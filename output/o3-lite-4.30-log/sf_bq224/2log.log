Query:
--Description:  #8 – Same as #7 but keep only repositories that have a recorded license.
WITH april AS (
  SELECT
         f.value:"name"::STRING AS "repo_name",
         t."type"
  FROM GITHUB_REPOS_DATE.YEAR."_2022" t,
       LATERAL FLATTEN(input => ARRAY_CONSTRUCT(t."repo")) f
  WHERE t."type" IN ('ForkEvent','WatchEvent','IssuesEvent')
    AND TO_DATE(TO_TIMESTAMP_NTZ(t."created_at" / 1000000))
        BETWEEN '2022-04-01' AND '2022-04-30'
)
SELECT
       a."repo_name",
       SUM(CASE WHEN a."type"='ForkEvent'   THEN 1 ELSE 0 END) AS "forks",
       SUM(CASE WHEN a."type"='WatchEvent'  THEN 1 ELSE 0 END) AS "watches",
       SUM(CASE WHEN a."type"='IssuesEvent' THEN 1 ELSE 0 END) AS "issues"
FROM april a
JOIN GITHUB_REPOS_DATE.GITHUB_REPOS.LICENSES l
  ON a."repo_name" = l."repo_name"
GROUP BY a."repo_name"
LIMIT 20
