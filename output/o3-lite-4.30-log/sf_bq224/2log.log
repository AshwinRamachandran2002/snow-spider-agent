```sql
-- Thinking process:
-- 1. We need events that happened in April 2022.
-- 2. Column "created_at" is micro‑seconds since 1970‑01‑01, so:  microseconds ÷ 1 000 000 → seconds.
-- 3. TO_TIMESTAMP_NTZ(<seconds>) converts seconds to a timestamp (no time‑zone).
-- 4. TO_DATE(<timestamp>) strips the time and leaves just the date, letting us compare to calendar dates.
-- 5. GROUP BY each event "type" and COUNT(*) rows to measure frequency.
-- 6. ORDER by that count, largest first, and LIMIT 20 for a quick glance.
SELECT
       t."type",
       COUNT(*) AS "event_count"
FROM GITHUB_REPOS_DATE.YEAR."_2022" t
WHERE TO_DATE(TO_TIMESTAMP_NTZ(t."created_at" / 1000000))
      BETWEEN '2022-04-01' AND '2022-04-30'
GROUP BY t."type"
ORDER BY "event_count" DESC
LIMIT 20;
```
