```

```sql
-- 4. Description:  Extract the repository name from the VARIANT "repo" field for 20 rows.
SELECT
       f.value:"name"::STRING AS "repo_name",
       t."type",
       t."created_at"
FROM GITHUB_REPOS_DATE.YEAR."_2022" t,
