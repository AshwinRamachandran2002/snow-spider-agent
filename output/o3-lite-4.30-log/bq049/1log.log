  SELECT
    RIGHT('00000' || SAFE_CAST(SPLIT(zip_code, '.')[OFFSET(0)] AS STRING), 5) AS zip5,
    date,
    sale_dollars
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE UPPER(county) = 'DUBUQUE'
    AND UPPER(category_name) LIKE '%BOURBON%'
    AND EXTRACT(YEAR FROM date) = 2022
),
ranked_zip AS (
  SELECT
    zip5,
    SUM(sale_dollars) AS total_sales_2022,
    ROW_NUMBER() OVER (ORDER BY SUM(sale_dollars) DESC) AS rn
  FROM sales_2022
  GROUP BY zip5
),
third_zip AS (
  SELECT zip5
  FROM ranked_zip
  WHERE rn = 3
),
population_21_plus AS (
  SELECT
    RIGHT('00000' || zipcode, 5) AS zip5,
    SUM(population) AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE gender IS NULL
    AND minimum_age >= 21
  GROUP BY zip5
),
monthly_sales AS (
  SELECT
    RIGHT('00000' || SAFE_CAST(SPLIT(zip_code, '.')[OFFSET(0)] AS STRING), 5) AS zip5,
    FORMAT_DATE('%Y-%m', date) AS month,
    SUM(sale_dollars) AS sales_usd
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE UPPER(county) = 'DUBUQUE'
    AND UPPER(category_name) LIKE '%BOURBON%'
    AND EXTRACT(YEAR FROM date) = 2022
  GROUP BY zip5, month
)
