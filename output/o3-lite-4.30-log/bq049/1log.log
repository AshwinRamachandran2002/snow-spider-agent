```

```sql
--Description: 6) Grab the third‑place zip code via QUALIFY ROW_NUMBER.
WITH ranked AS (
  SELECT 
    SAFE_CAST(SPLIT(zip_code,'.')[OFFSET(0)] AS STRING) AS zip5,
    SUM(sale_dollars) AS total_sales_2022,
    ROW_NUMBER() OVER(ORDER BY SUM(sale_dollars) DESC) AS rn
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND category_name = 'BOURBON WHISKEY'
    AND EXTRACT(YEAR FROM date)=2022
  GROUP BY zip5
)
SELECT zip5, total_sales_2022
FROM ranked 
WHERE rn = 3
LIMIT 20;
```

```sql
--Description: 7) Population 21+ by zip code from the 2010 census table.
SELECT zipcode,
       SUM(population) AS pop_21_plus
FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
WHERE gender IS NULL
  AND minimum_age >= 21
