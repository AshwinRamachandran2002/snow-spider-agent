--Description: 10) FINAL ANSWER – compute 2022 monthly Bourbon‑category sales per capita (age 21+) 
--for Dubuque County’s ZIP that ranks third in total 2022 Bourbon sales.  
--Consistent aliases: “t” for third_zip, “p” for the population CTE, and “s” for monthly sales.
WITH t AS (                        -- 3rd‑highest 2022 Bourbon‑sales ZIP in Dubuque
  SELECT zip5
  FROM (
    SELECT
      SAFE_CAST(SPLIT(zip_code, '.')[OFFSET(0)] AS STRING) AS zip5,
      ROW_NUMBER() OVER (ORDER BY SUM(sale_dollars) DESC) AS rn
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE county = 'DUBUQUE'
      AND LOWER(category_name) LIKE '%bourbon%'
      AND EXTRACT(YEAR FROM date) = 2022
    GROUP BY zip5
  )
  WHERE rn = 3
),
p AS (                             -- population aged 21+
  SELECT
    zipcode AS zip5,
    SUM(population) AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE minimum_age >= 21
  GROUP BY zipcode
),
s AS (                             -- monthly Bourbon sales dollars
  SELECT
    SAFE_CAST(SPLIT(zip_code, '.')[OFFSET(0)] AS STRING) AS zip5,
    FORMAT_DATE('%Y-%m', date) AS yyyymm,
    SUM(sale_dollars) AS month_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND LOWER(category_name) LIKE '%bourbon%'
    AND EXTRACT(YEAR FROM date) = 2022
  GROUP BY zip5, yyyymm
)
SELECT
  s.zip5,
  s.yyyymm,
  s.month_sales,
  p.pop_21_plus,
  ROUND(s.month_sales / p.pop_21_plus, 6) AS per_capita_sales_dollars
FROM s
JOIN t USING (zip5)
JOIN p USING (zip5)
ORDER BY yyyymm
