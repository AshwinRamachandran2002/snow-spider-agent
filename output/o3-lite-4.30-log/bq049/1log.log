ORDER BY zip5, yyyymm
LIMIT 20;
```

```sql
--Description: 9) Join monthly sales with population 21+ for the 3rd‑place zip to compute per‑capita.
WITH third_zip AS (
  SELECT zip5
  FROM (
    SELECT 
      SAFE_CAST(SPLIT(zip_code,'.')[OFFSET(0)] AS STRING) AS zip5,
      ROW_NUMBER() OVER(ORDER BY SUM(sale_dollars) DESC) AS rn
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE county = 'DUBUQUE'
      AND category_name = 'BOURBON WHISKEY'
      AND EXTRACT(YEAR FROM date)=2022
    GROUP BY zip5
  )
  WHERE rn = 3
),
pop AS (
  SELECT zipcode AS zip5, SUM(population) AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE gender IS NULL AND minimum_age >= 21
  GROUP BY zipcode
),
sales_mo AS (
  SELECT 
    SAFE_CAST(SPLIT(zip_code,'.')[OFFSET(0)] AS STRING) AS zip5,
    FORMAT_DATE('%Y-%m', date) AS yyyymm,
    SUM(sale_dollars) AS month_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND category_name = 'BOURBON WHISKEY'
    AND EXTRACT(YEAR FROM date)=2022
  GROUP BY zip5, yyyymm
)
SELECT 
  s.yyyymm,
  s.month_sales,
  p.pop_21_plus,
  s.month_sales / p.pop_21_plus AS per_capita_sales_dollars
FROM sales_mo AS s
JOIN third_zip USING (zip5)
JOIN pop      USING (zip5)
ORDER BY yyyymm
LIMIT 20;
```

```sql
--Description: 10) FINAL ANSWER – Monthly per‑capita Bourbon Whiskey sales (in dollars) during 2022 for Dubuque County’s 3rd‑highest‑selling zip code (age‑21‑plus population).
WITH third_zip AS (
  SELECT zip5
  FROM (
    SELECT 
      SAFE_CAST(SPLIT(zip_code,'.')[OFFSET(0)] AS STRING) AS zip5,
      ROW_NUMBER() OVER(ORDER BY SUM(sale_dollars) DESC) AS rn
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE county = 'DUBUQUE'
      AND category_name = 'BOURBON WHISKEY'
      AND EXTRACT(YEAR FROM date)=2022
    GROUP BY zip5
  )
  WHERE rn = 3
),
pop AS (
  SELECT zipcode AS zip5, SUM(population) AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE gender IS NULL 
    AND minimum_age >= 21
  GROUP BY zipcode
),
sales_mo AS (
  SELECT 
    SAFE_CAST(SPLIT(zip_code,'.')[OFFSET(0)] AS STRING) AS zip5,
    FORMAT_DATE('%Y-%m', date) AS yyyymm,
    SUM(sale_dollars) AS month_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND category_name = 'BOURBON WHISKEY'
    AND EXTRACT(YEAR FROM date)=2022
  GROUP BY zip5, yyyymm
)
SELECT 
  s.zip5,
  s.yyyymm,
  ROUND(s.month_sales / p.pop_21_plus, 4) AS per_capita_sales_dollars
FROM sales_mo AS s
JOIN third_zip USING (zip5)
JOIN pop      USING (zip5)
ORDER BY yyyymm
LIMIT 20;
```

The final query produces one row for each month of 2022 (up to 12 rows) showing the per‑capita Bourbon‑Whiskey sales in Dubuque County for the zip code that ranks third in total 2022 Bourbon‑Whiskey sales, using the 21‑and‑older 2010 census population as the denominator.
