```sql
--Description: Join 2022 Bourbon sales totals (by ZIP) with 2010 census population aged 21 + 
--for Dubuque County.  The population CTE now simply sums rows whose minimum_age ≥ 21, 
--avoiding the earlier gender filter that produced no data.
WITH bourbon_sales AS (
  SELECT
    SUBSTR(CAST(zip_code AS STRING), 1, 5) AS zip5,
    SUM(sale_dollars) AS total_sales_2022
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND date BETWEEN '2022-01-01' AND '2022-12-31'
    AND LOWER(category_name) LIKE '%bourbon%'
  GROUP BY zip5
),
pop AS (
  SELECT
    zipcode,
    SUM(population) AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE minimum_age >= 21
  GROUP BY zipcode
)
SELECT
  b.zip5,
  b.total_sales_2022,
  p.pop_21_plus
FROM bourbon_sales AS b
LEFT JOIN pop AS p
ON b.zip5 = p.zipcode
ORDER BY b.total_sales_2022 DESC
LIMIT 20;
```

```sql
--Description: Identify the ZIP code that ranks third in total 2022 Bourbon sales for Dubuque County.  
--No change needed, but retained for completeness with `%bourbon%` filter.
WITH bourbon_sales AS (
  SELECT
    SUBSTR(CAST(zip_code AS STRING), 1, 5) AS zip5,
    SUM(sale_dollars) AS total_sales_2022
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND date BETWEEN '2022-01-01' AND '2022-12-31'
    AND LOWER(category_name) LIKE '%bourbon%'
  GROUP BY zip5
)
SELECT
  zip5,
  total_sales_2022
FROM (
  SELECT
    zip5,
    total_sales_2022,
    RANK() OVER (ORDER BY total_sales_2022 DESC) AS rnk
  FROM bourbon_sales
)
WHERE rnk = 3
LIMIT 20;
```

```sql
--Description: Final answer – monthly per‑capita Bourbon sales in 2022 for the ZIP that ranks 
--third in total Bourbon dollars, using 2010 census population aged 21 +.  
--Population CTE simplified to `minimum_age ≥ 21`.
WITH third_zip AS (
  SELECT zip5
  FROM (
    SELECT
      SUBSTR(CAST(zip_code AS STRING), 1, 5) AS zip5,
      SUM(sale_dollars) AS total_sales_2022,
      RANK() OVER (ORDER BY SUM(sale_dollars) DESC) AS rnk
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE county = 'DUBUQUE'
      AND date BETWEEN '2022-01-01' AND '2022-12-31'
      AND LOWER(category_name) LIKE '%bourbon%'
    GROUP BY zip5
  )
  WHERE rnk = 3
),
pop AS (
  SELECT
    zipcode,
    SUM(population) AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE minimum_age >= 21
  GROUP BY zipcode
),
sales_monthly AS (
  SELECT
    SUBSTR(CAST(zip_code AS STRING), 1, 5) AS zip5,
    FORMAT_DATE('%Y-%m', date) AS ym,
    SUM(sale_dollars) AS monthly_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND date BETWEEN '2022-01-01' AND '2022-12-31'
    AND LOWER(category_name) LIKE '%bourbon%'
  GROUP BY zip5, ym
)
SELECT
  sm.ym                 AS month_2022,
  sm.monthly_sales,
  p.pop_21_plus,
  ROUND(sm.monthly_sales / p.pop_21_plus, 4) AS dollars_per_capita_21_plus
FROM sales_monthly AS sm
JOIN third_zip AS t
  ON sm.zip5 = t.zip5
JOIN pop AS p
  ON sm.zip5 = p.zipcode
ORDER BY month_2022
LIMIT 20;
```
