```sql
-- 7) Calculate population aged 21+ for every ZIP in 2010 census
SELECT zipcode,
       SUM(population) AS pop_21_plus
FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
WHERE (gender IS NULL OR gender = '')
  AND (
        minimum_age >= 21
        OR (minimum_age <= 21 AND (maximum_age IS NULL OR maximum_age >= 21))
      )
GROUP BY zipcode
LIMIT 20;
```

```sql
-- 8) Join liquor‑sales totals (all ZIPs) with 21+ population
WITH bourbon_sales AS (
  SELECT SUBSTR(zip_code,1,5) AS zip5,
         SUM(sale_dollars) AS total_sales_2022
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND date BETWEEN '2022-01-01' AND '2022-12-31'
    AND LOWER(category_name) LIKE '%bourbon%whiskey%'
  GROUP BY zip5
)
SELECT b.zip5,
       b.total_sales_2022,
       p.pop_21_plus
FROM bourbon_sales AS b
LEFT JOIN (
  SELECT zipcode, SUM(population) AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE (gender IS NULL OR gender = '')
    AND (
          minimum_age >= 21
          OR (minimum_age <= 21 AND (maximum_age IS NULL OR maximum_age >= 21))
        )
  GROUP BY zipcode
) AS p
ON b.zip5 = p.zipcode
ORDER BY b.total_sales_2022 DESC
LIMIT 20;
```

```sql
-- 9) Identify the specific ZIP that ranks 3rd in 2022 Bourbon sales
WITH bourbon_sales AS (
  SELECT SUBSTR(zip_code,1,5) AS zip5,
         SUM(sale_dollars) AS total_sales_2022
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND date BETWEEN '2022-01-01' AND '2022-12-31'
    AND LOWER(category_name) LIKE '%bourbon%whiskey%'
  GROUP BY zip5
)
SELECT zip5, total_sales_2022
FROM (
  SELECT zip5,
         total_sales_2022,
         RANK() OVER (ORDER BY total_sales_2022 DESC) AS rnk
  FROM bourbon_sales
)
WHERE rnk = 3
LIMIT 20;
```

```sql
-- 10) Final answer: Monthly per‑capita ($) Bourbon Whiskey sales in 2022
WITH third_zip AS (
  SELECT zip5
  FROM (
    SELECT SUBSTR(zip_code,1,5) AS zip5,
           SUM(sale_dollars) AS total_sales_2022,
           RANK() OVER (ORDER BY SUM(sale_dollars) DESC) AS rnk
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE county = 'DUBUQUE'
      AND date BETWEEN '2022-01-01' AND '2022-12-31'
      AND LOWER(category_name) LIKE '%bourbon%whiskey%'
    GROUP BY zip5
  )
  WHERE rnk = 3
),
pop AS (
  SELECT zipcode,
         SUM(population) AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE (gender IS NULL OR gender = '')
    AND (
          minimum_age >= 21
          OR (minimum_age <= 21 AND (maximum_age IS NULL OR maximum_age >= 21))
        )
  GROUP BY zipcode
),
sales_monthly AS (
  SELECT SUBSTR(zip_code,1,5) AS zip5,
         FORMAT_DATE('%Y-%m', date) AS ym,
         SUM(sale_dollars) AS monthly_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND date BETWEEN '2022-01-01' AND '2022-12-31'
    AND LOWER(category_name) LIKE '%bourbon%whiskey%'
  GROUP BY zip5, ym
)
SELECT sm.ym AS month_2022,
       sm.monthly_sales,
       p.pop_21_plus,
       ROUND(sm.monthly_sales / p.pop_21_plus, 4) AS dollars_per_capita_21_plus
FROM sales_monthly AS sm
JOIN third_zip AS t
  ON sm.zip5 = t.zip5
JOIN pop AS p
  ON sm.zip5 = p.zipcode
ORDER BY month_2022
LIMIT 20;
```

Each query is distinct, progressively explores needed information, and the final query (10) returns the requested “monthly per‑capita Bourbon Whiskey sales during 2022 in Dubuque County for the ZIP code that ranks third in total Bourbon Whiskey sales (population 21+).”
