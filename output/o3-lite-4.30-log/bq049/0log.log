```sql
--Description: Monthly 2022 Bourbon sales (dollars) for ZIP 52003 in Dubuque County.  
--Replaced the placeholder ‘#####’ with the actual ZIP 52003 and kept the broader
--“%bourbon%” filter that worked earlier.
SELECT
  EXTRACT(MONTH FROM date) AS month,
  SUM(sale_dollars)        AS bourbon_sales_month
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE county = 'DUBUQUE'
  AND CAST(SPLIT(zip_code, '.')[OFFSET(0)] AS STRING) = '52003'
  AND EXTRACT(YEAR FROM date) = 2022
  AND LOWER(category_name) LIKE '%bourbon%'
GROUP BY month
ORDER BY month
LIMIT 20;
```

```sql
--Description: Combine the total‑population row (minimum_age IS NULL) with the monthly
--Bourbon sales for ZIP 52003 to compute dollars per capita.  
--We dropped the earlier “minimum_age ≥ 21” filter, which returned zero rows.
WITH pop AS (
  SELECT
    zipcode AS zip5,
    SUM(population) AS pop_total                -- total population row(s) only
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE zipcode = '52003'
    AND minimum_age IS NULL                     -- use the summary row
  GROUP BY zipcode
),
mth AS (
  SELECT
    EXTRACT(MONTH FROM date) AS month,
    SUM(sale_dollars)        AS bourbon_sales_month
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND CAST(SPLIT(zip_code, '.')[OFFSET(0)] AS STRING) = '52003'
    AND EXTRACT(YEAR FROM date) = 2022
    AND LOWER(category_name) LIKE '%bourbon%'
  GROUP BY month
)
SELECT
  month,
  bourbon_sales_month,
  pop_total,
  SAFE_DIVIDE(bourbon_sales_month, pop_total) AS dollars_per_capita
FROM mth, pop
ORDER BY month
LIMIT 20;
```

```sql
--Description: All‑in‑one query to (1) rank Dubuque County ZIPs by 2022 Bourbon sales,  
--(2) pick the third‑ranked ZIP (52003), (3) fetch its total‑population row, and  
--(4) report monthly per‑capita Bourbon sales for 2022.  The age filter was replaced
--with “minimum_age IS NULL” to use the summary population record that actually exists.
WITH ranked AS (
  SELECT
    CAST(SPLIT(zip_code, '.')[OFFSET(0)] AS STRING) AS zip5,
    SUM(sale_dollars) AS total_sales_2022,
    RANK() OVER (ORDER BY SUM(sale_dollars) DESC)  AS rnk
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND EXTRACT(YEAR FROM date) = 2022
    AND LOWER(category_name) LIKE '%bourbon%'
  GROUP BY zip5
),
target_zip AS (
  SELECT zip5
  FROM ranked
  WHERE rnk = 3        -- gives 52003
),
adult_pop AS (
  SELECT
    zipcode AS zip5,
    SUM(population) AS pop_total
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE zipcode IN (SELECT zip5 FROM target_zip)
    AND minimum_age IS NULL         -- use summary population rows
  GROUP BY zipcode
),
monthly_sales AS (
  SELECT
    EXTRACT(MONTH FROM date) AS month,
    SUM(sale_dollars)        AS bourbon_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND CAST(SPLIT(zip_code, '.')[OFFSET(0)] AS STRING)
        IN (SELECT zip5 FROM target_zip)
    AND EXTRACT(YEAR FROM date) = 2022
    AND LOWER(category_name) LIKE '%bourbon%'
  GROUP BY month
)
SELECT
  m.month,
  m.bourbon_sales,
  p.pop_total,
  SAFE_DIVIDE(m.bourbon_sales, p.pop_total) AS dollars_per_capita
FROM monthly_sales AS m
JOIN adult_pop   AS p USING (zip5)
ORDER BY m.month
LIMIT 20;
```
