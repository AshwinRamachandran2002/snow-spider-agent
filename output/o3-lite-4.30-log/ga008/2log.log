        WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
          AND event_name = 'purchase'
      )
LIMIT 20;
```

```sql
-- 7. Description: Total number of page views per day by Nov‑2020 purchasers (no averaging yet).
SELECT event_date,
       COUNT(*) AS total_pageviews
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
  AND event_name = 'page_view'
  AND user_pseudo_id IN (
        SELECT DISTINCT user_pseudo_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
        WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
          AND event_name = 'purchase'
      )
GROUP BY event_date
ORDER BY event_date
LIMIT 20;
```

```sql
-- 8. Description: Distinct number of purchasers who generated at least one page view each day.
SELECT event_date,
       COUNT(DISTINCT user_pseudo_id) AS purchasing_users_with_pageviews
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
  AND event_name = 'page_view'
  AND user_pseudo_id IN (
        SELECT DISTINCT user_pseudo_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
        WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
          AND event_name = 'purchase'
      )
GROUP BY event_date
ORDER BY event_date
LIMIT 20;
```

```sql
-- 9. Description: Combine totals and user counts to compute the average page views per user per day.
SELECT
  pv.event_date,
  pv.total_pageviews,
  u.user_count,
  ROUND(pv.total_pageviews / u.user_count, 2) AS avg_pageviews_per_user
FROM (
  -- subquery for page‑view totals
  SELECT event_date, COUNT(*) AS total_pageviews
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND event_name = 'page_view'
    AND user_pseudo_id IN (
          SELECT DISTINCT user_pseudo_id
          FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
          WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
            AND event_name = 'purchase'
        )
  GROUP BY event_date
) AS pv
JOIN (
  -- subquery for distinct users with page views
  SELECT event_date, COUNT(DISTINCT user_pseudo_id) AS user_count
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND event_name = 'page_view'
    AND user_pseudo_id IN (
          SELECT DISTINCT user_pseudo_id
          FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
          WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
            AND event_name = 'purchase'
        )
  GROUP BY event_date
) AS u
USING (event_date)
ORDER BY event_date
LIMIT 20;
```

```sql
-- 10. Description: Final concise query returning the requested metrics for every day in Nov‑2020.
SELECT
  event_date,
  COUNT(*) AS total_pageviews,
  COUNT(DISTINCT user_pseudo_id) AS users_with_pageviews,
  ROUND(COUNT(*) / COUNT(DISTINCT user_pseudo_id), 2) AS avg_pageviews_per_user
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
  AND event_name = 'page_view'
  AND user_pseudo_id IN (
        -- set of purchasers in November 2020
        SELECT DISTINCT user_pseudo_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
        WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
          AND event_name = 'purchase'
      )
GROUP BY event_date
ORDER BY event_date;
```

