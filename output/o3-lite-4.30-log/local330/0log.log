Begin Exploring Related Columns
Relevant columns & possible usage  
"session": identify each unique browsing session  
"stamp": chronological order of page‑views inside a session (needed to pick first / last)  
"path": actual web page URL or pathname whose landing / exit popularity we must measure  
(action / option / search_type are not essential for this task but may be used for filters)  

Typical conditions we may apply  
• "path" IS NOT NULL  – ignore records that have no page information  
• aggregate MIN("stamp") / MAX("stamp") per "session" to find landing / exit time  
• use DISTINCT so a session is counted only once for a page even when it is both landing & exit  

Below are ten different, steadily‑more‑complex SQLite queries (each limited to 20 rows for safety) that explore the data and finally answer the question.

```sql
-- 1. List some distinct session IDs that exist in the activity log
SELECT DISTINCT "session"
FROM "activity_log"
LIMIT 20;
```

```sql
-- 2. Inspect different page paths that appear in the log
SELECT DISTINCT "path"
FROM "activity_log"
WHERE "path" IS NOT NULL
LIMIT 20;
```

```sql
-- 3. Show time‑ordered page views for each session (sample)
SELECT "session",
       "stamp",
       "path"
FROM "activity_log"
WHERE "path" IS NOT NULL
ORDER BY "session", "stamp"
LIMIT 20;
```

```sql
-- 4. Obtain the first time‑stamp (landing moment) for every session
SELECT "session",
       MIN("stamp") AS "first_stamp"
FROM "activity_log"
GROUP BY "session"
LIMIT 20;
```

```sql
-- 5. Retrieve the landing page (first path) of every session
SELECT a."session",
       a."path"  AS "landing_path"
FROM "activity_log" AS a
JOIN (
      SELECT "session", MIN("stamp") AS "first_stamp"
      FROM "activity_log"
      GROUP BY "session"
     ) AS f
  ON a."session" = f."session"
 AND a."stamp"   = f."first_stamp"
WHERE a."path" IS NOT NULL
LIMIT 20;
```

```sql
-- 6. Retrieve the exit page (last path) of every session
SELECT a."session",
       a."path"  AS "exit_path"
FROM "activity_log" AS a
JOIN (
      SELECT "session", MAX("stamp") AS "last_stamp"
      FROM "activity_log"
      GROUP BY "session"
     ) AS l
  ON a."session" = l."session"
 AND a."stamp"   = l."last_stamp"
WHERE a."path" IS NOT NULL
LIMIT 20;
```

```sql
-- 7. Combine landing and exit pages for each session (deduplicated)
SELECT DISTINCT "session", "path"
FROM (
        /* landing pages */
        SELECT a."session", a."path"
        FROM "activity_log" AS a
        JOIN (
              SELECT "session", MIN("stamp") AS "first_stamp"
              FROM "activity_log"
              GROUP BY "session"
             ) AS f
          ON a."session" = f."session"
         AND a."stamp"   = f."first_stamp"
        WHERE a."path" IS NOT NULL

        UNION

        /* exit pages */
        SELECT a."session", a."path"
        FROM "activity_log" AS a
        JOIN (
              SELECT "session", MAX("stamp") AS "last_stamp"
              FROM "activity_log"
              GROUP BY "session"
             ) AS l
          ON a."session" = l."session"
         AND a."stamp"   = l."last_stamp"
        WHERE a."path" IS NOT NULL
) AS t
LIMIT 20;
```

```sql
-- 8. Count how many unique sessions each page serves as either landing or exit
SELECT t."path",
       COUNT(DISTINCT t."session") AS "sessions_as_land_or_exit"
FROM (
        /* same sub‑query as #7 */
        SELECT DISTINCT "session", "path"
        FROM (
                SELECT a."session", a."path"
                FROM "activity_log" AS a
                JOIN (
                      SELECT "session", MIN("stamp") AS "first_stamp"
                      FROM "activity_log"
                      GROUP BY "session"
                     ) AS f
                  ON a."session" = f."session"
                 AND a."stamp"   = f."first_stamp"
                WHERE a."path" IS NOT NULL

                UNION

                SELECT a."session", a."path"
                FROM "activity_log" AS a
                JOIN (
                      SELECT "session", MAX("stamp") AS "last_stamp"
                      FROM "activity_log"
                      GROUP BY "session"
                     ) AS l
                  ON a."session" = l."session"
                 AND a."stamp"   = l."last_stamp"
                WHERE a."path" IS NOT NULL
        )
) AS t
GROUP BY t."path"
ORDER BY "sessions_as_land_or_exit" DESC
LIMIT 20;
```

```sql
-- 9. Same as #8 but include pages even with only one such session (ordering alphabetical)
SELECT t."path",
       COUNT(DISTINCT t."session") AS "sessions_as_land_or_exit"
FROM (
        /* landing or exit deduplicated per session & page */
        SELECT DISTINCT "session", "path"
        FROM (
                SELECT a."session", a."path"
                FROM "activity_log" AS a
                JOIN (
                      SELECT "session", MIN("stamp") AS "first_stamp"
                      FROM "activity_log"
                      GROUP BY "session"
                     ) AS f
                  ON a."session" = f."session"
                 AND a."stamp"   = f."first_stamp"
                WHERE a."path" IS NOT NULL

                UNION

                SELECT a."session", a."path"
                FROM "activity_log" AS a
                JOIN (
                      SELECT "session", MAX("stamp") AS "last_stamp"
                      FROM "activity_log"
                      GROUP BY "session"
                     ) AS l
                  ON a."session" = l."session"
                 AND a."stamp"   = l."last_stamp"
                WHERE a."path" IS NOT NULL
        )
) AS t
GROUP BY t."path"
ORDER BY t."path"
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: Total number of unique sessions for every page that appears
--        as a landing page, exit page, or both (no LIMIT applied here)
SELECT t."path"                             AS "web_page",
       COUNT(DISTINCT t."session")          AS "unique_sessions"
FROM (
        /* collect landing or exit pages, counting each session only once per page */
        SELECT DISTINCT "session", "path"
        FROM (
                /* landing */
                SELECT a."session", a."path"
                FROM "activity_log" AS a
                JOIN (
                      SELECT "session", MIN("stamp") AS "first_stamp"
                      FROM "activity_log"
                      GROUP BY "session"
                     ) AS f
                  ON a."session" = f."session"
                 AND a."stamp"   = f."first_stamp"
                WHERE a."path" IS NOT NULL

                UNION ALL

                /* exit */
                SELECT a."session", a."path"
                FROM "activity_log" AS a
                JOIN (
                      SELECT "session", MAX("stamp") AS "last_stamp"
                      FROM "activity_log"
                      GROUP BY "session"
                     ) AS l
                  ON a."session" = l."session"
                 AND a."stamp"   = l."last_stamp"
                WHERE a."path" IS NOT NULL
        )
) AS t
GROUP BY t."path"
ORDER BY "unique_sessions" DESC;
```
