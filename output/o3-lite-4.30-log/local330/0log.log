                      FROM "activity_log"
                      GROUP BY "session"
                     ) AS l
                  ON a."session" = l."session"
                 AND a."stamp"   = l."last_stamp"
                WHERE a."path" IS NOT NULL
        )
) AS t
GROUP BY t."path"
ORDER BY "sessions_as_land_or_exit" DESC
LIMIT 20;
