Begin Exploring Related Columns
Relevant columns and their potential usage  
activity_log."session" : identify each user session for grouping  
activity_log."stamp"   : determine chronological order inside a session  
activity_log."path"    : page URL (or page identifier) that we finally want to aggregate on  
activity_log."action"  : (optional) keep only page‑view–type rows if necessary, e.g. WHERE "action" = 'view'  

Typical conditions that may be useful  
• WHERE "action" = 'view'                              -- keep only page views (optional)  
• WHERE "stamp" IS NOT NULL AND "path" IS NOT NULL     -- safety guards  
• GROUP BY "session"                                   -- find first / last page per session  
• MIN("stamp") / MAX("stamp")                          -- pick landing / exit pages  
• UNION or UNION ALL + DISTINCT                        -- make sure each (session, path) is counted once even if it is both landing and exit  

Sample exploration & solution queries (each limited to 20 rows)

```sql
-- 1. Quick look at the raw activity_log table
SELECT *
FROM "activity_log"
LIMIT 20;
```

```sql
-- 2. Distinct values that appear in the "action" column
SELECT DISTINCT "action"
FROM "activity_log"
LIMIT 20;
```

```sql
-- 3. Distinct values that appear in the "option" column
SELECT DISTINCT "option"
FROM "activity_log"
LIMIT 20;
```

```sql
-- 4. Sample of unique page paths that users actually visit
SELECT DISTINCT "path"
FROM "activity_log"
WHERE "path" IS NOT NULL
LIMIT 20;
```

```sql
-- 5. For every session, pick the earliest (landing) page 
SELECT al."session",
       MIN(al."stamp")        AS first_stamp,
       (SELECT al2."path"
        FROM   "activity_log" al2
        WHERE  al2."session" = al."session"
        ORDER  BY al2."stamp" ASC
        LIMIT 1)              AS landing_path
FROM "activity_log" al
GROUP BY al."session"
LIMIT 20;
```

```sql
-- 6. For every session, pick the latest (exit) page
SELECT al."session",
       MAX(al."stamp")        AS last_stamp,
       (SELECT al2."path"
        FROM   "activity_log" al2
        WHERE  al2."session" = al."session"
        ORDER  BY al2."stamp" DESC
        LIMIT 1)              AS exit_path
FROM "activity_log" al
GROUP BY al."session"
LIMIT 20;
```

```sql
-- 7. List of (session, path) pairs where the path was either landing or exit
SELECT DISTINCT s."session", s."path"
FROM (
        -- landing pages
        SELECT a1."session",
               (SELECT a2."path"
                FROM "activity_log" a2
                WHERE a2."session" = a1."session"
                ORDER BY a2."stamp" ASC
                LIMIT 1) AS "path"
        FROM "activity_log" a1
        GROUP BY a1."session"
        UNION
        -- exit pages
        SELECT b1."session",
               (SELECT b2."path"
                FROM "activity_log" b2
                WHERE b2."session" = b1."session"
                ORDER BY b2."stamp" DESC
                LIMIT 1) AS "path"
        FROM "activity_log" b1
        GROUP BY b1."session"
     ) s
LIMIT 20;
```

```sql
-- 8. How many DISTINCT sessions treat each path as a landing page only
SELECT landing."path",
       COUNT(DISTINCT landing."session") AS landing_sessions
FROM (
        SELECT a1."session",
               (SELECT a2."path"
                FROM "activity_log" a2
                WHERE a2."session" = a1."session"
                ORDER BY a2."stamp" ASC
                LIMIT 1) AS "path"
        FROM "activity_log" a1
        GROUP BY a1."session"
     ) landing
GROUP BY landing."path"
ORDER BY landing_sessions DESC
LIMIT 20;
```

```sql
-- 9. How many DISTINCT sessions treat each path as an exit page only
SELECT exit."path",
       COUNT(DISTINCT exit."session") AS exit_sessions
FROM (
        SELECT b1."session",
               (SELECT b2."path"
                FROM "activity_log" b2
                WHERE b2."session" = b1."session"
                ORDER BY b2."stamp" DESC
                LIMIT 1) AS "path"
        FROM "activity_log" b1
        GROUP BY b1."session"
     ) exit
GROUP BY exit."path"
ORDER BY exit_sessions DESC
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: total DISTINCT sessions per page where the page is a landing or exit (count a session only once per page)
SELECT se."path",
       COUNT(DISTINCT se."session") AS total_sessions
FROM (
        -- landing pages
        SELECT a1."session",
               (SELECT a2."path"
                FROM "activity_log" a2
                WHERE a2."session" = a1."session"
                ORDER BY a2."stamp" ASC
                LIMIT 1) AS "path"
        FROM "activity_log" a1
        GROUP BY a1."session"
        UNION
        -- exit pages
        SELECT b1."session",
               (SELECT b2."path"
                FROM "activity_log" b2
                WHERE b2."session" = b1."session"
                ORDER BY b2."stamp" DESC
                LIMIT 1) AS "path"
        FROM "activity_log" b1
        GROUP BY b1."session"
     ) se
GROUP BY se."path"
ORDER BY total_sessions DESC
LIMIT 20;
```

The 10th query returns, for each web page path, the number of unique sessions in which that page appeared as the first or last page (landing or exit), counting any given session only once for that page even if it fulfilled both roles.
