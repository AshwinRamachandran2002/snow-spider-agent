```sql
--Description: #6  Show, for each view record, its chronological rank in both
--              ascending and descending order within the same session.  Useful
--              to understand landing (rn_asc = 1) and exit (rn_desc = 1) pages.
SELECT   "session",
         "path",
         "stamp",
         ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp")        AS rn_asc,
         ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC)   AS rn_desc
FROM     activity_log
WHERE    "action" = 'view'
         AND "path" IS NOT NULL
LIMIT 20;
```

```sql
--Description: #7  Extract landing pages only: take the earliest record
--              (rn = 1) per session after ranking by ascending timestamp.
WITH ranked AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp") AS rn
  FROM   activity_log
  WHERE  "action" = 'view'
         AND "path" IS NOT NULL
)
SELECT "session", "path" AS landing_path
FROM   ranked
WHERE  rn = 1
LIMIT 20;
```

```sql
--Description: #8  Extract exit pages only: take the latest record (rn = 1)
--              per session after ranking by descending timestamp.
WITH ranked AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) AS rn
  FROM   activity_log
  WHERE  "action" = 'view'
         AND "path" IS NOT NULL
)
SELECT "session", "path" AS exit_path
FROM   ranked
WHERE  rn = 1
LIMIT 20;
```

```sql
--Description: #9  Build a set of (session, path) pairs that are either landing
--              or exit pages.  Use window ranks, take rn_first = 1 or rn_last = 1,
--              and UNION to de‑duplicate within the same session‑path pair.
WITH ranked AS (
  SELECT
      "session",
      "path",
      ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp")        AS rn_first,
      ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC)   AS rn_last
  FROM activity_log
  WHERE "action" = 'view'
        AND "path" IS NOT NULL
),
landing_exit AS (
  SELECT "session", "path" FROM ranked WHERE rn_first = 1
  UNION
  SELECT "session", "path" FROM ranked WHERE rn_last  = 1
)
SELECT * FROM landing_exit
LIMIT 20;
```

```sql
--Description: #10  FINAL ANSWER – count the number of unique sessions for each
--              web page that acted as a landing and/or exit page, ensuring a
--              session contributes at most once per page.
WITH ranked AS (
  SELECT
      "session",
      "path",
      ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp")        AS rn_first,
      ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC)   AS rn_last
  FROM activity_log
  WHERE "action" = 'view'
        AND "path" IS NOT NULL
),
landing_exit AS (
  SELECT "session", "path" FROM ranked WHERE rn_first = 1
  UNION
  SELECT "session", "path" FROM ranked WHERE rn_last  = 1
)
SELECT   "path",
         COUNT(DISTINCT "session") AS session_cnt
FROM     landing_exit
GROUP BY "path"
ORDER BY session_cnt DESC
LIMIT 20;
```
