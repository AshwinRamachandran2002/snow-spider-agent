--Description / thinking process:
--Task: for every browsing session, show the first timestamp (first_hit) and the
--corresponding landing page (landing_path).
--Approach
-- 1. Work only with rows where action = 'view' and path IS NOT NULL
--    because those represent actual page views.
-- 2. Use a window function (ROW_NUMBER) to rank rows chronologically inside
--    each session: the row with rank = 1 is the earliest hit.
-- 3. Filter to keep only rank = 1; that immediately gives us the earliest
--    stamp and its path without a separate correlated sub‑query.
-- 4. LIMIT 20 to preview the output.
WITH ranked AS (
  SELECT
      "session",
      "stamp"  AS first_hit,
      "path"   AS landing_path,
      ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp") AS rn
  FROM  activity_log
  WHERE "action" = 'view'
        AND "path" IS NOT NULL
)
SELECT "session", first_hit, landing_path
FROM   ranked
WHERE  rn = 1
LIMIT 20;
```
