--              keep only rank = 1, and sample 20 rows.
WITH ranked AS (
  SELECT
      "session",
      "stamp" AS last_hit,
      "path"  AS exit_path,
      ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) AS rn
  FROM  activity_log
  WHERE "action" = 'view'
