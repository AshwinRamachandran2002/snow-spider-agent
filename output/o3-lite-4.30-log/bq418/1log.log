WITH
/* canonical Targetome drugID(s) that correspond to Sorafenib */
soraf_drug AS (
  SELECT DISTINCT `drugID`
  FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
  WHERE LOWER(`synonym`) = 'sorafenib'
),

/* UniProt IDs of Homo‑sapiens Sorafenib targets whose potency ≤ 100 nM  */
soraf_targets AS (
  SELECT DISTINCT i.`target_uniprotID` AS uniprot_id
  FROM `isb-cgc-bq.targetome_versioned.interactions_v1`  i
  JOIN soraf_drug                                         sd ON i.`drugID` = sd.`drugID`
  JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`   e  ON i.`expID`  = e.`expID`
  WHERE i.`targetSpecies`        = 'Homo sapiens'
    AND e.`exp_assayUnits`       = 'nM'
    AND e.`exp_assayValueMedian` <= 100
    AND (e.`exp_assayValueLow`   <= 100 OR e.`exp_assayValueLow`  IS NULL)
    AND (e.`exp_assayValueHigh`  <= 100 OR e.`exp_assayValueHigh` IS NULL)
),

/* Universe of all human proteins represented in Reactome physical entities */
all_uniprots AS (
  SELECT DISTINCT `uniprot_id`
  FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77`
  WHERE `uniprot_id` IS NOT NULL
),

/* Lowest‑level Human pathways (TAS evidence) with their member UniProt IDs */
pathway_members AS (
  SELECT DISTINCT ptp.`pathway_stable_id` AS pathway_id,
                  p.`uniprot_id`
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`      ptp
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77`    p   ON ptp.`pe_stable_id` = p.`stable_id`
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`            pw  ON ptp.`pathway_stable_id` = pw.`stable_id`
  WHERE ptp.`evidence_code` = 'TAS'
    AND pw.`lowest_level`   = TRUE
    AND pw.`species`        = 'Homo sapiens'
    AND p.`uniprot_id` IS NOT NULL
),

/* For every pathway: count how many Sorafenib targets / non‑targets fall inside it */
counts AS (
  SELECT
    pm.`pathway_id`,
    COUNTIF(st.`uniprot_id` IS NOT NULL) AS targets_in,
    COUNTIF(st.`uniprot_id` IS NULL)     AS nontargets_in
  FROM pathway_members pm
  LEFT JOIN soraf_targets st
         ON pm.`uniprot_id` = st.`uniprot_id`
  GROUP BY pm.`pathway_id`
),

/* Totals needed for chi‑squared */
totals AS (
  SELECT
    (SELECT COUNT(DISTINCT uniprot_id) FROM all_uniprots) AS N,
    (SELECT COUNT(DISTINCT uniprot_id) FROM soraf_targets) AS T
),

/* Attach pathway names, derive the out‑of‑pathway counts and compute chi‑squared */
chi_table AS (
  SELECT
    c.`pathway_id`,
    pv.`name`                                        AS pathway_name,
    c.`targets_in`,
    (t.T - c.`targets_in`)                          AS targets_outside,
    c.`nontargets_in`,
    (t.N - t.T - c.`nontargets_in`)                 AS nontargets_outside,
    /* chi‑squared statistic */
    t.N * POW( (c.targets_in * (t.N - t.T - c.nontargets_in) -
                c.nontargets_in * (t.T - c.targets_in) ), 2 )
      / (
          (c.targets_in + c.nontargets_in) *
          (t.T - c.targets_in + t.N - t.T - c.nontargets_in) *
          (c.targets_in + t.T - c.targets_in) *
          (c.nontargets_in + t.N - t.T - c.nontargets_in)
        )                                            AS chi_sq
  FROM counts c
  CROSS JOIN totals t
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77` pv
    ON c.`pathway_id` = pv.`stable_id`
)

/* Return the three pathways with the highest chi‑squared values */
SELECT
  pathway_id              AS reactome_pathway_id,
  pathway_name            AS reactome_pathway_name,
  targets_in              AS targets_in_pathway,
  targets_outside         AS targets_outside_pathway,
  nontargets_in           AS nontargets_in_pathway,
  nontargets_outside      AS nontargets_outside_pathway
FROM chi_table
ORDER BY chi_sq DESC, pathway_id
LIMIT 3;
```
