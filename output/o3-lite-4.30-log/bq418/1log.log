--Steps
-- 1) soraf_drug      – all Targetome drugIDs whose synonym contains 'sorafenib'.
-- 2) soraf_targets   – UniProt IDs of human targets whose median assay value ≤100 nM
--                      (and low/high ≤100 nM or NULL) against those drugIDs.
-- 3) all_human_pe    – every Reactome physical entity (PE) that has a UniProt ID.
-- 4) pe_pathway      – TAS‑supported PE‑to‑pathway links.
-- 5) pathway_filter  – pathways that are lowest_level = TRUE and species = 'Homo sapiens'.
-- 6) counts          – build contingency counts for each pathway:
--        a = # sorafenib targets in pathway
--        b = # non‑targets     in pathway
-- 7) totals          – N = total PEs,  T = total sorafenib targets.
-- 8) Final SELECT    – compute χ² = N(ad−bc)² / ((a+b)(c+d)(a+c)(b+d)),
--                      where c = T−a, d = N−T−b, and return the top‑3 pathways.
WITH soraf_drug AS (
  SELECT DISTINCT drugID
  FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
  WHERE LOWER(synonym) LIKE '%sorafenib%'
),
soraf_targets AS (
