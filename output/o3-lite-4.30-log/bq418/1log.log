  FROM   `isb-cgc-bq.targetome_versioned.interactions_v1`  i
  JOIN   soraf_drug                                       sd ON i.drugID = sd.drugID
  JOIN   `isb-cgc-bq.targetome_versioned.experiments_v1`   e ON i.expID  = e.expID
  JOIN   `isb-cgc-bq.reactome_versioned.physical_entity_v77` p
         ON i.target_uniprotID = p.uniprot_id
  WHERE  i.targetSpecies         = 'Homo sapiens'
    AND  e.exp_assayUnits        = 'nM'
    AND  e.exp_assayValueMedian <= 100
    AND (e.exp_assayValueLow   <= 100 OR e.exp_assayValueLow  IS NULL)
    AND (e.exp_assayValueHigh  <= 100 OR e.exp_assayValueHigh IS NULL)
)
SELECT DISTINCT ptp.pathway_stable_id,
       pt.name,
       ptp.evidence_code
FROM   soraf_pe                                             sp
JOIN   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`    ptp ON sp.stable_id     = ptp.pe_stable_id
JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77`          pt  ON ptp.pathway_stable_id = pt.stable_id
WHERE  ptp.evidence_code = 'TAS'
  AND  pt.species        = 'Homo sapiens'
LIMIT 20;
```

```sql
--Description: Count distinct potency‑filtered sorafenib targets in each lowest‑level Human pathway (TAS evidence).
WITH soraf_drug AS (
  SELECT DISTINCT drugID
  FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
  WHERE LOWER(synonym) LIKE '%sorafenib%'
), soraf_pe AS (
  SELECT DISTINCT p.stable_id, i.target_uniprotID
  FROM   `isb-cgc-bq.targetome_versioned.interactions_v1`  i
  JOIN   soraf_drug                                       sd ON i.drugID = sd.drugID
  JOIN   `isb-cgc-bq.targetome_versioned.experiments_v1`   e ON i.expID  = e.expID
  JOIN   `isb-cgc-bq.reactome_versioned.physical_entity_v77` p ON i.target_uniprotID = p.uniprot_id
  WHERE  i.targetSpecies         = 'Homo sapiens'
    AND  e.exp_assayUnits        = 'nM'
    AND  e.exp_assayValueMedian <= 100
    AND (e.exp_assayValueLow   <= 100 OR e.exp_assayValueLow  IS NULL)
    AND (e.exp_assayValueHigh  <= 100 OR e.exp_assayValueHigh IS NULL)
), soraf_pathways AS (
  SELECT DISTINCT ptp.pathway_stable_id, sp.target_uniprotID
  FROM   soraf_pe                                            sp
  JOIN   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`   ptp ON sp.stable_id = ptp.pe_stable_id
  WHERE  ptp.evidence_code = 'TAS'
)
SELECT  pw.stable_id,
        pw.name,
        COUNT(DISTINCT sp.target_uniprotID) AS sorafenib_target_ct
FROM    soraf_pathways                      sp
JOIN    `isb-cgc-bq.reactome_versioned.pathway_v77` pw
        ON sp.pathway_stable_id = pw.stable_id
WHERE   pw.lowest_level = TRUE
  AND   pw.species      = 'Homo sapiens'
GROUP BY pw.stable_id, pw.name
ORDER BY sorafenib_target_ct DESC
LIMIT 20;
```

```sql
--Description: Build contingency counts (targets vs non‑targets IN/OUT of each pathway) for sorafenib,
--using drugID lookup instead of direct drugName filtering; show a 20‑row sample.
WITH soraf_drug AS (
  SELECT DISTINCT drugID
  FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
  WHERE LOWER(synonym) LIKE '%sorafenib%'
), all_human_pe AS (
  SELECT DISTINCT p.stable_id, p.uniprot_id
  FROM   `isb-cgc-bq.reactome_versioned.physical_entity_v77` p
  WHERE  p.uniprot_id IS NOT NULL
), soraf_targets AS (
  SELECT DISTINCT p.uniprot_id
  FROM   `isb-cgc-bq.targetome_versioned.interactions_v1`  i
  JOIN   soraf_drug                                       sd ON i.drugID = sd.drugID
  JOIN   `isb-cgc-bq.targetome_versioned.experiments_v1`   e ON i.expID  = e.expID
  JOIN   `isb-cgc-bq.reactome_versioned.physical_entity_v77` p ON i.target_uniprotID = p.uniprot_id
  WHERE  i.targetSpecies          = 'Homo sapiens'
    AND  e.exp_assayUnits         = 'nM'
    AND  e.exp_assayValueMedian  <= 100
    AND (e.exp_assayValueLow    <= 100 OR e.exp_assayValueLow  IS NULL)
    AND (e.exp_assayValueHigh   <= 100 OR e.exp_assayValueHigh IS NULL)
), pe_pathway AS (
  SELECT DISTINCT pe_stable_id, pathway_stable_id
  FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`
  WHERE  evidence_code = 'TAS'
), pathway_filter AS (
  SELECT stable_id
  FROM   `isb-cgc-bq.reactome_versioned.pathway_v77`
  WHERE  lowest_level = TRUE
    AND  species      = 'Homo sapiens'
)
SELECT  pw.stable_id AS pathway_id,
        COUNTIF(st.uniprot_id IS NOT NULL) AS in_pathway_targets,
        COUNTIF(st.uniprot_id IS NULL)     AS in_pathway_nontargets
FROM    pathway_filter          pw
JOIN    pe_pathway              pp ON pw.stable_id    = pp.pathway_stable_id
JOIN    all_human_pe            hp ON pp.pe_stable_id = hp.stable_id
LEFT JOIN soraf_targets         st ON hp.uniprot_id   = st.uniprot_id
GROUP BY pw.stable_id
LIMIT 20;
```

```sql
--Description: Compute chi‑squared enrichment for every eligible pathway (lowest‑level,
--Human, TAS evidence) with corrected sorafenib target definition; return the top three.
WITH soraf_drug AS (
  SELECT DISTINCT drugID
  FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
  WHERE LOWER(synonym) LIKE '%sorafenib%'
), all_human_pe AS (
  SELECT DISTINCT stable_id, uniprot_id
  FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77`
  WHERE uniprot_id IS NOT NULL
), soraf_targets AS (
  SELECT DISTINCT p.uniprot_id
  FROM   `isb-cgc-bq.targetome_versioned.interactions_v1`  i
  JOIN   soraf_drug                                       sd ON i.drugID = sd.drugID
  JOIN   `isb-cgc-bq.targetome_versioned.experiments_v1`   e ON i.expID  = e.expID
  JOIN   `isb-cgc-bq.reactome_versioned.physical_entity_v77` p ON i.target_uniprotID = p.uniprot_id
  WHERE  i.targetSpecies          = 'Homo sapiens'
    AND  e.exp_assayUnits         = 'nM'
    AND  e.exp_assayValueMedian  <= 100
    AND (e.exp_assayValueLow    <= 100 OR e.exp_assayValueLow  IS NULL)
    AND (e.exp_assayValueHigh   <= 100 OR e.exp_assayValueHigh IS NULL)
), pe_pathway AS (
  SELECT DISTINCT pe_stable_id, pathway_stable_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`
  WHERE evidence_code = 'TAS'
), pathway_filter AS (
  SELECT stable_id, name
  FROM   `isb-cgc-bq.reactome_versioned.pathway_v77`
  WHERE  lowest_level = TRUE
    AND  species      = 'Homo sapiens'
), in_out AS (
  SELECT pf.stable_id AS pathway_id,
         pf.name,
         IF(st.uniprot_id IS NOT NULL, 1, 0) AS is_target
  FROM   pathway_filter  pf
  JOIN   pe_pathway      pp ON pf.stable_id = pp.pathway_stable_id
  JOIN   all_human_pe    hp ON pp.pe_stable_id = hp.stable_id
  LEFT  JOIN soraf_targets st ON hp.uniprot_id = st.uniprot_id
), totals AS (
  SELECT COUNT(*) AS all_pe_ct FROM all_human_pe
), target_tot AS (
  SELECT COUNT(*) AS t_ct FROM soraf_targets
)
SELECT pathway_id,
       name,
       SUM(CASE WHEN is_target = 1 THEN 1 END) AS a,   -- targets IN
       SUM(CASE WHEN is_target = 0 THEN 1 END) AS b,   -- non‑targets IN
       (SELECT t_ct FROM target_tot) - SUM(CASE WHEN is_target = 1 THEN 1 END) AS c, -- targets OUT
       (SELECT all_pe_ct FROM totals) -
       (SELECT t_ct FROM target_tot) -
       SUM(CASE WHEN is_target = 0 THEN 1 END) AS d,   -- non‑targets OUT
       -- Chi‑squared statistic
       (
         (SELECT all_pe_ct FROM totals) *
         POW(
           (SUM(CASE WHEN is_target = 1 THEN 1 END) *
            ((SELECT all_pe_ct FROM totals) - (SELECT t_ct FROM target_tot) -
             SUM(CASE WHEN is_target = 0 THEN 1 END)) -
            (SUM(CASE WHEN is_target = 0 THEN 1 END) *
            ((SELECT t_ct FROM target_tot) -
             SUM(CASE WHEN is_target = 1 THEN 1 END)))
         , 2)
       ) /
       ( (SUM(CASE WHEN is_target = 1 THEN 1 END) + SUM(CASE WHEN is_target = 0 THEN 1 END)) *
         ((SELECT t_ct FROM target_tot) - SUM(CASE WHEN is_target = 1 THEN 1 END) +
          ((SELECT all_pe_ct FROM totals) - (SELECT t_ct FROM target_tot) -
           SUM(CASE WHEN is_target = 0 THEN 1 END))) *
         (SUM(CASE WHEN is_target = 1 THEN 1 END) + ((SELECT t_ct FROM target_tot) -
          SUM(CASE WHEN is_target = 1 THEN 1 END))) *
         (SUM(CASE WHEN is_target = 0 THEN 1 END) + ((SELECT all_pe_ct FROM totals) -
          (SELECT t_ct FROM target_tot) - SUM(CASE WHEN is_target = 0 THEN 1 END)))
       ) AS chi_sq
FROM   in_out
GROUP BY pathway_id, name
ORDER BY chi_sq DESC
LIMIT 3;
```
