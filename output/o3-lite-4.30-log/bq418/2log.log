The table structure information is ({database name: {schema name: [table name]}}): 
{'isb-cgc-bq': {'reactome_versioned': ['pathway_hierarchy_v77', 'pe_to_pathway_v77', 'physical_entity_v77', 'pathway_v77'], 'targetome_versioned': ['target_synonyms_v1', 'sources_v1', 'interactions_v1', 'experiments_v1', 'drug_synonyms_v1']}}
Begin Exploring Related Columns
Relevant columns and their intended use  
• `drug_synonyms_v1.synonym`: find the word “sorafenib” (or any of its aliases)  
• `drug_synonyms_v1.drugID`: obtain the numeric drugID for sorafenib  

• `interactions_v1.drugID`: link to the drugID found above  
• `interactions_v1.expID`: connect every interaction to its experimental record  
• `interactions_v1.targetID`, `interactions_v1.target_uniprotID`: identify every molecular target (UniProt) of sorafenib  
• `interactions_v1.targetSpecies`: keep only “Homo sapiens” targets  

• `experiments_v1.expID`: join to interactions_v1  
• `experiments_v1.exp_assayValueMedian`,
  `experiments_v1.exp_assayValueLow`,
  `experiments_v1.exp_assayValueHigh`: apply the potency filter  
     ‑ `exp_assayValueMedian <= 100`  
     ‑ `exp_assayValueLow <= 100 OR exp_assayValueLow IS NULL`  
     ‑ `exp_assayValueHigh <= 100 OR exp_assayValueHigh IS NULL`  

• `physical_entity_v77.uniprot_id`: map every sorafenib UniProt to the Reactome physical‑entity stable_id  
• `physical_entity_v77.stable_id`: Reactome physical entity identifier  

• `pe_to_pathway_v77.pe_stable_id`: connect a physical entity to a Reactome pathway  
• `pe_to_pathway_v77.pathway_stable_id`: the pathway to which it belongs  
• `pe_to_pathway_v77.evidence_code`: keep only rows whose evidence_code = 'TAS'  

• `pathway_v77.stable_id`: join to obtain pathway details  
• `pathway_v77.lowest_level`: retain only TRUE (lowest‑level) pathways  
• `pathway_v77.name`: for readable output  

Additional counts required for the χ² table  
• number of “targets in pathway” (a)  
• number of “targets NOT in pathway” (b)  
• number of “non‑targets in pathway” (c)  
• number of “non‑targets NOT in pathway” (d)  

Once those 2 × 2 counts are built, χ² = N × (ad – bc)² / (a + c)(b + d)(a + b)(c + d)  
where N = a + b + c + d.  

Below are ten exploratory–to–final BigQuery SQL statements (all use back‑ticked identifiers; each ends with LIMIT 20 for sampling or illustrative purposes).


```sql
-- 1.  Look up every synonym that contains the word “sorafenib”.
SELECT DISTINCT
  drugID,
  synonym
FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
WHERE LOWER(synonym) LIKE '%sorafenib%'
LIMIT 20;
```

```sql
-- 2.  Verify that the drugID obtained above really is “sorafenib”
--     by checking the main interactions table.
SELECT DISTINCT
  drugID,
  drugName
FROM `isb-cgc-bq.targetome_versioned.interactions_v1`
WHERE drugID IN (
  SELECT DISTINCT drugID
  FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
  WHERE LOWER(synonym) LIKE '%sorafenib%'
)
LIMIT 20;
```

```sql
-- 3.  Bring in experimental potency values that satisfy the ≤100 nM rule.
SELECT
  i.interactionID,
  i.drugID,
  i.targetID,
  i.target_uniprotID,
  e.exp_assayValueLow,
  e.exp_assayValueMedian,
  e.exp_assayValueHigh
FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
JOIN `isb-cgc-bq.targetome_versioned.experiments_v1` AS e
  ON i.expID = e.expID
WHERE i.drugID =  (
        SELECT DISTINCT drugID
        FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
        WHERE LOWER(synonym) LIKE '%sorafenib%'
        LIMIT 1
      )
  AND i.targetSpecies = 'Homo sapiens'
  AND e.exp_assayValueMedian <= 100
  AND (e.exp_assayValueLow   <= 100 OR e.exp_assayValueLow   IS NULL)
  AND (e.exp_assayValueHigh  <= 100 OR e.exp_assayValueHigh  IS NULL)
LIMIT 20;
```

```sql
-- 4.  Collapse to unique sorafenib (human) target UniProt IDs.
SELECT DISTINCT
  target_uniprotID
FROM (
  /* re‑use the potency‑filtered query (shown above) */
  SELECT
    i.target_uniprotID
  FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
  JOIN `isb-cgc-bq.targetome_versioned.experiments_v1` AS e
    ON i.expID = e.expID
  WHERE i.drugID = (
          SELECT DISTINCT drugID
          FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
          WHERE LOWER(synonym) LIKE '%sorafenib%'
          LIMIT 1
        )
    AND i.targetSpecies = 'Homo sapiens'
    AND e.exp_assayValueMedian <= 100
    AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
    AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
)
LIMIT 20;
```

```sql
-- 5.  Map those UniProt IDs to all Reactome physical‑entity stable_ids.
SELECT DISTINCT
  p.uniprot_id,
  p.stable_id AS pe_stable_id
FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
JOIN (
  /* unique sorafenib target UniProts from step 4 */
  SELECT DISTINCT target_uniprotID
  FROM (
    SELECT
      i.target_uniprotID
    FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
    JOIN `isb-cgc-bq.targetome_versioned.experiments_v1` AS e
      ON i.expID = e.expID
    WHERE i.drugID = (
            SELECT DISTINCT drugID
            FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
            WHERE LOWER(synonym) LIKE '%sorafenib%'
            LIMIT 1
          )
      AND i.targetSpecies = 'Homo sapiens'
      AND e.exp_assayValueMedian <= 100
      AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
      AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
  )
) AS s
  ON p.uniprot_id = s.target_uniprotID
LIMIT 20;
```

```sql
-- 6.  Attach TAS‑supported pathways for every physical entity collected above.
SELECT DISTINCT
  ptp.pathway_stable_id,
  ptp.pe_stable_id
FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptp
JOIN (
  /* physical entities of sorafenib targets */
  SELECT DISTINCT p.stable_id AS pe_stable_id
  FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
  JOIN (
    SELECT DISTINCT target_uniprotID
      FROM (
        SELECT
          i.target_uniprotID
        FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
        JOIN `isb-cgc-bq.targetome_versioned.experiments_v1` AS e
          ON i.expID = e.expID
        WHERE i.drugID = (
                SELECT DISTINCT drugID
                  FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                 WHERE LOWER(synonym) LIKE '%sorafenib%'
                 LIMIT 1
              )
          AND i.targetSpecies = 'Homo sapiens'
          AND e.exp_assayValueMedian <= 100
          AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
          AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
      )
  ) AS s
    ON p.uniprot_id = s.target_uniprotID
) AS target_pe
  ON ptp.pe_stable_id = target_pe.pe_stable_id
WHERE ptp.evidence_code = 'TAS'
LIMIT 20;
```

```sql
-- 7.  Keep only lowest‑level pathways and show their names.
SELECT DISTINCT
  pw.stable_id      AS pathway_id,
  pw.name           AS pathway_name,
  pw.lowest_level
FROM `isb-cgc-bq.reactome_versioned.pathway_v77` AS pw
WHERE pw.lowest_level = TRUE
  AND pw.stable_id IN (
        SELECT DISTINCT pathway_stable_id
        FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`
        WHERE evidence_code = 'TAS'
      )
LIMIT 20;
```

```sql
-- 8.  For each lowest‑level TAS pathway, count sorafenib targets inside.
WITH sorafenib_targets AS (
  SELECT DISTINCT pe.stable_id AS pe_stable_id
  FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS pe
  JOIN (
    SELECT DISTINCT target_uniprotID
      FROM (
        SELECT
          i.target_uniprotID
        FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
        JOIN `isb-cgc-bq.targetome_versioned.experiments_v1` AS e
          ON i.expID = e.expID
        WHERE i.drugID = (
                SELECT DISTINCT drugID
                FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                WHERE LOWER(synonym) LIKE '%sorafenib%'
                LIMIT 1
              )
          AND i.targetSpecies = 'Homo sapiens'
          AND e.exp_assayValueMedian <= 100
          AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
          AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
      )
  ) AS t
    ON pe.uniprot_id = t.target_uniprotID
)
SELECT
  pw.stable_id AS pathway_id,
  pw.name      AS pathway_name,
  COUNT(DISTINCT s.pe_stable_id) AS targets_in_pathway
FROM sorafenib_targets AS s
JOIN `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptp
  ON ptp.pe_stable_id = s.pe_stable_id
JOIN `isb-cgc-bq.reactome_versioned.pathway_v77` AS pw
  ON pw.stable_id = ptp.pathway_stable_id
WHERE ptp.evidence_code = 'TAS'
  AND pw.lowest_level = TRUE
GROUP BY pathway_id, pathway_name
ORDER BY targets_in_pathway DESC
LIMIT 20;
```

```sql
-- 9.  Build full 2×2 contingency counts for every qualifying pathway.
WITH all_protein_pe AS (
  SELECT DISTINCT stable_id AS pe_stable_id
  FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77`
  WHERE uniprot_id IS NOT NULL
),
sorafenib_targets AS (
  SELECT DISTINCT pe.stable_id AS pe_stable_id
  FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS pe
  JOIN (
    SELECT DISTINCT target_uniprotID
      FROM (
        SELECT
          i.target_uniprotID
        FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
        JOIN `isb-cgc-bq.targetome_versioned.experiments_v1` AS e
          ON i.expID = e.expID
        WHERE i.drugID = (
                SELECT DISTINCT drugID
                FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                WHERE LOWER(synonym) LIKE '%sorafenib%'
                LIMIT 1
              )
          AND i.targetSpecies = 'Homo sapiens'
          AND e.exp_assayValueMedian <= 100
          AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
          AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
      )
  ) AS t
    ON pe.uniprot_id = t.target_uniprotID
),
pathway_members AS (
  SELECT DISTINCT
    ptp.pathway_stable_id,
    ptp.pe_stable_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptp
  WHERE ptp.evidence_code = 'TAS'
),
lowest_level_pathway AS (
  SELECT stable_id, name
  FROM `isb-cgc-bq.reactome_versioned.pathway_v77`
  WHERE lowest_level = TRUE
)
SELECT
  llp.stable_id  AS pathway_id,
  llp.name       AS pathway_name,
  -- a: targets inside
  COUNTIF( st.pe_stable_id IS NOT NULL )                              AS a_targets_in,
  -- b: targets outside
  (SELECT COUNT(*) FROM sorafenib_targets) - COUNTIF( st.pe_stable_id IS NOT NULL ) AS b_targets_out,
  -- c: non‑targets inside
  COUNTIF( st.pe_stable_id IS NULL )                                  AS c_nontargets_in,
  -- d: non‑targets outside
  (SELECT COUNT(*) FROM all_protein_pe) 
      - (SELECT COUNT(*) FROM sorafenib_targets)
      - COUNTIF( st.pe_stable_id IS NULL )                            AS d_nontargets_out
FROM lowest_level_pathway AS llp
LEFT JOIN pathway_members AS pm
       ON llp.stable_id = pm.pathway_stable_id
LEFT JOIN sorafenib_targets AS st
       ON pm.pe_stable_id = st.pe_stable_id
GROUP BY pathway_id, pathway_name
HAVING a_targets_in > 0   -- need at least one target inside
ORDER BY a_targets_in DESC
LIMIT 20;
