lowest_level_pathway AS (
  SELECT stable_id, name
  FROM `isb-cgc-bq.reactome_versioned.pathway_v77`
  WHERE lowest_level = TRUE
),
contingency AS (
  SELECT
    llp.stable_id  AS pathway_id,
    llp.name       AS pathway_name,
    -- counts
    COUNTIF( st.pe_stable_id IS NOT NULL )                               AS a_targets_in,
    (SELECT COUNT(*) FROM sorafenib_targets) 
      - COUNTIF( st.pe_stable_id IS NOT NULL )                           AS b_targets_out,
    COUNTIF( st.pe_stable_id IS NULL )                                   AS c_nontargets_in,
    (SELECT COUNT(*) FROM all_protein_pe) 
      - (SELECT COUNT(*) FROM sorafenib_targets)
      - COUNTIF( st.pe_stable_id IS NULL )                               AS d_nontargets_out
  FROM lowest_level_pathway AS llp
  LEFT JOIN pathway_members  AS pm
         ON llp.stable_id = pm.pathway_stable_id
  LEFT JOIN sorafenib_targets AS st
         ON pm.pe_stable_id = st.pe_stable_id
  GROUP BY pathway_id, pathway_name
  HAVING a_targets_in > 0
),
chi_sq AS (
  SELECT
    pathway_id,
    pathway_name,
    a_targets_in AS a,
    b_targets_out AS b,
    c_nontargets_in AS c,
    d_nontargets_out AS d,
    -- total N
    (a_targets_in + b_targets_out + c_nontargets_in + d_nontargets_out) AS N,
    -- χ² formula
    ( (a_targets_in * d_nontargets_out - b_targets_out * c_nontargets_in) *
      (a_targets_in * d_nontargets_out - b_targets_out * c_nontargets_in) )
      * (a_targets_in + b_targets_out + c_nontargets_in + d_nontargets_out)
      / (
          (a_targets_in + c_nontargets_in)
        * (b_targets_out + d_nontargets_out)
        * (a_targets_in + b_targets_out)
        * (c_nontargets_in + d_nontargets_out)
        )                                                               AS chi_squared
  FROM contingency
)
SELECT
  pathway_id,
  pathway_name,
  a AS targets_in_pathway,
  b AS targets_outside_pathway,
  c AS nontargets_in_pathway,
  d AS nontargets_outside_pathway,
  chi_squared
FROM chi_sq
ORDER BY chi_squared DESC
LIMIT 3;
