```sql
/*  ► 3 lowest‑level Reactome pathways whose TAS‑supported membership is most
       enriched for high‑affinity (≤100 nM) Homo sapiens sorafenib targets   */
WITH
---------------------------------------------------------------------------
-- 1. sorafenib drugID ------------------------------------------------------
sorafenib AS (
  SELECT DISTINCT drugID
  FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
  WHERE LOWER(synonym) LIKE '%sorafenib%'
),
---------------------------------------------------------------------------
-- 2. high‑affinity human sorafenib targets (UniProt IDs) -------------------
sora_uids AS (
  SELECT DISTINCT i.target_uniprotID
  FROM   `isb-cgc-bq.targetome_versioned.interactions_v1`  AS i
  JOIN   `isb-cgc-bq.targetome_versioned.experiments_v1`   AS e
         ON  i.expID = e.expID
  WHERE  i.drugID IN (SELECT drugID FROM sorafenib)
    AND  i.targetSpecies = 'Homo sapiens'
    AND  e.exp_assayValueMedian <= 100
    AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
    AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
),
---------------------------------------------------------------------------
-- 3. Reactome physical entities representing those targets ----------------
sora_pe AS (
  SELECT DISTINCT pe.stable_id AS pe_id
  FROM   `isb-cgc-bq.reactome_versioned.physical_entity_v77` pe
  JOIN   sora_uids u
         ON pe.uniprot_id = u.target_uniprotID
),
---------------------------------------------------------------------------
-- 4. Universe of all protein physical entities ----------------------------
all_protein_pe AS (
  SELECT DISTINCT stable_id AS pe_id
  FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77`
  WHERE uniprot_id IS NOT NULL
),
---------------------------------------------------------------------------
-- 5. TAS‑supported pathway–entity membership ------------------------------
tas_membership AS (
  SELECT DISTINCT ptp.pathway_stable_id AS pw_id,
                  ptp.pe_stable_id      AS pe_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` ptp
  WHERE ptp.evidence_code = 'TAS'
),
---------------------------------------------------------------------------
-- 6. keep only lowest‑level pathways --------------------------------------
lowest_pathways AS (
  SELECT stable_id AS pw_id,
         name      AS pw_name
  FROM   `isb-cgc-bq.reactome_versioned.pathway_v77`
  WHERE  lowest_level = TRUE
),
---------------------------------------------------------------------------
-- 7. 2×2 table counts for every pathway -----------------------------------
cont_table AS (
  SELECT
    lp.pw_id,
    lp.pw_name,
    COUNTIF( sp.pe_id IS NOT NULL )                                            AS a_targets_in,
    (SELECT COUNT(*) FROM sora_pe) - COUNTIF( sp.pe_id IS NOT NULL )           AS b_targets_out,
    COUNTIF( sp.pe_id IS NULL )                                                AS c_nontargets_in,
    (SELECT COUNT(*) FROM all_protein_pe)
      - (SELECT COUNT(*) FROM sora_pe)
      - COUNTIF( sp.pe_id IS NULL )                                            AS d_nontargets_out
  FROM   lowest_pathways lp
  LEFT JOIN tas_membership tm     ON lp.pw_id = tm.pw_id
  LEFT JOIN sora_pe       sp      ON tm.pe_id = sp.pe_id
  GROUP BY lp.pw_id, lp.pw_name
  HAVING a_targets_in > 0                      -- pathway must contain ≥1 target
),
---------------------------------------------------------------------------
-- 8. χ² statistic ----------------------------------------------------------
chi_sq AS (
  SELECT
    pw_id,
    pw_name,
    a_targets_in      AS a,
    b_targets_out     AS b,
    c_nontargets_in   AS c,
    d_nontargets_out  AS d,
    -- Pearson χ² (1 df) for 2×2 table
    ( (a*d - b*c)*(a*d - b*c) )
      * (a+b+c+d)
      / ( (a+c) * (b+d) * (a+b) * (c+d) )                                      AS chi2
  FROM cont_table
)
---------------------------------------------------------------------------
-- 9. final answer ----------------------------------------------------------
SELECT
  pw_id   AS reactome_pathway_id,
  pw_name AS reactome_pathway_name,
  a       AS targets_in_pathway,
  b       AS targets_outside_pathway,
  c       AS nontargets_in_pathway,
  d       AS nontargets_outside_pathway
FROM chi_sq
ORDER BY chi2 DESC, pw_id
LIMIT 3;
```
