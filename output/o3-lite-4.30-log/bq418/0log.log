-- 10.  Compute χ² for every pathway and output the three highest values.
WITH soraf_targets AS (
      SELECT DISTINCT p.stable_id AS pe_stable_id
      FROM   `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
      JOIN   `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
             ON i.expID = e.expID
      JOIN   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
             ON i.target_uniprotID = p.uniprot_id
      WHERE  LOWER(i.drugName) LIKE '%sorafenib%'
        AND  i.targetSpecies = 'Homo sapiens'
        AND  e.exp_assayUnits = 'nM'
        AND  e.exp_assayValueMedian <= 100
        AND  (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
        AND  (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
), tas_map AS (
      SELECT pe_stable_id,
             pathway_stable_id
      FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`
      WHERE  evidence_code = 'TAS'
), lowest_human_paths AS (
      SELECT stable_id, name
      FROM   `isb-cgc-bq.reactome_versioned.pathway_v77`
      WHERE  species = 'Homo sapiens'
        AND  lowest_level = TRUE
), totals AS (
      SELECT COUNT(DISTINCT pe_stable_id) AS total_pe
      FROM   tas_map
)
SELECT p.stable_id                AS pathway_id,
       p.name                     AS pathway_name,
       a_targets_in,
       b_targets_out,
       c_nontargets_in,
       d_nontargets_out,
       -- χ² = Σ (O‑E)² / E ;  here we compute it in a 2×2 contingency
       (
         (POW(a_targets_in -
              ( (a_targets_in + b_targets_out) *
                (a_targets_in + c_nontargets_in) /
                (a_targets_in + b_targets_out + c_nontargets_in + d_nontargets_out)
               ), 2)
          /
              ( (a_targets_in + b_targets_out) *
                (a_targets_in + c_nontargets_in) /
                (a_targets_in + b_targets_out + c_nontargets_in + d_nontargets_out)
              )
         )
         +
         (POW(b_targets_out -
              ( (a_targets_in + b_targets_out) *
                (b_targets_out + d_nontargets_out) /
                (a_targets_in + b_targets_out + c_nontargets_in + d_nontargets_out)
               ), 2)
          /
              ( (a_targets_in + b_targets_out) *
                (b_targets_out + d_nontargets_out) /
                (a_targets_in + b_targets_out + c_nontargets_in + d_nontargets_out)
              )
         )
         +
         (POW(c_nontargets_in -
              ( (c_nontargets_in + d_nontargets_out) *
                (a_targets_in + c_nontargets_in) /
                (a_targets_in + b_targets_out + c_nontargets_in + d_nontargets_out)
               ), 2)
          /
              ( (c_nontargets_in + d_nontargets_out) *
                (a_targets_in + c_nontargets_in) /
                (a_targets_in + b_targets_out + c_nontargets_in + d_nontargets_out)
              )
         )
         +
         (POW(d_nontargets_out -
              ( (c_nontargets_in + d_nontargets_out) *
                (b_targets_out + d_nontargets_out) /
                (a_targets_in + b_targets_out + c_nontargets_in + d_nontargets_out)
               ), 2)
          /
              ( (c_nontargets_in + d_nontargets_out) *
                (b_targets_out + d_nontargets_out) /
                (a_targets_in + b_targets_out + c_nontargets_in + d_nontargets_out)
              )
         )
       ) AS chi_squared
FROM (
      -- build the four cells a, b, c, d
      SELECT p.stable_id,
             COUNT(DISTINCT CASE WHEN st.pe_stable_id IS NOT NULL THEN tas.pe_stable_id END) AS a_targets_in,
             COUNT(DISTINCT st.pe_stable_id) -
             COUNT(DISTINCT CASE WHEN st.pe_stable_id IS NOT NULL THEN tas.pe_stable_id END) AS b_targets_out,
             COUNT(DISTINCT CASE WHEN st.pe_stable_id IS NULL THEN tas.pe_stable_id END)     AS c_nontargets_in,
             (SELECT total_pe FROM totals) -
             COUNT(DISTINCT st.pe_stable_id) -
             COUNT(DISTINCT CASE WHEN st.pe_stable_id IS NULL THEN tas.pe_stable_id END)     AS d_nontargets_out
      FROM   lowest_human_paths AS p
      LEFT JOIN tas_map AS tas
             ON p.stable_id = tas.pathway_stable_id
      LEFT JOIN soraf_targets AS st
             ON tas.pe_stable_id = st.pe_stable_id
      GROUP BY p.stable_id
) AS table4
JOIN lowest_human_paths AS p
  ON p.stable_id = table4.stable_id
ORDER BY chi_squared DESC
LIMIT 3;
