-- THINKING PROCESS (embedded as comments):
-- Goal:  Find the three lowest‑level Homo sapiens Reactome pathways (TAS evidence)
--        that show the strongest enrichment for potent (≤100 nM) sorafenib targets,
--        measured with a χ² statistic.  Also return the four cell counts (a,b,c,d).
--
-- Outline
--   1) Identify potent Homo sapiens sorafenib targets in Targetome and translate
--      their UniProt IDs to Reactome physical‑entity (PE) IDs.
--   2) From Reactome, keep PE→pathway links that have evidence_code = 'TAS'.
--   3) Keep only pathways that are (a) Homo sapiens and (b) lowest_level = TRUE.
--   4) For every such pathway build a 2×2 contingency table:
--        a = # sorafenib‑PEs inside pathway
--        b = # sorafenib‑PEs outside pathway
--        c = # non‑target PEs inside pathway
--        d = # non‑target PEs outside pathway
--   5) Compute χ² = Σ (O‑E)² / E, protecting all divisions with SAFE_DIVIDE.
--   6) Return the three pathways with the largest χ² together with a,b,c,d.
--
-- Notes
--   • SAFE_DIVIDE(x,y) returns NULL if y = 0, so every term is wrapped with
--     COALESCE( … , 0 ) to contribute zero when expected count = 0.
--   • “low” or “high” potency values may be NULL; those rows are still allowed.
--   • All joins are inner unless otherwise stated; LEFT JOIN is used so that
--     every candidate pathway is kept even if it has zero sorafenib targets.

WITH
/* Step 1: potent Homo sapiens sorafenib targets → physical entities */
soraf_targets AS (
  SELECT DISTINCT pe.stable_id AS pe_stable_id
  FROM   `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
  JOIN   `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
         ON i.expID = e.expID
  JOIN   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS pe
         ON i.target_uniprotID = pe.uniprot_id
  WHERE  LOWER(i.drugName) LIKE '%sorafenib%'          -- sorafenib only
    AND  i.targetSpecies = 'Homo sapiens'              -- human targets
    AND  e.exp_assayUnits = 'nM'                       -- potency in nM
    AND  e.exp_assayValueMedian <= 100
    AND  (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
    AND  (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
),
/* Step 2: TAS PE→pathway mapping */
tas_map AS (
  SELECT pe_stable_id, pathway_stable_id
  FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`
  WHERE  evidence_code = 'TAS'
),
/* Step 3: candidate pathways = Homo sapiens lowest‑level */
candidate_paths AS (
  SELECT stable_id, name
  FROM   `isb-cgc-bq.reactome_versioned.pathway_v77`
  WHERE  species = 'Homo sapiens'
    AND  lowest_level = TRUE
),
/* total number of unique TAS PEs (for the 'd' cell) */
total_pe AS (
  SELECT COUNT(DISTINCT pe_stable_id) AS N
  FROM   tas_map
),
/* Step 4: a,b,c,d counts for every candidate pathway */
contingency AS (
  SELECT
    cp.stable_id                                                                    AS pathway_id,
    cp.name                                                                         AS pathway_name,
    COUNT(DISTINCT CASE WHEN st.pe_stable_id IS NOT NULL THEN tas.pe_stable_id END) AS a,    -- targets in
    COUNT(DISTINCT st.pe_stable_id) -
    COUNT(DISTINCT CASE WHEN st.pe_stable_id IS NOT NULL THEN tas.pe_stable_id END) AS b,    -- targets out
    COUNT(DISTINCT CASE WHEN st.pe_stable_id IS NULL THEN tas.pe_stable_id END)     AS c,    -- non‑targets in
    tp.N -
    COUNT(DISTINCT st.pe_stable_id) -
    COUNT(DISTINCT CASE WHEN st.pe_stable_id IS NULL THEN tas.pe_stable_id END)     AS d     -- non‑targets out
  FROM   candidate_paths AS cp
  LEFT  JOIN tas_map       AS tas ON cp.stable_id    = tas.pathway_stable_id
  LEFT  JOIN soraf_targets AS st  ON tas.pe_stable_id = st.pe_stable_id
  CROSS JOIN total_pe      AS tp
  GROUP BY cp.stable_id, cp.name, tp.N
),
/* Step 5: χ² calculation with SAFE_DIVIDE to avoid /0 */
scored AS (
  SELECT
    pathway_id,
    pathway_name,
    a, b, c, d,
    -- row, column, grand totals
    (a + b) AS R1,
    (c + d) AS R2,
    (a + c) AS C1,
    (b + d) AS C2,
    (a + b + c + d) AS N
  FROM contingency
),
chi_squared AS (
  SELECT
    pathway_id,
    pathway_name,
    a, b, c, d,
    -- expected counts
    SAFE_DIVIDE(R1 * C1, N) AS Ea,
    SAFE_DIVIDE(R1 * C2, N) AS Eb,
    SAFE_DIVIDE(R2 * C1, N) AS Ec,
    SAFE_DIVIDE(R2 * C2, N) AS Ed,
    -- χ² sum (each term → 0 when expected = 0)
    COALESCE(SAFE_DIVIDE(POW(a - SAFE_DIVIDE(R1 * C1, N), 2), SAFE_DIVIDE(R1 * C1, N)), 0)
  + COALESCE(SAFE_DIVIDE(POW(b - SAFE_DIVIDE(R1 * C2, N), 2), SAFE_DIVIDE(R1 * C2, N)), 0)
  + COALESCE(SAFE_DIVIDE(POW(c - SAFE_DIVIDE(R2 * C1, N), 2), SAFE_DIVIDE(R2 * C1, N)), 0)
  + COALESCE(SAFE_DIVIDE(POW(d - SAFE_DIVIDE(R2 * C2, N), 2), SAFE_DIVIDE(R2 * C2, N)), 0)
    AS chi_sq
  FROM scored
)
/* Step 6: output top‑3 χ² pathways with counts */
SELECT
  pathway_id,
  pathway_name,
  a AS targets_in_pathway,
  b AS targets_outside_pathway,
  c AS nontargets_in_pathway,
  d AS nontargets_outside_pathway,
  chi_sq AS chi_squared
FROM chi_squared
ORDER BY chi_sq DESC
LIMIT 3;
