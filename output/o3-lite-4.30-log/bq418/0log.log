FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ppv
JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`        AS pv
     ON ppv.pathway_stable_id = pv.stable_id
WHERE ppv.evidence_code = 'TAS'
  AND pv.species       = 'Homo sapiens'
