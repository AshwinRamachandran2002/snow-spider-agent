  FROM potent_targets AS t
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
    ON t.target_uniprotID = p.uniprot_id
),
tas_map AS (                 -- TAS‑supported PE ↔ pathway mapping
  SELECT pe_stable_id, pathway_stable_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`
  WHERE evidence_code = 'TAS'
),
soraf_pe_tas AS (            -- potent targets that ALSO have TAS evidence
  SELECT DISTINCT sp.stable_id AS pe_stable_id
  FROM soraf_pe                AS sp
  JOIN tas_map                 AS tm
    ON sp.stable_id = tm.pe_stable_id
),
lowest_human_paths AS (      -- only lowest‑level Homo‑sapiens pathways
  SELECT stable_id, name
  FROM `isb-cgc-bq.reactome_versioned.pathway_v77`
  WHERE species = 'Homo sapiens'
    AND lowest_level = TRUE
),
totals AS (                  -- numbers used in every 2×2 table
  SELECT
    (SELECT COUNT(DISTINCT pe_stable_id) FROM soraf_pe_tas) AS n_targets,
    (SELECT COUNT(DISTINCT pe_stable_id) FROM tas_map)      AS n_total_pe
),
path_stats AS (              -- entities & targets present in each pathway
  SELECT
    p.stable_id                                       AS pathway_id,
    p.name                                            AS pathway_name,
    COUNT(DISTINCT tm.pe_stable_id)                   AS entities_in_pathway,
    COUNT(DISTINCT CASE
           WHEN spt.pe_stable_id IS NOT NULL
           THEN tm.pe_stable_id END)                  AS targets_in_pathway
  FROM lowest_human_paths          AS p
  LEFT JOIN tas_map                AS tm  ON tm.pathway_stable_id = p.stable_id
  LEFT JOIN soraf_pe_tas           AS spt ON spt.pe_stable_id     = tm.pe_stable_id
  GROUP BY pathway_id, pathway_name
),
contingency AS (             -- build the 2×2 components a,b,c,d for χ²
  SELECT
    ps.pathway_id,
    ps.pathway_name,
    ps.targets_in_pathway                                   AS a,                          -- targets in
    (t.n_targets - ps.targets_in_pathway)                   AS b,                          -- targets out
    (ps.entities_in_pathway - ps.targets_in_pathway)        AS c,                          -- non‑targets in
    (t.n_total_pe - t.n_targets
       - (ps.entities_in_pathway - ps.targets_in_pathway))  AS d                           -- non‑targets out
  FROM path_stats AS ps
  CROSS JOIN totals  AS t
  WHERE ps.entities_in_pathway > 0
),
chi2 AS (                   -- compute χ² statistic
  SELECT
    pathway_id,
    pathway_name,
    a, b, c, d,
    (POWER(a * d - b * c, 2) * (a + b + c + d)) /
      ( (a + b) * (c + d) * (a + c) * (b + d) )            AS chi_sq
  FROM contingency
)
SELECT
  pathway_id   AS reactome_pathway_id,
  pathway_name AS reactome_pathway_name,
  a            AS targets_in_pathway,
  b            AS targets_outside_pathway,
  c            AS nontargets_in_pathway,
  d            AS nontargets_outside_pathway
FROM chi2
ORDER BY chi_sq DESC, pathway_id
LIMIT 3;
