WITH sorafenib_drug AS (
  SELECT DISTINCT drugID
  FROM `isb-cgc-bq.targetome_versioned.interactions_v1`
  WHERE LOWER(drugName) LIKE '%sorafenib%'
),
potent_targets AS (           -- sorafenib targets ≤100 nM, Homo sapiens
  SELECT DISTINCT i.target_uniprotID
  FROM `isb-cgc-bq.targetome_versioned.interactions_v1`  i
  JOIN sorafenib_drug                                    d  ON i.drugID = d.drugID
  JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`   e  ON i.expID  = e.expID
  WHERE i.targetSpecies = 'Homo sapiens'
    AND e.exp_assayUnits       = 'nM'
    AND e.exp_assayValueMedian <= 100
    AND (e.exp_assayValueLow   <= 100 OR e.exp_assayValueLow  IS NULL)
    AND (e.exp_assayValueHigh  <= 100 OR e.exp_assayValueHigh IS NULL)
),
soraf_pe AS (                -- Reactome physical entities of potent targets
  SELECT DISTINCT p.stable_id AS pe_stable_id
  FROM potent_targets t
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` p
    ON t.target_uniprotID = p.uniprot_id
),
tas_map AS (                 -- TAS‑supported PE‑to‑pathway mapping
  SELECT pe_stable_id, pathway_stable_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`
  WHERE evidence_code = 'TAS'
),
lowest_human_paths AS (      -- lowest‑level Homo sapiens pathways
  SELECT stable_id, name
  FROM `isb-cgc-bq.reactome_versioned.pathway_v77`
  WHERE species = 'Homo sapiens'
    AND lowest_level = TRUE
),
totals AS (
  SELECT
    (SELECT COUNT(DISTINCT pe_stable_id) FROM soraf_pe) AS n_targets,
    (SELECT COUNT(DISTINCT pe_stable_id) FROM tas_map)  AS n_total_pe
),
path_stats AS (              -- counts per pathway
  SELECT
    p.stable_id                                       AS pathway_id,
    p.name                                            AS pathway_name,
    COUNT(DISTINCT tas.pe_stable_id)                  AS entities_in_pathway,
    COUNT(DISTINCT CASE WHEN sp.pe_stable_id IS NOT NULL
                        THEN tas.pe_stable_id END)    AS targets_in
  FROM lowest_human_paths p
  LEFT JOIN tas_map   tas ON tas.pathway_stable_id = p.stable_id
  LEFT JOIN soraf_pe  sp  ON sp.pe_stable_id       = tas.pe_stable_id
  GROUP BY pathway_id, pathway_name
),
contingency AS (            -- 2×2 table components
  SELECT
    ps.pathway_id,
    ps.pathway_name,
    ps.targets_in                                           AS a,          -- targets in pathway
    (t.n_targets - ps.targets_in)                           AS b,          -- targets outside
    (ps.entities_in_pathway - ps.targets_in)                AS c,          -- non‑targets in
    (t.n_total_pe - t.n_targets
      - (ps.entities_in_pathway - ps.targets_in))           AS d           -- non‑targets out
  FROM path_stats ps
  CROSS JOIN totals t
  WHERE ps.entities_in_pathway > 0
),
chi2 AS (                   -- χ² using 2×2 shortcut formula
  SELECT
    pathway_id,
    pathway_name,
    a, b, c, d,
    (POWER(a * d - b * c, 2) * (a + b + c + d)) /
    ( (a + b) * (c + d) * (a + c) * (b + d) )              AS chi_sq
  FROM contingency
)
SELECT
  pathway_id          AS reactome_pathway_id,
  pathway_name        AS reactome_pathway_name,
  a                   AS targets_in_pathway,
  b                   AS targets_outside_pathway,
  c                   AS nontargets_in_pathway,
  d                   AS nontargets_outside_pathway
FROM chi2
ORDER BY chi_sq DESC, pathway_id
LIMIT 3;
```
