SELECT COALESCE(p."Gender", 'Unknown') AS gender,
       COUNT(*)                        AS cast_rows
FROM   "M_Cast" AS mc
JOIN   "Person" AS p
       ON TRIM(mc."PID") = p."PID"
GROUP  BY COALESCE(p."Gender", 'Unknown')
ORDER  BY cast_rows DESC;
