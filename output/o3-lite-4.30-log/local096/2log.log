Begin Exploring Related Columns
Relevant tables, columns, and typical conditions  

Movie  
• MID : movie identifier, used to join with M_Cast  
• year : take the last 4 characters (substr("year",‑3)) to group by year  
• title : only for readability  

M_Cast  
• MID : movie identifier to join back to Movie  
• PID : person identifier to join to Person  

Person  
• PID : person identifier to join with M_Cast  
• Gender : actor’s gender  
    – ‘Female’  → qualifies as female actor  
    – ‘Male’ OR ‘None’ (or any value other than ‘Female’) → counts as non‑female  

Typical conditions  
• Person."Gender" = 'Female'            -- select only female actors  
• Person."Gender" <> 'Female'           -- select actors that disqualify the movie  
• substr(Movie."year",‑3) AS yr         -- extract the numeric year (‘2018’, ‘2019’, …)  

Exploratory SQLs – from the simplest inspection to the final computation  

```sql
-- 1. Distinct recorded gender values in the Person table (sanity‑check).
SELECT DISTINCT "Gender"
FROM "Person"
LIMIT 20;
```

```sql
-- 2. Distinct movie‐years (last 4 characters of Movie.year).
SELECT DISTINCT substr("year", -4) AS yr
FROM "Movie"
ORDER BY yr
LIMIT 20;
```

```sql
-- 3. Sample list of movies with the extracted year.
SELECT "MID", "title", substr("year", -4) AS yr
FROM "Movie"
LIMIT 20;
```

```sql
-- 4. For the first 20 movies, how many total cast members are recorded?
SELECT m."MID", m."title", COUNT(c."PID") AS cast_cnt
FROM "Movie" AS m
LEFT JOIN "M_Cast" AS c ON m."MID" = c."MID"
GROUP BY m."MID"
LIMIT 20;
```

```sql
-- 5. Show each actor’s gender for the first 20 (movie, actor) pairs.
SELECT c."MID", p."PID", p."Gender"
FROM "M_Cast" AS c
JOIN "Person" AS p ON c."PID" = p."PID"
LIMIT 20;
```

```sql
-- 6. Movies that have at least one NON‑female actor (male or unknown).
SELECT DISTINCT c."MID"
FROM "M_Cast" AS c
JOIN "Person" AS p ON c."PID" = p."PID"
WHERE p."Gender" <> 'Female'
LIMIT 20;
```

```sql
-- 7. Movies whose casts are ALL female (no male/unknown in the cast list).
SELECT m."MID", m."title"
FROM "Movie" AS m
WHERE NOT EXISTS (
        SELECT 1
        FROM "M_Cast" AS c
        JOIN "Person" AS p ON c."PID" = p."PID"
        WHERE c."MID" = m."MID"
          AND p."Gender" <> 'Female'
)
LIMIT 20;
```

```sql
-- 8. Total number of movies in each year (first 20 rows).
SELECT substr("year", -4) AS yr, COUNT(*) AS total_movies
FROM "Movie"
GROUP BY yr
ORDER BY yr
LIMIT 20;
```

```sql
-- 9. Number of exclusively‑female‑cast movies per year (first 20 rows).
WITH female_only AS (
    SELECT m."MID"
    FROM "Movie" AS m
    WHERE NOT EXISTS (
            SELECT 1
            FROM "M_Cast" AS c
            JOIN "Person" AS p ON c."PID" = p."PID"
            WHERE c."MID" = m."MID"
              AND p."Gender" <> 'Female'
    )
)
SELECT substr(m."year", -4) AS yr, COUNT(*) AS female_only_movies
FROM "Movie" AS m
JOIN female_only f ON f."MID" = m."MID"
GROUP BY yr
ORDER BY yr
LIMIT 20;
```

```sql
-- 10. Final result: for each year, total movies and percentage that have exclusively female actors.
WITH
total_per_year AS (
    SELECT substr("year", -4) AS yr, COUNT(*) AS total_movies
    FROM "Movie"
    GROUP BY yr
),
female_only AS (
    SELECT m."MID"
    FROM "Movie" AS m
    WHERE NOT EXISTS (
            SELECT 1
            FROM "M_Cast" AS c
            JOIN "Person" AS p ON c."PID" = p."PID"
            WHERE c."MID" = m."MID"
              AND p."Gender" <> 'Female'
    )
),
female_per_year AS (
    SELECT substr(m."year", -4) AS yr, COUNT(*) AS female_only_movies
    FROM "Movie" AS m
    JOIN female_only f ON f."MID" = m."MID"
    GROUP BY yr
)
SELECT t.yr,
       t.total_movies,
       ROUND(1.0 * COALESCE(f.female_only_movies, 0) / t.total_movies * 100, 2) AS pct_exclusively_female
FROM total_per_year AS t
LEFT JOIN female_per_year AS f USING (yr)
ORDER BY t.yr
LIMIT 20;
```
