              )
     ),
     female_per_year AS (
       SELECT substr(m."year", -4) AS yr,
              COUNT(*)             AS female_only_movies
       FROM   "Movie" AS m
       JOIN   female_only f ON f."MID" = m."MID"
       GROUP  BY yr
     )
SELECT t.yr,
       t.total_movies,
       ROUND(1.0 * COALESCE(f.female_only_movies, 0) / t.total_movies * 100, 2)
         AS pct_exclusively_female
FROM   total_per_year AS t
LEFT   JOIN female_per_year AS f USING (yr)
ORDER  BY t.yr
LIMIT 20
