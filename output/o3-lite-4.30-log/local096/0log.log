WITH female_only AS (
   SELECT m.MID
   FROM Movie AS m
   WHERE NOT EXISTS (
         SELECT 1
         FROM M_Cast AS mc
         JOIN Person AS p
               ON TRIM(mc.PID) = TRIM(p.PID)
         WHERE mc.MID = m.MID
           AND (p.Gender IS NULL OR TRIM(p.Gender) <> 'Female')
   )
)
SELECT CAST(substr(m.year, length(m.year) - 3) AS INTEGER) AS release_year,
       COUNT(*) AS female_only_movies
FROM Movie AS m
JOIN female_only AS fo ON m.MID = fo.MID
GROUP BY release_year
LIMIT 20;
