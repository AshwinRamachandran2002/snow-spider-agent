--Description:
-- 7. Identify movies that have *only* female performers.
--    Uses NOT EXISTS with TRIM() on both PID and Gender to avoid issues caused by
--    leading/trailing spaces.  Any movie for which a non‑female (or NULL) gender
--    cast member exists is excluded.
SELECT m.MID,
       m.title
FROM Movie AS m
WHERE NOT EXISTS (
      SELECT 1
      FROM M_Cast AS mc
      JOIN Person AS p
            ON TRIM(mc.PID) = TRIM(p.PID)
      WHERE mc.MID = m.MID
        AND (p.Gender IS NULL OR TRIM(p.Gender) <> 'Female')
)
LIMIT 20;
