FROM (
  SELECT SPLIT(REGEXP_REPLACE(tags, r'[<>]', ''), '><') AS tag_arr
  FROM android_q
), UNNEST(tag_arr) AS tag
GROUP BY tag
ORDER BY cnt DESC
LIMIT 20;
