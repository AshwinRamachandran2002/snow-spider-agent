['Bowler_Scores', 'Bowler_Scores_Archive', 'Bowlers', 'sqlite_sequence', 'Match_Games', 'Match_Games_Archive', 'Teams', 'Tournaments', 'Tournaments_Archive', 'Tourney_Matches', 'Tourney_Matches_Archive', 'WAZips']
Begin Exploring Related Columns
Relevant columns, their potential usage & important conditions
--------------------------------------------------------------
Bowler_Scores  
 • MatchID: to link each game to a tournament through Tourney_Matches  
 • GameNumber: to show which game within the match  
 • BowlerID: to identify the bowler  
 • HandiCapScore: must be ≤ 190 in the final answer  
 • WonGame: must be 1 (TRUE) in the final answer  

Bowlers  
 • BowlerID: joins to Bowler_Scores  
 • BowlerFirstName / BowlerLastName: returned in the output  

Tourney_Matches  
 • MatchID: joins to Bowler_Scores (and Match_Games if needed)  
 • TourneyID: joins to Tournaments  

Tournaments  
 • TourneyID: joins to Tourney_Matches  
 • TourneyDate / TourneyLocation: returned in the output  
   • TourneyLocation will be filtered to (Thunderbird Lanes, Totem Lanes, Bolero Lanes)

Typical filter conditions that will be used  
 • Bowler_Scores."WonGame" = 1  
 • Bowler_Scores."HandiCapScore" <= 190  
 • Tournaments."TourneyLocation" IN ('Thunderbird Lanes', 'Totem Lanes', 'Bolero Lanes')

Exploratory & step‑by‑step SQL queries
--------------------------------------

```sql
-- 1. List all distinct tournament locations that exist in the data (first 20)
SELECT DISTINCT "TourneyLocation"
FROM "Tournaments"
LIMIT 20;
```

```sql
-- 2. Preview handicap scores that are ≤ 200 for a sanity check
SELECT DISTINCT "HandiCapScore"
FROM "Bowler_Scores"
WHERE "HandiCapScore" <= 200
LIMIT 20;
```

```sql
-- 3. Show a sample of games that were actually WON with handicap ≤ 190
SELECT *
FROM "Bowler_Scores"
WHERE "WonGame" = 1
  AND "HandiCapScore" <= 190
LIMIT 20;
```

```sql
-- 4. Join bowlers’ names to their winning, ≤ 190 handicap games
SELECT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore"
FROM "Bowler_Scores" AS bs
JOIN "Bowlers"       AS b USING ("BowlerID")
WHERE bs."WonGame" = 1
  AND bs."HandiCapScore" <= 190
LIMIT 20;
```

```sql
-- 5. Add the tournament date & location to each such win
SELECT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyDate",
       t."TourneyLocation"
FROM "Bowler_Scores"  AS bs
JOIN "Bowlers"        AS b USING ("BowlerID")
JOIN "Tourney_Matches" AS tm USING ("MatchID")
JOIN "Tournaments"     AS t  USING ("TourneyID")
WHERE bs."WonGame" = 1
  AND bs."HandiCapScore" <= 190
LIMIT 20;
```

```sql
-- 6. Same as #5 but restricted to Thunderbird Lanes
SELECT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyDate",
       t."TourneyLocation"
FROM "Bowler_Scores"  AS bs
JOIN "Bowlers"        AS b USING ("BowlerID")
JOIN "Tourney_Matches" AS tm USING ("MatchID")
JOIN "Tournaments"     AS t  USING ("TourneyID")
WHERE bs."WonGame" = 1
  AND bs."HandiCapScore" <= 190
  AND t."TourneyLocation" = 'Thunderbird Lanes'
LIMIT 20;
```

```sql
-- 7. Same but for Bolero Lanes
SELECT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyDate",
       t."TourneyLocation"
FROM "Bowler_Scores"  AS bs
JOIN "Bowlers"        AS b USING ("BowlerID")
JOIN "Tourney_Matches" AS tm USING ("MatchID")
JOIN "Tournaments"     AS t  USING ("TourneyID")
WHERE bs."WonGame" = 1
  AND bs."HandiCapScore" <= 190
  AND t."TourneyLocation" = 'Bolero Lanes'
LIMIT 20;
```

```sql
-- 8. Same but for Totem Lanes
SELECT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyDate",
       t."TourneyLocation"
FROM "Bowler_Scores"  AS bs
JOIN "Bowlers"        AS b USING ("BowlerID")
JOIN "Tourney_Matches" AS tm USING ("MatchID")
JOIN "Tournaments"     AS t  USING ("TourneyID")
WHERE bs."WonGame" = 1
  AND bs."HandiCapScore" <= 190
  AND t."TourneyLocation" = 'Totem Lanes'
LIMIT 20;
```

```sql
-- 9. For each bowler, count how many qualifying wins they have at each location
SELECT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName",
       t."TourneyLocation",
       COUNT(*) AS wins_<=190
FROM "Bowler_Scores"  AS bs
JOIN "Bowlers"        AS b USING ("BowlerID")
JOIN "Tourney_Matches" AS tm USING ("MatchID")
JOIN "Tournaments"     AS t  USING ("TourneyID")
WHERE bs."WonGame" = 1
  AND bs."HandiCapScore" <= 190
  AND t."TourneyLocation" IN ('Thunderbird Lanes', 'Totem Lanes', 'Bolero Lanes')
GROUP BY b."BowlerID", t."TourneyLocation"
LIMIT 20;
```

```sql
-- 10. FINAL: bowlers who have at least one qualifying win (≤ 190) at ALL THREE locations,
-- and list the individual game records that satisfy the criteria
SELECT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyDate",
       t."TourneyLocation"
FROM "Bowler_Scores"  AS bs
JOIN "Bowlers"        AS b  USING ("BowlerID")
JOIN "Tourney_Matches" AS tm USING ("MatchID")
JOIN "Tournaments"     AS t  USING ("TourneyID")
WHERE bs."WonGame" = 1
  AND bs."HandiCapScore" <= 190
  AND t."TourneyLocation" IN ('Thunderbird Lanes', 'Totem Lanes', 'Bolero Lanes')
  AND b."BowlerID" IN (
      SELECT BowlerID
      FROM (
          SELECT b2."BowlerID",
                 t2."TourneyLocation"
          FROM "Bowler_Scores"  AS bs2
          JOIN "Tourney_Matches" AS tm2 USING ("MatchID")
          JOIN "Tournaments"     AS t2  USING ("TourneyID")
          WHERE bs2."WonGame" = 1
            AND bs2."HandiCapScore" <= 190
            AND t2."TourneyLocation" IN ('Thunderbird Lanes', 'Totem Lanes', 'Bolero Lanes')
          GROUP BY b2."BowlerID", t2."TourneyLocation"
      )
      GROUP BY BowlerID
      HAVING COUNT(DISTINCT "TourneyLocation") = 3
  )
ORDER BY b."BowlerID", t."TourneyLocation", bs."MatchID", bs."GameNumber"
LIMIT 20;
```

