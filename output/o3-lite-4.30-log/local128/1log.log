```sql
-- Description / Thinking process:
--  • Goal: count each bowler’s victories (WonGame = 1) with a handicap score ≤ 190
--    at the three venues of interest (Thunderbird, Totem, Bolero).
--  • Tables & joins:
--      Bowler_Scores  → provides game results, MatchID, BowlerID.
--      Bowlers        → gives first & last names (join on BowlerID).
--      Tourney_Matches→ links MatchID to a tournament (TourneyID).
--      Tournaments    → supplies TourneyLocation to filter the venues.
--  • Filters applied in WHERE:
--      bs.WonGame = 1            → only winning games.
--      bs.HandiCapScore ≤ 190    → score requirement.
--      t.TourneyLocation IN (…)   → only the three specified lanes.
--  • Aggregation:
--      GROUP BY bowler + location; COUNT(*) yields number of qualifying wins.
--  • LIMIT 20 just caps the preview.
SELECT
    b."BowlerID",
    b."BowlerFirstName",
    b."BowlerLastName",
    t."TourneyLocation",
    COUNT(*) AS wins_le_190
FROM "Bowler_Scores"      AS bs
JOIN "Bowlers"            AS b  USING ("BowlerID")
JOIN "Tourney_Matches"    AS tm USING ("MatchID")
JOIN "Tournaments"        AS t  USING ("TourneyID")
WHERE bs."WonGame" = 1
  AND bs."HandiCapScore" <= 190
  AND t."TourneyLocation" IN ('Thunderbird Lanes',
                              'Totem Lanes',
                              'Bolero Lanes')
GROUP BY
    b."BowlerID",
    t."TourneyLocation"
LIMIT 20;
```
