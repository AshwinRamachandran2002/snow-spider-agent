JOIN "Tourney_Matches" AS tm USING ("MatchID")
JOIN "Tournaments"     AS t  USING ("TourneyID")
WHERE bs."WonGame" = 1
  AND bs."HandiCapScore" <= 190
  AND t."TourneyLocation" = 'Bolero Lanes'
LIMIT 20;
```

```sql
-- 8. Same but for Totem Lanes
SELECT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyDate",
       t."TourneyLocation"
FROM "Bowler_Scores"  AS bs
JOIN "Bowlers"        AS b USING ("BowlerID")
JOIN "Tourney_Matches" AS tm USING ("MatchID")
JOIN "Tournaments"     AS t  USING ("TourneyID")
WHERE bs."WonGame" = 1
  AND bs."HandiCapScore" <= 190
  AND t."TourneyLocation" = 'Totem Lanes'
LIMIT 20;
```

```sql
-- 9. For each bowler, count how many qualifying wins they have at each location
SELECT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName",
       t."TourneyLocation",
       COUNT(*) AS wins_<=190
FROM "Bowler_Scores"  AS bs
JOIN "Bowlers"        AS b USING ("BowlerID")
JOIN "Tourney_Matches" AS tm USING ("MatchID")
JOIN "Tournaments"     AS t  USING ("TourneyID")
WHERE bs."WonGame" = 1
  AND bs."HandiCapScore" <= 190
  AND t."TourneyLocation" IN ('Thunderbird Lanes', 'Totem Lanes', 'Bolero Lanes')
GROUP BY b."BowlerID", t."TourneyLocation"
LIMIT 20;
```

```sql
-- 10. FINAL: bowlers who have at least one qualifying win (≤ 190) at ALL THREE locations,
-- and list the individual game records that satisfy the criteria
SELECT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyDate",
       t."TourneyLocation"
FROM "Bowler_Scores"  AS bs
JOIN "Bowlers"        AS b  USING ("BowlerID")
JOIN "Tourney_Matches" AS tm USING ("MatchID")
JOIN "Tournaments"     AS t  USING ("TourneyID")
WHERE bs."WonGame" = 1
  AND bs."HandiCapScore" <= 190
  AND t."TourneyLocation" IN ('Thunderbird Lanes', 'Totem Lanes', 'Bolero Lanes')
  AND b."BowlerID" IN (
      SELECT BowlerID
      FROM (
          SELECT b2."BowlerID",
                 t2."TourneyLocation"
          FROM "Bowler_Scores"  AS bs2
          JOIN "Tourney_Matches" AS tm2 USING ("MatchID")
          JOIN "Tournaments"     AS t2  USING ("TourneyID")
          WHERE bs2."WonGame" = 1
            AND bs2."HandiCapScore" <= 190
            AND t2."TourneyLocation" IN ('Thunderbird Lanes', 'Totem Lanes', 'Bolero Lanes')
          GROUP BY b2."BowlerID", t2."TourneyLocation"
      )
      GROUP BY BowlerID
      HAVING COUNT(DISTINCT "TourneyLocation") = 3
  )
ORDER BY b."BowlerID", t."TourneyLocation", bs."MatchID", bs."GameNumber"
LIMIT 20;
```

Each query is limited to 20 rows and progressively builds toward the final answer.
