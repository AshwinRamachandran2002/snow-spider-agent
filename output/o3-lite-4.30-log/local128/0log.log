2025-05-01 03:24:25 - Thread-1381 (execute) - INFO - [Exploration]
Relevant columns, their potential usage and major conditions
------------------------------------------------------------
• Bowler_Scores."BowlerID": join to Bowlers and identify each bowler  
• Bowler_Scores."MatchID": join to Tourney_Matches (and then to Tournaments)  
• Bowler_Scores."GameNumber": report in the final list  
• Bowler_Scores."HandiCapScore": filter ≤ 190 ( “…handicap score of 190 or less … ” )  
• Bowler_Scores."WonGame": filter = 1 ( only games the bowler actually won )  

• Bowlers."BowlerID": join key  
• Bowlers."BowlerFirstName", Bowlers."BowlerLastName": display in the result set  

• Tourney_Matches."MatchID": join to Bowler_Scores, provides TourneyID  
• Tourney_Matches."TourneyID": join to Tournaments  

• Tournaments."TourneyID": join key  
• Tournaments."TourneyDate": display in the result set  
• Tournaments."TourneyLocation": filter on the three requested venues  
  ('Thunderbird Lanes', 'Totem Lanes', 'Bolero Lanes') and display in the result set  

Main logical conditions
-----------------------
1. Bowler_Scores.WonGame = 1  
2. Bowler_Scores.HandiCapScore ≤ 190  
3. Tournaments.TourneyLocation IN ('Thunderbird Lanes','Totem Lanes','Bolero Lanes')  
4. Only keep bowlers who satisfy (1)+(2) at all three of those locations.

Exploratory / step‑by‑step SQL (10 separate queries, each limited to 20 rows)
-----------------------------------------------------------------------------

```sql
-- 1) Show every tournament location that currently exists
SELECT DISTINCT "TourneyLocation"
FROM "Tournaments"
LIMIT 20;
```

```sql
-- 2) Peek at some winning-score rows with handicap ≤190
SELECT *
FROM "Bowler_Scores"
WHERE "WonGame" = 1
  AND "HandiCapScore" <= 190
LIMIT 20;
```

```sql
-- 3) Join a few winning rows to their tournament date & location
SELECT bs."BowlerID",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyDate",
       t."TourneyLocation"
FROM   "Bowler_Scores"       AS bs
JOIN   "Tourney_Matches"     AS tm ON tm."MatchID"  = bs."MatchID"
JOIN   "Tournaments"         AS t  ON t."TourneyID" = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
LIMIT 20;
```

```sql
-- 4) List each bowler / venue pair where the bowler has a ≤190 winning game
SELECT DISTINCT bs."BowlerID",
       t."TourneyLocation"
FROM   "Bowler_Scores"   AS bs
JOIN   "Tourney_Matches" AS tm ON tm."MatchID"  = bs."MatchID"
JOIN   "Tournaments"     AS t  ON t."TourneyID" = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes','Totem Lanes','Bolero Lanes')
LIMIT 20;
```

```sql
-- 5) Count how many of the 3 target venues each bowler has satisfied
SELECT bs."BowlerID",
       COUNT( DISTINCT t."TourneyLocation") AS "venue_cnt"
FROM   "Bowler_Scores"   AS bs
JOIN   "Tourney_Matches" AS tm ON tm."MatchID"  = bs."MatchID"
JOIN   "Tournaments"     AS t  ON t."TourneyID" = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes','Totem Lanes','Bolero Lanes')
GROUP  BY bs."BowlerID"
HAVING "venue_cnt" = 3
LIMIT 20;
```

```sql
-- 6) Show the bowler names that passed the all‑three‑venues test
SELECT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName"
FROM  "Bowlers" AS b
WHERE b."BowlerID" IN (
        SELECT bs."BowlerID"
        FROM   "Bowler_Scores"   AS bs
        JOIN   "Tourney_Matches" AS tm ON tm."MatchID"  = bs."MatchID"
        JOIN   "Tournaments"     AS t  ON t."TourneyID" = tm."TourneyID"
        WHERE  bs."WonGame" = 1
          AND  bs."HandiCapScore" <= 190
          AND  t."TourneyLocation" IN ('Thunderbird Lanes','Totem Lanes','Bolero Lanes')
        GROUP  BY bs."BowlerID"
        HAVING COUNT( DISTINCT t."TourneyLocation") = 3
      )
LIMIT 20;
```

```sql
-- 7) Retrieve the exact game rows (with venue & date) for bowlers that qualified
SELECT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyDate",
       t."TourneyLocation"
FROM   "Bowler_Scores"   AS bs
JOIN   "Bowlers"         AS b  ON b."BowlerID"   = bs."BowlerID"
JOIN   "Tourney_Matches" AS tm ON tm."MatchID"   = bs."MatchID"
JOIN   "Tournaments"     AS t  ON t."TourneyID"  = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes','Totem Lanes','Bolero Lanes')
  AND  bs."BowlerID" IN (
        SELECT bs2."BowlerID"
        FROM   "Bowler_Scores"   AS bs2
        JOIN   "Tourney_Matches" AS tm2 ON tm2."MatchID"  = bs2."MatchID"
        JOIN   "Tournaments"     AS t2  ON t2."TourneyID" = tm2."TourneyID"
        WHERE  bs2."WonGame" = 1
          AND  bs2."HandiCapScore" <= 190
          AND  t2."TourneyLocation" IN ('Thunderbird Lanes','Totem Lanes','Bolero Lanes')
        GROUP  BY bs2."BowlerID"
        HAVING COUNT( DISTINCT t2."TourneyLocation") = 3
      )
LIMIT 20;
```

```sql
-- 8) Same as (7) but ordered by bowler and tournament date
SELECT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyDate",
       t."TourneyLocation"
FROM   "Bowler_Scores"   AS bs
JOIN   "Bowlers"         AS b  ON b."BowlerID"   = bs."BowlerID"
JOIN   "Tourney_Matches" AS tm ON tm."MatchID"   = bs."MatchID"
JOIN   "Tournaments"     AS t  ON t."TourneyID"  = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes','Totem Lanes','Bolero Lanes')
  AND  bs."BowlerID" IN (
        SELECT bs2."BowlerID"
        FROM   "Bowler_Scores"   AS bs2
        JOIN   "Tourney_Matches" AS tm2 ON tm2."MatchID"  = bs2."MatchID"
        JOIN   "Tournaments"     AS t2  ON t2."TourneyID" = tm2."TourneyID"
        WHERE  bs2."WonGame" = 1
          AND  bs2."HandiCapScore" <= 190
          AND  t2."TourneyLocation" IN ('Thunderbird Lanes','Totem Lanes','Bolero Lanes')
        GROUP  BY bs2."BowlerID"
        HAVING COUNT( DISTINCT t2."TourneyLocation") = 3
      )
ORDER BY b."BowlerLastName", b."BowlerFirstName", t."TourneyDate"
LIMIT 20;
```

```sql
-- 9) Verify that each selected bowler truly appears once per requested venue
SELECT b."BowlerID",
       t."TourneyLocation",
       COUNT(*) AS "games_at_venue"
FROM   "Bowler_Scores"   AS bs
JOIN   "Bowlers"         AS b  ON b."BowlerID"   = bs."BowlerID"
JOIN   "Tourney_Matches" AS tm ON tm."MatchID"   = bs."MatchID"
JOIN   "Tournaments"     AS t  ON t."TourneyID"  = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes','Totem Lanes','Bolero Lanes')
  AND  b."BowlerID" IN (
        SELECT bs2."BowlerID"
        FROM   "Bowler_Scores"   AS bs2
        JOIN   "Tourney_Matches" AS tm2 ON tm2."MatchID"  = bs2."MatchID"
        JOIN   "Tournaments"     AS t2  ON t2."TourneyID" = tm2."TourneyID"
        WHERE  bs2."WonGame" = 1
          AND  bs2."HandiCapScore" <= 190
          AND  t2."TourneyLocation" IN ('Thunderbird Lanes','Totem Lanes','Bolero Lanes')
        GROUP  BY bs2."BowlerID"
        HAVING COUNT( DISTINCT t2."TourneyLocation") = 3
      )
GROUP  BY b."BowlerID", t."TourneyLocation"
LIMIT 20;
```

```sql
-- 10) Final presentation adding the bowler’s full name in one column
SELECT b."BowlerID",
       b."BowlerFirstName" || ' ' || b."BowlerLastName" AS "BowlerName",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyDate",
       t."TourneyLocation"
FROM   "Bowler_Scores"   AS bs
JOIN   "Bowlers"         AS b  ON b."BowlerID"   = bs."BowlerID"
JOIN   "Tourney_Matches" AS tm ON tm."MatchID"   = bs."MatchID"
JOIN   "Tournaments"     AS t  ON t."TourneyID"  = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes','Totem Lanes','Bolero Lanes')
  AND  bs."BowlerID" IN (
        SELECT bs2."BowlerID"
        FROM   "Bowler_Scores"   AS bs2
        JOIN   "Tourney_Matches" AS tm2 ON tm2."MatchID"  = bs2."MatchID"
        JOIN   "Tournaments"     AS t2  ON t2."TourneyID" = tm2."TourneyID"
        WHERE  bs2."WonGame" = 1
          AND  bs2."HandiCapScore" <= 190
          AND  t2."TourneyLocation" IN ('Thunderbird Lanes','Totem Lanes','Bolero Lanes')
        GROUP  BY bs2."BowlerID"
        HAVING COUNT( DISTINCT t2."TourneyLocation") = 3
      )
ORDER BY b."BowlerLastName", b."BowlerFirstName", t."TourneyDate", bs."GameNumber"
LIMIT 20;
```

