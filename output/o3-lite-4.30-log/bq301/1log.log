Query:
--Description: Display answer‑level statistics for all answers posted in 2016,
--together with the answerer’s reputation.
SELECT
  a.id         AS answer_id,
  u.reputation AS answerer_reputation,
  a.score      AS answer_score
FROM `bigquery-public-data.stackoverflow.posts_answers` AS a
JOIN `bigquery-public-data.stackoverflow.users`         AS u
  ON a.owner_user_id = u.id
WHERE DATE(a.creation_date) BETWEEN '2016-01-01' AND '2016-12-31'
LIMIT 20
