Query:
--Description: Retrieve January‑2016 questions along with the asker’s reputation,
--view count, and comment count (no tag filtering).
SELECT
  q.id          AS question_id,
  uq.reputation AS asker_reputation,
  q.view_count,
  q.comment_count
FROM `bigquery-public-data.stackoverflow.posts_questions` AS q
JOIN `bigquery-public-data.stackoverflow.users`            AS uq
  ON q.owner_user_id = uq.id
WHERE DATE(q.creation_date) BETWEEN '2016-01-01' AND '2016-01-31'
LIMIT 20
