The table structure information is ({database name: {schema name: [table name]}}): 
{'bigquery-public-data': {'stackoverflow': ['posts_answers', 'users', 'posts_orphaned_tag_wiki', 'posts_tag_wiki', 'stackoverflow_posts', 'posts_questions', 'comments', 'posts_tag_wiki_excerpt', 'posts_wiki_placeholder', 'posts_privilege_wiki', 'post_history', 'badges', 'post_links', 'tags', 'votes', 'posts_moderator_nomination']}}
Begin Exploring Related Columns
Relevant columns & how they will be used  

posts_questions  
• id : primary key, to identify each question  
• creation_date : filter questions posted in 2016‑01  
• tags : look for “<javascript>” plus (“<xss>”, “<cross-site>”, “<exploit>”, “<cybersecurity>”)  
• accepted_answer_id : join to the answer that was accepted  
• score : return in the result  
• answer_count : return in the result  
• view_count : return in the result  
• comment_count : return in the result  
• owner_user_id : join to asker’s user record  

posts_answers  
• id : primary key – will equal accepted_answer_id  
• parent_id : sanity‑check linkage back to the question (optional)  
• creation_date : filter answers posted in 2016‑01  
• score : return in the result  
• comment_count : return in the result  
• owner_user_id : join to answerer’s user record  

users  
• id : primary key  
• reputation : fetch both asker and answerer reputation  

Date filter to be reused  
creation_date ≥ '2016‑01‑01' AND creation_date < '2016‑02‑01'  

Tag filter to be reused  
tags LIKE '%<javascript>%'  
AND ( tags LIKE '%<xss>%' OR tags LIKE '%<cross-site>%'  
      OR tags LIKE '%<exploit>%' OR tags LIKE '%<cybersecurity>%')  


Below are ten exploratory → final queries (all capped with LIMIT 20)  

```sql
-- 1. Sample of questions created in January‑2016
SELECT id, creation_date, tags
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE creation_date >= '2016-01-01' AND creation_date < '2016-02-01'
LIMIT 20;
```

```sql
-- 2. Sample of answers created in January‑2016
SELECT id, parent_id, creation_date, score
FROM `bigquery-public-data.stackoverflow.posts_answers`
WHERE creation_date >= '2016-01-01' AND creation_date < '2016-02-01'
LIMIT 20;
```

```sql
-- 3. January‑2016 questions that mention <javascript>
SELECT id, tags
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE creation_date >= '2016-01-01' AND creation_date < '2016-02-01'
  AND tags LIKE '%<javascript>%'
LIMIT 20;
```

```sql
-- 4. January‑2016 questions with <javascript> plus any security‑related tag
SELECT id, tags
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE creation_date >= '2016-01-01' AND creation_date < '2016-02-01'
  AND tags LIKE '%<javascript>%'
  AND ( tags LIKE '%<xss>%' OR tags LIKE '%<cross-site>%'
        OR tags LIKE '%<exploit>%' OR tags LIKE '%<cybersecurity>%')
LIMIT 20;
```

```sql
-- 5. Those questions that also have an accepted answer
SELECT id, accepted_answer_id
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE creation_date >= '2016-01-01' AND creation_date < '2016-02-01'
  AND accepted_answer_id IS NOT NULL
  AND tags LIKE '%<javascript>%'
  AND ( tags LIKE '%<xss>%' OR tags LIKE '%<cross-site>%'
        OR tags LIKE '%<exploit>%' OR tags LIKE '%<cybersecurity>%')
LIMIT 20;
```

```sql
-- 6. Join to the accepted answer; keep only answers from January‑2016
SELECT q.id   AS question_id,
       a.id   AS answer_id,
       q.tags,
       q.creation_date AS q_date,
       a.creation_date AS a_date
FROM `bigquery-public-data.stackoverflow.posts_questions` q
JOIN `bigquery-public-data.stackoverflow.posts_answers`  a
  ON a.id = q.accepted_answer_id
WHERE q.creation_date >= '2016-01-01' AND q.creation_date < '2016-02-01'
  AND a.creation_date >= '2016-01-01' AND a.creation_date < '2016-02-01'
  AND q.tags LIKE '%<javascript>%'
  AND ( q.tags LIKE '%<xss>%' OR q.tags LIKE '%<cross-site>%'
        OR q.tags LIKE '%<exploit>%' OR q.tags LIKE '%<cybersecurity>%')
LIMIT 20;
```

```sql
-- 7. Pull the asker’s reputation
SELECT q.id AS question_id,
       u.reputation AS asker_reputation
FROM `bigquery-public-data.stackoverflow.posts_questions` q
LEFT JOIN `bigquery-public-data.stackoverflow.users` u
  ON u.id = q.owner_user_id
WHERE q.creation_date >= '2016-01-01' AND q.creation_date < '2016-02-01'
  AND q.tags LIKE '%<javascript>%'
LIMIT 20;
```

```sql
-- 8. Pull the answerer’s reputation for accepted answers in scope
SELECT a.id AS answer_id,
       u.reputation AS answerer_reputation
FROM `bigquery-public-data.stackoverflow.posts_answers` a
LEFT JOIN `bigquery-public-data.stackoverflow.users` u
  ON u.id = a.owner_user_id
WHERE a.creation_date >= '2016-01-01' AND a.creation_date < '2016-02-01'
LIMIT 20;
```

```sql
-- 9. Combine questions + accepted answers + both users’ reputations (still limited columns)
SELECT q.id AS question_id,
       a.id AS answer_id,
       asker.reputation   AS asker_reputation,
       answerer.reputation AS answerer_reputation
FROM `bigquery-public-data.stackoverflow.posts_questions` q
JOIN `bigquery-public-data.stackoverflow.posts_answers` a
  ON a.id = q.accepted_answer_id
LEFT JOIN `bigquery-public-data.stackoverflow.users` asker
  ON asker.id = q.owner_user_id
LEFT JOIN `bigquery-public-data.stackoverflow.users` answerer
  ON answerer.id = a.owner_user_id
WHERE q.creation_date >= '2016-01-01' AND q.creation_date < '2016-02-01'
  AND a.creation_date >= '2016-01-01' AND a.creation_date < '2016-02-01'
  AND q.tags LIKE '%<javascript>%'
  AND ( q.tags LIKE '%<xss>%' OR q.tags LIKE '%<cross-site>%'
        OR q.tags LIKE '%<exploit>%' OR q.tags LIKE '%<cybersecurity>%')
LIMIT 20;
```

```sql
-- 10. Final query: all requested details for accepted answers that meet every requirement
SELECT
  a.id                                   AS answer_id,
  answerer.reputation                    AS answerer_reputation,
  a.score                                AS answer_score,
  a.comment_count                        AS answer_comment_count,
  q.tags                                 AS question_tags,
  q.score                                AS question_score,
  q.answer_count                         AS question_answer_count,
  asker.reputation                       AS asker_reputation,
  q.view_count                           AS question_view_count,
  q.comment_count                        AS question_comment_count
FROM `bigquery-public-data.stackoverflow.posts_questions`  AS q
JOIN `bigquery-public-data.stackoverflow.posts_answers`    AS a
     ON a.id = q.accepted_answer_id
LEFT JOIN `bigquery-public-data.stackoverflow.users`       AS asker
     ON asker.id = q.owner_user_id
LEFT JOIN `bigquery-public-data.stackoverflow.users`       AS answerer
     ON answerer.id = a.owner_user_id
WHERE q.creation_date >= '2016-01-01' AND q.creation_date < '2016-02-01'
  AND a.creation_date >= '2016-01-01' AND a.creation_date < '2016-02-01'
  AND q.tags LIKE '%<javascript>%'
  AND ( q.tags LIKE '%<xss>%' OR q.tags LIKE '%<cross-site>%'
        OR q.tags LIKE '%<exploit>%' OR q.tags LIKE '%<cybersecurity>%')
LIMIT 20;
```
