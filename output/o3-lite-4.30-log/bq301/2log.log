--containing the tag “javascript”.
SELECT q.id AS question_id,
       u.reputation AS asker_reputation
FROM `bigquery-public-data.stackoverflow.posts_questions` q
LEFT JOIN `bigquery-public-data.stackoverflow.users` u
       ON u.id = q.owner_user_id
WHERE q.creation_date >= '2016-01-01' AND q.creation_date < '2016-02-01'
  AND q.tags LIKE '%javascript%'
LIMIT 20
