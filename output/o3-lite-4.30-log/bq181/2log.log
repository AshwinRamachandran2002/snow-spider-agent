Begin Exploring Related Columns
Relevant columns and their potential usage  
`stn`: station identifier in `gsod2022` (to be matched with `stations.usaf`).  
`date`: to know the day-of‑year (all dates are in 2022).  
`temp`: daily mean temperature; must be present and ≠ 9999.9.  
`max`: daily maximum temperature; must be present and ≠ 9999.9.  
`min`: daily minimum temperature; must be present and ≠ 9999.9.  
`usaf`: station identifier in `stations`; used to filter out the bogus code `999999`.  

Conditions that will be used  
• `temp IS NOT NULL AND temp != 9999.9`  
• `max  IS NOT NULL AND max  != 9999.9`  
• `min  IS NOT NULL AND min  != 9999.9`  
• `s.usaf != '999999'` (after joining `gsod2022` as g and `stations` as s)  
• Valid‑day ratio ≥ 0.90 → `valid_days / total_days >= 0.9`  

Ten exploratory‑to‑final BigQuery SQL statements (each ends with `LIMIT 20`)  

```sql
-- 1. Description: Peek at a few 2022 GSOD weather records
SELECT *
FROM `bigquery-public-data.noaa_gsod.gsod2022`
LIMIT 20;
```

```sql
-- 2. Description: Inspect a handful of station‑metadata rows
SELECT *
FROM `bigquery-public-data.noaa_gsod.stations`
LIMIT 20;
```

```sql
-- 3. Description: List distinct station IDs that appear in the 2022 file
SELECT DISTINCT stn
FROM `bigquery-public-data.noaa_gsod.gsod2022`
ORDER BY stn
LIMIT 20;
```

```sql
-- 4. Description: For every station, count how many calendar days exist in 2022
SELECT
  stn,
  COUNT(1) AS total_days_2022
FROM `bigquery-public-data.noaa_gsod.gsod2022`
GROUP BY stn
ORDER BY total_days_2022 DESC
LIMIT 20;
```

```sql
-- 5. Description: Count “valid‑temperature” days (no sentinel 9999.9) per station
SELECT
  stn,
  COUNTIF(
      temp != 9999.9 AND max != 9999.9 AND min != 9999.9
      AND temp IS NOT NULL AND max IS NOT NULL AND min IS NOT NULL
  ) AS valid_temp_days
FROM `bigquery-public-data.noaa_gsod.gsod2022`
GROUP BY stn
ORDER BY valid_temp_days DESC
LIMIT 20;
```

```sql
-- 6. Description: Combine total vs. valid days and compute the fraction
WITH totals AS (
  SELECT
    stn,
    COUNT(1) AS total_days,
    COUNTIF(
      temp != 9999.9 AND max != 9999.9 AND min != 9999.9
      AND temp IS NOT NULL AND max IS NOT NULL AND min IS NOT NULL
    ) AS valid_days
  FROM `bigquery-public-data.noaa_gsod.gsod2022`
  GROUP BY stn
)
SELECT
  stn,
  total_days,
  valid_days,
  SAFE_DIVIDE(valid_days,total_days) AS valid_ratio
FROM totals
ORDER BY valid_ratio DESC
LIMIT 20;
```

```sql
-- 7. Description: Stations whose valid‑day ratio ≥ 0.9 (still not filtered for bogus USAF)
WITH validity AS (
  SELECT
    stn,
    COUNT(1) AS total_days,
    COUNTIF(
      temp != 9999.9 AND max != 9999.9 AND min != 9999.9
      AND temp IS NOT NULL AND max IS NOT NULL AND min IS NOT NULL
    ) AS valid_days
  FROM `bigquery-public-data.noaa_gsod.gsod2022`
  GROUP BY stn
)
SELECT
  stn,
  valid_days,
  total_days,
  SAFE_DIVIDE(valid_days,total_days) AS valid_ratio
FROM validity
WHERE SAFE_DIVIDE(valid_days,total_days) >= 0.90
ORDER BY stn
LIMIT 20;
```

```sql
-- 8. Description: Count how many stations satisfy the 90 % rule (after removing USAF 999999)
WITH validity AS (
  SELECT
    g.stn,
    COUNT(1) AS total_days,
    COUNTIF(
      g.temp != 9999.9 AND g.max != 9999.9 AND g.min != 9999.9
      AND g.temp IS NOT NULL AND g.max IS NOT NULL AND g.min IS NOT NULL
    ) AS valid_days
  FROM `bigquery-public-data.noaa_gsod.gsod2022` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn = s.usaf
  WHERE s.usaf != '999999'
  GROUP BY g.stn
)
SELECT COUNT(1) AS stations_meeting_90pct
FROM validity
WHERE SAFE_DIVIDE(valid_days,total_days) >= 0.90
LIMIT 20;
```

```sql
-- 9. Description: Determine total number of stations in the metadata (excluding USAF 999999)
SELECT COUNT(DISTINCT usaf) AS total_stations
FROM `bigquery-public-data.noaa_gsod.stations`
WHERE usaf != '999999'
LIMIT 20;
```

```sql
-- 10. Description: Final percentage = (stations ≥ 90 % valid days) / (all stations) * 100
WITH validity AS (
  SELECT
    g.stn,
    COUNT(1) AS total_days,
    COUNTIF(
      g.temp != 9999.9 AND g.max != 9999.9 AND g.min != 9999.9
      AND g.temp IS NOT NULL AND g.max IS NOT NULL AND g.min IS NOT NULL
    ) AS valid_days
  FROM `bigquery-public-data.noaa_gsod.gsod2022` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn = s.usaf
  WHERE s.usaf != '999999'
  GROUP BY g.stn
),
station_counts AS (
  SELECT
    (SELECT COUNT(1) FROM validity
     WHERE SAFE_DIVIDE(valid_days,total_days) >= 0.90) AS good_stations,
    (SELECT COUNT(DISTINCT usaf)
     FROM `bigquery-public-data.noaa_gsod.stations`
     WHERE usaf != '999999') AS all_stations
)
SELECT
  good_stations,
  all_stations,
  SAFE_DIVIDE(good_stations, all_stations) * 100 AS pct_good_stations
FROM station_counts
LIMIT 20;
```

