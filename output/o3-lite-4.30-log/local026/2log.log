Query:
-- 9) For each match, keep the over(s) that conceded the MOST runs
-- (limit to 20 matches for display)
WITH over_totals AS (
    SELECT b.match_id,
           b.innings_no,
           b.over_id,
           b.bowler,
           SUM(COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0)) AS over_runs
    FROM ball_by_ball AS b
    LEFT JOIN batsman_scored AS bs
           ON bs.match_id   = b.match_id
          AND bs.over_id    = b.over_id
          AND bs.ball_id    = b.ball_id
          AND bs.innings_no = b.innings_no
    LEFT JOIN extra_runs AS er
           ON er.match_id   = b.match_id
          AND er.over_id    = b.over_id
          AND er.ball_id    = b.ball_id
          AND er.innings_no = b.innings_no
    GROUP BY b.match_id, b.innings_no, b.over_id, b.bowler
), max_per_match AS (
    SELECT match_id,
           MAX(over_runs) AS max_runs_in_match
    FROM over_totals
    GROUP BY match_id
)
SELECT o.match_id,
       o.innings_no,
       o.over_id,
       o.bowler,
       o.over_runs
FROM over_totals AS o
JOIN max_per_match AS m
  ON o.match_id = m.match_id
 AND o.over_runs = m.max_runs_in_match
LIMIT 20;
