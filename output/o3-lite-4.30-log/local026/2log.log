```sql
--Description / Thinking process:
-- We need the three bowlers who, in the worst over(s) of each match, conceded
-- the most runs in a single over across all matches.
-- 1. over_totals  : add bat‑runs and extra‑runs ball‑by‑ball and sum them per
--                   match‑id, innings_no, over_id, bowler.
-- 2. max_over_per_match : for every match, keep only the over(s) whose total
--                   equals the maximum runs conceded in any over of that match.
-- 3. ranked       : rank all those “worst overs” from highest to lowest by the
--                   runs conceded.
-- 4. Final SELECT : return the top 3, showing bowler id, bowler name, match id,
--                   and runs conceded in that over.

WITH over_totals AS (
    SELECT  b.match_id,
            b.innings_no,
            b.over_id,
            b.bowler,
            SUM(COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0)) AS over_runs
    FROM    ball_by_ball AS b
    LEFT JOIN batsman_scored AS bs
           ON bs.match_id   = b.match_id
          AND bs.over_id    = b.over_id
          AND bs.ball_id    = b.ball_id
          AND bs.innings_no = b.innings_no
    LEFT JOIN extra_runs AS er
           ON er.match_id   = b.match_id
          AND er.over_id    = b.over_id
          AND er.ball_id    = b.ball_id
          AND er.innings_no = b.innings_no
    GROUP BY b.match_id, b.innings_no, b.over_id, b.bowler
),
max_over_per_match AS (
    SELECT  o.*
    FROM    over_totals AS o
    JOIN   (SELECT match_id,
                   MAX(over_runs) AS max_runs_in_match
            FROM   over_totals
            GROUP BY match_id) m
      ON    o.match_id = m.match_id
     AND    o.over_runs = m.max_runs_in_match
),
ranked AS (
    SELECT  m.match_id,
            m.bowler,
            m.over_runs,
            ROW_NUMBER() OVER (ORDER BY m.over_runs DESC) AS rnk
    FROM    max_over_per_match AS m
)
SELECT  r.bowler        AS bowler_id,
        p.player_name   AS bowler_name,
        r.match_id,
        r.over_runs     AS runs_in_that_over
FROM    ranked AS r
JOIN    player AS p
      ON p.player_id = r.bowler
WHERE   r.rnk <= 3
ORDER BY r.over_runs DESC, r.bowler;
```
