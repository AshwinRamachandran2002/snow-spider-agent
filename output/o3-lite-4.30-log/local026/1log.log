```sql
--Description:
-- Goal: Find the three worst overs (by runs conceded) that were also the
--       highest‑scoring over of their respective matches.
-- Logic:
--   1. over_runs  – compute runs a bowler concedes in every over
--                   (bat runs + wides/noballs, which count against the bowler).
--   2. match_max  – per match, pick the maximum runs an over conceded.
--   3. max_overs  – keep only overs whose runs equal that match maximum.
--   4. ranked     – order those overs across all matches by runs_conceded DESC
--                   and assign a row number.
--   5. final SELECT – return top 3 bowler‑match pairs with the worst such overs.

WITH over_runs AS (
    SELECT  bb.match_id,
            bb.over_id,
            bb.innings_no,
            bb.bowler,
            SUM(COALESCE(bs.runs_scored,0)) +
            SUM(CASE
                    WHEN er.extra_type IN ('wides','noballs')
                    THEN COALESCE(er.extra_runs,0)
                    ELSE 0
                END) AS runs_conceded
    FROM ball_by_ball AS bb
    LEFT JOIN batsman_scored AS bs
           ON  bs.match_id   = bb.match_id
          AND bs.over_id     = bb.over_id
          AND bs.ball_id     = bb.ball_id
          AND bs.innings_no  = bb.innings_no
    LEFT JOIN extra_runs AS er
           ON  er.match_id   = bb.match_id
          AND er.over_id     = bb.over_id
          AND er.ball_id     = bb.ball_id
          AND er.innings_no  = bb.innings_no
    GROUP BY bb.match_id, bb.over_id, bb.innings_no, bb.bowler
),
match_max AS (
    SELECT match_id, MAX(runs_conceded) AS mx
    FROM over_runs
    GROUP BY match_id
),
max_overs AS (
    SELECT o.match_id,
           o.over_id,
           o.bowler,
           o.runs_conceded
    FROM over_runs AS o
    JOIN match_max  AS m
      ON o.match_id       = m.match_id
     AND o.runs_conceded  = m.mx
),
ranked AS (
    SELECT mo.*,
           ROW_NUMBER() OVER (ORDER BY mo.runs_conceded DESC) AS rnk
    FROM max_overs AS mo
)
SELECT  r.rnk      AS rank_overall,
        p.player_name AS bowler,
        r.match_id,
        r.runs_conceded
FROM ranked AS r
JOIN player AS p ON p.player_id = r.bowler
WHERE r.rnk <= 3
ORDER BY r.rnk;
```
