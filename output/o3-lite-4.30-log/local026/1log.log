Begin Exploring Related Columns
Relevant tables / columns and their possible usage  
ball_by_ball.match_id         :  identify the match an over belongs to  
ball_by_ball.over_id          :  identify the over (within a match)  
ball_by_ball.ball_id          :  identify each delivery (for joining)  
ball_by_ball.innings_no       :  required to join to the scoring tables  
ball_by_ball.bowler           :  the bowler who delivered the ball ― key column for the ask  
batsman_scored.runs_scored    :  number of off‑the‑bat runs that count against the bowler  
batsman_scored.(match_id , over_id , ball_id , innings_no) :  composite key to join with ball_by_ball  
extra_runs.extra_runs         :  wides / no‑balls / byes / leg‑byes that also add to the over total  
extra_runs.extra_type         :  can be filtered if we decide to ignore byes/leg‑byes (they do not go to the bowler)  
player.player_id / player_name:  bowler’s name for the final output  
match.match_id , match_date   :  so we can show in which match the over occurred  

Typical join conditions  
ON bb.match_id = bs.match_id  
AND bb.over_id  = bs.over_id  
AND bb.ball_id  = bs.ball_id  
AND bb.innings_no = bs.innings_no  
(similar for extra_runs)  

The following 10 exploratory queries go from very simple inspection to the complete result for the task.

```sql
-- 1. Show a few bowler ids that appear in ball_by_ball
SELECT DISTINCT bowler
FROM ball_by_ball
LIMIT 20;
```

```sql
-- 2. Inspect how runs_scored is stored in batsman_scored
SELECT *
FROM batsman_scored
LIMIT 20;
```

```sql
-- 3. Inspect how extra runs are stored
SELECT *
FROM extra_runs
LIMIT 20;
```

```sql
-- 4. Look at one over, joining bat runs and extra runs to see the components
SELECT bb.match_id,
       bb.over_id,
       bb.innings_no,
       bb.bowler,
       SUM(COALESCE(bs.runs_scored,0)) AS bat_runs,
       SUM(CASE 
             WHEN er.extra_type IN ('wides','noballs') THEN COALESCE(er.extra_runs,0)
             ELSE 0
           END)                       AS bowler_extras
FROM ball_by_ball AS bb
LEFT JOIN batsman_scored AS bs
  ON  bb.match_id   = bs.match_id
 AND bb.over_id     = bs.over_id
 AND bb.ball_id     = bs.ball_id
 AND bb.innings_no  = bs.innings_no
LEFT JOIN extra_runs AS er
  ON  bb.match_id   = er.match_id
 AND bb.over_id     = er.over_id
 AND bb.ball_id     = er.ball_id
 AND bb.innings_no  = er.innings_no
GROUP BY bb.match_id, bb.over_id, bb.innings_no, bb.bowler
LIMIT 20;
```

```sql
-- 5. Aggregate the above to get total runs conceded by each bowler in every over
SELECT bb.match_id,
       bb.over_id,
       bb.innings_no,
       bb.bowler,
       SUM(COALESCE(bs.runs_scored,0))                                        -- off the bat
     + SUM(CASE WHEN er.extra_type IN ('wides','noballs')                     -- bowler‑charged extras
                THEN COALESCE(er.extra_runs,0) ELSE 0 END)  AS runs_conceded
FROM ball_by_ball AS bb
LEFT JOIN batsman_scored AS bs
  ON  bb.match_id  = bs.match_id
 AND bb.over_id    = bs.over_id
 AND bb.ball_id    = bs.ball_id
 AND bb.innings_no = bs.innings_no
LEFT JOIN extra_runs AS er
  ON  bb.match_id  = er.match_id
 AND bb.over_id    = er.over_id
 AND bb.ball_id    = er.ball_id
 AND bb.innings_no = er.innings_no
GROUP BY bb.match_id, bb.over_id, bb.innings_no, bb.bowler
LIMIT 20;
```

```sql
-- 6. For each match, find the maximum runs conceded in any single over
WITH over_runs AS (
  SELECT bb.match_id,
         bb.over_id,
         bb.innings_no,
         bb.bowler,
         SUM(COALESCE(bs.runs_scored,0))
       + SUM(CASE WHEN er.extra_type IN ('wides','noballs')
                  THEN COALESCE(er.extra_runs,0) ELSE 0 END) AS runs_conceded
  FROM ball_by_ball AS bb
  LEFT JOIN batsman_scored AS bs
    ON  bb.match_id  = bs.match_id
   AND bb.over_id    = bs.over_id
   AND bb.ball_id    = bs.ball_id
   AND bb.innings_no = bs.innings_no
  LEFT JOIN extra_runs AS er
    ON  bb.match_id  = er.match_id
   AND bb.over_id    = er.over_id
   AND bb.ball_id    = er.ball_id
   AND bb.innings_no = er.innings_no
  GROUP BY bb.match_id, bb.over_id, bb.innings_no, bb.bowler
)
SELECT match_id,
       MAX(runs_conceded) AS max_runs_in_match
FROM over_runs
GROUP BY match_id
LIMIT 20;
```

```sql
-- 7. Return only the overs that actually are the max‑run overs inside each match
WITH over_runs AS (
  SELECT bb.match_id,
         bb.over_id,
         bb.innings_no,
         bb.bowler,
         SUM(COALESCE(bs.runs_scored,0))
       + SUM(CASE WHEN er.extra_type IN ('wides','noballs')
                  THEN COALESCE(er.extra_runs,0) ELSE 0 END) AS runs_conceded
  FROM ball_by_ball AS bb
  LEFT JOIN batsman_scored AS bs
    ON  bb.match_id  = bs.match_id
   AND bb.over_id    = bs.over_id
   AND bb.ball_id    = bs.ball_id
   AND bb.innings_no = bs.innings_no
  LEFT JOIN extra_runs AS er
    ON  bb.match_id  = er.match_id
   AND bb.over_id    = er.over_id
   AND bb.ball_id    = er.ball_id
   AND bb.innings_no = er.innings_no
  GROUP BY bb.match_id, bb.over_id, bb.innings_no, bb.bowler
), match_max AS (
  SELECT match_id, MAX(runs_conceded) AS mx
  FROM over_runs
  GROUP BY match_id
)
SELECT o.*
FROM over_runs AS o
JOIN match_max AS m
  ON o.match_id = m.match_id
 AND o.runs_conceded = m.mx
LIMIT 20;
```

```sql
-- 8. Attach bowler names and match dates to the max‑run overs
WITH over_runs AS ( /* same as in query 7 */ ),
match_max AS (      /* same as in query 7 */ ),
max_overs AS (
  SELECT o.match_id,
         o.over_id,
         o.innings_no,
         o.bowler,
         o.runs_conceded
  FROM over_runs AS o
  JOIN match_max AS m
    ON o.match_id = m.match_id
   AND o.runs_conceded = m.mx
)
SELECT p.player_name,
       mo.match_id,
       mt.match_date,
       mo.over_id,
       mo.runs_conceded
FROM max_overs AS mo
JOIN player AS p   ON p.player_id = mo.bowler
JOIN match  AS mt  ON mt.match_id = mo.match_id
LIMIT 20;
```

```sql
-- 9. Rank those overs across ALL matches by runs conceded and pick the top 10
WITH over_runs AS ( /* same as in query 7 */ ),
match_max AS (      /* same as in query 7 */ ),
max_overs AS (
  SELECT o.match_id,
         o.over_id,
         o.innings_no,
         o.bowler,
         o.runs_conceded
  FROM over_runs AS o
  JOIN match_max AS m
    ON o.match_id = m.match_id
   AND o.runs_conceded = m.mx
)
SELECT p.player_name,
       mo.match_id,
       mo.runs_conceded
FROM max_overs AS mo
JOIN player AS p ON p.player_id = mo.bowler
ORDER BY mo.runs_conceded DESC
LIMIT 10;
```

```sql
-- 10. Final answer: top 3 bowlers (with tie‑breakers resolved by higher runs then arbitrary)
WITH over_runs AS (
  SELECT bb.match_id,
         bb.over_id,
         bb.innings_no,
         bb.bowler,
         SUM(COALESCE(bs.runs_scored,0))
       + SUM(CASE WHEN er.extra_type IN ('wides','noballs')
                  THEN COALESCE(er.extra_runs,0) ELSE 0 END) AS runs_conceded
  FROM ball_by_ball AS bb
  LEFT JOIN batsman_scored AS bs
    ON  bb.match_id  = bs.match_id
   AND bb.over_id    = bs.over_id
   AND bb.ball_id    = bs.ball_id
   AND bb.innings_no = bs.innings_no
  LEFT JOIN extra_runs AS er
    ON  bb.match_id  = er.match_id
   AND bb.over_id    = er.over_id
   AND bb.ball_id    = er.ball_id
   AND bb.innings_no = er.innings_no
  GROUP BY bb.match_id, bb.over_id, bb.innings_no, bb.bowler
),
match_max AS (
  SELECT match_id, MAX(runs_conceded) AS mx
  FROM over_runs
  GROUP BY match_id
),
max_overs AS (
  SELECT o.*
  FROM over_runs AS o
  JOIN match_max AS m
    ON o.match_id = m.match_id
   AND o.runs_conceded = m.mx
),
ranked AS (
  SELECT mo.*,
         ROW_NUMBER() OVER (ORDER BY runs_conceded DESC) AS rnk
  FROM max_overs AS mo
)
SELECT p.player_name AS bowler,
       r.match_id,
       r.runs_conceded
FROM ranked AS r
JOIN player AS p ON p.player_id = r.bowler
WHERE r.rnk <= 3
ORDER BY r.rnk;
```

Each successive query builds knowledge about the data, culminating in query 10, which identifies the three largest “worst” overs a bowler delivered when that over was also the highest‑scoring over of its match.
