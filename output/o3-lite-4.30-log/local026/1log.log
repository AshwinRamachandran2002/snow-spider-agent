Query:
--Description: Query #9 – Rank all overs that were the highest‑scoring over of their
--             respective matches, and list the ten with the most runs conceded.
WITH over_runs AS (                    -- runs a bowler gives up in every over
    SELECT  bb.match_id,
            bb.over_id,
            bb.innings_no,
            bb.bowler,
            SUM(COALESCE(bs.runs_scored,0)) +
            SUM(CASE
                    WHEN er.extra_type IN ('wides','noballs')
                    THEN COALESCE(er.extra_runs,0)
                    ELSE 0
                END) AS runs_conceded
    FROM ball_by_ball AS bb
    LEFT JOIN batsman_scored AS bs
           ON bs.match_id   = bb.match_id
          AND bs.over_id    = bb.over_id
          AND bs.ball_id    = bb.ball_id
          AND bs.innings_no = bb.innings_no
    LEFT JOIN extra_runs AS er
           ON er.match_id   = bb.match_id
          AND er.over_id    = bb.over_id
          AND er.ball_id    = bb.ball_id
          AND er.innings_no = bb.innings_no
    GROUP BY bb.match_id, bb.over_id, bb.innings_no, bb.bowler
),
match_max AS (                         -- per‑match maximum runs in any over
    SELECT match_id, MAX(runs_conceded) AS mx
    FROM over_runs
    GROUP BY match_id
),
max_overs AS (                         -- the over(s) that reached that maximum
    SELECT o.match_id,
           o.over_id,
           o.bowler,
           o.runs_conceded
    FROM over_runs AS o
    JOIN match_max AS m
      ON o.match_id      = m.match_id
     AND o.runs_conceded = m.mx
)
SELECT  p.player_name,
        mo.match_id,
        mo.runs_conceded
FROM max_overs AS mo
JOIN player AS p ON p.player_id = mo.bowler
ORDER BY mo.runs_conceded DESC
LIMIT 10
