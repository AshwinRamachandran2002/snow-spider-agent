--Description:
-- Each GA sample table is named ga_sessions_YYYYMMDD, so January‑2017 data lives in
-- tables ga_sessions_20170101 … ga_sessions_20170131.  Use the wildcard
-- ga_sessions_201701* to hit all of them.  The virtual column _TABLE_SUFFIX then
-- contains the full date string.  Filter it to the first week (20170101‑20170107),
-- unnest the hits array (alias h), and for each day count how many hits were
-- product‑detail views (action_type = 2) versus add‑to‑cart hits (action_type = 3).
-- Finally, order chronologically.
SELECT
  _TABLE_SUFFIX AS yyyymmdd,
  COUNTIF(h.eCommerceAction.action_type = '2') AS product_detail_views,
  COUNTIF(h.eCommerceAction.action_type = '3') AS add_to_cart
