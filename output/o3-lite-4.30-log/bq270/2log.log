--Description: Final calculation of monthly add‑to‑cart and purchase conversion rates
--             as a percentage of product‑detail‑view hits (Jan‑Mar 2017).
WITH detail AS (
  SELECT FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', s.date)) AS month,
         COUNT(*) AS detail_cnt
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*` AS s
  CROSS JOIN UNNEST(s.hits)    AS h
  CROSS JOIN UNNEST(h.product) AS p
  WHERE _TABLE_SUFFIX BETWEEN '20170101' AND '20170331'
    AND h.eCommerceAction.action_type = '2'
    AND (p.isImpression IS NULL OR p.isImpression = FALSE)
  GROUP BY month
),
add_cart AS (
  SELECT FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', s.date)) AS month,
         COUNT(*) AS add_cnt
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*` AS s
  CROSS JOIN UNNEST(s.hits)    AS h
  CROSS JOIN UNNEST(h.product) AS p
  WHERE _TABLE_SUFFIX BETWEEN '20170101' AND '20170331'
    AND h.eCommerceAction.action_type = '3'
    AND (p.isImpression IS NULL OR p.isImpression = FALSE)
  GROUP BY month
),
purchase AS (
  SELECT FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', s.date)) AS month,
         COUNT(*) AS purchase_cnt
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*` AS s
  CROSS JOIN UNNEST(s.hits)    AS h
  CROSS JOIN UNNEST(h.product) AS p
  WHERE _TABLE_SUFFIX BETWEEN '20170101' AND '20170331'
    AND h.eCommerceAction.action_type = '6'
    AND (p.isImpression IS NULL OR p.isImpression = FALSE)
  GROUP BY month
)
SELECT
  d.month,
  ROUND(100 * a.add_cnt      / d.detail_cnt, 2) AS add_to_cart_conversion_rate,
  ROUND(100 * p.purchase_cnt / d.detail_cnt, 2) AS purchase_conversion_rate
FROM detail d
LEFT JOIN add_cart a USING (month)
LEFT JOIN purchase p USING (month)
ORDER BY d.month
