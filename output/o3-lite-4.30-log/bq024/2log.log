```sql
--Description / thinking process:
-- Goal: list the ten evaluation groups that include the year 2012 whose single
--       largest‑acre condition (based on subplot acres) is greatest.
-- Logic:
--   1. Start from the population “view” (table) because it already ties each
--      plot to its evaluation, stratum, expansion factor, and evaluation_group.
--   2. Join to condition to obtain the subgroup proportions recorded on‑site.
--   3. Join to population_evaluation for evaluation text, state, and the list
--      of report years so we can filter evaluations that cover 2012.
--   4. Join to population_evaluation_type to report the evaluation_type
--      (e.g., EXPALL, EXPVOL, etc.).
--   5. Convert proportions to acres:  proportion × expansion_factor.
--   6. Rank every condition within its evaluation_group by those subplot acres
--      (largest first).  Keep only rank 1 ⇒ the single largest condition.
--   7. Order the kept rows by subplot acres and show the first ten.

WITH cond_rank AS (
  SELECT
    p.evaluation_group,
    et.evaluation_type,
    c.condition_status_code,
    e.evaluation_description,
    e.state_code,
    c.macroplot_proportion_unadjusted * p.expansion_factor AS macroplot_acres,
    c.subplot_proportion_unadjusted  * p.expansion_factor AS subplot_acres,
    ROW_NUMBER() OVER (
        PARTITION BY p.evaluation_group
        ORDER BY c.subplot_proportion_unadjusted * p.expansion_factor DESC
    ) AS rn
  FROM `bigquery-public-data.usfs_fia.population` AS p
  JOIN `bigquery-public-data.usfs_fia.condition`   AS c
        ON c.plot_sequence_number = p.plot_sequence_number
  JOIN `bigquery-public-data.usfs_fia.population_evaluation` AS e
        ON e.evaluation_sequence_number = p.evaluation_sequence_number
  JOIN `bigquery-public-data.usfs_fia.population_evaluation_type` AS et
        ON et.evaluation_sequence_number = e.evaluation_sequence_number
  WHERE e.report_year_name LIKE '%2012%'          -- keep evaluations that include 2012
        AND c.subplot_proportion_unadjusted IS NOT NULL
)

SELECT
  evaluation_group,
  evaluation_type,
  condition_status_code,
  evaluation_description,
  state_code,
  macroplot_acres,
  subplot_acres
FROM cond_rank
WHERE rn = 1                                      -- biggest condition per group
ORDER BY subplot_acres DESC
LIMIT 10;
```
