-- 10) FINAL ANSWER: top‑10 evaluation groups in 2012 by the *largest* subplot acres
WITH cond_acres AS (
  SELECT p.evaluation_group,
         p.evaluation_type,
         c.condition_status_code,
         p.evaluation_description,
         p.state_code,
         p.expansion_factor *
         COALESCE(p.adjustment_factor_for_the_macroplot,1) *
         c.macroplot_proportion_unadjusted AS macroplot_acres,
         p.expansion_factor *
         COALESCE(p.adjustment_factor_for_the_subplot,1) *
         c.subplot_proportion_unadjusted   AS subplot_acres,
         ROW_NUMBER() OVER (PARTITION BY p.evaluation_group
                            ORDER BY p.expansion_factor *
                                     COALESCE(p.adjustment_factor_for_the_subplot,1) *
                                     c.subplot_proportion_unadjusted DESC) AS rn
  FROM   `bigquery-public-data.usfs_fia.population` AS p
  JOIN   `bigquery-public-data.usfs_fia.condition`  AS c
    ON   p.plot_sequence_number = c.plot_sequence_number
  WHERE  p.report_year_name LIKE '%2012%'          -- restrict to 2012
)
SELECT evaluation_group,
       evaluation_type,
       condition_status_code,
       evaluation_description,
       state_code,
       macroplot_acres,
       subplot_acres
FROM   cond_acres
WHERE  rn = 1                        -- only the largest‑subplot condition per group
ORDER BY subplot_acres DESC
LIMIT 10;
