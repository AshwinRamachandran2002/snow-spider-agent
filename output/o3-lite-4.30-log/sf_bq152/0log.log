        "case_barcode",
        "chromosome",
        "start_pos",
        "end_pos",
        "segment_mean"
    FROM "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."COPY_NUMBER_SEGMENT_MASKED"
    WHERE "project_short_name" = 'TCGA-BRCA'
),

/* ---------------------------------------------------------------------
   Minimal cytoband approximation: treat each chromosome as one band
