------------------------------------------------------------------------ */
cytobands AS (
    SELECT
        "chromosome",
        1                               AS "cyto_start",
        MAX("end_pos")                  AS "cyto_end",
        CONCAT("chromosome", 'q')       AS "cytoband"      -- e.g. 1q, 2q, …, Xq
    FROM brca_segments
    GROUP BY "chromosome"
),

/* ---------------------------------------------------------------------
   Overlap each segment with its chromosome‑level band
------------------------------------------------------------------------ */
overlaps AS (
    SELECT
        c."cytoband",
        c."cyto_start",
        c."cyto_end",
        s."case_barcode",
        GREATEST(c."cyto_start", s."start_pos") AS ov_start,
        LEAST  (c."cyto_end",   s."end_pos")    AS ov_end,
        s."segment_mean"
    FROM cytobands c
    JOIN brca_segments s
         ON c."chromosome" = s."chromosome"
        AND s."end_pos"   >= c."cyto_start"
        AND s."start_pos" <= c."cyto_end"
),

/* ---------------------------------------------------------------------
   Length‑weighted average CN per (case, band) and rounding to integer
------------------------------------------------------------------------ */
band_cn_per_case AS (
    SELECT
        "cytoband",
        "cyto_start",
        "cyto_end",
        "case_barcode",
        ROUND(
            SUM( (ov_end - ov_start + 1) * (POWER(2, segment_mean) * 2) )
          / SUM(  ov_end - ov_start + 1 )
        ) AS rounded_cn
    FROM overlaps
    GROUP BY "cytoband", "cyto_start", "cyto_end", "case_barcode"
),

/* ---------------------------------------------------------------------
   Convert rounded CN to CNV categories
------------------------------------------------------------------------ */
band_cnv_type AS (
    SELECT
        "cytoband",
        "cyto_start",
        "cyto_end",
        CASE
            WHEN rounded_cn = 0 THEN 'homdel'
            WHEN rounded_cn = 1 THEN 'hetdel'
            WHEN rounded_cn = 2 THEN 'normal'
            WHEN rounded_cn = 3 THEN 'gain'
            WHEN rounded_cn  > 3 THEN 'amp'
        END AS cnv_type
    FROM band_cn_per_case
),

