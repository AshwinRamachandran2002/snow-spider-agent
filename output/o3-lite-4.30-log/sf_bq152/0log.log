    ROUND(100.0 * SUM( CASE WHEN ct.cnv_type = 'amp'    THEN 1 ELSE 0 END )
                 / (SELECT n_cases FROM total_cases), 2)                   AS amplification_pct
FROM cytobands cb
LEFT JOIN band_cnv_type ct
       ON  cb."cytoband"   = ct."cytoband"
      AND cb."cyto_start"  = ct."cyto_start"
      AND cb."cyto_end"    = ct."cyto_end"
GROUP BY cb."chromosome", cb."cytoband", cb."cyto_start", cb."cyto_end"
ORDER BY cb."chromosome", cb."cyto_start";
