    ROUND(100.0 * SUM( CASE WHEN ct.cnv_type = 'hetdel' THEN 1 ELSE 0 END )
                 / (SELECT n_cases FROM total_cases), 2)                   AS heterozygous_deletion_pct,
    ROUND(100.0 * SUM( CASE WHEN ct.cnv_type = 'normal' THEN 1 ELSE 0 END )
