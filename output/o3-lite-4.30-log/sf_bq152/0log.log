2025-05-01 17:48:03 - Thread-1 (execute) - INFO - [Try to run SQL in self-refine]
```sql
/* -------------------------------------------------------------------------
   Cytoband‑level CNV frequency map for TCGA‑BRCA (hg38 – GDC release‑23)
   ------------------------------------------------------------------------- */

WITH cytobands AS (   -- hg38 cytoband reference (one row per cytoband)
    SELECT
        "chromosome",          -- e.g. '1' … '22', 'X'
        "chrom_start"  AS "cyto_start",
        "chrom_end"    AS "cyto_end",
        "name"         AS "cytoband"
    FROM "REFERENCE_DATA"."HG38"."CYTOBAND"                 -- adjust if the reference table is named differently
),

/* ---------------------------------------------------------------------  
   All masked copy‑number segments for TCGA‑BRCA
------------------------------------------------------------------------ */
brca_segments AS (
    SELECT
        "case_barcode",
        "chromosome",
        "start_pos",
        "end_pos",
        "segment_mean"
    FROM "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."COPY_NUMBER_SEGMENT_MASKED"
    WHERE "project_short_name" = 'TCGA-BRCA'
),

/* ---------------------------------------------------------------------
   Intersect every cytoband with every overlapping CN segment of a case
------------------------------------------------------------------------ */
overlaps AS (
    SELECT
        c."cytoband",
        c."cyto_start",
        c."cyto_end",
        s."case_barcode",
        GREATEST(c."cyto_start", s."start_pos")        AS ov_start,
        LEAST  (c."cyto_end",   s."end_pos")           AS ov_end,
        s."segment_mean"
    FROM cytobands  c
    JOIN brca_segments s
          ON c."chromosome" = s."chromosome"
         AND s."end_pos"   >= c."cyto_start"
         AND s."start_pos" <= c."cyto_end"
),

/* ---------------------------------------------------------------------
   Copy‑number for each (case, cytoband) – length‑weighted average,
   then rounded to the nearest integer copy number
------------------------------------------------------------------------ */
band_cn_per_case AS (
    SELECT
        "cytoband",
        "cyto_start",
        "cyto_end",
        "case_barcode",
        ROUND(
            SUM( (ov_end - ov_start + 1) * (POWER(2, segment_mean) * 2) )
          / SUM(  ov_end - ov_start + 1 )
        )                       AS rounded_cn
    FROM overlaps
