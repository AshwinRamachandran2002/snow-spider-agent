            WHEN rounded_cn = 3        THEN 'gain'         -- single copy gain
            WHEN rounded_cn  > 3       THEN 'amp'          -- amplification
        END AS cnv_type
    FROM band_cn_per_case
),

/* ---------------------------------------------------------------------
   Total number of BRCA cases in the table (denominator for percentages)
------------------------------------------------------------------------ */
total_cases AS (
    SELECT COUNT(DISTINCT "case_barcode") AS n_cases
    FROM brca_segments
)

/* ---------------------------------------------------------------------
