        SUM( "ovl_len" )                                 AS "raw_cn"
    FROM overlaps
    GROUP BY "cytoband", "case_barcode"
),

/* round to integer copy number and translate to CNV class */
band_cnv AS (
    SELECT
        "cytoband",
        "case_barcode",
        ROUND("raw_cn")                                   AS "cn_round",
        CASE
            WHEN ROUND("raw_cn") = 0 THEN 'homozygous_deletion'
            WHEN ROUND("raw_cn") = 1 THEN 'heterozygous_deletion'
            WHEN ROUND("raw_cn") = 2 THEN 'normal'
            WHEN ROUND("raw_cn") = 3 THEN 'gain'
            ELSE                         'amplification'
        END                                              AS "cnv_type"
    FROM band_cn
),

/* total number of unique BRCA cases (denominator for percentages) */
tot AS (
    SELECT COUNT(DISTINCT "case_barcode") AS "n_cases"
    FROM brca_segments
),

/* frequency (percentage) of each CNV category per cytoband */
freq AS (
    SELECT
        b."cytoband",
        MIN(c."start_pos")                     AS "start_pos",
        MAX(c."end_pos")                       AS "end_pos",
        100 * COUNT_IF(b."cnv_type" = 'homozygous_deletion')   / t."n_cases" AS "homdel_pct",
        100 * COUNT_IF(b."cnv_type" = 'heterozygous_deletion') / t."n_cases" AS "hetdel_pct",
        100 * COUNT_IF(b."cnv_type" = 'normal')                / t."n_cases" AS "normal_pct",
        100 * COUNT_IF(b."cnv_type" = 'gain')                  / t."n_cases" AS "gain_pct",
        100 * COUNT_IF(b."cnv_type" = 'amplification')         / t."n_cases" AS "amp_pct"
    FROM band_cnv b
    JOIN cytobands c  ON c."cytoband" = b."cytoband"
    CROSS JOIN tot t
    GROUP BY b."cytoband", t."n_cases"
)

/* final output -----------------------------------------------------------*/
SELECT
    "cytoband",
    "start_pos"                                           AS start,
    "end_pos"                                             AS end,
    ROUND("homdel_pct", 2)                                AS homozygous_deletion_pct,
    ROUND("hetdel_pct", 2)                                AS heterozygous_deletion_pct,
    ROUND("normal_pct", 2)                                AS normal_pct,
    ROUND("gain_pct", 2)                                  AS gain_pct,
    ROUND("amp_pct", 2)                                   AS amplification_pct
FROM freq
ORDER BY "cytoband";
