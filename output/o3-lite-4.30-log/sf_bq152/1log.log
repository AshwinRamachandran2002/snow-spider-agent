```sql
/*---------------------------------------------------------------------------
Breast‑cancer (TCGA‑BRCA) copy‑number status per cytoband
---------------------------------------------------------------------------*/
WITH cytobands AS (           -- hg38 cytoband co‑ordinates (0‑based in UCSC)
    SELECT 
        CASE
            WHEN "chrom" IN ('chrX','chrY') THEN SUBSTR("chrom",4)     -- X / Y
            ELSE REPLACE("chrom",'chr','')                             -- 1‑22
        END                     AS "chromosome",
        "chromStart"+1          AS "start_pos",                        -- 1‑based
        "chromEnd"              AS "end_pos",
        "name"                  AS "cytoband"
    FROM "REFERENCE_GENOME"."HG38_CYTOBAND"            -- <‑‑ adjust if different
),                                                         

brca_segments AS (             -- masked CN segments for TCGA‑BRCA
    SELECT
        "case_barcode",
        "chromosome",
        "start_pos",
        "end_pos",
        "segment_mean"
    FROM "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."COPY_NUMBER_SEGMENT_MASKED"
    WHERE "project_short_name" = 'TCGA-BRCA'
),

-- overlap each segment with every cytoband it intersects
overlaps AS (
    SELECT
        c."cytoband",
        c."start_pos"                                           AS "cyto_start",
        c."end_pos"                                             AS "cyto_end",
        s."case_barcode",
        LEAST(s."end_pos",c."end_pos") -
        GREATEST(s."start_pos",c."start_pos") + 1              AS "ovl_len",
        s."segment_mean"
    FROM cytobands c
    JOIN brca_segments s
      ON s."chromosome" = c."chromosome"
     AND s."end_pos"   >= c."start_pos"
     AND s."start_pos" <= c."end_pos"
),

-- length‑weighted mean raw copy number ( 2*2^log2ratio ) per band & case
band_cn AS (
    SELECT
        "cytoband",
        "case_barcode",
        SUM( "ovl_len" * 2*POWER( 2 , "segment_mean") ) /
        SUM( "ovl_len")                                      AS "raw_cn"
    FROM overlaps
    GROUP BY "cytoband","case_barcode"
),

-- round to nearest integer and map to CNV class
band_cnv AS (
    SELECT
        "cytoband",
        "case_barcode",
        ROUND("raw_cn")                                       AS "cn_round",
        CASE
            WHEN ROUND("raw_cn") = 0 THEN 'homozygous_deletion'
            WHEN ROUND("raw_cn") = 1 THEN 'heterozygous_deletion'
            WHEN ROUND("raw_cn") = 2 THEN 'normal'
            WHEN ROUND("raw_cn") = 3 THEN 'gain'
            ELSE                            'amplification'
        END                                                  AS "cnv_type"
    FROM band_cn
),

-- total number of BRCA cases (needed for percentage denominator)
tot AS (
    SELECT COUNT(DISTINCT "case_barcode") AS "n_cases"
    FROM brca_segments
),

-- frequency (percentage) of each CNV type per cytoband
freq AS (
    SELECT
        b."cytoband",
        MIN(c."start_pos")                     AS "start_pos",
        MAX(c."end_pos")                       AS "end_pos",
        100.0*COUNT_IF(b."cnv_type"='homozygous_deletion')/t."n_cases"  AS "homdel_pct",
        100.0*COUNT_IF(b."cnv_type"='heterozygous_deletion')/t."n_cases"AS "hetdel_pct",
        100.0*COUNT_IF(b."cnv_type"='normal')/t."n_cases"               AS "normal_pct",
        100.0*COUNT_IF(b."cnv_type"='gain')/t."n_cases"                 AS "gain_pct",
        100.0*COUNT_IF(b."cnv_type"='amplification')/t."n_cases"        AS "amp_pct"
    FROM band_cnv  b
    JOIN cytobands c   ON c."cytoband" = b."cytoband"
    CROSS JOIN tot  t
    GROUP BY b."cytoband", t."n_cases"
)

SELECT
    "cytoband"                                                 AS cytoband,
    "start_pos"                                                AS start,
    "end_pos"                                                  AS end,
    ROUND("homdel_pct",2)                                      AS homozygous_deletion_pct,
    ROUND("hetdel_pct",2)                                      AS heterozygous_deletion_pct,
