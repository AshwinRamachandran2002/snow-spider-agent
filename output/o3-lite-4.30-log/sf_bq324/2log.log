      LATERAL FLATTEN (INPUT => t.SPECIMENPREPARATIONSEQUENCE) AS f
WHERE t.collection_name = 'TCGA-BRCA'
  AND t.Modality        = 'SM'
  AND t.SPECIMENPREPARATIONSEQUENCE IS NOT NULL
LIMIT 20;
