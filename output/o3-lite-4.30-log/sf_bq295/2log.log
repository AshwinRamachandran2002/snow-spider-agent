      AND "content" ILIKE '%def %'            -- containing the substring "def "
)
SELECT 
    w."repo_name"        AS repository,
    w."watch_event_count"
FROM watch_events_2017 w
JOIN qualified_python_repos p
  ON w."repo_name" = p."repo_name"
ORDER BY w."watch_event_count" DESC NULLS LAST,
         w."repo_name"        ASC
LIMIT 3;
