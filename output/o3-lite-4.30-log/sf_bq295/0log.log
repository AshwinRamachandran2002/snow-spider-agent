Relevant tables / columns for the requested task 

• GITHUB_REPOS_DATE.YEAR."_2017"  
  – "type": filter for Watch events (WHERE "type" = 'WatchEvent').  
  – "repo": VARIANT – flatten to pull out the actual repository name (f.value:"name").  

• GITHUB_REPOS_DATE.GITHUB_REPOS.SAMPLE_FILES  
  – "repo_name": repository name to join with watch‑event repos.  
  – "path": source‑file path (filter for ILIKE '%.py').  
  – "id": blob id which can be joined to SAMPLE_CONTENTS.  

• GITHUB_REPOS_DATE.GITHUB_REPOS.SAMPLE_CONTENTS  
  – "sample_repo_name": repository name (alternative join key).  
  – "sample_path": full path (may be used like "path").  
  – "size": filter for files < 15 000 bytes.  
  – "content": look for the substring 'def ' (WHERE "content" ILIKE '%def %').  

Typical conditions  

• "type" = 'WatchEvent'  
• f.value:"name" IS NOT NULL  – only events that have a repo name  
• "path" ILIKE '%.py'  
• "size" < 15000  
• "content" ILIKE '%def %'  

-----------------------------------------------------------------
Ten exploratory Snowflake SQL queries (LIMIT 20 each)

```sql
--Description: 1) Peek at raw 2017 rows to see structure of event records
SELECT * 
FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" 
LIMIT 20;
```

```sql
--Description: 2) What different GitHub event "type" values are present in 2017?
SELECT DISTINCT "type" 
FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" 
LIMIT 20;
```

```sql
--Description: 3) Pull repository names from the VARIANT "repo" column
SELECT f.value:"name"::STRING AS "repo_name"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t,
     LATERAL FLATTEN(input => t."repo") f
WHERE f.value:"name" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 4) Quickly list 20 Watch events with the repo each pertains to
SELECT f.value:"name"::STRING AS "repo_name",
       t."type"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t,
     LATERAL FLATTEN(input => t."repo") f
WHERE t."type" = 'WatchEvent'
LIMIT 20;
```

```sql
--Description: 5) Count Watch events per repository (early aggregation sample)
SELECT f.value:"name"::STRING  AS "repo_name",
       COUNT(*)                AS "watch_events_2017"
FROM   "GITHUB_REPOS_DATE"."YEAR"."_2017" t,
       LATERAL FLATTEN(input => t."repo") f
WHERE  t."type" = 'WatchEvent'
GROUP  BY "repo_name"
ORDER  BY "watch_events_2017" DESC
LIMIT 20;
```

```sql
--Description: 6) Preview Python‑source entries in SAMPLE_FILES
SELECT "repo_name",
       "path",
       "id"
FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE  "path" ILIKE '%.py'
LIMIT 20;
```

```sql
--Description: 7) Join SAMPLE_FILES to SAMPLE_CONTENTS to see code + size
SELECT f."repo_name",
       f."path",
       c."size",
       LEFT(c."content", 120) AS "content_snippet"
FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES"    f
JOIN   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
      ON f."id" = c."id"
WHERE  f."path" ILIKE '%.py'
  AND  c."size" < 15000
  AND  c."content" ILIKE '%def %'
LIMIT 20;
```

```sql
--Description: 8) Distinct repo list that contains at least one qualifying Python file
SELECT DISTINCT f."repo_name"
FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES"    f
JOIN   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
      ON f."id" = c."id"
WHERE  f."path" ILIKE '%.py'
  AND  c."size" < 15000
  AND  c."content" ILIKE '%def %'
LIMIT 20;
```

```sql
--Description: 9) Combine Watch‑event counts with repos that satisfy Python‑file rules
WITH python_repos AS (
    SELECT DISTINCT f."repo_name"
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES"    f
    JOIN   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
           ON f."id" = c."id"
    WHERE  f."path" ILIKE '%.py'
      AND  c."size" < 15000
      AND  c."content" ILIKE '%def %'
),
watch_counts AS (
    SELECT f.value:"name"::STRING  AS "repo_name",
           COUNT(*)                AS "watch_events_2017"
    FROM   "GITHUB_REPOS_DATE"."YEAR"."_2017" t,
           LATERAL FLATTEN(input => t."repo") f
    WHERE  t."type" = 'WatchEvent'
    GROUP  BY "repo_name"
)
SELECT w."repo_name",
       w."watch_events_2017"
FROM   watch_counts w
JOIN   python_repos p 
       ON w."repo_name" = p."repo_name"
ORDER  BY w."watch_events_2017" DESC
LIMIT 20;
```

```sql
--Description: 10) Final result – top 3 repos (by Watch events in 2017) that have ≥1 small .py file with 'def '
WITH python_repos AS (
    SELECT DISTINCT f."repo_name"
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES"    f
    JOIN   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
           ON f."id" = c."id"
    WHERE  f."path" ILIKE '%.py'
      AND  c."size" < 15000
      AND  c."content" ILIKE '%def %'
),
watch_counts AS (
    SELECT f.value:"name"::STRING  AS "repo_name",
           COUNT(*)                AS "watch_events_2017"
    FROM   "GITHUB_REPOS_DATE"."YEAR"."_2017" t,
           LATERAL FLATTEN(input => t."repo") f
    WHERE  t."type" = 'WatchEvent'
    GROUP  BY "repo_name"
)
SELECT w."repo_name",
       w."watch_events_2017"
FROM   watch_counts w
JOIN   python_repos p 
       ON w."repo_name" = p."repo_name"
ORDER  BY w."watch_events_2017" DESC
LIMIT 3;
```

