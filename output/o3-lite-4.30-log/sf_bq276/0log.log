--Description: A single, corrected summary query.  Because ST_ASWKT(p."port_geom") is
--             derived from the raw geometry, that geometry must appear in the GROUP BY
--             clause; otherwise Snowflake raises the “neither an aggregate nor in the
--             group by” error.  The steps are:
--               1) Filter WORLD_PORT_INDEX to region 6585 and U.S. ports.
--               2) Ensure each port lies within a U.S. state polygon via ST_CONTAINS.
--               3) Join to HURRICANES points that are ≤ 100 km from the port and meet the
--                  North‑Atlantic, wind ≥ 35 kts, SSHS ≥ 0 criteria.
--               4) Aggregate storm seasons, names, counts, and averages per (port,state).
--               5) Return port geometry as WKT and an array of storm point WKTs.
SELECT
       p."port_name",
       st."state_name",
       ARRAY_AGG(DISTINCT s."season")                         AS "years_impacted",
       COUNT(DISTINCT s."sid")                                AS "distinct_storms",
       ARRAY_AGG(DISTINCT s."name")                           AS "storm_names",
       AVG(s."usa_sshs")                                      AS "avg_category",
       AVG(s."usa_wind")                                      AS "avg_wind_kts",
       ST_ASWKT(TO_GEOGRAPHY(p."port_geom"))                  AS "port_geom_wkt",
       ARRAY_AGG(DISTINCT ST_ASWKT(ST_POINT(s."longitude", s."latitude")))
           AS "storm_geoms_wkt"
FROM   NOAA_PORTS.GEO_INTERNATIONAL_PORTS.WORLD_PORT_INDEX  p
JOIN   NOAA_PORTS.GEO_US_BOUNDARIES.STATES                 st
  ON   ST_CONTAINS(TO_GEOGRAPHY(st."state_geom"), TO_GEOGRAPHY(p."port_geom"))
JOIN   NOAA_PORTS.NOAA_HURRICANES.HURRICANES               s
  ON   ST_DISTANCE(TO_GEOGRAPHY(p."port_geom"),
                   ST_POINT(s."longitude", s."latitude")) <= 100000  -- 100 km
WHERE  p."region_number" = '6585'
  AND  p."country"       = 'US'
  AND  s."basin"         = 'NA'
  AND  s."usa_wind"     >= 35
  AND  s."usa_sshs"     >= 0
GROUP BY
       p."port_name",
       st."state_name",
       p."port_geom"
LIMIT  20;
