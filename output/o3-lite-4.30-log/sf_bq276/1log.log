```sql
-- 8️⃣  Description: sample named storms in the North Atlantic that meet wind & category thresholds
SELECT DISTINCT
  "sid",
  "name",
  "season",
  "usa_wind",
  "usa_sshs"
FROM NOAA_PORTS.NOAA_HURRICANES.HURRICANES
WHERE "basin" = 'NA'
  AND "usa_wind" >= 35          -- ≥ 35 kts  (tropical‑storm force)
  AND "usa_sshs" >= 0           -- ≥ minimal TS on Saffir‑Simpson
LIMIT 20;
```

```sql
-- 9️⃣  Description: pair each qualifying storm position with nearby ports (≤ 25 km buffer example)
SELECT
  p."port_name",
  p."index_number",
  h."name"          AS "storm_name",
  h."season"        AS "storm_year",
  h."usa_wind",
  ST_Distance(
     ST_GeomFromWKB(p."port_geom")::GEOGRAPHY,
     ST_Point(h."longitude", h."latitude")::GEOGRAPHY
  ) AS "meters_from_port"
FROM NOAA_PORTS.GEO_INTERNATIONAL_PORTS.WORLD_PORT_INDEX AS p
JOIN NOAA_PORTS.NOAA_HURRICANES.HURRICANES               AS h
  ON h."basin" = 'NA'
 AND h."usa_wind" >= 35
 AND h."usa_sshs" >= 0
 AND ST_Distance(
       ST_GeomFromWKB(p."port_geom")::GEOGRAPHY,
       ST_Point(h."longitude", h."latitude")::GEOGRAPHY
     ) <= 25000       -- within 25 km of the port
WHERE p."region_number" = '6585'
  AND p."country" = 'US'
LIMIT 20;
```

```sql
-- 🔟  Description: full roll‑up → ports in region 6585 (U.S.) + all qualifying NA storms
--                 reporting state, distinct years, storm count, distinct names,
--                 average Saffir‑Simpson cat & avg wind ‑‑ with geometries displayed
SELECT
  p."port_name",
  s."state_name",
  ARRAY_AGG(DISTINCT h."season")         AS "years_impacted",
  COUNT(DISTINCT h."sid")                AS "distinct_storms",
  ARRAY_AGG(DISTINCT h."name")           AS "storm_names",
  AVG(h."usa_sshs")                      AS "avg_sshs_category",
  AVG(h."usa_wind")                      AS "avg_wind_kts",
  p."port_geom"                          AS "port_geometry_wkb",
  ARRAY_AGG(
    DISTINCT ST_Point(h."longitude", h."latitude")::VARIANT
  ) AS "storm_point_geoms"
FROM NOAA_PORTS.GEO_INTERNATIONAL_PORTS.WORLD_PORT_INDEX AS p
JOIN NOAA_PORTS.GEO_US_BOUNDARIES.STATES                 AS s
  ON ST_Contains(
       ST_GeomFromWKB(s."state_geom"),
       ST_GeomFromWKB(p."port_geom")
     )
JOIN NOAA_PORTS.NOAA_HURRICANES.HURRICANES               AS h
  ON h."basin" = 'NA'
 AND h."usa_wind" >= 35
 AND h."usa_sshs" >= 0
 AND ST_Distance(
       ST_GeomFromWKB(p."port_geom")::GEOGRAPHY,
       ST_Point(h."longitude", h."latitude")::GEOGRAPHY
     ) <= 25000     -- 25‑km influence radius; adjust as needed
WHERE p."region_number" = '6585'
  AND p."country" = 'US'
GROUP BY
  p."port_name",
  s."state_name",
  p."port_geom"
LIMIT 20;
```

