  ON  h."basin"     = 'NA'
  AND h."usa_wind"  >= 35         -- ≥ tropical‑storm force
  AND h."usa_sshs"  >= 0          -- ≥ minimal TS category
  AND ST_DISTANCE(
        ST_GeogPoint(p."port_longitude", p."port_latitude"),
        ST_GeogPoint(h."longitude",     h."latitude")
      ) <= 25000                  -- within 25 km of port
WHERE p."region_number" = '6585'
  AND p."country"       = 'US'
