--Description:  Convert each port’s binary geometry to GEOGRAPHY with SRID 4326
--              (ST_GEOGFROMWKB), create GEOGRAPHY points for every storm
--              position (ST_MAKEPOINT), then measure great‑circle distance.
--              Keep only North‑Atlantic storms whose wind ≥ 35 kt and
--              Saffir‑Simpson category ≥ 0 that pass within 25 km (25 000 m)
--              of any U.S. port in region 6585.

SELECT
    p."port_name",
    p."index_number",
    h."name"          AS "storm_name",
    h."season"        AS "storm_year",
    h."usa_wind",
    ST_DISTANCE(
        ST_GEOGFROMWKB(p."port_geom", 4326),              -- port geography
        ST_MAKEPOINT(h."longitude", h."latitude")         -- storm geography
    ) AS "meters_from_port"
FROM   NOAA_PORTS.GEO_INTERNATIONAL_PORTS.WORLD_PORT_INDEX AS p
