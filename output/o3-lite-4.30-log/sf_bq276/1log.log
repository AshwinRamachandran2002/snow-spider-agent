```sql
-- 6️⃣  Description: spatial join – which STATE polygon contains each 6585 U.S. port?
SELECT
  p."port_name",
  s."state_name"
FROM NOAA_PORTS.GEO_INTERNATIONAL_PORTS.WORLD_PORT_INDEX  AS p
JOIN NOAA_PORTS.GEO_US_BOUNDARIES.STATES                 AS s
  ON ST_Contains(
       ST_GeomFromWKB(s."state_geom"),
       ST_GeomFromWKB(p."port_geom")
     )
