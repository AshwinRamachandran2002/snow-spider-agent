--Description:  Instead of wrestling with WKB SRIDs, build GEOGRAPHY points directly
--              from the numeric latitude / longitude columns for each port and
--              each storm.  Then measure great‑circle distance to keep only
--              North‑Atlantic storms (wind ≥ 35 kt, SSHS ≥ 0) that passed within
--              25 km of every U.S. port whose “region_number” = 6585.

SELECT
    p."port_name",
    p."index_number",
    h."name"       AS "storm_name",
    h."season"     AS "storm_year",
    h."usa_wind",
    ST_DISTANCE(
        ST_GeogPoint(p."port_longitude", p."port_latitude"),   -- port location
        ST_GeogPoint(h."longitude",     h."latitude")          -- storm location
    ) AS "meters_from_port"
FROM NOAA_PORTS.GEO_INTERNATIONAL_PORTS.WORLD_PORT_INDEX AS p
