```sql
--Description:  Roll up every U.S. port in region 6585 with all North‑Atlantic
--              storm positions that (a) carried winds ≥ 35 kt, (b) had a
--              Saffir‑Simpson category ≥ 0, and (c) passed within 25 km.
--              • Convert WKB geometries to GEOGRAPHY (SRID 4326) for spatial
--                functions.  State containment ensures each port is assigned a
--                state.  ST_DISTANCE filters to 25 000 m.
--              • Because ARRAY_AGG cannot hold GEOGRAPHY, convert geometries
--                to WKT text via ST_ASWKT() before aggregation.
--              • Aggregate distinct storm years & names, count storms, and
--                average wind / category, then return port and storm WKTs.

SELECT
    p."port_name",
    s."state_name",
    ARRAY_AGG(DISTINCT h."season")                     AS "years_impacted",
    COUNT(DISTINCT h."sid")                            AS "distinct_storms",
    ARRAY_AGG(DISTINCT h."name")                       AS "storm_names",
    AVG(h."usa_sshs")                                  AS "avg_sshs_category",
    AVG(h."usa_wind")                                  AS "avg_wind_kts",
    ST_ASWKT(ST_GEOGFROMWKB(p."port_geom", 4326))      AS "port_wkt",
    ARRAY_AGG(
        DISTINCT ST_ASWKT( ST_MAKEPOINT(h."longitude", h."latitude") )
    )                                                  AS "storm_point_wkts"
FROM   NOAA_PORTS.GEO_INTERNATIONAL_PORTS.WORLD_PORT_INDEX AS p
JOIN   NOAA_PORTS.GEO_US_BOUNDARIES.STATES                 AS s
  ON   ST_CONTAINS(
         ST_GEOGFROMWKB(s."state_geom", 4326),          -- state polygon
         ST_GEOGFROMWKB(p."port_geom", 4326)            -- port point
       )
JOIN   NOAA_PORTS.NOAA_HURRICANES.HURRICANES               AS h
  ON   h."basin"     = 'NA'
 AND  h."usa_wind"  >= 35
 AND  h."usa_sshs"  >= 0
 AND  ST_DISTANCE(                                       -- 25 km radius
         ST_GEOGFROMWKB(p."port_geom", 4326),
         ST_MAKEPOINT(h."longitude", h."latitude")
       ) <= 25000
WHERE  p."region_number" = '6585'
  AND  p."country"       = 'US'
GROUP BY
    p."port_name",
    s."state_name",
    p."port_geom"
LIMIT 20;
```
