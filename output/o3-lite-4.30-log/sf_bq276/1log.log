--Description:  Roll‑up U.S. ports (region 6585) with all North‑Atlantic storm
--              positions (wind ≥ 35 kt & SSHS ≥ 0) that came within 25 km.
--              • Convert both STATE & PORT geometries to GEOGRAPHY via
--                ST_GEOGFROMWKB(…, 4326) so ST_CONTAINS works.
--              • Build each storm position with ST_MAKEPOINT(long, lat).
--              • Use ST_DISTANCE to enforce the 25 000 m proximity filter.
--              • Aggregate distinct years, storm names, counts, plus averages.

SELECT
    p."port_name",
    s."state_name",
    ARRAY_AGG(DISTINCT h."season")        AS "years_impacted",
    COUNT(DISTINCT h."sid")               AS "distinct_storms",
    ARRAY_AGG(DISTINCT h."name")          AS "storm_names",
    AVG(h."usa_sshs")                     AS "avg_sshs_category",
    AVG(h."usa_wind")                     AS "avg_wind_kts",
    ST_GEOGFROMWKB(p."port_geom", 4326)   AS "port_geography",
    ARRAY_AGG(
        DISTINCT ST_MAKEPOINT(h."longitude", h."latitude")
    ) AS "storm_point_geoms"
FROM   NOAA_PORTS.GEO_INTERNATIONAL_PORTS.WORLD_PORT_INDEX AS p
JOIN   NOAA_PORTS.GEO_US_BOUNDARIES.STATES                 AS s
  ON  ST_CONTAINS(
        ST_GEOGFROMWKB(s."state_geom", 4326),          -- state polygon
        ST_GEOGFROMWKB(p."port_geom", 4326)            -- port point
      )
JOIN   NOAA_PORTS.NOAA_HURRICANES.HURRICANES               AS h
  ON   h."basin"    = 'NA'
 AND  h."usa_wind" >= 35
 AND  h."usa_sshs" >= 0
 AND  ST_DISTANCE(                                     -- ≤25 km filter
        ST_GEOGFROMWKB(p."port_geom", 4326),
        ST_MAKEPOINT(h."longitude", h."latitude")
      ) <= 25000
WHERE  p."region_number" = '6585'
  AND  p."country"       = 'US'
GROUP BY
    p."port_name",
    s."state_name",
    ST_GEOGFROMWKB(p."port_geom", 4326)
LIMIT 20;
