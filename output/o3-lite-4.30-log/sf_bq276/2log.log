--Description:  Single Snowflake SQL that explains its own logic in comments.
--  ───────────────────────────────────────────────────────────────────────────
--  GOAL  ➜  For each U.S. port whose “region_number” = 6585, list every named
--           North‑Atlantic storm (≥35 kt, ≥tropical‑storm strength) that came
--           within 100 km, then summarise years, storm names, counts and
--           average intensity, returning geometries as WKT text.
--
--  WHY THE SHAPE?   GEOGRAPHY columns cannot appear in GROUP BY, and ARRAY_AGG
--                   does not accept GEOGRAPHY.  Therefore:
--                     • convert the port geometry to WKT text (port_wkt)
--                     • convert each storm‑fix point to WKT text for the array
--                   These text representations allow grouping/aggregation
--                   while still preserving geometry information.
--
--  STEPS
--  1. port_state  – filter ports (region 6585, US) and confirm each lies inside
--                   some U.S. state polygon; keep centroid, GEOGRAPHY, WKT and
--                   state name.
--  2. hits        – join each port with IBTrACS storm fixes that satisfy:
--                     basin = 'NA', wind ≥ 35 kt, sshs ≥ 0, proper name,
--                     distance ≤ 100 km.  DISTINCT eliminates duplicate fixes.
--  3. Final SELECT – aggregate by port_name / state_name / port_wkt.
--                   Return lists, counts, averages, the port WKT, plus an
--                   array of storm‑point WKTs.
--  4. LIMIT 20 is just for preview; remove for full result set.
--  ───────────────────────────────────────────────────────────────────────────

WITH port_state AS (                -- STEP 1
    SELECT
        p."index_number",
        p."port_name",
        TO_GEOGRAPHY(p."port_geom")                       AS "port_geog",
        ST_POINT(p."port_longitude", p."port_latitude")   AS "port_centroid",
        ST_ASWKT(TO_GEOGRAPHY(p."port_geom"))             AS "port_wkt",
        s."state_name"
    FROM NOAA_PORTS.GEO_INTERNATIONAL_PORTS.WORLD_PORT_INDEX p
    JOIN NOAA_PORTS.GEO_US_BOUNDARIES.STATES s
      ON ST_WITHIN(TO_GEOGRAPHY(p."port_geom"), TO_GEOGRAPHY(s."state_geom"))
    WHERE p."region_number" = '6585'
      AND p."country"       = 'US'
),
hits AS (                          -- STEP 2
    SELECT DISTINCT
        ps."port_name",
        ps."state_name",
        ps."port_wkt",
        h."sid",
        h."name"                        AS "storm_name",
        h."season",
        h."usa_wind",
        h."usa_sshs",
        ST_ASWKT(ST_POINT(h."longitude", h."latitude"))  AS "storm_wkt"
    FROM port_state ps
    JOIN NOAA_PORTS.NOAA_HURRICANES.HURRICANES h
      ON h."basin"     = 'NA'
     AND h."usa_wind"  >= 35
     AND h."usa_sshs"  >= 0
     AND h."name"     NOT ILIKE 'NOT%'
     AND ST_DISTANCE(
           ps."port_centroid",
           ST_POINT(h."longitude", h."latitude")
         ) <= 100000   -- 100 km
)
SELECT                               -- STEP 3
    "port_name",
    "state_name",
    ARRAY_AGG(DISTINCT "season")               AS "storm_years",
    COUNT(DISTINCT "sid")                      AS "total_distinct_storms",
    ARRAY_AGG(DISTINCT "storm_name")           AS "storm_names",
    AVG("usa_sshs")                            AS "avg_sshs_category",
    AVG("usa_wind")                            AS "avg_wind_knots",
    "port_wkt",                                -- port geometry as WKT
    ARRAY_AGG(DISTINCT "storm_wkt")            AS "storm_points_wkt"
FROM hits
GROUP BY
    "port_name",
    "state_name",
    "port_wkt"
LIMIT 20;
```
