   have been within 100 km of at least one named North‑Atlantic storm
   (wind ≥ 35 kt, SSHS ≥ TS).  Aggregate the requested metrics. */

WITH port_state AS (           -- ports + containing state
    SELECT
        p."index_number",
        p."port_name",
        TO_GEOGRAPHY(p."port_geom")                      AS "port_geometry",
        ST_POINT(p."port_longitude", p."port_latitude")  AS "port_centroid",
        s."state_name"
    FROM NOAA_PORTS.GEO_INTERNATIONAL_PORTS.WORLD_PORT_INDEX p
    JOIN NOAA_PORTS.GEO_US_BOUNDARIES.STATES s
      ON ST_WITHIN(TO_GEOGRAPHY(p."port_geom"), TO_GEOGRAPHY(s."state_geom"))
    WHERE p."region_number" = '6585'
      AND p."country"       = 'US'
),
named_storm_fixes AS (         -- 6‑hour fixes that satisfy wind / category
    SELECT
        h."sid",
        h."season",
        h."name"                             AS "storm_name",
        h."usa_wind",
        h."usa_sshs",
        ST_POINT(h."longitude", h."latitude") AS "storm_geometry"
    FROM NOAA_PORTS.NOAA_HURRICANES.HURRICANES h
    WHERE h."basin"     = 'NA'          -- North Atlantic
      AND h."usa_wind" >= 35
      AND h."usa_sshs" >= 0
      AND h."name"     NOT ILIKE 'NOT%' -- skip unnamed placeholders
),
hits AS (                       -- port / storm‑fix pairs within 100 km
    SELECT
        ps."index_number",
        ps."port_name",
        ps."state_name",
        ps."port_geometry",
        ns."sid",
        ns."season",
        ns."storm_name",
        ns."usa_sshs",
        ns."usa_wind",
        ns."storm_geometry"
    FROM port_state ps
    JOIN named_storm_fixes ns
      ON ST_DISTANCE(ps."port_centroid", ns."storm_geometry") <= 100000
)

SELECT
    "port_name",
    "state_name",
    ARRAY_AGG(DISTINCT "season")       WITHIN GROUP (ORDER BY "season")           AS "years",
    COUNT(DISTINCT "sid")                                                          AS "storm_count",
    ARRAY_AGG(DISTINCT "storm_name")   WITHIN GROUP (ORDER BY "storm_name")        AS "storm_names",
    ROUND(AVG("usa_sshs"), 2)                                                      AS "avg_category",
    ROUND(AVG("usa_wind"), 2)                                                      AS "avg_wind_speed_knots",
    TO_WKT("port_geometry")                                                        AS "port_geometry",
    ARRAY_AGG(DISTINCT TO_WKT("storm_geometry"))                                   AS "storm_geometries"
FROM hits
GROUP BY
    "port_name",
    "state_name",
    "port_geometry"
ORDER BY
    "port_name",
    "state_name";
