WITH port_state AS (           -- ports + containing state
    SELECT
        p."index_number",
        p."port_name",
        TO_GEOGRAPHY(p."port_geom")                      AS "port_geometry",
        ST_POINT(p."port_longitude", p."port_latitude")  AS "port_centroid",
