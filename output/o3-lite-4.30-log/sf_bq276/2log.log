```sql
-- THINKING PROCESS EMBEDDED AS COMMENTS:
-- 1) Filter ports: region_number = 6585 AND country = 'US'; convert their geometry to GEOGRAPHY and keep centroid.
-- 2) Spatially join each port against US state polygons to guarantee it lies within a state (adds state_name).
-- 3) Pull hurricane fixes meeting ALL criteria:
--        • basin = 'NA' (North Atlantic)
--        • usa_wind ≥ 35 kt  (tropical‑storm threshold)
--        • usa_sshs ≥ 0      (at least minimal TS on Saffir‑Simpson)
--        • name not like 'NOT%'  (exclude unnamed)
-- 4) Keep only storm fixes within 100 km of the port centroid.
-- 5) Aggregate per port/state, returning:
--        • DISTINCT list of years, DISTINCT storm names, count of storms
--        • average SSHS category and wind
--        • port GEOGRAPHY
--        • ARRAY of WKT‑encoded storm points (ARRAY_AGG on GEOGRAPHY not allowed)
-- 6) LIMIT 20 for preview.

WITH port_state AS (
    SELECT
        p."index_number",
        p."port_name",
        TO_GEOGRAPHY(p."port_geom")                     AS "port_geog",
        ST_POINT(p."port_longitude", p."port_latitude") AS "port_centroid",
        s."state_name"
    FROM NOAA_PORTS.GEO_INTERNATIONAL_PORTS.WORLD_PORT_INDEX p
    JOIN NOAA_PORTS.GEO_US_BOUNDARIES.STATES s
         ON ST_WITHIN(TO_GEOGRAPHY(p."port_geom"), TO_GEOGRAPHY(s."state_geom"))
    WHERE p."region_number" = '6585'
      AND p."country"       = 'US'
),
hits AS (
    SELECT DISTINCT
        ps."index_number",
        ps."port_name",
        ps."state_name",
        ps."port_geog",
        h."sid",
        h."name"                        AS "storm_name",
        h."season",
        h."usa_wind",
        h."usa_sshs",
        ST_POINT(h."longitude", h."latitude") AS "storm_geog"
    FROM port_state ps
    JOIN NOAA_PORTS.NOAA_HURRICANES.HURRICANES h
         ON h."basin"      = 'NA'
        AND h."usa_wind"   >= 35
        AND h."usa_sshs"   >= 0
        AND h."name"      NOT ILIKE 'NOT%'
        AND ST_DISTANCE(ps."port_centroid",
                        ST_POINT(h."longitude", h."latitude")) <= 100000 -- 100 km buffer
)
SELECT
    "port_name",
    "state_name",
    ARRAY_AGG(DISTINCT "season")               AS "storm_years",
    COUNT(DISTINCT "sid")                      AS "total_distinct_storms",
    ARRAY_AGG(DISTINCT "storm_name")           AS "storm_names",
    AVG("usa_sshs")                            AS "avg_sshs_category",
    AVG("usa_wind")                            AS "avg_wind_knots",
    "port_geog",
    ARRAY_AGG(DISTINCT ST_ASWKT("storm_geog")) AS "storm_points_wkt"
FROM hits
GROUP BY "port_name", "state_name", "port_geog"
LIMIT 20;
```
