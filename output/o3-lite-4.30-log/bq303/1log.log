Query:
--Description: Corrected “final answer” query (earlier #10) that now treats
--             `tags` as a pipe‑delimited string instead of an angle‑bracket
--             string.  The query assembles every contribution (questions,
--             answers, comments on questions, comments on answers) made between
--             1 Jul 2019 and 31 Dec 2019 by users with IDs 16 712 208‑18 712 208,
--             splits the tag string with SPLIT('|'), and returns one distinct
--             row per (user_id , individual_tag).  Limited to 20 rows for
--             quick inspection.
WITH
-- questions authored by the cohort
contrib_q AS (
  SELECT owner_user_id AS user_id, tags
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  WHERE creation_date BETWEEN '2019-07-01' AND '2020-01-01'
    AND owner_user_id BETWEEN 16712208 AND 18712208
),
-- answers authored by the cohort
contrib_a AS (
  SELECT a.owner_user_id AS user_id, q.tags
  FROM `bigquery-public-data.stackoverflow.posts_answers`   AS a
  JOIN `bigquery-public-data.stackoverflow.posts_questions` AS q
    ON q.id = a.parent_id
  WHERE a.creation_date BETWEEN '2019-07-01' AND '2020-01-01'
    AND a.owner_user_id BETWEEN 16712208 AND 18712208
),
-- comments directly on questions
contrib_cq AS (
  SELECT c.user_id, q.tags
  FROM `bigquery-public-data.stackoverflow.comments`        AS c
  JOIN `bigquery-public-data.stackoverflow.posts_questions` AS q
    ON q.id = c.post_id
  WHERE c.creation_date BETWEEN '2019-07-01' AND '2020-01-01'
    AND c.user_id BETWEEN 16712208 AND 18712208
),
-- comments on answers (mapped back to parent question)
contrib_ca AS (
  SELECT c.user_id, q.tags
  FROM `bigquery-public-data.stackoverflow.comments`        AS c
  JOIN `bigquery-public-data.stackoverflow.posts_answers`   AS a
    ON a.id = c.post_id
  JOIN `bigquery-public-data.stackoverflow.posts_questions` AS q
    ON q.id = a.parent_id
  WHERE c.creation_date BETWEEN '2019-07-01' AND '2020-01-01'
    AND c.user_id BETWEEN 16712208 AND 18712208
)
SELECT DISTINCT
  user_id,
  tag AS single_tag
FROM (
  SELECT * FROM contrib_q
  UNION ALL
  SELECT * FROM contrib_a
  UNION ALL
  SELECT * FROM contrib_cq
  UNION ALL
  SELECT * FROM contrib_ca
) AS all_contrib
CROSS JOIN UNNEST(SPLIT(tags, '|')) AS tag
LIMIT 20
