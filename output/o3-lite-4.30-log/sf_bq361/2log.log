Begin Exploring Related Columns
Relevant columns, their potential usage and possible filter conditions  

• ORDERS."user_id": identifies each shopper; will be used for cohort definition and for “returning” checks  
• ORDERS."created_at": micro‑seconds UNIX time‑stamp of an order; will be converted to calendar month / year  
  ‒ Condition examples:  
   EXTRACT(YEAR FROM TO_TIMESTAMP_NTZ("created_at"/1000000)) = 2020 (restrict to 2020)  
   EXTRACT(MONTH FROM TO_TIMESTAMP_NTZ("created_at"/1000000)) = 1     (restrict to January)  
• ORDERS."order_id": helps to inspect concrete orders that satisfy the cohort logic  
• ORDERS."status": can be tested (e.g. "Complete") if we only want completed purchases  

Only the table THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS is strictly required; the other tables are not needed for the cohort/return‑rate calculation.

Below are ten exploratory Snowflake queries (LIMIT 20 each, all column names double‑quoted) that move from basic inspection to a final query that would yield the requested proportion.

```sql
-- 1) Inspect a handful of raw orders: user_id, status and timestamp
SELECT "order_id",
       "user_id",
       "status",
       "created_at"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
LIMIT  20;
```

```sql
-- 2) Show distinct year‑month pairs present in the ORDERS table
SELECT DISTINCT
       EXTRACT(YEAR  FROM TO_TIMESTAMP_NTZ("created_at"/1000000)) AS "yr",
       EXTRACT(MONTH FROM TO_TIMESTAMP_NTZ("created_at"/1000000)) AS "mo"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
ORDER BY 1,2
LIMIT 20;
```

```sql
-- 3) List the first order date per user (all years) – sample 20
SELECT "user_id",
       MIN("created_at") AS "first_order_ts"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
GROUP  BY "user_id"
LIMIT  20;
```

```sql
-- 4) Pull users whose FIRST purchase happened in January‑2020 (sample list)
WITH firsts AS (
  SELECT "user_id",
         MIN("created_at") AS "first_ts"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP  BY "user_id"
)
SELECT f."user_id",
       f."first_ts"
FROM   firsts f
WHERE  EXTRACT(YEAR  FROM TO_TIMESTAMP_NTZ(f."first_ts"/1000000)) = 2020
  AND  EXTRACT(MONTH FROM TO_TIMESTAMP_NTZ(f."first_ts"/1000000)) = 1
LIMIT 20;
```

```sql
-- 5) Pick a few of those cohort users and show ALL their 2020 orders
WITH jan20 AS (
  SELECT "user_id",
         MIN("created_at") AS "first_ts"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP  BY "user_id"
  HAVING EXTRACT(YEAR  FROM TO_TIMESTAMP_NTZ(MIN("created_at")/1000000)) = 2020
     AND EXTRACT(MONTH FROM TO_TIMESTAMP_NTZ(MIN("created_at")/1000000)) = 1
)
SELECT o."user_id",
       o."order_id",
       TO_TIMESTAMP_NTZ(o."created_at"/1000000) AS "order_time",
       o."status"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   jan20 j
  ON   o."user_id" = j."user_id"
WHERE  EXTRACT(YEAR FROM TO_TIMESTAMP_NTZ(o."created_at"/1000000)) = 2020
ORDER  BY o."user_id", o."created_at"
LIMIT 20;
```

```sql
-- 6) Count how many January‑2020‑cohort users placed ANY order later in 2020
WITH jan20 AS (
  SELECT "user_id",
         MIN("created_at") AS "first_ts"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP  BY "user_id"
  HAVING EXTRACT(YEAR  FROM TO_TIMESTAMP_NTZ(MIN("created_at")/1000000)) = 2020
     AND EXTRACT(MONTH FROM TO_TIMESTAMP_NTZ(MIN("created_at")/1000000)) = 1
)
SELECT COUNT(DISTINCT o."user_id") AS "returning_users"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   jan20 j
  ON   o."user_id" = j."user_id"
WHERE  o."created_at" > j."first_ts"
  AND  EXTRACT(YEAR FROM TO_TIMESTAMP_NTZ(o."created_at"/1000000)) = 2020
LIMIT 20;
```

```sql
-- 7) Total size of the January‑2020 cohort (needed for denominator)
WITH firsts AS (
  SELECT "user_id",
         MIN("created_at") AS "first_ts"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP  BY "user_id"
)
SELECT COUNT(*) AS "cohort_size"
FROM   firsts
WHERE  EXTRACT(YEAR  FROM TO_TIMESTAMP_NTZ("first_ts"/1000000)) = 2020
  AND  EXTRACT(MONTH FROM TO_TIMESTAMP_NTZ("first_ts"/1000000)) = 1
LIMIT 20;
```

```sql
-- 8) Combine the two previous sub‑queries to calculate the proportion
WITH jan20 AS (
  SELECT "user_id",
         MIN("created_at") AS "first_ts"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP  BY "user_id"
  HAVING EXTRACT(YEAR  FROM TO_TIMESTAMP_NTZ(MIN("created_at")/1000000)) = 2020
     AND EXTRACT(MONTH FROM TO_TIMESTAMP_NTZ(MIN("created_at")/1000000)) = 1
),
returning AS (
  SELECT DISTINCT o."user_id"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  JOIN   jan20 j
    ON   o."user_id" = j."user_id"
  WHERE  o."created_at" > j."first_ts"
    AND  EXTRACT(YEAR FROM TO_TIMESTAMP_NTZ(o."created_at"/1000000)) = 2020
)
SELECT (SELECT COUNT(*) FROM returning)     AS "returned_cnt",
       (SELECT COUNT(*) FROM jan20)         AS "cohort_cnt",
       (SELECT COUNT(*) FROM returning)::FLOAT /
       NULLIF((SELECT COUNT(*) FROM jan20),0) AS "return_rate_2020"
LIMIT 20;
```

```sql
-- 9) Same as above but split by month of the second purchase
WITH jan20 AS (
  SELECT "user_id",
         MIN("created_at") AS "first_ts"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP  BY "user_id"
  HAVING EXTRACT(YEAR  FROM TO_TIMESTAMP_NTZ(MIN("created_at")/1000000)) = 2020
     AND EXTRACT(MONTH FROM TO_TIMESTAMP_NTZ(MIN("created_at")/1000000)) = 1
)
SELECT EXTRACT(MONTH FROM TO_TIMESTAMP_NTZ(o."created_at"/1000000)) AS "return_month",
       COUNT(DISTINCT o."user_id")                                 AS "users_returned"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   jan20 j
  ON   o."user_id" = j."user_id"
WHERE  o."created_at" > j."first_ts"
  AND  EXTRACT(YEAR FROM TO_TIMESTAMP_NTZ(o."created_at"/1000000)) = 2020
GROUP  BY 1
ORDER  BY 1
LIMIT 20;
```

```sql
-- 10) Surface individual user timelines for manual inspection
WITH jan20 AS (
  SELECT "user_id",
         MIN("created_at") AS "first_ts"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP  BY "user_id"
  HAVING EXTRACT(YEAR  FROM TO_TIMESTAMP_NTZ(MIN("created_at")/1000000)) = 2020
     AND EXTRACT(MONTH FROM TO_TIMESTAMP_NTZ(MIN("created_at")/1000000)) = 1
)
SELECT o."user_id",
       TO_TIMESTAMP_NTZ(j."first_ts"/1000000) AS "first_purchase",
       TO_TIMESTAMP_NTZ(o."created_at"/1000000) AS "later_purchase",
       o."order_id"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   jan20 j
  ON   o."user_id" = j."user_id"
WHERE  o."created_at" > j."first_ts"
  AND  EXTRACT(YEAR FROM TO_TIMESTAMP_NTZ(o."created_at"/1000000)) = 2020
ORDER  BY o."user_id", o."created_at"
LIMIT 20;
```

These ten queries walk from basic data familiarity to the final calculation that would deliver the proportion of January‑2020 first‑time purchasers who placed at least one additional order later in 2020.
