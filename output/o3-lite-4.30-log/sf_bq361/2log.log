-- 6) Count how many January‑2020‑cohort users placed ANY order later in 2020
WITH jan20 AS (
  SELECT "user_id",
         MIN("created_at") AS "first_ts"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP  BY "user_id"
  HAVING EXTRACT(YEAR  FROM TO_TIMESTAMP_NTZ(MIN("created_at")/1000000)) = 2020
     AND EXTRACT(MONTH FROM TO_TIMESTAMP_NTZ(MIN("created_at")/1000000)) = 1
)
SELECT COUNT(DISTINCT o."user_id") AS "returning_users"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   jan20 j
  ON   o."user_id" = j."user_id"
WHERE  o."created_at" > j."first_ts"
  AND  EXTRACT(YEAR FROM TO_TIMESTAMP_NTZ(o."created_at"/1000000)) = 2020
LIMIT 20;
