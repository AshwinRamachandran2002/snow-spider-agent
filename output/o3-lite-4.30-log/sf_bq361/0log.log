Relevant columns and their potential usage
• ORDERS."user_id": Identify which customer placed the order.  
• ORDERS."created_at": Micro‑second epoch value; convert to timestamp to know when the order occurred (used to derive the “first purchase date” and filter by month).  
• ORDERS."order_id": Needed when counting / de‑duplicating orders.  
• ORDERS."status": Optional filter (e.g., only ‘Complete’ orders if you need to ensure the purchase really happened).  
• USERS."id": Same key as ORDERS."user_id" (can be used to pull user attributes, but not mandatory for retention logic).  

Typical conditions you will see in the queries
1. Filter first‑time customers who placed their initial order between 2020‑01‑01 and 2020‑01‑31.  
2. Find any later order for those same customers where order‑date ≥ 2020‑02‑01 AND ≤ 2020‑12‑31.  
3. Compare counts of (a) all January‑2020 first‑time customers vs. (b) those who ordered again later in 2020, to derive the proportion.  
4. Optional extra filters on ORDERS."status" = 'Complete'.  

Below are ten Snowflake SQL snippets (simple → complex) that help you explore / assemble the answer.  
All column names are double‑quoted; each query shows only the first 20 rows with LIMIT 20.

```sql
-- Description: Raw peek at a few orders, just to see the timestamp values around Jan‑2020
SELECT 
    "order_id",
    "user_id",
    "status",
    "created_at",
    TO_TIMESTAMP("created_at" / 1000000) AS "created_ts"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
WHERE TO_TIMESTAMP("created_at" / 1000000) BETWEEN '2020-01-01' AND '2020-01-31'
LIMIT 20;
```

```sql
-- Description: Distinct users with their very first purchase date
SELECT 
    "user_id",
    MIN("created_at") AS "first_created_at",
    TO_TIMESTAMP(MIN("created_at") / 1000000) AS "first_purchase_ts"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
GROUP BY "user_id"
LIMIT 20;
```

```sql
-- Description: Identify cohort = users whose first purchase was in January‑2020
WITH firsts AS (
    SELECT 
        "user_id",
        MIN("created_at") AS "first_created_at"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    GROUP BY "user_id"
)
SELECT 
    "user_id",
    TO_TIMESTAMP("first_created_at" / 1000000) AS "first_purchase_ts"
FROM firsts
WHERE TO_TIMESTAMP("first_created_at" / 1000000) BETWEEN '2020-01-01' AND '2020-01-31'
LIMIT 20;
```

```sql
-- Description: Count how many users are in that January‑2020 first‑time cohort
WITH firsts AS (
    SELECT "user_id", MIN("created_at") AS "first_created_at"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    GROUP BY "user_id"
)
SELECT 
    COUNT(DISTINCT "user_id") AS "jan2020_first_time_users"
FROM firsts
WHERE TO_TIMESTAMP("first_created_at" / 1000000) BETWEEN '2020-01-01' AND '2020-01-31'
LIMIT 20;
```

```sql
-- Description: All 2020 orders (Feb‑Dec) placed by the January‑2020 cohort
WITH jan AS (
    SELECT "user_id"
    FROM (
        SELECT "user_id", MIN("created_at") AS "first_created_at"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
        GROUP BY "user_id"
    )
    WHERE TO_TIMESTAMP("first_created_at" / 1000000) BETWEEN '2020-01-01' AND '2020-01-31'
)
SELECT 
    o."user_id",
    o."order_id",
    TO_TIMESTAMP(o."created_at" / 1000000) AS "order_ts"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN jan USING ("user_id")
WHERE TO_TIMESTAMP(o."created_at" / 1000000) BETWEEN '2020-02-01' AND '2020-12-31'
LIMIT 20;
```

```sql
-- Description: Which of those January‑cohort users actually returned later in 2020
WITH jan AS (
    SELECT "user_id"
    FROM (
        SELECT "user_id", MIN("created_at") AS "first_created_at"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
        GROUP BY "user_id"
    )
    WHERE TO_TIMESTAMP("first_created_at" / 1000000) BETWEEN '2020-01-01' AND '2020-01-31'
)
SELECT DISTINCT
    o."user_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN jan USING ("user_id")
WHERE TO_TIMESTAMP(o."created_at" / 1000000) BETWEEN '2020-02-01' AND '2020-12-31'
LIMIT 20;
```

```sql
-- Description: Count the number of returning users
WITH jan_cohort AS (
    SELECT "user_id"
    FROM (
        SELECT "user_id", MIN("created_at") AS "first_created_at"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
        GROUP BY "user_id"
    )
    WHERE TO_TIMESTAMP("first_created_at" / 1000000) BETWEEN '2020-01-01' AND '2020-01-31'
), returning AS (
    SELECT DISTINCT o."user_id"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
    JOIN jan_cohort USING ("user_id")
    WHERE TO_TIMESTAMP(o."created_at" / 1000000) BETWEEN '2020-02-01' AND '2020-12-31'
)
SELECT 
    COUNT(*) AS "returning_users_2020"
FROM returning
LIMIT 20;
```

```sql
-- Description: Compute overall proportion of January‑2020 cohort who returned
WITH firsts AS (
    SELECT "user_id", MIN("created_at") AS "first_created_at"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    GROUP BY "user_id"
), jan_cohort AS (
    SELECT "user_id"
    FROM firsts
    WHERE TO_TIMESTAMP("first_created_at" / 1000000) BETWEEN '2020-01-01' AND '2020-01-31'
), returning AS (
    SELECT DISTINCT o."user_id"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
    JOIN jan_cohort USING ("user_id")
    WHERE TO_TIMESTAMP(o."created_at" / 1000000) BETWEEN '2020-02-01' AND '2020-12-31'
)
SELECT
    (SELECT COUNT(*) FROM returning)      AS "returned_users",
    (SELECT COUNT(*) FROM jan_cohort)     AS "total_cohort",
    (SELECT COUNT(*) FROM returning)::FLOAT / NULLIF((SELECT COUNT(*) FROM jan_cohort),0) AS "proportion_returned"
LIMIT 20;
```

```sql
-- Description: Month‑by‑month retention – how many of the cohort ordered in each subsequent month
WITH jan_cohort AS (
    SELECT "user_id"
    FROM (
        SELECT "user_id", MIN("created_at") AS "first_created_at"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
        GROUP BY "user_id"
    )
    WHERE TO_TIMESTAMP("first_created_at" / 1000000) BETWEEN '2020-01-01' AND '2020-01-31'
), user_months AS (
    SELECT DISTINCT
        o."user_id",
        DATE_TRUNC('month', TO_TIMESTAMP(o."created_at" / 1000000)) AS "order_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
    JOIN jan_cohort USING ("user_id")
    WHERE TO_TIMESTAMP(o."created_at" / 1000000) > '2020-01-31'
      AND TO_TIMESTAMP(o."created_at" / 1000000) <= '2020-12-31'
)
SELECT
    "order_month",
    COUNT(DISTINCT "user_id") AS "users_in_month"
FROM user_months
GROUP BY "order_month"
ORDER BY "order_month"
LIMIT 20;
```

```sql
-- Description: Final concise answer – proportion for the whole year, plus per‑month retention
WITH firsts AS (
    SELECT "user_id", MIN("created_at") AS "first_created_at"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    GROUP BY "user_id"
), jan_cohort AS (
    SELECT "user_id"
    FROM firsts
    WHERE TO_TIMESTAMP("first_created_at" / 1000000) BETWEEN '2020-01-01' AND '2020-01-31'
), later_orders AS (
    SELECT 
        o."user_id",
        DATE_TRUNC('month', TO_TIMESTAMP(o."created_at" / 1000000)) AS "order_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
    JOIN jan_cohort USING ("user_id")
    WHERE TO_TIMESTAMP(o."created_at" / 1000000) BETWEEN '2020-02-01' AND '2020-12-31'
), summary AS (
    SELECT
        (SELECT COUNT(*) FROM jan_cohort)                          AS "total_cohort",
        (SELECT COUNT(DISTINCT "user_id") FROM later_orders)       AS "returned_any_time"
)
SELECT 
    s."total_cohort",
    s."returned_any_time",
    s."returned_any_time"::FLOAT / NULLIF(s."total_cohort",0) AS "proportion_returned",
    m."order_month",
    m."users_in_month",
    m."users_in_month"::FLOAT / NULLIF(s."total_cohort",0)   AS "monthly_retention_rate"
FROM summary s
LEFT JOIN (
    SELECT 
        "order_month",
        COUNT(DISTINCT "user_id") AS "users_in_month"
    FROM later_orders
    GROUP BY "order_month"
) m ON TRUE
ORDER BY "order_month"
LIMIT 20;
```

The ten queries above show the step‑by‑step exploration necessary to calculate the desired retention proportion for the January‑2020 first‑purchase cohort.
