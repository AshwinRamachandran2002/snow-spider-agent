WITH jan20_cohort AS (
  SELECT "user_id"
  FROM (
      SELECT "user_id",
             MIN("created_at") AS "first_order_ts"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
      GROUP BY "user_id"
  )
  WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515200000000
)
SELECT DISTINCT TO_CHAR(TO_TIMESTAMP("created_at"/1000000), 'YYYY‑MM') AS "order_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN jan20_cohort c
  ON o."user_id" = c."user_id"
WHERE o."created_at" BETWEEN 1580515200000000 AND 1609459200000000
ORDER BY "order_month"
LIMIT 20;
