2025-05-01 01:48:38 - Thread-473 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
• ORDERS."user_id": link each order back to a shopper  
• ORDERS."order_id": unique order identifier (needed to count/aggregate)  
• ORDERS."created_at": micro‑second epoch time stamp of the order (used to isolate January‑2020 first purchases and later months in 2020)  
• ORDER_ITEMS."order_id": lets you join to ORDERS when you need item–level detail (optional)  
• USERS."id": user identifier if demographic segmentation is later required  
• USERS."created_at": shopper account creation date (optional, not essential for “first purchase”)  

Typical conditions you will likely use  
1. ORDERS."created_at" BETWEEN 1577836800000000 /*2020‑01‑01 00:00:00*/  
                              AND     1580515200000000 /*2020‑02‑01 00:00:00*/    → January‑2020 window  
2. ORDERS."created_at" BETWEEN 1580515200000000 /*2020‑02‑01*/  
                              AND     1609459200000000 /*2021‑01‑01*/    → rest of 2020  
3. HAVING MIN(ORDERS."created_at") … to isolate “first purchase” month  
4. WHERE ORDERS."user_id" IN ( … ) to filter to the January‑2020 cohort  

Below are ten exploratory Snowflake SQL snippets (LIMIT 20 rows each).  
All column names are quoted, and fully‑qualified database / schema / table names are used.

```sql
--Description: 1. Peek at a few orders to confirm the raw time‑stamp format.
SELECT "order_id",
       "user_id",
       "created_at",
       "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
ORDER BY "created_at"
LIMIT 20;
```

```sql
--Description: 2. Sample orders whose "created_at" falls in January‑2020.
SELECT "order_id",
       "user_id",
       "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "created_at" BETWEEN 1577836800000000 AND 1580515200000000
ORDER BY "created_at"
LIMIT 20;
```

```sql
--Description: 3. Distinct shoppers who placed an order in January‑2020.
SELECT DISTINCT "user_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "created_at" BETWEEN 1577836800000000 AND 1580515200000000
LIMIT 20;
```

```sql
--Description: 4. For each user, show their first‑ever order time‑stamp (all years).
SELECT "user_id",
       MIN("created_at") AS "first_order_ts"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
GROUP BY "user_id"
ORDER BY "first_order_ts"
LIMIT 20;
```

```sql
--Description: 5. Isolate users whose FIRST purchase happened in January‑2020.
WITH firsts AS (
  SELECT "user_id",
         MIN("created_at") AS "first_order_ts"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
)
SELECT "user_id",
       "first_order_ts"
FROM firsts
WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515200000000
LIMIT 20;
```

```sql
--Description: 6. Count of users whose first purchase was in January‑2020.
WITH firsts AS (
  SELECT "user_id",
         MIN("created_at") AS "first_order_ts"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
)
SELECT COUNT(*) AS "jan_2020_first_purchase_users"
FROM firsts
WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515200000000
LIMIT 20;
```

```sql
--Description: 7. Subsequent 2020 orders placed by that January‑2020 cohort.
WITH jan20_cohort AS (
  SELECT "user_id"
  FROM (
      SELECT "user_id",
             MIN("created_at") AS "first_order_ts"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
      GROUP BY "user_id"
  )
  WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515200000000
)
SELECT o."order_id",
       o."user_id",
       o."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN jan20_cohort c
  ON o."user_id" = c."user_id"
WHERE o."created_at" BETWEEN 1580515200000000 AND 1609459200000000
ORDER BY o."created_at"
LIMIT 20;
```

```sql
--Description: 8. Distinct months (yyyy‑mm) when cohort users placed another order in 2020.
WITH jan20_cohort AS (
  SELECT "user_id"
  FROM (
      SELECT "user_id",
             MIN("created_at") AS "first_order_ts"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
      GROUP BY "user_id"
  )
  WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515200000000
)
SELECT DISTINCT TO_CHAR(TO_TIMESTAMP("created_at"/1000000), 'YYYY‑MM') AS "order_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN jan20_cohort c
  ON o."user_id" = c."user_id"
WHERE o."created_at" BETWEEN 1580515200000000 AND 1609459200000000
ORDER BY "order_month"
LIMIT 20;
```

```sql
--Description: 9. For each month in 2020, number of cohort users that returned.
WITH jan20_cohort AS (
  SELECT "user_id"
  FROM (
      SELECT "user_id",
             MIN("created_at") AS "first_order_ts"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
      GROUP BY "user_id"
  )
  WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515200000000
),
orders_2020 AS (
  SELECT o."user_id",
         TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000), 'YYYY‑MM') AS "order_month"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  JOIN jan20_cohort c
    ON o."user_id" = c."user_id"
  WHERE o."created_at" BETWEEN 1580515200000000 AND 1609459200000000
)
SELECT "order_month",
       COUNT(DISTINCT "user_id") AS "returning_users"
FROM orders_2020
GROUP BY "order_month"
ORDER BY "order_month"
LIMIT 20;
```

```sql
--Description: 10. Calculate overall 2020 return‑rate for the Jan‑2020 cohort.
WITH firsts AS (
  SELECT "user_id",
         MIN("created_at") AS "first_order_ts"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
),
jan20_cohort AS (
  SELECT "user_id"
  FROM firsts
  WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515200000000
),
returned_2020 AS (
  SELECT DISTINCT o."user_id"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  JOIN jan20_cohort c
    ON o."user_id" = c."user_id"
  WHERE o."created_at" BETWEEN 1580515200000000 AND 1609459200000000
)
SELECT (SELECT COUNT(*) FROM returned_2020)::FLOAT /
       (SELECT COUNT(*) FROM jan20_cohort)     AS "return_proportion_2020"
LIMIT 20;
```
