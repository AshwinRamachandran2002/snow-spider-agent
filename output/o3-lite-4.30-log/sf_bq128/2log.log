WITH apps AS (
    /* U.S. patents whose earliest application was filed
       between 2014‑01‑01 and 2014‑02‑01                     */
    SELECT  "patent_id",
            MIN(TO_DATE("date",'YYYY-MM-DD')) AS filing_date
    FROM    PATENTSVIEW.PATENTSVIEW.APPLICATION
    WHERE   "country" = 'US'
      AND   TO_DATE("date",'YYYY-MM-DD') BETWEEN '2014-01-01' AND '2014-02-01'
    GROUP BY "patent_id"
),
/* backward citations (only those dated BEFORE the filing date) */
backward AS (
    SELECT  u."patent_id",
            COUNT(*) AS backward_citations
    FROM    PATENTSVIEW.PATENTSVIEW.USPATENTCITATION u
    JOIN    apps a
           ON a."patent_id" = u."patent_id"
    WHERE   TRY_TO_DATE(u."date",'YYYY-MM-DD') IS NOT NULL
      AND   TRY_TO_DATE(u."date",'YYYY-MM-DD') < a.filing_date
    GROUP BY u."patent_id"
),
/* forward citations (within 5 years AFTER the publication date) */
forward AS (
    SELECT  u."citation_id"                       AS patent_id,
            COUNT(*)                              AS forward_citations_5yr
    FROM    PATENTSVIEW.PATENTSVIEW.USPATENTCITATION u
    JOIN    apps a
           ON a."patent_id" = u."citation_id"
    JOIN    PATENTSVIEW.PATENTSVIEW.PATENT p
           ON p."id" = u."citation_id"
    WHERE   TRY_TO_DATE(u."date",'YYYY-MM-DD') IS NOT NULL
      AND   TRY_TO_DATE(p."date",'YYYY-MM-DD') IS NOT NULL
      AND   TRY_TO_DATE(u."date",'YYYY-MM-DD') >= TRY_TO_DATE(p."date",'YYYY-MM-DD')
      AND   TRY_TO_DATE(u."date",'YYYY-MM-DD') <  DATEADD('year',5,TRY_TO_DATE(p."date",'YYYY-MM-DD'))
    GROUP BY u."citation_id"
)
/* final list */
SELECT  p."title"                                   AS patent_title,
        p."abstract",
        p."date"                                    AS publication_date,
        COALESCE(b.backward_citations ,0)           AS backward_citations,
        COALESCE(f.forward_citations_5yr,0)         AS forward_citations_5yr
FROM    PATENTSVIEW.PATENTSVIEW.PATENT   p
JOIN    apps      a ON a."patent_id" = p."id"
LEFT JOIN backward b ON b."patent_id" = p."id"
LEFT JOIN forward  f ON f."patent_id" = p."id"
ORDER BY TRY_TO_DATE(p."date",'YYYY-MM-DD'), p."id";
```
