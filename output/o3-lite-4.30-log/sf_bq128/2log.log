Begin Exploring Related Columns
Relevant tables / columns & how they will be used (main ones only)

PATENTSVIEW.PATENTSVIEW.PATENT  
• "id" – the patent number (key that ties everything together)  
• "title" – patent title (requested)  
• "abstract" – patent abstract (requested)  
• "date" – grant / publication date (will be treated as publication date)  
• "country" – filter to 'US'  

PATENTSVIEW.PATENTSVIEW.APPLICATION  
• "patent_id" – FK to PATENT."id"  
• "date" – application (filing) date → filter 2014‑01‑01 ≤ date < 2014‑02‑02 – also needed to compare with backward‑citation dates  

PATENTSVIEW.PATENTSVIEW.CPC_CURRENT  
• "patent_id" – FK to PATENT."id"  
• "subsection_id" – choose C05 … C13  
• "group_id" – choose from the bio/chem list supplied (A01G … G16H)  
→ At least one row must satisfy either condition for the patent to be kept  

PATENTSVIEW.PATENTSVIEW.USPATENTCITATION  
• "patent_id" – citing patent (current) → backward citations  
• "citation_id" – cited patent (target of backward citation) – used to join the “other side” for forward citations  
• "date" – date of the cited patent ⇒ to count backward (date < filing) or forward (date ≤ pub+5 yr ∧ date ≥ pub)  

The following ten exploratory queries show the data pieces step by step (each returns at most 20 rows).

```sql
-- 1) Get all U.S. applications filed 1‑Jan‑2014 – 1‑Feb‑2014
SELECT DISTINCT
       a."patent_id",
       a."date"   AS "filing_date"
FROM   PATENTSVIEW.PATENTSVIEW.APPLICATION a
WHERE  a."date" BETWEEN '2014-01-01' AND '2014-02-01'
  AND  a."country" = 'US'
LIMIT 20;
```

```sql
-- 2) Inspect core bibliographic info for those patents
SELECT p."id",
       p."title",
       p."abstract",
       p."date"      AS "pub_date",
       p."country"
FROM   PATENTSVIEW.PATENTSVIEW.PATENT p
WHERE  p."id" IN ( SELECT a."patent_id"
                   FROM PATENTSVIEW.PATENTSVIEW.APPLICATION a
                   WHERE a."date" BETWEEN '2014-01-01' AND '2014-02-01' )
LIMIT 20;
```

```sql
-- 3) Show CPC classifications for the same patents
SELECT DISTINCT
       c."patent_id",
       c."subsection_id",
       c."group_id",
       c."category"
FROM   PATENTSVIEW.PATENTSVIEW.CPC_CURRENT c
WHERE  c."patent_id" IN ( SELECT a."patent_id"
                          FROM PATENTSVIEW.PATENTSVIEW.APPLICATION a
                          WHERE a."date" BETWEEN '2014-01-01' AND '2014-02-01' )
LIMIT 20;
```

```sql
-- 4) Filter patents to the life‑science / chemistry CPC ranges only
SELECT DISTINCT
       c."patent_id"
FROM   PATENTSVIEW.PATENTSVIEW.CPC_CURRENT c
WHERE (
          c."subsection_id" BETWEEN 'C05' AND 'C13'
       OR c."group_id" IN ('A01G','A01H','A61K','A61P','A61Q',
                           'B01F','B01J','B81B','B82B','B82Y',
                           'G01N','G16H')
      )
  AND  c."patent_id" IN ( SELECT a."patent_id"
                          FROM PATENTSVIEW.PATENTSVIEW.APPLICATION a
                          WHERE a."date" BETWEEN '2014-01-01' AND '2014-02-01' )
LIMIT 20;
```

```sql
-- 5) Raw backward citations made by those patents
SELECT u."patent_id"          AS "citing_pat",
       u."citation_id"        AS "cited_pat",
       u."date"               AS "cited_pat_date"
FROM   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION u
WHERE  u."patent_id" IN ( SELECT DISTINCT c."patent_id"
                          FROM PATENTSVIEW.PATENTSVIEW.CPC_CURRENT c
                          WHERE (
                                 c."subsection_id" BETWEEN 'C05' AND 'C13'
                              OR c."group_id" IN ('A01G','A01H','A61K','A61P','A61Q',
                                                  'B01F','B01J','B81B','B82B','B82Y',
                                                  'G01N','G16H')
                                )
                            AND c."patent_id" IN ( SELECT a."patent_id"
                                                   FROM PATENTSVIEW.PATENTSVIEW.APPLICATION a
                                                   WHERE a."date" BETWEEN '2014-01-01' AND '2014-02-01' )
                         )
LIMIT 20;
```

```sql
-- 6) Count backward citations per patent (only before filing date)
SELECT u."patent_id",
       COUNT(*) AS "backward_cnt"
FROM   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION u
JOIN   PATENTSVIEW.PATENTSVIEW.APPLICATION a
       ON a."patent_id" = u."patent_id"
WHERE  a."date" BETWEEN '2014-01-01' AND '2014-02-01'
  AND  u."date" < a."date"
GROUP  BY u."patent_id"
LIMIT 20;
```

```sql
-- 7) Raw forward citations within 5 years of publication
SELECT u."citation_id"   AS "original_pat",
       u."patent_id"     AS "later_citing_pat",
       u."date"          AS "later_pat_date"
FROM   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION u
JOIN   PATENTSVIEW.PATENTSVIEW.PATENT p
       ON p."id" = u."citation_id"
WHERE  p."country" = 'US'
  AND  p."date" BETWEEN '2014-01-01' AND '2014-02-01'
  AND  u."date" >= p."date"
  AND  u."date" <= DATEADD(year, 5, p."date")
LIMIT 20;
```

```sql
-- 8) Count forward citations within 5 years per patent
SELECT u."citation_id"               AS "patent_id",
       COUNT(*)                      AS "forward_5yr_cnt"
FROM   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION u
JOIN   PATENTSVIEW.PATENTSVIEW.PATENT p
       ON p."id" = u."citation_id"
WHERE  p."country" = 'US'
  AND  p."date" BETWEEN '2014-01-01' AND '2014-02-01'
  AND  u."date" >= p."date"
  AND  u."date" <= DATEADD(year, 5, p."date")
GROUP  BY u."citation_id"
LIMIT 20;
```

```sql
-- 9) Combine bibliographic info with both citation counts (still without CPC filter)
SELECT p."id",
       p."title",
       p."abstract",
       p."date"                             AS "pub_date",
       COALESCE(b."backward_cnt",0)         AS "backward_cnt",
       COALESCE(f."forward_5yr_cnt",0)      AS "forward_5yr_cnt"
FROM   PATENTSVIEW.PATENTSVIEW.PATENT p
LEFT  JOIN ( SELECT u."patent_id",
                    COUNT(*) AS "backward_cnt"
             FROM   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION u
             JOIN   PATENTSVIEW.PATENTSVIEW.APPLICATION a
                    ON a."patent_id" = u."patent_id"
             WHERE  a."date" BETWEEN '2014-01-01' AND '2014-02-01'
               AND  u."date" < a."date"
             GROUP BY u."patent_id"
           ) b
       ON b."patent_id" = p."id"
LEFT  JOIN ( SELECT u."citation_id",
                    COUNT(*) AS "forward_5yr_cnt"
             FROM   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION u
             JOIN   PATENTSVIEW.PATENTSVIEW.PATENT p2
                    ON p2."id" = u."citation_id"
             WHERE  p2."date" BETWEEN '2014-01-01' AND '2014-02-01'
               AND  u."date" >= p2."date"
               AND  u."date" <= DATEADD(year,5,p2."date")
             GROUP BY u."citation_id"
           ) f
       ON f."citation_id" = p."id"
WHERE  p."id" IN ( SELECT a."patent_id"
                   FROM   PATENTSVIEW.PATENTSVIEW.APPLICATION a
                   WHERE  a."date" BETWEEN '2014-01-01' AND '2014-02-01' )
LIMIT 20;
```

```sql
--10) Final consolidated query with CPC life‑science filters applied
SELECT p."id",
       p."title",
       p."abstract",
       p."date"                             AS "pub_date",
       COALESCE(b."backward_cnt",0)         AS "backward_cnt",
       COALESCE(f."forward_5yr_cnt",0)      AS "forward_5yr_cnt"
FROM   PATENTSVIEW.PATENTSVIEW.PATENT  p
JOIN   PATENTSVIEW.PATENTSVIEW.APPLICATION a
       ON a."patent_id" = p."id"
JOIN   PATENTSVIEW.PATENTSVIEW.CPC_CURRENT c
       ON c."patent_id" = p."id"
LEFT  JOIN ( SELECT u."patent_id",
                    COUNT(*) AS "backward_cnt"
             FROM   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION u
             JOIN   PATENTSVIEW.PATENTSVIEW.APPLICATION a2
                    ON a2."patent_id" = u."patent_id"
             WHERE  a2."date" BETWEEN '2014-01-01' AND '2014-02-01'
               AND  u."date" < a2."date"
             GROUP BY u."patent_id"
           ) b
       ON b."patent_id" = p."id"
LEFT  JOIN ( SELECT u."citation_id",
                    COUNT(*) AS "forward_5yr_cnt"
             FROM   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION u
             JOIN   PATENTSVIEW.PATENTSVIEW.PATENT p3
                    ON p3."id" = u."citation_id"
             WHERE  p3."date" BETWEEN '2014-01-01' AND '2014-02-01'
               AND  u."date" >= p3."date"
               AND  u."date" <= DATEADD(year,5,p3."date")
             GROUP BY u."citation_id"
           ) f
       ON f."citation_id" = p."id"
WHERE  a."date" BETWEEN '2014-01-01' AND '2014-02-01'
  AND  p."country" = 'US'
  AND ( c."subsection_id" BETWEEN 'C05' AND 'C13'
        OR c."group_id" IN ('A01G','A01H','A61K','A61P','A61Q',
                            'B01F','B01J','B81B','B82B','B82Y',
                            'G01N','G16H') )
GROUP BY p."id", p."title", p."abstract", p."date", b."backward_cnt", f."forward_5yr_cnt"
LIMIT 20;
```

