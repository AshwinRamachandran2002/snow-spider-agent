```sql
WITH "apps" AS (
    /* U.S. applications filed between 2014‑01‑01 and 2014‑02‑01
       (take the first – earliest – filing date per patent) */
    SELECT  "patent_id",
            MIN("date") AS "filing_date"
    FROM    PATENTSVIEW.PATENTSVIEW.APPLICATION
    WHERE   "country" = 'US'
      AND   "date" BETWEEN '2014-01-01' AND '2014-02-01'
    GROUP BY "patent_id"
),
/* patents each application cites BEFORE its own filing date */
"backward" AS (
    SELECT  u."patent_id",
            COUNT(*) AS "backward_citations"
    FROM    PATENTSVIEW.PATENTSVIEW.USPATENTCITATION u
    JOIN    "apps" a
      ON    a."patent_id" = u."patent_id"
    WHERE   u."date" < a."filing_date"
    GROUP BY u."patent_id"
),
/* patents that cite the focal patent WITHIN 5 years after publication */
"forward" AS (
    SELECT  u."citation_id"                     AS "patent_id",
            COUNT(*)                           AS "forward_citations_5yr"
    FROM    PATENTSVIEW.PATENTSVIEW.USPATENTCITATION u
    JOIN    PATENTSVIEW.PATENTSVIEW.PATENT p
      ON    p."id" = u."citation_id"
    JOIN    "apps" a                            /* restrict to the same focal patents */
      ON    a."patent_id" = p."id"
    WHERE   u."date" >= p."date"
      AND   u."date" < DATEADD('year', 5, p."date")
    GROUP BY u."citation_id"
)
/* final result */
SELECT  p."title"                               AS patent_title,
        p."abstract",
        p."date"                                AS publication_date,
        COALESCE(b."backward_citations", 0)     AS backward_citations,
        COALESCE(f."forward_citations_5yr", 0)  AS forward_citations_5yr
FROM    PATENTSVIEW.PATENTSVIEW.PATENT p
JOIN    "apps"  a  ON a."patent_id" = p."id"
LEFT JOIN "backward" b ON b."patent_id" = p."id"
LEFT JOIN "forward"  f ON f."patent_id" = p."id"
ORDER BY p."date", p."id";
```
