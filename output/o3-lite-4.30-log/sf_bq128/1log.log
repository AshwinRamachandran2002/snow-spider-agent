```sql
WITH patents_filtered AS (   -- U.S. patents published 1 Jan 2014‑1 Feb 2014
    SELECT  p."id"                           AS patent_id,
            p."title",
            p."abstract",
            TO_DATE(p."date")               AS pub_date
    FROM    PATENTSVIEW.PATENTSVIEW.PATENT p
    WHERE   p."country" = 'US'
      AND   p."date" BETWEEN '2014-01-01' AND '2014-02-01'
),
bio_chem_patents AS (        -- keep only chemistry / biology / medical CPC codes
    SELECT DISTINCT pf.*
    FROM   patents_filtered pf
    JOIN   PATENTSVIEW.PATENTSVIEW.CPC_CURRENT cpc
           ON cpc."patent_id" = pf.patent_id
    WHERE  ( cpc."subsection_id" BETWEEN 'C05' AND 'C13'
          OR cpc."group_id" IN ('A01G','A01H','A61K','A61P','A61Q',
                                'B01F','B01J','B81B','B82B','B82Y',
                                'G01N','G16H') )
),
filing_dates AS (            -- earliest application (filing) date for each patent
    SELECT  a."patent_id",
            MIN(TO_DATE(a."date")) AS filing_date
    FROM    PATENTSVIEW.PATENTSVIEW.APPLICATION a
    GROUP BY a."patent_id"
),
backward AS (                -- backward citations made BEFORE the filing date
    SELECT  bp.patent_id,
            COUNT(DISTINCT c1."citation_id") AS backward_citations
    FROM    bio_chem_patents bp
    LEFT JOIN PATENTSVIEW.PATENTSVIEW.USPATENTCITATION c1
           ON c1."patent_id" = bp.patent_id
    LEFT JOIN filing_dates fd
           ON fd."patent_id" = bp.patent_id
    WHERE   c1."citation_id" IS NOT NULL
      AND   fd.filing_date    IS NOT NULL
      AND   TO_DATE(c1."date") < fd.filing_date
    GROUP BY bp.patent_id
),
forward AS (                 -- forward citations WITHIN 5 years of publication
    SELECT  bp.patent_id,
            COUNT(DISTINCT c2."patent_id") AS forward_citations_5yr
    FROM    bio_chem_patents bp
    LEFT JOIN PATENTSVIEW.PATENTSVIEW.USPATENTCITATION c2
           ON c2."citation_id" = bp.patent_id
    LEFT JOIN PATENTSVIEW.PATENTSVIEW.PATENT p2   -- citing patent
           ON p2."id" = c2."patent_id"
    WHERE   p2."date" IS NOT NULL
      AND   TO_DATE(p2."date") <= DATEADD(year, 5, bp.pub_date)
    GROUP BY bp.patent_id
)
SELECT
    bp."title"                                 AS patent_title,
    bp."abstract",
    bp.pub_date                                AS publication_date,
    COALESCE(b.backward_citations, 0)          AS backward_citations,
    COALESCE(f.forward_citations_5yr, 0)       AS forward_citations_5yr
FROM        bio_chem_patents bp
LEFT JOIN   backward b  ON b.patent_id = bp.patent_id
LEFT JOIN   forward  f  ON f.patent_id  = bp.patent_id
ORDER BY    bp.pub_date, bp.patent_id;
```

