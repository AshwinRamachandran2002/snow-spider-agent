    GROUP BY dm."name_id"
    ORDER BY num_movies DESC
    LIMIT 4
)
SELECT n."name"  AS "director",
       dr."num_movies"  AS "high_rated_count"
FROM directors_ranked dr
JOIN "names" n ON n."id" = dr."name_id"
ORDER BY dr."num_movies" DESC;
```

