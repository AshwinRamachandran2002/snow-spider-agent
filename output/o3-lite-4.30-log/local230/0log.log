```sql
WITH
-- movies whose average rating is higher than 8
high_rated AS (
    SELECT movie_id
    FROM ratings
    WHERE avg_rating > 8
),
-- the three genres that contain the largest number of such movies
top_genres AS (
    SELECT g.genre
    FROM genre AS g
    JOIN high_rated AS h ON g.movie_id = h.movie_id
    GROUP BY g.genre
    ORDER BY COUNT(*) DESC
    LIMIT 3
),
-- high‑rated movies that belong to at least one of those three genres
qualified_movies AS (
    SELECT DISTINCT h.movie_id
    FROM high_rated AS h
    JOIN genre      AS g ON h.movie_id = g.movie_id
    WHERE g.genre IN (SELECT genre FROM top_genres)
),
-- count how many qualified movies each director has made
director_counts AS (
    SELECT n.name AS director_name,
           COUNT(DISTINCT dm.movie_id) AS movie_count
    FROM director_mapping AS dm
    JOIN qualified_movies AS qm ON dm.movie_id = qm.movie_id
    JOIN names             AS n  ON dm.name_id  = n.id
    GROUP BY n.name
)
-- top four directors with the highest counts
SELECT director_name, movie_count
FROM director_counts
ORDER BY movie_count DESC, director_name
LIMIT 4;
```
