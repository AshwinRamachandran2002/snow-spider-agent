--Description: Extract all numeric member IDs from relation 124140, then look for
--             any of those IDs in PLANET_FEATURES (matching either “osm_id” or
--             “osm_way_id”).  Show up to 20 distinct features so we can examine
--             which members are present and what tags they have, without imposing
--             extra filters that previously returned no rows.
WITH member_ids AS (
    SELECT m.value:"id"::NUMBER AS id
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
           LATERAL FLATTEN(input => r."members") m
    WHERE  r."id" = 124140
)
SELECT DISTINCT
       f."osm_id",
       f."osm_way_id",
       f."feature_type",
       f."all_tags"
FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" f
JOIN   member_ids mi
       ON  (f."osm_id" = mi.id OR f."osm_way_id" = mi.id)
LIMIT 20;
