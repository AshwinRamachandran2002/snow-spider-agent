--Description: In relation 124140 each member object indicates "type":"w", meaning the
--             children are ways stored in PLANET_WAYS (not PLANET_FEATURES).  This query
--             (1) extracts all numeric member IDs from the relation’s “members” array,
--             (2) joins those IDs to PLANET_WAYS, and (3) keeps only the ways whose own
--             tag array contains a “wikidata” key, returning up to 20 such members.
WITH member_ids AS (                                  -- collect way IDs from relation 124140
  SELECT m.value:"id"::NUMBER AS id
  FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
         LATERAL FLATTEN(input => r."members") m
  WHERE  r."id" = 124140
)
SELECT DISTINCT
       w."id"      AS "member_way_id",
       w."all_tags"
FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS" w
JOIN   member_ids mi
       ON w."id" = mi.id
,      LATERAL FLATTEN(input => w."all_tags") tag
WHERE  tag.value:"key"::STRING = 'wikidata'
LIMIT 20;
```
