--Description: 7. Show the members of relation 124140 that themselves carry a “wikidata”
--             tag.  We flatten PLANET_FEATURES.tags to locate such members.
SELECT DISTINCT
       p."osm_id",
       p."all_tags"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES"  p,
     LATERAL FLATTEN(input => p."all_tags")                     tag
WHERE p."osm_id" IN ( SELECT m.value::NUMBER
                      FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
                           LATERAL FLATTEN(input => r."members") m
                      WHERE r."id" = 124140 )
  AND tag.value:"key"::STRING = 'wikidata'
LIMIT 20;


--Description: 8. Count how many planet_features intersect each candidate relation that
--             overlaps the Q1095 multipolygon, has a name tag, and lacks its own
--             wikidata tag.
WITH q AS (   -- geometry of the Q1095 multipolygon
  SELECT TO_GEOGRAPHY(p."geometry") AS g
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" p,
       LATERAL FLATTEN(input => p."all_tags") tag
  WHERE p."feature_type" = 'multipolygons'
    AND tag.value:"key"::STRING   = 'wikidata'
    AND tag.value:"value"::STRING = 'Q1095'
  LIMIT 1
), cand AS (  -- candidate relations that satisfy tag rules
  SELECT r."id",
         TO_GEOGRAPHY(r."geometry") AS rg
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
       LATERAL FLATTEN(input => r."all_tags") tag,
       q
  WHERE ST_INTERSECTS(TO_GEOGRAPHY(r."geometry"), q.g)
  GROUP BY r."id", r."geometry"
  HAVING MAX(IFF(tag.value:"key"::STRING = 'name'    ,1,0)) = 1
     AND MAX(IFF(tag.value:"key"::STRING = 'wikidata',1,0)) = 0
)
SELECT c."id"                            AS "relation_id",
       COUNT(*)                          AS "features_inside"
FROM   cand c
JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" f
  ON   ST_INTERSECTS(TO_GEOGRAPHY(f."geometry"), c.rg)
GROUP  BY 1
ORDER  BY 2 DESC
LIMIT 20;


--Description: 9. List all relation ids whose member list includes at least one feature
--             that carries a wikidata tag.
WITH member_wd AS (
  SELECT DISTINCT r."id" AS relation_id
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
       LATERAL FLATTEN(input => r."members")                      m
  JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES"  p
       ON p."osm_id" = m.value::NUMBER
  ,    LATERAL FLATTEN(input => p."all_tags")                     tag
  WHERE tag.value:"key"::STRING = 'wikidata'
)
SELECT relation_id
FROM   member_wd
LIMIT 20;


--Description: 10. Final step ‑ name of the relation inside the Q1095 area that
--             (a) has a name tag, (b) lacks a wikidata tag, (c) owns at least one
--             wikidata‑tagged member, and (d) encloses the most planet features.
WITH q AS (  -- geometry for Q1095 multipolygon
  SELECT TO_GEOGRAPHY(p."geometry") AS g
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" p,
       LATERAL FLATTEN(input => p."all_tags") tag
  WHERE p."feature_type" = 'multipolygons'
    AND tag.value:"key"::STRING   = 'wikidata'
    AND tag.value:"value"::STRING = 'Q1095'
  LIMIT 1
), candidate_relations AS (      -- name tag present, no wikidata tag
  SELECT r."id",
         r."all_tags",
         TO_GEOGRAPHY(r."geometry") AS rg
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
       LATERAL FLATTEN(input => r."all_tags") tag,
       q
  WHERE ST_INTERSECTS(TO_GEOGRAPHY(r."geometry"), q.g)
  GROUP BY r."id", r."all_tags", r."geometry"
  HAVING MAX(IFF(tag.value:"key"::STRING = 'name'    ,1,0)) = 1
     AND MAX(IFF(tag.value:"key"::STRING = 'wikidata',1,0)) = 0
), with_member_wd AS (           -- ensure at least one wikidata‑tagged member
  SELECT DISTINCT cr."id",
         cr."all_tags",
         cr.rg
  FROM candidate_relations cr
  JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r2
    ON r2."id" = cr."id"
  ,    LATERAL FLATTEN(input => r2."members")                      m
  JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES"   p
       ON p."osm_id" = m.value::NUMBER
  ,    LATERAL FLATTEN(input => p."all_tags")                      tag
  WHERE tag.value:"key"::STRING = 'wikidata'
), counts AS (                   -- count features inside each relation
  SELECT wmw."id",
         (SELECT t.value:"value"::STRING
            FROM LATERAL FLATTEN(input => wmw."all_tags") t
            WHERE t.value:"key"::STRING = 'name'
            LIMIT 1) AS relation_name,
         COUNT(*) AS features_inside
  FROM with_member_wd wmw
  JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" f
    ON ST_INTERSECTS(TO_GEOGRAPHY(f."geometry"), wmw.rg)
  GROUP BY 1,2
)
SELECT relation_name
FROM   counts
ORDER  BY features_inside DESC
LIMIT 20;
```
