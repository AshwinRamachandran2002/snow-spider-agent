--Description: 6) Count members for relations that have a name tag but NO wikidata tag,
--avoiding “NOT EXISTS” by pre‑computing tag counts with conditional aggregation.
WITH tag_stats AS (
     SELECT r."id",
            COUNT_IF(t.value:"key" = 'name')     AS name_cnt,
            COUNT_IF(t.value:"key" = 'wikidata') AS wd_cnt
     FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_RELATIONS" r,
            LATERAL FLATTEN(input => r."all_tags") t
     GROUP  BY r."id"
)
SELECT r."id",
       COUNT(*) AS member_cnt
FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_RELATIONS" r
JOIN   tag_stats ts
       ON ts."id" = r."id"
      AND ts.name_cnt > 0
      AND ts.wd_cnt   = 0,
       LATERAL FLATTEN(input => r."members") m
GROUP  BY r."id"
ORDER  BY member_cnt DESC
LIMIT 20
