Query:
--Description: 7) List candidate relations (name present, no wikidata) that spatially
--intersect the Q1095 multipolygon, using HAVING with COUNT_IF instead of NOT EXISTS.
WITH q1095 AS (
     SELECT TO_GEOGRAPHY("geometry") AS g
     FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_FEATURES" f,
            LATERAL FLATTEN(input => f."all_tags") t
     WHERE  t.value:"key"  = 'wikidata'
       AND  t.value:"value" = 'Q1095'
     LIMIT 1
)
SELECT r."id",
       MAX( CASE WHEN t.value:"key" = 'name'
                 THEN t.value:"value"::STRING END ) AS rel_name
FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_RELATIONS" r,
       q1095,
       LATERAL FLATTEN(input => r."all_tags") t
WHERE  ST_INTERSECTS( TO_GEOGRAPHY(r."geometry"), q1095.g )
GROUP  BY r."id"
HAVING COUNT_IF(t.value:"key" = 'name')    > 0      -- must have a name tag
   AND COUNT_IF(t.value:"key" = 'wikidata') = 0      -- no wikidata tag
LIMIT 20
