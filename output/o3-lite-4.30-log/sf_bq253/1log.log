```sql
--Description: 5) Preview how relation members are stored (unchanged – still valid).
SELECT r."id",
       m.value::VARCHAR AS raw_member
FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_RELATIONS" r,
       LATERAL FLATTEN(input => r."members") m
LIMIT 20;
```

```sql
--Description: 6) Count members for relations that have a name tag but NO wikidata tag,
--avoiding “NOT EXISTS” by pre‑computing tag counts with conditional aggregation.
WITH tag_stats AS (
     SELECT r."id",
            COUNT_IF(t.value:"key" = 'name')     AS name_cnt,
            COUNT_IF(t.value:"key" = 'wikidata') AS wd_cnt
     FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_RELATIONS" r,
            LATERAL FLATTEN(input => r."all_tags") t
     GROUP  BY r."id"
)
SELECT r."id",
       COUNT(*) AS member_cnt
FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_RELATIONS" r
JOIN   tag_stats ts
       ON ts."id" = r."id"
      AND ts.name_cnt > 0
      AND ts.wd_cnt   = 0,
       LATERAL FLATTEN(input => r."members") m
GROUP  BY r."id"
ORDER  BY member_cnt DESC
LIMIT 20;
```

```sql
--Description: 7) List candidate relations (name present, no wikidata) that spatially
--intersect the Q1095 multipolygon, using HAVING with COUNT_IF instead of NOT EXISTS.
WITH q1095 AS (
     SELECT TO_GEOGRAPHY("geometry") AS g
     FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_FEATURES" f,
            LATERAL FLATTEN(input => f."all_tags") t
     WHERE  t.value:"key"  = 'wikidata'
       AND  t.value:"value" = 'Q1095'
     LIMIT 1
)
SELECT r."id",
       MAX( CASE WHEN t.value:"key" = 'name'
                 THEN t.value:"value"::STRING END ) AS rel_name
FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_RELATIONS" r,
       q1095,
       LATERAL FLATTEN(input => r."all_tags") t
WHERE  ST_INTERSECTS( TO_GEOGRAPHY(r."geometry"), q1095.g )
GROUP  BY r."id"
HAVING COUNT_IF(t.value:"key" = 'name')    > 0      -- must have a name tag
   AND COUNT_IF(t.value:"key" = 'wikidata') = 0      -- no wikidata tag
LIMIT 20;
```

```sql
--Description: 8) For each intersecting candidate relation, count how many member
--features carry a wikidata tag.  Candidate list is built with conditional aggregation.
WITH q1095 AS (
     SELECT TO_GEOGRAPHY("geometry") AS g
     FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_FEATURES" f,
            LATERAL FLATTEN(input => f."all_tags") t
     WHERE  t.value:"key"  = 'wikidata'
       AND  t.value:"value" = 'Q1095'
     LIMIT 1
),
candidate_rel AS (
     SELECT r."id"
     FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_RELATIONS" r,
            q1095,
            LATERAL FLATTEN(input => r."all_tags") t
     WHERE  ST_INTERSECTS( TO_GEOGRAPHY(r."geometry"), q1095.g )
     GROUP  BY r."id"
     HAVING COUNT_IF(t.value:"key" = 'name')    > 0
        AND COUNT_IF(t.value:"key" = 'wikidata') = 0
)
SELECT cr."id"                            AS rel_id,
       COUNT(*)                           AS member_with_wikidata
FROM   candidate_rel            cr
JOIN   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_RELATIONS" r
       ON r."id" = cr."id",
       LATERAL FLATTEN(input => r."members") m
JOIN   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_FEATURES" f
       ON f."osm_way_id"::VARCHAR = m.value::STRING,
       LATERAL FLATTEN(input => f."all_tags") t
WHERE  t.value:"key" = 'wikidata'
GROUP  BY cr."id"
LIMIT 20;
```

```sql
--Description: 9) Combine everything: all intersecting, name‑only relations,
--count total members and how many of them have wikidata; rank by member count.
WITH q1095 AS (
     SELECT TO_GEOGRAPHY("geometry") AS g
     FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_FEATURES" f,
            LATERAL FLATTEN(input => f."all_tags") t
     WHERE  t.value:"key"  = 'wikidata'
       AND  t.value:"value" = 'Q1095'
     LIMIT 1
),
candidate_rel AS (
     SELECT r."id",
            MAX( CASE WHEN t.value:"key" = 'name'
                      THEN t.value:"value"::STRING END ) AS rel_name
     FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_RELATIONS" r,
            q1095,
            LATERAL FLATTEN(input => r."all_tags") t
     WHERE  ST_INTERSECTS( TO_GEOGRAPHY(r."geometry"), q1095.g )
     GROUP  BY r."id"
     HAVING COUNT_IF(t.value:"key" = 'name')    > 0
        AND COUNT_IF(t.value:"key" = 'wikidata') = 0
)
SELECT c.rel_name,
       c."id"                      AS relation_id,
       COUNT(*)                    AS total_members,
       SUM( CASE WHEN wt.value:"key" = 'wikidata'
                 THEN 1 ELSE 0 END ) AS members_with_wikidata
FROM   candidate_rel c
JOIN   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_RELATIONS" r
       ON r."id" = c."id",
       LATERAL FLATTEN(input => r."members") m
LEFT  JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_FEATURES" f
       ON f."osm_way_id"::VARCHAR = m.value::STRING
LEFT  JOIN LATERAL FLATTEN(input => f."all_tags") wt
       ON TRUE
GROUP  BY c.rel_name, c."id"
ORDER  BY total_members DESC
LIMIT 20;
```

```sql
--Description: 10) Final query – return only the name of the single relation that
--has the most members inside the Q1095 area, while meeting tag conditions.
WITH q1095 AS (
     SELECT TO_GEOGRAPHY("geometry") AS g
     FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_FEATURES" f,
            LATERAL FLATTEN(input => f."all_tags") t
     WHERE  t.value:"key"  = 'wikidata'
       AND  t.value:"value" = 'Q1095'
     LIMIT 1
),
candidate_rel AS (
     SELECT r."id",
            MAX( CASE WHEN t.value:"key" = 'name'
                      THEN t.value:"value"::STRING END ) AS rel_name
     FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_RELATIONS" r,
            q1095,
            LATERAL FLATTEN(input => r."all_tags") t
     WHERE  ST_INTERSECTS( TO_GEOGRAPHY(r."geometry"), q1095.g )
     GROUP  BY r."id"
     HAVING COUNT_IF(t.value:"key" = 'name')    > 0
        AND COUNT_IF(t.value:"key" = 'wikidata') = 0
),
scored AS (
     SELECT c.rel_name,
            c."id",
            COUNT(*) AS total_members
     FROM   candidate_rel c
     JOIN   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_RELATIONS" r
            ON r."id" = c."id",
            LATERAL FLATTEN(input => r."members") m
     GROUP  BY c.rel_name, c."id"
)
SELECT rel_name  AS relation_name_with_most_features
FROM   scored
ORDER  BY total_members DESC
LIMIT 1;
