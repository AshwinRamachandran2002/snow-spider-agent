```sql
--Description (thinking process):
-- Snowflake disallows a correlated FLATTEN in a NOT‑EXISTS sub‑query, so instead
-- we: (1) explode every relation’s "all_tags" with LATERAL FLATTEN; (2) use
-- conditional aggregation (COUNT_IF) to count how many tags have key = 'name'
-- and how many have key = 'wikidata'; (3) retain only relations where the first
-- count is ≥1 and the second count is 0.  For context we also return one sample
-- name (MAX of the name values).  Limit to 20 rows.
SELECT
       r."id",
       MAX(CASE WHEN tag.value:"key" = 'name'
                THEN tag.value:"value"::STRING
           END)                                AS relation_name
FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_RELATIONS" r,
       LATERAL FLATTEN(input => r."all_tags") tag
GROUP  BY r."id"
HAVING COUNT_IF(tag.value:"key" = 'name')    > 0      -- at least one name tag
   AND COUNT_IF(tag.value:"key" = 'wikidata') = 0      -- no wikidata tag
LIMIT 20;
```
