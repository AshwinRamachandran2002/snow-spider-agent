```sql
--Description: 9) Combine everything – list every relation that intersects Q1095, has a name
--but no wikidata tag, show its total member count and how many of those members
--carry a wikidata tag.  Uses independent sub‑queries to avoid correlated FLATTEN.
WITH q1095 AS (                                   -- geometry of the multipolygon Q1095
     SELECT TO_GEOGRAPHY("geometry") AS g
     FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_FEATURES" pf,
            LATERAL FLATTEN(input => pf."all_tags") ft
     WHERE  ft.value:"key"  = 'wikidata'
       AND  ft.value:"value" = 'Q1095'
     LIMIT 1
),
candidate_rel AS (                                -- relations: name present, no wikidata, overlap Q1095
     SELECT r."id",
            MAX(CASE WHEN tag.value:"key" = 'name'
                     THEN tag.value:"value"::STRING END) AS rel_name
     FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_RELATIONS" r,
            q1095,
            LATERAL FLATTEN(input => r."all_tags") tag
     WHERE  ST_INTERSECTS( TO_GEOGRAPHY(r."geometry"), q1095.g )
     GROUP  BY r."id"
     HAVING COUNT_IF(tag.value:"key" = 'name')    > 0
        AND COUNT_IF(tag.value:"key" = 'wikidata') = 0
),
members AS (                                      -- explode the members of each candidate relation
     SELECT cr."id"                       AS rel_id,
            (m.value:"id")::NUMBER        AS member_id
     FROM   candidate_rel cr
     JOIN   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_RELATIONS" r
            ON r."id" = cr."id",
            LATERAL FLATTEN(input => r."members") m
),
totals    AS ( SELECT rel_id, COUNT(*) AS total_members
               FROM   members
               GROUP  BY rel_id ),
wd_count  AS ( SELECT me.rel_id,
                      COUNT(*) AS members_with_wikidata
               FROM   members me
               JOIN   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_FEATURES" pf
                      ON pf."osm_way_id" = me.member_id
                    OR pf."osm_id"     = me.member_id,
                      LATERAL FLATTEN(input => pf."all_tags") t
               WHERE  t.value:"key" = 'wikidata'
               GROUP  BY me.rel_id )
SELECT c.rel_name,
       c."id"                         AS relation_id,
       COALESCE(t.total_members,0)    AS total_members,
       COALESCE(w.members_with_wikidata,0) AS members_with_wikidata
FROM   candidate_rel c
LEFT  JOIN totals   t ON t.rel_id = c."id"
LEFT  JOIN wd_count w ON w.rel_id = c."id"
ORDER  BY total_members DESC
LIMIT 20;
