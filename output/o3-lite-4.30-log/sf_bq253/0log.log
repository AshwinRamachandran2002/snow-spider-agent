```sql
--Description:
-- End‑to‑end query that returns the single relation name which
--   • lies in the geographic extent of the multipolygon tagged “wikidata = Q1095”,
--   • has its own “name” tag but no “wikidata” tag,
--   • contains at least one member that *does* have a wikidata tag,
--   • and has the greatest number of members among such relations.
-- Performance notes:
--   • Spatially reduces PLANET_RELATIONS with the Q1095 bounding box before JSON work.
--   • Examines PLANET_FEATURES only for the small set of member IDs.

WITH q1095_bbox AS (  ---------------------------------------------------------- 1
    SELECT ST_ENVELOPE(TO_GEOGRAPHY(p."geometry")) AS geom
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" p,
           LATERAL FLATTEN(input => p."all_tags") t
    WHERE  t.value:"key"::STRING = 'wikidata'
      AND  t.value:"value"::STRING = 'Q1095'
    LIMIT 1
),
candidate_rel AS (  ----------------------------------------------------------- 2
    SELECT r."id", r."all_tags", r."members"
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
           q1095_bbox
    WHERE  ST_INTERSECTS(TO_GEOGRAPHY(r."geometry"), q1095_bbox.geom)
),
named_no_wd AS (  ------------------------------------------------------------- 3
    SELECT cr."id" AS relation_id
    FROM   candidate_rel cr,
           LATERAL FLATTEN(input => cr."all_tags") tag
    GROUP  BY cr."id"
    HAVING MAX(CASE WHEN tag.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END) = 1
       AND MAX(CASE WHEN tag.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0
),
members AS (  ------------------------------------------------------------------ 4
    SELECT n.relation_id,
           mem.value:"ref"::NUMBER AS member_ref
    FROM   named_no_wd            n
    JOIN   candidate_rel          cr ON cr."id" = n.relation_id,
           LATERAL FLATTEN(input => cr."members") mem
),
members_with_wd AS (  ---------------------------------------------------------- 5
    SELECT DISTINCT m.relation_id
    FROM   members m
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf
           ON pf."osm_way_id" = m.member_ref OR pf."osm_id" = m.member_ref,
           LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE  tag.value:"key"::STRING = 'wikidata'
),
ranked AS (  -------------------------------------------------------------------- 6
    SELECT n.relation_id,
           MAX(CASE WHEN tag.value:"key"::STRING = 'name'
                    THEN tag.value:"value"::STRING END)      AS relation_name,
           COUNT(*)                                         AS member_cnt,
           ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC)       AS rn
    FROM   named_no_wd n
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r
           ON r."id" = n.relation_id
    JOIN   LATERAL FLATTEN(input => r."all_tags") tag
    JOIN   members              m  ON m.relation_id = n.relation_id
    JOIN   members_with_wd      w  ON w.relation_id = n.relation_id   -- ensures ≥1 wd member
    GROUP  BY n.relation_id
)
SELECT relation_name
FROM   ranked
WHERE  rn = 1;
