           COUNT(*)                                    AS total_members,
           ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC)  AS rn
    FROM   rel_core rc
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr
           ON pr."id" = rc.relation_id
    JOIN   LATERAL FLATTEN(input => pr."all_tags") tag
    JOIN   members m          ON m.relation_id = rc.relation_id
    JOIN   wd_member_refs w   ON w.member_ref   = m.member_ref   -- guarantees ≥1 wd member
    GROUP  BY rc.relation_id
)
SELECT relation_id,
       relation_name,
       total_members
FROM   ranked
WHERE  rn = 1
