```sql
--Description:
-- One‑shot query that answers the whole task.
-- Steps embedded as CTEs:
--   1) q1095_geom        – geometry of the multipolygon whose tag wikidata=Q1095.
--   2) candidate_rel     – relations whose geometry intersects that area.
--   3) named_no_wd       – keep only those relations that have a “name” tag and
--                          do NOT have their own “wikidata” tag.
--   4) rel_members       – explode each surviving relation’s “members” array.
--   5) members_with_wd   – from those members, find which ones carry a wikidata
--                          tag (via PLANET_FEATURES).
--   6) final_rank        – count total members per relation, retain only
--                          relations that have ≥1 wikidata‑tagged member,
--                          and rank by the number of members.
--   The outer SELECT returns the single relation name that satisfies all
--   conditions and contains the most features.

WITH q1095_geom AS (            -- 1
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES"  pf,
           LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE  LOWER(tag.value:"key"::STRING) = 'wikidata'
      AND  tag.value:"value"::STRING     = 'Q1095'
    LIMIT 1
),
candidate_rel AS (              -- 2
    SELECT pr."id",
           pr."all_tags",
           pr."members"
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr,
           q1095_geom
    WHERE  ST_INTERSECTS(TO_GEOGRAPHY(pr."geometry"), q1095_geom.geom)
),
named_no_wd AS (                -- 3
    SELECT cr."id"                               AS relation_id,
           MAX(CASE WHEN t.value:"key"::STRING = 'name'
                    THEN t.value:"value"::STRING END) AS relation_name,
           MAX(CASE WHEN t.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) AS has_wikidata
    FROM   candidate_rel cr,
           LATERAL FLATTEN(input => cr."all_tags") t
    GROUP  BY cr."id"
    HAVING has_wikidata = 0                       -- no wikidata tag
),
rel_members AS (               -- 4
    SELECT n.relation_id,
           mem.value:"ref"::NUMBER AS member_ref
    FROM   named_no_wd        n
    JOIN   candidate_rel      cr  ON cr."id" = n.relation_id,
           LATERAL FLATTEN(input => cr."members") mem
),
members_with_wd AS (           -- 5
    SELECT DISTINCT rm.relation_id
    FROM   rel_members rm
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf
           ON pf."osm_way_id" = rm.member_ref
           OR pf."osm_id"     = rm.member_ref,
           LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE  LOWER(tag.value:"key"::STRING) = 'wikidata'
),
final_rank AS (                -- 6
    SELECT n.relation_id,
           n.relation_name,
           COUNT(*) AS total_members
    FROM   named_no_wd       n
    JOIN   rel_members       rm ON rm.relation_id = n.relation_id
    JOIN   members_with_wd   mw ON mw.relation_id = n.relation_id  -- ensures ≥1 wikidata member
    GROUP  BY n.relation_id, n.relation_name
    ORDER  BY total_members DESC
    LIMIT 1
)
SELECT relation_name
FROM   final_rank;
```
