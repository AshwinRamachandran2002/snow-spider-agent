```sql
--Description: (7) For those relations gather counts of total members vs members that
--             themselves carry a wikidata tag.  Uses CASE logic (no BOOLOR).

WITH members AS (
    /* reuse query 6 CTEs to fetch the list of member references */
    WITH q1095_bbox AS (
        SELECT ST_ENVELOPE(TO_GEOGRAPHY(p."geometry")) AS geom
        FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" p,
               LATERAL FLATTEN(input => p."all_tags") t
        WHERE  t.value:"key"::STRING = 'wikidata'
          AND  t.value:"value"::STRING = 'Q1095'
        LIMIT 1
    ),
    rel_ids AS (
        SELECT r."id"
        FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
               q1095_bbox,
               LATERAL FLATTEN(input => r."all_tags") tag
        WHERE  ST_INTERSECTS(TO_GEOGRAPHY(r."geometry"), q1095_bbox.geom)
        GROUP BY r."id"
        HAVING MAX(CASE WHEN tag.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END) = 1
           AND MAX(CASE WHEN tag.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0
    )
    SELECT pr."id"                  AS relation_id,
           mem.value:"ref"::NUMBER  AS member_ref
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr
    JOIN   rel_ids ri ON ri."id" = pr."id",
           LATERAL FLATTEN(input => pr."members") mem
)
SELECT m.relation_id,
       COUNT(*)                                                   AS member_cnt,
       COUNT(CASE WHEN t.value:"key"::STRING = 'wikidata' THEN 1 END) AS members_with_wikidata
FROM   members m
LEFT  JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf
       ON pf."osm_way_id" = m.member_ref
       OR pf."osm_id"     = m.member_ref,
       LATERAL FLATTEN(input => pf."all_tags") t
GROUP BY m.relation_id
LIMIT 20;
