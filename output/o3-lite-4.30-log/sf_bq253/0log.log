```sql
--Description: (8) Show every qualifying relation’s name plus the total number of
--             objects it contains, regardless of whether members have wikidata.

WITH rel_and_members AS (
    /* Build relation/member pairs reusing the same filtered relation set */
    WITH q1095_bbox AS (
        SELECT ST_ENVELOPE(TO_GEOGRAPHY(p."geometry")) AS geom
        FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" p,
               LATERAL FLATTEN(input => p."all_tags") t
        WHERE  t.value:"key"::STRING = 'wikidata'
          AND  t.value:"value"::STRING = 'Q1095'
        LIMIT 1
    ),
    rel_ids AS (
        SELECT r."id"
        FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
               q1095_bbox,
               LATERAL FLATTEN(input => r."all_tags") tag
        WHERE  ST_INTERSECTS(TO_GEOGRAPHY(r."geometry"), q1095_bbox.geom)
        GROUP BY r."id"
        HAVING MAX(CASE WHEN tag.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END) = 1
           AND MAX(CASE WHEN tag.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0
    )
    SELECT pr."id" AS relation_id,
           mem.value:"ref"::NUMBER AS member_ref
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr
    JOIN   rel_ids ri ON ri."id" = pr."id",
           LATERAL FLATTEN(input => pr."members") mem
)
SELECT r."id"                                                    AS relation_id,
       MAX(CASE WHEN tag.value:"key"::STRING = 'name'
                THEN tag.value:"value"::STRING END)              AS relation_name,
       COUNT(*)                                                  AS total_members
FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r
JOIN   rel_and_members rm ON rm.relation_id = r."id",
       LATERAL FLATTEN(input => r."all_tags") tag
GROUP  BY r."id"
ORDER  BY total_members DESC
LIMIT 20;
```

```sql
--Description: (9) Full pipeline – pick the single relation (within the Q1095 area)
--             that has a name, lacks wikidata, and contains the greatest number
--             of members *while* having at least one member that carries
--             its own wikidata tag.  Uses CASE aggregation instead of BOOLOR.

WITH q1095_geom AS (
    SELECT ST_ENVELOPE(TO_GEOGRAPHY(pf."geometry")) AS geom
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
           LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE  tag.value:"key"::STRING = 'wikidata'
      AND  tag.value:"value"::STRING = 'Q1095'
    LIMIT 1
),
candidate_relations AS (
    SELECT pr."id",
           pr."all_tags",
           pr."members"
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr,
           q1095_geom
    WHERE  ST_INTERSECTS(TO_GEOGRAPHY(pr."geometry"), q1095_geom.geom)
),
named_no_wd AS (
    SELECT cr."id" AS relation_id
    FROM   candidate_relations cr,
           LATERAL FLATTEN(input => cr."all_tags") tag
    GROUP  BY cr."id"
    HAVING MAX(CASE WHEN tag.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END) = 1
       AND MAX(CASE WHEN tag.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0
),
members AS (
    SELECT n.relation_id,
           mem.value:"ref"::NUMBER AS member_ref
    FROM   named_no_wd n
    JOIN   candidate_relations cr ON cr."id" = n.relation_id,
           LATERAL FLATTEN(input => cr."members") mem
),
members_with_wd AS (
    SELECT DISTINCT m.relation_id
    FROM   members m
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf
           ON pf."osm_way_id" = m.member_ref OR pf."osm_id" = m.member_ref,
           LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE  tag.value:"key"::STRING = 'wikidata'
)
SELECT n.relation_id,
       MAX(CASE WHEN tag.value:"key"::STRING = 'name'
                THEN tag.value:"value"::STRING END)  AS relation_name,
       COUNT(*)                                      AS total_members
FROM   named_no_wd n
JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r
       ON r."id" = n.relation_id
JOIN   LATERAL FLATTEN(input => r."all_tags") tag
JOIN   members m           ON m.relation_id = n.relation_id
JOIN   members_with_wd mw  ON mw.relation_id = n.relation_id  -- ensures ≥1 wikidata member
GROUP  BY n.relation_id
ORDER  BY total_members DESC
LIMIT 20;
```

