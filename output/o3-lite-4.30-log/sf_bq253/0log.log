```sql
--Description:
--  Compute, for every relation that overlaps the bounding‑box of the multipolygon
--  tagged “wikidata = Q1095” and that has a “name” tag but NO “wikidata” tag,
--  (a) how many members it has in total and (b) how many of those members do
--  carry their own wikidata tag.  The design avoids time‑outs by:
--    1.  Spatially trimming PLANET_RELATIONS with the Q1095 bbox before any JSON work.
--    2.  Limiting JSON flattening to that shrunken set.
--    3.  Interrogating PLANET_FEATURES only for the small list of member IDs
--        (wd_member_refs), not the entire table.

WITH q1095_bbox AS (  -- 1. bounding box of the multipolygon that has wikidata=Q1095
    SELECT ST_ENVELOPE(TO_GEOGRAPHY(p."geometry")) AS geom
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" p,
           LATERAL FLATTEN(input => p."all_tags") tag
    WHERE  tag.value:"key"::STRING = 'wikidata'
      AND  tag.value:"value"::STRING = 'Q1095'
    LIMIT 1
),
rel_filtered AS (     -- 2. relations in that bbox WITH name tag, WITHOUT wikidata tag
    SELECT r."id" AS relation_id
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
           q1095_bbox,
           LATERAL FLATTEN(input => r."all_tags") tag
    WHERE  ST_INTERSECTS(TO_GEOGRAPHY(r."geometry"), q1095_bbox.geom)
    GROUP BY r."id"
    HAVING MAX(CASE WHEN tag.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END) = 1
       AND MAX(CASE WHEN tag.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0
),
members AS (          -- 3. explode the member references of those relations
    SELECT rf.relation_id,
           mem.value:"ref"::NUMBER AS member_ref
    FROM   rel_filtered rf
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr
           ON pr."id" = rf.relation_id,
           LATERAL FLATTEN(input => pr."members") mem
),
wd_member_refs AS (   -- 4. subset of member_refs whose feature has a wikidata tag
    SELECT DISTINCT COALESCE(pf."osm_way_id", pf."osm_id") AS member_ref
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf
    JOIN   members m
           ON pf."osm_way_id" = m.member_ref OR pf."osm_id" = m.member_ref,
           LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE  tag.value:"key"::STRING = 'wikidata'
)
-- 5. final aggregation
SELECT m.relation_id,
       COUNT(*)                                               AS total_members,
       COUNT(CASE WHEN w.member_ref IS NOT NULL THEN 1 END)   AS members_with_wikidata
FROM   members m
LEFT  JOIN wd_member_refs w
       ON w.member_ref = m.member_ref
GROUP  BY m.relation_id
ORDER  BY total_members DESC
LIMIT 20;
