Query:
--Description: (8) Return each qualifying relation’s name and total member count.
--             Qualifying = intersects Q1095 bbox, has “name” tag, lacks “wikidata”.
--             Strategy identical to earlier fixes: spatial filter first (q1095_bbox),
--             tag filter next (rel_core), expand members, aggregate.  No heavy
--             JSON work beyond the relation tags already flattened.

WITH q1095_bbox AS (
    SELECT ST_ENVELOPE(TO_GEOGRAPHY(p."geometry")) AS geom
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" p,
           LATERAL FLATTEN(input => p."all_tags") t
    WHERE  t.value:"key"::STRING = 'wikidata' AND t.value:"value"::STRING = 'Q1095'
    LIMIT 1
),
rel_core AS (      -- relations in bbox, name tag present, wikidata tag absent
    SELECT r."id" AS relation_id
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
           q1095_bbox,
           LATERAL FLATTEN(input => r."all_tags") tag
    WHERE  ST_INTERSECTS(TO_GEOGRAPHY(r."geometry"), q1095_bbox.geom)
    GROUP BY r."id"
    HAVING MAX(CASE WHEN tag.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END)=1
       AND MAX(CASE WHEN tag.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END)=0
),
rel_members AS (
    SELECT rc.relation_id,
           mem.value:"ref"::NUMBER AS member_ref
    FROM   rel_core rc
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr
           ON pr."id" = rc.relation_id,
           LATERAL FLATTEN(input => pr."members") mem
)
SELECT rc.relation_id,
       MAX(CASE WHEN tag.value:"key"::STRING='name' THEN tag.value:"value"::STRING END)
           AS relation_name,
       COUNT(*) AS total_members
FROM   rel_core rc
JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr
       ON pr."id" = rc.relation_id
JOIN   LATERAL FLATTEN(input => pr."all_tags") tag
JOIN   rel_members rm ON rm.relation_id = rc.relation_id
GROUP  BY rc.relation_id
ORDER  BY total_members DESC
LIMIT 20
