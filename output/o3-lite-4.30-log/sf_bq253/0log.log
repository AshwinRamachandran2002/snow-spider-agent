WITH q1095_geom AS (   -- envelope of the multipolygon tagged wikidata=Q1095
    SELECT ST_ENVELOPE(TO_GEOGRAPHY(pf."geometry")) AS "geom"
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
           LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE  tag.value:"key"::STRING  = 'wikidata'
      AND  tag.value:"value"::STRING = 'Q1095'
    LIMIT 1
),                                                         -- 1 row
candidate_relations AS (   -- relations that intersect that area
    SELECT pr."id",
           pr."all_tags",
           pr."geometry"
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr
    JOIN   q1095_geom q
           ON ST_INTERSECTS(TO_GEOGRAPHY(pr."geometry"), q."geom")
),
named_no_wd AS (         -- keep those having a name and NO wikidata tag
    SELECT cr."id"
    FROM   candidate_relations cr,
           LATERAL FLATTEN(input => cr."all_tags") tag
    GROUP  BY cr."id"
    HAVING MAX(IFF(tag.value:"key"::STRING = 'name'    ,1,0)) = 1   -- has name
       AND MAX(IFF(tag.value:"key"::STRING = 'wikidata',1,0)) = 0   -- no wikidata
),
relation_members AS (    -- explode members of the remaining relations
    SELECT nr."id" AS "relation_id",
           mem.value:"ref"::NUMBER AS "member_ref"
    FROM   named_no_wd nr
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr
           ON pr."id" = nr."id",
           LATERAL FLATTEN(input => pr."members") mem
),
member_with_wd AS (      -- relations that have at least one member with wikidata
    SELECT DISTINCT rm."relation_id"
    FROM   relation_members rm
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf
           ON pf."osm_way_id" = rm."member_ref"
           OR pf."osm_id"     = rm."member_ref",
           LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE  tag.value:"key"::STRING = 'wikidata'
),
ranked_relations AS (    -- count members and rank
    SELECT nr."id"                                               AS "relation_id",
           MAX(IFF(tag.value:"key"::STRING = 'name',
                   tag.value:"value"::STRING, NULL))             AS "name",
           COUNT(rm."member_ref")                                AS "member_cnt"
    FROM   named_no_wd nr
    JOIN   member_with_wd mw  ON mw."relation_id" = nr."id"
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr
           ON pr."id" = nr."id"
    JOIN   LATERAL FLATTEN(input => pr."all_tags") tag
    JOIN   relation_members rm ON rm."relation_id" = nr."id"
    GROUP  BY nr."id"
),
best AS (                 -- pick the one with the most members
    SELECT "name"
    FROM   ranked_relations
    ORDER  BY "member_cnt" DESC NULLS LAST, "relation_id" ASC
    LIMIT 1
)
SELECT "name"
FROM   best;
