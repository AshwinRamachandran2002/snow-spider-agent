```sql
--Description:
-- Find relations in the same area as the multipolygon carrying wikidata = Q1095,
-- then retain only those that:
--   • have at least one “name” tag,
--   • have no “wikidata” tag.
-- To keep the query fast we:
--   1. Grab the geometry of the Q1095 multipolygon and turn it into a bounding box (q1095_bbox).
--   2. Restrict PLANET_RELATIONS to those whose geometry intersects that bbox (candidate_relations),
--      which greatly reduces the amount of JSON we must FLATTEN.
--   3. FLATTEN the filtered tag arrays and aggregate to apply the tag conditions.
-- The result lists each qualifying relation (id + name), limited to 20 rows for inspection.

WITH q1095_bbox AS (                         -- 1. bbox of Q1095 multipolygon
    SELECT ST_ENVELOPE(TO_GEOGRAPHY(p."geometry")) AS geom
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES"  p,
           LATERAL FLATTEN(input => p."all_tags") t
    WHERE  t.value:"key"::STRING ILIKE 'wikidata'
      AND  t.value:"value"::STRING = 'Q1095'
    LIMIT 1
),
candidate_relations AS (                     -- 2. relations intersecting that bbox
    SELECT r."id",
           r."all_tags"
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
           q1095_bbox
    WHERE  ST_INTERSECTS(TO_GEOGRAPHY(r."geometry"), q1095_bbox.geom)
)
SELECT cr."id"                                                     AS relation_id,
       MAX(CASE WHEN tag.value:"key"::STRING = 'name'
                THEN tag.value:"value"::STRING END)                AS relation_name
FROM   candidate_relations cr,
       LATERAL FLATTEN(input => cr."all_tags") tag                 -- 3. evaluate tags
GROUP  BY cr."id"
HAVING MAX(CASE WHEN tag.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END) = 1  -- has name
   AND MAX(CASE WHEN tag.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0  -- lacks wikidata
LIMIT 20;
```
