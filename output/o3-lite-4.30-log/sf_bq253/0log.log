WITH q1095_geom AS (   -- bounding box of the multipolygon that has wikidata = Q1095
    SELECT ST_ENVELOPE(TO_GEOGRAPHY(pf."geometry")) AS "geom"
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES"  pf,
           LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE  tag.value:"key"::STRING  = 'wikidata'
      AND  tag.value:"value"::STRING = 'Q1095'
    LIMIT 1
),
/* --- features inside the same area that carry a wikidata tag ---------------- */
features_wd AS (
    SELECT DISTINCT COALESCE(pf."osm_way_id", pf."osm_id") AS "osm_ref"
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES"  pf,
           LATERAL FLATTEN(input => pf."all_tags") tag,
           q1095_geom q
    WHERE  tag.value:"key"::STRING = 'wikidata'
      AND  pf."geometry" IS NOT NULL
      AND  ST_INTERSECTS(TO_GEOGRAPHY(pf."geometry"), q."geom")
),
/* --- relations that intersect the area ------------------------------------- */
candidate_relations AS (
    SELECT pr."id",
           pr."all_tags",
           pr."geometry"
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr,
           q1095_geom q
    WHERE  ST_INTERSECTS(TO_GEOGRAPHY(pr."geometry"), q."geom")
),
/* --- keep only relations that HAVE a name tag but NO wikidata tag -----------*/
named_no_wd AS (
    SELECT cr."id"
    FROM   candidate_relations cr,
           LATERAL FLATTEN(input => cr."all_tags") tag
    GROUP  BY cr."id"
    HAVING MAX(IFF(tag.value:"key"::STRING = 'name'    ,1,0)) = 1   -- has name
       AND MAX(IFF(tag.value:"key"::STRING = 'wikidata',1,0)) = 0   -- no wikidata
),
/* --- explode members of those relations ------------------------------------ */
relation_members AS (
    SELECT nr."id" AS "relation_id",
           mem.value:"ref"::NUMBER AS "member_ref"
    FROM   named_no_wd nr
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr
           ON pr."id" = nr."id",
           LATERAL FLATTEN(input => pr."members") mem
),
/* --- keep relations that have ≥1 member with a wikidata tag -----------------*/
rel_with_wd_member AS (
    SELECT DISTINCT rm."relation_id"
    FROM   relation_members rm
    JOIN   features_wd f
           ON f."osm_ref" = rm."member_ref"
),
/* --- count members for each surviving relation ----------------------------- */
relation_counts AS (
    SELECT rm."relation_id",
           COUNT(*) AS "member_cnt"
    FROM   relation_members rm
    GROUP  BY rm."relation_id"
),
/* --- assemble name + member count and rank --------------------------------- */
ranked AS (
    SELECT rc."relation_id",
           MAX(CASE WHEN tag.value:"key"::STRING = 'name'
                    THEN tag.value:"value"::STRING END)  AS "name",
           rc."member_cnt",
           ROW_NUMBER() OVER (ORDER BY rc."member_cnt" DESC, rc."relation_id") AS "rn"
    FROM   relation_counts rc
    JOIN   rel_with_wd_member mw
           ON mw."relation_id" = rc."relation_id"
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr
           ON pr."id" = rc."relation_id",
           LATERAL FLATTEN(input => pr."all_tags") tag
    GROUP  BY rc."relation_id", rc."member_cnt"
)
SELECT "name"
FROM   ranked
WHERE  "rn" = 1;
