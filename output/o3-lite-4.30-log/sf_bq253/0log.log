```sql
--Description: (9) Pick the single relation (within Q1095 area, name tag present, no
--             wikidata tag) that has the greatest number of members AND at least
--             one member with its own wikidata tag.  Uses fast substring search
--             (ILIKE '%"wikidata"%') on PLANET_FEATURES to mark such members.

WITH q1095_bbox AS (
    SELECT ST_ENVELOPE(TO_GEOGRAPHY(p."geometry")) AS geom
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" p,
           LATERAL FLATTEN(input => p."all_tags") t
    WHERE  t.value:"key"::STRING='wikidata' AND t.value:"value"::STRING='Q1095'
    LIMIT 1
),
rel_core AS (
    SELECT r."id" AS relation_id
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
           q1095_bbox,
           LATERAL FLATTEN(input => r."all_tags") tag
    WHERE  ST_INTERSECTS(TO_GEOGRAPHY(r."geometry"), q1095_bbox.geom)
    GROUP BY r."id"
    HAVING MAX(CASE WHEN tag.value:"key"::STRING='name' THEN 1 ELSE 0 END)=1
       AND MAX(CASE WHEN tag.value:"key"::STRING='wikidata' THEN 1 ELSE 0 END)=0
),
members AS (
    SELECT rc.relation_id,
           mem.value:"ref"::NUMBER AS member_ref
    FROM   rel_core rc
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr
         ON pr."id" = rc.relation_id,
           LATERAL FLATTEN(input => pr."members") mem
),
wd_member_refs AS (   -- mark which member_refs carry a wikidata tag
    SELECT DISTINCT m.member_ref
    FROM   members m
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf
      ON pf."osm_way_id" = m.member_ref OR pf."osm_id" = m.member_ref
    WHERE  pf."all_tags"::STRING ILIKE '%"wikidata"%'
),
ranked AS (
    SELECT rc.relation_id,
           MAX(CASE WHEN tag.value:"key"::STRING='name'
                    THEN tag.value:"value"::STRING END) AS relation_name,
           COUNT(*)                                    AS total_members,
           ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC)  AS rn
    FROM   rel_core rc
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr
           ON pr."id" = rc.relation_id
    JOIN   LATERAL FLATTEN(input => pr."all_tags") tag
    JOIN   members m          ON m.relation_id = rc.relation_id
    JOIN   wd_member_refs w   ON w.member_ref   = m.member_ref   -- guarantees ≥1 wd member
    GROUP  BY rc.relation_id
)
SELECT relation_id,
       relation_name,
       total_members
FROM   ranked
WHERE  rn = 1;
