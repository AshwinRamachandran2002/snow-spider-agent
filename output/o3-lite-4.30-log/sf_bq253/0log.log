```sql
/* ---------------------------------------------------------------------------
   Return the name of the relation located in the “Liège‑Maastricht” area
   (bbox of the multipolygon that carries wikidata = Q1095) that …
        • has a “name” tag,
        • has NO “wikidata” tag itself,
        • contains at least one member feature that DOES have a “wikidata” tag,
        • and contains the greatest number of members.
   Only the name is returned.
--------------------------------------------------------------------------- */
WITH bbox AS (  -- constant bounding box of the Q1095 multipolygon
    SELECT TO_GEOGRAPHY(
             'POLYGON((4.9800804 50.6954339,
                       5.9111095 50.6954339,
                       5.9111095 51.3001647,
                       4.9800804 51.3001647,
                       4.9800804 50.6954339))') AS geom
),
/* 1. relations intersecting the bbox --------------------------------------- */
candidate_relations AS (
    SELECT pr."id",
           pr."all_tags"
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr,
           bbox b
    WHERE  pr."geometry" IS NOT NULL
      AND  ST_INTERSECTS(TO_GEOGRAPHY(pr."geometry"), b.geom)
),
/* 2. keep relations WITH a name tag but WITHOUT a wikidata tag ------------- */
named_no_wd AS (
    SELECT cr."id"
    FROM   candidate_relations cr,
           LATERAL FLATTEN(input => cr."all_tags") t
    GROUP  BY cr."id"
    HAVING MAX(CASE WHEN t.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END) = 1
       AND MAX(CASE WHEN t.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0
),
/* 3. explode their members -------------------------------------------------- */
relation_members AS (
    SELECT pr."id"                              AS relation_id,
           mem.value:"ref"::NUMBER              AS member_ref
    FROM   named_no_wd nd
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr
           ON pr."id" = nd."id",
           LATERAL FLATTEN(input => pr."members") mem
),
/* 4. identify which of those relations have ≥1 member with a wikidata tag -- */
rel_with_wd_member AS (
    SELECT DISTINCT rm.relation_id
    FROM   relation_members rm
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf
           ON pf."osm_way_id" = rm.member_ref
           OR pf."osm_id"     = rm.member_ref,
           LATERAL FLATTEN(input => pf."all_tags") t
    WHERE  t.value:"key"::STRING = 'wikidata'
),
/* 5. count total members per relation -------------------------------------- */
relation_counts AS (
    SELECT rm.relation_id,
           COUNT(*) AS member_cnt
    FROM   relation_members rm
    GROUP  BY rm.relation_id
),
/* 6. pull the name string and rank by member count ------------------------- */
ranked AS (
    SELECT rc.relation_id,
           MAX(CASE WHEN t.value:"key"::STRING = 'name'
                    THEN t.value:"value"::STRING END)         AS name,
           rc.member_cnt,
           ROW_NUMBER() OVER (ORDER BY rc.member_cnt DESC,
                                      rc.relation_id)         AS rn
    FROM   relation_counts rc
    JOIN   rel_with_wd_member wdm   ON wdm.relation_id = rc.relation_id
    JOIN   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" pr
           ON pr."id" = rc.relation_id,
           LATERAL FLATTEN(input => pr."all_tags") t
    GROUP  BY rc.relation_id, rc.member_cnt
)
SELECT name
FROM   ranked
WHERE  rn = 1;
```
