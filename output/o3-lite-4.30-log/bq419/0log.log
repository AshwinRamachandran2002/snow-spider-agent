UNION ALL
SELECT 1984 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1984`
UNION ALL
SELECT 1985 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1985`
UNION ALL
SELECT 1986 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1986`
UNION ALL
SELECT 1987 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1987`
UNION ALL
SELECT 1988 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1988`
UNION ALL
SELECT 1989 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1989`
UNION ALL
SELECT 1990 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1990`
UNION ALL
SELECT 1991 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1991`
UNION ALL
SELECT 1992 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1992`
UNION ALL
SELECT 1993 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1993`
UNION ALL
SELECT 1994 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1994`
UNION ALL
SELECT 1995 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1995`
LIMIT 20;
```

```sql
-- 6. Year‑by‑year event counts for every state 1980‑1995
WITH unioned AS (
  -- (same UNION ALL block as in query 5)
  SELECT 1980 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
  UNION ALL SELECT 1981, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1981`
  UNION ALL SELECT 1982, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1982`
  UNION ALL SELECT 1983, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1983`
  UNION ALL SELECT 1984, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1984`
  UNION ALL SELECT 1985, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1985`
  UNION ALL SELECT 1986, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1986`
  UNION ALL SELECT 1987, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1987`
  UNION ALL SELECT 1988, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1988`
  UNION ALL SELECT 1989, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1989`
  UNION ALL SELECT 1990, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1990`
  UNION ALL SELECT 1991, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1991`
  UNION ALL SELECT 1992, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1992`
  UNION ALL SELECT 1993, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1993`
  UNION ALL SELECT 1994, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1994`
  UNION ALL SELECT 1995, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1995`
)
SELECT yr,
       UPPER(state) AS state_abbr,
       COUNT(*)     AS events_in_year
FROM unioned
GROUP BY yr, state_abbr
ORDER BY yr, events_in_year DESC
LIMIT 20;
```

```sql
-- 7. Add a rank so we can keep only the top 1 000 states per year
WITH yearly AS (
  -- same aggregation step as query 6
  SELECT yr,
         UPPER(state) AS state_abbr,
         COUNT(*) AS events_in_year
  FROM (
    SELECT 1980 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
    UNION ALL SELECT 1981, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1981`
    UNION ALL SELECT 1982, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1982`
    UNION ALL SELECT 1983, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1983`
    UNION ALL SELECT 1984, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1984`
    UNION ALL SELECT 1985, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1985`
    UNION ALL SELECT 1986, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1986`
    UNION ALL SELECT 1987, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1987`
    UNION ALL SELECT 1988, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1988`
    UNION ALL SELECT 1989, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1989`
    UNION ALL SELECT 1990, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1990`
    UNION ALL SELECT 1991, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1991`
    UNION ALL SELECT 1992, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1992`
    UNION ALL SELECT 1993, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1993`
    UNION ALL SELECT 1994, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1994`
    UNION ALL SELECT 1995, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1995`
  )
  GROUP BY yr, state_abbr
), ranked AS (
  SELECT *,
         RANK() OVER(PARTITION BY yr ORDER BY events_in_year DESC) AS rnk
  FROM yearly
)
SELECT yr, state_abbr, events_in_year, rnk
FROM ranked
WHERE rnk <= 1000
ORDER BY yr, rnk
LIMIT 20;
```

```sql
-- 8. Aggregate across all years but only for the states that were in the top 1 000 for that year
WITH yearly AS (
  -- aggregation block identical to query 7
  SELECT yr,
         UPPER(state) AS state_abbr,
         COUNT(*) AS events_in_year
  FROM (
    SELECT 1980 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
    UNION ALL SELECT 1981, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1981`
    UNION ALL SELECT 1982, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1982`
    UNION ALL SELECT 1983, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1983`
    UNION ALL SELECT 1984, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1984`
    UNION ALL SELECT 1985, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1985`
    UNION ALL SELECT 1986, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1986`
    UNION ALL SELECT 1987, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1987`
    UNION ALL SELECT 1988, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1988`
    UNION ALL SELECT 1989, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1989`
    UNION ALL SELECT 1990, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1990`
    UNION ALL SELECT 1991, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1991`
    UNION ALL SELECT 1992, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1992`
    UNION ALL SELECT 1993, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1993`
    UNION ALL SELECT 1994, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1994`
    UNION ALL SELECT 1995, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1995`
  )
  GROUP BY yr, state_abbr
), ranked AS (
  SELECT *,
         RANK() OVER(PARTITION BY yr ORDER BY events_in_year DESC) AS rnk
  FROM yearly
), top1k AS (
  SELECT *
  FROM ranked
  WHERE rnk <= 1000
)
SELECT state_abbr,
       SUM(events_in_year) AS total_events_1980_1995
FROM top1k
GROUP BY state_abbr
ORDER BY total_events_1980_1995 DESC
LIMIT 20;
```

```sql
-- 9. Same as query 8 but show the yearly breakdown for the five leaders
WITH yearly AS (
  /* identical aggregation block */
  SELECT yr,
         UPPER(state) AS state_abbr,
         COUNT(*) AS events_in_year
  FROM (
    SELECT 1980 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
    UNION ALL SELECT 1981, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1981`
    UNION ALL SELECT 1982, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1982`
    UNION ALL SELECT 1983, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1983`
    UNION ALL SELECT 1984, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1984`
    UNION ALL SELECT 1985, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1985`
    UNION ALL SELECT 1986, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1986`
    UNION ALL SELECT 1987, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1987`
    UNION ALL SELECT 1988, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1988`
    UNION ALL SELECT 1989, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1989`
    UNION ALL SELECT 1990, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1990`
    UNION ALL SELECT 1991, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1991`
    UNION ALL SELECT 1992, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1992`
    UNION ALL SELECT 1993, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1993`
    UNION ALL SELECT 1994, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1994`
    UNION ALL SELECT 1995, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1995`
  )
  GROUP BY yr, state_abbr
), ranked AS (
  SELECT *,
         RANK() OVER(PARTITION BY yr ORDER BY events_in_year DESC) AS rnk
  FROM yearly
), top1k AS (
  SELECT *
  FROM ranked
  WHERE rnk <= 1000
), totals AS (
  SELECT state_abbr,
         SUM(events_in_year) AS total_events
  FROM top1k
  GROUP BY state_abbr
  ORDER BY total_events DESC
  LIMIT 5
)
SELECT t.state_abbr,
       y.yr,
       y.events_in_year
FROM totals  AS t
JOIN top1k  AS y
ON  t.state_abbr = y.state_abbr
ORDER BY t.state_abbr, y.yr
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: five states with most storm events (1980‑1995),
--     using only the top‑1 000 states of each year
WITH yearly AS (
  SELECT yr,
         UPPER(state) AS state_abbr,
         COUNT(*) AS events_in_year
  FROM (
    SELECT 1980 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
    UNION ALL SELECT 1981, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1981`
    UNION ALL SELECT 1982, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1982`
    UNION ALL SELECT 1983, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1983`
    UNION ALL SELECT 1984, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1984`
    UNION ALL SELECT 1985, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1985`
    UNION ALL SELECT 1986, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1986`
    UNION ALL SELECT 1987, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1987`
    UNION ALL SELECT 1988, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1988`
    UNION ALL SELECT 1989, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1989`
    UNION ALL SELECT 1990, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1990`
    UNION ALL SELECT 1991, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1991`
    UNION ALL SELECT 1992, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1992`
    UNION ALL SELECT 1993, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1993`
    UNION ALL SELECT 1994, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1994`
    UNION ALL SELECT 1995, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1995`
  )
  GROUP BY yr, state_abbr
), ranked AS (
  SELECT *,
         RANK() OVER(PARTITION BY yr ORDER BY events_in_year DESC) AS rnk
  FROM yearly
), top1k AS (
  SELECT *
  FROM ranked
  WHERE rnk <= 1000
)
SELECT state_abbr,
       SUM(events_in_year) AS total_events_1980_95
FROM top1k
GROUP BY state_abbr
ORDER BY total_events_1980_95 DESC
LIMIT 20;
```

