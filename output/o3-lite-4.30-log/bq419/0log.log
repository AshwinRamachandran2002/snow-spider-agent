```sql
-- 7. Add a rank so we can keep only the top 1 000 states per year
WITH yearly AS (
  -- same aggregation step as query 6
  SELECT yr,
         UPPER(state) AS state_abbr,
         COUNT(*) AS events_in_year
  FROM (
    SELECT 1980 AS yr, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
    UNION ALL SELECT 1981, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1981`
    UNION ALL SELECT 1982, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1982`
    UNION ALL SELECT 1983, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1983`
    UNION ALL SELECT 1984, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1984`
