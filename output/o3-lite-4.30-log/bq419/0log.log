  UNION ALL SELECT 1987, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1987`
  UNION ALL SELECT 1988, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1988`
  UNION ALL SELECT 1989, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1989`
  UNION ALL SELECT 1990, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1990`
