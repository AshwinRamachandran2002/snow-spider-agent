    UNION ALL SELECT 1986, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1986`
    UNION ALL SELECT 1987, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1987`
    UNION ALL SELECT 1988, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1988`
    UNION ALL SELECT 1989, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1989`
    UNION ALL SELECT 1990, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1990`
    UNION ALL SELECT 1991, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1991`
    UNION ALL SELECT 1992, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1992`
    UNION ALL SELECT 1993, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1993`
    UNION ALL SELECT 1994, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1994`
    UNION ALL SELECT 1995, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1995`
  )
  GROUP BY yr, state_abbr
), ranked AS (
  SELECT *,
         RANK() OVER(PARTITION BY yr ORDER BY events_in_year DESC) AS rnk
  FROM yearly
)
SELECT yr, state_abbr, events_in_year, rnk
FROM ranked
WHERE rnk <= 1000
ORDER BY yr, rnk
LIMIT 20;
