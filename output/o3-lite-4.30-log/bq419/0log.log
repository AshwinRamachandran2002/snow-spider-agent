  FROM ranked
  WHERE rnk <= 1000
), totals AS (
  SELECT state_abbr,
         SUM(events_in_year) AS total_events
  FROM top1k
  GROUP BY state_abbr
  ORDER BY total_events DESC
  LIMIT 5
)
SELECT t.state_abbr,
       y.yr,
