  UNION ALL SELECT 1995, state FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1995`
)
SELECT yr,
       UPPER(state) AS state_abbr,
       COUNT(*)     AS events_in_year
FROM unioned
GROUP BY yr, state_abbr
ORDER BY yr, events_in_year DESC
LIMIT 20;
