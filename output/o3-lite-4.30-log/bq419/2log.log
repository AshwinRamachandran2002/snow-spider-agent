  WHERE state IS NOT NULL
  GROUP BY state
  UNION ALL
  SELECT '1982', state, COUNT(*) FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1982`
  WHERE state IS NOT NULL
  GROUP BY state
  -- … continue up to 1995
)
SELECT *
FROM (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY yr ORDER BY events DESC) AS rn
  FROM per_year
)
WHERE rn <= 1000
LIMIT 20;
```

```sql
-- 9) Sum the counts across years (after filtering to TOP‑1000/year) to see overall leaders
WITH per_year AS (  -- same CTE as in query 8, but expanded to 1980‑1995
  --……………………………………………………
),
ranked AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY yr ORDER BY events DESC) AS rn
  FROM per_year
),
top1000 AS (
  SELECT state, events
  FROM ranked
  WHERE rn <= 1000
)
SELECT state,
