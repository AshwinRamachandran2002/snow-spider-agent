```sql
-- 1) List a few distinct state abbreviations that appear in 1980
SELECT DISTINCT state
FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
WHERE state IS NOT NULL
LIMIT 20;
```

```sql
-- 2) Simple event count per state for 1980
SELECT state, COUNT(*) AS events_1980
FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
WHERE state IS NOT NULL
GROUP BY state
ORDER BY events_1980 DESC
LIMIT 20;
```

```sql
-- 3) Top 10 states (by events) for 1980
SELECT state, COUNT(*) AS events_1980
FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
WHERE state IS NOT NULL
GROUP BY state
ORDER BY events_1980 DESC
LIMIT 10;
```

```sql
-- 4) Same idea for 1985
SELECT state, COUNT(*) AS events_1985
FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1985`
WHERE state IS NOT NULL
GROUP BY state
ORDER BY events_1985 DESC
LIMIT 20;
```

```sql
-- 5) Compare two separate years in one result set (1980 & 1981)
SELECT '1980' AS yr, state, COUNT(*) AS events
FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
WHERE state IS NOT NULL
GROUP BY state
UNION ALL
SELECT '1981', state, COUNT(*) AS events
FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1981`
WHERE state IS NOT NULL
GROUP BY state
LIMIT 20;
```

```sql
-- 6)  Window‑function ranking: pick TOP‑N states (=10 here) for each year 1980‑1982
WITH per_year AS (
  SELECT '1980' AS yr, state, COUNT(*) AS events FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
  WHERE state IS NOT NULL GROUP BY state
  UNION ALL
  SELECT '1981', state, COUNT(*) FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1981`
  WHERE state IS NOT NULL GROUP BY state
  UNION ALL
  SELECT '1982', state, COUNT(*) FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1982`
  WHERE state IS NOT NULL GROUP BY state
)
SELECT *
FROM (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY yr ORDER BY events DESC) AS rn
  FROM per_year
)
WHERE rn <= 10
ORDER BY yr, events DESC
LIMIT 20;
```

```sql
-- 7) Same idea but TOP 1000 for one sample year (1990)
WITH ranked AS (
  SELECT state,
         COUNT(*) AS events,
         ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn
  FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1990`
  WHERE state IS NOT NULL
  GROUP BY state
)
SELECT state, events
FROM ranked
WHERE rn <= 1000
ORDER BY events DESC
LIMIT 20;
```

