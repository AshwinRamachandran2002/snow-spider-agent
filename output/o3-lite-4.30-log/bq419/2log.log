--Description / thinking process:
-- Goal: find the five U.S. state abbreviations that end up with the largest
--       total number of storm events over 1980‑1995, **after** restricting
--       each individual year to its own top‑1000 states by event count.
--
-- Steps implemented below:
--  1. Read all yearly tables at once with BigQuery’s wildcard:
--       `storms_*` + _TABLE_SUFFIX gives the year.
--  2. CTE per_year:   count rows per (year, state).
--  3. CTE ranked:     within each year, rank states by event count.
--  4. CTE top1000:    keep only rows whose yearly rank ≤ 1000.
--  5. Final SELECT:   aggregate those filtered counts across years
--                     and return the top‑5 states.

WITH per_year AS (
  SELECT
    _TABLE_SUFFIX AS yr,       -- derive year from table name
    state,
    COUNT(*) AS events
  FROM `bigquery-public-data.noaa_historic_severe_storms.storms_*`
  WHERE _TABLE_SUFFIX BETWEEN '1980' AND '1995'
        AND state IS NOT NULL
  GROUP BY yr, state
),
ranked AS (
  SELECT
    yr,
    state,
    events,
    ROW_NUMBER() OVER (PARTITION BY yr ORDER BY events DESC) AS rn
  FROM per_year
),
top1000 AS (
  SELECT
    state,
    events
  FROM ranked
  WHERE rn <= 1000
)
SELECT
  state,
  SUM(events) AS total_events_1980_1995
FROM top1000
GROUP BY state
ORDER BY total_events_1980_1995 DESC
LIMIT 5;
