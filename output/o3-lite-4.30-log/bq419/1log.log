Begin Exploring Related Columns
Relevant columns, their potential usage, and typical conditions  

• `state` – state abbreviation we need to count events for.  
• `event_begin_time` – (not used directly, but it tells us which table/year we are in).  
• All other columns are not needed for a pure “how‑many‑events‑per‑state” question.  
Condition we will always apply: `state IS NOT NULL`.

────────────────────────────────────────
Below are ten exploratory → analytical → final‐answer queries (every query ends with `LIMIT 20`). Replace or add years if you want to see more.  

```sql
-- 1) Peek at a few 1980 records just to see what the data look like
SELECT *
FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
WHERE state IS NOT NULL
LIMIT 20;
```

```sql
-- 2) Distinct state abbreviations that appear in 1980
SELECT DISTINCT state
FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
WHERE state IS NOT NULL
LIMIT 20;
```

```sql
-- 3) Event counts per state for 1980 (top 20)
SELECT state, COUNT(*) AS event_cnt
FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
WHERE state IS NOT NULL
GROUP BY state
ORDER BY event_cnt DESC
LIMIT 20;
```

```sql
-- 4) Same idea for 1981
SELECT state, COUNT(*) AS event_cnt
FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1981`
WHERE state IS NOT NULL
GROUP BY state
ORDER BY event_cnt DESC
LIMIT 20;
```

```sql
-- 5) Combine two years (1980–1981) to see how UNION ALL works
SELECT state, COUNT(*) AS event_cnt
FROM (
      SELECT state
      FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
      WHERE state IS NOT NULL
      UNION ALL
      SELECT state
      FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1981`
      WHERE state IS NOT NULL
)
GROUP BY state
ORDER BY event_cnt DESC
LIMIT 20;
```

```sql
-- 6) Year‑by‑year state counts for one sample year (1985) including a rank
SELECT
  '1985' AS yr,
  state,
  COUNT(*) AS event_cnt,
  RANK() OVER (ORDER BY COUNT(*) DESC) AS yr_rank
FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1985`
WHERE state IS NOT NULL
GROUP BY state
ORDER BY yr_rank
LIMIT 20;
```

```sql
-- 7) Put the “top‑1000‑per‑year” logic in place for three sample years
WITH year_state AS (
  SELECT '1984' AS yr, state, COUNT(*) AS event_cnt
  FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1984`
  WHERE state IS NOT NULL
  GROUP BY state
  UNION ALL
  SELECT '1985', state, COUNT(*) 
  FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1985`
  WHERE state IS NOT NULL
  GROUP BY state
  UNION ALL
  SELECT '1986', state, COUNT(*)
  FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1986`
  WHERE state IS NOT NULL
  GROUP BY state
),
ranked AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY yr ORDER BY event_cnt DESC) AS rn
  FROM year_state
)
SELECT yr, state, event_cnt
FROM ranked
WHERE rn <= 1000
ORDER BY yr, event_cnt DESC
LIMIT 20;
```

```sql
-- 8) Aggregate the filtered (top‑1000) counts across those three years
WITH year_state AS (
  SELECT '1984' AS yr, state, COUNT(*) AS event_cnt
  FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1984`
  WHERE state IS NOT NULL
  GROUP BY state
  UNION ALL
  SELECT '1985', state, COUNT(*)
  FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1985`
  WHERE state IS NOT NULL
  GROUP BY state
  UNION ALL
  SELECT '1986', state, COUNT(*)
  FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1986`
  WHERE state IS NOT NULL
  GROUP BY state
),
ranked AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY yr ORDER BY event_cnt DESC) AS rn
  FROM year_state
)
SELECT state,
       SUM(event_cnt) AS total_events
FROM ranked
WHERE rn <= 1000
GROUP BY state
ORDER BY total_events DESC
LIMIT 20;
```

```sql
-- 9) Same pattern but for two large blocks, 1980‑1987 and 1988‑1995
WITH yr_tbl AS (
