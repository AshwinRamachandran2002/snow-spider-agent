--Description:  Use BigQuery’s table‑wildcard feature to scan every storms_* table,
--filter to years 1980‑1995, count events per (year, state), keep only the top
--1 000 states inside each year (ROW_NUMBER window), then add the surviving
--annual totals together and return the five states with the largest combined
--counts.  Because we project a single `yr` field from _TABLE_SUFFIX, the column
--name is unique and no ambiguity can arise.
WITH all_events AS (
  SELECT
    _TABLE_SUFFIX AS yr,        -- year comes from the table name
    state
  FROM `bigquery-public-data.noaa_historic_severe_storms.storms_*`
  WHERE _TABLE_SUFFIX BETWEEN '1980' AND '1995'   -- limit to 1980‑1995
    AND state IS NOT NULL
),
year_counts AS (                -- events per state within each year
  SELECT
    yr,
    state,
    COUNT(*) AS event_cnt
  FROM all_events
  GROUP BY yr, state
),
ranked AS (                     -- keep only the top‑1 000 states per year
  SELECT
    yr,
    state,
    event_cnt,
    ROW_NUMBER() OVER (PARTITION BY yr ORDER BY event_cnt DESC) AS rn
  FROM year_counts
)
SELECT
  state,
  SUM(event_cnt) AS total_events_1980_1995
FROM ranked
WHERE rn <= 1000                -- satisfies “top 1000 per year” requirement
GROUP BY state
ORDER BY total_events_1980_1995 DESC
LIMIT 5;                        -- final: 5 states with the most events
