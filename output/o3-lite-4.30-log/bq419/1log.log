Query:
-- 7) Put the “top‑1000‑per‑year” logic in place for three sample years
WITH year_state AS (
  SELECT '1984' AS yr, state, COUNT(*) AS event_cnt
  FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1984`
  WHERE state IS NOT NULL
  GROUP BY state
  UNION ALL
  SELECT '1985', state, COUNT(*) 
  FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1985`
  WHERE state IS NOT NULL
  GROUP BY state
  UNION ALL
  SELECT '1986', state, COUNT(*)
  FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1986`
  WHERE state IS NOT NULL
  GROUP BY state
),
ranked AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY yr ORDER BY event_cnt DESC) AS rn
  FROM year_state
)
SELECT yr, state, event_cnt
FROM ranked
WHERE rn <= 1000
ORDER BY yr, event_cnt DESC
LIMIT 20;
