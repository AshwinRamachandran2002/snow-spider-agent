Begin Exploring Related Columns
Relevant columns and their potential usages
• model_score.name : identify each problem / dataset  
• model_score.version : identify a concrete “model experiment” run for that problem  
• model_score.step : granular step inside an experiment  
• model_score.model : concrete algorithm (e.g. ‘DTCG’, ‘RFCG’, very often one row whose name contains the word ‘Stack’)  
• model_score.test_score : metric that will be compared with / without the Stack model  
• model.name : to join with model_score on (name, version, step)  
• model.version : idem  
• model.step : idem  
• model.L1_model : the “meta family” (e.g. ‘regression’, ‘classification’, ‘xgboost’, …) that we finally want to count  
Conditions that will be useful  
• model_score.model LIKE '%Stack%' → returns the rows corresponding to the stacker(s)  
• model_score.model NOT LIKE '%Stack%' → the “non‑stack” competitors  
• HAVING MAX(non_stack_score) < stack_score → ‘strong’ case  
• HAVING MAX(non_stack_score) = stack_score → ‘soft’ case  

Ten exploratory SQL queries
--------------------------------------------------
```sql
-- 1. Show the different (name,version) pairs for which model scores exist
SELECT DISTINCT "name", "version"
FROM "model_score"
LIMIT 20;
```

```sql
-- 2. List all distinct algorithm names to verify whether something contains “Stack”
SELECT DISTINCT "model"
FROM "model_score"
LIMIT 20;
```

```sql
-- 3. Inspect every score row whose model name contains “Stack”
SELECT *
FROM "model_score"
WHERE "model" LIKE '%Stack%'
ORDER BY "test_score" DESC
LIMIT 20;
```

```sql
-- 4. Inspect non–stack competitors for one concrete experiment
SELECT *
FROM "model_score"
WHERE "name" = 'iris' AND "version" = 1
  AND "model" NOT LIKE '%Stack%'
ORDER BY "test_score" DESC
LIMIT 20;
```

```sql
-- 5. Join model_score with model to see the L1_model attached to every step
SELECT ms."name",
       ms."version",
       ms."step",
       ms."model",
       m."L1_model",
       ms."test_score"
FROM   "model_score" AS ms
JOIN   "model"       AS m
  ON   ms."name" = m."name"
 AND   ms."version" = m."version"
 AND   ms."step" = m."step"
LIMIT 20;
```

```sql
-- 6. For each (name,version) give the stack test_score and the maximum non‑stack test_score
SELECT s."name",
       s."version",
       MAX(CASE WHEN s."model" LIKE '%Stack%' THEN s."test_score" END) AS stack_score,
       MAX(CASE WHEN s."model" NOT LIKE '%Stack%' THEN s."test_score" END) AS max_non_stack_score
FROM   "model_score" AS s
GROUP  BY s."name", s."version"
LIMIT 20;
```

```sql
-- 7. Classify every experiment as 'strong' / 'soft'
WITH scores AS (
  SELECT s."name",
         s."version",
         MAX(CASE WHEN s."model" LIKE '%Stack%' THEN s."test_score" END)         AS stack_score,
         MAX(CASE WHEN s."model" NOT LIKE '%Stack%' THEN s."test_score" END)     AS max_non_stack_score
  FROM   "model_score" AS s
  GROUP  BY s."name", s."version"
)
SELECT *,
       CASE
         WHEN max_non_stack_score <  stack_score THEN 'strong'
         WHEN max_non_stack_score =  stack_score THEN 'soft'
       END AS status
FROM   scores
LIMIT 20;
```

```sql
-- 8. Attach the dominant status of the experiment back to every step so that we can count by L1_model
WITH exp_status AS (
  SELECT s."name",
         s."version",
         CASE
           WHEN MAX(CASE WHEN s."model" NOT LIKE '%Stack%' THEN s."test_score" END) 
                <  MAX(CASE WHEN s."model" LIKE '%Stack%'     THEN s."test_score" END)
                THEN 'strong'
           WHEN MAX(CASE WHEN s."model" NOT LIKE '%Stack%' THEN s."test_score" END) 
                =  MAX(CASE WHEN s."model" LIKE '%Stack%'     THEN s."test_score" END)
                THEN 'soft'
         END AS status
  FROM   "model_score" AS s
  GROUP  BY s."name", s."version"
)
SELECT m."L1_model",
       es."status",
       COUNT(*) AS nb_occurrences
FROM   exp_status      AS es
JOIN   "model"         AS m
  ON   es."name" = m."name"
 AND   es."version" = m."version"
GROUP  BY m."L1_model", es."status"
LIMIT 20;
```

```sql
-- 9. For each status keep only the L1_model having the maximal count
WITH counts AS (
  SELECT m."L1_model",
         es."status",
         COUNT(*) AS nb_occurrences
  FROM   (
           SELECT s."name",
                  s."version",
                  CASE
                    WHEN MAX(CASE WHEN s."model" NOT LIKE '%Stack%' THEN s."test_score" END) 
                         <  MAX(CASE WHEN s."model" LIKE '%Stack%'     THEN s."test_score" END)
                         THEN 'strong'
                    WHEN MAX(CASE WHEN s."model" NOT LIKE '%Stack%' THEN s."test_score" END) 
                         =  MAX(CASE WHEN s."model" LIKE '%Stack%'     THEN s."test_score" END)
                         THEN 'soft'
                  END AS status
           FROM   "model_score" AS s
           GROUP  BY s."name", s."version"
         )                         AS es
JOIN   "model"                     AS m
  ON   es."name" = m."name"
 AND   es."version" = m."version"
GROUP  BY m."L1_model", es."status"
)
SELECT c1."status",
       c1."L1_model",
       c1."nb_occurrences"
FROM   counts AS c1
WHERE  c1."nb_occurrences" = (
         SELECT MAX(c2."nb_occurrences")
         FROM   counts AS c2
         WHERE  c2."status" = c1."status"
       )
ORDER BY c1."status"
LIMIT 20;
```

```sql
--10. Same as 9, but restricted to rows whose model name actually **is** the stacker;
