           WHEN MAX(CASE WHEN s."model" NOT LIKE '%Stack%' THEN s."test_score" END) 
                =  MAX(CASE WHEN s."model" LIKE '%Stack%'     THEN s."test_score" END)
                THEN 'soft'
         END AS status
  FROM   "model_score" AS s
  GROUP  BY s."name", s."version"
),
stack_steps AS (
  SELECT ms."name",
         ms."version",
         ms."step"
  FROM   "model_score" AS ms
  WHERE  ms."model" LIKE '%Stack%'
)
SELECT m."L1_model",
       es."status",
       COUNT(*) AS nb_occurrences
FROM   exp_status AS es
JOIN   stack_steps AS st
  ON   es."name"    = st."name"
 AND   es."version" = st."version"
JOIN   "model"      AS m
  ON   st."name"    = m."name"
 AND   st."version" = m."version"
 AND   st."step"    = m."step"
GROUP  BY m."L1_model", es."status"
LIMIT 20;
