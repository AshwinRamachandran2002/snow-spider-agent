-- 9. Count how many times each L1_model appears for every status (strong / soft)
WITH run_l1 AS (
      /* reuse CTE run_status from query 8 */
      WITH step_flag AS (
            SELECT  ms."name",
                    ms."version",
                    MAX(CASE WHEN ms."model" LIKE '%Stack%'     THEN ms."test_score" END) AS stack_score,
                    MAX(CASE WHEN ms."model" NOT LIKE '%Stack%' THEN ms."test_score" END) AS best_non_stack
            FROM    "model_score" AS ms
            GROUP BY ms."name", ms."version", ms."step"
      ), step_status AS (
            SELECT  "name","version",
                    CASE
                         WHEN best_non_stack < stack_score THEN 'strong'
                         WHEN best_non_stack = stack_score THEN 'soft'
                    END AS status_step
            FROM    step_flag
      ), run_status AS (
            SELECT  "name","version",
                    CASE
                         WHEN SUM(status_step='strong') > 0 THEN 'strong'
                         WHEN SUM(status_step='soft')   > 0 THEN 'soft'
                    END AS run_status
            FROM    step_status
            GROUP BY "name","version"
      )
      SELECT  rs."name",
              rs."version",
              rs."run_status",
              m."L1_model"
      FROM    run_status AS rs
      JOIN    "model"      AS m
           ON m."name" = rs."name"
          AND m."version" = rs."version"
          AND m."step" = 1          -- keep one row per run (step=1 is arbitrary but consistent)
)
SELECT  "run_status",
        "L1_model",
        COUNT(*) AS nb_occurrence
FROM    run_l1
GROUP BY "run_status","L1_model"
ORDER BY "run_status", nb_occurrence DESC
LIMIT 20;
