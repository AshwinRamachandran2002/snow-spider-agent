              MAX(CASE WHEN ms."model" NOT LIKE '%Stack%' THEN ms."test_score" END) AS best_non_stack
      FROM    "model_score" AS ms
      GROUP BY ms."name", ms."version", ms."step"
), step_status AS (
      SELECT  "name",
              "version",
              CASE
                   WHEN best_non_stack < stack_score THEN 'strong'
                   WHEN best_non_stack = stack_score THEN 'soft'
              END AS status_step
      FROM    step_flag
)
SELECT  "name",
        "version",
        CASE
             WHEN SUM(status_step='strong') > 0 THEN 'strong'
             WHEN SUM(status_step='soft')   > 0 THEN 'soft'
        END AS run_status
FROM    step_status
GROUP BY "name","version"
LIMIT 20;
