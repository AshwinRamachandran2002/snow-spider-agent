--10. Final query: for each status, show the L1_model with the maximum count
WITH run_l1 AS (
      /* same CTE as in query 9 */
      WITH step_flag AS (
            SELECT  ms."name",
                    ms."version",
                    MAX(CASE WHEN ms."model" LIKE '%Stack%'     THEN ms."test_score" END) AS stack_score,
                    MAX(CASE WHEN ms."model" NOT LIKE '%Stack%' THEN ms."test_score" END) AS best_non_stack
            FROM    "model_score" AS ms
            GROUP BY ms."name", ms."version", ms."step"
      ), step_status AS (
            SELECT  "name","version",
                    CASE
                         WHEN best_non_stack < stack_score THEN 'strong'
                         WHEN best_non_stack = stack_score THEN 'soft'
                    END AS status_step
            FROM    step_flag
      ), run_status AS (
            SELECT  "name","version",
                    CASE
                         WHEN SUM(status_step='strong') > 0 THEN 'strong'
                         WHEN SUM(status_step='soft')   > 0 THEN 'soft'
                    END AS run_status
            FROM    step_status
            GROUP BY "name","version"
      )
      SELECT  rs."name",
              rs."version",
              rs."run_status",
              m."L1_model"
      FROM    run_status AS rs
      JOIN    "model"      AS m
           ON m."name" = rs."name"
          AND m."version" = rs."version"
          AND m."step" = 1
), counts AS (
      SELECT  "run_status",
              "L1_model",
              COUNT(*) AS nb_occurrence
      FROM    run_l1
      GROUP BY "run_status","L1_model"
)
SELECT  c1."run_status",
        c1."L1_model",
        c1."nb_occurrence"
FROM    counts AS c1
JOIN (
      SELECT  "run_status",
              MAX(nb_occurrence) AS max_cnt
      FROM    counts
      GROUP BY "run_status"
) AS mx
  ON  c1."run_status" = mx."run_status"
 AND  c1."nb_occurrence" = mx."max_cnt"
ORDER BY c1."run_status";
