```sql
--Description: ❶ For every (name,version,step) compare the Stack test‑score with the
--                  best non‑Stack test‑score to tag the step as ‘strong’, ‘soft’ or NULL.  
--              ❷ Roll the step tags up to an experiment tag (strong if any step is
--                  strong, else soft if any step is soft).  
--              ❸ Attach the experiment’s first‑level model (L1_model).  
--              ❹ Count how many times each L1_model appears under each status.  
--              ❺ For each status keep the L1_model with the highest count.
WITH step_status AS (                       -- ❶
        SELECT  a."name",
                a."version",
                a."step",
                CASE
                     WHEN b."stack_score" > a."max_non_stack" THEN 'strong'
                     WHEN b."stack_score" = a."max_non_stack" THEN 'soft'
                END AS "step_status"
        FROM   ( SELECT  "name","version","step",
                        MAX("test_score") AS "max_non_stack"
                 FROM   "model_score"
                 WHERE  "model" NOT LIKE '%Stack%'
                 GROUP  BY "name","version","step" ) AS a
        JOIN   ( SELECT  "name","version","step",
                         "test_score" AS "stack_score"
                 FROM    "model_score"
                 WHERE   "model" LIKE '%Stack%' ) AS b
          ON   a."name"    = b."name"
         AND   a."version" = b."version"
         AND   a."step"    = b."step"
),
model_status AS (                            -- ❷
        SELECT  "name",
                "version",
                CASE
                     WHEN SUM(CASE WHEN "step_status"='strong' THEN 1 END) > 0
                          THEN 'strong'
                     WHEN SUM(CASE WHEN "step_status"='soft'   THEN 1 END) > 0
                          THEN 'soft'
                END AS "model_status"
        FROM    step_status
        GROUP   BY "name","version"
        HAVING  "model_status" IS NOT NULL      -- discard experiments with no tag
),
l1_status AS (                                -- ❸
        SELECT  m."L1_model",
                ms."model_status"
        FROM    model_status AS ms
        JOIN    ( SELECT DISTINCT "name","version","L1_model"
                  FROM "model" ) AS m
          ON    ms."name"    = m."name"
         AND    ms."version" = m."version"
),
counts AS (                                   -- ❹
        SELECT  "L1_model",
                "model_status",
                COUNT(*) AS n_occurrences
        FROM    l1_status
        GROUP   BY "L1_model","model_status"
)
-- ❺  final selection: the most frequent L1_model for each status
SELECT  c1."model_status",
        c1."L1_model",
        c1."n_occurrences"
FROM    counts AS c1
JOIN   ( SELECT  "model_status",
                 MAX(n_occurrences) AS max_cnt
         FROM    counts
         GROUP   BY "model_status" ) AS c2
  ON    c1."model_status"  = c2."model_status"
 AND    c1."n_occurrences" = c2.max_cnt;
