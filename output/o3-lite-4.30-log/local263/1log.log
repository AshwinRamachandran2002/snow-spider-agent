--Description: (#10) For each status (‘strong’, ‘soft’) return the L1_model that
--              occurs most often, together with its occurrence count.
WITH step_status AS (
        SELECT  a."name",a."version",a."step",
                CASE
                     WHEN b."stack_score" > a."max_non_stack" THEN 'strong'
                     WHEN b."stack_score" = a."max_non_stack" THEN 'soft'
                END AS "step_status"
        FROM  ( SELECT "name","version","step",
                       MAX("test_score") AS "max_non_stack"
                FROM  "model_score"
                WHERE "model" NOT LIKE '%Stack%'
                GROUP BY "name","version","step" ) AS a
        JOIN  ( SELECT "name","version","step",
                       "test_score" AS "stack_score"
                FROM  "model_score"
                WHERE "model" LIKE '%Stack%' ) AS b
          ON  a."name"    = b."name"
         AND a."version" = b."version"
         AND a."step"    = b."step"
),
model_status AS (
        SELECT  "name","version",
                CASE
                     WHEN SUM(CASE WHEN "step_status"='strong' THEN 1 END) > 0
                          THEN 'strong'
                     WHEN SUM(CASE WHEN "step_status"='soft' THEN 1 END) > 0
                          THEN 'soft'
                END AS "model_status"
        FROM    step_status
        GROUP BY "name","version"
        HAVING  "model_status" IS NOT NULL
),
l1_status AS (
        SELECT  m."L1_model", ms."model_status"
        FROM    model_status AS ms
        JOIN    (SELECT DISTINCT "name","version","L1_model" FROM "model") AS m
          ON    ms."name"    = m."name"
         AND    ms."version" = m."version"
),
counts AS (
        SELECT  "L1_model","model_status",COUNT(*) AS n_occurrences
        FROM    l1_status
        GROUP   BY "L1_model","model_status"
)
SELECT  c."model_status",
        c."L1_model",
        c."n_occurrences"
FROM    counts AS c
JOIN   (SELECT "model_status",MAX(n_occurrences) AS max_cnt
        FROM   counts
        GROUP  BY "model_status") AS mx
  ON    c."model_status"  = mx."model_status"
 AND    c."n_occurrences" = mx.max_cnt;
