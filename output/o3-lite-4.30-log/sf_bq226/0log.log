-- We anchor the filter on DECODED_EVENTS (timestamp ≥ 2023‑01‑01) and
-- INNER‑JOIN to LOGS on the shared transaction hash, then display fields from
-- both sides for comparison.  Limiting to 20 rows keeps the sample concise.
SELECT  d."TRANSACTION_HASH",
        d."LOG_INDEX"      AS "decoded_log_index",
        d."EVENT_SIGNATURE",
        d."ADDRESS"        AS "decoded_address",
        l."log_index"      AS "raw_log_index",
        l."address"        AS "raw_log_address",
        l."topics",
