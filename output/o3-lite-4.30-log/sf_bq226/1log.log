```sql
WITH logs_filtered AS (
    SELECT 
        "TRANSACTION_HASH",
        "LOG_INDEX"
    FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS"
    WHERE "BLOCK_TIMESTAMP" >= 1672531200000000          -- 2023‑01‑01 (µs)
      AND BYTELENGTH("DATA") > 4096                      -- blocks > 4 096 bytes
),
transfers AS (
    SELECT
        "TRANSACTION_HASH",
        "LOG_INDEX",
        (PARSE_JSON("ARGS"))[0]::STRING AS "FROM_ADDR",
        (PARSE_JSON("ARGS"))[1]::STRING AS "TO_ADDR"
    FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS"
    WHERE "BLOCK_TIMESTAMP" >= 1672531200000000
      AND "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
)
SELECT
    'https://cronoscan.com/address/' || LOWER(t."FROM_ADDR") AS "URL"
FROM transfers t
JOIN logs_filtered l
  ON t."TRANSACTION_HASH" = l."TRANSACTION_HASH"
 AND t."LOG_INDEX"        = l."LOG_INDEX"
WHERE t."TO_ADDR" IS NOT NULL                              -- non‑null “to” field
GROUP BY "URL"
ORDER BY COUNT(*) DESC NULLS LAST, "URL"                   -- most‑frequent sender
LIMIT 1;
```
