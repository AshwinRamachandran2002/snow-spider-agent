--Description:  (Corrected Query 8)
-- Build the 2014+ tournament team‑level rows, attach pace/efficiency metrics
-- for both sides, then calculate opponent‑minus‑team differences.  The join
-- to team metrics now correctly uses b.school_ncaa (not the earlier typo
-- “b.win_school_ncaa OR b.school_ncaa”).

WITH base AS (                         -- long format, 2014+
  SELECT season,
         'win'  AS label,
         win_seed        AS seed,
         win_school_ncaa AS school_ncaa,
         lose_seed       AS opponent_seed,
         lose_school_ncaa AS opponent_school_ncaa
  FROM `data-to-insights.ncaa.mbb_historical_tournament_games`
  WHERE season >= 2014
  UNION ALL
  SELECT season,
         'loss',
         lose_seed,
         lose_school_ncaa,
         win_seed,
         win_school_ncaa
  FROM `data-to-insights.ncaa.mbb_historical_tournament_games`
  WHERE season >= 2014
)

SELECT
    b.*,
    tm.pace_rank,
    tm.poss_40min,
    tm.pace_rating,
    tm.efficiency_rank,
    tm.pts_100poss,
    tm.efficiency_rating,
    opp.pace_rank         AS opp_pace_rank,
    opp.poss_40min        AS opp_poss_40min,
    opp.pace_rating       AS opp_pace_rating,
    opp.efficiency_rank   AS opp_efficiency_rank,
    opp.pts_100poss       AS opp_pts_100poss,
    opp.efficiency_rating AS opp_efficency_rating,

    -- differences (opponent − team)
    opp.pace_rank         - tm.pace_rank          AS pace_rank_diff,
    opp.poss_40min        - tm.poss_40min         AS poss_40min_diff,
    opp.pace_rating       - tm.pace_rating        AS pace_rating_diff,
    opp.efficiency_rank   - tm.efficiency_rank    AS eff_rank_diff,
    opp.pts_100poss       - tm.pts_100poss        AS pts_100poss_diff,
    opp.efficiency_rating - tm.efficiency_rating  AS eff_rating_diff
FROM base b
LEFT JOIN `data-to-insights.ncaa.feature_engineering` tm
       ON tm.season = b.season
      AND LOWER(tm.team) = LOWER(b.school_ncaa)
LEFT JOIN `data-to-insights.ncaa.feature_engineering` opp
       ON opp.season = b.season
      AND LOWER(opp.team) = LOWER(b.opponent_school_ncaa)
LIMIT 20
