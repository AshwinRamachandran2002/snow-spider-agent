```sql
--Description:
-- Goal: Produce an NCAA‑tournament data set (2014+) that lists every team–game outcome
--       together with its own and its opponent’s pace / efficiency metrics plus
--       metric differences.  Steps (inside one query):
--   1) hist_2014_17 : Convert 2014‑2017 historical games to a long “team‑centric” format
--                     by UNIONing winners and losers.
--   2) tourney_2018 : Bring in the already‑long 2018 tournament results.
--   3) base         : UNION ALL both sources, giving every team/outcome row ≥2014.
--   4) Join feature_engineering twice:
--        • tm  = metrics for the focal team  (match on season + LOWER(team)=LOWER(school))
--        • opp = metrics for the opponent    (match on season + LOWER(team)=LOWER(opponent))
--   5) Select raw metrics and pre‑compute six “opponent‑minus‑team” differences.
--   6) LIMIT 20 just for preview (remove for full extract).

WITH hist_2014_17 AS (
  SELECT
      season,
      'win'  AS label,
      win_seed         AS seed,
      win_school_ncaa  AS school_ncaa,
      lose_seed        AS opponent_seed,
      lose_school_ncaa AS opponent_school_ncaa
  FROM `data-to-insights.ncaa.mbb_historical_tournament_games`
  WHERE season BETWEEN 2014 AND 2017

  UNION ALL

  SELECT
      season,
      'loss' AS label,
      lose_seed        AS seed,
      lose_school_ncaa AS school_ncaa,
      win_seed         AS opponent_seed,
      win_school_ncaa  AS opponent_school_ncaa
  FROM `data-to-insights.ncaa.mbb_historical_tournament_games`
  WHERE season BETWEEN 2014 AND 2017
),
tourney_2018 AS (
  SELECT
      season,
      label,
      seed,
      school_ncaa,
      opponent_seed,
      opponent_school_ncaa
  FROM `data-to-insights.ncaa.2018_tournament_results`
  WHERE season = 2018
),
base AS (
  SELECT * FROM hist_2014_17
  UNION ALL
  SELECT * FROM tourney_2018
)
SELECT
    b.*,

    -- team metrics
    tm.pace_rank,
    tm.poss_40min,
    tm.pace_rating,
    tm.efficiency_rank,
    tm.pts_100poss,
    tm.efficiency_rating,

    -- opponent metrics
    opp.pace_rank          AS opp_pace_rank,
    opp.poss_40min         AS opp_poss_40min,
    opp.pace_rating        AS opp_pace_rating,
    opp.efficiency_rank    AS opp_efficiency_rank,
