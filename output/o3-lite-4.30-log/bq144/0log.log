/* -------------------------------------------------------------------
   NCAA Men’s Tournament games (2014‑present) enriched with pace &
   efficiency metrics for both teams plus opponent‑minus‑team diffs
------------------------------------------------------------------------ */

WITH -------------------------------------------------------------------
-- 1)  All tournament outcomes 2014‑present in a long (one‑row‑per‑team)
--     format.  Historical seasons 2014‑2017 come from the “historical”
--     file, 2018 uses the dedicated 2018 results file.
------------------------------------------------------------------------
tourney_long AS (

  /* winners & losers 2014‑2017 */
  SELECT
      season,
      'win'  AS label,
      win_seed        AS seed,
      win_school_ncaa AS school_ncaa,
      lose_seed       AS opponent_seed,
      lose_school_ncaa AS opponent_school_ncaa
  FROM `data-to-insights.ncaa.mbb_historical_tournament_games`
  WHERE season >= 2014

  UNION ALL

  SELECT
      season,
      'loss',
      lose_seed,
      lose_school_ncaa,
      win_seed,
      win_school_ncaa
  FROM `data-to-insights.ncaa.mbb_historical_tournament_games`
  WHERE season >= 2014

  UNION ALL                        -- 2018 file is already long format
  SELECT
      season,
      label,
      seed,
      school_ncaa,
      opponent_seed,
      opponent_school_ncaa
  FROM `data-to-insights.ncaa.2018_tournament_results`
  WHERE season = 2018
),

------------------------------------------------------------------------
-- 2)  Attach pace & efficiency metrics for the team and the opponent
------------------------------------------------------------------------
metrics_joined AS (
  SELECT
      t.*,

      /* team metrics (prefix: team_) */
      tm.pace_rank          AS team_pace_rank,
      tm.poss_40min         AS team_poss_40min,
      tm.pace_rating        AS team_pace_rating,
      tm.efficiency_rank    AS team_efficiency_rank,
      tm.pts_100poss        AS team_pts_100poss,
      tm.efficiency_rating  AS team_efficiency_rating,

      /* opponent metrics (prefix: opp_) */
      opp.pace_rank         AS opp_pace_rank,
      opp.poss_40min        AS opp_poss_40min,
      opp.pace_rating       AS opp_pace_rating,
      opp.efficiency_rank   AS opp_efficiency_rank,
      opp.pts_100poss       AS opp_pts_100poss,
      opp.efficiency_rating AS opp_efficiency_rating

  FROM tourney_long t
  LEFT JOIN `data-to-insights.ncaa.feature_engineering` tm
         ON tm.season = t.season
        AND LOWER(tm.team) = LOWER(t.school_ncaa)
  LEFT JOIN `data-to-insights.ncaa.feature_engineering` opp
         ON opp.season = t.season
        AND LOWER(opp.team) = LOWER(t.opponent_school_ncaa)
)

------------------------------------------------------------------------
-- 3)  Final select with opponent minus team differences
------------------------------------------------------------------------
SELECT
    season,
    label                             AS game_result,
    seed                              AS team_seed,
    opponent_seed,
    school_ncaa                       AS team_school,
    opponent_school_ncaa              AS opponent_school,

    /* pace metrics */
    team_pace_rank,
    opp_pace_rank,
    team_poss_40min,
    opp_poss_40min,
    team_pace_rating,
    opp_pace_rating,

    /* efficiency metrics */
    team_efficiency_rank,
    opp_efficiency_rank,
    team_pts_100poss,
    opp_pts_100poss,
    team_efficiency_rating,
    opp_efficiency_rating,

    /* differences (opponent – team) */
    (opp_pace_rank        - team_pace_rank)        AS pace_rank_diff,
    (opp_poss_40min       - team_poss_40min)       AS poss_40min_diff,
    (opp_pace_rating      - team_pace_rating)      AS pace_rating_diff,
    (opp_efficiency_rank  - team_efficiency_rank)  AS eff_rank_diff,
    (opp_pts_100poss      - team_pts_100poss)      AS pts_100poss_diff,
    (opp_efficiency_rating- team_efficiency_rating)AS eff_rating_diff
FROM metrics_joined
ORDER BY season, school_ncaa, label;
```
