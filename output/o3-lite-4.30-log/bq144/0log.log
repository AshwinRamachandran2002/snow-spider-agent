)

SELECT
    /* --- identifiers & seeds --- */
    season,
    label                                               AS game_result,
    seed                                                AS team_seed,
    opponent_seed,
    school_ncaa                                         AS team_school,
    opponent_school_ncaa                                AS opponent_school,

