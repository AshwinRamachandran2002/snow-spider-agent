```sql
--Description: We want the count of trips that begin and end at different stations.
--             The column `end_station_id` is STRING; if we try to cast it to INT64
--             we hit non‑numeric values like 'Event', which produced the previous error.
--             Therefore we cast the numeric start_station_id to STRING so both sides
--             are comparable as text, then exclude rows where the two station IDs match.
--             Finally we group by the (start_station_id, end_station_id) pair and count.

SELECT
  CAST(start_station_id AS STRING) AS start_station_id,
  end_station_id,
  COUNT(*) AS trips
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
WHERE end_station_id IS NOT NULL
  AND CAST(start_station_id AS STRING) <> end_station_id
GROUP BY start_station_id, end_station_id
LIMIT 20;
