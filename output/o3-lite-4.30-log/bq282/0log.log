```sql
--Description: #5  Join trips with their *start* station only (no error here because both
--             columns are INT64).  Shows each trip’s start council district for active
--             stations.

SELECT
  t.trip_id,
  t.start_station_id,
  ss.council_district AS start_cd
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`  AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS ss
  ON t.start_station_id = ss.station_id          -- both INT64, safe
WHERE ss.status = 'active'
LIMIT 20;
```

```sql
--Description: #6  Join trips to BOTH start & end stations, keeping only rows where
--             *both* stations are active and are different.  We now join on the
--             end station by casting `es.station_id` to STRING, not vice‑versa,
--             to avoid non‑numeric end_station_id values.  We also compare the
--             two station IDs as STRINGs to ensure they differ.

SELECT
  t.trip_id,
  t.start_station_id,
  ss.council_district AS start_cd,
  t.end_station_id,
  es.council_district AS end_cd
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`  AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS ss
  ON t.start_station_id = ss.station_id
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS es
  ON t.end_station_id = CAST(es.station_id AS STRING)          -- safe join
WHERE ss.status = 'active'
  AND es.status = 'active'
  AND CAST(t.start_station_id AS STRING) <> t.end_station_id   -- different stations
LIMIT 20;
```

```sql
--Description: #7  Keep only trips whose start *and* end council districts are the same
--             (but stations are different).  Same safe join strategy as in #6.

SELECT
  t.trip_id,
  ss.council_district AS district
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`  AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS ss
  ON t.start_station_id = ss.station_id
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS es
  ON t.end_station_id = CAST(es.station_id AS STRING)
WHERE ss.status = 'active'
  AND es.status = 'active'
  AND ss.council_district = es.council_district               -- same district
  AND CAST(t.start_station_id AS STRING) <> t.end_station_id  -- different stations
LIMIT 20;
```

```sql
--Description: #8  Aggregate: count trips (same district, different stations) per
--             council district, limited to 20 rows.  Uses safe STRING join.

SELECT
  ss.council_district AS district,
  COUNT(*) AS trips_same_cd_diff_station
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`  AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS ss
  ON t.start_station_id = ss.station_id
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS es
  ON t.end_station_id = CAST(es.station_id AS STRING)
WHERE ss.status = 'active'
  AND es.status = 'active'
  AND ss.council_district = es.council_district
  AND CAST(t.start_station_id AS STRING) <> t.end_station_id
GROUP BY district
ORDER BY trips_same_cd_diff_station DESC
LIMIT 20;
```

```sql
--Description: #9  Same as #8 but without the LIMIT so we can see every district’s
--             trip count, ordered by descending volume.

SELECT
  ss.council_district AS district,
  COUNT(*) AS trips_same_cd_diff_station
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`  AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS ss
  ON t.start_station_id = ss.station_id
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS es
  ON t.end_station_id = CAST(es.station_id AS STRING)
WHERE ss.status = 'active'
  AND es.status = 'active'
  AND ss.council_district = es.council_district
  AND CAST(t.start_station_id AS STRING) <> t.end_station_id
GROUP BY district
ORDER BY trips_same_cd_diff_station DESC;
```

```sql
--Description: #10  Final answer query – returns the single numeric council district
--             that records the highest number of trips starting & ending in the same
--             district but at different active stations, using the safe joins.

SELECT district
FROM (
  SELECT
    ss.council_district AS district,
    COUNT(*) AS trips_same_cd_diff_station
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`  AS t
  JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS ss
    ON t.start_station_id = ss.station_id
  JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS es
    ON t.end_station_id = CAST(es.station_id AS STRING)
  WHERE ss.status = 'active'
    AND es.status = 'active'
    AND ss.council_district = es.council_district
    AND CAST(t.start_station_id AS STRING) <> t.end_station_id
  GROUP BY district
  ORDER BY trips_same_cd_diff_station DESC
  LIMIT 1
);
```
