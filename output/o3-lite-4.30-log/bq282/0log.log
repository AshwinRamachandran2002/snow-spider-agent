--Description: #6  Join trips to BOTH start & end stations, keeping only rows where
--             *both* stations are active and are different.  We now join on the
--             end station by casting `es.station_id` to STRING, not vice‑versa,
--             to avoid non‑numeric end_station_id values.  We also compare the
--             two station IDs as STRINGs to ensure they differ.

SELECT
  t.trip_id,
  t.start_station_id,
  ss.council_district AS start_cd,
  t.end_station_id,
  es.council_district AS end_cd
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`  AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS ss
  ON t.start_station_id = ss.station_id
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS es
  ON t.end_station_id = CAST(es.station_id AS STRING)          -- safe join
WHERE ss.status = 'active'
  AND es.status = 'active'
  AND CAST(t.start_station_id AS STRING) <> t.end_station_id   -- different stations
LIMIT 20
