```sql
--Description (thinking process):
-- Goal: return the council‑district number that records the most bike‑share trips
--       where a trip begins and ends inside the same active district but at
--       different stations.
-- Steps implemented below:
--   1. Join each trip to its start and end station rows (active stations only).
--   2. Harmonize data types: start_station_id is INT64; end_station_id (STRING)
--      is cast to INT64 for the join.
--   3. Keep trips where both stations lie in the same council_district.
--   4. Exclude “loop” rides that start and finish at the identical station.
--   5. Count qualifying trips per district, sort by that count, and return the
--      single district with the highest total.
SELECT
  s_start.council_district AS highest_trip_district
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`    AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s_start
  ON t.start_station_id = s_start.station_id                    -- INT64 = INT64
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s_end
  ON CAST(t.end_station_id AS INT64) = s_end.station_id         -- STRING → INT64
WHERE s_start.status = 'active'
  AND s_end.status   = 'active'
  AND s_start.council_district = s_end.council_district         -- same district
  AND t.start_station_id <> CAST(t.end_station_id AS INT64)     -- different stations
GROUP BY highest_trip_district
ORDER BY COUNT(*) DESC
LIMIT 1;
```
