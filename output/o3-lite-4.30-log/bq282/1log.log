```sql
-- Thinking process:
-- • Goal: find the council district whose ACTIVE bikeshare stations generate the
--   highest number of trips that both start and finish in that same district, but
--   at DIFFERENT stations.
-- • Steps:
--   1) Join each trip’s start_station_id to its station record (alias sd).
--   2) Join each trip’s end_station_id to its station record (alias ed) using
--      SAFE_CAST to turn non‑numeric strings like “Event” into NULL; those rows
--      will be filtered out.
--   3) Keep only rows where:
--        ‑ start_id ≠ end_id  (different stations)
--        ‑ sd.council_district = ed.council_district (same district)
--        ‑ both stations’ status = 'active'
--   4) GROUP BY the shared district, COUNT trips, ORDER by that count, LIMIT 1.
SELECT
  sd.council_district AS district_with_max_trips,
  COUNT(*)            AS trip_count
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`    AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS sd
  ON sd.station_id = t.start_station_id
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS ed
  ON ed.station_id = SAFE_CAST(t.end_station_id AS INT64)
WHERE SAFE_CAST(t.end_station_id AS INT64) IS NOT NULL         -- ignore non‑numeric end IDs
  AND t.start_station_id <> SAFE_CAST(t.end_station_id AS INT64) -- different stations
  AND sd.council_district = ed.council_district                -- same district
  AND sd.status = 'active' AND ed.status = 'active'            -- both active
GROUP BY district_with_max_trips
ORDER BY trip_count DESC
LIMIT 1;
