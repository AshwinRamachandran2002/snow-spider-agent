```sql
--Description:  Find the five patents filed in the same year as US‑9741766‑B2 (i.e., 2016) that are
--              most similar in terms of Google‑generated text embeddings.  The query proceeds as:
--              (1)  Extract the focal patent’s embedding into a CTE (focal_vec) as (index, value).
--              (2)  Capture the focal filing year in a CTE (focal_year).
--              (3)  Select every other 2016 patent that has an embedding, explode that embedding
--                   (cand_vec) with FLATTEN, and align on coordinate index with focal_vec.
--              (4)  Compute the dot‑product similarity by summing aligned coordinate products.
--              (5)  Rank by similarity and return the top five publication numbers.
WITH focal_vec AS (
    SELECT
        f.index                    AS idx,
        f.value::FLOAT             AS val
    FROM "PATENTS_GOOGLE"."PATENTS_GOOGLE"."ABS_AND_EMB" AS foc,
         LATERAL FLATTEN(input => foc."embedding_v1")    AS f
    WHERE foc."publication_number" = 'US-9741766-B2'
),
focal_year AS (
    SELECT TO_NUMBER(SUBSTR("filing_date", 1, 4)) AS yr
    FROM "PATENTS_GOOGLE"."PATENTS_GOOGLE"."PUBLICATIONS"
    WHERE "publication_number" = 'US-9741766-B2'
    LIMIT 1
)
SELECT
    cand."publication_number"
FROM "PATENTS_GOOGLE"."PATENTS_GOOGLE"."ABS_AND_EMB"          AS cand
JOIN "PATENTS_GOOGLE"."PATENTS_GOOGLE"."PUBLICATIONS"         AS p
      ON p."publication_number" = cand."publication_number"
JOIN focal_year
      ON TO_NUMBER(SUBSTR(p."filing_date", 1, 4)) = focal_year.yr   -- same filing year
JOIN LATERAL FLATTEN(input => cand."embedding_v1")             AS cand_vec
      ON TRUE
JOIN focal_vec
      ON focal_vec.idx = cand_vec.index                        -- align coordinates
WHERE cand."publication_number" <> 'US-9741766-B2'             -- exclude focal patent
GROUP BY cand."publication_number"
ORDER BY SUM(focal_vec.val * cand_vec.value::FLOAT) DESC       -- dot‑product similarity
LIMIT 5;
