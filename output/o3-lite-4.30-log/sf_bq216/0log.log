```

```sql
-- 8. Description: compute dot‑product similarity between the focal patent and each same‑year patent
-- (Snowflake ≥6.0 supports array_dot); if not available, replace with manual sum over FLATTEN.
SELECT 
    cand."publication_number",
    ARRAY_DOT(focal."embedding_v1", cand."embedding_v1") AS "similarity_score"
FROM "PATENTS_GOOGLE"."PATENTS_GOOGLE"."ABS_AND_EMB" focal
JOIN "PATENTS_GOOGLE"."PATENTS_GOOGLE"."ABS_AND_EMB" cand   -- candidate patents
  ON TRUE
JOIN "PATENTS_GOOGLE"."PATENTS_GOOGLE"."PUBLICATIONS" p
  ON cand."publication_number" = p."publication_number"
JOIN ( SELECT TO_NUMBER(SUBSTR("filing_date",1,4)) AS "yr"
       FROM "PATENTS_GOOGLE"."PATENTS_GOOGLE"."PUBLICATIONS"
       WHERE "publication_number" = 'US-9741766-B2'
       LIMIT 1 ) yr_tbl
  ON TO_NUMBER(SUBSTR(p."filing_date",1,4)) = yr_tbl."yr"
WHERE focal."publication_number" = 'US-9741766-B2'
  AND cand."publication_number" <> 'US-9741766-B2'
LIMIT 20;
```

```sql
-- 9. Description: rank same‑year patents by similarity to focal, show top 20
SELECT 
    cand."publication_number",
    ARRAY_DOT(focal."embedding_v1", cand."embedding_v1") AS "similarity_score"
FROM "PATENTS_GOOGLE"."PATENTS_GOOGLE"."ABS_AND_EMB" focal
JOIN "PATENTS_GOOGLE"."PATENTS_GOOGLE"."ABS_AND_EMB" cand
  ON TRUE
JOIN "PATENTS_GOOGLE"."PATENTS_GOOGLE"."PUBLICATIONS" p
  ON cand."publication_number" = p."publication_number"
JOIN ( SELECT TO_NUMBER(SUBSTR("filing_date",1,4)) AS "yr"
       FROM "PATENTS_GOOGLE"."PATENTS_GOOGLE"."PUBLICATIONS"
       WHERE "publication_number" = 'US-9741766-B2'
       LIMIT 1 ) yr_tbl
  ON TO_NUMBER(SUBSTR(p."filing_date",1,4)) = yr_tbl."yr"
WHERE focal."publication_number" = 'US-9741766-B2'
  AND cand."publication_number" <> 'US-9741766-B2'
ORDER BY "similarity_score" DESC
LIMIT 20;
```

```sql
-- 10. Description: FINAL – return the five most‑similar patents (only publication numbers)
SELECT 
    cand."publication_number"
FROM "PATENTS_GOOGLE"."PATENTS_GOOGLE"."ABS_AND_EMB" focal
JOIN "PATENTS_GOOGLE"."PATENTS_GOOGLE"."ABS_AND_EMB" cand
  ON TRUE
JOIN "PATENTS_GOOGLE"."PATENTS_GOOGLE"."PUBLICATIONS" p
  ON cand."publication_number" = p."publication_number"
JOIN ( SELECT TO_NUMBER(SUBSTR("filing_date",1,4)) AS "yr"
       FROM "PATENTS_GOOGLE"."PATENTS_GOOGLE"."PUBLICATIONS"
       WHERE "publication_number" = 'US-9741766-B2'
       LIMIT 1 ) yr_tbl
  ON TO_NUMBER(SUBSTR(p."filing_date",1,4)) = yr_tbl."yr"
WHERE focal."publication_number" = 'US-9741766-B2'
  AND cand."publication_number" <> 'US-9741766-B2'
ORDER BY ARRAY_DOT(focal."embedding_v1", cand."embedding_v1") DESC
LIMIT 5;
```

