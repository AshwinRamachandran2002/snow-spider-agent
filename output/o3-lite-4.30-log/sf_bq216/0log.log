Query:
--Description:  Corrected version of “#9 – rank same‑year patents by similarity to focal, show top 20”.
--              Manually computes the dot‑product similarity (no ARRAY_DOT) between US‑9741766‑B2 and
--              every other 2016 patent with an embedding, then displays the 20 most‑similar records
--              along with their similarity scores.
WITH focal_vec AS (  -- explode focal embedding (index,value)
    SELECT
        f.index                 AS idx,
        f.value::FLOAT          AS val
    FROM "PATENTS_GOOGLE"."PATENTS_GOOGLE"."ABS_AND_EMB" fp,
         LATERAL FLATTEN(input => fp."embedding_v1") f
    WHERE fp."publication_number" = 'US-9741766-B2'
),
focal_year AS (      -- filing year of focal patent
    SELECT TO_NUMBER(SUBSTR("filing_date",1,4)) AS yr
    FROM "PATENTS_GOOGLE"."PATENTS_GOOGLE"."PUBLICATIONS"
    WHERE "publication_number" = 'US-9741766-B2'
    LIMIT 1
)
SELECT
    cand."publication_number",
    SUM(focal_vec.val * cand_val.value::FLOAT)  AS similarity_score
FROM "PATENTS_GOOGLE"."PATENTS_GOOGLE"."ABS_AND_EMB"        cand
CROSS JOIN LATERAL FLATTEN(input => cand."embedding_v1")     cand_val
JOIN focal_vec
      ON cand_val.index = focal_vec.idx                      -- align coordinates
JOIN "PATENTS_GOOGLE"."PATENTS_GOOGLE"."PUBLICATIONS"        p
      ON p."publication_number" = cand."publication_number"
JOIN focal_year
      ON TO_NUMBER(SUBSTR(p."filing_date",1,4)) = focal_year.yr
WHERE cand."publication_number" <> 'US-9741766-B2'
GROUP BY cand."publication_number"
ORDER BY similarity_score DESC
LIMIT 20
