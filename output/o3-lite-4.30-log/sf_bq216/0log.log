JOIN ( SELECT TO_NUMBER(SUBSTR("filing_date",1,4)) AS "yr"
       FROM "PATENTS_GOOGLE"."PATENTS_GOOGLE"."PUBLICATIONS"
       WHERE "publication_number" = 'US-9741766-B2'
       LIMIT 1 ) yr_tbl
  ON TO_NUMBER(SUBSTR(p."filing_date",1,4)) = yr_tbl."yr"
