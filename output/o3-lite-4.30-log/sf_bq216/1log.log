--Description:  #10 – Final query: return the five patents most similar to US‑9741766‑B2
--              whose derived year (filing or publication) equals the target patent’s
--              filing year (2016).
WITH target AS (
    SELECT '2016' AS yr            -- filing year of US‑9741766‑B2
), sim AS (
    SELECT DISTINCT
           f.value:"publication_number"::STRING  AS similar_pub,
           COALESCE(f.value:"score"::FLOAT, 0)   AS similarity_score
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB t,
         LATERAL FLATTEN(input => t."similar") f
    WHERE t."publication_number" = 'US-9741766-B2'
)
SELECT 
       s.similar_pub      AS publication_number,
       s.similarity_score
FROM   sim s
JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
