```sql
--Description:  Goal ‑ list the five patents from 2016 that are closest in technology
--              to US‑9741766‑B2.  “Closeness” is defined as sharing the greatest
--              number of identical 4‑digit IPC codes (IPC4) with the target patent.
--              Logic:
--              1) Pull the target patent’s distinct IPC4 codes (target_ipc4 CTE).
--              2) Gather every other patent whose filing OR publication year is 2016
--                 and extract their IPC4 codes (candidate_ipc4 CTE).
--              3) Join the two sets on IPC4, count overlaps for each candidate, and
--                 rank by the overlap count to surface the top five most‑similar
--                 patents.
WITH target_ipc4 AS (                      -- Step 1: IPC4s for US‑9741766‑B2
    SELECT DISTINCT
           SUBSTR(ipc_t.value:"code"::STRING, 1, 4) AS ipc4
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."ipc") ipc_t
    WHERE t."publication_number" = 'US-9741766-B2'
),
candidate_ipc4 AS (                         -- Step 2: IPC4s for all 2016 patents
    SELECT
           p."publication_number",
           SUBSTR(ipc_c.value:"code"::STRING, 1, 4) AS ipc4
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."ipc") ipc_c
    WHERE COALESCE(LEFT(TO_VARCHAR(p."filing_date"), 4),
                   LEFT(TO_VARCHAR(p."publication_date"), 4)) = '2016'
      AND p."publication_number" <> 'US-9741766-B2'
)
SELECT
       c."publication_number",
       COUNT(*) AS shared_ipc4_count              -- Step 3: overlap size
FROM   candidate_ipc4 c
JOIN   target_ipc4   t
       ON c.ipc4 = t.ipc4
GROUP  BY c."publication_number"
ORDER  BY shared_ipc4_count DESC,                -- most overlap first
          c."publication_number"                 -- tie‑break
LIMIT 5;
```
