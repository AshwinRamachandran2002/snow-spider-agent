```sql
--Description:  Diagnostic step: list up to 50 patents that Google’s embedding model
--              marks as “similar” to US‑9741766‑B2, along with their similarity
--              scores and whichever year (filing or publication) is available.
--              No year filter is applied so we can first observe which years are
--              actually present among the similar patents; this will help decide
--              whether or how to re‑introduce a same‑year restriction later.
WITH similar_patents AS (                                  -- pull distinct similar pubs
    SELECT DISTINCT
           f.value:"publication_number"::STRING  AS pub_num,
           COALESCE(f.value:"score"::FLOAT, 0)   AS sim_score
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB t,
         LATERAL FLATTEN(input => t."similar") f
    WHERE t."publication_number" = 'US-9741766-B2'
)
SELECT
       sp.pub_num                       AS "publication_number",
       sp.sim_score                     AS "similarity_score",
       LEFT(TO_VARCHAR(p."filing_date"),4)       AS "filing_year",
       LEFT(TO_VARCHAR(p."publication_date"),4)  AS "publication_year"
FROM   similar_patents  sp
LEFT JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
       ON sp.pub_num = p."publication_number"
ORDER  BY sp.sim_score DESC NULLS LAST
LIMIT 50;
