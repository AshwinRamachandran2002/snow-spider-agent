```sql
--Description:  Starting from the vector‑based “similar” list stored for US‑9741766‑B2,
--              this query (i) extracts each candidate publication number and its
--              similarity score, (ii) joins to PUBLICATIONS to obtain bibliographic
--              dates, (iii) derives a usable year as the first four digits of
--              filing_date (if present) otherwise publication_date, (iv) keeps only
--              those whose derived year equals the target patent’s filing year
--              (2016), and (v) returns the five most‑similar patents from that cohort.
WITH target_year AS (           -- filing year of US‑9741766‑B2
    SELECT '2016' AS yr         -- looked up once (20160511 → 2016)
), sim AS (                     -- list of patents Google’s model deems similar
    SELECT DISTINCT
        f.value:"publication_number"::STRING AS similar_pub,
        COALESCE(f.value:"score"::FLOAT, 0)  AS similarity_score
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB t,
         LATERAL FLATTEN(input => t."similar") f
    WHERE t."publication_number" = 'US-9741766-B2'
)
SELECT
    s.similar_pub        AS "publication_number",
    s.similarity_score   AS "similarity_score"
FROM  sim s
JOIN  PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
      ON s.similar_pub = p."publication_number"
JOIN  target_year ty
      ON COALESCE(LEFT(TO_VARCHAR(p."filing_date"),4),
                  LEFT(TO_VARCHAR(p."publication_date"),4)) = ty.yr
ORDER BY s.similarity_score DESC
LIMIT 5;
