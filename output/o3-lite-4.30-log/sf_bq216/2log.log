```sql
--Description:  Identify the five patents filed in 2016 that are most technologically similar to
--              US‑9741766‑B2.  The cosine‑similarity is calculated manually because Snowflake
--              lacks a built‑in vector dot‑product.  Steps
--              ①  focal_year  – retrieve the filing year (2016).
--              ②  focal_emb   – flatten the focal embedding into (idx , value) rows.
--              ③  focal_norm  – pre‑compute the focal vector’s Euclidean norm.
--              ④  peer_emb    – flatten every 2016 peer’s embedding in the same way.
--              ⑤  similarity  – join on the index, aggregate Σ f_i·p_i, Σ p_i², then
--                                cosine = dot / (‖f‖ · ‖p‖).  Return the five highest scores.
WITH focal_year AS (                             -- ①
    SELECT FLOOR("filing_date" / 10000) AS yr
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE  "publication_number" = 'US-9741766-B2'
),
focal_emb AS (                                   -- ②
    SELECT f.index AS idx,
           f.value::FLOAT AS f_val
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB ae,
           LATERAL FLATTEN(input => ae."embedding_v1") f
    WHERE  ae."publication_number" = 'US-9741766-B2'
),
focal_norm AS (                                  -- ③
    SELECT SQRT(SUM(POWER(f_val, 2))) AS f_norm
    FROM   focal_emb
),
peer_emb AS (                                    -- ④
    SELECT p."publication_number",
           fv.index  AS idx,
           fv.value::FLOAT AS p_val
    FROM   focal_year  y
    JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
           ON FLOOR(p."filing_date" / 10000) = y.yr
    JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB   e
           ON e."publication_number" = p."publication_number"
           , LATERAL FLATTEN(input => e."embedding_v1") fv
    WHERE  p."publication_number" <> 'US-9741766-B2'
),
similarity AS (                                  -- ⑤
    SELECT  pe."publication_number",
            SUM(fe.f_val * pe.p_val)                               AS dot_prod,
            SUM(POWER(pe.p_val , 2))                               AS p_sq_sum
    FROM    peer_emb  pe
    JOIN    focal_emb fe
            ON fe.idx = pe.idx             -- element-wise multiplication
    GROUP BY pe."publication_number"
)
SELECT  s."publication_number"
FROM    similarity s
CROSS   JOIN focal_norm fn
ORDER BY  s.dot_prod / ( fn.f_norm * SQRT(s.p_sq_sum) ) DESC
LIMIT 5;
```
