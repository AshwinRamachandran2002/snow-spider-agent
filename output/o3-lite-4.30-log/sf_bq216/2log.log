Ten step‑by‑step Snowflake SQL queries (each returns ≤ 20 rows)

```sql
--Description: ① Inspect the PUBLICATIONS row of the focal patent
SELECT *
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
WHERE "publication_number" = 'US-9741766-B2'
LIMIT 20;
```

```sql
--Description: ② Show only a few key dates for the focal patent
SELECT "publication_number",
       "filing_date",
       "publication_date",
       FLOOR("filing_date"/10000) AS "file_year"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
WHERE "publication_number" = 'US-9741766-B2'
LIMIT 20;
```

```sql
--Description: ③ Fetch the embedding vector for the focal patent
SELECT "publication_number",
       "embedding_v1"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB
WHERE "publication_number" = 'US-9741766-B2'
LIMIT 20;
```

```sql
--Description: ④ List all patents filed in the same year as the focal patent
WITH tgt AS (
  SELECT FLOOR("filing_date"/10000) AS "the_year"
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
  WHERE "publication_number" = 'US-9741766-B2'
)
SELECT p."publication_number",
       p."filing_date"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p, tgt
WHERE FLOOR(p."filing_date"/10000) = tgt."the_year"
LIMIT 20;
```

```sql
--Description: ⑤ Check how many of those same‑year patents have embeddings
WITH tgt AS (
  SELECT FLOOR("filing_date"/10000) AS "the_year"
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
  WHERE "publication_number" = 'US-9741766-B2'
)
SELECT COUNT(*) AS "with_embeddings"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB e
  ON p."publication_number" = e."publication_number",
tgt
WHERE FLOOR(p."filing_date"/10000) = tgt."the_year";
```

```sql
--Description: ⑥ Quickly preview 20 embeddings of random same‑year peers
WITH tgt AS (
  SELECT FLOOR("filing_date"/10000) AS "the_year"
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
  WHERE "publication_number" = 'US-9741766-B2'
)
SELECT e."publication_number", e."embedding_v1"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB e
  ON p."publication_number" = e."publication_number",
tgt
WHERE FLOOR(p."filing_date"/10000) = tgt."the_year"
LIMIT 20;
```

```sql
--Description: ⑦ Compute similarity score between focal patent and 20 peers
WITH focal AS (
  SELECT "embedding_v1" AS "vec"
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB
  WHERE "publication_number" = 'US-9741766-B2'
), tgt_year AS (
  SELECT FLOOR("filing_date"/10000) AS "the_year"
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
  WHERE "publication_number" = 'US-9741766-B2'
)
SELECT e2."publication_number",
       DOT_PRODUCT(f."vec", e2."embedding_v1") AS "similarity"
FROM focal f,
     tgt_year y
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p2
  ON FLOOR(p2."filing_date"/10000)=y."the_year"
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB e2
  ON e2."publication_number"=p2."publication_number"
ORDER BY "similarity" DESC
LIMIT 20;
```

```sql
--Description: ⑧ Same as ⑦ but exclude the focal patent itself
WITH focal AS (
  SELECT "embedding_v1" AS "vec"
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB
  WHERE "publication_number" = 'US-9741766-B2'
), tgt_year AS (
  SELECT FLOOR("filing_date"/10000) AS "the_year"
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
  WHERE "publication_number" = 'US-9741766-B2'
)
SELECT e2."publication_number",
       DOT_PRODUCT(f."vec", e2."embedding_v1") AS "similarity"
FROM focal f,
     tgt_year y
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p2
  ON FLOOR(p2."filing_date"/10000)=y."the_year"
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB e2
  ON e2."publication_number"=p2."publication_number"
WHERE e2."publication_number" <> 'US-9741766-B2'
ORDER BY "similarity" DESC
LIMIT 20;
```

```sql
--Description: ⑨ Pull the top 5 most similar same‑year patents
WITH focal AS (
  SELECT "embedding_v1" AS "vec"
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB
  WHERE "publication_number" = 'US-9741766-B2'
), tgt_year AS (
  SELECT FLOOR("filing_date"/10000) AS "the_year"
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
  WHERE "publication_number" = 'US-9741766-B2'
)
SELECT e2."publication_number"
FROM focal f,
     tgt_year y
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p2
  ON FLOOR(p2."filing_date"/10000)=y."the_year"
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB e2
  ON e2."publication_number"=p2."publication_number"
WHERE e2."publication_number" <> 'US-9741766-B2'
ORDER BY DOT_PRODUCT(f."vec", e2."embedding_v1") DESC
LIMIT 5;
```

```sql
--Description: ⑩ For interpretability: show titles of those five most‑similar patents
WITH top5 AS (
  /* re‑use query ⑨ */
  WITH focal AS (
    SELECT "embedding_v1" AS "vec"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB
    WHERE "publication_number" = 'US-9741766-B2'
  ), tgt_year AS (
    SELECT FLOOR("filing_date"/10000) AS "the_year"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE "publication_number" = 'US-9741766-B2'
  )
  SELECT e2."publication_number"
  FROM focal f,
       tgt_year y
  JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p2
    ON FLOOR(p2."filing_date"/10000)=y."the_year"
  JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB e2
    ON e2."publication_number"=p2."publication_number"
  WHERE e2."publication_number" <> 'US-9741766-B2'
  ORDER BY DOT_PRODUCT(f."vec", e2."embedding_v1") DESC
  LIMIT 5
)
SELECT p."publication_number",
       tl.value::VARIANT:"text"::STRING AS "title_en"
FROM top5 t
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
  ON t."publication_number" = p."publication_number",
LATERAL FLATTEN(input => p."title_localized") tl
WHERE tl.value::VARIANT:"language"::STRING = 'en'
LIMIT 20;
```

These ten queries progress from inspecting the focal patent to computing embedding‑based similarity and finally retrieving the top five most similar same‑year patents.
