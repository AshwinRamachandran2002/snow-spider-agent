```sql
SELECT
    division,
    ROUND(AVG(total_qty), 4) AS average_quantity_sold
FROM (
    /* aggregate 2021 total quantity per product within each division */
    SELECT
        p.division,
        h.product_code,
        SUM(h.sold_quantity) AS total_qty
    FROM hardware_fact_sales_monthly AS h
    JOIN hardware_dim_product        AS p
      ON p.product_code = h.product_code
    WHERE h.date BETWEEN '2021-01-01' AND '2021-12-31'
    GROUP BY p.division, h.product_code
) AS prod_totals
/* rank products by total quantity inside each division */
JOIN (
    SELECT
        division,
        product_code,
        RANK() OVER (PARTITION BY division ORDER BY total_qty DESC) AS rnk
    FROM (
        SELECT
            p.division,
            h.product_code,
            SUM(h.sold_quantity) AS total_qty
        FROM hardware_fact_sales_monthly AS h
        JOIN hardware_dim_product        AS p
          ON p.product_code = h.product_code
        WHERE h.date BETWEEN '2021-01-01' AND '2021-12-31'
        GROUP BY p.division, h.product_code
    )
) AS ranking
  ON prod_totals.division = ranking.division
 AND prod_totals.product_code = ranking.product_code
WHERE ranking.rnk <= 3          -- keep only top 3 products per division
GROUP BY division;
```
