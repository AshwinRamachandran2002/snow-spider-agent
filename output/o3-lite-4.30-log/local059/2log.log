--Description: FINAL ANSWER – Overall average quantity sold of the top three
--             best‑selling hardware products (by total 2021 quantity) in each
--             division, rounded to two decimals.
WITH product_totals AS (
    SELECT p.division,
           s.product_code,
           SUM(s.sold_quantity) AS total_qty_2021
    FROM hardware_fact_sales_monthly AS s
    JOIN hardware_dim_product        AS p
      ON s.product_code = p.product_code
    WHERE strftime('%Y', s.date) = '2021'
    GROUP BY p.division, s.product_code
),
ranked AS (
    SELECT division,
           product_code,
           total_qty_2021,
           ROW_NUMBER() OVER (PARTITION BY division ORDER BY total_qty_2021 DESC) AS rnk
    FROM product_totals
)
SELECT division,
       ROUND(AVG(total_qty_2021), 2) AS avg_qty_top3_products_2021
FROM ranked
WHERE rnk <= 3
GROUP BY division
ORDER BY division
