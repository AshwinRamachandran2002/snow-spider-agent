```sql
--Description / Thinking process:
-- Goal: “overall average quantity sold of the top three best‑selling hardware
--        products (by total quantity sold) in each division” for calendar‑year 2021.
--
-- Steps
-- 1. Filter the fact table to rows whose calendar year (strftime('%Y', date)) = 2021.
-- 2. Join each sales row (s) to the product dimension (p) to pull in the division.
-- 3. Aggregate sold_quantity per (division, product_code) to obtain each product’s
--    total 2021 volume  ➜ CTE product_totals.
-- 4. Within every division, rank products by that volume descending
--    using ROW_NUMBER()  ➜ CTE ranked.
-- 5. Keep only the top 3 (rnk ≤ 3) per division.
-- 6. For those three products in a division, take the AVG of their total quantities
--    (AVG(total_qty_2021)) to get the requested “overall average quantity sold”.
-- 7. Present division + rounded average.
WITH product_totals AS (
    SELECT
        p.division,
        s.product_code,
        SUM(s.sold_quantity) AS total_qty_2021
    FROM hardware_fact_sales_monthly AS s
    JOIN hardware_dim_product        AS p
      ON s.product_code = p.product_code
    WHERE strftime('%Y', s.date) = '2021'          -- calendar year filter
    GROUP BY p.division, s.product_code
),
ranked AS (
    SELECT
        division,
        product_code,
        total_qty_2021,
        ROW_NUMBER() OVER (
            PARTITION BY division
            ORDER BY total_qty_2021 DESC
        ) AS rnk
    FROM product_totals
)
SELECT
    division,
    ROUND(AVG(total_qty_2021), 2) AS avg_qty_top3_products_2021
FROM ranked
WHERE rnk <= 3
GROUP BY division
ORDER BY division;
```
