--Description:
-- One‑shot summary of the question we keep probing:
-- “For every imaging assay type that has Level‑2 data at HTAN WUSTL,
--  do any Level‑3 segmentation files and/or Level‑4 imaging files exist
--  that declare those Level‑2 files as their parent?”
--
-- Strategy
--   1.  Start with Level‑2 imaging metadata (alias l2) filtered to
--       HTAN_Center = 'HTAN WUSTL' and excluding Electron Microscopy.
--   2.  LEFT JOIN to Level‑3 segmentation metadata (l3) on
--         l3.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
--       to capture Level‑3 children.
--   3.  LEFT JOIN to Level‑4 imaging metadata (l4) on
--         l4.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
--       to capture Level‑4 children.
--   4.  Aggregate by l2.Imaging_Assay_Type and count distinct child files.
--   5.  Report three columns:
--         • imaging_assay_type
--         • n_level3_segmentation_files
--         • n_level4_imaging_files
--   6.  If both counts are zero for an assay type, that means WUSTL
--       currently has no Level‑3 or Level‑4 imaging data derived directly
--       from its Level‑2 files for that assay in revision 5.
SELECT
  l2.Imaging_Assay_Type                                   AS imaging_assay_type,
  COUNT(DISTINCT l3.entityId)                             AS n_level3_segmentation_files,
  COUNT(DISTINCT l4.entityId)                             AS n_level4_imaging_files
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`              AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5` AS l3
       ON l3.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
LEFT JOIN `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5`         AS l4
       ON l4.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
WHERE l2.HTAN_Center = 'HTAN WUSTL'
  AND LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron%'
GROUP BY imaging_assay_type
ORDER BY imaging_assay_type;
```
