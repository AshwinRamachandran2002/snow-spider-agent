```

```sql
--Description:
-- 10. FINAL aggregation: for every WUSTL imaging assay type that has Level‑2
--     data, indicate whether Level‑3 segmentation and/or Level‑4 imaging data
--     exist that declare the Level‑2 files as their parent.  Boolean flags
--     are derived from the presence of at least one child file in each level.
SELECT
  l2.Imaging_Assay_Type                                                AS imaging_assay_type,
  TRUE                                                                 AS has_level2,
  MAX(CASE WHEN l3.entityId IS NOT NULL THEN 1 ELSE 0 END) > 0         AS has_level3,
  MAX(CASE WHEN l4.entityId IS NOT NULL THEN 1 ELSE 0 END) > 0         AS has_level4
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`              AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5` AS l3
       ON l3.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
LEFT JOIN `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5`         AS l4
       ON l4.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
WHERE l2.HTAN_Center = 'HTAN WUSTL'
  AND LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron%'
  AND l2.Component IS NOT NULL
  AND LOWER(l2.Component) NOT LIKE '%auxiliary%'
  AND LOWER(l2.Component) NOT LIKE '%otherassay%'
GROUP BY imaging_assay_type
LIMIT 20;
```
