JOIN `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`  AS l2  -- parent L2 files
  ON p.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
WHERE l2.HTAN_Center = 'HTAN WUSTL'
  AND p.Component LIKE '%Level3%'
LIMIT 20;
