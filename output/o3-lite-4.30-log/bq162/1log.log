--   4) Return distinct combinations of the parent imaging assay type and
--      the Level‑3 component so we can see which assay types (IMC, CODEX,
--      H&E) have Level‑3 derivatives, if any.
SELECT DISTINCT
       l2.Imaging_Assay_Type    AS parent_assay_type,
       p.Component              AS child_level3_component,
       p.entityId               AS child_entityId,
       l2.HTAN_Data_File_ID     AS parent_lvl2_id
