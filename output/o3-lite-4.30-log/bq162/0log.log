--Description: 8)  Using the provenance table, count Level‑3 segmentation files that
--              can be traced back to WUSTL Level‑2 imaging files.  A LEFT JOIN keeps
--              all assay types visible even when the count is zero.
SELECT
  l2.Imaging_Assay_Type,
  COUNT(DISTINCT p_child.HTAN_Data_File_ID) AS level3_file_count_via_provenance
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`      AS p_child
  ON p_child.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
 AND p_child.Component = 'ImagingLevel3Segmentation'
WHERE l2.HTAN_Center = 'HTAN WUSTL'
GROUP BY l2.Imaging_Assay_Type
ORDER BY l2.Imaging_Assay_Type
