--Description: 8)  Using the provenance table, confirm Level‑3 derivations from HTAN WUSTL
--              Level‑2 files.  Each row shows assay type, Level‑3 component label, and ID.
SELECT DISTINCT
       l2.Imaging_Assay_Type,
       p_child.Component         AS level3_component,
