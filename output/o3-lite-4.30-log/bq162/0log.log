```sql
--Description: 9)  Using the provenance table, confirm Level‑4 derivations from HTAN WUSTL
--              Level‑2 files.  Each row shows assay type, Level‑4 component label, and ID.
SELECT DISTINCT
       l2.Imaging_Assay_Type,
       p_child.Component         AS level4_component,
       p_child.HTAN_Data_File_ID AS level4_id
FROM  `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN  `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS p_parent
      ON p_parent.entityId = l2.entityId
JOIN  `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS p_child
      ON p_child.HTAN_Parent_Data_File_ID = p_parent.HTAN_Data_File_ID
WHERE l2.HTAN_Center = 'HTAN WUSTL'
  AND p_child.Component = 'ImagingLevel4'
  AND LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron microscopy%'
LIMIT 20;
```

```sql
--Description: 10)  Final summary for HTAN WUSTL—per imaging assay type, indicate whether
--               Level‑2, Level‑3, and/or Level‑4 data are present.  Uses EXISTS checks for
--               higher levels and groups by assay type for a concise report.
WITH wustl_l2 AS (
  SELECT DISTINCT Imaging_Assay_Type, HTAN_Data_File_ID
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE HTAN_Center = 'HTAN WUSTL'
    AND LOWER(Imaging_Assay_Type) NOT LIKE '%electron microscopy%'
)
SELECT
  Imaging_Assay_Type,
  'Level2'                                        AS Level2_available,
  IF (EXISTS (
        SELECT 1 FROM `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5` AS l3
        WHERE l3.HTAN_Parent_Data_File_ID = wustl_l2.HTAN_Data_File_ID
      ), 'Level3', NULL)                          AS Level3_available,
  IF (EXISTS (
        SELECT 1 FROM `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5` AS l4
        WHERE l4.HTAN_Parent_Data_File_ID = wustl_l2.HTAN_Data_File_ID
      ), 'Level4', NULL)                          AS Level4_available
FROM wustl_l2
GROUP BY Imaging_Assay_Type, Level2_available, Level3_available, Level4_available
ORDER BY Imaging_Assay_Type
LIMIT 20;
```
