Begin Exploring Related Columns
Relevant columns and their potential use  
• `imaging_level2_metadata_r5.HTAN_Center` – restrict to “HTAN WUSTL”  
• `imaging_level2_metadata_r5.Imaging_Assay_Type` – imaging assay type to be returned  
• `imaging_level2_metadata_r5.HTAN_Data_File_ID / entityId` – keys that identify each Level 2 file  
• `id_provenance_r5.entityId` – connect every file (all levels) to its provenance record  
• `id_provenance_r5.Component` – tells whether a row represents ImagingLevel2, ImagingLevel3Segmentation, ImagingLevel4, etc.; filter out NULL, “Auxiliary%”, “OtherAssay%”  
• `id_provenance_r5.HTAN_Parent_Data_File_ID` – used to link Level 3 / Level 4 provenance rows back to the Level 2 file from which they were derived  
• `imaging_level3_segmentation_metadata_r5.HTAN_Data_File_ID / entityId / HTAN_Parent_Data_File_ID` – Level 3 segmentation metadata; join to provenance to verify relationship  
• `imaging_level4_metadata_r5.HTAN_Parent_Data_File_ID` – Level 4 feature‑matrix metadata; join likewise  
• `imaging_level3_segmentation_metadata_r5.Component` and `imaging_level4_metadata_r5.Component` – confirm correct component name and allow the same exclusion rule  
• (All tables) `File_Format`, `Filename`, etc. – optional inspection / debugging  

Conditions that will be used  
1. `HTAN_Center = 'HTAN WUSTL'`  
2. `LOWER(Imaging_Assay_Type) NOT LIKE '%electron microscopy%'`  
3. `Component IS NOT NULL AND LOWER(Component) NOT LIKE '%auxiliary%' AND LOWER(Component) NOT LIKE '%otherassay%'`  

------------------------------------------------------------------
Below are ten exploratory BigQuery SQL statements (each capped with `LIMIT 20`) progressing from simple inspection to the final aggregation that satisfies the task statement.  
------------------------------------------------------------------

```sql
-- 1) Preview WUSTL Level‑2 imaging rows
SELECT *
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE HTAN_Center = 'HTAN WUSTL'
  AND LOWER(Imaging_Assay_Type) NOT LIKE '%electron microscopy%'
LIMIT 20;
```

```sql
-- 2) Distinct imaging assay types at HTAN WUSTL (Level‑2 only)
SELECT DISTINCT Imaging_Assay_Type
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE HTAN_Center = 'HTAN WUSTL'
  AND LOWER(Imaging_Assay_Type) NOT LIKE '%electron microscopy%'
LIMIT 20;
```

```sql
-- 3) Join Level‑2 rows to their provenance records
SELECT l2.Imaging_Assay_Type,
       l2.HTAN_Data_File_ID AS level2_file_id,
       p.Component AS provenance_component
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`             AS p
  ON p.entityId = l2.entityId
WHERE l2.HTAN_Center = 'HTAN WUSTL'
  AND LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron microscopy%'
  AND p.Component IS NOT NULL
  AND LOWER(p.Component) NOT LIKE '%auxiliary%'
  AND LOWER(p.Component) NOT LIKE '%otherassay%'
LIMIT 20;
```

```sql
-- 4) Level‑3 segmentation files derived from WUSTL Level‑2 files
SELECT DISTINCT l2.Imaging_Assay_Type,
       l2.HTAN_Data_File_ID AS level2_id,
       l3.HTAN_Data_File_ID AS level3_id
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`     AS l2
JOIN `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5` AS l3
  ON l3.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
WHERE l2.HTAN_Center = 'HTAN WUSTL'
  AND LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron microscopy%'
LIMIT 20;
```

```sql
-- 5) Level‑4 feature‑matrix files derived from WUSTL Level‑2 files
SELECT DISTINCT l2.Imaging_Assay_Type,
       l2.HTAN_Data_File_ID AS level2_id,
       l4.HTAN_Data_File_ID AS level4_id
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5` AS l4
  ON l4.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
WHERE l2.HTAN_Center = 'HTAN WUSTL'
  AND LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron microscopy%'
LIMIT 20;
```

```sql
-- 6) Which assay types have Level‑3 data?
SELECT DISTINCT l2.Imaging_Assay_Type
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`     AS l2
JOIN `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5` AS l3
  ON l3.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
WHERE l2.HTAN_Center = 'HTAN WUSTL'
  AND LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron microscopy%'
LIMIT 20;
```

```sql
-- 7) Which assay types have Level‑4 data?
SELECT DISTINCT l2.Imaging_Assay_Type
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5` AS l4
  ON l4.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
WHERE l2.HTAN_Center = 'HTAN WUSTL'
  AND LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron microscopy%'
LIMIT 20;
```

```sql
-- 8) Use provenance to verify Level‑3 derivation (entityId path)
SELECT l2.Imaging_Assay_Type,
       p3.Component           AS level3_component,
       p3.HTAN_Data_File_ID   AS level3_id
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS p2
  ON p2.entityId = l2.entityId                               -- provenance row for Level‑2
JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS p3
  ON p3.HTAN_Parent_Data_File_ID = p2.HTAN_Data_File_ID      -- children rows
WHERE l2.HTAN_Center = 'HTAN WUSTL'
  AND p3.Component = 'ImagingLevel3Segmentation'
  AND LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron microscopy%'
LIMIT 20;
```

```sql
-- 9) Use provenance to verify Level‑4 derivation
SELECT l2.Imaging_Assay_Type,
       p4.Component           AS level4_component,
       p4.HTAN_Data_File_ID   AS level4_id
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS p2
  ON p2.entityId = l2.entityId
JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS p4
  ON p4.HTAN_Parent_Data_File_ID = p2.HTAN_Data_File_ID
WHERE l2.HTAN_Center = 'HTAN WUSTL'
  AND p4.Component = 'ImagingLevel4'
  AND LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron microscopy%'
LIMIT 20;
```

```sql
-- 10) FINAL QUERY: imaging assay types at HTAN WUSTL with the list of data levels available (L2, L3, L4)
WITH wustl_l2 AS (
  SELECT Imaging_Assay_Type,
         HTAN_Data_File_ID
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE HTAN_Center = 'HTAN WUSTL'
    AND LOWER(Imaging_Assay_Type) NOT LIKE '%electron microscopy%'
),
l3_exists AS (
  SELECT DISTINCT HTAN_Parent_Data_File_ID
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5`
),
l4_exists AS (
  SELECT DISTINCT HTAN_Parent_Data_File_ID
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5`
)
SELECT Imaging_Assay_Type,
       'Level2'                                          AS Level2,
       IF(HTAN_Data_File_ID IN (SELECT * FROM l3_exists), 'Level3', NULL) AS Level3,
       IF(HTAN_Data_File_ID IN (SELECT * FROM l4_exists), 'Level4', NULL) AS Level4
FROM wustl_l2
GROUP BY Imaging_Assay_Type, Level2, Level3, Level4
ORDER BY Imaging_Assay_Type
LIMIT 20;
```

Each SQL snippet is limited to 20 rows for safe exploration; remove or raise the LIMIT when running a production query.
