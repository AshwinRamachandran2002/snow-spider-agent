--Description: 6)  For each imaging assay type produced by the HTAN WUSTL center,
--              count how many Level‑3 segmentation files reference those Level‑2
--              files as their parent.  Counts may be zero, which makes the result
--              informative even when no Level‑3 data exist.
SELECT
  l2.Imaging_Assay_Type,
  COUNT(DISTINCT l3.HTAN_Data_File_ID) AS level3_file_count
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`            AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5` AS l3
  ON l3.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
WHERE l2.HTAN_Center = 'HTAN WUSTL'
GROUP BY l2.Imaging_Assay_Type
ORDER BY l2.Imaging_Assay_Type
