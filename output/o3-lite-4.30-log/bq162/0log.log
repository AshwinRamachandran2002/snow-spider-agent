WITH l2_filtered AS (
  SELECT
    l2.Imaging_Assay_Type,
    l2.HTAN_Data_File_ID
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5` AS p2
