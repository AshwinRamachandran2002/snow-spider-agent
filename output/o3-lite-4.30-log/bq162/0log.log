```sql
--Description: 6)  For each imaging assay type produced by the HTAN WUSTL center,
--              count how many Level‑3 segmentation files reference those Level‑2
--              files as their parent.  Counts may be zero, which makes the result
--              informative even when no Level‑3 data exist.
SELECT
  l2.Imaging_Assay_Type,
  COUNT(DISTINCT l3.HTAN_Data_File_ID) AS level3_file_count
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`            AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5` AS l3
  ON l3.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
WHERE l2.HTAN_Center = 'HTAN WUSTL'
GROUP BY l2.Imaging_Assay_Type
ORDER BY l2.Imaging_Assay_Type;
```

```sql
--Description: 7)  For each imaging assay type at HTAN WUSTL, count the number of
--              Level‑4 feature‑matrix files derived from its Level‑2 data.  This
--              mirrors the corrected strategy used in query 5.
SELECT
  l2.Imaging_Assay_Type,
  COUNT(DISTINCT l4.HTAN_Data_File_ID) AS level4_file_count
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`        AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5`   AS l4
  ON l4.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
WHERE l2.HTAN_Center = 'HTAN WUSTL'
GROUP BY l2.Imaging_Assay_Type
ORDER BY l2.Imaging_Assay_Type;
```

```sql
--Description: 8)  Using the provenance table, count Level‑3 segmentation files that
--              can be traced back to WUSTL Level‑2 imaging files.  A LEFT JOIN keeps
--              all assay types visible even when the count is zero.
SELECT
  l2.Imaging_Assay_Type,
  COUNT(DISTINCT p_child.HTAN_Data_File_ID) AS level3_file_count_via_provenance
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`      AS p_child
  ON p_child.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
 AND p_child.Component = 'ImagingLevel3Segmentation'
WHERE l2.HTAN_Center = 'HTAN WUSTL'
GROUP BY l2.Imaging_Assay_Type
ORDER BY l2.Imaging_Assay_Type;
```

```sql
--Description: 9)  Using the same provenance logic, count Level‑4 feature files that
--              originate from WUSTL Level‑2 imaging data.  Zero counts indicate no
--              Level‑4 derivations exist.
SELECT
  l2.Imaging_Assay_Type,
  COUNT(DISTINCT p_child.HTAN_Data_File_ID) AS level4_file_count_via_provenance
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`      AS p_child
  ON p_child.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
 AND p_child.Component = 'ImagingLevel4'
WHERE l2.HTAN_Center = 'HTAN WUSTL'
GROUP BY l2.Imaging_Assay_Type
ORDER BY l2.Imaging_Assay_Type;
```

```sql
--Description: 10)  Final summary for HTAN WUSTL.  For each assay type, indicate
--               whether Level‑2, Level‑3, and/or Level‑4 data are present by
--               checking for parent‑child relationships to the higher‑level tables.
WITH wustl_l2 AS (
  SELECT DISTINCT Imaging_Assay_Type, HTAN_Data_File_ID
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE HTAN_Center = 'HTAN WUSTL'
)
SELECT
  Imaging_Assay_Type,
  'Level2'                                        AS Level2_available,
  IF (EXISTS (
        SELECT 1
        FROM `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5` AS l3
        WHERE l3.HTAN_Parent_Data_File_ID = wustl_l2.HTAN_Data_File_ID
      ), 'Level3', NULL)                         AS Level3_available,
  IF (EXISTS (
        SELECT 1
        FROM `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5` AS l4
        WHERE l4.HTAN_Parent_Data_File_ID = wustl_l2.HTAN_Data_File_ID
      ), 'Level4', NULL)                         AS Level4_available
FROM wustl_l2
GROUP BY Imaging_Assay_Type, Level2_available, Level3_available, Level4_available
ORDER BY Imaging_Assay_Type;
```
