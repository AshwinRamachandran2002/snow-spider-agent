--HTAN WUSTL center (id_provenance_r5) to see which assay types have Level‑4
--data.  This will reveal whether any of them are imaging‑related.
SELECT
  Component,
  COUNT(*) AS n_files
FROM `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE HTAN_Center = 'HTAN WUSTL'
  AND LOWER(Component) LIKE '%level4%'
GROUP BY Component
ORDER BY n_files DESC
LIMIT 50;
```
