Begin Exploring Related Columns
Relevant tables and columns for this task  

imaging_level2_metadata_r5  
• HTAN_Center – filter to “HTAN WUSTL”  
• Imaging_Assay_Type – the assay that produced the Level‑2 image  
• HTAN_Data_File_ID – unique HTAN identifier for the file (used in provenance joins)  
• entityId – Synapse ID (join key to id_provenance)  
• Component – must not be NULL and must not contain “Auxiliary” or “OtherAssay”  

imaging_level3_segmentation_metadata_r5  
• HTAN_Parent_Data_File_ID – points to the HTAN_Data_File_ID of the source Level‑2 file  
• HTAN_Center, Component, entityId – same usage as above  

imaging_level4_metadata_r5  
• HTAN_Parent_Data_File_ID – points to the Level‑3 (or occasionally Level‑2) HTAN_Data_File_ID  
• HTAN_Center, Component, entityId – same usage as above  

id_provenance_r5  
• entityId – join key linking any file back to its HTAN_* IDs and parents  
• Component – tells us which “level” this file belongs to  
• HTAN_Data_File_ID – file’s own HTAN ID  
• HTAN_Parent_Data_File_ID – HTAN ID of the file it was derived from  

Typical filters / conditions  
• HTAN_Center = 'HTAN WUSTL'  
• LOWER(Component) NOT LIKE '%auxiliary%' AND LOWER(Component) NOT LIKE '%otherassay%' AND Component IS NOT NULL  
• Imaging_Assay_Type IS NOT NULL AND LOWER(Imaging_Assay_Type) NOT LIKE '%electron%'  



Ten exploratory BigQuery SQL examples (each shows only the first 20 rows)  

```sql
-- 1. Distinct imaging assay types that have Level‑2 data at HTAN WUSTL
SELECT DISTINCT Imaging_Assay_Type
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE HTAN_Center = 'HTAN WUSTL'
  AND Imaging_Assay_Type IS NOT NULL
  AND LOWER(Imaging_Assay_Type) NOT LIKE '%electron%'
  AND Component IS NOT NULL
  AND LOWER(Component) NOT LIKE '%auxiliary%'
  AND LOWER(Component) NOT LIKE '%otherassay%'
LIMIT 20;
```

```sql
-- 2. Level‑2 WUSTL imaging files together with their Synapse IDs and HTAN IDs
SELECT entityId,
       HTAN_Data_File_ID,
       Imaging_Assay_Type,
       Filename
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE HTAN_Center = 'HTAN WUSTL'
  AND Component IS NOT NULL
  AND LOWER(Component) NOT LIKE '%auxiliary%'
  AND LOWER(Component) NOT LIKE '%otherassay%'
LIMIT 20;
```

```sql
-- 3. Level‑2 WUSTL rows cross‑checked in id_provenance
SELECT p.entityId,
       p.Component,
       p.HTAN_Data_File_ID
FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5` AS p
JOIN   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  ON   p.entityId = l2.entityId
WHERE  l2.HTAN_Center = 'HTAN WUSTL'
  AND  LOWER(p.Component) NOT LIKE '%auxiliary%'
  AND  LOWER(p.Component) NOT LIKE '%otherassay%'
LIMIT 20;
```

```sql
-- 4. All Level‑3 segmentation files produced by the HTAN WUSTL center
SELECT entityId,
       HTAN_Data_File_ID,
       HTAN_Parent_Data_File_ID,
       Filename
FROM `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5`
WHERE HTAN_Center = 'HTAN WUSTL'
  AND Component IS NOT NULL
  AND LOWER(Component) NOT LIKE '%auxiliary%'
  AND LOWER(Component) NOT LIKE '%otherassay%'
LIMIT 20;
```

```sql
-- 5. Level‑3 files whose parent Level‑2 file was produced at WUSTL
SELECT l3.HTAN_Data_File_ID AS level3_id,
       l3.HTAN_Parent_Data_File_ID AS parent_l2_id,
       l2.Imaging_Assay_Type
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5` AS l3
JOIN   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`             AS l2
  ON   l3.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
WHERE  l2.HTAN_Center = 'HTAN WUSTL'
  AND  LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron%'
  AND  l3.Component IS NOT NULL
  AND  LOWER(l3.Component) NOT LIKE '%auxiliary%'
  AND  LOWER(l3.Component) NOT LIKE '%otherassay%'
LIMIT 20;
```

```sql
-- 6. Use id_provenance to confirm Level‑3 → Level‑2 ancestry (via HTAN IDs)
SELECT p3.HTAN_Data_File_ID AS level3_id,
       p3.HTAN_Parent_Data_File_ID AS parent_l2_id,
       l2.Imaging_Assay_Type
FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`                       AS p3
JOIN   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`             AS l2
  ON   p3.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
WHERE  p3.Component LIKE 'ImagingLevel3%'
  AND  l2.HTAN_Center = 'HTAN WUSTL'
  AND  LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron%'
  AND  LOWER(p3.Component) NOT LIKE '%auxiliary%'
  AND  LOWER(p3.Component) NOT LIKE '%otherassay%'
LIMIT 20;
```

```sql
-- 7. All Level‑4 quantification files from WUSTL
SELECT entityId,
       HTAN_Data_File_ID,
       HTAN_Parent_Data_File_ID,
       Filename
FROM `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5`
WHERE HTAN_Center = 'HTAN WUSTL'
  AND Component IS NOT NULL
  AND LOWER(Component) NOT LIKE '%auxiliary%'
  AND LOWER(Component) NOT LIKE '%otherassay%'
LIMIT 20;
```

```sql
-- 8. Level‑4 files whose ultimate Level‑2 ancestor is from WUSTL
WITH parent_l3 AS (
  SELECT HTAN_Data_File_ID, HTAN_Parent_Data_File_ID
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5`
)
SELECT l4.HTAN_Data_File_ID  AS level4_id,
       pl3.HTAN_Parent_Data_File_ID AS parent_l2_id,
       l2.Imaging_Assay_Type
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5` AS l4
JOIN   parent_l3                                           AS pl3
  ON   l4.HTAN_Parent_Data_File_ID = pl3.HTAN_Data_File_ID
JOIN   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  ON   pl3.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
WHERE  l2.HTAN_Center = 'HTAN WUSTL'
  AND  LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron%'
  AND  LOWER(l4.Component) NOT LIKE '%auxiliary%'
  AND  LOWER(l4.Component) NOT LIKE '%otherassay%'
LIMIT 20;
```

```sql
-- 9. For every WUSTL Level‑2 file, flag whether Level‑3 or Level‑4 exists
WITH l2 AS (
  SELECT HTAN_Data_File_ID,
         Imaging_Assay_Type
  FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE  HTAN_Center = 'HTAN WUSTL'
    AND  LOWER(Component) NOT LIKE '%auxiliary%'
    AND  LOWER(Component) NOT LIKE '%otherassay%'
    AND  LOWER(Imaging_Assay_Type) NOT LIKE '%electron%'
),
l3 AS (
  SELECT DISTINCT HTAN_Parent_Data_File_ID AS l2_id
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5`
),
l4 AS (
  -- Level‑4 may point to Level‑3 or occasionally directly to Level‑2
  SELECT DISTINCT
         COALESCE(pl3.HTAN_Parent_Data_File_ID, l4.HTAN_Parent_Data_File_ID) AS l2_id
  FROM   `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5` AS l4
  LEFT JOIN `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5` AS pl3
    ON  l4.HTAN_Parent_Data_File_ID = pl3.HTAN_Data_File_ID
)
SELECT l2.Imaging_Assay_Type,
       COUNT(DISTINCT l2.HTAN_Data_File_ID)               AS n_level2,
       COUNT(DISTINCT l3.l2_id)                           AS n_level3,
       COUNT(DISTINCT l4.l2_id)                           AS n_level4
FROM   l2
LEFT JOIN l3 ON l2.HTAN_Data_File_ID = l3.l2_id
LEFT JOIN l4 ON l2.HTAN_Data_File_ID = l4.l2_id
GROUP BY l2.Imaging_Assay_Type
LIMIT 20;
```

```sql
-- 10. Final summary: imaging assay types at WUSTL with the data levels present
-- (returns one row per assay type and a comma‑separated list of levels)
WITH l2 AS (
  SELECT HTAN_Data_File_ID,
         Imaging_Assay_Type
  FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE  HTAN_Center = 'HTAN WUSTL'
    AND  LOWER(Component) NOT LIKE '%auxiliary%'
    AND  LOWER(Component) NOT LIKE '%otherassay%'
    AND  LOWER(Imaging_Assay_Type) NOT LIKE '%electron%'
),
l3_map AS (
  SELECT DISTINCT HTAN_Parent_Data_File_ID AS l2_id
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5`
),
l4_map AS (
  SELECT DISTINCT
         COALESCE(pl3.HTAN_Parent_Data_File_ID, l4.HTAN_Parent_Data_File_ID) AS l2_id
  FROM   `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5` AS l4
  LEFT JOIN `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5` AS pl3
    ON  l4.HTAN_Parent_Data_File_ID = pl3.HTAN_Data_File_ID
)
SELECT Imaging_Assay_Type,
       STRING_AGG(level, ', ' ORDER BY level) AS available_levels
FROM (
  SELECT l2.Imaging_Assay_Type, 'Level2' AS level FROM l2
  UNION DISTINCT
  SELECT l2.Imaging_Assay_Type, 'Level3' AS level
  FROM   l2 JOIN l3_map ON l2.HTAN_Data_File_ID = l3_map.l2_id
  UNION DISTINCT
  SELECT l2.Imaging_Assay_Type, 'Level4' AS level
  FROM   l2 JOIN l4_map ON l2.HTAN_Data_File_ID = l4_map.l2_id
)
GROUP BY Imaging_Assay_Type
ORDER BY Imaging_Assay_Type
LIMIT 20;
```

