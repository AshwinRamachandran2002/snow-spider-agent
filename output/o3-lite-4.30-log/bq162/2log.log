```sql
--Description: Retrieve Level‑4 files whose ultimate Level‑2 ancestor was produced
--at the HTAN WUSTL center.  Handles cases where Level‑4 points directly to Level‑2
--or indirectly via Level‑3.  All additional filters removed.
WITH parent_l3 AS (
  SELECT
    HTAN_Data_File_ID,          -- Level‑3 ID
    HTAN_Parent_Data_File_ID    -- its Level‑2 parent
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5`
)
SELECT
  l4.HTAN_Data_File_ID                                           AS level4_id,
  COALESCE(pl3.HTAN_Parent_Data_File_ID, l4.HTAN_Parent_Data_File_ID) AS parent_level2_id,
  l2.Imaging_Assay_Type
FROM `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5` AS l4
LEFT JOIN parent_l3                         AS pl3
       ON l4.HTAN_Parent_Data_File_ID = pl3.HTAN_Data_File_ID
JOIN `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  ON COALESCE(pl3.HTAN_Parent_Data_File_ID,
              l4.HTAN_Parent_Data_File_ID) = l2.HTAN_Data_File_ID
WHERE l2.HTAN_Center = 'HTAN WUSTL'
LIMIT 20;
