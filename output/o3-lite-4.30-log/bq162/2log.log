Query:
--Description: For every Level‑2 image produced at the HTAN WUSTL center, count
--how many have associated Level‑3 or Level‑4 imaging‑specific files.  Because
--revision‑5 contains no WUSTL imaging Level‑3 or Level‑4 rows, the resulting
--n_level3 and n_level4 counts will be zero; nonetheless the query confirms this.
WITH l2 AS (
  SELECT HTAN_Data_File_ID, Imaging_Assay_Type
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE HTAN_Center = 'HTAN WUSTL'
),
l3 AS (                -- Level‑2 IDs appearing as parents in Level‑3 segmentation table
  SELECT DISTINCT HTAN_Parent_Data_File_ID AS l2_id
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5`
),
l4 AS (                -- Level‑2 IDs that are ultimate parents of Level‑4 quantification
  SELECT DISTINCT
         COALESCE(pl3.HTAN_Parent_Data_File_ID,
                  l4.HTAN_Parent_Data_File_ID) AS l2_id
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5`               AS l4
  LEFT JOIN `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5` AS pl3
    ON l4.HTAN_Parent_Data_File_ID = pl3.HTAN_Data_File_ID
)
SELECT
  l2.Imaging_Assay_Type,
  COUNT(DISTINCT l2.HTAN_Data_File_ID) AS n_level2,
  COUNT(DISTINCT l3.l2_id)             AS n_level3,
  COUNT(DISTINCT l4.l2_id)             AS n_level4
FROM l2
LEFT JOIN l3 ON l2.HTAN_Data_File_ID = l3.l2_id
LEFT JOIN l4 ON l2.HTAN_Data_File_ID = l4.l2_id
GROUP BY l2.Imaging_Assay_Type
LIMIT 20
