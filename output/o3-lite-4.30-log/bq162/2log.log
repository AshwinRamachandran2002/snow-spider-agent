Query:
--Description: Produce a concise summary showing, for each HTAN WUSTL imaging
--assay type, which data levels (2, 3, 4) are present in revision‑5.  Because
--no WUSTL imaging Level‑3 or Level‑4 files exist, only ‘Level2’ will appear in
--the available_levels field, confirming the absence of higher‑level imaging data.
WITH l2 AS (
  SELECT HTAN_Data_File_ID, Imaging_Assay_Type
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE HTAN_Center = 'HTAN WUSTL'
),
l3_map AS (
  SELECT DISTINCT HTAN_Parent_Data_File_ID AS l2_id
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5`
),
l4_map AS (
  SELECT DISTINCT
         COALESCE(pl3.HTAN_Parent_Data_File_ID,
                  l4.HTAN_Parent_Data_File_ID) AS l2_id
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5`               AS l4
  LEFT JOIN `isb-cgc-bq.HTAN_versioned.imaging_level3_segmentation_metadata_r5` AS pl3
    ON l4.HTAN_Parent_Data_File_ID = pl3.HTAN_Data_File_ID
),
levels AS (
  SELECT HTAN_Data_File_ID AS l2_id, 'Level2' AS level FROM l2
  UNION ALL
  SELECT l2_id, 'Level3' FROM l3_map
  UNION ALL
  SELECT l2_id, 'Level4' FROM l4_map
)
SELECT
  l2.Imaging_Assay_Type,
  STRING_AGG(DISTINCT level ORDER BY level) AS available_levels
FROM l2
JOIN levels ON l2.HTAN_Data_File_ID = levels.l2_id
GROUP BY l2.Imaging_Assay_Type
ORDER BY l2.Imaging_Assay_Type
LIMIT 20
Answer:
Imaging_Assay_Type,available_levels
