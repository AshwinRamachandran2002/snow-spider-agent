```

```sql
-- 7) Split the page_location into path segments so we can inspect which segment contains the category
SELECT ep.value.string_value                                       AS page_location,
       SPLIT(REGEXP_REPLACE(ep.value.string_value, r'^https?://[^/]+', ''), '/') AS segments
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` AS t
CROSS JOIN UNNEST(t.event_params) AS ep
WHERE t.event_date = '20210102'
  AND t.user_pseudo_id = '1402138.5184246691'
  AND t.event_name = 'page_view'
  AND ep.key = 'page_location'
LIMIT 20;
```

```sql
-- 8) Classify every visited URL as PDP or PLP according to the refined rules
WITH pages AS (
  SELECT ep.value.string_value AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` AS t
  CROSS JOIN UNNEST(t.event_params) AS ep
  WHERE t.event_date = '20210102'
    AND t.user_pseudo_id = '1402138.5184246691'
    AND t.event_name = 'page_view'
    AND ep.key = 'page_location'
)
SELECT url,
       CASE
         WHEN ARRAY_LENGTH(SPLIT(REGEXP_REPLACE(url, r'^https?://[^/]+', ''), '/')) >= 5
              AND REGEXP_CONTAINS(LOWER(url), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
              AND REGEXP_CONTAINS(url, r'\+')
           THEN 'PDP'
         WHEN ARRAY_LENGTH(SPLIT(REGEXP_REPLACE(url, r'^https?://[^/]+', ''), '/')) >= 5
              AND REGEXP_CONTAINS(LOWER(url), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
              AND NOT REGEXP_CONTAINS(url, r'\+')
           THEN 'PLP'
         ELSE 'Other'
       END AS page_type
FROM pages
LIMIT 20;
```

```sql
-- 9) Deduplicate and order the visited pages with the computed PDP/PLP flag
WITH all_hits AS (
  SELECT t.event_timestamp,
         ep.value.string_value AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` AS t
  CROSS JOIN UNNEST(t.event_params) AS ep
  WHERE t.event_date = '20210102'
    AND t.user_pseudo_id = '1402138.5184246691'
    AND t.event_name = 'page_view'
    AND ep.key = 'page_location'
),
typed AS (
  SELECT event_timestamp,
         url,
         CASE
           WHEN ARRAY_LENGTH(SPLIT(REGEXP_REPLACE(url, r'^https?://[^/]+', ''), '/')) >= 5
                AND REGEXP_CONTAINS(LOWER(url), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
                AND REGEXP_CONTAINS(url, r'\+')
             THEN 'PDP'
           WHEN ARRAY_LENGTH(SPLIT(REGEXP_REPLACE(url, r'^https?://[^/]+', ''), '/')) >= 5
                AND REGEXP_CONTAINS(LOWER(url), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
                AND NOT REGEXP_CONTAINS(url, r'\+')
             THEN 'PLP'
           ELSE 'Other'
         END AS page_type
  FROM all_hits
)
SELECT DISTINCT url, page_type
FROM typed
ORDER BY url
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER – sequence of pages the user visited (chronological) with PDP/PLP tag
WITH all_hits AS (
  SELECT t.event_timestamp,
         ep.value.string_value AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` AS t
  CROSS JOIN UNNEST(t.event_params) AS ep
  WHERE t.event_date = '20210102'
    AND t.user_pseudo_id = '1402138.5184246691'
    AND t.event_name = 'page_view'
    AND ep.key = 'page_location'
),
typed AS (
  SELECT event_timestamp,
         url,
         CASE
           WHEN ARRAY_LENGTH(SPLIT(REGEXP_REPLACE(url, r'^https?://[^/]+', ''), '/')) >= 5
                AND REGEXP_CONTAINS(LOWER(url), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
                AND REGEXP_CONTAINS(url, r'\+')
             THEN 'PDP'
           WHEN ARRAY_LENGTH(SPLIT(REGEXP_REPLACE(url, r'^https?://[^/]+', ''), '/')) >= 5
                AND REGEXP_CONTAINS(LOWER(url), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
                AND NOT REGEXP_CONTAINS(url, r'\+')
             THEN 'PLP'
           ELSE 'Other'
         END AS page_type
  FROM all_hits
)
SELECT FORMAT_TIMESTAMP('%Y-%m-%d %H:%M:%S', TIMESTAMP_MICROS(event_timestamp)) AS hit_time,
       url AS page_name,
       page_type
FROM typed
ORDER BY event_timestamp
LIMIT 20;
```

