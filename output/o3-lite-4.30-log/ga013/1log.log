Query:
--Description: 
--Fix for SQL #10 (final answer list) – remove the illegal negative array index.
--Steps inside query:
-- 1. Pull every hit for user 1402138.5184246691 on 2021‑01‑02 where the
--    event‑param key = 'page_location'; keep the timestamp and URL.
-- 2. Split each URL on “/” (parts array) so we can look at individual segments.
--    The last segment is parts[SAFE_OFFSET(ARRAY_LENGTH(parts)-1)].
-- 3. PDP rule  = ≥5 segments, category keyword in segment 4/5, last segment
--    contains “+”.
--    PLP rule  = same category test, last segment does NOT contain “+”.
-- 4. Output the timestamp (UTC), URL and derived label, ordered by time.
WITH base AS (
  SELECT DISTINCT
         TIMESTAMP_MICROS(t.event_timestamp)       AS event_ts_utc,
         loc.value.string_value                    AS page_location,
         SPLIT(loc.value.string_value, '/')        AS parts
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` AS t
  CROSS JOIN UNNEST(t.event_params) AS loc
  WHERE t.event_date     = '20210102'
    AND t.user_pseudo_id = '1402138.5184246691'
    AND loc.key          = 'page_location'
)
SELECT
  event_ts_utc,
  page_location,
  CASE
    WHEN ARRAY_LENGTH(parts) >= 5
         AND REGEXP_CONTAINS(
               LOWER(CONCAT(IFNULL(parts[SAFE_OFFSET(4)],''),
                            '/',
                            IFNULL(parts[SAFE_OFFSET(5)],''))),
               r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)'
         )
         AND REGEXP_CONTAINS(
               parts[SAFE_OFFSET(ARRAY_LENGTH(parts)-1)],
               r'\+'
         )
    THEN 'PDP'
    WHEN ARRAY_LENGTH(parts) >= 5
         AND REGEXP_CONTAINS(
               LOWER(CONCAT(IFNULL(parts[SAFE_OFFSET(4)],''),
                            '/',
                            IFNULL(parts[SAFE_OFFSET(5)],''))),
               r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)'
         )
         AND NOT REGEXP_CONTAINS(
               parts[SAFE_OFFSET(ARRAY_LENGTH(parts)-1)],
               r'\+'
         )
    THEN 'PLP'
    ELSE 'Other'
  END AS page_type
FROM base
ORDER BY event_ts_utc
LIMIT 20
