```sql
--Description:
--We need one final query that lists every distinct page URL visited by user
--1402138.5184246691 on 2021‑01‑02 and classifies each URL as PDP, PLP or Other.
--
--Thinking steps embedded in query:
--  1) Filter table `events_20210102` to the target date and user, then UNNEST
--     `event_params` to pull the values whose key = 'page_location'.  (These are
--     the full URLs).  Put them in CTE user_pages.
--  2) Deduplicate the URLs (CTE distinct_urls).
--  3) For every URL, split it on “/” so we can refer to individual segments
--     (CTE with_parts).  BigQuery arrays are 0‑based and cannot be indexed with
--     –1, so the last segment is parts[SAFE_OFFSET(ARRAY_LENGTH(parts)-1)].
--  4) Build one REGEXP pattern that includes every category keyword (all lower
--     case, plus‑signs instead of spaces to match the URL encoding).
--  5) PDP rule: ≥5 segments, category keyword appears in segment 4 or 5, and
--     the last segment contains “+”.
--     PLP rule: same as above but the last segment does NOT contain “+”.
--  6) Return page_location and the derived label.
WITH user_pages AS (
  SELECT loc.value.string_value AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` AS t
  CROSS JOIN UNNEST(t.event_params) AS loc
  WHERE t.event_date     = '20210102'
    AND t.user_pseudo_id = '1402138.5184246691'
    AND loc.key          = 'page_location'
),
distinct_urls AS (
  SELECT DISTINCT page_location FROM user_pages
),
with_parts AS (
  SELECT
    page_location,
    SPLIT(page_location, '/') AS parts
  FROM distinct_urls
)
SELECT
  page_location,
