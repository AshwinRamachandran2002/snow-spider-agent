```sql
--Description: 9. Apply the PLP / PDP classification rules to each distinct URL.
WITH urls AS (
  SELECT DISTINCT loc.value.string_value AS page_location
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
         UNNEST(event_params) AS loc
  WHERE  event_date = '20210102'
    AND  user_pseudo_id = '1402138.5184246691'
    AND  loc.key = 'page_location'
)
SELECT page_location,
       CASE
         WHEN ARRAY_LENGTH(SPLIT(page_location,'/')) >= 5
              AND REGEXP_CONTAINS(LOWER(SPLIT(page_location,'/')[SAFE_OFFSET(4)] ||
                                         '/' ||
                                         SPLIT(page_location,'/')[SAFE_OFFSET(5)]),
                                  r'(accessories|apparel|brands|campus\ collection|drinkware|electronics|google\ redesign|lifestyle|nest|new\ 2015\ logo|notebooks\ journals|office|shop\ by\ brand|small\ goods|stationery|wearables)')
              AND REGEXP_CONTAINS(SPLIT(page_location,'/') [OFFSET(-1)], r'\+')
         THEN 'PDP'
         WHEN ARRAY_LENGTH(SPLIT(page_location,'/')) >= 5
              AND REGEXP_CONTAINS(LOWER(SPLIT(page_location,'/')[SAFE_OFFSET(4)] ||
                                         '/' ||
                                         SPLIT(page_location,'/')[SAFE_OFFSET(5)]),
                                  r'(accessories|apparel|brands|campus\ collection|drinkware|electronics|google\ redesign|lifestyle|nest|new\ 2015\ logo|notebooks\ journals|office|shop\ by\ brand|small\ goods|stationery|wearables)')
              AND NOT REGEXP_CONTAINS(SPLIT(page_location,'/') [OFFSET(-1)], r'\+')
         THEN 'PLP'
         ELSE 'Other'
       END AS page_type
FROM urls
LIMIT 20;
```

```sql
--Description: 10. Final answer – every page visited by user 1402138.5184246691 on 2‑Jan‑2021, labelled PDP / PLP / Other, in the order they happened.
SELECT DISTINCT
       TIMESTAMP_MICROS(event_timestamp)  AS event_ts_utc,
       loc.value.string_value             AS page_location,
       CASE
         WHEN ARRAY_LENGTH(SPLIT(loc.value.string_value,'/')) >= 5
              AND REGEXP_CONTAINS(LOWER(SPLIT(loc.value.string_value,'/')[SAFE_OFFSET(4)] ||
                                         '/' ||
                                         SPLIT(loc.value.string_value,'/')[SAFE_OFFSET(5)]),
                                  r'(accessories|apparel|brands|campus\ collection|drinkware|electronics|google\ redesign|lifestyle|nest|new\ 2015\ logo|notebooks\ journals|office|shop\ by\ brand|small\ goods|stationery|wearables)')
              AND REGEXP_CONTAINS(SPLIT(loc.value.string_value,'/') [OFFSET(-1)], r'\+')
         THEN 'PDP'
         WHEN ARRAY_LENGTH(SPLIT(loc.value.string_value,'/')) >= 5
              AND REGEXP_CONTAINS(LOWER(SPLIT(loc.value.string_value,'/')[SAFE_OFFSET(4)] ||
                                         '/' ||
                                         SPLIT(loc.value.string_value,'/')[SAFE_OFFSET(5)]),
                                  r'(accessories|apparel|brands|campus\ collection|drinkware|electronics|google\ redesign|lifestyle|nest|new\ 2015\ logo|notebooks\ journals|office|shop\ by\ brand|small\ goods|stationery|wearables)')
              AND NOT REGEXP_CONTAINS(SPLIT(loc.value.string_value,'/') [OFFSET(-1)], r'\+')
         THEN 'PLP'
         ELSE 'Other'
       END                                     AS page_type
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS loc
WHERE  event_date = '20210102'
  AND  user_pseudo_id = '1402138.5184246691'
  AND  loc.key = 'page_location'
ORDER BY event_ts_utc
LIMIT 20;
```

