              AND NOT REGEXP_CONTAINS(SPLIT(loc.value.string_value,'/') [OFFSET(-1)], r'\+')
         THEN 'PLP'
         ELSE 'Other'
       END                                     AS page_type
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
