```sql
-- Description: 9) First pass categorisation – detect “+” (=> PDP) in the last URL segment.
WITH pages AS (
  SELECT DISTINCT
         pl.value.string_value AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS pl
  WHERE event_date = '20210102'
    AND user_pseudo_id = '1402138.5184246691'
    AND event_name = 'page_view'
    AND pl.key = 'page_location'
)
SELECT page_location,
       CASE
         WHEN REGEXP_EXTRACT(page_location, r'[^/]+$') LIKE '%+%' THEN 'PDP'
         ELSE 'PLP or Other'
       END AS page_type_guess
FROM pages
LIMIT 20;
```

```sql
-- Description: 10) Final answer – classify each visited page as PDP or PLP
--                 using refined category rules (case‑insensitive).
WITH pages AS (
  SELECT DISTINCT
         pl.value.string_value AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS pl
  WHERE event_date = '20210102'
    AND user_pseudo_id = '1402138.5184246691'
    AND event_name = 'page_view'
    AND pl.key = 'page_location'
),
segments AS (
  SELECT
    page_location,
    SPLIT(page_location, '/')     AS segs,
    LOWER(REGEXP_EXTRACT(page_location, r'[^/]+$')) AS last_seg
  FROM pages
),
classified AS (
  SELECT
    page_location,
    CASE
      WHEN ARRAY_LENGTH(segs) >= 5
           AND last_seg LIKE '%+%'
           AND (LOWER(segs[OFFSET(3)])     IN UNNEST([
                 'accessories','apparel','brands','campus collection','drinkware','electronics',
                 'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
                 'shop by brand','small goods','stationery','wearables'])
             OR LOWER(segs[OFFSET(4)])     IN UNNEST([
                 'accessories','apparel','brands','campus collection','drinkware','electronics',
                 'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
                 'shop by brand','small goods','stationery','wearables'])
           )
        THEN 'PDP'
      WHEN ARRAY_LENGTH(segs) >= 5
           AND last_seg NOT LIKE '%+%'
           AND (LOWER(segs[OFFSET(3)])     IN UNNEST([
                 'accessories','apparel','brands','campus collection','drinkware','electronics',
                 'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
                 'shop by brand','small goods','stationery','wearables'])
             OR LOWER(segs[OFFSET(4)])     IN UNNEST([
                 'accessories','apparel','brands','campus collection','drinkware','electronics',
                 'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
                 'shop by brand','small goods','stationery','wearables'])
           )
        THEN 'PLP'
      ELSE 'Other'
    END AS page_type
  FROM segments
)
SELECT page_location         AS visited_page,
       page_type             AS classification
FROM classified
ORDER BY visited_page
LIMIT 20;
```

These ten queries take you from a broad check of the user’s activity to the final list of distinct pages visited on 2‑Jan‑2021 with each one labelled PDP or PLP according to the provided rules.
