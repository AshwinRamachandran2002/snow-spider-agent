2025-05-01 03:03:30 - Thread-1164 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
• `event_date`: cohort filtering (2018‑07‑02 – 2018‑07‑08) & later retention windows, Monday‑based week grouping  
• `event_name`: identify first session (`'session_start'` only)  
• `user_pseudo_id`: stable anonymous user id for cohorting and retention counting  
• `event_timestamp`: alternative time stamp if sub‑day precision is ever required  
• `event_params`: can be unpacked when extra session information (e.g. `session_id`) is needed, though not strictly required here  
• `_TABLE_SUFFIX` (meta‑column available with the wildcard `events_*`): lets us restrict the daily sharded tables by date (`BETWEEN '20180702' AND '20181002'`)  

Typical conditions you will see below  
• `event_name = 'session_start'`  
• `_TABLE_SUFFIX BETWEEN '20180702' AND '20181002'` (we only analyse up to 2‑Oct‑2018)  
• `PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)` to convert the suffix into a real DATE  
• `DATE_DIFF(event_date , cohort_date , WEEK(MONDAY)) BETWEEN 0 AND 4` to label Week0‑Week4  

Ten exploratory → final queries
(Every query finishes with `LIMIT 20`, more than enough for inspection; remove the clause when you need full results.)

```sql
--Description: 1) List distinct event names on 2‑Jul‑2018 to check that 'session_start' exists
SELECT DISTINCT event_name
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX = '20180702'
LIMIT 20;
```

```sql
--Description: 2) Grab 20 raw 'session_start' rows on cohort day to verify fields we will use
SELECT
  PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) AS event_date,
  user_pseudo_id,
  event_timestamp
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX = '20180702'
  AND event_name = 'session_start'
LIMIT 20;
```

```sql
--Description: 3) Sample of users and the first calendar day they ever fired ANY event (sanity check)
SELECT
  user_pseudo_id,
  MIN(PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS first_seen_date
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
--Description: 4) Derive cohort candidates = first 'session_start' date for each user inside our cohort week
SELECT
  user_pseudo_id,
  MIN(PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS cohort_date
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180708'            -- cohort week
  AND event_name = 'session_start'
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
--Description: 5) Check distribution of those cohort dates (should all be 2018‑07‑02..08)
WITH cohort AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS cohort_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180708'
    AND event_name = 'session_start'
  GROUP BY user_pseudo_id
)
SELECT cohort_date, COUNT(*) AS users
FROM cohort
GROUP BY cohort_date
ORDER BY cohort_date
LIMIT 20;
```

```sql
--Description: 6) Join cohort with all later events (up to 2‑Oct‑2018); compute Monday‑based week_number
WITH base AS (
  SELECT
    PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) AS event_date,
    user_pseudo_id,
    event_name
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
),
cohort AS (
  SELECT
    user_pseudo_id,
    MIN(event_date) AS cohort_date
  FROM base
  WHERE event_name = 'session_start'
    AND event_date BETWEEN '2018-07-02' AND '2018-07-08'
  GROUP BY user_pseudo_id
)
SELECT
  b.user_pseudo_id,
  b.event_date,
  c.cohort_date,
  DATE_DIFF(b.event_date, c.cohort_date, WEEK(MONDAY)) AS week_number
FROM base b
JOIN cohort c USING (user_pseudo_id)
LIMIT 20;
```

```sql
--Description: 7) Count distinct cohort users for Week 0 (should equal cohort size)
WITH base AS (
  SELECT
    PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) AS event_date,
    user_pseudo_id,
    event_name
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
),
cohort AS (
  SELECT
    user_pseudo_id,
    MIN(event_date) AS cohort_date
  FROM base
  WHERE event_name = 'session_start'
    AND event_date BETWEEN '2018-07-02' AND '2018-07-08'
  GROUP BY user_pseudo_id
)
SELECT
  COUNT(DISTINCT user_pseudo_id) AS week0_users
FROM cohort
LIMIT 20;
```

```sql
--Description: 8) Users retained in Week 1 (1–7 days after cohort Monday week)
WITH base AS (
  SELECT
    PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) AS event_date,
    user_pseudo_id,
    event_name
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
),
cohort AS (
  SELECT
    user_pseudo_id,
    MIN(event_date) AS cohort_date
  FROM base
  WHERE event_name = 'session_start'
    AND event_date BETWEEN '2018-07-02' AND '2018-07-08'
  GROUP BY user_pseudo_id
),
events AS (
  SELECT
    b.user_pseudo_id,
    DATE_DIFF(b.event_date, c.cohort_date, WEEK(MONDAY)) AS week_number
  FROM base b
  JOIN cohort c USING (user_pseudo_id)
  WHERE b.event_date <= '2018-10-02'
)
SELECT
  COUNT(DISTINCT user_pseudo_id) AS week1_retained
FROM events
WHERE week_number = 1
LIMIT 20;
```

```sql
--Description: 9) Retention counts for Week 0‑4 (long form)
WITH base AS (
  SELECT
    PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) AS event_date,
    user_pseudo_id,
    event_name
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
),
cohort AS (
  SELECT
    user_pseudo_id,
    MIN(event_date) AS cohort_date
  FROM base
  WHERE event_name = 'session_start'
    AND event_date BETWEEN '2018-07-02' AND '2018-07-08'
  GROUP BY user_pseudo_id
),
events AS (
  SELECT
    b.user_pseudo_id,
    DATE_DIFF(b.event_date, c.cohort_date, WEEK(MONDAY)) AS week_number
  FROM base b
  JOIN cohort c USING (user_pseudo_id)
  WHERE b.event_date <= '2018-10-02'
)
SELECT
  week_number,
  COUNT(DISTINCT user_pseudo_id) AS users
FROM events
WHERE week_number BETWEEN 0 AND 4
GROUP BY week_number
ORDER BY week_number
LIMIT 20;
```

```sql
--Description: 10) FINAL ANSWER – pivot Week0‑Week4 retention counts for the 2‑Jul‑2018 cohort
WITH base AS (
  SELECT
    PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) AS event_date,
    user_pseudo_id,
    event_name
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
),
cohort AS (
  SELECT
    user_pseudo_id,
    MIN(event_date) AS cohort_date
  FROM base
  WHERE event_name = 'session_start'
    AND event_date BETWEEN '2018-07-02' AND '2018-07-08'         -- Cohort week starting Monday 2‑Jul‑2018
  GROUP BY user_pseudo_id
),
events AS (
  SELECT
    b.user_pseudo_id,
    DATE_DIFF(b.event_date, c.cohort_date, WEEK(MONDAY)) AS week_number
  FROM base b
  JOIN cohort c USING (user_pseudo_id)
  WHERE b.event_date <= '2018-10-02'
    AND DATE_DIFF(b.event_date, c.cohort_date, WEEK(MONDAY)) BETWEEN 0 AND 4
)
SELECT
  COUNT(DISTINCT IF(week_number = 0, user_pseudo_id, NULL)) AS week0_new_users,
  COUNT(DISTINCT IF(week_number = 1, user_pseudo_id, NULL)) AS week1_retained,
  COUNT(DISTINCT IF(week_number = 2, user_pseudo_id, NULL)) AS week2_retained,
  COUNT(DISTINCT IF(week_number = 3, user_pseudo_id, NULL)) AS week3_retained,
  COUNT(DISTINCT IF(week_number = 4, user_pseudo_id, NULL)) AS week4_retained
FROM events
LIMIT 20;
```

Running the last query will give you the total new‑user count for Week 0 and how many of those users came back in Weeks 1–4, all grouped by Monday‑based weeks and with events capped at 2‑Oct‑2018.
