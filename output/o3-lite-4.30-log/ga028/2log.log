--Description: 6) Join cohort with all later events (up to 2‑Oct‑2018); compute Monday‑based week_number
WITH base AS (
  SELECT
    PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) AS event_date,
    user_pseudo_id,
    event_name
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
),
cohort AS (
  SELECT
    user_pseudo_id,
    MIN(event_date) AS cohort_date
  FROM base
  WHERE event_name = 'session_start'
    AND event_date BETWEEN '2018-07-02' AND '2018-07-08'
  GROUP BY user_pseudo_id
)
SELECT
  b.user_pseudo_id,
  b.event_date,
  c.cohort_date,
  DATE_DIFF(b.event_date, c.cohort_date, WEEK(MONDAY)) AS week_number
FROM base b
JOIN cohort c USING (user_pseudo_id)
LIMIT 20;
