```sql
--Description: 9) Aggregate counts of cohort size (week_index=0) and retained users by week.
WITH cohort AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(event_date)), WEEK(MONDAY)) AS cohort_week_start
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
    AND event_name = 'session_start'
  GROUP BY user_pseudo_id
  HAVING cohort_week_start = DATE '2018-07-02'
),
touches AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS touch_week_start
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
    AND event_name = 'session_start'
)
SELECT DATE_DIFF(t.touch_week_start, c.cohort_week_start, WEEK) AS week_index,
       COUNT(DISTINCT c.user_pseudo_id) AS users
FROM cohort c
JOIN touches t USING (user_pseudo_id)
WHERE DATE_DIFF(t.touch_week_start, c.cohort_week_start, WEEK) BETWEEN 0 AND 4
GROUP BY week_index
ORDER BY week_index
LIMIT 20;
```

```sql
--Description: 10) FINAL ANSWER – 7‑day (weekly) retention table for cohort beginning 2018‑07‑02 (Weeks 0‑4).
WITH base AS (
  -- 1) Find first session_start (cohort definition) for each user
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(event_date)), WEEK(MONDAY)) AS cohort_week_start
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
    AND event_name = 'session_start'
  GROUP BY user_pseudo_id
  HAVING cohort_week_start = DATE '2018-07-02'     -- Week‑0 Monday
),
activity AS (
  -- 2) Every week a cohort user generates a session_start
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS act_week_start
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
    AND event_name = 'session_start'
)
SELECT
  -- Week labels
  DATE_DIFF(a.act_week_start, b.cohort_week_start, WEEK) AS week_index,
  -- Cohort size (repeated so it shows at week 0)
  COUNTIF(DATE_DIFF(a.act_week_start, b.cohort_week_start, WEEK) = 0)   AS new_users_week0,
  -- Retained users per week (week 0 = cohort size, week>0 = returning)
  COUNT(DISTINCT CASE
                 WHEN DATE_DIFF(a.act_week_start, b.cohort_week_start, WEEK) BETWEEN 1 AND 4
                 THEN b.user_pseudo_id
                 END)                                                   AS retained_users
FROM base b
JOIN activity a
  USING (user_pseudo_id)
WHERE DATE_DIFF(a.act_week_start, b.cohort_week_start, WEEK) BETWEEN 0 AND 4
GROUP BY week_index
ORDER BY week_index;
```

The final query returns one row per Week 0‑4 with:  
• `week_index` (0–4)  
• `new_users_week0` – the size of the cohort (only populated at index 0)  
• `retained_users` – count of those same users who had at least one `session_start` in that week.
