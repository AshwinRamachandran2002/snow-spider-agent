```sql
--Description: 7‑day retention (Week‑0 to Week‑4) for users whose first ever
--             `session_start` falls in the Monday‑based week that starts
--             2018‑07‑02.  The query:
--             1) Reads only the daily GA4 export tables between 2018‑07‑02 and
--                2018‑10‑02 using the wildcard plus `_TABLE_SUFFIX` filter.
--             2) Builds a cohort of users whose earliest session falls in that
--                week (cohort_week_start = 2018‑07‑02).
--             3) Calculates the difference, in whole weeks, between any later
--                `session_start` and the cohort week to derive week_index 0‑4.
--             4) Aggregates distinct‑user counts:
--                   • new_users_week0  — cohort size (shown only at week 0)
--                   • retained_users   — returning users for week 1‑4
--             The result set therefore shows one row per week_index (0‑4).
WITH all_sessions AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS event_week_start
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
    AND event_name = 'session_start'
),
cohort AS (
  SELECT
    user_pseudo_id,
    MIN(event_week_start) AS cohort_week_start
  FROM all_sessions
  GROUP BY user_pseudo_id
  HAVING cohort_week_start = DATE '2018-07-02'
),
retention AS (
  SELECT
    c.user_pseudo_id,
    DATE_DIFF(s.event_week_start, c.cohort_week_start, WEEK) AS week_index
  FROM cohort            AS c
  JOIN all_sessions AS s USING (user_pseudo_id)
  WHERE DATE_DIFF(s.event_week_start, c.cohort_week_start, WEEK) BETWEEN 0 AND 4
)
SELECT
  week_index,
  COUNT(DISTINCT CASE WHEN week_index = 0 THEN user_pseudo_id END) AS new_users_week0,
  COUNT(DISTINCT CASE WHEN week_index > 0  THEN user_pseudo_id END) AS retained_users
FROM retention
GROUP BY week_index
ORDER BY week_index;
```
