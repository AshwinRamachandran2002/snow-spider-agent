-- Keep only session_start events
session_events AS (
  SELECT user_pseudo_id, event_date
  FROM all_events
  WHERE event_name = 'session_start'
),

-- Cohort: users whose very first session happened 2018‑07‑02 → 2018‑07‑08
cohort_users AS (
  SELECT user_pseudo_id
  FROM session_events
  GROUP BY user_pseudo_id
  HAVING MIN(event_date) BETWEEN '20180702' AND '20180708'
),

-- All session_start touches of cohort users (up to 2018‑10‑02)
cohort_touches AS (
  SELECT
    s.user_pseudo_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', s.event_date), WEEK(MONDAY)) AS week_start
  FROM session_events AS s
  JOIN cohort_users  AS c USING (user_pseudo_id)
),

-- Week index (0‑4) relative to cohort week start (2018‑07‑02)
week_flags AS (
  SELECT
    DATE_DIFF(week_start, DATE '2018-07-02', WEEK) AS week,
    user_pseudo_id
  FROM cohort_touches
  WHERE DATE_DIFF(week_start, DATE '2018-07-02', WEEK) BETWEEN 0 AND 4
)

-- Final aggregation
SELECT
  week,
  COUNT(DISTINCT CASE WHEN week = 0 THEN user_pseudo_id END) AS cohort_size,
  COUNT(DISTINCT CASE WHEN week > 0 THEN user_pseudo_id END) AS retained_users
FROM week_flags
GROUP BY week
ORDER BY week;
