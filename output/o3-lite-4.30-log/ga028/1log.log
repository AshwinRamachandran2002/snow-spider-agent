--Description: 10) FINAL – Weekly (7‑day) retention table for cohort starting
--              2018‑07‑02, covering Week‑0 to Week‑4.
WITH all_sessions AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS event_week_start
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
    AND event_name = 'session_start'
),
cohort AS (
  SELECT
    user_pseudo_id,
    MIN(event_week_start) AS cohort_week_start
  FROM all_sessions
  GROUP BY user_pseudo_id
  HAVING cohort_week_start = DATE '2018-07-02'
),
retention AS (
  SELECT
    c.user_pseudo_id,
    DATE_DIFF(s.event_week_start, c.cohort_week_start, WEEK) AS week_index
  FROM cohort  AS c
  JOIN all_sessions AS s USING (user_pseudo_id)
  WHERE DATE_DIFF(s.event_week_start, c.cohort_week_start, WEEK) BETWEEN 0 AND 4
)
SELECT
  week_index,
  COUNT(DISTINCT CASE WHEN week_index = 0 THEN user_pseudo_id END) AS new_users_week0,
  COUNT(DISTINCT CASE WHEN week_index > 0  THEN user_pseudo_id END) AS retained_users
FROM retention
GROUP BY week_index
ORDER BY week_index
