--Description: 9) Aggregate counts of cohort size (week_index 0) and retained
--             users for week_index 0‑4.
WITH cohort AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(event_date)), WEEK(MONDAY)) AS cohort_week_start
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
    AND event_name = 'session_start'
  GROUP BY user_pseudo_id
  HAVING cohort_week_start = DATE '2018-07-02'
),
touches AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS touch_week_start
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
    AND event_name = 'session_start'
)
SELECT
  DATE_DIFF(t.touch_week_start, c.cohort_week_start, WEEK) AS week_index,
  COUNT(DISTINCT CASE WHEN DATE_DIFF(t.touch_week_start, c.cohort_week_start, WEEK) = 0
                      THEN c.user_pseudo_id END) AS cohort_size,
  COUNT(DISTINCT c.user_pseudo_id) AS retained_users
FROM cohort AS c
JOIN touches AS t USING (user_pseudo_id)
WHERE DATE_DIFF(t.touch_week_start, c.cohort_week_start, WEEK) BETWEEN 0 AND 4
GROUP BY week_index
ORDER BY week_index
