  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
    AND event_name = 'session_start'
)
SELECT c.user_pseudo_id,
       DATE_DIFF(t.touch_week_start, c.cohort_week_start, WEEK) AS week_index
FROM cohort c
JOIN touches t USING (user_pseudo_id)
