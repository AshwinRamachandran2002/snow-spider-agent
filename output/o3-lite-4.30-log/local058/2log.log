Begin Exploring Related Columns
Relevant tables / columns and how they will be used

• hardware_fact_sales_monthly.date : not needed, but can be used for extra filtering if we need month  
• hardware_fact_sales_monthly.product_code : key that links the fact table to the product‐dimension table  
• hardware_fact_sales_monthly.fiscal_year : filter rows for 2020 and 2021  
• hardware_dim_product.product_code : join key  
• hardware_dim_product.segment : the “segment” we have to report on  

Basic filter conditions that will be useful

WHERE hf.fiscal_year = 2020            -- for the 2020 slice  
WHERE hf.fiscal_year = 2021            -- for the 2021 slice  
WHERE hf.fiscal_year IN (2020, 2021)   -- for both years together  

-----------------------------------------------------------------
10 exploratory SQL queries (LIMIT 20 for safety)
-----------------------------------------------------------------

```sql
-- 1. Distinct fiscal years present in the fact table
SELECT DISTINCT fiscal_year
FROM "hardware_fact_sales_monthly"
LIMIT 20;
```

```sql
-- 2. A quick look at product codes sold in 2020
SELECT DISTINCT product_code
FROM "hardware_fact_sales_monthly"
WHERE fiscal_year = 2020
LIMIT 20;
```

```sql
-- 3. All available product segments in the product dimension table
SELECT DISTINCT segment
FROM "hardware_dim_product"
LIMIT 20;
```

```sql
-- 4. Example join: product code with its segment (first 20 rows of the fact table)
SELECT hf.product_code,
       dp.segment
FROM   "hardware_fact_sales_monthly"  AS hf
JOIN   "hardware_dim_product"         AS dp
       ON hf.product_code = dp.product_code
LIMIT 20;
```

```sql
-- 5. Unique product count by segment for fiscal‑year 2020
WITH fact2020 AS (
  SELECT DISTINCT product_code
  FROM   "hardware_fact_sales_monthly"
  WHERE  fiscal_year = 2020
)
SELECT dp.segment,
       COUNT(*) AS unique_products_2020
FROM   fact2020      AS f
JOIN   "hardware_dim_product" AS dp
       ON f.product_code = dp.product_code
GROUP  BY dp.segment
ORDER  BY unique_products_2020 DESC
LIMIT 20;
```

```sql
-- 6. Unique product count by segment for fiscal‑year 2021
WITH fact2021 AS (
  SELECT DISTINCT product_code
  FROM   "hardware_fact_sales_monthly"
  WHERE  fiscal_year = 2021
)
SELECT dp.segment,
       COUNT(*) AS unique_products_2021
FROM   fact2021      AS f
JOIN   "hardware_dim_product" AS dp
       ON f.product_code = dp.product_code
GROUP  BY dp.segment
ORDER  BY unique_products_2021 DESC
LIMIT 20;
```

```sql
-- 7. Combine the 2020 and 2021 counts side‑by‑side
WITH p2020 AS (
  SELECT dp.segment,
         COUNT(DISTINCT hf.product_code) AS cnt2020
  FROM   "hardware_fact_sales_monthly"  AS hf
  JOIN   "hardware_dim_product"         AS dp
         ON hf.product_code = dp.product_code
  WHERE  hf.fiscal_year = 2020
  GROUP  BY dp.segment
),
p2021 AS (
  SELECT dp.segment,
         COUNT(DISTINCT hf.product_code) AS cnt2021
  FROM   "hardware_fact_sales_monthly"  AS hf
  JOIN   "hardware_dim_product"         AS dp
         ON hf.product_code = dp.product_code
  WHERE  hf.fiscal_year = 2021
  GROUP  BY dp.segment
)
SELECT p2020.segment,
       p2020.cnt2020,
       p2021.cnt2021
FROM   p2020
LEFT   JOIN p2021 ON p2020.segment = p2021.segment
ORDER  BY p2020.cnt2020 DESC
LIMIT 20;
```

```sql
-- 8. Same join but include any segment that appears ONLY in 2021
WITH p2020 AS (
  SELECT dp.segment,
         COUNT(DISTINCT hf.product_code) AS cnt2020
  FROM   "hardware_fact_sales_monthly"  AS hf
  JOIN   "hardware_dim_product"         AS dp
         ON hf.product_code = dp.product_code
  WHERE  hf.fiscal_year = 2020
  GROUP  BY dp.segment
),
p2021 AS (
  SELECT dp.segment,
         COUNT(DISTINCT hf.product_code) AS cnt2021
  FROM   "hardware_fact_sales_monthly"  AS hf
  JOIN   "hardware_dim_product"         AS dp
         ON hf.product_code = dp.product_code
  WHERE  hf.fiscal_year = 2021
  GROUP  BY dp.segment
),
all_segments AS (
  SELECT segment FROM p2020
  UNION
  SELECT segment FROM p2021
)
SELECT s.segment,
       COALESCE(p2020.cnt2020, 0) AS cnt2020,
       COALESCE(p2021.cnt2021, 0) AS cnt2021
FROM   all_segments  AS s
LEFT   JOIN p2020    ON s.segment = p2020.segment
LEFT   JOIN p2021    ON s.segment = p2021.segment
LIMIT 20;
```

```sql
-- 9. Add percentage increase and keep only segments present in 2020
WITH p2020 AS (
  SELECT dp.segment,
         COUNT(DISTINCT hf.product_code) AS cnt2020
  FROM   "hardware_fact_sales_monthly"  AS hf
  JOIN   "hardware_dim_product"         AS dp
         ON hf.product_code = dp.product_code
  WHERE  hf.fiscal_year = 2020
  GROUP  BY dp.segment
),
p2021 AS (
  SELECT dp.segment,
         COUNT(DISTINCT hf.product_code) AS cnt2021
  FROM   "hardware_fact_sales_monthly"  AS hf
  JOIN   "hardware_dim_product"         AS dp
         ON hf.product_code = dp.product_code
  WHERE  hf.fiscal_year = 2021
  GROUP  BY dp.segment
)
SELECT p2020.segment,
       p2020.cnt2020,
       COALESCE(p2021.cnt2021, 0) AS cnt2021,
       ROUND(
         (COALESCE(p2021.cnt2021, 0) - p2020.cnt2020)*100.0 / p2020.cnt2020
         , 2) AS pct_increase
FROM   p2020
LEFT   JOIN p2021 ON p2020.segment = p2021.segment
ORDER  BY pct_increase DESC
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER QUERY:
--    Segment, unique‑product‑count‑2020, ordered by highest % increase to 2021
WITH p2020 AS (
  SELECT dp.segment,
         COUNT(DISTINCT hf.product_code) AS cnt2020
  FROM   "hardware_fact_sales_monthly"  AS hf
  JOIN   "hardware_dim_product"         AS dp
         ON hf.product_code = dp.product_code
  WHERE  hf.fiscal_year = 2020
  GROUP  BY dp.segment
),
p2021 AS (
  SELECT dp.segment,
         COUNT(DISTINCT hf.product_code) AS cnt2021
  FROM   "hardware_fact_sales_monthly"  AS hf
  JOIN   "hardware_dim_product"         AS dp
         ON hf.product_code = dp.product_code
  WHERE  hf.fiscal_year = 2021
  GROUP  BY dp.segment
)
SELECT p2020.segment                              AS segment,
       p2020.cnt2020                              AS unique_products_2020,
       ROUND(
         (COALESCE(p2021.cnt2021, 0) - p2020.cnt2020)*100.0 / p2020.cnt2020
         , 2)                                     AS pct_increase_20_to_21
FROM   p2020
LEFT   JOIN p2021 ON p2020.segment = p2021.segment
ORDER  BY pct_increase_20_to_21 DESC
LIMIT 20;
```

Each query is limited to 20 rows to stay lightweight while incrementally building the logic that finally satisfies:  
“Give product segments, their 2020 unique‑product counts, ordered by highest % increase in unique fact‑sales products from 2020→2021.”
