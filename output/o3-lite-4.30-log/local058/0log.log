Relevant columns and why they matter  

hardware_fact_sales_monthly."product_code": needed to know which products were sold in each fiscal year.  
hardware_fact_sales_monthly."fiscal_year": used to isolate the two years we care about (2020 and 2021).  
hardware_dim_product."product_code": joins the fact table to the product dimension.  
hardware_dim_product."segment": lets us aggregate by “hardware product segment.”  

Typical conditions that will be used  

hardware_fact_sales_monthly."fiscal_year" IN (2020, 2021) – to limit rows to the two target years.  


Ten investigative‑to‑final SQL queries  

```sql
-- 1) What fiscal years exist in the sales fact table?
SELECT DISTINCT "fiscal_year"
FROM "hardware_fact_sales_monthly"
ORDER BY "fiscal_year"
LIMIT 20;
```

```sql
-- 2) What hardware product segments do we have?
SELECT DISTINCT "segment"
FROM "hardware_dim_product"
ORDER BY "segment"
LIMIT 20;
```

```sql
-- 3) Unique product codes that appear in 2020 sales
SELECT DISTINCT "product_code"
FROM "hardware_fact_sales_monthly"
WHERE "fiscal_year" = 2020
LIMIT 20;
```

```sql
-- 4) Unique product codes that appear in 2021 sales
SELECT DISTINCT "product_code"
FROM "hardware_fact_sales_monthly"
WHERE "fiscal_year" = 2021
LIMIT 20;
```

```sql
-- 5) Segment–product pairs that registered sales in 2020
SELECT DISTINCT dp."segment",
       fm."product_code"
FROM   "hardware_fact_sales_monthly" AS fm
JOIN   "hardware_dim_product"        AS dp
       ON dp."product_code" = fm."product_code"
WHERE  fm."fiscal_year" = 2020
LIMIT 20;
```

```sql
-- 6) Count of UNIQUE products per segment for 2020
SELECT dp."segment",
       COUNT(DISTINCT fm."product_code") AS "cnt_2020"
FROM   "hardware_fact_sales_monthly" AS fm
JOIN   "hardware_dim_product"        AS dp
       ON dp."product_code" = fm."product_code"
WHERE  fm."fiscal_year" = 2020
GROUP  BY dp."segment"
ORDER  BY "cnt_2020" DESC
LIMIT 20;
```

```sql
-- 7) Count of UNIQUE products per segment for 2021
SELECT dp."segment",
       COUNT(DISTINCT fm."product_code") AS "cnt_2021"
FROM   "hardware_fact_sales_monthly" AS fm
JOIN   "hardware_dim_product"        AS dp
       ON dp."product_code" = fm."product_code"
WHERE  fm."fiscal_year" = 2021
GROUP  BY dp."segment"
ORDER  BY "cnt_2021" DESC
LIMIT 20;
```

```sql
-- 8) Join 2020 and 2021 counts side‑by‑side
WITH y20 AS (
     SELECT dp."segment",
            COUNT(DISTINCT fm."product_code") AS "cnt_2020"
     FROM   "hardware_fact_sales_monthly" AS fm
     JOIN   "hardware_dim_product"        AS dp
            ON dp."product_code" = fm."product_code"
     WHERE  fm."fiscal_year" = 2020
     GROUP  BY dp."segment"
),
y21 AS (
     SELECT dp."segment",
            COUNT(DISTINCT fm."product_code") AS "cnt_2021"
     FROM   "hardware_fact_sales_monthly" AS fm
     JOIN   "hardware_dim_product"        AS dp
            ON dp."product_code" = fm."product_code"
     WHERE  fm."fiscal_year" = 2021
     GROUP  BY dp."segment"
)
SELECT y20."segment",
       y20."cnt_2020",
       y21."cnt_2021"
FROM   y20
LEFT  JOIN y21 USING ("segment")
LIMIT 20;
```

```sql
-- 9) Same as #8 but also compute % increase
WITH y20 AS (
     SELECT dp."segment",
            COUNT(DISTINCT fm."product_code") AS "cnt_2020"
     FROM   "hardware_fact_sales_monthly" AS fm
     JOIN   "hardware_dim_product"        AS dp
            ON dp."product_code" = fm."product_code"
     WHERE  fm."fiscal_year" = 2020
     GROUP  BY dp."segment"
),
y21 AS (
     SELECT dp."segment",
            COUNT(DISTINCT fm."product_code") AS "cnt_2021"
     FROM   "hardware_fact_sales_monthly" AS fm
     JOIN   "hardware_dim_product"        AS dp
            ON dp."product_code" = fm."product_code"
     WHERE  fm."fiscal_year" = 2021
     GROUP  BY dp."segment"
)
SELECT y20."segment",
       y20."cnt_2020",
       y21."cnt_2021",
       ROUND( ( (y21."cnt_2021" - y20."cnt_2020") * 100.0 ) / NULLIF(y20."cnt_2020",0), 2) 
           AS "pct_increase"
FROM   y20
LEFT  JOIN y21 USING ("segment")
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER – list segments with their 2020 unique‑product counts,
--     ordered by highest % increase from 2020 to 2021
WITH y20 AS (
     SELECT dp."segment",
            COUNT(DISTINCT fm."product_code") AS "cnt_2020"
     FROM   "hardware_fact_sales_monthly" AS fm
     JOIN   "hardware_dim_product"        AS dp
            ON dp."product_code" = fm."product_code"
     WHERE  fm."fiscal_year" = 2020
     GROUP  BY dp."segment"
),
y21 AS (
     SELECT dp."segment",
            COUNT(DISTINCT fm."product_code") AS "cnt_2021"
     FROM   "hardware_fact_sales_monthly" AS fm
     JOIN   "hardware_dim_product"        AS dp
            ON dp."product_code" = fm."product_code"
     WHERE  fm."fiscal_year" = 2021
     GROUP  BY dp."segment"
)
SELECT y20."segment",
       y20."cnt_2020"
FROM   y20
LEFT  JOIN y21 USING ("segment")
ORDER  BY ( (y21."cnt_2021" - y20."cnt_2020") * 1.0 ) / NULLIF(y20."cnt_2020",0) DESC
LIMIT 20;
