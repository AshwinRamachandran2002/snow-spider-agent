Begin Exploring Related Columns
Relevant columns and their possible roles  
(bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary)  
• latitude / longitude : geographic keys (rounded to 2‑decimals to join with OpenAQ)  
• parameter_name       : filter to 'Acceptable PM2.5 AQI & Speciation Mass'  
• units_of_measure     : filter to 'Micrograms/cubic meter (LC)'  
• date_local           : extract the year (1990)  
• arithmetic_mean      : daily PM2.5 value to be averaged per site  
• city_name / state_name: city label to display in the answer  

(bigquery-public-data.openaq.global_air_quality)  
• latitude / longitude : geographic keys (rounded to 2‑decimals to join with EPA)  
• pollutant            : filter to 'pm25'  
• timestamp            : extract the year (2020)  
• value                : PM2.5 concentration to be averaged per site  
• city / country       : city label to display in the answer  

Typical filter conditions you will need  
• parameter_name = 'Acceptable PM2.5 AQI & Speciation Mass'  
• units_of_measure = 'Micrograms/cubic meter (LC)'  
• pollutant = 'pm25'  
• EXTRACT(YEAR FROM date_local) = 1990  
• EXTRACT(YEAR FROM timestamp)  = 2020  

Below are ten BigQuery SQL snippets that progress from exploring the data to producing the final answer.  
(Replace nothing – table names/columns are already fully qualified.)

```sql
-- 1. Peek at a few 1990 EPA PM2.5 records
SELECT *
FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
WHERE parameter_name = 'Acceptable PM2.5 AQI & Speciation Mass'
  AND units_of_measure = 'Micrograms/cubic meter (LC)'
  AND EXTRACT(YEAR FROM date_local) = 1990
LIMIT 20;
```

```sql
-- 2. Peek at a few 2020 OpenAQ PM2.5 records
SELECT *
FROM `bigquery-public-data.openaq.global_air_quality`
WHERE pollutant = 'pm25'
  AND EXTRACT(YEAR FROM timestamp) = 2020
LIMIT 20;
```

```sql
-- 3. See which years are present in the EPA table for our parameter / unit
SELECT DISTINCT EXTRACT(YEAR FROM date_local) AS yr
FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
WHERE parameter_name = 'Acceptable PM2.5 AQI & Speciation Mass'
  AND units_of_measure = 'Micrograms/cubic meter (LC)'
ORDER BY yr
LIMIT 20;
```

```sql
-- 4. See which years are present in OpenAQ for PM2.5
SELECT DISTINCT EXTRACT(YEAR FROM timestamp) AS yr
FROM `bigquery-public-data.openaq.global_air_quality`
WHERE pollutant = 'pm25'
ORDER BY yr
LIMIT 20;
```

```sql
-- 5. Average 1990 EPA PM2.5 per rounded coordinate
SELECT
  ROUND(latitude, 2)  AS lat_round,
  ROUND(longitude, 2) AS lon_round,
  AVG(arithmetic_mean) AS avg_pm25_1990
FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
WHERE parameter_name = 'Acceptable PM2.5 AQI & Speciation Mass'
  AND units_of_measure = 'Micrograms/cubic meter (LC)'
  AND EXTRACT(YEAR FROM date_local) = 1990
GROUP BY lat_round, lon_round
LIMIT 20;
```

```sql
-- 6. Average 2020 OpenAQ PM2.5 per rounded coordinate
SELECT
  ROUND(latitude, 2)  AS lat_round,
  ROUND(longitude, 2) AS lon_round,
  AVG(value)          AS avg_pm25_2020
FROM `bigquery-public-data.openaq.global_air_quality`
WHERE pollutant = 'pm25'
  AND EXTRACT(YEAR FROM timestamp) = 2020
GROUP BY lat_round, lon_round
LIMIT 20;
```

```sql
-- 7. Join the two summaries on the rounded coordinates
WITH epa AS (
  SELECT ROUND(latitude,2) AS lat_round, ROUND(longitude,2) AS lon_round,
         AVG(arithmetic_mean) AS avg_pm25_1990
  FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
  WHERE parameter_name = 'Acceptable PM2.5 AQI & Speciation Mass'
    AND units_of_measure = 'Micrograms/cubic meter (LC)'
    AND EXTRACT(YEAR FROM date_local) = 1990
  GROUP BY lat_round, lon_round
),
openaq AS (
  SELECT ROUND(latitude,2) AS lat_round, ROUND(longitude,2) AS lon_round,
         AVG(value) AS avg_pm25_2020
  FROM `bigquery-public-data.openaq.global_air_quality`
  WHERE pollutant = 'pm25'
    AND EXTRACT(YEAR FROM timestamp) = 2020
  GROUP BY lat_round, lon_round
)
SELECT *
FROM epa JOIN openaq USING (lat_round, lon_round)
LIMIT 20;
```

```sql
-- 8. Add city labels to the EPA aggregation
SELECT
  ROUND(latitude,2) AS lat_round,
  ROUND(longitude,2) AS lon_round,
  ANY_VALUE(city_name)  AS city_epa,
  ANY_VALUE(state_name) AS state_epa,
  AVG(arithmetic_mean)  AS avg_pm25_1990
FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
WHERE parameter_name = 'Acceptable PM2.5 AQI & Speciation Mass'
  AND units_of_measure = 'Micrograms/cubic meter (LC)'
  AND EXTRACT(YEAR FROM date_local) = 1990
GROUP BY lat_round, lon_round
LIMIT 20;
```

```sql
-- 9. Compute absolute differences and order them
WITH epa AS (
  SELECT ROUND(latitude,2) AS lat_round, ROUND(longitude,2) AS lon_round,
         ANY_VALUE(city_name) AS city_epa,
         AVG(arithmetic_mean) AS avg_pm25_1990
  FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
  WHERE parameter_name = 'Acceptable PM2.5 AQI & Speciation Mass'
    AND units_of_measure = 'Micrograms/cubic meter (LC)'
    AND EXTRACT(YEAR FROM date_local) = 1990
  GROUP BY lat_round, lon_round
),
openaq AS (
  SELECT ROUND(latitude,2) AS lat_round, ROUND(longitude,2) AS lon_round,
         ANY_VALUE(city) AS city_open,
         AVG(value) AS avg_pm25_2020
  FROM `bigquery-public-data.openaq.global_air_quality`
  WHERE pollutant = 'pm25'
    AND EXTRACT(YEAR FROM timestamp) = 2020
  GROUP BY lat_round, lon_round
)
SELECT
  COALESCE(city_open, city_epa) AS city,
  ABS(avg_pm25_2020 - avg_pm25_1990) AS diff_pm25
FROM epa JOIN openaq USING (lat_round, lon_round)
ORDER BY diff_pm25 DESC
LIMIT 20;
```

```sql
-- 10. Final query – three cities with the greatest 1990 vs 2020 PM2.5 change
WITH epa_1990 AS (
  SELECT
    ROUND(latitude, 2)  AS lat_round,
    ROUND(longitude, 2) AS lon_round,
    AVG(arithmetic_mean)         AS avg_pm25_1990,
    ANY_VALUE(city_name)  AS city_epa,
    ANY_VALUE(state_name) AS state_epa
  FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
  WHERE parameter_name   = 'Acceptable PM2.5 AQI & Speciation Mass'
    AND units_of_measure = 'Micrograms/cubic meter (LC)'
    AND EXTRACT(YEAR FROM date_local) = 1990
  GROUP BY lat_round, lon_round
),
openaq_2020 AS (
  SELECT
    ROUND(latitude, 2)  AS lat_round,
    ROUND(longitude, 2) AS lon_round,
    AVG(value)                 AS avg_pm25_2020,
    ANY_VALUE(city)     AS city_open,
    ANY_VALUE(country)  AS country_open
  FROM `bigquery-public-data.openaq.global_air_quality`
  WHERE pollutant = 'pm25'
    AND EXTRACT(YEAR FROM timestamp) = 2020
  GROUP BY lat_round, lon_round
)
SELECT
  COALESCE(city_open, city_epa)                AS city,
  lat_round                                    AS latitude_2dec,
  lon_round                                    AS longitude_2dec,
  avg_pm25_1990,
  avg_pm25_2020,
  ABS(avg_pm25_2020 - avg_pm25_1990)           AS pm25_difference
FROM epa_1990
JOIN openaq_2020 USING (lat_round, lon_round)
ORDER BY pm25_difference DESC
LIMIT 3;
```

Running the last query returns the three cities that show the greatest change (largest absolute difference) between their 1990 EPA PM2.5 levels and their 2020 OpenAQ PM2.5 levels, using the required matching and filters.
