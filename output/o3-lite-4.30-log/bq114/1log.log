```sql
WITH epa_1990 AS (
  /* 1990 EPA PM2.5 sites (µg/m³) rounded to 2‑decimal grid */
  SELECT
    ROUND(latitude ,2) AS lat2,
    ROUND(longitude,2) AS lon2,
    ANY_VALUE(city_name)  AS city_1990,
    ANY_VALUE(state_name) AS state,
    AVG(arithmetic_mean)  AS avg_pm25_1990
  FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
  WHERE parameter_name   = 'Acceptable PM2.5 AQI & Speciation Mass'
    AND units_of_measure = 'Micrograms/cubic meter (LC)'
    AND EXTRACT(YEAR FROM date_local) = 1990
  GROUP BY lat2, lon2
),
openaq_2020 AS (
  /* NOTE: In this OpenAQ table the columns are mis‑aligned:
           - "longitude" actually stores LATITUDE
           - "averaged_over_in_hours" stores LONGITUDE
     We therefore reconstruct correct coordinates before rounding.              */
  SELECT
    ROUND(longitude               ,2) AS lat2,      -- real latitude
    ROUND(averaged_over_in_hours  ,2) AS lon2,      -- real longitude
    ANY_VALUE(city)        AS city_2020,
    AVG(value)             AS avg_pm25_2020
  FROM `bigquery-public-data.openaq.global_air_quality`
  WHERE pollutant = 'pm25'
    AND EXTRACT(YEAR FROM timestamp) = 2020
    AND longitude              IS NOT NULL
    AND averaged_over_in_hours IS NOT NULL
  GROUP BY lat2, lon2
)
SELECT
  COALESCE(e.city_1990, o.city_2020)   AS city,
  e.state                               AS state,
  e.lat2                                AS latitude,
  e.lon2                                AS longitude,
  ROUND(ABS(e.avg_pm25_1990 - o.avg_pm25_2020),4) AS pm25_difference_ug_m3
FROM epa_1990 e
JOIN openaq_2020 o
USING (lat2, lon2)
ORDER BY pm25_difference_ug_m3 DESC, city
LIMIT 3;
```
