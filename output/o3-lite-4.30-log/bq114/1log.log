Begin Exploring Related Columns
Relevant columns, potential usage, and typical filter conditions
• bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary  
  - date_local: select only 1990 rows  WHERE EXTRACT(YEAR FROM date_local)=1990  
  - parameter_name: filter for PM2.5 speciation mass WHERE parameter_name='Acceptable PM2.5 AQI & Speciation Mass'  
  - units_of_measure: restrict to the requested unit WHERE units_of_measure='Micrograms/cubic meter (LC)'  
  - arithmetic_mean: daily PM2.5 concentration that we will aggregate to “1990 average”  
  - latitude / longitude: rounded to two decimals to match OpenAQ sites  
  - city_name: city label that will be returned in the final answer  

• bigquery-public-data.openaq.global_air_quality  
  - timestamp: filter for calendar year 2020 WHERE EXTRACT(YEAR FROM timestamp)=2020  
  - pollutant: keep only pm25 WHERE pollutant='pm25'  
  - value: hourly / sub‑hourly PM2.5 concentration that we will aggregate to “2020 average”  
  - latitude / longitude: rounded to two decimals to match EPA sites  
  - city: city label that will be returned in the final answer  

Below are ten investigative SQL queries (each limited to 20 rows) that progress from basic exploration to the final join producing the three cities with the largest 1990‑vs‑2020 difference.  
(Replace YOUR‑PROJECT if you need to qualify the project; the public dataset is already fully qualified.)

```sql
-- 1. Description: List distinct parameter names available in the EPA table (first 20)
SELECT DISTINCT `parameter_name`
FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
LIMIT 20;
```

```sql
-- 2. Description: Inspect EPA rows for 1990 that already meet the requested parameter & unit
SELECT
  date_local,
  city_name,
  latitude,
  longitude,
  arithmetic_mean
FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
WHERE parameter_name = 'Acceptable PM2.5 AQI & Speciation Mass'
  AND units_of_measure = 'Micrograms/cubic meter (LC)'
  AND EXTRACT(YEAR FROM date_local) = 1990
LIMIT 20;
```

```sql
-- 3. Description: Average the 1990 EPA arithmetic_mean per (rounded lat/lon) and city
SELECT
  ROUND(latitude,2) AS lat2,
  ROUND(longitude,2) AS lon2,
  ANY_VALUE(city_name) AS city,
  AVG(arithmetic_mean) AS avg_pm25_1990
FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
WHERE parameter_name = 'Acceptable PM2.5 AQI & Speciation Mass'
  AND units_of_measure = 'Micrograms/cubic meter (LC)'
  AND EXTRACT(YEAR FROM date_local) = 1990
GROUP BY lat2, lon2
LIMIT 20;
```

```sql
-- 4. Description: Show distinct pollutants present in OpenAQ
SELECT DISTINCT `pollutant`
FROM `bigquery-public-data.openaq.global_air_quality`
LIMIT 20;
```

```sql
-- 5. Description: Preview OpenAQ pm25 rows for the year 2020
SELECT
  timestamp,
  city,
  latitude,
  longitude,
  value
FROM `bigquery-public-data.openaq.global_air_quality`
WHERE pollutant='pm25'
  AND EXTRACT(YEAR FROM timestamp)=2020
LIMIT 20;
```

```sql
-- 6. Description: Average the 2020 OpenAQ value per (rounded lat/lon) and city
SELECT
  ROUND(latitude,2) AS lat2,
  ROUND(longitude,2) AS lon2,
  ANY_VALUE(city) AS city,
  AVG(value) AS avg_pm25_2020
FROM `bigquery-public-data.openaq.global_air_quality`
WHERE pollutant='pm25'
  AND EXTRACT(YEAR FROM timestamp)=2020
GROUP BY lat2, lon2
LIMIT 20;
```

```sql
-- 7. Description: Inspect how many distinct rounded coordinates are common to both datasets
WITH epa AS (
  SELECT DISTINCT ROUND(latitude,2) AS lat2, ROUND(longitude,2) AS lon2
  FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
  WHERE parameter_name='Acceptable PM2.5 AQI & Speciation Mass'
    AND units_of_measure='Micrograms/cubic meter (LC)'
    AND EXTRACT(YEAR FROM date_local)=1990
),
openaq AS (
  SELECT DISTINCT ROUND(latitude,2) AS lat2, ROUND(longitude,2) AS lon2
  FROM `bigquery-public-data.openaq.global_air_quality`
  WHERE pollutant='pm25'
    AND EXTRACT(YEAR FROM timestamp)=2020
)
SELECT COUNT(*) AS common_sites
FROM epa
JOIN openaq USING (lat2, lon2);
```

```sql
-- 8. Description: Join 1990 EPA averages with 2020 OpenAQ averages on rounded coordinates
WITH epa_1990 AS (
  SELECT
    ROUND(latitude,2) AS lat2,
    ROUND(longitude,2) AS lon2,
    ANY_VALUE(city_name) AS city_1990,
    AVG(arithmetic_mean) AS avg_pm25_1990
  FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
  WHERE parameter_name='Acceptable PM2.5 AQI & Speciation Mass'
    AND units_of_measure='Micrograms/cubic meter (LC)'
    AND EXTRACT(YEAR FROM date_local)=1990
  GROUP BY lat2, lon2
),
openaq_2020 AS (
  SELECT
    ROUND(latitude,2) AS lat2,
    ROUND(longitude,2) AS lon2,
    ANY_VALUE(city) AS city_2020,
    AVG(value) AS avg_pm25_2020
  FROM `bigquery-public-data.openaq.global_air_quality`
  WHERE pollutant='pm25'
    AND EXTRACT(YEAR FROM timestamp)=2020
  GROUP BY lat2, lon2
)
SELECT
  e.city_1990 AS epa_city,
  o.city_2020 AS openaq_city,
  e.avg_pm25_1990,
  o.avg_pm25_2020
FROM epa_1990 e
JOIN openaq_2020 o
USING (lat2, lon2)
LIMIT 20;
```

```sql
-- 9. Description: Compute absolute differences and sort descending 
WITH epa_1990 AS (
  SELECT
    ROUND(latitude,2) AS lat2,
    ROUND(longitude,2) AS lon2,
    ANY_VALUE(city_name) AS city,
    AVG(arithmetic_mean) AS avg_pm25_1990
  FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
  WHERE parameter_name='Acceptable PM2.5 AQI & Speciation Mass'
    AND units_of_measure='Micrograms/cubic meter (LC)'
    AND EXTRACT(YEAR FROM date_local)=1990
  GROUP BY lat2, lon2
),
openaq_2020 AS (
  SELECT
    ROUND(latitude,2) AS lat2,
    ROUND(longitude,2) AS lon2,
    ANY_VALUE(city) AS city,
    AVG(value) AS avg_pm25_2020
  FROM `bigquery-public-data.openaq.global_air_quality`
  WHERE pollutant='pm25'
    AND EXTRACT(YEAR FROM timestamp)=2020
  GROUP BY lat2, lon2
)
SELECT
  COALESCE(e.city,o.city) AS city,
  e.avg_pm25_1990,
  o.avg_pm25_2020,
  ABS(e.avg_pm25_1990 - o.avg_pm25_2020) AS diff_pm25
FROM epa_1990 e
JOIN openaq_2020 o USING (lat2, lon2)
ORDER BY diff_pm25 DESC
LIMIT 20;
```

