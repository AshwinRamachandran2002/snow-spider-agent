--Description: #8  Join 1990 EPA averages with 2020 OpenAQ averages on rounded coordinates
WITH epa_1990 AS (
  SELECT
    ROUND(latitude,2) AS lat2,
    ROUND(longitude,2) AS lon2,
    ANY_VALUE(city_name) AS city_1990,
    AVG(arithmetic_mean) AS avg_pm25_1990
  FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
  WHERE EXTRACT(YEAR FROM date_local) = 1990
    AND LOWER(parameter_name) LIKE '%pm2.5%'                  -- relaxed
    AND units_of_measure = 'Micrograms/cubic meter (LC)'
  GROUP BY lat2, lon2
),
openaq_2020 AS (
  SELECT
    ROUND(latitude,2) AS lat2,
    ROUND(longitude,2) AS lon2,
    ANY_VALUE(city) AS city_2020,
    AVG(value) AS avg_pm25_2020
  FROM `bigquery-public-data.openaq.global_air_quality`
  WHERE pollutant = 'pm25'
    AND EXTRACT(YEAR FROM timestamp) = 2020
  GROUP BY lat2, lon2
)
SELECT
  e.city_1990 AS epa_city,
  o.city_2020 AS openaq_city,
  e.avg_pm25_1990,
  o.avg_pm25_2020
FROM epa_1990 e
JOIN openaq_2020 o
USING (lat2, lon2)
LIMIT 20
