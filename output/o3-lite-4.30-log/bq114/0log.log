```sql
--Description: 9. Join the 1990 EPA means with the 2020 OpenAQ means on rounded coordinates
--and list the largest absolute differences.  The EPA sub‑query now uses the relaxed
--“%pm2.5%” parameter filter to ensure 1990 records are available.
SELECT
  e.lat2,
  e.lon2,
  e.epa_1990_mean,
  o.openaq_2020_mean,
  ABS(o.openaq_2020_mean - e.epa_1990_mean) AS diff
FROM (
  SELECT
    ROUND(latitude, 2) AS lat2,
    ROUND(longitude, 2) AS lon2,
    AVG(arithmetic_mean) AS epa_1990_mean
  FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
  WHERE LOWER(parameter_name) LIKE '%pm2.5%'
    AND units_of_measure = 'Micrograms/cubic meter (LC)'
    AND EXTRACT(YEAR FROM date_local) = 1990
  GROUP BY lat2, lon2
) AS e
JOIN (
  SELECT
    ROUND(latitude, 2) AS lat2,
    ROUND(longitude, 2) AS lon2,
    AVG(value) AS openaq_2020_mean
  FROM `bigquery-public-data.openaq.global_air_quality`
  WHERE pollutant = 'pm25'
    AND EXTRACT(YEAR FROM timestamp) = 2020
  GROUP BY lat2, lon2
) AS o
USING (lat2, lon2)
ORDER BY diff DESC
LIMIT 20;
```

```sql
--Description: 10. Final query — return the three cities whose rounded coordinates show the
--greatest absolute change in PM2.5 from 1990 (EPA) to 2020 (OpenAQ).  The EPA portion now
--uses the relaxed “%pm2.5%” filter so it captures any 1990 PM2.5 measurements.
SELECT
  COALESCE(o.city, e.city_name) AS city,
  e.epa_1990_mean,
  o.openaq_2020_mean,
  ABS(o.openaq_2020_mean - e.epa_1990_mean) AS pm25_diff
FROM (
  SELECT
    ROUND(latitude, 2) AS lat2,
    ROUND(longitude, 2) AS lon2,
    AVG(arithmetic_mean) AS epa_1990_mean,
    ANY_VALUE(city_name) AS city_name
  FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
  WHERE LOWER(parameter_name) LIKE '%pm2.5%'
    AND units_of_measure = 'Micrograms/cubic meter (LC)'
    AND EXTRACT(YEAR FROM date_local) = 1990
  GROUP BY lat2, lon2
) AS e
JOIN (
  SELECT
    ROUND(latitude, 2) AS lat2,
    ROUND(longitude, 2) AS lon2,
    AVG(value) AS openaq_2020_mean,
    ANY_VALUE(city) AS city
  FROM `bigquery-public-data.openaq.global_air_quality`
  WHERE pollutant = 'pm25'
    AND EXTRACT(YEAR FROM timestamp) = 2020
  GROUP BY lat2, lon2
) AS o
USING (lat2, lon2)
ORDER BY pm25_diff DESC
LIMIT 3;
```
