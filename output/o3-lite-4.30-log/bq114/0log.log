Relevant tables, columns, and how they will be used  

bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary  
• parameter_name : filter to 'Acceptable PM2.5 AQI & Speciation Mass'  
• units_of_measure : filter to 'Micrograms/cubic meter (LC)'  
• date_local : pick year = 1990  
• latitude / longitude : round to 2 decimals, use to match OpenAQ sites  
• arithmetic_mean : 1990 daily PM2.5 value to aggregate to an annual mean  
• city_name : city label for the result set  

bigquery-public-data.openaq.global_air_quality  
• pollutant : filter to 'pm25'  
• timestamp : pick year = 2020  
• latitude / longitude : round to 2 decimals, match EPA sites  
• value : 2020 PM2.5 value to aggregate to an annual mean  
• city : alternate city label for the result set  

Conditions that will be applied  
• EPA: parameter_name = 'Acceptable PM2.5 AQI & Speciation Mass'  
• EPA: units_of_measure = 'Micrograms/cubic meter (LC)'  
• EPA: EXTRACT(YEAR FROM date_local)=1990  
• OpenAQ: pollutant = 'pm25'  
• OpenAQ: EXTRACT(YEAR FROM timestamp)=2020  
• join key: ROUND(latitude,2) and ROUND(longitude,2)  
• difference = ABS(openAQ_2020_mean – epa_1990_mean)  
• order by difference DESC, limit 3  

-----------------------------------------------------------------
Ten exploratory SQL queries (each limited to 20 rows)

```sql
-- 1. List distinct years available in EPA daily summary
SELECT DISTINCT EXTRACT(YEAR FROM date_local) AS yr
FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
ORDER BY yr
LIMIT 20;
```

```sql
-- 2. Inspect all distinct parameter names that mention PM2.5
SELECT DISTINCT parameter_name
FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
WHERE LOWER(parameter_name) LIKE '%pm2.5%'
LIMIT 20;
```

```sql
-- 3. Check distinct units of measure for PM2.5 speciation
SELECT DISTINCT units_of_measure
FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
WHERE LOWER(parameter_name) LIKE '%pm2.5%'
LIMIT 20;
```

```sql
-- 4. Sample 1990 EPA rows that satisfy the required filters
SELECT state_code, county_code, site_num, date_local, arithmetic_mean,
       latitude, longitude, city_name
FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
WHERE parameter_name = 'Acceptable PM2.5 AQI & Speciation Mass'
  AND units_of_measure = 'Micrograms/cubic meter (LC)'
  AND EXTRACT(YEAR FROM date_local) = 1990
LIMIT 20;
```

```sql
-- 5. Annual‑mean 1990 EPA PM2.5 per site (rounded lat/lon)
SELECT ROUND(latitude,2) AS lat2, ROUND(longitude,2) AS lon2,
       AVG(arithmetic_mean) AS epa_1990_mean
FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
WHERE parameter_name = 'Acceptable PM2.5 AQI & Speciation Mass'
  AND units_of_measure = 'Micrograms/cubic meter (LC)'
  AND EXTRACT(YEAR FROM date_local) = 1990
GROUP BY lat2, lon2
LIMIT 20;
```

```sql
-- 6. Inspect OpenAQ distinct pollutants
SELECT DISTINCT pollutant
FROM `bigquery-public-data.openaq.global_air_quality`
LIMIT 20;
```

```sql
-- 7. Sample 2020 OpenAQ PM2.5 rows
SELECT city, timestamp, value, unit, latitude, longitude
FROM `bigquery-public-data.openaq.global_air_quality`
WHERE pollutant = 'pm25'
  AND EXTRACT(YEAR FROM timestamp) = 2020
LIMIT 20;
```

```sql
-- 8. Annual‑mean 2020 OpenAQ PM2.5 per site (rounded lat/lon)
SELECT ROUND(latitude,2) AS lat2, ROUND(longitude,2) AS lon2,
       AVG(value) AS openaq_2020_mean
FROM `bigquery-public-data.openaq.global_air_quality`
WHERE pollutant = 'pm25'
  AND EXTRACT(YEAR FROM timestamp) = 2020
GROUP BY lat2, lon2
LIMIT 20;
```

```sql
-- 9. Join 1990 EPA and 2020 OpenAQ means on rounded coordinates
SELECT e.lat2, e.lon2, e.epa_1990_mean, o.openaq_2020_mean,
       ABS(o.openaq_2020_mean - e.epa_1990_mean) AS diff
FROM (
  SELECT ROUND(latitude,2) AS lat2, ROUND(longitude,2) AS lon2,
         AVG(arithmetic_mean) AS epa_1990_mean
  FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
  WHERE parameter_name = 'Acceptable PM2.5 AQI & Speciation Mass'
    AND units_of_measure = 'Micrograms/cubic meter (LC)'
    AND EXTRACT(YEAR FROM date_local) = 1990
  GROUP BY lat2, lon2
) e
JOIN (
  SELECT ROUND(latitude,2) AS lat2, ROUND(longitude,2) AS lon2,
         AVG(value) AS openaq_2020_mean
  FROM `bigquery-public-data.openaq.global_air_quality`
  WHERE pollutant = 'pm25'
    AND EXTRACT(YEAR FROM timestamp) = 2020
  GROUP BY lat2, lon2
) o
USING (lat2, lon2)
ORDER BY diff DESC
LIMIT 20;
```

```sql
-- 10. Final query: top‑3 cities with greatest absolute difference
SELECT
  COALESCE(o.city, e.city_name) AS city,
  e.epa_1990_mean,
  o.openaq_2020_mean,
  ABS(o.openaq_2020_mean - e.epa_1990_mean) AS pm25_diff
FROM (
  SELECT ROUND(latitude,2) AS lat2, ROUND(longitude,2) AS lon2,
         AVG(arithmetic_mean) AS epa_1990_mean,
         ANY_VALUE(city_name) AS city_name
  FROM `bigquery-public-data.epa_historical_air_quality.pm25_speciation_daily_summary`
  WHERE parameter_name = 'Acceptable PM2.5 AQI & Speciation Mass'
    AND units_of_measure = 'Micrograms/cubic meter (LC)'
    AND EXTRACT(YEAR FROM date_local) = 1990
  GROUP BY lat2, lon2
) e
JOIN (
  SELECT ROUND(latitude,2) AS lat2, ROUND(longitude,2) AS lon2,
         AVG(value) AS openaq_2020_mean,
         ANY_VALUE(city) AS city
  FROM `bigquery-public-data.openaq.global_air_quality`
  WHERE pollutant = 'pm25'
    AND EXTRACT(YEAR FROM timestamp) = 2020
  GROUP BY lat2, lon2
) o
USING (lat2, lon2)
ORDER BY pm25_diff DESC
LIMIT 3;
```

(The last query returns the three cities whose rounded‑coordinate matches yield the largest absolute change from 1990 EPA PM2.5 to 2020 OpenAQ PM2.5.)
