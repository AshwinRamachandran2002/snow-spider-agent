Relevant columns and their potential usage  
• SALES_INVOICES."InvoiceDate": used to filter records for the calendar months of 2014 and to derive the month‑number (1–12).  
• SALES_INVOICES."CustomerID": identifies the customer who owns the invoice.  
• SALES_INVOICES."InvoiceID": key used to join to the invoice‑line table.  
• SALES_INVOICELINES."InvoiceID": foreign key that links a line to its header.  
• SALES_INVOICELINES."ExtendedPrice": monetary amount at line level to be summed into month totals.  

Typical conditions  
• SALES_INVOICES."InvoiceDate" BETWEEN '2014-01-01' AND '2014-12-31'  
• JOIN SALES_INVOICES i ON i."InvoiceID" = l."InvoiceID"  

Below are ten Snowflake SQL snippets that move step‑by‑step from basic exploration to a final query that returns the requested median.  
(Replace …LIMIT 20 with any limit you need; all identifiers are quoted.)

```sql
-- 1. Description: Peek at a few invoice headers to confirm 2014 dates are present
SELECT i."InvoiceID",
       i."CustomerID",
       i."InvoiceDate"
FROM   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES" i
WHERE  i."InvoiceDate" LIKE '2014-%'
LIMIT 20;
```

```sql
-- 2. Description: Count how many invoices fall inside calendar year 2014
SELECT COUNT(*) AS "invoice_cnt_2014"
FROM   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES" i
WHERE  i."InvoiceDate" BETWEEN '2014-01-01' AND '2014-12-31';
```

```sql
-- 3. Description: Inspect a handful of invoice lines (with money) linked to 2014 headers
SELECT l."InvoiceLineID",
       l."InvoiceID",
       l."ExtendedPrice"
FROM   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" l
JOIN   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"   i
       ON i."InvoiceID" = l."InvoiceID"
WHERE  i."InvoiceDate" BETWEEN '2014-01-01' AND '2014-12-31'
LIMIT 20;
```

```sql
-- 4. Description: Monthly totals per customer for 2014 (first 20 rows only)
SELECT i."CustomerID",
       TO_CHAR(TO_DATE(i."InvoiceDate"), 'YYYY-MM') AS "yyyymm",
       SUM(l."ExtendedPrice")                     AS "month_total"
FROM   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"     i
JOIN   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" l
       ON l."InvoiceID" = i."InvoiceID"
WHERE  i."InvoiceDate" BETWEEN '2014-01-01' AND '2014-12-31'
GROUP  BY i."CustomerID", TO_CHAR(TO_DATE(i."InvoiceDate"), 'YYYY-MM')
ORDER  BY i."CustomerID", "yyyymm"
LIMIT 20;
```

```sql
-- 5. Description: Distinct list of customers that bought something in 2014
SELECT DISTINCT i."CustomerID"
FROM   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES" i
WHERE  i."InvoiceDate" BETWEEN '2014-01-01' AND '2014-12-31'
LIMIT 20;
```

```sql
-- 6. Description: For each customer / month pair, compute month_total; show one customer sample
SELECT i."CustomerID",
       EXTRACT(MONTH FROM TO_DATE(i."InvoiceDate")) AS "month_num",
       SUM(l."ExtendedPrice") AS "month_total"
FROM   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"     i
JOIN   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" l
       ON l."InvoiceID" = i."InvoiceID"
WHERE  i."InvoiceDate" BETWEEN '2014-01-01' AND '2014-12-31'
GROUP  BY i."CustomerID",
          EXTRACT(MONTH FROM TO_DATE(i."InvoiceDate"))
HAVING i."CustomerID" = 1       -- pick a particular customer for quick look
LIMIT 20;
```

```sql
-- 7. Description: Average monthly spending for each customer (dividing by 12 months)
WITH month_tot AS (
    SELECT i."CustomerID",
           EXTRACT(MONTH FROM TO_DATE(i."InvoiceDate")) AS "mth",
           SUM(l."ExtendedPrice")                       AS "month_total"
    FROM   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"     i
    JOIN   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" l
           ON l."InvoiceID" = i."InvoiceID"
    WHERE  i."InvoiceDate" BETWEEN '2014-01-01' AND '2014-12-31'
    GROUP  BY i."CustomerID",
              EXTRACT(MONTH FROM TO_DATE(i."InvoiceDate"))
)
SELECT "CustomerID",
       SUM("month_total") / 12        AS "avg_month_spend_2014"
FROM   month_tot
GROUP  BY "CustomerID"
LIMIT 20;
```

```sql
-- 8. Description: Distribution of those averages sorted ascending
WITH month_tot AS (
    SELECT i."CustomerID",
           EXTRACT(MONTH FROM TO_DATE(i."InvoiceDate")) AS "mth",
           SUM(l."ExtendedPrice")                       AS "month_total"
    FROM   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"     i
    JOIN   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" l
           ON l."InvoiceID" = i."InvoiceID"
    WHERE  i."InvoiceDate" BETWEEN '2014-01-01' AND '2014-12-31'
    GROUP  BY i."CustomerID",
              EXTRACT(MONTH FROM TO_DATE(i."InvoiceDate"))
)
SELECT *
FROM (
      SELECT "CustomerID",
             SUM("month_total") / 12 AS "avg_month_spend_2014"
      FROM   month_tot
      GROUP  BY "CustomerID"
     )
ORDER  BY "avg_month_spend_2014"
LIMIT 20;
```

```sql
-- 9. Description: Compute the median (PERCENTILE_CONT) across the averages
WITH month_tot AS (
    SELECT i."CustomerID",
           EXTRACT(MONTH FROM TO_DATE(i."InvoiceDate")) AS "mth",
           SUM(l."ExtendedPrice")                       AS "month_total"
    FROM   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"     i
    JOIN   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" l
           ON l."InvoiceID" = i."InvoiceID"
    WHERE  i."InvoiceDate" BETWEEN '2014-01-01' AND '2014-12-31'
    GROUP  BY i."CustomerID",
              EXTRACT(MONTH FROM TO_DATE(i."InvoiceDate"))
),
avg_per_cust AS (
    SELECT "CustomerID",
           SUM("month_total") / 12 AS "avg_month_spend_2014"
    FROM   month_tot
    GROUP  BY "CustomerID"
)
SELECT PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY "avg_month_spend_2014") AS "median_avg_month_spend"
FROM   avg_per_cust;
```

```sql
-- 10. Description: Same as #9 but shows the source averages alongside the median (debug view)
WITH month_tot AS (
    SELECT i."CustomerID",
           EXTRACT(MONTH FROM TO_DATE(i."InvoiceDate")) AS "mth",
           SUM(l."ExtendedPrice")                       AS "month_total"
    FROM   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"     i
    JOIN   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" l
           ON l."InvoiceID" = i."InvoiceID"
    WHERE  i."InvoiceDate" BETWEEN '2014-01-01' AND '2014-12-31'
    GROUP  BY i."CustomerID",
              EXTRACT(MONTH FROM TO_DATE(i."InvoiceDate"))
),
avg_per_cust AS (
    SELECT "CustomerID",
           SUM("month_total") / 12 AS "avg_month_spend_2014"
    FROM   month_tot
    GROUP  BY "CustomerID"
),
median_calc AS (
    SELECT PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY "avg_month_spend_2014") AS "median_val"
    FROM   avg_per_cust
)
SELECT a."CustomerID",
       a."avg_month_spend_2014",
       m."median_val"
FROM   avg_per_cust a
CROSS JOIN median_calc m
ORDER  BY a."avg_month_spend_2014"
LIMIT 20;
```

