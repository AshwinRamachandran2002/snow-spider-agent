Begin Exploring Related Columns
Relevant columns and why they matter  
• SALES_INVOICES."InvoiceDate": filter to the 2014 calendar year and derive the month (YYYY‑MM).  
• SALES_INVOICES."CustomerID": identifies which customer placed each invoice.  
• SALES_INVOICES."InvoiceID": joins invoices to their lines.  
• SALES_INVOICELINES."InvoiceID": foreign key to the header table.  
• SALES_INVOICELINES."ExtendedPrice": total value of that invoice line; will be summed.  
• (alt.) SALES_INVOICELINES."Quantity" × "UnitPrice": same purpose if you prefer to re‑calculate line values.  

Typical filter / join conditions that will be used  
• WHERE "InvoiceDate" LIKE '2014-%' – keeps only 2014 data (InvoiceDate is stored as a ‘YYYY‑MM‑DD’ string).  
• SUBSTR("InvoiceDate",1,7) – extracts the month portion ‘YYYY‑MM’.  
• JOIN … ON l."InvoiceID" = i."InvoiceID" – links invoice lines to their headers.  

Ten exploratory‑to‑solution Snowflake SQL queries  
Each query is limited to 20 rows and wrapped in ```sql```; comments explain the progression.

```sql
-- 1. Description: Peek at a few invoice headers from 2014.
SELECT  i."InvoiceID",
        i."CustomerID",
        i."InvoiceDate"
FROM    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"   i
WHERE   i."InvoiceDate" LIKE '2014-%'
LIMIT 20;
```

```sql
-- 2. Description: List distinct months that actually have invoices in 2014.
SELECT  DISTINCT SUBSTR(i."InvoiceDate",1,7)        AS "yyyy_mm"
FROM    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES" i
WHERE   i."InvoiceDate" LIKE '2014-%'
ORDER BY 1
LIMIT 20;
```

```sql
-- 3. Description: Inspect some invoice‑line rows that belong to 2014 headers.
SELECT  l."InvoiceID",
        l."StockItemID",
        l."Quantity",
        l."UnitPrice",
        l."ExtendedPrice"
FROM    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" l
JOIN    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"  i
          ON l."InvoiceID" = i."InvoiceID"
WHERE   i."InvoiceDate" LIKE '2014-%'
LIMIT 20;
```

```sql
-- 4. Description: Calculate the total value per invoice for 2014 (sample).
SELECT  l."InvoiceID",
        SUM(l."ExtendedPrice")        AS "invoice_total"
FROM    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" l
JOIN    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"  i
          ON l."InvoiceID" = i."InvoiceID"
WHERE   i."InvoiceDate" LIKE '2014-%'
GROUP BY l."InvoiceID"
LIMIT 20;
```

```sql
-- 5. Description: Monthly spending by customer (one row per customer‑month, sample).
SELECT  i."CustomerID",
        SUBSTR(i."InvoiceDate",1,7)         AS "yyyy_mm",
        SUM(l."ExtendedPrice")              AS "month_total"
FROM    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" l
JOIN    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"  i
          ON l."InvoiceID" = i."InvoiceID"
WHERE   i."InvoiceDate" LIKE '2014-%'
GROUP BY i."CustomerID", SUBSTR(i."InvoiceDate",1,7)
LIMIT 20;
```

```sql
-- 6. Description: Average monthly spend per customer for the year (sample).
WITH month_totals AS (
     SELECT i."CustomerID",
            SUBSTR(i."InvoiceDate",1,7) AS "yyyy_mm",
            SUM(l."ExtendedPrice")      AS "month_total"
     FROM   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" l
     JOIN   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"  i
            ON l."InvoiceID" = i."InvoiceID"
     WHERE  i."InvoiceDate" LIKE '2014-%'
     GROUP  BY i."CustomerID", SUBSTR(i."InvoiceDate",1,7)
)
SELECT  mt."CustomerID",
        AVG(mt."month_total")           AS "avg_monthly_spend"
FROM    month_totals  mt
GROUP BY mt."CustomerID"
LIMIT 20;
```

```sql
-- 7. Description: Count how many customers have 2014 activity (for context).
SELECT  COUNT(DISTINCT i."CustomerID")   AS "active_customers_2014"
FROM    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES" i
WHERE   i."InvoiceDate" LIKE '2014-%'
LIMIT 20;
```

```sql
-- 8. Description: See distribution (five‑number summary) of the average monthly spend.
WITH per_cust AS (
     SELECT i."CustomerID",
            AVG(SUM(l."ExtendedPrice")) OVER (PARTITION BY i."CustomerID") 
            AS "avg_monthly_spend"
     FROM   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" l
     JOIN   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"  i
            ON l."InvoiceID" = i."InvoiceID"
     WHERE  i."InvoiceDate" LIKE '2014-%'
     GROUP  BY i."CustomerID", SUBSTR(i."InvoiceDate",1,7)
)
SELECT  PERCENTILE_CONT(0.00) WITHIN GROUP (ORDER BY "avg_monthly_spend") AS "min",
        PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY "avg_monthly_spend") AS "q1",
        PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY "avg_monthly_spend") AS "median",
        PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY "avg_monthly_spend") AS "q3",
        PERCENTILE_CONT(1.00) WITHIN GROUP (ORDER BY "avg_monthly_spend") AS "max"
FROM    per_cust
LIMIT 20;
```

```sql
-- 9. Description: List customers whose average monthly spend is above the overall median.
WITH month_totals AS (
     SELECT i."CustomerID",
            SUBSTR(i."InvoiceDate",1,7) AS "yyyy_mm",
            SUM(l."ExtendedPrice")      AS "month_total"
     FROM   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" l
     JOIN   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"  i
            ON l."InvoiceID" = i."InvoiceID"
     WHERE  i."InvoiceDate" LIKE '2014-%'
     GROUP  BY i."CustomerID", SUBSTR(i."InvoiceDate",1,7)
), avg_spend AS (
     SELECT  "CustomerID",
             AVG("month_total") AS "avg_monthly_spend"
     FROM    month_totals
     GROUP   BY "CustomerID"
), med AS (
     SELECT  PERCENTILE_CONT(0.5) WITHIN GROUP(ORDER BY "avg_monthly_spend") AS "med_spend"
     FROM    avg_spend
)
SELECT  a."CustomerID",
        a."avg_monthly_spend"
FROM    avg_spend   a,
        med         m
WHERE   a."avg_monthly_spend" > m."med_spend"
LIMIT 20;
```

```sql
-- 10. Description: Full calculation that returns only the overall median of the average
--     monthly spend across all customers for calendar year 2014.
WITH month_totals AS (
     SELECT i."CustomerID",
            SUBSTR(i."InvoiceDate",1,7) AS "yyyy_mm",
            SUM(l."ExtendedPrice")      AS "month_total"
     FROM   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" l
     JOIN   "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"  i
            ON l."InvoiceID" = i."InvoiceID"
     WHERE  i."InvoiceDate" LIKE '2014-%'
     GROUP  BY i."CustomerID", SUBSTR(i."InvoiceDate",1,7)
), avg_spend AS (
     SELECT  "CustomerID",
             AVG("month_total") AS "avg_monthly_spend"
     FROM    month_totals
     GROUP   BY "CustomerID"
)
SELECT  PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY "avg_monthly_spend")  AS "median_avg_monthly_spend_2014"
FROM    avg_spend
LIMIT 20;
```

