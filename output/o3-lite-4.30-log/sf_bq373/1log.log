--Description: Five‑number summary of customers’ average monthly spend in 2014.
WITH month_totals AS (
    SELECT  i."CustomerID",
            SUBSTR(i."InvoiceDate", 1, 7) AS "yyyy_mm",
            SUM(l."ExtendedPrice")        AS "month_total"
    FROM    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" AS l
    JOIN    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"     AS i
           ON l."InvoiceID" = i."InvoiceID"
    WHERE   i."InvoiceDate" LIKE '2014-%'
    GROUP BY i."CustomerID", SUBSTR(i."InvoiceDate", 1, 7)
), avg_per_cust AS (
    SELECT  "CustomerID",
            AVG("month_total") AS "avg_monthly_spend"
    FROM    month_totals
    GROUP BY "CustomerID"
)
SELECT  PERCENTILE_CONT(0.00) WITHIN GROUP (ORDER BY "avg_monthly_spend") AS "min",
        PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY "avg_monthly_spend") AS "q1",
        PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY "avg_monthly_spend") AS "median",
        PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY "avg_monthly_spend") AS "q3",
        PERCENTILE_CONT(1.00) WITHIN GROUP (ORDER BY "avg_monthly_spend") AS "max"
FROM    avg_per_cust
LIMIT 20
