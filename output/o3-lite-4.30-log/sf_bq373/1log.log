```sql
--Description:
-- THINKING PROCESS
--  • Combine invoice lines with their headers to know CustomerID and InvoiceDate. 
--  • Filter to the 2014 calendar year (InvoiceDate text begins with '2014-'). 
--  • Convert each InvoiceDate to the month key 'YYYY‑MM' via SUBSTR. 
--  • For each CustomerID‑month pair, sum ExtendedPrice ⇒ month_totals. 
--  • For each CustomerID, average those month_totals ⇒ avg_per_cust (their avg monthly spend). 
--  • Take the median (0.5 percentile) of all customers’ avg monthly spend values. 
--  • Return that single figure labelled MedianOfAvgMonthlySpend_2014.

WITH month_totals AS (
    SELECT  i."CustomerID",
            SUBSTR(i."InvoiceDate", 1, 7)        AS "Month",
            SUM(l."ExtendedPrice")               AS "MonthTotal"
    FROM    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES"  l
    JOIN    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"      i
         ON l."InvoiceID" = i."InvoiceID"
    WHERE   i."InvoiceDate" LIKE '2014-%'
    GROUP BY i."CustomerID", SUBSTR(i."InvoiceDate", 1, 7)
), avg_per_cust AS (
    SELECT  "CustomerID",
            AVG("MonthTotal")                    AS "AvgMonthlySpend"
    FROM    month_totals
    GROUP BY "CustomerID"
)
SELECT  PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY "AvgMonthlySpend")
           AS "MedianOfAvgMonthlySpend_2014"
FROM    avg_per_cust;
```
