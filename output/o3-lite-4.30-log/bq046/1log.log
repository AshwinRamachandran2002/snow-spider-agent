Ten exploratory → final BigQuery SQL statements  
(each returns ≤ 20 rows for safety)  

```sql
-- 1. Preview distinct annotation categories at the Patient level
SELECT DISTINCT category
FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
WHERE entity_type = 'Patient'
LIMIT 20;
```

```sql
-- 2. Preview distinct annotation classifications at the Patient level
SELECT DISTINCT classification
FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
WHERE entity_type = 'Patient'
LIMIT 20;
```

```sql
-- 3. List BRCA patients that are flagged by the categories / classifications of interest
SELECT DISTINCT
       entity_barcode AS case_barcode,
       case_gdc_id,
       category,
       classification
FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
WHERE entity_type = 'Patient'
  AND (category = 'History of unacceptable prior treatment related to a prior/other malignancy'
       OR classification = 'Redaction')
LIMIT 20;
```

```sql
-- 4. Inspect young (≤30 y) female BRCA patients in the Clinical table
SELECT DISTINCT
       case_barcode,
       case_gdc_id,
       gender,
       age_at_diagnosis
FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
WHERE disease_code = 'BRCA'
  AND UPPER(gender) = 'FEMALE'
  AND age_at_diagnosis IS NOT NULL
  AND age_at_diagnosis <= 30
LIMIT 20;
```

```sql
-- 5. Count how many such young female BRCA patients exist
SELECT COUNT(DISTINCT case_barcode) AS n_young_brca_female
FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
WHERE disease_code = 'BRCA'
  AND UPPER(gender) = 'FEMALE'
  AND age_at_diagnosis IS NOT NULL
  AND age_at_diagnosis <= 30;
```

```sql
-- 6. FULL JOIN the two sets (flagged vs young‑female‑BRCA); preview the join result
WITH flagged AS (
  SELECT DISTINCT entity_barcode AS case_barcode,
                  case_gdc_id,
                  category AS categoryName,
                  classification AS classificationName
  FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
  WHERE entity_type = 'Patient'
    AND (category = 'History of unacceptable prior treatment related to a prior/other malignancy'
         OR classification = 'Redaction')
),
clinical AS (
  SELECT DISTINCT case_barcode,
                  case_gdc_id
  FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
  WHERE disease_code = 'BRCA'
    AND UPPER(gender) = 'FEMALE'
    AND age_at_diagnosis IS NOT NULL
    AND age_at_diagnosis <= 30
)
SELECT *
FROM clinical
FULL JOIN flagged
USING (case_barcode, case_gdc_id)
LIMIT 20;
```

```sql
-- 7. Select only those who are in the Clinical subset but NOT in the flagged subset
WITH flagged AS (
  SELECT DISTINCT entity_barcode AS case_barcode,
                  case_gdc_id,
                  category AS categoryName,
                  classification AS classificationName
  FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
  WHERE entity_type = 'Patient'
    AND (category = 'History of unacceptable prior treatment related to a prior/other malignancy'
         OR classification = 'Redaction')
),
clinical AS (
  SELECT DISTINCT case_barcode,
                  case_gdc_id
  FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
  WHERE disease_code = 'BRCA'
    AND UPPER(gender) = 'FEMALE'
    AND age_at_diagnosis IS NOT NULL
    AND age_at_diagnosis <= 30
)
SELECT c.*
FROM clinical  AS c
LEFT JOIN flagged AS f
USING (case_barcode, case_gdc_id)
WHERE f.case_barcode IS NULL
LIMIT 20;
```

```sql
-- 8. Pull one example case’s files (archive Release 14) to see columns we can use
SELECT DISTINCT
       fdc.file_id,
       fdc.file_name,
       fdc.associated_entities__case_id
FROM `isb-cgc.GDC_metadata.rel14_fileData_current` AS fdc
WHERE fdc.associated_entities__case_id = 'REPLACE_WITH_A_CASE_UUID'
LIMIT 20;
```

```sql
-- 9. Map those file_ids to their GCS URLs
SELECT fdc.file_id,
       url.file_gdc_url
FROM `isb-cgc.GDC_metadata.rel14_fileData_current` AS fdc
JOIN `isb-cgc.GDC_metadata.rel14_GDCfileID_to_GCSurl_NEW`  AS url
     ON url.file_gdc_id = fdc.file_id
WHERE fdc.associated_entities__case_id = 'REPLACE_WITH_A_CASE_UUID'
LIMIT 20;
```

```sql
-- 10. FINAL QUERY : case barcodes of interest (young female BRCA, not flagged) 
-- together with every Release‑14 current file URL
WITH flagged AS (
  SELECT DISTINCT entity_barcode AS case_barcode,
                  case_gdc_id,
                  category AS categoryName,
                  classification AS classificationName
  FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
  WHERE entity_type = 'Patient'
    AND (category = 'History of unacceptable prior treatment related to a prior/other malignancy'
         OR classification = 'Redaction')
),
clinical AS (
  SELECT DISTINCT case_barcode,
                  case_gdc_id
  FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
  WHERE disease_code = 'BRCA'
    AND UPPER(gender) = 'FEMALE'
    AND age_at_diagnosis IS NOT NULL
    AND age_at_diagnosis <= 30
),
target_cases AS (
  -- keep only those NOT present in the flagged list
  SELECT c.case_barcode,
         c.case_gdc_id
  FROM clinical AS c
  LEFT JOIN flagged AS f
    ON c.case_barcode = f.case_barcode
   AND c.case_gdc_id  = f.case_gdc_id
  WHERE f.case_barcode IS NULL
)
SELECT DISTINCT
       tc.case_barcode,
       url.file_gdc_url
FROM target_cases                            AS tc
JOIN `isb-cgc.GDC_metadata.rel14_fileData_current`       AS fdc
     ON (fdc.associated_entities__case_id = tc.case_gdc_id
         OR fdc.cases__case_id             = tc.case_gdc_id)
JOIN `isb-cgc.GDC_metadata.rel14_GDCfileID_to_GCSurl_NEW` AS url
     ON url.file_gdc_id = fdc.file_id
LIMIT 20;
```

Each query builds a piece of the logic, culminating in #10 which returns the required `(case_barcode, file_gdc_url)` pairs for TCGA BRCA female patients aged ≤ 30 years, free of the specified annotation flags, using files from GDC Release 14.
