  SELECT DISTINCT
         entity_barcode AS case_barcode,
         case_gdc_id
  FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
  WHERE entity_type = 'Patient'
    AND (category = 'History of unacceptable prior treatment related to a prior/other malignancy'
         OR classification = 'Redaction')
),
clinical AS (
  SELECT DISTINCT
         case_barcode,
         case_gdc_id
  FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
  WHERE disease_code = 'BRCA'
    AND UPPER(gender) = 'FEMALE'
    AND age_at_diagnosis IS NOT NULL
    AND age_at_diagnosis <= 30
),
target_cases AS (
  SELECT c.case_barcode,
         c.case_gdc_id
  FROM clinical AS c
  LEFT JOIN flagged AS f
    ON c.case_barcode = f.case_barcode
   AND c.case_gdc_id  = f.case_gdc_id
  WHERE f.case_barcode IS NULL          -- keep only un‑flagged patients
)
SELECT DISTINCT
       tc.case_barcode,
       fdc.file_id,
       fdc.file_name,
       url.file_gdc_url
FROM target_cases                                         AS tc
JOIN `isb-cgc.GDC_metadata.rel14_fileData_current`        AS fdc
  ON fdc.case_gdc_id = tc.case_gdc_id
LEFT JOIN `isb-cgc.GDC_metadata.rel14_GDCfileID_to_GCSurl_NEW` AS url
