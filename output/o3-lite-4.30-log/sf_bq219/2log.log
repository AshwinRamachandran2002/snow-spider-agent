--Description: Compute the average monthly share for every category (≥2022‑01‑01 to
--             last completed month).  Steps:
--   1) month_cat  – litres per category per month
--   2) month_tot  – total litres per month
--   3) joined     – %‑of‑total per category per month
--   4) Final      – average of those monthly percentages for each category
WITH month_cat AS (                              -- step 1
    SELECT DATE_TRUNC('month', "date") AS "month",
           "category_name",
           SUM("volume_sold_liters")   AS "cat_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
      AND "date" <  DATE_TRUNC('month', CURRENT_DATE)
    GROUP BY 1, 2
), month_tot AS (                                -- step 2
    SELECT "month",
           SUM("cat_liters") AS "total_liters"
    FROM   month_cat
    GROUP BY 1
), joined AS (                                   -- step 3
    SELECT c."month",
           c."category_name",
           c."cat_liters" / t."total_liters" AS "pct_of_total"
    FROM   month_cat c
    JOIN   month_tot t USING ("month")
)
SELECT "category_name",
       AVG("pct_of_total") AS "avg_monthly_pct"  -- step 4
FROM   joined
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20
