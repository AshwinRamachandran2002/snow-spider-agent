--Description: Compute Pearson correlation of monthly %‑of‑total between two sample
--             categories (‘SCOTCH WHISKIES’ vs ‘100% AGAVE TEQUILA’).  The data are first
--             pivoted so each month supplies a single row with two numeric columns.
WITH pct AS (                                   -- % per category per month
    SELECT DATE_TRUNC('month', "date") AS "month",
           "category_name",
           SUM("volume_sold_liters") AS "cat_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
      AND "date" <  DATE_TRUNC('month', CURRENT_DATE)
    GROUP BY 1,2
), tot AS (
    SELECT "month",
           SUM("cat_liters") AS "tot_liters"
    FROM pct
    GROUP BY 1
), pct2 AS (
    SELECT p."month",
           p."category_name",
           p."cat_liters" / t."tot_liters" AS "pct_of_total"
    FROM pct p
    JOIN tot t USING ("month")
), pivot AS (                                   -- put both categories on one row
    SELECT "month",
           MAX(CASE WHEN "category_name" = 'SCOTCH WHISKIES'      THEN "pct_of_total" END) AS "SCOTCH",
           MAX(CASE WHEN "category_name" = '100% AGAVE TEQUILA'   THEN "pct_of_total" END) AS "TEQUILA"
    FROM pct2
    WHERE "category_name" IN ('SCOTCH WHISKIES', '100% AGAVE TEQUILA')
    GROUP BY "month"
)
SELECT CORR("SCOTCH", "TEQUILA") AS "corr_coeff"
FROM   pivot
LIMIT 20;
```

```sql
--Description: Final analytic query – among all categories that average ≥ 1 % share
--             and exist in ≥ 24 months (since 2022‑01‑01), find the pair with the LOWEST
--             Pearson correlation in their monthly shares.
WITH monthly AS (                               -- litres per category per month
    SELECT DATE_TRUNC('month', "date") AS "month",
           "category_name",
           SUM("volume_sold_liters")   AS "cat_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
      AND "date" <  DATE_TRUNC('month', CURRENT_DATE)
    GROUP BY 1,2
), month_tot AS (                               -- total litres per month
    SELECT "month",
           SUM("cat_liters") AS "total_liters"
    FROM   monthly
    GROUP BY 1
), pct AS (                                     -- %‑of‑total per category per month
    SELECT m."month",
           m."category_name",
           m."cat_liters" / t."total_liters" AS "pct_of_total"
    FROM   monthly m
    JOIN   month_tot t USING ("month")
), qualified AS (                               -- categories meeting 1 % & 24‑month rules
    SELECT "category_name"
    FROM   pct
    GROUP BY 1
    HAVING COUNT(*) >= 24
       AND AVG("pct_of_total") >= 0.01
), q_pct AS (
    SELECT p.*
    FROM   pct  p
    JOIN   qualified q USING ("category_name")
), pairs AS (                                   -- compute correlations for every pair
    SELECT a."category_name" AS "cat1",
           b."category_name" AS "cat2",
           CORR(a."pct_of_total", b."pct_of_total") AS "corr_coeff"
    FROM   q_pct a
    JOIN   q_pct b
      ON   a."month" = b."month"
     AND   a."category_name" < b."category_name"
    GROUP BY 1,2
)
SELECT "cat1",
       "cat2",
       "corr_coeff"
FROM   pairs
ORDER  BY "corr_coeff"      -- ascending: lowest correlation first
LIMIT 20;
```
