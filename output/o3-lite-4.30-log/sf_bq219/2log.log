```

```sql
-- 3) Description: Monthly total volume (all categories combined) since 2022‑01‑01
SELECT DATE_TRUNC('month', "date")   AS "month",
       SUM("volume_sold_liters")     AS "total_liters"
FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
WHERE "date" >= '2022-01-01'
  AND "date" <  DATE_TRUNC('month', CURRENT_DATE)
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
-- 4) Description: Monthly volume per category (raw litres)
SELECT DATE_TRUNC('month', "date")   AS "month",
       "category_name",
       SUM("volume_sold_liters")     AS "cat_liters"
FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
WHERE "date" >= '2022-01-01'
  AND "date" <  DATE_TRUNC('month', CURRENT_DATE)
GROUP BY 1, 2
ORDER BY 1, 2
LIMIT 20;
```

```sql
-- 5) Description: Same as #4 but joined to total to create a %‑of‑month column for two sample categories
WITH monthly_tot AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         SUM("volume_sold_liters")   AS "total_liters"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
    AND "date" <  DATE_TRUNC('month', CURRENT_DATE)
  GROUP BY 1
)
SELECT m."month",
       s."category_name",
       SUM(s."volume_sold_liters") / m."total_liters" AS "pct_of_total"
FROM  "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES" s
JOIN  monthly_tot m
  ON  m."month" = DATE_TRUNC('month', s."date")
WHERE s."category_name" ILIKE '%VODKA%'         -- change freely
  AND s."date" >= '2022-01-01'
  AND s."date" <  DATE_TRUNC('month', CURRENT_DATE)
GROUP BY 1,2
ORDER BY 1
LIMIT 20;
```

```sql
-- 6) Description: Compute the average monthly share for every category
WITH monthly_tot AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         SUM("volume_sold_liters")   AS "total_liters"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
    AND "date" <  DATE_TRUNC('month', CURRENT_DATE)
  GROUP BY 1
)
SELECT s."category_name",
       AVG(SUM(s."volume_sold_liters") / m."total_liters") OVER (PARTITION BY s."category_name")
         AS "avg_monthly_pct"
FROM  "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES" s
JOIN  monthly_tot m
  ON  m."month" = DATE_TRUNC('month', s."date")
WHERE s."date" >= '2022-01-01'
  AND s."date" <  DATE_TRUNC('month', CURRENT_DATE)
GROUP BY s."category_name", m."month"
LIMIT 20;
```

```sql
-- 7) Description: List those categories whose average monthly share ≥ 1 % and that appear in ≥ 24 months
WITH month_cat AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         "category_name",
         SUM("volume_sold_liters")   AS "cat_liters"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
    AND "date" <  DATE_TRUNC('month', CURRENT_DATE)
  GROUP BY 1,2
), month_tot AS (
  SELECT "month",
         SUM("cat_liters") AS "total_liters"
  FROM   month_cat
  GROUP BY 1
), joined AS (
  SELECT c."month",
         c."category_name",
         c."cat_liters" / t."total_liters" AS "pct_of_total"
  FROM   month_cat c
  JOIN   month_tot t USING ("month")
)
SELECT "category_name",
       COUNT(*)                          AS "months_present",
       AVG("pct_of_total")               AS "avg_monthly_pct"
FROM   joined
GROUP BY 1
HAVING COUNT(*) >= 24
   AND AVG("pct_of_total") >= 0.01
ORDER BY "avg_monthly_pct" DESC
LIMIT 20;
```

```sql
-- 8) Description: Build a “wide” table of category percentages per month for the qualifying categories
WITH month_cat AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         "category_name",
         SUM("volume_sold_liters")   AS "cat_liters"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
    AND "date" <  DATE_TRUNC('month', CURRENT_DATE)
  GROUP BY 1,2
), month_tot AS (
  SELECT "month",
         SUM("cat_liters") AS "total_liters"
  FROM   month_cat
  GROUP BY 1
), joined AS (
  SELECT c."month",
         c."category_name",
         c."cat_liters" / t."total_liters" AS "pct_of_total"
  FROM   month_cat c
  JOIN   month_tot t USING ("month")
), qualified AS (
  SELECT "category_name"
  FROM   joined
  GROUP BY 1
  HAVING COUNT(*) >= 24
     AND AVG("pct_of_total") >= 0.01
), filtered AS (
  SELECT j.*
  FROM   joined j
  JOIN   qualified q USING ("category_name")
)
SELECT *
FROM   filtered
ORDER BY "month", "category_name"
LIMIT 20;
```

```sql
-- 9) Description: Calculate Pearson correlation between two example categories (replace with actual names)
WITH pct AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         "category_name",
         SUM("volume_sold_liters") AS "cat_liters"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
    AND "date" <  DATE_TRUNC('month', CURRENT_DATE)
  GROUP BY 1,2
), tot AS (
  SELECT "month",
         SUM("cat_liters") AS "tot_liters"
  FROM pct
  GROUP BY 1
), pct2 AS (
  SELECT p."month",
         p."category_name",
         p."cat_liters" / t."tot_liters" AS "pct_of_total"
  FROM pct p
  JOIN tot t USING ("month")
), pick AS (
  SELECT *
  FROM pct2
  WHERE "category_name" IN ('SCOTCH', 'TEQUILA')     -- sample only
)
SELECT CORR(CASE WHEN "category_name" = 'SCOTCH'  THEN "pct_of_total" END,
            CASE WHEN "category_name" = 'TEQUILA' THEN "pct_of_total" END) AS "corr_coeff"
FROM pick
LIMIT 20;
```

```sql
-- 10) Description: Final query – find the two qualifying categories (≥ 1 % avg share, ≥ 24 months)
--                     that exhibit the lowest Pearson correlation in their monthly shares.
WITH monthly AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         "category_name",
         SUM("volume_sold_liters")   AS "cat_liters"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
    AND "date" <  DATE_TRUNC('month', CURRENT_DATE)
  GROUP BY 1,2
), month_tot AS (
  SELECT "month",
         SUM("cat_liters") AS "total_liters"
  FROM   monthly
  GROUP BY 1
), pct AS (
  SELECT m."month",
         m."category_name",
         m."cat_liters" / t."total_liters" AS "pct_of_total"
  FROM   monthly m
  JOIN   month_tot t USING ("month")
), qualified AS (
  SELECT "category_name"
  FROM   pct
  GROUP BY 1
  HAVING COUNT(*) >= 24
     AND AVG("pct_of_total") >= 0.01
), q_pct AS (
  SELECT p.*
  FROM   pct  p
  JOIN   qualified q USING ("category_name")
), pairs AS (
  SELECT a."category_name"           AS "cat1",
         b."category_name"           AS "cat2",
         CORR(a."pct_of_total", b."pct_of_total") AS "corr_coeff"
  FROM   q_pct a
  JOIN   q_pct b
    ON   a."month" = b."month"
   AND   a."category_name" < b."category_name"
  GROUP BY 1,2
)
SELECT "cat1", "cat2", "corr_coeff"
FROM   pairs
ORDER BY "corr_coeff"    -- ascending => lowest correlation first
LIMIT 20;
```

Each successive query increases in analytical depth, ending with a statement that will return the two liquor categories—subject to the stated 1 % average share and 24‑month presence rules—that exhibit the lowest Pearson correlation in their monthly market‑share trajectories.
