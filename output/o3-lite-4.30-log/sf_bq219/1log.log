--Description / Thinking process:
-- We have to discover the two liquor categories that (a) appear in ≥ 24
-- months since 2022‑01‑01, (b) average at least 1 % of each month’s total
-- liters, and (c) exhibit the LOWEST Pearson correlation when comparing
-- their monthly percentage shares.
--
-- Step‑by‑step inside one query:
-- 1. CTE cat_month
--      • Truncate dates to month.
--      • Compute pct_of_month = category liters ÷ month’s total liters
--        using a window sum for the denominator.
--      • QUALIFY enforces the 24‑month and 1 % criteria for each category.
-- 2. CTE pair_stats
--      • Self‑join cat_month on month to line up every qualifying
--        category pair for each month; keep cat_a < cat_b to avoid
--        duplicate orderings and self‑pairs.
-- 3. Final SELECT
--      • GROUP BY the two category names.
--      • CORR(pct_a, pct_b) gives the Pearson correlation across all
--        months where both categories exist (they all do by construction).
--      • Order ascending so the lowest correlation is first; LIMIT 20
--        (change to 1 if only the single minimum is required).

WITH cat_month AS (
    SELECT
        DATE_TRUNC('MONTH', s."date")                                   AS sales_month,
        s."category_name",
        /* category’s share of that month’s liters */
        SUM(s."volume_sold_liters")
          / SUM(SUM(s."volume_sold_liters")) OVER (PARTITION BY DATE_TRUNC('MONTH', s."date"))
          AS pct_of_month
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES" s
    WHERE s."date" >= '2022-01-01'
    GROUP BY 1, 2
    QUALIFY COUNT(*) OVER (PARTITION BY "category_name") >= 24
        AND AVG(pct_of_month) OVER (PARTITION BY "category_name") >= 0.01
),
pair_stats AS (
    SELECT
        a.sales_month,
        a."category_name" AS cat_a,
        b."category_name" AS cat_b,
        a.pct_of_month    AS pct_a,
        b.pct_of_month    AS pct_b
    FROM cat_month a
    JOIN cat_month b
      ON a.sales_month = b.sales_month
     AND a."category_name" < b."category_name"          -- remove duplicates/self‑pairs
)
SELECT
    cat_a AS category_name_1,
    cat_b AS category_name_2,
    CORR(pct_a, pct_b) AS pearson_corr
FROM pair_stats
GROUP BY cat_a, cat_b
ORDER BY pearson_corr ASC
LIMIT 20;
