    SELECT
        ml.sales_month,
        ml."category_name",
        ml.liters / mt.tot_liters AS pct_of_month
    FROM monthly_liters ml
    JOIN month_totals  mt  ON ml.sales_month = mt.sales_month
),
qualified AS (                -- 4) categories present ≥ 24 months & avg share ≥ 1 %
    SELECT *
    FROM cat_month_pct
    QUALIFY COUNT(*)  OVER (PARTITION BY "category_name") >= 24
       AND AVG(pct_of_month) OVER (PARTITION BY "category_name") >= 0.01
),
pair_corr AS (                -- 5) Pearson correlation for each category pair
    SELECT
        a."category_name" AS cat_a,
        b."category_name" AS cat_b,
        CORR(a.pct_of_month, b.pct_of_month) AS pearson_corr
    FROM qualified a
    JOIN qualified b
      ON a.sales_month = b.sales_month
     AND a."category_name" < b."category_name"     -- unique unordered pairs
    GROUP BY cat_a, cat_b
),
lowest AS (                    -- 6) rank pairs by correlation
    SELECT
        cat_a, cat_b, pearson_corr,
        RANK() OVER (ORDER BY pearson_corr ASC) AS rnk
    FROM pair_corr
)
SELECT
    cat_a AS category_name_1,
    cat_b AS category_name_2,
    pearson_corr
FROM lowest
WHERE rnk = 1     -- lowest correlation
LIMIT 20;         -- in case multiple pairs tie for rank 1
