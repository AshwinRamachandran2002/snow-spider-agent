--Description:
-- We need the pair of qualifying liquor categories whose monthly share of total liters
-- (from 2022‑01‑01 through the last full month) has the lowest Pearson correlation.
-- A “qualifying” category:
--   • Appears in at least 24 months of the time window
--   • Holds an average ≥ 1 % of each month’s liters.
-- Steps in the single query:
--   1) cat_month CTE: for every month & category, compute pct_of_month =
--      category liters ÷ month total liters.  Window SUM over the month gives
--      the denominator.  QUALIFY enforces the 24‑month / 1 % rules.
--   2) Self‑join cat_month on month to create category pairs (cat_a < cat_b
--      prevents duplicates and self pairs).
--   3) GROUP BY the two category names and use CORR() on their aligned
--      pct_of_month series to obtain each pair’s Pearson correlation.
--   4) ORDER ascending and LIMIT 20 (change to LIMIT 1 if only the very lowest
--      pair is required).

WITH cat_month AS (
    SELECT
        DATE_TRUNC('MONTH', s."date") AS "sales_month",
        s."category_name",
        SUM(s."volume_sold_liters")
          / SUM(SUM(s."volume_sold_liters")) OVER (PARTITION BY DATE_TRUNC('MONTH', s."date"))
          AS "pct_of_month"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES" s
    WHERE s."date" >= '2022-01-01'
    GROUP BY 1, 2
    QUALIFY COUNT(*) OVER (PARTITION BY "category_name") >= 24
        AND AVG("pct_of_month") OVER (PARTITION BY "category_name") >= 0.01
)
SELECT
    c1."category_name"                          AS "category_name_1",
    c2."category_name"                          AS "category_name_2",
    CORR(c1."pct_of_month", c2."pct_of_month")  AS "pearson_corr"
FROM   cat_month c1
JOIN   cat_month c2
  ON   c1."sales_month" = c2."sales_month"
 AND   c1."category_name" < c2."category_name"
GROUP  BY c1."category_name", c2."category_name"
ORDER  BY "pearson_corr" ASC
LIMIT 20;
