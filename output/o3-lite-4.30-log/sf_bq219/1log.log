```sql
--Description:
-- One‑shot query that returns EVERY liquor‑category pair whose monthly percentage
-- share of total liters (from 2022‑01‑01 through the latest fully‑completed month)
-- has the overall MINIMUM Pearson correlation.  Each category must :
--   • appear in at least 24 distinct months, and
--   • maintain an average monthly share ≥ 1 %.
--
-- Steps embodied in the query:
-- 1) monthly_liters  – sum liters for each (month, category) while discarding the current
--    partial month.
-- 2) month_totals    – total liters per month (denominator for percentages).
-- 3) cat_month_pct   – compute pct_of_month = category_liters ÷ month_total_liters.
-- 4) qualified       – filter categories to those meeting the 24‑month / 1 % rules.
-- 5) pair_corr       – self‑join qualified rows on month, create unique unordered
--    category pairs, and compute Pearson correlation for each pair.
-- 6) ranked          – dense‑rank pairs by correlation so every tie at the minimum
--    receives rank 1.
-- 7) Final SELECT    – return all pairs whose rank = 1 (i.e., the lowest correlation).

WITH monthly_liters AS (  -- (month, category) liters; exclude current partial month
    SELECT
        DATE_TRUNC('MONTH', "date")       AS sales_month,
        "category_name",
        SUM("volume_sold_liters")         AS liters
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
      AND DATE_TRUNC('MONTH', "date")
            <= DATE_TRUNC('MONTH', DATEADD(month, -1, CURRENT_DATE))
    GROUP BY sales_month, "category_name"
),
month_totals AS (  -- total liters per month
    SELECT
        sales_month,
        SUM(liters) AS tot_liters
    FROM monthly_liters
    GROUP BY sales_month
),
cat_month_pct AS (  -- monthly percentage for each category
    SELECT
        ml.sales_month,
        ml."category_name",
        ml.liters / mt.tot_liters AS pct_of_month
    FROM monthly_liters ml
    JOIN month_totals  mt ON ml.sales_month = mt.sales_month
),
qualified AS (  -- categories present ≥24 months & avg share ≥1 %
    SELECT *
    FROM cat_month_pct
    QUALIFY COUNT(*)  OVER (PARTITION BY "category_name") >= 24
       AND AVG(pct_of_month) OVER (PARTITION BY "category_name") >= 0.01
),
pair_corr AS (  -- Pearson correlation for every unique category pair
    SELECT
        a."category_name" AS cat_a,
        b."category_name" AS cat_b,
        CORR(a.pct_of_month, b.pct_of_month) AS pearson_corr
    FROM qualified a
    JOIN qualified b
      ON a.sales_month = b.sales_month
     AND a."category_name" < b."category_name"
    GROUP BY cat_a, cat_b
),
ranked AS (  -- dense rank to catch ties at the minimum
    SELECT
        cat_a,
        cat_b,
        pearson_corr,
        DENSE_RANK() OVER (ORDER BY pearson_corr ASC) AS rnk
    FROM pair_corr
)
SELECT
    cat_a AS category_name_1,
    cat_b AS category_name_2,
    pearson_corr
FROM ranked
WHERE rnk = 1;
