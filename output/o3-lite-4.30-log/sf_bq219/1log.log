--Description:
-- Find the single pair of liquor categories whose monthly percentage share of
-- total liters (from 01‑Jan‑2022 through the last fully‑completed month) shows
-- the LOWEST Pearson correlation.  A “qualifying” category must:
--   • appear in at least 24 of those months, and
--   • hold an average ≥ 1 % of each month’s liters.
-- Query outline
-- 1) month_tot   – total liters per month (date range restricted and current
--                  partial month removed).
-- 2) cat_month   – litres & pct_of_month for every (month, category).
-- 3) qual_cat    – list of categories meeting the 24‑month / 1 % rules.
-- 4) pct_q       – cat_month trimmed to qualifying categories only.
-- 5) pairs       – self‑join pct_q on month (cat_a < cat_b) to prepare aligned
--                  percentage series for each pair.
-- 6) final       – aggregate with CORR(pct_a, pct_b) and return the minimum.

WITH month_tot AS (
    SELECT
        DATE_TRUNC('MONTH', "date")                AS sales_month,
        SUM("volume_sold_liters")                  AS tot_liters
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
      AND DATE_TRUNC('MONTH', "date")
          <= DATE_TRUNC('MONTH', DATEADD(month, -1, CURRENT_DATE))   -- last full month
    GROUP BY sales_month
),
cat_month AS (
    SELECT
        DATE_TRUNC('MONTH', s."date")              AS sales_month,
        s."category_name",
        SUM(s."volume_sold_liters")                AS cat_liters,
        SUM(s."volume_sold_liters") / mt.tot_liters AS pct_of_month
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES" s
    JOIN month_tot mt
      ON DATE_TRUNC('MONTH', s."date") = mt.sales_month
    GROUP BY sales_month, s."category_name", mt.tot_liters
),
qual_cat AS (
    SELECT
        "category_name"
    FROM cat_month
    GROUP BY "category_name"
    HAVING COUNT(*) >= 24              -- appears in ≥ 24 months
       AND AVG(pct_of_month) >= 0.01   -- ≥ 1 % average monthly share
),
pct_q AS (
    SELECT *
    FROM cat_month
    WHERE "category_name" IN (SELECT "category_name" FROM qual_cat)
),
pairs AS (
    SELECT
        a."category_name" AS cat_a,
        b."category_name" AS cat_b,
        a.pct_of_month    AS pct_a,
        b.pct_of_month    AS pct_b
    FROM pct_q a
    JOIN pct_q b
      ON a.sales_month = b.sales_month
     AND a."category_name" < b."category_name"   -- remove self‑pairs / duplicates
)
SELECT
    cat_a  AS category_name_1,
    cat_b  AS category_name_2,
    CORR(pct_a, pct_b) AS pearson_corr
