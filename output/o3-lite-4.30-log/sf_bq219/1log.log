--Description: 
-- Return the single pair of liquor categories whose monthly percentage share of total
-- liters (from 2022‑01‑01 through the most recently COMPLETED month) exhibits the
-- lowest Pearson correlation, provided each category:
--   • appears in at least 24 different months, and
--   • averages at least 1 % of the monthly liters.
--
-- Steps (all inside this one query):
-- 1) monthly_liters  – total liters per (month, category), excluding the current partial month.
-- 2) month_totals    – total liters per month (denominator for percentages).
-- 3) cat_month_pct   – compute pct_of_month for every (month, category).
-- 4) qualified       – keep categories meeting both 24‑month and 1 %‑average criteria.
-- 5) pair_series     – self‑join qualified rows on month (cat_a < cat_b) to align the two
--                      percentage series for each category pair.
-- 6) Final SELECT    – aggregate each pair’s aligned series with CORR() and pick the
--                      overall minimum correlation (LIMIT 1).

WITH monthly_liters AS (
    SELECT
        DATE_TRUNC('MONTH', "date")       AS sales_month,
        "category_name",
        SUM("volume_sold_liters")         AS liters
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
      AND DATE_TRUNC('MONTH', "date")
          <= DATE_TRUNC('MONTH', DATEADD(month, -1, CURRENT_DATE))   -- only full months
    GROUP BY sales_month, "category_name"
),
month_totals AS (
    SELECT
        sales_month,
        SUM(liters) AS tot_liters
    FROM monthly_liters
    GROUP BY sales_month
),
cat_month_pct AS (
    SELECT
        m.sales_month,
        m."category_name",
        m.liters / t.tot_liters AS pct_of_month
    FROM monthly_liters m
    JOIN month_totals  t  ON m.sales_month = t.sales_month
),
qualified AS (
    SELECT *
    FROM cat_month_pct
    QUALIFY COUNT(*)  OVER (PARTITION BY "category_name") >= 24
       AND AVG(pct_of_month) OVER (PARTITION BY "category_name") >= 0.01
),
pair_series AS (
    SELECT
        a."category_name" AS cat_a,
        b."category_name" AS cat_b,
        a.pct_of_month    AS pct_a,
        b.pct_of_month    AS pct_b
    FROM qualified a
    JOIN qualified b
      ON a.sales_month = b.sales_month
     AND a."category_name" < b."category_name"      -- unique pairs, no self‑pairs
)
SELECT
    cat_a AS category_name_1,
    cat_b AS category_name_2,
    CORR(pct_a, pct_b) AS pearson_corr
FROM pair_series
GROUP BY cat_a, cat_b
ORDER BY pearson_corr ASC
LIMIT 1;
