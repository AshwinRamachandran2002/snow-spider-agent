Query:
--Description: 
-- Corrected version of “query 10” that fetches the two liquor categories whose
-- monthly percentage share of total liters (from 01‑Jan‑2022 through the last
-- completed month) shows the lowest Pearson correlation.  Each category must
-- (i) appear in ≥ 24 months and (ii) average ≥ 1 % of monthly liters.
-- The earlier draft errored because DATE_TRUNC references were not balanced
-- across GROUP BY / SELECT clauses when a window SUM was used.  This rewrite
-- computes percentages with an explicit month‑totals CTE, then applies the
-- correlation.

WITH monthly_liters AS (      -- 1) liters per (month, category)
    SELECT
        DATE_TRUNC('MONTH', "date")       AS sales_month,
        "category_name",
        SUM("volume_sold_liters")         AS liters
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
      AND DATE_TRUNC('MONTH', "date")
          <= DATE_TRUNC('MONTH', DATEADD(month, -1, CURRENT_DATE))   -- keep only full months
    GROUP BY sales_month, "category_name"
),
month_totals AS (             -- 2) total liters each month
    SELECT
        sales_month,
        SUM(liters) AS tot_liters
    FROM monthly_liters
    GROUP BY sales_month
),
cat_month_pct AS (            -- 3) percentage share per (month, category)
    SELECT
        ml.sales_month,
        ml."category_name",
        ml.liters / mt.tot_liters AS pct_of_month
    FROM monthly_liters ml
    JOIN month_totals  mt  ON ml.sales_month = mt.sales_month
),
qualified AS (                -- 4) categories present ≥ 24 months & avg share ≥ 1 %
    SELECT *
    FROM cat_month_pct
    QUALIFY COUNT(*)  OVER (PARTITION BY "category_name") >= 24
       AND AVG(pct_of_month) OVER (PARTITION BY "category_name") >= 0.01
),
pair_corr AS (                -- 5) Pearson correlation for each category pair
    SELECT
        a."category_name" AS cat_a,
        b."category_name" AS cat_b,
        CORR(a.pct_of_month, b.pct_of_month) AS pearson_corr
    FROM qualified a
    JOIN qualified b
      ON a.sales_month = b.sales_month
     AND a."category_name" < b."category_name"     -- unique unordered pairs
    GROUP BY cat_a, cat_b
),
lowest AS (                    -- 6) rank pairs by correlation
    SELECT
        cat_a, cat_b, pearson_corr,
        RANK() OVER (ORDER BY pearson_corr ASC) AS rnk
    FROM pair_corr
)
SELECT
    cat_a AS category_name_1,
    cat_b AS category_name_2,
    pearson_corr
FROM lowest
WHERE rnk = 1     -- lowest correlation
LIMIT 20
