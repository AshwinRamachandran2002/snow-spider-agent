```sql
--Description:
-- Find the two liquor categories that (a) appear in at least 24 fully‑completed
-- months starting Jan‑2022, (b) average ≥1 % of statewide liters in those
-- months, and (c) have the smallest Pearson correlation between their monthly
-- volume shares.
-- Logic
-- 1. mo_tot  : total liters per month, Jan‑2022 through the last closed month.
-- 2. cat_pct : each category’s % share of that month’s total.
-- 3. good_cat: categories meeting the ≥24‑month and ≥1 %‑average rules.
-- 4. cat_pct2: cat_pct restricted to good_cat only.
-- 5. pair_corr: self‑join cat_pct2 on year‑month, aggregate CORR() for every
--               unordered category pair, return the pair with the lowest value.
WITH mo_tot AS (
    SELECT
        TO_CHAR("date", 'YYYY-MM') AS ym,
        SUM("volume_sold_liters")  AS mo_total
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date" >= '2022-01-01'
      AND "date" < DATE_TRUNC('month', CURRENT_DATE)
    GROUP BY ym
),
cat_pct AS (
    SELECT
        TO_CHAR(s."date", 'YYYY-MM')                AS ym,
        s."category_name",
        SUM(s."volume_sold_liters") / MAX(t.mo_total) * 100 AS pct_of_month
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
    JOIN mo_tot t
      ON TO_CHAR(s."date", 'YYYY-MM') = t.ym
    WHERE s."date" >= '2022-01-01'
      AND s."date" < DATE_TRUNC('month', CURRENT_DATE)
    GROUP BY
        TO_CHAR(s."date", 'YYYY-MM'),
        s."category_name"
),
good_cat AS (
    SELECT
        "category_name"
    FROM cat_pct
    GROUP BY "category_name"
    HAVING COUNT(*) >= 24               -- at least 24 months
       AND AVG(pct_of_month) >= 1       -- avg ≥1 % of monthly volume
),
cat_pct2 AS (
    SELECT *
    FROM cat_pct
    WHERE "category_name" IN (SELECT "category_name" FROM good_cat)
),
pair_corr AS (
    SELECT
        c1."category_name"  AS cat1,
        c2."category_name"  AS cat2,
        CORR(c1.pct_of_month, c2.pct_of_month) AS pearson_corr
    FROM cat_pct2 c1
    JOIN cat_pct2 c2
      ON c1.ym = c2.ym
     AND c1."category_name" < c2."category_name"  -- avoid duplicate & self pairs
    GROUP BY
        cat1,
        cat2
)
SELECT
    cat1  AS category_one,
    cat2  AS category_two,
    pearson_corr
FROM pair_corr
ORDER BY pearson_corr  -- ascending: lowest correlation on top
LIMIT 1;
```
