Query:
--Description:
-- Compute the Pearson correlation between the monthly volume‑share (%) of
-- ‘SPICED RUM’ and ‘IRISH WHISKIES’ for all fully completed months beginning
-- Jan‑2022.  Both categories satisfy the ≥24‑month / ≥1 % criteria shown earlier.
-- Steps
--   1. mo_tot   : total liters sold each month (Jan‑2022 through last closed month).
--   2. cat_pct  : every category’s share (%) of that month’s total liters.
--   3. filtered : keep only the two chosen categories.
--   4. pivoted  : one row per month with the two categories in separate columns.
--   5. Final    : CORR() over those two columns gives the Pearson coefficient.
WITH mo_tot AS (
    SELECT
        TO_CHAR("date", 'YYYY-MM') AS ym,
        SUM("volume_sold_liters")  AS mo_total
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date" >= '2022-01-01'
      AND "date" < DATE_TRUNC('month', CURRENT_DATE)  -- last fully closed month
    GROUP BY ym
),
cat_pct AS (
    SELECT
        TO_CHAR(s."date", 'YYYY-MM')                AS ym,
        s."category_name",
        SUM(s."volume_sold_liters") / MAX(t.mo_total) * 100 AS pct_of_month
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
    JOIN mo_tot t
      ON TO_CHAR(s."date", 'YYYY-MM') = t.ym
    WHERE s."date" >= '2022-01-01'
      AND s."date" < DATE_TRUNC('month', CURRENT_DATE)
    GROUP BY
        TO_CHAR(s."date", 'YYYY-MM'),
        s."category_name"
),
filtered AS (
    SELECT *
    FROM cat_pct
    WHERE "category_name" IN ('SPICED RUM', 'IRISH WHISKIES')
),
pivoted AS (
    SELECT
        ym,
        MAX(CASE WHEN "category_name" = 'SPICED RUM'     THEN pct_of_month END) AS spiced_rum_pct,
        MAX(CASE WHEN "category_name" = 'IRISH WHISKIES' THEN pct_of_month END) AS irish_whiskies_pct
    FROM filtered
    GROUP BY ym
    HAVING spiced_rum_pct IS NOT NULL
       AND irish_whiskies_pct IS NOT NULL         -- ensure both present
)
SELECT
    CORR(spiced_rum_pct, irish_whiskies_pct) AS pearson_correlation
FROM pivoted
