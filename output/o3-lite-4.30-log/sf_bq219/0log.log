--Description:
-- Purpose: show each liquor category’s monthly share of total volume (% of liters) 
--          for fully completed months from Jan‑2022 through the end of the last closed month.
-- Thought process:
--   1. Determine the last closed month with DATE_TRUNC('month', CURRENT_DATE) and keep dates before it. 
--   2. Aggregate total liters per month (mo_tot) in a CTE. 
--   3. Re‑aggregate by category within each month and divide by that month’s total to get the percentage. 
--   4. Present the first 20 rows in chronological order for inspection.
WITH mo_tot AS (
  SELECT
    TO_CHAR("date", 'YYYY-MM')       AS ym,
    SUM("volume_sold_liters")        AS total_liters
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
  WHERE "date" >= '2022-01-01'
    AND "date" < DATE_TRUNC('month', CURRENT_DATE)
  GROUP BY ym
)
SELECT
  TO_CHAR(s."date", 'YYYY-MM')       AS "year_month",
  s."category_name",
  ROUND(
    SUM(s."volume_sold_liters") / MAX(t.total_liters) * 100,
    3
  )                                  AS "pct_of_month"
FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
JOIN mo_tot t
  ON TO_CHAR(s."date", 'YYYY-MM') = t.ym
WHERE s."date" >= '2022-01-01'
  AND s."date" < DATE_TRUNC('month', CURRENT_DATE)
GROUP BY
  TO_CHAR(s."date", 'YYYY-MM'),
  s."category_name"
ORDER BY
  "year_month",
  "category_name"
LIMIT 20;
