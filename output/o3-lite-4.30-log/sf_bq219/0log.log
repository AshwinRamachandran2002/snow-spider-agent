```sql
-- 6. Compute monthly volume share (%) for every category
WITH mo_tot AS (
  SELECT
    TO_CHAR("date", 'YYYY‑MM') AS ym,
    SUM("volume_sold_liters") AS mo_total
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
  WHERE "date" >= '2022‑01‑01'
    AND "date" < DATE_TRUNC('month', CURRENT_DATE)
  GROUP BY ym
)
SELECT
  TO_CHAR(s."date", 'YYYY‑MM')         AS "year_month",
  s."category_name",
  SUM(s."volume_sold_liters") / MAX(t.mo_total) * 100  AS "pct_of_month"
FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
JOIN mo_tot t
  ON TO_CHAR(s."date", 'YYYY‑MM') = t.ym
WHERE s."date" >= '2022‑01‑01'
  AND s."date" < DATE_TRUNC('month', CURRENT_DATE)
GROUP BY
  TO_CHAR(s."date", 'YYYY‑MM'),
  s."category_name"
ORDER BY "year_month", "pct_of_month" DESC
LIMIT 20;
```

```sql
-- 7. Average monthly percentage for each category over the period
WITH cat_pct AS (
  -- use the CTE from query #6
  WITH mo_tot AS (
    SELECT TO_CHAR("date", 'YYYY‑MM') AS ym,
           SUM("volume_sold_liters")  AS mo_total
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date" >= '2022‑01‑01'
      AND "date" < DATE_TRUNC('month', CURRENT_DATE)
    GROUP BY ym
  )
  SELECT
    TO_CHAR(s."date", 'YYYY‑MM')      AS "ym",
    s."category_name",
    SUM(s."volume_sold_liters") / MAX(t.mo_total) * 100  AS "pct_of_month"
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
  JOIN mo_tot t
    ON TO_CHAR(s."date", 'YYYY‑MM') = t.ym
  WHERE s."date" >= '2022‑01‑01'
    AND s."date" < DATE_TRUNC('month', CURRENT_DATE)
  GROUP BY
    TO_CHAR(s."date", 'YYYY‑MM'),
    s."category_name"
)
SELECT
  "category_name",
  COUNT(*)                         AS "months_present",
  AVG("pct_of_month")              AS "avg_monthly_pct"
FROM cat_pct
GROUP BY "category_name"
HAVING COUNT(*) >= 24
ORDER BY "avg_monthly_pct" DESC
LIMIT 20;
```

