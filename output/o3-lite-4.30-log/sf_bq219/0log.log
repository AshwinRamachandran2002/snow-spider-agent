```sql
-- 10. Example: compute pairwise Pearson correlation between two categories
WITH monthly_pct AS (
  -- reuse earlier CTE to get monthly % for every category
  WITH mo_tot AS (
    SELECT TO_CHAR("date", 'YYYY‑MM') AS ym,
           SUM("volume_sold_liters")  AS mo_total
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date" >= '2022‑01‑01'
      AND "date" < DATE_TRUNC('month', CURRENT_DATE)
    GROUP BY ym
  )
  SELECT
    TO_CHAR(s."date", 'YYYY‑MM')      AS "ym",
    s."category_name",
    SUM(s."volume_sold_liters") / MAX(t.mo_total) * 100  AS "pct_of_month"
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
  JOIN mo_tot t
    ON TO_CHAR(s."date", 'YYYY‑MM') = t.ym
  WHERE s."date" >= '2022‑01‑01'
    AND s."date" < DATE_TRUNC('month', CURRENT_DATE)
  GROUP BY
    TO_CHAR(s."date", 'YYYY‑MM'),
    s."category_name"
),
pivoted AS (
  SELECT
    "ym",
    MAX(CASE WHEN "category_name" = 'CATEGORY_A' THEN "pct_of_month" END) AS "cat_a_pct",
    MAX(CASE WHEN "category_name" = 'CATEGORY_B' THEN "pct_of_month" END) AS "cat_b_pct"
  FROM monthly_pct
  GROUP BY "ym"
  HAVING COUNT(*) = 2   -- ensures both categories appear in the month
)
SELECT
  CORR("cat_a_pct", "cat_b_pct") AS "pearson_correlation"
FROM pivoted
LIMIT 20;
```

Replace 'CATEGORY_A' and 'CATEGORY_B' in query #10 (and the IN() list in query #9) with the actual category names returned by query #8 to finish the analysis.
