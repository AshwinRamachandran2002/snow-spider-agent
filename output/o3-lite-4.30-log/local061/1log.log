-- 8. Description: Aggregate 2019 and 2020 monthly sales per product for France (needed for growth calculation)
SELECT t.calendar_year,
       t.calendar_month_number AS month,
       s.prod_id,
       SUM(s.amount_sold)      AS total_amount
FROM   sales      AS s
JOIN   promotions AS p  ON p.promo_id  = s.promo_id   AND p.promo_total_id   = 1
JOIN   channels   AS ch ON ch.channel_id = s.channel_id AND ch.channel_total_id = 1
JOIN   customers  AS c  ON c.cust_id   = s.cust_id
JOIN   countries  AS co ON co.country_id = c.country_id
JOIN   times      AS t  ON t.time_id   = s.time_id
WHERE  co.country_name = 'France'
  AND  t.calendar_year IN (2019, 2020)
GROUP BY t.calendar_year, t.calendar_month_number, s.prod_id
ORDER BY t.calendar_year, month, s.prod_id
LIMIT 20;
