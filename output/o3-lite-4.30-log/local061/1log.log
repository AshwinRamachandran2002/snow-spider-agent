-- 10. Description: Project 2021 monthly USD sales using 2019→2020 growth and convert with 2021 FX rate (sample rows)
WITH sales_by_year AS (
    SELECT t.calendar_year  AS yr,
           t.calendar_month_number AS mon,
           s.prod_id              AS prod,
           SUM(s.amount_sold)     AS amt
    FROM   sales      AS s
    JOIN   promotions AS p  ON p.promo_id  = s.promo_id   AND p.promo_total_id   = 1
    JOIN   channels   AS ch ON ch.channel_id = s.channel_id AND ch.channel_total_id = 1
    JOIN   customers  AS c  ON c.cust_id   = s.cust_id
    JOIN   countries  AS co ON co.country_id = c.country_id
    JOIN   times      AS t  ON t.time_id   = s.time_id
    WHERE  co.country_name = 'France'
      AND  t.calendar_year IN (2019, 2020)
    GROUP BY yr, mon, prod
),
growth AS (
    SELECT a.mon,
           a.prod,
           a.amt AS amt_2019,
           b.amt AS amt_2020,
           CASE WHEN a.amt > 0 THEN (b.amt - a.amt) * 1.0 / a.amt ELSE NULL END AS growth_rate
    FROM   sales_by_year AS a
    JOIN   sales_by_year AS b
          ON a.prod = b.prod AND a.mon = b.mon
    WHERE a.yr = 2019 AND b.yr = 2020
),
proj_2021 AS (
    SELECT g.mon,
           g.prod,
           g.amt_2020 * (1 + COALESCE(g.growth_rate,0)) AS projected_amt_2021_local
    FROM   growth AS g
),
fx_2021 AS (
    SELECT month, to_us
    FROM   currency
    WHERE  country = 'France' AND year = 2021
)
SELECT p.mon,
       ROUND(AVG(p.projected_amt_2021_local / f.to_us), 2) AS avg_projected_sales_usd
FROM   proj_2021 AS p
JOIN   fx_2021   AS f ON f.month = p.mon
GROUP BY p.mon
ORDER BY p.mon
LIMIT 20;
