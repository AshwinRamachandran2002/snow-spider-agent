--   • Sum each product’s sales by month for 2019 and for 2020.
--   • Calculate per‑product‑month growth = (2020 – 2019) / 2019.
--   • Project 2021 sales = 2020 total × (1 + growth).
--   • Convert projected 2021 values to USD via 2021 FX rates.
--   • Average the converted values per calendar month.

WITH sales_filtered AS (          -- step 1: apply country + promo + channel filters
    SELECT s.prod_id,
           s.amount_sold,
           s.time_id
    FROM   sales       AS s
    JOIN   customers   AS c   ON s.cust_id   = c.cust_id
    JOIN   countries   AS co  ON c.country_id = co.country_id
    JOIN   promotions  AS p   ON s.promo_id  = p.promo_id
    JOIN   channels    AS ch  ON s.channel_id = ch.channel_id
    WHERE  co.country_name     = 'France'
      AND  p.promo_total_id    = 1
      AND  ch.channel_total_id = 1
),
sales_totals AS (                -- step 2: add year+month & aggregate
    SELECT t.calendar_year         AS yr,
           t.calendar_month_number AS mo,
           sf.prod_id,
           SUM(sf.amount_sold)     AS amt
    FROM   sales_filtered sf
    JOIN   times t ON sf.time_id = t.time_id
    WHERE  t.calendar_year IN (2019, 2020)
    GROUP  BY t.calendar_year, t.calendar_month_number, sf.prod_id
),
sales_2019 AS (SELECT mo, prod_id, amt AS amt_2019 FROM sales_totals WHERE yr = 2019),
sales_2020 AS (SELECT mo, prod_id, amt AS amt_2020 FROM sales_totals WHERE yr = 2020),
growth AS (                       -- step 3: compute growth rate
    SELECT s20.mo,
           s20.prod_id,
           s20.amt_2020,
           (s20.amt_2020 - s19.amt_2019) * 1.0 / NULLIF(s19.amt_2019, 0) AS growth_rate
    FROM   sales_2020 s20
    JOIN   sales_2019 s19
           ON s20.mo = s19.mo AND s20.prod_id = s19.prod_id
),
proj_2021 AS (                    -- step 4: project 2021 sales in local currency
    SELECT mo   AS month,
           prod_id,
           amt_2020 * (1 + growth_rate) AS proj_local
    FROM   growth
)
-- step 5 & 6: convert to USD and average per month
SELECT  p.month,
        AVG(p.proj_local / cu.to_us) AS avg_projected_2021_usd
FROM    proj_2021 p
JOIN    currency cu
