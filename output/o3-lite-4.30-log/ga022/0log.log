--10. Final: weekly retention rates (%) for week 1, 2, 3
WITH
cohort AS (
  SELECT user_pseudo_id,
         MIN(TIMESTAMP_MICROS(event_timestamp)) AT TIME ZONE 'Asia/Shanghai' AS first_open_ts_sh
  FROM   (
    SELECT * FROM `firebase-public-project.analytics_153293282.events_20180901`
    UNION ALL SELECT * FROM `firebase-public-project.analytics_153293282.events_20180902`
    UNION ALL SELECT * FROM `firebase-public-project.analytics_153293282.events_20180903`
