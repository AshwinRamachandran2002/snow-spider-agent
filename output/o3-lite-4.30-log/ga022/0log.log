Begin Exploring Related Columns
Relevant columns and their potential usage  
• event_name : filter “first_open”, “session_start” (or any event that qualifies as “return”)  
• event_timestamp (INT64, micro‑seconds) : build Shanghai dates and calculate day / week differences  
• user_pseudo_id : unique anonymous user id for cohort / retention counting  
• event_date : partition pruning when reading single–day tables (helps performance)  

Typical conditions  
• event_name = 'first_open' (to create the cohort)  
• event_name IN ('session_start','user_engagement') (to decide that a user “came back”)  
• DATE(TIMESTAMP_MICROS(event_timestamp),"Asia/Shanghai")  
     BETWEEN '2018‑09‑01' AND '2018‑09‑07'  -- cohort window  
• week_index IN (1,2,3)                    -- subsequent weeks  

Below are ten progressively more complex BigQuery queries (LIMIT 20 each).  
Every query is wrapped in back‑ticks and preceded by a short comment.

```sql
--1. Distinct event names recorded on 1‑Sep‑2018
SELECT DISTINCT event_name
FROM `firebase-public-project.analytics_153293282.events_20180901`
LIMIT 20;
```

```sql
--2. Sample rows of the “first_open” event on 1‑Sep‑2018
SELECT user_pseudo_id,
       event_timestamp,
       event_name
FROM   `firebase-public-project.analytics_153293282.events_20180901`
WHERE  event_name = 'first_open'
LIMIT 20;
```

```sql
--3. Convert micro‑second timestamp to Shanghai date & time
SELECT user_pseudo_id,
       TIMESTAMP_MICROS(event_timestamp)                         AS ts_utc,
       TIMESTAMP_MICROS(event_timestamp) AT TIME ZONE 'Asia/Shanghai' AS ts_sh,
       DATE(TIMESTAMP_MICROS(event_timestamp),"Asia/Shanghai")   AS d_sh
FROM   `firebase-public-project.analytics_153293282.events_20180902`
LIMIT 20;
```

```sql
--4. Earliest first_open per user during the first week of September 2018
SELECT user_pseudo_id,
       MIN(TIMESTAMP_MICROS(event_timestamp)) AT TIME ZONE 'Asia/Shanghai' AS first_open_ts_sh
FROM (
  SELECT user_pseudo_id, event_timestamp
  FROM   `firebase-public-project.analytics_153293282.events_20180901`
  UNION ALL
  SELECT user_pseudo_id, event_timestamp
  FROM   `firebase-public-project.analytics_153293282.events_20180902`
  UNION ALL
  SELECT user_pseudo_id, event_timestamp
  FROM   `firebase-public-project.analytics_153293282.events_20180903`
  UNION ALL
  SELECT user_pseudo_id, event_timestamp
  FROM   `firebase-public-project.analytics_153293282.events_20180904`
  UNION ALL
  SELECT user_pseudo_id, event_timestamp
  FROM   `firebase-public-project.analytics_153293282.events_20180905`
  UNION ALL
  SELECT user_pseudo_id, event_timestamp
  FROM   `firebase-public-project.analytics_153293282.events_20180906`
  UNION ALL
  SELECT user_pseudo_id, event_timestamp
  FROM   `firebase-public-project.analytics_153293282.events_20180907`
)
WHERE  event_name = 'first_open'
GROUP  BY user_pseudo_id
LIMIT 20;
```

```sql
--5. Count of new users in that first‑week cohort
WITH cohort AS (
  SELECT user_pseudo_id
  FROM (
    SELECT user_pseudo_id,
           MIN(TIMESTAMP_MICROS(event_timestamp)) AT TIME ZONE 'Asia/Shanghai' AS first_open_ts_sh
    FROM (
      SELECT user_pseudo_id, event_timestamp
      FROM   `firebase-public-project.analytics_153293282.events_20180901`
      WHERE  event_name = 'first_open'
      UNION ALL
      SELECT user_pseudo_id, event_timestamp
      FROM   `firebase-public-project.analytics_153293282.events_20180902`
      WHERE  event_name = 'first_open'
      UNION ALL
      SELECT user_pseudo_id, event_timestamp
      FROM   `firebase-public-project.analytics_153293282.events_20180903`
      WHERE  event_name = 'first_open'
      UNION ALL
      SELECT user_pseudo_id, event_timestamp
      FROM   `firebase-public-project.analytics_153293282.events_20180904`
      WHERE  event_name = 'first_open'
      UNION ALL
      SELECT user_pseudo_id, event_timestamp
      FROM   `firebase-public-project.analytics_153293282.events_20180905`
      WHERE  event_name = 'first_open'
      UNION ALL
      SELECT user_pseudo_id, event_timestamp
      FROM   `firebase-public-project.analytics_153293282.events_20180906`
      WHERE  event_name = 'first_open'
      UNION ALL
      SELECT user_pseudo_id, event_timestamp
      FROM   `firebase-public-project.analytics_153293282.events_20180907`
      WHERE  event_name = 'first_open'
    )
    GROUP BY user_pseudo_id
    HAVING DATE(first_open_ts_sh) BETWEEN '2018-09-01' AND '2018-09-07'
  )
)
SELECT COUNT(DISTINCT user_pseudo_id) AS cohort_users
FROM   cohort
LIMIT 20;
```

```sql
--6. Sample “return” events (session_start) for cohort users during September
WITH cohort AS (
  SELECT user_pseudo_id
  FROM (
    SELECT user_pseudo_id,
           MIN(TIMESTAMP_MICROS(event_timestamp)) AT TIME ZONE 'Asia/Shanghai' AS first_open_ts_sh
    FROM   `firebase-public-project.analytics_153293282.events_20180901`
    WHERE  event_name = 'first_open'
    GROUP BY user_pseudo_id
    HAVING DATE(first_open_ts_sh) BETWEEN '2018-09-01' AND '2018-09-07'
  )
)
SELECT e.user_pseudo_id,
       DATE(TIMESTAMP_MICROS(e.event_timestamp),"Asia/Shanghai") AS d_sh,
       e.event_name
FROM   `firebase-public-project.analytics_153293282.events_20180910`  AS e
JOIN   cohort USING (user_pseudo_id)
WHERE  e.event_name = 'session_start'
LIMIT 20;
```

```sql
--7. Day difference between a return event and the user’s first_open date
WITH cohort AS (
  SELECT user_pseudo_id,
         MIN(TIMESTAMP_MICROS(event_timestamp)) AT TIME ZONE 'Asia/Shanghai' AS first_open_ts_sh
  FROM   `firebase-public-project.analytics_153293282.events_20180901`
  WHERE  event_name = 'first_open'
  GROUP  BY user_pseudo_id
  HAVING DATE(first_open_ts_sh) BETWEEN '2018-09-01' AND '2018-09-07'
)
SELECT e.user_pseudo_id,
       DATE(TIMESTAMP_MICROS(e.event_timestamp),"Asia/Shanghai")               AS d_sh,
       DATE_DIFF(DATE(TIMESTAMP_MICROS(e.event_timestamp),"Asia/Shanghai"),
                 DATE(co.first_open_ts_sh),
                 DAY)                                                          AS days_after_first_open
FROM   `firebase-public-project.analytics_153293282.events_20180914` AS e
JOIN   cohort AS co USING (user_pseudo_id)
WHERE  e.event_name = 'session_start'
LIMIT 20;
```

```sql
--8. Map each return into a week_index (0=cohort week, 1,2,3,…)
WITH cohort AS (
  SELECT user_pseudo_id,
         MIN(TIMESTAMP_MICROS(event_timestamp)) AT TIME ZONE 'Asia/Shanghai' AS first_open_ts_sh
  FROM   `firebase-public-project.analytics_153293282.events_20180901`
  WHERE  event_name = 'first_open'
  GROUP  BY user_pseudo_id
  HAVING DATE(first_open_ts_sh) BETWEEN '2018-09-01' AND '2018-09-07'
)
SELECT e.user_pseudo_id,
       FLOOR(DATE_DIFF(DATE(TIMESTAMP_MICROS(e.event_timestamp),"Asia/Shanghai"),
                       DATE(co.first_open_ts_sh), DAY) / 7)                   AS week_index,
       MIN(DATE(TIMESTAMP_MICROS(e.event_timestamp),"Asia/Shanghai"))         AS first_return_date
FROM   UNNEST([
         '20180908','20180909','20180910','20180911','20180912','20180913','20180914',
         '20180915','20180916','20180917','20180918','20180919','20180920','20180921',
         '20180922','20180923','20180924','20180925','20180926','20180927','20180928'
       ]) AS day_str
JOIN   `firebase-public-project.analytics_153293282.events_`||day_str AS e
  ON   TRUE
JOIN   cohort AS co
  ON   e.user_pseudo_id = co.user_pseudo_id
WHERE  e.event_name = 'session_start'
GROUP  BY user_pseudo_id, week_index
HAVING week_index IN (1,2,3)
LIMIT 20;
```

```sql
--9. Count of users retained for week 1, 2 and 3 (still raw numbers)
WITH
cohort AS (
  SELECT user_pseudo_id,
         MIN(TIMESTAMP_MICROS(event_timestamp)) AT TIME ZONE 'Asia/Shanghai' AS first_open_ts_sh
  FROM   (
    SELECT * FROM `firebase-public-project.analytics_153293282.events_20180901`
    UNION ALL SELECT * FROM `firebase-public-project.analytics_153293282.events_20180902`
    UNION ALL SELECT * FROM `firebase-public-project.analytics_153293282.events_20180903`
    UNION ALL SELECT * FROM `firebase-public-project.analytics_153293282.events_20180904`
    UNION ALL SELECT * FROM `firebase-public-project.analytics_153293282.events_20180905`
    UNION ALL SELECT * FROM `firebase-public-project.analytics_153293282.events_20180906`
    UNION ALL SELECT * FROM `firebase-public-project.analytics_153293282.events_20180907`
  )
  WHERE  event_name = 'first_open'
  GROUP BY user_pseudo_id
  HAVING DATE(first_open_ts_sh) BETWEEN '2018-09-01' AND '2018-09-07'
),
returns AS (
  SELECT DISTINCT co.user_pseudo_id,
         FLOOR(DATE_DIFF(DATE(TIMESTAMP_MICROS(e.event_timestamp),"Asia/Shanghai"),
                         DATE(co.first_open_ts_sh), DAY) / 7) AS week_index
  FROM   (
    SELECT * FROM `firebase-public-project.analytics_153293282.events_20180908`
    UNION ALL SELECT * FROM `firebase-public-project.analytics_153293282.events_20180909`
    UNION ALL SELECT * FROM `firebase-public-project.analytics_153293282.events_20180910`
