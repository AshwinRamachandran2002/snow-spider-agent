--Description: #10  Weekly retention rates (%) for weeks 1–3 (event‑agnostic, 8‑30 Sep scan)  
-- Same cohort/returns logic as #9, but expresses results as percentages of the
-- original cohort size.  
WITH
cohort AS (
  SELECT
    user_pseudo_id,
    MIN(DATETIME(TIMESTAMP_MICROS(event_timestamp),'Asia/Shanghai'))
        AS first_open_ts_sh
  FROM `firebase-public-project.analytics_153293282.events_2018090*`
  WHERE event_name = 'first_open'
  GROUP BY user_pseudo_id
  HAVING DATE(first_open_ts_sh) BETWEEN '2018-09-01' AND '2018-09-07'
),
returns AS (
  SELECT DISTINCT
    c.user_pseudo_id,
    FLOOR(
      DATE_DIFF(
        DATE(TIMESTAMP_MICROS(e.event_timestamp),'Asia/Shanghai'),
        DATE(c.first_open_ts_sh), DAY) / 7)                          AS week_index
  FROM `firebase-public-project.analytics_153293282.events_201809*` AS e
  JOIN cohort AS c USING (user_pseudo_id)
  WHERE _TABLE_SUFFIX BETWEEN '20180908' AND '20180930'
        AND FLOOR(
              DATE_DIFF(
                DATE(TIMESTAMP_MICROS(e.event_timestamp),'Asia/Shanghai'),
                DATE(c.first_open_ts_sh), DAY) / 7) IN (1,2,3)       -- weeks 1‑3
)
SELECT
  COUNT(*)                                           AS cohort_size,
  SAFE_DIVIDE(COUNTIF(week_index = 1), COUNT(*))     AS week_1_retention,
  SAFE_DIVIDE(COUNTIF(week_index = 2), COUNT(*))     AS week_2_retention,
  SAFE_DIVIDE(COUNTIF(week_index = 3), COUNT(*))     AS week_3_retention
FROM cohort
LEFT JOIN returns USING (user_pseudo_id)
LIMIT 20
