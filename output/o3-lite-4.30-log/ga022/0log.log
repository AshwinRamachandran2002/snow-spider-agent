--Description: 
-- We must (1) turn the INT64 micro‑second field into a true UTC TIMESTAMP,
-- then (2) express that same instant in the Asia/Shanghai clock, and finally
-- (3) pull out the Shanghai calendar date.  
-- BigQuery’s DATETIME(utc_ts, 'tz') is the accepted way to apply a time zone
-- to an existing TIMESTAMP; TIMESTAMP(<value>, 'tz') is not supported, which
-- caused the previous “no matching signature” error.  
SELECT
  user_pseudo_id,
  TIMESTAMP_MICROS(event_timestamp)                                        AS ts_utc,      -- step 1
  DATETIME(TIMESTAMP_MICROS(event_timestamp), 'Asia/Shanghai')             AS dt_shanghai, -- step 2
  DATE(TIMESTAMP_MICROS(event_timestamp),      'Asia/Shanghai')            AS d_shanghai   -- step 3
FROM `firebase-public-project.analytics_153293282.events_20180902`
