--Description: #9  Raw count of users retained in weeks 1–3 (event‑agnostic, 8‑30 Sep scan)  
-- Cohort: users whose first “first_open” (Shanghai time) was 1–7 Sep 2018.  
-- Returns: ANY event these users fired between 08–30 Sep 2018.  
-- week_index = ⌊days_since_signup / 7⌋ ; we then count distinct users per week.  
WITH
cohort AS (
  SELECT
    user_pseudo_id,
    MIN(DATETIME(TIMESTAMP_MICROS(event_timestamp),'Asia/Shanghai'))
        AS first_open_ts_sh
  FROM `firebase-public-project.analytics_153293282.events_2018090*`
  WHERE event_name = 'first_open'
  GROUP BY user_pseudo_id
  HAVING DATE(first_open_ts_sh) BETWEEN '2018-09-01' AND '2018-09-07'
),
returns AS (
  SELECT DISTINCT
    c.user_pseudo_id,
    FLOOR(
      DATE_DIFF(
        DATE(TIMESTAMP_MICROS(e.event_timestamp),'Asia/Shanghai'),
        DATE(c.first_open_ts_sh), DAY) / 7)                          AS week_index
  FROM `firebase-public-project.analytics_153293282.events_201809*` AS e
  JOIN cohort AS c USING (user_pseudo_id)
  WHERE _TABLE_SUFFIX BETWEEN '20180908' AND '20180930'
        AND FLOOR(
              DATE_DIFF(
                DATE(TIMESTAMP_MICROS(e.event_timestamp),'Asia/Shanghai'),
                DATE(c.first_open_ts_sh), DAY) / 7) IN (1,2,3)       -- weeks 1‑3
)
SELECT
  (SELECT COUNT(*) FROM cohort) AS cohort_size,
  COUNTIF(week_index = 1)       AS week_1_users,
  COUNTIF(week_index = 2)       AS week_2_users,
  COUNTIF(week_index = 3)       AS week_3_users
FROM returns
LIMIT 20
Answer:
cohort_size,week_1_users,week_2_users,week_3_users
