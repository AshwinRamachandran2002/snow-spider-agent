  )
  WHERE event_name = 'first_open'
  GROUP BY user_pseudo_id
  HAVING DATE(first_open_ts_sh) BETWEEN '2018-09-01' AND '2018-09-07'
),
returns AS (
  SELECT DISTINCT
    co.user_pseudo_id,
    FLOOR(
      DATE_DIFF(
        DATE(TIMESTAMP_MICROS(e.event_timestamp),'Asia/Shanghai'),
        DATE(co.first_open_ts_sh), DAY) / 7)                                AS week_index
  FROM (
    SELECT * FROM `firebase-public-project.analytics_153293282.events_20180908` UNION ALL
    SELECT * FROM `firebase-public-project.analytics_153293282.events_20180909` UNION ALL
    SELECT * FROM `firebase-public-project.analytics_153293282.events_20180910` UNION ALL
    SELECT * FROM `firebase-public-project.analytics_153293282.events_20180911` UNION ALL
