  TIMESTAMP_MICROS(event_timestamp)                                        AS ts_utc,
  TIMESTAMP(TIMESTAMP_MICROS(event_timestamp), 'Asia/Shanghai')            AS ts_sh,
  DATE(TIMESTAMP_MICROS(event_timestamp),      'Asia/Shanghai')            AS d_sh
FROM `firebase-public-project.analytics_153293282.events_20180902`
