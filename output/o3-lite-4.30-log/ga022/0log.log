```sql
--7. Day difference between a return event and the user’s first_open date
WITH cohort AS (
  SELECT user_pseudo_id,
         MIN(TIMESTAMP_MICROS(event_timestamp)) AT TIME ZONE 'Asia/Shanghai' AS first_open_ts_sh
  FROM   `firebase-public-project.analytics_153293282.events_20180901`
  WHERE  event_name = 'first_open'
  GROUP  BY user_pseudo_id
  HAVING DATE(first_open_ts_sh) BETWEEN '2018-09-01' AND '2018-09-07'
)
SELECT e.user_pseudo_id,
       DATE(TIMESTAMP_MICROS(e.event_timestamp),"Asia/Shanghai")               AS d_sh,
       DATE_DIFF(DATE(TIMESTAMP_MICROS(e.event_timestamp),"Asia/Shanghai"),
                 DATE(co.first_open_ts_sh),
                 DAY)                                                          AS days_after_first_open
FROM   `firebase-public-project.analytics_153293282.events_20180914` AS e
JOIN   cohort AS co USING (user_pseudo_id)
WHERE  e.event_name = 'session_start'
LIMIT 20;
```

```sql
--8. Map each return into a week_index (0=cohort week, 1,2,3,…)
WITH cohort AS (
  SELECT user_pseudo_id,
         MIN(TIMESTAMP_MICROS(event_timestamp)) AT TIME ZONE 'Asia/Shanghai' AS first_open_ts_sh
  FROM   `firebase-public-project.analytics_153293282.events_20180901`
  WHERE  event_name = 'first_open'
  GROUP  BY user_pseudo_id
  HAVING DATE(first_open_ts_sh) BETWEEN '2018-09-01' AND '2018-09-07'
)
SELECT e.user_pseudo_id,
       FLOOR(DATE_DIFF(DATE(TIMESTAMP_MICROS(e.event_timestamp),"Asia/Shanghai"),
                       DATE(co.first_open_ts_sh), DAY) / 7)                   AS week_index,
       MIN(DATE(TIMESTAMP_MICROS(e.event_timestamp),"Asia/Shanghai"))         AS first_return_date
FROM   UNNEST([
         '20180908','20180909','20180910','20180911','20180912','20180913','20180914',
         '20180915','20180916','20180917','20180918','20180919','20180920','20180921',
         '20180922','20180923','20180924','20180925','20180926','20180927','20180928'
       ]) AS day_str
JOIN   `firebase-public-project.analytics_153293282.events_`||day_str AS e
  ON   TRUE
JOIN   cohort AS co
  ON   e.user_pseudo_id = co.user_pseudo_id
WHERE  e.event_name = 'session_start'
GROUP  BY user_pseudo_id, week_index
HAVING week_index IN (1,2,3)
LIMIT 20;
```

