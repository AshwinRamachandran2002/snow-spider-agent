  WHERE _TABLE_SUFFIX BETWEEN '01' AND '28'                          -- scan 1‑28 Sep tables only
),

cohort AS (               -- users whose first_open is in 1‑7 Sep (Shanghai)
  SELECT DISTINCT user_pseudo_id
  FROM events
  WHERE event_name = 'first_open'
    AND DATE(sh_ts) BETWEEN '2018-09-01' AND '2018-09-07'
),

activity AS (             -- later activity by those users in weeks 1‑3
  SELECT DISTINCT
    e.user_pseudo_id,
    DATE(e.sh_ts) AS act_date
  FROM events AS e
  JOIN cohort AS c USING (user_pseudo_id)
  WHERE DATE(e.sh_ts) BETWEEN '2018-09-08' AND '2018-09-28'
),

retention AS (            -- one row per user & the week in which they were active
