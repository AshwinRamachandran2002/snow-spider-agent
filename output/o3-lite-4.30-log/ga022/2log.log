```

```sql
--Description: 7) Retained user counts by week‑number (1,2,3) without percentages yet.
WITH cohort AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE _TABLE_SUFFIX BETWEEN '01' AND '07'
    AND event_name = 'first_open'
),
activity AS (
  SELECT
    user_pseudo_id,
    DATE(TIMESTAMP_MICROS(event_timestamp+8*60*60*1000000),"Asia/Shanghai") AS act_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE _TABLE_SUFFIX BETWEEN '08' AND '28'
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM cohort)
)
SELECT
  CASE
    WHEN act_date BETWEEN '2018-09-08' AND '2018-09-14' THEN 1
    WHEN act_date BETWEEN '2018-09-15' AND '2018-09-21' THEN 2
    WHEN act_date BETWEEN '2018-09-22' AND '2018-09-28' THEN 3
  END AS week_num,
  COUNT(DISTINCT user_pseudo_id) AS retained_users
FROM activity
GROUP BY week_num
ORDER BY week_num
LIMIT 20;
```

```sql
--Description: 8) Same as #7 but adds cohort size & computes retention rate per week row.
WITH cohort AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE _TABLE_SUFFIX BETWEEN '01' AND '07'
    AND event_name = 'first_open'
), activity AS (
  SELECT
    user_pseudo_id,
    DATE(TIMESTAMP_MICROS(event_timestamp+8*60*60*1000000),"Asia/Shanghai") AS act_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE _TABLE_SUFFIX BETWEEN '08' AND '28'
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM cohort)
)
SELECT
  CASE
    WHEN act_date BETWEEN '2018-09-08' AND '2018-09-14' THEN 1
    WHEN act_date BETWEEN '2018-09-15' AND '2018-09-21' THEN 2
    WHEN act_date BETWEEN '2018-09-22' AND '2018-09-28' THEN 3
  END AS week_num,
  COUNT(DISTINCT user_pseudo_id) AS retained_users,
  (SELECT COUNT(*) FROM cohort) AS cohort_size,
  COUNT(DISTINCT user_pseudo_id)/(SELECT COUNT(*) FROM cohort) AS retention_rate
FROM activity
GROUP BY week_num
ORDER BY week_num
LIMIT 20;
```

```sql
--Description: 9) Pivot the previous output so each week’s retention becomes its own column.
WITH cohort AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE _TABLE_SUFFIX BETWEEN '01' AND '07'
    AND event_name = 'first_open'
), activity AS (
  SELECT
    user_pseudo_id,
    DATE(TIMESTAMP_MICROS(event_timestamp+8*60*60*1000000),"Asia/Shanghai") AS act_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE _TABLE_SUFFIX BETWEEN '08' AND '28'
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM cohort)
), retention AS (
