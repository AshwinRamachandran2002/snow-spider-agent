    CASE
      WHEN act_date BETWEEN '2018-09-08' AND '2018-09-14' THEN 1
      WHEN act_date BETWEEN '2018-09-15' AND '2018-09-21' THEN 2
      WHEN act_date BETWEEN '2018-09-22' AND '2018-09-28' THEN 3
    END AS week_num
  FROM activity
  GROUP BY user_pseudo_id, week_num
