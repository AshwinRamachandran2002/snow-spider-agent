    CASE
      WHEN act_date BETWEEN '2018-09-08' AND '2018-09-14' THEN 1
      WHEN act_date BETWEEN '2018-09-15' AND '2018-09-21' THEN 2
      WHEN act_date BETWEEN '2018-09-22' AND '2018-09-28' THEN 3
    END AS week_num,
    user_pseudo_id
  FROM activity
  GROUP BY week_num, user_pseudo_id
)
SELECT
  (SELECT COUNT(*) FROM cohort) AS cohort_size,
  COUNTIF(week_num=1) / (SELECT COUNT(*) FROM cohort) AS week1_retention,
  COUNTIF(week_num=2) / (SELECT COUNT(*) FROM cohort) AS week2_retention,
  COUNTIF(week_num=3) / (SELECT COUNT(*) FROM cohort) AS week3_retention
FROM retention
