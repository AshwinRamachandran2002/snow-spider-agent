--Description: (10) Final retention table – cohort size plus Week‑1 / Week‑2 / Week‑3 retention users & rates
WITH cohort AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'first_open'
    AND event_date BETWEEN '20180901' AND '20180907'
),
cohort_size AS (
  SELECT COUNT(*) AS n FROM cohort
),
week_counts AS (
  SELECT 1 AS wk, COUNT(DISTINCT e.user_pseudo_id) AS users
  FROM `firebase-public-project.analytics_153293282.events_201809*` e
  JOIN cohort c USING (user_pseudo_id)
  WHERE e.event_date BETWEEN '20180908' AND '20180914'
  UNION ALL
  SELECT 2 AS wk, COUNT(DISTINCT e.user_pseudo_id) AS users
  FROM `firebase-public-project.analytics_153293282.events_201809*` e
  JOIN cohort c USING (user_pseudo_id)
  WHERE e.event_date BETWEEN '20180915' AND '20180921'
  UNION ALL
  SELECT 3 AS wk, COUNT(DISTINCT e.user_pseudo_id) AS users
  FROM `firebase-public-project.analytics_153293282.events_201809*` e
  JOIN cohort c USING (user_pseudo_id)
  WHERE e.event_date BETWEEN '20180922' AND '20180928'
),
retention AS (
  SELECT
    MAX(CASE WHEN wk = 1 THEN users END) AS week_1_retained_users,
    MAX(CASE WHEN wk = 2 THEN users END) AS week_2_retained_users,
    MAX(CASE WHEN wk = 3 THEN users END) AS week_3_retained_users
  FROM week_counts
)
SELECT
  cs.n                                       AS cohort_size,
  r.week_1_retained_users,
  r.week_2_retained_users,
  r.week_3_retained_users,
  ROUND(r.week_1_retained_users / cs.n, 4)   AS week_1_retention_rate,
  ROUND(r.week_2_retained_users / cs.n, 4)   AS week_2_retention_rate,
  ROUND(r.week_3_retained_users / cs.n, 4)   AS week_3_retention_rate
FROM retention r
CROSS JOIN cohort_size cs
LIMIT 20;
