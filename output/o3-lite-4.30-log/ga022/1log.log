  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'first_open'
  GROUP BY user_pseudo_id
)
WHERE first_open_date BETWEEN '20180901' AND '20180907'
LIMIT 20;
```

```sql
--Description: (6) Any events that the cohort users triggered in Week‑1 (Sept 8‑14)
SELECT e.user_pseudo_id,
       e.event_date,
       e.event_name
FROM `firebase-public-project.analytics_153293282.events_201809*` AS e
JOIN (
    SELECT user_pseudo_id
    FROM (
        SELECT user_pseudo_id,
               MIN(event_date) AS first_open_date
        FROM `firebase-public-project.analytics_153293282.events_*`
        WHERE event_name = 'first_open'
        GROUP BY user_pseudo_id
    )
    WHERE first_open_date BETWEEN '20180901' AND '20180907'
) AS cohort
ON cohort.user_pseudo_id = e.user_pseudo_id
WHERE e.event_date BETWEEN '20180908' AND '20180914'
LIMIT 20;
```

```sql
