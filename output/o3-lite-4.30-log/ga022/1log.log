Relevant columns for the requested weekly retention calculation  

• `event_date`  : filter the cohort window (20180901‑20180907) and the three follow‑up weeks (20180908‑20180914, 20180915‑20180921, 20180922‑20180928).  
• `event_name`  : identify the first open of the app (`'first_open'`) and any return events afterwards (no filter → any `event_name`).  
• `user_pseudo_id` : de‑duplicate users, build the cohort and count unique returns.  
• `event_timestamp` : can be used to translate into UTC+8 if you need sub‑day precision (not required here because `event_date` is already day‑level).  

Typical conditions that will be used  

• `event_name = 'first_open'` (to pick the very first use)  
• `event_date BETWEEN '20180901' AND '20180907'` (build the cohort)  
• `event_date BETWEEN '20180908' AND '20180914'` ‑ Week‑1 retention  
• `event_date BETWEEN '20180915' AND '20180921'` ‑ Week‑2 retention  
• `event_date BETWEEN '20180922' AND '20180928'` ‑ Week‑3 retention  
• `_TABLE_SUFFIX` when the query scans a wildcard such as ```events_201809*``` (to restrict to September tables only).

------------------------------------------------------------------
10 example BigQuery queries (each limited to 20 rows)

```sql
--Description: (1) Show all distinct September 2018 days that exist in the tables
SELECT DISTINCT event_date
FROM `firebase-public-project.analytics_153293282.events_201809*`
ORDER BY event_date
LIMIT 20;
```

```sql
--Description: (2) Sample “first_open” events that happened in the first cohort week (Sep‑1 to Sep‑7)
SELECT event_date,
       user_pseudo_id,
       event_timestamp
FROM `firebase-public-project.analytics_153293282.events_201809*`
WHERE _TABLE_SUFFIX BETWEEN '01' AND '07'          -- Sept 1‑7
  AND event_name = 'first_open'
LIMIT 20;
```

```sql
--Description: (3) Distinct new users (cohort) who opened the app for the first time in Sept 1‑7
SELECT DISTINCT user_pseudo_id
FROM `firebase-public-project.analytics_153293282.events_201809*`
WHERE _TABLE_SUFFIX BETWEEN '01' AND '07'
  AND event_name = 'first_open'
LIMIT 20;
```

```sql
--Description: (4) Earliest “first_open” date for each user across the full data set
SELECT user_pseudo_id,
       MIN(event_date) AS first_open_date
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE event_name = 'first_open'
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
--Description: (5) Users whose first_open date puts them in our Sept 1‑7 cohort
SELECT user_pseudo_id,
       first_open_date
FROM (
  SELECT user_pseudo_id,
         MIN(event_date) AS first_open_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'first_open'
  GROUP BY user_pseudo_id
)
WHERE first_open_date BETWEEN '20180901' AND '20180907'
LIMIT 20;
```

```sql
--Description: (6) Any events that the cohort users triggered in Week‑1 (Sept 8‑14)
SELECT e.user_pseudo_id,
       e.event_date,
       e.event_name
FROM `firebase-public-project.analytics_153293282.events_201809*` AS e
JOIN (
    SELECT user_pseudo_id
    FROM (
        SELECT user_pseudo_id,
               MIN(event_date) AS first_open_date
        FROM `firebase-public-project.analytics_153293282.events_*`
        WHERE event_name = 'first_open'
        GROUP BY user_pseudo_id
    )
    WHERE first_open_date BETWEEN '20180901' AND '20180907'
) AS cohort
ON cohort.user_pseudo_id = e.user_pseudo_id
WHERE e.event_date BETWEEN '20180908' AND '20180914'
LIMIT 20;
```

```sql
--Description: (7) Week‑1 retained user count for the cohort (single‑row result)
SELECT 1 AS week_number,
       COUNT(DISTINCT e.user_pseudo_id) AS retained_users
FROM `firebase-public-project.analytics_153293282.events_201809*` AS e
JOIN (
    SELECT user_pseudo_id
    FROM (
        SELECT user_pseudo_id,
               MIN(event_date) AS first_open_date
        FROM `firebase-public-project.analytics_153293282.events_*`
        WHERE event_name = 'first_open'
        GROUP BY user_pseudo_id
    )
    WHERE first_open_date BETWEEN '20180901' AND '20180907'
) AS cohort
ON cohort.user_pseudo_id = e.user_pseudo_id
WHERE e.event_date BETWEEN '20180908' AND '20180914'
LIMIT 20;
```

```sql
--Description: (8) Week‑1, Week‑2, Week‑3 retained user counts (one row per week)
SELECT week_number,
       retained_users
FROM (
    SELECT 1 AS week_number, COUNT(DISTINCT e.user_pseudo_id) AS retained_users
    FROM `firebase-public-project.analytics_153293282.events_201809*` e
    JOIN (
        SELECT user_pseudo_id
        FROM (
            SELECT user_pseudo_id,
                   MIN(event_date) AS first_open_date
            FROM `firebase-public-project.analytics_153293282.events_*`
            WHERE event_name = 'first_open'
            GROUP BY user_pseudo_id
        )
        WHERE first_open_date BETWEEN '20180901' AND '20180907'
    ) cohort
    ON cohort.user_pseudo_id = e.user_pseudo_id
    WHERE e.event_date BETWEEN '20180908' AND '20180914'

    UNION ALL

    SELECT 2 AS week_number, COUNT(DISTINCT e.user_pseudo_id) AS retained_users
    FROM `firebase-public-project.analytics_153293282.events_201809*` e
    JOIN (
        SELECT user_pseudo_id
        FROM (
            SELECT user_pseudo_id,
                   MIN(event_date) AS first_open_date
            FROM `firebase-public-project.analytics_153293282.events_*`
            WHERE event_name = 'first_open'
            GROUP BY user_pseudo_id
        )
        WHERE first_open_date BETWEEN '20180901' AND '20180907'
    ) cohort
    ON cohort.user_pseudo_id = e.user_pseudo_id
    WHERE e.event_date BETWEEN '20180915' AND '20180921'

    UNION ALL

    SELECT 3 AS week_number, COUNT(DISTINCT e.user_pseudo_id) AS retained_users
    FROM `firebase-public-project.analytics_153293282.events_201809*` e
    JOIN (
        SELECT user_pseudo_id
        FROM (
            SELECT user_pseudo_id,
                   MIN(event_date) AS first_open_date
            FROM `firebase-public-project.analytics_153293282.events_*`
            WHERE event_name = 'first_open'
            GROUP BY user_pseudo_id
        )
        WHERE first_open_date BETWEEN '20180901' AND '20180907'
    ) cohort
    ON cohort.user_pseudo_id = e.user_pseudo_id
    WHERE e.event_date BETWEEN '20180922' AND '20180928'
)
ORDER BY week_number
LIMIT 20;
```

```sql
--Description: (9) Size of the cohort (needed to calculate retention rates)
SELECT COUNT(DISTINCT user_pseudo_id) AS cohort_size
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE event_name = 'first_open'
  AND event_date BETWEEN '20180901' AND '20180907'
LIMIT 20;
```

```sql
--Description: (10) Final retention table – cohort size plus Week‑1 / Week‑2 / Week‑3 retention users & rates
WITH cohort AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'first_open'
    AND event_date BETWEEN '20180901' AND '20180907'
),
cohort_size AS (
  SELECT COUNT(*) AS n FROM cohort
),
week_counts AS (
  SELECT 1 AS wk, COUNT(DISTINCT e.user_pseudo_id) AS users
  FROM `firebase-public-project.analytics_153293282.events_201809*` e
  JOIN cohort c USING (user_pseudo_id)
  WHERE e.event_date BETWEEN '20180908' AND '20180914'
  UNION ALL
  SELECT 2 AS wk, COUNT(DISTINCT e.user_pseudo_id) AS users
  FROM `firebase-public-project.analytics_153293282.events_201809*` e
  JOIN cohort c USING (user_pseudo_id)
  WHERE e.event_date BETWEEN '20180915' AND '20180921'
  UNION ALL
  SELECT 3 AS wk, COUNT(DISTINCT e.user_pseudo_id) AS users
  FROM `firebase-public-project.analytics_153293282.events_201809*` e
  JOIN cohort c USING (user_pseudo_id)
  WHERE e.event_date BETWEEN '20180922' AND '20180928'
),
retention AS (
  SELECT
    MAX(CASE WHEN wk = 1 THEN users END) AS week_1_retained_users,
    MAX(CASE WHEN wk = 2 THEN users END) AS week_2_retained_users,
    MAX(CASE WHEN wk = 3 THEN users END) AS week_3_retained_users
  FROM week_counts
)
SELECT
  cs.n                                       AS cohort_size,
  r.week_1_retained_users,
  r.week_2_retained_users,
  r.week_3_retained_users,
  ROUND(r.week_1_retained_users / cs.n, 4)   AS week_1_retention_rate,
  ROUND(r.week_2_retained_users / cs.n, 4)   AS week_2_retention_rate,
  ROUND(r.week_3_retained_users / cs.n, 4)   AS week_3_retention_rate
FROM retention r
CROSS JOIN cohort_size cs
LIMIT 20;
```

These ten queries guide you from exploring the raw September tables, through building the cohort, to producing the requested Week‑1 / Week‑2 / Week‑3 retention rates for users whose very first app open fell between 1‑Sep‑2018 and 7‑Sep‑2018 (Shanghai time).
