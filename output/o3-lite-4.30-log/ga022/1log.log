  ROUND(w1_users / n, 4)                             AS week1_retention_rate,
  ROUND(w2_users / n, 4)                             AS week2_retention_rate,
  ROUND(w3_users / n, 4)                             AS week3_retention_rate
FROM pivot
CROSS JOIN cohort_size;
