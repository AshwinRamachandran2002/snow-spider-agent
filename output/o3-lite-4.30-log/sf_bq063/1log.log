2025-05-01 01:58:16 - Thread-608 (execute) - INFO - [Exploration]
Relevant columns & potential usage  

• PACKAGEVERSIONS."System" : restrict to the NPM ecosystem  
• PACKAGEVERSIONS."Name" : package name (exclude those that contain ‘@’)  
• PACKAGEVERSIONS."Version" : version string – will be joined with DEPENDENCIES  
• PACKAGEVERSIONS."SnapshotAt" : choose the newest snapshot for a package / version  
• PACKAGEVERSIONS."VersionInfo" : JSON – key "IsRelease" tells if a version is a release  
• PACKAGEVERSIONS."Links" : JSON – flatten to find objects where "Label" = 'SOURCE_REPO' and the "URL" contains 'github.com'  
• DEPENDENCIES."System" : filter for NPM  
• DEPENDENCIES."Name", DEPENDENCIES."Version" : join‑keys with PACKAGEVERSIONS  
• DEPENDENCIES."Dependency" : each row = one dependency → COUNT(*) to measure “number of dependencies”  

Typical conditions to be used  

• "System" = 'NPM'  
• "Name" NOT ILIKE '%@%'                -- exclude scoped packages  
• f.value:"Label"::STRING = 'SOURCE_REPO'  
• f.value:"URL"::STRING ILIKE '%github.com%'  
• pv."VersionInfo":"IsRelease"::BOOLEAN = TRUE  

--------------------------------------------------------------------
Below are ten exploratory Snowflake SQL queries (LIMIT 20 each) that progress from simple inspection toward assembling the final result.  
Every column name is double‑quoted and each query is preceded by an explanatory comment.

```sql
-- 1) Quick look at some NPM package versions (excluding names with '@')
SELECT "Name",
       "Version",
       "SnapshotAt"
FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
WHERE  "System" = 'NPM'
  AND  "Name"  NOT ILIKE '%@%'
LIMIT  20;
```

```sql
-- 2) Inspect the JSON structure of the "Links" column for one random NPM package
SELECT pv."Name",
       pv."Version",
       f.value AS "LinkObject"
FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS  pv,
       LATERAL FLATTEN(input => pv."Links") f
WHERE  pv."System" = 'NPM'
  AND  pv."Name"  NOT ILIKE '%@%'
LIMIT  20;
```

```sql
-- 3) Extract Label & URL from flattened Links to see which have SOURCE_REPO pointing to GitHub
SELECT pv."Name",
       pv."Version",
       f.value:"Label"::STRING AS "Label",
       f.value:"URL"::STRING   AS "URL"
FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS  pv,
       LATERAL FLATTEN(input => pv."Links") f
WHERE  pv."System" = 'NPM'
  AND  pv."Name"  NOT ILIKE '%@%'
  AND  f.value:"Label"::STRING = 'SOURCE_REPO'
  AND  f.value:"URL"::STRING ILIKE '%github.com%'
LIMIT  20;
```

```sql
-- 4) Peek at VersionInfo to verify the "IsRelease" flag
SELECT "Name",
       "Version",
       "VersionInfo":"IsRelease"::BOOLEAN AS "IsRelease",
       "VersionInfo"                     AS "RawVersionInfo"
FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
WHERE  "System" = 'NPM'
  AND  "Name"  NOT ILIKE '%@%'
LIMIT  20;
```

```sql
-- 5) Count how many dependencies each (name,version) pair has in the DEPENDENCIES table
SELECT "Name",
       "Version",
       COUNT(*) AS "DepCount"
FROM   DEPS_DEV_V1.DEPS_DEV_V1.DEPENDENCIES
WHERE  "System" = 'NPM'
  AND  "Name"  NOT ILIKE '%@%'
GROUP BY "Name","Version"
ORDER BY "DepCount" DESC
LIMIT  20;
```

```sql
-- 6) Keep only dependency counts for versions that are tagged as releases
WITH rel AS (
  SELECT "Name","Version"
  FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
  WHERE  "System" = 'NPM'
    AND  "Name"  NOT ILIKE '%@%'
    AND  "VersionInfo":"IsRelease"::BOOLEAN = TRUE
)
SELECT d."Name",
       d."Version",
       COUNT(*) AS "DepCount"
FROM   DEPS_DEV_V1.DEPS_DEV_V1.DEPENDENCIES  d
JOIN   rel
  ON   rel."Name" = d."Name"
 AND   rel."Version" = d."Version"
GROUP BY d."Name",d."Version"
ORDER BY "DepCount" DESC
LIMIT  20;
```

```sql
-- 7) Select the latest release version for every package name (via max SnapshotAt)
WITH rel_versions AS (
  SELECT "Name",
         "Version",
         "SnapshotAt",
         ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "SnapshotAt" DESC) AS rn
  FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
  WHERE  "System" = 'NPM'
    AND  "Name"  NOT ILIKE '%@%'
    AND  "VersionInfo":"IsRelease"::BOOLEAN = TRUE
)
SELECT "Name",
       "Version",
       "SnapshotAt"
FROM   rel_versions
WHERE  rn = 1
LIMIT  20;
```

```sql
-- 8) Bring together latest release versions with their dependency counts
WITH latest AS (
  SELECT "Name","Version"
  FROM  (
    SELECT "Name",
           "Version",
           "SnapshotAt",
           ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "SnapshotAt" DESC) AS rn
    FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
    WHERE  "System" = 'NPM'
      AND  "Name"  NOT ILIKE '%@%'
      AND  "VersionInfo":"IsRelease"::BOOLEAN = TRUE
  )
  WHERE rn = 1
)
SELECT d."Name",
       d."Version",
       COUNT(*) AS "DepCount"
FROM   DEPS_DEV_V1.DEPS_DEV_V1.DEPENDENCIES d
JOIN   latest
  ON   latest."Name" = d."Name"
 AND   latest."Version" = d."Version"
GROUP BY d."Name", d."Version"
ORDER BY "DepCount" DESC
LIMIT  20;
```

```sql
-- 9) Add SOURCE_REPO GitHub URL for each candidate version
WITH latest AS (
  SELECT "Name","Version"
  FROM  (
    SELECT "Name",
           "Version",
           "SnapshotAt",
           ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "SnapshotAt" DESC) AS rn
    FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
    WHERE  "System" = 'NPM'
      AND  "Name"  NOT ILIKE '%@%'
      AND  "VersionInfo":"IsRelease"::BOOLEAN = TRUE
  )
  WHERE rn = 1
),
deps AS (
  SELECT d."Name",
         d."Version",
         COUNT(*) AS "DepCount"
  FROM   DEPS_DEV_V1.DEPS_DEV_V1.DEPENDENCIES d
  JOIN   latest
    ON   latest."Name" = d."Name"
   AND   latest."Version" = d."Version"
  GROUP BY d."Name", d."Version"
)
SELECT deps."Name",
       deps."Version",
       deps."DepCount",
       f.value:"URL"::STRING AS "GitHubURL"
FROM   deps
JOIN   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv
  ON   pv."Name"    = deps."Name"
 AND  pv."Version" = deps."Version"
     -- the join keeps only the same exact version
,     LATERAL FLATTEN(input => pv."Links") f
WHERE  f.value:"Label"::STRING = 'SOURCE_REPO'
  AND  f.value:"URL"::STRING ILIKE '%github.com%'
ORDER BY deps."DepCount" DESC
LIMIT  20;
```

```sql
-- 10) (Final step) Retrieve the single GitHub SOURCE_REPO URL of the package whose latest release has the most dependencies
WITH latest AS (
  SELECT "Name","Version"
  FROM  (
    SELECT "Name",
           "Version",
           "SnapshotAt",
           ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "SnapshotAt" DESC) AS rn
    FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
    WHERE  "System" = 'NPM'
      AND  "Name"  NOT ILIKE '%@%'
      AND  "VersionInfo":"IsRelease"::BOOLEAN = TRUE
  )
  WHERE rn = 1
),
deps AS (
  SELECT d."Name",
         d."Version",
         COUNT(*) AS "DepCount"
  FROM   DEPS_DEV_V1.DEPS_DEV_V1.DEPENDENCIES d
  JOIN   latest
    ON   latest."Name" = d."Name"
   AND   latest."Version" = d."Version"
  GROUP BY d."Name", d."Version"
)
SELECT f.value:"URL"::STRING AS "GitHubURL",
       deps."Name",
       deps."Version",
       deps."DepCount"
FROM   deps
JOIN   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv
  ON   pv."Name"    = deps."Name"
 AND  pv."Version"  = deps."Version"
,     LATERAL FLATTEN(input => pv."Links") f
WHERE  f.value:"Label"::STRING = 'SOURCE_REPO'
  AND  f.value:"URL"::STRING ILIKE '%github.com%'
ORDER BY deps."DepCount" DESC
LIMIT  20;
```

These ten queries move step‑by‑step from basic exploration to the composed query that will reveal the requested GitHub URL for the qualifying NPM package.
