WITH latest_release AS (
    SELECT
        "Name",
        "Version",
        ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "SnapshotAt" DESC) AS rn
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
    WHERE "System" = 'NPM'
      AND "Name" NOT LIKE '%@%'                                  -- exclude scoped packages
      AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE              -- keep only releases
),
latest_per_package AS (        -- most‑recent release of every package
    SELECT "Name", "Version"
    FROM   latest_release
    WHERE  rn = 1
),
dep_counts AS (                -- dependency count for each latest release
    SELECT
        d."Name",
        d."Version",
        COUNT(*) AS dep_count
    FROM   DEPS_DEV_V1.DEPS_DEV_V1.DEPENDENCIES d
    JOIN   latest_per_package lp
      ON   lp."Name"    = d."Name"
     AND   lp."Version" = d."Version"
    WHERE  d."System" = 'NPM'
    GROUP BY d."Name", d."Version"
),
top_pkg AS (                   -- package whose latest release has the most dependencies
    SELECT
        "Name",
        "Version",
        dep_count
    FROM   dep_counts
    ORDER BY dep_count DESC NULLS LAST, "Name"
    LIMIT 1
)
SELECT
    f.value:"URL"::STRING AS "SOURCE_REPO"
FROM   top_pkg t
JOIN   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv
  ON   pv."Name"    = t."Name"
 AND  pv."Version"  = t."Version",
     LATERAL FLATTEN(input => pv."Links") f
WHERE  f.value:"Label"::STRING = 'SOURCE_REPO'
  AND  f.value:"URL"::STRING LIKE '%github.com%'
LIMIT 1;
