FROM "extra_runs"
LIMIT 20;
```

```sql
-- 5) Look at a joined view of one match: striker, runs off the bat and extras for each ball
SELECT b."match_id",
       b."over_id",
       b."ball_id",
       b."striker",
       IFNULL(bs."runs_scored",0)  AS "bat_runs",
       IFNULL(er."extra_runs",0)   AS "extra_runs"
FROM   "ball_by_ball" AS b
LEFT JOIN "batsman_scored" AS bs
       ON  b."match_id"  = bs."match_id"
       AND b."over_id"   = bs."over_id"
       AND b."ball_id"   = bs."ball_id"
       AND b."innings_no"= bs."innings_no"
LEFT JOIN "extra_runs"     AS er
       ON  b."match_id"  = er."match_id"
       AND b."over_id"   = er."over_id"
       AND b."ball_id"   = er."ball_id"
       AND b."innings_no"= er."innings_no"
WHERE  b."match_id" = 335987
LIMIT 20;
```

```sql
-- 6) Display some wickets to understand where partnerships break
SELECT DISTINCT "match_id",
                "over_id",
                "ball_id",
                "player_out",
                "kind_out"
FROM "wicket_taken"
LIMIT 20;
```

```sql
-- 7) Compute (for one match) the total runs a given pair collected together
WITH ball_runs AS (
    SELECT b."match_id",
           CASE WHEN b."striker" < b."non_striker" THEN b."striker"
                ELSE b."non_striker" END          AS "p_low",
           CASE WHEN b."striker" < b."non_striker" THEN b."non_striker"
                ELSE b."striker" END              AS "p_high",
           b."striker"                            AS "striker_id",
           IFNULL(bs."runs_scored",0)             AS "bat_runs",
           IFNULL(er."extra_runs",0)              AS "extra_runs"
    FROM   "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS bs
      ON  b."match_id"   = bs."match_id"
      AND b."over_id"    = bs."over_id"
      AND b."ball_id"    = bs."ball_id"
      AND b."innings_no" = bs."innings_no"
    LEFT JOIN "extra_runs"     AS er
      ON  b."match_id"   = er."match_id"
      AND b."over_id"    = er."over_id"
      AND b."ball_id"    = er."ball_id"
      AND b."innings_no" = er."innings_no"
    WHERE  b."match_id" = 335987
)
SELECT "p_low"  AS "player_a",
       "p_high" AS "player_b",
       SUM("bat_runs" + "extra_runs") AS "partnership_runs"
FROM   ball_runs
GROUP BY "player_a", "player_b"
ORDER BY "partnership_runs" DESC
LIMIT 20;
```

```sql
-- 8) Add individual contributions (still within one match)
WITH ball_runs AS (
    SELECT b."match_id",
           CASE WHEN b."striker" < b."non_striker" THEN b."striker"
                ELSE b."non_striker" END          AS "p_low",
           CASE WHEN b."striker" < b."non_striker" THEN b."non_striker"
                ELSE b."striker" END              AS "p_high",
           b."striker"                            AS "striker_id",
           IFNULL(bs."runs_scored",0)             AS "bat_runs",
           IFNULL(er."extra_runs",0)              AS "extra_runs"
    FROM "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS bs
      ON  b."match_id"   = bs."match_id"
      AND b."over_id"    = bs."over_id"
      AND b."ball_id"    = bs."ball_id"
      AND b."innings_no" = bs."innings_no"
    LEFT JOIN "extra_runs"     AS er
      ON  b."match_id"   = er."match_id"
      AND b."over_id"    = er."over_id"
      AND b."ball_id"    = er."ball_id"
      AND b."innings_no" = er."innings_no"
    WHERE b."match_id" = 335987
)
SELECT "p_low"  AS "player_a",
       "p_high" AS "player_b",
       SUM(CASE WHEN "striker_id" = "p_low"  THEN "bat_runs" ELSE 0 END) AS "runs_a",
       SUM(CASE WHEN "striker_id" = "p_high" THEN "bat_runs" ELSE 0 END) AS "runs_b",
       SUM("bat_runs" + "extra_runs") AS "partnership_runs"
FROM   ball_runs
GROUP BY "player_a", "player_b"
ORDER BY "partnership_runs" DESC
LIMIT 20;
```

```sql
-- 9) Do the same aggregation for *all* matches
WITH ball_runs AS (
    SELECT b."match_id",
           CASE WHEN b."striker" < b."non_striker" THEN b."striker"
                ELSE b."non_striker" END          AS "p_low",
           CASE WHEN b."striker" < b."non_striker" THEN b."non_striker"
                ELSE b."striker" END              AS "p_high",
           b."striker"                            AS "striker_id",
           IFNULL(bs."runs_scored",0)             AS "bat_runs",
           IFNULL(er."extra_runs",0)              AS "extra_runs"
    FROM "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS bs
      ON  b."match_id"   = bs."match_id"
      AND b."over_id"    = bs."over_id"
      AND b."ball_id"    = bs."ball_id"
      AND b."innings_no" = bs."innings_no"
    LEFT JOIN "extra_runs"     AS er
      ON  b."match_id"   = er."match_id"
      AND b."over_id"    = er."over_id"
      AND b."ball_id"    = er."ball_id"
      AND b."innings_no" = er."innings_no"
)
SELECT "match_id",
       "p_low"  AS "player_a",
       "p_high" AS "player_b",
       SUM(CASE WHEN "striker_id" = "p_low"  THEN "bat_runs" ELSE 0 END) AS "runs_a",
       SUM(CASE WHEN "striker_id" = "p_high" THEN "bat_runs" ELSE 0 END) AS "runs_b",
       SUM("bat_runs" + "extra_runs") AS "partnership_runs"
FROM   ball_runs
GROUP BY "match_id", "player_a", "player_b"
LIMIT 20;
```

```sql
-- 10) Final step – for every match pick the pair(s) with the highest partnership
WITH ball_runs AS (
    SELECT b."match_id",
           CASE WHEN b."striker" < b."non_striker" THEN b."striker"
                ELSE b."non_striker" END          AS "p_low",
           CASE WHEN b."striker" < b."non_striker" THEN b."non_striker"
                ELSE b."striker" END              AS "p_high",
           b."striker"                            AS "striker_id",
           IFNULL(bs."runs_scored",0)             AS "bat_runs",
           IFNULL(er."extra_runs",0)              AS "extra_runs"
    FROM "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS bs
      ON  b."match_id"   = bs."match_id"
      AND b."over_id"    = bs."over_id"
      AND b."ball_id"    = bs."ball_id"
      AND b."innings_no" = bs."innings_no"
    LEFT JOIN "extra_runs"     AS er
      ON  b."match_id"   = er."match_id"
      AND b."over_id"    = er."over_id"
      AND b."ball_id"    = er."ball_id"
      AND b."innings_no" = er."innings_no"
),
pair_totals AS (
    SELECT "match_id",
           "p_low",
           "p_high",
           SUM(CASE WHEN "striker_id" = "p_low"  THEN "bat_runs" ELSE 0 END) AS "runs_low",
           SUM(CASE WHEN "striker_id" = "p_high" THEN "bat_runs" ELSE 0 END) AS "runs_high",
           SUM("bat_runs" + "extra_runs") AS "partner_runs"
    FROM   ball_runs
    GROUP BY "match_id", "p_low", "p_high"
),
ordered_pairs AS (
    -- decide who is player1 (higher individual runs, or higher id if equal)
    SELECT "match_id",
           CASE
               WHEN "runs_low"  > "runs_high" THEN "p_low"
               WHEN "runs_high" > "runs_low"  THEN "p_high"
               WHEN "runs_low" = "runs_high"  AND "p_low"  > "p_high" THEN "p_low"
                                                   ELSE "p_high"
           END AS "player1",
           CASE
               WHEN "runs_low"  > "runs_high" THEN "p_high"
               WHEN "runs_high" > "runs_low"  THEN "p_low"
               WHEN "runs_low" = "runs_high"  AND "p_low"  > "p_high" THEN "p_high"
                                                   ELSE "p_low"
           END AS "player2",
           CASE
               WHEN "runs_low"  >= "runs_high" THEN "runs_low"
               ELSE  "runs_high"
           END AS "player1_runs",
           CASE
               WHEN "runs_low"  >= "runs_high" THEN "runs_high"
               ELSE  "runs_low"
           END AS "player2_runs",
           "partner_runs"
    FROM pair_totals
),
max_per_match AS (
    SELECT "match_id",
           MAX("partner_runs") AS "max_partnership"
    FROM   ordered_pairs
    GROUP BY "match_id"
)
SELECT o."match_id",
       o."player1",
       o."player1_runs",
       o."player2",
       o."player2_runs",
       o."partner_runs" AS "partnership_runs"
FROM   ordered_pairs AS o
JOIN   max_per_match AS m
  ON   o."match_id" = m."match_id"
 AND   o."partner_runs" = m."max_partnership"
LIMIT 20;
```

The final query (No. 10) returns, for each match, the player‑ids of the pair (possibly several pairs if tied) that amassed the highest partnership runs, with the higher individual scorer listed first and the lower listed second, following the required tie‑break rules.
