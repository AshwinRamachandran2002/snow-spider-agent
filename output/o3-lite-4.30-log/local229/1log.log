-- 10. Bring individual contributions for the top partnership of each match
WITH pair_runs AS (
  SELECT b.match_id,
         b.striker AS p1,
         b.non_striker AS p2,
         SUM(COALESCE(s.runs_scored,0) + COALESCE(e.extra_runs,0)) AS pair_total
  FROM ball_by_ball AS b
  LEFT JOIN batsman_scored AS s
    ON s.match_id = b.match_id
   AND s.over_id  = b.over_id
   AND s.ball_id  = b.ball_id
   AND s.innings_no = b.innings_no
  LEFT JOIN extra_runs AS e
    ON e.match_id = b.match_id
   AND e.over_id  = b.over_id
   AND e.ball_id  = b.ball_id
   AND e.innings_no = b.innings_no
  GROUP BY b.match_id, b.striker, b.non_striker
), best_pair AS (
  SELECT *
  FROM (
    SELECT pr.*,
           RANK() OVER (PARTITION BY pr.match_id ORDER BY pr.pair_total DESC) AS rk
    FROM pair_runs AS pr
  )
  WHERE rk = 1
), individual AS (
  SELECT b.match_id, b.striker AS player_id,
         SUM(COALESCE(s.runs_scored,0)) AS indiv_runs
  FROM ball_by_ball AS b
  LEFT JOIN batsman_scored AS s
    ON s.match_id = b.match_id
   AND s.over_id  = b.over_id
   AND s.ball_id  = b.ball_id
   AND s.innings_no = b.innings_no
  GROUP BY b.match_id, b.striker
)
SELECT bp.match_id,
       CASE
         WHEN i1.indiv_runs > i2.indiv_runs THEN bp.p1
         WHEN i1.indiv_runs < i2.indiv_runs THEN bp.p2
         WHEN bp.p1 > bp.p2                THEN bp.p1
         ELSE bp.p2
       END AS player1_id,
       CASE
         WHEN i1.indiv_runs > i2.indiv_runs THEN bp.p2
         WHEN i1.indiv_runs < i2.indiv_runs THEN bp.p1
         WHEN bp.p1 > bp.p2                THEN bp.p2
         ELSE bp.p1
       END AS player2_id,
       MAX(i1.indiv_runs, i2.indiv_runs) AS player1_runs,
       MIN(i1.indiv_runs, i2.indiv_runs) AS player2_runs,
       bp.pair_total                      AS partnership_runs
FROM best_pair AS bp
JOIN individual AS i1
  ON i1.match_id = bp.match_id AND i1.player_id = bp.p1
JOIN individual AS i2
  ON i2.match_id = bp.match_id AND i2.player_id = bp.p2
LIMIT 20;
