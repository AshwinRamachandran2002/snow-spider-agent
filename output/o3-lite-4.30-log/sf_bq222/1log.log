--Description: The aim is to confirm that German patents granted in December 2016 really do
--             reference CPC level‑4 groups.  Earlier “no data” was probably due to joining
--             the full CPC codes (e.g. “F04D29/384”) to level‑4 definitions, which are stored
--             only as the first three characters (class symbols, e.g. “F04”).  
--             Strategy in this single query
--               1. Filter PUBLICATIONS to Germany ("country_code" = 'DE') *and* grant dates
--                  between 1‑Dec‑2016 and 31‑Dec‑2016.  
--               2. Use CROSS‑JOIN‑LATERAL FLATTEN to explode the JSON array in "cpc"; each
--                  element has field "code".  
--               3. Join to CPC_DEFINITION by matching the first three characters of that
--                  "code" (class symbol) to cd."symbol".  
--               4. Keep only definitions whose hierarchy "level" = 4.0.  
--               5. Select DISTINCT symbol and full title; LIMIT 20 for a quick sample.
SELECT DISTINCT
       cd."symbol"    AS "cpc_level4",
       cd."titleFull" AS "cpc_title"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f,
     PATENTS.PATENTS.CPC_DEFINITION cd
WHERE p."country_code" = 'DE'
  AND p."grant_date" BETWEEN 20161201 AND 20161231
  AND cd."level" = 4.0
  AND cd."symbol" = SUBSTR(f.value:"code"::STRING, 1, 3)
LIMIT 20;
