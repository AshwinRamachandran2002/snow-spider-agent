Query:
--Description: 10) Final answer: give CPC level‑4 symbol, full title, and the
--              calendar year with the highest EMA (α = 0.1) of annual German
--              filings for patents granted in December 2016; no nested windows.
WITH yearly AS (                 -- yearly filing counts with title
    SELECT
        cd."symbol"                            AS "cpc_level4",
        cd."titleFull"                         AS "cpc_title",
        FLOOR(p."publication_date" / 10000)    AS "year",
        COUNT(DISTINCT p."publication_number") AS "filings"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f,
         PATENTS.PATENTS.CPC_DEFINITION cd
    WHERE p."country_code" = 'DE'
      AND p."grant_date" BETWEEN 20161201 AND 20161231
      AND cd."level" = 4.0
      AND cd."symbol" = SUBSTR(f.value:"code"::STRING, 1, 3)
    GROUP BY cd."symbol", cd."titleFull", FLOOR(p."publication_date" / 10000)
), ranked AS (                   -- add descending row number
    SELECT
        y.*,
        ROW_NUMBER() OVER (PARTITION BY y."cpc_level4"
                           ORDER BY y."year" DESC) AS rn_desc
    FROM yearly y
), ema AS (                      -- compute EMA
    SELECT
        r.*,
        SUM( r."filings" * POWER(0.9, r.rn_desc - 1) )
            OVER (PARTITION BY r."cpc_level4"
                  ORDER BY r."year" DESC) * 0.1     AS "ema_alpha_point1"
    FROM ranked r
), best_year AS (                -- select best year per group
    SELECT
        e.*,
        ROW_NUMBER() OVER (PARTITION BY e."cpc_level4"
                           ORDER BY e."ema_alpha_point1" DESC) AS rn
    FROM ema e
)
SELECT
    "cpc_title",
    "cpc_level4",
    "year"              AS "best_year",
    "ema_alpha_point1"
FROM best_year
WHERE rn = 1
LIMIT 20
