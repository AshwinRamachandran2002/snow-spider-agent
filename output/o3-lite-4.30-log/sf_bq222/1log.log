Query:
--Description: 7) Count German patent filings per calendar year and CPC level‑4 group
--             for patents whose grant date fell in December 2016.  Uses CROSS‑JOIN‑LATERAL
--             FLATTEN (comma syntax) and matches the first 3 characters of each CPC code
--             to the level‑4 symbol in CPC_DEFINITION.
SELECT
    cd."symbol"                              AS "cpc_level4",
    FLOOR(p."publication_date" / 10000)      AS "year",
    COUNT(DISTINCT p."publication_number")   AS "filings"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f,
