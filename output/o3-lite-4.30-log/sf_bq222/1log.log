```sql
--Description: 1) Look at 20 German publications to confirm basic columns.
SELECT 
  "publication_number",
  "country_code",
  "grant_date",
  "publication_date",
  "cpc"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'DE'
LIMIT 20;
```

```sql
--Description: 2) Check whether any records have grant dates in December 2016.
SELECT 
  "publication_number",
  "grant_date"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "grant_date" BETWEEN 20161201 AND 20161231
  AND "country_code" = 'DE'
LIMIT 20;
```

```sql
--Description: 3) Inspect raw structure of the "cpc" variant column (first few rows).
SELECT 
  f.value
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f
WHERE p."country_code" = 'DE'
LIMIT 20;
