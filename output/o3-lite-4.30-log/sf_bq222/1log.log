--Description: 8) Compute an exponential moving average (α = 0.1) of annual filings
--             for each CPC level‑4 group, based on German patents granted in Dec 2016.
WITH yearly AS (
  SELECT
      cd."symbol"                            AS "cpc_level4",
      FLOOR(p."publication_date" / 10000)    AS "year",
      COUNT(DISTINCT p."publication_number") AS "filings"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc") f,
       PATENTS.PATENTS.CPC_DEFINITION cd
  WHERE p."country_code" = 'DE'
    AND p."grant_date"  BETWEEN 20161201 AND 20161231
    AND cd."level"      = 4.0
    AND cd."symbol"     = SUBSTR(f.value:"code"::STRING, 1, 3)
  GROUP BY cd."symbol", FLOOR(p."publication_date" / 10000)
)
SELECT
    y."cpc_level4",
    y."year",
    y."filings",
    /* Exponential moving average:  EMA_t = 0.1·x_t + 0.9·EMA_{t‑1}               */
    /* Implemented by a reverse‑ordered weighted sum inside a running window.     */
    SUM( y."filings"
         * POWER(0.9,
                 ROW_NUMBER() OVER (PARTITION BY y."cpc_level4"
                                    ORDER BY y."year" DESC) - 1)
       ) OVER (PARTITION BY y."cpc_level4"
               ORDER BY y."year") * 0.1        AS "ema_alpha_point1"
FROM yearly y
ORDER BY y."cpc_level4", y."year"
