--Description: 9) For every CPC level‑4 group, determine the calendar year with
--             the highest exponential moving average (α = 0.1) of annual filing
--             counts, based on German patents granted in December 2016.  All
--             window‑function nesting is removed by introducing an intermediate
--             RANKED step that supplies a plain row number (rn_desc).
WITH yearly AS (                 -- step 1: yearly counts
    SELECT
        cd."symbol"                            AS "cpc_level4",
        FLOOR(p."publication_date" / 10000)    AS "year",
        COUNT(DISTINCT p."publication_number") AS "filings"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f,
         PATENTS.PATENTS.CPC_DEFINITION cd
    WHERE p."country_code" = 'DE'
      AND p."grant_date" BETWEEN 20161201 AND 20161231
      AND cd."level" = 4.0
      AND cd."symbol" = SUBSTR(f.value:"code"::STRING, 1, 3)
    GROUP BY cd."symbol", FLOOR(p."publication_date" / 10000)
), ranked AS (                   -- step 2: descending row number per group
    SELECT
        y.*,
        ROW_NUMBER() OVER (PARTITION BY y."cpc_level4"
                           ORDER BY y."year" DESC) AS rn_desc
    FROM yearly y
), ema AS (                      -- step 3: compute EMA using running weighted sum
    SELECT
        r.*,
        SUM( r."filings" * POWER(0.9, r.rn_desc - 1) )
            OVER (PARTITION BY r."cpc_level4"
                  ORDER BY r."year" DESC) * 0.1     AS "ema_alpha_point1"
    FROM ranked r
), best AS (                     -- step 4: pick the year with max EMA per group
    SELECT
        e.*,
        ROW_NUMBER() OVER (PARTITION BY e."cpc_level4"
                           ORDER BY e."ema_alpha_point1" DESC) AS rn
    FROM ema e
)
SELECT
    "cpc_level4",
    "year"                AS "best_year",
    "ema_alpha_point1"
FROM best
WHERE rn = 1
LIMIT 20;
