  "symbol",
  "level",
  "titleFull"
FROM PATENTS.PATENTS.CPC_DEFINITION
WHERE "level" = 4.0
LIMIT 20;
```

```sql
--Description: 6) Join German December‑2016 grants with their CPC level‑4 groups & titles (sample 20).
SELECT 
  DISTINCT cd."symbol"       AS "cpc_level4",
  cd."titleFull"             AS "cpc_title"
FROM PATENTS.PATENTS.PUBLICATIONS p
JOIN LATERAL FLATTEN(input => p."cpc") f
      ON TRUE
JOIN PATENTS.PATENTS.CPC_DEFINITION cd
      ON cd."symbol" = f.value:"symbol"::STRING
WHERE p."country_code" = 'DE'
  AND p."grant_date" BETWEEN 20161201 AND 20161231
  AND cd."level" = 4.0
LIMIT 20;
```

```sql
--Description: 7) Count German filings per year & CPC level‑4 group for patents granted in Dec‑2016.
SELECT 
  cd."symbol"                               AS "cpc_level4",
  FLOOR(p."publication_date"/10000) AS "year",
  COUNT(DISTINCT p."publication_number")    AS "filings"
FROM PATENTS.PATENTS.PUBLICATIONS p
JOIN LATERAL FLATTEN(input => p."cpc") f ON TRUE
JOIN PATENTS.PATENTS.CPC_DEFINITION cd   ON cd."symbol" = f.value:"symbol"::STRING
WHERE p."country_code" = 'DE'
  AND p."grant_date" BETWEEN 20161201 AND 20161231
  AND cd."level" = 4.0
GROUP BY cd."symbol", FLOOR(p."publication_date"/10000)
ORDER BY cd."symbol", "year"
LIMIT 20;
```

```sql
--Description: 8) Derive an exponential moving average (α=0.1) of annual filings per CPC group.
WITH yearly AS (
  SELECT 
    cd."symbol"                           AS "cpc_level4",
    FLOOR(p."publication_date"/10000)     AS "year",
    COUNT(DISTINCT p."publication_number") AS "filings"
  FROM PATENTS.PATENTS.PUBLICATIONS p
  JOIN LATERAL FLATTEN(input => p."cpc") f ON TRUE
  JOIN PATENTS.PATENTS.CPC_DEFINITION cd  ON cd."symbol" = f.value:"symbol"::STRING
  WHERE p."country_code" = 'DE'
    AND p."grant_date" BETWEEN 20161201 AND 20161231
    AND cd."level" = 4.0
  GROUP BY cd."symbol", FLOOR(p."publication_date"/10000)
)
SELECT 
  y."cpc_level4",
  y."year",
  y."filings",
  -- simple EMA using recursive window: ema_t = 0.1*filings + 0.9*ema_{t-1}
  SUM(y."filings" * POWER(0.9, ROW_NUMBER() OVER (PARTITION BY y."cpc_level4" ORDER BY y."year" DESC) - 1)) 
    OVER (PARTITION BY y."cpc_level4" ORDER BY y."year") * 0.1 
    AS "ema_alpha_point1"
FROM yearly y
ORDER BY y."cpc_level4", y."year"
LIMIT 20;
```

```sql
--Description: 9) Identify, for each CPC level‑4 group, the year with the highest EMA.
WITH yearly AS (
  SELECT 
    cd."symbol"                           AS "cpc_level4",
    FLOOR(p."publication_date"/10000)     AS "year",
    COUNT(DISTINCT p."publication_number") AS "filings"
  FROM PATENTS.PATENTS.PUBLICATIONS p
  JOIN LATERAL FLATTEN(input => p."cpc") f ON TRUE
  JOIN PATENTS.PATENTS.CPC_DEFINITION cd  ON cd."symbol" = f.value:"symbol"::STRING
  WHERE p."country_code" = 'DE'
    AND p."grant_date" BETWEEN 20161201 AND 20161231
    AND cd."level" = 4.0
  GROUP BY cd."symbol", FLOOR(p."publication_date"/10000)
), ema AS (
  SELECT 
    y.*,
    SUM(y."filings" * POWER(0.9, ROW_NUMBER() OVER (PARTITION BY y."cpc_level4" ORDER BY y."year" DESC) - 1)) 
      OVER (PARTITION BY y."cpc_level4" ORDER BY y."year") * 0.1 
      AS "ema_alpha_point1"
  FROM yearly y
)
SELECT *
FROM (
  SELECT 
    e.*,
    ROW_NUMBER() OVER (PARTITION BY e."cpc_level4" ORDER BY e."ema_alpha_point1" DESC) AS rn
  FROM ema e
) q
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: 10) Final answer sketch: full CPC title, group symbol and best‑year (highest EMA).
WITH yearly AS (
  SELECT 
    cd."symbol"                           AS "cpc_level4",
    cd."titleFull"                        AS "cpc_title",
    FLOOR(p."publication_date"/10000)     AS "year",
    COUNT(DISTINCT p."publication_number") AS "filings"
  FROM PATENTS.PATENTS.PUBLICATIONS p
  JOIN LATERAL FLATTEN(input => p."cpc") f ON TRUE
  JOIN PATENTS.PATENTS.CPC_DEFINITION cd  ON cd."symbol" = f.value:"symbol"::STRING
  WHERE p."country_code" = 'DE'
    AND p."grant_date" BETWEEN 20161201 AND 20161231
    AND cd."level" = 4.0
  GROUP BY cd."symbol", cd."titleFull", FLOOR(p."publication_date"/10000)
), ema AS (
  SELECT 
    y.*,
    SUM(y."filings" * POWER(0.9, ROW_NUMBER() OVER (PARTITION BY y."cpc_level4" ORDER BY y."year" DESC) - 1)) 
      OVER (PARTITION BY y."cpc_level4" ORDER BY y."year") * 0.1 
      AS "ema_alpha_point1"
  FROM yearly y
), best AS (
  SELECT 
    e.*,
    ROW_NUMBER() OVER (PARTITION BY e."cpc_level4" ORDER BY e."ema_alpha_point1" DESC) AS rn
  FROM ema e
)
SELECT 
  "cpc_title",
  "cpc_level4",
  "year"     AS "best_year",
  "ema_alpha_point1"
FROM best
WHERE rn = 1
LIMIT 20;
```

