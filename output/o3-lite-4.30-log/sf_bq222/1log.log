```sql
--Description: 7) Count German patent filings per calendar year and CPC level‑4 group
--             for patents whose grant date fell in December 2016.  Uses CROSS‑JOIN‑LATERAL
--             FLATTEN (comma syntax) and matches the first 3 characters of each CPC code
--             to the level‑4 symbol in CPC_DEFINITION.
SELECT
    cd."symbol"                              AS "cpc_level4",
    FLOOR(p."publication_date" / 10000)      AS "year",
    COUNT(DISTINCT p."publication_number")   AS "filings"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f,
     PATENTS.PATENTS.CPC_DEFINITION cd
WHERE p."country_code" = 'DE'
  AND p."grant_date"  BETWEEN 20161201 AND 20161231
  AND cd."level"      = 4.0
  AND cd."symbol"     = SUBSTR(f.value:"code"::STRING, 1, 3)
GROUP BY cd."symbol", FLOOR(p."publication_date" / 10000)
ORDER BY cd."symbol", "year"
LIMIT 20;
```

```sql
--Description: 8) Compute an exponential moving average (α = 0.1) of annual filings
--             for each CPC level‑4 group, based on German patents granted in Dec 2016.
WITH yearly AS (
  SELECT
      cd."symbol"                            AS "cpc_level4",
      FLOOR(p."publication_date" / 10000)    AS "year",
      COUNT(DISTINCT p."publication_number") AS "filings"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc") f,
       PATENTS.PATENTS.CPC_DEFINITION cd
  WHERE p."country_code" = 'DE'
    AND p."grant_date"  BETWEEN 20161201 AND 20161231
    AND cd."level"      = 4.0
    AND cd."symbol"     = SUBSTR(f.value:"code"::STRING, 1, 3)
  GROUP BY cd."symbol", FLOOR(p."publication_date" / 10000)
)
SELECT
    y."cpc_level4",
    y."year",
    y."filings",
    /* Exponential moving average:  EMA_t = 0.1·x_t + 0.9·EMA_{t‑1}               */
    /* Implemented by a reverse‑ordered weighted sum inside a running window.     */
    SUM( y."filings"
         * POWER(0.9,
                 ROW_NUMBER() OVER (PARTITION BY y."cpc_level4"
                                    ORDER BY y."year" DESC) - 1)
       ) OVER (PARTITION BY y."cpc_level4"
               ORDER BY y."year") * 0.1        AS "ema_alpha_point1"
FROM yearly y
ORDER BY y."cpc_level4", y."year"
LIMIT 20;
```

```sql
--Description: 9) For every CPC level‑4 group, find the calendar year having the
--             maximum EMA value (α = 0.1) among German patents granted in Dec 2016.
WITH yearly AS (
  SELECT
      cd."symbol"                            AS "cpc_level4",
      FLOOR(p."publication_date" / 10000)    AS "year",
      COUNT(DISTINCT p."publication_number") AS "filings"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc") f,
       PATENTS.PATENTS.CPC_DEFINITION cd
  WHERE p."country_code" = 'DE'
    AND p."grant_date"  BETWEEN 20161201 AND 20161231
    AND cd."level"      = 4.0
    AND cd."symbol"     = SUBSTR(f.value:"code"::STRING, 1, 3)
  GROUP BY cd."symbol", FLOOR(p."publication_date" / 10000)
), ema AS (
  SELECT
      y.*,
      SUM( y."filings"
           * POWER(0.9,
                   ROW_NUMBER() OVER (PARTITION BY y."cpc_level4"
                                      ORDER BY y."year" DESC) - 1)
         ) OVER (PARTITION BY y."cpc_level4"
                 ORDER BY y."year") * 0.1     AS "ema_alpha_point1"
  FROM yearly y
), ranked AS (
  SELECT
      e.*,
      ROW_NUMBER() OVER (PARTITION BY e."cpc_level4"
                         ORDER BY e."ema_alpha_point1" DESC) AS rn
  FROM ema e
)
SELECT
    "cpc_level4",
    "year"                AS "best_year",
    "ema_alpha_point1"
FROM ranked
WHERE rn = 1
LIMIT 20;
```

