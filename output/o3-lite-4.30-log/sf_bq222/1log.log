--Description: Identify every unique CPC hierarchy‑level‑4 technology group that appears
--             on patents granted in Germany during December 2016.  
--             • PUBLICATIONS is filtered to rows where "country_code" = 'DE' and
--               "grant_date" between 20161201‑20161231.  
--             • The column "cpc" is a JSON array; CROSS‑JOIN LATERAL FLATTEN explodes it.  
--             • Each flattened object contains the field "code" (the CPC symbol);
--               we cast it to STRING.  
--             • Join to CPC_DEFINITION to get the full CPC title and ensure the
--               definition row represents a level‑4 group (cd."level" = 4.0).  
--             • DISTINCT eliminates duplicates; LIMIT 20 just samples results.
SELECT DISTINCT
       cd."symbol"    AS "cpc_level4",
       cd."titleFull" AS "cpc_title"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f
JOIN PATENTS.PATENTS.CPC_DEFINITION cd
     ON cd."symbol" = f.value:"code"::STRING
WHERE p."country_code" = 'DE'
  AND p."grant_date" BETWEEN 20161201 AND 20161231
  AND cd."level" = 4.0
LIMIT 20;
```
