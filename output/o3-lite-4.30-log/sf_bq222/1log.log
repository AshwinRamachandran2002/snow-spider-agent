```sql
--Description: Calculate the exponential moving average (EMA, α = 0.1) of yearly
--             patent‑filing counts for every CPC level‑4 group that appears on
--             German patents granted in December 2016.  Snowflake prohibits
--             nesting window functions, so we:
--               1. Build YEARLY counts by exploding the CPC array, mapping each
--                  detailed code (e.g. “F04D19/005”) to its 3‑character class
--                  symbol (e.g. “F04”), and keeping only CPC_DEFINITION rows at
--                  hierarchy level 4.  
--               2. Add a descending row number (rn_desc) per CPC group
--                  (newest year = 1) in a second CTE.  
--               3. Compute EMA in the final SELECT using a running SUM of
--                  filings × 0.9^(rn_desc‑1) and multiply by 0.1.
WITH yearly AS (   -- step 1: yearly filing counts
    SELECT
        cd."symbol"                             AS "cpc_level4",
        FLOOR(p."publication_date" / 10000)     AS "year",
        COUNT(DISTINCT p."publication_number")  AS "filings"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f,
         PATENTS.PATENTS.CPC_DEFINITION cd
    WHERE p."country_code" = 'DE'
      AND p."grant_date" BETWEEN 20161201 AND 20161231   -- December 2016 grants
      AND cd."level"  = 4.0                              -- keep level‑4 groups
      AND cd."symbol" = SUBSTR(f.value:"code"::STRING, 1, 3)
    GROUP BY cd."symbol", FLOOR(p."publication_date" / 10000)
), ranked AS (   -- step 2: add row number (newest year = 1) per group
    SELECT
        y.*,
        ROW_NUMBER() OVER (PARTITION BY y."cpc_level4"
                           ORDER BY y."year" DESC) AS rn_desc
    FROM yearly y
)
SELECT
    r."cpc_level4",
    r."year",
    r."filings",
    /* EMA_t = 0.1·x_t + 0.9·EMA_{t‑1}; implemented via weighted running sum */
    SUM( r."filings" * POWER(0.9, r.rn_desc - 1) )
        OVER (PARTITION BY r."cpc_level4"
              ORDER BY r."year" DESC) * 0.1   AS "ema_alpha_point1"
FROM ranked r
ORDER BY r."cpc_level4", r."year"
LIMIT 20;
```
