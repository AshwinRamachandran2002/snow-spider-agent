```sql
/*-----------------------------------------------------------------------
  Highest‑EMA year (α = 0.1) for every level‑4 CPC technology area that
  appears on German patents granted in December‑2016
------------------------------------------------------------------------*/
WITH dec_2016_grants AS (          /* 1. German patents granted in Dec‑2016 */
    SELECT
        FLOOR("filing_date" / 10000)::INT      AS filing_year,   -- YYYY
        "cpc"
    FROM   PATENTS.PATENTS.PUBLICATIONS
    WHERE  "country_code" = 'DE'
      AND  "grant_date"  BETWEEN 20161201 AND 20161231
      AND  "filing_date" IS NOT NULL
),

cpc_per_patent AS (                /* 2. explode CPC codes, keep 3‑char root */
    SELECT
        d.filing_year                               AS year,
        SUBSTR(f.value:"code"::STRING,1,3)          AS cpc_group
    FROM dec_2016_grants d,
         LATERAL FLATTEN(INPUT => d.cpc) f
    WHERE f.value:"code" IS NOT NULL
),

yearly_counts AS (                 /* 3. yearly filing counts per CPC root   */
    SELECT
        year,
        cpc_group,
        COUNT(*)                         AS filings
    FROM   cpc_per_patent
    GROUP  BY year, cpc_group
),

ranked AS (                        /* 4. row numbers within each CPC group   */
    SELECT
        year,
        cpc_group,
        filings,
        ROW_NUMBER() OVER (PARTITION BY cpc_group ORDER BY year) AS rn
    FROM yearly_counts
),

/*-----------------------------------------------------------------------
  5. Recursive computation of EMA
     EMA₁ = filings₁
     EMAₙ = 0.1 · filingsₙ + 0.9 · EMAₙ₋₁
------------------------------------------------------------------------*/
RECURSIVE ema_rec (cpc_group, year, rn, filings, ema) AS (
      /* anchor – first year of each CPC group */
      SELECT
          r.cpc_group,
          r.year,
          r.rn,
          r.filings,
          CAST(r.filings AS DOUBLE) AS ema          -- EMA₁  = filings₁
      FROM ranked r
      WHERE r.rn = 1

      UNION ALL

      /* recursive – subsequent years */
      SELECT
          n.cpc_group,
          n.year,
          n.rn,
          n.filings,
          0.1 * n.filings + 0.9 * p.ema             -- EMA formula
      FROM ema_rec p
      JOIN ranked  n
        ON n.cpc_group = p.cpc_group
       AND n.rn       = p.rn + 1
),

best_year AS (                      /* 6. pick the year with max EMA per CPC */
    SELECT
        cpc_group,
        year  AS year_with_max_exponential_moving_average,
        ema,
        ROW_NUMBER() OVER (PARTITION BY cpc_group
                           ORDER BY ema DESC, year) AS rn
    FROM ema_rec
)

SELECT
    cd.titleFull                                   AS cpc_title,
    b.cpc_group,
    b.year_with_max_exponential_moving_average
FROM   best_year b
JOIN   PATENTS.PATENTS.CPC_DEFINITION cd
       ON cd.symbol = b.cpc_group
WHERE  cd.level = 4          -- level‑4 CPC areas
  AND  b.rn   = 1            -- best year per CPC group
ORDER BY b.ema DESC NULLS LAST, b.cpc_group;
```
