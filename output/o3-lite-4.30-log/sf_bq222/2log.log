```sql
--Description:
-- We previously received zero rows because we attempted to join the full CPC code
-- (e.g., “B64G1/283”) to CPC_DEFINITION, whose level‑4 records contain only the
-- three‑character class root (e.g., “B64”).  To confirm the data exist and retrieve
-- matching titles, the strategy is:
--   1. Explode the JSON array in PUBLICATIONS."cpc" via LATERAL FLATTEN.
--   2. Trim each CPC symbol to its first three characters (class root).
--   3. Keep distinct roots that occur in German patents granted during December 2016.
--   4. Join those roots to CPC_DEFINITION where level = 4 to obtain the official title.
-- The query returns up to 20 class‑level CPC groups actually present in the target
-- patent set, together with their human‑readable titles.

WITH dec16_de_cpc AS (
    SELECT DISTINCT
           SUBSTR(f.value:"code"::STRING, 1, 3) AS "cpc_root"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND p."grant_date" BETWEEN 20161201 AND 20161231
)
SELECT c."cpc_root"                 AS "cpc_group",
       d."titleFull"                AS "cpc_title"
FROM   dec16_de_cpc c
LEFT   JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = c."cpc_root"
      AND d."level"  = 4
LIMIT 20;
```
