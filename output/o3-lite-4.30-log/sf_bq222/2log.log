Below are ten exploratory Snowflake SQL queries (LIMIT 20 rows each).  
All column names are wrapped in double quotes; queries grow from simple inspection to a possible final answer skeleton.

```sql
-- 1) Description: Distinct country codes available in PUBLICATIONS.
SELECT DISTINCT "country_code"
FROM PATENTS.PATENTS.PUBLICATIONS
LIMIT 20;
```

```sql
-- 2) Description: Sample German patents granted in December‑2016.
SELECT "publication_number",
       "grant_date",
       "publication_date",
       "country_code"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'DE'
  AND "grant_date" BETWEEN 20161201 AND 20161231
LIMIT 20;
```

```sql
-- 3) Description: Check the distribution of grant dates for German patents in 2016.
SELECT DISTINCT "grant_date"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'DE'
  AND "grant_date" BETWEEN 20160101 AND 20161231
ORDER BY "grant_date"
LIMIT 20;
```

```sql
-- 4) Description: Inspect raw CPC variant structure for one German patent (flatten once).
SELECT p."publication_number",
       f.value AS "cpc_raw"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(INPUT => p."cpc") f
WHERE p."country_code" = 'DE'
  AND p."grant_date" BETWEEN 20161201 AND 20161231
LIMIT 20;
```

```sql
-- 5) Description: Extract possible CPC symbol/code fields from the variant (try 'code').
SELECT f.value:"code"::STRING AS "cpc_code",
       COUNT(*) AS "cnt"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(INPUT => p."cpc") f
WHERE p."country_code" = 'DE'
  AND p."grant_date" BETWEEN 20161201 AND 20161231
GROUP BY f.value:"code"::STRING
ORDER BY "cnt" DESC
LIMIT 20;
```

```sql
-- 6) Description: Distinct level‑4 CPC symbols and their titles.
SELECT cd."symbol",
       cd."titleFull"
FROM PATENTS.PATENTS.CPC_DEFINITION cd
WHERE cd."level" = 4
LIMIT 20;
```

```sql
-- 7) Description: Join December‑2016 German patents with level‑4 CPC titles (one‑to‑many because of multiple CPC codes per patent).
SELECT DISTINCT cd."symbol"       AS "cpc_group",
       cd."titleFull"             AS "cpc_title",
       p."publication_number"
FROM   PATENTS.PATENTS.PUBLICATIONS   p,
       LATERAL FLATTEN(INPUT => p."cpc") f
JOIN   PATENTS.PATENTS.CPC_DEFINITION cd
      ON cd."symbol" = f.value:"code"::STRING
WHERE  cd."level" = 4
  AND  p."country_code" = 'DE'
  AND  p."grant_date" BETWEEN 20161201 AND 20161231
LIMIT 20;
```

```sql
-- 8) Description: Counts of German patent filings per year & CPC group (level‑4).
WITH cte AS (
  SELECT TO_NUMBER(LEFT(p."publication_date",4)) AS "year",
         f.value:"code"::STRING                  AS "cpc_group"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(INPUT => p."cpc") f
  WHERE p."country_code" = 'DE'
)
SELECT "year",
       "cpc_group",
       COUNT(*) AS "filings"
FROM cte
GROUP BY "year","cpc_group"
ORDER BY "filings" DESC
LIMIT 20;
```

```sql
-- 9) Description: Calculate exponential moving average (α=0.1) of yearly filings per CPC group.
-- Snowflake supports EMA(...) as a window function (assumed here).
WITH yearly AS (
  SELECT TO_NUMBER(LEFT(p."publication_date",4)) AS "year",
         f.value:"code"::STRING                  AS "cpc_group",
         COUNT(*)                                AS "filings"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(INPUT => p."cpc") f
  WHERE p."country_code" = 'DE'
  GROUP BY "year","cpc_group"
)
SELECT "year",
       "cpc_group",
       "filings",
       EMA("filings", 0.1) OVER (PARTITION BY "cpc_group" ORDER BY "year"
                                 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "ema_0_1"
FROM yearly
ORDER BY "cpc_group", "year"
LIMIT 20;
```

```sql
-- 10) Description: For each level‑4 CPC group, return the year with the highest EMA and the corresponding CPC title.
WITH yearly AS (
  SELECT TO_NUMBER(LEFT(p."publication_date",4)) AS "year",
         f.value:"code"::STRING                  AS "cpc_group",
         COUNT(*)                                AS "filings"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(INPUT => p."cpc") f
  WHERE p."country_code" = 'DE'
  GROUP BY "year","cpc_group"
),
ema_calc AS (
  SELECT "year",
         "cpc_group",
         EMA("filings", 0.1) OVER (PARTITION BY "cpc_group" ORDER BY "year"
                                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "ema_0_1"
  FROM yearly
),
ranked AS (
  SELECT e.*,
         ROW_NUMBER() OVER (PARTITION BY e."cpc_group" ORDER BY e."ema_0_1" DESC) AS rn
  FROM ema_calc e
)
SELECT cd."titleFull"        AS "cpc_title_full",
       r."cpc_group",
       r."year"              AS "best_year",
       r."ema_0_1"           AS "max_ema"
FROM   ranked r
JOIN   PATENTS.PATENTS.CPC_DEFINITION cd
       ON cd."symbol" = r."cpc_group"
WHERE  cd."level" = 4
  AND  r.rn = 1
ORDER BY r."max_ema" DESC
LIMIT 20;
```

