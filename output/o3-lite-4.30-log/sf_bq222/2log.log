```sql
--Description:
-- Purpose: Identify every CPC class (level‑4, i.e. 3‑character root) that appears in
-- German patents granted during December 2016 and, for each such class, return
-- (a) its official CPC title, (b) the class root, and (c) the calendar year in which
-- that class achieves its highest exponential moving average (EMA, α = 0.1) of
-- German patent filings.  The EMA is calculated cumulatively per class across all
-- filing years (Snowflake’s EMA function must be used without an explicit frame).
--
-- Steps
-- 1.  dec16_groups  – list distinct CPC class roots found in DE‑country patents
--     whose grant_date falls in December 2016.
-- 2.  yearly_counts – aggregate counts of DE patent publications by calendar year
--     and CPC class root for the entire database.
-- 3.  ema_calc      – compute EMA(0.1) of yearly counts per class root.  Because
--     no WINDOW frame is specified, Snowflake applies a cumulative frame that
--     starts with the first row of each partition.
-- 4.  best_years    – rank years by EMA within each class and keep the top‑ranked
--     (highest EMA) year.
-- 5.  Join the set of classes present in December 2016 (dec16_groups) with the
--     best‑year EMA results and CPC_DEFINITION to obtain human‑readable titles.
WITH dec16_groups AS (
    SELECT DISTINCT
           SUBSTR(f.value:"code"::STRING, 1, 3) AS cpc_root
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND p."grant_date"   BETWEEN 20161201 AND 20161231
),
yearly_counts AS (
    SELECT
           TO_NUMBER(LEFT(p."publication_date", 4)) AS year,
           SUBSTR(f.value:"code"::STRING, 1, 3)     AS cpc_root,
           COUNT(*)                                 AS filings
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE p."country_code" = 'DE'
    GROUP BY year, cpc_root
),
ema_calc AS (
    SELECT
           year,
           cpc_root,
           EMA(filings, 0.1)
             OVER (PARTITION BY cpc_root
                   ORDER BY      year)              AS ema_0_1
    FROM yearly_counts
),
best_years AS (
    SELECT
           cpc_root,
           year          AS best_year,
           ema_0_1       AS max_ema,
           ROW_NUMBER() OVER (PARTITION BY cpc_root
                              ORDER BY ema_0_1 DESC) AS rn
    FROM ema_calc
)
SELECT
       d."titleFull"          AS cpc_title,
       b.cpc_root             AS cpc_group,
       b.best_year,
       b.max_ema
FROM best_years b
JOIN dec16_groups g
     ON g.cpc_root = b.cpc_root
JOIN PATENTS.PATENTS.CPC_DEFINITION d
     ON d."symbol" = b.cpc_root
    AND d."level"  = 4
WHERE b.rn = 1
ORDER BY b.max_ema DESC
LIMIT 20;
```
