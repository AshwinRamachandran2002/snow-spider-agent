```sql
--Description: Count German patent publications per year by CPC class (level‑4 = 3‑character root).
WITH cte AS (
    SELECT 
           TO_NUMBER(LEFT(p."publication_date", 4))               AS "year",
           SUBSTR(f.value:"code"::STRING, 1, 3)                   AS "cpc_group"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE  p."country_code" = 'DE'
)
SELECT   "year",
         "cpc_group",
         COUNT(*) AS "filings"
FROM     cte
GROUP BY "year", "cpc_group"
ORDER BY "filings" DESC
LIMIT 20;
```

```sql
--Description: Compute the exponential moving average (α = 0.1) of yearly filings for each CPC class (3‑char root).
WITH yearly AS (
    SELECT 
           TO_NUMBER(LEFT(p."publication_date", 4))               AS "year",
           SUBSTR(f.value:"code"::STRING, 1, 3)                   AS "cpc_group",
           COUNT(*)                                               AS "filings"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE  p."country_code" = 'DE'
    GROUP BY "year", "cpc_group"
)
SELECT 
       "year",
       "cpc_group",
       "filings",
       EMA("filings", 0.1) 
         OVER (PARTITION BY "cpc_group" ORDER BY "year"
               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "ema_0_1"
FROM   yearly
ORDER BY "cpc_group", "year"
LIMIT 20;
```

```sql
--Description: For every CPC class (3‑char root), return the year with the highest EMA(0.1) of filings plus the class title.
WITH yearly AS (
    SELECT 
           TO_NUMBER(LEFT(p."publication_date", 4))               AS "year",
           SUBSTR(f.value:"code"::STRING, 1, 3)                   AS "cpc_group",
           COUNT(*)                                               AS "filings"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE  p."country_code" = 'DE'
    GROUP BY "year", "cpc_group"
),
ema_calc AS (
    SELECT 
           "year",
           "cpc_group",
           EMA("filings", 0.1) 
             OVER (PARTITION BY "cpc_group" ORDER BY "year"
                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "ema_0_1"
    FROM   yearly
),
ranked AS (
    SELECT 
           e.*,
           ROW_NUMBER() OVER (PARTITION BY e."cpc_group" ORDER BY e."ema_0_1" DESC) AS rn
    FROM   ema_calc e
)
SELECT 
       cd."titleFull"  AS "cpc_title_full",
       r."cpc_group",
       r."year"        AS "best_year",
       r."ema_0_1"     AS "max_ema"
FROM   ranked r
JOIN   PATENTS.PATENTS.CPC_DEFINITION cd
       ON cd."symbol" = r."cpc_group"
      AND cd."level"  = 4
WHERE  r.rn = 1
ORDER BY r."max_ema" DESC
LIMIT 20;
