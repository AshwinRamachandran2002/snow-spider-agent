```sql
--Description:
-- Return, for every CPC class (3‑character root), the year in which its exponential
-- moving average (EMA, α = 0.1) of German patent filings is highest, together with
-- the CPC class title.  
-- Technical notes
-- 1.  PUBLICATIONS."cpc" contains full symbols (e.g., “B64G1/283”).  Level‑4 titles in
--    CPC_DEFINITION are stored under the class root (e.g., “B64”), so we truncate each
--    symbol to its first three characters before grouping / joining.  
-- 2.  Snowflake’s EMA analytic function cannot accept the frame
--    “ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW”; therefore we use a large
--    finite window (200 PRECEDING) that safely covers the number of distinct years.  
-- 3.  We aggregate patent counts by (year, class root), calculate EMA per class,
--    rank the years by EMA within each class, and finally pick the top‑ranked year.  

WITH yearly AS (
    SELECT
        TO_NUMBER(LEFT(p."publication_date", 4))      AS "year",
        SUBSTR(f.value:"code"::STRING, 1, 3)          AS "cpc_group",
        COUNT(*)                                      AS "filings"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE p."country_code" = 'DE'
    GROUP BY "year", "cpc_group"
),
ema_calc AS (
    SELECT
        "year",
        "cpc_group",
        EMA("filings", 0.1)
          OVER (
            PARTITION BY "cpc_group"
            ORDER BY "year"
            ROWS BETWEEN 200 PRECEDING AND CURRENT ROW
          ) AS "ema_0_1"
    FROM yearly
),
ranked AS (
    SELECT
        e.*,
        ROW_NUMBER() OVER (PARTITION BY e."cpc_group" ORDER BY e."ema_0_1" DESC) AS rn
    FROM ema_calc e
)
SELECT
    cd."titleFull"   AS "cpc_title_full",
    r."cpc_group",
    r."year"         AS "best_year",
    r."ema_0_1"      AS "max_ema"
FROM ranked r
JOIN PATENTS.PATENTS.CPC_DEFINITION cd
     ON cd."symbol" = r."cpc_group"
    AND cd."level"  = 4
WHERE r.rn = 1
ORDER BY r."max_ema" DESC
LIMIT 20;
```
