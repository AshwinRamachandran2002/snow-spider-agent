```sql
--Description:
-- Objective:  For every CPC class root (3‑character level‑4 code) that appears in
--             German patents granted during December 2016, determine the calendar
--             year in which its exponential moving average (EMA, α = 0.1) of annual
--             German patent‑filing counts is highest.  Return that year, the CPC
--             class code, its full title, and the peak EMA value.
--
-- Why a recursive CTE?  Snowflake lacks a built‑in EMA window function, so we
-- compute the EMA manually:
--        ema₁ = filings₁
--        emaₜ = 0.1 * filingsₜ + 0.9 * emaₜ₋₁
--
-- Query outline
--   1) dec16_classes   – extract distinct CPC class roots found in DE patents
--      granted in Dec‑2016 (grant_date 20161201‑20161231).
--   2) yearly_counts   – count DE publications by (year, class root) for all years.
--   3) ordered         – give each (class, year) row a sequential number.
--   4) rec             – recursively compute the EMA per class.
--   5) best_years      – within each class, pick the year with the highest EMA.
--   6) final SELECT    – join to CPC_DEFINITION for titles; output top 20 classes
--      sorted by their maximum EMA.
WITH dec16_classes AS (       -- 1) classes present in Dec‑2016 grants
    SELECT DISTINCT
           SUBSTR(f.value:"code"::STRING, 1, 3) AS cpc_root
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND p."grant_date"   BETWEEN 20161201 AND 20161231
),
yearly_counts AS (            -- 2) yearly DE filings per class root
    SELECT
           TO_NUMBER(LEFT(p."publication_date", 4)) AS year,
           SUBSTR(f.value:"code"::STRING, 1, 3)     AS cpc_root,
           COUNT(*)                                 AS filings
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE p."country_code" = 'DE'
    GROUP BY year, cpc_root
),
ordered AS (                  -- 3) chronological row numbers per class
    SELECT
           cpc_root,
           year,
           filings,
           ROW_NUMBER() OVER (PARTITION BY cpc_root ORDER BY year) AS rn
    FROM yearly_counts
),
RECURSIVE rec AS (            -- 4) recursive EMA calculation
    -- seed: first year for each CPC class
    SELECT
           cpc_root,
           year,
           filings,
           rn,
           filings::FLOAT AS ema
    FROM ordered
    WHERE rn = 1
    UNION ALL
    -- recursion: subsequent years
    SELECT
           o.cpc_root,
           o.year,
           o.filings,
           o.rn,
           0.1 * o.filings + 0.9 * r.ema AS ema
    FROM ordered o
    JOIN rec     r
      ON o.cpc_root = r.cpc_root
     AND o.rn       = r.rn + 1
),
best_years AS (               -- 5) pick peak EMA year for each class
    SELECT
           cpc_root,
           year        AS best_year,
           ema         AS max_ema,
           ROW_NUMBER() OVER (PARTITION BY cpc_root ORDER BY ema DESC) AS rn
    FROM rec
)
SELECT                         -- 6) final result with CPC titles
       cd."titleFull"  AS cpc_title,
       b.cpc_root      AS cpc_group,
       b.best_year,
       b.max_ema
FROM best_years b
JOIN dec16_classes d16   ON d16.cpc_root = b.cpc_root
JOIN PATENTS.PATENTS.CPC_DEFINITION cd
     ON cd."symbol" = b.cpc_root
    AND cd."level"  = 4
WHERE b.rn = 1
ORDER BY b.max_ema DESC
LIMIT 20;
```
