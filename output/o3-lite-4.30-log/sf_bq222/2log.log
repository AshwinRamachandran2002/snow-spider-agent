WITH dec_2016_grants AS (               -- 1. German patents granted in December‑2016
    SELECT
        TO_NUMBER(LEFT("filing_date",4))        AS "filing_year",
        "cpc"
    FROM   PATENTS.PATENTS.PUBLICATIONS
    WHERE  "country_code" = 'DE'
      AND  "grant_date"  BETWEEN 20161201 AND 20161231
      AND  "filing_date" IS NOT NULL
),

cpc_per_patent AS (                      -- 2. Explode CPC codes and reduce to level‑4 symbol (first 3 chars)
    SELECT
        d."filing_year"                  AS "year",
        SUBSTR(f.value:"code"::STRING,1,3) AS "cpc_group"
    FROM dec_2016_grants d,
         LATERAL FLATTEN(INPUT => d."cpc") f
    WHERE f.value:"code" IS NOT NULL
),

yearly_counts AS (                       -- 3. Annual filing counts per CPC group
    SELECT
        "year",
        "cpc_group",
        COUNT(*)                         AS "filings"
    FROM   cpc_per_patent
    GROUP  BY "year","cpc_group"
),

ema_calc AS (                            -- 4. Exponential Moving Average  (α = 0.1)
    SELECT
        "year",
        "cpc_group",
        EMA("filings",0.1) OVER (PARTITION BY "cpc_group"
                                 ORDER BY "year"
                                 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "ema"
