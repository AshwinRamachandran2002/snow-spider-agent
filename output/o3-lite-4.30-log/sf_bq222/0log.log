Query:
--Description: Show cumulative average filings per CPC group (first step toward smoothing)
SELECT
    t."cpc_group_level4",
    t."filing_year",
    t."filings",
    AVG(t."filings") OVER (PARTITION BY t."cpc_group_level4"
                           ORDER BY t."filing_year"
                           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "cumulative_avg"
FROM (
    SELECT
        LEFT(f.value:"symbol"::STRING, 4) AS "cpc_group_level4",
        FLOOR(p."filing_date" / 10000)    AS "filing_year",
        COUNT(*)                          AS "filings"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND p."grant_date" BETWEEN 20161201 AND 20161231
    GROUP BY
        LEFT(f.value:"symbol"::STRING, 4),
        FLOOR(p."filing_date" / 10000)
) t
ORDER BY t."cpc_group_level4", t."filing_year"
LIMIT 20;
