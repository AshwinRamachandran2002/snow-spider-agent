```sql
--Description:
-- We discovered that the CPC JSON objects store the key "code", not "symbol", so the previous
-- joins returned NULL.  To verify the data pipeline step‑by‑step, the query below:
--   • Flattens the "cpc" array, extracts f.value:"code" and truncates it to four characters
--     to obtain the level‑4 CPC group (e.g. “F16C”).
--   • Filters to German patents (country_code = 'DE') granted in December 2016.
--   • Simply counts how many times each level‑4 CPC group appears in this subset.
--   • ORDER BY count DESC so we can quickly validate that we now receive non‑empty CPC groups.
-- This “sanity‑check” query is a simpler prerequisite before re‑running the full EMA logic.
SELECT
    LEFT(f.value:"code"::STRING, 4)          AS "cpc_group_level4",
    COUNT(*)                                 AS "patent_count"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f
WHERE p."country_code" = 'DE'
  AND p."grant_date" BETWEEN 20161201 AND 20161231
  AND f.value:"code" IS NOT NULL
GROUP BY
    LEFT(f.value:"code"::STRING, 4)
ORDER BY
    "patent_count" DESC
LIMIT 20;
```
