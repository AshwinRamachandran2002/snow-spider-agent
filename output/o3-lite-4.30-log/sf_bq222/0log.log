/*  ---------------------------------------------------------------
    CPC level‑4 groups in German patents granted in Dec‑2016 whose
    annual filing counts (by filing_date year) reach the maximum
    exponential moving average (α = 0.1).  
    Returns one row per CPC group: title, group code, best year.
    --------------------------------------------------------------- */
WITH filings AS (          /* annual patent counts per CPC‑L4 group */
    SELECT
        LEFT(f.value:"code"::STRING, 4)      AS cpc_group,
        FLOOR(p."filing_date" / 10000)       AS filing_year,
        COUNT(*)                             AS filings
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND p."grant_date" BETWEEN 20161201 AND 20161231   -- granted in Dec‑2016
      AND f.value:"code" IS NOT NULL
    GROUP BY
        LEFT(f.value:"code"::STRING, 4),
        FLOOR(p."filing_date" / 10000)
),
seq AS (               /* chronological index for each CPC group   */
    SELECT
        f.*,
        ROW_NUMBER() OVER (PARTITION BY f.cpc_group
                           ORDER BY f.filing_year) AS rn
    FROM filings f
),
ema AS (               /* exponential moving average, α = 0.1      */
    SELECT
        s1.cpc_group,
        s1.filing_year,
        SUM(s2.filings * POWER(0.9, s1.rn - s2.rn)) * 0.1 AS ema_val
    FROM seq s1
    JOIN seq s2
      ON s1.cpc_group = s2.cpc_group
     AND s2.rn <= s1.rn
    GROUP BY
        s1.cpc_group,
        s1.filing_year,
        s1.rn
),
best_year AS (         /* select the year with the highest EMA      */
    SELECT
        e.cpc_group,
        e.filing_year,
        e.ema_val,
        ROW_NUMBER() OVER (PARTITION BY e.cpc_group
                           ORDER BY e.ema_val DESC, e.filing_year) AS rnk
    FROM ema e
)
SELECT
