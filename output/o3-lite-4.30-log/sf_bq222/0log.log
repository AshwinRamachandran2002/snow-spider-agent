```sql
--Description:
-- Compute, for every CPC level‑4 technology area appearing in German patents granted
-- during December 2016, the filing‑year in which that group reaches its highest
-- exponential moving average (EMA, α = 0.1) of annual filings.  Then attach the
-- full CPC title and list the top‑20 groups by their peak EMA.
-- Key implementation notes
--  • Flatten PUBLICATIONS."cpc" and read f.value:"code" (the CPC symbol), take its
--    first 4 characters to obtain the level‑4 group (e.g., “H03H”).
--  • Aggregate filings per (group, year) and use row numbers to calculate the EMA.
--  • Pick the year with the maximum EMA for each group.
--  • Join to CPC_DEFINITION for the human‑readable title.
--  • ORDER BY the peak EMA (b.ema_0_1) descending; LIMIT 20 for brevity.
WITH filings AS (
    SELECT
        LEFT(f.value:"code"::STRING, 4)        AS "cpc_group_level4",
        FLOOR(p."filing_date" / 10000)         AS "filing_year",
        COUNT(*)                               AS "filings"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND p."grant_date" BETWEEN 20161201 AND 20161231
      AND f.value:"code" IS NOT NULL
    GROUP BY
        LEFT(f.value:"code"::STRING, 4),
        FLOOR(p."filing_date" / 10000)
),
seq AS (
    SELECT
        f.*,
        ROW_NUMBER() OVER (PARTITION BY f."cpc_group_level4"
                           ORDER BY f."filing_year") AS rn
    FROM filings f
),
ema AS (
    SELECT
        s1."cpc_group_level4",
        s1."filing_year",
        SUM(s2."filings" * POWER(0.9, s1.rn - s2.rn)) * 0.1 AS ema_0_1
    FROM seq s1
    JOIN seq s2
      ON s1."cpc_group_level4" = s2."cpc_group_level4"
     AND s2.rn <= s1.rn
    GROUP BY
        s1."cpc_group_level4",
        s1."filing_year",
        s1.rn
),
best_year AS (
    SELECT
        e.*,
        ROW_NUMBER() OVER (PARTITION BY e."cpc_group_level4"
                           ORDER BY e.ema_0_1 DESC) AS rank_ema
    FROM ema e
)
SELECT
    d."titleFull",
    b."cpc_group_level4",
    b."filing_year" AS "best_year",
    b.ema_0_1       AS "highest_ema"
FROM best_year b
JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON d."symbol" = b."cpc_group_level4"
WHERE d."level" = 4
  AND b.rank_ema = 1
ORDER BY
    b.ema_0_1 DESC
LIMIT 20;
