```sql
--Description:
-- Objective: for German patents granted in December 2016, find each CPC level‑4 group’s
-- filing‑year with the highest exponential moving average (EMA, α = 0.1) of annual
-- patent filings, and attach any available CPC title.  
-- Why this should return data now:
--   • Uses f.value:"code" (correct key) → derive 4‑character group.
--   • No restrictive filter on CPC_DEFINITION."level"; we LEFT JOIN so missing titles
--     won’t discard rows.  
-- Steps
-- 1. filings  – count filings per (group, year).  
-- 2. seq      – add chronological index per group.  
-- 3. ema      – compute EMA with α = 0.1.  
-- 4. best_year– keep the year with the peak EMA for each group.  
-- 5. Final SELECT lists top‑20 groups by that peak EMA, with titles when available.
WITH filings AS (
    SELECT
        LEFT(f.value:"code"::STRING, 4)       AS cpc_group,
        FLOOR(p."filing_date" / 10000)        AS filing_year,
        COUNT(*)                              AS filings
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN( INPUT => p."cpc" ) f
    WHERE p."country_code" = 'DE'
      AND p."grant_date"  BETWEEN 20161201 AND 20161231
      AND f.value:"code" IS NOT NULL
    GROUP BY
        LEFT(f.value:"code"::STRING, 4),
        FLOOR(p."filing_date" / 10000)
),
seq AS (
    SELECT
        f.*,
        ROW_NUMBER() OVER (PARTITION BY f.cpc_group
                           ORDER BY f.filing_year) AS rn
    FROM filings f
),
ema AS (
    SELECT
        s1.cpc_group,
        s1.filing_year,
        SUM( s2.filings * POWER(0.9, s1.rn - s2.rn) ) * 0.1 AS ema_0_1
    FROM seq s1
    JOIN seq s2
      ON s1.cpc_group = s2.cpc_group
     AND s2.rn <= s1.rn
    GROUP BY
        s1.cpc_group, s1.filing_year, s1.rn
),
best_year AS (
    SELECT
        e.*,
        ROW_NUMBER() OVER (PARTITION BY e.cpc_group
                           ORDER BY e.ema_0_1 DESC) AS rank_ema
    FROM ema e
)
SELECT
    COALESCE(d."titleFull", 'N/A')            AS cpc_title,
    b.cpc_group                               AS cpc_group_level4,
    b.filing_year                             AS best_year,
    b.ema_0_1                                 AS highest_ema
FROM best_year b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b.cpc_group
WHERE b.rank_ema = 1
ORDER BY
    highest_ema DESC
LIMIT 20;
```
