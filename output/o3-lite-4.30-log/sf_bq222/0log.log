Begin Exploring Related Columns
Relevant columns, their potential usage, and typical conditions
• PUBLICATIONS."country_code": filter to German patents ➜  WHERE "country_code" = 'DE'  
• PUBLICATIONS."grant_date": locate patents granted in Dec‑2016 ➜ WHERE "grant_date" BETWEEN 20161201 AND 20161231  
• PUBLICATIONS."filing_date": extract the filing year of every patent ➜  FLOOR("filing_date"/10000) AS filing_year  
• PUBLICATIONS."cpc": JSON array that lists CPC symbols for every publication; needs FLATTEN to read individual codes  
• PUBLICATIONS."publication_number": handy identifier when inspecting data  
• PUBLICATIONS."family_id": optional, if one wants one record per family  
• CPC_DEFINITION."symbol": full CPC symbol; join on level‑4 symbol (e.g., ‘A01B’)  
• CPC_DEFINITION."level": keep only level‑4 groups ➜ WHERE "level" = 4  
• CPC_DEFINITION."titleFull": the long human‑readable title of the CPC group  

Typical conditions  
– German patents: "country_code" = 'DE'  
– Granted in December‑2016: "grant_date" BETWEEN 20161201 AND 20161231  
– CPC group level‑4: LEFT(cpc_symbol,4) and CPC_DEFINITION."level" = 4  

Below are ten exploratory Snowflake SQL queries (LIMIT 20 each), progressing from simple inspection to the complete analytical query.  
Every identifier is wrapped in double quotes and comments are provided before each query.

```sql
--Description: Inspect a handful of German patents that were granted in December‑2016
SELECT 
    p."publication_number",
    p."grant_date",
    p."filing_date",
    p."country_code"
FROM PATENTS.PATENTS.PUBLICATIONS p
WHERE p."country_code" = 'DE'
  AND p."grant_date" BETWEEN 20161201 AND 20161231
LIMIT 20;
```

```sql
--Description: Look at the raw CPC JSON column for those same patents
SELECT 
    p."publication_number",
    p."cpc"
FROM PATENTS.PATENTS.PUBLICATIONS p
WHERE p."country_code" = 'DE'
  AND p."grant_date" BETWEEN 20161201 AND 20161231
LIMIT 20;
```

```sql
--Description: Flatten the CPC array to list individual CPC symbols per publication
SELECT
    p."publication_number",
    f.value:"symbol"::STRING AS "cpc_symbol"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f
WHERE p."country_code" = 'DE'
  AND p."grant_date" BETWEEN 20161201 AND 20161231
LIMIT 20;
```

```sql
--Description: Extract distinct level‑4 CPC groups (first 4 characters)
SELECT DISTINCT
    LEFT(f.value:"symbol"::STRING, 4) AS "cpc_group_level4"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f
WHERE p."country_code" = 'DE'
  AND p."grant_date" BETWEEN 20161201 AND 20161231
LIMIT 20;
```

```sql
--Description: Count patent filings per year for each level‑4 CPC group
SELECT
    LEFT(f.value:"symbol"::STRING, 4) AS "cpc_group_level4",
    FLOOR(p."filing_date" / 10000)    AS "filing_year",
    COUNT(*)                          AS "filings"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f
WHERE p."country_code" = 'DE'
  AND p."grant_date" BETWEEN 20161201 AND 20161231
GROUP BY
    LEFT(f.value:"symbol"::STRING, 4),
    FLOOR(p."filing_date" / 10000)
ORDER BY 3 DESC
LIMIT 20;
```

```sql
--Description: Show cumulative average filings per CPC group (first step toward smoothing)
SELECT
    t."cpc_group_level4",
    t."filing_year",
    t."filings",
    AVG(t."filings") OVER (PARTITION BY t."cpc_group_level4"
                           ORDER BY t."filing_year"
                           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "cumulative_avg"
FROM (
    SELECT
        LEFT(f.value:"symbol"::STRING, 4) AS "cpc_group_level4",
        FLOOR(p."filing_date" / 10000)    AS "filing_year",
        COUNT(*)                          AS "filings"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND p."grant_date" BETWEEN 20161201 AND 20161231
    GROUP BY
        LEFT(f.value:"symbol"::STRING, 4),
        FLOOR(p."filing_date" / 10000)
) t
ORDER BY t."cpc_group_level4", t."filing_year"
LIMIT 20;
```

```sql
--Description: Compute an exponential moving average (α = 0.1) for each CPC group & year
WITH filings AS (
    SELECT
        LEFT(f.value:"symbol"::STRING, 4) AS "cpc_group_level4",
        FLOOR(p."filing_date" / 10000)    AS "filing_year",
        COUNT(*)                          AS "filings"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND p."grant_date" BETWEEN 20161201 AND 20161231
    GROUP BY
        LEFT(f.value:"symbol"::STRING, 4),
        FLOOR(p."filing_date" / 10000)
),
seq AS (
    SELECT
        f.*,
        ROW_NUMBER() OVER (PARTITION BY f."cpc_group_level4" ORDER BY f."filing_year") AS "rn"
    FROM filings f
)
SELECT 
    s1."cpc_group_level4",
    s1."filing_year",
    SUM(s2."filings" * POWER(0.9, s1."rn" - s2."rn")) * 0.1 AS "ema_0_1"
FROM seq s1
JOIN seq s2
  ON s1."cpc_group_level4" = s2."cpc_group_level4"
 AND s2."rn" <= s1."rn"
GROUP BY 
    s1."cpc_group_level4",
    s1."filing_year",
    s1."rn"
ORDER BY s1."cpc_group_level4", s1."filing_year"
LIMIT 20;
```

```sql
--Description: Preview CPC definition records at level 4 (title & symbol)
SELECT
    d."symbol"   AS "cpc_group_level4",
    d."titleFull"
FROM PATENTS.PATENTS.CPC_DEFINITION d
WHERE d."level" = 4
LIMIT 20;
```

```sql
--Description: Combine EMA result with CPC titles; show the best EMA year per CPC group (top 20 groups)
WITH filings AS (
    SELECT
        LEFT(f.value:"symbol"::STRING, 4) AS "cpc_group_level4",
        FLOOR(p."filing_date" / 10000)    AS "filing_year",
        COUNT(*)                          AS "filings"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND p."grant_date" BETWEEN 20161201 AND 20161231
    GROUP BY
        LEFT(f.value:"symbol"::STRING, 4),
        FLOOR(p."filing_date" / 10000)
),
seq AS (
    SELECT
        f.*,
        ROW_NUMBER() OVER (PARTITION BY f."cpc_group_level4" ORDER BY f."filing_year") AS "rn"
    FROM filings f
),
ema AS (
    SELECT 
        s1."cpc_group_level4",
        s1."filing_year",
        SUM(s2."filings" * POWER(0.9, s1."rn" - s2."rn")) * 0.1 AS "ema_0_1"
    FROM seq s1
    JOIN seq s2
      ON s1."cpc_group_level4" = s2."cpc_group_level4"
     AND s2."rn" <= s1."rn"
    GROUP BY
        s1."cpc_group_level4",
        s1."filing_year",
        s1."rn"
),
best_year AS (
    SELECT
        e.*,
        ROW_NUMBER() OVER (PARTITION BY e."cpc_group_level4" ORDER BY e."ema_0_1" DESC) AS "rank_ema"
    FROM ema e
)
SELECT
    d."titleFull",
    b."cpc_group_level4",
    b."filing_year" AS "best_year",
    b."ema_0_1"     AS "highest_ema"
FROM best_year b
JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON d."symbol" = b."cpc_group_level4"
WHERE d."level" = 4
  AND b."rank_ema" = 1
ORDER BY b."highest_ema" DESC
LIMIT 20;
```

```sql
--Description: Same as above but returns only the single CPC group whose EMA is the overall maximum
WITH filings AS (
    SELECT
        LEFT(f.value:"symbol"::STRING, 4) AS "cpc_group_level4",
        FLOOR(p."filing_date" / 10000)    AS "filing_year",
        COUNT(*)                          AS "filings"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND p."grant_date" BETWEEN 20161201 AND 20161231
    GROUP BY
        LEFT(f.value:"symbol"::STRING, 4),
        FLOOR(p."filing_date" / 10000)
),
seq AS (
    SELECT
        f.*,
        ROW_NUMBER() OVER (PARTITION BY f."cpc_group_level4" ORDER BY f."filing_year") AS "rn"
    FROM filings f
),
ema AS (
    SELECT 
        s1."cpc_group_level4",
        s1."filing_year",
        SUM(s2."filings" * POWER(0.9, s1."rn" - s2."rn")) * 0.1 AS "ema_0_1"
    FROM seq s1
    JOIN seq s2
      ON s1."cpc_group_level4" = s2."cpc_group_level4"
     AND s2."rn" <= s1."rn"
    GROUP BY
        s1."cpc_group_level4",
        s1."filing_year",
        s1."rn"
),
best_year AS (
    SELECT
        e.*,
        ROW_NUMBER() OVER (PARTITION BY e."cpc_group_level4" ORDER BY e."ema_0_1" DESC) AS "rank_ema"
    FROM ema e
),
global_best AS (
    SELECT
        d."titleFull",
        b."cpc_group_level4",
        b."filing_year" AS "best_year",
        b."ema_0_1"     AS "highest_ema",
        ROW_NUMBER() OVER (ORDER BY b."ema_0_1" DESC) AS "overall_rank"
    FROM best_year b
    JOIN PATENTS.PATENTS.CPC_DEFINITION d
      ON d."symbol" = b."cpc_group_level4"
    WHERE d."level" = 4
      AND b."rank_ema" = 1
)
SELECT
    "titleFull",
    "cpc_group_level4",
    "best_year",
    "highest_ema"
FROM global_best
WHERE "overall_rank" = 1
LIMIT 20;
```

