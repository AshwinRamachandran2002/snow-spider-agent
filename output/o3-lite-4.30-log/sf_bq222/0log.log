    b.cpc_group                              AS cpc_group,
    b.filing_year                            AS year_with_max_exponential_moving_average
FROM best_year b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b.cpc_group
      AND d."level"  = 4                    -- ensure level‑4 title
