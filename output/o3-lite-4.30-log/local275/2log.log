```sql
WITH centred AS (
    /* 12‑month centred moving average:
       6 months before + current month + 5 months after = 12 observations   */
    SELECT
        product_id,
        mth,
        qty,
        AVG(qty) OVER (
            PARTITION BY product_id
            ORDER BY mth
            ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
        ) AS centred_avg
    FROM monthly_sales
    WHERE mth >= '2016-01-01'                -- data start‑point stated in task
),
ratios AS (
    /* seasonality‑adjusted ratio for every 2017 month                      */
    SELECT
        product_id,
        mth,
        qty * 1.0 / centred_avg AS ratio
    FROM centred
    WHERE strftime('%Y', mth) = '2017'
),
qualifying_products AS (
    /* keep products whose ratio stayed ≥ 2 for all 12 months of 2017       */
    SELECT product_id
    FROM ratios
    GROUP BY product_id
    HAVING MIN(ratio) >= 2                -- consistently at least 2
       AND COUNT(*)      = 12             -- every 2017 month present
)
SELECT
    p.name AS product_name,
    p.id   AS product_id
FROM products AS p
JOIN qualifying_products q
  ON p.id = q.product_id
ORDER BY p.name;
```
