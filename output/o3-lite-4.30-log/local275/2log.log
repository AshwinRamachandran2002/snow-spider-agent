Begin Exploring Related Columns
Relevant tables / columns for the task  

• monthly_sales.product_id : monthly quantities per product  
• monthly_sales.mth        : month of the sale (will be filtered to 2016‑01‑01 … 2017‑12‑01)  
• monthly_sales.qty        : units sold in that month  
• products.id              : product key (join)  
• products.name            : human‑readable product name  

Typical conditions that will be used  

• WHERE mth BETWEEN '2016-01-01' AND '2017-12-31'  
• WHERE strftime('%Y', mth) = '2017'               -- restrict to calendar year  
• HAVING MIN(ratio) > 2                            -- every month ratio above 2  

Below are ten exploratory → progressively more complex SQLite queries
(each finished with LIMIT 20) that build up to the final answer.

```sql
-- 1) Show the first 20 different months we have in the monthly_sales table
SELECT DISTINCT mth
FROM monthly_sales
ORDER BY mth
LIMIT 20;
```

```sql
-- 2) See which product_ids appear in the sales table
SELECT DISTINCT product_id
FROM monthly_sales
ORDER BY product_id
LIMIT 20;
```

```sql
-- 3) Check each product’s total quantity in 2016
SELECT product_id,
       SUM(qty) AS qty_2016
FROM monthly_sales
WHERE mth BETWEEN '2016-01-01' AND '2016-12-31'
GROUP BY product_id
ORDER BY qty_2016 DESC
LIMIT 20;
```

```sql
-- 4) Compute a 12‑month moving average (back‑looking) per product
SELECT product_id,
       mth,
       qty,
       AVG(qty) OVER (PARTITION BY product_id
                      ORDER BY mth
                      ROWS BETWEEN 11 PRECEDING AND CURRENT ROW) AS mov_avg_12
FROM monthly_sales
ORDER BY product_id, mth
LIMIT 20;
```

```sql
-- 5) Turn the 12‑month moving average into a centred 12‑month moving average
--    (6 months before + current + 5 months after → 12 months)
SELECT product_id,
       mth,
       qty,
       AVG(qty) OVER (PARTITION BY product_id
                      ORDER BY mth
                      ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS centred_avg_12
FROM monthly_sales
ORDER BY product_id, mth
LIMIT 20;
```

```sql
-- 6) Derive the seasonality‑adjusted ratio (qty / centred_avg_12)
WITH centred AS (
  SELECT product_id,
         mth,
         qty,
         AVG(qty) OVER (PARTITION BY product_id
                        ORDER BY mth
                        ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS centred_avg_12
  FROM monthly_sales
)
SELECT product_id,
       mth,
       qty,
       centred_avg_12,
       qty*1.0/centred_avg_12 AS ratio
FROM centred
WHERE mth BETWEEN '2017-01-01' AND '2017-12-31'
ORDER BY product_id, mth
LIMIT 20;
```

```sql
-- 7) List every 2017 month where the ratio already exceeds 2
WITH centred AS (
  SELECT product_id,
         mth,
         qty,
         AVG(qty) OVER (PARTITION BY product_id
                        ORDER BY mth
                        ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS centred_avg_12
  FROM monthly_sales
),
ratios AS (
  SELECT product_id,
         mth,
         qty,
         qty*1.0/centred_avg_12 AS ratio
  FROM centred
  WHERE strftime('%Y', mth) = '2017'
)
SELECT *
FROM ratios
WHERE ratio > 2
ORDER BY product_id, mth
LIMIT 20;
```

```sql
-- 8) Count how many 2017 months each product has with ratio > 2
WITH centred AS (
  SELECT product_id,
         mth,
         qty,
         AVG(qty) OVER (PARTITION BY product_id
                        ORDER BY mth
                        ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS centred_avg_12
  FROM monthly_sales
),
ratios AS (
  SELECT product_id,
         mth,
         qty,
         qty*1.0/centred_avg_12 AS ratio
  FROM centred
  WHERE strftime('%Y', mth) = '2017'
)
SELECT product_id,
       SUM(CASE WHEN ratio > 2 THEN 1 ELSE 0 END) AS months_ratio_gt2
FROM ratios
GROUP BY product_id
ORDER BY months_ratio_gt2 DESC
LIMIT 20;
```

```sql
-- 9) Keep only products whose ratio stayed above 2 *for all 12 months* of 2017
WITH centred AS (
  SELECT product_id,
         mth,
         qty,
         AVG(qty) OVER (PARTITION BY product_id
                        ORDER BY mth
                        ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS centred_avg_12
  FROM monthly_sales
),
ratios AS (
  SELECT product_id,
         mth,
         qty,
         qty*1.0/centred_avg_12 AS ratio
  FROM centred
  WHERE strftime('%Y', mth) = '2017'
),
flagged AS (
  SELECT product_id,
         MIN(ratio) AS lowest_ratio_2017,
         COUNT(*)   AS months_present
  FROM ratios
  GROUP BY product_id
)
SELECT product_id
FROM flagged
WHERE lowest_ratio_2017 > 2   -- all months above 2
  AND months_present = 12     -- exactly 12 months in 2017
LIMIT 20;
```

```sql
-- 10) FINAL – get the human‑readable names of those consistently strong products
WITH centred AS (
  SELECT product_id,
         mth,
         qty,
         AVG(qty) OVER (PARTITION BY product_id
                        ORDER BY mth
                        ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS centred_avg_12
  FROM monthly_sales
),
ratios AS (
  SELECT product_id,
         mth,
         qty,
         qty*1.0/centred_avg_12 AS ratio
  FROM centred
  WHERE strftime('%Y', mth) = '2017'
),
flagged AS (
  SELECT product_id
  FROM ratios
  GROUP BY product_id
  HAVING MIN(ratio) > 2          -- ratio above 2 every month
     AND COUNT(*) = 12           -- all 12 months represented
)
SELECT p.id          AS product_id,
       p.name        AS product_name
FROM products AS p
JOIN flagged  AS f ON f.product_id = p.id
LIMIT 20;
```
