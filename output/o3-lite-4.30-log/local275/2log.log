--Description:  Return all products whose seasonality‑adjusted sales ratio
--              (actual qty ÷ centred 12‑month moving average) never dropped
--              below 2 in any month of 2017 ­— i.e. the answer the original
--              “FINAL” query was meant to deliver, but now written so we can
--              also inspect each product’s lowest 2017 ratio and confirm the
--              filter logic.
WITH centred AS (
    SELECT
        product_id,
        mth,
        qty,
        AVG(qty) OVER (
            PARTITION BY product_id
            ORDER BY mth
            ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING   -- centred 12‑month window
        ) AS centred_avg_12
    FROM monthly_sales
),
ratios AS (
    SELECT
        product_id,
        mth,
        qty,
        qty * 1.0 / centred_avg_12 AS ratio
    FROM centred
    WHERE strftime('%Y', mth) = '2017'                 -- focus on 2017 only
),
summary AS (
    SELECT
        product_id,
        MIN(ratio)  AS min_ratio_2017,                 -- worst (lowest) ratio in 2017
        COUNT(*)    AS months_present
    FROM ratios
    GROUP BY product_id
    HAVING months_present = 12                        -- keep only complete years
       AND min_ratio_2017 > 2                         -- stayed above the threshold
)
SELECT
    s.product_id,
    p.name AS product_name,
    s.min_ratio_2017
FROM summary AS s
JOIN products AS p ON p.id = s.product_id
ORDER BY p.name
