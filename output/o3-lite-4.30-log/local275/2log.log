```sql
--Description: For each product that has sales in every one of the 12 months of 2017,
--             compute its centred 12‑month moving average, derive the seasonality‑
--             adjusted sales ratio (qty ÷ centred_avg_12) for each month of 2017,
--             and then report the lowest ratio the product reaches during that year.
--             Sorting by that minimum ratio lets us see how close (or far) each
--             product is from the threshold of 2 that the original task was after.
WITH centred AS (
    SELECT
        product_id,
        mth,
        qty,
        AVG(qty) OVER (
            PARTITION BY product_id
            ORDER BY mth
            ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING   -- centred 12‑month window
        ) AS centred_avg_12
    FROM monthly_sales
),
ratios AS (
    SELECT
        product_id,
        mth,
        qty,
        qty * 1.0 / centred_avg_12 AS ratio
    FROM centred
    WHERE strftime('%Y', mth) = '2017'                -- focus on 2017 only
),
summary AS (
    SELECT
        product_id,
        MIN(ratio)  AS min_ratio_2017,                -- worst (lowest) ratio in 2017
        COUNT(*)    AS months_present
    FROM ratios
    GROUP BY product_id
    HAVING months_present = 12                        -- keep only complete years
)
SELECT
    s.product_id,
    p.name              AS product_name,
    s.min_ratio_2017
FROM summary AS s
JOIN products AS p ON p.id = s.product_id
ORDER BY s.min_ratio_2017 DESC;
```
