```sql
--Description:
-- Corrected “final answer” query.  It returns the products whose seasonality‑adjusted
-- sales ratio (qty ÷ centred 12‑month moving average) exceeded 2 for every one
-- of the 12 calendar‑year 2017 months.
-- Steps
-- 1) Build a centred 12‑month moving average (ma12) from Jan‑2016 onward, so each
--    2017 month has the required six‑month history on either side.
-- 2) For 2017 rows compute the ratio qty / ma12.
-- 3) Keep products that have exactly 12 analysed months in 2017 **and** whose ratio
--    is >2 in all of them.
-- 4) Join to products to show readable names.
WITH ma AS (                       -- step‑1: moving average
    SELECT  m1.product_id,
            m1.mth,
            m1.qty,
            (SELECT AVG(m2.qty)
             FROM monthly_sales AS m2
             WHERE m2.product_id = m1.product_id
               AND m2.mth BETWEEN date(m1.mth,'-6 months')
                               AND date(m1.mth,'+6 months')) AS ma12
    FROM monthly_sales AS m1
    WHERE m1.mth >= '2016-01-01'   -- guarantee history for centred window
),
rat AS (                           -- step‑2: 2017 ratio
    SELECT  product_id,
            mth,
            qty * 1.0 / ma12 AS ratio
    FROM ma
    WHERE ma12 IS NOT NULL
      AND mth BETWEEN '2017-01-01' AND '2017-12-31'
),
flag AS (                          -- step‑3: ensure 12 good months
    SELECT  product_id
    FROM    rat
    GROUP BY product_id
    HAVING  COUNT(*) = 12                              -- all 12 months present
       AND SUM(CASE WHEN ratio > 2 THEN 1 END) = 12    -- ratio >2 every month
)
SELECT  p.id   AS product_id,
        p.name
FROM    products AS p
JOIN    flag AS f ON f.product_id = p.id
ORDER BY p.id;
