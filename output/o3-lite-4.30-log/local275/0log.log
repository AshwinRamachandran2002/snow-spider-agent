WITH centered_ma AS (
    /* 12‑month centred moving average (6 months before & 6 months after, current included) */
    SELECT  m1.product_id,
            m1.mth,
            m1.qty,
            (
                SELECT AVG(m2.qty)
                FROM   monthly_sales AS m2
                WHERE  m2.product_id = m1.product_id
                  AND  m2.mth BETWEEN date(m1.mth,'-6 months')
                                 AND date(m1.mth,'+6 months')
            ) AS ma12
    FROM   monthly_sales AS m1
    WHERE  m1.mth >= '2016-01-01'
),
ratios AS (
    SELECT  product_id,
            mth,
            qty * 1.0 / ma12 AS ratio
    FROM    centered_ma
    WHERE   ma12 IS NOT NULL
),
qualified AS (
    SELECT  product_id
    FROM    ratios
    WHERE   mth BETWEEN '2017-01-01' AND '2017-12-31'
    GROUP BY product_id
    HAVING  COUNT(*) = 12            /* all 12 months present in 2017 */
       AND  MIN(ratio) >= 2          /* ratio at least 2 every month  */
)
SELECT p.name AS product_name,
       p.id   AS product_id
FROM   products AS p
JOIN   qualified AS q
  ON   p.id = q.product_id
ORDER BY p.id;
```
