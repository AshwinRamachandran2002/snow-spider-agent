```sql
--Description:
-- 1) For each product/month beginning Jan‑2016, build a centred 12‑month moving
--    average (ma12) so that every 2017 month has six months of history both
--    before and after.
-- 2) Keep only the 2017 rows, compute the seasonality‑adjusted ratio
--    (qty ÷ ma12), and for every product count:
--       • good_months = months where ratio > 2
--       • total_months = months analysed in 2017
-- 3) Join to products for readable names and show the first 20 rows,
--    ordered by how many “good” months they achieved.
WITH ma AS (                           -- step‑1 moving average
    SELECT  m1.product_id,
            m1.mth,
            m1.qty,
            (SELECT AVG(m2.qty)
             FROM monthly_sales AS m2
             WHERE m2.product_id = m1.product_id
               AND m2.mth BETWEEN date(m1.mth,'-6 months')
                               AND date(m1.mth,'+6 months')) AS ma12
    FROM monthly_sales AS m1
    WHERE m1.mth >= '2016-01-01'       -- ensure six‑month history before 2017
),
rat AS (                               -- step‑2 calculate ratio for 2017
    SELECT  product_id,
            mth,
            qty * 1.0 / ma12 AS ratio
    FROM ma
    WHERE ma12 IS NOT NULL
      AND mth BETWEEN '2017-01-01' AND '2017-12-31'
),
summary AS (                           -- step‑3 aggregate by product
    SELECT  product_id,
            SUM(CASE WHEN ratio > 2 THEN 1 ELSE 0 END) AS good_months,
            COUNT(*)                                   AS total_months
    FROM rat
    GROUP BY product_id
)
SELECT  s.product_id,
        p.name,
        s.good_months,
        s.total_months
FROM    summary AS s
LEFT JOIN products AS p ON p.id = s.product_id
ORDER BY s.good_months DESC, s.product_id
LIMIT 20;
```
