Relevant columns and why they matter

monthly_sales.product_id : link each sales record to a product  
monthly_sales.mth        : month of the sales record (YYYY‑MM‑DD) – lets us filter 2016‑2017  
monthly_sales.qty        : the quantity that will be seasonally adjusted  
products.id              : joins to monthly_sales.product_id  
products.name            : readable product name to show in the result  

Typical filters / conditions that will be used

mth >= '2016‑01‑01'                 – be sure we have data starting Jan‑2016  
mth BETWEEN '2017‑01‑01' AND '2017‑12‑31'   – isolate calendar‑year 2017  
ratio > 2                           – seasonality–adjusted sales above the required threshold  
COUNT(*) = 12                       – must meet the threshold for every month of 2017  

Ten exploratory queries
(Each query is different, shows ≤20 rows, and is annotated with its purpose.)

```sql
-- 1. List a few distinct years we have in monthly_sales
SELECT DISTINCT substr(mth,1,4) AS year
FROM monthly_sales
ORDER BY year
LIMIT 20;
```

```sql
-- 2. Glimpse one product’s monthly sales pattern
SELECT product_id, mth, qty
FROM monthly_sales
WHERE product_id = 4040
ORDER BY mth
LIMIT 20;
```

```sql
-- 3. Distinct products that have data in 2017
SELECT DISTINCT product_id
FROM monthly_sales
WHERE mth BETWEEN '2017-01-01' AND '2017-12-31'
LIMIT 20;
```

```sql
-- 4. Monthly totals for one product in 2017
SELECT product_id, mth, qty
FROM monthly_sales
WHERE product_id = 4040
  AND mth BETWEEN '2017-01-01' AND '2017-12-31'
ORDER BY mth
LIMIT 20;
```

```sql
-- 5. 12‑month centred moving average for one product
SELECT  m1.product_id,
        m1.mth,
        m1.qty,
        (SELECT AVG(m2.qty)
         FROM monthly_sales AS m2
         WHERE m2.product_id = m1.product_id
           AND m2.mth BETWEEN date(m1.mth,'-6 months') AND date(m1.mth,'+6 months')
        ) AS ma12
FROM monthly_sales AS m1
WHERE m1.product_id = 4040
ORDER BY m1.mth
LIMIT 20;
```

```sql
-- 6. Seasonality‑adjusted ratio (qty / centred MA) for one product
SELECT  m1.product_id,
        m1.mth,
        m1.qty,
        ROUND(m1.qty * 1.0 / ma12, 3) AS ratio
FROM (
      SELECT  m1.*,
              (SELECT AVG(m2.qty)
               FROM monthly_sales AS m2
               WHERE m2.product_id = m1.product_id
                 AND m2.mth BETWEEN date(m1.mth,'-6 months') 
                                 AND date(m1.mth,'+6 months')
              ) AS ma12
      FROM monthly_sales AS m1
      WHERE m1.product_id = 4040
) AS m1
WHERE ma12 IS NOT NULL
ORDER BY m1.mth
LIMIT 20;
```

```sql
-- 7. All product/month rows whose ratio is > 2 during 2017
WITH ma AS (
   SELECT  m1.product_id,
           m1.mth,
           m1.qty,
           (SELECT AVG(m2.qty)
            FROM monthly_sales AS m2
            WHERE m2.product_id = m1.product_id
              AND m2.mth BETWEEN date(m1.mth,'-6 months') AND date(m1.mth,'+6 months')
           ) AS ma12
   FROM monthly_sales AS m1
)
SELECT product_id, mth, ROUND(qty*1.0/ma12,3) AS ratio
FROM ma
WHERE ma12 IS NOT NULL
  AND mth BETWEEN '2017-01-01' AND '2017-12-31'
  AND qty*1.0/ma12 > 2
ORDER BY product_id, mth
LIMIT 20;
```

```sql
-- 8. Count of 2017 months where ratio > 2 for every product
WITH ma AS (
   SELECT  m1.product_id,
           m1.mth,
           m1.qty,
           (SELECT AVG(m2.qty)
            FROM monthly_sales AS m2
            WHERE m2.product_id = m1.product_id
              AND m2.mth BETWEEN date(m1.mth,'-6 months') AND date(m1.mth,'+6 months')
           ) AS ma12
   FROM monthly_sales AS m1
),
rat AS (
   SELECT product_id, mth,
          qty*1.0/ma12 AS ratio
   FROM ma
   WHERE ma12 IS NOT NULL
     AND mth BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT product_id,
       COUNT(*)             AS months_in_2017,
       SUM(ratio > 2)       AS months_above_2
FROM rat
GROUP BY product_id
LIMIT 20;
```

```sql
-- 9. Products whose ratio was >2 in all 12 months of 2017
WITH ma AS (
   SELECT  m1.product_id,
           m1.mth,
           m1.qty,
           (SELECT AVG(m2.qty)
            FROM monthly_sales AS m2
            WHERE m2.product_id = m1.product_id
              AND m2.mth BETWEEN date(m1.mth,'-6 months') AND date(m1.mth,'+6 months')
           ) AS ma12
   FROM monthly_sales AS m1
),
rat AS (
   SELECT product_id, mth,
          qty*1.0/ma12 AS ratio
   FROM ma
   WHERE ma12 IS NOT NULL
     AND mth BETWEEN '2017-01-01' AND '2017-12-31'
),
flag AS (
   SELECT product_id,
          SUM(CASE WHEN ratio > 2 THEN 1 ELSE 0 END) AS good_months,
          COUNT(*)                                   AS total_months
   FROM rat
   GROUP BY product_id
)
SELECT product_id
FROM flag
WHERE good_months = 12     -- every month
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER – product names that met the requirement
WITH ma AS (
   SELECT  m1.product_id,
           m1.mth,
           m1.qty,
           (SELECT AVG(m2.qty)
            FROM monthly_sales AS m2
            WHERE m2.product_id = m1.product_id
              AND m2.mth BETWEEN date(m1.mth,'-6 months') AND date(m1.mth,'+6 months')
           ) AS ma12
   FROM monthly_sales AS m1
   WHERE m1.mth >= '2016-01-01'        -- make sure we have enough history
),
rat AS (
   SELECT product_id, mth,
          qty*1.0/ma12 AS ratio
   FROM ma
   WHERE ma12 IS NOT NULL
     AND mth BETWEEN '2017-01-01' AND '2017-12-31'
),
flag AS (
   SELECT product_id
   FROM rat
   GROUP BY product_id
   HAVING SUM(CASE WHEN ratio > 2 THEN 1 ELSE 0 END) = 12    -- all months good
)
SELECT p.id AS product_id,
       p.name
FROM products AS p
JOIN flag   AS f  ON f.product_id = p.id
ORDER BY p.id
LIMIT 20;
```

Running query #10 will return every product whose seasonality‑adjusted sales ratio remained above 2 in every single month of 2017.
