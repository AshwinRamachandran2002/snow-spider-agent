```sql
--Description: Identify products that achieved a seasonality‑adjusted
--             sales ratio of at least 2 in ANY month of 2017.
--             • A centred 7‑month moving average is built with
--               ROWS BETWEEN 3 PRECEDING AND 3 FOLLOWING.
--             • The ratio is qty / moving‑average.
--             • We summarise 2017 per product and keep those whose
--               maximum ratio (peak performance) reaches the 2× level.
WITH ratios AS (                      -- step‑1: calculate monthly ratios
    SELECT  product_id,
            mth,
            qty,
            qty * 1.0 /
            AVG(qty) OVER (
                 PARTITION BY product_id
                 ORDER BY mth
                 ROWS BETWEEN 3 PRECEDING AND 3 FOLLOWING
            ) AS ratio
    FROM    monthly_sales
    WHERE   mth >= '2016-01-01'
), peaks AS (                         -- step‑2: 2017 peak ratio per product
    SELECT  product_id,
            MAX(ratio) AS max_ratio_2017
    FROM    ratios
    WHERE   strftime('%Y', mth) = '2017'
    GROUP   BY product_id
    HAVING  max_ratio_2017 >= 2        -- at least one month ≥ 2
)
SELECT  p.id   AS product_id,
        p.name AS product_name,
        ROUND(pe.max_ratio_2017, 2) AS peak_ratio_2017
FROM    products p
JOIN    peaks pe ON p.id = pe.product_id
ORDER   BY peak_ratio_2017 DESC, p.name;
