```sql
--Description:  Find, for every product and month of 2017, the seasonality‑adjusted
--              sales ratio (qty divided by a centred 7‑month moving average).
--              We build the moving average with ROWS BETWEEN 3 PRECEDING AND 3
--              FOLLOWING so that each row is averaged with its three prior and
--              three subsequent months, eliminating the “all‑1.0” issue caused
--              by using RANGE in earlier attempts.  The final output lets us
--              inspect the ratios directly, ordered from highest to lowest, to
--              judge whether any product ever exceeds the threshold of 2.
WITH ratios AS (
    SELECT  product_id,
            mth,
            qty,
            qty * 1.0 /
            AVG(qty) OVER (
                PARTITION BY product_id
                ORDER BY mth
                ROWS BETWEEN 3 PRECEDING AND 3 FOLLOWING   -- centred window
            ) AS ratio
    FROM    monthly_sales
    WHERE   mth >= '2016-01-01'
)
SELECT  product_id,
        mth,
        qty,
        ROUND(ratio, 2) AS ratio_2017
FROM    ratios
WHERE   strftime('%Y', mth) = '2017'
ORDER   BY ratio_2017 DESC, product_id, mth
LIMIT   20;
```
