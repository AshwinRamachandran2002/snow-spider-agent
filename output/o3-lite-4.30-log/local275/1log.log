       mth,
       qty,
       ROUND(qty /
             AVG(qty) OVER (
                 PARTITION BY product_id
                 ORDER BY mth
                 RANGE BETWEEN 6 PRECEDING AND 6 FOLLOWING
             ), 2) AS ratio
FROM   monthly_sales
WHERE  mth >= '2016-01-01'
ORDER  BY product_id, mth
LIMIT  20;
```

```sql
-- 6. Keep only the 2017 months with the ratio
WITH sa AS (
