```

```sql
-- 7. Minimum 2017 ratio per product
WITH sa AS (
  SELECT product_id,
         mth,
         qty,
         qty /
         AVG(qty) OVER (
             PARTITION BY product_id
             ORDER BY mth
             RANGE BETWEEN 6 PRECEDING AND 6 FOLLOWING
         ) AS ratio
  FROM   monthly_sales
  WHERE  mth >= '2016-01-01'
)
SELECT product_id,
       MIN(ratio) AS min_ratio_2017
FROM   sa
WHERE  strftime('%Y', mth) = '2017'
GROUP  BY product_id
ORDER  BY min_ratio_2017 DESC
LIMIT  20;
```

```sql
-- 8. Products whose 2017 ratio never fell below 2
WITH sa AS (
  SELECT product_id,
         mth,
         qty,
         qty /
         AVG(qty) OVER (
             PARTITION BY product_id
             ORDER BY mth
             RANGE BETWEEN 6 PRECEDING AND 6 FOLLOWING
         ) AS ratio
  FROM   monthly_sales
  WHERE  mth >= '2016-01-01'
)
SELECT product_id
FROM   sa
WHERE  strftime('%Y', mth) = '2017'
GROUP  BY product_id
HAVING MIN(ratio) > 2
LIMIT  20;
```

```sql
-- 9. Same list, now with product names
WITH sa AS (
  SELECT product_id,
         mth,
         qty,
         qty /
         AVG(qty) OVER (
             PARTITION BY product_id
             ORDER BY mth
             RANGE BETWEEN 6 PRECEDING AND 6 FOLLOWING
         ) AS ratio
  FROM   monthly_sales
  WHERE  mth >= '2016-01-01'
), good AS (
  SELECT product_id
  FROM   sa
  WHERE  strftime('%Y', mth) = '2017'
  GROUP  BY product_id
  HAVING MIN(ratio) > 2
)
SELECT p.id   AS product_id,
       p.name AS product_name
FROM   products AS p
JOIN   good     ON p.id = good.product_id
ORDER  BY p.name
LIMIT  20;
```

```sql
-- 10. FINAL ANSWER – every product whose seasonality‑adjusted
--     sales ratio stayed above 2 for ALL months of 2017
WITH sa AS (
  SELECT product_id,
         mth,
         qty,
         qty /
         AVG(qty) OVER (
             PARTITION BY product_id
             ORDER BY mth
             RANGE BETWEEN 6 PRECEDING AND 6 FOLLOWING
         ) AS ratio
  FROM   monthly_sales
  WHERE  mth >= '2016-01-01'
), always_above_2 AS (
  SELECT product_id
  FROM   sa
  WHERE  strftime('%Y', mth) = '2017'
  GROUP  BY product_id
  HAVING MIN(ratio) > 2
)
SELECT DISTINCT p.id   AS product_id,
       p.name AS product_name
FROM   products AS p
JOIN   always_above_2 a ON a.product_id = p.id
ORDER  BY p.name;
```

