```sql
--Description: Same list, now with product names.  
--             Uses a centred 7‑month moving average implemented with
--             ROWS BETWEEN 3 PRECEDING AND 3 FOLLOWING to calculate the
--             seasonality‑adjusted ratio.  Products whose ratio never
--             drops below 2 during any 2017 month are kept and their
--             names displayed.
WITH sa AS (
    SELECT product_id,
           mth,
           qty,
           qty * 1.0 /
           AVG(qty) OVER (
                PARTITION BY product_id
                ORDER BY mth
                ROWS BETWEEN 3 PRECEDING AND 3 FOLLOWING   -- centred window
           ) AS ratio
    FROM   monthly_sales
    WHERE  mth >= '2016-01-01'
), good AS (
    SELECT product_id
    FROM   sa
    WHERE  strftime('%Y', mth) = '2017'
    GROUP  BY product_id
    HAVING MIN(ratio) > 2
)
SELECT p.id   AS product_id,
       p.name AS product_name
FROM   products AS p
JOIN   good     ON p.id = good.product_id
ORDER  BY p.name
LIMIT  20;
```

```sql
--Description: FINAL ANSWER – every product whose seasonality‑adjusted
--             sales ratio stayed above 2 for ALL months of 2017.
--             The centred moving average again uses ROWS to include the
--             three months before and after each observation.
WITH sa AS (
    SELECT product_id,
           mth,
           qty,
           qty * 1.0 /
           AVG(qty) OVER (
                PARTITION BY product_id
                ORDER BY mth
                ROWS BETWEEN 3 PRECEDING AND 3 FOLLOWING   -- centred window
           ) AS ratio
    FROM   monthly_sales
    WHERE  mth >= '2016-01-01'
), always_above_2 AS (
    SELECT product_id
    FROM   sa
    WHERE  strftime('%Y', mth) = '2017'
    GROUP  BY product_id
    HAVING MIN(ratio) > 2
)
SELECT DISTINCT p.id   AS product_id,
       p.name AS product_name
FROM   products AS p
JOIN   always_above_2 a ON a.product_id = p.id
ORDER  BY p.name;
