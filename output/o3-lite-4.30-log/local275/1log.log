         mth,
         qty,
         qty /
         AVG(qty) OVER (
             PARTITION BY product_id
             ORDER BY mth
             RANGE BETWEEN 6 PRECEDING AND 6 FOLLOWING
         ) AS ratio
  FROM   monthly_sales
  WHERE  mth >= '2016-01-01'
)
SELECT *            -- product_id, mth, qty, ratio
