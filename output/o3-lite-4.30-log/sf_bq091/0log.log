Query:
--Description: #8 – Using that top assignee, list the filing‑year distribution (top 20 years) of their A61‑category publications.
WITH top_assignee AS (
    SELECT  a.value::STRING AS assignee
    FROM PATENTS.PATENTS.PUBLICATIONS p
         , LATERAL FLATTEN(input => p."cpc")              c
         , LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%'
          AND a.value::STRING IS NOT NULL
    GROUP BY assignee
    ORDER BY COUNT(DISTINCT p."publication_number") DESC
    LIMIT 1
)
SELECT
       CAST(p."filing_date"/10000 AS INT)                 AS filing_year,
       COUNT(DISTINCT p."publication_number")             AS n_applications
FROM PATENTS.PATENTS.PUBLICATIONS p
     , LATERAL FLATTEN(input => p."cpc")                  c
     , LATERAL FLATTEN(input => p."assignee_harmonized")  a
     , top_assignee ta
WHERE c.value:"code"::STRING ILIKE 'A61%'
      AND a.value::STRING = ta.assignee
GROUP BY filing_year
ORDER BY n_applications DESC
LIMIT 20
