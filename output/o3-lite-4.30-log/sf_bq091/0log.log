Begin Exploring Related Columns
Relevant columns and their potential usage  
• "cpc": locating each application’s CPC symbols in order to filter to codes beginning with ‘A61’.  
• "assignee_harmonized": getting the (cleaned) applicant / assignee names.  
• "filing_date": extracting the year the application was filed (YYYY from yyyymmdd numeric).  
• "publication_number" (or "application_number"): a handy unique‑ish handle for counting “applications”.  
• "family_id": optional deduplication key when several publications belong to a single simple‑family.

Typical conditions that may be used  
1. LATERAL FLATTEN on "cpc" to expose every CPC object → f.value:"code"::STRING ILIKE 'A61%'.  
2. LATERAL FLATTEN on "assignee_harmonized" to expose every assignee name → g.value::STRING AS assignee.  
3. Getting a filing year → TO_CHAR("filing_date",'0000') or simply CAST("filing_date"/10000 AS INT).  
4. GROUP BY year / assignee and COUNT(DISTINCT publication_number).

Ten exploratory → final Snowflake SQL queries
```sql
-- 1. Quick look at a handful of raw rows in PUBLICATIONS
SELECT *
FROM PATENTS.PATENTS.PUBLICATIONS
LIMIT 20;
```

```sql
-- 2. What does the CPC array look like?  Show 20 distinct CPC codes
SELECT DISTINCT
       c.value:"code"::STRING AS "cpc_code"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") c
LIMIT 20;
```

```sql
-- 3. Verify CPC codes that start with ‘A61’ (medical / health domain)
SELECT DISTINCT
       c.value:"code"::STRING AS "a61_code"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") c
WHERE c.value:"code"::STRING ILIKE 'A61%'
LIMIT 20;
```

```sql
-- 4. Inspect how the harmonised assignee list is stored
SELECT DISTINCT
       a.value::STRING AS "assignee_name"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
LIMIT 20;
```

```sql
-- 5. Count how many A61‐category publications exist in total
SELECT COUNT(*) AS "a61_publication_rows"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") c
WHERE c.value:"code"::STRING ILIKE 'A61%';
```

```sql
-- 6. Top 20 assignees by A61 application count
SELECT
       assignee,
       COUNT(DISTINCT p."publication_number") AS n_applications
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%'
      AND (assignee := a.value::STRING) IS NOT NULL
GROUP BY assignee
ORDER BY n_applications DESC
LIMIT 20;
```

```sql
-- 7. Identify just the single assignee with the very most A61 applications
SELECT assignee
FROM (
     SELECT
            a.value::STRING AS assignee,
            COUNT(DISTINCT p."publication_number") AS n_applications
     FROM PATENTS.PATENTS.PUBLICATIONS p,
          LATERAL FLATTEN(input => p."cpc") c,
          LATERAL FLATTEN(input => p."assignee_harmonized") a
     WHERE c.value:"code"::STRING ILIKE 'A61%'
     GROUP BY assignee
     ORDER BY n_applications DESC
     LIMIT 1
) t;
```

```sql
-- 8. For that top assignee, see applications per filing year (top 20 years)
WITH top_assignee AS (
     SELECT a.value::STRING AS assignee
     FROM PATENTS.PATENTS.PUBLICATIONS p,
          LATERAL FLATTEN(input => p."cpc") c,
          LATERAL FLATTEN(input => p."assignee_harmonized") a
     WHERE c.value:"code"::STRING ILIKE 'A61%'
     GROUP BY assignee
     ORDER BY COUNT(DISTINCT p."publication_number") DESC
     LIMIT 1
)
SELECT
       CAST(p."filing_date"/10000 AS INT) AS filing_year,
       COUNT(DISTINCT p."publication_number") AS n_applications
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a,
     top_assignee ta
WHERE c.value:"code"::STRING ILIKE 'A61%'
      AND a.value::STRING = ta.assignee
GROUP BY filing_year
ORDER BY n_applications DESC
LIMIT 20;
```

```sql
-- 9. Same as #8 but keep only the single year with the maximum filing count
WITH top_assignee AS (
     SELECT a.value::STRING AS assignee
     FROM PATENTS.PATENTS.PUBLICATIONS p,
          LATERAL FLATTEN(input => p."cpc") c,
          LATERAL FLATTEN(input => p."assignee_harmonized") a
     WHERE c.value:"code"::STRING ILIKE 'A61%'
     GROUP BY assignee
     ORDER BY COUNT(DISTINCT p."publication_number") DESC
     LIMIT 1
),
year_counts AS (
     SELECT
            CAST(p."filing_date"/10000 AS INT) AS filing_year,
            COUNT(DISTINCT p."publication_number") AS n_apps
     FROM PATENTS.PATENTS.PUBLICATIONS p,
          LATERAL FLATTEN(input => p."cpc") c,
          LATERAL FLATTEN(input => p."assignee_harmonized") a,
          top_assignee ta
     WHERE c.value:"code"::STRING ILIKE 'A61%'
           AND a.value::STRING = ta.assignee
     GROUP BY filing_year
)
SELECT *
FROM year_counts
ORDER BY n_apps DESC
LIMIT 1;
```

```sql
-- 10. One‑shot query returning   (assignee_with_most_A61_apps,   peak_year,   #apps_that_year)
WITH a61_records AS (
     SELECT
            p."publication_number",
            p."filing_date",
            a.value::STRING AS assignee
     FROM PATENTS.PATENTS.PUBLICATIONS p,
          LATERAL FLATTEN(input => p."cpc") c,
          LATERAL FLATTEN(input => p."assignee_harmonized") a
     WHERE c.value:"code"::STRING ILIKE 'A61%'
),
top_assignee AS (
     SELECT assignee
     FROM a61_records
     GROUP BY assignee
     ORDER BY COUNT(DISTINCT "publication_number") DESC
     LIMIT 1
),
yearly AS (
     SELECT
            CAST(filing_date/10000 AS INT) AS filing_year,
            COUNT(DISTINCT publication_number) AS n_apps
     FROM a61_records ar
     JOIN top_assignee ta ON ar.assignee = ta.assignee
     GROUP BY filing_year
)
SELECT
       ta.assignee,
       y.filing_year,
       y.n_apps
FROM yearly y
JOIN top_assignee ta ON 1=1
ORDER BY y.n_apps DESC
