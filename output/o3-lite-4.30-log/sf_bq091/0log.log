```sql
--Description / Thinking process:
-- Goal:  “In which year did the assignee with the most A61‑category patent applications file the most?”
-- 1.  A61 is identified in the CPC field, which is a VARIANT array of JSON objects containing "code".
-- 2.  Each publication’s CPC list must be expanded (LATERAL FLATTEN) and filtered to codes ILIKE 'A61%'.
-- 3.  Each publication’s assignees are in the assignee_harmonized array; expand it as well.
-- 4.  Count distinct publication numbers per assignee across all A61 publications → find the single top assignee.
-- 5.  Restrict the data set to that top assignee, group by filing year (derived via filing_date/10000),
--     count publications per year, and pick the year with the maximum count.
-- 6.  Return three items: the assignee name, the peak filing year, and the number of A61 publications that year.
WITH a61_pubs AS (          -- all publications that include an A61 CPC symbol
    SELECT
        p."publication_number",
        p."filing_date",
        a.value::STRING            AS assignee
    FROM PATENTS.PATENTS.PUBLICATIONS p
         , LATERAL FLATTEN(input => p."cpc") c
         , LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%'
          AND a.value::STRING IS NOT NULL
),
top_assignee AS (           -- identify the assignee with the most distinct A61 publications
    SELECT assignee
    FROM a61_pubs
    GROUP BY assignee
    ORDER BY COUNT(DISTINCT "publication_number") DESC
    LIMIT 1
),
yearly_totals AS (          -- for that assignee, count publications per filing year
    SELECT
        CAST("filing_date"/10000 AS INT) AS filing_year,
        COUNT(DISTINCT "publication_number") AS n_apps
    FROM a61_pubs
    WHERE assignee = (SELECT assignee FROM top_assignee)
    GROUP BY filing_year
)
SELECT
       (SELECT assignee FROM top_assignee)  AS assignee_with_most_A61_apps,
       filing_year                          AS year_with_most_filings,
       n_apps                               AS num_applications_that_year
FROM yearly_totals
ORDER BY n_apps DESC, filing_year ASC   -- highest count, then earliest year if tie
LIMIT 1;
```
