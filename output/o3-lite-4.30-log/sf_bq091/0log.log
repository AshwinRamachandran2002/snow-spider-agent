--Description: #10 – One‑shot result: (assignee_with_most_A61_apps, peak_year, #apps_that_year).
WITH a61_records AS (
    SELECT
           p."publication_number",
           p."filing_date",
           a.value::STRING AS assignee
    FROM PATENTS.PATENTS.PUBLICATIONS p
         , LATERAL FLATTEN(input => p."cpc")              c
         , LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%'
          AND a.value::STRING IS NOT NULL
),
top_assignee AS (
    SELECT assignee
    FROM a61_records
    GROUP BY assignee
    ORDER BY COUNT(DISTINCT "publication_number") DESC
    LIMIT 1
),
yearly AS (
    SELECT
           CAST(filing_date/10000 AS INT)                 AS filing_year,
           COUNT(DISTINCT publication_number)             AS n_apps
    FROM a61_records ar
    JOIN top_assignee ta
      ON ar.assignee = ta.assignee
    GROUP BY filing_year
)
SELECT
       ta.assignee                                   AS assignee_with_most_A61_apps,
       y.filing_year                                 AS peak_year,
       y.n_apps                                      AS applications_in_peak_year
FROM yearly y
JOIN top_assignee ta  ON TRUE
ORDER BY y.n_apps DESC, y.filing_year ASC
LIMIT 1;
