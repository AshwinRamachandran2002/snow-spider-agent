Query:
--Description: #7 – Identify the single assignee that owns the largest number of distinct publications with at least one CPC symbol beginning “A61”.
SELECT assignee
FROM (
    SELECT
           a.value::STRING                                AS assignee,
           COUNT(DISTINCT p."publication_number")         AS n_applications
    FROM PATENTS.PATENTS.PUBLICATIONS  p
         , LATERAL FLATTEN(input => p."cpc")              c
         , LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%'
          AND a.value::STRING IS NOT NULL
    GROUP BY assignee
    ORDER BY n_applications DESC
    LIMIT 1
) t
