```sql
--Description: Find the year in which the assignee holding the largest number of A61‑category
--             patent applications filed the most applications.
--             • Step‑1: CTE “top_assignee” identifies the assignee name with the highest count of
--               distinct applications whose CPC "code" starts with 'A61'.
--             • Step‑2: Using that assignee, aggregate all of its A61 applications by
--               filing year (derived via FLOOR(filing_date/10000) since filing_date is yyyymmdd).
--             • Step‑3: Order by descending filings and pick the first row to reveal the peak year.
WITH top_assignee AS (
    SELECT a.value:"name"::STRING AS name
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."cpc") f,
           LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE  f.value:"code"::STRING ILIKE 'A61%'       -- keep only A61 CPC codes
      AND  a.value:"name"::STRING IS NOT NULL
    GROUP  BY name
    ORDER  BY COUNT(DISTINCT p."application_number") DESC
    LIMIT 1                                          -- the single most‑prolific assignee
)
SELECT ta.name                                        AS top_assignee,
       FLOOR(p."filing_date" / 10000)                 AS filing_year,
       COUNT(DISTINCT p."application_number")         AS filings_in_year
FROM   PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc") f,
       LATERAL FLATTEN(input => p."assignee_harmonized") a,
       top_assignee ta
WHERE  f.value:"code"::STRING ILIKE 'A61%'            -- still focus on A61 category
  AND  a.value:"name"::STRING = ta.name               -- restrict to the top assignee
GROUP  BY ta.name, filing_year
ORDER  BY filings_in_year DESC, filing_year           -- most‑filings year first
LIMIT 1;                                              -- return the single peak year
```
