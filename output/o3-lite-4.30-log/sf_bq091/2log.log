Begin Exploring Related Columns
Relevant columns and their potential usage  
PUBLICATIONS."cpc": CPC classification codes; filter symbols beginning with 'A61'.  
PUBLICATIONS."assignee_harmonized": assignee names (flatten → name); used to count applications per assignee.  
PUBLICATIONS."application_kind": limit to patents (value = 'A').  
PUBLICATIONS."filing_date": numeric YYYYMMDD; extract the first four digits as year.  
PUBLICATIONS."publication_number": simple handle when sampling individual rows.  

Typical conditions  
1. c.value:"symbol"::STRING ILIKE 'A61%' – select CPC symbols that start with A61.  
2. ak.value:"name"::STRING IS NOT NULL – insure an assignee name is present.  
3. p."application_kind" = 'A' – look only at patent‑type applications.  
4. TO_VARCHAR(p."filing_date") LIKE '____%' – grab the year from the first 4 digits.  

Ten exploratory → solution queries (each returns ≤ 20 rows)

```sql
-- 1) Sample a handful of rows that have CPC information
SELECT p."publication_number",
       p."cpc"
FROM   PATENTS.PATENTS.PUBLICATIONS p
WHERE  p."cpc" IS NOT NULL
LIMIT  20;
```

```sql
-- 2) Examine individual CPC symbols
SELECT DISTINCT
       c.value:"symbol"::STRING AS "cpc_symbol"
FROM   PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc") c
WHERE  c.value:"symbol" IS NOT NULL
LIMIT  20;
```

```sql
-- 3) Show distinct CPC symbols that start with A61
SELECT DISTINCT
       c.value:"symbol"::STRING AS "cpc_symbol"
FROM   PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc") c
WHERE  c.value:"symbol"::STRING ILIKE 'A61%'
LIMIT  20;
```

```sql
-- 4) View assignee names found in A61 publications
SELECT DISTINCT
       ak.value:"name"::STRING AS "assignee_name"
FROM   PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc")  c,
       LATERAL FLATTEN(input => p."assignee_harmonized") ak
WHERE  c.value:"symbol"::STRING ILIKE 'A61%'
  AND  ak.value:"name" IS NOT NULL
  AND  p."application_kind" = 'A'
LIMIT  20;
```

```sql
-- 5) Count A61 applications per assignee
SELECT   ak.value:"name"::STRING AS "assignee_name",
         COUNT(*)                AS "a61_apps"
FROM     PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")  c,
         LATERAL FLATTEN(input => p."assignee_harmonized") ak
WHERE    c.value:"symbol"::STRING ILIKE 'A61%'
  AND    p."application_kind" = 'A'
GROUP BY ak.value:"name"::STRING
ORDER BY "a61_apps" DESC
LIMIT    20;
```

```sql
-- 6) Identify the single assignee with the most A61 applications
SELECT   ak.value:"name"::STRING AS "top_assignee",
         COUNT(*)                AS "a61_apps"
FROM     PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")  c,
         LATERAL FLATTEN(input => p."assignee_harmonized") ak
WHERE    c.value:"symbol"::STRING ILIKE 'A61%'
  AND    p."application_kind" = 'A'
GROUP BY ak.value:"name"::STRING
ORDER BY "a61_apps" DESC
LIMIT    1;
```

```sql
-- 7) List A61 applications of that top assignee with year extracted
SELECT   SUBSTR(TO_VARCHAR(p."filing_date"),1,4) AS "filing_year",
         p."publication_number"
FROM     PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")  c,
         LATERAL FLATTEN(input => p."assignee_harmonized") ak
WHERE    c.value:"symbol"::STRING ILIKE 'A61%'
  AND    p."application_kind" = 'A'
  AND    ak.value:"name"::STRING = '<PUT_TOP_ASSIGNEE_NAME_HERE>'
LIMIT    20;
```

```sql
-- 8) Count yearly filings for that top assignee
SELECT   SUBSTR(TO_VARCHAR(p."filing_date"),1,4) AS "filing_year",
         COUNT(*)                                AS "yearly_apps"
FROM     PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")  c,
         LATERAL FLATTEN(input => p."assignee_harmonized") ak
WHERE    c.value:"symbol"::STRING ILIKE 'A61%'
  AND    p."application_kind" = 'A'
  AND    ak.value:"name"::STRING = '<PUT_TOP_ASSIGNEE_NAME_HERE>'
GROUP BY SUBSTR(TO_VARCHAR(p."filing_date"),1,4)
ORDER BY "yearly_apps" DESC
LIMIT    20;
```

```sql
-- 9) Obtain the single year with the most filings for that assignee
SELECT   SUBSTR(TO_VARCHAR(p."filing_date"),1,4) AS "filing_year",
         COUNT(*)                                AS "yearly_apps"
FROM     PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")  c,
         LATERAL FLATTEN(input => p."assignee_harmonized") ak
WHERE    c.value:"symbol"::STRING ILIKE 'A61%'
  AND    p."application_kind" = 'A'
  AND    ak.value:"name"::STRING = '<PUT_TOP_ASSIGNEE_NAME_HERE>'
GROUP BY SUBSTR(TO_VARCHAR(p."filing_date"),1,4)
ORDER BY "yearly_apps" DESC
LIMIT    1;
```

```sql
-- 10) One‑shot query: find the assignee with the most A61 applications
--     and the year in which that assignee filed the most
WITH a61_apps AS (
    SELECT   ak.value:"name"::STRING AS "assignee_name",
             SUBSTR(TO_VARCHAR(p."filing_date"),1,4) AS "filing_year"
    FROM     PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(input => p."cpc")  c,
             LATERAL FLATTEN(input => p."assignee_harmonized") ak
    WHERE    c.value:"symbol"::STRING ILIKE 'A61%'
      AND    p."application_kind" = 'A'
      AND    ak.value:"name" IS NOT NULL
)
, top_assignee AS (
    SELECT "assignee_name"
    FROM   a61_apps
    GROUP  BY "assignee_name"
    ORDER  BY COUNT(*) DESC
    LIMIT  1
)
SELECT  a."filing_year",
        COUNT(*) AS "applications_in_year"
FROM    a61_apps a
JOIN    top_assignee t
  ON    a."assignee_name" = t."assignee_name"
GROUP BY a."filing_year"
ORDER BY "applications_in_year" DESC
LIMIT   1;
