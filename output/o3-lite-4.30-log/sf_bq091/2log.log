```sql
--Description: Find the single year in which publications classified under CPC codes beginning with “A61”
--             and assigned to any entity whose name contains “PROCTER & GAMBLE” were filed most frequently.
--             We flatten the CPC and assignee JSON arrays, apply flexible ILIKE filters, then group by
--             the first four digits of the numeric filing_date.  Ordering by the count and limiting to 1
--             returns the busiest filing year for that assignee in the A61 domain.
SELECT  SUBSTR(TO_VARCHAR(p."filing_date"), 1, 4) AS "filing_year",
        COUNT(*)                                  AS "a61_applications"
FROM    PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."cpc")               c,
        LATERAL FLATTEN(input => p."assignee_harmonized") ak
WHERE   c.value:"code"::STRING ILIKE 'A61%'                -- CPC class filter
  AND   ak.value:"name"::STRING ILIKE '%PROCTER & GAMBLE%' -- assignee filter (case‑insensitive)
GROUP BY SUBSTR(TO_VARCHAR(p."filing_date"), 1, 4)
ORDER BY "a61_applications" DESC
LIMIT 1;
```
