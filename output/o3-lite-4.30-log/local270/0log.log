```sql
--Description: Find every “top‑level” package (a package that never appears as a child),
-- walk the entire packaging hierarchy, multiply quantities along each path,
-- add up the quantities of each leaf item that ends up inside each top‑level package,
-- and finally keep only those (container,item) pairs whose accumulated quantity > 500.
WITH RECURSIVE
    -- Step 1: traverse the hierarchy; multiply qty for every hop
    paths(container_id, item_id, total_qty) AS (
        -- anchor: direct parent‑child relations
        SELECT pr.packaging_id,
               pr.contains_id,
               pr.qty
        FROM   packaging_relations AS pr
        UNION ALL
        -- recursion: extend the path if current item is itself a container
        SELECT p.container_id,
               pr.contains_id,
               p.total_qty * pr.qty
        FROM   paths AS p
        JOIN   packaging_relations AS pr
               ON pr.packaging_id = p.item_id
    ),
    -- Step 2: identify containers that are never children → true top‑level packages
    top_level AS (
        SELECT DISTINCT packaging_id AS id
        FROM   packaging_relations
        WHERE  packaging_id NOT IN (
              SELECT DISTINCT contains_id FROM packaging_relations
        )
    ),
    -- Step 3: aggregate quantities per (top‑level container, item), keep if > 500
    totals AS (
        SELECT container_id,
               item_id,
               SUM(total_qty) AS total_qty
        FROM   paths
        WHERE  container_id IN (SELECT id FROM top_level)
        GROUP  BY container_id, item_id
        HAVING total_qty > 500
    )
-- Step 4: return human‑readable names and the accumulated quantity
SELECT pc.name  AS container_name,
       pi.name  AS item_name,
       totals.total_qty
FROM   totals
JOIN   packaging AS pc ON pc.id = totals.container_id
JOIN   packaging AS pi ON pi.id = totals.item_id
ORDER  BY pc.name, pi.name;
```
