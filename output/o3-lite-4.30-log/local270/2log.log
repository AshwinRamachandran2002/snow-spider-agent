['customers', 'conway_gen_zero', 'web_devices', 'web_demographics', 'channels_dim', 'gender_dim', 'packaging', 'packaging_relations', 'product_groups', 'products', 'monthly_sales', 'breweries', 'purchases', 'product_alcohol', 'customer_favorites', 'customer_reviews', 'locations', 'inventory', 'orders', 'orderlines', 'monthly_budget', 'product_minimums', 'stock', 'ticker', 'web_apps', 'web_pages', 'web_counter_hist', 'server_heartbeat', 'web_page_visits', 'employees', 'emp_hire_periods', 'picking_list', 'picking_line', 'picking_log', 'id_name_type', 'id_name_coll_type', 'id_name_coll_entries', 'favorite_coll_type']
Begin Exploring Related Columns
Relevant columns and their potential use  
• packaging.id : primary key that identifies every packaging unit; needed when we look‑up names or join to other rows.  
• packaging.name : human readable name of the packaging; required for the final output.  
• packaging_relations.packaging_id : the “parent” (the container that holds something); lets us build the hierarchy.  
• packaging_relations.contains_id : the “child” (whatever is inside the parent); can itself be another container or a final item.  
• packaging_relations.qty : quantity of the child that the parent contains; must be multiplied along the path when we go through several nesting levels.

Typical conditions we will need  
• Top‑level container → packaging.id NOT IN (SELECT contains_id FROM packaging_relations)  
• Recursive tree walk → WITH RECURSIVE … to multiply quantities down through the hierarchy.  
• “Any item total qty > 500” → HAVING SUM(total_qty) > 500

Below are ten exploratory SQL queries – from very simple inspection to a complete recursive solution – each capped with LIMIT 20 so you can run them safely.

```sql
-- 1) Peek at all packaging codes and names
SELECT *
FROM "packaging"
LIMIT 20;
```

```sql
-- 2) Inspect the basic parent‑child relations
SELECT *
FROM "packaging_relations"
LIMIT 20;
```

```sql
-- 3) Which IDs act as parents and which act as children?
SELECT DISTINCT "packaging_id"  AS parent_id   FROM "packaging_relations"
UNION
SELECT DISTINCT "contains_id"   FROM "packaging_relations"
LIMIT 20;
```

```sql
-- 4) Find containers that never appear as children ⇒ top‑level packages
SELECT p."id", p."name"
FROM   "packaging" AS p
WHERE  p."id" NOT IN (SELECT DISTINCT "contains_id" FROM "packaging_relations")
LIMIT 20;
```

```sql
-- 5) Show immediate (1‑level) contents of every top‑level container
SELECT pl."id"            AS top_pack_id,
       pl."name"          AS top_pack_name,
       pr."contains_id"   AS direct_child_id,
       pc."name"          AS direct_child_name,
       pr."qty"
FROM   "packaging"          AS pl
JOIN   "packaging_relations" AS pr ON pr."packaging_id" = pl."id"
JOIN   "packaging"           AS pc ON pc."id" = pr."contains_id"
WHERE  pl."id" NOT IN (SELECT "contains_id" FROM "packaging_relations")
LIMIT 20;
```

```sql
-- 6) Walk *recursively* through the hierarchy and calculate the
--    multiplied quantity for every path segment
WITH RECURSIVE r(parent_id, item_id, tot_qty) AS (
    SELECT pr."packaging_id",
           pr."contains_id",
           pr."qty" * 1.0
    FROM   "packaging_relations" pr
    UNION ALL
    SELECT r."parent_id",
           pr2."contains_id",
           r."tot_qty" * pr2."qty"
    FROM   r
    JOIN   "packaging_relations" pr2
           ON pr2."packaging_id" = r."item_id"
)
SELECT *
FROM   r
LIMIT 20;
```

```sql
-- 7) Aggregate the quantities so each (container, item) pair
--    gets its *total* quantity across all nesting levels
WITH RECURSIVE r(parent_id, item_id, tot_qty) AS (
    SELECT pr."packaging_id", pr."contains_id", pr."qty" * 1.0
    FROM   "packaging_relations" pr
    UNION ALL
    SELECT r."parent_id", pr2."contains_id", r."tot_qty" * pr2."qty"
    FROM   r
    JOIN   "packaging_relations" pr2
           ON pr2."packaging_id" = r."item_id"
)
SELECT   r."parent_id",
         r."item_id",
         SUM(r."tot_qty") AS total_qty
FROM     r
GROUP BY r."parent_id", r."item_id"
LIMIT 20;
```

```sql
-- 8) Keep only *top‑level* containers and compute totals
WITH RECURSIVE r(parent_id, item_id, tot_qty) AS (
    SELECT pr."packaging_id", pr."contains_id", pr."qty" * 1.0
    FROM   "packaging_relations" pr
    UNION ALL
    SELECT r."parent_id", pr2."contains_id", r."tot_qty" * pr2."qty"
    FROM   r
    JOIN   "packaging_relations" pr2
           ON pr2."packaging_id" = r."item_id"
),
agg AS (
    SELECT r."parent_id",
           r."item_id",
           SUM(r."tot_qty") AS total_qty
    FROM   r
    GROUP BY r."parent_id", r."item_id"
),
top_lvl AS (
    SELECT "id" AS top_id
    FROM   "packaging"
    WHERE  "id" NOT IN (SELECT DISTINCT "contains_id" FROM "packaging_relations")
)
SELECT *
FROM   agg
WHERE  agg."parent_id" IN (SELECT top_id FROM top_lvl)
LIMIT 20;
```

```sql
-- 9) Filter pairs whose total quantity > 500 and attach names
WITH RECURSIVE r(parent_id, item_id, tot_qty) AS (
    SELECT pr."packaging_id", pr."contains_id", pr."qty" * 1.0
    FROM   "packaging_relations" pr
    UNION ALL
    SELECT r."parent_id", pr2."contains_id", r."tot_qty" * pr2."qty"
    FROM   r
    JOIN   "packaging_relations" pr2
           ON pr2."packaging_id" = r."item_id"
),
agg AS (
    SELECT r."parent_id",
           r."item_id",
           SUM(r."tot_qty") AS total_qty
    FROM   r
    GROUP BY r."parent_id", r."item_id"
),
top_lvl AS (
    SELECT "id" AS top_id
    FROM   "packaging"
    WHERE  "id" NOT IN (SELECT DISTINCT "contains_id" FROM "packaging_relations")
)
SELECT tp."name"  AS top_container_name,
       ip."name"  AS item_name,
       a."total_qty"
FROM   agg          AS a
JOIN   top_lvl      AS t  ON t.top_id = a."parent_id"
JOIN   "packaging"  AS tp ON tp."id"  = a."parent_id"
JOIN   "packaging"  AS ip ON ip."id"  = a."item_id"
WHERE  a."total_qty" > 500
ORDER  BY tp."name", ip."name"
LIMIT 20;
```

```sql
-- 10) FINAL answer – bring everything together, no LIMIT
--     Shows every top‑level container having at least one item whose
--     summed nested quantity exceeds 500, plus that item’s name & qty
WITH RECURSIVE r(parent_id, item_id, tot_qty) AS (
    SELECT pr."packaging_id", pr."contains_id", pr."qty" * 1.0
    FROM   "packaging_relations" pr
    UNION ALL
    SELECT r."parent_id", pr2."contains_id", r."tot_qty" * pr2."qty"
    FROM   r
    JOIN   "packaging_relations" pr2
           ON pr2."packaging_id" = r."item_id"
),
agg AS (
    SELECT r."parent_id",
           r."item_id",
           SUM(r."tot_qty") AS total_qty
    FROM   r
    GROUP BY r."parent_id", r."item_id"
),
top_lvl AS (
    SELECT "id" AS top_id
    FROM   "packaging"
    WHERE  "id" NOT IN (SELECT DISTINCT "contains_id" FROM "packaging_relations")
)
SELECT DISTINCT
       tp."name"       AS top_container,
       ip."name"       AS contained_item,
       agg."total_qty"
FROM   agg
JOIN   top_lvl     ON top_lvl.top_id = agg."parent_id"
JOIN   "packaging" AS tp ON tp."id"  = agg."parent_id"
JOIN   "packaging" AS ip ON ip."id"  = agg."item_id"
WHERE  agg."total_qty" > 500
ORDER  BY tp."name", ip."name";
```

