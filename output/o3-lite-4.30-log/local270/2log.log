-- 10) FINAL answer – bring everything together, no LIMIT
--     Shows every top‑level container having at least one item whose
--     summed nested quantity exceeds 500, plus that item’s name & qty
WITH RECURSIVE r(parent_id, item_id, tot_qty) AS (
    SELECT pr."packaging_id", pr."contains_id", pr."qty" * 1.0
    FROM   "packaging_relations" pr
    UNION ALL
    SELECT r."parent_id", pr2."contains_id", r."tot_qty" * pr2."qty"
    FROM   r
    JOIN   "packaging_relations" pr2
           ON pr2."packaging_id" = r."item_id"
),
agg AS (
    SELECT r."parent_id",
           r."item_id",
           SUM(r."tot_qty") AS total_qty
    FROM   r
    GROUP BY r."parent_id", r."item_id"
),
top_lvl AS (
    SELECT "id" AS top_id
    FROM   "packaging"
    WHERE  "id" NOT IN (SELECT DISTINCT "contains_id" FROM "packaging_relations")
)
SELECT DISTINCT
       tp."name"       AS top_container,
       ip."name"       AS contained_item,
       agg."total_qty"
FROM   agg
JOIN   top_lvl     ON top_lvl.top_id = agg."parent_id"
JOIN   "packaging" AS tp ON tp."id"  = agg."parent_id"
JOIN   "packaging" AS ip ON ip."id"  = agg."item_id"
WHERE  agg."total_qty" > 500
ORDER  BY tp."name", ip."name";
