```sql
--Description:  
--We need the names of every “top‑level” packaging container (a parent package that never
--appears as someone else’s child) that contains, directly or through nested packages,
--any item whose overall quantity inside one such container is greater than 500.  
--The strategy inside one WITH‑RECURSIVE statement is:  
-- 1) top_packages – pick ids that are packaging_id but not contains_id.  
-- 2) hier         – starting from each top package, walk down packaging_relations,
--                   multiplying the qty values at each hop so that path_qty represents
--                   the number of descendant items in ONE top‑package.  
-- 3) totals       – aggregate all paths to get the total quantity per (top_pkg, item)
--                   and keep only those totals above 500.  
-- 4) names        – union of packaging and products lets us resolve human‑readable
--                   names for any id we encounter (because children might be bottles
--                   defined in packaging or finished products defined in products).  
--The final SELECT returns the container name, item name, and total quantity.
WITH RECURSIVE
top_packages AS (
    SELECT DISTINCT packaging_id
    FROM packaging_relations
    WHERE packaging_id NOT IN (SELECT contains_id FROM packaging_relations)
),
hier AS (
    --seed: direct children of each top‑level package
    SELECT tp.packaging_id AS top_id,
           pr.contains_id  AS item_id,
           pr.qty          AS path_qty
    FROM top_packages tp
    JOIN packaging_relations pr
      ON pr.packaging_id = tp.packaging_id
    UNION ALL
    --recurse: if an item is itself a package, keep descending and multiply qty’s
    SELECT h.top_id,
           pr.contains_id,
           h.path_qty * pr.qty
    FROM hier h
    JOIN packaging_relations pr
      ON pr.packaging_id = h.item_id
),
totals AS (
    SELECT top_id,
           item_id,
           SUM(path_qty) AS total_qty
    FROM hier
    GROUP BY top_id, item_id
    HAVING total_qty > 500
),
names AS (
    SELECT id, name FROM packaging
    UNION
    SELECT id, name FROM products
)
SELECT  p_top.name  AS top_container,
        n_item.name AS item_name,
        t.total_qty
FROM totals t
JOIN packaging p_top ON p_top.id = t.top_id
JOIN names n_item    ON n_item.id = t.item_id
ORDER BY p_top.name, n_item.name;
```
