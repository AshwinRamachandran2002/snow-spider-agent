Relevant columns and their potential usage

GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES  
• "repo_name":  repository‑id – used to join to LANGUAGES and to SAMPLE_CONTENTS  
• "path":        full file path – filter for 'README.md' (or case variants)  
• "id":          blob SHA – join key to "id" in SAMPLE_CONTENTS to obtain the file body  
• "ref":         branch / tag – normally ‘refs/heads/master’, not strictly needed here  
• "mode":        unix permissions – not required for this task  
• "symlink_target":  only needed if README is a symlink (skip when NULL)

GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  
• "id":              blob SHA – joins to SAMPLE_FILES."id"  
• "content":         complete file text – split into individual lines and strip blanks / comments  
• "binary":          boolean – exclude binary blobs (binary = TRUE)  
• "sample_repo_name": repo id duplicate – alternative to SAMPLE_FILES."repo_name"  
• "sample_path":     duplicate of file path – alternative to SAMPLE_FILES."path"

GITHUB_REPOS.GITHUB_REPOS.LANGUAGES  
• "repo_name":  repository‑id – join to SAMPLE_FILES."repo_name"  
• "language":   JSON/VARIANT list of language names – explode & aggregate into CSV



10 exploratory Snowflake SQL queries
(each returns ≤ 20 rows, all identifiers in double quotes)

```sql
-- 1.  Peek at files that look like README.md (case‑insensitive)  
SELECT  "repo_name",
        "path",
        "id"
FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE   LOWER("path") LIKE '%readme.md'
LIMIT 20;
```

```sql
-- 2.  Verify that those README candidates really exist in SAMPLE_CONTENTS  
SELECT  f."repo_name",
        f."path",
        c."size",
        c."binary"
FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  f
JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
          ON c."id" = f."id"
WHERE   LOWER(f."path") LIKE '%readme.md'
  AND   c."binary" = FALSE
LIMIT 20;
```

```sql
-- 3.  Pull one README’s raw content to inspect line structure  
SELECT  c."content"
FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" f
          ON c."id" = f."id"
WHERE   LOWER(f."path") LIKE '%readme.md'
  AND   c."binary" = FALSE
LIMIT 20;          -- each row is a full README blob
```

```sql
-- 4.  Split README blobs into individual lines (first repository only)  
SELECT  f."repo_name",
        l.value::STRING  AS "readme_line"
FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" f
          ON c."id" = f."id"
     ,  LATERAL SPLIT_TO_TABLE(c."content", '\n') l      -- line‑by‑line
WHERE   LOWER(f."path") LIKE '%readme.md'
  AND   f."repo_name" = (SELECT MIN("repo_name") 
                         FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
                         WHERE LOWER("path") LIKE '%readme.md')
LIMIT 20;
```

```sql
-- 5.  Filter out empty lines and Markdown or code comments  
SELECT  l.value::STRING AS "clean_line"
FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" f
          ON c."id" = f."id"
     ,  LATERAL SPLIT_TO_TABLE(c."content", '\n') l
WHERE   LOWER(f."path") LIKE '%readme.md'
  AND   c."binary" = FALSE
  AND   REGEXP_LIKE(TRIM(l.value), '^[#/]') = FALSE   -- rejects '#' or '//' lines
  AND   TRIM(l.value) <> ''
LIMIT 20;
```

```sql
-- 6.  Count how many times each cleaned line appears (sample set)  
SELECT  TRIM(l.value)                             AS "clean_line",
        COUNT(*)                                  AS "occurrences"
FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" f
          ON c."id" = f."id"
     ,  LATERAL SPLIT_TO_TABLE(c."content", '\n') l
WHERE   LOWER(f."path") LIKE '%readme.md'
  AND   c."binary" = FALSE
  AND   REGEXP_LIKE(TRIM(l.value), '^[#/]') = FALSE
  AND   TRIM(l.value) <> ''
GROUP BY 1
ORDER BY "occurrences" DESC
LIMIT 20;
```

```sql
-- 7.  Find languages used by each repository (one repo sample)  
SELECT  "repo_name",
        ARRAY_TO_STRING(ARRAY_AGG(DISTINCT value::STRING ORDER BY value::STRING), ',') 
        AS "languages_csv"
FROM    "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" lg
     ,  LATERAL FLATTEN(input => lg."language") lf
WHERE   lg."repo_name" = (SELECT MIN("repo_name") FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES")
GROUP BY "repo_name"
LIMIT 20;
```

```sql
-- 8.  Combine lines with the repo in which they appear  
SELECT  DISTINCT
        f."repo_name",
        TRIM(l.value)  AS "clean_line"
FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" f
          ON c."id" = f."id"
     ,  LATERAL SPLIT_TO_TABLE(c."content", '\n') l
WHERE   LOWER(f."path") LIKE '%readme.md'
  AND   c."binary" = FALSE
  AND   REGEXP_LIKE(TRIM(l.value), '^[#/]') = FALSE
  AND   TRIM(l.value) <> ''
LIMIT 20;
```

```sql
-- 9.  Map each unique line to the languages used by repos containing it  
SELECT  ln."clean_line",
        ARRAY_TO_STRING(
            ARRAY_AGG(DISTINCT lg_lang.value::STRING ORDER BY lg_lang.value::STRING), ','
        ) AS "languages_csv"
FROM   ( /* lines‑per‑repo */ 
        SELECT  DISTINCT
                f."repo_name",
                TRIM(l.value) AS "clean_line"
        FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
        JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" f
                  ON c."id" = f."id"
             ,  LATERAL SPLIT_TO_TABLE(c."content", '\n') l
        WHERE   LOWER(f."path") LIKE '%readme.md'
          AND   c."binary" = FALSE
          AND   REGEXP_LIKE(TRIM(l.value), '^[#/]') = FALSE
          AND   TRIM(l.value) <> ''
      ) ln
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" lg
        ON lg."repo_name" = ln."repo_name"
     , LATERAL FLATTEN(input => lg."language") lg_lang
GROUP BY ln."clean_line"
LIMIT 20;
```

```sql
-- 10.  Full solution pattern: frequency, languages CSV, ordered by frequency desc  
SELECT  ln."clean_line",
        COUNT(DISTINCT ln."repo_name")                         AS "repo_count",
        ARRAY_TO_STRING(
            ARRAY_AGG(DISTINCT lg_lang.value::STRING ORDER BY lg_lang.value::STRING),
            ','
        )                                                      AS "languages_csv"
FROM   (  -- derive non‑empty, non‑comment lines per repo  
        SELECT  DISTINCT
                f."repo_name",
                TRIM(l.value) AS "clean_line"
        FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
        JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" f
                  ON c."id" = f."id"
             ,  LATERAL SPLIT_TO_TABLE(c."content", '\n') l
        WHERE   LOWER(f."path") LIKE '%readme.md'
          AND   c."binary" = FALSE
          AND   REGEXP_LIKE(TRIM(l.value), '^[#/]') = FALSE
          AND   TRIM(l.value) <> ''
      ) ln
JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" lg
          ON lg."repo_name" = ln."repo_name"
     ,    LATERAL FLATTEN(input => lg."language") lg_lang
GROUP BY ln."clean_line"
ORDER BY "repo_count" DESC
LIMIT 20;
```



Explanation  
• Queries 1‑3 inspect README candidates and their raw contents.  
• Queries 4‑6 demonstrate line splitting, cleaning, and frequency counting.  
• Query 7 shows how to turn the VARIANT language array into a comma‑separated list.  
• Queries 8‑10 gradually combine everything: link cleaned lines to their repositories, attach languages, aggregate, and finally rank by how many repositories share the same line, returning the languages in alphabetic CSV format.
