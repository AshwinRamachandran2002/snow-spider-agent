```sql
--Description: Filter non‑empty, non‑comment lines out of the first non‑binary
--             README.md we can find and show 20 such cleaned lines.
WITH first_readme AS (
    SELECT  f."id", f."repo_name"
    FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"      f
    JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"   c
           ON c."id" = f."id"  AND c."binary" = FALSE
    WHERE   LOWER(f."path") LIKE '%readme.md'
    ORDER BY f."repo_name"
    LIMIT 1
)
SELECT  fr."repo_name",
        TRIM(l.value)::STRING AS "clean_line"
FROM    first_readme                                      fr
JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"   c
       ON c."id" = fr."id",
     LATERAL SPLIT_TO_TABLE(c."content", '\n')            l
WHERE   TRIM(l.value) <> ''
  AND   REGEXP_LIKE(TRIM(l.value), '^[#/]|^//') = FALSE
LIMIT 20;
```

```sql
--Description: Count how many times each cleaned line appears across ALL
--             non‑binary README.md files.  Show the 20 most common lines.
WITH clean_lines AS (
    SELECT  DISTINCT
            f."repo_name",
            TRIM(l.value) AS "line"
    FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"      f
    JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"   c
           ON c."id" = f."id" AND c."binary" = FALSE,
         LATERAL SPLIT_TO_TABLE(c."content", '\n')            l
    WHERE   LOWER(f."path") LIKE '%readme.md'
      AND   TRIM(l.value) <> ''
      AND   REGEXP_LIKE(TRIM(l.value), '^[#/]|^//') = FALSE
)
SELECT  "line"    AS "clean_line",
        COUNT(*)  AS "occurrences"
FROM    clean_lines
GROUP BY "line"
ORDER BY "occurrences" DESC
LIMIT 20;
```

```sql
--Description: Show a comma‑separated list of languages for the alphabetically
--             first repository that actually has at least one language entry.
WITH repo_with_lang AS (
    SELECT  DISTINCT lg."repo_name"
    FROM    "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" lg,
            LATERAL FLATTEN(input => lg."language") lf
    WHERE   lf.value IS NOT NULL
    ORDER BY lg."repo_name"
    LIMIT 1
)
SELECT  lg."repo_name",
        ARRAY_TO_STRING(
            ARRAY_AGG(DISTINCT lf.value::STRING ORDER BY lf.value::STRING),
            ','
        ) AS "languages_csv"
FROM    repo_with_lang r
JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" lg
          ON lg."repo_name" = r."repo_name",
        LATERAL FLATTEN(input => lg."language") lf
GROUP BY lg."repo_name"
LIMIT 20;
```

```sql
--Description: List (repo, line) pairs for the first non‑binary README after
--             removing blank lines and lines beginning with '#' or '//'.
WITH first_readme AS (
    SELECT  f."id", f."repo_name"
    FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"      f
    JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"   c
           ON c."id" = f."id"  AND c."binary" = FALSE
    WHERE   LOWER(f."path") LIKE '%readme.md'
    ORDER BY f."repo_name"
    LIMIT 1
)
SELECT  fr."repo_name",
        TRIM(l.value) AS "clean_line"
FROM    first_readme                                      fr
JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"   c
       ON c."id" = fr."id",
     LATERAL SPLIT_TO_TABLE(c."content", '\n')            l
WHERE   TRIM(l.value) <> ''
  AND   REGEXP_LIKE(TRIM(l.value), '^[#/]|^//') = FALSE
LIMIT 20;
```

```sql
--Description: For the 20 most frequent cleaned README lines, list the
--             distinct languages (alphabetically) used by repos containing
--             each line.
WITH lines_per_repo AS (
    SELECT  DISTINCT
            f."repo_name",
            TRIM(l.value) AS "clean_line"
    FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"      f
    JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"   c
           ON c."id" = f."id"  AND c."binary" = FALSE,
         LATERAL SPLIT_TO_TABLE(c."content", '\n')            l
    WHERE   LOWER(f."path") LIKE '%readme.md'
      AND   TRIM(l.value) <> ''
      AND   REGEXP_LIKE(TRIM(l.value), '^[#/]|^//') = FALSE
), top_lines AS (
    SELECT  "clean_line",
            COUNT(*) AS repo_cnt
    FROM    lines_per_repo
    GROUP BY "clean_line"
    ORDER BY repo_cnt DESC
    LIMIT 20
)
SELECT  tl."clean_line",
        ARRAY_TO_STRING(
            ARRAY_AGG(DISTINCT lf.value::STRING ORDER BY lf.value::STRING),
            ','
        ) AS "languages_csv"
FROM     top_lines tl
JOIN     lines_per_repo lr          ON lr."clean_line" = tl."clean_line"
JOIN     "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" lg
           ON lg."repo_name" = lr."repo_name",
         LATERAL FLATTEN(input => lg."language") lf
GROUP BY tl."clean_line";
```

```sql
--Description: Full solution – across all non‑binary README.md files, compute
--             how many repositories contain each non‑comment, non‑empty line,
--             and list the distinct languages used by those repositories.
WITH lines_per_repo AS (
    SELECT  DISTINCT
            f."repo_name",
            TRIM(l.value) AS "clean_line"
    FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"      f
    JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"   c
           ON c."id" = f."id"  AND c."binary" = FALSE,
         LATERAL SPLIT_TO_TABLE(c."content", '\n')            l
    WHERE   LOWER(f."path") LIKE '%readme.md'
      AND   TRIM(l.value) <> ''
      AND   REGEXP_LIKE(TRIM(l.value), '^[#/]|^//') = FALSE
)
SELECT  lr."clean_line",
        COUNT(DISTINCT lr."repo_name") AS "repo_count",
        ARRAY_TO_STRING(
            ARRAY_AGG(DISTINCT lf.value::STRING ORDER BY lf.value::STRING),
            ','
        ) AS "languages_csv"
FROM     lines_per_repo lr
JOIN     "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" lg
           ON lg."repo_name" = lr."repo_name",
         LATERAL FLATTEN(input => lg."language") lf
GROUP BY lr."clean_line"
ORDER BY "repo_count" DESC
LIMIT 20;
```
