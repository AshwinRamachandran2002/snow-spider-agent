Relevant columns and potential usage  
• SAMPLE_FILES."path": locate README.md files (`ILIKE '%README.md'`).  
• SAMPLE_FILES."id": join key to SAMPLE_CONTENTS."id" to fetch the file body.  
• SAMPLE_FILES."repo_name": identify the repository; join to LANGUAGES and to aggregate repos per line.  
• SAMPLE_CONTENTS."content": full text of each file—split into individual lines.  
• LANGUAGES."language": JSON/ARRAY containing the programming languages used by the repo; flattened when needed.

Typical conditions  
• "path" ILIKE '%README.md' – restrict to README files.  
• TRIM(line) <> '' – omit blank lines.  
• line NOT ILIKE '#%' AND line NOT ILIKE '//%' – skip Markdown or code comments.  

Below are ten exploratory Snowflake SQL queries (each shows only the first 20 rows).  
All identifiers are wrapped in double quotes.

```sql
-- 1. Description: Show a sample of README‑type paths.
SELECT DISTINCT "repo_name",
       "path"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%README.md'
LIMIT 20;
```

```sql
-- 2. Description: Retrieve the content and size of one random README file.
SELECT sf."repo_name",
       sc."size",
       sc."content"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  sf
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" sc
  ON sc."id" = sf."id"
WHERE sf."path" ILIKE '%README.md'
LIMIT 20;
```

```sql
-- 3. Description: Count how many README.md files each repository owns.
SELECT sf."repo_name",
       COUNT(*) AS "readme_count"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" sf
WHERE sf."path" ILIKE '%README.md'
GROUP BY sf."repo_name"
ORDER BY "readme_count" DESC
LIMIT 20;
```

```sql
-- 4. Description: Inspect the raw value stored in LANGUAGES for a few repos.
SELECT "repo_name",
       "language"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"
LIMIT 20;
```

```sql
-- 5. Description: Flatten the language array into individual rows.
SELECT l."repo_name",
       lang.value::STRING AS "language_name"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" l,
     LATERAL FLATTEN(INPUT => l."language") lang
LIMIT 20;
```

```sql
-- 6. Description: Break a README file into individual trimmed lines.
SELECT sc."sample_repo_name",
       TRIM(line.value) AS "readme_line"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" sc,
     LATERAL SPLIT_TO_TABLE(sc."content", '\n') line
WHERE sc."sample_path" ILIKE '%README.md'
  AND line.index < 20          -- just limit per file for demo
LIMIT 20;
```

```sql
-- 7. Description: Show non‑empty, non‑comment lines extracted from README files.
SELECT TRIM(line.value) AS "clean_line"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" sc,
     LATERAL SPLIT_TO_TABLE(sc."content", '\n') line
WHERE sc."sample_path" ILIKE '%README.md'
  AND TRIM(line.value) <> ''
  AND TRIM(line.value) NOT ILIKE '#%'
  AND TRIM(line.value) NOT ILIKE '//%'
LIMIT 20;
```

```sql
-- 8. Description: Count how many distinct repositories contain each clean line.
WITH lines AS (
  SELECT sc."sample_repo_name"      AS repo,
         TRIM(line.value)           AS line_text
  FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" sc,
       LATERAL SPLIT_TO_TABLE(sc."content", '\n') line
  WHERE sc."sample_path" ILIKE '%README.md'
    AND TRIM(line.value) <> ''
    AND TRIM(line.value) NOT ILIKE '#%'
    AND TRIM(line.value) NOT ILIKE '//%'
)
SELECT line_text,
       COUNT(DISTINCT repo) AS repo_occurrences
FROM lines
GROUP BY line_text
ORDER BY repo_occurrences DESC
LIMIT 20;
```

```sql
-- 9. Description: Attach language information to each (repo, line) pair.
WITH lines AS (
  SELECT sc."sample_repo_name"      AS repo,
         TRIM(line.value)           AS line_text
  FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" sc,
       LATERAL SPLIT_TO_TABLE(sc."content", '\n') line
  WHERE sc."sample_path" ILIKE '%README.md'
    AND TRIM(line.value) <> ''
    AND TRIM(line.value) NOT ILIKE '#%'
    AND TRIM(line.value) NOT ILIKE '//%'
)
SELECT ln.line_text,
       lrepo."language"
FROM lines ln
LEFT JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" lrepo
  ON lrepo."repo_name" = ln.repo
LIMIT 20;
```

```sql
-- 10. Description: Final assembly – frequency of each line plus comma‑separated sorted languages used in repos that contain that line.
WITH lines AS (
  SELECT sc."sample_repo_name"      AS repo,
         TRIM(line.value)           AS line_text
  FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" sc,
       LATERAL SPLIT_TO_TABLE(sc."content", '\n') line
  WHERE sc."sample_path" ILIKE '%README.md'
    AND TRIM(line.value) <> ''
    AND TRIM(line.value) NOT ILIKE '#%'
    AND TRIM(line.value) NOT ILIKE '//%'
),
lang_flat AS (
  SELECT l."repo_name",
         lf.value::STRING AS lang_name
  FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" l,
       LATERAL FLATTEN(INPUT => l."language") lf
)
SELECT ln.line_text,
       COUNT(DISTINCT ln.repo)                                     AS line_frequency,
       LISTAGG(DISTINCT lang_flat.lang_name, ','
                ORDER BY lang_flat.lang_name)                      AS languages
FROM lines ln
LEFT JOIN lang_flat
  ON lang_flat."repo_name" = ln.repo
GROUP BY ln.line_text
ORDER BY line_frequency DESC
LIMIT 20;
```
