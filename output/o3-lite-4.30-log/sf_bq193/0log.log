Query:
--Description: Build frequency & language list for every distinct, non‑comment README.md line.
WITH readme_lines AS (
    SELECT DISTINCT
           sf."repo_name",
           TRIM(f.value::STRING) AS "line"
    FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES    sf
    JOIN   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS sc
           ON sf."id" = sc."id"
    CROSS JOIN LATERAL FLATTEN(INPUT => SPLIT(sc."content", '\n')) f
    WHERE  sf."path" ILIKE '%README.md'
      AND  sc."binary" = FALSE
      AND  TRIM(f.value::STRING) <> ''
      AND  NOT TRIM(f.value::STRING) ILIKE '#%'
      AND  NOT TRIM(f.value::STRING) ILIKE '//%'
),
repo_langs AS (
    SELECT
        l."repo_name",
        COALESCE(fl.KEY::STRING, fl.VALUE::STRING) AS "language"
    FROM   GITHUB_REPOS.GITHUB_REPOS.LANGUAGES l
    ,      LATERAL FLATTEN(INPUT => l."language") fl
)
SELECT
    rl."line",
    COUNT(DISTINCT rl."repo_name")                                         AS "frequency",
    LISTAGG(DISTINCT rl_lang."language", ',') WITHIN GROUP (ORDER BY rl_lang."language") AS "languages"
FROM   readme_lines rl
LEFT  JOIN repo_langs rl_lang
       ON rl."repo_name" = rl_lang."repo_name"
GROUP BY rl."line"
ORDER BY "frequency" DESC
LIMIT 20
