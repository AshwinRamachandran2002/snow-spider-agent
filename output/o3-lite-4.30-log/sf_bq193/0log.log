```sql
--Description: For every distinct, non‑empty, non‑comment line found in textual
--             README.md files, count how many different repositories contain the
--             line and return a comma‑separated, alphabetical list of all
--             programming languages used in those repositories.
--Steps
-- 1. readme_lines  : explode every README.md (non‑binary) into individual lines,
--                    keeping only lines that are not blank and don’t begin with
--                    “#” or “//”.
-- 2. repo_langs    : normalise the LANGUAGES table so we have one row per
--                    (repo_name, language).  The VARIANT column can be an array
--                    or an object; FLATTEN gives both KEY (for objects) and
--                    VALUE (for arrays).  We coalesce KEY and VALUE to get the
--                    language name.
-- 3. Final SELECT  : join readme_lines to repo_langs, aggregate by line,
--                    count distinct repos, and LISTAGG distinct languages in
--                    alphabetical order.  Sort by frequency descending.
WITH readme_lines AS (
    SELECT DISTINCT
           sf."repo_name",
           TRIM(f.value::STRING) AS "line"
    FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES    sf
    JOIN   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS sc
           ON sf."id" = sc."id"
    CROSS JOIN LATERAL FLATTEN(INPUT => SPLIT(sc."content", '\n')) f
    WHERE  sf."path" ILIKE '%README.md'      -- README files
      AND  sc."binary" = FALSE               -- exclude binary blobs
      AND  TRIM(f.value::STRING) <> ''       -- non‑blank lines
      AND  NOT TRIM(f.value::STRING) ILIKE '#%'   -- skip Markdown comments/headers
      AND  NOT TRIM(f.value::STRING) ILIKE '//%'  -- skip code comments
),
repo_langs AS (
    SELECT
        l."repo_name",
        COALESCE(fl.KEY::STRING, fl.VALUE::STRING) AS "language"
    FROM   GITHUB_REPOS.GITHUB_REPOS.LANGUAGES l
    ,      LATERAL FLATTEN(INPUT => l."language") fl
)
SELECT
    rl."line",
    COUNT(DISTINCT rl."repo_name")                                         AS "frequency",
    LISTAGG(DISTINCT rl_lang."language", ',') 
        WITHIN GROUP (ORDER BY rl_lang."language")                         AS "languages"
FROM   readme_lines rl
LEFT  JOIN repo_langs rl_lang
       ON rl."repo_name" = rl_lang."repo_name"
GROUP BY rl."line"
ORDER BY "frequency" DESC
LIMIT 100;
```
