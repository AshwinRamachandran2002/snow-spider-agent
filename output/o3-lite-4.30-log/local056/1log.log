```sql
--Description:
-- Objective: identify the customer whose payments show the largest average absolute month‑to‑month change
--            and output that customer’s full name.
-- Strategy:
--   1) “monthly”  : roll every customer’s payments up to calendar months (YYYY‑MM) and sum the amounts.
--   2) “diffs”    : for each customer apply LAG to compute the difference between consecutive months.
--   3) “avg_diff” : average the absolute value of those differences per customer.
--   4) Final step : join to the customer table, order by the average change descending, keep the top row.
WITH monthly AS (
    SELECT customer_id,
           strftime('%Y-%m', payment_date) AS year_month,
           SUM(amount)                     AS month_total
    FROM payment
    GROUP BY customer_id, year_month
),
diffs AS (
    SELECT customer_id,
           month_total
             - LAG(month_total) OVER (PARTITION BY customer_id
                                      ORDER BY year_month)       AS diff_amt
    FROM monthly
),
avg_diff AS (
    SELECT customer_id,
           AVG(ABS(diff_amt)) AS avg_monthly_change
    FROM diffs
    WHERE diff_amt IS NOT NULL          -- exclude the first month per customer
    GROUP BY customer_id
)
SELECT c.first_name || ' ' || c.last_name AS full_name
FROM avg_diff ad
JOIN customer  c ON c.customer_id = ad.customer_id
ORDER BY ad.avg_monthly_change DESC
LIMIT 1;
```
