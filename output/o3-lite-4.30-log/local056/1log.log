Begin Exploring Related Columns
Relevant tables / columns and how they will be used  

payment  
• customer_id : tie every payment to a customer  
• amount      : money paid in this payment – the metric to analyse  
• payment_date: when the payment was made – needed to build year‑month buckets  

customer  
• customer_id : join key to payment  
• first_name / last_name : build the customer full name to report in the final step  

Typical predicates / conditions that will be used  
• “group by strftime('%Y‑%m', payment_date)” – to aggregate amounts per calendar month  
• “WHERE customer_id = … ” – when exploring one customer first  
• “LAG(sum_amount) OVER ( … ORDER BY year_month )” – to compute the change from one month to the next  
• “ORDER BY avg_monthly_change DESC LIMIT 1” – to get the customer with the highest average monthly change  


Exploratory → final SQL queries  
(each query limited to 20 rows to keep the result small)

```sql
-- 1. Quick look at the raw payments
SELECT * 
FROM payment 
LIMIT 20;
```

```sql
-- 2. Distinct ‘YYYY‑MM’ values that exist in payment_date
SELECT DISTINCT strftime('%Y-%m', payment_date) AS year_month
FROM payment
ORDER BY year_month
LIMIT 20;
```

```sql
-- 3. Count of payments each customer has made (top 20)
SELECT customer_id,
       COUNT(*) AS payment_cnt
FROM payment
GROUP BY customer_id
ORDER BY payment_cnt DESC
LIMIT 20;
```

```sql
-- 4. Monthly total amount for a single sample customer (id = 1)
SELECT strftime('%Y-%m', payment_date) AS year_month,
       SUM(amount)                    AS month_total
FROM payment
WHERE customer_id = 1
GROUP BY year_month
ORDER BY year_month
LIMIT 20;
```

```sql
-- 5. Month‑to‑month change for that same customer (id = 1)
WITH cte AS (
    SELECT strftime('%Y-%m', payment_date) AS year_month,
           SUM(amount)                    AS month_total
    FROM payment
    WHERE customer_id = 1
    GROUP BY year_month
)
SELECT year_month,
       month_total,
       month_total - LAG(month_total) OVER(ORDER BY year_month) AS change_from_prev
FROM cte
ORDER BY year_month
LIMIT 20;
```

```sql
-- 6. Average monthly change for that customer (id = 1)
WITH monthly AS (
    SELECT strftime('%Y-%m', payment_date) AS year_month,
           SUM(amount) AS month_total
    FROM payment
    WHERE customer_id = 1
    GROUP BY year_month
), diffs AS (
    SELECT month_total - LAG(month_total) OVER(ORDER BY year_month) AS diff_amt
    FROM monthly
    WHERE LAG(month_total) OVER(ORDER BY year_month) IS NOT NULL
)
SELECT AVG(ABS(diff_amt)) AS avg_monthly_change
FROM diffs;
```

```sql
-- 7. Monthly totals for EVERY customer
SELECT customer_id,
       strftime('%Y-%m', payment_date) AS year_month,
       SUM(amount)                    AS month_total
FROM payment
GROUP BY customer_id, year_month
ORDER BY customer_id, year_month
LIMIT 20;
```

```sql
-- 8. Month‑to‑month change for every customer (first 20 rows)
WITH monthly AS (
    SELECT customer_id,
           strftime('%Y-%m', payment_date) AS year_month,
           SUM(amount)                    AS month_total
    FROM payment
    GROUP BY customer_id, year_month
)
SELECT customer_id,
       year_month,
       month_total,
       month_total - LAG(month_total) OVER(PARTITION BY customer_id 
                                           ORDER BY year_month) AS change_from_prev
FROM monthly
WHERE LAG(month_total) OVER(PARTITION BY customer_id ORDER BY year_month) IS NOT NULL
LIMIT 20;
```

```sql
-- 9. Average monthly change for each customer
WITH monthly AS (
    SELECT customer_id,
           strftime('%Y-%m', payment_date) AS year_month,
           SUM(amount)                    AS month_total
    FROM payment
    GROUP BY customer_id, year_month
), diffs AS (
    SELECT customer_id,
           month_total - LAG(month_total) OVER(PARTITION BY customer_id 
                                               ORDER BY year_month) AS diff_amt
    FROM monthly
)
SELECT customer_id,
       AVG(ABS(diff_amt)) AS avg_monthly_change
FROM diffs
WHERE diff_amt IS NOT NULL
GROUP BY customer_id
ORDER BY avg_monthly_change DESC
LIMIT 20;
```

```sql
-- 10. Customer(s) with the highest average monthly change – full name shown
WITH monthly AS (
    SELECT customer_id,
           strftime('%Y-%m', payment_date) AS year_month,
           SUM(amount) AS month_total
    FROM payment
    GROUP BY customer_id, year_month
), diffs AS (
    SELECT customer_id,
           month_total - LAG(month_total) OVER(PARTITION BY customer_id 
                                               ORDER BY year_month) AS diff_amt
    FROM monthly
), avg_change AS (
    SELECT customer_id,
           AVG(ABS(diff_amt)) AS avg_monthly_change
    FROM diffs
    WHERE diff_amt IS NOT NULL
    GROUP BY customer_id
)
SELECT c.first_name || ' ' || c.last_name AS full_name
FROM avg_change ac
JOIN customer c ON c.customer_id = ac.customer_id
ORDER BY ac.avg_monthly_change DESC
LIMIT 1;
```
Each successive query builds understanding, culminating in the final query that returns the customer whose payment pattern shows the greatest average month‑to‑month change.
