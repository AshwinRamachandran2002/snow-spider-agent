    SELECT customer_id,
           year_month,
           month_total,
           month_total - LAG(month_total) OVER (PARTITION BY customer_id
                                                ORDER BY year_month) AS change_from_prev
    FROM monthly
)
SELECT customer_id,
       year_month,
       month_total,
       change_from_prev
FROM diffs
WHERE change_from_prev IS NOT NULL
LIMIT 20
