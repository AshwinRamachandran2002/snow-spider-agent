-- 10. Final query: Champion for every season (20 rows sample) with team, league & country
WITH match_points AS (
    SELECT "season", "league_id", "home_team_api_id" AS "team_api_id",
           CASE
             WHEN "home_team_goal" > "away_team_goal" THEN 3
             WHEN "home_team_goal" = "away_team_goal" THEN 1
             ELSE 0
           END AS "points"
    FROM "Match"
    UNION ALL
    SELECT "season", "league_id", "away_team_api_id",
           CASE
             WHEN "away_team_goal" > "home_team_goal" THEN 3
             WHEN "home_team_goal" = "away_team_goal" THEN 1
             ELSE 0
           END
    FROM "Match"
), team_season_points AS (
    SELECT "season", "league_id", "team_api_id",
           SUM("points") AS "total_points"
    FROM match_points
    GROUP BY "season", "league_id", "team_api_id"
), champions AS (
    SELECT tsp.*
    FROM team_season_points AS tsp
    JOIN (
        SELECT "season", "league_id",
               MAX("total_points") AS "max_points"
        FROM team_season_points
        GROUP BY "season", "league_id"
    ) AS mx
      ON tsp."season"      = mx."season"
     AND tsp."league_id"   = mx."league_id"
     AND tsp."total_points"= mx."max_points"
)
SELECT   "Country"."name"      AS "country",
         "League"."name"       AS "league",
         "Team"."team_long_name" AS "champion_team",
         champions."season",
         champions."total_points"
FROM champions
JOIN "League"  ON "League"."id"        = champions."league_id"
JOIN "Country" ON "Country"."id"       = "League"."country_id"
JOIN "Team"    ON "Team"."team_api_id" = champions."team_api_id"
ORDER BY champions."season", "league"
LIMIT 20;
