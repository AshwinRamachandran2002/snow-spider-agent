Begin Exploring Related Columns
Relevant tables & columns  
• Match  
  – "season": season of the match (needed to group points by season)  
  – "league_id": FK → League (to know the league)  
  – "country_id": FK → Country (to know the country)  
  – "home_team_api_id", "away_team_api_id": FK → Team (to know the team)  
  – "home_team_goal", "away_team_goal": result of the match (to compute win / draw / loss)  

• Team  
  – "team_api_id": PK referenced by Match (to join)  
  – "team_long_name": full team name to be returned as champion  

• League  
  – "id": PK referenced by Match (to join)  
  – "name": league name to be returned  

• Country  
  – "id": PK referenced by Match (to join)  
  – "name": country name to be returned  

Key conditions / joins you will eventually need  
1. Match.home_team_api_id  = Team.team_api_id  
2. Match.away_team_api_id  = Team.team_api_id  
3. Match.league_id         = League.id  
4. Match.country_id        = Country.id  
5. Filter out matches where home_team_goal or away_team_goal is NULL when computing points.  

Below are 10 progressive exploratory SQL queries (each limited to 20 rows) that move from simple inspection toward a full‑blown champion‑per‑season result.

```sql
-- 1. Description: List all distinct seasons that appear in the data set.
SELECT DISTINCT "season"
FROM "Match"
LIMIT 20;
```

```sql
-- 2. Description: Inspect the list of leagues (id & name).
SELECT DISTINCT "id", "name"
FROM "League"
LIMIT 20;
```

```sql
-- 3. Description: See which country each league belongs to.
SELECT l."id"            AS league_id,
       l."name"          AS league_name,
       c."name"          AS country_name
FROM   "League" AS l
JOIN   "Country" AS c
  ON   l."country_id" = c."id"
LIMIT 20;
```

```sql
-- 4. Description: Look at a handful of matches with their main identifiers and scores.
SELECT "id",
       "season",
       "league_id",
       "home_team_api_id",
       "away_team_api_id",
       "home_team_goal",
       "away_team_goal"
FROM   "Match"
LIMIT 20;
```

```sql
-- 5. Description: Join a match to team names (home & away) to verify the mapping.
SELECT m."id",
       m."season",
       th."team_long_name" AS home_team,
       ta."team_long_name" AS away_team,
       m."home_team_goal",
       m."away_team_goal"
FROM   "Match" AS m
JOIN   "Team"  AS th ON th."team_api_id" = m."home_team_api_id"
JOIN   "Team"  AS ta ON ta."team_api_id" = m."away_team_api_id"
LIMIT 20;
```

```sql
-- 6. Description: Compute the number of points earned by EACH SIDE for the first 20 matches.
SELECT *
FROM (
      /* points for the home side */
      SELECT m."id",
             m."season",
             m."home_team_api_id" AS team_api_id,
             CASE
                 WHEN m."home_team_goal"  > m."away_team_goal" THEN 3
                 WHEN m."home_team_goal"  = m."away_team_goal" THEN 1
                 ELSE 0
             END AS points
      FROM   "Match" AS m
      UNION ALL
      /* points for the away side */
      SELECT m."id",
             m."season",
             m."away_team_api_id" AS team_api_id,
             CASE
                 WHEN m."away_team_goal"  > m."home_team_goal" THEN 3
                 WHEN m."away_team_goal"  = m."home_team_goal" THEN 1
                 ELSE 0
             END AS points
      FROM   "Match" AS m
) AS per_team_per_match
LIMIT 20;
```

```sql
-- 7. Description: Aggregate total points per team PER SEASON inside one league (example league_id = 1729).
SELECT m."season",
       m."league_id",
       pt."team_api_id",
       SUM(pt."points") AS total_points
FROM (
      /* same UNION ALL logic as before */
      SELECT "id",
             "season",
             "league_id",
             "home_team_api_id" AS team_api_id,
             CASE
                 WHEN "home_team_goal" > "away_team_goal" THEN 3
                 WHEN "home_team_goal" = "away_team_goal" THEN 1
                 ELSE 0
             END AS points
      FROM "Match"
      WHERE "league_id" = 1729
      UNION ALL
      SELECT "id",
             "season",
             "league_id",
             "away_team_api_id" AS team_api_id,
             CASE
                 WHEN "away_team_goal" > "home_team_goal" THEN 3
                 WHEN "away_team_goal" = "home_team_goal" THEN 1
                 ELSE 0
             END AS points
      FROM "Match"
      WHERE "league_id" = 1729
) AS pt
JOIN "Match" AS m
  ON m."id" = pt."id"
GROUP BY m."season", m."league_id", pt."team_api_id"
ORDER BY m."season", total_points DESC
LIMIT 20;
```

```sql
-- 8. Description: Pick the champion (team with MAX points) for EACH season in that same league (1729).
WITH season_totals AS (
    /* reuse query #7 but without the example LIMIT */
    SELECT m."season",
           pt."team_api_id",
           SUM(pt."points") AS total_points
    FROM (
          SELECT "id",
                 "season",
                 "league_id",
                 "home_team_api_id" AS team_api_id,
                 CASE
                     WHEN "home_team_goal" > "away_team_goal" THEN 3
                     WHEN "home_team_goal" = "away_team_goal" THEN 1
                     ELSE 0
                 END AS points
          FROM "Match"
          WHERE "league_id" = 1729
          UNION ALL
          SELECT "id",
                 "season",
                 "league_id",
                 "away_team_api_id" AS team_api_id,
                 CASE
                     WHEN "away_team_goal" > "home_team_goal" THEN 3
                     WHEN "away_team_goal" = "home_team_goal" THEN 1
                     ELSE 0
                 END AS points
          FROM "Match"
          WHERE "league_id" = 1729
    ) AS pt
    JOIN "Match" AS m
      ON m."id" = pt."id"
    GROUP BY m."season", pt."team_api_id"
)
SELECT st."season",
       t."team_long_name",
       st."total_points"
FROM   season_totals AS st
JOIN   (
        /* find max points per season */
        SELECT "season", MAX("total_points") AS max_pts
        FROM   season_totals
        GROUP BY "season"
       ) AS mx
  ON st."season" = mx."season"
 AND st."total_points" = mx."max_pts"
JOIN   "Team" AS t
  ON   t."team_api_id" = st."team_api_id"
ORDER BY st."season"
LIMIT 20;
```

```sql
-- 9. Description: Same champion logic but across *all* leagues & countries.
WITH per_team_points AS (
    /* points per match per team over all leagues */
    SELECT "id",
           "season",
           "league_id",
           "country_id",
           "home_team_api_id" AS team_api_id,
           CASE
               WHEN "home_team_goal" > "away_team_goal" THEN 3
               WHEN "home_team_goal" = "away_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
    WHERE "home_team_goal" IS NOT NULL
      AND "away_team_goal" IS NOT NULL
    UNION ALL
    SELECT "id",
           "season",
           "league_id",
           "country_id",
           "away_team_api_id" AS team_api_id,
           CASE
               WHEN "away_team_goal" > "home_team_goal" THEN 3
               WHEN "away_team_goal" = "home_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
    WHERE "home_team_goal" IS NOT NULL
      AND "away_team_goal" IS NOT NULL
),
season_team_totals AS (
    SELECT "season",
           "league_id",
           "country_id",
           team_api_id,
           SUM(points) AS total_points
    FROM   per_team_points
    GROUP BY "season", "league_id", "country_id", team_api_id
),
season_champions AS (
    SELECT s1.*
    FROM   season_team_totals AS s1
    JOIN  (
           SELECT "season",
                  "league_id",
                  MAX(total_points) AS max_pts
           FROM   season_team_totals
           GROUP BY "season", "league_id"
          ) AS s2
      ON  s1."season"    = s2."season"
     AND  s1."league_id" = s2."league_id"
     AND  s1."total_points" = s2."max_pts"
)
SELECT sc."season",
       t."team_long_name" AS champion_team,
       l."name"           AS league_name,
       c."name"           AS country_name,
       sc."total_points"
FROM   season_champions AS sc
JOIN   "Team"   AS t ON t."team_api_id" = sc."team_api_id"
JOIN   "League" AS l ON l."id"          = sc."league_id"
JOIN   "Country" AS c ON c."id"         = sc."country_id"
ORDER  BY sc."season", l."name"
LIMIT 20;
```

```sql
-- 10. Description: Remove the LIMIT and deliver the complete champion-per-season-per-league-per-country result.
WITH per_team_points AS (
    SELECT "id",
           "season",
           "league_id",
           "country_id",
           "home_team_api_id" AS team_api_id,
           CASE
               WHEN "home_team_goal" > "away_team_goal" THEN 3
               WHEN "home_team_goal" = "away_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
    WHERE "home_team_goal" IS NOT NULL
      AND "away_team_goal" IS NOT NULL
    UNION ALL
    SELECT "id",
           "season",
           "league_id",
           "country_id",
           "away_team_api_id" AS team_api_id,
           CASE
               WHEN "away_team_goal" > "home_team_goal" THEN 3
               WHEN "away_team_goal" = "home_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
    WHERE "home_team_goal" IS NOT NULL
      AND "away_team_goal" IS NOT NULL
),
season_team_totals AS (
    SELECT "season",
           "league_id",
           "country_id",
           team_api_id,
           SUM(points) AS total_points
    FROM   per_team_points
    GROUP BY "season", "league_id", "country_id", team_api_id
),
season_champions AS (
    SELECT s1.*
    FROM   season_team_totals AS s1
    JOIN  (
           SELECT "season",
                  "league_id",
                  MAX(total_points) AS max_pts
           FROM   season_team_totals
           GROUP BY "season", "league_id"
          ) AS s2
      ON  s1."season"    = s2."season"
     AND  s1."league_id" = s2."league_id"
     AND  s1."total_points" = s2."max_pts"
)
SELECT sc."season"                       AS season,
       t."team_long_name"                AS champion_team,
       l."name"                          AS league_name,
       c."name"                          AS country_name,
       sc."total_points"                 AS total_points
FROM   season_champions AS sc
JOIN   "Team"    AS t ON t."team_api_id" = sc."team_api_id"
JOIN   "League"  AS l ON l."id"          = sc."league_id"
JOIN   "Country" AS c ON c."id"          = sc."country_id"
ORDER  BY sc."season", l."name";
```
