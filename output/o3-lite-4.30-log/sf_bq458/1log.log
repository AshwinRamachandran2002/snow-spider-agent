/* -----------------------------------------------------------
   Build a unit‑length GloVe‑based vector for every Nature article.
   The query reduces the amount of data early by
   1) removing stop‑words,
   2) collapsing to DISTINCT tokens per article with a count,
   thereby keeping the run time within the warehouse limit.
   -----------------------------------------------------------*/
WITH
/* 1. Explode each article body into raw tokens                */
raw_tokens AS (
    SELECT
        n."id",
        n."date",
        n."title",
        LOWER( REGEXP_REPLACE( t.value::STRING , '[^A-Za-z0-9]' , '' ) ) AS token
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN( INPUT => SPLIT( n."body", ' ' ) ) t
    WHERE t.value IS NOT NULL
),
/* 2. Filter out empty strings and a stop‑word list             */
filtered_tokens AS (
    SELECT *
    FROM raw_tokens
    WHERE token <> ''
      AND token NOT IN (
          'the','of','and','to','a','in','on','for','with','as','by','is','it','its',
          'at','an','be','that','this','are','from','or','was','were','which','we',
          'our','can','such','these','may','not','have','has','had','but','their',
          'they','them','also','using','used','use','between','into','during','after',
          'before','than','other','more','over','been','because','due','all','both'
      )
),
/* 3. Collapse to one row per (article, token) with frequency   */
token_counts AS (
    SELECT
        "id",
        "date",
        "title",
        token,
        COUNT(*)                                            AS token_cnt
    FROM filtered_tokens
    GROUP BY "id","date","title",token
),
/* 4. Join to word frequency and GloVe vector, compute weight   */
token_vectors AS (
    SELECT
        tc."id",
        tc."date",
        tc."title",
        gv."vector"                                         AS glove_vector,
        tc.token_cnt / POWER(wf."frequency", 0.4)           AS weight          -- cnt * (1/f^0.4)
    FROM token_counts tc
    INNER JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS    gv
            ON gv."word" = tc.token
    INNER JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
            ON wf."word" = tc.token
),
/* 5. Multiply each of the 300 vector elements by the weight    */
weighted_components AS (
    SELECT
        tv."id",
        tv."date",
        tv."title",
        vf.index                                            AS idx,          -- 0 .. 299
        vf.value::FLOAT * tv.weight                        AS component
    FROM token_vectors tv,
         LATERAL FLATTEN( INPUT => tv.glove_vector ) vf
),
/* 6. Sum weighted components for every article                 */
article_components AS (
    SELECT
        "id",
        "date",
        "title",
        idx,
        SUM(component)                                     AS component
    FROM weighted_components
    GROUP BY "id","date","title",idx
),
/* 7. Magnitude of each (still un‑normalised) article vector    */
magnitudes AS (
    SELECT
        "id",
        SQRT( SUM(component * component) )                 AS mag
    FROM article_components
    GROUP BY "id"
    HAVING mag > 0
),
/* 8. Normalise and reconstruct as an ordered array             */
normalised_vectors AS (
    SELECT
        ac."id",
        ac."date",
        ac."title",
        ARRAY_AGG( ac.component / m.mag )
            WITHIN GROUP (ORDER BY ac.idx)                 AS normalised_article_vector
    FROM article_components ac
    JOIN magnitudes      m ON m."id" = ac."id"
    GROUP BY ac."id", ac."date", ac."title"
)
SELECT
    "id",
    "date",
    "title",
    normalised_article_vector
FROM normalised_vectors;
