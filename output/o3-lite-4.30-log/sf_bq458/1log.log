Begin Exploring Related Columns
Relevant tables / columns and their potential usage  
• WORD_VECTORS_US.WORD_VECTORS_US.NATURE  
  – "id": unique article identifier, used to join results back to the article  
  – "date": publication date, is one of the requested output columns  
  – "title": article title, is one of the requested output columns  
  – "body": full‑text to be tokenised into individual words  
  – "keywords", "abstract", "category", … : can be helpful to filter or enrich but not strictly required for the vector‐building task  

• WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES  
  – "word": token to be matched with every distinct word in the articles  
  – "frequency": corpus frequency used to compute 1/(frequency^0.4) weighting  

• WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS  
  – "word": token to be matched with each non‑stop‑word token  
  – "vector": VARIANT that holds the 300‑dimensional GloVe embedding to be re‑weighted and summed  

Typical conditions that may later appear  
– WHERE "date" >= '2023‑01‑01' -- restrict to recent Nature papers  
– WHERE "word" = LOWER(<token>) -- exact word lookup in the two auxiliary tables  
– WHERE f.value::STRING NOT IN ('the','of','and', …) -- quick stop‑word filter  

Below are ten illustrative Snowflake SQL snippets, progressing from simple inspection to more elaborate joins.  
(Every identifier is double‑quoted and fully qualified; each query is limited to 20 rows.)

```sql
--Description: 1. Peek at the first 20 article IDs, dates and titles in the Nature table
SELECT 
    "id",
    "date",
    "title"
FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
LIMIT 20;
```

```sql
--Description: 2. Inspect an article’s body text to understand token structure
SELECT 
    "id",
    "title",
    "body"
FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
ORDER BY "date" DESC
LIMIT 20;
```

```sql
--Description: 3. View sample rows from the global word‑frequency list
SELECT 
    "word",
    "frequency"
FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES"
LIMIT 20;
```

```sql
--Description: 4. Look up GloVe vectors for a few frequent scientific words (fuzzy match ‘cell’)
SELECT 
    "word",
    "vector"
FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"
WHERE "word" ILIKE '%cell%'
LIMIT 20;
```

```sql
--Description: 5. Tokenise the body of one sample article into lower‑case words (very rough split on space)
SELECT 
    n."id",
    tok.value::STRING AS "token"
FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
     LATERAL FLATTEN( INPUT => SPLIT( LOWER(n."body"), ' ' ) ) tok
WHERE n."id" = (  -- pick one concrete article
        SELECT MIN("id") FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
      )
LIMIT 20;
```

```sql
--Description: 6. Same tokenisation but exclude a few basic stop‑words
SELECT 
    n."id",
    tok.value::STRING AS "token"
FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
     LATERAL FLATTEN( INPUT => SPLIT( LOWER(n."body"), ' ' ) ) tok
WHERE tok.value::STRING NOT IN ('the','of','and','to','a','in')
      AND n."id" = (SELECT MIN("id") FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE")
LIMIT 20;
```

```sql
--Description: 7. Join the tokens of one article with their corpus frequencies
SELECT
    t."token",
    wf."frequency"
FROM (
    SELECT 
        tok.value::STRING AS "token"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
         LATERAL FLATTEN( INPUT => SPLIT( LOWER(n."body"), ' ' ) ) tok
    WHERE n."id" = (SELECT MIN("id") FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE")
) t
LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
       ON wf."word" = t."token"
LIMIT 20;
```

```sql
--Description: 8. Add the GloVe vector for each token of that article (may return NULL if OOV)
SELECT
    t."token",
    gv."vector"
FROM (
    SELECT DISTINCT
        tok.value::STRING AS "token"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
         LATERAL FLATTEN( INPUT => SPLIT( LOWER(n."body"), ' ' ) ) tok
    WHERE n."id" = (SELECT MIN("id") FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE")
          AND tok.value::STRING NOT IN ('the','of','and','to','a','in')
) t
LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
       ON gv."word" = t."token"
LIMIT 20;
```

```sql
--Description: 9. Demonstrate calculation of the weighting factor 1/(frequency^0.4) for each token
SELECT
    t."token",
    wf."frequency",
    1 / POWER(wf."frequency", 0.4) AS "weight"
FROM (
    SELECT DISTINCT
        tok.value::STRING AS "token"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
         LATERAL FLATTEN( INPUT => SPLIT( LOWER(n."body"), ' ' ) ) tok
    WHERE n."id" = (SELECT MIN("id") FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE")
          AND tok.value::STRING NOT IN ('the','of','and','to','a','in')
) t
LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
       ON wf."word" = t."token"
LIMIT 20;
```

```sql
--Description: 10. Sketch of bringing everything together for one article—
--tokenise, join freq & vector, compute re‑weighted vector’s first element
SELECT
    n."id",
    tok.value::STRING                              AS "token",
    wf."frequency",
    1 / POWER(wf."frequency", 0.4)                 AS "weight",
    gv."vector"[0]                                 AS "vec_0",
    gv."vector"[0] * (1 / POWER(wf."frequency", 0.4)) AS "weighted_vec_0"
FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
     LATERAL FLATTEN( INPUT => SPLIT( LOWER(n."body"), ' ' ) ) tok
LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
       ON wf."word" = tok.value::STRING
LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
       ON gv."word" = tok.value::STRING
WHERE n."id" = (SELECT MIN("id") FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE")
      AND tok.value::STRING NOT IN ('the','of','and','to','a','in')
LIMIT 20;
```

