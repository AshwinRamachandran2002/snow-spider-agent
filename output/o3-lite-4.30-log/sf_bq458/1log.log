/* ----------------------------------------------------------
   Build a unit‑length GloVe‑based vector for every Nature
   article.
   ---------------------------------------------------------- */
WITH
/* 1. Split each article body into individual lower‑case tokens */
tokens AS (
    SELECT
        n."id",
        n."date",
        n."title",
        LOWER( REGEXP_REPLACE( tok.value::STRING , '[^A-Za-z0-9]' , '' ) ) AS token
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN( INPUT => SPLIT( n."body" , ' ' ) ) tok
    WHERE tok.value IS NOT NULL
),
/* 2. Drop empty tokens and a small stop‑word list */
filtered_tokens AS (
    SELECT *
    FROM tokens
    WHERE token <> ''
      AND token NOT IN (
          'the','of','and','to','a','in','on','for','with','as','by','is','it','its',
          'at','an','be','that','this','are','from','or','was','were','which','we',
          'our','can','such','these','may','not','have','has','had','but','their',
          'they','them','also','using','used','use','between','into','during','after',
          'before','than','other','more','over','been','because','due','all','both'
      )
),
/* 3. Attach corpus frequency & GloVe vector; compute the weight 1/f^0.4 */
token_vectors AS (
    SELECT
        ft."id",
        ft."date",
        ft."title",
        gv."vector"                                    AS glove_vector,
        1 / POWER( wf."frequency" , 0.4 )              AS weight
    FROM filtered_tokens ft
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS      gv
          ON  gv."word" = ft.token
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES   wf
          ON  wf."word" = ft.token
),
/* 4. Multiply every vector element by the token weight */
weighted_components AS (
    SELECT
        tv."id",
        tv."date",
        tv."title",
        vec."index"                            AS idx,
        vec."value"::FLOAT * tv.weight         AS component
    FROM token_vectors tv,
         LATERAL FLATTEN( INPUT => tv.glove_vector ) vec
),
/* 5. Sum the weighted components for each article */
article_components AS (
    SELECT
        "id",
        "date",
        "title",
        idx,
        SUM( component )                       AS component
    FROM weighted_components
    GROUP BY "id","date","title",idx
),
/* 6. Compute the vector magnitude  */
magnitudes AS (
    SELECT
        "id",
        SQRT( SUM( component * component ) )   AS mag
    FROM article_components
    GROUP BY "id"
    HAVING mag > 0     -- avoid divide‑by‑zero
),
/* 7. Normalise every component and rebuild into an array */
normalised_vectors AS (
    SELECT
        ac."id",
        ac."date",
        ac."title",
        ARRAY_AGG( ac.component / m.mag ORDER BY ac.idx )  AS normalised_article_vector
    FROM article_components  ac
    JOIN magnitudes          m   ON m."id" = ac."id"
    GROUP BY ac."id", ac."date", ac."title"
)
SELECT
    "id",
    "date",
    "title",
    normalised_article_vector
FROM normalised_vectors;
```
