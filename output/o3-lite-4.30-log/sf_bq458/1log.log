```sql
--Description / thinking process:
-- Goal: examine how we can build weighted word vectors for one Nature article.
-- Steps:
-- 1. Choose a single article; here, the one with the minimum "id" (arbitrary demo pick).
-- 2. Tokenise its "body" text: Snowflake requires CROSS JOIN LATERAL FLATTEN for this.
-- 3. Bring in word‑level information:
--      • WORD_FREQUENCIES to get corpus frequency.
--      • GLOVE_VECTORS to get the 300‑D embedding (demo shows element 0).
-- 4. Compute the weight = 1 / frequency^0.4.
-- 5. Multiply the first embedding component by the weight (as proof of concept).
-- 6. Filter out a few stop‑words to reduce noise.
-- 7. Limit to 20 rows for a concise sample.
SELECT
    n."id",
    tok.value::STRING                                  AS "token",
    wf."frequency",
    1 / POWER(wf."frequency", 0.4)                     AS "weight",
    gv."vector"[0]                                     AS "vec_0",
    gv."vector"[0] * (1 / POWER(wf."frequency", 0.4))  AS "weighted_vec_0"
FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n
CROSS JOIN LATERAL FLATTEN( INPUT => SPLIT( LOWER(n."body"), ' ' ) ) tok
LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
       ON wf."word" = tok.value::STRING
LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
       ON gv."word" = tok.value::STRING
WHERE n."id" = (SELECT MIN("id") FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE")
      AND tok.value::STRING NOT IN ('the', 'of', 'and', 'to', 'a', 'in')
LIMIT 20;
```
