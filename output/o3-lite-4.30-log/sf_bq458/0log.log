--Description / Thinking process:
-- Objective: produce, for up to 20 Nature articles, a single unit‑length article vector
--            built as the sum of frequency‑weighted GloVe word vectors (then normalised).
-- Steps
-- 1) CTE tokens   : explode every article BODY into alphabetic tokens (>2 chars, lower‑cased).
-- 2) CTE comps    : join each token to WORD_FREQUENCIES and GLOVE_VECTORS, 
--                   flatten the 300‑d vector into (index , value) rows,
--                   weight every component by dividing by frequency^0.4.
-- 3) CTE art_sum  : aggregate the weighted components per article & component index (i.e. sum over tokens).
-- 4) CTE art_vec  : re‑assemble the 300 summed components into an ordered ARRAY for each article.
-- 5) CTE normed   : compute vector magnitude for every article.
-- 6) Final SELECT : divide each component by the magnitude ⇒ unit‑length vector.
-- Notes
-- • All GROUP BY clauses exclude large VARIANT arrays to avoid previous syntax errors.
-- • LIMIT 20 keeps run time modest.

WITH tokens AS (                                                       -- step‑1
    SELECT
        n."id",
        n."date",
        n."title",
        LOWER(TRIM(f.value)) AS "token"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
             input => SPLIT(
                 REGEXP_REPLACE(LOWER(n."body"), '[^a-z ]', ' '), ' ')
         ) f
    WHERE n."body" IS NOT NULL
      AND LENGTH(TRIM(f.value)) > 2
    LIMIT 20000                         -- cap early rows so later LIMIT 20 is feasible
),
comps AS (                                                            -- step‑2
    SELECT
        t."id",
        t."date",
        t."title",
        fv.index                                        AS comp_idx,
        (fv.value::FLOAT) / POWER(wf."frequency", 0.4) AS weighted_val
    FROM tokens t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
          ON wf."word" = t."token"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
          ON gv."word" = t."token",
         LATERAL FLATTEN(input => gv."vector") fv
),
art_sum AS (                                                          -- step‑3
    SELECT
        "id",
        "date",
        "title",
        comp_idx,
        SUM(weighted_val) AS comp_sum
    FROM comps
    GROUP BY "id", "date", "title", comp_idx
),
art_vec AS (                                                          -- step‑4
    SELECT
        "id",
        "date",
        "title",
        ARRAY_AGG(comp_sum ORDER BY comp_idx) AS sum_vec
    FROM art_sum
    GROUP BY "id", "date", "title"
),
normed AS (                                                           -- step‑5
    SELECT
        av."id",
        av."date",
        av."title",
        av."sum_vec",
        SQRT( SUM( POWER(sv.value::FLOAT, 2) ) ) AS magnitude
    FROM art_vec av,
         LATERAL FLATTEN(input => av."sum_vec") sv
    GROUP BY av."id", av."date", av."title", av."sum_vec"
)
SELECT                                                                 -- step‑6
    "id",
    "date",
    "title",
    ARRAY_AGG( (sv.value::FLOAT) / NULLIF(magnitude, 0) )
        WITHIN GROUP (ORDER BY sv.index) AS article_vector_unit
FROM normed,
     LATERAL FLATTEN(input => normed."sum_vec") sv
WHERE magnitude IS NOT NULL
GROUP BY "id", "date", "title", magnitude
LIMIT 20;
