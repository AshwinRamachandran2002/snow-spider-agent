    LIMIT 20000                                -- early cap for safety
),
comps AS (                                     -- STEP‑2  add vectors & weights
    SELECT
        t."id",
        t."date",
        t."title",
        fv.index                                        AS comp_idx,
        (fv.value::FLOAT) / POWER(wf."frequency", 0.4) AS weighted_val
    FROM tokens t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
          ON wf."word" = t."token"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
          ON gv."word" = t."token",
         LATERAL FLATTEN( input => gv."vector" ) fv
),
art_sum AS (                                   -- STEP‑3  sum per component
    SELECT
        "id",
        "date",
        "title",
        comp_idx,
        SUM(weighted_val) AS comp_sum
    FROM comps
    GROUP BY "id", "date", "title", comp_idx
),
art_vec AS (                                   -- STEP‑4  pack 300‑component array
    SELECT
        "id",
        "date",
        "title",
