--Description: Produce a 300‑dimensional, unit‑length embedding for (up to) 20 Nature
--             articles by summing frequency‑weighted GloVe word vectors and normalising.
-- Workflow
-- 1. tokens  – tokenize each BODY into lowercase alphabetic words (>2 chars).
-- 2. comps   – join tokens with WORD_FREQUENCIES & GLOVE_VECTORS, flatten vectors,
--              weight every component by frequency^-0.4.
-- 3. art_sum – sum weighted components per article & component index.
-- 4. art_vec – assemble the 300 summed values into an ARRAY ordered by index.
-- 5. normed  – compute magnitude of each article vector.
-- 6. final   – divide each component by its magnitude to obtain unit‑length vectors.

WITH tokens AS (                               -- Step‑1  tokenize
    SELECT
        n."id",
        n."date",
        n."title",
        LOWER(TRIM(f.value)) AS "token"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
             INPUT => SPLIT(
                 REGEXP_REPLACE(LOWER(n."body"), '[^a-z ]', ' '), ' ')
         ) f
    WHERE n."body" IS NOT NULL
      AND LENGTH(TRIM(f.value)) > 2
    LIMIT 20000                                -- guard runtime
),
comps AS (                                     -- Step‑2  attach GloVe & weight
    SELECT
        t."id",
        t."date",
        t."title",
        v.index                                        AS comp_idx,
        (v.value::FLOAT) / POWER(wf."frequency", 0.4) AS weighted_val
    FROM tokens t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
        ON wf."word" = t."token"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
        ON gv."word" = t."token",
         LATERAL FLATTEN(INPUT => gv."vector") v
),
art_sum AS (                                   -- Step‑3  sum per component
    SELECT
        "id",
        "date",
        "title",
        comp_idx,
        SUM(weighted_val) AS comp_sum
    FROM comps
    GROUP BY "id", "date", "title", comp_idx
),
art_vec AS (                                   -- Step‑4  pack into ARRAY(300)
    SELECT
        "id",
        "date",
        "title",
        ARRAY_AGG(comp_sum ORDER BY comp_idx) AS sum_vec
    FROM art_sum
    GROUP BY "id", "date", "title"
),
normed AS (                                    -- Step‑5  compute magnitude
    SELECT
        av."id",
        av."date",
        av."title",
        av."sum_vec",
        SQRT(SUM(POWER(sv.value::FLOAT, 2))) AS magnitude
