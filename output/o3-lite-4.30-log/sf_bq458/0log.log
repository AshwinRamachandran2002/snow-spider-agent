--             articles.  The pipeline tokenises article bodies, weights each
--             word‑vector component by frequency‑0.4, sums across tokens,
--             and finally normalises the resulting 300‑d article vector.
WITH tokens AS (                               -- STEP‑1  tokenize bodies
