    FROM    magnitudes m,
            LATERAL FLATTEN(input => m.sum_vec) c
    WHERE   m.mag IS NOT NULL AND m.mag <> 0
    GROUP BY m.id, m.date, m.title
)
-----------------------------------------------------------------
/* 10. final result */
SELECT  id,
        date,
        title,
        normalized_article_vector
FROM    normalised;
