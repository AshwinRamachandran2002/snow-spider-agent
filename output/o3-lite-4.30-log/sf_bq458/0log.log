    FROM    article_pos_sums
    GROUP BY id, date, title
),
-----------------------------------------------------------------
/* 8. compute vector magnitude for normalisation */
magnitudes AS (
    SELECT  av.id,
            av.date,
            av.title,
            av.sum_vec,
            SQRT( SUM( POWER(comp.value::FLOAT, 2) ) )  AS mag
    FROM    article_vectors av,
            LATERAL FLATTEN(input => av.sum_vec) comp
    GROUP BY av.id, av.date, av.title, av.sum_vec
