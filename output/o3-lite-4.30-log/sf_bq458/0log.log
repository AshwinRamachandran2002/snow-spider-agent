    "category"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE "category" IS NOT NULL
LIMIT 20;
```

```sql
-- 3. Description: Look at the "body" text of a few articles (helps understand tokenisation needs)
SELECT 
    "id",
    LEFT("body", 500) AS "body_sample"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE "body" IS NOT NULL
LIMIT 20;
```

```sql
-- 4. Description: Preview the word‑frequency list
SELECT 
    "word",
    "frequency"
FROM WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES
LIMIT 20;
```

```sql
-- 5. Description: Preview the raw GloVe vectors for a few tokens
SELECT 
    "word",
    "vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS
LIMIT 20;
```

```sql
-- 6. Description: Join frequency & vector tables for a set of high‑frequency words
SELECT 
    wf."word",
    wf."frequency",
    gv."vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES  wf
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS     gv
      ON gv."word" = wf."word"
WHERE wf."frequency" > 10000
LIMIT 20;
```

```sql
-- 7. Description: Tokenise the body of one article into individual words
--         and keep only alphabetic tokens longer than 2 characters
SELECT 
    n."id",
    LOWER(TRIM(value)) AS "token"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE  n,
     LATERAL FLATTEN( input => SPLIT( 
         REGEXP_REPLACE( LOWER(n."body"), '[^a-z ]', ' '), ' ' ) ) f
WHERE n."id" = (SELECT "id" FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE LIMIT 1)
  AND LENGTH(TRIM(value)) > 2
LIMIT 20;
```

```sql
-- 8. Description: Attach frequency and GloVe vector to the tokens of one article
SELECT 
    t."id",
    t."token",
    wf."frequency",
    gv."vector"
FROM (
    SELECT 
        n."id",
        LOWER(TRIM(value)) AS "token"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN( input => SPLIT( 
             REGEXP_REPLACE( LOWER(n."body"), '[^a-z ]', ' '), ' ' ) ) f
    WHERE n."id" = (SELECT "id" FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE LIMIT 1)
      AND LENGTH(TRIM(value)) > 2
) t
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
     ON wf."word" = t."token"
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
     ON gv."word" = t."token"
LIMIT 20;
```

```sql
-- 9. Description: Compute weighted word vectors for tokens of one article
SELECT 
    t."id",
    t."token",
    gv."vector",
    wf."frequency",
    ARRAY_AGG( (value::FLOAT) / POWER(wf."frequency", 0.4) ) WITHIN GROUP (ORDER BY idx) AS "weighted_vector"
FROM (
    SELECT 
        n."id",
        LOWER(TRIM(value)) AS "token"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN( input => SPLIT( 
             REGEXP_REPLACE( LOWER(n."body"), '[^a-z ]', ' '), ' ' ) ) f
    WHERE n."id" = (SELECT "id" FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE LIMIT 1)
      AND LENGTH(TRIM(value)) > 2
) t
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
     ON wf."word" = t."token"
JOIN (
    SELECT 
        "word",
        FLATTEN("vector") AS vec
    FROM WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS
) gv
     ON gv."word" = t."token",
     LATERAL gv.vec
GROUP BY t."id", t."token", gv."vector", wf."frequency"
LIMIT 20;
```

```sql
-- 10. Description: Aggregate all weighted vectors into a single normalised article vector
--                  then return id, date, title, and the unit‑length article vector
WITH tokenised AS (
    SELECT 
        n."id",
        n."date",
        n."title",
        LOWER(TRIM(value)) AS "token"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN( input => SPLIT( 
             REGEXP_REPLACE( LOWER(n."body"), '[^a-z ]', ' '), ' ' ) ) f
    WHERE n."body" IS NOT NULL
      AND LENGTH(TRIM(value)) > 2
),
token_data AS (
    SELECT
        tk."id",
        tk."date",
        tk."title",
        gv."vector"                                   AS "raw_vec",
        wf."frequency",
        ARRAY_AGG( (v.value::FLOAT) / POWER(wf."frequency", 0.4) )
           WITHIN GROUP (ORDER BY v.index)           AS "weighted_vec"
    FROM tokenised tk
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
          ON wf."word" = tk."token"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
          ON gv."word" = tk."token",
         LATERAL FLATTEN(input => gv."vector") v
    GROUP BY tk."id", tk."date", tk."title", gv."vector", wf."frequency"
),
article_vec AS (
    SELECT
        "id",
        "date",
        "title",
        ARRAY_AGG(wv.value::FLOAT)      WITHIN GROUP (ORDER BY wv.index) AS "sum_vec"
    FROM token_data,
         LATERAL FLATTEN(input => token_data."weighted_vec") wv
    GROUP BY "id", "date", "title"
),
normed AS (
    SELECT
        "id",
        "date",
        "title",
        "sum_vec",
        SQRT( SUM( POWER(sv.value::FLOAT, 2) ) )       AS "magnitude"
    FROM article_vec,
         LATERAL FLATTEN(input => article_vec."sum_vec") sv
    GROUP BY "id", "date", "title", "sum_vec"
)
SELECT
    "id",
    "date",
    "title",
    ARRAY_AGG( (sv.value::FLOAT) / NULLIF("magnitude", 0) )
       WITHIN GROUP (ORDER BY sv.index)                AS "article_vector_unit"
FROM normed,
     LATERAL FLATTEN(input => normed."sum_vec") sv
WHERE "magnitude" IS NOT NULL
LIMIT 20;
```

Each query progresses in complexity: from simple sampling, to joining the vocabulary tables, to tokenising text, weighting word vectors, and finally deriving and normalising an article‑level embedding—all while remaining exploratory and limited to 20 rows for safety.
