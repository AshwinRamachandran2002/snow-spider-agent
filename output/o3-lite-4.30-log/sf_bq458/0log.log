```sql
--Description / Thinking process:
-- Goal: for one Nature article, derive the frequency‑weighted GloVe vector of every unique word.
-- 1. tokens CTE: pick the first article, clean its body, split into words, keep tokens >2 letters.
-- 2. Join each token to WORD_FREQUENCIES (for frequency) and GLOVE_VECTORS (for 300‑d vector).
-- 3. Flatten the 300‑element vector so each component is a row with its index.
-- 4. Weight each component by dividing by frequency^0.4.
-- 5. Re‑assemble the 300 weighted components into an ARRAY ordered by index.
-- 6. GROUP BY article id + token so every token has a single weighted vector.
WITH tokens AS (
    SELECT
        n."id",
        LOWER(TRIM(f.value)) AS "token"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
             input => SPLIT(
                 REGEXP_REPLACE(LOWER(n."body"), '[^a-z ]', ' '), ' ')
         ) f
    WHERE n."id" = (SELECT "id" FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE LIMIT 1)
      AND LENGTH(TRIM(f.value)) > 2
)
SELECT
    tok."id",
    tok."token",
    wf."frequency",
    ARRAY_AGG( (vec.value::FLOAT) / POWER(wf."frequency", 0.4) )
         WITHIN GROUP (ORDER BY vec.index) AS "weighted_vector"
FROM tokens tok
