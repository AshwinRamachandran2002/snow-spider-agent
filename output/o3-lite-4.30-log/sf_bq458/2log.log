--Description: 
-- Full prototype for a single Nature article:
--   • article CTE: pick one article whose "body" is not null.
--   • tokens  CTE: lower‑case body, SPLIT_TO_TABLE on spaces; each token (a VARIANT
--     named VALUE) is cast to STRING, punctuation removed with REGEXP_REPLACE,
--     trimmed; keep non‑empty tokens.
--   • Final SELECT: join these tokens to WORD_FREQUENCIES (to obtain "frequency")
--     and GLOVE_VECTORS (to obtain its 300‑D "vector").
--     → ARRAY_TRANSFORM applies element‑wise scaling:  x / frequency^0.4.
--   • Output article id, token, frequency and the weighted_vector; limit 20 rows.
WITH article AS (
    SELECT "id", "body"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
    WHERE "body" IS NOT NULL
    LIMIT 1
),
tokens AS (
    SELECT
        a."id",
        TRIM(REGEXP_REPLACE(tok.value::STRING, '[^a-z0-9]+', '')) AS token
    FROM article a,
         LATERAL SPLIT_TO_TABLE(LOWER(a."body"), ' ') tok
    WHERE TRIM(REGEXP_REPLACE(tok.value::STRING, '[^a-z0-9]+', '')) <> ''
)
SELECT
    t."id",
    t.token,
    wf."frequency",
    ARRAY_TRANSFORM(
        gv."vector",
        x -> x / POW(wf."frequency", 0.4)
    ) AS weighted_vector
FROM tokens                                                   t
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
  ON t.token = wf."word"
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"    gv
  ON t.token = gv."word"
LIMIT 20;
