```sql
--Description: 
-- Token‑inspection pipeline for one Nature article, end‑to‑end.
-- 1) Isolate a single article with a non‑null body (LIMIT 1 in sub‑query).
-- 2) Convert the body to lower case, SPLIT_TO_TABLE on blank space, obtaining
--    token_tbl.value (VARIANT).  Cast to STRING before further processing.
-- 3) Clean each raw token via REGEXP_REPLACE to strip non‑alphanumerics,
--    then TRIM, and discard empty results.
-- 4) Join the cleaned tokens to WORD_FREQUENCIES to fetch their corpus
--    frequencies and to GLOVE_VECTORS to fetch their 300‑D vectors.
-- 5) Show the first 20 rows (token, frequency, vector) so we can confirm
--    that the tokenisation and joins are working correctly; this also
--    demonstrates that the earlier “Numeric value 'i'” error is resolved
--    by explicit casting.
SELECT
    t."token",
    wf."frequency",
    gv."vector"
FROM (
    -- Step 1 & 2: pick one article and split it into tokens
    SELECT
        TRIM(REGEXP_REPLACE(tok_tbl.value::STRING, '[^a-z0-9]+', '')) AS "token"
    FROM (
        SELECT "body"
        FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
        WHERE "body" IS NOT NULL
        LIMIT 1
    ) art,
    LATERAL SPLIT_TO_TABLE(LOWER(art."body"), ' ') AS tok_tbl
) t
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" AS wf
  ON t."token" = wf."word"
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"    AS gv
  ON t."token" = gv."word"
WHERE t."token" <> ''
LIMIT 20;
```
