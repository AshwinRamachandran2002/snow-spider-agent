```sql
--Description: 
-- Single‑query demonstration:
--   • Pull exactly one Nature article that has body text (article CTE).  
--   • Tokenise that body: lower‑case, SPLIT_TO_TABLE on spaces, cast VARIANT to
--     STRING, strip punctuation via REGEXP_REPLACE, TRIM; keep non‑empty tokens
--     (tokens CTE).  
--   • Join tokens to WORD_FREQUENCIES (for term frequency) and GLOVE_VECTORS
--     (for 300‑D GloVe vector) in the joined CTE.  Also pre‑compute a scalar
--     weight = 1 / frequency^0.4.  
--   • Use ARRAY_TRANSFORM to multiply every element of the vector by that scalar,
--     producing a per‑token weighted vector without any VARIANT‑to‑numeric
--     casting errors.  
--   • Return article id, token, frequency and the weighted_vector; limit to
--     20 rows so we can manually inspect the result.
WITH article AS (
    SELECT "id", "body"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
    WHERE "body" IS NOT NULL
    LIMIT 1
),
tokens AS (
    SELECT
        a."id",
        TRIM(REGEXP_REPLACE(tok.value::STRING, '[^a-z0-9]+', '')) AS token
    FROM article a,
         LATERAL SPLIT_TO_TABLE(LOWER(a."body"), ' ') AS tok
    WHERE TRIM(REGEXP_REPLACE(tok.value::STRING, '[^a-z0-9]+', '')) <> ''
),
joined AS (
    SELECT
        t."id",
        t.token,
        wf."frequency",
        gv."vector",
        1 / POW(wf."frequency", 0.4) AS weight_scalar
    FROM tokens t
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
      ON t.token = wf."word"
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"    gv
      ON t.token = gv."word"
)
SELECT
    j."id",
    j.token,
    j."frequency",
    ARRAY_TRANSFORM(j."vector", x -> x * j.weight_scalar) AS weighted_vector
FROM joined j
LIMIT 20;
```
