```sql
--Description: Inspect one article end‑to‑end—tokenize its body, join each token to
--             WORD_FREQUENCIES and GLOVE_VECTORS, and view a handful of weighted
--             word vectors.  Steps:
--   1) Pick a single Nature article whose body is not null (LIMIT 1 for brevity).
--   2) Convert the body to lower case and split on spaces via SPLIT_TO_TABLE.
--   3) Clean each raw token with REGEXP_REPLACE to remove non‑alphanumerics,
--      then TRIM; discard empty strings.
--   4) Join those cleaned tokens to WORD_FREQUENCIES (for frequency) and
--      GLOVE_VECTORS (for its 300‑dimensional vector).
--   5) Compute a re‑weighted vector: vector / POW(frequency, 0.4).
--   6) Display the first 20 rows (token, frequency, original vector, weighted vector).
WITH one_article AS (
    SELECT "id", "title", "body"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
    WHERE "body" IS NOT NULL
    LIMIT 1
),
tokens AS (
    SELECT
        oa."id",
        TRIM(REGEXP_REPLACE(token_tbl.value, '[^a-z0-9]+', '', 'i')) AS token
    FROM one_article AS oa,
         LATERAL SPLIT_TO_TABLE(LOWER(oa."body"), ' ') AS token_tbl
    WHERE TRIM(REGEXP_REPLACE(token_tbl.value, '[^a-z0-9]+', '', 'i')) <> ''
)
SELECT
    t.token,
    wf."frequency",
    gv."vector",
    gv."vector" / POW(wf."frequency", 0.4) AS weighted_vector
FROM tokens                 AS t
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" AS wf
  ON t.token = wf."word"
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"    AS gv
  ON t.token = gv."word"
LIMIT 20;
```
