WITH stop_words(word) AS (   -- small list of stop‑words to drop
    SELECT column1 FROM VALUES
        ('the'),('of'),('and'),('in'),('to'),('a'),('for'),('is'),('on'),('that'),
        ('by'),('with'),('as'),('was'),('were'),('are'),('be'),('this'),('or'),
        ('at'),('from'),('an'),('it'),('which'),('but'),('not'),('have'),('has'),
        ('had'),('their'),('its'),('they'),('we'),('these'),('those'),('such')
),

/* 1) Tokenise every article body, lowercase, strip non‑alphanumerics */
article_tokens AS (
    SELECT
        n."id",
        n."date",
        n."title",
        REGEXP_REPLACE(LOWER(tok.value::STRING), '[^a-z0-9]+', '') AS token
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
         LATERAL SPLIT_TO_TABLE(n."body", ' ') tok
    WHERE n."body" IS NOT NULL
),

/* 2) Remove blanks & stop‑words, then count occurrences of each word per article */
token_counts AS (
    SELECT
        id,
        date,
        title,
        token,
        COUNT(*) AS cnt
    FROM article_tokens
    WHERE token <> ''
      AND token NOT IN (SELECT word FROM stop_words)
    GROUP BY id, date, title, token
),

/* 3) Attach global word frequency and GloVe vector */
word_data AS (
    SELECT
        tc.id,
        tc.date,
        tc.title,
        gv."vector"             AS vec,
        wf."frequency"          AS freq,
        tc.cnt
    FROM token_counts                                   tc
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"    gv  ON tc.token = gv."word"
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf  ON tc.token = wf."word"
),

/* 4) Weight each vector (scaled by cnt / freq^0.4) and explode to components */
weighted_components AS (
    SELECT
        wd.id,
        wd.date,
        wd.title,
        comp.index                           AS idx,
        (comp.value::FLOAT * wd.cnt) / POW(wd.freq, 0.4)  AS comp_val
    FROM word_data wd,
         LATERAL FLATTEN(input => wd.vec) comp
),

/* 5) Sum components per article */
article_vector AS (
    SELECT
        id,
        date,
        title,
        idx,
        SUM(comp_val) AS comp_sum
    FROM weighted_components
    GROUP BY id, date, title, idx
),

/* 6) Magnitude of each article vector */
mags AS (
    SELECT
        id,
        SQRT(SUM(comp_sum * comp_sum)) AS mag
    FROM article_vector
    GROUP BY id
),

/* 7) Normalise and rebuild as ordered array */
normalised AS (
    SELECT
        av.id,
        ANY_VALUE(av.date)  AS date,
        ANY_VALUE(av.title) AS title,
        ARRAY_AGG( (av.comp_sum / m.mag) ORDER BY av.idx ) AS normalised_article_vector
    FROM article_vector av
    JOIN mags m ON av.id = m.id
    GROUP BY av.id
)

/* 8) Final result */
SELECT
    id,
    date,
    title,
    normalised_article_vector
FROM normalised;
```
