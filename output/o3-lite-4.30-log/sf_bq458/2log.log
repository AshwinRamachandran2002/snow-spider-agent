WITH stop_words(word) AS (
    SELECT column1 FROM VALUES
        ('the'),('of'),('and'),('in'),('to'),('a'),('for'),('is'),('on'),('that'),
        ('by'),('with'),('as'),('was'),('were'),('are'),('be'),('this'),('or'),
        ('at'),('from'),('an'),('it'),('which'),('but'),('not'),('have'),('has'),
        ('had'),('their'),('its'),('they'),('we'),('these'),('those'),('such')
),
-- 1. tokenize article bodies and clean tokens
tokens AS (
    SELECT
        n."id",
        n."date",
        n."title",
        TRIM(REGEXP_REPLACE(tok.value::STRING,'[^a-z0-9]+','')) AS token
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"   n,
         LATERAL SPLIT_TO_TABLE(LOWER(n."body"),' ')    tok
    WHERE n."body" IS NOT NULL
),
-- 2. remove empty tokens and stop‑words
valid_tokens AS (
    SELECT *
    FROM tokens
    WHERE token <> ''
      AND token NOT IN (SELECT word FROM stop_words)
),
-- 3. join to word‑level frequency and GloVe vector tables
word_vectors AS (
    SELECT
        vt."id",
        vt."date",
        vt."title",
        gv."vector"                   AS vec,          -- 300‑dim array (VARIANT)
        wf."frequency"                AS freq
    FROM valid_tokens                                   vt
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"    gv ON vt.token = gv."word"
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf ON vt.token = wf."word"
),
-- 4. weight every element of every vector, then explode into (idx,value) pairs
weighted AS (
    SELECT
        wv."id",
        wv."date",
        wv."title",
        pos.index                               AS idx,
        (pos.value::FLOAT / POW(wv.freq,0.4))   AS w_val
    FROM word_vectors wv,
         LATERAL FLATTEN(input => wv.vec) pos
),
-- 5. sum weighted components per article
article_sum AS (
    SELECT
        "id",
        "date",
        "title",
        idx,
        SUM(w_val) AS comp_sum
    FROM weighted
    GROUP BY "id","date","title",idx
),
-- 6. compute vector magnitude for every article
magnitudes AS (
    SELECT
        "id",
        SQRT(SUM(comp_sum*comp_sum)) AS mag
    FROM article_sum
    GROUP BY "id"
),
-- 7. normalise each component and re‑assemble into an array
normalised AS (
    SELECT
        a."id",
        a."date",
        a."title",
        ARRAY_AGG(a.comp_sum / m.mag ORDER BY a.idx)  AS normalised_article_vector
    FROM article_sum a
    JOIN magnitudes m
      ON a."id" = m."id"
    GROUP BY a."id",a."date",a."title"
)
-- 8. final result
SELECT
    "id",
    "date",
    "title",
    normalised_article_vector
FROM normalised;
```
