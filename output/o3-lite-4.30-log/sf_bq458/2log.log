```sql
-- 10) Description: End‑to‑end prototype on a single article—
--                 fetch tokens, attach GloVe vectors, and show first 20 weighted vectors.
SELECT 
  n."id",
  TRIM(tok.token)                                  AS "token",
  gv."vector",
  wf."frequency",
  gv."vector" / POW(wf."frequency", 0.4)           AS "weighted_vector"
FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"           AS n,
     LATERAL SPLIT_TO_TABLE(LOWER(n."body"), ' ')           AS tok(token)
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" AS wf
  ON TRIM(tok.token) = wf."word"
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"    AS gv
  ON TRIM(tok.token) = gv."word"
WHERE n."id" IS NOT NULL
LIMIT 20;
