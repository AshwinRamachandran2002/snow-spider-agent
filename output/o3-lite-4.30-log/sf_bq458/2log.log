```sql
--Description: 
-- One‑shot demonstration of the full token‑to‑weighted‑vector path on a single
-- Nature article.  
-- • Pull one article whose body is not NULL.  
-- • Tokenise the body via SPLIT_TO_TABLE, cast each VARIANT token to STRING,
--   strip punctuation with REGEXP_REPLACE, TRIM, keep non‑empty tokens.  
-- • Join the cleaned tokens to WORD_FREQUENCIES (for corpus counts) and
--   GLOVE_VECTORS (for 300‑D vectors).  
-- • Use ARRAY_TRANSFORM to divide every element in the vector by
--   POW(frequency, 0.4), producing a per‑token weighted vector without
--   triggering cast errors.  
-- • Show article id, token, frequency, and the weighted vector; limit 20 rows
--   just to inspect correctness.
WITH one_article AS (
    SELECT "id", "body"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
    WHERE "body" IS NOT NULL
    LIMIT 1
),
tokens AS (
    SELECT
        oa."id",
        TRIM(REGEXP_REPLACE(tok_tbl.value::STRING, '[^a-z0-9]+', '')) AS "token"
    FROM one_article oa,
         LATERAL SPLIT_TO_TABLE(LOWER(oa."body"), ' ') tok_tbl
    WHERE TRIM(REGEXP_REPLACE(tok_tbl.value::STRING, '[^a-z0-9]+', '')) <> ''
)
SELECT
    t."id",
    t."token",
    wf."frequency",
    ARRAY_TRANSFORM(gv."vector", x -> x / POW(wf."frequency", 0.4)) AS "weighted_vector"
FROM tokens                                                    t
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
  ON t."token" = wf."word"
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"    gv
  ON t."token" = gv."word"
LIMIT 20;
```
