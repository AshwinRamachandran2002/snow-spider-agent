--Description: 
-- 9) For a single Nature article, tokenize its body, clean tokens, cast to STRING,
--    then join to WORD_FREQUENCIES to confirm that normalised tokens have matching
--    frequency records.  The explicit CAST prevents the earlier “Numeric value 'i'”
--    error.  Result limited to 20 rows.
SELECT
    n."id",
    TRIM(REGEXP_REPLACE(tok_tbl.value::STRING, '[^a-z0-9]+', '')) AS "token",
    wf."frequency"
FROM (
    SELECT "id", "body"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
    WHERE "body" IS NOT NULL
    LIMIT 1
) AS n,
LATERAL SPLIT_TO_TABLE(LOWER(n."body"), ' ') AS tok_tbl
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" AS wf
  ON TRIM(REGEXP_REPLACE(tok_tbl.value::STRING, '[^a-z0-9]+', '')) = wf."word"
WHERE TRIM(REGEXP_REPLACE(tok_tbl.value::STRING, '[^a-z0-9]+', '')) <> ''
LIMIT 20
