Query:
--Description: 9) Actors whose longest gap is ≤ 3 years (sample 20); trims PID consistently when computing gaps.
WITH ordered AS (
    SELECT
           TRIM(mc."PID")                                                AS PID,
           CAST(m."year" AS INTEGER)                                     AS y,
           LEAD(CAST(m."year" AS INTEGER)) OVER (PARTITION BY TRIM(mc."PID")
                                                 ORDER BY CAST(m."year" AS INTEGER)) AS nxt
    FROM   "M_Cast" AS mc
    JOIN   "Movie"  AS m ON m."MID" = mc."MID"
    WHERE  m."year" IS NOT NULL
),
gaps AS (
    SELECT  PID,
            MAX(COALESCE(nxt - y, 0)) AS max_gap
    FROM    ordered
    GROUP  BY PID
)
SELECT
       g.PID,
       TRIM(p."Name") AS actor_name
FROM   gaps   AS g
JOIN   "Person" AS p ON p."PID" = g.PID
WHERE  g.max_gap <= 3
LIMIT 20
