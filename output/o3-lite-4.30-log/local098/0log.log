2025-05-01 03:22:32 - Thread-1363 (execute) - INFO - [Exploration]
Relevant columns, their potential use and typical conditions  

• “M_Cast”.“PID” : the actor/actress identifier – used to collect every film credit that belongs to the same performer (JOIN with “Person”)  
• “M_Cast”.“MID” : the movie identifier – used to reach the movie table (JOIN with “Movie”)  
• “Movie”.“year” : release year for each title – used to build the ordered time line of appearances and to detect gaps; usually filtered with IS NOT NULL or CAST(…) AS INTEGER in case the column is stored as TEXT  
• “Person”.“Name” : human‑readable name – useful for displaying results or filtering a particular actor (e.g. WHERE TRIM(Name)= 'Christian Bale')  

Typical conditions you may see in the final query  
• WHERE “Movie”.“year” <> ''                       -- remove empty strings  
• WHERE CAST(“Movie”.“year” AS INTEGER) BETWEEN …  -- restrict to a period  
• HAVING MAX(gap) <= 3                             -- guarantee “no 4‑year span without a film” (gap is computed with LEAD/LAG)  


Ten exploratory SQL queries (each returns at most 20 rows)  
```sql
-- 1) See a sample of movie years to understand the raw format
SELECT DISTINCT "year"
FROM "Movie"
WHERE "year" IS NOT NULL
LIMIT 20;
```

```sql
-- 2) List some actor IDs together with their names
SELECT DISTINCT mc."PID", TRIM(p."Name") AS actor_name
FROM "M_Cast" AS mc
JOIN "Person" AS p ON p."PID" = mc."PID"
LIMIT 20;
```

```sql
-- 3) How many different movies does each actor have?  (top 20 only)
SELECT mc."PID",
       TRIM(p."Name")  AS actor_name,
       COUNT(DISTINCT mc."MID") AS film_credits
FROM   "M_Cast" AS mc
JOIN   "Person"  AS p ON p."PID" = mc."PID"
GROUP BY mc."PID"
ORDER BY film_credits DESC
LIMIT 20;
```

```sql
-- 4) All films (title + year) in which Christian Bale appears
SELECT m."title", m."year"
FROM   "M_Cast"  AS mc
JOIN   "Movie"   AS m ON m."MID" = mc."MID"
JOIN   "Person"  AS p ON p."PID" = mc."PID"
WHERE  TRIM(p."Name") = 'Christian Bale'
ORDER BY CAST(m."year" AS INTEGER)
LIMIT 20;
```

```sql
-- 5) Count appearances per actor per year (sample 20 rows)
SELECT mc."PID",
       CAST(m."year" AS INTEGER) AS rel_year,
       COUNT(*) AS appearances
FROM   "M_Cast" AS mc
JOIN   "Movie"  AS m ON m."MID" = mc."MID"
WHERE  m."year" IS NOT NULL
GROUP BY mc."PID", rel_year
LIMIT 20;
```

```sql
-- 6) First and last appearance year for every actor
SELECT mc."PID",
       MIN(CAST(m."year" AS INTEGER)) AS first_year,
       MAX(CAST(m."year" AS INTEGER)) AS last_year
FROM   "M_Cast" AS mc
JOIN   "Movie"  AS m ON m."MID" = mc."MID"
WHERE  m."year" IS NOT NULL
GROUP BY mc."PID"
LIMIT 20;
```

```sql
-- 7) For each credit, compute the next appearance year for that actor
SELECT mc."PID",
       CAST(m."year" AS INTEGER)               AS this_year,
       LEAD(CAST(m."year" AS INTEGER)) 
           OVER (PARTITION BY mc."PID"
                 ORDER BY CAST(m."year" AS INTEGER)) AS next_year
FROM   "M_Cast" AS mc
JOIN   "Movie"  AS m ON m."MID" = mc."MID"
WHERE  m."year" IS NOT NULL
ORDER  BY mc."PID", this_year
LIMIT 20;
```

```sql
-- 8) Biggest gap (in years) inside each actor’s career
WITH ordered AS (
  SELECT mc."PID",
         CAST(m."year" AS INTEGER) AS y,
         LEAD(CAST(m."year" AS INTEGER))
             OVER (PARTITION BY mc."PID" ORDER BY CAST(m."year" AS INTEGER)) AS nxt
  FROM   "M_Cast" AS mc
  JOIN   "Movie"  AS m ON m."MID" = mc."MID"
  WHERE  m."year" IS NOT NULL
)
SELECT  "PID",
        MAX(COALESCE(nxt - y,0)) AS max_gap
FROM    ordered
GROUP BY "PID"
LIMIT 20;
```

```sql
-- 9) Actors whose longest gap is <= 3 years  (i.e. satisfy the problem’s rule)
WITH ordered AS (
  SELECT mc."PID",
         CAST(m."year" AS INTEGER) AS y,
         LEAD(CAST(m."year" AS INTEGER))
             OVER (PARTITION BY mc."PID" ORDER BY CAST(m."year" AS INTEGER)) AS nxt
  FROM   "M_Cast" AS mc
  JOIN   "Movie"  AS m ON m."MID" = mc."MID"
  WHERE  m."year" IS NOT NULL
),
gaps AS (
  SELECT "PID",
         MAX(COALESCE(nxt - y,0)) AS max_gap
  FROM   ordered
  GROUP  BY "PID"
)
SELECT g."PID", TRIM(p."Name") AS actor_name
FROM   gaps AS g
JOIN   "Person" AS p ON p."PID" = g."PID"
WHERE  g.max_gap <= 3
LIMIT 20;
```

```sql
--10) Count how many actors meet the “no 4‑year gap” criterion (the final answer count)
WITH ordered AS (
  SELECT mc."PID",
         CAST(m."year" AS INTEGER) AS y,
         LEAD(CAST(m."year" AS INTEGER))
             OVER (PARTITION BY mc."PID" ORDER BY CAST(m."year" AS INTEGER)) AS nxt
  FROM   "M_Cast" AS mc
  JOIN   "Movie"  AS m ON m."MID" = mc."MID"
  WHERE  m."year" IS NOT NULL
),
gaps AS (
  SELECT "PID",
         MAX(COALESCE(nxt - y,0)) AS max_gap
  FROM   ordered
  GROUP BY "PID"
)
SELECT COUNT(*) AS actors_without_4year_gap
FROM   gaps
WHERE  max_gap <= 3;
```
