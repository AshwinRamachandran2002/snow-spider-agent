Query:
--Description: 10) Final count of actors who never experienced a ≥4‑year gap without a movie credit.
WITH ordered AS (
    SELECT
           TRIM(mc."PID")                                                AS PID,
           CAST(m."year" AS INTEGER)                                     AS y,
           LEAD(CAST(m."year" AS INTEGER)) OVER (PARTITION BY TRIM(mc."PID")
                                                 ORDER BY CAST(m."year" AS INTEGER)) AS nxt
    FROM   "M_Cast" AS mc
    JOIN   "Movie"  AS m ON m."MID" = mc."MID"
    WHERE  m."year" IS NOT NULL
),
gaps AS (
    SELECT  PID,
            MAX(COALESCE(nxt - y, 0)) AS max_gap
    FROM    ordered
    GROUP  BY PID
)
SELECT COUNT(*) AS actors_without_4year_gap
FROM   gaps
WHERE  max_gap <= 3
