--Description: 8) Biggest gap (in years) inside each actor’s career (sample 20); PIDs are trimmed in the CTE, so no ambiguity in GROUP BY.
WITH ordered AS (
    SELECT
           TRIM(mc."PID")                                                AS PID,
           CAST(m."year" AS INTEGER)                                     AS y,
           LEAD(CAST(m."year" AS INTEGER)) OVER (PARTITION BY TRIM(mc."PID")
                                                 ORDER BY CAST(m."year" AS INTEGER)) AS nxt
    FROM   "M_Cast" AS mc
    JOIN   "Movie"  AS m ON m."MID" = mc."MID"
    WHERE  m."year" IS NOT NULL
)
SELECT  PID,
        MAX(COALESCE(nxt - y, 0)) AS max_gap
FROM    ordered
GROUP  BY PID
LIMIT 20
