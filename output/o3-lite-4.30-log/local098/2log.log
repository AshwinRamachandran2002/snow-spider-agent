--       (Christian Bale) appeared.
-- Reasoning steps:
--   • Movie years are stored in Movie.year; actor‑movie links are in M_Cast.
--   • Join M_Cast to Movie on MID to attach each credit’s year.
--   • PIDs in M_Cast have a leading space, so TRIM() is used for accurate comparison.
--   • DISTINCT eliminates duplicates when an actor has multiple films in one year.
--   • CAST(year AS INTEGER) in ORDER BY ensures proper numeric ordering.
SELECT DISTINCT
       m."year"
FROM   "M_Cast" AS c
JOIN   "Movie"  AS m ON m."MID" = c."MID"
WHERE  TRIM(c."PID") = 'nm0000288'
ORDER BY CAST(m."year" AS INTEGER);
