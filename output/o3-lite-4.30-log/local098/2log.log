```sql
WITH actor_years AS (
    SELECT TRIM(c."PID") AS PID,
           CAST(m."year" AS INTEGER) AS yr
    FROM "M_Cast"  c
    JOIN "Movie"   m ON m."MID" = c."MID"
    WHERE m."year" IS NOT NULL
),
filtered_years AS (                -- ignore nonsensical years
    SELECT PID, yr
    FROM   actor_years
    WHERE  yr > 0
),
lagged AS (                         -- previous credit year for each actor
    SELECT
        PID,
        yr,
        LAG(yr) OVER (PARTITION BY PID ORDER BY yr) AS prev_yr
    FROM filtered_years
),
gap_per_actor AS (                  -- largest stretch with no credit
    SELECT
        PID,
        MAX((yr - prev_yr) - 1) AS max_gap          -- gap in empty years
    FROM lagged
    WHERE prev_yr IS NOT NULL
    GROUP BY PID
),
all_actors AS (
    SELECT DISTINCT PID FROM filtered_years
)
SELECT
    COUNT(*) AS actor_count
FROM all_actors  a
LEFT JOIN gap_per_actor g USING (PID)
WHERE COALESCE(g.max_gap,0) <= 3;   -- never a gap of 4+ empty years
```
