--Description:
-- 9) For sample actor 'nm0000288', list each credit year and the next later
--    credit year, revealing gaps.  Actor‑year pairs are first collected in a CTE
--    that trims the PID to keep things consistent.
WITH actor_years AS (
     SELECT DISTINCT
            TRIM(c."PID")            AS "PID",
            CAST(m."year" AS INTEGER) AS "yr"
     FROM   "M_Cast" AS c
     JOIN   "Movie"  AS m ON m."MID" = c."MID"
)
SELECT
       a."PID",
       a."yr"                         AS "current_year",
       MIN(b."yr")                    AS "next_year"
FROM   actor_years AS a
LEFT JOIN actor_years AS b
       ON a."PID" = b."PID" AND b."yr" > a."yr"
WHERE  a."PID" = 'nm0000288'
GROUP  BY a."PID", a."yr"
ORDER  BY a."yr"
LIMIT 20
