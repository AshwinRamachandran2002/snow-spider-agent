```sql
--Description:
-- 6) For every actor (identified by trimmed PID), report the earliest and latest
--    movie year they are credited in.  Trimming removes the leading space found in
--    M_Cast.PID so each performer is counted only once.
SELECT
       TRIM(c."PID")                         AS "PID",
       MIN(CAST(m."year" AS INTEGER))        AS "first_year",
       MAX(CAST(m."year" AS INTEGER))        AS "last_year"
FROM   "M_Cast" AS c
JOIN   "Movie"  AS m ON m."MID" = c."MID"
GROUP  BY TRIM(c."PID")
LIMIT 20;
```

```sql
--Description:
-- 7) Count total movie appearances per actor.  Using TRIM on PID guarantees all
--    credits for a given person collapse to the same identifier.
SELECT
       TRIM(c."PID")          AS "PID",
       COUNT(*)               AS "num_credits"
FROM   "M_Cast" AS c
GROUP  BY TRIM(c."PID")
ORDER  BY "num_credits" DESC
LIMIT 20;
```

```sql
--Description:
-- 8) Produce one row per actor‑year pair (deduplicated).  This table‑like
--    result is the atomic input for any gap analysis.
SELECT DISTINCT
       TRIM(c."PID")                   AS "PID",
       CAST(m."year" AS INTEGER)       AS "yr"
FROM   "M_Cast" AS c
JOIN   "Movie"  AS m ON m."MID" = c."MID"
ORDER  BY TRIM(c."PID"), "yr"
LIMIT 20;
```

```sql
--Description:
-- 9) For sample actor 'nm0000288', list each credit year and the next later
--    credit year, revealing gaps.  Actor‑year pairs are first collected in a CTE
--    that trims the PID to keep things consistent.
WITH actor_years AS (
     SELECT DISTINCT
            TRIM(c."PID")            AS "PID",
            CAST(m."year" AS INTEGER) AS "yr"
     FROM   "M_Cast" AS c
     JOIN   "Movie"  AS m ON m."MID" = c."MID"
)
SELECT
       a."PID",
       a."yr"                         AS "current_year",
       MIN(b."yr")                    AS "next_year"
FROM   actor_years AS a
LEFT JOIN actor_years AS b
       ON a."PID" = b."PID" AND b."yr" > a."yr"
WHERE  a."PID" = 'nm0000288'
GROUP  BY a."PID", a."yr"
ORDER  BY a."yr"
LIMIT 20;
```

```sql
--Description:
-- 10) Retrieve actors who experience at least one gap of four or more consecutive
--     years without a movie credit.  The sub‑query g finds every gap ≥ 4; selecting
--     actors NOT in this set would yield performers with no such gaps.
WITH actor_years AS (
     SELECT DISTINCT
            TRIM(c."PID")            AS "PID",
            CAST(m."year" AS INTEGER) AS "yr"
     FROM   "M_Cast" AS c
     JOIN   "Movie"  AS m ON m."MID" = c."MID"
)
SELECT DISTINCT
       g."PID"
FROM (
      SELECT
             a."PID",
             MIN(b."yr") - a."yr"    AS "gap"
      FROM   actor_years AS a
      JOIN   actor_years AS b
             ON a."PID" = b."PID" AND b."yr" > a."yr"
      GROUP  BY a."PID", a."yr"
      HAVING MIN(b."yr") - a."yr" >= 4
     ) AS g
LIMIT 20;
```
