2025-05-01 03:22:41 - Thread-1364 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
• Person."PID": unique identifier for each actor/actress – used to group appearances by performer.  
• Person."Name": optional for display.  
• M_Cast."PID": foreign‑key that connects a performer to a film.  
• M_Cast."MID": foreign‑key that connects a film to a performer.  
• Movie."MID": joins to M_Cast to reach the film year.  
• Movie."year": appearance year (TEXT → cast to INTEGER) – used to detect gaps between consecutive movies.  

Typical join / filter conditions  
• Person."PID" = M_Cast."PID"  
• M_Cast."MID"  = Movie."MID"  
• CAST(Movie."year" AS INTEGER) converts the TEXT year to a number in order to apply arithmetic such as  (next_year – prev_year) > 3.  

------------------------------------------------------------------------  
Exploratory & build‑up queries (each limited to 20 rows)

```sql
-- 1) Show the first 20 performers
SELECT DISTINCT "PID", "Name"
FROM "Person"
LIMIT 20;
```

```sql
-- 2) What cast records look like
SELECT *
FROM "M_Cast"
LIMIT 20;
```

```sql
-- 3) Join a few cast records with their movie titles and years
SELECT mc."PID", m."title", m."year"
FROM "M_Cast"  AS mc
JOIN "Movie"   AS m  ON mc."MID" = m."MID"
LIMIT 20;
```

```sql
-- 4) Distinct (actor, year) pairs on which the analysis will rely
SELECT DISTINCT mc."PID",
       CAST(m."year" AS INTEGER) AS "yr"
FROM "M_Cast" AS mc
JOIN "Movie"  AS m ON m."MID" = mc."MID"
ORDER BY mc."PID", "yr"
LIMIT 20;
```

```sql
-- 5) Minimum and maximum year for each actor
SELECT mc."PID",
       MIN(CAST(m."year" AS INTEGER)) AS "first_year",
       MAX(CAST(m."year" AS INTEGER)) AS "last_year"
FROM "M_Cast" AS mc
JOIN "Movie"  AS m ON m."MID" = mc."MID"
GROUP BY mc."PID"
LIMIT 20;
```

```sql
-- 6) Consecutive‑year gaps for one sample actor (replace 'nm0000288' if desired)
WITH years AS (
  SELECT DISTINCT CAST(m."year" AS INTEGER) AS yr
  FROM "M_Cast" AS mc
  JOIN "Movie"  AS m ON m."MID" = mc."MID"
  WHERE mc."PID" = 'nm0000288'
)
SELECT yr,
       LAG(yr) OVER (ORDER BY yr) AS prev_yr,
       yr - LAG(yr) OVER (ORDER BY yr) AS diff
FROM years
ORDER BY yr
LIMIT 20;
```

```sql
-- 7) All (actor, gap) rows where the gap exceeds 3 years
WITH actor_years AS (
  SELECT DISTINCT mc."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM "M_Cast" AS mc
  JOIN "Movie"  AS m ON m."MID" = mc."MID"
),
ordered AS (
  SELECT "PID", yr,
         LAG(yr) OVER (PARTITION BY "PID" ORDER BY yr) AS prev_yr
  FROM actor_years
)
SELECT *
FROM ordered
WHERE prev_yr IS NOT NULL
  AND (yr - prev_yr) > 3
LIMIT 20;
```

```sql
-- 8) List actors who ever had such a 4‑year gap
WITH actor_years AS (
  SELECT DISTINCT mc."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM "M_Cast" AS mc
  JOIN "Movie"  AS m ON m."MID" = mc."MID"
),
ordered AS (
  SELECT "PID", yr,
         LAG(yr) OVER (PARTITION BY "PID" ORDER BY yr) AS prev_yr
  FROM actor_years
)
SELECT DISTINCT "PID"
FROM ordered
WHERE prev_yr IS NOT NULL
  AND (yr - prev_yr) > 3
LIMIT 20;
```

```sql
-- 9) Actors whose whole career has NO gap longer than 3 years
WITH actor_years AS (
  SELECT DISTINCT mc."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM "M_Cast" AS mc
  JOIN "Movie"  AS m ON m."MID" = mc."MID"
),
ordered AS (
  SELECT "PID", yr,
         LAG(yr) OVER (PARTITION BY "PID" ORDER BY yr) AS prev_yr
  FROM actor_years
),
gap_actors AS (
  SELECT DISTINCT "PID"
  FROM ordered
  WHERE prev_yr IS NOT NULL
    AND (yr - prev_yr) > 3
)
SELECT DISTINCT ay."PID"
FROM actor_years AS ay
WHERE ay."PID" NOT IN (SELECT "PID" FROM gap_actors)
LIMIT 20;
```

```sql
-- 10) Final answer: how many actors never had a 4‑year span with no film credit
WITH actor_years AS (
  SELECT DISTINCT mc."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM "M_Cast" AS mc
  JOIN "Movie"  AS m ON m."MID" = mc."MID"
),
ordered AS (
  SELECT "PID", yr,
         LAG(yr) OVER (PARTITION BY "PID" ORDER BY yr) AS prev_yr
  FROM actor_years
),
gap_actors AS (
  SELECT DISTINCT "PID"
  FROM ordered
  WHERE prev_yr IS NOT NULL
    AND (yr - prev_yr) > 3
),
steady_actors AS (
  SELECT DISTINCT ay."PID"
  FROM actor_years AS ay
  WHERE ay."PID" NOT IN (SELECT "PID" FROM gap_actors)
)
SELECT COUNT(*) AS "actors_without_4_year_gap"
FROM steady_actors;
```

The very last query returns the required count of performers whose active span—from their first film to their latest—never contains four consecutive years without at least one appearance.
