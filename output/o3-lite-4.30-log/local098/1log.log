```sql
--Description:  
--Goal: count how many performers never experience a gap of 4 or more consecutive years
--      without at least one film credit, from their first to last appearance.  
--Step‑1  Gather every (actor, year) pair from M_Cast ↔ Movie, trimming PID to remove
--        leading blanks; convert Movie.year (TEXT) to INTEGER for arithmetic.  
--Step‑2  For each actor order their appearance years and, with LAG, find the previous
--        appearance year to compute the gap.  
--Step‑3  Identify actors who ever have a gap > 3 (i.e., 4‑year span with no credit).  
--Step‑4  Actors *not* in that “gap” set satisfy the requirement; finally count them.  
WITH actor_years AS (
    SELECT DISTINCT TRIM(mc."PID") AS PID,
           CAST(m."year" AS INTEGER) AS yr
    FROM "M_Cast" AS mc
    JOIN "Movie"   AS m ON mc."MID" = m."MID"
),
ordered AS (
    SELECT PID,
           yr,
           LAG(yr) OVER (PARTITION BY PID ORDER BY yr) AS prev_yr
    FROM actor_years
),
gap_actors AS (
    SELECT DISTINCT PID
    FROM ordered
    WHERE prev_yr IS NOT NULL
      AND (yr - prev_yr) > 3          -- gap ≥ 4 years
),
steady_actors AS (
    SELECT DISTINCT PID
    FROM actor_years
    WHERE PID NOT IN (SELECT PID FROM gap_actors)
)
SELECT COUNT(*) AS actors_without_4_year_gap
FROM steady_actors;
```
