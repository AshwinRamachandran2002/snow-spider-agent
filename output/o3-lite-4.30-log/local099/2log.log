Begin Exploring Related Columns
Relevant columns and their usage  

• Person.Name : to identify “Yash Chopra” and every actor’s readable name  
• Person.PID  : unique key of every person – lets us join names to the cross‑link tables  
• M_Director.MID / M_Director.PID : tells which person(s) directed which movie(s)  
• M_Cast.MID / M_Cast.PID : tells which person(s) acted in which movie(s)  
• Movie.MID   : movie identifier – the bridge that lets us compare director‑actor pairs  

Typical conditions we will need  

• TRIM(Person.Name) = 'Yash Chopra'  – to fetch his PID  
• director_PID = yash_pid             – limit rows to films he directed  
• GROUP BY actor_PID, director_PID    – count collaborations  
• HAVING yash_cnt > MAX(other_cnt)    – actor has more films with Yash Chopra than with anyone else  

SQL “drill‑down” – 10 progressive queries (each limited to 20 rows)  

```sql
-- 1. List a few names that look like Yash Chopra to learn his exact spelling
SELECT DISTINCT TRIM("Name") AS person_name
FROM "Person"
WHERE TRIM("Name") LIKE '%Yash%Chopra%'
LIMIT 20;
```

```sql
-- 2. Get Yash Chopra’s PID
SELECT "PID"
FROM "Person"
WHERE TRIM("Name") = 'Yash Chopra'
LIMIT 20;
```

```sql
-- 3. Movies directed by Yash Chopra (by MID and title)
SELECT md."MID", mv."title"
FROM   "M_Director" AS md
JOIN   "Movie"      AS mv ON mv."MID" = md."MID"
WHERE  md."PID" = (SELECT "PID"
                   FROM "Person"
                   WHERE TRIM("Name") = 'Yash Chopra')
LIMIT 20;
```

```sql
-- 4. All actors who appeared in a Yash‑Chopra‑directed movie
SELECT DISTINCT mc."PID" AS actor_pid
FROM   "M_Cast"     AS mc
JOIN   "M_Director" AS md ON md."MID" = mc."MID"
WHERE  md."PID" = (SELECT "PID"
                   FROM "Person"
                   WHERE TRIM("Name") = 'Yash Chopra')
LIMIT 20;
```

```sql
-- 5. Show actor names together with the number of Yash‑Chopra films they acted in
SELECT p."Name"  AS actor_name,
       COUNT(*)  AS yash_cnt
FROM   "M_Cast"     AS mc
JOIN   "M_Director" AS md ON md."MID" = mc."MID"
JOIN   "Person"     AS p  ON p."PID"  = mc."PID"
WHERE  md."PID" = (SELECT "PID"
                   FROM "Person"
                   WHERE TRIM("Name") = 'Yash Chopra')
GROUP  BY mc."PID"
ORDER  BY yash_cnt DESC
LIMIT 20;
```

```sql
-- 6. Every director–actor pair with their collaboration count (first 20 rows)
SELECT md."PID"          AS director_pid,
       mc."PID"          AS actor_pid,
       COUNT(*)          AS films_together
FROM   "M_Cast"     AS mc
JOIN   "M_Director" AS md ON md."MID" = mc."MID"
GROUP  BY director_pid, actor_pid
LIMIT 20;
```

```sql
-- 7. For each actor, find the max films made with ANY director
WITH pair_cnt AS (
  SELECT md."PID" AS director_pid,
         mc."PID" AS actor_pid,
         COUNT(*) AS films_together
  FROM   "M_Cast" AS mc
  JOIN   "M_Director" AS md ON md."MID" = mc."MID"
  GROUP  BY director_pid, actor_pid
)
SELECT actor_pid,
       MAX(films_together) AS max_with_any_director
FROM   pair_cnt
GROUP  BY actor_pid
LIMIT 20;
```

```sql
-- 8. How many films each actor made with Yash Chopra
WITH yash_id AS (
  SELECT "PID" AS yash_pid
  FROM   "Person"
  WHERE  TRIM("Name") = 'Yash Chopra'
),
yash_actor_cnt AS (
  SELECT mc."PID" AS actor_pid,
         COUNT(*) AS yash_cnt
  FROM   "M_Cast"     AS mc
  JOIN   "M_Director" AS md ON md."MID" = mc."MID"
  WHERE  md."PID" = (SELECT yash_pid FROM yash_id)
  GROUP  BY actor_pid
)
SELECT *
FROM   yash_actor_cnt
ORDER  BY yash_cnt DESC
LIMIT 20;
```

```sql
-- 9. Combine: actor’s yash_cnt and their overall best director count
WITH yash_id AS (
  SELECT "PID" AS yash_pid
  FROM   "Person"
  WHERE  TRIM("Name") = 'Yash Chopra'
),
pair_cnt AS (
  SELECT md."PID" AS director_pid,
         mc."PID" AS actor_pid,
         COUNT(*) AS films_together
  FROM   "M_Cast" AS mc
  JOIN   "M_Director" AS md ON md."MID" = mc."MID"
  GROUP  BY director_pid, actor_pid
),
best_any AS (
  SELECT actor_pid,
         MAX(films_together) AS best_overall
  FROM   pair_cnt
  GROUP  BY actor_pid
),
with_yash AS (
  SELECT actor_pid, films_together AS yash_cnt
  FROM   pair_cnt
  WHERE  director_pid = (SELECT yash_pid FROM yash_id)
)
SELECT bys.actor_pid,
       bys.yash_cnt,
       ba.best_overall
FROM   with_yash AS bys
JOIN   best_any  AS ba ON ba.actor_pid = bys.actor_pid
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: number of actors whose film count with Yash Chopra
--                    is strictly greater than with any other director
WITH yash_id AS (
  SELECT "PID" AS yash_pid
  FROM   "Person"
  WHERE  TRIM("Name") = 'Yash Chopra'
),
pair_cnt AS (
  SELECT md."PID" AS director_pid,
         mc."PID" AS actor_pid,
         COUNT(*) AS films_together
  FROM   "M_Cast" AS mc
  JOIN   "M_Director" AS md ON md."MID" = mc."MID"
  GROUP  BY director_pid, actor_pid
),
best_any AS (
  SELECT actor_pid,
         MAX(films_together) AS best_overall
  FROM   pair_cnt
  GROUP  BY actor_pid
),
with_yash AS (
  SELECT actor_pid, films_together AS yash_cnt
  FROM   pair_cnt
  WHERE  director_pid = (SELECT yash_pid FROM yash_id)
)
SELECT COUNT(*) AS actors_preferring_yash_chopra
FROM   with_yash  AS y
JOIN   best_any   AS b ON b.actor_pid = y.actor_pid
WHERE  y.yash_cnt > b.best_overall - y.yash_cnt;   -- yash_cnt > any other director
```
