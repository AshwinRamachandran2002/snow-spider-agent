```sql
--Description (thinking process inline):
--  • First get Yash Chopra’s PID (yash_pid).
--  • Build a table (pair) that counts how many films each actor made with each director.
--  • From that, isolate the Yash‑actor counts (yash_actor) and, separately, for
--    every actor the highest count with any non‑Yash director (actor_best_other).
--  • Finally count actors whose Yash count is larger than their best non‑Yash count
--    (NULL ⇒ 0, meaning they worked only with Yash).
WITH yash_pid AS (
    SELECT TRIM("PID") AS pid
    FROM   "Person"
    WHERE  TRIM("Name") = 'Yash Chopra'
    LIMIT 1
),
pair AS (
    SELECT TRIM(md."PID") AS director_pid,
           TRIM(mc."PID") AS actor_pid,
           COUNT(*)       AS films_together
    FROM   "M_Director" md
    JOIN   "M_Cast"     mc ON md."MID" = mc."MID"
    GROUP  BY director_pid, actor_pid
),
yash_actor AS (
    SELECT actor_pid,
           films_together AS yash_films
    FROM   pair, yash_pid
    WHERE  director_pid = yash_pid.pid
),
actor_best_other AS (
    SELECT actor_pid,
           MAX(films_together) AS best_other_films
    FROM   pair, yash_pid
    WHERE  director_pid <> yash_pid.pid
    GROUP  BY actor_pid
)
SELECT COUNT(*) AS actors_preferring_yash_chopra
FROM   yash_actor ya
LEFT   JOIN actor_best_other ao ON ao.actor_pid = ya.actor_pid
WHERE  ya.yash_films > COALESCE(ao.best_other_films, 0);
```
