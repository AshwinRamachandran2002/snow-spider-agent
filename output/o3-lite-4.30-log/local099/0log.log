JOIN   M_Director  AS d  ON TRIM(d.PID) = TRIM(p_director.PID)
JOIN   M_Cast      AS c  ON c.MID      = d.MID
JOIN   Person      AS p_actor ON TRIM(p_actor.PID) = TRIM(c.PID)
WHERE  TRIM(p_director.Name) = 'Yash Chopra'
LIMIT 20;
