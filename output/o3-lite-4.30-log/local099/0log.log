--1) we first locate movies whose director’s Person.Name (after TRIM to remove leading blanks) equals 'Yash Chopra'.  
--2) We join those movies to M_Cast to fetch all performers in the same films.  
--3) Both Person.PID and M_Cast.PID can contain leading spaces, so we join on TRIM(PID) for reliable matching.  
--4) DISTINCT prevents duplicates; LIMIT 20 just shows a sample.
SELECT DISTINCT
       TRIM(p_actor.Name) AS actor_name,
