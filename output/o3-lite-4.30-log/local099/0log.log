        TRIM(c.PID)     AS actor_pid,
        TRIM(pd.Name)   AS director_name,
        COUNT(*)        AS films_together
FROM    M_Director AS d
JOIN    Person     AS pd ON TRIM(pd.PID) = TRIM(d.PID)   -- director
JOIN    M_Cast     AS c  ON c.MID = d.MID
JOIN    Person     AS pr ON TRIM(pr.PID) = TRIM(c.PID)   -- actor
