Begin Exploring Related Columns
Relevant columns, their potential usage and typical filter conditions  
• Person.PID: unique person identifier – link performers/directors/producers in the bridge tables.  
• Person.Name: human‑readable name – filter for ‘Yash Chopra’, actors, etc.  (WHERE TRIM(Name)=’Yash Chopra’)  
• M_Director.MID / M_Director.PID: relates movies to directors – find all films directed by a given director.  
• Movie.MID / Movie.title / Movie.year: movie information – verify titles or years if needed.  
• M_Cast.MID / M_Cast.PID: relates movies to actors – count how many times every actor was in a director’s movies.  
• (optional) M_Director.ID / M_Cast.ID: not needed for logic, just surrogate keys.  

We shall gradually explore the data and finally obtain  
“the number of actors whose count of films with Yash Chopra is strictly larger than the count with every other single director”.

Below are ten illustrative SELECT queries (each limited to 20 rows) in increasing complexity, concluding with the final answer.  
(Use TRIM(Name) because many names in the sample hold leading spaces.)

```sql
-- 1. List all rows in Person that exactly match the director’s name (sanity‑check).
SELECT *
FROM Person
WHERE TRIM(Name) = 'Yash Chopra'
LIMIT 20;
```

```sql
-- 2. Get every director’s PID and cleaned name (overview of possible directors).
SELECT DISTINCT TRIM(p.Name) AS director_name,
       d.PID      AS director_pid
FROM M_Director AS d
JOIN Person     AS p ON p.PID = d.PID
LIMIT 20;
```

```sql
-- 3. Retrieve the movies directed by Yash Chopra.
SELECT m.MID,
       m.title,
       m.year
FROM   M_Director AS d
JOIN   Person     AS p ON p.PID = d.PID
JOIN   Movie      AS m ON m.MID = d.MID
WHERE  TRIM(p.Name) = 'Yash Chopra'
LIMIT 20;
```

```sql
-- 4. Actors (PID + name) who acted in at least one Yash Chopra film.
SELECT DISTINCT TRIM(pr.Name) AS actor_name,
       pr.PID                AS actor_pid
FROM   M_Director AS d
JOIN   Person     AS pd ON pd.PID = d.PID
JOIN   M_Cast     AS c  ON c.MID = d.MID          -- same movie
JOIN   Person     AS pr ON pr.PID = c.PID
WHERE  TRIM(pd.Name) = 'Yash Chopra'
LIMIT 20;
```

```sql
-- 5. Count how many Yash Chopra movies each actor appeared in.
SELECT   c.PID                               AS actor_pid,
         COUNT(*)                            AS yash_films
FROM     M_Director AS d
JOIN     Person     AS pd ON pd.PID = d.PID
JOIN     M_Cast     AS c  ON c.MID = d.MID
WHERE    TRIM(pd.Name) = 'Yash Chopra'
GROUP BY c.PID
ORDER BY yash_films DESC
LIMIT 20;
```

```sql
-- 6. Count how many films every actor has done with every director (not just YC).
SELECT  TRIM(pr.Name)            AS actor_name,
        c.PID                    AS actor_pid,
        TRIM(pd.Name)            AS director_name,
        COUNT(*)                 AS films_together
FROM    M_Director AS d
JOIN    Person     AS pd ON pd.PID = d.PID        -- director
JOIN    M_Cast     AS c  ON c.MID = d.MID
JOIN    Person     AS pr ON pr.PID = c.PID        -- actor
GROUP BY c.PID, d.PID
ORDER BY actor_pid
LIMIT 20;
```

```sql
-- 7. For each actor, get their maximum films with *any* director other than Yash Chopra.
WITH per_pair AS (
  SELECT c.PID          AS actor_pid,
         d.PID          AS director_pid,
         COUNT(*)       AS films_together
  FROM   M_Director AS d
  JOIN   Person     AS pd ON pd.PID = d.PID
  JOIN   M_Cast     AS c  ON c.MID = d.MID
  WHERE  TRIM(pd.Name) <> 'Yash Chopra'
  GROUP  BY c.PID, d.PID
)
SELECT actor_pid,
       MAX(films_together) AS max_with_others
FROM   per_pair
GROUP  BY actor_pid
LIMIT 20;
```

```sql
-- 8. Combine Yash‑count and max‑other‑count side‑by‑side for each actor.
WITH yfilms AS (
  SELECT c.PID  AS actor_pid,
         COUNT(*) AS yash_films
  FROM   M_Director AS d
  JOIN   Person     AS pd ON pd.PID = d.PID
  JOIN   M_Cast     AS c  ON c.MID = d.MID
  WHERE  TRIM(pd.Name) = 'Yash Chopra'
  GROUP  BY c.PID
),
other_max AS (
  SELECT actor_pid,
         MAX(films_together) AS max_with_others
  FROM (
      SELECT c.PID          AS actor_pid,
             COUNT(*)       AS films_together
      FROM   M_Director AS d
      JOIN   Person     AS pd ON pd.PID = d.PID
      JOIN   M_Cast     AS c  ON c.MID = d.MID
      WHERE  TRIM(pd.Name) <> 'Yash Chopra'
      GROUP  BY c.PID, d.PID
  )
  GROUP BY actor_pid
)
SELECT y.actor_pid,
       y.yash_films,
       COALESCE(o.max_with_others, 0) AS max_with_others
FROM   yfilms AS y
LEFT JOIN other_max AS o USING (actor_pid)
LIMIT 20;
```

```sql
-- 9. Filter actors whose Yash‑film count is strictly higher than their max with any other director.
WITH yfilms AS (
  SELECT c.PID  AS actor_pid,
         COUNT(*) AS yash_films
  FROM   M_Director AS d
  JOIN   Person     AS pd ON pd.PID = d.PID
  JOIN   M_Cast     AS c  ON c.MID = d.MID
  WHERE  TRIM(pd.Name) = 'Yash Chopra'
  GROUP  BY c.PID
),
other_max AS (
  SELECT actor_pid,
         MAX(films_together) AS max_with_others
  FROM (
      SELECT c.PID          AS actor_pid,
             COUNT(*)       AS films_together
      FROM   M_Director AS d
      JOIN   Person     AS pd ON pd.PID = d.PID
      JOIN   M_Cast     AS c  ON c.MID = d.MID
      WHERE  TRIM(pd.Name) <> 'Yash Chopra'
      GROUP  BY c.PID, d.PID
  )
  GROUP BY actor_pid
)
SELECT   y.actor_pid
FROM     yfilms AS y
LEFT JOIN other_max AS o USING (actor_pid)
WHERE    y.yash_films > COALESCE(o.max_with_others,0)
LIMIT 20;
```

```sql
-- 10. Final answer: total number of such actors.
WITH yfilms AS (
  SELECT c.PID  AS actor_pid,
         COUNT(*) AS yash_films
  FROM   M_Director AS d
  JOIN   Person     AS pd ON pd.PID = d.PID
  JOIN   M_Cast     AS c  ON c.MID = d.MID
  WHERE  TRIM(pd.Name) = 'Yash Chopra'
  GROUP  BY c.PID
),
other_max AS (
  SELECT actor_pid,
         MAX(films_together) AS max_with_others
  FROM (
      SELECT c.PID          AS actor_pid,
             COUNT(*)       AS films_together
      FROM   M_Director AS d
      JOIN   Person     AS pd ON pd.PID = d.PID
      JOIN   M_Cast     AS c  ON c.MID = d.MID
      WHERE  TRIM(pd.Name) <> 'Yash Chopra'
      GROUP  BY c.PID, d.PID
  )
  GROUP BY actor_pid
)
SELECT COUNT(*) AS actors_preferring_yash_chopra
FROM (
  SELECT y.actor_pid
  FROM   yfilms AS y
  LEFT JOIN other_max AS o USING (actor_pid)
  WHERE  y.yash_films > COALESCE(o.max_with_others,0)
) AS preferred;
```

These ten queries progressively reveal the data, culminating in the final query that returns the number of actors who have acted in more films with Yash Chopra than with any other individual director.
