Query:
--Description: 10) Final result – the number of actors who have appeared in more Yash Chopra films than with any other single director.
WITH yfilms AS (
    SELECT  TRIM(c.PID) AS actor_pid,
            COUNT(*)    AS yash_films
    FROM    M_Director AS d
    JOIN    Person     AS pd ON TRIM(pd.PID) = TRIM(d.PID)
    JOIN    M_Cast     AS c  ON c.MID = d.MID
    WHERE   TRIM(pd.Name) = 'Yash Chopra'
    GROUP BY TRIM(c.PID)
),
other_max AS (
    SELECT  actor_pid,
            MAX(films_together) AS max_with_others
    FROM   (
        SELECT  TRIM(c.PID) AS actor_pid,
                COUNT(*)    AS films_together
        FROM    M_Director AS d
        JOIN    Person     AS pd ON TRIM(pd.PID) = TRIM(d.PID)
        JOIN    M_Cast     AS c  ON c.MID = d.MID
        WHERE   TRIM(pd.Name) <> 'Yash Chopra'
        GROUP BY TRIM(c.PID), TRIM(d.PID)
    )
    GROUP BY actor_pid
)
SELECT  COUNT(*) AS actors_preferring_yash_chopra
FROM   (
    SELECT y.actor_pid
    FROM   yfilms AS y
    LEFT  JOIN other_max AS o USING (actor_pid)
    WHERE  y.yash_films > COALESCE(o.max_with_others,0)
) AS preferred
