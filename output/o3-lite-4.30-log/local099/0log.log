--Description: 5) Count how many Yash Chopra movies each actor appeared in, fixing joins with TRIM on IDs that may contain leading blanks.
SELECT  TRIM(c.PID)                     AS actor_pid,
        COUNT(*)                        AS yash_films
FROM    M_Director  AS d
JOIN    Person      AS pd ON TRIM(pd.PID) = TRIM(d.PID)   -- pick the director
JOIN    M_Cast      AS c  ON c.MID = d.MID                -- same movie
WHERE   TRIM(pd.Name) = 'Yash Chopra'
GROUP BY TRIM(c.PID)
ORDER BY yash_films DESC
LIMIT 20
