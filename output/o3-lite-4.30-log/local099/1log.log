```sql
--Description: Actors whose number of films with Yash Chopra is strictly greater than the best they have  
--with any other director (top 20).  LEFT JOIN + COALESCE covers actors who never worked with others.
SELECT y.actor_pid,
       y.actor_name,
       y.yash_collabs
FROM (
    SELECT TRIM(c."PID") AS actor_pid,
           p."Name"      AS actor_name,
           COUNT(*)      AS yash_collabs
    FROM   "M_Cast"      AS c
    JOIN   "M_Director"  AS d ON d."MID" = c."MID"
    JOIN   "Person"      AS p ON p."PID" = TRIM(c."PID")
    WHERE  TRIM(d."PID") = 'nm0007181'
    GROUP BY actor_pid
) y
LEFT JOIN (
    SELECT actor_pid,
           MAX(collabs) AS best_with_other
    FROM (
        SELECT TRIM(c."PID") AS actor_pid,
               TRIM(d."PID") AS director_pid,
               COUNT(*)      AS collabs
        FROM   "M_Cast"      AS c
        JOIN   "M_Director"  AS d ON d."MID" = c."MID"
        WHERE  TRIM(d."PID") <> 'nm0007181'
        GROUP BY actor_pid, director_pid
    ) q
    GROUP BY actor_pid
) o ON y.actor_pid = o.actor_pid
WHERE y.yash_collabs > COALESCE(o.best_with_other, 0)
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – how many actors have made more films with Yash Chopra than with any other director.  
--Same logic as previous query but reduced to a COUNT(*).
SELECT COUNT(*) AS actors_more_with_yash
FROM (
    SELECT y.actor_pid
    FROM (
        SELECT TRIM(c."PID") AS actor_pid,
               COUNT(*)      AS yash_collabs
        FROM   "M_Cast"     AS c
        JOIN   "M_Director" AS d ON d."MID" = c."MID"
        WHERE  TRIM(d."PID") = 'nm0007181'
        GROUP BY actor_pid
    ) y
    LEFT JOIN (
        SELECT actor_pid,
               MAX(collabs) AS best_with_other
        FROM (
            SELECT TRIM(c."PID") AS actor_pid,
                   TRIM(d."PID") AS director_pid,
                   COUNT(*)      AS collabs
            FROM   "M_Cast"     AS c
            JOIN   "M_Director" AS d ON d."MID" = c."MID"
            WHERE  TRIM(d."PID") <> 'nm0007181'
            GROUP BY actor_pid, director_pid
        ) x
        GROUP BY actor_pid
    ) o ON y.actor_pid = o.actor_pid
    WHERE y.yash_collabs > COALESCE(o.best_with_other, 0)
) final;
