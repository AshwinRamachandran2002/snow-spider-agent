Relevant columns and their potential usage for this task  
• Person."Name": to locate the row that contains the director “Yash Chopra”.  
• Person."PID": the unique identifier for the person; needed to join with the movie/crew tables.  
• M_Director."PID": director’s PID on each film – used to find every movie Yash Chopra directed.  
• M_Director."MID": the movie ID each director worked on – lets us connect to cast, title, etc.  
• M_Cast."MID": movie IDs each actor appeared in – lets us know which actors worked on which films.  
• M_Cast."PID": actor PID for every role – required to count collaborations.  
• Movie."MID", Movie."title": optional for readability in intermediate checks.

Typical conditions that will appear  
• Person."Name" LIKE '%Yash Chopra%'   -- get the director’s PID.  
• M_Director."PID" = :yash_pid         -- movies directed by Yash Chopra.  
• M_Cast."MID" = M_Director."MID"      -- actors in those movies.  
• GROUP BY M_Cast."PID"                -- count collaborations for each actor.  
• HAVING COUNT(*) > …                  -- filter counts.  
• Comparison of counts between Yash Chopra and every other director for every actor.

Ten exploratory SQL queries (run in order; each LIMITs to 20 rows)

```sql
--1. Get the exact Person row(s) whose name contains ‘Yash Chopra’
SELECT DISTINCT "PID", "Name"
FROM "Person"
WHERE "Name" LIKE '%Yash Chopra%'
LIMIT 20;
```

```sql
--2. List all movies (IDs and titles) that Yash Chopra directed
SELECT DISTINCT d."MID", m."title"
FROM "M_Director" AS d
JOIN "Person"      AS p ON p."PID" = d."PID"
JOIN "Movie"       AS m ON m."MID" = d."MID"
WHERE p."Name" LIKE '%Yash Chopra%'
LIMIT 20;
```

```sql
--3. Show the first 20 actors who appeared in any Yash Chopra‑directed movie
SELECT DISTINCT c."PID" AS actor_pid, pr."Name" AS actor_name
FROM "M_Cast"    AS c
JOIN "M_Director" AS d ON d."MID" = c."MID"
JOIN "Person"     AS pr ON pr."PID" = c."PID"
JOIN "Person"     AS pd ON pd."PID" = d."PID"
WHERE pd."Name" LIKE '%Yash Chopra%'
LIMIT 20;
```

```sql
--4. Count how many Yash Chopra movies each actor has worked in (top 20)
SELECT c."PID" AS actor_pid,
       pr."Name" AS actor_name,
       COUNT(*)  AS yash_collabs
FROM "M_Cast"    AS c
JOIN "M_Director" AS d ON d."MID" = c."MID"
JOIN "Person"     AS pr ON pr."PID" = c."PID"
JOIN "Person"     AS pd ON pd."PID" = d."PID"
WHERE pd."Name" LIKE '%Yash Chopra%'
GROUP BY c."PID"
ORDER BY yash_collabs DESC
LIMIT 20;
```

```sql
--5. For every actor/director pair, count joint films (sample 20 rows)
SELECT c."PID"        AS actor_pid,
       pr."Name"      AS actor_name,
       d."PID"        AS director_pid,
       pd."Name"      AS director_name,
       COUNT(*)       AS collabs
FROM "M_Cast"     AS c
JOIN "M_Director" AS d  ON d."MID" = c."MID"
JOIN "Person"     AS pr ON pr."PID" = c."PID"
JOIN "Person"     AS pd ON pd."PID" = d."PID"
GROUP BY actor_pid, director_pid
ORDER BY collabs DESC
LIMIT 20;
```

```sql
--6. For each actor, get the maximum collaboration count with ANY director
SELECT actor_pid,
       MAX(collabs) AS max_with_any_director
FROM (
    SELECT c."PID" AS actor_pid,
           d."PID" AS director_pid,
           COUNT(*) AS collabs
    FROM "M_Cast"     AS c
    JOIN "M_Director" AS d ON d."MID" = c."MID"
    GROUP BY actor_pid, director_pid
) AS t
GROUP BY actor_pid
LIMIT 20;
```

```sql
--7. Combine (4) and (6): actors whose Yash Chopra count equals their overall max
SELECT y.actor_pid,
       y.actor_name,
       y.yash_collabs
FROM (
    -- sub‑query from step 4
    SELECT c."PID" AS actor_pid,
           pr."Name" AS actor_name,
           COUNT(*)  AS yash_collabs
    FROM "M_Cast"    AS c
    JOIN "M_Director" AS d ON d."MID" = c."MID"
    JOIN "Person"     AS pr ON pr."PID" = c."PID"
    JOIN "Person"     AS pd ON pd."PID" = d."PID"
    WHERE pd."Name" LIKE '%Yash Chopra%'
    GROUP BY c."PID"
) AS y
JOIN (
    -- sub‑query from step 6
    SELECT actor_pid,
           MAX(collabs) AS max_with_any_director
    FROM (
        SELECT c."PID" AS actor_pid,
               d."PID" AS director_pid,
               COUNT(*) AS collabs
        FROM "M_Cast"     AS c
        JOIN "M_Director" AS d ON d."MID" = c."MID"
        GROUP BY actor_pid, director_pid
    ) AS q
    GROUP BY actor_pid
) AS m
ON y.actor_pid = m.actor_pid
WHERE y.yash_collabs = m.max_with_any_director
LIMIT 20;
```

```sql
--8. Actors whose Yash Chopra count is GREATER than their max with any other director
SELECT y.actor_pid,
       y.actor_name,
       y.yash_collabs
FROM (
    -- Yash Chopra counts
    SELECT c."PID"  AS actor_pid,
           pr."Name" AS actor_name,
           COUNT(*)  AS yash_collabs
    FROM "M_Cast"    AS c
    JOIN "M_Director" AS d ON d."MID" = c."MID"
    JOIN "Person"     AS pr ON pr."PID" = c."PID"
    JOIN "Person"     AS pd ON pd."PID" = d."PID"
    WHERE pd."Name" LIKE '%Yash Chopra%'
    GROUP BY c."PID"
) AS y
JOIN (
    -- best collaboration with any OTHER director
    SELECT actor_pid,
           MAX(collabs) AS best_with_other
    FROM (
        SELECT c."PID" AS actor_pid,
               d."PID" AS director_pid,
               COUNT(*) AS collabs
        FROM "M_Cast"     AS c
        JOIN "M_Director" AS d ON d."MID" = c."MID"
        WHERE d."PID" NOT IN (
            SELECT "PID" FROM "Person" WHERE "Name" LIKE '%Yash Chopra%'
        )
        GROUP BY actor_pid, director_pid
    ) AS q
    GROUP BY actor_pid
) AS o
ON y.actor_pid = o.actor_pid
WHERE y.yash_collabs > o.best_with_other
LIMIT 20;
```

```sql
--9. Count HOW MANY actors satisfy the condition of query 8 (answer we need)
SELECT COUNT(*) AS actors_more_with_yash
FROM (
    SELECT y.actor_pid
    FROM (
        -- Yash Chopra counts
        SELECT c."PID" AS actor_pid,
               COUNT(*) AS yash_collabs
        FROM "M_Cast"    AS c
        JOIN "M_Director" AS d ON d."MID" = c."MID"
        JOIN "Person"     AS pd ON pd."PID" = d."PID"
        WHERE pd."Name" LIKE '%Yash Chopra%'
        GROUP BY c."PID"
    ) AS y
    JOIN (
        -- best collaboration with other directors
        SELECT actor_pid,
               MAX(collabs) AS best_with_other
        FROM (
            SELECT c."PID" AS actor_pid,
                   d."PID" AS director_pid,
                   COUNT(*) AS collabs
            FROM "M_Cast"     AS c
            JOIN "M_Director" AS d ON d."MID" = c."MID"
            WHERE d."PID" NOT IN (
                SELECT "PID" FROM "Person" WHERE "Name" LIKE '%Yash Chopra%'
            )
            GROUP BY actor_pid, director_pid
        ) AS x
        GROUP BY actor_pid
    ) AS o
    ON y.actor_pid = o.actor_pid
    WHERE y.yash_collabs > o.best_with_other
) AS final;
```

```sql
--10. (Optional cross‑check) List those actors with the actual competing director and counts
SELECT y.actor_name,
       y.yash_collabs,
       o.best_with_other
FROM (
    -- same Yash Chopra sub‑query
    SELECT c."PID" AS actor_pid,
           pr."Name" AS actor_name,
           COUNT(*) AS yash_collabs
    FROM "M_Cast"    AS c
    JOIN "M_Director" AS d ON d."MID" = c."MID"
    JOIN "Person"     AS pr ON pr."PID" = c."PID"
    JOIN "Person"     AS pd ON pd."PID" = d."PID"
    WHERE pd."Name" LIKE '%Yash Chopra%'
    GROUP BY c."PID"
) AS y
JOIN (
    -- best_with_other sub‑query plus name of that other director
    SELECT t.actor_pid,
           t.best_with_other,
           p."Name" AS other_director_name
    FROM (
        SELECT actor_pid,
               director_pid,
               collabs AS best_with_other
        FROM (
            SELECT actor_pid,
                   director_pid,
                   collabs,
                   ROW_NUMBER() OVER (PARTITION BY actor_pid ORDER BY collabs DESC) AS rn
            FROM (
                SELECT c."PID" AS actor_pid,
                       d."PID" AS director_pid,
                       COUNT(*) AS collabs
                FROM "M_Cast"     AS c
                JOIN "M_Director" AS d ON d."MID" = c."MID"
                WHERE d."PID" NOT IN (
                    SELECT "PID" FROM "Person" WHERE "Name" LIKE '%Yash Chopra%'
                )
                GROUP BY actor_pid, director_pid
            )
        ) WHERE rn = 1
    ) AS t
    JOIN "Person" AS p ON p."PID" = t.director_pid
) AS o
ON y.actor_pid = o.actor_pid
WHERE y.yash_collabs > o.best_with_other
LIMIT 20;
```
