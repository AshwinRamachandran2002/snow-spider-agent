--Description: Cross‑check list – actors who worked more with Yash Chopra than anyone else,  
--along with their best collaboration count with another director and that director’s name (top 20).
SELECT y.actor_name,
       y.yash_collabs,
       o.other_director_name,
       o.best_with_other
FROM (
    SELECT TRIM(c."PID") AS actor_pid,
           p."Name"      AS actor_name,
           COUNT(*)      AS yash_collabs
    FROM   "M_Cast"      AS c
    JOIN   "M_Director"  AS d  ON d."MID" = c."MID"
    JOIN   "Person"      AS p  ON p."PID" = TRIM(c."PID")
    WHERE  TRIM(d."PID") = 'nm0007181'
    GROUP BY actor_pid
) y
LEFT JOIN (
    SELECT t.actor_pid,
           t.best_with_other,
           per."Name" AS other_director_name
    FROM (
        SELECT actor_pid,
               director_pid,
               collabs AS best_with_other
        FROM (
            SELECT actor_pid,
                   director_pid,
                   collabs,
                   ROW_NUMBER() OVER (PARTITION BY actor_pid ORDER BY collabs DESC) AS rn
            FROM (
                SELECT TRIM(c."PID") AS actor_pid,
                       TRIM(d."PID") AS director_pid,
                       COUNT(*)      AS collabs
                FROM   "M_Cast"      AS c
                JOIN   "M_Director"  AS d ON d."MID" = c."MID"
                WHERE  TRIM(d."PID") <> 'nm0007181'
                GROUP BY actor_pid, director_pid
            )
        ) WHERE rn = 1
    ) t
    JOIN "Person" per ON per."PID" = t.director_pid
) o ON y.actor_pid = o.actor_pid
WHERE y.yash_collabs > COALESCE(o.best_with_other, 0)
LIMIT 20
