Relevant tables, columns and their potential usage

1. veg_whsle_df  
   • whsle_date – extract year (2020‑2023) to group results  
   • item_code – join key to veg_cat and veg_loss_rate_df and veg_txn_df  
   • "whsle_px_rmb-kg" – wholesale price per kg (used for avg / max / min / cost)

2. veg_txn_df  
   • txn_date – extract year (2020‑2023) to match wholesale year  
   • item_code – join key  
   • "qty_sold(kg)" – quantity sold (used for cost, loss and revenue)  
   • "unit_selling_px_rmb/kg" – selling price per kg (used for revenue)  
   • "sale/return" – keep only 'sale' rows

3. veg_cat  
   • item_code – join key  
   • category_name – vegetable category required for the report

4. veg_loss_rate_df  
   • item_code – join key  
   • "loss_rate_%" – loss rate used to calculate average loss rate and total loss

Typical year filter condition (works for all four tables that hold dates as ISO text):  
WHERE substr(date_col,1,4) BETWEEN '2020' AND '2023'

--------------------------------------------------------------------
Ten exploratory SQL queries (from simple to complex)

```sql
-- 1. Description: Distinct wholesale years available in veg_whsle_df
SELECT DISTINCT substr("whsle_date",1,4) AS year
FROM "veg_whsle_df"
WHERE substr("whsle_date",1,4) BETWEEN '2020' AND '2023'
LIMIT 20;
```

```sql
-- 2. Description: Distinct transaction years present in veg_txn_df
SELECT DISTINCT substr("txn_date",1,4) AS year
FROM "veg_txn_df"
WHERE substr("txn_date",1,4) BETWEEN '2020' AND '2023'
LIMIT 20;
```

```sql
-- 3. Description: Sample mapping of item_code to category_name
SELECT DISTINCT v.item_code,
       c.category_name
FROM "veg_cat"  AS c
JOIN "veg_whsle_df" AS v
  ON v.item_code = c.item_code
LIMIT 20;
```

```sql
-- 4. Description: Average wholesale price per category for 2020
SELECT substr(w."whsle_date",1,4) AS year,
       c.category_name,
       ROUND(AVG(w."whsle_px_rmb-kg"),2) AS avg_wholesale_price
FROM "veg_whsle_df" w
JOIN "veg_cat"      c ON c.item_code = w.item_code
WHERE substr(w."whsle_date",1,4) = '2020'
GROUP BY year, c.category_name
LIMIT 20;
```

```sql
-- 5. Description: Total quantity sold per item in 2021 (sales only)
SELECT substr(t."txn_date",1,4) AS year,
       t.item_code,
       ROUND(SUM(t."qty_sold(kg)"),2) AS total_qty_kg
FROM "veg_txn_df" t
WHERE substr(t."txn_date",1,4) = '2021'
  AND t."sale/return" = 'sale'
GROUP BY year, t.item_code
LIMIT 20;
```

```sql
-- 6. Description: Total wholesale cost per category & year
SELECT year,
       cat.category_name,
       ROUND(SUM(qty * w_price),2) AS total_wholesale_cost
FROM (
      SELECT t.item_code,
             substr(t."txn_date",1,4)           AS year,
             SUM(t."qty_sold(kg)")              AS qty
      FROM "veg_txn_df" t
      WHERE t."sale/return"='sale'
        AND substr(t."txn_date",1,4) BETWEEN '2020' AND '2023'
      GROUP BY year, t.item_code
     ) s
JOIN "veg_whsle_df" w   ON w.item_code = s.item_code
JOIN "veg_cat"     cat ON cat.item_code = s.item_code
WHERE substr(w."whsle_date",1,4)=s.year               -- align same year
GROUP BY year, cat.category_name
LIMIT 20;
```

```sql
-- 7. Description: Total selling revenue per category & year
SELECT substr(t."txn_date",1,4) AS year,
       c.category_name,
       ROUND(SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg"),2) AS total_revenue
FROM "veg_txn_df" t
JOIN "veg_cat" c ON c.item_code = t.item_code
WHERE t."sale/return"='sale'
  AND substr(t."txn_date",1,4) BETWEEN '2020' AND '2023'
GROUP BY year, c.category_name
LIMIT 20;
```

```sql
-- 8. Description: Average loss rate (%) per category
SELECT c.category_name,
       ROUND(AVG(l."loss_rate_%"),2) AS avg_loss_rate_pct
FROM "veg_loss_rate_df" l
JOIN "veg_cat" c ON c.item_code = l.item_code
GROUP BY c.category_name
LIMIT 20;
```

```sql
-- 9. Description: Total monetary loss per category & year
SELECT year,
       c.category_name,
       ROUND(SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg" *
                 (l."loss_rate_%"/100.0)),2) AS total_loss
FROM "veg_txn_df" t
JOIN "veg_loss_rate_df" l ON l.item_code = t.item_code
JOIN "veg_cat" c         ON c.item_code = t.item_code
WHERE t."sale/return"='sale'
  AND substr(t."txn_date",1,4) BETWEEN '2020' AND '2023'
GROUP BY year, c.category_name
LIMIT 20;
```

```sql
--10. Description: Comprehensive profit summary per category & year
SELECT cat_year.year,
       cat_year.category_name,
       ROUND(cat_year.avg_wholesale_price,2)  AS avg_wholesale_price,
       ROUND(cat_year.max_wholesale_price,2)  AS max_wholesale_price,
       ROUND(cat_year.min_wholesale_price,2)  AS min_wholesale_price,
       ROUND(cat_year.max_wholesale_price - cat_year.min_wholesale_price,2) AS wholesale_price_diff,
       ROUND(costs.total_wholesale_cost,2)    AS total_wholesale_cost,
       ROUND(rev.total_revenue,2)             AS total_selling_price,
       ROUND(loss.avg_loss_rate,2)            AS avg_loss_rate_pct,
       ROUND(loss.total_loss,2)               AS total_loss,
       ROUND(rev.total_revenue - costs.total_wholesale_cost - loss.total_loss,2) AS profit
FROM (
      -- wholesale statistics per category & year
      SELECT substr(w."whsle_date",1,4)               AS year,
             c.category_name,
             AVG(w."whsle_px_rmb-kg")                 AS avg_wholesale_price,
             MAX(w."whsle_px_rmb-kg")                 AS max_wholesale_price,
             MIN(w."whsle_px_rmb-kg")                 AS min_wholesale_price
      FROM "veg_whsle_df" w
      JOIN "veg_cat" c ON c.item_code = w.item_code
      WHERE substr(w."whsle_date",1,4) BETWEEN '2020' AND '2023'
      GROUP BY year, c.category_name
     ) cat_year
JOIN (
      -- total wholesale cost
      SELECT year, category_name, SUM(cost) AS total_wholesale_cost
      FROM (
            SELECT substr(t."txn_date",1,4)                       AS year,
                   c.category_name,
                   t."qty_sold(kg)" * w."whsle_px_rmb-kg"         AS cost
            FROM "veg_txn_df" t
            JOIN "veg_whsle_df" w   ON w.item_code = t.item_code
            JOIN "veg_cat"     c    ON c.item_code = t.item_code
            WHERE t."sale/return"='sale'
              AND substr(t."txn_date",1,4) BETWEEN '2020' AND '2023'
              AND substr(w."whsle_date",1,4)=substr(t."txn_date",1,4)
           )
      GROUP BY year, category_name
     ) costs
     ON costs.year = cat_year.year AND costs.category_name = cat_year.category_name
JOIN (
      -- total revenue
      SELECT substr(t."txn_date",1,4) AS year,
             c.category_name,
             SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg") AS total_revenue
      FROM "veg_txn_df" t
      JOIN "veg_cat"    c ON c.item_code = t.item_code
      WHERE t."sale/return"='sale'
        AND substr(t."txn_date",1,4) BETWEEN '2020' AND '2023'
      GROUP BY year, c.category_name
     ) rev
     ON rev.year = cat_year.year AND rev.category_name = cat_year.category_name
JOIN (
      -- loss metrics
      SELECT substr(t."txn_date",1,4) AS year,
             c.category_name,
             AVG(l."loss_rate_%")                               AS avg_loss_rate,
             SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg" *
                 (l."loss_rate_%"/100.0))                       AS total_loss
      FROM "veg_txn_df" t
      JOIN "veg_loss_rate_df" l ON l.item_code = t.item_code
      JOIN "veg_cat"           c ON c.item_code = t.item_code
      WHERE t."sale/return"='sale'
        AND substr(t."txn_date",1,4) BETWEEN '2020' AND '2023'
      GROUP BY year, c.category_name
     ) loss
     ON loss.year = cat_year.year AND loss.category_name = cat_year.category_name
ORDER BY cat_year.year, cat_year.category_name
LIMIT 20;
```

These queries gradually inspect dates, mappings, prices, quantities, costs, revenues, losses, and finally produce a comprehensive profit analysis by category and year (2020‑2023).
