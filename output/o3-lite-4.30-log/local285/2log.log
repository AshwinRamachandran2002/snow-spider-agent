    FROM (
        -- wholesale sub‑query
        SELECT strftime('%Y', w."whsle_date") AS "year",
               c."category_name",
               SUM(w."whsle_px_rmb-kg")       AS "total_wholesale_price"
        FROM "veg_whsle_df" w
        JOIN "veg_cat"  c ON w."item_code" = c."item_code"
        WHERE strftime('%Y', w."whsle_date") BETWEEN '2020' AND '2023'
        GROUP BY strftime('%Y', w."whsle_date"), c."category_name"
    ) y
    JOIN (
        -- selling sub‑query
        SELECT strftime('%Y', t."txn_date")    AS "year",
               c."category_name",
               SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg") AS "total_sell_price"
        FROM "veg_txn_df" t
        JOIN "veg_cat" c ON t."item_code" = c."item_code"
        WHERE strftime('%Y', t."txn_date") BETWEEN '2020' AND '2023'
        GROUP BY strftime('%Y', t."txn_date"), c."category_name"
    ) s
      ON y."year" = s."year" AND y."category_name" = s."category_name"
    JOIN (
        -- average loss rate sub‑query
        SELECT c."category_name",
               AVG(l."loss_rate_%") AS "avg_loss_rate_%"
        FROM "veg_loss_rate_df" l
        JOIN "veg_cat" c ON l."item_code" = c."item_code"
        GROUP BY c."category_name"
    ) l
      ON y."category_name" = l."category_name"
) fin
LIMIT 20;
