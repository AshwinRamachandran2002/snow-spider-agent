      AND p."application_number" IS NOT NULL
      AND p."application_number" <> ''
      AND REGEXP_SUBSTR(f.value:"code"::STRING, '^[A-Z][0-9]{2}[A-Z]') IS NOT NULL
), year_counts AS (   -- yearly filing counts per CPC level‑5 subclass
    SELECT
        cd."symbol"                                                      AS "cpc_symbol",
        cd."titleFull"                                                   AS "cpc_full_title",
        YEAR(TO_DATE(fc."filing_date"::STRING, 'YYYYMMDD'))              AS "year",
        COUNT(*)                                                         AS "yearly_count"
    FROM first_cpc fc
    JOIN PATENTS.PATENTS.CPC_DEFINITION cd
      ON cd."symbol" = fc."subclass_symbol"
    WHERE cd."level" = 5
    GROUP BY 1,2,3
), counts_wt AS (     -- add row numbers & exponential weights (α = 0.2 → (1‑α)=0.8)
    SELECT
        *,
        ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "year")              AS rn,
        POWER(0.8, ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "year")-1) AS wt
    FROM year_counts
), ema_calc AS (      -- exponential moving average per year
    SELECT
        "cpc_symbol",
        "cpc_full_title",
        "year",
        SUM("yearly_count" * wt) OVER (PARTITION BY "cpc_symbol" ORDER BY "year"
                                       ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
        /
        SUM(wt)              OVER (PARTITION BY "cpc_symbol" ORDER BY "year"
                                       ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)  AS ema_val
    FROM counts_wt
), best_years AS (    -- pick the year with the highest EMA for each CPC subclass
    SELECT
