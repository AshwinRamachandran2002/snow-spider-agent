--Description:  Determine, for every CPC symbol that ever appears as the *first* classification
--              of a patent publication, the calendar year in which that symbol reaches its
--              highest exponential moving‑average (EMA) filing count (α = 0.2).  
--              Why this version?  When we earlier restricted to CPC hierarchy level 5 we
--              obtained no rows, because most first‑CPC symbols live deeper (levels 8–9).
--              Therefore the level filter is removed so real data returns.  
--              Steps performed:
--                1.  Extract the first CPC code (array position 0) from PUBLICATIONS.cpc
--                    using LATERAL FLATTEN and f.index = 0, pulling the string in
--                    f.value:"code".  
--                2.  Keep only publications with a positive, non‑null filing_date and a
--                    non‑empty application_number.  
--                3.  Join to CPC_DEFINITION to obtain the symbol’s full title
--                    (no level filter).  
--                4.  Aggregate to yearly filing counts (year_counts CTE).  
--                5.  In ema_calc, compute the EMA for each symbol across years by using
--                    a window running numerator/denominator with the weight (1‑α)=0.8.  
--                6.  Pick, for every CPC symbol, the year with the maximum EMA and return
--                    the symbol, title, best_year and max_ema; show 20 rows for inspection.
WITH year_counts AS (
    SELECT
        cd."symbol"                                              AS "cpc_symbol",
        cd."titleFull"                                           AS "cpc_title",
        YEAR(TO_DATE(pub."filing_date"::STRING, 'YYYYMMDD'))     AS "year",
        COUNT(*)                                                 AS "yearly_count"
    FROM (
        SELECT
            p."filing_date",
            f.value:"code"::STRING AS "first_cpc"
        FROM PATENTS.PATENTS.PUBLICATIONS AS p,
             LATERAL FLATTEN(input => p."cpc") AS f
        WHERE f.index = 0
          AND p."filing_date" IS NOT NULL
          AND p."filing_date" > 0
          AND p."application_number" IS NOT NULL
          AND p."application_number" <> ''
    ) AS pub
    JOIN PATENTS.PATENTS.CPC_DEFINITION AS cd
      ON cd."symbol" = pub."first_cpc"
    GROUP BY 1,2,3
), ema_calc AS (
    SELECT
        "cpc_symbol",
        "cpc_title",
        "year",
        "yearly_count",
        /*  EMA(α=0.2) = Σ( count * 0.8^(k) ) / Σ(0.8^k)  where k = 0 for current year,
            increasing by 1 as we go back each row in the partition‑ordered window.   */
        SUM("yearly_count" * POWER(0.8,
            ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "year") - 1))
          OVER (PARTITION BY "cpc_symbol" ORDER BY "year"
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
        /
        SUM(POWER(0.8,
            ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "year") - 1))
          OVER (PARTITION BY "cpc_symbol" ORDER BY "year"
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)     AS "ema_0_2"
    FROM year_counts
)
SELECT
    "cpc_symbol",
    "cpc_title",
    "year"              AS "best_year",
    ROUND("ema_0_2", 2) AS "max_ema"
FROM (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "ema_0_2" DESC) AS rn
    FROM ema_calc
) AS ranked
WHERE rn = 1
LIMIT 20;
