--                • Rank years by EMA within each subclass, keep the best year, round EMA,
--                  and limit to 20 rows for a sample.
WITH first_cpc AS (
    SELECT
        p."filing_date",
        REGEXP_SUBSTR(f.value:"code"::STRING, '^[A-Z][0-9]{2}[A-Z]') AS "subclass_symbol"
    FROM PATENTS.PATENTS.PUBLICATIONS AS p,
         LATERAL FLATTEN(input => p."cpc") AS f
    WHERE f.index = 0
      AND p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
      AND p."application_number" IS NOT NULL
      AND p."application_number" <> ''
      AND REGEXP_SUBSTR(f.value:"code"::STRING, '^[A-Z][0-9]{2}[A-Z]') IS NOT NULL
), year_counts AS (
    SELECT
        cd."symbol"                                            AS "cpc_symbol",
        cd."titleFull"                                         AS "cpc_title",
        YEAR(TO_DATE(fc."filing_date"::STRING, 'YYYYMMDD'))    AS "year",
        COUNT(*)                                               AS "yearly_count"
    FROM first_cpc fc
    JOIN PATENTS.PATENTS.CPC_DEFINITION cd
      ON cd."symbol" = fc."subclass_symbol"
    WHERE cd."level" = 5
    GROUP BY 1,2,3
), counts_nr AS (
    SELECT
        *,
        ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "year")                    AS rn,
        POWER(0.8, ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "year") - 1)    AS wt
    FROM year_counts
), ema_calc AS (
    SELECT
        "cpc_symbol",
        "cpc_title",
        "year",
        SUM("yearly_count" * wt) OVER (
            PARTITION BY "cpc_symbol" ORDER BY "year"
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        )
        /
        SUM(wt) OVER (
            PARTITION BY "cpc_symbol" ORDER BY "year"
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS ema_0_2
    FROM counts_nr
)
SELECT
    "cpc_symbol",
    "cpc_title",
    "year"              AS "best_year",
    ROUND(ema_0_2, 2)   AS "max_ema"
FROM (
    SELECT
        *,
        ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY ema_0_2 DESC) AS rnk
    FROM ema_calc
) ranked
WHERE rnk = 1
LIMIT 20
