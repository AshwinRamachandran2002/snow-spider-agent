```sql
--Description: 9) Example exponential moving average (α = 0.2) of yearly filings for one
--             CPC code (H04L29/08).  Fixes:
--               • Use pub."filing_date" for year conversion.
--               • Remove the cd.level filter to avoid excluding the chosen symbol.
WITH per_year AS (
    SELECT
        cd."symbol"                                              AS "cpc_symbol",
        YEAR(TO_DATE(pub."filing_date"::STRING, 'YYYYMMDD'))     AS "year",
        COUNT(*)                                                 AS "yearly_count"
    FROM (
        SELECT
            p."filing_date",
            f.value:"code"::STRING AS "first_cpc"
        FROM PATENTS.PATENTS.PUBLICATIONS AS p,
             LATERAL FLATTEN(input => p."cpc") AS f
        WHERE f.index = 0
          AND p."filing_date" IS NOT NULL
          AND p."filing_date" > 0
          AND p."application_number" IS NOT NULL
          AND p."application_number" <> ''
    ) AS pub
    JOIN PATENTS.PATENTS.CPC_DEFINITION AS cd
      ON cd."symbol" = pub."first_cpc"
    WHERE cd."symbol" = 'H04L29/08'        -- example CPC
    GROUP BY 1,2
)
SELECT
    "cpc_symbol",
    "year",
    "yearly_count",
    ROUND(
        SUM("yearly_count" * POWER(0.8,
            ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "year") - 1))
        OVER (PARTITION BY "cpc_symbol" ORDER BY "year"
              ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
      /
        SUM(POWER(0.8,
            ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "year") - 1))
        OVER (PARTITION BY "cpc_symbol" ORDER BY "year"
              ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
    , 2) AS "ema_0_2"
FROM per_year
ORDER BY "year"
LIMIT 20;
```

```sql
--Description: 10) Identify, for every level‑5 CPC technology area, the year with the highest
--              exponential moving average (α = 0.2).  Fixes:
--                • Use pub."filing_date" when deriving the year.
--                • First‑CPC extraction logic corrected (f.index / "code").
WITH year_counts AS (
    SELECT
        cd."symbol"                                              AS "cpc_symbol",
        cd."titleFull"                                           AS "cpc_title",
        YEAR(TO_DATE(pub."filing_date"::STRING, 'YYYYMMDD'))     AS "year",
        COUNT(*)                                                 AS "yearly_count"
    FROM (
        SELECT
            p."filing_date",
            f.value:"code"::STRING AS "first_cpc"
        FROM PATENTS.PATENTS.PUBLICATIONS AS p,
             LATERAL FLATTEN(input => p."cpc") AS f
        WHERE f.index = 0
          AND p."filing_date" IS NOT NULL
          AND p."filing_date" > 0
          AND p."application_number" IS NOT NULL
          AND p."application_number" <> ''
    ) AS pub
    JOIN PATENTS.PATENTS.CPC_DEFINITION AS cd
      ON cd."symbol" = pub."first_cpc"
    WHERE cd."level" = 5
    GROUP BY 1,2,3
), ema_calc AS (
    SELECT
        "cpc_symbol",
        "cpc_title",
        "year",
        "yearly_count",
        SUM("yearly_count" * POWER(0.8,
            ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "year") - 1))
          OVER (PARTITION BY "cpc_symbol" ORDER BY "year"
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
        /
        SUM(POWER(0.8,
            ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "year") - 1))
          OVER (PARTITION BY "cpc_symbol" ORDER BY "year"
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)     AS "ema_0_2"
    FROM year_counts
)
SELECT
    "cpc_symbol",
    "cpc_title",
    "year"              AS "best_year",
    ROUND("ema_0_2", 2) AS "max_ema"
FROM (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "ema_0_2" DESC) AS rn
    FROM ema_calc
)
WHERE rn = 1
LIMIT 20;
```
