```sql
--Description: 10) For every CPC subclass (level‑5), return the year with the highest
--                exponential moving average of filings (α = 0.2).  
--                Nested window‑function issue solved by computing row numbers & weights
--                in an intermediate CTE (counts_nr) before the EMA calculation.  
WITH year_counts AS (      -- yearly filing counts for each level‑5 subclass
    SELECT
        cd."symbol"                                           AS "cpc_symbol",
        cd."titleFull"                                        AS "cpc_title",
        YEAR(TO_DATE(pub."filing_date"::STRING,'YYYYMMDD'))   AS "year",
        COUNT(*)                                              AS "yearly_count"
    FROM (
        SELECT
            p."filing_date",
            REGEXP_SUBSTR(f.value:"code"::STRING,'^[A-Z][0-9]{2}[A-Z]') AS "subclass_symbol"
        FROM PATENTS.PATENTS.PUBLICATIONS AS p,
             LATERAL FLATTEN(input=>p."cpc") AS f
        WHERE f.index = 0
          AND p."filing_date" IS NOT NULL
          AND p."filing_date" > 0
          AND p."application_number" IS NOT NULL
          AND p."application_number" <> ''
          AND REGEXP_SUBSTR(f.value:"code"::STRING,'^[A-Z][0-9]{2}[A-Z]') IS NOT NULL
    ) AS pub
    JOIN PATENTS.PATENTS.CPC_DEFINITION AS cd
      ON cd."symbol" = pub."subclass_symbol"
    WHERE cd."level" = 5
    GROUP BY 1,2,3
), counts_nr AS (          -- add row number & weight per subclass
    SELECT
        *,
        ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "year")                AS rn,
        POWER(0.8 , ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "year")-1) AS wt
    FROM year_counts
), ema_calc AS (           -- compute running EMA without nested windows
    SELECT
        "cpc_symbol",
        "cpc_title",
        "year",
        "yearly_count",
        SUM("yearly_count"*wt) OVER (PARTITION BY "cpc_symbol" ORDER BY "year"
                                     ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
        /
        SUM(wt)             OVER (PARTITION BY "cpc_symbol" ORDER BY "year"
                                     ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)  AS "ema_0_2"
    FROM counts_nr
)
SELECT
    "cpc_symbol",
    "cpc_title",
    "year"              AS "best_year",
    ROUND("ema_0_2",2)  AS "max_ema"
FROM (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "ema_0_2" DESC) AS rn
    FROM ema_calc
) AS ranked
WHERE rn = 1
LIMIT 20;
