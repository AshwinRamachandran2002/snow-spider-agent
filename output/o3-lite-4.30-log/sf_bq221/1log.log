--Description:  Compute a running cumulative total of patent publications for each CPC
--              subclass (hierarchy level 5) using only the *first* CPC code in every
--              publication record.  Reasoning:
--                1.  Each publication’s “cpc” array is flattened; we keep the element
--                    at position 0 (f.index = 0) → the *first* CPC code.  
--                2.  Most first‑CPC codes are deep (level 8/9), e.g. “Y02E60/10”.  The
--                    level‑5 subclass is its first 4 characters (regex: 1 letter, two
--                    digits, 1 letter).  We extract that with REGEXP_SUBSTR.  
--                3.  We filter out rows where the regex returns NULL to avoid junk.  
--                4.  We require a positive, non‑null filing_date and non‑empty
--                    application_number for basic data hygiene.  
--                5.  Join the extracted subclass code to CPC_DEFINITION, keeping only
--                    rows where the definition table confirms it is level 5.  
--                6.  Derive the calendar year from numeric YYYYMMDD filing_date.  
--                7.  Use COUNT(*) OVER (PARTITION BY subclass ORDER BY year) to obtain
--                    a cumulative running total per subclass (no nested window fns).  
--                8.  LIMIT 20 rows for quick inspection.
WITH first_cpc AS (
    SELECT
        p."filing_date",
        REGEXP_SUBSTR(f.value:"code"::STRING, '^[A-Z][0-9]{2}[A-Z]') AS "subclass_symbol"
    FROM PATENTS.PATENTS.PUBLICATIONS AS p,
         LATERAL FLATTEN(input => p."cpc") AS f
    WHERE f.index = 0
      AND p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
      AND p."application_number" IS NOT NULL
      AND p."application_number" <> ''
      AND REGEXP_SUBSTR(f.value:"code"::STRING, '^[A-Z][0-9]{2}[A-Z]') IS NOT NULL
)
SELECT
    cd."symbol"                                              AS "cpc_symbol",
    YEAR(TO_DATE(fc."filing_date"::STRING, 'YYYYMMDD'))      AS "year",
    COUNT(*) OVER (
        PARTITION BY cd."symbol"
        ORDER BY YEAR(TO_DATE(fc."filing_date"::STRING, 'YYYYMMDD'))
    )                                                        AS "cumulative_filings"
FROM first_cpc AS fc
JOIN PATENTS.PATENTS.CPC_DEFINITION AS cd
  ON cd."symbol" = fc."subclass_symbol"
WHERE cd."level" = 5
LIMIT 20;
