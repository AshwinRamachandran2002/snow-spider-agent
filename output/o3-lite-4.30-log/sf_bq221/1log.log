```sql
--Description: 9) Example: Exponential moving average (α = 0.2) of yearly filings for one
--               CPC code (H04L29/08) – rewritten to avoid *nested* window functions.  
--               Strategy:  
--                 1.  Build yearly counts (per_year CTE).  
--                 2.  Add a sequential row number per symbol (per_year_nr CTE).  
--                 3.  Calculate a “weight” column = POWER(0.8 , row_nr‑1).  
--                 4.  In the outer query use two independent window SUMs (of
--                    weight*count and of weight) and divide them – no window function
--                    appears inside another window function’s argument.
WITH per_year AS (               -- yearly filing counts
    SELECT
        cd."symbol"                                           AS "cpc_symbol",
        YEAR(TO_DATE(pub."filing_date"::STRING,'YYYYMMDD'))   AS "year",
        COUNT(*)                                              AS "yearly_count"
    FROM (
        SELECT
            p."filing_date",
            f.value:"code"::STRING AS "first_cpc"
        FROM PATENTS.PATENTS.PUBLICATIONS AS p,
             LATERAL FLATTEN(input=>p."cpc") AS f
        WHERE f.index = 0
          AND p."filing_date" IS NOT NULL
          AND p."filing_date" > 0
          AND p."application_number" IS NOT NULL
          AND p."application_number" <> ''
    ) AS pub
    JOIN PATENTS.PATENTS.CPC_DEFINITION AS cd
      ON cd."symbol" = pub."first_cpc"
    WHERE cd."symbol" = 'H04L29/08'         -- example CPC
    GROUP BY 1,2
), per_year_nr AS (           -- add sequential number & weight
    SELECT
        *,
        ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "year")               AS rn,
        POWER(0.8 , ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "year")-1) AS wt
    FROM per_year
)
SELECT
    "cpc_symbol",
    "year",
    "yearly_count",
    ROUND(
        SUM("yearly_count"*wt) OVER (PARTITION BY "cpc_symbol" ORDER BY "year"
                                     ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
        /
        SUM(wt)               OVER (PARTITION BY "cpc_symbol" ORDER BY "year"
                                     ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
    ,2) AS "ema_0_2"
FROM per_year_nr
ORDER BY "year"
LIMIT 20;
