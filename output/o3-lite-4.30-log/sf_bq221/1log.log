        "year"                                      AS "best_year",
        ROUND(ema_val, 4)                           AS "highest_exponential_moving_average",
        ROW_NUMBER() OVER (PARTITION BY "cpc_full_title" ORDER BY ema_val DESC) AS rk
    FROM ema_calc
