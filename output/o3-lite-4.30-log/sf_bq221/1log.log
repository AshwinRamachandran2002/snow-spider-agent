```sql
--Description: Goal ‑ grab the very first CPC classification (“position 0”) for each patent
--             publication that has (a) a valid filing date (>0) and (b) a non‑empty
--             application number.  
--             Key points while composing the query:
--             • FLATTEN gives a pseudo‑column index (no quotes) that indicates the element’s
--               position in the array; using f.index = 0 filters to the first element only.  
--             • In the PUBLICATIONS.cpc VARIANT, the field that actually stores the CPC string
--               is named "code", so we extract it with f.value:"code".  
--             • We keep results small with LIMIT 20 for a quick sanity check.
SELECT
    p."publication_number",
    p."filing_date",
    f.value:"code"::STRING AS "first_cpc"
FROM PATENTS.PATENTS.PUBLICATIONS AS p,
     LATERAL FLATTEN(input => p."cpc") f
WHERE f.index = 0
  AND p."filing_date" IS NOT NULL
  AND p."filing_date" > 0
  AND p."application_number" IS NOT NULL
  AND p."application_number" <> ''
LIMIT 20;
```
