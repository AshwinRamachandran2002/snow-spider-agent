--Description: Compute an EMA (α = 0.2) of yearly counts for one sample CPC group (‘A01B’) without nesting window
--             functions.  We first create yearly counts, then add a plain rank column (rank_idx), and finally
--             calculate numerator and denominator in separate window sums.
WITH yearly AS (
    SELECT
        FLOOR(p."filing_date" / 10000)             AS "year",
        SPLIT_PART(f.value:"code"::STRING, '/', 1) AS "cpc_group_L5",
        COUNT(*)                                   AS "pub_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE f.index = 0
      AND p."filing_date" > 0
      AND p."application_number" IS NOT NULL
      AND SPLIT_PART(f.value:"code"::STRING, '/', 1) = 'A01B'
    GROUP BY 1, 2
),
ranked AS (
    SELECT
        y.*,
        DENSE_RANK() OVER (ORDER BY y."year" DESC) AS "rank_idx"
    FROM yearly y
),
ema AS (
    SELECT
        r."year",
        r."pub_cnt",
        SUM(r."pub_cnt" * POWER(0.8, r."rank_idx" - 1))
          OVER (ORDER BY r."rank_idx")                       AS "ema_numer",
        SUM(POWER(0.8, r."rank_idx" - 1))
          OVER (ORDER BY r."rank_idx")                       AS "ema_denom"
    FROM ranked r
)
SELECT
    "year",
    "pub_cnt",
    "ema_numer" / NULLIF("ema_denom", 0) AS "ema_alpha_0_2"
FROM ema
ORDER BY "year"
LIMIT 20;
