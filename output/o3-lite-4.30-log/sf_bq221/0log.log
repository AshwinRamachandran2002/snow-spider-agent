```sql
--Description / Thinking process:
-- Produce the final answer in one shot:
-- For every CPC level‑5 prefix (first code before “/” in the first CPC entry of each patent),
--   1. count yearly filings from 2000 onward,
--   2. compute an exponential moving average of those yearly counts with α = 0.2,
--   3. identify the year that gives the maximum EMA for the prefix (“best_year”),
--   4. attach the full CPC title (level‑5) from CPC_DEFINITION,
--   5. list the 20 prefixes with the highest max‑EMA values.
--
-- The query avoids nested‑window and GROUP‑BY conflicts by:
--   • computing a rank index in a CTE (ranked),
--   • calculating numerator and denominator for EMA in separate window sums,
--   • using FIRST_VALUE / MAX (window) to choose best_year / max_ema,
--   • selecting DISTINCT rows in the final projection.

WITH cpc_l5 AS (                      -- 1. prefix → title (level‑5)
    SELECT
        SPLIT_PART(cd."symbol", '/', 1) AS "cpc_group_L5",
        MIN(cd."titleFull")             AS "title_l5"
    FROM PATENTS.PATENTS.CPC_DEFINITION cd
    WHERE cd."level" = 5
    GROUP BY 1
),
yearly AS (                            -- 2. yearly publication counts, 2000+
    SELECT
        FLOOR(p."filing_date" / 10000)             AS "year",
        SPLIT_PART(f.value:"code"::STRING, '/', 1) AS "cpc_group_L5",
        COUNT(*)                                   AS "pub_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE f.index = 0
      AND p."filing_date" >= 20000000
      AND p."application_number" IS NOT NULL
    GROUP BY 1, 2
),
ranked AS (                            -- 3. add rank_idx inside each prefix
    SELECT
        y.*,
        DENSE_RANK() OVER (PARTITION BY y."cpc_group_L5" ORDER BY y."year" DESC) AS "rank_idx"
    FROM yearly y
),
ema_parts AS (                         -- 4. running numerator & denominator
    SELECT
        r."cpc_group_L5",
        r."year",
        SUM(r."pub_cnt" * POWER(0.8, r."rank_idx" - 1))
            OVER (PARTITION BY r."cpc_group_L5" ORDER BY r."rank_idx") AS "ema_numer",
        SUM(POWER(0.8, r."rank_idx" - 1))
            OVER (PARTITION BY r."cpc_group_L5" ORDER BY r."rank_idx") AS "ema_denom"
    FROM ranked r
),
ema_per_year AS (                      -- 5. EMA value per (prefix, year)
    SELECT
        e."cpc_group_L5",
        e."year",
        e."ema_numer" / NULLIF(e."ema_denom", 0) AS "ema_val"
    FROM ema_parts e
),
best_stats AS (                        -- 6. pick best_year & max_ema per prefix
    SELECT
        ep."cpc_group_L5",
        FIRST_VALUE(ep."year")
            OVER (PARTITION BY ep."cpc_group_L5" ORDER BY ep."ema_val" DESC) AS "best_year",
        MAX(ep."ema_val") OVER (PARTITION BY ep."cpc_group_L5")              AS "max_ema"
    FROM ema_per_year ep
)
SELECT DISTINCT                         -- 7. attach title, rank by max_ema
    b."cpc_group_L5",
    c."title_l5",
    b."best_year",
    b."max_ema"
FROM best_stats b
LEFT JOIN cpc_l5 c
  ON c."cpc_group_L5" = b."cpc_group_L5"
ORDER BY b."max_ema" DESC
LIMIT 20;
```
