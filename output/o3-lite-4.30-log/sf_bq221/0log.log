Below are ten exploratory Snowflake SQL queries (LIMIT 20 each) that move from simple inspection towards the complete answer.  
Remember to adjust any additional filtering or α parameter if needed.  

```sql
-- 1) Description: Quick look at the PUBLICATIONS table – basic bibliographic fields.
SELECT
    "publication_number",
    "application_number",
    "filing_date",
    "country_code",
    "application_kind"
FROM PATENTS.PATENTS.PUBLICATIONS
LIMIT 20;
```

```sql
-- 2) Description: Inspect the raw structure of the VARIANT "cpc" column.
SELECT
    "publication_number",
    "cpc"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "cpc" IS NOT NULL
LIMIT 20;
```

```sql
-- 3) Description: Flatten the "cpc" column to see individual CPC objects and their keys.
SELECT
    p."publication_number",
    f.value AS "cpc_object"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN (INPUT => p."cpc") f
WHERE f.value IS NOT NULL
LIMIT 20;
```

```sql
-- 4) Description: Extract only the first CPC symbol for each publication (index = 0).
SELECT
    p."publication_number",
    f.value:"symbol"::STRING AS "first_cpc_symbol"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN (INPUT => p."cpc") f
WHERE f."index" = 0
  AND p."filing_date" > 0
  AND p."application_number" IS NOT NULL
LIMIT 20;
```

```sql
-- 5) Description: Turn the first CPC symbol into a level‑5 group code
-- (keep everything up to the first slash '/').
SELECT
    f.value:"symbol"::STRING                               AS "first_cpc_symbol",
    SPLIT_PART(f.value:"symbol"::STRING, '/', 1)           AS "cpc_group_L5"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN (INPUT => p."cpc") f
WHERE f."index" = 0
LIMIT 20;
```

```sql
-- 6) Description: Count publications per (year, CPC level‑5 group).
SELECT
    FLOOR(p."filing_date" / 10000)                    AS "filing_year",
    SPLIT_PART(f.value:"symbol"::STRING, '/', 1)      AS "cpc_group_L5",
    COUNT(*)                                          AS "pub_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN (INPUT => p."cpc") f
WHERE f."index" = 0
  AND p."filing_date" > 0
  AND p."application_number" IS NOT NULL
GROUP BY 1, 2
ORDER BY 1 DESC, 3 DESC
LIMIT 20;
```

```sql
-- 7) Description: Join counts with CPC_DEFINITION to get the full CPC title (level = 5 only).
SELECT
    yr_cnt."filing_year",
    yr_cnt."cpc_group_L5",
    cd."titleFull",
    yr_cnt."pub_cnt"
FROM (
    SELECT
        FLOOR(p."filing_date" / 10000)                    AS "filing_year",
        SPLIT_PART(f.value:"symbol"::STRING, '/', 1)      AS "cpc_group_L5",
        COUNT(*)                                          AS "pub_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN (INPUT => p."cpc") f
    WHERE f."index" = 0
      AND p."filing_date" > 0
      AND p."application_number" IS NOT NULL
    GROUP BY 1, 2
) yr_cnt
JOIN PATENTS.PATENTS.CPC_DEFINITION cd
  ON cd."symbol" = yr_cnt."cpc_group_L5"
 WHERE cd."level" = 5
LIMIT 20;
```

```sql
-- 8) Description: Compute an exponential moving average (EMA, α = 0.2) of yearly
-- counts for ONE sample CPC group to validate the formula.
WITH yearly AS (
    SELECT
        FLOOR(p."filing_date" / 10000)                    AS "year",
        SPLIT_PART(f.value:"symbol"::STRING, '/', 1)      AS "cpc_group_L5",
        COUNT(*)                                          AS "pub_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN (INPUT => p."cpc") f
    WHERE f."index" = 0
      AND p."filing_date" > 0
      AND p."application_number" IS NOT NULL
      AND SPLIT_PART(f.value:"symbol"::STRING, '/', 1) = 'A01B'  -- sample group
    GROUP BY 1, 2
)
SELECT
    "year",
    "pub_cnt",
    -- EMA_t = α * x_t + (1-α) * EMA_{t-1}
    -- Implemented via recursive window expression
    SUM("pub_cnt" * POWER(1 - 0.2, DENSE_RANK() OVER (ORDER BY "year" DESC) - 1))
      OVER (ORDER BY "year") /
    SUM(POWER(1 - 0.2, DENSE_RANK() OVER (ORDER BY "year" DESC) - 1))
      OVER (ORDER BY "year")                           AS "ema_alpha_0_2"
FROM yearly
ORDER BY "year"
LIMIT 20;
```

```sql
-- 9) Description: EMA for every CPC level‑5 group and every year.
WITH yearly AS (
    SELECT
        FLOOR(p."filing_date" / 10000)                    AS "year",
        SPLIT_PART(f.value:"symbol"::STRING, '/', 1)      AS "cpc_group_L5",
        COUNT(*)                                          AS "pub_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN (INPUT => p."cpc") f
    WHERE f."index" = 0
      AND p."filing_date" > 0
      AND p."application_number" IS NOT NULL
    GROUP BY 1, 2
)
SELECT
    "cpc_group_L5",
    "year",
    "pub_cnt",
    SUM("pub_cnt" * POWER(1 - 0.2, DENSE_RANK() OVER (PARTITION BY "cpc_group_L5" ORDER BY "year" DESC) - 1))
        OVER (PARTITION BY "cpc_group_L5" ORDER BY "year")
      /
    SUM(POWER(1 - 0.2, DENSE_RANK() OVER (PARTITION BY "cpc_group_L5" ORDER BY "year" DESC) - 1))
        OVER (PARTITION BY "cpc_group_L5" ORDER BY "year")          AS "ema_alpha_0_2"
FROM yearly
ORDER BY "cpc_group_L5", "year"
LIMIT 20;
```

```sql
-- 10) Description: Final step – for each CPC level‑5 group,
-- pick the year with the highest EMA(α=0.2) and attach the full CPC title.
WITH yearly AS (
    SELECT
        FLOOR(p."filing_date" / 10000)                    AS "year",
        SPLIT_PART(f.value:"symbol"::STRING, '/', 1)      AS "cpc_group_L5",
        COUNT(*)                                          AS "pub_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN (INPUT => p."cpc") f
    WHERE f."index" = 0
      AND p."filing_date" > 0
      AND p."application_number" IS NOT NULL
    GROUP BY 1, 2
),
ema_calc AS (
    SELECT
        y."cpc_group_L5",
        y."year",
        y."pub_cnt",
        SUM(y."pub_cnt" * POWER(1 - 0.2, DENSE_RANK() OVER (PARTITION BY y."cpc_group_L5" ORDER BY y."year" DESC) - 1))
          OVER (PARTITION BY y."cpc_group_L5" ORDER BY y."year")
        /
        SUM(POWER(1 - 0.2, DENSE_RANK() OVER (PARTITION BY y."cpc_group_L5" ORDER BY y."year" DESC) - 1))
          OVER (PARTITION BY y."cpc_group_L5" ORDER BY y."year")  AS "ema_alpha_0_2"
    FROM yearly y
),
best_year AS (
    SELECT
        "cpc_group_L5",
        FIRST_VALUE("year")   OVER (PARTITION BY "cpc_group_L5" ORDER BY "ema_alpha_0_2" DESC) AS "best_year",
        MAX("ema_alpha_0_2")  AS "max_ema"
    FROM ema_calc
    GROUP BY "cpc_group_L5"
)
SELECT
    b."cpc_group_L5",
    cd."titleFull",
    b."best_year",
    b."max_ema"
FROM best_year b
JOIN PATENTS.PATENTS.CPC_DEFINITION cd
  ON cd."symbol" = b."cpc_group_L5"
WHERE cd."level" = 5
ORDER BY b."max_ema" DESC
LIMIT 20;
```

