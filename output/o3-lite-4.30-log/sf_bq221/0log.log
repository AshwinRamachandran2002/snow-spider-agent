--Description: Final step – for each CPC level‑5 group, pick the year with the highest EMA (α = 0.2) and
--             attach the full CPC title, all without nested window functions.
WITH cpc_l5 AS (         -- level‑5 prefix‑to‑title map
    SELECT
        SPLIT_PART(cd."symbol", '/', 1) AS "cpc_group_L5",
        MIN(cd."titleFull")             AS "title_l5"
    FROM PATENTS.PATENTS.CPC_DEFINITION cd
    WHERE cd."level" = 5
    GROUP BY 1
),
yearly AS (              -- yearly publication counts (2000‑present to keep volume reasonable)
    SELECT
        FLOOR(p."filing_date" / 10000)             AS "year",
        SPLIT_PART(f.value:"code"::STRING, '/', 1) AS "cpc_group_L5",
        COUNT(*)                                   AS "pub_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE f.index = 0
      AND p."filing_date" >= 20000000
      AND p."application_number" IS NOT NULL
    GROUP BY 1, 2
),
ranked AS (              -- add rank index
    SELECT
        y.*,
        DENSE_RANK() OVER (PARTITION BY y."cpc_group_L5" ORDER BY y."year" DESC) AS "rank_idx"
    FROM yearly y
),
ema AS (                 -- compute EMA components
    SELECT
        r."cpc_group_L5",
        r."year",
        SUM(r."pub_cnt" * POWER(0.8, r."rank_idx" - 1))
          OVER (PARTITION BY r."cpc_group_L5" ORDER BY r."rank_idx") AS "ema_numer",
        SUM(POWER(0.8, r."rank_idx" - 1))
          OVER (PARTITION BY r."cpc_group_L5" ORDER BY r."rank_idx") AS "ema_denom"
    FROM ranked r
),
ema_per_year AS (        -- final EMA per (prefix, year)
    SELECT
        e."cpc_group_L5",
        e."year",
        e."ema_numer" / NULLIF(e."ema_denom", 0) AS "ema_val"
    FROM ema e
),
best_year AS (           -- pick year with max EMA
    SELECT
        "cpc_group_L5",
        FIRST_VALUE("year") OVER (PARTITION BY "cpc_group_L5" ORDER BY "ema_val" DESC) AS "best_year",
        MAX("ema_val") AS "max_ema"
    FROM ema_per_year
    GROUP BY "cpc_group_L5"
)
SELECT
    b."cpc_group_L5",
    c."title_l5",
    b."best_year",
    b."max_ema"
FROM best_year b
LEFT JOIN cpc_l5 c
  ON c."cpc_group_L5" = b."cpc_group_L5"
ORDER BY b."max_ema" DESC
LIMIT 20;
