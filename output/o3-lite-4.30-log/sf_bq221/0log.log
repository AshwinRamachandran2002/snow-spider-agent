Query:
--Description: Calculate EMA (α = 0.2) for every CPC level‑5 group and every year, with no nested
--             window functions.  We (1) build yearly counts, (2) add a rank index per group,
--             (3) compute running numerator and denominator separately, and (4) divide them
--             to obtain the EMA value.
WITH yearly AS (                       -- 1) yearly counts
    SELECT
        FLOOR(p."filing_date" / 10000)             AS "year",
        SPLIT_PART(f.value:"code"::STRING, '/', 1) AS "cpc_group_L5",
        COUNT(*)                                   AS "pub_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN (INPUT => p."cpc") f
    WHERE f.index = 0
      AND p."filing_date" > 0
      AND p."application_number" IS NOT NULL
    GROUP BY 1, 2
),
ranked AS (                       -- 2) add rank index (avoids nested windows)
    SELECT
        y.*,
        DENSE_RANK() OVER (PARTITION BY y."cpc_group_L5" ORDER BY y."year" DESC) AS "rank_idx"
    FROM yearly y
),
ema_parts AS (                    -- 3) running sums for numerator & denominator
    SELECT
        r."cpc_group_L5",
        r."year",
        r."pub_cnt",
        SUM(r."pub_cnt" * POWER(0.8, r."rank_idx" - 1))
          OVER (PARTITION BY r."cpc_group_L5" ORDER BY r."rank_idx") AS "ema_numer",
        SUM(POWER(0.8, r."rank_idx" - 1))
          OVER (PARTITION BY r."cpc_group_L5" ORDER BY r."rank_idx") AS "ema_denom"
    FROM ranked r
)
SELECT                               -- 4) final EMA per (group, year)
    "cpc_group_L5",
    "year",
    "pub_cnt",
    "ema_numer" / NULLIF("ema_denom", 0) AS "ema_alpha_0_2"
FROM ema_parts
ORDER BY "cpc_group_L5", "year"
LIMIT 20
