```sql
/*  Identify, for every CPC level‑5 technology group, the year with the
    highest exponential moving average (EMA, α = 0.2) of patent‑filing
    counts.  The calculation is based on the first CPC code of each
    publication that has a valid ( > 0 ) filing date and a non‑empty
    application number.                                                     */

WITH alpha AS (                               -- single‑row CTE to hold α
    SELECT 0.2 AS a
),

/* 1. Yearly filing counts per CPC level‑5 group -------------------------- */
yearly_counts AS (
    SELECT
        SPLIT_PART(f.value:"code"::STRING, '/', 1)      AS "cpc_group_L5",
        FLOOR(p."filing_date" / 10000)                  AS "year",
        COUNT(*)                                        AS "pub_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS  p,
         LATERAL FLATTEN ( INPUT => p."cpc") f
    WHERE f."index" = 0                              -- first CPC only
      AND p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
      AND p."application_number" IS NOT NULL
      AND p."application_number" <> ''
    GROUP BY 1, 2
),

/* 2. Order the yearly rows inside every CPC group ------------------------ */
ordered AS (
    SELECT
        yc.*,
        ROW_NUMBER() OVER (PARTITION BY yc."cpc_group_L5"
                           ORDER BY yc."year")          AS rn     -- oldest = 1
    FROM yearly_counts yc
),

/* 3. Recursive EMA calculation (EMA₁ := first‑year count) ---------------- */
ema_recursive AS (
    -- anchor (first year of each CPC group)
    SELECT
        o."cpc_group_L5",
        o."year",
        o."pub_cnt",
        CAST(o."pub_cnt" AS FLOAT)                      AS ema,   -- EMA₁
        o.rn
    FROM ordered o
    WHERE o.rn = 1

    UNION ALL

    -- recursive step:  EMA_t = α·x_t + (1‑α)·EMA_{t‑1}
    SELECT
        o."cpc_group_L5",
        o."year",
        o."pub_cnt",
        (SELECT a FROM alpha)      * o."pub_cnt"
      + (1 - (SELECT a FROM alpha)) * e.ema             AS ema,
        o.rn
    FROM ema_recursive e
    JOIN ordered      o
      ON o."cpc_group_L5" = e."cpc_group_L5"
     AND o.rn          = e.rn + 1
),

/* 4. Pick the year with the highest EMA for every CPC group -------------- */
best_year_per_group AS (
    SELECT
        "cpc_group_L5",
        FIRST_VALUE("year")
            OVER (PARTITION BY "cpc_group_L5"
                  ORDER BY ema DESC, "year")            AS best_year,
        MAX(ema)                                        AS highest_exponential_moving_average
    FROM ema_recursive
    GROUP BY "cpc_group_L5"
)

/* 5. Attach the full CPC title (level = 5) and present the result -------- */
SELECT
    cd."titleFull"                                     AS cpc_full_title,
    b.best_year,
    ROUND(b.highest_exponential_moving_average, 4)     AS highest_exponential_moving_average
FROM best_year_per_group b
JOIN PATENTS.PATENTS.CPC_DEFINITION cd
  ON cd."symbol" = b."cpc_group_L5"
WHERE cd."level" = 5
ORDER BY b.highest_exponential_moving_average DESC NULLS LAST,
         cd."titleFull";
```
