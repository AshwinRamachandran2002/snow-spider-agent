```sql
--Description / Thinking process:
-- Goal: find, for each CPC level‑5 technology area, the filing year (2000‑present) that shows
--       the highest exponential moving average (EMA, α = 0.2) of patent‑filing counts, and
--       attach the full CPC title.
--
-- Performance considerations:
--  • Limit PUBLICATIONS to records with filing_date ≥ 20000000 to reduce volume.
--  • Use a pre‑built lookup of level‑5 prefixes and their titles (cpc_l5) so we join by equality
--    rather than by LIKE in the final step.
--
-- Steps:
-- 1) cpc_l5      : collect level‑5 CPC prefixes and one representative title.
-- 2) yearly      : count publications per (year, CPC prefix) for 2000‑present, using only the first CPC code.
-- 3) ema_calc    : compute EMA(α = 0.2) for each (CPC prefix, year) with an analytic window that
--                  weights recent years more heavily.
-- 4) best_year   : pick, per CPC prefix, the year with the maximum EMA value.
-- 5) Final SELECT: attach the CPC title and list the top 20 rows by EMA.

WITH cpc_l5 AS (
    SELECT
        SPLIT_PART(cd."symbol", '/', 1) AS "cpc_group_L5",
        MIN(cd."titleFull")             AS "title_l5"
    FROM PATENTS.PATENTS.CPC_DEFINITION cd
    WHERE cd."level" = 5
    GROUP BY 1
),
yearly AS (
    SELECT
        FLOOR(p."filing_date" / 10000)             AS "year",
        SPLIT_PART(f.value:"code"::STRING, '/', 1) AS "cpc_group_L5",
        COUNT(*)                                   AS "pub_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE f.index = 0
      AND p."filing_date" >= 20000000        -- keep years 2000‑present
      AND p."application_number" IS NOT NULL
    GROUP BY 1, 2
),
ema_calc AS (
    SELECT
        y."cpc_group_L5",
        y."year",
        /* Exponential Moving Average α = 0.2 */
        SUM(y."pub_cnt" * POWER(1 - 0.2,
            DENSE_RANK() OVER (PARTITION BY y."cpc_group_L5" ORDER BY y."year" DESC) - 1))
          OVER (PARTITION BY y."cpc_group_L5" ORDER BY y."year")
        /
        SUM(POWER(1 - 0.2,
            DENSE_RANK() OVER (PARTITION BY y."cpc_group_L5" ORDER BY y."year" DESC) - 1))
          OVER (PARTITION BY y."cpc_group_L5" ORDER BY y."year")   AS "ema_alpha_0_2"
    FROM yearly y
),
best_year AS (
    SELECT
        "cpc_group_L5",
        FIRST_VALUE("year")  OVER (PARTITION BY "cpc_group_L5"
                                   ORDER BY "ema_alpha_0_2" DESC)  AS "best_year",
        MAX("ema_alpha_0_2") AS "max_ema"
    FROM ema_calc
    GROUP BY "cpc_group_L5"
)
SELECT
    b."cpc_group_L5",
    c."title_l5",
    b."best_year",
    b."max_ema"
FROM best_year b
LEFT JOIN cpc_l5 c
  ON c."cpc_group_L5" = b."cpc_group_L5"
ORDER BY b."max_ema" DESC
LIMIT 20;
```
