--Description / Thinking process:
-- 1. For every publication that has a valid filing date and non‑empty application number,
--    take the FIRST CPC entry (f.index = 0) and truncate it before the first '/' to obtain
--    a level‑5 CPC prefix (e.g., “G06F3”).
-- 2. Aggregate to obtain the number of such publications per filing year and CPC prefix.
-- 3. Retrieve a human‑readable title for each prefix by left‑joining to CPC_DEFINITION
--    where CPC_DEFINITION.symbol starts with the prefix (symbol LIKE prefix || '%').
--    We keep the join loose (no cd.level filter) to improve hit‑rate; when multiple records
--    match the same prefix we just take MIN(titleFull) as a representative sample.
-- 4. Show a small sample (LIMIT 20) so we can verify the result.

SELECT
    yr."filing_year",
    yr."cpc_group_L5",
    MIN(cd."titleFull") AS "sample_title",
    yr."pub_cnt"
FROM (
    SELECT
        FLOOR(p."filing_date" / 10000)             AS "filing_year",
        SPLIT_PART(f.value:"code"::STRING, '/', 1) AS "cpc_group_L5",
        COUNT(*)                                   AS "pub_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE f.index = 0
      AND p."filing_date" > 0
      AND p."application_number" IS NOT NULL
    GROUP BY 1, 2
) yr
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION cd
  ON cd."symbol" LIKE yr."cpc_group_L5" || '%'
GROUP BY
    yr."filing_year",
    yr."cpc_group_L5",
    yr."pub_cnt"
LIMIT 20;
