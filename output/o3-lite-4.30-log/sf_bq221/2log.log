```sql
--Description / thinking process:
-- 1. The CPC field is a JSON array. Each element keeps its actual code under "code" not "symbol".
-- 2. We FLATTEN the array and keep only the first element (rn = 1) per publication to satisfy
--    “first CPC code for each patent”.
-- 3. We derive the filing year from the integer date (YYYYMMDD ⇒ divide by 10 000 and floor).
-- 4. We keep rows whose CPC code is present (non‑NULL / non‑empty) and whose filing_date > 0.
-- 5. Using LEFT JOIN to CPC_DEFINITION lets us see the human‑readable CPC title when available
--    without discarding publications whose code is missing from the definition table.
-- 6. LIMIT 20 for a lightweight sample preview.

WITH first_code AS (
    SELECT
        p."publication_number",
        FLOOR(p."filing_date" / 10000)                       AS "filing_year",
        f.value:"code"::STRING                               AS "cpc_symbol",
        ROW_NUMBER() OVER (PARTITION BY p."publication_number" ORDER BY f.index) AS rn
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
      AND f.value:"code" IS NOT NULL
)
SELECT
    fc."filing_year",
    fc."cpc_symbol",
    d."titleFull" AS "cpc_title"
FROM first_code fc
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON fc."cpc_symbol" = d."symbol"
WHERE fc.rn = 1
LIMIT 20;
