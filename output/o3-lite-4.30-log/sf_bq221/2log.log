--Description: 
--  “All‑in‑one” query that finds, for every level‑5 CPC group, the filing year in which
--  that group attains its highest exponential moving average (EMA) of patent filings
--  (α = 0.2), considering only the FIRST CPC code listed on each patent publication.  
--  Logical steps
--    1. first_code  – flatten PUBLICATIONS."cpc", extract the JSON key "code", and keep
--       only element index 0 (first CPC).  Retain records with positive filing_date.  
--    2. level5_counts – join to CPC_DEFINITION, restrict to level 5 symbols, and count
--       filings per (CPC, year).  
--    3. ordered – add a sequential row number per CPC to enable recursive EMA.  
--    4. ema_r  – recursive CTE to compute EMA_t = 0.2*x_t + 0.8*EMA_{t‑1}.  
--       Anchor row (seq = 1) sets EMA = x₁.  
--    5. best_year – for each CPC, pick the year whose EMA is maximal.  
--    6. Final select shows CPC symbol, full title, best year, and highest EMA, limited
--       to 20 rows for quick inspection.

WITH first_code AS (
    SELECT
        p."publication_number",
        FLOOR(p."filing_date" / 10000)             AS "filing_year",
        f.value:"code"::STRING                     AS "cpc_symbol",
        ROW_NUMBER() OVER (PARTITION BY p."publication_number" ORDER BY f.index) AS rn
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
      AND f.value:"code" IS NOT NULL
      AND f.index = 0                              -- first CPC element only
),
level5_counts AS (
    SELECT
        fc."cpc_symbol",
        fc."filing_year",
        COUNT(*) AS "n_filings"
    FROM first_code fc
    JOIN PATENTS.PATENTS.CPC_DEFINITION d
          ON fc."cpc_symbol" = d."symbol"
    WHERE fc.rn = 1
      AND d."level" = 5
    GROUP BY fc."cpc_symbol", fc."filing_year"
),
ordered AS (   -- add sequential order per CPC to support recursive EMA
    SELECT
        lc.*,
        ROW_NUMBER() OVER (PARTITION BY lc."cpc_symbol" ORDER BY lc."filing_year") AS seq
    FROM level5_counts lc
),
/* Recursive EMA calculation */
ema_r (cpc_symbol, seq, filing_year, n_filings, ema_val) AS (
    -- anchor: first year for each CPC
    SELECT
        o."cpc_symbol",
        o.seq,
        o."filing_year",
        o."n_filings",
        o."n_filings"::FLOAT AS ema_val
    FROM ordered o
    WHERE o.seq = 1
    
    UNION ALL
    
    -- recursive part: EMA_t = 0.2*x_t + 0.8*EMA_{t‑1}
    SELECT
        o."cpc_symbol",
        o.seq,
        o."filing_year",
        o."n_filings",
        0.2 * o."n_filings" + 0.8 * e.ema_val
    FROM ema_r e
    JOIN ordered o
      ON o."cpc_symbol" = e."cpc_symbol"
     AND o.seq = e.seq + 1
),
best_year AS (
    SELECT
        er."cpc_symbol",
        er."filing_year",
        er.ema_val,
        ROW_NUMBER() OVER (PARTITION BY er."cpc_symbol" ORDER BY er.ema_val DESC) AS rn
    FROM ema_r er
)
SELECT
    by."cpc_symbol",
    d."titleFull"                          AS "cpc_title",
    by."filing_year"                       AS "best_year",
    by.ema_val                             AS "highest_ema"
FROM best_year by
JOIN PATENTS.PATENTS.CPC_DEFINITION d
     ON by."cpc_symbol" = d."symbol"
WHERE by.rn = 1
LIMIT 20;
