--Description: 
--  Compute, for the CPC code ‘A61K008/00’, the yearly patent‑filing counts based on the
--  FIRST CPC code of each publication and calculate the exponential moving average
--  (EMA) with smoothing factor α = 0.2.  Snowflake’s recursive CTE capability is used
--  to implement the recurrence EMA_t = 0.2·x_t + 0.8·EMA_{t‑1}.
--  Logical flow
--    1. first_year_counts – flatten PUBLICATIONS."cpc", keep element index 0 (first code),
--       filter on the desired CPC symbol, derive filing_year, and count publications.  
--    2. ordered            – add a sequential row number (seq) per ascending year to drive
--       the recursion.  
--    3. ema_r (recursive)  – anchor row sets EMA for the first year; subsequent rows apply
--       the EMA formula.  
--    4. Final SELECT       – return filing_year, count, and EMA, ordered by year, limited
--       to 20 rows for brevity.

WITH first_year_counts AS (           -- step 1
    SELECT
        FLOOR(p."filing_date" / 10000)            AS filing_year,
        COUNT(*)                                  AS n_filings
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
      AND f.index = 0                               -- first CPC only
      AND f.value:"code"::STRING = 'A61K008/00'     -- target CPC
    GROUP BY filing_year
),
ordered AS (                          -- step 2
    SELECT
        filing_year,
        n_filings,
        ROW_NUMBER() OVER (ORDER BY filing_year) AS seq
    FROM first_year_counts
    ORDER BY filing_year
),
/* step 3: recursive EMA computation */
WITH RECURSIVE ema_r (seq, filing_year, n_filings, ema_val) AS (
    -- anchor (seq = 1)
    SELECT
        o.seq,
        o.filing_year,
        o.n_filings,
        o.n_filings::FLOAT                    -- EMA₁ = x₁
    FROM ordered o
    WHERE o.seq = 1

    UNION ALL

    -- recursive step: EMA_t = 0.2·x_t + 0.8·EMA_{t‑1}
    SELECT
        o.seq,
        o.filing_year,
        o.n_filings,
        0.2 * o.n_filings + 0.8 * e.ema_val
    FROM ema_r e
    JOIN ordered o
      ON o.seq = e.seq + 1
)
SELECT
    filing_year,
    n_filings,
    ema_val
FROM ema_r
ORDER BY filing_year
LIMIT 20;
