WITH RECURSIVE
/* 1. first CPC code (variant field may be "code" or "symbol")                  */
first_code AS (
    SELECT
        p."publication_number",
        FLOOR(p."filing_date" / 10000)                                    AS filing_year,
        TRIM(
             COALESCE(
                 f.value:"code"::STRING,
                 f.value:"symbol"::STRING
             )
        )                                                                 AS cpc_symbol
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN ( input => p."cpc" ) f
    WHERE p."application_number" IS NOT NULL
      AND p."application_number" <> ''
      AND p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
    QUALIFY ROW_NUMBER()
            OVER (PARTITION BY p."publication_number" ORDER BY f.index) = 1
),
/* 2. map each code to the level‑5 CPC group in the definition table            */
level5_mapped AS (
    SELECT
        d."symbol"                                     AS cpc_group, /* level‑5 symbol */
        fc.filing_year
    FROM first_code fc
    JOIN PATENTS.PATENTS.CPC_DEFINITION d
          ON fc.cpc_symbol LIKE d."symbol" || '%'
    WHERE d."level" = 5
),
/* 3. yearly patent counts per level‑5 CPC group                                */
year_counts AS (
    SELECT
        cpc_group,
        filing_year,
        COUNT(*)                                         AS n_filings
    FROM level5_mapped
    GROUP BY cpc_group, filing_year
),
/* 4. row numbers to order years inside each CPC group                          */
ordered_counts AS (
    SELECT
        yc.*,
        ROW_NUMBER() OVER (PARTITION BY cpc_group
                           ORDER BY filing_year)         AS rn
    FROM year_counts yc
),
/* 5. recursive EMA (α = 0.2)                                                    */
ema_cte AS (
    /* anchor: first year for every CPC group */
    SELECT
        cpc_group,
        filing_year,
        n_filings,
        0.2 * n_filings                               AS ema,
        rn
    FROM ordered_counts
    WHERE rn = 1

    UNION ALL

    /* recursion: subsequent years */
    SELECT
        o.cpc_group,
        o.filing_year,
        o.n_filings,
        0.2 * o.n_filings + 0.8 * e.ema              AS ema,
        o.rn
    FROM ema_cte e
    JOIN ordered_counts o
          ON o.cpc_group = e.cpc_group
         AND o.rn       = e.rn + 1
),
/* 6. select the best (highest‑EMA) year for each CPC group                     */
best_years AS (
    SELECT
        cpc_group,
        filing_year                     AS best_year,
        ema                             AS highest_ema,
        ROW_NUMBER() OVER (PARTITION BY cpc_group
                           ORDER BY ema DESC, filing_year) AS rn
    FROM ema_cte
)
/* 7. final result with full CPC title                                          */
SELECT
    d."titleFull"                                  AS cpc_full_title,
    b.best_year,
    ROUND(b.highest_ema, 4)                        AS highest_exponential_moving_average
FROM best_years b
JOIN PATENTS.PATENTS.CPC_DEFINITION d
      ON b.cpc_group = d."symbol"
WHERE b.rn = 1
ORDER BY highest_exponential_moving_average DESC NULLS LAST;
```
