Begin Exploring Related Columns
Relevant columns and their potential usage  
PUBLICATIONS table  
• "application_number": identify patents that have a valid (non‑empty) application number.  
• "filing_date": numeric YYYYMMDD value; derive the filing year and filter out rows where it is 0 or NULL.  
• "cpc": VARIANT array that contains one or more CPC codes; after flattening we will take the first element (row_number = 1) for every publication.  
• "publication_number": handy surrogate key to keep one row per patent publication.  
• "family_id": optional alternative key when de‑duplicating.  

CPC_DEFINITION table  
• "symbol": CPC code to join with codes extracted from PUBLICATIONS."cpc".  
• "titleFull": full text title for the CPC technology area, required in the final report.  
• "level": numeric depth in the CPC hierarchy; level = 5 denotes 5‑digit CPC groups that the task asks for.  

Typical conditions that may be used  
• p."application_number" IS NOT NULL AND p."application_number" <> ''  
• p."filing_date" IS NOT NULL AND p."filing_date" > 0  
• cpc_first."cpc_symbol" IS NOT NULL AND cpc_first."cpc_symbol" <> ''  
• d."level" = 5 OR d."level" = 5.0  

Below are ten exploratory Snowflake SQL queries (LIMIT 20 for each) that progress from very simple inspections to the complete logic required; every column name is enclosed in double quotes.

```sql
--Description: 1) Quick look at the CPC_DEFINITION table – distinct symbols and their hierarchy level
SELECT DISTINCT 
       d."symbol",
       d."level",
       d."titleFull"
FROM PATENTS.PATENTS.CPC_DEFINITION d
LIMIT 20;
```

```sql
--Description: 2) Peek inside the PUBLICATIONS table – see how the CPC array is stored
SELECT 
       p."publication_number",
       p."cpc"
FROM PATENTS.PATENTS.PUBLICATIONS p
WHERE p."cpc" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 3) Flatten the "cpc" array and show the first element (row_number = 1) per publication
SELECT 
       p."publication_number",
       f.value:"symbol"::STRING AS "cpc_symbol",
       ROW_NUMBER() OVER (PARTITION BY p."publication_number" ORDER BY f.index) AS rn
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f
QUALIFY rn = 1
LIMIT 20;
```

```sql
--Description: 4) Add filters for valid application numbers and filing dates; derive filing year
SELECT 
       p."publication_number",
       f.value:"symbol"::STRING AS "cpc_symbol",
       FLOOR(p."filing_date" / 10000) AS "filing_year"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f
WHERE p."application_number" IS NOT NULL
  AND p."application_number" <> ''
  AND p."filing_date" IS NOT NULL
  AND p."filing_date" > 0
QUALIFY ROW_NUMBER() OVER (PARTITION BY p."publication_number" ORDER BY f.index) = 1
LIMIT 20;
```

```sql
--Description: 5) Count how many patent publications we have per filing year (all CPCs)
SELECT 
       FLOOR(p."filing_date" / 10000) AS "filing_year",
       COUNT(*) AS "pub_count"
FROM PATENTS.PATENTS.PUBLICATIONS p
WHERE p."application_number" IS NOT NULL
  AND p."application_number" <> ''
  AND p."filing_date" IS NOT NULL
  AND p."filing_date" > 0
GROUP BY "filing_year"
ORDER BY "filing_year"
LIMIT 20;
```

```sql
--Description: 6) Count patent publications per filing year per first‑listed CPC code
WITH cpc_first AS (
    SELECT 
           p."publication_number",
           FLOOR(p."filing_date" / 10000) AS "filing_year",
           f.value:"symbol"::STRING AS "cpc_symbol",
           ROW_NUMBER() OVER (PARTITION BY p."publication_number" ORDER BY f.index) AS rn
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."application_number" IS NOT NULL
      AND p."application_number" <> ''
      AND p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
)
SELECT 
       "filing_year",
       "cpc_symbol",
       COUNT(*) AS "pub_count"
FROM cpc_first
WHERE rn = 1
GROUP BY "filing_year", "cpc_symbol"
ORDER BY "filing_year", "pub_count" DESC
LIMIT 20;
```

```sql
--Description: 7) Join first‑listed CPC symbols with their titles; limit to level‑5 CPC groups
WITH cpc_first AS (
    SELECT 
           p."publication_number",
           FLOOR(p."filing_date" / 10000) AS "filing_year",
           f.value:"symbol"::STRING AS "cpc_symbol",
           ROW_NUMBER() OVER (PARTITION BY p."publication_number" ORDER BY f.index) AS rn
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."application_number" IS NOT NULL
      AND p."application_number" <> ''
      AND p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
)
SELECT 
       cf."filing_year",
       cf."cpc_symbol",
       d."titleFull"
FROM cpc_first cf
JOIN PATENTS.PATENTS.CPC_DEFINITION d
     ON cf."cpc_symbol" = d."symbol"
WHERE cf.rn = 1
  AND d."level" = 5
LIMIT 20;
```

```sql
--Description: 8) Simple yearly counts for level‑5 CPC groups (first code only)
WITH first_code AS (
    SELECT 
           p."publication_number",
           FLOOR(p."filing_date" / 10000) AS "filing_year",
           f.value:"symbol"::STRING AS "cpc_symbol",
           ROW_NUMBER() OVER (PARTITION BY p."publication_number" ORDER BY f.index) AS rn
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."application_number" IS NOT NULL
      AND p."application_number" <> ''
      AND p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
)
SELECT 
       fc."filing_year",
       fc."cpc_symbol",
       COUNT(*) AS "yearly_filings"
FROM first_code fc
JOIN PATENTS.PATENTS.CPC_DEFINITION d
     ON fc."cpc_symbol" = d."symbol"
WHERE fc.rn = 1
  AND d."level" = 5
GROUP BY fc."filing_year", fc."cpc_symbol"
ORDER BY fc."filing_year"
LIMIT 20;
```

```sql
--Description: 9) Compute exponential moving average (EMA) with α = 0.2 for one sample CPC code
WITH per_year AS (
    SELECT 
           FLOOR(p."filing_date" / 10000) AS "filing_year",
           COUNT(*) AS "n_filings"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."application_number" IS NOT NULL
      AND p."application_number" <> ''
      AND p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
      AND f.index = 0                 -- first code only
      AND f.value:"symbol"::STRING = 'A61K008/00'   -- <‑‑ replace by desired CPC
    GROUP BY "filing_year"
)
SELECT 
       "filing_year",
       "n_filings",
       -- exponential moving average: EMA_t = 0.2 * x_t + 0.8 * EMA_{t‑1}
       SUM("n_filings") OVER (ORDER BY "filing_year"
                              ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) * 0.0 AS placeholder,
       /* The recursive or window approach for EMA is shown here with 
          a self‑referential calculation using sequences, but left as placeholder
          to keep query lightweight for LIMIT 20 */
       "n_filings" AS "ema_dummy"
FROM per_year
ORDER BY "filing_year"
LIMIT 20;
```

```sql
--Description: 10) All‑in‑one: yearly counts for each level‑5 CPC first code, EMA (α = 0.2),
--                and for each CPC select the year that gives the highest EMA
WITH first_code AS (
    SELECT 
           p."publication_number",
           FLOOR(p."filing_date" / 10000) AS "filing_year",
           f.value:"symbol"::STRING AS "cpc_symbol",
           ROW_NUMBER() OVER (PARTITION BY p."publication_number" ORDER BY f.index) AS rn
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."application_number" IS NOT NULL
      AND p."application_number" <> ''
      AND p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
)
, level5_counts AS (
    SELECT 
           fc."filing_year",
           fc."cpc_symbol",
           COUNT(*) AS "n_filings"
    FROM first_code fc
    JOIN PATENTS.PATENTS.CPC_DEFINITION d
         ON fc."cpc_symbol" = d."symbol"
    WHERE fc.rn = 1
      AND d."level" = 5
    GROUP BY fc."filing_year", fc."cpc_symbol"
)
, ema AS (
    SELECT 
           lc."cpc_symbol",
           lc."filing_year",
           lc."n_filings",
           0.2 * lc."n_filings" +
           0.8 * COALESCE(LAG(0.2 * lc."n_filings" +
                              0.8 * COALESCE(LAG(0.2 * lc."n_filings",1) OVER (PARTITION BY lc."cpc_symbol" ORDER BY lc."filing_year"),0)
                       ,1) OVER (PARTITION BY lc."cpc_symbol" ORDER BY lc."filing_year"),0) AS "ema_approx"
    FROM level5_counts lc
)
SELECT 
       e."cpc_symbol",
       d."titleFull",
       e."filing_year"  AS "best_year",
       e."ema_approx"   AS "highest_ema"
FROM (
        SELECT 
               "cpc_symbol",
               "filing_year",
               "ema_approx",
               ROW_NUMBER() OVER (PARTITION BY "cpc_symbol" ORDER BY "ema_approx" DESC) AS rn
        FROM ema
) e
JOIN PATENTS.PATENTS.CPC_DEFINITION d
     ON e."cpc_symbol" = d."symbol"
WHERE e.rn = 1
LIMIT 20;
```

