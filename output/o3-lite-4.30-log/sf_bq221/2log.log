--    1. per_year   – count filings per year for the chosen CPC code.
--    2. ordered    – attach a sequential row number (seq) by ascending year.
--    3. ema_r      – recursive EMA calculation:  EMAₜ = 0.2·xₜ + 0.8·EMAₜ₋₁,
--                   with EMA₁ = x₁.  Snowflake requires the keyword RECURSIVE.
--    4. Final SELECT returns filing_year, yearly count, and EMA (20 rows).

WITH RECURSIVE
/* 1) yearly counts -------------------------------------------------------- */
per_year AS (
    SELECT
        FLOOR(p."filing_date" / 10000)                 AS filing_year,
        COUNT(*)                                       AS n_filings
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
      AND f.index = 0                                   -- first CPC element only
      AND f.value:"code"::STRING = 'A61K008/00'         -- target CPC symbol
    GROUP BY filing_year
),
/* 2) sequential ordering -------------------------------------------------- */
ordered AS (
    SELECT
        filing_year,
        n_filings,
        ROW_NUMBER() OVER (ORDER BY filing_year) AS seq
    FROM per_year
),
/* 3) recursive EMA computation ------------------------------------------- */
ema_r (seq, filing_year, n_filings, ema_val) AS (
    -- anchor row: seq = 1
    SELECT
        o.seq,
        o.filing_year,
        o.n_filings,
        o.n_filings::FLOAT                            -- EMA₁ = x₁
    FROM ordered o
    WHERE o.seq = 1

    UNION ALL

    -- recursive rows: EMAₜ = 0.2·xₜ + 0.8·EMAₜ₋₁
    SELECT
        o.seq,
        o.filing_year,
        o.n_filings,
        0.2 * o.n_filings + 0.8 * e.ema_val
    FROM ema_r e
    JOIN ordered o
      ON o.seq = e.seq + 1
)
/* 4) results -------------------------------------------------------------- */
SELECT
    filing_year,
    n_filings,
    ema_val
FROM ema_r
ORDER BY filing_year
LIMIT 20;
```
