```sql
WITH
/* 1. first CPC code for each publication that has a valid application number & filing date */
first_code AS (
    SELECT
        p."publication_number",
        FLOOR(p."filing_date" / 10000)            AS "filing_year",
        f.value:"code"::STRING                    AS "cpc_symbol"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN ( input => p."cpc" ) f
    WHERE p."application_number" IS NOT NULL
      AND p."application_number" <> ''
      AND p."filing_date"       IS NOT NULL
      AND p."filing_date"       > 0
      AND f.index = 0                       -- keep only the first CPC code
)
/* 2. yearly filing counts for level‑5 CPC groups                               */
, level5_counts AS (
    SELECT
        fc."cpc_symbol",
        fc."filing_year",
        COUNT(*)                         AS "n_filings"
    FROM first_code fc
    JOIN PATENTS.PATENTS.CPC_DEFINITION d
          ON fc."cpc_symbol" = d."symbol"
    WHERE d."level" = 5
    GROUP BY fc."cpc_symbol", fc."filing_year"
)
/* 3. add a row number per CPC to enable recursion                              */
, ordered_counts AS (
    SELECT
        lc.*,
        ROW_NUMBER()   OVER (PARTITION BY lc."cpc_symbol"
                             ORDER BY lc."filing_year") AS rn
    FROM level5_counts lc
)
/* 4. recursive EMA calculation with α = 0.2                                    */
, RECURSIVE ema_recursive AS (
      -- anchor (first year per CPC)
      SELECT
          "cpc_symbol",
          "filing_year",
          "n_filings",
          0.2 * "n_filings"                          AS ema,
          rn
      FROM ordered_counts
      WHERE rn = 1
      UNION ALL
      -- recursion (subsequent years)
      SELECT
          oc."cpc_symbol",
          oc."filing_year",
          oc."n_filings",
          0.2 * oc."n_filings" + 0.8 * er.ema        AS ema,
          oc.rn
      FROM ema_recursive  er
      JOIN ordered_counts oc
            ON  oc."cpc_symbol" = er."cpc_symbol"
           AND oc.rn           = er.rn + 1
)
/* 5. pick the year with the highest EMA for each CPC                           */
, best_years AS (
    SELECT
        "cpc_symbol",
        "filing_year"                       AS best_year,
        ema                                 AS highest_exponential_moving_average,
        ROW_NUMBER() OVER (PARTITION BY "cpc_symbol"
                           ORDER BY ema DESC, "filing_year") AS rn
    FROM ema_recursive
)
/* 6. final selection with CPC full title                                       */
SELECT
    d."titleFull"                                          AS cpc_full_title,
    b.best_year,
    ROUND(b.highest_exponential_moving_average, 4)         AS highest_exponential_moving_average
FROM best_years b
JOIN PATENTS.PATENTS.CPC_DEFINITION d
      ON b."cpc_symbol" = d."symbol"
WHERE b.rn = 1
ORDER BY highest_exponential_moving_average DESC NULLS LAST;
```

