Query:
--Description: 6) Count patent publications per filing year per first‑listed CPC code
WITH cpc_first AS (
    SELECT 
           p."publication_number",
           FLOOR(p."filing_date" / 10000) AS "filing_year",
           f.value:"symbol"::STRING AS "cpc_symbol",
           ROW_NUMBER() OVER (PARTITION BY p."publication_number" ORDER BY f.index) AS rn
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."application_number" IS NOT NULL
      AND p."application_number" <> ''
      AND p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
)
SELECT 
       "filing_year",
       "cpc_symbol",
       COUNT(*) AS "pub_count"
FROM cpc_first
WHERE rn = 1
GROUP BY "filing_year", "cpc_symbol"
ORDER BY "filing_year", "pub_count" DESC
LIMIT 20;
