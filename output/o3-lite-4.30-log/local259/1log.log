Begin Exploring Related Columns
Relevant columns and why they matter  
player.player_id : primary key to connect every player–related fact  
player.player_name : display name  
player.batting_hand : show batting hand  
player.bowling_skill : show bowling skill  
player_match.player_id : links a player to a match; lets us count matches and roles  
player_match.match_id : match identifier for appearances and later joins  
player_match.role : find the most frequent (“modal”) role of the player  
ball_by_ball.striker : who faced the ball ⇒ balls faced & runs (after joining to batsman_scored)  
ball_by_ball.bowler : who bowled the ball ⇒ wickets taken & runs conceded  
ball_by_ball.match_id / over_id / ball_id / innings_no : composite keys used to join to batsman_scored & wicket_taken  
batsman_scored.runs_scored : runs off the bat; summed for total runs, per‑match scores, runs conceded to bowlers  
wicket_taken.player_out : the batter dismissed ⇒ number of dismissals (outs)  
wicket_taken.match_id / over_id / ball_id / innings_no : join keys to get the bowler that produced the wicket  
Conditions / joins commonly needed  
• ball_by_ball AS b  
  JOIN batsman_scored AS s  
    ON (b.match_id, b.over_id, b.ball_id, b.innings_no) = (s.match_id, s.over_id, s.ball_id, s.innings_no)  
• ball_by_ball AS b  
  JOIN wicket_taken AS w  
    ON the same composite keys  

Ten exploratory SQL queries (all limited to 20 rows)  
```sql
-- 1. Basic list of players
SELECT player_id, player_name, batting_hand, bowling_skill
FROM player
LIMIT 20;

-- 2. What roles exist in player_match?
SELECT DISTINCT role
FROM player_match
LIMIT 20;

-- 3. How many times has each player appeared with each role?  
SELECT player_id, role, COUNT(*) AS role_count
FROM player_match
GROUP BY player_id, role
ORDER BY role_count DESC
LIMIT 20;

-- 4. Sample of balls with striker names and runs scored (joins ball_by_ball + batsman_scored + player)
SELECT b.match_id,
       p.player_name   AS striker_name,
       s.runs_scored
FROM ball_by_ball AS b
JOIN batsman_scored AS s
  ON s.match_id  = b.match_id
 AND s.over_id   = b.over_id
 AND s.ball_id   = b.ball_id
 AND s.innings_no= b.innings_no
JOIN player AS p
  ON p.player_id = b.striker
LIMIT 20;

-- 5. Total runs made by players (top 20)
SELECT p.player_id,
       p.player_name,
       SUM(s.runs_scored) AS total_runs
FROM ball_by_ball AS b
JOIN batsman_scored AS s
  ON (b.match_id, b.over_id, b.ball_id, b.innings_no) =
     (s.match_id, s.over_id, s.ball_id, s.innings_no)
JOIN player AS p
  ON p.player_id = b.striker
GROUP BY p.player_id, p.player_name
ORDER BY total_runs DESC
LIMIT 20;

-- 6. Balls faced by each player
SELECT b.striker AS player_id,
       COUNT(*)  AS balls_faced
FROM ball_by_ball AS b
GROUP BY b.striker
ORDER BY balls_faced DESC
LIMIT 20;

-- 7. Dismissals suffered by players
SELECT w.player_out AS player_id,
       COUNT(*)     AS dismissals
FROM wicket_taken AS w
GROUP BY w.player_out
ORDER BY dismissals DESC
LIMIT 20;

-- 8. Total wickets taken by each bowler
SELECT b.bowler       AS player_id,
       COUNT(*)       AS wickets_taken
FROM wicket_taken AS w
JOIN ball_by_ball AS b
  ON (b.match_id, b.over_id, b.ball_id, b.innings_no) =
     (w.match_id, w.over_id, w.ball_id, w.innings_no)
GROUP BY b.bowler
ORDER BY wickets_taken DESC
LIMIT 20;

-- 9. Runs conceded and overs bowled for each bowler
SELECT b.bowler                        AS player_id,
       SUM(s.runs_scored)              AS runs_conceded,
       COUNT(DISTINCT b.match_id || '-' || b.innings_no || '-' || b.over_id) AS overs_bowled
FROM ball_by_ball AS b
JOIN batsman_scored AS s
  ON (b.match_id, b.over_id, b.ball_id, b.innings_no) =
     (s.match_id, s.over_id, s.ball_id, s.innings_no)
GROUP BY b.bowler
ORDER BY runs_conceded DESC
LIMIT 20;

--10. Best bowling performance per player (wickets & runs in a match)
SELECT perf.player_id,
       perf.match_id,
       perf.wkts_in_match,
       perf.runs_in_match,
       printf('%d-%d', perf.wkts_in_match, perf.runs_in_match) AS best_figures
FROM (
      SELECT b.bowler AS player_id,
             b.match_id,
             COUNT(*)                        AS wkts_in_match,
             SUM(s.runs_scored)              AS runs_in_match
      FROM wicket_taken AS w
      JOIN ball_by_ball AS b
        ON (b.match_id, b.over_id, b.ball_id, b.innings_no) =
           (w.match_id, w.over_id, w.ball_id, w.innings_no)
      JOIN batsman_scored AS s
        ON (b.match_id, b.over_id, b.ball_id, b.innings_no) =
           (s.match_id, s.over_id, s.ball_id, s.innings_no)
      GROUP BY b.bowler, b.match_id
) AS perf
ORDER BY perf.wkts_in_match DESC,
         perf.runs_in_match ASC
LIMIT 20;
```
