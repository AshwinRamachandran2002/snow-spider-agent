```

```sql
--Description: Highest score for every player‑match (top 20).  
--We JOIN batsman_scored with ball_by_ball to obtain the batter id (“striker”), then sum runs.
SELECT bb."striker" AS "player_id",
       bb."match_id",
       SUM(bs."runs_scored") AS "runs_in_match"
FROM   "batsman_scored" AS bs
JOIN   "ball_by_ball"  AS bb
       ON bs."match_id"   = bb."match_id"
      AND bs."over_id"    = bb."over_id"
      AND bs."ball_id"    = bb."ball_id"
      AND bs."innings_no" = bb."innings_no"
GROUP  BY bb."striker", bb."match_id"
ORDER  BY "runs_in_match" DESC
LIMIT 20;
```

```sql
--Description: Wickets credited to each bowler (first 20).  
--Join wicket_taken with ball_by_ball so we know who delivered the ball that produced every dismissal.
SELECT bb."bowler" AS "player_id",
       COUNT(*)    AS "wickets"
FROM   "wicket_taken" AS wk
JOIN   "ball_by_ball" AS bb
       ON wk."match_id"   = bb."match_id"
      AND wk."over_id"    = bb."over_id"
      AND wk."ball_id"    = bb."ball_id"
      AND wk."innings_no" = bb."innings_no"
GROUP  BY bb."bowler"
LIMIT 20;
```

```sql
--Description: Runs conceded off the bat by every bowler in each match (top 20 rows).  
--Join ball_by_ball with batsman_scored to add up runs the bowler gave away.
SELECT bb."bowler" AS "player_id",
       bb."match_id",
       SUM(bs."runs_scored") AS "runs_off_bat_conceded"
FROM   "ball_by_ball"  AS bb
JOIN   "batsman_scored" AS bs
       ON bb."match_id"   = bs."match_id"
      AND bb."over_id"    = bs."over_id"
      AND bb."ball_id"    = bs."ball_id"
      AND bb."innings_no" = bs."innings_no"
GROUP  BY bb."bowler", bb."match_id"
LIMIT 20;
```

```sql
--Description: Combined career summary for a sample player (id = 1).  
--All batting, bowling and match counts are obtained via sub‑queries that avoid missing‑column errors.
SELECT p."player_id",
       p."player_name",
       COALESCE(cr."career_runs",0)      AS "career_runs",
       COALESCE(mp."matches_played",0)   AS "matches_played",
       COALESCE(d."dismissals",0)        AS "dismissals",
       COALESCE(bbowl."balls_bowled",0)  AS "balls_bowled",
       COALESCE(wkts."wickets",0)        AS "wickets"
FROM   "player" AS p
LEFT JOIN (
      SELECT bb2."striker"               AS player_id,
             SUM(bs."runs_scored")       AS career_runs
      FROM   "batsman_scored" AS bs
      JOIN   "ball_by_ball"  AS bb2
             ON bb2."match_id"   = bs."match_id"
            AND bb2."over_id"    = bs."over_id"
            AND bb2."ball_id"    = bs."ball_id"
            AND bb2."innings_no" = bs."innings_no"
      GROUP  BY bb2."striker"
) cr     ON cr.player_id = p."player_id"
LEFT JOIN (
      SELECT pm."player_id",
             COUNT(DISTINCT pm."match_id") AS matches_played
      FROM   "player_match" pm
      GROUP  BY pm."player_id"
) mp     ON mp."player_id" = p."player_id"
LEFT JOIN (
      SELECT wk2."player_out" AS player_id,
             COUNT(*)         AS dismissals
      FROM   "wicket_taken" wk2
      GROUP  BY wk2."player_out"
) d      ON d.player_id = p."player_id"
LEFT JOIN (
      SELECT bb3."bowler" AS player_id,
             COUNT(*)     AS balls_bowled
      FROM   "ball_by_ball" bb3
      GROUP  BY bb3."bowler"
) bbowl  ON bbowl.player_id = p."player_id"
LEFT JOIN (
      SELECT bb4."bowler" AS player_id,
             COUNT(*)     AS wickets
      FROM   "wicket_taken" wk3
      JOIN   "ball_by_ball" bb4
             ON wk3."match_id"   = bb4."match_id"
            AND wk3."over_id"    = bb4."over_id"
            AND wk3."ball_id"    = bb4."ball_id"
            AND wk3."innings_no" = bb4."innings_no"
      GROUP  BY bb4."bowler"
) wkts   ON wkts.player_id = p."player_id"
WHERE  p."player_id" = 1
LIMIT 20;
```
