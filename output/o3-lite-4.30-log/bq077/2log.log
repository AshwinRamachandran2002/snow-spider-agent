--Description: 2) Show only rows that are motor‑vehicle thefts (any year).
SELECT unique_key, date, primary_type, block
FROM `bigquery-public-data.chicago_crime.crime`
WHERE primary_type = 'MOTOR VEHICLE THEFT'
LIMIT 20;
```

```sql
--Description: 3) Distinct years in which motor‑vehicle thefts occur.
SELECT DISTINCT year
FROM `bigquery-public-data.chicago_crime.crime`
WHERE primary_type = 'MOTOR VEHICLE THEFT'
ORDER BY year
LIMIT 20;
```

```sql
--Description: 4) Distinct year‑month pairs for motor‑vehicle thefts in 2010–2016.
SELECT DISTINCT
       year,
       EXTRACT(MONTH FROM date) AS month
FROM `bigquery-public-data.chicago_crime.crime`
WHERE primary_type = 'MOTOR VEHICLE THEFT'
  AND year BETWEEN 2010 AND 2016
ORDER BY year, month
LIMIT 20;
```

```sql
--Description: 5) Count of motor‑vehicle thefts by month for the year 2010 only.
SELECT
  EXTRACT(MONTH FROM date) AS month,
  COUNT(*) AS thefts_in_month
FROM `bigquery-public-data.chicago_crime.crime`
WHERE primary_type = 'MOTOR VEHICLE THEFT'
  AND year = 2010
GROUP BY month
ORDER BY month
LIMIT 20;
```

```sql
--Description: 6) Monthly counts for every year 2010‑2016 (raw detail).
SELECT
  year,
  EXTRACT(MONTH FROM date) AS month,
  COUNT(*) AS thefts_in_month
FROM `bigquery-public-data.chicago_crime.crime`
WHERE primary_type = 'MOTOR VEHICLE THEFT'
  AND year BETWEEN 2010 AND 2016
GROUP BY year, month
ORDER BY year, month
LIMIT 20;
```

```sql
--Description: 7) Same as #6 but using a derived table alias and a more explicit timestamp extract.
SELECT
  y.year,
  y.month,
  y.thefts_in_month
FROM (
  SELECT
    year,
    EXTRACT(MONTH FROM date) AS month,
    COUNT(*) AS thefts_in_month
  FROM `bigquery-public-data.chicago_crime.crime`
  WHERE primary_type = 'MOTOR VEHICLE THEFT'
    AND year BETWEEN 2010 AND 2016
  GROUP BY year, month
) AS y
ORDER BY y.year, y.month
LIMIT 20;
```

```sql
--Description: 8) Use a window function to rank each month inside its year by the number of thefts.
WITH monthly AS (
  SELECT
    year,
    EXTRACT(MONTH FROM date) AS month,
    COUNT(*) AS thefts_in_month
  FROM `bigquery-public-data.chicago_crime.crime`
  WHERE primary_type = 'MOTOR VEHICLE THEFT'
    AND year BETWEEN 2010 AND 2016
  GROUP BY year, month
)
SELECT
  year,
  month,
  thefts_in_month,
  ROW_NUMBER() OVER (PARTITION BY year ORDER BY thefts_in_month DESC) AS rn
FROM monthly
ORDER BY year, rn
LIMIT 20;
```

```sql
--Description: 9) Aggregate to find the single highest monthly value per year via MAX().
SELECT
  year,
  MAX(thefts_in_month) AS max_thefts_in_any_month
FROM (
  SELECT
    year,
    EXTRACT(MONTH FROM date) AS month,
    COUNT(*) AS thefts_in_month
  FROM `bigquery-public-data.chicago_crime.crime`
  WHERE primary_type = 'MOTOR VEHICLE THEFT'
    AND year BETWEEN 2010 AND 2016
  GROUP BY year, month
)
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--Description: 10) Final answer – for each year 2010‑2016, the highest number of motor‑vehicle thefts recorded in a single month.
SELECT
  year,
  MAX(thefts_in_month) AS highest_monthly_motor_thefts
FROM (
  SELECT
    year,
    EXTRACT(MONTH FROM date) AS month,
    COUNT(*) AS thefts_in_month
  FROM `bigquery-public-data.chicago_crime.crime`
  WHERE primary_type = 'MOTOR VEHICLE THEFT'
    AND year BETWEEN 2010 AND 2016
  GROUP BY year, month
)
GROUP BY year
ORDER BY year
LIMIT 20;
```
