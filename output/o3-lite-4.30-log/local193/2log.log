Begin Exploring Related Columns
Relevant tables, columns & why they matter
• payment.customer_id  : ties every $‑amount to a specific customer  
• payment.amount       : money value used to compute LTV (Lifetime Value)  
• payment.payment_date : timestamp that lets us position each payment in time; needed for “+7 days / +30 days” windows  
• customer.customer_id : list of all customers; lets us keep customers even if they have only one payment  

Typical filter / join conditions that will be useful  
• JOIN payment p ON p.customer_id = c.customer_id  
• HAVING SUM(p.amount) > 0                          -- exclude zero‑revenue customers  
• p.payment_date <= DATETIME(fp.first_payment,'+7 days')   -- 7‑day window (exact 7*24h)  
• p.payment_date <= DATETIME(fp.first_payment,'+30 days')  -- 30‑day window (exact 30*24h)  

10 exploratory‑to‑final SQL queries  
```sql
-- 1) Peak at a handful of payments
SELECT DISTINCT payment_id, customer_id, amount, payment_date
FROM payment
LIMIT 20;
```

```sql
-- 2) Get a feel for how many customers actually have payments
SELECT DISTINCT customer_id
FROM payment
LIMIT 20;
```

```sql
-- 3) First‑purchase timestamp (per customer)
SELECT customer_id,
       MIN(payment_date) AS first_payment_date
FROM payment
GROUP BY customer_id
LIMIT 20;
```

```sql
-- 4) Total lifetime sales (LTV) per customer
SELECT customer_id,
       SUM(amount) AS total_ltv
FROM payment
GROUP BY customer_id
LIMIT 20;
```

```sql
-- 5) LTV that landed in the 1st 7×24h after first purchase
WITH fp AS (
  SELECT customer_id, MIN(payment_date) AS first_payment
  FROM payment
  GROUP BY customer_id
)
SELECT p.customer_id,
       SUM(p.amount) AS ltv_first_7d
FROM payment AS p
JOIN fp ON fp.customer_id = p.customer_id
WHERE p.payment_date <= DATETIME(fp.first_payment, '+7 days')
GROUP BY p.customer_id
LIMIT 20;
```

```sql
-- 6) LTV that landed in the 1st 30×24h after first purchase
WITH fp AS (
  SELECT customer_id, MIN(payment_date) AS first_payment
  FROM payment
  GROUP BY customer_id
)
SELECT p.customer_id,
       SUM(p.amount) AS ltv_first_30d
FROM payment AS p
JOIN fp ON fp.customer_id = p.customer_id
WHERE p.payment_date <= DATETIME(fp.first_payment, '+30 days')
GROUP BY p.customer_id
LIMIT 20;
```

```sql
-- 7) Combine total LTV and the two windows for every customer
WITH first_purchase AS (
  SELECT customer_id,
         MIN(payment_date) AS first_payment,
         SUM(amount)       AS total_ltv
  FROM payment
  GROUP BY customer_id
),
window_sales AS (
  SELECT p.customer_id,
         SUM(CASE
               WHEN p.payment_date <= DATETIME(fp.first_payment,'+7 days')
               THEN p.amount END)  AS ltv_7d,
         SUM(CASE
               WHEN p.payment_date <= DATETIME(fp.first_payment,'+30 days')
               THEN p.amount END) AS ltv_30d
  FROM payment p
  JOIN first_purchase fp ON fp.customer_id = p.customer_id
  GROUP BY p.customer_id
)
SELECT ws.customer_id,
       ws.ltv_7d,
       ws.ltv_30d,
       fp.total_ltv
FROM window_sales ws
JOIN first_purchase fp ON fp.customer_id = ws.customer_id
LIMIT 20;
```

```sql
-- 8) Same as #7 but keep only customers whose total LTV > 0
WITH first_purchase AS (
  SELECT customer_id,
         MIN(payment_date) AS first_payment,
         SUM(amount)       AS total_ltv
  FROM payment
  GROUP BY customer_id
  HAVING SUM(amount) > 0
),
window_sales AS (
  SELECT p.customer_id,
         SUM(CASE
               WHEN p.payment_date <= DATETIME(fp.first_payment,'+7 days')
               THEN p.amount END)  AS ltv_7d,
         SUM(CASE
               WHEN p.payment_date <= DATETIME(fp.first_payment,'+30 days')
               THEN p.amount END) AS ltv_30d
  FROM payment p
  JOIN first_purchase fp ON fp.customer_id = p.customer_id
  GROUP BY p.customer_id
)
SELECT ws.customer_id,
       ws.ltv_7d,
       ws.ltv_30d,
       fp.total_ltv
FROM window_sales ws
JOIN first_purchase fp USING (customer_id)
LIMIT 20;
```

```sql
-- 9) Customer‑level percentages: what share of their lifetime sales
--    came inside 7 and 30 days of their first purchase?
WITH first_purchase AS (
  SELECT customer_id,
         MIN(payment_date) AS first_payment,
         SUM(amount)       AS total_ltv
  FROM payment
  GROUP BY customer_id
  HAVING SUM(amount) > 0
),
window_sales AS (
  SELECT p.customer_id,
         SUM(CASE
               WHEN p.payment_date <= DATETIME(fp.first_payment,'+7 days')
               THEN p.amount END)  AS ltv_7d,
         SUM(CASE
               WHEN p.payment_date <= DATETIME(fp.first_payment,'+30 days')
               THEN p.amount END) AS ltv_30d
  FROM payment p
  JOIN first_purchase fp ON fp.customer_id = p.customer_id
  GROUP BY p.customer_id
)
SELECT ws.customer_id,
       ROUND(ltv_7d * 100.0 / total_ltv, 2)  AS pct_7d,
       ROUND(ltv_30d * 100.0 / total_ltv, 2) AS pct_30d,
       total_ltv
FROM window_sales ws
JOIN first_purchase fp USING (customer_id)
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: overall averages requested by the task
WITH first_purchase AS (
  SELECT customer_id,
         MIN(payment_date) AS first_payment,
         SUM(amount)       AS total_ltv
  FROM payment
  GROUP BY customer_id
  HAVING SUM(amount) > 0                -- drop zero‑LTV customers
),
window_sales AS (
  SELECT p.customer_id,
         SUM(CASE
               WHEN p.payment_date <= DATETIME(fp.first_payment,'+7 days')
               THEN p.amount END)  AS ltv_7d,
         SUM(CASE
               WHEN p.payment_date <= DATETIME(fp.first_payment,'+30 days')
               THEN p.amount END) AS ltv_30d
  FROM payment p
  JOIN first_purchase fp ON fp.customer_id = p.customer_id
  GROUP BY p.customer_id
)
SELECT ROUND(AVG(ltv_7d * 1.0 / total_ltv)  * 100, 2) AS avg_pct_7d,
       ROUND(AVG(ltv_30d * 1.0 / total_ltv) * 100, 2) AS avg_pct_30d,
       ROUND(AVG(total_ltv), 2)                       AS avg_total_ltv
FROM window_sales
JOIN first_purchase USING (customer_id);
```
