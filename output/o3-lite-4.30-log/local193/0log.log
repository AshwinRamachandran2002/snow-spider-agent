-- 7. Aggregate 7‑day revenue for each customer.
WITH first_time AS (
     SELECT "customer_id", MIN("payment_date") AS "first_purchase"
     FROM "payment"
     GROUP BY "customer_id"
)
SELECT p."customer_id",
       SUM(p."amount") AS "sales_7d"
FROM "payment" AS p
JOIN first_time AS f
  ON p."customer_id" = f."customer_id"
WHERE (julianday(p."payment_date") - julianday(f."first_purchase"))*86400 <= 604800
GROUP BY p."customer_id"
LIMIT 20;
