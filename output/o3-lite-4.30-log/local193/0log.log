Begin Exploring Related Columns
Relevant columns and their potential usage
• payment.customer_id: identifies the customer that made every payment (needed for all customer‑level aggregations).  
• payment.amount: dollar value of each payment (used to build lifetime value and the 7‑ & 30‑day buckets).  
• payment.payment_date: exact date‑time of the payment (used to locate a customer’s first purchase and to decide whether a payment falls inside the first 7 days / 30 days).  
• customer.customer_id: lets us keep the customer dimension distinct (only needed if you want to display names or be sure the customer exists).  

Typical conditions that will be useful  
• WHERE payment.amount > 0 – eliminate “free” payments.  
• HAVING SUM(payment.amount) > 0 – exclude customers with zero lifetime sales.  
• (julianday(p.payment_date) – julianday(fp.first_purchase))*86400 <= 604 800 – payment is inside the first 7 days (exact to the second).  
• (julianday(p.payment_date) – julianday(fp.first_purchase))*86400 <= 2 592 000 – payment is inside the first 30 days (exact to the second).  

Below are ten exploratory SQLite queries that move from very simple inspection to the final answer.  
(Every query uses DISTINCT when it makes sense and is limited to 20 rows so it can run safely while exploring.)

```sql
-- 1. List a handful of customers that actually have payments.
SELECT DISTINCT "customer_id"
FROM "payment"
LIMIT 20;
```

```sql
-- 2. Peek at the first few payments for one customer (customer #1 here).
SELECT "payment_id", "amount", "payment_date"
FROM "payment"
WHERE "customer_id" = 1
ORDER BY "payment_date"
LIMIT 20;
```

```sql
-- 3. Find each customer's very first payment timestamp.
SELECT "customer_id",
       MIN("payment_date") AS "first_purchase"
FROM "payment"
GROUP BY "customer_id"
LIMIT 20;
```

```sql
-- 4. Compute lifetime sales (LTV) for every customer.
SELECT "customer_id",
       SUM("amount") AS "lifetime_sales"
FROM "payment"
GROUP BY "customer_id"
LIMIT 20;
```

```sql
-- 5. Lifetime sales restricted to customers that spent something.
SELECT "customer_id",
       SUM("amount") AS "lifetime_sales"
FROM "payment"
GROUP BY "customer_id"
HAVING SUM("amount") > 0
LIMIT 20;
```

```sql
-- 6. Show, for each payment, how many seconds it is after the customer's first purchase.
WITH first_time AS (
     SELECT "customer_id", MIN("payment_date") AS "first_purchase"
     FROM "payment"
     GROUP BY "customer_id"
)
SELECT p."customer_id",
       p."payment_id",
       p."amount",
       p."payment_date",
       (julianday(p."payment_date") - julianday(f."first_purchase"))*86400 AS "seconds_after_first"
FROM "payment" AS p
JOIN first_time AS f
  ON p."customer_id" = f."customer_id"
ORDER BY p."customer_id", p."payment_date"
LIMIT 20;
```

```sql
-- 7. Aggregate 7‑day revenue for each customer.
WITH first_time AS (
     SELECT "customer_id", MIN("payment_date") AS "first_purchase"
     FROM "payment"
     GROUP BY "customer_id"
)
SELECT p."customer_id",
       SUM(p."amount") AS "sales_7d"
FROM "payment" AS p
JOIN first_time AS f
  ON p."customer_id" = f."customer_id"
WHERE (julianday(p."payment_date") - julianday(f."first_purchase"))*86400 <= 604800
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
-- 8. Aggregate 7‑day and 30‑day revenue together plus lifetime value.
WITH first_time AS (
     SELECT "customer_id", MIN("payment_date") AS "first_purchase"
     FROM "payment"
     GROUP BY "customer_id"
)
SELECT p."customer_id",
       SUM(p."amount")                                                 AS "lifetime_sales",
       SUM(CASE WHEN (julianday(p."payment_date") - julianday(f."first_purchase"))*86400 <= 604800
                THEN p."amount" ELSE 0 END)                           AS "sales_7d",
       SUM(CASE WHEN (julianday(p."payment_date") - julianday(f."first_purchase"))*86400 <= 2592000
                THEN p."amount" ELSE 0 END)                           AS "sales_30d"
FROM "payment" AS p
JOIN first_time AS f
  ON p."customer_id" = f."customer_id"
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
-- 9. Add 7‑day and 30‑day percentages of lifetime sales (exclude zero‑LTV customers).
WITH first_time AS (
     SELECT "customer_id", MIN("payment_date") AS "first_purchase"
     FROM "payment"
     GROUP BY "customer_id"
),
bucket AS (
     SELECT p."customer_id",
            SUM(p."amount")                                                 AS "lifetime_sales",
            SUM(CASE WHEN (julianday(p."payment_date") - julianday(f."first_purchase"))*86400 <= 604800
                     THEN p."amount" ELSE 0 END)                            AS "sales_7d",
            SUM(CASE WHEN (julianday(p."payment_date") - julianday(f."first_purchase"))*86400 <= 2592000
                     THEN p."amount" ELSE 0 END)                            AS "sales_30d"
     FROM "payment" AS p
     JOIN first_time AS f
       ON p."customer_id" = f."customer_id"
     GROUP BY p."customer_id"
)
SELECT "customer_id",
       "lifetime_sales",
       ("sales_7d"  * 100.0) / "lifetime_sales" AS "pct_7d",
       ("sales_30d" * 100.0) / "lifetime_sales" AS "pct_30d"
FROM bucket
WHERE "lifetime_sales" > 0
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: overall averages for the percentages and for lifetime sales.
WITH first_payment AS (
     SELECT "customer_id", MIN("payment_date") AS "first_purchase"
     FROM "payment"
     GROUP BY "customer_id"
),
payments AS (
     SELECT p."customer_id",
            p."amount",
            p."payment_date",
            fp."first_purchase"
     FROM "payment" AS p
     JOIN first_payment AS fp
       ON p."customer_id" = fp."customer_id"
),
per_customer AS (
     SELECT "customer_id",
            SUM("amount")                                                         AS "lifetime_sales",
            SUM(CASE WHEN (julianday("payment_date") - julianday("first_purchase"))*86400 <= 604800
                     THEN "amount" ELSE 0 END)                                    AS "sales_7d",
            SUM(CASE WHEN (julianday("payment_date") - julianday("first_purchase"))*86400 <= 2592000
                     THEN "amount" ELSE 0 END)                                    AS "sales_30d"
     FROM payments
     GROUP BY "customer_id"
     HAVING SUM("amount") > 0        -- exclude zero‑LTV customers
),
pct AS (
     SELECT "customer_id",
            "lifetime_sales",
            ("sales_7d"  * 100.0) / "lifetime_sales" AS "pct_7d",
            ("sales_30d" * 100.0) / "lifetime_sales" AS "pct_30d"
     FROM per_customer
)
SELECT AVG("pct_7d")   AS "avg_pct_first_7_days",
       AVG("pct_30d")  AS "avg_pct_first_30_days",
       AVG("lifetime_sales") AS "avg_total_lifetime_sales"
FROM pct;
```

Run the last statement (Query 10) to get the requested three metrics:  
• average % of LTV captured in the first 7 days,  
• average % of LTV captured in the first 30 days, and  
• average total lifetime value.
