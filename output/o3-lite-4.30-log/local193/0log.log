Query:
-- 8. Aggregate 7‑day and 30‑day revenue together plus lifetime value.
WITH first_time AS (
     SELECT "customer_id", MIN("payment_date") AS "first_purchase"
     FROM "payment"
     GROUP BY "customer_id"
)
SELECT p."customer_id",
       SUM(p."amount")                                                 AS "lifetime_sales",
       SUM(CASE WHEN (julianday(p."payment_date") - julianday(f."first_purchase"))*86400 <= 604800
                THEN p."amount" ELSE 0 END)                           AS "sales_7d",
       SUM(CASE WHEN (julianday(p."payment_date") - julianday(f."first_purchase"))*86400 <= 2592000
                THEN p."amount" ELSE 0 END)                           AS "sales_30d"
FROM "payment" AS p
JOIN first_time AS f
  ON p."customer_id" = f."customer_id"
GROUP BY p."customer_id"
LIMIT 20;
