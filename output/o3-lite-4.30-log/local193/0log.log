-- 10. FINAL ANSWER: overall averages for the percentages and for lifetime sales.
WITH first_payment AS (
     SELECT "customer_id", MIN("payment_date") AS "first_purchase"
     FROM "payment"
     GROUP BY "customer_id"
),
payments AS (
     SELECT p."customer_id",
            p."amount",
            p."payment_date",
            fp."first_purchase"
     FROM "payment" AS p
     JOIN first_payment AS fp
       ON p."customer_id" = fp."customer_id"
),
per_customer AS (
     SELECT "customer_id",
            SUM("amount")                                                         AS "lifetime_sales",
            SUM(CASE WHEN (julianday("payment_date") - julianday("first_purchase"))*86400 <= 604800
                     THEN "amount" ELSE 0 END)                                    AS "sales_7d",
            SUM(CASE WHEN (julianday("payment_date") - julianday("first_purchase"))*86400 <= 2592000
                     THEN "amount" ELSE 0 END)                                    AS "sales_30d"
     FROM payments
     GROUP BY "customer_id"
     HAVING SUM("amount") > 0        -- exclude zero‑LTV customers
),
pct AS (
     SELECT "customer_id",
            "lifetime_sales",
            ("sales_7d"  * 100.0) / "lifetime_sales" AS "pct_7d",
            ("sales_30d" * 100.0) / "lifetime_sales" AS "pct_30d"
     FROM per_customer
)
SELECT AVG("pct_7d")   AS "avg_pct_first_7_days",
       AVG("pct_30d")  AS "avg_pct_first_30_days",
       AVG("lifetime_sales") AS "avg_total_lifetime_sales"
FROM pct;
