```sql
--Description:
-- Corrected version of “SQL #10”.  It produces, for every salesperson and
-- calendar year, the total sales, total quota, and their difference.
-- Because SQLite lacks FULL JOIN, we:
--   1) Build CTE “sales”  → annual sales totals.
--   2) Build CTE “quota”  → annual quota totals.
--   3) UNION ALL the two, inserting zeros for the missing metric → CTE “combined”.
--   4) Re‑aggregate “combined” into CTE “summary”.
--   5) LEFT JOIN that summary to the master “salesperson” table so that even
--      salespeople without any orders or quotas still appear.
-- The final SELECT lists each salesperson‑year with the requested difference.

WITH sales AS (
    SELECT
        salespersonid,
        strftime('%Y', orderdate) AS yr,
        SUM(totaldue)            AS total_sales
    FROM salesorderheader
    GROUP BY salespersonid, yr
),
quota AS (
    SELECT
        BusinessEntityID         AS salespersonid,
        strftime('%Y', QuotaDate) AS yr,
        SUM(SalesQuota)           AS total_quota
    FROM "SalesPersonQuotaHistory"
    GROUP BY BusinessEntityID, yr
),
combined AS (
    SELECT salespersonid, yr, total_sales, 0 AS total_quota FROM sales
    UNION ALL
    SELECT salespersonid, yr, 0 AS total_sales, total_quota FROM quota
),
summary AS (
    SELECT
        salespersonid,
        yr,
        SUM(total_sales)  AS total_sales,
        SUM(total_quota)  AS total_quota
    FROM combined
    GROUP BY salespersonid, yr
)
SELECT
    sp.businessentityid                AS salespersonid,
    s.yr                               AS year,
    COALESCE(s.total_sales, 0)         AS total_sales,
    COALESCE(s.total_quota, 0)         AS total_quota,
    COALESCE(s.total_sales, 0) -
    COALESCE(s.total_quota, 0)         AS difference
FROM salesperson AS sp
LEFT JOIN summary AS s
       ON s.salespersonid = sp.businessentityid
ORDER BY salespersonid, year
LIMIT 20;
```
