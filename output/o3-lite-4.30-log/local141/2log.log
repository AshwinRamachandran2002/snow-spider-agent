```sql
--Description / thinking process:
-- 1. Aggregate sales per salesperson per calendar year  → CTE "sales".
-- 2. Aggregate quotas per salesperson per calendar year → CTE "quota".
-- 3. SQLite lacks FULL OUTER JOIN, so UNION ALL the two result sets, 
--    putting a zero in the column that is absent on each side → CTE "combined".
-- 4. Re‑aggregate the UNION to merge duplicates and compute the
--    difference (total_sales − total_quota) for every salesperson‑year.

WITH sales AS (
    SELECT
        salespersonid,
        strftime('%Y', orderdate) AS yr,
        SUM(totaldue)            AS total_sales
    FROM salesorderheader
    GROUP BY salespersonid, yr
),
quota AS (
    SELECT
        BusinessEntityID         AS salespersonid,
        strftime('%Y', QuotaDate) AS yr,
        SUM(SalesQuota)           AS total_quota
    FROM "SalesPersonQuotaHistory"
    GROUP BY BusinessEntityID, yr
),
combined AS (
    SELECT salespersonid, yr, total_sales, 0           AS total_quota FROM sales
    UNION ALL
    SELECT salespersonid, yr, 0           AS total_sales, total_quota FROM quota
)
SELECT
    salespersonid,
    yr                                   AS year,
    SUM(total_sales)                    AS total_sales,
    SUM(total_quota)                    AS total_quota,
    SUM(total_sales) - SUM(total_quota) AS difference
FROM combined
GROUP BY salespersonid, year
ORDER BY salespersonid, year;
```
