--Description:  (#9) Produce a preview (first 20 rows) showing, for every
--              salesperson‑year present in either table, the yearly sales,
--              yearly quota and their difference.  FULL OUTER JOIN is emulated
--              by UNIONing two aggregated result sets and re‑aggregating.
WITH
sales AS (
    SELECT
        salespersonid,
        strftime('%Y', orderdate) AS yr,
        SUM(subtotal)             AS yearly_sales
    FROM salesorderheader
    GROUP BY salespersonid, strftime('%Y', orderdate)
),
quota AS (
    SELECT
        BusinessEntityID          AS salespersonid,
        strftime('%Y', QuotaDate) AS yr,
        SUM(SalesQuota)           AS yearly_quota
    FROM SalesPersonQuotaHistory
    GROUP BY BusinessEntityID, strftime('%Y', QuotaDate)
),
combined AS (
    SELECT salespersonid, yr, yearly_sales, 0 AS yearly_quota FROM sales
    UNION ALL
    SELECT salespersonid, yr, 0 AS yearly_sales, yearly_quota FROM quota
)
SELECT
    salespersonid,
    yr                              AS year,
    SUM(yearly_sales)  AS yearly_sales,
    SUM(yearly_quota)  AS yearly_quota,
    SUM(yearly_sales) - SUM(yearly_quota) AS sales_minus_quota
FROM combined
GROUP BY salespersonid, yr
ORDER BY salespersonid, yr
LIMIT 20;
