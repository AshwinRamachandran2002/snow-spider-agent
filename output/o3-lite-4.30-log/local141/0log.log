The table structure information is (table names): 
['salesperson', 'product', 'productmodelproductdescriptionculture', 'productdescription', 'productreview', 'productcategory', 'productsubcategory', 'salesorderdetail', 'salesorderheader', 'salesterritory', 'countryregioncurrency', 'currencyrate', 'SalesPersonQuotaHistory']
Begin Exploring Related Columns
Relevant columns and their potential usage  
salesorderheader.salespersonid: link each order to a salesperson.  
salesorderheader.orderdate: extract calendar year of the order.  
salesorderheader.subtotal (or totaldue): dollar value of the sale to be summed.  
SalesPersonQuotaHistory.BusinessEntityID: same person key as salespersonid / businessentityid.  
SalesPersonQuotaHistory.QuotaDate: extract calendar year of the quota.  
SalesPersonQuotaHistory.SalesQuota: monthly quota values – sum these to get an annual quota.  
salesperson.businessentityid: master list of salespeople (optional ‑ allows outer joins to include people without sales or quotas).

Typical conditions that will be useful  
• strftime('%Y', "orderdate") = strftime('%Y', "QuotaDate") to be sure we compare the same year.  
• GROUP BY salesperson / year when aggregating.  
• SUM("subtotal") or SUM("totaldue") for yearly sales; SUM("SalesQuota") for yearly quotas.  

Exploratory → final‑answer queries
```sql
-- 1) Show distinct salespeople that have any recorded quota.
SELECT DISTINCT "BusinessEntityID"
FROM "SalesPersonQuotaHistory"
LIMIT 20;

-- 2) Show distinct salespeople that have ever registered an order.
SELECT DISTINCT "salespersonid"
FROM "salesorderheader"
LIMIT 20;

-- 3) Peek at monthly quota values for one salesperson.
SELECT *
FROM "SalesPersonQuotaHistory"
WHERE "BusinessEntityID" = 274
LIMIT 20;

-- 4) Peek at sales orders for the same person to understand order amounts.
SELECT "salesorderid",
       "orderdate",
       "subtotal",
       "totaldue"
FROM "salesorderheader"
WHERE "salespersonid" = 274
ORDER BY "orderdate"
LIMIT 20;

-- 5) Compute yearly sales (Subtotal) for every salesperson.
SELECT "salespersonid",
       strftime('%Y', "orderdate") AS "year",
       SUM("subtotal")             AS "yearly_sales"
FROM "salesorderheader"
GROUP BY "salespersonid", strftime('%Y', "orderdate")
LIMIT 20;

-- 6) Compute yearly quotas for every salesperson (sum of the 12 monthly numbers).
SELECT "BusinessEntityID"                   AS "salespersonid",
       strftime('%Y', "QuotaDate")          AS "year",
       SUM("SalesQuota")                    AS "yearly_quota"
FROM "SalesPersonQuotaHistory"
GROUP BY "BusinessEntityID", strftime('%Y', "QuotaDate")
LIMIT 20;

-- 7) Join the two previous sub‑results to compare sales vs. quota.
SELECT s."salespersonid",
       s."year",
       s."yearly_sales",
       q."yearly_quota"
FROM (
        SELECT "salespersonid",
               strftime('%Y', "orderdate") AS "year",
               SUM("subtotal") AS "yearly_sales"
        FROM   "salesorderheader"
        GROUP  BY "salespersonid", strftime('%Y', "orderdate")
     ) AS s
JOIN (
        SELECT "BusinessEntityID" AS "salespersonid",
               strftime('%Y', "QuotaDate") AS "year",
               SUM("SalesQuota") AS "yearly_quota"
        FROM   "SalesPersonQuotaHistory"
        GROUP  BY "BusinessEntityID", strftime('%Y', "QuotaDate")
     ) AS q
  ON s."salespersonid" = q."salespersonid"
 AND s."year"          = q."year"
LIMIT 20;

-- 8) Same as #7 but include all salespeople even if one side (sales or quota) is missing.
SELECT COALESCE(s."salespersonid", q."salespersonid") AS "salespersonid",
       COALESCE(s."year",          q."year")          AS "year",
       s."yearly_sales",
       q."yearly_quota"
FROM (
        SELECT "salespersonid",
               strftime('%Y', "orderdate") AS "year",
               SUM("subtotal") AS "yearly_sales"
        FROM   "salesorderheader"
        GROUP  BY "salespersonid", strftime('%Y', "orderdate")
     ) AS s
FULL OUTER JOIN (
        SELECT "BusinessEntityID" AS "salespersonid",
               strftime('%Y', "QuotaDate") AS "year",
               SUM("SalesQuota") AS "yearly_quota"
        FROM   "SalesPersonQuotaHistory"
        GROUP  BY "BusinessEntityID", strftime('%Y', "QuotaDate")
     ) AS q
  ON s."salespersonid" = q."salespersonid"
 AND s."year"          = q."year"
LIMIT 20;

-- 9) Add the difference (sales – quota) for each salesperson‑year.
SELECT result."salespersonid",
       result."year",
       result."yearly_sales",
       result."yearly_quota",
       result."yearly_sales" - result."yearly_quota" AS "sales_minus_quota"
FROM (
        SELECT COALESCE(s."salespersonid", q."salespersonid") AS "salespersonid",
               COALESCE(s."year",          q."year")          AS "year",
               s."yearly_sales",
               q."yearly_quota"
        FROM (
                SELECT "salespersonid",
                       strftime('%Y', "orderdate") AS "year",
                       SUM("subtotal") AS "yearly_sales"
                FROM   "salesorderheader"
                GROUP  BY "salespersonid", strftime('%Y', "orderdate")
             ) AS s
        FULL OUTER JOIN (
                SELECT "BusinessEntityID" AS "salespersonid",
                       strftime('%Y', "QuotaDate") AS "year",
                       SUM("SalesQuota") AS "yearly_quota"
                FROM   "SalesPersonQuotaHistory"
                GROUP  BY "BusinessEntityID", strftime('%Y', "QuotaDate")
             ) AS q
          ON s."salespersonid" = q."salespersonid"
         AND s."year"          = q."year"
     ) AS result
LIMIT 20;

-- 10) Final answer query – fully aggregated, ordered, and without LIMIT.
SELECT res."salespersonid",
       res."year",
       res."yearly_sales",
       res."yearly_quota",
       res."yearly_sales" - res."yearly_quota" AS "sales_minus_quota"
FROM (
      SELECT COALESCE(s."salespersonid", q."salespersonid") AS "salespersonid",
             COALESCE(s."year",          q."year")          AS "year",
             s."yearly_sales",
             q."yearly_quota"
      FROM (
              SELECT "salespersonid",
                     strftime('%Y', "orderdate") AS "year",
                     SUM("subtotal") AS "yearly_sales"
              FROM   "salesorderheader"
              GROUP  BY "salespersonid", strftime('%Y', "orderdate")
           ) AS s
      FULL OUTER JOIN (
              SELECT "BusinessEntityID" AS "salespersonid",
                     strftime('%Y', "QuotaDate") AS "year",
                     SUM("SalesQuota") AS "yearly_quota"
              FROM   "SalesPersonQuotaHistory"
              GROUP  BY "BusinessEntityID", strftime('%Y', "QuotaDate")
           ) AS q
        ON s."salespersonid" = q."salespersonid"
       AND s."year"          = q."year"
     ) AS res
ORDER BY res."salespersonid", res."year";
```
