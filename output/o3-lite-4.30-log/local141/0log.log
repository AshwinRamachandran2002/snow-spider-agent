```sql
--Description:  Each salesperson‑year may appear in (a) SalesOrderHeader
--              (money actually sold) and/or (b) SalesPersonQuotaHistory
--              (monthly targets).  SQLite lacks FULL OUTER JOIN, so we:
--              1. Aggregate the two tables separately (yearly sales, yearly quota).
--              2. UNION the two result sets, padding the missing metric with 0.
--              3. Re‑aggregate the UNION to merge duplicates and compute
--                 sales_minus_quota = sales − quota.
--              The final output lists every salesperson‑year present in
--              either source, sorted for readability.

WITH
sales AS (          -- yearly sales per salesperson
    SELECT
        salespersonid,
        strftime('%Y', orderdate) AS yr,
        SUM(subtotal)             AS yearly_sales
    FROM salesorderheader
    GROUP BY salespersonid, strftime('%Y', orderdate)
),
quota AS (          -- yearly quota per salesperson
    SELECT
        BusinessEntityID          AS salespersonid,
        strftime('%Y', QuotaDate) AS yr,
        SUM(SalesQuota)           AS yearly_quota
    FROM SalesPersonQuotaHistory
    GROUP BY BusinessEntityID, strftime('%Y', QuotaDate)
),
combined AS (       -- put both metrics into one stream
    SELECT salespersonid, yr, yearly_sales, 0 AS yearly_quota FROM sales
    UNION ALL
    SELECT salespersonid, yr, 0 AS yearly_sales, yearly_quota FROM quota
)
SELECT
    salespersonid,
    yr                             AS year,
    SUM(yearly_sales)  AS yearly_sales,
    SUM(yearly_quota)  AS yearly_quota,
    SUM(yearly_sales) - SUM(yearly_quota) AS sales_minus_quota
FROM combined
GROUP BY salespersonid, yr
ORDER BY salespersonid, yr;
```
