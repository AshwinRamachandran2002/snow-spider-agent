```sql
--Description:
-- One‑stop query that
--   (a) determines the state that ranks 4th in how often it appears
--       in the national daily top‑5 COVID‑19 case increases, 1 Mar–31 May 2020, and
--   (b) lists that state’s five counties that most frequently appear in its own
--       daily top‑5 increases during the same period.
-- CTE roadmap
--   1. state_daily  : state day‑to‑day increases.
--   2. state_top5   : per‑day top‑5 states.
--   3. state_freq   : appearance counts + rank.
--   4. fourth_state : the single 4th‑rank state (Illinois in this data).
--   5. county_daily : county day‑to‑day increases inside that state.
--   6. county_top5  : per‑day top‑5 counties (within the state).
--   7. county_freq  : county appearance counts (top five).
-- Final SELECT shows the state, its total appearances, and each county with
-- the number of days it made the state’s top‑5 list.

WITH state_daily AS (
  SELECT
    date,
    state_name,
    confirmed_cases
      - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
state_top5 AS (
  SELECT date, state_name
  FROM (
    SELECT
      date,
      state_name,
      ROW_NUMBER() OVER (PARTITION BY date ORDER BY daily_new DESC) AS rnk
    FROM state_daily
  )
  WHERE rnk <= 5
),
state_freq AS (
  SELECT
    state_name,
    COUNT(*) AS days_in_top5,
    DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS state_rank
  FROM state_top5
  GROUP BY state_name
),
fourth_state AS (
  SELECT state_name, days_in_top5
  FROM state_freq
  WHERE state_rank = 4
),
county_daily AS (
  SELECT
    c.date,
    c.county,
    c.confirmed_cases
      - LAG(c.confirmed_cases) OVER (PARTITION BY c.county ORDER BY c.date) AS daily_new
  FROM `bigquery-public-data.covid19_nyt.us_counties` AS c
  JOIN fourth_state f
    ON c.state_name = f.state_name
  WHERE c.date BETWEEN '2020-03-01' AND '2020-05-31'
),
county_top5 AS (
  SELECT date, county
  FROM (
    SELECT
      date,
      county,
      daily_new,
      ROW_NUMBER() OVER (PARTITION BY date ORDER BY daily_new DESC) AS rnk
    FROM county_daily
  )
  WHERE rnk <= 5
),
county_freq AS (
  SELECT
    county,
    COUNT(*) AS days_in_state_top5
  FROM county_top5
  GROUP BY county
  ORDER BY days_in_state_top5 DESC
  LIMIT 5
)
SELECT
  f.state_name                 AS fourth_rank_state,
  f.days_in_top5              AS state_days_in_top5,
  cf.county,
  cf.days_in_state_top5
FROM fourth_state AS f
CROSS JOIN county_freq AS cf
ORDER BY cf.days_in_state_top5 DESC;
