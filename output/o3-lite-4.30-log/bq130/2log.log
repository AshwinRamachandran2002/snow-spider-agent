```sql
--Description:
-- Identify which U.S. state is 4th in the number of times it appears among
-- the five largest daily increases in confirmed COVID‑19 cases between
-- 01 Mar 2020 and 31 May 2020.
-- • state_daily  : compute daily new cases for every state.
-- • state_top5   : retain the five states with the highest new‑case counts
--                  on each calendar day.
-- • state_freq   : count how many days each state appears in that list.
-- • Final SELECT : sort by the count, then return the single 4th‑ranked state
--                  via LIMIT 1 OFFSET 3 (BigQuery requires LIMIT before OFFSET).

WITH state_daily AS (
  SELECT
    date,
    state_name,
    confirmed_cases
      - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
state_top5 AS (
  SELECT date, state_name
  FROM (
    SELECT
      date,
      state_name,
      ROW_NUMBER() OVER (PARTITION BY date ORDER BY daily_new DESC) AS rnk
    FROM state_daily
  )
  WHERE rnk <= 5
),
state_freq AS (
  SELECT
    state_name,
    COUNT(*) AS days_in_top5
  FROM state_top5
  GROUP BY state_name
  ORDER BY days_in_top5 DESC
)
SELECT
  state_name,
  days_in_top5
FROM state_freq
LIMIT 1 OFFSET 3;
```
