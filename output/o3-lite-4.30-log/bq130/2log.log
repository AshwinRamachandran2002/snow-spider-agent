```sql
--Description:
-- Find the state that ranks 4th in how often it appears in the nationwide
-- daily top‑5 increases (Mar‑May 2020) and then list that state’s five
-- counties that most frequently appear in its OWN daily top‑5 increases for
-- the same period.  One query, broken into CTE steps:
--   • state_daily   : state‑level new cases
--   • state_top5    : top‑5 states each day
--   • state_freq    : how many times each state appears + rank
--   • fourth_state  : the single 4th‑ranked state
--   • county_daily  : county‑level new cases in that state
--   • county_top5   : top‑5 counties each day within that state
--   • county_freq   : how many times each county appears
-- The final SELECT shows (a) the 4th‑ranked state and how many times it hit the
-- national top‑5, plus (b) that state’s five most‑frequent counties with their
-- appearance counts.

WITH state_daily AS (
  SELECT
    date,
    state_name,
    confirmed_cases
      - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
state_top5 AS (
  SELECT date, state_name
  FROM (
    SELECT
      date,
      state_name,
      ROW_NUMBER() OVER (PARTITION BY date ORDER BY daily_new DESC) AS rnk
    FROM state_daily
  )
  WHERE rnk <= 5
),
state_freq AS (
  SELECT
    state_name,
    COUNT(*) AS days_in_top5,
    DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS state_rank
  FROM state_top5
  GROUP BY state_name
),
fourth_state AS (
  SELECT state_name
  FROM state_freq
  WHERE state_rank = 4
),
county_daily AS (
  SELECT
    c.date,
    c.county,
    c.state_name,
    c.confirmed_cases
      - LAG(c.confirmed_cases) OVER (PARTITION BY c.county ORDER BY c.date) AS daily_new
  FROM `bigquery-public-data.covid19_nyt.us_counties` AS c
  JOIN fourth_state f
    ON c.state_name = f.state_name
  WHERE c.date BETWEEN '2020-03-01' AND '2020-05-31'
),
county_top5 AS (
  SELECT date, county
  FROM (
    SELECT
      date,
      county,
      ROW_NUMBER() OVER (PARTITION BY date ORDER BY daily_new DESC) AS rnk
    FROM county_daily
  )
  WHERE rnk <= 5
),
county_freq AS (
  SELECT
    county,
    COUNT(*) AS days_in_state_top5
  FROM county_top5
  GROUP BY county
)
SELECT
  f.state_name                    AS fourth_rank_state,
  sf.days_in_top5                 AS state_days_in_top5,
  cf.county,
  cf.days_in_state_top5
FROM fourth_state f
JOIN state_freq  sf ON sf.state_name = f.state_name
JOIN (
  SELECT *
  FROM county_freq
  ORDER BY days_in_state_top5 DESC
  LIMIT 5
) cf
ORDER BY cf.days_in_state_top5 DESC;
```
