```sql
-- 6. Description: count how many times each state appears in the daily top‑5 list
WITH daily_top5 AS (
  SELECT `date`, `state_name`
  FROM (
    SELECT `date`,
           `state_name`,
           `confirmed_cases`
             - LAG(`confirmed_cases`) OVER (PARTITION BY `state_name`
                                            ORDER BY `date`) AS `daily_new`
    FROM `bigquery-public-data.covid19_nyt.us_states`
    WHERE `date` BETWEEN '2020-03-01' AND '2020-05-31'
  )
  QUALIFY ROW_NUMBER() OVER (PARTITION BY `date`
                             ORDER BY `daily_new` DESC) <= 5
)
SELECT `state_name`,
