```sql
-- 2. Description: Take a quick look at Alabama’s cumulative case trajectory in early March 2020
SELECT date, state_name, confirmed_cases
FROM `bigquery-public-data.covid19_nyt.us_states`
WHERE state_name = 'Alabama'
  AND date BETWEEN '2020-03-01' AND '2020-03-10'
ORDER BY date
LIMIT 20;
```

```sql
-- 3. Description: Calculate daily new cases for all states for one sample week in March 2020
SELECT
  date,
  state_name,
  confirmed_cases - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS new_cases
FROM `bigquery-public-data.covid19_nyt.us_states`
WHERE date BETWEEN '2020-03-15' AND '2020-03-22'
ORDER BY date, state_name
LIMIT 20;
```

```sql
-- 4. Description: Rank states by daily new cases (top 5) for a single day (2020‑03‑31)
SELECT date, state_name, new_cases
FROM (
  SELECT
    date,
    state_name,
    confirmed_cases - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS new_cases,
    ROW_NUMBER() OVER (PARTITION BY date ORDER BY confirmed_cases - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) DESC) AS rn
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date = '2020-03-31'
)
WHERE rn <= 5
ORDER BY new_cases DESC
LIMIT 20;
```

```sql
