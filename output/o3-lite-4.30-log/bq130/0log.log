```

```sql
-- 6. Description: Count how often each state appears in the daily top‑5 list (March‑May 2020)
WITH daily_top5 AS (
  SELECT date, state_name
  FROM (
    SELECT
      date,
      state_name,
      confirmed_cases - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS new_cases,
      ROW_NUMBER() OVER (PARTITION BY date ORDER BY confirmed_cases - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) DESC) AS rn
    FROM `bigquery-public-data.covid19_nyt.us_states`
    WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
  )
  WHERE rn <= 5
)
SELECT state_name, COUNT(*) AS appearances
FROM daily_top5
GROUP BY state_name
