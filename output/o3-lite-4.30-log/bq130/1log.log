Begin Exploring Related Columns
Relevant columns and their potential usage

bigquery-public-data.covid19_nyt.us_states  
• date : period filter (“2020‑03‑01”–“2020‑05‑31”).  
• state_name : state identifier used in ranking.  
• confirmed_cases : cumulative total – will be differenced (LAG) to obtain DAILY new cases.

bigquery-public-data.covid19_nyt.us_counties  
• date : same period filter.  
• county : county name.  
• state_name : to restrict to the selected state.  
• confirmed_cases : cumulative total – will be differenced (LAG) to obtain DAILY new cases.

Conditions that will repeatedly appear  
WHERE date BETWEEN '2020-03-01' AND '2020-05-31'  
ORDER BY date, daily_new_cases DESC  
LIMIT 20  

-----------------------------------------------------------------
Ten exploratory → analytical SQL queries
-----------------------------------------------------------------

```sql
-- 1. Quick look at the state‑level data for early March 2020
SELECT date, state_name, confirmed_cases
FROM `bigquery-public-data.covid19_nyt.us_states`
WHERE date BETWEEN '2020-03-01' AND '2020-03-05'
ORDER BY date, state_name
LIMIT 20;
```

```sql
-- 2. Compute daily new cases for all states for the same first week of March
SELECT
  date,
  state_name,
  confirmed_cases -
    LAG(confirmed_cases) OVER(PARTITION BY state_name ORDER BY date) AS daily_new_cases
FROM `bigquery-public-data.covid19_nyt.us_states`
WHERE date BETWEEN '2020-03-01' AND '2020-03-07'
ORDER BY date, daily_new_cases DESC
LIMIT 20;
```

```sql
-- 3. Top‑5 states (by new cases) on a single day, 15 Mar 2020
WITH d AS (
  SELECT
    date,
    state_name,
    confirmed_cases -
      LAG(confirmed_cases) OVER(PARTITION BY state_name ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
)
SELECT date, state_name, daily_new_cases
FROM d
WHERE date = '2020-03-15'
ORDER BY daily_new_cases DESC
LIMIT 5;
```

```sql
-- 4. Daily TOP‑5 states between March–May 2020 (show first 20 rows)
WITH d AS (
  SELECT
    date,
    state_name,
    confirmed_cases -
      LAG(confirmed_cases) OVER(PARTITION BY state_name ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT *
FROM (
  SELECT
    date,
    state_name,
    daily_new_cases,
    ROW_NUMBER() OVER(PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
  FROM d
)
WHERE rn <= 5
ORDER BY date, rn
LIMIT 20;
```

```sql
-- 5. Frequency with which each state appears in those daily TOP‑5 lists
WITH d AS (
  SELECT
    date,
    state_name,
    confirmed_cases -
      LAG(confirmed_cases) OVER(PARTITION BY state_name ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
daily_top5 AS (
  SELECT date, state_name
  FROM (
    SELECT
      date,
      state_name,
      ROW_NUMBER() OVER(PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
    FROM d
  )
  WHERE rn <= 5
)
SELECT
  state_name,
  COUNT(*) AS appearances
FROM daily_top5
GROUP BY state_name
ORDER BY appearances DESC, state_name
LIMIT 20;
```

```sql
-- 6. Identify the state that ranks 4th by total appearances
WITH ranked AS (
  SELECT
    state_name,
    COUNT(*) AS appearances,
    RANK() OVER(ORDER BY COUNT(*) DESC) AS rnk
  FROM (
    -- reuse daily_top5 logic
    WITH d AS (
      SELECT
        date,
        state_name,
        confirmed_cases - LAG(confirmed_cases) OVER(PARTITION BY state_name ORDER BY date) AS daily_new_cases
      FROM `bigquery-public-data.covid19_nyt.us_states`
      WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
    )
    SELECT date, state_name
    FROM (
      SELECT date, state_name,
             ROW_NUMBER() OVER(PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
      FROM d)
    WHERE rn <= 5
  )
  GROUP BY state_name
)
SELECT state_name, appearances
FROM ranked
WHERE rnk = 4
LIMIT 20;
```

```sql
-- 7. Daily new cases by county for ONLY that 4th‑ranked state (replace <STATE> after you run #6)
WITH d AS (
  SELECT
    date,
    county,
    state_name,
    confirmed_cases -
      LAG(confirmed_cases) OVER(PARTITION BY county ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_counties`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
    AND state_name = '<STATE_FROM_QUERY_6>'
)
SELECT *
FROM d
WHERE date BETWEEN '2020-03-10' AND '2020-03-15'
ORDER BY date, daily_new_cases DESC
LIMIT 20;
```

```sql
-- 8. Top‑5 counties for the selected state on 10 Apr 2020
WITH d AS (
  SELECT
    date,
    county,
    confirmed_cases -
      LAG(confirmed_cases) OVER(PARTITION BY county ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_counties`
  WHERE state_name = '<STATE_FROM_QUERY_6>'
    AND date BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT date, county, daily_new_cases
FROM d
WHERE date = '2020-04-10'
ORDER BY daily_new_cases DESC
LIMIT 5;
```

```sql
-- 9. Daily TOP‑5 counties for the chosen state (first 20 rows)
WITH d AS (
  SELECT
    date,
    county,
    confirmed_cases -
      LAG(confirmed_cases) OVER(PARTITION BY county ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_counties`
  WHERE state_name = '<STATE_FROM_QUERY_6>'
    AND date BETWEEN '2020-03-01' AND '2020-05-31'
),
daily_top5_cnty AS (
  SELECT date, county
  FROM (
    SELECT
      date,
      county,
      ROW_NUMBER() OVER(PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
    FROM d
  )
  WHERE rn <= 5
)
SELECT *
FROM daily_top5_cnty
ORDER BY date, county
LIMIT 20;
```

```sql
-- 10. FINAL: Frequency of each county’s appearance in daily TOP‑5 lists for that state
WITH d AS (
  SELECT
    date,
    county,
    confirmed_cases -
      LAG(confirmed_cases) OVER(PARTITION BY county ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_counties`
  WHERE state_name = '<STATE_FROM_QUERY_6>'
    AND date BETWEEN '2020-03-01' AND '2020-05-31'
),
daily_top5_cnty AS (
  SELECT date, county
  FROM (
    SELECT
      date,
      county,
      ROW_NUMBER() OVER(PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
    FROM d
  )
  WHERE rn <= 5
)
SELECT
  county,
  COUNT(*) AS appearances
FROM daily_top5_cnty
GROUP BY county
ORDER BY appearances DESC, county
LIMIT 5;
```

