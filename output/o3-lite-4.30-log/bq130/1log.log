```sql
-- 1. Quick look at the state‑level data for early March 2020
SELECT date, state_name, confirmed_cases
FROM `bigquery-public-data.covid19_nyt.us_states`
WHERE date BETWEEN '2020-03-01' AND '2020-03-05'
ORDER BY date, state_name
LIMIT 20;
```

```sql
-- 2. Compute daily new cases for all states for the same first week of March
SELECT
  date,
  state_name,
  confirmed_cases -
    LAG(confirmed_cases) OVER(PARTITION BY state_name ORDER BY date) AS daily_new_cases
FROM `bigquery-public-data.covid19_nyt.us_states`
WHERE date BETWEEN '2020-03-01' AND '2020-03-07'
ORDER BY date, daily_new_cases DESC
LIMIT 20;
```

```sql
-- 3. Top‑5 states (by new cases) on a single day, 15 Mar 2020
WITH d AS (
  SELECT
    date,
    state_name,
    confirmed_cases -
      LAG(confirmed_cases) OVER(PARTITION BY state_name ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
)
SELECT date, state_name, daily_new_cases
FROM d
WHERE date = '2020-03-15'
ORDER BY daily_new_cases DESC
LIMIT 5;
```

```sql
-- 4. Daily TOP‑5 states between March–May 2020 (show first 20 rows)
WITH d AS (
  SELECT
    date,
    state_name,
    confirmed_cases -
      LAG(confirmed_cases) OVER(PARTITION BY state_name ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT *
FROM (
  SELECT
    date,
    state_name,
    daily_new_cases,
    ROW_NUMBER() OVER(PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
  FROM d
)
WHERE rn <= 5
ORDER BY date, rn
LIMIT 20;
```

```sql
-- 5. Frequency with which each state appears in those daily TOP‑5 lists
WITH d AS (
  SELECT
    date,
    state_name,
    confirmed_cases -
      LAG(confirmed_cases) OVER(PARTITION BY state_name ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
daily_top5 AS (
  SELECT date, state_name
  FROM (
    SELECT
      date,
      state_name,
      ROW_NUMBER() OVER(PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
    FROM d
  )
  WHERE rn <= 5
)
SELECT
  state_name,
  COUNT(*) AS appearances
FROM daily_top5
GROUP BY state_name
ORDER BY appearances DESC, state_name
LIMIT 20;
```

```sql
-- 6. Identify the state that ranks 4th by total appearances
WITH ranked AS (
  SELECT
    state_name,
    COUNT(*) AS appearances,
    RANK() OVER(ORDER BY COUNT(*) DESC) AS rnk
  FROM (
    -- reuse daily_top5 logic
    WITH d AS (
      SELECT
        date,
        state_name,
        confirmed_cases - LAG(confirmed_cases) OVER(PARTITION BY state_name ORDER BY date) AS daily_new_cases
      FROM `bigquery-public-data.covid19_nyt.us_states`
      WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
    )
    SELECT date, state_name
    FROM (
      SELECT date, state_name,
             ROW_NUMBER() OVER(PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
      FROM d)
    WHERE rn <= 5
  )
  GROUP BY state_name
)
SELECT state_name, appearances
FROM ranked
WHERE rnk = 4
LIMIT 20;
```

