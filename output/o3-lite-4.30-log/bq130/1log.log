/* -----------------------------------------------------------
   Daily‑new‑case “top‑5” analysis  (Mar 1 – May 31 2020)
   • Part 1 – States: how many days each state is in the daily top 5
   • Part 2 – Counties: do the same for the state that finishes 4th
   The query returns the two rankings together, tagged by “level”.
   ----------------------------------------------------------- */
WITH
-- ----------  STATE‑LEVEL  ----------
state_daily AS (
  SELECT
    date,
    state_name,
    confirmed_cases
      - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
state_top5_per_day AS (
  SELECT date, state_name
  FROM (
    SELECT
      date,
      state_name,
      ROW_NUMBER() OVER (PARTITION BY date
                         ORDER BY daily_new_cases DESC, state_name) AS rn
    FROM state_daily
    WHERE daily_new_cases IS NOT NULL
  )
  WHERE rn <= 5
),
state_frequency AS (
  SELECT
    state_name,
    COUNT(*) AS days_in_daily_top5
  FROM state_top5_per_day
  GROUP BY state_name
),
state_ranked AS (
  SELECT
    state_name,
    days_in_daily_top5,
    RANK() OVER (ORDER BY days_in_daily_top5 DESC, state_name) AS rnk
  FROM state_frequency
),
-- keep the overall top‑5 states
state_output AS (
  SELECT
    'state'         AS level,
    rnk             AS rank,
    state_name      AS name,
    days_in_daily_top5
  FROM state_ranked
  WHERE rnk <= 5
),

-- ----------  COUNTY‑LEVEL (for the 4th‑ranked state) ----------
target_state AS (
  -- choose one state with overall rank = 4
  SELECT state_name
  FROM state_ranked
  WHERE rnk = 4
  ORDER BY state_name               -- deterministic pick if tie
  LIMIT 1
),
county_daily AS (
  SELECT
    c.date,
    c.county,
    c.confirmed_cases
      - LAG(c.confirmed_cases) OVER (PARTITION BY c.county ORDER BY c.date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_counties` AS c
  JOIN target_state                AS t
    ON c.state_name = t.state_name
  WHERE c.date BETWEEN '2020-03-01' AND '2020-05-31'
),
county_top5_per_day AS (
  SELECT date, county
  FROM (
    SELECT
      date,
      county,
      ROW_NUMBER() OVER (PARTITION BY date
                         ORDER BY daily_new_cases DESC, county) AS rn
    FROM county_daily
    WHERE daily_new_cases IS NOT NULL
  )
  WHERE rn <= 5
),
county_frequency AS (
  SELECT
    county,
    COUNT(*) AS days_in_daily_top5
  FROM county_top5_per_day
  GROUP BY county
),
county_ranked AS (
  SELECT
    county,
    days_in_daily_top5,
    RANK() OVER (ORDER BY days_in_daily_top5 DESC, county) AS rnk
  FROM county_frequency
),
-- keep the top‑5 counties for that state
county_output AS (
  SELECT
    'county'        AS level,
    rnk             AS rank,
    county          AS name,
    days_in_daily_top5
  FROM county_ranked
  WHERE rnk <= 5
)

-- ----------  FINAL RESULT ----------
SELECT level, rank, name, days_in_daily_top5
FROM (
  SELECT * FROM state_output
  UNION ALL
  SELECT * FROM county_output
)
ORDER BY level, rank, name;
```
