```sql
--Description (thought process embedded):
-- • Illinois was found to be the 4th‑ranked state by number of appearances in the state‑level daily‑top‑5 list.
-- • To discover its leading counties, we:
--   1.  Calculate daily_new_cases for every Illinois county between 1 Mar and 31 May 2020
--      using the difference between successive cumulative confirmed_cases (LAG).
--   2.  For each date, rank counties by daily_new_cases and keep only the five with the
--      largest increases (these are that day’s “top‑5 counties”).
--   3.  Count how many times each county appears in these daily top‑5 lists.
--   4.  Return the five counties with the highest appearance counts (ties broken alphabetically).
WITH county_daily AS (
  SELECT
    date,
    county,
    confirmed_cases
      - LAG(confirmed_cases) OVER (PARTITION BY county ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_counties`
  WHERE state_name = 'Illinois'
    AND date BETWEEN '2020-03-01' AND '2020-05-31'
),
daily_top5 AS (
  SELECT date, county
  FROM (
    SELECT
      date,
      county,
      ROW_NUMBER() OVER (PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
    FROM county_daily
    WHERE daily_new_cases IS NOT NULL AND daily_new_cases > 0
  )
  WHERE rn <= 5
)
SELECT
  county,
  COUNT(*) AS appearances
FROM daily_top5
GROUP BY county
ORDER BY appearances DESC, county
LIMIT 5;
```
