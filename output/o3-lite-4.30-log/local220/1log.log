    SELECT id, home_player_5 FROM non_draw WHERE home_team_goal < away_team_goal AND home_player_5 IS NOT NULL UNION ALL
    SELECT id, home_player_6 FROM non_draw WHERE home_team_goal < away_team_goal AND home_player_6 IS NOT NULL UNION ALL
    SELECT id, home_player_7 FROM non_draw WHERE home_team_goal < away_team_goal AND home_player_7 IS NOT NULL UNION ALL
    SELECT id, home_player_8 FROM non_draw WHERE home_team_goal < away_team_goal AND home_player_8 IS NOT NULL UNION ALL
    SELECT id, home_player_9 FROM non_draw WHERE home_team_goal < away_team_goal AND home_player_9 IS NOT NULL UNION ALL
    SELECT id, home_player_10 FROM non_draw WHERE home_team_goal < away_team_goal AND home_player_10 IS NOT NULL UNION ALL
