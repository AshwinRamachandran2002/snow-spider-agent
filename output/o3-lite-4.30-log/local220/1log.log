```sql
--Description ──────────────────────────────────────────────────────────────────
--Goal:  • find the player involved in the most victories
--       • find the player involved in the most defeats
--Rules: ignore draws; count only matches in which the player actually played.
--
--Approach
-- 1. CTE non_draw        → matches with a clear winner.
-- 2. CTE winner_players  → UNION‑ALL of the 11 winning‑side slots (home* if
--                          home_team_goal > away_team_goal, otherwise away*).
-- 3. CTE loser_players   → same logic but for the losing side.
-- 4. Aggregate           → wins (count per player) and losses (count per player).
-- 5. Pick top‑1 from each and join with Player to show names and totals.
--The single statement below delivers both answers side‑by‑side.

WITH non_draw AS (
    SELECT id,
           home_team_goal, away_team_goal,
           home_player_1, home_player_2, home_player_3, home_player_4, home_player_5,
           home_player_6, home_player_7, home_player_8, home_player_9, home_player_10, home_player_11,
           away_player_1, away_player_2, away_player_3, away_player_4, away_player_5,
           away_player_6, away_player_7, away_player_8, away_player_9, away_player_10, away_player_11
    FROM   "Match"
    WHERE  home_team_goal <> away_team_goal
),
winner_players AS (
    -- home winners
    SELECT id, home_player_1 AS player_api_id FROM non_draw WHERE home_team_goal > away_team_goal AND home_player_1 IS NOT NULL UNION ALL
    SELECT id, home_player_2 FROM non_draw WHERE home_team_goal > away_team_goal AND home_player_2 IS NOT NULL UNION ALL
    SELECT id, home_player_3 FROM non_draw WHERE home_team_goal > away_team_goal AND home_player_3 IS NOT NULL UNION ALL
    SELECT id, home_player_4 FROM non_draw WHERE home_team_goal > away_team_goal AND home_player_4 IS NOT NULL UNION ALL
    SELECT id, home_player_5 FROM non_draw WHERE home_team_goal > away_team_goal AND home_player_5 IS NOT NULL UNION ALL
    SELECT id, home_player_6 FROM non_draw WHERE home_team_goal > away_team_goal AND home_player_6 IS NOT NULL UNION ALL
    SELECT id, home_player_7 FROM non_draw WHERE home_team_goal > away_team_goal AND home_player_7 IS NOT NULL UNION ALL
    SELECT id, home_player_8 FROM non_draw WHERE home_team_goal > away_team_goal AND home_player_8 IS NOT NULL UNION ALL
    SELECT id, home_player_9 FROM non_draw WHERE home_team_goal > away_team_goal AND home_player_9 IS NOT NULL UNION ALL
    SELECT id, home_player_10 FROM non_draw WHERE home_team_goal > away_team_goal AND home_player_10 IS NOT NULL UNION ALL
    SELECT id, home_player_11 FROM non_draw WHERE home_team_goal > away_team_goal AND home_player_11 IS NOT NULL
    UNION ALL
    -- away winners
    SELECT id, away_player_1 FROM non_draw WHERE away_team_goal > home_team_goal AND away_player_1 IS NOT NULL UNION ALL
    SELECT id, away_player_2 FROM non_draw WHERE away_team_goal > home_team_goal AND away_player_2 IS NOT NULL UNION ALL
    SELECT id, away_player_3 FROM non_draw WHERE away_team_goal > home_team_goal AND away_player_3 IS NOT NULL UNION ALL
    SELECT id, away_player_4 FROM non_draw WHERE away_team_goal > home_team_goal AND away_player_4 IS NOT NULL UNION ALL
    SELECT id, away_player_5 FROM non_draw WHERE away_team_goal > home_team_goal AND away_player_5 IS NOT NULL UNION ALL
    SELECT id, away_player_6 FROM non_draw WHERE away_team_goal > home_team_goal AND away_player_6 IS NOT NULL UNION ALL
    SELECT id, away_player_7 FROM non_draw WHERE away_team_goal > home_team_goal AND away_player_7 IS NOT NULL UNION ALL
    SELECT id, away_player_8 FROM non_draw WHERE away_team_goal > home_team_goal AND away_player_8 IS NOT NULL UNION ALL
    SELECT id, away_player_9 FROM non_draw WHERE away_team_goal > home_team_goal AND away_player_9 IS NOT NULL UNION ALL
    SELECT id, away_player_10 FROM non_draw WHERE away_team_goal > home_team_goal AND away_player_10 IS NOT NULL UNION ALL
    SELECT id, away_player_11 FROM non_draw WHERE away_team_goal > home_team_goal AND away_player_11 IS NOT NULL
),
loser_players AS (
    -- home losers
    SELECT id, home_player_1 AS player_api_id FROM non_draw WHERE home_team_goal < away_team_goal AND home_player_1 IS NOT NULL UNION ALL
    SELECT id, home_player_2 FROM non_draw WHERE home_team_goal < away_team_goal AND home_player_2 IS NOT NULL UNION ALL
    SELECT id, home_player_3 FROM non_draw WHERE home_team_goal < away_team_goal AND home_player_3 IS NOT NULL UNION ALL
