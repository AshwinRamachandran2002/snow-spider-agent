      UNION ALL SELECT m."away_player_2"  FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
      UNION ALL SELECT m."away_player_3"  FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
      UNION ALL SELECT m."away_player_4"  FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
      UNION ALL SELECT m."away_player_5"  FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
      UNION ALL SELECT m."away_player_6"  FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
      UNION ALL SELECT m."away_player_7"  FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
      UNION ALL SELECT m."away_player_8"  FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
      UNION ALL SELECT m."away_player_9"  FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
      UNION ALL SELECT m."away_player_10" FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
      UNION ALL SELECT m."away_player_11" FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
) AS losses
JOIN "Player" AS p
ON p."player_api_id" = losses.pid
WHERE losses.pid IS NOT NULL
GROUP BY losses.pid
ORDER BY loss_matches DESC
LIMIT 1;
