      UNION ALL SELECT m."away_player_7"  FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
      UNION ALL SELECT m."away_player_8"  FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
      UNION ALL SELECT m."away_player_9"  FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
      UNION ALL SELECT m."away_player_10" FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
      UNION ALL SELECT m."away_player_11" FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
),
-- Count wins per player
win_counts AS (
    SELECT pid, COUNT(*) AS cnt
    FROM winning_ids
    WHERE pid IS NOT NULL
    GROUP BY pid
),
-- Count losses per player
loss_counts AS (
    SELECT pid, COUNT(*) AS cnt
    FROM losing_ids
    WHERE pid IS NOT NULL
    GROUP BY pid
),
-- Player with the most wins
best_win AS (
    SELECT 'most_wins' AS category,
           p."player_name",
           wc.cnt        AS matches
    FROM win_counts wc
    JOIN "Player" p ON p."player_api_id" = wc.pid
    ORDER BY wc.cnt DESC
    LIMIT 1
),
-- Player with the most losses
worst_loss AS (
    SELECT 'most_losses' AS category,
           p."player_name",
           lc.cnt         AS matches
    FROM loss_counts lc
    JOIN "Player" p ON p."player_api_id" = lc.pid
    ORDER BY lc.cnt DESC
    LIMIT 1
)
-- Final two‑row answer
SELECT * FROM best_win
UNION ALL
SELECT * FROM worst_loss;
