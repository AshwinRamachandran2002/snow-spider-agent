      UNION ALL SELECT m."home_player_7"  FROM "Match" m WHERE m."home_team_goal" < m."away_team_goal"
      UNION ALL SELECT m."home_player_8"  FROM "Match" m WHERE m."home_team_goal" < m."away_team_goal"
      UNION ALL SELECT m."home_player_9"  FROM "Match" m WHERE m."home_team_goal" < m."away_team_goal"
      UNION ALL SELECT m."home_player_10" FROM "Match" m WHERE m."home_team_goal" < m."away_team_goal"
      UNION ALL SELECT m."home_player_11" FROM "Match" m WHERE m."home_team_goal" < m."away_team_goal"
      UNION ALL
      -- players on AWAY side when they LOST
      SELECT m."away_player_1"  FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
      UNION ALL SELECT m."away_player_2"  FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
      UNION ALL SELECT m."away_player_3"  FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
      UNION ALL SELECT m."away_player_4"  FROM "Match" m WHERE m."away_team_goal" < m."home_team_goal"
