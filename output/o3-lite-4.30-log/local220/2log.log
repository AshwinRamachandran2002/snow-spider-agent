--Description / Thinking process:
-- 1. Build two CTEs that list every player‑id that took part in a WIN
--    and every player‑id that took part in a LOSS (draws ignored).
--    Each appearance is kept with UNION ALL, so later counts are correct.
-- 2. Aggregate each list to get how many wins / losses every player has.
-- 3. Pick the top player from each set (highest wins, highest losses).
-- 4. Join to Player table for readable names and UNION the two single rows.

WITH
-- Every appearance made by a player on the WINNING side
winning_ids AS (
      /* home side won */
      SELECT m."home_player_1"  AS pid FROM "Match" m WHERE m."home_team_goal" > m."away_team_goal"
      UNION ALL SELECT m."home_player_2"  FROM "Match" m WHERE m."home_team_goal" > m."away_team_goal"
      UNION ALL SELECT m."home_player_3"  FROM "Match" m WHERE m."home_team_goal" > m."away_team_goal"
