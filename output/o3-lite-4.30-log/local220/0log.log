),
win_totals AS (
    SELECT player_id, COUNT(*) AS win_cnt
    FROM winner_appearances
    GROUP BY player_id
),
loss_totals AS (
    SELECT player_id, COUNT(*) AS loss_cnt
    FROM loser_appearances
    GROUP BY player_id
),
max_win AS (
    SELECT player_id, win_cnt
    FROM win_totals
    ORDER BY win_cnt DESC
    LIMIT 1
),
max_loss AS (
    SELECT player_id, loss_cnt
    FROM loss_totals
    ORDER BY loss_cnt DESC
    LIMIT 1
)
SELECT 'Most wins'  AS category,
       p1.player_name,
       mw.win_cnt     AS matches
FROM max_win AS mw
JOIN "Player" AS p1 ON p1.player_api_id = mw.player_id
UNION ALL
SELECT 'Most losses',
       p2.player_name,
       ml.loss_cnt
FROM max_loss AS ml
JOIN "Player" AS p2 ON p2.player_api_id = ml.player_id
LIMIT 20
