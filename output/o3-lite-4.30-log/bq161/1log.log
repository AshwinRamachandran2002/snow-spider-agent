Relevant columns and how they will be used  

Mutation table  `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`  
• `Study` : restrict to PAAD only (`Study = 'PAAD'`).  
• `Hugo_Symbol` : identify KRAS and TP53 mutations.  
• `ParticipantBarcode` : patient‑level key that will be compared with the clinical table.  
• `FILTER` : keep only high‑confidence calls (`FILTER = 'PASS'`).  

Clinical table  `isb-cgc-bq.pancancer_atlas.Filtered_clinical_PANCAN_patient_with_followup`  
• `acronym` : restrict to PAAD patients (`acronym = 'PAAD'`).  
• `bcr_patient_barcode` : joins to `ParticipantBarcode` coming from the mutation table.  

Typical conditions that will be applied  
```
WHERE Study = 'PAAD'
  AND FILTER = 'PASS'
  AND Hugo_Symbol IN ('KRAS','TP53')
```  
and, on the clinical side,  
```
WHERE acronym = 'PAAD'
```  

--------------------------------------------------------------------
Ten illustrative (increasingly complex) BigQuery SQL examples
--------------------------------------------------------------------

```sql
-- 1.  Show distinct cancer studies contained in the mutation table
SELECT DISTINCT `Study`
FROM `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`
LIMIT 20;
```

```sql
-- 2.  Inspect  KRAS mutations that passed all filters in PAAD
SELECT `ParticipantBarcode`, `Tumor_SampleBarcode`, `HGVSc`, `FILTER`
FROM `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`
WHERE Study = 'PAAD'
  AND Hugo_Symbol = 'KRAS'
  AND FILTER = 'PASS'
LIMIT 20;
```

```sql
-- 3.  Inspect TP53 mutations that passed filters in PAAD
SELECT `ParticipantBarcode`, `Tumor_SampleBarcode`, `HGVSc`, `FILTER`
FROM `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`
WHERE Study = 'PAAD'
  AND Hugo_Symbol = 'TP53'
  AND FILTER = 'PASS'
LIMIT 20;
```

```sql
-- 4.  Count of unique PAAD patients with at least one high‑confidence KRAS mutation
SELECT COUNT(DISTINCT ParticipantBarcode) AS kras_patients
FROM `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`
WHERE Study = 'PAAD'
  AND Hugo_Symbol = 'KRAS'
  AND FILTER = 'PASS'
LIMIT 20;
```

```sql
-- 5.  Count of unique PAAD patients with at least one high‑confidence TP53 mutation
SELECT COUNT(DISTINCT ParticipantBarcode) AS tp53_patients
FROM `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`
WHERE Study = 'PAAD'
  AND Hugo_Symbol = 'TP53'
  AND FILTER = 'PASS'
LIMIT 20;
```

```sql
-- 6.  List of PAAD patients who carry BOTH KRAS and TP53 mutations (passed filters)
WITH paad_kras AS (
  SELECT DISTINCT ParticipantBarcode
  FROM `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`
  WHERE Study = 'PAAD' AND Hugo_Symbol = 'KRAS' AND FILTER = 'PASS'
),
paad_tp53 AS (
  SELECT DISTINCT ParticipantBarcode
  FROM `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`
  WHERE Study = 'PAAD' AND Hugo_Symbol = 'TP53' AND FILTER = 'PASS'
)
SELECT k.ParticipantBarcode
FROM paad_kras  AS k
JOIN paad_tp53 AS t
ON  k.ParticipantBarcode = t.ParticipantBarcode
LIMIT 20;
```

```sql
-- 7.  How many PAAD patients have BOTH KRAS and TP53 mutations?
WITH paad_kras AS (
  SELECT DISTINCT ParticipantBarcode
  FROM `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`
  WHERE Study = 'PAAD' AND Hugo_Symbol = 'KRAS' AND FILTER = 'PASS'
),
paad_tp53 AS (
  SELECT DISTINCT ParticipantBarcode
  FROM `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`
  WHERE Study = 'PAAD' AND Hugo_Symbol = 'TP53' AND FILTER = 'PASS'
)
SELECT COUNT(*) AS patients_with_both
FROM (
  SELECT k.ParticipantBarcode
  FROM paad_kras k JOIN paad_tp53 t
  ON k.ParticipantBarcode = t.ParticipantBarcode
) 
LIMIT 20;
```

```sql
-- 8.  Total number of clinical PAAD patients in TCGA
SELECT COUNT(DISTINCT bcr_patient_barcode) AS total_paad_clinical
FROM `isb-cgc-bq.pancancer_atlas.Filtered_clinical_PANCAN_patient_with_followup`
WHERE acronym = 'PAAD'
LIMIT 20;
```

```sql
-- 9.  PAAD patients with NO KRAS NOR TP53 mutations (passed filters)
WITH mutated AS (
  SELECT DISTINCT ParticipantBarcode
  FROM `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`
  WHERE Study = 'PAAD'
    AND Hugo_Symbol IN ('KRAS','TP53')
    AND FILTER = 'PASS'
),
all_paad AS (
  SELECT DISTINCT bcr_patient_barcode
  FROM `isb-cgc-bq.pancancer_atlas.Filtered_clinical_PANCAN_patient_with_followup`
  WHERE acronym = 'PAAD'
)
SELECT a.bcr_patient_barcode
FROM all_paad a
LEFT JOIN mutated m
ON  a.bcr_patient_barcode = m.ParticipantBarcode
WHERE m.ParticipantBarcode IS NULL
LIMIT 20;
```

```sql
-- 10.  FINAL: counts & net difference between patients with BOTH mutations
--      and patients with neither mutation
WITH kras AS (
  SELECT DISTINCT ParticipantBarcode
  FROM `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`
  WHERE Study = 'PAAD' AND Hugo_Symbol = 'KRAS' AND FILTER = 'PASS'
),
tp53 AS (
  SELECT DISTINCT ParticipantBarcode
  FROM `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`
  WHERE Study = 'PAAD' AND Hugo_Symbol = 'TP53' AND FILTER = 'PASS'
),
both AS (
  SELECT k.ParticipantBarcode
  FROM kras k JOIN tp53 t
  ON   k.ParticipantBarcode = t.ParticipantBarcode
),
all_paad AS (
  SELECT DISTINCT bcr_patient_barcode
  FROM `isb-cgc-bq.pancancer_atlas.Filtered_clinical_PANCAN_patient_with_followup`
  WHERE acronym = 'PAAD'
),
neither AS (
  SELECT a.bcr_patient_barcode
  FROM all_paad a
  LEFT JOIN (
        SELECT DISTINCT ParticipantBarcode
        FROM `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`
        WHERE Study = 'PAAD'
          AND Hugo_Symbol IN ('KRAS','TP53')
          AND FILTER = 'PASS') m
    ON a.bcr_patient_barcode = m.ParticipantBarcode
  WHERE m.ParticipantBarcode IS NULL
)
SELECT
  (SELECT COUNT(*) FROM both   ) AS patients_with_both,
  (SELECT COUNT(*) FROM neither) AS patients_with_neither,
  (SELECT COUNT(*) FROM both) -
  (SELECT COUNT(*) FROM neither) AS net_difference
LIMIT 20;
```

These queries progress from basic data exploration to the calculation that directly answers the question: the net difference between PAAD patients carrying both KRAS and TP53 mutations that passed QC filters and PAAD patients carrying neither mutation.
