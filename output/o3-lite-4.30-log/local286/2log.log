The table structure information is (table names): 
['customers', 'sellers', 'order_reviews', 'order_items', 'products', 'geolocation', 'product_category_name_translation', 'orders', 'order_payments']
Begin Exploring Related Columns
Relevant columns and their potential usage  
------------------------------------------------  
orders.order_id: bridge key to connect reviews and items for each purchase  
orders.order_purchase_timestamp / orders.order_delivered_carrier_date: used to compute packing‑time (time from purchase to carrier pick‑up)  
order_items.order_id: ‑ joins to orders & reviews  
order_items.seller_id: seller identifier for every item sold (main grouping field)  
order_items.product_id: joins each item to its product category  
order_items.price: monetary value for sales totals and average item price  
order_reviews.order_id / order_reviews.review_score: customers’ rating of each order, used for average review score per seller  
products.product_id: joins to order_items  
products.product_category_name: original (Portuguese) category name  
product_category_name_translation.product_category_name: joins to products  
product_category_name_translation.product_category_name_english: English category name – highlighted for the categories with the highest sales volume  
Conditions that will be used  
• HAVING COUNT(*) > 100 – keep only sellers that sold > 100 items  
• WHERE order_status = 'delivered' (optional) – restrict to completed orders when needed  
• julianday(date2) – julianday(date1) – compute packing time in days  

10 exploratory SQL queries (all limited to 20 rows)  
---------------------------------------------------

```sql
--Description: Show a sample of distinct sellers that appear in the sales table
SELECT DISTINCT "seller_id"
FROM "order_items"
LIMIT 20;
```

```sql
--Description: Number of items sold by each seller (no filter yet)
SELECT "seller_id",
       COUNT(*) AS "products_sold"
FROM "order_items"
GROUP BY "seller_id"
LIMIT 20;
```

```sql
--Description: Sellers that already exceed 100 sold items
SELECT "seller_id",
       COUNT(*) AS "products_sold"
FROM "order_items"
GROUP BY "seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
--Description: Basic monetary metrics for high‑volume sellers
SELECT oi."seller_id",
       COUNT(*)                          AS "products_sold",
       SUM(oi."price")                   AS "total_sales_value",
       AVG(oi."price")                   AS "avg_item_price"
FROM "order_items" AS oi
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
--Description: Average review score per seller (all sellers)
SELECT oi."seller_id",
       AVG(orv."review_score")           AS "avg_review_score",
       COUNT(DISTINCT orv."review_id")   AS "review_qty"
FROM "order_items"  AS oi
JOIN "order_reviews" AS orv
  ON oi."order_id" = orv."order_id"
GROUP BY oi."seller_id"
LIMIT 20;
```

```sql
--Description: Raw packing‑time samples (days) by seller and order
SELECT oi."seller_id",
       o."order_purchase_timestamp",
       o."order_delivered_carrier_date",
       (julianday(o."order_delivered_carrier_date") - 
        julianday(o."order_purchase_timestamp")) AS "packing_time_days"
FROM "order_items" AS oi
JOIN "orders"      AS o
  ON oi."order_id" = o."order_id"
LIMIT 20;
```

```sql
--Description: Average packing‑time per seller
SELECT oi."seller_id",
       AVG(julianday(o."order_delivered_carrier_date") - 
           julianday(o."order_purchase_timestamp")) AS "avg_packing_time_days"
FROM "order_items" AS oi
JOIN "orders"      AS o
  ON oi."order_id" = o."order_id"
GROUP BY oi."seller_id"
LIMIT 20;
```

```sql
--Description: Overall sales volume by product category (English names)
SELECT ptn."product_category_name_english",
       COUNT(*) AS "items_sold"
FROM "order_items"                       AS oi
JOIN "products"                          AS p   ON p."product_id"  = oi."product_id"
JOIN "product_category_name_translation" AS ptn ON ptn."product_category_name" = p."product_category_name"
GROUP BY ptn."product_category_name_english"
ORDER BY COUNT(*) DESC
LIMIT 20;
```

```sql
--Description: For each seller, what is their top‑selling English category
SELECT sub."seller_id",
       sub."product_category_name_english",
       sub."items_sold"
FROM (
     SELECT oi."seller_id",
            ptn."product_category_name_english",
            COUNT(*) AS "items_sold",
            RANK() OVER (PARTITION BY oi."seller_id"
                         ORDER BY COUNT(*) DESC) AS rk
     FROM "order_items"                       AS oi
     JOIN "products"                          AS p   ON p."product_id"  = oi."product_id"
     JOIN "product_category_name_translation" AS ptn ON ptn."product_category_name" = p."product_category_name"
     GROUP BY oi."seller_id", ptn."product_category_name_english"
) AS sub
WHERE sub.rk = 1
LIMIT 20;
```

```sql
--Description: Comprehensive performance report for sellers with >100 sales
SELECT  sales."seller_id",
        sales."products_sold",
        sales."total_sales_value",
        sales."avg_item_price",
        revs."avg_review_score",
        pack."avg_packing_time_days"
FROM (
        SELECT oi."seller_id",
               COUNT(*)        AS "products_sold",
               SUM(oi."price") AS "total_sales_value",
               AVG(oi."price") AS "avg_item_price"
        FROM "order_items" AS oi
        GROUP BY oi."seller_id"
        HAVING COUNT(*) > 100
) AS sales
LEFT JOIN (
        SELECT oi."seller_id",
               AVG(orv."review_score") AS "avg_review_score"
        FROM "order_items"  AS oi
        JOIN "order_reviews" AS orv
          ON oi."order_id" = orv."order_id"
        GROUP BY oi."seller_id"
) AS revs
  ON sales."seller_id" = revs."seller_id"
LEFT JOIN (
        SELECT oi."seller_id",
               AVG(julianday(o."order_delivered_carrier_date") - 
                   julianday(o."order_purchase_timestamp")) AS "avg_packing_time_days"
        FROM "order_items" AS oi
        JOIN "orders"      AS o
          ON oi."order_id" = o."order_id"
        GROUP BY oi."seller_id"
) AS pack
  ON sales."seller_id" = pack."seller_id"
LIMIT 20;
```

