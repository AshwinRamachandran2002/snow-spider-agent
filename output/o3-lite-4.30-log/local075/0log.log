Query:
--Description: Corrected version of SQL #7.  
--Problem fixed:  the “buys” CTE was filtering out page_id 12 & 13, which are
--the only pages that actually record Purchase events, so it always returned
--zero rows.  The filter is removed for the buys CTE while it is still kept
--for the adds CTE (because Add‑to‑Cart happens on product pages).
WITH adds AS (                              -- Add‑to‑Cart counts per product
    SELECT p.product_id,
           COUNT(*) AS adds
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 2                -- “Add to Cart”
      AND  e.page_id NOT IN (1,2,12,13)    -- exclude generic pages
    GROUP  BY p.product_id
),
buys AS (                                   -- Purchase events (no page filter)
    SELECT p.product_id,
           COUNT(*) AS buys
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 3                -- “Purchase”
    GROUP  BY p.product_id
)
SELECT a.product_id,
       a.adds,
       IFNULL(b.buys,0)                             AS purchases,
       a.adds - IFNULL(b.buys,0)                    AS left_in_cart
FROM   adds a
LEFT   JOIN buys b USING (product_id)
LIMIT 20
