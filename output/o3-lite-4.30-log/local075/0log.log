```sql
--Description: Corrected version of SQL #10 (production‑ready summary).  
--Changes: Purchases CTE now keeps all Purchase events; LEFT JOINs are retained
--so every product that exists in the hierarchy still appears, and the generic
--page filter is kept only for the final output to remove non‑product pages.
WITH views AS (                             -- Views on product pages
    SELECT p.product_id, COUNT(*) AS views
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 1
      AND  e.page_id NOT IN (1,2,12,13)
    GROUP  BY p.product_id
),
adds AS (                                   -- Adds on product pages
    SELECT p.product_id, COUNT(*) AS adds
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 2
      AND  e.page_id NOT IN (1,2,12,13)
    GROUP  BY p.product_id
),
buys AS (                                   -- All Purchase events
    SELECT p.product_id, COUNT(*) AS purchases
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 3
    GROUP  BY p.product_id
)
SELECT p.product_id,
       p.page_name,
       IFNULL(v.views,0)       AS views,
       IFNULL(a.adds,0)        AS adds_to_cart,
       IFNULL(b.purchases,0)   AS purchases,
       IFNULL(a.adds,0) - IFNULL(b.purchases,0) AS left_in_cart
FROM   shopping_cart_page_hierarchy p
LEFT   JOIN views v USING(product_id)
LEFT   JOIN adds  a USING(product_id)
LEFT   JOIN buys  b USING(product_id)
WHERE  p.page_id NOT IN (1,2,12,13)         -- keep report to real products
ORDER  BY left_in_cart DESC
LIMIT 20;
