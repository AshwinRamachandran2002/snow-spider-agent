```

```sql
-- 7.  Combine “adds” and “purchases” so we can later compute leftovers
WITH adds AS (
    SELECT p.product_id, COUNT(*) AS adds
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 2
      AND  e.page_id NOT IN (1,2,12,13)
    GROUP  BY p.product_id
),
buys AS (
    SELECT p.product_id, COUNT(*) AS buys
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 3
      AND  e.page_id NOT IN (1,2,12,13)
    GROUP  BY p.product_id
)
SELECT a.product_id,
       a.adds,
       IFNULL(b.buys,0) AS purchases,
       a.adds - IFNULL(b.buys,0) AS left_in_cart
FROM   adds a
LEFT   JOIN buys b USING(product_id)
LIMIT 20;
```

```sql
-- 8.  All four metrics (views, adds, purchases, left_in_cart) in one go
WITH views AS (
    SELECT p.product_id, COUNT(*) AS views
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 1
      AND  e.page_id NOT IN (1,2,12,13)
    GROUP  BY p.product_id
),
adds AS (
    SELECT p.product_id, COUNT(*) AS adds
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 2
      AND  e.page_id NOT IN (1,2,12,13)
    GROUP  BY p.product_id
),
buys AS (
    SELECT p.product_id, COUNT(*) AS purchases
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 3
      AND  e.page_id NOT IN (1,2,12,13)
    GROUP  BY p.product_id
)
SELECT COALESCE(v.product_id,a.product_id,b.product_id)           AS product_id,
       v.views,
       a.adds,
       b.purchases,
       (IFNULL(a.adds,0) - IFNULL(b.purchases,0))                AS left_in_cart
FROM   views v
FULL   OUTER JOIN adds a       ON v.product_id = a.product_id
FULL   OUTER JOIN buys b       ON COALESCE(v.product_id,a.product_id) = b.product_id
LIMIT 20;
```

```sql
-- 9.  Same result as #8 but restricted to products that were ever viewed
WITH views AS (
    SELECT p.product_id, p.page_name, COUNT(*) AS views
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 1
      AND  e.page_id NOT IN (1,2,12,13)
    GROUP  BY p.product_id, p.page_name
),
adds AS (
    SELECT p.product_id, COUNT(*) AS adds
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 2
      AND  e.page_id NOT IN (1,2,12,13)
    GROUP  BY p.product_id
),
buys AS (
    SELECT p.product_id, COUNT(*) AS purchases
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 3
      AND  e.page_id NOT IN (1,2,12,13)
    GROUP  BY p.product_id
)
SELECT v.product_id,
       v.page_name,
       v.views,
       IFNULL(a.adds,0)        AS adds_to_cart,
       IFNULL(b.purchases,0)   AS purchases,
       IFNULL(a.adds,0) - IFNULL(b.purchases,0) AS left_in_cart
FROM   views v
LEFT  JOIN adds a USING(product_id)
LEFT  JOIN buys b USING(product_id)
LIMIT 20;
```

```sql
-- 10.  A “production‑ready” query: give the final counts for every product,
--      order by the highest number of items left in cart
WITH views AS (
    SELECT p.product_id, COUNT(*) AS views
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 1
      AND  e.page_id NOT IN (1,2,12,13)
    GROUP  BY p.product_id
),
adds AS (
    SELECT p.product_id, COUNT(*) AS adds
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 2
      AND  e.page_id NOT IN (1,2,12,13)
    GROUP  BY p.product_id
),
buys AS (
    SELECT p.product_id, COUNT(*) AS purchases
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 3
      AND  e.page_id NOT IN (1,2,12,13)
    GROUP  BY p.product_id
)
SELECT p.product_id,
       p.page_name,
       IFNULL(v.views,0)      AS views,
       IFNULL(a.adds,0)       AS adds_to_cart,
       IFNULL(b.purchases,0)  AS purchases,
       IFNULL(a.adds,0) - IFNULL(b.purchases,0) AS left_in_cart
FROM   shopping_cart_page_hierarchy p
LEFT   JOIN views v     USING(product_id)
LEFT   JOIN adds  a     USING(product_id)
LEFT   JOIN buys  b     USING(product_id)
WHERE  p.page_id NOT IN (1,2,12,13)
ORDER  BY left_in_cart DESC
LIMIT 20;
```

These queries move from data inspection to a complete per‑product breakdown of:

• views  
• adds to cart  
• purchases  
• left in cart = adds − purchases  

while always excluding page_id 1, 2, 12, 13 as required.
