```sql
WITH filtered_events AS (
    SELECT
        p.product_id,
        e.event_type
    FROM shopping_cart_events AS e
    JOIN shopping_cart_page_hierarchy AS p
          ON p.page_id = e.page_id
    -- keep only real product pages
    WHERE e.page_id NOT IN (1,2,12,13)
      AND p.product_id IS NOT NULL
),
views AS (
    SELECT product_id,
           COUNT(*) AS view_count
    FROM filtered_events
    WHERE event_type = 1                -- Page View
    GROUP BY product_id
),
adds AS (
    SELECT product_id,
           COUNT(*) AS add_to_cart_count
    FROM filtered_events
    WHERE event_type = 2                -- Add to Cart
    GROUP BY product_id
),
purchases AS (
    SELECT product_id,
           COUNT(*) AS purchase_count
    FROM filtered_events
    WHERE event_type = 3                -- Purchase
    GROUP BY product_id
),
all_products AS (                       -- union of every product that appears
    SELECT product_id FROM views
    UNION
    SELECT product_id FROM adds
    UNION
    SELECT product_id FROM purchases
)
SELECT
    ap.product_id,
    COALESCE(v.view_count,0)               AS view_count,
    COALESCE(a.add_to_cart_count,0)        AS add_to_cart_count,
    COALESCE(a.add_to_cart_count,0)
      - COALESCE(p.purchase_count,0)       AS cart_abandoned_count,
    COALESCE(p.purchase_count,0)           AS purchase_count
FROM all_products      AS ap
LEFT JOIN views        AS v USING(product_id)
LEFT JOIN adds         AS a USING(product_id)
LEFT JOIN purchases    AS p USING(product_id)
ORDER BY ap.product_id;
```
