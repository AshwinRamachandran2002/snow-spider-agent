--which pages capture these events and decide how to connect them to
--specific products later.
SELECT
    e.page_id,
    p.page_name,
    COUNT(*) AS purchase_events
FROM   shopping_cart_events AS e
LEFT   JOIN shopping_cart_page_hierarchy AS p USING(page_id)
WHERE  e.event_type = 3          -- “Purchase”
GROUP  BY e.page_id, p.page_name
ORDER  BY purchase_events DESC
LIMIT 20;
