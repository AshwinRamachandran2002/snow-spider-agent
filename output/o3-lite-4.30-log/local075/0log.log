```sql
WITH views AS (                                      -- product page‑views
    SELECT p.product_id,
           COUNT(*) AS view_count
    FROM   shopping_cart_events           AS e
    JOIN   shopping_cart_page_hierarchy   AS p
           ON p.page_id = e.page_id
    WHERE  e.event_type = 1                      -- Page View
      AND  e.page_id NOT IN (1,2,12,13)          -- exclude generic pages
    GROUP  BY p.product_id
),
adds AS (                                         -- add‑to‑cart events
    SELECT e.visit_id,
           p.product_id,
           COUNT(*) AS add_events
    FROM   shopping_cart_events           AS e
    JOIN   shopping_cart_page_hierarchy   AS p
           ON p.page_id = e.page_id
    WHERE  e.event_type = 2                      -- Add to Cart
      AND  e.page_id NOT IN (1,2,12,13)
    GROUP  BY e.visit_id, p.product_id
),
add_totals AS (                                   -- total adds per product
    SELECT product_id,
           SUM(add_events) AS add_to_cart_count
    FROM   adds
    GROUP  BY product_id
),
purchase_visits AS (                              -- visits that purchased
    SELECT DISTINCT visit_id
    FROM   shopping_cart_events
    WHERE  event_type = 3                        -- Purchase
),
purchases AS (                                    -- purchases per product
    SELECT a.product_id,
           COUNT(*) AS purchase_count
    FROM   adds a
    WHERE  a.visit_id IN (SELECT visit_id FROM purchase_visits)
    GROUP  BY a.product_id
),
all_products AS (                                 -- union of all product_ids
    SELECT product_id FROM views
    UNION
    SELECT product_id FROM add_totals
    UNION
    SELECT product_id FROM purchases
)
SELECT
    ap.product_id,
    COALESCE(v.view_count,0)                         AS view_count,
    COALESCE(at.add_to_cart_count,0)                 AS add_to_cart_count,
    COALESCE(at.add_to_cart_count,0)
        - COALESCE(p.purchase_count,0)               AS cart_abandoned_count,
    COALESCE(p.purchase_count,0)                     AS purchase_count
FROM   all_products      AS ap
LEFT   JOIN views        AS v  ON v.product_id  = ap.product_id
LEFT   JOIN add_totals   AS at ON at.product_id = ap.product_id
LEFT   JOIN purchases    AS p  ON p.product_id  = ap.product_id
ORDER  BY ap.product_id;
```
