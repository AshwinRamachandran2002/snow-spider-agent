Query:
--Description: Corrected version of SQL #8 (all four metrics).  
--Fixes applied:  
--1) Purchases CTE no longer filters out page_id 12 & 13.  
--2) Replaced the unsupported FULL OUTER JOIN with a UNION‑based approach that
--   works in SQLite.  We build a master list of all product_ids seen in any
--   of the three CTEs and then LEFT JOIN each metric onto that list.
WITH views AS (                             -- Page‑view counts
    SELECT p.product_id, COUNT(*) AS views
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 1
      AND  e.page_id NOT IN (1,2,12,13)
    GROUP  BY p.product_id
),
adds AS (                                   -- Add‑to‑Cart counts
    SELECT p.product_id, COUNT(*) AS adds
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 2
      AND  e.page_id NOT IN (1,2,12,13)
    GROUP  BY p.product_id
),
buys AS (                                   -- Purchase counts (no filter)
    SELECT p.product_id, COUNT(*) AS purchases
    FROM   shopping_cart_events e
    JOIN   shopping_cart_page_hierarchy p USING(page_id)
    WHERE  e.event_type = 3
    GROUP  BY p.product_id
),
all_products AS (                           -- union of every product_id seen
    SELECT product_id FROM views
    UNION
    SELECT product_id FROM adds
    UNION
    SELECT product_id FROM buys
)
SELECT ap.product_id,
       IFNULL(v.views,0)        AS views,
       IFNULL(a.adds,0)         AS adds_to_cart,
       IFNULL(b.purchases,0)    AS purchases,
       IFNULL(a.adds,0) - IFNULL(b.purchases,0) AS left_in_cart
FROM   all_products ap
LEFT   JOIN views v  USING(product_id)
LEFT   JOIN adds  a  USING(product_id)
LEFT   JOIN buys  b  USING(product_id)
LIMIT 20
