Query:
--Description:  Extend the previous query by also calculating how many items were
--              left in the cart (adds – purchases).  Again, purchases can be 0.
SELECT
    h."product_id",
    SUM(CASE WHEN e."event_type" = 1 THEN 1 ELSE 0 END) AS "views",
    SUM(CASE WHEN e."event_type" = 2 THEN 1 ELSE 0 END) AS "adds_to_cart",
    SUM(CASE WHEN e."event_type" = 3 THEN 1 ELSE 0 END) AS "purchases",
    SUM(CASE WHEN e."event_type" = 2 THEN 1 ELSE 0 END)
      - SUM(CASE WHEN e."event_type" = 3 THEN 1 ELSE 0 END) AS "left_in_cart"
FROM   "shopping_cart_events"          AS e
JOIN   "shopping_cart_page_hierarchy"  AS h
       ON e."page_id" = h."page_id"
WHERE  e."page_id" NOT IN (1,2,12,13)
GROUP  BY h."product_id"
LIMIT 20
