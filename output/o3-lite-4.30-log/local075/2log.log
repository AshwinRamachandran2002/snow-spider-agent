```sql
WITH product_events AS (
    SELECT
        sch.product_id,
        sce.visit_id,
        sce.event_type
    FROM   shopping_cart_events         AS sce
    JOIN   shopping_cart_page_hierarchy AS sch
           ON sch.page_id = sce.page_id
    WHERE  sce.page_id NOT IN (1, 2, 12, 13)          -- keep only real product pages
),
purchase_visits AS (                               -- all visits that completed a purchase
    SELECT DISTINCT visit_id
    FROM   shopping_cart_events
    WHERE  event_type = 3
)
SELECT
    pe.product_id,
    SUM(CASE WHEN pe.event_type = 1 THEN 1 ELSE 0 END)                                              AS view_count,
    SUM(CASE WHEN pe.event_type = 2 THEN 1 ELSE 0 END)                                              AS add_to_cart_count,
    SUM(CASE WHEN pe.event_type = 2 THEN 1 ELSE 0 END) -
    SUM(CASE WHEN pe.event_type = 2 AND pv.visit_id IS NOT NULL THEN 1 ELSE 0 END)                  AS cart_abandoned_count,
    SUM(CASE WHEN pe.event_type = 2 AND pv.visit_id IS NOT NULL THEN 1 ELSE 0 END)                  AS purchase_count
FROM   product_events      AS pe
LEFT JOIN purchase_visits  AS pv
       ON pe.visit_id = pv.visit_id
GROUP  BY pe.product_id
ORDER  BY view_count DESC;
```
