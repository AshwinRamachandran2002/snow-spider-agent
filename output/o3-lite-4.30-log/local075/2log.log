```sql
--Description: Earlier we learned that every product page (ids 3‑11) has adds but
--zero purchases when we exclude page_ids 1, 2, 12, 13.  To verify this and get
--a concise list of “abandoned‑cart” products, I aggregate add‑to‑cart and purchase
--events in one query, apply the same page filter, then keep only rows whose
--purchase_cnt = 0.  This is the simplest way to see which products were added
--but never bought.
SELECT
    sch.product_id,
    sch.page_name,
    SUM(CASE WHEN sce.event_type = 2 THEN 1 ELSE 0 END) AS add_cnt,
    SUM(CASE WHEN sce.event_type = 3 THEN 1 ELSE 0 END) AS purchase_cnt
FROM   shopping_cart_events AS sce
JOIN   shopping_cart_page_hierarchy AS sch
       ON sch.page_id = sce.page_id
WHERE  sce.page_id NOT IN (1, 2, 12, 13)         -- exclude non‑product pages
  AND  sce.event_type IN (2, 3)                  -- keep only adds & purchases
GROUP  BY sch.product_id, sch.page_name
HAVING purchase_cnt = 0                          -- carted but never purchased
LIMIT 20;
```
