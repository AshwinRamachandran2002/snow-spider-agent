```sql
--Description: Side‑by‑side comparison of all requested metrics (postal‑code vs census‑tract) for every state.  
--             Each WITH‑clause aggregates one source table by state; the final SELECT joins  
--             the two aggregates and lists suitability estimates, panel count, kW, kWh, CO₂ offset,  
--             and current installs for both geographic levels.  Limited to 20 rows for a quick look.
WITH postal AS (
  SELECT
    state_name,
    /* scale up qualified buildings to the whole state area that could be covered */
    SUM(count_qualified / (percent_covered/100.0)) AS est_suitable_postal,
    SUM(number_of_panels_total)                     AS panels_postal,
    SUM(kw_total)                                   AS kw_postal,
    SUM(yearly_sunlight_kwh_total)                  AS kwh_postal,
    SUM(carbon_offset_metric_tons)                  AS co2_postal,
    SUM(existing_installs_count)                    AS installs_postal
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
  WHERE percent_covered > 0
  GROUP BY state_name
),
tract AS (
  SELECT
    state_name,
    SUM(count_qualified / (percent_covered/100.0)) AS est_suitable_tract,
    SUM(number_of_panels_total)                     AS panels_tract,
    SUM(kw_total)                                   AS kw_tract,
    SUM(yearly_sunlight_kwh_total)                  AS kwh_tract,
    SUM(carbon_offset_metric_tons)                  AS co2_tract,
    SUM(existing_installs_count)                    AS installs_tract
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
  WHERE percent_covered > 0
  GROUP BY state_name
)
SELECT
  p.state_name,
  est_suitable_postal, panels_postal, kw_postal, kwh_postal, co2_postal, installs_postal,
  est_suitable_tract,  panels_tract,  kw_tract,  kwh_tract,  co2_tract,  installs_tract
FROM postal AS p
JOIN tract  AS t USING (state_name)
ORDER BY p.state_name
LIMIT 20;
```

```sql
--Description: Final comprehensive postal‑code–level report of by‑state metrics.  
--             Provides totals, averages, and the installation gap (potential minus current installs).  
--             Filters out rows where percent_covered = 0 to avoid divide‑by‑zero,  
--             groups by state, and limits to 20 rows for fast validation.
SELECT
  state_name,
  /* basic counts and averages */
  SUM(count_qualified)                       AS qualified_buildings_postal,
  AVG(percent_covered)                       AS avg_percent_covered_postal,
  AVG(percent_qualified)                     AS avg_percent_qualified_postal,
  /* solar capacity and energy potential */
  SUM(number_of_panels_total)                AS panels_total_postal,
  SUM(kw_total)                              AS kw_total_postal,
  SUM(yearly_sunlight_kwh_total)             AS kwh_total_postal,
  SUM(carbon_offset_metric_tons)             AS co2_offset_postal,
  /* existing installs */
  SUM(existing_installs_count)               AS installs_now_postal,
  /* potential gap = scaled suitable buildings minus current installs */
  SUM(count_qualified / (percent_covered/100.0)) -
  SUM(existing_installs_count)               AS potential_install_gap_postal
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
WHERE percent_covered > 0
GROUP BY state_name
ORDER BY state_name
LIMIT 20;
```
