    SUM(existing_installs_count)                                    AS installs_now
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
  GROUP BY state_name

  UNION ALL

  SELECT
    'census_tract' AS granularity,
    state_name,
    SUM(count_qualified)                                            AS buildings_qualified,
    AVG(percent_covered)                                            AS avg_pct_covered,
    AVG(percent_qualified)                                          AS avg_pct_suitable,
    SUM(number_of_panels_total)                                     AS panel_count,
    SUM(kw_total)                                                   AS kw_capacity,
    SUM(yearly_sunlight_kwh_total)                                  AS kwh_potential,
    SUM(carbon_offset_metric_tons)                                  AS co2_offset,
    SUM(existing_installs_count)                                    AS installs_now
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
  GROUP BY state_name
)
SELECT
  granularity,
  state_name,
  buildings_qualified,
  avg_pct_covered,
  avg_pct_suitable,
  panel_count,
  kw_capacity,
  kwh_potential,
  co2_offset,
  installs_now,
  -- Estimated total suitable buildings across *all* building stock
  (buildings_qualified / (avg_pct_covered/100)) *
      (avg_pct_suitable/100)                                      AS est_total_suitable_buildings,
  -- Potential installation gap
  ((buildings_qualified / (avg_pct_covered/100)) *
      (avg_pct_suitable/100)) - installs_now                      AS potential_install_gap
FROM base
ORDER BY state_name, granularity
LIMIT 20;
