-- 7) Potential‑installation GAP at postal‑code level
SELECT state_name,
       SUM(count_qualified)                                             AS qualified_zip,
       SUM(existing_installs_count)                                     AS current_installs,
       SUM(count_qualified)/AVG(percent_qualified/100)/AVG(percent_covered/100)
         AS potential_total_bldgs,
       (SUM(count_qualified)/AVG(percent_qualified/100)/AVG(percent_covered/100))
         - SUM(existing_installs_count)                                 AS gap_zip
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
GROUP BY state_name
ORDER BY gap_zip DESC
LIMIT 20;
