WITH first_answers AS (
  -- for every 2021 question, find the timestamp of its very first answer (if any)
  SELECT
    q.id,
    q.creation_date                           AS q_time,
    MIN(a.creation_date)                      AS first_answer_time
  FROM  `bigquery-public-data.stackoverflow.posts_questions` q
  LEFT JOIN `bigquery-public-data.stackoverflow.posts_answers` a
         ON a.parent_id = q.id
  WHERE EXTRACT(YEAR FROM q.creation_date) = 2021
  GROUP BY q.id, q.creation_date
)

SELECT
  FORMAT_TIMESTAMP('%A', q_time)                                                  AS day_of_week,
  COUNT(*)                                                                        AS total_questions,
  COUNTIF(first_answer_time IS NOT NULL
          AND TIMESTAMP_DIFF(first_answer_time, q_time, SECOND) <= 3600)          AS answered_within_1h,
