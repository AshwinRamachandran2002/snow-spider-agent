Begin Exploring Related Columns
Relevant columns and how they will be used  

`posts_questions.id`: unique question id – needed for joining with answers  
`posts_questions.creation_date`: when the question was asked – to (1) keep only 2021 questions and (2) derive day‑of‑week  
`posts_questions.answer_count`: quick indicator that a question ever received an answer (optional filter)  
`posts_answers.parent_id`: foreign‑key pointing to the question id – lets us attach answers to questions  
`posts_answers.creation_date`: when each answer was posted – lets us find the first answer and measure the time‑gap to the question  

Main conditions that will appear  
• `EXTRACT(YEAR FROM creation_date) = 2021` – restrict to year 2021  
• `TIMESTAMP_DIFF(first_answer, question_time, SECOND) <= 3600` – answered within 60 minutes  

Below are 10 step‑by‑step BigQuery SQL snippets (each limited to 20 rows where practical) that progress from simple exploration to the final answer.

```sql
-- 1. Peek at 2021 questions
SELECT id, creation_date
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE EXTRACT(YEAR FROM creation_date) = 2021
LIMIT 20;
```

```sql
-- 2. Count all 2021 questions
SELECT COUNT(*) AS total_q_2021
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE EXTRACT(YEAR FROM creation_date) = 2021;
```

```sql
-- 3. List distinct days of week that appear in 2021 questions
SELECT DISTINCT FORMAT_TIMESTAMP('%A', creation_date) AS day_of_week
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE EXTRACT(YEAR FROM creation_date) = 2021
LIMIT 20;
```

```sql
-- 4. Number of 2021 questions per weekday
SELECT
  FORMAT_TIMESTAMP('%A', creation_date) AS day_of_week,
  COUNT(*) AS questions_asked
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE EXTRACT(YEAR FROM creation_date) = 2021
GROUP BY day_of_week
ORDER BY questions_asked DESC;
```

```sql
-- 5. Join each 2021 question with ALL its answers (unfiltered)
SELECT q.id AS q_id,
       q.creation_date AS q_time,
       a.creation_date AS a_time
FROM `bigquery-public-data.stackoverflow.posts_questions`  AS q
JOIN `bigquery-public-data.stackoverflow.posts_answers`    AS a
ON  a.parent_id = q.id
WHERE EXTRACT(YEAR FROM q.creation_date) = 2021
LIMIT 20;
```

```sql
-- 6. For every 2021 question, pick the first (earliest) answer
SELECT
  q.id,
  q.creation_date                                AS q_time,
  MIN(a.creation_date)                           AS first_answer_time
FROM `bigquery-public-data.stackoverflow.posts_questions` q
JOIN `bigquery-public-data.stackoverflow.posts_answers`   a
ON  a.parent_id = q.id
WHERE EXTRACT(YEAR FROM q.creation_date) = 2021
GROUP BY q.id, q.creation_date
LIMIT 20;
```

```sql
-- 7. Flag questions answered within 1 hour
SELECT
  id,
  q_time,
  first_answer_time,
  TIMESTAMP_DIFF(first_answer_time, q_time, SECOND) AS seconds_to_first_answer,
  TIMESTAMP_DIFF(first_answer_time, q_time, SECOND) <= 3600 AS answered_within_hour
FROM (
  SELECT
    q.id,
    q.creation_date  AS q_time,
    MIN(a.creation_date) AS first_answer_time
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN `bigquery-public-data.stackoverflow.posts_answers`   a
  ON  a.parent_id = q.id
  WHERE EXTRACT(YEAR FROM q.creation_date) = 2021
  GROUP BY q.id, q.creation_date
)
LIMIT 20;
```

```sql
-- 8. Count per weekday how many questions got an answer within 1 hour
WITH first_answers AS (
  SELECT
    q.id,
    q.creation_date                       AS q_time,
    MIN(a.creation_date)                  AS first_answer_time
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN `bigquery-public-data.stackoverflow.posts_answers`   a
  ON  a.parent_id = q.id
  WHERE EXTRACT(YEAR FROM q.creation_date) = 2021
  GROUP BY q.id, q.creation_date
)
SELECT
  FORMAT_TIMESTAMP('%A', q_time)                              AS day_of_week,
  COUNTIF(TIMESTAMP_DIFF(first_answer_time, q_time, SECOND) <= 3600) AS answered_in_1h
FROM first_answers
GROUP BY day_of_week
ORDER BY day_of_week
LIMIT 20;
```

```sql
-- 9. Pull both totals and answered‑within‑1h counts in one shot
WITH first_answers AS (
  SELECT
    q.id,
    q.creation_date                       AS q_time,
    MIN(a.creation_date)                  AS first_answer_time
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN `bigquery-public-data.stackoverflow.posts_answers`   a
  ON  a.parent_id = q.id
  WHERE EXTRACT(YEAR FROM q.creation_date) = 2021
  GROUP BY q.id, q.creation_date
)
SELECT
  FORMAT_TIMESTAMP('%A', q_time)                                          AS day_of_week,
  COUNT(*)                                                                 AS total_questions,
  COUNTIF(TIMESTAMP_DIFF(first_answer_time, q_time, SECOND) <= 3600)       AS answered_in_1h
FROM first_answers
GROUP BY day_of_week
ORDER BY day_of_week
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: weekday, total questions, answered in ≤1 h, and percentage
WITH first_answers AS (
  SELECT
    q.id,
    q.creation_date                       AS q_time,
    MIN(a.creation_date)                  AS first_answer_time
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  LEFT JOIN `bigquery-public-data.stackoverflow.posts_answers`   a
  ON  a.parent_id = q.id
  WHERE EXTRACT(YEAR FROM q.creation_date) = 2021
  GROUP BY q.id, q.creation_date
)
SELECT
  FORMAT_TIMESTAMP('%A', q_time)                                     AS day_of_week,
  COUNT(*)                                                           AS total_questions,
  COUNTIF(first_answer_time IS NOT NULL
          AND TIMESTAMP_DIFF(first_answer_time, q_time, SECOND) <= 3600)
      AS answered_in_1h,
  SAFE_DIVIDE(
      COUNTIF(first_answer_time IS NOT NULL
              AND TIMESTAMP_DIFF(first_answer_time, q_time, SECOND) <= 3600)
    , COUNT(*)
  ) * 100.0                                                          AS pct_answered_in_1h
FROM first_answers
GROUP BY day_of_week
ORDER BY day_of_week;
```

