--Description / Thinking process:
-- We need, for each weekday in 2021, to know:
--   1. How many Stack Overflow questions were asked.
--   2. How many of those received their first answer within 60 minutes.
--   3. The percentage that represents.
-- Steps:
--   a. Pull all 2021 questions and note their weekday (EXTRACT(DAYOFWEEK)).
--   b. Pre‑compute the earliest answer time for every question (MIN over answers table).
--   c. Join a + b; compute the minute gap with TIMESTAMP_DIFF.
--   d. Aggregate per weekday with COUNT(*) and COUNTIF(gap≤60), then derive the %.
WITH
  -- a. Questions asked during calendar year‑2021
  questions_2021 AS (
    SELECT
      id                            AS q_id,
      creation_date                 AS q_time,
      EXTRACT(DAYOFWEEK FROM creation_date) AS weekday_num   -- 1=Sun … 7=Sat
    FROM `bigquery-public-data.stackoverflow.posts_questions`
    WHERE creation_date >= '2021-01-01'
      AND creation_date <  '2022-01-01'
  ),

  -- b. First (earliest) answer for each question
  first_answers AS (
    SELECT
      parent_id                     AS q_id,
      MIN(creation_date)            AS first_ans_time
    FROM `bigquery-public-data.stackoverflow.posts_answers`
    GROUP BY parent_id
  )

-- c & d. Combine, flag answers within 60 min, summarise per weekday
SELECT
  q.weekday_num,
  COUNT(*) AS total_questions,
  COUNTIF(
    TIMESTAMP_DIFF(first_ans_time, q.q_time, MINUTE) <= 60
  ) AS answered_within_hour,
  ROUND(
    100 * COUNTIF(
           TIMESTAMP_DIFF(first_ans_time, q.q_time, MINUTE) <= 60
         ) / COUNT(*),
    2
  ) AS pct_within_hour
FROM questions_2021 AS q
LEFT JOIN first_answers AS f
  ON f.q_id = q.q_id
GROUP BY q.weekday_num
ORDER BY q.weekday_num;
