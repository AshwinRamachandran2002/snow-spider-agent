The table structure information is ({database name: {schema name: [table name]}}): 
{'bigquery-public-data': {'stackoverflow': ['posts_answers', 'users', 'posts_orphaned_tag_wiki', 'posts_tag_wiki', 'stackoverflow_posts', 'posts_questions', 'comments', 'posts_tag_wiki_excerpt', 'posts_wiki_placeholder', 'posts_privilege_wiki', 'post_history', 'badges', 'post_links', 'tags', 'votes', 'posts_moderator_nomination']}}
Begin Exploring Related Columns
Relevant columns and their roles  
`posts_questions.id`: primary key for each question; used to join with answers.  
`posts_questions.creation_date`: timestamp when the question was asked; used to filter to the 2021‑calendar year and to derive the weekday.  
`posts_answers.parent_id`: the question id that the answer belongs to; join key to connect answers to their questions.  
`posts_answers.creation_date`: timestamp when each answer was posted; used to find the first answer and to calculate “answered within 1 hour”.  

Conditions that will be useful  
• `posts_questions.creation_date BETWEEN '2021-01-01' AND '2021-12-31 23:59:59'` – restrict questions to the 2021 year.  
• `EXTRACT(DAYOFWEEK FROM posts_questions.creation_date)` – obtain weekday (1‑Sunday … 7‑Saturday).  
• `TIMESTAMP_DIFF(first_answer_ts , question_ts , MINUTE) <= 60` – flag questions that received an answer within one hour.  

Below are ten progressively‑built BigQuery SQL queries (all capped with `LIMIT 20` for demonstration) that explore the data and culminate in the final answer.

```sql
-- 1. Peek at a few 2021 questions (id + timestamp)
SELECT id,
       creation_date
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE creation_date BETWEEN '2021-01-01' AND '2021-12-31 23:59:59'
LIMIT 20;
```

```sql
-- 2. Same rows but with the weekday extracted (1‑Sun … 7‑Sat)
SELECT id,
       creation_date,
       EXTRACT(DAYOFWEEK FROM creation_date) AS weekday
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE creation_date BETWEEN '2021-01-01' AND '2021-12-31 23:59:59'
LIMIT 20;
```

```sql
-- 3. Quick count of questions by weekday in 2021
SELECT
  EXTRACT(DAYOFWEEK FROM creation_date) AS weekday,
  COUNT(*) AS question_cnt
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE creation_date BETWEEN '2021-01-01' AND '2021-12-31 23:59:59'
GROUP BY weekday
ORDER BY weekday
LIMIT 20;
```

```sql
-- 4. Inspect a few answers that refer to 2021 questions
SELECT a.id AS answer_id,
       a.parent_id AS question_id,
       a.creation_date AS answer_ts
FROM   `bigquery-public-data.stackoverflow.posts_answers` AS a
JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
       ON q.id = a.parent_id
WHERE  q.creation_date BETWEEN '2021-01-01' AND '2021-12-31 23:59:59'
LIMIT 20;
```

```sql
-- 5. For 20 questions, show their first answer timestamp and the time‑difference in minutes
WITH first_answer AS (
  SELECT parent_id            AS question_id,
         MIN(creation_date)   AS first_answer_ts
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  GROUP  BY parent_id
)
SELECT q.id                                     AS question_id,
       q.creation_date                          AS question_ts,
       f.first_answer_ts,
       TIMESTAMP_DIFF(f.first_answer_ts , q.creation_date , MINUTE) AS minutes_to_first_answer
FROM   `bigquery-public-data.stackoverflow.posts_questions` AS q
LEFT  JOIN first_answer AS f
       ON f.question_id = q.id
WHERE  q.creation_date BETWEEN '2021-01-01' AND '2021-12-31 23:59:59'
LIMIT 20;
```

```sql
-- 6. Mark questions that were answered within 60 minutes
WITH first_answer AS (
  SELECT parent_id, MIN(creation_date) AS first_answer_ts
  FROM `bigquery-public-data.stackoverflow.posts_answers`
  GROUP BY parent_id
)
SELECT q.id,
       EXTRACT(DAYOFWEEK FROM q.creation_date) AS weekday,
       CASE
         WHEN f.first_answer_ts IS NOT NULL
              AND TIMESTAMP_DIFF(f.first_answer_ts , q.creation_date , MINUTE) <= 60
         THEN 1 ELSE 0 END AS answered_within_1h
FROM `bigquery-public-data.stackoverflow.posts_questions` AS q
LEFT JOIN first_answer AS f
       ON f.parent_id = q.id
WHERE q.creation_date BETWEEN '2021-01-01' AND '2021-12-31 23:59:59'
LIMIT 20;
```

```sql
-- 7. Aggregate counts of total questions vs. 1‑hour‑answered per weekday
WITH first_answer AS (
  SELECT parent_id, MIN(creation_date) AS first_answer_ts
  FROM `bigquery-public-data.stackoverflow.posts_answers`
  GROUP BY parent_id
), flags AS (
  SELECT q.id,
         EXTRACT(DAYOFWEEK FROM q.creation_date) AS weekday,
         CASE
           WHEN f.first_answer_ts IS NOT NULL
                AND TIMESTAMP_DIFF(f.first_answer_ts , q.creation_date , MINUTE) <= 60
           THEN 1 ELSE 0 END AS answered_within_1h
  FROM `bigquery-public-data.stackoverflow.posts_questions` AS q
  LEFT JOIN first_answer AS f
         ON f.parent_id = q.id
  WHERE q.creation_date BETWEEN '2021-01-01' AND '2021-12-31 23:59:59'
)
SELECT weekday,
       COUNT(*)                             AS total_questions,
       SUM(answered_within_1h)              AS answered_in_1h
FROM   flags
GROUP  BY weekday
ORDER  BY weekday
LIMIT 20;
```

```sql
-- 8. Add percentage of questions answered within one hour
WITH first_answer AS (
  SELECT parent_id, MIN(creation_date) AS first_answer_ts
  FROM `bigquery-public-data.stackoverflow.posts_answers`
  GROUP BY parent_id
), flags AS (
  SELECT q.id,
         EXTRACT(DAYOFWEEK FROM q.creation_date) AS weekday,
         CASE
           WHEN f.first_answer_ts IS NOT NULL
                AND TIMESTAMP_DIFF(f.first_answer_ts , q.creation_date , MINUTE) <= 60
           THEN 1 ELSE 0 END AS answered_within_1h
  FROM `bigquery-public-data.stackoverflow.posts_questions` AS q
  LEFT JOIN first_answer AS f
         ON f.parent_id = q.id
  WHERE q.creation_date BETWEEN '2021-01-01' AND '2021-12-31 23:59:59'
)
SELECT weekday,
       COUNT(*)                             AS total_questions,
       SUM(answered_within_1h)              AS answered_in_1h,
       100 * SAFE_DIVIDE(SUM(answered_within_1h), COUNT(*)) AS pct_answered_in_1h
FROM   flags
GROUP  BY weekday
ORDER  BY weekday
LIMIT 20;
```

```sql
-- 9. Same logic as #8 but restrict to questions that eventually received at least one answer
WITH first_answer AS (
  SELECT parent_id, MIN(creation_date) AS first_answer_ts
  FROM `bigquery-public-data.stackoverflow.posts_answers`
  GROUP BY parent_id
), flags AS (
  SELECT q.id,
         EXTRACT(DAYOFWEEK FROM q.creation_date) AS weekday,
         TIMESTAMP_DIFF(f.first_answer_ts , q.creation_date , MINUTE)  AS minutes_to_answer
  FROM `bigquery-public-data.stackoverflow.posts_questions` AS q
  JOIN first_answer AS f                   -- inner join = only answered questions
       ON f.parent_id = q.id
  WHERE q.creation_date BETWEEN '2021-01-01' AND '2021-12-31 23:59:59'
)
SELECT weekday,
       COUNT(*) AS answered_questions,
       SUM(CASE WHEN minutes_to_answer <= 60 THEN 1 ELSE 0 END) AS answered_in_1h,
       100 * SAFE_DIVIDE(SUM(CASE WHEN minutes_to_answer <= 60 THEN 1 ELSE 0 END),
                         COUNT(*)) AS pct_answered_in_1h
FROM flags
GROUP BY weekday
ORDER BY weekday
LIMIT 20;
```

```sql
-- 10. Final summary: total questions per weekday in 2021,
--     how many & what percent received their first answer ≤ 1 hour
WITH first_answer AS (
  SELECT parent_id, MIN(creation_date) AS first_answer_ts
  FROM `bigquery-public-data.stackoverflow.posts_answers`
  GROUP BY parent_id
), stats AS (
  SELECT
    EXTRACT(DAYOFWEEK FROM q.creation_date) AS weekday,
    1 AS question_flag,
    CASE
      WHEN f.first_answer_ts IS NOT NULL
           AND TIMESTAMP_DIFF(f.first_answer_ts , q.creation_date , MINUTE) <= 60
      THEN 1 ELSE 0 END AS answered_within_1h_flag
  FROM `bigquery-public-data.stackoverflow.posts_questions` AS q
  LEFT JOIN first_answer AS f
         ON f.parent_id = q.id
  WHERE q.creation_date BETWEEN '2021-01-01' AND '2021-12-31 23:59:59'
)
SELECT
  weekday,
  SUM(question_flag)                 AS total_questions,
  SUM(answered_within_1h_flag)       AS answered_within_1h,
  100 * SAFE_DIVIDE(SUM(answered_within_1h_flag), SUM(question_flag)) AS pct_answered_within_1h
FROM stats
GROUP BY weekday
ORDER BY weekday
LIMIT 20;
```

The last query (#10) directly produces the requested metrics: the count of questions posted on each weekday during 2021, how many of those received an answer within one hour, and the corresponding percentage.
