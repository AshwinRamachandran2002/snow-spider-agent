Begin Exploring Related Columns
Relevant tables, columns & possible conditions
• legislators.id_bioguide : join‑key to legislators_terms  
• legislators.gender : filter to only “F” (female)  
• legislators.full_name : for readability / checks  
• legislators_terms.id_bioguide : join‑key  
• legislators_terms.term_start / term_end : to test whether a term includes 31‑Dec of **that same year**  
• legislators_terms.state : state abbreviation to be counted  
• legislators_terms.term_number (or the dates themselves) : to identify the *first* state a legislator ever represented  

Typical date condition we will use  
date( strftime('%Y', lt.term_start) || '-12-31')  BETWEEN date(lt.term_start) AND date(lt.term_end)  

(The expression builds the 31‑Dec date of the term’s start‑year and checks that it lies inside the term.)

-----------------------------------------------------------------
10 step‑by‑step exploratory queries
-----------------------------------------------------------------

```sql
-- 1. Inspect gender values that exist in legislators
SELECT DISTINCT gender
FROM legislators
LIMIT 20;
```

```sql
-- 2. List 20 female legislators (id and name only)
SELECT id_bioguide,
       full_name
FROM legislators
WHERE gender = 'F'
LIMIT 20;
```

```sql
-- 3. Join terms of female legislators to see their states and dates
SELECT lt.id_bioguide,
       l.full_name,
       lt.state,
       lt.term_start,
       lt.term_end
FROM legislators_terms AS lt
JOIN legislators       AS l
  ON lt.id_bioguide = l.id_bioguide
WHERE l.gender = 'F'
LIMIT 20;
```

```sql
-- 4. Show a few terms (any gender) whose span contains 31‑Dec
SELECT id_bioguide,
       term_start,
       term_end
FROM legislators_terms
WHERE date(strftime('%Y', term_start) || '-12-31')
      BETWEEN date(term_start) AND date(term_end)
LIMIT 20;
```

```sql
-- 5. Same as #4 but keep only *female* legislators
SELECT lt.id_bioguide,
       l.full_name,
       lt.term_start,
       lt.term_end
FROM legislators_terms AS lt
JOIN legislators       AS l
  ON lt.id_bioguide = l.id_bioguide
WHERE l.gender = 'F'
  AND date(strftime('%Y', lt.term_start) || '-12-31')
      BETWEEN date(lt.term_start) AND date(lt.term_end)
LIMIT 20;
```

```sql
-- 6. For each female legislator, list all terms that contain 31‑Dec
SELECT l.id_bioguide,
       l.full_name,
       lt.state,
       lt.term_start,
       lt.term_end
FROM legislators_terms AS lt
JOIN legislators       AS l
  ON lt.id_bioguide = l.id_bioguide
WHERE l.gender = 'F'
  AND date(strftime('%Y', lt.term_start) || '-12-31')
      BETWEEN date(lt.term_start) AND date(lt.term_end)
ORDER BY l.id_bioguide,
         lt.term_start
LIMIT 20;
```

```sql
-- 7. Derive the *first* state each female legislator ever represented
WITH first_term AS (
  SELECT lt.id_bioguide,
         lt.state,
         MIN(date(lt.term_start)) AS first_term_start
  FROM legislators_terms AS lt
  JOIN legislators       AS l
    ON lt.id_bioguide = l.id_bioguide
  WHERE l.gender = 'F'
  GROUP BY lt.id_bioguide
)
SELECT *
FROM first_term
LIMIT 20;
```

```sql
-- 8. Keep only those legislators whose *any* term contained 31‑Dec,
--    then grab their first state
WITH dec31_females AS (
  SELECT DISTINCT lt.id_bioguide
  FROM legislators_terms AS lt
  JOIN legislators       AS l
    ON lt.id_bioguide = l.id_bioguide
  WHERE l.gender = 'F'
    AND date(strftime('%Y', lt.term_start) || '-12-31')
        BETWEEN date(lt.term_start) AND date(lt.term_end)
),
first_state AS (
  SELECT f.id_bioguide,
         lt.state,
         lt.term_start
  FROM dec31_females AS f
  JOIN legislators_terms AS lt
    ON f.id_bioguide = lt.id_bioguide
  WHERE lt.term_start = (
        SELECT MIN(term_start)
        FROM legislators_terms
        WHERE id_bioguide = lt.id_bioguide
  )
)
SELECT *
FROM first_state
LIMIT 20;
```

```sql
-- 9. Count how many such female legislators had each first‑represented state
WITH dec31_females AS (
  SELECT DISTINCT lt.id_bioguide
  FROM legislators_terms AS lt
  JOIN legislators       AS l
    ON lt.id_bioguide = l.id_bioguide
  WHERE l.gender = 'F'
    AND date(strftime('%Y', lt.term_start) || '-12-31')
        BETWEEN date(lt.term_start) AND date(lt.term_end)
),
first_state AS (
  SELECT f.id_bioguide,
         lt.state
  FROM dec31_females AS f
  JOIN legislators_terms AS lt
    ON f.id_bioguide = lt.id_bioguide
  WHERE lt.term_start = (
        SELECT MIN(term_start)
        FROM legislators_terms
        WHERE id_bioguide = lt.id_bioguide
  )
)
SELECT state,
       COUNT(*) AS female_legislator_cnt
FROM first_state
GROUP BY state
ORDER BY female_legislator_cnt DESC
LIMIT 20;
```

```sql
-- 10. FINAL: Which state has the highest number of female legislators
--           whose *any* term included 31‑Dec, counted by their first state
WITH dec31_females AS (
  SELECT DISTINCT lt.id_bioguide
  FROM legislators_terms AS lt
  JOIN legislators       AS l
    ON lt.id_bioguide = l.id_bioguide
  WHERE l.gender = 'F'
    AND date(strftime('%Y', lt.term_start) || '-12-31')
        BETWEEN date(lt.term_start) AND date(lt.term_end)
),
first_state AS (
  SELECT f.id_bioguide,
         lt.state
  FROM dec31_females AS f
  JOIN legislators_terms AS lt
    ON f.id_bioguide = lt.id_bioguide
  WHERE lt.term_start = (
        SELECT MIN(term_start)
        FROM legislators_terms
        WHERE id_bioguide = lt.id_bioguide
  )
)
SELECT state           AS state_abbreviation,
       COUNT(*)        AS female_legislator_cnt
FROM first_state
GROUP BY state
ORDER BY female_legislator_cnt DESC
LIMIT 1;
```
