               ROW_NUMBER() OVER (PARTITION BY "DATETIME"
                                  ORDER BY "PUBLISHDATE" DESC) AS rn
        FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_FORECAST_SAMPLE"
        WHERE "OBJECTID"   = 10000712973
          AND "DATATYPEID" = 9285       -- wind forecast
          AND DATE("DATETIME") = '2022-10-01'
    )
    WHERE rn = 1
),
f_solar AS (
    SELECT "DATETIME","VALUE"
    FROM (
        SELECT "DATETIME","VALUE",
               ROW_NUMBER() OVER (PARTITION BY "DATETIME"
                                  ORDER BY "PUBLISHDATE" DESC) AS rn
        FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_FORECAST_SAMPLE"
        WHERE "OBJECTID"   = 10000712973
          AND "DATATYPEID" = 662        -- solar forecast
          AND DATE("DATETIME") = '2022-10-01'
    )
    WHERE rn = 1
),

/* 4) Actual hourly load --------------------------------------- */
a_load AS (
    SELECT "DATETIME","VALUE"
    FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_LOAD_SAMPLE"
    WHERE "OBJECTID"   = 10000712973
      AND "DATATYPEID" = 9641          -- actual load
      AND DATE("DATETIME") = '2022-10-01'
),

/* 5) Actual wind & solar (5‑min → hourly avg) ----------------- */
a_wind AS (
    SELECT DATE_TRUNC('HOUR',"DATETIME") AS "DATETIME",
           AVG("VALUE")                  AS "VALUE"
    FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_GEN_SAMPLE"
    WHERE "OBJECTID"   = 10000712973
      AND "DATATYPEID" = 16             -- actual wind
      AND DATE("DATETIME") = '2022-10-01'
    GROUP BY DATE_TRUNC('HOUR',"DATETIME")
),
a_solar AS (
    SELECT DATE_TRUNC('HOUR',"DATETIME") AS "DATETIME",
           AVG("VALUE")                  AS "VALUE"
    FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_GEN_SAMPLE"
    WHERE "OBJECTID"   = 10000712973
      AND "DATATYPEID" = 650            -- actual solar
      AND DATE("DATETIME") = '2022-10-01'
    GROUP BY DATE_TRUNC('HOUR',"DATETIME")
)

/* 6) Assemble report ------------------------------------------ */
SELECT
    d."DATETIME"                                            AS timestamp_cpt,
    d."TIMEZONE"                                            AS timezone,
    CASE
        WHEN d."ONPEAK" = 1  THEN 'ONPEAK'
        WHEN d."WDPEAK" = 1  THEN 'WDPEAK'
        WHEN d."WEPEAK" = 1  THEN 'WEPEAK'
        WHEN d."OFFPEAK"= 1  THEN 'OFFPEAK'
        ELSE 'UNCL'
    END                                                     AS peak_classification,
    ROUND(p."DALMP", 4)                                     AS "day_ahead_price_$/MWh",
    ROUND(p."RTLMP", 4)                                     AS "real_time_price_$/MWh",
    ROUND(fl."VALUE", 4)                                    AS load_forecast_MW,
    ROUND(al."VALUE", 4)                                    AS load_actual_MW,
    ROUND(fw."VALUE", 4)                                    AS wind_forecast_MW,
    ROUND(aw."VALUE", 4)                                    AS wind_actual_MW,
    ROUND(fs."VALUE", 4)                                    AS solar_forecast_MW,
    ROUND(asol."VALUE", 4)                                  AS solar_actual_MW,
    ROUND(  al."VALUE"
          - COALESCE(aw."VALUE",0)
          - COALESCE(asol."VALUE",0)
    , 4)                                                    AS net_load_MW
FROM drv d
LEFT JOIN prices  p    ON p."DATETIME" = d."DATETIME"
LEFT JOIN f_load  fl   ON fl."DATETIME" = d."DATETIME"
LEFT JOIN a_load  al   ON al."DATETIME" = d."DATETIME"
LEFT JOIN f_wind  fw   ON fw."DATETIME" = d."DATETIME"
LEFT JOIN a_wind  aw   ON aw."DATETIME" = d."DATETIME"
LEFT JOIN f_solar fs   ON fs."DATETIME" = d."DATETIME"
LEFT JOIN a_solar asol ON asol."DATETIME" = d."DATETIME"
ORDER BY d."DATETIME";
```
