    WHERE "OBJECTID" = 10000697078
      AND DATE("DATETIME") = '2022-10-01'
),

/*  ---  PEAK / OFF‑PEAK FLAGS  ---------------------------------- */
market_times AS (
    SELECT
        "DATETIME",
        "ONPEAK",
        "OFFPEAK",
        "WEPEAK",
        "WDPEAK"
    FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."ISO_MARKET_TIMES_SAMPLE"
    WHERE "ISO" = 'ERCOT'
      AND DATE("DATETIME") = '2022-10-01'
),

/*  ---  FORECASTS (pick latest vintage per hour)  --------------- */
load_forecast AS (
    SELECT "DATETIME","VALUE"
    FROM (
        SELECT
            "DATETIME",
            "VALUE",
            ROW_NUMBER() OVER (PARTITION BY "DATETIME" ORDER BY "PUBLISHDATE" DESC) AS rn
        FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_FORECAST_SAMPLE"
        WHERE "OBJECTID"   = 10000712973
          AND "DATATYPEID" = 19060           -- load forecast
          AND DATE("DATETIME") = '2022-10-01'
    )
    WHERE rn = 1
),
wind_forecast AS (
    SELECT "DATETIME","VALUE"
    FROM (
        SELECT
            "DATETIME",
            "VALUE",
            ROW_NUMBER() OVER (PARTITION BY "DATETIME" ORDER BY "PUBLISHDATE" DESC) AS rn
        FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_FORECAST_SAMPLE"
        WHERE "OBJECTID"   = 10000712973
          AND "DATATYPEID" = 9285            -- wind forecast
          AND DATE("DATETIME") = '2022-10-01'
    )
    WHERE rn = 1
),
solar_forecast AS (
    SELECT "DATETIME","VALUE"
    FROM (
        SELECT
            "DATETIME",
            "VALUE",
            ROW_NUMBER() OVER (PARTITION BY "DATETIME" ORDER BY "PUBLISHDATE" DESC) AS rn
        FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_FORECAST_SAMPLE"
        WHERE "OBJECTID"   = 10000712973
          AND "DATATYPEID" = 662             -- solar forecast
          AND DATE("DATETIME") = '2022-10-01'
    )
    WHERE rn = 1
),

/*  ---  ACTUAL LOAD (already hourly)  --------------------------- */
load_actual AS (
    SELECT
        "DATETIME",
        "VALUE"
    FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_LOAD_SAMPLE"
    WHERE "OBJECTID"   = 10000712973
      AND "DATATYPEID" = 9641                -- actual load
      AND DATE("DATETIME") = '2022-10-01'
),

/*  ---  ACTUAL WIND / SOLAR (5‑min → hourly avg)  --------------- */
wind_actual AS (
    SELECT
        DATE_TRUNC('HOUR', "DATETIME") AS "DATETIME",
        AVG("VALUE")                  AS "VALUE"
    FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_GEN_SAMPLE"
    WHERE "OBJECTID"   = 10000712973
      AND "DATATYPEID" = 16                  -- actual wind
      AND DATE("DATETIME") = '2022-10-01'
    GROUP BY DATE_TRUNC('HOUR', "DATETIME")
),
solar_actual AS (
    SELECT
        DATE_TRUNC('HOUR', "DATETIME") AS "DATETIME",
        AVG("VALUE")                  AS "VALUE"
    FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_GEN_SAMPLE"
    WHERE "OBJECTID"   = 10000712973
      AND "DATATYPEID" = 650                 -- actual solar
      AND DATE("DATETIME") = '2022-10-01'
    GROUP BY DATE_TRUNC('HOUR', "DATETIME")
)

/*  ---  FINAL REPORT  ------------------------------------------- */
SELECT
    p."DATETIME"                                                   AS timestamp_cpt,
    p."TIMEZONE"                                                   AS timezone,
    CASE
        WHEN mt."ONPEAK"  = 1 THEN 'ONPEAK'
        WHEN mt."WDPEAK"  = 1 THEN 'WDPEAK'
        WHEN mt."WEPEAK"  = 1 THEN 'WEPEAK'
        WHEN mt."OFFPEAK" = 1 THEN 'OFFPEAK'
        ELSE 'UNCL'
    END                                                            AS peak_classification,
    p."DALMP"                                                      AS day_ahead_price_$/MWh,
    p."RTLMP"                                                      AS real_time_price_$/MWh,
    lf."VALUE"                                                     AS load_forecast_MW,
    la."VALUE"                                                     AS load_actual_MW,
    wf."VALUE"                                                     AS wind_forecast_MW,
    wa."VALUE"                                                     AS wind_actual_MW,
    sf."VALUE"                                                     AS solar_forecast_MW,
    sa."VALUE"                                                     AS solar_actual_MW,
    (   la."VALUE"
      - COALESCE(wa."VALUE",0)
      - COALESCE(sa."VALUE",0) )                                   AS net_load_MW
FROM prices p
LEFT JOIN market_times   mt ON mt."DATETIME" = p."DATETIME"
LEFT JOIN load_forecast  lf ON lf."DATETIME" = p."DATETIME"
LEFT JOIN load_actual    la ON la."DATETIME" = p."DATETIME"
LEFT JOIN wind_forecast  wf ON wf."DATETIME" = p."DATETIME"
LEFT JOIN wind_actual    wa ON wa."DATETIME" = p."DATETIME"
LEFT JOIN solar_forecast sf ON sf."DATETIME" = p."DATETIME"
LEFT JOIN solar_actual   sa ON sa."DATETIME" = p."DATETIME"
ORDER BY p."DATETIME";
