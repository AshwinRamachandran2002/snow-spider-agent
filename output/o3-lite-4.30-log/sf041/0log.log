```sql
--Description: 10) One‑stop view: Hourly prices, load forecast & actual, wind & solar forecast/actual, peak flags, and computed net‑load metrics for 1‑Oct‑2022
SELECT p."DATETIME",
       p."DALMP",
       p."RTLMP",
       lf."VALUE"   AS "LOAD_FORECAST_MW",
       la."VALUE"   AS "LOAD_ACTUAL_MW",
       wf."VALUE"   AS "WIND_FORECAST_MW",
       wa."VALUE"   AS "WIND_ACTUAL_MW",
       sf."VALUE"   AS "SOLAR_FORECAST_MW",
       sa."VALUE"   AS "SOLAR_ACTUAL_MW",
       /* net‑load calculations */
       (lf."VALUE" - wf."VALUE" - sf."VALUE")  AS "NET_LOAD_FORECAST_MW",
       (la."VALUE" - wa."VALUE" - sa."VALUE")  AS "NET_LOAD_REALTIME_MW",
       mt."ONPEAK",
       mt."OFFPEAK",
       mt."WEPEAK",
       mt."WDPEAK"
FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."DART_PRICES_SAMPLE" p
LEFT JOIN "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."ISO_MARKET_TIMES_SAMPLE" mt
       ON p."DATETIME" = mt."DATETIME" AND mt."ISO" = 'ERCOT'
LEFT JOIN "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_FORECAST_SAMPLE" lf
       ON p."DATETIME" = lf."DATETIME"
      AND lf."OBJECTID" = 10000712973
      AND lf."DATATYPEID" = 19060
LEFT JOIN "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_LOAD_SAMPLE" la
       ON p."DATETIME" = la."DATETIME"
      AND la."OBJECTID" = 10000712973
      AND la."DATATYPEID" = 9641
LEFT JOIN "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_FORECAST_SAMPLE" wf
       ON p."DATETIME" = wf."DATETIME"
      AND wf."OBJECTID" = 10000712973
      AND wf."DATATYPEID" = 9285
LEFT JOIN "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_GEN_SAMPLE" wa
       ON p."DATETIME" = wa."DATETIME"
      AND wa."OBJECTID" = 10000712973
      AND wa."DATATYPEID" = 16
LEFT JOIN "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_FORECAST_SAMPLE" sf
       ON p."DATETIME" = sf."DATETIME"
      AND sf."OBJECTID" = 10000712973
      AND sf."DATATYPEID" = 662
LEFT JOIN "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_GEN_SAMPLE" sa
       ON p."DATETIME" = sa."DATETIME"
      AND sa."OBJECTID" = 10000712973
      AND sa."DATATYPEID" = 650
WHERE p."OBJECTID" = 10000697078
  AND DATE(p."DATETIME") = '2022-10-01'
ORDER BY p."DATETIME"
LIMIT 20;
