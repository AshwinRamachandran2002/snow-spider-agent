```sql
WITH price AS (   -- HB_NORTH prices (node ID 10000697078)
    SELECT
        "DATETIME",
        "TIMEZONE",
        "DALMP" AS day_ahead_price,
        "RTLMP" AS real_time_price
    FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."DART_PRICES_SAMPLE"
    WHERE "OBJECTID" = 10000697078
      AND "DATETIME" >= '2022-10-01 00:00:00'
      AND "DATETIME" <  '2022-10-02 00:00:00'
      AND "RTFINAL" = 'Y'
),
load_forecast AS (   -- North zone load forecast (datatype 19060)
    SELECT
        "DATETIME",
        "VALUE" AS load_forecast_MW
    FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_FORECAST_SAMPLE"
    WHERE "OBJECTID"   = 10000712973
      AND "DATATYPEID" = 19060
      AND "DATETIME"  >= '2022-10-01 00:00:00'
      AND "DATETIME"  <  '2022-10-02 00:00:00'
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "DATETIME" ORDER BY "PUBLISHDATE" DESC) = 1
),
wind_forecast AS (   -- Wind forecast (datatype 9285)
    SELECT
        "DATETIME",
        "VALUE" AS wind_forecast_MW
    FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_FORECAST_SAMPLE"
    WHERE "OBJECTID"   = 10000712973
      AND "DATATYPEID" = 9285
      AND "DATETIME"  >= '2022-10-01 00:00:00'
      AND "DATETIME"  <  '2022-10-02 00:00:00'
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "DATETIME" ORDER BY "PUBLISHDATE" DESC) = 1
),
solar_forecast AS (  -- Solar forecast (datatype 662)
    SELECT
        "DATETIME",
        "VALUE" AS solar_forecast_MW
    FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_FORECAST_SAMPLE"
    WHERE "OBJECTID"   = 10000712973
      AND "DATATYPEID" = 662
      AND "DATETIME"  >= '2022-10-01 00:00:00'
      AND "DATETIME"  <  '2022-10-02 00:00:00'
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "DATETIME" ORDER BY "PUBLISHDATE" DESC) = 1
),
load_actual AS (     -- Actual hourly load (datatype 9641)
    SELECT
        "DATETIME",
        "VALUE" AS load_actual_MW
    FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_LOAD_SAMPLE"
    WHERE "OBJECTID"   = 10000712973
      AND "DATATYPEID" = 9641
      AND "DATETIME"  >= '2022-10-01 00:00:00'
      AND "DATETIME"  <  '2022-10-02 00:00:00'
),
wind_actual AS (     -- Aggregate 5‑min wind actuals (datatype 16) to hourly
    SELECT
        DATE_TRUNC('hour', "DATETIME") AS "DATETIME",
        AVG("VALUE") AS wind_actual_MW
    FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_GEN_SAMPLE"
    WHERE "OBJECTID"   = 10000712973   -- per task spec
      AND "DATATYPEID" = 16
      AND "DATETIME"  >= '2022-10-01 00:00:00'
      AND "DATETIME"  <  '2022-10-02 00:00:00'
    GROUP BY DATE_TRUNC('hour', "DATETIME")
),
solar_actual AS (    -- Aggregate 5‑min solar actuals (datatype 650) to hourly
    SELECT
        DATE_TRUNC('hour', "DATETIME") AS "DATETIME",
        AVG("VALUE") AS solar_actual_MW
    FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_GEN_SAMPLE"
    WHERE "OBJECTID"   = 10000712973   -- per task spec
      AND "DATATYPEID" = 650
      AND "DATETIME"  >= '2022-10-01 00:00:00'
      AND "DATETIME"  <  '2022-10-02 00:00:00'
    GROUP BY DATE_TRUNC('hour', "DATETIME")
),
peak_flags AS (      -- On/off‑peak classification
    SELECT
        "DATETIME",
        CASE
            WHEN "ONPEAK" = 1 THEN 'ONPEAK'
            WHEN "OFFPEAK" = 1 THEN 'OFFPEAK'
            WHEN "WEPEAK" = 1 THEN 'WEPEAK'
            WHEN "WDPEAK" = 1 THEN 'WDPEAK'
            ELSE 'NA'
        END AS peak_classification
    FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."ISO_MARKET_TIMES_SAMPLE"
