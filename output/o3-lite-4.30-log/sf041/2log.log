    h."DATETIME"                                                AS timestamp_cpt,
    COALESCE(pr."TIMEZONE", 'CPT')                              AS timezone,
    COALESCE(pf.peak_classification, 'NA')                      AS peak_classification,
    ROUND(COALESCE(pr."DALMP",0),4)   AS "day_ahead_price_$/MWh",
    ROUND(COALESCE(pr."RTLMP",0),4)   AS "real_time_price_$/MWh",
    ROUND(COALESCE(lf.load_forecast_MW,0),4)  AS load_forecast_MW,
    ROUND(COALESCE(la.load_actual_MW ,0),4)   AS load_actual_MW,
    ROUND(COALESCE(wf.wind_forecast_MW,0),4)  AS wind_forecast_MW,
    ROUND(COALESCE(wa.wind_actual_MW  ,0),4)  AS wind_actual_MW,
    ROUND(COALESCE(sf.solar_forecast_MW,0),4) AS solar_forecast_MW,
    ROUND(COALESCE(sa.solar_actual_MW ,0),4)  AS solar_actual_MW,
    ROUND( COALESCE(la.load_actual_MW,0)
         - COALESCE(wa.wind_actual_MW,0)
         - COALESCE(sa.solar_actual_MW,0)
    ,4)                                         AS net_load_MW
FROM hours               h
LEFT JOIN price          pr ON pr."DATETIME" = h."DATETIME"
LEFT JOIN load_forecast  lf ON lf."DATETIME" = h."DATETIME"
LEFT JOIN load_actual    la ON la."DATETIME" = h."DATETIME"
LEFT JOIN wind_forecast  wf ON wf."DATETIME" = h."DATETIME"
