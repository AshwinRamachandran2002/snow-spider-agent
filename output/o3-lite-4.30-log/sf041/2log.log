-- 10. Description: A mini “joined” view – combine price, load forecast, and on/off‑peak flags
--                  (first 20 rows only) for HB_NORTH & North zone on 10/1/2022.
SELECT p."DATETIME",
       p."DALMP",
       p."RTLMP",
       lf."VALUE"  AS "LOAD_FORECAST_MW",
       rt."VALUE"  AS "RTLOAD_MW",
       imt."ONPEAK",
       imt."OFFPEAK",
       imt."WEPEAK",
       imt."WDPEAK"
FROM "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."DART_PRICES_SAMPLE"   p
LEFT JOIN "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_FORECAST_SAMPLE" lf
       ON lf."DATETIME" = p."DATETIME"
      AND lf."OBJECTID" = 10000712973
      AND lf."DATATYPEID" = 19060          -- load forecast
LEFT JOIN "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."TS_LOAD_SAMPLE" rt
       ON rt."DATETIME" = p."DATETIME"
      AND rt."OBJECTID" = 10000712973
      AND rt."DATATYPEID" = 9641          -- actual load
LEFT JOIN "YES_ENERGY__SAMPLE_DATA"."YES_ENERGY_SAMPLE"."ISO_MARKET_TIMES_SAMPLE" imt
       ON imt."DATETIME" = p."DATETIME"
      AND imt."ISO" ILIKE 'ERCOT%'
WHERE p."OBJECTID" = 10000697078
  AND p."DATETIME" >= '2022-10-01 00:00:00'
  AND p."DATETIME" <  '2022-10-02 00:00:00'
ORDER BY p."DATETIME"
LIMIT 20;
```

