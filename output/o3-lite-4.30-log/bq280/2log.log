Query:
-- 7. Answers per user, requiring reputation > 10
SELECT u.display_name,
       u.reputation,
       COUNT(*)        AS answers_cnt
FROM `bigquery-public-data.stackoverflow.posts_answers` AS a
JOIN `bigquery-public-data.stackoverflow.users`        AS u
  ON a.owner_user_id = u.id
WHERE u.reputation > 10
GROUP BY u.display_name, u.reputation
ORDER BY answers_cnt DESC
LIMIT 20;
