--Description: 9) One‑liner to deliver drug_id, drug_type, withdrawal flag – LIKE‑based matching
WITH matches AS (
  SELECT id
  FROM `bigquery-public-data.open_targets_platform.molecule`
  WHERE LOWER(name) LIKE '%keytruda%' OR LOWER(name) LIKE '%vioxx%' OR LOWER(name) LIKE '%premarin%' OR LOWER(name) LIKE '%humira%'
  UNION ALL
  SELECT m.id
  FROM `bigquery-public-data.open_targets_platform.molecule` AS m,
       UNNEST(m.tradeNames.list) AS t
  WHERE LOWER(t.element) LIKE '%keytruda%' OR LOWER(t.element) LIKE '%vioxx%' OR LOWER(t.element) LIKE '%premarin%' OR LOWER(t.element) LIKE '%humira%'
  UNION ALL
  SELECT m.id
  FROM `bigquery-public-data.open_targets_platform.molecule` AS m,
       UNNEST(m.synonyms.list) AS s
  WHERE LOWER(s.element) LIKE '%keytruda%' OR LOWER(s.element) LIKE '%vioxx%' OR LOWER(s.element) LIKE '%premarin%' OR LOWER(s.element) LIKE '%humira%'
)
SELECT DISTINCT
  m.id            AS drug_id,
  m.drugType      AS drug_type,
  m.hasBeenWithdrawn AS has_been_withdrawn
FROM `bigquery-public-data.open_targets_platform.molecule` AS m
WHERE m.id IN (SELECT DISTINCT id FROM matches)
  AND m.isApproved = TRUE
  AND m.blackBoxWarning = TRUE
  AND m.drugType IS NOT NULL
LIMIT 20
