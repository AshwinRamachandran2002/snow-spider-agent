--             round‑trips, along with its average precipitation and wind speed.  Spatial and
--             date logic fixed; wdsp cast to FLOAT for averaging.
SELECT *
FROM (
    SELECT
        t."usertype",
        AVG(w."temp")              AS "avg_temp",
        AVG(w."prcp")              AS "avg_prcp",
