Query:
--Description: Join 2018 Citi Bike round‑trips inside ZIP 10019 to Central Park weather
--             and display trip date, usertype, and temperature.  The weather join now
--             filters only on WBAN 94728 (Central Park) and year 2018; STN code removed.
SELECT
    DATE_TRUNC('day', TO_TIMESTAMP(t."starttime" / 1000000)) AS "trip_day",
    t."usertype",
    w."temp"
FROM "NEW_YORK_CITIBIKE_1"."NEW_YORK_CITIBIKE"."CITIBIKE_TRIPS"  t
JOIN "NEW_YORK_CITIBIKE_1"."GEO_US_BOUNDARIES"."ZIP_CODES"       z
  ON z."zip_code"  = '10019'
 AND z."state_code" = 'NY'
JOIN "NEW_YORK_CITIBIKE_1"."NOAA_GSOD"."GSOD2018"                w
  ON w."wban" = '94728'              -- Central Park
 AND w."year" = '2018'
 AND TO_DATE(TO_TIMESTAMP(t."starttime" / 1000000))
     = TO_DATE(CONCAT(w."year",'-',LPAD(w."mo",2,'0'),'-',LPAD(w."da",2,'0')))
WHERE ST_WITHIN(ST_MAKEPOINT(t."start_station_longitude", t."start_station_latitude"), TO_GEOGRAPHY(z."zip_code_geom"))
  AND ST_WITHIN(ST_MAKEPOINT(t."end_station_longitude"  , t."end_station_latitude"  ), TO_GEOGRAPHY(z."zip_code_geom"))
LIMIT 20
