```sql
--Description & Thinking process:
-- Task end‑goal: identify which Citi Bike “usertype” (Customer vs Subscriber) experienced the
-- highest AVERAGE daily temperature on 2018 trips that both STARTED and ENDED inside ZIP‑code 10019,
-- then show that usertype’s average temperature, precipitation, and wind speed based on
-- Central Park (NYC) GSOD weather data.
--
-- Logical steps inside one query:
-- 1)  Pull the single polygon row for ZIP 10019 and cast its GEOMETRY to GEOGRAPHY for spatial tests.
-- 2)  Detect Central Park weather‑station codes on‑the‑fly from NOAA_GSOD.STATIONS.
-- 3)  Filter 2018 Citi Bike trips: start & end points must lie within the ZIP polygon
--     (ST_WITHIN with ST_MAKEPOINT).
-- 4)  Convert trip micro‑second epoch “starttime” to DATE and join to the matching
--     DATE built from GSOD2018 (year, month, day) for Central Park.
-- 5)  Aggregate weather variables (temp, prcp, wdsp) by usertype.
-- 6)  Return only the usertype whose average temperature is highest.
WITH
/* --- ZIP 10019 polygon ----------------------------------------------- */
z AS (
    SELECT TO_GEOGRAPHY("zip_code_geom") AS geom
    FROM "NEW_YORK_CITIBIKE_1"."GEO_US_BOUNDARIES"."ZIP_CODES"
    WHERE "zip_code" = '10019'
      AND "state_code" = 'NY'
),
/* --- Central Park station codes --------------------------------------- */
cp AS (
    SELECT "usaf" AS stn, "wban"
    FROM "NEW_YORK_CITIBIKE_1"."NOAA_GSOD"."STATIONS"
    WHERE UPPER("name") ILIKE '%CENTRAL%PARK%'
      AND "state" = 'NY'
    LIMIT 1
)
/* --- Final aggregation & ranking -------------------------------------- */
SELECT
       agg."usertype",
       agg."avg_temp",
       agg."avg_prcp",
       agg."avg_wdsp"
FROM (
    SELECT
        t."usertype",
        AVG(w."temp")           AS "avg_temp",
        AVG(w."prcp")           AS "avg_prcp",
        AVG(w."wdsp"::FLOAT)    AS "avg_wdsp"
    FROM "NEW_YORK_CITIBIKE_1"."NEW_YORK_CITIBIKE"."CITIBIKE_TRIPS" t,
         z
    /* spatial & temporal filters */
    WHERE ST_WITHIN(ST_MAKEPOINT(t."start_station_longitude", t."start_station_latitude"), z.geom)
      AND ST_WITHIN(ST_MAKEPOINT(t."end_station_longitude"  , t."end_station_latitude"  ), z.geom)
      AND t."starttime" BETWEEN 1514764800000000            -- 2018‑01‑01 00:00:00 (µs)
                           AND 1546300799000000            -- 2018‑12‑31 23:59:59 (µs)
    /* join to Central Park daily weather for the same calendar day */
    JOIN cp
    JOIN "NEW_YORK_CITIBIKE_1"."NOAA_GSOD"."GSOD2018" w
      ON w."stn"  = cp.stn
     AND w."wban" = cp.wban
     AND DATE_FROM_PARTS(
            CAST(w."year" AS INT),
            CAST(w."mo"   AS INT),
            CAST(w."da"   AS INT)
         ) = TO_DATE( TO_TIMESTAMP( t."starttime" / 1000000 ) )
    GROUP BY t."usertype"
) agg
ORDER BY agg."avg_temp" DESC
LIMIT 1;
```
