--Description: Retrieve 20 Citi Bike trips from 2018 whose START **and** END coordinates
--             are both located inside Manhattan ZIP‑code 10019.  Thinking steps:
--             1. Extract the 10019 polygon from GEO_US_BOUNDARIES.ZIP_CODES and cast it
--                to GEOGRAPHY (sub‑query z).
--             2. Convert each trip’s longitude/latitude pair into GEOGRAPHY points
--                with ST_MAKEPOINT.
--             3. Keep only trips where BOTH start and end points lie within the polygon
--                via ST_WITHIN, and where “starttime” falls in calendar‑year 2018
--                (micro‑second epoch range).
--             4. Limit to 20 rows for quick inspection.
SELECT
    t."starttime",
    t."stoptime",
    t."usertype"
FROM "NEW_YORK_CITIBIKE_1"."NEW_YORK_CITIBIKE"."CITIBIKE_TRIPS" t,
     LATERAL (
         SELECT TO_GEOGRAPHY("zip_code_geom") AS geom
         FROM "NEW_YORK_CITIBIKE_1"."GEO_US_BOUNDARIES"."ZIP_CODES"
         WHERE "zip_code" = '10019'
           AND "state_code" = 'NY'
         LIMIT 1
     ) z
WHERE ST_WITHIN(ST_MAKEPOINT(t."start_station_longitude", t."start_station_latitude"), z.geom)
  AND ST_WITHIN(ST_MAKEPOINT(t."end_station_longitude"  , t."end_station_latitude"  ), z.geom)
  AND t."starttime" BETWEEN 1514764800000000   -- 2018‑01‑01 00:00:00 µs
                       AND 1546300799000000   -- 2018‑12‑31 23:59:59 µs
LIMIT 20;
