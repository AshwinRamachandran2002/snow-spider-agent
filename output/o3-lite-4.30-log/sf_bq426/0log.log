           AND s."wban" = g."wban"
    WHERE  s."name" ILIKE '%CENTRAL PARK%'
),
joined_data AS (        -------------------------------------------------- ❹ Trip rows with matching weather
    SELECT
        t."usertype",
        w."temp",
        w."prcp",
        w.wdsp_knots
    FROM trips_2018           t
    JOIN central_park_weather w
          ON t.trip_date = w.wx_date
),
agg AS (                 -------------------------------------------------- ❺ Averages by user type
    SELECT
        "usertype",
        AVG("temp")                        AS average_temperature_f,
        AVG("prcp")                        AS average_precipitation_in,
        AVG(wdsp_knots * 1.150779)         AS average_wind_speed_mph   -- convert knots→mph
    FROM joined_data
    GROUP BY "usertype"
)
SELECT                     -------------------------------------------------- ❻ Hottest user‑type and its averages
    "usertype"                    AS user_type,
    average_temperature_f,
    average_precipitation_in,
    average_wind_speed_mph
FROM   agg
ORDER  BY average_temperature_f DESC NULLS LAST
LIMIT  1;
```
