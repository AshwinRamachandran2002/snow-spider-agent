```sql
--Description: For each user type, compute average weather values attached to its 2018 trips that start & end in ZIP 10019, using Central Park station determined by name.
SELECT 
    t."usertype",
    AVG(g."temp")  AS avg_temp_f,
    AVG(g."prcp")  AS avg_prcp_in,
    AVG(g."wdsp")::FLOAT AS avg_wdsp_kts
FROM NEW_YORK_CITIBIKE_1.NEW_YORK_CITIBIKE.CITIBIKE_TRIPS t
CROSS JOIN NEW_YORK_CITIBIKE_1.GEO_US_BOUNDARIES.ZIP_CODES z
JOIN NEW_YORK_CITIBIKE_1.NOAA_GSOD.GSOD2018 g
      ON TO_DATE(TO_TIMESTAMP_NTZ(t."starttime"/1000000)) 
         = TO_DATE(g."year"||'-'||g."mo"||'-'||g."da")
JOIN NEW_YORK_CITIBIKE_1.NOAA_GSOD.STATIONS s
      ON s."usaf" = g."stn"
     AND s."wban" = g."wban"
WHERE z."zip_code" = '10019'
  AND s."name" ILIKE '%central%park%'
  AND ST_WITHIN(
        ST_MAKEPOINT(t."start_station_longitude", t."start_station_latitude"),
        z."zip_code_geom")
  AND ST_WITHIN(
        ST_MAKEPOINT(t."end_station_longitude", t."end_station_latitude"),
        z."zip_code_geom")
  AND YEAR(TO_DATE(TO_TIMESTAMP_NTZ(t."starttime"/1000000))) = 2018
GROUP BY t."usertype"
ORDER BY avg_temp_f DESC
LIMIT 20;
```

```sql
--Description: Final query – return the user type with the highest average trip‑day temperature (plus its precipitation and wind averages) for 2018 trips wholly in ZIP 10019, joining Central Park weather by station name.  
SELECT 
    first_value("usertype")   OVER (ORDER BY avg_temp_f DESC) AS hottest_usertype,
    first_value(avg_temp_f)   OVER (ORDER BY avg_temp_f DESC) AS avg_temp_f,
    first_value(avg_prcp_in)  OVER (ORDER BY avg_temp_f DESC) AS avg_prcp_in,
    first_value(avg_wdsp_kts) OVER (ORDER BY avg_temp_f DESC) AS avg_wdsp_kts
FROM (
    SELECT 
        t."usertype",
        AVG(g."temp")  AS avg_temp_f,
        AVG(g."prcp")  AS avg_prcp_in,
        AVG(g."wdsp")::FLOAT AS avg_wdsp_kts
    FROM NEW_YORK_CITIBIKE_1.NEW_YORK_CITIBIKE.CITIBIKE_TRIPS t
    CROSS JOIN NEW_YORK_CITIBIKE_1.GEO_US_BOUNDARIES.ZIP_CODES z
    JOIN NEW_YORK_CITIBIKE_1.NOAA_GSOD.GSOD2018 g
          ON TO_DATE(TO_TIMESTAMP_NTZ(t."starttime"/1000000)) 
             = TO_DATE(g."year"||'-'||g."mo"||'-'||g."da")
    JOIN NEW_YORK_CITIBIKE_1.NOAA_GSOD.STATIONS s
          ON s."usaf" = g."stn"
         AND s."wban" = g."wban"
    WHERE z."zip_code" = '10019'
      AND s."name" ILIKE '%central%park%'
      AND ST_WITHIN(
            ST_MAKEPOINT(t."start_station_longitude", t."start_station_latitude"),
            z."zip_code_geom")
      AND ST_WITHIN(
            ST_MAKEPOINT(t."end_station_longitude", t."end_station_latitude"),
            z."zip_code_geom")
      AND YEAR(TO_DATE(TO_TIMESTAMP_NTZ(t."starttime"/1000000))) = 2018
    GROUP BY t."usertype"
)
LIMIT 1;
```
