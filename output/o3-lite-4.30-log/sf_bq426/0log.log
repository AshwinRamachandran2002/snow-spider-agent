--Description: Final query – return the user type with the highest average trip‑day temperature (plus average precipitation and wind) for 2018 trips wholly in ZIP 10019, joining Central Park weather by station name.
SELECT 
    FIRST_VALUE("usertype")   OVER (ORDER BY avg_temp_f DESC) AS hottest_usertype,
    FIRST_VALUE(avg_temp_f)   OVER (ORDER BY avg_temp_f DESC) AS avg_temp_f,
    FIRST_VALUE(avg_prcp_in)  OVER (ORDER BY avg_temp_f DESC) AS avg_prcp_in,
    FIRST_VALUE(avg_wdsp_kts) OVER (ORDER BY avg_temp_f DESC) AS avg_wdsp_kts
FROM (
    SELECT 
        t."usertype",
        AVG(g."temp")  AS avg_temp_f,
        AVG(g."prcp")  AS avg_prcp_in,
        AVG(g."wdsp")::FLOAT AS avg_wdsp_kts
    FROM NEW_YORK_CITIBIKE_1.NEW_YORK_CITIBIKE.CITIBIKE_TRIPS t
    CROSS JOIN (
        SELECT ST_GEOGFROMWKB("zip_code_geom") AS geom
        FROM NEW_YORK_CITIBIKE_1.GEO_US_BOUNDARIES.ZIP_CODES
        WHERE "zip_code" = '10019'
    ) z
    JOIN NEW_YORK_CITIBIKE_1.NOAA_GSOD.GSOD2018 g
          ON TO_DATE(TO_TIMESTAMP_NTZ(t."starttime" / 1000000))
             = TO_DATE(g."year" || '-' || g."mo" || '-' || g."da")
    JOIN NEW_YORK_CITIBIKE_1.NOAA_GSOD.STATIONS s
          ON s."usaf" = g."stn"
         AND s."wban" = g."wban"
    WHERE s."name" ILIKE '%central%park%'
      AND ST_WITHIN(
            ST_MAKEPOINT(t."start_station_longitude", t."start_station_latitude"),
            z.geom)
      AND ST_WITHIN(
            ST_MAKEPOINT(t."end_station_longitude", t."end_station_latitude"),
            z.geom)
      AND YEAR(TO_DATE(TO_TIMESTAMP_NTZ(t."starttime" / 1000000))) = 2018
    GROUP BY t."usertype"
)
