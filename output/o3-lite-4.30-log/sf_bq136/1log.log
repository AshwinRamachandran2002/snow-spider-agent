```sql
--Description: 9) Outgoing‑TX count for candidate intermediates
WITH candidates AS (
  SELECT DISTINCT inter
  FROM (
    SELECT "to_addr" AS inter
    FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
    WHERE "sender" = 'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
      AND "success" = TRUE
    UNION ALL
    SELECT "recipient" AS inter
    FROM CRYPTO.CRYPTO_ZILLIQA.TRANSITIONS
    WHERE "addr" ILIKE 'zil1jrp%'
  )
)
SELECT
  t."sender"  AS intermediate,
  COUNT(*)    AS outgoing_tx
FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS t
JOIN candidates c ON c.inter = t."sender"
WHERE t."success" = TRUE
GROUP BY t."sender"
ORDER BY outgoing_tx DESC
LIMIT 20;
```

