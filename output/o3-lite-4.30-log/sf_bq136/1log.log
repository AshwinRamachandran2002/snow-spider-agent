--Description: Build a single list of every address that has **received**
--             tokens/coins from the source address via either mechanism
--             available in Zilliqa:
--               ① Regular payment transactions      (TRANSACTIONS table)
--               ② Contract‑level value transitions  (TRANSITIONS table)
--             Each SELECT renames its result column to the common alias
--             “intermediate”, then the outer query deduplicates with
--             DISTINCT.  Unquoted identifiers keep Snowflake’s default
--             case‑insensitive behaviour, avoiding the earlier
--             “invalid identifier" error that arose from mismatched quotes.
WITH recv AS (
    /* Regular transactions sent by the source */
    SELECT
        to_addr AS intermediate
    FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
    WHERE sender = 'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
      AND success = TRUE

    UNION ALL

    /* Contract transitions where the sender address starts with the prefix */
    SELECT
        recipient AS intermediate
    FROM CRYPTO.CRYPTO_ZILLIQA.TRANSITIONS
    WHERE addr ILIKE 'zil1jrp%'
)
SELECT DISTINCT intermediate
FROM recv
LIMIT 20;
