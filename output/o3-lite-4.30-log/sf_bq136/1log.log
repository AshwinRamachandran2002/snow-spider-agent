```sql
-- 10. Produce nicely formatted 2‑hop paths (regular TX only) obeying ≤50 rule
WITH out_cnt AS (
  SELECT "sender", COUNT(*) AS out_n
  FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
  WHERE "success" = TRUE AND "accepted" = TRUE
  GROUP BY "sender"
),
h1 AS (
  SELECT "id" AS tx1, "to_addr" AS inter, "block_timestamp" AS ts1
  FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
  WHERE "sender" = 'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
    AND "success" = TRUE AND "accepted" = TRUE
),
h2 AS (
  SELECT "id" AS tx2, "sender" AS inter, "block_timestamp" AS ts2
  FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
  WHERE "to_addr" = 'zil19nmxkh020jnequql9kvqkf3pkwm0j0spqtd26e'
    AND "success" = TRUE AND "accepted" = TRUE
)
SELECT
  'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
  || ' --(tx ' || LEFT(h1.tx1,5) || '...)--> '
  || h1.inter
  || ' --(tx ' || LEFT(h2.tx2,5) || '...)--> '
  || 'zil19nmxkh020jnequql9kvqkf3pkwm0j0spqtd26e'  AS "path"
FROM h1
JOIN h2       ON h1.inter = h2.inter      -- same intermediate
JOIN out_cnt  ON out_cnt."sender" = h1.inter AND out_cnt.out_n <= 50
WHERE h1.ts1 < h2.ts2                     -- chronological
LIMIT 20;
```

