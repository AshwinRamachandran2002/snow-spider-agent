      "transaction_id" AS h1_tx,
      "recipient"      AS inter,
      "block_timestamp" AS h1_time
  FROM CRYPTO.CRYPTO_ZILLIQA.TRANSITIONS
  WHERE "addr" ILIKE 'zil1jrp%'        -- relaxed prefix match
),
second_hop AS (
