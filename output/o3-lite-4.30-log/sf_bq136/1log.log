Below are the columns that matter for building 2–hop paths on Zilliqa and why they are useful.  
(column name → potential usage / important conditions)

• CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS  
  – "id": unique on‑chain transaction hash, needed for the 1st / 2nd hop  
  – "sender": address that sends the transaction (source / intermediate)  
  – "to_addr": address that receives the transaction (intermediate / destination)  
  – "block_timestamp": used to impose chronological ordering (1st hop earlier than 2nd)  
  – "success": keep only confirmed transactions ( = TRUE )  
  – "accepted": extra status flag; keep only TRUE just in case  

• CRYPTO.CRYPTO_ZILLIQA.TRANSITIONS  
  – "transaction_id": unique hash for contract‑level value transfer (same role as "id")  
  – "addr": address that triggered / sent the transition (works like "sender")  
  – "recipient": address that received value (works like "to_addr")  
  – "block_timestamp": for chronological ordering  
  – "accepted" / "amount": "accepted" should be TRUE to guarantee the transition is final  

Typical filter that excludes exchange / high‑activity wallets  
  COUNT(*) OVER (PARTITION BY sender‑like‑column) <= 50

Below are ten exploratory Snowflake SQL snippets―from simple inspection to the final multi‑join―all of them enclosed in ```sql``` blocks, each preceded by a short comment.  All column names are double‑quoted and every query is limited to 20 rows so they can be run safely in sequence.

```sql
-- 1. Direct regular transactions sent by the given source address
SELECT
  "id",
  "sender",
  "to_addr",
  "amount",
  "block_timestamp"
FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
WHERE "sender" = 'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
  AND "success" = TRUE
  AND "accepted" = TRUE
LIMIT 20;
```

```sql
-- 2. Contract transitions initiated by the same source address
SELECT
  "transaction_id",
  "addr"             AS "sender",
  "recipient"        AS "to_addr",
  "amount",
  "block_timestamp"
FROM CRYPTO.CRYPTO_ZILLIQA.TRANSITIONS
WHERE "addr" = 'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
  AND "accepted" = TRUE
LIMIT 20;
```

```sql
-- 3. All addresses that ever receive from the source (1st‑hop candidates)
SELECT DISTINCT
  COALESCE("to_addr","recipient") AS "intermediate"
FROM (
  SELECT "to_addr"    FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS WHERE "sender" = 'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz' AND "success" = TRUE AND "accepted" = TRUE
  UNION ALL
  SELECT "recipient"  FROM CRYPTO.CRYPTO_ZILLIQA.TRANSITIONS  WHERE "addr"  = 'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz' AND "accepted" = TRUE
) t
LIMIT 20;
```

```sql
-- 4. Outgoing‑transaction count for every ZIL address (helps to exclude >50)
SELECT
  "sender",
  COUNT(*) AS "out_tx_count"
FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
WHERE "success" = TRUE AND "accepted" = TRUE
GROUP BY "sender"
HAVING COUNT(*) > 40               -- look near the threshold
ORDER BY "out_tx_count" DESC
LIMIT 20;
```

```sql
-- 5. First‑hop transfers that obey the ≤50 outgoing‑tx rule
WITH out_cnt AS (
  SELECT "sender", COUNT(*) AS c
  FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
  WHERE "success" = TRUE AND "accepted" = TRUE
  GROUP BY "sender"
)
SELECT
  t."id"          AS "tx_id",
  t."sender",
  t."to_addr"     AS "intermediate",
  t."block_timestamp"
FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS t
JOIN out_cnt o      ON o."sender" = t."to_addr" AND o.c <= 50
WHERE t."sender" = 'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
  AND t."success" = TRUE
  AND t."accepted" = TRUE
LIMIT 20;
```

```sql
-- 6. Second‑hop regular transactions that reach the destination address
SELECT
  "id"            AS "tx_id",
  "sender"        AS "intermediate",
  "to_addr"       AS "dest",
  "block_timestamp"
FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
WHERE "to_addr" = 'zil19nmxkh020jnequql9kvqkf3pkwm0j0spqtd26e'
  AND "success" = TRUE
  AND "accepted" = TRUE
LIMIT 20;
```

```sql
-- 7. Combine regular 1st hop + regular 2nd hop, chronological order enforced
WITH first_hop AS (
  SELECT "id" AS h1_tx,
         "to_addr" AS inter,
         "block_timestamp" AS h1_time
  FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
  WHERE "sender" = 'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
    AND "success" = TRUE
    AND "accepted" = TRUE
),
second_hop AS (
  SELECT "id" AS h2_tx,
         "sender" AS inter,
         "block_timestamp" AS h2_time
  FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
  WHERE "to_addr" = 'zil19nmxkh020jnequql9kvqkf3pkwm0j0spqtd26e'
    AND "success" = TRUE
    AND "accepted" = TRUE
)
SELECT
  LEFT(f.h1_tx,5) || '...' AS h1,
  f.inter                  AS intermediate,
  LEFT(s.h2_tx,5) || '...' AS h2
FROM first_hop f
JOIN second_hop s ON s.inter = f.inter        -- same intermediate
WHERE f.h1_time < s.h2_time                   -- chronological
LIMIT 20;
```

```sql
-- 8. Same as (7) but first hop can be a TRANSITION and second hop a TRANSACTION
WITH first_hop AS (
  SELECT "transaction_id" AS h1_tx,
         "recipient"      AS inter,
         "block_timestamp" AS h1_time
  FROM CRYPTO.CRYPTO_ZILLIQA.TRANSITIONS
  WHERE "addr" = 'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
    AND "accepted" = TRUE
),
second_hop AS (
  SELECT "id" AS h2_tx,
         "sender" AS inter,
         "block_timestamp" AS h2_time
  FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
  WHERE "to_addr" = 'zil19nmxkh020jnequql9kvqkf3pkwm0j0spqtd26e'
    AND "success" = TRUE
    AND "accepted" = TRUE
)
SELECT
  LEFT(f.h1_tx,5)||'...'  AS h1,
  f.inter                 AS intermediate,
  LEFT(s.h2_tx,5)||'...'  AS h2
FROM first_hop f
JOIN second_hop s ON s.inter = f.inter
WHERE f.h1_time < s.h2_time
LIMIT 20;
```

```sql
-- 9. Check outgoing‑tx count for intermediates found in previous step
WITH candidates AS (
  SELECT DISTINCT f.inter
  FROM (
    SELECT "to_addr"  AS inter
    FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
    WHERE "sender" = 'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
      AND "success" = TRUE
      AND "accepted" = TRUE
    UNION ALL
    SELECT "recipient" FROM CRYPTO.CRYPTO_ZILLIQA.TRANSITIONS
    WHERE "addr" = 'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
      AND "accepted" = TRUE
  ) f
)
SELECT
  t."sender"  AS "intermediate",
  COUNT(*)    AS "outgoing_tx"
FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS t
JOIN candidates c ON c.inter = t."sender"
WHERE t."success" = TRUE AND t."accepted" = TRUE
GROUP BY t."sender"
ORDER BY "outgoing_tx" DESC
LIMIT 20;
