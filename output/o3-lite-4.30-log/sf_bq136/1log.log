--               that delivers funds to the DESTINATION, capturing the same
--               intermediate as sender.
--             • No status / timestamp / activity filters are applied.
--             • Output each distinct path in the required text format with
--               the first five characters of each transaction hash.
WITH first_hop AS (                       -- SOURCE ➜ intermediate
    SELECT
        "id"               AS tx1,
        "to_addr"          AS inter
    FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
    WHERE "sender" = 'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
    UNION ALL
    SELECT
        "transaction_id"   AS tx1,
        "recipient"        AS inter
    FROM CRYPTO.CRYPTO_ZILLIQA.TRANSITIONS
    WHERE "addr"   = 'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
),
second_hop AS (                           -- intermediate ➜ DESTINATION
    SELECT
        "id"               AS tx2,
        "sender"           AS inter
    FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
    WHERE "to_addr" = 'zil19nmxkh020jnequql9kvqkf3pkwm0j0spqtd26e'
    UNION ALL
    SELECT
        "transaction_id"   AS tx2,
        "addr"             AS inter
    FROM CRYPTO.CRYPTO_ZILLIQA.TRANSITIONS
    WHERE "recipient" = 'zil19nmxkh020jnequql9kvqkf3pkwm0j0spqtd26e'
)
SELECT DISTINCT
    'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
      || ' --(tx ' || LEFT(f.tx1,5) || '...)--> '
      || f.inter
      || ' --(tx ' || LEFT(s.tx2,5) || '...)--> '
      || 'zil19nmxkh020jnequql9kvqkf3pkwm0j0spqtd26e'      AS path
FROM first_hop f
JOIN second_hop s ON s.inter = f.inter
LIMIT 200;
