```sql
--Description: Discover every confirmed 2‑hop payment path on the Zilliqa
--             chain from source  →  destination, where
--             • hop‑1: any regular TX or contract transition SENT by the
--               source address,
--             • hop‑2: any regular TX or contract transition RECEIVED by
--               the destination address,
--             • the intermediate address (same in hop‑1 and hop‑2) has
--               ≤ 50 outgoing regular transactions (reduces exchanges),
--             • hop‑1 timestamp < hop‑2 timestamp  (chronological),
--             • both hops are fully confirmed on‑chain.
--             The result string is formatted exactly as
--             '<src> --(tx ABCDE..)--> <inter> --(tx FGHIJ..)--> <dst>',
--             where ABCDE / FGHIJ are the first five characters of each
--             transaction hash.
WITH out_cnt AS (               -- count outgoing regular TXs per address
    SELECT
        "sender"       AS addr,
        COUNT(*)       AS out_n
    FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
    WHERE "success" = TRUE AND "accepted" = TRUE
    GROUP BY "sender"
),
first_hop AS (                  -- all confirmed transfers sent by SOURCE
    SELECT
        "id"              AS tx1,
        "to_addr"         AS inter,
        "block_timestamp" AS ts1
    FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
    WHERE "sender" = 'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
      AND "success" = TRUE
      AND "accepted" = TRUE
    UNION ALL
    SELECT
        "transaction_id"  AS tx1,
        "recipient"       AS inter,
        "block_timestamp" AS ts1
    FROM CRYPTO.CRYPTO_ZILLIQA.TRANSITIONS
    WHERE "addr" = 'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
      AND "accepted" = TRUE
),
second_hop AS (                 -- all confirmed transfers into DESTINATION
    SELECT
        "id"              AS tx2,
        "sender"          AS inter,
        "block_timestamp" AS ts2
    FROM CRYPTO.CRYPTO_ZILLIQA.TRANSACTIONS
    WHERE "to_addr" = 'zil19nmxkh020jnequql9kvqkf3pkwm0j0spqtd26e'
      AND "success" = TRUE
      AND "accepted" = TRUE
    UNION ALL
    SELECT
        "transaction_id"  AS tx2,
        "addr"            AS inter,
        "block_timestamp" AS ts2
    FROM CRYPTO.CRYPTO_ZILLIQA.TRANSITIONS
    WHERE "recipient" = 'zil19nmxkh020jnequql9kvqkf3pkwm0j0spqtd26e'
      AND "accepted" = TRUE
)
SELECT DISTINCT
    'zil1jrpjd8pjuv50cfkfr7eu6yrm3rn5u8rulqhqpz'
      || ' --(tx ' || LEFT(f.tx1,5) || '...)--> '
      || f.inter
      || ' --(tx ' || LEFT(s.tx2,5) || '...)--> '
      || 'zil19nmxkh020jnequql9kvqkf3pkwm0j0spqtd26e'  AS path
FROM first_hop  f
JOIN second_hop s ON s.inter = f.inter
JOIN out_cnt   o ON o.addr  = f.inter AND o.out_n <= 50   -- ≤50 filter
WHERE f.ts1 < s.ts2                                       -- chronological
ORDER BY path
LIMIT 100;
```
