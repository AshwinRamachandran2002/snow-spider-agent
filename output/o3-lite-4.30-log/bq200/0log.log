```sql
--Description:  We need one query that does everything: stack regular‑season and
--              post‑season pitch‑by‑pitch data, keep only pitches with
--              speed > 0 where the pitcher’s ID is actually listed among that
--              side’s fielders (so we know he is playing for that club),
--              determine the club (team_id), then, for every club, return:
--                 • the highest valid pitch speed, and
--                 • the full name of the pitcher who threw it.
--              Implementation steps in this single statement:
--              1) all_pitches  – UNION ALL `games_wide` + `games_post_wide`.
--              2) confirmed    – filter rows: pitchSpeed>0 AND pitcherId in the
--                                appropriate fielder list; use CASE to map each
--                                row to its club (team_id) and build pitcher_name.
--              3) Final GROUP  – per team_id take MAX(pitch_speed) and via
--                                ARRAY_AGG(STRUCT … ORDER BY … LIMIT 1) pull the
--                                pitcher_name associated with that top velocity.
WITH all_pitches AS (            -- 1) combine regular & post‑season
  SELECT * FROM `bigquery-public-data.baseball.games_wide`
  UNION ALL
  SELECT * FROM `bigquery-public-data.baseball.games_post_wide`
),
confirmed AS (                   -- 2) validate pitcher is on the field for the team
  SELECT
    CASE
      WHEN pitcherId IN (homeFielder1, homeFielder2, homeFielder3,
                         homeFielder4, homeFielder5, homeFielder6,
                         homeFielder7, homeFielder8, homeFielder9,
                         homeFielder10, homeFielder11, homeFielder12)
           THEN homeTeamId
      WHEN pitcherId IN (awayFielder1, awayFielder2, awayFielder3,
                         awayFielder4, awayFielder5, awayFielder6,
                         awayFielder7, awayFielder8, awayFielder9,
                         awayFielder10, awayFielder11, awayFielder12)
           THEN awayTeamId
      ELSE NULL
    END                                   AS team_id,
    pitchSpeed                            AS pitch_speed,
    CONCAT(pitcherFirstName, ' ', pitcherLastName) AS pitcher_name
  FROM all_pitches
  WHERE pitchSpeed > 0
    AND (
          pitcherId IN (homeFielder1, homeFielder2, homeFielder3,
                        homeFielder4, homeFielder5, homeFielder6,
                        homeFielder7, homeFielder8, homeFielder9,
                        homeFielder10, homeFielder11, homeFielder12)
       OR pitcherId IN (awayFielder1, awayFielder2, awayFielder3,
                        awayFielder4, awayFielder5, awayFielder6,
                        awayFielder7, awayFielder8, awayFielder9,
                        awayFielder10, awayFielder11, awayFielder12)
        )
    AND team_id IS NOT NULL
)
-- 3) show fastest pitch and pitcher for every club
SELECT
  team_id,
  MAX(pitch_speed)                                       AS max_valid_pitch_speed,
  (ARRAY_AGG(STRUCT(pitch_speed, pitcher_name)
             ORDER BY pitch_speed DESC
             LIMIT 1))[OFFSET(0)].pitcher_name           AS pitcher_full_name
FROM confirmed
GROUP BY team_id
ORDER BY max_valid_pitch_speed DESC
LIMIT 20;  -- keep the same LIMIT requested in the earlier attempts
```
