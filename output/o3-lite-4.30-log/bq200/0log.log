```sql
--Description:  Single statement (with CTEs) that finds, for every MLB club across
--              BOTH regular‑season (`games_wide`) and post‑season (`games_post_wide`)
--              data, the fastest non‑zero pitch actually thrown while the pitcher
--              was on the field for that club.  The logic:
--                 1) UNION ALL the two tables   →  all_pitches.
--                 2) Keep rows where pitchSpeed > 0 AND pitcherId is listed in
--                    the appropriate home/away fielder slots; a CASE maps each
--                    row to its true club (team_id).                 → confirmed.
--                 3) Group by team_id, take MAX(pitch_speed), and via
--                    ARRAY_AGG(STRUCT … ORDER BY … LIMIT 1) extract the full name
--                    of the pitcher who owns that maximum velocity (avoids the
--                    DISTINCT + ORDER BY and correlated‑subquery errors seen
--                    earlier).  The result shows one row per team, sorted by
--                    their top legal pitch speed.
WITH all_pitches AS (
  SELECT * FROM `bigquery-public-data.baseball.games_wide`
  UNION ALL
  SELECT * FROM `bigquery-public-data.baseball.games_post_wide`
),
confirmed AS (
  SELECT
    -- assign the row to the correct club
    CASE
      WHEN pitcherId IN (homeFielder1, homeFielder2, homeFielder3,
                         homeFielder4, homeFielder5, homeFielder6,
                         homeFielder7, homeFielder8, homeFielder9,
                         homeFielder10, homeFielder11, homeFielder12)
        THEN homeTeamId
      WHEN pitcherId IN (awayFielder1, awayFielder2, awayFielder3,
                         awayFielder4, awayFielder5, awayFielder6,
                         awayFielder7, awayFielder8, awayFielder9,
                         awayFielder10, awayFielder11, awayFielder12)
        THEN awayTeamId
      ELSE NULL
    END                                        AS team_id,
    pitchSpeed                                 AS pitch_speed,
    CONCAT(pitcherFirstName, ' ', pitcherLastName) AS full_name
  FROM all_pitches
  WHERE pitchSpeed > 0
    AND (
          pitcherId IN (homeFielder1, homeFielder2, homeFielder3,
                        homeFielder4, homeFielder5, homeFielder6,
                        homeFielder7, homeFielder8, homeFielder9,
                        homeFielder10, homeFielder11, homeFielder12)
       OR pitcherId IN (awayFielder1, awayFielder2, awayFielder3,
                        awayFielder4, awayFielder5, awayFielder6,
                        awayFielder7, awayFielder8, awayFielder9,
                        awayFielder10, awayFielder11, awayFielder12)
        )
    AND team_id IS NOT NULL                       -- discard plays we couldn’t assign
)
SELECT
  team_id,
  MAX(pitch_speed)                                              AS max_valid_pitch_speed,
  (ARRAY_AGG(STRUCT(pitch_speed, full_name)
             ORDER BY pitch_speed DESC
             LIMIT 1))[OFFSET(0)].full_name                     AS pitcher_full_name
FROM confirmed
GROUP BY team_id
ORDER BY max_valid_pitch_speed DESC;
```
