```sql
--Description: One self‑contained query (CTE style) that documents every step.
--             Objective: for every team (regular‑ & post‑season together) find
--             the highest non‑zero pitch speed and report the pitcher (full name)
--             who delivered it, but only when the pitcher’s ID is confirmed to be
--             on that club’s home/away fielder list in that play.

WITH
/* Step‑1: Stack regular‑season and post‑season pitch rows */
all_pitches AS (
  SELECT * FROM `bigquery-public-data.baseball.games_wide`
  UNION ALL
  SELECT * FROM `bigquery-public-data.baseball.games_post_wide`
),

/* Step‑2: Keep rows where pitchSpeed > 0 **and** the pitcher really belongs to
           the side’s fielder list; resolve the club he pitches for.             */
confirmed_team_pitch AS (
  SELECT
    -- decide which club this row belongs to
    CASE
      WHEN pitcherId IN (homeFielder1, homeFielder2, homeFielder3, homeFielder4,
                         homeFielder5, homeFielder6, homeFielder7, homeFielder8,
                         homeFielder9, homeFielder10, homeFielder11, homeFielder12)
           THEN homeTeamId
      WHEN pitcherId IN (awayFielder1, awayFielder2, awayFielder3, awayFielder4,
                         awayFielder5, awayFielder6, awayFielder7, awayFielder8,
                         awayFielder9, awayFielder10, awayFielder11, awayFielder12)
           THEN awayTeamId
      ELSE NULL
    END                         AS team_id,
    pitchSpeed                  AS pitch_speed,
    pitcherFirstName,
    pitcherLastName
  FROM all_pitches
  WHERE pitchSpeed > 0
    AND (
          pitcherId IN (homeFielder1, homeFielder2, homeFielder3, homeFielder4,
                        homeFielder5, homeFielder6, homeFielder7, homeFielder8,
                        homeFielder9, homeFielder10, homeFielder11, homeFielder12)
       OR pitcherId IN (awayFielder1, awayFielder2, awayFielder3, awayFielder4,
                        awayFielder5, awayFielder6, awayFielder7, awayFielder8,
                        awayFielder9, awayFielder10, awayFielder11, awayFielder12)
        )
    AND (
          -- remove rows where CASE did not find a club (defensive programming)
          (pitcherId IS NOT NULL)
        )
),

/* Step‑3: Aggregate to get the fastest pitch per team
           and the pitcher name that owns that velocity */
team_fastest AS (
  SELECT
    team_id,
    MAX(pitch_speed) AS max_valid_pitch_speed
  FROM confirmed_team_pitch
  WHERE team_id IS NOT NULL
  GROUP BY team_id
)

/* Step‑4: Attach the matching pitcher’s full name by joining back on speed */
SELECT
  t.team_id,
  t.max_valid_pitch_speed,
  -- pick one name whose pitch_speed equals the team’s max value
  (SELECT CONCAT(c.pitcherFirstName, ' ', c.pitcherLastName)
     FROM confirmed_team_pitch AS c
     WHERE c.team_id = t.team_id
       AND c.pitch_speed = t.max_valid_pitch_speed
     LIMIT 1) AS pitcher_full_name
FROM team_fastest AS t
ORDER BY t.max_valid_pitch_speed DESC;
```
