-- Description: 10) FINAL ANSWER – highest (non‑zero) pitch speed achieved for each team,
-- together with the pitcher’s full name
WITH unioned AS (
  SELECT
    gameId,
    pitchSpeed,
    pitcherId,
    CONCAT(pitcherFirstName, ' ', pitcherLastName) AS pitcher_name,
    -- Determine which team (home or away) the pitcher belonged to in this game
    CASE
      WHEN pitcherId IN UNNEST([
            homeFielder1, homeFielder2, homeFielder3, homeFielder4, homeFielder5, homeFielder6,
            homeFielder7, homeFielder8, homeFielder9, homeFielder10, homeFielder11, homeFielder12,
            homeBatter1 , homeBatter2 , homeBatter3 , homeBatter4 , homeBatter5 ,
            homeBatter6 , homeBatter7 , homeBatter8 , homeBatter9
          ]) THEN homeTeamId
      WHEN pitcherId IN UNNEST([
            awayFielder1, awayFielder2, awayFielder3, awayFielder4, awayFielder5, awayFielder6,
            awayFielder7, awayFielder8, awayFielder9, awayFielder10, awayFielder11, awayFielder12,
            awayBatter1 , awayBatter2 , awayBatter3 , awayBatter4 , awayBatter5 ,
            awayBatter6 , awayBatter7 , awayBatter8 , awayBatter9
          ]) THEN awayTeamId
    END AS teamId
  FROM (
    SELECT * FROM `bigquery-public-data.baseball.games_wide`
    UNION ALL
    SELECT * FROM `bigquery-public-data.baseball.games_post_wide`
  )
  WHERE pitchSpeed > 0
),
per_pitcher_team AS (
  SELECT
    teamId,
    pitcherId,
    pitcher_name,
    MAX(pitchSpeed) AS max_pitch_speed
  FROM unioned
  WHERE teamId IS NOT NULL      -- keep only rows where the ownership check succeeded
  GROUP BY teamId, pitcherId, pitcher_name
),
team_max AS (
  SELECT
    teamId,
    FIRST_VALUE(pitcherId)     OVER w AS pitcherId,
    FIRST_VALUE(pitcher_name)  OVER w AS pitcher_name,
    MAX(max_pitch_speed)       OVER w AS max_pitch_speed
  FROM per_pitcher_team
  WINDOW w AS (PARTITION BY teamId ORDER BY max_pitch_speed DESC)
)
SELECT DISTINCT teamId,
       pitcherId,
       pitcher_name,
       max_pitch_speed
FROM team_max
ORDER BY max_pitch_speed DESC    -- fastest arms first, optional
LIMIT 20;
