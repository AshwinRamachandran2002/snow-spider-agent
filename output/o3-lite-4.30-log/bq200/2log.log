  WHERE pitchSpeed BETWEEN 1 AND 125          -- keep only plausible, non‑zero speeds
),
team_pitcher_speed AS (
  /* highest speed each pitcher ever threw for each club                 */
  SELECT
    team_id,
    team_name,
    pitcher_name,
    MAX(pitch_speed) AS max_speed
  FROM pitcher_with_team
  WHERE team_id IS NOT NULL
  GROUP BY team_id, team_name, pitcher_name
),
ranked AS (
  /* pick the single fastest pitcher per club (break ties deterministically) */
  SELECT
    team_name,
    pitcher_name,
    max_speed,
    ROW_NUMBER() OVER (PARTITION BY team_name
                       ORDER BY max_speed DESC, pitcher_name) AS rn
  FROM team_pitcher_speed
)
SELECT
  team_name  AS team,
  pitcher_name,
  CAST(max_speed AS NUMERIC) AS max_pitch_speed_mph
FROM ranked
WHERE rn = 1
ORDER BY team;
