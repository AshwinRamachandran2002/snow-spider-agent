```sql
--Description: 9) For a sample of 50 citing patents compute Σ n_k² and (Σ n_k)²,  
--             ensuring cited patents have IPC data to avoid empty results.
WITH limited_rel AS (
    SELECT 
      p."publication_number"               AS "citing_pub",
      f.value:"publication_number"::STRING AS "cited_pub"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") f
    WHERE p."country_code" = 'US'
      AND p."kind_code" ILIKE '%B2'
      AND p."grant_date" BETWEEN 20150101 AND 20181231
    LIMIT 50
), ipc_counts AS (
    SELECT 
      lr."citing_pub",
      SUBSTR(ipc_u.value:"code"::STRING, 1, 4) AS "ipc4",
      COUNT(*) AS "ipc4_cnt"
    FROM limited_rel lr
    JOIN PATENTS.PATENTS.PUBLICATIONS cited
      ON cited."publication_number" = lr."cited_pub"
     AND cited."ipc" IS NOT NULL,
         LATERAL FLATTEN(input => cited."ipc") ipc_u
    GROUP BY lr."citing_pub", SUBSTR(ipc_u.value:"code"::STRING, 1, 4)
)
SELECT
  "citing_pub",
  SUM(POWER("ipc4_cnt", 2)) AS "sum_sq",
  POWER(SUM("ipc4_cnt"), 2) AS "total_sq"
FROM ipc_counts
GROUP BY "citing_pub"
LIMIT 20;
```

```sql
--Description: 10) Compute ORIGINALITY for all US‑B2 patents granted 2015‑2018,  
--              requiring cited patents to have IPC data; return top 20 scores.
WITH rel AS (
    SELECT 
      p."publication_number"               AS "citing_pub",
      f.value:"publication_number"::STRING AS "cited_pub"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") f
    WHERE p."country_code" = 'US'
      AND p."kind_code" ILIKE '%B2'
      AND p."grant_date" BETWEEN 20150101 AND 20181231
), ipc_counts AS (
    SELECT 
      rel."citing_pub",
      SUBSTR(ipc_u.value:"code"::STRING, 1, 4) AS "ipc4",
      COUNT(*) AS cnt
    FROM rel
    JOIN PATENTS.PATENTS.PUBLICATIONS cited
      ON cited."publication_number" = rel."cited_pub"
     AND cited."ipc" IS NOT NULL,
         LATERAL FLATTEN(input => cited."ipc") ipc_u
    GROUP BY rel."citing_pub", SUBSTR(ipc_u.value:"code"::STRING, 1, 4)
), originality AS (
    SELECT
      "citing_pub",
      1 - (SUM(POWER(cnt,2)) / POWER(SUM(cnt),2)) AS originality_score
    FROM ipc_counts
    GROUP BY "citing_pub"
)
SELECT 
  "citing_pub"       AS "publication_number",
  originality_score
FROM originality
ORDER BY originality_score DESC
LIMIT 20;
```
