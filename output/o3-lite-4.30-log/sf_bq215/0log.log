--Description:  Compute Σ nₖ² (sum_sq) and (Σ nₖ)² (total_sq) for a guaranteed‑non‑empty
--              sample of 20 U.S. patents (kind “B2”, grant years 2015‑2018).  
--              Steps
--              1) citing20  – choose 20 distinct US‑B2 patents granted 2015‑2018.  
--              2) rel       – explode their backward citations into citing‑cited pairs.  
--              3) ipc_cnt   – restrict to cited publications that have IPC data, flatten
--                             their “ipc” arrays, convert each IPC code to its 4‑digit
--                             form, and count occurrences per citing patent.  
--              4) final     – aggregate counts to derive Σ nₖ² and (Σ nₖ)² per citing
--                             patent; show 20 rows so results appear on screen.
WITH citing20 AS (    -- step‑1: pick 20 patents that satisfy filters
    SELECT DISTINCT p."publication_number" AS "citing_pub"
    FROM PATENTS.PATENTS.PUBLICATIONS p
    WHERE p."country_code" = 'US'
      AND p."kind_code"    ILIKE '%B2'
      AND p."grant_date"   BETWEEN 20150101 AND 20181231
    LIMIT 20
), rel AS (           -- step‑2: create citing‑cited pairs
    SELECT
        c20."citing_pub",
        f.value:"publication_number"::STRING AS "cited_pub"
    FROM citing20 c20
    JOIN PATENTS.PATENTS.PUBLICATIONS p
      ON p."publication_number" = c20."citing_pub",
         LATERAL FLATTEN(input => p."citation") f
), ipc_cnt AS (       -- step‑3: count 4‑digit IPC occurrences
    SELECT
        rel."citing_pub",
        SUBSTR(ipc_u.value:"code"::STRING, 1, 4) AS "ipc4",
        COUNT(*)                                 AS cnt
    FROM rel
    JOIN PATENTS.PATENTS.PUBLICATIONS cited
      ON cited."publication_number" = rel."cited_pub"
     AND cited."ipc" IS NOT NULL,                 -- keep cited pubs with IPC data
         LATERAL FLATTEN(input => cited."ipc") ipc_u
    GROUP BY rel."citing_pub", SUBSTR(ipc_u.value:"code"::STRING, 1, 4)
)
SELECT
    "citing_pub",
    SUM(POWER(cnt, 2)) AS "sum_sq",     -- Σ nₖ²
    POWER(SUM(cnt), 2) AS "total_sq"    -- (Σ nₖ)²
FROM ipc_cnt
GROUP BY "citing_pub"
LIMIT 20;
