--Description: Calculate Σ nₖ² (numerator) and (Σ nₖ)² (denominator) for a
--             SMALL, guaranteed‑non‑empty set of U.S. patents (kind “B2”, grant 2015‑2018).
--             Steps
--             1. valid_citing  – pick the first 10 US‑B2 patents that have ≥1 backward
--                citation whose publication record contains IPC data (checked via EXISTS).
--             2. ipc_counts    – for each selected citing patent, join to those cited
--                patents (with IPC), flatten their IPC array, convert to 4‑digit codes,
--                and count how many times each IPC4 appears.
--             3. final SELECT  – aggregate the counts to derive Σ nₖ² and (Σ nₖ)².
--             Limiting to 10 citing patents ensures results display while keeping the
--             query light.  The EXISTS filter prevents the earlier “no data found” issue.
WITH valid_citing AS (
    SELECT DISTINCT p."publication_number" AS "citing_pub"
    FROM PATENTS.PATENTS.PUBLICATIONS p
    WHERE p."country_code" = 'US'
      AND p."kind_code"    ILIKE '%B2'
      AND p."grant_date"   BETWEEN 20150101 AND 20181231
      AND EXISTS (
            SELECT 1
            FROM LATERAL FLATTEN(input => p."citation") f,
                 PATENTS.PATENTS.PUBLICATIONS cited
            WHERE cited."publication_number" = f.value:"publication_number"::STRING
              AND cited."ipc" IS NOT NULL
      )
    LIMIT 10
), ipc_counts AS (
    SELECT
        vc."citing_pub",
        SUBSTR(ipc_u.value:"code"::STRING, 1, 4) AS "ipc4",
        COUNT(*)                                 AS cnt
    FROM valid_citing vc
    JOIN PATENTS.PATENTS.PUBLICATIONS p
      ON p."publication_number" = vc."citing_pub",
         LATERAL FLATTEN(input => p."citation") f
    JOIN PATENTS.PATENTS.PUBLICATIONS cited
      ON cited."publication_number" = f.value:"publication_number"::STRING
     AND cited."ipc" IS NOT NULL,
         LATERAL FLATTEN(input => cited."ipc") ipc_u
    GROUP BY vc."citing_pub", SUBSTR(ipc_u.value:"code"::STRING, 1, 4)
)
SELECT
    "citing_pub",
    SUM(POWER(cnt, 2))  AS "sum_sq",
    POWER(SUM(cnt), 2)  AS "total_sq"
FROM ipc_counts
GROUP BY "citing_pub"
LIMIT 20;
