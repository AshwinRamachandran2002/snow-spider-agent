Query:
--Description: Compute ORIGINALITY for U.S. patents with kind code “B2” granted between
--             2015‑01‑01 and 2018‑12‑31.  
--             1) citing_rel  – build citing‑cited pairs, but keep only those cited publications
--                that actually have IPC data (pre‑join filter).  
--             2) ipc_counts  – flatten the cited patents' IPC arrays, convert each code to its
--                first 4 characters (IPC4), and count how many times each IPC4 appears per
--                citing patent.  
--             3) originality – aggregate counts to obtain ORIGINALITY =
--                1 − (Σ n_k² / (Σ n_k)²).  Return the 20 patents with the highest score.
WITH citing_rel AS (          -- step 1: citing‑cited pairs where cited has IPC
    SELECT
        p."publication_number"               AS "citing_pub",
        f.value:"publication_number"::STRING AS "cited_pub"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") f
    JOIN PATENTS.PATENTS.PUBLICATIONS cited
      ON cited."publication_number" = f.value:"publication_number"::STRING
     AND cited."ipc" IS NOT NULL               -- keep only cited pubs with IPC data
    WHERE p."country_code" = 'US'
      AND p."kind_code"    ILIKE '%B2'
      AND p."grant_date"   BETWEEN 20150101 AND 20181231
), ipc_counts AS (            -- step 2: count IPC4 occurrences
    SELECT
        cr."citing_pub",
        SUBSTR(ipc_u.value:"code"::STRING, 1, 4) AS "ipc4",
        COUNT(*)                                 AS cnt
    FROM citing_rel cr
    JOIN PATENTS.PATENTS.PUBLICATIONS cited
      ON cited."publication_number" = cr."cited_pub",
         LATERAL FLATTEN(input => cited."ipc") ipc_u
    GROUP BY cr."citing_pub", SUBSTR(ipc_u.value:"code"::STRING, 1, 4)
), originality AS (           -- step 3: compute originality score
    SELECT
        "citing_pub",
        1 - (SUM(POWER(cnt, 2)) / POWER(SUM(cnt), 2)) AS originality_score
    FROM ipc_counts
    GROUP BY "citing_pub"
)
SELECT
    "citing_pub" AS "publication_number",
    originality_score
FROM originality
ORDER BY originality_score DESC
LIMIT 20
