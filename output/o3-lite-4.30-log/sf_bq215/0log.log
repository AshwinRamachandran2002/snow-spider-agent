  f.value:"category"::STRING            AS "cite_cat",
  f.value:"patent"::STRING              AS "cite_patent"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."publication_number" IN (SELECT "publication_number" FROM one_patent)
LIMIT 20;
