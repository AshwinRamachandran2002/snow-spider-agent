--Description: 7) Show IPC4 codes for two cited patents selected dynamically (no placeholders)  
--             to illustrate deduplication/count logic later on.
WITH cited_set AS (
    SELECT DISTINCT f.value:"publication_number"::STRING AS cited_pub
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") f
    WHERE p."country_code" = 'US'
      AND p."kind_code" ILIKE '%B2'
      AND p."grant_date" BETWEEN 20150101 AND 20181231
    LIMIT 2
)
