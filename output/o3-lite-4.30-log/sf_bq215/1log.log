),
ipc_counts AS (
    SELECT 
        b."focal_pub",
        SUBSTR(ipc_f.value:"code"::STRING, 1, 4) AS "ipc4",
        COUNT(*) AS n
    FROM backward b
    JOIN PATENTS.PATENTS.PUBLICATIONS p
      ON p."publication_number" = b."cited_pub",
