--Description: 8) Compute originality for a focal patent that has IPC data in its backward citations
--             (switch from US‑9362717‑B2 to US‑9247876‑B2, which we verified).
WITH backward AS (
    SELECT f.value:"publication_number"::STRING AS "cited_pub"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."citation") f
    WHERE t."publication_number" = 'US-9247876-B2'
      AND f.value:"publication_number" IS NOT NULL
),
ipc_counts AS (
    SELECT 
        SUBSTR(ipc_f.value:"code"::STRING, 1, 4) AS "ipc4",
        COUNT(*) AS n
    FROM backward b
    JOIN PATENTS.PATENTS.PUBLICATIONS p
      ON p."publication_number" = b."cited_pub",
         LATERAL FLATTEN(input => p."ipc") ipc_f
    GROUP BY "ipc4"
),
tot AS (
    SELECT SUM(n) AS Ntot FROM ipc_counts
)
SELECT
    1 - SUM(n * n) / ( (SELECT Ntot FROM tot) * (SELECT Ntot FROM tot) ) AS "originality"
FROM ipc_counts
LIMIT 20
