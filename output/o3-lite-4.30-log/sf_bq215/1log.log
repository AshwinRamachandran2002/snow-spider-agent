Relevant columns and their potential usage  

• PUBLICATIONS."publication_number": identifier of each patent publication → will identify the focal US‑B2 patents and their backward citations  
• PUBLICATIONS."kind_code": filter to “B2” grants  
• PUBLICATIONS."country_code": filter to “US” patents  
• PUBLICATIONS."grant_date": limit to grants between 20150101 ‑ 20181231  
• PUBLICATIONS."citation": VARIANT array that contains every backward citation object → flatten to obtain the publication numbers that the focal patent cites  
• PUBLICATIONS."ipc": VARIANT array that lists every IPC code attributed to a publication → flatten to obtain 4‑digit IPC codes of every cited patent  
• PUBLICATIONS."family_id": may help to de‑duplicate cited publications belonging to the same simple family (optional)  

Typical conditions that may be used  

• WHERE "country_code" = 'US'  
• AND   "kind_code"   = 'B2'  
• AND   "grant_date" BETWEEN 20150101 AND 20181231  
• After flattening "citation": WHERE f.value:"publication_number" IS NOT NULL   (keep only patent‑type citations)  
• After flattening "ipc": use SUBSTR(f2.value:"code",1,4) to obtain the 4‑digit IPC code  

Ten step‑by‑step Snowflake SQL queries (every query ends with LIMIT 20)  

```sql
--Description: 1) Quickly list 20 US‑B2 publications granted 2015‑2018
SELECT 
    "publication_number",
    "grant_date",
    "kind_code"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'US'
  AND "kind_code"   = 'B2'
  AND "grant_date" BETWEEN 20150101 AND 20181231
LIMIT 20;
```

```sql
--Description: 2) Inspect the raw citation array of one example patent
SELECT 
    t."publication_number",
    t."citation"
FROM PATENTS.PATENTS.PUBLICATIONS t
WHERE t."publication_number" = 'US-9000000-B2'   -- replace after inspection
LIMIT 20;
```

```sql
--Description: 3) Flatten the citation array to see every cited publication number
SELECT 
    t."publication_number"              AS "citing_pub",
    f.value:"publication_number"::STRING AS "cited_pub"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."country_code" = 'US'
  AND t."kind_code"   = 'B2'
  AND t."grant_date" BETWEEN 20150101 AND 20181231
  AND f.value:"publication_number" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 4) Check which keys are available inside each citation object
SELECT DISTINCT
    OBJECT_KEYS(f.value) AS "citation_keys"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."country_code" = 'US'
  AND t."kind_code"   = 'B2'
  AND t."grant_date" BETWEEN 20150101 AND 20181231
LIMIT 20;
```

```sql
--Description: 5) Inspect IPC array structure for one cited patent
SELECT 
    p."publication_number",
    p."ipc"
FROM PATENTS.PATENTS.PUBLICATIONS p
WHERE p."publication_number" = 'US-8000000-B2'   -- replace after inspection
LIMIT 20;
```

```sql
--Description: 6) Flatten IPC for many patents and show first five 4‑digit codes
SELECT 
    p."publication_number",
    SUBSTR(f2.value:"code"::STRING,1,4) AS "ipc4"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."ipc") f2
WHERE p."country_code" = 'US'
  AND p."kind_code"   = 'B2'
  AND p."grant_date" BETWEEN 20150101 AND 20181231
LIMIT 20;
```

```sql
--Description: 7) Count how many times each cited 4‑digit IPC appears for a single focal patent
WITH backward AS (
  SELECT f.value:"publication_number"::STRING AS "cited_pub"
  FROM PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."citation") f
  WHERE t."publication_number" = 'US-9000000-B2'  -- replace
    AND f.value:"publication_number" IS NOT NULL
)
SELECT 
    SUBSTR(ipc_f.value:"code"::STRING,1,4) AS "ipc4",
    COUNT(*) AS "occurrences"
FROM backward b
JOIN PATENTS.PATENTS.PUBLICATIONS p
  ON p."publication_number" = b."cited_pub"
,    LATERAL FLATTEN(input => p."ipc") ipc_f
GROUP BY "ipc4"
ORDER BY "occurrences" DESC
LIMIT 20;
```

```sql
--Description: 8) Compute originality for one focal patent (formula from prompt)
WITH backward AS (
  SELECT f.value:"publication_number"::STRING AS "cited_pub"
  FROM PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."citation") f
  WHERE t."publication_number" = 'US-9000000-B2'  -- replace
    AND f.value:"publication_number" IS NOT NULL
),
ipc_counts AS (
  SELECT 
      SUBSTR(ipc_f.value:"code"::STRING,1,4) AS "ipc4",
      COUNT(*) AS n
  FROM backward b
  JOIN PATENTS.PATENTS.PUBLICATIONS p
    ON p."publication_number" = b."cited_pub"
  ,   LATERAL FLATTEN(input => p."ipc") ipc_f
  GROUP BY "ipc4"
),
tot AS (
  SELECT SUM(n) AS Ntot FROM ipc_counts
)
SELECT
    1 - SUM(n*n) / ( (SELECT Ntot FROM tot) * (SELECT Ntot FROM tot) ) AS "originality"
FROM ipc_counts
LIMIT 20;
```

```sql
--Description: 9) Compute originality for every US‑B2 patent 2015‑2018 (heavy query, 20 results only)
WITH focal AS (
  SELECT "publication_number"
  FROM PATENTS.PATENTS.PUBLICATIONS
  WHERE "country_code" = 'US'
    AND "kind_code"   = 'B2'
    AND "grant_date" BETWEEN 20150101 AND 20181231
),
backward AS (
  SELECT 
      f.value:"publication_number"::STRING AS "cited_pub",
      t."publication_number"              AS "focal_pub"
  FROM PATENTS.PATENTS.PUBLICATIONS t
  JOIN focal ON focal."publication_number" = t."publication_number"
  ,   LATERAL FLATTEN(input => t."citation") f
  WHERE f.value:"publication_number" IS NOT NULL
),
ipc_counts AS (
  SELECT 
      b."focal_pub",
      SUBSTR(ipc_f.value:"code"::STRING,1,4) AS "ipc4",
      COUNT(*) AS n
  FROM backward b
  JOIN PATENTS.PATENTS.PUBLICATIONS p
    ON p."publication_number" = b."cited_pub"
  ,   LATERAL FLATTEN(input => p."ipc") ipc_f
  GROUP BY b."focal_pub", "ipc4"
),
totals AS (
  SELECT "focal_pub", SUM(n) AS Ntot
  FROM ipc_counts
  GROUP BY "focal_pub"
),
orig AS (
  SELECT 
      c."focal_pub",
      1 - SUM(c.n * c.n) / (t.Ntot * t.Ntot) AS originality
  FROM ipc_counts c
  JOIN totals t
    ON t."focal_pub" = c."focal_pub"
  GROUP BY c."focal_pub", t.Ntot
)
SELECT *
FROM orig
ORDER BY originality DESC
LIMIT 20;
```

