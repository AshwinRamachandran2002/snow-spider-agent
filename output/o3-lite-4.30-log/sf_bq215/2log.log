Begin Exploring Related Columns
Relevant tables & columns  

PATENTS.PATENTS.PUBLICATIONS  
• "publication_number": unique id of every patent – final output and all joins  
• "country_code": filter to US patents  
• "kind_code": filter to B2 grants  
• "grant_date": filter to the 2015‑2018 window (incl.)  
• "citation": VARIANT array that contains every backward citation made by the focal patent – used to obtain cited publication numbers  
• "ipc": VARIANT array that holds IPC symbols for every patent – needed to pull the 4‑digit IPC codes of the cited patents for the originality formula  

Conditions that will be used  
• "country_code" = 'US'  
• "kind_code"   = 'B2'  
• "grant_date"  BETWEEN 20150101 AND 20181231  


Below are ten Snowflake SQL queries (simple → complex → full answer).  
All column names are enclosed in double quotes and every query is capped with LIMIT 20 for inspection.  

```sql
-- 1. Description: show a few US‑B2 patents granted 2015‑2018
SELECT 
    "publication_number",
    "grant_date",
    "kind_code"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'US'
  AND "kind_code"   = 'B2'
  AND "grant_date" BETWEEN 20150101 AND 20181231
LIMIT 20;
```

```sql
-- 2. Description: look at the raw structure of the "citation" array for one sample patent
SELECT 
    t."publication_number",
    c.value AS "raw_citation_variant"
FROM PATENTS.PATENTS.PUBLICATIONS  t,
     LATERAL FLATTEN(input => t."citation") c
WHERE t."publication_number" = 'US-xxxxxxx-B2'   -- replace with a value from query 1
LIMIT 20;
```

```sql
-- 3. Description: extract cited publication numbers from the citation objects
SELECT 
    t."publication_number"              AS "focal_pub",
    c.value:"publication_number"::STRING AS "cited_pub"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") c
WHERE t."country_code" = 'US'
  AND t."kind_code"   = 'B2'
  AND t."grant_date" BETWEEN 20150101 AND 20181231
LIMIT 20;
```

```sql
-- 4. Description: count how many backward citations each focal patent makes
SELECT 
    t."publication_number",
    COUNT(*) AS "n_backward_cites"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") c
WHERE t."country_code" = 'US'
  AND t."kind_code"   = 'B2'
  AND t."grant_date" BETWEEN 20150101 AND 20181231
GROUP BY t."publication_number"
ORDER BY "n_backward_cites" DESC
LIMIT 20;
```

```sql
-- 5. Description: join cited publication numbers back to the PUBLICATIONS table to get their IPC arrays
SELECT 
    t."publication_number"              AS "focal_pub",
    cited."publication_number"          AS "cited_pub",
    cited."ipc"                         AS "cited_ipc_variant"
FROM PATENTS.PATENTS.PUBLICATIONS  t,
     LATERAL FLATTEN(input => t."citation") c
     JOIN PATENTS.PATENTS.PUBLICATIONS cited
       ON cited."publication_number" = c.value:"publication_number"::STRING
WHERE t."country_code" = 'US'
  AND t."kind_code"   = 'B2'
  AND t."grant_date" BETWEEN 20150101 AND 20181231
LIMIT 20;
```

```sql
-- 6. Description: explode the cited patents’ IPC list and grab the first 4 characters (“IPC4”)
SELECT 
    t."publication_number"                         AS "focal_pub",
    SUBSTR(ipc_item.value:"code"::STRING,1,4)      AS "ipc4"
FROM PATENTS.PATENTS.PUBLICATIONS  t,
     LATERAL FLATTEN(input => t."citation") c
     JOIN PATENTS.PATENTS.PUBLICATIONS cited
       ON cited."publication_number" = c.value:"publication_number"::STRING
     , LATERAL FLATTEN(input => cited."ipc") ipc_item
WHERE t."country_code" = 'US'
  AND t."kind_code"   = 'B2'
  AND t."grant_date" BETWEEN 20150101 AND 20181231
LIMIT 20;
```

```sql
-- 7. Description: count occurrences of every IPC4 in the backward citations of each focal patent
SELECT 
    "focal_pub",
    "ipc4",
    COUNT(*) AS "ipc4_occurrences"
FROM (
    SELECT 
        t."publication_number"                    AS "focal_pub",
        SUBSTR(ipc_item.value:"code"::STRING,1,4) AS "ipc4"
    FROM PATENTS.PATENTS.PUBLICATIONS  t,
         LATERAL FLATTEN(input => t."citation") c
         JOIN PATENTS.PATENTS.PUBLICATIONS cited
           ON cited."publication_number" = c.value:"publication_number"::STRING
         , LATERAL FLATTEN(input => cited."ipc") ipc_item
    WHERE t."country_code" = 'US'
      AND t."kind_code"   = 'B2'
      AND t."grant_date" BETWEEN 20150101 AND 20181231
) q
GROUP BY "focal_pub", "ipc4"
LIMIT 20;
```

```sql
-- 8. Description: compute the components needed for originality for each focal patent
SELECT 
    "focal_pub",
    SUM(POWER("ipc4_occurrences",2))                       AS "sum_sq",
    POWER(SUM("ipc4_occurrences"),2)                       AS "total_sq"
FROM (
    SELECT 
        "focal_pub",
        "ipc4",
        COUNT(*) AS "ipc4_occurrences"
    FROM (
        SELECT 
            t."publication_number"                    AS "focal_pub",
            SUBSTR(ipc_item.value:"code"::STRING,1,4) AS "ipc4"
        FROM PATENTS.PATENTS.PUBLICATIONS  t,
             LATERAL FLATTEN(input => t."citation") c
             JOIN PATENTS.PATENTS.PUBLICATIONS cited
               ON cited."publication_number" = c.value:"publication_number"::STRING
             , LATERAL FLATTEN(input => cited."ipc") ipc_item
        WHERE t."country_code" = 'US'
          AND t."kind_code"   = 'B2'
          AND t."grant_date" BETWEEN 20150101 AND 20181231
    ) a
    GROUP BY "focal_pub", "ipc4"
) b
GROUP BY "focal_pub"
LIMIT 20;
```

```sql
-- 9. Description: calculate the originality score for every qualifying patent
SELECT 
    "focal_pub"                                           AS "publication_number",
    1 - ( "sum_sq" / NULLIF("total_sq",0) )               AS "originality"
FROM (
    SELECT 
        "focal_pub",
        SUM(POWER("ipc4_occurrences",2))         AS "sum_sq",
        POWER(SUM("ipc4_occurrences"),2)         AS "total_sq"
    FROM (
        SELECT 
            "focal_pub",
            "ipc4",
            COUNT(*) AS "ipc4_occurrences"
        FROM (
            SELECT 
                t."publication_number"                    AS "focal_pub",
                SUBSTR(ipc_item.value:"code"::STRING,1,4) AS "ipc4"
            FROM PATENTS.PATENTS.PUBLICATIONS  t,
                 LATERAL FLATTEN(input => t."citation") c
                 JOIN PATENTS.PATENTS.PUBLICATIONS cited
                   ON cited."publication_number" = c.value:"publication_number"::STRING
                 , LATERAL FLATTEN(input => cited."ipc") ipc_item
            WHERE t."country_code" = 'US'
              AND t."kind_code"   = 'B2'
              AND t."grant_date" BETWEEN 20150101 AND 20181231
        ) core
        GROUP BY "focal_pub", "ipc4"
    ) agg1
    GROUP BY "focal_pub"
) agg2
ORDER BY "originality" DESC
LIMIT 20;
```

```sql
-- 10. Description: final query – return the single US‑B2 patent (2015‑2018) with the highest originality score
SELECT 
    "publication_number",
    "originality"
FROM (
    SELECT 
        "focal_pub"                                       AS "publication_number",
        1 - ( "sum_sq" / NULLIF("total_sq",0) )           AS "originality"
    FROM (
        SELECT 
            "focal_pub",
            SUM(POWER("ipc4_occurrences",2))   AS "sum_sq",
            POWER(SUM("ipc4_occurrences"),2)   AS "total_sq"
        FROM (
            SELECT 
                "focal_pub",
                "ipc4",
                COUNT(*) AS "ipc4_occurrences"
            FROM (
                SELECT 
                    t."publication_number"                    AS "focal_pub",
                    SUBSTR(ipc_item.value:"code"::STRING,1,4) AS "ipc4"
                FROM PATENTS.PATENTS.PUBLICATIONS  t,
                     LATERAL FLATTEN(input => t."citation") c
                     JOIN PATENTS.PATENTS.PUBLICATIONS cited
                       ON cited."publication_number" = c.value:"publication_number"::STRING
                     , LATERAL FLATTEN(input => cited."ipc") ipc_item
                WHERE t."country_code" = 'US'
                  AND t."kind_code"   = 'B2'
                  AND t."grant_date" BETWEEN 20150101 AND 20181231
            ) sub_core
            GROUP BY "focal_pub", "ipc4"
        ) sub_agg
        GROUP BY "focal_pub"
    ) originality_calc
) final
ORDER BY "originality" DESC
LIMIT 1;
```
