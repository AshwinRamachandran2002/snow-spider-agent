                            r'|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand'
                            r'|small\+goods|stationery|wearables')
            OR
            REGEXP_CONTAINS(parts[SAFE_OFFSET(4)],
