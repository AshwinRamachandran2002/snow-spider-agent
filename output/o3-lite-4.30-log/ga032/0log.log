```sql
--8. Description: Produce a pure sequence of PLP/PDP/OTHER ordered by time.
WITH pages AS (
  SELECT event_timestamp,
         CASE
           WHEN REGEXP_CONTAINS(LOWER(SPLIT(loc.value.string_value, '/')[OFFSET(-1)]), r'\+') AND
                REGEXP_CONTAINS(LOWER(loc.value.string_value), r'/accessories|/apparel|/brands|/campus\+collection|/drinkware|/electronics|/google\+redesign|/lifestyle|/nest|/new\+2015\+logo|/notebooks\+journals|/office|/shop\+by\+brand|/small\+goods|/stationery|/wearables')
                THEN 'PDP'
           WHEN (REGEXP_CONTAINS(LOWER(SPLIT(loc.value.string_value, '/')[SAFE_OFFSET(4)]), r'accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables')
                  OR REGEXP_CONTAINS(LOWER(SPLIT(loc.value.string_value, '/')[SAFE_OFFSET(3)]), r'accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables'))
                AND NOT REGEXP_CONTAINS(SPLIT(loc.value.string_value, '/')[OFFSET(-1)], r'\+')
                THEN 'PLP'
           ELSE 'OTHER'
         END AS page_type
  FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`, UNNEST(event_params) AS loc
  WHERE event_date = '20210128'
    AND user_pseudo_id = '1362228.4966015575'
    AND event_name = 'page_view'
    AND loc.key = 'page_location'
)
SELECT *
FROM   pages
ORDER BY event_timestamp
LIMIT 20;
```

```sql
--9. Description: Collapse consecutive duplicates (window lag) and keep order.
WITH ordered AS (
  SELECT event_timestamp,
         page_type,
         LAG(page_type) OVER(ORDER BY event_timestamp) AS prev_type
  FROM (
    -- reuse pages CTE from query 8
    SELECT event_timestamp,
           CASE
             WHEN REGEXP_CONTAINS(LOWER(SPLIT(loc.value.string_value, '/')[OFFSET(-1)]), r'\+') AND
                  REGEXP_CONTAINS(LOWER(loc.value.string_value), r'/accessories|/apparel|/brands|/campus\+collection|/drinkware|/electronics|/google\+redesign|/lifestyle|/nest|/new\+2015\+logo|/notebooks\+journals|/office|/shop\+by\+brand|/small\+goods|/stationery|/wearables')
                  THEN 'PDP'
             WHEN (REGEXP_CONTAINS(LOWER(SPLIT(loc.value.string_value, '/')[SAFE_OFFSET(4)]), r'accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables')
                    OR REGEXP_CONTAINS(LOWER(SPLIT(loc.value.string_value, '/')[SAFE_OFFSET(3)]), r'accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables'))
                  AND NOT REGEXP_CONTAINS(SPLIT(loc.value.string_value, '/')[OFFSET(-1)], r'\+')
                  THEN 'PLP'
             ELSE 'OTHER'
           END AS page_type
    FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`, UNNEST(event_params) AS loc
    WHERE event_date = '20210128'
      AND user_pseudo_id = '1362228.4966015575'
      AND event_name = 'page_view'
      AND loc.key = 'page_location'
  )
)
SELECT page_type, MIN(event_timestamp) AS first_seen_ts
FROM   ordered
WHERE  page_type IS NOT NULL
  AND  page_type != prev_type
GROUP BY page_type, prev_type, 
         -- grouping by running group id to preserve order
         SUM(CASE WHEN page_type != prev_type THEN 1 ELSE 0 END)
ORDER BY first_seen_ts
LIMIT 20;
```

```sql
--10. Description: Produce the final navigation flow string e.g. "PLP >> PDP >> …".
WITH pages AS (
  SELECT event_timestamp,
         CASE
           WHEN REGEXP_CONTAINS(LOWER(SPLIT(loc.value.string_value, '/')[OFFSET(-1)]), r'\+') AND
                REGEXP_CONTAINS(LOWER(loc.value.string_value), r'/accessories|/apparel|/brands|/campus\+collection|/drinkware|/electronics|/google\+redesign|/lifestyle|/nest|/new\+2015\+logo|/notebooks\+journals|/office|/shop\+by\+brand|/small\+goods|/stationery|/wearables')
                THEN 'PDP'
           WHEN (REGEXP_CONTAINS(LOWER(SPLIT(loc.value.string_value, '/')[SAFE_OFFSET(4)]), r'accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables')
                  OR REGEXP_CONTAINS(LOWER(SPLIT(loc.value.string_value, '/')[SAFE_OFFSET(3)]), r'accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables'))
                AND NOT REGEXP_CONTAINS(SPLIT(loc.value.string_value, '/')[OFFSET(-1)], r'\+')
                THEN 'PLP'
           ELSE 'OTHER'
         END AS page_type
  FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`, UNNEST(event_params) AS loc
  WHERE event_date = '20210128'
    AND user_pseudo_id = '1362228.4966015575'
    AND event_name = 'page_view'
    AND loc.key = 'page_location'
),
ordered AS (
  SELECT event_timestamp,
         page_type,
         LAG(page_type) OVER(ORDER BY event_timestamp) AS prev_type
  FROM pages
),
dedup AS (
  SELECT page_type,
         ROW_NUMBER() OVER(ORDER BY event_timestamp) AS seq
  FROM   ordered
  WHERE  page_type != prev_type OR prev_type IS NULL
)
SELECT STRING_AGG(page_type, ' >> ' ORDER BY seq) AS navigation_flow
FROM   dedup;
```

Running query 10 will return one row whose value is exactly the condensed navigation flow for user 1362228.4966015575 on 28‑Jan‑2021, using the required PDP/PLP labels and collapsing consecutive duplicates.
