--Description: #8  Produce a chronological list of page_type (PLP / PDP / OTHER) for the visitor.
WITH pages AS (
  SELECT
    event_timestamp,
    SPLIT(loc.value.string_value, '/') AS parts,
    LOWER(loc.value.string_value)      AS url
  FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`, UNNEST(event_params) AS loc
  WHERE event_date     = '20210128'
    AND user_pseudo_id = '1362228.4966015575'
    AND event_name     = 'page_view'
    AND loc.key        = 'page_location'
),
typed AS (
  SELECT
    event_timestamp,
    CASE
      WHEN REGEXP_CONTAINS(parts[SAFE_OFFSET(ARRAY_LENGTH(parts)-1)], r'\+')
           AND REGEXP_CONTAINS(url,
               r'/accessories|/apparel|/brands|/campus\+collection|/drinkware|/electronics|/google\+redesign'
               r'|/lifestyle|/nest|/new\+2015\+logo|/notebooks\+journals|/office|/shop\+by\+brand'
               r'|/small\+goods|/stationery|/wearables')
      THEN 'PDP'
      WHEN (
            REGEXP_CONTAINS(parts[SAFE_OFFSET(3)],
                            r'accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign'
                            r'|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand'
                            r'|small\+goods|stationery|wearables')
            OR
            REGEXP_CONTAINS(parts[SAFE_OFFSET(4)],
                            r'accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign'
                            r'|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand'
                            r'|small\+goods|stationery|wearables')
           )
           AND NOT REGEXP_CONTAINS(parts[SAFE_OFFSET(ARRAY_LENGTH(parts)-1)], r'\+')
      THEN 'PLP'
      ELSE 'OTHER'
    END AS page_type
  FROM pages
)
SELECT *
FROM   typed
ORDER BY event_timestamp
LIMIT 20
