--Description: #7  Bring together timestamp, page_title, URL and classification (PDP / PLP / OTHER) for the
--               requested user‑day.  Uses SAFE_OFFSET and ARRAY_LENGTH to avoid negative indexes.
WITH base AS (
  SELECT
    t.event_timestamp,
    ttl.value.string_value                       AS page_title,
    loc.value.string_value                       AS page_location,
    SPLIT(loc.value.string_value, '/')           AS parts
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128` AS t
  CROSS JOIN UNNEST(t.event_params) AS ttl
  CROSS JOIN UNNEST(t.event_params) AS loc
  WHERE t.event_date     = '20210128'
    AND t.user_pseudo_id = '1362228.4966015575'
    AND t.event_name     = 'page_view'
    AND ttl.key          = 'page_title'
    AND loc.key          = 'page_location'
)
SELECT
  TIMESTAMP_MICROS(event_timestamp)              AS ts_utc,
  page_title,
  page_location,
  CASE
    WHEN REGEXP_CONTAINS(LOWER(parts[SAFE_OFFSET(ARRAY_LENGTH(parts)-1)]), r'\+')
         AND REGEXP_CONTAINS(
               LOWER(page_location),
               r'/accessories|/apparel|/brands|/campus\+collection|/drinkware|/electronics|/google\+redesign'
               r'|/lifestyle|/nest|/new\+2015\+logo|/notebooks\+journals|/office|/shop\+by\+brand'
               r'|/small\+goods|/stationery|/wearables')
    THEN 'PDP'
    WHEN (
          REGEXP_CONTAINS(LOWER(parts[SAFE_OFFSET(3)]),
                          r'accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign'
                          r'|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand'
                          r'|small\+goods|stationery|wearables')
          OR
          REGEXP_CONTAINS(LOWER(parts[SAFE_OFFSET(4)]),
                          r'accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign'
                          r'|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand'
                          r'|small\+goods|stationery|wearables')
         )
         AND NOT REGEXP_CONTAINS(parts[SAFE_OFFSET(ARRAY_LENGTH(parts)-1)], r'\+')
    THEN 'PLP'
    ELSE 'OTHER'
  END AS page_type
FROM base
ORDER BY event_timestamp
LIMIT 20
