  SELECT
    event_timestamp,
    label,
    LAG(label) OVER (ORDER BY event_timestamp) AS prev_label
  FROM classified
),
dedup AS (
  SELECT
    label,
    ROW_NUMBER() OVER (ORDER BY event_timestamp) AS seq
  FROM ordered
  WHERE prev_label IS NULL OR label <> prev_label
)
SELECT STRING_AGG(label, ' >> ' ORDER BY seq) AS navigation_flow
FROM dedup;
