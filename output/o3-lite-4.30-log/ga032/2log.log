```sql
--Description: 6) Extract page_location (full URL) for PDP / PLP recognition
SELECT
  event_timestamp,
  (SELECT ep.value.string_value
   FROM UNNEST(event_params) AS ep
   WHERE ep.key = 'page_location') AS page_location
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
WHERE event_date = '20210128'
  AND user_pseudo_id = '1362228.4966015575'
  AND event_name = 'page_view'
ORDER BY event_timestamp
LIMIT 20;
```

```sql
--Description: 7) Classify each page_view as PDP, PLP or OTHER using the refined rules
SELECT
  event_timestamp,
  page_location,
  CASE
    WHEN REGEXP_CONTAINS(LOWER(page_location),
         r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)(/|$)')
         AND REGEXP_CONTAINS(page_location, r'\+[^/]*$')
      THEN 'PDP'
    WHEN REGEXP_CONTAINS(LOWER(page_location),
         r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)(/|$)')
         AND NOT REGEXP_CONTAINS(page_location, r'\+[^/]*$')
      THEN 'PLP'
    ELSE 'OTHER'
  END AS page_type
FROM (
  SELECT
    event_timestamp,
    (SELECT ep.value.string_value
     FROM UNNEST(event_params) AS ep
     WHERE ep.key = 'page_location') AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
  WHERE event_date = '20210128'
    AND user_pseudo_id = '1362228.4966015575'
    AND event_name = 'page_view'
)
ORDER BY event_timestamp
LIMIT 20;
```

```sql
--Description: 8) Add lag() to remove immediately‑repeated identical pages (before building path)
WITH ordered AS (
  SELECT
    event_timestamp,
    (SELECT ep.value.string_value
     FROM UNNEST(event_params) AS ep
     WHERE ep.key = 'page_location') AS page_location,
    ROW_NUMBER() OVER (ORDER BY event_timestamp) AS rn
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
  WHERE event_date = '20210128'
    AND user_pseudo_id = '1362228.4966015575'
    AND event_name = 'page_view'
)
SELECT
  event_timestamp,
  page_location
FROM (
  SELECT
    *,
    LAG(page_location) OVER (ORDER BY rn) AS prev_page
  FROM ordered
)
WHERE page_location != prev_page OR prev_page IS NULL
ORDER BY event_timestamp
LIMIT 20;
```

```sql
--Description: 9) Show the deduplicated, classified sequence the user followed
WITH seq AS (
  SELECT
    event_timestamp,
    (SELECT ep.value.string_value
     FROM UNNEST(event_params) AS ep
     WHERE ep.key = 'page_location') AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
  WHERE event_date = '20210128'
    AND user_pseudo_id = '1362228.4966015575'
    AND event_name = 'page_view'
),
dedup AS (
  SELECT
    *,
    LAG(page_location) OVER (ORDER BY event_timestamp) AS prev_page
  FROM seq
),
classified AS (
  SELECT
    event_timestamp,
    page_location,
    CASE
      WHEN REGEXP_CONTAINS(LOWER(page_location),
           r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)(/|$)')
           AND REGEXP_CONTAINS(page_location, r'\+[^/]*$')
        THEN 'PDP'
      WHEN REGEXP_CONTAINS(LOWER(page_location),
           r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)(/|$)')
           AND NOT REGEXP_CONTAINS(page_location, r'\+[^/]*$')
        THEN 'PLP'
      ELSE 'OTHER'
    END AS page_type
  FROM dedup
  WHERE page_location != prev_page OR prev_page IS NULL
)
SELECT *
FROM classified
ORDER BY event_timestamp
LIMIT 20;
```

```sql
--Description: 10) Final query – build the navigation string joined by '>>'
WITH seq AS (
  SELECT
    event_timestamp,
    (SELECT ep.value.string_value
     FROM UNNEST(event_params) AS ep
     WHERE ep.key = 'page_location') AS page_location,
    (SELECT ep.value.string_value
     FROM UNNEST(event_params) AS ep
     WHERE ep.key = 'page_title') AS page_title
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
  WHERE event_date = '20210128'
    AND user_pseudo_id = '1362228.4966015575'
    AND event_name = 'page_view'
),
dedup AS (
  SELECT
    *,
    LAG(page_location) OVER (ORDER BY event_timestamp) AS prev_page
  FROM seq
  ORDER BY event_timestamp
),
classified AS (
  SELECT
    event_timestamp,
    CASE
      WHEN REGEXP_CONTAINS(LOWER(page_location),
           r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)(/|$)')
           AND REGEXP_CONTAINS(page_location, r'\+[^/]*$')
        THEN 'PDP'
      WHEN REGEXP_CONTAINS(LOWER(page_location),
           r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)(/|$)')
           AND NOT REGEXP_CONTAINS(page_location, r'\+[^/]*$')
        THEN 'PLP'
      ELSE COALESCE(page_title, 'OTHER')
    END AS node
  FROM dedup
  WHERE page_location != prev_page OR prev_page IS NULL
)
SELECT STRING_AGG(node, ' >> ' ORDER BY event_timestamp) AS navigation_flow
FROM classified;
```

The last statement outputs exactly one row containing the requested chain such as  

`Home >> PLP >> PDP >> PLP >> Checkout`  

(replacing “Home/Checkout/…” with the actual first‑party page titles that exist in the data).
