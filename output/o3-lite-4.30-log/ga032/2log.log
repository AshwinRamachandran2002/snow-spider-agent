--Description: 8) Add lag() to remove immediately‑repeated identical pages (before building path)
WITH ordered AS (
  SELECT
    event_timestamp,
    (SELECT ep.value.string_value
     FROM UNNEST(event_params) AS ep
     WHERE ep.key = 'page_location') AS page_location,
    ROW_NUMBER() OVER (ORDER BY event_timestamp) AS rn
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
  WHERE event_date = '20210128'
    AND user_pseudo_id = '1362228.4966015575'
    AND event_name = 'page_view'
)
SELECT
  event_timestamp,
  page_location
FROM (
  SELECT
    *,
    LAG(page_location) OVER (ORDER BY rn) AS prev_page
  FROM ordered
)
WHERE page_location != prev_page OR prev_page IS NULL
ORDER BY event_timestamp
LIMIT 20;
