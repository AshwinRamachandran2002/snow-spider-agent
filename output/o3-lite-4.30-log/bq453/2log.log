Begin Exploring Related Columns
Relevant columns and their potential usage  
`reference_name`: chromosome identifier; filter to chromosome 17 and include in SELECT  
`start`, `end`: genomic coordinates; filter range 41 196 311 – 41 277 499 and include in SELECT  
`reference_bases`: reference allele; include in SELECT  
`alternate_bases`: array of alternate allele(s); UNNEST, use DISTINCT, include in SELECT  
`VT`: variant type (e.g. SNP, INDEL); include in SELECT  
`HWE`: χ² statistic of Hardy‑Weinberg equilibrium; include in SELECT  
`AC`, `AF`, `AN`, `AC1`, `AF1`, `AFR_AF`, `AMR_AF`, `ASN_AF`, `EUR_AF`: allele counts / frequencies in the 1 KG meta‑data; include for comparison  
`call`: repeated record with per‑sample genotypes; UNNESTed to count observed genotypes  
 • `call.genotype`: ARRAY<INT64>; decide whether a sample is 0/0, 0/1 (or 1/0), 1/1  
Conditions that will be used  
WHERE `reference_name` = '17'  
AND   `start` BETWEEN 41196311 AND 41277499   -- inclusive genomic interval  

───────────────────────────────────────────────────────────────────────────────  
10 exploratory → final BigQuery SQL statements (each limited to 20 rows)  

```sql
-- 1. Peek at the variants table
SELECT *
FROM `spider2-public-data.1000_genomes.variants`
LIMIT 20;
```

```sql
-- 2. Look only at chromosome 17 in the desired interval
SELECT reference_name, start, end, reference_bases, alternate_bases
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 3. Distinct alternate alleles observed in that region
SELECT DISTINCT alt AS alternate_base
FROM `spider2-public-data.1000_genomes.variants`,
     UNNEST(alternate_bases) AS alt
WHERE reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 4. Count how many variant records fall in the region
SELECT COUNT(*) AS n_variants
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499;
```

```sql
-- 5. Inspect variant type (VT) and HWE statistic
SELECT start, VT, HWE
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 6. Unnest genotypes to see the raw diploid allele calls
SELECT v.start,
       c.call_set_name,
       c.genotype
FROM `spider2-public-data.1000_genomes.variants` AS v,
     UNNEST(v.call) AS c
WHERE v.reference_name = '17'
  AND v.start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 7. Observed genotype counts per variant
SELECT
  v.start,
  COUNTIF(ARRAY_LENGTH(c.genotype)=2
          AND c.genotype[OFFSET(0)] = 0
          AND c.genotype[OFFSET(1)] = 0) AS obs_hom_ref,
  COUNTIF(ARRAY_LENGTH(c.genotype)=2
          AND ((c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 1) OR
               (c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 0))) AS obs_het,
  COUNTIF(ARRAY_LENGTH(c.genotype)=2
          AND c.genotype[OFFSET(0)] = 1
          AND c.genotype[OFFSET(1)] = 1) AS obs_hom_alt,
  COUNT(*) AS total_genotypes
FROM `spider2-public-data.1000_genomes.variants` AS v,
     UNNEST(v.call) AS c
WHERE v.reference_name = '17'
  AND v.start BETWEEN 41196311 AND 41277499
GROUP BY v.start
LIMIT 20;
```

```sql
-- 8. Compute allele frequency from raw genotypes (AF_raw) and compare with AF column
WITH counts AS (
  SELECT
    v.start,
    SUM(c.genotype[OFFSET(0)] + c.genotype[SAFE_OFFSET(1)]) AS alt_allele_count,
    2 * COUNT(*)                                          AS total_alleles
  FROM `spider2-public-data.1000_genomes.variants` AS v,
       UNNEST(v.call) AS c
  WHERE v.reference_name = '17'
    AND v.start BETWEEN 41196311 AND 41277499
  GROUP BY v.start
)
SELECT
  v.start,
  counts.alt_allele_count / counts.total_alleles AS AF_raw,
  v.AF                                           AS AF_reported
FROM `spider2-public-data.1000_genomes.variants` AS v
JOIN counts USING (start)
WHERE v.reference_name = '17'
  AND v.start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 9. Expected genotype counts via Hardy‑Weinberg equilibrium
WITH obs AS (
  SELECT
    v.start,
    COUNTIF(ARRAY_LENGTH(c.genotype)=2
            AND c.genotype[OFFSET(0)] = 0
            AND c.genotype[OFFSET(1)] = 0) AS hom_ref,
    COUNTIF(ARRAY_LENGTH(c.genotype)=2
            AND ((c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 1) OR
                 (c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 0))) AS het,
    COUNTIF(ARRAY_LENGTH(c.genotype)=2
            AND c.genotype[OFFSET(0)] = 1
            AND c.genotype[OFFSET(1)] = 1) AS hom_alt,
    COUNT(*) AS N
  FROM `spider2-public-data.1000_genomes.variants` AS v,
       UNNEST(v.call) AS c
  WHERE v.reference_name = '17'
    AND v.start BETWEEN 41196311 AND 41277499
  GROUP BY v.start
)
SELECT
  start,
  N,
  hom_ref AS obs_hom_ref,
  het     AS obs_het,
  hom_alt AS obs_hom_alt,
  -- allele frequency p (alt)
  (2*hom_alt + het) / (2*N) AS p,
  -- expected counts
  (1 - ((2*hom_alt + het) / (2*N))) * (1 - ((2*hom_alt + het) / (2*N))) * N AS exp_hom_ref,
  2 * ((2*hom_alt + het) / (2*N)) * (1 - ((2*hom_alt + het) / (2*N))) * N   AS exp_het,
  ((2*hom_alt + het) / (2*N)) * ((2*hom_alt + het) / (2*N)) * N             AS exp_hom_alt
FROM obs
LIMIT 20;
```

```sql
-- 10. Final answer query: all requested attributes per variant in the target interval
WITH genotype_stats AS (
  SELECT
    v.start,
    v.end,
    COUNT(*)                                            AS total_genotypes,
    COUNTIF(ARRAY_LENGTH(c.genotype)=2
            AND c.genotype[OFFSET(0)] = 0
            AND c.genotype[OFFSET(1)] = 0)              AS obs_hom_ref,
    COUNTIF(ARRAY_LENGTH(c.genotype)=2
            AND ((c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 1) OR
                 (c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 0))) AS obs_het,
    COUNTIF(ARRAY_LENGTH(c.genotype)=2
            AND c.genotype[OFFSET(0)] = 1
            AND c.genotype[OFFSET(1)] = 1)              AS obs_hom_alt
  FROM `spider2-public-data.1000_genomes.variants` AS v,
       UNNEST(v.call) AS c
  WHERE v.reference_name = '17'
    AND v.start BETWEEN 41196311 AND 41277499
  GROUP BY v.start, v.end
)
SELECT
  v.reference_name,
  v.start,
  v.end,
  v.reference_bases,
  ARRAY_DISTINCT(v.alternate_bases)                      AS distinct_alt_bases,
  v.VT                                                  AS variant_type,
  v.HWE                                                 AS chi_squared,
  g.total_genotypes,
  g.obs_hom_ref,
  g.obs_het,
  g.obs_hom_alt,
  -- allele frequency derived from genotypes
  SAFE_DIVIDE(2*g.obs_hom_alt + g.obs_het, 2*g.total_genotypes) AS AF_observed,
  -- expected counts from H‑W using AF column (if present)
  (1 - v.AF) * (1 - v.AF) * g.total_genotypes            AS exp_hom_ref,
  2 * v.AF * (1 - v.AF) * g.total_genotypes              AS exp_het,
  v.AF * v.AF * g.total_genotypes                        AS exp_hom_alt,
  v.AF                                                   AS AF_1KG_overall,
  v.AFR_AF, v.AMR_AF, v.ASN_AF, v.EUR_AF
FROM `spider2-public-data.1000_genomes.variants` AS v
JOIN genotype_stats AS g
  ON v.start = g.start AND v.end = g.end
WHERE v.reference_name = '17'
  AND v.start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

The tenth query returns, for every variant on chromosome 17 in the specified interval, the reference/alternate alleles, variant type, χ² HWE statistic, observed genotype counts, Hardy‑Weinberg expected counts (computed from 1 KG allele frequency), observed allele frequency from the individual genotypes, and the 1 KG population allele‑frequency columns.
