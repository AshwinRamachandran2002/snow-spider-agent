--Description: 9) Calculate expected genotype counts under Hardy‑Weinberg equilibrium for each variant.
WITH obs AS (
  SELECT
    v.start,
    COUNTIF(ARRAY_LENGTH(c.genotype)=2
            AND c.genotype[OFFSET(0)] = 0
            AND c.genotype[OFFSET(1)] = 0) AS hom_ref,
    COUNTIF(ARRAY_LENGTH(c.genotype)=2
            AND ((c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 1) OR
                 (c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 0))) AS het,
    COUNTIF(ARRAY_LENGTH(c.genotype)=2
            AND c.genotype[OFFSET(0)] = 1
            AND c.genotype[OFFSET(1)] = 1) AS hom_alt,
    COUNT(*) AS N
  FROM `genomics-public-data.1000_genomes.variants` AS v,
       UNNEST(v.call) AS c
  WHERE v.reference_name = '17'
    AND v.start BETWEEN 41196311 AND 41277499
  GROUP BY v.start
)
SELECT
  start,
  N,
  hom_ref AS obs_hom_ref,
  het     AS obs_het,
  hom_alt AS obs_hom_alt,
  (2*hom_alt + het) / (2*N) AS p,                   -- alt‑allele frequency
  (1 - ((2*hom_alt + het) / (2*N)))^2 * N AS exp_hom_ref,
  2 * ((2*hom_alt + het) / (2*N)) *
      (1 - ((2*hom_alt + het) / (2*N))) * N  AS exp_het,
  ((2*hom_alt + het) / (2*N))^2 * N          AS exp_hom_alt
FROM obs
LIMIT 20
