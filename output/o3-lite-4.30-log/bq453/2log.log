--Description: 8) Derive allele frequency from raw genotypes (AF_raw) and compare with the AF column.
WITH counts AS (
  SELECT
    v.start,
    SUM(c.genotype[OFFSET(0)] + c.genotype[SAFE_OFFSET(1)]) AS alt_allele_count,
    2 * COUNT(*)                                           AS total_alleles
  FROM `genomics-public-data.1000_genomes.variants` AS v,
       UNNEST(v.call) AS c
  WHERE v.reference_name = '17'
    AND v.start BETWEEN 41196311 AND 41277499
  GROUP BY v.start
)
SELECT
  v.start,
  counts.alt_allele_count / counts.total_alleles AS AF_raw,
  v.AF                                           AS AF_reported
FROM `genomics-public-data.1000_genomes.variants` AS v
JOIN counts USING (start)
WHERE v.reference_name = '17'
  AND v.start BETWEEN 41196311 AND 41277499
LIMIT 20
