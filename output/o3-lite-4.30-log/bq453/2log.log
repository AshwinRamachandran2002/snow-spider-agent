--Description: Full variant report for chr 17 (41 196 311 – 41 277 499).
--             Step 1 (CTE genotype_stats): unnest per‑sample calls to gather
--             observed genotype counts and total samples for each variant.
--             Step 2: join back to the main variant table and build an array
--             of DISTINCT alternate alleles via a sub‑SELECT (avoids the
--             unsupported ARRAY_DISTINCT).  The query returns reference /
--             alternate alleles, variant type, H‑W χ², observed & H‑W‑expected
--             genotype counts, allele‑frequency metrics, and 1 KG population
--             frequencies, previewing 20 rows.
WITH genotype_stats AS (
  SELECT
    v.start,
    v.`end`,
    COUNT(*) AS total_genotypes,
    COUNTIF(ARRAY_LENGTH(c.genotype) = 2
            AND c.genotype[OFFSET(0)] = 0
            AND c.genotype[OFFSET(1)] = 0)                                     AS obs_hom_ref,
    COUNTIF(ARRAY_LENGTH(c.genotype) = 2
            AND ((c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 1) OR
                 (c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 0)))    AS obs_het,
    COUNTIF(ARRAY_LENGTH(c.genotype) = 2
            AND c.genotype[OFFSET(0)] = 1
            AND c.genotype[OFFSET(1)] = 1)                                     AS obs_hom_alt
  FROM `genomics-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  WHERE v.reference_name = '17'
    AND v.start BETWEEN 41196311 AND 41277499
  GROUP BY v.start, v.`end`
)
SELECT
  v.reference_name,
  v.start,
  v.`end`,
  v.reference_bases,
  ARRAY(SELECT DISTINCT alt FROM UNNEST(v.alternate_bases) AS alt)
      AS distinct_alt_bases,
  v.VT                                                    AS variant_type,
  v.HWE                                                   AS chi_squared,
  g.total_genotypes,
  g.obs_hom_ref,
  g.obs_het,
  g.obs_hom_alt,
  SAFE_DIVIDE(2*g.obs_hom_alt + g.obs_het, 2*g.total_genotypes) AS AF_observed,
  (1 - v.AF) * (1 - v.AF) * g.total_genotypes                   AS exp_hom_ref,
  2 * v.AF * (1 - v.AF) * g.total_genotypes                     AS exp_het,
  v.AF * v.AF * g.total_genotypes                               AS exp_hom_alt,
  v.AF                                                          AS AF_1KG_overall,
  v.AFR_AF, v.AMR_AF, v.ASN_AF, v.EUR_AF
FROM `genomics-public-data.1000_genomes.variants` AS v
JOIN genotype_stats AS g
  ON v.start = g.start
 AND v.`end`  = g.`end`
WHERE v.reference_name = '17'
  AND v.start BETWEEN 41196311 AND 41277499
LIMIT 20
