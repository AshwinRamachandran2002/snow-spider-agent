  CROSS JOIN UNNEST(v.call) AS c
  WHERE reference_name = '17'
    AND start BETWEEN 41196311 AND 41277499
),
obs AS (
  SELECT
    reference_name, start, `end`, reference_bases, alt_bases, variant_type,
    AF, AF1, AFR_AF, AMR_AF, ASN_AF, EUR_AF,
    COUNTIF(genotype[OFFSET(0)] = 0 AND genotype[SAFE_OFFSET(1)] = 0) AS hom_ref_obs,
    COUNTIF((genotype[OFFSET(0)] = 0 AND genotype[SAFE_OFFSET(1)] = 1)
         OR  (genotype[OFFSET(0)] = 1 AND genotype[SAFE_OFFSET(1)] = 0)) AS het_obs,
    COUNTIF(genotype[OFFSET(0)] = 1 AND genotype[SAFE_OFFSET(1)] = 1)     AS hom_alt_obs
  FROM region
  GROUP BY reference_name, start, `end`, reference_bases, alt_bases, variant_type,
           AF, AF1, AFR_AF, AMR_AF, ASN_AF, EUR_AF
),
stats AS (
  SELECT
    *,
    hom_ref_obs + het_obs + hom_alt_obs                                      AS N,
    SAFE_DIVIDE(2 * hom_alt_obs + het_obs, 2 * (hom_ref_obs+het_obs+hom_alt_obs)) AS q,
    SAFE_DIVIDE(2 * hom_ref_obs + het_obs, 2 * (hom_ref_obs+het_obs+hom_alt_obs)) AS p,
    -- expected counts under HWE
    (hom_ref_obs + het_obs + hom_alt_obs) * POW(SAFE_DIVIDE(2 * hom_ref_obs + het_obs,
                                                             2 * (hom_ref_obs+het_obs+hom_alt_obs)), 2) AS hom_ref_exp,
    (hom_ref_obs + het_obs + hom_alt_obs) * 2 * SAFE_DIVIDE(2 * hom_ref_obs + het_obs,
                                                             2 * (hom_ref_obs+het_obs+hom_alt_obs)) *
