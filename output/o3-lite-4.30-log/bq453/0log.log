                                                             2 * (hom_ref_obs+het_obs+hom_alt_obs))     AS het_exp,
    (hom_ref_obs + het_obs + hom_alt_obs) * POW(SAFE_DIVIDE(2 * hom_alt_obs + het_obs,
                                                             2 * (hom_ref_obs+het_obs+hom_alt_obs)), 2) AS hom_alt_exp
  FROM obs
)
SELECT
