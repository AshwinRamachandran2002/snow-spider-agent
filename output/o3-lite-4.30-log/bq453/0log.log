       ARRAY_TO_STRING(ARRAY_DISTINCT(alternate_bases), ',') AS distinct_alt_bases
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 3) Include variant type together with distinct alternate alleles
SELECT reference_name, start, end, reference_bases,
       ARRAY_TO_STRING(ARRAY_DISTINCT(alternate_bases), ',') AS distinct_alt_bases,
       VT AS variant_type
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 4) Inspect raw genotypes for a handful of samples
SELECT v.start, c.call_set_name, c.genotype
FROM `spider2-public-data.1000_genomes.variants` AS v
CROSS JOIN UNNEST(v.call) AS c
WHERE v.reference_name = '17'
  AND v.start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 5) Count observed genotypes (hom‑ref / het / hom‑alt) per variant
SELECT v.start,
       COUNTIF(c.genotype[OFFSET(0)] = 0 
               AND c.genotype[SAFE_OFFSET(1)] = 0) AS hom_ref_cnt,
       COUNTIF(((c.genotype[OFFSET(0)] = 0 AND c.genotype[SAFE_OFFSET(1)] = 1) OR
                (c.genotype[OFFSET(0)] = 1 AND c.genotype[SAFE_OFFSET(1)] = 0))) AS het_cnt,
       COUNTIF(c.genotype[OFFSET(0)] = 1 
               AND c.genotype[SAFE_OFFSET(1)] = 1) AS hom_alt_cnt
FROM `spider2-public-data.1000_genomes.variants` AS v
CROSS JOIN UNNEST(v.call) AS c
WHERE v.reference_name = '17'
  AND v.start BETWEEN 41196311 AND 41277499
GROUP BY v.start
LIMIT 20;
```

```sql
-- 6) Add allele counts and sample allele frequency (q = alt)
WITH gt AS (
  SELECT v.start,
         COUNTIF(c.genotype[OFFSET(0)] = 0 AND c.genotype[SAFE_OFFSET(1)] = 0) AS rr,
         COUNTIF(((c.genotype[OFFSET(0)] = 0 AND c.genotype[SAFE_OFFSET(1)] = 1) OR
                  (c.genotype[OFFSET(0)] = 1 AND c.genotype[SAFE_OFFSET(1)] = 0))) AS ra,
         COUNTIF(c.genotype[OFFSET(0)] = 1 AND c.genotype[SAFE_OFFSET(1)] = 1) AS aa
  FROM `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  WHERE v.reference_name = '17'
    AND v.start BETWEEN 41196311 AND 41277499
  GROUP BY v.start
)
SELECT start,
       rr AS hom_ref_cnt, ra AS het_cnt, aa AS hom_alt_cnt,
       2*rr + ra AS ref_alleles,
       2*aa + ra AS alt_alleles,
       SAFE_DIVIDE(2*aa + ra, 2*(rr+ra+aa)) AS alt_freq
FROM gt
LIMIT 20;
```

```sql
-- 7) Compute expected genotype counts under HWE and Chi‑square test
WITH g AS (
  SELECT v.start,
         COUNTIF(c.genotype[OFFSET(0)] = 0 AND c.genotype[SAFE_OFFSET(1)] = 0) AS rr,
         COUNTIF(((c.genotype[OFFSET(0)] = 0 AND c.genotype[SAFE_OFFSET(1)] = 1) OR
                  (c.genotype[OFFSET(0)] = 1 AND c.genotype[SAFE_OFFSET(1)] = 0))) AS ra,
         COUNTIF(c.genotype[OFFSET(0)] = 1 AND c.genotype[SAFE_OFFSET(1)] = 1) AS aa
  FROM `spider2-public-data.1000_genomes.variants` v
  CROSS JOIN UNNEST(v.call) AS c
  WHERE v.reference_name = '17'
    AND v.start BETWEEN 41196311 AND 41277499
  GROUP BY v.start
)
SELECT start,
       rr, ra, aa,
       rr + ra + aa AS N,
       SAFE_DIVIDE(2*aa + ra, 2*(rr+ra+aa)) AS q,
       SAFE_DIVIDE(2*rr + ra, 2*(rr+ra+aa)) AS p,
       (rr+ra+aa) * POW(SAFE_DIVIDE(2*rr + ra, 2*(rr+ra+aa)),2)  AS exp_rr,
       (rr+ra+aa) * 2*SAFE_DIVIDE(2*rr + ra, 2*(rr+ra+aa))*SAFE_DIVIDE(2*aa + ra, 2*(rr+ra+aa)) AS exp_ra,
       (rr+ra+aa) * POW(SAFE_DIVIDE(2*aa + ra, 2*(rr+ra+aa)),2)  AS exp_aa,
       -- Chi‑square
       SAFE_DIVIDE(POW(rr - ((rr+ra+aa) * POW(SAFE_DIVIDE(2*rr + ra, 2*(rr+ra+aa)),2)),2),
                   ((rr+ra+aa) * POW(SAFE_DIVIDE(2*rr + ra, 2*(rr+ra+aa)),2)))
       +
       SAFE_DIVIDE(POW(ra - ((rr+ra+aa) * 2*SAFE_DIVIDE(2*rr + ra, 2*(rr+ra+aa))*SAFE_DIVIDE(2*aa + ra, 2*(rr+ra+aa))),2),
                   ((rr+ra+aa) * 2*SAFE_DIVIDE(2*rr + ra, 2*(rr+ra+aa))*SAFE_DIVIDE(2*aa + ra, 2*(rr+ra+aa))))
       +
       SAFE_DIVIDE(POW(aa - ((rr+ra+aa) * POW(SAFE_DIVIDE(2*aa + ra, 2*(rr+ra+aa)),2)),2),
                   ((rr+ra+aa) * POW(SAFE_DIVIDE(2*aa + ra, 2*(rr+ra+aa)),2))) AS chi_sq
FROM g
LIMIT 20;
```

```sql
-- 8) Add distinct alt bases and variant type on top of HWE statistics
WITH base AS (
  SELECT v.start, v.end, v.reference_bases, v.alternate_bases, v.VT,
         c.genotype
  FROM `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  WHERE v.reference_name = '17'
    AND v.start BETWEEN 41196311 AND 41277499
), agg AS (
  SELECT start, end,
         ARRAY_TO_STRING(ARRAY_DISTINCT(alternate_bases), ',') AS alt_bases,
         reference_bases, VT,
         COUNTIF(genotype[OFFSET(0)] = 0 AND genotype[SAFE_OFFSET(1)] = 0) AS rr,
         COUNTIF(((genotype[OFFSET(0)] = 0 AND genotype[SAFE_OFFSET(1)] = 1) OR
                  (genotype[OFFSET(0)] = 1 AND genotype[SAFE_OFFSET(1)] = 0))) AS ra,
         COUNTIF(genotype[OFFSET(0)] = 1 AND genotype[SAFE_OFFSET(1)] = 1)          AS aa
  FROM base
  GROUP BY start, end, reference_bases, alt_bases, VT
)
SELECT *
FROM agg
LIMIT 20;
```

```sql
-- 9) Pull in 1000G allele‑frequency annotations alongside sample‑derived ones
WITH vc AS (
  SELECT v.start, v.end, v.reference_bases,
         ARRAY_TO_STRING(ARRAY_DISTINCT(v.alternate_bases), ',') AS alt_bases,
         v.VT, v.AF, v.AF1, v.AFR_AF, v.AMR_AF, v.ASN_AF, v.EUR_AF,
         c.genotype
  FROM `spider2-public-data.1000_genomes.variants` v
  CROSS JOIN UNNEST(v.call) c
  WHERE v.reference_name = '17'
    AND v.start BETWEEN 41196311 AND 41277499
), cts AS (
  SELECT start, end, reference_bases, alt_bases, VT,
         AF, AF1, AFR_AF, AMR_AF, ASN_AF, EUR_AF,
         COUNTIF(genotype[OFFSET(0)] = 0 AND genotype[SAFE_OFFSET(1)] = 0) AS rr,
         COUNTIF(((genotype[OFFSET(0)] = 0 AND genotype[SAFE_OFFSET(1)] = 1) OR
                  (genotype[OFFSET(0)] = 1 AND genotype[SAFE_OFFSET(1)] = 0))) AS ra,
         COUNTIF(genotype[OFFSET(0)] = 1 AND genotype[SAFE_OFFSET(1)] = 1)          AS aa
  FROM vc
  GROUP BY start, end, reference_bases, alt_bases, VT,
           AF, AF1, AFR_AF, AMR_AF, ASN_AF, EUR_AF
)
SELECT *
FROM cts
LIMIT 20;
```

```sql
-- 10) FINAL – everything asked: variant details, HWE χ², observed & expected genotype counts,
--     allele frequencies (ours + 1KG)  (20‑row glimpse)
WITH region AS (
  SELECT v.reference_name, v.start, v.end, v.reference_bases, v.alternate_bases,
         v.VT, v.AF, v.AF1, v.AFR_AF, v.AMR_AF, v.ASN_AF, v.EUR_AF,
         c.genotype
  FROM `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  WHERE v.reference_name = '17'
    AND v.start BETWEEN 41196311 AND 41277499
), counts AS (
  SELECT reference_name, start, end, reference_bases,
         ARRAY_TO_STRING(ARRAY_DISTINCT(alternate_bases), ',') AS distinct_alt_bases,
         VT,
         AF, AF1, AFR_AF, AMR_AF, ASN_AF, EUR_AF,
         COUNTIF(genotype[OFFSET(0)] = 0 AND genotype[SAFE_OFFSET(1)] = 0) AS hom_ref_obs,
         COUNTIF(((genotype[OFFSET(0)] = 0 AND genotype[SAFE_OFFSET(1)] = 1) OR
                  (genotype[OFFSET(0)] = 1 AND genotype[SAFE_OFFSET(1)] = 0))) AS het_obs,
         COUNTIF(genotype[OFFSET(0)] = 1 AND genotype[SAFE_OFFSET(1)] = 1)          AS hom_alt_obs
  FROM region
  GROUP BY reference_name, start, end, reference_bases,
           distinct_alt_bases, VT,
           AF, AF1, AFR_AF, AMR_AF, ASN_AF, EUR_AF
), stats AS (
  SELECT *,
         (hom_ref_obs + het_obs + hom_alt_obs)                                   AS N,
         SAFE_DIVIDE(2*hom_alt_obs + het_obs, 2*(hom_ref_obs+het_obs+hom_alt_obs)) AS q_alt_freq,
         SAFE_DIVIDE(2*hom_ref_obs + het_obs, 2*(hom_ref_obs+het_obs+hom_alt_obs)) AS p_ref_freq
  FROM counts
), exp AS (
  SELECT *,
         N * POW(p_ref_freq, 2)                            AS hom_ref_exp,
         N * 2 * p_ref_freq * q_alt_freq                   AS het_exp,
         N * POW(q_alt_freq, 2)                            AS hom_alt_exp
  FROM stats
), chi AS (
  SELECT *,
         SAFE_DIVIDE(POW(hom_ref_obs - hom_ref_exp, 2), hom_ref_exp) +
         SAFE_DIVIDE(POW(het_obs     - het_exp,     2), het_exp)     +
         SAFE_DIVIDE(POW(hom_alt_obs - hom_alt_exp, 2), hom_alt_exp) AS chi_squared
  FROM exp
)
SELECT reference_name,
       start, end,
       reference_bases,
       distinct_alt_bases,
       VT AS variant_type,
       chi_squared,
       N     AS total_genotypes,
       hom_ref_obs, het_obs, hom_alt_obs,
       hom_ref_exp, het_exp, hom_alt_exp,
       p_ref_freq  AS ref_allele_freq,
       q_alt_freq  AS alt_allele_freq,
       AF, AF1, AFR_AF, AMR_AF, ASN_AF, EUR_AF
FROM chi
ORDER BY start
LIMIT 20;
```

The last statement (query 10) produces the requested fields for every variant in chromosome 17 between positions 41 196 311 and 41 277 499, including Hardy‑Weinberg chi‑squared values, observed/expected genotype counts, allele frequencies, and 1000 Genomes frequency annotations.
