WITH region AS (
  SELECT
    reference_name,
    start,
    `end`,                               -- back‑ticked because END is reserved
    reference_bases,
    ARRAY_TO_STRING(ARRAY_DISTINCT(alternate_bases), ',') AS alt_bases,
