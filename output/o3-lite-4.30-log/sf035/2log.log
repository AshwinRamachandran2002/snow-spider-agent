[Answer format]
2025-05-01 03:44:26 - Thread-1611 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
"USER_ID": identify each user; will be counted uniquely  
"APP_GROUP_ID": distinguishes app groups; used in GROUP BY  
"TIME": UNIX‐epoch seconds when a session started; used to filter the 2023‑06‑01 → 2023‑06‑07 window and to derive the session start day  
"SESSION_ID": may help confirm a session event (not essential for the main metric)  

Typical filter condition on the requested period  
WHERE "TIME" BETWEEN 1685577600 /* 2023‑06‑01 00:00:00 UTC */  
                  AND 1686182399 /* 2023‑06‑07 23:59:59 UTC */

--------------------------------------------------------------------
Ten exploratory → final Snowflake SQL queries (each returns ≤20 rows)

```sql
--Description: 1) Peek at raw rows within the June 1‑7, 2023 window
SELECT "USER_ID",
       "APP_GROUP_ID",
       "TIME"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_BEHAVIORS_APP_SESSIONSTART_VIEW"
WHERE "TIME" BETWEEN 1685577600 AND 1686182399
LIMIT 20;
```

```sql
--Description: 2) Show distinct app‑group IDs present during the period
SELECT DISTINCT "APP_GROUP_ID"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_BEHAVIORS_APP_SESSIONSTART_VIEW"
WHERE "TIME" BETWEEN 1685577600 AND 1686182399
LIMIT 20;
```

```sql
--Description: 3) Sample distinct users who started sessions in the period
SELECT DISTINCT "USER_ID"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_BEHAVIORS_APP_SESSIONSTART_VIEW"
WHERE "TIME" BETWEEN 1685577600 AND 1686182399
LIMIT 20;
```

```sql
--Description: 4) Combine user and app‑group to see possible duplicates
SELECT DISTINCT "APP_GROUP_ID",
       "USER_ID"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_BEHAVIORS_APP_SESSIONSTART_VIEW"
WHERE "TIME" BETWEEN 1685577600 AND 1686182399
LIMIT 20;
```

```sql
--Description: 5) Inspect how many session events each user fired (top 20)
SELECT "APP_GROUP_ID",
       "USER_ID",
       COUNT(*) AS "session_events"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_BEHAVIORS_APP_SESSIONSTART_VIEW"
WHERE "TIME" BETWEEN 1685577600 AND 1686182399
GROUP BY "APP_GROUP_ID", "USER_ID"
ORDER BY "session_events" DESC
LIMIT 20;
```

```sql
--Description: 6) Extract the start‑day (UTC) using TO_DATE on epoch seconds
SELECT "APP_GROUP_ID",
       TO_DATE('1970-01-01') + ("TIME" / 86400)::INTEGER AS "session_day_utc",
       "USER_ID"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_BEHAVIORS_APP_SESSIONSTART_VIEW"
WHERE "TIME" BETWEEN 1685577600 AND 1686182399
LIMIT 20;
```

```sql
--Description: 7) Count distinct users per app‑group for each day
SELECT "APP_GROUP_ID",
       TO_DATE('1970-01-01') + ("TIME" / 86400)::INTEGER AS "session_day_utc",
       COUNT(DISTINCT "USER_ID") AS "unique_users"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_BEHAVIORS_APP_SESSIONSTART_VIEW"
WHERE "TIME" BETWEEN 1685577600 AND 1686182399
GROUP BY "APP_GROUP_ID",
         TO_DATE('1970-01-01') + ("TIME" / 86400)::INTEGER
ORDER BY "APP_GROUP_ID",
         "session_day_utc"
LIMIT 20;
```

```sql
--Description: 8) Same as 7 but restrict to only those app‑groups with ≥10 users
SELECT "APP_GROUP_ID",
       TO_DATE('1970-01-01') + ("TIME" / 86400)::INTEGER AS "session_day_utc",
       COUNT(DISTINCT "USER_ID") AS "unique_users"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_BEHAVIORS_APP_SESSIONSTART_VIEW"
WHERE "TIME" BETWEEN 1685577600 AND 1686182399
GROUP BY "APP_GROUP_ID",
         TO_DATE('1970-01-01') + ("TIME" / 86400)::INTEGER
HAVING COUNT(DISTINCT "USER_ID") >= 10
ORDER BY "unique_users" DESC
LIMIT 20;
```

```sql
--Description: 9) Focus on a single app‑group (fuzzy match) to explore trend
SELECT TO_DATE('1970-01-01') + ("TIME" / 86400)::INTEGER AS "session_day_utc",
       COUNT(DISTINCT "USER_ID") AS "unique_users"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_BEHAVIORS_APP_SESSIONSTART_VIEW"
WHERE "TIME" BETWEEN 1685577600 AND 1686182399
  AND "APP_GROUP_ID" ILIKE '%OkIYT1HbF7u%'   -- example fuzzy filter
GROUP BY TO_DATE('1970-01-01') + ("TIME" / 86400)::INTEGER
ORDER BY "session_day_utc"
LIMIT 20;
```

```sql
--Description: 10) FINAL: unique‑user count per day and app‑group for June 1‑7 2023
SELECT "APP_GROUP_ID",
       TO_DATE('1970-01-01') + ("TIME" / 86400)::INTEGER AS "session_day_utc",
       COUNT(DISTINCT "USER_ID") AS "unique_users_started_session"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_BEHAVIORS_APP_SESSIONSTART_VIEW"
WHERE "TIME" BETWEEN 1685577600 AND 1686182399
GROUP BY "APP_GROUP_ID",
         TO_DATE('1970-01-01') + ("TIME" / 86400)::INTEGER
ORDER BY "session_day_utc",
         "APP_GROUP_ID"
LIMIT 20;
```
