Relevant columns and their uses for figuring out the lowest bowling‑average  

player.player_id / player.player_name : to convert a bowler’s id to his name  
ball_by_ball.bowler                 : who delivered every ball (the bowler)  
batsman_scored.runs_scored          : runs made off the bat on each ball – always go to the bowler’s analysis  
extra_runs.extra_type / extra_runs.extra_runs : wides & no‑balls are charged to the bowler (byes / leg‑byes are not)  
wicket_taken.kind_out               : tells which dismissals count as a bowler’s wicket (exclude “run out”, “retired hurt”, …)  
wicket_taken.match_id, over_id, ball_id, innings_no  
ball_by_ball.match_id, over_id, ball_id, innings_no : join keys so we know which bowler took the wicket  

Below are ten exploratory → final SQL queries (LIMIT 20 each) that progressively build the answer.  
(Every query is independent; copy‑run one at a time.)

```sql
-- 1. See some bowler ids that exist in the ball‑by‑ball table
SELECT DISTINCT bowler
FROM ball_by_ball
LIMIT 20;
```

```sql
-- 2. Translate a few of those ids to names
SELECT DISTINCT bb.bowler, p.player_name
FROM ball_by_ball AS bb
JOIN player        AS p ON p.player_id = bb.bowler
LIMIT 20;
```

```sql
-- 3. What kinds of extras are recorded?
SELECT DISTINCT extra_type
FROM extra_runs
LIMIT 20;
```

```sql
-- 4. What dismissal kinds are stored?
SELECT DISTINCT kind_out
FROM wicket_taken
LIMIT 20;
```

```sql
-- 5. Raw wicket count per bowler (all dismissal kinds)
SELECT p.player_name,
       COUNT(*) AS wickets_all
FROM ball_by_ball     AS bb
JOIN wicket_taken     AS w  ON w.match_id = bb.match_id
                           AND w.over_id  = bb.over_id
                           AND w.ball_id  = bb.ball_id
                           AND w.innings_no = bb.innings_no
JOIN player           AS p  ON p.player_id = bb.bowler
GROUP BY p.player_name
ORDER BY wickets_all DESC
LIMIT 20;
```

```sql
-- 6. Wickets that are credited to the bowler
SELECT p.player_name,
       COUNT(*) AS wickets_to_bowler
FROM ball_by_ball     AS bb
JOIN wicket_taken     AS w  ON w.match_id = bb.match_id
                           AND w.over_id  = bb.over_id
                           AND w.ball_id  = bb.ball_id
                           AND w.innings_no = bb.innings_no
JOIN player           AS p  ON p.player_id = bb.bowler
WHERE w.kind_out NOT IN ('run out','retired hurt','obstructing the field')
GROUP BY p.player_name
ORDER BY wickets_to_bowler DESC
LIMIT 20;
```

```sql
-- 7. Runs off the bat conceded by every bowler
SELECT p.player_name,
       SUM(bs.runs_scored) AS runs_off_bat
FROM ball_by_ball AS bb
JOIN batsman_scored AS bs ON bs.match_id = bb.match_id
                         AND bs.over_id  = bb.over_id
                         AND bs.ball_id  = bb.ball_id
                         AND bs.innings_no = bb.innings_no
JOIN player AS p ON p.player_id = bb.bowler
GROUP BY p.player_name
ORDER BY runs_off_bat DESC
LIMIT 20;
```

```sql
-- 8. Add wides & no‑balls (charged to the bowler) to those runs
SELECT p.player_name,
       SUM(bs.runs_scored)
       + SUM(CASE WHEN er.extra_type IN ('wides','noballs')
                  THEN er.extra_runs ELSE 0 END) AS total_runs_conceded
FROM ball_by_ball AS bb
LEFT JOIN batsman_scored AS bs ON bs.match_id = bb.match_id
                              AND bs.over_id  = bb.over_id
                              AND bs.ball_id  = bb.ball_id
                              AND bs.innings_no = bb.innings_no
LEFT JOIN extra_runs     AS er ON er.match_id = bb.match_id
                              AND er.over_id  = bb.over_id
                              AND er.ball_id  = bb.ball_id
                              AND er.innings_no = bb.innings_no
JOIN player AS p ON p.player_id = bb.bowler
GROUP BY p.player_name
ORDER BY total_runs_conceded DESC
LIMIT 20;
```

```sql
-- 9. Bowling average (runs per wicket) of every bowler
WITH runs AS (
    SELECT bb.bowler,
           SUM(bs.runs_scored)
         + SUM(CASE WHEN er.extra_type IN ('wides','noballs')
                    THEN er.extra_runs ELSE 0 END) AS runs_conceded
    FROM ball_by_ball AS bb
    LEFT JOIN batsman_scored AS bs ON bs.match_id = bb.match_id
                                  AND bs.over_id  = bb.over_id
                                  AND bs.ball_id  = bb.ball_id
                                  AND bs.innings_no = bb.innings_no
    LEFT JOIN extra_runs     AS er ON er.match_id = bb.match_id
                                  AND er.over_id  = bb.over_id
                                  AND er.ball_id  = bb.ball_id
                                  AND er.innings_no = bb.innings_no
    GROUP BY bb.bowler
),
wkts AS (
    SELECT bb.bowler,
           COUNT(*) AS wickets
    FROM ball_by_ball AS bb
    JOIN wicket_taken AS w ON w.match_id = bb.match_id
                          AND w.over_id  = bb.over_id
                          AND w.ball_id  = bb.ball_id
                          AND w.innings_no = bb.innings_no
    WHERE w.kind_out NOT IN ('run out','retired hurt','obstructing the field')
    GROUP BY bb.bowler
)
SELECT p.player_name,
       1.0 * r.runs_conceded / w.wickets AS bowling_average
FROM runs AS r
JOIN wkts AS w       ON w.bowler = r.bowler
JOIN player AS p     ON p.player_id = r.bowler
WHERE w.wickets > 0
ORDER BY bowling_average ASC
LIMIT 20;
```

```sql
-- 10. The bowler with the lowest bowling average
WITH runs AS (
    SELECT bb.bowler,
           SUM(bs.runs_scored)
         + SUM(CASE WHEN er.extra_type IN ('wides','noballs')
                    THEN er.extra_runs ELSE 0 END) AS runs_conceded
    FROM ball_by_ball AS bb
    LEFT JOIN batsman_scored AS bs ON bs.match_id = bb.match_id
                                  AND bs.over_id  = bb.over_id
                                  AND bs.ball_id  = bb.ball_id
                                  AND bs.innings_no = bb.innings_no
    LEFT JOIN extra_runs     AS er ON er.match_id = bb.match_id
                                  AND er.over_id  = bb.over_id
                                  AND er.ball_id  = bb.ball_id
                                  AND er.innings_no = bb.innings_no
    GROUP BY bb.bowler
),
wkts AS (
    SELECT bb.bowler,
           COUNT(*) AS wickets
    FROM ball_by_ball AS bb
    JOIN wicket_taken AS w ON w.match_id = bb.match_id
                          AND w.over_id  = bb.over_id
                          AND w.ball_id  = bb.ball_id
                          AND w.innings_no = bb.innings_no
    WHERE w.kind_out NOT IN ('run out','retired hurt','obstructing the field')
    GROUP BY bb.bowler
),
averages AS (
    SELECT r.bowler,
           r.runs_conceded,
           w.wickets,
           1.0 * r.runs_conceded / w.wickets AS avg_runs_per_wicket
    FROM runs AS r
    JOIN wkts AS w ON w.bowler = r.bowler
    WHERE w.wickets > 0
)
SELECT p.player_name,
       a.avg_runs_per_wicket
FROM averages AS a
JOIN player AS p ON p.player_id = a.bowler
ORDER BY a.avg_runs_per_wicket ASC
LIMIT 1;
```

Run the last query and the single row it returns is the bowler with the best (lowest) bowling average in the database.
