WITH full AS (
    /* refer to query 8 for the full computation */
    SELECT wk.bowler,
           (COALESCE(rn.bat_runs,0) + COALESCE(ex.extra_runs,0)) AS runs_conceded,
           wk.wickets,
           1.0 * (COALESCE(rn.bat_runs,0) + COALESCE(ex.extra_runs,0)) / wk.wickets AS bowling_average
    FROM (
        SELECT b.bowler, COUNT(*) AS wickets
        FROM wicket_taken AS w
        JOIN ball_by_ball AS b
          ON b.match_id = w.match_id
         AND b.over_id  = w.over_id
         AND b.ball_id  = w.ball_id
         AND b.innings_no = w.innings_no
        GROUP BY b.bowler
    ) AS wk
    LEFT JOIN (
        SELECT b.bowler, SUM(bs.runs_scored) AS bat_runs
        FROM ball_by_ball AS b
        JOIN batsman_scored AS bs
          ON b.match_id = bs.match_id
         AND b.over_id  = bs.over_id
         AND b.ball_id  = bs.ball_id
         AND b.innings_no = bs.innings_no
        GROUP BY b.bowler
    ) AS rn USING(bowler)
    LEFT JOIN (
        SELECT b.bowler, SUM(er.extra_runs) AS extra_runs
        FROM ball_by_ball AS b
        JOIN extra_runs AS er
          ON b.match_id = er.match_id
         AND b.over_id  = er.over_id
         AND b.ball_id  = er.ball_id
         AND b.innings_no = er.innings_no
        WHERE er.extra_type IN ('wides','noballs')
        GROUP BY b.bowler
    ) AS ex USING(bowler)
    WHERE wk.wickets > 0
)
