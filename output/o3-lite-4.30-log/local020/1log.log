Query:
-- 10. Final answer: the bowler with the lowest bowling average among all bowlers
WITH runs AS (
    SELECT bb."bowler",
           SUM(bs."runs_scored") +
           COALESCE((
               SELECT SUM(er."extra_runs")
               FROM "extra_runs" AS er
               WHERE er."match_id"  = bb."match_id"
                 AND er."over_id"   = bb."over_id"
                 AND er."ball_id"   = bb."ball_id"
                 AND er."innings_no"= bb."innings_no"
                 AND er."extra_type" IN ('wides','noballs')
           ),0) AS run_on_ball
    FROM "ball_by_ball" AS bb
    LEFT JOIN "batsman_scored" AS bs
      ON bs."match_id" = bb."match_id"
     AND bs."over_id"  = bb."over_id"
     AND bs."ball_id"  = bb."ball_id"
     AND bs."innings_no" = bb."innings_no"
    GROUP BY bb."bowler"
), wickets AS (
    SELECT bb."bowler", COUNT(*) AS wk
    FROM "wicket_taken" AS wt
    JOIN "ball_by_ball" AS bb
      ON wt."match_id" = bb."match_id"
     AND wt."over_id"  = bb."over_id"
     AND wt."ball_id"  = bb."ball_id"
     AND wt."innings_no" = bb."innings_no"
    WHERE wt."kind_out" NOT IN ('run out')
    GROUP BY bb."bowler"
), avg_table AS (
    SELECT p."player_name",
           r."run_on_ball" AS "runs_conceded",
           w."wk"          AS "wickets",
           CAST(r."run_on_ball" AS REAL) / w."wk" AS "bowling_average"
    FROM runs AS r
    JOIN wickets AS w ON r."bowler" = w."bowler"
    JOIN "player"  AS p ON p."player_id" = r."bowler"
    WHERE w."wk" > 0
)
SELECT "player_name", ROUND("bowling_average",2) AS "bowling_average"
FROM avg_table
ORDER BY "bowling_average" ASC
LIMIT 1;
