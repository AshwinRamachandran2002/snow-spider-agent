-- 6. Combine the two previous queries to get total runs conceded
SELECT r1."bowler",
       COALESCE(r1."bat_runs",0) + COALESCE(r2."bowler_extras",0) AS "total_runs_conceded"
FROM (
    SELECT bb."bowler", SUM(bs."runs_scored") AS "bat_runs"
    FROM "ball_by_ball" AS bb
    JOIN "batsman_scored" AS bs
      ON bs."match_id" = bb."match_id"
     AND bs."over_id"  = bb."over_id"
     AND bs."ball_id"  = bb."ball_id"
     AND bs."innings_no" = bb."innings_no"
    GROUP BY bb."bowler"
) AS r1
LEFT JOIN (
    SELECT bb."bowler", SUM(er."extra_runs") AS "bowler_extras"
    FROM "ball_by_ball" AS bb
    JOIN "extra_runs"   AS er
      ON er."match_id" = bb."match_id"
     AND er."over_id"  = bb."over_id"
     AND er."ball_id"  = bb."ball_id"
     AND er."innings_no" = bb."innings_no"
    WHERE er."extra_type" IN ('wides', 'noballs')
    GROUP BY bb."bowler"
) AS r2
ON r1."bowler" = r2."bowler"
LIMIT 20;
