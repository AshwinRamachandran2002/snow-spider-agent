```sql
WITH filtered AS (   -- basic content filter
    SELECT
        "SeriesInstanceUID"                                   AS series_uid,
        "collection_name"                                     AS collection,
        "SOPInstanceUID"                                      AS sop_uid,
        -- image‑orientation components
        ("ImageOrientationPatient")[0]::FLOAT                 AS r1,
        ("ImageOrientationPatient")[1]::FLOAT                 AS r2,
        ("ImageOrientationPatient")[3]::FLOAT                 AS c1,
        ("ImageOrientationPatient")[4]::FLOAT                 AS c2,
        TO_VARCHAR("ImageOrientationPatient")                 AS iop_str,
        -- pixel spacing
        TO_VARCHAR("PixelSpacing")                            AS pixsp_str,
        -- image position (patient)
        ("ImagePositionPatient")[0]::FLOAT                    AS pos_x,
        ("ImagePositionPatient")[1]::FLOAT                    AS pos_y,
        ("ImagePositionPatient")[2]::FLOAT                    AS pos_z,
        -- exposure and matrix size
        TRY_TO_FLOAT("Exposure")                              AS exposure,
        "Rows"                                                AS n_rows,
        "Columns"                                             AS n_cols,
        -- instance payload size
        "instance_size"                                       AS inst_size
    FROM   "IDC"."IDC_V17"."DICOM_ALL"
    WHERE  "Modality" = 'CT'
      AND  "collection_name" <> 'NLST'                                       -- drop NLST
      AND  "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70',             -- drop JPEG
                                       '1.2.840.10008.1.2.4.51')
      AND ( "ImageType" IS NULL OR NOT ("ImageType" ILIKE '%LOCALIZER%') )    -- drop localizers
),
series_qc AS (      -- geometry & consistency checks per series
    SELECT
        series_uid,
        collection,
        /*  z‑component of row×col ( r1*c2 – r2*c1 )  */
        ABS( MIN(r1)*MIN(c2) - MIN(r2)*MIN(c1) )           AS dot_z,
        COUNT(*)                                           AS num_images,
        COUNT(DISTINCT iop_str)                            AS n_iop,
        COUNT(DISTINCT pixsp_str)                          AS n_pixsp,
        COUNT(DISTINCT n_rows)                             AS n_rows_vals,
        COUNT(DISTINCT n_cols)                             AS n_cols_vals,
        COUNT(DISTINCT TO_VARCHAR(pos_z))                  AS n_pos_z,
        COUNT(DISTINCT TO_VARCHAR(pos_x))                  AS n_pos_x,
        COUNT(DISTINCT TO_VARCHAR(pos_y))                  AS n_pos_y,
        SUM(inst_size)                                     AS total_bytes
    FROM   filtered
    GROUP  BY series_uid, collection
    HAVING
            dot_z BETWEEN 0.99 AND 1.01        -- near‑orthogonal orientation
        AND n_iop      = 1                     -- identical orientation
        AND n_pixsp    = 1                     -- identical pixel spacing
        AND n_rows_vals = 1 AND n_cols_vals = 1               -- identical matrix
        AND n_pos_x = 1    AND n_pos_y = 1                     -- identical (x,y)
        AND num_images = n_pos_z                              -- image count = z positions
),
z_diffs AS (        -- slice‑spacing per series
    SELECT
        f.series_uid,
        ABS( pos_z
           - LAG(pos_z) OVER (PARTITION BY f.series_uid ORDER BY pos_z)
        ) AS z_diff
    FROM   filtered f
    JOIN   series_qc s  ON s.series_uid = f.series_uid
),
z_stats AS (
    SELECT
        series_uid,
        AVG(z_diff)                              AS mean_slice_interval_mm,
        MAX(z_diff) - MIN(z_diff)                AS diff_slice_interval_mm
    FROM   z_diffs
    WHERE  z_diff IS NOT NULL
    GROUP  BY series_uid
),
exp_stats AS (      -- exposure statistics
    SELECT
        f.series_uid,
        AVG(exposure)                            AS mean_exposure_mAs,
        MAX(exposure) - MIN(exposure)            AS diff_exposure_mAs
    FROM   filtered f
    JOIN   series_qc s  ON s.series_uid = f.series_uid
    WHERE  exposure IS NOT NULL
    GROUP  BY f.series_uid
)
SELECT
    s.series_uid                         AS series_instance_uid,
    s.collection,
    s.num_images                         AS num_images,
    z.mean_slice_interval_mm,
    z.diff_slice_interval_mm,
    e.mean_exposure_mAs,
    e.diff_exposure_mAs,
    ROUND( s.total_bytes / (1024*1024), 3)  AS series_size_mb
FROM   series_qc  s
LEFT   JOIN z_stats  z ON z.series_uid = s.series_uid
LEFT   JOIN exp_stats e ON e.series_uid = s.series_uid
ORDER  BY z.diff_slice_interval_mm DESC NULLS LAST,
          e.diff_exposure_mAs      DESC NULLS LAST,
          s.series_uid             DESC;
```
