-- 10) Near‑final query – gathers all requested metrics, applies geometry & QC filters, and sorts by tolerance / exposure range / UID
WITH filtered AS (   -- basic content filter
    SELECT
        "SeriesInstanceUID",
        "SeriesNumber",
        "StudyInstanceUID",
        "PatientID",
        ("ImageOrientationPatient")[0]::FLOAT AS r1,
        ("ImageOrientationPatient")[1]::FLOAT AS r2,
        ("ImageOrientationPatient")[2]::FLOAT AS r3,
        ("ImageOrientationPatient")[3]::FLOAT AS c1,
        ("ImageOrientationPatient")[4]::FLOAT AS c2,
        ("ImageOrientationPatient")[5]::FLOAT AS c3,
        TO_VARCHAR("PixelSpacing")                 AS pix_spc_str,
        ("ImagePositionPatient")[0]::FLOAT         AS pos_x,
        ("ImagePositionPatient")[1]::FLOAT         AS pos_y,
        ("ImagePositionPatient")[2]::FLOAT         AS pos_z,
        TRY_TO_FLOAT("SliceThickness")             AS slice_thk,
        TRY_TO_FLOAT("Exposure")                   AS exposure_val,
        "Rows"                                     AS rows_val,
        "Columns"                                  AS cols_val,
        "instance_size"
    FROM "IDC"."IDC_V17"."DICOM_ALL"
    WHERE "Modality" = 'CT'
      AND "collection_name" <> 'NLST'
      AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70','1.2.840.10008.1.2.4.51')
      AND ( "ImageType" IS NULL OR NOT ("ImageType" ILIKE '%LOCALIZER%') )
)
, per_series AS (    -- tests that everything is internally consistent
    SELECT
        "SeriesInstanceUID",
        MAX("SeriesNumber")      AS "SeriesNumber",
        MAX("StudyInstanceUID")  AS "StudyInstanceUID",
        MAX("PatientID")         AS "PatientID",
        ABS( MIN(r1)*MIN(c2) - MIN(r2)*MIN(c1) )  AS dot_prod,
        COUNT(*)                 AS sop_cnt,
        COUNT(DISTINCT TO_VARCHAR(pos_z))         AS distinct_z,
        COUNT(DISTINCT pix_spc_str)               AS distinct_pix_spc,
        COUNT(DISTINCT rows_val)                  AS distinct_rows,
        COUNT(DISTINCT cols_val)                  AS distinct_cols,
        COUNT(DISTINCT slice_thk)                 AS distinct_thk,
        SUM("instance_size")/(1024*1024)          AS series_mib
    FROM   filtered
    GROUP  BY "SeriesInstanceUID"
    HAVING
          dot_prod BETWEEN 0.99 AND 1.01                    -- geometric alignment
      AND distinct_pix_spc = 1                              -- unique pixel spacing
      AND sop_cnt = distinct_z                              -- SOP count equals slice count
      AND distinct_rows = 1 AND distinct_cols = 1           -- constant matrix size
)
, z_diffs AS (
    SELECT  f."SeriesInstanceUID",
            ABS(pos_z - LAG(pos_z) OVER (PARTITION BY f."SeriesInstanceUID" ORDER BY pos_z)) AS z_diff
    FROM    filtered f
    JOIN    per_series p
      ON    p."SeriesInstanceUID" = f."SeriesInstanceUID"
)
, z_stats AS (
    SELECT  "SeriesInstanceUID",
            MAX(z_diff)                       AS max_z_diff,
            MIN(z_diff)                       AS min_z_diff,
            MAX(z_diff) - MIN(z_diff)         AS tol_z_diff
    FROM    z_diffs
    GROUP  BY "SeriesInstanceUID"
)
, exp_stats AS (
    SELECT  f."SeriesInstanceUID",
            COUNT(DISTINCT exposure_val)      AS num_exp_vals,
            MAX(exposure_val)                 AS max_exposure,
            MIN(exposure_val)                 AS min_exposure,
            MAX(exposure_val) - MIN(exposure_val) AS diff_exposure
    FROM    filtered f
    JOIN    per_series p
      ON    p."SeriesInstanceUID" = f."SeriesInstanceUID"
    GROUP  BY f."SeriesInstanceUID"
)
SELECT
    p."SeriesInstanceUID"                                                AS "series_uid",      -- #1
    p."SeriesNumber"                                                     AS "series_number",   -- #2
    p."StudyInstanceUID"                                                 AS "study_uid",       -- #3
    p."PatientID"                                                        AS "patient_id",      -- #4
    p.dot_prod                                                           AS "max_dot",         -- #5
    p.sop_cnt                                                            AS "num_sop",         -- #6
    p.distinct_thk                                                       AS "num_slice_thk",   -- #7
    z.max_z_diff                                                         AS "max_delta_z",     -- #8
    z.min_z_diff                                                         AS "min_delta_z",     -- #8
    z.tol_z_diff                                                         AS "delta_z_tol",     -- #9
    e.num_exp_vals                                                       AS "num_exposure_vals",--#10
    e.max_exposure                                                       AS "max_exposure",    -- #11
    e.min_exposure                                                       AS "min_exposure",    -- #11
    e.diff_exposure                                                      AS "exposure_range",  -- #12
    p.series_mib                                                         AS "series_mib"       -- #13
FROM   per_series  p
JOIN   z_stats     z  ON z."SeriesInstanceUID" = p."SeriesInstanceUID"
JOIN   exp_stats   e  ON e."SeriesInstanceUID" = p."SeriesInstanceUID"
ORDER  BY z.tol_z_diff  DESC NULLS LAST,
          e.diff_exposure DESC NULLS LAST,
          p."SeriesInstanceUID" DESC
LIMIT 20;
