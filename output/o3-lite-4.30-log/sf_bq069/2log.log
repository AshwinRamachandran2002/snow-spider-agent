--Description: Build a QC‑passed CT‑series report in one statement.
-- The “thinking process” is embedded as inline comments beside each step/CTE.
WITH
/* ------------------------------------------------------------------
   1. Filter raw CT slices:
      • CT modality
      • NOT NLST collection
      • NOT JPEG (two transfer syntaxes)
      • NOT LOCALIZER ImageType
      • Gather only attributes required downstream
------------------------------------------------------------------ */
filtered AS (
    SELECT
        "SeriesInstanceUID",
        "SeriesNumber",
        "StudyInstanceUID",
        "PatientID",
        ("ImageOrientationPatient")[0]::FLOAT AS r1,
        ("ImageOrientationPatient")[1]::FLOAT AS r2,
        ("ImageOrientationPatient")[2]::FLOAT AS r3,
        ("ImageOrientationPatient")[3]::FLOAT AS c1,
        ("ImageOrientationPatient")[4]::FLOAT AS c2,
        ("ImageOrientationPatient")[5]::FLOAT AS c3,
        TO_VARCHAR("PixelSpacing")            AS pix_spc_str,
        ("ImagePositionPatient")[2]::FLOAT    AS pos_z,
        TRY_TO_NUMBER("SliceThickness")       AS slice_thk,
        TRY_TO_NUMBER("Exposure")             AS exposure_val,
        "Rows"                                AS rows_val,
        "Columns"                             AS cols_val,
        "instance_size"
    FROM   "IDC"."IDC_V17"."DICOM_ALL"
    WHERE  "Modality" = 'CT'
       AND "collection_name" <> 'NLST'
       AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70',
                                       '1.2.840.10008.1.2.4.51')
       AND ( "ImageType" IS NULL OR NOT ("ImageType" ILIKE '%LOCALIZER%') )
),
/* ------------------------------------------------------------------
   2. per_series: aggregate by SeriesInstanceUID and **apply QC rules**
      • dot_prod ≈ 1  (orientation check)
      • single pixel spacing
      • SOP count equals distinct Z positions
      • constant Rows / Columns
------------------------------------------------------------------ */
per_series AS (
    SELECT
        "SeriesInstanceUID",
        MAX("SeriesNumber")      AS series_number,
        MAX("StudyInstanceUID")  AS study_uid,
        MAX("PatientID")         AS patient_id,
        ABS( MIN(r1)*MIN(c2) - MIN(r2)*MIN(c1) )                 AS dot_prod,
        COUNT(*)                                                   AS sop_cnt,
        COUNT(DISTINCT TO_VARCHAR(pos_z))                          AS distinct_z,
        COUNT(DISTINCT pix_spc_str)                                AS distinct_pix_spc,
        COUNT(DISTINCT rows_val)                                   AS distinct_rows,
        COUNT(DISTINCT cols_val)                                   AS distinct_cols,
        COUNT(DISTINCT slice_thk)                                  AS num_slice_thk,
        SUM("instance_size")/1048576                               AS series_mib   -- bytes→MiB
    FROM   filtered
    GROUP  BY "SeriesInstanceUID"
    HAVING dot_prod BETWEEN 0.99 AND 1.01
       AND distinct_pix_spc = 1
       AND sop_cnt = distinct_z
       AND distinct_rows = 1
       AND distinct_cols = 1
),
/* ------------------------------------------------------------------
   3. z_diffs + z_stats: calculate slice interval Δz statistics
------------------------------------------------------------------ */
z_diffs AS (
    SELECT
        f."SeriesInstanceUID",
        ABS(pos_z - LAG(pos_z)
            OVER (PARTITION BY f."SeriesInstanceUID" ORDER BY pos_z)) AS z_diff
    FROM   filtered f
    JOIN   per_series p USING ("SeriesInstanceUID")
),
z_stats AS (
    SELECT
        "SeriesInstanceUID",
        MAX(z_diff)                       AS max_delta_z,
        MIN(z_diff)                       AS min_delta_z,
        MAX(z_diff) - MIN(z_diff)         AS delta_z_tol
    FROM   z_diffs
    GROUP BY "SeriesInstanceUID"
),
/* ------------------------------------------------------------------
   4. exp_stats: exposure statistics per series
------------------------------------------------------------------ */
exp_stats AS (
    SELECT
        f."SeriesInstanceUID",
        COUNT(DISTINCT exposure_val)      AS num_exposure_vals,
        MAX(exposure_val)                 AS max_exposure,
        MIN(exposure_val)                 AS min_exposure,
        MAX(exposure_val) - MIN(exposure_val) AS exposure_range
    FROM   filtered f
    JOIN   per_series p USING ("SeriesInstanceUID")
    GROUP  BY f."SeriesInstanceUID"
)
/* ------------------------------------------------------------------
   5. Final selection: deliver 13 requested fields
      and order by tolerance, exposure range, UID (all DESC)
------------------------------------------------------------------ */
SELECT
    p."SeriesInstanceUID"   AS series_uid,      -- (1) UID
    p.series_number,                            -- (2) SeriesNumber
    p.study_uid,                                -- (3) Study UID
    p.patient_id,                               -- (4) Patient ID
    p.dot_prod            AS max_dot,           -- (5) dot‑product
    p.sop_cnt             AS num_sop,           -- (6) SOP count
    p.num_slice_thk       AS num_slice_thk,     -- (7) distinct slice thk
    z.max_delta_z,                              -- (8a) max Δz
    z.min_delta_z,                              -- (8b) min Δz
    z.delta_z_tol,                              -- (9)  tolerance
    e.num_exposure_vals,                        -- (10) exposure count
    e.max_exposure,                             -- (11a) max exposure
    e.min_exposure,                             -- (11b) min exposure
    e.exposure_range,                           -- (12) exposure range
    p.series_mib                               -- (13) size MiB
FROM   per_series p
JOIN   z_stats   z USING ("SeriesInstanceUID")
JOIN   exp_stats e USING ("SeriesInstanceUID")
ORDER  BY z.delta_z_tol DESC NULLS LAST,
          e.exposure_range DESC NULLS LAST,
          series_uid DESC
LIMIT 20;   -- remove limit for full dataset
