--🔟  Description: Quick view of exposure stats & total size (MiB) for CT series.
SELECT "SeriesInstanceUID",
       COUNT(DISTINCT "Exposure")                        AS "distinct_exposure",
       MIN(TRY_TO_NUMBER("Exposure"))                    AS "min_exposure",
       MAX(TRY_TO_NUMBER("Exposure"))                    AS "max_exposure",
       (MAX(TRY_TO_NUMBER("Exposure")) - MIN(TRY_TO_NUMBER("Exposure"))) AS "exp_range",
       ROUND(SUM("instance_size") / 1048576, 2)          AS "series_size_MiB"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
GROUP BY "SeriesInstanceUID"
LIMIT 20;
