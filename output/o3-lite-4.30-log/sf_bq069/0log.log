/*  -----------------------------------------------------------
    CT series quality report  (Snowflake SQL)

    – excludes NLST collection
    – keeps CT only, skips JPEG‑compressed & LOCALIZER series
    – applies all requested geometry / consistency filters
    – returns the metrics required by the specification
   ----------------------------------------------------------- */
WITH filtered AS (   -- ❶  row‑level pre‑filter
    SELECT
        "SeriesInstanceUID"              AS series_uid ,
        "SeriesNumber"                   AS series_number ,
        "StudyInstanceUID"               AS study_uid ,
        "PatientID"                      AS patient_id ,
        TRY_TO_NUMBER("Exposure")        AS exposure_num ,
        TRY_TO_NUMBER("SliceThickness")  AS slice_thickness ,
        "instance_size"                  AS instance_size ,
        /* dot‑product of cross(row‑vec , col‑vec) with k‑unit‑vec */
        (   ("ImageOrientationPatient"[0]::FLOAT * "ImageOrientationPatient"[4]::FLOAT)
          - ("ImageOrientationPatient"[1]::FLOAT * "ImageOrientationPatient"[3]::FLOAT)
        )                                AS dot_k ,
        "ImageOrientationPatient"::STRING AS orient_str ,
        "PixelSpacing"::STRING            AS px_spacing_str ,
        "Rows"                             AS rows_cnt ,
        "Columns"                          AS cols_cnt ,
        "ImagePositionPatient"::STRING     AS ipp_str ,
        "ImagePositionPatient"[0]::STRING  AS ipp_x_str ,
        "ImagePositionPatient"[1]::STRING  AS ipp_y_str ,
        "ImagePositionPatient"[2]::FLOAT   AS ipp_z
    FROM IDC.IDC_V17.DICOM_ALL
    WHERE "Modality" = 'CT'
      AND "collection_name" <> 'NLST'
      AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70',
                                      '1.2.840.10008.1.2.4.51')
      AND (UPPER("ImageType"::STRING) NOT ILIKE '%LOCALIZER%')
),
with_spacing AS (    -- ❷  add per‑slice z‑spacing
    SELECT
        f.*,
        ABS( f.ipp_z 
           - LAG(f.ipp_z) OVER (PARTITION BY series_uid ORDER BY f.ipp_z)
        )                                AS z_spacing
    FROM filtered f
),
series_agg AS (      -- ❸  collect series‑level metrics and quality counters
    SELECT
        series_uid,
        MAX(series_number)                         AS series_number,
        MAX(study_uid)                             AS study_uid,
        MAX(patient_id)                            AS patient_id,

        /* geometry verification helpers */
        COUNT(DISTINCT orient_str)                 AS distinct_orient,
        COUNT(DISTINCT px_spacing_str)             AS distinct_px_spacing,
        COUNT(DISTINCT rows_cnt)                   AS distinct_rows,
        COUNT(DISTINCT cols_cnt)                   AS distinct_cols,
        COUNT(*)                                   AS sop_cnt,
        COUNT(DISTINCT ipp_str)                    AS ipp_distinct,
        COUNT(DISTINCT (ipp_x_str||'|'||ipp_y_str))AS xy_distinct,
        MAX(ABS(dot_k))                            AS max_dot_k,

        /* requested report figures */
        COUNT(DISTINCT slice_thickness)            AS n_slice_thk,
        MIN(z_spacing)                             AS min_z_spacing,
        MAX(z_spacing)                             AS max_z_spacing,
        (MAX(z_spacing) - MIN(z_spacing))          AS tol_z_spacing,

        COUNT(DISTINCT exposure_num)               AS n_exposure,
        MIN(exposure_num)                          AS min_exposure,
        MAX(exposure_num)                          AS max_exposure,
        (MAX(exposure_num) - MIN(exposure_num))    AS diff_exposure,

        ROUND(SUM(instance_size)/1048576 , 2)      AS series_size_mib
    FROM with_spacing
    GROUP BY series_uid
),
qualified AS (       -- ❹  apply all series‑level quality filters
    SELECT *
    FROM series_agg
    WHERE distinct_orient      = 1
      AND distinct_px_spacing  = 1
      AND distinct_rows        = 1
      AND distinct_cols        = 1
      AND sop_cnt              = ipp_distinct
      AND xy_distinct          = 1
      AND max_dot_k BETWEEN 0.99 AND 1.01
)
SELECT
    series_uid                                AS series_instance_uid,
    series_number,
    study_uid                                 AS study_instance_uid,
    patient_id,
    max_dot_k                                 AS max_dot_product_k,
    sop_cnt                                   AS num_sop_instances,
    n_slice_thk                               AS distinct_slice_thickness_cnt,
    max_z_spacing                             AS max_slice_interval_mm,
    min_z_spacing                             AS min_slice_interval_mm,
    tol_z_spacing                             AS slice_interval_tolerance_mm,
    n_exposure                                AS distinct_exposure_cnt,
    max_exposure                              AS max_exposure_value,
    min_exposure                              AS min_exposure_value,
    diff_exposure                             AS exposure_range,
    series_size_mib                           AS series_size_mib
FROM qualified
ORDER BY
      slice_interval_tolerance_mm DESC NULLS LAST,
      diff_exposure               DESC NULLS LAST,
      series_instance_uid         DESC;
