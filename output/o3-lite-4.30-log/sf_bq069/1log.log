```sql
--Description: 7) Count how many different “SliceThickness” values exist
--             inside each CT series.  A well‑behaved axial stack usually
--             has exactly one value.  Sorting by that count (DESC) puts the
--             odd series – with 2, 3, … thicknesses – on top.
SELECT
    "SeriesInstanceUID",
    COUNT(DISTINCT "SliceThickness") AS "distinct_thickness_vals"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
GROUP BY "SeriesInstanceUID"
ORDER BY "distinct_thickness_vals" DESC
LIMIT 20;
```

```sql
--Description: 8) Examine positional consistency of the first two components
--             (x and y) of "ImagePositionPatient" for each CT series.
--             Instead of filtering with a HAVING clause (which could yield
--             no rows) we compute “distinct_x” and “distinct_y”, then
--             derive a simple variation score that lets us see which series
--             violate the “all slices share same x,y” rule.  A score of 0
--             means perfect consistency.
SELECT
    "SeriesInstanceUID",
    MIN(TO_VARCHAR("ImagePositionPatient")) AS "sample_first_pos",
    COUNT(DISTINCT SPLIT_PART(TO_VARCHAR("ImagePositionPatient"), ',', 1)) AS "distinct_x",
    COUNT(DISTINCT SPLIT_PART(TO_VARCHAR("ImagePositionPatient"), ',', 2)) AS "distinct_y",
    (  COUNT(DISTINCT SPLIT_PART(TO_VARCHAR("ImagePositionPatient"), ',', 1))
     +COUNT(DISTINCT SPLIT_PART(TO_VARCHAR("ImagePositionPatient"), ',', 2)) ) AS "pos_variation_score"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
GROUP BY "SeriesInstanceUID"
ORDER BY "pos_variation_score" DESC, "SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 9) Rough picture of z‑span per CT series.  Extract the third
--             coordinate (z) from "ImagePositionPatient", compute the total
--             span (max‑min) and the slice count.  Sorting by span shows the
--             thickest anatomical ranges first.
WITH z AS (
  SELECT
      "SeriesInstanceUID",
      CAST(SPLIT_PART(TO_VARCHAR("ImagePositionPatient"), ',', 3) AS FLOAT) AS zpos
  FROM IDC.IDC_V17.DICOM_ALL
  WHERE "Modality" = 'CT'
)
SELECT
    "SeriesInstanceUID",
    MAX(zpos) - MIN(zpos) AS "total_z_span",
    COUNT(*)              AS "slices_in_series"
FROM z
GROUP BY "SeriesInstanceUID"
ORDER BY "total_z_span" DESC
LIMIT 20;
```

```sql
--Description: 10) Preview exposure variability and approximate size for each
--              CT series.  Shows how many different "Exposure" values occur,
--              their min/max, the resulting range, and the summed byte size
--              in MiB.  Sorted by exposure_range so the most variable series
--              appear first.
SELECT
    "SeriesInstanceUID",
    COUNT(DISTINCT "Exposure")              AS "distinct_exposure_vals",
    MIN(CAST("Exposure" AS FLOAT))          AS "min_exposure",
    MAX(CAST("Exposure" AS FLOAT))          AS "max_exposure",
    MAX(CAST("Exposure" AS FLOAT)) -
    MIN(CAST("Exposure" AS FLOAT))          AS "exposure_range",
    ROUND(SUM("instance_size") / 1048576, 2) AS "series_size_MiB"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "Exposure" IS NOT NULL
GROUP BY "SeriesInstanceUID"
ORDER BY "exposure_range" DESC
LIMIT 20;
```
