--Description:
-- Purpose: sanity‑check CT data integrity by comparing the total number of
--          rows stored for each series with the number of DISTINCT
--          "SOPInstanceUID" values those rows contain.  Any difference
--          indicates duplicate rows for at least one SOP instance.
-- Steps / reasoning
--   • Filter to CT modality only (task domain).
--   • GROUP BY "SeriesInstanceUID" so each series is collapsed to one row.
--   • COUNT(*) gives the raw row count; COUNT(DISTINCT ...) gives unique images.
--   • Compute their difference as "dup_row_delta" to highlight issues.
--   • ORDER BY the difference first (descending) so problematic series rise
--     to the top, then by total rows just for additional context.
--   • LIMIT 20 keeps the result set bite‑sized for manual inspection.
SELECT
    "SeriesInstanceUID",
    COUNT(*)                          AS "rows_in_table",
    COUNT(DISTINCT "SOPInstanceUID")  AS "unique_instances",
    COUNT(*) - COUNT(DISTINCT "SOPInstanceUID") AS "dup_row_delta"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
GROUP BY "SeriesInstanceUID"
ORDER BY "dup_row_delta" DESC, "rows_in_table" DESC
LIMIT 20;
```
