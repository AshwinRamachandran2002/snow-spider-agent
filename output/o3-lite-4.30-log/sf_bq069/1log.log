```sql
--Description:
-- Robust preview of exposure variability and series size for CT data.
-- “Exposure” occasionally carries quotes/brackets that break a plain CAST,
-- so we sanitise it first, then use TRY_TO_NUMBER to avoid errors
-- (values that still fail to convert become NULL and are ignored in min/max).
-- Steps:
--   1.  In CTE e, keep CT rows where "Exposure" is not NULL.
--   2.  Convert "Exposure" VARIANT → VARCHAR → strip [, ], " via REGEXP_REPLACE.
--   3.  TRY_TO_NUMBER(...) converts the cleaned string to FLOAT (NULL on failure).
--   4.  Aggregate per "SeriesInstanceUID":
--        • distinct_exposure_vals – number of different numeric exposures
--        • min_exposure / max_exposure – numeric range (ignoring NULLs)
--        • exposure_range – max‑min
--        • series_size_MiB – sum(instance_size) ÷ 1 048 576
--   5.  ORDER BY exposure_range DESC (most variable first) and limit to 20.
WITH e AS (
    SELECT
        "SeriesInstanceUID",
        TRY_TO_NUMBER(
            REGEXP_REPLACE(
                TO_VARCHAR("Exposure"),
                '[\\[\\]\"]',    -- remove brackets & quotes
                ''
            )
        )                 AS exposure_val,
        "instance_size"
    FROM IDC.IDC_V17.DICOM_ALL
    WHERE "Modality" = 'CT'
      AND "Exposure" IS NOT NULL
)
SELECT
    "SeriesInstanceUID",
    COUNT(DISTINCT exposure_val)                   AS "distinct_exposure_vals",
    MIN(exposure_val)                              AS "min_exposure",
    MAX(exposure_val)                              AS "max_exposure",
    MAX(exposure_val) - MIN(exposure_val)          AS "exposure_range",
    ROUND(SUM("instance_size") / 1048576, 2)       AS "series_size_MiB"
FROM e
GROUP BY "SeriesInstanceUID"
ORDER BY "exposure_range" DESC, "SeriesInstanceUID"
LIMIT 20;
```
