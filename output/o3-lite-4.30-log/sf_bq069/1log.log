    /* geometry & consistency filters applied at series level */
    SELECT
        series_uid,
        COUNT(*)                             AS num_imgs ,
        COUNT(DISTINCT ps_clean)             AS ps_variants ,
        MAX(ABS(dp_abs - 1))                 AS max_dp_delta ,
        COUNT(DISTINCT n_rows)               AS row_variants ,
        COUNT(DISTINCT n_cols)               AS col_variants ,
        COUNT(DISTINCT TO_VARCHAR(x_pos))    AS x_variants ,
        COUNT(DISTINCT TO_VARCHAR(y_pos))    AS y_variants ,
        COUNT(DISTINCT TO_VARCHAR(z_pos))    AS z_variants
    FROM with_dp
    GROUP BY series_uid
    HAVING
          ps_variants  = 1
      AND row_variants = 1
      AND col_variants = 1
      AND x_variants   = 1
      AND y_variants   = 1
      AND z_variants   = num_imgs          -- #IPP = #instances
      AND max_dp_delta <= 0.01             -- |dot‑product – 1| ≤ 0.01
), final AS (     ------------------------------------------------------------------
    /* compute all requested metrics for series that passed geo checks */
    SELECT
        g.series_uid                                AS series_instance_uid ,
        MAX(z.series_number)                        AS series_number ,
        MAX(z.study_uid)                            AS study_instance_uid ,
        MAX(z.patient_id)                           AS patient_id ,

        MAX(z.dp_abs)                               AS max_dp_value ,

        g.num_imgs                                  AS num_images ,

        COUNT(DISTINCT z.slice_thickness)           AS distinct_slice_thickness ,

        /* slice interval (z‑spacing) */
        MAX( ABS(z.z_pos - z.prev_z) )              AS max_slice_interval_mm ,
        MIN( ABS(z.z_pos - z.prev_z) )              AS min_slice_interval_mm ,
        MAX( ABS(z.z_pos - z.prev_z) )
        - MIN( ABS(z.z_pos - z.prev_z) )            AS slice_interval_tolerance_mm ,

        /* exposure variation */
        COUNT(DISTINCT z.exposure_val)              AS distinct_exposure_vals ,
        MAX(z.exposure_val)                         AS max_exposure ,
        MIN(z.exposure_val)                         AS min_exposure ,
        MAX(z.exposure_val) - MIN(z.exposure_val)   AS exposure_range ,

        /* total series size */
        ROUND( SUM(z.instance_size) / 1048576 , 2 ) AS series_size_mb
    FROM geo_pass g
    JOIN zdiff z
      ON g.series_uid = z.series_uid
    WHERE z.prev_z IS NOT NULL                      -- exclude first‑slice NULL diff
    GROUP BY g.series_uid , g.num_imgs
)
SELECT
    series_instance_uid ,
    series_number ,
    study_instance_uid ,
    patient_id ,
    max_dp_value ,
    num_images ,
