Query:
--Description: 7) Count how many different “SliceThickness” values exist
--             inside each CT series.  A well‑behaved axial stack usually
--             has exactly one value.  Sorting by that count (DESC) puts the
--             odd series – with 2, 3, … thicknesses – on top.
SELECT
    "SeriesInstanceUID",
    COUNT(DISTINCT "SliceThickness") AS "distinct_thickness_vals"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
GROUP BY "SeriesInstanceUID"
ORDER BY "distinct_thickness_vals" DESC
LIMIT 20
