Query:
--Description:
-- Revised “exposure variability & series size” explorer that avoids CAST
-- errors arising from quote / bracket clutter in "Exposure".
-- Strategy
--   ①  In CTE e, keep CT rows whose "Exposure" is not NULL.
--   ②  Convert the VARIANT to VARCHAR, then strip [, ], and " characters
--       via REGEXP_REPLACE.  TRY_TO_NUMBER() converts the cleaned string to
--       numeric; malformed strings become NULL (and later ignored by MIN/MAX).
--   ③  Aggregate per "SeriesInstanceUID":
--         • distinct_exposure_vals  – how many different numeric exposures
--         • min_exposure / max_exposure  – extremes of those values
--         • exposure_range          – max − min
--         • series_size_MiB         – Σ(instance_size) ÷ 1 048 576
--   ④  Sort by exposure_range (DESC) so the most variable series are on top,
--       then limit to 20 rows for a concise preview.
WITH e AS (
    SELECT
        "SeriesInstanceUID",
        TRY_TO_NUMBER(
            REGEXP_REPLACE(
                TO_VARCHAR("Exposure"),
                '[\\[\\]\"]',      -- strip brackets & quotes
                ''
            )
        )        AS exposure_val,
        "instance_size"
    FROM IDC.IDC_V17.DICOM_ALL
    WHERE "Modality" = 'CT'
      AND "Exposure" IS NOT NULL
)
SELECT
    "SeriesInstanceUID",
    COUNT(DISTINCT exposure_val)                  AS "distinct_exposure_vals",
    MIN(exposure_val)                             AS "min_exposure",
    MAX(exposure_val)                             AS "max_exposure",
    MAX(exposure_val) - MIN(exposure_val)         AS "exposure_range",
    ROUND(SUM("instance_size") / 1048576, 2)      AS "series_size_MiB"
FROM e
GROUP BY "SeriesInstanceUID"
ORDER BY "exposure_range" DESC, "SeriesInstanceUID"
LIMIT 20
