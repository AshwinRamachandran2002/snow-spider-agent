/*  ------------------------------------------------------------
    CT‑Series QA Report (non‑NLST, non‑JPEG, non‑localizer)

    Geometry, dose and size checks implemented exactly as requested.
    ------------------------------------------------------------  */
WITH base AS (   -----------------------------------------------------------------
    SELECT
        /* identifiers */
        "SeriesInstanceUID"                      AS series_uid ,
        "SeriesNumber"                           AS series_number ,
        "StudyInstanceUID"                       AS study_uid ,
        "PatientID"                              AS patient_id ,

        /* raw DICOM attributes that will be parsed */
        TO_VARCHAR("ImageOrientationPatient")    AS iop_raw ,
        TO_VARCHAR("PixelSpacing")               AS ps_raw ,
        TO_VARCHAR("ImagePositionPatient")       AS ipp_raw ,
        "Rows"                                   AS n_rows ,
        "Columns"                                AS n_cols ,
        "SliceThickness"                         AS slice_thickness ,
        REGEXP_REPLACE(TO_VARCHAR("Exposure"), '[\\[\\]\"]' , '' )  AS exposure_str ,
        "instance_size"                          AS instance_size

    FROM IDC.IDC_V17.DICOM_ALL
    WHERE  "Modality"              =  'CT'
      AND  "collection_name"       <> 'NLST'
      AND  "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70','1.2.840.10008.1.2.4.51')
      AND ( "ImageType" IS NULL OR TO_VARCHAR("ImageType") NOT ILIKE '%LOCALIZER%' )
), parsed AS (   ------------------------------------------------------------------
    /* strip brackets / quotes so SPLIT_PART works cleanly */
    SELECT  *,
        REGEXP_REPLACE(iop_raw , '[\\[\\]\"]' , '' )           AS iop_clean ,
        REGEXP_REPLACE(ps_raw  , '[\\[\\]\"]' , '' )           AS ps_clean ,
        REGEXP_REPLACE(ipp_raw , '[\\[\\]\"]' , '' )           AS ipp_clean
    FROM base
), numbers AS (   ------------------------------------------------------------------
    /* convert the comma‑separated strings to numeric values */
    SELECT
        series_uid,
        series_number,
        study_uid,
        patient_id,
        ps_clean,
        ipp_clean,
        n_rows,
        n_cols,
        slice_thickness,
        TRY_TO_DOUBLE(exposure_str)                 AS exposure_val,
        instance_size,

        /* six orientation numbers */
        TRY_TO_DOUBLE( SPLIT_PART(iop_clean, ',', 1) ) AS a ,
        TRY_TO_DOUBLE( SPLIT_PART(iop_clean, ',', 2) ) AS b ,
        TRY_TO_DOUBLE( SPLIT_PART(iop_clean, ',', 3) ) AS c ,
        TRY_TO_DOUBLE( SPLIT_PART(iop_clean, ',', 4) ) AS d ,
        TRY_TO_DOUBLE( SPLIT_PART(iop_clean, ',', 5) ) AS e ,
        TRY_TO_DOUBLE( SPLIT_PART(iop_clean, ',', 6) ) AS f ,

        /* three position numbers */
        TRY_TO_DOUBLE( SPLIT_PART(ipp_clean, ',', 1) ) AS x_pos ,
        TRY_TO_DOUBLE( SPLIT_PART(ipp_clean, ',', 2) ) AS y_pos ,
        TRY_TO_DOUBLE( SPLIT_PART(ipp_clean, ',', 3) ) AS z_pos
    FROM parsed
), with_dp AS (   ------------------------------------------------------------------
    /* dot product |(IOP₁ × IOP₂)·[0,0,1]|  =  |a·e − b·d| */
    SELECT
        *,
        ABS( (a*e) - (b*d) )                       AS dp_abs
    FROM numbers
), zdiff AS (     ------------------------------------------------------------------
    /* difference between consecutive z‑positions inside each series */
    SELECT
        series_uid,
        series_number,
        study_uid,
        patient_id,
        z_pos,
        LAG(z_pos)  OVER (PARTITION BY series_uid ORDER BY z_pos)     AS prev_z,
        exposure_val,
        slice_thickness,
        n_rows,
        n_cols,
        ps_clean,
        dp_abs,
        x_pos,
        y_pos,
        instance_size
    FROM with_dp
), geo_pass AS (   ------------------------------------------------------------------
    /* geometry & consistency filters applied at series level */
    SELECT
        series_uid,
        COUNT(*)                             AS num_imgs ,
        COUNT(DISTINCT ps_clean)             AS ps_variants ,
        MAX(ABS(dp_abs - 1))                 AS max_dp_delta ,
        COUNT(DISTINCT n_rows)               AS row_variants ,
        COUNT(DISTINCT n_cols)               AS col_variants ,
        COUNT(DISTINCT TO_VARCHAR(x_pos))    AS x_variants ,
        COUNT(DISTINCT TO_VARCHAR(y_pos))    AS y_variants ,
        COUNT(DISTINCT TO_VARCHAR(z_pos))    AS z_variants
    FROM with_dp
    GROUP BY series_uid
    HAVING
          ps_variants  = 1
      AND row_variants = 1
      AND col_variants = 1
      AND x_variants   = 1
      AND y_variants   = 1
      AND z_variants   = num_imgs          -- #IPP = #instances
      AND max_dp_delta <= 0.01             -- |dot‑product – 1| ≤ 0.01
), final AS (     ------------------------------------------------------------------
    /* compute all requested metrics for series that passed geo checks */
    SELECT
        g.series_uid                                AS series_instance_uid ,
        MAX(z.series_number)                        AS series_number ,
        MAX(z.study_uid)                            AS study_instance_uid ,
        MAX(z.patient_id)                           AS patient_id ,

        MAX(z.dp_abs)                               AS max_dp_value ,

        g.num_imgs                                  AS num_images ,

        COUNT(DISTINCT z.slice_thickness)           AS distinct_slice_thickness ,

        /* slice interval (z‑spacing) */
        MAX( ABS(z.z_pos - z.prev_z) )              AS max_slice_interval_mm ,
        MIN( ABS(z.z_pos - z.prev_z) )              AS min_slice_interval_mm ,
        MAX( ABS(z.z_pos - z.prev_z) )
        - MIN( ABS(z.z_pos - z.prev_z) )            AS slice_interval_tolerance_mm ,

        /* exposure variation */
        COUNT(DISTINCT z.exposure_val)              AS distinct_exposure_vals ,
        MAX(z.exposure_val)                         AS max_exposure ,
        MIN(z.exposure_val)                         AS min_exposure ,
        MAX(z.exposure_val) - MIN(z.exposure_val)   AS exposure_range ,

        /* total series size */
        ROUND( SUM(z.instance_size) / 1048576 , 2 ) AS series_size_mb
    FROM geo_pass g
    JOIN zdiff z
      ON g.series_uid = z.series_uid
    WHERE z.prev_z IS NOT NULL                      -- exclude first‑slice NULL diff
    GROUP BY g.series_uid , g.num_imgs
)
SELECT
    series_instance_uid ,
    series_number ,
    study_instance_uid ,
    patient_id ,
    max_dp_value ,
    num_images ,
    distinct_slice_thickness ,
    max_slice_interval_mm ,
    min_slice_interval_mm ,
    slice_interval_tolerance_mm ,
    distinct_exposure_vals ,
    max_exposure ,
    min_exposure ,
    exposure_range ,
    series_size_mb
FROM final
ORDER BY
      slice_interval_tolerance_mm DESC NULLS LAST ,
      exposure_range              DESC NULLS LAST ,
      series_instance_uid         DESC;
