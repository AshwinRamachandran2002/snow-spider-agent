-- 9) Description: Retrieve product(s) whose profit equals that minimum per month.
WITH month_min AS (
  SELECT 
    DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at" / 1000000.0)) AS "sale_month",
    MIN(pr."retail_price" - pr."cost") AS "lowest_profit"
  FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
  JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    pr
    ON pr."id" = oi."product_id"
  WHERE oi."status" = 'Complete'
    AND YEAR(TO_TIMESTAMP_NTZ(oi."created_at" / 1000000.0)) = 2020
  GROUP BY 1
)
SELECT DISTINCT
  m."sale_month",
  pr."name",
  m."lowest_profit"
FROM month_min                  m
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
  ON DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at" / 1000000.0)) = m."sale_month"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     pr
  ON pr."id" = oi."product_id"
WHERE (pr."retail_price" - pr."cost") = m."lowest_profit"
  AND oi."status" = 'Complete'
LIMIT 20;
