Query:
-- 7. Description: Show lowest‑profit product(s) for every month of 2020, side‑by‑side.
WITH profits AS (
  SELECT
    DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)) AS "month",
    p."name",
    (p."retail_price" - p."cost")                               AS "profit"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"   p
    ON p."id" = oi."product_id"
  WHERE YEAR( TO_TIMESTAMP(oi."created_at" / 1000000) ) = 2020
)
SELECT
  pr."month",
  pr."name",
  pr."profit"
FROM profits pr
JOIN (
  SELECT
    "month",
    MIN("profit") AS "min_profit"
  FROM profits
  GROUP BY "month"
) mp
  ON pr."month" = mp."month"
 AND pr."profit" = mp."min_profit"
ORDER BY pr."month"
LIMIT 20;
Answer:
month,name,profit
