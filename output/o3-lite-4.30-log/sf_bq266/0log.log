```sql
--Description / Thinking process:
-- 1) We must look only at items that actually sold in 2020, therefore:
--      • "sold_at" IS NOT NULL
--      • convert micro‑second epoch to TIMESTAMP -> keep dates between
--        2020‑01‑01 and 2020‑12‑31.
-- 2) We need profit per item → (retail_price − cost) from PRODUCTS.
-- 3) Bucket every sale into its calendar month using DATE_TRUNC('month', …).
-- 4) Per month, find the minimum profit via a window MIN().
-- 5) Use QUALIFY so we keep only the rows whose profit equals that minimum,
--    i.e. each month’s least‑profitable product(s).
-- 6) Finally return month, product name, and profit in chronological order.
SELECT
    DATE_TRUNC('month', TO_TIMESTAMP(i."sold_at" / 1e6)) AS "month_2020",
    p."name"                                            AS "product_name_with_lowest_profit",
    ROUND(p."retail_price" - p."cost", 2)               AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.INVENTORY_ITEMS i
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p
  ON i."product_id" = p."id"
WHERE i."sold_at" IS NOT NULL
  AND TO_TIMESTAMP(i."sold_at" / 1e6) BETWEEN '2020-01-01' AND '2020-12-31'
QUALIFY ROUND(p."retail_price" - p."cost", 2) =
