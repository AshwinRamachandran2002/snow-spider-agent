```sql
--Description:
-- Returns, for every month in 2020, the product(s) that recorded at least one sale
-- and had the lowest profit (retail_price − cost) among all products sold that
-- month.  Steps performed:
--   ① Filter INVENTORY_ITEMS to rows with a non‑null “sold_at” that fall in 2020.
--   ② Convert micro‑second epoch to TIMESTAMP and truncate to the month level.
--   ③ Join to PRODUCTS to obtain name, cost and retail_price.
--   ④ Calculate profit per item.
--   ⑤ Use QUALIFY with a window MIN(profit) to keep only rows whose profit
--      equals that month’s minimum.
--   ⑥ DISTINCT prevents duplicates when the same product sold multiple times
--      in that month.  Ordered chronologically.
SELECT DISTINCT
       DATE_TRUNC('month', TO_TIMESTAMP(i."sold_at" / 1e6)) AS "month_2020",
       p."name"                                            AS "product_name_with_lowest_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.INVENTORY_ITEMS i
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS        p
  ON i."product_id" = p."id"
WHERE i."sold_at" IS NOT NULL
  AND TO_TIMESTAMP(i."sold_at" / 1e6) BETWEEN '2020-01-01' AND '2020-12-31'
QUALIFY (p."retail_price" - p."cost") =
        MIN(p."retail_price" - p."cost")
        OVER (PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP(i."sold_at" / 1e6)))
ORDER BY "month_2020";
```
