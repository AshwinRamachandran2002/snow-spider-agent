FROM pizza_recipes
LIMIT 20;
```

```sql
-- 3. Look at master list of topping_id to topping_name
SELECT DISTINCT topping_id, topping_name
FROM pizza_toppings
LIMIT 20;
```

```sql
-- 4. Basic look at customer orders
SELECT *
FROM pizza_customer_orders
LIMIT 20;
```

```sql
-- 5. Inspect exclusions table (row_id, order_id mapping)
SELECT *
FROM pizza_get_exclusions
LIMIT 20;
```

```sql
-- 6. Inspect extras table (row_id, order_id mapping)
SELECT *
FROM pizza_get_extras
LIMIT 20;
```

```sql
-- 7. Join an order with its pizza name for a quick sense‑check
SELECT o.order_id,
       o.customer_id,
       n.pizza_name,
       o.exclusions,
       o.extras,
       o.order_time
FROM pizza_customer_orders AS o
JOIN pizza_names          AS n ON n.pizza_id = o.pizza_id
LIMIT 20;
```

```sql
-- 8. Combine one order with all exclusions (topping names)
SELECT e.row_id,
       e.order_id,
       t.topping_name           AS excluded_topping
FROM pizza_get_exclusions AS e
JOIN pizza_toppings       AS t ON t.topping_id = e.exclusions
ORDER BY e.row_id
LIMIT 20;
```

```sql
-- 9. Combine one order with all extras (topping names)
SELECT x.row_id,
       x.order_id,
       t.topping_name           AS extra_topping
FROM pizza_get_extras     AS x
JOIN pizza_toppings       AS t ON t.topping_id = x.extras
ORDER BY x.row_id
LIMIT 20;
```

```sql
-- 10. Prototype: pick one order (id = 1) and build its final ingredient list
WITH recipe AS (
     SELECT r.toppings AS recipe_toppings
     FROM pizza_customer_orders AS o
     JOIN pizza_recipes         AS r ON r.pizza_id = o.pizza_id
     WHERE o.order_id = 1
),
excl AS (
     SELECT GROUP_CONCAT(exclusions) AS excl
     FROM pizza_get_exclusions
     WHERE order_id = 1
),
extra AS (
     SELECT GROUP_CONCAT(extras) AS extra
     FROM pizza_get_extras
     WHERE order_id = 1
),
exploded AS (
     SELECT CAST(value AS INTEGER) AS topping_id
     FROM json_each('[' || (SELECT recipe_toppings FROM recipe) || ']')
)
SELECT DISTINCT topping_id
FROM exploded
WHERE topping_id NOT IN (SELECT CAST(value AS INTEGER) FROM json_each('['||IFNULL((SELECT excl  FROM excl), '')||']'))
UNION ALL
SELECT CAST(value AS INTEGER)
FROM json_each('['||IFNULL((SELECT extra FROM extra), '')||']')
LIMIT 20;
```

(The last query is only a proof‑of‑concept to explode recipe / exclusions / extras and will be expanded in the final production statement.)
