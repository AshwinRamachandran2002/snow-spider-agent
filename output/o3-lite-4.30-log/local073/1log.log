```sql
WITH
/* -----------------------------------------------------------
1. every individual pizza order (one row per pizza bought)
----------------------------------------------------------- */
orders AS (
    SELECT
        pc."order_id",
        pc."customer_id",
        pc."order_time",
        pc."pizza_id",
        pn."pizza_name",
        /* take row_id from the extras / exclusions tables if it exists,
           otherwise fall back to the order_id so we always have a key   */
        COALESCE(ge."row_id",
                 gx."row_id",
                 pc."order_id")           AS row_id
    FROM  "pizza_customer_orders"  pc
    JOIN  "pizza_names"            pn  ON pn."pizza_id" = pc."pizza_id"
    LEFT  JOIN "pizza_get_extras"       ge ON ge."order_id" = pc."order_id"
    LEFT  JOIN "pizza_get_exclusions"   gx ON gx."order_id" = pc."order_id"
),
/* -----------------------------------------------------------
2. default toppings that remain after any exclusions
----------------------------------------------------------- */
base_toppings AS (
    SELECT
        o.row_id, o.order_id, o.customer_id, o.order_time,
        o.pizza_name,
        CASE WHEN o.pizza_name = 'Meatlovers' THEN 1 ELSE 2 END   AS pizza_id,
        pt."topping_id",
        1                                                        AS qty
    FROM  orders                   o
    JOIN  "pizza_recipes"          pr ON pr."pizza_id" = o."pizza_id"
    JOIN  "pizza_toppings"         pt
          ON instr(','||pr."toppings"||',',','||pt."topping_id"||',')>0
    /* remove those that are excluded for this order                */
    WHERE pt."topping_id" NOT IN (
          SELECT gx2."exclusions"
          FROM   "pizza_get_exclusions" gx2
          WHERE  gx2."order_id" = o."order_id"
    )
),
/* -----------------------------------------------------------
3. any extra toppings that were added
----------------------------------------------------------- */
extra_toppings AS (
    SELECT
        o.row_id, o.order_id, o.customer_id, o.order_time,
        o.pizza_name,
        CASE WHEN o.pizza_name = 'Meatlovers' THEN 1 ELSE 2 END   AS pizza_id,
        ge."extras"       AS topping_id,
        ge."extras_count" AS qty
    FROM  orders              o
    JOIN  "pizza_get_extras"  ge
          ON ge."order_id" = o."order_id"
),
/* -----------------------------------------------------------
4. put base and extras together, then add up quantities
----------------------------------------------------------- */
all_toppings AS (
    SELECT * FROM base_toppings
    UNION ALL
    SELECT * FROM extra_toppings
),
topping_totals AS (
    SELECT
        row_id, order_id, customer_id, order_time,
        pizza_name, pizza_id,
        topping_id,
        SUM(qty) AS total_qty
    FROM all_toppings
    GROUP BY row_id, order_id, customer_id, order_time,
             pizza_name, pizza_id, topping_id
),
/* -----------------------------------------------------------
5. translate topping_id → readable name with “2x ” prefix when needed
----------------------------------------------------------- */
ingredient_words AS (
    SELECT
        tt.row_id, tt.order_id, tt.customer_id, tt.order_time,
        tt.pizza_name, tt.pizza_id,
        CASE
            WHEN tt.total_qty > 1 THEN '2x ' || pt."topping_name"
            ELSE                       pt."topping_name"
        END AS ingredient
    FROM   topping_totals  tt
    JOIN   "pizza_toppings" pt ON pt."topping_id" = tt."topping_id"
),
/* -----------------------------------------------------------
6. assemble the final ingredient string in alphabetical order
----------------------------------------------------------- */
final_string AS (
    SELECT
        iw.row_id,
        iw.order_id,
        iw.customer_id,
        iw.order_time,
        iw.pizza_name,
        iw.pizza_id,
        (iw.pizza_name || ': ' ||
         (SELECT GROUP_CONCAT(ingredient, ', ')
          FROM   (SELECT ingredient
                  FROM   ingredient_words iw2
                  WHERE  iw2.row_id   = iw.row_id
                    AND  iw2.order_id = iw.order_id
                    AND  iw2.pizza_id = iw.pizza_id
                  ORDER  BY ingredient)
         )
        ) AS final_ingredients
    FROM ingredient_words iw
    GROUP BY iw.row_id, iw.order_id, iw.customer_id,
             iw.order_time, iw.pizza_name, iw.pizza_id
)
/* -----------------------------------------------------------
7. required output
----------------------------------------------------------- */
SELECT
    row_id,
    order_id,
    customer_id,
    order_time,
    pizza_name,
    pizza_id,
    final_ingredients
FROM   final_string
ORDER  BY row_id;
```
