    JOIN   pizza_names pn ON pn.pizza_id = pc.pizza_id
    WHERE  pc.order_id NOT IN (SELECT order_id FROM pizza_get_extras)
      AND  pc.order_id NOT IN (SELECT order_id FROM pizza_get_exclusions)
),
