```sql
--Description: Prototype a “final ingredients” string for each order that contains extras.
--Fixes the previous DISTINCT‑aggregate error by omitting the custom separator in group_concat.
SELECT
    ge.row_id,
    pc.order_id,
    pc.customer_id,
    pn.pizza_name || ': ' ||
    group_concat(DISTINCT pt.topping_name) AS final_ingredients
FROM   pizza_customer_orders   AS pc
JOIN   pizza_names             AS pn  ON pn.pizza_id  = pc.pizza_id
JOIN   pizza_recipes           AS pr  ON pr.pizza_id  = pc.pizza_id
JOIN   pizza_get_extras        AS ge  ON ge.order_id  = pc.order_id      -- guarantees extras exist
LEFT  JOIN pizza_get_exclusions AS gx ON gx.order_id  = pc.order_id      -- exclusions may be absent
JOIN   pizza_toppings          AS pt
       ON ( instr(',' || pr.toppings || ',', ',' || pt.topping_id || ',') > 0   -- default recipe
            OR pt.topping_id = ge.extras )                                       -- or extra
WHERE  gx.exclusions IS NULL                     -- keep if no exclusions at all
       OR pt.topping_id <> gx.exclusions         -- or keep when topping isn’t excluded
GROUP  BY ge.row_id, pc.order_id, pc.customer_id, pn.pizza_name
LIMIT 20;
```
