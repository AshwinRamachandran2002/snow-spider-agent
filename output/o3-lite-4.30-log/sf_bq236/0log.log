-- Description: 7) Nationwide 2024 hail‑to‑ZIP join; convert WKB → GEOGRAPHY before ST_WITHIN.
SELECT
       z."zip_code",
       COUNT(*) AS "hail_events_2024"
FROM   "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2024" AS s
