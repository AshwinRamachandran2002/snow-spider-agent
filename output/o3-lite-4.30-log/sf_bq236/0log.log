```sql
-- Description: The earlier failure showed that state information lives in the ZIP table, not the storms table.
-- Strategy:
--  • keep only hail rows from STORMS_2024 (event_type ILIKE '%hail%').
--  • spatially join each hail POINT to its containing ZIP polygon with ST_WITHIN.
--  • retain rows whose ZIP polygon belongs to Florida by checking z."state_code" = 'FL'.
--  • aggregate to count hail events per ZIP, order by that count, and display the top 20.
SELECT
       z."zip_code",
       COUNT(*) AS "hail_events_FL_2024"
FROM   "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2024" AS s
JOIN   "NOAA_DATA_PLUS"."GEO_US_BOUNDARIES"."ZIP_CODES"             AS z
       ON ST_WITHIN(s."event_point", z."zip_code_geom")
WHERE  s."event_type" ILIKE '%hail%'
  AND  z."state_code" = 'FL'
GROUP BY z."zip_code"
ORDER BY "hail_events_FL_2024" DESC
LIMIT 20;
