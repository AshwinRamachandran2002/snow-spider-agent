Begin Exploring Related Columns
Relevant columns and their potential usage
• ZIP_CODES."zip_code": 5‑digit postal code; used for final grouping and ranking.  
• ZIP_CODES."zip_code_geom": polygon for each ZIP; used with ST_WITHIN to spatially assign each storm event to a ZIP code.  
• STORMS_20XX."event_type": filter to hail events (value normally equals ‘HAIL’ – case may vary).  
• STORMS_20XX."event_point": POINT geometry (lon/lat) for each event; used in the ST_WITHIN spatial join.  
• STORMS_20XX."event_begin_time": numeric timestamp; restrict to the most recent 10 calendar years (2014‑01‑01 → 2024‑12‑31).  
• (optional) STORMS_20XX."event_latitude", "event_longitude": quick sanity checks before using geometries.  
Conditions that will be useful  
• WHERE "event_type" ILIKE '%hail%'  
• WHERE "event_begin_time" >= 1388534400000000   -- ≈ 2014‑01‑01 in microseconds (validate actual units first)  
• ST_WITHIN( s."event_point", z."zip_code_geom" )  

Below are ten exploratory Snowflake SQL queries, ordered from simple inspection to the complete answer.  
All column names are wrapped in double quotes, each query returns at most 20 rows, and no DDL/metadata calls are used.

```sql
-- Description: 1) See all distinct event types in the most recent file to verify the hail spelling/casing.
SELECT DISTINCT "event_type"
FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2024"
LIMIT 20;
```

```sql
-- Description: 2) Quick look at a few hail rows (coordinates & time) for 2024.
SELECT "event_id",
       "event_type",
       "event_begin_time",
       "event_latitude",
       "event_longitude",
       "event_point"
FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2024"
WHERE "event_type" ILIKE '%hail%'
LIMIT 20;
```

```sql
-- Description: 3) Inspect raw numeric time values so we know the unit/epoch.
SELECT "event_id",
       "event_begin_time",
       "event_end_time"
FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2019"
WHERE "event_type" ILIKE '%hail%'
LIMIT 20;
```

```sql
-- Description: 4) Double‑check that ‘HAIL’ exists (or other spellings) in an older file (2014).
SELECT DISTINCT "event_type"
FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2014"
LIMIT 20;
```

```sql
-- Description: 5) Count hail events by state for 2023 (sanity‑check spatial distribution).
SELECT "state",
       COUNT(*) AS "hail_events_2023"
FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023"
WHERE "event_type" ILIKE '%hail%'
GROUP BY "state"
ORDER BY "hail_events_2023" DESC
LIMIT 20;
```

```sql
-- Description: 6) Join 2024 hail events to ZIP polygons for one state (FL) just to test ST_WITHIN.
SELECT z."zip_code",
       COUNT(*) AS "hail_events_FL_2024"
FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2024"  s
JOIN "NOAA_DATA_PLUS"."GEO_US_BOUNDARIES"."ZIP_CODES"              z
  ON ST_WITHIN( s."event_point", z."zip_code_geom" )
WHERE s."event_type" ILIKE '%hail%'
  AND s."state_code" = 'FL'
GROUP BY z."zip_code"
ORDER BY "hail_events_FL_2024" DESC
LIMIT 20;
```

```sql
-- Description: 7) Nationwide 2024 hail‑to‑ZIP join with a LIMIT to preview performance.
SELECT z."zip_code",
       COUNT(*) AS "hail_events_2024"
FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2024"  s
JOIN "NOAA_DATA_PLUS"."GEO_US_BOUNDARIES"."ZIP_CODES"              z
  ON ST_WITHIN( s."event_point", z."zip_code_geom" )
WHERE s."event_type" ILIKE '%hail%'
GROUP BY z."zip_code"
ORDER BY "hail_events_2024" DESC
LIMIT 20;
```

```sql
-- Description: 8) Same as #7 but aggregating instead on state to confirm total counts line up.
SELECT z."state_code",
       COUNT(*) AS "hail_events_2024"
FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2024"  s
JOIN "NOAA_DATA_PLUS"."GEO_US_BOUNDARIES"."ZIP_CODES"              z
  ON ST_WITHIN( s."event_point", z."zip_code_geom" )
WHERE s."event_type" ILIKE '%hail%'
GROUP BY z."state_code"
ORDER BY "hail_events_2024" DESC
LIMIT 20;
```

```sql
-- Description: 9) Union all storm tables from 2014‑2024, then count hail events per ZIP.
WITH hail_events AS (  
    SELECT "event_point"
    FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2014" WHERE "event_type" ILIKE '%hail%'
    UNION ALL
    SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2015" WHERE "event_type" ILIKE '%hail%'
    UNION ALL
    SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2016" WHERE "event_type" ILIKE '%hail%'
    UNION ALL
    SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2017" WHERE "event_type" ILIKE '%hail%'
    UNION ALL
    SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2018" WHERE "event_type" ILIKE '%hail%'
    UNION ALL
    SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2019" WHERE "event_type" ILIKE '%hail%'
    UNION ALL
    SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2020" WHERE "event_type" ILIKE '%hail%'
    UNION ALL
    SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2021" WHERE "event_type" ILIKE '%hail%'
    UNION ALL
    SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2022" WHERE "event_type" ILIKE '%hail%'
    UNION ALL
    SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023" WHERE "event_type" ILIKE '%hail%'
    UNION ALL
    SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2024" WHERE "event_type" ILIKE '%hail%'
)
SELECT z."zip_code",
       COUNT(*) AS "hail_events_2014_2024"
FROM hail_events h
JOIN "NOAA_DATA_PLUS"."GEO_US_BOUNDARIES"."ZIP_CODES" z
  ON ST_WITHIN( h."event_point", z."zip_code_geom" )
GROUP BY z."zip_code"
ORDER BY "hail_events_2014_2024" DESC
LIMIT 20;
```

```sql
-- Description: 10) Final query – returns the TOP 5 ZIP codes with the most hail reports in the last 10 years.
WITH hail_events AS (  
    SELECT "event_point"
    FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2014" WHERE "event_type" ILIKE '%hail%'
    UNION ALL SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2015" WHERE "event_type" ILIKE '%hail%'
    UNION ALL SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2016" WHERE "event_type" ILIKE '%hail%'
    UNION ALL SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2017" WHERE "event_type" ILIKE '%hail%'
    UNION ALL SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2018" WHERE "event_type" ILIKE '%hail%'
    UNION ALL SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2019" WHERE "event_type" ILIKE '%hail%'
    UNION ALL SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2020" WHERE "event_type" ILIKE '%hail%'
    UNION ALL SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2021" WHERE "event_type" ILIKE '%hail%'
    UNION ALL SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2022" WHERE "event_type" ILIKE '%hail%'
    UNION ALL SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023" WHERE "event_type" ILIKE '%hail%'
    UNION ALL SELECT "event_point" FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2024" WHERE "event_type" ILIKE '%hail%'
)
SELECT z."zip_code",
       COUNT(*) AS "hail_event_count"
FROM hail_events h
JOIN "NOAA_DATA_PLUS"."GEO_US_BOUNDARIES"."ZIP_CODES" z
  ON ST_WITHIN( h."event_point", z."zip_code_geom" )
GROUP BY z."zip_code"
ORDER BY "hail_event_count" DESC
LIMIT 5;
```

