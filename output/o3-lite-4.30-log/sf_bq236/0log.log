-- Description: ST_WITHIN requires GEOGRAPHY objects, but both tables keep geometries in WKB (BINARY).
--              1) Convert the hail “event_point” and ZIP “zip_code_geom” to GEOGRAPHY with TO_GEOGRAPHY().
--              2) Perform the spatial join. 3) Filter ZIP polygons to Florida (state_code = 'FL').
--              4) Count 2024 hail events per ZIP and return the 20 highest‑count ZIP codes.
SELECT
       z."zip_code",
       COUNT(*) AS "hail_events_FL_2024"
FROM   "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2024" AS s
JOIN   "NOAA_DATA_PLUS"."GEO_US_BOUNDARIES"."ZIP_CODES"             AS z
       ON ST_WITHIN(
            TO_GEOGRAPHY(s."event_point"),
            TO_GEOGRAPHY(z."zip_code_geom")
          )
WHERE  s."event_type" ILIKE '%hail%'
  AND  z."state_code" = 'FL'
GROUP BY z."zip_code"
ORDER BY "hail_events_FL_2024" DESC
LIMIT 20;
