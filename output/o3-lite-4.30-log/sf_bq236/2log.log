WITH hail AS (
  SELECT "event_id",
         ST_MAKEPOINT("event_longitude","event_latitude") AS "pt"
  FROM (
        SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2019"
