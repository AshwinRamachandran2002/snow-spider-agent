```sql
--Query 10 -------------------------------------------------------------
--Description: Final query template to pull the TOP‑5 ZIP codes with the
--most hail events across the full 10‑year window; the LIMIT is kept at
--20 during exploration—remove or change to 5 when ready for production.
WITH hail_10yr AS (
  /* 1.  Union every yearly table from 2014‑2024 */
  SELECT "event_id",
         ST_MAKEPOINT("event_longitude","event_latitude") AS "pt"
  FROM (
        SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2014"
        UNION ALL SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2015"
        UNION ALL SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2016"
        UNION ALL SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2017"
        UNION ALL SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2018"
        UNION ALL SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2019"
        UNION ALL SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2020"
        UNION ALL SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2021"
        UNION ALL SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2022"
        UNION ALL SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023"
        UNION ALL SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2024"
       )
  WHERE "event_type" ILIKE '%hail%'
    AND "event_latitude" IS NOT NULL
    AND "event_longitude" IS NOT NULL
)
SELECT z."zip_code",
       z."state_code",
       COUNT(*) AS "hail_events_last_10yr"
FROM hail_10yr h
JOIN "NOAA_DATA_PLUS"."GEO_US_BOUNDARIES"."ZIP_CODES" z
  ON ST_WITHIN(h."pt", z."zip_code_geom")
GROUP BY z."zip_code", z."state_code"
ORDER BY "hail_events_last_10yr" DESC
LIMIT 20;   --Change to LIMIT 5 for the actual answer
```

