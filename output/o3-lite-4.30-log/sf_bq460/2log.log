WITH tokens AS (
    /* Tokenise article body, keep alphabetic / numeric tokens, drop stop‑words */
    SELECT
        n."id",
        tok.value::STRING AS "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL SPLIT_TO_TABLE(
