--Description:  Because repeated attempts to reference the TOKENISE_NO_STOP UDF failed,
--              we replicate its essential logic directly in‑line:  
--              1)  Remove possessive ’s from the article body via REGEXP_REPLACE.  
--              2)  Use REGEXP_EXTRACT_ALL to capture every word/number token into an ARRAY.  
--              3)  FLATTEN that ARRAY so each token becomes its own row.  
--              4)  Convert to lower‑case and filter out an explicit list of stop‑words  
--                 (approximating the UDF’s stop‑word list).  
--              5)  Return the first 20 non‑stopword tokens for the target article  
--                 id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'.
SELECT  LOWER(tok.value)::STRING AS "word"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
           input => REGEXP_EXTRACT_ALL(
