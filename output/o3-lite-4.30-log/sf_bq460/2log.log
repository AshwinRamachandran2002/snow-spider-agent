--Description: 8) Tokenise the target article inline (no UDF); join the resulting tokens
--              to WORD_FREQUENCIES to inspect corpus frequency counts for each word.
SELECT  tok.value::STRING            AS "word",
        wf."frequency"
FROM  WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
      ,LATERAL SPLIT_TO_TABLE(
           REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z]+', ' '),
           ' '
       ) tok
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON wf."word" = tok.value::STRING
WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
  AND tok.value IS NOT NULL
  AND tok.value <> ''
LIMIT 20
