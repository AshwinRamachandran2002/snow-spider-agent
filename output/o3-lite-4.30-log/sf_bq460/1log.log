Relevant columns and their potential usage  

WORD_VECTORS_US.WORD_VECTORS_US.NATURE  
• "id": unique key for each article – used to pick a target article and to join aggregated results back to the article  
• "date": publication date – returned with final similarity list or filtered on recency if desired  
• "title": article title – returned so results are readable  
• "body": full‑text that must be tokenised and cleaned of stop‑words before vectorising  
• "abstract", "category", "authors", … : could be displayed or filtered, but not strictly required for the cosine‑similarity task  
• "acquisition_date": alternative date field that could be filtered  

WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES  
• "word": term to match tokens coming from the article body  
• "frequency": corpus frequency – used as the denominator in weighting; the query will need POWER("frequency",0.4)  

WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS  
• "word": term to match tokens after stop‑word removal  
• "vector": 300‑dimensional GloVe vector – divided by the 0.4‑power of its frequency, then summed per article  

Typical conditions that may be used  
• WHERE "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'                         -- locate the reference article  
• WHERE "word" IN (…)                                                      -- restrict to tokens that survived stop‑word removal  
• WHERE "frequency" IS NOT NULL AND "vector" IS NOT NULL                    -- keep only valid rows  
• ORDER BY "similarity" DESC                                                -- rank by cosine similarity  
• LIMIT 20 / LIMIT 10                                                       -- trim result sets  

Below are ten Snowflake SQL snippets that progress from simple inspection through to an (illustrative) final cosine‑similarity query.  Each query is limited to 20 rows (except the final one which returns the Top‑10 similar articles).  All identifiers are enclosed in double quotes.

```sql
-- 1. Description: Peek at article identifiers, dates and titles in the Nature table.
SELECT DISTINCT
       "id",
       "date",
       "title"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE
LIMIT  20;
```

```sql
-- 2. Description: Retrieve the body, title and date of the target article (fuzzy search on id fragment).
SELECT
  "id",
  "date",
  "title",
  "body"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE "id" ILIKE '%8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373%'
LIMIT 20;
```

```sql
-- 3. Description: Tokenise the body of the target article and remove stop‑words.
SELECT
  t."id",
  token.value::STRING  AS "token"
FROM  WORD_VECTORS_US.WORD_VECTORS_US.NATURE  t,
      LATERAL FLATTEN( INPUT => `spider2-public-data`.word_vectors_us.tokenise_no_stop(t."body") ) token
WHERE t."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
LIMIT 20;
```

```sql
-- 4. Description: Show the distinct tokens appearing in ANY Nature article together with their counts.
SELECT
       token.value::STRING AS "token",
       COUNT(*)           AS "token_count"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE t,
       LATERAL FLATTEN( INPUT => `spider2-public-data`.word_vectors_us.tokenise_no_stop(t."body") ) token
GROUP  BY token.value
ORDER  BY "token_count" DESC
LIMIT  20;
```

```sql
-- 5. Description: Join the tokens of the target article to the WORD_FREQUENCIES table.
WITH target AS (
    SELECT token.value::STRING AS "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN( INPUT => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body") ) token
    WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
)
SELECT
   w."word",
   f."frequency"
FROM target w
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
       ON f."word" = w."word"
LIMIT 20;
```

```sql
-- 6. Description: Attach GloVe vectors to the same token set.
WITH target AS (
    SELECT token.value::STRING AS "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN( INPUT => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body") ) token
    WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
)
SELECT
   g."word",
   g."vector"
FROM target w
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
     ON g."word" = w."word"
LIMIT 20;
```

```sql
-- 7. Description: Demonstrate weighting a vector by frequency^(‑0.4) for one token.
SELECT
   g."word",
   g."vector",
   f."frequency",
   g."vector" / POWER(f."frequency", 0.4)  AS "weighted_vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
     ON f."word" = g."word"
WHERE g."word" = 'polyamines'      -- example token
LIMIT 20;
```

```sql
-- 8. Description: Build a per‑article aggregated (unnormalised) vector – demonstration on 1 article.
WITH tokens AS (
    SELECT
        n."id",
        t.value::STRING AS "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN( INPUT => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body") ) t
    WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),
weighted AS (
    SELECT
        tok."id",
        gv."vector" / POWER(wf."frequency", 0.4) AS "w_vec"
    FROM tokens tok
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv  ON gv."word" = tok."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf ON wf."word" = tok."word"
)
SELECT
    "id",
    ARRAY_AGG("w_vec") AS "all_weighted_vectors"
FROM weighted
GROUP BY "id"
LIMIT 20;
```

```sql
-- 9. Description: Compute length and normalise the aggregated vector (single article example).
WITH tokens AS (
    SELECT n."id", t.value::STRING AS "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN( INPUT => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body") ) t
    WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),
weighted AS (
    SELECT tok."id",
           gv."vector" / POWER(wf."frequency", 0.4) AS "w_vec"
    FROM tokens tok
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv  ON gv."word" = tok."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf ON wf."word" = tok."word"
),
summed AS (
    SELECT "id",
           ARRAY_SUM_AGG("w_vec") AS "raw_vec"
    FROM weighted
    GROUP BY "id"
)
SELECT
   "id",
   "raw_vec",
   SQRT(ARRAY_SUM(ARRAY_TRANSFORM("raw_vec", x -> x * x))) AS "norm",
   "raw_vec" / SQRT(ARRAY_SUM(ARRAY_TRANSFORM("raw_vec", x -> x * x))) AS "unit_vec"
FROM summed
LIMIT 20;
```

```sql
-- 10. Description: Produce top‑10 articles most similar to the target article based on cosine similarity.
WITH article_vectors AS (  ---------------------------------------------------------
    SELECT n."id",
           ARRAY_SUM_AGG( gv."vector" / POWER(wf."frequency", 0.4) ) AS "raw_vec"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE          n
    ,    LATERAL FLATTEN( INPUT =>
            `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body") ) t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv ON gv."word" = t.value::STRING
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf ON wf."word" = t.value::STRING
    GROUP BY n."id"
),                                                                ------------ summed
unitised AS (                                                     ------------ get unit vectors
    SELECT
       "id",
       "raw_vec",
       "raw_vec" / SQRT(ARRAY_SUM(ARRAY_TRANSFORM("raw_vec", x -> x * x))) AS "unit_vec"
    FROM article_vectors
),
target AS (
    SELECT "unit_vec" AS "target_vec"
    FROM   unitised
    WHERE  "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),
similarity AS (
    SELECT
       u."id",
       ARRAY_SUM(ARRAY_TRANSFORM( u."unit_vec", (v, idx) -> v * target."target_vec"[idx] )) AS "cosine_sim"
    FROM unitised u, target
)
SELECT
    s."id",
    n."date",
    n."title",
    s."cosine_sim"
FROM   similarity s
JOIN   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n ON n."id" = s."id"
WHERE  s."id" <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
ORDER BY s."cosine_sim" DESC
LIMIT 10;
```

These queries progressively explore the dataset—from simple inspection (Query 1) up to a complete cosine‑similarity pipeline (Query 10)—while respecting the table/column names given.
