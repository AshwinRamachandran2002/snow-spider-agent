```sql
--Description / Thinking process:
-- Objective: return the 10 Nature articles whose content is most similar to the
--            Alzheimer‑biomarker article (id = '8a78ef2d‑d5f7‑4d2d‑9b47‑5adb25cbd373')
--            using the weighting scheme vector / frequency^0.4 and cosine similarity.
--
-- Key Snowflake functions used:
--   • REGEXP_REPLACE  – strip punctuation
--   • SPLIT / FLATTEN – crude tokeniser
--   • ARRAY_TRANSFORM – element‑wise arithmetic inside a VARIANT array
--   • ARRAY_SUM_AGG   – element‑wise sum across many arrays
--   • ARRAY_ZIP       – pair corresponding elements of two arrays
--   • ARRAY_SUM       – sum numeric elements inside a single array
--
-- Pipeline:
-- 1. tokenised  : explode every article’s body into “meaningful” tokens
--                 (lower‑case, punctuation stripped, stop‑words removed).
-- 2. weighted   : attach each token’s GloVe vector & frequency and create a
--                 weighted vector = ARRAY_TRANSFORM(vector, x -> x / freq^0.4).
-- 3. article_vec: sum the weighted vectors token‑by‑token for each article
--                 → raw_vec (size 300).
-- 4. unit_vecs  : convert raw_vec to unit length (divide by its Euclidean norm).
-- 5. target_vec : isolate the unit vector of the reference article.
-- 6. similarity : for every other article compute cosine similarity as the
--                 dot‑product of its unit_vec with target_vec using
--                 ARRAY_ZIP + ARRAY_TRANSFORM + ARRAY_SUM.
-- 7. final      : join back to NATURE for date & title; sort; return top 10.
--
-- The entire process is expressed in ONE query block below.

WITH tokenised AS (
    SELECT
        n."id",
        tok.value::STRING AS "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
             INPUT => SPLIT(
                       REGEXP_REPLACE( LOWER(n."body"), '[^a-z0-9]+', ' ' ),
                       ' '
                    )
         ) tok
    WHERE tok.value IS NOT NULL
      AND tok.value <> ''
      AND tok.value NOT IN (
           'a','about','above','after','again','against','all','am','an','and','any','are','as','at','be',
           'because','been','before','being','below','between','both','but','by','can','could','did','do',
           'does','doing','down','during','each','few','for','from','further','had','has','have','having',
           'he','her','here','hers','herself','him','himself','his','how','i','if','in','into','is','it',
           'its','itself','just','ll','m','ma','me','more','most','my','myself','no','nor','not','now','o',
           'of','off','on','once','only','or','other','our','ours','ourselves','out','over','own','re','s',
           'same','she','should','so','some','such','t','than','that','the','their','theirs','them',
           'themselves','then','there','these','they','this','those','through','to','too','under','up',
           've','very','was','we','were','what','when','where','which','while','who','whom','why','will',
           'with','won','would','y','you','your','yours','yourself','yourselves'
      )
),
weighted AS (
    SELECT
        tok."id",
        ARRAY_TRANSFORM( gv."vector", x -> x / POWER(wf."frequency", 0.4) ) AS "w_vec"
    FROM tokenised tok
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
           ON gv."word" = tok."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
           ON wf."word" = tok."word"
),
article_vec AS (
    SELECT
        "id",
        ARRAY_SUM_AGG("w_vec") AS "raw_vec"
    FROM weighted
    GROUP BY "id"
),
unit_vecs AS (
    SELECT
        "id",
        "raw_vec",
        SQRT(ARRAY_SUM(ARRAY_TRANSFORM("raw_vec", v -> v * v)))                      AS norm,
        "raw_vec" / SQRT(ARRAY_SUM(ARRAY_TRANSFORM("raw_vec", v -> v * v)))          AS unit_vec
    FROM article_vec
    WHERE ARRAY_SUM(ARRAY_TRANSFORM("raw_vec", v -> v * v)) > 0      -- guard /0
),
target_vec AS (
    SELECT unit_vec AS tgt_vec
    FROM   unit_vecs
    WHERE  "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),
similarity AS (
    SELECT
        u."id",
        ARRAY_SUM(
            ARRAY_TRANSFORM(
                ARRAY_ZIP(u.unit_vec , tgt.tgt_vec) ,
                p -> p[0] * p[1]
            )
        ) AS cosine_sim
    FROM unit_vecs u, target_vec tgt
    WHERE u."id" <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
)
SELECT
    s."id",
    n."date",
    n."title",
    s."cosine_sim"
FROM similarity s
JOIN WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
     ON n."id" = s."id"
ORDER BY s."cosine_sim" DESC
LIMIT 10;
```
