--   2. Replace all non‑alphanumeric characters with spaces (REGEXP_REPLACE).
--   3. SPLIT the cleaned text on spaces → array of tokens.
--   4. FLATTEN the array so each token is its own row.
--   5. Remove NULL/empty tokens and a simple stop‑word list.
--   6. GROUP BY token to count its appearances across the corpus.
--   7. LEFT JOIN the result to WORD_FREQUENCIES to display each token’s global
--      frequency (if present).
--   8. Order by descending article‑corpus count and list the top 20.

WITH tokenised AS (
    SELECT
        tok.value::STRING AS token
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE AS n,
         LATERAL FLATTEN(
             INPUT => SPLIT(
                 REGEXP_REPLACE( LOWER(n."body"), '[^a-z0-9]+', ' ' ),
                 ' '
             )
         ) AS tok
    WHERE tok.value IS NOT NULL
      AND tok.value <> ''
      AND tok.value NOT IN (  -- basic stop‑word list
         'a','about','above','after','again','against','all','am','an','and','any','are','as','at','be',
         'because','been','before','being','below','between','both','but','by','can','could','did','do',
