            gv.vector,
            x -> x / POWER(wf.frequency, 0.4)
        ) AS w_vec
    FROM tokenised tok
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
         ON wf.word = tok.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
         ON gv.word = tok.word
), article_vec AS (
    SELECT
        id,
        ARRAY_SUM_AGG(w_vec) AS raw_vec
    FROM weighted
    GROUP BY id
), unit_vecs AS (
    SELECT
        id,
        raw_vec,
        SQRT(ARRAY_SUM(ARRAY_TRANSFORM(raw_vec, v -> v * v))) AS norm,
        raw_vec / NULLIF(SQRT(ARRAY_SUM(ARRAY_TRANSFORM(raw_vec, v -> v * v))),0) AS unit_vec
    FROM article_vec
), target AS (
    SELECT unit_vec AS tgt
    FROM unit_vecs
    WHERE id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
), similarity AS (
    SELECT
        u.id,
        ARRAY_SUM(
            ARRAY_TRANSFORM(
                ARRAY_ZIP(u.unit_vec, t.tgt),
                pair -> pair[0] * pair[1]
            )
        ) AS cosine_sim
    FROM unit_vecs u, target t
    WHERE u.id <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
)
SELECT
    s.id,
    n.date,
    n.title,
    s.cosine_sim
FROM similarity s
JOIN WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
  ON n.id = s.id
ORDER BY s.cosine_sim DESC
LIMIT 10;
