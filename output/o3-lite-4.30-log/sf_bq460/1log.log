--
-- Core ideas
-- 1. Tokenisation (manual):
--      • LOWER(body), strip non‑alphanumerics → spaces, SPLIT on spaces, FLATTEN.
--      • Remove blanks + hard‑coded English stop‑words.
-- 2. Weighting:
--      • Inner‑join surviving tokens to WORD_FREQUENCIES (wf) and GLOVE_VECTORS (gv).
--      • weighted_vec = ARRAY_TRANSFORM(gv.vector, x -> x / POWER(wf.frequency, 0.4))
--        (avoids VARIANT‑to‑REAL cast error by element‑wise division).
-- 3. Aggregation:
--      • Sum weighted_vec across tokens per article with ARRAY_SUM_AGG → raw_vec (300‑D).
--      • Convert to unit length: unit_vec = raw_vec / ||raw_vec||.
-- 4. Similarity:
--      • Dot product of each unit_vec with the target article’s unit_vec via
--        ARRAY_ZIP + ARRAY_TRANSFORM + ARRAY_SUM.
-- 5. Output: id, date, title, cosine similarity – top 10 (excluding the target).
--
-- All accomplished in a single query block.

WITH tokenised AS (
    SELECT
        n.id,
        tok.value::STRING AS word
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
             INPUT => SPLIT(
