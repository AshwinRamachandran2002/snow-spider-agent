--    “no stopwords”.
-- 3. GROUP BY token, COUNT(*) its occurrences across the corpus.
-- 4. LEFT JOIN the counts to WORD_FREQUENCIES (aliased wf) on token = wf.word
--    so we can display wf.frequency (the earlier “invalid identifier” error
--    happened because the alias was missing; we fix that here).
-- 5. ORDER by token_count descending, LIMIT 20.

WITH tokenised AS (
    SELECT
        tok.value::STRING AS token
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE AS n,
         LATERAL FLATTEN(
             INPUT => SPLIT(
                 REGEXP_REPLACE( LOWER(n."body"), '[^a-z0-9]+', ' ' ),
