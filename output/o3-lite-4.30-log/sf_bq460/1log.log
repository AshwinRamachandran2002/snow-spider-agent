--Description / Thinking process:
-- Goal: for the Alzheimer‑biomarker article (id = '8a78ef2d‑d5f7‑4d2d‑9b47‑5adb25cbd373'),
--       extract “meaningful” tokens from the body, attach each token’s corpus frequency
--       and GloVe vector, then compute its weight = vector / frequency^0.4.
-- Steps:
--   1. Tokenisation:
--        • LOWER the body text.
--        • REGEXP_REPLACE to convert non‑alphanumerics → spaces.
--        • SPLIT on spaces → array of tokens.
--        • FLATTEN the array to rows.
--   2. Filter out empty tokens plus a hard‑coded stop‑word list (since the external UDF
--      tokenise_no_stop is unavailable).
--   3. JOIN to WORD_FREQUENCIES (wf) to get "frequency".
--   4. JOIN to GLOVE_VECTORS (gv) to get the 300‑dimensional "vector".
--   5. Compute a weighted vector by dividing gv.vector by POWER(wf.frequency, 0.4).
--   6. Show the first 20 rows so we can verify everything works.
-- Note: Snowflake represents the GloVe vector as VARIANT (JSON array); here we keep it
--       unchanged to avoid exploding 300 columns.  This single query demonstrates the
--       full pipeline foundation for later aggregation / cosine‑similarity work.

WITH tokenised AS (
    SELECT
        n."id",
        tok.value::STRING AS "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
             INPUT => SPLIT(
                       REGEXP_REPLACE( LOWER(n."body"), '[^a-z0-9]+', ' ' ),
                       ' '
                    )
         ) tok
    WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
      AND tok.value IS NOT NULL
      AND tok.value <> ''
      AND tok.value NOT IN (
           'a','about','above','after','again','against','all','am','an','and','any','are','as','at','be',
           'because','been','before','being','below','between','both','but','by','can','could','did','do',
           'does','doing','down','during','each','few','for','from','further','had','has','have','having',
           'he','her','here','hers','herself','him','himself','his','how','i','if','in','into','is','it',
           'its','itself','just','ll','m','ma','me','more','most','my','myself','no','nor','not','now','o',
           'of','off','on','once','only','or','other','our','ours','ourselves','out','over','own','re','s',
           'same','she','should','so','some','such','t','than','that','the','their','theirs','them',
           'themselves','then','there','these','they','this','those','through','to','too','under','up',
           've','very','was','we','were','what','when','where','which','while','who','whom','why','will',
           'with','won','would','y','you','your','yours','yourself','yourselves'
      )
)
SELECT
    t."word",
    wf."frequency",
    gv."vector",
    gv."vector" / POWER(wf."frequency", 0.4) AS "weighted_vector"
FROM tokenised t
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
       ON wf."word" = t."word"
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
       ON gv."word" = t."word"
LIMIT 20;
