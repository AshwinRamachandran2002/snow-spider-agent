         'same','she','should','so','some','such','t','than','that','the','their','theirs','them',
         'themselves','then','there','these','they','this','those','through','to','too','under','up',
         've','very','was','we','were','what','when','where','which','while','who','whom','why','will',
         'with','won','would','y','you','your','yours','yourself','yourselves'
      )
), counts AS (
    SELECT
        token,
        COUNT(*) AS token_count
    FROM tokenised
    GROUP BY token
)
SELECT
    c.token,
    c.token_count,
    wf.frequency AS corpus_frequency
FROM counts AS c
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES AS wf
       ON wf.word = c.token
ORDER BY c.token_count DESC
