        a."date",
        a."title",
        COSINE_SIMILARITY(a."agg_vec", b."agg_vec") AS "cos_sim"
FROM    article_vecs a
JOIN    article_vecs b
   ON   b."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
ORDER BY "cos_sim" DESC
LIMIT 20;
```

