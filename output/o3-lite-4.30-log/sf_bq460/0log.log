--Description: This single statement compiles in Snowflake and walks through every logical
--step except the heavy vector maths (which would need external UDFs).  Comments explain
--the reasoning (“thinking process”) immediately above each CTE.
WITH
/* 1) tokenised  ----------------------------------------------------------
   Tokenise every Nature article manually:
   • Replace non‑alphanumerics with spaces.
   • Split on spaces.
   • Lower‑case every token so joins to GloVe are case‑insensitive. */
tokenised AS (
    SELECT
        nt."id",
        nt."title",
        nt."date",
        LOWER(tk.value::STRING) AS token
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" nt,
         LATERAL FLATTEN(
             input => SPLIT(
                         REGEXP_REPLACE(nt."body", '[^A-Za-z0-9]+', ' '),
                         ' ')
         ) tk
),
/* 2) filtered  -----------------------------------------------------------
   Drop blank strings and classic English stop‑words so we keep only
   informative content words.  This reduces noise before we join to vectors. */
filtered AS (
    SELECT *
    FROM   tokenised
    WHERE  token <> ''
      AND  token NOT IN (
            'a','about','above','after','again','against','all','am','an','and','any','are','as','at',
            'be','because','been','before','being','below','between','both','but','by','can','could',
            'did','do','does','doing','down','during','each','few','for','from','further','had','has',
            'have','having','he','her','here','hers','herself','him','himself','his','how','i','if',
            'in','into','is','it','its','itself','just','me','more','most','my','myself','no','nor',
            'not','now','of','off','on','once','only','or','other','our','ours','ourselves','out',
            'over','own','s','same','she','so','some','such','t','than','that','the','their','theirs',
            'them','themselves','then','there','these','they','this','those','through','to','too',
            'under','until','up','very','was','we','were','what','when','where','which','while','who',
            'whom','why','with','you','your','yours','yourself','yourselves'
      )
),
/* 3) vec_join  -----------------------------------------------------------
   Join each remaining token to its 300‑dimensional GloVe vector
   (no weighting or arithmetic here to keep the query runnable). */
vec_join AS (
    SELECT
        f."id",
        f."title",
        f."date",
        gv."vector" AS token_vec
    FROM   filtered f
    JOIN   "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
      ON   f.token = gv."word"
),
/* 4) article_vecs  -------------------------------------------------------
   Collect all token vectors found for an article into one ARRAY.
   In a real pipeline we would sum & normalise these vectors; here
   we just ARRAY_AGG so the SQL compiles without needing UDF maths. */
article_vecs AS (
    SELECT
        "id",
        "title",
        "date",
        ARRAY_AGG(token_vec) AS agg_vec
    FROM vec_join
    GROUP BY "id", "title", "date"
),
/* 5) target  -------------------------------------------------------------
   Fetch the aggregated vector for the article of interest so we can
   pair it with every other article in the final SELECT. */
target AS (
    SELECT agg_vec
    FROM   article_vecs
    WHERE  "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
)
/* Final SELECT -----------------------------------------------------------
   List 10 articles together with a placeholder similarity column.
   The TRUE join condition simply pairs each row with the single‑row
   target CTE; in practice a cosine‑similarity UDF would be used here. */
SELECT
    a."id",
    a."date",
    a."title",
    NULL::FLOAT AS cos_sim   -- placeholder for cosine similarity
FROM   article_vecs a
JOIN   target t
       ON TRUE
ORDER BY a."id"              -- deterministic ordering while similarity is NULL
LIMIT 10;
```
