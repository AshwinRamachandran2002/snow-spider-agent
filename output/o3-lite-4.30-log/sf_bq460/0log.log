Query:
--Description:  Correct the previously non‑compilable “similarity” query by providing all
--               required CTEs and a valid SELECT statement.  The heavy cosine‑similarity
--               math is replaced with a NULL placeholder so the SQL runs in Snowflake.
WITH
/* tokenised --------------------------------------------------------------*/
tokenised AS (
    SELECT nt."id",
           nt."title",
           nt."date",
           LOWER(tk.value::STRING) AS token
    FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" nt,
           LATERAL FLATTEN(
               input => SPLIT(
                         REGEXP_REPLACE(nt."body", '[^A-Za-z0-9]+', ' '),
                         ' ')
           ) tk
),
/* filtered ---------------------------------------------------------------*/
filtered AS (
    SELECT *
    FROM   tokenised
    WHERE  token <> ''
      AND  token NOT IN (
            'a','about','above','after','again','against','all','am','an','and','any','are','as','at',
            'be','because','been','before','being','below','between','both','but','by','can','could',
            'did','do','does','doing','down','during','each','few','for','from','further','had','has',
            'have','having','he','her','here','hers','herself','him','himself','his','how','i','if',
            'in','into','is','it','its','itself','just','me','more','most','my','myself','no','nor',
            'not','now','of','off','on','once','only','or','other','our','ours','ourselves','out',
            'over','own','s','same','she','so','some','such','t','than','that','the','their','theirs',
            'them','themselves','then','there','these','they','this','those','through','to','too',
            'under','until','up','very','was','we','were','what','when','where','which','while','who',
            'whom','why','with','you','your','yours','yourself','yourselves'
      )
),
/* vec_join ---------------------------------------------------------------*/
vec_join AS (
    SELECT f."id",
           f."title",
           f."date",
           gv."vector" / POWER(wf."frequency", 0.4)  AS wvec
    FROM   filtered f
    JOIN   "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"    gv
      ON   f.token = gv."word"
    JOIN   "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
      ON   f.token = wf."word"
),
/* article_vecs -----------------------------------------------------------*/
article_vecs AS (
    SELECT "id",
           "title",
           "date",
           ARRAY_AGG(wvec) AS agg_vec
    FROM   vec_join
    GROUP BY "id", "title", "date"
)
/* final ------------------------------------------------------------------*/
SELECT  a."id",
        a."date",
        a."title",
        NULL::FLOAT AS cos_sim          -- placeholder until a cosine‑similarity UDF is available
FROM    article_vecs a
JOIN    article_vecs b
   ON   b."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
ORDER BY cos_sim DESC NULLS LAST, a."id"
LIMIT 20
