{'WORD_VECTORS_US': {'WORD_VECTORS_US': ['NATURE', 'WORD_FREQUENCIES', 'GLOVE_VECTORS']}}
Begin Exploring Related Columns
Relevant columns & their potential usage  
• WORD_VECTORS_US.WORD_VECTORS_US.NATURE  
  – "id": article identifier – filter on a single article or join back after processing  
  – "body": full‑text that must be tokenised and stripped of stop‑words  
  – "title": returned with the final similarity score for context  
  – "date": publication date to be shown with results  

• WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES  
  – "word": token to join with the article’s tokens  
  – "frequency": corpus frequency – used in the 0.4‑power weighting denominator  

• WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS  
  – "word": token to join with the article’s tokens  
  – "vector": 300‑dimensional GloVe embedding – divided by frequency^0.4 and then summed  

Common filter / join conditions that will be useful  
• WHERE "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'          --select the query article  
• WHERE LOWER(tk.word) = gv."word"                               --join token to glove  
• WHERE LOWER(tk.word) = wf."word"                               --join token to frequency  


Below are 10 exploratory Snowflake SQL queries (LIMIT 20 rows each) progressing from simple inspection to more complex joins.  
All identifiers are enclosed in double quotes.

```sql
-- 1. Description: View a handful of Nature article identifiers to understand "id" values.
SELECT "id"
FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
LIMIT 20;
```

```sql
-- 2. Description: Pull the metadata for the target article by its id.
SELECT "id",
       "date",
       "title"
FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
WHERE  "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
LIMIT 20;
```

```sql
-- 3. Description: Inspect the body text of that single article (truncated for review).
SELECT "id",
       LEFT("body", 2000) AS "body_sample"
FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
WHERE  "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
LIMIT 20;
```

```sql
-- 4. Description: Tokenise the body (stop‑words removed) for the target article.
SELECT  tk.value::STRING AS "token"
FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"  AS nt,
        LATERAL FLATTEN(
             input => "WORD_VECTORS_US"."tokenise_no_stop"(nt."body")
        ) tk
WHERE   nt."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
LIMIT 20;
```

```sql
-- 5. Description: Look up GloVe vectors for a sample of those tokens.
SELECT  tk.value::STRING                 AS "token",
        gv."vector"
FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"  AS nt,
        LATERAL FLATTEN(
             input => "WORD_VECTORS_US"."tokenise_no_stop"(nt."body")
        ) tk
JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" AS gv
     ON LOWER(tk.value::STRING) = gv."word"
WHERE   nt."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
LIMIT 20;
```

```sql
-- 6. Description: Fetch each token’s corpus frequency.
SELECT  tk.value::STRING                 AS "token",
        wf."frequency"
FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"  AS nt,
        LATERAL FLATTEN(
             input => "WORD_VECTORS_US"."tokenise_no_stop"(nt."body")
        ) tk
JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" AS wf
     ON LOWER(tk.value::STRING) = wf."word"
WHERE   nt."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
LIMIT 20;
```

```sql
-- 7. Description: Combine vector & frequency for weighting inspection (no maths yet).
SELECT  tk.value::STRING                 AS "token",
        gv."vector",
        wf."frequency"
FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"  AS nt,
        LATERAL FLATTEN(
             input => "WORD_VECTORS_US"."tokenise_no_stop"(nt."body")
        ) tk
JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"      AS gv
     ON LOWER(tk.value::STRING) = gv."word"
JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES"   AS wf
     ON LOWER(tk.value::STRING) = wf."word"
WHERE   nt."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
LIMIT 20;
```

```sql
-- 8. Description: Illustrate how a weighted vector component could be calculated for one dimension.
-- (Example shows only vector[0] element to keep row size small.)
SELECT  tk.value::STRING                  AS "token",
        gv."vector"[0]::FLOAT             AS "dim0",
        wf."frequency"                    AS "freq",
        gv."vector"[0]::FLOAT / POWER(wf."frequency", 0.4) AS "weighted_dim0"
FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"  AS nt,
        LATERAL FLATTEN(
             input => "WORD_VECTORS_US"."tokenise_no_stop"(nt."body")
        ) tk
JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"      AS gv
     ON LOWER(tk.value::STRING) = gv."word"
JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES"   AS wf
     ON LOWER(tk.value::STRING) = wf."word"
WHERE   nt."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
LIMIT 20;
```

```sql
-- 9. Description: Aggregate weighted vectors into a single 300‑D array for one article.
-- (Uses ARRAY_AGG over each dimension; demonstration for dim0 only.)
WITH toks AS (
  SELECT  gv."vector"[0]::FLOAT / POWER(wf."frequency", 0.4) AS w0
  FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"  AS nt,
          LATERAL FLATTEN(
               input => "WORD_VECTORS_US"."tokenise_no_stop"(nt."body")
          ) tk
  JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"      AS gv
       ON LOWER(tk.value::STRING) = gv."word"
  JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES"   AS wf
       ON LOWER(tk.value::STRING) = wf."word"
  WHERE   nt."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
)
SELECT SUM(w0) AS "sum_dim0"
FROM   toks
LIMIT 20;
```

