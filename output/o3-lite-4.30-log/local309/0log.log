Query:
-- 10. Final combined answer: for each season list both the champion driver and constructor
SELECT  yr."year",
        drv."driver_full_name",
        con."constructor_name"
FROM
  ( /* driver champions */
    SELECT r."year", ds."driver_id"
    FROM   "driver_standings" AS ds
    JOIN   "races"            AS r ON r."race_id" = ds."race_id"
    WHERE  r."round" = (
           SELECT MAX(r2."round") FROM "races" AS r2 WHERE r2."year" = r."year")
      AND ds."position" = 1
  ) AS yr
JOIN  ( /* turn driver_id into full name */
    SELECT d."driver_id",
           d."forename" || ' ' || d."surname" AS "driver_full_name"
    FROM   "drivers" AS d
  ) AS drv   ON drv."driver_id" = yr."driver_id"
JOIN  ( /* constructor champions */
    SELECT r."year", cs."constructor_id", c."name" AS "constructor_name"
    FROM   "constructor_standings" AS cs
    JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
    JOIN   "constructors"          AS c ON c."constructor_id" = cs."constructor_id"
    WHERE  r."round" = (
           SELECT MAX(r2."round") FROM "races" AS r2 WHERE r2."year" = r."year")
      AND  cs."position" = 1
  ) AS con ON con."year" = yr."year"
ORDER BY yr."year"
LIMIT 20;
