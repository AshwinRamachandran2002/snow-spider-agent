    LIMIT  1
),
yearly_counts AS (                         -- new‑unicorn count per year for that industry
    SELECT year,
           COUNT(DISTINCT company_id) AS cnt
    FROM   unicorns
    WHERE  industry = (SELECT industry FROM top_industry)
    GROUP  BY year
),
years AS (                                 -- ensure all three years are present
    SELECT '2019' AS year UNION ALL
    SELECT '2020' UNION ALL
    SELECT '2021'
),
filled AS (                                -- add 0 for any missing years
    SELECT y.year,
           COALESCE(yc.cnt,0) AS cnt
    FROM   years y
    LEFT   JOIN yearly_counts yc ON y.year = yc.year
)
SELECT
    (SELECT industry FROM top_industry)        AS industry,
    AVG(cnt)                                   AS avg_new_unicorns_per_year
FROM filled;
