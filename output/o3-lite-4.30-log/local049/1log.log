Begin Exploring Related Columns
Relevant columns, their possible use, and key filter conditions
• companies_funding.company_id : join key that links the three company‑related tables  
• companies_funding.valuation  : identify “unicorns” (valuation ≥ 1 000 000 000)  
• companies_industries.company_id : join key to reach the industry name  
• companies_industries.industry  : decide which industry is the “top” one (most new unicorns)  
• companies_dates.company_id : join key to reach the date a firm became a unicorn  
• companies_dates.date_joined  : extract the year (2019‑2021) to count “new” unicorns  

Main conditions you will repeatedly see below  
1. valuation >= 1000000000                -- unicorn threshold  
2. date_joined >= '2019‑01‑01'  
3. date_joined <  '2022‑01‑01'            -- keeps 2019‑2021 inclusive  

Ten exploratory → final SQL statements (each LIMITED to 20 rows)  
```sql
-- 1️⃣ Description: look at distinct valuations at or above the unicorn cut‑off
SELECT DISTINCT valuation
FROM   companies_funding
WHERE  valuation >= 1000000000
LIMIT  20;
```

```sql
-- 2️⃣ Description: list all distinct industries available
SELECT DISTINCT industry
FROM   companies_industries
LIMIT  20;
```

```sql
-- 3️⃣ Description: sample of unicorn company_id plus their industry
SELECT DISTINCT cf.company_id,
                ci.industry
FROM   companies_funding   AS cf
JOIN   companies_industries AS ci USING (company_id)
WHERE  cf.valuation >= 1000000000
LIMIT  20;
```

```sql
-- 4️⃣ Description: how many new unicorns were created (2019‑2021) per industry
SELECT ci.industry,
       COUNT(*) AS unicorn_cnt
FROM   companies_funding   AS cf
JOIN   companies_industries AS ci USING (company_id)
JOIN   companies_dates      AS cd USING (company_id)
WHERE  cf.valuation  >= 1000000000
  AND  cd.date_joined >= '2019-01-01'
  AND  cd.date_joined <  '2022-01-01'
GROUP  BY ci.industry
ORDER  BY unicorn_cnt DESC
LIMIT  20;
```

```sql
-- 5️⃣ Description: distinct years inside the 2019‑2021 window
SELECT DISTINCT substr(cd.date_joined, 1, 4) AS year
FROM   companies_dates AS cd
WHERE  cd.date_joined >= '2019-01-01'
  AND  cd.date_joined <  '2022-01-01'
ORDER  BY year
LIMIT  20;
```

```sql
-- 6️⃣ Description: yearly count of new unicorns for one target industry ('Fintech' used as example)
SELECT substr(cd.date_joined, 1, 4) AS year,
       COUNT(*)                    AS new_unicorns
FROM   companies_funding    AS cf
JOIN   companies_industries AS ci USING (company_id)
JOIN   companies_dates      AS cd USING (company_id)
WHERE  cf.valuation  >= 1000000000
  AND  ci.industry   = 'Fintech'
  AND  cd.date_joined >= '2019-01-01'
  AND  cd.date_joined <  '2022-01-01'
GROUP  BY year
ORDER  BY year
LIMIT  20;
```

```sql
-- 7️⃣ Description: average of those yearly counts for the chosen industry
SELECT AVG(yearly_cnt) AS avg_new_unicorns
FROM (
        SELECT substr(cd.date_joined, 1, 4) AS year,
               COUNT(*) AS yearly_cnt
        FROM   companies_funding    AS cf
        JOIN   companies_industries AS ci USING (company_id)
        JOIN   companies_dates      AS cd USING (company_id)
        WHERE  cf.valuation  >= 1000000000
          AND  ci.industry   = 'Fintech'
          AND  cd.date_joined >= '2019-01-01'
          AND  cd.date_joined <  '2022-01-01'
        GROUP  BY year
     )
LIMIT 20;
```

```sql
-- 8️⃣ Description: find the single “top” industry (greatest count of new unicorns)
SELECT ci.industry,
       COUNT(*) AS unicorn_cnt
FROM   companies_funding    AS cf
JOIN   companies_industries AS ci USING (company_id)
JOIN   companies_dates      AS cd USING (company_id)
WHERE  cf.valuation  >= 1000000000
  AND  cd.date_joined >= '2019-01-01'
  AND  cd.date_joined <  '2022-01-01'
GROUP  BY ci.industry
ORDER  BY unicorn_cnt DESC
LIMIT  1;
```

```sql
-- 9️⃣ Description: compute average yearly new‑unicorns for that top industry via CTE
WITH top_industry AS (
       SELECT ci.industry
       FROM   companies_funding    AS cf
       JOIN   companies_industries AS ci USING (company_id)
       JOIN   companies_dates      AS cd USING (company_id)
       WHERE  cf.valuation  >= 1000000000
         AND  cd.date_joined >= '2019-01-01'
         AND  cd.date_joined <  '2022-01-01'
       GROUP  BY ci.industry
       ORDER  BY COUNT(*) DESC
       LIMIT  1
)
SELECT AVG(yearly_cnt) AS avg_new_unicorns
FROM (
        SELECT substr(cd.date_joined, 1, 4) AS year,
               COUNT(*) AS yearly_cnt
        FROM   companies_funding    AS cf
        JOIN   companies_industries AS ci USING (company_id)
        JOIN   companies_dates      AS cd USING (company_id)
        JOIN   top_industry   AS ti ON ci.industry = ti.industry
        WHERE  cf.valuation  >= 1000000000
          AND  cd.date_joined >= '2019-01-01'
          AND  cd.date_joined <  '2022-01-01'
        GROUP  BY year
     )
LIMIT 20;
```

```sql
-- 🔟 Description: identical goal as #9 but shows DISTINCT company_id safeguarding
SELECT AVG(yearly_cnt) AS avg_new_unicorns
FROM (
        SELECT substr(cd.date_joined, 1, 4) AS year,
               COUNT(DISTINCT cf.company_id) AS yearly_cnt
        FROM   companies_funding    AS cf
        JOIN   companies_industries AS ci USING (company_id)
        JOIN   companies_dates      AS cd USING (company_id)
        WHERE  cf.valuation  >= 1000000000
          AND  cd.date_joined BETWEEN '2019-01-01' AND '2021-12-31'
          AND  ci.industry = (
                  SELECT ci2.industry
                  FROM   companies_funding    AS cf2
                  JOIN   companies_industries AS ci2 USING (company_id)
                  JOIN   companies_dates      AS cd2 USING (company_id)
                  WHERE  cf2.valuation >= 1000000000
                    AND  cd2.date_joined BETWEEN '2019-01-01' AND '2021-12-31'
                  GROUP  BY ci2.industry
                  ORDER  BY COUNT(*) DESC
                  LIMIT  1
                )
        GROUP BY year
     )
LIMIT 20;
```

