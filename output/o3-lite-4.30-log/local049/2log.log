2025-05-01 03:16:32 - Thread-1281 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
• companies_funding.company_id: key to join with other company tables  
• companies_funding.valuation: identify “unicorns” ( valuation ≥ 1 000 000 000)  
• companies_industries.company_id: join key  
• companies_industries.industry: group companies by industry; find “top” industry (most unicorns)  
• companies_dates.company_id: join key  
• companies_dates.date_joined: filter the first‑time unicorns to the 2019‑2021 window and extract the year part  

Below are ten progressively richer inspection / analysis queries that lead to the requested result.

```sql
--Description: 1) See the different years recorded in companies_dates.date_joined
SELECT DISTINCT substr("date_joined", 1, 4) AS "year"
FROM "companies_dates"
WHERE "date_joined" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 2) Count how many companies have a valuation of at least $1 B (i.e., unicorns)
SELECT COUNT(*) AS "total_unicorns"
FROM "companies_funding"
WHERE "valuation" >= 1000000000;
```

```sql
--Description: 3) Inspect the list of distinct industries present in companies_industries
SELECT DISTINCT "industry"
FROM "companies_industries"
LIMIT 20;
```

```sql
--Description: 4) Count unicorns per industry over all time (no date filter yet)
SELECT ci."industry",
       COUNT(*) AS "unicorn_cnt"
FROM   "companies_funding" AS cf
JOIN   "companies_industries" AS ci
       ON cf."company_id" = ci."company_id"
WHERE  cf."valuation" >= 1000000000
GROUP  BY ci."industry"
ORDER  BY "unicorn_cnt" DESC
LIMIT 20;
```

```sql
--Description: 5) Same as #4 but restricted to companies that joined in 2019‑2021
SELECT ci."industry",
       COUNT(*) AS "unicorn_cnt_2019_2021"
FROM   "companies_funding"  AS cf
JOIN   "companies_industries" AS ci
       ON cf."company_id" = ci."company_id"
JOIN   "companies_dates" AS cd
       ON cf."company_id" = cd."company_id"
WHERE  cf."valuation" >= 1000000000
  AND  substr(cd."date_joined",1,4) BETWEEN '2019' AND '2021'
GROUP  BY ci."industry"
ORDER  BY "unicorn_cnt_2019_2021" DESC
LIMIT 20;
```

```sql
--Description: 6) Identify the single “top” industry (most unicorns 2019‑2021)
SELECT ci."industry"
FROM   "companies_funding"  AS cf
JOIN   "companies_industries" AS ci
       ON cf."company_id" = ci."company_id"
JOIN   "companies_dates" AS cd
       ON cf."company_id" = cd."company_id"
WHERE  cf."valuation" >= 1000000000
  AND  substr(cd."date_joined",1,4) BETWEEN '2019' AND '2021'
GROUP  BY ci."industry"
ORDER  BY COUNT(*) DESC
LIMIT 1;
```

```sql
--Description: 7) List unicorns in that top industry within 2019‑2021, with their join year
SELECT cd."company_id",
       substr(cd."date_joined",1,4) AS "year_joined"
FROM   "companies_funding"  AS cf
JOIN   "companies_industries" AS ci
       ON cf."company_id" = ci."company_id"
JOIN   "companies_dates" AS cd
       ON cf."company_id" = cd."company_id"
WHERE  cf."valuation" >= 1000000000
  AND  substr(cd."date_joined",1,4) BETWEEN '2019' AND '2021'
  AND  ci."industry" = (
        /* sub‑query returns the top industry determined in #6 */
        SELECT ci2."industry"
        FROM   "companies_funding"  AS cf2
        JOIN   "companies_industries" AS ci2
               ON cf2."company_id" = ci2."company_id"
        JOIN   "companies_dates" AS cd2
               ON cf2."company_id" = cd2."company_id"
        WHERE  cf2."valuation" >= 1000000000
          AND  substr(cd2."date_joined",1,4) BETWEEN '2019' AND '2021'
        GROUP  BY ci2."industry"
        ORDER  BY COUNT(*) DESC
        LIMIT 1
      )
LIMIT 20;
```

```sql
--Description: 8) Count how many new unicorns per year within the top industry (2019‑2021)
WITH top_ind AS (
  SELECT ci."industry"
  FROM   "companies_funding" AS cf
  JOIN   "companies_industries" AS ci ON cf."company_id" = ci."company_id"
  JOIN   "companies_dates" AS cd      ON cf."company_id" = cd."company_id"
  WHERE  cf."valuation" >= 1000000000
    AND  substr(cd."date_joined",1,4) BETWEEN '2019' AND '2021'
  GROUP  BY ci."industry"
  ORDER  BY COUNT(*) DESC
  LIMIT 1
)
SELECT substr(cd."date_joined",1,4) AS "year",
       COUNT(*) AS "new_unicorns"
FROM   "companies_funding"  AS cf
JOIN   "companies_industries" AS ci ON cf."company_id" = ci."company_id"
JOIN   "companies_dates" AS cd      ON cf."company_id" = cd."company_id"
JOIN   top_ind                       ON ci."industry" = top_ind."industry"
WHERE  cf."valuation" >= 1000000000
  AND  substr(cd."date_joined",1,4) BETWEEN '2019' AND '2021'
GROUP  BY "year"
ORDER  BY "year"
LIMIT 20;
```

```sql
--Description: 9) Compute the average of the yearly counts from query #8
WITH top_ind AS (
  SELECT ci."industry"
  FROM   "companies_funding" AS cf
  JOIN   "companies_industries" AS ci ON cf."company_id" = ci."company_id"
  JOIN   "companies_dates" AS cd      ON cf."company_id" = cd."company_id"
  WHERE  cf."valuation" >= 1000000000
    AND  substr(cd."date_joined",1,4) BETWEEN '2019' AND '2021'
  GROUP  BY ci."industry"
  ORDER  BY COUNT(*) DESC
  LIMIT 1
),
per_year AS (
  SELECT substr(cd."date_joined",1,4) AS "year",
         COUNT(*) AS "new_unicorns"
  FROM   "companies_funding"  AS cf
  JOIN   "companies_industries" AS ci ON cf."company_id" = ci."company_id"
  JOIN   "companies_dates" AS cd      ON cf."company_id" = cd."company_id"
  JOIN   top_ind                       ON ci."industry" = top_ind."industry"
  WHERE  cf."valuation" >= 1000000000
    AND  substr(cd."date_joined",1,4) BETWEEN '2019' AND '2021'
  GROUP  BY "year"
)
SELECT AVG("new_unicorns") AS "avg_new_unicorns_per_year"
FROM   per_year;
```

```sql
--Description: 10) One‑liner alternative combining everything: average new unicorns (2019‑2021) for the top industry
SELECT AVG("cnt") AS "avg_new_unicorns_per_year"
FROM (
  SELECT substr(cd."date_joined",1,4) AS "yr",
         COUNT(*)                     AS "cnt"
  FROM   "companies_funding"  AS cf
  JOIN   "companies_industries" AS ci ON cf."company_id" = ci."company_id"
  JOIN   "companies_dates" AS cd      ON cf."company_id" = cd."company_id"
  WHERE  cf."valuation" >= 1000000000
    AND  substr(cd."date_joined",1,4) BETWEEN '2019' AND '2021'
    AND  ci."industry" = (
          SELECT ci2."industry"
          FROM   "companies_funding"  AS cf2
          JOIN   "companies_industries" AS ci2 ON cf2."company_id" = ci2."company_id"
          JOIN   "companies_dates" AS cd2      ON cf2."company_id" = cd2."company_id"
          WHERE  cf2."valuation" >= 1000000000
            AND  substr(cd2."date_joined",1,4) BETWEEN '2019' AND '2021'
          GROUP  BY ci2."industry"
          ORDER  BY COUNT(*) DESC
          LIMIT 1
        )
  GROUP  BY "yr"
);
```
