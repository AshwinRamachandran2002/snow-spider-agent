Relevant columns and their potential usage  

bigquery-public-data.noaa_gsod.gsod2023  
• stn / wban :  keys to join with the stations table  
• date :  filter for every day in October 2023 (WHERE DATE BETWEEN '2023-10-01' AND '2023-10-31')  
• max :  maximum daily temperature (ignore rows where max = 9999.9)  
• min :  minimum daily temperature (ignore rows where min = 9999.9)  
• temp :  mean daily temperature (ignore rows where temp = 9999.9)  

bigquery-public-data.noaa_gsod.stations  
• usaf / wban :  station identifiers; join with gsod2023.stn / gsod2023.wban  
• country :  keep only 'US' and 'UK' stations  

Typical filtering conditions  
• country IN ('US','UK')  
• DATE(date) BETWEEN '2023‑10‑01' AND '2023‑10‑31'  
• max  <> 9999.9 AND min <> 9999.9 AND temp <> 9999.9   

Below are ten exploratory → increasingly complex SQL queries (each capped with LIMIT 20) that culminate in computing the requested day‑by‑day temperature differences for October 2023.

```sql
-- 1) Quick look at a few October‑2023 GSOD records
SELECT *
FROM `bigquery-public-data.noaa_gsod.gsod2023`
WHERE date BETWEEN '2023-10-01' AND '2023-10-31'
LIMIT 20;
```

```sql
-- 2) Peek at US and UK rows in the stations table
SELECT usaf, wban, name, country
FROM `bigquery-public-data.noaa_gsod.stations`
WHERE country IN ('US','UK')
LIMIT 20;
```

```sql
-- 3) Count how many 2023 stations each country has
SELECT country, COUNT(*) AS station_cnt
FROM `bigquery-public-data.noaa_gsod.stations`
WHERE country IN ('US','UK')
GROUP BY country
LIMIT 20;
```

```sql
-- 4) Validate that the station key (usaf,wban) matches the GSOD table
SELECT g.stn, g.wban, s.usaf, s.wban, s.country
FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn = s.usaf AND g.wban = s.wban
WHERE s.country IN ('US','UK')
LIMIT 20;
```

```sql
-- 5) Examine temperature value ranges and spot invalid codes
SELECT MAX(max)  AS max_of_max, MIN(max)  AS min_of_max,
       MAX(min)  AS max_of_min, MIN(min)  AS min_of_min,
       MAX(temp) AS max_of_avg, MIN(temp) AS min_of_avg
FROM `bigquery-public-data.noaa_gsod.gsod2023`
LIMIT 20;
```

```sql
-- 6) Fetch valid‑temperature readings for a couple of US stations in October
SELECT g.date, g.stn, g.wban, g.max, g.min, g.temp
FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn = s.usaf AND g.wban = s.wban
WHERE s.country = 'US'
  AND g.date BETWEEN '2023-10-01' AND '2023-10-31'
  AND g.max  <> 9999.9
  AND g.min  <> 9999.9
  AND g.temp <> 9999.9
LIMIT 20;
```

```sql
-- 7) Same, but UK stations
SELECT g.date, g.stn, g.wban, g.max, g.min, g.temp
FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn = s.usaf AND g.wban = s.wban
WHERE s.country = 'UK'
  AND g.date BETWEEN '2023-10-01' AND '2023-10-31'
  AND g.max  <> 9999.9
  AND g.min  <> 9999.9
  AND g.temp <> 9999.9
LIMIT 20;
```

```sql
-- 8) Aggregate daily temperatures by country
SELECT
  g.date,
  s.country,
  AVG(g.max)  AS country_max,
  AVG(g.min)  AS country_min,
  AVG(g.temp) AS country_avg
FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn = s.usaf AND g.wban = s.wban
WHERE s.country IN ('US','UK')
  AND g.date BETWEEN '2023-10-01' AND '2023-10-31'
  AND g.max  <> 9999.9
  AND g.min  <> 9999.9
  AND g.temp <> 9999.9
GROUP BY g.date, s.country
ORDER BY g.date, s.country
LIMIT 20;
```

```sql
-- 9) Put US & UK daily numbers side‑by‑side
WITH country_day AS (
  SELECT
    g.date,
    s.country,
    AVG(g.max)  AS max_t,
    AVG(g.min)  AS min_t,
    AVG(g.temp) AS avg_t
  FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE s.country IN ('US','UK')
    AND g.date BETWEEN '2023-10-01' AND '2023-10-31'
    AND g.max  <> 9999.9
    AND g.min  <> 9999.9
    AND g.temp <> 9999.9
  GROUP BY g.date, s.country
)
SELECT
  d.date,
  MAX(CASE WHEN country = 'US' THEN max_t END)  AS us_max,
  MAX(CASE WHEN country = 'UK' THEN max_t END)  AS uk_max,
  MAX(CASE WHEN country = 'US' THEN min_t END)  AS us_min,
  MAX(CASE WHEN country = 'UK' THEN min_t END)  AS uk_min,
  MAX(CASE WHEN country = 'US' THEN avg_t END)  AS us_avg,
  MAX(CASE WHEN country = 'UK' THEN avg_t END)  AS uk_avg
FROM country_day d
GROUP BY d.date
ORDER BY d.date
LIMIT 20;
```

```sql
-- 10) FINAL – compute the day‑by‑day differences (US minus UK) for max, min, and average temperatures in October 2023
WITH country_day AS (
  SELECT
    g.date,
    s.country,
    AVG(g.max)  AS max_t,
    AVG(g.min)  AS min_t,
    AVG(g.temp) AS avg_t
  FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE s.country IN ('US','UK')
    AND g.date BETWEEN '2023-10-01' AND '2023-10-31'
    AND g.max  <> 9999.9
    AND g.min  <> 9999.9
    AND g.temp <> 9999.9
  GROUP BY g.date, s.country
), pivot AS (
  SELECT
    date,
    MAX(CASE WHEN country = 'US' THEN max_t END)  AS us_max,
    MAX(CASE WHEN country = 'UK' THEN max_t END)  AS uk_max,
    MAX(CASE WHEN country = 'US' THEN min_t END)  AS us_min,
    MAX(CASE WHEN country = 'UK' THEN min_t END)  AS uk_min,
    MAX(CASE WHEN country = 'US' THEN avg_t END)  AS us_avg,
    MAX(CASE WHEN country = 'UK' THEN avg_t END)  AS uk_avg
  FROM country_day
  GROUP BY date
)
SELECT
  date,
  us_max - uk_max AS diff_max,
  us_min - uk_min AS diff_min,
  us_avg - uk_avg AS diff_avg
FROM pivot
ORDER BY date
LIMIT 20;
```

The tenth query returns, for every day in October 2023, the difference (US minus UK) in daily maximum, minimum, and mean temperatures, while excluding any rows that contained the GSOD “missing value” codes.
