FROM `bigquery-public-data.noaa_gsod.stations`
ORDER BY country
LIMIT 20;
```

```sql
-- 2️⃣  Description: inspect 20 joined US records in October‑2023 (basic join)
SELECT g.stn, g.wban, g.date, g.temp, g.max, g.min, s.country
FROM   `bigquery-public-data.nooa_gsod.gsod2023` AS g
JOIN   `bigquery-public-data.noaa_gsod.stations` AS s
  ON s.usaf = g.stn AND s.wban = g.wban
WHERE  g.date BETWEEN '2023-10-01' AND '2023-10-31'
  AND  s.country = 'US'
LIMIT 20;
```

```sql
-- 3️⃣  Description: inspect 20 joined UK records in October‑2023
SELECT g.stn, g.wban, g.date, g.temp, g.max, g.min, s.country
FROM   `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN   `bigquery-public-data.noaa_gsod.stations` AS s
  ON s.usaf = g.stn AND s.wban = g.wban
WHERE  g.date BETWEEN '2023-10-01' AND '2023-10-31'
  AND  s.country = 'UK'
LIMIT 20;
```

```sql
-- 4️⃣  Description: count distinct reporting stations in Oct‑2023 for the US and UK
SELECT s.country,
       COUNT(DISTINCT CONCAT(g.stn,'-',g.wban)) AS station_cnt
FROM   `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN   `bigquery-public-data.noaa_gsod.stations` AS s
  ON s.usaf = g.stn AND s.wban = g.wban
WHERE  g.date BETWEEN '2023-10-01' AND '2023-10-31'
  AND  s.country IN ('US','UK')
GROUP  BY s.country
LIMIT 20;
```

```sql
-- 5️⃣  Description: daily average of mean temperature for US stations (quality‑checked)
SELECT g.date,
       AVG(g.temp) AS us_avg_temp
FROM   `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN   `bigquery-public-data.noaa_gsod.stations` AS s
  ON s.usaf = g.stn AND s.wban = g.wban
WHERE  g.date BETWEEN '2023-10-01' AND '2023-10-31'
  AND  s.country = 'US'
  AND  g.temp < 9999
GROUP  BY g.date
ORDER  BY g.date
LIMIT 20;
```

```sql
-- 6️⃣  Description: daily average of mean temperature for UK stations (quality‑checked)
SELECT g.date,
       AVG(g.temp) AS uk_avg_temp
FROM   `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN   `bigquery-public-data.noaa_gsod.stations` AS s
  ON s.usaf = g.stn AND s.wban = g.wban
WHERE  g.date BETWEEN '2023-10-01' AND '2023-10-31'
  AND  s.country = 'UK'
  AND  g.temp < 9999
GROUP  BY g.date
ORDER  BY g.date
LIMIT 20;
```

```sql
-- 7️⃣  Description: daily mean of maximum temperature for US & UK (side‑by‑side)
SELECT g.date,
       AVG(CASE WHEN s.country = 'US' THEN g.max END) AS us_avg_max,
       AVG(CASE WHEN s.country = 'UK' THEN g.max END) AS uk_avg_max
FROM   `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN   `bigquery-public-data.noaa_gsod.stations` AS s
  ON s.usaf = g.stn AND s.wban = g.wban
WHERE  g.date BETWEEN '2023-10-01' AND '2023-10-31'
  AND  s.country IN ('US','UK')
  AND  g.max < 9999
GROUP BY g.date
ORDER BY g.date
LIMIT 20;
```

```sql
-- 8️⃣  Description: daily mean of minimum temperature for US & UK
SELECT g.date,
       AVG(CASE WHEN s.country = 'US' THEN g.min END) AS us_avg_min,
       AVG(CASE WHEN s.country = 'UK' THEN g.min END) AS uk_avg_min
FROM   `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN   `bigquery-public-data.noaa_gsod.stations` AS s
  ON s.usaf = g.stn AND s.wban = g.wban
WHERE  g.date BETWEEN '2023-10-01' AND '2023-10-31'
  AND  s.country IN ('US','UK')
  AND  g.min < 9999
GROUP BY g.date
ORDER BY g.date
LIMIT 20;
```

```sql
-- 9️⃣  Description: combine mean‑temp, max‑temp, min‑temp for US and UK into one CTE
WITH daily AS (
  SELECT g.date,
         s.country,
         AVG(g.temp) AS avg_temp,
         AVG(g.max)  AS avg_max,
         AVG(g.min)  AS avg_min
  FROM   `bigquery-public-data.noaa_gsod.gsod2023` AS g
  JOIN   `bigquery-public-data.noaa_gsod.stations` AS s
    ON s.usaf = g.stn AND s.wban = g.wban
  WHERE  g.date BETWEEN '2023-10-01' AND '2023-10-31'
    AND  s.country IN ('US','UK')
    AND  g.temp < 9999 AND g.max < 9999 AND g.min < 9999
  GROUP  BY g.date, s.country
)
SELECT *
FROM   daily
ORDER  BY date, country
LIMIT 20;
```

```sql
-- 🔟  Description: FINAL – for each day in October‑2023, show the difference
--                 (US minus UK) in average, max, and min temperatures
WITH daily AS (
  SELECT g.date,
         s.country,
         AVG(g.temp) AS avg_temp,
         AVG(g.max)  AS avg_max,
         AVG(g.min)  AS avg_min
  FROM   `bigquery-public-data.noaa_gsod.gsod2023` AS g
  JOIN   `bigquery-public-data.noaa_gsod.stations` AS s
    ON s.usaf = g.stn AND s.wban = g.wban
  WHERE  g.date BETWEEN '2023-10-01' AND '2023-10-31'
    AND  s.country IN ('US','UK')
    AND  g.temp < 9999 AND g.max < 9999 AND g.min < 9999
  GROUP  BY g.date, s.country
),
pivot AS (
  SELECT date,
         MAX(CASE WHEN country = 'US' THEN avg_temp END) AS us_avg_temp,
         MAX(CASE WHEN country = 'UK' THEN avg_temp END) AS uk_avg_temp,
         MAX(CASE WHEN country = 'US' THEN avg_max  END) AS us_avg_max,
         MAX(CASE WHEN country = 'UK' THEN avg_max  END) AS uk_avg_max,
         MAX(CASE WHEN country = 'US' THEN avg_min  END) AS us_avg_min,
         MAX(CASE WHEN country = 'UK' THEN avg_min  END) AS uk_avg_min
  FROM   daily
  GROUP  BY date
)
SELECT date,
       ROUND(us_avg_temp - uk_avg_temp, 2) AS diff_avg_temp,
       ROUND(us_avg_max  - uk_avg_max , 2) AS diff_max_temp,
       ROUND(us_avg_min  - uk_avg_min , 2) AS diff_min_temp
FROM   pivot
ORDER  BY date
LIMIT 20;
```


Each query is capped with `LIMIT 20` so they can be run safely and inspected before scaling up.
