Ten exploratory → final BigQuery SQL snippets
--------------------------------------------------------------------

```sql
-- 1. Description: List any October‑2023 rows to see date format.
SELECT DISTINCT `date`
FROM `bigquery-public-data.noaa_gsod.gsod2023`
WHERE `date` BETWEEN '2023-10-01' AND '2023-10-31'
ORDER BY `date`
LIMIT 20;
```

```sql
-- 2. Description: Inspect which ISO country codes exist for US / UK stations.
SELECT DISTINCT country
FROM `bigquery-public-data.noaa_gsod.stations`
WHERE country IN ('US','UK','GB')
ORDER BY country;
```

```sql
-- 3. Description: Sample one October‑2023 record for a U.S. station.
SELECT g.*
FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn = s.usaf AND g.wban = s.wban
WHERE s.country = 'US'
  AND g.date = '2023-10-15'
LIMIT 20;
```

```sql
-- 4. Description: Average October‑2023 mean temperature for all U.S. stations.
SELECT AVG(g.temp) AS us_oct_avg_temp
FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn = s.usaf AND g.wban = s.wban
WHERE s.country = 'US'
  AND g.date BETWEEN '2023-10-01' AND '2023-10-31'
  AND g.temp <> 9999.9;
```

```sql
-- 5. Description: Same metric for United Kingdom stations.
SELECT AVG(g.temp) AS uk_oct_avg_temp
FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn = s.usaf AND g.wban = s.wban
WHERE s.country IN ('UK','GB')
  AND g.date BETWEEN '2023-10-01' AND '2023-10-31'
  AND g.temp <> 9999.9;
```

```sql
-- 6. Description: Daily average of mean temperature for U.S. stations.
SELECT g.date,
       AVG(g.temp) AS us_daily_avg_temp
FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn = s.usaf AND g.wban = s.wban
WHERE s.country = 'US'
  AND g.date BETWEEN '2023-10-01' AND '2023-10-31'
  AND g.temp <> 9999.9
GROUP BY g.date
ORDER BY g.date
LIMIT 20;
```

```sql
-- 7. Description: Daily average of mean temperature for U.K. stations.
SELECT g.date,
       AVG(g.temp) AS uk_daily_avg_temp
FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn = s.usaf AND g.wban = s.wban
WHERE s.country IN ('UK','GB')
  AND g.date BETWEEN '2023-10-01' AND '2023-10-31'
  AND g.temp <> 9999.9
GROUP BY g.date
ORDER BY g.date
LIMIT 20;
```

```sql
-- 8. Description: Daily difference (US minus UK) for mean temperature only.
WITH base AS (
  SELECT g.date,
         s.country,
         AVG(g.temp) AS avg_temp
  FROM `bigquery-public-data.noaa_gsod.gsod2023` g
  JOIN `bigquery-public-data.noaa_gsod.stations` s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE g.date BETWEEN '2023-10-01' AND '2023-10-31'
    AND g.temp <> 9999.9
    AND s.country IN ('US','UK','GB')
  GROUP BY g.date, s.country
)
SELECT b1.date,
       b1.avg_temp AS us_avg_temp,
       b2.avg_temp AS uk_avg_temp,
       b1.avg_temp - b2.avg_temp AS diff_avg_temp
FROM base b1
JOIN base b2
  ON b1.date = b2.date
WHERE b1.country = 'US'
  AND b2.country IN ('UK','GB')
ORDER BY b1.date
LIMIT 20;
```

```sql
-- 9. Description: Same idea but for maximum and minimum temperatures.
WITH valid AS (
  SELECT g.date,
         s.country,
         AVG(g.max) AS avg_max,
         AVG(g.min) AS avg_min
  FROM `bigquery-public-data.noaa_gsod.gsod2023` g
  JOIN `bigquery-public-data.noaa_gsod.stations` s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE g.date BETWEEN '2023-10-01' AND '2023-10-31'
    AND g.max <> 9999.9
    AND g.min <> 9999.9
    AND s.country IN ('US','UK','GB')
  GROUP BY g.date, s.country
)
SELECT v1.date,
       v1.avg_max - v2.avg_max AS diff_max,
       v1.avg_min - v2.avg_min AS diff_min
FROM valid v1
JOIN valid v2
  ON v1.date = v2.date
WHERE v1.country = 'US'
  AND v2.country IN ('UK','GB')
ORDER BY v1.date
LIMIT 20;
```

```sql
-- 10. Description: FINAL ANSWER —
-- Per‑day (Oct‑2023) difference of average, max and min temperatures
-- between United States and United Kingdom stations.
WITH good AS (
  SELECT
    g.date,
    s.country,
    g.max,
    g.min,
    g.temp
  FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations`   AS s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE g.date BETWEEN '2023-10-01' AND '2023-10-31'
    AND g.max <> 9999.9
    AND g.min <> 9999.9
    AND g.temp <> 9999.9
    AND s.country IN ('US','UK','GB')
), agg AS (
  SELECT
    date,
    country,
    AVG(max)  AS avg_max,
    AVG(min)  AS avg_min,
    AVG(temp) AS avg_temp
  FROM good
  GROUP BY date, country
), piv AS (
  SELECT
    date,
    MAX(CASE WHEN country = 'US' THEN avg_max END)  AS us_max,
    MAX(CASE WHEN country IN ('UK','GB') THEN avg_max END) AS uk_max,
    MAX(CASE WHEN country = 'US' THEN avg_min END)  AS us_min,
    MAX(CASE WHEN country IN ('UK','GB') THEN avg_min END) AS uk_min,
    MAX(CASE WHEN country = 'US' THEN avg_temp END) AS us_avg,
    MAX(CASE WHEN country IN ('UK','GB') THEN avg_temp END) AS uk_avg
  FROM agg
  GROUP BY date
)
SELECT
  date,
  us_max - uk_max  AS diff_max,
  us_min - uk_min  AS diff_min,
  us_avg - uk_avg  AS diff_avg
FROM piv
ORDER BY date;
```

