Query:
-- 10. Description: FINAL ANSWER —
-- Per‑day (Oct‑2023) difference of average, max and min temperatures
-- between United States and United Kingdom stations.
WITH good AS (
  SELECT
    g.date,
    s.country,
    g.max,
    g.min,
    g.temp
  FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations`   AS s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE g.date BETWEEN '2023-10-01' AND '2023-10-31'
    AND g.max <> 9999.9
    AND g.min <> 9999.9
    AND g.temp <> 9999.9
    AND s.country IN ('US','UK','GB')
), agg AS (
  SELECT
    date,
    country,
    AVG(max)  AS avg_max,
    AVG(min)  AS avg_min,
    AVG(temp) AS avg_temp
  FROM good
  GROUP BY date, country
), piv AS (
  SELECT
    date,
    MAX(CASE WHEN country = 'US' THEN avg_max END)  AS us_max,
    MAX(CASE WHEN country IN ('UK','GB') THEN avg_max END) AS uk_max,
    MAX(CASE WHEN country = 'US' THEN avg_min END)  AS us_min,
    MAX(CASE WHEN country IN ('UK','GB') THEN avg_min END) AS uk_min,
    MAX(CASE WHEN country = 'US' THEN avg_temp END) AS us_avg,
    MAX(CASE WHEN country IN ('UK','GB') THEN avg_temp END) AS uk_avg
  FROM agg
  GROUP BY date
)
SELECT
  date,
  us_max - uk_max  AS diff_max,
  us_min - uk_min  AS diff_min,
  us_avg - uk_avg  AS diff_avg
FROM piv
ORDER BY date;
