Begin Exploring Related Columns
Relevant tables / columns and their usage
• cities.city_name : returns the city that had a row recorded on a given day  
• cities.country_code_2 : lets us keep only Chinese records ( = 'cn' )  
• cities.insert_date : the calendar day we are going to line‑up into consecutive‑date streaks  
• (auxiliary) julianday(insert_date) : numeric form of the date, handy for gaps‑in‑dates logic  

Main filter conditions that will be used
country_code_2 = 'cn'  
insert_date BETWEEN '2021‑07‑01' AND '2021‑07‑31'  

────────────────────────
Exploratory → progressively complex SQL snippets
────────────────────────

```sql
-- 1) Peek at every country code that exists in the cities table
SELECT DISTINCT country_code_2
FROM cities
LIMIT 20;
```

```sql
-- 2) Inspect a handful of Chinese city rows
SELECT city_name, insert_date
FROM cities
WHERE country_code_2 = 'cn'
LIMIT 20;
```

```sql
-- 3) Check which July‑2021 dates exist for China
SELECT DISTINCT insert_date
FROM cities
WHERE country_code_2 = 'cn'
  AND insert_date BETWEEN '2021-07-01' AND '2021-07-31'
ORDER BY insert_date
LIMIT 20;
```

```sql
-- 4) How many Chinese records were inserted per July‑2021 day?
SELECT insert_date, COUNT(*) AS rows_in_that_day
FROM cities
WHERE country_code_2 = 'cn'
  AND insert_date BETWEEN '2021-07-01' AND '2021-07-31'
GROUP BY insert_date
ORDER BY insert_date
LIMIT 20;
```

```sql
-- 5) Full list of Chinese rows inside July‑2021 (date + city)
SELECT insert_date, city_name
FROM cities
WHERE country_code_2 = 'cn'
  AND insert_date BETWEEN '2021-07-01' AND '2021-07-31'
ORDER BY insert_date, city_name
LIMIT 20;
```

```sql
-- 6) Give each DISTINCT date a running row number (to prepare gap logic)
WITH d AS (
  SELECT DISTINCT insert_date
  FROM cities
  WHERE country_code_2 = 'cn'
    AND insert_date BETWEEN '2021-07-01' AND '2021-07-31'
)
SELECT insert_date,
       ROW_NUMBER() OVER (ORDER BY insert_date) AS rn
FROM d
ORDER BY insert_date
LIMIT 20;
```

```sql
-- 7) Tag every date with a "group id":  julianday(date) - rn  (stays constant inside a streak)
WITH d AS (
  SELECT DISTINCT insert_date
  FROM cities
  WHERE country_code_2 = 'cn'
    AND insert_date BETWEEN '2021-07-01' AND '2021-07-31'
),
tagged AS (
  SELECT insert_date,
         ROW_NUMBER() OVER (ORDER BY insert_date)               AS rn,
         julianday(insert_date) - 
         ROW_NUMBER() OVER (ORDER BY insert_date)               AS grp_id
  FROM d
)
SELECT *
FROM tagged
ORDER BY insert_date
LIMIT 20;
```

```sql
-- 8) Measure every streak’s length
WITH d AS (
  SELECT DISTINCT insert_date
  FROM cities
  WHERE country_code_2 = 'cn'
    AND insert_date BETWEEN '2021-07-01' AND '2021-07-31'
),
tagged AS (
  SELECT insert_date,
         julianday(insert_date) - 
         ROW_NUMBER() OVER (ORDER BY insert_date) AS grp_id
  FROM d
),
streaks AS (
  SELECT grp_id,
         MIN(insert_date)  AS start_date,
         MAX(insert_date)  AS end_date,
         COUNT(*)          AS streak_len
  FROM tagged
  GROUP BY grp_id
)
SELECT *
FROM streaks
ORDER BY streak_len, start_date
LIMIT 20;
```

```sql
-- 9) Identify the numerical size of the shortest & longest streaks
WITH d AS (
  SELECT DISTINCT insert_date
  FROM cities
  WHERE country_code_2 = 'cn'
    AND insert_date BETWEEN '2021-07-01' AND '2021-07-31'
),
tagged AS (
  SELECT insert_date,
         julianday(insert_date) - 
         ROW_NUMBER() OVER (ORDER BY insert_date) AS grp_id
  FROM d
),
streaks AS (
  SELECT grp_id, COUNT(*) AS streak_len
  FROM tagged
  GROUP BY grp_id
)
SELECT MIN(streak_len) AS min_streak,
       MAX(streak_len) AS max_streak
FROM streaks;
```

```sql
-- 10) FINAL – dates & city (one per day) for both the shortest
--     and the longest July‑2021 Chinese consecutive‑date streaks
WITH china AS (
  SELECT insert_date, city_name
  FROM cities
  WHERE country_code_2 = 'cn'
    AND insert_date BETWEEN '2021-07-01' AND '2021-07-31'
),
d AS (                      -- distinct calendar days
  SELECT DISTINCT insert_date
  FROM china
),
tagged AS (                 -- group id = constant inside a run
  SELECT insert_date,
         julianday(insert_date) -
         ROW_NUMBER() OVER (ORDER BY insert_date) AS grp_id
  FROM d
),
streaks AS (                -- length of every run
  SELECT grp_id, COUNT(*) AS streak_len
  FROM tagged
  GROUP BY grp_id
),
extremes AS (               -- numeric shortest / longest values
  SELECT MIN(streak_len) AS min_len,
         MAX(streak_len) AS max_len
  FROM streaks
),
wanted AS (                 -- the specific group(s) we need
  SELECT grp_id, streak_len
  FROM streaks, extremes
  WHERE streak_len = min_len OR streak_len = max_len
),
final_dates AS (            -- calendar days that belong to those runs
  SELECT t.insert_date, w.streak_len
  FROM tagged t
  JOIN wanted w ON t.grp_id = w.grp_id
)
SELECT fd.insert_date,
       -- Capitalize: first letter upper‑case, rest lower‑case
       substr(upper(c.city_name),1,1) || lower(substr(c.city_name,2)) AS city_name
FROM final_dates fd
JOIN china c ON c.insert_date = fd.insert_date
-- one record per date: ROW_NUMBER() = 1 gives us “any” city for that date
WHERE (                          -- pick the first city alphabetically per date
  SELECT 1
  FROM china c2
  WHERE c2.insert_date = fd.insert_date
  ORDER BY lower(c2.city_name)
  LIMIT 1
) = 1
ORDER BY fd.streak_len, fd.insert_date;
```

The last query gathers exactly one city per calendar day belonging to (a) the shortest and (b) the longest uninterrupted July‑2021 date sequences for Chinese cities, capitalises the city names correctly, and lists the dates in order.
