Query:
-- 10) FINAL – dates & city (one per day) for both the shortest
--     and the longest July‑2021 Chinese consecutive‑date streaks
WITH china AS (
  SELECT insert_date, city_name
  FROM cities
  WHERE country_code_2 = 'cn'
    AND insert_date BETWEEN '2021-07-01' AND '2021-07-31'
),
d AS (                      -- distinct calendar days
  SELECT DISTINCT insert_date
  FROM china
),
tagged AS (                 -- group id = constant inside a run
  SELECT insert_date,
         julianday(insert_date) -
         ROW_NUMBER() OVER (ORDER BY insert_date) AS grp_id
  FROM d
),
streaks AS (                -- length of every run
  SELECT grp_id, COUNT(*) AS streak_len
  FROM tagged
  GROUP BY grp_id
),
extremes AS (               -- numeric shortest / longest values
  SELECT MIN(streak_len) AS min_len,
         MAX(streak_len) AS max_len
  FROM streaks
),
wanted AS (                 -- the specific group(s) we need
  SELECT grp_id, streak_len
  FROM streaks, extremes
  WHERE streak_len = min_len OR streak_len = max_len
),
final_dates AS (            -- calendar days that belong to those runs
  SELECT t.insert_date, w.streak_len
  FROM tagged t
  JOIN wanted w ON t.grp_id = w.grp_id
)
SELECT fd.insert_date,
       -- Capitalize: first letter upper‑case, rest lower‑case
       substr(upper(c.city_name),1,1) || lower(substr(c.city_name,2)) AS city_name
FROM final_dates fd
JOIN china c ON c.insert_date = fd.insert_date
-- one record per date: ROW_NUMBER() = 1 gives us “any” city for that date
WHERE (                          -- pick the first city alphabetically per date
  SELECT 1
  FROM china c2
  WHERE c2.insert_date = fd.insert_date
  ORDER BY lower(c2.city_name)
  LIMIT 1
) = 1
ORDER BY fd.streak_len, fd.insert_date;
