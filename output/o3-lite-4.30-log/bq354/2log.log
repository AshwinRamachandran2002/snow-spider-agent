```sql
-- 10. **Final production answer** – identical to #8 but without LIMIT,
--     returns precisely the requested % for each disease family
WITH roots AS (
  SELECT concept_id, concept_code
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE vocabulary_id='ICD10CM' AND concept_code IN ('L70','L20','L40','L80')
),
descendants AS (
  SELECT r.concept_code AS root_code, ca.descendant_concept_id
  FROM roots AS r
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
    ON ca.ancestor_concept_id = r.concept_id
),
root_counts AS (
  SELECT d.root_code,
         COUNT(DISTINCT co.person_id) AS n_persons
  FROM descendants d
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
    ON co.condition_concept_id = d.descendant_concept_id
  GROUP BY d.root_code
),
total AS (
  SELECT COUNT(DISTINCT person_id) AS tot
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.person`
)
SELECT rc.root_code                                    AS icd10cm_family,
       rc.n_persons                                    AS participants,
       t.tot                                           AS total_participants,
       ROUND(SAFE_DIVIDE(rc.n_persons, t.tot)*100,2)   AS pct_participants
FROM root_counts rc CROSS JOIN total t
ORDER BY icd10cm_family;
```

