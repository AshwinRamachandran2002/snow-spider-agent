Query:
--Description: Count distinct participants with at least one acne diagnosis by
--             (1) finding all non‑standard ICD‑10‑CM concepts whose code starts
--             with L70, (2) translating them to their standard concepts via
--             the “Maps to” relationship, and (3) counting condition_occurrence
--             rows whose condition_concept_id is in that translated set.
WITH l70_std AS (
  SELECT DISTINCT cr.concept_id_2 AS std_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`              AS icd
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` AS cr
    ON cr.concept_id_1 = icd.concept_id
   AND cr.relationship_id = 'Maps to'
  WHERE icd.vocabulary_id = 'ICD10CM'
    AND icd.concept_code  LIKE 'L70%'            -- acne family ICD‑10‑CM
    AND cr.concept_id_2 <> 0                     -- valid mapping
)
SELECT COUNT(DISTINCT person_id) AS acne_participants
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
WHERE  condition_concept_id IN (SELECT std_id FROM l70_std)
