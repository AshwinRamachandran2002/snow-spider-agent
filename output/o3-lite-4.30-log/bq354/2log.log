```sql
--Description: Concept_ancestor is empty for non‑standard ICD‑10‑CM concepts such as L70, L20, L40, L80.
--             However, these codes *do* appear exactly in condition_occurrence.condition_source_value.
--             This query therefore:
--               1) Counts distinct participants whose source diagnosis code starts with each family prefix.
--               2) Retrieves the total participant count from the person table.
--               3) Calculates the percentage of the population represented by each dermatologic family.
WITH family_counts AS (
  SELECT 'L70' AS family, COUNT(DISTINCT person_id) AS n_participants
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
  WHERE  condition_source_value LIKE 'L70%'

  UNION ALL
  SELECT 'L20', COUNT(DISTINCT person_id)
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
  WHERE  condition_source_value LIKE 'L20%'

  UNION ALL
  SELECT 'L40', COUNT(DISTINCT person_id)
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
