```sql
-- 9. Same as #8 but also include a row for "Any of the four dermatologic diseases"
WITH roots AS (
  SELECT concept_id, concept_code
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE vocabulary_id='ICD10CM' AND concept_code IN ('L70','L20','L40','L80')
),
descendants AS (
  SELECT concept_code AS root_code, descendant_concept_id
  FROM roots
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor`
       USING (concept_id)
),
persons_by_root AS (
  SELECT root_code, person_id
  FROM descendants
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
       USING (descendant_concept_id)
  GROUP BY root_code, person_id
),
root_counts AS (
  SELECT root_code, COUNT(*) AS n_persons
  FROM persons_by_root
  GROUP BY root_code
),
any_disease AS (
  SELECT 'ANY_L20_L40_L70_L80' AS root_code,
         COUNT(DISTINCT person_id) AS n_persons
  FROM persons_by_root
),
union_counts AS (
  SELECT * FROM root_counts
  UNION ALL
  SELECT * FROM any_disease
),
total AS (
  SELECT COUNT(*) AS tot FROM `bigquery-public-data.cms_synthetic_patient_data_omop.person`
)
SELECT root_code, n_persons,
       SAFE_DIVIDE(n_persons, tot)*100 AS pct_participants
FROM union_counts, total
ORDER BY root_code
LIMIT 20;
