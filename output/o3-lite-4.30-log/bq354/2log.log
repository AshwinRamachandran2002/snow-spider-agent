```sql
--Description: Participant counts and percentages for each dermatologic ICD‑10‑CM
--             family (L70, L20, L40, L80).  For each family, map its ICD‑10‑CM
--             codes to standard concepts via “Maps to”, then count distinct
--             persons with those standard concepts in condition_occurrence.
WITH families AS (
  SELECT 'L70' AS fam UNION ALL
  SELECT 'L20' UNION ALL
  SELECT 'L40' UNION ALL
  SELECT 'L80'
),
mapped AS (
  SELECT f.fam,
         DISTINCT cr.concept_id_2 AS std_id
  FROM families AS f
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept`              AS icd
    ON icd.vocabulary_id = 'ICD10CM'
   AND icd.concept_code  LIKE CONCAT(f.fam, '%')
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` AS cr
    ON cr.concept_id_1 = icd.concept_id
   AND cr.relationship_id = 'Maps to'
  WHERE cr.concept_id_2 <> 0
),
family_counts AS (
  SELECT m.fam,
         COUNT(DISTINCT co.person_id) AS n_participants
  FROM   mapped AS m
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` AS co
    ON   co.condition_concept_id = m.std_id
  GROUP  BY m.fam
),
tot AS (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.person`
)
SELECT
  fc.fam                              AS icd10cm_family,
  fc.n_participants,
  tot.total_participants,
  ROUND(SAFE_DIVIDE(fc.n_participants, tot.total_participants) * 100, 2)
       AS pct_participants
FROM family_counts fc CROSS JOIN tot
ORDER BY icd10cm_family;
```

