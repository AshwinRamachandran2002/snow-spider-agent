Relevant columns & why they matter  
• USERS."id": join key to ORDERS / ORDER_ITEMS  
• USERS."email": the value the task finally needs  
• USERS."created_at": filter users who registered in 2019 ( 1546300800000000 – 1577836799000000 µs)  
• ORDERS."user_id": join key back to USERS  
• ORDERS."order_id": join key to ORDER_ITEMS  
• ORDERS."created_at": keep only orders placed in 2019 (same numeric window)  
• ORDERS."num_of_item": part of average‑order‑value (AOV) calculation  
• ORDERS."status": can be used to keep only finished sales (e.g., 'Complete')  
• ORDER_ITEMS."order_id": join to ORDERS  
• ORDER_ITEMS."sale_price": other half of AOV calculation  
• ORDER_ITEMS."status": optional extra filter for completed lines (e.g., 'Complete')  

Typical conditions you will eventually need  
1. USERS."created_at" BETWEEN 1546300800000000 AND 1577836799000000  
2. ORDERS."created_at" BETWEEN 1546300800000000 AND 1577836799000000  
3. ORDERS."status" = 'Complete' (and/or ORDER_ITEMS."status" = 'Complete')  

Below are ten exploratory Snowflake queries (each different and limited to 20 rows) that gradually build the context required for the final analysis. Adjust database / schema / table names only if yours differ.

```sql
-- 1️⃣  Users who signed up in 2019 (sample)
SELECT "id", "email", "created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1577836799000000
LIMIT 20;
```

```sql
-- 2️⃣  Distinct 2019 orders (any status)
SELECT DISTINCT "order_id", "user_id", "created_at", "status", "num_of_item"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1577836799000000
LIMIT 20;
```

```sql
-- 3️⃣  Completed 2019 orders only
SELECT "order_id", "user_id", "num_of_item", "created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1577836799000000
  AND "status" = 'Complete'
LIMIT 20;
```

```sql
-- 4️⃣  Order‑item lines tied to 2019 orders (no join yet)
SELECT "order_id", "inventory_item_id", "sale_price", "status"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
WHERE "order_id" IN (
    SELECT "order_id"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
    WHERE "created_at" BETWEEN 1546300800000000 AND 1577836799000000
)
LIMIT 20;
```

```sql
-- 5️⃣  Combine ORDERS + ORDER_ITEMS for revenue per order line
SELECT oi."order_id",
       oi."sale_price",
       o."num_of_item",
       o."user_id"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
  ON oi."order_id" = o."order_id"
WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836799000000
  AND o."status"    = 'Complete'
  AND oi."status"   = 'Complete'
LIMIT 20;
```

```sql
-- 6️⃣  Total order value (num_of_item * sale_price) for each order
SELECT o."order_id",
       o."user_id",
       SUM(o."num_of_item" * oi."sale_price") AS "order_value"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
  ON oi."order_id" = o."order_id"
WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836799000000
  AND o."status" = 'Complete'
  AND oi."status" = 'Complete'
GROUP BY o."order_id", o."user_id"
LIMIT 20;
```

```sql
-- 7️⃣  Average order value (AOV) per user for 2019 purchases
SELECT "user_id",
       AVG("order_value") AS "avg_order_value",
       COUNT(*)           AS "orders_placed"
FROM (
    SELECT o."order_id",
           o."user_id",
           SUM(o."num_of_item" * oi."sale_price") AS "order_value"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
      ON oi."order_id" = o."order_id"
    WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836799000000
      AND o."status" = 'Complete'
      AND oi."status" = 'Complete'
    GROUP BY o."order_id", o."user_id"
) t
GROUP BY "user_id"
LIMIT 20;
```

```sql
-- 8️⃣  Join the 2019‑signup users to their 2019 AOV
SELECT u."email",
       a."avg_order_value",
       a."orders_placed"
FROM (
    -- subquery from step 7
    SELECT "user_id",
           AVG("order_value") AS "avg_order_value",
           COUNT(*)           AS "orders_placed"
    FROM (
        SELECT o."order_id",
               o."user_id",
               SUM(o."num_of_item" * oi."sale_price") AS "order_value"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
        JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
          ON oi."order_id" = o."order_id"
        WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836799000000
          AND o."status" = 'Complete'
          AND oi."status" = 'Complete'
        GROUP BY o."order_id", o."user_id"
    ) t
    GROUP BY "user_id"
) a
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS" u
  ON u."id" = a."user_id"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836799000000
LIMIT 20;
```

```sql
-- 9️⃣  Same as #8 but ordered by highest AOV
SELECT u."email",
       a."avg_order_value"
FROM (
    /* AOV per user (same inner logic) */
    SELECT "user_id",
           AVG("order_value") AS "avg_order_value"
    FROM (
        SELECT o."order_id",
               o."user_id",
               SUM(o."num_of_item" * oi."sale_price") AS "order_value"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
        JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
          ON oi."order_id" = o."order_id"
        WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836799000000
          AND o."status" = 'Complete'
          AND oi."status" = 'Complete'
        GROUP BY o."order_id", o."user_id"
    ) t
    GROUP BY "user_id"
) a
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS" u
  ON u."id" = a."user_id"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836799000000
ORDER BY a."avg_order_value" DESC
LIMIT 20;
```

```sql
-- 🔟  Final-style query: Top‑10 2019 sign‑ups ranked by 2019 AOV
SELECT u."email"                                         AS "email_address",
       a."avg_order_value"                               AS "average_order_value_2019"
