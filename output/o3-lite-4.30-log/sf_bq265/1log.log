    WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836799999999
    GROUP BY u."email"
)
SELECT
    "email"
FROM user_aov
ORDER BY "avg_order_value" DESC NULLS LAST
LIMIT 10;
