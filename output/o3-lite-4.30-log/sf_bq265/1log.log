WITH orders_2019 AS (
    SELECT
        "order_id",
        "user_id",
        "num_of_item"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    WHERE "created_at" BETWEEN 1546300800000000 AND 1577836799999999
),
order_values AS (
    SELECT
        o."user_id",
        o."order_id",
        o."num_of_item" * MIN(oi."sale_price") AS "order_value"
    FROM orders_2019 o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
        ON oi."order_id" = o."order_id"
    WHERE COALESCE(oi."status", '') <> 'Cancelled'
    GROUP BY o."user_id", o."order_id", o."num_of_item"
),
