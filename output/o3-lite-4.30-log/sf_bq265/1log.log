Relevant columns & their potential usage  
• USERS."id": primary key for each user; join field to ORDERS / ORDER_ITEMS  
• USERS."email": final information we want to display  
• USERS."created_at": registration time‑stamp (µs) – filter to the 2019 range  
• ORDERS."user_id": foreign key back to USERS  
• ORDERS."order_id": primary key; join field to ORDER_ITEMS  
• ORDERS."created_at": order time‑stamp – filter to the 2019 range  
• ORDERS."num_of_item": quantity in each order – used in order‑value calculation  
• ORDER_ITEMS."order_id": foreign key back to ORDERS  
• ORDER_ITEMS."sale_price": price per item – used in order‑value calculation  
• ORDER_ITEMS."status": optional – use when you want to ignore ‘Cancelled’, etc.  
• ORDER_ITEMS."user_id": redundant, but can help in joins/filters  

Typical conditions that may be useful  
• USERS."created_at" BETWEEN 1546300800000000 AND 1577836800000000     -- registered in 2019  
• ORDERS."created_at" BETWEEN 1546300800000000 AND 1577836800000000    -- purchased in 2019  
• ORDER_ITEMS."status" = 'Complete'                                    -- optional quality filter  
• ORDER_ITEMS."sale_price" IS NOT NULL                                  -- avoid missing prices  

Below are ten exploratory Snowflake SQL queries (each limited to 20 rows), moving from simple inspection to the final top‑10 list.  
All identifiers are wrapped in double quotes, and each query is preceded by a short description.

```sql
-- 1) Peek at users who registered in 2019
SELECT 
    "id", 
    "email", 
    "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1577836800000000
LIMIT 20;
```

```sql
-- 2) Inspect orders created in 2019
SELECT 
    "order_id", 
    "user_id", 
    "num_of_item", 
    "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1577836800000000
LIMIT 20;
```

```sql
-- 3) Join users & orders to be sure registration‑year users actually bought in 2019
SELECT 
    u."id"        AS "user_id",
    u."email",
    o."order_id",
    o."created_at" AS "order_created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"  u
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  ON u."id" = o."user_id"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836800000000   -- registered 2019
  AND o."created_at" BETWEEN 1546300800000000 AND 1577836800000000   -- bought 2019
LIMIT 20;
```

```sql
-- 4) Look at order‑items (price side) for those 2019 orders
SELECT 
    oi."order_id",
    oi."sale_price",
    oi."status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
WHERE oi."order_id" IN (
        SELECT "order_id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
        WHERE "created_at" BETWEEN 1546300800000000 AND 1577836800000000
      )
LIMIT 20;
```

```sql
-- 5) Calculate a raw order value (num_of_item * first sale_price pick) for each order
SELECT 
    o."order_id",
    o."user_id",
    o."num_of_item",
    MIN(oi."sale_price")          AS "sample_sale_price",
    o."num_of_item" * MIN(oi."sale_price") AS "order_value_est"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
  ON o."order_id" = oi."order_id"
WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
GROUP BY o."order_id", o."user_id", o."num_of_item"
LIMIT 20;
```

```sql
-- 6) Aggregate to average order value per user (only 2019 orders & 2019 sign‑ups)
WITH order_values AS (
    SELECT 
        o."user_id",
        o."order_id",
        o."num_of_item" * MIN(oi."sale_price") AS "order_value"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
      ON o."order_id" = oi."order_id"
    WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
    GROUP BY o."user_id", o."order_id", o."num_of_item"
)
SELECT 
    "user_id",
    AVG("order_value") AS "avg_order_value",
    COUNT(*)           AS "order_cnt"
FROM order_values
GROUP BY "user_id"
LIMIT 20;
```

```sql
-- 7) Bring user emails into the picture and keep only those who registered in 2019
WITH order_values AS (
    SELECT 
        o."user_id",
        o."order_id",
        o."num_of_item" * MIN(oi."sale_price") AS "order_value"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
      ON o."order_id" = oi."order_id"
    WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
    GROUP BY o."user_id", o."order_id", o."num_of_item"
)
SELECT 
    u."email",
    AVG(ov."order_value") AS "avg_order_value",
    COUNT(*)              AS "order_cnt"
FROM order_values ov
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
  ON u."id" = ov."user_id"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836800000000
GROUP BY u."email"
LIMIT 20;
```

```sql
-- 8) Add a minimum‑orders filter (e.g., at least 2 completed orders) & sort
WITH order_values AS (
    SELECT 
        o."user_id",
        o."order_id",
        o."num_of_item" * MIN(oi."sale_price") AS "order_value"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
      ON o."order_id" = oi."order_id"
    WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
      AND oi."status" = 'Complete'
    GROUP BY o."user_id", o."order_id", o."num_of_item"
)
SELECT 
    u."email",
    AVG(ov."order_value") AS "avg_order_value",
    COUNT(*)              AS "completed_order_cnt"
FROM order_values ov
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
  ON u."id" = ov."user_id"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836800000000
GROUP BY u."email"
HAVING COUNT(*) >= 2
ORDER BY "avg_order_value" DESC
LIMIT 20;
```

```sql
-- 9) Rank users by average order value (dense rank) – useful before final top‑10 pick
WITH order_values AS (
    SELECT 
        o."user_id",
        o."order_id",
        o."num_of_item" * MIN(oi."sale_price") AS "order_value"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
      ON o."order_id" = oi."order_id"
    WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
    GROUP BY o."user_id", o."order_id", o."num_of_item"
), user_avgs AS (
    SELECT 
        u."email",
        AVG(ov."order_value") AS "avg_order_value"
    FROM order_values ov
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
      ON u."id" = ov."user_id"
    WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836800000000
    GROUP BY u."email"
)
SELECT 
    "email",
    "avg_order_value",
    DENSE_RANK() OVER (ORDER BY "avg_order_value" DESC) AS "rank_by_avg_value"
FROM user_avgs
ORDER BY "rank_by_avg_value"
LIMIT 20;
```

```sql
-- 10) Final pull: top 10 e‑mails of 2019 sign‑ups who bought in 2019, ranked by highest AOV
WITH order_values AS (
    SELECT 
        o."user_id",
        o."order_id",
        o."num_of_item" * MIN(oi."sale_price") AS "order_value"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
      ON o."order_id" = oi."order_id"
    WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
    GROUP BY o."user_id", o."order_id", o."num_of_item"
), user_avgs AS (
    SELECT 
        u."email",
        AVG(ov."order_value") AS "avg_order_value",
        COUNT(*)              AS "order_cnt"
    FROM order_values ov
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
      ON u."id" = ov."user_id"
    WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836800000000
    GROUP BY u."email"
)
SELECT 
    "email",
    "avg_order_value",
    "order_cnt"
FROM user_avgs
ORDER BY "avg_order_value" DESC
LIMIT 20;
```

