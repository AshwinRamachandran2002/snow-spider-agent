Below are 10 exploratory → increasingly complex Snowflake SQL queries (all limited to 20 rows when they output raw data) that gradually lead to the requested side‑by‑side comparison.  
All identifiers are enclosed in double quotes as required.

```sql
-- 1. Description: Inspect distinct road classes present in the whole dataset.
SELECT DISTINCT "CLASS"
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"
LIMIT 20;
```

```sql
-- 2. Description: Inspect distinct subclasses for a quick idea of the taxonomy.
SELECT DISTINCT "SUBCLASS"
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"
LIMIT 20;
```

```sql
-- 3. Description: Peek at 20 Amsterdam‑tile road records (quadkey starts 12020210).
SELECT "ID", "CLASS", "SUBCLASS", "LENGTH_M", "QUADKEY"
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"
WHERE "QUADKEY" LIKE '12020210%'
LIMIT 20;
```

```sql
-- 4. Description: Peek at 20 Rotterdam‑tile road records (quadkey starts 12020211).
SELECT "ID", "CLASS", "SUBCLASS", "LENGTH_M", "QUADKEY"
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"
WHERE "QUADKEY" LIKE '12020211%'
LIMIT 20;
```

```sql
-- 5. Description: Aggregate total length (meters) for every class / subclass in the Amsterdam tile.
SELECT
  "CLASS",
  "SUBCLASS",
  SUM(CAST("LENGTH_M" AS NUMBER)) AS "AMS_TOTAL_LENGTH_M"
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"
WHERE "QUADKEY" LIKE '12020210%'
GROUP BY "CLASS", "SUBCLASS"
ORDER BY "AMS_TOTAL_LENGTH_M" DESC
LIMIT 20;
```

```sql
-- 6. Description: Aggregate total length (meters) for every class / subclass in the Rotterdam tile.
SELECT
  "CLASS",
  "SUBCLASS",
  SUM(CAST("LENGTH_M" AS NUMBER)) AS "RTD_TOTAL_LENGTH_M"
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"
WHERE "QUADKEY" LIKE '12020211%'
GROUP BY "CLASS", "SUBCLASS"
ORDER BY "RTD_TOTAL_LENGTH_M" DESC
LIMIT 20;
```

```sql
-- 7. Description: Explore administrative objects; look at raw NAMES variants.
SELECT "ID", "ADMIN_LEVEL", "NAMES"
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ADMINISTRATIVE"
WHERE "ADMIN_LEVEL" = '8'
LIMIT 20;
```

```sql
-- 8. Description: Find the administrative polygon record whose name contains “Amsterdam”.
SELECT a."ID", a."ADMIN_LEVEL", n.value::STRING AS "NAME"
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ADMINISTRATIVE" a,
     LATERAL FLATTEN (input => a."NAMES") n
WHERE a."ADMIN_LEVEL" = '8'
  AND n.value::STRING ILIKE '%amsterdam%'
LIMIT 20;
```

```sql
-- 9. Description: Find the administrative polygon record whose name contains “Rotterdam”.
SELECT a."ID", a."ADMIN_LEVEL", n.value::STRING AS "NAME"
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ADMINISTRATIVE" a,
     LATERAL FLATTEN (input => a."NAMES") n
WHERE a."ADMIN_LEVEL" = '8'
  AND n.value::STRING ILIKE '%rotterdam%'
LIMIT 20;
```

```sql
-- 10. Description: Final combined view – total road lengths per class & subclass,
--                  side‑by‑side for Amsterdam (quadkey 12020210) and Rotterdam (quadkey 12020211).
SELECT
    COALESCE(ams."CLASS", rtd."CLASS")      AS "CLASS",
    COALESCE(ams."SUBCLASS", rtd."SUBCLASS") AS "SUBCLASS",
    ams."AMS_TOTAL_LENGTH_M",
    rtd."RTD_TOTAL_LENGTH_M"
FROM
(
  SELECT "CLASS", "SUBCLASS",
         SUM(CAST("LENGTH_M" AS NUMBER)) AS "AMS_TOTAL_LENGTH_M"
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"
  WHERE "QUADKEY" LIKE '12020210%'
  GROUP BY "CLASS", "SUBCLASS"
) ams
FULL OUTER JOIN
(
  SELECT "CLASS", "SUBCLASS",
         SUM(CAST("LENGTH_M" AS NUMBER)) AS "RTD_TOTAL_LENGTH_M"
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"
  WHERE "QUADKEY" LIKE '12020211%'
  GROUP BY "CLASS", "SUBCLASS"
) rtd
ON  ams."CLASS"    = rtd."CLASS"
AND ams."SUBCLASS" = rtd."SUBCLASS"
ORDER BY "CLASS", "SUBCLASS"
LIMIT 20;
```

