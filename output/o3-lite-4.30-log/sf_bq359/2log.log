```sql
--Description:
-- Goal: find which repositories that mention “JavaScript” in the LANGUAGES table
-- have the largest number of commits.
-- Steps:
--   1) Filter LANGUAGES for rows whose language JSON text contains the substring “JavaScript”.
--   2) Join those repos to SAMPLE_COMMITS on repo_name.
--   3) Count commits per repo, sort by that count (descending), and view the top 20.
SELECT sc."repo_name",
       COUNT(*) AS "commit_cnt"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_COMMITS" AS sc
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"      AS lg
  ON sc."repo_name" = lg."repo_name"
WHERE lg."language"::STRING ILIKE '%JavaScript%'
GROUP BY sc."repo_name"
ORDER BY "commit_cnt" DESC
LIMIT 20;
```
