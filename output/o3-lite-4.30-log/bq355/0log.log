```sql
-- 5. Description: Show 20 drug_era rows that involve any quinapril‑related concept
WITH quinapril_desc AS (
  SELECT ca.descendant_concept_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
    ON ca.ancestor_concept_id = c.concept_id
  WHERE c.vocabulary_id = 'RxNorm'
    AND c.concept_code = '35208'
)
SELECT de.person_id,
       de.drug_concept_id,
       de.drug_era_start_date,
       de.drug_era_end_date
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` de
WHERE de.drug_concept_id IN (SELECT descendant_concept_id FROM quinapril_desc)
LIMIT 20;
```

```sql
-- 6. Description: Number of unique participants who ever used quinapril (or related)
WITH quinapril_desc AS (
  SELECT ca.descendant_concept_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
    ON ca.ancestor_concept_id = c.concept_id
  WHERE c.vocabulary_id = 'RxNorm'
    AND c.concept_code = '35208'
)
SELECT COUNT(DISTINCT de.person_id) AS quinapril_users
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` de
WHERE de.drug_concept_id IN (SELECT descendant_concept_id FROM quinapril_desc);
```

```sql
-- 7. Description: Total number of unique persons in the synthetic dataset
SELECT COUNT(DISTINCT person_id) AS total_persons
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.person`;
```

```sql
-- 8. Description: Compute the percentage of participants that ever used quinapril
WITH quinapril_desc AS (
  SELECT ca.descendant_concept_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
    ON ca.ancestor_concept_id = c.concept_id
  WHERE c.vocabulary_id = 'RxNorm'
    AND c.concept_code = '35208'
),
users AS (
  SELECT DISTINCT de.person_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` de
  WHERE de.drug_concept_id IN (SELECT descendant_concept_id FROM quinapril_desc)
),
totals AS (
  SELECT COUNT(*) AS total_persons
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.person`
)
SELECT (SELECT COUNT(*) FROM users) / totals.total_persons * 100 AS pct_using_quinapril
FROM totals;
```

```sql
-- 9. Description: Compute the percentage of participants that have NOT used quinapril
WITH quinapril_desc AS (
  SELECT ca.descendant_concept_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
    ON ca.ancestor_concept_id = c.concept_id
  WHERE c.vocabulary_id = 'RxNorm'
    AND c.concept_code = '35208'
),
users AS (
  SELECT DISTINCT de.person_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` de
  WHERE de.drug_concept_id IN (SELECT descendant_concept_id FROM quinapril_desc)
),
population AS (
  SELECT person_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.person`
)
SELECT (1 - (SELECT COUNT(*) FROM users) / CAST(COUNT(*) AS FLOAT64)) * 100
       AS pct_not_using_quinapril
FROM population
LIMIT 20;  -- LIMIT just to satisfy the 20‑row instruction; result repeats same scalar
```

```sql
-- 10. Description: Final concise query returning the single percentage of participants NOT using quinapril or any related formulation
WITH quinapril AS (
  SELECT concept_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE vocabulary_id = 'RxNorm'
    AND concept_code = '35208'
),
quinapril_desc AS (
  SELECT descendant_concept_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor`
  WHERE ancestor_concept_id IN (SELECT concept_id FROM quinapril)
),
users AS (
  SELECT DISTINCT person_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
  WHERE drug_concept_id IN (SELECT descendant_concept_id FROM quinapril_desc)
),
population AS (
  SELECT DISTINCT person_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.person`
)
SELECT ROUND( (1 - (SELECT COUNT(*) FROM users) /
                    (SELECT COUNT(*) FROM population) ) * 100 , 2) 
       AS percent_not_using_quinapril;
```

