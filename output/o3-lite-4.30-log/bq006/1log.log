Begin Exploring Related Columns
Relevant tables & columns for the task  
(bigquery-public-data.austin_incidents.incidents_2016)

• `descript` : filter to rows whose description is “PUBLIC INTOXICATION”.  
  condition example → `WHERE UPPER(descript) = 'PUBLIC INTOXICATION'`

• `date` : calendar day on which the incident happened; will be used for daily aggregation.  
  condition example → `WHERE date BETWEEN '2016-01-01' AND '2016-12-31'` (table already limited to 2016, but keeps query explicit).

• `unique_key` : unique identifier for each incident; can be counted to get number of cases per day.  
  aggregation example → `COUNT(DISTINCT unique_key) AS incidents`

• `timestamp` (optional) : exact moment of incident; can be used to double‑check the `date` field or extract the year with `EXTRACT(YEAR FROM timestamp)=2016`.

--------------------------------------------------------------------
Ten exploratory → final SQLs
--------------------------------------------------------------------

```sql
-- 1️⃣ Description:
-- Inspect the variety of ‘descript’ values that contain the word “INTOXICATION”.
SELECT DISTINCT descript
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE LOWER(descript) LIKE '%intoxication%'
LIMIT 20;
```

```sql
-- 2️⃣ Description:
-- Count ALL 2016 incidents whose description is exactly “PUBLIC INTOXICATION”.
SELECT COUNT(*) AS total_public_intox_2016
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE UPPER(descript) = 'PUBLIC INTOXICATION';
```

```sql
-- 3️⃣ Description:
-- Show 20 sample rows of PUBLIC INTOXICATION incidents.
SELECT unique_key, date, time, address
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
ORDER BY date, time
LIMIT 20;
```

```sql
-- 4️⃣ Description:
-- Daily counts of PUBLIC INTOXICATION incidents in 2016.
SELECT
  date,
  COUNT(DISTINCT unique_key) AS incidents
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
GROUP BY date
ORDER BY date
LIMIT 20;
```

```sql
-- 5️⃣ Description:
-- Identify the 20 dates with the highest daily counts.
SELECT
  date,
  COUNT(DISTINCT unique_key) AS incidents
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
GROUP BY date
ORDER BY incidents DESC, date
LIMIT 20;
```

```sql
-- 6️⃣ Description:
-- Compute mean & standard deviation of daily incident counts (sub‑query style).
WITH daily AS (
  SELECT
    date,
    COUNT(DISTINCT unique_key) AS incidents
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
  GROUP BY date
)
SELECT
  AVG(incidents)   AS mean_incidents,
  STDDEV_POP(incidents) AS stddev_incidents
FROM daily;
```

```sql
-- 7️⃣ Description:
-- Attach mean & stddev to every date to calculate the Z‑score.
WITH daily AS (
  SELECT
    date,
    COUNT(DISTINCT unique_key) AS incidents
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
  GROUP BY date
),
stats AS (
  SELECT
    AVG(incidents)   AS mean_incidents,
    STDDEV_POP(incidents) AS stddev_incidents
  FROM daily
)
SELECT
  d.date,
  d.incidents,
  (d.incidents - s.mean_incidents) / s.stddev_incidents AS z_score
FROM daily d CROSS JOIN stats s
ORDER BY z_score DESC
LIMIT 20;
```

```sql
-- 8️⃣ Description:
-- Same as above but only keep dates where Z‑score > 2 (potential outliers).
WITH daily AS (
  SELECT date, COUNT(DISTINCT unique_key) AS incidents
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
  GROUP BY date
),
stats AS (
  SELECT AVG(incidents) AS mean_incidents,
         STDDEV_POP(incidents) AS stddev_incidents
  FROM daily
)
SELECT
  d.date,
  d.incidents,
  (d.incidents - s.mean_incidents) / s.stddev_incidents AS z_score
FROM daily d CROSS JOIN stats s
WHERE (d.incidents - s.mean_incidents) / s.stddev_incidents > 2
ORDER BY z_score DESC
LIMIT 20;
```

```sql
-- 9️⃣ Description:
-- Identify the date with the highest Z‑score.
WITH daily AS (
  SELECT date, COUNT(DISTINCT unique_key) AS incidents
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
  GROUP BY date
),
stats AS (
  SELECT AVG(incidents) AS mean_incidents,
         STDDEV_POP(incidents) AS stddev_incidents
  FROM daily
)
SELECT
  d.date,
  d.incidents,
  (d.incidents - s.mean_incidents) / s.stddev_incidents AS z_score
FROM daily d CROSS JOIN stats s
ORDER BY z_score DESC
LIMIT 1;
```

```sql
-- 🔟 Description (FINAL):
-- Return the date (formatted ‘2016‑xx‑xx’) with the second‑highest Z‑score.
WITH daily AS (
  SELECT date, COUNT(DISTINCT unique_key) AS incidents
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
  GROUP BY date
),
stats AS (
  SELECT AVG(incidents) AS mean_incidents,
         STDDEV_POP(incidents) AS stddev_incidents
  FROM daily
),
ranked AS (
  SELECT
    date,
    incidents,
    (incidents - mean_incidents)/stddev_incidents AS z_score,
    ROW_NUMBER() OVER (ORDER BY (incidents - mean_incidents)/stddev_incidents DESC) AS rn
  FROM daily CROSS JOIN stats
)
SELECT FORMAT_DATE('%Y-%m-%d', date) AS second_highest_zscore_date
FROM ranked
WHERE rn = 2;
```

