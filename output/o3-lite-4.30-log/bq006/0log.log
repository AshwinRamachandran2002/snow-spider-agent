SELECT COUNT(*) AS intoxication_incident_cnt
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
LIMIT 20;
```

```sql
--Description: 4. List 20 sample incident dates for “PUBLIC INTOXICATION”.
SELECT date
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
LIMIT 20;
```

```sql
--Description: 5. Daily incident counts (raw) for “PUBLIC INTOXICATION”.
SELECT
  date,
  COUNT(*) AS daily_cnt
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
GROUP BY date
ORDER BY date
LIMIT 20;
```

```sql
--Description: 6. Same as #5 but ordered by highest daily counts first.
SELECT
  date,
  COUNT(*) AS daily_cnt
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
GROUP BY date
ORDER BY daily_cnt DESC
LIMIT 20;
```

```sql
--Description: 7. Compute daily counts and overall mean & stddev (include them on every row via window functions).
SELECT
  date,
  COUNT(*) AS daily_cnt,
  AVG(COUNT(*)) OVER()          AS mean_cnt,
  STDDEV_POP(COUNT(*)) OVER()   AS stddev_cnt
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
GROUP BY date
ORDER BY date
LIMIT 20;
```

```sql
--Description: 8. Add z‑score for each day and sort by descending z‑score.
SELECT
  date,
  COUNT(*) AS daily_cnt,
  ROUND( (COUNT(*) - AVG(COUNT(*)) OVER()) / NULLIF(STDDEV_POP(COUNT(*)) OVER(),0), 2) AS z_score
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
GROUP BY date
ORDER BY z_score DESC
LIMIT 20;
```

```sql
--Description: 9. Pull top two z‑scores so we can visually confirm the second‑highest day.
SELECT
  date,
  COUNT(*)   AS daily_cnt,
  ROUND( (COUNT(*) - AVG(COUNT(*)) OVER()) / NULLIF(STDDEV_POP(COUNT(*)) OVER(),0), 2) AS z_score
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
GROUP BY date
ORDER BY z_score DESC
LIMIT 2;
```

```sql
--Description: 10. Final query – returns only the date with the second‑highest z‑score.
SELECT date
FROM (
  SELECT
    date,
    COUNT(*) AS daily_cnt,
    ROW_NUMBER() OVER(ORDER BY (COUNT(*) - AVG(COUNT(*)) OVER()) / NULLIF(STDDEV_POP(COUNT(*)) OVER(),0) DESC) AS rn
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
  GROUP BY date
)
WHERE rn = 2
LIMIT 20;
```

