-- • Step‑2  Group by `date` to get the count of those incidents per day (daily_cnt).
-- • Step‑3  Use window functions to compute the overall mean and population standard
--           deviation of daily_cnt.  Calculate each day’s Z‑score with
--           SAFE_DIVIDE( daily_cnt - mean , stddev ).
-- • Step‑4  Rank all days by Z‑score in descending order (ROW_NUMBER).
-- • Step‑5  Pick the row where rank = 2 and return its date.
SELECT
  `date`
FROM (
  SELECT
    `date`,
    ROW_NUMBER() OVER (ORDER BY z_score DESC) AS rn
  FROM (
    SELECT
      `date`,
      SAFE_DIVIDE(
        daily_cnt - AVG(daily_cnt) OVER (),
        STDDEV_POP(daily_cnt) OVER ()
      ) AS z_score
    FROM (
      SELECT
        `date`,
        COUNT(*) AS daily_cnt
      FROM `bigquery-public-data.austin_incidents.incidents_2016`
      WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
      GROUP BY `date`
    )
  )
)
WHERE rn = 2;
