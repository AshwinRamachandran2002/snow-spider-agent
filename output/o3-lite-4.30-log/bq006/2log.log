WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
LIMIT 20;
```

```sql
-- 3. Description: Count PUBLIC INTOXICATION incidents per day (simple aggregate).
SELECT date, COUNT(*) AS daily_cnt
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
GROUP BY date
ORDER BY date
LIMIT 20;
```

```sql
-- 4. Description: Show the 20 days with the highest raw counts.
SELECT date, COUNT(*) AS daily_cnt
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
GROUP BY date
ORDER BY daily_cnt DESC
LIMIT 20;
```

```sql
-- 5. Description: Compute mean & standard deviation of daily counts in a sub‑query.
WITH daily AS (
  SELECT date, COUNT(*) AS cnt
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
  GROUP BY date
)
SELECT
  AVG(cnt)  AS avg_cnt,
  STDDEV_POP(cnt) AS stddev_cnt
FROM daily;
```

```sql
-- 6. Description: Attach z‑scores to each day (population stddev).
WITH daily AS (
  SELECT date, COUNT(*) AS cnt
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
  GROUP BY date
),
stats AS (
  SELECT AVG(cnt) AS mu, STDDEV_POP(cnt) AS sigma FROM daily
)
SELECT
  d.date,
  d.cnt,
  ROUND( (d.cnt - s.mu) / s.sigma , 2) AS z_score
FROM daily d CROSS JOIN stats s
ORDER BY z_score DESC
LIMIT 20;
```

```sql
-- 7. Description: Rank days by z‑score and show ties (dense_rank).
WITH daily AS (
  SELECT date, COUNT(*) AS cnt
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
  GROUP BY date
),
stats AS (
  SELECT AVG(cnt) AS mu, STDDEV_POP(cnt) AS sigma FROM daily
),
zs AS (
  SELECT
    date,
    cnt,
    (cnt - mu)/sigma AS z
  FROM daily, stats
)
SELECT
  date,
  cnt,
  ROUND(z,2) AS z_score,
  DENSE_RANK() OVER(ORDER BY z DESC) AS z_rank
FROM zs
ORDER BY z_rank, date
LIMIT 20;
```

```sql
-- 8. Description: Return only the date(s) with z_rank = 2 (second‑highest z‑score).
WITH daily AS (
  SELECT date, COUNT(*) AS cnt
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
