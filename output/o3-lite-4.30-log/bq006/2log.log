-- 9. Description: Same as #8 but formatted as a string '2016-xx-xx'.
WITH daily AS (
  SELECT date, COUNT(*) AS cnt
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
  GROUP BY date
),
stats AS (
  SELECT AVG(cnt) AS mu, STDDEV_POP(cnt) AS sigma FROM daily
),
zs AS (
  SELECT
    date,
    (cnt - mu)/sigma AS z
  FROM daily, stats
),
ranked AS (
  SELECT date,
         DENSE_RANK() OVER(ORDER BY z DESC) AS z_rank
  FROM zs
)
SELECT FORMAT_DATE('%F', date) AS second_highest_zscore_date
FROM ranked
WHERE z_rank = 2
LIMIT 20;
