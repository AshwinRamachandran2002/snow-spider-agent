Begin Exploring Related Columns
Relevant columns, their usage, and typical conditions  

• `descript`: filter to incidents that equal (or contain) ‘PUBLIC INTOXICATION’ (`WHERE UPPER(descript) = 'PUBLIC INTOXICATION'`).  
• `date`: the calendar day of the incident; aggregate counts by this field.  
• `timestamp` (optional): verifies the record is in 2016 (`EXTRACT(YEAR FROM timestamp)=2016`) but `date` already holds 2016‑xx‑xx for this table.  

Tables used:  
`bigquery-public-data.austin_incidents.incidents_2016`

---

Below are ten exploratory → analytical SQL queries (each limited to 20 rows where relevant) that progressively lead to the final answer.

```sql
-- 1. Description: Peek at distinct incident types in 2016 to verify the exact text for public intoxication.
SELECT DISTINCT descript
FROM `bigquery-public-data.austin_incidents.incidents_2016`
LIMIT 20;
```

```sql
-- 2. Description: Show a few raw rows whose incident type is PUBLIC INTOXICATION.
SELECT date, time, descript, address
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
LIMIT 20;
```

```sql
-- 3. Description: Count PUBLIC INTOXICATION incidents per day (simple aggregate).
SELECT date, COUNT(*) AS daily_cnt
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
GROUP BY date
ORDER BY date
LIMIT 20;
```

```sql
-- 4. Description: Show the 20 days with the highest raw counts.
SELECT date, COUNT(*) AS daily_cnt
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
GROUP BY date
ORDER BY daily_cnt DESC
LIMIT 20;
```

```sql
-- 5. Description: Compute mean & standard deviation of daily counts in a sub‑query.
WITH daily AS (
  SELECT date, COUNT(*) AS cnt
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
  GROUP BY date
)
SELECT
  AVG(cnt)  AS avg_cnt,
  STDDEV_POP(cnt) AS stddev_cnt
FROM daily;
```

```sql
-- 6. Description: Attach z‑scores to each day (population stddev).
WITH daily AS (
  SELECT date, COUNT(*) AS cnt
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
  GROUP BY date
),
stats AS (
  SELECT AVG(cnt) AS mu, STDDEV_POP(cnt) AS sigma FROM daily
)
SELECT
  d.date,
  d.cnt,
  ROUND( (d.cnt - s.mu) / s.sigma , 2) AS z_score
FROM daily d CROSS JOIN stats s
ORDER BY z_score DESC
LIMIT 20;
```

```sql
-- 7. Description: Rank days by z‑score and show ties (dense_rank).
WITH daily AS (
  SELECT date, COUNT(*) AS cnt
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
  GROUP BY date
),
stats AS (
  SELECT AVG(cnt) AS mu, STDDEV_POP(cnt) AS sigma FROM daily
),
zs AS (
  SELECT
    date,
    cnt,
    (cnt - mu)/sigma AS z
  FROM daily, stats
)
SELECT
  date,
  cnt,
  ROUND(z,2) AS z_score,
  DENSE_RANK() OVER(ORDER BY z DESC) AS z_rank
FROM zs
ORDER BY z_rank, date
LIMIT 20;
```

```sql
-- 8. Description: Return only the date(s) with z_rank = 2 (second‑highest z‑score).
WITH daily AS (
  SELECT date, COUNT(*) AS cnt
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
  GROUP BY date
),
stats AS (
  SELECT AVG(cnt) AS mu, STDDEV_POP(cnt) AS sigma FROM daily
),
zs AS (
  SELECT
    date,
    (cnt - mu)/sigma AS z
  FROM daily, stats
)
SELECT date
FROM (
  SELECT date,
         DENSE_RANK() OVER(ORDER BY z DESC) AS z_rank
  FROM zs
)
WHERE z_rank = 2
LIMIT 20;
```

```sql
-- 9. Description: Same as #8 but formatted as a string '2016-xx-xx'.
WITH daily AS (
  SELECT date, COUNT(*) AS cnt
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
  GROUP BY date
),
stats AS (
  SELECT AVG(cnt) AS mu, STDDEV_POP(cnt) AS sigma FROM daily
),
zs AS (
  SELECT
    date,
    (cnt - mu)/sigma AS z
  FROM daily, stats
),
ranked AS (
  SELECT date,
         DENSE_RANK() OVER(ORDER BY z DESC) AS z_rank
  FROM zs
)
SELECT FORMAT_DATE('%F', date) AS second_highest_zscore_date
FROM ranked
WHERE z_rank = 2
LIMIT 20;
```

```sql
-- 10. Description: One‑liner version (no CTEs) that returns only the needed date.
SELECT FORMAT_DATE('%F', date) AS second_highest_zscore_date
FROM (
  SELECT
    date,
    DENSE_RANK() OVER(
      ORDER BY (COUNT(*) - AVG(COUNT(*)) OVER()) /
               STDDEV_POP(COUNT(*)) OVER() DESC
    ) AS z_rank
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE UPPER(descript) = 'PUBLIC INTOXICATION'
  GROUP BY date
)
WHERE z_rank = 2;
```

