Relevant table & columns

• bigquery-public-data.chicago_taxi_trips.taxi_trips  
  – trip_seconds : will be converted to minutes and rounded, then used to build the NTILE(10) groups.  
  – fare         : aggregated (AVG) for every quantile.  
  – (optional) unique_key : could be counted to know the number of trips.  

Typical filter conditions that will be used

• trip_seconds IS NOT NULL  
• ROUND(trip_seconds/60.0) BETWEEN 1 AND 50      -- keep trips whose rounded duration is from 1‑50 minutes  

Ten exploratory → final queries
(queries grow in complexity; each limited to 20 rows except the last)

```sql
-- 1. Quick peek: trip length (sec) and fare
SELECT trip_seconds, fare
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT 20;
```

```sql
-- 2. Distinct list of some rounded‑minute durations that actually appear
SELECT DISTINCT ROUND(trip_seconds/60.0) AS dur_minutes
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds IS NOT NULL
ORDER BY dur_minutes
LIMIT 20;
```

```sql
-- 3. Sample of trips whose rounded duration lies between 1 and 50 minutes
SELECT unique_key, trip_seconds, ROUND(trip_seconds/60.0) AS dur_minutes, fare
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds IS NOT NULL
  AND ROUND(trip_seconds/60.0) BETWEEN 1 AND 50
LIMIT 20;
```

```sql
-- 4. Same sample, but show the human‑readable time‑range text
SELECT unique_key,
       FORMAT('%02dm', ROUND(trip_seconds/60.0)) AS time_bucket,
       fare
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds IS NOT NULL
  AND ROUND(trip_seconds/60.0) BETWEEN 1 AND 50
LIMIT 20;
```

```sql
-- 5. Count of trips for each rounded‑minute duration (1‑50)
SELECT ROUND(trip_seconds/60.0) AS dur_minutes,
       COUNT(*)                  AS trips
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds IS NOT NULL
  AND ROUND(trip_seconds/60.0) BETWEEN 1 AND 50
GROUP BY dur_minutes
ORDER BY dur_minutes
LIMIT 20;
```

```sql
-- 6. Put every qualifying trip into one of 10 equal NTILE bins
SELECT unique_key,
       ROUND(trip_seconds/60.0) AS dur_minutes,
       NTILE(10) OVER (ORDER BY ROUND(trip_seconds/60.0)) AS decile
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds IS NOT NULL
  AND ROUND(trip_seconds/60.0) BETWEEN 1 AND 50
LIMIT 20;
```

```sql
-- 7. Count of trips inside each decile
WITH base AS (
  SELECT NTILE(10) OVER (ORDER BY ROUND(trip_seconds/60.0)) AS decile
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds IS NOT NULL
    AND ROUND(trip_seconds/60.0) BETWEEN 1 AND 50
)
SELECT decile, COUNT(*) AS trips
FROM base
GROUP BY decile
ORDER BY decile
LIMIT 20;
```

```sql
-- 8. Min / max duration present inside each decile
WITH base AS (
  SELECT ROUND(trip_seconds/60.0)                               AS dur_minutes,
         NTILE(10) OVER (ORDER BY ROUND(trip_seconds/60.0))      AS decile
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds IS NOT NULL
    AND ROUND(trip_seconds/60.0) BETWEEN 1 AND 50
)
SELECT decile,
       MIN(dur_minutes) AS min_dur,
       MAX(dur_minutes) AS max_dur
FROM base
GROUP BY decile
ORDER BY decile
LIMIT 20;
```

```sql
-- 9. Average fare for each decile (un‑formatted)
WITH base AS (
  SELECT ROUND(trip_seconds/60.0)                               AS dur_minutes,
         fare,
         NTILE(10) OVER (ORDER BY ROUND(trip_seconds/60.0))      AS decile
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds IS NOT NULL
    AND ROUND(trip_seconds/60.0) BETWEEN 1 AND 50
)
SELECT decile,
       COUNT(*)              AS trips,
       AVG(fare)             AS avg_fare
FROM base
GROUP BY decile
ORDER BY decile
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: total trips & avg fare (2‑decimals) for each of 10 equal‑sized
--     duration quantiles (1–50 rounded minutes), with nicely formatted range text
WITH qualified AS (
  SELECT
    ROUND(trip_seconds/60.0) AS dur_minutes,
    fare
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds IS NOT NULL
    AND ROUND(trip_seconds/60.0) BETWEEN 1 AND 50
),
bucketed AS (
  SELECT
    dur_minutes,
    fare,
    NTILE(10) OVER (ORDER BY dur_minutes) AS decile
  FROM qualified
),
summary AS (
  SELECT
    decile,
    MIN(dur_minutes)                     AS min_dur,
    MAX(dur_minutes)                     AS max_dur,
    COUNT(*)                             AS total_trips,
    AVG(fare)                            AS avg_fare
  FROM bucketed
  GROUP BY decile
)
SELECT
  FORMAT('%02dm to %02dm', min_dur, max_dur)      AS time_range,
  total_trips                                     AS trips,
  FORMAT('%.2f', avg_fare)                        AS average_fare
FROM summary
ORDER BY min_dur;
```
