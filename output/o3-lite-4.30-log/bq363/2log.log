--Description: We need 10 equally‑sized quantile groups (NTILE(10)) based on rounded
--             trip duration (minutes) for trips whose rounded duration is 1–50 min.
--             Steps:
--               1) Keep only trips with non‑NULL trip_seconds and a rounded duration
--                  between 1 and 50 minutes.  Compute dur_minutes = ROUND(trip_seconds/60).
--               2) Use NTILE(10) OVER (ORDER BY dur_minutes) to assign each trip to a
--                  decile of duration.  This ensures ~equal‑sized buckets.
--               3) Aggregate by decile: get MIN and MAX dur_minutes, COUNT(*) trips,
--                  and AVG(fare).
--               4) Format the time range “XXm to XXm” (zero‑padded two digits) and the
--                  average fare to two decimals.
--             Finally, sort chronologically by the minimum duration so ranges appear
--             in order.
WITH qualified AS (
  SELECT
    ROUND(trip_seconds / 60.0)                           AS dur_minutes,
    fare
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds IS NOT NULL
    AND ROUND(trip_seconds / 60.0) BETWEEN 1 AND 50
),
bucketed AS (
  SELECT
    dur_minutes,
    fare,
    NTILE(10) OVER (ORDER BY dur_minutes)                AS decile
  FROM qualified
),
summary AS (
  SELECT
    decile,
    MIN(dur_minutes)                                     AS min_dur,
    MAX(dur_minutes)                                     AS max_dur,
    COUNT(*)                                             AS total_trips,
    AVG(fare)                                            AS avg_fare
  FROM bucketed
  GROUP BY decile
)
SELECT
  FORMAT('%02dm to %02dm', min_dur, max_dur)             AS time_range,
  total_trips                                            AS trips,
  FORMAT('%.2f', avg_fare)                               AS average_fare
FROM summary
ORDER BY min_dur;
