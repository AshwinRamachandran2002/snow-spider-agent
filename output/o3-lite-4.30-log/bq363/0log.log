Relevant columns and their usage
--------------------------------
bigquery-public-data.chicago_taxi_trips.taxi_trips  
• `trip_seconds`: calculate trip‑duration in minutes (trip_seconds/60).  
• `fare`: average fare per quantile group.  
• `unique_key`: counting trips.  
• (Optional filters) `trip_seconds IS NOT NULL` and trip duration between 60 s and 3 000 s (≈ 1‑50 min).

10 step‑by‑step exploratory → final queries
-------------------------------------------

```sql
-- 1) Peek at raw trip_seconds and fare
SELECT trip_seconds, fare
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT 20;
```

```sql
-- 2) Add a computed rounded‑minutes column
SELECT trip_seconds,
       ROUND(trip_seconds / 60.0) AS trip_minutes,
       fare
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds IS NOT NULL
LIMIT 20;
```

```sql
-- 3) Keep trips whose rounded duration is 1‑50 minutes
SELECT ROUND(trip_seconds / 60.0) AS trip_minutes,
       fare
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds IS NOT NULL
  AND ROUND(trip_seconds / 60.0) BETWEEN 1 AND 50
LIMIT 20;
```

```sql
-- 4) See how many trips fall in every exact minute (1‑50)
SELECT ROUND(trip_seconds / 60.0) AS trip_minutes,
       COUNT(*) AS trips
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds IS NOT NULL
  AND ROUND(trip_seconds / 60.0) BETWEEN 1 AND 50
GROUP BY trip_minutes
ORDER BY trip_minutes
LIMIT 20;
```

```sql
-- 5) Distinct minute values present in the filtered set
SELECT DISTINCT ROUND(trip_seconds / 60.0) AS trip_minutes
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds IS NOT NULL
  AND ROUND(trip_seconds / 60.0) BETWEEN 1 AND 50
ORDER BY trip_minutes
LIMIT 20;
```

```sql
-- 6) Assign every trip to one of 10 NTILE buckets
SELECT unique_key,
       ROUND(trip_seconds / 60.0) AS trip_minutes,
       NTILE(10) OVER (ORDER BY ROUND(trip_seconds / 60.0)) AS quantile
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds IS NOT NULL
  AND ROUND(trip_seconds / 60.0) BETWEEN 1 AND 50
LIMIT 20;
```

```sql
-- 7) Inspect min / max minute per quantile bucket
SELECT quantile,
       MIN(trip_minutes) AS min_minute,
       MAX(trip_minutes) AS max_minute
FROM (
  SELECT ROUND(trip_seconds / 60.0) AS trip_minutes,
         NTILE(10) OVER (ORDER BY ROUND(trip_seconds / 60.0)) AS quantile
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds IS NOT NULL
    AND ROUND(trip_seconds / 60.0) BETWEEN 1 AND 50
)
GROUP BY quantile
ORDER BY quantile
LIMIT 20;
```

```sql
-- 8) Add total trips and average fare for each quantile
SELECT quantile,
       COUNT(*)  AS total_trips,
       AVG(fare) AS avg_fare
FROM (
  SELECT fare,
         NTILE(10) OVER (ORDER BY ROUND(trip_seconds / 60.0)) AS quantile
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds IS NOT NULL
    AND ROUND(trip_seconds / 60.0) BETWEEN 1 AND 50
)
GROUP BY quantile
ORDER BY quantile
LIMIT 20;
```

```sql
-- 9) Build the human‑readable time‑range string ("XXm to XXm")
SELECT quantile,
       CONCAT(
         LPAD(CAST(min_minute AS STRING),2,'0'),'m to ',
         LPAD(CAST(max_minute AS STRING),2,'0'),'m'
       ) AS time_range,
       total_trips,
       ROUND(avg_fare, 2) AS avg_fare
FROM (
  SELECT quantile,
         MIN(trip_minutes) AS min_minute,
         MAX(trip_minutes) AS max_minute,
         COUNT(*)           AS total_trips,
         AVG(fare)          AS avg_fare
  FROM (
    SELECT fare,
           ROUND(trip_seconds / 60.0) AS trip_minutes,
           NTILE(10) OVER (ORDER BY ROUND(trip_seconds / 60.0)) AS quantile
    FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
    WHERE trip_seconds IS NOT NULL
      AND ROUND(trip_seconds / 60.0) BETWEEN 1 AND 50
  )
  GROUP BY quantile
)
ORDER BY quantile
LIMIT 20;
```

```sql
-- 10) FINAL answer: total trips & avg fare (2‑dec) for the 10 equal‑sized quantile groups
SELECT CONCAT(LPAD(CAST(min_minute AS STRING),2,'0'),'m to ',
              LPAD(CAST(max_minute AS STRING),2,'0'),'m') AS time_range,
       total_trips,
       FORMAT('%.2f', avg_fare) AS avg_fare
FROM (
  SELECT quantile,
         MIN(trip_minutes) AS min_minute,
         MAX(trip_minutes) AS max_minute,
         COUNT(*)          AS total_trips,
         AVG(fare)         AS avg_fare
  FROM (
    SELECT fare,
           ROUND(trip_seconds / 60.0) AS trip_minutes,
           NTILE(10) OVER (ORDER BY ROUND(trip_seconds / 60.0)) AS quantile
    FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
    WHERE trip_seconds IS NOT NULL
      AND ROUND(trip_seconds / 60.0) BETWEEN 1 AND 50
  )
  GROUP BY quantile
)
ORDER BY min_minute
LIMIT 20;
```

The last query delivers the requested 10 quantile buckets, each showing its zero‑padded minute range, total‑trip count, and average fare rounded to two decimals.
