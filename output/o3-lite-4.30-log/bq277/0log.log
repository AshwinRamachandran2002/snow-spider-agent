Begin Exploring Related Columns
Relevant columns and how they will be used  

```
world_port_index.region_number        : filter to the required region  ('6585')
world_port_index.port_name            : port identification
world_port_index.port_geom            : point‑geometry of each port for spatial tests
states.state_geom                     : polygon geometry of every U.S. state; “container” for ports
states.state, states.state_name       : let us keep only the 50 states + DC if desired
hurricanes.basin                      : keep only North‑Atlantic rows  ('NA')
hurricanes.name                       : exclude unnamed storms          (name <> 'NOT_NAMED')
hurricanes.latitude / longitude       : convert every 6‑hour fix to a GEOGRAPHY point
hurricanes.usa_wind (or wmo_wind)     : wind speed – keep points ≥ 35 kt
hurricanes.sid, hurricanes.season     : let us count unique storms / seasons
```

Typical conditions that will be needed  

```
WHERE region_number = '6585'
AND   ST_Intersects(port_geom , state_geom)                      -- port inside a state
AND   basin = 'NA'
AND   name <> 'NOT_NAMED'
AND   COALESCE(usa_wind , wmo_wind , 0) >= 35                    -- TS force
AND   ST_DWithin( port_geom ,
                  ST_GeogPoint(longitude , latitude) ,
                  50*1000)                                       -- ≤ 50 km from the port
```

Below are ten exploratory BigQuery queries – from very simple inspections to a complete answer – all limited to 20 rows so they are safe to run in the console.  
(Replace ❶‑❿ with the order you want to run them.)

```sql
-- ❶ Description: list every port that belongs to region 6585
SELECT
  index_number,
  port_name,
  country,
  port_latitude,
  port_longitude
FROM
  `bigquery-public-data.geo_international_ports.world_port_index`
WHERE
  region_number = '6585'
LIMIT 20;
```

```sql
-- ❷ Description: check which of those ports actually fall inside a U.S. state polygon
SELECT
  p.index_number,
  p.port_name,
  s.state
FROM
  `bigquery-public-data.geo_international_ports.world_port_index` AS p
JOIN
  `bigquery-public-data.geo_us_boundaries.states`               AS s
ON
  ST_Intersects(p.port_geom , s.state_geom)
WHERE
  p.region_number = '6585'
LIMIT 20;
```

```sql
-- ❸ Description: quick look at North‑Atlantic storm fixes that are named and ≥ 35 kt
SELECT
  sid,
  season,
  name,
  iso_time,
  latitude,
  longitude,
  usa_wind
FROM
  `bigquery-public-data.noaa_hurricanes.hurricanes`
WHERE
  basin = 'NA'
  AND name <> 'NOT_NAMED'
  AND COALESCE(usa_wind , wmo_wind , 0) >= 35
LIMIT 20;
```

```sql
-- ❹ Description: convert those storm points to GEOGRAPHY objects
SELECT
  sid,
  season,
  name,
  ST_GeogPoint(longitude , latitude) AS storm_pt
FROM
  `bigquery-public-data.noaa_hurricanes.hurricanes`
WHERE
  basin = 'NA'
  AND name <> 'NOT_NAMED'
  AND COALESCE(usa_wind , wmo_wind , 0) >= 35
LIMIT 20;
```

```sql
-- ❺ Description: see which storm fixes physically lie inside any U.S. state
SELECT
  h.sid,
  h.season,
  h.name,
  s.state
FROM
  `bigquery-public-data.noaa_hurricanes.hurricanes` AS h
JOIN
  `bigquery-public-data.geo_us_boundaries.states`   AS s
ON
  ST_Intersects( ST_GeogPoint(h.longitude , h.latitude) , s.state_geom)
WHERE
  basin = 'NA'
  AND h.name <> 'NOT_NAMED'
  AND COALESCE(h.usa_wind , h.wmo_wind , 0) >= 35
LIMIT 20;
```

```sql
-- ❻ Description: count how many qualifying storm fixes occur within 50 km of each port
SELECT
  p.port_name,
  COUNT(*) AS fix_hits
FROM
  `bigquery-public-data.geo_international_ports.world_port_index` AS p
JOIN
  `bigquery-public-data.geo_us_boundaries.states`                 AS s
ON
  ST_Intersects(p.port_geom , s.state_geom)            -- port inside a state
JOIN
  `bigquery-public-data.noaa_hurricanes.hurricanes`    AS h
ON
  ST_DWithin( p.port_geom ,
              ST_GeogPoint(h.longitude , h.latitude) ,
              50*1000 )                               -- within 50 km
WHERE
  p.region_number = '6585'
  AND h.basin = 'NA'
  AND h.name <> 'NOT_NAMED'
  AND COALESCE(h.usa_wind , h.wmo_wind , 0) >= 35
GROUP BY
  p.port_name
ORDER BY
  fix_hits DESC
LIMIT 20;
```

```sql
-- ❼ Description: same as above, but count **distinct storms** (sid) instead of fixes
SELECT
  p.port_name,
  COUNT(DISTINCT h.sid) AS storms_nearby
FROM
  `bigquery-public-data.geo_international_ports.world_port_index` AS p
JOIN
  `bigquery-public-data.geo_us_boundaries.states`                 AS s
ON
  ST_Intersects(p.port_geom , s.state_geom)
JOIN
  `bigquery-public-data.noaa_hurricanes.hurricanes`               AS h
ON
  ST_DWithin( p.port_geom ,
              ST_GeogPoint(h.longitude , h.latitude) ,
              50*1000 )
WHERE
  p.region_number = '6585'
  AND h.basin = 'NA'
  AND h.name <> 'NOT_NAMED'
  AND COALESCE(h.usa_wind , h.wmo_wind , 0) >= 35
GROUP BY
  p.port_name
ORDER BY
  storms_nearby DESC
LIMIT 20;
```

```sql
-- ❽ Description: cross‑check using WMO winds only (where they exist)
SELECT
  p.port_name,
  COUNT(DISTINCT h.sid) AS storms_wmo
FROM
  `bigquery-public-data.geo_international_ports.world_port_index` AS p
JOIN
  `bigquery-public-data.geo_us_boundaries.states`                 AS s
ON
  ST_Intersects(p.port_geom , s.state_geom)
JOIN
  `bigquery-public-data.noaa_hurricanes.hurricanes`               AS h
ON
  ST_DWithin( p.port_geom ,
              ST_GeogPoint(h.longitude , h.latitude) ,
              50*1000 )
WHERE
  p.region_number = '6585'
  AND h.basin = 'NA'
  AND h.name <> 'NOT_NAMED'
  AND h.wmo_wind >= 35
GROUP BY
  p.port_name
ORDER BY
  storms_wmo DESC
LIMIT 20;
```

```sql
-- ❾ Description: produce a season‑by‑season view of storm contacts for every port
SELECT
  p.port_name,
  h.season,
  COUNT(DISTINCT h.sid) AS storms_in_season
FROM
  `bigquery-public-data.geo_international_ports.world_port_index` AS p
JOIN
  `bigquery-public-data.geo_us_boundaries.states`                 AS s
ON
  ST_Intersects(p.port_geom , s.state_geom)
JOIN
  `bigquery-public-data.noaa_hurricanes.hurricanes`               AS h
ON
  ST_DWithin( p.port_geom ,
              ST_GeogPoint(h.longitude , h.latitude) ,
              50*1000 )
WHERE
  p.region_number = '6585'
  AND h.basin = 'NA'
  AND h.name <> 'NOT_NAMED'
  AND COALESCE(h.usa_wind , h.wmo_wind , 0) >= 35
GROUP BY
  p.port_name, h.season
ORDER BY
  storms_in_season DESC
LIMIT 20;
```

