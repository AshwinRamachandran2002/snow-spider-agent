    d."Dependency":"Name"::STRING    AS "MostFrequentDepName",
    d."Dependency":"Version"::STRING AS "MostFrequentDepVersion",
    COUNT(*)                         AS "Appearances"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES" d
JOIN latest_rows lr
  ON d."Name"    = lr."Name"
 AND d."Version" = lr."Version"
WHERE d."System" = 'NPM'
  AND d."Dependency":"Name" IS NOT NULL
GROUP BY d."Dependency":"Name", d."Dependency":"Version"
ORDER BY "Appearances" DESC
