--Description: Return the (dependency package, dependency version) that occurs most often
--             among the dependencies of the latest released version of every NPM package.
--             Same logic as earlier query but limited to the single top‑occurring pair.
WITH latest AS (                           -- choose highest released version per package
    SELECT
        pv."Name"                                   AS "PkgName",
        MAX(pv."VersionInfo":"Ordinal")             AS "HighestOrdinal"
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" pv
    WHERE pv."System" = 'NPM'
      AND pv."VersionInfo":"IsRelease" = TRUE
    GROUP BY pv."Name"
