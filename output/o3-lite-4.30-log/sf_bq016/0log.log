```sql
--Description: 7) Create a temporary table “highest_releases” that stores, for every NPM
--              package, the version string corresponding to its highest‑release
--              (i.e. the row whose VersionInfo→Ordinal is maximal among IsRelease=TRUE).
CREATE OR REPLACE TEMP TABLE highest_releases AS
WITH releases AS (
    SELECT
        "Name",
        "Version",
        "VersionInfo":"Ordinal"::NUMBER AS "Ordinal"
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
    WHERE "System" = 'NPM'
      AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
),
hi AS (
    SELECT
        "Name",
        MAX("Ordinal") AS "HighestOrdinal"
    FROM releases
    GROUP BY "Name"
)
SELECT
    r."Name",
    r."Version"
FROM releases r
JOIN hi h
  ON r."Name"    = h."Name"
 AND r."Ordinal" = h."HighestOrdinal";
```

```sql
--Description: 8) Display a sample of dependency rows (raw JSON) that belong to those
--              highest‑release packages stored in the temp table created above.
SELECT
    d."Name"       AS "PackageName",
    d."Version"    AS "PackageVersion",
    d."Dependency" AS "DependencyJson"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES" d
JOIN highest_releases hr
  ON d."Name"    = hr."Name"
 AND d."Version" = hr."Version"
WHERE d."System" = 'NPM'
LIMIT 20;
```

```sql
--Description: 9) Parse the JSON “Dependency” object for the same highest‑release packages
--              to show each dependency’s package name & version separately.
SELECT
    d."Name"                                  AS "PackageName",
    d."Version"                               AS "PackageVersion",
    PARSE_JSON(d."Dependency"):"Name"::TEXT    AS "DepName",
    PARSE_JSON(d."Dependency"):"Version"::TEXT AS "DepVersion"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES" d
JOIN highest_releases hr
  ON d."Name"    = hr."Name"
 AND d."Version" = hr."Version"
WHERE d."System" = 'NPM'
LIMIT 20;
```

```sql
--Description: 10) Count how many times each (dependency package + version) appears among
--               all dependencies of the highest‑release NPM packages, ordered from most
--               frequent to least frequent.  LIMIT 20 previews the top list.
WITH target_deps AS (
    SELECT
        PARSE_JSON(d."Dependency"):"Name"::TEXT    AS "DepName",
        PARSE_JSON(d."Dependency"):"Version"::TEXT AS "DepVersion"
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES" d
    JOIN highest_releases hr
      ON d."Name"    = hr."Name"
     AND d."Version" = hr."Version"
    WHERE d."System" = 'NPM'
)
SELECT
    "DepName",
    "DepVersion",
    COUNT(*) AS "Appearances"
FROM target_deps
GROUP BY "DepName", "DepVersion"
ORDER BY "Appearances" DESC
LIMIT 20;
```
