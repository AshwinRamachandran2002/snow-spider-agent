-- 5. Description: For each NPM package, obtain its highest release version (max Ordinal)
WITH releases AS (
  SELECT "Name",
         "Version",
         "VersionInfo":"Ordinal"::NUMBER AS "Ordinal"
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
  WHERE "System" = 'NPM'
