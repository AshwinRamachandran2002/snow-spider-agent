            ON m."pat_no" = pcs."pat_no"
    JOIN    "PATENTS_USPTO"."PATENTS"."PUBLICATIONS"                 p
            ON p."publication_number" = m."publication_number"
    WHERE   pcs."ind_flg" = '1'
) q
WHERE q.RN_APP_EARLIEST = 1
ORDER BY TO_NUMBER(q."word_ct") DESC
LIMIT 100;
