--Description: Final production query – returns the 100 longest independent patent
--             claims (by word count) while ensuring that only the FIRST (earliest)
--             publication for each application is kept.
--             1. Join PATENT_CLAIMS_STATS → MATCH → PUBLICATIONS.
--             2. Filter to independent claims (ind_flg = '1').
--             3. Use ROW_NUMBER() to tag the earliest publication per application.
--             4. Keep only RN_APP_EARLIEST = 1.
--             5. Sort by WORD_CT (cast to numeric) DESC and limit to 100 rows.
SELECT  q."publication_number",
        q."application_number",
        q."claim_no",
        q."word_ct"
FROM (
    SELECT  p."application_number",
            p."publication_number",
            p."publication_date",
            pcs."claim_no",
            pcs."word_ct",
            ROW_NUMBER() OVER (PARTITION BY p."application_number"
                               ORDER BY p."publication_date") AS RN_APP_EARLIEST
