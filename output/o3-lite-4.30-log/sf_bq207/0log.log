```sql
WITH indep_claims AS (      -- keep only independent claims and cast word_ct to number
    SELECT
        pcs."pat_no",
        pcs."claim_no",
        TO_NUMBER(pcs."word_ct") AS word_cnt
    FROM "PATENTS_USPTO"."USPTO_OCE_CLAIMS"."PATENT_CLAIMS_STATS" pcs
    WHERE pcs."ind_flg" = '1'
      AND pcs."word_ct" IS NOT NULL
), pat_to_pub AS (          -- attach publication numbers
    SELECT
        ic."pat_no",
        ic."claim_no",
        ic.word_cnt,
        m."publication_number"
    FROM indep_claims ic
    JOIN "PATENTS_USPTO"."USPTO_OCE_CLAIMS"."MATCH" m
      ON m."pat_no" = ic."pat_no"
), full_join AS (           -- bring in application numbers & publication dates
    SELECT
        ptp."publication_number",
        p."application_number",
        p."publication_date",
        ptp."claim_no",
        ptp.word_cnt
    FROM pat_to_pub ptp
    JOIN "PATENTS_USPTO"."PATENTS"."PUBLICATIONS" p
      ON p."publication_number" = ptp."publication_number"
    WHERE p."application_number" IS NOT NULL
)
SELECT
    publication_number,
    application_number,
    claim_no  AS claim_num,
    word_cnt  AS word_count
FROM (
    SELECT
        fj.*,
        ROW_NUMBER() OVER (PARTITION BY application_number
                           ORDER BY publication_date, word_cnt DESC) AS rn
    FROM full_join fj
) earliest_per_app
WHERE rn = 1                       -- keep earliest publication per application
ORDER BY word_count DESC NULLS LAST, publication_number
LIMIT 100;
```
