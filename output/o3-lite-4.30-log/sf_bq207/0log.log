```sql
-- 1) Peek at PATENT_CLAIMS_STATS to see basic structure
SELECT *
FROM "PATENTS_USPTO"."USPTO_OCE_CLAIMS"."PATENT_CLAIMS_STATS"
LIMIT 20;
```

```sql
-- 2) Verify the flag values actually present in the table
SELECT DISTINCT "ind_flg"
FROM "PATENTS_USPTO"."USPTO_OCE_CLAIMS"."PATENT_CLAIMS_STATS";
```

```sql
-- 3) Small sample: independent claims with the largest word counts
SELECT "pat_no",
       "claim_no",
       "word_ct"
FROM "PATENTS_USPTO"."USPTO_OCE_CLAIMS"."PATENT_CLAIMS_STATS"
WHERE "ind_flg" = '1'
ORDER BY TO_NUMBER("word_ct") DESC
LIMIT 20;
```

```sql
-- 4) Join PATENT_CLAIMS_STATS to MATCH to attach publication numbers
SELECT pcs."pat_no",
       m."publication_number",
       pcs."claim_no",
       pcs."word_ct"
FROM "PATENTS_USPTO"."USPTO_OCE_CLAIMS"."PATENT_CLAIMS_STATS" pcs
JOIN "PATENTS_USPTO"."USPTO_OCE_CLAIMS"."MATCH"              m
  ON m."pat_no" = pcs."pat_no"
WHERE pcs."ind_flg" = '1'
LIMIT 20;
```

```sql
-- 5) Inspect PUBLICATIONS for the joined sample rows
SELECT p."publication_number",
       p."application_number",
       p."publication_date"
FROM "PATENTS_USPTO"."PATENTS"."PUBLICATIONS" p
WHERE p."publication_number" IN (
        SELECT m."publication_number"
        FROM "PATENTS_USPTO"."USPTO_OCE_CLAIMS"."MATCH" m
        LIMIT 100
      )
LIMIT 20;
```

```sql
-- 6) First cut: bring all three tables together (small slice)
SELECT pcs."pat_no",
       m."publication_number",
       p."application_number",
       p."publication_date",
       pcs."claim_no",
       pcs."word_ct"
FROM "PATENTS_USPTO"."USPTO_OCE_CLAIMS"."PATENT_CLAIMS_STATS" pcs
JOIN "PATENTS_USPTO"."USPTO_OCE_CLAIMS"."MATCH"              m
      ON m."pat_no" = pcs."pat_no"
JOIN "PATENTS_USPTO"."PATENTS"."PUBLICATIONS"                p
      ON p."publication_number" = m."publication_number"
WHERE pcs."ind_flg" = '1'
LIMIT 20;
```

```sql
-- 7) Add a window‑function to mark the earliest publication per application
SELECT *,
       ROW_NUMBER() OVER (PARTITION BY p."application_number"
                          ORDER BY p."publication_date") AS rn_app_earliest
FROM "PATENTS_USPTO"."USPTO_OCE_CLAIMS"."PATENT_CLAIMS_STATS" pcs
JOIN "PATENTS_USPTO"."USPTO_OCE_CLAIMS"."MATCH"              m
      ON m."pat_no" = pcs."pat_no"
JOIN "PATENTS_USPTO"."PATENTS"."PUBLICATIONS"                p
      ON p."publication_number" = m."publication_number"
WHERE pcs."ind_flg" = '1'
LIMIT 20;
```

```sql
-- 8) Filter on rn_app_earliest = 1 → keep earliest publication only
SELECT *
FROM (
  SELECT p."application_number",
         p."publication_number",
         p."publication_date",
         pcs."claim_no",
         pcs."word_ct",
         ROW_NUMBER() OVER (PARTITION BY p."application_number"
                            ORDER BY p."publication_date") AS rn_app_earliest
  FROM "PATENTS_USPTO"."USPTO_OCE_CLAIMS"."PATENT_CLAIMS_STATS" pcs
  JOIN "PATENTS_USPTO"."USPTO_OCE_CLAIMS"."MATCH"              m
        ON m."pat_no" = pcs."pat_no"
  JOIN "PATENTS_USPTO"."PATENTS"."PUBLICATIONS"                p
        ON p."publication_number" = m."publication_number"
  WHERE pcs."ind_flg" = '1'
) q
WHERE rn_app_earliest = 1
LIMIT 20;
```

```sql
