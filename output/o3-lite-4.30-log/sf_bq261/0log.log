-- 7) Description: Rank products by profit within each month (restricted to months prior to 2024‑01).
SELECT
    month_profit."order_month",
    month_profit."product_id",
    p."name",
    month_profit."total_cost",
    month_profit."total_profit",
    RANK() OVER (PARTITION BY month_profit."order_month" ORDER BY month_profit."total_profit" DESC) AS "profit_rank"
FROM (
    SELECT
        TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000), 'YYYY-MM') AS "order_month",
        oi."product_id",
        SUM(p."cost")                             AS "total_cost",
        SUM(oi."sale_price" - p."cost")           AS "total_profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
      ON p."id" = oi."product_id"
    WHERE oi."created_at" < 1704067200000000     -- before 2024‑01‑01
    GROUP BY 1, 2
) month_profit
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
  ON p."id" = month_profit."product_id"
LIMIT 20;
