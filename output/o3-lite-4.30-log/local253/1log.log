Query:
-- 10. Description: FINAL ANSWER – top‑5 companies by average salary in each
--     of the four specified cities, plus the overall national average in a
--     four‑column output (Location, Company Name, Average Salary in State,
--     Average Salary in Country)
WITH national AS (
    SELECT AVG(
             CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS REAL)
           ) AS national_avg_salary
    FROM   "SalaryDataset"
),
city_avgs AS (
    SELECT  "Location",
            "CompanyName",
            AVG(
                  CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS REAL)
                ) AS avg_salary_city,
            RANK() OVER (PARTITION BY "Location"
                         ORDER BY AVG(
                             CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS REAL)
                         ) DESC) AS city_rank
    FROM    "SalaryDataset"
    WHERE   "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location","CompanyName"
)
SELECT  c."Location"                        AS "Location",
        c."CompanyName"                     AS "Company Name",
        ROUND(c.avg_salary_city, 2)         AS "Average Salary in State",
        ROUND(n.national_avg_salary, 2)     AS "Average Salary in Country"
FROM    city_avgs  AS c
CROSS JOIN national AS n
WHERE   c.city_rank <= 5
ORDER BY c."Location",
         c.avg_salary_city DESC,
         c."CompanyName";
