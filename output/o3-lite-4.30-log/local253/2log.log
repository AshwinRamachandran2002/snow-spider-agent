['hardware_dim_customer', 'hardware_fact_pre_invoice_deductions', 'web_sales_reps', 'hardware_dim_product', 'web_orders', 'StaffHours', 'university_enrollment', 'university_faculty', 'university_student', 'university_offering', 'web_accounts', 'web_events', 'SalaryDataset', 'web_region', 'hardware_fact_gross_price', 'hardware_fact_manufacturing_cost', 'university_course', 'hardware_fact_sales_monthly']
Begin Exploring Related Columns
Relevant columns and their usage  
• SalaryDataset."Location": filters to the 4 required cities and identifies the “state / city” for which we need the top‑5 companies.  
• SalaryDataset."CompanyName": company identifier that will be ranked within each city.  
• SalaryDataset."Salary": needs to be cleaned (remove the currency sign, commas and “/yr”) and then cast to a numeric type so that averages can be calculated.  
• (Optional) SalaryDataset."JobTitle", "SalariesReported" … are NOT needed for this analysis.  

Typical conditions that will be used  
• WHERE "Location" IN ('Mumbai', 'Pune', 'New Delhi', 'Hyderabad')  
• Cleaning salary:  
  CAST( REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','')  AS INTEGER)  

Below are ten exploratory / building‑block queries (each limited to 20 rows) ending with the complete answer.  
--------------------------------------------------------------------------------

```sql
-- 1. Description:  Show the distinct locations that exist in the Salary dataset
SELECT DISTINCT "Location"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
-- 2. Description:  Look at a sample of the raw salary strings
SELECT "CompanyName",
       "Location",
       "Salary"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
-- 3. Description:  Inspect how the salary string looks after basic cleaning
SELECT "Salary",
       REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS cleaned_salary_str
FROM "SalaryDataset"
LIMIT 20;
```

```sql
-- 4. Description:  Convert the cleaned salary string to an INTEGER to verify the cast works
SELECT "Salary",
       CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS INTEGER) AS salary_value
FROM "SalaryDataset"
LIMIT 20;
```

```sql
-- 5. Description:  Average salary at the NATIONAL level (all records)
SELECT AVG(
        CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS INTEGER)
       )  AS avg_salary_country
FROM "SalaryDataset";
```

```sql
-- 6. Description:  Average salary for each company‑city pair (restricted to the 4 target cities)
SELECT "Location",
       "CompanyName",
       AVG(
          CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS INTEGER)
       ) AS avg_salary_city
FROM "SalaryDataset"
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
GROUP BY "Location","CompanyName"
LIMIT 20;
```

```sql
-- 7. Description:  Rank companies inside each of the 4 cities by their average salary
SELECT *
FROM (
        SELECT  "Location",
                "CompanyName",
                AVG(
                   CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS INTEGER)
                ) AS avg_salary_city,
                ROW_NUMBER() OVER (PARTITION BY "Location" 
                                   ORDER BY AVG(
                                        CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS INTEGER)
                                   ) DESC) AS rn
        FROM "SalaryDataset"
        WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
        GROUP BY "Location","CompanyName"
) ranked
WHERE rn <= 5
LIMIT 20;
```

```sql
-- 8. Description:  Compute the same ranking but keep the national average salary with every row
WITH national AS (
     SELECT AVG(
            CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS INTEGER)
         )  AS avg_salary_country
     FROM "SalaryDataset"
), city_company AS (
     SELECT "Location",
            "CompanyName",
            AVG(
               CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS INTEGER)
            ) AS avg_salary_city,
            ROW_NUMBER() OVER (PARTITION BY "Location" 
                               ORDER BY AVG(
                                    CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS INTEGER)
                               ) DESC) AS rn
     FROM "SalaryDataset"
     WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
     GROUP BY "Location","CompanyName"
)
SELECT c."Location",
       c."CompanyName",
       c.avg_salary_city       AS "Average Salary in State",
       n.avg_salary_country    AS "Average Salary in Country"
FROM  city_company  c
CROSS JOIN national n
WHERE c.rn <= 5
LIMIT 20;
```

```sql
-- 9. Description:  (Optional) Show the difference between city salary and national salary
WITH national AS (
     SELECT AVG(
            CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS INTEGER)
         )  AS avg_salary_country
     FROM "SalaryDataset"
), city_company AS (
     SELECT "Location",
            "CompanyName",
            AVG(
               CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS INTEGER)
            ) AS avg_salary_city,
            ROW_NUMBER() OVER (PARTITION BY "Location" 
                               ORDER BY AVG(
                                    CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS INTEGER)
                               ) DESC) AS rn
     FROM "SalaryDataset"
     WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
     GROUP BY "Location","CompanyName"
)
SELECT c."Location",
       c."CompanyName",
       c.avg_salary_city                       AS "Average Salary in State",
       n.avg_salary_country                    AS "Average Salary in Country",
       c.avg_salary_city - n.avg_salary_country AS "Diff_State_vs_Country"
FROM  city_company  c
CROSS JOIN national n
WHERE c.rn <= 5
LIMIT 20;
```

```sql
-- 10. Description:  FINAL ANSWER – Top 5 companies by average salary in each of
--                  Mumbai, Pune, New Delhi, and Hyderabad, along with the
--                  overall national average salary.
WITH national AS (
     SELECT AVG(
            CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS INTEGER)
         )  AS avg_salary_country
     FROM "SalaryDataset"
),
city_company AS (
     SELECT "Location",
            "CompanyName",
            AVG(
               CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS INTEGER)
            ) AS avg_salary_city,
            ROW_NUMBER() OVER (PARTITION BY "Location"
                               ORDER BY AVG(
                                    CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') AS INTEGER)
                               ) DESC) AS rn
     FROM "SalaryDataset"
     WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
     GROUP BY "Location","CompanyName"
)
SELECT   c."Location"                       AS "Location",
         c."CompanyName"                    AS "Company Name",
         c.avg_salary_city                  AS "Average Salary in State",
         n.avg_salary_country               AS "Average Salary in Country"
FROM     city_company c
CROSS JOIN national    n
WHERE    c.rn <= 5
ORDER BY c."Location",
         c.avg_salary_city DESC;
```

The last query will produce the requested four‑column report, listing only the five highest‑paying companies (by average salary) in each of the specified cities and, alongside, the single national average salary so that users can visually compare company‑level city averages with the overall country‑wide figure.
