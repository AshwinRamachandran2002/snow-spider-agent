Query:
-- 8️⃣  Combine city‑level and country‑level averages for the same company
SELECT
       c."Location",
       c."CompanyName",
       c.avg_salary_city,
       n.avg_salary_country
FROM (
    -- city averages
    SELECT 
        "Location",
        "CompanyName",
        ROUND( AVG(
            CAST(
                 REPLACE(
                     REPLACE(
                         REPLACE("Salary",'₹',''),
                     ',',''),
                '/yr','') AS FLOAT)
        ),2) AS avg_salary_city
    FROM "SalaryDataset"
    WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location","CompanyName"
)  AS c
JOIN (
    -- nationwide averages
    SELECT 
        "CompanyName",
        ROUND( AVG(
            CAST(
                 REPLACE(
                     REPLACE(
                         REPLACE("Salary",'₹',''),
                     ',',''),
                '/yr','') AS FLOAT)
        ),2) AS avg_salary_country
    FROM "SalaryDataset"
    GROUP BY "CompanyName"
)  AS n
ON c."CompanyName" = n."CompanyName"
LIMIT 20;
