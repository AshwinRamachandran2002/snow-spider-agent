Begin Exploring Related Columns
Relevant columns for this task (all from the table `SalaryDataset`)

• CompanyName : used for grouping companies and computing their average salary  
• Location    : used for filtering the four target cities (Mumbai, Pune, New Delhi, Hyderabad)  
• Salary      : needs to be cleaned (remove “₹”, commas, “/yr”), cast to a numeric type, and then averaged  

Typical conditions you will see in the forthcoming SQL  
• WHERE Location IN ('Mumbai','Pune','New Delhi','Hyderabad') – to isolate the four cities  
• REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr','') – to strip non‑numeric characters  
• CAST( … AS FLOAT) – to convert the cleaned string into a number  
• GROUP BY CompanyName, Location (or just CompanyName for the nationwide average)  
• A window function (e.g., ROW_NUMBER or RANK) partitioned by Location to keep the top‑5 companies in each city  

Below are ten exploratory queries (from very simple to the final solution) that progressively build the logic.  
All queries use SQLite syntax and return at most 20 rows.

```sql
-- 1️⃣  List every distinct city recorded in the SalaryDataset
SELECT DISTINCT "Location"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
-- 2️⃣  See all distinct salary strings (raw format) just to understand patterns
SELECT DISTINCT "Salary"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
-- 3️⃣  Quick peek at rows from the four cities of interest
SELECT *
FROM "SalaryDataset"
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
LIMIT 20;
```

```sql
-- 4️⃣  Demonstrate the salary‑cleaning logic on a few sample rows
SELECT 
       "CompanyName",
       "Location",
       "Salary"                     AS raw_salary,
       CAST(
            REPLACE(
                REPLACE(
                    REPLACE("Salary",'₹',''),
                ',',''),
           '/yr','') AS FLOAT)      AS salary_numeric
FROM "SalaryDataset"
LIMIT 20;
```

```sql
-- 5️⃣  Average salary for every city (helps verify cleaning worked)
SELECT 
       "Location",
       ROUND( AVG(
           CAST(
                REPLACE(
                    REPLACE(
                       REPLACE("Salary",'₹',''),
                   ',',''),
               '/yr','') AS FLOAT)
       ),2) AS avg_salary
FROM "SalaryDataset"
GROUP BY "Location"
LIMIT 20;
```

```sql
-- 6️⃣  Nationwide (all locations) average salary per company
SELECT 
       "CompanyName",
       ROUND( AVG(
           CAST(
                REPLACE(
                    REPLACE(
                       REPLACE("Salary",'₹',''),
                   ',',''),
               '/yr','') AS FLOAT)
       ),2) AS avg_salary_country
FROM "SalaryDataset"
GROUP BY "CompanyName"
LIMIT 20;
```

```sql
-- 7️⃣  Average salary per company FOR EACH of the four cities
SELECT 
       "Location",
       "CompanyName",
       ROUND( AVG(
           CAST(
                REPLACE(
                    REPLACE(
                       REPLACE("Salary",'₹',''),
                   ',',''),
               '/yr','') AS FLOAT)
       ),2) AS avg_salary_city
FROM "SalaryDataset"
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
GROUP BY "Location","CompanyName"
LIMIT 20;
```

```sql
-- 8️⃣  Combine city‑level and country‑level averages for the same company
SELECT
       c."Location",
       c."CompanyName",
       c.avg_salary_city,
       n.avg_salary_country
FROM (
    -- city averages
    SELECT 
        "Location",
        "CompanyName",
        ROUND( AVG(
            CAST(
                 REPLACE(
                     REPLACE(
                         REPLACE("Salary",'₹',''),
                     ',',''),
                '/yr','') AS FLOAT)
        ),2) AS avg_salary_city
    FROM "SalaryDataset"
    WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location","CompanyName"
)  AS c
JOIN (
    -- nationwide averages
    SELECT 
        "CompanyName",
        ROUND( AVG(
            CAST(
                 REPLACE(
                     REPLACE(
                         REPLACE("Salary",'₹',''),
                     ',',''),
                '/yr','') AS FLOAT)
        ),2) AS avg_salary_country
    FROM "SalaryDataset"
    GROUP BY "CompanyName"
)  AS n
ON c."CompanyName" = n."CompanyName"
LIMIT 20;
```

```sql
-- 9️⃣  Rank companies within each city by their average salary
SELECT
       e.*,
       ROW_NUMBER() OVER (PARTITION BY e."Location" ORDER BY e.avg_salary_city DESC) AS rn
FROM (
    /* query from step 8 without LIMIT */
    SELECT
           c."Location",
           c."CompanyName",
           c.avg_salary_city,
           n.avg_salary_country
    FROM (
        SELECT 
            "Location",
            "CompanyName",
            ROUND( AVG(
                CAST(
                     REPLACE(
                         REPLACE(
                             REPLACE("Salary",'₹',''),
                         ',',''),
                    '/yr','') AS FLOAT)
            ),2) AS avg_salary_city
        FROM "SalaryDataset"
        WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
        GROUP BY "Location","CompanyName"
    )  AS c
    JOIN (
        SELECT 
            "CompanyName",
            ROUND( AVG(
                CAST(
                     REPLACE(
                         REPLACE(
                             REPLACE("Salary",'₹',''),
                         ',',''),
                    '/yr','') AS FLOAT)
            ),2) AS avg_salary_country
        FROM "SalaryDataset"
        GROUP BY "CompanyName"
    )  AS n
    ON c."CompanyName" = n."CompanyName"
) AS e
LIMIT 20;
```

```sql
-- 🔟  FINAL QUERY ─ top‑5 companies by average salary in each city
SELECT
       final."Location"                         AS "Location",
       final."CompanyName"                      AS "Company Name",
       final.avg_salary_city                    AS "Average Salary in State",
       final.avg_salary_country                 AS "Average Salary in Country"
FROM (
    SELECT
           e."Location",
           e."CompanyName",
           e.avg_salary_city,
           e.avg_salary_country,
           ROW_NUMBER() OVER (PARTITION BY e."Location" ORDER BY e.avg_salary_city DESC) AS rn
    FROM (
        /* city‑level + country‑level averages */
        SELECT
               c."Location",
               c."CompanyName",
               c.avg_salary_city,
               n.avg_salary_country
        FROM (
            SELECT 
                "Location",
                "CompanyName",
                ROUND( AVG(
                    CAST(
                         REPLACE(
                             REPLACE(
                                 REPLACE("Salary",'₹',''),
                             ',',''),
                        '/yr','') AS FLOAT)
                ),2) AS avg_salary_city
            FROM "SalaryDataset"
            WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
            GROUP BY "Location","CompanyName"
        )  AS c
        JOIN (
            SELECT 
                "CompanyName",
                ROUND( AVG(
                    CAST(
                         REPLACE(
                             REPLACE(
                                 REPLACE("Salary",'₹',''),
                             ',',''),
                        '/yr','') AS FLOAT)
                ),2) AS avg_salary_country
            FROM "SalaryDataset"
            GROUP BY "CompanyName"
        )  AS n
        ON c."CompanyName" = n."CompanyName"
    ) AS e
) AS final
WHERE final.rn <= 5     -- keep only the top 5 for each city
ORDER BY final."Location", final.avg_salary_city DESC
LIMIT 20;
```

