Query:
-- 🔟  FINAL QUERY ─ top‑5 companies by average salary in each city
SELECT
       final."Location"                         AS "Location",
       final."CompanyName"                      AS "Company Name",
       final.avg_salary_city                    AS "Average Salary in State",
       final.avg_salary_country                 AS "Average Salary in Country"
FROM (
    SELECT
           e."Location",
           e."CompanyName",
           e.avg_salary_city,
           e.avg_salary_country,
           ROW_NUMBER() OVER (PARTITION BY e."Location" ORDER BY e.avg_salary_city DESC) AS rn
    FROM (
        /* city‑level + country‑level averages */
        SELECT
               c."Location",
               c."CompanyName",
               c.avg_salary_city,
               n.avg_salary_country
        FROM (
            SELECT 
                "Location",
                "CompanyName",
                ROUND( AVG(
                    CAST(
                         REPLACE(
                             REPLACE(
                                 REPLACE("Salary",'₹',''),
                             ',',''),
                        '/yr','') AS FLOAT)
                ),2) AS avg_salary_city
            FROM "SalaryDataset"
            WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
            GROUP BY "Location","CompanyName"
        )  AS c
        JOIN (
            SELECT 
                "CompanyName",
                ROUND( AVG(
                    CAST(
                         REPLACE(
                             REPLACE(
                                 REPLACE("Salary",'₹',''),
                             ',',''),
                        '/yr','') AS FLOAT)
                ),2) AS avg_salary_country
            FROM "SalaryDataset"
            GROUP BY "CompanyName"
        )  AS n
        ON c."CompanyName" = n."CompanyName"
    ) AS e
) AS final
WHERE final.rn <= 5     -- keep only the top 5 for each city
ORDER BY final."Location", final.avg_salary_city DESC
LIMIT 20;
