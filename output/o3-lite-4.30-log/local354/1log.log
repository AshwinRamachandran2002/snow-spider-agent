Relevant tables / columns for the task  
(results, races, drivers are the core – drives can be useful, too)

• races.year – season‑year (filter to 1950‑1959)  
• races.round – sequence of the GPs inside the season (needed to know “first / last” race a driver entered)  
• races.race_id – technical key to join to results  

• results.race_id – link to races  
• results.driver_id – who drove  
• results.constructor_id – which constructor the driver used in​ that GP  

• drivers.driver_id – technical key  
• drivers.forename / drivers.surname / drivers.full_name – to print the driver’s name  

Typical conditions   
races.year BETWEEN 1950 AND 1959  
HAVING COUNT(DISTINCT races.round) ≥ 2  
MIN(CASE WHEN …) = MAX(CASE WHEN …)   ← same constructor in first & last race  

Below are ten exploratory SQL queries (each limited to 20 rows) that gradually build up to the final answer.

```sql
-- 1. Seasons in the 1950s we have in the database
SELECT DISTINCT year
FROM races
WHERE year BETWEEN 1950 AND 1959
ORDER BY year
LIMIT 20;
```

```sql
-- 2. All race‑ids that belong to the 1950s
SELECT race_id, year, round, name
FROM races
WHERE year BETWEEN 1950 AND 1959
ORDER BY year, round
LIMIT 20;
```

```sql
-- 3. Drivers who appear in at least one 1950s race (id only)
SELECT DISTINCT r.driver_id
FROM results AS r
JOIN races  AS ra USING (race_id)
WHERE ra.year BETWEEN 1950 AND 1959
LIMIT 20;
```

```sql
-- 4. Same as #3 but with driver names
SELECT DISTINCT d.driver_id,
       d.forename || ' ' || d.surname AS driver_name
FROM results  AS res
JOIN races    AS ra  USING (race_id)
JOIN drivers  AS d   USING (driver_id)
WHERE ra.year BETWEEN 1950 AND 1959
ORDER BY driver_name
LIMIT 20;
```

```sql
-- 5. For an example driver (change the id) list the 1950s races he entered
SELECT ra.year,
       ra.round,
       res.constructor_id
FROM results AS res
JOIN races   AS ra USING (race_id)
WHERE ra.year BETWEEN 1950 AND 1959
  AND res.driver_id = 1          -- example driver_id
ORDER BY ra.year, ra.round
LIMIT 20;
```

```sql
-- 6. For every (driver,year) in 1950s: first and last constructor + #rounds
SELECT res.driver_id,
       ra.year,
       MIN(ra.round)                                AS first_round,
       MAX(ra.round)                                AS last_round,
       COUNT(DISTINCT ra.round)                     AS num_rounds,
       MIN(CASE WHEN ra.round = (SELECT MIN(round) 
                                 FROM races AS r2 
                                 JOIN results AS rs2 ON rs2.race_id = r2.race_id 
                                 WHERE r2.year = ra.year 
                                   AND rs2.driver_id = res.driver_id)
                THEN res.constructor_id END)        AS first_constructor,
       MAX(CASE WHEN ra.round = (SELECT MAX(round) 
                                 FROM races AS r3 
                                 JOIN results AS rs3 ON rs3.race_id = r3.race_id 
                                 WHERE r3.year = ra.year 
                                   AND rs3.driver_id = res.driver_id)
                THEN res.constructor_id END)        AS last_constructor
FROM results AS res
JOIN races   AS ra USING (race_id)
WHERE ra.year BETWEEN 1950 AND 1959
GROUP BY res.driver_id, ra.year
LIMIT 20;
```

```sql
-- 7. Filter the previous query: same constructor in first & last race
SELECT *
FROM (
    SELECT res.driver_id,
           ra.year,
           COUNT(DISTINCT ra.round)                     AS num_rounds,
           MIN(ra.round)                                AS first_round,
           MAX(ra.round)                                AS last_round,
           MIN(CASE WHEN ra.round = (SELECT MIN(round) FROM races r2 
                                      JOIN results rs2 ON rs2.race_id = r2.race_id 
                                      WHERE r2.year = ra.year 
                                        AND rs2.driver_id = res.driver_id)
                    THEN res.constructor_id END)        AS first_constructor,
           MAX(CASE WHEN ra.round = (SELECT MAX(round) FROM races r3 
                                      JOIN results rs3 ON rs3.race_id = r3.race_id 
                                      WHERE r3.year = ra.year 
                                        AND rs3.driver_id = res.driver_id)
                    THEN res.constructor_id END)        AS last_constructor
    FROM results AS res
    JOIN races   AS ra USING (race_id)
    WHERE ra.year BETWEEN 1950 AND 1959
    GROUP BY res.driver_id, ra.year
) sub
WHERE first_constructor = last_constructor
  AND num_rounds >= 2
LIMIT 20;
```

```sql
-- 8. Bring driver names into the filtered list
SELECT d.driver_id,
       d.forename || ' ' || d.surname AS driver_name,
       sub.year,
       sub.num_rounds,
       sub.first_constructor          AS constructor_id
FROM (
    -- same inner query as #7
    SELECT res.driver_id,
           ra.year,
           COUNT(DISTINCT ra.round)                     AS num_rounds,
           MIN(CASE WHEN ra.round = (SELECT MIN(round) FROM races r2 
                                      JOIN results rs2 ON rs2.race_id = r2.race_id 
                                      WHERE r2.year = ra.year 
                                        AND rs2.driver_id = res.driver_id)
                    THEN res.constructor_id END)        AS first_constructor,
           MAX(CASE WHEN ra.round = (SELECT MAX(round) FROM races r3 
                                      JOIN results rs3 ON rs3.race_id = r3.race_id 
                                      WHERE r3.year = ra.year 
                                        AND rs3.driver_id = res.driver_id)
                    THEN res.constructor_id END)        AS last_constructor
    FROM results AS res
    JOIN races   AS ra USING (race_id)
    WHERE ra.year BETWEEN 1950 AND 1959
    GROUP BY res.driver_id, ra.year
    HAVING first_constructor = last_constructor
       AND COUNT(DISTINCT ra.round) >= 2
) sub
JOIN drivers AS d USING (driver_id)
ORDER BY d.surname, d.forename, sub.year
LIMIT 20;
```

```sql
-- 9. Replace constructor_id by its name for better readability
SELECT d.forename || ' ' || d.surname AS driver_name,
       c.name                          AS constructor_name,
       sub.year,
       sub.num_rounds
FROM (
    -- identical sub‑query as #8
    SELECT res.driver_id,
           ra.year,
           COUNT(DISTINCT ra.round)                     AS num_rounds,
           MIN(CASE WHEN ra.round = (SELECT MIN(round) FROM races r2 
                                      JOIN results rs2 ON rs2.race_id = r2.race_id 
                                      WHERE r2.year = ra.year 
                                        AND rs2.driver_id = res.driver_id)
                    THEN res.constructor_id END)        AS first_constructor
    FROM results AS res
    JOIN races   AS ra USING (race_id)
    WHERE ra.year BETWEEN 1950 AND 1959
    GROUP BY res.driver_id, ra.year
    HAVING first_constructor = MAX(CASE WHEN ra.round = (SELECT MAX(round) FROM races r3 
                                                         JOIN results rs3 ON rs3.race_id = r3.race_id 
                                                         WHERE r3.year = ra.year 
                                                           AND rs3.driver_id = res.driver_id)
                                        THEN res.constructor_id END)
       AND COUNT(DISTINCT ra.round) >= 2
) sub
JOIN drivers      AS d  USING (driver_id)
JOIN constructors AS c  ON c.constructor_id = sub.first_constructor
ORDER BY sub.year, driver_name
LIMIT 20;
```

```sql
-- 10. (Final answer) – list every driver who meets all criteria in *any* 1950s season
SELECT DISTINCT d.forename || ' ' || d.surname AS driver_name
FROM (
    SELECT res.driver_id,
           ra.year,
           MIN(ra.round)                 AS first_round,
           MAX(ra.round)                 AS last_round,
           COUNT(DISTINCT ra.round)      AS num_rounds,
           MIN(CASE WHEN ra.round = (SELECT MIN(round) 
                                     FROM races r2 
                                     JOIN results rs2 ON rs2.race_id = r2.race_id 
                                     WHERE r2.year = ra.year 
                                       AND rs2.driver_id = res.driver_id)
                    THEN res.constructor_id END)  AS first_constructor,
           MAX(CASE WHEN ra.round = (SELECT MAX(round) 
                                     FROM races r3 
                                     JOIN results rs3 ON rs3.race_id = r3.race_id 
                                     WHERE r3.year = ra.year 
                                       AND rs3.driver_id = res.driver_id)
                    THEN res.constructor_id END)  AS last_constructor
    FROM results AS res
    JOIN races   AS ra USING (race_id)
    WHERE ra.year BETWEEN 1950 AND 1959
    GROUP BY res.driver_id, ra.year
    HAVING first_constructor = last_constructor
       AND num_rounds >= 2
) season_ok
JOIN drivers AS d USING (driver_id)
ORDER BY driver_name
LIMIT 20;
```

Each successive query digs a bit deeper—from identifying the seasons and drivers, through determining the first/last constructor they used in a season, to finally listing those who satisfy all the stated conditions.
