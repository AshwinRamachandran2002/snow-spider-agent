Query:
--Description:  #6 – For every (driver, year) in the 1950s list the first & last round
-- they contested, how many different rounds they entered, and which constructor
-- they used in the first and last of those rounds.
SELECT
    res.driver_id,
    ra.year,
    MIN(ra.round) AS first_round,
    MAX(ra.round) AS last_round,
    COUNT(DISTINCT ra.round) AS num_rounds,
    /* constructor in the driver’s first race of that season */
    MIN(
        CASE
            WHEN ra.round = (
                SELECT MIN(r2.round)
                FROM races   AS r2
                JOIN results AS rs2 ON rs2.race_id = r2.race_id
                WHERE r2.year      = ra.year
                  AND rs2.driver_id = res.driver_id
            )
            THEN res.constructor_id
        END
    ) AS first_constructor,
    /* constructor in the driver’s last race of that season */
    MAX(
        CASE
            WHEN ra.round = (
                SELECT MAX(r3.round)
                FROM races   AS r3
                JOIN results AS rs3 ON rs3.race_id = r3.race_id
                WHERE r3.year      = ra.year
                  AND rs3.driver_id = res.driver_id
            )
            THEN res.constructor_id
        END
    ) AS last_constructor
FROM results AS res
JOIN races   AS ra USING (race_id)
WHERE ra.year BETWEEN 1950 AND 1959
GROUP BY res.driver_id, ra.year
LIMIT 20
