--Description:  #7 – From the previous summary keep only (driver, year) pairs where
-- the same constructor was used in both the first and the last race, and the
-- driver took part in at least two distinct rounds.
SELECT *
FROM (
    SELECT
        res.driver_id,
        ra.year,
        COUNT(DISTINCT ra.round) AS num_rounds,
        MIN(ra.round) AS first_round,
        MAX(ra.round) AS last_round,
        MIN(
            CASE
                WHEN ra.round = (
                    SELECT MIN(r2.round)
                    FROM races   AS r2
                    JOIN results AS rs2 ON rs2.race_id = r2.race_id
                    WHERE r2.year      = ra.year
                      AND rs2.driver_id = res.driver_id
                )
                THEN res.constructor_id
            END
        ) AS first_constructor,
        MAX(
            CASE
                WHEN ra.round = (
                    SELECT MAX(r3.round)
                    FROM races   AS r3
                    JOIN results AS rs3 ON rs3.race_id = r3.race_id
                    WHERE r3.year      = ra.year
                      AND rs3.driver_id = res.driver_id
                )
                THEN res.constructor_id
            END
        ) AS last_constructor
    FROM results AS res
    JOIN races   AS ra USING (race_id)
    WHERE ra.year BETWEEN 1950 AND 1959
    GROUP BY res.driver_id, ra.year
) AS sub
WHERE sub.first_constructor = sub.last_constructor
  AND sub.num_rounds >= 2
LIMIT 20
