```sql
--Description:  Identify every driver‑season in the 1950‑1959 decade where the driver
-- 1) started and finished that season (their first and last race entries) with the
--    SAME constructor and
-- 2) contested at least two different rounds in that season.  
-- Steps inside the CTE `driver_season`:
--   • join results→races, keep 1950‑1959,
--   • for each (driver, year) gather the first round, last round and total rounds,
--   • capture the constructor used in the first‑round race and the constructor used
--     in the last‑round race,
--   • keep only rows where first_constructor = last_constructor and rounds ≥ 2.  
-- The outer query turns those qualifying seasons into a distinct list of driver
-- full names (you could also show year / constructor if desired).
WITH driver_season AS (
    SELECT
        res.driver_id,
        ra.year,
        COUNT(DISTINCT ra.round)                          AS num_rounds,
        -- constructor in the FIRST race the driver entered that season
        MIN(CASE
                WHEN ra.round = (
                    SELECT MIN(r2.round)
                    FROM races   r2
                    JOIN results rs2 ON rs2.race_id = r2.race_id
                    WHERE r2.year      = ra.year
                      AND rs2.driver_id = res.driver_id
                )
                THEN res.constructor_id
            END)                                          AS first_constructor,
        -- constructor in the LAST race the driver entered that season
        MAX(CASE
                WHEN ra.round = (
                    SELECT MAX(r3.round)
                    FROM races    r3
                    JOIN results  rs3 ON rs3.race_id = r3.race_id
                    WHERE r3.year      = ra.year
                      AND rs3.driver_id = res.driver_id
                )
                THEN res.constructor_id
            END)                                          AS last_constructor
    FROM results AS res
    JOIN races   AS ra  USING (race_id)
    WHERE ra.year BETWEEN 1950 AND 1959
    GROUP BY res.driver_id, ra.year
    HAVING num_rounds >= 2
       AND first_constructor = last_constructor
)
SELECT DISTINCT
       d.forename || ' ' || d.surname AS driver_name
FROM driver_season AS ds
JOIN drivers        d  ON d.driver_id = ds.driver_id
ORDER BY driver_name;
```
