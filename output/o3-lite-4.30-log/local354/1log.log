--Description:  #10 – Final answer.  List every driver who, in at least one season
-- during 1950‑1959, began and ended the season with the same constructor while
-- taking part in two or more distinct rounds.
SELECT DISTINCT
       d.forename || ' ' || d.surname AS driver_name
FROM (
    SELECT
        res.driver_id,
        ra.year,
        COUNT(DISTINCT ra.round) AS num_rounds,
        MIN(
            CASE
                WHEN ra.round = (
                    SELECT MIN(r2.round)
                    FROM races   AS r2
                    JOIN results AS rs2 ON rs2.race_id = r2.race_id
                    WHERE r2.year      = ra.year
                      AND rs2.driver_id = res.driver_id
                )
                THEN res.constructor_id
            END
        ) AS first_constructor,
        MAX(
            CASE
                WHEN ra.round = (
                    SELECT MAX(r3.round)
                    FROM races   AS r3
                    JOIN results AS rs3 ON rs3.race_id = r3.race_id
                    WHERE r3.year      = ra.year
                      AND rs3.driver_id = res.driver_id
                )
                THEN res.constructor_id
            END
        ) AS last_constructor
    FROM results AS res
    JOIN races   AS ra USING (race_id)
    WHERE ra.year BETWEEN 1950 AND 1959
    GROUP BY res.driver_id, ra.year
    HAVING first_constructor = last_constructor
       AND num_rounds >= 2
) AS season_ok
JOIN drivers AS d USING (driver_id)
ORDER BY driver_name
LIMIT 20
