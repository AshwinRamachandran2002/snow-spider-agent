-- 10) FINAL ANSWER: complete list of all driver‑season pairs that meet every criterion
WITH summary AS (
  SELECT res."driver_id",
         r."year",
         MIN(r."round") AS first_round,
         MAX(r."round") AS last_round,
         COUNT(DISTINCT r."round") AS rounds_entered
  FROM results AS res
  JOIN races   AS r ON r."race_id" = res."race_id"
  WHERE r."year" BETWEEN 1950 AND 1959
  GROUP BY res."driver_id", r."year"
  HAVING rounds_entered >= 2
),
first_const AS (
  SELECT s."driver_id", s."year", res."constructor_id" AS constructor_id
  FROM summary AS s
  JOIN races   AS r   ON r."year" = s."year"  AND r."round" = s."first_round"
  JOIN results AS res ON res."race_id" = r."race_id" AND res."driver_id" = s."driver_id"
),
last_const AS (
  SELECT s."driver_id", s."year", res."constructor_id" AS constructor_id
  FROM summary AS s
  JOIN races   AS r   ON r."year" = s."year"  AND r."round" = s."last_round"
  JOIN results AS res ON res."race_id" = r."race_id" AND res."driver_id" = s."driver_id"
)
SELECT DISTINCT d."forename" || ' ' || d."surname"  AS driver_name,
       s."year",
       c."name"                                     AS constructor_name,
       s.rounds_entered
FROM summary     AS s
JOIN first_const AS fc ON fc."driver_id" = s."driver_id" AND fc."year" = s."year"
JOIN last_const  AS lc ON lc."driver_id" = s."driver_id" AND lc."year" = s."year"
JOIN drivers     AS d  ON d."driver_id" = s."driver_id"
JOIN constructors AS c ON c."constructor_id" = fc."constructor_id"
WHERE fc."constructor_id" = lc."constructor_id"
ORDER BY s."year", driver_name
LIMIT 20;
