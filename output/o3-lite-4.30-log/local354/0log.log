        ds.driver_id,
        ds.year,
        res.constructor_id
    FROM driver_season ds
    JOIN races   r   ON r.year = ds.year  AND r.round = ds.first_round
    JOIN results res ON res.race_id = r.race_id AND res.driver_id = ds.driver_id
),
last_const AS (
    SELECT
        ds.driver_id,
        ds.year,
        res.constructor_id
    FROM driver_season ds
