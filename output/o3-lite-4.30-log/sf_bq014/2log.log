2025-05-01 01:45:46 - Thread-435 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
• ORDERS."user_id": join key to users and order items  
• ORDERS."order_id": join key to order items  
• ORDERS."created_at": decide which order is the customer’s first  
• ORDERS."status": drop rows where status = 'Cancelled'  
• ORDERS."returned_at": keep only rows where value IS NULL  

• ORDER_ITEMS."order_id": join key back to ORDERS  
• ORDER_ITEMS."product_id": join key to PRODUCTS  
• ORDER_ITEMS."sale_price": revenue to be summed  
• ORDER_ITEMS."status": may reconfirm non‑cancelled rows  
• ORDER_ITEMS."returned_at": keep only NULL (not returned)  

• PRODUCTS."id": join key from ORDER_ITEMS."product_id"  
• PRODUCTS."category": product category to group by when counting distinct customers and summing revenue  

Typical conditions you will need  
1. ORDERS."status" <> 'Cancelled'  
2. ORDERS."returned_at" IS NULL  
3. ORDER_ITEMS."returned_at" IS NULL  
4. (optional) ORDER_ITEMS."status" <> 'Cancelled'  
5. Pick MIN(ORDERS."created_at") per ORDERS."user_id" to get the first qualifying order  

Ten exploratory Snowflake SQL queries (all capped at 20 rows)  
```sql
-- 1) Description: Look at distinct order statuses.
SELECT DISTINCT "status"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
LIMIT 20;
```

```sql
-- 2) Description: Sample of non‑cancelled, non‑returned orders.
SELECT "order_id",
       "user_id",
       "status",
       "created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
WHERE "status" <> 'Cancelled'
  AND "returned_at" IS NULL
LIMIT 20;
```

```sql
-- 3) Description: Earliest qualifying order for each customer (first pass, no LIMIT in window; outer LIMIT to keep result short).
SELECT "user_id",
       "order_id",
       "created_at"
FROM (
    SELECT "user_id",
           "order_id",
           "created_at",
           ROW_NUMBER() OVER(PARTITION BY "user_id" ORDER BY "created_at") AS rn
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
    WHERE "status" <> 'Cancelled'
      AND "returned_at" IS NULL
) t
WHERE rn = 1
LIMIT 20;
```

```sql
-- 4) Description: Join first‑order list to ORDER_ITEMS to see purchased products.
WITH first_orders AS (
    SELECT "user_id",
           "order_id"
    FROM (
        SELECT "user_id",
               "order_id",
               ROW_NUMBER() OVER(PARTITION BY "user_id" ORDER BY "created_at") AS rn
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "status" <> 'Cancelled'
          AND "returned_at" IS NULL
    )
    WHERE rn = 1
)
SELECT oi."order_id",
       oi."product_id",
       oi."sale_price"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
JOIN first_orders fo
  ON oi."order_id" = fo."order_id"
WHERE oi."returned_at" IS NULL
  AND oi."status" <> 'Cancelled'
LIMIT 20;
```

```sql
-- 5) Description: Attach product category to first‑order items.
WITH first_orders AS (
    SELECT "user_id",
           "order_id"
    FROM (
        SELECT "user_id",
               "order_id",
               ROW_NUMBER() OVER(PARTITION BY "user_id" ORDER BY "created_at") AS rn
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "status" <> 'Cancelled'
          AND "returned_at" IS NULL
    )
    WHERE rn = 1
)
SELECT oi."order_id",
       p."category",
       oi."sale_price"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
JOIN first_orders fo
  ON oi."order_id" = fo."order_id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
  ON p."id" = oi."product_id"
WHERE oi."returned_at" IS NULL
  AND oi."status" <> 'Cancelled'
LIMIT 20;
```

```sql
-- 6) Description: Count distinct customers per category in first orders.
WITH first_orders AS (
    SELECT "user_id",
           "order_id"
    FROM (
        SELECT "user_id",
               "order_id",
               ROW_NUMBER() OVER(PARTITION BY "user_id" ORDER BY "created_at") AS rn
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "status" <> 'Cancelled'
          AND "returned_at" IS NULL
    )
    WHERE rn = 1
)
SELECT p."category",
       COUNT(DISTINCT fo."user_id") AS "num_customers"
FROM first_orders fo
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
  ON oi."order_id" = fo."order_id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
  ON p."id" = oi."product_id"
WHERE oi."returned_at" IS NULL
  AND oi."status" <> 'Cancelled'
GROUP BY p."category"
ORDER BY "num_customers" DESC
LIMIT 20;
```

```sql
-- 7) Description: Find the top category alone (CTE version showing rank).
WITH first_orders AS (
    SELECT "user_id",
           "order_id"
    FROM (
        SELECT "user_id",
               "order_id",
               ROW_NUMBER() OVER(PARTITION BY "user_id" ORDER BY "created_at") AS rn
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "status" <> 'Cancelled'
          AND "returned_at" IS NULL
    )
    WHERE rn = 1
), category_counts AS (
    SELECT p."category",
           COUNT(DISTINCT fo."user_id") AS "num_customers",
           ROW_NUMBER() OVER(ORDER BY COUNT(DISTINCT fo."user_id") DESC) AS rnk
    FROM first_orders fo
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
      ON oi."order_id" = fo."order_id"
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
      ON p."id" = oi."product_id"
    WHERE oi."returned_at" IS NULL
      AND oi."status" <> 'Cancelled'
    GROUP BY p."category"
)
SELECT *
FROM category_counts
WHERE rnk = 1
LIMIT 20;
```

```sql
-- 8) Description: Sum revenue for every category in first orders.
WITH first_orders AS (
    SELECT "user_id",
           "order_id"
    FROM (
        SELECT "user_id",
               "order_id",
               ROW_NUMBER() OVER(PARTITION BY "user_id" ORDER BY "created_at") AS rn
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "status" <> 'Cancelled'
          AND "returned_at" IS NULL
    )
    WHERE rn = 1
)
SELECT p."category",
       SUM(oi."sale_price") AS "revenue"
FROM first_orders fo
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
  ON oi."order_id" = fo."order_id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
  ON p."id" = oi."product_id"
WHERE oi."returned_at" IS NULL
  AND oi."status" <> 'Cancelled'
GROUP BY p."category"
ORDER BY "revenue" DESC
LIMIT 20;
```

```sql
-- 9) Description: Combine steps 6–8 to isolate the single highest‑customer category, then list its revenue.
WITH first_orders AS (
    SELECT "user_id",
           "order_id"
    FROM (
        SELECT "user_id",
               "order_id",
               ROW_NUMBER() OVER(PARTITION BY "user_id" ORDER BY "created_at") AS rn
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "status" <> 'Cancelled'
          AND "returned_at" IS NULL
    )
    WHERE rn = 1
), category_customer_ct AS (
    SELECT p."category",
           COUNT(DISTINCT fo."user_id") AS "num_customers"
    FROM first_orders fo
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
      ON oi."order_id" = fo."order_id"
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
      ON p."id" = oi."product_id"
    WHERE oi."returned_at" IS NULL
      AND oi."status" <> 'Cancelled'
    GROUP BY p."category"
), top_category AS (
    SELECT "category"
    FROM category_customer_ct
    ORDER BY "num_customers" DESC
    LIMIT 1
)
SELECT tc."category",
       SUM(oi."sale_price") AS "revenue"
FROM top_category tc
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
  ON 1=1
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
  ON o."order_id" = oi."order_id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
  ON p."id" = oi."product_id"
WHERE p."category" = tc."category"
  AND o."status" <> 'Cancelled'
  AND o."returned_at" IS NULL
  AND oi."returned_at" IS NULL
  AND oi."status" <> 'Cancelled'
  AND o."created_at" = (
        SELECT MIN(o2."created_at")
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o2
        WHERE o2."user_id" = o."user_id"
          AND o2."status" <> 'Cancelled'
          AND o2."returned_at" IS NULL
  )
GROUP BY tc."category"
LIMIT 20;
```

```sql
-- 10) Description: Streamlined final query delivering only the revenue amount for the category with the most first‑order customers.
WITH first_orders AS (
    SELECT "user_id",
           "order_id"
    FROM (
        SELECT "user_id",
               "order_id",
               ROW_NUMBER() OVER(PARTITION BY "user_id" ORDER BY "created_at") AS rn
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "status" <> 'Cancelled'
          AND "returned_at" IS NULL
    )
    WHERE rn = 1
), ranked_category AS (
    SELECT p."category",
           COUNT(DISTINCT fo."user_id") AS "num_customers",
           ROW_NUMBER() OVER(ORDER BY COUNT(DISTINCT fo."user_id") DESC) AS rnk
    FROM first_orders fo
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
      ON oi."order_id" = fo."order_id"
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
      ON p."id" = oi."product_id"
    WHERE oi."returned_at" IS NULL
      AND oi."status" <> 'Cancelled'
    GROUP BY p."category"
), final_rev AS (
    SELECT p."category",
           SUM(oi."sale_price") AS "revenue"
    FROM ranked_category rc
    JOIN first_orders fo
      ON rc.rnk = 1
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
      ON oi."order_id" = fo."order_id"
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
      ON p."id" = oi."product_id"
    WHERE rc."category" = p."category"
      AND oi."returned_at" IS NULL
      AND oi."status" <> 'Cancelled'
    GROUP BY p."category"
)
SELECT *
FROM final_rev
LIMIT 20;
```
