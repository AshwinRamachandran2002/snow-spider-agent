         COUNT(DISTINCT fg."user_id") AS "num_customers_first_order",
         RANK() OVER (ORDER BY COUNT(DISTINCT fg."user_id") DESC) AS "rnk"
  FROM   first_good                     fg
  JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"   i
    ON   fg."first_good_order_id" = i."order_id"
  JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      p
    ON   i."product_id" = p."id"
  GROUP  BY p."category"
)
SELECT *
FROM   cat_rank
WHERE  "rnk" = 1
LIMIT 20;
```

```sql
--Description: 10) Compute total revenue (sum of sale_price) for that top category across *all* valid items.
WITH first_good AS (
  SELECT DISTINCT FIRST_VALUE(o."order_id") OVER (PARTITION BY o."user_id" 
                                                  ORDER BY o."created_at") AS "first_good_order_id",
         o."user_id"
  FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"      o
  JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" i
    ON   o."order_id" = i."order_id"
  WHERE  o."status" <> 'Cancelled'
    AND  i."returned_at" IS NULL
    AND  i."status" <> 'Returned'
),
top_cat AS (
  SELECT p."category",
         COUNT(DISTINCT fg."user_id") AS "num_customers_first_order",
         RANK() OVER (ORDER BY COUNT(DISTINCT fg."user_id") DESC) AS "rnk"
  FROM   first_good                     fg
  JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"   i
    ON   fg."first_good_order_id" = i."order_id"
  JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      p
    ON   i."product_id" = p."id"
  GROUP  BY p."category"
)
SELECT p."category",
       SUM(i."sale_price") AS "revenue_all_items_in_top_category"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"   i
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      p
  ON   i."product_id" = p."id"
JOIN   top_cat tc
  ON   p."category" = tc."category"
WHERE  tc."rnk" = 1
  AND  i."returned_at" IS NULL
  AND  i."status" <> 'Returned'
GROUP  BY p."category"
LIMIT 20;
```

