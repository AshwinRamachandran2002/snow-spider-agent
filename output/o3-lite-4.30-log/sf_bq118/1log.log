--              (1) the word “discharge” (excluding “Urethral discharge”, “Discharge of firework”,
--                  and any “firearm discharge”), versus
--              (2) the word “vehicle”.
--              Steps implemented in one statement:
--              • CTE discharge_avg   – counts deaths per (AgeRecode27, Icd10Code) that meet the
--                                       “discharge” filters, then averages those counts per age band.
--              • CTE vehicle_avg     – same logic for “vehicle”.
--              • Final SELECT joins both CTEs, adds readable age‑group names from AGERECODE27,
--                and computes the difference (avg_discharge - avg_vehicle).
WITH discharge_avg AS (
    SELECT
           DR."AgeRecode27",
           AVG(code_death_cnt) AS "avg_discharge"
    FROM (
            SELECT
                   DR."AgeRecode27",
                   DR."Icd10Code",
                   COUNT(*) AS code_death_cnt
            FROM   DEATH.DEATH.DEATHRECORDS AS DR
            JOIN   DEATH.DEATH.ICD10CODE    AS IC
                   ON DR."Icd10Code" = IC."Code"
            WHERE  DR."RaceRecode3" = 1                             -- White only
              AND  IC."Description" ILIKE '%discharge%'
              AND  IC."Description" NOT ILIKE '%urethral discharge%'
              AND  IC."Description" NOT ILIKE '%discharge of firework%'
              AND  IC."Description" NOT ILIKE '%firearm discharge%'
            GROUP  BY DR."AgeRecode27", DR."Icd10Code"
         ) sub
    GROUP BY DR."AgeRecode27"
),
vehicle_avg AS (
    SELECT
           DR."AgeRecode27",
           AVG(code_death_cnt) AS "avg_vehicle"
    FROM (
            SELECT
                   DR."AgeRecode27",
                   DR."Icd10Code",
                   COUNT(*) AS code_death_cnt
            FROM   DEATH.DEATH.DEATHRECORDS AS DR
            JOIN   DEATH.DEATH.ICD10CODE    AS IC
                   ON DR."Icd10Code" = IC."Code"
            WHERE  DR."RaceRecode3" = 1
              AND  IC."Description" ILIKE '%vehicle%'
            GROUP  BY DR."AgeRecode27", DR."Icd10Code"
