--Description: 9) Attach readable age‑group names to both averages.  In each CTE the outer SELECT
--              must refer to the inner‑query alias (x or y), not DR.
WITH discharge_avg AS (
    SELECT
           x."AgeRecode27",
           AVG(x.cnt) AS "avg_discharge"
    FROM (
            SELECT
                   DR."AgeRecode27",
                   DR."Icd10Code",
                   COUNT(*) AS cnt
            FROM   DEATH.DEATH.DEATHRECORDS AS DR
            JOIN   DEATH.DEATH.ICD10CODE    AS IC
                   ON DR."Icd10Code" = IC."Code"
            WHERE  DR."RaceRecode3" = 1
