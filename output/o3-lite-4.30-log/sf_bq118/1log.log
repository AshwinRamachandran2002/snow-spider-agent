```sql
--Description: We need, for White decedents (RaceRecode3 = 1), the difference between
--             (i) the average number of deaths per ICD‑10 code whose description
--                 contains “discharge” (excluding “Urethral discharge”, “Discharge of firework”,
--                 and any “firearm discharge”), and
--             (ii) the average number of deaths per ICD‑10 code whose description
--                 contains “vehicle”, all computed within each 27‑group age band.
--             The steps are implemented in one query:
--               1. “discharge_avg” CTE – compute the average deaths per ICD code
--                  that pass the “discharge” filters for every AgeRecode27.
--               2. “vehicle_avg”   CTE – same idea with “vehicle”.
--               3. Join the CTEs, add readable age‑group names, and calculate the
--                  difference (avg_discharge − avg_vehicle).
WITH discharge_avg AS (
    SELECT
           DR."AgeRecode27",
           AVG(code_death_count) AS "avg_discharge"
    FROM (
            SELECT
                   DR."AgeRecode27",
                   DR."Icd10Code",
                   COUNT(*) AS code_death_count
            FROM   DEATH.DEATH.DEATHRECORDS AS DR
            JOIN   DEATH.DEATH.ICD10CODE    AS IC
                   ON DR."Icd10Code" = IC."Code"
            WHERE  DR."RaceRecode3" = 1
              AND  IC."Description" ILIKE '%discharge%'
              AND  IC."Description" NOT ILIKE '%urethral discharge%'
              AND  IC."Description" NOT ILIKE '%discharge of firework%'
              AND  IC."Description" NOT ILIKE '%firearm discharge%'
            GROUP BY DR."AgeRecode27", DR."Icd10Code"
         ) sub
    GROUP BY DR."AgeRecode27"
),
vehicle_avg AS (
    SELECT
           DR."AgeRecode27",
           AVG(code_death_count) AS "avg_vehicle"
    FROM (
            SELECT
                   DR."AgeRecode27",
                   DR."Icd10Code",
                   COUNT(*) AS code_death_count
            FROM   DEATH.DEATH.DEATHRECORDS AS DR
            JOIN   DEATH.DEATH.ICD10CODE    AS IC
                   ON DR."Icd10Code" = IC."Code"
            WHERE  DR."RaceRecode3" = 1
              AND  IC."Description" ILIKE '%vehicle%'
            GROUP BY DR."AgeRecode27", DR."Icd10Code"
         ) sub
    GROUP BY DR."AgeRecode27"
)
SELECT
       AR."Description"                       AS "age_group",
       d."avg_discharge",
       v."avg_vehicle",
       (d."avg_discharge" - v."avg_vehicle")  AS "avg_diff_discharge_minus_vehicle"
FROM   discharge_avg AS d
JOIN   vehicle_avg   AS v
  ON   d."AgeRecode27" = v."AgeRecode27"
JOIN   DEATH.DEATH.AGERECODE27 AS AR
  ON   AR."Code" = d."AgeRecode27"
ORDER  BY d."AgeRecode27";
