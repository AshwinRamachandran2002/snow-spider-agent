```sql
--Description: Find Procter & Gamble’s busiest year for A61 patents and return the five jurisdictions (country_code)
--             where they filed the most patents that year.
-- Steps:
--   1. pg_a61 CTE: keep publications whose CPC JSON field "code" starts with 'A61' and whose harmonized assignee
--      name ILIKE 'PROCTER%GAMBLE%'.  Extract publication_number, country_code, and year.
--   2. busiest CTE: compute which year (pub_year) has the highest distinct‑publication count.
--   3. Final SELECT: for that busiest year, count distinct publication_numbers per country_code,
--      order by count desc, and limit to the top five jurisdictions.
WITH pg_a61 AS (
    SELECT
        p.publication_number,
        p.country_code,
        SUBSTR(CAST(p.publication_date AS STRING), 1, 4) AS pub_year
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p.cpc)                 c,
         LATERAL FLATTEN(input => p.assignee_harmonized) a
    WHERE c.value:"code"::STRING ILIKE 'A61%'            -- limit to A61 CPC codes
      AND a.value:"name"::STRING ILIKE 'PROCTER%GAMBLE%' -- Procter & Gamble variants
),
busiest AS (
    SELECT pub_year
    FROM pg_a61
    GROUP BY pub_year
    ORDER BY COUNT(DISTINCT publication_number) DESC
    LIMIT 1
)
SELECT
       country_code
FROM pg_a61
WHERE pub_year = (SELECT pub_year FROM busiest)
GROUP BY country_code
ORDER BY COUNT(DISTINCT publication_number) DESC
LIMIT 5;
