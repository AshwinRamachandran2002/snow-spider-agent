Query:
--Description: 9 – Return the top five jurisdictions (country_code) together with their patent counts for Procter & Gamble’s busiest A61 year.
WITH pg_a61 AS (                           -- collect all P&G A61‑category publications
    SELECT
        p."publication_number"                             AS pub_num,
        p."country_code"                                   AS country_code,
        SUBSTR(CAST(p."publication_date" AS STRING), 1, 4) AS pub_year
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")                 c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%'              -- A61 CPC codes
      AND a.value:"name"::STRING ILIKE 'PROCTER%GAMBLE%'   -- Procter & Gamble
),
busiest AS (                           -- identify busiest publication year
    SELECT pub_year
    FROM pg_a61
    GROUP BY pub_year
    ORDER BY COUNT(DISTINCT pub_num) DESC
    LIMIT 1
)
SELECT
       country_code,
       COUNT(DISTINCT pub_num) AS patents_in_year_country
FROM pg_a61
WHERE pub_year = (SELECT pub_year FROM busiest)            -- restrict to busiest year
GROUP BY country_code
ORDER BY patents_in_year_country DESC
LIMIT 5
