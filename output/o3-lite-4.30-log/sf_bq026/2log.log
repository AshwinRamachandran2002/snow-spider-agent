```sql
--Description: 8 – Jurisdiction counts during the busiest publication year for Procter & Gamble’s A61‑category patents.
WITH pg_a61 AS (
    SELECT
        p."publication_number",
        p."country_code",
        SUBSTR(CAST(p."publication_date" AS STRING), 1, 4) AS pub_year
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")                 c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%'              -- A61 CPC codes
      AND a.value:"name"::STRING ILIKE 'PROCTER%GAMBLE%'   -- Procter & Gamble
),
busiest AS (
    SELECT pub_year
    FROM pg_a61
    GROUP BY pub_year
    ORDER BY COUNT(DISTINCT "publication_number") DESC
    LIMIT 1
)
SELECT
       country_code,
       COUNT(DISTINCT publication_number) AS patents_in_year_country
FROM pg_a61
WHERE pub_year = (SELECT pub_year FROM busiest)
GROUP BY country_code
ORDER BY patents_in_year_country DESC
LIMIT 20;
```

```sql
--Description: 9 – Same as #8 but return only the top five jurisdiction codes.
WITH pg_a61 AS (
    SELECT
        p."publication_number",
        p."country_code",
        SUBSTR(CAST(p."publication_date" AS STRING), 1, 4) AS pub_year
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")                 c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%'
      AND a.value:"name"::STRING ILIKE 'PROCTER%GAMBLE%'
),
busiest AS (
    SELECT pub_year
    FROM pg_a61
    GROUP BY pub_year
    ORDER BY COUNT(DISTINCT "publication_number") DESC
    LIMIT 1
)
SELECT
       country_code
FROM pg_a61
WHERE pub_year = (SELECT pub_year FROM busiest)
GROUP BY country_code
ORDER BY COUNT(DISTINCT publication_number) DESC
LIMIT 5;
```

