```sql
--Description:  One‑shot query to answer the original task:
--              1)  Identify the assignee with the most distinct publications that contain at least one
--                  CPC code starting with ‘A61’.
--              2)  For that top assignee, find the single year in which they published the most such
--                  patents (“busiest year”).
--              3)  Within that busiest year, count how many of those patents were published in each
--                  jurisdiction (country_code).
--              4)  Return the five jurisdictions with the highest counts, concatenated in descending
--                  order with commas (e.g.  'US,CA,AU,DK,AT').
WITH pub_a61 AS (  -- all publications that include an A61 CPC code, exploded by assignee
    SELECT DISTINCT
           p."publication_number",
           p."country_code",
           SUBSTR(CAST(p."publication_date" AS STRING),1,4)        AS pub_year,
           a.value:"name"::STRING                                  AS assignee_name
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")                 c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%'              -- keep only A61 category
),
top_assignee AS (         -- who has the most A61 publications overall?
    SELECT assignee_name
    FROM pub_a61
    GROUP BY assignee_name
    ORDER BY COUNT(DISTINCT publication_number) DESC
    LIMIT 1
),
busiest_year AS (         -- the year in which that assignee was most active
    SELECT pub_year
    FROM pub_a61
    WHERE assignee_name = (SELECT assignee_name FROM top_assignee)
    GROUP BY pub_year
    ORDER BY COUNT(DISTINCT publication_number) DESC
    LIMIT 1
),
jurisdiction_counts AS (  -- counts by country in the busiest year
    SELECT
           country_code,
           COUNT(DISTINCT publication_number) AS patents_cnt
    FROM pub_a61
    WHERE assignee_name = (SELECT assignee_name FROM top_assignee)
      AND pub_year      = (SELECT pub_year      FROM busiest_year)
    GROUP BY country_code
    ORDER BY patents_cnt DESC
    LIMIT 5
)
SELECT
       LISTAGG(country_code, ',') WITHIN GROUP (ORDER BY patents_cnt DESC)  AS top_5_jurisdictions
FROM jurisdiction_counts;
```
