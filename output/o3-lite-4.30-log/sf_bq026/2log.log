```sql
--Description: Determine how many A61‑category patents “Procter & Gamble” published each year.
--Logic:
-- 1. Flatten the "cpc" array and keep only rows whose JSON key "code" starts with 'A61'.
-- 2. Flatten the "assignee_harmonized" array and retain rows whose "name" contains both
--    “PROCTER” and “GAMBLE” (case‑insensitive) via ILIKE 'PROCTER%GAMBLE%'.
-- 3. Derive the publication year from the first four characters of "publication_date".
-- 4. Count distinct publication numbers per year and sort to reveal the busiest year(s).
SELECT
       SUBSTR(CAST(p."publication_date" AS STRING), 1, 4) AS pub_year,
       COUNT(DISTINCT p."publication_number")             AS patents_in_year
FROM PATENTS.PATENTS.PUBLICATIONS        p,
     LATERAL FLATTEN(input => p."cpc")   c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%'          -- retain only A61 CPC codes
  AND a.value:"name"::STRING ILIKE 'PROCTER%GAMBLE%' -- match Procter & Gamble
  AND p."publication_date" IS NOT NULL             -- ensure date exists
GROUP BY pub_year
ORDER BY patents_in_year DESC
LIMIT 20;
```
