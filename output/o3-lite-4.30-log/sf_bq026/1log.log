2025-05-01 00:45:45 - Thread-17 (execute) - INFO - [Exploration]
Relevant columns and their potential usage

• “cpc”: contains Cooperative Patent Classification symbols; filter rows whose CPC symbols start with ‘A61’.

• “assignee_harmonized”: (VARIANT, mostly arrays/objects) holds the harmonised assignee names; flatten it to get the assignee that has been most active.

• “publication_date”: numeric YYYYMMDD; the first four digits give the publication year – extract them to find each assignee’s busiest year.

• “country_code”: two–letter jurisdiction code; count how many patents were filed in every jurisdiction.

• “publication_number”, “family_id”: identify individual publications / patent families if needed.

Typical conditions you may use  
– LATERAL FLATTEN on “cpc” and “assignee_harmonized”  
– WHERE c.value::STRING ILIKE 'A61%' to retain only A61‑class patents  
– SUBSTR(TO_VARCHAR("publication_date"),1,4) AS "pub_year" to group by year  
– GROUP BY … ORDER BY COUNT(*) DESC to pick the busiest year or the most‑active assignee  

Ten exploratory Snowflake SQL queries
(The queries progress from simple inspection to the complete answer. All column names are enclosed in double quotes and each query is limited to 20 rows.)

```sql
-- 1. Description:  Look at raw CPC symbols to understand their format
SELECT DISTINCT c.value::STRING AS "cpc_symbol"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") c
LIMIT 20;
```

```sql
-- 2. Description:  Inspect harmonised assignee values (flattened)
SELECT DISTINCT a.value::STRING AS "assignee_name"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
LIMIT 20;
```

```sql
-- 3. Description:  Sample publications that belong to CPC section 'A61'
SELECT p."publication_number",
       c.value::STRING AS "cpc_symbol"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") c
WHERE c.value::STRING ILIKE 'A61%'
LIMIT 20;
```

```sql
-- 4. Description:  Count A61 publications per assignee (top 20)
SELECT a.value::STRING AS "assignee_name",
       COUNT(*) AS "a61_pub_count"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE c.value::STRING ILIKE 'A61%'
GROUP BY a.value::STRING
ORDER BY "a61_pub_count" DESC
LIMIT 20;
```

```sql
-- 5. Description:  For every assignee, see the publication count by year (sample 20 rows)
SELECT a.value::STRING           AS "assignee_name",
       SUBSTR(TO_VARCHAR(p."publication_date"),1,4) AS "pub_year",
       COUNT(*)                  AS "a61_pub_count"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE c.value::STRING ILIKE 'A61%'
GROUP BY a.value::STRING,
         SUBSTR(TO_VARCHAR(p."publication_date"),1,4)
ORDER BY "a61_pub_count" DESC
LIMIT 20;
```

```sql
-- 6. Description:  Identify the single most‑active assignee overall in A61
SELECT a.value::STRING AS "top_assignee",
       COUNT(*)        AS "a61_total"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE c.value::STRING ILIKE 'A61%'
GROUP BY a.value::STRING
ORDER BY "a61_total" DESC
LIMIT 1;
```

```sql
-- 7. Description:  For the most‑active assignee, find its busiest year
WITH top_assignee AS (
    SELECT a.value::STRING AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value::STRING ILIKE 'A61%'
    GROUP BY a.value::STRING
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT SUBSTR(TO_VARCHAR(p."publication_date"),1,4) AS "pub_year",
       COUNT(*) AS "yearly_a61_count"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a,
     top_assignee t
WHERE c.value::STRING ILIKE 'A61%'
  AND a.value::STRING = t."assignee_name"
GROUP BY SUBSTR(TO_VARCHAR(p."publication_date"),1,4)
ORDER BY "yearly_a61_count" DESC
LIMIT 1;
```

```sql
-- 8. Description:  List A61 publications for that assignee in its busiest year (sample 20)
WITH top_assignee AS (
    SELECT a.value::STRING AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value::STRING ILIKE 'A61%'
    GROUP BY a.value::STRING
    ORDER BY COUNT(*) DESC
    LIMIT 1
), busiest_year AS (
    SELECT SUBSTR(TO_VARCHAR(p."publication_date"),1,4) AS "pub_year"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a,
         top_assignee t
    WHERE c.value::STRING ILIKE 'A61%'
      AND a.value::STRING = t."assignee_name"
    GROUP BY SUBSTR(TO_VARCHAR(p."publication_date"),1,4)
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT p."publication_number",
       p."country_code",
       p."publication_date"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a,
     top_assignee t,
     busiest_year y
WHERE c.value::STRING ILIKE 'A61%'
  AND a.value::STRING = t."assignee_name"
  AND SUBSTR(TO_VARCHAR(p."publication_date"),1,4) = y."pub_year"
LIMIT 20;
```

```sql
-- 9. Description:  Count patents by jurisdiction in the busiest year for that assignee
WITH top_assignee AS (
    SELECT a.value::STRING AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value::STRING ILIKE 'A61%'
    GROUP BY a.value::STRING
    ORDER BY COUNT(*) DESC
    LIMIT 1
), busiest_year AS (
    SELECT SUBSTR(TO_VARCHAR(p."publication_date"),1,4) AS "pub_year"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a,
         top_assignee t
    WHERE c.value::STRING ILIKE 'A61%'
      AND a.value::STRING = t."assignee_name"
    GROUP BY SUBSTR(TO_VARCHAR(p."publication_date"),1,4)
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT p."country_code",
       COUNT(*) AS "country_count"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a,
     top_assignee t,
     busiest_year y
WHERE c.value::STRING ILIKE 'A61%'
  AND a.value::STRING = t."assignee_name"
  AND SUBSTR(TO_VARCHAR(p."publication_date"),1,4) = y."pub_year"
GROUP BY p."country_code"
ORDER BY "country_count" DESC
LIMIT 20;
```

```sql
-- 10. Description:  Final query – return the five jurisdiction codes (comma‑separated) in which the top assignee filed the most A61 patents during its busiest year
WITH top_assignee AS (
    SELECT a.value::STRING AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value::STRING ILIKE 'A61%'
    GROUP BY a.value::STRING
    ORDER BY COUNT(*) DESC
    LIMIT 1
), busiest_year AS (
    SELECT SUBSTR(TO_VARCHAR(p."publication_date"),1,4) AS "pub_year"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a,
         top_assignee t
    WHERE c.value::STRING ILIKE 'A61%'
      AND a.value::STRING = t."assignee_name"
    GROUP BY SUBSTR(TO_VARCHAR(p."publication_date"),1,4)
    ORDER BY COUNT(*) DESC
    LIMIT 1
), ranked_countries AS (
    SELECT p."country_code",
           COUNT(*) AS "cnt",
           ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS "rn"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a,
         top_assignee t,
         busiest_year y
    WHERE c.value::STRING ILIKE 'A61%'
      AND a.value::STRING = t."assignee_name"
      AND SUBSTR(TO_VARCHAR(p."publication_date"),1,4) = y."pub_year"
    GROUP BY p."country_code"
)
SELECT LISTAGG("country_code", ',') WITHIN GROUP (ORDER BY "cnt" DESC) AS "top_5_jurisdictions"
FROM ranked_countries
WHERE "rn" <= 5;
```

These ten queries should let you move step‑by‑step from exploring the data through to retrieving the five jurisdiction codes requested in the task.
