--Description: 8) Country‑level patent counts for Procter & Gamble in its busiest A61 year
WITH pg_busiest AS (
    SELECT FLOOR(p."publication_date" / 10000) AS pub_year
    FROM   PATENTS.PATENTS.PUBLICATIONS                 p
    CROSS JOIN LATERAL FLATTEN(input => p."cpc")        c
    CROSS JOIN LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE  c.value:"code"::STRING LIKE 'A61%'
      AND  a.value:"name"::STRING ILIKE '%PROCTER%GAMBLE%'
    GROUP  BY FLOOR(p."publication_date" / 10000)
    ORDER  BY COUNT(*) DESC
    LIMIT 1
)
SELECT
       p."country_code",
       COUNT(*) AS "country_patent_count"
FROM   PATENTS.PATENTS.PUBLICATIONS                 p
CROSS JOIN LATERAL FLATTEN(input => p."cpc")        c
CROSS JOIN LATERAL FLATTEN(input => p."assignee_harmonized") a,
       pg_busiest b
WHERE  c.value:"code"::STRING LIKE 'A61%'
  AND  a.value:"name"::STRING ILIKE '%PROCTER%GAMBLE%'
  AND  FLOOR(p."publication_date" / 10000) = b.pub_year
GROUP  BY p."country_code"
ORDER  BY "country_patent_count" DESC
LIMIT 20
