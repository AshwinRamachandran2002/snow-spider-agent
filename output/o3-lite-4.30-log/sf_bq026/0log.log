```sql
--Description: 9) Top 5 jurisdiction codes for that assignee during their busiest year
SELECT
       p."country_code",
       COUNT(*)                          AS "country_patent_count"
FROM   PATENTS.PATENTS.PUBLICATIONS                     p
CROSS JOIN LATERAL FLATTEN(input => p."cpc")            c
CROSS JOIN LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE  c.value:"code"::STRING LIKE 'A61%'
  AND  a.value:"name"::STRING ILIKE '%TOP_ASSIGNEE%'
  AND  FLOOR(p."publication_date"/10000) = %BUSIEST_YEAR%
GROUP  BY p."country_code"
ORDER  BY "country_patent_count" DESC
LIMIT 5;
```

```sql
--Description: 10) Final query – comma‑separated list of the five most‑used jurisdiction codes
--               by the most‑active A61 assignee in their busiest year
WITH a61_data AS (
    SELECT
           a.value:"name"::STRING            AS assignee_name,
           FLOOR(p."publication_date"/10000) AS pub_year,
           p."country_code"
    FROM   PATENTS.PATENTS.PUBLICATIONS                     p
    CROSS JOIN LATERAL FLATTEN(input => p."cpc")            c
    CROSS JOIN LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE  c.value:"code"::STRING LIKE 'A61%'
),
most_active AS (
    SELECT assignee_name
    FROM   a61_data
    GROUP  BY assignee_name
    ORDER  BY COUNT(*) DESC
    LIMIT 1
),
busiest_year AS (
    SELECT  pub_year
    FROM    a61_data d
    JOIN    most_active m  ON d.assignee_name = m.assignee_name
    GROUP   BY pub_year
    ORDER   BY COUNT(*) DESC
    LIMIT   1
)
SELECT
       LISTAGG(country_code, ',') WITHIN GROUP (ORDER BY cnt DESC) AS top5_country_codes
FROM (
       SELECT
              d.country_code,
              COUNT(*) AS cnt
       FROM   a61_data d
       JOIN   most_active  m ON d.assignee_name = m.assignee_name
       JOIN   busiest_year y ON d.pub_year      = y.pub_year
       GROUP  BY d.country_code
       ORDER  BY cnt DESC
       LIMIT 5
) q;
```
