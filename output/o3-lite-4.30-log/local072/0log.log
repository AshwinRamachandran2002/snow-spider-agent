WITH jan AS (
    SELECT *
    FROM cities
    WHERE insert_date LIKE '2022-01-%'
),
nine_country AS (           -- country that has data on exactly 9 different January‑2022 days
    SELECT country_code_2
    FROM jan
    GROUP BY country_code_2
    HAVING COUNT(DISTINCT insert_date) = 9
    LIMIT 1
),
country_jan AS (            -- all January‑2022 rows for that country
    SELECT *
    FROM jan
    WHERE country_code_2 = (SELECT country_code_2 FROM nine_country)
),
rn AS (                      -- give each date a row number to detect consecutive spans
    SELECT insert_date,
           capital,
           julianday(insert_date)                 AS jd,
           ROW_NUMBER() OVER (ORDER BY insert_date) AS rn
    FROM country_jan
),
grp AS (                     -- constant grp_key inside each consecutive‑day block
    SELECT *,
           jd - rn AS grp_key
    FROM rn
),
spans AS (                   -- summarise every consecutive‑day block
    SELECT grp_key,
           MIN(insert_date) AS start_date,
           MAX(insert_date) AS end_date,
           COUNT(*)         AS span_len
    FROM grp
    GROUP BY grp_key
),
longest AS (                 -- pick the single longest block
    SELECT *
    FROM spans
    ORDER BY span_len DESC, start_date
    LIMIT 1
),
period_rows AS (             -- rows belonging to the longest block
    SELECT g.*
    FROM grp g
    JOIN longest l ON g.grp_key = l.grp_key
),
summary AS (                 -- final statistics
    SELECT
        cc.country_name                              AS country,
        (SELECT start_date FROM longest)             AS consecutive_period_start,
        (SELECT end_date   FROM longest)             AS consecutive_period_end,
        COUNT(*)                                     AS total_entries_in_period,
        SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END) AS capital_entries_in_period,
        CAST(SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END) AS REAL) /
        COUNT(*)                                     AS capital_entry_proportion
    FROM period_rows
    JOIN cities_countries cc
      ON cc.country_code_2 = (SELECT country_code_2 FROM nine_country)
)
SELECT *
FROM summary;
