```sql
--Description:  Compute, for Iran (‘ir’), the proportion of city‑rows that represent its capital
--              during the country’s longest consecutive stretch of January 2022 insert‑dates.
--  • jan_ir   : nine distinct 2022‑01 dates for Iran.  
--  • ordered  : add julianday() and row_number(); jd − rn is constant inside any run of
--               consecutive calendar days.  
--  • streaks  : group by that constant to get every consecutive block’s start, end, and length.  
--  • longest  : pick the block with the greatest length (Iran can have ties; earliest retained).  
--  • period_rows : all Iran rows whose insert_date falls inside that longest block.  
--  • final    : count total rows vs. capital = 1 rows and return their ratio.
WITH jan_ir AS (
    SELECT DISTINCT insert_date
    FROM cities
    WHERE country_code_2 = 'ir'
      AND insert_date LIKE '2022-01-%'
),
ordered AS (
    SELECT insert_date,
           julianday(insert_date) AS jd,
           ROW_NUMBER() OVER (ORDER BY insert_date) AS rn
    FROM jan_ir
),
streaks AS (
    SELECT jd - rn                    AS grp_key,
           MIN(insert_date)           AS start_date,
           MAX(insert_date)           AS end_date,
           COUNT(*)                   AS span_days
    FROM ordered
    GROUP BY grp_key
),
longest AS (
    SELECT start_date, end_date
    FROM streaks
    ORDER BY span_days DESC, start_date
    LIMIT 1
),
period_rows AS (
    SELECT *
    FROM cities
    WHERE country_code_2 = 'ir'
      AND insert_date BETWEEN (SELECT start_date FROM longest)
                          AND (SELECT end_date   FROM longest)
)
SELECT (SELECT start_date FROM longest)               AS longest_span_start,
       (SELECT end_date   FROM longest)               AS longest_span_end,
       COUNT(*)                                        AS total_entries,
       SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END)   AS capital_entries,
       1.0 * SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END) / COUNT(*) AS capital_ratio
FROM period_rows;
```
