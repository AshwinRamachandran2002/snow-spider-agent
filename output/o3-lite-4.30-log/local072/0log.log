Query:
--Description: Aggregate those grp_key blocks for Iran to find every consecutive‑day span
--             in January 2022, showing start, end, and length of each span.
WITH jan AS (
  SELECT insert_date,
         julianday(insert_date) AS jd,
         ROW_NUMBER() OVER (ORDER BY insert_date) AS rn
  FROM cities
  WHERE country_code_2 = 'ir'
    AND insert_date LIKE '2022-01-%'
),
grp AS (
  SELECT (jd - rn)             AS grp_key,
         MIN(insert_date)      AS start_date,
         MAX(insert_date)      AS end_date,
         COUNT(*)              AS span_days
  FROM jan
  GROUP BY grp_key
)
SELECT *
FROM grp
ORDER BY span_days DESC
LIMIT 20
