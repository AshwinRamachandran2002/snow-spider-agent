--Description: Add a row number to Iran’s January 2022 dates so we can derive a grp_key
--             (jd − rn) that is constant within any consecutive‑day block.
WITH jan AS (
  SELECT insert_date,
         julianday(insert_date) AS jd,
         ROW_NUMBER() OVER (ORDER BY insert_date) AS rn
  FROM cities
  WHERE country_code_2 = 'ir'
    AND insert_date LIKE '2022-01-%'
)
SELECT insert_date,
       jd,
       rn,
       jd - rn AS grp_key          -- constant for each consecutive block
FROM jan
ORDER BY insert_date
LIMIT 20
