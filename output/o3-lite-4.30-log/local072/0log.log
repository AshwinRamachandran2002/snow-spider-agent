WITH jan AS (
    SELECT *
    FROM cities
    WHERE insert_date LIKE '2022-01-%'
),
nine_country AS (                         -- country with data on exactly nine different January‑2022 days
    SELECT country_code_2
    FROM jan
    GROUP BY country_code_2
    HAVING COUNT(DISTINCT insert_date) = 9
    LIMIT 1
),
country_jan AS (                          -- all January‑2022 rows for that country
    SELECT *
    FROM jan
    WHERE country_code_2 = (SELECT country_code_2 FROM nine_country)
),
distinct_dates AS (                       -- unique insertion dates to build consecutive ranges
    SELECT DISTINCT insert_date
    FROM country_jan
),
numbered AS (                             -- row‑number each date to detect consecutive blocks
    SELECT insert_date,
           julianday(insert_date) AS jd,
           ROW_NUMBER() OVER (ORDER BY insert_date) AS rn
    FROM distinct_dates
),
date_groups AS (                          -- each consecutive‑day span
    SELECT jd - rn           AS grp_key,
           MIN(insert_date)  AS start_date,
           MAX(insert_date)  AS end_date,
           COUNT(*)          AS span_len
    FROM numbered
    GROUP BY grp_key
),
longest AS (                              -- the longest consecutive span
    SELECT *
    FROM date_groups
    ORDER BY span_len DESC, start_date
    LIMIT 1
),
period_rows AS (                          -- all rows that fall inside the longest span
    SELECT cj.*
    FROM country_jan cj
    JOIN longest l
      ON cj.insert_date BETWEEN l.start_date AND l.end_date
),
result AS (
