--Description: Final answer – proportion of rows that are the capital (Tehran)
--             within Iran’s longest consecutive January 2022 insertion period.
WITH jan AS (
  SELECT *
  FROM cities
  WHERE country_code_2 = 'ir'
    AND insert_date LIKE '2022-01-%'
),
rn AS (
  SELECT insert_date,
         julianday(insert_date) AS jd,
         ROW_NUMBER() OVER (ORDER BY insert_date) AS rn,
         capital
  FROM jan
),
grp AS (
  SELECT *,
         (jd - rn) AS grp_key
  FROM rn
),
longest AS (
  SELECT grp_key
  FROM grp
  GROUP BY grp_key
  ORDER BY COUNT(*) DESC
  LIMIT 1
)
SELECT cc.country_name,
       COUNT(*)                                      AS total_rows,
       SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END) AS capital_rows,
       1.0 * SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END) / COUNT(*) AS capital_ratio
FROM grp
JOIN longest USING (grp_key)
JOIN cities_countries AS cc
  ON cc.country_code_2 = 'ir'
GROUP BY cc.country_name
