Relevant columns and their potential usage
• cities."insert_date": extract the calendar day when each city record was inserted; filter for January 2022, build day‑level lists, detect consecutive‑day streaks  
• cities."country_code_2": identifies the country to which every city belongs; used for grouping and joins  
• cities."capital": flag (1 = capital city) used to measure how many January 2022 insertions for the target country came from its capital city  
• cities_countries."country_code_2": common key to join with cities  
• cities_countries."country_name": human‑readable name of the country we will ultimately report  

Typical conditions that will be used
• SUBSTR(cities."insert_date",1,7) = '2022-01' → restrict to January 2022  
• COUNT(DISTINCT date(insert_date)) = 9 → find the country inserted on nine different January days  
• julianday(date(insert_date))‑ROW_NUMBER() OVER(ORDER BY date(insert_date)) → create “islands” of consecutive days  
• BETWEEN 'start_day' AND 'end_day' → confine the capital‑city proportion calculation to the longest consecutive streak  

Ten exploratory‑to‑solution SQL queries
```sql
-- 1️⃣  Quick look at January 2022 rows in the cities table
SELECT *
FROM "cities"
WHERE SUBSTR("insert_date",1,7) = '2022-01'
LIMIT 20;

-- 2️⃣  List every distinct January 2022 insertion day (all countries)
SELECT DISTINCT DATE("insert_date") AS day_inserted
FROM "cities"
WHERE SUBSTR("insert_date",1,7) = '2022-01'
ORDER BY day_inserted
LIMIT 20;

-- 3️⃣  Count how many different January 2022 days each country appears
SELECT "country_code_2",
       COUNT(DISTINCT DATE("insert_date")) AS jan22_days
FROM "cities"
WHERE SUBSTR("insert_date",1,7) = '2022-01'
GROUP BY "country_code_2"
ORDER BY jan22_days DESC, "country_code_2"
LIMIT 20;

-- 4️⃣  Keep only the country (or countries) that posted on exactly 9 January 2022 days
SELECT "country_code_2"
FROM (
    SELECT "country_code_2",
           COUNT(DISTINCT DATE("insert_date")) AS jan22_days
    FROM "cities"
    WHERE SUBSTR("insert_date",1,7) = '2022-01'
    GROUP BY "country_code_2"
) AS t
WHERE jan22_days = 9;

-- 5️⃣  Show the human‑readable name of that 9‑day country
SELECT c."country_code_2", d."country_name"
FROM (
    SELECT "country_code_2"
    FROM (
        SELECT "country_code_2",
               COUNT(DISTINCT DATE("insert_date")) AS jan22_days
        FROM "cities"
        WHERE SUBSTR("insert_date",1,7) = '2022-01'
        GROUP BY "country_code_2"
    ) WHERE jan22_days = 9
) AS c
JOIN "cities_countries" AS d
  ON c."country_code_2" = d."country_code_2";

-- 6️⃣  List the nine January 2022 insertion days for that country
SELECT DISTINCT DATE("insert_date") AS day_inserted
FROM "cities"
WHERE "country_code_2" = (SELECT "country_code_2"
                          FROM (
                              SELECT "country_code_2",
                                     COUNT(DISTINCT DATE("insert_date")) AS jan22_days
                              FROM "cities"
                              WHERE SUBSTR("insert_date",1,7) = '2022-01'
                              GROUP BY "country_code_2"
                          ) WHERE jan22_days = 9)
  AND SUBSTR("insert_date",1,7) = '2022-01'
ORDER BY day_inserted;

-- 7️⃣  Tag every January 2022 day for that country with a “consecutive‑day group id”
SELECT DATE("insert_date") AS day_inserted,
       ROW_NUMBER() OVER(ORDER BY DATE("insert_date"))                       AS rn,
       julianday(DATE("insert_date"))
       - ROW_NUMBER() OVER(ORDER BY DATE("insert_date"))                     AS grp_id
FROM "cities"
WHERE "country_code_2" = (SELECT "country_code_2"
                          FROM (
                              SELECT "country_code_2",
                                     COUNT(DISTINCT DATE("insert_date")) AS jan22_days
                              FROM "cities"
                              WHERE SUBSTR("insert_date",1,7) = '2022-01'
                              GROUP BY "country_code_2"
                          ) WHERE jan22_days = 9)
  AND SUBSTR("insert_date",1,7) = '2022-01'
GROUP BY day_inserted
ORDER BY day_inserted;

-- 8️⃣  Compress those rows into consecutive‑day “islands” and compute their lengths
WITH day_grps AS (
    SELECT DATE("insert_date")                                   AS d,
           julianday(DATE("insert_date"))
           - ROW_NUMBER() OVER(ORDER BY DATE("insert_date"))     AS grp_id
    FROM "cities"
    WHERE "country_code_2" = (SELECT "country_code_2"
                              FROM (
                                  SELECT "country_code_2",
                                         COUNT(DISTINCT DATE("insert_date")) AS jan22_days
                                  FROM "cities"
                                  WHERE SUBSTR("insert_date",1,7) = '2022-01'
                                  GROUP BY "country_code_2"
                              ) WHERE jan22_days = 9)
      AND SUBSTR("insert_date",1,7) = '2022-01'
    GROUP BY d
)
SELECT MIN(d) AS streak_start,
       MAX(d) AS streak_end,
       COUNT(*) AS streak_len
FROM day_grps
GROUP BY grp_id
ORDER BY streak_len DESC
LIMIT 20;

-- 9️⃣  Pick the longest streak (start‑ and end‑date) for that country
WITH day_grps AS (
    SELECT DATE("insert_date")                                   AS d,
           julianday(DATE("insert_date"))
           - ROW_NUMBER() OVER(ORDER BY DATE("insert_date"))     AS grp_id
    FROM "cities"
    WHERE "country_code_2" = (SELECT "country_code_2"
                              FROM (
                                  SELECT "country_code_2",
                                         COUNT(DISTINCT DATE("insert_date")) AS jan22_days
                                  FROM "cities"
                                  WHERE SUBSTR("insert_date",1,7) = '2022-01'
                                  GROUP BY "country_code_2"
                              ) WHERE jan22_days = 9)
      AND SUBSTR("insert_date",1,7) = '2022-01'
    GROUP BY d
),
streaks AS (
    SELECT grp_id,
           MIN(d) AS s_start,
           MAX(d) AS s_end,
           COUNT(*) AS s_len
    FROM day_grps
    GROUP BY grp_id
)
SELECT s_start, s_end, s_len
FROM streaks
ORDER BY s_len DESC, s_start
LIMIT 1;

-- 🔟  Final: within that longest streak, calculate the share of insertions that are from the capital city
WITH params AS (  -- identify country & streak period
    SELECT (SELECT "country_code_2"
            FROM (
                SELECT "country_code_2",
                       COUNT(DISTINCT DATE("insert_date")) AS jan22_days
                FROM "cities"
                WHERE SUBSTR("insert_date",1,7) = '2022-01'
                GROUP BY "country_code_2"
            ) WHERE jan22_days = 9)                     AS ccode,
           s_start,
           s_end
    FROM (
        WITH day_grps AS (
            SELECT DATE("insert_date")                                   AS d,
                   julianday(DATE("insert_date"))
                   - ROW_NUMBER() OVER(ORDER BY DATE("insert_date"))     AS grp_id
            FROM "cities"
            WHERE "country_code_2" = (SELECT "country_code_2"
                                      FROM (
                                          SELECT "country_code_2",
                                                 COUNT(DISTINCT DATE("insert_date")) AS jan22_days
                                          FROM "cities"
                                          WHERE SUBSTR("insert_date",1,7) = '2022-01'
                                          GROUP BY "country_code_2"
                                      ) WHERE jan22_days = 9)
              AND SUBSTR("insert_date",1,7) = '2022-01'
            GROUP BY d
        ),
        streaks AS (
            SELECT grp_id,
                   MIN(d) AS s_start,
                   MAX(d) AS s_end,
                   COUNT(*) AS s_len
            FROM day_grps
            GROUP BY grp_id
        )
        ORDER BY s_len DESC, s_start
        LIMIT 1
    )
),
target_rows AS (
    SELECT *
    FROM "cities", params
    WHERE "country_code_2" = params.ccode
      AND DATE("insert_date") BETWEEN params.s_start AND params.s_end
)
SELECT params.ccode                AS country_code,
       params.s_start              AS streak_start,
       params.s_end                AS streak_end,
       COUNT(*)                    AS total_rows,
       SUM(CASE WHEN "capital" = 1 THEN 1 ELSE 0 END)      AS capital_rows,
       ROUND(1.0 * SUM(CASE WHEN "capital" = 1 THEN 1 ELSE 0 END)
                 / COUNT(*), 4)     AS capital_row_ratio
FROM target_rows, params;
```

