Query:
--Description: Add row numbers to Iran’s January 2022 dates so that consecutive‑day groups can be detected (JULIANDAY(d)‑rn trick).
WITH jan AS (
    SELECT DATE(insert_date) AS d,
           ROW_NUMBER() OVER (ORDER BY DATE(insert_date)) AS rn
    FROM   cities
    WHERE  insert_date LIKE '2022-01-%'
      AND  country_code_2 = 'ir'
    GROUP  BY DATE(insert_date)
)
SELECT d,
       rn,
       JULIANDAY(d) - rn AS grp_key
FROM   jan
ORDER  BY d
LIMIT 20
Answer:
