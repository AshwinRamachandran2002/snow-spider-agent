--Description: For Iran ('ir') in January 2022, find the longest run of consecutive
--insert‑dates in the “cities” table and, for that run, calculate how many of the
--rows are the capital (capital = 1) and what proportion they represent.
WITH ir AS (  -- all Iranian city rows in Jan‑2022
    SELECT city_id,
           city_name,
           capital,
           DATE(insert_date) AS d
    FROM   cities
    WHERE  country_code_2 = 'ir'
      AND  insert_date LIKE '2022-01-%'
),
distinct_dates AS (          -- distinct days (needed to detect gaps)
    SELECT d,
           ROW_NUMBER() OVER (ORDER BY d) AS rn
    FROM (SELECT DISTINCT d FROM ir)
),
blocks AS (                  -- consecutive‑day groups via julianDay(d)‑rn trick
    SELECT d,
           rn,
           JULIANDAY(d) - rn AS grp
    FROM   distinct_dates
),
block_len AS (               -- pick the longest consecutive block
    SELECT grp,
           MIN(d) AS start_date,
           MAX(d) AS end_date,
           COUNT(*) AS len
    FROM   blocks
    GROUP  BY grp
    ORDER  BY len DESC
    LIMIT  1
),
period_rows AS (             -- all rows that fall inside that longest block
    SELECT ir.*
    FROM   ir
    JOIN   block_len
      ON   ir.d BETWEEN block_len.start_date AND block_len.end_date
)
SELECT block_len.start_date,
       block_len.end_date,
