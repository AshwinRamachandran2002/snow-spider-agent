```sql
--Description: End‑to‑end solution.
-- 1) Locate every country whose cities were inserted on exactly nine different
--    days in January 2022. (Only Iran in our data, but the query stays generic.)
-- 2) For each such country, find all January 2022 dates, label consecutive‑day
--    groups (JULIANDAY(d)‑ROW_NUMBER trick), and pick that country’s longest
--    consecutive block.
-- 3) Inside that block, count total rows and how many are the capital
--    (capital = 1), then return the proportion of capital rows.
WITH jan_cities AS (                             -- all Jan‑2022 rows
    SELECT country_code_2,
           capital,
           DATE(insert_date) AS d
    FROM   cities
    WHERE  insert_date LIKE '2022-01-%'
),
nine_day_countries AS (                           -- step 1
    SELECT country_code_2
    FROM   jan_cities
    GROUP  BY country_code_2
    HAVING COUNT(DISTINCT d) = 9
),
dates AS (                                        -- distinct dates per country
    SELECT jc.country_code_2,
           jc.d
    FROM   jan_cities jc
    JOIN   nine_day_countries nc
           ON jc.country_code_2 = nc.country_code_2
    GROUP  BY jc.country_code_2, jc.d
),
grp_dates AS (                                    -- label consecutive groups
    SELECT country_code_2,
           d,
           JULIANDAY(d) - ROW_NUMBER() OVER (PARTITION BY country_code_2 ORDER BY d) AS grp
    FROM   dates
),
blocks AS (                                       -- group lengths
    SELECT country_code_2,
           MIN(d) AS start_date,
           MAX(d) AS end_date,
           COUNT(*) AS consecutive_days
    FROM   grp_dates
    GROUP  BY country_code_2, grp
),
longest AS (                                      -- longest block per country
    SELECT b.*
    FROM   blocks b
    JOIN  (SELECT country_code_2,
                  MAX(consecutive_days) AS max_len
           FROM   blocks
           GROUP  BY country_code_2) m
      ON  b.country_code_2 = m.country_code_2
     AND  b.consecutive_days = m.max_len
),
period_rows AS (                                  -- all rows inside the block
    SELECT c.country_code_2,
           c.capital
    FROM   cities c
    JOIN   longest l
      ON   c.country_code_2 = l.country_code_2
     AND   DATE(c.insert_date) BETWEEN l.start_date AND l.end_date
)
SELECT l.country_code_2,
       l.start_date,
       l.end_date,
       l.consecutive_days,
       COUNT(*)                                   AS total_entries,
       SUM(CASE WHEN pr.capital = 1 THEN 1 END)   AS capital_entries,
       1.0 * SUM(CASE WHEN pr.capital = 1 THEN 1 END) / COUNT(*) AS capital_proportion
FROM   longest l
JOIN   period_rows pr
  ON   pr.country_code_2 = l.country_code_2
GROUP  BY l.country_code_2,
          l.start_date,
          l.end_date,
          l.consecutive_days;
