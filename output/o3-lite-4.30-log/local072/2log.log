```sql
WITH january_ir AS (
    -- all Iranian city rows inserted in January 2022
    SELECT 
        DATE(insert_date)            AS d,
        capital
    FROM cities
    WHERE insert_date LIKE '2022-01-%'
      AND country_code_2 = 'ir'
), distinct_days AS (
    -- distinct January‑2022 days
    SELECT DISTINCT d
    FROM january_ir
), numbered AS (
    -- give each day a row number to build consecutive‑day groups
    SELECT
        d,
        ROW_NUMBER() OVER (ORDER BY d)                    AS rn
    FROM distinct_days
), day_blocks AS (
    -- group consecutive days (julianday trick) and measure block length
    SELECT
        MIN(d)                                            AS block_start,
        MAX(d)                                            AS block_end,
        COUNT(*)                                          AS block_len
    FROM (
        SELECT d,
               julianday(d) - rn                          AS grp_key
        FROM numbered
    )
    GROUP BY grp_key
), longest_block AS (
    -- pick the longest consecutive block
    SELECT *
    FROM day_blocks
    ORDER BY block_len DESC, block_start
    LIMIT 1
), period_rows AS (
    -- all rows that fall inside that longest block
    SELECT ji.*
    FROM january_ir ji
    JOIN longest_block lb
      ON ji.d BETWEEN lb.block_start AND lb.block_end
)
SELECT
    'iran'                                               AS country,
    lb.block_start                                       AS consecutive_period_start,
    lb.block_end                                         AS consecutive_period_end,
    COUNT(*)                                             AS total_entries_in_period,
    SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END)         AS capital_entries_in_period,
    ROUND(
        1.0 * SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END) 
        / COUNT(*), 4
    )                                                    AS capital_entry_proportion
FROM period_rows
CROSS JOIN longest_block lb;
```
