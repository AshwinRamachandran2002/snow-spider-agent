       SUM(CASE WHEN period_rows.capital = 1 THEN 1 END) AS capital_entries,
       COUNT(*)                                   AS total_entries,
       1.0 * SUM(CASE WHEN period_rows.capital = 1 THEN 1 END) / COUNT(*) 
                                                   AS capital_proportion
FROM   period_rows, block_len;
