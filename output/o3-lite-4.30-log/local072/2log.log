Query:
--Description: Collapse the previous result to find every consecutive‑day block for Iran in January 2022 and show their lengths.
WITH jan AS (
    SELECT DATE(insert_date) AS d,
           ROW_NUMBER() OVER (ORDER BY DATE(insert_date)) AS rn
    FROM   cities
    WHERE  insert_date LIKE '2022-01-%'
      AND  country_code_2 = 'ir'
    GROUP  BY DATE(insert_date)
),
blocks AS (
    SELECT MIN(d)  AS block_start,
           MAX(d)  AS block_end,
           COUNT(*) AS block_len
    FROM  (
        SELECT d,
               JULIANDAY(d) - rn AS grp_key
        FROM   jan
    )
    GROUP BY grp_key
)
SELECT *
FROM   blocks
ORDER  BY block_len DESC
LIMIT 20
