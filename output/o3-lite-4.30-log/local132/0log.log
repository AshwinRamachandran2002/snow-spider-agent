--      1st‑ and 2nd‑ranked preference (captured as cust_pref1 / cust_pref2).
--   3) The customer’s two top preferences equal the entertainer’s two top strengths
--      in either the same order or reversed.
-- Returned columns: entertainer stage name, customer last name.
WITH ent AS (                               --‑ Gather eligible entertainers
    SELECT es."EntertainerID",
           MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS ent_style1,
           MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS ent_style2
    FROM   "Entertainer_Styles" AS es
    GROUP  BY es."EntertainerID"
    HAVING COUNT(*) <= 3
       AND ent_style1 IS NOT NULL
       AND ent_style2 IS NOT NULL
),
cust AS (                                   --‑ Gather eligible customers
    SELECT mp."CustomerID",
           MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS cust_pref1,
           MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS cust_pref2
    FROM   "Musical_Preferences" AS mp
    GROUP  BY mp."CustomerID"
    HAVING COUNT(*) <= 3
       AND cust_pref1 IS NOT NULL
       AND cust_pref2 IS NOT NULL
)
SELECT DISTINCT e."EntStageName",
                c."CustLastName"
FROM   ent
JOIN   "Entertainers" AS e ON e."EntertainerID" = ent."EntertainerID"
JOIN   cust
JOIN   "Customers"    AS c ON c."CustomerID"    = cust."CustomerID"
WHERE  ( ent.ent_style1 = cust.cust_pref1  AND ent.ent_style2 = cust.cust_pref2 )  -- same order
    OR ( ent.ent_style1 = cust.cust_pref2  AND ent.ent_style2 = cust.cust_pref1 )  -- reverse order
ORDER  BY e."EntStageName", c."CustLastName"
LIMIT 20
