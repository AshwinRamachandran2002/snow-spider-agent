Relevant columns & their usage for this task
------------------------------------------------
Entertainer_Styles.EntertainerID :  join key back to Entertainers  
Entertainer_Styles.StyleID       :  entertainer’s musical style  
Entertainer_Styles.StyleStrength :  preference order (1 = 1st, 2 = 2nd …)  

Entertainers.EntertainerID       :  join key  
Entertainers.EntStageName        :  value we finally need to display  

Musical_Preferences.CustomerID   :  join key back to Customers  
Musical_Preferences.StyleID      :  customer’s preferred style  
Musical_Preferences.PreferenceSeq:  preference order (1 = 1st, 2 = 2nd …)  

Customers.CustomerID             :  join key  
Customers.CustLastName           :  value we finally need to display  

Typical conditions that will be needed
--------------------------------------
• StyleStrength  IN (1,2)  – keep only the first‑ and second‑ranked styles  
• PreferenceSeq  IN (1,2)  – keep only the first‑ and second‑ranked preferences  
• HAVING COUNT(*) ≤ 3       – restrict each entertainer / customer to at most three styles / preferences  
• Matching logic            – (Style1 = Pref1 AND Style2 = Pref2) OR the reverse  

Ten exploratory → progressive SQL queries
-----------------------------------------

```sql
-- 1. Inspect the first two ranked styles for each entertainer
SELECT es."EntertainerID",
       e."EntStageName",
       es."StyleID",
       es."StyleStrength"
FROM "Entertainer_Styles" AS es
JOIN "Entertainers"       AS e ON e."EntertainerID" = es."EntertainerID"
WHERE es."StyleStrength" <= 2
ORDER BY es."EntertainerID", es."StyleStrength"
LIMIT 20;
```

```sql
-- 2. Inspect the first two ranked musical preferences for each customer
SELECT mp."CustomerID",
       c."CustLastName",
       mp."StyleID",
       mp."PreferenceSeq"
FROM "Musical_Preferences" AS mp
JOIN "Customers"           AS c ON c."CustomerID" = mp."CustomerID"
WHERE mp."PreferenceSeq" <= 2
ORDER BY mp."CustomerID", mp."PreferenceSeq"
LIMIT 20;
```

```sql
-- 3. Count how many style rows each entertainer has
SELECT "EntertainerID",
       COUNT(*) AS style_cnt
FROM   "Entertainer_Styles"
GROUP  BY "EntertainerID"
LIMIT 20;
```

```sql
-- 4. List entertainers that have three or fewer style rows
SELECT "EntertainerID"
FROM   "Entertainer_Styles"
GROUP  BY "EntertainerID"
HAVING COUNT(*) <= 3
LIMIT 20;
```

```sql
-- 5. Count how many musical preferences each customer has
SELECT "CustomerID",
       COUNT(*) AS pref_cnt
FROM   "Musical_Preferences"
GROUP  BY "CustomerID"
LIMIT 20;
```

```sql
-- 6. List customers that have three or fewer musical preferences
SELECT "CustomerID"
FROM   "Musical_Preferences"
GROUP  BY "CustomerID"
HAVING COUNT(*) <= 3
LIMIT 20;
```

```sql
-- 7. Pair entertainers & customers where the FIRST style matches the FIRST preference
SELECT DISTINCT e."EntStageName",
                c."CustLastName"
FROM   "Entertainers"         AS e
JOIN   "Entertainer_Styles"    AS es1 ON es1."EntertainerID" = e."EntertainerID" 
                                     AND es1."StyleStrength" = 1
JOIN   "Musical_Preferences"   AS mp1 ON mp1."StyleID"      = es1."StyleID"
                                     AND mp1."PreferenceSeq" = 1
JOIN   "Customers"             AS c   ON c."CustomerID"     = mp1."CustomerID"
LIMIT 20;
```

```sql
-- 8. Same as (7) but FIRST style with SECOND preference (for later reverse‑order match)
SELECT DISTINCT e."EntStageName",
                c."CustLastName"
FROM   "Entertainers"         AS e
JOIN   "Entertainer_Styles"    AS es1 ON es1."EntertainerID" = e."EntertainerID"
                                     AND es1."StyleStrength" = 1
JOIN   "Musical_Preferences"   AS mp2 ON mp2."StyleID"      = es1."StyleID"
                                     AND mp2."PreferenceSeq" = 2
JOIN   "Customers"             AS c   ON c."CustomerID"     = mp2."CustomerID"
LIMIT 20;
```

```sql
-- 9. Customers and entertainers that EACH have ≤3 rows plus their first two styles / preferences
WITH ent AS (
    SELECT "EntertainerID"
    FROM   "Entertainer_Styles"
    GROUP  BY "EntertainerID"
    HAVING COUNT(*) <= 3
),
cust AS (
    SELECT "CustomerID"
    FROM   "Musical_Preferences"
    GROUP  BY "CustomerID"
    HAVING COUNT(*) <= 3
)
SELECT e."EntStageName",
       c."CustLastName",
       es."StyleStrength",
       mp."PreferenceSeq"
FROM   ent
JOIN   "Entertainers"       AS e  ON e."EntertainerID" = ent."EntertainerID"
JOIN   "Entertainer_Styles" AS es ON es."EntertainerID" = e."EntertainerID"
JOIN   cust
JOIN   "Musical_Preferences" AS mp ON mp."CustomerID"   = cust."CustomerID"
WHERE  es."StyleStrength"   <= 2
  AND  mp."PreferenceSeq"   <= 2
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: pairs that satisfy every requirement
WITH ent AS (                       -- entertainers having ≤3 style rows
    SELECT es."EntertainerID",
           MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS ent_style1,
           MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS ent_style2
    FROM   "Entertainer_Styles" AS es
    GROUP  BY es."EntertainerID"
    HAVING COUNT(*) <= 3
       AND ent_style1 IS NOT NULL
       AND ent_style2 IS NOT NULL
),
cust AS (                           -- customers having ≤3 preference rows
    SELECT mp."CustomerID",
           MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS cust_pref1,
           MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS cust_pref2
    FROM   "Musical_Preferences" AS mp
    GROUP  BY mp."CustomerID"
    HAVING COUNT(*) <= 3
       AND cust_pref1 IS NOT NULL
       AND cust_pref2 IS NOT NULL
)
SELECT DISTINCT e."EntStageName",
                c."CustLastName"
FROM   ent
JOIN   "Entertainers" AS e ON e."EntertainerID" = ent."EntertainerID"
JOIN   cust
JOIN   "Customers"    AS c ON c."CustomerID"    = cust."CustomerID"
WHERE  ( ent.ent_style1 = cust.cust_pref1  AND ent.ent_style2 = cust.cust_pref2 )
    OR ( ent.ent_style1 = cust.cust_pref2  AND ent.ent_style2 = cust.cust_pref1 )
LIMIT 20;
```

