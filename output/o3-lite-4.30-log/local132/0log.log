```sql
-- Thinking process inside comments:
-- Goal: list entertainer–customer pairs where both have at most three style/preference rows
--       and the customer’s first two preferences match the entertainer’s first two strengths
--       in the same or reverse order.  Return only stage name + customer last name.
-- 1. ent CTE  -> per entertainer grab style1 (rank‑1) & style2 (rank‑2); keep if total ≤3.
-- 2. cust CTE -> per customer   grab pref1  (rank‑1) & pref2  (rank‑2); keep if total ≤3.
-- 3. Join those sets through Entertainers and Customers, apply matching logic.
-- 4. Distinct rows, tidy ordering, limit to 20 sample lines.
WITH ent AS (
    SELECT es."EntertainerID",
           MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS style1,
           MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS style2
    FROM "Entertainer_Styles" AS es
    GROUP BY es."EntertainerID"
    HAVING COUNT(*) <= 3
       AND style1 IS NOT NULL
       AND style2 IS NOT NULL
),
cust AS (
    SELECT mp."CustomerID",
           MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS pref1,
           MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS pref2
    FROM "Musical_Preferences" AS mp
    GROUP BY mp."CustomerID"
    HAVING COUNT(*) <= 3
       AND pref1 IS NOT NULL
       AND pref2 IS NOT NULL
)
SELECT DISTINCT e."EntStageName",
                c."CustLastName"
FROM   ent
JOIN   "Entertainers" AS e ON e."EntertainerID" = ent."EntertainerID"
JOIN   cust
JOIN   "Customers"    AS c ON c."CustomerID"    = cust."CustomerID"
WHERE  (ent.style1 = cust.pref1 AND ent.style2 = cust.pref2)   -- same order
    OR (ent.style1 = cust.pref2 AND ent.style2 = cust.pref1)   -- reverse order
ORDER  BY e."EntStageName", c."CustLastName"
LIMIT 20;
```
