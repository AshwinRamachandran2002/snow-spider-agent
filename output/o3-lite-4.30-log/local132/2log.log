Relevant columns and their potential usage
• Entertainer_Styles.EntertainerID : foreign–key that ties each style row to one entertainer  
• Entertainer_Styles.StyleID      : the musical style played by the entertainer  
• Entertainer_Styles.StyleStrength: lets us order a performer’s styles (strongest = 1st, etc.)  
• Entertainers.EntStageName       : stage name we must finally display  
• Musical_Preferences.CustomerID  : foreign–key that ties each preference row to one customer  
• Musical_Preferences.StyleID     : the musical style the customer likes  
• Musical_Preferences.PreferenceSeq: numeric order of those likes (1 = 1st choice, 2 = 2nd …)  
• Customers.CustLastName          : customer’s last name we must finally display  

Typical conditions that will be needed  
• Count of styles / preferences ≤ 3 ( “…who each have up to three …” )  
• Rank/choose only seq 1 and 2 for both sides  
• Match (Style1 = Pref1 AND Style2 = Pref2) OR (Style1 = Pref2 AND Style2 = Pref1)  

Below are ten exploratory SQL queries (SQLite syntax, each returns ≤ 20 rows) that progress from simple inspection to the complete answer.

```sql
-- 1. All style rows for entertainers
SELECT DISTINCT "EntertainerID", "StyleID", "StyleStrength"
FROM "Entertainer_Styles"
LIMIT 20;
```

```sql
-- 2. How many style rows does each entertainer have?
SELECT "EntertainerID", COUNT(*) AS "StyleCount"
FROM "Entertainer_Styles"
GROUP BY "EntertainerID"
HAVING COUNT(*) <= 3      -- keep only those with ≤3 styles
LIMIT 20;
```

```sql
-- 3. The strongest two styles for every entertainer (ranked by StyleStrength)
SELECT "EntertainerID", "StyleID", "StyleStrength"
FROM (
    SELECT "EntertainerID", "StyleID", "StyleStrength",
           ROW_NUMBER() OVER (PARTITION BY "EntertainerID"
                              ORDER BY "StyleStrength" DESC) AS rn
    FROM "Entertainer_Styles"
)
WHERE rn <= 2
LIMIT 20;
```

```sql
-- 4. All musical‑preference rows for customers
SELECT DISTINCT "CustomerID", "StyleID", "PreferenceSeq"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
-- 5. Customers that have at most three preferences
SELECT "CustomerID", COUNT(*) AS "PrefCount"
FROM "Musical_Preferences"
GROUP BY "CustomerID"
HAVING COUNT(*) <= 3
LIMIT 20;
```

```sql
-- 6. First and second musical preferences for every customer
SELECT "CustomerID", "StyleID", "PreferenceSeq"
FROM "Musical_Preferences"
WHERE "PreferenceSeq" IN (1, 2)
LIMIT 20;
```

```sql
-- 7. Pair entertainers & customers whose 1st and 2nd styles match in THE SAME order
SELECT e."EntertainerID", c."CustomerID"
FROM
    (SELECT "EntertainerID",
            MAX(CASE WHEN rn = 1 THEN "StyleID" END) AS Style1,
            MAX(CASE WHEN rn = 2 THEN "StyleID" END) AS Style2
     FROM (
         SELECT "EntertainerID", "StyleID",
                ROW_NUMBER() OVER (PARTITION BY "EntertainerID"
                                   ORDER BY "StyleStrength" DESC) AS rn
         FROM "Entertainer_Styles"
     )
     WHERE rn <= 2
     GROUP BY "EntertainerID")  AS e
JOIN
    (SELECT "CustomerID",
            MAX(CASE WHEN "PreferenceSeq" = 1 THEN "StyleID" END) AS Pref1,
            MAX(CASE WHEN "PreferenceSeq" = 2 THEN "StyleID" END) AS Pref2
     FROM "Musical_Preferences"
     GROUP BY "CustomerID")     AS c
ON  e.Style1 = c.Pref1 AND e.Style2 = c.Pref2
LIMIT 20;
```

```sql
-- 8. Same idea as #7 but styles can be in REVERSE order
SELECT e."EntertainerID", c."CustomerID"
FROM
    (SELECT "EntertainerID",
            MAX(CASE WHEN rn = 1 THEN "StyleID" END) AS Style1,
            MAX(CASE WHEN rn = 2 THEN "StyleID" END) AS Style2
     FROM (
         SELECT "EntertainerID", "StyleID",
                ROW_NUMBER() OVER (PARTITION BY "EntertainerID"
                                   ORDER BY "StyleStrength" DESC) AS rn
         FROM "Entertainer_Styles"
     )
     WHERE rn <= 2
     GROUP BY "EntertainerID")  AS e
JOIN
    (SELECT "CustomerID",
            MAX(CASE WHEN "PreferenceSeq" = 1 THEN "StyleID" END) AS Pref1,
            MAX(CASE WHEN "PreferenceSeq" = 2 THEN "StyleID" END) AS Pref2
     FROM "Musical_Preferences"
     GROUP BY "CustomerID")     AS c
ON  e.Style1 = c.Pref2 AND e.Style2 = c.Pref1
LIMIT 20;
```

```sql
-- 9. Combine both orderings (#7 UNION #8) and keep only entertainers/customers with ≤3 rows each
SELECT *
FROM (
    -- same‑order match
    SELECT e."EntertainerID", c."CustomerID"
    FROM
        (SELECT "EntertainerID",
                MAX(CASE WHEN rn = 1 THEN "StyleID" END) AS Style1,
                MAX(CASE WHEN rn = 2 THEN "StyleID" END) AS Style2
         FROM (
             SELECT "EntertainerID", "StyleID",
                    ROW_NUMBER() OVER (PARTITION BY "EntertainerID"
                                       ORDER BY "StyleStrength" DESC) AS rn
             FROM "Entertainer_Styles"
         )
         WHERE rn <= 2
         GROUP BY "EntertainerID"
         HAVING COUNT(*) <= 3)  AS e
    JOIN
        (SELECT "CustomerID",
                MAX(CASE WHEN "PreferenceSeq" = 1 THEN "StyleID" END) AS Pref1,
                MAX(CASE WHEN "PreferenceSeq" = 2 THEN "StyleID" END) AS Pref2
         FROM "Musical_Preferences"
         GROUP BY "CustomerID"
         HAVING COUNT(*) <= 3)  AS c
    ON e.Style1 = c.Pref1 AND e.Style2 = c.Pref2

    UNION

    -- reverse‑order match
    SELECT e."EntertainerID", c."CustomerID"
    FROM
        (SELECT "EntertainerID",
                MAX(CASE WHEN rn = 1 THEN "StyleID" END) AS Style1,
                MAX(CASE WHEN rn = 2 THEN "StyleID" END) AS Style2
         FROM (
             SELECT "EntertainerID", "StyleID",
                    ROW_NUMBER() OVER (PARTITION BY "EntertainerID"
                                       ORDER BY "StyleStrength" DESC) AS rn
             FROM "Entertainer_Styles"
         )
         WHERE rn <= 2
         GROUP BY "EntertainerID"
         HAVING COUNT(*) <= 3)  AS e
    JOIN
        (SELECT "CustomerID",
                MAX(CASE WHEN "PreferenceSeq" = 1 THEN "StyleID" END) AS Pref1,
                MAX(CASE WHEN "PreferenceSeq" = 2 THEN "StyleID" END) AS Pref2
         FROM "Musical_Preferences"
         GROUP BY "CustomerID"
         HAVING COUNT(*) <= 3)  AS c
    ON e.Style1 = c.Pref2 AND e.Style2 = c.Pref1
) LIMIT 20;
```

```sql
-- 10. FINAL answer: entertainer stage‑name & customer last‑name for the required pairs
SELECT DISTINCT ent."EntStageName", cust."CustLastName"
FROM
    ( -- entertainer top two styles
      SELECT "EntertainerID",
             MAX(CASE WHEN rn = 1 THEN "StyleID" END) AS Style1,
             MAX(CASE WHEN rn = 2 THEN "StyleID" END) AS Style2
      FROM (
          SELECT "EntertainerID", "StyleID",
                 ROW_NUMBER() OVER (PARTITION BY "EntertainerID"
                                    ORDER BY "StyleStrength" DESC) AS rn
          FROM "Entertainer_Styles"
      )
      WHERE rn <= 2
      GROUP BY "EntertainerID"
      HAVING COUNT(*) <= 3
    ) AS es
JOIN "Entertainers"  AS ent  ON ent."EntertainerID" = es."EntertainerID"
JOIN (
      -- customer first two preferences
      SELECT "CustomerID",
             MAX(CASE WHEN "PreferenceSeq" = 1 THEN "StyleID" END) AS Pref1,
             MAX(CASE WHEN "PreferenceSeq" = 2 THEN "StyleID" END) AS Pref2
      FROM "Musical_Preferences"
      GROUP BY "CustomerID"
      HAVING COUNT(*) <= 3
) AS mp ON (es.Style1 = mp.Pref1 AND es.Style2 = mp.Pref2)
       OR (es.Style1 = mp.Pref2 AND es.Style2 = mp.Pref1)
JOIN "Customers"    AS cust ON cust."CustomerID" = mp."CustomerID"
LIMIT 20;
```

