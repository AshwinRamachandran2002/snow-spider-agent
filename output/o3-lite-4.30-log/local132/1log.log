```sql
--Description:
-- 1. Build two CTEs that keep only entertainers / customers who have at most three
--    style rows.  For each, extract their 1st‑ and 2nd‑ranked styles.
-- 2. Pair an entertainer with a customer when the customer’s top‑two preferences
--    match the entertainer’s top‑two strengths in either the same order
--    (1↔1 and 2↔2) or reversed order (1↔2 and 2↔1).
-- 3. Return just the entertainer’s stage name and the customer’s last name.
WITH ent_two AS (
    SELECT EntertainerID,
           MAX(CASE WHEN StyleStrength = 1 THEN StyleID END) AS style1,
           MAX(CASE WHEN StyleStrength = 2 THEN StyleID END) AS style2
    FROM   Entertainer_Styles
    GROUP  BY EntertainerID
    HAVING COUNT(*) <= 3          -- up to three style strengths
),
cust_two AS (
    SELECT CustomerID,
           MAX(CASE WHEN PreferenceSeq = 1 THEN StyleID END) AS pref1,
           MAX(CASE WHEN PreferenceSeq = 2 THEN StyleID END) AS pref2
    FROM   Musical_Preferences
    GROUP  BY CustomerID
    HAVING COUNT(*) <= 3          -- up to three preferences
)
SELECT DISTINCT
       e.EntStageName,
       c.CustLastName
FROM   ent_two      et
JOIN   Entertainers  e  ON e.EntertainerID = et.EntertainerID
JOIN   cust_two     ct  ON
     ( et.style1 = ct.pref1 AND et.style2 = ct.pref2   -- same order
       OR
       et.style1 = ct.pref2 AND et.style2 = ct.pref1 ) -- reversed order
JOIN   Customers    c  ON c.CustomerID = ct.CustomerID
LIMIT 20;
```
