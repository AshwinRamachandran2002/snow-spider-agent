Relevant columns, their purposes and typical conditions  

Entertainer_Styles  
• EntertainerID : join to Entertainers, grouping/ COUNT(*) ≤ 3  
• StyleID : to compare with customer preferences  
• StyleStrength : 1 = strongest, 2 = second, 3 = third (use StyleStrength IN (1,2))  

Entertainers  
• EntertainerID : PK, join to Entertainer_Styles  
• EntStageName : what we finally want to show (SELECT list)  

Musical_Preferences  
• CustomerID : join to Customers, grouping/ COUNT(*) ≤ 3  
• StyleID : to compare with entertainer styles  
• PreferenceSeq : 1 = favourite, 2 = second‑favourite (use PreferenceSeq IN (1,2))  

Customers  
• CustomerID : PK, join to Musical_Preferences  
• CustLastName : what we finally want to show (SELECT list)  

Typical filter / join conditions  
• COUNT(*) OVER (PARTITION BY …) ≤ 3   – “up‑to‑three” rule  
• StyleStrength = 1 AND PreferenceSeq = 1 (1st vs 1st)  
• StyleStrength = 2 AND PreferenceSeq = 2 (2nd vs 2nd)  
• Or reversed: StyleStrength = 1 vs PreferenceSeq = 2 AND StyleStrength = 2 vs PreferenceSeq = 1  

Below are ten exploratory SQLite queries (DISTINCT, each limited to 20 rows).  
```sql
-- 1) How many style rows does each entertainer have?
SELECT "EntertainerID",
       COUNT(*) AS "style_cnt"
FROM "Entertainer_Styles"
GROUP BY "EntertainerID"
LIMIT 20;

-- 2) List entertainers that have three or fewer styles
SELECT DISTINCT e."EntertainerID", e."EntStageName"
FROM "Entertainers"  AS e
JOIN "Entertainer_Styles" s ON s."EntertainerID" = e."EntertainerID"
GROUP BY e."EntertainerID"
HAVING COUNT(*) <= 3
LIMIT 20;

-- 3) How many musical preference rows does each customer have?
SELECT "CustomerID",
       COUNT(*) AS "pref_cnt"
FROM "Musical_Preferences"
GROUP BY "CustomerID"
LIMIT 20;

-- 4) Customers with three or fewer musical preferences
SELECT DISTINCT c."CustomerID", c."CustLastName"
FROM "Customers"            c
JOIN "Musical_Preferences" p ON p."CustomerID" = c."CustomerID"
GROUP BY c."CustomerID"
HAVING COUNT(*) <= 3
LIMIT 20;

-- 5) First‑ and second‑strongest styles for each entertainer
SELECT DISTINCT s."EntertainerID",
       MAX(CASE WHEN s."StyleStrength" = 1 THEN s."StyleID" END) AS "style_one",
       MAX(CASE WHEN s."StyleStrength" = 2 THEN s."StyleID" END) AS "style_two"
FROM "Entertainer_Styles" s
GROUP BY s."EntertainerID"
LIMIT 20;

-- 6) First‑ and second‑preference styles for each customer
SELECT DISTINCT p."CustomerID",
       MAX(CASE WHEN p."PreferenceSeq" = 1 THEN p."StyleID" END) AS "pref_one",
       MAX(CASE WHEN p."PreferenceSeq" = 2 THEN p."StyleID" END) AS "pref_two"
FROM "Musical_Preferences" p
GROUP BY p."CustomerID"
LIMIT 20;

-- 7) Match rows where 1st & 2nd preferences match 1st & 2nd strengths (same order)
SELECT DISTINCT e."EntStageName",
                c."CustLastName"
FROM "Entertainers"            e
JOIN "Entertainer_Styles"   es1 ON es1."EntertainerID" = e."EntertainerID" AND es1."StyleStrength" = 1
JOIN "Entertainer_Styles"   es2 ON es2."EntertainerID" = e."EntertainerID" AND es2."StyleStrength" = 2
JOIN "Musical_Preferences"  cp1 ON cp1."StyleID"      = es1."StyleID"      AND cp1."PreferenceSeq" = 1
JOIN "Musical_Preferences"  cp2 ON cp2."StyleID"      = es2."StyleID"      AND cp2."PreferenceSeq" = 2
JOIN "Customers"            c   ON c."CustomerID"     = cp1."CustomerID"
                               AND c."CustomerID"     = cp2."CustomerID"
GROUP BY e."EntStageName", c."CustLastName"
LIMIT 20;

-- 8) Match rows where 1st & 2nd preferences match 1st & 2nd strengths (reversed order)
SELECT DISTINCT e."EntStageName",
                c."CustLastName"
FROM "Entertainers"            e
JOIN "Entertainer_Styles"   es1 ON es1."EntertainerID" = e."EntertainerID" AND es1."StyleStrength" = 1
JOIN "Entertainer_Styles"   es2 ON es2."EntertainerID" = e."EntertainerID" AND es2."StyleStrength" = 2
JOIN "Musical_Preferences"  cp1 ON cp1."StyleID"      = es1."StyleID"      AND cp1."PreferenceSeq" = 2
JOIN "Musical_Preferences"  cp2 ON cp2."StyleID"      = es2."StyleID"      AND cp2."PreferenceSeq" = 1
JOIN "Customers"            c   ON c."CustomerID"     = cp1."CustomerID"
                               AND c."CustomerID"     = cp2."CustomerID"
GROUP BY e."EntStageName", c."CustLastName"
LIMIT 20;

-- 9) Union of same‑order and reversed‑order matches, with “≤3 styles/preferences” rule
SELECT DISTINCT e."EntStageName",
                c."CustLastName"
FROM "Entertainers"            e
JOIN "Entertainer_Styles"   es1 ON es1."EntertainerID" = e."EntertainerID" AND es1."StyleStrength" = 1
JOIN "Entertainer_Styles"   es2 ON es2."EntertainerID" = e."EntertainerID" AND es2."StyleStrength" = 2
JOIN ( SELECT "EntertainerID"
       FROM "Entertainer_Styles"
       GROUP BY "EntertainerID"
       HAVING COUNT(*) <= 3) ok_ent ON ok_ent."EntertainerID" = e."EntertainerID"
JOIN "Musical_Preferences"  cp1 ON cp1."StyleID" = es1."StyleID"
JOIN "Musical_Preferences"  cp2 ON cp2."StyleID" = es2."StyleID"
JOIN ( SELECT "CustomerID"
       FROM "Musical_Preferences"
       GROUP BY "CustomerID"
       HAVING COUNT(*) <= 3) ok_cust ON ok_cust."CustomerID" IN (cp1."CustomerID", cp2."CustomerID")
JOIN "Customers"            c  ON c."CustomerID" = cp1."CustomerID"
WHERE (cp1."CustomerID" = cp2."CustomerID"                -- same customer
       AND ((cp1."PreferenceSeq" = 1 AND cp2."PreferenceSeq" = 2)   -- same order
         OR (cp1."PreferenceSeq" = 2 AND cp2."PreferenceSeq" = 1))) -- reversed
LIMIT 20;

-- 10) Final concise answer: pairs obeying every rule (show only the two names)
SELECT DISTINCT e."EntStageName"  AS "EntStageName",
                c."CustLastName"  AS "CustLastName"
FROM (
     SELECT "EntertainerID"
     FROM "Entertainer_Styles"
     GROUP BY "EntertainerID"
     HAVING COUNT(*) <= 3
) AS ok_ent
JOIN "Entertainer_Styles" es1 ON es1."EntertainerID" = ok_ent."EntertainerID" AND es1."StyleStrength" = 1
JOIN "Entertainer_Styles" es2 ON es2."EntertainerID" = ok_ent."EntertainerID" AND es2."StyleStrength" = 2
JOIN (
     SELECT "CustomerID"
     FROM "Musical_Preferences"
     GROUP BY "CustomerID"
     HAVING COUNT(*) <= 3
) AS ok_cust
JOIN "Musical_Preferences" cp1 ON cp1."CustomerID" = ok_cust."CustomerID"
JOIN "Musical_Preferences" cp2 ON cp2."CustomerID" = ok_cust."CustomerID"
JOIN "Entertainers"        e   ON e."EntertainerID" = ok_ent."EntertainerID"
JOIN "Customers"           c   ON c."CustomerID"    = ok_cust."CustomerID"
WHERE (
        (cp1."PreferenceSeq" = 1 AND cp2."PreferenceSeq" = 2
         AND cp1."StyleID"   = es1."StyleID"
         AND cp2."StyleID"   = es2."StyleID")
     OR (cp1."PreferenceSeq" = 1 AND cp2."PreferenceSeq" = 2
         AND cp1."StyleID"   = es2."StyleID"
         AND cp2."StyleID"   = es1."StyleID")
)
LIMIT 20;
