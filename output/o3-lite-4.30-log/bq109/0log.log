Begin Exploring Related Columns
Relevant columns and their potential usage  
• `variant_disease_coloc.left_chrom` / `left_pos` / `left_ref` / `left_alt`: identify the GWAS variant ‘1_55029009_C_T’.  
• `variant_disease_coloc.right_gene_id`: keep only rows for gene ENSG00000169174.  
• `variant_disease_coloc.right_bio_feature`: keep only “IPSC”.  
• `variant_disease_coloc.coloc_h4` / `coloc_h3`: reliability filters (h4 > 0.8, h3 < 0.02).  
• `variant_disease_coloc.coloc_log2_h4_h3`: value to summarise (average, variance, max‑min).  
• `variant_disease_coloc.right_study`: QTL study we finally want for the max log2(h4/h3).  
• `variant_disease_coloc.left_study`: joins to GWAS study metadata.  
• `studies.trait_reported`: text filter ‑ must contain “…lesterol levels…”.  

Fixed conditions that will be used  
```
right_gene_id = 'ENSG00000169174'
right_bio_feature = 'IPSC'
coloc_h4 > 0.8
coloc_h3 < 0.02
left_chrom = '1' AND left_pos = 55029009 AND left_ref = 'C' AND left_alt = 'T'
LOWER(st.trait_reported) LIKE '%lesterol levels%'
```  

Below are ten step‑wise BigQuery SQL queries (LIMIT 20 except the last one) showing how to explore the data and finally obtain the requested statistics.  
```sql
-- 1. List all coloc rows for the gene of interest
SELECT *
FROM `open-targets-genetics.genetics.variant_disease_coloc`
WHERE right_gene_id = 'ENSG00000169174'
LIMIT 20;
```

```sql
-- 2. Add the variant filter (1_55029009_C_T)
SELECT left_study, right_study, coloc_h4, coloc_h3, coloc_log2_h4_h3
FROM `open-targets-genetics.genetics.variant_disease_coloc`
WHERE right_gene_id = 'ENSG00000169174'
  AND left_chrom = '1' AND left_pos = 55029009
  AND left_ref = 'C' AND left_alt = 'T'
LIMIT 20;
```

```sql
-- 3. Keep only strong coloc signals (h4 > 0.8 and h3 < 0.02)
SELECT left_study, right_study, coloc_h4, coloc_h3, coloc_log2_h4_h3
FROM `open-targets-genetics.genetics.variant_disease_coloc`
WHERE right_gene_id = 'ENSG00000169174'
  AND left_chrom = '1' AND left_pos = 55029009
  AND left_ref = 'C' AND left_alt = 'T'
  AND coloc_h4 > 0.8
  AND coloc_h3 < 0.02
LIMIT 20;
```

```sql
-- 4. Also require the right biological feature to be IPSC
SELECT left_study, right_study, right_bio_feature, coloc_log2_h4_h3
FROM `open-targets-genetics.genetics.variant_disease_coloc`
WHERE right_gene_id = 'ENSG00000169174'
  AND left_chrom = '1' AND left_pos = 55029009
  AND left_ref = 'C' AND left_alt = 'T'
  AND coloc_h4 > 0.8
  AND coloc_h3 < 0.02
  AND right_bio_feature = 'IPSC'
LIMIT 20;
```

```sql
-- 5. Join to studies table to inspect the reported traits of the left (GWAS) study
SELECT vc.left_study,
       st.trait_reported
FROM `open-targets-genetics.genetics.variant_disease_coloc` AS vc
JOIN `open-targets-genetics.genetics.studies`            AS st
  ON vc.left_study = st.study_id
WHERE vc.right_gene_id = 'ENSG00000169174'
  AND vc.left_chrom = '1' AND vc.left_pos = 55029009
  AND vc.left_ref = 'C' AND vc.left_alt = 'T'
  AND vc.coloc_h4 > 0.8 AND vc.coloc_h3 < 0.02
  AND vc.right_bio_feature = 'IPSC'
LIMIT 20;
```

```sql
-- 6. Keep only studies whose reported trait includes “lesterol levels”
SELECT DISTINCT vc.left_study, st.trait_reported
FROM `open-targets-genetics.genetics.variant_disease_coloc` AS vc
JOIN `open-targets-genetics.genetics.studies`            AS st
  ON vc.left_study = st.study_id
WHERE vc.right_gene_id = 'ENSG00000169174'
  AND vc.left_chrom = '1' AND vc.left_pos = 55029009
  AND vc.left_ref = 'C' AND vc.left_alt = 'T'
  AND vc.coloc_h4 > 0.8 AND vc.coloc_h3 < 0.02
  AND vc.right_bio_feature = 'IPSC'
  AND LOWER(st.trait_reported) LIKE '%lesterol levels%'
LIMIT 20;
```

```sql
-- 7. Pull coloc_log2_h4_h3 values that satisfy all conditions
SELECT vc.left_study,
       vc.right_study,
       vc.coloc_log2_h4_h3
FROM `open-targets-genetics.genetics.variant_disease_coloc` AS vc
JOIN `open-targets-genetics.genetics.studies`            AS st
  ON vc.left_study = st.study_id
WHERE vc.right_gene_id = 'ENSG00000169174'
  AND vc.left_chrom = '1' AND vc.left_pos = 55029009
  AND vc.left_ref = 'C' AND vc.left_alt = 'T'
  AND vc.coloc_h4 > 0.8 AND vc.coloc_h3 < 0.02
  AND vc.right_bio_feature = 'IPSC'
  AND LOWER(st.trait_reported) LIKE '%lesterol levels%'
LIMIT 20;
```

```sql
-- 8. Distinct list of right_study (QTL sources) that match
SELECT DISTINCT vc.right_study
FROM `open-targets-genetics.genetics.variant_disease_coloc` AS vc
JOIN `open-targets-genetics.genetics.studies`            AS st
  ON vc.left_study = st.study_id
WHERE vc.right_gene_id = 'ENSG00000169174'
  AND vc.left_chrom = '1' AND vc.left_pos = 55029009
  AND vc.left_ref = 'C' AND vc.left_alt = 'T'
  AND vc.coloc_h4 > 0.8 AND vc.coloc_h3 < 0.02
  AND vc.right_bio_feature = 'IPSC'
  AND LOWER(st.trait_reported) LIKE '%lesterol levels%'
LIMIT 20;
```

```sql
-- 9. Identify the row with the maximum log2(h4/h3) after all filters
SELECT *
FROM `open-targets-genetics.genetics.variant_disease_coloc` AS vc
JOIN `open-targets-genetics.genetics.studies`            AS st
  ON vc.left_study = st.study_id
WHERE vc.right_gene_id = 'ENSG00000169174'
  AND vc.left_chrom = '1' AND vc.left_pos = 55029009
  AND vc.left_ref = 'C' AND vc.left_alt = 'T'
  AND vc.coloc_h4 > 0.8 AND vc.coloc_h3 < 0.02
  AND vc.right_bio_feature = 'IPSC'
  AND LOWER(st.trait_reported) LIKE '%lesterol levels%'
ORDER BY vc.coloc_log2_h4_h3 DESC
LIMIT 20;
```

```sql
-- 10. FINAL: compute average, sample variance, max‑min difference of log2(h4/h3)
--         and return the QTL source (right_study) where that log2 ratio is maximal
WITH filtered AS (
  SELECT vc.right_study,
         vc.coloc_log2_h4_h3
  FROM `open-targets-genetics.genetics.variant_disease_coloc` AS vc
  JOIN `open-targets-genetics.genetics.studies`            AS st
    ON vc.left_study = st.study_id
  WHERE vc.right_gene_id = 'ENSG00000169174'
    AND vc.left_chrom = '1' AND vc.left_pos = 55029009
    AND vc.left_ref = 'C' AND vc.left_alt = 'T'
    AND vc.coloc_h4 > 0.8 AND vc.coloc_h3 < 0.02
    AND vc.right_bio_feature = 'IPSC'
    AND LOWER(st.trait_reported) LIKE '%lesterol levels%'
)
SELECT
  AVG(coloc_log2_h4_h3)                      AS avg_log2_h4_h3,
  VAR_SAMP(coloc_log2_h4_h3)                 AS var_log2_h4_h3,
  MAX(coloc_log2_h4_h3) - MIN(coloc_log2_h4_h3) AS range_log2_h4_h3,
  (SELECT right_study
   FROM filtered
   ORDER BY coloc_log2_h4_h3 DESC
   LIMIT 1)                                  AS right_study_max_log2_h4_h3
FROM filtered;
```
