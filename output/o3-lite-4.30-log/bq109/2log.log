```sql
--Description: 
-- Build a filtered set (“filt”) that satisfies every condition stated in the task:
--   • right_gene_id  = 'ENSG00000169174'
--   • coloc_h4  > 0.8  and  coloc_h3 < 0.02
--   • right_bio_feature = 'IPSC'
--   • the GWAS trait (left_study) contains the phrase “lesterol levels”
--   • either the left‑side or right‑side variant string equals ‘1_55029009_C_T’
-- Then, from that set:
--   1. AVG() gives the mean log₂(H4/H3)
--   2. VAR_POP() gives the population variance
--   3. MAX‑MIN gives the range
--   4. A scalar sub‑query (ORDER BY DESC, LIMIT 1) returns the right_study with
--      the highest log₂(H4/H3).
WITH filt AS (
  SELECT
    vc.coloc_log2_h4_h3,
    vc.right_study
  FROM `open-targets-genetics.genetics.variant_disease_coloc` AS vc
  JOIN `open-targets-genetics.genetics.studies`              AS s
        ON vc.left_study = s.study_id
  WHERE vc.right_gene_id     = 'ENSG00000169174'
    AND vc.coloc_h4          > 0.8
    AND vc.coloc_h3          < 0.02
    AND vc.right_bio_feature = 'IPSC'
    AND LOWER(s.trait_reported) LIKE '%lesterol levels%'
    AND (
          CONCAT(vc.left_chrom , '_', CAST(vc.left_pos  AS STRING), '_', vc.left_ref , '_', vc.left_alt ) = '1_55029009_C_T'
       OR CONCAT(vc.right_chrom, '_', CAST(vc.right_pos AS STRING), '_', vc.right_ref, '_', vc.right_alt) = '1_55029009_C_T'
        )
)
SELECT
  AVG(coloc_log2_h4_h3)                                   AS avg_log2_h4_h3,
  VAR_POP(coloc_log2_h4_h3)                               AS var_log2_h4_h3,
  MAX(coloc_log2_h4_h3) - MIN(coloc_log2_h4_h3)           AS range_log2_h4_h3,
  (SELECT right_study FROM filt ORDER BY coloc_log2_h4_h3 DESC LIMIT 1)
                                                         AS right_study_of_max
FROM filt;
```
