Query:
--Description: 10) Final condensed query that yields the exact output required for the
--               chronological scoring summary (clock, running scores, who scored, what happened)
WITH scoring AS (
  SELECT
    elapsed_time_sec,
    game_clock,
    team_market,
    points_scored,
    SUM(points_scored) OVER (PARTITION BY team_id ORDER BY elapsed_time_sec) AS running_pts,
    event_description
  FROM `bigquery-public-data.ncaa_basketball.mbb_pbp_sr`
  WHERE game_id = '95cda731-b593-42cd-8573-621a3d1369dc'
    AND points_scored > 0
),
pivoted AS (
  SELECT
    elapsed_time_sec,
    game_clock,
    MAX(CASE WHEN team_market = 'Kentucky'   THEN running_pts END) AS wildcats_score,
    MAX(CASE WHEN team_market = 'Notre Dame' THEN running_pts END) AS fighting_irish_score,
    ANY_VALUE(team_market)        AS scoring_team,
    ANY_VALUE(event_description)  AS event_description
  FROM scoring
  GROUP BY elapsed_time_sec, game_clock
)
SELECT
  game_clock,
  wildcats_score,
  fighting_irish_score,
  scoring_team,
  event_description
FROM pivoted
ORDER BY elapsed_time_sec
