```sql
--Description: We need every distinct month (formatted YYYY‑MM) that has orders between 1‑Jun‑2019 and 31‑Dec‑2019.
--“created_at” is stored in micro‑seconds; dividing by 1,000,000 yields epoch seconds.
--TO_TIMESTAMP turns those seconds into a proper TIMESTAMP.
--DATE_TRUNC('month', …) normalises any day within that month to the month’s first day.
--TO_CHAR then formats that truncated timestamp as the string YYYY‑MM.
--DISTINCT removes duplicates, ORDER BY sorts chronologically, and LIMIT 20 keeps the preview short.
SELECT DISTINCT
       TO_CHAR(
           DATE_TRUNC('month', TO_TIMESTAMP("created_at" / 1000000)),
           'YYYY-MM'
       ) AS "yyyy_mm"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
WHERE  "created_at" BETWEEN 1559347200000000   -- 2019‑06‑01 00:00:00
                        AND 1577836799000000   -- 2019‑12‑31 23:59:59
ORDER  BY "yyyy_mm"
LIMIT 20;
```
