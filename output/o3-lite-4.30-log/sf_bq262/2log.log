```

```sql
-- 10) Draft of the full month‑over‑month growth report (July‑Dec 2019), limited to 20 rows
WITH base AS (
  SELECT TO_CHAR(DATE_FROM_PARTS(1970,1,1) 
                 + (o."created_at"/1000000)::BIGINT*INTERVAL '1 SECOND', 'YYYY-MM') AS "yyyymm",
         p."category",
         COUNT(DISTINCT o."order_id")                       AS "orders_cnt",
         SUM(oi."sale_price")                               AS "revenue",
         SUM(oi."sale_price" - p."cost")                    AS "profit"
  FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
  JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o  ON o."order_id" = oi."order_id"
  JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p  ON p."id"      = oi."product_id"
  WHERE  o."created_at" BETWEEN 1559347200000000 AND 1577836799000000   -- Jun‑Dec 2019
  GROUP  BY 1,2
),
jun AS (
  SELECT b."category",
         b."orders_cnt"  AS "orders_jun",
         b."revenue"     AS "revenue_jun",
         b."profit"      AS "profit_jun"
  FROM   base b
  WHERE  b."yyyymm" = '2019-06'
)
SELECT b."yyyymm",
       b."category",
       b."orders_cnt",
       b."revenue",
       b."profit",
       ROUND( (b."orders_cnt"  - j."orders_jun")  / NULLIF(j."orders_jun",0) , 4) AS "orders_mom_growth",
       ROUND( (b."revenue"     - j."revenue_jun") / NULLIF(j."revenue_jun",0), 4) AS "revenue_mom_growth",
       ROUND( (b."profit"      - j."profit_jun")  / NULLIF(j."profit_jun",0) , 4) AS "profit_mom_growth"
FROM   base b
JOIN   jun  j  ON j."category" = b."category"
WHERE  b."yyyymm" != '2019-06'           -- omit June but use it for growth
ORDER  BY b."yyyymm", b."category"
LIMIT 20;
```

Each query provides a progressively deeper look at the data you will need, ending with a prototype of the final report (still capped at 20 rows for inspection).  
