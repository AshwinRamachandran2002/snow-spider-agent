--Description: Draft MoM growth report (July‑Dec 2019) using safer timestamp conversion; June is the baseline but omitted from output.
WITH base AS (
  SELECT TO_CHAR(
           DATE_TRUNC('month', TO_TIMESTAMP(o."created_at" / 1000000)),
           'YYYY-MM'
         )                         AS "yyyymm",
         p."category",
         COUNT(DISTINCT o."order_id")            AS "orders_cnt",
         SUM(oi."sale_price")                    AS "revenue",
         SUM(oi."sale_price" - p."cost")         AS "profit"
  FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
  JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o  ON o."order_id" = oi."order_id"
  JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p  ON p."id"      = oi."product_id"
  WHERE  o."created_at" BETWEEN 1559347200000000 AND 1577836799000000   -- Jun‑Dec 2019
  GROUP  BY 1,2
),
jun AS (
  SELECT b."category",
         b."orders_cnt" AS "orders_jun",
         b."revenue"    AS "revenue_jun",
         b."profit"     AS "profit_jun"
  FROM   base b
  WHERE  b."yyyymm" = '2019-06'
)
SELECT b."yyyymm",
       b."category",
       b."orders_cnt",
       b."revenue",
       b."profit",
       ROUND( (b."orders_cnt" - j."orders_jun")  / NULLIF(j."orders_jun",0), 4) AS "orders_mom_growth",
