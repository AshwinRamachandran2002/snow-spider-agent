```sql
-- 1) Quick glance at raw order headers for 2019
SELECT "order_id",
       "status",
       "created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
WHERE "created_at" BETWEEN 1559347200000000 AND 1577836799000000
LIMIT 20;
```

```sql
-- 2) See the earliest and latest order timestamps present in the whole table
SELECT MIN("created_at") AS "min_created_at",
       MAX("created_at") AS "max_created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS";
```

```sql
-- 3) Distinct year‑month values actually present in 2019 (micro‑seconds truncated to month using integer math)
SELECT DISTINCT TO_CHAR( DATE_FROM_PARTS(1970,1,1) 
                         + ("created_at"/1000000)::BIGINT * INTERVAL '1 SECOND', 'YYYY-MM') AS "yyyy_mm"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
WHERE "created_at" BETWEEN 1559347200000000 AND 1577836799000000
ORDER BY 1
LIMIT 20;
```

```sql
-- 4) Look at order items joined to their parent orders for June 2019
