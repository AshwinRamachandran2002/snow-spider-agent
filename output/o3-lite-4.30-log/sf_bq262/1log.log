-- 9. Description: Filter out June 2019 from the final display but still reference it in MoM calculations.
WITH base AS (
  SELECT TO_CHAR(TO_TIMESTAMP(oi."created_at"/1e6), 'YYYY‑MM') AS "month",
         p."category",
         COUNT(DISTINCT oi."order_id")                         AS "orders_cnt",
         SUM(oi."sale_price")                                  AS "revenue",
         SUM(oi."sale_price" - p."cost")                       AS "profit"
  FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
  JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
         ON p."id" = oi."product_id"
  WHERE  oi."created_at" BETWEEN 1559347200000000 AND 1577836800000000
  GROUP  BY 1, 2
)
SELECT *
FROM   (
  SELECT "month",
         "category",
         "orders_cnt",
         "revenue",
         "profit",
         ROUND(("orders_cnt" / NULLIF(LAG("orders_cnt") OVER (PARTITION BY "category" ORDER BY "month"),0) - 1)*100,2) AS "orders_mom_%", 
         ROUND(("revenue"     / NULLIF(LAG("revenue")     OVER (PARTITION BY "category" ORDER BY "month"),0) - 1)*100,2) AS "revenue_mom_%",
         ROUND(("profit"      / NULLIF(LAG("profit")      OVER (PARTITION BY "category" ORDER BY "month"),0) - 1)*100,2) AS "profit_mom_%"
  FROM   base
) z
WHERE  z."month" <> '2019‑06'
ORDER  BY z."month", z."category"
LIMIT  20;
