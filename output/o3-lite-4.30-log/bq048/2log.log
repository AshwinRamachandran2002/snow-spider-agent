--Description:
--We must discover which 311 complaint types (2011‑2020) have the strongest
--positive and strongest negative Pearson correlations between their DAILY
--PROPORTION of all requests and the daily mean wind speed observed at
--JFK Airport (NOAA GSOD station 744860).  Only types with >3 000 total
--requests are eligible.
--
--Logical steps inside successive CTEs
--1) type_counts ‑ total requests per complaint_type to apply 3 000‑minimum filter.
--2) daily        ‑ daily counts per complaint_type.
--3) tot          ‑ total 311 requests per day.
--4) wind         ‑ daily mean wind speed (knots) at JFK, 2011‑2020.
--5) props        ‑ daily proportion = cnt / tot_cnt for each complaint type.
--6) joined       ‑ combine proportions with wind by calendar day.
--7) corrs        ‑ compute Pearson r for each complaint type, rounded to 4 dp.
--8) final        ‑ rank correlations; keep top positive (pos_rank=1) and
--                  top negative (neg_rank=1); return their coefficients.

WITH type_counts AS (
  SELECT complaint_type,
         COUNT(*) AS total_requests
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY complaint_type
),
daily AS (
  SELECT DATE(created_date) AS day,
         complaint_type,
         COUNT(*)           AS cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY day, complaint_type
),
tot AS (
  SELECT DATE(created_date) AS day,
         COUNT(*)           AS tot_cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY day
),
wind AS (
  SELECT DATE(CAST(year AS INT64), CAST(mo AS INT64), CAST(da AS INT64)) AS day,
         SAFE_CAST(wdsp AS FLOAT64) AS wind_knots
  FROM `bigquery-public-data.noaa_gsod.gsod*`
  WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
    AND stn = '744860'
),
props AS (
  SELECT d.day,
         d.complaint_type,
         d.cnt / t.tot_cnt AS prop
  FROM daily d
  JOIN tot   t USING(day)
),
joined AS (
  SELECT p.complaint_type,
         p.prop,
         w.wind_knots
  FROM props p
  JOIN wind  w USING(day)
),
corrs AS (
  SELECT complaint_type,
         ROUND(CORR(prop, wind_knots), 4) AS corr_coef
  FROM joined
  GROUP BY complaint_type
),
final AS (
  SELECT c.complaint_type,
         c.corr_coef,
         RANK() OVER (ORDER BY c.corr_coef DESC) AS pos_rank,
         RANK() OVER (ORDER BY c.corr_coef ASC ) AS neg_rank
  FROM corrs c
  JOIN type_counts tc
    ON c.complaint_type = tc.complaint_type
  WHERE tc.total_requests > 3000
)
SELECT complaint_type,
       corr_coef
FROM final
WHERE pos_rank = 1 OR neg_rank = 1
ORDER BY corr_coef DESC;
