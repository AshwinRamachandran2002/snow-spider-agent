Begin Exploring Related Columns
Relevant columns and their roles  
• `311_service_requests.created_date`: filter rows to 2011‑01‑01 – 2020‑12‑31 and derive the calendar `DATE`.  
• `311_service_requests.complaint_type`: classify each request; will be counted and converted to a daily proportion.  
• `noaa_gsod.gsod*.(year , mo , da)`: build a `DATE` that matches the 311 calendar day.  
• `noaa_gsod.gsod*.wdsp`: mean daily wind‑speed (knots, to tenths); will be converted to FLOAT64.  
• `noaa_gsod.gsod*.stn`: keep only station **744860** (JFK Airport).  

Typical filters / conditions  
• `created_date BETWEEN '2011-01-01' AND '2020-12-31'`  
• `stn = '744860'`  
• `_TABLE_SUFFIX BETWEEN '2011' AND '2020'` (when using the wildcard tables `gsod*`)  

Below are ten inspection‑to‑solution SQL statements, each capped at 20 rows, that progressively explore the data and culminate in the final correlation results.

```sql
-- 1. Peek at a few 311 requests in the target period
SELECT created_date, complaint_type, borough
FROM `bigquery-public-data.new_york.311_service_requests`
WHERE created_date BETWEEN '2011-01-01' AND '2011-01-31'
LIMIT 20;
```

```sql
-- 2. List distinct complaint categories recorded since 2011
SELECT DISTINCT complaint_type
FROM `bigquery-public-data.new_york.311_service_requests`
WHERE created_date >= '2011-01-01'
LIMIT 20;
```

```sql
-- 3. Count total requests by complaint type (2011‑2020)
SELECT complaint_type, COUNT(*) AS total_requests
FROM `bigquery-public-data.new_york.311_service_requests`
WHERE created_date BETWEEN '2011-01-01' AND '2020-12-31'
GROUP BY complaint_type
ORDER BY total_requests DESC
LIMIT 20;
```

```sql
-- 4. Retain only complaint types that exceed the 3 000‑request threshold
SELECT complaint_type, COUNT(*) AS total_requests
FROM `bigquery-public-data.new_york.311_service_requests`
WHERE created_date BETWEEN '2011-01-01' AND '2020-12-31'
GROUP BY complaint_type
HAVING total_requests > 3000
ORDER BY total_requests DESC
LIMIT 20;
```

```sql
-- 5. Build daily totals for all 311 complaints
SELECT DATE(created_date) AS req_date,
       COUNT(*)          AS daily_total
FROM `bigquery-public-data.new_york.311_service_requests`
WHERE created_date BETWEEN '2011-01-01' AND '2020-12-31'
GROUP BY req_date
ORDER BY req_date
LIMIT 20;
```

```sql
-- 6. Example: daily counts for one popular complaint (Noise – Street/Sidewalk)
SELECT DATE(created_date)      AS req_date,
       COUNT(*)                AS noise_cnt
FROM `bigquery-public-data.new_york.311_service_requests`
WHERE created_date BETWEEN '2011-01-01' AND '2020-12-31'
  AND complaint_type = 'Noise - Street/Sidewalk'
GROUP BY req_date
ORDER BY req_date
LIMIT 20;
```

```sql
-- 7. Retrieve JFK daily mean wind speeds (station 744860) for 2011
SELECT DATE(CAST(year AS INT64), CAST(mo AS INT64), CAST(da AS INT64)) AS obs_date,
       SAFE_CAST(wdsp AS FLOAT64) AS wind_knots
FROM `bigquery-public-data.noaa_gsod.gsod*`
WHERE _TABLE_SUFFIX = '2011'
  AND stn = '744860'
ORDER BY obs_date
LIMIT 20;
```

```sql
-- 8. Join wind with one complaint to see daily proportions
WITH noise AS (
  SELECT DATE(created_date) AS day, COUNT(*) AS cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2011-01-01' AND '2020-12-31'
    AND complaint_type = 'Noise - Street/Sidewalk'
  GROUP BY day
),
tot AS (
  SELECT DATE(created_date) AS day, COUNT(*) AS tot_cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY day
),
wind AS (
  SELECT DATE(CAST(year AS INT64),CAST(mo AS INT64),CAST(da AS INT64)) AS day,
         SAFE_CAST(wdsp AS FLOAT64) AS wind_knots
  FROM `bigquery-public-data.noaa_gsod.gsod*`
  WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
    AND stn = '744860'
)
SELECT w.day,
       wind_knots,
       IFNULL(cnt,0)/tot_cnt AS noise_prop
FROM wind w
LEFT JOIN noise USING(day)
JOIN tot  USING(day)
ORDER BY w.day
LIMIT 20;
```

```sql
-- 9. Compute Pearson r between JFK wind and one complaint’s daily proportion
WITH daily AS (
  SELECT DATE(created_date)               AS day,
         complaint_type,
         COUNT(*)                         AS cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2011-01-01' AND '2020-12-31'
    AND complaint_type = 'Noise - Street/Sidewalk'
  GROUP BY day, complaint_type
),
tot AS (
  SELECT DATE(created_date) AS day, COUNT(*) AS tot_cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY day
),
wind AS (
  SELECT DATE(CAST(year AS INT64),CAST(mo AS INT64),CAST(da AS INT64)) AS day,
         SAFE_CAST(wdsp AS FLOAT64) AS wind_knots
  FROM `bigquery-public-data.noaa_gsod.gsod*`
  WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
    AND stn = '744860'
)
SELECT CORR(IFNULL(cnt,0)/tot_cnt , wind_knots) AS r_noise_wind
FROM wind
LEFT JOIN daily USING(day)
JOIN tot   USING(day);
```

```sql
-- 10. Final: find the strongest positive and strongest negative correlations
WITH daily AS (
  SELECT DATE(created_date) AS day,
         complaint_type,
         COUNT(*)           AS cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY day, complaint_type
),
tot AS (
  SELECT DATE(created_date) AS day,
         COUNT(*)           AS tot_cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY day
),
wind AS (
  SELECT DATE(CAST(year AS INT64),CAST(mo AS INT64),CAST(da AS INT64)) AS day,
         SAFE_CAST(wdsp AS FLOAT64) AS wind_knots
  FROM `bigquery-public-data.noaa_gsod.gsod*`
  WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
    AND stn = '744860'
),
props AS (
  SELECT d.day,
         d.complaint_type,
         d.cnt / t.tot_cnt        AS prop
  FROM daily d
  JOIN tot  t USING(day)
),
joined AS (
  SELECT p.complaint_type,
         p.prop,
         w.wind_knots
  FROM props  p
  JOIN wind   w USING(day)
)
SELECT complaint_type,
       ROUND(CORR(prop, wind_knots), 4) AS corr_coef
FROM joined
GROUP BY complaint_type
HAVING SUM(p.prop) IS NOT NULL            -- exclude types with no overlap
   AND (SELECT COUNT(*) FROM `bigquery-public-data.new_york.311_service_requests`
         WHERE complaint_type = joined.complaint_type
           AND created_date BETWEEN '2011-01-01' AND '2020-12-31') > 3000
ORDER BY corr_coef DESC
LIMIT 20;            -- first row = strongest positive, last row = strongest negative
```

These queries let you explore the data step‑by‑step and, with the final query, return the complaint types whose daily proportions have the highest positive and the strongest negative Pearson correlations with JFK’s daily mean wind speed, rounded to four decimal places.
