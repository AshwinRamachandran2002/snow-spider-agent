Query:
--Description:  Corrected version of the original “final answer” query.
--  Fixes made:
--    • Include the daily count n in `props` so it can be summed later.
--    • Use consistent column names (`tot_reqs`) to avoid missing‑name errors.
--    • Remove the redundant extra JOIN of by_type in the corrs CTE.
--    • Round correlation in the last step (not inside a CTE that feeds HAVING).
--  The query outputs two rows—the complaint types with the strongest
--  positive and negative Pearson correlations (rounded to 4 decimals) between
--  their daily proportion of all 311 requests and daily mean wind speed at
--  JFK (station 744860) for 2011‑2020, considering only types with ≥3 000
--  total requests and ≥30 overlapping days.

WITH
-- 1) JFK daily wind speed
wind AS (
  SELECT
    PARSE_DATE('%Y-%m-%d', CONCAT(year,'-',mo,'-',da)) AS d,
    CAST(wdsp AS FLOAT64) AS wdsp_knots
  FROM `bigquery-public-data.noaa_gsod.gsod20*`
  WHERE stn = '744860'
    AND year BETWEEN '2011' AND '2020'
    AND wdsp NOT IN ('999.9','9999.9')
),
-- 2) Daily total 311 requests
tot AS (
  SELECT DATE(created_date) AS d,
         COUNT(*)           AS tot_reqs
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY d
),
-- 3) Daily count per complaint type
by_type AS (
  SELECT DATE(created_date) AS d,
         complaint_type,
         COUNT(*)           AS n
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY d, complaint_type
),
-- 4) Daily proportion per complaint type
props AS (
  SELECT
    b.complaint_type,
    b.d,
    b.n,
    SAFE_DIVIDE(b.n, t.tot_reqs) AS prop
  FROM by_type b
  JOIN tot t USING (d)
),
-- 5) Correlation per complaint type with filters
corrs AS (
  SELECT
    complaint_type,
    CORR(prop, wdsp_knots)          AS corr_coeff,
    SUM(n)                          AS total_reqs
  FROM props
  JOIN wind USING (d)
  GROUP BY complaint_type
  HAVING total_reqs >= 3000         -- at least 3 000 requests overall
     AND COUNT(prop)  >= 30         -- at least 30 overlap days
)
-- 6) Output strongest positive and negative correlations
SELECT complaint_type, ROUND(corr_coeff, 4) AS corr_coeff
FROM (
  (SELECT complaint_type, corr_coeff FROM corrs ORDER BY corr_coeff DESC LIMIT 1)
  UNION ALL
  (SELECT complaint_type, corr_coeff FROM corrs ORDER BY corr_coeff ASC  LIMIT 1)
)
