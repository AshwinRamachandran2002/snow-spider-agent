```sql
/* Thinking process (inline comments):
   1.  Pull daily mean wind‑speed for JFK Airport (station 744860) from every
       GSOD table whose name starts with gsod20*, restricted to years 2011‑2020,
       and discard the 999/9999 “missing” codes.
   2.  Compute the total number of 311 requests per NYC day for the same decade
       (denominator for proportions).
   3.  Compute the daily count per complaint_type (numerator).
   4.  Derive the daily proportion of each complaint_type (SAFE_DIVIDE).
   5.  Join proportions to wind; for each complaint_type calculate Pearson
       correlation between its daily proportion and wind speed.
   6.  Keep only complaint types with ≥3 000 total requests and at least 30
       overlap days; round the coefficient to 4 decimals.
   7.  Return two rows: the strongest positive and strongest negative
       correlations.
*/
WITH
-- Step‑1: JFK daily wind series (knots)
wind AS (
  SELECT
    PARSE_DATE('%Y-%m-%d', CONCAT(year,'-',mo,'-',da)) AS d,
    CAST(wdsp AS FLOAT64)                              AS wdsp_knots
  FROM `bigquery-public-data.noaa_gsod.gsod20*`
  WHERE stn = '744860'
    AND year BETWEEN '2011' AND '2020'
    AND wdsp NOT IN ('999.9','9999.9')
),
-- Step‑2: city‑wide daily 311 totals
tot AS (
  SELECT DATE(created_date) AS d,
         COUNT(*)           AS tot_reqs
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY d
),
-- Step‑3: daily counts per complaint type
by_type AS (
  SELECT DATE(created_date) AS d,
         complaint_type,
         COUNT(*)           AS n
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY d, complaint_type
),
-- Step‑4: daily proportion of each complaint type
props AS (
  SELECT
    b.complaint_type,
    b.d,
    b.n,
    SAFE_DIVIDE(b.n, t.tot_reqs) AS prop
  FROM by_type b
  JOIN tot t USING (d)
),
-- Step‑5/6: correlation per complaint type with filters
corrs AS (
  SELECT
    complaint_type,
    ROUND(CORR(prop, wdsp_knots), 4) AS corr_coeff,
    SUM(n)                           AS total_reqs
  FROM props
