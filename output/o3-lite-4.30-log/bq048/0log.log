```sql
--Description:  One‑shot query to find, for 2011‑2020, the 311 complaint types
-- (each having ≥3 000 total requests) whose daily proportion of all 311 calls
-- is most strongly POSITIVELY and most strongly NEGATIVELY correlated with the
-- daily mean wind speed measured at JFK Airport (GSOD station 744860).
-- --------------------------------------------------------------------------
-- Logic steps inside CTEs
--   wind   : daily wind speed series (knots) from all gsod20* tables.
--   tot    : daily total 311 requests (denominator for proportions).
--   by_type: daily 311 counts per complaint_type (numerator).
--   props  : daily share = n / total, keeping n for later summation.
--   corrs  : Pearson CORR(prop, wind) per complaint_type, filtered to
--            ≥3 000 total requests and ≥30 overlapping days; coefficient
--            rounded to 4 decimals.
-- Final SELECT returns exactly two rows: highest and lowest correlations.
WITH
-- 1) JFK daily wind speed
wind AS (
  SELECT
    PARSE_DATE('%Y-%m-%d', CONCAT(year,'-',mo,'-',da)) AS d,
    CAST(wdsp AS FLOAT64)                              AS wdsp_knots
  FROM `bigquery-public-data.noaa_gsod.gsod20*`
  WHERE stn = '744860'
    AND year BETWEEN '2011' AND '2020'
    AND wdsp NOT IN ('999.9','9999.9')            -- exclude “missing” values
),
-- 2) Daily total 311 requests
tot AS (
  SELECT DATE(created_date) AS d,
         COUNT(*)           AS tot_reqs
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY d
),
-- 3) Daily count per complaint type
by_type AS (
  SELECT DATE(created_date) AS d,
         complaint_type,
         COUNT(*)           AS n
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY d, complaint_type
),
-- 4) Daily proportion of each complaint type
props AS (
  SELECT
    b.complaint_type,
    b.d,
    b.n,
    SAFE_DIVIDE(b.n, t.tot_reqs) AS prop
  FROM by_type b
  JOIN tot     t USING (d)
),
-- 5) Correlation per complaint type with filters
corrs AS (
  SELECT
    complaint_type,
    ROUND(CORR(prop, wdsp_knots), 4) AS corr_coeff,
    SUM(n)                           AS total_reqs
  FROM props
  JOIN wind USING (d)
  GROUP BY complaint_type
  HAVING total_reqs >= 3000          -- only well‑represented types
     AND COUNT(prop)  >= 30          -- sufficient overlap days
)
-- 6) Output strongest positive and negative correlations
SELECT complaint_type, corr_coeff
FROM (
  (SELECT complaint_type, corr_coeff FROM corrs ORDER BY corr_coeff DESC LIMIT 1)
  UNION ALL
  (SELECT complaint_type, corr_coeff FROM corrs ORDER BY corr_coeff ASC  LIMIT 1)
);
