```sql
-- 7. Daily TOTAL of 311 requests city‑wide (2011‑2020)
-- Description: denominator for the daily proportions.
SELECT
  DATE(created_date)            AS req_date,
  COUNT(*)                      AS total_requests
FROM `bigquery-public-data.new_york.311_service_requests`
WHERE DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
