```sql
--Description:  Find the 311 complaint types (2011‑2020) whose daily share of
--total 311 calls is most positively and most negatively correlated with the
--daily mean wind speed recorded at JFK Airport (GSOD station 744860).  Only
--complaint types with >3 000 total requests in the decade are considered.
--Steps
-- 1)  wind  : collect daily mean wind speed for 2011‑2020, removing “missing”
--             codes (999.9 / 9999.9) and building a DATE field.
-- 2)  tot   : total 311 calls per day.
-- 3)  big   : complaint types with >3 000 calls overall.
-- 4)  dcnt  : per‑day counts for each “big” complaint type.
-- 5)  prop  : per‑day proportion (dcnt ÷ tot).
-- 6)  corrs : Pearson correlation between prop and wind for every type.
-- 7)  Return the strongest positive and strongest negative correlations,
--     rounded to four decimals, as required.

WITH wind AS (
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS day,
         CAST(wdsp AS FLOAT64)            AS wind
  FROM   `bigquery-public-data.noaa_gsod.gsod*`
  WHERE  _TABLE_SUFFIX BETWEEN '2011' AND '2020'
     AND stn = '744860'
     AND CAST(wdsp AS FLOAT64) NOT IN (999.9, 9999.9)
),
tot AS (
  SELECT DATE(created_date) AS day,
         COUNT(*)           AS tot_calls
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP  BY day
),
big AS (
  SELECT complaint_type
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP  BY complaint_type
  HAVING COUNT(*) > 3000
),
dcnt AS (
  SELECT DATE(created_date) AS day,
         complaint_type,
         COUNT(*)           AS n_type
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
    AND  complaint_type IN (SELECT complaint_type FROM big)
  GROUP  BY day, complaint_type
),
prop AS (
  SELECT d.complaint_type,
         d.day,
         d.n_type / t.tot_calls AS prop
  FROM   dcnt d
  JOIN   tot  t ON t.day = d.day
),
corrs AS (
  SELECT p.complaint_type,
         CORR(p.prop, w.wind) AS corr_coef
  FROM   prop p
  JOIN   wind w ON w.day = p.day
  GROUP  BY p.complaint_type
)
SELECT complaint_type, ROUND(corr_coef, 4) AS corr_coef
FROM (
      (SELECT * FROM corrs ORDER BY corr_coef DESC LIMIT 1)       -- strongest +
      UNION ALL
      (SELECT * FROM corrs ORDER BY corr_coef ASC LIMIT 1)        -- strongest –
     );
```
