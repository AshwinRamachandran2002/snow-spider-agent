[{'stn': '153140', 'wban': '99999', 'year': '2000', 'mo': '01', 'da': '21', 'temp': 31.0, 'count_temp': 4, 'dewp': 9999.9, 'count_dewp': 0, 'slp': 9999.9, 'count_slp': 0, 'stp': 9999.9, 'count_stp': 0, 'visib': 3.4, 'count_visib': 4, 'wdsp': '11.2', 'count_wdsp': '4', 'mxpsd': '15.5', 'gust': 999.9, 'max': 36.7, 'flag_max': '*', 'min': 24.8, 'flag_min': None, 'prcp': 99.99, 'flag_prcp': None, 'sndp': 5.1, 'fog': '0', 'rain_drizzle': '0', 'snow_ice_pellets': '1', 'hail': '0', 'thunder': '0', 'tornado_funnel_cloud': '0'}, {'stn': '153770', 'wban': '99999', 'year': '2000', 'mo': '12', 'da': '21', 'temp': 24.8, 'count_temp': 6, 'dewp': 9999.9, 'count_dewp': 0, 'slp': 9999.9, 'count_slp': 0, 'stp': 9999.9, 'count_stp': 0, 'visib': 5.0, 'count_visib': 6, 'wdsp': '3.6', 'count_wdsp': '6', 'mxpsd': '7.8', 'gust': 999.9, 'max': 27.7, 'flag_max': '*', 'min': 23.7, 'flag_min': None, 'prcp': 99.99, 'flag_prcp': None, 'sndp': 2.4, 'fog': '0', 'rain_drizzle': '0', 'snow_ice_pellets': '1', 'hail': '0

