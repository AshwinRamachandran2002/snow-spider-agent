Relevant columns, their use, and typical filter conditions
-----------------------------------------------------------
311 service requests  
• `complaint_type` : category whose relationship with wind we want to measure  
• `created_date`    : convert to DATE to aggregate by day  
  – Condition  `DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'`  
• (any other columns are not needed)

NOAA GSOD daily weather  
• `stn`     : station id – keep only JFK Airport (`stn = '744860'`)  
• `year`,`mo`,`da` : build calendar date for the observation  
• `wdsp`    : mean wind‑speed (knots, tenths) – cast to FLOAT64  
  – Condition  `CAST(wdsp AS FLOAT64) NOT IN (999.9,9999.9)` to drop “missing” codes  
  – Condition  `_TABLE_SUFFIX BETWEEN '2011' AND '2020'` to read 2011‑2020 tables in one shot

-----------------------------------------------------------
10 illustrative BigQuery SQL queries
-----------------------------------------------------------

```sql
-- 1. Peek at a few 311 rows in 2011
SELECT complaint_type, created_date
FROM `bigquery-public-data.new_york.311_service_requests`
WHERE DATE(created_date) BETWEEN '2011-01-01' AND '2011-12-31'
LIMIT 20;
```

```sql
-- 2. What complaint types exist?
SELECT DISTINCT complaint_type
FROM `bigquery-public-data.new_york.311_service_requests`
LIMIT 20;
```

```sql
-- 3. Top‑20 complaint‑type totals (2011‑2020)
SELECT complaint_type, COUNT(*) AS n_requests
FROM `bigquery-public-data.new_york.311_service_requests`
WHERE DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
GROUP BY complaint_type
ORDER BY n_requests DESC
LIMIT 20;
```

```sql
-- 4. Daily total 311 volume (all types)
SELECT DATE(created_date) AS day, COUNT(*) AS tot_reqs
FROM `bigquery-public-data.new_york.311_service_requests`
WHERE DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
GROUP BY day
ORDER BY day
LIMIT 20;
```

```sql
-- 5. Inspect raw NOAA wind data for JFK in 2011
SELECT year, mo, da, CAST(wdsp AS FLOAT64) AS wdsp
FROM `bigquery-public-data.noaa_gsod.gsod2011`
WHERE stn = '744860'
ORDER BY year, mo, da
LIMIT 20;
```

```sql
-- 6. Daily wind‑speed series for JFK, 2011‑2020
SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS day,
       CAST(wdsp AS FLOAT64) AS wind_knots_tenths
FROM `bigquery-public-data.noaa_gsod.gsod*`
WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
  AND stn = '744860'
  AND CAST(wdsp AS FLOAT64) NOT IN (999.9,9999.9)
ORDER BY day
LIMIT 20;
```

```sql
-- 7. Daily proportion of “Damaged Tree” complaints (example type)
WITH daily_tot AS (
  SELECT DATE(created_date) AS day, COUNT(*) AS tot
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY day),
daily_type AS (
  SELECT DATE(created_date) AS day, COUNT(*) AS type_cnt
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
    AND  complaint_type = 'Damaged Tree'
  GROUP BY day)
SELECT t.day,
       IFNULL(type_cnt,0)/tot AS prop_damaged_tree
FROM   daily_tot t
LEFT JOIN daily_type d USING(day)
ORDER BY t.day
LIMIT 20;
```

```sql
-- 8. Correlation between “Damaged Tree” proportions and wind speed
WITH wind AS (
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS day,
         CAST(wdsp AS FLOAT64) AS wind
  FROM `bigquery-public-data.noaa_gsod.gsod*`
  WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
    AND stn='744860'
    AND CAST(wdsp AS FLOAT64) NOT IN (999.9,9999.9)),
prop AS (
  -- reuse logic from query 7
  WITH daily_tot AS (
    SELECT DATE(created_date) AS day, COUNT(*) AS tot
    FROM   `bigquery-public-data.new_york.311_service_requests`
    WHERE  DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
    GROUP BY day),
  daily_type AS (
    SELECT DATE(created_date) AS day, COUNT(*) AS type_cnt
    FROM   `bigquery-public-data.new_york.311_service_requests`
    WHERE  DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
      AND  complaint_type = 'Damaged Tree'
    GROUP BY day)
  SELECT t.day, IFNULL(type_cnt,0)/tot AS prop
  FROM   daily_tot t
  LEFT JOIN daily_type d USING(day))
SELECT CORR(prop, wind) AS corr_damaged_tree_wind
FROM wind JOIN prop USING(day);
```

```sql
-- 9. Correlation for EVERY complaint type having >3,000 records
WITH wind AS (
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS day,
         CAST(wdsp AS FLOAT64)              AS wind
  FROM `bigquery-public-data.noaa_gsod.gsod*`
  WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
    AND stn='744860'
    AND CAST(wdsp AS FLOAT64) NOT IN (999.9,9999.9)),
tot AS (
  SELECT DATE(created_date) AS day, COUNT(*) AS tot
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY day),
types_over3k AS (
  SELECT complaint_type
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY complaint_type
  HAVING COUNT(*) > 3000),
daily_props AS (
  SELECT DATE(created_date) AS day,
         complaint_type,
         COUNT(*)            AS type_cnt
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY day, complaint_type)
SELECT d.complaint_type,
       CORR(IFNULL(d.type_cnt,0)/t.tot, w.wind) AS corr_coef
FROM   daily_props d
JOIN   tot t  ON t.day  = d.day
JOIN   wind w ON w.day  = d.day
JOIN   types_over3k o USING(complaint_type)
GROUP  BY complaint_type
ORDER  BY corr_coef DESC
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: strongest positive & strongest negative correlations
WITH wind AS (
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS day,
         CAST(wdsp AS FLOAT64)              AS wind
  FROM `bigquery-public-data.noaa_gsod.gsod*`
  WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
    AND stn='744860'
    AND CAST(wdsp AS FLOAT64) NOT IN (999.9,9999.9)),
tot AS (
  SELECT DATE(created_date) AS day, COUNT(*) AS tot
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY day),
types_over3k AS (
  SELECT complaint_type
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY complaint_type
  HAVING COUNT(*) > 3000),
daily_props AS (
  SELECT DATE(created_date) AS day,
         complaint_type,
         COUNT(*)            AS type_cnt
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY day, complaint_type)
, corrs AS (
  SELECT d.complaint_type,
         CORR(IFNULL(d.type_cnt,0)/t.tot, w.wind) AS corr_coef
  FROM   daily_props d
  JOIN   tot   t ON t.day = d.day
  JOIN   wind  w ON w.day = d.day
  JOIN   types_over3k USING(complaint_type)
  GROUP  BY complaint_type)
SELECT *
FROM (
  SELECT complaint_type, ROUND(corr_coef,4) AS corr_coef
  FROM corrs
  ORDER BY corr_coef DESC
  LIMIT 1)  -- strongest positive
UNION ALL
SELECT *
FROM (
  SELECT complaint_type, ROUND(corr_coef,4) AS corr_coef
  FROM corrs
  ORDER BY corr_coef ASC
  LIMIT 1);  -- strongest negative
```

Running the last statement returns the two requested complaint types and their Pearson correlation coefficients (positive and negative extremes) rounded to four decimal places.

