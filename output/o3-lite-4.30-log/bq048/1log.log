Query:
--Description:  Corrected version of query 9 – compute the Pearson correlation
--between daily wind speed at JFK (station 744860) and the daily proportion of
--every 311 complaint type that accumulated > 3 000 records from 2011‑01‑01 to
--2020‑12‑31.  Aliases are used so CORR() receives pure FLOAT64 arguments and
--no STRUCT/alias conflict occurs.

WITH wind AS (
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS day,
         CAST(wdsp AS FLOAT64)            AS wind
  FROM   `bigquery-public-data.noaa_gsod.gsod*`
  WHERE  _TABLE_SUFFIX BETWEEN '2011' AND '2020'
     AND stn = '744860'
     AND CAST(wdsp AS FLOAT64) NOT IN (999.9, 9999.9)
),
tot AS (
  SELECT DATE(created_date) AS day,
         COUNT(*)           AS tot_calls
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP  BY day
),
big AS (
  SELECT complaint_type
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP  BY complaint_type
  HAVING COUNT(*) > 3000
),
dcnt AS (
  SELECT DATE(created_date) AS day,
         complaint_type,
         COUNT(*)           AS n_type
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
    AND  complaint_type IN (SELECT complaint_type FROM big)
  GROUP  BY day, complaint_type
),
prop AS (
  SELECT d.complaint_type,
         d.day,
         d.n_type / t.tot_calls AS prop
  FROM   dcnt d
  JOIN   tot  t ON t.day = d.day
)
SELECT complaint_type,
       CORR(p.prop, w.wind) AS corr_coef
FROM   prop p
JOIN   wind w ON w.day = p.day
GROUP  BY complaint_type
ORDER  BY corr_coef DESC
LIMIT 20
Answer:
complaint_type,corr_coef
HEAT/HOT WATER,0.3939933674144706
Street Sign - Dangling,0.3568789046919754
HEATING,0.3397769970871836
