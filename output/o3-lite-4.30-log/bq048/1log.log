big_types AS (      -- complaint types with > 3 000 requests over the decade
  SELECT complaint_type
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
  GROUP BY complaint_type
  HAVING COUNT(*) > 3000
),
daily_type_counts AS (   -- daily counts for those complaint types
  SELECT
    DATE(created_date) AS day,
    complaint_type,
    COUNT(*)           AS type_cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE DATE(created_date) BETWEEN '2011-01-01' AND '2020-12-31'
    AND complaint_type IN (SELECT complaint_type FROM big_types)
  GROUP BY day, complaint_type
),
daily_props AS (    -- daily proportion of each type
  SELECT
    d.complaint_type,
    d.day,
    CAST(d.type_cnt AS FLOAT64) / t.tot_calls AS prop
  FROM daily_type_counts d
  JOIN daily_totals t ON t.day = d.day
),
corrs AS (          -- Pearson correlations with wind
  SELECT
    dp.complaint_type,
    CORR(dp.prop, w.wind) AS correlation_coefficient
  FROM daily_props dp
  JOIN wind w ON w.day = dp.day
  GROUP BY dp.complaint_type
),
ranked AS (         -- rank to get strongest + and –
  SELECT
    complaint_type,
    correlation_coefficient,
    ROW_NUMBER() OVER (ORDER BY correlation_coefficient DESC) AS pos_rank,
    ROW_NUMBER() OVER (ORDER BY correlation_coefficient ASC)  AS neg_rank
  FROM corrs
)
SELECT
  complaint_type,
  ROUND(correlation_coefficient, 4) AS correlation_coefficient
FROM ranked
WHERE pos_rank = 1 OR neg_rank = 1;
