LIMIT 20;
```

```sql
-- 8) Description: Bring together replies, distinct users and up‑votes for every topic under sub‑forums of “General”.
SELECT
    t."Id"                                      AS "TopicId",
    COUNT(m."Id")                               AS "ReplyCount",
    COUNT(DISTINCT m."PostUserId")              AS "DistinctUsers",
    COUNT(v."Id")                               AS "TotalUpVotes"
FROM "META_KAGGLE"."META_KAGGLE"."FORUMTOPICS" t
LEFT JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGES" m
       ON m."ForumTopicId" = t."Id"
LEFT JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES" v
       ON v."ForumMessageId" = m."Id"
WHERE t."ForumId" IN (
    SELECT "Id"
    FROM "META_KAGGLE"."META_KAGGLE"."FORUMS"
    WHERE "ParentForumId" = <REPLACE_WITH_GENERAL_ID>
)
GROUP BY t."Id"
ORDER BY t."CreationDate"
LIMIT 20;
```

```sql
-- 9) Description: Fetch the earliest five topics in those sub‑forums (no aggregates, just to identify them).
SELECT
    t."Id"          AS "TopicId",
    t."Title",
    t."CreationDate",
    t."TotalViews"
FROM "META_KAGGLE"."META_KAGGLE"."FORUMTOPICS" t
WHERE t."ForumId" IN (
    SELECT "Id"
    FROM "META_KAGGLE"."META_KAGGLE"."FORUMS"
    WHERE "ParentForumId" = <REPLACE_WITH_GENERAL_ID>
)
ORDER BY t."CreationDate" ASC
LIMIT 5;
```

```sql
-- 10) Description: Final composite query – return creation date, topic title, parent forum title, reply count, 
--                  distinct user replies, total up‑votes and total views for the earliest five topics.
SELECT
    t."CreationDate"                                           AS "CreationDate",
    t."Title"                                                  AS "TopicTitle",
    pf."Title"                                                 AS "ParentForumTitle",
    COALESCE(COUNT(m."Id"), 0)                                 AS "ReplyCount",
    COALESCE(COUNT(DISTINCT m."PostUserId"), 0)                AS "DistinctUserReplies",
    COALESCE(COUNT(v."Id"), 0)                                 AS "TotalUpVotes",
    COALESCE(t."TotalViews", 0)                                AS "TotalViews"
FROM "META_KAGGLE"."META_KAGGLE"."FORUMTOPICS" t
JOIN "META_KAGGLE"."META_KAGGLE"."FORUMS" sf
     ON sf."Id" = t."ForumId"                                  -- sub‑forum
JOIN "META_KAGGLE"."META_KAGGLE"."FORUMS" pf
     ON pf."Id" = sf."ParentForumId"                           -- parent forum (“General”)
LEFT JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGES" m
     ON m."ForumTopicId" = t."Id"
LEFT JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES" v
     ON v."ForumMessageId" = m."Id"
WHERE pf."Title" ILIKE '%general%'
GROUP BY
    t."Id",            -- keep topic grain
    t."CreationDate",
    t."Title",
    pf."Title",
    t."TotalViews"
ORDER BY t."CreationDate" ASC
LIMIT 5;
```

