```sql
--Description:  We first identify every sub‑forum that is a direct child of the “General” forum (its id = 9).  
--              From those sub‑forums we pick the five earliest topics, then compute:  
--                  • reply count         = total messages per topic  
--                  • distinct users      = unique posters per topic  
--                  • total up‑votes      = count of vote rows on those messages  
--                  • total views         = stored view counter in FORUMTOPICS (NULL→0)  
--              Finally we show topic creation date, title, parent‑forum title and the calculated metrics.
WITH subforums AS (
    SELECT "Id" AS "SubForumId"
    FROM "META_KAGGLE"."META_KAGGLE"."FORUMS"
    WHERE "ParentForumId" = 9                                       -- children of “General”
),
earliest_five AS (
    SELECT "Id"
    FROM "META_KAGGLE"."META_KAGGLE"."FORUMTOPICS"
    WHERE "ForumId" IN (SELECT "SubForumId" FROM subforums)
    ORDER BY "CreationDate" ASC
    LIMIT 5                                                          -- earliest five
)
SELECT
    t."CreationDate"                                 AS "CreationDate",
    t."Title"                                        AS "TopicTitle",
    pf."Title"                                       AS "ParentForumTitle",
    COALESCE(COUNT(m."Id"), 0)                       AS "ReplyCount",
    COALESCE(COUNT(DISTINCT m."PostUserId"), 0)      AS "DistinctUserReplies",
    COALESCE(COUNT(v."Id"), 0)                       AS "TotalUpVotes",
    COALESCE(t."TotalViews", 0)                      AS "TotalViews"
FROM  "META_KAGGLE"."META_KAGGLE"."FORUMTOPICS" t
JOIN  "META_KAGGLE"."META_KAGGLE"."FORUMS" sf
      ON sf."Id" = t."ForumId"                       -- sub‑forum of topic
JOIN  "META_KAGGLE"."META_KAGGLE"."FORUMS" pf
      ON pf."Id" = sf."ParentForumId"                -- parent → should be “General”
LEFT JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGES" m
      ON m."ForumTopicId" = t."Id"
LEFT JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES" v
      ON v."ForumMessageId" = m."Id"
WHERE t."Id" IN (SELECT "Id" FROM earliest_five)
GROUP BY
    t."Id",
    t."CreationDate",
    t."Title",
    pf."Title",
    t."TotalViews"
ORDER BY t."CreationDate" ASC;
```
