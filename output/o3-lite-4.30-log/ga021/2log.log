FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
LIMIT 20;
```

```sql
-- 2️⃣ Description: List the distinct event names that start with 'quickplay'
SELECT DISTINCT event_name
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND LOWER(event_name) LIKE 'quickplay%'
LIMIT 20;
```

```sql
-- 3️⃣ Description: Peek into event_params of one quick‑play event to see the keys that exist
SELECT ep.key,
       ep.value.string_value AS str_val,
       ep.value.int_value     AS int_val
FROM `firebase-public-project.analytics_153293282.events_*`     AS t,
     UNNEST(t.event_params) AS ep
WHERE _TABLE_SUFFIX = '20180705'
  AND t.event_name  LIKE 'quickplay%'
LIMIT 20;
```

```sql
-- 4️⃣ Description: Pull out the parameter that contains the quick‑play type
SELECT t.event_name,
       ( SELECT ep.value.string_value
         FROM UNNEST(t.event_params) ep
         WHERE ep.key = 'quickplay_event_type') AS quickplay_type
FROM `firebase-public-project.analytics_153293282.events_*` t
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND t.event_name LIKE 'quickplay%'
  AND quickplay_type IS NOT NULL
LIMIT 20;
```

```sql
-- 5️⃣ Description: First session_start per user in the cohort window
SELECT user_pseudo_id,
       MIN(_TABLE_SUFFIX) AS first_session_day
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND event_name = 'session_start'
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
-- 6️⃣ Description: Users’ very first quick‑play event (type & date) inside cohort window
WITH cohort AS (
  SELECT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
  GROUP BY user_pseudo_id
)
SELECT user_pseudo_id,
       MIN(_TABLE_SUFFIX) AS first_qp_day,
       ( SELECT ep.value.string_value
         FROM UNNEST(t.event_params) ep
         WHERE ep.key = 'quickplay_event_type') AS quickplay_type
FROM  `firebase-public-project.analytics_153293282.events_*` t
JOIN  cohort USING (user_pseudo_id)
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND t.event_name LIKE 'quickplay%'
GROUP BY user_pseudo_id, quickplay_type
LIMIT 20;
```

```sql
-- 7️⃣ Description: Any return quick‑play events for those users 14 days later
WITH cohort AS (
  SELECT user_pseudo_id,
         MIN(_TABLE_SUFFIX) AS first_qp_day,
         ( SELECT ep.value.string_value
           FROM UNNEST(t.event_params) ep
           WHERE ep.key = 'quickplay_event_type') AS quickplay_type
  FROM `firebase-public-project.analytics_153293282.events_*` t
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name LIKE 'quickplay%'
  GROUP BY user_pseudo_id, quickplay_type
)
SELECT c.user_pseudo_id,
       c.quickplay_type,
       MIN(t._TABLE_SUFFIX) AS day_of_return
FROM   cohort AS c
JOIN   `firebase-public-project.analytics_153293282.events_*` t
         ON t.user_pseudo_id = c.user_pseudo_id
WHERE  t._TABLE_SUFFIX BETWEEN '20180716' AND '20180730'
  AND  t.event_name LIKE 'quickplay%'
GROUP BY c.user_pseudo_id, c.quickplay_type
LIMIT 20;
```

```sql
-- 8️⃣ Description: Count cohort size per quick‑play type
WITH cohort AS (
  SELECT user_pseudo_id,
         ( SELECT ep.value.string_value
           FROM UNNEST(event_params) ep
           WHERE ep.key = 'quickplay_event_type') AS quickplay_type
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name LIKE 'quickplay%'
  GROUP BY user_pseudo_id, quickplay_type
)
SELECT quickplay_type,
       COUNT(DISTINCT user_pseudo_id) AS cohort_users
FROM cohort
GROUP BY quickplay_type
LIMIT 20;
```

```sql
-- 9️⃣ Description: Count retained users (came back 14 days after) per quick‑play type
WITH cohort AS (
  SELECT user_pseudo_id,
         ( SELECT ep.value.string_value
           FROM UNNEST(event_params) ep
           WHERE ep.key = 'quickplay_event_type') AS quickplay_type
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name LIKE 'quickplay%'
  GROUP BY user_pseudo_id, quickplay_type
),
returns AS (
  SELECT DISTINCT t.user_pseudo_id
  FROM   `firebase-public-project.analytics_153293282.events_*` t
  WHERE  _TABLE_SUFFIX BETWEEN '20180716' AND '20180730'
    AND  t.event_name LIKE 'quickplay%'
)
SELECT c.quickplay_type,
       COUNT(DISTINCT c.user_pseudo_id) AS retained_users
FROM   cohort c
JOIN   returns r
  ON   r.user_pseudo_id = c.user_pseudo_id
GROUP BY c.quickplay_type
LIMIT 20;
```

```sql
-- 🔟 Description: FINAL – 2‑Week Retention Rate per quick‑play type for users who had a session_start between 2‑Jul‑2018 and 16‑Jul‑2018
WITH session_users AS (   -- users that opened the app in the window
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
),
cohort AS (              -- first quick‑play for those users
  SELECT su.user_pseudo_id,
         ( SELECT ep.value.string_value
           FROM UNNEST(t.event_params) ep
           WHERE ep.key = 'quickplay_event_type') AS quickplay_type
  FROM   `firebase-public-project.analytics_153293282.events_*` t
  JOIN   session_users su
    ON   su.user_pseudo_id = t.user_pseudo_id
  WHERE  t._TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND  t.event_name LIKE 'quickplay%'
  GROUP BY su.user_pseudo_id, quickplay_type
),
returns AS (             -- any quick‑play 14 days (or later) afterwards
  SELECT DISTINCT user_pseudo_id
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20180716' AND '20180730'
    AND  event_name LIKE 'quickplay%'
)
SELECT c.quickplay_type,
       COUNT(DISTINCT c.user_pseudo_id)            AS cohort_users,
       COUNT(DISTINCT r.user_pseudo_id)            AS retained_users,
       SAFE_DIVIDE(COUNT(DISTINCT r.user_pseudo_id),
                   COUNT(DISTINCT c.user_pseudo_id)) AS retention_rate_2w
FROM   cohort c
LEFT JOIN returns r
       ON r.user_pseudo_id = c.user_pseudo_id
GROUP BY c.quickplay_type
LIMIT 20;
```

Each successive query builds knowledge—from discovering the quick‑play events and their parameters, to isolating the cohort, measuring 14‑day return behaviour, and finally providing the requested retention rate per quick‑play event type.
