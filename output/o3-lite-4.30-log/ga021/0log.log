--   4) Return the unique list of these base names; LIMIT 20 for a quick glance.
SELECT DISTINCT
  REGEXP_REPLACE(event_name, r'_quickplay$', '') AS quickplay_type
FROM `firebase-public-project.analytics_153293282.events_201807*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND LOWER(event_name) LIKE '%_quickplay'
LIMIT 20;
