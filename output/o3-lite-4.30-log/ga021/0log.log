```sql
-- 10. Description: FINAL – Retention rate 14‑day (two‑week) per quick‑play type
WITH first_qp AS (
  /* cohort: earliest quick‑play per user/type between 02‑Jul & 16‑Jul 2018 */
  SELECT
      user_pseudo_id,
      MIN(DATE(event_date))                           AS first_quickplay_date,
      ep.value.string_value                           AS qp_type
  FROM  `firebase-public-project.analytics_153293282.events_201807*`,
        UNNEST(event_params) AS ep
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'quickplay'
    AND ep.key = 'quickplay_type'
  GROUP BY user_pseudo_id, qp_type
),
cohort_size AS (
  SELECT qp_type,
         COUNT(DISTINCT user_pseudo_id) AS users_in_cohort
  FROM   first_qp
  GROUP  BY qp_type
),
retained AS (
  SELECT
      f.qp_type,
      COUNT(DISTINCT f.user_pseudo_id) AS users_retained
  FROM  first_qp   AS f
  JOIN  `firebase-public-project.analytics_153293282.events_201807*` AS e
        ON  e.user_pseudo_id = f.user_pseudo_id
  WHERE DATE(e.event_date) = DATE_ADD(f.first_quickplay_date, INTERVAL 14 DAY)
    AND e.event_name = 'session_start'
  GROUP BY f.qp_type
)
SELECT
    c.qp_type,
    c.users_in_cohort,
    r.users_retained,
    SAFE_DIVIDE(r.users_retained, c.users_in_cohort) AS retention_rate_14d
FROM  cohort_size AS c
LEFT JOIN retained    AS r USING (qp_type)
LIMIT 20;
```

