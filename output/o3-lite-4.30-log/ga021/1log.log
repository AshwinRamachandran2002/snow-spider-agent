Begin Exploring Related Columns
Below is a list of the columns that will be useful for a 2‑week‑retention calculation together with their “potential usage” and typical filter / join conditions you will need later.

event_date            : cohort filter “between 20180702 and 20180716”; create the 14‑day‐later date; join to later events  
event_name            : identify the cohort event (quick‑play), the qualifying session (“session_start”) and the return events  
event_timestamp       : optional – finer time‑difference checks if two events happen on the same calendar day  
user_pseudo_id        : user id used to build the cohort and to look for the same user 14 days later  
event_params          : extract the concrete quick‑play type (e.g. ‘quickplay_event_type’, ‘mode’, etc.)  
_TABLE_SUFFIX         : pseudo‑column when a wildcard table is used – limit tables that are scanned  
(others)              : no other columns are required for a basic N‑day retention query  

Typical conditions you will use repeatedly
• _TABLE_SUFFIX BETWEEN '20180702' AND '20180716' ‑‑ initial cohort  
• _TABLE_SUFFIX BETWEEN '20180716' AND '20180730' ‑‑ look for return events (day‑14 lies in that range)  
• event_name = 'quickplay' (or LIKE '%quickplay%')  
• event_name = 'session_start'  
• p.key   = 'quickplay_event_type' (or the correct key once identified)  


Ten step‑by‑step queries  
(Every query ends with LIMIT 20 so you can run them safely; remove the limits once you are happy.)

```sql
-- 1. Distinct event names (2–16 July 2018)
-- Description: discover which event names mention quick‑play.
SELECT DISTINCT event_name
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
ORDER BY 1
LIMIT 20;
```

```sql
-- 2. Sample rows of raw event_params for any quick‑play event on 2 July
-- Description: inspect the nested structure to find the parameter that carries the “quick‑play type”.
SELECT event_name,
       event_params
FROM `firebase-public-project.analytics_153293282.events_20180702`
WHERE LOWER(event_name) LIKE '%quickplay%'
LIMIT 20;
```

```sql
-- 3. Distinct keys present inside event_params for quick‑play events (2–16 July)
-- Description: list all parameter keys; helps confirm which one stores the type.
SELECT DISTINCT p.key
FROM `firebase-public-project.analytics_153293282.events_*`,
     UNNEST(event_params) AS p
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND LOWER(event_name) LIKE '%quickplay%'
ORDER BY 1
LIMIT 20;
```

```sql
-- 4. Distinct quick‑play types using the suspected key
-- Description: replace 'quickplay_event_type' with the key found in step 3 if different.
SELECT DISTINCT p.value.string_value  AS quickplay_type
FROM `firebase-public-project.analytics_153293282.events_*`,
     UNNEST(event_params) AS p
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND event_name = 'quickplay'
  AND p.key = 'quickplay_event_type'
LIMIT 20;
```

```sql
-- 5. Users that triggered each quick‑play type (2–16 July)
-- Description: cohort size by type.
SELECT p.value.string_value                 AS quickplay_type,
       COUNT(DISTINCT user_pseudo_id)       AS users_in_cohort
FROM `firebase-public-project.analytics_153293282.events_*`,
     UNNEST(event_params) AS p
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND event_name = 'quickplay'
  AND p.key = 'quickplay_event_type'
GROUP BY quickplay_type
ORDER BY users_in_cohort DESC
LIMIT 20;
```

```sql
-- 6. First quick‑play date per user (cohort between 2–16 Jul)
-- Description: find the initial quickplay date; needed to add 14 days later.
SELECT user_pseudo_id,
       MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_qp_date
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND event_name = 'quickplay'
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
-- 7. First quick‑play date + its type per user
-- Description: adds the quickplay_type column to previous result.
WITH cohort AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS first_ts
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND  event_name = 'quickplay'
  GROUP BY user_pseudo_id
)
SELECT c.user_pseudo_id,
       p.value.string_value AS quickplay_type,
       PARSE_DATE('%Y%m%d', e.event_date) AS first_qp_date
FROM cohort      AS c
JOIN `firebase-public-project.analytics_153293282.events_*`  e
  ON e.user_pseudo_id = c.user_pseudo_id
 AND e.event_timestamp = c.first_ts
JOIN UNNEST(e.event_params) AS p
WHERE p.key = 'quickplay_event_type'
LIMIT 20;
```

```sql
-- 8. Did the user have ANY session_start exactly 14 days later?
-- Description: flag retained users (0/1) per quickplay_type.
WITH cohort AS (
  SELECT user_pseudo_id,
         PARSE_DATE('%Y%m%d', MIN(event_date)) AS first_qp_date,
         (SELECT p.value.string_value FROM UNNEST(event_params) AS p
           WHERE p.key = 'quickplay_event_type' LIMIT 1) AS quickplay_type
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'quickplay'
  GROUP BY user_pseudo_id
)
SELECT c.quickplay_type,
       COUNT(DISTINCT c.user_pseudo_id)                     AS cohort_size,
       COUNT(DISTINCT s.user_pseudo_id)                     AS retained_users
FROM cohort c
LEFT JOIN `firebase-public-project.analytics_153293282.events_*` s
  ON s.user_pseudo_id = c.user_pseudo_id
 AND s.event_name      = 'session_start'
 AND PARSE_DATE('%Y%m%d', s.event_date)
     = DATE_ADD(c.first_qp_date, INTERVAL 14 DAY)
WHERE _TABLE_SUFFIX BETWEEN '20180716' AND '20180730'
GROUP BY c.quickplay_type
LIMIT 20;
```

```sql
-- 9. Retention rate two weeks later per quick‑play type (float)
-- Description: compute rate = retained / cohort.
WITH cohort AS (
  SELECT user_pseudo_id,
         PARSE_DATE('%Y%m%d', MIN(event_date)) AS first_qp_date,
         (SELECT p.value.string_value FROM UNNEST(event_params) AS p
           WHERE p.key = 'quickplay_event_type' LIMIT 1) AS quickplay_type
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'quickplay'
  GROUP BY user_pseudo_id
),
ret AS (
  SELECT c.quickplay_type,
         COUNT(DISTINCT c.user_pseudo_id) AS cohort_size,
         COUNT(DISTINCT s.user_pseudo_id) AS retained_users
  FROM cohort c
  LEFT JOIN `firebase-public-project.analytics_153293282.events_*` s
    ON s.user_pseudo_id = c.user_pseudo_id
   AND s.event_name = 'session_start'
   AND PARSE_DATE('%Y%m%d', s.event_date) = DATE_ADD(c.first_qp_date, INTERVAL 14 DAY)
  WHERE _TABLE_SUFFIX BETWEEN '20180716' AND '20180730'
  GROUP BY c.quickplay_type
)
SELECT quickplay_type,
       cohort_size,
       retained_users,
       SAFE_DIVIDE(retained_users, cohort_size) AS retention_rate_14d
FROM ret
LIMIT 20;
```

```sql
-- 10. (Final answer query) 14‑day retention by quick‑play event type
-- Description: ready for production – remove LIMIT if full result required.
WITH initial_cohort AS (
  SELECT
    user_pseudo_id,
    MIN(event_timestamp)                                        AS first_qp_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'quickplay'
  GROUP BY user_pseudo_id
),
cohort_labeled AS (
  SELECT
    i.user_pseudo_id,
    PARSE_DATE('%Y%m%d', e.event_date)                          AS first_qp_date,
    (SELECT p.value.string_value FROM UNNEST(e.event_params) p
      WHERE p.key = 'quickplay_event_type' LIMIT 1)             AS quickplay_type
  FROM initial_cohort i
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = i.user_pseudo_id
   AND e.event_timestamp = i.first_qp_ts
),
retention AS (
  SELECT
    c.quickplay_type,
    COUNT(DISTINCT c.user_pseudo_id)                            AS cohort_size,
    COUNT(DISTINCT r.user_pseudo_id)                            AS retained_users
  FROM cohort_labeled c
  LEFT JOIN `firebase-public-project.analytics_153293282.events_*` r
    ON r.user_pseudo_id = c.user_pseudo_id
   AND r.event_name     = 'session_start'
   AND PARSE_DATE('%Y%m%d', r.event_date)
       = DATE_ADD(c.first_qp_date, INTERVAL 14 DAY)
  WHERE _TABLE_SUFFIX BETWEEN '20180716' AND '20180730'
  GROUP BY c.quickplay_type
)
SELECT
  quickplay_type,
  cohort_size,
  retained_users,
  SAFE_DIVIDE(retained_users, cohort_size)                      AS retention_rate_14d
FROM retention
ORDER BY quickplay_type
LIMIT 20;
```

