```sql
--Description: Calculate 14‑day user retention for each quick‑play “board” type.
--             • Step 1: Pull all events whose name includes “quickplay” during the
--               cohort window (2 Jul – 16 Jul 2018).  Extract the board label from
--               event_params and rank events per user by timestamp.
--             • Step 2: Keep only the earliest quick‑play event (rn = 1) to define
--               the user’s cohort date and board type.
--             • Step 3: Join that cohort to any `session_start` event that occurs
--               exactly 14 days later (16 Jul – 30 Jul 2018).  Count cohort size,
--               retained users, and compute the retention rate.
WITH quickplays AS (
  SELECT
    user_pseudo_id,
    PARSE_DATE('%Y%m%d', event_date) AS qp_date,
    event_timestamp,
    (SELECT p.value.string_value
       FROM UNNEST(event_params) p
      WHERE p.key = 'board'
      LIMIT 1)                       AS board_type,
    ROW_NUMBER() OVER (PARTITION BY user_pseudo_id
                       ORDER BY event_timestamp) AS rn
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
),
cohort AS (
  SELECT
    user_pseudo_id,
    qp_date          AS first_qp_date,
    board_type
  FROM quickplays
  WHERE rn = 1   -- first quick‑play for each user
)
SELECT
  board_type                            AS quickplay_type,
  COUNT(DISTINCT c.user_pseudo_id)      AS cohort_size,
  COUNT(DISTINCT s.user_pseudo_id)      AS retained_users,
  SAFE_DIVIDE(COUNT(DISTINCT s.user_pseudo_id),
              COUNT(DISTINCT c.user_pseudo_id)) AS retention_rate_14d
FROM cohort c
LEFT JOIN `firebase-public-project.analytics_153293282.events_*` s
  ON s.user_pseudo_id = c.user_pseudo_id
 AND s.event_name     = 'session_start'
 AND PARSE_DATE('%Y%m%d', s.event_date)
     = DATE_ADD(c.first_qp_date, INTERVAL 14 DAY)
WHERE _TABLE_SUFFIX BETWEEN '20180716' AND '20180730'
GROUP BY board_type
ORDER BY cohort_size DESC
LIMIT 20;
```
