--Description:  Query #9  – Compute cohort size, retained users, and 14‑day
--               retention RATE for every quick‑play “board” type by
--               1) collecting all quick‑play events (2–16 Jul 2018),
--               2) keeping the FIRST quick‑play per user (cohort),
--               3) joining to `session_start` events exactly 14 days later
--                  (16–30 Jul 2018), and
--               4) producing cohort_size, retained_users, and retention_rate.
WITH quickplays AS (
  SELECT
    user_pseudo_id,
    PARSE_DATE('%Y%m%d', event_date) AS qp_date,
    event_timestamp,
    ( SELECT p.value.string_value
        FROM UNNEST(event_params) p
       WHERE p.key = 'board'
       LIMIT 1)                       AS board_type,
    ROW_NUMBER() OVER (PARTITION BY user_pseudo_id
                       ORDER BY event_timestamp) AS rn
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
),
cohort AS (
  SELECT
    user_pseudo_id,
    qp_date      AS first_qp_date,
    board_type   AS quickplay_type
  FROM quickplays
  WHERE rn = 1                    -- first quick‑play only
),
ret AS (
  SELECT
    c.quickplay_type,
    COUNT(DISTINCT c.user_pseudo_id) AS cohort_size,
    COUNT(DISTINCT s.user_pseudo_id) AS retained_users
  FROM cohort c
  LEFT JOIN `firebase-public-project.analytics_153293282.events_*` s
    ON  s.user_pseudo_id = c.user_pseudo_id
    AND s.event_name     = 'session_start'
    AND PARSE_DATE('%Y%m%d', s.event_date)
        = DATE_ADD(c.first_qp_date, INTERVAL 14 DAY)
  WHERE _TABLE_SUFFIX BETWEEN '20180716' AND '20180730'
  GROUP BY c.quickplay_type
)
SELECT
  quickplay_type,
  cohort_size,
  retained_users,
