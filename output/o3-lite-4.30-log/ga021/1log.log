  FROM cohort c
  LEFT JOIN `firebase-public-project.analytics_153293282.events_*` r
    ON  r.user_pseudo_id = c.user_pseudo_id
    AND r.event_name     = 'session_start'
    AND PARSE_DATE('%Y%m%d', r.event_date)
        = DATE_ADD(c.first_qp_date, INTERVAL 14 DAY)
  WHERE _TABLE_SUFFIX BETWEEN '20180716' AND '20180730'
  GROUP BY c.quickplay_type
)
SELECT
  quickplay_type,
  cohort_size,
  retained_users,
  SAFE_DIVIDE(retained_users, cohort_size) AS retention_rate_14d
FROM retention
ORDER BY cohort_size DESC
LIMIT 20
