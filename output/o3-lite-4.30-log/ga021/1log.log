--             before calculating 14‑day retention.
SELECT DISTINCT
       p.key                                                        AS param_key,
       COALESCE( p.value.string_value,
                 CAST(p.value.int_value    AS STRING),
                 CAST(p.value.float_value  AS STRING),
                 CAST(p.value.double_value AS STRING) )             AS param_value
FROM  `firebase-public-project.analytics_153293282.events_*`
CROSS JOIN UNNEST(event_params) AS p
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND LOWER(event_name) LIKE '%quickplay%'
