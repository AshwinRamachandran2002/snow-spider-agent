Begin Exploring Related Columns
column name : potential usage  
• “content” (GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS) : holds the raw file text in which we can search for Go / Python‑like multi‑line import blocks (import (…) ).  
• “sample_repo_name” (same table) : helps discover in which repositories the import blocks occur so we can later aggregate by repository if desired.  
• “binary” (same table) : a quick filter to ignore compiled or other non‑text artefacts (binary = FALSE).  
• “size” (same table) : an optional guardrail to avoid scanning extremely small / empty blobs.  

Below are ten exploratory Snowflake SQL snippets, starting from very simple inspection and gradually adding extraction, splitting, aggregation, and ordering.  Every statement is wrapped in a comment that explains what it does.  Column names are always enclosed in double quotes, and each query returns at most 20 rows so you can safely preview the data.

```sql
-- 1. Quick look at a few source files that contain the string 'import ('.
SELECT 
    "sample_repo_name",
    "sample_path",
    LEFT("content", 300) AS "content_preview"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
WHERE "binary" = FALSE
  AND "content" ILIKE '%import (%'
LIMIT 20;
```

```sql
-- 2. Show only the distinct repositories where multi‑line imports appear.
SELECT DISTINCT 
    "sample_repo_name"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
WHERE "binary" = FALSE
  AND "content" ILIKE '%import (%'
LIMIT 20;
```

```sql
-- 3. Pull out the exact multi‑line import blocks (text between 'import (' and the next ')').
SELECT 
    "sample_repo_name",
    REGEXP_SUBSTR("content", 'import \\([\\s\\S]*?\\)', 1, 1, 'n') AS "import_block"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
WHERE "binary" = FALSE
  AND "content" ILIKE '%import (%'
LIMIT 20;
```

```sql
-- 4. Split multi‑line import blocks into individual lines with LATERAL FLATTEN on SPLIT.
SELECT 
    c."sample_repo_name",
    TRIM(f.value) AS "one_import_line"
FROM (
    SELECT 
        "sample_repo_name",
        REGEXP_SUBSTR("content", 'import \\([\\s\\S]*?\\)', 1, 1, 'n') AS "import_block"
    FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
    WHERE "binary" = FALSE
      AND "content" ILIKE '%import (%'
) c,
LATERAL FLATTEN(input => SPLIT(c."import_block", '\n')) f
LIMIT 20;
```

```sql
-- 5. Filter to keep only the lines that contain a double‑quoted path.
SELECT 
    TRIM(f.value) AS "import_line_with_quotes"
FROM (
    SELECT 
        REGEXP_SUBSTR("content", 'import \\([\\s\\S]*?\\)', 1, 1, 'n') AS "import_block"
    FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
    WHERE "binary" = FALSE
      AND "content" ILIKE '%import (%'
) s,
LATERAL FLATTEN(input => SPLIT(s."import_block", '\n')) f
WHERE f.value ILIKE '%"%'
LIMIT 20;
```

```sql
-- 6. Extract the package string that sits inside the first pair of double quotes.
SELECT 
    REGEXP_SUBSTR(TRIM(f.value), '"([^"]+)"', 1, 1, 'e') AS "package_raw"
FROM (
    SELECT 
        REGEXP_SUBSTR("content", 'import \\([\\s\\S]*?\\)', 1, 1, 'n') AS "import_block"
    FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
    WHERE "binary" = FALSE
      AND "content" ILIKE '%import (%'
) b,
LATERAL FLATTEN(input => SPLIT(b."import_block", '\n')) f
WHERE f.value ILIKE '%"%'
LIMIT 20;
```

```sql
-- 7. Remove the surrounding double quotes so the column holds only the bare package name.
SELECT 
    REPLACE(REGEXP_SUBSTR(TRIM(f.value), '"([^"]+)"', 1, 1, 'e'), '"', '') AS "package_name"
FROM (
    SELECT 
        REGEXP_SUBSTR("content", 'import \\([\\s\\S]*?\\)', 1, 1, 'n') AS "import_block"
    FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
    WHERE "binary" = FALSE
      AND "content" ILIKE '%import (%'
) q,
LATERAL FLATTEN(input => SPLIT(q."import_block", '\n')) f
WHERE f.value ILIKE '%"%'
LIMIT 20;
```

```sql
-- 8. Count how many times each package appears (unfiltered count, still limited for preview).
SELECT 
    REPLACE(REGEXP_SUBSTR(TRIM(f.value), '"([^"]+)"', 1, 1, 'e'), '"', '') AS "package_name",
    COUNT(*) AS "occurrences"
FROM (
    SELECT 
        REGEXP_SUBSTR("content", 'import \\([\\s\\S]*?\\)', 1, 1, 'n') AS "import_block"
    FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
    WHERE "binary" = FALSE
      AND "content" ILIKE '%import (%'
) v,
LATERAL FLATTEN(input => SPLIT(v."import_block", '\n')) f
WHERE f.value ILIKE '%"%'
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 9. Same as #8 but exclude any rows where REGEXP returned NULL and still preview 20 rows.
SELECT 
    "package_name",
    "occurrences"
FROM (
    SELECT 
        REPLACE(REGEXP_SUBSTR(TRIM(f.value), '"([^"]+)"', 1, 1, 'e'), '"', '') AS "package_name",
        COUNT(*) AS "occurrences"
    FROM (
        SELECT 
            REGEXP_SUBSTR("content", 'import \\([\\s\\S]*?\\)', 1, 1, 'n') AS "import_block"
        FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
        WHERE "binary" = FALSE
          AND "content" ILIKE '%import (%'
    ) w,
    LATERAL FLATTEN(input => SPLIT(w."import_block", '\n')) f
    WHERE f.value ILIKE '%"%'
    GROUP BY 1
) 
WHERE "package_name" IS NOT NULL
ORDER BY "occurrences" DESC
LIMIT 20;
```

```sql
-- 10. (Final style) Pull the top‑10 most frequently used packages across the whole sample.
SELECT 
    "package_name",
    "occurrences"
FROM (
    SELECT 
        REPLACE(REGEXP_SUBSTR(TRIM(f.value), '"([^"]+)"', 1, 1, 'e'), '"', '') AS "package_name",
        COUNT(*) AS "occurrences"
    FROM (
        SELECT 
            REGEXP_SUBSTR("content", 'import \\([\\s\\S]*?\\)', 1, 1, 'n') AS "import_block"
        FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
        WHERE "binary" = FALSE
          AND "content" ILIKE '%import (%'
    ) r,
    LATERAL FLATTEN(input => SPLIT(r."import_block", '\n')) f
    WHERE f.value ILIKE '%"%'
    GROUP BY 1
) 
WHERE "package_name" IS NOT NULL
ORDER BY "occurrences" DESC
LIMIT 10;
```

These ten queries progressively explore and refine the data until they yield the desired ranking of package names (still limited to 10 rows). You can run them in order, adjusting filters or limits as needed, to ensure each intermediate step behaves as expected before relying on the final result.
