```sql
--Description: Extract every double‑quoted import target from parenthesised “import ( … )” blocks,
--count how often each package string appears across the sample contents, drop NULLs,
--and return the 20 most frequent packages.  We order by the second output column
--(the count) to avoid alias‑resolution issues that caused the earlier error.
SELECT
    pkg_name,
    COUNT(*) AS cnt
FROM (
    --Pull out one potential package name per line that sits inside an import block
    SELECT
        REGEXP_SUBSTR(TRIM(line.value), '"([^"]+)"', 1, 1, 'e', 1) AS pkg_name
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
         LATERAL SPLIT_TO_TABLE(
             TRIM(
                 SPLIT_PART(
                     SUBSTR(
                         t."content",
                         POSITION('import (' IN t."content") + 8,   -- start after “import (”
                         1000                                        -- read enough chars to cover the block
                     ),
                     ')',                                           -- stop at first “)”
                     1
                 )
             ),
             '\n'                                                   -- split inner block into lines
         ) line
    WHERE t."content" ILIKE '%import (%'                            -- ensure file contains an import block
      AND line.value ILIKE '%"%"%'                                  -- keep lines with double‑quoted strings
) sub
WHERE pkg_name IS NOT NULL
GROUP BY pkg_name
ORDER BY 2 DESC                                                      -- 2nd column = cnt
LIMIT 20;
```
