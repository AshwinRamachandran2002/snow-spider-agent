```sql
--Description: Final query – extract double‑quoted paths from parenthesised import blocks,
--strip the quotes, count how often each package appears across all files, and return
--the 10 most frequent packages in descending order of their counts.  Ordering uses
--column position 2 to avoid alias‑resolution problems.
SELECT
    pkg_name,
    COUNT(*) AS cnt
FROM (
    SELECT
        REGEXP_REPLACE(
            REGEXP_SUBSTR(TRIM(line.value), '"([^"]+)"', 1, 1, 'e', 1),
            '"',
            ''
        ) AS pkg_name
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
         LATERAL SPLIT_TO_TABLE(
             TRIM(
                 SPLIT_PART(
                     SUBSTR(
                         t."content",
                         POSITION('import (' IN t."content") + 8,   -- start after “import (”
                         1000                                        -- length large enough for typical block
                     ),
                     ')',                                           -- stop at first “)”
                     1
                 )
             ),
             '\n'                                                   -- split inner block into individual lines
         ) line
    WHERE t."content" ILIKE '%import (%'                            -- ensure file has an import block
      AND line.value ILIKE '%"%"%'                                  -- keep lines containing quotes
) sub
WHERE pkg_name IS NOT NULL
GROUP BY pkg_name
ORDER BY 2 DESC      -- column 2 = cnt
LIMIT 10;
```
