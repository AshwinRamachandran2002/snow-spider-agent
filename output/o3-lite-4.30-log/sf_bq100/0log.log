--after that marker, pull a 1 000‑character slice, then cut at the first ‘)’ so we keep
--only the lines that reside inside the parenthesised import list.  Finally TRIM
--leading/trailing whitespace so we can inspect the clean inner block.
SELECT
    "sample_repo_name",
    TRIM(
        SPLIT_PART(
            SUBSTR("content", POSITION('import (' IN "content") + 8, 1000),
            ')',
            1
        )
    ) AS "imports_inside"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE "content" ILIKE '%import (%'
LIMIT 20;
