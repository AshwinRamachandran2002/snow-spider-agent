Begin Exploring Related Columns
Relevant columns and their potential usage  
• SAMPLE_CONTENTS."content":  scan the text of every stored source file for patterns that look like Go‑style multi‑line imports (import ( … )).  
• SAMPLE_CONTENTS."sample_path":  optional filter to restrict the search to Go files (WHERE "sample_path" ILIKE '%.go').  
• SAMPLE_CONTENTS."id":  technical key – useful only when we want to join to other tables (e.g. SAMPLE_FILES) for additional file meta‑data.  

Typical conditions  
• "content" ILIKE '%import (%'                                  – find files that actually contain a parenthesised import block.  
• "sample_path" ILIKE '%.go'                                    – ignore non‑Go files.  
• TRIM('"' FROM <string>) IS NOT NULL                           – discard null / empty package names after we strip the quotes.  


Below are ten Snowflake SQL snippets, moving from very simple exploration to a complete query that returns the requested “Top‑10” list.  All column names are enclosed in double quotes as required; each query is limited to 20 rows so you can run them safely.

```sql
-- 1. Preview a handful of raw file contents
SELECT "sample_repo_name", "sample_path", LEFT("content", 200) AS "snippet"
FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
LIMIT  20;
```

```sql
-- 2. Show a few Go files only (.go extension)
SELECT "sample_repo_name", "sample_path"
FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE  "sample_path" ILIKE '%.go'
LIMIT  20;
```

```sql
-- 3. Look for files that contain the text “import (”
SELECT "sample_repo_name", "sample_path"
FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE  "content" ILIKE '%import (%'
LIMIT  20;
```

```sql
-- 4. Grab the whole parenthesised import block (first match only)
SELECT "sample_repo_name",
       REGEXP_SUBSTR("content", 'import\\s*\\(([^)]*)\\)', 1, 1, 'e', 1) AS "imports_block"
FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE  "content" ILIKE '%import (%'
LIMIT  20;
```

```sql
-- 5. Split the import block into an array of individual lines
WITH t AS (
  SELECT REGEXP_SUBSTR("content", 'import\\s*\\(([^)]*)\\)', 1, 1, 'e', 1) AS "imports_block"
  FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
  WHERE  "content" ILIKE '%import (%'
)
SELECT SPLIT("imports_block", '\n') AS "lines"
FROM   t
LIMIT  20;
```

```sql
-- 6. Flatten those lines to one row per line
WITH t AS (
  SELECT REGEXP_SUBSTR("content", 'import\\s*\\(([^)]*)\\)', 1, 1, 'e', 1) AS "imports_block"
  FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
  WHERE  "content" ILIKE '%import (%'
)
SELECT f.VALUE::STRING AS "import_line"
FROM   t,
       LATERAL FLATTEN(input => SPLIT("imports_block", '\n')) f
WHERE  f.VALUE IS NOT NULL
LIMIT  20;
```

```sql
-- 7. Extract the part that sits inside double quotes
WITH t AS (
  SELECT REGEXP_SUBSTR("content", 'import\\s*\\(([^)]*)\\)', 1, 1, 'e', 1) AS "imports_block"
  FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
  WHERE  "content" ILIKE '%import (%'
),
lines AS (
  SELECT f.VALUE::STRING AS "import_line"
  FROM   t, LATERAL FLATTEN(input => SPLIT("imports_block", '\n')) f
)
SELECT REGEXP_SUBSTR("import_line", '"([^"]+)"', 1, 1, 'e', 1) AS "raw_pkg"
FROM   lines
WHERE  "raw_pkg" IS NOT NULL
LIMIT  20;
```

```sql
-- 8. Remove the quotation marks and discard blanks
WITH t AS (
  SELECT REGEXP_SUBSTR("content", 'import\\s*\\(([^)]*)\\)', 1, 1, 'e', 1) AS "imports_block"
  FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
  WHERE  "content" ILIKE '%import (%'
),
lines AS (
  SELECT f.VALUE::STRING AS "import_line"
  FROM   t, LATERAL FLATTEN(input => SPLIT("imports_block", '\n')) f
),
pkgs AS (
  SELECT TRIM('"', REGEXP_SUBSTR("import_line", '"([^"]+)"', 1, 1, 'e', 1)) AS "pkg"
  FROM   lines
)
SELECT DISTINCT "pkg"
FROM   pkgs
WHERE  "pkg" IS NOT NULL
LIMIT  20;
```

```sql
-- 9. Count how often every package is imported (no ordering yet)
WITH t AS (
  SELECT REGEXP_SUBSTR("content", 'import\\s*\\(([^)]*)\\)', 1, 1, 'e', 1) AS "imports_block"
  FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
  WHERE  "content" ILIKE '%import (%'
),
lines AS (
  SELECT f.VALUE::STRING AS "import_line"
  FROM   t, LATERAL FLATTEN(input => SPLIT("imports_block", '\n')) f
),
pkgs AS (
  SELECT TRIM('"', REGEXP_SUBSTR("import_line", '"([^"]+)"', 1, 1, 'e', 1)) AS "pkg"
  FROM   lines
  WHERE  "import_line" IS NOT NULL
)
SELECT "pkg", COUNT(*) AS "pkg_count"
FROM   pkgs
WHERE  "pkg" IS NOT NULL
GROUP  BY "pkg"
LIMIT  20;
```

```sql
-- 10. Final answer: Top‑10 most frequently imported packages (quotes removed)
WITH imports AS (
  SELECT REGEXP_SUBSTR("content", 'import\\s*\\(([^)]*)\\)', 1, 1, 'e', 1) AS "imports_block"
  FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
  WHERE  "content" ILIKE '%import (%'
),
lines AS (
  SELECT f.VALUE::STRING AS "import_line"
  FROM   imports,
       LATERAL FLATTEN(input => SPLIT("imports_block", '\n')) f
),
pkgs AS (
  SELECT TRIM('"', REGEXP_SUBSTR("import_line", '"([^"]+)"', 1, 1, 'e', 1)) AS "pkg"
  FROM   lines
  WHERE  "import_line" IS NOT NULL
),
counts AS (
  SELECT "pkg", COUNT(*) AS "frequency"
  FROM   pkgs
  WHERE  "pkg" IS NOT NULL
  GROUP  BY "pkg"
)
SELECT "pkg", "frequency"
FROM   counts
ORDER  BY "frequency" DESC
LIMIT  10;
```

