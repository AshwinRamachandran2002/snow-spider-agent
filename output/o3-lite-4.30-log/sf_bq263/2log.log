--Description: 10) Final‑style report with profit and profit‑to‑cost ratio for each 2023 month.
SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))                AS "month",
       SUM(oi."sale_price")                                                     AS "total_sales",
       SUM(p."cost")                                                            AS "total_cost",
       COUNT(DISTINCT oi."order_id")                                            AS "num_complete_orders",
       SUM(oi."sale_price" - p."cost")                                          AS "total_profit",
       CASE WHEN SUM(p."cost") = 0 THEN NULL
