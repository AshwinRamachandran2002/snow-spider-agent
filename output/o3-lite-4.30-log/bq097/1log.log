  WHERE Year = '2017-01-01' AND GeoName LIKE '%, MA'
)
SELECT y17.GeoFIPS,
       y17.GeoName,
       y12.earnings2012,
       y17.earnings2017,
       (y17.earnings2017 - y12.earnings2012)     AS earnings_increase
FROM yr2012 y12
JOIN yr2017 y17 USING (GeoFIPS)
ORDER BY y17.GeoName
LIMIT 20;
