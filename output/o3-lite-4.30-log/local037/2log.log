```sql
--Description / Thinking process:
-- We need the three product categories whose single most‑popular payment type
-- generated the greatest number of payments overall.  Steps:
-- 1) Join payments → order_items → products to count payments for every
--    (product_category_name, payment_type) pair.  Also pull the English name by
--    LEFT JOINing the translation table (helps readability, but grouping still
--    uses the original category).
-- 2) For each category, rank its payment types by COUNT(*) using ROW_NUMBER;
--    keep rn = 1 ⇒ the dominant payment_type of that category.
-- 3) Sort the surviving rows by num_payments DESC and take the top three.

WITH category_payment_counts AS (
    SELECT
        p.product_category_name,
        COALESCE(t.product_category_name_english,
                 p.product_category_name)        AS category_english,
        op.payment_type,
        COUNT(*)                              AS num_payments
    FROM olist_order_payments  AS op
    JOIN olist_order_items     AS oi ON op.order_id = oi.order_id
    JOIN olist_products        AS p  ON oi.product_id = p.product_id
    LEFT JOIN product_category_name_translation AS t
           ON p.product_category_name = t.product_category_name
    GROUP BY p.product_category_name,
             op.payment_type
),
ranked AS (
    SELECT
        product_category_name,
        category_english,
        payment_type,
        num_payments,
        ROW_NUMBER() OVER (
            PARTITION BY product_category_name
            ORDER BY num_payments DESC
        ) AS rn
    FROM category_payment_counts
)
SELECT
    category_english   AS product_category,
    payment_type,
    num_payments
FROM ranked
WHERE rn = 1                -- keep each category's dominant payment_type
ORDER BY num_payments DESC  -- rank categories by how many payments that type got
LIMIT 3;
```
