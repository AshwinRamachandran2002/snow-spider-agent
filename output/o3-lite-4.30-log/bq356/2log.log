Begin Exploring Related Columns
Relevant columns and why we need them  
usaf (stations):           join key to daily data (same as stn)  
wban (stations / gsod2019): secondary join key, prevents collisions  
begin (stations):           filter stations that were already active on 2000‑01‑01 or earlier (begin ≤ ‘20000101’)  
end (stations):             filter stations that were still active on 2019‑06‑30 or later (end ≥ ‘20190630’)  
year (gsod2019):            confirm all rows are 2019 (constant in this table)  
mo, da (gsod2019):          help form the calendar date if needed (not strictly required for the count)  
temp, max, min (gsod2019):  test for “valid” temperature rows (≠ 9999.9)  
stn (gsod2019):             join key to stations (same as usaf)  

Key conditions we will use  
stations.begin  <= ‘20000101’  
stations.end   >= ‘20190630’  
gsod2019.temp != 9999.9 AND max != 9999.9 AND min != 9999.9  
valid_day_cnt ≥ 0.9 * 365  (i.e., ≥ 329)  

Below are 10 progressively more complex SQL queries (all BigQuery‑standard SQL).  
Each one is prefaced by a short comment and capped with LIMIT 20 to satisfy the exercise requirement.

```sql
-- 1) Quick look at the stations master table
SELECT *
FROM `bigquery-public-data.noaa_gsod.stations`
LIMIT 20;
```

```sql
-- 2) Quick look at the 2019 daily data
SELECT *
FROM `bigquery-public-data.noaa_gsod.gsod2019`
LIMIT 20;
```

```sql
-- 3) Stations whose period of record already spans the target time window
SELECT usaf, wban, begin, `end`
FROM `bigquery-public-data.noaa_gsod.stations`
WHERE begin <= '20000101'            -- started by 1‑Jan‑2000 or earlier
  AND `end`  >= '20190630'           -- still operating at least through 30‑Jun‑2019
LIMIT 20;
```

```sql
-- 4) Sample of “valid” 2019 daily rows (non‑missing temp + max + min)
SELECT stn, wban, mo, da, temp, max, min
FROM `bigquery-public-data.noaa_gsod.gsod2019`
WHERE temp != 9999.9
  AND max  != 9999.9
  AND min  != 9999.9
LIMIT 20;
```

```sql
-- 5) Count of valid‑temperature days per station (preview only)
SELECT
  stn        AS usaf,
  wban,
  COUNT(*)   AS valid_days_2019
FROM `bigquery-public-data.noaa_gsod.gsod2019`
WHERE temp != 9999.9
  AND max  != 9999.9
  AND min  != 9999.9
GROUP BY usaf, wban
LIMIT 20;
```

```sql
-- 6) Same as #5 but add a flag for stations reaching ≥329 valid days (90% of 365)
SELECT
  stn        AS usaf,
  wban,
  COUNT(*)                       AS valid_days_2019,
  COUNT(*) >= 329                AS reached_90_pct
FROM `bigquery-public-data.noaa_gsod.gsod2019`
WHERE temp != 9999.9
  AND max  != 9999.9
  AND min  != 9999.9
GROUP BY usaf, wban
LIMIT 20;
```

```sql
-- 7) List of stations that reached the 90 % threshold (no join yet)
SELECT
  stn        AS usaf,
  wban,
  COUNT(*) AS valid_days_2019
FROM `bigquery-public-data.noaa_gsod.gsod2019`
WHERE temp != 9999.9
  AND max  != 9999.9
  AND min  != 9999.9
GROUP BY usaf, wban
HAVING COUNT(*) >= 329
LIMIT 20;
```

```sql
-- 8) Join the threshold list (from #7) with the stations master to enforce the date‑range rule
SELECT
  v.usaf,
  v.wban,
  v.valid_days_2019,
  s.begin,
  s.end
FROM (
  SELECT
    stn AS usaf,
    wban,
    COUNT(*) AS valid_days_2019
  FROM `bigquery-public-data.noaa_gsod.gsod2019`
  WHERE temp != 9999.9
    AND max  != 9999.9
    AND min  != 9999.9
  GROUP BY usaf, wban
  HAVING COUNT(*) >= 329
) AS v
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON v.usaf = s.usaf AND v.wban = s.wban
WHERE s.begin <= '20000101'
  AND s.end   >= '20190630'
LIMIT 20;
```

```sql
-- 9) Same as #8 but keep only the station ID columns (ready for the final count)
SELECT
  v.usaf,
  v.wban
FROM (
  SELECT
    stn AS usaf,
    wban,
    COUNT(*) AS valid_days_2019
  FROM `bigquery-public-data.noaa_gsod.gsod2019`
  WHERE temp != 9999.9
    AND max  != 9999.9
    AND min  != 9999.9
  GROUP BY usaf, wban
  HAVING COUNT(*) >= 329
) AS v
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON v.usaf = s.usaf AND v.wban = s.wban
WHERE s.begin <= '20000101'
  AND s.end   >= '20190630'
LIMIT 20;
```

```sql
-- 10) Final answer: how many stations meet ALL criteria
SELECT COUNT(*) AS num_stations_90pct_or_more
FROM (
  SELECT
    v.usaf,
    v.wban
  FROM (
    /* derive stations with ≥329 valid rows in 2019 */
    SELECT
      stn AS usaf,
      wban,
      COUNT(*) AS valid_days_2019
    FROM `bigquery-public-data.noaa_gsod.gsod2019`
    WHERE temp != 9999.9
      AND max  != 9999.9
      AND min  != 9999.9
    GROUP BY usaf, wban
    HAVING COUNT(*) >= 329          -- 90% of the 365 days in 2019
  ) AS v
  /* join to ensure the station’s record spans the target window */
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON v.usaf = s.usaf AND v.wban = s.wban
  WHERE s.begin <= '20000101'
    AND s.end   >= '20190630'
) 
LIMIT 20;
```

These ten queries, executed in order, take you from basic inspection of the two source tables all the way to the final count of stations that (1) had at least 90 % of the possible valid‑temperature days in 2019 and (2) possessed a period of record spanning 1‑Jan‑2000 through 30‑Jun‑2019.
