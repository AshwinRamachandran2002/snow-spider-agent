--Description: 9. Build a simple histogram of coverage levels among candidate stations
SELECT
  CASE
    WHEN valid_days_2019 >= 329 THEN '≥90%'
    WHEN valid_days_2019 >= 300 THEN '80–<90%'
    WHEN valid_days_2019 >= 200 THEN '55–<80%'
    ELSE '<55%'
  END AS coverage_bucket,
  COUNT(*) AS station_cnt
FROM (
  SELECT
    g.stn,
    g.wban,
    COUNT(*) AS valid_days_2019
  FROM `bigquery-public-data.noaa_gsod.gsod2019` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations`   AS s
    ON g.stn  = s.usaf
   AND g.wban = s.wban
  WHERE s.`begin` <= '20000101'
    AND s.`end`   >= '20190630'
    AND g.temp <> 9999.9
    AND g.max  <> 9999.9
    AND g.min  <> 9999.9
  GROUP BY g.stn, g.wban
)
GROUP BY coverage_bucket
ORDER BY coverage_bucket
