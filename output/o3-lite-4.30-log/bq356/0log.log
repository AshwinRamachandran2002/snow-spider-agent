Relevant tables & columns for the task  

bigquery-public-data.noaa_gsod.stations  
• usaf : joins to gsod2019.stn (station id)  
• wban : joins to gsod2019.wban (secondary id)  
• begin : first date of record – need  begin <= '20000101'  
• end   : last date of record  – need  end  >= '20190630'  

bigquery-public-data.noaa_gsod.gsod2019  
• stn  : station id – join to stations.usaf  
• wban : join partner – join to stations.wban  
• temp : daily mean temperature – want  temp <> 9999.9  
• max  : daily maximum temperature – want  max  <> 9999.9  
• min  : daily minimum temperature – want  min  <> 9999.9  
• year/mo/da : calendar fields – combine to know the day (2019 has 365 days)  

Key conditions we will use  
1. stations.begin  <= '20000101'  
2. stations.end    >= '20190630'  
3. gsod2019.temp <> 9999.9 AND max <> 9999.9 AND min <> 9999.9  
4. Coverage ≥ 0.90 × 365 (= 328.5, so ≥ 329 valid‑day records)  

Below are ten exploratory‑to‑solution SQL queries (each limited to 20 rows except the final “answer” query).  
Replace YOUR_PROJECT if you choose to copy them into your own sandbox.

```sql
-- 1. Description: quick look at a few rows in the stations table
SELECT *
FROM `bigquery-public-data.noaa_gsod.stations`
LIMIT 20;
```

```sql
-- 2. Description: count of all stations in the catalogue
SELECT COUNT(*) AS station_cnt
FROM `bigquery-public-data.noaa_gsod.stations`;
```

```sql
-- 3. Description: stations that started on/before 2000‑01‑01
--    and have records that reach ≥ 2019‑06‑30
SELECT usaf, wban, name, begin, end
FROM `bigquery-public-data.noaa_gsod.stations`
WHERE begin <= '20000101'
  AND end   >= '20190630'
LIMIT 20;
```

```sql
-- 4. Description: look at a few rows in the 2019 daily data
SELECT *
FROM `bigquery-public-data.noaa_gsod.gsod2019`
LIMIT 20;
```

```sql
-- 5. Description: 2019 rows whose temp/max/min are all valid
SELECT stn, wban, mo, da, temp, max, min
FROM `bigquery-public-data.noaa_gsod.gsod2019`
WHERE temp <> 9999.9
  AND max  <> 9999.9
  AND min  <> 9999.9
LIMIT 20;
```

```sql
-- 6. Description: join candidate stations to their 2019 valid rows
SELECT g.stn, g.wban, g.mo, g.da, g.temp, g.max, g.min
FROM `bigquery-public-data.noaa_gsod.gsod2019` AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn  = s.usaf
 AND g.wban = s.wban
WHERE s.begin <= '20000101'
  AND s.end   >= '20190630'
  AND g.temp <> 9999.9
  AND g.max  <> 9999.9
  AND g.min  <> 9999.9
LIMIT 20;
```

```sql
-- 7. Description: number of 2019 valid‑temperature days per station
SELECT g.stn, g.wban,
       COUNT(*) AS valid_days_2019
FROM `bigquery-public-data.noaa_gsod.gsod2019` AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn  = s.usaf
 AND g.wban = s.wban
WHERE s.begin <= '20000101'
  AND s.end   >= '20190630'
  AND g.temp <> 9999.9
  AND g.max  <> 9999.9
  AND g.min  <> 9999.9
GROUP BY g.stn, g.wban
LIMIT 20;
```

```sql
-- 8. Description: add a coverage_pct column (% of 365 valid days)
SELECT stn,
       wban,
       valid_days_2019,
       ROUND(valid_days_2019 / 365.0, 3) AS coverage_pct
FROM (
  SELECT g.stn, g.wban, COUNT(*) AS valid_days_2019
  FROM `bigquery-public-data.noaa_gsod.gsod2019` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn  = s.usaf
   AND g.wban = s.wban
  WHERE s.begin <= '20000101'
    AND s.end   >= '20190630'
    AND g.temp <> 9999.9
    AND g.max  <> 9999.9
    AND g.min  <> 9999.9
  GROUP BY g.stn, g.wban
)
LIMIT 20;
```

```sql
-- 9. Description: histogram of coverage buckets for candidate stations
SELECT
  CASE
    WHEN valid_days_2019 >= 329 THEN '≥90%'
    WHEN valid_days_2019 >= 300 THEN '80‑<90%'
    WHEN valid_days_2019 >= 200 THEN '55‑<80%'
    ELSE '<55%'
  END AS coverage_bucket,
  COUNT(*) AS station_cnt
FROM (
  SELECT g.stn, g.wban, COUNT(*) AS valid_days_2019
  FROM `bigquery-public-data.noaa_gsod.gsod2019` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn  = s.usaf
   AND g.wban = s.wban
  WHERE s.begin <= '20000101'
    AND s.end   >= '20190630'
    AND g.temp <> 9999.9
    AND g.max  <> 9999.9
    AND g.min  <> 9999.9
  GROUP BY g.stn, g.wban
)
GROUP BY coverage_bucket
ORDER BY coverage_bucket;
```

```sql
-- 10. Description: FINAL ANSWER – how many stations logged ≥90% of
--     all possible 2019 days with valid temp/max/min?
SELECT COUNT(*) AS stations_ge_90pct_coverage
FROM (
  SELECT g.stn, g.wban, COUNT(*) AS valid_days_2019
  FROM `bigquery-public-data.noaa_gsod.gsod2019` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn  = s.usaf
   AND g.wban = s.wban
  WHERE s.begin <= '20000101'
    AND s.end   >= '20190630'
    AND g.temp <> 9999.9
    AND g.max  <> 9999.9
    AND g.min  <> 9999.9
  GROUP BY g.stn, g.wban
  HAVING COUNT(*) >= 329          -- 90% of 365 days
);
```

