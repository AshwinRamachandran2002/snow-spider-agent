```sql
--Description / Thinking process:
--Goal: Count stations that (a) started service on/before 2000‑01‑01, (b) remained active at least
--through 2019‑06‑30, and (c) supplied valid mean/max/min temperatures for ≥90 % of 2019 days (≥329).
--Steps
--1. Join gsod2019 (daily data) to stations table on USAF/WBAN identifiers.
--2. Filter stations by their `begin` / `end` dates (quoted with back‑ticks because BEGIN/END are reserved).
--3. Exclude rows where any of temp, max, or min equals the missing flag 9999.9.
--4. Count qualifying 2019 rows per station, then keep only those with ≥329 rows.
--5. Count how many stations meet all criteria.

WITH per_station_coverage AS (
  SELECT
    g.stn,
    g.wban,
    COUNT(*) AS valid_days_2019
  FROM `bigquery-public-data.noaa_gsod.gsod2019` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations`   AS s
    ON g.stn  = s.usaf
   AND g.wban = s.wban
  WHERE
        s.`begin` <= '20000101'  -- active by 1‑Jan‑2000
    AND s.`end`   >= '20190630'  -- still active through 30‑Jun‑2019
    AND g.temp <> 9999.9         -- all three temps valid
    AND g.max  <> 9999.9
    AND g.min  <> 9999.9
  GROUP BY g.stn, g.wban
)
SELECT COUNT(*) AS stations_ge_90pct_valid_days_2019
FROM per_station_coverage
WHERE valid_days_2019 >= 329;      -- ≥90% of 365
```
