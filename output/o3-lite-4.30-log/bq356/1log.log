Query:
--Description: Final answer – count how many stations met every criterion
--             (period‑of‑record rule + ≥ 90 % valid days in 2019).
WITH station_filter AS (
  SELECT usaf, wban
  FROM `bigquery-public-data.noaa_gsod.stations`
  WHERE CAST(`begin` AS INT64) <= 20000101
    AND CAST(`end`   AS INT64) >= 20190630
),
valid_day_counts AS (
  SELECT
    g.stn,
    g.wban,
    COUNT(1) AS valid_days_2019
  FROM `bigquery-public-data.noaa_gsod.gsod2019` AS g
  JOIN station_filter AS f
    ON g.stn  = f.usaf
   AND g.wban = f.wban
  WHERE g.temp <> 9999.9
    AND g.max  <> 9999.9
    AND g.min  <> 9999.9
  GROUP BY g.stn, g.wban
)
SELECT COUNT(*) AS stations_reaching_90pct_of_full_year
FROM valid_day_counts
WHERE valid_days_2019 >= 0.9 * 365
