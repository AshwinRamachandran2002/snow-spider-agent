Query:
--Description: Join 2019 daily data to the station table and keep only rows
--             from stations whose record began ≤ 2000‑01‑01 and lasted ≥ 2019‑06‑30.
--             `begin` and `end` are wrapped in back‑quotes.
SELECT
  g.stn,
  g.wban,
  g.temp,
  g.max,
  g.min
FROM `bigquery-public-data.noaa_gsod.gsod2019` AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn  = s.usaf
 AND g.wban = s.wban
WHERE CAST(s.`begin` AS INT64) <= 20000101
  AND CAST(s.`end`   AS INT64) >= 20190630
LIMIT 20
