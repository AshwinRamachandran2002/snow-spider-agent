Query:
--Description: Count valid‑temperature days per station for 2019, but only for
--             stations whose record began ≤ 2000‑01‑01 and continued ≥ 2019‑06‑30.
WITH station_filter AS (
  SELECT usaf, wban
  FROM `bigquery-public-data.noaa_gsod.stations`
  WHERE CAST(`begin` AS INT64) <= 20000101
    AND CAST(`end`   AS INT64) >= 20190630
)
SELECT
  g.stn,
  g.wban,
  COUNT(1) AS valid_days_2019
FROM `bigquery-public-data.noaa_gsod.gsod2019` AS g
JOIN station_filter AS f
  ON g.stn  = f.usaf
 AND g.wban = f.wban
WHERE g.temp <> 9999.9
  AND g.max  <> 9999.9
  AND g.min  <> 9999.9
GROUP BY g.stn, g.wban
ORDER BY valid_days_2019 DESC
LIMIT 20
