--Description:  Goal – identify the five calendar days (2005‑2015) that recorded
--              the highest DAILY‑AVERAGE wind speed (column wind_speed, stored in
--              tenths m s‑¹) in the ICOADS “core” tables.  
--
--              Thinking process
--              1. Every yearly table shares the same structure but contains many
--                 more than the six fields we need.  Selecting the identical
--                 set of six columns from each table prevents the UNION ALL
--                 column‑count error that appeared earlier.
--              2. All 11 tables from 2005 through 2015 are UNIONed in the CTE
--                 all_years.  (2016 and 2017 are outside the required range.)
--              3. Because wind_speed may be NULL or NaN, we keep only finite
--                 values via   WHERE wind_speed IS NOT NULL AND NOT IS_NAN(wind_speed).
--              4. We aggregate by DATE(year,month,day) to compute:
--                   • avg_daily_wind_tenths_ms  – mean of wind_speed for that day
--                   • centroid_latitude/longitude – average position of all reports
--              5. Finally, we sort descending and limit to the top 5 days.
WITH all_years AS (
  SELECT year, month, day, latitude, longitude, wind_speed
  FROM `bigquery-public-data.noaa_icoads.icoads_core_2005` UNION ALL
  SELECT year, month, day, latitude, longitude, wind_speed
  FROM `bigquery-public-data.noaa_icoads.icoads_core_2006` UNION ALL
  SELECT year, month, day, latitude, longitude, wind_speed
  FROM `bigquery-public-data.noaa_icoads.icoads_core_2007` UNION ALL
  SELECT year, month, day, latitude, longitude, wind_speed
  FROM `bigquery-public-data.noaa_icoads.icoads_core_2008` UNION ALL
  SELECT year, month, day, latitude, longitude, wind_speed
  FROM `bigquery-public-data.noaa_icoads.icoads_core_2009` UNION ALL
  SELECT year, month, day, latitude, longitude, wind_speed
  FROM `bigquery-public-data.noaa_icoads.icoads_core_2010` UNION ALL
  SELECT year, month, day, latitude, longitude, wind_speed
