```sql
--Description:  Retention matrix – for every cohort defined by the month of a user’s first purchase
--              (using ORDER_ITEMS up to 31‑Dec‑2022 and excluding ‘Cancelled’ lines) we calculate
--              the percentage of that cohort’s users who placed at least one order in
--              month‑0 (the first‑purchase month itself) through month‑3.  A single SQL CTE
--              pipeline builds:
--              1) first_purchase  – timestamp of each customer’s very first purchase
--              2) cohorts         – adds a YYYY‑MM “cohort_month”
--              3) purchases       – every qualifying purchase with its month_offset (0‑3)
--              4) final SELECT    – pivot-like aggregation that divides distinct user counts
--                                   by cohort_size to get percentages.
WITH first_purchase AS (
    SELECT
           "user_id",
           MIN("created_at") AS "first_purchase_ts"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
    WHERE "status" <> 'Cancelled'
      AND "created_at" < 1672531200000000             -- before 2023‑01‑01
    GROUP BY "user_id"
),
cohorts AS (
    SELECT
           fp."user_id",
           fp."first_purchase_ts",
           TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_purchase_ts" / 1000000), 'YYYY-MM') AS "cohort_month"
    FROM first_purchase fp
),
purchases AS (
    SELECT
           oi."user_id",
           FLOOR(
               DATEDIFF(
                   'day',
                   TO_TIMESTAMP_NTZ(fp."first_purchase_ts" / 1000000),
                   TO_TIMESTAMP_NTZ(oi."created_at"       / 1000000)
               ) / 30
           ) AS "month_offset"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
    JOIN first_purchase fp
      ON oi."user_id" = fp."user_id"
    WHERE oi."status" <> 'Cancelled'
      AND oi."created_at" < 1672531200000000
      AND FLOOR(
              DATEDIFF(
                  'day',
                  TO_TIMESTAMP_NTZ(fp."first_purchase_ts" / 1000000),
                  TO_TIMESTAMP_NTZ(oi."created_at"       / 1000000)
              ) / 30
          ) BETWEEN 0 AND 3                              -- we only need offsets 0‑3
)
SELECT
       c."cohort_month",
       ROUND( 100.0 * COUNT(DISTINCT CASE WHEN p."month_offset" = 0 THEN p."user_id" END)
                / COUNT(DISTINCT c."user_id"), 2) AS "pct_month_0",
       ROUND( 100.0 * COUNT(DISTINCT CASE WHEN p."month_offset" = 1 THEN p."user_id" END)
                / COUNT(DISTINCT c."user_id"), 2) AS "pct_month_1",
       ROUND( 100.0 * COUNT(DISTINCT CASE WHEN p."month_offset" = 2 THEN p."user_id" END)
                / COUNT(DISTINCT c."user_id"), 2) AS "pct_month_2",
       ROUND( 100.0 * COUNT(DISTINCT CASE WHEN p."month_offset" = 3 THEN p."user_id" END)
                / COUNT(DISTINCT c."user_id"), 2) AS "pct_month_3"
FROM cohorts c
LEFT JOIN purchases p
       ON c."user_id" = p."user_id"
GROUP BY c."cohort_month"
ORDER BY c."cohort_month"
LIMIT 20;
```
