```sql
--Description: 9)  Cohort sizes – number of users whose first purchase falls in each
--               first‑purchase month (YYYY‑MM) up to 31‑Dec‑2022.  LIMIT 20 for preview.
WITH first_purchase AS (
    SELECT
           "user_id",
           MIN("created_at") AS "first_purchase_ts"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
    WHERE "status" <> 'Cancelled'
      AND "created_at" < 1672531200000000
    GROUP BY "user_id"
)
SELECT
       TO_CHAR( TO_TIMESTAMP_NTZ("first_purchase_ts" / 1000000), 'YYYY-MM') AS "cohort_month",
       COUNT(*)                                                             AS "cohort_size"
FROM first_purchase
GROUP BY TO_CHAR( TO_TIMESTAMP_NTZ("first_purchase_ts" / 1000000), 'YYYY-MM')
ORDER BY "cohort_month"
LIMIT 20;
```

```sql
--Description: 10)  Cohort retention – for each cohort_month, compute the percentage of users
--                  who purchased in month offsets 0‑3.  Uses CTEs to build first_purchase,
--                  cohorts, and purchases, then aggregates.  LIMIT 20 rows for review.
WITH first_purchase AS (
    SELECT
           "user_id",
           MIN("created_at") AS "first_purchase_ts"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
    WHERE "status" <> 'Cancelled'
      AND "created_at" < 1672531200000000
    GROUP BY "user_id"
),
cohorts AS (
    SELECT
           fp."user_id",
           TO_CHAR( TO_TIMESTAMP_NTZ(fp."first_purchase_ts" / 1000000), 'YYYY-MM') AS "cohort_month"
    FROM first_purchase fp
),
cohort_sizes AS (
    SELECT
           "cohort_month",
           COUNT(*) AS "cohort_size"
    FROM cohorts
    GROUP BY "cohort_month"
),
purchases AS (
    SELECT
           oi."user_id",
           FLOOR(
               DATEDIFF(
                   'day',
                   TO_TIMESTAMP_NTZ(fp."first_purchase_ts" / 1000000),
                   TO_TIMESTAMP_NTZ(oi."created_at"       / 1000000)
               ) / 30
           ) AS "month_offset"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN first_purchase fp
      ON oi."user_id" = fp."user_id"
    WHERE oi."status" <> 'Cancelled'
      AND oi."created_at" < 1672531200000000
)
SELECT
       cs."cohort_month",
       ROUND(100.0 * COUNT(DISTINCT CASE WHEN p."month_offset" = 0 THEN p."user_id" END) / cs."cohort_size", 2) AS "pct_month_0",
       ROUND(100.0 * COUNT(DISTINCT CASE WHEN p."month_offset" = 1 THEN p."user_id" END) / cs."cohort_size", 2) AS "pct_month_1",
       ROUND(100.0 * COUNT(DISTINCT CASE WHEN p."month_offset" = 2 THEN p."user_id" END) / cs."cohort_size", 2) AS "pct_month_2",
       ROUND(100.0 * COUNT(DISTINCT CASE WHEN p."month_offset" = 3 THEN p."user_id" END) / cs."cohort_size", 2) AS "pct_month_3"
FROM cohort_sizes cs
JOIN cohorts       c  ON c."cohort_month" = cs."cohort_month"
LEFT JOIN purchases p ON p."user_id"      = c."user_id"
WHERE p."month_offset" BETWEEN 0 AND 3
GROUP BY cs."cohort_month", cs."cohort_size"
ORDER BY cs."cohort_month"
LIMIT 20;
