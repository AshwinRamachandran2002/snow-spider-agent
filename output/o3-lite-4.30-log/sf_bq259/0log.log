    SELECT
        TO_CHAR(TO_TIMESTAMP_NTZ(first_us/1000000),'YYYY-MM') AS first_month,
        COUNT(*)                                            AS cohort_size
    FROM first_purchase
    GROUP BY TO_CHAR(TO_TIMESTAMP_NTZ(first_us/1000000),'YYYY-MM')
)
SELECT
    c.first_month                              AS first_purchase_month,
    ROUND(100 * COALESCE(MAX(CASE WHEN b.month_number = 0 THEN b.buyers END),0)
                / c.cohort_size, 2)            AS pct_users_month1,   -- month of first purchase
    ROUND(100 * COALESCE(MAX(CASE WHEN b.month_number = 1 THEN b.buyers END),0)
                / c.cohort_size, 2)            AS pct_users_month2,
    ROUND(100 * COALESCE(MAX(CASE WHEN b.month_number = 2 THEN b.buyers END),0)
                / c.cohort_size, 2)            AS pct_users_month3,
    ROUND(100 * COALESCE(MAX(CASE WHEN b.month_number = 3 THEN b.buyers END),0)
                / c.cohort_size, 2)            AS pct_users_month4
FROM cohort c
LEFT JOIN buyers b
       ON b.first_month = c.first_month
GROUP BY c.first_month, c.cohort_size
ORDER BY c.first_month;
