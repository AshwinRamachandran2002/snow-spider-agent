Relevant columns & their potential usage  

• ORDERS."user_id": links every purchase event to a unique shopper  
• ORDERS."created_at": micro‑second time‑stamp that lets us determine the calendar month of each purchase and to build “month 0, month 1 …” cohorts that follow the first purchase of every user  
• ORDERS."status": allows us to keep only real purchases (e.g. "Complete" or "Shipped") and ignore cancelled / returned orders  
• USERS."id": provides the master list of shoppers so we can compare “buyers vs. all users” if ever required (not vital for the cohort part itself)  

Typical conditions we will probably need  

• ORDERS."status" IN ('Complete','Shipped')                -- keep only true sales  
• ORDERS."created_at" < 1672531200000000                   -- exclude anything after 31‑Dec‑2022 23:59:59 (micro‑seconds)  

Below are ten exploratory Snowflake SQL snippets – from very simple to cohort‑style – to look at the data that will ultimately allow us to calculate “in month 0 / 1 / 2 / 3 what % of users purchased again”.  
All column names are enclosed in double quotes, each query is capped with LIMIT 20.  

```sql
-- 1. Sample of raw orders (all statuses, all years)
SELECT 
  "order_id",
  "user_id",
  "status",
  "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
LIMIT 20;
```

```sql
-- 2. What different order statuses exist?
SELECT DISTINCT
  "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
LIMIT 20;
```

```sql
-- 3. Inspect the micro‑second time‑stamp by converting it to calendar date
SELECT 
  "order_id",
  "user_id",
  TO_TIMESTAMP_NTZ("created_at"/1000000) AS "order_ts"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
ORDER BY "order_ts" DESC
LIMIT 20;
```

```sql
-- 4. Orders that represent real sales before 2023
SELECT 
  "order_id",
  "user_id",
  TO_TIMESTAMP_NTZ("created_at"/1000000) AS "order_ts",
  "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
WHERE "status" IN ('Complete','Shipped')
  AND "created_at" < 1672531200000000
ORDER BY "order_ts" DESC
LIMIT 20;
```

```sql
-- 5. First purchase time‑stamp for every user (through end‑2022)
SELECT
  "user_id",
  MIN("created_at") AS "first_purchase_us"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
WHERE "status" IN ('Complete','Shipped')
  AND "created_at" < 1672531200000000
GROUP BY "user_id"
LIMIT 20;
```

```sql
-- 6. Same as above but also produce the calendar month of that first purchase
SELECT
  "user_id",
  TO_CHAR(TO_TIMESTAMP_NTZ(MIN("created_at")/1000000), 'YYYY‑MM') AS "first_purchase_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
WHERE "status" IN ('Complete','Shipped')
  AND "created_at" < 1672531200000000
GROUP BY "user_id"
LIMIT 20;
```

```sql
-- 7. Join each order to its user’s first purchase to get the month‑offset (0,1,2,3,…)
WITH first AS (
  SELECT
    "user_id",
    MIN("created_at") AS "first_us"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
  WHERE "status" IN ('Complete','Shipped')
    AND "created_at" < 1672531200000000
  GROUP BY "user_id"
)
SELECT
  o."user_id",
  TO_CHAR(TO_TIMESTAMP_NTZ(first."first_us"/1000000), 'YYYY‑MM') AS "first_month",
  DATEDIFF(month,
           TO_TIMESTAMP_NTZ(first."first_us"/1000000),
           TO_TIMESTAMP_NTZ(o."created_at"/1000000)) AS "month_number",
  o."order_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN first
  ON o."user_id" = first."user_id"
WHERE o."status" IN ('Complete','Shipped')
  AND o."created_at" < 1672531200000000
ORDER BY o."user_id", "month_number"
LIMIT 20;
```

```sql
-- 8. For every cohort (first purchase month) and for every month_number (0..3) 
--    count the number of distinct purchasers
WITH first AS (
  SELECT "user_id",
         MIN("created_at") AS "first_us"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
  WHERE "status" IN ('Complete','Shipped')
    AND "created_at" < 1672531200000000
  GROUP BY "user_id"
),
activities AS (
  SELECT
    o."user_id",
    TO_CHAR(TO_TIMESTAMP_NTZ(first."first_us"/1000000), 'YYYY‑MM') AS "first_month",
    DATEDIFF(month,
             TO_TIMESTAMP_NTZ(first."first_us"/1000000),
             TO_TIMESTAMP_NTZ(o."created_at"/1000000)) AS "month_number"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
  JOIN first
    ON o."user_id" = first."user_id"
  WHERE o."status" IN ('Complete','Shipped')
    AND o."created_at" < 1672531200000000
)
SELECT
  "first_month",
  "month_number",
  COUNT(DISTINCT "user_id") AS "buyers"
FROM activities
WHERE "month_number" BETWEEN 0 AND 3
GROUP BY "first_month", "month_number"
ORDER BY "first_month", "month_number"
LIMIT 20;
```

```sql
-- 9. Calculate cohort size (total users who bought in that first month)
WITH cohort AS (
  SELECT 
    TO_CHAR(TO_TIMESTAMP_NTZ(MIN("created_at")/1000000), 'YYYY‑MM') AS "first_month",
    COUNT(DISTINCT "user_id") AS "cohort_size"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
  WHERE "status" IN ('Complete','Shipped')
    AND "created_at" < 1672531200000000
  GROUP BY "first_month"
)
SELECT *
FROM cohort
ORDER BY "first_month"
LIMIT 20;
```

```sql
-- 10. Combine cohort size with repeat‑purchase counts to get the percentage of buyers 
--     in month 0, 1, 2 and 3 after the first purchase (limited to first 20 cohorts)
WITH first AS (
  SELECT "user_id",
         MIN("created_at") AS "first_us"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
  WHERE "status" IN ('Complete','Shipped')
    AND "created_at" < 1672531200000000
  GROUP BY "user_id"
),
activities AS (
  SELECT
    o."user_id",
    TO_CHAR(TO_TIMESTAMP_NTZ(first."first_us"/1000000), 'YYYY‑MM') AS "first_month",
    DATEDIFF(month,
             TO_TIMESTAMP_NTZ(first."first_us"/1000000),
             TO_TIMESTAMP_NTZ(o."created_at"/1000000)) AS "month_number"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
  JOIN first
    ON o."user_id" = first."user_id"
  WHERE o."status" IN ('Complete','Shipped')
    AND o."created_at" < 1672531200000000
    AND DATEDIFF(month,
                 TO_TIMESTAMP_NTZ(first."first_us"/1000000),
                 TO_TIMESTAMP_NTZ(o."created_at"/1000000)) BETWEEN 0 AND 3
),
buyers AS (
  SELECT 
    "first_month",
    "month_number",
    COUNT(DISTINCT "user_id") AS "buyers"
  FROM activities
  GROUP BY "first_month", "month_number"
),
cohort AS (
  SELECT 
    TO_CHAR(TO_TIMESTAMP_NTZ(MIN("created_at")/1000000), 'YYYY‑MM') AS "first_month",
    COUNT(DISTINCT "user_id") AS "cohort_size"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
  WHERE "status" IN ('Complete','Shipped')
    AND "created_at" < 1672531200000000
  GROUP BY "first_month"
)
SELECT
  b."first_month",
  b."month_number",
  ROUND(100.0 * b."buyers" / c."cohort_size", 2) AS "buyer_pct"
FROM buyers b
JOIN cohort c
  ON b."first_month" = c."first_month"
ORDER BY b."first_month", b."month_number"
LIMIT 20;
```
