```sql
--Description: Cohort‑retention matrix (up to 2022‑12‑31)
-- 1) first_purchase  : earliest Complete/Shipped order per user (our cohort anchor).
-- 2) cohort_size     : the number of users in each first‑purchase month (month 0).
-- 3) activity        : every subsequent Complete/Shipped order for those users,
--                      translated into the month offset relative to the anchor.
-- 4) month_buyers    : distinct buyers per (cohort‑month , offset 0‑3).
-- 5) final SELECT    : join month_buyers to cohort_size and compute the
--                      percentage of buyers who ordered again in month 0,1,2,3.
WITH first_purchase AS (                               -- step 1
    SELECT
        "user_id",
        MIN("created_at") AS "first_us"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    WHERE "status" IN ('Complete','Shipped')
      AND "created_at" < 1672531200000000              -- keep data through 2022‑12‑31
    GROUP BY "user_id"
),
cohort_size AS (                                       -- step 2
    SELECT
        TO_CHAR(TO_TIMESTAMP_NTZ("first_us"/1000000), 'YYYY-MM') AS "first_month",
        COUNT(*) AS "cohort_size"
    FROM first_purchase
    GROUP BY TO_CHAR(TO_TIMESTAMP_NTZ("first_us"/1000000), 'YYYY-MM')
),
activity AS (                                          -- step 3
    SELECT
        fp."user_id",
        TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_us"/1000000), 'YYYY-MM') AS "first_month",
        DATEDIFF(
            month,
            TO_TIMESTAMP_NTZ(fp."first_us"/1000000),
            TO_TIMESTAMP_NTZ(o."created_at"/1000000)
        ) AS "month_offset"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
    JOIN first_purchase fp ON fp."user_id" = o."user_id"
    WHERE o."status" IN ('Complete','Shipped')
      AND o."created_at" < 1672531200000000
),
month_buyers AS (                                      -- step 4
    SELECT
        "first_month",
        "month_offset",
        COUNT(DISTINCT "user_id") AS "buyers"
    FROM activity
    WHERE "month_offset" BETWEEN 0 AND 3
    GROUP BY "first_month", "month_offset"
)
-- step 5 : compute percentages
SELECT
    mb."first_month",
    mb."month_offset"         AS "month_since_first",
    ROUND(100.0 * mb."buyers" / cs."cohort_size", 2) AS "buyer_pct"
FROM month_buyers mb
JOIN cohort_size cs
  ON mb."first_month" = cs."first_month"
ORDER BY mb."first_month", mb."month_offset";
