Query:
--Description: Corrected version of the “combine cohort size with repeat‑purchase counts” query.
--             The fix removes the invalid GROUP BY on an alias by deriving cohort sizes
--             from a first_purchase CTE (one row per user) and grouping on the explicit
--             month expression.  Results show, for each cohort month, the % of users
--             who placed an order in months 0‑3 after their initial purchase (data up
--             to 2022‑12‑31 only).
WITH first_purchase AS (                               -- users’ earliest Complete/Shipped order
    SELECT
        "user_id",
        MIN("created_at") AS "first_us"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    WHERE "status" IN ('Complete', 'Shipped')
      AND "created_at" < 1672531200000000              -- keep data through 2022‑12‑31
    GROUP BY "user_id"
),
activities AS (                                        -- every order mapped to month offset
    SELECT
        o."user_id",
        TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_us"/1000000), 'YYYY-MM') AS "first_month",
        DATEDIFF(
            month,
            TO_TIMESTAMP_NTZ(fp."first_us"/1000000),
            TO_TIMESTAMP_NTZ(o."created_at"/1000000)
        ) AS "month_number"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
    JOIN first_purchase fp ON fp."user_id" = o."user_id"
    WHERE o."status" IN ('Complete', 'Shipped')
      AND o."created_at" < 1672531200000000
      AND DATEDIFF(
            month,
            TO_TIMESTAMP_NTZ(fp."first_us"/1000000),
            TO_TIMESTAMP_NTZ(o."created_at"/1000000)
          ) BETWEEN 0 AND 3
),
buyers AS (                                            -- distinct buyers per cohort‑month / offset
    SELECT
        "first_month",
        "month_number",
        COUNT(DISTINCT "user_id") AS "buyers"
    FROM activities
    GROUP BY "first_month", "month_number"
),
cohort AS (                                            -- cohort size per first‑purchase month
    SELECT
        TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_us"/1000000), 'YYYY-MM') AS "first_month",
        COUNT(*) AS "cohort_size"
    FROM first_purchase fp
    GROUP BY TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_us"/1000000), 'YYYY-MM')
)
SELECT
    b."first_month",
    b."month_number"      AS "month_since_first",
    ROUND(100.0 * b."buyers" / c."cohort_size", 2) AS "buyer_pct"
FROM buyers b
JOIN cohort c
  ON b."first_month" = c."first_month"
ORDER BY b."first_month", b."month_number"
LIMIT 20
