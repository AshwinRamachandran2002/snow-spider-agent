```sql
--Description: Compute total gas fees earned by each miner across the whole
--             Ethereum Classic dataset.  Approach:
--             1) In CTE block_fees, sum gas_used*gas_price for every block_number
--                directly from TRANSACTIONS (avoids losing rows when a block
--                has no entry in BLOCKS).
--             2) LEFT JOIN those per‑block totals to BLOCKS to fetch the miner
--                (coinbase) address; use COALESCE to label missing miners as
--                'UNKNOWN'.
--             3) Aggregate again by miner, order by total fees, and return the
--                top 20 earners.
WITH block_fees AS (
    SELECT
        "block_number",
        SUM("receipt_gas_used" * "gas_price") AS "fee_wei"
    FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS"
    GROUP BY "block_number"
)
SELECT
    COALESCE(b."miner", 'UNKNOWN') AS "address",
    SUM(bf."fee_wei")              AS "miner_fees_wei"
FROM block_fees bf
LEFT JOIN "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."BLOCKS" b
       ON bf."block_number" = b."number"
GROUP BY COALESCE(b."miner", 'UNKNOWN')
ORDER BY "miner_fees_wei" DESC
LIMIT 20;
```
