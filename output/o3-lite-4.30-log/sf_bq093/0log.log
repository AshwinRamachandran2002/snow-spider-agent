```sql
--Description: Determine the largest positive and negative net balance changes (Wei)
--             for any Ethereum Classic address on 14 Oct 2016.
--
--THINKING PROCESS
--1. Tables involved
--      • CRYPTO.CRYPTO_ETHEREUM_CLASSIC.TRANSACTIONS  → value moved, gas_price, gas_used, sender, receiver
--      • CRYPTO.CRYPTO_ETHEREUM_CLASSIC.BLOCKS        → miner that earns each block’s gas fees
--
--2. Filters
--      • Successful top‑level txs only: receipt_status = 1
--      • Date range 2016‑10‑14 UTC: 1476403200000000 ≤ block_timestamp < 1476489600000000
--
--3. Net‑change rules
--      • Sender  : −value − (gas_used × gas_price)
--      • Receiver: +value
--      • Miner   : +Σ(gas_used × gas_price) for all txs in its block
--
--4. Approach
--      • Build three CTEs (sender_side, receiver_side, miner_side) to calculate
--        each role’s net change per address.
--      • UNION ALL them into one list (all_changes).
--      • Return MAX() and MIN() across that list.
--------------------------------------------------------------------------------
WITH sender_side AS (
    SELECT
        "from_address"                                            AS "address",
        SUM( -1 * "value" - ("receipt_gas_used" * "gas_price") )  AS "net_change_wei"
    FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS"
    WHERE "receipt_status" = 1
      AND "block_timestamp" >= 1476403200000000   -- 2016‑10‑14 00:00:00 UTC
      AND "block_timestamp" <  1476489600000000   -- 2016‑10‑15 00:00:00 UTC
    GROUP BY "from_address"
),
receiver_side AS (
    SELECT
        "to_address"                                              AS "address",
        SUM( "value" )                                            AS "net_change_wei"
    FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS"
    WHERE "receipt_status" = 1
      AND "block_timestamp" >= 1476403200000000
      AND "block_timestamp" <  1476489600000000
      AND "to_address" IS NOT NULL
    GROUP BY "to_address"
),
miner_side AS (
    SELECT
        b."miner"                                                 AS "address",
        SUM( t."receipt_gas_used" * t."gas_price" )               AS "net_change_wei"
    FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS" t
    JOIN "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."BLOCKS"      b
      ON t."block_number" = b."number"
    WHERE t."receipt_status" = 1
      AND t."block_timestamp" >= 1476403200000000
      AND t."block_timestamp" <  1476489600000000
    GROUP BY b."miner"
),
all_changes AS (
    SELECT * FROM sender_side
    UNION ALL
    SELECT * FROM receiver_side
    UNION ALL
    SELECT * FROM miner_side
)
SELECT
    MAX("net_change_wei") AS "max_net_change_wei",
    MIN("net_change_wei") AS "min_net_change_wei"
FROM all_changes;
```
