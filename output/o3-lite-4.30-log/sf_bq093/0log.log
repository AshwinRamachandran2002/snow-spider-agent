```sql
--Description: Combine sender, receiver, and miner net balance changes across the full
--             Ethereum Classic dataset and report the maximum and minimum changes.
--             A robust miner_side calculation is added that first sums gas fees per
--             block in a CTE (block_fees) and then left‑joins to BLOCKS to capture
--             every miner, even when a block record is missing.
WITH
sender_side AS (  -- negative outflow: value + fees
  SELECT
      "from_address"                                            AS "address",
      SUM(-1 * "value" - ("receipt_gas_used" * "gas_price"))    AS "net_change_wei"
  FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS"
  WHERE "receipt_status" = 1
  GROUP BY "from_address"
),
receiver_side AS (  -- positive inflow: value
  SELECT
      "to_address"                                              AS "address",
      SUM("value")                                              AS "net_change_wei"
  FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS"
  WHERE "receipt_status" = 1
    AND "to_address" IS NOT NULL
  GROUP BY "to_address"
),
-- fees per block (includes all txs whether block exists in BLOCKS table or not)
block_fees AS (
  SELECT
      "block_number",
      SUM("receipt_gas_used" * "gas_price") AS "fee_wei"
  FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS"
  WHERE "receipt_status" = 1
  GROUP BY "block_number"
),
miner_side AS (  -- positive inflow: fees earned
  SELECT
      COALESCE(b."miner", 'UNKNOWN')        AS "address",
      SUM(bf."fee_wei")                     AS "net_change_wei"
  FROM block_fees bf
  LEFT JOIN "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."BLOCKS" b
         ON bf."block_number" = b."number"
  GROUP BY COALESCE(b."miner", 'UNKNOWN')
),
all_changes AS (
  SELECT * FROM sender_side
  UNION ALL
  SELECT * FROM receiver_side
  UNION ALL
  SELECT * FROM miner_side
)
SELECT
    MAX("net_change_wei") AS "max_net_change_wei",
    MIN("net_change_wei") AS "min_net_change_wei"
FROM all_changes;
```
