/*  Maximum and minimum net‑balance changes for every Ethereum Classic
    address on 14‑Oct‑2016 (UTC).  A net change = value in/out ± gas fee.
    Successful top‑level transactions only; internal calls (traces) ignored. */

WITH timeframe AS (      -- 2016‑10‑14 00:00‑24:00 UTC (microseconds)
    SELECT 1476403200000000::NUMBER AS start_ts ,
           1476489600000000::NUMBER AS end_ts
),

txs AS (                 -- successful transactions during the day
    SELECT *
    FROM   "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS" t
    JOIN   timeframe f
          ON t."block_timestamp" >= f.start_ts
         AND t."block_timestamp" <  f.end_ts
    WHERE  t."receipt_status" IS NULL          -- pre‑Byzantium txs (treated as OK)
       OR  t."receipt_status" != 0             -- successful status (1 / 1.0)
),

/* ---------------- sender: negative change (value + paid fee) --------- */
sender_side AS (
    SELECT
        t."from_address"                                           AS address,
        SUM( -1 * t."value"                                        -- value sent
             - (t."receipt_gas_used" * t."gas_price") )            -- fee paid
            AS net_change_wei
    FROM txs t
    WHERE t."from_address" IS NOT NULL
    GROUP BY t."from_address"
),

/* ---------------- receiver: positive change (value) ------------------ */
receiver_side AS (
    SELECT
        t."to_address"                                             AS address,
        SUM( t."value" )                                           AS net_change_wei
    FROM txs t
    WHERE t."to_address" IS NOT NULL
    GROUP BY t."to_address"
),

/* ---------------- miner: positive change (block fees) ---------------- */
block_fees AS (
    SELECT
        t."block_number",
        SUM( t."receipt_gas_used" * t."gas_price" )                AS fee_wei
    FROM txs t
    GROUP BY t."block_number"
),
miner_side AS (
    SELECT
        b."miner"                                                  AS address,
        SUM( bf.fee_wei )                                          AS net_change_wei
    FROM block_fees bf
    JOIN "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."BLOCKS" b
      ON bf."block_number" = b."number"
    GROUP BY b."miner"
),

/* ---------------- union all balance movements ------------------------ */
all_changes AS (
    SELECT * FROM sender_side
    UNION ALL
    SELECT * FROM receiver_side
    UNION ALL
    SELECT * FROM miner_side
)

/* ---------------- final max & min (rounded to 4 decimals) ------------ */
SELECT
       ROUND( MAX(net_change_wei), 4 ) AS max_net_change_wei ,
       ROUND( MIN(net_change_wei), 4 ) AS min_net_change_wei
FROM   all_changes;
