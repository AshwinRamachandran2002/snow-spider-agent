Begin Exploring Related Columns
column name / table: potential usage & typical conditions
• CRYPTO.CRYPTO_ETHEREUM_CLASSIC.TRANSACTIONS  
  – "block_timestamp": filter rows for 14‑Oct‑2016 ( 1476403200000000 ≤ ts < 1476489600000000 )  
  – "receipt_status": keep only successful txs (= 1)  
  – "hash": join key / grouping unit for fees  
  – "from_address": addresses that pay value + gas (credit side, negative change)  
  – "to_address": addresses that receive value (debit side, positive change)  
  – "value": amount of ether transferred  
  – "receipt_gas_used": actual gas consumed (sender pays / miner earns)  
  – "gas_price": Wei per gas ‑– multiply with "receipt_gas_used" for fee  
  
• CRYPTO.CRYPTO_ETHEREUM_CLASSIC.BLOCKS  
  – "number": join to transactions to know the miner of every block  
  – "miner": address that earns all gas fees in the block (positive change)  
  – "timestamp": alternative filter for the same date if needed  
  
Conditions to exclude internal calls  
  – ignore CRYPTO.CRYPTO_ETHEREUM_CLASSIC.TRACES completely (only top‑level txs)  

Below are 10 exploratory Snowflake SQL snippets (LIMIT 20) that gradually build the pieces needed for the final calculation.  
Each query is wrapped in ```sql``` and every identifier is double‑quoted.

```sql
--Description: 1) Peek at a few Ethereum Classic transactions that happened on 14‑Oct‑2016
SELECT *
FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS"
WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489600000000
  AND "receipt_status" = 1
LIMIT 20;
```

```sql
--Description: 2) List distinct successful transaction hashes on that date
SELECT DISTINCT "hash"
FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS"
WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489600000000
  AND "receipt_status" = 1
LIMIT 20;
```

```sql
--Description: 3) Aggregate total wei sent (value) by each sender on 14‑Oct‑2016
SELECT "from_address",
       SUM("value") AS "total_value_sent"
FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS"
WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489600000000
  AND "receipt_status" = 1
GROUP BY "from_address"
ORDER BY "total_value_sent" DESC
LIMIT 20;
```

```sql
--Description: 4) Aggregate total wei received by each recipient on 14‑Oct‑2016
SELECT "to_address",
       SUM("value") AS "total_value_received"
FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS"
WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489600000000
  AND "receipt_status" = 1
GROUP BY "to_address"
ORDER BY "total_value_received" DESC
LIMIT 20;
```

```sql
--Description: 5) Inspect calculated gas fee per transaction (gas_used * gas_price)
SELECT "hash",
       "from_address",
       ("receipt_gas_used" * "gas_price") AS "tx_fee_wei"
FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS"
WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489600000000
  AND "receipt_status" = 1
ORDER BY "tx_fee_wei" DESC
LIMIT 20;
```

```sql
--Description: 6) Total gas fees paid by each sender on that date
SELECT "from_address",
       SUM("receipt_gas_used" * "gas_price") AS "total_fees_paid"
FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS"
WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489600000000
  AND "receipt_status" = 1
GROUP BY "from_address"
ORDER BY "total_fees_paid" DESC
LIMIT 20;
```

```sql
--Description: 7) Build sender side net change (‑value ‑ fee) for every tx
SELECT "hash",
       "from_address"           AS "address",
       ( -1 * "value" - ("receipt_gas_used" * "gas_price") ) AS "net_change_wei"
FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS"
WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489600000000
  AND "receipt_status" = 1
LIMIT 20;
```

```sql
--Description: 8) Build receiver side net change (+value) for every tx
SELECT "hash",
       "to_address"             AS "address",
       "value"                  AS "net_change_wei"
FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS"
WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489600000000
  AND "receipt_status" = 1
  AND "to_address" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 9) Attribute gas fees to miners (sum of all fees in each block)
SELECT b."miner"               AS "address",
       SUM(t."receipt_gas_used" * t."gas_price") AS "miner_fees_wei"
FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS" t
JOIN "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."BLOCKS" b
  ON t."block_number" = b."number"
WHERE t."block_timestamp" BETWEEN 1476403200000000 AND 1476489600000000
  AND t."receipt_status" = 1
GROUP BY b."miner"
ORDER BY "miner_fees_wei" DESC
LIMIT 20;
```

```sql
--Description: 10) Combine sender, receiver, and miner components to get net change per address; show max & min
WITH
sender_side AS (
  SELECT "from_address" AS "address",
         SUM( -1 * "value" - ("receipt_gas_used" * "gas_price") ) AS "net_change_wei"
  FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS"
  WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489600000000
    AND "receipt_status" = 1
  GROUP BY "from_address"
),
receiver_side AS (
  SELECT "to_address"   AS "address",
         SUM( "value" ) AS "net_change_wei"
  FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS"
  WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489600000000
    AND "receipt_status" = 1
    AND "to_address" IS NOT NULL
  GROUP BY "to_address"
),
miner_side AS (
  SELECT b."miner"      AS "address",
         SUM( t."receipt_gas_used" * t."gas_price" ) AS "net_change_wei"
  FROM "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."TRANSACTIONS" t
  JOIN "CRYPTO"."CRYPTO_ETHEREUM_CLASSIC"."BLOCKS" b
    ON t."block_number" = b."number"
  WHERE t."block_timestamp" BETWEEN 1476403200000000 AND 1476489600000000
    AND t."receipt_status" = 1
  GROUP BY b."miner"
)
SELECT MAX(total."net_change_wei") AS "max_net_change_wei",
       MIN(total."net_change_wei") AS "min_net_change_wei"
FROM (
  SELECT * FROM sender_side
  UNION ALL
  SELECT * FROM receiver_side
  UNION ALL
  SELECT * FROM miner_side
) total;
```

