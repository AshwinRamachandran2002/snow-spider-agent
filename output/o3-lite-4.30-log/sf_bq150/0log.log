Begin Exploring Related Columns
Relevant columns and their potential usage  
• "HGNC_gene_symbol" (RNASEQ_GENE_EXPRESSION_UNC_RSEM): filter to the TP53 gene.  
• "normalized_count" (RNASEQ_GENE_EXPRESSION_UNC_RSEM): raw expression value that will be log10‑transformed.  
• "project_short_name" (both tables): restrict to the TCGA‑BRCA cohort.  
• "sample_barcode" (RNASEQ_GENE_EXPRESSION_UNC_RSEM): primary key for expression samples.  
• "Hugo_Symbol" (SOMATIC_MUTATION_MC3): restrict to TP53 in mutation data.  
• "Variant_Classification" (SOMATIC_MUTATION_MC3): treat as the “mutation type” grouping variable.  
• "sample_barcode_tumor" (SOMATIC_MUTATION_MC3): sample identifier that must be aligned (substring) with "sample_barcode" from expression data.  
Typical filter conditions  
• "project_short_name" = 'TCGA-BRCA'  
• "HGNC_gene_symbol" ILIKE '%TP53%' (expression)  
• "Hugo_Symbol"  = 'TP53'          (mutation)  
• "normalized_count" > 0           (to allow LOG10 transform)  

Below are ten Snowflake SQL queries — from simple look‑ups to the full one‑way ANOVA calculation.  
All column names are enclosed in double quotes and every exploratory query is capped with `LIMIT 20`.

```sql
-- 1. Description: Peek at TP53 expression records in the BRCA cohort
SELECT "sample_barcode",
       "normalized_count"
FROM   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.RNASEQ_GENE_EXPRESSION_UNC_RSEM
WHERE  "project_short_name" = 'TCGA-BRCA'
  AND  "HGNC_gene_symbol" ILIKE '%TP53%'
LIMIT 20;
```

```sql
-- 2. Description: List distinct mutation types (Variant_Classification) for TP53 in BRCA
SELECT DISTINCT "Variant_Classification"
FROM   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.SOMATIC_MUTATION_MC3
WHERE  "project_short_name" = 'TCGA-BRCA'
  AND  "Hugo_Symbol" = 'TP53'
LIMIT 20;
```

```sql
-- 3. Description: Count how many TP53 mutations per mutation type
SELECT "Variant_Classification"          AS "mutation_type",
       COUNT(*)                          AS "mutation_count"
FROM   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.SOMATIC_MUTATION_MC3
WHERE  "project_short_name" = 'TCGA-BRCA'
  AND  "Hugo_Symbol" = 'TP53'
GROUP BY "Variant_Classification"
ORDER BY "mutation_count" DESC
LIMIT 20;
```

```sql
-- 4. Description: Preview the mapping between expression and mutation sample barcodes
SELECT SUBSTR(m."sample_barcode_tumor",1,15) AS "expr_like_barcode", 
       m."sample_barcode_tumor",
       e."sample_barcode"
FROM   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.SOMATIC_MUTATION_MC3 m
JOIN   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.RNASEQ_GENE_EXPRESSION_UNC_RSEM e
  ON   SUBSTR(m."sample_barcode_tumor",1,15) = e."sample_barcode"
WHERE  m."project_short_name" = 'TCGA-BRCA'
  AND  e."project_short_name" = 'TCGA-BRCA'
  AND  e."HGNC_gene_symbol"   ILIKE '%TP53%'
LIMIT 20;
```

```sql
-- 5. Description: Create a derived table of log10‑transformed TP53 expression (after removing zeros)
SELECT "sample_barcode",
       LOG10("normalized_count") AS "log_expr"
FROM   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.RNASEQ_GENE_EXPRESSION_UNC_RSEM
WHERE  "project_short_name" = 'TCGA-BRCA'
  AND  "HGNC_gene_symbol"   = 'TP53'
  AND  "normalized_count"  > 0
LIMIT 20;
```

```sql
-- 6. Description: Merge log10(TP53 expression) with mutation types
SELECT e."sample_barcode",
       LOG10(e."normalized_count")       AS "log_expr",
       m."Variant_Classification"        AS "mutation_type"
FROM   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.RNASEQ_GENE_EXPRESSION_UNC_RSEM e
JOIN   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.SOMATIC_MUTATION_MC3 m
  ON   SUBSTR(m."sample_barcode_tumor",1,15) = e."sample_barcode"
WHERE  e."project_short_name" = 'TCGA-BRCA'
  AND  m."project_short_name" = 'TCGA-BRCA'
  AND  e."HGNC_gene_symbol"   = 'TP53'
  AND  m."Hugo_Symbol"        = 'TP53'
  AND  e."normalized_count"  > 0
LIMIT 20;
```

```sql
-- 7. Description: Compute per‑mutation‑type sample counts and mean log10 expression
WITH joined AS (
  SELECT LOG10(e."normalized_count")     AS "log_expr",
         m."Variant_Classification"      AS "mutation_type"
  FROM   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.RNASEQ_GENE_EXPRESSION_UNC_RSEM e
  JOIN   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.SOMATIC_MUTATION_MC3 m
    ON   SUBSTR(m."sample_barcode_tumor",1,15) = e."sample_barcode"
  WHERE  e."project_short_name" = 'TCGA-BRCA'
    AND  m."project_short_name" = 'TCGA-BRCA'
    AND  e."HGNC_gene_symbol"   = 'TP53'
    AND  m."Hugo_Symbol"        = 'TP53'
    AND  e."normalized_count"  > 0
)
SELECT "mutation_type",
       COUNT(*)                      AS "n_samples",
       AVG("log_expr")               AS "group_mean"
FROM   joined
GROUP BY "mutation_type"
ORDER BY "n_samples" DESC
LIMIT 20;
```

```sql
-- 8. Description: Calculate the grand mean of log10 expression across all mutation groups
WITH joined AS (
  SELECT LOG10(e."normalized_count") AS "log_expr"
  FROM   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.RNASEQ_GENE_EXPRESSION_UNC_RSEM e
  JOIN   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.SOMATIC_MUTATION_MC3 m
    ON   SUBSTR(m."sample_barcode_tumor",1,15) = e."sample_barcode"
  WHERE  e."project_short_name" = 'TCGA-BRCA'
    AND  m."project_short_name" = 'TCGA-BRCA'
    AND  e."HGNC_gene_symbol"   = 'TP53'
    AND  m."Hugo_Symbol"        = 'TP53'
    AND  e."normalized_count"  > 0
)
SELECT AVG("log_expr") AS "grand_mean"
FROM   joined;
```

```sql
-- 9. Description: Derive SSB (Sum of Squares Between) using group means
WITH joined AS (
  SELECT LOG10(e."normalized_count") AS "log_expr",
         m."Variant_Classification"  AS "mutation_type"
  FROM   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.RNASEQ_GENE_EXPRESSION_UNC_RSEM e
  JOIN   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.SOMATIC_MUTATION_MC3 m
    ON   SUBSTR(m."sample_barcode_tumor",1,15) = e."sample_barcode"
  WHERE  e."project_short_name" = 'TCGA-BRCA'
    AND  m."project_short_name" = 'TCGA-BRCA'
    AND  e."HGNC_gene_symbol"   = 'TP53'
    AND  m."Hugo_Symbol"        = 'TP53'
    AND  e."normalized_count"  > 0
),
group_stats AS (
  SELECT "mutation_type",
         COUNT(*)        AS "n",
         AVG("log_expr") AS "group_mean"
  FROM   joined
  GROUP BY "mutation_type"
),
overall AS (
  SELECT AVG("log_expr") AS "grand_mean" FROM joined
)
SELECT SUM(gs."n"*POWER(gs."group_mean"-o."grand_mean",2)) AS "SSB"
FROM   group_stats gs, overall o;
```

```sql
--10. Description: Full one‑way ANOVA – total samples, #mutation types, MSB, MSW, and F‑statistic
WITH joined AS (  -- filtered & merged expression‑mutation table
  SELECT LOG10(e."normalized_count") AS "log_expr",
         m."Variant_Classification"  AS "mutation_type"
  FROM   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.RNASEQ_GENE_EXPRESSION_UNC_RSEM e
  JOIN   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.SOMATIC_MUTATION_MC3 m
    ON   SUBSTR(m."sample_barcode_tumor",1,15) = e."sample_barcode"
  WHERE  e."project_short_name" = 'TCGA-BRCA'
    AND  m."project_short_name" = 'TCGA-BRCA'
    AND  e."HGNC_gene_symbol"   = 'TP53'
    AND  m."Hugo_Symbol"        = 'TP53'
    AND  e."normalized_count"  > 0
),
group_stats AS (  -- n_j and group means
  SELECT "mutation_type",
         COUNT(*)        AS "n",
         AVG("log_expr") AS "group_mean"
  FROM   joined
  GROUP BY "mutation_type"
),
overall AS (  -- grand mean
  SELECT AVG("log_expr") AS "grand_mean" FROM joined
),
ssb AS (      -- Sum of Squares Between
  SELECT SUM(gs."n"*POWER(gs."group_mean"-o."grand_mean",2)) AS "SSB"
  FROM   group_stats gs, overall o
),
ssw AS (      -- Sum of Squares Within
  SELECT SUM(POWER(j."log_expr" - gs."group_mean",2)) AS "SSW"
  FROM   joined j
  JOIN   group_stats gs
    ON   j."mutation_type" = gs."mutation_type"
),
df AS (       -- degrees of freedom
  SELECT (SELECT COUNT(*) FROM group_stats) - 1        AS "df_between",
         (SELECT COUNT(*) FROM joined) -
         (SELECT COUNT(*) FROM group_stats)            AS "df_within"
),
ms AS (       -- mean squares & F
  SELECT (ssb."SSB"/df."df_between")                   AS "MSB",
         (ssw."SSW"/df."df_within")                   AS "MSW",
         (ssb."SSB"/df."df_between") /
         (ssw."SSW"/df."df_within")                   AS "F_statistic"
  FROM   ssb, ssw, df
)
SELECT (SELECT COUNT(*) FROM joined)          AS "total_samples",
       (SELECT COUNT(*) FROM group_stats)     AS "mutation_type_count",
       ms."MSB"                               AS "mean_square_between",
       ms."MSW"                               AS "mean_square_within",
       ms."F_statistic"                       AS "f_statistic"
FROM   ms;
```

