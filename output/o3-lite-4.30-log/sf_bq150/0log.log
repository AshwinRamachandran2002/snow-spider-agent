```sql
-- 9. Description: Derive SSB (Sum of Squares Between) using group means
WITH joined AS (
  SELECT LOG10(e."normalized_count") AS "log_expr",
         m."Variant_Classification"  AS "mutation_type"
  FROM   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.RNASEQ_GENE_EXPRESSION_UNC_RSEM e
  JOIN   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.SOMATIC_MUTATION_MC3 m
    ON   SUBSTR(m."sample_barcode_tumor",1,15) = e."sample_barcode"
  WHERE  e."project_short_name" = 'TCGA-BRCA'
    AND  m."project_short_name" = 'TCGA-BRCA'
    AND  e."HGNC_gene_symbol"   = 'TP53'
    AND  m."Hugo_Symbol"        = 'TP53'
    AND  e."normalized_count"  > 0
),
group_stats AS (
  SELECT "mutation_type",
         COUNT(*)        AS "n",
         AVG("log_expr") AS "group_mean"
  FROM   joined
  GROUP BY "mutation_type"
),
overall AS (
  SELECT AVG("log_expr") AS "grand_mean" FROM joined
)
SELECT SUM(gs."n"*POWER(gs."group_mean"-o."grand_mean",2)) AS "SSB"
FROM   group_stats gs, overall o;
```

```sql
--10. Description: Full one‑way ANOVA – total samples, #mutation types, MSB, MSW, and F‑statistic
WITH joined AS (  -- filtered & merged expression‑mutation table
  SELECT LOG10(e."normalized_count") AS "log_expr",
         m."Variant_Classification"  AS "mutation_type"
  FROM   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.RNASEQ_GENE_EXPRESSION_UNC_RSEM e
  JOIN   TCGA_HG19_DATA_V0.TCGA_HG19_DATA_V0.SOMATIC_MUTATION_MC3 m
    ON   SUBSTR(m."sample_barcode_tumor",1,15) = e."sample_barcode"
  WHERE  e."project_short_name" = 'TCGA-BRCA'
    AND  m."project_short_name" = 'TCGA-BRCA'
    AND  e."HGNC_gene_symbol"   = 'TP53'
    AND  m."Hugo_Symbol"        = 'TP53'
    AND  e."normalized_count"  > 0
),
group_stats AS (  -- n_j and group means
  SELECT "mutation_type",
         COUNT(*)        AS "n",
         AVG("log_expr") AS "group_mean"
  FROM   joined
  GROUP BY "mutation_type"
),
overall AS (  -- grand mean
  SELECT AVG("log_expr") AS "grand_mean" FROM joined
),
ssb AS (      -- Sum of Squares Between
  SELECT SUM(gs."n"*POWER(gs."group_mean"-o."grand_mean",2)) AS "SSB"
  FROM   group_stats gs, overall o
),
ssw AS (      -- Sum of Squares Within
  SELECT SUM(POWER(j."log_expr" - gs."group_mean",2)) AS "SSW"
  FROM   joined j
  JOIN   group_stats gs
    ON   j."mutation_type" = gs."mutation_type"
),
df AS (       -- degrees of freedom
  SELECT (SELECT COUNT(*) FROM group_stats) - 1        AS "df_between",
         (SELECT COUNT(*) FROM joined) -
         (SELECT COUNT(*) FROM group_stats)            AS "df_within"
),
ms AS (       -- mean squares & F
  SELECT (ssb."SSB"/df."df_between")                   AS "MSB",
         (ssw."SSW"/df."df_within")                   AS "MSW",
         (ssb."SSB"/df."df_between") /
         (ssw."SSW"/df."df_within")                   AS "F_statistic"
  FROM   ssb, ssw, df
)
SELECT (SELECT COUNT(*) FROM joined)          AS "total_samples",
       (SELECT COUNT(*) FROM group_stats)     AS "mutation_type_count",
       ms."MSB"                               AS "mean_square_between",
       ms."MSW"                               AS "mean_square_within",
       ms."F_statistic"                       AS "f_statistic"
FROM   ms;
```

The final statement (#10) produces exactly the five requested ANOVA metrics for TP53 expression across mutation types in TCGA‑BRCA.
