        ssb.SSB / df.df_between                             AS MSB,
        ssw.SSW / df.df_within                              AS MSW,
        (ssb.SSB / df.df_between) /
        (ssw.SSW / df.df_within)                            AS F_statistic
    FROM ssb, ssw, df
)
SELECT
    (SELECT COUNT(*) FROM joined)        AS total_samples,
    (SELECT COUNT(*) FROM group_stats)   AS mutation_types,
    MSB                                  AS mean_square_between,
    MSW                                  AS mean_square_within,
