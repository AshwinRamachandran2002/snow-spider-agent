-- 10) Description: For that top‑selling category, compute the average minutes users spend per product‑page visit.
--   The sub‑query first isolates product SKUs belonging to the chosen category.
--   Then it matches events whose URI contains those SKUs (heuristic match),
--   finally calculates dwell time and averages it.
WITH top_cat AS (
     SELECT p."category"
     FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
     JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p
           ON oi."product_id" = p."id"
     WHERE oi."status" = 'Complete'
     GROUP BY p."category"
     ORDER BY COUNT(*) DESC
     LIMIT 1
),
prod_skus AS (
     SELECT DISTINCT p."sku"
     FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p
     JOIN top_cat t
          ON p."category" = t."category"
),
product_events AS (
     SELECT  e."session_id",
             e."created_at",
             LEAD(e."created_at") OVER (PARTITION BY e."session_id" ORDER BY e."created_at") AS "next_ts",
             (LEAD(e."created_at") OVER (PARTITION BY e."session_id" ORDER BY e."created_at") 
               - e."created_at")/60000000.0 AS "minutes_on_page"
     FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS e
     JOIN prod_skus s
          ON e."uri" ILIKE '%' || s."sku" || '%'
     WHERE e."uri" ILIKE '%/product%'
)
SELECT AVG("minutes_on_page") AS "avg_minutes_top_category"
FROM product_events
WHERE "minutes_on_page" IS NOT NULL
LIMIT 20;
