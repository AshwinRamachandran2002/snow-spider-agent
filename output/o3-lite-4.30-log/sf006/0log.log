--8. Description: Bring in full state names from GEOGRAPHY_INDEX.
WITH state_counts AS (
    /* reuse query #7 but stop before ORDER BY */
    WITH march20 AS (
        SELECT "ID_STATE",
               COUNT(DISTINCT "ID_RSSD") AS "cnt_20200301"
        FROM FINANCE__ECONOMICS.CYBERSYN.FINANCIAL_BRANCH_ENTITIES
        WHERE "START_DATE" <= '2020-03-01'
          AND ("END_DATE" IS NULL OR "END_DATE" >= '2020-03-01')
          AND "CATEGORY" = 'Branch'
          AND "ID_COUNTRY" = 'country/USA'
        GROUP BY "ID_STATE"
    ),
    dec21 AS (
        SELECT "ID_STATE",
               COUNT(DISTINCT "ID_RSSD") AS "cnt_20211231"
        FROM FINANCE__ECONOMICS.CYBERSYN.FINANCIAL_BRANCH_ENTITIES
        WHERE "START_DATE" <= '2021-12-31'
          AND ("END_DATE" IS NULL OR "END_DATE" >= '2021-12-31')
          AND "CATEGORY" = 'Branch'
          AND "ID_COUNTRY" = 'country/USA'
        GROUP BY "ID_STATE"
    )
    SELECT COALESCE(m."ID_STATE", d."ID_STATE") AS "ID_STATE",
           m."cnt_20200301",
           d."cnt_20211231"
    FROM march20 m
    FULL JOIN dec21 d USING ("ID_STATE")
)
SELECT g."GEO_NAME" AS "STATE_NAME",
       s."cnt_20200301",
       s."cnt_20211231",
       ROUND(100.0 * (s."cnt_20211231" - s."cnt_20200301") / NULLIF(s."cnt_20200301",0), 2) AS "pct_change"
FROM state_counts s
LEFT JOIN FINANCE__ECONOMICS.CYBERSYN.GEOGRAPHY_INDEX g
  ON g."GEO_ID" = s."ID_STATE"
ORDER BY "pct_change" DESC
LIMIT 20;
