--9. Description: Rank states by greatest decline in active branches.
WITH summary AS (
    /* identical to query #7 */
    WITH march20 AS (
        SELECT "STATE_ABBREVIATION",
               COUNT(DISTINCT "ID_RSSD") AS "cnt20"
        FROM FINANCE__ECONOMICS.CYBERSYN.FINANCIAL_BRANCH_ENTITIES
        WHERE "START_DATE" <= '2020-03-01'
          AND ("END_DATE" IS NULL OR "END_DATE" >= '2020-03-01')
          AND "CATEGORY" = 'Branch'
          AND "ID_COUNTRY" = 'country/USA'
        GROUP BY "STATE_ABBREVIATION"
    ),
    dec21 AS (
        SELECT "STATE_ABBREVIATION",
               COUNT(DISTINCT "ID_RSSD") AS "cnt21"
        FROM FINANCE__ECONOMICS.CYBERSYN.FINANCIAL_BRANCH_ENTITIES
        WHERE "START_DATE" <= '2021-12-31'
          AND ("END_DATE" IS NULL OR "END_DATE" >= '2021-12-31')
          AND "CATEGORY" = 'Branch'
          AND "ID_COUNTRY" = 'country/USA'
        GROUP BY "STATE_ABBREVIATION"
    )
    SELECT COALESCE(m."STATE_ABBREVIATION", d."STATE_ABBREVIATION") AS "STATE",
           m."cnt20",
           d."cnt21",
           (d."cnt21" - m."cnt20") AS "net_change"
    FROM march20 m
    FULL JOIN dec21 d USING ("STATE_ABBREVIATION")
)
SELECT *
FROM summary
ORDER BY "net_change" ASC
LIMIT 20;
