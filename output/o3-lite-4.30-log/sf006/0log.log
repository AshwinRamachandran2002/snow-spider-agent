--4. Description: Check a few branches that were already open by 2020‑03‑01.
SELECT "ID_RSSD",
       "STATE_ABBREVIATION",
       "START_DATE",
       "END_DATE"
FROM FINANCE__ECONOMICS.CYBERSYN.FINANCIAL_BRANCH_ENTITIES
WHERE "START_DATE" <= '2020-03-01'
