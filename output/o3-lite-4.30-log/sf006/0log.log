--7. Description: Combine the two snapshots and compute % change.
WITH march20 AS (
    SELECT "STATE_ABBREVIATION",
           COUNT(DISTINCT "ID_RSSD") AS "cnt_20200301"
    FROM FINANCE__ECONOMICS.CYBERSYN.FINANCIAL_BRANCH_ENTITIES
    WHERE "START_DATE" <= '2020-03-01'
      AND ("END_DATE" IS NULL OR "END_DATE" >= '2020-03-01')
      AND "CATEGORY" = 'Branch'
      AND "ID_COUNTRY" = 'country/USA'
    GROUP BY "STATE_ABBREVIATION"
),
dec21 AS (
    SELECT "STATE_ABBREVIATION",
           COUNT(DISTINCT "ID_RSSD") AS "cnt_20211231"
    FROM FINANCE__ECONOMICS.CYBERSYN.FINANCIAL_BRANCH_ENTITIES
    WHERE "START_DATE" <= '2021-12-31'
      AND ("END_DATE" IS NULL OR "END_DATE" >= '2021-12-31')
      AND "CATEGORY" = 'Branch'
      AND "ID_COUNTRY" = 'country/USA'
    GROUP BY "STATE_ABBREVIATION"
)
SELECT COALESCE(m."STATE_ABBREVIATION", d."STATE_ABBREVIATION") AS "STATE",
       m."cnt_20200301",
       d."cnt_20211231",
       ROUND(100.0 * (d."cnt_20211231" - m."cnt_20200301") / NULLIF(m."cnt_20200301",0), 2) AS "pct_change"
FROM march20 m
FULL JOIN dec21 d
  ON m."STATE_ABBREVIATION" = d."STATE_ABBREVIATION"
ORDER BY "pct_change" DESC
LIMIT 20;
