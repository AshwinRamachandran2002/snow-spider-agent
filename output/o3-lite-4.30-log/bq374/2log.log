```sql
--Description:
-- 9. List up to 20 users whose first recorded session between 2016‑08‑01 and
--    2017‑04‑30 (a) was a new‑visitor session that lasted >5 min and who
--    (b) made at least one purchase in any later session (any day).
WITH first_visit AS (
  SELECT
    fullVisitorId,
    MIN(visitStartTime) AS first_ts
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
    AND totals.newVisits = 1
    AND totals.timeOnSite > 300
  GROUP BY fullVisitorId
),
buyers AS (
  SELECT DISTINCT fullVisitorId
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
    AND totals.transactions IS NOT NULL
    AND totals.transactions > 0
)
SELECT first_visit.fullVisitorId
FROM first_visit
JOIN buyers USING (fullVisitorId)
LIMIT 20;
```

```sql
--Description:
-- 10. Compute the required percentage for the whole period (2016‑08‑01 …
--     2017‑04‑30).  Numerator = new users whose *first* session lasted >5 min
--     AND who made a purchase in any later session.  Denominator = all new
--     users in that period.
WITH all_new_users AS (
  SELECT DISTINCT fullVisitorId
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
    AND totals.newVisits = 1
),
long_first AS (
  SELECT
    fullVisitorId,
    MIN(visitStartTime) AS first_ts
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
    AND totals.newVisits = 1
    AND totals.timeOnSite > 300
  GROUP BY fullVisitorId
),
buyers AS (
  SELECT DISTINCT fullVisitorId
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
    AND totals.transactions IS NOT NULL
    AND totals.transactions > 0
),
qualified AS (
  SELECT DISTINCT l.fullVisitorId
  FROM long_first AS l
  JOIN buyers     AS b USING (fullVisitorId)
)
SELECT
  (SELECT COUNT(*) FROM qualified) AS new_users_long_visit_and_purchase,
  (SELECT COUNT(*) FROM all_new_users) AS total_new_users,
  SAFE_DIVIDE(
    (SELECT COUNT(*) FROM qualified),
    (SELECT COUNT(*) FROM all_new_users)
  ) AS percentage;
