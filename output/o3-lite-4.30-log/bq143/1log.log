```sql
WITH matched AS (
  /*--------------------------------------------------------------------
    1.  Map proteome sample UUIDs to CPTAC barcodes and attach RNA‑seq
        expression for the same gene in the same sample.
  --------------------------------------------------------------------*/
  SELECT
      m.sample_type,                                     -- 'Primary Tumor' / 'Solid Tissue Normal'
      p.gene_symbol      AS gene_name,
      p.protein_abundance_log2ratio                     AS protein_log2ratio,
      LOG(r.fpkm_unstranded + 1 , 2)                    AS log2_fpkm
  FROM  `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`        AS p
  JOIN  `isb-cgc-bq.PDC_metadata.aliquot_to_case_mapping_current`  AS m
          ON p.sample_id = m.sample_id
         AND m.project_name = 'CPTAC CCRCC Discovery Study'
  JOIN  `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                   AS r
          ON m.sample_submitter_id = r.sample_barcode
         AND r.gene_name          = p.gene_symbol
  WHERE m.sample_type IN ('Primary Tumor','Solid Tissue Normal')
),

per_gene_corr AS (
  /*--------------------------------------------------------------------
    2.  Correlation of protein vs. RNA for each gene within each sample
        type (tumor vs normal).
  --------------------------------------------------------------------*/
  SELECT
      sample_type,
      gene_name,
      CORR(log2_fpkm, protein_log2ratio) AS r_val
  FROM matched
  GROUP BY sample_type, gene_name
  HAVING ABS(r_val) > 0.5                       -- keep strong correlations
)

 /*--------------------------------------------------------------------
   3.  Average of the strong per‑gene correlations for each sample type.
  --------------------------------------------------------------------*/
SELECT
    sample_type,
    AVG(r_val) AS average_correlation
FROM per_gene_corr
GROUP BY sample_type
ORDER BY sample_type;
```
