```sql
--Description: 7.  Per‑gene correlation for PRIMARY TUMOR samples; sample_type
--              filter replaces the earlier project_name restriction.
SELECT
    gene_name,
    CORR(log2_fpkm, protein_log2) AS r_primary
FROM (
    SELECT
        p.gene_symbol                    AS gene_name,
        LOG2(r.fpkm_unstranded + 1)      AS log2_fpkm,
        p.protein_abundance_log2ratio    AS protein_log2
    FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                        AS r
    JOIN   `isb-cgc-bq.PDC_metadata.aliquot_to_case_mapping_current`         AS m
      ON   r.sample_barcode = m.sample_submitter_id
    JOIN   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
      ON   m.sample_id   = p.sample_id
      AND  p.gene_symbol = r.gene_name
    WHERE  m.sample_type = 'Primary Tumor'
)
GROUP BY gene_name
LIMIT 20;
```

```sql
--Description: 8.  Per‑gene correlation for SOLID TISSUE NORMAL samples; no
--              project_name filter, only sample_type.
SELECT
    gene_name,
    CORR(log2_fpkm, protein_log2) AS r_normal
FROM (
    SELECT
        p.gene_symbol                 AS gene_name,
        LOG2(r.fpkm_unstranded + 1)   AS log2_fpkm,
        p.protein_abundance_log2ratio AS protein_log2
    FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                        AS r
    JOIN   `isb-cgc-bq.PDC_metadata.aliquot_to_case_mapping_current`         AS m
      ON   r.sample_barcode = m.sample_submitter_id
    JOIN   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
      ON   m.sample_id   = p.sample_id
      AND  p.gene_symbol = r.gene_name
    WHERE  m.sample_type = 'Solid Tissue Normal'
)
GROUP BY gene_name
LIMIT 20;
```

```sql
--Description: 9.  For Primary Tumor samples, retain only genes with |r|>0.5 and
--              list the strongest positive/negative correlations.  The join
--              uses sample_type instead of project_name.
SELECT *
FROM (
    SELECT
        gene_name,
        CORR(log2_fpkm, protein_log2) AS r_primary
    FROM (
        SELECT
            p.gene_symbol                 AS gene_name,
            LOG2(r.fpkm_unstranded + 1)   AS log2_fpkm,
            p.protein_abundance_log2ratio AS protein_log2
        FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                        AS r
        JOIN   `isb-cgc-bq.PDC_metadata.aliquot_to_case_mapping_current`         AS m
          ON   r.sample_barcode = m.sample_submitter_id
        JOIN   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
          ON   m.sample_id   = p.sample_id
          AND  p.gene_symbol = r.gene_name
        WHERE  m.sample_type = 'Primary Tumor'
    )
    GROUP BY gene_name
)
WHERE ABS(r_primary) > 0.5
ORDER BY r_primary DESC
LIMIT 20;
```

```sql
--Description: 10. Compute the average correlation (after |r|>0.5 filter) for
--              each sample_type (Primary Tumor vs Solid Tissue Normal).  Uses
--              sample_type filter directly and omits project_name.
WITH corr AS (
    SELECT
        m.sample_type,
        p.gene_symbol                 AS gene_name,
        CORR(LOG2(r.fpkm_unstranded + 1), p.protein_abundance_log2ratio) AS r_val
    FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                        AS r
    JOIN   `isb-cgc-bq.PDC_metadata.aliquot_to_case_mapping_current`         AS m
      ON   r.sample_barcode = m.sample_submitter_id
    JOIN   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
      ON   m.sample_id   = p.sample_id
      AND  p.gene_symbol = r.gene_name
    WHERE  m.sample_type IN ('Primary Tumor', 'Solid Tissue Normal')
    GROUP BY m.sample_type, p.gene_symbol
    HAVING ABS(r_val) > 0.5
)
SELECT
    sample_type,
    AVG(r_val) AS avg_correlation_after_filter
FROM corr
GROUP BY sample_type
LIMIT 20;
```
