Successfully corrected. SQL:
--Description:
-- We need to correlate protein abundance with RNA expression for Clear‑Cell RCC (Kidney) samples
-- from the CPTAC‑3 project.  The proteome values (already log2‑ratio) live in the CCRCC discovery
-- study table.  To match them with RNA‑Seq we must translate proteome sample UUIDs to the
-- submitter‑style barcodes found in RNAseq_hg38_gdc_current; PDC_metadata.aliquot_to_case_mapping_current
-- performs that mapping.  After joining on both sample and gene symbol we:
--   • keep only “Primary Tumor” and “Solid Tissue Normal” rows,
--   • log2‑transform RNA expression using LOG(x,2) (BigQuery has no LOG2),
--   • obtain a Pearson correlation per gene within each sample‑type,
--   • retain genes whose |ρ| > 0.5,
--   • and finally average these filtered correlations by sample‑type.
-- The result shows, for each tissue category, the mean correlation and the number of genes
-- that passed the absolute‑correlation threshold.

WITH expr AS (
  SELECT
    r.sample_type_name,
    p.gene_symbol,
    p.protein_abundance_log2ratio                    AS prot_log2,
    LOG(r.fpkm_unstranded + 1, 2)                    AS rna_log2
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
  JOIN `isb-cgc-bq.PDC_metadata.aliquot_to_case_mapping_current` AS m
        ON p.sample_id = m.sample_id
  JOIN `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current` AS r
        ON m.sample_submitter_id = r.sample_barcode
       AND p.gene_symbol         = r.gene_name
  WHERE r.primary_site       = 'Kidney'
    AND r.project_short_name = 'CPTAC-3'
    AND r.sample_type_name  IN ('Primary Tumor', 'Solid Tissue Normal')
),
gene_corr AS (
  SELECT
    gene_symbol,
    sample_type_name,
    CORR(prot_log2, rna_log2) AS corr_coef
  FROM expr
  GROUP BY gene_symbol, sample_type_name
  HAVING ABS(corr_coef) > 0.5
)
SELECT
  sample_type_name,
  AVG(corr_coef) AS avg_filtered_corr,
  COUNT(*)       AS n_genes
FROM gene_corr
GROUP BY sample_type_name
ORDER BY sample_type_name;
