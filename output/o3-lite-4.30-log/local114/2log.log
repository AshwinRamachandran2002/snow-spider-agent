```sql
--Description: Build the complete “web sales by region” report in one query.
--             Thinking process:
--             1. Region summary (rsum): count of orders and total sales dollars
--                – orders → accounts → reps → region.
--             2. Rep totals (rep_rs): total sales by each rep within each region.
--             3. Max table (mx): for every region find the maximum rep‑sales $.
--             4. treps: keep only reps whose totals equal mx.max_amt, then
--                GROUP_CONCAT their names (handles ties) and carry the amount.
--             5. Join rsum with treps on region_name to deliver the final view.
SELECT rsum.region_name,
       rsum.num_orders,
       rsum.region_total_sales,
       treps.top_sales_reps,
       treps.top_sales_amount
FROM (
      /* 1. Region‑level order count & total sales */
      SELECT r.name                     AS region_name,
             COUNT(o.id)                AS num_orders,
             SUM(o.total_amt_usd)       AS region_total_sales
      FROM   web_orders      AS o
      JOIN   web_accounts    AS a  ON a.id = o.account_id
      JOIN   web_sales_reps  AS sr ON sr.id = a.sales_rep_id
      JOIN   web_region      AS r  ON r.id = sr.region_id
      GROUP  BY r.id
) AS rsum
JOIN (
      /* 2‑4. Find tied top reps in each region */
      SELECT rep_rs.region_name,
             GROUP_CONCAT(rep_rs.sales_rep_name, ', ') AS top_sales_reps,
             MAX(rep_rs.total_sales_amt)               AS top_sales_amount
      FROM (
            /* 2. Rep‑level totals per region */
            SELECT r.name                AS region_name,
                   sr.name               AS sales_rep_name,
                   SUM(o.total_amt_usd)  AS total_sales_amt
            FROM   web_orders      AS o
            JOIN   web_accounts    AS a  ON a.id = o.account_id
            JOIN   web_sales_reps  AS sr ON sr.id = a.sales_rep_id
            JOIN   web_region      AS r  ON r.id = sr.region_id
            GROUP  BY r.id, sr.id
      ) AS rep_rs
      JOIN (
            /* 3. Maximum rep total in each region */
            SELECT region_name,
                   MAX(total_sales_amt) AS max_amt
            FROM (
                  SELECT r.name               AS region_name,
                         sr.id,
                         SUM(o.total_amt_usd) AS total_sales_amt
                  FROM   web_orders      AS o
                  JOIN   web_accounts    AS a  ON a.id = o.account_id
                  JOIN   web_sales_reps  AS sr ON sr.id = a.sales_rep_id
                  JOIN   web_region      AS r  ON r.id = sr.region_id
                  GROUP  BY r.id, sr.id
            ) AS inn
            GROUP BY region_name
      ) AS mx
        ON  mx.region_name = rep_rs.region_name
       AND mx.max_amt      = rep_rs.total_sales_amt
      GROUP BY rep_rs.region_name
) AS treps
  ON treps.region_name = rsum.region_name
LIMIT 20;
