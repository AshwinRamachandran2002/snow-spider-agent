    SELECT
        rg.id                 AS region_id,
        rg.name               AS region,
        COUNT(o.id)           AS total_orders,
        SUM(o.total_amt_usd)  AS total_sales_amount
    FROM web_orders      o
    JOIN web_accounts    a  ON o.account_id   = a.id
    JOIN web_sales_reps  r  ON a.sales_rep_id = r.id
    JOIN web_region      rg ON r.region_id    = rg.id
    GROUP BY rg.id
)
