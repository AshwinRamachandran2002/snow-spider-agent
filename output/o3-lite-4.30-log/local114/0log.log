    tr.top_sales_rep_name                             AS top_sales_rep_name,
    ROUND(tr.top_sales_rep_sales_amount,4)            AS top_sales_rep_sales_amount
FROM region_totals rt
LEFT JOIN top_reps tr
       ON rt.region_id = tr.region_id
ORDER BY rt.region;
