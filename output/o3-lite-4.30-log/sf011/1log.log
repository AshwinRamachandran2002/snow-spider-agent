```sql
--Description: Identify New York (StateFIPS = '36') block groups whose 2021 ACS total‑population
--             (MetricID = 'B01003_001E') represents more than 50 % of their parent census tract.
-- Thinking process:
--   1) Pull block‑group population rows from Fact_CensusValues_ACS2021 and attach geography data.
--   2) Aggregate those rows to get tract‑level totals; drop any tracts whose total = 0
--      so division can’t fail.
--   3) Re‑join block groups to their tract totals; calculate ratio using NULLIF to guard
--      against divide‑by‑zero just in case.
--   4) Filter ratio > 0.5 and show a sample of 20 rows.
WITH ny_bg AS (   -- step 1
    SELECT f."BlockGroupID",
           g."StateCountyTractID",
           f."CensusValue" AS "BlockGroupPop"
    FROM "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021" f
    JOIN "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Dim_CensusGeography" g
      ON f."BlockGroupID" = g."BlockGroupID"
    WHERE f."MetricID"  = 'B01003_001E'
      AND g."StateFIPS" = '36'
),
tract_tot AS (    -- step 2
    SELECT "StateCountyTractID",
           SUM("BlockGroupPop") AS "TractPop"
    FROM ny_bg
    GROUP BY "StateCountyTractID"
    HAVING SUM("BlockGroupPop") > 0
)
SELECT b."BlockGroupID",
       b."StateCountyTractID",
       b."BlockGroupPop",
       t."TractPop",
       b."BlockGroupPop" / NULLIF(t."TractPop",0) AS "PopRatio_BG_to_Tract"
FROM ny_bg b      -- step 3
JOIN tract_tot t
  ON b."StateCountyTractID" = t."StateCountyTractID"
WHERE b."BlockGroupPop" / NULLIF(t."TractPop",0) > 0.5   -- step 4
LIMIT 20;
