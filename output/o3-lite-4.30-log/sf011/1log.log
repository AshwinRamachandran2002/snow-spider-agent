Begin Exploring Related Columns
Relevant columns and their potential usage  
• Fact_CensusValues_ACS2021."MetricID": filter to total–population metric ('B01003_001E').  
• Fact_CensusValues_ACS2021."BlockGroupID": identify each block‑group; join to geography table.  
• Fact_CensusValues_ACS2021."CensusValue": block‑group population.  
• Dim_CensusGeography."BlockGroupID": join key to facts.  
• Dim_CensusGeography."StateCountyTractID": parent tract for each block‑group.  
• Dim_CensusGeography."StateFIPS": limit to New York ('36').  
• Dim_CensusGeography."StateAbbrev" / "StateName": alternate New York filter.  
Conditions likely used  
• Fact_CensusValues_ACS2021."MetricID" = 'B01003_001E'  
• Dim_CensusGeography."StateFIPS"   = '36'   (or "StateAbbrev" = 'NY')  

Below are 10 exploratory → final SQL statements (each limited to 20 rows) wrapped in comments that explain the step.

```sql
-- 1. Inspect all distinct metric IDs present in the block‑group fact table
SELECT DISTINCT "MetricID"
FROM "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021"
LIMIT 20;
```

```sql
-- 2. Preview raw population records (MetricID = total population) for any state
SELECT "BlockGroupID",
       "MetricID",
       "CensusValue"
FROM "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021"
WHERE "MetricID" = 'B01003_001E'
LIMIT 20;
```

```sql
-- 3. Join facts to geography to see New York block‑groups with their tract IDs
SELECT f."BlockGroupID",
       g."StateCountyTractID",
       f."CensusValue"
FROM "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021" f
JOIN "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Dim_CensusGeography" g
  ON f."BlockGroupID" = g."BlockGroupID"
WHERE f."MetricID"  = 'B01003_001E'
  AND g."StateFIPS" = '36'
LIMIT 20;
```

```sql
-- 4. Calculate total population per tract inside New York (CTE style)
WITH ny_bg AS (
  SELECT g."StateCountyTractID",
         f."CensusValue"
  FROM "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021" f
  JOIN "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Dim_CensusGeography" g
    ON f."BlockGroupID" = g."BlockGroupID"
  WHERE f."MetricID"  = 'B01003_001E'
    AND g."StateFIPS" = '36'
)
SELECT "StateCountyTractID",
       SUM("CensusValue") AS "TractPopulation"
FROM ny_bg
GROUP BY "StateCountyTractID"
LIMIT 20;
```

```sql
-- 5. Display largest 20 tracts by total population in NY
WITH ny_bg AS (
  SELECT g."StateCountyTractID",
         f."CensusValue"
  FROM "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021" f
  JOIN "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Dim_CensusGeography" g
    ON f."BlockGroupID" = g."BlockGroupID"
  WHERE f."MetricID"  = 'B01003_001E'
    AND g."StateFIPS" = '36'
),
tract_tot AS (
  SELECT "StateCountyTractID",
         SUM("CensusValue") AS "TractPopulation"
  FROM ny_bg
  GROUP BY "StateCountyTractID"
)
SELECT *
FROM tract_tot
ORDER BY "TractPopulation" DESC
LIMIT 20;
```

```sql
-- 6. Combine block‑group pop with tract totals to compute intra‑tract ratio
WITH ny_bg AS (
  SELECT f."BlockGroupID",
         g."StateCountyTractID",
         f."CensusValue"
  FROM "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021" f
  JOIN "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Dim_CensusGeography" g
    ON f."BlockGroupID" = g."BlockGroupID"
  WHERE f."MetricID" = 'B01003_001E'
    AND g."StateFIPS" = '36'
),
tract_tot AS (
  SELECT "StateCountyTractID",
         SUM("CensusValue") AS "TractPop"
  FROM ny_bg
  GROUP BY "StateCountyTractID"
)
SELECT b."BlockGroupID",
       b."StateCountyTractID",
       b."CensusValue"        AS "BlockGroupPop",
       t."TractPop",
       b."CensusValue"/t."TractPop" AS "PopRatio_BG_to_Tract"
FROM ny_bg b
JOIN tract_tot t
  ON b."StateCountyTractID" = t."StateCountyTractID"
LIMIT 20;
```

```sql
-- 7. Focus on block‑groups that constitute more than 50% of their tract
WITH ny_bg AS (
  SELECT f."BlockGroupID",
         g."StateCountyTractID",
         f."CensusValue"
  FROM "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021" f
  JOIN "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Dim_CensusGeography" g
    ON f."BlockGroupID" = g."BlockGroupID"
  WHERE f."MetricID" = 'B01003_001E'
    AND g."StateFIPS" = '36'
),
tract_tot AS (
  SELECT "StateCountyTractID",
         SUM("CensusValue") AS "TractPop"
  FROM ny_bg
  GROUP BY "StateCountyTractID"
)
SELECT b."BlockGroupID",
       b."StateCountyTractID",
       b."CensusValue",
       t."TractPop",
       b."CensusValue"/t."TractPop" AS "PopRatio"
FROM ny_bg b
JOIN tract_tot t
  ON b."StateCountyTractID" = t."StateCountyTractID"
WHERE b."CensusValue"/t."TractPop" > 0.5
LIMIT 20;
```

```sql
-- 8. Same computation but using QUALIFY to retrieve top‑two populous block‑groups per tract
WITH ny_bg AS (
  SELECT f."BlockGroupID",
         g."StateCountyTractID",
         f."CensusValue"
  FROM "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021" f
  JOIN "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Dim_CensusGeography" g
    ON f."BlockGroupID" = g."BlockGroupID"
  WHERE f."MetricID" = 'B01003_001E'
    AND g."StateFIPS" = '36'
),
tract_tot AS (
  SELECT "StateCountyTractID",
         SUM("CensusValue") AS "TractPop"
  FROM ny_bg
  GROUP BY "StateCountyTractID"
)
SELECT b."BlockGroupID",
       b."StateCountyTractID",
       b."CensusValue",
       t."TractPop",
       b."CensusValue"/t."TractPop" AS "PopRatio",
       ROW_NUMBER() OVER (PARTITION BY b."StateCountyTractID"
                          ORDER BY b."CensusValue" DESC) AS "rk"
FROM ny_bg b
JOIN tract_tot t
  ON b."StateCountyTractID" = t."StateCountyTractID"
QUALIFY "rk" <= 2
LIMIT 20;
```

```sql
-- 9. Display distribution statistics of the ratio (min/max/avg) by county
WITH ny_bg AS (
  SELECT f."BlockGroupID",
         g."StateCountyTractID",
         g."CountyFIPS",
         f."CensusValue"
  FROM "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021" f
  JOIN "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Dim_CensusGeography" g
    ON f."BlockGroupID" = g."BlockGroupID"
  WHERE f."MetricID" = 'B01003_001E'
    AND g."StateFIPS" = '36'
),
tract_tot AS (
  SELECT "StateCountyTractID",
         SUM("CensusValue") AS "TractPop"
  FROM ny_bg
  GROUP BY "StateCountyTractID"
),
bg_ratio AS (
  SELECT b."CountyFIPS",
         b."StateCountyTractID",
         b."CensusValue"/t."TractPop" AS "Ratio"
  FROM ny_bg b
  JOIN tract_tot t
    ON b."StateCountyTractID" = t."StateCountyTractID"
)
SELECT "CountyFIPS",
       MIN("Ratio") AS "MinRatio",
       MAX("Ratio") AS "MaxRatio",
       AVG("Ratio") AS "AvgRatio"
FROM bg_ratio
GROUP BY "CountyFIPS"
LIMIT 20;
```

```sql
-- 10. Final query: full list of NY block‑groups with population, tract pop, and ratio
WITH ny_bg AS (
