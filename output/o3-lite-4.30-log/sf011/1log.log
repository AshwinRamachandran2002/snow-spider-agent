)
SELECT b."BlockGroupID",
       b."StateCountyTractID",
       b."CensusValue"               AS "BlockGroupPopulation",
       t."TractPopulation",
       b."CensusValue"/t."TractPopulation" AS "PopulationRatio_BG_to_Tract"
FROM ny_bg b
JOIN tract_tot t
  ON b."StateCountyTractID" = t."StateCountyTractID"
LIMIT 20;
