```sql
-- 6. Combine block‑group pop with tract totals to compute intra‑tract ratio
WITH ny_bg AS (
  SELECT f."BlockGroupID",
         g."StateCountyTractID",
         f."CensusValue"
  FROM "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021" f
  JOIN "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Dim_CensusGeography" g
    ON f."BlockGroupID" = g."BlockGroupID"
  WHERE f."MetricID" = 'B01003_001E'
    AND g."StateFIPS" = '36'
),
tract_tot AS (
  SELECT "StateCountyTractID",
         SUM("CensusValue") AS "TractPop"
  FROM ny_bg
  GROUP BY "StateCountyTractID"
)
SELECT b."BlockGroupID",
       b."StateCountyTractID",
       b."CensusValue"        AS "BlockGroupPop",
       t."TractPop",
       b."CensusValue"/t."TractPop" AS "PopRatio_BG_to_Tract"
FROM ny_bg b
JOIN tract_tot t
  ON b."StateCountyTractID" = t."StateCountyTractID"
LIMIT 20;
```

```sql
-- 7. Focus on block‑groups that constitute more than 50% of their tract
WITH ny_bg AS (
  SELECT f."BlockGroupID",
         g."StateCountyTractID",
         f."CensusValue"
  FROM "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021" f
  JOIN "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Dim_CensusGeography" g
    ON f."BlockGroupID" = g."BlockGroupID"
  WHERE f."MetricID" = 'B01003_001E'
    AND g."StateFIPS" = '36'
),
tract_tot AS (
  SELECT "StateCountyTractID",
         SUM("CensusValue") AS "TractPop"
  FROM ny_bg
  GROUP BY "StateCountyTractID"
)
SELECT b."BlockGroupID",
       b."StateCountyTractID",
       b."CensusValue",
       t."TractPop",
       b."CensusValue"/t."TractPop" AS "PopRatio"
FROM ny_bg b
JOIN tract_tot t
  ON b."StateCountyTractID" = t."StateCountyTractID"
WHERE b."CensusValue"/t."TractPop" > 0.5
LIMIT 20;
```

```sql
-- 8. Same computation but using QUALIFY to retrieve top‑two populous block‑groups per tract
WITH ny_bg AS (
  SELECT f."BlockGroupID",
         g."StateCountyTractID",
         f."CensusValue"
  FROM "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021" f
  JOIN "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Dim_CensusGeography" g
    ON f."BlockGroupID" = g."BlockGroupID"
  WHERE f."MetricID" = 'B01003_001E'
    AND g."StateFIPS" = '36'
),
tract_tot AS (
  SELECT "StateCountyTractID",
         SUM("CensusValue") AS "TractPop"
  FROM ny_bg
  GROUP BY "StateCountyTractID"
)
SELECT b."BlockGroupID",
       b."StateCountyTractID",
       b."CensusValue",
       t."TractPop",
       b."CensusValue"/t."TractPop" AS "PopRatio",
       ROW_NUMBER() OVER (PARTITION BY b."StateCountyTractID"
                          ORDER BY b."CensusValue" DESC) AS "rk"
FROM ny_bg b
JOIN tract_tot t
  ON b."StateCountyTractID" = t."StateCountyTractID"
QUALIFY "rk" <= 2
LIMIT 20;
```

```sql
-- 9. Display distribution statistics of the ratio (min/max/avg) by county
WITH ny_bg AS (
  SELECT f."BlockGroupID",
         g."StateCountyTractID",
         g."CountyFIPS",
         f."CensusValue"
  FROM "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021" f
  JOIN "CENSUS_GALAXY__ZIP_CODE_TO_BLOCK_GROUP_SAMPLE"."PUBLIC"."Dim_CensusGeography" g
    ON f."BlockGroupID" = g."BlockGroupID"
  WHERE f."MetricID" = 'B01003_001E'
    AND g."StateFIPS" = '36'
),
tract_tot AS (
  SELECT "StateCountyTractID",
         SUM("CensusValue") AS "TractPop"
  FROM ny_bg
  GROUP BY "StateCountyTractID"
),
bg_ratio AS (
  SELECT b."CountyFIPS",
         b."StateCountyTractID",
         b."CensusValue"/t."TractPop" AS "Ratio"
  FROM ny_bg b
  JOIN tract_tot t
    ON b."StateCountyTractID" = t."StateCountyTractID"
)
SELECT "CountyFIPS",
       MIN("Ratio") AS "MinRatio",
       MAX("Ratio") AS "MaxRatio",
       AVG("Ratio") AS "AvgRatio"
FROM bg_ratio
GROUP BY "CountyFIPS"
LIMIT 20;
```

