--Description: Identify all distinct simple‑family IDs that cite any publication belonging
--             to family 48988161.  We first gather that family’s publication_numbers,
--             then scan every other publication’s “citation” array for matching
--             publication_numbers.  Distinct family_ids of those citing publications
--             are returned, sorted alphabetically and limited to 20.
WITH my_pubs AS (
    SELECT DISTINCT "publication_number"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE "family_id" = '48988161'
)
SELECT DISTINCT
       q."family_id" AS "citing_family_id"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS q,
     LATERAL FLATTEN(input => q."citation") c
WHERE c.value:"publication_number"::STRING IN (SELECT "publication_number" FROM my_pubs)
ORDER BY "citing_family_id"
LIMIT 20;
```

```sql
--Description: Prototype end‑to‑end aggregation for every family whose earliest
--             publication date falls in January 2015.  For each family we return:
--               • earliest publication date
--               • all publication numbers and country codes
--               • distinct CPC and IPC codes
--               • distinct cited publication numbers (not family_ids, because citation
--                 objects store "publication_number")
--               • distinct family_ids that cite any of the family’s publications.
--             Limited to 20 rows for inspection.
WITH jan15 AS (
    SELECT 
        "family_id",
        MIN("publication_date") AS "earliest_pub_date"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE "publication_date" BETWEEN 20150101 AND 20150131
    GROUP BY "family_id"
)
SELECT 
    j."family_id",
    j."earliest_pub_date",
    ARRAY_AGG(DISTINCT p."publication_number")           AS "pub_numbers",
    ARRAY_AGG(DISTINCT p."country_code")                 AS "country_codes",
    ARRAY_AGG(DISTINCT cpc_f.value:"code"::STRING)       AS "cpc_codes",
    ARRAY_AGG(DISTINCT ipc_f.value:"code"::STRING)       AS "ipc_codes",
    ARRAY_AGG(DISTINCT cit_f.value:"publication_number"::STRING) AS "cited_publications",
    ARRAY_AGG(DISTINCT citing."family_id")               AS "citing_families"
FROM jan15 j
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
  ON p."family_id" = j."family_id"
LEFT JOIN LATERAL FLATTEN(input => p."cpc")            cpc_f ON TRUE
LEFT JOIN LATERAL FLATTEN(input => p."ipc")            ipc_f ON TRUE
LEFT JOIN LATERAL FLATTEN(input => p."citation")       cit_f ON TRUE
LEFT JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS citing
  ON EXISTS (
       SELECT 1
       FROM LATERAL FLATTEN(input => citing."citation") cf
       WHERE cf.value:"publication_number"::STRING = p."publication_number"
     )
GROUP BY j."family_id", j."earliest_pub_date"
LIMIT 20;
```
