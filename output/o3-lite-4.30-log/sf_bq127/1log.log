```sql
-- 9. Find families that cite our family (reverse lookup) via publication_number match
WITH my_pubs AS (
    SELECT DISTINCT "publication_number"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE "family_id" = 'YOUR_FAMILY_ID'
)
SELECT DISTINCT
    q."family_id" AS "citing_family_id"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS q,
     LATERAL FLATTEN(input => q."citation") c,
     my_pubs m
WHERE c.value:"number"::STRING = m."publication_number"
ORDER BY "citing_family_id"
LIMIT 20;
