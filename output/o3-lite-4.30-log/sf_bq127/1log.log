-- 10. (Prototype) Pull everything together for all families with earliest pub in Jan‑2015
WITH jan15 AS (
    SELECT 
        "family_id",
        MIN("publication_date") AS "earliest_pub_date"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE "publication_date" BETWEEN 20150101 AND 20150131
    GROUP BY "family_id"
)
SELECT 
    j."family_id",
    j."earliest_pub_date",
    ARRAY_AGG(DISTINCT p."publication_number") AS "pub_numbers",
    ARRAY_AGG(DISTINCT p."country_code")      AS "country_codes",
    ARRAY_AGG(DISTINCT cpc_f.value:"code"::STRING) AS "cpc_codes",
    ARRAY_AGG(DISTINCT ipc_f.value:"code"::STRING) AS "ipc_codes",
    ARRAY_AGG(DISTINCT cited_fam.value:"family_id"::STRING) AS "cited_families",
    ARRAY_AGG(DISTINCT citing."family_id")                   AS "citing_families"
FROM jan15 j
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
  ON p."family_id" = j."family_id"
LEFT JOIN LATERAL FLATTEN(input => p."cpc")  cpc_f ON TRUE
LEFT JOIN LATERAL FLATTEN(input => p."ipc")  ipc_f ON TRUE
LEFT JOIN LATERAL FLATTEN(input => p."citation") cited_fam ON TRUE
LEFT JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS citing
  ON EXISTS (
       SELECT 1
       FROM LATERAL FLATTEN(input => citing."citation") cit_f
       WHERE cit_f.value:"number"::STRING = p."publication_number"
     )
GROUP BY j."family_id", j."earliest_pub_date"
LIMIT 20;
```

