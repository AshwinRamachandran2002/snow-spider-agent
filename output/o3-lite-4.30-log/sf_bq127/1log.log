```sql
--Description: Determine whether any publication in the PUBLICATIONS table cites the
--             target document “US‑2015006794‑A1”, while ignoring punctuation and kind
--             codes.  We:
--               • Flatten every publication’s “citation” array (alias c).
--               • Normalise the cited publication_number by stripping all non‑digits
--                 with REGEXP_REPLACE and compare the result to ‘2015006794’.
--               • Return the distinct family_ids of publications that contain such a
--                 citation, excluding the target family itself (48988161).
--             If the query returns zero rows, it confirms no families currently cite
--             the target publication in the dataset.
SELECT DISTINCT
       q."family_id" AS "citing_family_id"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS q,
     LATERAL FLATTEN(input => q."citation") c
WHERE REGEXP_REPLACE(c.value:"publication_number"::STRING, '[^0-9]', '') = '2015006794'
  AND q."family_id" <> '48988161'
ORDER BY "citing_family_id"
LIMIT 20;
```
