```sql
/* -----------------------------------------------------------
   Families whose very first publication appeared in Jan‑2015
   ----------------------------------------------------------- */
WITH earliest AS (     -- first publication date per family
    SELECT
        "family_id",
        MIN("publication_date") AS earliest_publication_date
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    GROUP BY "family_id"
    HAVING earliest_publication_date BETWEEN 20150101 AND 20150131
),
pub AS (               -- all publications in those families
    SELECT  p.*,
            e.earliest_publication_date
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    JOIN earliest e
      ON p."family_id" = e."family_id"
),
my_pub AS (            -- helper: (family , publication_number)
    SELECT DISTINCT "family_id",
                    "publication_number"
    FROM pub
),
/* ---------- families that CITE one of our publications -------- */
citing AS (
    /* case A: citation lists our publication number */
    SELECT DISTINCT
           mp."family_id"               AS family_id,
           q."family_id"                AS citing_family_id
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS  q ,
         LATERAL FLATTEN(input => q."citation")      cit ,
         my_pub                                      mp
    WHERE cit.value:"publication_number"::STRING = mp."publication_number"
      AND q."family_id" <> mp."family_id"

    UNION DISTINCT

    /* case B: citation lists our family id directly */
    SELECT DISTINCT
           e."family_id"                AS family_id,
           q."family_id"                AS citing_family_id
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS  q ,
         LATERAL FLATTEN(input => q."citation")      cit ,
         earliest                                   e
    WHERE cit.value:"family_id"::STRING = e."family_id"
      AND q."family_id" <> e."family_id"
),
/* ---------- families that ARE CITED by our family ------------- */
cited AS (
    /* case A: we cite by publication number */
    SELECT DISTINCT
           p."family_id"                AS family_id,
           p2."family_id"               AS cited_family_id
    FROM pub                                           p ,
         LATERAL FLATTEN(input => p."citation")        cit ,
         PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS    p2
    WHERE p2."publication_number" = cit.value:"publication_number"::STRING
      AND p2."family_id"      <> p."family_id"

    UNION DISTINCT

    /* case B: we cite by family id directly */
    SELECT DISTINCT
           p."family_id"                AS family_id,
           cit.value:"family_id"::STRING AS cited_family_id
    FROM pub                                        p ,
         LATERAL FLATTEN(input => p."citation")     cit
    WHERE cit.value:"family_id" IS NOT NULL
      AND cit.value:"family_id"::STRING <> p."family_id"
)
/* -------------------- final result ---------------------------- */
SELECT
    e.earliest_publication_date                                                             AS earliest_publication_date,
    LISTAGG(DISTINCT p."publication_number", ',') WITHIN GROUP (ORDER BY p."publication_number")   AS publication_numbers,
    LISTAGG(DISTINCT p."country_code",       ',') WITHIN GROUP (ORDER BY p."country_code")         AS country_codes,
    LISTAGG(DISTINCT cpc.value:"code"::STRING, ',') WITHIN GROUP (ORDER BY cpc.value:"code"::STRING) AS cpc_codes,
    LISTAGG(DISTINCT ipc.value:"code"::STRING, ',') WITHIN GROUP (ORDER BY ipc.value:"code"::STRING) AS ipc_codes,
    COALESCE(
        LISTAGG(DISTINCT citing.citing_family_id, ',') WITHIN GROUP (ORDER BY citing.citing_family_id)
    , '')                                                                                           AS citing_family_ids,
    COALESCE(
        LISTAGG(DISTINCT cited.cited_family_id , ',') WITHIN GROUP (ORDER BY cited.cited_family_id)
    , '')                                                                                           AS cited_family_ids
FROM earliest e
JOIN pub p
  ON p."family_id" = e."family_id"
LEFT JOIN citing
  ON citing.family_id = e."family_id"
LEFT JOIN cited
  ON cited.family_id  = e."family_id"
, LATERAL FLATTEN(input => p."cpc", outer => TRUE) cpc
, LATERAL FLATTEN(input => p."ipc", outer => TRUE) ipc
GROUP BY e."family_id", e.earliest_publication_date
ORDER BY e.earliest_publication_date, e."family_id";
