```sql
/* -----------------------------------------------------------
   Families whose very first publication appeared in Jan‑2015
   ----------------------------------------------------------- */
WITH earliest AS (   /* 1. first publication date per family      */
    SELECT
        "family_id",
        MIN("publication_date") AS earliest_publication_date
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    GROUP BY "family_id"
    HAVING earliest_publication_date BETWEEN 20150101 AND 20150131
),
pub AS (             /* 2. every publication that belongs to them */
    SELECT p.*,
           e.earliest_publication_date
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    JOIN earliest e  ON p."family_id" = e."family_id"
),
my_pub AS (          /* 3. (family, publication_number) pairs      */
    SELECT "family_id",
           "publication_number"
    FROM pub
),
/* 4. families that CITE one of our publications ---------------- */
citing AS (
    SELECT DISTINCT
        mp."family_id"           AS family_id,            -- our family
        q."family_id"            AS citing_family_id      -- the other family
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS q
         ,LATERAL FLATTEN(input => q."citation") cit
         JOIN my_pub mp
           ON cit.value:"publication_number"::STRING = mp."publication_number"
    WHERE q."family_id" <> mp."family_id"
),
/* 5. families that are CITED by our family --------------------- */
cited AS (
    SELECT DISTINCT
        p."family_id",
        cit.value:"family_id"::STRING AS cited_family_id
    FROM pub p
         ,LATERAL FLATTEN(input => p."citation") cit
    WHERE cit.value:"family_id" IS NOT NULL
)
/* 6. final aggregation ----------------------------------------- */
SELECT
    e.earliest_publication_date                                                     AS earliest_publication_date,
    COALESCE(ARRAY_TO_STRING(
        ARRAY_AGG(DISTINCT p."publication_number" ORDER BY p."publication_number"), ','), '') AS publication_numbers,
    COALESCE(ARRAY_TO_STRING(
        ARRAY_AGG(DISTINCT p."country_code"       ORDER BY p."country_code"),       ','), '') AS country_codes,
    COALESCE(ARRAY_TO_STRING(
        ARRAY_AGG(DISTINCT cpc.value:"code"::STRING ORDER BY cpc.value:"code"::STRING), ','), '') AS cpc_codes,
    COALESCE(ARRAY_TO_STRING(
        ARRAY_AGG(DISTINCT ipc.value:"code"::STRING ORDER BY ipc.value:"code"::STRING), ','), '') AS ipc_codes,
    COALESCE(ARRAY_TO_STRING(
        ARRAY_AGG(DISTINCT citing.citing_family_id ORDER BY citing.citing_family_id), ','), '') AS citing_family_ids,
    COALESCE(ARRAY_TO_STRING(
        ARRAY_AGG(DISTINCT cited.cited_family_id  ORDER BY cited.cited_family_id),  ','), '') AS cited_family_ids
FROM earliest e
JOIN pub p
  ON p."family_id" = e."family_id"
LEFT JOIN LATERAL FLATTEN(input => p."cpc") cpc ON TRUE
LEFT JOIN LATERAL FLATTEN(input => p."ipc") ipc ON TRUE
LEFT JOIN citing
  ON citing.family_id = e."family_id"
LEFT JOIN cited
  ON cited.family_id  = e."family_id"
GROUP BY e."family_id", e.earliest_publication_date
ORDER BY e.earliest_publication_date, e."family_id";
```

