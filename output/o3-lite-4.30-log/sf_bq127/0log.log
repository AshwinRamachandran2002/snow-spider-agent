```sql
--Description: 10) One‑stop report for Jan‑2015 families (LIMIT 20).
--              Returns earliest date, publication numbers, country codes, CPC & IPC codes,
--              plus citing and cited families.
WITH base AS (
    SELECT 
        "family_id",
        MIN("publication_date") AS "earliest_pub_date"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    GROUP BY "family_id"
    HAVING MIN("publication_date") BETWEEN 20150101 AND 20150131
    LIMIT 20
)
SELECT 
    base."family_id",
    base."earliest_pub_date",
    LISTAGG(DISTINCT p."publication_number", ', ') WITHIN GROUP (ORDER BY p."publication_number") AS "pub_numbers",
    LISTAGG(DISTINCT p."country_code",    ', ') WITHIN GROUP (ORDER BY p."country_code")        AS "country_codes",
    LISTAGG(DISTINCT cpc_f.value::STRING, ', ') WITHIN GROUP (ORDER BY cpc_f.value::STRING)     AS "cpc_codes",
    LISTAGG(DISTINCT ipc_f.value::STRING, ', ') WITHIN GROUP (ORDER BY ipc_f.value::STRING)     AS "ipc_codes",
    LISTAGG(DISTINCT cfam."family_id",    ', ') WITHIN GROUP (ORDER BY cfam."family_id")        AS "citing_families",
    LISTAGG(DISTINCT cited_p."family_id", ', ') WITHIN GROUP (ORDER BY cited_p."family_id")     AS "cited_families"
FROM base
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
     ON p."family_id" = base."family_id"
LEFT JOIN LATERAL FLATTEN(input => p."cpc") cpc_f ON TRUE
LEFT JOIN LATERAL FLATTEN(input => p."ipc") ipc_f ON TRUE
/* backward citations */
LEFT JOIN LATERAL FLATTEN(input => p."citation") cb           ON TRUE
LEFT JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS cited_p
       ON cited_p."publication_number" = cb.value::STRING
/* forward citations */
LEFT JOIN (
        SELECT 
            cp."family_id",
            f.value::STRING AS "cited_pub_number"
        FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS cp,
             LATERAL FLATTEN(input => cp."citation") f
) citing_flat
       ON citing_flat."cited_pub_number" = p."publication_number"
LEFT JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS cfam
       ON cfam."family_id" = citing_flat."family_id"
GROUP BY 
    base."family_id",
    base."earliest_pub_date"
LIMIT 20;
```
