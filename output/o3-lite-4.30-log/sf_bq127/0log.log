--Description: 9) Aggregate CPC & IPC codes for Jan‑2015 families (sample ≤20).
--             Uses WITHIN GROUP ordering and DISTINCT inside LISTAGG.
SELECT 
    fam."family_id",
    LISTAGG(DISTINCT fc.value::STRING, ', ') WITHIN GROUP (ORDER BY fc.value::STRING) AS "cpc_list",
    LISTAGG(DISTINCT fi.value::STRING, ', ') WITHIN GROUP (ORDER BY fi.value::STRING) AS "ipc_list"
FROM (
        SELECT "family_id"
        FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
        GROUP BY "family_id"
        HAVING MIN("publication_date") BETWEEN 20150101 AND 20150131
        LIMIT 20
) fam
LEFT JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
       ON p."family_id" = fam."family_id"
LEFT JOIN LATERAL FLATTEN(input => p."cpc") fc ON TRUE
LEFT JOIN LATERAL FLATTEN(input => p."ipc") fi ON TRUE
GROUP BY fam."family_id";
