        GROUP BY "family_id"
        HAVING MIN("publication_date") BETWEEN 20150101 AND 20150131
) fam
LEFT JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
       ON p."family_id" = fam."family_id"
LEFT JOIN LATERAL FLATTEN(input => p."cpc") fc ON TRUE
