--Description: 
-- 10) One‑stop report for Jan‑2015 families (≤20 rows) without using ON‑clause
--     lateral joins.  Separate sub‑queries handle CPC, IPC, cited, and citing data.
WITH base AS (
    SELECT "family_id",
           MIN("publication_date") AS earliest_pub_date
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    GROUP BY "family_id"
    HAVING MIN("publication_date") BETWEEN 20150101 AND 20150131
    LIMIT 20
),
pubs AS (
    SELECT p.*
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    JOIN base b ON b."family_id" = p."family_id"
),
cpc_flat AS (
    SELECT p."family_id", fc.value::STRING AS cpc_code
    FROM pubs p, LATERAL FLATTEN(input => p."cpc") fc
),
ipc_flat AS (
    SELECT p."family_id", fi.value::STRING AS ipc_code
    FROM pubs p, LATERAL FLATTEN(input => p."ipc") fi
),
cited_flat AS (              -- families this family cites
    SELECT DISTINCT
           src."family_id"             AS source_family,
           cited_p."family_id"         AS cited_family
    FROM pubs src,
         LATERAL FLATTEN(input => src."citation") f,
         PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS cited_p
    WHERE cited_p."publication_number" = f.value:"publication_number"::STRING
),
citing_flat AS (             -- families that cite this family
    SELECT DISTINCT
           citing_p."family_id"        AS citing_family,
           cited_p."family_id"         AS target_family
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS citing_p,
         LATERAL FLATTEN(input => citing_p."citation") f,
         pubs cited_p
    WHERE cited_p."publication_number" = f.value:"publication_number"::STRING
)
SELECT
    b."family_id",
    b.earliest_pub_date,
    LISTAGG(DISTINCT p."publication_number", ', ')
        WITHIN GROUP (ORDER BY p."publication_number") AS pub_numbers,
    LISTAGG(DISTINCT p."country_code", ', ')
        WITHIN GROUP (ORDER BY p."country_code")       AS country_codes,
    LISTAGG(DISTINCT c.cpc_code, ', ')
        WITHIN GROUP (ORDER BY c.cpc_code)             AS cpc_codes,
    LISTAGG(DISTINCT i.ipc_code, ', ')
        WITHIN GROUP (ORDER BY i.ipc_code)             AS ipc_codes,
    LISTAGG(DISTINCT ci.citing_family, ', ')
        WITHIN GROUP (ORDER BY ci.citing_family)       AS citing_families,
    LISTAGG(DISTINCT cd.cited_family, ', ')
        WITHIN GROUP (ORDER BY cd.cited_family)        AS cited_families
FROM base b
LEFT JOIN pubs p        ON p."family_id" = b."family_id"
LEFT JOIN cpc_flat c    ON c."family_id" = b."family_id"
LEFT JOIN ipc_flat i    ON i."family_id" = b."family_id"
LEFT JOIN citing_flat ci ON ci.target_family  = b."family_id"
LEFT JOIN cited_flat cd  ON cd.source_family  = b."family_id"
GROUP BY b."family_id", b.earliest_pub_date
LIMIT 20
