--Description: 
-- 9) Aggregate CPC & IPC codes for ≤20 Jan‑2015 families, using sub‑queries that
--    FLATTEN without ON‑clause joins.  LISTAGG returns alphabetic, comma‑separated lists.
WITH jan15_fams AS (
    SELECT "family_id"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    GROUP BY "family_id"
    HAVING MIN("publication_date") BETWEEN 20150101 AND 20150131
    LIMIT 20
),
cpc_flat AS (
    SELECT p."family_id", fc.value::STRING AS cpc_code
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") fc
),
ipc_flat AS (
    SELECT p."family_id", fi.value::STRING AS ipc_code
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."ipc") fi
)
SELECT
    j."family_id",
    LISTAGG(DISTINCT c.cpc_code, ', ') WITHIN GROUP (ORDER BY c.cpc_code) AS "cpc_list",
    LISTAGG(DISTINCT i.ipc_code, ', ') WITHIN GROUP (ORDER BY i.ipc_code) AS "ipc_list"
FROM jan15_fams j
LEFT JOIN cpc_flat c ON c."family_id" = j."family_id"
LEFT JOIN ipc_flat i ON i."family_id" = j."family_id"
GROUP BY j."family_id"
