Query:
--Description: 
-- 8) Families that cite publications from other families (forward citations).
--    We avoid Snowflake’s lateral‑join restrictions by listing FLATTEN in the
--    comma‑style FROM clause.  Each citation element contains a field
--    "publication_number"; we join this back to PUBLICATIONS to discover the
--    cited family, then emit DISTINCT pairs (citing_family → cited_family).
SELECT DISTINCT
       citing_p."family_id"  AS "citing_family",
       cited_p."family_id"   AS "cited_family"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS citing_p,
     LATERAL FLATTEN(input => citing_p."citation") f,
     PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS cited_p
WHERE citing_p."citation" IS NOT NULL
  AND cited_p."publication_number" = f.value:"publication_number"::STRING
LIMIT 20
