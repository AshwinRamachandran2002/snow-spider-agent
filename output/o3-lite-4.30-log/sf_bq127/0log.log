--Description: 
-- Goal: list a small sample (≤20) of backward‑citation links, showing which patent
--       families cite which other families.  
-- Reasoning steps:  
--   1) Pick every publication record (alias src) that contains citation data
--      (src."citation" IS NOT NULL).  
--   2) Place `LATERAL FLATTEN` in the comma‑style FROM clause to explode that citation
--      array/variant into individual elements (f).  This avoids Snowflake’s restriction
--      on ON‑clause lateral joins.  
--   3) Each flattened element is a JSON object; its field "publication_number"
--      holds the cited publication’s identifier.  
--   4) Join that identifier back to the PUBLICATIONS table (alias cited_p) to obtain
--      the cited publication’s "family_id".  
--   5) Select DISTINCT pairs (source_family, cited_family) and cap the output at 20
--      rows for a quick, non‑overwhelming look.
SELECT DISTINCT
    src."family_id"       AS "source_family",
    cited_p."family_id"   AS "cited_family"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS src,
     LATERAL FLATTEN(input => src."citation") f,
     PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS cited_p
WHERE src."citation" IS NOT NULL
  AND cited_p."publication_number" = f.value:"publication_number"::STRING
LIMIT 20;
