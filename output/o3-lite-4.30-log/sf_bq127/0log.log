   publications, CPC / IPC codes and citation relations
------------------------------------------------------------ */
WITH base AS (      /* families whose FIRST publication is in Jan‑2015 */
    SELECT
        "family_id",
        MIN("publication_date") AS earliest_publication_date
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    GROUP BY "family_id"
    HAVING MIN("publication_date") BETWEEN 20150101 AND 20150131
),
/* all publications that belong to those families */
pubs AS (
    SELECT p.*
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    JOIN base b ON b."family_id" = p."family_id"
),
/* flatten CPC and IPC arrays to individual codes */
cpc_flat AS (
    SELECT
        p."family_id",
        f.value:"code"::STRING AS cpc_code
    FROM pubs p,
         LATERAL FLATTEN ( INPUT => p."cpc" ) f
    WHERE f.value:"code" IS NOT NULL
),
ipc_flat AS (
    SELECT
        p."family_id",
        f.value:"code"::STRING AS ipc_code
    FROM pubs p,
         LATERAL FLATTEN ( INPUT => p."ipc" ) f
    WHERE f.value:"code" IS NOT NULL
),
/* families that THIS family cites (back‑ward citations) */
cited_flat AS (
    SELECT DISTINCT
        src."family_id"            AS source_family_id,
        tgt."family_id"            AS cited_family_id
    FROM pubs src,
         LATERAL FLATTEN ( INPUT => src."citation" ) f,
         PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS tgt
    WHERE tgt."publication_number" = f.value:"publication_number"::STRING
),
/* families that cite THIS family (forward citations) */
citing_flat AS (
    SELECT DISTINCT
        cit."family_id"            AS citing_family_id,
        tgt."family_id"            AS target_family_id
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS cit,
         LATERAL FLATTEN ( INPUT => cit."citation" ) f,
         pubs tgt
    WHERE tgt."publication_number" = f.value:"publication_number"::STRING
          AND cit."family_id" IS NOT NULL
)
SELECT
    b.earliest_publication_date                                                 AS earliest_publication_date,
    LISTAGG( DISTINCT p."publication_number", ', ' )
        WITHIN GROUP ( ORDER BY p."publication_number" )                        AS publication_numbers,
    LISTAGG( DISTINCT p."country_code", ', ' )
        WITHIN GROUP ( ORDER BY p."country_code" )                              AS country_codes,
    LISTAGG( DISTINCT c.cpc_code, ', ' )
