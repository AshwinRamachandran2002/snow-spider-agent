/*  One row per patent family whose very first publication was in January‑2015  */
WITH focal_families AS (   -- families first seen in Jan‑2015
    SELECT
        "family_id",
        MIN("publication_date") AS earliest_pub_date
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    GROUP BY "family_id"
    HAVING MIN("publication_date") BETWEEN 20150101 AND 20150131
),

focal_pubs AS (   -- every publication that belongs to those families
    SELECT p.*
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    JOIN focal_families f
      ON p."family_id" = f."family_id"
),

/* -------- aggregate publication numbers & country codes ------------------- */
pubs_agg AS (
    SELECT
        "family_id",
        LISTAGG(DISTINCT "publication_number", ', ')
            WITHIN GROUP (ORDER BY "publication_number")               AS publication_numbers,
        LISTAGG(DISTINCT "country_code", ', ')
            WITHIN GROUP (ORDER BY "country_code")                     AS country_codes
    FROM focal_pubs
    GROUP BY "family_id"
),

/* ---------------- aggregate CPC codes ------------------------------------ */
cpc_agg AS (
    SELECT
        fp."family_id",
        LISTAGG(DISTINCT fl.value:"code"::STRING, ', ')
            WITHIN GROUP (ORDER BY fl.value:"code"::STRING)            AS cpc_codes
    FROM focal_pubs fp,
         LATERAL FLATTEN (INPUT => fp."cpc") fl
    GROUP BY fp."family_id"
),

/* ---------------- aggregate IPC codes ------------------------------------ */
ipc_agg AS (
    SELECT
        fp."family_id",
        LISTAGG(DISTINCT fl.value:"code"::STRING, ', ')
            WITHIN GROUP (ORDER BY fl.value:"code"::STRING)            AS ipc_codes
    FROM focal_pubs fp,
         LATERAL FLATTEN (INPUT => fp."ipc") fl
    GROUP BY fp."family_id"
),

/* --------- raw families that are CITED BY the focal families -------------- */
cited_raw AS (
    SELECT DISTINCT
           fp."family_id"                      AS source_family_id,
           tgt."family_id"                     AS cited_family_id
    FROM focal_pubs fp,
         LATERAL FLATTEN (INPUT => fp."citation") c
         JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS tgt
           ON tgt."publication_number" = c.value:"publication_number"::STRING
    WHERE c.value:"publication_number" IS NOT NULL
),

cited_agg AS (
    SELECT
        source_family_id   AS family_id,
        LISTAGG(DISTINCT cited_family_id, ', ')
            WITHIN GROUP (ORDER BY cited_family_id)                    AS cited_family_ids
    FROM cited_raw
    GROUP BY source_family_id
),

/* --------- raw families that CITE the focal families ---------------------- */
citing_raw AS (
    SELECT DISTINCT
           src."family_id"                     AS citing_family_id,
           tgt."family_id"                     AS target_family_id
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS src,
         LATERAL FLATTEN (INPUT => src."citation") c
         JOIN focal_pubs   tgt
           ON tgt."publication_number" = c.value:"publication_number"::STRING
    WHERE c.value:"publication_number" IS NOT NULL
),

citing_agg AS (
    SELECT
        target_family_id  AS family_id,
        LISTAGG(DISTINCT citing_family_id, ', ')
            WITHIN GROUP (ORDER BY citing_family_id)                   AS citing_family_ids
    FROM citing_raw
    GROUP BY target_family_id
)

/* ----------------------------- final result ------------------------------- */
SELECT
    f.earliest_pub_date                                                      AS earliest_publication_date,
    COALESCE(p.publication_numbers, '')                                      AS publication_numbers,
    COALESCE(p.country_codes     , '')                                       AS country_codes,
    COALESCE(cc.cpc_codes        , '')                                       AS cpc_codes,
    COALESCE(ic.ipc_codes        , '')                                       AS ipc_codes,
    COALESCE(ci.citing_family_ids, '')                                       AS citing_family_ids,
    COALESCE(cd.cited_family_ids , '')                                       AS cited_family_ids
FROM focal_families  f
LEFT JOIN pubs_agg   p  ON p."family_id" = f."family_id"
LEFT JOIN cpc_agg    cc ON cc."family_id" = f."family_id"
LEFT JOIN ipc_agg    ic ON ic."family_id" = f."family_id"
LEFT JOIN citing_agg ci ON ci."family_id" = f."family_id"
LEFT JOIN cited_agg  cd ON cd."family_id" = f."family_id"
ORDER BY f.earliest_pub_date, f."family_id";
