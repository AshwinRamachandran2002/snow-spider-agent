--Description: Produce one summary row per patent family whose first‑ever publication
--occurred in January 2015.  For every such “focal family” we list
--  • its earliest publication date
--  • all publication numbers in the family
--  • all country codes represented in that family
--  • distinct CPC and IPC symbols found anywhere in the family
--  • distinct families that the focal family CITES
--  • distinct families that CITE the focal family
--
--All JSON arrays (cpc, ipc, citation) are exploded with comma‑style
--`LATERAL FLATTEN` so no unsupported OUTER/LATERAL join syntax is used.

WITH focal_families AS (                      -- families first published in Jan‑2015
    SELECT DISTINCT "family_id"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE "publication_date" BETWEEN 20150101 AND 20150131
),
cited_families AS (                           -- families that focal families cite
    SELECT DISTINCT
           src."family_id"                  AS source_family,
           tgt."family_id"                  AS cited_family
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS  src
       , LATERAL FLATTEN(input => src."citation") cit
       , PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS  tgt
    WHERE tgt."publication_number" = cit.value:"publication_number"::STRING
),
citing_families AS (                          -- families that cite focal families
    SELECT DISTINCT
           tgt."family_id"                  AS citing_family,
           src."family_id"                  AS target_family
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS  src
       , LATERAL FLATTEN(input => src."citation") cit
       , PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS  tgt
    WHERE tgt."publication_number" = cit.value:"publication_number"::STRING
)
SELECT
    f."family_id",
    MIN(p."publication_date")                                                          AS "earliest_pub_date",
    ARRAY_TO_STRING(ARRAY_AGG(DISTINCT p."publication_number" ORDER BY p."publication_number"), ', ') AS "pub_numbers",
    ARRAY_TO_STRING(ARRAY_AGG(DISTINCT p."country_code"       ORDER BY p."country_code"),       ', ') AS "country_codes",
    ARRAY_TO_STRING(ARRAY_AGG(DISTINCT cpc.value:"code"::STRING ORDER BY cpc.value:"code"::STRING),   ', ') AS "cpc_codes",
    ARRAY_TO_STRING(ARRAY_AGG(DISTINCT ipc.value:"code"::STRING ORDER BY ipc.value:"code"::STRING),   ', ') AS "ipc_codes",
    ARRAY_TO_STRING(ARRAY_AGG(DISTINCT cf.cited_family  ORDER BY cf.cited_family),  ', ')            AS "cited_families",
    ARRAY_TO_STRING(ARRAY_AGG(DISTINCT rf.citing_family ORDER BY rf.citing_family), ', ')            AS "citing_families"
FROM focal_families                f
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
  ON p."family_id" = f."family_id"
  -- explode CPC and IPC arrays (outer=>TRUE keeps rows even when the array is null)
 , LATERAL FLATTEN(input => p."cpc", outer => TRUE) cpc
 , LATERAL FLATTEN(input => p."ipc", outer => TRUE) ipc
LEFT JOIN cited_families  cf  ON cf.source_family  = f."family_id"
LEFT JOIN citing_families rf  ON rf.target_family  = f."family_id"
GROUP BY f."family_id"
LIMIT 20;
```
