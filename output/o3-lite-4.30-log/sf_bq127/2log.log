--Description:  Produce a complete summary for every patent family whose very first
--publication appeared in January 2015 (01‑Jan‑2015 – 31‑Jan‑2015).  Steps:
-- 1. earliest_pub    – compute the minimum publication date per family.
-- 2. focal_families  – retain families whose minimum date is in the target month.
-- 3. cited_families  – from every publication of a focal family, explode its
--    "citation" array and map cited publication numbers back to their families.
-- 4. citing_families – find all families that cite any publication belonging to a
--    focal family (reverse‑direction citations).
-- 5. Final SELECT aggregates, for each focal family:
--      • earliest publication date
--      • comma‑separated list of all publication numbers
--      • comma‑separated list of country codes
--      • comma‑separated list of CPC symbols
--      • comma‑separated list of IPC symbols
--      • comma‑separated list of families it cites
--      • comma‑separated list of families that cite it
--    JSON arrays are unfolded with LATERAL FLATTEN (comma‑style joins, outer => TRUE),
--    and ARRAY_AGG DISTINCT … WITHIN GROUP supplies alphabetically‑sorted lists.

WITH earliest_pub AS (
    SELECT "family_id",
           MIN("publication_date") AS earliest_pub_date
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    GROUP  BY "family_id"
),
focal_families AS (   -- families whose first publication is in Jan‑2015
    SELECT "family_id", earliest_pub_date
    FROM   earliest_pub
    WHERE  earliest_pub_date BETWEEN 20150101 AND 20150131
),
/* families that focal families CITE */
cited_families AS (
    SELECT DISTINCT
           src."family_id"                   AS source_family,
           tgt."family_id"                   AS cited_family
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS src
         , LATERAL FLATTEN(input => src."citation") cit
         , PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS tgt
    WHERE tgt."publication_number" = cit.value:"publication_number"::STRING
),
/* families that CITE the focal families */
citing_families AS (
    SELECT DISTINCT
           tgt."family_id"                   AS citing_family,
           src."family_id"                   AS target_family
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS src
         , LATERAL FLATTEN(input => src."citation") cit
         , PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS tgt
    WHERE tgt."publication_number" = cit.value:"publication_number"::STRING
)

SELECT
    f."family_id",
    f.earliest_pub_date                                            AS "earliest_pub_date",

    ARRAY_TO_STRING(
        ARRAY_AGG(DISTINCT p."publication_number")
            WITHIN GROUP (ORDER BY p."publication_number"),
        ', '
    ) AS "pub_numbers",

    ARRAY_TO_STRING(
        ARRAY_AGG(DISTINCT p."country_code")
            WITHIN GROUP (ORDER BY p."country_code"),
        ', '
    ) AS "country_codes",

    ARRAY_TO_STRING(
        ARRAY_AGG(DISTINCT cpc.value:"code"::STRING)
            WITHIN GROUP (ORDER BY cpc.value:"code"::STRING),
        ', '
    ) AS "cpc_codes",

    ARRAY_TO_STRING(
        ARRAY_AGG(DISTINCT ipc.value:"code"::STRING)
            WITHIN GROUP (ORDER BY ipc.value:"code"::STRING),
        ', '
    ) AS "ipc_codes",

    ARRAY_TO_STRING(
        ARRAY_AGG(DISTINCT cf.cited_family)
            WITHIN GROUP (ORDER BY cf.cited_family),
        ', '
    ) AS "cited_families",

    ARRAY_TO_STRING(
        ARRAY_AGG(DISTINCT rf.citing_family)
            WITHIN GROUP (ORDER BY rf.citing_family),
        ', '
    ) AS "citing_families"

FROM focal_families f
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
  ON p."family_id" = f."family_id"

, LATERAL FLATTEN(input => p."cpc", outer => TRUE) cpc
, LATERAL FLATTEN(input => p."ipc", outer => TRUE) ipc

LEFT JOIN cited_families  cf ON cf.source_family = f."family_id"
LEFT JOIN citing_families rf ON rf.target_family = f."family_id"

