--Description:  Create one compact row per patent family whose first publication
--(minimum “publication_date”) lies in January 2015.  Each row shows
--  • that earliest publication date,
--  • all publication numbers,
--  • all country codes,
--  • distinct CPC codes,
--  • distinct IPC codes,
--  • distinct families cited by the focal family,
--  • distinct families that cite the focal family.
--
--Key implementation notes
--  • CROSS JOIN LATERAL FLATTEN is used (never on the left‑hand side of a JOIN),
--    so Snowflake’s lateral restrictions are satisfied.
--  • ARRAY_AGG(DISTINCT …) is combined with ARRAY_SORT to yield alphabetically
--    ordered lists because ORDER BY cannot accompany DISTINCT in Snowflake’s
--    aggregate syntax.
--  • ARRAY_TO_STRING converts each sorted array into a comma‑separated string.
--  • All joins are LEFT so families without CPC/IPC/citation data are still kept.

WITH earliest_pub AS (                        -- minimum pub‑date per family
    SELECT
        "family_id",
        MIN("publication_date") AS earliest_pub_date
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    GROUP BY "family_id"
),
focal_families AS (                           -- first published in Jan‑2015
    SELECT *
    FROM   earliest_pub
    WHERE  earliest_pub_date BETWEEN 20150101 AND 20150131
),
/* families that focal families cite */
cited_families AS (
    SELECT DISTINCT
           src."family_id"  AS source_family,
           tgt."family_id"  AS cited_family
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS src
         CROSS JOIN LATERAL FLATTEN(input => src."citation") cit
         JOIN  PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS tgt
           ON tgt."publication_number" = cit.value:"publication_number"::STRING
),
/* families that cite focal families */
citing_families AS (
    SELECT DISTINCT
           tgt."family_id"  AS citing_family,
           src."family_id"  AS target_family
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS src
         CROSS JOIN LATERAL FLATTEN(input => src."citation") cit
         JOIN  PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS tgt
           ON tgt."publication_number" = cit.value:"publication_number"::STRING
),
/* explode CPC and IPC arrays for every publication in focal families */
publication_exp AS (
    SELECT
        p."family_id",
        p."publication_number",
        p."country_code",
        cpc_f.value:"code"::STRING AS cpc_code,
        ipc_f.value:"code"::STRING AS ipc_code
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
         CROSS JOIN LATERAL FLATTEN(input => p."cpc", outer => TRUE)  cpc_f
         CROSS JOIN LATERAL FLATTEN(input => p."ipc", outer => TRUE)  ipc_f
    WHERE p."family_id" IN (SELECT "family_id" FROM focal_families)
)
SELECT
    f."family_id",
    f.earliest_pub_date                                                    AS "earliest_pub_date",

    ARRAY_TO_STRING(
        ARRAY_SORT(ARRAY_AGG(DISTINCT pe."publication_number")), ', '
    ) AS "pub_numbers",

    ARRAY_TO_STRING(
        ARRAY_SORT(ARRAY_AGG(DISTINCT pe."country_code")), ', '
    ) AS "country_codes",

    ARRAY_TO_STRING(
        ARRAY_SORT(ARRAY_AGG(DISTINCT pe.cpc_code)), ', '
    ) AS "cpc_codes",

    ARRAY_TO_STRING(
        ARRAY_SORT(ARRAY_AGG(DISTINCT pe.ipc_code)), ', '
    ) AS "ipc_codes",

    ARRAY_TO_STRING(
        ARRAY_SORT(ARRAY_AGG(DISTINCT cf.cited_family)), ', '
    ) AS "cited_families",

    ARRAY_TO_STRING(
        ARRAY_SORT(ARRAY_AGG(DISTINCT rf.citing_family)), ', '
    ) AS "citing_families"

FROM focal_families        f
LEFT JOIN publication_exp  pe ON pe."family_id"   = f."family_id"
LEFT JOIN cited_families   cf ON cf.source_family = f."family_id"
LEFT JOIN citing_families  rf ON rf.target_family = f."family_id"
GROUP BY f."family_id", f.earliest_pub_date
