    WHERE "publication_date" BETWEEN 20150101 AND 20150131
  )
) src
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS tgt
  ON tgt."publication_number" = src."cited_pub_number"
LIMIT 20;
