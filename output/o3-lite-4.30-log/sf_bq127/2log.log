-- 8. Description: Map the cited publication_numbers to their family_ids (families that are cited BY the focal families)
SELECT DISTINCT
  src."source_family"      AS "citing_family",
  tgt."family_id"          AS "cited_family"
FROM (
  SELECT
    p."family_id" AS "source_family",
    c.value:"publication_number"::STRING AS "cited_pub_number"
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."citation") c
