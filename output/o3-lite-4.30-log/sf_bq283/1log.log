Relevant columns and possible conditions  

AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS  
• "station_id": station identifier – will be used for joining with trip data  
• "status": whether the station is currently “active” or not – filter to status = 'active' (or ILIKE '%active%')  

AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS  
• "start_station_id": ﻿ID of the station where every trip begins – counts/percentages will be based on this value  
• "duration_minutes": ﻿trip length – used to compute the average duration per station  

Typical conditions  
•  Only keep stations whose "status" ILIKE '%active%' (interpretation of “currently active”)  
•  Only consider trips whose "start_station_id" is in the set of active stations  
•  Rank stations by COUNT(*) DESC, pull the top‑15 positions including ties (DENSE_RANK ≤ 15)  

Sample exploration queries  
Each query below is limited to 20 rows just to become familiar with the data before composing the final analytic statement.

```sql
-- 1. Distinct station statuses (look for the spelling of “active”)
SELECT DISTINCT "status"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS
LIMIT 20;
```

```sql
-- 2. Peek at a few stations that are already marked as active
SELECT "station_id",
       "name",
       "status",
       "location"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS
WHERE "status" ILIKE '%active%'
LIMIT 20;
```

```sql
-- 3. Quick look at the trip table – starting station information
SELECT "trip_id",
       "start_station_id",
       "end_station_id",
       "duration_minutes"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS
LIMIT 20;
```

```sql
-- 4. How many trips have ever started from each station (no filters yet)
SELECT "start_station_id",
       COUNT(*) AS "trip_starts"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS
GROUP BY "start_station_id"
ORDER BY "trip_starts" DESC
LIMIT 20;
```

```sql
-- 5. Overall # of trips that began at *active* stations only
SELECT COUNT(*) AS "total_starts_active_stations"
FROM AUSTIN.AUSTON_BIKESHARE.BIKESHARE_TRIPS t
JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
  ON t."start_station_id" = s."station_id"
WHERE s."status" ILIKE '%active%';
```

```sql
-- 6. Trip counts per active station and preliminary ranking
SELECT t."start_station_id",
       COUNT(*)       AS "trip_starts",
       DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS "rank_by_starts"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS t
JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
  ON t."start_station_id" = s."station_id"
WHERE s."status" ILIKE '%active%'
GROUP BY t."start_station_id"
ORDER BY "rank_by_starts"
LIMIT 20;
```

```sql
-- 7. Average duration for trips that start at each active station
SELECT t."start_station_id",
       AVG(t."duration_minutes") AS "avg_duration"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS t
JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
  ON t."start_station_id" = s."station_id"
WHERE s."status" ILIKE '%active%'
GROUP BY t."start_station_id"
LIMIT 20;
```

```sql
-- 8. Combine count and average duration; compute overall starts for percentage
WITH active_trips AS (
    SELECT t."start_station_id",
           t."duration_minutes"
    FROM   AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS t
    JOIN   AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
      ON   t."start_station_id" = s."station_id"
    WHERE  s."status" ILIKE '%active%'
)
SELECT "start_station_id",
       COUNT(*)                            AS "trip_starts",
       AVG("duration_minutes")             AS "avg_duration",
       (SELECT COUNT(*) FROM active_trips) AS "overall_active_starts"
FROM   active_trips
GROUP  BY "start_station_id"
LIMIT 20;
```

```sql
-- 9. Identify stations whose rank (by starts) is ≤ 15 INCLUDING ties
WITH active AS (
    SELECT t."start_station_id",
           COUNT(*) AS "trip_starts"
    FROM   AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS t
    JOIN   AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
      ON   t."start_station_id" = s."station_id"
    WHERE  s."status" ILIKE '%active%'
    GROUP  BY t."start_station_id"
), ranked AS (
    SELECT *,
           DENSE_RANK() OVER (ORDER BY "trip_starts" DESC) AS "rk"
    FROM   active
)
SELECT *
FROM   ranked
WHERE  "rk" <= 15
ORDER  BY "rk"
LIMIT 20;
```

```sql
-- 10. Final query: station id, total starts, % of overall active‑station starts,
--     average trip duration, restricted to top‑15 ranks (ties included).
WITH active_trips AS (
    SELECT t."start_station_id",
           t."duration_minutes"
    FROM   AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS t
    JOIN   AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
      ON   t."start_station_id" = s."station_id"
    WHERE  s."status" ILIKE '%active%'
),
agg AS (
    SELECT "start_station_id",
           COUNT(*)        AS "trip_starts",
           AVG("duration_minutes") AS "avg_duration"
    FROM   active_trips
    GROUP  BY "start_station_id"
),
ranked AS (
    SELECT *,
           DENSE_RANK() OVER (ORDER BY "trip_starts" DESC) AS "rk"
    FROM   agg
),
tot AS (
    SELECT SUM("trip_starts") AS "overall_active_starts"
    FROM   agg
)
SELECT r."start_station_id"               AS "station_id",
       r."trip_starts",
       ROUND(r."trip_starts" * 100.0 / t."overall_active_starts", 2) AS "pct_of_active_starts",
       ROUND(r."avg_duration", 2)         AS "avg_trip_duration_minutes",
       r."rk"                             AS "rank"
FROM   ranked r
CROSS  JOIN tot t
WHERE  r."rk" <= 15
ORDER  BY r."rk", r."station_id"
LIMIT 20;
```
