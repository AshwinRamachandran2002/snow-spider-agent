```sql
--Description: Final answer for the task.
--Goal: For currently “active” stations, identify the stations that fall in the
--      top‑15 ranks (including ties) by number of trips that start there.
--Steps
-- 1) active_trips – keep only trips that began at stations whose status
--    ILIKE '%active%'.
-- 2) agg – per active station, compute the total number of starting trips and
--    the average trip duration (minutes).
-- 3) ranked – assign a DENSE_RANK ordered by descending trip count.
-- 4) tot – compute the grand total of trip starts from all active stations
--    (used to calculate percentages).
-- 5) Final SELECT – return the station ID, total trip starts, percentage of
--    overall active‑station starts, average trip duration, and the rank for
--    all stations whose rank ≤ 15; order by rank then station ID.
WITH active_trips AS (
    SELECT t."start_station_id",
           t."duration_minutes"
    FROM   AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS   t
    JOIN   AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
           ON t."start_station_id" = s."station_id"
    WHERE  s."status" ILIKE '%active%'
),
agg AS (
    SELECT "start_station_id",
           COUNT(*)                AS "trip_starts",
           AVG("duration_minutes") AS "avg_duration"
    FROM   active_trips
    GROUP  BY "start_station_id"
),
ranked AS (
    SELECT *,
           DENSE_RANK() OVER (ORDER BY "trip_starts" DESC) AS "rk"
    FROM   agg
),
tot AS (
    SELECT SUM("trip_starts") AS "overall_active_starts"
    FROM   agg
)
SELECT  r."start_station_id"                                             AS "station_id",
        r."trip_starts",
        ROUND(r."trip_starts" * 100.0 / t."overall_active_starts", 2)     AS "pct_of_active_starts",
        ROUND(r."avg_duration", 2)                                        AS "avg_trip_duration_minutes",
        r."rk"                                                            AS "rank"
FROM    ranked r
CROSS   JOIN tot t
WHERE   r."rk" <= 15
ORDER BY r."rk", r."start_station_id"
LIMIT 20;
