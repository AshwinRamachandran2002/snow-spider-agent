Relevant columns, usage & typical conditions  
• AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS  
  – "station_id": joins to trips, grouping key  
  – "status": filter to currently‑active stations (e.g. WHERE "status" ILIKE 'active%')  
• AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS  
  – "start_station_id": starting station for each trip (join to stations)  
  – "duration_minutes": to build station average duration  
  – "trip_id": row‑counter when we need COUNT(*)  

Below are ten exploratory → final Snowflake SQL queries (each LIMITED to 20 rows unless otherwise noted).  
Every identifier is wrapped in double quotes.

```sql
-- 1. Preview a few bikeshare‑station rows
SELECT *
FROM "AUSTIN"."AUSTIN_BIKESHARE"."BIKESHARE_STATIONS"
LIMIT 20;
```

```sql
-- 2. Look at distinct station statuses
SELECT DISTINCT "status"
FROM "AUSTIN"."AUSTIN_BIKESHARE"."BIKESHARE_STATIONS"
LIMIT 20;
```

```sql
-- 3. Count how many stations are currently active
SELECT COUNT(*) AS "active_station_cnt"
FROM "AUSTIN"."AUSTIN_BIKESHARE"."BIKESHARE_STATIONS"
WHERE "status" ILIKE 'active%';
```

```sql
-- 4. Inspect a handful of trip records
SELECT *
FROM "AUSTIN"."AUSTIN_BIKESHARE"."BIKESHARE_TRIPS"
LIMIT 20;
```

```sql
-- 5. Which start‑station IDs appear in trips?  (first 20)
SELECT DISTINCT "start_station_id"
FROM "AUSTIN"."AUSTIN_BIKESHARE"."BIKESHARE_TRIPS"
LIMIT 20;
```

```sql
-- 6. Join trips to active stations, first 20 joined rows
SELECT t."trip_id",
       t."start_station_id",
       s."status"
FROM "AUSTIN"."AUSTIN_BIKESHARE"."BIKESHARE_TRIPS" t
JOIN "AUSTIN"."AUSTIN_BIKESHARE"."BIKESHARE_STATIONS" s
  ON t."start_station_id" = s."station_id"
WHERE s."status" ILIKE 'active%'
LIMIT 20;
```

```sql
-- 7. Trip counts per active station (preview only)
SELECT t."start_station_id"          AS "station_id",
       COUNT(*)                      AS "start_trip_cnt",
       AVG(t."duration_minutes")     AS "avg_duration_min"
FROM "AUSTIN"."AUSTIN_BIKESHARE"."BIKESHARE_TRIPS" t
JOIN "AUSTIN"."AUSTIN_BIKESHARE"."BIKESHARE_STATIONS" s
  ON t."start_station_id" = s."station_id"
WHERE s."status" ILIKE 'active%'
GROUP BY t."start_station_id"
ORDER BY "start_trip_cnt" DESC
LIMIT 20;
```

```sql
-- 8. Overall number of trips that start from active stations
SELECT COUNT(*) AS "overall_start_trips"
FROM "AUSTIN"."AUSTIN_BIKESHARE"."BIKESHARE_TRIPS" t
JOIN "AUSTIN"."AUSTIN_BIKESHARE"."BIKESHARE_STATIONS" s
  ON t."start_station_id" = s."station_id"
WHERE s."status" ILIKE 'active%';
```

```sql
-- 9. Rank stations by start‑trip count (dense rank) and preview
WITH active_station_trips AS (
    SELECT t."start_station_id"      AS "station_id",
           COUNT(*)                  AS "start_trip_cnt",
           AVG(t."duration_minutes") AS "avg_duration_min"
    FROM   "AUSTIN"."AUSTIN_BIKESHARE"."BIKESHARE_TRIPS" t
    JOIN   "AUSTIN"."AUSTIN_BIKESHARE"."BIKESHARE_STATIONS" s
           ON t."start_station_id" = s."station_id"
    WHERE  s."status" ILIKE 'active%'
    GROUP  BY t."start_station_id"
)
SELECT *,
       DENSE_RANK() OVER (ORDER BY "start_trip_cnt" DESC) AS "rank"
FROM active_station_trips
ORDER BY "rank"
LIMIT 20;
```

```sql
-- 10. Final query – Top 15 (incl. ties) active stations by starting trips,
--      showing station_id, total start‑trips, pct of all active‑station trips,
--      and average trip duration, ordered by rank
WITH active_stations AS (
    SELECT "station_id"
    FROM   "AUSTIN"."AUSTIN_BIKESHARE"."BIKESHARE_STATIONS"
    WHERE  "status" ILIKE 'active%'
),
station_trip_stats AS (
    SELECT t."start_station_id"      AS "station_id",
           COUNT(*)                  AS "start_trip_cnt",
           AVG(t."duration_minutes") AS "avg_duration_min"
    FROM   "AUSTIN"."AUSTIN_BIKESHARE"."BIKESHARE_TRIPS" t
    JOIN   active_stations s
           ON t."start_station_id" = s."station_id"
    GROUP  BY t."start_station_id"
),
overall_total AS (
    SELECT SUM("start_trip_cnt") AS "overall_cnt"
    FROM   station_trip_stats
)
SELECT sts."station_id",
       sts."start_trip_cnt",
       ROUND(sts."start_trip_cnt" * 100.0 / ot."overall_cnt", 2) AS "pct_of_active_start_trips",
       ROUND(sts."avg_duration_min", 2)                          AS "avg_duration_min",
       DENSE_RANK() OVER (ORDER BY sts."start_trip_cnt" DESC)    AS "rank"
FROM   station_trip_stats  sts
CROSS  JOIN overall_total  ot
QUALIFY "rank" <= 15
ORDER BY "rank", sts."station_id"
LIMIT 20;
```

