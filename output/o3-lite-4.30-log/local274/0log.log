Begin Exploring Related Columns
Relevant tables / columns and why  
• picking_line.id – unique line id, helps identify each pick action  
• picking_line.order_id – filter lines that belong to order 421  
• picking_line.product_id – tells which product was picked  
• picking_line.qty – number of units picked in that line, used for the average  
• picking_line.line_no – sequence inside a pick‑list (FIFO within one list)  
• picking_line.picklist_id – join key to the pick‑list header  
• picking_list.id – primary key, lets us join from picking_line  
• picking_list.created – time stamp of the list; when two lists exist, the one with the earliest created time is “first‑in” (FIFO across lists)  
• products.id / products.name – to show the human‑readable product name  
Conditions that will be used  
• picking_line.order_id = 421  
• (optional) ORDER BY picking_list.created, picking_line.line_no  – to respect FIFO

Below are ten exploratory queries (LIMIT 20) building up to the final answer.

```sql
-- 1) See the order header for order 421
SELECT *
FROM "orders"
WHERE "id" = 421
LIMIT 20;

-- 2) All pick‑lists that contain lines for order 421
SELECT DISTINCT pl."picklist_id"
FROM "picking_line" AS pl
WHERE pl."order_id" = 421
LIMIT 20;

-- 3) Raw picking lines for order 421
SELECT *
FROM "picking_line"
WHERE "order_id" = 421
ORDER BY "picklist_id", "line_no"
LIMIT 20;

-- 4) Picking lines together with their list creation time (FIFO insight)
SELECT pl.*, lst."created"
FROM "picking_line" AS pl
JOIN "picking_list" AS lst
     ON lst."id" = pl."picklist_id"
WHERE pl."order_id" = 421
ORDER BY lst."created", pl."line_no"
LIMIT 20;

-- 5) Add product names to the picking lines
SELECT pl."picklist_id",
       pl."line_no",
       pr."name"      AS "product_name",
       pl."qty"
FROM "picking_line" AS pl
JOIN "products"     AS pr
     ON pr."id" = pl."product_id"
WHERE pl."order_id" = 421
ORDER BY pl."picklist_id", pl."line_no"
LIMIT 20;

-- 6) How many distinct products were picked for order 421?
SELECT COUNT(DISTINCT pl."product_id") AS "distinct_products"
FROM   "picking_line" AS pl
WHERE  pl."order_id" = 421;

-- 7) Total quantity per product for order 421
SELECT pl."product_id",
       SUM(pl."qty") AS "total_qty"
FROM   "picking_line" AS pl
WHERE  pl."order_id" = 421
GROUP  BY pl."product_id"
LIMIT 20;

-- 8) Number of pick actions per product for order 421
SELECT pl."product_id",
       COUNT(*) AS "pick_actions"
FROM   "picking_line" AS pl
WHERE  pl."order_id" = 421
GROUP  BY pl."product_id"
LIMIT 20;

-- 9) Average quantity per product (without names, FIFO not crucial yet)
SELECT pl."product_id",
       AVG(pl."qty") AS "avg_qty"
FROM   "picking_line" AS pl
WHERE  pl."order_id" = 421
GROUP  BY pl."product_id"
LIMIT 20;

-- 10) FINAL – products picked for order 421 with average units,  
--      respecting FIFO ordering only for presentation
SELECT pr."id"   AS "product_id",
       pr."name" AS "product_name",
       ROUND(AVG(pl."qty"), 2) AS "avg_units_picked"
FROM   "picking_line" AS pl
JOIN   "picking_list" AS lst
       ON lst."id" = pl."picklist_id"
JOIN   "products"     AS pr
       ON pr."id" = pl."product_id"
WHERE  pl."order_id" = 421
GROUP  BY pr."id", pr."name"
ORDER  BY MIN(lst."created"),   -- earliest pick‑list first (FIFO across lists)
          MIN(pl."line_no")     -- earliest line within that list
LIMIT 20;
```
