```sql
--Description / Thinking process:
--1. We need the top two repositories from 2017 WatchEvent data that (a) have more
--   than 300 distinct watchers and (b) also appear in the code snapshot table
--   GITHUB_REPOS.SAMPLE_FILES.
--2. Step A (CTE watcher_counts):   aggregate 2017 WatchEvents, counting DISTINCT
--   actor IDs per repo; keep only repos whose counts exceed 300.
--3. Step B (CTE sample_repos):     collect the DISTINCT repo names present in
--   SAMPLE_FILES so our final answer is limited to those repos.
--4. Final SELECT:                  join the two CTEs on repo_name, then order
--   by watcher count descending and LIMIT 2 so we return only the two repos
--   with the highest distinct‑watcher totals.
WITH watcher_counts AS (
    SELECT
        t."repo":"name"::STRING                AS repo_name,
        COUNT(DISTINCT t."actor":"id"::STRING) AS distinct_watchers
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t
    WHERE t."type" = 'WatchEvent'
    GROUP BY t."repo":"name"::STRING
    HAVING COUNT(DISTINCT t."actor":"id"::STRING) > 300
),
sample_repos AS (
    SELECT DISTINCT
           f."repo_name"
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES" f
)
SELECT
       wc.repo_name,
       wc.distinct_watchers
FROM   watcher_counts wc
JOIN   sample_repos   sr
  ON   wc.repo_name = sr.repo_name
ORDER  BY wc.distinct_watchers DESC
LIMIT 2;
```
