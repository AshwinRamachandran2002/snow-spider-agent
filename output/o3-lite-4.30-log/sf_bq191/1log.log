```sql
--Description / Thinking process:
--1. watcher_counts CTE:
--     • Scan the 2017 GitHub events table.
--     • Keep only rows whose "type" is 'WatchEvent'.
--     • Group by the repository name extracted from the "repo" JSON.
--     • Count DISTINCT watcher IDs (actor.id) per repository.
--     • Retain only repositories that accumulated more than 300 distinct watchers.
--2. Final SELECT:
--     • Filter watcher_counts so we keep only repositories that also appear
--       in GITHUB_REPOS.SAMPLE_FILES (using an IN clause on its DISTINCT repo list).
--       This avoids the duplicate‑row explosion that a raw JOIN can produce
--       because SAMPLE_FILES has one row per file.
--     • Order by the watcher count descending.
--     • LIMIT 2 so we return exactly the two repositories with the highest
--       distinct‑watcher totals that satisfy both conditions.
WITH watcher_counts AS (
    SELECT
        t."repo":"name"::STRING                AS repo_name,
        COUNT(DISTINCT t."actor":"id"::STRING) AS distinct_watchers
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t
    WHERE t."type" = 'WatchEvent'
    GROUP BY t."repo":"name"::STRING
    HAVING COUNT(DISTINCT t."actor":"id"::STRING) > 300
)
SELECT
       wc.repo_name,
       wc.distinct_watchers
FROM   watcher_counts wc
WHERE  wc.repo_name IN (
    SELECT DISTINCT f."repo_name"
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES" f
)
ORDER  BY wc.distinct_watchers DESC
LIMIT 2;
```
