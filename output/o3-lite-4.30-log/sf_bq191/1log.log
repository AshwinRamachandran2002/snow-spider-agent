  t."actor":"id"::STRING AS "watcher_id"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t
WHERE t."type" = 'WatchEvent'
  AND t."repo":"name"::STRING ILIKE '%<repo_here>%'
LIMIT 20;
```

```sql
-- 10. Description: FINAL RESULT – top 2 repositories (present in SAMPLE_FILES) with >300 distinct watchers during 2017.
SELECT
  w."repo_name",
  w."distinct_watchers"
FROM (
  SELECT
    t."repo":"name"::STRING               AS "repo_name",
    COUNT(DISTINCT t."actor":"id"::STRING) AS "distinct_watchers"
  FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t
  WHERE t."type" = 'WatchEvent'
  GROUP BY t."repo":"name"::STRING
  HAVING COUNT(DISTINCT t."actor":"id"::STRING) > 300
) w
INNER JOIN "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES" f
  ON w."repo_name" = f."repo_name"
ORDER BY w."distinct_watchers" DESC
LIMIT 2;
```

