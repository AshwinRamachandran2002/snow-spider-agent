  t."repo":"name"::STRING  AS "repo_name",
  t."actor":"id"::STRING   AS "watcher_id"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t
WHERE t."type" = 'WatchEvent'
LIMIT 20;
```

```sql
-- 5. Description: Count distinct watchers for each repo (top 10 by watcher count).
SELECT
  t."repo":"name"::STRING               AS "repo_name",
  COUNT(DISTINCT t."actor":"id"::STRING) AS "distinct_watchers"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t
WHERE t."type" = 'WatchEvent'
GROUP BY t."repo":"name"::STRING
ORDER BY "distinct_watchers" DESC
LIMIT 20;
```

```sql
-- 6. Description: Repos that already exceed 300 distinct watchers (pre‑join, top 10).
SELECT
  t."repo":"name"::STRING               AS "repo_name",
  COUNT(DISTINCT t."actor":"id"::STRING) AS "distinct_watchers"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t
WHERE t."type" = 'WatchEvent'
GROUP BY t."repo":"name"::STRING
HAVING COUNT(DISTINCT t."actor":"id"::STRING) > 300
ORDER BY "distinct_watchers" DESC
LIMIT 20;
```

```sql
-- 7. Description: Peek at the SAMPLE_FILES table so we know the structure of the join key.
SELECT DISTINCT f."repo_name"
FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES" f
LIMIT 20;
```

```sql
-- 8. Description: Bring the two datasets together; list repos with 300+ watchers that also appear in SAMPLE_FILES.
SELECT
  w."repo_name",
  w."distinct_watchers"
FROM (
  SELECT
    t."repo":"name"::STRING               AS "repo_name",
    COUNT(DISTINCT t."actor":"id"::STRING) AS "distinct_watchers"
  FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t
  WHERE t."type" = 'WatchEvent'
  GROUP BY t."repo":"name"::STRING
  HAVING COUNT(DISTINCT t."actor":"id"::STRING) > 300
) w
INNER JOIN "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES" f
  ON w."repo_name" = f."repo_name"
ORDER BY w."distinct_watchers" DESC
LIMIT 20;
```

```sql
-- 9. Description: Verify distinct watcher IDs for one high‑traffic repo (replace <repo_here> after inspection).
