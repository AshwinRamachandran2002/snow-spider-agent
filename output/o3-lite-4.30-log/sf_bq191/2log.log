2025-05-01 00:57:27 - Thread-144 (execute) - INFO - [Exploration]
Relevant tables / columns and their potential usage  
• YEAR."_2017"."type" : filter to only `"WatchEvent"` rows  
• YEAR."_2017"."repo":"name"::STRING : repository full name that was watched  
• YEAR."_2017"."actor":"login"::STRING : user who watched (used to count distinct watchers)  
• GITHUB_REPOS.SAMPLE_FILES."repo_name" : join‑key so we only keep repos that also occur in Sample Files  
Conditions that may be needed  
• YEAR."_2017"."type" = 'WatchEvent'  
• HAVING COUNT(DISTINCT …) > 300  
• JOIN GITHUB_REPOS.SAMPLE_FILES f  
  ON repo_name extracted from events = f."repo_name"  

Below are ten different Snowflake SQL queries (from very simple exploration to the complete answer).  
All identifiers are enclosed in double quotes and every statement is preceded by a short comment.

```sql
-- 1. Peek at raw 2017 event rows
SELECT *
FROM "GITHUB_REPOS_DATE"."YEAR"."_2017"
LIMIT 20;
```

```sql
-- 2. See distinct event types occurring in 2017
SELECT DISTINCT "type"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2017"
LIMIT 20;
```

```sql
-- 3. Look only at WatchEvent records
SELECT *
FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t
WHERE t."type" = 'WatchEvent'
LIMIT 20;
```

```sql
-- 4. Extract repository names and watcher logins from WatchEvents
SELECT 
       t."repo":"name"::STRING   AS "repo_name",
       t."actor":"login"::STRING AS "watcher_login"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t
WHERE t."type" = 'WatchEvent'
LIMIT 20;
```

```sql
-- 5. Count all WatchEvent rows per repository (raw count, not distinct watchers)
SELECT 
       t."repo":"name"::STRING AS "repo_name",
       COUNT(*)               AS "watch_event_rows"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t
WHERE t."type" = 'WatchEvent'
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 6. Count DISTINCT watchers per repository
SELECT 
       t."repo":"name"::STRING                    AS "repo_name",
       COUNT(DISTINCT t."actor":"login"::STRING)  AS "distinct_watchers"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t
WHERE t."type" = 'WatchEvent'
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 7. Keep only repositories whose distinct watcher count exceeds 300
SELECT 
       t."repo":"name"::STRING                    AS "repo_name",
       COUNT(DISTINCT t."actor":"login"::STRING)  AS "distinct_watchers"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t
WHERE t."type" = 'WatchEvent'
GROUP BY 1
HAVING COUNT(DISTINCT t."actor":"login"::STRING) > 300
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 8. Join the >300‑watcher result with SAMPLE_FILES to retain repos present there
SELECT 
       w."repo_name",
       w."distinct_watchers"
FROM  (
        SELECT 
               t."repo":"name"::STRING                    AS "repo_name",
               COUNT(DISTINCT t."actor":"login"::STRING)  AS "distinct_watchers"
        FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t
        WHERE t."type" = 'WatchEvent'
        GROUP BY 1
        HAVING COUNT(DISTINCT t."actor":"login"::STRING) > 300
      ) w
JOIN "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES" f
     ON w."repo_name" = f."repo_name"
LIMIT 20;
```

```sql
-- 9. Retrieve top 10 such repositories after the join, ordered by watcher count
SELECT 
       w."repo_name",
       w."distinct_watchers"
FROM  (
        SELECT 
               t."repo":"name"::STRING                    AS "repo_name",
               COUNT(DISTINCT t."actor":"login"::STRING)  AS "distinct_watchers"
        FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t
        WHERE t."type" = 'WatchEvent'
        GROUP BY 1
        HAVING COUNT(DISTINCT t."actor":"login"::STRING) > 300
      ) w
JOIN "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES" f
     ON w."repo_name" = f."repo_name"
ORDER BY w."distinct_watchers" DESC
LIMIT 10;
```

```sql
-- 10. Final answer: top two repositories (joined with SAMPLE_FILES) that have >300 distinct watchers
SELECT 
       w."repo_name",
       w."distinct_watchers"
FROM  (
        SELECT 
               t."repo":"name"::STRING                    AS "repo_name",
               COUNT(DISTINCT t."actor":"login"::STRING)  AS "distinct_watchers"
        FROM "GITHUB_REPOS_DATE"."YEAR"."_2017" t
        WHERE t."type" = 'WatchEvent'
        GROUP BY 1
        HAVING COUNT(DISTINCT t."actor":"login"::STRING) > 300
      ) w
JOIN "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES" f
     ON w."repo_name" = f."repo_name"
ORDER BY w."distinct_watchers" DESC
LIMIT 2;
```
