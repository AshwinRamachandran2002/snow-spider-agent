Relevant columns and their potential usage  

1. LANGUAGES."repo_name": repository identifier –‑ use to join with commits.  
2. LANGUAGES."language": VARIANT/json with language names –‑ filter repos that contain ‘Python’.  
   • Condition idea → WHERE "language"::STRING ILIKE '%Python%'  
3. SAMPLE_COMMITS."repo_name": repository identifier –‑ join to LANGUAGES.  
4. SAMPLE_COMMITS."author":"date": micro‑seconds since epoch –‑ pick commits that happened in 2016.  
   • Condition idea → BETWEEN 1451606400000000 AND 1483228799000000  (2016‑01‑01 .. 2016‑12‑31)  
5. SAMPLE_COMMITS."commit": commit hash –‑ can be counted.  

-------------------------------------------------------------------
Ten exploratory queries (each different, all limited to 20 rows)  

```sql
--Description: 1) Peek at the LANGUAGES table to see raw language data
SELECT 
  "repo_name",
  "language"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"
LIMIT 20;
```

```sql
--Description: 2) Find repositories whose language field mentions Python
SELECT DISTINCT
  "repo_name"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"
WHERE "language"::STRING ILIKE '%Python%'
LIMIT 20;
```

```sql
--Description: 3) Count how many repositories are tagged with Python
SELECT 
  COUNT(*) AS "python_repo_count"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"
WHERE "language"::STRING ILIKE '%Python%'
LIMIT 20;
```

```sql
--Description: 4) Inspect one commit record to understand the author.date field
SELECT 
  "repo_name",
  "commit",
  "author":"date" AS "author_date_micro"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_COMMITS"
LIMIT 20;
```

```sql
--Description: 5) Look at commits in a single Python repo to verify dates
SELECT 
  c."repo_name",
  c."commit",
  c."author":"date" AS "author_date_micro"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_COMMITS" c
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" l
  ON c."repo_name" = l."repo_name"
WHERE l."language"::STRING ILIKE '%Python%'
LIMIT 20;
```

```sql
--Description: 6) Pull commits made in calendar‑year 2016 for Python repos
SELECT 
  c."repo_name",
  c."commit",
  c."author":"date" AS "author_date_micro"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_COMMITS" c
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" l
  ON c."repo_name" = l."repo_name"
WHERE l."language"::STRING ILIKE '%Python%'
  AND c."author":"date" BETWEEN 1451606400000000 AND 1483228799000000
LIMIT 20;
```

```sql
--Description: 7) Aggregate 2016 Python commits by repo & month (microseconds → month by simple arithmetic)
SELECT 
  c."repo_name",
  FLOOR( (c."author":"date") / 1000000 / 86400 / 30 ) AS "rough_month_bucket",
  COUNT(*) AS "commit_cnt"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_COMMITS" c
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" l
  ON c."repo_name" = l."repo_name"
WHERE l."language"::STRING ILIKE '%Python%'
  AND c."author":"date" BETWEEN 1451606400000000 AND 1483228799000000
GROUP BY 1,2
LIMIT 20;
```

```sql
--Description: 8) Number of commits each month summed over all Python repos (calendar month extracted via DATEADD/TO_TIMESTAMP)
SELECT 
  TO_CHAR( DATEADD('second', (c."author":"date")/1000000, '1970-01-01'), 'YYYY-MM' ) AS "month",
  COUNT(*) AS "total_commits"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_COMMITS" c
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" l
  ON c."repo_name" = l."repo_name"
WHERE l."language"::STRING ILIKE '%Python%'
  AND c."author":"date" BETWEEN 1451606400000000 AND 1483228799000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 9) Commit counts and running average per month
SELECT 
  m."month",
  m."total_commits",
  AVG(m."total_commits") OVER() AS "average_2016"
FROM (
  SELECT 
    TO_CHAR( DATEADD('second', (c."author":"date")/1000000, '1970-01-01'), 'YYYY-MM' ) AS "month",
    COUNT(*) AS "total_commits"
  FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_COMMITS" c
  JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" l
    ON c."repo_name" = l."repo_name"
  WHERE l."language"::STRING ILIKE '%Python%'
    AND c."author":"date" BETWEEN 1451606400000000 AND 1483228799000000
  GROUP BY 1
) m
ORDER BY m."month"
LIMIT 20;
```

```sql
--Description: 10) Final query – average number of commits per month in 2016 for all repositories containing Python code
SELECT 
  AVG(month_commit_count) AS "avg_commits_per_month_2016"
FROM (
  SELECT 
    TO_CHAR( DATEADD('second', (c."author":"date")/1000000, '1970-01-01'), 'YYYY-MM' ) AS month_label,
    COUNT(*) AS month_commit_count
  FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_COMMITS" c
  JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" l
    ON c."repo_name" = l."repo_name"
  WHERE l."language"::STRING ILIKE '%Python%'
    AND c."author":"date" BETWEEN 1451606400000000 AND 1483228799000000
  GROUP BY month_label
) t
LIMIT 20;
```
