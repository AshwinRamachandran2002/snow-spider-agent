```sql
--Description: We need the 2016 commits from repos that list Python in LANGUAGES.  
--1) LANGUAGES: keep repos where the string “Python” appears in the text form of the VARIANT column "language".  
--2) SAMPLE_COMMITS: convert the micro‑second epoch in "author":"date" to TIMESTAMP, then restrict to the 2016 calendar year.  
--3) Count commits for each month of 2016 (DATE_TRUNC('month', …)).  
--4) Outer query takes the average of those twelve monthly counts = average commits per month in 2016.  
SELECT
    AVG(monthly_counts."monthly_cnt") AS "avg_commits_per_month_2016"
FROM (
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP(c."author":"date"::NUMBER / 1000000)) AS "month_2016",
        COUNT(*) AS "monthly_cnt"
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_COMMITS c
    JOIN GITHUB_REPOS.GITHUB_REPOS.LANGUAGES      l
         ON c."repo_name" = l."repo_name"
    WHERE CAST(l."language" AS STRING) ILIKE '%Python%'                              -- repos containing Python
      AND DATE_TRUNC('year', TO_TIMESTAMP(c."author":"date"::NUMBER / 1000000)) = '2016-01-01'  -- year 2016
    GROUP BY
        DATE_TRUNC('month', TO_TIMESTAMP(c."author":"date"::NUMBER / 1000000))
) AS monthly_counts;
