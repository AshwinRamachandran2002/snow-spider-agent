/* summary statistics for chr1:55039447‑55064852 in gnomAD v3 genomes */
SELECT
  cnt.variants                                         AS variants,
  cnt.total_allele_count                               AS total_allele_count,
  cnt.total_number_of_alleles                          AS total_number_of_alleles,
  -- comma‑separated list of distinct gene symbols found by VEP
  ( SELECT ARRAY_TO_STRING(
             ARRAY_AGG(DISTINCT vep.SYMBOL ORDER BY vep.SYMBOL), ',' )
      FROM `bigquery-public-data.gnomAD.v3_genomes__chr1` t2
           JOIN UNNEST(t2.alternate_bases) alt2
           JOIN UNNEST(alt2.vep)           vep
     WHERE t2.reference_name = 'chr1'
       AND t2.start_position BETWEEN 55039447 AND 55064852
       AND vep.SYMBOL IS NOT NULL )                    AS gene_symbols,
  -- mutation density (base‑pairs per variant)
  25405.0 / cnt.variants                               AS mutation_density_bp_per_variant
FROM (
  SELECT
    COUNT(DISTINCT t.start_position)                              AS variants,
    SUM(COALESCE(alt.AC,0))                                       AS total_allele_count,
    SUM(COALESCE(t.AN,0))                                         AS total_number_of_alleles
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1` t
       JOIN UNNEST(t.alternate_bases) alt
  WHERE t.reference_name = 'chr1'
    AND t.start_position BETWEEN 55039447 AND 55064852
) AS cnt;
