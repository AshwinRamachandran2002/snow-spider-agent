```sql
--Description / thinking process:
-- Goal: one‑row overview of variants between 55 039 447‑55 064 852 on chr1.
-- Steps
-- 1) per_variant CTE
--    • UNNEST(alternate_bases) to access every alternate allele.
--    • SUM(alt.AC)  → total allele count (AC) for that variant position.
--    • ANY_VALUE(AN)  → total called alleles; AN is constant within the row.
--    • ARRAY_AGG DISTINCT VEP symbols to keep unique gene names per variant.
-- 2) Final SELECT
--    • variant_count           : number of variant rows.
--    • total_allele_count      : Σ AC across region.
--    • total_number_of_alleles : Σ AN across region.
--    • distinct_gene_symbols   : flatten & de‑duplicate all gene arrays, join with comma.
--    • region_length_per_variant = (region length) / variant_count ⇒ mutation density.
WITH per_variant AS (
  SELECT
    start_position,
    SUM(alt.AC)                                    AS ac_sum,
    ANY_VALUE(AN)                                  AS an_value,
    ARRAY_AGG(DISTINCT vep_item.SYMBOL IGNORE NULLS) AS gene_syms
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1` AS t
  CROSS JOIN UNNEST(t.alternate_bases) AS alt
  LEFT  JOIN UNNEST(alt.vep)          AS vep_item ON TRUE
  WHERE t.reference_name = 'chr1'
    AND t.start_position BETWEEN 55039447 AND 55064852
  GROUP BY start_position
)
SELECT
  COUNT(*)                                         AS variant_count,
  SUM(ac_sum)                                      AS total_allele_count,
  SUM(an_value)                                    AS total_number_of_alleles,
  ARRAY_TO_STRING(
      ARRAY(
        SELECT DISTINCT g FROM per_variant, UNNEST(gene_syms) AS g
      ),
      ', '
  )                                                AS distinct_gene_symbols,
  (55064852 - 55039447) / COUNT(*)                 AS region_length_per_variant
FROM per_variant;
```
