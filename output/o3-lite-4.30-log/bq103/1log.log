  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
  WHERE reference_name = 'chr1'
    AND start_position BETWEEN 55039447 AND 55064852
)
SELECT
  region_length / n_var AS region_length_per_variant
FROM region, var_count
LIMIT 20;
```

```sql
-- 9. Position, gene symbol(s), allele count – one row per alt allele
SELECT
  t.start_position,
  vep_entry.SYMBOL AS gene_symbol,
  alt.AC           AS allele_count
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1` AS t
JOIN UNNEST(t.alternate_bases) AS alt
JOIN UNNEST(alt.vep)           AS vep_entry
ON TRUE
WHERE t.reference_name = 'chr1'
  AND t.start_position BETWEEN 55039447 AND 55064852
ORDER BY t.start_position
LIMIT 20;
```

```sql
-- 10. Final one‑row summary: #variants, total AC, total AN, distinct gene list, density
WITH base AS (
  SELECT
    start_position,
    SUM(alt.AC) AS sum_AC_per_variant,
    ANY_VALUE(AN) AS AN_per_variant,
    ARRAY_AGG(DISTINCT vep_entry.SYMBOL IGNORE NULLS) AS symbols
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
       UNNEST(alternate_bases) AS alt
  LEFT JOIN UNNEST(alt.vep) AS vep_entry
  ON TRUE
  WHERE reference_name = 'chr1'
    AND start_position BETWEEN 55039447 AND 55064852
  GROUP BY start_position
)
SELECT
  COUNT(*)                                        AS variant_count,
  SUM(sum_AC_per_variant)                         AS total_allele_count,
  SUM(AN_per_variant)                             AS total_number_of_alleles,
  ARRAY_TO_STRING(ARRAY(SELECT DISTINCT s FROM UNNEST(symbols) AS s), ', ') AS distinct_gene_symbols,
  (55064852 - 55039447) / COUNT(*)               AS region_length_per_variant
FROM base
LIMIT 20;
```

