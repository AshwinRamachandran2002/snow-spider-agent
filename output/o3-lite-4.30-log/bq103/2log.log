)
SELECT
  vs.variants,
  vs.total_allele_count,
  vs.total_number_of_alleles,
  gs.genes                                              AS gene_symbols,
  ROUND((region_end - region_start + 1) / vs.variants, 4) AS mutation_density_bp_per_variant
FROM variant_stats AS vs
CROSS JOIN gene_symbols AS gs
CROSS JOIN region;
