Begin Exploring Related Columns
Relevant columns and typical filters  

state_name / state_code : identify California (`state_name` = 'California' or `state_code` = '06')  
date_local : allows us to ① restrict to the 2020 calendar year ② derive the “month” key (`FORMAT_DATE('%Y-%m', date_local)`)  
arithmetic_mean : daily mean concentration that will be averaged again at the monthly level  
parameter_name / parameter_code : may help confirm the pollutant but are not strictly needed once the proper table is chosen  
units_of_measure : sanity check that the same units are kept in every row  
Any other column can stay un‑used for the present task.

Typical WHERE clause used below  
• `state_name = 'California'`  
• `EXTRACT(YEAR FROM date_local) = 2020`  

--------------------------------------------------------------------
Ten exploratory → incremental → final SQL statements
(each finishes with `LIMIT 20` and uses back‑ticks for every identifier)

```sql
--Description: 1) Peek distinct state names stored in the PM10 table
SELECT DISTINCT `state_name`
FROM `bigquery-public-data.epa_historical_air_quality.pm10_daily_summary`
LIMIT 20;
```

```sql
--Description: 2) Sample daily PM10 readings taken in California during 2020
SELECT `date_local`, `arithmetic_mean`, `units_of_measure`
FROM `bigquery-public-data.epa_historical_air_quality.pm10_daily_summary`
WHERE `state_name` = 'California'
  AND EXTRACT(YEAR FROM `date_local`) = 2020
LIMIT 20;
```

```sql
--Description: 3) Sample daily PM2.5 FRM observations for California, 2020
SELECT `date_local`, `arithmetic_mean`
FROM `bigquery-public-data.epa_historical_air_quality.pm25_frm_daily_summary`
WHERE `state_name` = 'California'
  AND EXTRACT(YEAR FROM `date_local`) = 2020
LIMIT 20;
```

```sql
--Description: 4) Compute monthly average of PM10 for California, 2020
SELECT
  FORMAT_DATE('%Y-%m', `date_local`) AS month,
  AVG(`arithmetic_mean`)            AS pm10_avg
FROM `bigquery-public-data.epa_historical_air_quality.pm10_daily_summary`
WHERE `state_name` = 'California'
  AND EXTRACT(YEAR FROM `date_local`) = 2020
GROUP BY month
ORDER BY month
LIMIT 20;
```

```sql
--Description: 5) Monthly average of PM2.5 FRM for California, 2020
SELECT
  FORMAT_DATE('%Y-%m', `date_local`) AS month,
  AVG(`arithmetic_mean`)            AS pm25_frm_avg
FROM `bigquery-public-data.epa_historical_air_quality.pm25_frm_daily_summary`
WHERE `state_name` = 'California'
  AND EXTRACT(YEAR FROM `date_local`) = 2020
GROUP BY month
ORDER BY month
LIMIT 20;
```

```sql
--Description: 6) Monthly average of PM2.5 non‑FRM for California, 2020
SELECT
  FORMAT_DATE('%Y-%m', `date_local`) AS month,
  AVG(`arithmetic_mean`)            AS pm25_nonfrm_avg
FROM `bigquery-public-data.epa_historical_air_quality.pm25_nonfrm_daily_summary`
WHERE `state_name` = 'California'
  AND EXTRACT(YEAR FROM `date_local`) = 2020
GROUP BY month
ORDER BY month
LIMIT 20;
```

```sql
--Description: 7) Monthly average of Volatile Organic Compounds (VOC) for CA, 2020
SELECT
  FORMAT_DATE('%Y-%m', `date_local`) AS month,
  AVG(`arithmetic_mean`)            AS voc_avg
FROM `bigquery-public-data.epa_historical_air_quality.voc_daily_summary`
WHERE `state_name` = 'California'
  AND EXTRACT(YEAR FROM `date_local`) = 2020
GROUP BY month
ORDER BY month
LIMIT 20;
```

```sql
--Description: 8) Monthly average of SO2, then scaled ×10, for CA, 2020
SELECT
  FORMAT_DATE('%Y-%m', `date_local`)      AS month,
  AVG(`arithmetic_mean`)*10.0             AS so2_scaled_avg
FROM `bigquery-public-data.epa_historical_air_quality.so2_daily_summary`
WHERE `state_name` = 'California'
  AND EXTRACT(YEAR FROM `date_local`) = 2020
GROUP BY month
ORDER BY month
LIMIT 20;
```

```sql
--Description: 9) Monthly average of Lead, scaled ×100, for CA, 2020
SELECT
  FORMAT_DATE('%Y-%m', `date_local`)      AS month,
  AVG(`arithmetic_mean`)*100.0            AS lead_scaled_avg
FROM `bigquery-public-data.epa_historical_air_quality.lead_daily_summary`
WHERE `state_name` = 'California'
  AND EXTRACT(YEAR FROM `date_local`) = 2020
GROUP BY month
ORDER BY month
LIMIT 20;
```

```sql
--Description: 10) Final combined monthly averages for all six pollutants in CA, 2020
WITH
pm10 AS (
  SELECT FORMAT_DATE('%Y-%m', `date_local`) AS month,
         AVG(`arithmetic_mean`)             AS pm10_avg
  FROM `bigquery-public-data.epa_historical_air_quality.pm10_daily_summary`
  WHERE `state_name` = 'California'
    AND EXTRACT(YEAR FROM `date_local`) = 2020
  GROUP BY month
),
pm25_frm AS (
  SELECT FORMAT_DATE('%Y-%m', `date_local`) AS month,
         AVG(`arithmetic_mean`)             AS pm25_frm_avg
  FROM `bigquery-public-data.epa_historical_air_quality.pm25_frm_daily_summary`
  WHERE `state_name` = 'California'
    AND EXTRACT(YEAR FROM `date_local`) = 2020
  GROUP BY month
),
pm25_nonfrm AS (
  SELECT FORMAT_DATE('%Y-%m', `date_local`) AS month,
         AVG(`arithmetic_mean`)             AS pm25_nonfrm_avg
  FROM `bigquery-public-data.epa_historical_air_quality.pm25_nonfrm_daily_summary`
  WHERE `state_name` = 'California'
    AND EXTRACT(YEAR FROM `date_local`) = 2020
  GROUP BY month
),
voc AS (
  SELECT FORMAT_DATE('%Y-%m', `date_local`) AS month,
         AVG(`arithmetic_mean`)             AS voc_avg
  FROM `bigquery-public-data.epa_historical_air_quality.voc_daily_summary`
  WHERE `state_name` = 'California'
    AND EXTRACT(YEAR FROM `date_local`) = 2020
  GROUP BY month
),
so2 AS (
  SELECT FORMAT_DATE('%Y-%m', `date_local`) AS month,
         AVG(`arithmetic_mean`)*10.0        AS so2_scaled_avg
  FROM `bigquery-public-data.epa_historical_air_quality.so2_daily_summary`
  WHERE `state_name` = 'California'
    AND EXTRACT(YEAR FROM `date_local`) = 2020
  GROUP BY month
),
lead AS (
  SELECT FORMAT_DATE('%Y-%m', `date_local`) AS month,
         AVG(`arithmetic_mean`)*100.0       AS lead_scaled_avg
  FROM `bigquery-public-data.epa_historical_air_quality.lead_daily_summary`
  WHERE `state_name` = 'California'
    AND EXTRACT(YEAR FROM `date_local`) = 2020
  GROUP BY month
)

SELECT
  pm10.month                                   AS month,
  pm10.pm10_avg,
  pm25_frm.pm25_frm_avg,
  pm25_nonfrm.pm25_nonfrm_avg,
  voc.voc_avg,
  so2.so2_scaled_avg,
  lead.lead_scaled_avg
FROM pm10
LEFT JOIN pm25_frm     USING (month)
LEFT JOIN pm25_nonfrm  USING (month)
LEFT JOIN voc          USING (month)
LEFT JOIN so2          USING (month)
LEFT JOIN lead         USING (month)
ORDER BY month
LIMIT 20;
```

