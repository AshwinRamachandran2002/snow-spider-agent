Relevant columns and their possible usage  
------------------------------------------------  
patient.id   : join‐key that uniquely identifies each patient  
patient.deceased.dateTime   : NULL  ⇒  patient is still alive  
condition.subject.patientId   : join‐key to patient.id  
condition.code.text / condition.code.coding (UNNEST).display   : look‑up strings that contain “diabetes” or “hypertension”  
condition.clinicalStatus / verificationStatus   : optional filter for confirmed / active diagnoses  
medication_request.subject.patientId   : join‐key to patient.id  
medication_request.status   : we want only records whose status = 'active'  
medication_request.medication.codeableConcept.coding.code or .display (UNNEST)   : medication identifier; use DISTINCT to count per patient  

Typical conditions you may use  
• patient.deceased.dateTime IS NULL  
• LOWER(condition.code.text) LIKE '%diabetes%' OR …  
• medication_request.status = 'active'  
• HAVING COUNT(DISTINCT med_code) ≥ 7  

Ten exploratory BigQuery SQL queries  
------------------------------------  

```sql
-- 1. Inspect a few patients and their deceased flag
SELECT id, deceased.dateTime
FROM `bigquery-public-data.fhir_synthea.patient`
LIMIT 20;
```

```sql
-- 2. Pull only the patients who are still alive
SELECT id
FROM `bigquery-public-data.fhir_synthea.patient`
WHERE deceased.dateTime IS NULL
LIMIT 20;
```

```sql
-- 3. Look at condition texts that mention diabetes or hypertension
SELECT id,
       code.text            AS cond_text,
       c_coding.display     AS coding_display
FROM   `bigquery-public-data.fhir_synthea.condition`,
       UNNEST(code.coding) AS c_coding
WHERE  LOWER(code.text)      LIKE '%diabetes%'
    OR LOWER(code.text)      LIKE '%hypertension%'
    OR LOWER(c_coding.display) LIKE '%diabetes%'
    OR LOWER(c_coding.display) LIKE '%hypertension%'
LIMIT 20;
```

```sql
-- 4. All alive patients who have either diabetes or hypertension
SELECT DISTINCT p.id AS patient_id
FROM `bigquery-public-data.fhir_synthea.patient`   AS p
JOIN `bigquery-public-data.fhir_synthea.condition` AS c
  ON p.id = c.subject.patientId
LEFT JOIN UNNEST(c.code.coding) AS cc
WHERE p.deceased.dateTime IS NULL
  AND ( LOWER(c.code.text)        LIKE '%diabetes%'
     OR LOWER(c.code.text)        LIKE '%hypertension%'
     OR LOWER(cc.display)         LIKE '%diabetes%'
     OR LOWER(cc.display)         LIKE '%hypertension%' )
LIMIT 20;
```

```sql
-- 5. Look at active medication requests and a derived medication code/display
SELECT id,
       subject.patientId      AS patient_id,
       status,
       m_coding.code          AS med_code,
       m_coding.display       AS med_display
FROM   `bigquery-public-data.fhir_synthea.medication_request`,
       UNNEST(medication.codeableConcept.coding) AS m_coding
WHERE  status = 'active'
LIMIT 20;
```

```sql
-- 6. Count distinct active medications per patient
SELECT subject.patientId                    AS patient_id,
       COUNT(DISTINCT m_coding.code)        AS active_meds
FROM   `bigquery-public-data.fhir_synthea.medication_request`,
       UNNEST(medication.codeableConcept.coding) AS m_coding
WHERE  status = 'active'
GROUP  BY patient_id
LIMIT 20;
```

```sql
-- 7. Patients with at least seven distinct active medications
SELECT patient_id
FROM (
  SELECT subject.patientId                 AS patient_id,
         COUNT(DISTINCT m_coding.code)     AS active_meds
  FROM   `bigquery-public-data.fhir_synthea.medication_request`,
         UNNEST(medication.codeableConcept.coding) AS m_coding
  WHERE  status = 'active'
  GROUP  BY patient_id
)
WHERE active_meds >= 7
LIMIT 20;
```

```sql
-- 8. Combine diagnoses and medication counts for alive patients
WITH alive AS (
  SELECT id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient`
  WHERE deceased.dateTime IS NULL
),
dx AS (
  SELECT DISTINCT c.subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  LEFT JOIN UNNEST(c.code.coding) AS cc
  WHERE LOWER(c.code.text)      LIKE '%diabetes%'
     OR LOWER(c.code.text)      LIKE '%hypertension%'
     OR LOWER(cc.display)       LIKE '%diabetes%'
     OR LOWER(cc.display)       LIKE '%hypertension%'
),
meds AS (
  SELECT subject.patientId             AS patient_id,
         COUNT(DISTINCT m_coding.code) AS n_meds
  FROM   `bigquery-public-data.fhir_synthea.medication_request`,
         UNNEST(medication.codeableConcept.coding) AS m_coding
  WHERE  status = 'active'
  GROUP  BY patient_id
  HAVING n_meds >= 7
)
SELECT a.patient_id
FROM   alive a
JOIN   dx    USING(patient_id)
JOIN   meds  USING(patient_id)
LIMIT 20;
```

```sql
-- 9. How many such patients satisfy all three criteria?
WITH alive AS (
  SELECT id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient`
  WHERE deceased.dateTime IS NULL
),
dx AS (
  SELECT DISTINCT c.subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  LEFT JOIN UNNEST(c.code.coding) AS cc
  WHERE LOWER(c.code.text)      LIKE '%diabetes%'
     OR LOWER(c.code.text)      LIKE '%hypertension%'
     OR LOWER(cc.display)       LIKE '%diabetes%'
     OR LOWER(cc.display)       LIKE '%hypertension%'
),
meds AS (
  SELECT subject.patientId             AS patient_id,
         COUNT(DISTINCT m_coding.code) AS n_meds
  FROM   `bigquery-public-data.fhir_synthea.medication_request`,
         UNNEST(medication.codeableConcept.coding) AS m_coding
  WHERE  status = 'active'
  GROUP  BY patient_id
  HAVING n_meds >= 7
)
SELECT COUNT(*) AS alive_with_dx_and_7plus_meds
FROM   alive
JOIN   dx   USING(patient_id)
JOIN   meds USING(patient_id);
```

```sql
-- 10. (Same as #9 but returns the detailed list and medication count)
WITH alive AS (
  SELECT id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient`
  WHERE deceased.dateTime IS NULL
),
dx AS (
  SELECT DISTINCT c.subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  LEFT JOIN UNNEST(c.code.coding) AS cc
  WHERE LOWER(c.code.text)      LIKE '%diabetes%'
     OR LOWER(c.code.text)      LIKE '%hypertension%'
     OR LOWER(cc.display)       LIKE '%diabetes%'
     OR LOWER(cc.display)       LIKE '%hypertension%'
),
meds AS (
  SELECT subject.patientId             AS patient_id,
         COUNT(DISTINCT m_coding.code) AS n_active_meds
  FROM   `bigquery-public-data.fhir_synthea.medication_request`,
         UNNEST(medication.codeableConcept.coding) AS m_coding
  WHERE  status = 'active'
  GROUP  BY patient_id
  HAVING n_active_meds >= 7
)
SELECT a.patient_id, n_active_meds
FROM   alive a
JOIN   dx   USING(patient_id)
JOIN   meds USING(patient_id)
LIMIT 20;
```

Each query is limited to 20 rows (except the aggregate count in #9) and is wrapped in back‑ticks exactly as requested.
