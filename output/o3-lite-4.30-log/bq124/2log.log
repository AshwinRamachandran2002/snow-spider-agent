The table structure information is ({database name: {schema name: [table name]}}): 
{'bigquery-public-data': {'fhir_synthea': ['patient', 'condition', 'medication_request']}}
Begin Exploring Related Columns
Relevant columns and why they matter  
• `patient.id`: primary key we will join on.  
• `patient.deceased.dateTime`: NULL ⇒ the patient is still alive.  
• `condition.subject.patientId`: joins a condition record to the patient.  
• `condition.code.text` / `condition.code.coding[*].display` / `condition.code.coding[*].code`: look‑up wording or codes that contain “diabetes” or “hypertension”.  
• `medication_request.subject.patientId`: joins a medication request to the patient.  
• `medication_request.status`: must be `'active'` for a current prescription.  
• `medication_request.medication.codeableConcept.coding[*].code` (or `.display`): lets us count DISTINCT drugs per patient.  

Typical filters  
• Alive: `p.deceased.dateTime IS NULL`  
• Diabetes / Hypertension:  
  `LOWER(co.code.text) LIKE '%diabetes%' OR`  
  `LOWER(cod.display) LIKE '%hypertension%'` … (after UNNEST of `code.coding`).  
• Active prescriptions: `mr.status = 'active'`  
• ≥ 7 distinct drugs: `HAVING COUNT(DISTINCT med.code) >= 7`  

--------------------------------------------------------------------
Ten exploratory ➜ increasingly complex BigQuery queries  
(all end with `LIMIT 20` for safety/preview)

```sql
-- 1. Patients and their death flag
SELECT p.id, p.deceased.dateTime
FROM `bigquery-public-data.fhir_synthea.patient` AS p
LIMIT 20;
```

```sql
-- 2. Any condition rows whose free‑text mentions diabetes
SELECT DISTINCT c.id, c.subject.patientId, c.code.text
FROM `bigquery-public-data.fhir_synthea.condition` AS c
WHERE LOWER(c.code.text) LIKE '%diabetes%'
LIMIT 20;
```

```sql
-- 3. Any coding display that mentions hypertension
SELECT DISTINCT c.id,
       c.subject.patientId,
       cod.display
FROM `bigquery-public-data.fhir_synthea.condition` AS c
CROSS JOIN UNNEST(c.code.coding) AS cod
WHERE LOWER(cod.display) LIKE '%hypertension%'
LIMIT 20;
```

```sql
-- 4. Look at the status distribution of medication requests
SELECT mr.status, COUNT(*) AS records
FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
GROUP BY mr.status
LIMIT 20;
```

```sql
-- 5. Sample of active prescriptions with a flattened drug code
SELECT mr.id,
       mr.subject.patientId,
       cod.code            AS drug_code,
       cod.display         AS drug_name
FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS cod
WHERE mr.status = 'active'
LIMIT 20;
```

```sql
-- 6. Alive patients who have any diabetes OR hypertension diagnosis
SELECT DISTINCT p.id
FROM `bigquery-public-data.fhir_synthea.patient`  AS p
JOIN `bigquery-public-data.fhir_synthea.condition` AS c
  ON p.id = c.subject.patientId
LEFT JOIN UNNEST(c.code.coding) AS cod
WHERE p.deceased.dateTime IS NULL
  AND (
        LOWER(c.code.text) LIKE '%diabetes%' OR
        LOWER(c.code.text) LIKE '%hypertension%' OR
        LOWER(cod.display) LIKE '%diabetes%'   OR
        LOWER(cod.display) LIKE '%hypertension%'
      )
LIMIT 20;
```

```sql
-- 7. Count distinct active drugs per patient
SELECT mr.subject.patientId         AS patient_id,
       COUNT(DISTINCT cod.code)     AS distinct_active_drugs
FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS cod
WHERE mr.status = 'active'
GROUP BY patient_id
LIMIT 20;
```

```sql
-- 8. Patients with ≥7 active medications
SELECT patient_id
FROM (
      SELECT mr.subject.patientId AS patient_id,
             COUNT(DISTINCT cod.code) AS distinct_active_drugs
      FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
      CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS cod
      WHERE mr.status = 'active'
      GROUP BY patient_id
     )
WHERE distinct_active_drugs >= 7
LIMIT 20;
```

```sql
-- 9. Combine alive flag + Dx + ≥7 drugs, list qualifying patient IDs
SELECT DISTINCT alive_and_diseased.patient_id
FROM (
      /* Alive + Diabetes/Hypertension */
      SELECT p.id AS patient_id
      FROM `bigquery-public-data.fhir_synthea.patient`  AS p
      JOIN `bigquery-public-data.fhir_synthea.condition` AS c
        ON p.id = c.subject.patientId
      LEFT JOIN UNNEST(c.code.coding) AS cod
      WHERE p.deceased.dateTime IS NULL
        AND (
              LOWER(c.code.text) LIKE '%diabetes%' OR
              LOWER(c.code.text) LIKE '%hypertension%' OR
              LOWER(cod.display) LIKE '%diabetes%' OR
              LOWER(cod.display) LIKE '%hypertension%'
            )
     ) AS alive_and_diseased
JOIN (
      /* ≥7 active drugs */
      SELECT mr.subject.patientId AS patient_id
      FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
      CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS cod
      WHERE mr.status = 'active'
      GROUP BY patient_id
      HAVING COUNT(DISTINCT cod.code) >= 7
     ) AS med7
  ON alive_and_diseased.patient_id = med7.patient_id
LIMIT 20;
```

```sql
-- 10. Final count of individuals who satisfy ALL conditions
SELECT COUNT(*) AS alive_diabetes_or_htn_with_7plus_drugs
FROM (
      SELECT DISTINCT alive_and_diseased.patient_id
      FROM (
            /* Alive + Diabetes/Hypertension */
            SELECT p.id AS patient_id
            FROM `bigquery-public-data.fhir_synthea.patient`  AS p
            JOIN `bigquery-public-data.fhir_synthea.condition` AS c
              ON p.id = c.subject.patientId
            LEFT JOIN UNNEST(c.code.coding) AS cod
            WHERE p.deceased.dateTime IS NULL
              AND (
                    LOWER(c.code.text) LIKE '%diabetes%' OR
                    LOWER(c.code.text) LIKE '%hypertension%' OR
                    LOWER(cod.display) LIKE '%diabetes%' OR
                    LOWER(cod.display) LIKE '%hypertension%'
                  )
           ) AS alive_and_diseased
      JOIN (
            /* ≥7 active drugs */
            SELECT mr.subject.patientId AS patient_id
            FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
            CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS cod
            WHERE mr.status = 'active'
            GROUP BY patient_id
            HAVING COUNT(DISTINCT cod.code) >= 7
           ) AS med7
        ON alive_and_diseased.patient_id = med7.patient_id
     )
LIMIT 20;
```

Each successive query exposes or narrows down the data needed, culminating in #10, which returns (within the 20‑row preview) the single aggregate count answering the original question.
