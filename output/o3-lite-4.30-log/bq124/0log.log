The table structure information is ({database name: {schema name: [table name]}}): 
{'bigquery-public-data': {'fhir_synthea': ['patient', 'condition', 'medication_request']}}
Begin Exploring Related Columns
Relevant columns and their potential usage  
• `patient.id`: unique patient identifier used to join to the other two tables.  
• `patient.deceased.dateTime`: NULL ⇒ patient is still alive.  
• `condition.subject.patientId`: links a condition record to a patient.  
• `condition.code.coding.code / condition.code.coding.display`: SNOMED (or other) code / text that lets us find “diabetes” or “hypertension”.  
• `condition.clinicalStatus`: could be used to keep only active problems (optional).  
• `medication_request.subject.patientId`: links a medication request to a patient.  
• `medication_request.status`: keep only `active` medication orders.  
• `medication_request.medication.codeableConcept.coding.code` (or `…display`): code that uniquely identifies each prescribed drug so we can count “distinct medications”.  

Typical predicates  
• Alive: `p.deceased.dateTime IS NULL`  
• Diabetes / Hypertension diagnosis:  
  `LOWER(cod.display) LIKE '%diabetes%' OR LOWER(cod.display) LIKE '%hypertension%'`  
• Active prescription: `mr.status = 'active'`  
• Seven or more distinct drugs: `HAVING COUNT(DISTINCT med.code) >= 7`  

--------------------------------------------------------------------
Ten exploratory‑to‑final queries
--------------------------------------------------------------------

```sql
-- 1. Inspect a few patients and their death status
SELECT id, deceased.dateTime
FROM `bigquery-public-data.fhir_synthea.patient`
LIMIT 20;
```

```sql
-- 2. Look at raw condition codes & text
SELECT id AS condition_id,
       subject.patientId,
       cod.system, cod.code, cod.display
FROM `bigquery-public-data.fhir_synthea.condition` AS c,
     UNNEST(c.code.coding) AS cod
LIMIT 20;
```

```sql
-- 3. Distinct codes whose text mentions diabetes or hypertension
SELECT DISTINCT cod.code, cod.display
FROM `bigquery-public-data.fhir_synthea.condition` AS c,
     UNNEST(c.code.coding) AS cod
WHERE LOWER(cod.display) LIKE '%diabetes%'
   OR LOWER(cod.display) LIKE '%hypertension%'
LIMIT 20;
```

```sql
-- 4. Alive patients who have at least one diabetes or hypertension diagnosis
SELECT DISTINCT p.id
FROM `bigquery-public-data.fhir_synthea.patient`   AS p
JOIN `bigquery-public-data.fhir_synthea.condition` AS c
  ON c.subject.patientId = p.id
CROSS JOIN UNNEST(c.code.coding) AS cod
WHERE p.deceased.dateTime IS NULL
  AND (LOWER(cod.display) LIKE '%diabetes%'
       OR LOWER(cod.display) LIKE '%hypertension%')
LIMIT 20;
```

```sql
-- 5. Sample medication‑request rows with status and medication information
SELECT id               AS med_request_id,
       subject.patientId AS patient_id,
       status,
       med.code,
       med.display
FROM `bigquery-public-data.fhir_synthea.medication_request`,
     UNNEST(medication.codeableConcept.coding) AS med
LIMIT 20;
```

```sql
-- 6. How many distinct active drugs per patient?
SELECT subject.patientId          AS patient_id,
       COUNT(DISTINCT med.code)   AS distinct_active_drugs
FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr,
     UNNEST(mr.medication.codeableConcept.coding) AS med
WHERE mr.status = 'active'
GROUP BY subject.patientId
LIMIT 20;
```

```sql
-- 7. Patients with ≥7 active drugs
SELECT subject.patientId
FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr,
     UNNEST(mr.medication.codeableConcept.coding) AS med
WHERE mr.status = 'active'
GROUP BY subject.patientId
HAVING COUNT(DISTINCT med.code) >= 7
LIMIT 20;
```

```sql
-- 8. Alive patients diagnosed with diabetes/hypertension AND ≥7 active drugs
WITH alive_dx AS (
  SELECT DISTINCT p.id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient`   AS p
  JOIN `bigquery-public-data.fhir_synthea.condition` AS c
    ON c.subject.patientId = p.id
  CROSS JOIN UNNEST(c.code.coding) AS cod
  WHERE p.deceased.dateTime IS NULL
    AND (LOWER(cod.display) LIKE '%diabetes%'
         OR LOWER(cod.display) LIKE '%hypertension%')
),
polypharm AS (
  SELECT subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr,
       UNNEST(mr.medication.codeableConcept.coding) AS med
  WHERE mr.status = 'active'
  GROUP BY subject.patientId
  HAVING COUNT(DISTINCT med.code) >= 7
)
SELECT DISTINCT a.patient_id
FROM   alive_dx AS a
JOIN   polypharm AS b
ON     a.patient_id = b.patient_id
LIMIT 20;
```

```sql
-- 9. For those patients, show drug count to verify the threshold
WITH alive_dx AS (
  SELECT DISTINCT p.id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient`   AS p
  JOIN `bigquery-public-data.fhir_synthea.condition` AS c
    ON c.subject.patientId = p.id
  CROSS JOIN UNNEST(c.code.coding) AS cod
  WHERE p.deceased.dateTime IS NULL
    AND (LOWER(cod.display) LIKE '%diabetes%'
         OR LOWER(cod.display) LIKE '%hypertension%')
),
polypharm AS (
  SELECT subject.patientId AS patient_id,
         COUNT(DISTINCT med.code) AS drug_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr,
       UNNEST(mr.medication.codeableConcept.coding) AS med
  WHERE mr.status = 'active'
  GROUP BY subject.patientId
  HAVING drug_cnt >= 7
)
SELECT a.patient_id, b.drug_cnt
FROM   alive_dx AS a
JOIN   polypharm AS b
ON     a.patient_id = b.patient_id
ORDER BY b.drug_cnt DESC
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER – number of alive patients with diabetes or hypertension who have ≥7 active meds
WITH alive_dx AS (
  SELECT DISTINCT p.id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient`   AS p
  JOIN `bigquery-public-data.fhir_synthea.condition` AS c
    ON c.subject.patientId = p.id
  CROSS JOIN UNNEST(c.code.coding) AS cod
  WHERE p.deceased.dateTime IS NULL
    AND (LOWER(cod.display) LIKE '%diabetes%'
         OR LOWER(cod.display) LIKE '%hypertension%')
),
polypharm AS (
  SELECT subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr,
       UNNEST(mr.medication.codeableConcept.coding) AS med
  WHERE mr.status = 'active'
  GROUP BY subject.patientId
  HAVING COUNT(DISTINCT med.code) >= 7
)
SELECT COUNT(*) AS num_patients
FROM   alive_dx
JOIN   polypharm
USING  (patient_id);
```

Each query is capped with a clear purpose, gradually building understanding of the data until the last one returns the required count of qualifying individuals.
