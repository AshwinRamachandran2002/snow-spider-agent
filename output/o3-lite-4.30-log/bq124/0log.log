-- 9. For those patients, show drug count to verify the threshold
WITH alive_dx AS (
  SELECT DISTINCT p.id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient`   AS p
  JOIN `bigquery-public-data.fhir_synthea.condition` AS c
    ON c.subject.patientId = p.id
  CROSS JOIN UNNEST(c.code.coding) AS cod
  WHERE p.deceased.dateTime IS NULL
    AND (LOWER(cod.display) LIKE '%diabetes%'
         OR LOWER(cod.display) LIKE '%hypertension%')
),
polypharm AS (
  SELECT subject.patientId AS patient_id,
         COUNT(DISTINCT med.code) AS drug_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr,
       UNNEST(mr.medication.codeableConcept.coding) AS med
  WHERE mr.status = 'active'
  GROUP BY subject.patientId
  HAVING drug_cnt >= 7
)
SELECT a.patient_id, b.drug_cnt
FROM   alive_dx AS a
JOIN   polypharm AS b
ON     a.patient_id = b.patient_id
ORDER BY b.drug_cnt DESC
LIMIT 20;
