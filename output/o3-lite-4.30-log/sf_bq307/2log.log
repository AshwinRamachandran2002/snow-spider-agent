```sql
--Description / Thinking process:
-- Objective: Determine which gold badge most users receive first.
-- Steps:
-- 1) Work from STACKOVERFLOW.STACKOVERFLOW.BADGES.
-- 2) Keep only gold badges (class = 1).
-- 3) For every user, identify the earliest badge date (their FIRST gold badge)
--    using an analytic MIN(date) over each user_id and QUALIFY to keep only that row.
-- 4) Aggregate those “first” rows: GROUP BY badge name, COUNT users.
-- 5) Order by the count to see the most common first‑gold badges (LIMIT 20 for peek).

WITH first_gold AS (
    SELECT  b."user_id",
            b."name"
    FROM    "STACKOVERFLOW"."STACKOVERFLOW"."BADGES"  b
    WHERE   b."class" = 1                             -- keep only gold badges
    QUALIFY b."date" = MIN(b."date") OVER (PARTITION BY b."user_id")  -- first gold per user
)
SELECT  "name",
        COUNT(*)  AS "users_first_gold"
FROM    first_gold
GROUP BY "name"
ORDER BY "users_first_gold" DESC
LIMIT 20;
```
