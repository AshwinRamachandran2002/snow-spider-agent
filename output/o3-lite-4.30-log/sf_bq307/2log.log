```sql
--Description:  (#8)  Count users whose FIRST gold badge is a given badge name and
--              compute the average number of days between account creation and that badge.
WITH first_gold AS (                      -- isolate each user’s earliest gold badge
    SELECT  b."name",
            b."date",
            u."creation_date"
    FROM    "STACKOVERFLOW"."STACKOVERFLOW"."BADGES" b
    JOIN    "STACKOVERFLOW"."STACKOVERFLOW"."USERS"  u
            ON b."user_id" = u."id"
    WHERE   b."class" = 1
    QUALIFY b."date" = MIN(b."date") OVER (PARTITION BY b."user_id")
)
SELECT  "name",
        COUNT(*)                                                    AS "users_first_gold",
        AVG( ("date" - "creation_date") / 86400000000::FLOAT )      AS "avg_days_to_badge"
FROM    first_gold
GROUP BY "name"
ORDER BY "users_first_gold" DESC
LIMIT 20;
```

```sql
--Description:  (#9)  Same as #8, but show only those badges that at least
--              100 users earned as their FIRST gold badge.
WITH first_gold AS (
    SELECT  b."name",
            b."date",
            u."creation_date"
    FROM    "STACKOVERFLOW"."STACKOVERFLOW"."BADGES" b
    JOIN    "STACKOVERFLOW"."STACKOVERFLOW"."USERS"  u
            ON b."user_id" = u."id"
    WHERE   b."class" = 1
    QUALIFY b."date" = MIN(b."date") OVER (PARTITION BY b."user_id")
)
SELECT  "name",
        COUNT(*)                                                    AS "users_first_gold",
        AVG( ("date" - "creation_date") / 86400000000::FLOAT )      AS "avg_days_to_badge"
FROM    first_gold
GROUP BY "name"
HAVING  COUNT(*) >= 100
ORDER BY "users_first_gold" DESC
LIMIT 20;
```

```sql
--Description:  (#10 FINAL)  Return the top‑10 badge names that appear most often
--              as a user’s FIRST gold badge, along with the user count and the
--              average wait (days) from account creation to that badge.
WITH first_gold AS (
    SELECT  b."name",
            b."date",
            u."creation_date"
    FROM    "STACKOVERFLOW"."STACKOVERFLOW"."BADGES" b
    JOIN    "STACKOVERFLOW"."STACKOVERFLOW"."USERS"  u
            ON b."user_id" = u."id"
    WHERE   b."class" = 1
    QUALIFY b."date" = MIN(b."date") OVER (PARTITION BY b."user_id")
)
SELECT  "name"                                                  AS "badge_name",
        COUNT(*)                                                AS "users_first_gold",
        AVG( ("date" - "creation_date") / 86400000000::FLOAT )  AS "avg_days_to_badge"
FROM    first_gold
GROUP BY "name"
ORDER BY "users_first_gold" DESC
FETCH 10;
