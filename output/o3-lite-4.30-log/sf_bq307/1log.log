```sql
--Description: Corrected “final” query that retrieves the 10 gold badges most often earned
--             as a user’s first gold badge and the average days it took to obtain them.  
--             QUALIFY is used inside a CTE (after WHERE and before any GROUP BY), so
--             the clause order is valid in Snowflake.

WITH first_gold AS (          -- isolate each user’s earliest gold badge
    SELECT
        b."user_id",
        b."name"           AS "badge_name",
        b."date",
        u."creation_date"
    FROM "STACKOVERFLOW"."STACKOVERFLOW"."BADGES" b
    JOIN "STACKOVERFLOW"."STACKOVERFLOW"."USERS"  u
      ON u."id" = b."user_id"
    WHERE b."class" = 1                 -- gold badges only
    QUALIFY ROW_NUMBER() OVER (
              PARTITION BY b."user_id"
              ORDER BY b."date"
           ) = 1                        -- keep the first gold badge per user
)

SELECT
    fg."badge_name",
    COUNT(*) AS "users_first_badge",
    AVG( (fg."date" - fg."creation_date") / (86400 * 1000000.0) ) AS "avg_days_to_badge"
FROM first_gold fg
GROUP BY fg."badge_name"
ORDER BY "users_first_badge" DESC
LIMIT 10;
