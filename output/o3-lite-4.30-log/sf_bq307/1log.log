```sql
--Description (thinking process inline):
--Goal: Top 10 gold badges that most users receive as their FIRST gold badge,
--      plus average days from account creation to that badge.
--
--Approach:
--1. Start with BADGES restricted to gold (class = 1).
--2. Join USERS to access creation_date for elapsed‑time calculation.
--3. Use ROW_NUMBER() partitioned by user_id, ordered by badge date, to rank
--   a user’s gold badges chronologically.
--4. Keep only the row where rn = 1 (the earliest gold badge for that user).
--5. Aggregate this reduced set:
--      • COUNT(*)  → how many users share the same first gold badge.
--      • AVG(...)  → mean of (badge_date - creation_date) converted from
--                    microseconds to days (86400 * 1e6).
--6. Sort by COUNT descending and limit to 10.

WITH first_gold AS (
    SELECT
        b."name"           AS "badge_name",
        b."user_id",
        b."date",
        u."creation_date",
        ROW_NUMBER() OVER (
            PARTITION BY b."user_id"
            ORDER BY b."date"
        ) AS rn
    FROM "STACKOVERFLOW"."STACKOVERFLOW"."BADGES" b
    JOIN "STACKOVERFLOW"."STACKOVERFLOW"."USERS"  u
      ON u."id" = b."user_id"
    WHERE b."class" = 1  -- gold badges only
)
SELECT
    fg."badge_name",
    COUNT(*) AS "users_first_badge",
    AVG( (fg."date" - fg."creation_date") / (86400 * 1000000.0) ) AS "avg_days_to_badge"
FROM first_gold fg
WHERE fg.rn = 1           -- keep each user’s first gold badge
GROUP BY fg."badge_name"
ORDER BY "users_first_badge" DESC
LIMIT 10;
```
