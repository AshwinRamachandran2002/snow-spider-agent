Begin Exploring Related Columns
Relevant tables / columns and how they will be used 

BADGES  
• “id”: unique badge id – not strictly needed but useful for sanity‑checks  
• “name”: the badge that was granted – needed for grouping / final ranking  
• “class”: badge class (1 = gold, 2 = silver, 3 = bronze) – filter to gold (class = 1)  
• “user_id”: who earned the badge – used to decide each user’s first gold badge  
• “date”: when the badge was earned – used to find the first gold badge per user and to compute the elapsed days since account creation  

USERS  
• “id”: user id – join back to BADGES.user_id  
• “creation_date”: account creation time – needed for the date‑difference calculation  

Possible conditions that will appear in the queries 

• "class" = 1                    – restrict to gold badges only  
• "date" = (SELECT MIN(date)… ) – pick each user’s earliest gold badge  
• "user_id" IS NOT NULL      – ignore badges granted to the “community‑wiki” user (‑1)  
• calculation of (b."date" – u."creation_date") / 86400000000 to obtain “raw” days (both columns are micro‑seconds since epoch in this dataset; no further conversions requested)  

--------------------------------------------------------------------
Exploratory → step‑by‑step queries (each limited to 20 rows)

```sql
-- 1. Peek at a handful of rows from the BADGES table
SELECT "id", "name", "class", "user_id", "date"
FROM STACKOVERFLOW.STACKOVERFLOW.BADGES
LIMIT 20;
```

```sql
-- 2. Find out the distinct badge classes that exist
SELECT DISTINCT "class"
FROM STACKOVERFLOW.STACKOVERFLOW.BADGES
LIMIT 20;
```

```sql
-- 3. List distinct badge names that are gold (class = 1)
SELECT DISTINCT "name"
FROM STACKOVERFLOW.STACKOVERFLOW.BADGES
WHERE "class" = 1
LIMIT 20;
```

```sql
-- 4. For every gold badge earned, show the user and earning date
SELECT "user_id", "name", "date"
FROM STACKOVERFLOW.STACKOVERFLOW.BADGES
WHERE "class" = 1
AND   "user_id" IS NOT NULL
LIMIT 20;
```

```sql
-- 5. Compute each user’s very first gold badge (one row per user)
SELECT b1."user_id",
       b1."name"          AS "first_gold_badge",
       b1."date"          AS "first_gold_date"
FROM   STACKOVERFLOW.STACKOVERFLOW.BADGES b1
JOIN ( SELECT "user_id",
              MIN("date") AS "first_gold_date"
       FROM   STACKOVERFLOW.STACKOVERFLOW.BADGES
       WHERE  "class" = 1
       AND    "user_id" IS NOT NULL
       GROUP  BY "user_id"
     ) bmin
  ON  b1."user_id" = bmin."user_id"
  AND b1."date"    = bmin."first_gold_date"
LIMIT 20;
```

```sql
-- 6. Count how many users have each specific badge as their first gold
SELECT "first_gold_badge",
       COUNT(*) AS "users_who_got_it_first"
FROM (
        SELECT b1."user_id",
               b1."name" AS "first_gold_badge"
        FROM   STACKOVERFLOW.STACKOVERFLOW.BADGES b1
        JOIN  ( SELECT "user_id", MIN("date") AS "first_gold_date"
                FROM STACKOVERFLOW.STACKOVERFLOW.BADGES
                WHERE "class" = 1 AND "user_id" IS NOT NULL
                GROUP BY "user_id"
              ) bmin
          ON b1."user_id" = bmin."user_id"
         AND b1."date"    = bmin."first_gold_date"
     )
GROUP  BY "first_gold_badge"
ORDER  BY "users_who_got_it_first" DESC
LIMIT 20;
```

```sql
-- 7. Join users to calculate days from sign‑up to first gold badge (sample)
SELECT u."id"                     AS "user_id",
       b."name"                   AS "first_gold_badge",
       (b."date" - u."creation_date") / 86400000000 AS "days_to_gold"
FROM   (
        SELECT b1."user_id",
               b1."name",
               b1."date"
        FROM   STACKOVERFLOW.STACKOVERFLOW.BADGES b1
        JOIN  ( SELECT "user_id", MIN("date") AS "first_gold_date"
                FROM STACKOVERFLOW.STACKOVERFLOW.BADGES
                WHERE "class" = 1 AND "user_id" IS NOT NULL
                GROUP BY "user_id"
              ) bmin
          ON b1."user_id" = bmin."user_id"
         AND b1."date"    = bmin."first_gold_date"
      ) b
JOIN   STACKOVERFLOW.STACKOVERFLOW.USERS u
  ON   b."user_id" = u."id"
LIMIT 20;
```

```sql
-- 8. Average days from sign‑up to first gold badge for each badge
SELECT b."name" AS "badge_name",
       AVG( (b."date" - u."creation_date") / 86400000000 ) AS "avg_days_to_first_gold"
FROM   (
        SELECT b1."user_id",
               b1."name",
               b1."date"
        FROM   STACKOVERFLOW.STACKOVERFLOW.BADGES b1
        JOIN  ( SELECT "user_id", MIN("date") AS "first_gold_date"
                FROM STACKOVERFLOW.STACKOVERFLOW.BADGES
                WHERE "class" = 1 AND "user_id" IS NOT NULL
                GROUP BY "user_id"
              ) bmin
          ON b1."user_id" = bmin."user_id"
         AND b1."date"    = bmin."first_gold_date"
      ) b
JOIN   STACKOVERFLOW.STACKOVERFLOW.USERS u
  ON   b."user_id" = u."id"
GROUP BY b."name"
ORDER  BY "avg_days_to_first_gold"
LIMIT 20;
```

```sql
-- 9. Combine counts and average days, order by popularity
SELECT res."badge_name",
       res."users_who_got_it_first",
       res."avg_days_to_first_gold"
FROM (
       SELECT b."name" AS "badge_name",
              COUNT(*) AS "users_who_got_it_first",
              AVG( (b."date" - u."creation_date") / 86400000000 ) AS "avg_days_to_first_gold"
       FROM  (
               SELECT b1."user_id",
                      b1."name",
                      b1."date"
               FROM   STACKOVERFLOW.STACKOVERFLOW.BADGES b1
               JOIN  ( SELECT "user_id",
                              MIN("date") AS "first_gold_date"
                       FROM   STACKOVERFLOW.STACKOVERFLOW.BADGES
                       WHERE  "class" = 1
                       AND    "user_id" IS NOT NULL
                       GROUP BY "user_id"
                     ) bmin
                 ON b1."user_id" = bmin."user_id"
                AND b1."date"    = bmin."first_gold_date"
             ) b
       JOIN  STACKOVERFLOW.STACKOVERFLOW.USERS u
         ON b."user_id" = u."id"
       GROUP BY b."name"
     ) res
ORDER BY res."users_who_got_it_first" DESC
LIMIT 20;
```

```sql
-- 10. FINAL QUERY: Top‑10 gold badges most commonly earned as first gold,
--     including count of such users and their average days from sign‑up
SELECT res."badge_name",
       res."users_who_got_it_first",
       res."avg_days_to_first_gold"
FROM (
       SELECT b."name" AS "badge_name",
              COUNT(*)                                                  AS "users_who_got_it_first",
              AVG( (b."date" - u."creation_date") / 86400000000 )      AS "avg_days_to_first_gold"
       FROM  (
               SELECT b1."user_id",
                      b1."name",
                      b1."date"
               FROM   STACKOVERFLOW.STACKOVERFLOW.BADGES b1
               JOIN  ( SELECT "user_id",
                              MIN("date") AS "first_gold_date"
                       FROM   STACKOVERFLOW.STACKOVERFLOW.BADGES
                       WHERE  "class" = 1
                       AND    "user_id" IS NOT NULL
                       GROUP BY "user_id"
                     ) bmin
                 ON b1."user_id" = bmin."user_id"
                AND b1."date"    = bmin."first_gold_date"
             ) b
       JOIN  STACKOVERFLOW.STACKOVERFLOW.USERS u
         ON  b."user_id" = u."id"
       GROUP BY b."name"
     ) res
ORDER BY res."users_who_got_it_first" DESC
LIMIT 10;
```

