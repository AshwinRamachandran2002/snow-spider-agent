Begin Exploring Related Columns
Relevant tables & columns for the task  

• cities.insert_date : stores the date when the city row was inserted.  
  – Usage : filter the rows that fall in April, May, or June 2021‑2023 and to derive the month & year portions.  
  – Typical conditions :  
    • WHERE insert_date BETWEEN '2021-04-01' AND '2023-06-30'  
    • WHERE strftime('%m', insert_date) IN ('04','05','06')  

• cities.city_id : a unique identifier for each city row (used only for COUNT(*))  

Those two columns are all that are necessary; everything else in the database is unrelated to “when a city was inserted”.

Below are 10 exploratory SQL queries (simple → complex).  
Each query is preceded by a brief comment and capped at 20 rows with DISTINCT where helpful.

```sql
-- 1. Peek at some raw insert_date values to confirm the format (YYYY‑MM‑DD)
SELECT "insert_date"
FROM "cities"
LIMIT 20;
```

```sql
-- 2. List the distinct years present in insert_date (useful to verify 2021‑2023 exist)
SELECT DISTINCT substr("insert_date",1,4) AS "year"
FROM "cities"
ORDER BY "year"
LIMIT 20;
```

```sql
-- 3. List distinct months (01–12) observed in the table
SELECT DISTINCT strftime('%m',"insert_date") AS "month"
FROM "cities"
ORDER BY "month"
LIMIT 20;
```

```sql
-- 4. Show distinct year‑month combinations limited to Apr, May, Jun of 2021‑2023
SELECT DISTINCT substr("insert_date",1,7) AS "year_month"
FROM "cities"
WHERE strftime('%m',"insert_date") IN ('04','05','06')
  AND substr("insert_date",1,4) BETWEEN '2021' AND '2023'
ORDER BY "year_month"
LIMIT 20;
```

```sql
-- 5. Count new cities per year and month for Apr‑Jun, all three years
SELECT substr("insert_date",1,4) AS "year",
       strftime('%m',"insert_date") AS "month",
       COUNT(*)                    AS "cities_added"
FROM   "cities"
WHERE  strftime('%m',"insert_date") IN ('04','05','06')
  AND  substr("insert_date",1,4) BETWEEN '2021' AND '2023'
GROUP  BY "year","month"
ORDER  BY "year","month"
LIMIT 20;
```

```sql
-- 6. Baseline: counts for the year 2021 only (needed for YoY calculations)
SELECT strftime('%m',"insert_date") AS "month",
       COUNT(*)                    AS "cities_added_2021"
FROM   "cities"
WHERE  strftime('%m',"insert_date") IN ('04','05','06')
  AND  substr("insert_date",1,4) = '2021'
GROUP  BY "month"
ORDER  BY "month"
LIMIT 20;
```

```sql
-- 7. Count new cities for 2022 with an optional join to 2021 data to see YoY change
WITH y21 AS (
  SELECT strftime('%m',"insert_date") AS "month", COUNT(*) AS cnt_2021
  FROM   "cities"
  WHERE  strftime('%m',"insert_date") IN ('04','05','06') AND substr("insert_date",1,4)='2021'
  GROUP  BY "month"
)
SELECT strftime('%m',c."insert_date")        AS "month",
       COUNT(*)                              AS "cities_added_2022",
       y21.cnt_2021
FROM   "cities" AS c
LEFT JOIN y21 ON y21."month" = strftime('%m',c."insert_date")
WHERE  strftime('%m',c."insert_date") IN ('04','05','06')
  AND  substr(c."insert_date",1,4)='2022'
GROUP  BY "month"
ORDER  BY "month"
LIMIT 20;
```

```sql
-- 8. Running cumulative total for each month across the three years (Apr, May, Jun)
SELECT substr("insert_date",1,4)                     AS "year",
       strftime('%m',"insert_date")                  AS "month",
       COUNT(*)                                      AS "monthly_total",
       SUM(COUNT(*)) OVER (PARTITION BY strftime('%m',"insert_date")
                          ORDER BY substr("insert_date",1,4)
                          ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
                                                      AS "running_total"
FROM   "cities"
WHERE  strftime('%m',"insert_date") IN ('04','05','06')
  AND  substr("insert_date",1,4) BETWEEN '2021' AND '2023'
GROUP  BY "year","month"
ORDER  BY "year","month"
LIMIT 20;
```

```sql
-- 9. Same as #8 but adding year‑over‑year % growth for the monthly totals
WITH month_stats AS (
  SELECT substr("insert_date",1,4)          AS "year",
         strftime('%m',"insert_date")       AS "month",
         COUNT(*)                           AS "monthly_total"
  FROM   "cities"
  WHERE  strftime('%m',"insert_date") IN ('04','05','06')
    AND  substr("insert_date",1,4) BETWEEN '2021' AND '2023'
  GROUP  BY "year","month"
)
SELECT "year","month","monthly_total",
       LAG("monthly_total") OVER (PARTITION BY "month" ORDER BY "year") AS "prev_year_total",
       ROUND(
         100.0 * ("monthly_total" - LAG("monthly_total") OVER (PARTITION BY "month" ORDER BY "year"))
         / NULLIF(LAG("monthly_total") OVER (PARTITION BY "month" ORDER BY "year"),0), 2
       ) AS "pct_change_month"
FROM   month_stats
ORDER  BY "year","month"
LIMIT 20;
```

```sql
-- 10. Final all‑in‑one query: 2022‑2023 only, returning the requested columns
WITH base AS (
  SELECT substr("insert_date",1,4)          AS "year",
         strftime('%m',"insert_date")       AS "month",
         COUNT(*)                           AS "monthly_total"
  FROM   "cities"
  WHERE  strftime('%m',"insert_date") IN ('04','05','06')
    AND  substr("insert_date",1,4) BETWEEN '2021' AND '2023'
  GROUP  BY "year","month"
),
running AS (
  SELECT b.*,
         SUM("monthly_total") OVER (PARTITION BY "month"
                                    ORDER BY "year"
                                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_total",
         LAG("monthly_total")   OVER (PARTITION BY "month" ORDER BY "year")             AS "prev_month_total",
         LAG("running_total")   OVER (PARTITION BY "month" ORDER BY "year")             AS "prev_running_total"
  FROM   base AS b
)
SELECT "year",
       CASE "month"
            WHEN '04' THEN 'April'
            WHEN '05' THEN 'May'
            WHEN '06' THEN 'June'
       END                                           AS "month",
       "monthly_total"                               AS "cities_added",
       "running_total",
       ROUND(100.0 * ("monthly_total" - "prev_month_total") / NULLIF("prev_month_total",0),2)
                                                     AS "pct_growth_month",
       ROUND(100.0 * ("running_total" - "prev_running_total") / NULLIF("prev_running_total",0),2)
                                                     AS "pct_growth_running"
FROM   running
WHERE  "year" IN ('2022','2023')
ORDER  BY "year","month"
LIMIT 20;
```

These queries proceed from simple inspection of the raw dates to the full computation of monthly counts, cumulative totals, and year‑over‑year growth rates required for April, May, and June.
