-- 10. Final result for 2022 & 2023: monthly total, running total, YoY %
WITH stats AS (
   SELECT year,
          month_num,
          cities_added,
          SUM(cities_added) OVER (PARTITION BY month_num ORDER BY year) AS running_total
   FROM (
         SELECT substr("insert_date",1,4) AS year,
                substr("insert_date",6,2) AS month_num,
                COUNT(*)                  AS cities_added
         FROM "cities"
         WHERE substr("insert_date",1,4) BETWEEN '2021' AND '2023'
           AND substr("insert_date",6,2) IN ('04','05','06')
         GROUP BY year,month_num
   )
), final AS (
   SELECT *,
          100.0 * (cities_added - LAG(cities_added) OVER (PARTITION BY month_num ORDER BY year))
                 / LAG(cities_added) OVER (PARTITION BY month_num ORDER BY year) AS yoy_month_pct,
          100.0 * (running_total - LAG(running_total) OVER (PARTITION BY month_num ORDER BY year))
                 / LAG(running_total) OVER (PARTITION BY month_num ORDER BY year) AS yoy_run_pct
   FROM stats
)
SELECT year,
       CASE month_num
            WHEN '04' THEN 'April'
            WHEN '05' THEN 'May'
            WHEN '06' THEN 'June'
       END                     AS month,
       cities_added            AS monthly_total,
       running_total,
       yoy_month_pct,
       yoy_run_pct
FROM final
WHERE year IN ('2022','2023')
ORDER BY month_num, year
LIMIT 20;
