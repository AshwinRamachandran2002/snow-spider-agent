-- 9. Compute YoY % growth for the running cumulative total
WITH base AS (
   SELECT year,
          month_num,
          cities_added,
          SUM(cities_added) OVER (PARTITION BY month_num ORDER BY year) AS running_total
   FROM (
         SELECT substr("insert_date",1,4) AS year,
                substr("insert_date",6,2) AS month_num,
                COUNT(*)                  AS cities_added
         FROM "cities"
         WHERE substr("insert_date",1,4) BETWEEN '2021' AND '2023'
           AND substr("insert_date",6,2) IN ('04','05','06')
         GROUP BY year,month_num
   )
)
SELECT year,
       month_num,
       running_total,
       100.0 * (running_total - LAG(running_total) OVER (PARTITION BY month_num ORDER BY year))
              / LAG(running_total) OVER (PARTITION BY month_num ORDER BY year) AS yoy_run_pct
FROM base
ORDER BY month_num,year
LIMIT 20;
