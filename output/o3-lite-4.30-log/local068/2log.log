Relevant tables / columns and how they will be used  

cities."insert_date": identify the day a city was added; filter by years 2021‑2023 and by months April (04), May (05), June (06).  
cities."city_id": primary key – useful for COUNTing how many cities were added.  
cities."city_name": inspect sample values / data quality if needed.  
Possible WHERE‑clauses  
• strftime('%Y', insert_date) BETWEEN '2021' AND '2023' – keep the three years of interest.  
• strftime('%m', insert_date) IN ('04','05','06') – keep April, May, June.  
• strftime('%Y', insert_date)= '2022' (or '2023') – when building YoY calculations.  

Below are ten exploratory SQL queries – from simple inspection to the cumulative / YoY calculations that solve the assignment.  
(Every query is a plain SELECT, uses DISTINCT wherever practical, and is limited to 20 rows.)

```sql
-- 1. Show distinct years present in cities.insert_date (sanity‑check the date range)
SELECT DISTINCT substr("insert_date",1,4) AS year
FROM "cities"
LIMIT 20;
```

```sql
-- 2. Show distinct months (as numbers) present in 2021‑2023
SELECT DISTINCT substr("insert_date",6,2) AS month_num
FROM "cities"
WHERE substr("insert_date",1,4) BETWEEN '2021' AND '2023'
LIMIT 20;
```

```sql
-- 3. Sample of cities added in April 2021 (first 20 rows)
SELECT "city_id","city_name","insert_date"
FROM "cities"
WHERE substr("insert_date",1,4)='2021'
  AND substr("insert_date",6,2)='04'
LIMIT 20;
```

```sql
-- 4. Sample of cities added in May 2022 (first 20 rows)
SELECT "city_id","city_name","insert_date"
FROM "cities"
WHERE substr("insert_date",1,4)='2022'
  AND substr("insert_date",6,2)='05'
LIMIT 20;
```

```sql
-- 5. Sample of cities added in June 2023 (first 20 rows)
SELECT "city_id","city_name","insert_date"
FROM "cities"
WHERE substr("insert_date",1,4)='2023'
  AND substr("insert_date",6,2)='06'
LIMIT 20;
```

```sql
-- 6. Count of new cities per year & month (April‑June, 2021‑2023)
SELECT substr("insert_date",1,4) AS year,
       substr("insert_date",6,2) AS month_num,
       COUNT(*)                   AS cities_added
FROM "cities"
WHERE substr("insert_date",1,4) BETWEEN '2021' AND '2023'
  AND substr("insert_date",6,2) IN ('04','05','06')
GROUP BY 1,2
ORDER BY 1,2
LIMIT 20;
```

```sql
-- 7. Add running cumulative total for each month across years
SELECT year,
       month_num,
       cities_added,
       SUM(cities_added) OVER (PARTITION BY month_num
                               ORDER BY year)      AS running_total
FROM (
      SELECT substr("insert_date",1,4) AS year,
             substr("insert_date",6,2) AS month_num,
             COUNT(*)                  AS cities_added
      FROM "cities"
      WHERE substr("insert_date",1,4) BETWEEN '2021' AND '2023'
        AND substr("insert_date",6,2) IN ('04','05','06')
      GROUP BY year,month_num
) t
ORDER BY month_num,year
LIMIT 20;
```

```sql
-- 8. Compute YoY % growth for the monthly total (needs window LAG)
SELECT year,
       month_num,
       cities_added,
       100.0 * (cities_added - LAG(cities_added) OVER (PARTITION BY month_num ORDER BY year))
              / LAG(cities_added) OVER (PARTITION BY month_num ORDER BY year) AS yoy_month_pct
FROM (
      SELECT substr("insert_date",1,4) AS year,
             substr("insert_date",6,2) AS month_num,
             COUNT(*)                  AS cities_added
      FROM "cities"
      WHERE substr("insert_date",1,4) BETWEEN '2021' AND '2023'
        AND substr("insert_date",6,2) IN ('04','05','06')
      GROUP BY year,month_num
) t
ORDER BY month_num,year
LIMIT 20;
```

```sql
-- 9. Compute YoY % growth for the running cumulative total
WITH base AS (
   SELECT year,
          month_num,
          cities_added,
          SUM(cities_added) OVER (PARTITION BY month_num ORDER BY year) AS running_total
   FROM (
         SELECT substr("insert_date",1,4) AS year,
                substr("insert_date",6,2) AS month_num,
                COUNT(*)                  AS cities_added
         FROM "cities"
         WHERE substr("insert_date",1,4) BETWEEN '2021' AND '2023'
           AND substr("insert_date",6,2) IN ('04','05','06')
         GROUP BY year,month_num
   )
)
SELECT year,
       month_num,
       running_total,
       100.0 * (running_total - LAG(running_total) OVER (PARTITION BY month_num ORDER BY year))
              / LAG(running_total) OVER (PARTITION BY month_num ORDER BY year) AS yoy_run_pct
FROM base
ORDER BY month_num,year
LIMIT 20;
```

```sql
-- 10. Final result for 2022 & 2023: monthly total, running total, YoY %
WITH stats AS (
   SELECT year,
          month_num,
          cities_added,
          SUM(cities_added) OVER (PARTITION BY month_num ORDER BY year) AS running_total
   FROM (
         SELECT substr("insert_date",1,4) AS year,
                substr("insert_date",6,2) AS month_num,
                COUNT(*)                  AS cities_added
         FROM "cities"
         WHERE substr("insert_date",1,4) BETWEEN '2021' AND '2023'
           AND substr("insert_date",6,2) IN ('04','05','06')
         GROUP BY year,month_num
   )
), final AS (
   SELECT *,
          100.0 * (cities_added - LAG(cities_added) OVER (PARTITION BY month_num ORDER BY year))
                 / LAG(cities_added) OVER (PARTITION BY month_num ORDER BY year) AS yoy_month_pct,
          100.0 * (running_total - LAG(running_total) OVER (PARTITION BY month_num ORDER BY year))
                 / LAG(running_total) OVER (PARTITION BY month_num ORDER BY year) AS yoy_run_pct
   FROM stats
)
SELECT year,
       CASE month_num
            WHEN '04' THEN 'April'
            WHEN '05' THEN 'May'
            WHEN '06' THEN 'June'
       END                     AS month,
       cities_added            AS monthly_total,
       running_total,
       yoy_month_pct,
       yoy_run_pct
FROM final
WHERE year IN ('2022','2023')
ORDER BY month_num, year
LIMIT 20;
```
