```sql
/*  Unique embedding‑medium / staining‑substance pairs (SM modality, SCT codes)   */
WITH ci AS (      /* every content‑item within specimen‑preparation steps          */
    SELECT
        sd.value:"SpecimenUID"::STRING                                         AS specimen_uid,
        ci.value                                                               AS content_item
    FROM  "IDC"."IDC_V17"."DICOM_METADATA" t
          ,LATERAL FLATTEN(input => t."SpecimenDescriptionSequence")                 sd
          ,LATERAL FLATTEN(input => sd.value:"SpecimenPreparationSequence")          sp
          ,LATERAL FLATTEN(input => sp.value:"SpecimenPreparationStepContentItemSequence") ci
    WHERE t."Modality" = 'SM'
),
codes AS (        /* classify each content‑item as EMBED or STAIN & keep SCT only */
    SELECT
        specimen_uid,
        CASE
            WHEN LOWER(content_item:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING)
                 LIKE '%embedding%'                        THEN 'EMBED'
            WHEN LOWER(content_item:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING)
                 LIKE '%stain%'                            THEN 'STAIN'
        END                                                               AS item_type,
        content_item:"ConceptCodeSequence"[0]:"CodeValue"::STRING         AS code,
        content_item:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING       AS meaning
    FROM ci
    WHERE content_item:"ConceptCodeSequence"[0]:"CodingSchemeDesignator"::STRING = 'SCT'
      AND (   LOWER(content_item:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING) LIKE '%embedding%'
           OR LOWER(content_item:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING) LIKE '%stain%')
      AND content_item:"ConceptCodeSequence"[0]:"CodeValue" IS NOT NULL
),
embedding AS (    /* distinct embedding media per specimen */
    SELECT DISTINCT specimen_uid,
           code    AS embedding_code,
           meaning AS embedding_meaning
    FROM codes
    WHERE item_type = 'EMBED'
),
staining  AS (    /* distinct staining substances per specimen */
    SELECT DISTINCT specimen_uid,
           code    AS staining_code,
           meaning AS staining_meaning
    FROM codes
    WHERE item_type = 'STAIN'
),
pair_list AS (    /* every embedding–staining combination observed in a specimen */
    SELECT
        e.embedding_code,
        e.embedding_meaning,
        s.staining_code,
        s.staining_meaning
    FROM embedding e
    JOIN staining  s
      ON e.specimen_uid = s.specimen_uid
)
SELECT
    embedding_meaning  AS embedding_medium_code_meaning,
    staining_meaning   AS staining_substance_code_meaning,
    COUNT(DISTINCT embedding_code || '|' || staining_code) AS occurrence_count
FROM pair_list
GROUP BY
    embedding_medium_code_meaning,
    staining_meaning
ORDER BY
    occurrence_count DESC NULLS LAST,
    embedding_medium_code_meaning,
    staining_meaning;
```
