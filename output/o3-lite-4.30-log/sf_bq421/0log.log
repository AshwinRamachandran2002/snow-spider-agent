--Description: Quickly survey specimen‑preparation content items for slide‑microscopy (SM) images.  
--             We flatten SpecimenDescriptionSequence ➜ SpecimenPreparationStepContentItemSequence  
--             and list distinct Concept‑name values (human‑readable step names) to discover how staining/embedding
--             steps are labeled in the dataset.
SELECT DISTINCT
       step.value:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING AS concept_name
FROM   "IDC"."IDC_V17"."DICOM_METADATA" t,
       LATERAL FLATTEN(input => t."SpecimenDescriptionSequence")                       sd,
       LATERAL FLATTEN(input => sd.value:"SpecimenPreparationStepContentItemSequence") step
WHERE  t."Modality" = 'SM'
LIMIT 20;
