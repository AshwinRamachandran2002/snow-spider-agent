```sql
--Description: For slide‑microscopy (SM) images, locate specimen‑preparation content items whose Concept‑name
--             contains “embed” (case‑insensitive).  These are likely the “Embedding Medium” entries.
--             Return the associated ConceptCodeSequence’s CodeMeaning and CodingSchemeDesignator so we can
--             verify available embedding‑medium codes and their coding scheme.
SELECT
    step.value:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING            AS embedding_code_meaning,
    step.value:"ConceptCodeSequence"[0]:"CodingSchemeDesignator"::STRING AS embedding_designator
FROM "IDC"."IDC_V17"."DICOM_METADATA" t,
     LATERAL FLATTEN(input => t."SpecimenDescriptionSequence")                       sd,
     LATERAL FLATTEN(input => sd.value:"SpecimenPreparationStepContentItemSequence") step
WHERE t."Modality" = 'SM'
  AND step.value:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING ILIKE '%embed%'
LIMIT 20;
```
