    SELECT  sp.value AS step
    FROM    base, LATERAL FLATTEN(input => prep_seq1) sp
    UNION ALL
    SELECT  sps.value AS step
    FROM    base, LATERAL FLATTEN(input => prep_seq2) sps
),
prep AS (       -- extract embedding & staining code items (SCT only)
