--Description: final report – list each unique (embedding medium, staining substance) pair
--             along with the number of SM images in which that pair occurs.  Both embedding
--             and staining substances are SCT‑coded and extracted via the CTEs above.
WITH emb AS (
    SELECT  t."SOPInstanceUID" AS "instance_uid",
            item.value:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING AS "embedding_medium"
    FROM    "IDC"."IDC_V17"."DICOM_METADATA" t
            ,LATERAL FLATTEN (input => t."SpecimenDescriptionSequence")                               desc_obj
            ,LATERAL FLATTEN (input => desc_obj.value:"SpecimenPreparationSequence",  outer => TRUE)  prep
            ,LATERAL FLATTEN (input => prep.value:"SpecimenPreparationStepContentItemSequence",
                              outer => TRUE)                                                          item
    WHERE   t."Modality" = 'SM'
      AND   item.value IS NOT NULL
      AND   item.value:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING ILIKE '%embedding%medium%'
      AND   item.value:"ConceptCodeSequence"[0]:"CodingSchemeDesignator"::STRING = 'SCT'
),
stain AS (
    SELECT  t."SOPInstanceUID" AS "instance_uid",
            item.value:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING AS "staining_substance"
    FROM    "IDC"."IDC_V17"."DICOM_METADATA" t
            ,LATERAL FLATTEN (input => t."SpecimenDescriptionSequence")                               desc_obj
            ,LATERAL FLATTEN (input => desc_obj.value:"SpecimenPreparationSequence",  outer => TRUE)  prep
            ,LATERAL FLATTEN (input => prep.value:"SpecimenPreparationStepContentItemSequence",
                              outer => TRUE)                                                          item
    WHERE   t."Modality" = 'SM'
      AND   item.value IS NOT NULL
      AND   item.value:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING ILIKE '%using%substance%'
      AND   item.value:"ConceptCodeSequence"[0]:"CodingSchemeDesignator"::STRING = 'SCT'
)
SELECT  emb."embedding_medium",
        stain."staining_substance",
        COUNT(DISTINCT emb."instance_uid") AS "occurrences"
FROM    emb
JOIN    stain
  ON    emb."instance_uid" = stain."instance_uid"
GROUP BY 1, 2
ORDER BY "occurrences" DESC
LIMIT 20
