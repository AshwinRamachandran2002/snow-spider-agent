    FROM    "IDC"."IDC_V17"."DICOM_METADATA" t
            ,LATERAL FLATTEN (input => t."SpecimenDescriptionSequence")                               desc_obj
            ,LATERAL FLATTEN (input => desc_obj.value:"SpecimenPreparationSequence",  outer => TRUE)  prep
            ,LATERAL FLATTEN (input => prep.value:"SpecimenPreparationStepContentItemSequence",
                              outer => TRUE)                                                          item
    WHERE   t."Modality" = 'SM'
      AND   item.value IS NOT NULL
      AND   item.value:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING ILIKE '%embedding%medium%'
      AND   item.value:"ConceptCodeSequence"[0]:"CodingSchemeDesignator"::STRING = 'SCT'
),
stain AS (
    SELECT  t."SOPInstanceUID" AS "instance_uid",
            item.value:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING AS "staining_substance"
    FROM    "IDC"."IDC_V17"."DICOM_METADATA" t
            ,LATERAL FLATTEN (input => t."SpecimenDescriptionSequence")                               desc_obj
            ,LATERAL FLATTEN (input => desc_obj.value:"SpecimenPreparationSequence",  outer => TRUE)  prep
