WITH embedding AS (
    SELECT DISTINCT
        d."SOPInstanceUID",
        ci.value:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING
            AS "embedding_medium_code_meaning"
    FROM "IDC"."IDC_V17"."DICOM_METADATA" d,
         LATERAL FLATTEN(input => d."SpecimenDescriptionSequence")                     sd,
         LATERAL FLATTEN(input => sd.value:"SpecimenPreparationSequence")              sp,
         LATERAL FLATTEN(input => sp.value:"SpecimenPreparationStepContentItemSequence") ci
    WHERE d."Modality" = 'SM'
      AND ci.value:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING ILIKE '%embedding%'
      AND ci.value:"ConceptCodeSequence"[0]:"CodingSchemeDesignator"::STRING = 'SCT'
), 
staining AS (
    SELECT DISTINCT
        d."SOPInstanceUID",
        ci.value:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING
            AS "staining_substance_code_meaning"
    FROM "IDC"."IDC_V17"."DICOM_METADATA" d,
         LATERAL FLATTEN(input => d."SpecimenDescriptionSequence")                     sd,
         LATERAL FLATTEN(input => sd.value:"SpecimenPreparationSequence")              sp,
         LATERAL FLATTEN(input => sp.value:"SpecimenPreparationStepContentItemSequence") ci
    WHERE d."Modality" = 'SM'
      AND ci.value:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING ILIKE '%stain%'
      AND ci.value:"ConceptCodeSequence"[0]:"CodingSchemeDesignator"::STRING = 'SCT'
)

SELECT
    e."embedding_medium_code_meaning",
    s."staining_substance_code_meaning",
    COUNT(*) AS "occurrence_count"
FROM embedding e
JOIN staining s
  ON e."SOPInstanceUID" = s."SOPInstanceUID"
GROUP BY
    e."embedding_medium_code_meaning",
    s."staining_substance_code_meaning"
ORDER BY
    "occurrence_count" DESC NULLS LAST,
    e."embedding_medium_code_meaning",
    s."staining_substance_code_meaning";
