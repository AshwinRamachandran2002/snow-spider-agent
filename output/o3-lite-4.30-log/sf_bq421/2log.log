Begin Exploring Related Columns
Relevant columns and their potential usage  
• "Modality" (TEXT) – filter rows to microscopy slides (value = ‘SM’).  
• "SpecimenDescriptionSequence" (VARIANT) – JSON/VARIANT column that holds, for every specimen, the nested Specimen‑Preparation structures from which the embedding‑medium and staining‑substance information can be extracted.  
Conditions that will be used  
• "Modality" = ‘SM’  
• JSON path filters that keep only items whose "ConceptCodeSequence"[0]."CodingSchemeDesignator" = ‘SCT’ (SNOMED CT).  
• Look‑ups on the Concept‑Name code meaning (ILIKE ‘%embedding%’ or ILIKE ‘%stain%’) to recognise the preparation‑step type.  

Ten exploratory‑to‑final Snowflake SQL queries  
```sql
-- 1) Description: quick look at the different modality values present.
SELECT DISTINCT "Modality"
FROM "IDC"."IDC_V17"."DICOM_METADATA"
LIMIT 20;
```

```sql
-- 2) Description: sample of SM rows with the raw SpecimenDescriptionSequence.
SELECT "SOPInstanceUID",
       "SpecimenDescriptionSequence"
FROM "IDC"."IDC_V17"."DICOM_METADATA"
WHERE "Modality" = 'SM'
  AND "SpecimenDescriptionSequence" IS NOT NULL
LIMIT 20;
```

```sql
-- 3) Description: explode (flatten) the first‑level items of SpecimenDescriptionSequence.
SELECT d."SOPInstanceUID",
       f.value AS "Specimen_Item"
FROM "IDC"."IDC_V17"."DICOM_METADATA" d,
     LATERAL FLATTEN(input => d."SpecimenDescriptionSequence") f
WHERE d."Modality" = 'SM'
LIMIT 20;
```

```sql
-- 4) Description: for every specimen item show the embedded SpecimenPreparationSequence JSON.
SELECT d."SOPInstanceUID",
       s.value:"SpecimenPreparationSequence" AS "SpecimenPreparationSequence"
FROM "IDC"."IDC_V17"."DICOM_METADATA" d,
     LATERAL FLATTEN(input => d."SpecimenDescriptionSequence") s
WHERE d."Modality" = 'SM'
LIMIT 20;
```

```sql
-- 5) Description: flatten the individual preparation steps.
SELECT d."SOPInstanceUID",
       prep_step.value AS "Preparation_Step"
FROM "IDC"."IDC_V17"."DICOM_METADATA" d,
     LATERAL FLATTEN(input => d."SpecimenDescriptionSequence") sd,
     LATERAL FLATTEN(input => sd.value:"SpecimenPreparationSequence") prep_step
WHERE d."Modality" = 'SM'
LIMIT 20;
```

```sql
-- 6) Description: inspect Concept‑Name (step type) and Concept‑Code (material) for each step.
SELECT prep_step.value:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING  AS "Step_Type",
       prep_step.value:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING     AS "Material_Meaning",
       prep_step.value:"ConceptCodeSequence"[0]:"CodingSchemeDesignator"::STRING AS "Scheme"
FROM "IDC"."IDC_V17"."DICOM_METADATA" d,
     LATERAL FLATTEN(input => d."SpecimenDescriptionSequence") sd,
     LATERAL FLATTEN(input => sd.value:"SpecimenPreparationSequence") prep_step
WHERE d."Modality" = 'SM'
LIMIT 20;
```

```sql
-- 7) Description: keep only SCT‑coded preparation steps (any type).
SELECT prep_step.value:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING  AS "Step_Type",
       prep_step.value:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING     AS "Material_Meaning"
FROM "IDC"."IDC_V17"."DICOM_METADATA" d,
     LATERAL FLATTEN(input => d."SpecimenDescriptionSequence") sd,
     LATERAL FLATTEN(input => sd.value:"SpecimenPreparationSequence") prep_step
WHERE d."Modality" = 'SM'
  AND prep_step.value:"ConceptCodeSequence"[0]:"CodingSchemeDesignator"::STRING = 'SCT'
LIMIT 20;
```

```sql
-- 8) Description: show distinct embedding‑medium meanings (SCT only).
SELECT DISTINCT
       prep_step.value:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING AS "Embedding_Medium"
FROM "IDC"."IDC_V17"."DICOM_METADATA" d,
     LATERAL FLATTEN(input => d."SpecimenDescriptionSequence") sd,
     LATERAL FLATTEN(input => sd.value:"SpecimenPreparationSequence") prep_step
WHERE d."Modality" = 'SM'
  AND prep_step.value:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING ILIKE '%embedding%'
  AND prep_step.value:"ConceptCodeSequence"[0]:"CodingSchemeDesignator"::STRING = 'SCT'
LIMIT 20;
```

```sql
-- 9) Description: per SOPInstance, capture both the embedding‑medium and staining‑substance meanings.
SELECT
       d."SOPInstanceUID",
       MAX(CASE
             WHEN prep_step.value:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING ILIKE '%embedding%'
             THEN prep_step.value:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING
           END) AS "Embedding_Medium",
       MAX(CASE
             WHEN prep_step.value:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING ILIKE '%stain%'
             THEN prep_step.value:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING
           END) AS "Staining_Substance"
FROM "IDC"."IDC_V17"."DICOM_METADATA" d,
     LATERAL FLATTEN(input => d."SpecimenDescriptionSequence") sd,
     LATERAL FLATTEN(input => sd.value:"SpecimenPreparationSequence") prep_step
WHERE d."Modality" = 'SM'
  AND prep_step.value:"ConceptCodeSequence"[0]:"CodingSchemeDesignator"::STRING = 'SCT'
GROUP BY d."SOPInstanceUID"
LIMIT 20;
```

```sql
-- 10) Description: final result – unique pairs of embedding medium & staining substance
--               (both SCT coded) with their number of occurrences.
SELECT
       pair."Embedding_Medium",
       pair."Staining_Substance",
       COUNT(*) AS "Occurrences"
FROM (
        SELECT
               MAX(CASE
                     WHEN prep_step.value:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING ILIKE '%embedding%'
                     THEN prep_step.value:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING
                   END) AS "Embedding_Medium",
               MAX(CASE
                     WHEN prep_step.value:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING ILIKE '%stain%'
                     THEN prep_step.value:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING
                   END) AS "Staining_Substance"
        FROM "IDC"."IDC_V17"."DICOM_METADATA" d,
             LATERAL FLATTEN(input => d."SpecimenDescriptionSequence") sd,
             LATERAL FLATTEN(input => sd.value:"SpecimenPreparationSequence") prep_step
        WHERE d."Modality" = 'SM'
          AND prep_step.value:"ConceptCodeSequence"[0]:"CodingSchemeDesignator"::STRING = 'SCT'
        GROUP BY d."SOPInstanceUID"
     ) pair
WHERE pair."Embedding_Medium" IS NOT NULL
  AND pair."Staining_Substance" IS NOT NULL
GROUP BY pair."Embedding_Medium", pair."Staining_Substance"
ORDER BY "Occurrences" DESC
LIMIT 20;
```
