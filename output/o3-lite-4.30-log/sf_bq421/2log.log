--Description: Final result – unique pairs of embedding medium & staining substance (both SCT‑coded)
--             with the number of SM instances that contain each pair; corrected to use the deeper flatten.
WITH per_instance AS (
    SELECT
           d."SOPInstanceUID",
           MAX(CASE
                 WHEN ci.value:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING ILIKE '%embedding%'
                 THEN ci.value:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING
               END) AS embedding_medium,
           MAX(CASE
                 WHEN ci.value:"ConceptNameCodeSequence"[0]:"CodeMeaning"::STRING ILIKE '%stain%'
                 THEN ci.value:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING
               END) AS staining_substance
    FROM "IDC"."IDC_V17"."DICOM_METADATA" d
         , LATERAL FLATTEN(input => d."SpecimenDescriptionSequence")                     sd
         , LATERAL FLATTEN(input => sd.value:"SpecimenPreparationSequence")              sp
         , LATERAL FLATTEN(input => sp.value:"SpecimenPreparationStepContentItemSequence") ci
    WHERE d."Modality" = 'SM'
      AND ci.value:"ConceptCodeSequence"[0]:"CodingSchemeDesignator"::STRING = 'SCT'
    GROUP BY d."SOPInstanceUID"
)
SELECT
       embedding_medium   AS "Embedding_Medium",
       staining_substance AS "Staining_Substance",
       COUNT(*)           AS "Occurrences"
FROM per_instance
WHERE embedding_medium IS NOT NULL
  AND staining_substance IS NOT NULL
GROUP BY embedding_medium, staining_substance
ORDER BY "Occurrences" DESC
LIMIT 20
