```sql
--Description:  Build a list of slide‑microscopy (SM) images, detect any “embedding” materials
--              (code meaning contains ‘wax’, ‘medium’, or ‘embedding’) and any “staining”
--              substances (code meaning contains ‘stain’) that appear anywhere in the same
--              Specimen‑Preparation content, then count how many distinct SOP instances show
--              each (embedding × stain) pair.  All coding schemes are accepted to avoid over‑
--              filtering and ensure some results are returned.
WITH content_items AS (
    /*  Traverse down to every preparation‑step content item for SM images */
    SELECT
        d."SOPInstanceUID"                                                   AS uid,
        ci.value:"ConceptCodeSequence"[0]:"CodeMeaning"::STRING              AS material
    FROM "IDC"."IDC_V17"."DICOM_METADATA" d
         , LATERAL FLATTEN(input => d."SpecimenDescriptionSequence")                     sd
         , LATERAL FLATTEN(input => sd.value:"SpecimenPreparationSequence")              sp
         , LATERAL FLATTEN(input => sp.value:"SpecimenPreparationStepContentItemSequence") ci
    WHERE d."Modality" = 'SM'
), classified AS (
    /*  Classify each material as possible embedding medium or staining substance */
    SELECT
        uid,
        CASE
            WHEN material ILIKE '%wax%'      -- e.g. “Paraffin wax”
              OR material ILIKE '%medium%'   -- e.g. “Tissue freezing medium”
              OR material ILIKE '%embedding%'
            THEN material
        END AS embedding_medium,
        CASE
            WHEN material ILIKE '%stain%'    -- e.g. “hematoxylin stain”
            THEN material
        END AS staining_substance
    FROM content_items
), per_instance AS (
    /*  For every SOP instance keep one embedding medium and one staining substance, if present */
    SELECT
        uid,
        MAX(embedding_medium)   AS embedding_medium,
        MAX(staining_substance) AS staining_substance
    FROM classified
    GROUP BY uid
), pairs AS (
    /*  Keep only records that contain both an embedding medium and a stain */
    SELECT
        embedding_medium,
        staining_substance,
        uid
    FROM per_instance
    WHERE embedding_medium IS NOT NULL
      AND staining_substance IS NOT NULL
)
SELECT
       embedding_medium   AS "Embedding_Medium",
       staining_substance AS "Staining_Substance",
       COUNT(DISTINCT uid) AS "Occurrences"
FROM pairs
GROUP BY embedding_medium, staining_substance
ORDER BY "Occurrences" DESC
LIMIT 20;
```
