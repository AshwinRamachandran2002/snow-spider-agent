--Description:  Identify the bus‑route network that has the largest number of bus‑stop
--              point features inside Denmark.  Logic:
--              1.  CTE denmark      – retrieve Denmark’s multipolygon (relation with wikidata = Q35).
--              2.  CTE dk_busstops  – keep every point feature whose tags include either
--                 “highway = bus_stop” OR “public_transport = platform” and whose geometry
--                 lies inside the Denmark polygon.
--              3.  CTE stop_networks – flatten each bus stop’s tag array again and keep only
--                 the objects where key = 'network'; each row now carries <stop_id, network_name>.
--              4.  Final SELECT      – count distinct stop_ids per network, order descending,
--                 and return the single network with the largest count (LIMIT 1).
WITH denmark AS (
    SELECT TO_GEOGRAPHY(r."geometry") AS geo
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
         LATERAL FLATTEN(input => r."all_tags") tag
    WHERE tag.value:"key" = 'wikidata'
      AND tag.value:"value" = 'Q35'
    LIMIT 1
),
dk_busstops AS (
    SELECT DISTINCT p."osm_id", p."all_tags", p."geometry"
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" p,
         LATERAL FLATTEN(input => p."all_tags") bt,
         denmark d
    WHERE ((bt.value:"key" = 'highway'          AND bt.value:"value" = 'bus_stop')
        OR (bt.value:"key" = 'public_transport' AND bt.value:"value" = 'platform'))
      AND p."geometry" IS NOT NULL
      AND ST_CONTAINS(d.geo, TO_GEOGRAPHY(p."geometry"))
),
stop_networks AS (
    SELECT
        b."osm_id"                   AS stop_id,
        nt.value:"value"::STRING     AS network_name
    FROM dk_busstops b,
         LATERAL FLATTEN(input => b."all_tags") nt
    WHERE nt.value:"key" = 'network'
      AND nt.value:"value" IS NOT NULL
)
SELECT
    network_name,
    COUNT(DISTINCT stop_id) AS num_stops_in_denmark
FROM stop_networks
GROUP BY network_name
ORDER BY num_stops_in_denmark DESC
LIMIT 1;
```
