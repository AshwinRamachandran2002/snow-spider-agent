--Description: Return the bus‑route network that has the largest number of distinct member
--             nodes whose coordinates lie inside Denmark (Wikidata Q35).  
--             • No role or member‑type filter is applied; every member id that exists in
--               PLANET_NODES is tested.  
--             • Conditional aggregation (HAVING) replaces any correlated sub‑queries.
--             • ST_MAKEPOINT + ST_CONTAINS tests whether a node’s lon/lat is inside Denmark.
WITH denmark AS (      ------------------------------------------------ Denmark multipolygon
    SELECT TO_GEOGRAPHY(r."geometry") AS geo
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
         LATERAL FLATTEN(input => r."all_tags") t
    WHERE t.value:"key"  = 'wikidata'
      AND t.value:"value" = 'Q35'
    LIMIT 1
),                     ------------------------------------------------ all route=bus relations with a network tag
route_with_network AS (
    SELECT
        r."id" AS route_id,
        MAX(CASE WHEN f.value:"key" = 'network'
                 THEN f.value:"value" END) AS network_name
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
         LATERAL FLATTEN(input => r."all_tags") f
    GROUP BY r."id"
    HAVING MAX(CASE WHEN f.value:"key" = 'route'   AND f.value:"value" = 'bus' THEN 1 ELSE 0 END) = 1
       AND MAX(CASE WHEN f.value:"key" = 'network'                          THEN 1 ELSE 0 END) = 1
),                     ------------------------------------------------ explode members and keep those that exist in PLANET_NODES
route_node_ids AS (
    SELECT
        rw.network_name,
        m.value:"ref"::NUMBER AS node_id
    FROM route_with_network rw
    JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r
      ON r."id" = rw.route_id,
         LATERAL FLATTEN(input => r."members") m
),                     ------------------------------------------------ attach coordinates & filter to Denmark
nodes_in_denmark AS (
