Relevant columns and their potential usage

• PLANET_RELATIONS."id":                primary key of every relation (country borders, bus routes, etc.)  
• PLANET_RELATIONS."all_tags":          JSON array that stores tags such as "wikidata = Q35", "route = bus", "network", "type = route" …  
• PLANET_RELATIONS."geometry":          GEOMETRY / BINARY that can be cast to GEOGRAPHY for spatial tests (country border of Denmark, route‑geometries, …)  
• PLANET_RELATIONS."members":           JSON array that lists the member objects (nodes / ways / relations).  Stop‑nodes appear here with their ids.  

• PLANET_FEATURES_POINTS."osm_id":      node id – can be compared with relation member ids to know which nodes are stops of a route / network.  
• PLANET_FEATURES_POINTS."all_tags":    JSON array that contains “highway = bus_stop”, “public_transport = platform”, “bus = yes” … → identifies bus stops.  
• PLANET_FEATURES_POINTS."geometry":    GEOMETRY / BINARY of every point – used to test if it lies inside Denmark.  

Conditions that may be useful

1. Denmark border  
   LATERAL FLATTEN on PLANET_RELATIONS."all_tags"  
      WHERE f.value:"key"  = 'wikidata'  
        AND f.value:"value" = 'Q35'  

2. Bus‑stop points  
   LATERAL FLATTEN on PLANET_FEATURES_POINTS."all_tags"  
      WHERE (f.value:"key"  = 'highway'         AND f.value:"value" = 'bus_stop')  
         OR (f.value:"key"  = 'public_transport' AND f.value:"value" = 'platform')  

3. Bus routes with declared network  
   LATERAL FLATTEN on PLANET_RELATIONS."all_tags"  
      WHERE f.value:"key" IN ('route','type','network')  
        AND f.value:"value" ILIKE 'bus'               -- route = bus  
        AND EXISTS (SELECT 1 FROM TABLE(flatten(input => PLANET_RELATIONS."all_tags")) g
                    WHERE g.value:"key" = 'network')  -- network tag is present

10 Exploratory Snowflake SQL queries
(each returns at most 20 rows; all identifiers are wrapped in double quotes)

```sql
-- 1. Description: find the relation(s) that represent Denmark by its Wikidata tag Q35.
SELECT r."id", r."geometry"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
     LATERAL FLATTEN(input => r."all_tags") f
WHERE f.value:"key"  = 'wikidata'
  AND f.value:"value" = 'Q35'
LIMIT 20;
```

```sql
-- 2. Description: view the full tag set of the Denmark relation.
SELECT r."id",
       f.value AS "denmark_tag_object"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
     LATERAL FLATTEN(input => r."all_tags") f
WHERE r."id" IN (
      SELECT sub."id"
      FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" sub,
           LATERAL FLATTEN(input => sub."all_tags") sf
      WHERE sf.value:"key"  = 'wikidata'
        AND sf.value:"value" = 'Q35')
LIMIT 20;
```

```sql
-- 3. Description: list a sample of point features that are tagged as bus stops anywhere in the world.
SELECT p."osm_id",
       p."all_tags",
       p."geometry"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" p,
     LATERAL FLATTEN(input => p."all_tags") f
WHERE (f.value:"key" = 'highway'         AND f.value:"value" = 'bus_stop')
   OR (f.value:"key" = 'public_transport' AND f.value:"value" = 'platform')
LIMIT 20;
```

```sql
-- 4. Description: find bus‑stop points that lie inside the Denmark multipolygon.
WITH denmark AS (
  SELECT TO_GEOGRAPHY(r."geometry") AS "geo"
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
       LATERAL FLATTEN(input => r."all_tags") f
  WHERE f.value:"key" = 'wikidata'
    AND f.value:"value" = 'Q35'
  LIMIT 1
)
SELECT p."osm_id",
       p."geometry"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" p,
     LATERAL FLATTEN(input => p."all_tags") f,
     denmark d
WHERE (f.value:"key" = 'highway' AND f.value:"value" = 'bus_stop')
  AND ST_CONTAINS(d."geo", TO_GEOGRAPHY(p."geometry"))
LIMIT 20;
```

```sql
-- 5. Description: list relations that are bus routes having a 'network' tag (worldwide sample).
SELECT DISTINCT r."id",
       MAX(CASE WHEN f.value:"key" = 'network' THEN f.value:"value" END) AS "network_name"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
     LATERAL FLATTEN(input => r."all_tags") f
WHERE EXISTS (
       SELECT 1
       FROM TABLE(FLATTEN(input => r."all_tags")) g
       WHERE g.value:"key" = 'route' AND g.value:"value" = 'bus')
  AND EXISTS (
       SELECT 1
       FROM TABLE(FLATTEN(input => r."all_tags")) h
       WHERE h.value:"key" = 'network')
GROUP BY r."id"
LIMIT 20;
```

```sql
-- 6. Description: restrict those bus‑route relations to ones whose geometry intersects Denmark.
WITH denmark AS (
  SELECT TO_GEOGRAPHY(r."geometry") AS "geo"
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
       LATERAL FLATTEN(input => r."all_tags") f
  WHERE f.value:"key" = 'wikidata'
    AND f.value:"value" = 'Q35'
  LIMIT 1
)
SELECT r."id",
       MAX(CASE WHEN f.value:"key" = 'network' THEN f.value:"value" END) AS "network_name"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
     LATERAL FLATTEN(input => r."all_tags") f,
     denmark d
WHERE EXISTS (
       SELECT 1
       FROM TABLE(FLATTEN(input => r."all_tags")) g
       WHERE g.value:"key" = 'route' AND g.value:"value" = 'bus')
  AND EXISTS (
       SELECT 1
       FROM TABLE(FLATTEN(input => r."all_tags")) h
       WHERE h.value:"key" = 'network')
  AND ST_INTERSECTS(TO_GEOGRAPHY(r."geometry"), d."geo")
GROUP BY r."id"
LIMIT 20;
```

```sql
-- 7. Description: explode the member list of one sample bus‑route relation to see its stop node ids.
SELECT r."id"  AS "route_id",
       m.value:"ref"::NUMBER AS "member_osm_id",
       m.value:"role"::STRING AS "member_role",
       m.value:"type"::STRING AS "member_type"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
     LATERAL FLATTEN(input => r."members") m
WHERE r."id" = (SELECT MIN("id") FROM
                 (SELECT r2."id"
                  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r2,
                       LATERAL FLATTEN(input => r2."all_tags") f2
                  WHERE f2.value:"key" = 'route'
                    AND f2.value:"value" = 'bus'
                  LIMIT 1))
LIMIT 20;
```

```sql
-- 8. Description: join route‑member stop nodes to point features to get stop geometries + tags.
WITH sample_route AS (
  SELECT r."id"
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
       LATERAL FLATTEN(input => r."all_tags") f
  WHERE f.value:"key" = 'route'
    AND f.value:"value" = 'bus'
  LIMIT 1
)
SELECT n."member_osm_id" AS "stop_node_id",
       p."all_tags"
FROM sample_route sr
JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r
  ON r."id" = sr."id",
     LATERAL FLATTEN(input => r."members") n
JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" p
  ON p."osm_id" = n.value:"ref"::NUMBER
WHERE n.value:"role"::STRING ILIKE '%stop%'
LIMIT 20;
```

```sql
-- 9. Description: count how many bus stops each network has inside Denmark.
WITH denmark AS (
  SELECT TO_GEOGRAPHY(r."geometry") AS "geo"
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
       LATERAL FLATTEN(input => r."all_tags") f
  WHERE f.value:"key" = 'wikidata'
    AND f.value:"value" = 'Q35'
  LIMIT 1
),
route_with_network AS (
  SELECT r."id" AS "route_id",
         MAX(CASE WHEN f.value:"key" = 'network'
                  THEN f.value:"value" END) AS "network_name"
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
       LATERAL FLATTEN(input => r."all_tags") f
  WHERE EXISTS (
      SELECT 1
      FROM TABLE(FLATTEN(input => r."all_tags")) rt
      WHERE rt.value:"key" = 'route' AND rt.value:"value" = 'bus')
    AND EXISTS (
      SELECT 1
      FROM TABLE(FLATTEN(input => r."all_tags")) nt
      WHERE nt.value:"key" = 'network')
  GROUP BY r."id"
),
route_stop_nodes AS (
  SELECT rw."network_name",
         m.value:"ref"::NUMBER AS "stop_node_id"
  FROM route_with_network rw
  JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r
    ON r."id" = rw."route_id",
       LATERAL FLATTEN(input => r."members") m
  WHERE m.value:"role"::STRING ILIKE '%stop%'
),
denmark_busstops AS (
  SELECT DISTINCT rsn."network_name",
         rsn."stop_node_id"
  FROM route_stop_nodes rsn
  JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" p
    ON p."osm_id" = rsn."stop_node_id",
       denmark d
  WHERE ST_CONTAINS(d."geo", TO_GEOGRAPHY(p."geometry"))
)
SELECT "network_name",
       COUNT(DISTINCT "stop_node_id") AS "num_stops_in_denmark"
FROM denmark_busstops
GROUP BY "network_name"
ORDER BY "num_stops_in_denmark" DESC
LIMIT 20;
```

```sql
-- 10. Description: return the number of stops for the single bus network that has the most stops inside Denmark.
WITH denmark AS (
  SELECT TO_GEOGRAPHY(r."geometry") AS "geo"
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
       LATERAL FLATTEN(input => r."all_tags") f
  WHERE f.value:"key" = 'wikidata'
    AND f.value:"value" = 'Q35'
  LIMIT 1
),
route_with_network AS (
  SELECT r."id" AS "route_id",
         MAX(CASE WHEN f.value:"key" = 'network'
                  THEN f.value:"value" END) AS "network_name"
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
       LATERAL FLATTEN(input => r."all_tags") f
  WHERE EXISTS (
      SELECT 1
      FROM TABLE(FLATTEN(input => r."all_tags")) rt
      WHERE rt.value:"key" = 'route' AND rt.value:"value" = 'bus')
    AND EXISTS (
      SELECT 1
      FROM TABLE(FLATTEN(input => r."all_tags")) nt
      WHERE nt.value:"key" = 'network')
  GROUP BY r."id"
),
route_stop_nodes AS (
  SELECT rw."network_name",
         m.value:"ref"::NUMBER AS "stop_node_id"
  FROM route_with_network rw
  JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r
    ON r."id" = rw."route_id",
       LATERAL FLATTEN(input => r."members") m
  WHERE m.value:"role"::STRING ILIKE '%stop%'
),
denmark_busstops AS (
  SELECT DISTINCT rsn."network_name",
         rsn."stop_node_id"
  FROM route_stop_nodes rsn
  JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" p
    ON p."osm_id" = rsn."stop_node_id",
       denmark d
  WHERE ST_CONTAINS(d."geo", TO_GEOGRAPHY(p."geometry"))
)
SELECT "network_name",
       COUNT(DISTINCT "stop_node_id") AS "num_stops_in_denmark"
FROM denmark_busstops
GROUP BY "network_name"
ORDER BY "num_stops_in_denmark" DESC
LIMIT 1;
```

