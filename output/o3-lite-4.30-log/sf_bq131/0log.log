WITH denmark AS (
    /* Denmark multipolygon (Wikidata Q35) */
    SELECT TO_GEOGRAPHY(r."geometry") AS "geo"
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
         LATERAL FLATTEN(input => r."all_tags") f
    WHERE f.value:"key"  = 'wikidata'
      AND f.value:"value" = 'Q35'
    LIMIT 1
),
route_with_network AS (
    /* Bus route relations that have a network tag */
    SELECT r."id" AS "route_id",
           MAX(CASE WHEN f.value:"key" = 'network'
                    THEN f.value:"value" END) AS "network_name"
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
         LATERAL FLATTEN(input => r."all_tags") f
    GROUP BY r."id"
    HAVING MAX(CASE WHEN f.value:"key" = 'route'
                     AND f.value:"value" = 'bus' THEN 1 ELSE 0 END) = 1
       AND MAX(CASE WHEN f.value:"key" = 'network' THEN 1 ELSE 0 END)     = 1
),
route_stop_nodes AS (
    /* Extract node‑members that represent stops/platforms */
    SELECT rw."network_name",
           m.value:"ref"::NUMBER AS "stop_node_id"
    FROM route_with_network rw
    JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r
      ON r."id" = rw."route_id",
         LATERAL FLATTEN(input => r."members") m
    WHERE (m.value:"role"::STRING ILIKE '%stop%'      -- stop, stop_entry_only …
        OR m.value:"role"::STRING ILIKE '%platform%') -- platform / stop_position
      AND m.value:"type"::STRING = 'node'
),
stop_geometries AS (
    /* Obtain a GEOGRAPHY for each stop node (from features_points or nodes table) */
    SELECT rsn."network_name",
           rsn."stop_node_id",
           COALESCE(
               TO_GEOGRAPHY(pfp."geometry"),
               CASE
                   WHEN pn."latitude" IS NOT NULL AND pn."longitude" IS NOT NULL
                   THEN ST_MAKEPOINT(pn."longitude"::FLOAT, pn."latitude"::FLOAT)
               END
           ) AS "geo"
    FROM route_stop_nodes rsn
    LEFT JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pfp
           ON pfp."osm_id" = rsn."stop_node_id"
    LEFT JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_NODES" pn
           ON pn."id" = rsn."stop_node_id"
),
denmark_busstops AS (
    /* Keep only stops whose geometry is inside Denmark */
    SELECT DISTINCT sg."network_name",
           sg."stop_node_id"
    FROM stop_geometries sg,
         denmark d
    WHERE sg."geo" IS NOT NULL
      AND ST_CONTAINS(d."geo", sg."geo")
),
network_counts AS (
    /* Count stops per network and take the network with the most stops */
    SELECT "network_name",
           COUNT(DISTINCT "stop_node_id") AS "cnt"
    FROM denmark_busstops
    GROUP BY "network_name"
    ORDER BY "cnt" DESC NULLS LAST
    LIMIT 1
)
SELECT "cnt" AS bus_stop_count
FROM network_counts;
