```sql
--Description: Count bus stops inside Denmark for every bus‑route network, avoiding any correlated sub‑queries.
--             Steps
--             1. denmark            : fetch Denmark’s border as a GEOGRAPHY object (wikidata = Q35).
--             2. route_with_network : select every relation that is tagged route = bus AND has a network tag,
--                                     using conditional aggregation in HAVING (no EXISTS).
--             3. route_stop_nodes   : explode each qualified route’s “members” array and keep node members
--                                     whose role text contains ‘stop’ (ILIKE).  Capture the stop node id +
--                                     its parent network name.
--             4. denmark_busstops   : join those node ids to PLANET_FEATURES_POINTS to get geometries and
--                                     keep only points that lie within Denmark.
--             5. Final SELECT       : count distinct stop nodes per network, order by the count, show top 20.
WITH denmark AS (
    SELECT TO_GEOGRAPHY(r."geometry") AS "geo"
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
         LATERAL FLATTEN(input => r."all_tags") t
    WHERE t.value:"key" = 'wikidata'
      AND t.value:"value" = 'Q35'
    LIMIT 1
),
route_with_network AS (
    SELECT
           r."id" AS "route_id",
           MAX(CASE WHEN f.value:"key" = 'network' THEN f.value:"value" END) AS "network_name"
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
         LATERAL FLATTEN(input => r."all_tags") f
    GROUP BY r."id"
    HAVING MAX(CASE WHEN f.value:"key" = 'route' AND f.value:"value" = 'bus' THEN 1 ELSE 0 END) = 1
       AND MAX(CASE WHEN f.value:"key" = 'network'                          THEN 1 ELSE 0 END) = 1
),
route_stop_nodes AS (
    SELECT
           rw."network_name",
           m.value:"ref"::NUMBER AS "stop_node_id"
    FROM route_with_network rw
    JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r
      ON r."id" = rw."route_id",
         LATERAL FLATTEN(input => r."members") m
    WHERE m.value:"type"::STRING = 'node'
      AND m.value:"role"::STRING ILIKE '%stop%'
),
denmark_busstops AS (
    SELECT DISTINCT
           rsn."network_name",
           rsn."stop_node_id"
    FROM route_stop_nodes rsn
    JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" p
      ON p."osm_id" = rsn."stop_node_id",
         denmark d
    WHERE ST_CONTAINS(d."geo", TO_GEOGRAPHY(p."geometry"))
)
SELECT
       "network_name",
       COUNT(DISTINCT "stop_node_id") AS "num_stops_in_denmark"
FROM denmark_busstops
GROUP BY "network_name"
ORDER BY "num_stops_in_denmark" DESC
LIMIT 20;
```
