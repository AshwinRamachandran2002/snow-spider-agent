```sql
--Description: We need relations that (a) are bus routes (route=bus) and (b) contain a “network” tag.  
--             Correlated sub‑queries inside WHERE caused an error, so we switch to conditional 
--             aggregation inside HAVING:  
--               • FLATTEN turns each tag into one row (alias f).  
--               • GROUP BY relation id.  
--               • MAX(CASE …) in HAVING tests if at least one tag meets the condition.  
--               • The same MAX(CASE …) in SELECT shows which network is recorded.  
--             The query returns 20 sample relations worldwide that satisfy both conditions.
SELECT
       r."id",
       MAX(CASE WHEN f.value:"key" = 'network' THEN f.value:"value" END) AS "network_name"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
     LATERAL FLATTEN(input => r."all_tags") f
GROUP BY r."id"
HAVING MAX(CASE WHEN f.value:"key" = 'route' AND f.value:"value" = 'bus' THEN 1 ELSE 0 END) = 1
   AND MAX(CASE WHEN f.value:"key" = 'network'                          THEN 1 ELSE 0 END) = 1
LIMIT 20;
```
