2025-05-01 01:16:47 - Thread-263 (execute) - INFO - [Exploration]
Relevant columns and their potential usage
• GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_RELATIONS  
  – "geometry": holds the multipolygon geometry of administrative boundaries (Denmark).  
  – "all_tags": JSON array – we can search for {"key":"wikidata","value":"Q35"} to isolate Denmark.  
  – "id": OSM relation id – handy when joining / verifying.  

• GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS  
  – "geometry": point geometry for every mapped POI.  
  – "all_tags": JSON array – contains {"key":"highway","value":"bus_stop"} together with an optional {"key":"network","value": …}.  
  – "osm_id": node id – unique identifier.  

Typical conditions  
• In PLANET_RELATIONS:  
      WHERE f.value:"key" = 'wikidata' AND f.value:"value" = 'Q35'  
• In PLANET_FEATURES_POINTS (bus stop nodes):  
      WHERE g.value:"key" = 'highway' AND g.value:"value" = 'bus_stop'  
• Spatial containment (point inside Denmark multipolygon):  
      ST_CONTAINS( ST_GEOGFROMWKB(den."geometry"), ST_GEOGFROMWKB(pt."geometry") )  

Ten exploratory → final Snowflake SQL queries  
(Always enclose names with double quotes, use LIMIT 20 to sample.)  

```sql
--Description: 1. Inspect Denmark’s relation by Wikidata‑ID = Q35
SELECT r."id",
       r."all_tags",
       ST_ASWKT( ST_GEOGFROMWKB(r."geometry") ) AS "wkt_preview"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
     LATERAL FLATTEN( input => r."all_tags" ) f
WHERE f.value:"key" = 'wikidata'
  AND f.value:"value" = 'Q35'
LIMIT 20;
```

```sql
--Description: 2. Verify the boundary has boundary=administrative + admin_level = 2
SELECT r."id", r."all_tags"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
     LATERAL FLATTEN( input => r."all_tags" ) f
WHERE r."id" IN ( -- Denmark id(s) found above
      SELECT DISTINCT r2."id"
      FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r2,
           LATERAL FLATTEN( input => r2."all_tags" ) f2
      WHERE f2.value:"key" = 'wikidata' AND f2.value:"value" = 'Q35' )
  AND f.value:"key" IN ('boundary', 'admin_level')
LIMIT 20;
```

```sql
--Description: 3. Look at one row of bus stops (highway = bus_stop) anywhere
SELECT pt."osm_id",
       pt."all_tags"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
     LATERAL FLATTEN( input => pt."all_tags" ) g
WHERE g.value:"key" = 'highway'
  AND g.value:"value" ILIKE '%bus_stop%'
LIMIT 20;
```

```sql
--Description: 4. Check distinct network strings recorded at bus stops
SELECT DISTINCT g_net.value:"value" AS "network"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
     LATERAL FLATTEN( input => pt."all_tags" ) g_hw,
     LATERAL FLATTEN( input => pt."all_tags" ) g_net
WHERE g_hw.value:"key" = 'highway'
  AND g_hw.value:"value" = 'bus_stop'
  AND g_net.value:"key" = 'network'
LIMIT 20;
```

```sql
--Description: 5. Bring Denmark’s geometry into a CTE for later spatial filter
WITH den AS (
  SELECT ST_GEOGFROMWKB("geometry") AS "den_geom"
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
       LATERAL FLATTEN( input => r."all_tags" ) f
  WHERE f.value:"key" = 'wikidata'
    AND f.value:"value" = 'Q35'
  LIMIT 1
)
SELECT *
FROM den;
```

```sql
--Description: 6. Sample first 20 bus stops that fall inside Denmark boundary
WITH den AS (
  SELECT ST_GEOGFROMWKB("geometry") AS "den_geom"
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
       LATERAL FLATTEN( input => r."all_tags" ) f
  WHERE f.value:"key" = 'wikidata' AND f.value:"value" = 'Q35'
  LIMIT 1
)
SELECT pt."osm_id",
       pt."all_tags"
FROM den,
     "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
     LATERAL FLATTEN( input => pt."all_tags" ) g
WHERE g.value:"key" = 'highway'
  AND g.value:"value" = 'bus_stop'
  AND ST_CONTAINS( den."den_geom", ST_GEOGFROMWKB(pt."geometry") )
LIMIT 20;
```

```sql
--Description: 7. Count how many bus stops have a defined network tag inside Denmark
WITH den AS (
  SELECT ST_GEOGFROMWKB("geometry") AS "den_geom"
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
       LATERAL FLATTEN( input => r."all_tags" ) f
  WHERE f.value:"key" = 'wikidata' AND f.value:"value" = 'Q35'
  LIMIT 1
)
SELECT COUNT(*) AS "stops_with_network"
FROM den,
     "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
     LATERAL FLATTEN( input => pt."all_tags" ) g_hw,
     LATERAL FLATTEN( input => pt."all_tags" ) g_net
WHERE g_hw.value:"key" = 'highway'
  AND g_hw.value:"value" = 'bus_stop'
  AND g_net.value:"key" = 'network'
  AND ST_CONTAINS( den."den_geom", ST_GEOGFROMWKB(pt."geometry") )
LIMIT 20;
```

```sql
--Description: 8. Produce a list of bus networks and number of stops in Denmark (ordered)
WITH den AS (
  SELECT ST_GEOGFROMWKB("geometry") AS "den_geom"
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
       LATERAL FLATTEN( input => r."all_tags" ) f
  WHERE f.value:"key" = 'wikidata' AND f.value:"value" = 'Q35'
  LIMIT 1
)
SELECT g_net.value:"value" AS "network",
       COUNT(*)        AS "stop_count"
FROM den,
     "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
     LATERAL FLATTEN( input => pt."all_tags" ) g_hw,
     LATERAL FLATTEN( input => pt."all_tags" ) g_net
WHERE g_hw.value:"key" = 'highway'
  AND g_hw.value:"value" = 'bus_stop'
  AND g_net.value:"key" = 'network'
  AND ST_CONTAINS( den."den_geom", ST_GEOGFROMWKB(pt."geometry") )
GROUP BY g_net.value:"value"
ORDER BY "stop_count" DESC
LIMIT 20;
```

```sql
--Description: 9. Return the single bus network that has the most stops in Denmark
WITH den AS (
  SELECT ST_GEOGFROMWKB("geometry") AS "den_geom"
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
       LATERAL FLATTEN( input => r."all_tags" ) f
  WHERE f.value:"key" = 'wikidata' AND f.value:"value" = 'Q35'
  LIMIT 1
),
network_counts AS (
  SELECT g_net.value:"value" AS "network",
         COUNT(*)           AS "stop_count"
  FROM den,
       "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
       LATERAL FLATTEN( input => pt."all_tags" ) g_hw,
       LATERAL FLATTEN( input => pt."all_tags" ) g_net
  WHERE g_hw.value:"key" = 'highway'
    AND g_hw.value:"value" = 'bus_stop'
    AND g_net.value:"key" = 'network'
    AND ST_CONTAINS( den."den_geom", ST_GEOGFROMWKB(pt."geometry") )
  GROUP BY g_net.value:"value"
)
SELECT "network", "stop_count"
FROM network_counts
ORDER BY "stop_count" DESC
LIMIT 20;
```

```sql
--Description: 10. (Final answer query)  –  Number of bus stops for the bus network with the most stops inside Denmark
WITH den AS (
  SELECT ST_GEOGFROMWKB("geometry") AS "den_geom"
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
       LATERAL FLATTEN( input => r."all_tags" ) f
  WHERE f.value:"key" = 'wikidata' AND f.value:"value" = 'Q35'
  LIMIT 1
),
network_counts AS (
  SELECT g_net.value:"value" AS "network",
         COUNT(*)           AS "stop_count"
  FROM den,
       "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
       LATERAL FLATTEN( input => pt."all_tags" ) g_hw,
       LATERAL FLATTEN( input => pt."all_tags" ) g_net
  WHERE g_hw.value:"key" = 'highway'
    AND g_hw.value:"value" = 'bus_stop'
    AND g_net.value:"key" = 'network'
    AND ST_CONTAINS( den."den_geom", ST_GEOGFROMWKB(pt."geometry") )
  GROUP BY g_net.value:"value"
)
SELECT MAX("stop_count") AS "max_bus_stop_count_in_Denmark"
FROM network_counts
LIMIT 20;
```
