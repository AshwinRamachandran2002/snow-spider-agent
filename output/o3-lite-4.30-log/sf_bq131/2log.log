Begin Exploring Related Columns
Relevant columns and potential usage  
• GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES  
  – "geometry": holds the Multipolygon geometry that can be converted to GEOGRAPHY; used for the Denmark border.  
  – "all_tags": JSON array that includes `"key":"wikidata","value":"Q35"` for Denmark; we will flatten this to find the polygon.  
  – "feature_type": lets us keep only true multipolygons (national borders normally live here).  

• GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS  
  – "geometry": point geometry for every mapped POI, convertible to GEOGRAPHY; used for bus‑stop points.  
  – "all_tags": JSON array that contains `"key":"highway","value":"bus_stop"` and usually also `"key":"network"` (or `"operator"`) that identifies the bus network; we will flatten this twice (first to pick only bus stops, second to pull out the network tag).  
  – "osm_id", "osm_timestamp", "osm_version": not needed for the final count but handy for checking.  

Conditions that will be used  
1. Flatten "all_tags" and keep only tags where tag.value:"key" ILIKE '%wikidata%' AND tag.value:"value"='Q35' to obtain Denmark’s polygon.  
2. Flatten "all_tags" and keep only tags where tag.value:"key" ILIKE '%highway%' AND tag.value:"value"='bus_stop' to obtain bus stops.  
3. Optional second FLATTEN on the same "all_tags" result set to extract tag.value:"value" for key ILIKE '%network%'.  
4. Spatial filter: ST_CONTAINS(TO_GEOGRAPHY(<Denmark Multipolygon>), TO_GEOGRAPHY(<Bus‑Stop Point>)) = TRUE.  

Ten step‑by‑step Snowflake SQL queries (each limited to 20 rows)  
```sql
-- 1. Peek at any multipolygons that carry a Wikidata tag (quick scan)
SELECT pf."feature_type",
       f.value:"key"::STRING  AS tag_key,
       f.value:"value"::STRING AS tag_value,
       pf."geometry"
FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
       LATERAL FLATTEN(input => pf."all_tags") f
WHERE  pf."feature_type" = 'multipolygons'
LIMIT 20;

-- 2. Find the Denmark border by its Wikidata = Q35 tag
SELECT pf."geometry",
       pf."all_tags"
FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
       LATERAL FLATTEN(input => pf."all_tags") f
WHERE  f.value:"key"::STRING ILIKE '%wikidata%'
  AND  f.value:"value"::STRING = 'Q35'
LIMIT 20;

-- 3. List a few bus‑stop points (tag highway = bus_stop) inside the entire dataset
SELECT p."osm_id",
       p."all_tags",
       p."geometry"
FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" p,
       LATERAL FLATTEN(input => p."all_tags") f
WHERE  f.value:"key"::STRING ILIKE '%highway%'
  AND  f.value:"value"::STRING = 'bus_stop'
LIMIT 20;

-- 4. Extract distinct 'network' tag values that appear on bus stops (worldwide)
SELECT DISTINCT
       net.value:"value"::STRING AS bus_network
FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" p,
       LATERAL FLATTEN(input => p."all_tags") hw,
       LATERAL FLATTEN(input => p."all_tags") net
WHERE  hw.value:"key"::STRING ILIKE '%highway%'
  AND  hw.value:"value"::STRING = 'bus_stop'
  AND  net.value:"key"::STRING ILIKE '%network%'
LIMIT 20;

-- 5. Count how many bus stops each network has in the whole world (rough check)
SELECT
       net.value:"value"::STRING AS bus_network,
       COUNT(*) AS stop_cnt
FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" p,
       LATERAL FLATTEN(input => p."all_tags") hw,
       LATERAL FLATTEN(input => p."all_tags") net
WHERE  hw.value:"key"::STRING ILIKE '%highway%'
  AND  hw.value:"value"::STRING = 'bus_stop'
  AND  net.value:"key"::STRING ILIKE '%network%'
GROUP  BY bus_network
ORDER  BY stop_cnt DESC
LIMIT 20;

-- 6. Materialize Denmark’s multipolygon in a CTE and view its bbox length (A sanity geometry view)
WITH dk AS (
   SELECT TO_GEOGRAPHY(pf."geometry") AS geog
   FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
          LATERAL FLATTEN(input => pf."all_tags") f
   WHERE  f.value:"key"::STRING ILIKE '%wikidata%'
     AND  f.value:"value"::STRING = 'Q35'
   LIMIT 1
)
SELECT ST_AREA(geog)/1000000 AS area_km2
FROM   dk
LIMIT 20;

-- 7. Pull 20 bus‑stop points that fall INSIDE the Denmark border
WITH dk AS (
   SELECT TO_GEOGRAPHY(pf."geometry") AS dk_geog
   FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
          LATERAL FLATTEN(input => pf."all_tags") f
   WHERE  f.value:"key"::STRING ILIKE '%wikidata%'
     AND  f.value:"value"::STRING = 'Q35'
   LIMIT 1
)
SELECT p."osm_id",
       p."all_tags"
FROM   dk, "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" p,
       LATERAL FLATTEN(input => p."all_tags") hw
WHERE  hw.value:"key"::STRING ILIKE '%highway%'
  AND  hw.value:"value"::STRING = 'bus_stop'
  AND  ST_CONTAINS(dk.dk_geog, TO_GEOGRAPHY(p."geometry"))
LIMIT 20;

-- 8. Get network tag together with each Danish bus‑stop point
WITH dk AS (
   SELECT TO_GEOGRAPHY(pf."geometry") AS dk_geog
   FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
          LATERAL FLATTEN(input => pf."all_tags") f
   WHERE  f.value:"key"::STRING ILIKE '%wikidata%'
     AND  f.value:"value"::STRING = 'Q35'
   LIMIT 1
)
SELECT
       net.value:"value"::STRING AS bus_network,
       p."osm_id",
       p."all_tags"
FROM   dk,
       "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" p,
       LATERAL FLATTEN(input => p."all_tags") hw,
       LATERAL FLATTEN(input => p."all_tags") net
WHERE  hw.value:"key"::STRING ILIKE '%highway%'
  AND  hw.value:"value"::STRING = 'bus_stop'
  AND  net.value:"key"::STRING ILIKE '%network%'
  AND  ST_CONTAINS(dk.dk_geog, TO_GEOGRAPHY(p."geometry"))
LIMIT 20;

-- 9. Count Danish bus stops per network and show the top 20
WITH dk AS (
   SELECT TO_GEOGRAPHY(pf."geometry") AS dk_geog
   FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
          LATERAL FLATTEN(input => pf."all_tags") f
   WHERE  f.value:"key"::STRING ILIKE '%wikidata%'
     AND  f.value:"value"::STRING = 'Q35'
   LIMIT 1
)
SELECT
       net.value:"value"::STRING AS bus_network,
       COUNT(*)                    AS stop_cnt
FROM   dk,
       "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" p,
       LATERAL FLATTEN(input => p."all_tags") hw,
       LATERAL FLATTEN(input => p."all_tags") net
WHERE  hw.value:"key"::STRING ILIKE '%highway%'
  AND  hw.value:"value"::STRING = 'bus_stop'
  AND  net.value:"key"::STRING ILIKE '%network%'
  AND  ST_CONTAINS(dk.dk_geog, TO_GEOGRAPHY(p."geometry"))
GROUP  BY bus_network
ORDER  BY stop_cnt DESC
LIMIT 20;

-- 10. Final query: return the number of bus stops for the SINGLE network that has the most stops in Denmark
WITH dk AS (
   SELECT TO_GEOGRAPHY(pf."geometry") AS dk_geog
   FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
          LATERAL FLATTEN(input => pf."all_tags") f
   WHERE  f.value:"key"::STRING ILIKE '%wikidata%'
     AND  f.value:"value"::STRING = 'Q35'
   LIMIT 1
),
bus_points AS (
   SELECT
          p."osm_id",
          TO_GEOGRAPHY(p."geometry")          AS pt_geog,
          net.value:"value"::STRING           AS bus_network
   FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" p,
          LATERAL FLATTEN(input => p."all_tags") hw,
          LATERAL FLATTEN(input => p."all_tags") net
   WHERE  hw.value:"key"::STRING ILIKE '%highway%'
     AND  hw.value:"value"::STRING = 'bus_stop'
     AND  net.value:"key"::STRING ILIKE '%network%'
)
SELECT bus_network,
       COUNT(*)  AS stop_cnt
FROM   dk
JOIN   bus_points bp
       ON ST_CONTAINS(dk.dk_geog, bp.pt_geog)
GROUP  BY bus_network
ORDER  BY stop_cnt DESC
LIMIT 1;
```
