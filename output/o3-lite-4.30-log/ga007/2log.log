```sql
-- 5. Tag each page_view as PDP or PLP using the rules (boolean flags only, no aggregation yet)
WITH pages AS (
  SELECT ep.value.string_value AS page_url
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
         UNNEST(t.event_params) AS ep
  WHERE  t.event_date = '20210102'
    AND  t.event_name = 'page_view'
    AND  ep.key = 'page_location'
)
SELECT page_url,
       CASE
         WHEN STRPOS(LOWER(page_url), '+') > -1 THEN 'PDP'
         ELSE 'PLP'
       END AS page_type
FROM pages
LIMIT 20;
```

```sql
-- 6. Apply the full category test plus “+” test, keep only urls that meet category requirement
WITH pages AS (
  SELECT ep.value.string_value AS page_url,
         SPLIT(ep.value.string_value, '/') AS url_parts
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
         UNNEST(t.event_params) AS ep
  WHERE  t.event_date = '20210102'
    AND  t.event_name = 'page_view'
    AND  ep.key = 'page_location'
),
categories AS (
  SELECT ['accessories','apparel','brands','campus collection','drinkware','electronics',
          'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
          'shop by brand','small goods','stationery','wearables'] AS kw
)
SELECT page_url,
       CASE
         WHEN STRPOS(LOWER(page_url), '+') > -1 THEN 'PDP' ELSE 'PLP' END AS simple_flag,
       EXISTS(SELECT 1 FROM UNNEST(c.kw) AS k
              WHERE LOWER(page_url) LIKE CONCAT('%', REPLACE(k,' ','%'), '%')) AS has_category
FROM pages, categories c
LIMIT 20;
```

```sql
-- 7. Keep only valid PLP/PDP pages (has_category = TRUE and at least 5 segments)
WITH pages AS (
  SELECT ep.value.string_value AS page_url,
         SPLIT(ep.value.string_value, '/') AS url_parts
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
         UNNEST(t.event_params) AS ep
  WHERE  t.event_date = '20210102'
    AND  t.event_name = 'page_view'
    AND  ep.key = 'page_location'
),
categories AS (
  SELECT ['accessories','apparel','brands','campus collection','drinkware','electronics',
          'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
          'shop by brand','small goods','stationery','wearables'] AS kw
)
SELECT page_url,
       CASE
         WHEN STRPOS(LOWER(page_url), '+') > -1 THEN 'PDP' ELSE 'PLP' END AS page_type
FROM pages, categories c
WHERE ARRAY_LENGTH(url_parts) >= 5
  AND EXISTS(SELECT 1 FROM UNNEST(c.kw) AS k
             WHERE LOWER(page_url) LIKE CONCAT('%', REPLACE(k,' ','%'), '%'))
LIMIT 20;
```

```sql
-- 8. Aggregate counts of PLP vs PDP that passed filters
WITH classified AS (
  SELECT
    CASE WHEN STRPOS(LOWER(page_url), '+') > -1 THEN 'PDP' ELSE 'PLP' END AS page_type
  FROM (
    SELECT ep.value.string_value AS page_url,
           SPLIT(ep.value.string_value, '/') AS url_parts
    FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
           UNNEST(t.event_params) AS ep
    WHERE  t.event_date = '20210102'
      AND  t.event_name = 'page_view'
      AND  ep.key = 'page_location'
  ) pages
  WHERE ARRAY_LENGTH(url_parts) >= 5
    AND (
      LOWER(url_parts[OFFSET(3)]) IN (
        'accessories','apparel','brands','campus collection','drinkware','electronics',
        'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
        'shop by brand','small goods','stationery','wearables'
      ) OR
      LOWER(url_parts[OFFSET(4)]) IN (
        'accessories','apparel','brands','campus collection','drinkware','electronics',
        'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
        'shop by brand','small goods','stationery','wearables'
      )
    )
)
SELECT page_type, COUNT(*) AS views
FROM   classified
GROUP  BY page_type
LIMIT 20;
```

```sql
-- 9. Translate the previous result into percentage for PDP (integer math kept as FLOAT64)
WITH classified AS (
  SELECT
    CASE WHEN STRPOS(LOWER(page_url), '+') > -1 THEN 'PDP' ELSE 'PLP' END AS page_type
  FROM (
    SELECT ep.value.string_value AS page_url,
           SPLIT(ep.value.string_value, '/') AS url_parts
    FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
           UNNEST(t.event_params) AS ep
    WHERE  t.event_date = '20210102'
      AND  t.event_name = 'page_view'
      AND  ep.key = 'page_location'
  ) pages
  WHERE ARRAY_LENGTH(url_parts) >= 5
    AND (
      LOWER(url_parts[OFFSET(3)]) IN (
        'accessories','apparel','brands','campus collection','drinkware','electronics',
        'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
        'shop by brand','small goods','stationery','wearables'
      ) OR
      LOWER(url_parts[OFFSET(4)]) IN (
        'accessories','apparel','brands','campus collection','drinkware','electronics',
        'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
        'shop by brand','small goods','stationery','wearables'
      )
    )
),
agg AS (
  SELECT
    SUM(CASE WHEN page_type='PDP' THEN 1 ELSE 0 END) AS pdp_views,
    COUNT(*)                                         AS total_views
  FROM classified
)
SELECT pdp_views,
       total_views,
       pdp_views / total_views * 100 AS pct_pdp
FROM   agg
LIMIT 20;
```

```sql
-- 10. FINAL answer: percentage of page views that were PDP pages on 2021‑01‑02
WITH base AS (
  SELECT ep.value.string_value AS page_url,
         SPLIT(ep.value.string_value, '/') AS url_parts
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
         UNNEST(t.event_params) AS ep
  WHERE  t.event_date = '20210102'
    AND  t.event_name = 'page_view'
    AND  ep.key = 'page_location'
),
classified AS (
  SELECT
    CASE WHEN STRPOS(LOWER(page_url), '+') > -1 THEN 'PDP' ELSE 'PLP' END AS page_type
  FROM base
  WHERE ARRAY_LENGTH(url_parts) >= 5
    AND (
      LOWER(url_parts[OFFSET(3)]) IN (
        'accessories','apparel','brands','campus collection','drinkware','electronics',
        'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
        'shop by brand','small goods','stationery','wearables'
      ) OR
      LOWER(url_parts[OFFSET(4)]) IN (
        'accessories','apparel','brands','campus collection','drinkware','electronics',
        'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
        'shop by brand','small goods','stationery','wearables'
      )
    )
),
final AS (
  SELECT
    SUM(CASE WHEN page_type='PDP' THEN 1 ELSE 0 END) AS pdp_views,
    COUNT(*)                                         AS total_views
  FROM classified
)
SELECT
  pdp_views,
  total_views,
  ROUND(pdp_views / total_views * 100, 2) AS percentage_PDP_pageviews
FROM final
LIMIT 20;
```

