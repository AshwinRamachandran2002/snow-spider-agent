```sql
/* ===================================================================
   Goal: What % of all page_view hits on 2021‑01‑02 were PDP pages?
   -------------------------------------------------------------------
   PDP definition recap (case‑insensitive):
     – URL has ≥ 5 segments    (after splitting on '/')
     – Segment 4 or 5 equals   any approved category keyword
     – The FINAL segment contains a '+' sign                   

   PLP definition:
     – Same segment / category test as above
     – FINAL segment contains NO '+' sign

   Strategy in four CTEs
   1. pageviews  : fetch every 2‑Jan page_view and extract page_location
   2. qualified  : keep URLs with ≥5 parts and expose seg4, seg5, last_seg
   3. classified : apply category + '+' tests → label PDP vs PLP
   4. totals     : aggregate counts and compute percentage
   =================================================================== */

WITH pageviews AS (
  -- Pull every page_view event on 2021‑01‑02 and grab its page_location URL
  SELECT
    ep.value.string_value                    AS url,
    SPLIT(ep.value.string_value, '/')        AS parts
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` AS e
  CROSS JOIN UNNEST(e.event_params) AS ep
  WHERE e.event_date  = '20210102'
    AND e.event_name  = 'page_view'
    AND ep.key        = 'page_location'
),

qualified AS (
  -- Keep only URLs with at least 5 segments and pull key pieces
  SELECT
    url,
    parts,
    LOWER(parts[SAFE_OFFSET(3)])                                     AS seg4,      -- 4th path piece
    LOWER(parts[SAFE_OFFSET(4)])                                     AS seg5,      -- 5th path piece
    LOWER(parts[ORDINAL(ARRAY_LENGTH(parts))])                       AS last_seg   -- last piece
  FROM pageviews
  WHERE ARRAY_LENGTH(parts) >= 5
),

classified AS (
  -- Define PDP vs PLP using category list + presence of '+'
  SELECT
    CASE
      WHEN STRPOS(last_seg, '+') > -1 THEN 'PDP' ELSE 'PLP'
    END AS page_type
  FROM qualified
  WHERE seg4 IN UNNEST([
          'accessories','apparel','brands','campus collection','drinkware',
          'electronics','google redesign','lifestyle','nest','new 2015 logo',
          'notebooks journals','office','shop by brand','small goods',
          'stationery','wearables'
        ])
     OR seg5 IN UNNEST([
          'accessories','apparel','brands','campus collection','drinkware',
          'electronics','google redesign','lifestyle','nest','new 2015 logo',
          'notebooks journals','office','shop by brand','small goods',
          'stationery','wearables'
        ])
),

totals AS (
  SELECT
    SUM(CASE WHEN page_type = 'PDP' THEN 1 ELSE 0 END) AS pdp_views,
    COUNT(*)                                           AS total_views
  FROM classified
)

-- Final percentage output 
SELECT
  pdp_views,
  total_views,
  ROUND(pdp_views / total_views * 100, 2) AS pct_pdp_pageviews
FROM totals;
```
