Begin Exploring Related Columns
Relevant columns and how we will use them  

event_date:           filter to the single day we are interested in ( '20210102' ).  
event_name:           keep only page‑view events ( event_name = 'page_view' ).  
event_params:         UNNEST to reach the key‑value pairs and pull the page URL that lives in the parameter whose key = 'page_location'.  
                     – we will also find other parameters (page_title, page_referrer, etc.) but only page_location is needed here.  

Important conditions we will need  

event_date         = '20210102'  
event_name         = 'page_view'  
param.key          = 'page_location'  

Page‑type rules to implement on page_location (lower‑cased for case‑insensitive matching)  

• Split the URL on “/”; make sure the array length ≥ 5.  
• Grab segment 4 or 5 (SAFE_OFFSET(3) or SAFE_OFFSET(4)).  
• Check that one of those segments contains (case‑insensitive) one of the category keywords supplied.  
• PDP = last segment of the URL contains “+”.  
• PLP = last segment does NOT contain “+”.  

Ten exploration‑to‑answer queries
(they all return max 20 rows, each illustrates one additional building block)

```sql
-- 1. Distinct event names on 2‑Jan‑2021
SELECT DISTINCT `event_name`
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
WHERE  `event_date` = '20210102'
LIMIT 20;
```

```sql
-- 2. Grab a handful of event_params to see which keys exist on a page_view
SELECT ep.key,
       ep.value.string_value AS string_val,
       ep.value.int_value     AS int_val
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
       UNNEST(t.event_params) AS ep
WHERE  t.event_date = '20210102'
  AND  t.event_name = 'page_view'
LIMIT 20;
```

```sql
-- 3. Pull only the page_location values for page_view events
SELECT ep.value.string_value AS page_url
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
       UNNEST(t.event_params) AS ep
WHERE  t.event_date = '20210102'
  AND  t.event_name = 'page_view'
  AND  ep.key = 'page_location'
LIMIT 20;
```

```sql
-- 4. Break the URL into segments to make sure we have enough depth
SELECT page_url,
       ARRAY_LENGTH(url_parts) AS parts_cnt,
       url_parts[OFFSET(3)]    AS seg4,
       url_parts[OFFSET(4)]    AS seg5
FROM (
  SELECT ep.value.string_value AS page_url,
         SPLIT(ep.value.string_value, '/') AS url_parts
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
         UNNEST(t.event_params) AS ep
  WHERE  t.event_date = '20210102'
    AND  t.event_name = 'page_view'
    AND  ep.key = 'page_location'
)
LIMIT 20;
```

```sql
-- 5. Tag each page_view as PDP or PLP using the rules (boolean flags only, no aggregation yet)
WITH pages AS (
  SELECT ep.value.string_value AS page_url
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
         UNNEST(t.event_params) AS ep
  WHERE  t.event_date = '20210102'
    AND  t.event_name = 'page_view'
    AND  ep.key = 'page_location'
)
SELECT page_url,
       CASE
         WHEN STRPOS(LOWER(page_url), '+') > -1 THEN 'PDP'
         ELSE 'PLP'
       END AS page_type
FROM pages
LIMIT 20;
```

```sql
-- 6. Apply the full category test plus “+” test, keep only urls that meet category requirement
WITH pages AS (
  SELECT ep.value.string_value AS page_url,
         SPLIT(ep.value.string_value, '/') AS url_parts
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
         UNNEST(t.event_params) AS ep
  WHERE  t.event_date = '20210102'
    AND  t.event_name = 'page_view'
    AND  ep.key = 'page_location'
),
categories AS (
  SELECT ['accessories','apparel','brands','campus collection','drinkware','electronics',
          'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
          'shop by brand','small goods','stationery','wearables'] AS kw
)
SELECT page_url,
       CASE
         WHEN STRPOS(LOWER(page_url), '+') > -1 THEN 'PDP' ELSE 'PLP' END AS simple_flag,
       EXISTS(SELECT 1 FROM UNNEST(c.kw) AS k
              WHERE LOWER(page_url) LIKE CONCAT('%', REPLACE(k,' ','%'), '%')) AS has_category
FROM pages, categories c
LIMIT 20;
```

```sql
-- 7. Keep only valid PLP/PDP pages (has_category = TRUE and at least 5 segments)
WITH pages AS (
  SELECT ep.value.string_value AS page_url,
         SPLIT(ep.value.string_value, '/') AS url_parts
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
         UNNEST(t.event_params) AS ep
  WHERE  t.event_date = '20210102'
    AND  t.event_name = 'page_view'
    AND  ep.key = 'page_location'
),
categories AS (
  SELECT ['accessories','apparel','brands','campus collection','drinkware','electronics',
          'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
          'shop by brand','small goods','stationery','wearables'] AS kw
)
SELECT page_url,
       CASE
         WHEN STRPOS(LOWER(page_url), '+') > -1 THEN 'PDP' ELSE 'PLP' END AS page_type
FROM pages, categories c
WHERE ARRAY_LENGTH(url_parts) >= 5
  AND EXISTS(SELECT 1 FROM UNNEST(c.kw) AS k
             WHERE LOWER(page_url) LIKE CONCAT('%', REPLACE(k,' ','%'), '%'))
LIMIT 20;
```

```sql
-- 8. Aggregate counts of PLP vs PDP that passed filters
WITH classified AS (
  SELECT
    CASE WHEN STRPOS(LOWER(page_url), '+') > -1 THEN 'PDP' ELSE 'PLP' END AS page_type
  FROM (
    SELECT ep.value.string_value AS page_url,
           SPLIT(ep.value.string_value, '/') AS url_parts
    FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
           UNNEST(t.event_params) AS ep
    WHERE  t.event_date = '20210102'
      AND  t.event_name = 'page_view'
      AND  ep.key = 'page_location'
  ) pages
  WHERE ARRAY_LENGTH(url_parts) >= 5
    AND (
      LOWER(url_parts[OFFSET(3)]) IN (
        'accessories','apparel','brands','campus collection','drinkware','electronics',
        'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
        'shop by brand','small goods','stationery','wearables'
      ) OR
      LOWER(url_parts[OFFSET(4)]) IN (
        'accessories','apparel','brands','campus collection','drinkware','electronics',
        'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
        'shop by brand','small goods','stationery','wearables'
      )
    )
)
SELECT page_type, COUNT(*) AS views
FROM   classified
GROUP  BY page_type
LIMIT 20;
```

```sql
-- 9. Translate the previous result into percentage for PDP (integer math kept as FLOAT64)
WITH classified AS (
  SELECT
    CASE WHEN STRPOS(LOWER(page_url), '+') > -1 THEN 'PDP' ELSE 'PLP' END AS page_type
  FROM (
    SELECT ep.value.string_value AS page_url,
           SPLIT(ep.value.string_value, '/') AS url_parts
    FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
           UNNEST(t.event_params) AS ep
    WHERE  t.event_date = '20210102'
      AND  t.event_name = 'page_view'
      AND  ep.key = 'page_location'
  ) pages
  WHERE ARRAY_LENGTH(url_parts) >= 5
    AND (
      LOWER(url_parts[OFFSET(3)]) IN (
        'accessories','apparel','brands','campus collection','drinkware','electronics',
        'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
        'shop by brand','small goods','stationery','wearables'
      ) OR
      LOWER(url_parts[OFFSET(4)]) IN (
        'accessories','apparel','brands','campus collection','drinkware','electronics',
        'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
        'shop by brand','small goods','stationery','wearables'
      )
    )
),
agg AS (
  SELECT
    SUM(CASE WHEN page_type='PDP' THEN 1 ELSE 0 END) AS pdp_views,
    COUNT(*)                                         AS total_views
  FROM classified
)
SELECT pdp_views,
       total_views,
       pdp_views / total_views * 100 AS pct_pdp
FROM   agg
LIMIT 20;
```

```sql
-- 10. FINAL answer: percentage of page views that were PDP pages on 2021‑01‑02
WITH base AS (
  SELECT ep.value.string_value AS page_url,
         SPLIT(ep.value.string_value, '/') AS url_parts
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
         UNNEST(t.event_params) AS ep
  WHERE  t.event_date = '20210102'
    AND  t.event_name = 'page_view'
    AND  ep.key = 'page_location'
),
classified AS (
  SELECT
    CASE WHEN STRPOS(LOWER(page_url), '+') > -1 THEN 'PDP' ELSE 'PLP' END AS page_type
  FROM base
  WHERE ARRAY_LENGTH(url_parts) >= 5
    AND (
      LOWER(url_parts[OFFSET(3)]) IN (
        'accessories','apparel','brands','campus collection','drinkware','electronics',
        'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
        'shop by brand','small goods','stationery','wearables'
      ) OR
      LOWER(url_parts[OFFSET(4)]) IN (
        'accessories','apparel','brands','campus collection','drinkware','electronics',
        'google redesign','lifestyle','nest','new 2015 logo','notebooks journals','office',
        'shop by brand','small goods','stationery','wearables'
      )
    )
),
final AS (
  SELECT
    SUM(CASE WHEN page_type='PDP' THEN 1 ELSE 0 END) AS pdp_views,
    COUNT(*)                                         AS total_views
  FROM classified
)
SELECT
  pdp_views,
  total_views,
  ROUND(pdp_views / total_views * 100, 2) AS percentage_PDP_pageviews
FROM final
LIMIT 20;
```

