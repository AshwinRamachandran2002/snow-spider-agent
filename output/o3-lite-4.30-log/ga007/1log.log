Begin Exploring Related Columns
Relevant columns and their potential usage for this task  
(event‑params are accessed through UNNEST):

• event_date : filter to 20210102 (1‑Jan‑02).  
• event_name : keep only the 'page_view' events (one event per page‑view).  
• event_params.key = 'page_location' / value.string_value : full URL we have to classify as PDP or not.  
• event_params.key = 'page_referrer' (optional) : sometimes useful to double‑check navigation paths.  

Typical conditions you will see in the SQLs below  
    WHERE event_date = '20210102'  
      AND event_name = 'page_view'  
      AND ep.key = 'page_location'  

A PDP will be identified when  
    – the URL contains at least 5 “/” segments  
    – the last segment contains “+” (plus sign)  
    – one of the allowed category names appears in either the 4‑th or 5‑th segment  
The category list (case‑insensitive, “+” stands for spaces) is:  
accessories, apparel, brands, campus+collection, drinkware, electronics, google+redesign, lifestyle, nest, new+2015+logo, notebooks+journals, office, shop+by+brand, small+goods, stationery, wearables  

Below are ten exploratory → analytical queries (LIMIT 20 each) that gradually lead to the final percentage calculation.

```sql
-- 1. Distinct event names that happened on 2021‑01‑02
SELECT DISTINCT event_name
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
WHERE event_date = '20210102'
LIMIT 20;
```

```sql
-- 2. All distinct keys living inside event_params for page_view events on that day
SELECT DISTINCT ep.key
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params) AS ep
WHERE event_date = '20210102'
  AND event_name = 'page_view'
LIMIT 20;
```

```sql
-- 3. Sample raw page_location URLs (first 20)
SELECT ep.value.string_value AS page_location
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params) AS ep
WHERE event_date = '20210102'
  AND event_name = 'page_view'
  AND ep.key = 'page_location'
LIMIT 20;
```

```sql
-- 4. Show how many "/" segments each URL has (to see the split pattern)
SELECT
  ep.value.string_value AS page_location,
  ARRAY_LENGTH(SPLIT(ep.value.string_value,'/')) AS segments
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params) ep
WHERE event_date = '20210102'
  AND event_name = 'page_view'
  AND ep.key = 'page_location'
LIMIT 20;
```

```sql
-- 5. Mark each page_view as potential PDP (=1) or not (=0) – sample
WITH pages AS (
  SELECT
    ep.value.string_value AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) ep
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
    AND ep.key = 'page_location'
)
SELECT
  url,
  -- Boolean marker following the refined PDP logic
  IF(
     REGEXP_CONTAINS(LOWER(url),
       r'/((accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables))/[^/]*\+$'
     ), 1, 0) AS is_pdp
FROM pages
LIMIT 20;
```

```sql
-- 6. Total number of page_view events on 2021‑01‑02
SELECT COUNT(*) AS total_page_views
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
WHERE event_date = '20210102'
  AND event_name = 'page_view'
LIMIT 20;
```

```sql
-- 7. Count of PDP‑qualified page_view events on the same day
WITH pages AS (
  SELECT
    ep.value.string_value AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) ep
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
    AND ep.key = 'page_location'
)
SELECT COUNT(*) AS pdp_page_views
FROM pages
WHERE REGEXP_CONTAINS(LOWER(url),
      r'/((accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables))/[^/]*\+$')
LIMIT 20;
```

```sql
-- 8. Combine total and PDP counts side‑by‑side
WITH pages AS (
  SELECT
    ep.value.string_value AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) ep
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
    AND ep.key = 'page_location'
),
stats AS (
  SELECT
    COUNT(*) AS total_views,
    COUNTIF(REGEXP_CONTAINS(LOWER(url),
            r'/((accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables))/[^/]*\+$')
          ) AS pdp_views
  FROM pages
)
SELECT * FROM stats
LIMIT 20;
```

```sql
-- 9. Same as #8 but also returns the percentage
WITH pages AS (
  SELECT
    ep.value.string_value AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) ep
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
    AND ep.key = 'page_location'
),
stats AS (
  SELECT
    COUNT(*) AS total_views,
    COUNTIF(REGEXP_CONTAINS(LOWER(url),
            r'/((accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables))/[^/]*\+$')
          ) AS pdp_views
  FROM pages
)
SELECT
  total_views,
  pdp_views,
  SAFE_DIVIDE(pdp_views,total_views)*100 AS pct_pdp_pageviews
FROM stats
LIMIT 20;
```

```sql
-- 10. Single‑step query returning only the percentage of PDP page views on 2021‑01‑02
SELECT
  SAFE_DIVIDE(
    COUNTIF( REGEXP_CONTAINS(LOWER(ep.value.string_value),
              r'/((accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables))/[^/]*\+$')
           ),
    COUNT(*) ) * 100 AS pct_pdp_pageviews
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params) AS ep
WHERE event_date = '20210102'
  AND event_name = 'page_view'
  AND ep.key = 'page_location'
LIMIT 20;
```

