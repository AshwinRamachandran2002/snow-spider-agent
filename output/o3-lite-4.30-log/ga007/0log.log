--Description:
-- Objective: sample 20 page‑view events from 2021‑01‑02 and show
--            • full URL (page_location)
--            • its final path segment
--            • a flag (has_plus) set to 1 when the final segment contains “+”.
--
-- Thinking steps encoded below:
-- 1. From every qualifying event, pull the `page_location` value out of
--    the repeated `event_params` array.
-- 2. Strip any leading “http://” or “https://” with REGEXP_REPLACE
--    (third argument '' is mandatory, fixing the earlier error).
-- 3. Split the trimmed URL on “/” → array `parts`.
-- 4. Retrieve the last element of `parts` as `last_segment`.
-- 5. Flag `has_plus` via a LIKE test on that segment.
-- 6. LIMIT 20 rows for a quick human check.

WITH pageviews AS (
  SELECT
    (SELECT ep.value.string_value
       FROM UNNEST(event_params) AS ep
      WHERE ep.key = 'page_location') AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
)
SELECT
  page_location,
  parts[OFFSET(ARRAY_LENGTH(parts) - 1)] AS last_segment,
  IF(parts[OFFSET(ARRAY_LENGTH(parts) - 1)] LIKE '%+%', 1, 0)    AS has_plus
FROM (
  SELECT
    page_location,
    SPLIT(
      REGEXP_REPLACE(page_location, r'^https?://', ''),  -- remove protocol
      '/'
    ) AS parts
  FROM pageviews
)
LIMIT 20;
