Successfully corrected. SQL:
--Description:  One‑stop query that
--  • finds each state’s most‑recent evaluation group that is coded ‘EXPCURR’,
--  • converts every eligible condition’s proportion (MACR or SUBP) to acres by the
--    correct adjustment factor,
--  • aggregates to state totals for
--        – Forestland  (condition_status_code = 1)
--        – Timberland (condition_status_code = 1  AND  reserved_status_code = 0
--                     AND site_productivity_class_code BETWEEN 1 AND 6),
--  • ranks states on those totals,
--  • returns the single state that has the greatest acreage in each category,
--    with its state code, latest evaluation‑group number, state name, and acres.
WITH latest_eval AS (      -- newest evaluation group (sequence) per state that carries EXPCURR
    SELECT
        peg.state_code,
        MAX(peg.evaluation_group_sequence_number) AS latest_egs
    FROM   `bigquery-public-data.usfs_fia.population_evaluation_group`  AS peg
    JOIN   `bigquery-public-data.usfs_fia.population_evaluation_type`   AS pet
           ON pet.evaluation_group_sequence_number = peg.evaluation_group_sequence_number
    WHERE  pet.evaluation_type = 'EXPCURR'
    GROUP BY peg.state_code
),
pop AS (                    -- population rows restricted to those latest groups
    SELECT
        p.plot_sequence_number,
        p.state_code,
        p.evaluation_group,
        p.evaluation_group_sequence_number,
        p.location_name                  AS state_name,
        p.adjustment_factor_for_the_macroplot AS fac_macr,
        p.adjustment_factor_for_the_subplot   AS fac_subp
    FROM   `bigquery-public-data.usfs_fia.population` AS p
    JOIN   latest_eval AS l
           ON l.state_code = p.state_code
          AND l.latest_egs = p.evaluation_group_sequence_number
),
cond AS (                   -- attach conditions and compute per‑record acres
    SELECT
        pop.state_code,
        pop.evaluation_group,
        pop.state_name,
        -- choose the right expansion factor; NULL if factor not positive
        CASE
          WHEN c.proportion_basis = 'MACR' AND pop.fac_macr > 0
               THEN c.condition_proportion_unadjusted * pop.fac_macr
          WHEN c.proportion_basis = 'SUBP' AND pop.fac_subp > 0
               THEN c.condition_proportion_unadjusted * pop.fac_subp
        END AS acres,
        c.condition_status_code,
        c.reserved_status_code,
        c.site_productivity_class_code
    FROM   `bigquery-public-data.usfs_fia.condition` AS c
    JOIN   pop
           ON pop.plot_sequence_number = c.plot_sequence_number
    WHERE  c.proportion_basis IN ('MACR','SUBP')
),
acres_by_state AS (         -- roll up to totals for each category
    SELECT
        state_code,
        MAX(evaluation_group) AS evaluation_group,
        MAX(state_name)       AS state_name,
        SUM(IF(condition_status_code = 1, acres, 0)) AS forest_acres,
        SUM(IF(condition_status_code = 1
               AND reserved_status_code = 0
               AND site_productivity_class_code BETWEEN 1 AND 6,
               acres, 0)) AS timber_acres
    FROM   cond
    GROUP  BY state_code
),
ranked AS (                 -- rank states separately for forest and timber
    SELECT *,
           ROW_NUMBER() OVER (ORDER BY forest_acres  DESC) AS rn_forest,
           ROW_NUMBER() OVER (ORDER BY timber_acres DESC) AS rn_timber
    FROM   acres_by_state
)
SELECT
    'FORESTLAND'            AS category,
    state_code,
    evaluation_group,
    state_name,
    forest_acres            AS total_acres
FROM   ranked
WHERE  rn_forest = 1

UNION ALL

SELECT
    'TIMBERLAND'            AS category,
    state_code,
    evaluation_group,
    state_name,
    timber_acres            AS total_acres
FROM   ranked
WHERE  rn_timber = 1;
