The table structure information is ({database name: {schema name: [table name]}}): 
{'bigquery-public-data': {'usfs_fia': ['population_stratum_assign', 'plot', 'plot_tree', 'tree', 'population_stratum', 'population_evaluation_group', 'condition', 'population_evaluation', 'population_estimation_unit', 'population_evaluation_type', 'population']}}
Begin Exploring Related Columns
Relevant columns and how they will be used  

(Only columns that are needed for the requested acreage roll‑ups are listed here.)  
• `condition.condition_status_code` – filter to 1 (= forested condition).  
• `condition.reserved_status_code` – filter to 0 for timberland.  
• `condition.site_productivity_class_code` – filter between 1 and 6 for timberland.  
• `condition.proportion_basis` – tells whether the record represents a MACR(0.25‑acre) or SUBP(0.017‑acre) portion.  
• `population.adjustment_factor_for_the_macroplot` – expansion factor to convert MACR proportions to acres.  
• `population.adjustment_factor_for_the_subplot` – expansion factor to convert SUBP proportions to acres.  
• `population.evaluation_group_sequence_number` – ties every plot/condition record to one evaluation group.  
• `population.evaluation_group` / `population_evaluation_group.evaluation_group` – numeric code that generally increases with time; used to pick the “latest” evaluation group in each state.  
• `population_evaluation_type.evaluation_type` – filter to ‘EXPCURR’.  
• `population.plot_sequence_number` and `condition.plot_sequence_number` – join key between the population‑derived factors and the plot/condition filters.  
• `population.state_code`  /  `population.plot_state_code_name` – state id / name for the roll‑ups.  

Typical filter logic that will be applied later  
Timberland : `condition_status_code = 1` AND `reserved_status_code = 0` AND `site_productivity_class_code BETWEEN 1 AND 6`  
Forestland : `condition_status_code = 1`  
Both categories : include only conditions whose `proportion_basis` is either ‘MACR’ or ‘SUBP’; keep the corresponding population adjustment factor if it is > 0.  

─────────────────────────────────────────────────────────  
Ten exploratory BigQuery SQL snippets (all use the public FIA data set)  
─────────────────────────────────────────────────────────  

```sql
-- 1) Look at the different condition_status_code values and their meaning
SELECT DISTINCT condition_status_code, condition_status_code_name
FROM `bigquery-public-data.usfs_fia.condition`
LIMIT 20;
```

```sql
-- 2) What values appear in proportion_basis (MACR, SUBP, etc.)?
SELECT DISTINCT proportion_basis
FROM `bigquery-public-data.usfs_fia.condition`
WHERE proportion_basis IS NOT NULL
LIMIT 20;
```

```sql
-- 3) Inspect adjustment‑factor columns that will later be multiplied by proportions
SELECT adjustment_factor_for_the_macroplot,
       adjustment_factor_for_the_subplot
FROM `bigquery-public-data.usfs_fia.population`
WHERE adjustment_factor_for_the_macroplot > 0
   OR adjustment_factor_for_the_subplot  > 0
LIMIT 20;
```

```sql
-- 4) Sample join between condition records and population‑level factors for one plot
SELECT c.plot_sequence_number,
       c.proportion_basis,
       p.adjustment_factor_for_the_macroplot,
       p.adjustment_factor_for_the_subplot
FROM `bigquery-public-data.usfs_fia.condition`  AS c
JOIN `bigquery-public-data.usfs_fia.population` AS p
  ON p.plot_sequence_number = c.plot_sequence_number
WHERE c.plot_sequence_number IS NOT NULL
LIMIT 20;
```

```sql
-- 5) See how many evaluation groups exist per state and their codes
SELECT state_code,
       COUNT(DISTINCT evaluation_group_sequence_number) AS n_groups,
       ARRAY_AGG(DISTINCT evaluation_group ORDER BY evaluation_group DESC)[OFFSET(0)] AS latest_eval_group_code
FROM `bigquery-public-data.usfs_fia.population_evaluation_group`
GROUP BY state_code
ORDER BY state_code
LIMIT 20;
```

```sql
-- 6) Verify which evaluation types are attached to each evaluation group
SELECT eg.state_code,
       eg.evaluation_group,
       et.evaluation_type
FROM   `bigquery-public-data.usfs_fia.population_evaluation_group` AS eg
JOIN   `bigquery-public-data.usfs_fia.population_evaluation_type`  AS et
  ON   et.evaluation_group_sequence_number = eg.evaluation_group_sequence_number
WHERE  et.evaluation_type = 'EXPCURR'
LIMIT 20;
```

```sql
-- 7) Identify (state, evaluation_group) combinations that are the most recent per state and have EXPCURR
WITH latest AS (
  SELECT eg.state_code,
         MAX(eg.evaluation_group) AS latest_eval_group
  FROM `bigquery-public-data.usfs_fia.population_evaluation_group` AS eg
  GROUP BY eg.state_code
)
SELECT l.state_code,
       l.latest_eval_group,
       eg.evaluation_group_description
FROM   latest AS l
JOIN   `bigquery-public-data.usfs_fia.population_evaluation_group` AS eg
  ON   eg.state_code = l.state_code
 AND   eg.evaluation_group = l.latest_eval_group
LIMIT 20;
```

```sql
-- 8) Acres contributed by each condition (MACR only) for one target state & eval group
--    Adjusted proportion * expansion factor gives acres for that condition part
WITH one_state AS (
  SELECT state_code,
         MAX(evaluation_group) AS latest_eval_group
  FROM `bigquery-public-data.usfs_fia.population_evaluation_group`
  WHERE state_code = 41              -- Oregon as example
  GROUP BY state_code
)
SELECT c.plot_sequence_number,
       c.condition_class_number,
       c.condition_proportion_unadjusted AS prop_unadj,
       p.adjustment_factor_for_the_macroplot AS exp_factor,
       prop_unadj * exp_factor        AS acres_est
FROM   `bigquery-public-data.usfs_fia.condition`  AS c
JOIN   `bigquery-public-data.usfs_fia.population` AS p
  ON   p.plot_sequence_number             = c.plot_sequence_number
JOIN   one_state AS s
  ON   p.state_code                       = s.state_code
JOIN   `bigquery-public-data.usfs_fia.population_evaluation_type` AS et
  ON   et.evaluation_group_sequence_number = p.evaluation_group_sequence_number
WHERE  et.evaluation_type = 'EXPCURR'
  AND  p.evaluation_group = s.latest_eval_group
  AND  c.proportion_basis = 'MACR'
  AND  p.adjustment_factor_for_the_macroplot > 0
LIMIT 20;
```

```sql
-- 9) Forestland acres per state (latest eval group, EXPCURR), keeping MACR & SUBP
WITH latest AS (
  SELECT state_code,
         MAX(evaluation_group_sequence_number) AS latest_egs
  FROM   `bigquery-public-data.usfs_fia.population_evaluation_group`
  GROUP BY state_code
),
pop_filtered AS (
  SELECT p.state_code,
         p.plot_sequence_number,
         p.adjustment_factor_for_the_macroplot,
         p.adjustment_factor_for_the_subplot
  FROM   `bigquery-public-data.usfs_fia.population` AS p
  JOIN   latest AS l  USING (state_code)
  JOIN   `bigquery-public-data.usfs_fia.population_evaluation_type` AS et
    ON et.evaluation_group_sequence_number = p.evaluation_group_sequence_number
  WHERE et.evaluation_type = 'EXPCURR'
)
SELECT pf.state_code,
       SUM(CASE WHEN c.proportion_basis = 'MACR'
                THEN c.condition_proportion_unadjusted * pf.adjustment_factor_for_the_macroplot
                WHEN c.proportion_basis = 'SUBP'
                THEN c.condition_proportion_unadjusted * pf.adjustment_factor_for_the_subplot
           END) AS forest_acres
FROM   pop_filtered AS pf
JOIN   `bigquery-public-data.usfs_fia.condition` AS c
  ON   c.plot_sequence_number = pf.plot_sequence_number
WHERE  c.condition_status_code = 1               -- forest land
  AND  c.proportion_basis IN ('MACR','SUBP')
GROUP BY pf.state_code
ORDER BY forest_acres DESC
LIMIT 20;
