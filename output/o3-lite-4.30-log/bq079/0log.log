```sql
-- 2) What values appear in proportion_basis (MACR, SUBP, etc.)?
SELECT DISTINCT proportion_basis
FROM `bigquery-public-data.usfs_fia.condition`
WHERE proportion_basis IS NOT NULL
LIMIT 20;
```

```sql
-- 3) Inspect adjustment‑factor columns that will later be multiplied by proportions
SELECT adjustment_factor_for_the_macroplot,
       adjustment_factor_for_the_subplot
FROM `bigquery-public-data.usfs_fia.population`
WHERE adjustment_factor_for_the_macroplot > 0
   OR adjustment_factor_for_the_subplot  > 0
LIMIT 20;
```

```sql
-- 4) Sample join between condition records and population‑level factors for one plot
SELECT c.plot_sequence_number,
       c.proportion_basis,
       p.adjustment_factor_for_the_macroplot,
       p.adjustment_factor_for_the_subplot
FROM `bigquery-public-data.usfs_fia.condition`  AS c
JOIN `bigquery-public-data.usfs_fia.population` AS p
  ON p.plot_sequence_number = c.plot_sequence_number
WHERE c.plot_sequence_number IS NOT NULL
LIMIT 20;
```

```sql
-- 5) See how many evaluation groups exist per state and their codes
