--Description / Thinking process ------------------------------------------------
-- 1. Most‑recent evaluation_group per state is found via population_evaluation_group
--    (latest created_date).  Keep only those evaluation_groups that contain
--    evaluation_type = 'EXPCURR'.                                             eg_curr
-- 2. These evaluation_groups are joined to population_stratum_assign (sa) to
--    reach every sampled plot that belongs to that evaluation.
-- 3. sa → population_stratum (ps) gives expansion_factor and adjustment factors.
-- 4. sa → condition (c) supplies plot‑level land status & proportion_basis.
-- 5. For each condition record we compute “adj_acres”:
--      MACR  : expansion_factor * macroplot_adj_factor (if >0)
--      SUBP  : expansion_factor * subplot_adj_factor  (if >0)
--      else  : expansion_factor
-- 6. Flags: is_forest = (condition_status_code =1)
--           is_timber = is_forest AND reserved_status_code =0
--                                   AND site_productivity 1–6
-- 7. Sum acres per state. pick the maximum timberland state and
--    maximum forestland state (could be the same or different).
-- 8. Map state_code → state_name using the plot table (one scan with ANY_VALUE).
-- 9. Return exactly two rows via UNION ALL.

WITH latest_groups AS (
  SELECT state_code,
         MAX(pop_evaluation_group_created_date) AS latest_date
  FROM   `bigquery-public-data.usfs_fia.population_evaluation_group`
  GROUP  BY state_code
),
eg_latest AS (
  SELECT eg.*
  FROM   `bigquery-public-data.usfs_fia.population_evaluation_group` eg
  JOIN   latest_groups lg
    ON   lg.state_code = eg.state_code
   AND   lg.latest_date = eg.pop_evaluation_group_created_date
),
eg_curr AS (                       -- newest group that includes EXPCURR
  SELECT DISTINCT eg.*
  FROM   eg_latest eg
  JOIN   `bigquery-public-data.usfs_fia.population_evaluation_type` et
    ON   et.evaluation_group_sequence_number = eg.evaluation_group_sequence_number
   AND  et.evaluation_type = 'EXPCURR'
),
base AS (                          -- per‑condition adjusted acres + flags
  SELECT eg.state_code,
         eg.evaluation_group,
         CASE
           WHEN c.proportion_basis = 'MACR'
                AND ps.adjustment_factor_for_the_macroplot > 0
             THEN ps.expansion_factor * ps.adjustment_factor_for_the_macroplot
           WHEN c.proportion_basis = 'SUBP'
                AND ps.adjustment_factor_for_the_subplot  > 0
             THEN ps.expansion_factor * ps.adjustment_factor_for_the_subplot
           ELSE ps.expansion_factor
         END                                         AS adj_acres,
         (c.condition_status_code = 1)               AS is_forest,
         (c.condition_status_code = 1
          AND c.reserved_status_code = 0
          AND c.site_productivity_class_code BETWEEN 1 AND 6) AS is_timber
  FROM   eg_curr eg
  JOIN   `bigquery-public-data.usfs_fia.population_stratum_assign` sa
         ON sa.region_or_station_code = eg.region_or_station_code
        AND sa.evaluation_identifier  = eg.evaluation_group
  JOIN   `bigquery-public-data.usfs_fia.population_stratum` ps
         ON ps.stratum_sequence_number = sa.stratum_sequence_number
  JOIN   `bigquery-public-data.usfs_fia.condition` c
         ON c.plot_sequence_number = sa.plot_sequence_number
),
sums AS (                          -- total acres per state
  SELECT state_code,
         evaluation_group,
         SUM(CASE WHEN is_timber THEN adj_acres ELSE 0 END) AS timberland_acres,
         SUM(CASE WHEN is_forest THEN adj_acres ELSE 0 END)  AS forestland_acres
  FROM   base
  GROUP  BY state_code, evaluation_group
),
max_timber AS (
  SELECT *
  FROM   sums
  ORDER  BY timberland_acres DESC
  LIMIT 1
),
max_forest AS (
  SELECT *
  FROM   sums
  ORDER  BY forestland_acres DESC
  LIMIT 1
),
state_names AS (                   -- map code → name once
  SELECT plot_state_code AS state_code,
         ANY_VALUE(plot_state_code_name) AS state_name
  FROM   `bigquery-public-data.usfs_fia.plot`
  GROUP  BY plot_state_code
)

-- final output: two rows
SELECT 'TIMBERLAND'          AS category,
       mt.state_code,
       mt.evaluation_group,
       sn.state_name,
       mt.timberland_acres   AS total_acres
FROM   max_timber mt
JOIN   state_names sn USING (state_code)

UNION ALL

SELECT 'FORESTLAND'          AS category,
       mf.state_code,
       mf.evaluation_group,
       sn.state_name,
       mf.forestland_acres   AS total_acres
FROM   max_forest mf
JOIN   state_names sn USING (state_code);
