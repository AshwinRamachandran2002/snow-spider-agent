-- 10. One shot: top state for timberland and for forestland (macro‑plot)
WITH latest AS (
  SELECT state_code, evaluation_group
  FROM (
    SELECT state_code, evaluation_group,
           ROW_NUMBER() OVER (PARTITION BY state_code ORDER BY evaluation_group DESC) rn
    FROM `bigquery-public-data.usfs_fia.population`
    WHERE evaluation_type = 'EXPCURR'
  ) WHERE rn = 1
),
pop AS (
  SELECT p.state_code,
         p.plot_sequence_number,
         p.expansion_factor,
         p.adjustment_factor_for_the_macroplot AS adj
  FROM `bigquery-public-data.usfs_fia.population` p
  JOIN latest USING (state_code, evaluation_group)
),
cond AS (
  SELECT plot_sequence_number,
         condition_proportion_unadjusted,
         reserved_status_code,
         site_productivity_class_code
  FROM `bigquery-public-data.usfs_fia.condition`
  WHERE condition_status_code = 1
        AND proportion_basis = 'MACR'
),
acres AS (
  SELECT p.state_code,
         SUM(p.expansion_factor * IF(p.adj>0,p.adj,1) * c.condition_proportion_unadjusted)                                       AS forest_acres,
         SUM(CASE WHEN c.reserved_status_code = 0
                       AND c.site_productivity_class_code BETWEEN 1 AND 6
                  THEN p.expansion_factor * IF(p.adj>0,p.adj,1) * c.condition_proportion_unadjusted
             END)                                                                                                                AS timber_acres
  FROM pop p
  JOIN cond c USING (plot_sequence_number)
  GROUP BY p.state_code
),
top_timber AS (SELECT * FROM acres ORDER BY timber_acres  DESC LIMIT 1),
top_forest AS (SELECT * FROM acres ORDER BY forest_acres DESC LIMIT 1)
SELECT 'TIMBERLAND' AS category,
       state_code,
       timber_acres AS acres
FROM top_timber
UNION ALL
SELECT 'FORESTLAND',
       state_code,
       forest_acres
FROM top_forest;
