/*  ---------------------------------------------------------
    Highest‑acreage states for TIMBERLAND and FORESTLAND
    (latest EXPCURR evaluation group per state)
    --------------------------------------------------------- */
WITH latest_eval AS (      -- newest evaluation_group for each state
  SELECT state_code,
         MAX(evaluation_group) AS evaluation_group
  FROM `bigquery-public-data.usfs_fia.population`
  WHERE evaluation_type = 'EXPCURR'
  GROUP BY state_code
),
pop_plot AS (              -- one record per plot within the latest group
  SELECT *
  FROM (
        SELECT p.state_code,
               p.evaluation_group,
               p.plot_sequence_number,
               p.expansion_factor,
               COALESCE(NULLIF(p.adjustment_factor_for_the_macroplot ,0),1) AS adj_macro,
               COALESCE(NULLIF(p.adjustment_factor_for_the_subplot ,0),1)  AS adj_subp,
               ROW_NUMBER() OVER (PARTITION BY p.evaluation_group,
                                             p.plot_sequence_number) AS rn
        FROM `bigquery-public-data.usfs_fia.population` p
        JOIN latest_eval l
              ON  p.state_code        = l.state_code
             AND p.evaluation_group   = l.evaluation_group
  )
  WHERE rn = 1
),
cond_ok AS (               -- condition rows that can contribute acres
  SELECT plot_sequence_number,
         proportion_basis,
         condition_proportion_unadjusted,
         reserved_status_code,
         site_productivity_class_code
  FROM `bigquery-public-data.usfs_fia.condition`
  WHERE condition_status_code = 1                 -- accessible forest land
    AND proportion_basis IN ('MACR','SUBP')       -- usable bases
),
calc AS (                  -- per‑plot per‑condition acre calculations
  SELECT pp.state_code,
         pp.evaluation_group,
         CASE                                     -- acres for this condition
           WHEN c.proportion_basis = 'MACR'
                THEN pp.expansion_factor * pp.adj_macro * c.condition_proportion_unadjusted
           ELSE        pp.expansion_factor * pp.adj_subp * c.condition_proportion_unadjusted
         END                                                                      AS forest_acres,
         CASE                                     -- timberland acres (extra filters)
           WHEN c.reserved_status_code = 0
            AND c.site_productivity_class_code BETWEEN 1 AND 6
            THEN CASE
                   WHEN c.proportion_basis = 'MACR'
                        THEN pp.expansion_factor * pp.adj_macro * c.condition_proportion_unadjusted
                   ELSE   pp.expansion_factor * pp.adj_subp  * c.condition_proportion_unadjusted
                 END
           ELSE 0
         END                                                                      AS timber_acres
  FROM pop_plot pp
  JOIN cond_ok  c
    ON pp.plot_sequence_number = c.plot_sequence_number
),
state_totals AS (          -- total acres per state / evaluation group
  SELECT state_code,
         evaluation_group,
         SUM(timber_acres) AS timber_acres,
         SUM(forest_acres) AS forest_acres
  FROM calc
  GROUP BY state_code, evaluation_group
),
top_timber AS (            -- state with greatest timberland acreage
  SELECT *
  FROM state_totals
  ORDER BY timber_acres DESC
  LIMIT 1
),
top_forest AS (            -- state with greatest forestland acreage
  SELECT *
  FROM state_totals
  ORDER BY forest_acres DESC
  LIMIT 1
),
state_names AS (           -- look‑up for readable state names
  SELECT DISTINCT
         plot_state_code        AS state_code,
         plot_state_code_name   AS state_name
  FROM `bigquery-public-data.usfs_fia.plot`
)
SELECT 'TIMBERLAND'                      AS category,
       t.state_code                      AS state_cd,
       t.evaluation_group               AS evalidgrp,
       n.state_name,
       ROUND(t.timber_acres ,4)          AS total_acres
FROM  top_timber t
LEFT JOIN state_names n USING (state_code)

UNION ALL

SELECT 'FORESTLAND'                     AS category,
       f.state_code                     AS state_cd,
       f.evaluation_group               AS evalidgrp,
       n.state_name,
       ROUND(f.forest_acres,4)          AS total_acres
FROM  top_forest f
LEFT JOIN state_names n USING (state_code);
