```sql
--Description:
-- Thinking process:
-- • Identify 2022 questions       → WHERE EXTRACT(YEAR FROM creation_date) = 2022
-- • Detect the exact “python” tag → REGEXP_CONTAINS(tags, r'(^|\|)python(\||$)')
--   (tags are pipe‑delimited, e.g. "python|pandas")
-- • Group by month                → DATE_TRUNC(DATE(creation_date), MONTH)
-- • Aggregate:
--     total   = COUNT(*)
--     python  = COUNTIF( REGEXP_CONTAINS(tags, r'(^|\|)python(\||$)') )
-- • Proportion = python / total   → SAFE_DIVIDE(...)
-- • Present month as YYYY‑MM and order chronologically
SELECT
  FORMAT_DATE('%Y-%m', DATE_TRUNC(DATE(creation_date), MONTH)) AS month,
  SAFE_DIVIDE(
    COUNTIF(REGEXP_CONTAINS(tags, r'(^|\|)python(\||$)')),
    COUNT(*)
  ) AS proportion_python
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE EXTRACT(YEAR FROM creation_date) = 2022
GROUP BY month
ORDER BY month;
```
