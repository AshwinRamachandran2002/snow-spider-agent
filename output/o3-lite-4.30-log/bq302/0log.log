--Description: Same calculation as above but groups by DATE objects (month_start) and uses COUNTIF for python tag detection.
WITH monthly AS (
  SELECT
    DATE_TRUNC(DATE(creation_date), MONTH) AS month_start,
    COUNT(*)                               AS total_q,
    COUNTIF(tags LIKE '%python%')          AS python_q
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  WHERE EXTRACT(YEAR FROM creation_date) = 2022
  GROUP BY month_start)
SELECT
  month_start,
  total_q,
  python_q,
  SAFE_DIVIDE(python_q, total_q) AS proportion_python
FROM monthly
ORDER BY month_start
LIMIT 20
