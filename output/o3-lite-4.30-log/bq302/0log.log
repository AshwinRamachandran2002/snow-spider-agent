Begin Exploring Related Columns
Relevant columns, potential usage & conditions
• `posts_questions.creation_date`: filter questions created in the 2022 calendar year and aggregate by month.  
• `posts_questions.tags`: detect whether the question is tagged ‘python’. On Stack Overflow this field is a lowercase string like “<python><pandas>…”.  Condition: `tags LIKE '%<python>%'`.  
• `posts_questions.id` (or any non‑null column): use COUNT(*) to obtain question totals.

Below are 10 progressively more sophisticated BigQuery SQL snippets (all limited to 20 rows except the last one) that let you examine the data and finally obtain the required monthly proportions.

```sql
-- 1. Peek at some 2022 questions and their tag strings
SELECT id, creation_date, tags
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE EXTRACT(YEAR FROM creation_date) = 2022
LIMIT 20;
```

```sql
-- 2. Inspect only questions that mention the python tag in 2022
SELECT id, creation_date, tags
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE EXTRACT(YEAR FROM creation_date) = 2022
  AND tags LIKE '%<python>%'
LIMIT 20;
```

```sql
-- 3. Count total number of questions asked in all of 2022
SELECT COUNT(*) AS total_questions_2022
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE EXTRACT(YEAR FROM creation_date) = 2022;
```

```sql
-- 4. Count total number of python‑tagged questions in 2022
SELECT COUNT(*) AS python_questions_2022
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE EXTRACT(YEAR FROM creation_date) = 2022
  AND tags LIKE '%<python>%';
```

```sql
-- 5. Monthly totals (all tags) for 2022
SELECT
  FORMAT_DATE('%Y-%m', DATE(creation_date)) AS month,
  COUNT(*) AS total_questions
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE EXTRACT(YEAR FROM creation_date) = 2022
GROUP BY month
ORDER BY month
LIMIT 20;
```

```sql
-- 6. Monthly totals for python‑tagged questions in 2022
SELECT
  FORMAT_DATE('%Y-%m', DATE(creation_date)) AS month,
  COUNT(*) AS python_questions
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE EXTRACT(YEAR FROM creation_date) = 2022
  AND tags LIKE '%<python>%'
GROUP BY month
ORDER BY month
LIMIT 20;
```

```sql
-- 7. Join the two monthly aggregations to place totals side‑by‑side
WITH
  all_q AS (
    SELECT FORMAT_DATE('%Y-%m', DATE(creation_date)) AS month,
           COUNT(*) AS total_q
    FROM `bigquery-public-data.stackoverflow.posts_questions`
    WHERE EXTRACT(YEAR FROM creation_date) = 2022
    GROUP BY month),
  py_q AS (
    SELECT FORMAT_DATE('%Y-%m', DATE(creation_date)) AS month,
           COUNT(*) AS python_q
    FROM `bigquery-public-data.stackoverflow.posts_questions`
    WHERE EXTRACT(YEAR FROM creation_date) = 2022
      AND tags LIKE '%<python>%'
    GROUP BY month)
SELECT
  a.month,
  a.total_q,
  IFNULL(p.python_q,0) AS python_q
FROM all_q a
LEFT JOIN py_q p USING (month)
ORDER BY month
LIMIT 20;
```

```sql
-- 8. Add proportion column (python_q / total_q)
WITH
  all_q AS (
    SELECT FORMAT_DATE('%Y-%m', DATE(creation_date)) AS month,
           COUNT(*) AS total_q
    FROM `bigquery-public-data.stackoverflow.posts_questions`
    WHERE EXTRACT(YEAR FROM creation_date) = 2022
    GROUP BY month),
  py_q AS (
    SELECT FORMAT_DATE('%Y-%m', DATE(creation_date)) AS month,
           COUNT(*) AS python_q
    FROM `bigquery-public-data.stackoverflow.posts_questions`
    WHERE EXTRACT(YEAR FROM creation_date) = 2022
      AND tags LIKE '%<python>%'
    GROUP BY month)
SELECT
  a.month,
  a.total_q,
  p.python_q,
  SAFE_DIVIDE(p.python_q, a.total_q) AS proportion_python
FROM all_q a
LEFT JOIN py_q p USING (month)
ORDER BY month
LIMIT 20;
```

```sql
-- 9. Same calculation but casts month to DATE for easier sorting / charting
WITH monthly AS (
  SELECT
    DATE_TRUNC(DATE(creation_date), MONTH) AS month_start,
    COUNT(*) AS total_q,
    COUNTIF(tags LIKE '%<python>%') AS python_q
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  WHERE EXTRACT(YEAR FROM creation_date) = 2022
  GROUP BY month_start)
SELECT
  month_start,
  total_q,
  python_q,
  SAFE_DIVIDE(python_q, total_q) AS proportion_python
FROM monthly
ORDER BY month_start
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: monthly proportion of 2022 Stack Overflow questions tagged with 'python'
SELECT
  FORMAT_DATE('%Y-%m', month_start)                AS month,
  total_q,
  python_q,
  ROUND(SAFE_DIVIDE(python_q, total_q), 4) AS proportion_python
FROM (
  SELECT
    DATE_TRUNC(DATE(creation_date), MONTH) AS month_start,
    COUNT(*)                                AS total_q,
    COUNTIF(tags LIKE '%<python>%')         AS python_q
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  WHERE EXTRACT(YEAR FROM creation_date) = 2022
  GROUP BY month_start)
ORDER BY month_start;
```

The last query returns, for each month in 2022, (a) the total questions, (b) how many of those contain the `<python>` tag, and (c) the proportion of python‑tagged questions out of the monthly total.
