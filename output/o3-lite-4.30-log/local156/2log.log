       ON ry."region" = f."region"
  WHERE ry."txn_year" > f."first_year"
)
SELECT "txn_year",
       "region",
       "avg_price_usd",
       RANK() OVER (PARTITION BY "txn_year" ORDER BY "avg_price_usd" DESC) AS "price_rank"
FROM   filtered
ORDER BY "txn_year", "price_rank"
LIMIT 20;
