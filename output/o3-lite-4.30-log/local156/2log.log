Begin Exploring Related Columns
Relevant columns, their potential usage, and some obvious filtering conditions  

bitcoin_transactions  
• ticker : select only ‘BTC’ records  
• txn_type : keep only ‘BUY’ rows (i.e. BTC purchased)  
• txn_date : derive calendar year with substr(txn_date,-4) AS txn_year  
• quantity : number of BTC bought; denominator in avg‑price calculation  
• member_id : join key to bitcoin_members  

bitcoin_members  
• member_id : join key to bitcoin_transactions  
• region : geographic region used in grouping/ranking  

bitcoin_prices  
• ticker : join key to bitcoin_transactions (keep ‘BTC’)  
• market_date : join to txn_date (same dd‑mm‑yyyy format) to fetch the price on the purchase day  
• price : USD price per BTC; multiply by quantity to get dollar amount spent  

Typical conditions  
• bt."ticker" = 'BTC'  
• bt."txn_type" = 'BUY'  
• bp."ticker" = 'BTC'  
• bt."txn_date" = bp."market_date"            -- date match for price lookup  
• CAST(substr(bt."txn_date",‑4) AS INTEGER) > (SELECT MIN(...) …)   -- skip each region’s first year  

────────────────────────────  
Exploratory → increasingly complex SQLs (all limited to 20 rows)  
────────────────────────────  

```sql
-- 1. Distinct tickers traded
SELECT DISTINCT "ticker"
FROM "bitcoin_transactions"
LIMIT 20;
```

```sql
-- 2. Sample purchase transactions for BTC only
SELECT "txn_id",
       "member_id",
       "txn_date",
       "quantity"
FROM "bitcoin_transactions"
WHERE "ticker" = 'BTC'
  AND "txn_type" = 'BUY'
LIMIT 20;
```

```sql
-- 3. List the years in which BTC purchases occurred
SELECT DISTINCT CAST(substr("txn_date", -4) AS INTEGER) AS "txn_year"
FROM "bitcoin_transactions"
WHERE "ticker" = 'BTC'
  AND "txn_type" = 'BUY'
ORDER BY "txn_year"
LIMIT 20;
```

```sql
-- 4. Join purchases to members to see which regions are active
SELECT bt."member_id",
       bm."region",
       bt."txn_date",
       bt."quantity"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_members"      AS bm
       ON bt."member_id" = bm."member_id"
WHERE  bt."ticker" = 'BTC'
  AND  bt."txn_type" = 'BUY'
LIMIT 20;
```

```sql
-- 5. Match each BTC purchase with its daily market price
SELECT bt."txn_id",
       bt."txn_date",
       bp."price"          AS "price_usd",
       bt."quantity",
       (bt."quantity" * bp."price") AS "amount_spent"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_prices"       AS bp
       ON  bt."ticker"      = bp."ticker"
       AND bt."txn_date"    = bp."market_date"
WHERE  bt."ticker" = 'BTC'
  AND  bt."txn_type" = 'BUY'
LIMIT 20;
```

```sql
-- 6. Yearly totals of quantity & amount spent by region
SELECT bm."region",
       CAST(substr(bt."txn_date", -4) AS INTEGER) AS "txn_year",
       SUM(bt."quantity" * bp."price") AS "total_spent",
       SUM(bt."quantity")              AS "total_qty"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_members"      AS bm
       ON bt."member_id" = bm."member_id"
JOIN   "bitcoin_prices"       AS bp
       ON bt."ticker" = bp."ticker"
      AND bt."txn_date" = bp."market_date"
WHERE  bt."ticker" = 'BTC'
  AND  bt."txn_type" = 'BUY'
GROUP BY bm."region", "txn_year"
LIMIT 20;
```

```sql
-- 7. Compute annual average purchase price per BTC by region
SELECT bm."region",
       CAST(substr(bt."txn_date", -4) AS INTEGER) AS "txn_year",
       SUM(bt."quantity" * bp."price") / SUM(bt."quantity") AS "avg_price_usd"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_members"      AS bm  ON bt."member_id" = bm."member_id"
JOIN   "bitcoin_prices"       AS bp  ON bt."ticker" = bp."ticker"
                                    AND bt."txn_date" = bp."market_date"
WHERE  bt."ticker" = 'BTC'
  AND  bt."txn_type" = 'BUY'
GROUP BY bm."region", "txn_year"
ORDER BY bm."region", "txn_year"
LIMIT 20;
```

```sql
-- 8. Remove each region’s first year of data
WITH region_years AS (
  SELECT bm."region",
         CAST(substr(bt."txn_date", -4) AS INTEGER) AS "txn_year",
         SUM(bt."quantity" * bp."price") / SUM(bt."quantity") AS "avg_price_usd"
  FROM   "bitcoin_transactions" AS bt
  JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
  JOIN   "bitcoin_prices"       AS bp ON bt."ticker" = bp."ticker"
                                     AND bt."txn_date" = bp."market_date"
  WHERE  bt."ticker" = 'BTC'
    AND  bt."txn_type" = 'BUY'
  GROUP BY bm."region", "txn_year"
),
filtered AS (
  SELECT ry.*
  FROM   region_years AS ry
  JOIN  (SELECT "region", MIN("txn_year") AS "first_year"
         FROM region_years
         GROUP BY "region") AS f
       ON ry."region" = f."region"
  WHERE ry."txn_year" > f."first_year"
)
SELECT *
FROM   filtered
LIMIT 20;
```

```sql
-- 9. Rank regions by average price within each year
WITH region_years AS (
  SELECT bm."region",
         CAST(substr(bt."txn_date", -4) AS INTEGER) AS "txn_year",
         SUM(bt."quantity" * bp."price") / SUM(bt."quantity") AS "avg_price_usd"
  FROM   "bitcoin_transactions" AS bt
  JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
  JOIN   "bitcoin_prices"       AS bp ON bt."ticker" = bp."ticker"
                                     AND bt."txn_date" = bp."market_date"
  WHERE  bt."ticker" = 'BTC'
    AND  bt."txn_type" = 'BUY'
  GROUP BY bm."region", "txn_year"
),
filtered AS (
  SELECT ry.*
  FROM   region_years AS ry
  JOIN  (SELECT "region", MIN("txn_year") AS "first_year"
         FROM region_years
         GROUP BY "region") AS f
       ON ry."region" = f."region"
  WHERE ry."txn_year" > f."first_year"
)
SELECT "txn_year",
       "region",
       "avg_price_usd",
       RANK() OVER (PARTITION BY "txn_year" ORDER BY "avg_price_usd" DESC) AS "price_rank"
FROM   filtered
ORDER BY "txn_year", "price_rank"
LIMIT 20;
```

```sql
-- 10. Final answer:  ► average cost, rank per year, and YoY % change for each region
WITH region_years AS (
  SELECT bm."region",
         CAST(substr(bt."txn_date", -4) AS INTEGER) AS "txn_year",
         SUM(bt."quantity" * bp."price") / SUM(bt."quantity") AS "avg_price_usd"
  FROM   "bitcoin_transactions" AS bt
  JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
  JOIN   "bitcoin_prices"       AS bp ON bt."ticker" = bp."ticker"
                                     AND bt."txn_date" = bp."market_date"
  WHERE  bt."ticker" = 'BTC'
    AND  bt."txn_type" = 'BUY'
  GROUP BY bm."region", "txn_year"
),
filtered AS (
  SELECT ry.*
  FROM   region_years AS ry
  JOIN  (SELECT "region", MIN("txn_year") AS "first_year"
         FROM region_years
         GROUP BY "region") AS f
       ON ry."region" = f."region"
  WHERE ry."txn_year" > f."first_year"
),
ranked AS (
  SELECT *,
         RANK() OVER (PARTITION BY "txn_year"
                      ORDER BY "avg_price_usd" DESC) AS "price_rank",
         LAG("avg_price_usd") OVER (PARTITION BY "region"
                                    ORDER BY "txn_year") AS "prev_year_price"
  FROM   filtered
)
SELECT "txn_year",
       "region",
       ROUND("avg_price_usd",2)          AS "avg_price_usd",
       "price_rank",
       ROUND( ( ("avg_price_usd" - "prev_year_price") / "prev_year_price") * 100, 2 ) 
            AS "pct_change_vs_prev_year"
FROM   ranked
ORDER BY "txn_year", "price_rank"
LIMIT 20;
```

