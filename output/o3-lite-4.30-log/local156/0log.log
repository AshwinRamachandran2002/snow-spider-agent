```sql
--Description / thinking process:
-- 1) Keep only BTC BUY transactions, join to members (for region) and daily prices (for USD cost).
-- 2) Aggregate to region‑year and compute avg_price = ∑(qty*price)/∑qty.
-- 3) With window functions, for every year rank regions by avg_price (highest = 1)
--    and fetch each region’s previous‑year avg_price (LAG).
-- 4) Discard the first year per region (where LAG is NULL) and calculate
--    pct_change = (avg_price‑prev) / prev * 100.
-- 5) Return region, year, avg_price, rank, pct_change ordered by year & rank.

WITH yearly AS (
    SELECT
        bm.region                                                          AS region,
        substr(bt.txn_date, -4)                                            AS year,
        SUM(bt.quantity * bp.price) * 1.0 / SUM(bt.quantity)               AS avg_price
    FROM   bitcoin_transactions AS bt
    JOIN   bitcoin_members      AS bm ON bt.member_id = bm.member_id
    JOIN   bitcoin_prices       AS bp ON bt.ticker = bp.ticker
                                     AND bt.txn_date = bp.market_date
    WHERE  bt.ticker   = 'BTC'
      AND  bt.txn_type = 'BUY'
    GROUP  BY bm.region, substr(bt.txn_date, -4)
),
ranked AS (
    SELECT
        region,
        year,
        avg_price,
        RANK() OVER (PARTITION BY year   ORDER BY avg_price DESC) AS region_rank,
        LAG(avg_price) OVER (PARTITION BY region ORDER BY year)   AS prev_avg_price
    FROM yearly
),
final AS (
    SELECT
        region,
        year,
        avg_price,
        region_rank,
        ROUND((avg_price - prev_avg_price) * 100.0 / prev_avg_price, 2) AS pct_change
    FROM ranked
    WHERE prev_avg_price IS NOT NULL              -- exclude each region's first year
)
SELECT *
FROM   final
ORDER BY year, region_rank;
```
