Query:
-- 8. Compute the annual average purchase price (total_spent / total_qty) for each region‑year
WITH yearly AS (
  SELECT bm."region"                      AS region,
         substr(bt."txn_date", -4)        AS year,
         SUM(bt."quantity" * bp."price")  / SUM(bt."quantity") AS avg_price
  FROM   "bitcoin_transactions" AS bt
  JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
  JOIN   "bitcoin_prices"       AS bp ON bt."ticker" = bp."ticker"
                                   AND bt."txn_date" = bp."market_date"
  WHERE  bt."ticker"   = 'BTC'
    AND  bt."txn_type" = 'BUY'
  GROUP  BY bm."region", substr(bt."txn_date", -4)
)
SELECT *
FROM   yearly
LIMIT 20;
