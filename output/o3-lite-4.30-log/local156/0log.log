    JOIN "bitcoin_prices"   bp ON bt."ticker" = bp."ticker"
                              AND bt."txn_date" = bp."market_date"
    WHERE bt."ticker" = 'BTC'
      AND bt."txn_type" = 'BUY'
    GROUP BY bm."region", CAST(SUBSTR(bt."txn_date", -4) AS INTEGER)
),
with_prev AS (
    SELECT
        region,
        year,
        avg_price,
        LAG(avg_price) OVER (PARTITION BY region ORDER BY year) AS prev_avg
