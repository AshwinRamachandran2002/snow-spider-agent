Begin Exploring Related Columns
Relevant columns and how they will be used  
• bitcoin_transactions.txn_type : filter to ‘BUY’ only  
• bitcoin_transactions.ticker   : filter to ‘BTC’ only  
• bitcoin_transactions.txn_date : derive calendar year (substr(txn_date,7,4)) and match to bitcoin_prices.market_date  
• bitcoin_transactions.quantity : number of BTC purchased – will be summed for each region‑year  
• bitcoin_transactions.member_id: joins to bitcoin_members.member_id to fetch the purchaser’s region  
• bitcoin_prices.market_date    : join on the same calendar date as txn_date  
• bitcoin_prices.ticker         : keep only ‘BTC’ (or simply use the join key)  
• bitcoin_prices.price          : USD price per 1 BTC on each day – multiplied by quantity to obtain dollar amount spent  
• bitcoin_members.region        : purchaser’s home region – analysis is done at this level  

Typical filter conditions  
• bitcoin_transactions.ticker = 'BTC'  
• bitcoin_transactions.txn_type = 'BUY'  
• bitcoin_prices.ticker = 'BTC' (redundant if you only join matching ticker)  


Below are ten exploratory → complex SQLite queries (all limited to 20 rows) that progressively build toward the required answer.

```sql
-- 1. Distinct tickers available in the transactions table
SELECT DISTINCT "ticker"
FROM "bitcoin_transactions"
LIMIT 20;
```

```sql
-- 2. Distinct transaction types for BTC
SELECT DISTINCT "txn_type"
FROM "bitcoin_transactions"
WHERE "ticker" = 'BTC'
LIMIT 20;
```

```sql
-- 3. A quick glance at raw BTC purchase transactions
SELECT "txn_id",
       "member_id",
       "txn_date",
       "quantity",
       "percentage_fee"
FROM "bitcoin_transactions"
WHERE "ticker" = 'BTC'
  AND "txn_type" = 'BUY'
LIMIT 20;
```

```sql
-- 4. Verify member_id → region mapping
SELECT DISTINCT bm."member_id",
                bm."region"
FROM "bitcoin_members" AS bm
LIMIT 20;
```

```sql
-- 5. Peek at BTC market prices for a handful of dates
SELECT bp."market_date",
       bp."price"
FROM "bitcoin_prices" AS bp
WHERE bp."ticker" = 'BTC'
LIMIT 20;
```

```sql
-- 6. Join one day's purchases to its market price
SELECT bt."txn_id",
       bt."member_id",
       bt."quantity",
       bp."price",
       (bt."quantity" * bp."price") AS "dollar_spent"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_prices"       AS bp
       ON bt."txn_date"  = bp."market_date"
      AND bp."ticker"    = 'BTC'
WHERE  bt."ticker"      = 'BTC'
  AND  bt."txn_type"    = 'BUY'
LIMIT 20;
```

```sql
-- 7. Add region into the mix for a richer view
SELECT bt."txn_id",
       bm."region",
       bt."txn_date",
       bt."quantity",
       bp."price",
       (bt."quantity" * bp."price") AS "dollar_spent"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_members"      AS bm
       ON bt."member_id" = bm."member_id"
JOIN   "bitcoin_prices"       AS bp
       ON bt."txn_date" = bp."market_date"
WHERE  bt."ticker"   = 'BTC'
  AND  bt."txn_type" = 'BUY'
LIMIT 20;
```

```sql
-- 8. Aggregate to yearly totals per region
WITH tx AS (
  SELECT bm."region",
         substr(bt."txn_date",7,4) AS "year",
         SUM(bt."quantity")               AS "total_qty",
         SUM(bt."quantity" * bp."price")  AS "total_spent"
  FROM   "bitcoin_transactions" AS bt
  JOIN   "bitcoin_members"      AS bm  ON bt."member_id" = bm."member_id"
  JOIN   "bitcoin_prices"       AS bp  ON bt."txn_date"  = bp."market_date"
  WHERE  bt."ticker"   = 'BTC'
    AND  bt."txn_type" = 'BUY'
    AND  bp."ticker"   = 'BTC'
  GROUP BY bm."region", substr(bt."txn_date",7,4)
)
SELECT "region",
       "year",
       "total_qty",
       "total_spent",
       ROUND("total_spent" / "total_qty", 2) AS "avg_price_usd"
FROM   tx
LIMIT 20;
```

```sql
-- 9. Add a row_number per region to identify and later drop the first year
WITH yearly AS (
  SELECT bm."region",
         substr(bt."txn_date",7,4) AS "year",
         SUM(bt."quantity")              AS "total_qty",
         SUM(bt."quantity" * bp."price") AS "total_spent",
         ROW_NUMBER() OVER (PARTITION BY bm."region" ORDER BY substr(bt."txn_date",7,4)) AS rn
  FROM   "bitcoin_transactions" AS bt
  JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
  JOIN   "bitcoin_prices"       AS bp ON bt."txn_date"  = bp."market_date"
  WHERE  bt."ticker"   = 'BTC'
    AND  bt."txn_type" = 'BUY'
    AND  bp."ticker"   = 'BTC'
  GROUP BY bm."region", substr(bt."txn_date",7,4)
)
SELECT "region",
       "year",
       ROUND("total_spent" / "total_qty", 2) AS "avg_price_usd"
FROM   yearly
WHERE  rn > 1      -- exclude the first year per region
LIMIT 20;
```

```sql
-- 10. Final answer: yearly regional ranking + YoY % change, first year per region removed
WITH yearly AS (
  SELECT bm."region",
         substr(bt."txn_date",7,4) AS "year",
         SUM(bt."quantity")              AS "total_qty",
         SUM(bt."quantity" * bp."price") AS "total_spent"
  FROM   "bitcoin_transactions" AS bt
  JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
  JOIN   "bitcoin_prices"       AS bp ON bt."txn_date"  = bp."market_date"
  WHERE  bt."ticker"   = 'BTC'
    AND  bt."txn_type" = 'BUY'
    AND  bp."ticker"   = 'BTC'
  GROUP BY bm."region", substr(bt."txn_date",7,4)
),
calc AS (
  SELECT region,
         year,
         ROUND(total_spent / total_qty, 2) AS avg_price_usd,
         ROW_NUMBER() OVER (PARTITION BY region ORDER BY year)                        AS rn,
         LAG(ROUND(total_spent / total_qty, 2)) OVER (PARTITION BY region ORDER BY year) AS prev_avg
  FROM   yearly
)
SELECT region,
       year,
       avg_price_usd,
       RANK() OVER (PARTITION BY year ORDER BY avg_price_usd DESC)  AS region_rank,
       ROUND( (avg_price_usd - prev_avg) * 100.0 / prev_avg , 2)    AS pct_change_vs_last_year
FROM   calc
WHERE  rn > 1     -- drop the first year for each region
ORDER BY year, region_rank
LIMIT 20;
```

These ten queries move from basic data inspection all the way to the required regional ranking and year‑over‑year cost change, while always limiting results to 20 rows for quick, safe exploration.
