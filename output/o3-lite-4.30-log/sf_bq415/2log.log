--Query 9 – Description: attach population metadata from the sample‑info table.
WITH hom_ref AS (
    SELECT f.value:"name"::STRING AS "sample_name",
           COUNT(*)               AS "hom_ref_positions"
    FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_VARIANTS_20150220" v,
         LATERAL FLATTEN(input => v."call") f
    WHERE ARRAY_SIZE(v."alternate_bases") = 1
      AND f.value:"genotype"[0]::NUMBER = 0
      AND f.value:"genotype"[1]::NUMBER = 0
    GROUP BY f.value:"name"::STRING
)
SELECT h."sample_name",
       h."hom_ref_positions",
       s."Population",
       s."Super_Population"
FROM hom_ref h
LEFT JOIN "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_SAMPLE_INFO" s
       ON s."Sample" = h."sample_name"
ORDER BY h."hom_ref_positions" DESC
LIMIT 20;
