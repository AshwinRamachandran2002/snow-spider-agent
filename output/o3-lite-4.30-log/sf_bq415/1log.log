```sql
--Description:  We want the 10 samples that exhibit the greatest number of loci where
--              (A) there is exactly ONE alternate allele recorded for the site and
--              (B) the sample’s genotype is homozygous reference (0/0). 
--              Logic:
--              1.  Use the Phase‑3 variants table (alias v).  Each row = one genomic site.
--              2.  Keep only sites whose "alternate_bases" JSON array has length 1
--                  (ARRAY_SIZE(v."alternate_bases") = 1).
--              3.  Flatten the "call" JSON array so each element (alias c) gives us
--                  a single sample’s information at that site.
--              4.  Retain rows where c.value:"genotype"[0] = 0 AND c.value:"genotype"[1] = 0
--                  (homozygous reference).
--              5.  Aggregate COUNT(*) per sample to tally qualifying loci.
--              6.  Order by the tally descending and keep the top 10.
--              7.  LEFT JOIN to the sample‑info table so we can show Population and
--                  Super_Population labels alongside the counts.
WITH per_sample AS (
    SELECT
        c.value:"name"::STRING AS "sample",
        COUNT(*)               AS hom_ref_single_alt_sites
    FROM HUMAN_GENOME_VARIANTS.HUMAN_GENOME_VARIANTS."_1000_GENOMES_PHASE_3_VARIANTS_20150220" v,
         LATERAL FLATTEN(input => v."call") c
    WHERE ARRAY_SIZE(v."alternate_bases") = 1           -- one ALT allele only
      AND c.value:"genotype"[0]::INT = 0                -- ref allele #1
      AND c.value:"genotype"[1]::INT = 0                -- ref allele #2
    GROUP BY 1
)
SELECT
    p."sample",
    p.hom_ref_single_alt_sites,
    si."Population",
    si."Super_Population"
FROM per_sample p
LEFT JOIN HUMAN_GENOME_VARIANTS.HUMAN_GENOME_VARIANTS."_1000_GENOMES_SAMPLE_INFO" si
       ON p."sample" = si."Sample"
ORDER BY p.hom_ref_single_alt_sites DESC
LIMIT 10;
```
