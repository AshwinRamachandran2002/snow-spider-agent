{'HUMAN_GENOME_VARIANTS': {'HUMAN_GENOME_VARIANTS': ['_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220', '_1000_GENOMES_PHASE_3_VARIANTS_20150220', '_1000_GENOMES_SAMPLE_INFO', 'PLATINUM_GENOMES_DEEPVARIANT_VARIANTS_20180823', 'SIMONS_GENOME_DIVERSITY_PROJECT_SAMPLE_ATTRIBUTES', 'SIMONS_GENOME_DIVERSITY_PROJECT_SAMPLE_METADATA', 'SIMONS_GENOME_DIVERSITY_PROJECT_SAMPLE_VARIANTS', '_1000_GENOMES_PEDIGREE']}}
Begin Exploring Related Columns
Relevant columns and their potential usage  

• "alternate_bases": VARIANT → ARRAY that keeps every ALT allele for a position.  ARRAY_SIZE("alternate_bases") lets us know whether the record has exactly one alternate allele ( = 1 ).  
• "hom_ref_call": VARIANT → ARRAY of sample‑IDs whose genotype is homozygous reference (0/0) at that position.  By flattening this array we can list / count those samples.  
• "reference_name" , "start_position", "end_position" → locus information (optional filters).  
• "_1000_GENOMES_SAMPLE_INFO"."Sample", "Population", … → can be joined later to enrich results with sample meta data.  

Conditions that will be useful  

1.  ARRAY_SIZE("alternate_bases") = 1  → position has exactly one ALT allele.  
2.  FLATTEN(input => t."hom_ref_call")  → cursor of all samples that are hom‑ref at that position.  

Below are ten illustrative Snowflake SQL queries (each limited to 20 rows) that gradually explore the data and finally produce the required ranking.  
All identifiers are enclosed in double quotes.  

```sql
-- 1. Peek at a few rows to verify the overall structure
SELECT 
  "reference_name",
  "start_position",
  ARRAY_SIZE("alternate_bases")  AS "alt_count",
  ARRAY_SIZE("hom_ref_call")     AS "hom_ref_sample_count"
FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"
LIMIT 20;
```

```sql
-- 2. Inspect the contents of one ALT‑allele record after flattening “alternate_bases”
SELECT 
  t."reference_name",
  t."start_position",
  f.value                 AS "alt_record"
FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"  t,
     LATERAL FLATTEN(input => t."alternate_bases") f
LIMIT 20;
```

```sql
-- 3. Inspect the list of homozygous‑reference samples at a few positions
SELECT 
  t."reference_name",
  t."start_position",
  s.value::STRING         AS "sample_id"
FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"  t,
     LATERAL FLATTEN(input => t."hom_ref_call") s
LIMIT 20;
```

```sql
-- 4. Show homozygous‑reference samples only at sites that have EXACTLY one ALT allele
SELECT 
  t."reference_name",
  t."start_position",
  s.value::STRING AS "sample_id"
FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220" t,
     LATERAL FLATTEN(input => t."hom_ref_call") s
WHERE ARRAY_SIZE(t."alternate_bases") = 1
LIMIT 20;
```

```sql
-- 5. Count, for each sample, how many single‑ALT sites are homozygous reference
SELECT 
  s.value::STRING            AS "sample_id",
  COUNT(*)                   AS "hom_ref_single_alt_cnt"
FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220" t,
     LATERAL FLATTEN(input => t."hom_ref_call") s
WHERE ARRAY_SIZE(t."alternate_bases") = 1
GROUP BY s.value::STRING
LIMIT 20;
```

```sql
-- 6. Top 10 samples with the highest counts (core answer shape)
SELECT 
  s.value::STRING            AS "sample_id",
  COUNT(*)                   AS "hom_ref_single_alt_cnt"
FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220" t,
     LATERAL FLATTEN(input => t."hom_ref_call") s
WHERE ARRAY_SIZE(t."alternate_bases") = 1
GROUP BY s.value::STRING
ORDER BY "hom_ref_single_alt_cnt" DESC
LIMIT 10;
```

```sql
-- 7. Same as (6) but enriched with population information
SELECT 
  c."sample_id",
  c."hom_ref_single_alt_cnt",
  i."Population",
  i."Population_Description"
FROM (
      SELECT 
        s.value::STRING  AS "sample_id",
        COUNT(*)         AS "hom_ref_single_alt_cnt"
      FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220" t,
           LATERAL FLATTEN(input => t."hom_ref_call") s
      WHERE ARRAY_SIZE(t."alternate_bases") = 1
      GROUP BY s.value::STRING
) c
LEFT JOIN "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_SAMPLE_INFO" i
       ON c."sample_id" = i."Sample"
ORDER BY c."hom_ref_single_alt_cnt" DESC
LIMIT 10;
```

```sql
-- 8. List distinct samples that ever appear in “hom_ref_call”
SELECT DISTINCT
  s.value::STRING AS "sample_id"
FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220" t,
     LATERAL FLATTEN(input => t."hom_ref_call") s
LIMIT 20;
```

```sql
-- 9. Same computation as (6) expressed with CTEs for readability
WITH hom_ref_single_alt AS (
    SELECT s.value::STRING AS sample_id
    FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220" t,
         LATERAL FLATTEN(input => t."hom_ref_call") s
    WHERE ARRAY_SIZE(t."alternate_bases") = 1
)
SELECT sample_id,
       COUNT(*) AS hom_ref_single_alt_cnt
FROM hom_ref_single_alt
GROUP BY sample_id
ORDER BY hom_ref_single_alt_cnt DESC
LIMIT 20;
```

```sql
-- 10. Check how many loci in total have exactly one ALT allele (sanity statistic)
SELECT 
  COUNT(*) AS loci_with_single_alt
FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"
WHERE ARRAY_SIZE("alternate_bases") = 1
LIMIT 20;
```
