```sql
-- Query‑1: Quick peek at the three relevant columns
SELECT "StudyInstanceUID",
       "SegmentedPropertyTypeCodeSequence",
       "collection_id"
FROM IDC.IDC_V17.DICOM_PIVOT
LIMIT 20;
```

```sql
-- Query‑2: See how the SegmentedPropertyTypeCodeSequence values look in general
SELECT DISTINCT "SegmentedPropertyTypeCodeSequence"
FROM IDC.IDC_V17.DICOM_PIVOT
LIMIT 20;
```

```sql
-- Query‑3: Rows whose SegmentedPropertyTypeCodeSequence contains “15825003” (fuzzy match)
SELECT "StudyInstanceUID",
       "SegmentedPropertyTypeCodeSequence",
       "collection_id"
FROM IDC.IDC_V17.DICOM_PIVOT
WHERE "SegmentedPropertyTypeCodeSequence" ILIKE '%15825003%'
LIMIT 20;
```

```sql
-- Query‑4: Exactly the code “15825003”, case‑insensitive
SELECT "StudyInstanceUID",
       "SegmentedPropertyTypeCodeSequence",
       "collection_id"
FROM IDC.IDC_V17.DICOM_PIVOT
WHERE UPPER("SegmentedPropertyTypeCodeSequence") = '15825003'
LIMIT 20;
```

```sql
-- Query‑5: Same filter as above + restrict to the two required collections
SELECT "StudyInstanceUID",
       "SegmentedPropertyTypeCodeSequence",
       "collection_id"
FROM IDC.IDC_V17.DICOM_PIVOT
WHERE UPPER("SegmentedPropertyTypeCodeSequence") = '15825003'
  AND "collection_id" IN ('Community','nsclc_radiomics')
LIMIT 20;
```

```sql
-- Query‑6: Distinct StudyInstanceUIDs after applying both filters
SELECT DISTINCT "StudyInstanceUID"
FROM IDC.IDC_V17.DICOM_PIVOT
WHERE UPPER("SegmentedPropertyTypeCodeSequence") = '15825003'
  AND "collection_id" IN ('Community','nsclc_radiomics')
LIMIT 20;
```

```sql
-- Query‑7: Count of distinct StudyInstanceUIDs that satisfy both filters
SELECT COUNT(DISTINCT "StudyInstanceUID") AS "distinct_study_count"
FROM IDC.IDC_V17.DICOM_PIVOT
WHERE UPPER("SegmentedPropertyTypeCodeSequence") = '15825003'
  AND "collection_id" IN ('Community','nsclc_radiomics');
```

```sql
-- Query‑8: Show how many such studies exist per collection
SELECT "collection_id",
       COUNT(DISTINCT "StudyInstanceUID") AS "studies_per_collection"
FROM IDC.IDC_V17.DICOM_PIVOT
WHERE UPPER("SegmentedPropertyTypeCodeSequence") = '15825003'
  AND "collection_id" IN ('Community','nsclc_radiomics')
GROUP BY "collection_id";
```

```sql
-- Query‑9: Double‑check if there are multiple rows per study in the result set
SELECT "StudyInstanceUID",
       COUNT(*) AS "row_count_for_study"
FROM IDC.IDC_V17.DICOM_PIVOT
WHERE UPPER("SegmentedPropertyTypeCodeSequence") = '15825003'
  AND "collection_id" IN ('Community','nsclc_radiomics')
GROUP BY "StudyInstanceUID"
ORDER BY "row_count_for_study" DESC
LIMIT 20;
```

```sql
-- Query‑10: Full details for one sample study that matches all criteria
SELECT *
FROM IDC.IDC_V17.DICOM_PIVOT
WHERE UPPER("SegmentedPropertyTypeCodeSequence") = '15825003'
  AND "collection_id" IN ('Community','nsclc_radiomics')
  AND "StudyInstanceUID" = (
        SELECT DISTINCT "StudyInstanceUID"
        FROM IDC.IDC_V17.DICOM_PIVOT
        WHERE UPPER("SegmentedPropertyTypeCodeSequence") = '15825003'
          AND "collection_id" IN ('Community','nsclc_radiomics')
        LIMIT 1
      )
LIMIT 20;
```
