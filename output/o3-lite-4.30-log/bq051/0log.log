Ten exploratory → final queries (each limited to 20 rows where applicable)  
---------------------------------------------------------------------------  

```sql
-- 1. Quick look at raw Citi Bike trips
SELECT *
FROM `bigquery-public-data.new_york.citibike_trips`
LIMIT 20;
```

```sql
-- 2. Distinct years of Citi Bike data (check that 2016 exists)
SELECT DISTINCT EXTRACT(YEAR FROM starttime) AS yr
FROM `bigquery-public-data.new_york.citibike_trips`
ORDER BY yr;
```

```sql
-- 3. Number of Citi Bike trips per day in 2016 (sample 20 days)
SELECT
  DATE(starttime) AS ride_day,
  COUNT(*)        AS trips
FROM `bigquery-public-data.new_york.citibike_trips`
WHERE EXTRACT(YEAR FROM starttime) = 2016
GROUP BY ride_day
ORDER BY ride_day
LIMIT 20;
```

```sql
-- 4. All GHCN stations within 50 km of NYC’s coordinates (preview)
SELECT
  id,
  name,
  latitude,
  longitude,
  ST_DISTANCE(
      ST_GEOGPOINT(longitude, latitude),
      ST_GEOGPOINT(-74.0060, 40.7128)
  ) AS distance_m
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE ST_DISTANCE(
        ST_GEOGPOINT(longitude, latitude),
        ST_GEOGPOINT(-74.0060, 40.7128)
      ) <= 50000   -- 50 km
ORDER BY distance_m
LIMIT 20;
```

```sql
-- 5. Pick the single nearest valid station (should return 1 row)
SELECT
  id,
  name,
  latitude,
  longitude,
  ST_DISTANCE(
      ST_GEOGPOINT(longitude, latitude),
      ST_GEOGPOINT(-74.0060, 40.7128)
  ) AS distance_m
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
ORDER BY distance_m
LIMIT 1;
```

```sql
-- 6. Raw 2016 precipitation records for that station (replace <STATION_ID>)
SELECT *
FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
WHERE id = '<STATION_ID>'
  AND element = 'PRCP'
  AND qflag IS NULL
LIMIT 20;
```

```sql
-- 7. Daily total precipitation (mm) for the chosen station (sample 20 days)
SELECT
  date,
  SUM(value)/10.0 AS prcp_mm          -- raw value is in 0.1 mm
FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
WHERE id = '<STATION_ID>'
  AND element = 'PRCP'
  AND qflag IS NULL
GROUP BY date
ORDER BY date
LIMIT 20;
```

```sql
-- 8. Mark each day as rainy (>5 mm) or non‑rainy (sample 20)
WITH daily_prcp AS (
  SELECT
    date,
    SUM(value)/10.0 AS prcp_mm
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id = '<STATION_ID>'
    AND element = 'PRCP'
    AND qflag IS NULL
  GROUP BY date
)
SELECT
  date,
  prcp_mm,
  CASE WHEN prcp_mm > 5.0 THEN 'rainy' ELSE 'non_rainy' END AS rain_flag
FROM daily_prcp
ORDER BY date
LIMIT 20;
```

```sql
-- 9. Daily Citi Bike trip counts in 2016 (sample 20)
SELECT
  DATE(starttime) AS ride_day,
  COUNT(*)        AS trips
FROM `bigquery-public-data.new_york.citibike_trips`
WHERE EXTRACT(YEAR FROM starttime) = 2016
GROUP BY ride_day
ORDER BY ride_day
LIMIT 20;
```

```sql
-- 10. FINAL: Average daily trips on rainy vs non‑rainy days
WITH daily_prcp AS (
  SELECT
    date,
    SUM(value)/10.0 AS prcp_mm
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id = '<STATION_ID>'
    AND element = 'PRCP'
    AND qflag IS NULL
  GROUP BY date
),
rain_flags AS (
  SELECT
    date,
    CASE WHEN prcp_mm > 5.0 THEN 'rainy' ELSE 'non_rainy' END AS rain_flag
  FROM daily_prcp
),
daily_citibike AS (
  SELECT
    DATE(starttime) AS ride_day,
    COUNT(*)        AS trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime) = 2016
  GROUP BY ride_day
)
SELECT
  rf.rain_flag,
  AVG(dc.trips) AS avg_daily_trips
FROM rain_flags rf
JOIN daily_citibike dc
  ON rf.date = dc.ride_day
GROUP BY rf.rain_flag;
```

The tenth query produces the required comparison: the average number of Citi Bike trips per day in 2016 for “rainy” (> 5 mm precipitation) versus “non‑rainy” days, using data from the single closest GHCN station that lies within 50 km of downtown New York City and contains only valid, un‑flagged measurements.
