    id,
    COUNTIF(element = 'PRCP' AND qflag IS NULL) AS prcp_rows
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  GROUP BY id
),
best_station AS (
  SELECT n.id
  FROM nyc_nearby n
  JOIN daily_counts d ON n.id = d.id
  WHERE d.prcp_rows > 0
  ORDER BY d.prcp_rows DESC, n.distance_m ASC
  LIMIT 1
),
daily_prcp AS (
