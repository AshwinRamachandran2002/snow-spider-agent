--Description:  Among all GHCN stations located within 50 km of New York City,
--              find the one that reports the greatest number of quality‑checked
--              precipitation observations (element = PRCP, qflag IS NULL) during
--              calendar‑year 2016.  The query joins the 2016 daily table with
--              the stations catalogue, filters by distance, counts valid rows
--              per station, orders by descending day‑count then ascending
--              distance, and returns the best candidate plus a few runners‑up.
WITH nyc_nearby AS (
  SELECT
    s.id,
    s.name,
    ST_DISTANCE(
        ST_GEOGPOINT(s.longitude, s.latitude),
        ST_GEOGPOINT(-74.0060, 40.7128)
    ) AS distance_m
  FROM `bigquery-public-data.ghcn_d.ghcnd_stations` AS s
  WHERE s.longitude IS NOT NULL
    AND s.latitude  IS NOT NULL
    AND ST_DISTANCE(
          ST_GEOGPOINT(s.longitude, s.latitude),
          ST_GEOGPOINT(-74.0060, 40.7128)
        ) <= 50000      -- within 50 km of NYC
),
daily_2016 AS (
  SELECT
    id,
    COUNTIF(element = 'PRCP' AND qflag IS NULL) AS prcp_rows
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  GROUP BY id
)
SELECT
  n.id,
  n.name,
  ROUND(n.distance_m) AS distance_m,
  d.prcp_rows         AS valid_prcp_records_2016
FROM nyc_nearby AS n
JOIN daily_2016 AS d
  ON n.id = d.id
WHERE d.prcp_rows > 0
ORDER BY d.prcp_rows DESC, n.distance_m ASC
LIMIT 10;
