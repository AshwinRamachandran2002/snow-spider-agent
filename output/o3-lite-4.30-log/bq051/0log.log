```sql
--Description:  (A) Pick, automatically, the single GHCN station ≤ 50 km from
--              NYC that has the most valid precipitation (PRCP) rows in 2016,
--              then (B) compute that station’s daily precipitation totals for
--              2016 and label each day as rainy (> 5 mm) or non‑rainy.
WITH nyc_nearby AS (                       -- stations within 50 km of NYC
  SELECT
    s.id,
    ST_DISTANCE(ST_GEOGPOINT(s.longitude, s.latitude),
                ST_GEOGPOINT(-74.0060, 40.7128)) AS distance_m
  FROM `bigquery-public-data.ghcn_d.ghcnd_stations` AS s
  WHERE s.longitude IS NOT NULL
    AND s.latitude  IS NOT NULL
    AND ST_DISTANCE(ST_GEOGPOINT(s.longitude, s.latitude),
                    ST_GEOGPOINT(-74.0060, 40.7128)) <= 50000
),
daily_counts AS (                          -- how many good PRCP rows in 2016?
  SELECT
    id,
    COUNTIF(element = 'PRCP' AND qflag IS NULL) AS prcp_rows
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  GROUP BY id
),
best_station AS (                          -- choose the best nearby station
  SELECT n.id
  FROM nyc_nearby n
  JOIN daily_counts d ON n.id = d.id
  WHERE d.prcp_rows > 0
  ORDER BY d.prcp_rows DESC, n.distance_m ASC
  LIMIT 1
),
daily_prcp AS (                            -- compute daily totals for that id
  SELECT
    date,
    SUM(value) / 10.0 AS prcp_mm
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  CROSS JOIN best_station                     -- pulls best station id
  WHERE id = best_station.id
    AND element = 'PRCP'
    AND qflag  IS NULL
  GROUP BY date
)
SELECT
  date,
  prcp_mm,
  CASE WHEN prcp_mm > 5.0 THEN 'rainy' ELSE 'non_rainy' END AS rain_flag
FROM daily_prcp
ORDER BY date
LIMIT 20;
```

