Query:
--Description:  Re‑create the rainy‑vs‑non‑rainy comparison using the automatically
--              selected “best” precipitation station (most valid PRCP rows in
--              2016 within 50 km of NYC).  The ambiguity in the previous query
--              is eliminated by explicitly joining the 2016 daily table (alias d)
--              to the one‑row best_station CTE (alias bs) on d.id = bs.id.
WITH nyc_nearby AS (                 -- stations within 50 km of NYC
  SELECT
    s.id,
    ST_DISTANCE(
      ST_GEOGPOINT(s.longitude, s.latitude),
      ST_GEOGPOINT(-74.0060, 40.7128)
    ) AS distance_m
  FROM `bigquery-public-data.ghcn_d.ghcnd_stations` AS s
  WHERE s.longitude IS NOT NULL
    AND s.latitude  IS NOT NULL
    AND ST_DISTANCE(
          ST_GEOGPOINT(s.longitude, s.latitude),
          ST_GEOGPOINT(-74.0060, 40.7128)
        ) <= 50000
),
daily_counts AS (                    -- count valid PRCP rows in 2016
  SELECT
    id,
    COUNTIF(element = 'PRCP' AND qflag IS NULL) AS prcp_rows
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  GROUP BY id
),
best_station AS (                    -- select the best nearby station
  SELECT n.id
  FROM nyc_nearby n
  JOIN daily_counts d ON n.id = d.id
  ORDER BY d.prcp_rows DESC, n.distance_m ASC
  LIMIT 1
),
daily_prcp AS (                      -- daily precip totals for the best station
  SELECT
    d.date,
    SUM(d.value) / 10.0 AS prcp_mm
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016` AS d
  JOIN best_station bs
    ON d.id = bs.id
  WHERE d.element = 'PRCP'
    AND d.qflag  IS NULL
  GROUP BY d.date
),
rain_flags AS (                      -- classify each day as rainy / non‑rainy
  SELECT
    date,
    CASE WHEN prcp_mm > 5.0 THEN 'rainy' ELSE 'non_rainy' END AS rain_flag
  FROM daily_prcp
),
daily_citibike AS (                  -- Citi Bike trips per day in 2016
  SELECT
    DATE(starttime) AS ride_day,
    COUNT(*)        AS trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime) = 2016
  GROUP BY ride_day
)
SELECT
  rf.rain_flag,
  AVG(dc.trips) AS avg_daily_trips
FROM rain_flags rf
JOIN daily_citibike dc
  ON rf.date = dc.ride_day
GROUP BY rf.rain_flag
