WITH
-- reference point for NYC
nyc AS (
  SELECT ST_GEOGPOINT(-74.0060, 40.7128) AS geom
),

-- stations within 50 km of NYC
nearby_stations AS (
  SELECT
    s.id,
    ST_DISTANCE(ST_GEOGPOINT(s.longitude, s.latitude),
                (SELECT geom FROM nyc)) AS distance_m
  FROM `bigquery-public-data.ghcn_d.ghcnd_stations` AS s
  WHERE s.longitude IS NOT NULL
    AND s.latitude  IS NOT NULL
    AND ST_DISTANCE(ST_GEOGPOINT(s.longitude, s.latitude),
                    (SELECT geom FROM nyc)) <= 50000
),

-- how many VALID precipitation rows each nearby station has in 2016
station_quality AS (
  SELECT
    d.id,
    COUNTIF(d.element = 'PRCP' AND d.qflag IS NULL) AS valid_prcp_rows
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016` AS d
  GROUP BY d.id
),

-- choose the single “best” station: most valid rows, then closest
best_station AS (
  SELECT n.id
  FROM nearby_stations n
  JOIN station_quality q USING (id)
  ORDER BY q.valid_prcp_rows DESC, n.distance_m ASC
  LIMIT 1
),

-- daily precipitation (mm) for the chosen station
daily_precip AS (
  SELECT
    d.date,
    SUM(d.value) / 10.0 AS prcp_mm       -- raw unit is 0.1 mm
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016` AS d
  JOIN best_station b ON d.id = b.id
  WHERE d.element = 'PRCP'
    AND d.qflag  IS NULL
  GROUP BY d.date
),

-- classify each day
precip_flag AS (
  SELECT
    date,
    CASE WHEN prcp_mm > 5.0 THEN 'rainy' ELSE 'non_rainy' END AS rain_category
  FROM daily_precip
),

-- Citi Bike trips per calendar day in 2016
bike_daily AS (
  SELECT
    DATE(starttime) AS ride_day,
    COUNT(*)        AS trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime) = 2016
  GROUP BY ride_day
),

-- join trips with precipitation classification;
-- if a day has no precip record, treat it as non‑rainy (0 mm)
combined AS (
  SELECT
    b.ride_day,
    COALESCE(p.rain_category, 'non_rainy') AS rain_category,
    b.trips
  FROM bike_daily b
  LEFT JOIN precip_flag p
    ON b.ride_day = p.date
)

SELECT
  rain_category,
  AVG(trips) AS average_daily_citibike_trips_2016
FROM combined
GROUP BY rain_category
ORDER BY rain_category;
