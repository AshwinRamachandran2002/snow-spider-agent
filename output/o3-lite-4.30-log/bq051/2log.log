WITH -- 1) pick the closest GHCN station (≤ 50 km from 40.7128 N, –74.0060 E) having the most valid 2016 PRCP rows
nearby_stations AS (
  SELECT id
  FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
  WHERE longitude IS NOT NULL
    AND latitude  IS NOT NULL
    AND ST_DISTANCE(
          ST_GEOGPOINT(longitude, latitude),
          ST_GEOGPOINT(-74.0060, 40.7128)
        ) < 50000            -- 50 km radius
),
best_station AS (
  SELECT id
  FROM (
    SELECT d.id,
           COUNT(*) AS good_rows
    FROM `bigquery-public-data.ghcn_d.ghcnd_2016` AS d
    JOIN nearby_stations USING (id)
    WHERE d.element = 'PRCP'
      AND d.qflag  IS NULL          -- keep only un‑flagged values
    GROUP BY d.id
    ORDER BY good_rows DESC
    LIMIT 1
  )
),

-- 2) daily precipitation (in mm) for that station
daily_precip AS (
  SELECT
    DATE(date)         AS obs_date,
    SUM(value) / 10.0  AS prcp_mm    -- convert 0.1 mm units → mm
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id IN (SELECT id FROM best_station)
    AND element = 'PRCP'
    AND qflag IS NULL
  GROUP BY obs_date
),

-- 3) daily Citi Bike trip counts for 2016
daily_trips AS (
  SELECT
    DATE(starttime) AS ride_date,
    COUNT(*)        AS trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime) = 2016
  GROUP BY ride_date
)

-- 4) average trips on rainy (>5 mm) vs. non‑rainy days
SELECT
  CASE WHEN IFNULL(prcp_mm, 0) > 5 THEN 'Rainy'
       ELSE 'Non‑rainy' END          AS rain_category,
  AVG(trips)                         AS average_daily_citibike_trips_2016
FROM daily_trips
LEFT JOIN daily_precip
  ON ride_date = obs_date
GROUP BY rain_category
ORDER BY rain_category;
```
