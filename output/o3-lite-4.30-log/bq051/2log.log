--        • element = 'PRCP'
--        • qflag IS NULL  (only good measurements)
--        • id IN (five closest station IDs)
-- 5) We aggregate by station id and order by the number of good rows so the
--    “best” station appears first.
SELECT
  id,
  COUNT(*) AS valid_prcp_rows_2016
FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
WHERE id IN ('USC00305816',           -- World Trade Center
             'USC00309580',           -- World Trade Center (alternate metadata)
             'US1NYNY0078',           -- Stuyvesant Square Park
             'US1NYKN0025',           -- Brooklyn 3.1 NW
             'US1NJHD0023')           -- Jersey City 1.6 NNE
  AND element = 'PRCP'
  AND qflag IS NULL
  AND EXTRACT(YEAR FROM date) = 2016
GROUP BY id
ORDER BY valid_prcp_rows_2016 DESC;
