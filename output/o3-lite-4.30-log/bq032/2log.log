  WHERE rnk = 2
),
last_fix AS (
  SELECT
    ROUND(latitude, 4) AS latitude,
    ROW_NUMBER() OVER (ORDER BY iso_time DESC) AS rn
  FROM na2020
  WHERE sid IN (SELECT sid FROM second_longest)
)
SELECT latitude
FROM last_fix
WHERE rn = 1;
```
