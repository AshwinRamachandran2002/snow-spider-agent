```sql
--Description: Identify the storm that travelled the second‑longest distance
--             in 2020 (North Atlantic) and show its total distance (metres)
WITH legs AS (
  SELECT
    sid,
    ST_DISTANCE(
      ST_GEOGPOINT(longitude, latitude),
      ST_GEOGPOINT(
        LAG(longitude) OVER (PARTITION BY sid ORDER BY iso_time),
        LAG(latitude)  OVER (PARTITION BY sid ORDER BY iso_time)
      )
    ) AS leg_m
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE season = '2020'
    AND basin  = 'NA'
    AND track_type = 'main'
),
totals AS (
  SELECT sid, SUM(leg_m) AS total_m
  FROM legs
  GROUP BY sid
),
ranked AS (
  SELECT
    sid,
    total_m,
    DENSE_RANK() OVER (ORDER BY total_m DESC) AS rnk
  FROM totals
)
SELECT sid, total_m
FROM ranked
WHERE rnk = 2
LIMIT 20;
