      )
    ) / 1000.0 AS leg_km
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE season = '2020'
    AND basin  = 'NA'
    AND track_type = 'main'
)
SELECT
  sid,
  SUM(leg_km) AS total_km
FROM legs
GROUP BY sid
ORDER BY total_km DESC
LIMIT 20;
