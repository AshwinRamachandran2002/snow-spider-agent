Relevant columns and their use for this task  

• `sid` : to group every observation that belongs to the same tropical‑cyclone.  
• `season` : to restrict the analysis to 2020.  
• `basin` : to keep only North‑Atlantic storms (`'NA'`).  
• `track_type` : to use the main (best‑track) points of a storm.  
• `iso_time` : to order the successive fixes of the track.  
• `latitude`, `longitude` : to build GEOGRAPHY points and measure great‑circle distances (with `ST_DISTANCE`).  

Typical filters that will be used  

```sql
WHERE season = '2020'
  AND basin  = 'NA'
  AND track_type = 'main'
```

Below are ten exploratory → incremental SQL queries (each capped with `LIMIT 20`) that lead from simple inspection to the final answer.

```sql
-- 1) Description: show the seasons available in the file (sanity check)
SELECT DISTINCT season
FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
ORDER BY season
LIMIT 20;
```

```sql
-- 2) Description: list every storm identifier (sid) that occurred in
--    the North Atlantic during the 2020 season
SELECT DISTINCT sid, name
FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
WHERE season = '2020'
  AND basin  = 'NA'
  AND track_type = 'main'
ORDER BY sid
LIMIT 20;
```

```sql
-- 3) Description: look at a few individual fixes for one 2020 NA storm
SELECT sid, iso_time, latitude, longitude
FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
WHERE sid = (SELECT MIN(sid)
             FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
             WHERE season='2020' AND basin='NA' AND track_type='main')
ORDER BY iso_time
LIMIT 20;
```

```sql
-- 4) Description: calculate the great‑circle distance between consecutive
--    fixes for a single example storm (uses LAG window)
SELECT
  sid,
  iso_time,
  latitude,
  longitude,
  ST_DISTANCE(
      ST_GEOGPOINT(longitude, latitude),
      ST_GEOGPOINT(LAG(longitude) OVER (PARTITION BY sid ORDER BY iso_time),
                   LAG(latitude)  OVER (PARTITION BY sid ORDER BY iso_time))
  ) AS leg_meters
FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
WHERE sid = (SELECT MIN(sid)
             FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
             WHERE season='2020' AND basin='NA' AND track_type='main')
  AND track_type = 'main'
ORDER BY iso_time
LIMIT 20;
```

```sql
-- 5) Description: compute the travelled distance (km) for every 2020 NA storm
--    by summing each leg
WITH legs AS (
  SELECT
    sid,
    ST_DISTANCE(
        ST_GEOGPOINT(longitude, latitude),
        ST_GEOGPOINT(LAG(longitude) OVER w,
                     LAG(latitude)  OVER w)
    ) / 1000.0 AS leg_km
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WINDOW w AS (PARTITION BY sid ORDER BY iso_time)
  WHERE season='2020' AND basin='NA' AND track_type='main'
)
SELECT sid,
       SUM(leg_km) AS total_km
FROM legs
GROUP BY sid
ORDER BY total_km DESC
LIMIT 20;
```

```sql
-- 6) Description: extract the storm that travelled the second‑longest
WITH distances AS (
  SELECT sid,
         SUM( ST_DISTANCE(
                 ST_GEOGPOINT(longitude, latitude),
                 ST_GEOGPOINT(LAG(longitude) OVER w,
                              LAG(latitude)  OVER w)
             ) ) AS total_m
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WINDOW w AS (PARTITION BY sid ORDER BY iso_time)
  WHERE season='2020' AND basin='NA' AND track_type='main'
  GROUP BY sid
),
ranked AS (
  SELECT sid, total_m,
         DENSE_RANK() OVER (ORDER BY total_m DESC) AS rnk
  FROM distances
)
SELECT sid, total_m
FROM ranked
WHERE rnk = 2
LIMIT 20;
```

```sql
-- 7) Description: show every fix of that second‑longest‑distance storm
--    to verify its track
WITH second_longest AS (
  SELECT sid
  FROM (
      SELECT sid,
             SUM( ST_DISTANCE(
                     ST_GEOGPOINT(longitude, latitude),
                     ST_GEOGPOINT(LAG(longitude) OVER w,
                                  LAG(latitude)  OVER w)
                 ) ) AS total_m,
             DENSE_RANK() OVER (ORDER BY SUM( ST_DISTANCE(
                     ST_GEOGPOINT(longitude, latitude),
                     ST_GEOGPOINT(LAG(longitude) OVER w,
                                  LAG(latitude)  OVER w)
                 ) ) DESC) AS rnk
      FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
      WINDOW w AS (PARTITION BY sid ORDER BY iso_time)
      WHERE season='2020' AND basin='NA' AND track_type='main'
      GROUP BY sid
  )
  WHERE rnk = 2
)
SELECT h.sid, h.iso_time, h.latitude, h.longitude
FROM `bigquery-public-data.noaa_hurricanes.hurricanes` AS h
JOIN second_longest AS s
ON h.sid = s.sid
ORDER BY h.iso_time
LIMIT 20;
```

```sql
-- 8) Description: fetch the very last fix (max iso_time) of that storm
WITH second_longest AS (
  SELECT sid
  FROM (
      SELECT sid,
             DENSE_RANK() OVER (ORDER BY SUM( ST_DISTANCE(
                     ST_GEOGPOINT(longitude, latitude),
                     ST_GEOGPOINT(LAG(longitude) OVER w,
                                  LAG(latitude)  OVER w)
                 ) ) DESC) AS rnk
      FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
      WINDOW w AS (PARTITION BY sid ORDER BY iso_time)
      WHERE season='2020' AND basin='NA' AND track_type='main'
      GROUP BY sid
  )
  WHERE rnk = 2
)
SELECT sid,
       iso_time,
       latitude,
       longitude
FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
WHERE sid IN (SELECT sid FROM second_longest)
ORDER BY iso_time DESC
LIMIT 20;
```

```sql
-- 9) Description: return only the latitude of that final coordinate
WITH second_longest AS (
  SELECT sid
  FROM (
      SELECT sid,
             DENSE_RANK() OVER (ORDER BY SUM( ST_DISTANCE(
                     ST_GEOGPOINT(longitude, latitude),
                     ST_GEOGPOINT(LAG(longitude) OVER w,
                                  LAG(latitude)  OVER w)
                 ) ) DESC) AS rnk
      FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
      WINDOW w AS (PARTITION BY sid ORDER BY iso_time)
      WHERE season='2020' AND basin='NA' AND track_type='main'
      GROUP BY sid
  )
  WHERE rnk = 2
),
last_point AS (
  SELECT t.sid,
         t.latitude,
         ROW_NUMBER() OVER (PARTITION BY t.sid ORDER BY t.iso_time DESC) AS rn
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes` t
  JOIN second_longest s USING (sid)
)
SELECT latitude
FROM last_point
WHERE rn = 1
LIMIT 20;
```

```sql
-- 10) Description: (Same as 9, but returning both sid and latitude just
--      to double‑check)
WITH ranks AS (
  SELECT sid,
         SUM( ST_DISTANCE(
                 ST_GEOGPOINT(longitude, latitude),
                 ST_GEOGPOINT(LAG(longitude) OVER w,
                              LAG(latitude)  OVER w)
             ) ) AS total_m,
         DENSE_RANK() OVER (ORDER BY SUM( ST_DISTANCE(
                 ST_GEOGPOINT(longitude, latitude),
                 ST_GEOGPOINT(LAG(longitude) OVER w,
                              LAG(latitude)  OVER w)
             ) ) DESC) AS rnk
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WINDOW w AS (PARTITION BY sid ORDER BY iso_time)
  WHERE season='2020' AND basin='NA' AND track_type='main'
  GROUP BY sid
),
second_longest AS (
  SELECT sid FROM ranks WHERE rnk = 2
),
final_fix AS (
  SELECT sid, latitude,
         ROW_NUMBER() OVER (PARTITION BY sid ORDER BY iso_time DESC) AS rn
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE sid IN (SELECT sid FROM second_longest)
)
SELECT sid, latitude
FROM final_fix
WHERE rn = 1
LIMIT 20;
```

