--Description / thinking process:
-- 1) Filter the dataset to the 2020 season, North‑Atlantic basin (NA),
--    and ‘main’ track fixes—these are the re‑analysed best‑track points.
-- 2) For every storm (sid) order its fixes by time; LAG() fetches the
--    previous latitude/longitude so we can measure the distance to the
--    current fix with ST_DISTANCE (geodesic metres).
-- 3) Divide by 1000 to convert metres to kilometres; each row now holds
--    a “leg” length in km (NULL for the first fix of each storm).
-- 4) Sum all legs per storm to obtain the total track length.
-- 5) Sort the storms by total_km (descending) and return the top 20.
WITH legs AS (
  SELECT
    sid,
    ST_DISTANCE(
      ST_GEOGPOINT(longitude, latitude),
      ST_GEOGPOINT(
        LAG(longitude) OVER (PARTITION BY sid ORDER BY iso_time),
