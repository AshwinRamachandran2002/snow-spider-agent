    AND basin  = 'NA'
    AND track_type = 'main'
),
totals AS (
  SELECT sid, SUM(leg_m) AS total_m
  FROM legs
  GROUP BY sid
),
ranks AS (
  SELECT
    sid,
    total_m,
    DENSE_RANK() OVER (ORDER BY total_m DESC) AS rnk
  FROM totals
),
second_longest AS (
  SELECT sid
  FROM ranks
  WHERE rnk = 2
),
final_fix AS (
  SELECT
    sid,
    latitude,
    ROW_NUMBER() OVER (PARTITION BY sid ORDER BY iso_time DESC) AS rn
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE sid IN (SELECT sid FROM second_longest)
)
SELECT sid, latitude
FROM final_fix
WHERE rn = 1
LIMIT 20
