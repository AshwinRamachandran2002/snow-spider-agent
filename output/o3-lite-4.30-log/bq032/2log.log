```sql
--Description: Show every fix of the second‑longest‑distance storm (2020 NA)
WITH legs AS (
  SELECT
    sid,
    ST_DISTANCE(
      ST_GEOGPOINT(longitude, latitude),
      ST_GEOGPOINT(
        LAG(longitude) OVER (PARTITION BY sid ORDER BY iso_time),
        LAG(latitude)  OVER (PARTITION BY sid ORDER BY iso_time)
      )
    ) AS leg_m
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE season = '2020'
    AND basin  = 'NA'
    AND track_type = 'main'
),
totals AS (
  SELECT sid, SUM(leg_m) AS total_m
  FROM legs
  GROUP BY sid
),
second_longest AS (
  SELECT sid
  FROM (
    SELECT
      sid,
      DENSE_RANK() OVER (ORDER BY total_m DESC) AS rnk
    FROM totals
  )
  WHERE rnk = 2
)
SELECT
  h.sid,
  h.iso_time,
  h.latitude,
  h.longitude
FROM `bigquery-public-data.noaa_hurricanes.hurricanes` AS h
JOIN second_longest AS s
ON h.sid = s.sid
ORDER BY h.iso_time
LIMIT 20;
```

