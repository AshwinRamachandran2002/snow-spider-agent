Query:
-- Description: 10) Latitude of the last recorded point for the hurricane that
--                travelled the second‑longest distance in the 2020
--                North‑Atlantic season.
WITH pts AS (
  SELECT
    sid,
    iso_time,
    latitude,
    longitude,
    LAG(latitude)  OVER (PARTITION BY sid ORDER BY iso_time) AS prev_lat,
    LAG(longitude) OVER (PARTITION BY sid ORDER BY iso_time) AS prev_lon
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE season = '2020'
    AND basin  = 'NA'
),
seg AS (
  SELECT
    sid,
    ST_DISTANCE(
      ST_GEOGPOINT(longitude, latitude),
      ST_GEOGPOINT(prev_lon,  prev_lat)
    ) AS metres
  FROM pts
  WHERE prev_lat IS NOT NULL
),
tot AS (
  SELECT
    sid,
    SUM(metres) AS metres_travelled
  FROM seg
  GROUP BY sid
),
second_longest AS (
  SELECT sid
  FROM (
    SELECT
      sid,
      DENSE_RANK() OVER (ORDER BY metres_travelled DESC) AS rk
    FROM tot
  )
  WHERE rk = 2
),
last_point AS (
  SELECT
    h.sid,
    h.latitude,
    ROW_NUMBER() OVER (PARTITION BY h.sid ORDER BY h.iso_time DESC) AS rn
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes` AS h
  JOIN second_longest USING (sid)
)
SELECT latitude AS final_latitude
FROM last_point
WHERE rn = 1
