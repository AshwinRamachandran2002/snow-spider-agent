--Description: Compute the great‑circle distance in kilometres between
--             successive 6‑hour fixes for a real 2020 North‑Atlantic
--             hurricane (SID = '2020251N17319').  Strategy: order the track
--             chronologically, use LAG to fetch the previous coordinates,
--             apply ST_DISTANCE to get metres, then convert to km.  The first
--             point is excluded because it lacks a previous fix.
WITH ordered AS (
  SELECT
    iso_time,
    latitude,
    longitude,
    LAG(latitude)  OVER (ORDER BY iso_time)  AS prev_lat,
    LAG(longitude) OVER (ORDER BY iso_time)  AS prev_lon
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE sid = '2020251N17319'
)
SELECT
  iso_time,
  ST_DISTANCE(
    ST_GEOGPOINT(longitude, latitude),
    ST_GEOGPOINT(prev_lon, prev_lat)
  ) / 1000 AS km_between_points
FROM ordered
WHERE prev_lat IS NOT NULL
ORDER BY iso_time;
