Begin Exploring Related Columns
Relevant columns & why they matter  
• `season` : filter to the 2020 season  
• `basin` : filter to North Atlantic ('NA') storms  
• `sid` : unique storm identifier – used to group all 6‑hourly points that belong to the same hurricane  
• `iso_time` : timestamp used to order the points chronologically and to pick the final point of a track  
• `latitude`, `longitude` : coordinates from which the travelled distance is calculated (via ST_GEOGPOINT / ST_DISTANCE)  

Typical filter conditions for every query below  
```
WHERE season = '2020' 
  AND basin  = 'NA'
```

------------------------------------------------------------------
10 step‑by‑step BigQuery SQLs
------------------------------------------------------------------

```sql
-- Description: 1) Peek at 20 raw points for the 2020 North‑Atlantic season
SELECT *
FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
WHERE season = '2020' AND basin = 'NA'
LIMIT 20;
```

```sql
-- Description: 2) List the distinct storm IDs (sid) that existed in 2020 NA
SELECT DISTINCT sid
FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
WHERE season = '2020' AND basin = 'NA'
ORDER BY sid
LIMIT 20;
```

```sql
-- Description: 3) How many 6‑hourly records does each 2020 NA storm have?
SELECT sid, COUNT(*) AS points
FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
WHERE season = '2020' AND basin = 'NA'
GROUP BY sid
ORDER BY points DESC
LIMIT 20;
```

```sql
-- Description: 4) Show the first & last timestamp recorded for every storm
SELECT sid,
       MIN(iso_time) AS first_time,
       MAX(iso_time) AS last_time
FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
WHERE season = '2020' AND basin = 'NA'
GROUP BY sid
ORDER BY last_time;
```

```sql
-- Description: 5) Get the final coordinates (lat/lon) of every storm track
SELECT sid, 
       FIRST_VALUE(latitude)  OVER w AS final_lat,
       FIRST_VALUE(longitude) OVER w AS final_lon
FROM (
  SELECT sid, iso_time, latitude, longitude,
         ROW_NUMBER() OVER (PARTITION BY sid ORDER BY iso_time DESC) AS r
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE season = '2020' AND basin = 'NA'
) w
WHERE r = 1
ORDER BY sid;
```

```sql
-- Description: 6) Example – compute segment distances for one storm (replace «HURRICANE_ID»)
WITH pts AS (
  SELECT iso_time,
         latitude, longitude,
         LAG(latitude)  OVER (ORDER BY iso_time) AS prev_lat,
         LAG(longitude) OVER (ORDER BY iso_time) AS prev_lon
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE season = '2020' AND basin = 'NA' AND sid = '«HURRICANE_ID»'
)
SELECT iso_time,
       ST_DISTANCE(ST_GEOGPOINT(longitude, latitude),
                   ST_GEOGPOINT(prev_lon,  prev_lat))/1000 AS km_to_prev
FROM pts
WHERE prev_lat IS NOT NULL;
```

```sql
-- Description: 7) Total travelled kilometres for every 2020 NA storm
WITH pts AS (
  SELECT sid, iso_time, latitude, longitude,
         LAG(latitude)  OVER (PARTITION BY sid ORDER BY iso_time) AS prev_lat,
         LAG(longitude) OVER (PARTITION BY sid ORDER BY iso_time) AS prev_lon
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE season = '2020' AND basin = 'NA'
),
seg AS (
  SELECT sid,
         ST_DISTANCE(ST_GEOGPOINT(longitude, latitude),
                     ST_GEOGPOINT(prev_lon,  prev_lat)) AS metres
  FROM pts
  WHERE prev_lat IS NOT NULL
)
SELECT sid,
       SUM(metres)/1000 AS total_km
FROM seg
GROUP BY sid
ORDER BY total_km DESC;
```

```sql
-- Description: 8) Rank storms by total distance and pick top 5
WITH pts AS (
  SELECT sid, iso_time, latitude, longitude,
         LAG(latitude)  OVER (PARTITION BY sid ORDER BY iso_time) AS prev_lat,
         LAG(longitude) OVER (PARTITION BY sid ORDER BY iso_time) AS prev_lon
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE season = '2020' AND basin = 'NA'
),
seg AS (
  SELECT sid,
         ST_DISTANCE(ST_GEOGPOINT(longitude, latitude),
                     ST_GEOGPOINT(prev_lon,  prev_lat)) AS metres
  FROM pts
  WHERE prev_lat IS NOT NULL
),
tot AS (
  SELECT sid,
         SUM(metres) AS metres_travelled
  FROM seg
  GROUP BY sid
)
SELECT sid,
       metres_travelled/1000 AS km,
       DENSE_RANK() OVER (ORDER BY metres_travelled DESC) AS rk
FROM tot
ORDER BY rk
LIMIT 5;
```

```sql
-- Description: 9) Identify the SID of the 2nd‑longest track
WITH pts AS (
  SELECT sid, iso_time, latitude, longitude,
         LAG(latitude)  OVER (PARTITION BY sid ORDER BY iso_time) AS prev_lat,
         LAG(longitude) OVER (PARTITION BY sid ORDER BY iso_time) AS prev_lon
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE season = '2020' AND basin = 'NA'
),
seg AS (
  SELECT sid,
         ST_DISTANCE(ST_GEOGPOINT(longitude, latitude),
                     ST_GEOGPOINT(prev_lon,  prev_lat)) AS metres
  FROM pts
  WHERE prev_lat IS NOT NULL
),
tot AS (
  SELECT sid,
         SUM(metres) AS metres_travelled
  FROM seg
  GROUP BY sid
),
ranked AS (
  SELECT sid,
         metres_travelled,
         DENSE_RANK() OVER (ORDER BY metres_travelled DESC) AS rk
  FROM tot
)
SELECT sid
FROM ranked
WHERE rk = 2;
```

```sql
-- Description: 10) FINAL – latitude of the last point for the hurricane
--                that travelled the SECOND longest distance in 2020 NA
WITH pts AS (
  SELECT sid, iso_time, latitude, longitude,
         LAG(latitude)  OVER (PARTITION BY sid ORDER BY iso_time) AS prev_lat,
         LAG(longitude) OVER (PARTITION BY sid ORDER BY iso_time) AS prev_lon
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE season = '2020' AND basin = 'NA'
),
seg AS (
  SELECT sid,
         ST_DISTANCE(ST_GEOGPOINT(longitude, latitude),
                     ST_GEOGPOINT(prev_lon,  prev_lat)) AS metres
  FROM pts
  WHERE prev_lat IS NOT NULL
),
tot AS (
  SELECT sid,
         SUM(metres) AS metres_travelled
  FROM seg
  GROUP BY sid
),
second_longest AS (
  SELECT sid
  FROM (
    SELECT sid,
           DENSE_RANK() OVER (ORDER BY metres_travelled DESC) AS rk
    FROM tot
  )
  WHERE rk = 2
),
last_point AS (
  SELECT sid, latitude,
         ROW_NUMBER() OVER (PARTITION BY sid ORDER BY iso_time DESC) AS r
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE season = '2020' AND basin = 'NA'
    AND sid IN (SELECT sid FROM second_longest)
)
SELECT latitude AS final_latitude
FROM last_point
WHERE r = 1;
```
