```sql
-- Description / Thinking process:
-- Goal: return the latitude of the last recorded point for the 2020
--       North‑Atlantic hurricane whose overall track length is the
--       SECOND longest among that season’s NA storms.
--
-- Steps inside a single query (realised with CTEs):
--  1. pts   – For each 6‑hourly fix add the previous lat/lon (LAG) so we can
--             measure segment lengths.
--  2. seg   – Convert consecutive positions into great‑circle distances
--             using ST_DISTANCE; first point per storm is skipped.
--  3. tot   – Sum segment metres per storm to get total distance travelled.
--  4. ranked– Rank storms by total distance; keep the one with rk = 2
--             (second‑longest).
--  5. last  – From the original table, pull that storm’s most recent row
--             (iso_time DESC, rn = 1).
--  6. SELECT– Output its latitude.
WITH pts AS (
  SELECT
    sid,
    iso_time,
    latitude,
    longitude,
    LAG(latitude)  OVER (PARTITION BY sid ORDER BY iso_time) AS prev_lat,
    LAG(longitude) OVER (PARTITION BY sid ORDER BY iso_time) AS prev_lon
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE season = '2020'
    AND basin  = 'NA'
),
seg AS (
  SELECT
    sid,
    ST_DISTANCE(
      ST_GEOGPOINT(longitude, latitude),
      ST_GEOGPOINT(prev_lon,  prev_lat)
    ) AS metres
  FROM pts
  WHERE prev_lat IS NOT NULL
),
tot AS (
  SELECT
    sid,
    SUM(metres) AS total_metres
  FROM seg
  GROUP BY sid
),
ranked AS (
  SELECT
    sid,
    total_metres,
    DENSE_RANK() OVER (ORDER BY total_metres DESC) AS rk
  FROM tot
),
last AS (
  SELECT
    h.sid,
    h.latitude,
    ROW_NUMBER() OVER (PARTITION BY h.sid ORDER BY h.iso_time DESC) AS rn
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes` AS h
  JOIN ranked r
    ON h.sid = r.sid
  WHERE r.rk = 2                      -- keep only the second‑longest storm
)
SELECT latitude AS final_latitude
FROM last
WHERE rn = 1;
```
