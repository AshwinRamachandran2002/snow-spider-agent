Query:
-- Description: 7) Total distance travelled (km) by every 2020 North‑Atlantic
--               storm.  Each 6‑hourly segment is summed per SID.
WITH pts AS (
  SELECT
    sid,
    iso_time,
    latitude,
    longitude,
    LAG(latitude)  OVER (PARTITION BY sid ORDER BY iso_time) AS prev_lat,
    LAG(longitude) OVER (PARTITION BY sid ORDER BY iso_time) AS prev_lon
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE season = '2020'
    AND basin  = 'NA'
),
seg AS (
  SELECT
    sid,
    ST_DISTANCE(
      ST_GEOGPOINT(longitude, latitude),
      ST_GEOGPOINT(prev_lon,  prev_lat)
    ) AS metres
  FROM pts
  WHERE prev_lat IS NOT NULL
)
SELECT
  sid,
  SUM(metres) / 1000 AS total_km
FROM seg
GROUP BY sid
ORDER BY total_km DESC
