FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
  AND LOWER(event_name) LIKE '%quickplay%'
LIMIT 20;
```

```sql
-- 2) Description: show how many times each quick‑play event fired (Aug 1–15, 2018)
SELECT event_name, COUNT(*) AS hits
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
  AND LOWER(event_name) LIKE '%quickplay%'
GROUP BY event_name
ORDER BY hits DESC
LIMIT 20;
```

```sql
-- 3) Description: first session_start date for every user in the cohort window
SELECT user_pseudo_id,
       MIN(PARSE_DATE('%Y%m%d', event_date)) AS cohort_date
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
  AND event_name = 'session_start'
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
-- 4) Description: count cohort users by day (sanity check)
WITH cohort AS (
  SELECT user_pseudo_id,
         MIN(PARSE_DATE('%Y%m%d', event_date)) AS cohort_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
    AND event_name = 'session_start'
  GROUP BY user_pseudo_id )
SELECT cohort_date, COUNT(DISTINCT user_pseudo_id) AS users
FROM cohort
GROUP BY cohort_date
ORDER BY cohort_date
LIMIT 20;
```

```sql
