--Description: Compute 2‑nd‑week retention by “board” (the parameter that labels quick‑play type).
-- Steps performed inside the query:
-- 1.  Cohort users whose very first quick‑play event occurred between 1 Aug 2018 and 15 Aug 2018.
-- 2.  Capture the board value that appears on that first event to tag the user’s cohort.
-- 3.  Count, for each board, how many distinct cohort users there are (cohort size).
-- 4.  Count how many of those users fire at least one session_start exactly 8‑14 days
--     after their first quick‑play (2‑nd‑week returners).
-- 5.  Divide returners by cohort size to obtain the 2‑nd‑week retention rate
--     and list boards from worst to best.
WITH first_quickplay AS (
  SELECT
    user_pseudo_id,
    MIN(event_date) AS first_play_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id
),
board_tag AS (
  -- attach the board value seen on the first quick‑play event
  SELECT DISTINCT
    fqp.user_pseudo_id,
    fqp.first_play_date,
    ep.value.string_value AS board
  FROM `firebase-public-project.analytics_153293282.events_*` AS e
  JOIN first_quickplay fqp
    ON e.user_pseudo_id = fqp.user_pseudo_id
   AND e.event_date      = fqp.first_play_date
   AND LOWER(e.event_name) LIKE '%quickplay%'
  CROSS JOIN UNNEST(e.event_params) AS ep
  WHERE ep.key = 'board'
),
second_week_returners AS (
  SELECT DISTINCT
    bt.user_pseudo_id,
    bt.board
  FROM `firebase-public-project.analytics_153293282.events_*` AS s
  JOIN board_tag bt
    ON s.user_pseudo_id = bt.user_pseudo_id
  WHERE s.event_name = 'session_start'
    AND DATE_DIFF(PARSE_DATE('%Y%m%d', s.event_date),
                  PARSE_DATE('%Y%m%d', bt.first_play_date), DAY)
        BETWEEN 8 AND 14
)
SELECT
  bt.board                                    AS quickplay_board,
  COUNT(DISTINCT bt.user_pseudo_id)           AS cohort_users,
  COUNT(DISTINCT sr.user_pseudo_id)           AS second_week_returners,
  SAFE_DIVIDE(COUNT(DISTINCT sr.user_pseudo_id),
              COUNT(DISTINCT bt.user_pseudo_id)) AS second_week_retention_rate
FROM board_tag bt
LEFT JOIN second_week_returners sr
  ON bt.user_pseudo_id = sr.user_pseudo_id
GROUP BY quickplay_board
ORDER BY second_week_retention_rate ASC
LIMIT 20;
