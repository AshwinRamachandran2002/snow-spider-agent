Begin Exploring Related Columns
Relevant columns and why they matter  
• event_date : cohort definition (first engagement date) and date arithmetic for the “second week” (day‑8 → day‑14)  
• event_name : distinguishes the two kinds of events we need – the various quick‑play events and the retention signal session_start  
• user_pseudo_id : stable user identifier used to build cohorts and measure returns  
• event_params : holds the quick‑play subtype (e.g. quickplay_type, mode, or map) that we must compare; we pull it by UNNEST‑ing and filtering on key = 'quickplay_type' (or any other key we discover)  

Typical filters / join conditions  
• event_name LIKE '%quickplay%'                               –– identify all quick‑play events  
• event_name  = 'session_start'                               –– retention signal  
• _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'             –– users who FIRST engaged 1‑15 Aug 2018  
• event_date  BETWEEN '20180809' AND '20180829'               –– second‑week window (user‑specific once we know the cohort start)  
• PARSE_DATE('%Y%m%d', event_date) - PARSE_DATE('%Y%m%d', first_play_date) BETWEEN 8 AND 14  

Below are ten progressively richer inspection / analysis queries (all capped with LIMIT 20).  
Replace <PROJECT>.<DATASET> with firebase-public-project.analytics_153293282 in your console if you copy‑paste.  

```sql
-- 1.  All distinct event names that contain the word “quickplay” (Aug‑01 – Aug‑15)
SELECT DISTINCT event_name
FROM   `firebase-public-project.analytics_153293282.events_*`
WHERE  _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
  AND  LOWER(event_name) LIKE '%quickplay%'
LIMIT 20;
```

```sql
-- 2.  List every parameter key recorded on quick‑play events so we can spot the subtype key
SELECT DISTINCT ep.key
FROM   `firebase-public-project.analytics_153293282.events_*`,
       UNNEST(event_params) AS ep
WHERE  _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
  AND  LOWER(event_name) LIKE '%quickplay%'
LIMIT 20;
```

```sql
-- 3.  Preview distinct values for the suspected quick‑play subtype parameter: ‘quickplay_type’
SELECT DISTINCT
       ep.value.string_value        AS quickplay_type
FROM   `firebase-public-project.analytics_153293282.events_*`,
       UNNEST(event_params) AS ep
WHERE  _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
  AND  LOWER(event_name) LIKE '%quickplay%'
  AND  ep.key = 'quickplay_type'
LIMIT 20;
```

```sql
-- 4.  First quick‑play date per user (cohort: 1‑15 Aug 2018)
SELECT
  user_pseudo_id,
  MIN(event_date) AS first_play_date
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
  AND LOWER(event_name) LIKE '%quickplay%'
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
-- 5.  Attach the quick‑play subtype to each user’s very first play
WITH first_play AS (
  SELECT AS VALUE
    STRUCT(user_pseudo_id,
           MIN(event_date) AS first_play_date)
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id
)
SELECT
  fp.user_pseudo_id,
  fp.first_play_date,
  ep.value.string_value AS quickplay_type
FROM `firebase-public-project.analytics_153293282.events_*` AS t
JOIN first_play fp
  ON t.user_pseudo_id = fp.user_pseudo_id
 AND t.event_date      = fp.first_play_date
 AND LOWER(t.event_name) LIKE '%quickplay%'
CROSS JOIN UNNEST(t.event_params) AS ep
WHERE ep.key = 'quickplay_type'
LIMIT 20;
```

```sql
-- 6.  Second‑week session_start events for the same cohort (shows raw matches)
WITH cohort AS (
  SELECT user_pseudo_id,
         MIN(event_date) AS first_play_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id
)
SELECT
  t.user_pseudo_id,
  t.event_date                                AS return_date,
  cohort.first_play_date,
  DATE_DIFF(PARSE_DATE('%Y%m%d', t.event_date),
            PARSE_DATE('%Y%m%d', cohort.first_play_date), DAY) AS days_since_first
FROM `firebase-public-project.analytics_153293282.events_*` AS t
JOIN cohort
  ON t.user_pseudo_id = cohort.user_pseudo_id
WHERE t.event_name = 'session_start'
  AND DATE_DIFF(PARSE_DATE('%Y%m%d', t.event_date),
                PARSE_DATE('%Y%m%d', cohort.first_play_date), DAY)
      BETWEEN 8 AND 14
LIMIT 20;
```

```sql
-- 7.  Count cohort size per quick‑play subtype
WITH first_play AS (
  SELECT
    user_pseudo_id,
    MIN(event_date) AS first_play_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id
),
labeled AS (
  SELECT DISTINCT
    fp.user_pseudo_id,
    fp.first_play_date,
    ep.value.string_value AS quickplay_type
  FROM `firebase-public-project.analytics_153293282.events_*` AS t
  JOIN first_play fp
    ON fp.user_pseudo_id = t.user_pseudo_id
   AND fp.first_play_date = t.event_date
   AND LOWER(t.event_name) LIKE '%quickplay%'
  CROSS JOIN UNNEST(t.event_params) AS ep
  WHERE ep.key = 'quickplay_type'
)
SELECT quickplay_type,
       COUNT(DISTINCT user_pseudo_id) AS cohort_users
FROM labeled
GROUP BY quickplay_type
LIMIT 20;
```

```sql
-- 8.  Count second‑week returners per quick‑play subtype
WITH first_play AS (
  SELECT
    user_pseudo_id,
    MIN(event_date) AS first_play_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id
),
labeled AS (
  SELECT DISTINCT
    fp.user_pseudo_id,
    fp.first_play_date,
    ep.value.string_value AS quickplay_type
  FROM `firebase-public-project.analytics_153293282.events_*` AS t
  JOIN first_play fp
    ON fp.user_pseudo_id = t.user_pseudo_id
   AND fp.first_play_date = t.event_date
   AND LOWER(t.event_name) LIKE '%quickplay%'
  CROSS JOIN UNNEST(t.event_params) AS ep
  WHERE ep.key = 'quickplay_type'
),
returns AS (
  SELECT
    l.quickplay_type,
    l.user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*` AS ss
  JOIN labeled l
    ON ss.user_pseudo_id = l.user_pseudo_id
  WHERE ss.event_name = 'session_start'
    AND DATE_DIFF(PARSE_DATE('%Y%m%d', ss.event_date),
                  PARSE_DATE('%Y%m%d', l.first_play_date), DAY)
        BETWEEN 8 AND 14
)
SELECT quickplay_type,
       COUNT(DISTINCT user_pseudo_id) AS second_week_returners
FROM returns
GROUP BY quickplay_type
LIMIT 20;
```

```sql
-- 9.  Combine cohort size & returners to produce second‑week retention rate
WITH first_play AS (
  SELECT
    user_pseudo_id,
    MIN(event_date) AS first_play_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id
),
labeled AS (
  SELECT DISTINCT
    fp.user_pseudo_id,
    fp.first_play_date,
    ep.value.string_value AS quickplay_type
  FROM `firebase-public-project.analytics_153293282.events_*` AS t
  JOIN first_play fp
    ON fp.user_pseudo_id = t.user_pseudo_id
   AND fp.first_play_date = t.event_date
   AND LOWER(t.event_name) LIKE '%quickplay%'
  CROSS JOIN UNNEST(t.event_params) AS ep
  WHERE ep.key = 'quickplay_type'
),
returns AS (
  SELECT
    l.quickplay_type,
    l.user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*` AS ss
  JOIN labeled l
    ON ss.user_pseudo_id = l.user_pseudo_id
  WHERE ss.event_name = 'session_start'
    AND DATE_DIFF(PARSE_DATE('%Y%m%d', ss.event_date),
                  PARSE_DATE('%Y%m%d', l.first_play_date), DAY)
        BETWEEN 8 AND 14
)
SELECT
  c.quickplay_type,
  c.cohort_users,
  IFNULL(r.second_week_returners,0) AS second_week_returners,
  SAFE_DIVIDE(r.second_week_returners, c.cohort_users) AS retention_rate
FROM (
  SELECT quickplay_type,
         COUNT(DISTINCT user_pseudo_id) AS cohort_users
  FROM labeled
  GROUP BY quickplay_type
) c
LEFT JOIN (
