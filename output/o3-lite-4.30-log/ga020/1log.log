```sql
--Description: 9) Compute cohort size, retained users, and week‑2 retention rate
--              for each distinct “…quickplay…” event that started a user’s journey.
WITH first_quickplay AS (
  SELECT
    user_pseudo_id,
    ARRAY_AGG(event_name ORDER BY event_timestamp ASC LIMIT 1)[OFFSET(0)] AS quickplay_event,
    MIN(event_timestamp) AS first_qp_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id
),
second_week AS (
  SELECT DISTINCT fp.user_pseudo_id
  FROM first_quickplay fp
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = fp.user_pseudo_id
  WHERE e.event_name = 'session_start'
    AND DATE_DIFF(
          DATE(TIMESTAMP_MICROS(e.event_timestamp)),
          DATE(TIMESTAMP_MICROS(fp.first_qp_ts)),
          DAY) BETWEEN 8 AND 14
)
SELECT
  quickplay_event,
  COUNT(DISTINCT fp.user_pseudo_id) AS cohort_users,
  COUNT(DISTINCT sw.user_pseudo_id) AS retained_users,
  SAFE_DIVIDE(COUNT(DISTINCT sw.user_pseudo_id),
              COUNT(DISTINCT fp.user_pseudo_id)) AS retention_rate
FROM first_quickplay fp
LEFT JOIN second_week sw
  ON fp.user_pseudo_id = sw.user_pseudo_id
GROUP BY quickplay_event
ORDER BY retention_rate
LIMIT 20;
```

