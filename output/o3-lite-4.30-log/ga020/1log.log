Begin Exploring Related Columns
Relevant columns and their potential usage  
• `event_name`: identify “quickplay_*” events and the “session_start” events that signal a visit (retention).  
• `user_pseudo_id`: unique‐visitor key – lets us form a cohort and measure who returns.  
• `event_timestamp`: micro‑seconds since epoch – used to place every event on an exact timeline (needed to work‑out “second‑week”, i.e. days 8‑14 after first engagement).  
• `event_date`: convenient STRING partition column – used to prune the daily sharded tables quickly (e.g. ‘20180801’ … ‘20180815’ for the acquisition cohort, ‘20180809’ … ‘20180829’ for days 8‑14).  

Typical conditions you will see below  
1. `_TABLE_SUFFIX BETWEEN '20180801' AND '20180815'` – limits the cohort to users whose first event happened 1–15 Aug 2018.  
2. `event_name LIKE 'quickplay%'` – isolates quick‑play event types.  
3. `event_name = 'session_start'` – marks a visit that we treat as “retained”.  
4. `TIMESTAMP_MICROS(event_timestamp)` – converts micro‑seconds to TIMESTAMP to compute day differences.  
5. `DATE_DIFF(retention_day , first_eng_day , DAY) BETWEEN 8 AND 14` – implements the “second week” window.  

Below are ten exploratory → progressively more complete SQL snippets (all limited to 20 rows so they can be run in the sandbox first).  
Each uses the public GA4 game dataset  
`firebase-public-project.analytics_153293282.events_*`.

```sql
-- 1. Description: peek at the first 20 distinct event names on 1‑Aug‑2018
SELECT DISTINCT event_name
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX = '20180801'
LIMIT 20;
```

```sql
-- 2. Description: list distinct event names that contain the word “quickplay” (1–15 Aug)
SELECT DISTINCT event_name
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
  AND LOWER(event_name) LIKE '%quickplay%'
LIMIT 20;
```

```sql
-- 3. Description: count total quick‑play events per type during 1–15 Aug
SELECT event_name      AS quickplay_event,
       COUNT(*)        AS total_events
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
  AND event_name LIKE 'quickplay%'
GROUP BY event_name
ORDER BY total_events DESC
LIMIT 20;
```

```sql
-- 4. Description: get the first quick‑play event timestamp for every user in the cohort
SELECT user_pseudo_id,
       event_name                         AS first_quickplay_event,
       MIN(event_timestamp) AS first_quickplay_ts
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
  AND event_name LIKE 'quickplay%'
GROUP BY user_pseudo_id, first_quickplay_event
LIMIT 20;
```

```sql
-- 5. Description: for the same users, pull their first ever engagement date (any event)
WITH cohort AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS first_any_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
  GROUP BY user_pseudo_id
)
SELECT user_pseudo_id,
       TIMESTAMP_MICROS(first_any_ts) AS first_eng
FROM cohort
LIMIT 20;
```

```sql
-- 6. Description: inspect one user’s timeline (replace 'XYZ...' by an ID from result 5)
SELECT _TABLE_SUFFIX AS tbl, 
       event_date,
       TIMESTAMP_MICROS(event_timestamp) AS ts,
       event_name
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE user_pseudo_id = 'XYZ_REPLACE_ME'
ORDER BY event_timestamp
LIMIT 20;
```

```sql
-- 7. Description: find session_start events that fall 8‑14 days after first engagement
WITH base AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS first_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
  GROUP BY user_pseudo_id
)
SELECT b.user_pseudo_id,
       TIMESTAMP_MICROS(e.event_timestamp) AS second_week_session
FROM base b
JOIN `firebase-public-project.analytics_153293282.events_*` e
ON  e.user_pseudo_id = b.user_pseudo_id
WHERE e.event_name = 'session_start'
  AND DATE_DIFF(
        DATE(TIMESTAMP_MICROS(e.event_timestamp)),
        DATE(TIMESTAMP_MICROS(b.first_ts)),
        DAY) BETWEEN 8 AND 14
LIMIT 20;
```

```sql
-- 8. Description: combine quick‑play event type with second‑week retention flag
WITH first_quickplay AS (
  SELECT user_pseudo_id,
         MIN_BY(event_name, event_timestamp) AS quickplay_event, -- BigQuery 1.34+
         MIN(event_timestamp) AS first_qp_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
    AND event_name LIKE 'quickplay%'
  GROUP BY user_pseudo_id
),
second_week AS (
  SELECT user_pseudo_id
  FROM first_quickplay fp
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = fp.user_pseudo_id
  WHERE e.event_name = 'session_start'
    AND DATE_DIFF(
          DATE(TIMESTAMP_MICROS(e.event_timestamp)),
          DATE(TIMESTAMP_MICROS(fp.first_qp_ts)),
          DAY) BETWEEN 8 AND 14
  GROUP BY user_pseudo_id
)
SELECT *
FROM first_quickplay
LEFT JOIN second_week USING(user_pseudo_id)
LIMIT 20;
```

```sql
-- 9. Description: calculate counts & retention rate for each quick‑play event
WITH first_quickplay AS (
  SELECT user_pseudo_id,
         MIN_BY(event_name, event_timestamp) AS quickplay_event,
         MIN(event_timestamp) AS first_qp_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
    AND event_name LIKE 'quickplay%'
  GROUP BY user_pseudo_id
),
second_week AS (
  SELECT DISTINCT fp.user_pseudo_id
  FROM first_quickplay fp
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = fp.user_pseudo_id
  WHERE e.event_name = 'session_start'
    AND DATE_DIFF(
          DATE(TIMESTAMP_MICROS(e.event_timestamp)),
          DATE(TIMESTAMP_MICROS(fp.first_qp_ts)),
          DAY) BETWEEN 8 AND 14
)
SELECT quickplay_event,
       COUNT(DISTINCT fp.user_pseudo_id)                        AS cohort_users,
       COUNT(DISTINCT sw.user_pseudo_id)                        AS retained_users,
       SAFE_DIVIDE(COUNT(DISTINCT sw.user_pseudo_id),
                   COUNT(DISTINCT fp.user_pseudo_id)) AS retention_rate
FROM first_quickplay fp
LEFT JOIN second_week sw
  ON fp.user_pseudo_id = sw.user_pseudo_id
GROUP BY quickplay_event
ORDER BY retention_rate
LIMIT 20;
```

```sql
-- 10. Description: final answer – the quick‑play event type with the LOWEST 2nd‑week retention
WITH first_quickplay AS (
  SELECT user_pseudo_id,
         MIN_BY(event_name, event_timestamp) AS quickplay_event,
         MIN(event_timestamp) AS first_qp_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
    AND event_name LIKE 'quickplay%'
  GROUP BY user_pseudo_id
),
second_week AS (
  SELECT DISTINCT fp.user_pseudo_id
  FROM first_quickplay fp
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = fp.user_pseudo_id
  WHERE e.event_name = 'session_start'
    AND DATE_DIFF(
          DATE(TIMESTAMP_MICROS(e.event_timestamp)),
          DATE(TIMESTAMP_MICROS(fp.first_qp_ts)),
          DAY) BETWEEN 8 AND 14
),
rates AS (
  SELECT quickplay_event,
         COUNT(DISTINCT fp.user_pseudo_id)                        AS cohort_users,
         COUNT(DISTINCT sw.user_pseudo_id)                        AS retained_users,
         SAFE_DIVIDE(COUNT(DISTINCT sw.user_pseudo_id),
                     COUNT(DISTINCT fp.user_pseudo_id)) AS retention_rate
  FROM first_quickplay fp
  LEFT JOIN second_week sw
    ON fp.user_pseudo_id = sw.user_pseudo_id
  GROUP BY quickplay_event
)
SELECT quickplay_event,
       cohort_users,
       retained_users,
       retention_rate
FROM rates
ORDER BY retention_rate ASC
LIMIT 1;
```

