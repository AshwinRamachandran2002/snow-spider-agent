```sql
--Description / Thinking process:
-- 1. The dataset is daily‑sharded, so filtering on _TABLE_SUFFIX limits the scan
--    to the 15 daily partitions we need (20180801‑20180815).
-- 2. “quickplay” appears at the END of many event names (e.g. level_start_quickplay)
--    but sometimes in the middle (e.g. level_retry_quickplay).  Using
--    LIKE '%quickplay%' guarantees we catch every variation.
-- 3. We GROUP BY event_name to produce one row per distinct “…quickplay…” type
--    and COUNT(*) to see how often each was triggered.
-- 4. ORDER BY total_events DESC shows the most common first;
--    LIMIT 20 keeps the preview short in the console.
SELECT
  event_name AS quickplay_event,
  COUNT(*)   AS total_events
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
  AND LOWER(event_name) LIKE '%quickplay%'
GROUP BY quickplay_event
ORDER BY total_events DESC
LIMIT 20;
```
