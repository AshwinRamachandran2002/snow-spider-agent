Query:
--Description: Count distinct U.S. B2 patents granted from 2008‑01‑01 through
-- 2018‑12‑31 that contain at least one plain‑text claim whose content does NOT
-- include the word “claim”.  We first ensure each publication actually has
-- claim data, then flatten the "claims_localized" array, filter the text, and
-- return the final count.
SELECT
    COUNT(DISTINCT t."publication_number") AS "patent_count_no_claim_word"
FROM "PATENTS"."PATENTS"."PUBLICATIONS" t,
     LATERAL FLATTEN(input => t."claims_localized") f
WHERE t."country_code"  = 'US'
  AND t."kind_code"     = 'B2'
  AND t."grant_date" BETWEEN 20080101 AND 20181231
  AND t."claims_localized" IS NOT NULL
  AND f.value:"text"::STRING NOT ILIKE '%claim%'
