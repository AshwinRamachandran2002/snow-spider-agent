```sql
-- Purpose:  Count all US patents with kind code B2 that were granted between
--           1‑Jan‑2008 and 31‑Dec‑2018 whose claims *never* contain the substring “claim”.
-- Reasoning steps (expressed as comments so only one SQL block is output):
--   1) PUBLICATIONS is the only table that stores claims text (claims_localized).
--   2) Filter rows for US country_code, B2 kind_code, and grant_date in the desired range.
--   3) LATERAL FLATTEN turns the VARIANT array claims_localized into one row per claim.
--   4) For each patent, determine whether ANY claim includes the word “claim”
--      (case‑insensitive) by computing MAX over a 1/0 flag.
--   5) Patents for which that MAX = 0 have no such word in any claim;
--      count those patents.

WITH flagged AS (
    SELECT
        p."publication_number",
        MAX(
            CASE
                WHEN LOWER(f.value:"text"::STRING) ILIKE '%claim%' THEN 1
                ELSE 0
            END
        ) AS has_word_claim
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."claims_localized") f
    WHERE p."country_code" = 'US'
      AND p."kind_code"    = 'B2'
      AND p."grant_date"   BETWEEN 20080101 AND 20181231
    GROUP BY p."publication_number"
)
SELECT COUNT(*) AS "num_us_b2_patents_no_word_claim"
FROM   flagged
WHERE  has_word_claim = 0;
```
