```sql
--Description: 
-- Fetch 20 multipolygons that overlap the multipolygon tagged with wikidata = 'Q191'
-- and ensure those candidates carry NO own 'wikidata' tag.
-- Strategy
--   1. q191 CTE → obtain geometry of the single multipolygon whose tag ("key"='wikidata',"value"='Q191').
--   2. Outer query →
--        • filter PLANET_FEATURES to 'multipolygons';
--        • keep only rows whose geometry ST_INTERSECTS q191.geom;
--        • apply NOT EXISTS with LATERAL FLATTEN to reject any polygon that has a 'wikidata' tag.
--   3. Return osm_id, osm_way_id, and all_tags (LIMIT 20) for inspection.

WITH q191 AS (                                                     
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
         LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE pf."feature_type" = 'multipolygons'
      AND tag.value:"key"::STRING   = 'wikidata'
      AND tag.value:"value"::STRING = 'Q191'
    LIMIT 1
)
SELECT
    cand."osm_id",
    cand."osm_way_id",
    cand."all_tags"
FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES AS cand,
     q191                               -- CROSS JOIN so q191.geom is in scope
WHERE cand."feature_type" = 'multipolygons'
  AND ST_INTERSECTS(TO_GEOGRAPHY(cand."geometry"), q191.geom)
  AND NOT EXISTS (                       -- exclude any candidate that has its own wikidata tag
        SELECT 1
        FROM LATERAL FLATTEN(input => cand."all_tags") t
        WHERE t.value:"key"::STRING = 'wikidata'
  )
LIMIT 20;
```
