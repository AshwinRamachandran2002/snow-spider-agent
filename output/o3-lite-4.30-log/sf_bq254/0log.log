```sql
--Description:
-- Objective → For every multipolygon that
--      (a) intersects the multipolygon whose tag is wikidata = 'Q191',
--      (b) has NO own ‘wikidata’ tag,
--   count how many point‑features (PLANET_FEATURES_POINTS) lie inside it,
--   and list the 20 highest counts.
--
-- Implementation outline (all in one query via CTEs):
--   1. q191        : retrieve geometry of the reference multipolygon (wikidata = 'Q191').
--   2. candidates  : select multipolygons that spatially intersect q191.geom
--                    and confirm the absence of a wikidata tag using NOT EXISTS +
--                    LATERAL FLATTEN (this avoids the “unsupported subquery type” error).
--   3. point_count : join each candidate with points through ST_CONTAINS and aggregate.
--
WITH q191 AS (                                                          -- 1) reference polygon
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES    pf,
         LATERAL FLATTEN(input => pf."all_tags")                tag
    WHERE pf."feature_type"            = 'multipolygons'
      AND tag.value:"key"::STRING      = 'wikidata'
      AND tag.value:"value"::STRING    = 'Q191'
    LIMIT 1
),
candidates AS (                                                         -- 2) polys intersecting q191 & w/out wikidata
    SELECT cand."osm_id",
           cand."geometry"
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES    cand,
         q191                                   -- cross‑join to access q191.geom
    WHERE cand."feature_type" = 'multipolygons'
      AND ST_INTERSECTS(TO_GEOGRAPHY(cand."geometry"), q191.geom)
      AND NOT EXISTS (                           -- ensure the polygon has no wikidata tag
            SELECT 1
            FROM LATERAL FLATTEN(input => cand."all_tags") t
            WHERE t.value:"key"::STRING = 'wikidata'
      )
),
point_count AS (                                                        -- 3) count points inside each candidate
    SELECT 
        c."osm_id"                         AS poly_id,
        COUNT(*)                           AS pts_inside
    FROM candidates               AS c
    JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS p
      ON p."geometry" IS NOT NULL
     AND ST_CONTAINS(
            TO_GEOGRAPHY(c."geometry"),
            TO_GEOGRAPHY(p."geometry")
         )
    GROUP BY c."osm_id"
)
SELECT *
FROM point_count
ORDER BY pts_inside DESC
LIMIT 20;
