-- 1. q191: grab the geometry of the multipolygon whose all_tags contain ("key"='wikidata',"value"='Q191').
-- 2. Outer query scans every multipolygon; keeps those that
--      • intersect the q191 geometry (ST_INTERSECTS),
--      • have NO own ‘wikidata’ tag (checked via NOT EXISTS with LATERAL FLATTEN).
--    Returns 20 rows (osm_id, osm_way_id, all_tags) for verification.

WITH q191 AS (                           
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
         LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE pf."feature_type" = 'multipolygons'
      AND tag.value:"key"::STRING  = 'wikidata'
      AND tag.value:"value"::STRING = 'Q191'
    LIMIT 1
)
