        c."osm_id",
        COUNT(*) AS pts_inside
    FROM candidates c
    JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS p
      ON p."geometry" IS NOT NULL
     AND ST_CONTAINS(TO_GEOGRAPHY(c."geometry"), TO_GEOGRAPHY(p."geometry"))
    GROUP BY c."osm_id"
),

named AS (        -- fetch the “name” tag for every candidate
    SELECT
        pc."osm_id",
        pc.pts_inside,
        MAX(
            CASE 
                WHEN t.value:"key"::STRING = 'name' 
                THEN t.value:"value"::STRING 
