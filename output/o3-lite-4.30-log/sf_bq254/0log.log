--Description:
-- Return the TWO multipolygons that:
--   • intersect the multipolygon whose tag (“wikidata” = ‘Q191’);
--   • have NO own ‘wikidata’ tag;
--   • contain the greatest number of point features.
-- The query is arranged in four CTEs, each avoiding LEFT‑JOIN‑LATERAL (which Snowflake cannot evaluate)
-- by using NOT EXISTS with LATERAL FLATTEN.
--   1. q191         – geometry of the reference multipolygon (wikidata = Q191).
--   2. candidates   – every multipolygon intersecting q191.geom and lacking any wikidata tag.
--   3. point_counts – count of PLANET_FEATURES_POINTS inside each candidate polygon.
--   4. ranked       – attach the “name” tag to each candidate and keep the top two by point count.
-- Final SELECT shows their names and point totals.

WITH q191 AS (                                        -- 1) reference multipolygon
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
         LATERAL FLATTEN(input => pf."all_tags") t
    WHERE pf."feature_type"            = 'multipolygons'
      AND t.value:"key"::STRING        = 'wikidata'
      AND t.value:"value"::STRING      = 'Q191'
    LIMIT 1
),
candidates AS (                                       -- 2) intersecting polys w/out wikidata tag
    SELECT cand."osm_id",
           cand."geometry",
           cand."all_tags"
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES cand,
         q191                                   -- cross‑join to use q191.geom
    WHERE cand."feature_type" = 'multipolygons'
      AND ST_INTERSECTS(TO_GEOGRAPHY(cand."geometry"), q191.geom)
      AND NOT EXISTS (
          SELECT 1
          FROM LATERAL FLATTEN(input => cand."all_tags") t
          WHERE t.value:"key"::STRING = 'wikidata'
      )
),
point_counts AS (                                    -- 3) count points inside each candidate
    SELECT 
        c."osm_id",
        COUNT(*) AS pts_inside
    FROM candidates c
    JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS p
      ON p."geometry" IS NOT NULL
     AND ST_CONTAINS(
            TO_GEOGRAPHY(c."geometry"),
            TO_GEOGRAPHY(p."geometry")
         )
    GROUP BY c."osm_id"
),
ranked AS (                                          -- 4) attach name tag, order by count
    SELECT 
        pc."osm_id",
        pc.pts_inside,
        MAX(
            CASE 
                WHEN tag.value:"key"::STRING = 'name'
                THEN tag.value:"value"::STRING
            END
        ) AS name
    FROM point_counts pc
    JOIN candidates c
      ON c."osm_id" = pc."osm_id"
    ,  LATERAL FLATTEN(input => c."all_tags") tag
    GROUP BY pc."osm_id", pc.pts_inside
    ORDER BY pc.pts_inside DESC
    LIMIT 2
)
SELECT name, pts_inside
FROM ranked;
```
