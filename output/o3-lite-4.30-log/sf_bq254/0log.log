WITH q191 AS (   -- geometry of the multipolygon that has wikidata = 'Q191'
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
         LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE pf."feature_type" = 'multipolygons'
      AND tag.value:"key"::STRING  = 'wikidata'
      AND tag.value:"value"::STRING = 'Q191'
    LIMIT 1
),

candidates AS (  -- multipolygons in the same area, *without* a wikidata tag
    SELECT pf."osm_id",
           pf."geometry",
           pf."all_tags"
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf
    CROSS JOIN q191
    WHERE pf."feature_type" = 'multipolygons'
      AND pf."geometry" IS NOT NULL
      AND ST_INTERSECTS(TO_GEOGRAPHY(pf."geometry"), q191.geom)
      AND NOT EXISTS (        -- ensure no wikidata tag
          SELECT 1
          FROM LATERAL FLATTEN(input => pf."all_tags") t
          WHERE t.value:"key"::STRING = 'wikidata'
      )
),

point_counts AS (  -- count points that fall inside each candidate polygon
