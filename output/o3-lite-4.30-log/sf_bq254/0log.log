--Description: 
-- Produce the final answer in one shot:
--   • Identify the multipolygon whose tag is wikidata = 'Q191' (q191 CTE).
--   • Select every other multipolygon that (i) intersects q191 and (ii) has NO own wikidata tag (candidates CTE).
--   • Count how many PLANET_FEATURES_POINTS fall inside each candidate (point_counts CTE).
--   • Extract the “name” tag for each candidate and keep the two with the highest point count (top_two CTE).
--   The final SELECT returns those two names and their point totals.

WITH q191 AS (                               -- reference multipolygon (wikidata = Q191)
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf
    ,    LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE pf."feature_type"            = 'multipolygons'
      AND tag.value:"key"::STRING      = 'wikidata'
      AND tag.value:"value"::STRING    = 'Q191'
    LIMIT 1
),
candidates AS (                              -- multipolygons intersecting q191 & lacking wikidata
    SELECT cand."osm_id",
           cand."geometry",
           cand."all_tags"
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES cand
    ,     q191                               -- cross‑join to access q191.geom
    WHERE cand."feature_type" = 'multipolygons'
      AND ST_INTERSECTS(TO_GEOGRAPHY(cand."geometry"), q191.geom)
      AND NOT EXISTS (                       -- ensure NO wikidata tag on candidate
            SELECT 1
            FROM LATERAL FLATTEN(input => cand."all_tags") t
            WHERE t.value:"key"::STRING = 'wikidata'
      )
),
point_counts AS (                            -- number of points inside each candidate
    SELECT 
        c."osm_id"                   AS poly_id,
        COUNT(*)                     AS pts_inside
    FROM candidates c
    JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS p
      ON p."geometry" IS NOT NULL
     AND ST_CONTAINS(
            TO_GEOGRAPHY(c."geometry"),
            TO_GEOGRAPHY(p."geometry")
         )
    GROUP BY c."osm_id"
),
top_two AS (                                 -- add name tag and keep top 2 by point count
    SELECT 
        pc.poly_id,
        pc.pts_inside,
        MAX(CASE 
                WHEN t.value:"key"::STRING = 'name' 
                THEN t.value:"value"::STRING 
            END) AS name
    FROM point_counts pc
    JOIN candidates cand
      ON cand."osm_id" = pc.poly_id
    ,  LATERAL FLATTEN(input => cand."all_tags") t
    GROUP BY pc.poly_id, pc.pts_inside
    ORDER BY pc.pts_inside DESC
    LIMIT 2
)
SELECT name, pts_inside
FROM top_two;
```
