```sql
--Description: 
-- Goal → return the two multipolygons that
--   • intersect the reference multipolygon whose tag wikidata = 'Q191';
--   • have NO own ‘wikidata’ tag;
--   • contain the greatest number of points (from PLANET_FEATURES_POINTS);
--   • and show their “name” plus the point‑count.
--
-- CTEs
--   1. q191        : grab geometry of the Q191 object.
--   2. candidates  : every other multipolygon intersecting q191 and lacking wikidata.
--   3. point_hits  : pairs (candidate‑id, point) where point is inside candidate polygon.
--   4. counts      : total number of points per candidate polygon.
--   5. names_rank  : attach the “name” tag, rank by count.
--
WITH q191 AS (                           -- 1) Q191 multipolygon
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
         LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE pf."feature_type" = 'multipolygons'
      AND tag.value:"key"::STRING  = 'wikidata'
      AND tag.value:"value"::STRING = 'Q191'
    LIMIT 1
),
candidates AS (                          -- 2) intersecting multipolygons w/o wikidata
    SELECT cand."osm_id",
           cand."geometry",
           cand."all_tags"
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES cand
    JOIN q191
      ON ST_INTERSECTS(TO_GEOGRAPHY(cand."geometry"), q191.geom)
    WHERE cand."feature_type" = 'multipolygons'
      AND NOT EXISTS (
            SELECT 1
            FROM LATERAL FLATTEN(input => cand."all_tags") t
            WHERE t.value:"key"::STRING = 'wikidata'
      )
),
point_hits AS (                          -- 3) every point contained in each candidate
    SELECT c."osm_id" AS poly_id
    FROM candidates c
    JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS p
      ON p."geometry" IS NOT NULL
     AND ST_CONTAINS(
            TO_GEOGRAPHY(c."geometry"),
            TO_GEOGRAPHY(p."geometry")
         )
),
counts AS (                              -- 4) count points per candidate
    SELECT poly_id,
           COUNT(*) AS pts_inside
    FROM point_hits
    GROUP BY poly_id
),
names_rank AS (                          -- 5) attach 'name' tag and rank
    SELECT 
        cnt.poly_id,
        cnt.pts_inside,
        MAX(
            CASE
                WHEN t.value:"key"::STRING = 'name'
                THEN t.value:"value"::STRING
            END
        ) AS name
    FROM counts cnt
    JOIN candidates c
      ON c."osm_id" = cnt.poly_id
    ,  LATERAL FLATTEN(input => c."all_tags") t
    GROUP BY cnt.poly_id, cnt.pts_inside
)
SELECT name, pts_inside
FROM names_rank
ORDER BY pts_inside DESC
LIMIT 2;      -- top two multipolygons by point count
```
