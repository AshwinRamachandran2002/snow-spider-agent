--Description: 9️⃣  Rank all candidate multipolygons by the number of internal
--             points and keep only the top two.
WITH ranked AS (                                                 -- bring step 8 logic here
    WITH q191 AS (
        SELECT ST_GEOGFROMWKB("geometry") AS geom
        FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
               LATERAL FLATTEN( input => PARSE_JSON(pf."all_tags") ) f
        WHERE  pf."feature_type" = 'multipolygons'
          AND  f.value:"key"   = 'wikidata'
          AND  f.value:"value" = 'Q191'
        LIMIT 1
    ),
    candidates AS (
        SELECT  p."osm_id",
                p."all_tags",
                p."geometry"
        FROM    GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p
        JOIN    q191
          ON    ST_INTERSECTS(q191.geom, ST_GEOGFROMWKB(p."geometry"))
        CROSS JOIN LATERAL FLATTEN( input => PARSE_JSON(p."all_tags"),
                                    outer => TRUE ) f
        WHERE   p."feature_type" = 'multipolygons'
        GROUP BY p."osm_id", p."all_tags", p."geometry"
        HAVING  MAX( CASE WHEN f.value:"key" = 'wikidata' THEN 1 ELSE 0 END ) = 0
    ),
    points AS (
        SELECT ST_GEOGFROMWKB("geometry") AS geo_pt
        FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS
        WHERE  "geometry" IS NOT NULL
    )
    SELECT  c."osm_id",
            MIN( CASE WHEN f2.value:"key" = 'name'
                      THEN f2.value:"value" END ) AS "name",
            COUNT(*)                              AS pts_inside
    FROM    candidates c
    CROSS JOIN LATERAL FLATTEN( input => PARSE_JSON(c."all_tags"),
                                outer => TRUE ) f2
    JOIN    points p
      ON    ST_CONTAINS(ST_GEOGFROMWKB(c."geometry"), p.geo_pt)
    GROUP BY c."osm_id"
)
SELECT *
FROM   ranked
QUALIFY ROW_NUMBER() OVER (ORDER BY pts_inside DESC) <= 2
