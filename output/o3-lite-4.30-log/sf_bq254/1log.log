WITH q191 AS (  -- geometry of the multipolygon whose wikidata tag = 'Q191' (Estonia)
    SELECT ST_GEOGFROMWKB(pf."geometry") AS geom
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
           LATERAL FLATTEN ( INPUT => PARSE_JSON(pf."all_tags") ) f
    WHERE  pf."feature_type" = 'multipolygons'
      AND  f.value:"key"   = 'wikidata'
      AND  f.value:"value" = 'Q191'
    LIMIT 1
),
candidate_polys AS (  -- multipolygons that intersect Q191 and have NO wikidata tag
    SELECT  p."osm_id",
            ST_GEOGFROMWKB(p."geometry")                       AS geog,
            MAX(IFF(f.value:"key" = 'name',
                    f.value:"value", NULL))                    AS name
    FROM    GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p
    JOIN    q191
      ON    ST_INTERSECTS(q191.geom, ST_GEOGFROMWKB(p."geometry"))
    ,      LATERAL FLATTEN ( INPUT => PARSE_JSON(p."all_tags") ) f
    WHERE   p."feature_type" = 'multipolygons'
    GROUP  BY p."osm_id", p."geometry"
    HAVING  MAX(CASE WHEN f.value:"key" = 'wikidata' THEN 1 ELSE 0 END) = 0
),
point_features AS (  -- all point geometries
    SELECT ST_GEOGFROMWKB("geometry") AS geo_pt
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS
    WHERE  "geometry" IS NOT NULL
),
poly_point_counts AS (  -- point count inside each candidate polygon (only with a name)
    SELECT  c."osm_id",
            c.name,
            COUNT(*)                       AS pts_inside
    FROM    candidate_polys c
    JOIN    point_features p
      ON    ST_CONTAINS(c.geog, p.geo_pt)
    WHERE   c.name IS NOT NULL
    GROUP  BY c."osm_id", c.name
)
SELECT REGEXP_REPLACE(cast(name AS STRING), '\"', '') AS name
FROM   poly_point_counts
ORDER  BY pts_inside DESC NULLS LAST, name
LIMIT 2;
