```sql
--Description: 7️⃣  Retrieve point features that lie within 1 000 km of the Q191 multipolygon
WITH q191 AS (
    SELECT ST_GEOGFROMWKB("geometry") AS geom
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
           LATERAL FLATTEN(input => PARSE_JSON(pf."all_tags")) f
    WHERE  pf."feature_type" = 'multipolygons'
      AND  f.value:"key"   = 'wikidata'
      AND  f.value:"value" = 'Q191'
    LIMIT 1
)
SELECT p.*
FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS p, q191
WHERE  p."geometry" IS NOT NULL
  AND  ST_DWITHIN(q191.geom, ST_GEOGFROMWKB(p."geometry"), 1000000)   -- 1 000 000 m window
LIMIT 20;
```

```sql
--Description: 8️⃣  Count how many points fall INSIDE each candidate multipolygon
WITH q191 AS (                                                   -- Q191 geometry
    SELECT ST_GEOGFROMWKB("geometry") AS geom
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
           LATERAL FLATTEN(input => PARSE_JSON(pf."all_tags")) f
    WHERE  pf."feature_type" = 'multipolygons'
      AND  f.value:"key"   = 'wikidata'
      AND  f.value:"value" = 'Q191'
    LIMIT 1
),
candidates AS (                                                  -- polys intersecting Q191 w/o wikidata
    SELECT p.*
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p, q191
    WHERE  p."feature_type" = 'multipolygons'
      AND  ST_INTERSECTS(q191.geom, ST_GEOGFROMWKB(p."geometry"))
      AND NOT EXISTS (
            SELECT 1
            FROM   LATERAL FLATTEN(input => PARSE_JSON(p."all_tags")) f
            WHERE  f.value:"key" = 'wikidata'
          )
),
points AS (                                                      -- all points as GEOGRAPHY objects
    SELECT ST_GEOGFROMWKB("geometry") AS geo_pt
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS
    WHERE  "geometry" IS NOT NULL
)
SELECT  c."osm_id",
        ( SELECT f.value:"value"
          FROM   LATERAL FLATTEN(input => PARSE_JSON(c."all_tags")) f
          WHERE  f.value:"key" = 'name'
          LIMIT 1)                       AS "name",
        COUNT(*)                         AS pts_inside
FROM    candidates c
JOIN    points p
  ON    ST_CONTAINS(ST_GEOGFROMWKB(c."geometry"), p.geo_pt)
GROUP BY 1,2
ORDER BY pts_inside DESC
LIMIT 20;
```

