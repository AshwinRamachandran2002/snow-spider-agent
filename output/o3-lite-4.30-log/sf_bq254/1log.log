--      geometry to GEOGRAPHY, and keeps only those that intersect the Q191
--      polygon via ST_INTERSECTS.  For each match we also compute the surface
--      area (ST_AREA) as a quick attribute to inspect later.
--   3. LIMIT 20 – restrict output to 20 rows for a manageable preview.
WITH q191 AS (
    SELECT ST_GEOGFROMWKB("geometry") AS geom
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
           LATERAL FLATTEN(input => PARSE_JSON(pf."all_tags")) f
    WHERE  pf."feature_type" = 'multipolygons'
      AND  f.value:"key"   = 'wikidata'
      AND  f.value:"value" = 'Q191'
    LIMIT 1
)
SELECT  p."osm_id",
        ST_AREA(ST_GEOGFROMWKB(p."geometry")) AS "area_m2",
        p."all_tags"
FROM    GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p,
        q191
WHERE   p."feature_type" = 'multipolygons'
  AND   ST_INTERSECTS(q191.geom, ST_GEOGFROMWKB(p."geometry"))
LIMIT   20;
