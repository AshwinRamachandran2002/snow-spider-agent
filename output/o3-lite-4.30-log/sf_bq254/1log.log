Query:
--Description: 7️⃣  Retrieve up to 20 point features whose geometries sit within
--             1 000 km of the Q191 multipolygon.  A broad spatial filter is used
--             solely for performance; deeper containment checks come later.
WITH q191 AS (
    SELECT ST_GEOGFROMWKB("geometry") AS geom
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
           LATERAL FLATTEN( input => PARSE_JSON(pf."all_tags") ) f
    WHERE  pf."feature_type" = 'multipolygons'
      AND  f.value:"key"   = 'wikidata'
      AND  f.value:"value" = 'Q191'
    LIMIT 1
)
SELECT p."osm_id",
       p."all_tags",
       p."osm_timestamp",
       ST_GEOGFROMWKB(p."geometry") AS geo_pt
FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS p,
       q191
WHERE  p."geometry" IS NOT NULL
  AND  ST_DWITHIN(q191.geom, ST_GEOGFROMWKB(p."geometry"), 1000000)   -- 1 000 000 m
LIMIT 20
