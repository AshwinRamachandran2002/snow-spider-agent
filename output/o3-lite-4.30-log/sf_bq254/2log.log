--Description:
-- Count, for each multipolygon that (a) intersects the multipolygon tagged
-- wikidata = 'Q191' and (b) does NOT itself have a ‘wikidata’ tag, how many
-- point features intersect its geometry; list the 20 largest counts.
--
-- 1. q191  : grab the GEOGRAPHY geometry of the single multipolygon whose
--            tag wikidata = Q191.  Using LATERAL FLATTEN avoids a correlated
--            sub‑query error.
-- 2. raw   : fetch every multipolygon whose geometry intersects q191.geom,
--            emitting one row per tag key so we can later test for the
--            presence of a wikidata tag.
-- 3. candidates : keep exactly one row per polygon **only if** the windowed
--            sum of wikidata tags over that polygon equals zero (thus
--            excluding polygons already tagged with wikidata).
-- 4. point_counts : spatially join each candidate polygon with
--            PLANET_FEATURES_POINTS and count the number of points whose
--            geometries intersect the polygon (ST_INTERSECTS).
-- 5. Return the 20 polygons with the highest point totals.

WITH q191 AS (      ----------------------------------------------------------
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
           LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE  pf."feature_type"        = 'multipolygons'
      AND  tag.value:"key"::STRING   = 'wikidata'
      AND  tag.value:"value"::STRING = 'Q191'
    LIMIT 1
),
raw AS (           ------------------------------------------------------------
    SELECT pf."osm_way_id",
           TO_GEOGRAPHY(pf."geometry")           AS poly_geom,
           tag.value:"key"::STRING               AS tag_key
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
           q191,
           LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE  pf."feature_type" = 'multipolygons'
      AND  ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), q191.geom )
),
candidates AS (    ------------------------------------------------------------
    SELECT r."osm_way_id",
           r."poly_geom"
    FROM   raw r
    QUALIFY SUM( IFF(r.tag_key = 'wikidata', 1, 0) )
            OVER (PARTITION BY r."osm_way_id") = 0   -- exclude if wikidata tag
),
point_counts AS (  ------------------------------------------------------------
    SELECT c."osm_way_id",
           COUNT(*) AS pt_in_poly
    FROM   candidates c
           JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS pp
             ON pp."geometry" IS NOT NULL
            AND ST_INTERSECTS( c."poly_geom", TO_GEOGRAPHY(pp."geometry") )
    GROUP  BY c."osm_way_id"
)
SELECT *
FROM   point_counts
ORDER  BY pt_in_poly DESC
LIMIT 20;
