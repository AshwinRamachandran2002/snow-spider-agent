--Description:
-- Count how many point features intersect each multipolygon that
--   • intersects the multipolygon whose tag wikidata = 'Q191', and
--   • has NO own tag with key = 'wikidata'.
--
-- Technique
-- 1. q191 CTE   : obtain GEOGRAPHY of the single multipolygon tagged Q191.
-- 2. raw CTE    : for every multipolygon intersecting q191.geom, output one
--                 row per tag so we can check whether it contains a wikidata tag.
-- 3. candidates : use QUALIFY to keep exactly one geometry row per polygon
--                 when the windowed SUM of wikidata tags equals zero; the
--                 ROW_NUMBER() call selects that single row without
--                 aggregating GEOGRAPHY (avoids earlier MAX error).
-- 4. Final      : spatially join candidates to point features and count
--                 intersections; show top‑20 polygons by point count.

WITH q191 AS (                     -- reference multipolygon (wikidata = Q191)
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
           LATERAL FLATTEN(input => pf."all_tags") t
    WHERE  pf."feature_type"        = 'multipolygons'
      AND  t.value:"key"::STRING     = 'wikidata'
      AND  t.value:"value"::STRING   = 'Q191'
    LIMIT 1
),
raw AS (                           -- every tag row for each intersecting poly
    SELECT pf."osm_way_id",
           TO_GEOGRAPHY(pf."geometry")            AS poly_geom,
           tag_row.value:"key"::STRING            AS tag_key
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
           q191,
           LATERAL FLATTEN(input => pf."all_tags") tag_row
    WHERE  pf."feature_type" = 'multipolygons'
      AND  ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), q191.geom )
),
candidates AS (                    -- polygons without wikidata tag (one row)
    SELECT r."osm_way_id",
           r."poly_geom"
    FROM   raw r
    QUALIFY SUM( IFF(r.tag_key = 'wikidata', 1, 0) )
              OVER (PARTITION BY r."osm_way_id") = 0      -- lacks wikidata tag
        AND ROW_NUMBER() OVER (PARTITION BY r."osm_way_id") = 1   -- single row
)
SELECT c."osm_way_id",
       COUNT(*) AS pt_in_poly
FROM   candidates c
JOIN   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS pp
  ON   pp."geometry" IS NOT NULL
 AND   ST_INTERSECTS( c."poly_geom", TO_GEOGRAPHY(pp."geometry") )
GROUP  BY c."osm_way_id"
ORDER  BY pt_in_poly DESC
LIMIT 20;
