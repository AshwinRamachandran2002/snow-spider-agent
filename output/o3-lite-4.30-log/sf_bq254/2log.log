--Description:
-- 6. Retrieve the names of multipolygons that
--    a) intersect the Q191 multipolygon, and
--    b) have NO ‘wikidata’ tag themselves.
WITH q191 AS (
    -- geometry of the reference multipolygon (wikidata = Q191)
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf ,
           LATERAL FLATTEN ( input => pf."all_tags" ) t
    WHERE  pf."feature_type"        = 'multipolygons'
      AND  t.value:"key"::STRING     = 'wikidata'
      AND  t.value:"value"::STRING   = 'Q191'
    LIMIT 1
),
candidates AS (
    -- multipolygons that intersect q191.geom (tags flattened)
    SELECT pf."osm_way_id",
           MAX( IFF( f.value:"key"::STRING = 'name'
                   , f.value:"value"::STRING
                   , NULL) ) AS candidate_name
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf ,
           q191 ,
           LATERAL FLATTEN ( input => pf."all_tags" ) f
    WHERE  pf."feature_type" = 'multipolygons'
      AND  ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), q191.geom )
    GROUP  BY pf."osm_way_id"
    HAVING SUM( IFF( f.value:"key"::STRING = 'wikidata', 1, 0) ) = 0
)
SELECT *
FROM   candidates
LIMIT 20;
