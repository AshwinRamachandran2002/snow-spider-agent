```sql
--Description:
-- 8. Count how many points fall inside every candidate multipolygon
--    (intersecting Q191 and lacking a wikidata tag).
WITH q191 AS (
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf ,
           LATERAL FLATTEN ( input => pf."all_tags" ) t
    WHERE  pf."feature_type"      = 'multipolygons'
      AND  t.value:"key"::STRING   = 'wikidata'
      AND  t.value:"value"::STRING = 'Q191'
    LIMIT 1
),
candidates AS (
    SELECT pf."osm_way_id",
           TO_GEOGRAPHY(pf."geometry") AS poly_geom
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf ,
           q191
    WHERE  pf."feature_type" = 'multipolygons'
      AND  ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), q191.geom )
),                                -- flatten tags to filter out wikidata
filtered AS (
    SELECT c."osm_way_id",
           c."poly_geom"
    FROM   candidates c ,
           LATERAL FLATTEN ( input => (
               SELECT pf."all_tags"
               FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf
               WHERE pf."osm_way_id" = c."osm_way_id"
           )) f
    GROUP  BY c."osm_way_id", c."poly_geom"
    HAVING SUM( IFF( f.value:"key"::STRING = 'wikidata', 1, 0) ) = 0
)
SELECT f."osm_way_id",
       COUNT(*) AS pt_in_poly
FROM   filtered f
JOIN   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS pp
  ON   ST_CONTAINS( f."poly_geom", TO_GEOGRAPHY(pp."geometry") )
GROUP BY f."osm_way_id"
ORDER BY pt_in_poly DESC
LIMIT 20;
```

```sql
--Description:
-- 9. Return each candidate’s name and the number of interior points
--    (top 10 by count).
WITH q191 AS (
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf ,
           LATERAL FLATTEN ( input => pf."all_tags" ) t
    WHERE  pf."feature_type"      = 'multipolygons'
      AND  t.value:"key"::STRING   = 'wikidata'
      AND  t.value:"value"::STRING = 'Q191'
    LIMIT 1
),
raw AS (
    -- intersecting polys & all their tags
    SELECT pf."osm_way_id",
           TO_GEOGRAPHY(pf."geometry")           AS poly_geom,
           f.value:"key"::STRING                 AS tag_key,
           f.value:"value"::STRING               AS tag_val
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf ,
           q191 ,
           LATERAL FLATTEN ( input => pf."all_tags" ) f
    WHERE  pf."feature_type" = 'multipolygons'
      AND  ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), q191.geom )
),
candidates AS (
    -- keep only polygons without wikidata; collect name
    SELECT r."osm_way_id",
           MAX( IFF( r.tag_key = 'name', r.tag_val, NULL) ) AS poly_name,
           MAX( r.poly_geom )                              AS poly_geom
    FROM   raw r
    GROUP  BY r."osm_way_id"
    HAVING SUM( IFF( r.tag_key = 'wikidata', 1, 0) ) = 0
)
SELECT c."poly_name",
       c."osm_way_id",
       COUNT(*) AS pt_in_poly
FROM   candidates c
JOIN   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS pp
  ON   ST_CONTAINS( c.poly_geom , TO_GEOGRAPHY(pp."geometry") )
GROUP  BY c."poly_name", c."osm_way_id"
ORDER  BY pt_in_poly DESC
LIMIT 10;
```

