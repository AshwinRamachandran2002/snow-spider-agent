```sql
--Description:
-- Find up to 20 multipolygons that
--   1) spatially intersect the reference multipolygon whose tag wikidata = 'Q191'
--   2) do NOT possess any tag with key = 'wikidata' themselves.
-- Approach
--   A. CTE q191: fetch the GEOGRAPHY geometry of the single multipolygon carrying wikidata = Q191.
--      We expose tags via LATERAL FLATTEN (avoids a correlated sub‑query).
--   B. CTE candidates: keep every multipolygon that intersects q191.geom.
--   C. Final SELECT: flatten each candidate’s tags, group by polygon, and
--      retain only those whose flattened rows contain zero wikidata tags.

WITH q191 AS (   -- A. reference geometry
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
           LATERAL FLATTEN(input => pf."all_tags") t
    WHERE  pf."feature_type"          = 'multipolygons'
      AND  t.value:"key"::STRING       = 'wikidata'
      AND  t.value:"value"::STRING     = 'Q191'
    LIMIT 1
),
candidates AS (  -- B. multipolygons intersecting that geometry
    SELECT pf."osm_way_id",
           pf."all_tags"
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
           q191
    WHERE  pf."feature_type" = 'multipolygons'
      AND  ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), q191.geom )
)
-- C. exclude polygons that already have a wikidata tag
SELECT c."osm_way_id"
FROM   candidates c,
       LATERAL FLATTEN(input => c."all_tags") f
GROUP  BY c."osm_way_id"
HAVING SUM( IFF( f.value:"key"::STRING = 'wikidata', 1, 0) ) = 0
LIMIT 20;
```
