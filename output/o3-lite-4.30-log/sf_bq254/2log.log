--Description:
-- Compute, for every multipolygon that (1) intersects the polygon whose tag
-- wikidata = 'Q191' and (2) lacks any ‘wikidata’ tag itself, the number of
-- point features that intersect it.  Show the 20 polygons with the largest
-- point counts.
--
-- Steps
-- 1. q191       – obtain the GEOGRAPHY geometry of the single multipolygon
--                 carrying wikidata = Q191 by flattening its all_tags.
-- 2. raw        – list every multipolygon that intersects q191.geom, emitting
--                 one row per tag (tag_key) so we can test for wikidata tags.
-- 3. candidates – keep exactly one geometry row per polygon if the windowed
--                 SUM of “wikidata” tags is zero; ROW_NUMBER() selects the
--                 representative geometry without aggregating GEOGRAPHY.
-- 4. Final SELECT – spatially join each candidate polygon with
--                 PLANET_FEATURES_POINTS and count intersecting points.

WITH q191 AS (  --------------------------------------------------------------
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
           LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE  pf."feature_type"        = 'multipolygons'
      AND  tag.value:"key"::STRING   = 'wikidata'
      AND  tag.value:"value"::STRING = 'Q191'
    LIMIT 1
),
raw AS (  --------------------------------------------------------------------
    SELECT pf."osm_way_id",
           TO_GEOGRAPHY(pf."geometry")           AS poly_geom,
           tag.value:"key"::STRING               AS tag_key
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
           q191,
           LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE  pf."feature_type" = 'multipolygons'
      AND  ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), q191.geom )
),
candidates AS (  -------------------------------------------------------------
    SELECT r."osm_way_id",
           r."poly_geom"
    FROM   raw r
    QUALIFY SUM( IFF(r.tag_key = 'wikidata', 1, 0) )
              OVER (PARTITION BY r."osm_way_id") = 0   -- exclude polygons with wikidata tag
        AND ROW_NUMBER() OVER (PARTITION BY r."osm_way_id") = 1 -- keep one geometry row
)
SELECT c."osm_way_id",
       COUNT(*) AS pt_in_poly
FROM   candidates c
JOIN   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS pp
  ON   pp."geometry" IS NOT NULL
 AND   ST_INTERSECTS( c."poly_geom", TO_GEOGRAPHY(pp."geometry") )
GROUP  BY c."osm_way_id"
ORDER  BY pt_in_poly DESC
