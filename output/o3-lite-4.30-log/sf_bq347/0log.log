WITH relevant_sops AS (
    /* 1)  SOPs that belong to the requested imaging series */
    SELECT  "Modality",
            "SOPInstanceUID"
    FROM    "IDC"."IDC_V17"."DICOM_METADATA"
    WHERE   "SeriesInstanceUID" = '1.3.6.1.4.1.14519.5.2.1.3671.4754.105976129314091491952445656147'

    UNION ALL

    /* 2)  SOPs that belong to every SEG series referencing that imaging series */
    SELECT  dm."Modality",
            dm."SOPInstanceUID"
    FROM    "IDC"."IDC_V17"."DICOM_METADATA"  dm
    WHERE   dm."SeriesInstanceUID" IN (
                SELECT DISTINCT s."SeriesInstanceUID"
                FROM   "IDC"."IDC_V17"."SEGMENTATIONS"  s
                WHERE  s."segmented_SeriesInstanceUID" =
                       '1.3.6.1.4.1.14519.5.2.1.3671.4754.105976129314091491952445656147'
            )
)
SELECT      "Modality"                                AS modality,
            COUNT(DISTINCT "SOPInstanceUID")          AS total_sop_instances
FROM        relevant_sops
GROUP BY    "Modality"
ORDER BY    total_sop_instances DESC NULLS LAST,
            modality
LIMIT 1;
