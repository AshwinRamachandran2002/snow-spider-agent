      SELECT "Modality", "SOPInstanceUID"
      FROM "IDC"."IDC_V17"."DICOM_METADATA"
      WHERE ("Modality" = 'MR'
             AND "SeriesInstanceUID" LIKE '1.3.6.1.4.1.14519.%')

      UNION ALL

      SELECT "Modality", "SOPInstanceUID"
      FROM "IDC"."IDC_V17"."DICOM_METADATA"
      WHERE "SeriesInstanceUID" IN (
            SELECT DISTINCT s."SeriesInstanceUID"
            FROM "IDC"."IDC_V17"."SEGMENTATIONS" s
            WHERE s."segmented_SeriesInstanceUID" LIKE '1.3.6.1.4.1.14519.%'
      )
) AS all_sops
GROUP BY "Modality"
ORDER BY "total_sops" DESC
LIMIT 1;
