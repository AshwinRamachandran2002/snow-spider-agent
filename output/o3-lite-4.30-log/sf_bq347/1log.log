        SELECT "SOPInstanceUID",
               'SEG' AS "Modality"
        FROM IDC.IDC_V17.SEGMENTATIONS
        WHERE "segmented_SeriesInstanceUID" LIKE '%3671.4754%'
     ) u
GROUP BY "Modality"
ORDER BY "num_sop_total" DESC
LIMIT 1;
```

