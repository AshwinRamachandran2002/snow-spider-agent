Relevant columns and their potential usage
• payment.payment_id : primary key of each payment row  
• payment.customer_id : link payments to the customer who paid  
• payment.rental_id : links the payment to the rental that generated the charge  
• payment.amount : dollar amount to be summed for a customer’s total spend  
• payment.payment_date : lets us pick the customer’s FIRST payment chronologically  

• rental.rental_id : primary key; joins to payment.rental_id  
• rental.customer_id : another route to the customer; useful for counting rentals  
• rental.inventory_id : points to the physical copy that was rented  

• inventory.inventory_id : primary key; joins to rental.inventory_id  
• inventory.film_id : links the inventory record to the actual movie title  

• film.film_id : primary key; joins to inventory.film_id  
• film.rating : rating category (G, PG‑13, etc.).  This is the grouping field requested.  

Typical join / filter conditions
payment.rental_id = rental.rental_id  
rental.inventory_id = inventory.inventory_id  
inventory.film_id = film.film_id  
To isolate the first movie rented by a customer we will use  
payment.payment_date = ( SELECT MIN(payment_date) FROM payment p2 WHERE p2.customer_id = payment.customer_id)

Example exploratory queries
```sql
-- 1. Description: List every distinct rating that exists in the film table.
SELECT DISTINCT film.rating
FROM film
LIMIT 20;
```

```sql
-- 2. Description: Verify that every payment is connected to a rental row.
SELECT DISTINCT p.rental_id
FROM payment AS p
LEFT JOIN rental AS r ON r.rental_id = p.rental_id
WHERE r.rental_id IS NULL
LIMIT 20;
```

```sql
-- 3. Description: Fetch the earliest payment record (id & date) for each customer.
SELECT p.customer_id,
       MIN(p.payment_date) AS first_payment_date
FROM payment AS p
GROUP BY p.customer_id
LIMIT 20;
```

```sql
-- 4. Description: See the film and its rating that corresponds to each customer’s very first payment.
SELECT fp.customer_id,
       f.film_id,
       f.rating,
       fp.first_payment_date
FROM (
        SELECT p1.customer_id,
               MIN(p1.payment_date) AS first_payment_date
        FROM payment AS p1
        GROUP BY p1.customer_id
     ) AS fp
JOIN payment  AS p   ON p.customer_id = fp.customer_id
                    AND p.payment_date = fp.first_payment_date
JOIN rental   AS r   ON r.rental_id   = p.rental_id
JOIN inventory AS i  ON i.inventory_id = r.inventory_id
JOIN film      AS f  ON f.film_id      = i.film_id
LIMIT 20;
```

```sql
-- 5. Description: Count how many total rentals each customer has ever made.
SELECT r.customer_id,
       COUNT(*) AS total_rentals
FROM rental AS r
GROUP BY r.customer_id
LIMIT 20;
```

```sql
-- 6. Description: Total dollar amount each customer has spent in payments.
SELECT p.customer_id,
       SUM(p.amount) AS total_spent
FROM payment AS p
GROUP BY p.customer_id
LIMIT 20;
```

```sql
-- 7. Description: Combine first‑movie rating, customer’s total spend, and total rentals in one view.
WITH first_movie AS (
    SELECT fp.customer_id,
           f.rating
    FROM (
            SELECT p1.customer_id,
                   MIN(p1.payment_date) AS first_payment_date
            FROM payment AS p1
            GROUP BY p1.customer_id
         ) AS fp
    JOIN payment  AS p   ON p.customer_id = fp.customer_id
                        AND p.payment_date = fp.first_payment_date
    JOIN rental   AS r   ON r.rental_id   = p.rental_id
    JOIN inventory AS i  ON i.inventory_id = r.inventory_id
    JOIN film      AS f  ON f.film_id      = i.film_id
)
SELECT fm.customer_id,
       fm.rating,
       ts.total_spent,
       tr.total_rentals
FROM first_movie AS fm
JOIN (
        SELECT customer_id, SUM(amount) AS total_spent
        FROM payment
        GROUP BY customer_id
     ) AS ts ON ts.customer_id = fm.customer_id
JOIN (
        SELECT customer_id, COUNT(*) AS total_rentals
        FROM rental
        GROUP BY customer_id
     ) AS tr ON tr.customer_id = fm.customer_id
LIMIT 20;
```

```sql
-- 8. Description: Compute, for every rating category, the average total spend
--    per customer whose first movie had that rating.
WITH first_movie AS (
    SELECT fp.customer_id,
           f.rating
    FROM (
            SELECT p1.customer_id,
                   MIN(p1.payment_date) AS first_payment_date
            FROM payment AS p1
            GROUP BY p1.customer_id
         ) AS fp
    JOIN payment  AS p   ON p.customer_id = fp.customer_id
                        AND p.payment_date = fp.first_payment_date
    JOIN rental   AS r   ON r.rental_id   = p.rental_id
    JOIN inventory AS i  ON i.inventory_id = r.inventory_id
    JOIN film      AS f  ON f.film_id      = i.film_id
),
per_customer AS (
    SELECT fm.rating,
           fm.customer_id,
           SUM(p.amount)                        AS total_spent,
           COUNT(DISTINCT r.rental_id)          AS total_rentals
    FROM first_movie AS fm
    JOIN payment AS p  ON p.customer_id = fm.customer_id
    JOIN rental  AS r  ON r.customer_id = fm.customer_id
    GROUP BY fm.rating, fm.customer_id
)
SELECT rating,
       AVG(total_spent)                        AS avg_total_spent,
       AVG(total_rentals - 1)                  AS avg_subsequent_rentals
FROM per_customer
GROUP BY rating
LIMIT 20;
```

```sql
-- 9. Description: Same aggregation as #8 but built with scalar sub‑queries instead
--    of multiple CTE layers (alternative technique).
SELECT fm.rating,
       AVG( (SELECT SUM(p.amount)
             FROM payment AS p
             WHERE p.customer_id = fm.customer_id) )                         AS avg_total_spent,
       AVG( (SELECT COUNT(*)
             FROM rental AS r
             WHERE r.customer_id = fm.customer_id) - 1 )                     AS avg_subsequent_rentals
FROM (
        SELECT fp.customer_id,
               f.rating
        FROM (
                SELECT p1.customer_id,
                       MIN(p1.payment_date) AS first_payment_date
                FROM payment AS p1
                GROUP BY p1.customer_id
             ) AS fp
        JOIN payment  AS p   ON p.customer_id = fp.customer_id
                            AND p.payment_date = fp.first_payment_date
        JOIN rental   AS r   ON r.rental_id   = p.rental_id
        JOIN inventory AS i  ON i.inventory_id = r.inventory_id
        JOIN film      AS f  ON f.film_id      = i.film_id
     ) AS fm
GROUP BY fm.rating
LIMIT 20;
```

```sql
-- 10. Description: Final compact answer – rating, average spend, average (rentals‑1).
WITH first_payment AS (
    SELECT customer_id,
           MIN(payment_date) AS first_payment_date
    FROM payment
    GROUP BY customer_id
), first_rating AS (
    SELECT fp.customer_id,
           f.rating
    FROM first_payment AS fp
    JOIN payment   AS p  ON p.customer_id = fp.customer_id
                        AND p.payment_date = fp.first_payment_date
    JOIN rental    AS r  ON r.rental_id = p.rental_id
    JOIN inventory AS i  ON i.inventory_id = r.inventory_id
    JOIN film      AS f  ON f.film_id = i.film_id
), spend AS (
    SELECT customer_id,
           SUM(amount) AS total_spent
    FROM payment
    GROUP BY customer_id
), rentals AS (
    SELECT customer_id,
           COUNT(*) AS total_rentals
    FROM rental
    GROUP BY customer_id
)
SELECT fr.rating,
       AVG(s.total_spent)              AS avg_total_amount_spent,
       AVG(r.total_rentals - 1)        AS avg_number_subsequent_rentals
FROM first_rating  AS fr
JOIN spend         AS s  ON s.customer_id = fr.customer_id
JOIN rentals       AS r  ON r.customer_id = fr.customer_id
GROUP BY fr.rating
LIMIT 20;
```

Each query is capped at 20 output rows to keep the exploration manageable.
