The table structure information is (table names): 
['actor', 'country', 'city', 'address', 'language', 'category', 'customer', 'film', 'film_actor', 'film_category', 'film_text', 'inventory', 'staff', 'store', 'payment', 'rental']
Begin Exploring Related Columns
Relevant columns and their possible roles  
payment.payment_id : individual payment events (one row per rental)  
payment.customer_id : links to the customer we are analysing  
payment.amount : money spent in every rental; used to totalise spend  
payment.payment_date : chronology – lets us detect the first‐ever rental for each customer  
payment.rental_id : connects the payment to the rental that produced it  

rental.rental_id : bridge between payment and the physical copy (inventory)  
rental.inventory_id : lets us reach the film that was rented  

inventory.film_id : identifies the actual movie title that was rented  

film.film_id : primary key of movies  
film.rating : the rating category asked for in the question (PG, R, …)  

Conditions we will very likely need  
• Link path: payment → rental → inventory → film  
• Pick the customer’s FIRST rental: ROW_NUMBER() = 1 or payment_date = MIN(payment_date)  
• Subsequent rentals = total_rentals – 1 (cannot be negative)  
• Grouping/aggregating by film.rating  

Below are ten exploratory/finality‑building queries – each limited to 20 rows – ranging from very simple inspection to the final answer.

```sql
-- 1. Description: See what rating values exist in the catalogue
SELECT DISTINCT f.rating
FROM film AS f
LIMIT 20;
```

```sql
-- 2. Description: Have a look at the time span of payments
SELECT MIN(p.payment_date)  AS first_payment,
       MAX(p.payment_date)  AS last_payment
FROM payment AS p;
```

```sql
-- 3. Description: Join one payment hop all the way to the film to ensure the path works
SELECT p.payment_id,
       p.customer_id,
       p.amount,
       p.payment_date,
       f.title,
       f.rating
FROM payment   AS p
JOIN rental    AS r ON r.rental_id    = p.rental_id
JOIN inventory AS i ON i.inventory_id = r.inventory_id
JOIN film      AS f ON f.film_id      = i.film_id
LIMIT 20;
```

```sql
-- 4. Description: Retrieve, per customer, the very first film they ever paid for (with its rating)
WITH ranked AS (
  SELECT p.customer_id,
         p.payment_date,
         f.rating,
         ROW_NUMBER() OVER (PARTITION BY p.customer_id
                            ORDER BY p.payment_date, p.payment_id) AS rn
  FROM payment   AS p
  JOIN rental    AS r ON r.rental_id    = p.rental_id
  JOIN inventory AS i ON i.inventory_id = r.inventory_id
  JOIN film      AS f ON f.film_id      = i.film_id
)
SELECT customer_id, payment_date, rating
FROM ranked
WHERE rn = 1
LIMIT 20;
```

```sql
-- 5. Description: Count how many rentals each customer has in total
SELECT p.customer_id,
       COUNT(*) AS total_rentals
FROM payment AS p
GROUP BY p.customer_id
LIMIT 20;
```

```sql
-- 6. Description: How much money has each customer spent in total?
SELECT p.customer_id,
       SUM(p.amount) AS total_amount
FROM payment AS p
GROUP BY p.customer_id
LIMIT 20;
```

```sql
-- 7. Description: Merge total rentals and first‑rating in one row per customer
WITH first_movie AS (
  SELECT customer_id,
         rating
  FROM (
        SELECT p.customer_id,
               f.rating,
               ROW_NUMBER() OVER (PARTITION BY p.customer_id
                                  ORDER BY p.payment_date, p.payment_id) AS rn
        FROM payment   AS p
        JOIN rental    AS r ON r.rental_id    = p.rental_id
        JOIN inventory AS i ON i.inventory_id = r.inventory_id
        JOIN film      AS f ON f.film_id      = i.film_id
  ) WHERE rn = 1
),
cust_totals AS (
  SELECT p.customer_id,
         COUNT(*)            AS total_rentals,
         SUM(p.amount)       AS total_amount
  FROM payment AS p
  GROUP BY p.customer_id
)
SELECT ft.customer_id,
       ft.rating,
       ct.total_rentals,
       ct.total_amount
FROM first_movie AS ft
JOIN cust_totals AS ct USING (customer_id)
LIMIT 20;
```

```sql
-- 8. Description: Compute “subsequent rentals” (total - 1, floored at 0) for each customer
WITH cust_stats AS (
  SELECT p.customer_id,
         COUNT(*)              AS total_rentals,
         SUM(p.amount)         AS total_amount
  FROM payment AS p
  GROUP BY p.customer_id
)
SELECT customer_id,
       CASE WHEN total_rentals > 0 THEN total_rentals - 1 ELSE 0 END AS subsequent_rentals,
       total_amount
FROM cust_stats
LIMIT 20;
```

```sql
-- 9. Description: Tie the above customer metrics back to their first‑movie rating
WITH first_movie AS (
  SELECT customer_id,
         rating
  FROM (
        SELECT p.customer_id,
               f.rating,
               ROW_NUMBER() OVER (PARTITION BY p.customer_id
                                  ORDER BY p.payment_date, p.payment_id) AS rn
        FROM payment   AS p
        JOIN rental    AS r ON r.rental_id    = p.rental_id
        JOIN inventory AS i ON i.inventory_id = r.inventory_id
        JOIN film      AS f ON f.film_id      = i.film_id
  ) WHERE rn = 1
),
cust_stats AS (
  SELECT p.customer_id,
         COUNT(*)              AS total_rentals,
         SUM(p.amount)         AS total_amount
  FROM payment AS p
  GROUP BY p.customer_id
)
SELECT fm.rating,
       cs.total_amount,
       cs.total_rentals - 1 AS subsequent_rentals
FROM first_movie AS fm
JOIN cust_stats  AS cs USING (customer_id)
LIMIT 20;
```

```sql
-- 10. Description: FINAL ANSWER – Aggregate by rating of the first movie:
--                    • average total amount spent per customer
--                    • average number of subsequent rentals
WITH payment_film AS (
    SELECT p.payment_id,
           p.customer_id,
           p.amount,
           p.payment_date,
           r.rental_id,
           f.rating,
           ROW_NUMBER() OVER (PARTITION BY p.customer_id
                              ORDER BY p.payment_date, p.payment_id) AS rn
    FROM payment   AS p
    JOIN rental    AS r ON r.rental_id    = p.rental_id
    JOIN inventory AS i ON i.inventory_id = r.inventory_id
    JOIN film      AS f ON f.film_id      = i.film_id
),
first_film AS (
    SELECT customer_id,
           rating
    FROM payment_film
    WHERE rn = 1
),
customer_stats AS (
    SELECT customer_id,
           SUM(amount)                   AS total_amount,
           COUNT(DISTINCT rental_id)     AS total_rentals
    FROM payment_film
    GROUP BY customer_id
),
combined AS (
    SELECT ff.rating,
           cs.total_amount,
           cs.total_rentals - 1          AS subsequent_rentals
    FROM first_film     AS ff
    JOIN customer_stats AS cs USING (customer_id)
)
SELECT rating,
       AVG(total_amount)      AS avg_total_amount_per_customer,
       AVG(subsequent_rentals) AS avg_subsequent_rentals
FROM combined
GROUP BY rating
ORDER BY rating
LIMIT 20;
```

Each query builds understanding of the data and progressively approaches the required result, culminating in query #10 which directly answers the task.
