SELECT DISTINCT ep.key
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params) AS ep
WHERE event_date = '20210102'
  AND event_name = 'page_view'
LIMIT 20;
```

```sql
-- 3) Description: Sample page_location URLs so we can visually verify the structure
SELECT ep.value.string_value AS page_location
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params) AS ep
WHERE event_date = '20210102'
  AND event_name = 'page_view'
  AND ep.key = 'page_location'
LIMIT 20;
```

```sql
-- 4) Description: Bring URL and timestamp together to see order of navigation
SELECT
  user_pseudo_id,
  ep_loc.value.string_value  AS page_location,
  event_timestamp
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params) AS ep_loc
WHERE event_date = '20210102'
  AND event_name = 'page_view'
  AND ep_loc.key = 'page_location'
LIMIT 20;
```

```sql
-- 5) Description: Sample ga_session_id values (needed for session definition)
SELECT
  user_pseudo_id,
  ep_id.value.int_value AS ga_session_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params) AS ep_id
WHERE event_date = '20210102'
  AND event_name = 'page_view'
  AND ep_id.key = 'ga_session_id'
LIMIT 20;
```

```sql
-- 6) Description: Categorise every page_view as PLP, PDP or OTHER and count them
WITH base AS (
  SELECT
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'page_location') AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
)
SELECT
  CASE
    WHEN REGEXP_CONTAINS(LOWER(url), r'\+')
         AND REGEXP_CONTAINS(LOWER(url),
             r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
      THEN 'PDP'
    WHEN REGEXP_CONTAINS(LOWER(url),
             r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
      THEN 'PLP'
    ELSE 'OTHER'
  END AS page_type,
  COUNT(*) AS cnt
FROM base
GROUP BY page_type
LIMIT 20;
```

```sql
-- 7) Description: Count sessions that include BOTH a PLP and a PDP
WITH page_views AS (
  SELECT
    user_pseudo_id,
    (SELECT value.int_value    FROM UNNEST(event_params) WHERE key = 'ga_session_id') AS session_id,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'page_location') AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
),
typed AS (
  SELECT *,
    CASE
      WHEN REGEXP_CONTAINS(LOWER(url), r'\+')
           AND REGEXP_CONTAINS(LOWER(url),
               r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
        THEN 'PDP'
      WHEN REGEXP_CONTAINS(LOWER(url),
               r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
        THEN 'PLP'
      ELSE 'OTHER'
    END AS pg_type
  FROM page_views
)
SELECT COUNT(DISTINCT CONCAT(user_pseudo_id,'-',session_id)) AS sessions_with_plp_and_pdp
FROM (
  SELECT user_pseudo_id, session_id,
         ARRAY_AGG(DISTINCT pg_type) AS types
  FROM typed
  GROUP BY user_pseudo_id, session_id
)
WHERE 'PLP' IN UNNEST(types) AND 'PDP' IN UNNEST(types)
LIMIT 20;
```

```sql
-- 8) Description: For every PLP event, find the first PDP that came AFTER it in the same session
WITH page_views AS (
  SELECT
    user_pseudo_id,
    (SELECT value.int_value    FROM UNNEST(event_params) WHERE key = 'ga_session_id')    AS session_id,
    event_timestamp,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'page_location')    AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
),
typed AS (
  SELECT *,
    CASE
      WHEN REGEXP_CONTAINS(LOWER(url), r'\+')
           AND REGEXP_CONTAINS(LOWER(url),
               r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
        THEN 'PDP'
      WHEN REGEXP_CONTAINS(LOWER(url),
               r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
        THEN 'PLP'
      ELSE 'OTHER'
    END AS pg_type
  FROM page_views
),
plp AS (
  SELECT user_pseudo_id, session_id, event_timestamp AS plp_ts
  FROM typed
  WHERE pg_type = 'PLP'
),
pdp AS (
  SELECT user_pseudo_id, session_id, event_timestamp AS pdp_ts
  FROM typed
  WHERE pg_type = 'PDP'
)
SELECT
  plp.user_pseudo_id,
  plp.session_id,
  plp.plp_ts,
  MIN(pdp.pdp_ts) AS first_pdp_after
FROM plp
LEFT JOIN pdp
  ON plp.user_pseudo_id = pdp.user_pseudo_id
 AND plp.session_id    = pdp.session_id
 AND pdp.pdp_ts        > plp.plp_ts
GROUP BY plp.user_pseudo_id, plp.session_id, plp.plp_ts
LIMIT 20;
```

```sql
-- 9) Description: Aggregate the previous result – how many PLPs had a following PDP?
WITH page_views AS (
  SELECT
    user_pseudo_id,
    (SELECT value.int_value    FROM UNNEST(event_params) WHERE key = 'ga_session_id')    AS session_id,
    event_timestamp,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'page_location')    AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
),
typed AS (
  SELECT *,
    CASE
      WHEN REGEXP_CONTAINS(LOWER(url), r'\+')
           AND REGEXP_CONTAINS(LOWER(url),
               r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
        THEN 'PDP'
      WHEN REGEXP_CONTAINS(LOWER(url),
               r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
        THEN 'PLP'
      ELSE 'OTHER'
    END AS pg_type
  FROM page_views
),
plp AS (
  SELECT user_pseudo_id, session_id, event_timestamp AS plp_ts
  FROM typed
  WHERE pg_type = 'PLP'
),
pdp AS (
  SELECT user_pseudo_id, session_id, event_timestamp AS pdp_ts
  FROM typed
  WHERE pg_type = 'PDP'
),
joined AS (
  SELECT
    plp.*,
    MIN(pdp.pdp_ts) AS first_pdp_after
  FROM plp
  LEFT JOIN pdp
    ON plp.user_pseudo_id = pdp.user_pseudo_id
   AND plp.session_id    = pdp.session_id
   AND pdp.pdp_ts        > plp.plp_ts
  GROUP BY plp.user_pseudo_id, plp.session_id, plp.plp_ts
)
SELECT
  COUNT(*)                                   AS total_plp_events,
  COUNTIF(first_pdp_after IS NOT NULL)       AS plp_leading_to_pdp
FROM joined
LIMIT 20;
```

```sql
-- 10) Description: Final answer – total PLP views, those that led to PDP, and the percentage
WITH page_views AS (
  SELECT
    user_pseudo_id,
    (SELECT value.int_value    FROM UNNEST(event_params) WHERE key = 'ga_session_id')    AS session_id,
    event_timestamp,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'page_location')    AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
),
typed AS (
  SELECT *,
    CASE
      WHEN REGEXP_CONTAINS(LOWER(url), r'\+')
           AND REGEXP_CONTAINS(LOWER(url),
               r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
        THEN 'PDP'
      WHEN REGEXP_CONTAINS(LOWER(url),
               r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
        THEN 'PLP'
      ELSE 'OTHER'
    END AS pg_type
  FROM page_views
),
plp AS (
  SELECT user_pseudo_id, session_id, event_timestamp AS plp_ts
  FROM typed
  WHERE pg_type = 'PLP'
),
pdp AS (
  SELECT user_pseudo_id, session_id, event_timestamp AS pdp_ts
  FROM typed
  WHERE pg_type = 'PDP'
),
joined AS (
  SELECT
    plp.*,
    MIN(pdp.pdp_ts) AS first_pdp_after
  FROM plp
  LEFT JOIN pdp
    ON plp.user_pseudo_id = pdp.user_pseudo_id
   AND plp.session_id    = pdp.session_id
   AND pdp.pdp_ts        > plp.plp_ts
  GROUP BY plp.user_pseudo_id, plp.session_id, plp.plp_ts
)
SELECT
  COUNT(*)                                   AS total_plp_views,
  COUNTIF(first_pdp_after IS NOT NULL)       AS plp_views_with_pdp_after,
  SAFE_DIVIDE(COUNTIF(first_pdp_after IS NOT NULL), COUNT(*)) * 100
                                             AS pct_plp_to_pdp
FROM joined
LIMIT 20;
```

Running the last query will return three numbers:
1. `total_plp_views` – how many PLP page_view events happened on 2‑Jan‑2021  
2. `plp_views_with_pdp_after` – how many of those were followed by a PDP in the same session  
3. `pct_plp_to_pdp` – the percentage of PLP views that transitioned to PDP views inside the session.
