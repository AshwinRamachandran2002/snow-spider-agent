    SELECT
        user_pseudo_id,
        (SELECT value.int_value    FROM UNNEST(event_params) WHERE key = 'ga_session_id') AS ga_session_id,
        event_timestamp,
        (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'page_location')  AS url
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
    WHERE event_date = '20210102'
      AND event_name = 'page_view'
  ),
  tagged AS (
    SELECT *,
           CASE
             WHEN REGEXP_CONTAINS(url, r'/[^/]*\+[^/]*$') THEN 'PDP'
             ELSE 'PLP'
           END AS page_type
    FROM base
  ),
  transition_sessions AS (
    SELECT
        user_pseudo_id,
        ga_session_id
    FROM (
      SELECT
          user_pseudo_id,
          ga_session_id,
          MIN(IF(page_type = 'PLP', event_timestamp, NULL)) AS first_plp,
          MIN(IF(page_type = 'PDP', event_timestamp, NULL)) AS first_pdp
      FROM tagged
      GROUP BY user_pseudo_id, ga_session_id
    )
    WHERE first_plp IS NOT NULL
      AND first_pdp IS NOT NULL
      AND first_pdp > first_plp
  ),
  plp_counts AS (
    SELECT
      (SELECT COUNT(*) FROM tagged WHERE page_type = 'PLP') AS total_plp_views,
      (SELECT COUNT(*) FROM tagged t
           JOIN transition_sessions s
             ON t.user_pseudo_id = s.user_pseudo_id
            AND t.ga_session_id  = s.ga_session_id
         WHERE t.page_type = 'PLP')                         AS plp_views_leading_to_pdp
  )
  SELECT * FROM plp_counts
)
