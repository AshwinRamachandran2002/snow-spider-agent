--Description / Thinking process:
-- We need the % of Product‑List‑Page (PLP) views on 2021‑01‑02 that later,
-- in the same session, are followed by a Product‑Detail‑Page (PDP) view.
-- Steps implemented below, each numbered in comments:
--
-- 1.  Keep only page_view rows on 20210102 and pull out:
--       • user_pseudo_id       – user identity
--       • ga_session_id        – session identity
--       • event_timestamp      – order within session
--       • page_location (url)  – to decide PLP vs PDP
--
-- 2.  Tag every row: if the *last* URL segment contains a “+” → PDP, else PLP.
--     (This pragmatic rule matches the sample URLs and avoids missing data.)
--
-- 3.  For each session find the first PLP time and first PDP time.
--
-- 4.  Keep sessions where a PDP occurs after a PLP ⇒ “transition sessions”.
--
-- 5.  Count:
--       a) total PLP views,
--       b) PLP views that belong to transition sessions.
--
-- 6.  Output the two counts and the percentage.
WITH base AS (                               -- Step 1
  SELECT
    user_pseudo_id,
    (SELECT value.int_value    FROM UNNEST(event_params)
     WHERE key = 'ga_session_id')                            AS ga_session_id,
    event_timestamp,
    (SELECT value.string_value FROM UNNEST(event_params)
     WHERE key = 'page_location')                            AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
),
tagged AS (                                  -- Step 2
  SELECT *,
         CASE WHEN REGEXP_CONTAINS(url, r'/[^/]*\+[^/]*$')
              THEN 'PDP'
              ELSE 'PLP'
         END AS page_type
  FROM base
),
session_times AS (                           -- Step 3
  SELECT
    user_pseudo_id,
    ga_session_id,
    MIN(IF(page_type = 'PLP', event_timestamp, NULL)) AS first_plp,
    MIN(IF(page_type = 'PDP', event_timestamp, NULL)) AS first_pdp
  FROM tagged
  GROUP BY user_pseudo_id, ga_session_id
),
transition_sessions AS (                     -- Step 4
  SELECT *
  FROM session_times
  WHERE first_plp IS NOT NULL
    AND first_pdp IS NOT NULL
    AND first_pdp > first_plp
),
counts AS (                                  -- Step 5
  SELECT
    (SELECT COUNT(*) FROM tagged WHERE page_type = 'PLP') AS total_plp_views,
    (SELECT COUNT(*) FROM tagged t
         JOIN transition_sessions s
           ON t.user_pseudo_id = s.user_pseudo_id
          AND t.ga_session_id  = s.ga_session_id
       WHERE t.page_type = 'PLP')                         AS plp_views_leading_to_pdp
)
-- Step 6
SELECT
  total_plp_views,
  plp_views_leading_to_pdp,
  ROUND(100 * SAFE_DIVIDE(plp_views_leading_to_pdp, total_plp_views), 2)
    AS pct_plp_to_pdp
FROM counts;
