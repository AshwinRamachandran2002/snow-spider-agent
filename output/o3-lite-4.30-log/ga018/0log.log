Relevant columns, their potential usage and typical conditions  
• event_date: filter to the single day we care about → `WHERE event_date = '20210102'`  
• event_name: keep only page views → `WHERE event_name = 'page_view'`  
• event_params  
  – key = 'page_location' → the full URL that lets us decide PLP / PDP  
  – key = 'ga_session_id'  → groups page‑views that occur in the same session  
• user_pseudo_id: together with ga_session_id, uniquely identifies a session  
• event_timestamp: order the page‑views in the sequence they happened  

------------------------------------------------------------------------  
Ten exploratory → final BigQuery queries  
(Every query is restricted to the only table that holds data for 2‑Jan‑2021:  
`bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`)

```sql
--Description: 1)  What kinds of events exist on 2021‑01‑02?
SELECT DISTINCT event_name
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
WHERE  event_date = '20210102'
LIMIT 20;
```

```sql
--Description: 2)  Peek into event_params for a handful of page_view events.
SELECT event_timestamp,
       event_params
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
WHERE  event_date   = '20210102'
  AND  event_name   = 'page_view'
LIMIT 20;
```

```sql
--Description: 3)  List the distinct parameter keys that appear in page_view events.
SELECT DISTINCT ep.key
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS ep
WHERE  event_date = '20210102'
  AND  event_name = 'page_view'
LIMIT 20;
```

```sql
--Description: 4)  Display a sample of page_location URLs so we can see their format.
SELECT ep.value.string_value AS page_location
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS ep
WHERE  event_date           = '20210102'
  AND  event_name           = 'page_view'
  AND  ep.key               = 'page_location'
LIMIT 20;
```

```sql
--Description: 5)  Check that ga_session_id exists and looks usable.
SELECT user_pseudo_id,
       ep.value.int_value   AS ga_session_id,
       COUNT(*)             AS views_in_session
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS ep
WHERE  event_date           = '20210102'
  AND  event_name           = 'page_view'
  AND  ep.key               = 'ga_session_id'
GROUP BY user_pseudo_id, ga_session_id
LIMIT 20;
```

```sql
--Description: 6)  Classify each page_view as PLP / PDP / OTHER (small sample).
WITH base AS (
  SELECT
      user_pseudo_id,
      (SELECT value.int_value   FROM UNNEST(event_params) WHERE key = 'ga_session_id')   AS ga_session_id,
      (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'page_location')  AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
)
SELECT *,
       CASE
         WHEN REGEXP_CONTAINS(LOWER(url),
              r'/((accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)(/|$))')
              AND NOT REGEXP_CONTAINS(url, r'\+')
              THEN 'PLP'
         WHEN REGEXP_CONTAINS(LOWER(url),
              r'/((accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)(/|$))')
              AND REGEXP_CONTAINS(url, r'\+$')
              THEN 'PDP'
         ELSE 'OTHER'
       END AS page_type
FROM base
LIMIT 20;
```

```sql
--Description: 7)  Count how many PLP page_views we have in total on 2‑Jan‑21.
WITH pv AS (
  SELECT
      (SELECT value.string_value FROM UNNEST(event_params) WHERE key='page_location') AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
)
SELECT COUNT(*) AS total_plp_views
FROM   pv
WHERE  REGEXP_CONTAINS(LOWER(url),
          r'/((accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)(/|$))')
  AND  NOT REGEXP_CONTAINS(url, r'\+')
LIMIT 20;
```

```sql
--Description: 8)  Find for every session whether it contains at least one PLP and later a PDP.
WITH classified AS (
  SELECT
      user_pseudo_id,
      (SELECT value.int_value    FROM UNNEST(event_params) WHERE key='ga_session_id')    AS ga_session_id,
      event_timestamp,
      CASE
        WHEN REGEXP_CONTAINS(LOWER((SELECT value.string_value FROM UNNEST(event_params) WHERE key='page_location')),
             r'/((accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)(/|$))')
             AND NOT REGEXP_CONTAINS((SELECT value.string_value FROM UNNEST(event_params) WHERE key='page_location'), r'\+')
             THEN 'PLP'
        WHEN REGEXP_CONTAINS(LOWER((SELECT value.string_value FROM UNNEST(event_params) WHERE key='page_location')),
             r'/((accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)(/|$))')
             AND REGEXP_CONTAINS((SELECT value.string_value FROM UNNEST(event_params) WHERE key='page_location'), r'\+$')
             THEN 'PDP'
        ELSE 'OTHER'
      END AS page_type
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
)
SELECT
    user_pseudo_id,
    ga_session_id,
    MIN(IF(page_type='PLP', event_timestamp, NULL)) AS first_plp_ts,
    MIN(IF(page_type='PDP', event_timestamp, NULL)) AS first_pdp_ts
FROM classified
GROUP BY user_pseudo_id, ga_session_id
HAVING first_plp_ts IS NOT NULL           -- session had a PLP
   AND first_pdp_ts IS NOT NULL           -- session had a PDP
   AND first_pdp_ts > first_plp_ts        -- PDP happened after PLP
LIMIT 20;
```

```sql
--Description: 9)  Summarise the counts: total PLP views vs. PLP views that eventually led to PDP.
WITH base AS (
  SELECT
      user_pseudo_id,
      (SELECT value.int_value    FROM UNNEST(event_params) WHERE key='ga_session_id')     AS ga_session_id,
      event_timestamp,
      (SELECT value.string_value FROM UNNEST(event_params) WHERE key='page_location')     AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
),
tagged AS (
  SELECT *,
         CASE
           WHEN REGEXP_CONTAINS(LOWER(url),
                r'/((accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)(/|$))')
                AND NOT REGEXP_CONTAINS(url, r'\+')
                THEN 'PLP'
           WHEN REGEXP_CONTAINS(LOWER(url),
                r'/((accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)(/|$))')
                AND REGEXP_CONTAINS(url, r'\+$')
                THEN 'PDP'
           ELSE 'OTHER'
         END AS page_type
  FROM base
),
sessions AS (
  SELECT
      user_pseudo_id,
      ga_session_id,
      MIN(IF(page_type='PLP', event_timestamp, NULL)) AS first_plp,
      MIN(IF(page_type='PDP', event_timestamp, NULL)) AS first_pdp
  FROM tagged
  GROUP BY user_pseudo_id, ga_session_id
),
plp_to_pdp_sessions AS (
  SELECT *
  FROM   sessions
  WHERE  first_plp IS NOT NULL
     AND first_pdp IS NOT NULL
     AND first_pdp > first_plp
),
plp_views_that_led AS (
  SELECT COUNT(*) AS plp_views_leading
  FROM   tagged t
  JOIN   plp_to_pdp_sessions s
    ON   t.user_pseudo_id = s.user_pseudo_id
   AND   t.ga_session_id  = s.ga_session_id
  WHERE  t.page_type = 'PLP'
)
SELECT
  (SELECT COUNT(*) FROM tagged            WHERE page_type='PLP')           AS total_plp_views,
  (SELECT plp_views_leading FROM plp_views_that_led)                      AS plp_views_leading_to_pdp,
  SAFE_DIVIDE(
       (SELECT plp_views_leading FROM plp_views_that_led),
       (SELECT COUNT(*)         FROM tagged WHERE page_type='PLP')
  ) AS pct_plp_to_pdp
LIMIT 20;
```

```sql
--Description: 10)  Single concise query that returns the final percentage.
SELECT
  ROUND(100 * SAFE_DIVIDE(plp_views_leading_to_pdp, total_plp_views), 2) AS pct_plp_to_pdp
FROM (
  WITH base AS (
    SELECT
        user_pseudo_id,
        (SELECT value.int_value    FROM UNNEST(event_params) WHERE key='ga_session_id')     AS ga_session_id,
        event_timestamp,
        (SELECT value.string_value FROM UNNEST(event_params) WHERE key='page_location')     AS url
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
    WHERE event_date = '20210102'
      AND event_name = 'page_view'
  ),
  tagged AS (
    SELECT *,
           CASE
             WHEN REGEXP_CONTAINS(LOWER(url),
                  r'/((accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)(/|$))')
                  AND NOT REGEXP_CONTAINS(url, r'\+')
                  THEN 'PLP'
             WHEN REGEXP_CONTAINS(LOWER(url),
                  r'/((accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)(/|$))')
                  AND REGEXP_CONTAINS(url, r'\+$')
                  THEN 'PDP'
             ELSE 'OTHER'
           END AS page_type
    FROM base
  ),
  sessions AS (
    SELECT
        user_pseudo_id,
        ga_session_id,
        MIN(IF(page_type='PLP', event_timestamp, NULL)) AS first_plp,
        MIN(IF(page_type='PDP', event_timestamp, NULL)) AS first_pdp
    FROM tagged
    GROUP BY user_pseudo_id, ga_session_id
  ),
  plp_to_pdp_sessions AS (
    SELECT *
    FROM   sessions
    WHERE  first_plp IS NOT NULL
       AND first_pdp IS NOT NULL
       AND first_pdp > first_plp
  ),
  plp_counts AS (
    SELECT
      (SELECT COUNT(*) FROM tagged WHERE page_type='PLP')                                    AS total_plp_views,
      (SELECT COUNT(*) FROM tagged t
         JOIN plp_to_pdp_sessions s
           ON t.user_pseudo_id = s.user_pseudo_id
          AND t.ga_session_id  = s.ga_session_id
        WHERE t.page_type='PLP')                                                            AS plp_views_leading_to_pdp
  )
  SELECT * FROM plp_counts
)
LIMIT 20;
```

