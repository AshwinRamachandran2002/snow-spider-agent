```sql
--Description:  One‑pass query (with inline comments = “thinking process”) that
--              calculates, for 2021‑01‑02, the share of Product‑Listing‑Page (PLP)
--              views that eventually lead to a Product‑Detail‑Page (PDP) view
--              later in the SAME session.  Result columns:
--                   total_plp_views         – all PLP page_view hits
--                   plp_views_lead_to_pdp   – PLP hits that occur before the first PDP in session
--                   pct_plp_to_pdp          – percentage  (=  plp_views_lead_to_pdp / total_plp_views)

WITH raw AS (                                   -- 1) pull page_view hits for the day
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
     FROM UNNEST(event_params) ep
     WHERE ep.key = 'ga_session_id')            AS ga_session_id,
    event_timestamp,
    (SELECT ep.value.string_value
     FROM UNNEST(event_params) ep
     WHERE ep.key = 'page_location')            AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
),
typed AS (                                      -- 2) classify each hit as PLP / PDP / OTHER
  SELECT
    *,
    CASE
      -- ---------- PLP ----------
      WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
           AND NOT REGEXP_CONTAINS(SPLIT(url,'/')[OFFSET(4)], r'\+')
           AND (
                 REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(3)]),
                     r'(accessories|apparel|brands|campus collection|drinkware|electronics|google redesign|lifestyle|nest|new 2015 logo|notebooks journals|office|shop by brand|small goods|stationery|wearables)')
              OR REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(4)]),
                     r'(accessories|apparel|brands|campus collection|drinkware|electronics|google redesign|lifestyle|nest|new 2015 logo|notebooks journals|office|shop by brand|small goods|stationery|wearables)')
               )
           THEN 'PLP'
      -- ---------- PDP ----------
      WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
           AND REGEXP_CONTAINS(LOWER(url), r'\+')
           AND (
                 REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(3)]),
                     r'(accessories|apparel|brands|campus collection|drinkware|electronics|google redesign|lifestyle|nest|new 2015 logo|notebooks journals|office|shop by brand|small goods|stationery|wearables)')
              OR REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(4)]),
                     r'(accessories|apparel|brands|campus collection|drinkware|electronics|google redesign|lifestyle|nest|new 2015 logo|notebooks journals|office|shop by brand|small goods|stationery|wearables)')
               )
           THEN 'PDP'
      ELSE 'OTHER'
    END AS page_type
  FROM raw
),
first_pdp AS (                                  -- 3) timestamp of first PDP per session
  SELECT user_pseudo_id, ga_session_id,
         MIN(event_timestamp) AS first_pdp_ts
  FROM typed
  WHERE page_type = 'PDP'
  GROUP BY user_pseudo_id, ga_session_id
),
plp_flags AS (                                  -- 4) mark each PLP if it leads to a PDP later in session
  SELECT
    t.*,
    CASE
      WHEN f.first_pdp_ts IS NOT NULL
           AND t.page_type = 'PLP'
           AND t.event_timestamp < f.first_pdp_ts
      THEN 1
      ELSE 0
    END AS plp_leads_to_pdp
  FROM typed t
  LEFT JOIN first_pdp f
    ON f.user_pseudo_id = t.user_pseudo_id
   AND f.ga_session_id = t.ga_session_id
)
SELECT
  COUNTIF(page_type = 'PLP')                                            AS total_plp_views,
  SUM(plp_leads_to_pdp)                                                 AS plp_views_lead_to_pdp,
  SAFE_DIVIDE(SUM(plp_leads_to_pdp),
              COUNTIF(page_type = 'PLP')) * 100 AS pct_plp_to_pdp
FROM plp_flags;
