```sql
--Description: 6. Tag every page_view on Jan‑02 as PLP / PDP / OTHER.
WITH pv AS (
  SELECT
    `user_pseudo_id`,
    (SELECT ep.value.int_value   FROM UNNEST(`event_params`) ep WHERE ep.key = 'ga_session_id') AS ga_session_id,
    `event_timestamp`,
    (SELECT ep.value.string_value FROM UNNEST(`event_params`) ep WHERE ep.key = 'page_location') AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE `event_date` = '20210102' AND `event_name` = 'page_view'
)
SELECT
  user_pseudo_id,
  ga_session_id,
  event_timestamp,
  url,
  CASE
    WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
         AND NOT REGEXP_CONTAINS(SPLIT(url,'/')[OFFSET(4)], r'\+')
         AND (
              REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(3)]), r'(accessories|apparel|brands|campus collection|drinkware|electronics|google redesign|lifestyle|nest|new 2015 logo|notebooks journals|office|shop by brand|small goods|stationery|wearables)')
           OR REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(4)]), r'(accessories|apparel|brands|campus collection|drinkware|electronics|google redesign|lifestyle|nest|new 2015 logo|notebooks journals|office|shop by brand|small goods|stationery|wearables)')
             ) THEN 'PLP'
    WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
         AND REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[ORDINAL(ARRAY_LENGTH(SPLIT(url,'/')))]), r'\+')
         AND (
              REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(3)]), r'(accessories|apparel|brands|campus collection|drinkware|electronics|google redesign|lifestyle|nest|new 2015 logo|notebooks journals|office|shop by brand|small goods|stationery|wearables)')
           OR REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(4)]), r'(accessories|apparel|brands|campus collection|drinkware|electronics|google redesign|lifestyle|nest|new 2015 logo|notebooks journals|office|shop by brand|small goods|stationery|wearables)')
             ) THEN 'PDP'
    ELSE 'OTHER'
  END AS page_type
FROM pv
ORDER BY event_timestamp
LIMIT 20;
```

```sql
--Description: 7. For every session, list whether it contains at least one PLP and at least one PDP.
WITH typed AS (
  SELECT
    `user_pseudo_id`,
    (SELECT ep.value.int_value FROM UNNEST(`event_params`) ep WHERE ep.key='ga_session_id') AS ga_session_id,
    CASE
      WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
           AND NOT REGEXP_CONTAINS(SPLIT(url,'/')[OFFSET(4)], r'\+')
           AND (
                REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(3)]), r'(accessories|apparel|brands|campus collection|drinkware|electronics|google redesign|lifestyle|nest|new 2015 logo|notebooks journals|office|shop by brand|small goods|stationery|wearables)')
             OR REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(4)]), r'(accessories|apparel|brands|campus collection|drinkware|electronics|google redesign|lifestyle|nest|new 2015 logo|notebooks journals|office|shop by brand|small goods|stationery|wearables)')
               ) THEN 'PLP'
      WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
           AND REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[ORDINAL(ARRAY_LENGTH(SPLIT(url,'/')))]), r'\+')
           AND (
                REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(3)]), r'(accessories|apparel|brands|campus collection|drinkware|electronics|google redesign|lifestyle|nest|new 2015 logo|notebooks journals|office|shop by brand|small goods|stationery|wearables)')
             OR REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(4)]), r'(accessories|apparel|brands|campus collection|drinkware|electronics|google redesign|lifestyle|nest|new 2015 logo|notebooks journals|office|shop by brand|small goods|stationery|wearables)')
               ) THEN 'PDP'
      ELSE 'OTHER'
    END AS page_type
  FROM (
    SELECT
      `user_pseudo_id`,
      (SELECT ep.value.string_value FROM UNNEST(`event_params`) ep WHERE ep.key='page_location') AS url,
      `event_params`
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
    WHERE `event_date`='20210102' AND `event_name`='page_view'
  )
)
SELECT
  user_pseudo_id,
  ga_session_id,
  COUNTIF(page_type='PLP')  > 0 AS has_PLP,
  COUNTIF(page_type='PDP')  > 0 AS has_PDP
FROM typed
GROUP BY user_pseudo_id, ga_session_id
LIMIT 20;
```

```sql
--Description: 8. Sessions where a PLP occurred *before* a PDP (proof‑of‑concept with row_number).
WITH ordered AS (
  SELECT
    `user_pseudo_id`,
    (SELECT ep.value.int_value FROM UNNEST(`event_params`) ep WHERE ep.key='ga_session_id') AS ga_session_id,
    `event_timestamp`,
    (SELECT ep.value.string_value FROM UNNEST(`event_params`) ep WHERE ep.key='page_location') AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE `event_date`='20210102' AND `event_name`='page_view'
),
typed AS (
  SELECT
    *,
    CASE
      WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
           AND NOT REGEXP_CONTAINS(SPLIT(url,'/')[OFFSET(4)], r'\+')
           AND REGEXP_CONTAINS(LOWER(CONCAT(SPLIT(url,'/')[OFFSET(3)], SPLIT(url,'/')[OFFSET(4)])),
                              r'(accessories|apparel|brands|campus collection|drinkware|electronics|google redesign|lifestyle|nest|new 2015 logo|notebooks journals|office|shop by brand|small goods|stationery|wearables)')
           THEN 'PLP'
      WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
           AND REGEXP_CONTAINS(LOWER(url), r'\+')
           THEN 'PDP'
      ELSE 'OTHER'
    END AS page_type
  FROM ordered
),
ranked AS (
  SELECT
    *,
    ROW_NUMBER() OVER(PARTITION BY user_pseudo_id, ga_session_id ORDER BY event_timestamp) AS hit_rank
  FROM typed
)
SELECT
  user_pseudo_id,
  ga_session_id,
  MIN(hit_rank) FILTER(WHERE page_type='PLP') AS first_PLP_rank,
  MIN(hit_rank) FILTER(WHERE page_type='PDP') AS first_PDP_rank
FROM ranked
GROUP BY user_pseudo_id, ga_session_id
HAVING first_PLP_rank IS NOT NULL
   AND first_PDP_rank IS NOT NULL
   AND first_PLP_rank < first_PDP_rank
LIMIT 20;
```

```sql
--Description: 9. Count PLP views and how many of those sessions converted to PDP (core numbers).
WITH base AS (
  /* same ordered+typed CTE as in previous query */
  SELECT
    `user_pseudo_id`,
    (SELECT ep.value.int_value FROM UNNEST(`event_params`) ep WHERE ep.key='ga_session_id') AS ga_session_id,
    `event_timestamp`,
    (SELECT ep.value.string_value FROM UNNEST(`event_params`) ep WHERE ep.key='page_location') AS url,
    CASE
      WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
           AND NOT REGEXP_CONTAINS(SPLIT(url,'/')[OFFSET(4)], r'\+')
           AND REGEXP_CONTAINS(LOWER(CONCAT(SPLIT(url,'/')[OFFSET(3)], SPLIT(url,'/')[OFFSET(4)])),
                              r'(accessories|apparel|brands|campus collection|drinkware|electronics|google redesign|lifestyle|nest|new 2015 logo|notebooks journals|office|shop by brand|small goods|stationery|wearables)')
           THEN 'PLP'
      WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
           AND REGEXP_CONTAINS(LOWER(url), r'\+')
           THEN 'PDP'
      ELSE 'OTHER'
    END AS page_type
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE `event_date`='20210102' AND `event_name`='page_view'
), session_level AS (
  SELECT
    user_pseudo_id,
    ga_session_id,
    COUNTIF(page_type='PLP')  AS plp_views_in_session,
    BOOL_OR(page_type='PDP')  AS session_has_pdp
  FROM base
  GROUP BY user_pseudo_id, ga_session_id
)
SELECT
  SUM(plp_views_in_session)                                   AS total_PLP_views,
  SUM(plp_views_in_session) FILTER(WHERE session_has_pdp)     AS plp_views_that_led_to_PDP
FROM session_level
LIMIT 20;
```

```sql
--Description: 10. Final step – compute the % of PLP views that produced at least one downstream PDP in the same session (single‑line answer).
WITH base AS (
  SELECT
    `user_pseudo_id`,
    (SELECT ep.value.int_value FROM UNNEST(`event_params`) ep WHERE ep.key='ga_session_id') AS ga_session_id,
    `event_timestamp`,
    (SELECT ep.value.string_value FROM UNNEST(`event_params`) ep WHERE ep.key='page_location') AS url,
    CASE
      WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
           AND NOT REGEXP_CONTAINS(SPLIT(url,'/')[OFFSET(4)], r'\+')
           AND REGEXP_CONTAINS(LOWER(CONCAT(SPLIT(url,'/')[OFFSET(3)], SPLIT(url,'/')[OFFSET(4)])),
                              r'(accessories|apparel|brands|campus collection|drinkware|electronics|google redesign|lifestyle|nest|new 2015 logo|notebooks journals|office|shop by brand|small goods|stationery|wearables)')
           THEN 'PLP'
      WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
           AND REGEXP_CONTAINS(LOWER(url), r'\+')
           THEN 'PDP'
      ELSE 'OTHER'
    END AS page_type
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE `event_date`='20210102' AND `event_name`='page_view'
), session_flags AS (
  SELECT
    user_pseudo_id,
    ga_session_id,
    COUNTIF(page_type='PLP')                    AS plp_views,
    BOOL_OR(page_type='PDP')                    AS has_pdp
  FROM base
  GROUP BY user_pseudo_id, ga_session_id
), rollup AS (
  SELECT
    SUM(plp_views)                               AS total_plp,
    SUM(plp_views) FILTER(WHERE has_pdp)         AS plp_with_pdp
  FROM session_flags
)
SELECT
  total_plp,
  plp_with_pdp,
  SAFE_DIVIDE(plp_with_pdp, total_plp) * 100 AS pct_plp_to_pdp
FROM rollup
LIMIT 20;
```

Each query is capped with `LIMIT 20` so they are safe test probes while you iterate from simple inspection (queries 1‑3) through classification (4‑6) to calculated session‑level conversion and the final percentage (queries 7‑10).
