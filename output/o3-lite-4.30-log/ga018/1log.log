    SUM(IF(has_pdp, plp_views, 0))                   AS plp_with_pdp
  FROM session_flags
)
SELECT
  total_plp,
  plp_with_pdp,
  SAFE_DIVIDE(plp_with_pdp, total_plp) * 100 AS pct_plp_to_pdp
FROM rollup;
