Begin Exploring Related Columns
Relevant columns and their potential usage

• SAMPLE_CONTENTS."sample_repo_name": repository that owns the sample file; needed to report the final repo.  
• SAMPLE_CONTENTS."sample_path": complete file path; filter by the Swift file‑extension “.swift”.  
• SAMPLE_CONTENTS."binary": Boolean flag; must be FALSE to keep only non‑binary files.  
• SAMPLE_CONTENTS."copies": number of times the same file blob (same "id") appears in other repos/refs; we want the highest value.  
• SAMPLE_CONTENTS."id": SHA of the blob; guarantees one logical file regardless of how many times it is checked‑in elsewhere.  
• (optional) LANGUAGES."language": can be joined if we want to confirm that the repo is recognised as Swift (not strictly required).

Typical conditions  
WHERE "binary" = FALSE  
AND   LOWER("sample_path") LIKE '%.swift'  

--------------------------------------------------------------------
Ten exploratory Snowflake SQL queries  
(each returns ≤ 20 rows; every column name and table name is double‑quoted).

```sql
-- 1. Description: Peek at a handful of Swift files in SAMPLE_CONTENTS
SELECT 
  "sample_repo_name",
  "sample_path",
  "binary",
  "copies",
  "id"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
WHERE "binary" = FALSE
  AND LOWER("sample_path") LIKE '%.swift'
LIMIT 20;
```

```sql
-- 2. Description: Top Swift files by copy count (may include duplicates per id)
SELECT 
  "sample_repo_name",
  "sample_path",
  "copies",
  "id"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
WHERE "binary" = FALSE
  AND LOWER("sample_path") LIKE '%.swift'
ORDER BY "copies" DESC
LIMIT 20;
```

```sql
-- 3. Description: Distinct Swift blob IDs with their highest copy count
SELECT DISTINCT
  "id",
  "copies"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
WHERE "binary" = FALSE
  AND LOWER("sample_path") LIKE '%.swift'
ORDER BY "copies" DESC
LIMIT 20;
```

```sql
-- 4. Description: For each repo, count how many non‑binary Swift files it hosts
SELECT
  "sample_repo_name",
  COUNT(*) AS "swift_file_count"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
WHERE "binary" = FALSE
  AND LOWER("sample_path") LIKE '%.swift'
GROUP BY "sample_repo_name"
ORDER BY "swift_file_count" DESC
LIMIT 20;
```

```sql
-- 5. Description: Show the single most copied Swift blob (one row per id)
SELECT
  "id",
  MAX("copies") AS "max_copies"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
WHERE "binary" = FALSE
  AND LOWER("sample_path") LIKE '%.swift'
GROUP BY "id"
ORDER BY "max_copies" DESC
LIMIT 20;
```

```sql
-- 6. Description: Associate each distinct Swift blob with the repo where it shows the max copies
SELECT
  "id",
  "sample_repo_name",
  "copies"
FROM (
  SELECT
    "id",
    "sample_repo_name",
    "copies",
    ROW_NUMBER() OVER (PARTITION BY "id" ORDER BY "copies" DESC) AS rn
  FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
  WHERE "binary" = FALSE
    AND LOWER("sample_path") LIKE '%.swift'
) q
WHERE rn = 1
ORDER BY "copies" DESC
LIMIT 20;
```

```sql
-- 7. Description: Combine #5 and #6 to spotlight the blob with the absolute highest copies
SELECT
  sub."id",
  sub."sample_repo_name",
  sub."copies"
FROM (
  SELECT
    "id",
    "sample_repo_name",
    "copies",
    ROW_NUMBER() OVER (ORDER BY "copies" DESC) AS rn
  FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
  WHERE "binary" = FALSE
    AND LOWER("sample_path") LIKE '%.swift'
  QUALIFY ROW_NUMBER() OVER (PARTITION BY "id" ORDER BY "copies" DESC) = 1
) sub
WHERE rn = 1
LIMIT 20;
```

```sql
-- 8. Description: Optionally confirm that the winning repo is tagged with Swift language
SELECT
  c."sample_repo_name",
  l."language"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"       l
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
     ON l."repo_name" = c."sample_repo_name"
WHERE c."binary" = FALSE
  AND LOWER(c."sample_path") LIKE '%.swift'
  AND c."copies" = (
        SELECT MAX("copies")
        FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
        WHERE "binary" = FALSE
          AND LOWER("sample_path") LIKE '%.swift'
      )
LIMIT 20;
```

```sql
-- 9. Description: Show all repos that contain the most‑copied Swift blob (in case it appears in many)
SELECT
  "sample_repo_name",
  "sample_path",
  "copies"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
WHERE "binary" = FALSE
  AND LOWER("sample_path") LIKE '%.swift'
  AND "copies" = (
        SELECT MAX("copies")
        FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
        WHERE "binary" = FALSE
          AND LOWER("sample_path") LIKE '%.swift'
      )
LIMIT 20;
```

```sql
-- 10. Description: Final lookup – pick the repo that owns the single most‑copied, non‑binary Swift file
SELECT
  "sample_repo_name"      AS "repo_with_most_copied_swift_file",
  "id"                    AS "blob_id",
  "copies"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
WHERE "binary" = FALSE
  AND LOWER("sample_path") LIKE '%.swift'
QUALIFY ROW_NUMBER() OVER (ORDER BY "copies" DESC) = 1
LIMIT 20;
```

