Begin Exploring Related Columns
Relevant columns and their potential usage
• SOMATIC_MUTATION_HG19_MC3_2017_02  
  – "project_short_name": filter to the TCGA‑BLCA project  
  – "Hugo_Symbol": find rows where the mutated gene is CDKN2A  
  – "case_barcode": obtain patient/case identifiers to link to the other two tables  

• RNASEQ_HG38_GDC_R39  
  – "project_short_name": keep only TCGA‑BLCA rows  
  – "gene_name": restrict to the four genes of interest (MDM2, TP53, CDKN1A, CCNE1)  
  – "case_barcode": join to the mutation‑positive barcodes  
  – "sample_barcode", "sample_type_name": distinguish Tumor vs Solid‑Tissue‑Normal samples  
  – "fpkm_unstranded", "fpkm_uq_unstranded", "tpm_unstranded": RNA‑seq expression values  

• CLINICAL_GDC_R39  
  – "submitter_id": identical to the TCGA case barcode; join to mutation‑positive barcodes  
  – selected descriptive attributes, e.g.  
       "primary_site", "disease_type", "demo__gender", "demo__race",  
       "diag__age_at_diagnosis", "demo__vital_status"  

Typical filter conditions  
1.  "SOMATIC"."project_short_name" = 'TCGA-BLCA'  
2.  "SOMATIC"."Hugo_Symbol" = 'CDKN2A'  
3.  "RNA"."project_short_name"  = 'TCGA-BLCA'  
4.  "RNA"."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')  
5.  matching barcodes: "SOMATIC"."case_barcode" = "RNA"."case_barcode"  
6.  "CLIN"."submitter_id" = "RNA"."case_barcode"  

---------------------------------------------------------------------
Example exploratory SQL statements  
Each query is limited to 20 rows and all column names are double‑quoted.

```sql
-- 1) Show all genes that are reported as mutated in the BLCA cohort
SELECT DISTINCT "Hugo_Symbol"
FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
WHERE "project_short_name" = 'TCGA-BLCA'
LIMIT 20;
```

```sql
-- 2) List the first 20 bladder‑cancer cases that carry a CDKN2A mutation
SELECT DISTINCT "case_barcode"
FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
WHERE "project_short_name" = 'TCGA-BLCA'
  AND "Hugo_Symbol" = 'CDKN2A'
LIMIT 20;
```

```sql
-- 3) Count of BLCA cases with any CDKN2A mutation
SELECT COUNT(DISTINCT "case_barcode") AS "n_cdkn2a_mut_cases"
FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
WHERE "project_short_name" = 'TCGA-BLCA'
  AND "Hugo_Symbol" = 'CDKN2A';
```

```sql
-- 4) MDM2 expression (FPKM‑UQ) in mutation‑positive cases
SELECT r."case_barcode",
       r."sample_barcode",
       r."sample_type_name",
       r."fpkm_uq_unstranded"
FROM  TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39  r
JOIN ( SELECT DISTINCT "case_barcode"
       FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
       WHERE "project_short_name" = 'TCGA-BLCA'
         AND "Hugo_Symbol" = 'CDKN2A' ) s
  ON s."case_barcode" = r."case_barcode"
WHERE r."project_short_name" = 'TCGA-BLCA'
  AND r."gene_name" = 'MDM2'
LIMIT 20;
```

```sql
-- 5) Expression (FPKM) of the four genes for each tumor sample in mutation‑positive cases
SELECT r."case_barcode",
       r."sample_barcode",
       r."gene_name",
       r."fpkm_unstranded"
FROM  TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39  r
JOIN ( SELECT DISTINCT "case_barcode"
       FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
       WHERE "project_short_name" = 'TCGA-BLCA'
         AND "Hugo_Symbol" = 'CDKN2A' ) s
  ON s."case_barcode" = r."case_barcode"
WHERE r."project_short_name" = 'TCGA-BLCA'
  AND r."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
  AND r."sample_type_name" ILIKE '%Tumor%'
LIMIT 20;
```

```sql
-- 6) Tumor vs Normal expression of TP53 (TPM) for the same patients
SELECT r."case_barcode",
       r."sample_barcode",
       r."sample_type_name",
       r."tpm_unstranded"
FROM  TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39  r
JOIN ( SELECT DISTINCT "case_barcode"
       FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
       WHERE "project_short_name" = 'TCGA-BLCA'
         AND "Hugo_Symbol" = 'CDKN2A' ) s
  ON s."case_barcode" = r."case_barcode"
WHERE r."project_short_name" = 'TCGA-BLCA'
  AND r."gene_name" = 'TP53'
LIMIT 20;
```

```sql
-- 7) Bring in a few key clinical attributes for the mutation‑positive cohort
SELECT c."submitter_id"              AS "case_barcode",
       c."primary_site",
       c."disease_type",
       c."demo__gender",
       c."diag__age_at_diagnosis",
       c."demo__vital_status"
FROM TCGA.TCGA_VERSIONED.CLINICAL_GDC_R39 c
WHERE c."submitter_id" IN (
      SELECT DISTINCT "case_barcode"
      FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
      WHERE "project_short_name" = 'TCGA-BLCA'
        AND "Hugo_Symbol" = 'CDKN2A')
LIMIT 20;
```

```sql
-- 8) Merge clinical data with MDM2 expression (FPKM‑UQ)
SELECT r."case_barcode",
       r."fpkm_uq_unstranded"  AS "MDM2_FPKM_UQ",
       c."demo__gender",
       c."diag__age_at_diagnosis",
       c."demo__vital_status"
FROM  TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39  r
JOIN  TCGA.TCGA_VERSIONED.CLINICAL_GDC_R39      c
      ON c."submitter_id" = r."case_barcode"
WHERE r."project_short_name" = 'TCGA-BLCA'
  AND r."gene_name" = 'MDM2'
  AND r."case_barcode" IN (
        SELECT DISTINCT "case_barcode"
        FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
        WHERE "project_short_name" = 'TCGA-BLCA'
          AND "Hugo_Symbol" = 'CDKN2A')
LIMIT 20;
```

```sql
-- 9) Average FPKM‑UQ across the four genes per patient (tumor samples only)
SELECT r."case_barcode",
       AVG(r."fpkm_uq_unstranded") AS "mean_fpkm_uq_four_genes"
FROM  TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39  r
WHERE r."project_short_name" = 'TCGA-BLCA'
  AND r."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
  AND r."sample_type_name" ILIKE '%Tumor%'
  AND r."case_barcode" IN (
        SELECT DISTINCT "case_barcode"
        FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
        WHERE "project_short_name" = 'TCGA-BLCA'
          AND "Hugo_Symbol" = 'CDKN2A')
GROUP BY r."case_barcode"
LIMIT 20;
```

```sql
-- 10) Comprehensive view: each tumor sample, four‑gene panel expression, plus selected clinical info
SELECT r."case_barcode",
       r."sample_barcode",
       r."gene_name",
       r."fpkm_uq_unstranded",
       c."demo__gender",
       c."diag__age_at_diagnosis",
       c."demo__vital_status"
FROM  TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39  r
JOIN  TCGA.TCGA_VERSIONED.CLINICAL_GDC_R39      c
      ON c."submitter_id" = r."case_barcode"
WHERE r."project_short_name" = 'TCGA-BLCA'
  AND r."sample_type_name" ILIKE '%Tumor%'
  AND r."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
  AND r."case_barcode" IN (
        SELECT DISTINCT "case_barcode"
        FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
        WHERE "project_short_name" = 'TCGA-BLCA'
          AND "Hugo_Symbol" = 'CDKN2A')
LIMIT 20;
```

