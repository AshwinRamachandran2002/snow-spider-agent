    bladder‑cancer (TCGA‑BLCA) patients that harbour a CDKN2A
    mutation, together with selected clinical attributes         */

SELECT
    s."case_barcode"                                                         AS case_id,
    AVG(CASE WHEN r."gene_name" = 'MDM2'   THEN r."fpkm_uq_unstranded" END)  AS mdm2_fpkm,
    AVG(CASE WHEN r."gene_name" = 'TP53'   THEN r."fpkm_uq_unstranded" END)  AS tp53_fpkm,
    AVG(CASE WHEN r."gene_name" = 'CDKN1A' THEN r."fpkm_uq_unstranded" END)  AS cdkn1a_fpkm,
    AVG(CASE WHEN r."gene_name" = 'CCNE1'  THEN r."fpkm_uq_unstranded" END)  AS ccne1_fpkm,
    c."diag__age_at_diagnosis"                                               AS age_at_diagnosis_days,
    c."demo__gender"                                                         AS gender,
    c."demo__vital_status"                                                   AS vital_status,
    c."diag__ajcc_pathologic_stage"                                          AS tumor_stage
FROM
    ( SELECT DISTINCT "case_barcode"
      FROM   TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
      WHERE  "project_short_name" = 'TCGA-BLCA'
        AND  "Hugo_Symbol"       = 'CDKN2A'
