--Description: Create a pivot‑style table listing the TPM values (which may all be NULL) for MDM2, TP53, CDKN1A, and CCNE1 for every CDKN2A‑mutated bladder‑cancer case.
WITH cdkn2a_mut_cases AS (
    SELECT DISTINCT "case_barcode"
    FROM "TCGA"."TCGA_VERSIONED"."SOMATIC_MUTATION_HG19_MC3_2017_02"
    WHERE "project_short_name" = 'TCGA-BLCA'
      AND "Hugo_Symbol" = 'CDKN2A'
),
expr AS (
    SELECT r."case_barcode",
           r."gene_name",
           r."tpm_unstranded"
    FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R39" r
    JOIN cdkn2a_mut_cases m
      ON r."case_barcode" = m."case_barcode"
    WHERE r."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
)
SELECT m."case_barcode",
       MAX(CASE WHEN e."gene_name" = 'MDM2'   THEN e."tpm_unstranded" END) AS "MDM2_TPM",
       MAX(CASE WHEN e."gene_name" = 'TP53'   THEN e."tpm_unstranded" END) AS "TP53_TPM",
