--Description: Compute, for each target gene, how many RNA‑Seq rows (if any) and the average TPM across CDKN2A‑mutated bladder‑cancer cases; uses a VALUES list so every gene is returned even when expression rows are missing.
WITH cdkn2a_mut_cases AS (
    SELECT DISTINCT "case_barcode"
    FROM "TCGA"."TCGA_VERSIONED"."SOMATIC_MUTATION_HG19_MC3_2017_02"
    WHERE "project_short_name" = 'TCGA-BLCA'
      AND "Hugo_Symbol" = 'CDKN2A'
),
gene_list AS (
    SELECT 'MDM2'  AS "gene_name" UNION ALL
    SELECT 'TP53'  UNION ALL
    SELECT 'CDKN1A' UNION ALL
    SELECT 'CCNE1'
),
expr AS (
    SELECT r."case_barcode",
           r."gene_name",
           r."tpm_unstranded"
    FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R39" r
    JOIN cdkn2a_mut_cases m
      ON r."case_barcode" = m."case_barcode"
    WHERE r."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
)
SELECT g."gene_name",
       COUNT(e."tpm_unstranded") AS "row_count",
       AVG(e."tpm_unstranded")   AS "avg_tpm"
FROM gene_list g
LEFT JOIN expr e
       ON g."gene_name" = e."gene_name"
GROUP BY g."gene_name"
LIMIT 20
