/*  RNA expression of MDM2, TP53, CDKN1A and CCNE1
    plus basic clinical information
    for bladder‑cancer (TCGA‑BLCA) cases that harbor a CDKN2A mutation          */

WITH mutated_cases AS (          -- patients with at least one CDKN2A mutation
    SELECT DISTINCT "case_barcode"
    FROM   "TCGA"."TCGA_VERSIONED"."SOMATIC_MUTATION_HG19_MC3_2017_02"
    WHERE  "project_short_name" = 'TCGA-BLCA'
      AND  "Hugo_Symbol"        = 'CDKN2A'
),
expr_raw AS (                    -- raw RNA‑Seq rows for the four genes
    SELECT  r."case_barcode",
            r."gene_name",
            r."fpkm_unstranded"        AS "fpkm"
    FROM   "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R39" r
    WHERE  r."project_short_name" = 'TCGA-BLCA'
      AND  r."gene_name"          IN ('MDM2','TP53','CDKN1A','CCNE1')
      AND  r."sample_type_name"   = 'Primary Tumor'
),
expr AS (                        -- average FPKM per case × gene (handles >1 aliquot)
    SELECT  "case_barcode",
            "gene_name",
            AVG("fpkm") AS "fpkm"
    FROM    expr_raw
    GROUP BY "case_barcode", "gene_name"
),
expr_pivot AS (                  -- pivot genes into separate columns
    SELECT
        "case_barcode",
        MAX(CASE WHEN "gene_name" = 'MDM2'   THEN "fpkm" END) AS "mdm2_fpkm",
        MAX(CASE WHEN "gene_name" = 'TP53'   THEN "fpkm" END) AS "tp53_fpkm",
        MAX(CASE WHEN "gene_name" = 'CDKN1A' THEN "fpkm" END) AS "cdkn1a_fpkm",
        MAX(CASE WHEN "gene_name" = 'CCNE1'  THEN "fpkm" END) AS "ccne1_fpkm"
    FROM expr
    GROUP BY "case_barcode"
)

SELECT
    m."case_barcode"                                AS case_id,
    e."mdm2_fpkm",
    e."tp53_fpkm",
    e."cdkn1a_fpkm",
    e."ccne1_fpkm",
    c."diag__age_at_diagnosis"                      AS age_at_diagnosis_days,
    c."demo__gender"                                AS gender,
    c."demo__vital_status"                          AS vital_status,
    c."diag__ajcc_pathologic_stage"                 AS tumor_stage
FROM   mutated_cases                           m
LEFT JOIN expr_pivot                           e ON m."case_barcode" = e."case_barcode"
LEFT JOIN "TCGA"."TCGA_VERSIONED"."CLINICAL_GDC_R39" c ON m."case_barcode" = c."submitter_id"
ORDER BY case_id;
```
