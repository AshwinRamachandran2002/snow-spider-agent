```sql
--Description: Check which (if any) TCGA projects have cases that both harbor a CDKN2A mutation (in the somatic‑mutation table)
--and possess RNA‑seq data (in the expression table).  We count the distinct overlapping case barcodes per project; if
--the result is empty, it confirms that there is no overlap, explaining earlier “no data” findings.
SELECT  m."project_short_name",
        COUNT(DISTINCT m."case_barcode") AS "overlap_case_count"
FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02 m
JOIN TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39 r
  ON r."case_barcode" = m."case_barcode"
WHERE m."Hugo_Symbol" = 'CDKN2A'
GROUP BY m."project_short_name"
ORDER BY "overlap_case_count" DESC
LIMIT 20;
