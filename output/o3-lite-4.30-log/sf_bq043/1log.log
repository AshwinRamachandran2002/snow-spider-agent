```sql
--Description:  Because the RNA‑seq table holds only TCGA‑STAD samples, we first gather all stomach‑cancer (TCGA‑STAD) cases that carry a CDKN2A mutation from the mutation table.  We then join those case barcodes to the RNA‑seq table and return TPM and FPKM‑UQ values for MDM2, TP53, CDKN1A, and CCNE1, confirming expression data exist for these CDKN2A‑mutant cases.
WITH cdkn2a_stad_cases AS (
    SELECT DISTINCT "case_barcode"
    FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
    WHERE "project_short_name" = 'TCGA-STAD'
      AND "Hugo_Symbol" = 'CDKN2A'
)
SELECT  r."case_barcode",
        r."sample_barcode",
        r."gene_name",
        r."tpm_unstranded",
        r."fpkm_uq_unstranded"
FROM cdkn2a_stad_cases c
JOIN TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39 r
      ON r."case_barcode" = c."case_barcode"
WHERE r."gene_name" IN ('MDM2', 'TP53', 'CDKN1A', 'CCNE1')
LIMIT 20;
```
