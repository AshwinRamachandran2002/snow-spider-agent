```sql
/*  RNA‑seq FPKM‑UQ expression of MDM2, TP53, CDKN1A and CCNE1
    in TCGA‑BLCA patients that carry at least one CDKN2A somatic mutation,
    together with selected clinical data (GDC Release 39)                       */

WITH cdkn2a_cases AS (   -- patients with CDKN2A mutation
    SELECT DISTINCT "case_barcode"
    FROM  TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
    WHERE "project_short_name" = 'TCGA-BLCA'
      AND "Hugo_Symbol"        = 'CDKN2A'
),

expr AS (                -- FPKM‑UQ for the four genes in primary‑tumour RNA‑seq
    SELECT
        r."case_barcode",
        ROUND(MAX(CASE WHEN r."Ensembl_gene_id" = 'ENSG00000135679' THEN r."fpkm_uq_unstranded" END),4) AS "mdm2_fpkm",
        ROUND(MAX(CASE WHEN r."Ensembl_gene_id" = 'ENSG00000141510' THEN r."fpkm_uq_unstranded" END),4) AS "tp53_fpkm",
        ROUND(MAX(CASE WHEN r."Ensembl_gene_id" = 'ENSG00000124762' THEN r."fpkm_uq_unstranded" END),4) AS "cdkn1a_fpkm",
        ROUND(MAX(CASE WHEN r."Ensembl_gene_id" = 'ENSG00000105173' THEN r."fpkm_uq_unstranded" END),4) AS "ccne1_fpkm"
    FROM  TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39 r
    JOIN  cdkn2a_cases c
          ON c."case_barcode" = r."case_barcode"
    WHERE r."project_short_name" = 'TCGA-BLCA'
      AND r."sample_type_name"   = 'Primary Tumor'
      AND r."Ensembl_gene_id" IN ('ENSG00000135679',   -- MDM2
                                  'ENSG00000141510',   -- TP53
                                  'ENSG00000124762',   -- CDKN1A
                                  'ENSG00000105173')   -- CCNE1
    GROUP BY r."case_barcode"
)

SELECT
    m."case_barcode"                                    AS "case_id",
    e."mdm2_fpkm",
    e."tp53_fpkm",
    e."cdkn1a_fpkm",
    e."ccne1_fpkm",
    clin."diag__age_at_diagnosis"                      AS "age_at_diagnosis_days",
    clin."demo__gender"                                AS "gender",
    clin."demo__vital_status"                          AS "vital_status",
    clin."diag__ajcc_pathologic_stage"                 AS "tumor_stage"
FROM  cdkn2a_cases m
LEFT JOIN expr                           e ON e."case_barcode"       = m."case_barcode"
LEFT JOIN TCGA.TCGA_VERSIONED.CLINICAL_GDC_R39 clin
       ON clin."submitter_id"            = m."case_barcode"
      AND clin."proj__project_id"        = 'TCGA-BLCA'
WHERE e."mdm2_fpkm"  IS NOT NULL
   OR e."tp53_fpkm"  IS NOT NULL
   OR e."cdkn1a_fpkm" IS NOT NULL
   OR e."ccne1_fpkm" IS NOT NULL
ORDER BY m."case_barcode";
```
