```sql
-- 1. Description: Look at which genes are mutated in TCGA‑BLCA (quick sanity check)
SELECT DISTINCT "Hugo_Symbol"
FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
WHERE "project_short_name" = 'TCGA-BLCA'
LIMIT 20;
```

```sql
-- 2. Description: Inspect CDKN2A mutations in bladder cancer
SELECT  "case_barcode",
        "sample_barcode_tumor",
        "Variant_Classification",
        "Variant_Type",
        "Start_Position",
        "End_Position"
FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
WHERE "project_short_name" = 'TCGA-BLCA'
  AND "Hugo_Symbol" = 'CDKN2A'
LIMIT 20;
```

```sql
-- 3. Description: Obtain the list of distinct cases (patients) that carry CDKN2A mutations
SELECT DISTINCT "case_barcode"
FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
WHERE "project_short_name" = 'TCGA-BLCA'
  AND "Hugo_Symbol" = 'CDKN2A'
LIMIT 20;
```

```sql
-- 4. Description: Preview available RNA‑seq sample types for TCGA‑BLCA
