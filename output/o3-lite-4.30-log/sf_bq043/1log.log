```sql
/*  RNA expression of MDM2, TP53, CDKN1A and CCNE1
    in TCGA‑BLCA cases that carry a CDKN2A mutation,
    together with selected clinical fields                                        */

WITH cdkn2a_cases AS (      -- patients with a CDKN2A somatic mutation
    SELECT DISTINCT "case_barcode"
    FROM   TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
    WHERE  "project_short_name" = 'TCGA-BLCA'
      AND  "Hugo_Symbol"       = 'CDKN2A'
),

expr AS (                   -- pivoted FPKM‑UQ values for the 4 genes
    SELECT
        r."case_barcode",
        MAX(CASE WHEN r."gene_name" = 'MDM2'   THEN r."fpkm_uq_unstranded" END) AS "mdm2_fpkm",
        MAX(CASE WHEN r."gene_name" = 'TP53'   THEN r."fpkm_uq_unstranded" END) AS "tp53_fpkm",
        MAX(CASE WHEN r."gene_name" = 'CDKN1A' THEN r."fpkm_uq_unstranded" END) AS "cdkn1a_fpkm",
        MAX(CASE WHEN r."gene_name" = 'CCNE1'  THEN r."fpkm_uq_unstranded" END) AS "ccne1_fpkm"
    FROM   TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39 r
    WHERE  r."project_short_name" = 'TCGA-BLCA'
      AND  r."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
      AND  r."sample_type_name" = 'Primary Tumor'
      AND  r."case_barcode" IN (SELECT "case_barcode" FROM cdkn2a_cases)
    GROUP BY r."case_barcode"
)

SELECT
    e."case_barcode"                       AS "case_id",
    e."mdm2_fpkm",
    e."tp53_fpkm",
    e."cdkn1a_fpkm",
    e."ccne1_fpkm",
    c."diag__age_at_diagnosis"            AS "age_at_diagnosis_days",
    c."demo__gender"                      AS "gender",
    c."demo__vital_status"                AS "vital_status",
    c."diag__ajcc_pathologic_stage"       AS "tumor_stage"
FROM   expr e
LEFT JOIN TCGA.TCGA_VERSIONED.CLINICAL_GDC_R39 c
       ON c."submitter_id"     = e."case_barcode"
      AND c."proj__project_id" = 'TCGA-BLCA'
ORDER BY e."case_barcode";
```
