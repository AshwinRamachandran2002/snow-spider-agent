FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39
WHERE "project_short_name" = 'TCGA-BLCA'
LIMIT 20;
```

```sql
-- 5. Description: Inspect raw RNA‑seq expression rows for the gene TP53
SELECT  "case_barcode",
        "sample_barcode",
        "gene_name",
        "tpm_unstranded",
        "fpkm_uq_unstranded"
FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39
WHERE "project_short_name" = 'TCGA-BLCA'
  AND "gene_name" = 'TP53'
LIMIT 20;
```

```sql
-- 6. Description: Retrieve RNA expression of the four genes in BLCA primary‑tumor samples
SELECT  "case_barcode",
        "sample_barcode",
        "gene_name",
        "tpm_unstranded",
        "fpkm_uq_unstranded"
FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39
WHERE "project_short_name" = 'TCGA-BLCA'
  AND "gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
  AND "sample_type_name" ILIKE '%Primary%Tumor%'
LIMIT 20;
```

```sql
-- 7. Description: Join CDKN2A‑mutant case list with RNA expression for the four genes
WITH cdkn2a_cases AS (
  SELECT DISTINCT "case_barcode"
  FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
  WHERE "project_short_name" = 'TCGA-BLCA'
    AND "Hugo_Symbol" = 'CDKN2A'
)
SELECT  r."case_barcode",
        r."sample_barcode",
        r."gene_name",
        r."tpm_unstranded",
        r."fpkm_uq_unstranded"
FROM cdkn2a_cases c
JOIN TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39 r
      ON r."case_barcode" = c."case_barcode"
WHERE r."project_short_name" = 'TCGA-BLCA'
  AND r."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
  AND r."sample_type_name" ILIKE '%Primary%Tumor%'
LIMIT 20;
```

```sql
-- 8. Description: Preview clinical information fields available for BLCA patients
SELECT  "submitter_id",
        "primary_site",
        "disease_type",
        "diag__ajcc_pathologic_stage",
        "demo__gender",
        "demo__race"
FROM TCGA.TCGA_VERSIONED.CLINICAL_GDC_R39
WHERE "proj__project_id" = 'TCGA-BLCA'
LIMIT 20;
```

```sql
-- 9. Description: Combine CDKN2A‑mutant cases with selected clinical data
WITH cdkn2a_cases AS (
  SELECT DISTINCT "case_barcode"
  FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
  WHERE "project_short_name" = 'TCGA-BLCA'
    AND "Hugo_Symbol" = 'CDKN2A'
)
SELECT  clin."submitter_id"  AS "case_barcode",
        clin."primary_site",
        clin."disease_type",
        clin."diag__ajcc_pathologic_stage",
        clin."demo__gender",
        clin."demo__race"
FROM cdkn2a_cases m
JOIN TCGA.TCGA_VERSIONED.CLINICAL_GDC_R39 clin
      ON clin."submitter_id" = m."case_barcode"
WHERE clin."proj__project_id" = 'TCGA-BLCA'
LIMIT 20;
```

```sql
-- 10. Description: Final integrated view – RNA expression & clinical data for CDKN2A‑mutant BLCA cases
WITH cdkn2a_cases AS (
  SELECT DISTINCT "case_barcode"
  FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG19_MC3_2017_02
  WHERE "project_short_name" = 'TCGA-BLCA'
    AND "Hugo_Symbol" = 'CDKN2A'
)
SELECT  r."case_barcode",
        r."sample_barcode",
        r."gene_name",
        r."tpm_unstranded",
        r."fpkm_uq_unstranded",
        clin."primary_site",
        clin."disease_type",
        clin."diag__ajcc_pathologic_stage",
        clin."demo__gender",
        clin."demo__race"
FROM cdkn2a_cases m
JOIN TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39 r
      ON r."case_barcode" = m."case_barcode"
JOIN TCGA.TCGA_VERSIONED.CLINICAL_GDC_R39 clin
      ON clin."submitter_id" = r."case_barcode"
WHERE r."project_short_name" = 'TCGA-BLCA'
  AND clin."proj__project_id" = 'TCGA-BLCA'
  AND r."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
  AND r."sample_type_name" ILIKE '%Primary%Tumor%'
LIMIT 20;
```

