      FROM    "CRYPTO"."CRYPTO_ETHEREUM"."TOKEN_TRANSFERS"
      WHERE   "token_address" ILIKE '0xa92a861fc11b99b24296af880011b47f9cafb5ab'
      UNION ALL
      SELECT  "from_address" AS "address",
              -TRY_TO_NUMBER("value") AS "amount_signed"
      FROM    "CRYPTO"."CRYPTO_ETHEREUM"."TOKEN_TRANSFERS"
      WHERE   "token_address" ILIKE '0xa92a861fc11b99b24296af880011b47f9cafb5ab'
),
balances AS (
      SELECT
        "address",
        SUM("amount_signed") AS "net_balance"
      FROM flows
      GROUP BY "address"
      HAVING SUM("amount_signed") > 0          -- only positive holders
)
SELECT
  "address",
  "net_balance"
FROM balances
ORDER BY "net_balance" ASC                     -- smallest first
LIMIT 20;                                      -- will include the top‑3 smallest
