      SELECT  "to_address"   AS "address",
              TRY_TO_NUMBER("value") AS "amount_signed"
      FROM    "CRYPTO"."CRYPTO_ETHEREUM"."TOKEN_TRANSFERS"
      WHERE   "token_address" ILIKE '0xa92a861fc11b99b24296af880011b47f9cafb5ab'
      UNION ALL
      SELECT  "from_address" AS "address",
              -TRY_TO_NUMBER("value") AS "amount_signed"
      FROM    "CRYPTO"."CRYPTO_ETHEREUM"."TOKEN_TRANSFERS"
      WHERE   "token_address" ILIKE '0xa92a861fc11b99b24296af880011b47f9cafb5ab'
)
SELECT
  "address",
  SUM("amount_signed") AS "net_balance"
FROM flows
GROUP BY "address"
ORDER BY "net_balance" ASC      -- smallest first (can be negative)
LIMIT 20;
