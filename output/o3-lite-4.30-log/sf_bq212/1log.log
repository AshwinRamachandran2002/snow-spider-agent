2025-05-01 00:46:37 - Thread-74 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
• "publication_number": retrieves the unique patent‑publication identifier that will finally be reported.  
• "country_code": lets us limit the sample to United‑States patents ('US').  
• "kind_code": holds the DOCDB kind code; we will filter on 'B2'.  
• "grant_date": numeric YYYYMMDD value used for the June‑to‑September‑2022 window (20220601‑20220930).  
• "application_kind": very high‑level application type; keep 'A' to make sure we only look at utility patents (skip design ‘F’, etc.).  
• "ipc": VARIANT array that contains objects with the field "code"; we will FLATTEN this column to obtain individual IPC codes per patent.  
• Extracted helper field ipc4 (SUBSTR(ipc_code,1,4)): used to compute the most frequent 4‑digit IPC code for each publication.  

Typical conditions that will be used  
• WHERE "country_code" = 'US'  
• AND   "kind_code" = 'B2'  
• AND   "grant_date" BETWEEN 20220601 AND 20220930  
• AND   "application_kind" = 'A'  
• LATERAL FLATTEN(input => t."ipc") f   
• WHERE f.value:"code" IS NOT NULL  

------------------------------------------------------------  
Ten exploratory‑to‑final Snowflake SQL queries (each limited to 20 rows)  

```sql
-- Description: 1) Look at a handful of publication numbers just to get a feel for the data.
SELECT DISTINCT 
       t."publication_number"
FROM   PATENTS.PATENTS.PUBLICATIONS t
LIMIT 20;
```

```sql
-- Description: 2) Inspect distinct kind codes (to verify that 'B2' exists).
SELECT DISTINCT 
       t."kind_code"
FROM   PATENTS.PATENTS.PUBLICATIONS t
LIMIT 20;
```

```sql
-- Description: 3) List a few U.S. B2 publications granted in 2022 (no IPC yet).
SELECT 
       t."publication_number",
       t."grant_date",
       t."kind_code"
FROM   PATENTS.PATENTS.PUBLICATIONS t
WHERE  t."country_code" = 'US'
  AND  t."kind_code"    = 'B2'
  AND  t."grant_date" BETWEEN 20220101 AND 20221231
LIMIT 20;
```

```sql
-- Description: 4) Quickly confirm the June‑Sept‑2022 time window.
SELECT 
       t."publication_number",
       t."grant_date"
FROM   PATENTS.PATENTS.PUBLICATIONS t
WHERE  t."country_code"   = 'US'
  AND  t."kind_code"      = 'B2'
  AND  t."grant_date" BETWEEN 20220601 AND 20220930
LIMIT 20;
```

```sql
-- Description: 5) Flatten the ipc array and show raw IPC codes for a few patents.
SELECT 
       t."publication_number",
       f.value:"code"::STRING   AS "ipc_code"
FROM   PATENTS.PATENTS.PUBLICATIONS t, 
       LATERAL FLATTEN(input => t."ipc") f
WHERE  t."country_code" = 'US'
  AND  t."kind_code"    = 'B2'
  AND  t."grant_date" BETWEEN 20220601 AND 20220930
  AND  f.value:"code" IS NOT NULL
LIMIT 20;
```

```sql
-- Description: 6) Extract first 4 characters (IPC4) and inspect frequency per publication.
SELECT 
       t."publication_number",
       SUBSTR(f.value:"code"::STRING,1,4) AS "ipc4",
       COUNT(*)                           AS "ipc4_count"
FROM   PATENTS.PATENTS.PUBLICATIONS t, 
       LATERAL FLATTEN(input => t."ipc") f
WHERE  t."country_code"   = 'US'
  AND  t."kind_code"      = 'B2'
  AND  t."grant_date" BETWEEN 20220601 AND 20220930
  AND  f.value:"code" IS NOT NULL
GROUP BY 
       t."publication_number",
       "ipc4"
LIMIT 20;
```

```sql
-- Description: 7) For each patent keep only the IPC4 with the largest count (ties kept).
WITH ipc4_counts AS (
    SELECT 
           t."publication_number",
           SUBSTR(f.value:"code"::STRING,1,4) AS "ipc4",
           COUNT(*)                            AS "ipc4_cnt"
    FROM   PATENTS.PATENTS.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."ipc") f
    WHERE  t."country_code" = 'US'
      AND  t."kind_code"    = 'B2'
      AND  t."grant_date" BETWEEN 20220601 AND 20220930
      AND  f.value:"code" IS NOT NULL
    GROUP BY t."publication_number", "ipc4"
), ranked AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY "publication_number" 
                              ORDER BY "ipc4_cnt" DESC) AS rn
    FROM   ipc4_counts
)
SELECT 
       "publication_number",
       "ipc4",
       "ipc4_cnt"
FROM   ranked
WHERE  rn = 1
LIMIT 20;
```

```sql
-- Description: 8) Count how many different patents share each chosen‑per‑patent IPC4.
WITH ipc4_per_patent AS (
    SELECT 
           r."publication_number",
           r."ipc4"
    FROM (
        SELECT 
               t."publication_number",
               SUBSTR(f.value:"code"::STRING,1,4) AS "ipc4",
               COUNT(*) AS cnt,
               ROW_NUMBER() OVER (PARTITION BY t."publication_number" 
                                  ORDER BY COUNT(*) DESC) AS rn
        FROM   PATENTS.PATENTS.PUBLICATIONS t,
               LATERAL FLATTEN(input => t."ipc") f
        WHERE  t."country_code" = 'US'
          AND  t."kind_code"    = 'B2'
          AND  t."grant_date" BETWEEN 20220601 AND 20220930
          AND  f.value:"code" IS NOT NULL
        GROUP BY t."publication_number", "ipc4"
    ) r
    WHERE rn = 1
)
SELECT 
       p."ipc4",
       COUNT(*) AS "n_patents"
FROM   ipc4_per_patent p
GROUP BY p."ipc4"
HAVING COUNT(*) >= 10
LIMIT 20;
```

```sql
-- Description: 9) Bring back the publication numbers for IPC4s that appear in ≥10 patents.
WITH ipc4_per_patent AS (
    SELECT 
           r."publication_number",
           r."ipc4"
    FROM (
        SELECT 
               t."publication_number",
               SUBSTR(f.value:"code"::STRING,1,4) AS "ipc4",
               COUNT(*) AS cnt,
               ROW_NUMBER() OVER (PARTITION BY t."publication_number" 
                                  ORDER BY COUNT(*) DESC) AS rn
        FROM   PATENTS.PATENTS.PUBLICATIONS t,
               LATERAL FLATTEN(input => t."ipc") f
        WHERE  t."country_code" = 'US'
          AND  t."kind_code"    = 'B2'
          AND  t."grant_date" BETWEEN 20220601 AND 20220930
          AND  f.value:"code" IS NOT NULL
        GROUP BY t."publication_number", "ipc4"
    ) r
    WHERE rn = 1
), ipc4_freq AS (
    SELECT "ipc4"
    FROM   ipc4_per_patent
    GROUP BY "ipc4"
    HAVING COUNT(*) >= 10
)
SELECT 
       p."publication_number",
       p."ipc4"
FROM   ipc4_per_patent p
JOIN   ipc4_freq       f
  ON   p."ipc4" = f."ipc4"
LIMIT 20;
```

```sql
-- Description: 10) Final full answer query (same logic as 9 but without LIMIT).
WITH ipc4_counts AS (
    SELECT 
           t."publication_number",
           SUBSTR(f.value:"code"::STRING,1,4) AS "ipc4",
           COUNT(*) AS "cnt"
    FROM   PATENTS.PATENTS.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."ipc") f
    WHERE  t."country_code"   = 'US'
      AND  t."kind_code"      = 'B2'
      AND  t."grant_date" BETWEEN 20220601 AND 20220930
      AND  t."application_kind" = 'A'
      AND  f.value:"code" IS NOT NULL
    GROUP BY t."publication_number", "ipc4"
), ipc4_ranked AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY "publication_number" 
                              ORDER BY "cnt" DESC) AS rn
    FROM   ipc4_counts
), ipc4_per_patent AS (
    SELECT "publication_number", "ipc4"
    FROM   ipc4_ranked
    WHERE  rn = 1
), ipc4_frequent AS (
    SELECT "ipc4"
    FROM   ipc4_per_patent
    GROUP BY "ipc4"
    HAVING COUNT(*) >= 10
)
SELECT 
       p."publication_number",
       p."ipc4"
FROM   ipc4_per_patent p
JOIN   ipc4_frequent  f
  ON   p."ipc4" = f."ipc4";
```
