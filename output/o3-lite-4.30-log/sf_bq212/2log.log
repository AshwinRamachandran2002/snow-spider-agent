Current sql:
/*  United States utility (patent) B2 grants between 2022‑06‑01 and 2022‑09‑30.
    1. Determine, for every patent, the most‑frequent 4‑digit IPC code (IPC4).
    2. Keep only those patents whose “main” IPC4 occurs in at least 10 different patents.
    3. Return the publication number and that IPC4.                                     */

WITH filtered AS (   -- cohort selection & IPC4 extraction
    SELECT
        p."publication_number",
        SUBSTR(f.value:"code"::STRING, 1, 4) AS "ipc4"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."ipc") f
    WHERE p."country_code"      = 'US'
      AND p."kind_code"         = 'B2'
      AND p."application_kind"  = 'A'          -- utility patents; excludes design (“F”)
      AND p."publication_date" BETWEEN 20220601 AND 20220930
),
main_ipc AS (        -- most‑frequent IPC4 for each patent
    SELECT
        "publication_number",
        "ipc4",
        COUNT(*)                                       AS "ipc4_count",
        ROW_NUMBER() OVER (
            PARTITION BY "publication_number"
            ORDER BY COUNT(*) DESC, "ipc4"
        )                                             AS "rnk"
    FROM filtered
    GROUP BY "publication_number", "ipc4"
),
ipc4_with_10 AS (    -- IPC4 codes appearing in ≥10 different patents
    SELECT "ipc4"
    FROM main_ipc
    WHERE "rnk" = 1
    GROUP BY "ipc4"
    HAVING COUNT(*) >= 10
)
SELECT
    m."publication_number",
    m."ipc4"
FROM main_ipc m
JOIN ipc4_with_10 i
  ON m."ipc4" = i."ipc4"
WHERE m."rnk" = 1
ORDER BY m."ipc4", m."publication_number";
