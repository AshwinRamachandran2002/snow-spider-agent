--Description: List publication numbers and IPC4 codes for patents whose main IPC4 appears in at least 10 different patents.
WITH main_ipc AS (
    SELECT
        p."publication_number",
        SUBSTR(f.value:"code"::STRING, 1, 4) AS "ipc4",
        ROW_NUMBER() OVER (
            PARTITION BY p."publication_number"
            ORDER BY COUNT(*) DESC
        ) AS "rnk"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."ipc") f
    WHERE p."country_code" = 'US'
      AND p."kind_code" = 'B2'
      AND p."application_kind" = 'A'
      AND p."publication_date" BETWEEN 20220601 AND 20220930
    GROUP BY p."publication_number", SUBSTR(f.value:"code"::STRING, 1, 4)
), ipc4_with_10 AS (
    SELECT "ipc4"
    FROM main_ipc
    WHERE "rnk" = 1
    GROUP BY "ipc4"
    HAVING COUNT(*) >= 10
)
SELECT
    m."publication_number",
    m."ipc4"
FROM main_ipc m
JOIN ipc4_with_10 i
  ON m."ipc4" = i."ipc4"
WHERE m."rnk" = 1
LIMIT 20;
