2025-05-01 00:46:40 - Thread-75 (execute) - INFO - [Exploration]
Relevant columns, potential usage & typical filter conditions  
• "publication_number": identifier of each patent publication – SELECT list, GROUP BY  
• "country_code": filter to U.S. patents –  WHERE "country_code" = 'US'  
• "kind_code": patent stage/type –  WHERE "kind_code" = 'B2' (granted)  
• "application_kind": high‑level type –  WHERE "application_kind" = 'U' (utility)  – optional extra screen  
• "publication_date": grant/publication date –  WHERE "publication_date" BETWEEN 20220601 AND 20220930 (Jun‑Sep 2022)  
• "ipc": VARIANT array holding IPC objects – must be flattened to read each element  
• ipc element → value:"code": actual IPC code string – substring first 4 chars for IPC4  
• derived field SUBSTR(value:"code"::STRING,1,4) AS "ipc4": four‑digit IPC code  
• COUNT(*) / ROW_NUMBER() for frequency calculations  

10 exploratory → increasingly complex Snowflake queries  
(Each limited to 20 rows, all identifiers double‑quoted)

```sql
-- 1) Quick look at basic publication fields
SELECT DISTINCT
    "publication_number",
    "country_code",
    "kind_code",
    "application_kind",
    "publication_date"
FROM PATENTS.PATENTS.PUBLICATIONS
LIMIT 20;
```

```sql
-- 2) U.S. B2 publications in the June‑Sept 2022 window
SELECT DISTINCT
    "publication_number",
    "publication_date",
    "kind_code"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'US'
  AND "kind_code" = 'B2'
  AND "publication_date" BETWEEN 20220601 AND 20220930
LIMIT 20;
```

```sql
-- 3) Same as #2 but add the optional utility filter
SELECT DISTINCT
    "publication_number",
    "application_kind",
    "publication_date"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'US'
  AND "kind_code" = 'B2'
  AND "application_kind" = 'U'
  AND "publication_date" BETWEEN 20220601 AND 20220930
LIMIT 20;
```

```sql
-- 4) Inspect raw IPC JSON objects for a few filtered patents
SELECT
    p."publication_number",
    f.value AS "ipc_raw"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."ipc") f
WHERE p."country_code" = 'US'
  AND p."kind_code" = 'B2'
  AND p."publication_date" BETWEEN 20220601 AND 20220930
LIMIT 20;
```

```sql
-- 5) Extract the IPC code string from the JSON
SELECT
    p."publication_number",
    f.value:"code"::STRING AS "ipc_code"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."ipc") f
WHERE p."country_code" = 'US'
  AND p."kind_code" = 'B2'
  AND p."publication_date" BETWEEN 20220601 AND 20220930
LIMIT 20;
```

```sql
-- 6) Derive the four‑digit IPC (IPC4) for quick inspection
SELECT
    p."publication_number",
    SUBSTR(f.value:"code"::STRING, 1, 4) AS "ipc4"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."ipc") f
WHERE p."country_code" = 'US'
  AND p."kind_code" = 'B2'
  AND p."publication_date" BETWEEN 20220601 AND 20220930
LIMIT 20;
```

```sql
-- 7) Count how often each IPC4 appears within a single patent
SELECT
    p."publication_number",
    SUBSTR(f.value:"code"::STRING, 1, 4) AS "ipc4",
    COUNT(*) AS "ipc4_occurrences"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."ipc") f
WHERE p."country_code" = 'US'
  AND p."kind_code" = 'B2'
  AND p."publication_date" BETWEEN 20220601 AND 20220930
GROUP BY p."publication_number", ipc4
ORDER BY "ipc4_occurrences" DESC
LIMIT 20;
```

```sql
-- 8) Identify the single most‑frequent IPC4 for each patent
SELECT *
FROM (
    SELECT
        p."publication_number",
        SUBSTR(f.value:"code"::STRING, 1, 4) AS "ipc4",
        COUNT(*) AS "ipc4_count",
        ROW_NUMBER() OVER (
            PARTITION BY p."publication_number"
            ORDER BY COUNT(*) DESC
        ) AS "rnk"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."ipc") f
    WHERE p."country_code" = 'US'
      AND p."kind_code" = 'B2'
      AND p."publication_date" BETWEEN 20220601 AND 20220930
    GROUP BY p."publication_number", ipc4
) t
WHERE "rnk" = 1
LIMIT 20;
```

```sql
-- 9) Count how many patents share the same “main” IPC4; keep those ≥10
WITH main_ipc AS (
    SELECT
        p."publication_number",
        SUBSTR(f.value:"code"::STRING, 1, 4) AS "ipc4",
        ROW_NUMBER() OVER (
            PARTITION BY p."publication_number"
            ORDER BY COUNT(*) DESC
        ) AS "rnk"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."ipc") f
    WHERE p."country_code" = 'US'
      AND p."kind_code" = 'B2'
      AND p."publication_date" BETWEEN 20220601 AND 20220930
    GROUP BY p."publication_number", ipc4
)
SELECT
    "ipc4",
    COUNT(*) AS "patent_count"
FROM main_ipc
WHERE "rnk" = 1
GROUP BY "ipc4"
HAVING COUNT(*) >= 10
LIMIT 20;
```

```sql
-- 10) Patents whose most frequent IPC4 appears at least 10 times across the cohort
WITH main_ipc AS (
    SELECT
        p."publication_number",
        SUBSTR(f.value:"code"::STRING, 1, 4) AS "ipc4",
        ROW_NUMBER() OVER (
            PARTITION BY p."publication_number"
            ORDER BY COUNT(*) DESC
        ) AS "rnk"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."ipc") f
    WHERE p."country_code" = 'US'
      AND p."kind_code" = 'B2'
      AND p."publication_date" BETWEEN 20220601 AND 20220930
    GROUP BY p."publication_number", ipc4
), ipc4_with_10 AS (
    SELECT "ipc4"
    FROM main_ipc
    WHERE "rnk" = 1
    GROUP BY "ipc4"
    HAVING COUNT(*) >= 10
)
SELECT
    m."publication_number",
    m."ipc4"
FROM main_ipc m
JOIN ipc4_with_10 i
  ON m."ipc4" = i."ipc4"
WHERE m."rnk" = 1
LIMIT 20;
```

The ten queries progress from simple inspection of columns to the full logic needed to fulfill the stated task.
