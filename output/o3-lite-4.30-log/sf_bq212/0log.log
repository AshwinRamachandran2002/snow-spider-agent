```sql
--Description: 
-- Objective
--   • Find every U.S. utility patent (kind B2) granted between 1 Jun 2022 and 30 Sep 2022.  
--   • Inside each patent, choose the 4‑digit IPC code (IPC4) that appears most often   
--     (ties kept).  
--   • Keep only those IPC4s that serve as the “main” IPC4 for ≥ 10 different patents.  
--   • Return the publication numbers together with their qualifying IPC4 codes.  
-- Method
--   1. Filter PUBLICATIONS for the cohort, FLATTEN the JSON array "ipc".  
--   2. Count how many times every IPC4 occurs within each patent (ipc_counts).  
--   3. QUALIFY with a window MAX() to retain the highest‑frequency IPC4 per patent (main_ipc).  
--   4. Aggregate main_ipc to see which IPC4s reach the ≥ 10‑patent threshold (popular_ipc4).  
--   5. Join back and list publication numbers + IPC4 that satisfy the popularity rule.  
WITH ipc_counts AS (                               -- Step 2
    SELECT
        p."publication_number",
        SUBSTR(ipc_item.value:"code"::STRING, 1, 4) AS "ipc4",
        COUNT(*) AS "freq"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."ipc") ipc_item
    WHERE p."country_code"     = 'US'             -- Step 1 cohort filters
      AND p."kind_code"        = 'B2'
      AND p."application_kind" = 'A'
      AND p."grant_date" BETWEEN 20220601 AND 20220930
    GROUP BY
        p."publication_number",
        "ipc4"
),
main_ipc AS (                                     -- Step 3
    SELECT
        "publication_number",
        "ipc4"
    FROM ipc_counts
    QUALIFY "freq" = MAX("freq") OVER (PARTITION BY "publication_number")
),
popular_ipc4 AS (                                 -- Step 4
    SELECT "ipc4"
    FROM   main_ipc
    GROUP  BY "ipc4"
    HAVING COUNT(*) >= 10
)
-- Step 5: final answer
SELECT
    mi."publication_number",
    mi."ipc4"
FROM   main_ipc mi
JOIN   popular_ipc4 pi
  ON   mi."ipc4" = pi."ipc4"
ORDER BY
    mi."ipc4",
    mi."publication_number";
