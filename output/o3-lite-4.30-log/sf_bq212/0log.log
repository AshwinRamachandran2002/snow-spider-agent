```sql
--Description: 
-- Objective: Find U.S. utility patents (kind B2) granted from 1 Jun 2022 to 30 Sep 2022 whose
--            “main” 4‑digit IPC code (IPC4) occurs as the main code in ≥ 10 patents.
-- Strategy:
--   1. Filter PUBLICATIONS for the date‑/country‑/kind‑/utility criteria and flatten the "ipc" array.
--   2. Derive IPC4 by taking the first 4 characters of each IPC "code", then count how often each IPC4
--      appears **within** each patent (ipc_counts).
--   3. Select, for every patent, the IPC4 with the highest intra‑patent frequency (main_ipc).  
--      Ties are kept because QUALIFY uses the max‑frequency condition.
--   4. Identify IPC4s that serve as the main IPC4 in at least 10 patents (popular_ipc4).
--   5. Return the publication numbers and their IPC4 if they belong to the popular set.
WITH ipc_counts AS (          -- Step 2
    SELECT
        p."publication_number",
        SUBSTR(ipc_item.value:"code"::STRING, 1, 4) AS "ipc4",
        COUNT(*) AS "freq"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."ipc") ipc_item
    WHERE p."country_code"     = 'US'     -- Step 1 filters
      AND p."kind_code"        = 'B2'
      AND p."application_kind" = 'A'
      AND p."grant_date" BETWEEN 20220601 AND 20220930
    GROUP BY
        p."publication_number",
        "ipc4"
),
main_ipc AS (                 -- Step 3
    SELECT *
    FROM   ipc_counts ic
    QUALIFY ic."freq" = (
        SELECT MAX(ic2."freq")
        FROM   ipc_counts ic2
        WHERE  ic2."publication_number" = ic."publication_number"
    )
),
popular_ipc4 AS (             -- Step 4
    SELECT "ipc4"
    FROM   main_ipc
    GROUP  BY "ipc4"
    HAVING COUNT(*) >= 10
)
SELECT                        -- Step 5: final answer
    mi."publication_number",
    mi."ipc4"
FROM   main_ipc mi
JOIN   popular_ipc4 pi
  ON   mi."ipc4" = pi."ipc4"
ORDER BY
    mi."ipc4",
    mi."publication_number";
```
