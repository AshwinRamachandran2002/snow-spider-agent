--Description: 10) Complete list of patents whose main IPC4 is shared by ≥10 patents (ordered output).
WITH main_ipc AS (
    SELECT
        p."publication_number",
        SUBSTR(ipc_item.value:"code"::STRING, 1, 4) AS "ipc4",
        COUNT(*) AS "freq"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."ipc") ipc_item
    WHERE p."country_code"     = 'US'
      AND p."kind_code"        = 'B2'
      AND p."application_kind" = 'A'
      AND p."grant_date" BETWEEN 20220601 AND 20220930
    GROUP BY
        p."publication_number",
        "ipc4"
    QUALIFY "freq" = MAX("freq") OVER (PARTITION BY "publication_number")
), popular_ipc4 AS (
    SELECT
        "ipc4"
    FROM   main_ipc
    GROUP  BY "ipc4"
    HAVING COUNT(*) >= 10
)
SELECT
    mi."publication_number",
    mi."ipc4"
FROM   main_ipc mi
JOIN   popular_ipc4 pi
  ON   mi."ipc4" = pi."ipc4"
ORDER BY
    mi."ipc4",
    mi."publication_number"
LIMIT 20
