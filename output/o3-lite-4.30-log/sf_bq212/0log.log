Begin Exploring Related Columns
Relevant columns and their potential usage  
• "publication_number": identifier to be displayed in final list.  
• "country_code": filter to U.S. patents ("US").  
• "kind_code": filter to B‑series grants, specifically "B2".  
• "grant_date": used to keep only grants between 20220601 and 20220930 (≈ June‑Sept 2022).  
• "application_kind": keep only utility patents ("A").  
• "ipc": VARIANT array that stores all IPC codes per patent; needs FLATTEN.  
  – ipc_item.value:"code" ⇒ full IPC symbol (e.g. ‘A01K005/00’).  
  – SUBSTR(ipc_item.value:"code"::STRING,1,4) ⇒ IPC4 to be counted.  

General conditions that may be used  
• WHERE "country_code" = 'US'  
• AND   "kind_code" = 'B2'  
• AND   "grant_date" BETWEEN 20220601 AND 20220930  
• AND   "application_kind" = 'A'  

Below are ten incremental Snowflake SQL queries (LIMIT 20 for sampling).  
All identifiers are enclosed in double quotation marks as required.

```sql
--Description: 1) Quick look at a few 2022 U.S. B2 publications.
SELECT 
    "publication_number", 
    "kind_code", 
    "grant_date"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'US'
  AND "kind_code" = 'B2'
  AND "grant_date" BETWEEN 20220101 AND 20221231
LIMIT 20;
```

```sql
--Description: 2) Restrict to utility patents (“application_kind” = 'A') granted June‑Sept 2022.
SELECT 
    "publication_number", 
    "grant_date", 
    "application_kind"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code"      = 'US'
  AND "kind_code"         = 'B2'
  AND "application_kind"  = 'A'
  AND "grant_date" BETWEEN 20220601 AND 20220930
LIMIT 20;
```

```sql
--Description: 3) Inspect raw IPC JSON for one patent (flattened view).
SELECT 
    t."publication_number",
    ipc_item.value AS "ipc_raw"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."ipc") ipc_item
WHERE t."publication_number" ILIKE 'US-%'
LIMIT 20;
```

```sql
--Description: 4) Extract full IPC symbol string from the JSON.
SELECT 
    t."publication_number",
    ipc_item.value:"code"::STRING AS "ipc_code"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."ipc") ipc_item
WHERE t."country_code" = 'US'
  AND t."kind_code"    = 'B2'
  AND t."grant_date" BETWEEN 20220601 AND 20220930
LIMIT 20;
```

```sql
--Description: 5) Derive 4‑digit IPC (IPC4) and count how often each IPC4 occurs per patent.
SELECT
    t."publication_number",
    SUBSTR(ipc_item.value:"code"::STRING,1,4) AS "ipc4"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."ipc") ipc_item
WHERE t."country_code"     = 'US'
  AND t."kind_code"        = 'B2'
  AND t."application_kind" = 'A'
  AND t."grant_date" BETWEEN 20220601 AND 20220930
LIMIT 20;
```

```sql
--Description: 6) Aggregate to get frequency of each IPC4 inside every patent.
SELECT
    t."publication_number",
    SUBSTR(ipc_item.value:"code"::STRING,1,4) AS "ipc4",
    COUNT(*) AS "ipc4_freq_in_patent"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."ipc") ipc_item
WHERE t."country_code"     = 'US'
  AND t."kind_code"        = 'B2'
  AND t."application_kind" = 'A'
  AND t."grant_date" BETWEEN 20220601 AND 20220930
GROUP BY
    t."publication_number",
    "ipc4"
LIMIT 20;
```

```sql
--Description: 7) For every patent, pick the IPC4 that occurs most frequently (ties kept).
WITH ipc_counts AS (
    SELECT
        t."publication_number",
        SUBSTR(ipc_item.value:"code"::STRING,1,4) AS "ipc4",
        COUNT(*) AS "freq"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."ipc") ipc_item
    WHERE t."country_code"     = 'US'
      AND t."kind_code"        = 'B2'
      AND t."application_kind" = 'A'
      AND t."grant_date" BETWEEN 20220601 AND 20220930
    GROUP BY t."publication_number", "ipc4"
)
SELECT *
FROM ipc_counts
QUALIFY "freq" = (SELECT MAX(freq) FROM ipc_counts ic2 
                  WHERE ic2."publication_number" = ipc_counts."publication_number")
LIMIT 20;
```

```sql
--Description: 8) Count how many patents share the same “most‑frequent” IPC4.
WITH main_ipc AS (
    SELECT
        t."publication_number",
        SUBSTR(ipc_item.value:"code"::STRING,1,4) AS "ipc4",
        COUNT(*) AS "freq"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."ipc") ipc_item
    WHERE t."country_code"     = 'US'
      AND t."kind_code"        = 'B2'
      AND t."application_kind" = 'A'
      AND t."grant_date" BETWEEN 20220601 AND 20220930
    GROUP BY t."publication_number", "ipc4"
    QUALIFY "freq" = MAX("freq") OVER (PARTITION BY "publication_number")
)
SELECT
    "ipc4",
    COUNT(*) AS "num_patents_with_this_main_ipc4"
FROM main_ipc
GROUP BY "ipc4"
ORDER BY "num_patents_with_this_main_ipc4" DESC
LIMIT 20;
```

```sql
--Description: 9) Retrieve patents whose main IPC4 appears ≥ 10 times across the cohort.
WITH main_ipc AS (
    SELECT
        t."publication_number",
        SUBSTR(ipc_item.value:"code"::STRING,1,4) AS "ipc4",
        COUNT(*) AS "freq"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."ipc") ipc_item
    WHERE t."country_code"     = 'US'
      AND t."kind_code"        = 'B2'
      AND t."application_kind" = 'A'
      AND t."grant_date" BETWEEN 20220601 AND 20220930
    GROUP BY t."publication_number", "ipc4"
    QUALIFY "freq" = MAX("freq") OVER (PARTITION BY "publication_number")
), ipc4_totals AS (
    SELECT "ipc4"
    FROM   main_ipc
    GROUP  BY "ipc4"
    HAVING COUNT(*) >= 10
)
SELECT
    m."publication_number",
    m."ipc4"
FROM main_ipc m
JOIN ipc4_totals t
  ON m."ipc4" = t."ipc4"
LIMIT 20;
```

```sql
--Description: 10) Full final answer list (no LIMIT) ordered by IPC4 and publication number.
--(LIMIT kept at 20 for demonstration; remove LIMIT to show complete results)
WITH main_ipc AS (
    SELECT
        p."publication_number",
        SUBSTR(ipc_item.value:"code"::STRING,1,4) AS "ipc4",
        COUNT(*) AS "freq"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."ipc") ipc_item
    WHERE p."country_code"     = 'US'
      AND p."kind_code"        = 'B2'
      AND p."application_kind" = 'A'
      AND p."grant_date" BETWEEN 20220601 AND 20220930
    GROUP BY p."publication_number", "ipc4"
    QUALIFY "freq" = MAX("freq") OVER (PARTITION BY "publication_number")
), ipc4_selected AS (
    SELECT "ipc4"
    FROM   main_ipc
    GROUP  BY "ipc4"
    HAVING COUNT(*) >= 10
)
SELECT
    m."publication_number",
    m."ipc4"
FROM   main_ipc m
JOIN   ipc4_selected s
  ON   m."ipc4" = s."ipc4"
ORDER BY
    m."ipc4",
    m."publication_number"
LIMIT 20;
```
