-- 10. Final answer: one row per category showing the player(s) who own the record
WITH career AS (
    SELECT player_id,
           SUM(g)  AS total_g,
           SUM(r)  AS total_r,
           SUM(h)  AS total_h,
           SUM(hr) AS total_hr
    FROM   batting
    GROUP  BY player_id
),
max_vals AS (
    SELECT MAX(total_g)  AS max_g,
           MAX(total_r)  AS max_r,
           MAX(total_h)  AS max_h,
           MAX(total_hr) AS max_hr
    FROM   career
)
SELECT 'Games Played' AS category,
       p.name_given,
       c.total_g       AS value
FROM   career AS c, max_vals AS m
JOIN   player  AS p ON p.player_id = c.player_id
WHERE  c.total_g = m.max_g

UNION ALL
SELECT 'Runs'         AS category,
       p.name_given,
       c.total_r       AS value
FROM   career AS c, max_vals AS m
JOIN   player  AS p ON p.player_id = c.player_id
WHERE  c.total_r = m.max_r

UNION ALL
SELECT 'Hits'         AS category,
       p.name_given,
       c.total_h       AS value
FROM   career AS c, max_vals AS m
JOIN   player  AS p ON p.player_id = c.player_id
WHERE  c.total_h = m.max_h

UNION ALL
SELECT 'Home Runs'    AS category,
       p.name_given,
       c.total_hr      AS value
FROM   career AS c, max_vals AS m
JOIN   player  AS p ON p.player_id = c.player_id
WHERE  c.total_hr = m.max_hr;
