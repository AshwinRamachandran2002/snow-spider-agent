WHERE DATE(pickup_datetime) BETWEEN '2016-01-01' AND '2016-01-07'
  AND dropoff_datetime > pickup_datetime
  AND passenger_count > 0
  AND trip_distance >= 0
  AND tip_amount    >= 0
  AND tolls_amount  >= 0
  AND mta_tax       >= 0
  AND fare_amount   > 0          -- exclude zero fare to avoid div‑by‑0
  AND total_amount  >= 0
  AND g.borough NOT IN ('EWR','Staten Island')
GROUP BY g.borough, tip_bucket
LIMIT 20;
