Begin Exploring Related Columns
Relevant columns, their potential usage and important conditions  
---------------------------------------------------------------  
customers.customerid: customer identifier used to join with orders and order_details.  
orders.orderid: primary key to link a set of order_details lines to one order.  
orders.customerid: links an order to the customer who placed it.  
orders.orderdate: filter orders to the year 1998 with the condition  
  strftime('%Y', orders."orderdate") = '1998'.  
order_details.unitprice: price of each product line, used in the spend calculation.  
order_details.quantity: number of units in the line, multiplied by unitprice.  
customergroupthreshold.rangebottom / rangetop: numeric limits that define the spending bands.  
customergroupthreshold.groupname: label of each spending band.  

Queries (simple to complex, each different, 20‑row sample where applicable)  
---------------------------------------------------------------------------  

```sql
-- 1. Years for which we have orders (helps confirm '1998' exists)
SELECT DISTINCT strftime('%Y', "orderdate") AS "order_year"
FROM "orders"
ORDER BY "order_year"
LIMIT 20;
```

```sql
-- 2. A sample of orders placed in 1998
SELECT "orderid", "customerid", "orderdate"
FROM "orders"
WHERE strftime('%Y', "orderdate") = '1998'
LIMIT 20;
```

```sql
-- 3. Customers who placed at least one order in 1998
SELECT DISTINCT "customerid"
FROM "orders"
WHERE strftime('%Y', "orderdate") = '1998'
LIMIT 20;
```

```sql
-- 4. Company names of those 1998 customers
SELECT DISTINCT c."customerid", c."companyname"
FROM "customers" AS c
JOIN "orders"  AS o ON c."customerid" = o."customerid"
WHERE strftime('%Y', o."orderdate") = '1998'
LIMIT 20;
```

```sql
-- 5. Order‑detail lines belonging to 1998 orders
SELECT od."orderid", od."productid", od."unitprice", od."quantity"
FROM "order_details" AS od
JOIN "orders"        AS o ON od."orderid" = o."orderid"
WHERE strftime('%Y', o."orderdate") = '1998'
LIMIT 20;
```

```sql
-- 6. Spend per order (line value = unitprice * quantity) for 1998 orders
SELECT od."orderid",
       ROUND(SUM(od."unitprice" * od."quantity"), 2) AS "order_total"
FROM "order_details" AS od
JOIN "orders"        AS o ON od."orderid" = o."orderid"
WHERE strftime('%Y', o."orderdate") = '1998'
GROUP BY od."orderid"
LIMIT 20;
```

```sql
-- 7. Total spend per customer for the year 1998
SELECT o."customerid",
       ROUND(SUM(od."unitprice" * od."quantity"), 2) AS "customer_total_1998"
FROM "orders"        AS o
JOIN "order_details" AS od ON od."orderid" = o."orderid"
WHERE strftime('%Y', o."orderdate") = '1998'
GROUP BY o."customerid"
LIMIT 20;
```

```sql
-- 8. Map each 1998 customer to a spending group (Low / Medium / High)
SELECT ct."customerid",
       ct."customer_total_1998",
       cgt."groupname"
FROM (
        SELECT o."customerid",
               SUM(od."unitprice" * od."quantity") AS "customer_total_1998"
        FROM "orders"        AS o
        JOIN "order_details" AS od ON od."orderid" = o."orderid"
        WHERE strftime('%Y', o."orderdate") = '1998'
        GROUP BY o."customerid"
     ) AS ct
JOIN "customergroupthreshold" AS cgt
  ON ct."customer_total_1998" >= cgt."rangebottom"
 AND ct."customer_total_1998" <= cgt."rangetop"
LIMIT 20;
```

```sql
-- 9. Count how many customers fall in each spending group for 1998
SELECT cgt."groupname",
       COUNT(*) AS "customers_in_group"
FROM (
        SELECT o."customerid",
               SUM(od."unitprice" * od."quantity") AS "customer_total_1998"
        FROM "orders"        AS o
        JOIN "order_details" AS od ON od."orderid" = o."orderid"
        WHERE strftime('%Y', o."orderdate") = '1998'
        GROUP BY o."customerid"
     ) AS ct
JOIN "customergroupthreshold" AS cgt
  ON ct."customer_total_1998" >= cgt."rangebottom"
 AND ct."customer_total_1998" <= cgt."rangetop"
GROUP BY cgt."groupname"
ORDER BY "customers_in_group" DESC
LIMIT 20;
```

```sql
-- 10. Final query: count & percentage of 1998 customers in each spending group
SELECT cgt."groupname",
       COUNT(*) AS "customers_in_group",
       ROUND(100.0 * COUNT(*) / (
              SELECT COUNT(DISTINCT o."customerid")
              FROM "orders" AS o
              WHERE strftime('%Y', o."orderdate") = '1998'
            ), 2) AS "percent_of_1998_customers"
FROM (
        SELECT o."customerid",
               SUM(od."unitprice" * od."quantity") AS "customer_total_1998"
        FROM "orders"        AS o
        JOIN "order_details" AS od ON od."orderid" = o."orderid"
        WHERE strftime('%Y', o."orderdate") = '1998'
        GROUP BY o."customerid"
     ) AS ct
JOIN "customergroupthreshold" AS cgt
  ON ct."customer_total_1998" >= cgt."rangebottom"
 AND ct."customer_total_1998" <= cgt."rangetop"
GROUP BY cgt."groupname"
ORDER BY "customers_in_group" DESC;
```

Each query is a plain SELECT (no schema inspection) and samples at most 20 rows when appropriate.
