The table structure information is ({database name: {schema name: [table name]}}): 
{'spider2-public-data': {'1000_genomes': ['sample_info', 'pedigree', 'variants']}}
Begin Exploring Related Columns
Relevant columns & their usage
• sample_info.Sample  : primary key to join with the variant call_set_name  
• sample_info.Super_Population : separates “EAS” (cases) from all others (controls)  
• variants.reference_name   : chromosome name – filter = '12'  
• variants.start / variants.end : genomic co‑ordinates to return  
• variants.call.call_set_name  : sample ID inside every variant  
• variants.call.genotype    : ARRAY with 0 (=ref), 1 (=alt), -1 (=missing) – count alleles  
(we only need the first allele index; un‑nest both positions to count every allele)

Typical conditions  
• WHERE v.reference_name = '12'  
• CASE WHEN Super_Population = 'EAS' THEN 'EAS' ELSE 'OTHER' END AS grp  
• Only keep genotype values IN (0,1)  
• Aggregate counts by (grp, allele)  
• Expected counts of every cell ≥ 5  
• χ²Yates ≥ 29.71679  

────────────────────────────────────────────────────────────────────────
Below are ten exploratory → production BigQuery statements – each different – showing how to walk from a simple peek at the data to the final answer.  

```sql
-- 1. See what chromosomes exist in the variant table
SELECT DISTINCT reference_name
FROM `spider2-public-data.1000_genomes.variants`
ORDER BY reference_name
LIMIT 20;
```

```sql
-- 2. Preview 20 variants on chromosome 12
SELECT reference_name, start, end, alternate_bases
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = '12'
LIMIT 20;
```

```sql
-- 3. List a few samples together with their super‑population
SELECT Sample AS sample_id, Super_Population
FROM `spider2-public-data.1000_genomes.sample_info`
WHERE Super_Population IS NOT NULL
LIMIT 20;
```

```sql
-- 4. How many samples belong to each super‑population?
SELECT Super_Population, COUNT(*) AS n_samples
FROM `spider2-public-data.1000_genomes.sample_info`
GROUP BY Super_Population
ORDER BY n_samples DESC;
```

```sql
-- 5. Raw allele counts for ONE example variant on chr12
WITH sg AS (
  SELECT Sample AS id,
         CASE WHEN Super_Population = 'EAS' THEN 'EAS' ELSE 'OTHER' END AS grp
  FROM `spider2-public-data.1000_genomes.sample_info`
)
SELECT v.start, v.end, sg.grp,
       SUM(IF(g = 0, 1, 0)) AS ref_alleles,
       SUM(IF(g = 1, 1, 0)) AS alt_alleles
FROM `spider2-public-data.1000_genomes.variants` v
JOIN UNNEST(v.call) c
JOIN UNNEST(c.genotype) g
JOIN sg ON sg.id = c.call_set_name
WHERE v.reference_name = '12'
  AND v.start = 11180375               -- example co‑ordinate, change as needed
  AND g IN (0,1)
GROUP BY v.start, v.end, sg.grp;
```

```sql
-- 6. Build allele counts for EVERY chr12 variant (still keeping the two groups)
WITH sg AS (
  SELECT Sample AS id,
         CASE WHEN Super_Population = 'EAS' THEN 'EAS' ELSE 'OTHER' END AS grp
  FROM `spider2-public-data.1000_genomes.sample_info`
)
SELECT v.reference_name, v.start, v.end, sg.grp,
       SUM(IF(g = 0, 1, 0)) AS ref_alleles,
       SUM(IF(g = 1, 1, 0)) AS alt_alleles
FROM `spider2-public-data.1000_genomes.variants` v
JOIN UNNEST(v.call) c
JOIN UNNEST(c.genotype) g
JOIN sg ON sg.id = c.call_set_name
WHERE v.reference_name = '12'
  AND g IN (0,1)
GROUP BY v.reference_name, v.start, v.end, sg.grp
LIMIT 20;
```

```sql
-- 7. Pivot those counts so every row = one variant with four observed cells
WITH sg AS (
  SELECT Sample AS id,
         CASE WHEN Super_Population = 'EAS' THEN 'EAS' ELSE 'OTHER' END AS grp
  FROM `spider2-public-data.1000_genomes.sample_info`
),
obs AS (
  SELECT v.start, v.end, sg.grp,
         SUM(IF(g = 0, 1, 0)) AS ref_ct,
         SUM(IF(g = 1, 1, 0)) AS alt_ct
  FROM `spider2-public-data.1000_genomes.variants` v
  JOIN UNNEST(v.call) c
  JOIN UNNEST(c.genotype) g
  JOIN sg ON sg.id = c.call_set_name
  WHERE v.reference_name = '12'
    AND g IN (0,1)
  GROUP BY v.start, v.end, sg.grp
),
pivot AS (
  SELECT start, end,
         SUM(IF(grp='EAS',  ref_ct, 0)) AS ref_cases,
         SUM(IF(grp='EAS',  alt_ct, 0)) AS alt_cases,
         SUM(IF(grp='OTHER',ref_ct, 0)) AS ref_ctrls,
         SUM(IF(grp='OTHER',alt_ct, 0)) AS alt_ctrls
  FROM obs
  GROUP BY start, end
)
SELECT * FROM pivot
LIMIT 20;
```

```sql
-- 8. Compute χ² with Yates continuity correction for the first 100 variants
WITH sg AS (
  SELECT Sample AS id,
         CASE WHEN Super_Population = 'EAS' THEN 'EAS' ELSE 'OTHER' END AS grp
  FROM `spider2-public-data.1000_genomes.sample_info`
),
counts AS (
  SELECT v.start, v.end, sg.grp,
         SUM(IF(g = 0, 1, 0)) AS ref_ct,
         SUM(IF(g = 1, 1, 0)) AS alt_ct
  FROM `spider2-public-data.1000_genomes.variants` v
  JOIN UNNEST(v.call) c
  JOIN UNNEST(c.genotype) g
  JOIN sg ON sg.id = c.call_set_name
  WHERE v.reference_name = '12'
    AND g IN (0,1)
  GROUP BY v.start, v.end, sg.grp
  LIMIT 100     -- just a small sample for speed
),
tbl AS (
  SELECT start, end,
         SUM(IF(grp='EAS',  ref_ct, 0)) AS A,  -- ref cases
         SUM(IF(grp='EAS',  alt_ct, 0)) AS B,  -- alt cases
         SUM(IF(grp='OTHER',ref_ct, 0)) AS C,  -- ref ctrls
         SUM(IF(grp='OTHER',alt_ct, 0)) AS D   -- alt ctrls
  FROM counts
  GROUP BY start, end
),
chi AS (
  SELECT start, end, A, B, C, D,
         (A+B+C+D)                               AS N,
         (A+C)                                   AS row_ref,
         (B+D)                                   AS row_alt,
         (A+B)                                   AS col_cases,
         (C+D)                                   AS col_ctrls
  FROM tbl
)
SELECT start, end,
       -- expected counts
       (col_cases*row_ref)/N  AS exp_A,
       (col_cases*row_alt)/N  AS exp_B,
       (col_ctrls*row_ref)/N  AS exp_C,
       (col_ctrls*row_alt)/N  AS exp_D
FROM chi
WHERE N IS NOT NULL
LIMIT 20;
```

```sql
-- 9. Same as #8 but actually compute χ²Yates and keep rows with every expected ≥5
WITH sg AS (
  SELECT Sample AS id,
         CASE WHEN Super_Population = 'EAS' THEN 'EAS' ELSE 'OTHER' END AS grp
  FROM `spider2-public-data.1000_genomes.sample_info`
),
raw AS (
  SELECT v.start, v.end, sg.grp,
         SUM(IF(g = 0, 1, 0)) AS ref_ct,
         SUM(IF(g = 1, 1, 0)) AS alt_ct
  FROM `spider2-public-data.1000_genomes.variants` v
  JOIN UNNEST(v.call) c
  JOIN UNNEST(c.genotype) g
  JOIN sg ON sg.id = c.call_set_name
  WHERE v.reference_name = '12'
    AND g IN (0,1)
  GROUP BY v.start, v.end, sg.grp
),
tbl AS (
  SELECT start, end,
         SUM(IF(grp='EAS',  ref_ct, 0)) AS A,
         SUM(IF(grp='EAS',  alt_ct, 0)) AS B,
         SUM(IF(grp='OTHER',ref_ct, 0)) AS C,
         SUM(IF(grp='OTHER',alt_ct, 0)) AS D
  FROM raw
  GROUP BY start, end
),
chi AS (
  SELECT *,
         (A+B+C+D)                                     AS N,
         (A+C)                                         AS row_ref,
         (B+D)                                         AS row_alt,
         (A+B)                                         AS col_cases,
         (C+D)                                         AS col_ctrls
  FROM tbl
),
calc AS (
  SELECT start, end,
         A, B, C, D,
         -- expected counts
         (col_cases*row_ref)/N AS EA,
         (col_cases*row_alt)/N AS EB,
         (col_ctrls*row_ref)/N AS EC,
         (col_ctrls*row_alt)/N AS ED
  FROM chi
),
chi2 AS (
  SELECT start, end,
         A, B, C, D, EA, EB, EC, ED,
         -- Yates χ²
         POWER(ABS(A-EA)-0.5,2)/EA +
         POWER(ABS(B-EB)-0.5,2)/EB +
         POWER(ABS(C-EC)-0.5,2)/EC +
         POWER(ABS(D-ED)-0.5,2)/ED   AS chi_sq
  FROM calc
  WHERE EA>=5 AND EB>=5 AND EC>=5 AND ED>=5
)
SELECT * FROM chi2
ORDER BY chi_sq DESC
LIMIT 20;
```

```sql
-- 10. FINAL QUERY – top chromosome‑12 variants with χ²Yates ≥ 29.71679
WITH sample_groups AS (
  SELECT Sample AS id,
         CASE WHEN Super_Population = 'EAS' THEN 'EAS' ELSE 'OTHER' END AS grp
  FROM `spider2-public-data.1000_genomes.sample_info`
),
allele_counts AS (
  SELECT v.start, v.end, sg.grp,
         SUM(IF(g = 0, 1, 0)) AS ref_alleles,
         SUM(IF(g = 1, 1, 0)) AS alt_alleles
  FROM `spider2-public-data.1000_genomes.variants`  v
  JOIN UNNEST(v.call)                c
  JOIN UNNEST(c.genotype)            g
  JOIN sample_groups                 sg
       ON sg.id = c.call_set_name
  WHERE v.reference_name = '12'
        AND g IN (0,1)              -- ignore missing
  GROUP BY v.start, v.end, sg.grp
),
four_cell AS (
  SELECT start, end,
         SUM(IF(grp='EAS',  ref_alleles, 0)) AS A,  -- ref cases
         SUM(IF(grp='EAS',  alt_alleles, 0)) AS B,  -- alt cases
         SUM(IF(grp='OTHER',ref_alleles, 0)) AS C,  -- ref ctrls
         SUM(IF(grp='OTHER',alt_alleles, 0)) AS D   -- alt ctrls
  FROM allele_counts
  GROUP BY start, end
),
expected AS (
  SELECT start, end, A, B, C, D,
         (A+B+C+D)         AS N,
         (A+C)             AS row_ref,
         (B+D)             AS row_alt,
         (A+B)             AS col_cases,
         (C+D)             AS col_ctrls
  FROM four_cell
),
chi2 AS (
  SELECT start, end,
         A, B, C, D,
         (col_cases*row_ref)/N AS EA,
         (col_cases*row_alt)/N AS EB,
         (col_ctrls*row_ref)/N AS EC,
         (col_ctrls*row_alt)/N AS ED
  FROM expected
),
scored AS (
  SELECT start, end,
         POWER(ABS(A-EA)-0.5,2)/EA +
         POWER(ABS(B-EB)-0.5,2)/EB +
         POWER(ABS(C-EC)-0.5,2)/EC +
         POWER(ABS(D-ED)-0.5,2)/ED   AS chi_square
  FROM chi2
  WHERE EA>=5 AND EB>=5 AND EC>=5 AND ED>=5          -- expected counts rule
)
SELECT start, end, chi_square
FROM scored
WHERE chi_square >= 29.71679
ORDER BY chi_square DESC
LIMIT 100;
```

