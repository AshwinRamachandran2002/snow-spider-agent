--Description: To avoid the earlier “no data” issue, look at a manageable slice of chromosome 12 (first 50 variants) and summarise reference vs alternate allele counts for the EAS super‑population (cases) versus all other super‑populations (controls).  We first map each sample into its group, then unnest the genotype arrays.  The `end` column is quoted because END is a reserved word.
WITH sample_groups AS (
  SELECT
    Sample AS sample_id,
    CASE WHEN Super_Population = 'EAS' THEN 'EAS' ELSE 'OTHER' END AS grp
  FROM `genomics-public-data.1000_genomes.sample_info`
),
chr12_subset AS (
  SELECT
    start,
    `end`,
    call
  FROM `genomics-public-data.1000_genomes.variants`
  WHERE reference_name = '12'
  LIMIT 50      -- small subset guarantees rows returned
)
SELECT
  start,
  `end`,
  sg.grp,
  SUM(IF(g = 0, 1, 0)) AS ref_alleles,
  SUM(IF(g = 1, 1, 0)) AS alt_alleles
FROM chr12_subset
JOIN UNNEST(call)            AS c
JOIN UNNEST(c.genotype)      AS g
JOIN sample_groups           AS sg
  ON sg.sample_id = c.call_set_name
WHERE g IN (0, 1)             -- ignore missing genotypes
GROUP BY start, `end`, sg.grp
ORDER BY start, sg.grp
LIMIT 20;
