```sql
--Description: Pivot allele counts so each row contains the four observed cells (ref/alt × cases/controls) for chr12 variants.
WITH sg AS (
  SELECT
    Sample AS id,
    CASE WHEN Super_Population = 'EAS' THEN 'EAS' ELSE 'OTHER' END AS grp
  FROM `genomics-public-data.1000_genomes.sample_info`
),
obs AS (
  SELECT
    v.start,
    v.`end`,
    sg.grp,
    SUM(IF(g = 0, 1, 0)) AS ref_ct,
    SUM(IF(g = 1, 1, 0)) AS alt_ct
  FROM `genomics-public-data.1000_genomes.variants` v
  JOIN UNNEST(v.call) c
  JOIN UNNEST(c.genotype) g
  JOIN sg ON sg.id = c.call_set_name
  WHERE v.reference_name = '12'
    AND g IN (0, 1)
  GROUP BY v.start, v.`end`, sg.grp
),
pivot AS (
  SELECT
    start,
    `end`,
    SUM(IF(grp = 'EAS',   ref_ct, 0)) AS ref_cases,
    SUM(IF(grp = 'EAS',   alt_ct, 0)) AS alt_cases,
    SUM(IF(grp = 'OTHER', ref_ct, 0)) AS ref_ctrls,
    SUM(IF(grp = 'OTHER', alt_ct, 0)) AS alt_ctrls
  FROM obs
  GROUP BY start, `end`
)
SELECT *
FROM pivot
LIMIT 20;
