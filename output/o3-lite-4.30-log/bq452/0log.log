```sql
--Description: Compute expected counts for the first 100 chr12 variants and display them (Yates χ² not yet applied).
WITH sg AS (
  SELECT
    Sample AS id,
    CASE WHEN Super_Population = 'EAS' THEN 'EAS' ELSE 'OTHER' END AS grp
  FROM `genomics-public-data.1000_genomes.sample_info`
),
counts AS (
  SELECT
    v.start,
    v.`end`,
    sg.grp,
    SUM(IF(g = 0, 1, 0)) AS ref_ct,
    SUM(IF(g = 1, 1, 0)) AS alt_ct
  FROM `genomics-public-data.1000_genomes.variants` v
  JOIN UNNEST(v.call) c
  JOIN UNNEST(c.genotype) g
  JOIN sg ON sg.id = c.call_set_name
  WHERE v.reference_name = '12'
    AND g IN (0, 1)
  GROUP BY v.start, v.`end`, sg.grp
  LIMIT 100
),
tbl AS (
  SELECT
    start,
    `end`,
    SUM(IF(grp = 'EAS',   ref_ct, 0)) AS A,
    SUM(IF(grp = 'EAS',   alt_ct, 0)) AS B,
    SUM(IF(grp = 'OTHER', ref_ct, 0)) AS C,
    SUM(IF(grp = 'OTHER', alt_ct, 0)) AS D
  FROM counts
  GROUP BY start, `end`
),
chi AS (
  SELECT
    start,
    `end`,
    A, B, C, D,
    (A + B + C + D)      AS N,
    (A + C)              AS row_ref,
    (B + D)              AS row_alt,
    (A + B)              AS col_cases,
    (C + D)              AS col_ctrls
  FROM tbl
)
SELECT
  start,
  `end`,
  (col_cases * row_ref) / N AS exp_A,
  (col_cases * row_alt) / N AS exp_B,
  (col_ctrls * row_ref) / N AS exp_C,
  (col_ctrls * row_alt) / N AS exp_D
FROM chi
WHERE N IS NOT NULL
LIMIT 20;
```

```sql
--Description: Compute Yates‑corrected χ² for chr12 variants and keep those where every expected cell ≥ 5.
WITH sg AS (
  SELECT
    Sample AS id,
    CASE WHEN Super_Population = 'EAS' THEN 'EAS' ELSE 'OTHER' END AS grp
  FROM `genomics-public-data.1000_genomes.sample_info`
),
raw AS (
  SELECT
    v.start,
    v.`end`,
    sg.grp,
    SUM(IF(g = 0, 1, 0)) AS ref_ct,
    SUM(IF(g = 1, 1, 0)) AS alt_ct
  FROM `genomics-public-data.1000_genomes.variants` v
  JOIN UNNEST(v.call) c
  JOIN UNNEST(c.genotype) g
  JOIN sg ON sg.id = c.call_set_name
  WHERE v.reference_name = '12'
    AND g IN (0, 1)
  GROUP BY v.start, v.`end`, sg.grp
),
tbl AS (
  SELECT
    start,
    `end`,
    SUM(IF(grp = 'EAS',   ref_ct, 0)) AS A,
    SUM(IF(grp = 'EAS',   alt_ct, 0)) AS B,
    SUM(IF(grp = 'OTHER', ref_ct, 0)) AS C,
    SUM(IF(grp = 'OTHER', alt_ct, 0)) AS D
  FROM raw
  GROUP BY start, `end`
),
exp AS (
  SELECT
    start,
    `end`,
    A, B, C, D,
    (A + B + C + D)       AS N,
    (A + C)               AS row_ref,
    (B + D)               AS row_alt,
    (A + B)               AS col_cases,
    (C + D)               AS col_ctrls
  FROM tbl
),
chi AS (
  SELECT
    start,
    `end`,
    A, B, C, D,
    (col_cases * row_ref) / N AS EA,
    (col_cases * row_alt) / N AS EB,
    (col_ctrls * row_ref) / N AS EC,
    (col_ctrls * row_alt) / N AS ED
  FROM exp
),
chi2 AS (
  SELECT
    start,
    `end`,
    POWER(ABS(A - EA) - 0.5, 2) / EA +
    POWER(ABS(B - EB) - 0.5, 2) / EB +
    POWER(ABS(C - EC) - 0.5, 2) / EC +
    POWER(ABS(D - ED) - 0.5, 2) / ED AS chi_sq
  FROM chi
  WHERE EA >= 5 AND EB >= 5 AND EC >= 5 AND ED >= 5
)
SELECT *
FROM chi2
ORDER BY chi_sq DESC
LIMIT 20;
```

