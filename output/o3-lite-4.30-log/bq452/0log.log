  JOIN UNNEST(v.call)     c
  JOIN UNNEST(c.genotype) g
  JOIN sample_groups      sg
    ON sg.id = c.call_set_name
  WHERE v.reference_name = '12'
    AND g IN (0, 1)
  GROUP BY v.start, v.`end`, sg.grp
),
four_cell AS (
  SELECT
    start,
    `end`,
    SUM(IF(grp = 'EAS',   ref_alleles, 0)) AS A,
    SUM(IF(grp = 'EAS',   alt_alleles, 0)) AS B,
    SUM(IF(grp = 'OTHER', ref_alleles, 0)) AS C,
    SUM(IF(grp = 'OTHER', alt_alleles, 0)) AS D
  FROM allele_counts
  GROUP BY start, `end`
),
expected AS (
  SELECT
    start,
    `end`,
    A, B, C, D,
    (A + B + C + D)       AS N,
    (A + C)               AS row_ref,
    (B + D)               AS row_alt,
    (A + B)               AS col_cases,
    (C + D)               AS col_ctrls
  FROM four_cell
),
chi_vals AS (
