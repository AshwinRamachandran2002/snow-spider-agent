    (A + C)              AS row_ref,
    (B + D)              AS row_alt,
    (A + B)              AS col_cases,
    (C + D)              AS col_ctrls
  FROM tbl
)
SELECT
  start,
  `end`,
  (col_cases * row_ref) / N AS exp_A,
  (col_cases * row_alt) / N AS exp_B,
  (col_ctrls * row_ref) / N AS exp_C,
  (col_ctrls * row_alt) / N AS exp_D
FROM chi
WHERE N IS NOT NULL
LIMIT 20;
