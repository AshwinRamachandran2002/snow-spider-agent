  JOIN UNNEST(c.genotype) AS g
  JOIN sample_groups      AS sg
    ON sg.id = c.call_set_name
  WHERE v.reference_name = '12'
    AND g IN (0, 1)
  GROUP BY v.start, v.`end`, sg.grp
),
four_cell AS (
  SELECT
    start,
    `end`,
    SUM(IF(grp = 'EAS',   ref_alleles, 0)) AS A,
    SUM(IF(grp = 'EAS',   alt_alleles, 0)) AS B,
    SUM(IF(grp = 'OTHER', ref_alleles, 0)) AS C,
    SUM(IF(grp = 'OTHER', alt_alleles, 0)) AS D
  FROM allele_counts
  GROUP BY start, `end`
),
expected AS (
  SELECT
    start,
    `end`,
    A, B, C, D,
    (A + B + C + D)       AS N,
    (A + C)               AS row_ref,
    (B + D)               AS row_alt,
    (A + B)               AS col_cases,
    (C + D)               AS col_ctrls
  FROM four_cell
),
chi_vals AS (
  SELECT
    start,
    `end`,
    (col_cases * row_ref) / N AS EA,
    (col_cases * row_alt) / N AS EB,
    (col_ctrls * row_ref) / N AS EC,
    (col_ctrls * row_alt) / N AS ED,
    A, B, C, D
  FROM expected
),
scored AS (
  SELECT
    start,
    `end`,
    POWER(ABS(A - EA) - 0.5, 2) / EA +
    POWER(ABS(B - EB) - 0.5, 2) / EB +
    POWER(ABS(C - EC) - 0.5, 2) / EC +
    POWER(ABS(D - ED) - 0.5, 2) / ED AS chi_square
  FROM chi_vals
  WHERE EA >= 5 AND EB >= 5 AND EC >= 5 AND ED >= 5
        AND (POWER(ABS(A - EA) - 0.5, 2) / EA +
             POWER(ABS(B - EB) - 0.5, 2) / EB +
             POWER(ABS(C - EC) - 0.5, 2) / EC +
             POWER(ABS(D - ED) - 0.5, 2) / ED) >= 29.71679
)
SELECT
  start,
  `end`,
  chi_square
FROM scored
ORDER BY chi_square DESC
LIMIT 100
