Ten exploratory → analytical BigQuery queries
(Each query is different; they all return ≤ 20 rows.)

```sql
-- 1. Description: List distinct chromosomes present in the variants table.
SELECT DISTINCT reference_name
FROM `spider2-public-data.1000_genomes.variants`
LIMIT 20;
```

```sql
-- 2. Description: Preview a few rows of sample_info to see the Sample and Super_Population columns.
SELECT Sample, Super_Population, Super_Population_Description
FROM `spider2-public-data.1000_genomes.sample_info`
LIMIT 20;
```

```sql
-- 3. Description: Count the number of samples in each super‑population.
SELECT Super_Population, COUNT(*) AS n_samples
FROM `spider2-public-data.1000_genomes.sample_info`
GROUP BY Super_Population
ORDER BY n_samples DESC
LIMIT 20;
```

```sql
-- 4. Description: Show 20 variants that are on chromosome 12 and are biallelic.
SELECT reference_name, start, end, alternate_bases
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = '12'
  AND ARRAY_LENGTH(alternate_bases) = 1
LIMIT 20;
```

```sql
-- 5. Description: Unnest the call array for a single variant to view genotypes per sample.
SELECT v.start, c.call_set_name, c.genotype
FROM `spider2-public-data.1000_genomes.variants` AS v
CROSS JOIN UNNEST(v.call) AS c
WHERE v.reference_name = '12'
  AND ARRAY_LENGTH(v.alternate_bases) = 1
LIMIT 20;
```

```sql
-- 6. Description: Join one variant’s genotypes with sample_info to tag cases vs controls.
SELECT v.start,
       c.call_set_name AS sample,
       s.Super_Population,
       c.genotype
FROM `spider2-public-data.1000_genomes.variants` AS v
CROSS JOIN UNNEST(v.call) AS c
JOIN `spider2-public-data.1000_genomes.sample_info` AS s
  ON s.Sample = c.call_set_name
WHERE v.reference_name = '12'
  AND ARRAY_LENGTH(v.alternate_bases) = 1
LIMIT 20;
```

```sql
-- 7. Description: For 20 variants, compute raw allele counts (ref vs alt) stratified by EAS vs non‑EAS.
SELECT v.start,
       CASE WHEN s.Super_Population = 'EAS' THEN 'case' ELSE 'control' END AS grp,
       SUM(CASE WHEN gt = 1 THEN 1 ELSE 0 END) AS alt_alleles,
       SUM(CASE WHEN gt = 0 THEN 1 ELSE 0 END) AS ref_alleles
FROM `spider2-public-data.1000_genomes.variants`  AS v
CROSS JOIN UNNEST(v.call)                         AS c
CROSS JOIN UNNEST(c.genotype)                    AS gt
JOIN `spider2-public-data.1000_genomes.sample_info` AS s
  ON s.Sample = c.call_set_name
WHERE v.reference_name = '12'
  AND ARRAY_LENGTH(v.alternate_bases) = 1
  AND gt IN (0,1)
GROUP BY v.start, grp
LIMIT 20;
```

```sql
-- 8. Description: For each variant build the 2×2 contingency table and keep only those with expected ≥ 5.
WITH allele_counts AS (
  SELECT v.start, v.end,
         CASE WHEN s.Super_Population = 'EAS' THEN 'case' ELSE 'control' END AS grp,
         SUM(CASE WHEN gt = 1 THEN 1 ELSE 0 END) AS alt_cnt,
         SUM(CASE WHEN gt = 0 THEN 1 ELSE 0 END) AS ref_cnt
  FROM `spider2-public-data.1000_genomes.variants`  AS v
  CROSS JOIN UNNEST(v.call)                         AS c
  CROSS JOIN UNNEST(c.genotype)                    AS gt
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.Sample = c.call_set_name
  WHERE v.reference_name = '12'
    AND ARRAY_LENGTH(v.alternate_bases) = 1
    AND gt IN (0,1)
  GROUP BY v.start, v.end, grp
)
SELECT *
FROM allele_counts
WHERE alt_cnt + ref_cnt >= 5   -- crude guard; full expected check later
LIMIT 20;
```

```sql
-- 9. Description: Compute Yates‑corrected χ² for each variant (no expected‑count filter yet).
WITH ct AS (
  SELECT v.start, v.end,
         SUM(CASE WHEN s.Super_Population = 'EAS' THEN alt ELSE 0 END) AS case_alt,
         SUM(CASE WHEN s.Super_Population = 'EAS' THEN ref ELSE 0 END) AS case_ref,
         SUM(CASE WHEN s.Super_Population <> 'EAS' THEN alt ELSE 0 END) AS ctrl_alt,
         SUM(CASE WHEN s.Super_Population <> 'EAS' THEN ref ELSE 0 END) AS ctrl_ref
  FROM (
    SELECT v.start, v.end, c.call_set_name,
           SUM(CASE WHEN gt = 1 THEN 1 ELSE 0 END) AS alt,
           SUM(CASE WHEN gt = 0 THEN 1 ELSE 0 END) AS ref
    FROM `spider2-public-data.1000_genomes.variants` AS v
    CROSS JOIN UNNEST(v.call)                      AS c
    CROSS JOIN UNNEST(c.genotype)                 AS gt
    WHERE v.reference_name = '12'
      AND ARRAY_LENGTH(v.alternate_bases) = 1
      AND gt IN (0,1)
    GROUP BY v.start, v.end, c.call_set_name
  ) AS g
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.Sample = g.call_set_name
  GROUP BY v.start, v.end
)
SELECT *,
       -- Yates correction
       (POWER(ABS(case_alt - (
           (case_alt + ctrl_alt) * (case_alt + case_ref) / NULLIF(case_alt + case_ref + ctrl_alt + ctrl_ref,0)
         )) - 0.5, 2)
        /
        NULLIF(
           (case_alt + ctrl_alt) * (case_alt + case_ref) / (case_alt + case_ref + ctrl_alt + ctrl_ref)
        ,0)
       )
     + (POWER(ABS(case_ref - (
           (case_ref + ctrl_ref) * (case_alt + case_ref) / NULLIF(case_alt + case_ref + ctrl_alt + ctrl_ref,0)
         )) - 0.5, 2)
        /
        NULLIF(
           (case_ref + ctrl_ref) * (case_alt + case_ref) / (case_alt + case_ref + ctrl_alt + ctrl_ref)
        ,0)
       )
     + (POWER(ABS(ctrl_alt - (
           (case_alt + ctrl_alt) * (ctrl_alt + ctrl_ref) / NULLIF(case_alt + case_ref + ctrl_alt + ctrl_ref,0)
         )) - 0.5, 2)
        /
        NULLIF(
           (case_alt + ctrl_alt) * (ctrl_alt + ctrl_ref) / (case_alt + case_ref + ctrl_alt + ctrl_ref)
        ,0)
       )
     + (POWER(ABS(ctrl_ref - (
           (case_ref + ctrl_ref) * (ctrl_alt + ctrl_ref) / NULLIF(case_alt + case_ref + ctrl_alt + ctrl_ref,0)
         )) - 0.5, 2)
        /
        NULLIF(
           (case_ref + ctrl_ref) * (ctrl_alt + ctrl_ref) / (case_alt + case_ref + ctrl_alt + ctrl_ref)
        ,0)
       ) AS chi_sq_yates
FROM ct
LIMIT 20;
```

```sql
-- 10. Description: FINAL ANSWER – variants on chr 12 whose
--                  Yates‑corrected χ² ≥ 29.71679 and all expected cells ≥ 5.
WITH per_sample AS (
  -- collapse each sample’s diploid genotype into ref/alt allele counts
  SELECT v.start, v.end, c.call_set_name,
         SUM(CASE WHEN gt = 1 THEN 1 ELSE 0 END) AS alt,
         SUM(CASE WHEN gt = 0 THEN 1 ELSE 0 END) AS ref
  FROM `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call)                      AS c
  CROSS JOIN UNNEST(c.genotype)                 AS gt
  WHERE v.reference_name = '12'
    AND ARRAY_LENGTH(v.alternate_bases) = 1
    AND gt IN (0,1)
  GROUP BY v.start, v.end, c.call_set_name
), ct AS (
  -- build 2×2 table
  SELECT p.start, p.end,
         SUM(CASE WHEN s.Super_Population = 'EAS' THEN p.alt  ELSE 0 END) AS case_alt,
         SUM(CASE WHEN s.Super_Population = 'EAS' THEN p.ref  ELSE 0 END) AS case_ref,
         SUM(CASE WHEN s.Super_Population <> 'EAS' THEN p.alt ELSE 0 END) AS ctrl_alt,
         SUM(CASE WHEN s.Super_Population <> 'EAS' THEN p.ref ELSE 0 END) AS ctrl_ref
  FROM per_sample AS p
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.Sample = p.call_set_name
  GROUP BY p.start, p.end
), stats AS (
  -- calculate totals and expected counts
  SELECT *,
         case_alt + ctrl_alt                                   AS total_alt,
         case_ref + ctrl_ref                                   AS total_ref,
         case_alt + case_ref                                   AS total_case,
         ctrl_alt + ctrl_ref                                   AS total_ctrl,
         (case_alt + ctrl_alt + case_ref + ctrl_ref)           AS grand_total
  FROM ct
), expected_ok AS (
  -- filter on expected counts ≥ 5
  SELECT *, 
         (total_alt * total_case)  / grand_total AS exp_case_alt,
         (total_ref * total_case)  / grand_total AS exp_case_ref,
         (total_alt * total_ctrl)  / grand_total AS exp_ctrl_alt,
         (total_ref * total_ctrl)  / grand_total AS exp_ctrl_ref
  FROM stats
  WHERE (total_alt * total_case)  / grand_total >= 5
    AND (total_ref * total_case)  / grand_total >= 5
    AND (total_alt * total_ctrl)  / grand_total >= 5
    AND (total_ref * total_ctrl)  / grand_total >= 5
), chi2 AS (
  -- Yates‑corrected χ²
  SELECT start, end,
         (
           POWER(ABS(case_alt - exp_case_alt)  - 0.5, 2) / exp_case_alt  +
           POWER(ABS(case_ref - exp_case_ref)  - 0.5, 2) / exp_case_ref  +
           POWER(ABS(ctrl_alt - exp_ctrl_alt)  - 0.5, 2) / exp_ctrl_alt  +
           POWER(ABS(ctrl_ref - exp_ctrl_ref)  - 0.5, 2) / exp_ctrl_ref
         ) AS chi_sq
  FROM expected_ok
)
SELECT start, end, chi_sq
FROM chi2
WHERE chi_sq >= 29.71679
ORDER BY chi_sq DESC
LIMIT 20;
```

