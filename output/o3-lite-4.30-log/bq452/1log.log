```sql
--Description: Compute Yates‑corrected χ² statistics for chromosome 12 variants (no expected‑count
--             filter yet) using public tables.
WITH per_sample AS (
  SELECT
    v.start_position AS start,
    v.end_position   AS end,
    c.call_set_name,
    SUM(CASE WHEN gt = 1 THEN 1 ELSE 0 END) AS alt,
    SUM(CASE WHEN gt = 0 THEN 1 ELSE 0 END) AS ref
  FROM `bigquery-public-data.human_genome_variants.1000_genomes_variant_calls` AS v
  CROSS JOIN UNNEST(v.call)  AS c
  CROSS JOIN UNNEST(c.genotype) AS gt
  WHERE v.reference_name = '12'
    AND ARRAY_LENGTH(v.alternate_bases) = 1
    AND gt IN (0,1)
  GROUP BY start, end, c.call_set_name
), ct AS (
  SELECT
    p.start, p.end,
    SUM(CASE WHEN s.super_population = 'EAS' THEN p.alt ELSE 0 END) AS case_alt,
    SUM(CASE WHEN s.super_population = 'EAS' THEN p.ref ELSE 0 END) AS case_ref,
    SUM(CASE WHEN s.super_population <> 'EAS' THEN p.alt ELSE 0 END) AS ctrl_alt,
    SUM(CASE WHEN s.super_population <> 'EAS' THEN p.ref ELSE 0 END) AS ctrl_ref
  FROM per_sample AS p
  JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS s
    ON s.sample = p.call_set_name
  GROUP BY p.start, p.end
)
SELECT
  *,
  -- Yates‑corrected χ²
  (POWER(ABS(case_alt - ((case_alt + ctrl_alt) * (case_alt + case_ref) /
        NULLIF(case_alt + case_ref + ctrl_alt + ctrl_ref, 0))) - 0.5, 2) /
        NULLIF((case_alt + ctrl_alt) * (case_alt + case_ref) /
        (case_alt + case_ref + ctrl_alt + ctrl_ref), 0))
+ (POWER(ABS(case_ref - ((case_ref + ctrl_ref) * (case_alt + case_ref) /
        NULLIF(case_alt + case_ref + ctrl_alt + ctrl_ref, 0))) - 0.5, 2) /
        NULLIF((case_ref + ctrl_ref) * (case_alt + case_ref) /
        (case_alt + case_ref + ctrl_alt + ctrl_ref), 0))
+ (POWER(ABS(ctrl_alt - ((case_alt + ctrl_alt) * (ctrl_alt + ctrl_ref) /
        NULLIF(case_alt + case_ref + ctrl_alt + ctrl_ref, 0))) - 0.5, 2) /
        NULLIF((case_alt + ctrl_alt) * (ctrl_alt + ctrl_ref) /
        (case_alt + case_ref + ctrl_alt + ctrl_ref), 0))
+ (POWER(ABS(ctrl_ref - ((case_ref + ctrl_ref) * (ctrl_alt + ctrl_ref) /
        NULLIF(case_alt + case_ref + ctrl_alt + ctrl_ref, 0))) - 0.5, 2) /
        NULLIF((case_ref + ctrl_ref) * (ctrl_alt + ctrl_ref) /
        (case_alt + case_ref + ctrl_alt + ctrl_ref), 0)) AS chi_sq_yates
FROM ct
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – identify chromosome 12 variants whose Yates‑corrected χ² ≥ 29.71679
--             and whose expected counts in each cell are ≥ 5, using only public 1000 Genomes data.
WITH per_sample AS (
  SELECT
    v.start_position AS start,
    v.end_position   AS end,
    c.call_set_name,
    SUM(CASE WHEN gt = 1 THEN 1 ELSE 0 END) AS alt,
    SUM(CASE WHEN gt = 0 THEN 1 ELSE 0 END) AS ref
  FROM `bigquery-public-data.human_genome_variants.1000_genomes_variant_calls` AS v
  CROSS JOIN UNNEST(v.call)  AS c
  CROSS JOIN UNNEST(c.genotype) AS gt
  WHERE v.reference_name = '12'
    AND ARRAY_LENGTH(v.alternate_bases) = 1
    AND gt IN (0,1)
  GROUP BY start, end, c.call_set_name
), ct AS (
  SELECT
    p.start, p.end,
    SUM(CASE WHEN s.super_population = 'EAS' THEN p.alt ELSE 0 END) AS case_alt,
    SUM(CASE WHEN s.super_population = 'EAS' THEN p.ref ELSE 0 END) AS case_ref,
    SUM(CASE WHEN s.super_population <> 'EAS' THEN p.alt ELSE 0 END) AS ctrl_alt,
    SUM(CASE WHEN s.super_population <> 'EAS' THEN p.ref ELSE 0 END) AS ctrl_ref
  FROM per_sample AS p
  JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS s
    ON s.sample = p.call_set_name
  GROUP BY p.start, p.end
), stats AS (
  SELECT
    *,
    case_alt + ctrl_alt AS total_alt,
    case_ref + ctrl_ref AS total_ref,
    case_alt + case_ref AS total_case,
    ctrl_alt + ctrl_ref AS total_ctrl,
    (case_alt + ctrl_alt + case_ref + ctrl_ref) AS grand_total
  FROM ct
), expected_ok AS (
  SELECT
    *,
    (total_alt * total_case)  / grand_total AS exp_case_alt,
    (total_ref * total_case)  / grand_total AS exp_case_ref,
    (total_alt * total_ctrl) / grand_total AS exp_ctrl_alt,
    (total_ref * total_ctrl) / grand_total AS exp_ctrl_ref
  FROM stats
  WHERE (total_alt * total_case)  / grand_total >= 5
    AND (total_ref * total_case)  / grand_total >= 5
    AND (total_alt * total_ctrl) / grand_total >= 5
    AND (total_ref * total_ctrl) / grand_total >= 5
), chi2 AS (
  SELECT
    start,
    end,
    (
      POWER(ABS(case_alt  - exp_case_alt)  - 0.5, 2) / exp_case_alt  +
      POWER(ABS(case_ref  - exp_case_ref)  - 0.5, 2) / exp_case_ref  +
      POWER(ABS(ctrl_alt  - exp_ctrl_alt)  - 0.5, 2) / exp_ctrl_alt  +
      POWER(ABS(ctrl_ref  - exp_ctrl_ref)  - 0.5, 2) / exp_ctrl_ref
    ) AS chi_sq
  FROM expected_ok
)
SELECT
  start,
  end,
  chi_sq
FROM chi2
WHERE chi_sq >= 29.71679
ORDER BY chi_sq DESC
LIMIT 20;
```
