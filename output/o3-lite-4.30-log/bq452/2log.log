--samples for each chromosome 12 variant, then computes the Yates‑corrected χ²
--statistic and returns the first 20 rows.
WITH per_grp AS (
  SELECT
    v.start AS start,
    v.end   AS end,
    (CASE WHEN s.super_population = 'EAS'
          THEN 'CASE' ELSE 'CONTROL' END) AS grp,
    SUM(CASE WHEN g = 1 THEN 1 ELSE 0 END) AS alt_alleles,
    SUM(CASE WHEN g = 0 THEN 1 ELSE 0 END) AS ref_alleles
  FROM `genomics-public-data.1000_genomes.variants`     AS v
  CROSS JOIN UNNEST(v.call)                            AS c
  JOIN `genomics-public-data.1000_genomes.sample_info` AS s
    ON s.sample = c.call_set_name
  CROSS JOIN UNNEST(c.genotype)                        AS g
  WHERE v.reference_name = '12'
  GROUP BY start, end, grp
),
counts AS (
  SELECT
    start,
    end,
    SUM(IF(grp = 'CASE',    alt_alleles, 0)) AS A,
    SUM(IF(grp = 'CASE',    ref_alleles, 0)) AS B,
    SUM(IF(grp = 'CONTROL', alt_alleles, 0)) AS C,
    SUM(IF(grp = 'CONTROL', ref_alleles, 0)) AS D
  FROM per_grp
  GROUP BY start, end
)
SELECT
  start,
  end,
  A,
  B,
  C,
  D,
  ( (A+B+C+D) * POW(ABS(A*D - B*C) - 0.5*(A+B+C+D), 2)
    / ( (A+B) * (C+D) * (A+C) * (B+D) ) ) AS chi2
FROM counts
LIMIT 20;
```
