```sql
--Description: Final answer – chr12 variants whose Yates χ² ≥ 29.71679 and all expected counts ≥ 5
WITH raw AS (
  SELECT
    v.start,
    v.end,
    CASE WHEN s.super_population = 'EAS' THEN 'CASE' ELSE 'CONTROL' END AS grp,
    SUM(CASE WHEN g = 1 THEN 1 ELSE 0 END) AS alt_alleles,
    SUM(CASE WHEN g = 0 THEN 1 ELSE 0 END) AS ref_alleles
  FROM `bigquery-public-data.human_genome_variants.1000_genomes_variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS s
    ON s.sample = c.call_set_name
  CROSS JOIN UNNEST(c.genotype) AS g
  WHERE v.reference_name = '12'
  GROUP BY v.start, v.end, grp
),
tbl AS (
  SELECT
    start,
    end,
    SUM(IF(grp = 'CASE',    alt_alleles, 0)) AS A,
    SUM(IF(grp = 'CASE',    ref_alleles, 0)) AS B,
    SUM(IF(grp = 'CONTROL', alt_alleles, 0)) AS C,
    SUM(IF(grp = 'CONTROL', ref_alleles, 0)) AS D
  FROM raw
  GROUP BY start, end
),
stats AS (
  SELECT
    start,
    end,
    A,
    B,
    C,
    D,
    (A+B)                 AS case_total,
    (C+D)                 AS ctrl_total,
    (A+C)                 AS alt_total,
    (B+D)                 AS ref_total,
    (A+B+C+D)             AS N
  FROM tbl
),
filtered AS (
  SELECT
    start,
    end,
    A,
    B,
    C,
    D,
    N,
    (alt_total * case_total)  / N AS exp_A,
    (alt_total * ctrl_total)  / N AS exp_C,
    (ref_total * case_total)  / N AS exp_B,
    (ref_total * ctrl_total)  / N AS exp_D
  FROM stats
  WHERE N > 0
)
SELECT
  start,
  end,
  ( N * POW(ABS(A*D - B*C) - 0.5*N, 2) /
    ((A+B)*(C+D)*(A+C)*(B+D)) ) AS chi_squared
FROM filtered
WHERE
  exp_A >= 5
  AND exp_B >= 5
  AND exp_C >= 5
  AND exp_D >= 5
  AND ( N * POW(ABS(A*D - B*C) - 0.5*N, 2) /
        ((A+B)*(C+D)*(A+C)*(B+D)) ) >= 29.71679
ORDER BY chi_squared DESC;
```
