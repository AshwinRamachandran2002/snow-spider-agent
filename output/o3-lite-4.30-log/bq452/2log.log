Begin Exploring Related Columns
Relevant columns and how they will be used  

• `variants.reference_name` – filter to chromosome 12 (`'12'`).  
• `variants.start`, `variants.end` – genomic coordinates to be returned.  
• `variants.call` (ARRAY of STRUCT)  
   – `call.call_set_name` → sample ID.  
   – `call.genotype` → two integers (0 = reference, 1 = alternate, –1 = missing) that let us count reference / alternate alleles.  
• `sample_info.Sample` – sample ID to join with `call.call_set_name`.  
• `sample_info.Super_Population` – used to split samples into CASES (`'EAS'`) and CONTROLS (all others).  

Conditions that will be used  

1. `variants.reference_name = '12'` (chromosome 12 only)  
2. `sample_info.Super_Population = 'EAS'` ⇒ cases, otherwise ⇒ controls  
3. Yates χ² continuity–corrected value ≥ 29.71679  
4. The 4 expected cell counts of the 2×2 table (`alt/ref × case/control`) ≥ 5  

Ten exploratory → analytical queries
(Every query is limited to 20 rows except the last one.)

```sql
-- 1. Description: Chromosomes represented in the variants table
SELECT DISTINCT reference_name
FROM `spider2-public-data.1000_genomes.variants`
LIMIT 20;
```

```sql
-- 2. Description: Super‑populations available in the sample information
SELECT DISTINCT Super_Population
FROM `spider2-public-data.1000_genomes.sample_info`
LIMIT 20;
```

```sql
-- 3. Description: How many samples fall into each super‑population group
SELECT Super_Population, COUNT(*) AS n_samples
FROM `spider2-public-data.1000_genomes.sample_info`
GROUP BY Super_Population
LIMIT 20;
```

```sql
-- 4. Description: List 20 sample IDs that belong to the EAS super‑population (our cases)
SELECT Sample
FROM `spider2-public-data.1000_genomes.sample_info`
WHERE Super_Population = 'EAS'
LIMIT 20;
```

```sql
-- 5. Description: Take one variant on chr12 and explode its calls to view genotypes
SELECT v.start, v.end, c.call_set_name, c.genotype
FROM `spider2-public-data.1000_genomes.variants` AS v
CROSS JOIN UNNEST(v.call) AS c
WHERE v.reference_name = '12'
LIMIT 20;
```

```sql
-- 6. Description: For a single variant show per‑sample allele counts (alt & ref)
SELECT
  v.start, v.end,
  c.call_set_name,
  SUM(CASE WHEN a = 1 THEN 1 ELSE 0 END) AS alt_alleles,
  SUM(CASE WHEN a = 0 THEN 1 ELSE 0 END) AS ref_alleles
FROM `spider2-public-data.1000_genomes.variants` AS v
CROSS JOIN UNNEST(v.call) AS c
CROSS JOIN UNNEST(c.genotype) AS a
WHERE v.reference_name = '12'
GROUP BY v.start, v.end, c.call_set_name
LIMIT 20;
```

```sql
-- 7. Description: Join sample_info so we know whether each sample is CASE (EAS) or CONTROL
SELECT
  v.start, v.end,
  s.Super_Population,
  SUM(CASE WHEN a = 1 THEN 1 ELSE 0 END) AS alt_alleles,
  SUM(CASE WHEN a = 0 THEN 1 ELSE 0 END) AS ref_alleles
FROM `spider2-public-data.1000_genomes.variants` AS v
CROSS JOIN UNNEST(v.call) AS c
JOIN `spider2-public-data.1000_genomes.sample_info` AS s
  ON s.Sample = c.call_set_name
CROSS JOIN UNNEST(c.genotype) AS a
WHERE v.reference_name = '12'
GROUP BY v.start, v.end, s.Super_Population
LIMIT 20;
```

```sql
-- 8. Description: Build the 2×2 table (alt/ref × case/control) for each variant
WITH allele_counts AS (
  SELECT
    v.start, v.end,
    CASE WHEN s.Super_Population = 'EAS' THEN 'CASE' ELSE 'CONTROL' END AS group_type,
    SUM(CASE WHEN a = 1 THEN 1 ELSE 0 END) AS alt_alleles,
    SUM(CASE WHEN a = 0 THEN 1 ELSE 0 END) AS ref_alleles
  FROM `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.Sample = c.call_set_name
  CROSS JOIN UNNEST(c.genotype) AS a
  WHERE v.reference_name = '12'
  GROUP BY v.start, v.end, group_type
)
SELECT *
FROM allele_counts
LIMIT 20;
```

```sql
-- 9. Description: Calculate Yates χ² for variants on chr12; keep first 20 rows
WITH counts AS (
  SELECT
    start, end,
    SUM(CASE WHEN group_type = 'CASE'    THEN alt_alleles ELSE 0 END) AS A,
    SUM(CASE WHEN group_type = 'CASE'    THEN ref_alleles ELSE 0 END) AS B,
    SUM(CASE WHEN group_type = 'CONTROL' THEN alt_alleles ELSE 0 END) AS C,
    SUM(CASE WHEN group_type = 'CONTROL' THEN ref_alleles ELSE 0 END) AS D
  FROM (
    SELECT
      v.start, v.end,
      CASE WHEN s.Super_Population = 'EAS' THEN 'CASE' ELSE 'CONTROL' END AS group_type,
      SUM(CASE WHEN a = 1 THEN 1 ELSE 0 END) AS alt_alleles,
      SUM(CASE WHEN a = 0 THEN 1 ELSE 0 END) AS ref_alleles
    FROM `spider2-public-data.1000_genomes.variants` AS v
    CROSS JOIN UNNEST(v.call) AS c
    JOIN `spider2-public-data.1000_genomes.sample_info` AS s
      ON s.Sample = c.call_set_name
    CROSS JOIN UNNEST(c.genotype) AS a
    WHERE v.reference_name = '12'
    GROUP BY v.start, v.end, group_type
  )
  GROUP BY start, end
)
SELECT
  start, end,
  A, B, C, D,
  -- continuity‑corrected Yates χ²
  ( (A+B+C+D) * POW( ABS(A*D - B*C) - 0.5*(A+B+C+D), 2 )
    / ( (A+B)*(C+D)*(A+C)*(B+D) )
  ) AS chi2
FROM counts
LIMIT 20;
```

```sql
-- 10. Description: Final answer – chr12 variants whose Yates χ² ≥ 29.71679 and
--                  all four expected counts ≥ 5; ordered by χ² descending
WITH raw AS (
  SELECT
    v.start, v.end,
    CASE WHEN s.Super_Population = 'EAS' THEN 'CASE' ELSE 'CONTROL' END AS grp,
    SUM(CASE WHEN a = 1 THEN 1 ELSE 0 END) AS alt_alleles,
    SUM(CASE WHEN a = 0 THEN 1 ELSE 0 END) AS ref_alleles
  FROM `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  JOIN `spider2-public-data.1000_genomes.sample_info`  AS s
    ON s.Sample = c.call_set_name
  CROSS JOIN UNNEST(c.genotype) AS a
  WHERE v.reference_name = '12'
  GROUP BY v.start, v.end, grp
),
tbl AS (
  SELECT
    start, end,
    SUM(IF(grp = 'CASE',    alt_alleles, 0)) AS A,
    SUM(IF(grp = 'CASE',    ref_alleles, 0)) AS B,
    SUM(IF(grp = 'CONTROL', alt_alleles, 0)) AS C,
    SUM(IF(grp = 'CONTROL', ref_alleles, 0)) AS D
  FROM raw
  GROUP BY start, end
),
stats AS (
  SELECT
    start, end,
    A, B, C, D,
    (A+B)     AS case_total,
    (C+D)     AS ctrl_total,
    (A+C)     AS alt_total,
    (B+D)     AS ref_total,
    (A+B+C+D) AS N
  FROM tbl
),
filtered AS (
  SELECT
    start, end,
    A, B, C, D, N,
    -- expected counts
    (alt_total * case_total)  / N AS exp_A,
    (alt_total * ctrl_total)  / N AS exp_C,
    (ref_total * case_total)  / N AS exp_B,
    (ref_total * ctrl_total)  / N AS exp_D
  FROM stats
  WHERE N > 0
)
SELECT
  start,
  end,
  -- Yates continuity‑corrected Chi‑square
  ( N * POW(ABS(A*D - B*C) - 0.5*N, 2) / ((A+B)*(C+D)*(A+C)*(B+D)) ) AS chi_squared
FROM filtered
WHERE
  -- ensure each expected cell ≥ 5
  exp_A >= 5 AND exp_B >= 5 AND exp_C >= 5 AND exp_D >= 5
  AND ( N * POW(ABS(A*D - B*C) - 0.5*N, 2) / ((A+B)*(C+D)*(A+C)*(B+D)) ) >= 29.71679
ORDER BY chi_squared DESC;
```

The last query returns the `start`, `end`, and χ² score for every chromosome 12 variant whose chi‑squared statistic (with Yates continuity correction) is at least 29.71679 and whose expected allele counts satisfy the minimum‑of‑five rule.
