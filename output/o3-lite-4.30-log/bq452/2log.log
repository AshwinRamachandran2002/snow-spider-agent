WITH allele_counts AS (
  SELECT
    v.start,
    v.end,
    CASE WHEN s.super_population = 'EAS' THEN 'CASE' ELSE 'CONTROL' END AS group_type,
    SUM(CASE WHEN g = 1 THEN 1 ELSE 0 END) AS alt_alleles,
    SUM(CASE WHEN g = 0 THEN 1 ELSE 0 END) AS ref_alleles
  FROM `genomics-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  JOIN `genomics-public-data.1000_genomes.sample_info` AS s
    ON s.sample = c.call_set_name
  CROSS JOIN UNNEST(c.genotype) AS g
  WHERE v.reference_name = '12'
  GROUP BY v.start, v.end, group_type
)
SELECT *
FROM allele_counts
