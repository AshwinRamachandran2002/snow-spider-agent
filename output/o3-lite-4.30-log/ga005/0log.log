```sql
--Description: 9. Compute Week‑2 retention for every Monday cohort between 9‑Jul and 17‑Sep
WITH base AS (
  SELECT
    user_pseudo_id,
    PARSE_DATE('%Y%m%d', event_date) AS event_dt,
    DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)) AS first_touch_dt,
    event_name
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
),
cohort_users AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(event_dt, WEEK(MONDAY)) AS cohort_week_start
  FROM base
  WHERE event_dt = first_touch_dt
),
week2_activity AS (
  SELECT
    cu.user_pseudo_id,
    cu.cohort_week_start
  FROM cohort_users cu
  JOIN base b
    ON b.user_pseudo_id = cu.user_pseudo_id
   AND b.event_dt BETWEEN cu.cohort_week_start + INTERVAL 14 DAY
                      AND cu.cohort_week_start + INTERVAL 20 DAY
)
SELECT
  cohort_week_start,
  COUNT(DISTINCT week2_activity.user_pseudo_id) AS week2_users,
  COUNT(DISTINCT cohort_users.user_pseudo_id)  AS cohort_users
FROM cohort_users
LEFT JOIN week2_activity
  ON cohort_users.user_pseudo_id = week2_activity.user_pseudo_id
GROUP BY cohort_week_start
HAVING cohort_week_start BETWEEN '2018-07-09' AND '2018-09-17'
ORDER BY cohort_week_start
LIMIT 20;
```

```sql
--Description: 10. Final query – Week‑2 retention rate for each weekly cohort, ordered chronologically
WITH base AS (
  SELECT
    user_pseudo_id,
    PARSE_DATE('%Y%m%d', event_date) AS event_dt,
    DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)) AS first_touch_dt,
    event_name
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
),
cohort AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(event_dt, WEEK(MONDAY)) AS cohort_week_start
  FROM base
  WHERE event_dt = first_touch_dt
),
activity AS (
  SELECT
    user_pseudo_id,
    event_dt
  FROM base
),
week2 AS (
  SELECT
    c.cohort_week_start,
    COUNT(DISTINCT c.user_pseudo_id) AS cohort_users,
    COUNT(DISTINCT CASE
                     WHEN a.event_dt BETWEEN c.cohort_week_start + INTERVAL 14 DAY
                                      AND c.cohort_week_start + INTERVAL 20 DAY
                     THEN c.user_pseudo_id
                   END) AS week2_users
  FROM cohort c
  LEFT JOIN activity a
    ON a.user_pseudo_id = c.user_pseudo_id
  GROUP BY c.cohort_week_start
)
SELECT
  cohort_week_start,
  SAFE_DIVIDE(week2_users, cohort_users) AS week2_retention_rate
FROM week2
WHERE cohort_week_start BETWEEN '2018-07-09' AND '2018-09-17'
ORDER BY cohort_week_start
LIMIT 20;
```

Each successive query builds familiarity with the necessary columns and logic, culminating in the full weekly cohort analysis and the Week‑2 retention rate for every cohort whose Monday falls between 09‑Jul‑2018 and 17‑Sep‑2018.
