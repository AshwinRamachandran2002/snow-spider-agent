--Description: Final query – Week‑2 retention rate for each Monday cohort (09‑Jul‑2018‑‑17‑Sep‑2018)  
--Fixes ambiguity by fully qualifying every cohort_week_start reference with its table / CTE alias.
WITH base AS (                                   -- all session_start rows that can contribute
  SELECT
    user_pseudo_id,
    PARSE_DATE('%Y%m%d', event_date)                       AS event_dt,
    DATE(TIMESTAMP_MICROS(user_first_touch_timestamp))     AS first_touch_dt
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
),
cohort AS (                                      -- new users + their cohort Monday
  SELECT
    user_pseudo_id,
    DATE_TRUNC(event_dt, WEEK(MONDAY))           AS cohort_week_start
  FROM base
  WHERE event_dt = first_touch_dt
),
activity AS (                                    -- every session_start event we saw
  SELECT
    user_pseudo_id,
    event_dt
  FROM base
),
week2 AS (                                       -- aggregate at cohort level
  SELECT
    c.cohort_week_start                                       AS cohort_week_start,
    COUNT(DISTINCT c.user_pseudo_id)                          AS cohort_users,
    COUNT(DISTINCT CASE
                     WHEN a.event_dt BETWEEN c.cohort_week_start + INTERVAL 14 DAY
                                          AND     c.cohort_week_start + INTERVAL 20 DAY
                     THEN c.user_pseudo_id
                   END)                                       AS week2_users
  FROM cohort  AS c
  LEFT JOIN activity AS a
    ON a.user_pseudo_id = c.user_pseudo_id
  GROUP BY c.cohort_week_start
)
SELECT
  w2.cohort_week_start,
  SAFE_DIVIDE(w2.week2_users, w2.cohort_users) AS week2_retention_rate
FROM week2 AS w2
WHERE w2.cohort_week_start BETWEEN DATE '2018-07-09' AND DATE '2018-09-17'
ORDER BY w2.cohort_week_start
LIMIT 20
