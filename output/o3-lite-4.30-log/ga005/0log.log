```sql
--Description: 8. How many of the 9‑Jul cohort returned any day in week 23‑Jul‑2018 to 29‑Jul‑2018 (Week 2)
WITH cohort AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180715'
    AND event_name = 'session_start'
    AND event_date = FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)))
), week2 AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180723' AND '20180729'
    AND event_name = 'session_start'
