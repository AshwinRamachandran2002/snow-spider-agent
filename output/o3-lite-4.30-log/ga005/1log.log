```sql
--Description: 6) Count of NEW users per cohort week (raw numbers only)
SELECT
  DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS cohort_week,
  COUNT(DISTINCT user_pseudo_id)                           AS cohort_users
