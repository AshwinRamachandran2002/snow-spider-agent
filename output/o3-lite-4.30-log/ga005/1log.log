```sql
--Description: 8) Compute Week‑2 retention for the single 9 Jul 2018 cohort
WITH cohort AS (
  SELECT DISTINCT user_pseudo_id
  FROM  `firebase-public-project.analytics_153293282.events_20180709`
  WHERE event_name = 'session_start'
    AND event_date = FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)))
),
week2_returners AS (
  SELECT DISTINCT e.user_pseudo_id
  FROM  cohort  c
  JOIN  `firebase-public-project.analytics_153293282.events_*` e
        ON e.user_pseudo_id = c.user_pseudo_id
  WHERE e.event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180723' AND '20180729'
)
SELECT
  COUNT(*) AS week2_users ,
  (SELECT COUNT(*) FROM cohort) AS cohort_users ,
  COUNT(*) / (SELECT COUNT(*) FROM cohort) AS week2_retention_rate
LIMIT 20;
```

```sql
--Description: 9) Retention counts for every cohort (without the rate yet)
WITH base AS (
  SELECT
    user_pseudo_id ,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS cohort_week
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
    AND event_date = FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)))
),
cohort_users AS (
  SELECT cohort_week, COUNT(DISTINCT user_pseudo_id) AS cohort_users
  FROM  base
  GROUP BY cohort_week
),
week2_events AS (
  SELECT
    b.cohort_week ,
    e.user_pseudo_id
  FROM  base  b
  JOIN  `firebase-public-project.analytics_153293282.events_*` e
        ON e.user_pseudo_id = b.user_pseudo_id
  WHERE _TABLE_SUFFIX BETWEEN '20180723' AND '20181002'     -- full Week‑2 windows
    AND e.event_name = 'session_start'
    -- ensure the event sits 14‑20 days after its cohort_week
    AND DATE_DIFF(PARSE_DATE('%Y%m%d', e.event_date), b.cohort_week, DAY) BETWEEN 14 AND 20
)
SELECT
  cw.cohort_week ,
  COUNT(DISTINCT w2.user_pseudo_id) AS week2_users ,
  cw.cohort_users
FROM cohort_users cw
LEFT JOIN week2_events w2
       ON w2.cohort_week = cw.cohort_week
GROUP BY cw.cohort_week, cw.cohort_users
ORDER BY cw.cohort_week
LIMIT 20;
```

```sql
--Description: 10) FINAL ANSWER – Week‑2 retention for cohorts 9 Jul 2018 → 17 Sep 2018
WITH new_users AS (        -- users whose first touch happens in our window
  SELECT
    user_pseudo_id ,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS cohort_week
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
    AND event_date = FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)))
    AND PARSE_DATE('%Y%m%d', event_date) BETWEEN DATE '2018-07-09' AND DATE '2018-09-17'
),
cohort_sizes AS (
  SELECT cohort_week , COUNT(DISTINCT user_pseudo_id) AS cohort_users
  FROM   new_users
  GROUP BY cohort_week
),
week2_returners AS (
  SELECT
    n.cohort_week ,
    n.user_pseudo_id
  FROM   new_users  n
  JOIN   `firebase-public-project.analytics_153293282.events_*` e
         ON e.user_pseudo_id = n.user_pseudo_id
  WHERE  _TABLE_SUFFIX BETWEEN '20180723' AND '20181002'
    AND  e.event_name = 'session_start'
    AND  DATE_DIFF(PARSE_DATE('%Y%m%d', e.event_date), n.cohort_week, DAY) BETWEEN 14 AND 20
),
retention AS (
  SELECT
    c.cohort_week ,
    COUNT(DISTINCT w.user_pseudo_id) AS week2_users ,
    c.cohort_users
  FROM   cohort_sizes c
  LEFT JOIN week2_returners w
         ON w.cohort_week = c.cohort_week
  GROUP BY c.cohort_week , c.cohort_users
)
SELECT
  cohort_week ,
  ROUND(100.0 * week2_users / cohort_users, 2) AS week2_retention_percent
FROM   retention
ORDER BY cohort_week;
```

Each query is limited to 20 rows except the final answer query, which purposely returns the full set of weekly cohorts (2018‑07‑09, 2018‑07‑16, … , 2018‑09‑17) and their Week‑2 retention rates.
