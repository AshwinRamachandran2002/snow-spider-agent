--Description: Week‑2 retention for the Monday 2018‑07‑09 cohort.
--Thinking process (inline):
--  • cohort: pick distinct users whose very first session_start is on 2018‑07‑09
--  • week2_returners: among those users, find a session_start exactly 14‑20 days later (2018‑07‑23 → 2018‑07‑29)
--  • counts: compute cohort size and number of week‑2 users
--  • final SELECT: output counts and retention rate
WITH cohort AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_20180709`
  WHERE event_name = 'session_start'
    AND event_date = FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)))
),
week2_returners AS (
  SELECT DISTINCT e.user_pseudo_id
  FROM cohort c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = c.user_pseudo_id
  WHERE _TABLE_SUFFIX BETWEEN '20180723' AND '20180729'
    AND e.event_name = 'session_start'
),
counts AS (
  SELECT
    COUNT(*) AS cohort_users,
    (SELECT COUNT(*) FROM week2_returners) AS week2_users
  FROM cohort
)
SELECT
  cohort_users,
  week2_users,
  SAFE_DIVIDE(week2_users, cohort_users) AS week2_retention_rate
FROM counts;
