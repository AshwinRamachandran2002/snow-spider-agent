```sql
-- 6. Size of each weekly cohort (Mon‑Sun) we care about
WITH new_users AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS cohort_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180923'  -- include last cohort’s first week
    AND event_name = 'session_start'
    AND event_date = FORMAT_TIMESTAMP('%Y%m%d', TIMESTAMP_MICROS(user_first_touch_timestamp))
)
SELECT cohort_week,
       COUNT(DISTINCT user_pseudo_id) AS cohort_size
FROM new_users
GROUP BY cohort_week
ORDER BY cohort_week
LIMIT 20;
```

```sql
-- 7. Users from the 9 Jul 2018 cohort who fired session_start in the week that begins 23 Jul 2018 (two weeks later)
WITH cohort AS (
  SELECT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX = '20180709'
    AND event_name = 'session_start'
    AND event_date = FORMAT_TIMESTAMP('%Y%m%d', TIMESTAMP_MICROS(user_first_touch_timestamp))
),
week2_activity AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180723' AND '20180729'
    AND event_name = 'session_start'
)
SELECT ca.user_pseudo_id
FROM cohort ca
JOIN week2_activity wa
ON ca.user_pseudo_id = wa.user_pseudo_id
LIMIT 20;
```

```sql
-- 8. Compute Week‑2 retention for the single cohort that started 9 Jul 2018
WITH cohort AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX = '20180709'
    AND event_name = 'session_start'
    AND event_date = FORMAT_TIMESTAMP('%Y%m%d', TIMESTAMP_MICROS(user_first_touch_timestamp))
),
week2 AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180723' AND '20180729'
    AND event_name = 'session_start'
)
SELECT
  DATE '2018-07-09' AS cohort_week_start,
  COUNT(DISTINCT week2.user_pseudo_id) / COUNT(DISTINCT cohort.user_pseudo_id) AS week2_retention_rate
FROM cohort
LEFT JOIN week2 USING (user_pseudo_id)
LIMIT 20;
```

```sql
-- 9. Week‑2 retention for every cohort between 09 Jul and 13 Aug (first 6 cohorts)
WITH base AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS activity_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180902'
    AND event_name = 'session_start'
),
new_users AS (
  SELECT user_pseudo_id,
         activity_week AS cohort_week
  FROM base
  WHERE activity_week BETWEEN DATE '2018-07-09' AND DATE '2018-08-13'
    AND _TABLE_SUFFIX = FORMAT_DATE('%Y%m%d', activity_week)  -- new user definition
)
SELECT
  cohort_week,
  COUNT(DISTINCT CASE WHEN activity_week = cohort_week + INTERVAL 2 WEEK THEN user_pseudo_id END)
    / COUNT(DISTINCT user_pseudo_id) AS week2_retention
FROM new_users nu
JOIN base b
USING (user_pseudo_id)
GROUP BY cohort_week
ORDER BY cohort_week
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: Week‑2 retention for cohorts 9 Jul 2018 – 17 Sep 2018
WITH sessions AS (
  SELECT
    user_pseudo_id,
    event_date,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY))             AS activity_week,
    DATE_TRUNC(PARSE_DATE('%Y%m%d',
             FORMAT_TIMESTAMP('%Y%m%d', TIMESTAMP_MICROS(user_first_touch_timestamp))
           ), WEEK(MONDAY))                                                AS first_touch_week,
    FORMAT_TIMESTAMP('%Y%m%d', TIMESTAMP_MICROS(user_first_touch_timestamp)) AS first_touch_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
),
cohorts AS (        -- users whose very first touch happens inside the week we analyse
  SELECT DISTINCT
         user_pseudo_id,
         first_touch_week AS cohort_week
  FROM sessions
  WHERE event_date = first_touch_date
    AND cohort_week BETWEEN DATE '2018-07-09' AND DATE '2018-09-17'
),
week2_activity AS (
  SELECT DISTINCT
         user_pseudo_id,
         activity_week
  FROM sessions
)
SELECT
  cohort_week,
  ROUND( 100 * COUNT(DISTINCT CASE
            WHEN activity_week = cohort_week + INTERVAL 2 WEEK
            THEN wa.user_pseudo_id END)
        / COUNT(DISTINCT c.user_pseudo_id), 2) AS week2_retention_percent
FROM cohorts        AS c
LEFT JOIN week2_activity AS wa
USING (user_pseudo_id)
GROUP BY cohort_week
ORDER BY cohort_week
LIMIT 20;
```
The last query returns one row per Monday‑based weekly cohort (09 Jul 2018 … 17 Sep 2018) along with the percentage of those new users who came back during the exact week two weeks later.
