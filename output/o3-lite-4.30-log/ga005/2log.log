--Description: FINAL answer ‑‑ Week‑2 retention for Monday‑based cohorts (09‑Jul‑2018 → 17‑Sep‑2018).  
--Fixes applied to the earlier draft:  
--  • Cannot reference an alias (cohort_week) in the same SELECT’s WHERE clause, so we use first_touch_week there.  
--  • Kept _TABLE_SUFFIX filter for efficient partition pruning.  
--  • Removed unnecessary LIMIT 20 for the final metric table.  

WITH sessions AS (       -- every session_start within analysis window
  SELECT
    user_pseudo_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS activity_week,
    FORMAT_TIMESTAMP('%Y%m%d', TIMESTAMP_MICROS(user_first_touch_timestamp))   AS first_touch_date,
    DATE_TRUNC(                                               
      PARSE_DATE('%Y%m%d',
        FORMAT_TIMESTAMP('%Y%m%d', TIMESTAMP_MICROS(user_first_touch_timestamp))
      ), WEEK(MONDAY))                                           AS first_touch_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
),
cohorts AS (             -- users whose very first touch falls in one of the target weeks
  SELECT DISTINCT
         user_pseudo_id,
         first_touch_week AS cohort_week
  FROM sessions
  WHERE event_date = first_touch_date
    AND first_touch_week BETWEEN DATE '2018-07-09' AND DATE '2018-09-17'
),
week2_activity AS (      -- any session_start activity for those users
  SELECT DISTINCT
         user_pseudo_id,
         activity_week
  FROM sessions
)
SELECT
  cohort_week,
  ROUND(
        100 * COUNT(DISTINCT CASE
                WHEN activity_week = cohort_week + INTERVAL 2 WEEK
                THEN user_pseudo_id END)
        / COUNT(DISTINCT c.user_pseudo_id), 2) AS week2_retention_percent
FROM cohorts c
LEFT JOIN week2_activity w
USING (user_pseudo_id)
GROUP BY cohort_week
ORDER BY cohort_week;
