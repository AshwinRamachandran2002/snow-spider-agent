SELECT event_date,
       COUNT(DISTINCT user_pseudo_id) AS new_users
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180715'
  AND event_name = 'session_start'
  AND event_date = FORMAT_TIMESTAMP('%Y%m%d', TIMESTAMP_MICROS(user_first_touch_timestamp))
GROUP BY event_date
ORDER BY event_date
LIMIT 20;
