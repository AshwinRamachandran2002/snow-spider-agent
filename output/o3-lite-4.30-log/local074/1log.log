           OVER (PARTITION BY cal."customer_id"
                 ORDER BY cal."month_year")                                  AS "closing_balance"
FROM   calendar AS cal
LEFT   JOIN monthly_values AS mv
       ON  cal."customer_id" = mv."customer_id"
       AND cal."month_year"  = mv."month_year"
ORDER  BY cal."customer_id", cal."month_year"
LIMIT 20;
