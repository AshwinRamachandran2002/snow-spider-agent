WITH all_months AS (
     SELECT DISTINCT strftime('%Y-%m', "txn_date") AS "month_year"
     FROM   "customer_transactions"
), all_customers AS (
     SELECT DISTINCT "customer_id"
     FROM   "customer_transactions"
)
SELECT c."customer_id",
       m."month_year"
FROM   all_customers  AS c
CROSS  JOIN all_months AS m
ORDER  BY c."customer_id", m."month_year"
LIMIT 20;
