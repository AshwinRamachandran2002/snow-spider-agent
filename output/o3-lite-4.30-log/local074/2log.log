Begin Exploring Related Columns
Relevant tables and columns for monthly balance reporting

customer_transactions  
• customer_id: identifies each customer – used for grouping and joining  
• txn_date: the calendar date of the movement – used for generating year‑month buckets and for ordering transactions chronologically  
• txn_type: tells us whether the movement adds to, or subtracts from, the balance (e.g. deposit = +, withdrawal = –). We must inspect values to confirm sign logic  
• txn_amount: size of the movement – will be signed (+/–) and aggregated to monthly change figures  

Possible filtering / transformation conditions  
• strftime('%Y‑%m', txn_date) AS month_year  → collapses any date to its calendar month  
• CASE txn_type WHEN 'deposit' THEN +txn_amount WHEN 'withdrawal' THEN -txn_amount END AS signed_amount  
• Recursive calendar CTE between min(txn_date) and max(txn_date) → produces “all months” so that customers with no activity still appear with prior balance carried forward  

Exploratory SQL queries  
The following 10 queries (LIMIT 20) move from simple inspection to a full closing‑balance prototype.  
```sql
-- 1) List the different transaction types that exist
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 2) Quick look at raw data for one random customer (id = 155)
SELECT *
FROM "customer_transactions"
WHERE "customer_id" = 155
ORDER BY "txn_date"
LIMIT 20;
```

```sql
-- 3) First 20 rows ordered chronologically – helps check date format
SELECT *
FROM "customer_transactions"
ORDER BY "txn_date", "customer_id"
LIMIT 20;
```

```sql
-- 4) Distinct calendar months present in the data set
SELECT DISTINCT strftime('%Y-%m', "txn_date") AS "month_year"
FROM "customer_transactions"
ORDER BY "month_year"
LIMIT 20;
```

```sql
-- 5) Monthly net change (deposit positive, withdrawal negative) for each customer
SELECT
  "customer_id",
  strftime('%Y-%m', "txn_date") AS "month_year",
  SUM(
      CASE
        WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
        WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
        ELSE 0
      END
  ) AS "monthly_change"
FROM "customer_transactions"
GROUP BY "customer_id", "month_year"
ORDER BY "customer_id", "month_year"
LIMIT 20;
```

```sql
-- 6) Distinct customer list (needed for the later all‑months cross join)
SELECT DISTINCT "customer_id"
FROM "customer_transactions"
ORDER BY "customer_id"
LIMIT 20;
```

```sql
-- 7) Create a complete calendar of months that exist between min and max txn_date
WITH RECURSIVE months(m) AS (
  SELECT date((SELECT MIN("txn_date") FROM "customer_transactions"), 'start of month')
  UNION ALL
  SELECT date(m, '+1 month')
  FROM months
  WHERE m < date((SELECT MAX("txn_date") FROM "customer_transactions"), 'start of month')
)
SELECT strftime('%Y-%m', m) AS "month_year"
FROM months
ORDER BY "month_year"
LIMIT 20;
```

```sql
-- 8) Produce every (customer, month) combination so that inactive months are present
WITH RECURSIVE months(m) AS (
  SELECT date((SELECT MIN("txn_date") FROM "customer_transactions"), 'start of month')
  UNION ALL
  SELECT date(m, '+1 month')
  FROM months
  WHERE m < date((SELECT MAX("txn_date") FROM "customer_transactions"), 'start of month')
)
SELECT c."customer_id", strftime('%Y-%m', m) AS "month_year"
FROM (SELECT DISTINCT "customer_id" FROM "customer_transactions") AS c
CROSS JOIN months
ORDER BY c."customer_id", "month_year"
LIMIT 20;
```

```sql
-- 9) Join monthly change onto the full (customer, month) grid
WITH
  all_months AS (
    WITH RECURSIVE m(mth) AS (
      SELECT date((SELECT MIN("txn_date") FROM "customer_transactions"), 'start of month')
      UNION ALL
      SELECT date(mth, '+1 month') FROM m
      WHERE mth < date((SELECT MAX("txn_date") FROM "customer_transactions"), 'start of month')
    )
    SELECT strftime('%Y-%m', mth) AS month_year FROM m
  ),
  customers AS (
    SELECT DISTINCT "customer_id" FROM "customer_transactions"
  ),
  monthly_change AS (
    SELECT
      "customer_id",
      strftime('%Y-%m', "txn_date") AS month_year,
      SUM(
        CASE WHEN "txn_type"='deposit' THEN  "txn_amount"
             WHEN "txn_type"='withdrawal' THEN - "txn_amount"
             ELSE 0 END
      ) AS change_amt
    FROM "customer_transactions"
    GROUP BY "customer_id", "month_year"
  )
SELECT
  g."customer_id",
  g."month_year",
  COALESCE(mc.change_amt, 0) AS "monthly_change"
FROM customers c
CROSS JOIN all_months g
LEFT JOIN monthly_change mc
      ON mc."customer_id" = c."customer_id"
     AND mc."month_year"  = g."month_year"
ORDER BY g."customer_id", g."month_year"
LIMIT 20;
```

```sql
-- 10) Closing balance per month using a running sum window over the monthly change
WITH
  all_months AS (
    WITH RECURSIVE m(mth) AS (
      SELECT date((SELECT MIN("txn_date") FROM "customer_transactions"), 'start of month')
      UNION ALL
      SELECT date(mth, '+1 month') FROM m
      WHERE mth < date((SELECT MAX("txn_date") FROM "customer_transactions"), 'start of month')
    )
    SELECT strftime('%Y-%m', mth) AS month_year FROM m
  ),
  customers AS (
    SELECT DISTINCT "customer_id" FROM "customer_transactions"
  ),
  monthly_change AS (
    SELECT
      "customer_id",
      strftime('%Y-%m', "txn_date") AS month_year,
      SUM(
        CASE WHEN "txn_type"='deposit' THEN  "txn_amount"
             WHEN "txn_type"='withdrawal' THEN - "txn_amount"
             ELSE 0 END
      ) AS change_amt
    FROM "customer_transactions"
    GROUP BY "customer_id", "month_year"
  ),
  grid AS (
    SELECT
      c."customer_id",
      m."month_year"
    FROM customers c
    CROSS JOIN all_months m
  ),
  merged AS (
    SELECT
      g."customer_id",
      g."month_year",
      COALESCE(mc.change_amt, 0) AS monthly_change
    FROM grid g
    LEFT JOIN monthly_change mc
      ON mc."customer_id" = g."customer_id"
     AND mc."month_year"  = g."month_year"
  )
SELECT
  "customer_id",
  "month_year",
  "monthly_change",
  SUM("monthly_change") OVER (
      PARTITION BY "customer_id"
      ORDER BY "month_year"
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
  ) AS "closing_balance"
FROM merged
ORDER BY "customer_id", "month_year"
LIMIT 20;
```

