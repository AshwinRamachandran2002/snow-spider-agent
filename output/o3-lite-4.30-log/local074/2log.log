--    transaction month and finishes at the last; this guarantees every month
--    in the range appears.
-- 3. Calculate the signed monthly movement per customer:
--       • deposit     → +amount
--       • withdrawal  → –amount
--       • purchase    → 0 (ignored for balance purposes)
-- 4. CROSS JOIN customers × month_dim to create a complete grid of every
--    (customer, month) combination.
-- 5. LEFT JOIN the monthly movement onto the grid and COALESCE missing rows
--    to 0 so inactive months appear with zero change.
-- 6. Use a window SUM to accumulate the running balance (closing balance)
--    month by month for each customer.
-- 7. Return the first 20 rows for validation.
WITH
  customers AS (                       -- Step‑1
    SELECT DISTINCT customer_id
    FROM customer_transactions
  ),
  month_dim AS (                       -- Step‑2
    WITH RECURSIVE m(dt) AS (
      SELECT date((SELECT MIN(txn_date) FROM customer_transactions), 'start of month')
      UNION ALL
      SELECT date(dt, '+1 month')
      FROM m
      WHERE dt < date((SELECT MAX(txn_date) FROM customer_transactions), 'start of month')
    )
    SELECT strftime('%Y-%m', dt) AS month_year
    FROM m
  ),
  monthly_change AS (                  -- Step‑3
    SELECT
      customer_id,
      strftime('%Y-%m', txn_date) AS month_year,
      SUM(
        CASE
          WHEN txn_type = 'deposit'    THEN  txn_amount
          WHEN txn_type = 'withdrawal' THEN -txn_amount
          ELSE 0
        END
      ) AS change_amt
    FROM customer_transactions
    GROUP BY customer_id, month_year
  ),
  grid AS (                            -- Step‑4
    SELECT c.customer_id, m.month_year
    FROM customers  AS c
    CROSS JOIN month_dim AS m
  ),
  merged AS (                          -- Step‑5
    SELECT
      g.customer_id,
      g.month_year,
      COALESCE(mc.change_amt, 0) AS monthly_change
    FROM grid AS g
    LEFT JOIN monthly_change AS mc
           ON mc.customer_id = g.customer_id
          AND mc.month_year  = g.month_year
  )
SELECT                                   -- Step‑6
  customer_id,
  month_year,
  monthly_change,
  SUM(monthly_change) OVER (
      PARTITION BY customer_id
      ORDER BY month_year
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
  ) AS closing_balance
FROM merged
ORDER BY customer_id, month_year
LIMIT 20;                                -- Step‑7
