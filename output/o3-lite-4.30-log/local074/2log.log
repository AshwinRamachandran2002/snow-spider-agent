--Description:
-- Corrected version of the “#10 closing‑balance” query.
-- The main fix is to make sure every table alias referenced in the SELECT list
-- and ORDER BY clause is defined in the scope of that SELECT.
-- Steps performed:
--   1. Build a month list (all_months) that spans from the earliest to the latest
--      transaction month.
--   2. Collect all customers.
--   3. Compute each customer’s net monthly change (deposit – withdrawal).
--   4. CROSS JOIN customers × all_months to create a full customer‑month grid.
--   5. LEFT JOIN the net‑change results onto that grid; COALESCE missing rows to 0.
--   6. Use a window SUM to derive the cumulative (closing) balance per month.
--   7. Display 20 sample rows for verification.

WITH
  all_months AS (
    WITH RECURSIVE m(dt) AS (
      SELECT date((SELECT MIN(txn_date) FROM customer_transactions), 'start of month')
      UNION ALL
      SELECT date(dt, '+1 month')
      FROM m
      WHERE dt < date((SELECT MAX(txn_date) FROM customer_transactions), 'start of month')
    )
    SELECT strftime('%Y-%m', dt) AS month_year
    FROM m
  ),
  customers AS (
    SELECT DISTINCT customer_id
    FROM customer_transactions
  ),
  monthly_change AS (
    SELECT
      customer_id,
      strftime('%Y-%m', txn_date) AS month_year,
      SUM(
        CASE
          WHEN txn_type = 'deposit'    THEN  txn_amount
          WHEN txn_type = 'withdrawal' THEN -txn_amount
          ELSE 0
        END
      ) AS change_amt
    FROM customer_transactions
    GROUP BY customer_id, month_year
  ),
  grid AS (
    SELECT c.customer_id, m.month_year
    FROM customers  AS c
    CROSS JOIN all_months AS m
  ),
  merged AS (
    SELECT
      g.customer_id,
      g.month_year,
      COALESCE(mc.change_amt, 0) AS monthly_change
    FROM grid AS g
    LEFT JOIN monthly_change AS mc
           ON mc.customer_id = g.customer_id
          AND mc.month_year  = g.month_year
  )
SELECT
  customer_id,
  month_year,
  monthly_change,
  SUM(monthly_change) OVER (
    PARTITION BY customer_id
    ORDER BY month_year
    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
  ) AS closing_balance
FROM merged
ORDER BY customer_id, month_year
LIMIT 20
