```

```sql
-- 5) Monthly net change (deposit positive, withdrawal negative) for each customer
SELECT
  "customer_id",
  strftime('%Y-%m', "txn_date") AS "month_year",
  SUM(
      CASE
        WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
        WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
        ELSE 0
      END
  ) AS "monthly_change"
FROM "customer_transactions"
GROUP BY "customer_id", "month_year"
ORDER BY "customer_id", "month_year"
LIMIT 20;
```

```sql
-- 6) Distinct customer list (needed for the later all‑months cross join)
SELECT DISTINCT "customer_id"
FROM "customer_transactions"
ORDER BY "customer_id"
LIMIT 20;
```

```sql
-- 7) Create a complete calendar of months that exist between min and max txn_date
WITH RECURSIVE months(m) AS (
  SELECT date((SELECT MIN("txn_date") FROM "customer_transactions"), 'start of month')
  UNION ALL
  SELECT date(m, '+1 month')
  FROM months
  WHERE m < date((SELECT MAX("txn_date") FROM "customer_transactions"), 'start of month')
)
SELECT strftime('%Y-%m', m) AS "month_year"
FROM months
ORDER BY "month_year"
LIMIT 20;
```

```sql
-- 8) Produce every (customer, month) combination so that inactive months are present
WITH RECURSIVE months(m) AS (
  SELECT date((SELECT MIN("txn_date") FROM "customer_transactions"), 'start of month')
  UNION ALL
  SELECT date(m, '+1 month')
  FROM months
  WHERE m < date((SELECT MAX("txn_date") FROM "customer_transactions"), 'start of month')
)
SELECT c."customer_id", strftime('%Y-%m', m) AS "month_year"
FROM (SELECT DISTINCT "customer_id" FROM "customer_transactions") AS c
CROSS JOIN months
ORDER BY c."customer_id", "month_year"
LIMIT 20;
```

```sql
-- 9) Join monthly change onto the full (customer, month) grid
WITH
  all_months AS (
    WITH RECURSIVE m(mth) AS (
      SELECT date((SELECT MIN("txn_date") FROM "customer_transactions"), 'start of month')
      UNION ALL
      SELECT date(mth, '+1 month') FROM m
      WHERE mth < date((SELECT MAX("txn_date") FROM "customer_transactions"), 'start of month')
    )
    SELECT strftime('%Y-%m', mth) AS month_year FROM m
  ),
  customers AS (
    SELECT DISTINCT "customer_id" FROM "customer_transactions"
  ),
  monthly_change AS (
    SELECT
      "customer_id",
      strftime('%Y-%m', "txn_date") AS month_year,
      SUM(
        CASE WHEN "txn_type"='deposit' THEN  "txn_amount"
             WHEN "txn_type"='withdrawal' THEN - "txn_amount"
             ELSE 0 END
      ) AS change_amt
    FROM "customer_transactions"
    GROUP BY "customer_id", "month_year"
  )
SELECT
  g."customer_id",
  g."month_year",
  COALESCE(mc.change_amt, 0) AS "monthly_change"
FROM customers c
CROSS JOIN all_months g
LEFT JOIN monthly_change mc
      ON mc."customer_id" = c."customer_id"
     AND mc."month_year"  = g."month_year"
ORDER BY g."customer_id", g."month_year"
LIMIT 20;
```

```sql
-- 10) Closing balance per month using a running sum window over the monthly change
WITH
  all_months AS (
    WITH RECURSIVE m(mth) AS (
      SELECT date((SELECT MIN("txn_date") FROM "customer_transactions"), 'start of month')
      UNION ALL
      SELECT date(mth, '+1 month') FROM m
      WHERE mth < date((SELECT MAX("txn_date") FROM "customer_transactions"), 'start of month')
    )
    SELECT strftime('%Y-%m', mth) AS month_year FROM m
  ),
  customers AS (
    SELECT DISTINCT "customer_id" FROM "customer_transactions"
  ),
  monthly_change AS (
    SELECT
      "customer_id",
      strftime('%Y-%m', "txn_date") AS month_year,
      SUM(
        CASE WHEN "txn_type"='deposit' THEN  "txn_amount"
             WHEN "txn_type"='withdrawal' THEN - "txn_amount"
             ELSE 0 END
      ) AS change_amt
    FROM "customer_transactions"
    GROUP BY "customer_id", "month_year"
  ),
  grid AS (
    SELECT
      c."customer_id",
      m."month_year"
    FROM customers c
    CROSS JOIN all_months m
  ),
  merged AS (
    SELECT
      g."customer_id",
      g."month_year",
      COALESCE(mc.change_amt, 0) AS monthly_change
    FROM grid g
    LEFT JOIN monthly_change mc
      ON mc."customer_id" = g."customer_id"
     AND mc."month_year"  = g."month_year"
  )
SELECT
  "customer_id",
  "month_year",
  "monthly_change",
  SUM("monthly_change") OVER (
      PARTITION BY "customer_id"
      ORDER BY "month_year"
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
  ) AS "closing_balance"
FROM merged
ORDER BY "customer_id", "month_year"
LIMIT 20;
```

These 10 queries progress from basic data inspection to a complete, window‑function driven calculation of each customer’s month‑end closing balance, ensuring that months with no activity are still represented with a carried‑forward balance of zero change.
