Relevant tables / columns and how they will be used
---------------------------------------------------
mst_users  
• user_id : primary key to count unique users  
• birth_date : to calculate user’s age (YYYY‑MM‑DD).  

(Other tables are not necessary because the age can be calculated from mst_users alone.)

Typical conditions / notes  
• Ignore rows whose birth_date is NULL or malformed.  
• Age  = strftime('%Y','now') – substr(birth_date,1,4).  
• Age‑band label (20s, 30s …) can be obtained with CASE.  

Exploratory & step‑by‑step SQL (10 examples)
-------------------------------------------
```sql
-- 1. Show a few raw birth dates so we know the format
SELECT DISTINCT "birth_date"
FROM "mst_users"
WHERE "birth_date" IS NOT NULL
LIMIT 20;
```

```sql
-- 2. Pair each user with the four‑digit birth year that will be used later
SELECT "user_id",
       substr("birth_date", 1, 4) AS "birth_year"
FROM   "mst_users"
WHERE  "birth_date" IS NOT NULL
LIMIT 20;
```

```sql
-- 3. Compute the current age (based only on the year part)
SELECT "user_id",
       CAST(strftime('%Y','now') AS INTEGER)
       - CAST(substr("birth_date",1,4) AS INTEGER) AS "age"
FROM   "mst_users"
WHERE  "birth_date" IS NOT NULL
LIMIT 20;
```

```sql
-- 4. Put each user into a rough 10‑year bucket (20‑29, 30‑39, …)
SELECT "user_id",
       ( (CAST(strftime('%Y','now') AS INTEGER)
           - CAST(substr("birth_date",1,4) AS INTEGER)) / 10 ) * 10
         AS "age_floor"
FROM   "mst_users"
WHERE  "birth_date" IS NOT NULL
LIMIT 20;
```

```sql
-- 5. Same as #4 but render the bucket as a text label like '20s'
SELECT "user_id",
       printf('%ds',
              ( (CAST(strftime('%Y','now') AS INTEGER)
                  - CAST(substr("birth_date",1,4) AS INTEGER)) / 10 ) * 10
             ) AS "age_band"
FROM   "mst_users"
WHERE  "birth_date" IS NOT NULL
LIMIT 20;
```

```sql
-- 6. Count users that fall strictly into the 20‑29 range
SELECT COUNT(*) AS "cnt_20s"
FROM   "mst_users"
WHERE  "birth_date" IS NOT NULL
  AND  (CAST(strftime('%Y','now') AS INTEGER)
        - CAST(substr("birth_date",1,4) AS INTEGER)) BETWEEN 20 AND 29;
```

```sql
-- 7. Same idea for the 30s; written slightly differently
SELECT COUNT(*) AS "cnt_30s"
FROM   "mst_users"
WHERE  "birth_date" IS NOT NULL
  AND  (strftime('%Y','now') - substr("birth_date",1,4)) BETWEEN 30 AND 39;
```

```sql
-- 8. Do it for 40s, 50s and "other" in one query using CASE
SELECT CASE
         WHEN age BETWEEN 20 AND 29 THEN '20s'
         WHEN age BETWEEN 30 AND 39 THEN '30s'
         WHEN age BETWEEN 40 AND 49 THEN '40s'
         WHEN age BETWEEN 50 AND 59 THEN '50s'
         ELSE 'others'
       END                       AS "age_category",
       COUNT(*)                  AS "users"
FROM (
       SELECT (strftime('%Y','now') - substr("birth_date",1,4)) AS age
       FROM   "mst_users"
       WHERE  "birth_date" IS NOT NULL
     )
GROUP BY "age_category"
ORDER BY CASE
           WHEN "age_category"='20s'  THEN 1
           WHEN "age_category"='30s'  THEN 2
           WHEN "age_category"='40s'  THEN 3
           WHEN "age_category"='50s'  THEN 4
           ELSE 5
         END;
```

```sql
-- 9. Same as #8, but display percentages as well
SELECT "age_category",
       "users",
       ROUND(100.0 * "users" / SUM("users") OVER(), 1) || '%' AS "ratio"
FROM (
       SELECT CASE
                WHEN age BETWEEN 20 AND 29 THEN '20s'
                WHEN age BETWEEN 30 AND 39 THEN '30s'
                WHEN age BETWEEN 40 AND 49 THEN '40s'
                WHEN age BETWEEN 50 AND 59 THEN '50s'
                ELSE 'others'
              END  AS "age_category",
              COUNT(*) AS "users"
       FROM (
              SELECT (strftime('%Y','now')
                      - substr("birth_date",1,4)) AS age
              FROM   "mst_users"
              WHERE  "birth_date" IS NOT NULL
            )
       GROUP BY "age_category"
     )
ORDER BY "users" DESC;
```

```sql
-- 10. Final concise answer: number of users in each requested bucket
SELECT '20s'  AS "age_category",
       SUM( CASE WHEN (strftime('%Y','now') - substr("birth_date",1,4))
                           BETWEEN 20 AND 29 THEN 1 ELSE 0 END) AS "users" FROM "mst_users"
UNION ALL
SELECT '30s',
       SUM( CASE WHEN (strftime('%Y','now') - substr("birth_date",1,4))
                           BETWEEN 30 AND 39 THEN 1 ELSE 0 END) FROM "mst_users"
UNION ALL
SELECT '40s',
       SUM( CASE WHEN (strftime('%Y','now') - substr("birth_date",1,4))
                           BETWEEN 40 AND 49 THEN 1 ELSE 0 END) FROM "mst_users"
UNION ALL
SELECT '50s',
       SUM( CASE WHEN (strftime('%Y','now') - substr("birth_date",1,4))
                           BETWEEN 50 AND 59 THEN 1 ELSE 0 END) FROM "mst_users"
UNION ALL
SELECT 'others',
       SUM( CASE WHEN (strftime('%Y','now') - substr("birth_date",1,4))
                           NOT BETWEEN 20 AND 59 THEN 1 ELSE 0 END) FROM "mst_users";
```

