Relevant tables / columns and their roles  
• mst_users.user_id : unique key, lets us count users  
• mst_users.birth_date : needed to calculate each user’s present age  
• (optional) mst_users.withdraw_date : if we only want “active” users we could add … WHERE "withdraw_date" IS NULL  
Main condition we will often use  
• WHERE "birth_date" IS NOT NULL             – remove rows whose age cannot be computed  

Below are 10 exploratory → final SQL snippets (all SQLite‑flavoured).  
Every statement is preceded by a short comment, uses only the provided tables, and is limited to 20 rows with DISTINCT where it makes sense.

```sql
-- 1. Peek at a handful of birth‑dates in mst_users
SELECT DISTINCT "birth_date"
FROM   "mst_users"
WHERE  "birth_date" IS NOT NULL
LIMIT  20;
```

```sql
-- 2. See which years of birth we have, newest to oldest
SELECT DISTINCT substr("birth_date",1,4) AS birth_year
FROM   "mst_users"
WHERE  "birth_date" IS NOT NULL
ORDER  BY birth_year DESC
LIMIT  20;
```

```sql
-- 3. Examine the combination of user_id and birth_date
SELECT DISTINCT "user_id","birth_date"
FROM   "mst_users"
WHERE  "birth_date" IS NOT NULL
LIMIT  20;
```

```sql
-- 4. Quickly compute each user’s current age (using today’s date)
SELECT DISTINCT
       "user_id",
       CAST(strftime('%Y','now') AS INTEGER)
       - CAST(strftime('%Y',"birth_date") AS INTEGER) AS age
FROM   "mst_users"
WHERE  "birth_date" IS NOT NULL
LIMIT  20;
```

```sql
-- 5. Put those ages into buckets (20s / 30s / 40s / 50s / others)
SELECT DISTINCT
       "user_id",
       CASE
           WHEN age BETWEEN 20 AND 29 THEN '20s'
           WHEN age BETWEEN 30 AND 39 THEN '30s'
           WHEN age BETWEEN 40 AND 49 THEN '40s'
           WHEN age BETWEEN 50 AND 59 THEN '50s'
           ELSE 'others'
       END AS age_group
FROM (
     SELECT "user_id",
            CAST(strftime('%Y','now') AS INTEGER)
            - CAST(strftime('%Y',"birth_date") AS INTEGER) AS age
     FROM   "mst_users"
     WHERE  "birth_date" IS NOT NULL
) AS t
LIMIT 20;
```

```sql
-- 6. Count how many users fall in each bucket (all users)
SELECT age_group,
       COUNT(DISTINCT "user_id") AS users
FROM (
     SELECT "user_id",
            CASE
               WHEN age BETWEEN 20 AND 29 THEN '20s'
               WHEN age BETWEEN 30 AND 39 THEN '30s'
               WHEN age BETWEEN 40 AND 49 THEN '40s'
               WHEN age BETWEEN 50 AND 59 THEN '50s'
               ELSE 'others'
            END AS age_group
     FROM (
          SELECT "user_id",
                 CAST(strftime('%Y','now') AS INTEGER)
                 - CAST(strftime('%Y',"birth_date") AS INTEGER) AS age
          FROM   "mst_users"
          WHERE  "birth_date" IS NOT NULL
     )
) GROUP BY age_group
LIMIT 20;
```

```sql
-- 7. Same as #6 but exclude users who have withdrawn
SELECT age_group,
       COUNT(DISTINCT "user_id") AS users
FROM (
     SELECT "user_id",
            CASE
                WHEN age BETWEEN 20 AND 29 THEN '20s'
                WHEN age BETWEEN 30 AND 39 THEN '30s'
                WHEN age BETWEEN 40 AND 49 THEN '40s'
                WHEN age BETWEEN 50 AND 59 THEN '50s'
                ELSE 'others'
            END AS age_group
     FROM (
          SELECT "user_id",
                 CAST(strftime('%Y','now') AS INTEGER)
                 - CAST(strftime('%Y',"birth_date") AS INTEGER) AS age,
                 "withdraw_date"
          FROM   "mst_users"
          WHERE  "birth_date" IS NOT NULL
            AND  "withdraw_date" IS NULL        -- active only
     )
) GROUP BY age_group
LIMIT 20;
```

```sql
-- 8. Quick check of any NULL birth_dates vs total users
SELECT
    SUM(CASE WHEN "birth_date" IS NULL THEN 1 ELSE 0 END) AS null_birth_dates,
    COUNT(*)                                                AS total_rows
FROM "mst_users"
LIMIT 20;
```

```sql
-- 9. Show age distribution broken down further by sex
SELECT
    sex,
    age_group,
    COUNT(DISTINCT "user_id") AS users
FROM (
     SELECT "user_id",
            sex,
            CASE
                WHEN age BETWEEN 20 AND 29 THEN '20s'
                WHEN age BETWEEN 30 AND 39 THEN '30s'
                WHEN age BETWEEN 40 AND 49 THEN '40s'
                WHEN age BETWEEN 50 AND 59 THEN '50s'
                ELSE 'others'
            END AS age_group
     FROM (
          SELECT "user_id",
                 sex,
                 CAST(strftime('%Y','now') AS INTEGER)
                 - CAST(strftime('%Y',"birth_date") AS INTEGER) AS age
          FROM   "mst_users"
          WHERE  "birth_date" IS NOT NULL
     )
) GROUP BY sex, age_group
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: count users per requested age category
SELECT
    CASE
        WHEN age BETWEEN 20 AND 29 THEN '20s'
        WHEN age BETWEEN 30 AND 39 THEN '30s'
        WHEN age BETWEEN 40 AND 49 THEN '40s'
        WHEN age BETWEEN 50 AND 59 THEN '50s'
        ELSE 'others'
    END AS age_group,
    COUNT(DISTINCT "user_id") AS users
FROM (
     SELECT "user_id",
            CAST(strftime('%Y','now') AS INTEGER)
            - CAST(strftime('%Y',"birth_date") AS INTEGER) AS age
     FROM   "mst_users"
     WHERE  "birth_date" IS NOT NULL
) AS t
GROUP BY age_group
ORDER BY
    CASE age_group
         WHEN '20s' THEN 1
         WHEN '30s' THEN 2
         WHEN '40s' THEN 3
         WHEN '50s' THEN 4
         ELSE 5
    END
LIMIT 20;
```

