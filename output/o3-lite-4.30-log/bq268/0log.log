Query:
--Description: ❾  Within Jan‑2017, show each visitor’s first session, first transaction
--               (if any) and the candidate “last recorded event” (first_tx_ts when it
--               exists, otherwise the last session).  The fix is to expose the nested
--               field totals.transactions as a plain column called “transactions” in
--               the CTE `s`, and then reference that column (transactions > 0).
WITH s AS (
  SELECT
    fullVisitorId,
    visitStartTime,
    totals.transactions AS transactions,
    device.isMobile
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20170101' AND '20170131'
),
first_visit AS (
  SELECT fullVisitorId, MIN(visitStartTime) AS first_visit_ts
  FROM s
  GROUP BY fullVisitorId
),
first_tx AS (
  SELECT fullVisitorId, MIN(visitStartTime) AS first_tx_ts
  FROM s
  WHERE transactions > 0
  GROUP BY fullVisitorId
),
last_visit AS (
  SELECT fullVisitorId, MAX(visitStartTime) AS last_visit_ts
  FROM s
  GROUP BY fullVisitorId
),
events AS (
  SELECT
    fv.fullVisitorId,
    fv.first_visit_ts,
    COALESCE(ft.first_tx_ts, lv.last_visit_ts) AS last_event_ts
  FROM first_visit fv
  LEFT JOIN first_tx  ft USING (fullVisitorId)
  LEFT JOIN last_visit lv USING (fullVisitorId)
)
SELECT *
FROM events
LIMIT 20
