Begin Exploring Related Columns
Relevant columns (and why)

• fullVisitorId: unique visitor key – use to stitch all sessions belonging to the same user.  
• visitStartTime: session Unix‑epoch – use to derive first‑visit date and all “event” dates.  
• date: YYYYMMDD string version of the visit date – handy to turn epoch into a calendar day.  
• totals.transactions: number of transactions in the session – if >0 → the session contains the first transaction.  
• device.isMobile: TRUE/FALSE flag telling whether the session happened on a mobile device – we keep only users whose last recorded event is mobile.  
• _TABLE_SUFFIX (virtual) : the wild‑card part after ga_sessions_* – lets us query many day‑tables at once and/or filter a time range.  

Typical conditions

• totals.transactions > 0 → “transaction sessions”.  
• device.isMobile = TRUE → sessions that occurred on a mobile device.  
• _TABLE_SUFFIX BETWEEN '20160801' AND '20170801' → limit to the 1‑year demo data range.  


Ten exploratory → final SQL snippets
(each limited to 20 rows and wrapped in back‑ticks for copy/paste)

```sql
-- 1. Peek at raw rows (20 random sessions)
SELECT
  fullVisitorId,
  visitStartTime,
  date,
  totals.transactions,
  device.isMobile
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170127`
LIMIT 20;
```

```sql
-- 2. Distinct device categories to understand “mobile”
SELECT DISTINCT device.deviceCategory
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170127`
LIMIT 20;
```

```sql
-- 3. How many sessions per visitor on a single day?
SELECT
  fullVisitorId,
  COUNT(1) AS sessions_on_20170127
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170127`
GROUP BY fullVisitorId
LIMIT 20;
```

```sql
-- 4. Grab sessions that contain at least one transaction
SELECT
  fullVisitorId,
  visitStartTime,
  totals.transactions,
  device.isMobile
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170127`
WHERE totals.transactions > 0
LIMIT 20;
```

```sql
-- 5. First transaction (earliest) per user in a two‑day window
WITH tx AS (
  SELECT
    fullVisitorId,
    visitStartTime,
    DATE(TIMESTAMP_SECONDS(visitStartTime)) AS tx_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX IN ('20170126','20170127')
    AND totals.transactions > 0
)
SELECT *
FROM (
  SELECT
    fullVisitorId,
    MIN(visitStartTime) AS first_tx_ts
  FROM tx
  GROUP BY fullVisitorId
)
LIMIT 20;
```

```sql
-- 6. First visit per user in the same two‑day window
WITH v AS (
  SELECT fullVisitorId, visitStartTime
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX IN ('20170126','20170127')
)
SELECT
  fullVisitorId,
  MIN(visitStartTime) AS first_visit_ts
FROM v
GROUP BY fullVisitorId
LIMIT 20;
```

```sql
-- 7. Last visit per user in the same window + whether it was mobile
WITH v AS (
  SELECT fullVisitorId, visitStartTime, device.isMobile
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX IN ('20170126','20170127')
)
SELECT
  fullVisitorId,
  MAX(visitStartTime) AS last_visit_ts,
  ANY_VALUE(device.isMobile) KEEP (DENSE_RANK LAST ORDER BY visitStartTime) 
      AS last_visit_mobile
FROM v
GROUP BY fullVisitorId
LIMIT 20;
```

```sql
-- 8. Days between first visit and FIRST transaction (only buyers)
WITH sessions AS (
  SELECT fullVisitorId, visitStartTime, totals.transactions
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20170101' AND '20170131'
), 
first_visit AS (
  SELECT fullVisitorId, MIN(visitStartTime) AS first_visit_ts
  FROM sessions
  GROUP BY fullVisitorId
), 
first_tx AS (
  SELECT fullVisitorId, MIN(visitStartTime) AS first_tx_ts
  FROM sessions
  WHERE totals.transactions > 0
  GROUP BY fullVisitorId
)
SELECT
  f.fullVisitorId,
  DATE_DIFF(
    DATE(TIMESTAMP_SECONDS(t.first_tx_ts)),
    DATE(TIMESTAMP_SECONDS(f.first_visit_ts)),
    DAY) AS days_to_first_tx
FROM first_visit f
JOIN first_tx t USING(fullVisitorId)
LIMIT 20;
```

```sql
-- 9. Candidate “last recorded event” per user in Jan‑2017
WITH s AS (
  SELECT
    fullVisitorId,
    visitStartTime,
    totals.transactions,
    device.isMobile
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20170101' AND '20170131'
), 
first_visit AS (
  SELECT fullVisitorId, MIN(visitStartTime) AS first_visit_ts
  FROM s GROUP BY fullVisitorId
), 
first_tx AS (
  SELECT fullVisitorId, MIN(visitStartTime) AS first_tx_ts
  FROM s WHERE totals.transactions > 0 GROUP BY fullVisitorId
), 
last_visit AS (
  SELECT fullVisitorId, MAX(visitStartTime) AS last_visit_ts
  FROM s GROUP BY fullVisitorId
), 
events AS (
  SELECT
    fv.fullVisitorId,
    fv.first_visit_ts,
    COALESCE(ft.first_tx_ts, lv.last_visit_ts) AS last_event_ts
  FROM first_visit fv
  LEFT JOIN first_tx ft USING(fullVisitorId)
  LEFT JOIN last_visit lv USING(fullVisitorId)
)
SELECT * FROM events LIMIT 20;
```

```sql
-- 10. Final answer: users whose LAST recorded event was on mobile
--     and the maximum number of days between first visit and that event
WITH sessions AS (
  SELECT
    fullVisitorId,
    visitStartTime,
    totals.transactions,
    device.isMobile
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170801'
), 
first_visit AS (
  SELECT fullVisitorId, MIN(visitStartTime) AS first_visit_ts
  FROM sessions
  GROUP BY fullVisitorId
), 
first_tx AS (
  SELECT fullVisitorId, MIN(visitStartTime) AS first_tx_ts
  FROM sessions
  WHERE totals.transactions > 0
  GROUP BY fullVisitorId
), 
last_visit AS (
  SELECT fullVisitorId, MAX(visitStartTime) AS last_visit_ts
  FROM sessions
  GROUP BY fullVisitorId
), 
last_event AS (
  SELECT
    fv.fullVisitorId,
    fv.first_visit_ts,
    COALESCE(ft.first_tx_ts, lv.last_visit_ts) AS last_event_ts
  FROM first_visit fv
  LEFT JOIN first_tx ft USING(fullVisitorId)
  LEFT JOIN last_visit lv USING(fullVisitorId)
), 
mobile_flag AS (
  SELECT
    le.*,
    -- pick mobile flag for the session that equals last_event_ts
    ANY_VALUE(s.isMobile) AS is_mobile_event
  FROM last_event le
  JOIN sessions s
    ON  s.fullVisitorId   = le.fullVisitorId
    AND s.visitStartTime  = le.last_event_ts
  GROUP BY le.fullVisitorId, le.first_visit_ts, le.last_event_ts
), 
differences AS (
  SELECT
    fullVisitorId,
    DATE_DIFF(
      DATE(TIMESTAMP_SECONDS(last_event_ts)),
      DATE(TIMESTAMP_SECONDS(first_visit_ts)),
      DAY) AS days_between
  FROM mobile_flag
  WHERE is_mobile_event = TRUE
)
SELECT
  days_between
FROM differences
ORDER BY days_between DESC
LIMIT 20;
```

The very last query (10) calculates, for every user whose final meaningful event occurred on a mobile device, the number of days between that event and their first visit, then lists the 20 largest gaps (replace the final ORDER / LIMIT with `SELECT MAX(days_between) AS longest_gap_in_days` if you only need the single longest span).
