--Description:  One‐statement solution (comments = thinking process) that
--              finds the 20 visitors with the largest number of days between
--              their FIRST visit and their “last recorded event”.
--              Rule for “last recorded event” per visitor:
--                 • If the visitor has any transaction sessions, use the FIRST
--                   such session; otherwise use the LAST session.
--              Only retain visitors whose chosen final event occurred on a
--              MOBILE device.
--              Technical notes:
--                 • Read the required columns from seven daily tables via a
--                   single wildcard scan and _TABLE_SUFFIX filter — avoids the
--                   UNION‑ALL column‐mismatch seen previously.
--                 • Use ROW_NUMBER() to pick first / last rows where needed.
WITH
/* --------------------------------------------------------------------------
   Step 1 : Pull sessions we need, selecting only relevant columns
----------------------------------------------------------------------------*/
sess AS (
  SELECT
    fullVisitorId,
    DATE(PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS session_date,
    visitStartTime,
    device.isMobile                           AS is_mobile,
    totals.transactions                       AS txn_cnt
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX IN (
        '20170127','20170212','20170314',
        '20170421','20170515','20170614','20170715'
  )
),
/* --------------------------------------------------------------------------
   Step 2 : First transaction per visitor
----------------------------------------------------------------------------*/
first_tx AS (
  SELECT
    fullVisitorId,
    session_date                AS tx_date,
    is_mobile                   AS tx_mobile,
    ROW_NUMBER() OVER (PARTITION BY fullVisitorId
                       ORDER BY session_date ASC, visitStartTime ASC) AS rn
  FROM sess
  WHERE txn_cnt > 0
),
first_tx_one AS (SELECT * FROM first_tx WHERE rn = 1),
/* --------------------------------------------------------------------------
   Step 3 : Last session per visitor
----------------------------------------------------------------------------*/
last_vis AS (
  SELECT
    fullVisitorId,
    session_date                AS lv_date,
    is_mobile                   AS lv_mobile,
    ROW_NUMBER() OVER (PARTITION BY fullVisitorId
                       ORDER BY session_date DESC, visitStartTime DESC) AS rn
  FROM sess
),
last_vis_one AS (SELECT * FROM last_vis WHERE rn = 1),
/* --------------------------------------------------------------------------
   Step 4 : First appearance (first visit) per visitor
----------------------------------------------------------------------------*/
first_vis AS (
  SELECT
    fullVisitorId,
    MIN(session_date) AS first_visit_date
  FROM sess
  GROUP BY fullVisitorId
),
/* --------------------------------------------------------------------------
   Step 5 : Decide each visitor’s “last recorded event” and its mobile flag
----------------------------------------------------------------------------*/
choose_event AS (
  SELECT
    fv.fullVisitorId,
    fv.first_visit_date,
    COALESCE(ft.tx_date , lv.lv_date ) AS event_date,
    COALESCE(ft.tx_mobile, lv.lv_mobile) AS event_is_mobile
  FROM first_vis       fv
  JOIN last_vis_one    lv USING (fullVisitorId)
  LEFT JOIN first_tx_one ft USING (fullVisitorId)
),
/* --------------------------------------------------------------------------
   Step 6 : Compute day gap, keep only visitors with mobile final event
----------------------------------------------------------------------------*/
gap AS (
  SELECT
    fullVisitorId,
    first_visit_date,
    event_date,
    DATE_DIFF(event_date, first_visit_date, DAY) AS days_between
  FROM choose_event
  WHERE event_is_mobile = TRUE
)
/* --------------------------------------------------------------------------
   Step 7 : Return the top‑20 longest gaps
----------------------------------------------------------------------------*/
SELECT
  fullVisitorId,
  first_visit_date,
  event_date   AS last_recorded_event_date,
  days_between AS days_between_first_and_last
FROM gap
ORDER BY days_between DESC
LIMIT 20;
