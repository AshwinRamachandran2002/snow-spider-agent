```sql
--Description: Find the visitor whose span between their very first visit
--             and their “last recorded event” is the longest, where that
--             final event happened on a MOBILE device.
--             Rule for the “last recorded event”:
--               • If the visitor ever made a transaction, use the FIRST
--                 session that contained a transaction.
--               • Otherwise use the LAST session we see.
--             Steps (all inside this single query):
--               1.  Pull every ga_sessions_YYYYMMDD table with a wildcard;
--                   keep session date, timestamp, transaction flag, and
--                   whether the device is mobile.
--               2.  Derive: first visit date; last visit (date + mobile);
--                   first transaction (date + mobile).
--               3.  Decide per visitor which event date wins by the rule.
--               4.  Keep only visitors whose chosen event was on mobile.
--               5.  Compute the day gap and return the largest one.
WITH sessions AS (
  SELECT
    fullVisitorId,
    DATE(PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS session_date,
    visitStartTime,
    device.isMobile                           AS is_mobile,
    totals.transactions                       AS txn_cnt
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
),
-- first visit for every visitor -------------------------------------------
first_visit AS (
  SELECT
    fullVisitorId,
    MIN(session_date) AS first_visit_date
  FROM sessions
  GROUP BY fullVisitorId
),
-- last visit for every visitor --------------------------------------------
last_visit AS (
  SELECT
    fullVisitorId,
    session_date    AS last_visit_date,
    is_mobile       AS last_visit_mobile,
    ROW_NUMBER() OVER (
      PARTITION BY fullVisitorId
      ORDER BY session_date DESC, visitStartTime DESC
    ) AS rn
  FROM sessions
),
last_visit_one AS (
  SELECT * FROM last_visit WHERE rn = 1
),
-- first transaction for every visitor -------------------------------------
first_tx AS (
  SELECT
    fullVisitorId,
    session_date    AS first_tx_date,
    is_mobile       AS first_tx_mobile,
    ROW_NUMBER() OVER (
      PARTITION BY fullVisitorId
      ORDER BY session_date ASC, visitStartTime ASC
    ) AS rn
  FROM sessions
  WHERE txn_cnt > 0
),
first_tx_one AS (
  SELECT * FROM first_tx WHERE rn = 1
),
-- stitch everything and choose the “event” --------------------------------
event_choice AS (
  SELECT
    fv.fullVisitorId,
    fv.first_visit_date,
    lv.last_visit_date,
    lv.last_visit_mobile,
    ft.first_tx_date,
    ft.first_tx_mobile,
    COALESCE(ft.first_tx_date,   lv.last_visit_date)   AS event_date,
    COALESCE(ft.first_tx_mobile, lv.last_visit_mobile) AS event_is_mobile
  FROM first_visit      fv
  JOIN last_visit_one   lv USING (fullVisitorId)
  LEFT JOIN first_tx_one ft USING (fullVisitorId)
),
-- compute gap and keep only mobile final events ---------------------------
gap_calc AS (
  SELECT
    fullVisitorId,
    first_visit_date,
    event_date,
    DATE_DIFF(event_date, first_visit_date, DAY) AS days_between
  FROM event_choice
  WHERE event_is_mobile = TRUE
)
-- final answer: visitor(s) with the longest gap ---------------------------
SELECT
  fullVisitorId,
  first_visit_date,
  event_date   AS last_recorded_event_date,
  days_between AS days_between_first_and_last
FROM gap_calc
ORDER BY days_between DESC
LIMIT 20;
```
