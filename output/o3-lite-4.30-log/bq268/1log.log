--Description:  Corrected version of the “FINAL” query (original item #10).
--              No BigQuery reserved words are used as CTE names, and each CTE
--              name is unique.  The query returns the 20 visitors who exhibit
--              the largest number of days between their very first visit and
--              their “last recorded event”, where that last recorded event
--              (first transaction if any, otherwise last visit) occurred on a
--              mobile device.
WITH unioned AS (      -- pick a handful of daily tables to stay lightweight
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170127`
  UNION ALL
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170212`
  UNION ALL
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170314`
  UNION ALL
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170421`
  UNION ALL
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170515`
  UNION ALL
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170614`
  UNION ALL
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170715`
),
sess AS (
  SELECT
    fullVisitorId,
    DATE(PARSE_DATE('%Y%m%d', date))  AS session_date,
    visitStartTime,
    device.isMobile                   AS is_mobile,
    totals.transactions               AS txn_cnt
  FROM unioned
),
-- first transaction per user ----------------------------------------------
first_tx AS (
  SELECT
    fullVisitorId,
    session_date          AS tx_date,
    is_mobile             AS tx_mobile,
    ROW_NUMBER() OVER (PARTITION BY fullVisitorId
                       ORDER BY session_date ASC, visitStartTime ASC) AS rn
  FROM sess
  WHERE txn_cnt > 0
),
-- last visit per user ------------------------------------------------------
last_visit AS (
  SELECT
    fullVisitorId,
    session_date          AS lv_date,
    is_mobile             AS lv_mobile,
    ROW_NUMBER() OVER (PARTITION BY fullVisitorId
                       ORDER BY session_date DESC, visitStartTime DESC) AS rn
  FROM sess
),
-- decide which event is kept ----------------------------------------------
chosen AS (
  SELECT
    v.fullVisitorId,
    v.lv_date,
    v.lv_mobile,
    t.tx_date,
    t.tx_mobile
  FROM (SELECT * FROM last_visit WHERE rn = 1) v
  LEFT JOIN (SELECT * FROM first_tx WHERE rn = 1) t
  USING (fullVisitorId)
),
-- first visit date per user ------------------------------------------------
first_visit AS (
  SELECT
    fullVisitorId,
    MIN(session_date) AS first_visit_date
  FROM sess
  GROUP BY fullVisitorId
),
-- combine pieces and compute gap ------------------------------------------
assembled AS (
  SELECT
    c.fullVisitorId,
    fv.first_visit_date,
    COALESCE(c.tx_date,  c.lv_date)   AS event_date,
    COALESCE(c.tx_mobile, c.lv_mobile) AS event_is_mobile
  FROM chosen            c
  JOIN first_visit       fv USING (fullVisitorId)
),
gap_calc AS (
  SELECT
    fullVisitorId,
    first_visit_date,
    event_date,
    DATE_DIFF(event_date, first_visit_date, DAY) AS days_between
  FROM assembled
  WHERE event_is_mobile = TRUE
)
SELECT
  fullVisitorId,
  first_visit_date,
  event_date   AS last_recorded_event_date,
  days_between AS days_between_first_and_last
FROM gap_calc
ORDER BY days_between DESC
LIMIT 20;
