```sql
-- 9) For each user: first visit, last visit, first transaction,
--    and the chosen "last recorded event" according to the rule
WITH sessions AS (
  -- use a few monthly snapshots so the query stays light
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170127`
  UNION ALL
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170212`
  UNION ALL
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170314`
),
base AS (
  SELECT
    fullVisitorId,
    DATE(PARSE_DATE('%Y%m%d', date))               AS session_date,
    visitStartTime,
    device.isMobile                                AS is_mobile,
    totals.transactions                            AS txn_cnt
  FROM sessions
),
rollup AS (
  SELECT
    fullVisitorId,
    MIN(session_date)                              AS first_visit_date,
    MAX(session_date)                              AS last_visit_date,
    MIN(CASE WHEN txn_cnt > 0 THEN session_date END)  AS first_txn_date
  FROM base
  GROUP BY fullVisitorId
)
SELECT
  fullVisitorId,
  first_visit_date,
  last_visit_date,
  first_txn_date,
  CASE
    WHEN first_txn_date IS NOT NULL THEN first_txn_date
    ELSE last_visit_date
  END                                               AS chosen_event_date
FROM rollup
LIMIT 20;
```

```sql
-- 10) FINAL – who has the longest gap (days) from first visit
--      to the "last recorded event" (first transaction OR last visit),
--      where that last recorded event happened on a MOBILE device
WITH unioned AS (
  -- a compact yet multi‑month sample of tables (add more unions if desired)
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170127`
  UNION ALL
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170212`
  UNION ALL
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170314`
  UNION ALL
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170421`
  UNION ALL
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170515`
  UNION ALL
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170614`
  UNION ALL
  SELECT * FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170715`
),
sess AS (
  SELECT
    fullVisitorId,
    DATE(PARSE_DATE('%Y%m%d', date))  AS session_date,
    visitStartTime,
    device.isMobile                   AS is_mobile,
    totals.transactions               AS txn_cnt
  FROM unioned
),
-- first tx per user ---------------------------------------------------------
first_tx AS (
  SELECT
    fullVisitorId,
    session_date          AS tx_date,
    is_mobile             AS tx_mobile,
    ROW_NUMBER() OVER (PARTITION BY fullVisitorId
                       ORDER BY session_date ASC, visitStartTime ASC) AS rn
  FROM sess
  WHERE txn_cnt > 0
),
-- last visit per user -------------------------------------------------------
last_visit AS (
  SELECT
    fullVisitorId,
    session_date          AS lv_date,
    is_mobile             AS lv_mobile,
    ROW_NUMBER() OVER (PARTITION BY fullVisitorId
                       ORDER BY session_date DESC, visitStartTime DESC) AS rn
  FROM sess
),
-- decide which event to keep ------------------------------------------------
chosen AS (
  SELECT
    v.fullVisitorId,
    v.lv_date,
    v.lv_mobile,
    t.tx_date,
    t.tx_mobile
  FROM
    (SELECT * FROM last_visit WHERE rn = 1)  v
  LEFT JOIN
    (SELECT * FROM first_tx WHERE rn = 1) t
  USING (fullVisitorId)
),
first_visit AS (
  SELECT
    fullVisitorId,
    MIN(session_date) AS first_visit_date
  FROM sess
  GROUP BY fullVisitorId
),
assembled AS (
  SELECT
    c.fullVisitorId,
    fv.first_visit_date,
    -- event date: first transaction if it exists, else last visit
    COALESCE(c.tx_date, c.lv_date)                              AS event_date,
    -- event on mobile?  use the appropriate mobile flag
    COALESCE(c.tx_mobile, c.lv_mobile)                          AS event_is_mobile
  FROM chosen  AS c
  JOIN first_visit AS fv USING (fullVisitorId)
),
gap_calc AS (
  SELECT
    fullVisitorId,
    first_visit_date,
    event_date,
    DATE_DIFF(event_date, first_visit_date, DAY) AS days_between
  FROM assembled
  WHERE event_is_mobile = TRUE          -- keep only users whose
                                        -- last recorded event was mobile
)
SELECT
  fullVisitorId,
  first_visit_date,
  event_date,
  days_between
FROM gap_calc
ORDER BY days_between DESC
LIMIT 20;
```

Each successive query adds a new idea, ending with a compact answer‑level query that returns (up to) the 20 users who show the largest number of days between their first visit and their last recorded event **and** whose last recorded event occurred on a mobile device.
