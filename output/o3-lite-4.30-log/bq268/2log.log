```sql
WITH all_sessions AS (
  -- bring every available day into one single stream
  SELECT
    fullVisitorId,
    visitStartTime,                 -- session‑level epoch seconds
    device.isMobile,                -- TRUE when the session was on a mobile device
    hits                             -- repeated record – needed to find transactions
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170801'        -- whole life–span of the demo data
),

/* first time the visitor generated an e‑commerce transaction */
first_transaction AS (
  SELECT
    fullVisitorId,
    MIN(visitStartTime + h.time) AS first_txn_ts               -- absolute epoch seconds
  FROM  all_sessions, UNNEST(hits) AS h
  WHERE h.transaction.transactionId IS NOT NULL
  GROUP BY fullVisitorId
),

/* first / last visit for every visitor, and last visit that was on mobile */
visits_summary AS (
  SELECT
    fullVisitorId,
    MIN(visitStartTime)                                         AS first_visit_ts,
    MAX(visitStartTime)                                         AS last_visit_ts,
    MAX(IF(isMobile, visitStartTime, NULL))                     AS last_mobile_visit_ts
  FROM all_sessions
  GROUP BY fullVisitorId
),

/* choose as “last recorded event” the later of
   (a) the last visit and
   (b) the first transaction                                    */
combined AS (
  SELECT
    v.fullVisitorId,
    v.first_visit_ts,
    GREATEST(v.last_visit_ts, COALESCE(t.first_txn_ts, 0))      AS last_recorded_event_ts,
    v.last_mobile_visit_ts
  FROM visits_summary v
  LEFT JOIN first_transaction t
  USING (fullVisitorId)
)

/* keep only the users whose last recorded event happened on a mobile device;
   return the one with the largest span (days) between first visit and that event */
SELECT
  fullVisitorId                                               AS user_id,
  DATE_DIFF(
      DATE(TIMESTAMP_SECONDS(last_recorded_event_ts)),
      DATE(TIMESTAMP_SECONDS(first_visit_ts)),
      DAY)                                                    AS days_between_first_visit_and_last_mobile_event
FROM combined
WHERE last_recorded_event_ts = last_mobile_visit_ts
ORDER BY days_between_first_visit_and_last_mobile_event DESC,
         user_id
LIMIT 1;
```
