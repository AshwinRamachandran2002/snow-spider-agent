WITH races_with_pit AS (
    SELECT race_id
    FROM races_ext
    WHERE is_pit_data_available = 1
),
pos AS (
    SELECT lp.race_id,
           lp.lap,
           lp.driver_id,
           lp.position
    FROM lap_positions lp
    JOIN races_with_pit rwp
      ON rwp.race_id = lp.race_id
    WHERE lp.lap_type = 'Race'
),
candidate_overtakes AS (
    /* order between two cars is reversed from lap‑1 to lap */
    SELECT prevA.race_id,
           prevA.lap + 1                 AS lap,
           prevA.driver_id               AS driver_lost,      -- was ahead, now behind
           prevB.driver_id               AS driver_gained     -- was behind, now ahead
    FROM pos AS prevA
    JOIN pos AS prevB
      ON prevB.race_id = prevA.race_id
     AND prevB.lap     = prevA.lap
     AND prevB.position > prevA.position                      -- A ahead of B on lap‑1
    JOIN pos AS curA
      ON curA.race_id  = prevA.race_id
     AND curA.lap      = prevA.lap + 1
     AND curA.driver_id= prevA.driver_id
    JOIN pos AS curB
      ON curB.race_id  = prevB.race_id
     AND curB.lap      = prevB.lap + 1
     AND curB.driver_id= prevB.driver_id
    WHERE curB.position < curA.position                       -- B ahead of A on lap
),
overtakes_no_pit AS (
    /* exclude swaps that occur on laps where either car is in the pits */
    SELECT co.*
    FROM candidate_overtakes co
    LEFT JOIN pit_stops ps_lost
           ON ps_lost.race_id  = co.race_id
          AND ps_lost.driver_id= co.driver_lost
          AND ps_lost.lap      = co.lap
    LEFT JOIN pit_stops ps_gain
           ON ps_gain.race_id  = co.race_id
          AND ps_gain.driver_id= co.driver_gained
          AND ps_gain.lap      = co.lap
    WHERE ps_lost.race_id IS NULL
      AND ps_gain.race_id IS NULL
),
classified AS (
    SELECT
        CASE
            WHEN o.lap = 1 THEN 'Race Start'
            WHEN ps_prev.driver_id IS NOT NULL THEN 'Pit Exit'        -- gaining car left pits previous lap
            WHEN ps_curr.driver_id IS NOT NULL THEN 'Pit Entry'       -- losing car entered pits this lap
            WHEN ret_prev.driver_id IS NOT NULL THEN 'Post‑Retirement'
            ELSE 'On‑Track'
        END AS overtake_type
    FROM overtakes_no_pit o
    LEFT JOIN pit_stops ps_prev
           ON ps_prev.race_id   = o.race_id
          AND ps_prev.driver_id = o.driver_gained
          AND ps_prev.lap       = o.lap - 1
    LEFT JOIN pit_stops ps_curr
           ON ps_curr.race_id   = o.race_id
          AND ps_curr.driver_id = o.driver_lost
          AND ps_curr.lap       = o.lap
    LEFT JOIN retirements ret_prev
           ON ret_prev.race_id   = o.race_id
          AND ret_prev.driver_id = o.driver_gained
          AND ret_prev.lap       = o.lap - 1
)
SELECT overtake_type,
       COUNT(*) AS overtake_count
FROM classified
GROUP BY overtake_type
ORDER BY overtake_type;
