--Description / Thinking process:  
--1. Focus on a single event that we know contains full pit‑stop coverage (race_id = 841).  
--2. Restrict to lap_positions rows labelled 'Race' so we ignore grid / formation / pit‑lane records.  
--3. Create a CTE “pos” holding each driver’s position on every race lap.  
--4. Join two copies of “pos” from the same lap (curA, curB) to look at any pair of drivers.  
--5. Join their previous‑lap positions (prevA, prevB).  
--6. A candidate overtake is recorded when driver A was AHEAD of driver B on lap N‑1  
--   (prevA.position < prevB.position) but is BEHIND on lap N (curA.position > curB.position).  
--7. No adjacency test is enforced here—∆position may be ≥1—so we can confirm data exists.  
--8. Return the first 20 events just for inspection.

WITH pos AS (
    SELECT race_id, lap, driver_id, position
    FROM   lap_positions
    WHERE  race_id = 841          -- “pit‑data‑ready” grand prix
      AND  lap_type = 'Race'      -- pure racing laps only
)
SELECT  curA.race_id,
        curA.lap,
        curA.driver_id AS driver_now_behind,
        curB.driver_id AS driver_now_ahead,
        prevA.position AS prev_pos_A,
        prevB.position AS prev_pos_B,
        curA.position  AS curr_pos_A,
        curB.position  AS curr_pos_B
FROM     pos AS curA
JOIN     pos AS curB
       ON curB.race_id  = curA.race_id
      AND curB.lap      = curA.lap
      AND curB.driver_id<> curA.driver_id
JOIN     pos AS prevA
       ON prevA.race_id = curA.race_id
      AND prevA.lap     = curA.lap - 1
      AND prevA.driver_id = curA.driver_id
JOIN     pos AS prevB
       ON prevB.race_id = curB.race_id
      AND prevB.lap     = curA.lap - 1
      AND prevB.driver_id = curB.driver_id
WHERE    prevA.position < prevB.position     -- A was ahead of B on lap N‑1
  AND    curA.position  > curB.position      -- A is behind B on lap N (flip)
LIMIT 20;
