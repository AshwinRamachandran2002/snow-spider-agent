Query:
--Description: “Query 9” rebuilt – produce candidate overtakes in all races where full pit‑stop
--data exist, then discard laps in which either car made a pit‑stop on that same lap.
--Logic recap
-- 1. pos  : every driver’s position on every pure ‘Race’ lap for races with pit data
-- 2. candidate_overtakes: any pair of cars whose relative order flips from lap‑1 to lap
-- 3. final SELECT filters out pairs where driver_a OR driver_b pitted on the overtake lap
--    (we keep LIMIT 20 for brevity).

WITH pos AS (
    SELECT race_id, lap, driver_id, position
    FROM   lap_positions
    WHERE  lap_type = 'Race'
      AND  race_id IN (SELECT race_id FROM races_ext WHERE is_pit_data_available = 1)
),
candidate_overtakes AS (
    SELECT  prevA.race_id,
            prevA.lap + 1              AS lap,
            prevA.driver_id            AS driver_a,   -- loses position
            prevB.driver_id            AS driver_b    -- gains position
    FROM     pos AS prevA
    JOIN     pos AS prevB
           ON prevB.race_id   = prevA.race_id
          AND prevB.lap       = prevA.lap
          AND prevB.driver_id<> prevA.driver_id
    JOIN     pos AS curA
           ON curA.race_id    = prevA.race_id
          AND curA.lap        = prevA.lap + 1
          AND curA.driver_id  = prevA.driver_id
    JOIN     pos AS curB
           ON curB.race_id    = prevB.race_id
          AND curB.lap        = prevB.lap + 1
          AND curB.driver_id  = prevB.driver_id
    WHERE    prevA.position < prevB.position   -- A ahead of B on lap‑1
      AND    curA.position  > curB.position    -- A behind B on current lap ⇒ order flip
)
SELECT  co.*
FROM    candidate_overtakes AS co
LEFT JOIN pit_stops AS psA
       ON psA.race_id  = co.race_id
      AND psA.driver_id= co.driver_a
      AND psA.lap      = co.lap
LEFT JOIN pit_stops AS psB
       ON psB.race_id  = co.race_id
      AND psB.driver_id= co.driver_b
      AND psB.lap      = co.lap
WHERE   psA.race_id IS NULL        -- exclude if either pitted on this lap
  AND   psB.race_id IS NULL
LIMIT 20
