-- 10. Count overtakes by coarse type across the whole database
WITH
base AS (   -- all position‑swap events
  SELECT p1.race_id,
         p1.lap,
         behind.driver_id  AS behind_driver,
         ahead.driver_id   AS passed_driver
  FROM lap_positions AS p1
  JOIN lap_positions AS behind
    ON behind.race_id = p1.race_id
   AND behind.lap     = p1.lap
  JOIN lap_positions AS p0
    ON p0.race_id    = behind.race_id
   AND p0.driver_id  = behind.driver_id
   AND p0.lap        = behind.lap - 1
  JOIN lap_positions AS ahead
    ON ahead.race_id = p0.race_id
   AND ahead.lap     = p0.lap
   AND ahead.position = p0.position - 1
  JOIN lap_positions AS ahead_now
    ON ahead_now.race_id  = ahead.race_id
   AND ahead_now.driver_id = ahead.driver_id
   AND ahead_now.lap       = ahead.lap + 1
  WHERE p1.lap_type = 'Race'
    AND ahead_now.position > behind.position
    AND p1.race_id IN (SELECT DISTINCT race_id FROM pit_stops)  -- races w/ pit data
),
classified AS (
  SELECT b.*,
         CASE
           WHEN EXISTS (SELECT 1 FROM pit_stops ps
                        WHERE ps.race_id = b.race_id
                          AND ps.driver_id = b.passed_driver
                          AND ps.lap = b.lap)            THEN 'Pit‑Entry Pass'
           WHEN EXISTS (SELECT 1 FROM pit_stops ps
                        WHERE ps.race_id = b.race_id
                          AND ps.driver_id = b.passed_driver
                          AND ps.lap = b.lap - 1)        THEN 'Pit‑Exit Pass'
           WHEN EXISTS (SELECT 1 FROM retirements r
                        WHERE r.race_id = b.race_id
                          AND r.driver_id = b.passed_driver
                          AND r.lap = b.lap)              THEN 'Retirement Pass'
           ELSE 'On‑Track Pass'
         END AS overtake_type
  FROM base b
)
SELECT overtake_type,
       COUNT(*) AS num_overtakes
FROM classified
GROUP BY overtake_type
ORDER BY num_overtakes DESC
LIMIT 20;
