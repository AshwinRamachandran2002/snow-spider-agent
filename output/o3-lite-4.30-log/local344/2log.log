),

/* detect every position swap between two consecutive laps
   (the “passer” was directly behind the “passed” driver on the
   previous lap and is now ahead on the current lap)              */
base AS (
    SELECT
        cur.race_id,
        cur.lap,                           -- current lap (>=1, race‑lap numbering)
        prev.lap_type      AS prev_lap_type,
        cur.driver_id      AS passer_driver,
        prev_ahead.driver_id AS passed_driver
    FROM lap_positions            AS cur                -- driver after the swap
    JOIN lap_positions            AS prev               -- same driver, previous lap
         ON  prev.race_id   = cur.race_id
         AND prev.driver_id = cur.driver_id
         AND prev.lap       = cur.lap - 1
    JOIN lap_positions            AS prev_ahead         -- driver who was directly ahead
         ON  prev_ahead.race_id = prev.race_id
         AND prev_ahead.lap     = prev.lap
         AND prev_ahead.position = prev.position - 1
    JOIN lap_positions            AS cur_ahead          -- same “ahead” driver, current lap
         ON  cur_ahead.race_id   = prev_ahead.race_id
         AND cur_ahead.driver_id = prev_ahead.driver_id
         AND cur_ahead.lap       = cur.lap
    WHERE cur.lap_type = 'Race'                         -- only race laps
      AND cur_ahead.position > cur.position             -- positions have swapped
      AND cur.race_id IN (SELECT race_id FROM pit_races)
),

/* classify every swap */
classified AS (
    SELECT
        b.*,
        CASE
            /* grid‑to‑lap‑1 changes (race start) */
            WHEN b.lap = 1
              OR (b.prev_lap_type LIKE 'Starting Position%')
                 THEN 'Race Start Pass'

            /* car being passed enters the pits this same lap */
            WHEN EXISTS (
                     SELECT 1
                     FROM pit_stops ps
                     WHERE ps.race_id  = b.race_id
                       AND ps.driver_id = b.passed_driver
                       AND ps.lap       = b.lap
                 ) THEN 'Pit-Entry Pass'

            /* car being passed has just exited the pits (pitted previous lap) */
            WHEN EXISTS (
                     SELECT 1
                     FROM pit_stops ps
                     WHERE ps.race_id  = b.race_id
                       AND ps.driver_id = b.passed_driver
                       AND ps.lap       = b.lap - 1
                 ) THEN 'Pit-Exit Pass'

            /* car being passed retires on this lap */
            WHEN EXISTS (
                     SELECT 1
                     FROM retirements r
                     WHERE r.race_id   = b.race_id
                       AND r.driver_id = b.passed_driver
                       AND r.lap       = b.lap
                 ) THEN 'Retirement Pass'

            /* everything else */
            ELSE 'On-Track Pass'
        END AS overtake_type
    FROM base b
)

SELECT
    overtake_type,
    COUNT(*) AS count
FROM classified
GROUP BY overtake_type
ORDER BY count DESC;
