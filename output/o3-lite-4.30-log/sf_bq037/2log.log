```sql
-- 10) All-in-one summary: min, max, their counts and proportions
WITH tbl AS (
  SELECT "reference_bases", "start_position"
  FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"
  WHERE "partition_date_please_ignore" = '2015-02-20'
    AND "reference_bases" IN ('AT','TA')
),
stats AS (
  SELECT "reference_bases",
         MIN("start_position") AS min_pos,
         MAX("start_position") AS max_pos,
         COUNT(*)           AS total_cnt
  FROM tbl
  GROUP BY "reference_bases"
),
detail AS (
  SELECT s.*,
         SUM(CASE WHEN t."start_position" = s.min_pos THEN 1 ELSE 0 END) AS min_cnt,
         SUM(CASE WHEN t."start_position" = s.max_pos THEN 1 ELSE 0 END) AS max_cnt
  FROM stats s
  JOIN tbl t
    ON s."reference_bases" = t."reference_bases"
  GROUP BY s."reference_bases", s.min_pos, s.max_pos, s.total_cnt
)
SELECT "reference_bases",
       min_pos,
       max_pos,
       min_cnt,
       max_cnt,
       total_cnt,
       (min_cnt / total_cnt)::FLOAT AS min_prop,
       (max_cnt / total_cnt)::FLOAT AS max_prop
FROM detail
LIMIT 20;
