Query:
--Description:  Compute, for each reference base (‘AT’, ‘TA’), the maximum
--              start_position observed on 2015‑02‑20, how many variants sit
--              at that coordinate, and the proportion this represents out of
--              all variants with that base.
WITH base_counts AS (          -- total rows per base
    SELECT "reference_bases",
           COUNT(*) AS total_cnt
    FROM   "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"
    WHERE  "partition_date_please_ignore" = '2015-02-20'
      AND  "reference_bases" IN ('AT','TA')
    GROUP BY "reference_bases"
), max_pos AS (                -- maximum coordinate per base
    SELECT "reference_bases",
           MAX("start_position") AS max_pos
    FROM   "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"
    WHERE  "partition_date_please_ignore" = '2015-02-20'
      AND  "reference_bases" IN ('AT','TA')
    GROUP BY "reference_bases"
), max_counts AS (             -- count records that occur at that max_pos
    SELECT p."reference_bases",
           p.max_pos,
           COUNT(*) AS max_cnt
    FROM   "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220" t
    JOIN   max_pos p
      ON   t."reference_bases" = p."reference_bases"
     AND   t."start_position"  = p.max_pos
    WHERE  t."partition_date_please_ignore" = '2015-02-20'
    GROUP BY p."reference_bases", p.max_pos
)
SELECT b."reference_bases",
       x.max_pos,
       x.max_cnt,
       b.total_cnt,
       (x.max_cnt / b.total_cnt)::FLOAT AS max_prop
FROM   base_counts b
JOIN   max_counts x USING ("reference_bases")
ORDER BY "reference_bases"
LIMIT 20
