```sql
-- 8) Proportion (rows_at_min / total_rows) for each reference_bases
WITH base_counts AS (
  SELECT "reference_bases", COUNT(*) AS total_cnt
  FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"
  WHERE "partition_date_please_ignore" = '2015-02-20'
    AND "reference_bases" IN ('AT','TA')
  GROUP BY "reference_bases"
),
min_counts AS (
  SELECT "reference_bases", MIN("start_position") AS min_pos, COUNT(*) AS min_cnt
  FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"
  WHERE "partition_date_please_ignore" = '2015-02-20'
    AND "reference_bases" IN ('AT','TA')
  GROUP BY "reference_bases", MIN("start_position")
)
SELECT b."reference_bases",
       m.min_pos,
       m.min_cnt,
       b.total_cnt,
       (m.min_cnt / b.total_cnt)::FLOAT AS min_prop
FROM base_counts b
JOIN min_counts m USING ("reference_bases")
LIMIT 20;
