Query:
--Description:  One‑stop summary for each reference base (‘AT’, ‘TA’) on
--              2015‑02‑20 showing:
--                • min & max start_positions
--                • how many rows occur at each extreme
--                • proportions of those counts w.r.t. total rows
WITH filtered AS (
    SELECT "reference_bases",
           "start_position"
    FROM   "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"
    WHERE  "partition_date_please_ignore" = '2015-02-20'
      AND  "reference_bases" IN ('AT','TA')
), stats AS (                  -- basic aggregates
    SELECT "reference_bases",
           COUNT(*)              AS total_cnt,
           MIN("start_position") AS min_pos,
           MAX("start_position") AS max_pos
    FROM   filtered
    GROUP BY "reference_bases"
), detail AS (                 -- count rows at min_pos / max_pos
    SELECT s."reference_bases",
           s.total_cnt,
           s.min_pos,
           s.max_pos,
           SUM(CASE WHEN f."start_position" = s.min_pos THEN 1 ELSE 0 END) AS min_cnt,
           SUM(CASE WHEN f."start_position" = s.max_pos THEN 1 ELSE 0 END) AS max_cnt
    FROM   stats s
    JOIN   filtered f
      ON   f."reference_bases" = s."reference_bases"
    GROUP BY s."reference_bases", s.total_cnt, s.min_pos, s.max_pos
)
SELECT "reference_bases",
       min_pos,
       min_cnt,
       (min_cnt / total_cnt)::FLOAT AS min_prop,
       max_pos,
       max_cnt,
       (max_cnt / total_cnt)::FLOAT AS max_prop,
       total_cnt
FROM   detail
ORDER BY "reference_bases"
LIMIT 20
