/*  Minimum / maximum start_position and their proportions
    for reference bases 'AT' and 'TA' (2015‑02‑20 partition)      */
WITH filtered AS (
    SELECT
        "reference_bases",
        "start_position"
    FROM  "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"
    WHERE "partition_date_please_ignore" = '2015-02-20'
      AND "reference_bases" IN ('AT','TA')
),
agg AS (          -- total, min and max positions per reference base
    SELECT
        "reference_bases"           AS ref_base,
        MIN("start_position")       AS min_start_pos,
        MAX("start_position")       AS max_start_pos,
        COUNT(*)                    AS total_cnt
    FROM filtered
    GROUP BY "reference_bases"
),
min_cnt AS (      -- how many rows occur at the min position
    SELECT f."reference_bases" AS ref_base,
           COUNT(*)            AS cnt_min
    FROM filtered f
    JOIN agg a
      ON a.ref_base = f."reference_bases"
     AND f."start_position" = a.min_start_pos
    GROUP BY f."reference_bases"
),
max_cnt AS (      -- how many rows occur at the max position
    SELECT f."reference_bases" AS ref_base,
           COUNT(*)            AS cnt_max
    FROM filtered f
    JOIN agg a
      ON a.ref_base = f."reference_bases"
