WITH stats AS (
    SELECT "reference_bases",
           MIN("start_position") AS "min_pos",
           MAX("start_position") AS "max_pos",
           COUNT(*)              AS "total_cnt"
    FROM   "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"
    WHERE  "partition_date_please_ignore" = '2015-02-20'
      AND  "reference_bases" IN ('AT','TA')
    GROUP BY "reference_bases"
),
cnt_min AS (
    SELECT "reference_bases",
           "start_position" AS "min_pos",
           COUNT(*) AS "cnt_at_min"
    FROM   "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"
    WHERE  "partition_date_please_ignore" = '2015-02-20'
      AND  "reference_bases" IN ('AT','TA')
    GROUP BY "reference_bases", "start_position"
),
cnt_max AS (
    SELECT "reference_bases",
           "start_position" AS "max_pos",
           COUNT(*) AS "cnt_at_max"
    FROM   "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"
    WHERE  "partition_date_please_ignore" = '2015-02-20'
      AND  "reference_bases" IN ('AT','TA')
    GROUP BY "reference_bases", "start_position"
)
SELECT s."reference_bases",
       s."min_pos",
       cm."cnt_at_min",
       cm."cnt_at_min"/s."total_cnt" AS "prop_min",
       s."max_pos",
       cM2."cnt_at_max",
       cM2."cnt_at_max"/s."total_cnt" AS "prop_max"
FROM   stats s
LEFT  JOIN cnt_min cm  ON cm."reference_bases" = s."reference_bases" AND cm."min_pos" = s."min_pos"
LEFT  JOIN cnt_max cM2 ON cM2."reference_bases" = s."reference_bases" AND cM2."max_pos" = s."max_pos"
LIMIT 20;
