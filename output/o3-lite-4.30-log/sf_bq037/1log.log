    min_start_pos,
    CAST(base_rows AS FLOAT) / all_rows  AS min_pos_proportion,
    max_start_pos,
    CAST(base_rows AS FLOAT) / all_rows  AS max_pos_proportion
FROM base_stats, total_rows
ORDER BY ref_base;
