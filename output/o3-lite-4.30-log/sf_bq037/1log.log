       MAX("start_position") AS "max_start_TA"
FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"
WHERE "partition_date_please_ignore" = '2015-02-20'
  AND "reference_bases" = 'TA';
```

```sql
--Description: 8) Proportion of 'AT' rows versus all rows from 2015‑02‑20.
WITH base_counts AS (
  SELECT COUNT(*) AS "total_rows",
         SUM(CASE WHEN "reference_bases" = 'AT' THEN 1 ELSE 0 END) AS "at_rows"
  FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"
  WHERE "partition_date_please_ignore" = '2015-02-20'
)
SELECT "at_rows"::FLOAT / "total_rows" AS "prop_AT"
FROM base_counts;
```

```sql
--Description: 9) Proportion of 'TA' rows versus all rows from 2015‑02‑20.
WITH base_counts AS (
  SELECT COUNT(*) AS "total_rows",
         SUM(CASE WHEN "reference_bases" = 'TA' THEN 1 ELSE 0 END) AS "ta_rows"
  FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"
  WHERE "partition_date_please_ignore" = '2015-02-20'
)
SELECT "ta_rows"::FLOAT / "total_rows" AS "prop_TA"
FROM base_counts;
```

```sql
--Description: 10) One‑shot query returning min & max start_position
--               plus row counts and proportions for 'AT' and 'TA'.
WITH stats AS (
  SELECT
        COUNT(*)                                                                    AS "total_rows",
        MIN("start_position")                                                       AS "overall_min",
        MAX("start_position")                                                       AS "overall_max",
        SUM(CASE WHEN "reference_bases" = 'AT' THEN 1 ELSE 0 END)                   AS "at_rows",
        MIN(CASE WHEN "reference_bases" = 'AT' THEN "start_position" END)           AS "min_start_AT",
        MAX(CASE WHEN "reference_bases" = 'AT' THEN "start_position" END)           AS "max_start_AT",
        SUM(CASE WHEN "reference_bases" = 'TA' THEN 1 ELSE 0 END)                   AS "ta_rows",
        MIN(CASE WHEN "reference_bases" = 'TA' THEN "start_position" END)           AS "min_start_TA",
        MAX(CASE WHEN "reference_bases" = 'TA' THEN "start_position" END)           AS "max_start_TA"
  FROM "HUMAN_GENOME_VARIANTS"."HUMAN_GENOME_VARIANTS"."_1000_GENOMES_PHASE_3_OPTIMIZED_SCHEMA_VARIANTS_20150220"
  WHERE "partition_date_please_ignore" = '2015-02-20'
)
SELECT
  "min_start_AT",
  "max_start_AT",
  "at_rows"::FLOAT / "total_rows" AS "prop_AT",
  "min_start_TA",
  "max_start_TA",
  "ta_rows"::FLOAT / "total_rows" AS "prop_TA"
FROM stats;
```

