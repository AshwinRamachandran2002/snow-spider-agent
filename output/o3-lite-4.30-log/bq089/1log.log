10 exploratory‑to‑final SQL statements (all limited to 20 rows)  

```sql
-- 1) Peek at a few California population rows (ACS table)
SELECT geo_id, do_date, total_pop
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE SUBSTR(geo_id,1,2) = '06'
LIMIT 20;
```

```sql
-- 2) Distinct ACS reference dates that exist for California
SELECT DISTINCT do_date
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE SUBSTR(geo_id,1,2) = '06'
ORDER BY do_date DESC
LIMIT 20;
```

```sql
-- 3) Pick the latest ACS population per California county
WITH latest AS (
  SELECT geo_id, total_pop,
         ROW_NUMBER() OVER(PARTITION BY geo_id ORDER BY do_date DESC) AS rn
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE SUBSTR(geo_id,1,2) = '06'
)
SELECT geo_id, total_pop
FROM latest
WHERE rn = 1
LIMIT 20;
```

```sql
-- 4) Sample vaccination‑site rows for California
SELECT facility_place_id, facility_sub_region_2_code AS geo_id,
       facility_name
FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
WHERE facility_country_region_code = 'US'
  AND facility_sub_region_1 = 'California'
LIMIT 20;
```

```sql
-- 5) Count distinct vaccine sites by California county
SELECT facility_sub_region_2_code AS geo_id,
       COUNT(DISTINCT facility_place_id) AS vaccine_sites
FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
WHERE facility_country_region_code = 'US'
  AND facility_sub_region_1 = 'California'
GROUP BY geo_id
ORDER BY vaccine_sites DESC
LIMIT 20;
```

```sql
-- 6) Combine latest population with site counts (inner join – counties with sites)
WITH latest_pop AS (
  SELECT geo_id, total_pop,
         ROW_NUMBER() OVER(PARTITION BY geo_id ORDER BY do_date DESC) AS rn
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE SUBSTR(geo_id,1,2) = '06'
), sites AS (
  SELECT facility_sub_region_2_code AS geo_id,
         COUNT(DISTINCT facility_place_id) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_country_region_code = 'US'
    AND facility_sub_region_1 = 'California'
  GROUP BY geo_id
)
SELECT p.geo_id, p.total_pop, s.vaccine_sites
FROM latest_pop p
JOIN sites s USING (geo_id)
WHERE p.rn = 1
LIMIT 20;
```

```sql
-- 7) Calculate vaccine sites per 1 000 people (inner join)
WITH latest_pop AS (
  SELECT geo_id, total_pop,
         ROW_NUMBER() OVER(PARTITION BY geo_id ORDER BY do_date DESC) AS rn
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE SUBSTR(geo_id,1,2) = '06'
), sites AS (
  SELECT facility_sub_region_2_code AS geo_id,
         COUNT(DISTINCT facility_place_id) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_country_region_code = 'US'
    AND facility_sub_region_1 = 'California'
  GROUP BY geo_id
)
SELECT p.geo_id,
       s.vaccine_sites,
       p.total_pop,
       ROUND(s.vaccine_sites * 1000 / p.total_pop, 3) AS sites_per_1000
FROM latest_pop p
JOIN sites s USING (geo_id)
WHERE p.rn = 1
ORDER BY sites_per_1000 DESC
LIMIT 20;
```

```sql
