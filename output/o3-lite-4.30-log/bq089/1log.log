Relevant columns and how they will be used  

bigquery-public-data.census_bureau_acs.county_2018_5yr  
• geo_id : 5‑digit county FIPS code – join key to vaccination table  
• do_date : the reference date for each ACS release – used for “latest” record per county  
• total_pop : total population – denominator for “sites per 1 000 people”  

bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all  
• facility_place_id : unique vaccination‑site identifier – used to count sites  
• facility_sub_region_1 : state name – filter to ‘California’  
• facility_sub_region_2_code : 5‑digit county FIPS – join key to ACS  
• facility_country_region_code : ISO‑country code – keep only ‘US’ records  

Typical conditions that will be applied  
• SUBSTR(geo_id,1,2)=‘06’  (California’s state FIPS)  
• facility_country_region_code='US'  
• facility_sub_region_1='California'  
• Get the row with max(do_date) per county to obtain “latest” population  

--------------------------------------------------------------------
10 exploratory‑to‑final SQL statements (all limited to 20 rows)  

```sql
-- 1) Peek at a few California population rows (ACS table)
SELECT geo_id, do_date, total_pop
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE SUBSTR(geo_id,1,2) = '06'
LIMIT 20;
```

```sql
-- 2) Distinct ACS reference dates that exist for California
SELECT DISTINCT do_date
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE SUBSTR(geo_id,1,2) = '06'
ORDER BY do_date DESC
LIMIT 20;
```

```sql
-- 3) Pick the latest ACS population per California county
WITH latest AS (
  SELECT geo_id, total_pop,
         ROW_NUMBER() OVER(PARTITION BY geo_id ORDER BY do_date DESC) AS rn
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE SUBSTR(geo_id,1,2) = '06'
)
SELECT geo_id, total_pop
FROM latest
WHERE rn = 1
LIMIT 20;
```

```sql
-- 4) Sample vaccination‑site rows for California
SELECT facility_place_id, facility_sub_region_2_code AS geo_id,
       facility_name
FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
WHERE facility_country_region_code = 'US'
  AND facility_sub_region_1 = 'California'
LIMIT 20;
```

```sql
-- 5) Count distinct vaccine sites by California county
SELECT facility_sub_region_2_code AS geo_id,
       COUNT(DISTINCT facility_place_id) AS vaccine_sites
FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
WHERE facility_country_region_code = 'US'
  AND facility_sub_region_1 = 'California'
GROUP BY geo_id
ORDER BY vaccine_sites DESC
LIMIT 20;
```

```sql
-- 6) Combine latest population with site counts (inner join – counties with sites)
WITH latest_pop AS (
  SELECT geo_id, total_pop,
         ROW_NUMBER() OVER(PARTITION BY geo_id ORDER BY do_date DESC) AS rn
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE SUBSTR(geo_id,1,2) = '06'
), sites AS (
  SELECT facility_sub_region_2_code AS geo_id,
         COUNT(DISTINCT facility_place_id) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_country_region_code = 'US'
    AND facility_sub_region_1 = 'California'
  GROUP BY geo_id
)
SELECT p.geo_id, p.total_pop, s.vaccine_sites
FROM latest_pop p
JOIN sites s USING (geo_id)
WHERE p.rn = 1
LIMIT 20;
```

```sql
-- 7) Calculate vaccine sites per 1 000 people (inner join)
WITH latest_pop AS (
  SELECT geo_id, total_pop,
         ROW_NUMBER() OVER(PARTITION BY geo_id ORDER BY do_date DESC) AS rn
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE SUBSTR(geo_id,1,2) = '06'
), sites AS (
  SELECT facility_sub_region_2_code AS geo_id,
         COUNT(DISTINCT facility_place_id) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_country_region_code = 'US'
    AND facility_sub_region_1 = 'California'
  GROUP BY geo_id
)
SELECT p.geo_id,
       s.vaccine_sites,
       p.total_pop,
       ROUND(s.vaccine_sites * 1000 / p.total_pop, 3) AS sites_per_1000
FROM latest_pop p
JOIN sites s USING (geo_id)
WHERE p.rn = 1
ORDER BY sites_per_1000 DESC
LIMIT 20;
```

```sql
-- 8) Same as #7 but include counties with zero sites (LEFT JOIN)
WITH latest_pop AS (
  SELECT geo_id, total_pop,
         ROW_NUMBER() OVER(PARTITION BY geo_id ORDER BY do_date DESC) AS rn
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE SUBSTR(geo_id,1,2) = '06'
)
SELECT p.geo_id,
       IFNULL(s.vaccine_sites, 0) AS vaccine_sites,
       p.total_pop,
       ROUND(IFNULL(s.vaccine_sites, 0) * 1000 / p.total_pop, 3) AS sites_per_1000
FROM latest_pop p
LEFT JOIN (
  SELECT facility_sub_region_2_code AS geo_id,
         COUNT(DISTINCT facility_place_id) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_country_region_code = 'US'
    AND facility_sub_region_1 = 'California'
  GROUP BY geo_id
) s
USING (geo_id)
WHERE p.rn = 1
ORDER BY sites_per_1000 DESC
LIMIT 20;
```

```sql
-- 9) Display county name (from vaccination table) + metric, keeping one row per county
WITH latest_pop AS (
  SELECT geo_id, total_pop,
         ROW_NUMBER() OVER(PARTITION BY geo_id ORDER BY do_date DESC) AS rn
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE SUBSTR(geo_id,1,2) = '06'
), sites AS (
  SELECT facility_sub_region_2_code AS geo_id,
         ANY_VALUE(facility_sub_region_2) AS county_name,
         COUNT(DISTINCT facility_place_id) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_country_region_code = 'US'
    AND facility_sub_region_1 = 'California'
  GROUP BY geo_id
)
SELECT s.county_name, p.geo_id,
       s.vaccine_sites,
       p.total_pop,
       ROUND(s.vaccine_sites * 1000 / p.total_pop, 3) AS sites_per_1000
FROM latest_pop p
JOIN sites s USING (geo_id)
WHERE p.rn = 1
ORDER BY sites_per_1000 DESC
LIMIT 20;
```

```sql
-- 10) Final: vaccine sites per 1 000 population for every California county (all counties)
WITH latest_pop AS (
  SELECT geo_id, total_pop,
         ROW_NUMBER() OVER(PARTITION BY geo_id ORDER BY do_date DESC) AS rn
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE SUBSTR(geo_id,1,2) = '06'
), sites AS (
  SELECT facility_sub_region_2_code AS geo_id,
         ANY_VALUE(facility_sub_region_2) AS county_name,
         COUNT(DISTINCT facility_place_id) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_country_region_code = 'US'
    AND facility_sub_region_1 = 'California'
  GROUP BY geo_id
)
SELECT COALESCE(s.county_name, 'Unknown County') AS county_name,
       p.geo_id,
       IFNULL(s.vaccine_sites, 0)        AS vaccine_sites,
       p.total_pop,
       ROUND(IFNULL(s.vaccine_sites, 0) * 1000 / p.total_pop, 3) AS sites_per_1000
FROM latest_pop p
LEFT JOIN sites s USING (geo_id)
WHERE p.rn = 1
ORDER BY sites_per_1000 DESC
LIMIT 20;
```
