  WHERE facility_country_region_code = 'US'
    AND facility_sub_region_1 = 'California'
  GROUP BY geo_id
) s
USING (geo_id)
WHERE p.rn = 1
ORDER BY sites_per_1000 DESC
LIMIT 20;
```

