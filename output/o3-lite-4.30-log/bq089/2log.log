--Description: Final result – vaccination‑site density for every California county.
--             Uses LEFT JOIN (so counties with zero sites still appear) and groups on
--             actual columns rather than aliases to avoid GROUP BY errors.
SELECT
  a.geo_id                                                     AS county_fips,
  a.total_pop,
  COUNT(DISTINCT v.facility_place_id)                          AS site_count,
  ROUND(1000 * COUNT(DISTINCT v.facility_place_id) / a.total_pop, 3)
                                                              AS sites_per_1000_pop
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`  AS a
LEFT JOIN `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all` AS v
       ON a.geo_id = v.facility_sub_region_2_code
WHERE a.geo_id LIKE '06%'                -- California counties
GROUP BY a.geo_id, a.total_pop
ORDER BY county_fips
LIMIT 20
