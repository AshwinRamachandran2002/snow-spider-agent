    month,
    MAX(IF(purchase_flag = 'purchase',     avg_pageviews, NULL)) AS avg_pageviews_purchase,
    MAX(IF(purchase_flag = 'non_purchase', avg_pageviews, NULL)) AS avg_pageviews_non_purchase
FROM avg_pageviews
GROUP BY month
ORDER BY month;
