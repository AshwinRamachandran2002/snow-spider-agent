--Description:
-- The four queries below (#7 – #10) are rewritten so that any CASE / purchase_flag
-- logic that relies on aggregated values is done **after** the aggregation step.
-- This removes the previous “aggregation function not allowed in GROUP BY” error.
-- Each query keeps its original purpose (June averages, July averages, raw union,
-- and the final side‑by‑side result).

/* ---------- 7. Average June page‑views per visitor (purchase vs non‑purchase) ---------- */
WITH visitor_june AS (
  SELECT
    fullVisitorId,
    SUM(totals.pageviews)    AS june_pageviews,
    SUM(totals.transactions) AS total_transactions
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20170601' AND '20170630'
    AND totals.pageviews IS NOT NULL
  GROUP BY fullVisitorId
)
SELECT
  CASE WHEN total_transactions >= 1 THEN 'purchase' ELSE 'non_purchase' END AS purchase_flag,
  AVG(june_pageviews) AS avg_pageviews_per_visitor
FROM visitor_june
GROUP BY purchase_flag
LIMIT 20
