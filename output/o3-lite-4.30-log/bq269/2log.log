-- is needed.
--
-- Steps
-- 1. Inner query (alias m):
--      • Filter to June‑2017 tables only        → _TABLE_SUFFIX BETWEEN '20170601' AND '20170630'
--      • Keep sessions that have pageviews      → totals.pageviews IS NOT NULL
--      • Group by fullVisitorId
--      • Sum(pageviews)  → total_pageviews per visitor
--      • Sum(transactions) → total_transactions per visitor
-- 2. Outer query:
--      • Derive purchase_flag: if total_transactions ≥ 1 → 'purchase', else 'non_purchase'
--      • Return visitor id, flag, and summed pageviews.
-- 3. LIMIT 20 for a quick sanity check.
SELECT
  fullVisitorId,
  CASE WHEN total_transactions >= 1 THEN 'purchase' ELSE 'non_purchase' END AS purchase_flag,
  total_pageviews AS june_pageviews
FROM (
  SELECT
    fullVisitorId,
    SUM(totals.pageviews)    AS total_pageviews,
