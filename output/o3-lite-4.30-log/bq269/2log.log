Begin Exploring Related Columns
Relevant columns and why we need them  
• `fullVisitorId`: the unique visitor key that lets us aggregate page‑views per visitor.  
• `totals.pageviews`: number of page‑views in a session; we keep only sessions where it is NOT NULL and later sum it.  
• `totals.transactions`: number of transactions in a session; if ≥1 the session is a “purchase”, otherwise “non_purchase”.  
• `date` (or `_TABLE_SUFFIX`): session date (YYYYMMDD).  We restrict to 20170601–20170731 and also turn it into a month flag (`2017‑06`, `2017‑07`).  

Typical filter / helper conditions  
```
WHERE _TABLE_SUFFIX BETWEEN '20170601' AND '20170731'          -- June & July 2017 only
  AND totals.pageviews IS NOT NULL                             -- sessions that have pageviews
```
Purchase classification  
```
CASE WHEN totals.transactions >= 1 THEN 'purchase'
     ELSE 'non_purchase' END AS purchase_flag
```

Below are ten exploration queries that move from very simple inspection to the final answer.  
(Every query is self‑contained, uses only the allowed tables, and is limited to 20 rows so it is “safe to run”.)

```sql
-- 1. Peek at a single day (July 10 2017): show pageviews & transactions
SELECT
  fullVisitorId,
  totals.pageviews                 AS pageviews,
  totals.transactions              AS transactions
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170710`
LIMIT 20;
```

```sql
-- 2. Count sessions that have non‑null pageviews on the same day
SELECT
  COUNT(1) AS sessions_with_pageviews
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170710`
WHERE totals.pageviews IS NOT NULL;
```

```sql
-- 3. See how many of those sessions contained a transaction
SELECT
  CASE WHEN totals.transactions >= 1 THEN 'purchase' ELSE 'non_purchase' END AS purchase_flag,
  COUNT(1) AS sessions
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170710`
WHERE totals.pageviews IS NOT NULL
GROUP BY purchase_flag
LIMIT 20;
```

```sql
-- 4. Inspect the first 20 June‑2017 sessions after classifying them
SELECT
  _TABLE_SUFFIX                              AS table_day,
  fullVisitorId,
  totals.pageviews                           AS pageviews,
  CASE WHEN totals.transactions >= 1 THEN 'purchase' ELSE 'non_purchase' END AS purchase_flag
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
WHERE _TABLE_SUFFIX BETWEEN '20170601' AND '20170630'
  AND totals.pageviews IS NOT NULL
LIMIT 20;
```

```sql
-- 5. Distinct visitors and their total June pageviews (all sessions collapsed)
SELECT
  fullVisitorId,
  SUM(totals.pageviews) AS june_pageviews
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
WHERE _TABLE_SUFFIX BETWEEN '20170601' AND '20170630'
  AND totals.pageviews IS NOT NULL
GROUP BY fullVisitorId
LIMIT 20;
```

```sql
-- 6. Same as #5, but split into purchase / non‑purchase groups
SELECT
  fullVisitorId,
  CASE WHEN SUM(totals.transactions) >= 1 THEN 'purchase' ELSE 'non_purchase' END AS purchase_flag,
  SUM(totals.pageviews) AS june_pageviews
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
WHERE _TABLE_SUFFIX BETWEEN '20170601' AND '20170630'
  AND totals.pageviews IS NOT NULL
GROUP BY fullVisitorId, purchase_flag
LIMIT 20;
```

```sql
-- 7. Average June pageviews per visitor inside each group
SELECT
  purchase_flag,
  AVG(june_pageviews) AS avg_pageviews_per_visitor
FROM (
  SELECT
    fullVisitorId,
    CASE WHEN SUM(totals.transactions) >= 1 THEN 'purchase' ELSE 'non_purchase' END AS purchase_flag,
    SUM(totals.pageviews) AS june_pageviews
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20170601' AND '20170630'
    AND totals.pageviews IS NOT NULL
  GROUP BY fullVisitorId, purchase_flag
)
GROUP BY purchase_flag
LIMIT 20;
```

```sql
-- 8. Repeat the same aggregation for July (quick check)
SELECT
  purchase_flag,
  AVG(july_pageviews) AS avg_pageviews_per_visitor
FROM (
  SELECT
    fullVisitorId,
    CASE WHEN SUM(totals.transactions) >= 1 THEN 'purchase' ELSE 'non_purchase' END AS purchase_flag,
    SUM(totals.pageviews) AS july_pageviews
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20170701' AND '20170731'
    AND totals.pageviews IS NOT NULL
  GROUP BY fullVisitorId, purchase_flag
)
GROUP BY purchase_flag
LIMIT 20;
```

```sql
-- 9. Prepare one unioned set for BOTH months with a month flag
SELECT
  FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS month,
  fullVisitorId,
  totals.pageviews,
  totals.transactions
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
WHERE _TABLE_SUFFIX BETWEEN '20170601' AND '20170731'
  AND totals.pageviews IS NOT NULL
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER – average pageviews per visitor for purchase vs non‑purchase, by month
WITH sessions AS (
  SELECT
    FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS month,
    fullVisitorId,
    totals.pageviews                                    AS pageviews,
    totals.transactions                                 AS transactions
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20170601' AND '20170731'
    AND totals.pageviews IS NOT NULL
),
classified AS (
  SELECT
    month,
    fullVisitorId,
    pageviews,
    CASE WHEN transactions >= 1 THEN 'purchase' ELSE 'non_purchase' END AS purchase_flag
  FROM sessions
),
per_visitor AS (
  SELECT
    month,
    fullVisitorId,
    purchase_flag,
    SUM(pageviews) AS total_pageviews
  FROM classified
  GROUP BY month, fullVisitorId, purchase_flag
),
avg_per_visitor AS (
  SELECT
    month,
    purchase_flag,
    AVG(total_pageviews) AS avg_pageviews
  FROM per_visitor
  GROUP BY month, purchase_flag
)
SELECT
  month,
  MAX(IF(purchase_flag = 'purchase',     avg_pageviews, NULL)) AS avg_pageviews_purchase,
  MAX(IF(purchase_flag = 'non_purchase', avg_pageviews, NULL)) AS avg_pageviews_non_purchase
FROM avg_per_visitor
GROUP BY month
ORDER BY month
LIMIT 20;
```
The last query delivers one row per month (2017‑06 and 2017‑07) and shows, side by side, the average number of page‑views each visitor generated in purchase sessions versus non‑purchase sessions.
