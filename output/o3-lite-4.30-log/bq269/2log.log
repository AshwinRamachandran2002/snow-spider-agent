```sql
--Description:
-- The four queries below (#7 – #10) are rewritten so that any CASE / purchase_flag
-- logic that relies on aggregated values is done **after** the aggregation step.
-- This removes the previous “aggregation function not allowed in GROUP BY” error.
-- Each query keeps its original purpose (June averages, July averages, raw union,
-- and the final side‑by‑side result).

/* ---------- 7. Average June page‑views per visitor (purchase vs non‑purchase) ---------- */
WITH visitor_june AS (
  SELECT
    fullVisitorId,
    SUM(totals.pageviews)    AS june_pageviews,
    SUM(totals.transactions) AS total_transactions
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20170601' AND '20170630'
    AND totals.pageviews IS NOT NULL
  GROUP BY fullVisitorId
)
SELECT
  CASE WHEN total_transactions >= 1 THEN 'purchase' ELSE 'non_purchase' END AS purchase_flag,
  AVG(june_pageviews) AS avg_pageviews_per_visitor
FROM visitor_june
GROUP BY purchase_flag
LIMIT 20;

/* ---------- 8. Same calculation for July 2017 ---------- */
WITH visitor_july AS (
  SELECT
    fullVisitorId,
    SUM(totals.pageviews)    AS july_pageviews,
    SUM(totals.transactions) AS total_transactions
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20170701' AND '20170731'
    AND totals.pageviews IS NOT NULL
  GROUP BY fullVisitorId
)
SELECT
  CASE WHEN total_transactions >= 1 THEN 'purchase' ELSE 'non_purchase' END AS purchase_flag,
  AVG(july_pageviews) AS avg_pageviews_per_visitor
FROM visitor_july
GROUP BY purchase_flag
LIMIT 20;

/* ---------- 9. Unioned session‑level set for both months ---------- */
SELECT
  FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS month,
  fullVisitorId,
  totals.pageviews,
  totals.transactions
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
WHERE _TABLE_SUFFIX BETWEEN '20170601' AND '20170731'
  AND totals.pageviews IS NOT NULL
LIMIT 20;

/* ---------- 10. Final answer – side‑by‑side monthly averages ---------- */
WITH sessions AS (
  SELECT
    FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS month,
    fullVisitorId,
    totals.pageviews     AS pageviews,
    totals.transactions  AS transactions
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20170601' AND '20170731'
    AND totals.pageviews IS NOT NULL
),
per_visitor AS (
  -- collapse all sessions of a visitor inside a month
  SELECT
    month,
    fullVisitorId,
    SUM(pageviews)      AS total_pageviews,
    SUM(transactions)   AS total_transactions
  FROM sessions
  GROUP BY month, fullVisitorId
),
avg_per_visitor AS (
  -- average those totals across visitors, split by purchase / non‑purchase
  SELECT
    month,
    CASE WHEN total_transactions >= 1 THEN 'purchase' ELSE 'non_purchase' END AS purchase_flag,
    AVG(total_pageviews) AS avg_pageviews
  FROM per_visitor
  GROUP BY month, purchase_flag
)
SELECT
  month,
  MAX(IF(purchase_flag = 'purchase',     avg_pageviews, NULL)) AS avg_pageviews_purchase,
  MAX(IF(purchase_flag = 'non_purchase', avg_pageviews, NULL)) AS avg_pageviews_non_purchase
FROM avg_per_visitor
GROUP BY month
ORDER BY month
LIMIT 20;
```
