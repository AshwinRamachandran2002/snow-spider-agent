),

/* ----------  average page‑views per visitor within each month‑class  ---------- */
avg_pageviews AS (
    SELECT
        month,
        purchase_flag,
        AVG(total_pageviews) AS avg_pageviews
    FROM visitor_monthly
    GROUP BY month, purchase_flag
)

/* ----------  side‑by‑side result with four‑decimal precision  ---------- */
SELECT
    month,
    ROUND(MAX(IF(purchase_flag = 'purchase',     avg_pageviews, NULL)), 4) AS avg_pageviews_purchase,
    ROUND(MAX(IF(purchase_flag = 'non_purchase', avg_pageviews, NULL)), 4) AS avg_pageviews_non_purchase
FROM avg_pageviews
GROUP BY month
ORDER BY month;
