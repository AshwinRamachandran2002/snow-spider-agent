2025-05-01 01:57:55 - Thread-603 (execute) - INFO - [Exploration]
column name : potential usage  
• PACKAGEVERSIONS."System" : Identify the ecosystem ( NPM, Maven, NuGet, …) for every package version.  
• PACKAGEVERSIONS."Licenses" : Variant array that lists one‑or‑many license strings attached to each package version; needs FLATTEN to read.  
• PACKAGEVERSIONS."SnapshotAt" : Lets you restrict to a specific snapshot timestamp (latest, a point‑in‑time, etc.).  
• PACKAGEVERSIONS."Name" / "Version" : Helpful for debugging which package carries which license.  
• PROJECTS."Licenses" : Alternative source if you want to compare project‑level licences to package‑level ones (optional for the task).  

Below are 10 incremental Snowflake SQL snippets (each limited to 20 rows) that progressively explore the data and finally rank the most frequently used license per system.

```sql
-- 1) Peek at a handful of PACKAGEVERSIONS rows
SELECT 
  "SnapshotAt",
  "System",
  "Name",
  "Version",
  "Licenses"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
LIMIT 20;
```

```sql
-- 2) List the distinct package ecosystems (systems)
SELECT DISTINCT 
  "System"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
LIMIT 20;
```

```sql
-- 3) Inspect raw licenses for one system (example: NPM)
SELECT 
  "System",
  "Name",
  "Version",
  "Licenses"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
WHERE "System" = 'NPM'
LIMIT 20;
```

```sql
-- 4) Flatten the "Licenses" array into one row per license string
SELECT 
  pv."System",
  pv."Name",
  pv."Version",
  f.value::STRING AS "License"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
     LATERAL FLATTEN(INPUT => pv."Licenses") f
LIMIT 20;
```

```sql
-- 5) Show all distinct license identifiers that appear after flattening
SELECT DISTINCT 
  f.value::STRING AS "License"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
     LATERAL FLATTEN(INPUT => pv."Licenses") f
LIMIT 20;
```

```sql
-- 6) Count how many package versions carry each license (across all systems)
SELECT 
  f.value::STRING AS "License",
  COUNT(*)           AS "PackageVersionsWithLicense"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
     LATERAL FLATTEN(INPUT => pv."Licenses") f
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 7) Count license usage per ecosystem (system / license pair)
SELECT 
  pv."System",
  f.value::STRING AS "License",
  COUNT(*)        AS "PackageVersionCount"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
     LATERAL FLATTEN(INPUT => pv."Licenses") f
GROUP BY 1, 2
ORDER BY 1, 3 DESC
LIMIT 20;
```

```sql
-- 8) Rank licenses inside each system by frequency using window functions
SELECT
  "System",
  "License",
  "PackageVersionCount",
  ROW_NUMBER() OVER (PARTITION BY "System" ORDER BY "PackageVersionCount" DESC) AS "RankInSystem"
FROM (
  SELECT 
    pv."System",
    f.value::STRING AS "License",
    COUNT(*) AS "PackageVersionCount"
  FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
       LATERAL FLATTEN(INPUT => pv."Licenses") f
  GROUP BY 1, 2
) ranked
ORDER BY "System", "RankInSystem"
LIMIT 20;
```

```sql
-- 9) Filter out null / empty license entries before ranking
SELECT
  "System",
  "License",
  "PackageVersionCount",
  ROW_NUMBER() OVER (PARTITION BY "System" ORDER BY "PackageVersionCount" DESC) AS "RankInSystem"
FROM (
  SELECT 
    pv."System",
    f.value::STRING AS "License",
    COUNT(*) AS "PackageVersionCount"
  FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
       LATERAL FLATTEN(INPUT => pv."Licenses") f
  WHERE f.value IS NOT NULL
  GROUP BY 1, 2
) ranked
ORDER BY "System", "RankInSystem"
LIMIT 20;
```

```sql
-- 10) Final query: pick the single most‑frequent license in each ecosystem
SELECT
  "System",
  "License",
  "PackageVersionCount"
FROM (
  SELECT
    pv."System",
    f.value::STRING AS "License",
    COUNT(*) AS "PackageVersionCount",
    ROW_NUMBER() OVER (PARTITION BY pv."System" ORDER BY COUNT(*) DESC) AS rn
  FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
       LATERAL FLATTEN(INPUT => pv."Licenses") f
  WHERE f.value IS NOT NULL
  GROUP BY 1, 2
) sub
WHERE rn = 1
ORDER BY "System"
LIMIT 20;
```
