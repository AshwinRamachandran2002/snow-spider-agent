Query:
-- 10) Final query: pick the single most‑frequent license in each ecosystem
SELECT
  "System",
  "License",
  "PackageVersionCount"
FROM (
  SELECT
    pv."System",
    f.value::STRING AS "License",
    COUNT(*) AS "PackageVersionCount",
    ROW_NUMBER() OVER (PARTITION BY pv."System" ORDER BY COUNT(*) DESC) AS rn
  FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
       LATERAL FLATTEN(INPUT => pv."Licenses") f
  WHERE f.value IS NOT NULL
  GROUP BY 1, 2
) sub
WHERE rn = 1
ORDER BY "System"
LIMIT 20;
