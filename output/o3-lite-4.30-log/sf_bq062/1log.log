--Because LATERAL FLATTEN produces zero rows for empty arrays, it is sufficient
--to filter out only rows where "Licenses" IS NULL; no additional ARRAY_SIZE()
--check is required.  We count how often each flattened license string appears,
--apply ROW_NUMBER() to pick the top one per "System", and list the result
--sorted alphabetically by ecosystem.
SELECT
    "System",
    "License",
    "Occurrences"
FROM (
        SELECT
            pv."System",
            l.value::STRING AS "License",
            COUNT(*)                               AS "Occurrences",
            ROW_NUMBER() OVER (PARTITION BY pv."System"
                               ORDER BY COUNT(*) DESC) AS rn
        FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" pv,
             LATERAL FLATTEN(input => pv."Licenses") l
        WHERE pv."Licenses" IS NOT NULL
        GROUP BY pv."System", l.value::STRING
     )
WHERE rn = 1
ORDER BY "System"
LIMIT 20;
```
