The table structure information is ({database name: {schema name: [table name]}}): 
{'DEPS_DEV_V1': {'DEPS_DEV_V1': ['PACKAGEVERSIONTOPROJECT', 'PROJECTS', 'NUGETREQUIREMENTS', 'DEPENDENCYGRAPHEDGES', 'PACKAGEVERSIONS', 'SNAPSHOTS', 'ADVISORIES', 'DEPENDENTS', 'PACKAGEVERSIONHASHES', 'DEPENDENCIES']}}
Begin Exploring Related Columns
Relevant columns & their use for this task  
• "System": discriminator for the ecosystem (NPM, MAVEN, …).  
• "Name": package identifier – used to count **distinct packages** so one package that has many versions is not over‑counted.  
• "Licenses": VARIANT array that lists every license detected for a (system , name , version) row.  
• Conditions often useful  
  – WHERE "Licenses" IS NOT NULL  
  – LATERAL FLATTEN( input => "Licenses") f to turn the JSON array into one row per license string.  
  – GROUP BY "System", license_value to count frequency.  
  – QUALIFY ROW_NUMBER() … = 1 to keep only the most‑frequent license per system.  

Below are ten exploratory → increasingly complex Snowflake SQL queries (all limited to 20 rows) that surface the information needed.

```sql
-- 1. Quick peek: show sample licenses stored with a few package versions
SELECT "System",
       "Name",
       "Version",
       "Licenses"
FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
LIMIT  20;
```

```sql
-- 2. Flatten the array so each license is on its own row (sample)
SELECT pv."System",
       pv."Name",
       pv."Version",
       f.value::STRING AS "License"
FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
       LATERAL FLATTEN(input => pv."Licenses") f
LIMIT  20;
```

```sql
-- 3. Distinct list of licenses per system (sample)
SELECT DISTINCT pv."System",
                f.value::STRING AS "License"
FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
       LATERAL FLATTEN(input => pv."Licenses") f
LIMIT  20;
```

```sql
-- 4. Count how many (system,name,version) rows carry each license
SELECT pv."System",
       f.value::STRING AS "License",
       COUNT(*)        AS "Occurrences"
FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
       LATERAL FLATTEN(input => pv."Licenses") f
GROUP  BY pv."System", f.value::STRING
ORDER  BY pv."System", "Occurrences" DESC
LIMIT  20;
```

```sql
-- 5. Same as #4 but counting UNIQUE packages (system,name) to avoid multiple versions
SELECT pv."System",
       f.value::STRING AS "License",
       COUNT(DISTINCT pv."Name") AS "Packages"
FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
       LATERAL FLATTEN(input => pv."Licenses") f
GROUP  BY pv."System", f.value::STRING
ORDER  BY pv."System", "Packages" DESC
LIMIT  20;
```

```sql
-- 6. For every system, list licenses ordered by frequency of DISTINCT packages
SELECT pv."System",
       f.value::STRING AS "License",
       COUNT(DISTINCT pv."Name") AS "Packages"
FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
       LATERAL FLATTEN(input => pv."Licenses") f
GROUP  BY pv."System", f.value::STRING
ORDER  BY pv."System", "Packages" DESC, "License"
LIMIT  20;
```

```sql
-- 7. Keep only the most‑frequent license per system (ties kept) – still limited to 20
SELECT *
FROM  (
  SELECT pv."System",
         f.value::STRING AS "License",
         COUNT(DISTINCT pv."Name") AS "Packages",
         ROW_NUMBER() OVER (PARTITION BY pv."System" ORDER BY COUNT(DISTINCT pv."Name") DESC) AS rn
  FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
         LATERAL FLATTEN(input => pv."Licenses") f
  GROUP  BY pv."System", f.value::STRING
)
WHERE  rn = 1
LIMIT 20;
```

```sql
-- 8. Same as #7 but using QUALIFY instead of sub‑query
SELECT pv."System",
       f.value::STRING AS "License",
       COUNT(DISTINCT pv."Name") AS "Packages"
FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
       LATERAL FLATTEN(input => pv."Licenses") f
GROUP  BY pv."System", f.value::STRING
QUALIFY ROW_NUMBER() OVER (PARTITION BY pv."System" ORDER BY COUNT(DISTINCT pv."Name") DESC) = 1
LIMIT 20;
```

```sql
-- 9. Show systems / packages whose license array is empty or NULL
SELECT "System",
       "Name",
       "Version",
       "Licenses"
FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
WHERE  "Licenses" IS NULL
   OR  ARRAY_SIZE("Licenses") = 0
LIMIT 20;
```

```sql
-- 10. FINAL analytical query: most‑frequent license by packages for each system
SELECT pv."System",
       f.value::STRING AS "Most_Frequent_License",
       COUNT(DISTINCT pv."Name") AS "Package_Count"
FROM   DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
       LATERAL FLATTEN(input => pv."Licenses") f
GROUP  BY pv."System", f.value::STRING
QUALIFY ROW_NUMBER() OVER (PARTITION BY pv."System" ORDER BY COUNT(DISTINCT pv."Name") DESC) = 1
LIMIT 20;
```
