--Description: Purchase date & status for a sample of toy orders.
SELECT DISTINCT o."order_id",
       o."order_purchase_timestamp",
       o."order_status"
FROM "orders"                 AS o
JOIN "order_items"            AS oi ON o."order_id" = oi."order_id"
JOIN "products"               AS pr ON oi."product_id" = pr."product_id"
JOIN "product_category_name_translation" AS tr
  ON pr."product_category_name" = tr."product_category_name"
WHERE tr."product_category_name_english" LIKE '%toy%'
LIMIT 20;
