--Description / Thinking process:
-- We need to understand up to which date toy sales exist, because our earlier query
-- (1‑10 Dec 2018) returned no rows.  To do that, we:
--   • join products → translation to isolate the Portuguese category “brinquedos” (toys);
--   • join order_items → orders to know purchase timestamps;
--   • aggregate by calendar date and count toy order‑lines;
--   • sort by date descending to reveal the most recent days that actually contain toy sales.
-- Showing only 20 rows is enough to identify the dataset’s tail.

SELECT
    DATE(o."order_purchase_timestamp") AS "order_date",
    COUNT(oi."order_item_id")          AS "toy_items_sold"
FROM "orders"              AS o
JOIN "order_items"         AS oi ON oi."order_id" = o."order_id"
JOIN "products"            AS pr ON pr."product_id" = oi."product_id"
JOIN "product_category_name_translation" AS tr
     ON tr."product_category_name" = pr."product_category_name"
WHERE tr."product_category_name_english" LIKE '%toy%'    -- keep only toy items
GROUP BY DATE(o."order_purchase_timestamp")
ORDER BY "order_date" DESC
LIMIT 20;
```
