--Description:  Sum the four centred 5‑day moving averages for 05‑Dec‑2018
--              through 08‑Dec‑2018.  We insert the real regression parameters
--              (slope = 0.004580261047945885, intercept = 5.59962257176278),
--              predict ŷ for the four dates, create the symmetric 5‑day window
--              around each date, average the neighbouring predictions, and
--              finally add up the four moving‑average values.
WITH
params AS (                    -- regression coefficients
    SELECT 0.004580261047945885 AS slope,
           5.59962257176278     AS intercept
),
forecast(d) AS (               -- target dates
    VALUES ('2018-12-05'),
           ('2018-12-06'),
           ('2018-12-07'),
           ('2018-12-08')
),
predicted AS (                 -- ŷ = slope·x + intercept
    SELECT DATE(d) AS sale_date,
           p.slope * (julianday(d) - julianday('2017-01-01')) + p.intercept AS y_hat
    FROM   forecast
    CROSS  JOIN params p
),
win AS (                       -- centred 5‑day moving average
    SELECT p1.sale_date,
           AVG(p2.y_hat) AS mov_avg_5d
    FROM   predicted p1
    JOIN   predicted p2
         ON julianday(p2.sale_date)
            BETWEEN julianday(p1.sale_date,'-2 day')
                AND  julianday(p1.sale_date,'+2 day')
    GROUP  BY p1.sale_date
)
SELECT SUM(mov_avg_5d) AS sum_of_four_moving_avgs
FROM   win
