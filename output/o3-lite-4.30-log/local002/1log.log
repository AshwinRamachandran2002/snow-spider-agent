```sql
--Description / thinking process:
-- • We already computed the linear‑regression parameters on the historical
--   (2017‑01‑01 – 2018‑08‑29) daily toy‑sales series:
--       slope     = 0.004580261047945885
--       intercept = 5.59962257176278
-- • Let d be any of our four target dates (05‑Dec‑2018 → 08‑Dec‑2018).
--   x = julianday(d) − julianday('2017‑01‑01') counts how many days have passed
--   since the origin; ŷ = slope·x + intercept is the predicted number of toy sales.
-- • A centred 5‑day moving average (MA₅) for each target date averages the
--   predictions for that date and the two days before / after it.
--   Because we predict only those four dates, every window contains exactly
--   the subset of forecasts that fall within ±2 days of its centre.
-- • The outermost SELECT shows each date with its MA₅ and—in the same row—
--   the grand total of the four MA₅ values (the quantity requested in the task).
WITH
params AS (                     -- regression coefficients
    SELECT 0.004580261047945885 AS slope,
           5.59962257176278     AS intercept
),
forecast(d) AS (                -- the four forecast days
    VALUES ('2018-12-05'),
           ('2018-12-06'),
           ('2018-12-07'),
           ('2018-12-08')
),
predicted AS (                  -- ŷ for every date
    SELECT DATE(d) AS sale_date,
           p.slope * (julianday(d) - julianday('2017-01-01')) + p.intercept AS y_hat
    FROM   forecast
    CROSS  JOIN params AS p
),
win AS (                        -- centred 5‑day moving average
    SELECT p1.sale_date,
           AVG(p2.y_hat) AS mov_avg_5d
    FROM   predicted AS p1
    JOIN   predicted AS p2
      ON julianday(p2.sale_date)
         BETWEEN julianday(p1.sale_date,'-2 day')
             AND  julianday(p1.sale_date,'+2 day')
    GROUP  BY p1.sale_date
)
SELECT w.sale_date,
       w.mov_avg_5d,
       (SELECT SUM(mov_avg_5d) FROM win) AS sum_of_four_moving_avgs
FROM   win AS w;
```
