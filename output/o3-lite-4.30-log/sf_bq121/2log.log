Begin Exploring Related Columns
Relevant columns and their potential usage for the analysis  

• USERS."id": primary key to join with BADGES."user_id"  
• USERS."creation_date": users’ sign‑up time (µs since Unix epoch) – used to calculate complete membership years  
• USERS."reputation": reputation score of each user – averaged per membership‑year bucket  
• BADGES."user_id": foreign key that links a badge to its owner – used to count badges per user  
• BADGES."id": badge identifier – counted to obtain “number of badges” per user  
• BADGES."date": the moment a badge was earned (not strictly needed for the final metric but handy for checks)

-----------------------------------------------------------------
Example exploratory Snowflake SQL queries  
(Adjust DATABASE / SCHEMA / TABLE names only if your environment differs; every column name is enclosed in double quotes.)

```sql
-- 1. Peek at raw user creation dates & reputations
SELECT "id",
       "creation_date",
       "reputation"
FROM   STACKOVERFLOW.STACKOVERFLOW.USERS
LIMIT  20;
```

```sql
-- 2. Convert microsecond epoch to a timestamp for a quick sanity check
SELECT "id",
       TO_TIMESTAMP_LTZ("creation_date" / 1000000)  AS "creation_ts",
       "reputation"
FROM   STACKOVERFLOW.STACKOVERFLOW.USERS
LIMIT  20;
```

```sql
-- 3. Count users who joined on or before 1‑Oct‑2021 (1633046400 in seconds → 1633046400000000 µs)
SELECT COUNT(*) AS "users_before_2021_10_01"
FROM   STACKOVERFLOW.STACKOVERFLOW.USERS
WHERE  "creation_date" <= 1633046400000000;
```

```sql
-- 4. Simple badge count for a handful of users
SELECT "user_id",
       COUNT(*) AS "badge_cnt"
FROM   STACKOVERFLOW.STACKOVERFLOW.BADGES
GROUP  BY "user_id"
ORDER  BY "badge_cnt" DESC
LIMIT  20;
```

```sql
-- 5. Join USERS ↔ BADGES and list users with their badge totals (sample)
SELECT u."id"               AS "user_id",
       u."reputation",
       COUNT(b."id")        AS "badge_cnt"
FROM   STACKOVERFLOW.STACKOVERFLOW.USERS  u
LEFT   JOIN STACKOVERFLOW.STACKOVERFLOW.BADGES b
       ON u."id" = b."user_id"
GROUP  BY u."id", u."reputation"
LIMIT  20;
```

```sql
-- 6. Compute complete membership years for each user (floor difference)
--    1633046400000000 represents 2021‑10‑01 00:00:00 UTC in µs
SELECT "id"                                  AS "user_id",
       FLOOR( (1633046400000000 - "creation_date")
              / 1000000 / 60 / 60 / 24 / 365 )  AS "complete_years",
       "reputation"
FROM   STACKOVERFLOW.STACKOVERFLOW.USERS
WHERE  "creation_date" <= 1633046400000000
LIMIT  20;
```

```sql
-- 7. Average reputation by complete membership year bucket
SELECT FLOOR( (1633046400000000 - u."creation_date")
              / 1000000 / 60 / 60 / 24 / 365 ) AS "complete_years",
       AVG(u."reputation")                     AS "avg_reputation"
FROM   STACKOVERFLOW.STACKOVERFLOW.USERS u
WHERE  u."creation_date" <= 1633046400000000
GROUP  BY "complete_years"
ORDER  BY "complete_years";
```

```sql
-- 8. Average badge count per membership‑year bucket
WITH badge_tot AS (
    SELECT "user_id", COUNT(*) AS "badge_cnt"
    FROM   STACKOVERFLOW.STACKOVERFLOW.BADGES
    GROUP  BY "user_id"
)
SELECT FLOOR( (1633046400000000 - u."creation_date")
              / 1000000 / 60 / 60 / 24 / 365 )  AS "complete_years",
       AVG(COALESCE(b."badge_cnt",0))           AS "avg_badges"
FROM   STACKOVERFLOW.STACKOVERFLOW.USERS  u
LEFT   JOIN badge_tot b
       ON u."id" = b."user_id"
WHERE  u."creation_date" <= 1633046400000000
GROUP  BY "complete_years"
ORDER  BY "complete_years";
```

```sql
-- 9. Combined view: avg reputation & avg badge count per membership‑year bucket
WITH badge_tot AS (
    SELECT "user_id", COUNT(*) AS "badge_cnt"
    FROM   STACKOVERFLOW.STACKOVERFLOW.BADGES
    GROUP  BY "user_id"
)
SELECT yr."complete_years",
       AVG(yr."reputation")            AS "avg_reputation",
       AVG(COALESCE(b."badge_cnt",0))  AS "avg_badges"
FROM (
    SELECT u."id",
           u."reputation",
           FLOOR( (1633046400000000 - u."creation_date")
                  / 1000000 / 60 / 60 / 24 / 365 ) AS "complete_years"
    FROM   STACKOVERFLOW.STACKOVERFLOW.USERS u
    WHERE  u."creation_date" <= 1633046400000000
) yr
LEFT JOIN badge_tot b
       ON yr."id" = b."user_id"
GROUP BY yr."complete_years"
ORDER BY yr."complete_years";
```

```sql
-- 10. Same as #9, but restricting to buckets having ≥1,000 users (helps filter noise)
WITH badge_tot AS (
    SELECT "user_id", COUNT(*) AS "badge_cnt"
    FROM   STACKOVERFLOW.STACKOVERFLOW.BADGES
    GROUP  BY "user_id"
), yr AS (
    SELECT u."id",
           u."reputation",
           FLOOR( (1633046400000000 - u."creation_date")
                  / 1000000 / 60 / 60 / 24 / 365 ) AS "complete_years"
    FROM   STACKOVERFLOW.STACKOVERFLOW.USERS u
    WHERE  u."creation_date" <= 1633046400000000
)
SELECT yr."complete_years",
       COUNT(*)                       AS "n_users",
       AVG(yr."reputation")           AS "avg_reputation",
       AVG(COALESCE(b."badge_cnt",0)) AS "avg_badges"
FROM   yr
LEFT  JOIN badge_tot b
       ON yr."id" = b."user_id"
GROUP  BY yr."complete_years"
HAVING COUNT(*) >= 1000
ORDER  BY yr."complete_years";
```

