2025-05-01 02:14:05 - Thread-734 (execute) - INFO - [Exploration]
Relevant columns and possible uses  
"id": primary‑key to join USERS ↔ BADGES  
"creation_date": users’ sign‑up time; filter ≤ 2021‑10‑01 and calculate completed years  
"reputation": metric whose average we need  
"date" (BADGES): each badge award date; not needed for final calc, but confirms it belongs to the period if you want to time‑filter badges  
"user_id": foreign key to tie BADGES back to USERS  
Conditions that may be helpful  
• "USERS"."creation_date" ≤ TO_TIMESTAMP('2021‑10‑01')  
• completed_years = DATEDIFF('year', joined_timestamp , '2021‑10‑01')  

Ten exploratory Snowflake SQL queries
```sql
-- 1. Peek at raw sign‑up epoch values for a handful of users
SELECT "id",
       "creation_date"
FROM "STACKOVERFLOW"."STACKOVERFLOW"."USERS"
LIMIT 20;
```

```sql
-- 2. Convert those micro‑second epochs into readable timestamps
SELECT "id",
       TO_TIMESTAMP("creation_date"/1000000) AS "joined_at"
FROM "STACKOVERFLOW"."STACKOVERFLOW"."USERS"
LIMIT 20;
```

```sql
-- 3. How many users joined on or before 1‑Oct‑2021?
SELECT COUNT(*) AS "users_pre_2021_10_01"
FROM  "STACKOVERFLOW"."STACKOVERFLOW"."USERS"
WHERE TO_TIMESTAMP("creation_date"/1000000) 
      <= '2021-10-01';
```

```sql
-- 4. Glimpse the BADGES table to see user_id and award date values
SELECT "id",
       "user_id",
       "name",
       "date"
FROM   "STACKOVERFLOW"."STACKOVERFLOW"."BADGES"
LIMIT 20;
```

```sql
-- 5. Aggregate badge counts per user (top 20 by badge total)
SELECT "user_id",
       COUNT(*) AS "badge_cnt"
FROM   "STACKOVERFLOW"."STACKOVERFLOW"."BADGES"
GROUP  BY "user_id"
ORDER  BY "badge_cnt" DESC
LIMIT 20;
```

```sql
-- 6. Join users with their badge counts (zero when no badges)
SELECT u."id"            AS "user_id",
       u."reputation",
       COALESCE(b."badge_cnt",0) AS "badge_cnt"
FROM   "STACKOVERFLOW"."STACKOVERFLOW"."USERS"  u
LEFT JOIN (
        SELECT "user_id", COUNT(*) AS "badge_cnt"
        FROM   "STACKOVERFLOW"."STACKOVERFLOW"."BADGES"
        GROUP  BY "user_id"
) b
ON b."user_id" = u."id"
LIMIT 20;
```

```sql
-- 7. Compute complete membership years for each qualifying user
SELECT u."id",
       TO_TIMESTAMP(u."creation_date"/1000000)       AS "joined_at",
       DATEDIFF('year', TO_TIMESTAMP(u."creation_date"/1000000), '2021-10-01') AS "years_complete"
FROM   "STACKOVERFLOW"."STACKOVERFLOW"."USERS" u
WHERE  TO_TIMESTAMP(u."creation_date"/1000000) <= '2021-10-01'
LIMIT 20;
```

```sql
-- 8. Average reputation by completed‑year bucket
SELECT DATEDIFF('year', TO_TIMESTAMP(u."creation_date"/1000000), '2021-10-01') AS "years_complete",
       AVG(u."reputation") AS "avg_reputation"
FROM   "STACKOVERFLOW"."STACKOVERFLOW"."USERS" u
WHERE  TO_TIMESTAMP(u."creation_date"/1000000) <= '2021-10-01'
GROUP  BY 1
ORDER  BY 1
LIMIT 20;
```

```sql
-- 9. Average badge count by completed‑year bucket
WITH badge_tot AS (
  SELECT "user_id", COUNT(*) AS "badge_cnt"
  FROM   "STACKOVERFLOW"."STACKOVERFLOW"."BADGES"
  GROUP  BY "user_id"
)
SELECT DATEDIFF('year',
                TO_TIMESTAMP(u."creation_date"/1000000),
                '2021-10-01') AS "years_complete",
       AVG(COALESCE(b."badge_cnt",0))               AS "avg_badges"
FROM   "STACKOVERFLOW"."STACKOVERFLOW"."USERS" u
LEFT  JOIN badge_tot b ON b."user_id" = u."id"
WHERE  TO_TIMESTAMP(u."creation_date"/1000000) <= '2021-10-01'
GROUP  BY 1
ORDER  BY 1
LIMIT 20;
```

```sql
-- 10. Final pull‑together: both averages side‑by‑side per completed year
WITH badge_tot AS (
  SELECT "user_id", COUNT(*) AS "badge_cnt"
  FROM   "STACKOVERFLOW"."STACKOVERFLOW"."BADGES"
  GROUP  BY "user_id"
)
SELECT DATEDIFF('year',
                TO_TIMESTAMP(u."creation_date"/1000000),
                '2021-10-01')                       AS "years_complete",
       AVG(u."reputation")                         AS "avg_reputation",
       AVG(COALESCE(b."badge_cnt",0))              AS "avg_badges"
FROM   "STACKOVERFLOW"."STACKOVERFLOW"."USERS" u
LEFT  JOIN badge_tot b ON b."user_id" = u."id"
WHERE  TO_TIMESTAMP(u."creation_date"/1000000) <= '2021-10-01'
GROUP  BY 1
ORDER  BY 1
LIMIT 20;
```
