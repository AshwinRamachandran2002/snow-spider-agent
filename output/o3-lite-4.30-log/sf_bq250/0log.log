--Description: Produce every raw distance pair (in metres) between each Singapore 1 km
--population‑grid centroid (latest snapshot before 2023‑01‑01) and every hospital/doctor
--feature from the OSM planet layer.  Steps:
--  1. sgp_grid: select grid cells for Singapore, convert their longitude/latitude into a
--     GEOGRAPHY point using ST_POINT.
--  2. hosp: select hospital/doctor features (layer_code 2110 or 2120) and cast their
--     stored binary geometry into GEOGRAPHY with TO_GEOGRAPHY.
--  3. Final SELECT: CROSS JOIN both sets and apply ST_DISTANCE to obtain great‑circle
--     distances for each pair.  Limited to 20 rows for preview.
WITH sgp_grid AS (
    SELECT
        "geo_id",
        "population",
        ST_POINT("longitude_centroid", "latitude_centroid") AS "centroid_geom"
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
      AND "last_updated" = (
          SELECT MAX("last_updated")
          FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
          WHERE "alpha_3_code" = 'SGP'
            AND "last_updated" < '2023-01-01'
      )
),
hosp AS (
    SELECT
        TO_GEOGRAPHY("geometry") AS "hosp_geom"
    FROM GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS
    WHERE "layer_code" IN (2110, 2120)
)
SELECT
    g."geo_id",
    ST_DISTANCE(g."centroid_geom", h."hosp_geom") AS "dist_m"
FROM sgp_grid g
CROSS JOIN hosp h
LIMIT 20;
