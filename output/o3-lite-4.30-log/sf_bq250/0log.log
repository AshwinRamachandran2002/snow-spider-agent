```sql
--Description: Find the Singapore 1 km population‑grid cell that is farthest from any
--hospital or doctor feature (layer_code 2110 or 2120) using the latest grid snapshot
--before 2023‑01‑01, and return that cell’s total population together with the
--distance (metres) to its nearest hospital/doctor.
--
--Strategy
-- 1. hull      – Build a minimal bounding envelope around all Singapore grid cells
--                to restrict the hospital search area.
-- 2. hosp      – Keep only hospital/doctor geometries that intersect this envelope;
--                cast them to GEOGRAPHY for distance work.
-- 3. sgp_grid  – Prepare the centroid (GEOGRAPHY point) for every Singapore grid cell.
-- 4. distances – Cross‑join sgp_grid with the filtered hosp set (small) and compute
--                the minimum ST_DISTANCE for each grid cell.
-- 5. Final SELECT orders by that distance descending and returns the single
--    farthest cell’s population.
WITH hull AS (   -- Bounding envelope of Singapore grid cells
    SELECT ST_ENVELOPE(ST_COLLECT(TO_GEOGRAPHY("geog"))) AS hull_geom
    FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE  "alpha_3_code" = 'SGP'
      AND  "last_updated" = (
            SELECT MAX("last_updated")
            FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
            WHERE  "alpha_3_code" = 'SGP'
              AND  "last_updated" < '2023-01-01'
      )
),
hosp AS (        -- Hospitals / doctors inside the envelope
    SELECT TO_GEOGRAPHY(l."geometry") AS hosp_geom
    FROM   GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS l, hull
    WHERE  l."layer_code" IN (2110, 2120)
      AND  ST_INTERSECTS(TO_GEOGRAPHY(l."geometry"), hull.hull_geom)
),
sgp_grid AS (    -- Singapore population‑grid centroids
    SELECT
        "geo_id",
        "population",
        ST_POINT("longitude_centroid", "latitude_centroid") AS centroid_geom
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
      AND "last_updated" = (
            SELECT MAX("last_updated")
            FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
            WHERE "alpha_3_code" = 'SGP'
              AND "last_updated" < '2023-01-01'
      )
),
distances AS (   -- Nearest‑hospital distance for each grid cell
    SELECT
        g."geo_id",
        g."population",
        MIN( ST_DISTANCE(g.centroid_geom, h.hosp_geom) ) AS nearest_dist_m
    FROM sgp_grid g
    CROSS JOIN hosp h
    GROUP BY g."geo_id", g."population"
)
SELECT
    "population" AS total_population_farthest_cell,
    nearest_dist_m
FROM distances
ORDER BY nearest_dist_m DESC
LIMIT 1;
```
