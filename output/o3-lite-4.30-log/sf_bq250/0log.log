--Description: Identify the grid cell that is farthest from any hospital and return its population plus the distance
WITH sgp_grid AS (
    SELECT
           "geo_id",
           "population",
           ST_MAKEPOINT("longitude_centroid", "latitude_centroid") AS "centroid_geom"
    FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE  "alpha_3_code" = 'SGP'
      AND  "last_updated" = (
            SELECT MAX("last_updated")
            FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
            WHERE  "alpha_3_code" = 'SGP'
              AND  "last_updated" < '2023-01-01'
    )
),
hosp AS (
    SELECT TO_GEOGRAPHY( ST_MAKEVALID("geometry") ) AS "hosp_geom"
    FROM   GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS
    WHERE  "layer_code" IN (2110, 2120)
),
distances AS (
    SELECT
           g."geo_id",
           g."population",
           MIN( ST_DISTANCE(g."centroid_geom", h."hosp_geom") ) AS "nearest_dist_m"
    FROM   sgp_grid g
    CROSS JOIN hosp h
