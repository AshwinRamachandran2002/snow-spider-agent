```sql
-- 7. Hospitals whose geometries lie inside the Singapore convex hull
WITH hull AS (
  SELECT ST_CONVEXHULL(ST_COLLECT("geog")) AS "hull_geom"
  FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
  WHERE  "alpha_3_code"  = 'SGP'
    AND  "last_updated" = (
          SELECT MAX("last_updated")
          FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
          WHERE  "alpha_3_code" = 'SGP'
            AND  "last_updated" < '2023-01-01')
)
SELECT
       h."layer_code",
       h."osm_way_id",
       h."geometry"
FROM   GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS h,
       hull
WHERE  h."layer_code" IN (2110, 2120)
  AND  ST_INTERSECTS(h."geometry", hull."hull_geom")
LIMIT  20;
```

```sql
-- 8. Compute distance from each Singapore grid centroid to every hospital (raw pairs)
WITH sgp_grid AS (
  SELECT
         "geo_id",
         "population",
         ST_POINT("longitude_centroid", "latitude_centroid") AS "centroid_geom"
  FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
  WHERE  "alpha_3_code"  = 'SGP'
    AND  "last_updated" = (
          SELECT MAX("last_updated")
          FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
          WHERE  "alpha_3_code" = 'SGP'
            AND  "last_updated" < '2023-01-01')
),
hosp AS (
  SELECT
         ST_MAKEVALID("geometry") AS "hosp_geom"
  FROM   GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS l
  WHERE  l."layer_code" IN (2110, 2120)
)
SELECT
       g."geo_id",
       ST_DISTANCE(g."centroid_geom", h."hosp_geom") AS "dist_m"
FROM   sgp_grid g,
       hosp h
LIMIT  20;
```

```sql
-- 9. Nearest‑hospital distance for every grid cell
WITH sgp_grid AS (
  SELECT
         "geo_id",
         "population",
         ST_POINT("longitude_centroid", "latitude_centroid") AS "centroid_geom"
  FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
  WHERE  "alpha_3_code"  = 'SGP'
    AND  "last_updated" = (
          SELECT MAX("last_updated")
          FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
          WHERE  "alpha_3_code" = 'SGP'
            AND  "last_updated" < '2023-01-01')
),
hosp AS (
  SELECT
         ST_MAKEVALID("geometry") AS "hosp_geom"
  FROM   GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS
  WHERE  "layer_code" IN (2110, 2120)
)
SELECT
       g."geo_id",
       g."population",
       MIN( ST_DISTANCE(g."centroid_geom", h."hosp_geom") ) AS "nearest_dist_m"
FROM   sgp_grid g
       CROSS JOIN hosp h
GROUP  BY g."geo_id", g."population"
LIMIT  20;
```

```sql
-- 10. Grid cell farthest from any hospital and its total population
WITH sgp_grid AS (
  SELECT
         "geo_id",
         "population",
         ST_POINT("longitude_centroid", "latitude_centroid") AS "centroid_geom"
  FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
  WHERE  "alpha_3_code"  = 'SGP'
    AND  "last_updated" = (
          SELECT MAX("last_updated")
          FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
          WHERE  "alpha_3_code" = 'SGP'
            AND  "last_updated" < '2023-01-01')
),
hosp AS (
  SELECT
         ST_MAKEVALID("geometry") AS "hosp_geom"
  FROM   GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS
  WHERE  "layer_code" IN (2110, 2120)
),
distances AS (
  SELECT
         g."geo_id",
         g."population",
         MIN( ST_DISTANCE(g."centroid_geom", h."hosp_geom") ) AS "nearest_dist_m"
  FROM   sgp_grid g
         CROSS JOIN hosp h
  GROUP  BY g."geo_id", g."population"
)
SELECT
       "geo_id",
       "population"   AS "total_population_farthest_cell",
       "nearest_dist_m"
FROM   distances
ORDER  BY "nearest_dist_m" DESC
LIMIT  20;
```
