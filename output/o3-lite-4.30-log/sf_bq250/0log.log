    FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE  "alpha_3_code" = 'SGP'
      AND  "last_updated" = (
            SELECT MAX("last_updated")
            FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
            WHERE  "alpha_3_code" = 'SGP'
              AND  "last_updated" < '2023-01-01'
      )
),
hosp AS (        -- Hospitals / doctors inside the envelope
    SELECT TO_GEOGRAPHY(l."geometry") AS hosp_geom
    FROM   GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS l, hull
    WHERE  l."layer_code" IN (2110, 2120)
      AND  ST_INTERSECTS(TO_GEOGRAPHY(l."geometry"), hull.hull_geom)
),
sgp_grid AS (    -- Singapore population‑grid centroids
    SELECT
        "geo_id",
        "population",
        ST_POINT("longitude_centroid", "latitude_centroid") AS centroid_geom
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
      AND "last_updated" = (
            SELECT MAX("last_updated")
            FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
            WHERE "alpha_3_code" = 'SGP'
              AND "last_updated" < '2023-01-01'
      )
),
distances AS (   -- Nearest‑hospital distance for each grid cell
    SELECT
        g."geo_id",
        g."population",
        MIN( ST_DISTANCE(g.centroid_geom, h.hosp_geom) ) AS nearest_dist_m
    FROM sgp_grid g
    CROSS JOIN hosp h
    GROUP BY g."geo_id", g."population"
)
SELECT
    "population" AS total_population_farthest_cell,
    nearest_dist_m
FROM distances
ORDER BY nearest_dist_m DESC
LIMIT 1;
