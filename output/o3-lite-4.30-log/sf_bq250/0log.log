Query:
--Description: Identify the single Singapore 1 km population‑grid cell (latest snapshot
--before 2023‑01‑01) that is farthest from any hospital or doctor feature (layer_code
--2110 or 2120).  The query first builds an envelope around all Singapore grid cells
--to pre‑filter hospitals, then computes each cell’s minimum distance to that reduced
--hospital set and finally returns the cell with the greatest such distance.
WITH hull AS (                               -- Bounding envelope of Singapore grid cells
    SELECT ST_ENVELOPE(ST_COLLECT(TO_GEOGRAPHY("geog"))) AS hull_geom
    FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE  "alpha_3_code" = 'SGP'
      AND  "last_updated" = (
              SELECT MAX("last_updated")
              FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
              WHERE  "alpha_3_code" = 'SGP'
                AND  "last_updated" < '2023-01-01'
           )
),
hosp AS (                                    -- Hospitals/clinics intersecting the envelope
    SELECT TO_GEOGRAPHY(l."geometry") AS hosp_geom
    FROM   GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS l,
           hull
    WHERE  l."layer_code" IN (2110, 2120)
      AND  ST_INTERSECTS(TO_GEOGRAPHY(l."geometry"), hull.hull_geom)
),
sgp_grid AS (                                -- Singapore grid‑cell centroids & population
    SELECT
        "geo_id",
        "population",
        ST_POINT("longitude_centroid", "latitude_centroid") AS centroid_geom
    FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE  "alpha_3_code" = 'SGP'
      AND  "last_updated" = (
              SELECT MAX("last_updated")
              FROM   GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
              WHERE  "alpha_3_code" = 'SGP'
                AND  "last_updated" < '2023-01-01'
           )
),
distances AS (                               -- Nearest‑hospital distance for each grid cell
    SELECT
        g."geo_id",
        g."population",
        MIN( ST_DISTANCE(g.centroid_geom, h.hosp_geom) ) AS nearest_dist_m
    FROM   sgp_grid g
    CROSS JOIN hosp h
    GROUP BY g."geo_id", g."population"
)
SELECT
    "geo_id",
    "population" AS total_population_farthest_cell,
    nearest_dist_m
FROM   distances
ORDER  BY nearest_dist_m DESC
LIMIT  1
Answer:
geo_id,TOTAL_POPULATION_FARTHEST_CELL,NEAREST_DIST_M
