```sql
--Description: Derive a convex‑hull polygon that encloses every Singapore (SGP) 1 km
--             population‑grid centroid before 2023‑01‑01, then count how many OSM
--             hospital‑type features (layer_code 2110 or 2120, timestamp ≤ 2023‑01‑01)
--             lie inside that polygon.  Steps executed inside this single query:
--             1) Filter POPULATION_GRID_1KM for Singapore rows with last_updated < 2023‑01‑01.
--             2) Convert each centroid (lon/lat) to a GEOGRAPHY point (ST_GEOGPOINT).
--             3) Merge all points with ST_UNION_AGG and wrap them with ST_CONVEXHULL
--                to obtain the bounding polygon (hull_geom).
--             4) Cross‑join that hull with PLANET_LAYERS, convert each OSM geometry
--                from WKB to GEOGRAPHY (ST_GEOGFROMWKB), and count those that
--                intersect the hull and satisfy layer_code/timestamp filters.
WITH hull AS (
    SELECT
        ST_CONVEXHULL(
            ST_UNION_AGG(
                ST_GEOGPOINT("longitude_centroid", "latitude_centroid")
            )
        ) AS hull_geom
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
      AND "last_updated" < DATE '2023-01-01'
)
SELECT
    COUNT(*) AS hospital_cnt
FROM GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS l
CROSS JOIN hull
WHERE l."layer_code" IN (2110, 2120)
  AND l."osm_timestamp" <= 1672444800000000        -- 2023‑01‑01 (microseconds)
  AND ST_INTERSECTS(
        hull.hull_geom,
        ST_GEOGFROMWKB(l."geometry")
      );
