--Description: 7) For one sample grid cell (first row) compute the distance (metres)
--              to every hospital object that satisfies layer_code / timestamp filters.
WITH latest AS (                                   -- latest population layer < 2023‑01‑01
    SELECT MAX("last_updated") AS d
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
      AND "last_updated" < DATE '2023-01-01'
), grid_one AS (                                   -- pick one grid cell
    SELECT
        ST_GEOGFROMTEXT('POINT(' || "longitude_centroid" || ' ' || "latitude_centroid" || ')') AS pt,
        "geo_id"
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
      AND "last_updated" = (SELECT d FROM latest)
    LIMIT 1
), hospitals AS (                                  -- hospital geometries
    SELECT ST_GEOGFROMWKB("geometry") AS geom
    FROM GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS
    WHERE "layer_code" IN (2110, 2120)
      AND "osm_timestamp" <= 1672444800000000
)
SELECT
    g."geo_id",
    ST_DISTANCE(g.pt, h.geom) AS dist_m
FROM grid_one g
JOIN hospitals h
LIMIT 20
