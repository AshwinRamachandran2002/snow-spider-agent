--Description: 9) Identify the grid cell that is farthest from any hospital and see its population / distance.
WITH latest AS (
    SELECT MAX("last_updated") AS "d"
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
      AND "last_updated" < DATE '2023-01-01'
), grid AS (
    SELECT "geo_id",
           ST_POINT("longitude_centroid", "latitude_centroid") AS "pt",
           "population"
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
      AND "last_updated" = (SELECT "d" FROM latest)
), hospitals AS (
    SELECT "geometry"
    FROM GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS
    WHERE "layer_code" IN (2110, 2120)
      AND "osm_timestamp" <= 1672444800000000
), distances AS (
    SELECT g."geo_id",
