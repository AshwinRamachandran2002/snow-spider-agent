--Description: 8) Compute the nearest‑hospital distance for every Singapore grid cell (return sample 20 rows).
WITH latest AS (
    SELECT MAX("last_updated") AS "d"
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
