Query:
--Description: 6) List 20 OSM hospital objects (layer_code 2110/2120, ≤ 1‑Jan‑2023)
--              that fall inside the geographic rectangle which bounds every
--              Singapore (SGP) 1 km population‑grid centroid dated before 2023‑01‑01.
WITH bounds AS (                                   -- numeric limits of centroids
    SELECT  MIN("longitude_centroid") AS min_lon,
            MAX("longitude_centroid") AS max_lon,
            MIN("latitude_centroid")  AS min_lat,
            MAX("latitude_centroid")  AS max_lat
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
      AND "last_updated" < DATE '2023-01-01'
), bbox AS (                                      -- rectangle as GEOGRAPHY polygon
    SELECT ST_GEOGFROMTEXT(
             'POLYGON((' ||
             min_lon || ' ' || min_lat || ', ' ||
             max_lon || ' ' || min_lat || ', ' ||
             max_lon || ' ' || max_lat || ', ' ||
             min_lon || ' ' || max_lat || ', ' ||
             min_lon || ' ' || min_lat || '))'
           ) AS hull_geom
    FROM bounds
)
SELECT l."osm_id",
       l."layer_code",
       l."osm_timestamp"
FROM GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS l
CROSS JOIN bbox
WHERE l."layer_code" IN (2110, 2120)
  AND l."osm_timestamp" <= 1672444800000000               -- 1‑Jan‑2023 (µs)
  AND ST_INTERSECTS(
        bbox.hull_geom,
        ST_GEOGFROMWKB(l."geometry")
      )
LIMIT 20
