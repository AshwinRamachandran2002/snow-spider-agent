```sql
--Description: Determine the number of OSM hospital objects (layer_code 2110 or 2120,
--             with osm_timestamp ≤ 2023‑01‑01) whose geometries intersect the
--             geographic rectangle that bounds every Singapore (SGP) 1‑km population
--             grid‑cell centroid dated before 2023‑01‑01.
--             • bounds CTE: find min/max longitude and latitude for the centroids.
--             • bbox CTE: turn those limits into a WKT POLYGON and cast to GEOGRAPHY.
--             • Final SELECT: convert each OSM object from WKB to GEOGRAPHY and count
--               those that intersect the bounding rectangle while satisfying the
--               layer_code and timestamp filters.
WITH bounds AS (
    SELECT
        MIN("longitude_centroid") AS min_lon,
        MAX("longitude_centroid") AS max_lon,
        MIN("latitude_centroid")  AS min_lat,
        MAX("latitude_centroid")  AS max_lat
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
      AND "last_updated" < DATE '2023-01-01'
),
bbox AS (
    SELECT ST_GEOGFROMTEXT(
        'POLYGON((' ||
        min_lon || ' ' || min_lat || ', ' ||
        max_lon || ' ' || min_lat || ', ' ||
        max_lon || ' ' || max_lat || ', ' ||
        min_lon || ' ' || max_lat || ', ' ||
        min_lon || ' ' || min_lat || '))'
    ) AS hull_geom
    FROM bounds
)
SELECT COUNT(*) AS hospital_cnt
FROM GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS l
CROSS JOIN bbox
WHERE l."layer_code" IN (2110, 2120)
  AND l."osm_timestamp" <= 1672444800000000           -- 1‑Jan‑2023 in µs
  AND ST_INTERSECTS(
        bbox.hull_geom,
        ST_GEOGFROMWKB(l."geometry")
      );
