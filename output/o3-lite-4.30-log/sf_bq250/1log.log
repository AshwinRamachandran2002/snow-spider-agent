```sql
--Description: 8) For the most‑recent Singapore 1 km population‑grid layer prior to
--             2023‑01‑01, return 20 grid cells together with the distance (metres) to
--             their nearest hospital feature (layer_code 2110/2120, timestamp ≤ 2023‑01‑01).
--             A JOIN LATERAL is used so that, for each grid cell, Snowflake scans the
--             small hospital set once and keeps only the minimum distance, thus
--             avoiding the heavy Cartesian product that previously led to timeouts.
WITH latest AS (                                   -- newest layer before 2023‑01‑01
    SELECT MAX("last_updated") AS d
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
      AND "last_updated" < DATE '2023-01-01'
), grid AS (
    SELECT
        "geo_id",
        "population",
        ST_GEOGFROMTEXT('POINT(' || "longitude_centroid" || ' ' || "latitude_centroid" || ')') AS pt
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
      AND "last_updated" = (SELECT d FROM latest)
), hospitals AS (
    SELECT ST_GEOGFROMWKB("geometry") AS geom
    FROM GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS
    WHERE "layer_code" IN (2110, 2120)
      AND "osm_timestamp" <= 1672444800000000      -- 1‑Jan‑2023 in µs
)
SELECT
    g."geo_id",
    g."population",
    nearest.nearest_m
FROM grid g
JOIN LATERAL (                                     -- per‑grid‑cell nearest hospital
    SELECT MIN(ST_DISTANCE(g.pt, h.geom)) AS nearest_m
    FROM hospitals h
