), bbox AS (                                      -- rectangle as GEOGRAPHY polygon
    SELECT ST_GEOGFROMTEXT(
             'POLYGON((' ||
             min_lon || ' ' || min_lat || ', ' ||
             max_lon || ' ' || min_lat || ', ' ||
             max_lon || ' ' || max_lat || ', ' ||
             min_lon || ' ' || max_lat || ', ' ||
             min_lon || ' ' || min_lat || '))'
           ) AS hull_geom
    FROM bounds
)
SELECT l."osm_id",
       l."layer_code",
       l."osm_timestamp"
FROM GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS l
CROSS JOIN bbox
WHERE l."layer_code" IN (2110, 2120)
  AND l."osm_timestamp" <= 1672444800000000               -- 1‑Jan‑2023 (µs)
  AND ST_INTERSECTS(
        bbox.hull_geom,
        ST_GEOGFROMWKB(l."geometry")
      )
LIMIT 20;
