```sql
WITH latest_grid_date AS (      -- most‑recent 1‑km layer before 2023‑01‑01
    SELECT MAX("last_updated") AS "last_updated"
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
      AND "last_updated" < DATE '2023-01-01'
),

sgp_grid AS (                   -- Singapore grid‑cell centroids
    SELECT
        "geo_id",
        "population",
        ST_POINT("longitude_centroid", "latitude_centroid") AS "centroid",
        "longitude_centroid"                                   AS lon,
        "latitude_centroid"                                    AS lat
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
      AND "last_updated" = (SELECT "last_updated" FROM latest_grid_date)
),

sgp_bounds AS (                 -- rectangle that encloses all centroids
    SELECT
        MIN(lon) AS min_lon,
        MAX(lon) AS max_lon,
        MIN(lat) AS min_lat,
        MAX(lat) AS max_lat
    FROM sgp_grid
),

hull AS (                       -- bounding‑box polygon as GEOGRAPHY
    SELECT ST_GEOGFROMTEXT(
             'POLYGON((' ||
             min_lon || ' ' || min_lat || ', ' ||
             max_lon || ' ' || min_lat || ', ' ||
             max_lon || ' ' || max_lat || ', ' ||
             min_lon || ' ' || max_lat || ', ' ||
             min_lon || ' ' || min_lat || '))'
           ) AS geom
    FROM sgp_bounds
),

hospitals AS (                  -- hospitals present before 2023‑01‑01 and inside hull
    SELECT ST_GEOGFROMWKB(pl."geometry") AS geom
    FROM GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS pl
    CROSS JOIN hull h
    WHERE pl."layer_code" IN (2110, 2120)
      AND pl."osm_timestamp" <= 1672444800000000          -- 1‑Jan‑2023 (µs)
      AND ST_INTERSECTS(ST_GEOGFROMWKB(pl."geometry"), h.geom)
),

grid_distances AS (             -- distance from each grid centroid to nearest hospital
    SELECT
        g."geo_id",
        g."population",
        (
            SELECT MIN(ST_DISTANCE(g.centroid, hosp.geom))
            FROM hospitals hosp
        ) AS nearest_distance
    FROM sgp_grid g
)

SELECT "population" AS total_population
FROM grid_distances
ORDER BY nearest_distance DESC NULLS LAST, "geo_id"
LIMIT 1;
```
