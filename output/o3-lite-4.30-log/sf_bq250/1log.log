```sql
--Description: 8) For every 1 km population‑grid cell in Singapore (most‑recent layer
--             before 2023‑01‑01) calculate the distance in metres to its nearest
--             hospital feature (layer_code 2110 or 2120, osm_timestamp ≤ 2023‑01‑01).
--             The query avoids a full Cartesian join by using a LATERAL sub‑query
--             that, for each grid cell, aggregates the minimum distance across the
--             ≈159 hospital geometries.  Finally, 20 rows with the largest
--             nearest‑hospital distances are shown.
WITH latest AS (                                   -- latest grid layer < 2023‑01‑01
    SELECT MAX("last_updated") AS d
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
      AND "last_updated" < DATE '2023-01-01'
), grid AS (                                       -- grid centroids as GEOGRAPHY points
    SELECT
        "geo_id",
        "population",
        ST_GEOGFROMTEXT(
            'POINT(' || "longitude_centroid" || ' ' || "latitude_centroid" || ')'
        ) AS pt
    FROM GEO_OPENSTREETMAP_WORLDPOP.WORLDPOP.POPULATION_GRID_1KM
    WHERE "alpha_3_code" = 'SGP'
      AND "last_updated" = (SELECT d FROM latest)
), hospitals AS (                                  -- qualifying hospital geometries
    SELECT ST_GEOGFROMWKB("geometry") AS geom
    FROM GEO_OPENSTREETMAP_WORLDPOP.GEO_OPENSTREETMAP.PLANET_LAYERS
    WHERE "layer_code" IN (2110, 2120)
      AND "osm_timestamp" <= 1672444800000000       -- ≤ 1‑Jan‑2023 (µs)
)
SELECT
    g."geo_id",
    g."population",
    nearest.min_dist AS nearest_m
FROM grid g
JOIN LATERAL (                                     -- per‑row aggregation of min distance
    SELECT MIN(ST_DISTANCE(g.pt, h.geom)) AS min_dist
    FROM hospitals h
) nearest
ORDER BY nearest_m DESC
LIMIT 20;
```
