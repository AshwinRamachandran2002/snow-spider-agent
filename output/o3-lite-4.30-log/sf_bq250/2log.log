Query:
--Description: List hospital / doctor features (layer_code 2110 or 2120) that intersect the
--             Singapore 1 km‑grid bounding envelope (latest snapshot before 2023‑01‑01).
--             Uses ST_ENVELOPE for the bounding region and casts PLANET_LAYERS geometries
--             from WKB → GEOGRAPHY with ST_GEOGFROMWKB so ST_INTERSECTS works.
WITH sg_bbox AS (
    SELECT ST_ENVELOPE(
             ST_COLLECT(
               ST_POINT("longitude_centroid", "latitude_centroid")
             )
           ) AS geom
    FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
    WHERE  "country_name" = 'Singapore'
      AND  "last_updated" = (
            SELECT MAX("last_updated")
            FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
            WHERE  "country_name" = 'Singapore'
              AND  "last_updated" < DATE '2023-01-01'
          )
)
SELECT
       p."osm_id",
       p."layer_code"
FROM   "GEO_OPENSTREETMAP_WORLDPOP"."GEO_OPENSTREETMAP"."PLANET_LAYERS" p,
       sg_bbox
WHERE  p."layer_code" IN (2110, 2120)
  AND  ST_INTERSECTS(
         ST_GEOGFROMWKB(p."geometry"),
         sg_bbox.geom
       )
LIMIT  20
