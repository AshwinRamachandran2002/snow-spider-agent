--Description: For each Singapore grid cell (latest snapshot before 2023‑01‑01) compute the
--             minimum distance to any hospital / doctor inside the bounding envelope and
--             display 20 sample rows (geo_id, population, distance in metres).
WITH sg_cells AS (
