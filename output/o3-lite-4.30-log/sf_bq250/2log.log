Query:
--Description: For each Singapore grid cell (latest snapshot before 2023‑01‑01) compute the
--             minimum distance to any hospital / doctor inside the bounding envelope and
--             display 20 sample rows (geo_id, population, distance in metres).
WITH sg_cells AS (
    SELECT
           "geo_id",
           "population",
           ST_POINT("longitude_centroid", "latitude_centroid") AS geom
    FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
    WHERE  "country_name" = 'Singapore'
      AND  "last_updated" = (
            SELECT MAX("last_updated")
            FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
            WHERE  "country_name" = 'Singapore'
              AND  "last_updated" < DATE '2023-01-01'
          )
),
sg_bbox AS (
    SELECT ST_ENVELOPE(
             ST_COLLECT(
               ST_POINT("longitude_centroid", "latitude_centroid")
             )
           ) AS geom
    FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
    WHERE  "country_name" = 'Singapore'
      AND  "last_updated" = (
            SELECT MAX("last_updated")
            FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
            WHERE  "country_name" = 'Singapore'
              AND  "last_updated" < DATE '2023-01-01'
          )
),
hosp AS (
    SELECT
           ST_CENTROID( ST_GEOGFROMWKB(p."geometry") ) AS geom
    FROM   "GEO_OPENSTREETMAP_WORLDPOP"."GEO_OPENSTREETMAP"."PLANET_LAYERS" p,
           sg_bbox
    WHERE  p."layer_code" IN (2110, 2120)
      AND  ST_INTERSECTS(
             ST_GEOGFROMWKB(p."geometry"),
             sg_bbox.geom
           )
)
SELECT
       c."geo_id",
       c."population",
       MIN( ST_DISTANCE(c.geom, h.geom) ) AS dist_to_nearest_hospital_m
FROM   sg_cells c,
       hosp     h
GROUP  BY c."geo_id", c."population"
LIMIT  20
