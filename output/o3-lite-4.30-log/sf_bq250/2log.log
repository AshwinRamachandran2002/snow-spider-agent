--Description: Build a rectangular bounding envelope around all Singapore 1 km grid‑cell centroids
--            (latest snapshot before 1 Jan 2023) and list the OSM‑ID and layer_code of every
--            hospital/doctor feature (layer_code 2110 or 2120) whose geometry intersects that
--            envelope.  ST_ENVELOPE is used instead of the unavailable ST_CONVEXHULL.
WITH sg_hull AS (
    SELECT ST_ENVELOPE(
             ST_COLLECT(
               ST_POINT("longitude_centroid", "latitude_centroid")
             )
           ) AS geom
    FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
    WHERE  "country_name" = 'Singapore'
      AND  "last_updated" = (
            SELECT MAX("last_updated")
            FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
            WHERE  "country_name" = 'Singapore'
              AND  "last_updated" < DATE '2023-01-01'
          )
)
SELECT
       p."osm_id",
       p."layer_code"
FROM   "GEO_OPENSTREETMAP_WORLDPOP"."GEO_OPENSTREETMAP"."PLANET_LAYERS"  p,
       sg_hull
WHERE  p."layer_code" IN (2110, 2120)
  AND  ST_INTERSECTS(p."geometry", sg_hull.geom)
LIMIT  20;
