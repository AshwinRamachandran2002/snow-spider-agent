```sql
--Description: Build a bounding envelope from centroid points of Singapore’s latest (pre‑2023‑01‑01) 1 km WorldPop grid,
--             then list hospital / doctor features (layer_code 2110 or 2120) whose geometries intersect that envelope.
--             PLANET_LAYERS geometries (WKB) are converted to GEOGRAPHY with ST_GEOGFROMWKB so ST_INTERSECTS works.
WITH sg_bbox AS (
    SELECT ST_ENVELOPE(
             ST_COLLECT(
               ST_POINT("longitude_centroid", "latitude_centroid")
             )
           ) AS geom                      -- GEOGRAPHY bounding envelope
    FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
    WHERE  "country_name" = 'Singapore'
      AND  "last_updated" = (
            SELECT MAX("last_updated")
            FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
            WHERE  "country_name" = 'Singapore'
              AND  "last_updated" < DATE '2023-01-01'
          )
)
SELECT
       p."osm_id",
       p."layer_code"
FROM   "GEO_OPENSTREETMAP_WORLDPOP"."GEO_OPENSTREETMAP"."PLANET_LAYERS" p,
       sg_bbox
WHERE  p."layer_code" IN (2110, 2120)
  AND  ST_INTERSECTS(
         ST_GEOGFROMWKB(p."geometry"),   -- convert BINARY → GEOGRAPHY
         sg_bbox.geom
       )
LIMIT  20;
```
