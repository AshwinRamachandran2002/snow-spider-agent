Relevant columns & why they matter  

• WORLDPOP.POPULATION_GRID_1KM  
  • "country_name" / "alpha_3_code": restrict the study area to Singapore.  
  • "last_updated": keep data prior to 2023‑01‑01 and pick the most recent date.  
  • "latitude_centroid", "longitude_centroid": build a point geometry for every 1‑km grid cell.  
  • "population": population that will finally be reported for the most distant cell.  
  • "geog": polygon outline of each grid cell (can also be used as geometry if preferred).  
  • "geo_id": unique identifier of every grid cell.  

• GEO_OPENSTREETMAP.PLANET_LAYERS  
  • "layer_code": select hospitals / doctors (2110, 2120).  
  • "geometry": point or polygon geometry of every POI; needed to evaluate distances & intersections.  
  • "osm_timestamp": can be used if a currency filter is required.  

Snowflake‑SQL queries (run them step‑by‑step – all names are wrapped in double quotes and each query is capped to 20 rows with LIMIT 20):

```sql
-- 1.  Show distinct country names that exist in the 1‑km WorldPop grid.
SELECT DISTINCT 
       "country_name"
FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
LIMIT  20;
```

```sql
-- 2.  Inspect the update dates for Singapore to find the most recent one before 2023‑01‑01.
SELECT DISTINCT 
       "last_updated"
FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
WHERE  "country_name" = 'Singapore'
  AND  "last_updated" < '2023‑01‑01'
ORDER  BY "last_updated" DESC
LIMIT  20;
```

```sql
-- 3.  Look at one sample of Singapore 1‑km grid records (columns used later).
SELECT 
       "geo_id",
       "last_updated",
       "population",
       "latitude_centroid",
       "longitude_centroid"
FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
WHERE  "country_name" = 'Singapore'
  AND  "last_updated" = ( SELECT MAX("last_updated")
                          FROM "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
                          WHERE "country_name" = 'Singapore'
                            AND "last_updated" < '2023‑01‑01')
LIMIT  20;
```

```sql
-- 4.  Check that hospital / doctor layer codes exist in PLANET_LAYERS.
SELECT DISTINCT 
       "layer_code"
FROM   "GEO_OPENSTREETMAP_WORLDPOP"."GEO_OPENSTREETMAP"."PLANET_LAYERS"
WHERE  "layer_code" IN (2110, 2120)
LIMIT  20;
```

```sql
-- 5.  Preview a few hospital geometries that are potentially inside Singapore
--     (no spatial filter yet – just layer code).
SELECT 
       "osm_id",
       "layer_code",
       "geometry"
FROM   "GEO_OPENSTREETMAP_WORLDPOP"."GEO_OPENSTREETMAP"."PLANET_LAYERS"
WHERE  "layer_code" IN (2110, 2120)
LIMIT  20;
```

```sql
-- 6.  Build a convex‑hull polygon around all Singapore grid centroids
--     (latest date < 2023‑01‑01).  Only show the WKT for inspection.
SELECT 
       ST_ASWKT(
         ST_CONVEXHULL(
           ST_COLLECT(
             ST_POINT("longitude_centroid", "latitude_centroid")
           )
         )
       ) AS "sg_convex_hull_wkt"
FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
WHERE  "country_name" = 'Singapore'
  AND  "last_updated" = ( SELECT MAX("last_updated")
                          FROM "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
                          WHERE "country_name" = 'Singapore'
                            AND "last_updated" < '2023‑01‑01');
```

```sql
-- 7.  Retrieve hospitals / doctors whose geometry falls inside that convex hull.
WITH hull AS (
  SELECT ST_CONVEXHULL(
           ST_COLLECT(
             ST_POINT("longitude_centroid", "latitude_centroid")
           )
         ) AS geom
  FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
  WHERE  "country_name" = 'Singapore'
    AND  "last_updated" = ( SELECT MAX("last_updated")
                            FROM "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
                            WHERE "country_name" = 'Singapore'
                              AND "last_updated" < '2023‑01‑01')
)
SELECT 
       p."osm_id",
       p."layer_code"
FROM   "GEO_OPENSTREETMAP_WORLDPOP"."GEO_OPENSTREETMAP"."PLANET_LAYERS"   p,
       hull
WHERE  p."layer_code" IN (2110, 2120)
  AND  ST_INTERSECTS(p."geometry", hull.geom)
LIMIT  20;
```

```sql
-- 8.  For each Singapore grid cell, compute its centroid point (as GEOGRAPHY)
--     and the minimum distance to any hospital inside the convex hull.
--     Show 20 sample rows including that distance.
WITH sg_cells AS (
  SELECT 
         "geo_id",
         "population",
         ST_POINT("longitude_centroid", "latitude_centroid") AS geom
  FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
  WHERE  "country_name" = 'Singapore'
    AND  "last_updated" = ( SELECT MAX("last_updated")
                            FROM "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
                            WHERE "country_name" = 'Singapore'
                              AND "last_updated" < '2023‑01‑01')
),
hosp AS (
  SELECT 
         ST_CENTROID("geometry") AS geom
  FROM   "GEO_OPENSTREETMAP_WORLDPOP"."GEO_OPENSTREETMAP"."PLANET_LAYERS" p,
         ( SELECT ST_CONVEXHULL(
                    ST_COLLECT(
                      ST_POINT("longitude_centroid", "latitude_centroid")
                    )
                  ) AS hull_geom
           FROM "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
           WHERE "country_name" = 'Singapore'
             AND "last_updated" = ( SELECT MAX("last_updated")
                                    FROM "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
                                    WHERE "country_name" = 'Singapore'
                                      AND "last_updated" < '2023‑01‑01')
         ) h
  WHERE  p."layer_code" IN (2110, 2120)
    AND  ST_INTERSECTS(p."geometry", h.hull_geom)
)
SELECT 
       c."geo_id",
       c."population",
       MIN( ST_DISTANCE(c.geom, h.geom) ) AS dist_to_nearest_hospital_m
FROM   sg_cells  c,
       hosp      h
GROUP  BY c."geo_id", c."population"
LIMIT  20;
```

```sql
-- 9.  Identify the single grid cell that is farthest from any hospital.
--     (Return the geo_id, population and that maximum distance.)
WITH sg_cells AS (
  SELECT 
         "geo_id",
         "population",
         ST_POINT("longitude_centroid", "latitude_centroid") AS geom
  FROM   "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
  WHERE  "country_name" = 'Singapore'
    AND  "last_updated" = ( SELECT MAX("last_updated")
                            FROM "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
                            WHERE "country_name" = 'Singapore'
                              AND "last_updated" < '2023‑01‑01')
),
hosp AS (
  SELECT 
         ST_CENTROID("geometry") AS geom
  FROM   "GEO_OPENSTREETMAP_WORLDPOP"."GEO_OPENSTREETMAP"."PLANET_LAYERS" p,
         ( SELECT ST_CONVEXHULL(
                    ST_COLLECT(
                      ST_POINT("longitude_centroid", "latitude_centroid")
                    )
                  ) AS hull_geom
           FROM "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
           WHERE "country_name" = 'Singapore'
             AND "last_updated" = ( SELECT MAX("last_updated")
                                    FROM "GEO_OPENSTREETMAP_WORLDPOP"."WORLDPOP"."POPULATION_GRID_1KM"
                                    WHERE "country_name" = 'Singapore'
                                      AND "last_updated" < '2023‑01‑01')
         ) h
  WHERE  p."layer_code" IN (2110, 2120)
    AND  ST_INTERSECTS(p."geometry", h.hull_geom)
),
distances AS (
SELECT 
       c."geo_id",
       c."population",
       MIN( ST_DISTANCE(c.geom, h.geom) ) AS dist_m
FROM   sg_cells c, hosp h
GROUP  BY c."geo_id", c."population"
)
SELECT 
       "geo_id",
       "population",
       dist_m
FROM   distances
ORDER  BY dist_m DESC
LIMIT  1;
```

