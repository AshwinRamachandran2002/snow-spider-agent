2025-05-01 03:45:54 - Thread-1622 (execute) - INFO - [Exploration]
Relevant columns + why they matter  

• V_BUILDING."CLASS": main building classification → group/aggregate on it  
• V_BUILDING."SUBCLASS": finer building classification → group/aggregate on it  
• V_BUILDING."SURFACE_AREA_SQ_M": numeric text field that stores surface area → SUM() for totals  
• V_BUILDING."ID": building identifier → COUNT() for # of buildings  
• V_BUILDING."GEO_CORDINATES": GEOGRAPHY polygon → spatial filter (inside a city boundary)  

• V_ADMINISTRATIVE."GEO_CORDINATES": GEOGRAPHY polygon of the administrative area → spatial filter  
• V_ADMINISTRATIVE."NAMES": VARIANT holding the place‑names → pick “Amsterdam” / “Rotterdam”  
• V_ADMINISTRATIVE."ADMIN_LEVEL": administrative hierarchy. Municipalities are usually level ‘8’; use as an extra filter (optional).  

Typical conditions that will be used  

1. Extract the city name from the VARIANT object and compare:  

   LATERAL FLATTEN(input => a."NAMES") f  
   WHERE f.value::string ILIKE '%Amsterdam%'  

2. Keep only municipality polygons (optional, but helps performance):  

   AND a."ADMIN_LEVEL" = '8'  

3. Spatial match between buildings and the chosen polygon:  

   ST_WITHIN(b."GEO_CORDINATES", a."GEO_CORDINATES")  

4. Clean numeric surface text → CAST(b."SURFACE_AREA_SQ_M" AS FLOAT)  

-------------------------------------------------------------------
Ten exploratory → final Snowflake SQL queries  
(each limited to 20 rows for safety; adjust or remove LIMIT for production)

```sql
-- 1) Peek at raw building records
SELECT b."ID",
       b."CLASS",
       b."SUBCLASS",
       b."SURFACE_AREA_SQ_M"
FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_BUILDING b
LIMIT  20;
```

```sql
-- 2) List all distinct building class / subclass combinations
SELECT DISTINCT
       b."CLASS",
       b."SUBCLASS"
FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_BUILDING b
ORDER  BY 1, 2
LIMIT  20;
```

```sql
-- 3) Quick look at surface‑area values that are not NULL
SELECT b."SURFACE_AREA_SQ_M"
FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_BUILDING b
WHERE  b."SURFACE_AREA_SQ_M" IS NOT NULL
LIMIT  20;
```

```sql
-- 4) Inspect administrative polygons and their names
SELECT a."ID",
       f.key              AS "LANG_CODE",
       f.value::string    AS "PLACE_NAME",
       a."ADMIN_LEVEL"
FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_ADMINISTRATIVE a,
       LATERAL FLATTEN(input => a."NAMES") f
LIMIT  20;
```

```sql
-- 5) Retrieve the polygon row(s) that correspond to “Amsterdam”
SELECT a."ID",
       a."GEO_CORDINATES"
FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_ADMINISTRATIVE a,
       LATERAL FLATTEN(input => a."NAMES") n
WHERE  n.value::string ILIKE '%Amsterdam%'
  AND  a."ADMIN_LEVEL" = '8'         -- municipality
LIMIT  20;
```

```sql
-- 6) Retrieve the polygon row(s) that correspond to “Rotterdam”
SELECT a."ID",
       a."GEO_CORDINATES"
FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_ADMINISTRATIVE a,
       LATERAL FLATTEN(input => a."NAMES") n
WHERE  n.value::string ILIKE '%Rotterdam%'
  AND  a."ADMIN_LEVEL" = '8'
LIMIT  20;
```

```sql
-- 7) Count buildings that fall inside the Amsterdam polygon(s)
WITH ams AS (
  SELECT a."GEO_CORDINATES" AS geom
  FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_ADMINISTRATIVE a,
         LATERAL FLATTEN(input => a."NAMES") n
  WHERE  n.value::string ILIKE '%Amsterdam%'
    AND  a."ADMIN_LEVEL" = '8'
)
SELECT COUNT(*) AS "NUM_BUILDINGS_AMS"
FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_BUILDING b,
       ams
WHERE  ST_WITHIN(b."GEO_CORDINATES", ams.geom)
LIMIT  20;
```

```sql
-- 8) Amsterdam – aggregate by class / subclass
WITH ams AS (
  SELECT a."GEO_CORDINATES" AS geom
  FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_ADMINISTRATIVE a,
         LATERAL FLATTEN(input => a."NAMES") n
  WHERE  n.value::string ILIKE '%Amsterdam%'
    AND  a."ADMIN_LEVEL" = '8'
)
SELECT b."CLASS",
       b."SUBCLASS",
       COUNT(*)                                             AS "NUM_BUILDINGS",
       SUM(TRY_CAST(b."SURFACE_AREA_SQ_M" AS FLOAT))        AS "TOTAL_SURFACE_SQ_M"
FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_BUILDING b,
       ams
WHERE  ST_WITHIN(b."GEO_CORDINATES", ams.geom)
GROUP  BY b."CLASS", b."SUBCLASS"
ORDER  BY b."CLASS", b."SUBCLASS"
LIMIT  20;
```

```sql
-- 9) Rotterdam – aggregate by class / subclass
WITH rtm AS (
  SELECT a."GEO_CORDINATES" AS geom
  FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_ADMINISTRATIVE a,
         LATERAL FLATTEN(input => a."NAMES") n
  WHERE  n.value::string ILIKE '%Rotterdam%'
    AND  a."ADMIN_LEVEL" = '8'
)
SELECT b."CLASS",
       b."SUBCLASS",
       COUNT(*)                                             AS "NUM_BUILDINGS",
       SUM(TRY_CAST(b."SURFACE_AREA_SQ_M" AS FLOAT))        AS "TOTAL_SURFACE_SQ_M"
FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_BUILDING b,
       rtm
WHERE  ST_WITHIN(b."GEO_CORDINATES", rtm.geom)
GROUP  BY b."CLASS", b."SUBCLASS"
ORDER  BY b."CLASS", b."SUBCLASS"
LIMIT  20;
```

```sql
-- 10) FINAL comparison report: Amsterdam vs. Rotterdam side‑by‑side
WITH city_polys AS (
  SELECT 'Amsterdam'  AS city, a."GEO_CORDINATES" AS geom
  FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_ADMINISTRATIVE a,
         LATERAL FLATTEN(input => a."NAMES") n
  WHERE  n.value::string ILIKE '%Amsterdam%'  AND a."ADMIN_LEVEL" = '8'
  UNION ALL
  SELECT 'Rotterdam'  AS city, a."GEO_CORDINATES" AS geom
  FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_ADMINISTRATIVE a,
         LATERAL FLATTEN(input => a."NAMES") n
  WHERE  n.value::string ILIKE '%Rotterdam%'  AND a."ADMIN_LEVEL" = '8'
),
bldg_city AS (
  SELECT c.city,
         b."CLASS",
         b."SUBCLASS",
         TRY_CAST(b."SURFACE_AREA_SQ_M" AS FLOAT) AS surf
  FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_BUILDING b,
         city_polys c
  WHERE  ST_WITHIN(b."GEO_CORDINATES", c.geom)
)
SELECT bc."CLASS",
       bc."SUBCLASS",
       -- Amsterdam columns
       SUM(CASE WHEN bc.city = 'Amsterdam'  THEN 1    END) AS "AMS_NUM_BUILDINGS",
       SUM(CASE WHEN bc.city = 'Amsterdam'  THEN bc.surf END) AS "AMS_TOTAL_SURFACE_SQ_M",
       -- Rotterdam columns
       SUM(CASE WHEN bc.city = 'Rotterdam'  THEN 1    END) AS "RTM_NUM_BUILDINGS",
       SUM(CASE WHEN bc.city = 'Rotterdam'  THEN bc.surf END) AS "RTM_TOTAL_SURFACE_SQ_M"
FROM   bldg_city bc
GROUP  BY bc."CLASS", bc."SUBCLASS"
ORDER  BY bc."CLASS", bc."SUBCLASS"
LIMIT  20;
```

These ten queries progress from simple data inspection to the fully‑formed comparison report (query #10) that a real‑estate analyst can run after removing the LIMIT clause to obtain the complete results.
