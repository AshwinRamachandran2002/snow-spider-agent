--Description: Side‑by‑side comparison of Amsterdam vs Rotterdam building statistics (count & total surface) by CLASS/SUBCLASS.
WITH ams AS (
    SELECT "GEO_CORDINATES" AS "POLY"
    FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS."V_ADMINISTRATIVE" a,
           LATERAL FLATTEN(input => a."NAMES") f
    WHERE  f.value::STRING ILIKE '%Amsterdam%'
      AND  "ADMIN_LEVEL" = '8'
    LIMIT 1
),
rdam AS (
    SELECT "GEO_CORDINATES" AS "POLY"
    FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS."V_ADMINISTRATIVE" a,
           LATERAL FLATTEN(input => a."NAMES") f
    WHERE  f.value::STRING ILIKE '%Rotterdam%'
      AND  "ADMIN_LEVEL" = '8'
    LIMIT 1
),
ams_aggr AS (
    SELECT
           b."CLASS",
           b."SUBCLASS",
           COUNT(*)                          AS "NUM_BUILDINGS_AMS",
           SUM(b."SURFACE_AREA_SQ_M"::FLOAT) AS "TOTAL_AREA_AMS_SQ_M"
    FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS."V_BUILDING" b
    JOIN   ams a
          ON ST_CONTAINS(a."POLY", ST_CENTROID(b."GEO_CORDINATES"))
    GROUP  BY b."CLASS", b."SUBCLASS"
),
rdam_aggr AS (
    SELECT
           b."CLASS",
           b."SUBCLASS",
           COUNT(*)                          AS "NUM_BUILDINGS_RDAM",
           SUM(b."SURFACE_AREA_SQ_M"::FLOAT) AS "TOTAL_AREA_RDAM_SQ_M"
    FROM   NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS."V_BUILDING" b
    JOIN   rdam r
          ON ST_CONTAINS(r."POLY", ST_CENTROID(b."GEO_CORDINATES"))
    GROUP  BY b."CLASS", b."SUBCLASS"
)
SELECT
       COALESCE(a."CLASS",  r."CLASS")    AS "CLASS",
       COALESCE(a."SUBCLASS", r."SUBCLASS") AS "SUBCLASS",
       a."NUM_BUILDINGS_AMS",
       a."TOTAL_AREA_AMS_SQ_M",
       r."NUM_BUILDINGS_RDAM",
       r."TOTAL_AREA_RDAM_SQ_M"
FROM   ams_aggr a
FULL  OUTER JOIN rdam_aggr r
      ON a."CLASS" = r."CLASS"
     AND a."SUBCLASS" = r."SUBCLASS"
ORDER BY 1, 2
LIMIT 20
