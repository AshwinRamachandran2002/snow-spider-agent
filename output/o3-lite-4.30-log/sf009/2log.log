-- 9. Combine both city aggregations side‑by‑side
WITH ams AS (
  SELECT a."GEO_CORDINATES" AS "poly"
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ADMINISTRATIVE" a,
       LATERAL FLATTEN(input => a."NAMES") f
  WHERE a."ADMIN_LEVEL" = '8'
    AND f.value::STRING ILIKE '%Amsterdam%'
  LIMIT 1
),
rot AS (
  SELECT a."GEO_CORDINATES" AS "poly"
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ADMINISTRATIVE" a,
       LATERAL FLATTEN(input => a."NAMES") f
  WHERE a."ADMIN_LEVEL" = '8'
    AND f.value::STRING ILIKE '%Rotterdam%'
  LIMIT 1
),
ams_agg AS (
  SELECT b."CLASS",
         b."SUBCLASS",
         COUNT(*)                                       AS "amsterdam_buildings",
         SUM(TRY_TO_NUMBER(b."SURFACE_AREA_SQ_M"))      AS "amsterdam_surface_m2"
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_BUILDING" b, ams
  WHERE ST_INTERSECTS(b."GEO_CORDINATES", ams."poly")
  GROUP BY b."CLASS", b."SUBCLASS"
),
rot_agg AS (
  SELECT b."CLASS",
         b."SUBCLASS",
         COUNT(*)                                       AS "rotterdam_buildings",
         SUM(TRY_TO_NUMBER(b."SURFACE_AREA_SQ_M"))      AS "rotterdam_surface_m2"
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_BUILDING" b, rot
  WHERE ST_INTERSECTS(b."GEO_CORDINATES", rot."poly")
  GROUP BY b."CLASS", b."SUBCLASS"
)
SELECT COALESCE(a."CLASS", r."CLASS")      AS "CLASS",
       COALESCE(a."SUBCLASS", r."SUBCLASS") AS "SUBCLASS",
       a."amsterdam_buildings",
       a."amsterdam_surface_m2",
       r."rotterdam_buildings",
       r."rotterdam_surface_m2"
FROM ams_agg a
FULL OUTER JOIN rot_agg r
   ON a."CLASS" = r."CLASS" 
  AND a."SUBCLASS" = r."SUBCLASS"
ORDER BY "CLASS", "SUBCLASS";
