        SUM("SURFACE")                   AS "TOTAL_SURFACE_SQM"
    FROM buildings_in_cities
    GROUP BY "BUILDING_CLASS","BUILDING_SUBCLASS","CITY"
)
SELECT
    "BUILDING_CLASS"                                      AS building_class,
    "BUILDING_SUBCLASS"                                   AS building_subclass,
    COALESCE(MAX(CASE WHEN "CITY"='Amsterdam'
                      THEN "TOTAL_SURFACE_SQM" END),0)    AS amsterdam_total_surface_sqm,
    COALESCE(MAX(CASE WHEN "CITY"='Amsterdam'
                      THEN "TOTAL_BUILDINGS"   END),0)    AS amsterdam_total_buildings,
    COALESCE(MAX(CASE WHEN "CITY"='Rotterdam'
                      THEN "TOTAL_SURFACE_SQM" END),0)    AS rotterdam_total_surface_sqm,
    COALESCE(MAX(CASE WHEN "CITY"='Rotterdam'
                      THEN "TOTAL_BUILDINGS"   END),0)    AS rotterdam_total_buildings
FROM city_aggregates
GROUP BY
    "BUILDING_CLASS",
    "BUILDING_SUBCLASS"
ORDER BY
    "BUILDING_CLASS",
    "BUILDING_SUBCLASS";
