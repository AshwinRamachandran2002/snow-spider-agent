Relevant columns, possible usages and draft filtering conditions
• V_BUILDING."CLASS":            main building‑class we need to group by  
• V_BUILDING."SUBCLASS":         sub‑classification – 2nd level grouping  
• V_BUILDING."SURFACE_AREA_SQ_M": surface area in m² – numeric (cast to NUMBER) to SUM  
• V_BUILDING."ID":               row identifier – can be counted for “number of buildings”  
• V_BUILDING."GEO_CORDINATES":   GEOGRAPHY geometry – lets us locate the building

• V_ADMINISTRATIVE."NAMES":      contains the locality/municipality names in many languages  
• V_ADMINISTRATIVE."ADMIN_LEVEL":  administrative level (municipality usually 8)  
• V_ADMINISTRATIVE."GEO_CORDINATES": GEOGRAPHY geometry of the city boundary – use for a spatial clip

Typical conditions we will need  
1. Locate the municipal polygons for Amsterdam and Rotterdam  
   WHERE f.value::STRING ILIKE '%Amsterdam%'   or  '%Rotterdam%' inside flattened "NAMES"  
   AND "ADMIN_LEVEL" = '8'          -- municipality  
2. Clip buildings that fall inside those polygons with  
   ST_INTERSECTS(b."GEO_CORDINATES", c."GEO_CORDINATES")

━━━━━━━━━━━━━━━━━━━━━━━━━━━━
Exploratory & final SQLs (10 pieces, simplest ➜ final report)

```sql
-- 1. Quick look at raw building rows
SELECT * 
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_BUILDING"
LIMIT 20;
```

```sql
-- 2. Distinct building classes and subclasses that exist
SELECT DISTINCT 
       "CLASS", 
       "SUBCLASS"
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_BUILDING"
ORDER BY 1,2
LIMIT 20;
```

```sql
-- 3. Check how many buildings have a numeric surface value
SELECT COUNT(*) AS "total_rows",
       COUNT("SURFACE_AREA_SQ_M") AS "with_surface_str"
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_BUILDING";
```

```sql
-- 4. Peek at the administrative areas whose names mention Amsterdam / Rotterdam
SELECT a."ID",
       a."ADMIN_LEVEL",
       f.value::STRING AS "name_text"
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ADMINISTRATIVE"  a,
     LATERAL FLATTEN(input => a."NAMES") f
WHERE f.value::STRING ILIKE '%Amsterdam%' 
   OR f.value::STRING ILIKE '%Rotterdam%'
LIMIT 20;
```

```sql
-- 5. Retrieve the full city polygons for Amsterdam & Rotterdam (admin level 8)
SELECT a."ID",
       f.value::STRING AS "city_name",
       a."GEO_CORDINATES"
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ADMINISTRATIVE" a,
     LATERAL FLATTEN(input => a."NAMES") f
WHERE a."ADMIN_LEVEL" = '8'
  AND (f.value::STRING ILIKE '%Amsterdam%' OR f.value::STRING ILIKE '%Rotterdam%');
```

```sql
-- 6. Verify the geographic test: take one Amsterdam polygon and list 5 buildings inside it
WITH ams AS (
  SELECT a."GEO_CORDINATES" AS "poly"
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ADMINISTRATIVE" a,
       LATERAL FLATTEN(input => a."NAMES") f
  WHERE a."ADMIN_LEVEL" = '8'
    AND f.value::STRING ILIKE '%Amsterdam%'
  LIMIT 1
)
SELECT b."ID",
       b."CLASS",
       b."SUBCLASS",
       b."SURFACE_AREA_SQ_M"
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_BUILDING" b,
     ams
WHERE ST_INTERSECTS(b."GEO_CORDINATES", ams."poly")
LIMIT 5;
```

```sql
-- 7. Aggregate Amsterdam buildings by class / subclass
WITH ams AS (
  SELECT a."GEO_CORDINATES" AS "poly"
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ADMINISTRATIVE" a,
       LATERAL FLATTEN(input => a."NAMES") f
  WHERE a."ADMIN_LEVEL" = '8'
    AND f.value::STRING ILIKE '%Amsterdam%'
  LIMIT 1
)
SELECT b."CLASS",
       b."SUBCLASS",
       COUNT(*) AS "amsterdam_buildings",
       SUM(TRY_TO_NUMBER(b."SURFACE_AREA_SQ_M")) AS "amsterdam_surface_m2"
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_BUILDING" b,
     ams
WHERE ST_INTERSECTS(b."GEO_CORDINATES", ams."poly")
GROUP BY b."CLASS", b."SUBCLASS"
ORDER BY b."CLASS", b."SUBCLASS"
LIMIT 20;
```

```sql
-- 8. Aggregate Rotterdam buildings by class / subclass
WITH rot AS (
  SELECT a."GEO_CORDINATES" AS "poly"
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ADMINISTRATIVE" a,
       LATERAL FLATTEN(input => a."NAMES") f
  WHERE a."ADMIN_LEVEL" = '8'
    AND f.value::STRING ILIKE '%Rotterdam%'
  LIMIT 1
)
SELECT b."CLASS",
       b."SUBCLASS",
       COUNT(*) AS "rotterdam_buildings",
       SUM(TRY_TO_NUMBER(b."SURFACE_AREA_SQ_M")) AS "rotterdam_surface_m2"
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_BUILDING" b,
     rot
WHERE ST_INTERSECTS(b."GEO_CORDINATES", rot."poly")
GROUP BY b."CLASS", b."SUBCLASS"
ORDER BY b."CLASS", b."SUBCLASS"
LIMIT 20;
```

```sql
-- 9. Combine both city aggregations side‑by‑side
WITH ams AS (
  SELECT a."GEO_CORDINATES" AS "poly"
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ADMINISTRATIVE" a,
       LATERAL FLATTEN(input => a."NAMES") f
  WHERE a."ADMIN_LEVEL" = '8'
    AND f.value::STRING ILIKE '%Amsterdam%'
  LIMIT 1
),
rot AS (
  SELECT a."GEO_CORDINATES" AS "poly"
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ADMINISTRATIVE" a,
       LATERAL FLATTEN(input => a."NAMES") f
  WHERE a."ADMIN_LEVEL" = '8'
    AND f.value::STRING ILIKE '%Rotterdam%'
  LIMIT 1
),
ams_agg AS (
  SELECT b."CLASS",
         b."SUBCLASS",
         COUNT(*)                                       AS "amsterdam_buildings",
         SUM(TRY_TO_NUMBER(b."SURFACE_AREA_SQ_M"))      AS "amsterdam_surface_m2"
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_BUILDING" b, ams
  WHERE ST_INTERSECTS(b."GEO_CORDINATES", ams."poly")
  GROUP BY b."CLASS", b."SUBCLASS"
),
rot_agg AS (
  SELECT b."CLASS",
         b."SUBCLASS",
         COUNT(*)                                       AS "rotterdam_buildings",
         SUM(TRY_TO_NUMBER(b."SURFACE_AREA_SQ_M"))      AS "rotterdam_surface_m2"
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_BUILDING" b, rot
  WHERE ST_INTERSECTS(b."GEO_CORDINATES", rot."poly")
  GROUP BY b."CLASS", b."SUBCLASS"
)
SELECT COALESCE(a."CLASS", r."CLASS")      AS "CLASS",
       COALESCE(a."SUBCLASS", r."SUBCLASS") AS "SUBCLASS",
       a."amsterdam_buildings",
       a."amsterdam_surface_m2",
       r."rotterdam_buildings",
       r."rotterdam_surface_m2"
FROM ams_agg a
FULL OUTER JOIN rot_agg r
   ON a."CLASS" = r."CLASS" 
  AND a."SUBCLASS" = r."SUBCLASS"
ORDER BY "CLASS", "SUBCLASS";
```

```sql
-- 10. (Optional) apply numeric formatting & NULL‑to‑zero presentation for final report
WITH final AS (
  /* insert the query #9 here */
)
SELECT "CLASS",
       "SUBCLASS",
       COALESCE("amsterdam_buildings", 0)  AS "ams_buildings",
       COALESCE("amsterdam_surface_m2",0)  AS "ams_surface_m2",
       COALESCE("rotterdam_buildings", 0)  AS "rtm_buildings",
       COALESCE("rotterdam_surface_m2",0)  AS "rtm_surface_m2"
FROM final
ORDER BY "CLASS", "SUBCLASS";
```

