--Description: comprehensive side‑by‑side building‑classification comparison for Amsterdam vs Rotterdam
-- • find each city’s admin‑level‑8 polygon by matching names in V_ADMINISTRATIVE
-- • intersect V_BUILDING geometries with each polygon
-- • aggregate per CLASS/SUBCLASS: count(*) and SUM(surface)
-- • FULL OUTER JOIN Amsterdam & Rotterdam results
-- • convert NULLs to zeros so both cities appear on every row
WITH
-- Amsterdam polygon
ams_poly AS (
  SELECT a."GEO_CORDINATES" AS poly
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ADMINISTRATIVE" a,
       LATERAL FLATTEN(input => a."NAMES") f
  WHERE a."ADMIN_LEVEL" = '8'
    AND f.value::STRING ILIKE '%Amsterdam%'
  LIMIT 1
),
-- Rotterdam polygon
rtm_poly AS (
  SELECT a."GEO_CORDINATES" AS poly
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ADMINISTRATIVE" a,
       LATERAL FLATTEN(input => a."NAMES") f
  WHERE a."ADMIN_LEVEL" = '8'
    AND f.value::STRING ILIKE '%Rotterdam%'
  LIMIT 1
),
-- Amsterdam aggregation
ams AS (
  SELECT b."CLASS",
         b."SUBCLASS",
         COUNT(*)                                  AS ams_cnt,
         SUM(TRY_TO_NUMBER(b."SURFACE_AREA_SQ_M")) AS ams_area
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_BUILDING" b, ams_poly p
  WHERE ST_INTERSECTS(b."GEO_CORDINATES", p.poly)
  GROUP BY b."CLASS", b."SUBCLASS"
),
-- Rotterdam aggregation
rtm AS (
  SELECT b."CLASS",
         b."SUBCLASS",
         COUNT(*)                                  AS rtm_cnt,
         SUM(TRY_TO_NUMBER(b."SURFACE_AREA_SQ_M")) AS rtm_area
  FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_BUILDING" b, rtm_poly p
  WHERE ST_INTERSECTS(b."GEO_CORDINATES", p.poly)
  GROUP BY b."CLASS", b."SUBCLASS"
)
SELECT COALESCE(ams."CLASS", rtm."CLASS")       AS "CLASS",
       COALESCE(ams."SUBCLASS", rtm."SUBCLASS") AS "SUBCLASS",
       COALESCE(ams_cnt, 0)                     AS "amsterdam_buildings",
       COALESCE(ams_area, 0)                    AS "amsterdam_surface_m2",
       COALESCE(rtm_cnt, 0)                     AS "rotterdam_buildings",
       COALESCE(rtm_area, 0)                    AS "rotterdam_surface_m2"
FROM ams
FULL OUTER JOIN rtm
  ON ams."CLASS" = rtm."CLASS"
 AND ams."SUBCLASS" = rtm."SUBCLASS"
ORDER BY "CLASS", "SUBCLASS";
