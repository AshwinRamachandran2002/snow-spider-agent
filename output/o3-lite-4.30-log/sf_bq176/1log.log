    WHERE  "chromosome" = 'chr15'
      AND  "cytoband_name" = '15q11'
),
calc AS (
    SELECT c."case_barcode",
           SUM(c."segment_mean" * c."num_probes") / NULLIF(SUM(c."num_probes"),0) AS "weighted_avg_cn"
    FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02"  c,
         band b
    WHERE c."project_short_name" = 'TCGA-LAML'
      AND c."chromosome" = '15'
      AND c."end_pos"   >= b."b_start"
      AND c."start_pos" <= b."b_stop"
    GROUP BY c."case_barcode"
),
maxval AS (
    SELECT MAX("weighted_avg_cn") AS "top_cn" FROM calc
)
SELECT calc."case_barcode", calc."weighted_avg_cn"
FROM   calc
JOIN   maxval ON calc."weighted_avg_cn" = maxval."top_cn"
LIMIT 20;
