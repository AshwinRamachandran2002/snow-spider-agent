```sql
-- 04. Extract both session_engaged and ga_session_id side by side (Dec‑09)
SELECT
  user_pseudo_id,
  MAX(CASE WHEN ep.key = 'ga_session_id'   THEN ep.value.int_value END) AS ga_session_id,
  MAX(CASE WHEN ep.key = 'session_engaged' THEN ep.value.int_value END) AS session_engaged_flag
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201209`,
     UNNEST(event_params) AS ep
GROUP BY user_pseudo_id
HAVING session_engaged_flag = 1
LIMIT 20;
```

```sql
-- 05. Distinct engaged sessions on one table (Dec‑10)
SELECT DISTINCT
       user_pseudo_id,
       ga_session_id
FROM (
  SELECT
    user_pseudo_id,
    MAX(CASE WHEN ep.key = 'ga_session_id' THEN ep.value.int_value END)   AS ga_session_id,
    MAX(CASE WHEN ep.key = 'session_engaged' THEN ep.value.int_value END) AS session_engaged_flag
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201210`,
       UNNEST(event_params) AS ep
  GROUP BY user_pseudo_id, event_timestamp
)
WHERE session_engaged_flag = 1
LIMIT 20;
```

```sql
-- 06. Union three December days, keep engaged sessions only
WITH dec_tables AS (
  SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201211`
  UNION ALL
  SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201212`
  UNION ALL
  SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201213`
)
SELECT DISTINCT
       user_pseudo_id,
       ga_session_id
FROM (
  SELECT
    user_pseudo_id,
    MAX(CASE WHEN ep.key = 'ga_session_id'   THEN ep.value.int_value END) AS ga_session_id,
    MAX(CASE WHEN ep.key = 'session_engaged' THEN ep.value.int_value END) AS engaged
  FROM dec_tables, UNNEST(event_params) AS ep
  GROUP BY user_pseudo_id, event_timestamp
)
WHERE engaged = 1
LIMIT 20;
```

```sql
