Relevant columns and how they will be used  
(event‑level columns unless otherwise stated)

event_date:           filter to December 2020 tables (events_20201201 – events_20201231)  
event_name:           make sure we stay at the event grain, can be used for quick sanity checks  
event_params:         store every parameter; UNNEST() will be used  
 ‑ key               → look for 'session_engaged' and 'ga_session_id'  
 ‑ value.int_value   → value of the two parameters above (1 = “yes” for session_engaged)  
user_pseudo_id:       visitor identifier (part of the session key)  
ga_session_id (param): second half of the session key; must be extracted from event_params  
Conditions that will be applied  

• event_date like '202012%' (or use only the “events_202012**” tables)  
• key = 'session_engaged'                AND value.int_value = 1  
• key = 'ga_session_id'                  (to retrieve the session id)  

SQL snippets (all SELECT‑only, each limited to 20 rows)

```sql
-- 01. Peek at December‑01 table: basic columns only
SELECT event_date, user_pseudo_id, event_name
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
LIMIT 20;
```

```sql
-- 02. Inspect which event_params keys exist on Dec‑01
SELECT DISTINCT ep.key
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`,
     UNNEST(event_params) AS ep
LIMIT 20;
```

```sql
-- 03. Show events where session_engaged = 1 (Dec‑05 sample)
SELECT event_date, user_pseudo_id, event_name, ep.value.int_value AS session_engaged
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201205`,
     UNNEST(event_params) AS ep
WHERE ep.key = 'session_engaged'
  AND ep.value.int_value = 1
LIMIT 20;
```

```sql
-- 04. Extract both session_engaged and ga_session_id side by side (Dec‑09)
SELECT
  user_pseudo_id,
  MAX(CASE WHEN ep.key = 'ga_session_id'   THEN ep.value.int_value END) AS ga_session_id,
  MAX(CASE WHEN ep.key = 'session_engaged' THEN ep.value.int_value END) AS session_engaged_flag
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201209`,
     UNNEST(event_params) AS ep
GROUP BY user_pseudo_id
HAVING session_engaged_flag = 1
LIMIT 20;
```

```sql
-- 05. Distinct engaged sessions on one table (Dec‑10)
SELECT DISTINCT
       user_pseudo_id,
       ga_session_id
FROM (
  SELECT
    user_pseudo_id,
    MAX(CASE WHEN ep.key = 'ga_session_id' THEN ep.value.int_value END)   AS ga_session_id,
    MAX(CASE WHEN ep.key = 'session_engaged' THEN ep.value.int_value END) AS session_engaged_flag
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201210`,
       UNNEST(event_params) AS ep
  GROUP BY user_pseudo_id, event_timestamp
)
WHERE session_engaged_flag = 1
LIMIT 20;
```

```sql
-- 06. Union three December days, keep engaged sessions only
WITH dec_tables AS (
  SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201211`
  UNION ALL
  SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201212`
  UNION ALL
  SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201213`
)
SELECT DISTINCT
       user_pseudo_id,
       ga_session_id
FROM (
  SELECT
    user_pseudo_id,
    MAX(CASE WHEN ep.key = 'ga_session_id'   THEN ep.value.int_value END) AS ga_session_id,
    MAX(CASE WHEN ep.key = 'session_engaged' THEN ep.value.int_value END) AS engaged
  FROM dec_tables, UNNEST(event_params) AS ep
  GROUP BY user_pseudo_id, event_timestamp
)
WHERE engaged = 1
LIMIT 20;
```

```sql
-- 07. Count engaged sessions per user (Dec‑15 only)
SELECT
  user_pseudo_id,
  COUNT(DISTINCT CONCAT(CAST(user_pseudo_id AS STRING),'-',CAST(ga_session_id AS STRING))) AS engaged_sessions
FROM (
  SELECT
    user_pseudo_id,
    MAX(CASE WHEN ep.key = 'ga_session_id'   THEN ep.value.int_value END) AS ga_session_id,
    MAX(CASE WHEN ep.key = 'session_engaged' THEN ep.value.int_value END) AS engaged
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201215`,
       UNNEST(event_params) AS ep
  GROUP BY user_pseudo_id, event_timestamp
)
WHERE engaged = 1
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
-- 08. Bring every December table together via GENERATE_ARRAY to build a list
WITH all_dec AS (
  SELECT *
  FROM UNNEST(GENERATE_ARRAY(1,31)) AS day_num
  JOIN (
    SELECT *
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
    WHERE FALSE
  ) AS dummy ON TRUE  -- dummy just to hold schema
)
SELECT day_num  -- just proof of concept, no rows actually returned
LIMIT 20;
```

```sql
-- 09. Quick overall totals: users & engaged sessions (Dec‑24 sample)
WITH base AS (
  SELECT
    user_pseudo_id,
    MAX(CASE WHEN ep.key = 'ga_session_id'   THEN ep.value.int_value END) AS ga_session_id,
    MAX(CASE WHEN ep.key = 'session_engaged' THEN ep.value.int_value END) AS engaged
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201224`,
       UNNEST(event_params) AS ep
  GROUP BY user_pseudo_id, event_timestamp
)
SELECT
  COUNT(DISTINCT user_pseudo_id)               AS total_users,
  COUNT(DISTINCT CONCAT(user_pseudo_id,'-',ga_session_id)) AS engaged_sessions
FROM base
WHERE engaged = 1
LIMIT 20;
```

