```sql
-- 03. Show events where session_engaged = 1 (Dec‑05 sample)
SELECT event_date, user_pseudo_id, event_name, ep.value.int_value AS session_engaged
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201205`,
     UNNEST(event_params) AS ep
WHERE ep.key = 'session_engaged'
  AND ep.value.int_value = 1
