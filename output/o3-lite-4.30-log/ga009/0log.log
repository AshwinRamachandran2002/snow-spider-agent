```sql
-- 4. Display raw parameter values for `session_engaged`
SELECT event_timestamp,
       ep.value.int_value  AS session_engaged_flag
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`,
     UNNEST(event_params) AS ep
WHERE ep.key = 'session_engaged'
LIMIT 20;
```

```sql
-- 5. Grab `ga_session_id` on the same table/day
SELECT event_timestamp,
       ep.value.int_value AS ga_session_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`,
     UNNEST(event_params) AS ep
WHERE ep.key = 'ga_session_id'
LIMIT 20;
```

```sql
-- 6. Join both parameters back together (single day sample)
SELECT
  user_pseudo_id,
  MAX(CASE WHEN ep.key = 'ga_session_id'    THEN ep.value.int_value END) AS ga_session_id,
  MAX(CASE WHEN ep.key = 'session_engaged'  THEN ep.value.int_value END) AS session_engaged
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201215`,
     UNNEST(event_params) AS ep
GROUP BY user_pseudo_id, event_timestamp
LIMIT 20;
```

```sql
-- 7. Keep only engaged sessions (single day) and show unique session keys
SELECT DISTINCT
  user_pseudo_id,
  ga_session_id
FROM (
  SELECT
    user_pseudo_id,
    MAX(CASE WHEN ep.key = 'ga_session_id'   THEN ep.value.int_value END) AS ga_session_id,
    MAX(CASE WHEN ep.key = 'session_engaged' THEN ep.value.int_value END) AS session_engaged
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201215`,
       UNNEST(event_params) AS ep
  GROUP BY user_pseudo_id, event_timestamp
)
WHERE session_engaged = 1
LIMIT 20;
```

```sql
-- 8. Count engaged sessions per user for one day
SELECT
  user_pseudo_id,
  COUNT(DISTINCT ga_session_id) AS engaged_sessions
FROM (
  SELECT
    user_pseudo_id,
    MAX(CASE WHEN ep.key = 'ga_session_id'   THEN ep.value.int_value END) AS ga_session_id,
    MAX(CASE WHEN ep.key = 'session_engaged' THEN ep.value.int_value END) AS session_engaged
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201215`,
       UNNEST(event_params) AS ep
  GROUP BY user_pseudo_id, event_timestamp
)
WHERE session_engaged = 1
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
-- 9. Extend to the whole of December 2020: create a staging sub‑query
WITH dec_events AS (
  SELECT
    user_pseudo_id,
    MAX(CASE WHEN ep.key = 'ga_session_id'   THEN ep.value.int_value END) AS ga_session_id,
    MAX(CASE WHEN ep.key = 'session_engaged' THEN ep.value.int_value END) AS session_engaged
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(event_params) AS ep
  GROUP BY user_pseudo_id, event_timestamp
)
SELECT
  user_pseudo_id,
  COUNT(DISTINCT ga_session_id) AS engaged_sessions
FROM dec_events
WHERE session_engaged = 1
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER (average engaged sessions per user, December 2020)
WITH dec_events AS (
  SELECT
    user_pseudo_id,
    MAX(CASE WHEN ep.key = 'ga_session_id'   THEN ep.value.int_value END) AS ga_session_id,
    MAX(CASE WHEN ep.key = 'session_engaged' THEN ep.value.int_value END) AS session_engaged
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(event_params) AS ep
  GROUP BY user_pseudo_id, event_timestamp
),
user_level AS (
  SELECT
    user_pseudo_id,
    COUNT(DISTINCT ga_session_id) AS engaged_sessions
  FROM dec_events
  WHERE session_engaged = 1            -- keep only engaged sessions
  GROUP BY user_pseudo_id
)
SELECT
  AVG(engaged_sessions) AS avg_engaged_sessions_per_user
FROM user_level
LIMIT 20;
```

Each query builds on the previous one, moving from basic inspection to the computed metric: the average number of engaged sessions per user in December 2020, where an engaged session is defined by `session_engaged = 1` and a unique session key is (`user_pseudo_id`, `ga_session_id`).
