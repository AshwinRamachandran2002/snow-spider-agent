Begin Exploring Related Columns
Relevant tables and columns  
cleaned_weekly_sales  
  • week_date: filter the 24‑week window (12 weeks before and after 2020‑06‑15).  
  • sales: numeric metric we must compare.  
  • region / platform / age_band / demographic / customer_type: attribute values whose % change in sales will be evaluated.  
  • calendar_year, week_number (optional helpers to validate the chosen weeks).

Typical date conditions we will use  
  – Weeks BEFORE pivot: 2020‑03‑23 ≤ week_date < 2020‑06‑15  
  – Weeks AFTER pivot: 2020‑06‑15 ≤ week_date ≤ 2020‑09‑07  
(The exact Monday boundaries may be adjusted once we inspect the available week_date values.)

Below are ten exploratory‑to‑complex SQL examples (20‑row LIMIT where sensible).  
All identifiers are wrapped in double quotes to stay safe with SQLite.

```sql
-- 1. List the distinct week_date values that sit inside the ±12‑week window
SELECT DISTINCT "week_date"
FROM "cleaned_weekly_sales"
WHERE "week_date" BETWEEN '2020-03-23' AND '2020-09-07'
ORDER BY "week_date"
LIMIT 20;
```

```sql
-- 2. See how many rows we have per week inside the window
SELECT "week_date", COUNT(*) AS row_cnt
FROM "cleaned_weekly_sales"
WHERE "week_date" BETWEEN '2020-03-23' AND '2020-09-07'
GROUP BY "week_date"
ORDER BY "week_date"
LIMIT 20;
```

```sql
-- 3. Total sales for the 12 weeks BEFORE the pivot (all data combined)
SELECT SUM("sales") AS before_sales
FROM "cleaned_weekly_sales"
WHERE "week_date" >= '2020-03-23'
  AND "week_date" <  '2020-06-15';
```

```sql
-- 4. Total sales for the 12 weeks AFTER/ON the pivot (all data combined)
SELECT SUM("sales") AS after_sales
FROM "cleaned_weekly_sales"
WHERE "week_date" >= '2020-06-15'
  AND "week_date" <= '2020-09-07';
```

```sql
-- 5. Sales before vs after by REGION
SELECT
       "region",
       SUM(CASE WHEN "week_date" < '2020-06-15' THEN "sales" END) AS before_sales,
       SUM(CASE WHEN "week_date" >= '2020-06-15' THEN "sales" END) AS after_sales
FROM   "cleaned_weekly_sales"
WHERE  "week_date" BETWEEN '2020-03-23' AND '2020-09-07'
GROUP  BY "region"
LIMIT 20;
```

```sql
-- 6. Percentage change in sales by PLATFORM
WITH t AS (
  SELECT
         "platform",
         SUM(CASE WHEN "week_date" < '2020-06-15' THEN "sales" END) AS before_sales,
         SUM(CASE WHEN "week_date" >= '2020-06-15' THEN "sales" END) AS after_sales
  FROM   "cleaned_weekly_sales"
  WHERE  "week_date" BETWEEN '2020-03-23' AND '2020-09-07'
  GROUP  BY "platform"
)
SELECT "platform",
       before_sales,
       after_sales,
       ROUND((after_sales - before_sales) * 100.0 / NULLIF(before_sales,0),2) AS pct_change
FROM   t
ORDER  BY pct_change
LIMIT 20;
```

```sql
-- 7. Same idea for AGE BAND (abridged to first 20 rows)
WITH t AS (
  SELECT
         "age_band",
         SUM(CASE WHEN "week_date" < '2020-06-15' THEN "sales" END) AS before_sales,
         SUM(CASE WHEN "week_date" >= '2020-06-15' THEN "sales" END) AS after_sales
  FROM   "cleaned_weekly_sales"
  WHERE  "week_date" BETWEEN '2020-03-23' AND '2020-09-07'
  GROUP  BY "age_band"
)
SELECT "age_band",
       ROUND((after_sales - before_sales) * 100.0 / NULLIF(before_sales,0),2) AS pct_change
FROM   t
ORDER  BY pct_change
LIMIT 20;
```

```sql
-- 8. Generic CTE that melts five attribute types into one field
WITH raw AS (
  SELECT "region"        AS attr_val, 'region'        AS attr_type, "week_date", "sales" FROM "cleaned_weekly_sales"
  UNION ALL
  SELECT "platform",         'platform',              "week_date", "sales" FROM "cleaned_weekly_sales"
  UNION ALL
  SELECT "age_band",         'age_band',              "week_date", "sales" FROM "cleaned_weekly_sales"
  UNION ALL
  SELECT "demographic",      'demographic',           "week_date", "sales" FROM "cleaned_weekly_sales"
  UNION ALL
  SELECT "customer_type",    'customer_type',         "week_date", "sales" FROM "cleaned_weekly_sales"
), agg AS (
  SELECT attr_type,
         attr_val,
         SUM(CASE WHEN week_date <  '2020-06-15' THEN sales END) AS before_sales,
         SUM(CASE WHEN week_date >= '2020-06-15' THEN sales END) AS after_sales
  FROM   raw
  WHERE  week_date BETWEEN '2020-03-23' AND '2020-09-07'
  GROUP  BY attr_type, attr_val
)
SELECT *
FROM   agg
LIMIT 20;
```

```sql
-- 9. Average % change per attribute TYPE (across all its values)
WITH raw AS (
  SELECT "region" AS attr_val, 'region' AS attr_type, "week_date", "sales" FROM "cleaned_weekly_sales"
  UNION ALL SELECT "platform",      'platform',   "week_date", "sales" FROM "cleaned_weekly_sales"
  UNION ALL SELECT "age_band",      'age_band',   "week_date", "sales" FROM "cleaned_weekly_sales"
  UNION ALL SELECT "demographic",   'demographic',"week_date", "sales" FROM "cleaned_weekly_sales"
  UNION ALL SELECT "customer_type", 'customer_type',"week_date","sales" FROM "cleaned_weekly_sales"
), pct AS (
  SELECT attr_type,
         attr_val,
         SUM(CASE WHEN week_date <  '2020-06-15' THEN sales END) AS before_sales,
         SUM(CASE WHEN week_date >= '2020-06-15' THEN sales END) AS after_sales
  FROM   raw
  WHERE  week_date BETWEEN '2020-03-23' AND '2020-09-07'
  GROUP  BY attr_type, attr_val
), pct_calc AS (
  SELECT attr_type,
         attr_val,
         ROUND((after_sales - before_sales) * 100.0 / NULLIF(before_sales,0), 2) AS pct_change
  FROM   pct
)
SELECT attr_type,
       ROUND(AVG(pct_change), 2) AS avg_pct_change
FROM   pct_calc
GROUP  BY attr_type
ORDER  BY avg_pct_change
LIMIT 20;
```

```sql
-- 10. Identify the attribute type with the highest NEGATIVE impact on sales
WITH raw AS (
  SELECT "region" AS attr_val, 'region' AS attr_type, "week_date", "sales" FROM "cleaned_weekly_sales"
  UNION ALL SELECT "platform",      'platform',   "week_date", "sales" FROM "cleaned_weekly_sales"
  UNION ALL SELECT "age_band",      'age_band',   "week_date", "sales" FROM "cleaned_weekly_sales"
  UNION ALL SELECT "demographic",   'demographic',"week_date", "sales" FROM "cleaned_weekly_sales"
  UNION ALL SELECT "customer_type", 'customer_type',"week_date","sales" FROM "cleaned_weekly_sales"
), pct AS (
  SELECT attr_type,
         attr_val,
         SUM(CASE WHEN week_date <  '2020-06-15' THEN sales END) AS before_sales,
         SUM(CASE WHEN week_date >= '2020-06-15' THEN sales END) AS after_sales
  FROM   raw
  WHERE  week_date BETWEEN '2020-03-23' AND '2020-09-07'
  GROUP  BY attr_type, attr_val
), pct_calc AS (
  SELECT attr_type,
         ROUND((after_sales - before_sales) * 100.0 / NULLIF(before_sales,0), 2) AS pct_change
  FROM   pct
), final_rank AS (
  SELECT attr_type,
         ROUND(AVG(pct_change), 2) AS avg_pct_change
  FROM   pct_calc
  GROUP  BY attr_type
)
SELECT *
FROM   final_rank
ORDER  BY avg_pct_change        -- ascending => most negative first
LIMIT 1;
```

The final query (#10) returns one row: the attribute type whose average percentage change in sales is the lowest (i.e., greatest negative impact) along with that average % change value.
