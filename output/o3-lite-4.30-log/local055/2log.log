FROM "albums" AS al
JOIN "artists" AS ar ON al."ArtistId" = ar."ArtistId"
LIMIT 20;
```

```sql
-- 3. Show a few tracks together with their album and artist
SELECT t."TrackId", t."Name" AS "Track",
       al."Title"  AS "Album",
       ar."Name"   AS "Artist"
FROM   "tracks"  AS t
JOIN   "albums"  AS al ON t."AlbumId"  = al."AlbumId"
JOIN   "artists" AS ar ON al."ArtistId" = ar."ArtistId"
LIMIT 20;
```

```sql
-- 4. Inspect some invoice line items together with track and artist
SELECT ii."InvoiceLineId",
       ii."UnitPrice", ii."Quantity",
       t."Name"  AS "Track",
       ar."Name" AS "Artist"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS al ON t."AlbumId"  = al."AlbumId"
JOIN   "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
LIMIT 20;
```

```sql
-- 5. Compute total sales per artist (amount = UnitPrice * Quantity)
SELECT ar."ArtistId",
       ar."Name",
       SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS al ON t."AlbumId"  = al."AlbumId"
JOIN   "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "TotalSales" DESC
LIMIT 20;
```

```sql
-- 6. Identify the single highest‑selling artist (tie‑break alphabetically)
SELECT ar."ArtistId", ar."Name", SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS al ON t."AlbumId"  = al."AlbumId"
JOIN   "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "TotalSales" DESC, ar."Name" ASC
LIMIT 1;
```

```sql
-- 7. Identify the single lowest‑selling artist (tie‑break alphabetically)
SELECT ar."ArtistId", ar."Name", SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS al ON t."AlbumId"  = al."AlbumId"
JOIN   "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "TotalSales" ASC, ar."Name" ASC
LIMIT 1;
```

```sql
-- 8. Customer‑level spending on the top‑ and bottom‑selling artists
WITH top_bot AS (
    -- union the top and bottom artist IDs
    SELECT ar."ArtistId"
    FROM   "invoice_items" AS ii
    JOIN   "tracks"  AS t  ON ii."TrackId" = t."TrackId"
    JOIN   "albums"  AS al ON t."AlbumId"  = al."AlbumId"
    JOIN   "artists" AS ar ON al."ArtistId" = ar."ArtistId"
    GROUP  BY ar."ArtistId", ar."Name"
    HAVING SUM(ii."UnitPrice" * ii."Quantity") = (
        SELECT MAX(sales) FROM (
            SELECT SUM(ii2."UnitPrice"*ii2."Quantity") AS sales
            FROM "invoice_items" ii2
            JOIN "tracks" t2 ON ii2."TrackId" = t2."TrackId"
            JOIN "albums" al2 ON t2."AlbumId" = al2."AlbumId"
            GROUP BY al2."ArtistId"
        )
    )
    UNION
    SELECT ar."ArtistId"
    FROM   "invoice_items" AS ii
    JOIN   "tracks"  AS t  ON ii."TrackId" = t."TrackId"
    JOIN   "albums"  AS al ON t."AlbumId"  = al."AlbumId"
    JOIN   "artists" AS ar ON al."ArtistId" = ar."ArtistId"
    GROUP  BY ar."ArtistId", ar."Name"
    HAVING SUM(ii."UnitPrice" * ii."Quantity") = (
        SELECT MIN(sales) FROM (
            SELECT SUM(ii2."UnitPrice"*ii2."Quantity") AS sales
            FROM "invoice_items" ii2
            JOIN "tracks" t2 ON ii2."TrackId" = t2."TrackId"
            JOIN "albums" al2 ON t2."AlbumId" = al2."AlbumId"
            GROUP BY al2."ArtistId"
        )
    )
)
SELECT inv."CustomerId",
       ar."ArtistId",
       ar."Name"          AS "Artist",
       SUM(ii."UnitPrice" * ii."Quantity") AS "CustomerSpend"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t   ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS al  ON t."AlbumId" = al."AlbumId"
JOIN   "artists"       AS ar  ON al."ArtistId" = ar."ArtistId"
JOIN   "invoices"      AS inv ON ii."InvoiceId" = inv."InvoiceId"
WHERE  ar."ArtistId" IN (SELECT "ArtistId" FROM top_bot)
GROUP  BY inv."CustomerId", ar."ArtistId", ar."Name"
LIMIT 20;
```

```sql
-- 9. Average spend per customer for each of the two target artists
WITH artist_sales AS (
    SELECT inv."CustomerId",
           ar."ArtistId",
           ar."Name" AS "Artist",
           SUM(ii."UnitPrice" * ii."Quantity") AS "Spend"
    FROM   "invoice_items" AS ii
    JOIN   "tracks"        AS t   ON ii."TrackId" = t."TrackId"
    JOIN   "albums"        AS al  ON t."AlbumId"  = al."AlbumId"
    JOIN   "artists"       AS ar  ON al."ArtistId" = ar."ArtistId"
    JOIN   "invoices"      AS inv ON ii."InvoiceId" = inv."InvoiceId"
    GROUP  BY inv."CustomerId", ar."ArtistId", ar."Name"
),
tops AS (
    SELECT "ArtistId" FROM artist_sales
    GROUP  BY "ArtistId"
    ORDER  BY SUM("Spend") DESC, MIN("Artist") ASC
    LIMIT 1
),
bots AS (
    SELECT "ArtistId" FROM artist_sales
    GROUP  BY "ArtistId"
    ORDER  BY SUM("Spend") ASC, MIN("Artist") ASC
    LIMIT 1
),
avg_spend AS (
    SELECT 'top'  AS which, AVG("Spend") AS avg_spend
    FROM   artist_sales
    WHERE  "ArtistId" = (SELECT "ArtistId" FROM tops)
    UNION ALL
    SELECT 'bottom', AVG("Spend")
    FROM   artist_sales
    WHERE  "ArtistId" = (SELECT "ArtistId" FROM bots)
)
SELECT * FROM avg_spend
LIMIT 20;
```

```sql
-- 10. Absolute difference between the two averages (final step)
WITH artist_sales AS (
    SELECT inv."CustomerId",
           ar."ArtistId",
           SUM(ii."UnitPrice" * ii."Quantity") AS "Spend"
    FROM   "invoice_items" AS ii
    JOIN   "tracks"        AS t   ON ii."TrackId" = t."TrackId"
    JOIN   "albums"        AS al  ON t."AlbumId"  = al."AlbumId"
    JOIN   "artists"       AS ar  ON al."ArtistId" = ar."ArtistId"
    JOIN   "invoices"      AS inv ON ii."InvoiceId" = inv."InvoiceId"
    GROUP  BY inv."CustomerId", ar."ArtistId"
),
tops AS (
    SELECT "ArtistId" FROM artist_sales
    GROUP  BY "ArtistId"
    ORDER  BY SUM("Spend") DESC, MIN("ArtistId") -- tie‑break later
    LIMIT 1
),
bots AS (
    SELECT "ArtistId" FROM artist_sales
    GROUP  BY "ArtistId"
    ORDER  BY SUM("Spend") ASC, MIN("ArtistId")
    LIMIT 1
),
avg_vals AS (
    SELECT AVG("Spend") AS avg_top
    FROM   artist_sales
    WHERE  "ArtistId" = (SELECT "ArtistId" FROM tops)
),
avg_vals2 AS (
    SELECT AVG("Spend") AS avg_bot
    FROM   artist_sales
    WHERE  "ArtistId" = (SELECT "ArtistId" FROM bots)
)
SELECT ABS( (SELECT avg_top FROM avg_vals) - (SELECT avg_bot FROM avg_vals2) )
       AS "AbsDiffAvgSpend";
```  

Each query is purposefully distinct and builds toward the computation asked for, staying within the limit of 20 rows where applicable.
