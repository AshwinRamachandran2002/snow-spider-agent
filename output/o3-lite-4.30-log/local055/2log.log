Begin Exploring Related Columns
Relevant tables, columns, and how they will be used  

albums  
• AlbumId : join‐key to tracks and invoice_items (through tracks)  
• ArtistId : lets us aggregate sales by artist  

artists  
• ArtistId : join‐key to albums  
• Name : used for tie‑breaking alphabetically and for reporting  

tracks  
• TrackId : join‐key to invoice_items  
• AlbumId : join to albums in order to reach the artist  

invoice_items  
• InvoiceId : join‐key to invoices so we can reach the customer  
• TrackId : join to tracks  
• UnitPrice, Quantity : sales amount per line (UnitPrice × Quantity)  

invoices  
• InvoiceId : join‐key to invoice_items  
• CustomerId : lets us compute how much each customer spent on a given artist  

customers  
• CustomerId : used for customer‑level spending and to count / average customers  

Typical join conditions  
albums.AlbumId = tracks.AlbumId  
artists.ArtistId = albums.ArtistId  
tracks.TrackId = invoice_items.TrackId  
invoice_items.InvoiceId = invoices.InvoiceId  
invoices.CustomerId = customers.CustomerId  

Below are 10 exploratory SQL statements (all `SELECT` only, each capped with `LIMIT 20`) that progressively build up to the final answer.

```sql
-- 1. Quick look at existing artists
SELECT DISTINCT a."ArtistId", a."Name"
FROM "artists" AS a
LIMIT 20;
```

```sql
-- 2. Show how albums map to artists
SELECT al."AlbumId", al."Title", ar."Name" AS "Artist"
FROM "albums" AS al
JOIN "artists" AS ar ON al."ArtistId" = ar."ArtistId"
LIMIT 20;
```

```sql
-- 3. Show a few tracks together with their album and artist
SELECT t."TrackId", t."Name" AS "Track",
       al."Title"  AS "Album",
       ar."Name"   AS "Artist"
FROM   "tracks"  AS t
JOIN   "albums"  AS al ON t."AlbumId"  = al."AlbumId"
JOIN   "artists" AS ar ON al."ArtistId" = ar."ArtistId"
LIMIT 20;
```

```sql
-- 4. Inspect some invoice line items together with track and artist
SELECT ii."InvoiceLineId",
       ii."UnitPrice", ii."Quantity",
       t."Name"  AS "Track",
       ar."Name" AS "Artist"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS al ON t."AlbumId"  = al."AlbumId"
JOIN   "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
LIMIT 20;
```

```sql
-- 5. Compute total sales per artist (amount = UnitPrice * Quantity)
SELECT ar."ArtistId",
       ar."Name",
       SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS al ON t."AlbumId"  = al."AlbumId"
JOIN   "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "TotalSales" DESC
LIMIT 20;
```

```sql
-- 6. Identify the single highest‑selling artist (tie‑break alphabetically)
SELECT ar."ArtistId", ar."Name", SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS al ON t."AlbumId"  = al."AlbumId"
JOIN   "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "TotalSales" DESC, ar."Name" ASC
LIMIT 1;
```

```sql
-- 7. Identify the single lowest‑selling artist (tie‑break alphabetically)
SELECT ar."ArtistId", ar."Name", SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS al ON t."AlbumId"  = al."AlbumId"
JOIN   "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "TotalSales" ASC, ar."Name" ASC
LIMIT 1;
```

```sql
-- 8. Customer‑level spending on the top‑ and bottom‑selling artists
WITH top_bot AS (
    -- union the top and bottom artist IDs
    SELECT ar."ArtistId"
    FROM   "invoice_items" AS ii
    JOIN   "tracks"  AS t  ON ii."TrackId" = t."TrackId"
    JOIN   "albums"  AS al ON t."AlbumId"  = al."AlbumId"
    JOIN   "artists" AS ar ON al."ArtistId" = ar."ArtistId"
    GROUP  BY ar."ArtistId", ar."Name"
    HAVING SUM(ii."UnitPrice" * ii."Quantity") = (
        SELECT MAX(sales) FROM (
            SELECT SUM(ii2."UnitPrice"*ii2."Quantity") AS sales
            FROM "invoice_items" ii2
            JOIN "tracks" t2 ON ii2."TrackId" = t2."TrackId"
            JOIN "albums" al2 ON t2."AlbumId" = al2."AlbumId"
            GROUP BY al2."ArtistId"
        )
    )
    UNION
    SELECT ar."ArtistId"
    FROM   "invoice_items" AS ii
    JOIN   "tracks"  AS t  ON ii."TrackId" = t."TrackId"
    JOIN   "albums"  AS al ON t."AlbumId"  = al."AlbumId"
    JOIN   "artists" AS ar ON al."ArtistId" = ar."ArtistId"
    GROUP  BY ar."ArtistId", ar."Name"
    HAVING SUM(ii."UnitPrice" * ii."Quantity") = (
        SELECT MIN(sales) FROM (
            SELECT SUM(ii2."UnitPrice"*ii2."Quantity") AS sales
            FROM "invoice_items" ii2
            JOIN "tracks" t2 ON ii2."TrackId" = t2."TrackId"
            JOIN "albums" al2 ON t2."AlbumId" = al2."AlbumId"
            GROUP BY al2."ArtistId"
        )
    )
)
SELECT inv."CustomerId",
       ar."ArtistId",
       ar."Name"          AS "Artist",
       SUM(ii."UnitPrice" * ii."Quantity") AS "CustomerSpend"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t   ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS al  ON t."AlbumId" = al."AlbumId"
JOIN   "artists"       AS ar  ON al."ArtistId" = ar."ArtistId"
JOIN   "invoices"      AS inv ON ii."InvoiceId" = inv."InvoiceId"
WHERE  ar."ArtistId" IN (SELECT "ArtistId" FROM top_bot)
GROUP  BY inv."CustomerId", ar."ArtistId", ar."Name"
LIMIT 20;
```

```sql
