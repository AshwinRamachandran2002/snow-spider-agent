    SELECT inv."CustomerId",
           ar."ArtistId",
           ar."Name" AS "Artist",
           SUM(ii."UnitPrice" * ii."Quantity") AS "Spend"
    FROM   "invoice_items" AS ii
    JOIN   "tracks"        AS t   ON ii."TrackId" = t."TrackId"
    JOIN   "albums"        AS al  ON t."AlbumId"  = al."AlbumId"
    JOIN   "artists"       AS ar  ON al."ArtistId" = ar."ArtistId"
    JOIN   "invoices"      AS inv ON ii."InvoiceId" = inv."InvoiceId"
    GROUP  BY inv."CustomerId", ar."ArtistId", ar."Name"
),
tops AS (
    SELECT "ArtistId" FROM artist_sales
    GROUP  BY "ArtistId"
    ORDER  BY SUM("Spend") DESC, MIN("Artist") ASC
    LIMIT 1
),
bots AS (
    SELECT "ArtistId" FROM artist_sales
    GROUP  BY "ArtistId"
    ORDER  BY SUM("Spend") ASC, MIN("Artist") ASC
    LIMIT 1
),
avg_spend AS (
    SELECT 'top'  AS which, AVG("Spend") AS avg_spend
    FROM   artist_sales
    WHERE  "ArtistId" = (SELECT "ArtistId" FROM tops)
    UNION ALL
