-- 10. Absolute difference between the two averages (final step)
WITH artist_sales AS (
    SELECT inv."CustomerId",
           ar."ArtistId",
           SUM(ii."UnitPrice" * ii."Quantity") AS "Spend"
    FROM   "invoice_items" AS ii
    JOIN   "tracks"        AS t   ON ii."TrackId" = t."TrackId"
    JOIN   "albums"        AS al  ON t."AlbumId"  = al."AlbumId"
    JOIN   "artists"       AS ar  ON al."ArtistId" = ar."ArtistId"
    JOIN   "invoices"      AS inv ON ii."InvoiceId" = inv."InvoiceId"
    GROUP  BY inv."CustomerId", ar."ArtistId"
),
tops AS (
    SELECT "ArtistId" FROM artist_sales
    GROUP  BY "ArtistId"
    ORDER  BY SUM("Spend") DESC, MIN("ArtistId") -- tie‑break later
    LIMIT 1
),
bots AS (
    SELECT "ArtistId" FROM artist_sales
    GROUP  BY "ArtistId"
    ORDER  BY SUM("Spend") ASC, MIN("ArtistId")
    LIMIT 1
),
avg_vals AS (
    SELECT AVG("Spend") AS avg_top
    FROM   artist_sales
    WHERE  "ArtistId" = (SELECT "ArtistId" FROM tops)
),
avg_vals2 AS (
    SELECT AVG("Spend") AS avg_bot
    FROM   artist_sales
    WHERE  "ArtistId" = (SELECT "ArtistId" FROM bots)
)
SELECT ABS( (SELECT avg_top FROM avg_vals) - (SELECT avg_bot FROM avg_vals2) )
       AS "AbsDiffAvgSpend";
