Begin Exploring Related Columns
Relevant columns and their potential usage (for the whole task)

artists
• ArtistId: joins to albums, identifies each artist.  
• Name: used for the alphabetical tie‑breaker and for display.

albums  
• AlbumId: joins to tracks; represents the “album” that is being sold.  
• ArtistId: links an album back to an artist.

tracks  
• TrackId: joins to invoice_items to see what was actually bought.  
• AlbumId: links each track back to its album (and therefore its artist).  
• UnitPrice: individual track price (used later when we multiply by Quantity).

invoice_items  
• InvoiceId: joins to invoices so we can get the customer.  
• TrackId: links the bought track back to tracks → albums → artists.  
• UnitPrice / Quantity: sales value for that line (UnitPrice × Quantity).

invoices  
• InvoiceId: header for an order, used to reach the customer.  
• CustomerId: identifies which customer made the purchase.

Conditions / filters that will be useful  
• Join chains: artists → albums → tracks → invoice_items → invoices.  
• We’ll aggregate SUM(invoice_items.UnitPrice * invoice_items.Quantity).  
• ORDER BY total_sales DESC / ASC; break ties with ORDER BY artists.Name.  
• To isolate the two target artists we can use a sub‑query or CTE.  
• When averaging customer spend, GROUP BY CustomerId, then average.

Exploratory SQL queries  
(The LIMIT 20 is just to keep outputs small when you test.)

```sql
-- 1. Show the first 20 artists
SELECT DISTINCT ArtistId, Name
FROM artists
LIMIT 20;
```

```sql
-- 2. List 20 albums together with their artist names
SELECT a.AlbumId, a.Title, ar.Name AS Artist
FROM albums AS a
JOIN artists AS ar ON ar.ArtistId = a.ArtistId
LIMIT 20;
```

```sql
-- 3. Peek at tracks and their album & artist (20 rows)
SELECT t.TrackId, t.Name AS TrackName, al.Title AS AlbumTitle, ar.Name AS Artist
FROM tracks AS t
JOIN albums AS al  ON al.AlbumId  = t.AlbumId
JOIN artists AS ar ON ar.ArtistId = al.ArtistId
LIMIT 20;
```

```sql
-- 4. Show some invoice lines with customer and track price info
SELECT ii.InvoiceLineId, ii.TrackId, ii.UnitPrice, ii.Quantity,
       inv.CustomerId
FROM invoice_items AS ii
JOIN invoices AS inv ON inv.InvoiceId = ii.InvoiceId
LIMIT 20;
```

```sql
-- 5. Compute total sales value per artist (20 artists shown)
SELECT ar.ArtistId, ar.Name,
       SUM(ii.UnitPrice * ii.Quantity) AS TotalSales
FROM artists AS ar
JOIN albums  AS al ON al.ArtistId = ar.ArtistId
JOIN tracks  AS t  ON t.AlbumId    = al.AlbumId
JOIN invoice_items AS ii ON ii.TrackId = t.TrackId
GROUP BY ar.ArtistId, ar.Name
ORDER BY TotalSales DESC, ar.Name
LIMIT 20;
```

```sql
-- 6. Artist with the highest overall sales (after tie‑breaker)
SELECT ar.ArtistId, ar.Name,
       SUM(ii.UnitPrice * ii.Quantity) AS TotalSales
FROM artists AS ar
JOIN albums  AS al ON al.ArtistId = ar.ArtistId
JOIN tracks  AS t  ON t.AlbumId    = al.AlbumId
JOIN invoice_items AS ii ON ii.TrackId = t.TrackId
GROUP BY ar.ArtistId, ar.Name
ORDER BY TotalSales DESC, ar.Name
LIMIT 1;
```

```sql
-- 7. Artist with the lowest overall sales (after tie‑breaker)
SELECT ar.ArtistId, ar.Name,
       SUM(ii.UnitPrice * ii.Quantity) AS TotalSales
FROM artists AS ar
JOIN albums  AS al ON al.ArtistId = ar.ArtistId
JOIN tracks  AS t  ON t.AlbumId    = al.AlbumId
JOIN invoice_items AS ii ON ii.TrackId = t.TrackId
GROUP BY ar.ArtistId, ar.Name
ORDER BY TotalSales ASC, ar.Name
LIMIT 1;
```

```sql
-- 8. Amount each customer spent on the top‑selling artist
WITH top_artist AS (
    SELECT ar.ArtistId
    FROM artists AS ar
    JOIN albums  AS al ON al.ArtistId = ar.ArtistId
    JOIN tracks  AS t  ON t.AlbumId    = al.AlbumId
    JOIN invoice_items AS ii ON ii.TrackId = t.TrackId
    GROUP BY ar.ArtistId, ar.Name
    ORDER BY SUM(ii.UnitPrice * ii.Quantity) DESC, ar.Name
    LIMIT 1
)
SELECT inv.CustomerId,
       SUM(ii.UnitPrice * ii.Quantity) AS SpendOnTopArtist
FROM invoice_items AS ii
JOIN tracks  AS t   ON t.TrackId  = ii.TrackId
JOIN albums  AS al  ON al.AlbumId = t.AlbumId
JOIN invoices AS inv ON inv.InvoiceId = ii.InvoiceId
WHERE al.ArtistId = (SELECT ArtistId FROM top_artist)
GROUP BY inv.CustomerId
LIMIT 20;
```

```sql
-- 9. Amount each customer spent on the lowest‑selling artist
WITH bottom_artist AS (
    SELECT ar.ArtistId
    FROM artists AS ar
    JOIN albums  AS al ON al.ArtistId = ar.ArtistId
    JOIN tracks  AS t  ON t.AlbumId    = al.AlbumId
    JOIN invoice_items AS ii ON ii.TrackId = t.TrackId
    GROUP BY ar.ArtistId, ar.Name
    ORDER BY SUM(ii.UnitPrice * ii.Quantity) ASC, ar.Name
    LIMIT 1
)
SELECT inv.CustomerId,
       SUM(ii.UnitPrice * ii.Quantity) AS SpendOnBottomArtist
FROM invoice_items AS ii
JOIN tracks  AS t   ON t.TrackId  = ii.TrackId
JOIN albums  AS al  ON al.AlbumId = t.AlbumId
JOIN invoices AS inv ON inv.InvoiceId = ii.InvoiceId
WHERE al.ArtistId = (SELECT ArtistId FROM bottom_artist)
GROUP BY inv.CustomerId
LIMIT 20;
```

```sql
-- 10. Absolute difference between the two customer‑average spends
WITH top_artist AS (
    SELECT ar.ArtistId
    FROM artists AS ar
    JOIN albums  AS al ON al.ArtistId = ar.ArtistId
    JOIN tracks  AS t  ON t.AlbumId    = al.AlbumId
    JOIN invoice_items AS ii ON ii.TrackId = t.TrackId
    GROUP BY ar.ArtistId, ar.Name
    ORDER BY SUM(ii.UnitPrice * ii.Quantity) DESC, ar.Name
    LIMIT 1
), bottom_artist AS (
    SELECT ar.ArtistId
    FROM artists AS ar
    JOIN albums  AS al ON al.ArtistId = ar.ArtistId
    JOIN tracks  AS t  ON t.AlbumId    = al.AlbumId
    JOIN invoice_items AS ii ON ii.TrackId = t.TrackId
    GROUP BY ar.ArtistId, ar.Name
    ORDER BY SUM(ii.UnitPrice * ii.Quantity) ASC, ar.Name
    LIMIT 1
), top_spend_per_cust AS (
    SELECT inv.CustomerId,
           SUM(ii.UnitPrice * ii.Quantity) AS Spend
    FROM invoice_items AS ii
    JOIN tracks  AS t   ON t.TrackId  = ii.TrackId
    JOIN albums  AS al  ON al.AlbumId = t.AlbumId
    JOIN invoices AS inv ON inv.InvoiceId = ii.InvoiceId
    WHERE al.ArtistId = (SELECT ArtistId FROM top_artist)
    GROUP BY inv.CustomerId
), bottom_spend_per_cust AS (
    SELECT inv.CustomerId,
           SUM(ii.UnitPrice * ii.Quantity) AS Spend
    FROM invoice_items AS ii
    JOIN tracks  AS t   ON t.TrackId  = ii.TrackId
    JOIN albums  AS al  ON al.AlbumId = t.AlbumId
    JOIN invoices AS inv ON inv.InvoiceId = ii.InvoiceId
    WHERE al.ArtistId = (SELECT ArtistId FROM bottom_artist)
    GROUP BY inv.CustomerId
)
SELECT ABS( (SELECT AVG(Spend) FROM top_spend_per_cust)
          - (SELECT AVG(Spend) FROM bottom_spend_per_cust)
          ) AS AbsDifferenceInAvgSpend;
```
