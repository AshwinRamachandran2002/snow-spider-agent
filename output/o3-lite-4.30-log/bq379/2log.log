```sql
--Description (thinking process inline):
-- Goal: return the approved gene symbol whose overall association score with psoriasis
--       is closest to the mean of all psoriasis scores.
-- Steps:
--   1) Use diseaseId 'EFO_0000676' (psoriasis) in associationByOverallIndirect
--      – this table is present in the open_targets_platform dataset and stores
--      overall association scores between diseases and targets.
--   2) Compute the mean score for all targets linked to psoriasis.
--   3) For every target, calculate the absolute difference between its score
--      and that mean.
--   4) Rank targets by this difference and keep the one with the smallest gap.
--   5) Join to the targets table to translate the targetId to its approvedSymbol.

WITH psori_scores AS (
  SELECT targetId, score
  FROM `bigquery-public-data.open_targets_platform.associationByOverallIndirect`
  WHERE diseaseId = 'EFO_0000676'                  -- psoriasis
    AND score IS NOT NULL
),
mean_val AS (
  SELECT AVG(score) AS avg_score FROM psori_scores
),
closest AS (
  SELECT
    p.targetId,
    p.score,
    ABS(p.score - m.avg_score) AS diff,
    ROW_NUMBER() OVER (ORDER BY ABS(p.score - m.avg_score)) AS rn
  FROM psori_scores p
  CROSS JOIN mean_val m
)
SELECT t.approvedSymbol
FROM closest c
JOIN `bigquery-public-data.open_targets_platform.targets` t
  ON t.id = c.targetId
WHERE c.rn = 1;
```
