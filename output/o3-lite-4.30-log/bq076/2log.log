FROM `bigquery-public-data.chicago_crime.crime`
WHERE year = 2016
LIMIT 20;
```

```sql
-- 3) Sample 20 motor‑vehicle‑theft incidents in 2016
SELECT unique_key, date, block, arrest
FROM `bigquery-public-data.chicago_crime.crime`
WHERE year = 2016
  AND primary_type = 'MOTOR VEHICLE THEFT'
LIMIT 20;
```

```sql
-- 4) Distinct months (number) that had any crime in 2016
SELECT DISTINCT EXTRACT(MONTH FROM date) AS month_num
FROM `bigquery-public-data.chicago_crime.crime`
WHERE year = 2016
ORDER BY month_num
LIMIT 20;
```

```sql
-- 5) Distinct months that had motor‑vehicle‑theft incidents in 2016
SELECT DISTINCT EXTRACT(MONTH FROM date) AS month_num
FROM `bigquery-public-data.chicago_crime.crime`
WHERE year = 2016
  AND primary_type = 'MOTOR VEHICLE THEFT'
ORDER BY month_num
LIMIT 20;
```

```sql
-- 6) Count motor‑vehicle‑theft incidents per month for 2016
SELECT
  EXTRACT(MONTH FROM date) AS month_num,
  COUNT(*) AS mv_theft_cnt
FROM `bigquery-public-data.chicago_crime.crime`
WHERE year = 2016
  AND primary_type = 'MOTOR VEHICLE THEFT'
GROUP BY month_num
ORDER BY month_num
LIMIT 20;
```

```sql
-- 7) Same counts, ordered from highest to lowest
SELECT
  EXTRACT(MONTH FROM date) AS month_num,
  COUNT(*) AS mv_theft_cnt
FROM `bigquery-public-data.chicago_crime.crime`
WHERE year = 2016
  AND primary_type = 'MOTOR VEHICLE THEFT'
GROUP BY month_num
ORDER BY mv_theft_cnt DESC
LIMIT 20;
```

```sql
-- 8) Use a sub‑query to isolate the highest count
SELECT MAX(mv_theft_cnt) AS max_monthly_mv_theft_2016
FROM (
  SELECT
    EXTRACT(MONTH FROM date) AS month_num,
    COUNT(*) AS mv_theft_cnt
  FROM `bigquery-public-data.chicago_crime.crime`
  WHERE year = 2016
    AND primary_type = 'MOTOR VEHICLE THEFT'
  GROUP BY month_num
);
```

```sql
-- 9) Alternative formulation with QUALIFY and window function
SELECT DISTINCT mv_theft_cnt
FROM (
  SELECT
    EXTRACT(MONTH FROM date) AS month_num,
    COUNT(*) OVER (PARTITION BY EXTRACT(MONTH FROM date)) AS mv_theft_cnt
  FROM `bigquery-public-data.chicago_crime.crime`
  WHERE year = 2016
    AND primary_type = 'MOTOR VEHICLE THEFT'
)
QUALIFY mv_theft_cnt = MAX(mv_theft_cnt) OVER ()
LIMIT 20;
```

```sql
-- 10) Final concise answer: highest number of motor vehicle thefts in
--     any single month during 2016
SELECT MAX(monthly_total) AS highest_single_month_mv_thefts_2016
FROM (
  SELECT
    EXTRACT(MONTH FROM date) AS month_num,
    COUNT(*)                AS monthly_total
  FROM `bigquery-public-data.chicago_crime.crime`
  WHERE year = 2016
    AND primary_type = 'MOTOR VEHICLE THEFT'
  GROUP BY month_num
);
```
