-- 7. Description: Join the per‑question lag, then combine ‘answered‑within‑hour’ counts with totals to get percentages
WITH per_question AS (
  SELECT
    EXTRACT(DAYOFWEEK FROM q.creation_date) AS dow,
    TIMESTAMP_DIFF(MIN(a.creation_date), q.creation_date, MINUTE) AS mins_to_first
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN `bigquery-public-data.stackoverflow.posts_answers`      a
    ON a.parent_id = q.id
  GROUP BY q.id, q.creation_date
),
answered AS (
  SELECT
    dow,
    COUNTIF(mins_to_first <= 60) AS answered_in_hour
  FROM per_question
  GROUP BY dow
),
totals AS (
  SELECT
    EXTRACT(DAYOFWEEK FROM creation_date) AS dow,
    COUNT(*) AS total_questions
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  GROUP BY dow
)
SELECT
  t.dow,
  a.answered_in_hour,
  t.total_questions,
  SAFE_DIVIDE(a.answered_in_hour, t.total_questions) AS pct_answered_within_hour
FROM totals t
LEFT JOIN answered a USING (dow)
ORDER BY pct_answered_within_hour DESC
LIMIT 20
