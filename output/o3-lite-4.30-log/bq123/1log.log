```sql
--Description: Find the weekday (name) whose share of questions answered within 60 minutes is the 3rd‑highest.
--             Steps (in CTEs):
--             1) per_question   – join each question to its first answer and measure the lag in minutes.
--             2) answered_cnt   – per weekday, count questions whose first answer came ≤ 60 minutes.
--             3) total_cnt      – per weekday, count all questions asked.
--             4) pct_by_dow     – compute the percentage answered within an hour for every weekday.
--             5) ranked         – rank weekdays by that percentage and pick rank = 3 (third highest).
WITH per_question AS (
  SELECT
    EXTRACT(DAYOFWEEK FROM q.creation_date) AS dow,                 -- 1=Sun … 7=Sat
    TIMESTAMP_DIFF(MIN(a.creation_date), q.creation_date, MINUTE) AS mins_to_first
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN `bigquery-public-data.stackoverflow.posts_answers` a
    ON a.parent_id = q.id
  GROUP BY q.id, q.creation_date
),
answered_cnt AS (
  SELECT
    dow,
    COUNTIF(mins_to_first <= 60) AS answered_within_hour
  FROM per_question
  GROUP BY dow
),
total_cnt AS (
  SELECT
    EXTRACT(DAYOFWEEK FROM creation_date) AS dow,
    COUNT(*) AS total_questions
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  GROUP BY dow
),
pct_by_dow AS (
  SELECT
    t.dow,
    SAFE_DIVIDE(a.answered_within_hour, t.total_questions) AS pct_answered_within_hour
  FROM total_cnt t
  JOIN answered_cnt a USING (dow)
),
ranked AS (
  SELECT
    dow,
    pct_answered_within_hour,
    DENSE_RANK() OVER (ORDER BY pct_answered_within_hour DESC) AS rnk
  FROM pct_by_dow
)
SELECT
  CASE dow
    WHEN 1 THEN 'Sunday'
    WHEN 2 THEN 'Monday'
    WHEN 3 THEN 'Tuesday'
    WHEN 4 THEN 'Wednesday'
    WHEN 5 THEN 'Thursday'
    WHEN 6 THEN 'Friday'
    WHEN 7 THEN 'Saturday'
  END AS weekday_name,
  pct_answered_within_hour
FROM ranked
WHERE rnk = 3;
