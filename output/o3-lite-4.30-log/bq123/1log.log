Relevant columns – what they are good for

`posts_questions.id` : primary‑key of every question, used to join to the answers  
`posts_questions.creation_date` : when the question was asked – needed for day‑of‑week and elapsed time calculations  
`posts_answers.parent_id` : the id of the question that the answer belongs to – join key  
`posts_answers.creation_date` : when each answer was posted – we will take the MIN() of this per question  
`posts_questions.answer_count` ( optional ) : can be used to filter to questions that actually have answers (>0) so we do not waste work  
`posts_questions.post_type_id` ( =1 for questions in the all‑in‑one table, but already filtered for us in posts_questions ) – no extra filter needed here  

Common filter / join conditions you will see below

• `FROM   \`bigquery-public-data.stackoverflow.posts_questions\`   q`  
• `JOIN   \`bigquery-public-data.stackoverflow.posts_answers\`   a  
     ON a.parent_id = q.id`  
• `WHERE  a.creation_date IS NOT NULL`  
• Sometimes add `AND q.answer_count > 0` (safe but optional)  

The 10 exploratory → final queries
(Each returns at most 20 rows so you can inspect the data in the UI before running the final heavy query.)

```sql
-- 1. Description: Peek at a handful of recent questions
SELECT id, creation_date, answer_count
FROM `bigquery-public-data.stackoverflow.posts_questions`
ORDER BY creation_date DESC
LIMIT 20;
```

```sql
-- 2. Description: Peek at some answers and their parent_id link
SELECT id, parent_id, creation_date
FROM `bigquery-public-data.stackoverflow.posts_answers`
ORDER BY creation_date DESC
LIMIT 20;
```

```sql
-- 3. Description: Join a small sample of Q&A and show the time difference in minutes
SELECT
  q.id AS question_id,
  q.creation_date AS question_time,
  MIN(a.creation_date) AS first_answer_time,
  TIMESTAMP_DIFF(MIN(a.creation_date), q.creation_date, MINUTE) AS minutes_to_first_answer
FROM `bigquery-public-data.stackoverflow.posts_questions` q
JOIN `bigquery-public-data.stackoverflow.posts_answers`  a
  ON a.parent_id = q.id
GROUP BY question_id, question_time
ORDER BY question_time DESC
LIMIT 20;
```

```sql
-- 4. Description: Same as #3 but show only cases answered within 60 minutes
SELECT
  q.id,
  q.creation_date,
  MIN(a.creation_date) AS first_answer_time
FROM `bigquery-public-data.stackoverflow.posts_questions` q
JOIN `bigquery-public-data.stackoverflow.posts_answers`  a
  ON a.parent_id = q.id
GROUP BY q.id, q.creation_date
HAVING TIMESTAMP_DIFF(MIN(a.creation_date), q.creation_date, MINUTE) <= 60
LIMIT 20;
```

```sql
-- 5. Description: Compute raw counts of (answered‑within‑hour) per day‑of‑week
SELECT
  EXTRACT(DAYOFWEEK FROM q.creation_date) AS dow,              -- 1=Sun…7=Sat
  COUNT(DISTINCT q.id) AS answered_in_hour
FROM `bigquery-public-data.stackoverflow.posts_questions` q
JOIN `bigquery-public-data.stackoverflow.posts_answers`  a
  ON a.parent_id = q.id
GROUP BY dow
HAVING TIMESTAMP_DIFF(MIN(a.creation_date), q.creation_date, MINUTE) <= 60
ORDER BY dow
LIMIT 20;
```

```sql
-- 6. Description: Total questions per day‑of‑week (needed for the denominator)
SELECT
  EXTRACT(DAYOFWEEK FROM creation_date) AS dow,
  COUNT(*) AS total_questions
FROM `bigquery-public-data.stackoverflow.posts_questions`
GROUP BY dow
ORDER BY dow
LIMIT 20;
```

```sql
-- 7. Description: Combine answered‑within‑hour counts with total counts to get percentages
WITH answered AS (
  SELECT
    EXTRACT(DAYOFWEEK FROM q.creation_date) AS dow,
    COUNT(DISTINCT q.id) AS answered_in_hour
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN `bigquery-public-data.stackoverflow.posts_answers`  a
    ON a.parent_id = q.id
  GROUP BY dow
  HAVING TIMESTAMP_DIFF(MIN(a.creation_date), q.creation_date, MINUTE) <= 60
),
totals AS (
  SELECT
    EXTRACT(DAYOFWEEK FROM creation_date) AS dow,
    COUNT(*) AS total_questions
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  GROUP BY dow
)
SELECT
  t.dow,
  answered_in_hour,
  total_questions,
  SAFE_DIVIDE(answered_in_hour, total_questions) AS pct_answered_within_hour
FROM totals t
LEFT JOIN answered a USING (dow)
ORDER BY pct_answered_within_hour DESC
LIMIT 20;
```

```sql
-- 8. Description: Add a human‑readable weekday name
WITH base AS (
  SELECT
    EXTRACT(DAYOFWEEK FROM q.creation_date)                 AS dow,
    COUNT(DISTINCT q.id)                                    AS answered_in_hour
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN `bigquery-public-data.stackoverflow.posts_answers`  a
    ON a.parent_id = q.id
  GROUP BY dow
  HAVING TIMESTAMP_DIFF(MIN(a.creation_date), q.creation_date, MINUTE) <= 60
), totals AS (
  SELECT
    EXTRACT(DAYOFWEEK FROM creation_date) AS dow,
    COUNT(*) AS total_questions
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  GROUP BY dow
)
SELECT
  FORMAT_DATE('%A', DATE_SUB(CURRENT_DATE(), INTERVAL (8-dow) DAY)) AS weekday_name,
  SAFE_DIVIDE(b.answered_in_hour, t.total_questions)                AS pct_answered_within_hour
FROM totals t
JOIN base   b USING (dow)
ORDER BY pct_answered_within_hour DESC
LIMIT 20;
```

```sql
-- 9. Description: Rank the weekdays by percentage and keep the third highest
WITH answered AS (
  SELECT
    EXTRACT(DAYOFWEEK FROM q.creation_date) AS dow,
    COUNT(DISTINCT q.id) AS answered_in_hour
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN `bigquery-public-data.stackoverflow.posts_answers`  a
    ON a.parent_id = q.id
  GROUP BY dow
  HAVING TIMESTAMP_DIFF(MIN(a.creation_date), q.creation_date, MINUTE) <= 60
), totals AS (
  SELECT
    EXTRACT(DAYOFWEEK FROM creation_date) AS dow,
    COUNT(*) AS total_questions
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  GROUP BY dow
), stats AS (
  SELECT
    dow,
    SAFE_DIVIDE(answered_in_hour, total_questions) AS pct
  FROM answered
  JOIN totals USING (dow)
)
SELECT
  FORMAT_DATE('%A', DATE_SUB(CURRENT_DATE(), INTERVAL (8-dow) DAY)) AS weekday_name,
  pct
FROM (
  SELECT *, DENSE_RANK() OVER (ORDER BY pct DESC) AS rnk
  FROM stats
)
WHERE rnk = 3
LIMIT 20;
```

```sql
-- 10. Description (FINAL): Same as #9 without LIMIT, returns exactly the third‑highest weekday and its percentage
WITH answered AS (
  SELECT
    EXTRACT(DAYOFWEEK FROM q.creation_date) AS dow,
    COUNT(DISTINCT q.id) AS answered_in_hour
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN `bigquery-public-data.stackoverflow.posts_answers`  a
    ON a.parent_id = q.id
  GROUP BY dow
  HAVING TIMESTAMP_DIFF(MIN(a.creation_date), q.creation_date, MINUTE) <= 60
), totals AS (
  SELECT
    EXTRACT(DAYOFWEEK FROM creation_date) AS dow,
    COUNT(*) AS total_questions
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  GROUP BY dow
), stats AS (
  SELECT
    dow,
    SAFE_DIVIDE(answered_in_hour, total_questions) AS pct
  FROM answered
  JOIN totals USING (dow)
)
SELECT
  FORMAT_DATE('%A', DATE_SUB(CURRENT_DATE(), INTERVAL (8-dow) DAY)) AS weekday_name,
  pct AS percentage_answered_within_one_hour
FROM (
  SELECT *, DENSE_RANK() OVER (ORDER BY pct DESC) AS rnk
  FROM stats
)
WHERE rnk = 3;
```

