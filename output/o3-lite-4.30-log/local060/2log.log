```sql
--4 Description: Compare total revenue generated under each promotion code so we can
--   confirm which code(s) dominate and later decide what identifies “no‑promotion”.
SELECT s."promo_id",
       p."promo_name",
       SUM(s."amount_sold") AS total_sales
FROM   "sales"       AS s
LEFT   JOIN "promotions" AS p
       ON s."promo_id" = p."promo_id"
GROUP  BY s."promo_id", p."promo_name"
ORDER  BY total_sales DESC
LIMIT 20;
```

```sql
--5 Description: Verify which rows in the time dimension belong to Q4‑2019 and Q4‑2020.
SELECT DISTINCT "time_id",
       "calendar_year",
       "calendar_quarter_number"
FROM   "times"
WHERE  "calendar_year" IN (2019, 2020)
  AND  "calendar_quarter_number" = 4
LIMIT 20;
```

```sql
--6 Description: Q4‑2019 U.S. city sales with NO active promotion.
--   “No promotion” rows are defined where the joined promo_name is either NULL
--   or explicitly contains the words ‘no promotion’.
SELECT cu."cust_city",
       ROUND(SUM(s."amount_sold"), 2) AS sales_q4_2019
FROM   "sales"       AS s
JOIN   "times"       AS t  ON s."time_id"   = t."time_id"
JOIN   "customers"   AS cu ON s."cust_id"   = cu."cust_id"
JOIN   "countries"   AS co ON cu."country_id" = co."country_id"
LEFT   JOIN "promotions" p  ON s."promo_id" = p."promo_id"
WHERE  co."country_name" LIKE 'United States%'
  AND  t."calendar_year" = 2019
  AND  t."calendar_quarter_number" = 4
  AND  (p."promo_name" IS NULL OR LOWER(p."promo_name") LIKE '%no promotion%')
GROUP  BY cu."cust_city"
ORDER  BY sales_q4_2019 DESC
LIMIT 20;
```

```sql
--7 Description: Q4‑2020 U.S. city sales with NO active promotion (same rule as #6).
SELECT cu."cust_city",
       ROUND(SUM(s."amount_sold"), 2) AS sales_q4_2020
FROM   "sales"       AS s
JOIN   "times"       AS t  ON s."time_id"   = t."time_id"
JOIN   "customers"   AS cu ON s."cust_id"   = cu."cust_id"
JOIN   "countries"   AS co ON cu."country_id" = co."country_id"
LEFT   JOIN "promotions" p  ON s."promo_id" = p."promo_id"
WHERE  co."country_name" LIKE 'United States%'
  AND  t."calendar_year" = 2020
  AND  t."calendar_quarter_number" = 4
  AND  (p."promo_name" IS NULL OR LOWER(p."promo_name") LIKE '%no promotion%')
GROUP  BY cu."cust_city"
ORDER  BY sales_q4_2020 DESC
LIMIT 20;
```

```sql
--8 Description: Cities whose non‑promo sales grew by at least 20 % from Q4‑2019 to Q4‑2020.
WITH q19 AS (
    SELECT cu."cust_city", SUM(s."amount_sold") AS s19
    FROM   "sales" s
    JOIN   "times" t      ON s."time_id" = t."time_id"
    JOIN   "customers" cu ON s."cust_id" = cu."cust_id"
    JOIN   "countries" co ON cu."country_id" = co."country_id"
    LEFT   JOIN "promotions" p ON s."promo_id" = p."promo_id"
    WHERE  co."country_name" LIKE 'United States%'
      AND  t."calendar_year" = 2019
      AND  t."calendar_quarter_number" = 4
      AND  (p."promo_name" IS NULL OR LOWER(p."promo_name") LIKE '%no promotion%')
    GROUP  BY cu."cust_city"
),
q20 AS (
    SELECT cu."cust_city", SUM(s."amount_sold") AS s20
    FROM   "sales" s
    JOIN   "times" t      ON s."time_id" = t."time_id"
    JOIN   "customers" cu ON s."cust_id" = cu."cust_id"
    JOIN   "countries" co ON cu."country_id" = co."country_id"
    LEFT   JOIN "promotions" p ON s."promo_id" = p."promo_id"
    WHERE  co."country_name" LIKE 'United States%'
      AND  t."calendar_year" = 2020
      AND  t."calendar_quarter_number" = 4
      AND  (p."promo_name" IS NULL OR LOWER(p."promo_name") LIKE '%no promotion%')
    GROUP  BY cu."cust_city"
)
SELECT q20."cust_city",
       ROUND(q19.s19,2) AS sales_q4_2019,
       ROUND(q20.s20,2) AS sales_q4_2020,
       ROUND((q20.s20 - q19.s19)*100.0/q19.s19,2) AS pct_growth
FROM   q19
JOIN   q20 ON q19."cust_city" = q20."cust_city"
WHERE  q20.s20 >= 1.20 * q19.s19
ORDER  BY pct_growth DESC
LIMIT 20;
