```sql
--10 Description: For the top‑20 % products identified in #9, compute their share of total
--   non‑promo sales in Q4‑2019 and Q4‑2020 inside the growth cities, then list the
--   change in share (2020 – 2019) in descending order.
WITH growth_cities AS (
    /* same CTE as in query #9 (omitted here for brevity) */
    WITH q19 AS (
        SELECT cu."cust_city", SUM(s."amount_sold") AS s19
        FROM "sales" s
        JOIN "times" t      ON s."time_id" = t."time_id"
        JOIN "customers" cu ON s."cust_id" = cu."cust_id"
        JOIN "countries" co ON cu."country_id" = co."country_id"
        LEFT JOIN "promotions" p ON s."promo_id" = p."promo_id"
        WHERE co."country_name" LIKE 'United States%'
          AND t."calendar_year" = 2019
          AND t."calendar_quarter_number" = 4
          AND (p."promo_name" IS NULL OR LOWER(p."promo_name") LIKE '%no promotion%')
        GROUP BY cu."cust_city"
    ),
    q20 AS (
        SELECT cu."cust_city", SUM(s."amount_sold") AS s20
        FROM "sales" s
        JOIN "times" t      ON s."time_id" = t."time_id"
        JOIN "customers" cu ON s."cust_id" = cu."cust_id"
        JOIN "countries" co ON cu."country_id" = co."country_id"
        LEFT JOIN "promotions" p ON s."promo_id" = p."promo_id"
        WHERE co."country_name" LIKE 'United States%'
          AND t."calendar_year" = 2020
          AND t."calendar_quarter_number" = 4
          AND (p."promo_name" IS NULL OR LOWER(p."promo_name") LIKE '%no promotion%')
        GROUP BY cu."cust_city"
    )
    SELECT q20."cust_city"
    FROM   q19
    JOIN   q20 ON q19."cust_city" = q20."cust_city"
    WHERE  q20.s20 >= 1.20 * q19.s19
),
top_products AS (
    -- reuse ranking logic from #9
    WITH prod_tot AS (
        SELECT s."prod_id",
               SUM(s."amount_sold") AS tot_sales
        FROM   "sales" s
        JOIN   "times" t        ON s."time_id" = t."time_id"
        JOIN   "customers" cu   ON s."cust_id" = cu."cust_id"
        JOIN   growth_cities gc ON cu."cust_city" = gc."cust_city"
        LEFT   JOIN "promotions" p ON s."promo_id" = p."promo_id"
        WHERE  t."calendar_year" IN (2019, 2020)
          AND  t."calendar_quarter_number" = 4
          AND  (p."promo_name" IS NULL OR LOWER(p."promo_name") LIKE '%no promotion%')
        GROUP  BY s."prod_id"
    ),
    ranked AS (
        SELECT pt.*,
               RANK()  OVER (ORDER BY pt.tot_sales DESC) AS rk,
               COUNT(*) OVER ()                          AS cnt
        FROM prod_tot pt
    )
    SELECT "prod_id"
    FROM   ranked
    WHERE  rk <= 0.20 * cnt
),
sales_by_prod_year AS (
    SELECT s."prod_id",
           t."calendar_year",
           SUM(s."amount_sold") AS sales_amt
    FROM   "sales" s
    JOIN   "times" t        ON s."time_id" = t."time_id"
    JOIN   "customers" cu   ON s."cust_id" = cu."cust_id"
    JOIN   growth_cities gc ON cu."cust_city" = gc."cust_city"
    JOIN   top_products tp  ON s."prod_id"   = tp."prod_id"
    LEFT   JOIN "promotions" p ON s."promo_id" = p."promo_id"
    WHERE  t."calendar_year" IN (2019, 2020)
      AND  t."calendar_quarter_number" = 4
      AND  (p."promo_name" IS NULL OR LOWER(p."promo_name") LIKE '%no promotion%')
    GROUP  BY s."prod_id", t."calendar_year"
),
totals_per_year AS (
    SELECT t."calendar_year",
           SUM(s."amount_sold") AS total_sales
    FROM   "sales" s
    JOIN   "times" t        ON s."time_id" = t."time_id"
    JOIN   "customers" cu   ON s."cust_id" = cu."cust_id"
    JOIN   growth_cities gc ON cu."cust_city" = gc."cust_city"
    LEFT   JOIN "promotions" p ON s."promo_id" = p."promo_id"
    WHERE  t."calendar_year" IN (2019, 2020)
      AND  t."calendar_quarter_number" = 4
      AND  (p."promo_name" IS NULL OR LOWER(p."promo_name") LIKE '%no promotion%')
    GROUP  BY t."calendar_year"
)
SELECT sb."prod_id",
       ROUND(SUM(CASE WHEN sb."calendar_year" = 2019 THEN sb."sales_amt" END) * 1.0 /
             (SELECT total_sales FROM totals_per_year WHERE calendar_year = 2019), 4) AS share_2019,
       ROUND(SUM(CASE WHEN sb."calendar_year" = 2020 THEN sb."sales_amt" END) * 1.0 /
             (SELECT total_sales FROM totals_per_year WHERE calendar_year = 2020), 4) AS share_2020,
       ROUND(
           (SUM(CASE WHEN sb."calendar_year" = 2020 THEN sb."sales_amt" END) * 1.0 /
             (SELECT total_sales FROM totals_per_year WHERE calendar_year = 2020))
         - (SUM(CASE WHEN sb."calendar_year" = 2019 THEN sb."sales_amt" END) * 1.0 /
             (SELECT total_sales FROM totals_per_year WHERE calendar_year = 2019))
       , 4) AS share_change
FROM   sales_by_prod_year sb
GROUP  BY sb."prod_id"
ORDER  BY share_change DESC
LIMIT 20;
```
