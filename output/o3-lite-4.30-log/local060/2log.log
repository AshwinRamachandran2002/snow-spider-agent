--Description: Show the most frequently used promotion codes in the sales table
--together with their promo names; the code that represents “no promotion”
--should either have a descriptive name (e.g., “No Promotion”) or simply be
--the one that dominates the transactions.  Listing them in descending order
--of occurrence helps us spot it quickly.
SELECT s."promo_id",
       p."promo_name",
       COUNT(*) AS occurrences
FROM   "sales"       AS s
LEFT   JOIN "promotions" AS p
       ON s."promo_id" = p."promo_id"
GROUP  BY s."promo_id", p."promo_name"
ORDER  BY occurrences DESC
LIMIT 20;
