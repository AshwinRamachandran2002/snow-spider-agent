['countries', 'customers', 'promotions', 'products', 'times', 'channels', 'sales', 'costs', 'supplementary_demographics', 'currency']
Begin Exploring Related Columns
Relevant columns and why they matter  
• sales.prod_id : product identifier (needed for ranking / share calculations)  
• sales.cust_id : link to customers → city / country  
• sales.time_id : link to times → calendar quarter & year  
• sales.promo_id : lets us keep only “no promotion” rows (we’ll test which value = no‑promo)  
• sales.amount_sold : metric we must aggregate  

• customers.cust_id : join key to sales  
• customers.cust_city : city to compare growth  
• customers.country_id : join key to countries  

• countries.country_id : join key to customers  
• countries.country_name : filter to “United States%”  

• times.time_id : join key to sales  
• times.calendar_year : 2019 vs 2020  
• times.calendar_quarter_number : 4 (Q4)  

Typical filter conditions we’ll need  
• countries.country_name LIKE 'United States%'  
• times.calendar_year IN (2019, 2020)  
• times.calendar_quarter_number = 4  
• sales.promo_id = 999    -- (we’ll confirm this is the “no promotion” code)  

Below are ten exploratory SQLite queries (each limited to 20 rows) that move from simple inspection to the full analysis.  
Each query is annotated with an explanation.

```sql
--1 Description: See how “United States” is stored in the countries table
SELECT DISTINCT "country_name"
FROM "countries"
WHERE "country_name" LIKE 'United States%'
LIMIT 20;
```

```sql
--2 Description: Peek at a few U.S. customers to verify city data
SELECT DISTINCT c."cust_city", c."cust_state_province"
FROM "customers"  AS c
JOIN "countries"  AS co ON c."country_id" = co."country_id"
WHERE co."country_name" LIKE 'United States%'
LIMIT 20;
```

```sql
--3 Description: List promo_id values that appear in sales but are NOT in promotions (possible “no‑promotion” code)
SELECT DISTINCT s."promo_id"
FROM   "sales"       AS s
LEFT   JOIN "promotions" AS p ON s."promo_id" = p."promo_id"
WHERE  p."promo_id" IS NULL
LIMIT 20;
```

```sql
--4 Description: How much revenue comes from each mystery promo_id (to confirm 999 dominates)
SELECT s."promo_id",
       SUM(s."amount_sold") AS "total_sales"
FROM   "sales" AS s
GROUP  BY s."promo_id"
ORDER  BY "total_sales" DESC
LIMIT 20;
```

```sql
--5 Description: Look at time rows that belong to Q4 2019 and Q4 2020
SELECT DISTINCT "time_id",
       "calendar_year",
       "calendar_quarter_number"
FROM   "times"
WHERE  "calendar_year" IN (2019, 2020)
  AND  "calendar_quarter_number" = 4
LIMIT 20;
```

```sql
--6 Description: Total non‑promo sales by U.S. city in Q4‑2019
SELECT cu."cust_city",
       ROUND(SUM(s."amount_sold"),2) AS "sales_q4_2019"
FROM   "sales"     AS s
JOIN   "times"     AS t  ON s."time_id"   = t."time_id"
JOIN   "customers" AS cu ON s."cust_id"   = cu."cust_id"
JOIN   "countries" AS co ON cu."country_id" = co."country_id"
WHERE  co."country_name" LIKE 'United States%'
  AND  t."calendar_year" = 2019
  AND  t."calendar_quarter_number" = 4
  AND  s."promo_id" = 999                 -- no promotion
GROUP  BY cu."cust_city"
ORDER  BY "sales_q4_2019" DESC
LIMIT 20;
```

```sql
--7 Description: Total non‑promo sales by the same U.S. cities in Q4‑2020
SELECT cu."cust_city",
       ROUND(SUM(s."amount_sold"),2) AS "sales_q4_2020"
FROM   "sales"     AS s
JOIN   "times"     AS t  ON s."time_id"   = t."time_id"
JOIN   "customers" AS cu ON s."cust_id"   = cu."cust_id"
JOIN   "countries" AS co ON cu."country_id" = co."country_id"
WHERE  co."country_name" LIKE 'United States%'
  AND  t."calendar_year" = 2020
  AND  t."calendar_quarter_number" = 4
  AND  s."promo_id" = 999
GROUP  BY cu."cust_city"
ORDER  BY "sales_q4_2020" DESC
LIMIT 20;
```

```sql
--8 Description: Cities whose Q4‑2020 sales ≥ 1.20 × Q4‑2019 sales
WITH q19 AS (
    SELECT cu."cust_city", SUM(s."amount_sold") AS s19
    FROM "sales" AS s
    JOIN "times" AS t   ON s."time_id" = t."time_id"
    JOIN "customers" cu ON s."cust_id" = cu."cust_id"
    JOIN "countries" co ON cu."country_id" = co."country_id"
    WHERE co."country_name" LIKE 'United States%'
      AND t."calendar_year" = 2019
      AND t."calendar_quarter_number" = 4
      AND s."promo_id" = 999
    GROUP BY cu."cust_city"
),
q20 AS (
    SELECT cu."cust_city", SUM(s."amount_sold") AS s20
    FROM "sales" AS s
    JOIN "times" AS t   ON s."time_id" = t."time_id"
    JOIN "customers" cu ON s."cust_id" = cu."cust_id"
    JOIN "countries" co ON cu."country_id" = co."country_id"
    WHERE co."country_name" LIKE 'United States%'
      AND t."calendar_year" = 2020
      AND t."calendar_quarter_number" = 4
      AND s."promo_id" = 999
    GROUP BY cu."cust_city"
)
SELECT q20."cust_city",
       ROUND(q19.s19,2) AS "sales_q4_2019",
       ROUND(q20.s20,2) AS "sales_q4_2020",
       ROUND((q20.s20 - q19.s19)*100.0/q19.s19,2) AS "pct_growth"
FROM q19
JOIN q20 ON q19."cust_city" = q20."cust_city"
WHERE q20.s20 >= 1.20 * q19.s19
ORDER BY "pct_growth" DESC
LIMIT 20;
```

```sql
--9 Description: Total sales per product (non‑promo, both Q4s) in the growth‑qualified cities; rank & keep top 20 %
WITH growth_cities AS (            -- reuse result of previous CTE
    SELECT q20."cust_city"
    FROM (
        /* same q19/q20 logic as #8 */
        SELECT cu."cust_city", SUM(s."amount_sold") AS s19
        FROM "sales" AS s
        JOIN "times" AS t  ON s."time_id" = t."time_id"
        JOIN "customers" cu ON s."cust_id" = cu."cust_id"
        JOIN "countries" co ON cu."country_id" = co."country_id"
        WHERE co."country_name" LIKE 'United States%'
          AND t."calendar_year" = 2019
          AND t."calendar_quarter_number" = 4
          AND s."promo_id" = 999
        GROUP BY cu."cust_city"
    ) q19
    JOIN (
        SELECT cu."cust_city", SUM(s."amount_sold") AS s20
        FROM "sales" AS s
        JOIN "times" AS t  ON s."time_id" = t."time_id"
        JOIN "customers" cu ON s."cust_id" = cu."cust_id"
        JOIN "countries" co ON cu."country_id" = co."country_id"
        WHERE co."country_name" LIKE 'United States%'
          AND t."calendar_year" = 2020
          AND t."calendar_quarter_number" = 4
          AND s."promo_id" = 999
        GROUP BY cu."cust_city"
    ) q20
      ON q19."cust_city" = q20."cust_city"
    WHERE q20.s20 >= 1.20 * q19.s19
),
prod_tot AS (
    SELECT s."prod_id",
           SUM(s."amount_sold") AS tot_sales
    FROM   "sales"       AS s
    JOIN   "times"       AS t  ON s."time_id" = t."time_id"
    JOIN   "customers"   AS cu ON s."cust_id" = cu."cust_id"
    JOIN   growth_cities AS gc ON cu."cust_city" = gc."cust_city"
    WHERE  t."calendar_year" IN (2019, 2020)
      AND  t."calendar_quarter_number" = 4
      AND  s."promo_id" = 999
    GROUP  BY s."prod_id"
),
ranked AS (
    SELECT pt.*,
           RANK() OVER (ORDER BY pt."tot_sales" DESC)      AS rk,
           COUNT(*) OVER ()                                AS cnt
    FROM   prod_tot pt
)
SELECT *
FROM   ranked
WHERE  rk <= 0.20 * cnt          -- top 20 %
ORDER  BY "tot_sales" DESC
LIMIT 20;
```

```sql
--10 Description: For the top‑20 % products, find their sales share in each Q4 and the change 2020‑2019
WITH growth_cities AS (
    /* same definition as query #9 */
    SELECT q20."cust_city"
    FROM (
        SELECT cu."cust_city", SUM(s."amount_sold") AS s19
        FROM "sales" AS s
        JOIN "times" AS t  ON s."time_id" = t."time_id"
        JOIN "customers" cu ON s."cust_id" = cu."cust_id"
        JOIN "countries" co ON cu."country_id" = co."country_id"
        WHERE co."country_name" LIKE 'United States%'
          AND t."calendar_year" = 2019
          AND t."calendar_quarter_number" = 4
          AND s."promo_id" = 999
        GROUP BY cu."cust_city"
    ) q19
    JOIN (
        SELECT cu."cust_city", SUM(s."amount_sold") AS s20
        FROM "sales" AS s
        JOIN "times" AS t  ON s."time_id" = t."time_id"
        JOIN "customers" cu ON s."cust_id" = cu."cust_id"
        JOIN "countries" co ON cu."country_id" = co."country_id"
        WHERE co."country_name" LIKE 'United States%'
          AND t."calendar_year" = 2020
          AND t."calendar_quarter_number" = 4
          AND s."promo_id" = 999
        GROUP BY cu."cust_city"
    ) q20
      ON q19."cust_city" = q20."cust_city"
    WHERE q20.s20 >= 1.20 * q19.s19
),
top_products AS (
    /* reuse ranked logic from #9 */
    WITH prod_tot AS (
        SELECT s."prod_id",
               SUM(s."amount_sold") AS tot_sales
        FROM   "sales"       AS s
        JOIN   "times"       AS t  ON s."time_id" = t."time_id"
        JOIN   "customers"   AS cu ON s."cust_id" = cu."cust_id"
        JOIN   growth_cities AS gc ON cu."cust_city" = gc."cust_city"
        WHERE  t."calendar_year" IN (2019, 2020)
          AND  t."calendar_quarter_number" = 4
          AND  s."promo_id" = 999
        GROUP  BY s."prod_id"
    )
    SELECT pt."prod_id"
    FROM (
        SELECT pt.*,
               RANK()  OVER (ORDER BY pt."tot_sales" DESC) AS rk,
               COUNT(*) OVER ()                            AS cnt
        FROM prod_tot pt
    ) ranked
    WHERE rk <= 0.20 * cnt
),
sales_by_prod_qtr AS (
    SELECT s."prod_id",
           t."calendar_year",
           SUM(s."amount_sold") AS sales_amt
    FROM   "sales"       AS s
    JOIN   "times"       AS t  ON s."time_id" = t."time_id"
    JOIN   "customers"   AS cu ON s."cust_id" = cu."cust_id"
    JOIN   growth_cities AS gc ON cu."cust_city" = gc."cust_city"
    JOIN   top_products  AS tp ON s."prod_id"   = tp."prod_id"
    WHERE  t."calendar_year" IN (2019, 2020)
      AND  t."calendar_quarter_number" = 4
      AND  s."promo_id" = 999
    GROUP  BY s."prod_id", t."calendar_year"
),
totals_qtr AS (
    SELECT t."calendar_year",
           SUM(s."amount_sold") AS total_sales
    FROM   "sales"       AS s
    JOIN   "times"       AS t  ON s."time_id" = t."time_id"
    JOIN   "customers"   AS cu ON s."cust_id" = cu."cust_id"
    JOIN   growth_cities AS gc ON cu."cust_city" = gc."cust_city"
    WHERE  t."calendar_year" IN (2019, 2020)
      AND  t."calendar_quarter_number" = 4
      AND  s."promo_id" = 999
    GROUP  BY t."calendar_year"
)
SELECT sp."prod_id",
       ROUND(SUM(CASE WHEN sp."calendar_year" = 2019 THEN sp."sales_amt" END) * 1.0 /
             (SELECT total_sales FROM totals_qtr WHERE calendar_year = 2019), 4) AS share_2019,
       ROUND(SUM(CASE WHEN sp."calendar_year" = 2020 THEN sp."sales_amt" END) * 1.0 /
             (SELECT total_sales FROM totals_qtr WHERE calendar_year = 2020), 4) AS share_2020,
       ROUND(
         (SUM(CASE WHEN sp."calendar_year" = 2020 THEN sp."sales_amt" END) * 1.0 /
          (SELECT total_sales FROM totals_qtr WHERE calendar_year = 2020))
         -
         (SUM(CASE WHEN sp."calendar_year" = 2019 THEN sp."sales_amt" END) * 1.0 /
          (SELECT total_sales FROM totals_qtr WHERE calendar_year = 2019))
       ,4) AS share_change
FROM sales_by_prod_qtr sp
GROUP BY sp."prod_id"
ORDER BY share_change DESC
LIMIT 20;
```

