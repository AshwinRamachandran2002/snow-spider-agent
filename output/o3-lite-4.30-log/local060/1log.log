The table structure information is (table names): 
['countries', 'customers', 'promotions', 'products', 'times', 'channels', 'sales', 'costs', 'supplementary_demographics', 'currency']
Begin Exploring Related Columns
Relevant tables / columns and how they will probably be used  

customers  
• cust_id : join key to sales  
• cust_city : city‑level grouping  
• country_id : join key to countries  

countries  
• country_name : filter to “United States …”  
• country_iso_code : alternative U.S. filter value (likely “US”)  
• country_id : join key to customers  

sales  
• cust_id : join to customers  
• time_id : join to times for quarter & year selection  
• promo_id : join to promotions – we will keep only rows that correspond to “no promotion”  
• prod_id : later ranking of products  
• amount_sold : what we aggregate / use for shares  

promotions  
• promo_id : join key  
• promo_name / promo_category : to discover the row(s) that represent “no promotion”  

times  
• time_id : join key  
• calendar_year : choose 2019 and 2020  
• calendar_quarter_number : choose 4 (Q4)  

Typical conditions we will need  
1. countries.country_name LIKE 'United States%'  (or country_iso_code = 'US')  
2. times.calendar_year IN (2019, 2020)  
3. times.calendar_quarter_number = 4  
4. promotion designator for “no promotion” – after inspecting promotions we may find promo_id = 999 or a name like '%no promo%' and keep only that id.  

----------------------------------------------------------------------------  
Exploratory / building‑block queries (all limited to 20 rows)  
```sql
--1) Quick look at country names and iso codes
SELECT DISTINCT country_id, country_iso_code, country_name
FROM countries
WHERE country_iso_code LIKE 'U%' OR country_name LIKE '%United%'
LIMIT 20;

--2) What does promo_id 999 look like?
SELECT promo_id, promo_name, promo_category
FROM promotions
WHERE promo_id = 999
LIMIT 20;

--3) Any promo rows that seem to mean “no promotion”
SELECT DISTINCT promo_id, promo_name
FROM promotions
WHERE LOWER(promo_name) LIKE '%no%' OR LOWER(promo_name) LIKE '%none%'
LIMIT 20;

--4) Inspect times rows that belong to Q4 2019
SELECT DISTINCT time_id, calendar_year, calendar_quarter_number
FROM times
WHERE calendar_year = 2019
  AND calendar_quarter_number = 4
LIMIT 20;

--5) Same for Q4 2020
SELECT DISTINCT time_id, calendar_year, calendar_quarter_number
FROM times
WHERE calendar_year = 2020
  AND calendar_quarter_number = 4
LIMIT 20;

--6) Sample sales rows for U.S. customers in Q4 2019 with promo_id 999 (candidate for “no promo”)
SELECT s.*
FROM sales AS s
JOIN customers AS c  ON c.cust_id = s.cust_id
JOIN countries  AS co ON co.country_id = c.country_id
JOIN times      AS t  ON t.time_id    = s.time_id
WHERE co.country_name LIKE 'United States%'
  AND t.calendar_year = 2019
  AND t.calendar_quarter_number = 4
  AND s.promo_id = 999
LIMIT 20;

--7) City‑level total sales (no promo) for Q4‑2019
SELECT c.cust_city,
       SUM(s.amount_sold) AS city_sales_2019_Q4
FROM   sales      AS s
JOIN   customers  AS c  ON c.cust_id = s.cust_id
JOIN   countries  AS co ON co.country_id = c.country_id
JOIN   times      AS t  ON t.time_id    = s.time_id
WHERE  co.country_name LIKE 'United States%'
  AND  t.calendar_year = 2019
  AND  t.calendar_quarter_number = 4
  AND  s.promo_id = 999          -- “no promotion”
GROUP  BY c.cust_city
LIMIT 20;

--8) Same aggregation for Q4‑2020
SELECT c.cust_city,
       SUM(s.amount_sold) AS city_sales_2020_Q4
FROM   sales      AS s
JOIN   customers  AS c  ON c.cust_id = s.cust_id
JOIN   countries  AS co ON co.country_id = c.country_id
JOIN   times      AS t  ON t.time_id    = s.time_id
WHERE  co.country_name LIKE 'United States%'
  AND  t.calendar_year = 2020
  AND  t.calendar_quarter_number = 4
  AND  s.promo_id = 999
GROUP  BY c.cust_city
LIMIT 20;

--9) Cities whose Q4 total sales rose >= 20% from 2019 to 2020 (CTE version)
WITH q4_19 AS (
      SELECT c.cust_city,
             SUM(s.amount_sold) AS amt_19
      FROM   sales s
      JOIN   customers c  ON c.cust_id = s.cust_id
      JOIN   countries co ON co.country_id = c.country_id
      JOIN   times t      ON t.time_id    = s.time_id
      WHERE  co.country_name LIKE 'United States%'
         AND t.calendar_year = 2019
         AND t.calendar_quarter_number = 4
         AND s.promo_id = 999
      GROUP BY c.cust_city),
     q4_20 AS (
      SELECT c.cust_city,
             SUM(s.amount_sold) AS amt_20
      FROM   sales s
      JOIN   customers c  ON c.cust_id = s.cust_id
      JOIN   countries co ON co.country_id = c.country_id
      JOIN   times t      ON t.time_id    = s.time_id
      WHERE  co.country_name LIKE 'United States%'
         AND t.calendar_year = 2020
         AND t.calendar_quarter_number = 4
         AND s.promo_id = 999
      GROUP BY c.cust_city)
SELECT a.cust_city,
       a.amt_19, b.amt_20,
       ROUND( (b.amt_20 - a.amt_19)*100.0 / a.amt_19 , 2) AS pct_growth
FROM   q4_19 a
JOIN   q4_20 b USING (cust_city)
WHERE  b.amt_20 >= 1.20 * a.amt_19
LIMIT 20;

--10) FINAL – Top 20 % products inside the growth‑cities and their share‑change
WITH base AS (               -- sales lines, US, Q4s, no promo, growth cities only
     WITH q4_19 AS (
        SELECT c.cust_city, SUM(s.amount_sold) amt19
        FROM   sales s
        JOIN   customers c  ON c.cust_id = s.cust_id
        JOIN   countries co ON co.country_id = c.country_id
        JOIN   times t      ON t.time_id = s.time_id
        WHERE  co.country_name LIKE 'United States%'
          AND  t.calendar_year = 2019
          AND  t.calendar_quarter_number = 4
          AND  s.promo_id = 999
        GROUP BY c.cust_city),
       q4_20 AS (
        SELECT c.cust_city, SUM(s.amount_sold) amt20
        FROM   sales s
        JOIN   customers c  ON c.cust_id = s.cust_id
        JOIN   countries co ON co.country_id = c.country_id
        JOIN   times t      ON t.time_id = s.time_id
        WHERE  co.country_name LIKE 'United States%'
          AND  t.calendar_year = 2020
          AND  t.calendar_quarter_number = 4
          AND  s.promo_id = 999
        GROUP BY c.cust_city),
       growth AS (
        SELECT a.cust_city
        FROM   q4_19 a
        JOIN   q4_20 b ON a.cust_city = b.cust_city
        WHERE  b.amt20 >= 1.20 * a.amt19)
     SELECT s.prod_id,
            t.calendar_year,
            SUM(s.amount_sold) AS amt
     FROM   sales      s
     JOIN   customers  c  ON c.cust_id = s.cust_id
     JOIN   times      t  ON t.time_id = s.time_id
     JOIN   growth     g  ON g.cust_city = c.cust_city
     WHERE  t.calendar_year IN (2019,2020)
       AND  t.calendar_quarter_number = 4
       AND  s.promo_id = 999
     GROUP  BY s.prod_id, t.calendar_year),

totals AS (                  -- total sales (all prod) in selected cities by year
     SELECT calendar_year, SUM(amt) AS year_total
     FROM   base
     GROUP  BY calendar_year),

ranked AS (                  -- rank products by overall (2019+2020) sales, take top 20 %
     SELECT prod_id,
            SUM(amt) AS two_year_amt,
            NTILE(5) OVER (ORDER BY SUM(amt) DESC) AS quintile
     FROM   base
     GROUP  BY prod_id
),
top20 AS (
     SELECT prod_id
     FROM   ranked
     WHERE  quintile = 1          -- top 20 %
)

SELECT b.prod_id,
       SUM(CASE WHEN b.calendar_year = 2019 THEN b.amt END) AS amt_19,
       SUM(CASE WHEN b.calendar_year = 2020 THEN b.amt END) AS amt_20,
       ROUND( SUM(CASE WHEN b.calendar_year = 2019 THEN b.amt END)
              / (SELECT year_total FROM totals WHERE calendar_year = 2019)
              , 4) AS share_19,
       ROUND( SUM(CASE WHEN b.calendar_year = 2020 THEN b.amt END)
              / (SELECT year_total FROM totals WHERE calendar_year = 2020)
              , 4) AS share_20,
       ROUND( ( SUM(CASE WHEN b.calendar_year = 2020 THEN b.amt END)
              / (SELECT year_total FROM totals WHERE calendar_year = 2020)
              ) -
              ( SUM(CASE WHEN b.calendar_year = 2019 THEN b.amt END)
              / (SELECT year_total FROM totals WHERE calendar_year = 2019)
              ), 4)                                   AS share_change
FROM   base b
JOIN   top20 t20 ON t20.prod_id = b.prod_id
GROUP  BY b.prod_id
ORDER  BY share_change DESC
LIMIT 20;
```
