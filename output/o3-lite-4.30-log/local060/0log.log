```sql
--Description: Identify U.S. cities whose no‑promotion sales in Q4‑2020
--             are at least 20 % higher than in Q4‑2019.
WITH q19 AS (
    SELECT c.cust_city,
           SUM(s.amount_sold) AS amt19
    FROM   sales      AS s
    JOIN   times      AS t  ON t.time_id   = s.time_id
    JOIN   customers  AS c  ON c.cust_id   = s.cust_id
    JOIN   countries  AS co ON co.country_id = c.country_id
    WHERE  co.country_name           = 'United States of America'
      AND  t.calendar_year           = 2019
      AND  t.calendar_quarter_number = 4
      AND  s.promo_id                = 999
    GROUP  BY c.cust_city
), q20 AS (
    SELECT c.cust_city,
           SUM(s.amount_sold) AS amt20
    FROM   sales      AS s
    JOIN   times      AS t  ON t.time_id   = s.time_id
    JOIN   customers  AS c  ON c.cust_id   = s.cust_id
    JOIN   countries  AS co ON co.country_id = c.country_id
    WHERE  co.country_name           = 'United States of America'
      AND  t.calendar_year           = 2020
      AND  t.calendar_quarter_number = 4
      AND  s.promo_id                = 999
    GROUP  BY c.cust_city
)
SELECT  q20.cust_city,
        amt19,
        amt20,
        ROUND( (amt20 - amt19) * 100.0 / amt19 , 2) AS pct_growth
FROM    q19
JOIN    q20 USING (cust_city)
WHERE   amt20 >= 1.20 * amt19
ORDER   BY pct_growth DESC
LIMIT   20;
```

```sql
--Description: Among growth‑qualified U.S. cities (≥20 % increase),
--             rank products by combined no‑promotion sales in Q4‑2019
--             and Q4‑2020, then list the top 20 % of those products.
WITH good_cities AS (
    SELECT q20.cust_city
    FROM (
        SELECT c.cust_city, SUM(s.amount_sold) AS amt19
        FROM   sales AS s
        JOIN   times AS t  ON t.time_id = s.time_id
        JOIN   customers AS c ON c.cust_id = s.cust_id
        JOIN   countries AS co ON co.country_id = c.country_id
        WHERE  co.country_name = 'United States of America'
          AND  t.calendar_year = 2019
          AND  t.calendar_quarter_number = 4
          AND  s.promo_id      = 999
        GROUP  BY c.cust_city
    ) AS q19
    JOIN (
        SELECT c.cust_city, SUM(s.amount_sold) AS amt20
        FROM   sales AS s
        JOIN   times AS t  ON t.time_id = s.time_id
        JOIN   customers AS c ON c.cust_id = s.cust_id
        JOIN   countries AS co ON co.country_id = c.country_id
        WHERE  co.country_name = 'United States of America'
          AND  t.calendar_year = 2020
          AND  t.calendar_quarter_number = 4
          AND  s.promo_id      = 999
        GROUP  BY c.cust_city
    ) AS q20
    ON  q19.cust_city = q20.cust_city
    WHERE q20.amt20 >= 1.20 * q19.amt19
), prod_sales AS (
    SELECT s.prod_id,
           SUM(s.amount_sold) AS total_sales
    FROM   sales AS s
    JOIN   times AS t  ON t.time_id = s.time_id
    JOIN   customers AS c ON c.cust_id = s.cust_id
    JOIN   countries AS co ON co.country_id = c.country_id
    WHERE  co.country_name = 'United States of America'
      AND  c.cust_city IN (SELECT cust_city FROM good_cities)
      AND  t.calendar_quarter_number = 4
      AND  t.calendar_year IN (2019, 2020)
      AND  s.promo_id = 999
    GROUP  BY s.prod_id
), ranked AS (
    SELECT prod_id,
           total_sales,
           NTILE(5) OVER (ORDER BY total_sales DESC) AS quintile
    FROM   prod_sales
)
SELECT  prod_id,
        total_sales
FROM    ranked
WHERE   quintile = 1      -- top 20 %
ORDER   BY total_sales DESC
LIMIT   20;
```

```sql
--Description: For the top‑20 % products (by combined sales) sold
--             in growth‑qualified U.S. cities, compute each product’s
--             share of total no‑promotion sales in Q4‑2019 vs Q4‑2020
--             and list products by greatest share increase.
WITH good_cities AS (
    SELECT q20.cust_city
    FROM (
        SELECT c.cust_city, SUM(s.amount_sold) AS amt19
        FROM   sales AS s
        JOIN   times AS t  ON t.time_id = s.time_id
        JOIN   customers AS c ON c.cust_id = s.cust_id
        JOIN   countries AS co ON co.country_id = c.country_id
        WHERE  co.country_name = 'United States of America'
          AND  t.calendar_year = 2019
          AND  t.calendar_quarter_number = 4
          AND  s.promo_id      = 999
        GROUP  BY c.cust_city
    ) AS q19
    JOIN (
        SELECT c.cust_city, SUM(s.amount_sold) AS amt20
        FROM   sales AS s
        JOIN   times AS t  ON t.time_id = s.time_id
        JOIN   customers AS c ON c.cust_id = s.cust_id
        JOIN   countries AS co ON co.country_id = c.country_id
        WHERE  co.country_name = 'United States of America'
          AND  t.calendar_year = 2020
          AND  t.calendar_quarter_number = 4
          AND  s.promo_id      = 999
        GROUP  BY c.cust_city
    ) AS q20
    ON  q19.cust_city = q20.cust_city
    WHERE q20.amt20 >= 1.20 * q19.amt19
), top_products AS (
    SELECT prod_id
    FROM (
        SELECT prod_id,
               NTILE(5) OVER (ORDER BY SUM(amount_sold) DESC) AS quintile
        FROM   sales AS s
        JOIN   times AS t  ON t.time_id = s.time_id
        JOIN   customers AS c ON c.cust_id = s.cust_id
        JOIN   countries AS co ON co.country_id = c.country_id
        WHERE  co.country_name = 'United States of America'
          AND  c.cust_city IN (SELECT cust_city FROM good_cities)
          AND  t.calendar_quarter_number = 4
          AND  t.calendar_year IN (2019, 2020)
          AND  s.promo_id = 999
        GROUP  BY prod_id
    )
    WHERE quintile = 1          -- top 20 %
), base AS (
    SELECT
        s.prod_id,
        SUM(CASE WHEN t.calendar_year = 2019 THEN s.amount_sold END) AS prod19,
        SUM(CASE WHEN t.calendar_year = 2020 THEN s.amount_sold END) AS prod20,
        SUM(CASE WHEN t.calendar_year = 2019 THEN s.amount_sold END)
            OVER () AS overall19,
        SUM(CASE WHEN t.calendar_year = 2020 THEN s.amount_sold END)
            OVER () AS overall20
    FROM   sales AS s
    JOIN   times AS t  ON t.time_id = s.time_id
    JOIN   customers AS c ON c.cust_id = s.cust_id
    JOIN   countries AS co ON co.country_id = c.country_id
    WHERE  co.country_name = 'United States of America'
      AND  c.cust_city IN (SELECT cust_city FROM good_cities)
      AND  t.calendar_quarter_number = 4
      AND  t.calendar_year IN (2019, 2020)
      AND  s.promo_id = 999
      AND  s.prod_id IN (SELECT prod_id FROM top_products)
    GROUP  BY s.prod_id
)
SELECT
    prod_id,
    ROUND(100.0 * prod19 / overall19, 2) AS share_2019,
    ROUND(100.0 * prod20 / overall20, 2) AS share_2020,
    ROUND( (100.0 * prod20 / overall20) -
           (100.0 * prod19 / overall19), 2) AS pct_point_change
FROM   base
ORDER  BY pct_point_change DESC
LIMIT  20;
```
