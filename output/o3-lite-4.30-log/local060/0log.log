--Description: City‑level total “no‑promotion” sales for calendar Q4‑2020
--             in the United States (promo_id = 999). Shows the 20 cities
--             with the highest sales.
SELECT
    c.cust_city,
    SUM(s.amount_sold) AS q4_2020_sales
FROM   sales      AS s
JOIN   times      AS t  ON t.time_id   = s.time_id
JOIN   customers  AS c  ON c.cust_id   = s.cust_id
JOIN   countries  AS co ON co.country_id = c.country_id
WHERE  co.country_name           = 'United States of America'
  AND  t.calendar_year           = 2020
  AND  t.calendar_quarter_number = 4
  AND  s.promo_id                = 999
GROUP  BY c.cust_city
ORDER  BY q4_2020_sales DESC
LIMIT  20;
