Query:
--Description: Among growth‑qualified U.S. cities (≥20 % increase),
--             rank products by combined no‑promotion sales in Q4‑2019
--             and Q4‑2020, then list the top 20 % of those products.
WITH good_cities AS (
    SELECT q20.cust_city
    FROM (
        SELECT c.cust_city, SUM(s.amount_sold) AS amt19
        FROM   sales AS s
        JOIN   times AS t  ON t.time_id = s.time_id
        JOIN   customers AS c ON c.cust_id = s.cust_id
        JOIN   countries AS co ON co.country_id = c.country_id
        WHERE  co.country_name = 'United States of America'
          AND  t.calendar_year = 2019
          AND  t.calendar_quarter_number = 4
          AND  s.promo_id      = 999
        GROUP  BY c.cust_city
    ) AS q19
    JOIN (
        SELECT c.cust_city, SUM(s.amount_sold) AS amt20
        FROM   sales AS s
        JOIN   times AS t  ON t.time_id = s.time_id
        JOIN   customers AS c ON c.cust_id = s.cust_id
        JOIN   countries AS co ON co.country_id = c.country_id
        WHERE  co.country_name = 'United States of America'
          AND  t.calendar_year = 2020
          AND  t.calendar_quarter_number = 4
          AND  s.promo_id      = 999
        GROUP  BY c.cust_city
    ) AS q20
    ON  q19.cust_city = q20.cust_city
    WHERE q20.amt20 >= 1.20 * q19.amt19
), prod_sales AS (
    SELECT s.prod_id,
           SUM(s.amount_sold) AS total_sales
    FROM   sales AS s
    JOIN   times AS t  ON t.time_id = s.time_id
    JOIN   customers AS c ON c.cust_id = s.cust_id
    JOIN   countries AS co ON co.country_id = c.country_id
    WHERE  co.country_name = 'United States of America'
      AND  c.cust_city IN (SELECT cust_city FROM good_cities)
      AND  t.calendar_quarter_number = 4
      AND  t.calendar_year IN (2019, 2020)
      AND  s.promo_id = 999
    GROUP  BY s.prod_id
), ranked AS (
    SELECT prod_id,
           total_sales,
           NTILE(5) OVER (ORDER BY total_sales DESC) AS quintile
    FROM   prod_sales
)
SELECT  prod_id,
        total_sales
FROM    ranked
WHERE   quintile = 1      -- top 20 %
ORDER   BY total_sales DESC
LIMIT   20
