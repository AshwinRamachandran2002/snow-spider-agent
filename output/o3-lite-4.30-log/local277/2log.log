WITH hist AS (
  SELECT
    product_id,
    ROW_NUMBER() OVER (PARTITION BY product_id ORDER BY mth)                      AS x,
    qty                                                                           AS y,
    CASE
      WHEN ROW_NUMBER() OVER (PARTITION BY product_id ORDER BY mth) BETWEEN 7 AND 30
           THEN 2.0
      ELSE 1.0
    END                                                                           AS w
  FROM monthly_sales
  WHERE product_id IN (4160, 7790)
    AND mth >= '2016-01-01'
    AND mth <  '2019-01-01'
),
sums AS (
  SELECT
    product_id,
    SUM(w)            AS Sw,
    SUM(w * x)        AS Sx,
    SUM(w * y)        AS Sy,
    SUM(w * x * x)    AS Sxx,
    SUM(w * x * y)    AS Sxy
  FROM hist
  GROUP BY product_id
),
params AS (
  SELECT
    product_id,
    (Sw * Sxy - Sx * Sy) * 1.0 / (Sw * Sxx - Sx * Sx)                             AS b,
    (Sy - ((Sw * Sxy - Sx * Sy) * 1.0 / (Sw * Sxx - Sx * Sx)) * Sx) / Sw          AS a
  FROM sums
),
