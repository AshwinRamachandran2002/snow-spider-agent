  CROSS JOIN months_2018 m
),
avg_pred AS (
  SELECT
    product_id,
    AVG(y_hat)                                                                    AS forecasted_annual_sales_2018
  FROM pred
  GROUP BY product_id
)
SELECT
  product_id,
  ROUND(forecasted_annual_sales_2018, 4) AS forecasted_annual_sales_2018
FROM avg_pred
ORDER BY product_id;
