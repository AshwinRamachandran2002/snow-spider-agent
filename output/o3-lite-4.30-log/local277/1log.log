WITH ranked AS (
    /* time index (t_idx) 1‑36 per product starting 2016‑01‑01 */
    SELECT  m."product_id",
            m."mth",
            m."qty",
            (SELECT COUNT(*) 
             FROM   "monthly_sales" m2
             WHERE  m2."product_id" = m."product_id"
               AND  m2."mth"        <= m."mth")          AS t_idx,
            CAST(STRFTIME('%m', m."mth") AS INTEGER)     AS month_no
    FROM   "monthly_sales" m
    WHERE  m."product_id" IN (4160, 7790)
),
first36 AS (
    /* keep the requested 36 first months (Jan‑2016 … Dec‑2018) */
    SELECT * 
    FROM   ranked
    WHERE  t_idx <= 36
),
stats AS (
    /* ordinary least‑squares aggregates per product                */
    SELECT  "product_id",
            COUNT(*)                           AS n,
            SUM(t_idx)                         AS sum_x,
            SUM("qty")                         AS sum_y,
            SUM(t_idx*t_idx)                   AS sum_xx,
            SUM(t_idx*"qty")                   AS sum_xy
    FROM    first36
    GROUP BY "product_id"
),
trend_calc AS (
    /* attach slope, intercept, and the trend value for each record */
    SELECT  f.*,
            (
              (s.n*1.0*s.sum_xy - s.sum_x*1.0*s.sum_y)
              /
              (s.n*1.0*s.sum_xx - s.sum_x*1.0*s.sum_x)
            )                                       AS slope,
            (
              (s.sum_y*1.0 -
               ((s.n*1.0*s.sum_xy - s.sum_x*1.0*s.sum_y)
                /
               (s.n*1.0*s.sum_xx - s.sum_x*1.0*s.sum_x))
               * s.sum_x)
              / s.n
            )                                       AS intercept,
            NULL                                     AS dummy      -- placeholder
    FROM    first36 f
    JOIN    stats  s USING ("product_id")
),
trend AS (
    SELECT  "product_id",
            "mth",
            "qty",
            t_idx,
            month_no,
            slope,
            intercept,
            (slope * t_idx + intercept)  AS trend_val
    FROM    trend_calc
),
season AS (
    /* seasonal indices from time‑steps 7 → 30                      */
    SELECT  "product_id",
            month_no,
            AVG("qty" * 1.0 / trend_val)  AS seasonal_idx
    FROM    trend
    WHERE   t_idx BETWEEN 7 AND 30
    GROUP BY "product_id", month_no
),
forecast AS (
    /* forecast the 2018 months (t_idx 25‑36)                       */
    SELECT  t."product_id",
            t."mth",
            t_idx,
            t.trend_val,
            s.seasonal_idx,
            t.trend_val * s.seasonal_idx   AS forecast_qty
    FROM    trend  t
    JOIN    season s
           ON s."product_id" = t."product_id"
          AND s.month_no     = t.month_no
    WHERE   t_idx BETWEEN 25 AND 36            -- 2018 months
),
annual AS (
    SELECT  "product_id",
            SUM(forecast_qty)  AS forecasted_annual_sales_2018
    FROM    forecast
    GROUP BY "product_id"
)
SELECT  "product_id",
        ROUND(forecasted_annual_sales_2018, 4) AS forecasted_annual_sales_2018
FROM    annual
ORDER BY "product_id";
