--Description:  Produce final list of the 5 states with the highest distracted‑crash rates in 2015 and 2016 (per 100,000 population).
WITH pop AS (
  SELECT z.state_name, SUM(p.population) AS pop_2010
  FROM   `bigquery-public-data.census_bureau_usa.population_by_zip_2010` p
  JOIN   `bigquery-public-data.utility_us.zipcode_area` z
    ON   LPAD(p.zipcode, 5, '0') = z.zipcode
  GROUP BY z.state_name
),
crash15 AS (
  SELECT a.state_name, COUNT(DISTINCT a.consecutive_number) AS crashes15
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` a
  JOIN   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`  d
    ON   a.state_number       = d.state_number
   AND   a.consecutive_number = d.consecutive_number
  WHERE  d.driver_distracted_by_name NOT IN ('Not Distracted',
                                             'Unknown if Distracted',
                                             'Not Reported')
  GROUP BY a.state_name
),
crash16 AS (
  SELECT a.state_name, COUNT(DISTINCT a.consecutive_number) AS crashes16
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` a
  JOIN   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`  d
    ON   a.state_number       = d.state_number
   AND   a.consecutive_number = d.consecutive_number
  WHERE  d.driver_distracted_by_name NOT IN ('Not Distracted',
                                             'Unknown if Distracted',
                                             'Not Reported')
  GROUP BY a.state_name
),
rates AS (
  SELECT
    p.state_name,
    100000 * crashes15 / pop_2010 AS rate_2015,
    100000 * crashes16 / pop_2010 AS rate_2016
  FROM pop
  LEFT JOIN crash15 USING (state_name)
  LEFT JOIN crash16 USING (state_name)
),
ranked AS (
  SELECT '2015' AS yr,
         state_name,
         rate_2015 AS rate_per_100k,
         ROW_NUMBER() OVER (ORDER BY rate_2015 DESC) AS rn
  FROM rates
  UNION ALL
  SELECT '2016',
         state_name,
         rate_2016,
         ROW_NUMBER() OVER (ORDER BY rate_2016 DESC)
  FROM rates
)
SELECT yr, state_name, rate_per_100k
FROM   ranked
WHERE  rn <= 5
ORDER  BY yr, rate_per_100k DESC
