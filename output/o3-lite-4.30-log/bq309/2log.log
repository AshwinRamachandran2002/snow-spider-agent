Begin Exploring Related Columns
Relevant columns and their potential usage
• posts_questions.id: unique question id – used to join with answers and other tables.  
• posts_questions.body: question content – LENGTH(body) is used to measure “longest”.  
• posts_questions.accepted_answer_id: lets us know whether the question already has an accepted answer.  
• posts_questions.view_count: needed for score‑to‑view ratio test.  
• posts_questions.owner_user_id: used to join the question with its author in the users table.  

• posts_answers.parent_id: id of the question this answer belongs to – join to the question.  
• posts_answers.score: answer score – used in score/view ratio test.  

• users.id: primary key, joins to posts_questions.owner_user_id.  
• users.reputation: author’s reputation.  
• users.up_votes / users.down_votes: used to compute net_votes = up_votes‑down_votes.  

• badges.user_id: we simply COUNT(*) per user to get badge total.  

Typical filter conditions  
• q.accepted_answer_id IS NOT NULL  
• EXISTS (SELECT 1 FROM posts_answers a WHERE a.parent_id = q.id AND a.score / q.view_count > .01)  
• q.view_count > 0  -- to avoid division by zero  

Below are ten progressively richer example queries (all limited to 20 rows except the last, which returns the required 10 rows).

```sql
-- 1. Inspect a few questions and take their body length
SELECT id, LENGTH(body) AS body_len
FROM `bigquery-public-data.stackoverflow.posts_questions`
ORDER BY body_len DESC
LIMIT 20;
```

```sql
-- 2. See which of those questions already have an accepted answer
SELECT id, accepted_answer_id
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE accepted_answer_id IS NOT NULL
LIMIT 20;
```

```sql
-- 3. List some answers together with their parent question id and score
SELECT id AS answer_id, parent_id AS question_id, score
FROM `bigquery-public-data.stackoverflow.posts_answers`
LIMIT 20;
```

```sql
-- 4. Compute answer‑score / question‑views for a sample of answers
SELECT a.id AS answer_id,
       a.parent_id AS question_id,
       a.score,
       q.view_count,
       a.score / q.view_count AS score_view_ratio
FROM `bigquery-public-data.stackoverflow.posts_answers` a
JOIN `bigquery-public-data.stackoverflow.posts_questions` q
  ON q.id = a.parent_id
WHERE q.view_count > 0
LIMIT 20;
```

```sql
-- 5. Show answers whose score‑to‑view ratio is greater than 0.01
SELECT a.parent_id AS question_id,
       a.id AS answer_id,
       a.score,
       q.view_count,
       a.score / q.view_count AS ratio
FROM `bigquery-public-data.stackoverflow.posts_answers` a
JOIN `bigquery-public-data.stackoverflow.posts_questions` q
  ON q.id = a.parent_id
WHERE q.view_count > 0
  AND a.score / q.view_count > 0.01
LIMIT 20;
```

```sql
-- 6. Bring in asker reputation and net votes
SELECT q.id AS question_id,
       u.reputation,
       (u.up_votes - u.down_votes) AS net_votes
FROM `bigquery-public-data.stackoverflow.posts_questions` q
LEFT JOIN `bigquery-public-data.stackoverflow.users` u
  ON u.id = q.owner_user_id
LIMIT 20;
```

```sql
-- 7. Count how many badges each of a few users has earned
SELECT user_id, COUNT(*) AS badge_count
FROM `bigquery-public-data.stackoverflow.badges`
GROUP BY user_id
ORDER BY badge_count DESC
LIMIT 20;
```

```sql
-- 8. Combine question, user and badge data
SELECT q.id AS question_id,
       u.reputation,
       (u.up_votes - u.down_votes) AS net_votes,
       b.badge_count
FROM `bigquery-public-data.stackoverflow.posts_questions` q
LEFT JOIN `bigquery-public-data.stackoverflow.users` u
  ON u.id = q.owner_user_id
LEFT JOIN (
     SELECT user_id, COUNT(*) AS badge_count
     FROM `bigquery-public-data.stackoverflow.badges`
     GROUP BY user_id
) b ON b.user_id = u.id
LIMIT 20;
```

```sql
-- 9. Keep only questions that (a) have an accepted answer OR
--    (b) no accepted answer but at least one high‑ratio answer
WITH base AS (
  SELECT q.*
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  WHERE q.accepted_answer_id IS NOT NULL
     OR EXISTS (
        SELECT 1
        FROM `bigquery-public-data.stackoverflow.posts_answers` a
        WHERE a.parent_id = q.id
          AND q.view_count > 0
          AND a.score / q.view_count > 0.01
     )
)
SELECT id
FROM base
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: the 10 longest questions satisfying the stated rule,
--     with asker reputation, net votes, and total badge count
WITH eligible_questions AS (
  SELECT
        q.id,
        q.body,
        LENGTH(q.body) AS body_len,
        q.view_count,
        q.owner_user_id
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  WHERE q.accepted_answer_id IS NOT NULL
     OR EXISTS (
        SELECT 1
        FROM `bigquery-public-data.stackoverflow.posts_answers` a
        WHERE a.parent_id = q.id
          AND q.view_count > 0
          AND a.score / q.view_count > 0.01          -- score‑to‑view > 0.01
     )
),
badge_totals AS (
  SELECT user_id, COUNT(*) AS badge_count
  FROM `bigquery-public-data.stackoverflow.badges`
  GROUP BY user_id
)
SELECT
    eq.id                                  AS question_id,
    eq.body_len,
    u.reputation,
    (u.up_votes - u.down_votes)            AS net_votes,
    COALESCE(b.badge_count, 0)             AS badge_count
FROM eligible_questions eq
LEFT JOIN `bigquery-public-data.stackoverflow.users`   u ON u.id = eq.owner_user_id
LEFT JOIN badge_totals                                  b ON b.user_id = u.id
ORDER BY eq.body_len DESC
LIMIT 10;
```

