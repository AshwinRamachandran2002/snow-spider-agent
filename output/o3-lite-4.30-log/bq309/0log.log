Below is a brief mapping of the columns that will be useful, followed by ten exploratory‐to‑final SQL queries (each limited to 20 rows and wrapped in back‑ticks) that progressively build up to the required result.

Relevant columns and their potential use  
• posts_questions.id             : question identifier, join target for answers  
• posts_questions.body           : the text whose length we must measure  
• posts_questions.accepted_answer_id : tells if question has an accepted answer  
• posts_questions.view_count     : used for score‑to‑view ratio test  
• posts_questions.owner_user_id  : asker → join to users & badges  
• posts_answers.id               : answer identifier (needed for accepted answer join)  
• posts_answers.parent_id        : the question that an answer belongs to  
• posts_answers.score            : numerator in score‑to‑view ratio  
• users.id                       : join key coming from posts_questions.owner_user_id  
• users.reputation               : part of output  
• users.up_votes, users.down_votes : compute net votes (up‑down)  
• badges.user_id                 : to count badges per user  

Conditions that will be used  
1. LENGTH(posts_questions.body) – used for ranking longest questions.  
2. Question qualifies when  
   (a) accepted_answer_id IS NOT NULL  
   OR  
   (b) accepted_answer_id IS NULL AND EXISTS answer with  
            answer.score / question.view_count > 0.01.  
3. view_count > 0 to avoid divide‑by‑zero.  

-------------------------------------------------------------------------------
Query set
-------------------------------------------------------------------------------

```sql
-- 1. Quick look at question bodies and their lengths
SELECT id,
       LENGTH(body) AS body_len
FROM `bigquery-public-data.stackoverflow.posts_questions`
ORDER BY body_len DESC
LIMIT 20;
```

```sql
-- 2. Check the answer records for a single question to see available fields
SELECT pa.id,
       pa.parent_id,
       pa.score,
       LENGTH(pa.body) AS ans_len
FROM `bigquery-public-data.stackoverflow.posts_answers` AS pa
WHERE pa.parent_id = 24449808          -- sample question id from the prompt
LIMIT 20;
```

```sql
-- 3. Basic user information (reputation + net votes)
SELECT u.id,
       u.display_name,
       u.reputation,
       u.up_votes - u.down_votes AS net_votes
FROM `bigquery-public-data.stackoverflow.users` AS u
ORDER BY reputation DESC
LIMIT 20;
```

```sql
-- 4. Number of badges per user
SELECT b.user_id,
       COUNT(1) AS badge_cnt
FROM `bigquery-public-data.stackoverflow.badges` AS b
GROUP BY b.user_id
ORDER BY badge_cnt DESC
LIMIT 20;
```

```sql
-- 5. Questions that already have an accepted answer
SELECT id, accepted_answer_id
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE accepted_answer_id IS NOT NULL
LIMIT 20;
```

```sql
-- 6. Questions with no accepted answer but at least one high score/view answer
SELECT q.id AS question_id
FROM   `bigquery-public-data.stackoverflow.posts_questions` AS q
JOIN   `bigquery-public-data.stackoverflow.posts_answers`  AS a
       ON a.parent_id = q.id
WHERE  q.accepted_answer_id IS NULL
  AND  q.view_count > 0
  AND  a.score / q.view_count > 0.01
GROUP  BY q.id
LIMIT 20;
```

```sql
-- 7. Combine (qualifying) question ids from 5 and 6
WITH accepted AS (
  SELECT id FROM `bigquery-public-data.stackoverflow.posts_questions`
  WHERE accepted_answer_id IS NOT NULL
),
ratio_ok AS (
  SELECT DISTINCT q.id
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN `bigquery-public-data.stackoverflow.posts_answers` a
        ON a.parent_id = q.id
  WHERE q.accepted_answer_id IS NULL
    AND q.view_count > 0
    AND a.score / q.view_count > 0.01
)
SELECT id FROM accepted
UNION DISTINCT
SELECT id FROM ratio_ok
LIMIT 20;
```

```sql
-- 8. Longest qualifying questions (id + body length)
WITH qual_q AS (
  -- same logic as query 7
  SELECT id, body
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  WHERE q.accepted_answer_id IS NOT NULL

  UNION DISTINCT

  SELECT q.id, q.body
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN `bigquery-public-data.stackoverflow.posts_answers` a
        ON a.parent_id = q.id
  WHERE q.accepted_answer_id IS NULL
    AND q.view_count > 0
    AND a.score / q.view_count > 0.01
)
SELECT id,
       LENGTH(body) AS body_len
FROM   qual_q
ORDER  BY body_len DESC
LIMIT 20;
```

```sql
-- 9. Bring in user info & badge count for the longest qualifying questions
WITH qual_q AS (
  /* same definition as query 8 but with owner_user_id */
  SELECT id, body, owner_user_id
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  WHERE q.accepted_answer_id IS NOT NULL

  UNION DISTINCT

  SELECT q.id, q.body, q.owner_user_id
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN `bigquery-public-data.stackoverflow.posts_answers` a
        ON a.parent_id = q.id
  WHERE q.accepted_answer_id IS NULL
    AND q.view_count > 0
    AND a.score / q.view_count > 0.01
),
user_badges AS (
  SELECT user_id,
         COUNT(1) AS badge_cnt
  FROM `bigquery-public-data.stackoverflow.badges`
  GROUP BY user_id
)
SELECT q.id AS question_id,
       LENGTH(q.body) AS body_len,
       u.reputation,
       (u.up_votes - u.down_votes) AS net_votes,
       IFNULL(b.badge_cnt, 0) AS badge_cnt
FROM   qual_q q
JOIN   `bigquery-public-data.stackoverflow.users` u
       ON u.id = q.owner_user_id
LEFT  JOIN user_badges b
       ON b.user_id = u.id
ORDER BY body_len DESC
LIMIT 20;
```

```sql
-- 10. Final answer: Top‑10 longest qualifying questions with all requested fields
WITH qual_q AS (
  SELECT id,
         body,
         owner_user_id
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  WHERE accepted_answer_id IS NOT NULL

  UNION DISTINCT

  SELECT q.id,
         q.body,
         q.owner_user_id
  FROM `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN `bigquery-public-data.stackoverflow.posts_answers` a
        ON a.parent_id = q.id
  WHERE q.accepted_answer_id IS NULL
    AND q.view_count > 0
    AND a.score / q.view_count > 0.01
),
user_badges AS (
  SELECT user_id,
         COUNT(1) AS badge_cnt
  FROM `bigquery-public-data.stackoverflow.badges`
  GROUP BY user_id
)
SELECT q.id                             AS question_id,
       LENGTH(q.body)                   AS body_length,
       u.reputation                     AS asker_reputation,
       (u.up_votes - u.down_votes)      AS asker_net_votes,
       IFNULL(b.badge_cnt, 0)           AS total_badges
FROM   qual_q q
JOIN   `bigquery-public-data.stackoverflow.users` u
       ON u.id = q.owner_user_id
LEFT  JOIN user_badges b
       ON b.user_id = u.id
ORDER BY body_length DESC
LIMIT 10;
```

