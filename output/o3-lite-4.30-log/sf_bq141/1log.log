Query:
--Description: Full pipeline—build stage centroids from TRAIN patients (deterministic HASH split),
--then assign each TEST patient to the clinical stage whose centroid is closest in Euclidean
--distance across MT‑CO1, MT‑CO2, and MT‑CO3 expression values.  Returns 20 predicted labels.
WITH kirp_expr AS (
    SELECT e."case_barcode",
           MAX(CASE WHEN e."gene_name" = 'MT-CO1' THEN e."HTSeq__FPKM_UQ" END) AS "MT_CO1",
           MAX(CASE WHEN e."gene_name" = 'MT-CO2' THEN e."HTSeq__FPKM_UQ" END) AS "MT_CO2",
           MAX(CASE WHEN e."gene_name" = 'MT-CO3' THEN e."HTSeq__FPKM_UQ" END) AS "MT_CO3"
    FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION e
    WHERE e."gene_name" IN ('MT-CO1','MT-CO2','MT-CO3')
    GROUP BY e."case_barcode"
),
kirp_clin AS (
    SELECT c."case_barcode",
           c."clinical_stage"
    FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL c
    WHERE c."disease_code" = 'KIRP'
      AND c."clinical_stage" IS NOT NULL
),
stage_centroids AS (
    SELECT kc."clinical_stage",
           AVG(ke."MT_CO1") AS "cent_MT_CO1",
           AVG(ke."MT_CO2") AS "cent_MT_CO2",
           AVG(ke."MT_CO3") AS "cent_MT_CO3"
    FROM kirp_clin kc
    JOIN kirp_expr ke ON ke."case_barcode" = kc."case_barcode"
    WHERE MOD(ABS(HASH(kc."case_barcode")), 10) < 9         -- TRAIN
    GROUP BY kc."clinical_stage"
),
test_set AS (
    SELECT kc."case_barcode",
           ke."MT_CO1",
           ke."MT_CO2",
           ke."MT_CO3"
    FROM kirp_clin kc
    JOIN kirp_expr ke ON ke."case_barcode" = kc."case_barcode"
    WHERE MOD(ABS(HASH(kc."case_barcode")), 10) >= 9        -- TEST
)
SELECT t."case_barcode",
       FIRST_VALUE(sc."clinical_stage") OVER (
           PARTITION BY t."case_barcode"
           ORDER BY SQRT( POWER(t."MT_CO1" - sc."cent_MT_CO1", 2 )
                        + POWER(t."MT_CO2" - sc."cent_MT_CO2", 2 )
                        + POWER(t."MT_CO3" - sc."cent_MT_CO3", 2 ) )
       ) AS "predicted_clinical_stage"
FROM test_set      t
CROSS JOIN stage_centroids sc
QUALIFY ROW_NUMBER() OVER (
           PARTITION BY t."case_barcode"
           ORDER BY SQRT( POWER(t."MT_CO1" - sc."cent_MT_CO1", 2 )
                        + POWER(t."MT_CO2" - sc."cent_MT_CO2", 2 )
                        + POWER(t."MT_CO3" - sc."cent_MT_CO3", 2 ) )
       ) = 1
LIMIT 20
