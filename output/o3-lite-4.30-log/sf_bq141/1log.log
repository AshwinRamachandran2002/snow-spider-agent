Begin Exploring Related Columns
Relevant columns and their potential usage  
• “disease_code”: filter to kidney renal papillary cell carcinoma cohort (value = ‘KIRP’)  
• “clinical_stage”: provides the stage labels that will be predicted; must be non‑NULL  
• “case_barcode”: unique patient identifier; used for joins, random split, and final output  
• “gene_name”: used to pick the three mitochondrially encoded genes ‘MT‑CO3’, ‘MT‑CO1’, ‘MT‑CO2’  
• “HTSeq__FPKM_UQ”: gene‑expression value subjected to averaging, distance calculation, etc.  
• “project_short_name”: quick sanity‑check that rows indeed belong to TCGA‑KIRP (optional extra filter)  

Typical conditions  
• "disease_code" = 'KIRP'  
• "clinical_stage" IS NOT NULL  
• "gene_name" IN ('MT-CO1', 'MT-CO2', 'MT-CO3')  
• Using FARM_FINGERPRINT(CAST("case_barcode" AS STRING)) % 10 < 9 ⇒ training set, else test set  

Below are ten exploratory‑to‑complex Snowflake SQL snippets (each returns ≤20 rows) to understand the data and build toward the full solution.

```sql
-- 1) Description: glance at how many distinct disease codes exist in the clinical table
SELECT DISTINCT "disease_code"
FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
LIMIT 20;
```

```sql
-- 2) Description: list 20 kidney‑papillary patients that already have a clinical stage recorded
SELECT "case_barcode", "clinical_stage"
FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
WHERE "disease_code" = 'KIRP'
  AND "clinical_stage" IS NOT NULL
LIMIT 20;
```

```sql
-- 3) Description: show the distinct stage labels present for TCGA‑KIRP
SELECT DISTINCT "clinical_stage"
FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
WHERE "disease_code" = 'KIRP'
  AND "clinical_stage" IS NOT NULL
LIMIT 20;
```

```sql
-- 4) Description: preview the gene‑expression rows for the three MT‑CO genes
SELECT "case_barcode",
       "sample_barcode",
       "gene_name",
       "HTSeq__FPKM_UQ"
FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION
WHERE "gene_name" IN ('MT-CO1','MT-CO2','MT-CO3')
LIMIT 20;
```

```sql
-- 5) Description: join clinical & expression to make sure every KIRP case has expression for MT‑CO1
SELECT c."case_barcode",
       c."clinical_stage",
       e."HTSeq__FPKM_UQ" AS "MT_CO1_FPKM_UQ"
FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL                         c
JOIN TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION         e
  ON e."case_barcode" = c."case_barcode"
WHERE c."disease_code"  = 'KIRP'
  AND c."clinical_stage" IS NOT NULL
  AND e."gene_name" = 'MT-CO1'
LIMIT 20;
```

```sql
-- 6) Description: check that each KIRP case has exactly one row per MT‑CO gene (sanity)
SELECT e."case_barcode",
       COUNT(DISTINCT e."gene_name") AS "num_MT_CO_genes"
FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION e
WHERE e."gene_name" IN ('MT-CO1','MT-CO2','MT-CO3')
GROUP BY e."case_barcode"
HAVING COUNT(DISTINCT e."gene_name") <> 3     -- non‑conforming samples
LIMIT 20;
```

```sql
-- 7) Description: create a per‑patient vector of the three MT‑CO expression values
SELECT e."case_barcode",
       MAX(CASE WHEN e."gene_name" = 'MT-CO1' THEN e."HTSeq__FPKM_UQ" END) AS "MT_CO1",
       MAX(CASE WHEN e."gene_name" = 'MT-CO2' THEN e."HTSeq__FPKM_UQ" END) AS "MT_CO2",
       MAX(CASE WHEN e."gene_name" = 'MT-CO3' THEN e."HTSeq__FPKM_UQ" END) AS "MT_CO3"
FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION e
WHERE e."gene_name" IN ('MT-CO1','MT-CO2','MT-CO3')
GROUP BY e."case_barcode"
LIMIT 20;
```

```sql
-- 8) Description: randomly split KIRP patients 90/10 via FARM_FINGERPRINT modulo trick
SELECT c."case_barcode",
       CASE
         WHEN ABS(FARM_FINGERPRINT(CAST(c."case_barcode" AS STRING))) % 10 < 9 THEN 'TRAIN'
         ELSE 'TEST'
       END AS "split_bucket"
FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL c
WHERE c."disease_code" = 'KIRP'
  AND c."clinical_stage" IS NOT NULL
LIMIT 20;
```

```sql
-- 9) Description: average MT‑CO expression per clinical stage *inside the training split*
WITH kirp_expr AS (
  SELECT e."case_barcode",
         e."gene_name",
         e."HTSeq__FPKM_UQ"
    FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION e
   WHERE e."gene_name" IN ('MT-CO1','MT-CO2','MT-CO3')
),
kirp_clin AS (
  SELECT c."case_barcode",
         c."clinical_stage"
    FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL c
   WHERE c."disease_code" = 'KIRP'
     AND c."clinical_stage" IS NOT NULL
),
train_samples AS (
  SELECT kc."case_barcode",
         kc."clinical_stage"
  FROM kirp_clin kc
  WHERE ABS(FARM_FINGERPRINT(CAST(kc."case_barcode" AS STRING))) % 10 < 9
)
SELECT ts."clinical_stage",
       AVG(CASE WHEN ke."gene_name" = 'MT-CO1' THEN ke."HTSeq__FPKM_UQ" END) AS "avg_MT_CO1",
       AVG(CASE WHEN ke."gene_name" = 'MT-CO2' THEN ke."HTSeq__FPKM_UQ" END) AS "avg_MT_CO2",
       AVG(CASE WHEN ke."gene_name" = 'MT-CO3' THEN ke."HTSeq__FPKM_UQ" END) AS "avg_MT_CO3"
FROM train_samples ts
JOIN kirp_expr ke
  ON ke."case_barcode" = ts."case_barcode"
GROUP BY ts."clinical_stage"
LIMIT 20;
```

```sql
-- 10) Description: full pipeline – assign each test patient to the nearest stage centroid (Euclidean distance) and return the prediction
WITH kirp_expr AS (
  SELECT e."case_barcode",
         MAX(CASE WHEN e."gene_name" = 'MT-CO1' THEN e."HTSeq__FPKM_UQ" END) AS "MT_CO1",
         MAX(CASE WHEN e."gene_name" = 'MT-CO2' THEN e."HTSeq__FPKM_UQ" END) AS "MT_CO2",
         MAX(CASE WHEN e."gene_name" = 'MT-CO3' THEN e."HTSeq__FPKM_UQ" END) AS "MT_CO3"
  FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION e
  WHERE e."gene_name" IN ('MT-CO1','MT-CO2','MT-CO3')
  GROUP BY e."case_barcode"
),
kirp_clin AS (
  SELECT c."case_barcode",
         c."clinical_stage"
  FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL c
  WHERE c."disease_code" = 'KIRP'
    AND c."clinical_stage" IS NOT NULL
),
stage_centroids AS (
  SELECT kc."clinical_stage",
         AVG(ke."MT_CO1") AS "cent_MT_CO1",
         AVG(ke."MT_CO2") AS "cent_MT_CO2",
         AVG(ke."MT_CO3") AS "cent_MT_CO3"
  FROM kirp_clin kc
  JOIN kirp_expr ke ON ke."case_barcode" = kc."case_barcode"
  WHERE ABS(FARM_FINGERPRINT(CAST(kc."case_barcode" AS STRING))) % 10 < 9   -- TRAIN
  GROUP BY kc."clinical_stage"
),
test_set AS (
  SELECT kc."case_barcode",
         ke."MT_CO1",
         ke."MT_CO2",
         ke."MT_CO3"
  FROM kirp_clin kc
  JOIN kirp_expr ke ON ke."case_barcode" = kc."case_barcode"
  WHERE ABS(FARM_FINGERPRINT(CAST(kc."case_barcode" AS STRING))) % 10 >= 9   -- TEST
)
SELECT t."case_barcode",
       FIRST_VALUE(sc."clinical_stage") OVER (
           PARTITION BY t."case_barcode"
           ORDER BY SQRT( POWER(t."MT_CO1" - sc."cent_MT_CO1",2)
                         + POWER(t."MT_CO2" - sc."cent_MT_CO2",2)
                         + POWER(t."MT_CO3" - sc."cent_MT_CO3",2) )
       ) AS "predicted_clinical_stage"
FROM test_set                       t
CROSS JOIN stage_centroids          sc
QUALIFY ROW_NUMBER() OVER (
           PARTITION BY t."case_barcode"
           ORDER BY SQRT( POWER(t."MT_CO1" - sc."cent_MT_CO1",2)
                         + POWER(t."MT_CO2" - sc."cent_MT_CO2",2)
                         + POWER(t."MT_CO3" - sc."cent_MT_CO3",2) )
       ) = 1
LIMIT 20;
```

These ten queries progress from inspecting the raw data to producing the requested case‑level clinical‑stage predictions while adhering strictly to the specified tables and columns.
