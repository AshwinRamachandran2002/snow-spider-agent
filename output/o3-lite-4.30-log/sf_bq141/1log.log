--Description: deterministic 90 / 10 train‑test split for TCGA‑KIRP patients
--Thinking process:
-- 1) Keep only rows with disease_code = 'KIRP' and non‑NULL clinical_stage.
-- 2) Use CRC32(barcode) to obtain a repeatable 32‑bit integer hash for each case_barcode.
-- 3) MOD(hash,10) maps that integer to buckets 0‑9.
-- 4) Reserve buckets 0‑8 for TRAIN (~90 %) and bucket 9 for TEST (~10 %).
-- 5) Return a sample of 20 rows to verify the split.
SELECT
    c."case_barcode",
    CASE
        WHEN MOD(ABS(CRC32(c."case_barcode")), 10) < 9 THEN 'TRAIN'
        ELSE 'TEST'
    END AS "split_bucket"
FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL AS c
WHERE c."disease_code" = 'KIRP'
  AND c."clinical_stage" IS NOT NULL
LIMIT 20;
