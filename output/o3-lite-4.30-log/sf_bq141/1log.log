--Description: create a deterministic 90 / 10 split for TCGA‑KIRP patients who have a recorded
--clinical stage.  HASH(<string>) yields a reproducible 64‑bit integer; ABS() makes it non‑negative
--and MOD 10 bins it into values 0–9.  Buckets 0–8 (≈90 %) are labeled TRAIN, bucket 9 (≈10 %)
--TEST.  Return 20 example rows to verify the logic.
SELECT
       c."case_barcode",
       CASE
           WHEN MOD(ABS(HASH(c."case_barcode")), 10) < 9 THEN 'TRAIN'
           ELSE 'TEST'
       END AS "split_bucket"
FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL AS c
WHERE c."disease_code" = 'KIRP'
  AND c."clinical_stage" IS NOT NULL
LIMIT 20;
