```sql
WITH eligible_cases AS (                 -- KIRP patients with a known clinical stage
    SELECT
        "case_barcode",
        "clinical_stage"
    FROM "TCGA_HG38_DATA_V0"."TCGA_BIOCLIN_V0"."CLINICAL"
    WHERE "disease_code"   = 'KIRP'
      AND "clinical_stage" IS NOT NULL
),
split AS (                               -- 90 % TRAIN / 10 % TEST via FARM_FINGERPRINT
    SELECT
        "case_barcode",
        "clinical_stage",
        CASE
            WHEN ABS(MOD(FARM_FINGERPRINT("case_barcode"), 10)) < 9 THEN 'TRAIN'
            ELSE 'TEST'
        END AS "set_type"
    FROM eligible_cases
),
expr AS (                                -- expression rows for the three target genes
    SELECT
        "case_barcode",
        "gene_name",
        "HTSeq__FPKM_UQ"
    FROM "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."RNASEQ_GENE_EXPRESSION"
    WHERE "project_short_name" = 'TCGA-KIRP'
      AND "gene_name" IN ('MT-CO1', 'MT-CO2', 'MT-CO3')
),
pivot AS (                               -- one row per patient with three expression cols
    SELECT
        "case_barcode",
        MAX(CASE WHEN "gene_name" = 'MT-CO1' THEN "HTSeq__FPKM_UQ" END) AS "MT_CO1",
        MAX(CASE WHEN "gene_name" = 'MT-CO2' THEN "HTSeq__FPKM_UQ" END) AS "MT_CO2",
        MAX(CASE WHEN "gene_name" = 'MT-CO3' THEN "HTSeq__FPKM_UQ" END) AS "MT_CO3"
    FROM expr
    GROUP BY "case_barcode"
),
data AS (                                -- merge clinical, split flag, and expression
    SELECT
        s."case_barcode",
        s."clinical_stage",
        s."set_type",
        p."MT_CO1",
        p."MT_CO2",
        p."MT_CO3"
    FROM split  s
    JOIN pivot  p
      ON s."case_barcode" = p."case_barcode"
),
stage_mean AS (                          -- stage‑specific centroid from TRAIN cohort
    SELECT
        "clinical_stage",
        AVG("MT_CO1") AS "AVG_MT_CO1",
        AVG("MT_CO2") AS "AVG_MT_CO2",
        AVG("MT_CO3") AS "AVG_MT_CO3"
    FROM data
    WHERE "set_type" = 'TRAIN'
    GROUP BY "clinical_stage"
),
distances AS (                           -- distance of each TEST patient to every centroid
    SELECT
        d."case_barcode",
        m."clinical_stage"                                    AS "candidate_stage",
        SQRT( POWER(d."MT_CO1" - m."AVG_MT_CO1", 2)
            + POWER(d."MT_CO2" - m."AVG_MT_CO2", 2)
            + POWER(d."MT_CO3" - m."AVG_MT_CO3", 2) )         AS "distance"
    FROM data d
    JOIN stage_mean m
    WHERE d."set_type" = 'TEST'
),
nearest AS (                             -- select the nearest centroid per patient
    SELECT
        "case_barcode",
        "candidate_stage",
        ROW_NUMBER() OVER (PARTITION BY "case_barcode" ORDER BY "distance") AS rn
    FROM distances
)
SELECT
    "case_barcode",
    "candidate_stage" AS predicted_clinical_stage
FROM nearest
WHERE rn = 1
ORDER BY "case_barcode";
```
