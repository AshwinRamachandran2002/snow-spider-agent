Query:
--Description: Compute the mean HTSeq__FPKM_UQ expression of MT‑CO3 for each clinical stage
--             among KIRP patients in the TRAIN cohort (≈90 %) using HASH() instead of
--             the unavailable FARM_FINGERPRINT.  HASH(case_barcode) % 10 < 9 ⇒ TRAIN.
SELECT
    c."clinical_stage",
    AVG(r."HTSeq__FPKM_UQ") AS "avg_mt_co3_fpkm_uq"
FROM "TCGA_HG38_DATA_V0"."TCGA_BIOCLIN_V0"."CLINICAL"            c
JOIN "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."RNASEQ_GENE_EXPRESSION" r
  ON c."case_barcode" = r."case_barcode"
WHERE c."disease_code" = 'KIRP'
  AND c."clinical_stage" IS NOT NULL
  AND r."gene_name" = 'MT-CO3'
  AND ABS(MOD(HASH(c."case_barcode"), 10)) < 9      -- TRAIN cohort
GROUP BY c."clinical_stage"
LIMIT 20
