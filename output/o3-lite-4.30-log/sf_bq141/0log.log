WITH eligible_cases AS (
    SELECT
        "case_barcode",
        "clinical_stage"
    FROM "TCGA_HG38_DATA_V0"."TCGA_BIOCLIN_V0"."CLINICAL"
    WHERE "disease_code" = 'KIRP'
      AND "clinical_stage" IS NOT NULL
),
train_test_split AS (
    SELECT
        "case_barcode",
        "clinical_stage",
        CASE
            WHEN ABS(MOD(HASH("case_barcode"),10)) < 9 THEN 'TRAIN'
            ELSE 'TEST'
        END AS "set_type"
    FROM eligible_cases
),
expr AS (
    SELECT
        "case_barcode",
        "gene_name",
        "HTSeq__FPKM_UQ"
    FROM "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."RNASEQ_GENE_EXPRESSION"
    WHERE "project_short_name" = 'TCGA-KIRP'
      AND "gene_name" IN ('MT-CO1','MT-CO2','MT-CO3')
),
expr_pivot AS (
    SELECT
        "case_barcode",
        MAX(CASE WHEN "gene_name" = 'MT-CO1' THEN "HTSeq__FPKM_UQ" END) AS "MT_CO1",
        MAX(CASE WHEN "gene_name" = 'MT-CO2' THEN "HTSeq__FPKM_UQ" END) AS "MT_CO2",
        MAX(CASE WHEN "gene_name" = 'MT-CO3' THEN "HTSeq__FPKM_UQ" END) AS "MT_CO3"
    FROM expr
    GROUP BY "case_barcode"
),
combined AS (
    SELECT
        t."case_barcode",
        t."clinical_stage",
        t."set_type",
        p."MT_CO1",
        p."MT_CO2",
        p."MT_CO3"
    FROM train_test_split t
    JOIN expr_pivot p
      ON t."case_barcode" = p."case_barcode"
    WHERE p."MT_CO1" IS NOT NULL
      AND p."MT_CO2" IS NOT NULL
      AND p."MT_CO3" IS NOT NULL
),
stage_avg AS (
    SELECT
        "clinical_stage",
        AVG("MT_CO1") AS "AVG_MT_CO1",
        AVG("MT_CO2") AS "AVG_MT_CO2",
        AVG("MT_CO3") AS "AVG_MT_CO3"
    FROM combined
    WHERE "set_type" = 'TRAIN'
    GROUP BY "clinical_stage"
),
test_vs_avg AS (
    SELECT
        c."case_barcode",
        s."clinical_stage" AS "stage_candidate",
        SQRT(
            POW(c."MT_CO1" - s."AVG_MT_CO1", 2) +
            POW(c."MT_CO2" - s."AVG_MT_CO2", 2) +
            POW(c."MT_CO3" - s."AVG_MT_CO3", 2)
        ) AS "distance"
    FROM combined c
    CROSS JOIN stage_avg s
    WHERE c."set_type" = 'TEST'
),
ranked AS (
    SELECT
        *,
        ROW_NUMBER() OVER (PARTITION BY "case_barcode" ORDER BY "distance") AS rn
    FROM test_vs_avg
)
SELECT
    "case_barcode",
    "stage_candidate" AS predicted_clinical_stage
FROM ranked
WHERE rn = 1
ORDER BY "case_barcode";
```
