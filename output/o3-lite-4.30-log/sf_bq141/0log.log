```sql
--Description / Thinking process:
-- 1) Task asks for a 90 % / 10 % split via FARM_FINGERPRINT, but Snowflake lacks that function.
-- 2) HASH() is deterministic and returns a signed 64‑bit integer, so we can replicate the idea.
-- 3) Compute ABS(MOD(HASH(case_barcode),10)).  Range is 0‑9.
-- 4) Define TRAIN when result < 9 (≈90 %), TEST when result = 9 (≈10 %).
-- 5) Work only on KIRP patients that have a non‑null clinical_stage.
-- 6) Show a sample (LIMIT 20) to confirm the logic.
SELECT
    "case_barcode",
    "clinical_stage",
    ABS(MOD(HASH("case_barcode"), 10)) AS "hash_mod_10",
    CASE
        WHEN ABS(MOD(HASH("case_barcode"), 10)) < 9 THEN 'TRAIN'
        ELSE 'TEST'
    END AS "set_type"
FROM "TCGA_HG38_DATA_V0"."TCGA_BIOCLIN_V0"."CLINICAL"
WHERE "disease_code" = 'KIRP'
  AND "clinical_stage" IS NOT NULL
LIMIT 20;
```
