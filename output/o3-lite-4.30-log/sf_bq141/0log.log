            POWER(c."MT_CO3" - s."AVG_MT_CO3", 2)
        ) AS "distance"
    FROM combined c
    CROSS JOIN stage_avg s
    WHERE c."set_type" = 'TEST'
),
ranked AS (
    SELECT
        "case_barcode",
        "candidate_stage",
        ROW_NUMBER() OVER (PARTITION BY "case_barcode" ORDER BY "distance") AS rn
    FROM test_vs_avg
)
SELECT
    "case_barcode",
    "candidate_stage" AS predicted_clinical_stage
FROM ranked
WHERE rn = 1
ORDER BY "case_barcode";
