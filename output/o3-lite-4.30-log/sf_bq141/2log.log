```sql
WITH kirp_expr AS (   -- 1.  Pivot CO‑gene expression per KIRP patient
    SELECT
        c."case_barcode",
        c."clinical_stage",
        MAX(CASE WHEN e."gene_name" = 'MT-CO1' THEN e."HTSeq__FPKM_UQ" END) AS "MT_CO1",
        MAX(CASE WHEN e."gene_name" = 'MT-CO2' THEN e."HTSeq__FPKM_UQ" END) AS "MT_CO2",
        MAX(CASE WHEN e."gene_name" = 'MT-CO3' THEN e."HTSeq__FPKM_UQ" END) AS "MT_CO3"
    FROM "TCGA_HG38_DATA_V0"."TCGA_BIOCLIN_V0"."CLINICAL"                c
    JOIN "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."RNASEQ_GENE_EXPRESSION" e
      ON c."case_barcode" = e."case_barcode"
    WHERE c."disease_code"   = 'KIRP'
      AND c."clinical_stage" IS NOT NULL            -- keep only staged patients
      AND TRIM(c."clinical_stage") <> ''            -- drop empty strings
      AND e."gene_name" IN ('MT-CO1','MT-CO2','MT-CO3')
    GROUP BY c."case_barcode", c."clinical_stage"
),
splits AS (          -- 2.  Deterministic 90/10 split with FARM_FINGERPRINT
    SELECT *,
           ABS(FARM_FINGERPRINT("case_barcode")) % 10 AS bucket
    FROM kirp_expr
),
train_data AS (SELECT * FROM splits WHERE bucket < 9),   -- 90 %
test_data  AS (SELECT * FROM splits WHERE bucket = 9),   -- 10 %
stage_means AS (       -- 3.  Mean expression of each CO‑gene per stage (train only)
    SELECT
        "clinical_stage",
        AVG("MT_CO1") AS avg_co1,
        AVG("MT_CO2") AS avg_co2,
        AVG("MT_CO3") AS avg_co3
    FROM train_data
    GROUP BY "clinical_stage"
),
pred_dist AS (        -- 4.  Euclidean distance from every test patient to each stage mean
    SELECT
        t."case_barcode",
        s."clinical_stage" AS predicted_clinical_stage,
        SQRT( POWER(COALESCE(t."MT_CO1",0) - COALESCE(s.avg_co1,0), 2) +
              POWER(COALESCE(t."MT_CO2",0) - COALESCE(s.avg_co2,0), 2) +
              POWER(COALESCE(t."MT_CO3",0) - COALESCE(s.avg_co3,0), 2) ) AS dist
    FROM test_data  t
    CROSS JOIN stage_means s
)
SELECT
    "case_barcode",
    "predicted_clinical_stage"
FROM (
    SELECT
        pd.*,
        ROW_NUMBER() OVER (PARTITION BY pd."case_barcode"
                           ORDER BY pd.dist) AS rn
    FROM pred_dist pd
)
WHERE rn = 1                  -- 5. Keep nearest stage only
ORDER BY "case_barcode";
```
