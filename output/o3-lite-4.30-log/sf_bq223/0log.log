--Description: To view how primary CPC codes are represented, we flatten the CPC
--variant column.  The FLATTEN operator returns an "INDEX" field showing the
--position of each array element; INDEX = 0 therefore corresponds to the first
--(primary) CPC code.  Selecting only those rows lets us see, for 20 random
--publications, which primary codes they carry.
SELECT
    t."publication_number",
    cp.value:"code"::STRING AS "primary_cpc_code"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc", OUTER => TRUE) cp
WHERE cp."INDEX" = 0
LIMIT 20;
