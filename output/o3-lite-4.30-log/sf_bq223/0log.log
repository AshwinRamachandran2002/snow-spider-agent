```sql
--Description: 
-- 9. Verify the overall logic on a sample citing patent (excluding DENSO as citer),
--    keeping only the first CPC element (INDEX = 0).  We first collect all DENSO
--    patents, then build a CTE of citations that reference those patents, capture
--    each citing patent’s first CPC code, and finally filter out any citing
--    assignee that is DENSO itself.  Display 20 example rows.
WITH denso AS (
    SELECT DISTINCT t."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."assignee_harmonized") ah
    WHERE ah.value::STRING ILIKE '%DENSO%CORP%'
),
citing AS (
    SELECT
        t."publication_number"                          AS "citing_pub",
        ca.value::STRING                                AS "citing_assignee",
        cp.value:"code"::STRING                         AS "primary_cpc",
        c.value:"publication_number"::STRING            AS "cited_pub"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."assignee_harmonized") ca,
         LATERAL FLATTEN(input => t."citation") c,
         LATERAL FLATTEN(input => t."cpc", OUTER => TRUE) cp
    WHERE cp."INDEX" = 0                                -- keep only first CPC element
)
SELECT *
FROM citing
WHERE "cited_pub" IN (SELECT * FROM denso)
  AND "citing_assignee" NOT ILIKE '%DENSO%CORP%'
LIMIT 20;
```

```sql
--Description: 
-- 10. FINAL query – Count citations of DENSO patents by external assignee and
--     primary CPC subclass.  Steps:
--     (1) Identify every DENSO‑assigned publication with a valid filing date.
--     (2) For every other patent, explode its citations and first CPC code
--         (INDEX = 0).  Keep only those rows that cite a DENSO publication.
--     (3) Exclude instances where the citing assignee is DENSO itself.
--     (4) Join the primary CPC code to CPC_DEFINITION for the full subclass title.
--     (5) Aggregate and list the number of citations per (assignee × CPC title).
WITH denso AS (
    SELECT DISTINCT t."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."assignee_harmonized") ah
    WHERE ah.value::STRING ILIKE '%DENSO%CORP%'
      AND t."filing_date" > 0
),
citing_side AS (
    SELECT
        t."publication_number"                          AS "citing_pub",
        ca.value::STRING                                AS "citing_assignee",
        cp.value:"code"::STRING                         AS "primary_cpc",
        c.value:"publication_number"::STRING            AS "cited_pub"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."assignee_harmonized") ca,
         LATERAL FLATTEN(input => t."citation") c,
         LATERAL FLATTEN(input => t."cpc", OUTER => TRUE) cp
    WHERE cp."INDEX" = 0                                -- first CPC element
),
joined AS (
    SELECT
        cs."citing_assignee",
        cs."primary_cpc"
    FROM citing_side cs
    WHERE cs."cited_pub" IN (SELECT * FROM denso)
      AND cs."citing_assignee" NOT ILIKE '%DENSO%CORP%'
)
SELECT
    j."citing_assignee",
    d."titleFull"           AS "cpc_subclass_title",
    COUNT(*)                AS "citation_count"
FROM joined j
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = j."primary_cpc"
GROUP BY j."citing_assignee", d."titleFull"
ORDER BY "citation_count" DESC
LIMIT 20;
```
