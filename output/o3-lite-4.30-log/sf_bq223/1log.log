```sql
--Description: 
-- Purpose: produce an aggregated view – for each non‑DENSO assignee, count how
-- many distinct publications they have that cite at least one DENSO‑assigned
-- patent, broken‑down by the title of the citing publication’s primary CPC
-- subclass.  This is the core result requested, but written to execute fast.
--
-- Thinking process & optimisation steps
-- 1) Build a compact CTE (denso_pubs) holding all publication_numbers whose
--    assignee list contains “DENSO CORP” and that have a valid filing_date.
--    This is small relative to the full publications table.
-- 2) In the main query, flatten each candidate citing publication’s citation
--    array and immediately INNER‑JOIN to denso_pubs, so we only retain rows
--    that actually reference a DENSO patent; this prunes data early.
-- 3) Flatten the citing publication’s assignee_harmonized array to get each
--    assignee name, and exclude those matching DENSO.
-- 4) Flatten the citing publication’s CPC array, but keep only cp.index = 0
--    (primary CPC).  Join to CPC_DEFINITION on the first four characters to
--    obtain the full subclass title.
-- 5) Group by citing assignee and CPC title; count DISTINCT citing publication
--    numbers to avoid double‑counting if a single pub cites multiple DENSO
--    patents.  LIMIT 20 keeps runtime & output small while testing.
WITH denso_pubs AS (
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE a.value::STRING ILIKE '%DENSO%CORP%'
      AND p."filing_date" IS NOT NULL
)
SELECT
       ca.value::STRING                         AS "citing_assignee",
       cd."titleFull"                           AS "cpc_title",
       COUNT(DISTINCT p."publication_number")   AS "num_citations"
FROM PATENTS.PATENTS.PUBLICATIONS p
     -- citing assignees
     , LATERAL FLATTEN(input => p."assignee_harmonized") ca
     -- citing publications’ citations
     , LATERAL FLATTEN(input => p."citation") cit
     -- retain only citations that point to DENSO patents
     JOIN denso_pubs dp
       ON cit.value:"publication_number"::STRING = dp."publication_number"
     -- citing publications’ primary CPC
     , LATERAL FLATTEN(input => p."cpc") cp
     -- CPC definition join for title
     JOIN PATENTS.PATENTS.CPC_DEFINITION cd
       ON cd."symbol" = SUBSTR(cp.value:"code"::STRING, 1, 4)
WHERE cp.index = 0
  AND p."filing_date" IS NOT NULL
  AND ca.value::STRING NOT ILIKE '%DENSO%CORP%'
GROUP BY ca.value::STRING, cd."titleFull"
ORDER BY "num_citations" DESC
LIMIT 20;
```
