```sql
SELECT
       TRIM(ca.value:"name"::STRING)                                        AS "citing_assignee",
       cd."titleFull"                                                      AS "cpc_subclass_title",
       COUNT(*)                                                            AS "citation_count"
FROM PATENTS.PATENTS.PUBLICATIONS              p
     -- citing‑side assignees
     , LATERAL FLATTEN(input => p."assignee_harmonized")            ca
     -- citing‑side citations
     , LATERAL FLATTEN(input => p."citation")                       cit
     -- citing‑side CPC codes (keep only the first / primary one)
     , LATERAL FLATTEN(input => p."cpc")                            cp
     -- join to CPC definition on the first 4 characters of the CPC code
JOIN PATENTS.PATENTS.CPC_DEFINITION             cd
  ON cd."symbol" = SUBSTR(cp.value:"code"::STRING, 1, 4)
WHERE cp.index = 0                                   -- primary CPC only
  AND p."filing_date" IS NOT NULL                   -- citing patent has valid filing date
  AND cit.value:"publication_number"::STRING IS NOT NULL
  -- cited publication is assigned to DENSO CORP and has valid filing date
  AND EXISTS (
        SELECT 1
        FROM PATENTS.PATENTS.PUBLICATIONS       d,
             LATERAL FLATTEN(input => d."assignee_harmonized") da
        WHERE d."publication_number" = cit.value:"publication_number"::STRING
          AND da.value:"name"::STRING ILIKE '%DENSO%CORP%'
          AND d."filing_date" IS NOT NULL
      )
  -- EXCLUDE DENSO CORP as a citing assignee
  AND ca.value:"name"::STRING NOT ILIKE '%DENSO%CORP%'
GROUP BY
       TRIM(ca.value:"name"::STRING),
       cd."titleFull"
