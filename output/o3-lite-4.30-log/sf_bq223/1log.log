--Description: 
-- Quickly list 20 DISTINCT, non‑DENSO assignees whose publications cite at least
-- one patent assigned to “DENSO CORP”.  For each citing publication, show the
-- publication number, the assignee name, its primary CPC code, and the full
-- CPC subclass title.  A compact CTE (denso_pubs) is used to filter citation
-- rows early, preventing time‑outs.
WITH denso_pubs AS (
    /* Step 1: Gather all publication numbers that are assigned to DENSO CORP */
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE a.value::STRING ILIKE '%DENSO%CORP%'
      AND p."filing_date" IS NOT NULL
)
SELECT DISTINCT
       p."publication_number"                        AS "citing_pub",
       ca.value::STRING                              AS "citing_assignee",
       SUBSTR(cp.value:"code"::STRING, 1, 7)         AS "primary_cpc",
       cd."titleFull"                                AS "cpc_title"
FROM PATENTS.PATENTS.PUBLICATIONS p
     /* Step 2: Retain only citations that point to patents in denso_pubs */
     , LATERAL FLATTEN(input => p."citation") cit
     JOIN denso_pubs dp
       ON cit.value:"publication_number"::STRING = dp."publication_number"
     /* Step 3: Expand assignees (exclude DENSO) and primary CPC of the citing pub */
     , LATERAL FLATTEN(input => p."assignee_harmonized") ca
     , LATERAL FLATTEN(input => p."cpc") cp
     JOIN PATENTS.PATENTS.CPC_DEFINITION cd
       ON cd."symbol" = SUBSTR(cp.value:"code"::STRING, 1, 4)
WHERE p."filing_date" IS NOT NULL       -- citing pub has valid filing date
  AND cp.index = 0                      -- primary CPC only
  AND ca.value::STRING NOT ILIKE '%DENSO%CORP%'  -- exclude DENSO as citing assignee
LIMIT 20;
