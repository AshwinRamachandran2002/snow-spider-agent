```sql
--Description: 
-- 5) Identify whether a cited publication (from any citation) belongs to
--    DENSO CORP.  The EXISTS sub‑query checks the assignee of the cited
--    publication.  Basic filters only ensure non‑null publication numbers and
--    valid filing dates for both citing and cited patents.
SELECT DISTINCT
       c.value:"publication_number"::STRING AS "cited_pub"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") c
WHERE c.value:"publication_number"::STRING IS NOT NULL
  AND EXISTS (
        SELECT 1
        FROM PATENTS.PATENTS.PUBLICATIONS d,
             LATERAL FLATTEN(input => d."assignee_harmonized") da
        WHERE d."publication_number" = c.value:"publication_number"::STRING
          AND da.value::STRING ILIKE '%DENSO%CORP%'
          AND d."filing_date" IS NOT NULL
      )
LIMIT 20;
```

```sql
--Description: 
-- 6) View the primary (index 0) CPC code for a set of patents to confirm the
--    format “A01B33/00” etc.  Only publications with valid filing dates and
--    at least one CPC entry are returned.
SELECT
       p."publication_number",
       cp.value:"code"::STRING AS "primary_cpc_code"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") cp
WHERE cp.index = 0
  AND p."filing_date" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 
-- 7) Take the first four characters of the primary CPC code (ipc4) and join to
--    CPC_DEFINITION to extract the full subclass title, providing a quick
--    mapping sample.
SELECT
       SUBSTR(cp.value:"code"::STRING, 1, 4) AS "ipc4",
       cd."titleFull"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") cp
JOIN PATENTS.PATENTS.CPC_DEFINITION cd
  ON cd."symbol" = SUBSTR(cp.value:"code"::STRING, 1, 4)
WHERE cp.index = 0
LIMIT 20;
```

```sql
--Description: 
-- 8) Pull publications that cite at least one DENSO patent, retrieve their
--    non‑DENSO assignee name, primary CPC, and the CPC title.  LIMIT keeps the
--    result small; filters ensure (i) valid filing date, (ii) primary CPC
--    available, (iii) cited patent assigned to DENSO, and (iv) citing assignee
--    is not DENSO.
SELECT DISTINCT
       p."publication_number"                      AS "citing_pub",
       ca.value::STRING                            AS "citing_assignee",
       SUBSTR(cp.value:"code"::STRING, 1, 7)       AS "primary_cpc",
       cd."titleFull"                              AS "cpc_title"
FROM PATENTS.PATENTS.PUBLICATIONS p
     , LATERAL FLATTEN(input => p."assignee_harmonized") ca
     , LATERAL FLATTEN(input => p."citation") cit
     , LATERAL FLATTEN(input => p."cpc") cp
JOIN PATENTS.PATENTS.CPC_DEFINITION cd
  ON cd."symbol" = SUBSTR(cp.value:"code"::STRING, 1, 4)
WHERE cp.index = 0
  AND p."filing_date" IS NOT NULL
  AND cit.value:"publication_number"::STRING IS NOT NULL
  AND EXISTS (
        SELECT 1
        FROM PATENTS.PATENTS.PUBLICATIONS d,
             LATERAL FLATTEN(input => d."assignee_harmonized") da
        WHERE d."publication_number" = cit.value:"publication_number"::STRING
          AND da.value::STRING ILIKE '%DENSO%CORP%'
          AND d."filing_date" IS NOT NULL
      )
  AND ca.value::STRING NOT ILIKE '%DENSO%CORP%'
LIMIT 20;
```

```sql
--Description: 
-- 9) Aggregate counts of citing publications (excluding DENSO assignees) that
--    reference DENSO patents, grouped by citing assignee and CPC subclass
--    title.  We count distinct citing publications to avoid double‑counting.
SELECT
       ca.value::STRING                      AS "citing_assignee",
       cd."titleFull"                        AS "cpc_title",
       COUNT(DISTINCT p."publication_number") AS "num_citations"
FROM PATENTS.PATENTS.PUBLICATIONS p
     , LATERAL FLATTEN(input => p."assignee_harmonized") ca
     , LATERAL FLATTEN(input => p."citation") cit
     , LATERAL FLATTEN(input => p."cpc") cp
JOIN PATENTS.PATENTS.CPC_DEFINITION cd
  ON cd."symbol" = SUBSTR(cp.value:"code"::STRING, 1, 4)
WHERE cp.index = 0
  AND p."filing_date" IS NOT NULL
  AND cit.value:"publication_number"::STRING IS NOT NULL
  AND EXISTS (
        SELECT 1
        FROM PATENTS.PATENTS.PUBLICATIONS d,
             LATERAL FLATTEN(input => d."assignee_harmonized") da
        WHERE d."publication_number" = cit.value:"publication_number"::STRING
          AND da.value::STRING ILIKE '%DENSO%CORP%'
          AND d."filing_date" IS NOT NULL
      )
  AND ca.value::STRING NOT ILIKE '%DENSO%CORP%'
GROUP BY ca.value::STRING, cd."titleFull"
ORDER BY "num_citations" DESC
LIMIT 20;
```

