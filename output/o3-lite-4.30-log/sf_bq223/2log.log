Query:
--Description: 10) For each non‑DENSO citing assignee, obtain the primary CPC code
--(flagged “first”), count how many DENSO patents they cite, and attach the CPC
--subclass title from CPC_DEFINITION.
WITH denso_pubs AS (
    SELECT DISTINCT
           p."publication_number" AS denso_pub
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."assignee") a
    WHERE a.value::STRING ILIKE '%DENSO%'
),
citing AS (
    SELECT
        t."publication_number"               AS citing_pub,
        a.value::STRING                      AS citing_assignee,
        c.value:"code"::STRING               AS main_cpc_code
    FROM PATENTS.PATENTS.PUBLICATIONS t
         ,LATERAL FLATTEN(input => t."citation") f
         ,LATERAL FLATTEN(input => t."assignee") a
         ,LATERAL FLATTEN(input => t."cpc")     c
    WHERE t."filing_date" IS NOT NULL
      AND t."filing_date" > 0
      AND f.value:"publication_number"::STRING IN (SELECT dp.denso_pub FROM denso_pubs dp)
      AND a.value::STRING NOT ILIKE '%DENSO%'
      AND c.value:"first"::BOOLEAN = TRUE
)
SELECT
    c.citing_assignee,
    d."titleFull"         AS cpc_title,
    COUNT(*)              AS num_citations
FROM citing c
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = c.main_cpc_code
GROUP BY c.citing_assignee, d."titleFull"
ORDER BY num_citations DESC
LIMIT 20
