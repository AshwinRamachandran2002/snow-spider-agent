/* 1.  Build citing–cited pairs, keep non‑DENSO citers,                     */
/*     and pick one CPC code per citing pub (prefer the one flagged FIRST). */
"citing_w_cpc" AS (
    SELECT
        t."publication_number"                       AS citing_pub,
        a2.value:"organization"::STRING              AS citing_assignee,
        c.value:"code"::STRING                       AS main_cpc_code,
        ROW_NUMBER() OVER (PARTITION BY t."publication_number"
                           ORDER BY COALESCE(c.value:"first"::BOOLEAN, FALSE) DESC) AS rn
    FROM PATENTS.PATENTS.PUBLICATIONS t
         ,LATERAL FLATTEN(INPUT => t."citation")              cit
         ,LATERAL FLATTEN(INPUT => t."assignee_harmonized")   a2
         ,LATERAL FLATTEN(INPUT => t."cpc")                   c
    WHERE t."filing_date" IS NOT NULL
      AND t."filing_date" > 0
      AND cit.value:"publication_number"::STRING IN (SELECT "publication_number" FROM "denso_pubs")
      AND a2.value:"organization"::STRING NOT ILIKE '%DENSO%'      -- exclude DENSO as citer
),

/* 2.  Retain exactly one (primary) CPC per citing publication              */
"citing_data" AS (
    SELECT
        citing_pub,
        citing_assignee,
        main_cpc_code,
        SUBSTR(main_cpc_code, 1, 4)                  AS cpc_subclass_code
    FROM "citing_w_cpc"
    WHERE rn = 1
)

/* 3.  Aggregate by assignee and CPC subclass title                         */
SELECT
    cd.citing_assignee                            AS citing_assignee,
    d."titleFull"                                 AS cpc_subclass_title,
    COUNT(*)                                      AS citation_count
FROM "citing_data" cd
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = cd.cpc_subclass_code
GROUP BY cd.citing_assignee, d."titleFull"
ORDER BY citation_count DESC NULLS LAST, citing_assignee;
```
