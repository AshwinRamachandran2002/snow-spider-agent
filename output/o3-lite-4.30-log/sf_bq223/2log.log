```sql
--Description: 1) “denso_pubs” collects all publication numbers whose flattened assignee
--JSON contains the substring “DENSO”.  2) “citing_pairs” flattens the citation arrays
--of every publication with a valid, positive filing date, capturing (citing_pub,
--cited_pub) pairs.  3) The outer query joins these CTEs so we retain only the pairs
--where the cited publication belongs to the DENSO set, i.e., patents that reference
--a DENSO‑assigned patent.
WITH denso_pubs AS (
    SELECT DISTINCT
           p."publication_number" AS denso_pub
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."assignee") a
    WHERE a.value::STRING ILIKE '%DENSO%'
),
citing_pairs AS (
    SELECT
        t."publication_number"               AS citing_pub,
        f.value:"publication_number"::STRING AS cited_pub
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."citation") f
    WHERE t."filing_date" IS NOT NULL
      AND t."filing_date" > 0
      AND f.value:"publication_number" IS NOT NULL
)
SELECT
    cp.citing_pub,
    cp.cited_pub
FROM citing_pairs cp
JOIN denso_pubs dp
  ON cp.cited_pub = dp.denso_pub
LIMIT 20;
```
