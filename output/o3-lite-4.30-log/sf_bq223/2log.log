WITH "denso_pubs" AS (
    /* 1.  All publication numbers that list DENSO as (one of) the assignee(s)   */
    SELECT DISTINCT
           p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."assignee") a
    WHERE a.value:"name"::STRING ILIKE '%DENSO%'
),

"citing_data" AS (
    /* 2.  Every citing‑cited pair in which the cited publication belongs to     */
    /*     DENSO, retaining only:                                                */
    /*         – non‑DENSO citing assignee                                       */
    /*         – citing publications with valid filing dates                     */
    /*         – the primary (first = TRUE) CPC code of the citing publication   */
    SELECT
        t."publication_number"                             AS "citing_pub",
        a.value:"name"::STRING                             AS "citing_assignee",
        c.value:"code"::STRING                             AS "main_cpc_code"
    FROM PATENTS.PATENTS.PUBLICATIONS t
         ,LATERAL FLATTEN(INPUT => t."citation")  cit
         ,LATERAL FLATTEN(INPUT => t."assignee")  a
         ,LATERAL FLATTEN(INPUT => t."cpc")       c
    WHERE t."filing_date" IS NOT NULL
      AND t."filing_date" > 0
      AND cit.value:"publication_number"::STRING IN (SELECT * FROM "denso_pubs")
      AND a.value:"name"::STRING NOT ILIKE '%DENSO%'          -- exclude DENSO as citer
      AND c.value:"first"::BOOLEAN = TRUE                     -- primary CPC only
)

