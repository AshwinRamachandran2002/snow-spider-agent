--Description: 8) Retrieve citing publications (with valid filing dates) that reference
--any DENSO‑assigned patent via their backward citations.  “denso_pubs” captures the
--set of DENSO publications, and “citing” pulls all (citing_pub, cited_pub) pairs.
WITH denso_pubs AS (
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."assignee") a
    WHERE a.value::STRING ILIKE '%DENSO%'
),
citing AS (
    SELECT 
        t."publication_number"               AS "citing_pub",
        f.value:"publication_number"::STRING AS "cited_pub"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."citation") f
    WHERE t."filing_date" IS NOT NULL
      AND t."filing_date" > 0
)
SELECT *
FROM citing
WHERE cited_pub IN (SELECT * FROM denso_pubs)
LIMIT 20
