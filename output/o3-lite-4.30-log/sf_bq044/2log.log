```sql
/* bladder‑cancer (TCGA‑BLCA) patients that harbor a CDKN2A mutation,
   together with basic clinical info (GDC Release 39)
   and RNA‑seq FPKM expression of four downstream genes               */

SELECT
    m."case_barcode"                                             AS case_id,
    LISTAGG(m."Variant_Classification", '; ') 
        WITHIN GROUP (ORDER BY m."Variant_Classification")        AS mutation_type,
    c."demo__gender"                                             AS gender,
    c."demo__vital_status"                                       AS vital_status,
    c."demo__days_to_death"                                      AS days_to_death,
    MAX(CASE WHEN r."gene_name" = 'MDM2'   THEN r."HTSeq__FPKM" END) AS mdm2_expr,
    MAX(CASE WHEN r."gene_name" = 'TP53'   THEN r."HTSeq__FPKM" END) AS tp53_expr,
    MAX(CASE WHEN r."gene_name" = 'CDKN1A' THEN r."HTSeq__FPKM" END) AS cdkn1a_expr,
    MAX(CASE WHEN r."gene_name" = 'CCNE1'  THEN r."HTSeq__FPKM" END) AS ccne1_expr
FROM   TCGA.TCGA_VERSIONED.MASKED_SOMATIC_MUTATION_HG38_GDC_R39  m
JOIN   TCGA.TCGA_VERSIONED.CLINICAL_GDC_R39                      c
       ON m."case_barcode" = c."submitter_id"
