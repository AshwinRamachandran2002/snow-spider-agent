Below are the columns that matter for the requested analysis and how they will be used:

• AMERICAN_COMMUNITY_SURVEY_ATTRIBUTES  
  – "VARIABLE": to locate the Total‑Population variable code (very likely “B01003_001E_5YR”).  
  – "VARIABLE_NAME": human‑readable check.  

• AMERICAN_COMMUNITY_SURVEY_TIMESERIES  
  – "VARIABLE": filter to the Total‑Population code.  
  – "DATE": pick 31‑Dec for every calendar year (ACS 5‑Year).  
  – "GEO_ID": zip‑code level IDs (format: zip/#####).  
  – "VALUE": population estimate we need for growth‑rate math.  

• GEOGRAPHY_RELATIONSHIPS  
  – "GEO_ID": the ZIP code.  
  – "RELATED_GEO_ID": the containing state’s GEO_ID (“geoId/##”).  
  – "RELATED_LEVEL": make sure it equals ‘State’.  
  – "RELATIONSHIP_TYPE": zip “Overlaps” state.  

• GEOGRAPHY_INDEX  
  – "GEO_ID": the state id (“geoId/##”).  
  – "ISO_3166_2_CODE": will hold strings such as ‘US‑CA’; we’ll trim to the 2‑letter state abbreviation.  

Conditions we will apply  
1. "VARIABLE" = ‘B01003_001E_5YR’ (Total population, 5‑yr estimate).  
2. "DATE" between ‘2014‑12‑31’ and ‘2020‑12‑31’.  
3. Current‑year population ≥ 25 000.  
4. Growth = (popY – popY‑1)/popY‑1.  
5. For each year, rank growth DESC and choose rank = 2.

Ten exploratory‑to‑final Snowflake SQL queries
(Each finishes with `LIMIT 20` for sampling per instructions.)

```sql
-- 1. Description: Show all ACS variables that look like total population (B01003, 5‑yr).
SELECT 
  "VARIABLE",
  "VARIABLE_NAME"
FROM "GLOBAL_GOVERNMENT"."CYBERSYN"."AMERICAN_COMMUNITY_SURVEY_ATTRIBUTES"
WHERE "VARIABLE" ILIKE 'B01003%'
  AND "VARIABLE" ILIKE '%5YR%'
LIMIT 20;
```

```sql
-- 2. Description: Peek at 2015 population values for a few ZIP codes.
SELECT 
  "GEO_ID",
  "VALUE"
FROM "GLOBAL_GOVERNMENT"."CYBERSYN"."AMERICAN_COMMUNITY_SURVEY_TIMESERIES"
WHERE "VARIABLE" = 'B01003_001E_5YR'
  AND "DATE" = '2015-12-31'
LIMIT 20;
```

```sql
-- 3. Description: Compare 2014 vs 2015 population for one random ZIP to see growth.
SELECT 
  "GEO_ID",
  "DATE",
  "VALUE"
FROM "GLOBAL_GOVERNMENT"."CYBERSYN"."AMERICAN_COMMUNITY_SURVEY_TIMESERIES"
WHERE "VARIABLE" = 'B01003_001E_5YR'
  AND "GEO_ID" = 'zip/30349'              -- example ZIP, adjust as needed
  AND "DATE" IN ('2014-12-31','2015-12-31')
ORDER BY "DATE"
LIMIT 20;
```

```sql
-- 4. Description: Compute 2015 growth rate for every ZIP that has 2014 & 2015 data.
WITH pop AS (
  SELECT
    "GEO_ID",
    "DATE",
    "VALUE"::FLOAT AS "POP"
  FROM "GLOBAL_GOVERNMENT"."CYBERSYN"."AMERICAN_COMMUNITY_SURVEY_TIMESERIES"
  WHERE "VARIABLE" = 'B01003_001E_5YR'
    AND "DATE" BETWEEN '2014-12-31' AND '2015-12-31'
)
SELECT
  "GEO_ID",
  MAX(CASE WHEN "DATE" = '2015-12-31' THEN "POP" END) AS "POP_2015",
  MAX(CASE WHEN "DATE" = '2014-12-31' THEN "POP" END) AS "POP_2014",
  (MAX(CASE WHEN "DATE" = '2015-12-31' THEN "POP" END) -
   MAX(CASE WHEN "DATE" = '2014-12-31' THEN "POP" END)) /
   NULLIF(MAX(CASE WHEN "DATE" = '2014-12-31' THEN "POP" END),0) * 100 AS "GROWTH_PCT"
FROM pop
GROUP BY "GEO_ID"
LIMIT 20;
```

```sql
-- 5. Description: Pull yearly population (2014‑2020) for all ZIPs into one set.
SELECT
  "GEO_ID",
  "DATE",
  "VALUE"::FLOAT AS "POP"
FROM "GLOBAL_GOVERNMENT"."CYBERSYN"."AMERICAN_COMMUNITY_SURVEY_TIMESERIES"
WHERE "VARIABLE" = 'B01003_001E_5YR'
  AND "DATE" BETWEEN '2014-12-31' AND '2020-12-31'
LIMIT 20;
```

```sql
-- 6. Description: Add lag to compute annual growth for 2015‑2020 and flag big ZIPs (≥25k).
WITH z AS (
  SELECT
    "GEO_ID",
    "DATE",
    "VALUE"::FLOAT AS "POP",
    LAG("VALUE"::FLOAT) OVER (PARTITION BY "GEO_ID" ORDER BY "DATE") AS "POP_PREV"
  FROM "GLOBAL_GOVERNMENT"."CYBERSYN"."AMERICAN_COMMUNITY_SURVEY_TIMESERIES"
  WHERE "VARIABLE" = 'B01003_001E_5YR'
    AND "DATE" BETWEEN '2014-12-31' AND '2020-12-31'
)
SELECT
  "GEO_ID",
  "DATE",
  "POP",
  "POP_PREV",
  ("POP" - "POP_PREV") / NULLIF("POP_PREV",0) * 100 AS "GROWTH_PCT"
FROM z
WHERE "DATE" >= '2015-12-31'
  AND "POP" >= 25000
LIMIT 20;
```

```sql
-- 7. Description: Attach state GEO_ID to each ZIP via geography relationships.
SELECT
  r."GEO_ID"            AS "ZIP_GEO_ID",
  r."RELATED_GEO_ID"    AS "STATE_GEO_ID",
  r."RELATED_LEVEL",
  r."RELATIONSHIP_TYPE"
FROM "GLOBAL_GOVERNMENT"."CYBERSYN"."GEOGRAPHY_RELATIONSHIPS" r
WHERE r."LEVEL" = 'CensusZipCodeTabulationArea'
  AND r."RELATED_LEVEL" = 'State'
  AND r."RELATIONSHIP_TYPE" = 'Overlaps'
LIMIT 20;
```

```sql
-- 8. Description: Join previous growth calc to state id (no state name yet).
WITH growth AS (
  SELECT
    "GEO_ID",
    "DATE",
    ("VALUE"::FLOAT -
     LAG("VALUE"::FLOAT) OVER (PARTITION BY "GEO_ID" ORDER BY "DATE"))
     / NULLIF(LAG("VALUE"::FLOAT) OVER (PARTITION BY "GEO_ID" ORDER BY "DATE"),0)
     * 100 AS "GROWTH_PCT",
    "VALUE"::FLOAT AS "POP"
  FROM "GLOBAL_GOVERNMENT"."CYBERSYN"."AMERICAN_COMMUNITY_SURVEY_TIMESERIES"
  WHERE "VARIABLE" = 'B01003_001E_5YR'
    AND "DATE" BETWEEN '2014-12-31' AND '2020-12-31'
)
SELECT 
  g."GEO_ID"  AS "ZIP_GEO_ID",
  r."RELATED_GEO_ID" AS "STATE_GEO_ID",
  g."DATE",
  g."POP",
  g."GROWTH_PCT"
FROM growth g
JOIN "GLOBAL_GOVERNMENT"."CYBERSYN"."GEOGRAPHY_RELATIONSHIPS" r
  ON g."GEO_ID" = r."GEO_ID"
WHERE r."RELATED_LEVEL" = 'State'
  AND r."RELATIONSHIP_TYPE" = 'Overlaps'
  AND g."DATE" >= '2015-12-31'
  AND g."POP" >= 25000
LIMIT 20;
```

```sql
-- 9. Description: Bring in state abbreviation (use ISO_3166_2_CODE, strip 'US-').
WITH state_xwalk AS (
  SELECT 
    "GEO_ID",
    SPLIT_PART("ISO_3166_2_CODE",'‑',2) AS "STATE_ABBR"
  FROM "GLOBAL_GOVERNMENT"."CYBERSYN"."GEOGRAPHY_INDEX"
  WHERE "LEVEL" = 'State'
),
growth AS (
  SELECT
    g."GEO_ID",
    r."RELATED_GEO_ID" AS "STATE_GEO_ID",
    g."DATE",
    g."VALUE"::FLOAT AS "POP",
    (g."VALUE"::FLOAT - LAG(g."VALUE"::FLOAT) OVER (PARTITION BY g."GEO_ID" ORDER BY g."DATE"))
      / NULLIF(LAG(g."VALUE"::FLOAT) OVER (PARTITION BY g."GEO_ID" ORDER BY g."DATE"),0) * 100
      AS "GROWTH_PCT"
  FROM "GLOBAL_GOVERNMENT"."CYBERSYN"."AMERICAN_COMMUNITY_SURVEY_TIMESERIES" g
  JOIN "GLOBAL_GOVERNMENT"."CYBERSYN"."GEOGRAPHY_RELATIONSHIPS" r
       ON g."GEO_ID" = r."GEO_ID"
       AND r."RELATED_LEVEL" = 'State'
       AND r."RELATIONSHIP_TYPE" = 'Overlaps'
  WHERE g."VARIABLE" = 'B01003_001E_5YR'
    AND g."DATE" BETWEEN '2014-12-31' AND '2020-12-31'
)
SELECT 
  gr."GEO_ID" AS "ZIP_GEO_ID",
  sx."STATE_ABBR",
  gr."DATE",
  gr."POP",
  gr."GROWTH_PCT"
FROM growth gr
JOIN state_xwalk sx
  ON gr."STATE_GEO_ID" = sx."GEO_ID"
WHERE gr."DATE" >= '2015-12-31'
  AND gr."POP" >= 25000
LIMIT 20;
```

```sql
-- 10. Description: Final answer – 2nd‑highest growth ZIP each year 2015‑2020 (≥25k pop).
WITH state_xwalk AS (
  SELECT 
    "GEO_ID",
    SPLIT_PART("ISO_3166_2_CODE",'‑',2) AS "STATE_ABBR"
  FROM "GLOBAL_GOVERNMENT"."CYBERSYN"."GEOGRAPHY_INDEX"
  WHERE "LEVEL" = 'State'
),
growth AS (
  SELECT
    g."GEO_ID"                                AS "ZIP_GEO_ID",
    r."RELATED_GEO_ID"                        AS "STATE_GEO_ID",
    g."DATE",
    g."VALUE"::FLOAT                          AS "POP",
    (g."VALUE"::FLOAT -
     LAG(g."VALUE"::FLOAT) OVER (PARTITION BY g."GEO_ID" ORDER BY g."DATE"))
     / NULLIF(LAG(g."VALUE"::FLOAT) OVER (PARTITION BY g."GEO_ID" ORDER BY g."DATE"),0)
     * 100                                    AS "GROWTH_PCT"
  FROM "GLOBAL_GOVERNMENT"."CYBERSYN"."AMERICAN_COMMUNITY_SURVEY_TIMESERIES" g
  JOIN "GLOBAL_GOVERNMENT"."CYBERSYN"."GEOGRAPHY_RELATIONSHIPS" r
       ON g."GEO_ID" = r."GEO_ID"
       AND r."RELATED_LEVEL" = 'State'
       AND r."RELATIONSHIP_TYPE" = 'Overlaps'
  WHERE g."VARIABLE" = 'B01003_001E_5YR'
    AND g."DATE" BETWEEN '2014-12-31' AND '2020-12-31'
)
SELECT
  TO_CHAR("DATE",'YYYY')                 AS "YEAR",
  "ZIP_GEO_ID"                           AS "ZIP_CODE",
  sx."STATE_ABBR",
  ROUND("GROWTH_PCT",2)                  AS "ANNUAL_GROWTH_PCT"
FROM (
  SELECT
    gr.*,
    ROW_NUMBER() OVER (PARTITION BY gr."DATE"
                       ORDER BY gr."GROWTH_PCT" DESC) AS "RN"
  FROM growth gr
  WHERE gr."DATE" >= '2015-12-31'
    AND gr."POP" >= 25000
) gr
JOIN state_xwalk sx
  ON gr."STATE_GEO_ID" = sx."GEO_ID"
WHERE gr."RN" = 2
ORDER BY "YEAR"
LIMIT 20;
```

