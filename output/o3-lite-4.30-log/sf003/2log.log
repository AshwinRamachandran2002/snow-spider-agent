-- 10. Description: Final answer – 2nd‑highest growth ZIP each year 2015‑2020 (≥25k pop).
WITH state_xwalk AS (
  SELECT 
    "GEO_ID",
    SPLIT_PART("ISO_3166_2_CODE",'‑',2) AS "STATE_ABBR"
  FROM "GLOBAL_GOVERNMENT"."CYBERSYN"."GEOGRAPHY_INDEX"
  WHERE "LEVEL" = 'State'
),
growth AS (
  SELECT
    g."GEO_ID"                                AS "ZIP_GEO_ID",
    r."RELATED_GEO_ID"                        AS "STATE_GEO_ID",
    g."DATE",
    g."VALUE"::FLOAT                          AS "POP",
    (g."VALUE"::FLOAT -
     LAG(g."VALUE"::FLOAT) OVER (PARTITION BY g."GEO_ID" ORDER BY g."DATE"))
     / NULLIF(LAG(g."VALUE"::FLOAT) OVER (PARTITION BY g."GEO_ID" ORDER BY g."DATE"),0)
     * 100                                    AS "GROWTH_PCT"
  FROM "GLOBAL_GOVERNMENT"."CYBERSYN"."AMERICAN_COMMUNITY_SURVEY_TIMESERIES" g
  JOIN "GLOBAL_GOVERNMENT"."CYBERSYN"."GEOGRAPHY_RELATIONSHIPS" r
       ON g."GEO_ID" = r."GEO_ID"
       AND r."RELATED_LEVEL" = 'State'
       AND r."RELATIONSHIP_TYPE" = 'Overlaps'
  WHERE g."VARIABLE" = 'B01003_001E_5YR'
    AND g."DATE" BETWEEN '2014-12-31' AND '2020-12-31'
)
SELECT
  TO_CHAR("DATE",'YYYY')                 AS "YEAR",
  "ZIP_GEO_ID"                           AS "ZIP_CODE",
  sx."STATE_ABBR",
  ROUND("GROWTH_PCT",2)                  AS "ANNUAL_GROWTH_PCT"
FROM (
  SELECT
    gr.*,
    ROW_NUMBER() OVER (PARTITION BY gr."DATE"
                       ORDER BY gr."GROWTH_PCT" DESC) AS "RN"
  FROM growth gr
  WHERE gr."DATE" >= '2015-12-31'
    AND gr."POP" >= 25000
) gr
JOIN state_xwalk sx
  ON gr."STATE_GEO_ID" = sx."GEO_ID"
WHERE gr."RN" = 2
ORDER BY "YEAR"
LIMIT 20;
