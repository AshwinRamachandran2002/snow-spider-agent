Begin Exploring Related Columns
Relevant columns and their potential usage  
• `id`: identify the weather‑station (`USW00094846`).  
• `date`: restrict the rows to the last 15 days of every year (`12‑17` … `12‑31`).  
• `element`: recognise the physical variable (`PRCP`, `TMIN`, `TMAX`).  
• `value`: numeric measurement that will be aggregated (recorded in tenths).  
• `qflag`: rows with a quality problem – keep only `qflag IS NULL`.  
• `mflag`, `sflag`, `time`: not needed for the final numbers but can be inspected.  

Typical conditions that will be reused  
```
WHERE id = 'USW00094846'
  AND element IN ('PRCP','TMIN','TMAX')
  AND FORMAT_DATE('%m-%d', date) BETWEEN '12-17' AND '12-31'
  AND value IS NOT NULL
  AND qflag IS NULL
```

Ten exploratory → final queries
```sql
-- 1) Distinct elements available for the station in 2015
SELECT DISTINCT element
FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
WHERE id = 'USW00094846'
LIMIT 20;
```

```sql
-- 2) Raw records for the last 15 days of 2015
SELECT date, element, value, qflag
FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
WHERE id = 'USW00094846'
  AND FORMAT_DATE('%m-%d', date) BETWEEN '12-17' AND '12-31'
LIMIT 20;
```

```sql
-- 3) Same as #2 but keep only validated rows
SELECT date, element, value
FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
WHERE id       = 'USW00094846'
  AND qflag IS NULL
  AND FORMAT_DATE('%m-%d', date) BETWEEN '12-17' AND '12-31'
LIMIT 20;
```

```sql
-- 4) Convert precipitation to millimetres for 2015 (last 15 days)
SELECT date,
       value / 10.0 AS prcp_mm        -- PRCP is stored in tenths of mm
FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
WHERE id = 'USW00094846'
  AND element = 'PRCP'
  AND qflag   IS NULL
  AND FORMAT_DATE('%m-%d', date) BETWEEN '12-17' AND '12-31'
LIMIT 20;
```

```sql
-- 5) Convert minimum temperature to °C for a glimpse at 2014
SELECT date,
       value / 10.0 AS tmin_c
FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
WHERE id = 'USW00094846'
  AND element = 'TMIN'
  AND qflag   IS NULL
  AND FORMAT_DATE('%m-%d', date) BETWEEN '12-17' AND '12-31'
LIMIT 20;
```

```sql
-- 6) Show the single wettest day in the period 17‑31 Dec 2015
SELECT MAX(value) / 10.0 AS max_prcp_mm
FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
WHERE id      = 'USW00094846'
  AND element = 'PRCP'
  AND qflag  IS NULL
  AND FORMAT_DATE('%m-%d', date) BETWEEN '12-17' AND '12-31';
```

```sql
-- 7) Show the coldest reading in the same period for 2015
SELECT MIN(value) / 10.0 AS min_tmin_c
FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
WHERE id      = 'USW00094846'
  AND element = 'TMIN'
  AND qflag  IS NULL
  AND FORMAT_DATE('%m-%d', date) BETWEEN '12-17' AND '12-31';
```

```sql
-- 8) Per‑year extremes of PRCP in 2013‑2016 (preview)
SELECT EXTRACT(YEAR FROM date) AS yr,
       MAX(value) / 10.0       AS prcp_mm_max
FROM  `bigquery-public-data.ghcn_d.ghcnd_2013`
WHERE id='USW00094846' AND element='PRCP' AND qflag IS NULL
  AND FORMAT_DATE('%m-%d',date) BETWEEN '12-17' AND '12-31'
GROUP BY yr
UNION ALL
SELECT EXTRACT(YEAR FROM date), MAX(value)/10.0
FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
WHERE id='USW00094846' AND element='PRCP' AND qflag IS NULL
  AND FORMAT_DATE('%m-%d',date) BETWEEN '12-17' AND '12-31'
GROUP BY 1
LIMIT 20;
```

```sql
-- 9) Build one sub‑query gathering PRCP/TMIN/TMAX for 2016 only
SELECT
  element,
  MAX(IF(element='PRCP', value/10.0, NULL)) AS prcp_mm,
  MIN(IF(element='TMIN', value/10.0, NULL)) AS tmin_c,
  MAX(IF(element='TMAX', value/10.0, NULL)) AS tmax_c
FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
WHERE id='USW00094846'
  AND element IN ('PRCP','TMIN','TMAX')
  AND qflag IS NULL
  AND FORMAT_DATE('%m-%d', date) BETWEEN '12-17' AND '12-31'
GROUP BY element
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: extremes for the last 15 days of each year 2013‑2016
WITH unioned AS (
  SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  UNION ALL
  SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  UNION ALL
  SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  UNION ALL
  SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
)
SELECT
  EXTRACT(YEAR FROM date)                          AS year,
  MAX(CASE WHEN element='PRCP' THEN value END)/10  AS highest_prcp_mm,
  MIN(CASE WHEN element='TMIN' THEN value END)/10  AS minimum_tmin_c,
  MAX(CASE WHEN element='TMAX' THEN value END)/10  AS maximum_tmax_c
FROM unioned
WHERE id = 'USW00094846'
  AND element IN ('PRCP','TMIN','TMAX')
  AND qflag  IS NULL
  AND FORMAT_DATE('%m-%d', date) BETWEEN '12-17' AND '12-31'
GROUP BY year
ORDER BY year;
```

