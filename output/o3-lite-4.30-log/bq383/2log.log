```sql
-- Thinking process:
-- 1) Each year from 2013‑2016 lives in its own table.  We must combine them, so we use UNION ALL.
--    To avoid the “mismatched column count” error every SELECT in the UNION must expose the same
--    number and order of columns, therefore we explicitly project only the five columns relevant
--    to this task: id, date, element, value, qflag.
-- 2) After stacking the data we filter for:
--      • the target station  id = 'USW00094846'
--      • the three elements that matter: PRCP (precipitation), TMIN (minimum temp), TMAX (maximum temp)
--      • validated rows   → qflag IS NULL and value IS NOT NULL
--      • dates between 17 Dec and 31 Dec (the last 15 days of the year)
-- 3) We then aggregate by calendar year:
--      • highest PRCP (MAX)   converted from tenths‑millimetres to mm  (divide by 10.0)
--      • lowest  TMIN (MIN)   converted from tenths‑°C to °C           (divide by 10.0)
--      • highest TMAX (MAX)   converted from tenths‑°C to °C           (divide by 10.0)
-- 4) The final result is ordered chronologically.
WITH unioned AS (
  SELECT id, date, element, value, qflag
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  UNION ALL
  SELECT id, date, element, value, qflag
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  UNION ALL
  SELECT id, date, element, value, qflag
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  UNION ALL
  SELECT id, date, element, value, qflag
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
)
SELECT
  EXTRACT(YEAR FROM date)                             AS year,
  MAX(CASE WHEN element = 'PRCP' THEN value END)/10.0 AS highest_prcp_mm,
  MIN(CASE WHEN element = 'TMIN' THEN value END)/10.0 AS minimum_tmin_c,
  MAX(CASE WHEN element = 'TMAX' THEN value END)/10.0 AS maximum_tmax_c
FROM unioned
WHERE id = 'USW00094846'
  AND element IN ('PRCP','TMIN','TMAX')
  AND qflag IS NULL
  AND value IS NOT NULL
  AND FORMAT_DATE('%m-%d', date) BETWEEN '12-17' AND '12-31'
GROUP BY year
ORDER BY year;
