Begin Exploring Related Columns
Relevant tables / columns and why they matter  
• `id` : to keep only the station we need (`USW00094846`).  
• `date` : to restrict each query to the last 15 days of the year (‑12‑17 → ‑12‑31).  
• `element` : lets us separate precipitation (`PRCP`), daily minimum temperature (`TMIN`), and daily maximum temperature (`TMAX`).  
• `value` : the actual measured amount (tenths of mm for `PRCP`, tenths of °C for temps) – will be divided by 10 for the requested units.  
• `qflag` : quality flag – we keep rows only when `qflag IS NULL` (validated observations).  
(Columns `mflag`, `sflag`, `time` are not needed for this task.)

Typical conditions that will be re‑used  
```
id                = 'USW00094846'
element           IN ('PRCP','TMIN','TMAX')
date BETWEEN 'YYYY-12-17' AND 'YYYY-12-31'
qflag             IS NULL
value             IS NOT NULL
```

Below are ten exploratory‑to‑final BigQuery SQL queries (each limited to 20 rows where possible) that lead to the required answer.

```sql
-- 1) Quick peek at the 2015 table for the station
SELECT *
FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
WHERE id = 'USW00094846'
LIMIT 20;
```

```sql
-- 2) What measurement types (elements) exist for this station in 2015?
SELECT DISTINCT element
FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
WHERE id = 'USW00094846'
ORDER BY element
LIMIT 20;
```

```sql
-- 3) Valid rows from the last 15 days of 2015
SELECT id, date, element, value, qflag
FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
WHERE id = 'USW00094846'
  AND date BETWEEN '2015-12-17' AND '2015-12-31'
  AND qflag IS NULL
LIMIT 20;
```

```sql
-- 4) Highest raw precipitation (tenths of mm) in the target period, 2015
SELECT MAX(value) AS max_prcp_tenths
FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
WHERE id = 'USW00094846'
  AND element = 'PRCP'
  AND date BETWEEN '2015-12-17' AND '2015-12-31'
  AND qflag IS NULL;
```

```sql
-- 5) Lowest daily‑minimum temperature (tenths of °C) in the target period, 2015
SELECT MIN(value) AS min_tmin_tenths
FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
WHERE id = 'USW00094846'
  AND element = 'TMIN'
  AND date BETWEEN '2015-12-17' AND '2015-12-31'
  AND qflag IS NULL;
```

```sql
-- 6) 2015 summary with unit conversion (mm, °C)
SELECT
  '2015' AS year,
  MAX(CASE WHEN element = 'PRCP' THEN value END)/10 AS highest_precip_mm,
  MIN(CASE WHEN element = 'TMIN' THEN value END)/10 AS lowest_tmin_c,
  MAX(CASE WHEN element = 'TMAX' THEN value END)/10 AS highest_tmax_c
FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
WHERE id = 'USW00094846'
  AND element IN ('PRCP','TMIN','TMAX')
  AND date BETWEEN '2015-12-17' AND '2015-12-31'
  AND qflag IS NULL;
```

```sql
-- 7) Same kind of summary, 2013 example
SELECT
  '2013' AS year,
  MAX(CASE WHEN element = 'PRCP' THEN value END)/10 AS highest_precip_mm,
  MIN(CASE WHEN element = 'TMIN' THEN value END)/10 AS lowest_tmin_c,
  MAX(CASE WHEN element = 'TMAX' THEN value END)/10 AS highest_tmax_c
FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
WHERE id = 'USW00094846'
  AND element IN ('PRCP','TMIN','TMAX')
  AND date BETWEEN '2013-12-17' AND '2013-12-31'
  AND qflag IS NULL;
```

```sql
-- 8) Four one‑shot UNIONs (2013‑2016) – quick check
SELECT * FROM (
  SELECT 2013 AS year,
         MAX(CASE WHEN element='PRCP' THEN value END)/10 AS highest_precip_mm,
         MIN(CASE WHEN element='TMIN' THEN value END)/10 AS lowest_tmin_c,
         MAX(CASE WHEN element='TMAX' THEN value END)/10 AS highest_tmax_c
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id='USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2013-12-17' AND '2013-12-31'
    AND qflag IS NULL
  UNION ALL
  SELECT 2014 AS year,
         MAX(CASE WHEN element='PRCP' THEN value END)/10,
         MIN(CASE WHEN element='TMIN' THEN value END)/10,
         MAX(CASE WHEN element='TMAX' THEN value END)/10
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id='USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2014-12-17' AND '2014-12-31'
    AND qflag IS NULL
  UNION ALL
  SELECT 2015 AS year,
         MAX(CASE WHEN element='PRCP' THEN value END)/10,
         MIN(CASE WHEN element='TMIN' THEN value END)/10,
         MAX(CASE WHEN element='TMAX' THEN value END)/10
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id='USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2015-12-17' AND '2015-12-31'
    AND qflag IS NULL
  UNION ALL
  SELECT 2016 AS year,
         MAX(CASE WHEN element='PRCP' THEN value END)/10,
         MIN(CASE WHEN element='TMIN' THEN value END)/10,
         MAX(CASE WHEN element='TMAX' THEN value END)/10
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id='USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2016-12-17' AND '2016-12-31'
    AND qflag IS NULL
)
ORDER BY year
LIMIT 20;
```

```sql
-- 9) Bring all clean rows together first, then group (still shows 20)
WITH unioned AS (
  SELECT 2013 AS year, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id='USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2013-12-17' AND '2013-12-31'
    AND qflag IS NULL
  UNION ALL
  SELECT 2014 AS year, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id='USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2014-12-17' AND '2014-12-31'
    AND qflag IS NULL
  UNION ALL
  SELECT 2015 AS year, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id='USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2015-12-17' AND '2015-12-31'
    AND qflag IS NULL
  UNION ALL
  SELECT 2016 AS year, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id='USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2016-12-17' AND '2016-12-31'
    AND qflag IS NULL
)
SELECT
  year,
  MAX(CASE WHEN element='PRCP' THEN value END)/10 AS highest_precip_mm,
  MIN(CASE WHEN element='TMIN' THEN value END)/10 AS lowest_tmin_c,
  MAX(CASE WHEN element='TMAX' THEN value END)/10 AS highest_tmax_c
FROM unioned
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER – peak values for each of the last‑15‑day windows, 2013‑2016
WITH unioned AS (
  SELECT 2013 AS year, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id='USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2013-12-17' AND '2013-12-31'
    AND value IS NOT NULL
    AND qflag IS NULL
  UNION ALL
  SELECT 2014 AS year, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id='USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2014-12-17' AND '2014-12-31'
    AND value IS NOT NULL
    AND qflag IS NULL
  UNION ALL
  SELECT 2015 AS year, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id='USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2015-12-17' AND '2015-12-31'
    AND value IS NOT NULL
    AND qflag IS NULL
  UNION ALL
  SELECT 2016 AS year, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id='USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2016-12-17' AND '2016-12-31'
    AND value IS NOT NULL
    AND qflag IS NULL
)
SELECT
  year,
  MAX(CASE WHEN element='PRCP' THEN value END)/10 AS highest_precip_mm,
  MIN(CASE WHEN element='TMIN' THEN value END)/10 AS minimum_temperature_c,
  MAX(CASE WHEN element='TMAX' THEN value END)/10 AS maximum_temperature_c
FROM unioned
GROUP BY year
ORDER BY year;
```

