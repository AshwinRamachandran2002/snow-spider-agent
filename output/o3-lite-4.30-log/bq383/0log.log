```sql
-- 10. Description: FINAL ANSWER – Highest precipitation (mm), highest TMAX (°C),
--                  and lowest TMIN (°C) for the last 15 days of each year 2013‑2016.
WITH last_15 AS (
  SELECT
    CAST(_TABLE_SUFFIX AS INT64) AS year,
    element,
    value
  FROM `bigquery-public-data.ghcn_d.ghcnd_*`
  WHERE _TABLE_SUFFIX BETWEEN '2013' AND '2016'
    AND id = 'USW00094846'
    AND qflag IS NULL               -- keep only validated values
    AND element IN ('PRCP','TMAX','TMIN')
    AND EXTRACT(MONTH FROM date)=12
    AND EXTRACT(DAY FROM date) >= 17
)
SELECT
  year,
  MAX(CASE WHEN element='PRCP' THEN value END)/10  AS max_prcp_mm,   -- tenths‑mm → mm
  MAX(CASE WHEN element='TMAX' THEN value END)/10 AS max_tmax_c,    -- tenths‑°C → °C
  MIN(CASE WHEN element='TMIN' THEN value END)/10 AS min_tmin_c     -- tenths‑°C → °C
FROM last_15
GROUP BY year
ORDER BY year;
```
