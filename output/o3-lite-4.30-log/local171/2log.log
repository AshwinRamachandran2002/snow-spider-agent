['aliens_details', 'skills_dim', 'legislators_terms', 'cities_currencies', 'legislators', 'skills_job_dim', 'job_postings_fact', 'alien_data', 'cities_countries', 'legislation_date_dim', 'cities', 'aliens_location', 'aliens', 'cities_languages', 'job_company']
Begin Exploring Related Columns
Relevant columns and their potential usage  
• legislators.id_bioguide : unique key that lets us join the biographical table to the individual terms table.  
• legislators.gender : allows us to keep only “M” (male) records.  
• legislators_terms.id_bioguide : foreign key that joins the terms to the person.  
• legislators_terms.state : filter to Louisiana (“LA”).  
• legislators_terms.term_start / legislators_terms.term_end : tell us for what calendar span a person was in‑office; we will use them to test if a legislator was still serving on a specific “Dec‑31” date.  
• legislators_terms.term_number : helps find the first term for a legislator (term_number = 0 is the earliest).  

Typical conditions we will need  
1. legislators.gender = 'M'  
2. legislators_terms.state = 'LA'  
3. date('YEAR‑12‑31') BETWEEN term_start AND COALESCE(term_end, '9999‑12‑31')  
4. years_elapsed = CAST(strftime('%Y','YEAR‑12‑31') AS INT) − CAST(substr(first_term_start,1,4) AS INT)  
5. 30 < years_elapsed < 50  

Below are ten exploratory queries (LIMIT 20 each) to get comfortable with the data before writing the final production query.

```sql
-- 1. States that appear in legislators_terms (quick sanity check)
SELECT DISTINCT state
FROM legislators_terms
LIMIT 20;
```

```sql
-- 2. Distinct gender codes in the legislators table
SELECT DISTINCT gender
FROM legislators
LIMIT 20;
```

```sql
-- 3. List male legislators who have at least one Louisiana term
SELECT DISTINCT l.id_bioguide, l.full_name
FROM legislators AS l
JOIN legislators_terms AS t
  ON l.id_bioguide = t.id_bioguide
WHERE l.gender = 'M'
  AND t.state = 'LA'
LIMIT 20;
```

```sql
-- 4. Show all terms for the male Louisiana legislators we just found
SELECT t.*
FROM legislators_terms AS t
WHERE t.id_bioguide IN (
    SELECT l.id_bioguide
    FROM legislators AS l
    JOIN legislators_terms AS t2
      ON l.id_bioguide = t2.id_bioguide
    WHERE l.gender = 'M'
      AND t2.state = 'LA'
)
ORDER BY t.id_bioguide, t.term_start
LIMIT 20;
```

```sql
-- 5. Fetch the first term_start date for each male Louisiana legislator
SELECT t.id_bioguide,
       MIN(t.term_start) AS first_term_start
FROM legislators_terms AS t
JOIN legislators AS l
  ON l.id_bioguide = t.id_bioguide
WHERE l.gender = 'M'
  AND t.state = 'LA'
GROUP BY t.id_bioguide
LIMIT 20;
```

```sql
-- 6. Pick one example legislator and see in which calendar years (Dec‑31) he was serving
-- (Replace 'B000944' with any id returned above)
SELECT '2010-12-31' AS dec31,
       CASE
         WHEN '2010-12-31' BETWEEN term_start AND COALESCE(term_end, '9999-12-31')
         THEN 1 ELSE 0 END AS in_office
FROM legislators_terms
WHERE id_bioguide = 'B000944'
LIMIT 20;
```

```sql
-- 7. Build a small list of distinct calendar years that intersect any Louisiana term
SELECT DISTINCT CAST(substr(term_start,1,4) AS INT) AS year_start,
       CAST(substr(term_end,1,4) AS INT)   AS year_end
FROM legislators_terms
WHERE state = 'LA'
ORDER BY year_start
LIMIT 20;
```

```sql
-- 8. For each male Louisiana legislator, compute years elapsed from first term to Dec‑31‑1990
SELECT s.id_bioguide,
       s.first_term_start,
       1990 - CAST(substr(s.first_term_start,1,4) AS INT) AS years_elapsed
FROM (
    SELECT t.id_bioguide,
           MIN(t.term_start) AS first_term_start
    FROM legislators_terms AS t
    JOIN legislators AS l
      ON l.id_bioguide = t.id_bioguide
    WHERE l.gender = 'M' AND t.state = 'LA'
    GROUP BY t.id_bioguide
) AS s
LIMIT 20;
```

```sql
-- 9. Count how many of those legislators were still in office on 1990‑12‑31
SELECT COUNT(DISTINCT t.id_bioguide) AS active_on_1990_12_31
FROM legislators_terms AS t
JOIN (
    SELECT l.id_bioguide
    FROM legislators AS l
    JOIN legislators_terms AS t2
      ON l.id_bioguide = t2.id_bioguide
    WHERE l.gender = 'M' AND t2.state = 'LA'
    GROUP BY l.id_bioguide
) AS lu
  ON t.id_bioguide = lu.id_bioguide
WHERE '1990-12-31' BETWEEN t.term_start AND COALESCE(t.term_end, '9999-12-31')
LIMIT 20;
```

```sql
-- 10. (Near‑final) For every year‑end date in which 30<years_elapsed<50,
--      count distinct male Louisiana legislators still serving, grouped by years_elapsed
WITH first_terms AS (
    SELECT t.id_bioguide,
           MIN(t.term_start) AS first_term_start
    FROM legislators_terms AS t
    JOIN legislators AS l
      ON l.id_bioguide = t.id_bioguide
    WHERE l.gender = 'M' AND t.state = 'LA'
    GROUP BY t.id_bioguide
),
calendar_years AS (
    SELECT year
    FROM (
        -- Generate years from 1900 to 2023 based on the legislation_date_dim if available
        SELECT DISTINCT CAST(substr(date,1,4) AS INT) AS year
        FROM legislation_date_dim
    )
    WHERE year BETWEEN 1900 AND 2023
),
active_on_dec31 AS (
    SELECT cy.year,
           ft.id_bioguide,
           (cy.year - CAST(substr(ft.first_term_start,1,4) AS INT)) AS years_elapsed
    FROM calendar_years AS cy
    JOIN first_terms AS ft
    JOIN legislators_terms AS t
      ON ft.id_bioguide = t.id_bioguide
    WHERE date(cy.year || '-12-31') BETWEEN t.term_start AND COALESCE(t.term_end, '9999-12-31')
)
SELECT years_elapsed,
       COUNT(DISTINCT id_bioguide) AS num_legislators
FROM active_on_dec31
WHERE years_elapsed > 30
  AND years_elapsed < 50
GROUP BY years_elapsed
ORDER BY years_elapsed
LIMIT 20;
```

The last query (#10) is the template that directly answers the task:  
“For male legislators from Louisiana, count distinct legislators actively serving on December 31 for each elapsed‑years bucket (31‑49 inclusive) measured since their first term, and group the result by exact years_elapsed.”
