2025-05-01 03:28:23 - Thread-1424 (execute) - INFO - [Exploration]
Relevant tables / columns and how they will be used  

legislators  
• id_bioguide : primary key that lets us join to legislators_terms  
• gender      : filter to only males ('M')  
• full_name   : human readable identifier to count “distinct legislators”  

legislators_terms  
• id_bioguide : foreign key back to legislators → identifies whose term it is  
• term_start  : term starting date – we will need the earliest one per legislator  
• term_end    : term ending date – we will test if they were still in‑office on ‘YYYY‑12‑31’  
• state       : filter to the state of interest, ‘LA’ (Louisiana)  
• term_number : can help verify ordering but not strictly required  

Conditions we will eventually need  

1. legislators.gender = 'M'  
2. legislators_terms.state = 'LA'  
3. For every legislator, compute first_term_year = CAST(substr(min(term_start),1,4) AS INT)  
4. Generate every anniversary year s = first_term_year + n where 30 < n < 50  
5. Keep only those (legislator, s) pairs where the legislator is serving on s‑12‑31, i.e.  
   term_start ≤ s‑12‑31 AND term_end   ≥ s‑12‑31  
6. Group by n (= years elapsed since first term) and count distinct legislators  

────────────────────────────────────────────────────────────  
Exploratory → progressive SQLs (LIMIT 20 for readability)  
────────────────────────────────────────────────────────────  

```sql
-- 1. Quick glance at Louisiana terms
SELECT DISTINCT "state" 
FROM "legislators_terms" 
WHERE "state" = 'LA' 
LIMIT 20;
```

```sql
-- 2. List male legislators from Louisiana (join personal table)
SELECT DISTINCT l."id_bioguide", l."full_name"
FROM "legislators"        AS l
JOIN "legislators_terms"  AS t ON l."id_bioguide" = t."id_bioguide"
WHERE t."state" = 'LA'
  AND l."gender" = 'M'
LIMIT 20;
```

```sql
-- 3. All terms for one sample Louisiana male legislator
SELECT t.*
FROM   "legislators_terms" AS t
WHERE  t."id_bioguide" IN (
       SELECT l."id_bioguide"
       FROM "legislators" l
       WHERE l."gender" = 'M'
       LIMIT 1)          -- pick first just to inspect
ORDER  BY t."term_start"
LIMIT 20;
```

```sql
-- 4. Earliest term_start per Louisiana male legislator
SELECT t."id_bioguide",
       MIN(t."term_start") AS "first_term_start"
FROM   "legislators_terms" t
JOIN   "legislators"       l ON l."id_bioguide" = t."id_bioguide"
WHERE  t."state" = 'LA'
  AND  l."gender" = 'M'
GROUP  BY t."id_bioguide"
LIMIT 20;
```

```sql
-- 5. Show first_term_year and all term ranges for verification
SELECT b."id_bioguide",
       SUBSTR(MIN(b."term_start"),1,4) AS "first_term_year",
       GROUP_CONCAT(b."term_start" || '→' || b."term_end") AS "term_ranges"
FROM   "legislators_terms" b
JOIN   "legislators"       l ON l."id_bioguide" = b."id_bioguide"
WHERE  b."state"='LA'
  AND  l."gender"='M'
GROUP  BY b."id_bioguide"
LIMIT 20;
```

```sql
-- 6. Build every (legislator, anniversary_year) when 30 < n < 50
--    (Using a recursive CTE to generate the n values)
WITH first_terms AS (
  SELECT l."id_bioguide",
         CAST(SUBSTR(MIN(t."term_start"),1,4) AS INT) AS first_year
  FROM   "legislators_terms" t
  JOIN   "legislators"       l ON l."id_bioguide" = t."id_bioguide"
  WHERE  t."state"='LA' AND l."gender"='M'
  GROUP  BY l."id_bioguide"
),
nums(n) AS (
  SELECT 31 UNION ALL SELECT 32 UNION ALL SELECT 33 UNION ALL SELECT 34 UNION ALL
  SELECT 35 UNION ALL SELECT 36 UNION ALL SELECT 37 UNION ALL SELECT 38 UNION ALL
  SELECT 39 UNION ALL SELECT 40 UNION ALL SELECT 41 UNION ALL SELECT 42 UNION ALL
  SELECT 43 UNION ALL SELECT 44 UNION ALL SELECT 45 UNION ALL SELECT 46 UNION ALL
  SELECT 47 UNION ALL SELECT 48 UNION ALL SELECT 49
)
SELECT f."id_bioguide",
       f.first_year,
       n.n               AS "years_elapsed",
       (f.first_year + n.n) AS "anniv_year"
FROM   first_terms  f
JOIN   nums         n
LIMIT 20;
```

```sql
-- 7. Attach the 'December 31' date string for each anniversary
WITH first_terms AS (
  SELECT l."id_bioguide",
         CAST(SUBSTR(MIN(t."term_start"),1,4) AS INT) AS first_year
  FROM   "legislators_terms" t
  JOIN   "legislators"       l ON l."id_bioguide" = t."id_bioguide"
  WHERE  t."state"='LA' AND l."gender"='M'
  GROUP  BY l."id_bioguide"
),
nums(n) AS (
  SELECT 31 UNION ALL SELECT 32 UNION ALL SELECT 33 UNION ALL SELECT 34 UNION ALL
  SELECT 35 UNION ALL SELECT 36 UNION ALL SELECT 37 UNION ALL SELECT 38 UNION ALL
  SELECT 39 UNION ALL SELECT 40 UNION ALL SELECT 41 UNION ALL SELECT 42 UNION ALL
  SELECT 43 UNION ALL SELECT 44 UNION ALL SELECT 45 UNION ALL SELECT 46 UNION ALL
  SELECT 47 UNION ALL SELECT 48 UNION ALL SELECT 49
)
SELECT f."id_bioguide",
       n.n AS years_elapsed,
       (f.first_year + n.n) || '-12-31' AS dec31_date
FROM   first_terms f
JOIN   nums n
LIMIT 20;
```

```sql
-- 8. Check whether each legislator was ACTIVE on that Dec‑31 date
WITH first_terms AS (
  SELECT l."id_bioguide",
         CAST(SUBSTR(MIN(t."term_start"),1,4) AS INT) AS first_year
  FROM   "legislators_terms" t
  JOIN   "legislators"       l ON l."id_bioguide" = t."id_bioguide"
  WHERE  t."state"='LA' AND l."gender"='M'
  GROUP  BY l."id_bioguide"
),
nums(n) AS (
  SELECT 31 UNION ALL SELECT 32 UNION ALL SELECT 33 UNION ALL SELECT 34 UNION ALL
  SELECT 35 UNION ALL SELECT 36 UNION ALL SELECT 37 UNION ALL SELECT 38 UNION ALL
  SELECT 39 UNION ALL SELECT 40 UNION ALL SELECT 41 UNION ALL SELECT 42 UNION ALL
  SELECT 43 UNION ALL SELECT 44 UNION ALL SELECT 45 UNION ALL SELECT 46 UNION ALL
  SELECT 47 UNION ALL SELECT 48 UNION ALL SELECT 49
),
anniv AS (
  SELECT f."id_bioguide",
         n.n              AS years_elapsed,
         (f.first_year + n.n) || '-12-31' AS target_date
  FROM   first_terms f
  JOIN   nums n
)
SELECT a."id_bioguide", a.years_elapsed, a.target_date
FROM   anniv          a
JOIN   "legislators_terms" t
       ON t."id_bioguide" = a."id_bioguide"
      AND t."term_start"  <= a.target_date
      AND t."term_end"    >= a.target_date
LIMIT 20;
```

```sql
-- 9. Distinct legislators active on those dates (no duplicates)
WITH first_terms AS (
  SELECT l."id_bioguide",
         CAST(SUBSTR(MIN(t."term_start"),1,4) AS INT) AS first_year
  FROM   "legislators_terms" t
  JOIN   "legislators"       l ON l."id_bioguide" = t."id_bioguide"
  WHERE  t."state"='LA' AND l."gender"='M'
  GROUP  BY l."id_bioguide"
),
nums(n) AS (
  SELECT 31 UNION ALL SELECT 32 UNION ALL SELECT 33 UNION ALL SELECT 34 UNION ALL
  SELECT 35 UNION ALL SELECT 36 UNION ALL SELECT 37 UNION ALL SELECT 38 UNION ALL
  SELECT 39 UNION ALL SELECT 40 UNION ALL SELECT 41 UNION ALL SELECT 42 UNION ALL
  SELECT 43 UNION ALL SELECT 44 UNION ALL SELECT 45 UNION ALL SELECT 46 UNION ALL
  SELECT 47 UNION ALL SELECT 48 UNION ALL SELECT 49
),
anniv AS (
  SELECT f."id_bioguide",
         n.n              AS years_elapsed,
         (f.first_year + n.n) || '-12-31' AS target_date
  FROM   first_terms f
  JOIN   nums n
)
SELECT DISTINCT a."id_bioguide", a.years_elapsed
FROM   anniv          a
JOIN   "legislators_terms" t
       ON t."id_bioguide" = a."id_bioguide"
      AND t."term_start"  <= a.target_date
      AND t."term_end"    >= a.target_date
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER QUERY:
--     Count distinct male LA legislators active on Dec‑31 exactly
--     (30,50) years after first term, grouped by years_elapsed
WITH first_terms AS (
  SELECT l."id_bioguide",
         CAST(SUBSTR(MIN(t."term_start"),1,4) AS INT) AS first_year
  FROM   "legislators_terms" t
  JOIN   "legislators"       l ON l."id_bioguide" = t."id_bioguide"
  WHERE  t."state"='LA' AND l."gender"='M'
  GROUP  BY l."id_bioguide"
),
nums(n) AS (
  /* Integers 31‑49 inclusive */
  SELECT 31 UNION ALL SELECT 32 UNION ALL SELECT 33 UNION ALL SELECT 34 UNION ALL
  SELECT 35 UNION ALL SELECT 36 UNION ALL SELECT 37 UNION ALL SELECT 38 UNION ALL
  SELECT 39 UNION ALL SELECT 40 UNION ALL SELECT 41 UNION ALL SELECT 42 UNION ALL
  SELECT 43 UNION ALL SELECT 44 UNION ALL SELECT 45 UNION ALL SELECT 46 UNION ALL
  SELECT 47 UNION ALL SELECT 48 UNION ALL SELECT 49
),
anniv AS (
  SELECT f."id_bioguide",
         n.n                          AS years_elapsed,
         (f.first_year + n.n) || '-12-31' AS target_date
  FROM   first_terms f
  JOIN   nums n
)
SELECT a.years_elapsed,
       COUNT(DISTINCT a."id_bioguide") AS "active_legislators"
FROM   anniv a
JOIN   "legislators_terms" t
       ON t."id_bioguide" = a."id_bioguide"
      AND t."term_start"  <= a.target_date
      AND t."term_end"    >= a.target_date
GROUP  BY a.years_elapsed
ORDER  BY a.years_elapsed;
```
