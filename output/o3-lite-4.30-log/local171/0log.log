```sql
--Description: Corrected version of the “#10” query.  Fixes two issues:
--  • In the original calendar CTE the alias “yr” was referenced in the same SELECT
--    that created it; this now uses a WHERE clause on the raw CAST expression.
--  • Ensures all column aliases are referenced unambiguously in later clauses.
--The logic:
--  1. base   : male legislators whose service includes Louisiana, with their first‑year.
--  2. calendar: distinct years pulled from term_start, restricted to 1800‑2100.
--  3. active : cross‑join calendar with base, keep only years 31‑49 after first year
--              and verify the legislator was in office on 31‑Dec‑<year>.
--  4. Final  : group by years_elapsed and count distinct legislators.

WITH base AS (
    SELECT l.id_bioguide,
           MIN(CAST(substr(t.term_start,1,4) AS INTEGER)) AS first_year
    FROM   legislators         AS l
    JOIN   legislators_terms   AS t
           ON l.id_bioguide = t.id_bioguide
    WHERE  l.gender = 'M'
      AND  t.state  = 'LA'
    GROUP  BY l.id_bioguide
),
calendar AS (
    SELECT DISTINCT CAST(substr(term_start,1,4) AS INTEGER) AS yr
    FROM   legislators_terms
    WHERE  CAST(substr(term_start,1,4) AS INTEGER) BETWEEN 1800 AND 2100
),
active AS (
    SELECT  b.id_bioguide,
            c.yr,
            c.yr - b.first_year AS years_elapsed
    FROM    base     AS b
    JOIN    calendar AS c
      ON    (c.yr - b.first_year) > 30
      AND   (c.yr - b.first_year) < 50
    JOIN    legislators_terms AS t
      ON    t.id_bioguide = b.id_bioguide
      AND   t.term_start <= printf('%d-12-31', c.yr)
      AND   (t.term_end IS NULL OR t.term_end > printf('%d-12-31', c.yr))
)
SELECT  years_elapsed,
        COUNT(DISTINCT id_bioguide) AS legislators_active
FROM    active
GROUP   BY years_elapsed
ORDER   BY years_elapsed
LIMIT 20;
```
