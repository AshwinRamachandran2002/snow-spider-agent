--    and requiring term_start ≤ '<year>-12-31'  AND (term_end IS NULL OR term_end
--    > '<year>-12-31').
--4.  Having filtered to the valid (legislator,year) combinations, compute
--    years_elapsed = year – first_year and finally COUNT the DISTINCT legislators
--    for each elapsed‑year bucket.

WITH male_la AS (
    SELECT  l.id_bioguide,
            MIN(CAST(substr(t.term_start,1,4) AS INTEGER)) AS first_year
    FROM    legislators         AS l
    JOIN    legislators_terms   AS t
           ON l.id_bioguide = t.id_bioguide
    WHERE   l.gender = 'M'
      AND   t.state  = 'LA'
    GROUP   BY l.id_bioguide
),
yrs AS (
    SELECT 1789 AS yr                   -- start of the 1st Congress
    UNION ALL
    SELECT yr + 1
    FROM   yrs
    WHERE  yr < 2025                    -- upper bound to keep recursion finite
),
active AS (
    SELECT  ml.id_bioguide,
            y.yr,
            y.yr - ml.first_year AS years_elapsed
    FROM    male_la AS ml
    JOIN    yrs     AS y
      ON    (y.yr - ml.first_year) > 30      -- >30
      AND   (y.yr - ml.first_year) < 50      -- <50
    JOIN    legislators_terms AS t
      ON    t.id_bioguide = ml.id_bioguide
      AND   t.term_start <= printf('%d-12-31', y.yr)
      AND   (t.term_end IS NULL OR t.term_end > printf('%d-12-31', y.yr))
)
SELECT  years_elapsed,
        COUNT(DISTINCT id_bioguide) AS legislators_active
FROM    active
GROUP   BY years_elapsed
ORDER   BY years_elapsed;
