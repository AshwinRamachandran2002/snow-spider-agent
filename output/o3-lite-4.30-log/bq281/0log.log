Relevant table and columns

bigquery-public-data.austin_bikeshare.bikeshare_trips  
• subscriber_type : filter to ‘Student Membership’  
• bike_type : filter to ‘electric’ (or other value showing an e‑bike; inspect distinct values first)  
• duration_minutes : filter to rides > 10 min  
• start_time : used to derive calendar date with DATE(start_time)  
• start_station_name : exclude names containing ‘Mobile Station’ or ‘Repair Shop’  
• end_station_name : same exclusion as above  

Typical filter conditions  
• LOWER(subscriber_type)=‘student membership’  
• LOWER(bike_type)=‘electric’  
• duration_minutes>10  
• NOT (LOWER(start_station_name) LIKE '%mobile station%' OR  
       LOWER(start_station_name) LIKE '%repair shop%' OR  
       LOWER(end_station_name)   LIKE '%mobile station%' OR  
       LOWER(end_station_name)   LIKE '%repair shop%')

Ten progressive exploratory queries

```sql
--1. Description: Look at all distinct subscriber types.
SELECT DISTINCT `subscriber_type`
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
LIMIT 20;
```

```sql
--2. Description: See distinct bike_type values to learn the exact label for e‑bikes.
SELECT DISTINCT `bike_type`
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
LIMIT 20;
```

```sql
--3. Description: Sample 20 electric‑bike trips that lasted more than 10 minutes.
SELECT *
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
WHERE LOWER(`bike_type`) = 'electric'
  AND `duration_minutes` > 10
LIMIT 20;
```

```sql
--4. Description: List station names that contain the words “mobile” or “repair”.
SELECT DISTINCT `start_station_name`
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
WHERE LOWER(`start_station_name`) LIKE '%mobile%'
   OR LOWER(`start_station_name`) LIKE '%repair%'
LIMIT 20;
```

```sql
--5. Description: Count student‑membership electric trips over 10 min per day.
SELECT DATE(`start_time`) AS ride_date,
       COUNT(*) AS trips
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
WHERE LOWER(`subscriber_type`) = 'student membership'
  AND LOWER(`bike_type`) = 'electric'
  AND `duration_minutes` > 10
GROUP BY ride_date
ORDER BY ride_date
LIMIT 20;
```

```sql
--6. Description: Same as #5 but exclude rides that start OR end at the unwanted stations.
SELECT DATE(`start_time`) AS ride_date,
       COUNT(*) AS trips
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
WHERE LOWER(`subscriber_type`) = 'student membership'
  AND LOWER(`bike_type`) = 'electric'
  AND `duration_minutes` > 10
  AND NOT (LOWER(`start_station_name`) LIKE '%mobile station%' OR
           LOWER(`start_station_name`) LIKE '%repair shop%'  OR
           LOWER(`end_station_name`)   LIKE '%mobile station%' OR
           LOWER(`end_station_name`)   LIKE '%repair shop%')
GROUP BY ride_date
ORDER BY trips DESC
LIMIT 20;
```

```sql
--7. Description: Find the single day(s) with the highest qualifying‑ride total.
WITH daily AS (
  SELECT DATE(`start_time`) AS ride_date,
         COUNT(*) AS trips
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
  WHERE LOWER(`subscriber_type`) = 'student membership'
    AND LOWER(`bike_type`) = 'electric'
    AND `duration_minutes` > 10
    AND NOT (LOWER(`start_station_name`) LIKE '%mobile station%' OR
             LOWER(`start_station_name`) LIKE '%repair shop%'  OR
             LOWER(`end_station_name`)   LIKE '%mobile station%' OR
             LOWER(`end_station_name`)   LIKE '%repair shop%')
  GROUP BY ride_date)
SELECT *
FROM daily
ORDER BY trips DESC
LIMIT 20;
```

```sql
--8. Description: Return only the maximum ride count observed on any day.
WITH daily AS (
  SELECT DATE(`start_time`) AS ride_date,
         COUNT(*) AS trips
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
  WHERE LOWER(`subscriber_type`) = 'student membership'
    AND LOWER(`bike_type`) = 'electric'
    AND `duration_minutes` > 10
    AND NOT (LOWER(`start_station_name`) LIKE '%mobile station%' OR
             LOWER(`start_station_name`) LIKE '%repair shop%'  OR
             LOWER(`end_station_name`)   LIKE '%mobile station%' OR
             LOWER(`end_station_name`)   LIKE '%repair shop%')
  GROUP BY ride_date)
SELECT MAX(trips) AS highest_daily_total
FROM daily;
```

```sql
--9. Description: Show the date(s) tied for the highest daily total together with that total.
WITH daily AS (
  SELECT DATE(`start_time`) AS ride_date,
         COUNT(*) AS trips
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
  WHERE LOWER(`subscriber_type`) = 'student membership'
    AND LOWER(`bike_type`) = 'electric'
    AND `duration_minutes` > 10
    AND NOT (LOWER(`start_station_name`) LIKE '%mobile station%' OR
             LOWER(`start_station_name`) LIKE '%repair shop%'  OR
             LOWER(`end_station_name`)   LIKE '%mobile station%' OR
             LOWER(`end_station_name`)   LIKE '%repair shop%')
  GROUP BY ride_date),
max_val AS (SELECT MAX(trips) AS max_trips FROM daily)
SELECT d.ride_date, d.trips
FROM daily d
JOIN max_val m
ON d.trips = m.max_trips;
```

```sql
--10. Description: Produce the final answer directly (returns one row, one column).
SELECT MAX(daily_count) AS highest_number_of_qualifying_rides_in_a_single_day
FROM (
  SELECT DATE(`start_time`) AS ride_date,
         COUNT(*) AS daily_count
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
  WHERE LOWER(`subscriber_type`) = 'student membership'
    AND LOWER(`bike_type`) = 'electric'
    AND `duration_minutes` > 10
    AND NOT (LOWER(`start_station_name`) LIKE '%mobile station%' OR
             LOWER(`start_station_name`) LIKE '%repair shop%'  OR
             LOWER(`end_station_name`)   LIKE '%mobile station%' OR
             LOWER(`end_station_name`)   LIKE '%repair shop%')
  GROUP BY ride_date
);
```

