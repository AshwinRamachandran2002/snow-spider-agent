Relevant table and columns   
(bigquery-public-data.chicago_taxi_trips.taxi_trips)

• trip_seconds  : will be converted to minutes to measure trip‑duration.  
• fare          : used to calculate the average fare in every duration group.  
• unique_key    : useful for counting trips (one row = one trip).  

Typical conditions that will be applied  

• trip_seconds BETWEEN 1 AND 3600        -- keep only trips that last 0–60 min  
• trip_seconds IS NOT NULL AND fare IS NOT NULL   -- discard incomplete rows  


Below are ten exploratory → analytical BigQuery SQL statements (each limited to 20 rows except the final answer) that gradually build understanding and end with the requested result.

```sql
-- 1) Show raw trip_seconds and fare for quick inspection
SELECT trip_seconds, fare
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds BETWEEN 1 AND 3600
LIMIT 20;
```

```sql
-- 2) Look at the same information but already expressed in minutes
SELECT trip_seconds, ROUND(trip_seconds/60.0,1) AS trip_minutes, fare
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds BETWEEN 1 AND 3600
LIMIT 20;
```

```sql
-- 3) Distinct payment types to understand possible segmentation fields
SELECT DISTINCT payment_type
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT 20;
```

```sql
-- 4) Count how many trips fall in each whole‑minute bucket (0–60)
SELECT ROUND(trip_seconds/60.0) AS trip_minute_rounded,
       COUNT(*) AS trips
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds BETWEEN 1 AND 3600
GROUP BY trip_minute_rounded
ORDER BY trip_minute_rounded
LIMIT 20;
```

```sql
-- 5) Average fare by rounded minute bucket
SELECT ROUND(trip_seconds/60.0) AS trip_minute_rounded,
       COUNT(*)                         AS trips,
       AVG(fare)                       AS avg_fare
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds BETWEEN 1 AND 3600
GROUP BY trip_minute_rounded
ORDER BY trip_minute_rounded
LIMIT 20;
```

```sql
-- 6) Explore the distribution of trip_seconds with percentiles
SELECT
  APPROX_QUANTILES(trip_seconds, 10) AS decile_bounds
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds BETWEEN 1 AND 3600
LIMIT 20;
```

```sql
-- 7) Retrieve a sample of trips lying roughly in the median duration
SELECT unique_key, trip_seconds, fare
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds BETWEEN 900 AND 1800   -- 15‑30 minutes
LIMIT 20;
```

```sql
-- 8) Show min / max / avg fare for several coarse duration brackets
SELECT
  CASE
    WHEN trip_seconds <= 600  THEN '≤10 min'
    WHEN trip_seconds <= 1200 THEN '10–20 min'
    WHEN trip_seconds <= 1800 THEN '20–30 min'
    WHEN trip_seconds <= 2400 THEN '30–40 min'
    WHEN trip_seconds <= 3000 THEN '40–50 min'
    ELSE                          '50–60 min'
  END AS duration_band,
  COUNT(*)             AS trips,
  MIN(trip_seconds)    AS min_sec,
  MAX(trip_seconds)    AS max_sec,
  AVG(fare)            AS avg_fare
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds BETWEEN 1 AND 3600
GROUP BY duration_band
ORDER BY duration_band
LIMIT 20;
```

```sql
-- 9) Assign each trip to six equal‑frequency quantiles (NTILE example)
SELECT
  unique_key,
  ROUND(trip_seconds/60.0,2) AS trip_minutes,
  fare,
  NTILE(6) OVER (ORDER BY trip_seconds) AS duration_quantile
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds BETWEEN 1 AND 3600
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER – min & max trip‑duration (rounded minutes), 
--     total trips, and average fare for each of the six equal quantiles
WITH eligible AS (
  SELECT
    unique_key,
    ROUND(trip_seconds/60.0) AS trip_minutes,   -- duration in whole minutes
    fare,
    NTILE(6) OVER (ORDER BY trip_seconds) AS q6 -- six‑quantile bucket
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 1 AND 3600
)
SELECT
  q6                               AS quantile_group,
  MIN(trip_minutes)                AS min_trip_minutes,
  MAX(trip_minutes)                AS max_trip_minutes,
  COUNT(*)                         AS total_trips,
  ROUND(AVG(fare),2)               AS avg_fare
FROM eligible
GROUP BY q6
ORDER BY q6;
```
