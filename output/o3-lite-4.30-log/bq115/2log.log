Query:
-- Description: 10) FINAL – return only the #1 country (highest % under‑25) for 2017.
SELECT country_name,
       ROUND(pct_u25, 2) AS pct_population_under_25_2017
FROM (
  SELECT u.country_name,
         100.0 * u.pop_u25 / t.midyear_population AS pct_u25,
         ROW_NUMBER() OVER (ORDER BY 100.0 * u.pop_u25 / t.midyear_population DESC) AS rn
  FROM (
    SELECT country_code, country_name, SUM(population) AS pop_u25
    FROM `bigquery-public-data.census_bureau_international.midyear_population_agespecific`
    WHERE year = 2017
      AND age < 25
    GROUP BY country_code, country_name
  ) AS u
  JOIN `bigquery-public-data.census_bureau_international.midyear_population` AS t
    ON u.country_code = t.country_code
  WHERE t.year = 2017
)
WHERE rn = 1
LIMIT 20;
