Query:
--Description: 8) Verify that one “*” row in the 5‑year‑age table equals the total‑population table. 
--             We aggregate the rows with total_flag='*' for 2017 (just in case there is more than one), 
--             then join to the plain total‑population table, show the absolute difference, 
--             and order by the largest discrepancies.
SELECT
  c.country_name,
  c.star_table_total,
  t.midyear_population AS plain_total,
  c.star_table_total - t.midyear_population AS diff
FROM (
  SELECT
    country_code,
    ANY_VALUE(country_name) AS country_name,
    SUM(midyear_population) AS star_table_total
  FROM `bigquery-public-data.census_bureau_international.midyear_population_5yr_age_sex`
  WHERE year = 2017
    AND total_flag = '*'
  GROUP BY country_code
) AS c
JOIN `bigquery-public-data.census_bureau_international.midyear_population` AS t
  ON c.country_code = t.country_code
  AND t.year = 2017
ORDER BY ABS(diff) DESC
LIMIT 20
