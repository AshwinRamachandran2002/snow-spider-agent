```sql
--Description: 10) FINAL ANSWER – determine the country whose population had the largest share under age 25 in 2017.
-- Logic:
--   • Sum mid‑year population in all five‑year age buckets starting_age < 25 (0‑24) ⇒ numerator.
--   • Join to total 2017 mid‑year population ⇒ denominator.
--   • Compute percentage, order descending, keep the top result.

SELECT
  p.country_name,
  SUM(g.midyear_population)                          AS population_under_25,
  p.midyear_population                               AS total_population,
  100 * SUM(g.midyear_population) / p.midyear_population AS pct_under_25
FROM `bigquery-public-data.census_bureau_international.midyear_population` AS p
JOIN `bigquery-public-data.census_bureau_international.midyear_population_5yr_age_sex` AS g
  ON p.country_code = g.country_code
  AND p.year        = g.year
WHERE p.year = 2017
  AND g.total_flag = 'A'     -- individual five‑year groups
  AND g.starting_age < 25    -- ages 0‑24
GROUP BY p.country_name, p.midyear_population
ORDER BY pct_under_25 DESC
LIMIT 1;
```
