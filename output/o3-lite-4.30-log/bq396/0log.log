Begin Exploring Related Columns
Relevant columns and how they will be used  

• state_name : state‑level grouping for the final ranking  
• day_of_week (or day_of_week_name) : to keep only weekend crashes (1=Sunday, 7=Saturday)  
• atmospheric_conditions_1_name / atmospheric_conditions_2_name : weather at the moment of the crash.  
  – Conditions we care about: ‘Rain’ (or any string that starts with ‘Rain’ such as ‘Rain (Freezing)’ etc.) vs. ‘Clear’ (often appears as ‘Clear/No Adverse Condition’ or simply ‘Clear’).  
• year_of_crash : make sure we stay in 2016 (table already limited to 2016, but kept for clarity).  

Typical filters / conditions  

1.  year_of_crash = 2016          -- 2016 only  
2.  day_of_week IN (1,7)  or LOWER(day_of_week_name) IN ('sunday','saturday') -- weekend only  
3.  LOWER(atmospheric_conditions_1_name) LIKE 'rain%'  (or do the same on _2_name)  
4.  LOWER(atmospheric_conditions_1_name) IN ('clear','no adverse condition')  (or do the same on _2_name)  

------------------------------------------------------------------------  
Ten step‑by‑step exploration queries (each limited to 20 rows)  
------------------------------------------------------------------------  

```sql
-- 1. Description:  What distinct atmospheric condition labels exist in the first slot?
SELECT DISTINCT atmospheric_conditions_1_name
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
LIMIT 20;
```

```sql
-- 2. Description:  Peek at the day‑of‑week labels used in 2016.
SELECT DISTINCT day_of_week, day_of_week_name
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
LIMIT 20;
```

```sql
-- 3. Description:  Show a few weekend crashes that happened in rain.
SELECT state_name,
       day_of_week_name,
       atmospheric_conditions_1_name,
       atmospheric_conditions_2_name
FROM   `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE  day_of_week IN (1,7)                               -- weekend
  AND  (LOWER(atmospheric_conditions_1_name) LIKE 'rain%'
        OR LOWER(atmospheric_conditions_2_name) LIKE 'rain%')
LIMIT 20;
```

```sql
-- 4. Description:  Show a few weekend crashes that happened in clear weather.
SELECT state_name,
       day_of_week_name,
       atmospheric_conditions_1_name,
       atmospheric_conditions_2_name
FROM   `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE  day_of_week IN (1,7)                               -- weekend
  AND  (LOWER(atmospheric_conditions_1_name) IN ('clear','no adverse condition')
        OR LOWER(atmospheric_conditions_2_name) IN ('clear','no adverse condition'))
LIMIT 20;
```

```sql
-- 5. Description:  Count weekend‑rain crashes per state.
SELECT state_name,
       COUNT(*) AS rain_weekend_crashes
FROM   `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE  day_of_week IN (1,7)
  AND  (LOWER(atmospheric_conditions_1_name) LIKE 'rain%'
        OR LOWER(atmospheric_conditions_2_name) LIKE 'rain%')
GROUP  BY state_name
ORDER  BY rain_weekend_crashes DESC
LIMIT 20;
```

```sql
-- 6. Description:  Count weekend‑clear crashes per state.
SELECT state_name,
       COUNT(*) AS clear_weekend_crashes
FROM   `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE  day_of_week IN (1,7)
  AND  (LOWER(atmospheric_conditions_1_name) IN ('clear','no adverse condition')
        OR LOWER(atmospheric_conditions_2_name) IN ('clear','no adverse condition'))
GROUP  BY state_name
ORDER  BY clear_weekend_crashes DESC
LIMIT 20;
```

```sql
-- 7. Description:  Combine the two previous counts side‑by‑side.
WITH rain AS (
  SELECT state_name,
         COUNT(*) AS rain_weekend_crashes
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE  day_of_week IN (1,7)
    AND  (LOWER(atmospheric_conditions_1_name) LIKE 'rain%'
          OR LOWER(atmospheric_conditions_2_name) LIKE 'rain%')
  GROUP  BY state_name
),
clear AS (
  SELECT state_name,
         COUNT(*) AS clear_weekend_crashes
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE  day_of_week IN (1,7)
    AND  (LOWER(atmospheric_conditions_1_name) IN ('clear','no adverse condition')
          OR LOWER(atmospheric_conditions_2_name) IN ('clear','no adverse condition'))
  GROUP  BY state_name
)
SELECT COALESCE(rain.state_name, clear.state_name) AS state_name,
       rain_weekend_crashes,
       clear_weekend_crashes
FROM   rain
FULL  JOIN clear USING (state_name)
LIMIT 20;
```

```sql
-- 8. Description:  Add the absolute difference column.
WITH rain AS (
  SELECT state_name,
         COUNT(*) AS rain_weekend_crashes
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE  day_of_week IN (1,7)
    AND  (LOWER(atmospheric_conditions_1_name) LIKE 'rain%'
          OR LOWER(atmospheric_conditions_2_name) LIKE 'rain%')
  GROUP  BY state_name
),
clear AS (
  SELECT state_name,
         COUNT(*) AS clear_weekend_crashes
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE  day_of_week IN (1,7)
    AND  (LOWER(atmospheric_conditions_1_name) IN ('clear','no adverse condition')
          OR LOWER(atmospheric_conditions_2_name) IN ('clear','no adverse condition'))
  GROUP  BY state_name
)
SELECT COALESCE(rain.state_name, clear.state_name) AS state_name,
       rain_weekend_crashes,
       clear_weekend_crashes,
       ABS(COALESCE(rain_weekend_crashes,0) - COALESCE(clear_weekend_crashes,0)) AS diff
FROM   rain
FULL  JOIN clear USING (state_name)
ORDER  BY diff DESC
LIMIT 20;
```

```sql
-- 9. Description:  Same as #8 but keep just the top 10 states by difference.
WITH rain AS (
  SELECT state_name,
         COUNT(*) AS rain_weekend_crashes
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE  day_of_week IN (1,7)
    AND  (LOWER(atmospheric_conditions_1_name) LIKE 'rain%'
          OR LOWER(atmospheric_conditions_2_name) LIKE 'rain%')
  GROUP  BY state_name
),
clear AS (
  SELECT state_name,
         COUNT(*) AS clear_weekend_crashes
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE  day_of_week IN (1,7)
    AND  (LOWER(atmospheric_conditions_1_name) IN ('clear','no adverse condition')
          OR LOWER(atmospheric_conditions_2_name) IN ('clear','no adverse condition'))
  GROUP  BY state_name
)
SELECT COALESCE(rain.state_name, clear.state_name) AS state_name,
       rain_weekend_crashes,
       clear_weekend_crashes,
       ABS(COALESCE(rain_weekend_crashes,0) - COALESCE(clear_weekend_crashes,0)) AS diff
FROM   rain
FULL  JOIN clear USING (state_name)
ORDER  BY diff DESC
LIMIT 10;
```

```sql
-- 10. Description:  Final query – return the top‑3 states
--     with the largest rain‑vs‑clear weekend accident difference in 2016.
WITH rain AS (
  SELECT state_name,
         COUNT(*) AS rain_weekend_crashes
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE  day_of_week IN (1,7)
    AND  (LOWER(atmospheric_conditions_1_name) LIKE 'rain%'
          OR LOWER(atmospheric_conditions_2_name) LIKE 'rain%')
  GROUP  BY state_name
),
clear AS (
  SELECT state_name,
         COUNT(*) AS clear_weekend_crashes
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE  day_of_week IN (1,7)
    AND  (LOWER(atmospheric_conditions_1_name) IN ('clear','no adverse condition')
          OR LOWER(atmospheric_conditions_2_name) IN ('clear','no adverse condition'))
  GROUP  BY state_name
)
SELECT COALESCE(rain.state_name, clear.state_name)             AS state_name,
       rain_weekend_crashes,
       clear_weekend_crashes,
       ABS(COALESCE(rain_weekend_crashes,0) -
           COALESCE(clear_weekend_crashes,0))                  AS diff_rain_vs_clear
FROM   rain
FULL  JOIN clear USING (state_name)
ORDER  BY diff_rain_vs_clear DESC
LIMIT 3;
```
