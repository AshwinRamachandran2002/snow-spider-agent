--Description: 8) Combine weekend rain/clear counts for every state.
WITH rain AS (
  SELECT state_name, COUNT(*) AS rain_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND (LOWER(atmospheric_conditions_1_name) LIKE '%rain%'
         OR LOWER(atmospheric_conditions_2_name) LIKE '%rain%')
  GROUP BY state_name
), clear AS (
  SELECT state_name, COUNT(*) AS clear_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND (LOWER(atmospheric_conditions_1_name) LIKE '%clear%'
         OR LOWER(atmospheric_conditions_2_name) LIKE '%clear%')
  GROUP BY state_name
)
SELECT
  COALESCE(rain.state_name, clear.state_name) AS state_name,
  IFNULL(rain_cnt,  0) AS rain_cnt,
  IFNULL(clear_cnt, 0) AS clear_cnt
FROM rain
FULL OUTER JOIN clear USING (state_name)
ORDER BY state_name
LIMIT 20
