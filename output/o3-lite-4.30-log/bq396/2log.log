```sql
-- 5. Description: Sample of weekend crashes that happened in clear weather.
SELECT state_name,
       day_of_week_name,
       atmospheric_conditions_1_name,
       atmospheric_conditions_2_name
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE day_of_week IN (1,7)
  AND (LOWER(atmospheric_conditions_1_name) LIKE '%clear%'
       OR LOWER(atmospheric_conditions_2_name) LIKE '%clear%')
LIMIT 20;
```

```sql
-- 6. Description: Count weekend‑rain crashes per state.
SELECT state_name,
       COUNT(*) AS rain_weekend_crashes
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE day_of_week IN (1,7)
  AND (LOWER(atmospheric_conditions_1_name) LIKE '%rain%'
       OR LOWER(atmospheric_conditions_2_name) LIKE '%rain%')
GROUP BY state_name
ORDER BY rain_weekend_crashes DESC
LIMIT 20;
```

```sql
-- 7. Description: Count weekend‑clear crashes per state.
SELECT state_name,
       COUNT(*) AS clear_weekend_crashes
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE day_of_week IN (1,7)
  AND (LOWER(atmospheric_conditions_1_name) LIKE '%clear%'
       OR LOWER(atmospheric_conditions_2_name) LIKE '%clear%')
GROUP BY state_name
ORDER BY clear_weekend_crashes DESC
LIMIT 20;
```

```sql
-- 8. Description: Put the two previous counts together for every state.
WITH rain AS (
  SELECT state_name, COUNT(*) AS rain_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND (LOWER(atmospheric_conditions_1_name) LIKE '%rain%'
         OR LOWER(atmospheric_conditions_2_name) LIKE '%rain%')
  GROUP BY state_name
), clear AS (
  SELECT state_name, COUNT(*) AS clear_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND (LOWER(atmospheric_conditions_1_name) LIKE '%clear%'
         OR LOWER(atmospheric_conditions_2_name) LIKE '%clear%')
  GROUP BY state_name
)
SELECT
  COALESCE(rain.state_name, clear.state_name) AS state_name,
  IFNULL(rain_cnt,0) AS rain_cnt,
  IFNULL(clear_cnt,0) AS clear_cnt
FROM rain
FULL OUTER JOIN clear
USING (state_name)
ORDER BY state_name
LIMIT 20;
```

```sql
-- 9. Description: Compute the absolute difference between weekend‑rain and weekend‑clear crashes for every state.
WITH rain AS (
  SELECT state_name, COUNT(*) AS rain_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND (LOWER(atmospheric_conditions_1_name) LIKE '%rain%'
         OR LOWER(atmospheric_conditions_2_name) LIKE '%rain%')
  GROUP BY state_name
), clear AS (
  SELECT state_name, COUNT(*) AS clear_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND (LOWER(atmospheric_conditions_1_name) LIKE '%clear%'
         OR LOWER(atmospheric_conditions_2_name) LIKE '%clear%')
  GROUP BY state_name
)
SELECT
  COALESCE(rain.state_name, clear.state_name) AS state_name,
  IFNULL(rain_cnt,0)  AS rain_cnt,
  IFNULL(clear_cnt,0) AS clear_cnt,
  ABS(IFNULL(rain_cnt,0) - IFNULL(clear_cnt,0)) AS difference
FROM rain
FULL OUTER JOIN clear
USING (state_name)
ORDER BY difference DESC
LIMIT 20;
```

```sql
-- 10. Description: FINAL ANSWER – Top‑3 states with the largest weekend difference between rain and clear crashes in 2016.
WITH rain AS (
  SELECT state_name, COUNT(*) AS rain_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)  -- 1 = Sunday, 7 = Saturday
    AND (LOWER(atmospheric_conditions_1_name) LIKE '%rain%'
         OR LOWER(atmospheric_conditions_2_name) LIKE '%rain%')
  GROUP BY state_name
), clear AS (
  SELECT state_name, COUNT(*) AS clear_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND (LOWER(atmospheric_conditions_1_name) LIKE '%clear%'
         OR LOWER(atmospheric_conditions_2_name) LIKE '%clear%')
  GROUP BY state_name
)
SELECT
  COALESCE(rain.state_name, clear.state_name)                    AS state,
  IFNULL(rain_cnt,0)                                             AS weekend_rain_accidents,
  IFNULL(clear_cnt,0)                                            AS weekend_clear_accidents,
  ABS(IFNULL(rain_cnt,0) - IFNULL(clear_cnt,0))                  AS difference
FROM rain
FULL OUTER JOIN clear
USING (state_name)
ORDER BY difference DESC
LIMIT 3;
```

Running the last query will list the three states with the greatest numeric gap between weekend accidents under rainy vs. clear conditions, together with the size of that gap.
