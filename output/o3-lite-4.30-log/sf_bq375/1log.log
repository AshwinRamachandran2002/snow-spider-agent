SELECT "path"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%.py'
  AND (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) + 1 > 10
LIMIT 20;
```

```sql
--Description: 6. Count deep‑nested Python files.
SELECT COUNT(*) AS "py_file_cnt"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%.py'
  AND (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) + 1 > 10;
```

```sql
--Description: 7. Count deep‑nested C source files.
SELECT COUNT(*) AS "c_file_cnt"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%.c'
  AND (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) + 1 > 10;
```

```sql
--Description: 8. Count deep‑nested Java, JavaScript, and Notebook files individually.
SELECT 
  SUM(CASE WHEN LOWER("path") ILIKE '%.java'  THEN 1 ELSE 0 END) AS "java_cnt",
  SUM(CASE WHEN LOWER("path") ILIKE '%.js'    THEN 1 ELSE 0 END) AS "js_cnt",
  SUM(CASE WHEN LOWER("path") ILIKE '%.ipynb' THEN 1 ELSE 0 END) AS "ipynb_cnt"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) + 1 > 10;
```

```sql
--Description: 9. Aggregate counts for all five target extensions and present side‑by‑side.
SELECT 
  CASE
    WHEN LOWER("path") ILIKE '%.py'   THEN 'python'
    WHEN LOWER("path") ILIKE '%.c'    THEN 'c'
    WHEN LOWER("path") ILIKE '%.ipynb' THEN 'notebook'
    WHEN LOWER("path") ILIKE '%.java' THEN 'java'
    WHEN LOWER("path") ILIKE '%.js'   THEN 'javascript'
  END AS "file_type",
  COUNT(*) AS "deep_file_cnt"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) + 1 > 10
  AND (
        LOWER("path") ILIKE '%.py' OR
        LOWER("path") ILIKE '%.c' OR
        LOWER("path") ILIKE '%.ipynb' OR
        LOWER("path") ILIKE '%.java' OR
        LOWER("path") ILIKE '%.js'
      )
GROUP BY 1
ORDER BY "deep_file_cnt" DESC
LIMIT 20;
```

```sql
--Description: 10. Return only the file type that has the maximum deep‑file count.
SELECT "file_type", "deep_file_cnt"
FROM (
  SELECT 
    CASE
      WHEN LOWER("path") ILIKE '%.py'   THEN 'python'
      WHEN LOWER("path") ILIKE '%.c'    THEN 'c'
      WHEN LOWER("path") ILIKE '%.ipynb' THEN 'notebook'
      WHEN LOWER("path") ILIKE '%.java' THEN 'java'
      WHEN LOWER("path") ILIKE '%.js'   THEN 'javascript'
    END AS "file_type",
    COUNT(*) AS "deep_file_cnt"
  FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
  WHERE (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) + 1 > 10
    AND (
          LOWER("path") ILIKE '%.py' OR
          LOWER("path") ILIKE '%.c' OR
          LOWER("path") ILIKE '%.ipynb' OR
          LOWER("path") ILIKE '%.java' OR
          LOWER("path") ILIKE '%.js'
        )
  GROUP BY 1
)
QUALIFY ROW_NUMBER() OVER (ORDER BY "deep_file_cnt" DESC) = 1;
```
