  LOWER(SUBSTR("path", POSITION('.' IN "path") + 1)) AS "ext"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
LIMIT 20;
```

```sql
--Description: 4. Show examples whose depth is greater than 10.
SELECT 
  "path",
