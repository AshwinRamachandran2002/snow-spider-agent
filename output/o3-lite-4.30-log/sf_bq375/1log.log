Relevant columns and their potential usage

• "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  
  – "path": discover the file‑system path, extract extension, and derive directory depth.  
  – "repo_name": optional grouping by repository.  
  – "id": optional unique identifier of the file object (not needed for this task).

Conditions that will likely be used

• File‐type filter with ILIKE '%<ext>' (e.g. '%\.py').  
• Directory depth filter:   
  (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) + 1  > 10

Ten exploratory Snowflake SQL queries
```sql
--Description: 1. Inspect a handful of raw paths to see the directory layout.
SELECT "path"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
LIMIT 20;
```

```sql
--Description: 2. Show distinct file‑name extensions that exist in the sample set.
SELECT DISTINCT LOWER(SUBSTR("path", POSITION('.' IN "path") + 1)) AS "ext"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%.%'
LIMIT 20;
```

```sql
--Description: 3. Preview path, computed directory depth, and extension for a few rows.
SELECT 
  "path",
  (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) + 1 AS "depth",
  LOWER(SUBSTR("path", POSITION('.' IN "path") + 1)) AS "ext"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
LIMIT 20;
```

```sql
--Description: 4. Show examples whose depth is greater than 10.
SELECT 
  "path",
  (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) + 1 AS "depth"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) + 1 > 10
LIMIT 20;
```

```sql
--Description: 5. Pull twenty deep‑nested Python files.
SELECT "path"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%.py'
  AND (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) + 1 > 10
LIMIT 20;
```

```sql
--Description: 6. Count deep‑nested Python files.
SELECT COUNT(*) AS "py_file_cnt"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%.py'
  AND (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) + 1 > 10;
```

```sql
--Description: 7. Count deep‑nested C source files.
SELECT COUNT(*) AS "c_file_cnt"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%.c'
  AND (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) + 1 > 10;
```

```sql
--Description: 8. Count deep‑nested Java, JavaScript, and Notebook files individually.
SELECT 
  SUM(CASE WHEN LOWER("path") ILIKE '%.java'  THEN 1 ELSE 0 END) AS "java_cnt",
  SUM(CASE WHEN LOWER("path") ILIKE '%.js'    THEN 1 ELSE 0 END) AS "js_cnt",
  SUM(CASE WHEN LOWER("path") ILIKE '%.ipynb' THEN 1 ELSE 0 END) AS "ipynb_cnt"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) + 1 > 10;
```

```sql
--Description: 9. Aggregate counts for all five target extensions and present side‑by‑side.
SELECT 
  CASE
    WHEN LOWER("path") ILIKE '%.py'   THEN 'python'
    WHEN LOWER("path") ILIKE '%.c'    THEN 'c'
    WHEN LOWER("path") ILIKE '%.ipynb' THEN 'notebook'
    WHEN LOWER("path") ILIKE '%.java' THEN 'java'
    WHEN LOWER("path") ILIKE '%.js'   THEN 'javascript'
  END AS "file_type",
  COUNT(*) AS "deep_file_cnt"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) + 1 > 10
  AND (
        LOWER("path") ILIKE '%.py' OR
        LOWER("path") ILIKE '%.c' OR
        LOWER("path") ILIKE '%.ipynb' OR
        LOWER("path") ILIKE '%.java' OR
        LOWER("path") ILIKE '%.js'
      )
GROUP BY 1
ORDER BY "deep_file_cnt" DESC
LIMIT 20;
```

```sql
--Description: 10. Return only the file type that has the maximum deep‑file count.
SELECT "file_type", "deep_file_cnt"
FROM (
  SELECT 
    CASE
      WHEN LOWER("path") ILIKE '%.py'   THEN 'python'
      WHEN LOWER("path") ILIKE '%.c'    THEN 'c'
      WHEN LOWER("path") ILIKE '%.ipynb' THEN 'notebook'
      WHEN LOWER("path") ILIKE '%.java' THEN 'java'
      WHEN LOWER("path") ILIKE '%.js'   THEN 'javascript'
    END AS "file_type",
    COUNT(*) AS "deep_file_cnt"
  FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
  WHERE (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) + 1 > 10
    AND (
          LOWER("path") ILIKE '%.py' OR
          LOWER("path") ILIKE '%.c' OR
          LOWER("path") ILIKE '%.ipynb' OR
          LOWER("path") ILIKE '%.java' OR
          LOWER("path") ILIKE '%.js'
        )
  GROUP BY 1
)
QUALIFY ROW_NUMBER() OVER (ORDER BY "deep_file_cnt" DESC) = 1;
```
