LIMIT 20;
```

```sql
--Description: 2. Show distinct file‑name extensions that exist in the sample set.
SELECT DISTINCT LOWER(SUBSTR("path", POSITION('.' IN "path") + 1)) AS "ext"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%.%'
LIMIT 20;
```

```sql
--Description: 3. Preview path, computed directory depth, and extension for a few rows.
SELECT 
