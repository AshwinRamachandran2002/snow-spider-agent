```sql
SELECT
  file_type,
  file_count
FROM (
  SELECT
    CASE
      WHEN "path" ILIKE '%.py'    THEN '.py'
      WHEN "path" ILIKE '%.c'     THEN '.c'
      WHEN "path" ILIKE '%.ipynb' THEN '.ipynb'
      WHEN "path" ILIKE '%.java'  THEN '.java'
      WHEN "path" ILIKE '%.js'    THEN '.js'
    END                                       AS file_type,
    COUNT(*)                                  AS file_count
  FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES
  WHERE (LENGTH("path") - LENGTH(REPLACE("path", '/', ''))) > 10   -- directory depth > 10
    AND (
          "path" ILIKE '%.py' OR
          "path" ILIKE '%.c' OR
          "path" ILIKE '%.ipynb' OR
          "path" ILIKE '%.java' OR
          "path" ILIKE '%.js'
        )
  GROUP BY file_type
)
ORDER BY file_count DESC NULLS LAST, file_type
LIMIT 1;
```
