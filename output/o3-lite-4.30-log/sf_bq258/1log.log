The table structure information is ({database name: {schema name: [table name]}}): 
{'THELOOK_ECOMMERCE': {'THELOOK_ECOMMERCE': ['DISTRIBUTION_CENTERS', 'ORDERS', 'USERS', 'EVENTS', 'INVENTORY_ITEMS', 'PRODUCTS', 'ORDER_ITEMS']}}
Begin Exploring Related Columns
Relevant columns and how they will be used  
• ORDER_ITEMS."status": filter rows that equal ‘Complete’.  
• ORDER_ITEMS."delivered_at": identify delivery date ( µ‑seconds since epoch) → extract month / year; also used to keep only dates before 2022.  
• ORDER_ITEMS."sale_price": revenue for each order line.  
• ORDER_ITEMS."order_id": to count completed orders (use COUNT(DISTINCT "order_id")).  
• ORDER_ITEMS."product_id": join key to PRODUCTS.  
• PRODUCTS."category": product category needed for the report.  
• PRODUCTS."cost": unit cost of the product – multiply by number of items (1 per order‑item) to get total cost.  

Typical conditions you’ll combine later  
• WHERE ORDER_ITEMS."status" = 'Complete'  
• AND   ORDER_ITEMS."delivered_at" IS NOT NULL  
• AND   ORDER_ITEMS."delivered_at" < 1640995200000000   -- 2022‑01‑01 in µ‑seconds  

Below are ten practice Snowflake queries that gradually explore the data up to a full monthly profit / growth calculation.  
Each query is limited to 20 rows and all identifiers are double‑quoted.  

```sql
-- 1. Description: Quick glance at raw order‑item data
SELECT *
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
LIMIT 20;
```

```sql
-- 2. Description: See all distinct order‑item statuses
SELECT DISTINCT "status"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
LIMIT 20;
```

```sql
-- 3. Description: List all distinct product categories
SELECT DISTINCT "category"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"
LIMIT 20;
```

```sql
-- 4. Description: Join a handful of completed order‑items to their product info
SELECT oi."id"               AS "order_item_id",
       oi."order_id",
       oi."product_id",
       p."category",
       oi."sale_price",
       p."cost",
       oi."delivered_at"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"   oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      p
       ON oi."product_id" = p."id"
WHERE  oi."status" = 'Complete'
LIMIT 20;
```

```sql
-- 5. Description: Completed order‑items that were delivered (non‑null field)
SELECT oi."order_id",
       oi."product_id",
       oi."delivered_at",
       oi."sale_price"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
WHERE  oi."status" = 'Complete'
  AND  oi."delivered_at" IS NOT NULL
LIMIT 20;
```

```sql
-- 6. Description: Show delivery time in both raw µs and human readable format
SELECT oi."order_id",
       oi."delivered_at",
       TO_TIMESTAMP(oi."delivered_at" / 1000000)  AS "delivered_ts"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
WHERE  oi."status" = 'Complete'
  AND  oi."delivered_at" IS NOT NULL
LIMIT 20;
```

```sql
-- 7. Description: Simple monthly revenue per category before 2022
SELECT p."category",
       DATE_TRUNC('month', TO_TIMESTAMP(oi."delivered_at" / 1000000)) AS "month",
       SUM(oi."sale_price")  AS "revenue"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
WHERE  oi."status" = 'Complete'
  AND  oi."delivered_at" IS NOT NULL
  AND  oi."delivered_at" < 1640995200000000       -- before 2022‑01‑01
GROUP  BY 1,2
ORDER  BY 2,1
LIMIT 20;
```

```sql
-- 8. Description: Add total cost per month/category
SELECT p."category",
       DATE_TRUNC('month', TO_TIMESTAMP(oi."delivered_at" / 1000000)) AS "month",
       SUM(oi."sale_price")                 AS "revenue",
       SUM(p."cost")                        AS "total_cost"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
WHERE  oi."status" = 'Complete'
  AND  oi."delivered_at" IS NOT NULL
  AND  oi."delivered_at" < 1640995200000000
GROUP  BY 1,2
ORDER  BY 2,1
LIMIT 20;
```

```sql
-- 9. Description: Add profit & profit‑to‑cost ratio
SELECT p."category",
       DATE_TRUNC('month', TO_TIMESTAMP(oi."delivered_at" / 1000000)) AS "month",
       SUM(oi."sale_price")                 AS "revenue",
       SUM(p."cost")                        AS "total_cost",
       SUM(oi."sale_price") - SUM(p."cost") AS "profit",
       (SUM(oi."sale_price") - SUM(p."cost")) / NULLIF(SUM(p."cost"),0) AS "profit_to_cost_ratio"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
WHERE  oi."status" = 'Complete'
  AND  oi."delivered_at" IS NOT NULL
  AND  oi."delivered_at" < 1640995200000000
GROUP  BY 1,2
ORDER  BY 2,1
LIMIT 20;
```

```sql
-- 10. Description: Full report – revenue, orders, MoM growth, cost, profit, ratio
WITH monthly AS (
    SELECT p."category",
           DATE_TRUNC('month', TO_TIMESTAMP(oi."delivered_at" / 1000000)) AS "month",
           SUM(oi."sale_price")                 AS "revenue",
           COUNT(DISTINCT oi."order_id")        AS "orders",
           SUM(p."cost")                        AS "total_cost",
           SUM(oi."sale_price") - SUM(p."cost") AS "profit"
    FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
           ON oi."product_id" = p."id"
    WHERE  oi."status" = 'Complete'
      AND  oi."delivered_at" IS NOT NULL
      AND  oi."delivered_at" < 1640995200000000
    GROUP  BY 1,2
)
SELECT m."category",
       m."month",
       m."revenue",
       m."orders",
       ROUND(100 * (m."revenue"  - LAG(m."revenue")  OVER (PARTITION BY m."category" ORDER BY m."month"))
             / NULLIF(LAG(m."revenue")  OVER (PARTITION BY m."category" ORDER BY m."month"),0), 2) AS "pct_rev_mom",
       ROUND(100 * (m."orders"   - LAG(m."orders")   OVER (PARTITION BY m."category" ORDER BY m."month"))
             / NULLIF(LAG(m."orders")   OVER (PARTITION BY m."category" ORDER BY m."month"),0), 2) AS "pct_ord_mom",
       m."total_cost",
       m."profit",
       m."profit" / NULLIF(m."total_cost",0)                 AS "profit_to_cost_ratio"
FROM   monthly  m
ORDER BY m."category", m."month"
LIMIT 20;
```
