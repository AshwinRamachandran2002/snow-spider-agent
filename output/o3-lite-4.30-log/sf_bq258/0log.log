Query:
-- 10. Description: Demonstrate month‑over‑month growth calculations for revenue and orders.
WITH monthly AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(O."delivered_at"/1000000)) AS "month",
         P."category",
         SUM(O."sale_price")                    AS "revenue",
         COUNT(DISTINCT O."order_id")           AS "orders"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  O
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     P
    ON O."product_id" = P."id"
  WHERE O."status" = 'Complete'
    AND TO_DATE(TO_TIMESTAMP_NTZ(O."delivered_at"/1000000)) < '2022-01-01'
  GROUP BY 1,2
)
SELECT "month",
       "category",
       "revenue",
       "orders",
       LAG("revenue") OVER (PARTITION BY "category" ORDER BY "month") AS "prev_revenue",
       LAG("orders")  OVER (PARTITION BY "category" ORDER BY "month") AS "prev_orders",
       ROUND( ( "revenue" / NULLIF("prev_revenue",0) - 1 ) * 100 , 2) AS "pct_revenue_growth",
       ROUND( ( "orders"  / NULLIF("prev_orders",0)  - 1 ) * 100 , 2) AS "pct_order_growth"
FROM monthly
ORDER BY "category", "month"
LIMIT 20;
