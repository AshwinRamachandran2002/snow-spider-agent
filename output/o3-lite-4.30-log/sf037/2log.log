--Description: 8) Distance (miles) from one arbitrary Home Depot store to every Lowe’s store.
--One_hd subquery supplies a single HD coordinate; cross‑join to every Lowe’s coordinate,
--then compute ST_DISTANCE /1609.  Aliases are consistent (lw_idx for POI, a for address).
WITH one_hd AS (
    SELECT  a."LATITUDE"  AS "HD_LAT",
            a."LONGITUDE" AS "HD_LON"
    FROM    US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_INDEX                  hd_idx
    JOIN    US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS hd_rel
           ON hd_idx."POI_ID" = hd_rel."POI_ID"
    JOIN    US_REAL_ESTATE.CYBERSYN.US_ADDRESSES                              a
           ON hd_rel."ADDRESS_ID" = a."ADDRESS_ID"
    WHERE   hd_idx."POI_NAME" ILIKE '%Home%Depot%'
    LIMIT 1
)
SELECT  lw_idx."POI_ID" AS "LOWES_POI_ID",
        ST_DISTANCE(
            ST_MAKEPOINT(one_hd."HD_LON", one_hd."HD_LAT"),
            ST_MAKEPOINT(a."LONGITUDE",  a."LATITUDE")
        )/1609           AS "DIST_MILES"
FROM    one_hd
CROSS JOIN US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_INDEX                   lw_idx
JOIN     US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS   lw_rel
       ON lw_idx."POI_ID" = lw_rel."POI_ID"
JOIN     US_REAL_ESTATE.CYBERSYN.US_ADDRESSES                                a
       ON lw_rel."ADDRESS_ID" = a."ADDRESS_ID"
WHERE    lw_idx."POI_NAME" ILIKE '%Lowe%s%Improvement%'
ORDER BY "DIST_MILES"
LIMIT 20
