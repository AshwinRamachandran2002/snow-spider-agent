Begin Exploring Related Columns
Relevant columns & how they will be used  
• POINT_OF_INTEREST_INDEX."POI_ID" – join key to addresses, unique id for every POI.  
• POINT_OF_INTEREST_INDEX."POI_NAME" – string to identify “The Home Depot” and “Lowe’s Home Improvement”.  
• POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS."POI_ID" – join to POI table.  
• POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS."ADDRESS_ID" – join to US_ADDRESSES for coordinates.  
• US_ADDRESSES."ADDRESS_ID" – join key back to relationships.  
• US_ADDRESSES."LATITUDE", US_ADDRESSES."LONGITUDE" – build geography points for distance math.  
• (Optional display) US_ADDRESSES."CITY", "STATE", "ZIP" – context when viewing results.  

Typical filters  
• POINT_OF_INTEREST_INDEX."POI_NAME" ILIKE '%Home%Depot%' for Home Depot stores.  
• POINT_OF_INTEREST_INDEX."POI_NAME" ILIKE '%Lowe%s%Improvement%' for Lowe’s stores.

Below are 10 progressively‑complex Snowflake SQL snippets (each returns ≤20 rows) that explore the data and finish with the fully‑worked nearest‑neighbor query.  
All column names are wrapped in double quotes and tables are fully qualified.

```sql
-- 1.  All distinct POI names that contain the words “Home” and “Depot”
SELECT DISTINCT 
       "POI_NAME"
FROM   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_INDEX
WHERE  "POI_NAME" ILIKE '%Home%Depot%'
LIMIT  20;
```

```sql
-- 2.  All distinct POI names that contain “Lowe” and “Improvement”
SELECT DISTINCT 
       "POI_NAME"
FROM   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_INDEX
WHERE  "POI_NAME" ILIKE '%Lowe%s%Improvement%'
LIMIT  20;
```

```sql
-- 3.  Sample of Home Depot POI_IDs and their names
SELECT "POI_ID",
       "POI_NAME"
FROM   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_INDEX
WHERE  "POI_NAME" ILIKE '%Home%Depot%'
LIMIT  20;
```

```sql
-- 4.  Address relationships for a few Home Depot POIs
SELECT r."POI_ID",
       r."ADDRESS_ID",
       r."RELATIONSHIP_TYPE"
FROM   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS  r
WHERE  r."POI_ID" IN (
          SELECT "POI_ID"
          FROM   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_INDEX
          WHERE  "POI_NAME" ILIKE '%Home%Depot%'
          LIMIT  20
       )
LIMIT 20;
```

```sql
-- 5.  Look up the raw latitude / longitude for those ADDRESS_IDs
SELECT a."ADDRESS_ID",
       a."LATITUDE",
       a."LONGITUDE",
       a."CITY",
       a."STATE",
       a."ZIP"
FROM   US_REAL_ESTATE.CYBERSYN.US_ADDRESSES               a
JOIN   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS r
       ON a."ADDRESS_ID" = r."ADDRESS_ID"
WHERE  r."POI_ID" IN (
          SELECT "POI_ID"
          FROM   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_INDEX
          WHERE  "POI_NAME" ILIKE '%Home%Depot%'
          LIMIT  20
       )
LIMIT 20;
```

```sql
-- 6.  Build a small view of Home Depot stores with lat / long
SELECT hd."POI_ID"                    AS "HD_POI_ID",
       a."ADDRESS_ID"                 AS "HD_ADDRESS_ID",
       a."LATITUDE"                   AS "HD_LAT",
       a."LONGITUDE"                  AS "HD_LON"
FROM   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_INDEX                  hd_idx
JOIN   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS hd_rel
       ON hd_idx."POI_ID" = hd_rel."POI_ID"
JOIN   US_REAL_ESTATE.CYBERSYN.US_ADDRESSES                              a
       ON hd_rel."ADDRESS_ID" = a."ADDRESS_ID"
WHERE  hd_idx."POI_NAME" ILIKE '%Home%Depot%'
LIMIT 20;
```

```sql
-- 7.  Same, but for Lowe’s Home Improvement stores
SELECT lw."POI_ID"                    AS "LOWES_POI_ID",
       a."ADDRESS_ID"                 AS "LOWES_ADDRESS_ID",
       a."LATITUDE"                   AS "LOWES_LAT",
       a."LONGITUDE"                  AS "LOWES_LON"
FROM   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_INDEX                  lw_idx
JOIN   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS lw_rel
       ON lw_idx."POI_ID" = lw_rel."POI_ID"
JOIN   US_REAL_ESTATE.CYBERSYN.US_ADDRESSES                              a
       ON lw_rel."ADDRESS_ID" = a."ADDRESS_ID"
WHERE  lw_idx."POI_NAME" ILIKE '%Lowe%s%Improvement%'
LIMIT 20;
```

```sql
-- 8.  Example: distance (in miles) from one arbitrary Home Depot to every Lowe’s
WITH one_hd AS (
   SELECT   a."LATITUDE"  AS "HD_LAT",
            a."LONGITUDE" AS "HD_LON"
   FROM     US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_INDEX                  hd_idx
   JOIN     US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS hd_rel
            ON hd_idx."POI_ID" = hd_rel."POI_ID"
   JOIN     US_REAL_ESTATE.CYBERSYN.US_ADDRESSES                              a
            ON hd_rel."ADDRESS_ID" = a."ADDRESS_ID"
   WHERE    hd_idx."POI_NAME" ILIKE '%Home%Depot%'
   LIMIT 1
)
SELECT  lw_idx."POI_ID"                                           AS "LOWES_POI_ID",
        ST_DISTANCE(
           ST_MAKEPOINT(one_hd."HD_LON", one_hd."HD_LAT"),
           ST_MAKEPOINT(a."LONGITUDE", a."LATITUDE")
        )/1609                                                   AS "DIST_MILES"
FROM    one_hd
CROSS JOIN US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_INDEX                   lw_idx
JOIN     US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS   lw_rel
         ON lw_idx."POI_ID" = lw_rel."POI_ID"
JOIN     US_REAL_ESTATE.CYBERSYN.US_ADDRESSES                                a
         ON lw_rel."ADDRESS_ID" = a."ADDRESS_ID"
WHERE    lw_idx."POI_NAME" ILIKE '%Lowe%s%Improvement%'
ORDER BY "DIST_MILES"
LIMIT 20;
```

```sql
-- 9.  Minimum distance Lowe’s → Home Depot for a handful of Home Depots
WITH hd AS (
     SELECT hd_idx."POI_ID"       AS "HD_POI_ID",
            a."LATITUDE"          AS "HD_LAT",
            a."LONGITUDE"         AS "HD_LON"
     FROM   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_INDEX                  hd_idx
     JOIN   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS hd_rel
            ON hd_idx."POI_ID" = hd_rel."POI_ID"
     JOIN   US_REAL_ESTATE.CYBERSYN.US_ADDRESSES                              a
            ON hd_rel."ADDRESS_ID" = a."ADDRESS_ID"
     WHERE  hd_idx."POI_NAME" ILIKE '%Home%Depot%'
     LIMIT 20
), lw AS (
     SELECT lw_idx."POI_ID"       AS "LOWES_POI_ID",
            a."LATITUDE"          AS "LOWES_LAT",
            a."LONGITUDE"         AS "LOWES_LON"
     FROM   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_INDEX                  lw_idx
     JOIN   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS lw_rel
            ON lw_idx."POI_ID" = lw_rel."POI_ID"
     JOIN   US_REAL_ESTATE.CYBERSYN.US_ADDRESSES                              a
            ON lw_rel."ADDRESS_ID" = a."ADDRESS_ID"
     WHERE  lw_idx."POI_NAME" ILIKE '%Lowe%s%Improvement%'
)
SELECT  hd."HD_POI_ID",
        lw."LOWES_POI_ID",
        ST_DISTANCE(
           ST_MAKEPOINT(hd."HD_LON",   hd."HD_LAT"),
           ST_MAKEPOINT(lw."LOWES_LON",lw."LOWES_LAT")
        )/1609                                   AS "DIST_MILES"
FROM    hd
CROSS JOIN lw
ORDER BY hd."HD_POI_ID", "DIST_MILES"
LIMIT 20;
```

```sql
-- 10.  FINAL Pattern: shortest straight‑line Home Depot → nearest Lowe’s (all stores)
WITH hd AS (
     SELECT hd_idx."POI_ID"       AS "HD_POI_ID",
            a."LATITUDE"          AS "HD_LAT",
            a."LONGITUDE"         AS "HD_LON"
     FROM   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_INDEX                  hd_idx
     JOIN   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS hd_rel
            ON hd_idx."POI_ID" = hd_rel."POI_ID"
     JOIN   US_REAL_ESTATE.CYBERSYN.US_ADDRESSES                              a
            ON hd_rel."ADDRESS_ID" = a."ADDRESS_ID"
     WHERE  hd_idx."POI_NAME" ILIKE '%Home%Depot%'
), lw AS (
     SELECT lw_idx."POI_ID"       AS "LOWES_POI_ID",
            a."LATITUDE"          AS "LOWES_LAT",
            a."LONGITUDE"         AS "LOWES_LON"
     FROM   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_INDEX                  lw_idx
     JOIN   US_REAL_ESTATE.CYBERSYN.POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS lw_rel
            ON lw_idx."POI_ID" = lw_rel."POI_ID"
     JOIN   US_REAL_ESTATE.CYBERSYN.US_ADDRESSES                              a
            ON lw_rel."ADDRESS_ID" = a."ADDRESS_ID"
     WHERE  lw_idx."POI_NAME" ILIKE '%Lowe%s%Improvement%'
)
SELECT  hd."HD_POI_ID",
        -- the nearest Lowe’s store id
        lw."LOWES_POI_ID"                         AS "NEAREST_LOWES_POI_ID",
        ST_DISTANCE(
           ST_MAKEPOINT(hd."HD_LON", hd."HD_LAT"),
           ST_MAKEPOINT(lw."LOWES_LON", lw."LOWES_LAT")
        )/1609                                    AS "DIST_MILES"
FROM    hd
CROSS JOIN lw
QUALIFY ROW_NUMBER() OVER (PARTITION BY hd."HD_POI_ID"
                           ORDER BY ST_DISTANCE(
                                   ST_MAKEPOINT(hd."HD_LON", hd."HD_LAT"),
                                   ST_MAKEPOINT(lw."LOWES_LON", lw."LOWES_LAT")) ) = 1
LIMIT 20;
```

