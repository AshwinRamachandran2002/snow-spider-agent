    WHERE   p."POI_NAME" ILIKE '%lowe%home%improvement%'
)
SELECT  lws.lw_poi,
        ST_DISTANCE(
            ST_MAKEPOINT(hd.hd_lon, hd.hd_lat),
            ST_MAKEPOINT(lws.lw_lon, lws.lw_lat)
