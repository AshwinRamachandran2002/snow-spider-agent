--Description (thinking process):
-- Goal: retrieve 20 sample “The Home Depot” POIs with their coordinates.
--  1. Start with POINT_OF_INTEREST_INDEX (alias hd_idx) – contains POI_ID and POI_NAME.  
--  2. Join POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS (hd_rel) on POI_ID; keep only rows where RELATIONSHIP_TYPE = 'Overlaps'
--     so we link each POI to its primary street address.  
--  3. Join US_ADDRESSES (alias a) on ADDRESS_ID to obtain LATITUDE / LONGITUDE and location details.  
--  4. Filter POI_NAME using ILIKE '%home%depot%' to capture all Home Depot variations.  
--  5. Select hd_idx."POI_ID" plus coordinates & city/state/ZIP.  
--  6. LIMIT 20 for a quick inspection.
SELECT
       hd_idx."POI_ID",
       a."LATITUDE",
       a."LONGITUDE",
       a."CITY",
       a."STATE",
       a."ZIP"
FROM   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"                 hd_idx
JOIN   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS" hd_rel
       ON hd_idx."POI_ID" = hd_rel."POI_ID"
       AND hd_rel."RELATIONSHIP_TYPE" = 'Overlaps'
JOIN   "US_REAL_ESTATE"."CYBERSYN"."US_ADDRESSES"                             a
       ON hd_rel."ADDRESS_ID" = a."ADDRESS_ID"
WHERE  hd_idx."POI_NAME" ILIKE '%home%depot%'
LIMIT 20;
