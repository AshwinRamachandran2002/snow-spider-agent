--Description: Full query – each Home Depot matched to its nearest Lowe’s with distance in miles (aliases coherent).
WITH
home_depot AS (
    SELECT  hd_idx."POI_ID"   AS "HD_POI",
            hd_a."LATITUDE"   AS "HD_LAT",
            hd_a."LONGITUDE"  AS "HD_LON"
    FROM    "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"                 hd_idx
    JOIN    "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS" hd_rel
           ON hd_idx."POI_ID" = hd_rel."POI_ID"
           AND hd_rel."RELATIONSHIP_TYPE" = 'Overlaps'
    JOIN    "US_REAL_ESTATE"."CYBERSYN"."US_ADDRESSES"                             hd_a
           ON hd_rel."ADDRESS_ID" = hd_a."ADDRESS_ID"
    WHERE   hd_idx."POI_NAME" ILIKE '%home%depot%'
),
lowes AS (
    SELECT  lw_idx."POI_ID"   AS "LW_POI",
            lw_a."LATITUDE"   AS "LW_LAT",
            lw_a."LONGITUDE"  AS "LW_LON"
    FROM    "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"                 lw_idx
    JOIN    "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS" lw_rel
           ON lw_idx."POI_ID" = lw_rel."POI_ID"
           AND lw_rel."RELATIONSHIP_TYPE" = 'Overlaps'
    JOIN    "US_REAL_ESTATE"."CYBERSYN"."US_ADDRESSES"                             lw_a
           ON lw_rel."ADDRESS_ID" = lw_a."ADDRESS_ID"
    WHERE   (lw_idx."POI_NAME" ILIKE '%lowe%s%home%improvement%'
             OR lw_idx."POI_NAME" ILIKE '%lowe%s%')
)
SELECT
       hd."HD_POI" AS "THE_HOME_DEPOT_POI_ID",
       lw."LW_POI" AS "NEAREST_LOWES_POI_ID",
       ST_DISTANCE(
           ST_POINT(hd."HD_LON", hd."HD_LAT"),
           ST_POINT(lw."LW_LON", lw."LW_LAT")
       ) / 1609    AS "DISTANCE_MILES"
FROM   home_depot hd
JOIN   lowes      lw
       ON 1 = 1            -- Cartesian join to test every pair
QUALIFY ROW_NUMBER() OVER (PARTITION BY hd."HD_POI"
                           ORDER BY ST_DISTANCE(
                                      ST_POINT(hd."HD_LON", hd."HD_LAT"),
                                      ST_POINT(lw."LW_LON", lw."LW_LAT")
                                   )
) = 1
LIMIT 20
