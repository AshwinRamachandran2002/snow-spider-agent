Begin Exploring Related Columns
Relevant columns and their potential use  
• "POI_ID" (POINT_OF_INTEREST_INDEX)     : joins every POI to its address via POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS  
• "POI_NAME" (POINT_OF_INTEREST_INDEX)  : filter for ‘The Home Depot’ and ‘Lowe’s Home Improvement’ stores  
• "CATEGORY_MAIN" / "CATEGORY_ALTERNATE" : optional extra filters / validation of merchant type  
• "ADDRESS_ID" (POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS) : connects POI records to rows in US_ADDRESSES  
• "RELATIONSHIP_TYPE" (POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS) : keep only ‘Overlaps’ relations (one‑to‑one link)  
• "LATITUDE" / "LONGITUDE" (US_ADDRESSES)                 : needed to build points for distance calculations  
• "ZIP" / "CITY" / "STATE" (US_ADDRESSES) : optional extra geography checks  

Typical filter conditions  
WHERE "POI_NAME" ILIKE '%home%depot%'   — grabs all Home Depot rows  
WHERE "POI_NAME" ILIKE '%lowe%s%home%improvement%' OR "POI_NAME" ILIKE '%lowe%s%' — grabs Lowe’s rows  
AND   "RELATIONSHIP_TYPE" = 'Overlaps'      — keeps proper POI→address links  

Below are ten exploratory → increasingly complex Snowflake SQLs (all limited to 20 rows) that walk from basic inspection to the final minimum‑distance result.  
Replace or tweak the ILIKE patterns if inspection shows slightly different store names.

```sql
-- 1. Peek at any POI names that mention “Depot” or “Lowe” to understand naming conventions
SELECT DISTINCT "POI_NAME"
FROM   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"
WHERE  "POI_NAME" ILIKE '%depot%'
   OR  "POI_NAME" ILIKE '%lowe%'
LIMIT 20;
```

```sql
-- 2. List the distinct Home Depot‑style POI names that actually exist
SELECT DISTINCT "POI_NAME"
FROM   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"
WHERE  "POI_NAME" ILIKE '%home%depot%'
LIMIT 20;
```

```sql
-- 3. List the distinct Lowe’s‑style POI names that actually exist
SELECT DISTINCT "POI_NAME"
FROM   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"
WHERE  "POI_NAME" ILIKE '%lowe%s%home%improvement%'
   OR  "POI_NAME" ILIKE '%lowe%s%'
LIMIT 20;
```

```sql
-- 4. Count how many POIs we have for each chain
SELECT
       CASE WHEN "POI_NAME" ILIKE '%home%depot%'             THEN 'Home Depot'
            WHEN "POI_NAME" ILIKE '%lowe%s%home%improvement%' 
              OR "POI_NAME" ILIKE '%lowe%s%'                 THEN 'Lowes'
       END   AS "CHAIN",
       COUNT(*)            AS "POI_COUNT"
FROM   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"
WHERE  ("POI_NAME" ILIKE '%home%depot%' 
        OR "POI_NAME" ILIKE '%lowe%s%home%improvement%' 
        OR "POI_NAME" ILIKE '%lowe%s%')
GROUP  BY 1
LIMIT 20;
```

```sql
-- 5. Sample 20 Home Depot stores with their coordinates
SELECT  hd."POI_ID",
        a."LATITUDE",
        a."LONGITUDE",
        a."CITY",
        a."STATE",
        a."ZIP"
FROM   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"               hd_idx
JOIN   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS" hd_rel
       ON hd_idx."POI_ID" = hd_rel."POI_ID"  AND hd_rel."RELATIONSHIP_TYPE" = 'Overlaps'
JOIN   "US_REAL_ESTATE"."CYBERSYN"."US_ADDRESSES"                           a
       ON hd_rel."ADDRESS_ID" = a."ADDRESS_ID"
WHERE  hd_idx."POI_NAME" ILIKE '%home%depot%'
LIMIT 20;
```

```sql
-- 6. Sample 20 Lowe’s stores with their coordinates
SELECT  lw."POI_ID",
        a."LATITUDE",
        a."LONGITUDE",
        a."CITY",
        a."STATE",
        a."ZIP"
FROM   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"               lw_idx
JOIN   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS" lw_rel
       ON lw_idx."POI_ID" = lw_rel."POI_ID"  AND lw_rel."RELATIONSHIP_TYPE" = 'Overlaps'
JOIN   "US_REAL_ESTATE"."CYBERSYN"."US_ADDRESSES"                           a
       ON lw_rel."ADDRESS_ID" = a."ADDRESS_ID"
WHERE  (lw_idx."POI_NAME" ILIKE '%lowe%s%home%improvement%' 
        OR lw_idx."POI_NAME" ILIKE '%lowe%s%')
LIMIT 20;
```

```sql
-- 7. Build GEOGRAPHY points for both chains (single example row each)
SELECT  ST_POINT(hd_a."LONGITUDE", hd_a."LATITUDE") AS "HD_POINT",
        ST_POINT(lw_a."LONGITUDE", lw_a."LATITUDE") AS "LOWES_POINT"
FROM   (SELECT * FROM "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"  WHERE "POI_NAME" ILIKE '%home%depot%'  LIMIT 1) hd
JOIN   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS" hd_rel
        ON hd."POI_ID" = hd_rel."POI_ID"
JOIN   "US_REAL_ESTATE"."CYBERSYN"."US_ADDRESSES" hd_a
        ON hd_rel."ADDRESS_ID" = hd_a."ADDRESS_ID"
CROSS JOIN
      (SELECT * FROM "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"  WHERE ("POI_NAME" ILIKE '%lowe%s%home%improvement%' OR "POI_NAME" ILIKE '%lowe%s%') LIMIT 1) lw
JOIN   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS" lw_rel
        ON lw."POI_ID" = lw_rel."POI_ID"
JOIN   "US_REAL_ESTATE"."CYBERSYN"."US_ADDRESSES" lw_a
        ON lw_rel."ADDRESS_ID" = lw_a."ADDRESS_ID"
LIMIT 20;
```

```sql
-- 8. Compute straight‑line distance (miles) between the first Home Depot and the first Lowe’s
SELECT
       hd."POI_ID"               AS "HOME_DEPOT_POI",
       lw."POI_ID"               AS "LOWES_POI",
       ST_DISTANCE(
           ST_POINT(hd_a."LONGITUDE", hd_a."LATITUDE"),
           ST_POINT(lw_a."LONGITUDE", lw_a."LATITUDE")
       ) / 1609                  AS "DISTANCE_MILES"
FROM   (SELECT * FROM "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"  WHERE "POI_NAME" ILIKE '%home%depot%'  LIMIT 1) hd
JOIN   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS" hd_rel
        ON hd."POI_ID" = hd_rel."POI_ID"
JOIN   "US_REAL_ESTATE"."CYBERSYN"."US_ADDRESSES" hd_a
        ON hd_rel."ADDRESS_ID" = hd_a."ADDRESS_ID"
CROSS JOIN
      (SELECT * FROM "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"  WHERE ("POI_NAME" ILIKE '%lowe%s%home%improvement%' OR "POI_NAME" ILIKE '%lowe%s%') LIMIT 1) lw
JOIN   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS" lw_rel
        ON lw."POI_ID" = lw_rel."POI_ID"
JOIN   "US_REAL_ESTATE"."CYBERSYN"."US_ADDRESSES" lw_a
        ON lw_rel."ADDRESS_ID" = lw_a."ADDRESS_ID"
LIMIT 20;
```

```sql
-- 9. For ONE Home Depot, find its nearest Lowe’s (short sample version)
WITH
hd AS (
    SELECT  hd_idx."POI_ID"    AS "HD_POI",
            hd_a."LATITUDE"    AS "HD_LAT",
            hd_a."LONGITUDE"   AS "HD_LON"
    FROM   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"               hd_idx
    JOIN   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS" hd_rel
           ON hd_idx."POI_ID" = hd_rel."POI_ID"  AND hd_rel."RELATIONSHIP_TYPE" = 'Overlaps'
    JOIN   "US_REAL_ESTATE"."CYBERSYN"."US_ADDRESSES"                           hd_a
           ON hd_rel."ADDRESS_ID" = hd_a."ADDRESS_ID"
    WHERE  hd_idx."POI_NAME" ILIKE '%home%depot%'
    LIMIT 1
),
lw AS (
    SELECT  lw_idx."POI_ID"    AS "LW_POI",
            lw_a."LATITUDE"    AS "LW_LAT",
            lw_a."LONGITUDE"   AS "LW_LON"
    FROM   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"               lw_idx
    JOIN   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS" lw_rel
           ON lw_idx."POI_ID" = lw_rel."POI_ID"  AND lw_rel."RELATIONSHIP_TYPE" = 'Overlaps'
    JOIN   "US_REAL_ESTATE"."CYBERSYN"."US_ADDRESSES"                           lw_a
           ON lw_rel."ADDRESS_ID" = lw_a."ADDRESS_ID"
    WHERE  (lw_idx."POI_NAME" ILIKE '%lowe%s%home%improvement%' 
            OR lw_idx."POI_NAME" ILIKE '%lowe%s%')
)
SELECT
       hd."HD_POI",
       lw."LW_POI",
       ST_DISTANCE(ST_POINT(hd."HD_LON", hd."HD_LAT"), ST_POINT(lw."LW_LON", lw."LW_LAT")) / 1609 AS "DISTANCE_MILES"
FROM   hd
CROSS JOIN lw
ORDER BY "DISTANCE_MILES"
LIMIT 20;
```

```sql
-- 10. FULL query: for every Home Depot, return the closest Lowe’s and the straight‑line distance in miles
WITH
home_depot AS (
    SELECT  hd_idx."POI_ID"                    AS "HD_POI",
            hd_a."LATITUDE"                   AS "HD_LAT",
            hd_a."LONGITUDE"                  AS "HD_LON"
    FROM   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"               hd_idx
    JOIN   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS" hd_rel
           ON hd_idx."POI_ID" = hd_rel."POI_ID"  AND hd_rel."RELATIONSHIP_TYPE" = 'Overlaps'
    JOIN   "US_REAL_ESTATE"."CYBERSYN"."US_ADDRESSES"                           hd_a
           ON hd_rel."ADDRESS_ID" = hd_a."ADDRESS_ID"
    WHERE  hd_idx."POI_NAME" ILIKE '%home%depot%'
),
lowes AS (
    SELECT  lw_idx."POI_ID"                    AS "LW_POI",
            lw_a."LATITUDE"                   AS "LW_LAT",
            lw_a."LONGITUDE"                  AS "LW_LON"
    FROM   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_INDEX"               lw_idx
    JOIN   "US_REAL_ESTATE"."CYBERSYN"."POINT_OF_INTEREST_ADDRESSES_RELATIONSHIPS" lw_rel
           ON lw_idx."POI_ID" = lw_rel."POI_ID"  AND lw_rel."RELATIONSHIP_TYPE" = 'Overlaps'
    JOIN   "US_REAL_ESTATE"."CYBERSYN"."US_ADDRESSES"                           lw_a
           ON lw_rel."ADDRESS_ID" = lw_a."ADDRESS_ID"
    WHERE  (lw_idx."POI_NAME" ILIKE '%lowe%s%home%improvement%' 
            OR  lw_idx."POI_NAME" ILIKE '%lowe%s%')
)
SELECT
       hd."HD_POI"                                                AS "THE_HOME_DEPOT_POI_ID",
       lw."LW_POI"                                                AS "NEAREST_LOWES_POI_ID",
       ST_DISTANCE(
           ST_POINT(hd."HD_LON", hd."HD_LAT"),
           ST_POINT(lw."LW_LON", lw."LW_LAT")
       ) / 1609                                                   AS "DISTANCE_MILES"
FROM   home_depot hd
JOIN   lowes      lw
     ON 1 = 1         -- Cartesian join to compare every HD to every Lowe’s
QUALIFY ROW_NUMBER() OVER (PARTITION BY hd."HD_POI"
                           ORDER BY ST_DISTANCE(
                                  ST_POINT(hd."HD_LON", hd."HD_LAT"),
                                  ST_POINT(lw."LW_LON", lw."LW_LAT")
                           )
) = 1
LIMIT 20;
