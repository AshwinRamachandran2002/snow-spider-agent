WITH traces_filtered AS (   ---------------------------------------------------
    /* all traces before 2017‑01‑01, excluding delegate/callcode/staticcall */
    SELECT *
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
    WHERE "block_timestamp" < 1483228800000000
      AND ( "call_type" IS NULL
            OR UPPER("call_type") NOT IN ('DELEGATECALL','CALLCODE','STATICCALL') )
), success_calls AS (       ---------------------------------------------------
    SELECT *
    FROM traces_filtered
    WHERE "trace_type" = 'call' AND "status" = 1
), all_activity AS (        ---------------------------------------------------
    /* every appearance of an address (sender or receiver) */
    SELECT "from_address" AS address , "block_timestamp" FROM traces_filtered
    UNION ALL
    SELECT "to_address"   AS address , "block_timestamp" FROM traces_filtered
), activity_hourly AS (    ---------------------------------------------------
    /* stats needed for R_active_hour & active_days                       */
    SELECT
        address,
        COUNT(*)                                             AS activity_cnt,
        COUNT(DISTINCT FLOOR( ("block_timestamp"/1000000) / 86400 )) AS active_days,
        SUM( COS( 2*PI()*MOD(FLOOR(("block_timestamp"/1000000)/3600),24)/24 ) ) AS sum_cos,
        SUM( SIN( 2*PI()*MOD(FLOOR(("block_timestamp"/1000000)/3600),24)/24 ) ) AS sum_sin
    FROM all_activity
    WHERE address IS NOT NULL
    GROUP BY address
), r_hour AS (            ---------------------------------------------------
    SELECT
        address,
        CASE WHEN activity_cnt > 24
             THEN SQRT( (sum_cos*sum_cos + sum_sin*sum_sin) / activity_cnt )
        END AS R_active_hour,
        active_days
    FROM activity_hourly
), incoming AS (           ---------------------------------------------------
    /* incoming successful call traces                                    */
    SELECT
        "to_address"                         AS address,
        COUNT(*)                             AS in_trace_count,
        COUNT(DISTINCT "from_address")       AS in_addr_count,
        SUM(CASE WHEN "value" <> 0 THEN 1 END)               AS in_transfer_count,
        SUM("value")                         AS in_total_wei,
        AVG(CASE WHEN "value" <> 0 THEN "value" END)         AS in_avg_wei,
        AVG("gas_used")                      AS avg_gas_used,
        STDDEV_SAMP("gas_used")              AS std_gas_used
    FROM success_calls
    WHERE "to_address" IS NOT NULL
    GROUP BY "to_address"
), outgoing AS (           ---------------------------------------------------
    /* outgoing successful call traces                                    */
    SELECT
        "from_address"                       AS address,
        COUNT(*)                             AS out_trace_count,
        COUNT(DISTINCT "to_address")         AS out_addr_count,
        SUM(CASE WHEN "value" <> 0 THEN 1 END)               AS out_transfer_count,
        SUM("value")                         AS out_total_wei,
        AVG(CASE WHEN "value" <> 0 THEN "value" END)         AS out_avg_wei
    FROM success_calls
    WHERE "from_address" IS NOT NULL
    GROUP BY "from_address"
