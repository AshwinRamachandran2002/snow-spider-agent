    WHERE "block_timestamp" < 1483228800000000
      AND "receipt_status" = 1
    GROUP BY "from_address"
),
net_balance AS (
    SELECT
        b.address,
        (COALESCE(recv_wei,0) - COALESCE(sent_wei,0) - COALESCE(fee_wei,0))/1e18
            AS BALANCE
    FROM balance_base b
    LEFT JOIN fees f ON b.address = f.address
),
/* ------------------------------------------------------------------ */
/* ERC‑20 token transfers                                             */
token_in AS (
    SELECT
        "to_address"                         AS address,
        COUNT(*)                             AS TOKEN_IN_TNX,
        COUNT(DISTINCT "token_address")      AS TOKEN_IN_TYPE,
        COUNT(DISTINCT "from_address")       AS TOKEN_FROM_ADDR
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKEN_TRANSFERS
    WHERE "block_timestamp" < 1483228800000000
    GROUP BY "to_address"
),
token_out AS (
    SELECT
        "from_address"                       AS address,
        COUNT(*)                             AS TOKEN_OUT_TNX,
        COUNT(DISTINCT "token_address")      AS TOKEN_OUT_TYPE,
        COUNT(DISTINCT "to_address")         AS TOKEN_TO_ADDR
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKEN_TRANSFERS
    WHERE "block_timestamp" < 1483228800000000
    GROUP BY "from_address"
),
/* ------------------------------------------------------------------ */
/* Mining rewards & contract creation                                 */
rewards AS (
    SELECT
        "to_address"                         AS address,
        SUM("value")/1e18                    AS REWARD_AMOUNT
    FROM traces_filtered
    WHERE "trace_type" = 'reward'
    GROUP BY "to_address"
),
creates AS (
    SELECT
        "from_address"                       AS address,
        COUNT(*)                             AS CONTRACT_CREATE_COUNT
    FROM traces_filtered
    WHERE "trace_type" = 'create'
    GROUP BY "from_address"
),
/* ------------------------------------------------------------------ */
/* Failures                                                            */
failures AS (
    SELECT
        "from_address"                       AS address,
        COUNT(*)                             AS FAILURE_COUNT
    FROM traces_filtered
    WHERE "status" = 0
    GROUP BY "from_address"
),
/* ------------------------------------------------------------------ */
/* Bytecode size for created contracts                                 */
bytecode AS (
    SELECT
        t."from_address"                     AS address,
        AVG(LENGTH(c."bytecode"))            AS BYTECODE_SIZE
    FROM traces_filtered t
    JOIN ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.CONTRACTS c
      ON LOWER(c."address") = LOWER(t."to_address")
    WHERE t."trace_type" = 'create'
    GROUP BY t."from_address"
),
/* ------------------------------------------------------------------ */
/* Master address list                                                 */
address_union AS (
    SELECT address FROM net_balance
    UNION SELECT address FROM r_hour
    UNION SELECT address FROM incoming
    UNION SELECT address FROM outgoing
    UNION SELECT address FROM token_in
    UNION SELECT address FROM token_out
    UNION SELECT address FROM rewards
    UNION SELECT address FROM creates
    UNION SELECT address FROM failures
    UNION SELECT address FROM bytecode
)
/* ================================================================== */
/* Final report                                                        */
SELECT
    a.address                                                                          AS ADDRESS,
    ROUND(COALESCE(nb.BALANCE,0),4)                                                    AS BALANCE,
    ROUND(COALESCE(rh.R_ACTIVE_HOUR,0),4)                                              AS R_ACTIVE_HOUR,
    COALESCE(rh.ACTIVE_DAYS,0)                                                         AS ACTIVE_DAYS,
    COALESCE(inc.IN_TRACE_COUNT,0)                                                     AS IN_TRACE_COUNT,
    COALESCE(inc.IN_ADDR_COUNT,0)                                                      AS IN_ADDR_COUNT,
    COALESCE(inc.IN_TRANSFER_COUNT,0)                                                  AS IN_TRANSFER_COUNT,
    ROUND(COALESCE(inc.in_avg_wei,0)/1e18,4)                                           AS IN_AVG_AMOUNT,
    COALESCE(inc.AVG_GAS_USED,0)                                                       AS AVG_GAS_USED,
    COALESCE(inc.STD_GAS_USED,0)                                                       AS STD_GAS_USED,
    COALESCE(outg.OUT_TRACE_COUNT,0)                                                   AS OUT_TRACE_COUNT,
    COALESCE(outg.OUT_ADDR_COUNT,0)                                                    AS OUT_ADDR_COUNT,
    COALESCE(outg.OUT_TRANSFER_COUNT,0)                                                AS OUT_TRANSFER_COUNT,
    ROUND(COALESCE(outg.out_avg_wei,0)/1e18,4)                                         AS OUT_AVG_AMOUNT,
    COALESCE(ti.TOKEN_IN_TNX,0)                                                        AS TOKEN_IN_TNX,
    COALESCE(ti.TOKEN_IN_TYPE,0)                                                       AS TOKEN_IN_TYPE,
    COALESCE(ti.TOKEN_FROM_ADDR,0)                                                     AS TOKEN_FROM_ADDR,
    COALESCE(to1.TOKEN_OUT_TNX,0)                                                      AS TOKEN_OUT_TNX,
    COALESCE(to1.TOKEN_OUT_TYPE,0)                                                     AS TOKEN_OUT_TYPE,
    COALESCE(to1.TOKEN_TO_ADDR,0)                                                      AS TOKEN_TO_ADDR,
    ROUND(COALESCE(rw.REWARD_AMOUNT,0),4)                                              AS REWARD_AMOUNT,
    COALESCE(cr.CONTRACT_CREATE_COUNT,0)                                               AS CONTRACT_CREATE_COUNT,
    COALESCE(fl.FAILURE_COUNT,0)                                                       AS FAILURE_COUNT,
    COALESCE(bc.BYTECODE_SIZE,0)                                                       AS BYTECODE_SIZE
FROM address_union a
LEFT JOIN net_balance nb ON a.address = nb.address
LEFT JOIN r_hour      rh ON a.address = rh.address
LEFT JOIN incoming    inc ON a.address = inc.address
LEFT JOIN outgoing    outg ON a.address = outg.address
