```sql
--Description: The earlier query returned “No data found”, so first confirm whether the
--CONTRACTS table actually contains any rows.  A CTE (“t”) selects all records; the
--outer query then:
--  • shows the total number of rows in the table (COUNT(*) OVER()) to verify data presence,
--  • lists the first 20 contracts ordered by earliest "block_timestamp",
--  • displays each contract’s bytecode length for later analytics.
--If the table is empty, this query will also return no rows, definitively proving that
--no contract records are available.

WITH t AS (
  SELECT "address",
         "bytecode",
         "block_timestamp"
  FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."CONTRACTS"
)
SELECT
       COUNT(*) OVER()            AS total_rows_in_table,
       "address"                  AS contract_addr,
       LENGTH("bytecode")         AS bytecode_size,
       "block_timestamp"
FROM   t
ORDER  BY "block_timestamp"
LIMIT  20;
```
