```sql
--Description: Token transfers IN to each address before 2017, plus a row‑count sanity check
--to ensure data actually exists for the chosen time‑window.  The CTE “tt” contains all
--TOKEN_TRANSFERS records earlier than 2017‑01‑01; the outer query reports:
--  • total_rows_filtered  – number of rows that matched the filter,
--  • token_in_tnx         – count of incoming token transfers for each address,
--  • token_in_type        – number of distinct token contracts received.
WITH tt AS (
  SELECT "to_address",
         "token_address"
  FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
  WHERE  "block_timestamp" < 1483228800000000
)
SELECT
       COUNT(*) OVER()                     AS total_rows_filtered,
       "to_address",
       COUNT(*)                            AS token_in_tnx,
       COUNT(DISTINCT "token_address")     AS token_in_type
FROM   tt
GROUP  BY "to_address"
ORDER  BY token_in_tnx DESC
LIMIT  20;
```

```sql
--Description: Compute total transaction fees (gas_price × receipt_gas_used) paid by each
--sender before 2017‑01‑01, while confirming how many transactions satisfy the filter.
--The CTE “tx” pre‑selects successful transactions in the desired period; the outer
--query returns:
--  • total_rows_filtered – number of qualifying rows,
--  • total_fee_eth       – summed fee in Ether (Wei ÷ 1e18).
WITH tx AS (
  SELECT "from_address",
         "gas_price",
         "receipt_gas_used"
  FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRANSACTIONS"
  WHERE  "block_timestamp" < 1483228800000000
    AND  "receipt_status" = 1
)
SELECT
       COUNT(*) OVER()                              AS total_rows_filtered,
       "from_address",
       SUM("gas_price" * "receipt_gas_used") / 1e18 AS total_fee_eth
FROM   tx
GROUP  BY "from_address"
ORDER  BY total_fee_eth DESC
LIMIT  20;
```
