```sql
WITH traces_flt AS (
    SELECT *
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
    WHERE "block_timestamp" < 1483228800000000
      AND ( "call_type" IS NULL
            OR UPPER("call_type") NOT IN ('DELEGATECALL','CALLCODE','STATICCALL') )
),
succ_calls AS (
    SELECT *
    FROM traces_flt
    WHERE "trace_type" = 'call' AND "status" = 1
),
/* ------------------------------------------------------------------  ACTIVITY  */
act_union AS (
    SELECT "from_address" AS address , "block_timestamp" FROM traces_flt
    UNION ALL
    SELECT "to_address"   AS address , "block_timestamp" FROM traces_flt
),
act_stats AS (
    SELECT
        address,
        COUNT(*)                                                  AS activity_cnt,
        COUNT(DISTINCT FLOOR(("block_timestamp"/1000000)/86400))  AS active_days,
        SUM(COS(2*PI()*MOD(FLOOR(("block_timestamp"/1000000)/3600),24)/24)) AS sc,
        SUM(SIN(2*PI()*MOD(FLOOR(("block_timestamp"/1000000)/3600),24)/24)) AS ss
    FROM act_union
    WHERE address IS NOT NULL
    GROUP BY address
),
r_hour AS (
    SELECT
        address,
        CASE WHEN activity_cnt > 24
             THEN SQRT((sc*sc+ss*ss)/activity_cnt)
        END                                   AS R_ACTIVE_HOUR,
        active_days                           AS ACTIVE_DAYS
    FROM act_stats
),
/* ------------------------------------------------------------------  ETH FLOW  */
inc AS (
    SELECT
        "to_address"                       AS address,
        COUNT(*)                           AS IN_TRACE_COUNT,
        COUNT(DISTINCT "from_address")     AS IN_ADDR_COUNT,
        SUM(CASE WHEN "value" <> 0 THEN 1 END)         AS IN_TRANSFER_COUNT,
        SUM("value")                       AS in_total_wei,
        AVG(CASE WHEN "value" <> 0 THEN "value" END)   AS in_avg_wei,
        AVG("gas_used")                    AS AVG_GAS_USED,
        STDDEV_SAMP("gas_used")            AS STD_GAS_USED
    FROM succ_calls
    WHERE "to_address" IS NOT NULL
    GROUP BY "to_address"
),
out AS (
    SELECT
        "from_address"                     AS address,
        COUNT(*)                           AS OUT_TRACE_COUNT,
        COUNT(DISTINCT "to_address")       AS OUT_ADDR_COUNT,
        SUM(CASE WHEN "value" <> 0 THEN 1 END)         AS OUT_TRANSFER_COUNT,
        SUM("value")                       AS out_total_wei,
        AVG(CASE WHEN "value" <> 0 THEN "value" END)   AS out_avg_wei
    FROM succ_calls
    WHERE "from_address" IS NOT NULL
    GROUP BY "from_address"
),
bal_base AS (
    SELECT
        COALESCE(i.address,o.address) AS address,
        COALESCE(i.in_total_wei,0)    AS recv_wei,
        COALESCE(o.out_total_wei,0)   AS sent_wei
    FROM inc i
    FULL JOIN out o ON i.address=o.address
),
fees AS (
    SELECT
        "from_address"                       AS address,
        SUM("gas_price"*"receipt_gas_used")  AS fee_wei
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
    WHERE "block_timestamp" < 1483228800000000
      AND "receipt_status" = 1
    GROUP BY "from_address"
),
net_bal AS (
    SELECT
        b.address,
        (COALESCE(recv_wei,0)-COALESCE(sent_wei,0)-COALESCE(f.fee_wei,0))/1e18 AS BALANCE
    FROM bal_base b
    LEFT JOIN fees f ON b.address=f.address
),
/* ------------------------------------------------------------------  TOKENS  */
tin AS (
    SELECT
        "to_address"                     AS address,
        COUNT(*)                         AS TOKEN_IN_TNX,
        COUNT(DISTINCT "token_address")  AS TOKEN_IN_TYPE,
        COUNT(DISTINCT "from_address")   AS TOKEN_FROM_ADDR
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKEN_TRANSFERS
    WHERE "block_timestamp" < 1483228800000000
    GROUP BY "to_address"
),
tout AS (
    SELECT
        "from_address"                   AS address,
        COUNT(*)                         AS TOKEN_OUT_TNX,
        COUNT(DISTINCT "token_address")  AS TOKEN_OUT_TYPE,
        COUNT(DISTINCT "to_address")     AS TOKEN_TO_ADDR
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKEN_TRANSFERS
    WHERE "block_timestamp" < 1483228800000000
    GROUP BY "from_address"
),
/* ------------------------------------------------------------------  OTHER  */
rew AS (
    SELECT "to_address" AS address, SUM("value")/1e18 AS REWARD_AMOUNT
    FROM traces_flt
    WHERE "trace_type"='reward'
    GROUP BY "to_address"
),
cre AS (
    SELECT "from_address" AS address, COUNT(*) AS CONTRACT_CREATE_COUNT
    FROM traces_flt
    WHERE "trace_type"='create'
    GROUP BY "from_address"
),
fail AS (
    SELECT "from_address" AS address, COUNT(*) AS FAILURE_COUNT
    FROM traces_flt
    WHERE "status"=0
    GROUP BY "from_address"
),
bcode AS (
    SELECT t."from_address" AS address,
           AVG(LENGTH(c."bytecode")) AS BYTECODE_SIZE
    FROM traces_flt t
    JOIN ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.CONTRACTS c
      ON LOWER(c."address")=LOWER(t."to_address")
    WHERE t."trace_type"='create'
    GROUP BY t."from_address"
),
addr AS (
    SELECT address FROM net_bal
    UNION SELECT address FROM r_hour
    UNION SELECT address FROM inc
    UNION SELECT address FROM out
    UNION SELECT address FROM tin
    UNION SELECT address FROM tout
    UNION SELECT address FROM rew
    UNION SELECT address FROM cre
    UNION SELECT address FROM fail
    UNION SELECT address FROM bcode
)
SELECT
    a.address                                                        AS ADDRESS,
    ROUND(COALESCE(nb.BALANCE,0),4)                                  AS BALANCE,
    ROUND(COALESCE(r.R_ACTIVE_HOUR,0),4)                             AS R_ACTIVE_HOUR,
    COALESCE(r.ACTIVE_DAYS,0)                                        AS ACTIVE_DAYS,
    COALESCE(i.IN_TRACE_COUNT,0)                                     AS IN_TRACE_COUNT,
    COALESCE(i.IN_ADDR_COUNT,0)                                      AS IN_ADDR_COUNT,
    COALESCE(i.IN_TRANSFER_COUNT,0)                                  AS IN_TRANSFER_COUNT,
    ROUND(COALESCE(i.in_avg_wei,0)/1e18,4)                           AS IN_AVG_AMOUNT,
    COALESCE(i.AVG_GAS_USED,0)                                       AS AVG_GAS_USED,
    COALESCE(i.STD_GAS_USED,0)                                       AS STD_GAS_USED,
    COALESCE(o.OUT_TRACE_COUNT,0)                                    AS OUT_TRACE_COUNT,
    COALESCE(o.OUT_ADDR_COUNT,0)                                     AS OUT_ADDR_COUNT,
    COALESCE(o.OUT_TRANSFER_COUNT,0)                                 AS OUT_TRANSFER_COUNT,
    ROUND(COALESCE(o.out_avg_wei,0)/1e18,4)                          AS OUT_AVG_AMOUNT,
    COALESCE(ti.TOKEN_IN_TNX,0)                                      AS TOKEN_IN_TNX,
    COALESCE(ti.TOKEN_IN_TYPE,0)                                     AS TOKEN_IN_TYPE,
    COALESCE(ti.TOKEN_FROM_ADDR,0)                                   AS TOKEN_FROM_ADDR,
    COALESCE(to1.TOKEN_OUT_TNX,0)                                    AS TOKEN_OUT_TNX,
    COALESCE(to1.TOKEN_OUT_TYPE,0)                                   AS TOKEN_OUT_TYPE,
    COALESCE(to1.TOKEN_TO_ADDR,0)                                    AS TOKEN_TO_ADDR,
    ROUND(COALESCE(rw.REWARD_AMOUNT,0),4)                            AS REWARD_AMOUNT,
    COALESCE(cr.CONTRACT_CREATE_COUNT,0)                             AS CONTRACT_CREATE_COUNT,
    COALESCE(fl.FAILURE_COUNT,0)                                     AS FAILURE_COUNT,
    COALESCE(bc.BYTECODE_SIZE,0)                                     AS BYTECODE_SIZE
FROM addr a
LEFT JOIN net_bal  nb ON a.address=nb.address
LEFT JOIN r_hour   r  ON a.address=r.address
LEFT JOIN inc      i  ON a.address=i.address
LEFT JOIN out      o  ON a.address=o.address
LEFT JOIN tin      ti ON a.address=ti.address
LEFT JOIN tout     to1 ON a.address=to1.address
LEFT JOIN rew      rw ON a.address=rw.address
LEFT JOIN cre      cr ON a.address=cr.address
LEFT JOIN fail     fl ON a.address=fl.address
LEFT JOIN bcode    bc ON a.address=bc.address;
```
