Query:
--Description: The previous fee‑calculation query might return no rows if the
--TRANSACTIONS table lacks records earlier than 2017‑01‑01.  To verify data
--presence and still calculate sender‑side gas fees, drop the timestamp
--filter and keep only successful transactions (receipt_status = 1).  
--The CTE “tx” gathers those rows; the outer query:
--  • total_rows_in_table – sanity‑check of how many successful txns exist,
--  • total_fee_eth       – sum of gas_price × receipt_gas_used (converted from
--    Wei to Ether) per sender,
--  • lists the 20 addresses that have paid the highest total fees.

WITH tx AS (
  SELECT
         "from_address",
         "gas_price",
         "receipt_gas_used"
  FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRANSACTIONS"
  WHERE  "receipt_status" = 1
)
SELECT
       COUNT(*) OVER()                              AS total_rows_in_table,
       "from_address",
       SUM("gas_price" * "receipt_gas_used") / 1e18 AS total_fee_eth
FROM   tx
GROUP  BY "from_address"
ORDER  BY total_fee_eth DESC
LIMIT  20
