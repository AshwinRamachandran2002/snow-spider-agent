```sql
WITH traces_filtered AS (   ---------------------------------------------------
    /* all traces before 2017‑01‑01, excluding delegate/callcode/staticcall */
    SELECT *
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
    WHERE "block_timestamp" < 1483228800000000
      AND ( "call_type" IS NULL
            OR UPPER("call_type") NOT IN ('DELEGATECALL','CALLCODE','STATICCALL') )
), success_calls AS (       ---------------------------------------------------
    SELECT *
    FROM traces_filtered
    WHERE "trace_type" = 'call' AND "status" = 1
), all_activity AS (        ---------------------------------------------------
    /* every appearance of an address (sender or receiver) */
    SELECT "from_address" AS address , "block_timestamp" FROM traces_filtered
    UNION ALL
    SELECT "to_address"   AS address , "block_timestamp" FROM traces_filtered
), activity_hourly AS (    ---------------------------------------------------
    /* stats needed for R_active_hour & active_days                       */
    SELECT
        address,
        COUNT(*)                                             AS activity_cnt,
        COUNT(DISTINCT FLOOR( ("block_timestamp"/1000000) / 86400 )) AS active_days,
        SUM( COS( 2*PI()*MOD(FLOOR(("block_timestamp"/1000000)/3600),24)/24 ) ) AS sum_cos,
        SUM( SIN( 2*PI()*MOD(FLOOR(("block_timestamp"/1000000)/3600),24)/24 ) ) AS sum_sin
    FROM all_activity
    WHERE address IS NOT NULL
    GROUP BY address
), r_hour AS (            ---------------------------------------------------
    SELECT
        address,
        CASE WHEN activity_cnt > 24
             THEN SQRT( (sum_cos*sum_cos + sum_sin*sum_sin) / activity_cnt )
        END AS R_active_hour,
        active_days
    FROM activity_hourly
), incoming AS (           ---------------------------------------------------
    /* incoming successful call traces                                    */
    SELECT
        "to_address"                         AS address,
        COUNT(*)                             AS in_trace_count,
        COUNT(DISTINCT "from_address")       AS in_addr_count,
        SUM(CASE WHEN "value" <> 0 THEN 1 END)               AS in_transfer_count,
        SUM("value")                         AS in_total_wei,
        AVG(CASE WHEN "value" <> 0 THEN "value" END)         AS in_avg_wei,
        AVG("gas_used")                      AS avg_gas_used,
        STDDEV_SAMP("gas_used")              AS std_gas_used
    FROM success_calls
    WHERE "to_address" IS NOT NULL
    GROUP BY "to_address"
), outgoing AS (           ---------------------------------------------------
    /* outgoing successful call traces                                    */
    SELECT
        "from_address"                       AS address,
        COUNT(*)                             AS out_trace_count,
        COUNT(DISTINCT "to_address")         AS out_addr_count,
        SUM(CASE WHEN "value" <> 0 THEN 1 END)               AS out_transfer_count,
        SUM("value")                         AS out_total_wei,
        AVG(CASE WHEN "value" <> 0 THEN "value" END)         AS out_avg_wei
    FROM success_calls
    WHERE "from_address" IS NOT NULL
    GROUP BY "from_address"
), balance_base AS (       ---------------------------------------------------
    /* ETH received minus sent (no fee yet)                               */
    SELECT
        COALESCE(i.address, o.address)                           AS address,
        COALESCE(i.in_total_wei , 0)                             AS recv_wei,
        COALESCE(o.out_total_wei, 0)                             AS sent_wei
    FROM incoming i
    FULL OUTER JOIN outgoing o ON i.address = o.address
), fees AS (               ---------------------------------------------------
    /* gas fee per sender from TRANSACTIONS                              */
    SELECT
        "from_address"                           AS address,
        SUM("gas_price" * "receipt_gas_used")    AS fee_wei
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
    WHERE "block_timestamp" < 1483228800000000
      AND "receipt_status" = 1
    GROUP BY "from_address"
), net_balance AS (        ---------------------------------------------------
    SELECT
        b.address,
        ( COALESCE(recv_wei,0) - COALESCE(sent_wei,0) - COALESCE(f.fee_wei,0) )
          / 1e18                                             AS balance
    FROM balance_base b
    LEFT JOIN fees f ON b.address = f.address
), token_in AS (           ---------------------------------------------------
    SELECT
        "to_address"                         AS address,
        COUNT(*)                             AS token_in_tnx,
        COUNT(DISTINCT "token_address")      AS token_in_type,
        COUNT(DISTINCT "from_address")       AS token_from_addr
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKEN_TRANSFERS
    WHERE "block_timestamp" < 1483228800000000
    GROUP BY "to_address"
), token_out AS (          ---------------------------------------------------
    SELECT
        "from_address"                       AS address,
        COUNT(*)                             AS token_out_tnx,
        COUNT(DISTINCT "token_address")      AS token_out_type,
        COUNT(DISTINCT "to_address")         AS token_to_addr
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKEN_TRANSFERS
    WHERE "block_timestamp" < 1483228800000000
    GROUP BY "from_address"
), rewards AS (            ---------------------------------------------------
    SELECT
        "to_address"                         AS address,
        SUM("value") / 1e18                  AS reward_amount
    FROM traces_filtered
    WHERE "trace_type" = 'reward'
    GROUP BY "to_address"
), creates AS (            ---------------------------------------------------
    SELECT
        "from_address"                       AS address,
        COUNT(*)                             AS contract_create_count
    FROM traces_filtered
    WHERE "trace_type" = 'create'
    GROUP BY "from_address"
), failures AS (           ---------------------------------------------------
    SELECT
        "from_address"                       AS address,
        COUNT(*)                             AS failure_count
    FROM traces_filtered
    WHERE "status" = 0
    GROUP BY "from_address"
), bytecode AS (           ---------------------------------------------------
    /* average bytecode length of contracts each creator deployed         */
    SELECT
        t."from_address"                     AS address,
        AVG(LENGTH(c."bytecode"))            AS bytecode_size
    FROM traces_filtered t
    JOIN ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.CONTRACTS c
      ON LOWER(c."address") = LOWER(t."to_address")
    WHERE t."trace_type" = 'create'
    GROUP BY t."from_address"
), address_union AS (      ---------------------------------------------------
    /* master list of addresses that appear in any sub‑result             */
    SELECT address FROM net_balance
    UNION SELECT address FROM r_hour
    UNION SELECT address FROM incoming
    UNION SELECT address FROM outgoing
    UNION SELECT address FROM token_in
    UNION SELECT address FROM token_out
    UNION SELECT address FROM rewards
    UNION SELECT address FROM creates
    UNION SELECT address FROM failures
    UNION SELECT address FROM bytecode
) ---------------------------------------------------------------------------
SELECT
