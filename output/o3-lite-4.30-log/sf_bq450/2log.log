WITH
    /* -------------------------------------------------
       Constant : 2017‑01‑01 UTC expressed in µ‑seconds
    ------------------------------------------------- */
    params AS (
        SELECT 1483228800000000::NUMBER AS cutoff_ts
    ),

    /* -------------------------------------------------
       1.  Successful internal traces (exclude delegate*)
    ------------------------------------------------- */
    traces_filtered AS (
        SELECT
            "block_timestamp",
            "trace_type",
            "call_type",
            "value",
            "gas_used",
            "from_address",
            "to_address"
        FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TRACES", params
        WHERE "block_timestamp" < cutoff_ts
          AND "status" = 1
          AND ( "call_type" IS NULL
                OR "call_type" NOT IN ('delegatecall','callcode','staticcall') )
    ),

    /* -------------------------------------------------
       2.  Incoming / outgoing trace statistics
    ------------------------------------------------- */
    in_traces AS (
        SELECT
            "to_address"                           AS address,
            COUNT(*)                               AS in_trace_count,
            COUNT(DISTINCT "from_address")         AS in_addr_count,
            COUNT_IF("value" <> 0)                 AS in_transfer_count,
            AVG("value" / 1e18)                    AS in_avg_amount,
            SUM("value") / 1e18                    AS incoming_eth
        FROM traces_filtered
        GROUP BY "to_address"
    ),
    out_traces AS (
        SELECT
            "from_address"                         AS address,
            COUNT(*)                               AS out_trace_count,
            COUNT(DISTINCT "to_address")           AS out_addr_count,
            COUNT_IF("value" <> 0)                 AS out_transfer_count,
            AVG("value" / 1e18)                    AS out_avg_amount,
            SUM("value") / 1e18                    AS outgoing_eth
        FROM traces_filtered
        GROUP BY "from_address"
    ),

    /* -------------------------------------------------
       3.  Gas statistics for incoming CALL traces
    ------------------------------------------------- */
    gas_stats AS (
        SELECT
            "to_address"                           AS address,
            AVG("gas_used")                        AS avg_gas_used,
            STDDEV_SAMP("gas_used")                AS std_gas_used
        FROM traces_filtered
        WHERE "trace_type" = 'call'
        GROUP BY "to_address"
    ),

    /* -------------------------------------------------
       4.  Mining rewards
    ------------------------------------------------- */
    reward_agg AS (
        SELECT
            "to_address"                           AS address,
            SUM("value") / 1e18                    AS reward_amount
        FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TRACES", params
        WHERE "trace_type" = 'reward'
          AND "block_timestamp" < cutoff_ts
        GROUP BY "to_address"
    ),

    /* -------------------------------------------------
       5.  Contract creations & byte‑code size
    ------------------------------------------------- */
    create_traces AS (
        SELECT
            "from_address",
            "to_address"
        FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TRACES", params
        WHERE "trace_type" = 'create'
          AND "status" = 1
          AND "block_timestamp" < cutoff_ts
    ),
    contract_create AS (
        SELECT
            "from_address"                         AS address,
            COUNT(*)                               AS contract_create_count
        FROM create_traces
        GROUP BY "from_address"
    ),
    bytecode_agg AS (
        SELECT
            ct."from_address"                      AS address,
            AVG(LENGTH(c."bytecode"))              AS bytecode_size
        FROM create_traces              ct
        JOIN ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."CONTRACTS" c
            ON c."address" = ct."to_address"
        JOIN params
            ON c."block_timestamp" < cutoff_ts
        GROUP BY ct."from_address"
    ),

    /* -------------------------------------------------
       6.  Failed external transactions
    ------------------------------------------------- */
    failure_agg AS (
        SELECT
            "from_address"                         AS address,
            COUNT(*)                               AS failure_count
        FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TRANSACTIONS", params
        WHERE "receipt_status" = 0
          AND "block_timestamp" < cutoff_ts
        GROUP BY "from_address"
    ),

    /* -------------------------------------------------
       7.  Gas fees paid in successful external txns
    ------------------------------------------------- */
    gas_fee AS (
        SELECT
            "from_address"                         AS address,
            SUM("receipt_gas_used" * "gas_price") / 1e18  AS gas_fee_eth
        FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TRANSACTIONS", params
        WHERE "receipt_status" = 1
          AND "block_timestamp" < cutoff_ts
        GROUP BY "from_address"
    ),

    /* -------------------------------------------------
       8.  ERC‑20 / ERC‑721 token transfers
    ------------------------------------------------- */
    tk_transfers AS (
        SELECT *
        FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS", params
        WHERE "block_timestamp" < cutoff_ts
    ),
    token_in AS (
        SELECT
            "to_address"                           AS address,
            COUNT(*)                               AS token_in_tnx,
            COUNT(DISTINCT "token_address")        AS token_in_type,
            COUNT(DISTINCT "from_address")         AS token_from_addr
        FROM tk_transfers
        GROUP BY "to_address"
    ),
    token_out AS (
        SELECT
            "from_address"                         AS address,
            COUNT(*)                               AS token_out_tnx,
            COUNT(DISTINCT "token_address")        AS token_out_type,
            COUNT(DISTINCT "to_address")           AS token_to_addr
        FROM tk_transfers
        GROUP BY "from_address"
    ),

    /* -------------------------------------------------
       9.  Activity, active days & R_active_hour
    ------------------------------------------------- */
    activities AS (
        SELECT
            adr,
            ts_micro,
            TO_TIMESTAMP(ts_micro / 1e6)           AS ts
        FROM (
            SELECT "from_address" AS adr, "block_timestamp" AS ts_micro FROM traces_filtered WHERE "from_address" IS NOT NULL
            UNION ALL
            SELECT "to_address"   AS adr, "block_timestamp" AS ts_micro FROM traces_filtered WHERE "to_address"   IS NOT NULL
        )
    ),
    activity_stats AS (
        SELECT
            adr                                     AS address,
            COUNT(*)                                AS total_activities,
            COUNT(DISTINCT DATE_TRUNC('day', ts))   AS active_days,
            AVG(COS(2 * PI() * EXTRACT(hour FROM ts) / 24)) AS avg_cos,
            AVG(SIN(2 * PI() * EXTRACT(hour FROM ts) / 24)) AS avg_sin
        FROM activities
        GROUP BY adr
    ),
    activity_final AS (
        SELECT
            address,
            CASE
                WHEN total_activities > 24
                THEN SQRT( POW(avg_cos, 2) + POW(avg_sin, 2) )
            END                                     AS R_active_hour,
            active_days
        FROM activity_stats
    ),

    /* -------------------------------------------------
       10.  Universe of addresses having any activity
    ------------------------------------------------- */
    all_addresses AS (
        SELECT address FROM in_traces            UNION
        SELECT address FROM out_traces           UNION
        SELECT address FROM reward_agg           UNION
        SELECT address FROM contract_create      UNION
        SELECT address FROM failure_agg          UNION
        SELECT address FROM token_in             UNION
        SELECT address FROM token_out
    )

/* -----------------------------------------------------
   11.  Final report
----------------------------------------------------- */
SELECT
    a.address                                                     AS "address",

    /* ----- Balance (ETH) ------------------------------------- */
    COALESCE(
        COALESCE(in_traces.incoming_eth, 0)
      + COALESCE(reward_agg.reward_amount, 0)
      - COALESCE(out_traces.outgoing_eth, 0)
      - COALESCE(gas_fee.gas_fee_eth, 0)
    , 0)                                                          AS "balance",

    /* ----- Activity metrics ---------------------------------- */
    activity_final.R_active_hour                                  AS "R_active_hour",
    COALESCE(activity_final.active_days, 0)                       AS "active_days",

    /* ----- Incoming traces ----------------------------------- */
    COALESCE(in_traces.in_trace_count,     0)                     AS "in_trace_count",
    COALESCE(in_traces.in_addr_count,      0)                     AS "in_addr_count",
    COALESCE(in_traces.in_transfer_count,  0)                     AS "in_transfer_count",
    COALESCE(in_traces.in_avg_amount,      0)                     AS "in_avg_amount",
    COALESCE(gas_stats.avg_gas_used,       0)                     AS "avg_gas_used",
    COALESCE(gas_stats.std_gas_used,       0)                     AS "std_gas_used",

    /* ----- Outgoing traces ----------------------------------- */
    COALESCE(out_traces.out_trace_count,    0)                    AS "out_trace_count",
    COALESCE(out_traces.out_addr_count,     0)                    AS "out_addr_count",
    COALESCE(out_traces.out_transfer_count, 0)                    AS "out_transfer_count",
    COALESCE(out_traces.out_avg_amount,     0)                    AS "out_avg_amount",

    /* ----- Token transfers ----------------------------------- */
    COALESCE(token_in.token_in_tnx,     0)                        AS "token_in_tnx",
    COALESCE(token_in.token_in_type,    0)                        AS "token_in_type",
    COALESCE(token_in.token_from_addr,  0)                        AS "token_from_addr",

    COALESCE(token_out.token_out_tnx,   0)                        AS "token_out_tnx",
    COALESCE(token_out.token_out_type,  0)                        AS "token_out_type",
    COALESCE(token_out.token_to_addr,   0)                        AS "token_to_addr",

