            "call_type",
            "value",
            "gas_used",
            "from_address",
            "to_address"
    FROM    ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TRACES", params
    WHERE   "status" = 1
      AND   "block_timestamp" < cutoff_ts
      AND  ( "call_type" IS NULL
             OR "call_type" NOT IN ('delegatecall','callcode','staticcall') )
),

/* -------------------------------------------------
   3.  incoming / outgoing ETH (pre‑2017 internal traces)
------------------------------------------------- */
tr_in AS (
    SELECT  "to_address"                         AS address,
            COUNT(*)                             AS in_trace_count,
            COUNT(DISTINCT "from_address")       AS in_addr_count,
            COUNT_IF("value" <> 0)               AS in_transfer_count,
            ROUND(AVG("value"/1e18),4)           AS in_avg_amount,
            SUM("value")/1e18                    AS eth_in
    FROM    traces_ok
    GROUP BY "to_address"
),
tr_out AS (
    SELECT  "from_address"                       AS address,
            COUNT(*)                             AS out_trace_count,
            COUNT(DISTINCT "to_address")         AS out_addr_count,
            COUNT_IF("value" <> 0)               AS out_transfer_count,
            ROUND(AVG("value"/1e18),4)           AS out_avg_amount,
            SUM("value")/1e18                    AS eth_out
    FROM    traces_ok
    GROUP BY "from_address"
),

/* -------------------------------------------------
   4.  gas statistics for incoming CALL traces (pre‑2017)
------------------------------------------------- */
gas_stat AS (
    SELECT  "to_address"                         AS address,
            ROUND(AVG("gas_used"),4)             AS avg_gas_used,
            ROUND(STDDEV_SAMP("gas_used"),4)     AS std_gas_used
    FROM    traces_ok
    WHERE   "trace_type" = 'call'
    GROUP BY "to_address"
),

/* -------------------------------------------------
   5.  mining rewards  (pre‑2017)
------------------------------------------------- */
rewards AS (
    SELECT  "to_address"                         AS address,
            ROUND(SUM("value")/1e18,4)           AS reward_amount
    FROM    ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TRACES", params
    WHERE   "trace_type" = 'reward'
      AND   "block_timestamp" < cutoff_ts
    GROUP BY "to_address"
),

/* -------------------------------------------------
   6.  contract creations (all time)  & byte‑code size
------------------------------------------------- */
crt AS (
    SELECT  "from_address"                       AS creator,
            "to_address"                         AS contract_addr
    FROM    ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TRACES"
    WHERE   "trace_type" = 'create'
      AND   "status" = 1
),
crt_cnt AS (
    SELECT  creator                              AS address,
            COUNT(*)                             AS contract_create_count
    FROM    crt
    GROUP BY creator
),
byte_sz AS (
    SELECT  c.creator                            AS address,
            ROUND(AVG(LENGTH(ct."bytecode")),4)  AS bytecode_size
    FROM    crt                     c
    JOIN    ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."CONTRACTS" ct
            ON ct."address" = c.contract_addr
    GROUP BY c.creator
),

/* -------------------------------------------------
   7.  failed external transactions (all time)
------------------------------------------------- */
fail_tx AS (
    SELECT  "from_address"                       AS address,
            COUNT(*)                             AS failure_count
    FROM    ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TRANSACTIONS"
    WHERE   "receipt_status" = 0
    GROUP BY "from_address"
),

/* -------------------------------------------------
   8.  gas fees paid in successful external tx (all time)
------------------------------------------------- */
fee_tx AS (
    SELECT  "from_address"                       AS address,
            SUM("receipt_gas_used" * "gas_price")/1e18  AS gas_fee_eth
    FROM    ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TRANSACTIONS"
    WHERE   "receipt_status" = 1
    GROUP BY "from_address"
),

/* -------------------------------------------------
   9.  token transfers (all time)
------------------------------------------------- */
tk AS (
    SELECT * 
    FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"
),
tk_in AS (
    SELECT  "to_address"                         AS address,
            COUNT(*)                             AS token_in_tnx,
            COUNT(DISTINCT "token_address")      AS token_in_type,
            COUNT(DISTINCT "from_address")       AS token_from_addr
    FROM    tk
    GROUP BY "to_address"
),
tk_out AS (
    SELECT  "from_address"                       AS address,
            COUNT(*)                             AS token_out_tnx,
            COUNT(DISTINCT "token_address")      AS token_out_type,
            COUNT(DISTINCT "to_address")         AS token_to_addr
    FROM    tk
    GROUP BY "from_address"
),

/* -------------------------------------------------
   10.  activity metrics (pre‑2017)
------------------------------------------------- */
acts AS (
    SELECT  adr,
            TO_TIMESTAMP("block_timestamp"/1e6)  AS ts
    FROM   (
            SELECT "from_address" AS adr, "block_timestamp" FROM traces_ok WHERE "from_address" IS NOT NULL
            UNION ALL
            SELECT "to_address"   AS adr, "block_timestamp" FROM traces_ok WHERE "to_address"   IS NOT NULL
    )
),
act_calc AS (
    SELECT  adr                                   AS address,
            COUNT(*)                              AS tot_act,
            COUNT(DISTINCT DATE_TRUNC('day',ts))  AS active_days,
            AVG(COS(2*PI()*EXTRACT(hour FROM ts)/24)) AS c,
            AVG(SIN(2*PI()*EXTRACT(hour FROM ts)/24)) AS s
    FROM    acts
    GROUP BY adr
),
act_final AS (
    SELECT  address,
            active_days,
            ROUND( IFF(tot_act>24,SQRT(c*c + s*s),0) ,4) AS R_active_hour
    FROM    act_calc
),

/* -------------------------------------------------
   11.  addresses with ANY pre‑2017 activity
------------------------------------------------- */
active_addr AS (
    SELECT address FROM tr_in
    UNION
    SELECT address FROM tr_out
    UNION
    SELECT address FROM rewards
)

/* -------------------------------------------------
   12.  final assemble
------------------------------------------------- */
SELECT
    a.address                                                      AS address,

    /* balance (ETH) */
    ROUND(
        COALESCE(tr_in.eth_in ,0)
      - COALESCE(tr_out.eth_out,0)
      - COALESCE(fee_tx.gas_fee_eth,0)
      + COALESCE(rewards.reward_amount,0)
    ,4)                                                            AS balance,

    /* activity */
    COALESCE(act_final.R_active_hour,0)                            AS R_active_hour,
    COALESCE(act_final.active_days ,0)                             AS active_days,

    /* incoming ETH traces */
    COALESCE(tr_in.in_trace_count ,0)                              AS in_trace_count,
    COALESCE(tr_in.in_addr_count  ,0)                              AS in_addr_count,
    COALESCE(tr_in.in_transfer_count,0)                            AS in_transfer_count,
    COALESCE(tr_in.in_avg_amount ,0)                               AS in_avg_amount,
    COALESCE(gas_stat.avg_gas_used,0)                              AS avg_gas_used,
    COALESCE(gas_stat.std_gas_used,0)                              AS std_gas_used,

    /* outgoing ETH traces */
    COALESCE(tr_out.out_trace_count ,0)                            AS out_trace_count,
    COALESCE(tr_out.out_addr_count  ,0)                            AS out_addr_count,
    COALESCE(tr_out.out_transfer_count,0)                          AS out_transfer_count,
    COALESCE(tr_out.out_avg_amount ,0)                             AS out_avg_amount,

    /* token interactions */
    COALESCE(tk_in.token_in_tnx ,0)                                AS token_in_tnx,
    COALESCE(tk_in.token_in_type,0)                                AS token_in_type,
    COALESCE(tk_in.token_from_addr,0)                              AS token_from_addr,
    COALESCE(tk_out.token_out_tnx ,0)                              AS token_out_tnx,
    COALESCE(tk_out.token_out_type,0)                              AS token_out_type,
    COALESCE(tk_out.token_to_addr ,0)                              AS token_to_addr,

    /* mining / contracts / failures / bytecode */
    COALESCE(rewards.reward_amount ,0)                             AS reward_amount,
    COALESCE(crt_cnt.contract_create_count,0)                      AS contract_create_count,
    COALESCE(fail_tx.failure_count ,0)                             AS failure_count,
    COALESCE(byte_sz.bytecode_size ,0)                             AS bytecode_size

FROM active_addr      a
LEFT JOIN tr_in       ON a.address = tr_in.address
LEFT JOIN tr_out      ON a.address = tr_out.address
LEFT JOIN gas_stat    ON a.address = gas_stat.address
LEFT JOIN rewards     ON a.address = rewards.address
LEFT JOIN crt_cnt     ON a.address = crt_cnt.address
LEFT JOIN byte_sz     ON a.address = byte_sz.address
LEFT JOIN fail_tx     ON a.address = fail_tx.address
LEFT JOIN fee_tx      ON a.address = fee_tx.address
LEFT JOIN tk_in       ON a.address = tk_in.address
LEFT JOIN tk_out      ON a.address = tk_out.address
LEFT JOIN act_final   ON a.address = act_final.address;
