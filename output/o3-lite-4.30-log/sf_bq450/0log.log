Exploratory SQL queries (LIMIT 20 each)  
---------------------------------------

```sql
-- 1. Description: Sample of pre‑2017 successful call traces that transfer a non‑zero amount
SELECT 
    "block_timestamp",
    "from_address",
    "to_address",
    "value"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE "block_timestamp" < 1483228800000000
  AND "trace_type" = 'call'
  AND ("call_type" IS NULL OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))
  AND "status" = 1
  AND "value" <> 0
LIMIT 20;
```

```sql
-- 2. Description: Distinct addresses that received mining rewards before 2017
SELECT DISTINCT
    "to_address" AS "miner_address"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE "block_timestamp" < 1483228800000000
  AND "trace_type" = 'reward'
LIMIT 20;
```

```sql
-- 3. Description: Examples of contracts created before 2017 with their bytecode length
SELECT 
    "address",
    LENGTH("bytecode") AS "bytecode_size"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.CONTRACTS
WHERE "block_timestamp" < 1483228800000000
ORDER BY "bytecode_size" DESC
LIMIT 20;
```

```sql
-- 4. Description: Failed outgoing traces (status = 0) before 2017
SELECT 
    "from_address",
    "to_address",
    "error",
    "value"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE "block_timestamp" < 1483228800000000
  AND "status" = 0
LIMIT 20;
```

```sql
-- 5. Description: Token transfers received by addresses before 2017
SELECT 
    "to_address",
    "token_address",
    "value",
    "block_timestamp"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKEN_TRANSFERS
WHERE "block_timestamp" < 1483228800000000
LIMIT 20;
```

```sql
-- 6. Description: Count of unique token types each address sent before 2017 (top 20)
SELECT 
    "from_address",
    COUNT(DISTINCT "token_address") AS "sent_token_types"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKEN_TRANSFERS
WHERE "block_timestamp" < 1483228800000000
GROUP BY "from_address"
ORDER BY "sent_token_types" DESC
LIMIT 20;
```

```sql
-- 7. Description: Average and standard deviation of gas_used for incoming call traces to each address (simple sample)
SELECT 
    "to_address",
    AVG("gas_used") AS "avg_gas_used",
    STDDEV("gas_used") AS "std_gas_used"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE "block_timestamp" < 1483228800000000
  AND "trace_type" = 'call'
  AND ("call_type" IS NULL OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))
  AND "status" = 1
GROUP BY "to_address"
LIMIT 20;
```

```sql
-- 8. Description: Daily activity count for a sample address (replace <ADDR> with real address)
SELECT 
    FLOOR("block_timestamp"/86400000000) AS "day_bucket",  -- rough day bucket (micro‑sec / 86 400 000 000)
    COUNT(*) AS "tx_count"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE "block_timestamp" < 1483228800000000
  AND ("from_address" = '<ADDR>' OR "to_address" = '<ADDR>')
GROUP BY "day_bucket"
ORDER BY "day_bucket"
LIMIT 20;
```

```sql
-- 9. Description: Contract creation count per creator address before 2017
SELECT 
    "from_address" AS "creator",
    COUNT(*) AS "contract_create_count"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE "block_timestamp" < 1483228800000000
  AND "trace_type" = 'create'
GROUP BY "from_address"
ORDER BY "contract_create_count" DESC
LIMIT 20;
```

```sql
-- 10. Description: Net ETH received (incoming minus outgoing) per address before 2017 using traces (ignoring fees for now)
SELECT 
    addr,
    (SUM(CASE WHEN dir = 'in'  THEN val ELSE 0 END) -
     SUM(CASE WHEN dir = 'out' THEN val ELSE 0 END)) / 1e18 AS "net_balance_eth"
FROM (
    SELECT "to_address"   AS addr, "value" AS val, 'in'  AS dir
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
    WHERE "block_timestamp" < 1483228800000000
      AND "trace_type" = 'call'
      AND ("call_type" IS NULL OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))
      AND "status" = 1
      AND "value" <> 0

    UNION ALL

    SELECT "from_address" AS addr, "value" AS val, 'out' AS dir
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
    WHERE "block_timestamp" < 1483228800000000
      AND "trace_type" = 'call'
      AND ("call_type" IS NULL OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))
      AND "status" = 1
      AND "value" <> 0
) t
GROUP BY addr
LIMIT 20;
```

