/* ===============================================================
   Comprehensive address‑level report (activity before 2017‑01‑01)
   ===============================================================*/
WITH traces_call AS (   -- successful normal CALL traces
    SELECT
        "block_timestamp",
        "from_address",
        "to_address",
        "value",
        "gas_used"
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
    WHERE "block_timestamp" < 1483228800000000                -- < 2017‑01‑01 (µs)
      AND "trace_type" = 'call'
      AND "status" = 1
      AND ("call_type" IS NULL OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))
),  /* ---------- incoming statistics ---------- */
incoming AS (
    SELECT
        "to_address"                                         AS address,
        COUNT(*)                                             AS in_trace_count,
        COUNT(DISTINCT "from_address")                       AS in_addr_count,
        COUNT_IF("value" <> 0)                               AS in_transfer_count,
        AVG(CASE WHEN "value" <> 0 THEN "value" END)         AS in_avg_amount_wei,
        AVG("gas_used")                                      AS avg_gas_used,
        STDDEV_SAMP("gas_used")                              AS std_gas_used,
        SUM("value")                                         AS in_wei
    FROM traces_call
    GROUP BY "to_address"
),  /* ---------- outgoing statistics ---------- */
outgoing AS (
    SELECT
        "from_address"                                       AS address,
        COUNT(*)                                             AS out_trace_count,
        COUNT(DISTINCT "to_address")                         AS out_addr_count,
        COUNT_IF("value" <> 0)                               AS out_transfer_count,
        AVG(CASE WHEN "value" <> 0 THEN "value" END)         AS out_avg_amount_wei,
        SUM("value")                                         AS out_wei
    FROM traces_call
    GROUP BY "from_address"
),  /* ---------- hourly activity & active days ---------- */
activity AS (
    SELECT
        addr                                                 AS address,
        COUNT(*)                                             AS activity_count,
        COUNT(DISTINCT TO_DATE(TO_TIMESTAMP("block_timestamp"/1000000))) AS active_days,
        SUM(COS((2*PI())*hr/24))                             AS sum_cos,
        SUM(SIN((2*PI())*hr/24))                             AS sum_sin
    FROM (
        SELECT  "from_address" AS addr,
                "block_timestamp",
                DATE_PART('HOUR', TO_TIMESTAMP("block_timestamp"/1000000)) AS hr
        FROM traces_call
        UNION ALL
        SELECT  "to_address"   AS addr,
                "block_timestamp",
                DATE_PART('HOUR', TO_TIMESTAMP("block_timestamp"/1000000)) AS hr
        FROM traces_call
    ) t
    GROUP BY addr
),  /* ---------- ERC‑20/ERC‑721 token transfers ---------- */
token_in AS (
    SELECT
        "to_address"                                         AS address,
        COUNT(*)                                             AS token_in_tnx,
        COUNT(DISTINCT "token_address")                      AS token_in_type,
        COUNT(DISTINCT "from_address")                       AS token_from_addr
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKEN_TRANSFERS
    WHERE "block_timestamp" < 1483228800000000
    GROUP BY "to_address"
),
token_out AS (
    SELECT
        "from_address"                                       AS address,
        COUNT(*)                                             AS token_out_tnx,
        COUNT(DISTINCT "token_address")                      AS token_out_type,
        COUNT(DISTINCT "to_address")                         AS token_to_addr
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKEN_TRANSFERS
    WHERE "block_timestamp" < 1483228800000000
    GROUP BY "from_address"
),  /* ---------- mining rewards ---------- */
rewards AS (
    SELECT
        "to_address"                                         AS address,
        SUM("value")                                         AS reward_wei
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
    WHERE "block_timestamp" < 1483228800000000
      AND "trace_type" = 'reward'
    GROUP BY "to_address"
),  /* ---------- contract creations ---------- */
creates AS (
    SELECT
        "from_address"                                       AS address,
        COUNT(*)                                             AS contract_create_count
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
    WHERE "block_timestamp" < 1483228800000000
      AND "trace_type" = 'create'
    GROUP BY "from_address"
),  /* ---------- failed transactions ---------- */
failures AS (
    SELECT
        "from_address"                                       AS address,
        COUNT(*)                                             AS failure_count
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
    WHERE "block_timestamp" < 1483228800000000
      AND "status" = 0
      AND "trace_type" = 'call'
      AND ("call_type" IS NULL OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))
    GROUP BY "from_address"
),  /* ---------- byte‑code size for contracts ---------- */
bytecodes AS (
    SELECT
        "address"                                            AS address,
        MAX(LENGTH("bytecode"))                              AS bytecode_size
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.CONTRACTS
    WHERE "block_timestamp" < 1483228800000000
    GROUP BY "address"
),  /* ---------- gas fees paid (per transaction) ---------- */
fees AS (
    SELECT
        "from_address"                                       AS address,
        SUM("gas_price" * "receipt_gas_used")                AS fee_wei
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
    WHERE "block_timestamp" < 1483228800000000
      AND "receipt_status" = 1
    GROUP BY "from_address"
), /* ---------- master address list ---------- */
all_addresses AS (
    SELECT address FROM incoming
    UNION SELECT address FROM outgoing
    UNION SELECT address FROM token_in
    UNION SELECT address FROM token_out
    UNION SELECT address FROM rewards
    UNION SELECT address FROM creates
    UNION SELECT address FROM bytecodes
)
/* ======================== final select ======================== */
SELECT
    a.address,

    /* ---- balance (ETH) ---- */
    ROUND( (COALESCE(i.in_wei,0)
          - COALESCE(o.out_wei,0)
          - COALESCE(fe.fee_wei,0) ) / 1e18 , 6)                     AS balance,

    /* ---- hourly activity consistency ---- */
    CASE WHEN COALESCE(act.activity_count,0) > 0 THEN
             ROUND( SQRT(POWER(act.sum_cos,2) + POWER(act.sum_sin,2))
                  / act.activity_count , 6)
         END                                                         AS R_active_hour,

    COALESCE(act.active_days,0)                                      AS active_days,

    /* ---- incoming ---- */
    COALESCE(i.in_trace_count,0)                                     AS in_trace_count,
    COALESCE(i.in_addr_count,0)                                      AS in_addr_count,
    COALESCE(i.in_transfer_count,0)                                  AS in_transfer_count,
    ROUND(COALESCE(i.in_avg_amount_wei,0)/1e18 , 6)                  AS in_avg_amount,
    ROUND(COALESCE(i.avg_gas_used,0) , 4)                            AS avg_gas_used,
    ROUND(COALESCE(i.std_gas_used,0) , 4)                            AS std_gas_used,

    /* ---- outgoing ---- */
    COALESCE(o.out_trace_count,0)                                    AS out_trace_count,
    COALESCE(o.out_addr_count,0)                                     AS out_addr_count,
    COALESCE(o.out_transfer_count,0)                                 AS out_transfer_count,
    ROUND(COALESCE(o.out_avg_amount_wei,0)/1e18 , 6)                 AS out_avg_amount,

    /* ---- token transfers ---- */
    COALESCE(ti.token_in_tnx,0)                                      AS token_in_tnx,
    COALESCE(ti.token_in_type,0)                                     AS token_in_type,
    COALESCE(ti.token_from_addr,0)                                   AS token_from_addr,
    COALESCE(tox.token_out_tnx,0)                                    AS token_out_tnx,
    COALESCE(tox.token_out_type,0)                                   AS token_out_type,
    COALESCE(tox.token_to_addr,0)                                    AS token_to_addr,

    /* ---- mining & contracts ---- */
    ROUND(COALESCE(r.reward_wei,0) / 1e18 , 6)                       AS reward_amount,
    COALESCE(c.contract_create_count,0)                              AS contract_create_count,

    /* ---- failures & byte‑code ---- */
    COALESCE(f.failure_count,0)                                      AS failure_count,
    bc.bytecode_size

FROM       all_addresses           a
LEFT JOIN  incoming                i   ON a.address = i.address
LEFT JOIN  outgoing                o   ON a.address = o.address
LEFT JOIN  activity                act ON a.address = act.address
LEFT JOIN  token_in                ti  ON a.address = ti.address
LEFT JOIN  token_out               tox ON a.address = tox.address
LEFT JOIN  rewards                 r   ON a.address = r.address
LEFT JOIN  creates                 c   ON a.address = c.address
LEFT JOIN  failures                f   ON a.address = f.address
LEFT JOIN  bytecodes               bc  ON a.address = bc.address
LEFT JOIN  fees                    fe  ON a.address = fe.address;
