--Description:  (#9)  Same as #8 but joined to GENES for readable gene symbols and
--              still restricted to p ≤ 5 × 10⁻¹¹.  Only the best variant per
--              gene–study pair is retained via QUALIFY.
WITH sig AS (
    SELECT
        "gene_id","study_id","pval",
        "tag_chrom","tag_pos","tag_ref","tag_alt",
        "lead_chrom","lead_pos","lead_ref","lead_alt"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE "pval" <= 5e-11
)
SELECT
    s."gene_id",
    g."gene_name",
    s."study_id",
    s."pval"
FROM sig s
JOIN "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."GENES" g
  ON s."gene_id" = g."gene_id"
QUALIFY ROW_NUMBER() OVER (
            PARTITION BY s."gene_id", s."study_id"
            ORDER BY     s."pval"
        ) = 1
ORDER BY s."pval" ASC
