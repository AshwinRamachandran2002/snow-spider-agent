Query:
--Description:  (#8)  Retrieve the 20 strongest gene–study associations after
--              trimming the DISEASE_VARIANT_GENE table to p‑values ≤ 5 × 10⁻¹¹.
--              QUALIFY removes all but the single lowest‑p‑value variant per
--              (gene_id , study_id), and the result is ordered by p‑value.
WITH sig AS (
    SELECT "gene_id", "study_id", "pval"
    FROM   "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE  "pval" <= 5e-11
)
SELECT
    "gene_id",
    "study_id",
    "pval"
FROM sig
QUALIFY ROW_NUMBER() OVER (
            PARTITION BY "gene_id", "study_id"
            ORDER BY     "pval"
        ) = 1
ORDER BY "pval" ASC
LIMIT 20
