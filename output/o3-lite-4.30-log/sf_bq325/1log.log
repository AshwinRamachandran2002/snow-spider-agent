```sql
--Description: This single statement delivers the 10 genes with the most significant
--             associations across ALL studies while remaining warehouse‑friendly.
--             • Step 1 (CTE `sig`)   – keep only variants with p ≤ 5×10⁻¹¹; this
--                                       prunes the 1.8 B‑row table to a tiny slice
--                                       yet captures every conceivable “top hit”.
--             • Step 2 (CTE `best`)  – for every (gene_id, study_id) pair select
--                                       the variant with the lowest p‑value by
--                                       applying ROW_NUMBER and QUALIFY.
--             • Final SELECT         – join to GENES for symbols, coalesce coordinate
--                                       fields for completeness, sort by p‑value and
--                                       return the 10 smallest.
WITH sig AS (
    SELECT *
    FROM   "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE  "pval" <= 5e-11                       -- strong significance filter
),
best AS (
    SELECT
        "gene_id",
        "study_id",
        "pval",
        "tag_chrom", "tag_pos", "tag_ref", "tag_alt",
        "lead_chrom","lead_pos","lead_ref","lead_alt",
        ROW_NUMBER() OVER (
            PARTITION BY "gene_id", "study_id"
            ORDER BY     "pval"
        ) AS rn
    FROM sig
    QUALIFY rn = 1                               -- 1 variant per gene–study
)
SELECT
    b."gene_id",
    g."gene_name",
    b."study_id",
    b."pval",
    COALESCE(b."tag_chrom", b."lead_chrom") AS "chrom",
    COALESCE(b."tag_pos" , b."lead_pos" )   AS "pos",
    COALESCE(b."tag_ref" , b."lead_ref" )   AS "ref",
    COALESCE(b."tag_alt" , b."lead_alt" )   AS "alt"
FROM best b
JOIN "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."GENES" g
  ON b."gene_id" = g."gene_id"
ORDER BY b."pval" ASC
LIMIT 10;
