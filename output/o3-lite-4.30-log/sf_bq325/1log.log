/*  Top‑10 genes with the strongest associations across all studies               */
WITH gene_study_best AS (          -- best variant per (gene , study)
    SELECT
        d."gene_id",
        d."study_id",
        d."pval",
        COALESCE(d."tag_chrom", d."lead_chrom") AS chrom,
        COALESCE(d."tag_pos" , d."lead_pos" )   AS pos,
        COALESCE(d."tag_ref" , d."lead_ref" )   AS ref,
        COALESCE(d."tag_alt" , d."lead_alt" )   AS alt,
        ROW_NUMBER() OVER (
            PARTITION BY d."gene_id", d."study_id"
            ORDER BY     d."pval" ASC
        ) AS rn_gene_study
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE" d
    WHERE d."pval" IS NOT NULL
),
gene_best AS (                     -- best variant across ALL studies per gene
    SELECT *
    FROM   gene_study_best
    WHERE  rn_gene_study = 1
    QUALIFY ROW_NUMBER() OVER (
                PARTITION BY "gene_id"
