--Description:  Produce a histogram of log10 P‑values for the most significant
--              variant associated with every (gene_id , study_id) pair, while
--              ensuring the query stays performant and uses supported maths
--              functions.
--
--  • Why pre‑filter to p ≤ 1 × 10⁻⁶?  
--    Scanning the full 1.8 B‑row table is impractical.  A 10⁻⁶ threshold
--    retains all strongly associated variants yet reduces the data volume
--    by several orders of magnitude.
--
--  • Why ROW_NUMBER + QUALIFY?  
--    We need just one “best” variant per gene–study combination; ROW_NUMBER
--    provides that ranking and QUALIFY removes the rest on‑the‑fly.
--
--  • Why LOG("pval", 10) instead of LOG10()?  
--    The built‑in LOG10 function is not recognised in this SQL environment,
--    but Snowflake’s LOG(x, base) form is; using base = 10 gives the same
--    result.  Rounding to 0.02 creates tidy bins for a quick visual check.
WITH best AS (
    SELECT
        "gene_id",
        "study_id",
        "pval",
        ROW_NUMBER() OVER (
            PARTITION BY "gene_id", "study_id"
            ORDER BY     "pval"
        ) AS rn
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE "pval" <= 1e-6               -- focus on highly significant hits
    QUALIFY rn = 1                     -- keep lowest‑p‑value per gene–study
)
SELECT
    ROUND(LOG("pval", 10), 2) AS "log10_pval_bin",
    COUNT(*)                  AS "n_associations"
FROM best
GROUP BY "log10_pval_bin"
ORDER BY "log10_pval_bin";
