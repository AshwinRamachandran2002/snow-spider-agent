```sql
--Description:  (#7)  Produce a log10‑p‑value histogram of the best association per
--                       (gene_id , study_id) pair.  To keep the scan light, restrict
--                       to variants with p ≤ 1×10⁻⁶ before doing the ROW_NUMBER step.
WITH sig AS (
    SELECT "gene_id", "study_id", "pval"
    FROM   "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE  "pval" <= 1e-6
)
SELECT 
    ROUND(LOG10("pval"),2) AS "log10_pval_bin",
    COUNT(*)               AS "n_associations"
FROM (
    SELECT
        "gene_id",
        "study_id",
        "pval",
        ROW_NUMBER() OVER (PARTITION BY "gene_id","study_id" ORDER BY "pval") AS rn
    FROM sig
) sub
WHERE rn = 1
GROUP BY "log10_pval_bin"
ORDER BY "log10_pval_bin";
```

```sql
--Description:  (#8)  List the 20 strongest gene–study associations (one per pair)
--                       after trimming to p ≤ 5×10⁻¹¹ to avoid full‑table scan.
WITH sig AS (
    SELECT "gene_id","study_id","pval"
    FROM   "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE  "pval" <= 5e-11
)
SELECT
    "gene_id",
    "study_id",
    "pval"
FROM (
    SELECT
        "gene_id",
        "study_id",
        "pval",
        ROW_NUMBER() OVER (PARTITION BY "gene_id","study_id" ORDER BY "pval") AS rn
    FROM sig
) sub
WHERE rn = 1
ORDER BY "pval" ASC
LIMIT 20;
```

```sql
--Description:  (#9)  Same as #8 but joined to GENES for readable symbols; still
--                       pre‑filters to p ≤ 5×10⁻¹¹ and keeps one row per gene–study.
WITH sig AS (
    SELECT
        "gene_id","study_id","pval",
        "tag_chrom","tag_pos","tag_ref","tag_alt",
        "lead_chrom","lead_pos","lead_ref","lead_alt"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE "pval" <= 5e-11
),
best AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY "gene_id","study_id" ORDER BY "pval") AS rn
    FROM sig
    QUALIFY rn = 1
)
SELECT
    b."gene_id",
    g."gene_name",
    b."study_id",
    b."pval"
FROM best b
JOIN "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."GENES" g
  ON b."gene_id" = g."gene_id"
ORDER BY b."pval" ASC
LIMIT 20;
```

```sql
--Description:  (#10 Final)  Top‑10 genes with the strongest association signals
--                           across all studies.  Uses p ≤ 5×10⁻¹¹ filter, keeps
--                           best variant per gene–study, joins to GENES, and
--                           returns variant coordinates via COALESCE.
WITH sig AS (
    SELECT *
    FROM   "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE  "pval" <= 5e-11
),
best AS (
    SELECT
        "gene_id",
        "study_id",
        "pval",
        "tag_chrom","tag_pos","tag_ref","tag_alt",
        "lead_chrom","lead_pos","lead_ref","lead_alt",
        ROW_NUMBER() OVER (
            PARTITION BY "gene_id","study_id"
            ORDER BY     "pval"
        ) AS rn
    FROM sig
    QUALIFY rn = 1
)
SELECT
    b."gene_id",
    g."gene_name",
    b."study_id",
    b."pval",
    COALESCE(b."tag_chrom", b."lead_chrom") AS "chrom",
    COALESCE(b."tag_pos" , b."lead_pos" )   AS "pos",
    COALESCE(b."tag_ref" , b."lead_ref" )   AS "ref",
    COALESCE(b."tag_alt" , b."lead_alt" )   AS "alt"
FROM best b
JOIN "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."GENES" g
  ON b."gene_id" = g."gene_id"
ORDER BY b."pval" ASC
LIMIT 10;
