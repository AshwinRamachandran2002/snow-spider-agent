Query:
--Description:  (#10 Final)  Produce the top‑10 genes with the strongest
--              associations across all studies.  Filter to variants with
--              p ≤ 5 × 10⁻¹¹, keep the lowest‑p‑value record per gene–study,
--              join to GENES for symbols, and coalesce tag/lead coordinates.
WITH sig AS (
    SELECT *
    FROM   "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE  "pval" <= 5e-11
),
best AS (
    SELECT
        "gene_id",
        "study_id",
        "pval",
        "tag_chrom","tag_pos","tag_ref","tag_alt",
        "lead_chrom","lead_pos","lead_ref","lead_alt",
        ROW_NUMBER() OVER (
            PARTITION BY "gene_id", "study_id"
            ORDER BY     "pval"
        ) AS rn
    FROM sig
    QUALIFY rn = 1
)
SELECT
    b."gene_id",
    g."gene_name",
    b."study_id",
    b."pval",
    COALESCE(b."tag_chrom", b."lead_chrom") AS "chrom",
    COALESCE(b."tag_pos" , b."lead_pos" )   AS "pos",
    COALESCE(b."tag_ref" , b."lead_ref" )   AS "ref",
    COALESCE(b."tag_alt" , b."lead_alt" )   AS "alt"
FROM best b
JOIN "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."GENES" g
  ON b."gene_id" = g."gene_id"
ORDER BY b."pval" ASC
LIMIT 10
