--Description: (#10) Final answer – Top‑10 gene–variant pairs with the smallest
--              p‑values across both sources.  For speed we restrict both tables
--              to 0 < p ≤ 1 × 10⁻⁶, then keep the single lowest‑p variant per
--              (study_id, gene_id) using QUALIFY.  Finally we UNION the two
--              reduced sets, order by p‑value, and return the 10 strongest hits.
WITH gene_min_sa AS (          -- SA_MOLECULAR_TRAIT
    SELECT
        "study_id",
        "gene_id",
        "chrom",
        "pos",
        "ref",
        "alt",
        "pval"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."SA_MOLECULAR_TRAIT"
    WHERE "pval" BETWEEN 1e-323 AND 1e-6
    QUALIFY ROW_NUMBER() OVER (
                PARTITION BY "study_id", "gene_id"
                ORDER BY "pval"
            ) = 1
),
gene_min_dvg AS (              -- DISEASE_VARIANT_GENE
    SELECT
        "study_id",
        "gene_id",
        "tag_chrom" AS "chrom",
        "tag_pos"   AS "pos",
        "tag_ref"   AS "ref",
        "tag_alt"   AS "alt",
        "pval"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE "pval" BETWEEN 1e-323 AND 1e-6
    QUALIFY ROW_NUMBER() OVER (
                PARTITION BY "study_id", "gene_id"
                ORDER BY "pval"
            ) = 1
),
union_hits AS (
    SELECT * FROM gene_min_sa
    UNION ALL
    SELECT * FROM gene_min_dvg
)
SELECT
    "gene_id",
    "study_id",
    "chrom",
    "pos",
    "ref",
    "alt",
    "pval"
FROM union_hits
ORDER BY "pval" ASC
LIMIT 10
