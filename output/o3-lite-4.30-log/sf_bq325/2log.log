```sql
--Description: The large DISEASE_VARIANT_GENE table caused a timeout when we tried to rank every
--             record.  To keep the computation light, we:
--               1) Apply a strong significance cut‑off (p < 1e‑6) so only the most informative
--                  rows remain.  This drastically reduces the number of rows the analytic
--                  window function must scan.
--               2) Use QUALIFY with ROW_NUMBER() to retain, for each (study_id, gene_id)
--                  partition, the single variant that has the smallest p‑value.
--               3) Return 20 illustrative rows so we can confirm the logic before scaling up.
SELECT
    "study_id",
    "gene_id",
    "tag_chrom" AS "chrom",
    "tag_pos"   AS "pos",
    "tag_ref"   AS "ref",
    "tag_alt"   AS "alt",
    "pval"
FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
WHERE "pval" IS NOT NULL            -- ensure p‑value exists
  AND "pval" < 1e-6                 -- pre‑filter to highly significant hits
QUALIFY ROW_NUMBER() OVER (
          PARTITION BY "study_id", "gene_id"
          ORDER BY "pval"           -- smallest p‑value first
      ) = 1
LIMIT 20;
```
