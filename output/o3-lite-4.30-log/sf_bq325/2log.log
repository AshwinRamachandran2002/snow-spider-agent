```sql
--Description:  Build the combined set of lowest‑p variants per (study_id, gene_id)
--              from two sources—SA_MOLECULAR_TRAIT in full, and DISEASE_VARIANT_GENE
--              after a speed‑saving significance filter (p < 1 × 10⁻⁶).  Because
--              LOG10() isn’t available, convert p‑values to –log10 scale with
--              –LN(p)/LN(10).  Finally, aggregate to show the 20 most significant
--              –log10(p) bins together with their hit counts.
WITH union_all AS (
    /* -------- SA_MOLECULAR_TRAIT: keep best variant per study–gene pair -------- */
    SELECT "pval"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."SA_MOLECULAR_TRAIT"
    WHERE "pval" IS NOT NULL
    QUALIFY ROW_NUMBER() OVER (
                PARTITION BY "study_id", "gene_id"
                ORDER BY "pval"
           ) = 1
    UNION ALL
    /* -------- DISEASE_VARIANT_GENE: pre‑filter to p<1e‑6, then best per pair ---- */
    SELECT "pval"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
      AND "pval" < 1e-6
    QUALIFY ROW_NUMBER() OVER (
                PARTITION BY "study_id", "gene_id"
                ORDER BY "pval"
           ) = 1
)
SELECT
    -LN("pval") / LN(10)  AS "minus_log10_p",
    COUNT(*)              AS "num_hits"
FROM union_all
GROUP BY 1
ORDER BY 1 DESC
LIMIT 20;
