```sql
--Description:  Fetch the 10 most significant (smallest‑p) gene–variant links taken
--              from both molecular‑trait (SA_MOLECULAR_TRAIT) and disease GWAS
--              (DISEASE_VARIANT_GENE) sources, without risking time‑out.
--              • Step‑1  Ultra‑significance filter  : keep only rows with 0 < p‑value < 1 × 10⁻¹²
--                 (this tiny subset is guaranteed to contain the overall minima).
--              • Step‑2  Deduplicate per source     : for every (study_id, gene_id) retain
--                 the single lowest‑p variant via ROW_NUMBER … QUALIFY = 1.
--              • Step‑3  UNION the two trimmed sets.
--              • Step‑4  Sort by p‑value ascending and emit the top 10 rows.
WITH sa_best AS (   /* molecular‑trait associations */
    SELECT
        "study_id",
        "gene_id",
        "chrom",
        "pos",
        "ref",
        "alt",
        "pval"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."SA_MOLECULAR_TRAIT"
    WHERE "pval" > 0                -- exclude exact zeros (ln/overflow safety)
      AND "pval" < 1e-12            -- heavy significance cut for speed
    QUALIFY ROW_NUMBER() OVER (
               PARTITION BY "study_id", "gene_id"
               ORDER BY "pval"
           ) = 1                    -- keep best variant per study–gene pair
),
dvg_best AS (    /* disease associations */
    SELECT
        "study_id",
        "gene_id",
        "tag_chrom" AS "chrom",
        "tag_pos"   AS "pos",
        "tag_ref"   AS "ref",
        "tag_alt"   AS "alt",
        "pval"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE "pval" > 0
      AND "pval" < 1e-12
    QUALIFY ROW_NUMBER() OVER (
               PARTITION BY "study_id", "gene_id"
               ORDER BY "pval"
           ) = 1
),
combined AS (    /* union both sources after trimming + deduplication */
    SELECT * FROM sa_best
    UNION ALL
    SELECT * FROM dvg_best
)
SELECT
    "gene_id",
    "study_id",
    "chrom",
    "pos",
    "ref",
    "alt",
    "pval"
FROM combined
ORDER BY "pval" ASC
LIMIT 10;          -- final top‑10 strongest associations
```
