Query:
--Description: (#9) Count the number of distinct studies that still contribute
--              after we (a) pre‑filter both sources to 0 < p ≤ 1 × 10⁻⁶ to keep
--              the row set small and (b) retain only the single most‑significant
--              variant per (study_id, gene_id) via QUALIFY + ROW_NUMBER().
WITH sa AS (                        -- molecular‑trait source
    SELECT "study_id"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."SA_MOLECULAR_TRAIT"
    WHERE "pval" BETWEEN 1e-323 AND 1e-6
    QUALIFY ROW_NUMBER() OVER (
                PARTITION BY "study_id", "gene_id"
                ORDER BY "pval"
            ) = 1
),
dg AS (                        -- disease‑variant source (already p ≤ 1e‑6)
    SELECT "study_id"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE "pval" BETWEEN 1e-323 AND 1e-6
    QUALIFY ROW_NUMBER() OVER (
                PARTITION BY "study_id", "gene_id"
                ORDER BY "pval"
            ) = 1
),
union_all AS (
    SELECT * FROM sa
    UNION ALL
    SELECT * FROM dg
)
SELECT COUNT(DISTINCT "study_id") AS "num_studies_contributing"
FROM union_all
