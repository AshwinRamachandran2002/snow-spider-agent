        "study_id", "gene_id", "chrom", "pos", "ref", "alt", "pval"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."SA_MOLECULAR_TRAIT"
    WHERE "pval" IS NOT NULL
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "study_id","gene_id"
                               ORDER BY "pval") = 1
    UNION ALL
    ------------------------------- DG part (filtered)
    SELECT
        "study_id",
        "gene_id",
        "tag_chrom" AS "chrom",
        "tag_pos"   AS "pos",
        "tag_ref"   AS "ref",
        "tag_alt"   AS "alt",
