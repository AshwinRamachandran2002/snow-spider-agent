```sql
--Description:  Minimise run‑time on the large DISEASE_VARIANT_GENE table by
--              1) keeping only ultra‑significant associations (p‑value < 1×10⁻¹²),
--              2) using QUALIFY + ROW_NUMBER to retain just the single best
--                 variant for each (study_id, gene_id) pair,
--              3) returning 20 illustrative rows ordered by ascending p‑value.
WITH ultra_sig AS (
    SELECT
        "study_id",
        "gene_id",
        "tag_chrom" AS "chrom",
        "tag_pos"   AS "pos",
        "tag_ref"   AS "ref",
        "tag_alt"   AS "alt",
        "pval"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
      AND "pval" < 1e-12                     -- aggressive filter to shrink data
    QUALIFY ROW_NUMBER() OVER (
                PARTITION BY "study_id", "gene_id"
                ORDER BY "pval"
            ) = 1                            -- best variant per (study, gene)
)
SELECT
    "study_id",
    "gene_id",
    "chrom",
    "pos",
    "ref",
    "alt",
    "pval"
FROM ultra_sig
ORDER BY "pval" ASC
LIMIT 20;
```
