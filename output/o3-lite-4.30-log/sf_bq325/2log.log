--Description:  Build a unified sample of the SINGLE most‑significant variant for every
--              (study_id, gene_id) across both sources—SA_MOLECULAR_TRAIT (all rows) and
--              DISEASE_VARIANT_GENE (pre‑filtered to p < 1 × 10⁻⁶ for speed).  Exclude p‑values
--              equal to zero (to avoid ln(0) errors), convert p to –log₁₀(p) via
--              –LN(p)/LN(10), then return the 20 highest –log₁₀(p) bins with their counts.
WITH union_all AS (
    /* ---------------- SA_MOLECULAR_TRAIT ---------------- */
    SELECT "pval"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."SA_MOLECULAR_TRAIT"
    WHERE "pval" IS NOT NULL                -- keep non‑null p
      AND "pval" > 0                        -- avoid ln(0)
    QUALIFY ROW_NUMBER() OVER (
               PARTITION BY "study_id", "gene_id"
               ORDER BY "pval"
           ) = 1                            -- lowest p per study–gene
    UNION ALL
    /* ------------ DISEASE_VARIANT_GENE (p < 1e‑6) -------- */
    SELECT "pval"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
      AND "pval" > 0
      AND "pval" < 1e-6                     -- speed filter
    QUALIFY ROW_NUMBER() OVER (
               PARTITION BY "study_id", "gene_id"
               ORDER BY "pval"
           ) = 1
)
SELECT
    -LN("pval") / LN(10)  AS "minus_log10_p",
    COUNT(*)              AS "num_hits"
FROM union_all
GROUP BY 1
ORDER BY 1 DESC
LIMIT 20;
