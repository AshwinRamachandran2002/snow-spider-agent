    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
      AND "pval" < 1e-6
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "study_id","gene_id"
                               ORDER BY "pval") = 1
)
SELECT
    -LOG10("pval") AS "minus_log10_p",
    COUNT(*)       AS "num_hits"
FROM union_all
GROUP BY 1
ORDER BY 1 DESC
