--Description: (#7) Build a combined table of lowest‑p‑value hits from both sources,
--             but shrink DISEASE_VARIANT_GENE first (p < 1e‑6) to prevent timeout.
WITH sa AS (   ------------------------------------------------ Molecular‑trait source
    SELECT
        "study_id",
        "gene_id",
        "chrom",
        "pos",
        "ref",
        "alt",
        "pval"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."SA_MOLECULAR_TRAIT"
    WHERE "pval" IS NOT NULL
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "study_id","gene_id"
                               ORDER BY "pval") = 1
),
dg AS (   ------------------------------------------------------ Disease variant source
    SELECT
        "study_id",
        "gene_id",
        "tag_chrom" AS "chrom",
        "tag_pos"   AS "pos",
        "tag_ref"   AS "ref",
        "tag_alt"   AS "alt",
