The table structure information is ({database name: {schema name: [table name]}}): 
{'OPEN_TARGETS_GENETICS_2': {'OPEN_TARGETS_GENETICS': ['LOCUS2GENE', 'SA_GWAS', 'STUDIES', 'GENES', 'SA_MOLECULAR_TRAIT', 'VARIANT_DISEASE_CREDSET', 'VARIANT_GENE', 'DISEASE_VARIANT_GENE', 'STUDIES_OVERLAP', 'VARIANTS', 'VARIANT_DISEASE_COLOC', 'OT_RELEASE', 'VARIANT_DISEASE']}}
Begin Exploring Related Columns
Below are the columns that are most relevant for finding “strongest associations” (smallest p‑values) between variants and genes, together with their potential usage and typical conditions you will probably apply later.

Relevant columns and their potential usage
• SA_MOLECULAR_TRAIT."gene_id": identifies the gene affected by the molecular‑trait association  
• SA_MOLECULAR_TRAIT."study_id": groups results by study  
• SA_MOLECULAR_TRAIT."pval": p‑value of the variant–gene association (to be minimised)  
• SA_MOLECULAR_TRAIT."chrom", "pos", "ref", "alt": variant coordinates/alleles to report the winning variant  

• DISEASE_VARIANT_GENE."gene_id": gene linked to a disease association  
• DISEASE_VARIANT_GENE."study_id": study identifier  
• DISEASE_VARIANT_GENE."pval": p‑value for the disease variant–gene association  
• DISEASE_VARIANT_GENE."tag_chrom", "tag_pos", "tag_ref", "tag_alt": variant coordinates/alleles (need to rename to match the molecular‑trait columns)

Typical filters/conditions you will need  
– WHERE "pval" IS NOT NULL              -- ignore missing p‑values  
– ROW_NUMBER() OVER (PARTITION BY "study_id","gene_id" ORDER BY "pval") = 1  
  to keep only the lowest p‑value variant per gene within each study  
– ORDER BY "pval" ASC LIMIT 10          -- finally take the 10 smallest p‑values overall  

Ten step‑by‑step Snowflake SQL queries
(Every identifier is wrapped in double quotes, every query capped with LIMIT 20 except the last, which naturally returns 10 rows.)

```sql
-- 1. Quick peek at molecular‑trait data (first 20 rows)
SELECT
  "study_id",
  "gene_id",
  "chrom",
  "pos",
  "ref",
  "alt",
  "pval"
FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."SA_MOLECULAR_TRAIT"
LIMIT 20;
```

```sql
-- 2. Unique list of genes present in molecular‑trait summary statistics
SELECT DISTINCT
  "gene_id"
FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."SA_MOLECULAR_TRAIT"
WHERE "gene_id" IS NOT NULL
LIMIT 20;
```

```sql
-- 3. Minimum p‑value per gene across all studies (molecular‑trait only)
SELECT
  "gene_id",
  MIN("pval") AS "min_pval"
FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."SA_MOLECULAR_TRAIT"
WHERE "pval" IS NOT NULL
GROUP BY "gene_id"
ORDER BY "min_pval"
LIMIT 20;
```

```sql
-- 4. Lowest‑p‑value variant for each (study, gene) pair – molecular‑trait source
SELECT *
FROM (
  SELECT
    "study_id",
    "gene_id",
    "chrom",
    "pos",
    "ref",
    "alt",
    "pval",
    ROW_NUMBER() OVER (PARTITION BY "study_id","gene_id" ORDER BY "pval") AS "rn"
  FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."SA_MOLECULAR_TRAIT"
  WHERE "pval" IS NOT NULL
) AS t
WHERE "rn" = 1
LIMIT 20;
```

```sql
-- 5. Same idea for disease‑oriented associations
SELECT *
FROM (
  SELECT
    "study_id",
    "gene_id",
    "tag_chrom" AS "chrom",
    "tag_pos"  AS "pos",
    "tag_ref"  AS "ref",
    "tag_alt"  AS "alt",
    "pval",
    ROW_NUMBER() OVER (PARTITION BY "study_id","gene_id" ORDER BY "pval") AS "rn"
  FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
  WHERE "pval" IS NOT NULL
) AS d
WHERE "rn" = 1
LIMIT 20;
```

```sql
-- 6. Count how many (study,gene) pairs survive the “lowest p‑value” filter in molecular‑trait data
WITH cte AS (
  SELECT
    ROW_NUMBER() OVER (PARTITION BY "study_id","gene_id" ORDER BY "pval") AS "rn"
  FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."SA_MOLECULAR_TRAIT"
  WHERE "pval" IS NOT NULL
)
SELECT COUNT(*) AS "num_first_hits"
FROM cte
WHERE "rn" = 1;
```

```sql
-- 7. Combine the two sources into a single UNION ALL, keeping only lowest‑p‑value hits
WITH sa AS (
  SELECT
    "study_id",
    "gene_id",
    "chrom",
    "pos",
    "ref",
    "alt",
    "pval"
  FROM (
    SELECT
      "study_id","gene_id","chrom","pos","ref","alt","pval",
      ROW_NUMBER() OVER (PARTITION BY "study_id","gene_id" ORDER BY "pval") AS "rn"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."SA_MOLECULAR_TRAIT"
    WHERE "pval" IS NOT NULL
  )
  WHERE "rn" = 1
),
dg AS (
  SELECT
    "study_id",
    "gene_id",
    "tag_chrom" AS "chrom",
    "tag_pos"  AS "pos",
    "tag_ref"  AS "ref",
    "tag_alt"  AS "alt",
    "pval"
  FROM (
    SELECT
      "study_id","gene_id","tag_chrom","tag_pos","tag_ref","tag_alt","pval",
      ROW_NUMBER() OVER (PARTITION BY "study_id","gene_id" ORDER BY "pval") AS "rn"
    FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
  )
  WHERE "rn" = 1
)
SELECT *
FROM sa
UNION ALL
SELECT *
FROM dg
LIMIT 20;
```

```sql
-- 8. Quick check: distribution of p‑values (log‑10) from the combined set
WITH union_all AS (
  /* same UNION ALL block as Query 7 */
  SELECT * FROM (
      SELECT
        "study_id","gene_id","chrom","pos","ref","alt","pval"
      FROM (
        SELECT
          "study_id","gene_id","chrom","pos","ref","alt","pval",
          ROW_NUMBER() OVER (PARTITION BY "study_id","gene_id" ORDER BY "pval") AS "rn"
        FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."SA_MOLECULAR_TRAIT"
        WHERE "pval" IS NOT NULL
      ) WHERE "rn" = 1
    )
  UNION ALL
  SELECT * FROM (
      SELECT
        "study_id","gene_id","tag_chrom","tag_pos","tag_ref","tag_alt","pval"
      FROM (
        SELECT
          "study_id","gene_id","tag_chrom","tag_pos","tag_ref","tag_alt","pval",
          ROW_NUMBER() OVER (PARTITION BY "study_id","gene_id" ORDER BY "pval") AS "rn"
        FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
        WHERE "pval" IS NOT NULL
      ) WHERE "rn" = 1
    )
)
SELECT
  -LOG10("pval") AS "minus_log10_p",
  COUNT(*)       AS "num_hits"
FROM union_all
GROUP BY 1
ORDER BY 1 DESC
LIMIT 20;
```

```sql
-- 9. Sanity check: how many unique studies contribute to the final pool?
WITH final_hits AS (
  /* exactly the same UNION ALL used above */
  SELECT * FROM (
      SELECT
        "study_id","gene_id","chrom","pos","ref","alt","pval"
      FROM (
        SELECT
          "study_id","gene_id","chrom","pos","ref","alt","pval",
          ROW_NUMBER() OVER (PARTITION BY "study_id","gene_id" ORDER BY "pval") AS "rn"
        FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."SA_MOLECULAR_TRAIT"
        WHERE "pval" IS NOT NULL
      ) WHERE "rn" = 1
    )
  UNION ALL
  SELECT * FROM (
      SELECT
        "study_id","gene_id","tag_chrom","tag_pos","tag_ref","tag_alt","pval"
      FROM (
        SELECT
          "study_id","gene_id","tag_chrom","tag_pos","tag_ref","tag_alt","pval",
          ROW_NUMBER() OVER (PARTITION BY "study_id","gene_id" ORDER BY "pval") AS "rn"
        FROM "OPEN_TARGETS_GENETICS_2"."OPEN_TARGETS_GENETICS"."DISEASE_VARIANT_GENE"
        WHERE "pval" IS NOT NULL
      ) WHERE "rn" = 1
    )
)
SELECT
  COUNT(DISTINCT "study_id") AS "num_studies_contributing"
FROM final_hits;
