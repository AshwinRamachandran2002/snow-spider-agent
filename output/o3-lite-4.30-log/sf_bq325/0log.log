--Description:  Deliver the task in one pass while staying performant.
--1) CTE per_gene_study_min   — quick GROUP BY that collapses the huge table to
--   one row per (gene_id, study_id) holding its minimal p‑value.
--2) CTE top_variants         — join those minima back to the source table to
--   retrieve the variant that attains the min p‑value; use ROW_NUMBER only on
--   this much‑reduced set to break ties deterministically by genomic position.
--3) Final SELECT             — order all gene–study best variants by p‑value
--   and return the 10 smallest values together with a human‑readable gene name.
WITH per_gene_study_min AS (           -- step 1: smallest p‑value in each study
    SELECT
        "gene_id",
        "study_id",
        MIN("pval") AS min_pval
    FROM   OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.DISEASE_VARIANT_GENE
    WHERE  "pval" IS NOT NULL
    GROUP BY "gene_id", "study_id"
),
top_variants AS (                       -- step 2: fetch corresponding variant
    SELECT
        d."gene_id",
        d."study_id",
        d."tag_chrom",
        d."tag_pos",
        d."tag_ref",
        d."tag_alt",
        d."pval",
        ROW_NUMBER() OVER (
            PARTITION BY d."gene_id", d."study_id"
            ORDER BY d."tag_pos", d."tag_ref", d."tag_alt"
        ) AS rn
    FROM   OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.DISEASE_VARIANT_GENE d
    JOIN   per_gene_study_min m
      ON   d."gene_id"  = m."gene_id"
     AND   d."study_id" = m."study_id"
     AND   d."pval"     = m.min_pval
)
SELECT
    g."gene_name",
    v."gene_id",
    v."study_id",
    v."tag_chrom",
    v."tag_pos",
    v."tag_ref",
    v."tag_alt",
    v."pval"
FROM   top_variants v
LEFT   JOIN OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.GENES g
       ON g."gene_id" = v."gene_id"
WHERE  v.rn = 1                       -- keep one variant per (gene, study)
ORDER  BY v."pval"
LIMIT  10;
