```sql
--Description:  Produce the 10 strongest gene associations across all studies.
--Logic
-- 1. per_gene_study_min   – collapse the large table to one row per
--    (gene_id, study_id) holding the minimal p‑value (fast GROUP BY).
-- 2. best_variant         – join those minima back to the source table to grab
--    the exact variant that achieved each minimum; apply ROW_NUMBER only on
--    this small result to break ties deterministically by genomic position.
-- 3. Final SELECT         – attach the gene symbol, rank by p‑value, and return
--    the top 10 rows (gene, study, variant, p‑value).

WITH per_gene_study_min AS (            -- step 1
    SELECT
        "gene_id",
        "study_id",
        MIN("pval") AS min_pval
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.DISEASE_VARIANT_GENE
    WHERE "pval" IS NOT NULL
    GROUP BY "gene_id", "study_id"
),
best_variant AS (                       -- step 2
    SELECT
        d."gene_id",
        d."study_id",
        d."tag_chrom",
        d."tag_pos",
        d."tag_ref",
        d."tag_alt",
        d."pval",
        ROW_NUMBER() OVER (
            PARTITION BY d."gene_id", d."study_id"
            ORDER BY d."tag_chrom", d."tag_pos", d."tag_ref", d."tag_alt"
        ) AS rn
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.DISEASE_VARIANT_GENE d
    JOIN per_gene_study_min m
      ON d."gene_id"  = m."gene_id"
     AND d."study_id" = m."study_id"
     AND d."pval"     = m.min_pval
)
SELECT
    g."gene_name",
    b."gene_id",
    b."study_id",
    b."tag_chrom",
    b."tag_pos",
    b."tag_ref",
    b."tag_alt",
    b."pval"
FROM best_variant b
LEFT JOIN OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.GENES g
       ON g."gene_id" = b."gene_id"
WHERE b.rn = 1                          -- keep one variant per (gene, study)
ORDER BY b."pval"
LIMIT 10;
```
