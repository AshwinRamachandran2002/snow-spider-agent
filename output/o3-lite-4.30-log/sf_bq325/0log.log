--Description ─ thinking process embedded:
--Goal:   “top 10 genes with the strongest associations across all studies by
--        first selecting, for each gene within each study, the variant with the
--        lowest p‑value, then ranking all such gene–variant pairs and returning
--        the 10 smallest p‑values overall.”
--
--Approach:
-- 1. CTE min_pval:        lightweight GROUP BY to obtain the minimum p‑value
--                         for every (gene_id, study_id) pair.
-- 2. CTE best_variant:    join those minima back to the full table on
--                         (gene_id, study_id, pval) to pull the variant
--                         coordinates that actually achieved that minimum.
--                         In the (rare) case of ties we keep the first one via
--                         ROW_NUMBER, which is now inexpensive because the
--                         join output is already small.
-- 3. Final SELECT:        order the best gene–variant pairs by their p‑value
--                         and return the top 10 rows.
--
WITH min_pval AS (                 -- step 1
    SELECT
        "gene_id",
        "study_id",
        MIN("pval") AS min_pval
    FROM   OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.DISEASE_VARIANT_GENE
    WHERE  "pval" IS NOT NULL
    GROUP  BY "gene_id", "study_id"
),
best_variant AS (                  -- step 2
    SELECT
        d."gene_id",
        d."study_id",
        d."tag_chrom",
        d."tag_pos",
        d."tag_ref",
        d."tag_alt",
        d."pval",
        ROW_NUMBER() OVER (PARTITION BY d."gene_id", d."study_id"
                           ORDER BY d."tag_pos") AS rn
    FROM   OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.DISEASE_VARIANT_GENE d
    JOIN   min_pval m
           ON  d."gene_id"  = m."gene_id"
           AND d."study_id" = m."study_id"
           AND d."pval"     = m.min_pval
)
SELECT
       "gene_id",
       "study_id",
       "tag_chrom",
       "tag_pos",
       "tag_ref",
       "tag_alt",
       "pval"
FROM   best_variant
WHERE  rn = 1                     -- keep one variant per (gene, study)
ORDER  BY "pval"                  -- step 3
LIMIT  10;
