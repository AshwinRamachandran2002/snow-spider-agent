--  • Step‑1 (CTE min_pval): GROUP BY gene_id, study_id to obtain MIN(pval).
--    This is a pure aggregation and scales well.
--  • Step‑2 (CTE best_variant): join min_pval back to the original table to
--    capture the variant that achieves that minimum.  The join output is now
--    small, so applying ROW_NUMBER merely breaks ties deterministically (by
--    genomic position) and is cheap.
--  • Final SELECT: keep the first (tie‑broken) record per pair and show 20 rows
--    for validation.  Adjust/remove LIMIT in production.
WITH min_pval AS (
    SELECT
        "gene_id",
        "study_id",
        MIN("pval") AS min_pval
    FROM   OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.DISEASE_VARIANT_GENE
    WHERE  "pval" IS NOT NULL
    GROUP  BY "gene_id", "study_id"
),
best_variant AS (
    SELECT
        d."gene_id",
        d."study_id",
        d."tag_chrom",
        d."tag_pos",
        d."tag_ref",
        d."tag_alt",
        d."pval",
        ROW_NUMBER() OVER (PARTITION BY d."gene_id", d."study_id"
                           ORDER BY d."tag_pos") AS rn
