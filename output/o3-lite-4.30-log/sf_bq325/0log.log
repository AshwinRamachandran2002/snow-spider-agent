```sql
--Description:  The goal is to emulate “pick the lowest‑p‑value variant for each
--gene within each study, then rank all those variants and return the 10 overall
--smallest p‑values” without triggering a timeout.
--
--Why this design avoids the previous failure:
--  • Window functions over the whole DISEASE_VARIANT_GENE table are expensive.
--  • Instead, the first CTE (min_pval) reduces the dataset with a GROUP BY
--    (cheap) that keeps only (gene_id, study_id, MIN(pval)).
--  • We then join that compact result back to the original table to fetch the
--    corresponding variant; because the join output is small, a ROW_NUMBER
--    merely resolves any ties, and the entire query stays fast.
--  • Finally we order those gene–variant pairs by p‑value and limit to 10.
WITH min_pval AS (                       -- step 1: smallest p‑value per pair
    SELECT
        "gene_id",
        "study_id",
        MIN("pval") AS min_pval
    FROM   OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.DISEASE_VARIANT_GENE
    WHERE  "pval" IS NOT NULL
    GROUP BY "gene_id", "study_id"
),
best_variant AS (                        -- step 2: retrieve the actual variant
    SELECT
        d."gene_id",
        d."study_id",
        d."tag_chrom",
        d."tag_pos",
        d."tag_ref",
        d."tag_alt",
        d."pval",
        ROW_NUMBER() OVER (PARTITION BY d."gene_id", d."study_id"
                           ORDER BY d."tag_pos") AS rn   -- tie‑breaker
    FROM   OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.DISEASE_VARIANT_GENE d
    JOIN   min_pval m
      ON   d."gene_id"  = m."gene_id"
     AND   d."study_id" = m."study_id"
     AND   d."pval"     = m.min_pval
)
SELECT
    "gene_id",
    "study_id",
    "tag_chrom",
    "tag_pos",
    "tag_ref",
    "tag_alt",
    "pval"
FROM   best_variant
WHERE  rn = 1                            -- keep one variant per (gene, study)
ORDER  BY "pval"                         -- step 3: rank the strongest hits
LIMIT  10;
```
