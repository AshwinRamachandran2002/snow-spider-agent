10 exploratory → analytical queries (all capped with LIMIT 20 for safety)

```sql
-- 1) Look at the different event names that exist in one December day
SELECT DISTINCT event_name
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201225`
LIMIT 20;
```

```sql
-- 2) Inspect how the items array looks like in a single purchase row
SELECT event_timestamp,
       ecommerce.transaction_id,
       items
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201210`
WHERE event_name = 'purchase'
LIMIT 20;
```

```sql
-- 3) List a few distinct item names that were sold on 24‑Dec‑2020
SELECT DISTINCT item.item_name
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201224`,
     UNNEST(items) AS item
WHERE event_name = 'purchase'
LIMIT 20;
```

```sql
-- 4) Show the Tee purchases in December with the transaction id
SELECT event_date,
       ecommerce.transaction_id,
       item.item_name,
       item.quantity
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
     UNNEST(items) AS item
WHERE event_name = 'purchase'
  AND LOWER(item.item_name) LIKE '%google%navy%speckled%tee%'
LIMIT 20;
```

```sql
-- 5) Collect all December transaction_ids that include the Tee
SELECT DISTINCT ecommerce.transaction_id AS trx_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
     UNNEST(items) AS item
WHERE event_name = 'purchase'
  AND LOWER(item.item_name) LIKE '%google%navy%speckled%tee%'
LIMIT 20;
```

```sql
-- 6) See everything that was purchased in those same transactions (raw list)
SELECT tee_trx.trx_id,
       item.item_name,
       item.quantity
FROM (
      SELECT DISTINCT ecommerce.transaction_id AS trx_id
      FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
           UNNEST(items) AS item
      WHERE event_name = 'purchase'
        AND LOWER(item.item_name) LIKE '%google%navy%speckled%tee%'
     ) AS tee_trx
JOIN `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` e
  ON e.ecommerce.transaction_id = tee_trx.trx_id
CROSS JOIN UNNEST(e.items) AS item
LIMIT 20;
```

```sql
-- 7) Aggregate quantities for every co‑purchased product (excluding the Tee)
SELECT item.item_name,
       SUM(item.quantity) AS total_qty
FROM (
      SELECT DISTINCT ecommerce.transaction_id AS trx_id
      FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
           UNNEST(items) AS item
      WHERE event_name = 'purchase'
        AND LOWER(item.item_name) LIKE '%google%navy%speckled%tee%'
     ) AS tee_trx
JOIN `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` e
  ON e.ecommerce.transaction_id = tee_trx.trx_id
CROSS JOIN UNNEST(e.items) AS item
WHERE LOWER(item.item_name) NOT LIKE '%google%navy%speckled%tee%'
GROUP BY item.item_name
ORDER BY total_qty DESC
LIMIT 20;
```

```sql
-- 8) Same as #7 but also count number of orders that contained each product
SELECT item.item_name,
       COUNT(DISTINCT e.ecommerce.transaction_id) AS orders_cnt,
       SUM(item.quantity)                            AS total_qty
FROM (
      SELECT DISTINCT ecommerce.transaction_id AS trx_id
      FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
           UNNEST(items) AS item
      WHERE event_name = 'purchase'
        AND LOWER(item.item_name) LIKE '%google%navy%speckled%tee%'
     ) AS tee_trx
JOIN `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` e
  ON e.ecommerce.transaction_id = tee_trx.trx_id
CROSS JOIN UNNEST(e.items) AS item
WHERE LOWER(item.item_name) NOT LIKE '%google%navy%speckled%tee%'
GROUP BY item.item_name
ORDER BY total_qty DESC
LIMIT 20;
```

```sql
-- 9) List the customers (pseudo_id) who bought the Tee and what else they bought
SELECT e.user_pseudo_id,
       item.item_name,
       SUM(item.quantity) AS qty
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` e
CROSS JOIN UNNEST(e.items) AS item
WHERE e.event_name = 'purchase'
  AND e.ecommerce.transaction_id IN (
        SELECT DISTINCT ecommerce.transaction_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
             UNNEST(items) AS i
        WHERE event_name = 'purchase'
          AND LOWER(i.item_name) LIKE '%google%navy%speckled%tee%'
       )
  AND LOWER(item.item_name) NOT LIKE '%google%navy%speckled%tee%'
GROUP BY e.user_pseudo_id, item.item_name
ORDER BY qty DESC
LIMIT 20;
```

```sql
-- 10) FINAL – product bought with the highest total quantity together with
--      Google Navy Speckled Tee in December‑2020
SELECT item.item_name                              AS co_purchased_product,
       SUM(item.quantity)                          AS total_quantity_sold_together
FROM (
      -- all orders that include the Tee
      SELECT DISTINCT ecommerce.transaction_id AS tee_trx_id
      FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
           UNNEST(items) AS it
      WHERE event_name = 'purchase'
        AND LOWER(it.item_name) LIKE '%google%navy%speckled%tee%'
     ) AS tee_orders
JOIN `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` e
  ON e.ecommerce.transaction_id = tee_orders.tee_trx_id
CROSS JOIN UNNEST(e.items) AS item
WHERE LOWER(item.item_name) NOT LIKE '%google%navy%speckled%tee%'
GROUP BY item.item_name
ORDER BY total_quantity_sold_together DESC
LIMIT 20;
```

