```

```sql
-- 6. Description: Show the quantities of the tee itself to see the magnitude
SELECT SUM(it.quantity) AS tee_qty
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS it
WHERE  _TABLE_SUFFIX LIKE '202012%'
  AND  event_name = 'purchase'
  AND  LOWER(it.item_name) LIKE '%google%navy%speckled%tee%';
```

```sql
-- 7. Description: Tally quantities of *all* items appearing in any tee order, including the tee
SELECT LOWER(i.item_name) AS item_name,
       SUM(i.quantity)    AS total_qty
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e,
       UNNEST(e.items) AS i
WHERE  _TABLE_SUFFIX LIKE '202012%'
  AND  e.event_name = 'purchase'
  AND  e.ecommerce.transaction_id IN (
        SELECT DISTINCT ecommerce.transaction_id
        FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
               UNNEST(items) AS it
        WHERE  _TABLE_SUFFIX LIKE '202012%'
          AND  event_name = 'purchase'
          AND  LOWER(it.item_name) LIKE '%google%navy%speckled%tee%'
       )
GROUP BY item_name
ORDER BY total_qty DESC
LIMIT 20;
```

```sql
-- 8. Description: Remove the tee itself and order by quantity to see the top “other” product
SELECT LOWER(i.item_name) AS other_item,
       SUM(i.quantity)    AS total_qty
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e,
       UNNEST(e.items) AS i
WHERE  _TABLE_SUFFIX LIKE '202012%'
  AND  e.event_name = 'purchase'
  AND  e.ecommerce.transaction_id IN (
        SELECT DISTINCT ecommerce.transaction_id
        FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
               UNNEST(items) AS it
        WHERE  _TABLE_SUFFIX LIKE '202012%'
          AND  event_name = 'purchase'
          AND  LOWER(it.item_name) LIKE '%google%navy%speckled%tee%'
       )
  AND  LOWER(i.item_name) NOT LIKE '%google%navy%speckled%tee%'
GROUP BY other_item
ORDER BY total_qty DESC
LIMIT 20;
```

```sql
-- 9. Description: Same as #8 but also list how many distinct transactions contained that other product
SELECT LOWER(i.item_name)               AS other_item,
       COUNT(DISTINCT e.ecommerce.transaction_id) AS txn_count,
       SUM(i.quantity)                  AS total_qty
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e,
       UNNEST(e.items) AS i
WHERE  _TABLE_SUFFIX LIKE '202012%'
  AND  e.event_name = 'purchase'
  AND  e.ecommerce.transaction_id IN (
        SELECT DISTINCT ecommerce.transaction_id
        FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
               UNNEST(items) AS it
        WHERE  _TABLE_SUFFIX LIKE '202012%'
          AND  event_name = 'purchase'
          AND  LOWER(it.item_name) LIKE '%google%navy%speckled%tee%'
       )
  AND  LOWER(i.item_name) NOT LIKE '%google%navy%speckled%tee%'
GROUP BY other_item
ORDER BY total_qty DESC
LIMIT 20;
```

```sql
-- 10. Description: Final answer – return the single “other” product with the highest total quantity
SELECT other_item,
       total_qty
FROM (
      SELECT LOWER(i.item_name) AS other_item,
             SUM(i.quantity)    AS total_qty,
             ROW_NUMBER() OVER (ORDER BY SUM(i.quantity) DESC) AS rn
      FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e,
             UNNEST(e.items) AS i
      WHERE  _TABLE_SUFFIX LIKE '202012%'
        AND  e.event_name = 'purchase'
        AND  e.ecommerce.transaction_id IN (
              SELECT DISTINCT ecommerce.transaction_id
              FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
                     UNNEST(items) AS it
              WHERE  _TABLE_SUFFIX LIKE '202012%'
                AND  event_name = 'purchase'
                AND  LOWER(it.item_name) LIKE '%google%navy%speckled%tee%'
             )
        AND  LOWER(i.item_name) NOT LIKE '%google%navy%speckled%tee%'
      GROUP BY other_item
     )
WHERE  rn = 1
LIMIT 20;
```

