WITH tee_txns AS (                                         -- all December tee transactions
  SELECT DISTINCT ecommerce.transaction_id AS txn_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS t
  JOIN UNNEST(t.items) AS it
  WHERE _TABLE_SUFFIX LIKE '202012%'
    AND t.event_name = 'purchase'
    AND LOWER(it.item_name) LIKE '%google%navy%speckled%tee%'
)
