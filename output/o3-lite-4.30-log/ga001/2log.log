--Description: #10 – Final answer: the single “other” product with the greatest total quantity in tee orders
WITH tee_txns AS (                                         -- all December tee transactions
  SELECT DISTINCT ecommerce.transaction_id AS txn_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS t
  JOIN UNNEST(t.items) AS it
  WHERE _TABLE_SUFFIX LIKE '202012%'
    AND t.event_name = 'purchase'
    AND LOWER(it.item_name) LIKE '%google%navy%speckled%tee%'
)
SELECT other_item,
       total_qty
FROM (
  SELECT
    LOWER(i.item_name) AS other_item,
    SUM(i.quantity)    AS total_qty,
    ROW_NUMBER() OVER (ORDER BY SUM(i.quantity) DESC) AS rn
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
  JOIN tee_txns t
    ON t.txn_id = e.ecommerce.transaction_id
  JOIN UNNEST(e.items) AS i
  WHERE _TABLE_SUFFIX LIKE '202012%'
    AND e.event_name = 'purchase'
    AND LOWER(i.item_name) NOT LIKE '%google%navy%speckled%tee%'
  GROUP BY other_item
)
WHERE rn = 1
LIMIT 1
