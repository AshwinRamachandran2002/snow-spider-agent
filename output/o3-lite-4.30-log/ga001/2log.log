    AND event_name = 'purchase'
    AND LOWER(itm.item_name) LIKE '%google%navy%speckled%tee%'
),
co_items AS (
  SELECT i.item_name,
         i.quantity
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
  JOIN tee_txns t
    ON t.txn_id = e.ecommerce.transaction_id
  , UNNEST(e.items) AS i
  WHERE _TABLE_SUFFIX LIKE '202012%'                 -- keep month consistent
    AND e.event_name = 'purchase'
)
SELECT
  item_name,
  SUM(quantity) AS total_quantity
FROM co_items
WHERE LOWER(item_name) NOT LIKE '%google%navy%speckled%tee%'  -- exclude the tee itself
