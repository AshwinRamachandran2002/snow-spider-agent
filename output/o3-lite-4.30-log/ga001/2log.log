```sql
--Description: Find the product (other than the Google Navy Speckled Tee) with the highest total
--quantity purchased in the same December‑2020 transactions as that tee.
--Step 1: tee_txns – collect all transaction_id values where the tee was bought.
--Step 2: co_items – pull every line‑item from those same transactions.
--Step 3: aggregate quantities for items that are *not* the tee and sort descending.
WITH tee_txns AS (
  SELECT DISTINCT ecommerce.transaction_id AS txn_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS itm
