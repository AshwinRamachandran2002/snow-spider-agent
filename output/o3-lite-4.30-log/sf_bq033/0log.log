--Description: 
-- (9) Preview query – show up to 20 rows.  
-- Builds a monthly calendar (2008‑01 through 2022‑12) with GENERATOR,  
-- then counts U.S. publications whose abstract contains “internet of things”  
-- and joins the two sets so that months with zero filings appear as 0.  
-- NOTE: Inside the iot subquery we GROUP BY the positional reference (1)  
--       because Snowflake does not allow re‑using a SELECT‑list alias in GROUP BY.

WITH calendar AS (
    SELECT TO_CHAR(
               DATEADD(month, seq4(), '2008-01-01'::DATE),
               'YYYY-MM'
           ) AS "month_key"
    FROM   TABLE(GENERATOR(ROWCOUNT => 180))     -- 15 years * 12 months
), iot AS (
    SELECT TO_CHAR(
               TO_DATE(p."filing_date"::STRING, 'YYYYMMDD'),
               'YYYY-MM'
           ) AS "month_key",
           COUNT(*) AS "filings"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."abstract_localized") f
    WHERE  p."country_code" = 'US'
      AND  LOWER(f.value:"text"::STRING) LIKE '%internet%of%things%'
      AND  p."filing_date" BETWEEN 20080101 AND 20221231
    GROUP BY 1
)
SELECT  c."month_key",
        COALESCE(i."filings", 0) AS "iot_filings"
FROM    calendar c
LEFT    JOIN iot i
       ON c."month_key" = i."month_key"
ORDER   BY c."month_key"
LIMIT   20
