```sql
--Description:
-- We need monthly counts (YYYY‑MM) of distinct U.S. patent families (family_id)
-- whose abstract text contains the phrase “internet of things”, using filings
-- between 2008‑01‑01 and 2022‑12‑31.
--
-- 1.  Flatten the JSON array “abstract_localized” so each language entry is searchable.
-- 2.  Keep U.S. records only (“country_code” = 'US').
-- 3.  Filter abstracts with a case‑insensitive LIKE on “internet of things”.
-- 4.  Restrict by filing_date numeric range 20080101‑20221231.
-- 5.  For every family_id that survives, take its earliest filing_date (MIN) and
--     turn that date into a YYYY‑MM string (“filing_month”).
-- 6.  Finally, count how many families fall into each filing_month.
WITH per_family AS (
    SELECT  t."family_id",
            TO_CHAR(
                TO_DATE(MIN(t."filing_date")::STRING, 'YYYYMMDD'),
                'YYYY-MM'
            ) AS "filing_month"
    FROM    PATENTS.PATENTS.PUBLICATIONS t,
            LATERAL FLATTEN(input => t."abstract_localized") f
    WHERE   t."country_code" = 'US'
      AND   LOWER(f.value:"text"::STRING) LIKE '%internet%of%things%'
      AND   t."filing_date" BETWEEN 20080101 AND 20221231
    GROUP BY t."family_id"
)
SELECT  p."filing_month"    AS "family_filing_month",
        COUNT(*)            AS "family_count"
FROM    per_family p
GROUP BY p."filing_month"
ORDER BY p."filing_month";
```
