Begin Exploring Related Columns
Relevant columns and how they will be used  

• customers."Country" : to know a customer’s country.  
• customers."CustomerId" : needed to join customers to invoices.  
• invoices."CustomerId" : lets us map an invoice back to a customer (and therefore to a country).  
• invoices."BillingCountry" : second way to know the country that bought the invoice (will be used for filtering; it lines‑up with customers."Country").  
• invoices."Total" : the sales amount whose median we need.  

Main condition  

• Only consider those countries that have more than 4 customers (COUNT(customers."CustomerId") > 4).  

Below are ten exploratory – increasingly complex – SQL queries that lead to the final result.  
(Each query is independent; LIMIT 20 added where the row‑set could be large.)

```sql
-- 1) Countries that appear in the customers table
SELECT DISTINCT "Country"
FROM "customers"
LIMIT 20;
```

```sql
-- 2) How many customers are in each country
SELECT "Country", COUNT(*) AS "num_customers"
FROM "customers"
GROUP BY "Country"
ORDER BY "num_customers" DESC
LIMIT 20;
```

```sql
-- 3) Countries that have more than 4 customers
SELECT "Country"
FROM "customers"
GROUP BY "Country"
HAVING COUNT(*) > 4
ORDER BY "Country"
LIMIT 20;
```

```sql
-- 4) Show a few invoices together with their billing country and total
SELECT "InvoiceId", "BillingCountry", "Total"
FROM "invoices"
ORDER BY "InvoiceId"
LIMIT 20;
```

```sql
-- 5) Invoices that belong to countries with >4 customers
SELECT i."InvoiceId", i."BillingCountry", i."Total"
FROM   "invoices"  AS i
WHERE  i."BillingCountry" IN (
         SELECT "Country"
         FROM   "customers"
         GROUP  BY "Country"
         HAVING COUNT(*) > 4
       )
ORDER BY i."BillingCountry", i."InvoiceId"
LIMIT 20;
```

```sql
-- 6) Just the numeric Total column for those invoices (quick glance)
SELECT i."Total"
FROM   "invoices" AS i
WHERE  i."BillingCountry" IN (
         SELECT "Country"
         FROM   "customers"
         GROUP  BY "Country"
         HAVING COUNT(*) > 4
       )
ORDER BY i."Total"
LIMIT 20;
```

```sql
-- 7) Order all relevant invoice totals and give each row a running number
WITH relevant_invoices AS (
  SELECT i."Total"
  FROM   "invoices" AS i
  WHERE  i."BillingCountry" IN (
           SELECT "Country"
           FROM   "customers"
           GROUP  BY "Country"
           HAVING COUNT(*) > 4
         )
)
SELECT "Total",
       ROW_NUMBER()  OVER (ORDER BY "Total")            AS "row_num",
       COUNT(*)      OVER ()                            AS "total_rows"
FROM   relevant_invoices
ORDER  BY "Total"
LIMIT 20;
```

```sql
-- 8) Find the middle position(s) needed for a median
WITH relevant_invoices AS (
  SELECT i."Total"
  FROM   "invoices" AS i
  WHERE  i."BillingCountry" IN (
           SELECT "Country"
           FROM   "customers"
           GROUP  BY "Country"
           HAVING COUNT(*) > 4
         )
),
ordered AS (
  SELECT "Total",
         ROW_NUMBER() OVER (ORDER BY "Total") AS "rn",
         COUNT(*)   OVER ()                   AS "cnt"
  FROM   relevant_invoices
)
SELECT *
FROM   ordered
WHERE  rn = cnt/2
    OR rn = cnt/2 + 1   -- keeps both middle rows when cnt is even
ORDER  BY rn
LIMIT 20;
```

```sql
-- 9) Derive the median by averaging the middle value(s)
WITH relevant_invoices AS (
  SELECT i."Total"
  FROM   "invoices" AS i
  WHERE  i."BillingCountry" IN (
           SELECT "Country"
           FROM   "customers"
           GROUP  BY "Country"
           HAVING COUNT(*) > 4
         )
),
ordered AS (
  SELECT "Total",
         ROW_NUMBER() OVER (ORDER BY "Total") AS "rn",
         COUNT(*)   OVER ()                   AS "cnt"
  FROM   relevant_invoices
)
SELECT AVG("Total") AS "median_total_sales"
FROM   ordered
WHERE  rn = cnt/2
    OR rn = cnt/2 + 1;
```

```sql
-- 10) Final succinct query that returns only the median value
WITH country_filter AS (
  SELECT "Country"
  FROM   "customers"
  GROUP  BY "Country"
  HAVING COUNT(*) > 4
),
all_totals AS (
  SELECT i."Total"
  FROM   "invoices" AS i
  WHERE  i."BillingCountry" IN (SELECT "Country" FROM country_filter)
),
pos AS (
  SELECT "Total",
         ROW_NUMBER() OVER (ORDER BY "Total") AS rn,
         COUNT(*)   OVER ()                   AS cnt
  FROM   all_totals
)
SELECT ROUND(AVG("Total"), 2) AS "median_total_sales"
FROM   pos
WHERE  rn IN (cnt/2, cnt/2 + 1);
```

