2025-05-01 03:16:28 - Thread-1285 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
customers."Country": to know each customer’s country  
customers."CustomerId": primary‑key used to join with invoices  
invoices."CustomerId": lets us tie every invoice to a customer  
invoices."Total": money paid on each invoice, the value whose median we need  
(Condition)  COUNT(customers."CustomerId") > 4  → keeps only those countries that have more than 4 customers  

Below are ten progressively richer SELECT statements (each limited to 20 rows unless it is the final answer) that lead from simple inspection to the median calculation.  

```sql
-- 1. List every country that appears in the customers table
SELECT DISTINCT c."Country"
FROM "customers" AS c
LIMIT 20;
```

```sql
-- 2. Count how many customers live in each country
SELECT c."Country",
       COUNT(*) AS "num_customers"
FROM "customers" AS c
GROUP BY c."Country"
ORDER BY "num_customers" DESC
LIMIT 20;
```

```sql
-- 3. Show only those countries whose customer count is greater than 4
SELECT c."Country",
       COUNT(*) AS "num_customers"
FROM "customers" AS c
GROUP BY c."Country"
HAVING COUNT(*) > 4
ORDER BY "num_customers" DESC
LIMIT 20;
```

```sql
-- 4. Quick look at invoices: which customer bought, when, and how much
SELECT i."InvoiceId",
       i."CustomerId",
       i."BillingCountry",
       i."Total"
FROM "invoices" AS i
LIMIT 20;
```

```sql
-- 5. Join invoices with customers and keep only countries with >4 customers
WITH big_countries AS (
  SELECT "Country"
  FROM "customers"
  GROUP BY "Country"
  HAVING COUNT(*) > 4
)
SELECT i."InvoiceId",
       i."Total",
       c."Country"
FROM   "invoices"  AS i
JOIN   "customers" AS c USING ("CustomerId")
WHERE  c."Country" IN (SELECT "Country" FROM big_countries)
LIMIT 20;
```

```sql
-- 6. Just the invoice totals we will base the median on
WITH big_countries AS (
  SELECT "Country"
  FROM "customers"
  GROUP BY "Country"
  HAVING COUNT(*) > 4
)
SELECT i."Total"
FROM   "invoices"  AS i
JOIN   "customers" AS c USING ("CustomerId")
WHERE  c."Country" IN (SELECT "Country" FROM big_countries)
ORDER BY i."Total"
LIMIT 20;
```

```sql
-- 7. Add a running row number (window function) to the ordered totals
WITH big_countries AS (
  SELECT "Country"
  FROM "customers"
  GROUP BY "Country"
  HAVING COUNT(*) > 4
), invoice_totals AS (
  SELECT i."Total"
  FROM   "invoices"  AS i
  JOIN   "customers" AS c USING ("CustomerId")
  WHERE  c."Country" IN (SELECT "Country" FROM big_countries)
)
SELECT it."Total",
       ROW_NUMBER() OVER (ORDER BY it."Total") AS "rn"
FROM   invoice_totals AS it
LIMIT 20;
```

```sql
-- 8. Show each total with its row number and the overall count
WITH big_countries AS (
  SELECT "Country"
  FROM "customers"
  GROUP BY "Country"
  HAVING COUNT(*) > 4
), invoice_totals AS (
  SELECT i."Total"
  FROM   "invoices"  AS i
  JOIN   "customers" AS c USING ("CustomerId")
  WHERE  c."Country" IN (SELECT "Country" FROM big_countries)
)
SELECT it."Total",
       ROW_NUMBER() OVER (ORDER BY it."Total")       AS "rn",
       COUNT(*)   OVER ()                            AS "cnt"
FROM   invoice_totals AS it
LIMIT 20;
```

```sql
-- 9. Identify which row numbers correspond to the median
WITH big_countries AS (
  SELECT "Country"
  FROM "customers"
  GROUP BY "Country"
  HAVING COUNT(*) > 4
), invoice_totals AS (
  SELECT i."Total"
  FROM   "invoices"  AS i
  JOIN   "customers" AS c USING ("CustomerId")
  WHERE  c."Country" IN (SELECT "Country" FROM big_countries)
), ordered_totals AS (
  SELECT it."Total",
         ROW_NUMBER() OVER (ORDER BY it."Total") AS "rn",
         COUNT(*) OVER ()                        AS "cnt"
  FROM   invoice_totals AS it
)
SELECT "Total", "rn", "cnt"
FROM   ordered_totals
WHERE  "rn" IN ( (cnt+1)/2, (cnt+2)/2 )
LIMIT 20;
```

```sql
-- 10. FINAL: compute the median total sales for invoices coming from
--     countries that have more than 4 customers
WITH country_customer_cnt AS (
  SELECT "Country",
         COUNT(*) AS "customer_cnt"
  FROM   "customers"
  GROUP BY "Country"
  HAVING COUNT(*) > 4
), qualifying_invoices AS (
  SELECT i."Total"
  FROM   "invoices"  AS i
  JOIN   "customers" AS c USING ("CustomerId")
  WHERE  c."Country" IN (SELECT "Country"
                         FROM country_customer_cnt)
), ordered AS (
  SELECT q."Total",
         ROW_NUMBER() OVER (ORDER BY q."Total") AS "rn",
         COUNT(*)   OVER ()                     AS "cnt"
  FROM   qualifying_invoices AS q
)
SELECT AVG("Total") AS "median_total_sales"
FROM   ordered
WHERE  "rn" IN ( (cnt + 1)/2, (cnt + 2)/2 );
```

