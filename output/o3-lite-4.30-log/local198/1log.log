Begin Exploring Related Columns
Relevant columns and their potential usage
• customers."CustomerId": joins customers to their invoices  
• customers."Country": used to count customers per country and filter countries with > 4 customers  
• invoices."CustomerId": joins invoices to the owning customer  
• invoices."Total": the money value for each sale (each invoice) – the data on which we will calculate the median  

Below are ten exploratory SQL statements that gradually build up to the final answer.  
(Every query except the last one is limited to 20 rows so that you can peek at the data without flooding the console.)

```sql
-- 1. Look at a sample of the customers table
SELECT *
FROM "customers"
LIMIT 20;
```

```sql
-- 2. Count how many customers each country has
SELECT c."Country",
       COUNT(*) AS num_customers
FROM "customers" AS c
GROUP BY c."Country"
ORDER BY num_customers DESC
LIMIT 20;
```

```sql
-- 3. Which countries have more than 4 customers?
SELECT c."Country"
FROM "customers" AS c
GROUP BY c."Country"
HAVING COUNT(*) > 4
ORDER BY c."Country"
LIMIT 20;
```

```sql
-- 4. Quick look at the invoices table
SELECT *
FROM "invoices"
LIMIT 20;
```

```sql
-- 5. Join invoices to customers so we can use the customer’s country
SELECT i."InvoiceId",
       i."Total",
       c."Country"
FROM   "invoices"  AS i
JOIN   "customers" AS c  ON c."CustomerId" = i."CustomerId"
LIMIT 20;
```

```sql
-- 6. Only the invoices that belong to countries with >4 customers
SELECT i."InvoiceId",
       i."Total",
       c."Country"
FROM   "invoices"  AS i
JOIN   "customers" AS c  ON c."CustomerId" = i."CustomerId"
WHERE  c."Country" IN (
       SELECT c2."Country"
       FROM   "customers" AS c2
       GROUP  BY c2."Country"
       HAVING COUNT(*) > 4)
LIMIT 20;
```

```sql
-- 7. Show just the Total column for those invoices, ordered for visual inspection
SELECT i."Total"
FROM   "invoices"  AS i
JOIN   "customers" AS c  ON c."CustomerId" = i."CustomerId"
WHERE  c."Country" IN (
       SELECT c2."Country"
       FROM   "customers" AS c2
       GROUP  BY c2."Country"
       HAVING COUNT(*) > 4)
ORDER BY i."Total"
LIMIT 20;
```

```sql
-- 8. Attach a row number and a total‑row count to each selected invoice total
WITH Eligible AS (
  SELECT i."Total"
  FROM   "invoices"  AS i
  JOIN   "customers" AS c  ON c."CustomerId" = i."CustomerId"
  WHERE  c."Country" IN (
         SELECT c2."Country"
         FROM   "customers" AS c2
         GROUP  BY c2."Country"
         HAVING COUNT(*) > 4)
)
SELECT e."Total",
       ROW_NUMBER() OVER (ORDER BY e."Total")      AS rn,
       COUNT(*)  OVER ()                           AS cnt
FROM   Eligible AS e
ORDER  BY e."Total"
LIMIT 20;
```

```sql
-- 9. Compute the two “middle” rows that will form the median
WITH Eligible AS (
  SELECT i."Total"
  FROM   "invoices"  AS i
  JOIN   "customers" AS c  ON c."CustomerId" = i."CustomerId"
  WHERE  c."Country" IN (
         SELECT c2."Country"
         FROM   "customers" AS c2
         GROUP  BY c2."Country"
         HAVING COUNT(*) > 4)
),
Ordered AS (
  SELECT e."Total",
         ROW_NUMBER() OVER (ORDER BY e."Total") AS rn,
         COUNT(*) OVER ()                       AS cnt
  FROM   Eligible AS e
)
SELECT o."Total", o.rn, o.cnt
FROM   Ordered AS o
WHERE  o.rn IN ( (o.cnt+1)/2, (o.cnt+2)/2 )
ORDER  BY o.rn
LIMIT 20;
```

```sql
-- 10. Final query: median value of total sales made in countries having >4 customers
WITH EligibleCountries AS (
    SELECT c."Country"
    FROM   "customers" AS c
    GROUP  BY c."Country"
    HAVING COUNT(*) > 4
),
CountryInvoices AS (
    SELECT i."Total"
    FROM   "invoices"  AS i
    JOIN   "customers" AS c ON c."CustomerId" = i."CustomerId"
    WHERE  c."Country" IN (SELECT "Country" FROM EligibleCountries)
),
OrderedTotals AS (
    SELECT ci."Total",
           ROW_NUMBER() OVER (ORDER BY ci."Total") AS rn,
           COUNT(*)  OVER ()                       AS cnt
    FROM   CountryInvoices AS ci
)
SELECT AVG("Total") AS median_total_sales
FROM   OrderedTotals
WHERE  rn IN ( (cnt+1)/2, (cnt+2)/2 );
```

Run the last statement to obtain the required median of invoice totals for all countries where the customer count exceeds four.
