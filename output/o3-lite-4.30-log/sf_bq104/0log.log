```sql
--Description / thinking process:
-- 1. Find the most‑recent “week” in the TOP_RISING_TERMS table (latest_wk).
-- 2. Roll that date back by exactly 52 weeks (one full year of weeks) to keep the same day‑of‑week; call it target_wk.
-- 3. Identify the smallest rank recorded during target_wk (top spot).
-- 4. Return the row(s) whose week = target_wk and rank = that smallest value,
--    which reveals the top‑ranked rising search term one year earlier.

WITH latest_wk AS (
    SELECT MAX("week") AS "latest_week"
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
),
target_wk AS (
    SELECT DATEADD(week, -52, "latest_week") AS "target_week"
    FROM latest_wk
),
best_rank AS (
    SELECT MIN("rank") AS "min_rank"
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
    WHERE "week" = (SELECT "target_week" FROM target_wk)
)
SELECT
    "week",
    "term",
    "rank",
    "percent_gain",
    "dma_name"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
WHERE "week" = (SELECT "target_week" FROM target_wk)
  AND "rank" = (SELECT "min_rank" FROM best_rank)
ORDER BY "term"
LIMIT 20;
```
