```sql
--Description / thinking‑process inside one query:
-- ① Find the most‑recent “week” in the TOP_RISING_TERMS table → latest_week CTE.
-- ② Compute the week that is exactly one year earlier (DATEADD(year,-1, …)) → target_week CTE.
-- ③ Within that target_week, obtain the lowest numeric rank (the top spot) → top_rank CTE.
-- ④ Return the row(s) from target_week whose rank equals that top_rank, revealing
--    the top‑ranked rising search term one year prior to the latest week.

WITH latest_week AS (
    SELECT MAX("week") AS "latest_week"
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
), target_week AS (
    SELECT DATEADD(year, -1, "latest_week") AS "target_week"
    FROM latest_week
), top_rank AS (
    SELECT MIN("rank") AS "min_rank"
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS tr
    JOIN target_week tw
      ON tr."week" = tw."target_week"
)
SELECT tr."week",
       tr."term",
       tr."rank",
       tr."percent_gain",
       tr."dma_name"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS tr
JOIN target_week tw
  ON tr."week" = tw."target_week"
JOIN top_rank trk
  ON tr."rank" = trk."min_rank"
ORDER BY tr."term"
LIMIT 20;
```
