Begin Exploring Related Columns
Relevant columns and their potential usage for this task  

• "refresh_date": to locate the most‑recent ingestion of the data set.  
• "week"         : to find the latest week, and later calculate the week exactly one year earlier.  
• "rank"         : to decide which term is “top‑ranked” (lowest numeric value).  
• "term"         : the rising search phrase we ultimately want.  
• "dma_id", "dma_name", "percent_gain", "score": optional context / tie‑breakers.  

Typical conditions that may be useful  

1. WHERE "refresh_date" = (SELECT MAX("refresh_date") …)  
2. WHERE "week" = (SELECT MAX("week") …)  
3. DATEADD(year,‑1, <latest_week>) to reach the target comparison week.  
4. ORDER BY "rank" ASC LIMIT 1 to isolate the top‑ranked term.  

Below are ten exploratory Snowflake SQL queries (each guarded with a short comment) that progressively drill down to the final information.  
All column names are enclosed in double quotes; every query is capped at 20 rows with LIMIT 20.  

```sql
-- 1) Description: Check the newest refresh date available in the TOP_RISING_TERMS table
SELECT MAX("refresh_date") AS "latest_refresh_date"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
LIMIT 20;
```

```sql
-- 2) Description: List all rows that share the most‑recent refresh date
SELECT *
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
WHERE "refresh_date" = (
      SELECT MAX("refresh_date")
      FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
)
LIMIT 20;
```

```sql
-- 3) Description: Find the latest week within the most‑recent refresh batch
SELECT MAX("week") AS "latest_week"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
WHERE "refresh_date" = (
      SELECT MAX("refresh_date")
      FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
)
LIMIT 20;
```

```sql
-- 4) Description: Display all rising search terms for the latest week
SELECT *
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
WHERE "week" = (
      SELECT MAX("week")
      FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
      WHERE "refresh_date" = (SELECT MAX("refresh_date")
                              FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS)
)
LIMIT 20;
```

```sql
-- 5) Description: Determine the week exactly one year before the latest week
SELECT DATEADD(year, -1, (
          SELECT MAX("week")
          FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
          WHERE "refresh_date" = (SELECT MAX("refresh_date")
                                  FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS)
       )) AS "week_minus_1yr"
LIMIT 20;
```

```sql
-- 6) Description: Preview records for the week one year prior to the latest week
SELECT *
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
WHERE "week" = (
      SELECT DATEADD(year, -1, MAX("week"))
      FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
      WHERE "refresh_date" = (SELECT MAX("refresh_date")
                              FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS)
)
LIMIT 20;
```

```sql
-- 7) Description: Check distinct DMA markets represented in that earlier week
SELECT DISTINCT "dma_id", "dma_name"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
WHERE "week" = (
      SELECT DATEADD(year, -1, MAX("week"))
      FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
      WHERE "refresh_date" = (SELECT MAX("refresh_date")
                              FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS)
)
LIMIT 20;
```

```sql
-- 8) Description: Rank the terms for the target week by ascending rank
SELECT "rank", "term", "percent_gain"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
WHERE "week" = (
      SELECT DATEADD(year, -1, MAX("week"))
      FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
      WHERE "refresh_date" = (SELECT MAX("refresh_date")
                              FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS)
)
ORDER BY "rank" ASC
LIMIT 20;
```

```sql
-- 9) Description: Same as #8 but restrict to the single best ranked term
SELECT "rank", "term", "percent_gain"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
WHERE "week" = (
      SELECT DATEADD(year, -1, MAX("week"))
      FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
      WHERE "refresh_date" = (SELECT MAX("refresh_date")
                              FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS)
)
ORDER BY "rank" ASC
LIMIT 1;
```

```sql
-- 10) Description: Final query — locate the single top‑ranked rising search term
WITH t AS (
     SELECT
         MAX("refresh_date")      AS "latest_refresh_date"
     FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
), w AS (
     SELECT
         MAX(r."week")            AS "latest_week"
     FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS r
     JOIN t ON r."refresh_date" = t."latest_refresh_date"
), target_week AS (
     SELECT
         DATEADD(year, -1, w."latest_week") AS "one_year_prior_week"
     FROM w
)
SELECT
       r."term",
       r."rank",
       r."percent_gain",
       r."week"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS r
JOIN target_week tw
  ON r."week" = tw."one_year_prior_week"
ORDER BY r."rank" ASC
LIMIT 1;
```
