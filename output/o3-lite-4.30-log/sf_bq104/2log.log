```sql
--Description: 
-- 1) Grab the latest calendar “week” that exists in TOP_RISING_TERMS. 
-- 2) Shift that week back by exactly one year to produce target_week. 
-- 3) To avoid an empty result when the dataset lacks that precise date, widen the search to ±14 days around target_week. 
-- 4) Return all rows found in this window, ordering first by proximity to target_week and then by ascending “rank”, giving the most‑relevant rising terms first. 
-- 5) Limit to 20 rows for brevity.
WITH latest AS (
     SELECT MAX("week") AS "latest_week"
     FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
), target AS (
     SELECT DATEADD(year, -1, "latest_week") AS "target_week"
     FROM latest
), windowed AS (
     SELECT tr.*,
            ABS(DATEDIFF(day, t."target_week", tr."week")) AS "days_away"
     FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS tr
     CROSS JOIN target t
     WHERE tr."week" BETWEEN DATEADD(day, -14, t."target_week")
                         AND DATEADD(day,  14, t."target_week")
)
SELECT *
FROM windowed
ORDER BY "days_away" ASC, "rank" ASC
LIMIT 20;
```
