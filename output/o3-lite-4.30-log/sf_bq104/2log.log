```sql
--Description / Thinking process:
-- • Step‑1: Determine the freshest week in the entire TOP_RISING_TERMS table (no refresh_date filter this time).  
-- • Step‑2: Compute the week that falls exactly one calendar year before that freshest week.  
-- • Step‑3: Pull every record whose "week" equals the derived one‑year‑prior date.  
-- • Step‑4: Order by "rank" so the top‑ranked rising term is shown first, give us up to 20 rows as a snapshot.
WITH latest_week AS (
    SELECT MAX("week") AS "max_week"
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
)
SELECT *
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
WHERE "week" = (
        SELECT DATEADD(year, -1, "max_week")
        FROM latest_week
)
ORDER BY "rank" ASC
LIMIT 20;
