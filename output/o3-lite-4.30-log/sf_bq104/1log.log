WITH latest_data AS (
    SELECT *
    FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
    WHERE "refresh_date" = (SELECT MAX("refresh_date")
                            FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS")
), latest_week AS (
    SELECT MAX("week") AS max_week
    FROM latest_data
), target_week AS (
    SELECT DATEADD(week, -52, max_week) AS week_prior
    FROM latest_week
)
SELECT "term" AS rising_search_term
FROM latest_data
WHERE "week" = (SELECT week_prior FROM target_week)
  AND "rank" = 1
ORDER BY "percent_gain" DESC NULLS LAST
LIMIT 1;
```
