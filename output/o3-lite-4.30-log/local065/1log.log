• pizza_names.pizza_id / pizza_names.pizza_name : maps pizza‑id to its name to decide price ($12 vs $10)  
• pizza_get_extras.order_id : links extra toppings back to an order  
• pizza_get_extras.extras_count : number of extra toppings on that order (every extra costs $1)  

Key conditions we will need  
1. pizza_clean_runner_orders.cancellation IS NULL OR cancellation = ''  
2. pizza_clean_customer_orders.pizza_id IN (1,2)                    -- 1 = Meat Lovers, 2 = Vegetarian  

-------------------------------------------------------------------
Step‑by‑step exploration – 10 short inspection queries

```sql
-- 1. Description: All pizza names and their id’s
SELECT DISTINCT pizza_id, pizza_name
FROM pizza_names
LIMIT 20;
```

```sql
-- 2. Description: Raw view of cleaned customer orders
SELECT DISTINCT order_id, customer_id, pizza_id, exclusions, extras
FROM pizza_clean_customer_orders
LIMIT 20;
```

```sql
-- 3. Description: Which orders are for Meat Lovers or Vegetarian
SELECT DISTINCT c.order_id, n.pizza_name
FROM pizza_clean_customer_orders AS c
JOIN pizza_names                AS n USING (pizza_id)
WHERE c.pizza_id IN (1,2)
LIMIT 20;
```

```sql
-- 4. Description: Check runner side – look for any cancellations
SELECT DISTINCT order_id, cancellation
FROM pizza_clean_runner_orders
LIMIT 20;
```

```sql
-- 5. Description: Only orders that were *not* cancelled
SELECT DISTINCT r.order_id
FROM pizza_clean_runner_orders AS r
WHERE r.cancellation IS NULL OR r.cancellation = ''
LIMIT 20;
```

```sql
-- 6. Description: Inspect extra‑topping rows (one row per topping)
SELECT DISTINCT order_id, extras, extras_count
FROM pizza_get_extras
LIMIT 20;
```

```sql
-- 7. Description: Aggregate extras – how many paid extras per order
SELECT order_id,
       SUM(extras_count) AS total_extras
FROM   pizza_get_extras
GROUP  BY order_id
LIMIT 20;
```

```sql
-- 8. Description: Join everything and compute the price *per order*
SELECT c.order_id,
       CASE c.pizza_id
            WHEN 1 THEN 12      -- Meat Lovers
            WHEN 2 THEN 10      -- Vegetarian
       END                           AS base_price,
       COALESCE(e.total_extras,0)    AS extra_dollars,
       CASE c.pizza_id
            WHEN 1 THEN 12
            WHEN 2 THEN 10
       END + COALESCE(e.total_extras,0)  AS order_revenue
FROM   pizza_clean_customer_orders AS c
JOIN   pizza_clean_runner_orders   AS r  USING (order_id)
LEFT   JOIN (
        SELECT order_id, SUM(extras_count) AS total_extras
        FROM   pizza_get_extras
        GROUP  BY order_id
       ) AS e USING (order_id)
WHERE  (r.cancellation IS NULL OR r.cancellation = '')
AND    c.pizza_id IN (1,2)
LIMIT 20;
```

```sql
-- 9. Description: Same as #8 but group to show subtotal per pizza type
SELECT n.pizza_name,
       SUM( CASE c.pizza_id WHEN 1 THEN 12 WHEN 2 THEN 10 END )        AS pizza_revenue,
       SUM( COALESCE(e.total_extras,0) )                               AS extras_revenue
FROM   pizza_clean_customer_orders AS c
JOIN   pizza_clean_runner_orders   AS r  USING (order_id)
LEFT   JOIN (
        SELECT order_id, SUM(extras_count) AS total_extras
        FROM   pizza_get_extras
        GROUP  BY order_id
       ) AS e USING (order_id)
JOIN   pizza_names                 AS n USING (pizza_id)
WHERE  (r.cancellation IS NULL OR r.cancellation = '')
AND    c.pizza_id IN (1,2)
GROUP  BY n.pizza_name
LIMIT 20;
```

```sql
-- 10. Description: FINAL – total money earned from delivered Meat Lovers and Vegetarian orders
SELECT SUM(
         CASE c.pizza_id
              WHEN 1 THEN 12
              WHEN 2 THEN 10
         END + COALESCE(e.total_extras,0)
       ) AS total_income_usd
FROM   pizza_clean_customer_orders AS c
JOIN   pizza_clean_runner_orders   AS r  USING (order_id)
LEFT   JOIN (
        SELECT order_id, SUM(extras_count) AS total_extras
        FROM   pizza_get_extras
        GROUP  BY order_id
       ) AS e USING (order_id)
WHERE  (r.cancellation IS NULL OR r.cancellation = '')
AND    c.pizza_id IN (1,2);
```

