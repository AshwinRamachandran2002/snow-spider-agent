Query:
-- 10) Combined summary: total vs. Black counts for vehicle and firearm deaths (12‑18)
SELECT
    a."Age",
    a."vehicle_deaths_total",
    COALESCE(b."vehicle_black_deaths", 0)   AS "vehicle_black_deaths",
    c."firearm_deaths_total",
    COALESCE(d."firearm_black_deaths", 0)   AS "firearm_black_deaths"
FROM (
        SELECT d."Age", COUNT(DISTINCT d."Id") AS "vehicle_deaths_total"
        FROM DEATH.DEATH."DEATHRECORDS" d
        JOIN DEATH.DEATH."ENTITYAXISCONDITIONS" ec ON ec."DeathRecordId" = d."Id"
        JOIN DEATH.DEATH."ICD10CODE" i ON i."Code" = ec."Icd10Code"
        WHERE d."Age" BETWEEN 12 AND 18
          AND i."Description" ILIKE '%vehicle%'
        GROUP BY d."Age"
     ) a
LEFT JOIN (
        SELECT d."Age", COUNT(DISTINCT d."Id") AS "vehicle_black_deaths"
        FROM DEATH.DEATH."DEATHRECORDS" d
        JOIN DEATH.DEATH."ENTITYAXISCONDITIONS" ec ON ec."DeathRecordId" = d."Id"
        JOIN DEATH.DEATH."ICD10CODE" i ON i."Code" = ec."Icd10Code"
        JOIN DEATH.DEATH."RACE" r           ON r."Code" = d."Race"
        WHERE d."Age" BETWEEN 12 AND 18
          AND i."Description" ILIKE '%vehicle%'
          AND r."Description" ILIKE '%black%'
        GROUP BY d."Age"
     ) b  ON a."Age" = b."Age"
LEFT JOIN (
        SELECT d."Age", COUNT(DISTINCT d."Id") AS "firearm_deaths_total"
        FROM DEATH.DEATH."DEATHRECORDS" d
        JOIN DEATH.DEATH."ENTITYAXISCONDITIONS" ec ON ec."DeathRecordId" = d."Id"
        JOIN DEATH.DEATH."ICD10CODE" i ON i."Code" = ec."Icd10Code"
        WHERE d."Age" BETWEEN 12 AND 18
          AND i."Description" ILIKE '%firearm%'
        GROUP BY d."Age"
     ) c  ON a."Age" = c."Age"
LEFT JOIN (
        SELECT d."Age", COUNT(DISTINCT d."Id") AS "firearm_black_deaths"
        FROM DEATH.DEATH."DEATHRECORDS" d
        JOIN DEATH.DEATH."ENTITYAXISCONDITIONS" ec ON ec."DeathRecordId" = d."Id"
        JOIN DEATH.DEATH."ICD10CODE" i ON i."Code" = ec."Icd10Code"
        JOIN DEATH.DEATH."RACE" r           ON r."Code" = d."Race"
        WHERE d."Age" BETWEEN 12 AND 18
          AND i."Description" ILIKE '%firearm%'
          AND r."Description" ILIKE '%black%'
        GROUP BY d."Age"
     ) d  ON a."Age" = d."Age"
ORDER BY a."Age"
LIMIT 20;
