Begin Exploring Related Columns
Relevant columns and their potential usage  
• DEATHRECORDS."Id": primary‐key for each death – join to ENTITYAXISCONDITIONS."DeathRecordId".  
• DEATHRECORDS."Age": filter to 12‑18 (inclusive).  
• DEATHRECORDS."Race": race code of the decedent – join to RACE."Code".  
• ENTITYAXISCONDITIONS."DeathRecordId": link to the death record.  
• ENTITYAXISCONDITIONS."Icd10Code": ICD‑10 code involved in the death – join to ICD10CODE."Code".  
• ICD10CODE."Description": filter codes whose text ILIKE '%vehicle%' or ILIKE '%firearm%'.  
• RACE."Description": identify rows whose text ILIKE '%black%' to tag Black decedents.  

Common conditions you will use  
• d."Age" BETWEEN 12 AND 18  
• i."Description" ILIKE '%vehicle%'   (or  '%firearm%')  
• r."Description" ILIKE '%black%'  

Below are ten exploratory Snowflake SQL queries (each limited to 20 rows, all identifiers double‑quoted) that move from simple inspection to the final combined aggregation.

```sql
-- 1) Distinct ages between 12 and 18 in the data set
SELECT DISTINCT "Age"
FROM DEATH.DEATH."DEATHRECORDS"
WHERE "Age" BETWEEN 12 AND 18
LIMIT 20;
```

```sql
-- 2) Show race codes whose description contains the word “black”
SELECT r."Code", r."Description"
FROM DEATH.DEATH."RACE" r
WHERE r."Description" ILIKE '%black%'
LIMIT 20;
```

```sql
-- 3) List ICD‑10 codes whose description contains “vehicle”
SELECT i."Code", i."Description"
FROM DEATH.DEATH."ICD10CODE" i
WHERE i."Description" ILIKE '%vehicle%'
LIMIT 20;
```

```sql
-- 4) List ICD‑10 codes whose description contains “firearm”
SELECT i."Code", i."Description"
FROM DEATH.DEATH."ICD10CODE" i
WHERE i."Description" ILIKE '%firearm%'
LIMIT 20;
```

```sql
-- 5) Sample of deaths (age 12‑18) associated with any “vehicle” codes
SELECT d."Id", d."Age", ec."Icd10Code", i."Description"
FROM DEATH.DEATH."DEATHRECORDS" d
JOIN DEATH.DEATH."ENTITYAXISCONDITIONS" ec
  ON ec."DeathRecordId" = d."Id"
JOIN DEATH.DEATH."ICD10CODE" i
  ON i."Code" = ec."Icd10Code"
WHERE d."Age" BETWEEN 12 AND 18
  AND i."Description" ILIKE '%vehicle%'
LIMIT 20;
```

```sql
-- 6) Sample of deaths (age 12‑18) associated with any “firearm” codes
SELECT d."Id", d."Age", ec."Icd10Code", i."Description"
FROM DEATH.DEATH."DEATHRECORDS" d
JOIN DEATH.DEATH."ENTITYAXISCONDITIONS" ec
  ON ec."DeathRecordId" = d."Id"
JOIN DEATH.DEATH."ICD10CODE" i
  ON i."Code" = ec."Icd10Code"
WHERE d."Age" BETWEEN 12 AND 18
  AND i."Description" ILIKE '%firearm%'
LIMIT 20;
```

```sql
-- 7) Total vehicle‑related deaths by single year of age (12‑18)
SELECT d."Age",
       COUNT(DISTINCT d."Id") AS "vehicle_deaths_total"
FROM DEATH.DEATH."DEATHRECORDS" d
JOIN DEATH.DEATH."ENTITYAXISCONDITIONS" ec
  ON ec."DeathRecordId" = d."Id"
JOIN DEATH.DEATH."ICD10CODE" i
  ON i."Code" = ec."Icd10Code"
WHERE d."Age" BETWEEN 12 AND 18
  AND i."Description" ILIKE '%vehicle%'
GROUP BY d."Age"
ORDER BY d."Age"
LIMIT 20;
```

```sql
-- 8) Vehicle‑related deaths among Black decedents (12‑18)
SELECT d."Age",
       COUNT(DISTINCT d."Id") AS "vehicle_black_deaths"
FROM DEATH.DEATH."DEATHRECORDS" d
JOIN DEATH.DEATH."ENTITYAXISCONDITIONS" ec
  ON ec."DeathRecordId" = d."Id"
JOIN DEATH.DEATH."ICD10CODE" i
  ON i."Code" = ec."Icd10Code"
JOIN DEATH.DEATH."RACE" r
  ON r."Code" = d."Race"
WHERE d."Age" BETWEEN 12 AND 18
  AND i."Description" ILIKE '%vehicle%'
  AND r."Description" ILIKE '%black%'
GROUP BY d."Age"
ORDER BY d."Age"
LIMIT 20;
```

```sql
-- 9) Total firearm‑related deaths by single year of age (12‑18)
SELECT d."Age",
       COUNT(DISTINCT d."Id") AS "firearm_deaths_total"
FROM DEATH.DEATH."DEATHRECORDS" d
JOIN DEATH.DEATH."ENTITYAXISCONDITIONS" ec
  ON ec."DeathRecordId" = d."Id"
JOIN DEATH.DEATH."ICD10CODE" i
  ON i."Code" = ec."Icd10Code"
WHERE d."Age" BETWEEN 12 AND 18
  AND i."Description" ILIKE '%firearm%'
GROUP BY d."Age"
ORDER BY d."Age"
LIMIT 20;
```

```sql
-- 10) Combined summary: total vs. Black counts for vehicle and firearm deaths (12‑18)
SELECT
    a."Age",
    a."vehicle_deaths_total",
    COALESCE(b."vehicle_black_deaths", 0)   AS "vehicle_black_deaths",
    c."firearm_deaths_total",
    COALESCE(d."firearm_black_deaths", 0)   AS "firearm_black_deaths"
FROM (
        SELECT d."Age", COUNT(DISTINCT d."Id") AS "vehicle_deaths_total"
        FROM DEATH.DEATH."DEATHRECORDS" d
        JOIN DEATH.DEATH."ENTITYAXISCONDITIONS" ec ON ec."DeathRecordId" = d."Id"
        JOIN DEATH.DEATH."ICD10CODE" i ON i."Code" = ec."Icd10Code"
        WHERE d."Age" BETWEEN 12 AND 18
          AND i."Description" ILIKE '%vehicle%'
        GROUP BY d."Age"
     ) a
LEFT JOIN (
        SELECT d."Age", COUNT(DISTINCT d."Id") AS "vehicle_black_deaths"
        FROM DEATH.DEATH."DEATHRECORDS" d
        JOIN DEATH.DEATH."ENTITYAXISCONDITIONS" ec ON ec."DeathRecordId" = d."Id"
        JOIN DEATH.DEATH."ICD10CODE" i ON i."Code" = ec."Icd10Code"
        JOIN DEATH.DEATH."RACE" r           ON r."Code" = d."Race"
        WHERE d."Age" BETWEEN 12 AND 18
          AND i."Description" ILIKE '%vehicle%'
          AND r."Description" ILIKE '%black%'
        GROUP BY d."Age"
     ) b  ON a."Age" = b."Age"
LEFT JOIN (
        SELECT d."Age", COUNT(DISTINCT d."Id") AS "firearm_deaths_total"
        FROM DEATH.DEATH."DEATHRECORDS" d
        JOIN DEATH.DEATH."ENTITYAXISCONDITIONS" ec ON ec."DeathRecordId" = d."Id"
        JOIN DEATH.DEATH."ICD10CODE" i ON i."Code" = ec."Icd10Code"
        WHERE d."Age" BETWEEN 12 AND 18
          AND i."Description" ILIKE '%firearm%'
        GROUP BY d."Age"
     ) c  ON a."Age" = c."Age"
LEFT JOIN (
        SELECT d."Age", COUNT(DISTINCT d."Id") AS "firearm_black_deaths"
        FROM DEATH.DEATH."DEATHRECORDS" d
        JOIN DEATH.DEATH."ENTITYAXISCONDITIONS" ec ON ec."DeathRecordId" = d."Id"
        JOIN DEATH.DEATH."ICD10CODE" i ON i."Code" = ec."Icd10Code"
        JOIN DEATH.DEATH."RACE" r           ON r."Code" = d."Race"
        WHERE d."Age" BETWEEN 12 AND 18
          AND i."Description" ILIKE '%firearm%'
          AND r."Description" ILIKE '%black%'
        GROUP BY d."Age"
     ) d  ON a."Age" = d."Age"
ORDER BY a."Age"
LIMIT 20;
```
