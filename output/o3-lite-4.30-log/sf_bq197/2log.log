--Description: Deliver, in one shot, the report of monthly top performers
--             (before Jul‑2024) requested earlier.
--             ── Thinking process ──────────────────────────────────────────────
--   • WHERE filters: keep only line‑items and parent orders whose status = 'Complete'
--                    and products with non‑null brands; limit months < 2024‑07.
--   • CTE 1 (monthly_product_sales): aggregate quantity (items_sold) and revenue
--                    per month‑product pair, using TO_TIMESTAMP_NTZ(created_at/1e6)
--                    to convert the micro‑seconds field.
--   • CTE 2 (ranked): apply ROW_NUMBER() over each month ordered by
--                    items_sold DESC, revenue DESC  ➜ ensures a single winner
--                    per month (tiebreaker = revenue).
--   • Final SELECT: pick row_number = 1, join back to PRODUCTS for descriptive
--                    columns, present requested fields.
WITH monthly_product_sales AS (          -- aggregate once
    SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at" / 1000000)) AS "sales_month",
           oi."product_id",
           COUNT(*)                              AS "items_sold",
           SUM(oi."sale_price")                  AS "revenue"
    FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
           ON o."order_id" = oi."order_id"
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
           ON p."id" = oi."product_id"
    WHERE  oi."status" = 'Complete'       -- line‑item status
      AND  o."status"  = 'Complete'       -- order status
      AND  p."brand"   IS NOT NULL        -- brand must exist
      AND  DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at" / 1000000)) < '2024-07-01'
    GROUP  BY 1, oi."product_id"
), ranked AS (                            -- decide winners
    SELECT mps.*,
           ROW_NUMBER() OVER (PARTITION BY mps."sales_month"
                              ORDER BY mps."items_sold" DESC,
                                       mps."revenue"    DESC) AS rn
    FROM   monthly_product_sales mps
)
SELECT   r."sales_month",
         p."name"                 AS "product_name",
         p."brand",
         p."category",
