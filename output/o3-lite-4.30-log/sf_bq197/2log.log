```sql
-- 🔟 Description: FINAL query – for every month up to (but excluding) July‑2024,
--                pick ONE best‑selling product: first by items sold, tiebreaker by revenue.
WITH filtered_items AS (
    SELECT  oi."order_id",
            oi."product_id",
            oi."sale_price",
            oi."created_at"
    FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
    JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
            ON o."order_id" = oi."order_id"
    WHERE   o."status"  = 'Complete'        -- ensure the whole order is complete
      AND   oi."status" = 'Complete'        -- and the line‑item itself is complete
), monthly_product_sales AS (
    SELECT  DATE_TRUNC('month', TO_TIMESTAMP_NTZ(fi."created_at"/1000000)) AS "sales_month",
            fi."product_id",
            COUNT(*)                              AS "items_sold",
            SUM(fi."sale_price")                  AS "revenue"
    FROM    filtered_items fi
    GROUP   BY 1, fi."product_id"
    HAVING  "sales_month" < '2024-07-01'          -- exclude July‑2024 and beyond
), ranked AS (
    SELECT  mps.*,
            RANK() OVER (PARTITION BY "sales_month"
                         ORDER BY "items_sold" DESC, "revenue" DESC) AS rnk
    FROM    monthly_product_sales mps
), top_monthly AS (
    SELECT  *
    FROM    ranked
    WHERE   rnk = 1
)
SELECT  tm."sales_month",
        p."name"          AS "product_name",
        p."brand",
        p."category",
        tm."items_sold"   AS "total_sales",
        ROUND(tm."revenue",2) AS "total_revenue",
        'Complete'        AS "order_status"
FROM    top_monthly tm
JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"  p
        ON p."id" = tm."product_id"
WHERE   p."brand" IS NOT NULL
ORDER   BY tm."sales_month"
LIMIT 20;
```

