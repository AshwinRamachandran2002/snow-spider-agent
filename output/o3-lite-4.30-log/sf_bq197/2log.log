Query:
--Description: FINAL monthly top‑performer report — for every month prior to Jul‑2024,
--             keep ONE best‑selling product (highest quantity; revenue is tiebreaker).
--             Uses ROW_NUMBER so only a single winner survives even if quantities
--             and revenues match exactly.
WITH monthly_product_sales AS (      -- Aggregate quantity & revenue per month‑product
    SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at" / 1000000)) AS "sales_month",
           oi."product_id",
           COUNT(*)                       AS "items_sold",
           SUM(oi."sale_price")           AS "revenue"
    FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
           ON o."order_id" = oi."order_id"
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
           ON p."id" = oi."product_id"
    WHERE  oi."status" = 'Complete'      -- line‑item complete
      AND  o."status"  = 'Complete'      -- order complete
      AND  p."brand"   IS NOT NULL       -- brand must exist
      AND  DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at" / 1000000)) < '2024-07-01'
    GROUP  BY 1, oi."product_id"
), ranked AS (                           -- Rank inside each month
    SELECT mps.*,
           ROW_NUMBER() OVER (PARTITION BY mps."sales_month"
                              ORDER BY mps."items_sold" DESC,
                                       mps."revenue"    DESC) AS rn
    FROM   monthly_product_sales mps
)
SELECT  r."sales_month",
        p."name"          AS "product_name",
        p."brand",
        p."category",
        r."items_sold"    AS "total_sales",
        ROUND(r."revenue", 2) AS "total_revenue",
        'Complete'        AS "order_status"
FROM    ranked r
JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
        ON p."id" = r."product_id"
WHERE   r.rn = 1                       -- keep single best‑seller per month
ORDER BY r."sales_month"
