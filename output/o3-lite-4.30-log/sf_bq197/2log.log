```sql
-- 8️⃣ Description: Detect months where two or more products tie on quantity (top 20 cases)
WITH monthly_sales AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "month",
         oi."product_id",
         COUNT(*)                AS "items_sold"
  FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
  JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
         ON p."id" = oi."product_id"
  WHERE  oi."status" = 'Complete'
    AND  p."brand" IS NOT NULL
  GROUP  BY 1, oi."product_id"
), ranked AS (
  SELECT *,
         RANK() OVER (PARTITION BY "month" ORDER BY "items_sold" DESC) AS rnk
  FROM   monthly_sales
)
SELECT *
FROM   ranked
WHERE  rnk = 1
GROUP  BY "month"
HAVING COUNT(*) > 1
LIMIT 20;
