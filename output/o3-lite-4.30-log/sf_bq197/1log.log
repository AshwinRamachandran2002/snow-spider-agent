The table structure information is ({database name: {schema name: [table name]}}): 
{'THELOOK_ECOMMERCE': {'THELOOK_ECOMMERCE': ['DISTRIBUTION_CENTERS', 'ORDERS', 'USERS', 'EVENTS', 'INVENTORY_ITEMS', 'PRODUCTS', 'ORDER_ITEMS']}}
Begin Exploring Related Columns
Relevant columns and their potential usage  
• ORDER_ITEMS."status": filter only finished sales (‘Complete’)  
• ORDER_ITEMS."created_at": derive the calendar month of every sale (micro‑seconds since Unix epoch)  
• ORDER_ITEMS."product_id": connect each order line to its product record  
• ORDER_ITEMS."sale_price": monetary amount of each item – to sum up revenue  
• ORDER_ITEMS."order_id": possible cross‑check with ORDERS table if you want the order‑level status  
• ORDERS."status": second way to keep only ‘Complete’ orders (optional – can be used together with, or instead of, ORDER_ITEMS."status")  
• PRODUCTS."id": join key that matches ORDER_ITEMS."product_id"  
• PRODUCTS."name": product description to be shown in the report  
• PRODUCTS."brand": make sure it is not null and put it in the final output  
• PRODUCTS."category": show the category of the winning product each month  

Typical filter / join conditions you may need  
• INNER JOIN ORDER_ITEMS oi  ON oi."product_id" = p."id"  
• INNER JOIN ORDERS o         ON o."order_id" = oi."order_id"  
• WHERE oi."status" = 'Complete'                      -- or o."status" = 'Complete'  
• AND   p."brand"  IS NOT NULL  
• AND   TO_TIMESTAMP(oi."created_at"/1000000) < '2024‑07‑01'  -- keep months prior to July‑2024  

Ten incremental Snowflake SQL snippets (each returns at most 20 rows)  
```sql
-- 1) Description: Peek at a handful of order lines and their statuses
SELECT *
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
LIMIT 20;
```

```sql
-- 2) Description: Show all distinct line‑item statuses
SELECT DISTINCT "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
LIMIT 20;
```

```sql
-- 3) Description: Verify that product brands are populated
SELECT DISTINCT "brand"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
WHERE "brand" IS NOT NULL
LIMIT 20;
```

```sql
-- 4) Description: Quick join – look at complete order lines with product details
SELECT oi."id",
       oi."product_id",
       p."name",
       p."brand",
       oi."sale_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
  ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
LIMIT 20;
```

```sql
-- 5) Description: Same as #4 but double‑checks against the ORDERS table status
SELECT oi."id",
       o."status"     AS "order_status",
       oi."status"    AS "item_status",
       p."name",
       p."brand"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"        o  ON o."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p  ON p."id"       = oi."product_id"
WHERE o."status" = 'Complete'
LIMIT 20;
```

```sql
-- 6) Description: Aggregate total units and revenue per product across all time
SELECT oi."product_id",
       COUNT(*)                        AS "units_sold",
       SUM(oi."sale_price")            AS "revenue"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
WHERE oi."status" = 'Complete'
GROUP BY oi."product_id"
ORDER BY "units_sold" DESC
LIMIT 20;
```

```sql
-- 7) Description: Convert microseconds to a calendar month; look only at June‑2024 sales
SELECT p."name",
       p."brand",
       COUNT(*)                 AS "units",
       SUM(oi."sale_price")     AS "revenue"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p ON p."id" = oi."product_id"
WHERE oi."status" = 'Complete'
  AND DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) = '2024‑06‑01'
GROUP BY p."name", p."brand"
ORDER BY "units" DESC, "revenue" DESC
LIMIT 20;
```

```sql
-- 8) Description: Monthly product totals (units & revenue) for the first half of 2024
SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "month",
       p."product_id",
       COUNT(*)       AS "units_sold",
       SUM(oi."sale_price") AS "revenue"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p ON p."id" = oi."product_id"
WHERE oi."status" = 'Complete'
  AND DATE_TRUNC('year', TO_TIMESTAMP(oi."created_at"/1000000)) = '2024‑01‑01'
GROUP BY "month", p."product_id"
ORDER BY "month" DESC, "units_sold" DESC
LIMIT 20;
```

```sql
-- 9) Description: For each month find the best‑selling product (units first, revenue second)
WITH monthly_product_sales AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "month",
           p."id"       AS "product_id",
           p."name",
           p."brand",
           p."category",
           COUNT(*)     AS "units_sold",
           SUM(oi."sale_price") AS "revenue"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p ON p."id" = oi."product_id"
    WHERE oi."status" = 'Complete'
      AND p."brand" IS NOT NULL
    GROUP BY "month", p."id", p."name", p."brand", p."category"
)
SELECT *
FROM (
    SELECT mps.*,
           ROW_NUMBER() OVER (PARTITION BY mps."month"
                              ORDER BY mps."units_sold" DESC, mps."revenue" DESC) AS rn
    FROM monthly_product_sales mps
) ranked
WHERE rn = 1
LIMIT 20;
```

```sql
-- 10) Description: Final report – monthly top performer before July‑2024
WITH monthly_product_sales AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "month",
           p."name",
           p."brand",
           p."category",
           COUNT(*)             AS "total_sales",
           ROUND(SUM(oi."sale_price"), 2) AS "total_revenue"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p ON p."id" = oi."product_id"
    WHERE oi."status" = 'Complete'
      AND p."brand" IS NOT NULL
      AND TO_TIMESTAMP(oi."created_at"/1000000) < '2024‑07‑01'
    GROUP BY "month", p."name", p."brand", p."category"
), ranked AS (
    SELECT mps.*,
           ROW_NUMBER() OVER (PARTITION BY mps."month"
                              ORDER BY mps."total_sales" DESC, mps."total_revenue" DESC) AS rn
    FROM monthly_product_sales mps
)
SELECT "month",
       "name"            AS "product_name",
       "brand",
       "category",
       "total_sales",
       "total_revenue",
       'Complete'        AS "order_status"
FROM ranked
WHERE rn = 1
ORDER BY "month" DESC
LIMIT 20;
```
