```sql
--Description: build the customer‑level RFM base in one shot and register it as a
--             temporary view (v_customer_rfm). The query proceeds in two layers:
--             ① order_level CTE – aggregates each delivered order’s value
--                (price + freight) and keeps its timestamp & customer_id.
--             ② final SELECT     – joins to customers to reach customer_unique_id,
--                then rolls up to deliver F (frequency), M (monetary) and the
--                most recent purchase timestamp (for Recency).
CREATE TEMP VIEW v_customer_rfm AS
WITH order_level AS (
    SELECT
           oi.order_id,
           o.order_purchase_timestamp AS purchase_ts,
           o.customer_id,
           SUM(oi.price + oi.freight_value) AS order_sales
    FROM   order_items AS oi
    JOIN   orders      AS o  ON oi.order_id = o.order_id
    WHERE  o.order_status = 'delivered'
    GROUP  BY oi.order_id
)
SELECT
       c.customer_unique_id,
       COUNT(*)                         AS frequency,        -- F
       ROUND(SUM(ol.order_sales), 2)    AS monetary,         -- M
       MAX(ol.purchase_ts)              AS last_purchase_ts  -- for Recency
FROM   order_level AS ol
JOIN   customers    AS c  ON c.customer_id = ol.customer_id
GROUP  BY c.customer_unique_id;
```
