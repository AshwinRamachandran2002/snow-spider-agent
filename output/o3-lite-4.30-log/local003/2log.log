            WHEN r_ntile = 2 AND f_ntile = 1 AND m_ntile = 1 THEN 'Potential Loyalist'
            WHEN r_ntile = 3 AND f_ntile = 3 AND m_ntile = 3 THEN 'Lost'
            ELSE 'Others'
        END AS rfm_segment
    FROM scored
),
segment_avg AS (                         -- 6. average of those customer‑level averages
    SELECT
        rfm_segment,
        ROUND(AVG(avg_sales_per_order),4) AS average_sales_per_order
