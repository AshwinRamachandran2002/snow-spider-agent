```sql
--Description: create a customer‑level R & F & M base (frequency, monetary, last purchase)
CREATE TEMP VIEW v_customer_rfm AS
SELECT
        c.customer_unique_id,
        COUNT(*)                           AS frequency,          -- F
        ROUND(SUM(v.order_sales), 2)       AS monetary,           -- M
        MAX(v.order_purchase_timestamp)    AS last_purchase_ts    -- for Recency
FROM    v_order_sales  AS v
JOIN    customers      AS c   ON c.customer_id = v.customer_id
GROUP BY c.customer_unique_id;
```

```sql
--Description: add Recency (in days) and translate each metric to 3‑level scores via NTILE(3)
WITH rfm_raw AS (
    SELECT *,
           CAST(
               julianday( (SELECT MAX(order_purchase_timestamp) FROM v_order_sales) )
               - julianday(last_purchase_ts)
           AS INTEGER)                               AS recency_days
    FROM   v_customer_rfm
),
scored AS (
    SELECT  rfm_raw.*,
            NTILE(3) OVER (ORDER BY recency_days  ASC) AS r_ntile,  -- low days = better
            NTILE(3) OVER (ORDER BY frequency     DESC) AS f_ntile, -- high freq = better
            NTILE(3) OVER (ORDER BY monetary      DESC) AS m_ntile  -- high $   = better
    FROM    rfm_raw
)
SELECT
        customer_unique_id,
        recency_days,
        frequency,
        monetary,
        CASE r_ntile WHEN 1 THEN 3 WHEN 2 THEN 2 ELSE 1 END AS r_score,
        CASE f_ntile WHEN 1 THEN 3 WHEN 2 THEN 2 ELSE 1 END AS f_score,
        CASE m_ntile WHEN 1 THEN 3 WHEN 2 THEN 2 ELSE 1 END AS m_score
FROM    scored
LIMIT 20;
```

```sql
--Description: map R/F/M scores to segment labels and compute average sales per order for each segment
WITH rfm_raw AS (
    SELECT *,
           CAST(
               julianday( (SELECT MAX(order_purchase_timestamp) FROM v_order_sales) )
               - julianday(last_purchase_ts)
           AS INTEGER)                               AS recency_days
    FROM   v_customer_rfm
),
scored AS (
    SELECT  rfm_raw.*,
            NTILE(3) OVER (ORDER BY recency_days  ASC) AS r_ntile,
            NTILE(3) OVER (ORDER BY frequency     DESC) AS f_ntile,
            NTILE(3) OVER (ORDER BY monetary      DESC) AS m_ntile
    FROM    rfm_raw
),
labeled AS (
    SELECT *,
           CASE r_ntile WHEN 1 THEN 3 WHEN 2 THEN 2 ELSE 1 END AS r_score,
           CASE f_ntile WHEN 1 THEN 3 WHEN 2 THEN 2 ELSE 1 END AS f_score,
           CASE m_ntile WHEN 1 THEN 3 WHEN 2 THEN 2 ELSE 1 END AS m_score,
           ROUND(monetary * 1.0 / frequency, 2)       AS avg_sales_per_order,
           CASE
               WHEN r_ntile = 1 AND f_ntile = 1 AND m_ntile = 1 THEN 'Champions'
               WHEN r_ntile = 1 AND f_ntile = 2                THEN 'Loyal'
               WHEN             f_ntile = 1 AND m_ntile = 1    THEN 'Potential Loyalist'
               WHEN r_ntile = 3 AND f_ntile = 3 AND m_ntile = 3 THEN 'Lost'
               ELSE 'Others'
           END                                         AS rfm_segment
    FROM   scored
)
SELECT
        rfm_segment,
        COUNT(*)                          AS customers,
        ROUND(AVG(avg_sales_per_order),2) AS avg_sales_segment
FROM    labeled
GROUP BY rfm_segment;
```

```sql
--Description: detail the dispersion of average‑sales‑per‑order within each RFM segment
WITH rfm_raw AS (
    SELECT *,
           CAST(
               julianday( (SELECT MAX(order_purchase_timestamp) FROM v_order_sales) )
               - julianday(last_purchase_ts)
           AS INTEGER)                               AS recency_days
    FROM   v_customer_rfm
),
scored AS (
    SELECT  rfm_raw.*,
            NTILE(3) OVER (ORDER BY recency_days  ASC) AS r_ntile,
            NTILE(3) OVER (ORDER BY frequency     DESC) AS f_ntile,
            NTILE(3) OVER (ORDER BY monetary      DESC) AS m_ntile
    FROM    rfm_raw
),
labeled AS (
    SELECT *,
           CASE r_ntile WHEN 1 THEN 3 WHEN 2 THEN 2 ELSE 1 END AS r_score,
           CASE f_ntile WHEN 1 THEN 3 WHEN 2 THEN 2 ELSE 1 END AS f_score,
           CASE m_ntile WHEN 1 THEN 3 WHEN 2 THEN 2 ELSE 1 END AS m_score,
           ROUND(monetary * 1.0 / frequency, 2)       AS avg_sales_per_order,
           CASE
               WHEN r_ntile = 1 AND f_ntile = 1 AND m_ntile = 1 THEN 'Champions'
               WHEN r_ntile = 1 AND f_ntile = 2                THEN 'Loyal'
               WHEN             f_ntile = 1 AND m_ntile = 1    THEN 'Potential Loyalist'
               WHEN r_ntile = 3 AND f_ntile = 3 AND m_ntile = 3 THEN 'Lost'
               ELSE 'Others'
           END                                         AS rfm_segment
    FROM   scored
)
SELECT
        rfm_segment,
        ROUND(AVG(avg_sales_per_order),2) AS avg_sales_per_order,
        ROUND(MIN(avg_sales_per_order),2) AS min_customer_avg,
        ROUND(MAX(avg_sales_per_order),2) AS max_customer_avg,
        COUNT(*)                          AS num_customers
FROM    labeled
GROUP BY rfm_segment
ORDER BY avg_sales_per_order DESC
LIMIT 20;
```
