Query:
--Description: label each customer into an RFM segment and summarise average sales per order per segment.
-- • Reuses the same CTE chain as above (customer_rfm → rfm_raw → scored).
-- • labeled CTE assigns human‑readable segment names and calculates avg_sales_per_order.
WITH customer_rfm AS (
    SELECT
           c.customer_unique_id,
           COUNT(*)                         AS frequency,
           ROUND(SUM(v.order_sales), 2)     AS monetary,
           MAX(v.order_purchase_timestamp)  AS last_purchase_ts
    FROM   v_order_sales AS v
    JOIN   customers     AS c  ON c.customer_id = v.customer_id
    GROUP  BY c.customer_unique_id
),
rfm_raw AS (
    SELECT *,
           CAST(
               julianday( (SELECT MAX(order_purchase_timestamp) FROM v_order_sales) )
               - julianday(last_purchase_ts)
           AS INTEGER)                      AS recency_days
    FROM   customer_rfm
),
scored AS (
    SELECT  rfm_raw.*,
            NTILE(3) OVER (ORDER BY recency_days  ASC) AS r_ntile,
            NTILE(3) OVER (ORDER BY frequency     DESC) AS f_ntile,
            NTILE(3) OVER (ORDER BY monetary      DESC) AS m_ntile
    FROM    rfm_raw
),
labeled AS (
    SELECT *,
           CASE r_ntile WHEN 1 THEN 3 WHEN 2 THEN 2 ELSE 1 END AS r_score,
           CASE f_ntile WHEN 1 THEN 3 WHEN 2 THEN 2 ELSE 1 END AS f_score,
           CASE m_ntile WHEN 1 THEN 3 WHEN 2 THEN 2 ELSE 1 END AS m_score,
           ROUND(monetary * 1.0 / frequency, 2) AS avg_sales_per_order,
           CASE
               WHEN r_ntile = 1 AND f_ntile = 1 AND m_ntile = 1 THEN 'Champions'
               WHEN r_ntile = 1 AND f_ntile = 2                THEN 'Loyal'
               WHEN             f_ntile = 1 AND m_ntile = 1    THEN 'Potential Loyalist'
               WHEN r_ntile = 3 AND f_ntile = 3 AND m_ntile = 3 THEN 'Lost'
               ELSE 'Others'
           END AS rfm_segment
    FROM   scored
)
SELECT
        rfm_segment,
        COUNT(*)                          AS customers,
        ROUND(AVG(avg_sales_per_order),2) AS avg_sales_segment
FROM    labeled
GROUP  BY rfm_segment
