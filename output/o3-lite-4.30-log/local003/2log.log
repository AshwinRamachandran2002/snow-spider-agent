--Description: roll up the already‑prepared order‑level dataset (v_order_sales) to the
--             customer_unique_id level, returning one row per customer with:
--               • frequency  = count of delivered orders
--               • monetary   = total spend (price + freight) across those orders
--               • last_purchase_ts = most recent delivered order timestamp
--             (A pure SELECT—no VIEW creation—so it can be executed safely even if
--             v_customer_rfm was created earlier.)
SELECT
       c.customer_unique_id,
       COUNT(*)                        AS frequency,          -- F
       ROUND(SUM(v.order_sales), 2)    AS monetary,           -- M
       MAX(v.order_purchase_timestamp) AS last_purchase_ts    -- for Recency
FROM   v_order_sales AS v
JOIN   customers     AS c  ON c.customer_id = v.customer_id
GROUP  BY c.customer_unique_id;
```
