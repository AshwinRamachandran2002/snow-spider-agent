--Description: One‑shot RFM segmentation and comparison of the average sales per order
--             (Monetary / Frequency) across segments, based only on “delivered” orders.
--             Steps inside CTEs:
--             1) delivered_orders – compute total value of every delivered order
--                (price + freight).
--             2) customer_base    – aggregate to the customer level: number of orders,
--                total spend, and the date of the last purchase.
--             3) with_recency     – convert last purchase to “recency_days” by subtracting
--                it from the global most‑recent purchase date.
--             4) scored           – assign quartile ranks with NTILE(4):
--                   • R  (1 = freshest … 4 = stalest) over recency_days  ASC.
--                   • F′ (1 = most orders … 4 = few) over orders_cnt     DESC.
--                   • M′ (1 = highest spend … 4 = low) over total_spend  DESC.
--                Flip F′ and M′ (score = 5 − tile) so that 4 always means “best”.
--             5) rfm_segment      – build segment_code (R||F||M) and the customer’s
--                avg_sales_per_order (total_spend / orders_cnt).
--             The final SELECT shows, for each segment, the number of customers and
--             the mean avg_sales_per_order. LIMIT 20 keeps output compact.

WITH delivered_orders AS (
    SELECT  o.order_id,
            c.customer_unique_id,
            o.order_purchase_timestamp,
            SUM(oi.price + oi.freight_value)       AS order_total
    FROM    orders        AS o
    JOIN    customers     AS c  ON c.customer_id = o.customer_id
    JOIN    order_items   AS oi ON oi.order_id   = o.order_id
    WHERE   o.order_status = 'delivered'
    GROUP BY o.order_id
),
customer_base AS (
    SELECT  customer_unique_id,
            COUNT(*)                                  AS orders_cnt,
            ROUND(SUM(order_total), 2)               AS total_spend,
            MAX(order_purchase_timestamp)             AS last_purchase
    FROM    delivered_orders
    GROUP BY customer_unique_id
),
with_recency AS (
    SELECT  *,
            ROUND(
                julianday( (SELECT MAX(last_purchase) FROM customer_base) )
                - julianday(last_purchase), 1
            )                                        AS recency_days
    FROM    customer_base
),
scored AS (
    SELECT  *,
            NTILE(4) OVER (ORDER BY recency_days  ASC)  AS r_tile, -- 1 freshest
            NTILE(4) OVER (ORDER BY orders_cnt  DESC)   AS f_raw,  -- 1 many orders
            NTILE(4) OVER (ORDER BY total_spend DESC)   AS m_raw   -- 1 high spend
    FROM    with_recency
),
rfm_segment AS (
    SELECT  customer_unique_id,
            ROUND(total_spend * 1.0 / orders_cnt, 2)   AS avg_sales_per_order,
            r_tile                                     AS R,
            (5 - f_raw)                                AS F,
            (5 - m_raw)                                AS M
    FROM    scored
)
SELECT  R || F || M                        AS segment_code,
        COUNT(*)                           AS customers_in_segment,
        ROUND(AVG(avg_sales_per_order),2)  AS avg_sales_per_order_segment
FROM    rfm_segment
GROUP BY segment_code
ORDER BY segment_code
LIMIT 20;
