```sql
--Description: SINGLE end‑to‑end statement that
-- 1) collects every *delivered* order’s total value,
-- 2) aggregates to the customer level (frequency, monetary, last purchase),
-- 3) computes Recency in days from the most‑recent purchase in the whole dataset,
-- 4) assigns quartile scores with NTILE(4) (R fresh→old, F many→few, M high→low),
--    then flips F & M so that a score of 4 always means “best”,
-- 5) builds an RFM segment code and the customer’s average sales per order,
-- 6) finally compares segments by counting customers and averaging the metric.
WITH delivered_orders AS (                 -- per‑order values
    SELECT  o.order_id,
            c.customer_unique_id,
            o.order_purchase_timestamp,
            SUM(oi.price + oi.freight_value) AS order_total
    FROM    orders      AS o
    JOIN    customers   AS c  ON c.customer_id = o.customer_id
    JOIN    order_items AS oi ON oi.order_id   = o.order_id
    WHERE   o.order_status = 'delivered'
    GROUP BY o.order_id
),
customer_base AS (                         -- per‑customer aggregates
    SELECT  customer_unique_id,
            COUNT(*)                              AS orders_cnt,
            ROUND(SUM(order_total),2)             AS total_spend,
            MAX(order_purchase_timestamp)         AS last_purchase
    FROM    delivered_orders
    GROUP BY customer_unique_id
),
with_recency AS (                          -- recency in days
    SELECT  *,
            ROUND(
                julianday( (SELECT MAX(last_purchase) FROM customer_base) )
                - julianday(last_purchase), 1
            ) AS recency_days
    FROM    customer_base
),
scored AS (                                -- quartile scores via NTILE(4)
    SELECT  *,
            NTILE(4) OVER (ORDER BY recency_days  ASC)  AS r_tile, -- 1 freshest
            NTILE(4) OVER (ORDER BY orders_cnt  DESC)   AS f_raw,  -- 1 many orders
            NTILE(4) OVER (ORDER BY total_spend DESC)   AS m_raw   -- 1 high spend
    FROM    with_recency
),
rfm_customer AS (                          -- flip F & M so 4 = best
    SELECT  customer_unique_id,
            orders_cnt,
            total_spend,
            ROUND(total_spend * 1.0 / orders_cnt,2)     AS avg_sales_per_order,
            r_tile                                      AS R,
            (5 - f_raw)                                 AS F,
            (5 - m_raw)                                 AS M
    FROM    scored
)
SELECT  R || F || M                         AS segment_code,
        COUNT(*)                            AS customers_in_segment,
        ROUND(AVG(avg_sales_per_order),2)   AS avg_sales_per_order_segment
FROM    rfm_customer
GROUP BY segment_code
ORDER BY segment_code;
