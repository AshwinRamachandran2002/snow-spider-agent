```sql
WITH moto_parties AS (
    SELECT
        case_id,
        CASE
            WHEN party_safety_equipment_1 LIKE '%helmet not used%' 
                 OR party_safety_equipment_2 LIKE '%helmet not used%' 
                 THEN 'not_used'
            WHEN party_safety_equipment_1 LIKE '%helmet used%' 
                 OR party_safety_equipment_2 LIKE '%helmet used%' 
                 THEN 'used'
            ELSE 'unknown'
        END AS helmet_status
    FROM parties
    WHERE statewide_vehicle_type LIKE '%motorcycle%'
),
collision_helmet AS (
    SELECT
        case_id,
        CASE
            WHEN MAX(CASE WHEN helmet_status = 'used' THEN 1 ELSE 0 END) = 1
                 AND MAX(CASE WHEN helmet_status = 'not_used' THEN 1 ELSE 0 END) = 0
                 THEN 'helmet_used'
            WHEN MAX(CASE WHEN helmet_status = 'not_used' THEN 1 ELSE 0 END) = 1
                 AND MAX(CASE WHEN helmet_status = 'used' THEN 1 ELSE 0 END) = 0
                 THEN 'helmet_not_used'
            ELSE NULL
        END AS helmet_usage_group
    FROM moto_parties
    GROUP BY case_id
),
relevant_collisions AS (
    SELECT
        c.case_id,
        ch.helmet_usage_group AS helmet_usage,
        COALESCE(c.motorcyclist_killed_count, 0) AS killed
    FROM collisions AS c
    JOIN collision_helmet AS ch ON ch.case_id = c.case_id
    WHERE ch.helmet_usage_group IS NOT NULL
      AND c.motorcycle_collision = 1
)
SELECT
    helmet_usage,
    ROUND(SUM(killed) * 100.0 / COUNT(DISTINCT case_id), 4) AS fatality_rate_percent
FROM relevant_collisions
GROUP BY helmet_usage
ORDER BY helmet_usage;
```

