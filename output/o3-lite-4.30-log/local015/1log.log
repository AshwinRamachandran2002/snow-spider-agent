```sql
WITH motorcyclist AS (
    SELECT
        "case_id",
        COALESCE("party_number_killed",0) AS party_number_killed,
        CASE
            WHEN ("party_safety_equipment_1" LIKE '%helmet%' OR "party_safety_equipment_2" LIKE '%helmet%')
            THEN 'helmet'
            ELSE 'no_helmet'
        END AS helmet_usage
    FROM "parties"
    WHERE "statewide_vehicle_type" LIKE '%motorcycle%'
),
stats AS (
    SELECT
        helmet_usage,
        SUM(party_number_killed) AS deaths,
        COUNT(DISTINCT "case_id") AS collisions
    FROM motorcyclist
    GROUP BY helmet_usage
)
SELECT
    helmet_usage,
    ROUND(deaths * 100.0 / collisions, 4) AS fatality_rate_percent
FROM stats
ORDER BY helmet_usage;
```
