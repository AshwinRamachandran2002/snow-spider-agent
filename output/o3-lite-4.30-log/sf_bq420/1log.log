```sql
/*  Top‑5 U.S. patents (granted 2010‑2023) whose very first
    office action was a §101 rejection with zero allowed claims.
    Output:
        first_publication_number,
        first_publication_date,
        first_office_action_date,
        filed_claim_length_words,
        grant_date
*/

WITH first_101_oa AS (     -- 1️⃣ first office action = 101 rejection / 0 allowed
    SELECT
        oa."application_number"                AS app_no,
        MIN(oa."mail_date")                    AS first_office_action_date
    FROM PATENTS_USPTO.PUBLIC_PAIR.OFFICE_ACTIONS oa
    WHERE oa."rejection_35usc" = '101'
      AND COALESCE(oa."allowed_claims", 0) = 0
    GROUP BY oa."application_number"
),

us_grants AS (             -- 2️⃣ U.S. grants issued 2010‑2023
    SELECT
        p."publication_number"                 AS grant_pub_no,
        p."application_number"                 AS application_number,
        p."grant_date"                         AS grant_date,
        p."family_id"                          AS family_id
    FROM PATENTS_USPTO.PATENTS.PUBLICATIONS p
    WHERE p."country_code" = 'US'
      AND p."kind_code"    LIKE 'B%'           -- granted patents
      AND p."grant_date"  BETWEEN 20100101 AND 20231231
),

claim_lengths AS (         -- 3️⃣ granted‑claim word counts
    SELECT
        m."publication_number"                 AS grant_pub_no,
        CAST(d."pat_wrd_ct" AS INTEGER)        AS filed_claim_length_words
    FROM PATENTS_USPTO.USPTO_OCE_CLAIMS.PATENT_DOCUMENT_STATS d
    JOIN PATENTS_USPTO.USPTO_OCE_CLAIMS.MATCH               m
      ON d."pat_no" = m."pat_no"
),

first_app_pub AS (         -- 4️⃣ earliest A‑kind publication per family
    SELECT
        g.grant_pub_no,
        MIN(a."publication_number")            AS first_publication_number,
        MIN(a."publication_date")              AS first_publication_date
    FROM us_grants g
    JOIN PATENTS_USPTO.PATENTS.PUBLICATIONS a
      ON g.family_id = a."family_id"
     AND a."kind_code" LIKE 'A%'
    GROUP BY g.grant_pub_no
)

SELECT
    fp.first_publication_number,
    fp.first_publication_date,
    oa.first_office_action_date,
    cl.filed_claim_length_words,
    g.grant_date
FROM us_grants          g
JOIN first_101_oa       oa  ON oa.app_no      = g.application_number
JOIN claim_lengths      cl  ON cl.grant_pub_no = g.grant_pub_no
JOIN first_app_pub      fp  ON fp.grant_pub_no = g.grant_pub_no
ORDER BY cl.filed_claim_length_words DESC NULLS LAST,
         fp.first_publication_number
LIMIT 5;
```
