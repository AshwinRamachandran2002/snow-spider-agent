```sql
/*  Top‑5 U.S. patents (granted 2010‑2023) whose very first
    office‑action was a §101 rejection with “0” allowed claims.
    The query returns the first‑published application number,
    its publication date, the first office‑action date,
    the number of words in the originally‑filed claims,
    and the eventual grant date – ordered by claim length.         */

WITH first_101_oa AS (   -- 1️⃣  first office action = §101, no claims allowed
    SELECT
          oa."application_number"                         AS app_no ,
          MIN(oa."mail_date")                             AS first_office_action_date
    FROM  PATENTS_USPTO.PAIR.OFFICE_ACTIONS               oa
    WHERE oa."rejection_35usc"  = '101'        -- §101 rejection flag
      AND oa."allowed_claims"   = 0            -- “no allowed claims”
    GROUP BY oa."application_number"
),

us_grants AS (          -- 2️⃣  U.S. grants in the 2010‑2023 window
    SELECT
          p."publication_number"          AS grant_pub_no ,
          p."grant_date" ,
          p."family_id" ,
          p."application_number"
    FROM  PATENTS_USPTO.PATENTS.PUBLICATIONS  p
    WHERE p."country_code"   = 'US'
      AND p."kind_code"      LIKE 'B%'       -- granted patents
      AND p."grant_date"
          BETWEEN 20100101 AND 20231231
),

claim_lengths AS (      -- 3️⃣  word‑count of the filed (granted) claims
    SELECT
          m."publication_number"                       AS grant_pub_no ,
          CAST(d."pat_wrd_ct" AS INTEGER)              AS filed_claim_length_words
    FROM  PATENTS_USPTO.USPTO_OCE_CLAIMS.PATENT_DOCUMENT_STATS  d
    JOIN  PATENTS_USPTO.USPTO_OCE_CLAIMS.MATCH                  m
          ON d."pat_no" = m."pat_no"
),

first_app_pub AS (      -- 4️⃣  first A‑kind publication that opened the family
    SELECT
          g."publication_number"                       AS grant_pub_no ,
          MIN(a."publication_number")                  AS first_publication_number ,
          MIN(a."publication_date")                   AS first_publication_date
    FROM  us_grants                        g
    JOIN  PATENTS_USPTO.PATENTS.PUBLICATIONS  a
          ON g."family_id" = a."family_id"
         AND a."kind_code" LIKE 'A%'                  -- pre‑grant publication
    GROUP BY g."publication_number"
)

-- 5️⃣  put everything together and rank by length of granted claims
SELECT
       fp.first_publication_number                                     AS first_publication_number ,
       fp.first_publication_date                                       AS first_publication_date ,
       oa.first_office_action_date                                     AS first_office_action_date ,
       cl.filed_claim_length_words                                     AS filed_claim_length_words ,
       g.grant_date                                                    AS grant_date
FROM   us_grants                g
JOIN   first_app_pub            fp  ON fp.grant_pub_no = g.grant_pub_no
JOIN   claim_lengths            cl  ON cl.grant_pub_no = g.grant_pub_no
JOIN   first_101_oa             oa  ON oa.app_no       = g."application_number"
ORDER BY cl.filed_claim_length_words DESC NULLS LAST ,
         g.grant_pub_no
LIMIT 5;
```

