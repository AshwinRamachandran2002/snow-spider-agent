```sql
--Description:  #7  Combine claim‑length (PATENT_DOCUMENT_STATS), bridge (MATCH),
--              first‑publication sub‑query (#6) and PUBLICATIONS to rank grants by
--              word count in claims.
SELECT 
       p."publication_number"        AS "grant_pub_no",
       p."grant_date",
       d."pat_wrd_ct"                AS "grant_claim_words",
       a."first_app_pub",
       a."first_app_pub_date"
FROM   PATENTS_USPTO.USPTO_OCE_CLAIMS.PATENT_DOCUMENT_STATS AS d
JOIN   PATENTS_USPTO.USPTO_OCE_CLAIMS.MATCH                 AS m
  ON   d."pat_no" = m."pat_no"
JOIN (
        SELECT 
               g."publication_number",
               MIN(a."publication_number") AS "first_app_pub",
               MIN(a."publication_date")   AS "first_app_pub_date"
        FROM   PATENTS_USPTO.PATENTS.PUBLICATIONS g
        JOIN   PATENTS_USPTO.PATENTS.PUBLICATIONS a
          ON   g."family_id" = a."family_id"
        WHERE  g."country_code" = 'US'
          AND  g."kind_code"    LIKE 'B%'
          AND  g."grant_date"   BETWEEN 20100101 AND 20231231
          AND  a."kind_code"    LIKE 'A%'
        GROUP  BY g."publication_number"
      )                                   AS a
  ON  a."publication_number" = m."publication_number"
JOIN   PATENTS_USPTO.PATENTS.PUBLICATIONS   AS p
  ON   p."publication_number" = m."publication_number"
WHERE  p."country_code" = 'US'
  AND  p."kind_code"    LIKE 'B%'
  AND  p."grant_date"   BETWEEN 20100101 AND 20231231
ORDER BY d."pat_wrd_ct" DESC
LIMIT 20;
