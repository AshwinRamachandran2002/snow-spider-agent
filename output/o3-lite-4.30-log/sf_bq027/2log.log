```sql
--Description:
-- Thinking process:
-- • We need: (a) patents whose grant_date falls from 2010‑01‑01 through 2018‑12‑31,
--   (b) the count of their backward citations whose "category" value begins with "SEA".
-- • Inside PATENTS.PATENTS.PUBLICATIONS, each patent’s "citation" field is a JSON array
--   of objects; we flatten it (alias f) so each row is one cited document.
-- • Filter on f.value:"category" ILIKE 'SEA%' to keep only SEA‑category citations.
-- • GROUP BY the parent patent’s "publication_number" and COUNT(*) those SEA rows.
-- • ORDER BY the count (most SEA citations first) and limit to 20 for a quick look.
SELECT
       t."publication_number",
       COUNT(*) AS "sea_citation_count"
FROM   PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."citation") f
WHERE  t."grant_date" BETWEEN 20100101 AND 20181231
  AND  f.value:"category"::STRING ILIKE 'SEA%'
GROUP BY t."publication_number"
ORDER BY "sea_citation_count" DESC
LIMIT 20;
