```sql
--Description:
-- Goal:  For each grant year from 2010‑2018, count how many distinct patents have
--        at least one backward citation whose "category" starts with 'SEA'.
-- Reasoning steps:
--   1. grant_date is stored as an 8‑digit NUMBER in YYYYMMDD format (e.g., 20140227).
--      Converting it to STRING and taking SUBSTR(..,1,4) yields the four‑digit year.
--   2. FLATTEN the "citation" array (alias f) so each cited document becomes a row.
--   3. Keep only rows where the citation’s "category" value matches 'SEA%' (ILIKE for
--      case‑insensitive comparison).
--   4. COUNT(DISTINCT publication_number) so each patent is counted once per year,
--      regardless of how many SEA citations it contains.
--   5. GROUP BY the derived year string and order ascending for readability.
SELECT
       SUBSTR(CAST(t."grant_date" AS STRING), 1, 4) AS "grant_year",
       COUNT(DISTINCT t."publication_number")       AS "num_pats_with_sea"
FROM   PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."citation") f
WHERE  t."grant_date" BETWEEN 20100101 AND 20181231
  AND  f.value:"category"::STRING ILIKE 'SEA%'
GROUP BY SUBSTR(CAST(t."grant_date" AS STRING), 1, 4)
ORDER BY "grant_year";
```
