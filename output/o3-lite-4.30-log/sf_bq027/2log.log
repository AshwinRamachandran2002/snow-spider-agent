--Description: #10 – Final‑style query: publication number and the count of SEA backward citations (granted 2010‑2018).
-- Logic:
-- • Flatten the "citation" array (alias f) to expose individual citation objects.
-- • Keep rows whose citation "category" begins with 'SEA' (case‑insensitive).
-- • Group by parent patent ("publication_number") and count those SEA citations.
-- • Order alphabetically by publication_number (change to DESC on count if needed).
SELECT
       t."publication_number",
       COUNT(*) AS "sea_citation_count"
FROM   PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN (input => t."citation") f
WHERE  t."grant_date" BETWEEN 20100101 AND 20181231
  AND  f.value:"category"::STRING ILIKE 'SEA%'
GROUP BY t."publication_number"
ORDER BY t."publication_number"
