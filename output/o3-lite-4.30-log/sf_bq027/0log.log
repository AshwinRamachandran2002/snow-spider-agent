```sql
SELECT 
    p."publication_number"                                      AS publication_number,
    COUNT(*)                                                    AS backward_citations_sea
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN (INPUT => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231              -- granted 2010‑01‑01 … 2018‑12‑31
  AND f.value:"category"::STRING = 'SEA'                        -- SEA‑category backward citations
GROUP BY p."publication_number"
ORDER BY p."publication_number";
```
