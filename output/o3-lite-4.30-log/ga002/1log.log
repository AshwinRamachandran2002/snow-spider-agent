      SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
      UNION ALL
      SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
      UNION ALL
      SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`
     ) AS e
CROSS JOIN UNNEST(e.items)  AS tee
CROSS JOIN UNNEST(e.items)  AS other
WHERE e.event_name = 'purchase'
  AND SUBSTR(event_date,1,6) IN ('202011','202012','202101')
  AND LOWER(tee.item_name) = 'google red speckled tee'
  AND LOWER(other.item_name) <> 'google red speckled tee'
GROUP BY month_yyyymm, product
ORDER BY month_yyyymm, total_quantity DESC
LIMIT 20;
```




