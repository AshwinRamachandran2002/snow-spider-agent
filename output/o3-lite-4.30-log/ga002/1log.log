--Description / thinking process:
-- • Goal → For each of the three months (202011, 202012, 202101) list every
--   product that was purchased in the same purchase event as a “Google Red
--   Speckled Tee”, together with the total quantity of that product bought
--   alongside the tee.  
-- • Approach → 
--   1. UNION‑ALL all daily tables for the three months into one CTE
--      (keeps only event_date, event_name, items to minimise scan).  
--   2. UNNEST items twice:  
--        – alias `tee` → to test for the presence of the tee.  
--        – alias `other` → to capture the co‑purchased items.  
--   3. Filter to purchase events, require that `tee` is the target product,
--      and exclude the tee itself from `other`.  
--   4. Aggregate by month (first 6 chars of event_date) and product, summing
--      `other.quantity`.  
--   5. Order within each month by quantity (desc); LIMIT 20 for inspection.  
WITH all_months AS (
  -- November 2020
  SELECT event_date, event_name, items
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
  UNION ALL
  -- December 2020
  SELECT event_date, event_name, items
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  UNION ALL
  -- January 2021
  SELECT event_date, event_name, items
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`
)
SELECT
  SUBSTR(event_date, 1, 6) AS month_yyyymm,   -- e.g. 202012
  other.item_name          AS product,        -- co‑purchased product
  SUM(other.quantity)      AS total_quantity  -- quantity bought with the tee
FROM all_months
CROSS JOIN UNNEST(items) AS tee
CROSS JOIN UNNEST(items) AS other
WHERE event_name = 'purchase'
  AND LOWER(tee.item_name) = 'google red speckled tee'
  AND LOWER(other.item_name) <> 'google red speckled tee'
GROUP BY month_yyyymm, product
ORDER BY month_yyyymm, total_quantity DESC
LIMIT 20;
