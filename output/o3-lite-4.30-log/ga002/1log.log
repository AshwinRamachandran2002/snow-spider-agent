Query:
--Description: (#8 corrected)  Summarise the three‑month period and keep only the
-- top‑purchased “other” product for each month.  We UNION‑ALL the daily tables
-- for 202011, 202012 and 202101 into one CTE, unnest `items` twice so we can
-- detect the Google Red Speckled Tee (`tee`) and simultaneously collect every
-- co‑purchased product (`other`).  After aggregating quantities we rank the
-- products per month and keep the row with rn = 1 (the most‑purchased).
WITH all_events AS (                      -- gather the 3 months
  SELECT event_date, event_name, items
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
  UNION ALL
  SELECT event_date, event_name, items
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  UNION ALL
  SELECT event_date, event_name, items
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`
),
agg AS (                                  -- aggregate qty of every other item
  SELECT
    SUBSTR(event_date,1,6)      AS ym,          -- month (YYYYMM)
    other.item_name             AS product,     -- co‑purchased product
    SUM(other.quantity)         AS qty
  FROM all_events
  CROSS JOIN UNNEST(items) AS tee
  CROSS JOIN UNNEST(items) AS other
  WHERE event_name = 'purchase'
    AND LOWER(tee.item_name) = 'google red speckled tee'
    AND LOWER(other.item_name) <> 'google red speckled tee'
  GROUP BY ym, product
),
ranked AS (                               -- rank products within each month
  SELECT
    ym,
    product,
    qty,
    ROW_NUMBER() OVER (PARTITION BY ym ORDER BY qty DESC) AS rn
  FROM agg
)
SELECT ym,
       product       AS top_other_product,
       qty           AS total_quantity
FROM ranked
WHERE rn = 1
ORDER BY ym
Answer:
ym,top_other_product,total_quantity
202011,Google Decal,17
202012,Google Navy Speckled Tee,12
202101,Google PNW Campus Sticker,12
Query:
--Description: (#9 corrected)  Same logic as #8 but emphasises the ranking step
-- with an inner UNION‑ALL of all daily tables first, then aggregates and finally
-- returns only the single most‑purchased “other” product per month.  (Very
-- similar to #8; retained for demonstration.)
WITH joined AS (                          -- combine daily tables
  SELECT event_date, event_name, items
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
  UNION ALL
  SELECT event_date, event_name, items
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  UNION ALL
  SELECT event_date, event_name, items
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`
),
agg AS (                                  -- qty per month & product
  SELECT
    SUBSTR(event_date,1,6) AS ym,
    other.item_name        AS product,
    SUM(other.quantity)    AS qty
  FROM joined
  CROSS JOIN UNNEST(items) AS tee
  CROSS JOIN UNNEST(items) AS other
  WHERE event_name = 'purchase'
    AND LOWER(tee.item_name) = 'google red speckled tee'
    AND LOWER(other.item_name) <> 'google red speckled tee'
  GROUP BY ym, product
),
ranked AS (                               -- get the top‑ranked product
  SELECT
    ym,
    product,
    qty,
    ROW_NUMBER() OVER (PARTITION BY ym ORDER BY qty DESC) AS rn
  FROM agg
)
SELECT
  ym                                   AS month_yyyymm,
  product                              AS most_purchased_other_product,
  qty                                  AS total_quantity
FROM ranked
WHERE rn = 1
ORDER BY ym
