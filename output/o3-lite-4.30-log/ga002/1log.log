```sql
-- 8. Full three‑month summary: top “other” product per month
WITH joined AS (
  SELECT SUBSTR(event_date,1,6) AS ym,
         other.item_name        AS product,
         SUM(other.quantity)    AS qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_2020*` AS e
  CROSS JOIN UNNEST(e.items) AS tee
  CROSS JOIN UNNEST(e.items) AS other
  WHERE e.event_name = 'purchase'
    AND SUBSTR(event_date,1,6) IN ('202011','202012')
    AND LOWER(tee.item_name) = 'google red speckled tee'
    AND LOWER(other.item_name) <> 'google red speckled tee'
  GROUP BY ym, product

  UNION ALL

  SELECT SUBSTR(event_date,1,6),
         other.item_name,
         SUM(other.quantity)
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*` AS e
  CROSS JOIN UNNEST(e.items) AS tee
  CROSS JOIN UNNEST(e.items) AS other
  WHERE e.event_name = 'purchase'
    AND LOWER(tee.item_name) = 'google red speckled tee'
    AND LOWER(other.item_name) <> 'google red speckled tee'
  GROUP BY ym, product
)
SELECT *
FROM joined
ORDER BY ym, qty DESC
LIMIT 20;
```

```sql
-- 9. Same as #8 but keep ONLY the ‘most‑purchased’ product per month
WITH joined AS (
  SELECT SUBSTR(event_date,1,6) AS ym,
         other.item_name        AS product,
         SUM(other.quantity)    AS qty
  FROM (
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
        UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
        UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`
       ) AS e
  CROSS JOIN UNNEST(e.items) AS tee
  CROSS JOIN UNNEST(e.items) AS other
  WHERE e.event_name = 'purchase'
    AND SUBSTR(event_date,1,6) IN ('202011','202012','202101')
    AND LOWER(tee.item_name) = 'google red speckled tee'
    AND LOWER(other.item_name) <> 'google red speckled tee'
  GROUP BY ym, product
), ranked AS (
  SELECT ym, product, qty,
         ROW_NUMBER() OVER (PARTITION BY ym ORDER BY qty DESC) AS rn
  FROM joined
)
SELECT ym          AS month_yyyymm,
       product     AS most_purchased_other_product,
       qty         AS total_quantity
FROM ranked
WHERE rn = 1
ORDER BY ym
LIMIT 20;
```

```sql
-- 10. FINAL answer‑ready query: list all ‘other’ products with quantities per month, ordered by quantity desc
SELECT SUBSTR(event_date,1,6)  AS month_yyyymm,
       other.item_name         AS product,
       SUM(other.quantity)     AS total_quantity
FROM (
      SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
      UNION ALL
      SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
      UNION ALL
      SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`
     ) AS e
CROSS JOIN UNNEST(e.items)  AS tee
CROSS JOIN UNNEST(e.items)  AS other
WHERE e.event_name = 'purchase'
  AND SUBSTR(event_date,1,6) IN ('202011','202012','202101')
  AND LOWER(tee.item_name) = 'google red speckled tee'
  AND LOWER(other.item_name) <> 'google red speckled tee'
GROUP BY month_yyyymm, product
ORDER BY month_yyyymm, total_quantity DESC
LIMIT 20;
```




