```sql
--Description: 🔟  FINAL ANSWER query – for Nov‑2020, Dec‑2020, and Jan‑2021,
--                 return the single most‑purchased *other* product (and its
--                 total quantity) among customers who bought any “Speckled Tee”.
WITH tee_buyers AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS i
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
    AND LOWER(i.item_name) LIKE '%speckled%tee%'
)
SELECT
  month,
  item_name,
  total_qty
FROM (
  SELECT
    FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', event_date)) AS month,
    other.item_name,
    SUM(other.quantity) AS total_qty,
    ROW_NUMBER() OVER (PARTITION BY FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', event_date))
                       ORDER BY SUM(other.quantity) DESC) AS rk
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS other
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM tee_buyers)
    AND LOWER(other.item_name) NOT LIKE '%speckled%tee%'
  GROUP BY month, other.item_name
)
WHERE rk = 1
ORDER BY month
LIMIT 20;
```
