--   1. tee_buyers  – collect distinct user_pseudo_id values that purchased an
--      item whose name contains both “speckled” and “tee” (case‑insensitive)
--      between 1‑Nov‑2020 and 31‑Jan‑2021.
--   2. monthly_totals – for every purchase made by those users in that date
--      range, explode the items array, filter out any remaining tee lines, turn
--      event_date (YYYYMMDD) into a YYYY‑MM label, and sum quantity per
--      (month, item_name).
--   3. Final SELECT – within each month, rank products by total_qty, keep the
--      top‑ranked one (rk = 1), and output month, item_name, total_qty.
WITH tee_buyers AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS i
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
    AND LOWER(i.item_name) LIKE '%speckled%tee%'
),
monthly_totals AS (
  SELECT
    FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', event_date)) AS month,
    other.item_name,
    SUM(other.quantity) AS total_qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS other
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM tee_buyers)
    AND LOWER(other.item_name) NOT LIKE '%speckled%tee%'
  GROUP BY month, other.item_name
)
SELECT
  month,
  item_name,
  total_qty
FROM (
  SELECT
    month,
    item_name,
    total_qty,
    ROW_NUMBER() OVER (PARTITION BY month ORDER BY total_qty DESC) AS rk
  FROM monthly_totals
)
WHERE rk = 1
ORDER BY month;
