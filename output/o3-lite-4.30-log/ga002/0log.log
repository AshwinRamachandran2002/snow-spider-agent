--Description: The original “final answer” query produced an error because the
--ROW_NUMBER window used SUBSTR(e.event_date,1,6) in its PARTITION BY clause,
--yet the SELECT was grouped by an alias (“month”).  This fix introduces a
--single year‑month key (yrmo) in a first CTE, aggregates on that key, and then
--partitions the window function by the same yrmo column—eliminating the
--mismatch.  The query returns, for each of the three target months, the one
--“other” product (i.e. any item that is NOT a Google Red Speckled Tee) that
--tee‑buyers purchased the most, along with the total quantity.
WITH monthly_totals AS (
  SELECT
    SUBSTR(e.event_date, 1, 6)        AS yrmo,           -- 202011, 202012, 202101
    i_other.item_name                 AS other_product,
    SUM(i_other.quantity)             AS total_qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
  CROSS JOIN UNNEST(e.items) AS i_tee
  CROSS JOIN UNNEST(e.items) AS i_other
  WHERE e.event_name = 'purchase'
    AND e.event_date BETWEEN '20201101' AND '20210131'
    AND LOWER(i_tee.item_name) LIKE '%red%speckled%tee%'         -- find tee
    AND LOWER(i_other.item_name) NOT LIKE '%red%speckled%tee%'   -- exclude tee
  GROUP BY yrmo, other_product
),
ranked AS (
  SELECT
    yrmo,
    other_product,
    total_qty,
    ROW_NUMBER() OVER (PARTITION BY yrmo ORDER BY total_qty DESC) AS rn
  FROM monthly_totals
)
SELECT
  CASE yrmo
       WHEN '202011' THEN '2020-11'
       WHEN '202012' THEN '2020-12'
       WHEN '202101' THEN '2021-01'
  END                               AS month,
  other_product                     AS most_purchased_other_product,
  total_qty                         AS total_quantity
FROM ranked
WHERE rn = 1
ORDER BY month
LIMIT 20;
