```sql
--Description: Final step – return the single most‑purchased “other” product
--for each of the three months (2020‑11, 2020‑12, 2021‑01) among customers who
--bought any item whose name contains “red speckled tee”.  We first aggregate
--quantities per (yrmo, other_item) in a CTE, then rank items within each month
--and keep only the top‑ranked row (rn = 1).  The month column is presented in
--YYYY‑MM format for readability.
WITH monthly_totals AS (
  SELECT
    SUBSTR(e.event_date, 1, 6)        AS yrmo,               -- e.g. 202011
    i_other.item_name                 AS other_product,
    SUM(i_other.quantity)             AS total_qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
  CROSS JOIN UNNEST(e.items) AS i_tee
  CROSS JOIN UNNEST(e.items) AS i_other
  WHERE e.event_name = 'purchase'
    AND e.event_date BETWEEN '20201101' AND '20210131'
    AND LOWER(i_tee.item_name) LIKE '%red%speckled%tee%'     -- “tee” events
    AND LOWER(i_other.item_name) NOT LIKE '%red%speckled%tee%' -- exclude the tee itself
  GROUP BY yrmo, other_product
),
ranked AS (
  SELECT
    yrmo,
    other_product,
    total_qty,
    ROW_NUMBER() OVER (PARTITION BY yrmo ORDER BY total_qty DESC) AS rn
  FROM monthly_totals
)
SELECT
  CASE yrmo
       WHEN '202011' THEN '2020-11'
       WHEN '202012' THEN '2020-12'
       WHEN '202101' THEN '2021-01'
  END                           AS month,
  other_product                 AS most_purchased_other_product,
  total_qty                     AS total_quantity
FROM ranked
WHERE rn = 1
ORDER BY month;
```
