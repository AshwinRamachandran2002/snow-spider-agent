```sql
--Description: ⑦  Aggregate those “other” items by customer and by calendar
--month (yrmo = YYYYMM) to see how many units each customer bought together
--with the tee.  Uses flexible LIKE filters and covers the full date window.
SELECT
  SUBSTR(e.event_date,1,6)          AS yrmo,
  e.user_pseudo_id,
  i_other.item_name,
  SUM(i_other.quantity)             AS qty
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
CROSS JOIN UNNEST(e.items) AS i_tee
CROSS JOIN UNNEST(e.items) AS i_other
WHERE e.event_name = 'purchase'
  AND e.event_date BETWEEN '20201101' AND '20210131'
  AND LOWER(i_tee.item_name) LIKE '%red%speckled%tee%'
  AND LOWER(i_other.item_name) NOT LIKE '%red%speckled%tee%'
GROUP BY yrmo, e.user_pseudo_id, i_other.item_name
LIMIT 20;
```

```sql
--Description: ⑧  Sum quantities across all tee‑buying customers to see which
--“other” products were purchased the most in each month of the three‑month
--window.
SELECT
  SUBSTR(e.event_date,1,6)          AS yrmo,
  i_other.item_name,
  SUM(i_other.quantity)             AS qty
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
CROSS JOIN UNNEST(e.items) AS i_tee
CROSS JOIN UNNEST(e.items) AS i_other
WHERE e.event_name = 'purchase'
  AND e.event_date BETWEEN '20201101' AND '20210131'
  AND LOWER(i_tee.item_name) LIKE '%red%speckled%tee%'
  AND LOWER(i_other.item_name) NOT LIKE '%red%speckled%tee%'
GROUP BY yrmo, i_other.item_name
ORDER BY yrmo, qty DESC
LIMIT 20;
```

```sql
--Description: ⑨  From the monthly aggregates in #8, pick the single “other”
--product with the highest total quantity for each month (yrmo).  The ROW_NUMBER
--window function selects the top product per partition.
SELECT
  yrmo,
  item_name,
  qty
FROM (
  SELECT
    SUBSTR(e.event_date,1,6)                       AS yrmo,
    i_other.item_name                              AS item_name,
    SUM(i_other.quantity)                          AS qty,
    ROW_NUMBER() OVER (PARTITION BY SUBSTR(e.event_date,1,6)
                       ORDER BY SUM(i_other.quantity) DESC) AS rn
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
  CROSS JOIN UNNEST(e.items) AS i_tee
  CROSS JOIN UNNEST(e.items) AS i_other
  WHERE e.event_name = 'purchase'
    AND e.event_date BETWEEN '20201101' AND '20210131'
    AND LOWER(i_tee.item_name) LIKE '%red%speckled%tee%'
    AND LOWER(i_other.item_name) NOT LIKE '%red%speckled%tee%'
  GROUP BY yrmo, i_other.item_name
)
WHERE rn = 1
ORDER BY yrmo
LIMIT 20;
```

```sql
--Description: ⑩  Final answer – for November 2020, December 2020, and January 2021,
--return the most‑purchased “other” product among tee buyers and the total
--quantity purchased.  Uses flexible LIKE matching, three‑month window, and
--ROW_NUMBER to extract the winner per month.
WITH monthly_rank AS (
  SELECT
    CASE SUBSTR(e.event_date,1,6)
         WHEN '202011' THEN '2020‑11'
         WHEN '202012' THEN '2020‑12'
         WHEN '202101' THEN '2021‑01'
    END                                           AS month,
    i_other.item_name                             AS other_product,
    SUM(i_other.quantity)                         AS total_qty,
    ROW_NUMBER() OVER (PARTITION BY SUBSTR(e.event_date,1,6)
                       ORDER BY SUM(i_other.quantity) DESC) AS rn
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
  CROSS JOIN UNNEST(e.items) AS i_tee
  CROSS JOIN UNNEST(e.items) AS i_other
  WHERE e.event_name = 'purchase'
    AND e.event_date BETWEEN '20201101' AND '20210131'
    AND LOWER(i_tee.item_name) LIKE '%red%speckled%tee%'
    AND LOWER(i_other.item_name) NOT LIKE '%red%speckled%tee%'
  GROUP BY month, i_other.item_name
)
SELECT
  month,
  other_product  AS most_purchased_other_product,
  total_qty      AS total_quantity
FROM monthly_rank
WHERE rn = 1
ORDER BY month
LIMIT 20;
```
