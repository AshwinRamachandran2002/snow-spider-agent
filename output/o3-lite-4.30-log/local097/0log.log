WHERE  CAST("year" AS INTEGER) BETWEEN 2000 AND 2009;
```

```sql
-- 8) Produce counts for *all* 10‑year windows, one row per distinct start year
SELECT  a.start_year,
        COUNT(*) AS films_in_window
FROM   (SELECT DISTINCT CAST("year" AS INTEGER) AS start_year
        FROM "Movie") AS a               -- every possible window start
JOIN   "Movie"  AS b
  ON   CAST(b."year" AS INTEGER) BETWEEN a.start_year
                                      AND a.start_year + 9
GROUP  BY a.start_year
ORDER  BY a.start_year
LIMIT 20;
```

```sql
-- 9) Same as (8) but ranked by size so we can see which window is largest
SELECT  a.start_year,
        COUNT(*) AS films_in_window
FROM   (SELECT DISTINCT CAST("year" AS INTEGER) AS start_year
        FROM "Movie") AS a
JOIN   "Movie" AS b
  ON   CAST(b."year" AS INTEGER) BETWEEN a.start_year
                                   AND a.start_year + 9
GROUP  BY a.start_year
ORDER  BY films_in_window DESC, a.start_year
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: start year of the 10‑year window with most films and its count
SELECT  a.start_year,
        COUNT(*) AS films_in_window
FROM   (SELECT DISTINCT CAST("year" AS INTEGER) AS start_year
        FROM "Movie") AS a
JOIN   "Movie" AS b
  ON   CAST(b."year" AS INTEGER) BETWEEN a.start_year
                                   AND a.start_year + 9
GROUP  BY a.start_year
ORDER  BY films_in_window DESC, a.start_year
LIMIT 1;
```

Running query 10 will return exactly two columns:  

start_year | films_in_window  

which gives the opening year of the most‑populated consecutive ten‑year span and how many movies fall inside that window.
