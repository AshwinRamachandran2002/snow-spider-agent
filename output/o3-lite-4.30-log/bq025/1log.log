  SELECT country_code, SUM(midyear_population) AS pop_under20
  FROM `bigquery-public-data.census_bureau_international.midyear_population_5yr_age_sex`
  WHERE year = 2020
    AND total_flag = 'A'
    AND age_group_indicator = '-'
    AND starting_age < 20
  GROUP BY country_code
)
SELECT t.country_name,
       u.pop_under20,
       t.midyear_population AS total_pop,
       ROUND(100 * u.pop_under20 / t.midyear_population, 2) AS pct_under20
FROM under20 u
JOIN `bigquery-public-data.census_bureau_international.midyear_population` t
  ON u.country_code = t.country_code
WHERE t.year = 2020
ORDER BY pct_under20 DESC
LIMIT 10;
