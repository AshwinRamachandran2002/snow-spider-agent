Relevant tables / columns for the task  

• `bigquery-public-data.census_bureau_international.midyear_population_agespecific`  
   - `country_code`, `country_name` – identify the country  
   - `year` – filter for 2020  
   - `age` – keep only ages < 20  
   - `population` – number of people of that exact age/sex (to be aggregated)  

• `bigquery-public-data.census_bureau_international.midyear_population`  
   - `country_code`, `country_name` – identify the country  
   - `year` – filter for 2020  
   - `midyear_population` – total population in 2020 (denominator for percentage)  

Typical conditions that will be used  

```
WHERE year = 2020
```

and, for the age–specific table,  

```
WHERE age < 20
```

───────────────────────────────────────────────  
10 exploratory → final SQL queries
───────────────────────────────────────────────  

```sql
-- 1. Peek at age–specific records for 2020 (first 20 rows)
SELECT *
FROM `bigquery-public-data.census_bureau_international.midyear_population_agespecific`
WHERE year = 2020
LIMIT 20;
```

```sql
-- 2. What ages are present in the age‑specific table?
SELECT DISTINCT age
FROM `bigquery-public-data.census_bureau_international.midyear_population_agespecific`
ORDER BY age
LIMIT 20;
```

```sql
-- 3. Population at each age (<20) for one sample country (e.g., Afghanistan) in 2020
SELECT country_name, age, SUM(population) AS pop_at_age
FROM `bigquery-public-data.census_bureau_international.midyear_population_agespecific`
WHERE year = 2020
  AND country_name = 'Afghanistan'
  AND age < 20
GROUP BY country_name, age
ORDER BY age
LIMIT 20;
```

```sql
-- 4. Total 2020 population for that same country from the summary table
SELECT country_name, midyear_population
FROM `bigquery-public-data.census_bureau_international.midyear_population`
WHERE year = 2020
  AND country_name = 'Afghanistan';
```

```sql
-- 5. Sum of population under 20 for every country in 2020
SELECT country_code,
       country_name,
       SUM(population) AS pop_under_20
FROM `bigquery-public-data.census_bureau_international.midyear_population_agespecific`
WHERE year = 2020
  AND age < 20
GROUP BY country_code, country_name
LIMIT 20;
```

```sql
-- 6. Total mid‑year 2020 population for every country
SELECT country_code,
       country_name,
       midyear_population AS total_pop_2020
FROM `bigquery-public-data.census_bureau_international.midyear_population`
WHERE year = 2020
LIMIT 20;
```

```sql
-- 7. Join the two aggregates to compute % population under 20 (all countries)
SELECT t.country_code,
       t.country_name,
       u.pop_under_20,
       t.total_pop_2020,
       100.0 * u.pop_under_20 / t.total_pop_2020 AS pct_under_20
FROM (
    SELECT country_code, country_name, midyear_population AS total_pop_2020
    FROM `bigquery-public-data.census_bureau_international.midyear_population`
    WHERE year = 2020
) AS t
JOIN (
    SELECT country_code, country_name, SUM(population) AS pop_under_20
    FROM `bigquery-public-data.census_bureau_international.midyear_population_agespecific`
    WHERE year = 2020
      AND age < 20
    GROUP BY country_code, country_name
) AS u
USING (country_code)
LIMIT 20;
```

```sql
-- 8. Same as (7) but ordered by the percentage descending
SELECT t.country_code,
       t.country_name,
       u.pop_under_20,
       t.total_pop_2020,
       100.0 * u.pop_under_20 / t.total_pop_2020 AS pct_under_20
FROM (
    SELECT country_code, country_name, midyear_population AS total_pop_2020
    FROM `bigquery-public-data.census_bureau_international.midyear_population`
    WHERE year = 2020
) AS t
JOIN (
    SELECT country_code, country_name, SUM(population) AS pop_under_20
    FROM `bigquery-public-data.census_bureau_international.midyear_population_agespecific`
    WHERE year = 2020
      AND age < 20
    GROUP BY country_code, country_name
) AS u
USING (country_code)
ORDER BY pct_under_20 DESC
LIMIT 20;
```

```sql
-- 9. Add rounding to two decimals and limit to top‑10
SELECT t.country_name,
       u.pop_under_20,
       t.total_pop_2020,
       ROUND(100.0 * u.pop_under_20 / t.total_pop_2020, 2) AS pct_under_20
FROM (
    SELECT country_code, country_name, midyear_population AS total_pop_2020
    FROM `bigquery-public-data.census_bureau_international.midyear_population`
    WHERE year = 2020
) AS t
JOIN (
    SELECT country_code, country_name, SUM(population) AS pop_under_20
    FROM `bigquery-public-data.census_bureau_international.midyear_population_agespecific`
    WHERE year = 2020
      AND age < 20
    GROUP BY country_code, country_name
) AS u
USING (country_code)
ORDER BY pct_under_20 DESC
LIMIT 10;
```

```sql
-- 10. Final answer query: Top‑10 countries, 2020, highest % population under 20
SELECT
  t.country_name                          AS country,
  u.pop_under_20                          AS population_under_20,
  t.total_pop_2020                        AS total_population,
  ROUND(100.0 * u.pop_under_20 / t.total_pop_2020, 2) AS percent_under_20
FROM (
  SELECT country_code,
         country_name,
         midyear_population AS total_pop_2020
  FROM `bigquery-public-data.census_bureau_international.midyear_population`
  WHERE year = 2020
) t
JOIN (
  SELECT country_code,
         country_name,
         SUM(population) AS pop_under_20
  FROM `bigquery-public-data.census_bureau_international.midyear_population_agespecific`
  WHERE year = 2020
    AND age < 20
  GROUP BY country_code, country_name
) u
USING (country_code)
ORDER BY percent_under_20 DESC
LIMIT 10;
```
