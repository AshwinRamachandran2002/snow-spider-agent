-- 7. Join the two aggregates to compute % population under 20 (all countries)
SELECT t.country_code,
       t.country_name,
       u.pop_under_20,
       t.total_pop_2020,
       100.0 * u.pop_under_20 / t.total_pop_2020 AS pct_under_20
FROM (
    SELECT country_code, country_name, midyear_population AS total_pop_2020
    FROM `bigquery-public-data.census_bureau_international.midyear_population`
    WHERE year = 2020
) AS t
JOIN (
    SELECT country_code, country_name, SUM(population) AS pop_under_20
    FROM `bigquery-public-data.census_bureau_international.midyear_population_agespecific`
    WHERE year = 2020
      AND age < 20
    GROUP BY country_code, country_name
) AS u
USING (country_code)
LIMIT 20;
