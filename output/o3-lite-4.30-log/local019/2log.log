```sql
--Description / thinking process:
-- 1) We need the two wrestlers in the SHORTEST NXT‑title match where the title did NOT change hands.
-- 2) Filter Matches by:
--        • title belongs to a belt whose name contains “NXT”
--        • title_change = 0
--        • duration is present (contains a colon)
-- 3) Convert the duration text (assumed 'MM:SS' for the shortest bouts) to total seconds
--    so we can order numerically and pick the minimum.
-- 4) Join Wrestlers twice (winner_id, loser_id) to get their names.
-- 5) Return the first row (LIMIT 1) – that is our answer.
SELECT w1.name AS wrestler_1,
       w2.name AS wrestler_2
FROM   Matches   AS m
JOIN   Belts     AS b  ON b.id = m.title_id
JOIN   Wrestlers AS w1 ON w1.id = m.winner_id
JOIN   Wrestlers AS w2 ON w2.id = m.loser_id
WHERE  b.name LIKE '%NXT%'          -- step 2a
  AND  m.title_change = 0           -- step 2b
  AND  m.duration LIKE '%:%'        -- step 2c
ORDER BY                             -- step 3
  (CAST(substr(m.duration,1,instr(m.duration,':')-1) AS INTEGER) * 60 +
   CAST(substr(m.duration,instr(m.duration,':')+1)        AS INTEGER))
LIMIT 1;                             -- step 5
