-- 6. Find the single highest‑scoring over for each match & innings
SELECT x.match_id,
       x.innings_no,
       MAX(x.total_runs) AS highest_over_runs
FROM (
     SELECT b.match_id,
            b.innings_no,
            b.over_id,
            COALESCE(SUM(b.runs_scored),0) + COALESCE(SUM(e.extra_runs),0) AS total_runs
     FROM batsman_scored AS b
     LEFT JOIN extra_runs AS e
       ON b.match_id   = e.match_id
      AND b.over_id    = e.over_id
      AND b.innings_no = e.innings_no
     GROUP BY b.match_id, b.innings_no, b.over_id
) AS x
GROUP BY x.match_id, x.innings_no
LIMIT 20;
