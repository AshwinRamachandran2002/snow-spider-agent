-- 7. Which bowler delivered those max‑run overs?  (showing just one match for clarity)
WITH per_over AS (
     SELECT b.match_id,
            b.innings_no,
            b.over_id,
            COALESCE(SUM(b.runs_scored),0) + COALESCE(SUM(e.extra_runs),0) AS total_runs
     FROM batsman_scored AS b
     LEFT JOIN extra_runs AS e
       ON b.match_id   = e.match_id
      AND b.over_id    = e.over_id
      AND b.innings_no = e.innings_no
     GROUP BY b.match_id, b.innings_no, b.over_id
), max_over AS (
     SELECT po.*
     FROM per_over AS po
     JOIN (
          SELECT match_id, innings_no, MAX(total_runs) AS mx
          FROM per_over
          GROUP BY match_id, innings_no
     ) AS m
     ON po.match_id = m.match_id
    AND po.innings_no = m.innings_no
    AND po.total_runs = m.mx
)
SELECT mo.match_id,
       mo.innings_no,
       mo.over_id,
       mo.total_runs,
       bb.bowler
FROM max_over AS mo
JOIN ball_by_ball AS bb
  ON mo.match_id   = bb.match_id
 AND mo.over_id    = bb.over_id
 AND mo.innings_no = bb.innings_no
GROUP BY mo.match_id, mo.innings_no;  -- bowler is unique per over
