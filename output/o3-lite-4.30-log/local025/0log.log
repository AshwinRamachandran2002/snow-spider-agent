SELECT DISTINCT "over_id"
FROM "batsman_scored"
WHERE "match_id" = 335987
ORDER BY "over_id"
LIMIT 20;
```

```sql
-- 4. Preview the raw runs scored off the bat for the same match
SELECT "match_id", "innings_no", "over_id", "ball_id", "runs_scored"
FROM "batsman_scored"
WHERE "match_id" = 335987
LIMIT 20;
```

```sql
-- 5. Find overs that have any kind of extra runs recorded
SELECT DISTINCT "match_id", "innings_no", "over_id"
FROM "extra_runs"
LIMIT 20;
```

```sql
-- 6. Combine bat‑runs and extra‑runs to get total runs per over for a single match
SELECT bs."match_id",
       bs."innings_no",
       bs."over_id",
       SUM(bs."runs_scored") +
       COALESCE(SUM(er."extra_runs"),0) AS "total_runs"
FROM   "batsman_scored" AS bs
LEFT JOIN "extra_runs"  AS er
       ON  bs."match_id"   = er."match_id"
       AND bs."innings_no" = er."innings_no"
       AND bs."over_id"    = er."over_id"
GROUP  BY bs."match_id", bs."innings_no", bs."over_id"
ORDER BY "total_runs" DESC
LIMIT 20;
```

```sql
-- 7. Same aggregation for ALL matches, showing the 20 most expensive overs overall
SELECT bs."match_id",
       bs."innings_no",
       bs."over_id",
       SUM(bs."runs_scored") +
       COALESCE(SUM(er."extra_runs"),0) AS "total_runs"
FROM   "batsman_scored" AS bs
LEFT JOIN "extra_runs"  AS er
       ON  bs."match_id"   = er."match_id"
       AND bs."innings_no" = er."innings_no"
       AND bs."over_id"    = er."over_id"
GROUP  BY bs."match_id", bs."innings_no", bs."over_id"
ORDER BY "total_runs" DESC
LIMIT 20;
```

```sql
-- 8. Attach the bowler (player_id) to every over for one sample match
SELECT bb."match_id",
       bb."innings_no",
       bb."over_id",
       bb."bowler"
FROM   "ball_by_ball" AS bb
WHERE  bb."match_id" = 335987
GROUP  BY bb."match_id", bb."innings_no", bb."over_id", bb."bowler"
LIMIT 20;
```

```sql
-- 9. For every match, find the single highest‑scoring over (total_runs) and its bowler
WITH over_totals AS (
    SELECT bs."match_id",
           bs."innings_no",
           bs."over_id",
           SUM(bs."runs_scored") +
           COALESCE(SUM(er."extra_runs"),0) AS "total_runs"
    FROM   "batsman_scored" AS bs
    LEFT JOIN "extra_runs"  AS er
           ON  bs."match_id"   = er."match_id"
           AND bs."innings_no" = er."innings_no"
           AND bs."over_id"    = er."over_id"
    GROUP  BY bs."match_id", bs."innings_no", bs."over_id"
),
ranked AS (
    SELECT ot.*,
           ROW_NUMBER() OVER (PARTITION BY ot."match_id"
                              ORDER BY ot."total_runs" DESC) AS rn
    FROM   over_totals AS ot
)
SELECT r."match_id",
       r."innings_no",
       r."over_id",
       r."total_runs",
       bb."bowler"
FROM   ranked AS r
JOIN   "ball_by_ball" AS bb
       ON  r."match_id"   = bb."match_id"
       AND r."innings_no" = bb."innings_no"
       AND r."over_id"    = bb."over_id"
WHERE  r.rn = 1
GROUP  BY r."match_id", r."innings_no", r."over_id", r."total_runs", bb."bowler"
LIMIT 20;
```

```sql
-- 10. Compute the average of the highest‑scoring over totals across all matches
WITH over_totals AS (
    SELECT bs."match_id",
           bs."innings_no",
           bs."over_id",
           SUM(bs."runs_scored") +
           COALESCE(SUM(er."extra_runs"),0) AS "total_runs"
    FROM   "batsman_scored" AS bs
    LEFT JOIN "extra_runs"  AS er
           ON  bs."match_id"   = er."match_id"
           AND bs."innings_no" = er."innings_no"
           AND bs."over_id"    = er."over_id"
    GROUP  BY bs."match_id", bs."innings_no", bs."over_id"
),
best_over_per_match AS (
    SELECT "match_id", MAX("total_runs") AS "max_over_runs"
    FROM   over_totals
    GROUP  BY "match_id"
)
SELECT AVG("max_over_runs") AS "avg_highest_over_runs_across_matches"
FROM   best_over_per_match;
```

