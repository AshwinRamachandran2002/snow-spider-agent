    JOIN  (
            SELECT "match_id", MAX(total_runs) AS max_total
            FROM   over_totals
            GROUP  BY "match_id"
          ) mx
          ON ot."match_id" = mx."match_id"
         AND ot.total_runs = mx.max_total
),
highest_with_bowler AS (
    SELECT ho."match_id",
           ho.total_runs,
           bb."bowler"
    FROM   highest_over AS ho
    JOIN   "ball_by_ball" AS bb
           ON  ho."match_id"   = bb."match_id"
           AND ho."innings_no" = bb."innings_no"
           AND ho."over_id"    = bb."over_id"
    GROUP  BY ho."match_id"          -- one row per match (over has single bowler)
)
SELECT CAST(AVG(total_runs) AS INTEGER) AS average_highest_over_runs
FROM   highest_with_bowler;
