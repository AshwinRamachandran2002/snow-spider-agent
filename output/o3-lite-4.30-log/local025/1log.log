2025-05-01 03:11:09 - Thread-1226 (execute) - INFO - [Exploration]
Relevant columns and their potential usage
• ball_by_ball.match_id – key to identify the match and to join with other fact tables  
• ball_by_ball.innings_no – distinguishes 1st / 2nd innings within a match  
• ball_by_ball.over_id – groups six legal‑balls that form one over  
• ball_by_ball.ball_id – lets us align individual deliveries across tables  
• ball_by_ball.bowler – player_id of the bowler who delivered the over; later joined to player.player_id for the name  
• batsman_scored.runs_scored – runs the striker actually scores off the bat  
• extra_runs.extra_runs – runs not credited to the striker (wides, no‑balls, byes, leg‑byes, etc.)  
• batsman_scored / extra_runs (match_id, over_id, ball_id, innings_no) – composite keys enabling joins with ball_by_ball, so we can sum all runs for each delivery  
• player.player_id / player.player_name – to convert bowler id into human‑readable name  

Typical conditions / join keys that will be needed  
• batsman_scored.match_id  = ball_by_ball.match_id  
• batsman_scored.over_id   = ball_by_ball.over_id  
• batsman_scored.ball_id   = ball_by_ball.ball_id  
• batsman_scored.innings_no = ball_by_ball.innings_no  
(and the same pattern with extra_runs)  

Ten exploratory SQL queries (each capped at 20 rows)

```sql
-- 1. Distinct innings numbers present in the scoring table
SELECT DISTINCT innings_no
FROM batsman_scored
LIMIT 20;
```

```sql
-- 2. Sample list of distinct over numbers that appear in ball_by_ball
SELECT DISTINCT over_id
FROM ball_by_ball
ORDER BY over_id
LIMIT 20;
```

```sql
-- 3. Sample of bowler player‑ids seen in the data
SELECT DISTINCT bowler
FROM ball_by_ball
LIMIT 20;
```

```sql
-- 4. Map a few bowler ids to their names
SELECT DISTINCT bb.bowler AS bowler_id,
       p.player_name
FROM ball_by_ball AS bb
JOIN player       AS p ON p.player_id = bb.bowler
LIMIT 20;
```

```sql
-- 5. Show combined runs (bat + extras) per single ball for one sample match
SELECT bb.match_id,
       bb.innings_no,
       bb.over_id,
       bb.ball_id,
       COALESCE(bs.runs_scored,0)    AS bat_runs,
       COALESCE(er.extra_runs,0)     AS extra_runs,
       COALESCE(bs.runs_scored,0)+COALESCE(er.extra_runs,0) AS total_runs
FROM ball_by_ball AS bb
LEFT JOIN batsman_scored AS bs
       ON bs.match_id   = bb.match_id
      AND bs.over_id    = bb.over_id
      AND bs.ball_id    = bb.ball_id
      AND bs.innings_no = bb.innings_no
LEFT JOIN extra_runs AS er
       ON er.match_id   = bb.match_id
      AND er.over_id    = bb.over_id
      AND er.ball_id    = bb.ball_id
      AND er.innings_no = bb.innings_no
WHERE bb.match_id = (SELECT match_id FROM ball_by_ball LIMIT 1)
LIMIT 20;
```

```sql
-- 6. Aggregate total runs per over (per innings) for the same sample match
SELECT bb.match_id,
       bb.innings_no,
       bb.over_id,
       SUM(COALESCE(bs.runs_scored,0)+COALESCE(er.extra_runs,0)) AS over_total
FROM ball_by_ball AS bb
LEFT JOIN batsman_scored AS bs
       ON bs.match_id   = bb.match_id
      AND bs.over_id    = bb.over_id
      AND bs.ball_id    = bb.ball_id
      AND bs.innings_no = bb.innings_no
LEFT JOIN extra_runs AS er
       ON er.match_id   = bb.match_id
      AND er.over_id    = bb.over_id
      AND er.ball_id    = bb.ball_id
      AND er.innings_no = bb.innings_no
WHERE bb.match_id = (SELECT match_id FROM ball_by_ball LIMIT 1)
GROUP BY bb.match_id, bb.innings_no, bb.over_id
ORDER BY over_total DESC
LIMIT 20;
```

```sql
-- 7. Identify the single highest‑scoring over for every match+innings
SELECT x.match_id,
       x.innings_no,
       x.over_id,
       x.over_total
FROM (
    SELECT bb.match_id,
           bb.innings_no,
           bb.over_id,
           SUM(COALESCE(bs.runs_scored,0)+COALESCE(er.extra_runs,0)) AS over_total,
           ROW_NUMBER() OVER (PARTITION BY bb.match_id, bb.innings_no ORDER BY SUM(COALESCE(bs.runs_scored,0)+COALESCE(er.extra_runs,0)) DESC) AS rn
    FROM ball_by_ball AS bb
    LEFT JOIN batsman_scored AS bs
           ON bs.match_id   = bb.match_id
          AND bs.over_id    = bb.over_id
          AND bs.ball_id    = bb.ball_id
          AND bs.innings_no = bb.innings_no
    LEFT JOIN extra_runs AS er
           ON er.match_id   = bb.match_id
          AND er.over_id    = bb.over_id
          AND er.ball_id    = bb.ball_id
          AND er.innings_no = bb.innings_no
    GROUP BY bb.match_id, bb.innings_no, bb.over_id
) AS x
WHERE x.rn = 1
LIMIT 20;
```

```sql
-- 8. From those highest‑scoring overs, pick the bigger one across the two innings for each match
WITH per_innings AS (
    SELECT bb.match_id,
           bb.innings_no,
           bb.over_id,
           SUM(COALESCE(bs.runs_scored,0)+COALESCE(er.extra_runs,0)) AS over_total
    FROM ball_by_ball AS bb
    LEFT JOIN batsman_scored AS bs
           ON bs.match_id   = bb.match_id
          AND bs.over_id    = bb.over_id
          AND bs.ball_id    = bb.ball_id
          AND bs.innings_no = bb.innings_no
    LEFT JOIN extra_runs AS er
           ON er.match_id   = bb.match_id
          AND er.over_id    = bb.over_id
          AND er.ball_id    = bb.ball_id
          AND er.innings_no = bb.innings_no
    GROUP BY bb.match_id, bb.innings_no, bb.over_id
),
per_match AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY match_id ORDER BY over_total DESC) AS rn
    FROM per_innings
)
SELECT match_id,
       innings_no,
       over_id,
       over_total
FROM per_match
WHERE rn = 1
LIMIT 20;
```

```sql
-- 9. Attach the bowler (id + name) who delivered that highest‑scoring over
WITH highest AS (
    /* same logic as query 8 */
    WITH per_innings AS (
        SELECT bb.match_id,
               bb.innings_no,
               bb.over_id,
               SUM(COALESCE(bs.runs_scored,0)+COALESCE(er.extra_runs,0)) AS over_total
        FROM ball_by_ball AS bb
        LEFT JOIN batsman_scored AS bs
               ON bs.match_id   = bb.match_id
              AND bs.over_id    = bb.over_id
              AND bs.ball_id    = bb.ball_id
              AND bs.innings_no = bb.innings_no
        LEFT JOIN extra_runs AS er
               ON er.match_id   = bb.match_id
              AND er.over_id    = bb.over_id
              AND er.ball_id    = bb.ball_id
              AND er.innings_no = bb.innings_no
        GROUP BY bb.match_id, bb.innings_no, bb.over_id
    ),
    per_match AS (
        SELECT *,
               ROW_NUMBER() OVER (PARTITION BY match_id ORDER BY over_total DESC) AS rn
        FROM per_innings
    )
    SELECT match_id, innings_no, over_id, over_total
    FROM   per_match
    WHERE  rn = 1
)
SELECT h.match_id,
       h.over_total      AS highest_over_runs,
       h.over_id,
       b.bowler          AS bowler_id,
       p.player_name     AS bowler_name
FROM highest AS h
JOIN ball_by_ball AS b
     ON b.match_id   = h.match_id
    AND b.innings_no = h.innings_no
    AND b.over_id    = h.over_id
LIMIT 20;
```

```sql
-- 10. Compute the average of those highest‑over totals across all matches
WITH per_innings AS (
    SELECT bb.match_id,
           bb.innings_no,
           bb.over_id,
           SUM(COALESCE(bs.runs_scored,0)+COALESCE(er.extra_runs,0)) AS over_total
    FROM ball_by_ball AS bb
    LEFT JOIN batsman_scored AS bs
           ON bs.match_id   = bb.match_id
          AND bs.over_id    = bb.over_id
          AND bs.ball_id    = bb.ball_id
          AND bs.innings_no = bb.innings_no
    LEFT JOIN extra_runs AS er
           ON er.match_id   = bb.match_id
          AND er.over_id    = bb.over_id
          AND er.ball_id    = bb.ball_id
          AND er.innings_no = bb.innings_no
    GROUP BY bb.match_id, bb.innings_no, bb.over_id
),
per_match AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY match_id ORDER BY over_total DESC) AS rn
    FROM per_innings
)
SELECT AVG(over_total) AS avg_highest_over_runs_across_matches
FROM   per_match
WHERE  rn = 1;
```
