    JOIN   ball_by_ball   AS bb
           ON bb.match_id   = bo.match_id
          AND bb.innings_no = bo.innings_no
          AND bb.over_id    = bo.over_id
    GROUP BY bo.match_id, bo.over_total
)
SELECT ROUND(AVG(over_total),4) AS average_highest_over_runs
