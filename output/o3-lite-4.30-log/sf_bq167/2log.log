--Description: FINAL answer query – returns the usernames for both sides of the
--             top pair, the number of distinct up‑votes one received from the
--             other, and how many they returned.  Ordering & ROW_NUMBER ensure
--             only the single highest pair is shown.
WITH pair_counts AS (
    SELECT  "FromUserId"                     AS "giver",
            "ToUserId"                       AS "receiver",
            COUNT(DISTINCT "ForumMessageId") AS "votes_from_to"
    FROM    META_KAGGLE.META_KAGGLE.FORUMMESSAGEVOTES
    GROUP   BY "FromUserId", "ToUserId"
),
pair_bidirectional AS (
    SELECT  pc1."giver",
            pc1."receiver",
            pc1."votes_from_to"              AS "received_from_giver",  -- A → B
            COALESCE(pc2."votes_from_to",0)  AS "given_back",           -- B → A
            ROW_NUMBER() OVER (
                ORDER BY pc1."votes_from_to" DESC,
                         COALESCE(pc2."votes_from_to",0) DESC
            ) AS rn
    FROM    pair_counts pc1
    LEFT JOIN pair_counts pc2
           ON pc2."giver"    = pc1."receiver"
          AND pc2."receiver" = pc1."giver"
)
SELECT  ua."UserName"  AS "user_who_received_most",
        ub."UserName"  AS "user_who_gave_most",
        pb."received_from_giver"  AS "distinct_upvotes_received",
        pb."given_back"           AS "upvotes_returned"
FROM    pair_bidirectional pb
JOIN    META_KAGGLE.META_KAGGLE.USERS ua ON ua."Id" = pb."receiver"
JOIN    META_KAGGLE.META_KAGGLE.USERS ub ON ub."Id" = pb."giver"
WHERE   pb.rn = 1;
