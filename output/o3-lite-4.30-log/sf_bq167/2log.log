--Description / thinking process:
-- 1. Every row in FORUMMESSAGEVOTES is one up‑vote that user "FromUserId" gave to
--    the author of the message "ToUserId".  We want DISTINCT messages, so we
--    count DISTINCT ForumMessageId for each ordered pair (giver → receiver).
-- 2. With that aggregated result (CTE pair_counts) we now know “A → B = N”.
-- 3. To see how many went the other way (“B → A”), self‑join the CTE in reverse.
-- 4. Attach usernames so the final output is human–readable.
-- 5. Order by the largest number of up‑votes received (A→B) and, if tied,
--    by the number given back (B→A).  LIMIT 1 = the single top pair.

WITH pair_counts AS (
    SELECT  "FromUserId"                     AS "giver",
            "ToUserId"                       AS "receiver",
            COUNT(DISTINCT "ForumMessageId") AS "votes_from_to"
    FROM    META_KAGGLE.META_KAGGLE.FORUMMESSAGEVOTES
    GROUP   BY "FromUserId", "ToUserId"
)
SELECT  u_rec."UserName"                  AS "recipient_username",
        u_giv."UserName"                  AS "giver_username",
        pc1."votes_from_to"               AS "distinct_upvotes_received",
        COALESCE(pc2."votes_from_to",0)   AS "upvotes_returned"
FROM    pair_counts pc1
LEFT JOIN pair_counts pc2
       ON pc2."giver"    = pc1."receiver"   -- reverse direction
      AND pc2."receiver" = pc1."giver"
JOIN    META_KAGGLE.META_KAGGLE.USERS u_giv ON u_giv."Id" = pc1."giver"
JOIN    META_KAGGLE.META_KAGGLE.USERS u_rec ON u_rec."Id" = pc1."receiver"
ORDER BY pc1."votes_from_to" DESC,
         COALESCE(pc2."votes_from_to",0) DESC
LIMIT 1;
