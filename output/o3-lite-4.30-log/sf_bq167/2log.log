WITH pair_counts AS (   -- how many DISTINCT forum‑messages each user up‑voted for another user
    SELECT
        "FromUserId"              AS giver_id,
        "ToUserId"                AS receiver_id,
        COUNT(DISTINCT "ForumMessageId") AS upvotes_given          -- A → B
    FROM META_KAGGLE.META_KAGGLE.FORUMMESSAGEVOTES
    GROUP BY "FromUserId", "ToUserId"
),
pair_bidirectional AS (  -- bring the opposite direction together and rank
    SELECT
        pc1.giver_id,
        pc1.receiver_id,
        pc1.upvotes_given                          AS upvotes_given,
        COALESCE(pc2.upvotes_given, 0)             AS upvotes_returned,  -- B → A
        ROW_NUMBER() OVER (                        -- rank by “received” then “returned”
            ORDER BY pc1.upvotes_given DESC,
                     COALESCE(pc2.upvotes_given,0) DESC
        ) AS rn
    FROM pair_counts pc1
    LEFT JOIN pair_counts pc2
           ON pc2.giver_id    = pc1.receiver_id
          AND pc2.receiver_id = pc1.giver_id
)
SELECT
    g."UserName" AS upvoter_username,      -- the user who gave the most distinct up‑votes
    r."UserName" AS recipient_username,    -- the user who received them
    pb.upvotes_given,                      -- distinct up‑votes received
    pb.upvotes_returned                    -- distinct up‑votes the recipient gave back
FROM pair_bidirectional pb
JOIN META_KAGGLE.META_KAGGLE.USERS g ON g."Id" = pb.giver_id
