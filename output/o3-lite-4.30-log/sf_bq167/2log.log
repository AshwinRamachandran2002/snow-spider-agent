--Description: We need the user‑pair in ForumMessageVotes where one user has given the
--             greatest number of DISTINCT forum‑message up‑votes to another, plus the
--             count sent back.  Approach:
--   1. CTE pair_counts – for every ordered pair (giver → receiver) count DISTINCT
--      "ForumMessageId" (each different message up‑voted) – this is the metric requested.
--   2. CTE pair_bidirectional – self‑join pair_counts in reverse (receiver → giver) so
--      we also know how many votes flowed back; rank all pairs by (forward, reverse).
--   3. Select the single top‑ranked pair (rn = 1).  Attach usernames with LEFT JOIN so
--      the row is preserved even if either account is missing; fall back to the numeric
--      id via CAST when a username is NULL.
WITH pair_counts AS (                 -- A → B totals
    SELECT  "FromUserId"                     AS "giver",
            "ToUserId"                       AS "receiver",
            COUNT(DISTINCT "ForumMessageId") AS "votes_from_to"
    FROM    META_KAGGLE.META_KAGGLE.FORUMMESSAGEVOTES
    GROUP   BY "FromUserId", "ToUserId"
),
pair_bidirectional AS (              -- add B → A totals + rank
    SELECT  pc1."giver",
            pc1."receiver",
            pc1."votes_from_to"              AS "a_to_b",
            COALESCE(pc2."votes_from_to", 0) AS "b_to_a",
            ROW_NUMBER() OVER (
                ORDER BY pc1."votes_from_to" DESC,
                         COALESCE(pc2."votes_from_to", 0) DESC
            ) AS rn
    FROM    pair_counts pc1
    LEFT JOIN pair_counts pc2            -- reverse direction
           ON pc2."giver"    = pc1."receiver"
          AND pc2."receiver" = pc1."giver"
)
SELECT  COALESCE(u_rec."UserName", CAST(pb."receiver" AS STRING)) AS "recipient_username",
        COALESCE(u_giv."UserName", CAST(pb."giver"    AS STRING)) AS "giver_username",
        pb."a_to_b"  AS "distinct_upvotes_received",
        pb."b_to_a"  AS "upvotes_returned"
FROM    pair_bidirectional pb
LEFT JOIN META_KAGGLE.META_KAGGLE.USERS u_rec ON u_rec."Id" = pb."receiver"
LEFT JOIN META_KAGGLE.META_KAGGLE.USERS u_giv ON u_giv."Id" = pb."giver"
WHERE   pb.rn = 1;
