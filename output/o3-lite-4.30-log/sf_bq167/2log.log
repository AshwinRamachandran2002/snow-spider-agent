),
ranked AS (              -- rank by received, then returned
    SELECT *,
           ROW_NUMBER() OVER (ORDER BY upvotes_given DESC,
                                      upvotes_returned DESC) AS rn
    FROM pair_bidirectional
)
SELECT
    giver_username    AS upvoter_username,
