    SELECT
        pc1."giver",
        pc1."receiver",
        pc1."votes_forward",
        COALESCE(pc2."votes_forward", 0) AS "votes_back"
    FROM pair_counts pc1
    LEFT JOIN pair_counts pc2
           ON pc1."giver"    = pc2."receiver"
          AND pc1."receiver" = pc2."giver"
)
SELECT
    ug."UserName" AS "giver",
    ur."UserName" AS "receiver",
    p."votes_forward" AS "votes_forward",
    p."votes_back"    AS "votes_back"
