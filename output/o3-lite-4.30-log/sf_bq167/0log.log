```

```sql
-- 8. Description: Filter to pairs with at least 5 mutual votes in either direction
WITH pair_counts AS (
    SELECT 
           "FromUserId" AS "giver",
           "ToUserId"   AS "receiver",
           COUNT(DISTINCT "ForumMessageId") AS "votes_forward"
    FROM   "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES"
    GROUP  BY "FromUserId","ToUserId"
),
paired AS (
    SELECT 
           pc1.*,
           COALESCE(pc2."votes_forward",0) AS "votes_back"
    FROM   pair_counts pc1
    LEFT   JOIN pair_counts pc2
           ON pc1."giver"    = pc2."receiver"
          AND pc1."receiver" = pc2."giver"
)
SELECT 
       ug."UserName" AS "giver",
       ur."UserName" AS "receiver",
       p."votes_forward",
       p."votes_back"
FROM   paired p
JOIN   "META_KAGGLE"."META_KAGGLE"."USERS" ug ON p."giver" = ug."Id"
JOIN   "META_KAGGLE"."META_KAGGLE"."USERS" ur ON p."receiver" = ur."Id"
WHERE  p."votes_forward" >= 5
   AND p."votes_back"    >= 5
ORDER  BY p."votes_forward" DESC, p."votes_back" DESC
LIMIT 20;
```

```sql
-- 9. Description: Use QUALIFY to directly keep the single best pair (top 1) by our sorting rule
WITH pair_counts AS (
    SELECT 
           "FromUserId" AS "giver",
           "ToUserId"   AS "receiver",
           COUNT(DISTINCT "ForumMessageId") AS "votes_forward"
    FROM   "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES"
    GROUP  BY "FromUserId","ToUserId"
),
paired AS (
    SELECT 
           pc1.*,
           COALESCE(pc2."votes_forward",0) AS "votes_back"
    FROM   pair_counts pc1
    LEFT   JOIN pair_counts pc2
           ON pc1."giver"    = pc2."receiver"
          AND pc1."receiver" = pc2."giver"
)
SELECT 
       ug."UserName" AS "giver_username",
       ur."UserName" AS "receiver_username",
       p."votes_forward" AS "votes_given",
       p."votes_back"    AS "votes_returned"
FROM   paired p
JOIN   "META_KAGGLE"."META_KAGGLE"."USERS" ug ON p."giver" = ug."Id"
JOIN   "META_KAGGLE"."META_KAGGLE"."USERS" ur ON p."receiver" = ur."Id"
QUALIFY ROW_NUMBER() OVER (ORDER BY p."votes_forward" DESC, p."votes_back" DESC) = 1
LIMIT 20;
```

```sql
-- 10. Description: Same logic as #9 but explicitly LIMIT 1 after ordering (alternate style)
WITH pair_counts AS (
    SELECT 
           "FromUserId" AS "giver",
           "ToUserId"   AS "receiver",
           COUNT(DISTINCT "ForumMessageId") AS "votes_forward"
