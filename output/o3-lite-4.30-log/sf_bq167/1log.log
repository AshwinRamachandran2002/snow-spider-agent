/*  Pair with the largest one‑way forum‑message up‑vote count
    together with the number of up‑votes returned in the
    opposite direction, restricted to real users (Id > 0).  */
WITH pair_votes AS (
    SELECT
        "FromUserId"             AS giver_id,
        "ToUserId"               AS receiver_id,
        COUNT(*)                 AS upvotes_given
    FROM  "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES"
    WHERE "FromUserId" > 0       -- exclude the system user (-1)
      AND "ToUserId"   > 0
    GROUP BY "FromUserId", "ToUserId"
), paired AS (
    SELECT
        a.giver_id,
        a.receiver_id,
        a.upvotes_given,                               -- votes giver → receiver
        COALESCE(b.upvotes_given, 0) AS upvotes_returned -- votes receiver → giver
    FROM pair_votes a
    LEFT JOIN pair_votes b
           ON  a.giver_id    = b.receiver_id
           AND a.receiver_id = b.giver_id
)
SELECT
    g."UserName"  AS upvoter_username,
    r."UserName"  AS recipient_username,
    p.upvotes_given     AS upvotes_given,
    p.upvotes_returned  AS upvotes_returned
FROM paired p
JOIN "META_KAGGLE"."META_KAGGLE"."USERS" g
  ON p.giver_id    = g."Id"
JOIN "META_KAGGLE"."META_KAGGLE"."USERS" r
  ON p.receiver_id = r."Id"
ORDER BY
    p.upvotes_given     DESC NULLS LAST,
    p.upvotes_returned  DESC NULLS LAST
LIMIT 1;
```
