```sql
-- 7) Build a full derived table of amenity counts per boundary (trim to 20)
SELECT pf."osm_id",
       COUNT(n."id") AS "amenity_cnt"
FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
       LATERAL FLATTEN( INPUT => pf."all_tags") pf_tag
LEFT JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_NODES" n
       ON ST_CONTAINS( TO_GEOGRAPHY(pf."geometry"),
                       ST_MAKEPOINT(n."longitude", n."latitude") )
LEFT JOIN LATERAL FLATTEN( INPUT => n."all_tags") n_tag
       ON TRUE
WHERE  pf."feature_type" = 'multipolygons'
  AND  pf_tag.value:"key"::STRING = 'boundary'
  AND  pf_tag.value:"value"::STRING = 'administrative'
  AND  n_tag.value:"key"::STRING = 'amenity'
GROUP  BY pf."osm_id"
LIMIT 20;
```

```sql
-- 8) Compute the median amenity‑POI count across ALL admin boundaries
WITH amenity_counts AS (
    SELECT pf."osm_id",
           COUNT(n."id") AS "amenity_cnt"
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
           LATERAL FLATTEN( INPUT => pf."all_tags") pf_tag
    LEFT JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_NODES" n
           ON ST_CONTAINS( TO_GEOGRAPHY(pf."geometry"),
                           ST_MAKEPOINT(n."longitude", n."latitude") )
    LEFT JOIN LATERAL FLATTEN( INPUT => n."all_tags") n_tag
           ON TRUE
    WHERE  pf."feature_type" = 'multipolygons'
      AND  pf_tag.value:"key"::STRING = 'boundary'
      AND  pf_tag.value:"value"::STRING = 'administrative'
      AND  n_tag.value:"key"::STRING = 'amenity'
    GROUP  BY pf."osm_id"
)
SELECT MEDIAN("amenity_cnt") AS "median_amenity_cnt"
FROM   amenity_counts;
```

```sql
-- 9) Show each boundary’s count plus its distance from the median (20 rows)
WITH amenity_counts AS (
    SELECT pf."osm_id",
           COUNT(n."id") AS "amenity_cnt"
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
           LATERAL FLATTEN( INPUT => pf."all_tags") pf_tag
    LEFT JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_NODES" n
           ON ST_CONTAINS( TO_GEOGRAPHY(pf."geometry"),
                           ST_MAKEPOINT(n."longitude", n."latitude") )
    LEFT JOIN LATERAL FLATTEN( INPUT => n."all_tags") n_tag
           ON TRUE
    WHERE  pf."feature_type" = 'multipolygons'
      AND  pf_tag.value:"key"::STRING = 'boundary'
      AND  pf_tag.value:"value"::STRING = 'administrative'
      AND  n_tag.value:"key"::STRING = 'amenity'
    GROUP  BY pf."osm_id"
),
med AS ( SELECT MEDIAN("amenity_cnt") AS "med" FROM amenity_counts )
SELECT a."osm_id",
       a."amenity_cnt",
       ABS(a."amenity_cnt" - m."med") AS "dist_from_median"
FROM   amenity_counts a, med m
ORDER  BY "dist_from_median"
LIMIT 20;
```

