           ON ST_CONTAINS(ab.geom, an.geom)
    GROUP  BY ab."osm_id"
),
med AS (
    SELECT MEDIAN(amenity_cnt) AS med
    FROM   amenity_counts
)
SELECT ac."osm_id"
FROM   amenity_counts ac, med m
ORDER  BY ABS(ac.amenity_cnt - m.med)
LIMIT 1
