```sql
--Description: Find the administrative boundary (multipolygon) whose count of ‘amenity’‑tagged
--nodes is closest to the median among all such boundaries.
--Steps inside CTEs:
-- 1. admin_boundaries:  filter PLANET_FEATURES → multipolygons tagged boundary=administrative;
--    convert each geometry once to GEOGRAPHY for spatial ops.
-- 2. amenity_nodes:  filter PLANET_NODES to those whose flattened tags include key = 'amenity';
--    turn lat/lon into GEOGRAPHY points.
-- 3. amenity_counts:  spatial join − count how many amenity nodes fall inside each boundary.
-- 4. median_val:      compute the median of those counts.
--Final SELECT: order boundaries by absolute distance to the median, return the single closest ID.

WITH admin_boundaries AS (
    SELECT pf."osm_id",
           TO_GEOGRAPHY(pf."geometry") AS geom
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
           LATERAL FLATTEN(INPUT => pf."all_tags") pf_tag
    WHERE  pf."feature_type" = 'multipolygons'
      AND  pf_tag.value:"key"::STRING  = 'boundary'
      AND  pf_tag.value:"value"::STRING = 'administrative'
),
amenity_nodes AS (
    SELECT n."id",
           ST_MAKEPOINT(n."longitude", n."latitude")::GEOGRAPHY AS geom
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_NODES" n,
           LATERAL FLATTEN(INPUT => n."all_tags") n_tag
    WHERE  n_tag.value:"key"::STRING = 'amenity'
),
amenity_counts AS (
    SELECT ab."osm_id",
           COUNT(an."id") AS amenity_cnt
    FROM   admin_boundaries ab
    LEFT JOIN amenity_nodes an
           ON ST_CONTAINS(ab.geom, an.geom)
    GROUP BY ab."osm_id"
),
median_val AS (
    SELECT MEDIAN(amenity_cnt) AS med_cnt
    FROM   amenity_counts
)
SELECT ac."osm_id"
FROM   amenity_counts ac, median_val mv
ORDER BY ABS(ac.amenity_cnt - mv.med_cnt)
LIMIT 1;
```
