--Description: Determine which administrative boundary (multipolygon) has an
--amenity‑POI total closest to the overall median among all such boundaries.
--CTE flow
-- 1) admin_boundaries  – pull every PLANET_FEATURES multipolygon whose tags include
--    boundary=administrative; convert once from WKB to GEOGRAPHY.
-- 2) amenity_nodes     – keep only PLANET_NODES whose flattened tags contain key
--    'amenity'; build GEOGRAPHY point via ST_MAKEPOINT after casting lon/lat to DOUBLE.
-- 3) amenity_counts    – spatially join the two sets, counting how many amenity
--    nodes fall inside each boundary.
-- 4) median_val        – compute the median of those counts.
--Final SELECT          – return the osm_id whose count is nearest to that median.

WITH admin_boundaries AS (
    SELECT pf."osm_id",
           TO_GEOGRAPHY(pf."geometry") AS geom
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
           LATERAL FLATTEN(INPUT => pf."all_tags") pf_tag
    WHERE  pf."feature_type" = 'multipolygons'
      AND  pf_tag.value:"key"::STRING  = 'boundary'
      AND  pf_tag.value:"value"::STRING = 'administrative'
),
amenity_nodes AS (
    SELECT n."id",
           ST_MAKEPOINT(
               TO_DOUBLE(n."longitude"),
               TO_DOUBLE(n."latitude")
           ) AS geom
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_NODES" n,
           LATERAL FLATTEN(INPUT => n."all_tags") n_tag
    WHERE  n_tag.value:"key"::STRING = 'amenity'
),
amenity_counts AS (
    SELECT ab."osm_id",
           COUNT(an."id") AS amenity_cnt
    FROM   admin_boundaries ab
    LEFT   JOIN amenity_nodes an
           ON ST_CONTAINS(ab.geom, an.geom)
    GROUP  BY ab."osm_id"
