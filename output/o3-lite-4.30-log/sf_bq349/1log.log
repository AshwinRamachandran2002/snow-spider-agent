--Description: (9) Show each boundary’s amenity count plus its absolute distance
--from the global median (first 20 rows).  Corrected ST_MAKEPOINT usage resolves
--previous GEOGRAPHY casting error.

WITH amenity_counts AS (
    SELECT pf."osm_id",
           COUNT(n."id") AS "amenity_cnt"
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
           LATERAL FLATTEN(INPUT => pf."all_tags") pf_tag
    LEFT  JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_NODES" n
           ON ST_CONTAINS(
                  TO_GEOGRAPHY(pf."geometry"),
                  ST_MAKEPOINT(
                      TO_DOUBLE(n."longitude"),
                      TO_DOUBLE(n."latitude")
                  )
              )
    LEFT  JOIN LATERAL FLATTEN(INPUT => n."all_tags") n_tag
           ON TRUE
    WHERE  pf."feature_type" = 'multipolygons'
      AND  pf_tag.value:"key"::STRING  = 'boundary'
      AND  pf_tag.value:"value"::STRING = 'administrative'
      AND  n_tag.value:"key"::STRING   = 'amenity'
    GROUP BY pf."osm_id"
),
med AS (
    SELECT MEDIAN("amenity_cnt") AS "med"
    FROM   amenity_counts
)
SELECT a."osm_id",
       a."amenity_cnt",
       ABS(a."amenity_cnt" - m."med") AS "dist_from_median"
FROM   amenity_counts a, med m
ORDER  BY "dist_from_median"
LIMIT 20;
