Query:
--Description: (8) Compute the median number of amenity‑tagged POIs inside all
--administrative multipolygon boundaries.  Uses two CTEs so each FLATTEN call is
--directly after its source table, avoiding the lateral‑view join error.

WITH admin_boundaries AS (                    -- all admin multipolygons
    SELECT pf."osm_id",
           TO_GEOGRAPHY(pf."geometry") AS geom
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf
    CROSS  JOIN LATERAL FLATTEN(INPUT => pf."all_tags") pf_tag
    WHERE  pf."feature_type" = 'multipolygons'
      AND  pf_tag.value:"key"::STRING   = 'boundary'
      AND  pf_tag.value:"value"::STRING = 'administrative'
),
amenity_nodes AS (                            -- every amenity‑tagged node
    SELECT n."id",
           ST_MAKEPOINT(
               TO_DOUBLE(n."longitude"),
               TO_DOUBLE(n."latitude")
           ) AS geom
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_NODES" n
    CROSS  JOIN LATERAL FLATTEN(INPUT => n."all_tags") n_tag
    WHERE  n_tag.value:"key"::STRING = 'amenity'
),
amenity_counts AS (                            -- count POIs per boundary
    SELECT ab."osm_id",
           COUNT(an."id") AS amenity_cnt
    FROM   admin_boundaries ab
    LEFT   JOIN amenity_nodes an
           ON ST_CONTAINS(ab.geom, an.geom)
    GROUP  BY ab."osm_id"
)
SELECT MEDIAN(amenity_cnt) AS "median_amenity_cnt"
FROM   amenity_counts
