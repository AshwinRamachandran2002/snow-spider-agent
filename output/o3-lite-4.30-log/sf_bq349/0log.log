/* ----------------------------------------------------------------------
   Goal: return the OpenStreetMap ID of an administrative boundary
         (multipolygon) whose number of amenity‑tagged POIs is closest
         to the median among all such boundaries.

   Thinking process encoded as comments inside one statement:

   1) admin_bounds  – collect every feature that is a multipolygon with
      boundary = administrative, casting its WKB to GEOGRAPHY.

   2) amen_nodes    – turn each node that contains an “amenity” tag into
      a GEOGRAPHY point (use stored geometry when present, otherwise
      build from lon/lat).

   3) amen_ct       – for every boundary, count amenity points that fall
      inside it via ST_CONTAINS.

   4) median_val    – compute the median of those counts.

   5) ranked        – compute absolute difference from the median and
      rank boundaries by that difference (then by id to break ties).

   6) final select  – output the single boundary_id with rank = 1.
------------------------------------------------------------------------ */
WITH admin_bounds AS (
    SELECT
        COALESCE(pf."osm_id", pf."osm_way_id") AS boundary_id,
        TO_GEOGRAPHY(pf."geometry")            AS boundary_geo
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
         LATERAL FLATTEN(INPUT => pf."all_tags") tag
    WHERE pf."feature_type"          = 'multipolygons'
      AND tag.value:"key"::STRING    = 'boundary'
      AND tag.value:"value"::STRING  = 'administrative'
),
amen_nodes AS (
    SELECT
        COALESCE(
            TO_GEOGRAPHY(pn."geometry"),
            ST_MAKEPOINT(pn."longitude"::DOUBLE, pn."latitude"::DOUBLE)
        ) AS node_geo
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_NODES" pn,
         LATERAL FLATTEN(INPUT => pn."all_tags") tag
    WHERE tag.value:"key"::STRING = 'amenity'
),
amen_ct AS (
    SELECT
        ab.boundary_id,
        COUNT(an.node_geo) AS amenity_cnt
    FROM admin_bounds ab
    LEFT JOIN amen_nodes an
      ON ST_CONTAINS(ab.boundary_geo, an.node_geo)
    GROUP BY ab.boundary_id
),
median_val AS (
    SELECT MEDIAN(amenity_cnt) AS med_cnt FROM amen_ct
),
ranked AS (
    SELECT
        ac.boundary_id,
        ac.amenity_cnt,
        ABS(ac.amenity_cnt - mv.med_cnt) AS diff_from_median,
        ROW_NUMBER() OVER (ORDER BY ABS(ac.amenity_cnt - mv.med_cnt), ac.boundary_id) AS rn
    FROM amen_ct ac, median_val mv
)
SELECT boundary_id
FROM ranked
WHERE rn = 1
LIMIT 1;
