    WHERE tag.value:"key"::STRING = 'amenity'
),
amen_ct AS (
    SELECT
        ab.boundary_id,
        COUNT(an."id") AS amenity_cnt
    FROM admin_bounds ab
    LEFT JOIN amen_nodes an
      ON ST_CONTAINS(ab.bnd_geo, an.node_geo)
    GROUP BY ab.boundary_id
),
median_val AS (
    SELECT MEDIAN(amenity_cnt) AS med_cnt FROM amen_ct
),
ranked AS (
    SELECT
        ac.boundary_id,
        ac.amenity_cnt,
        ABS(ac.amenity_cnt - mv.med_cnt) AS diff_from_median,
        ROW_NUMBER() OVER (ORDER BY ABS(ac.amenity_cnt - mv.med_cnt), ac.boundary_id) AS rn
    FROM amen_ct ac, median_val mv
)
SELECT boundary_id
FROM ranked
WHERE rn = 1
LIMIT 1
