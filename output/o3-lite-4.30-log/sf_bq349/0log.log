    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_NODES" pn,
         LATERAL FLATTEN(INPUT => pn."all_tags") tag
    WHERE tag.value:"key"::STRING = 'amenity'
),
amen_ct AS (
    SELECT
        ab.boundary_id,
        COUNT(an."id") AS amenity_cnt
    FROM admin_bounds ab
    LEFT JOIN amen_nodes an
      ON ST_CONTAINS(ab.bnd_geo, an.node_geo)
    GROUP BY ab.boundary_id
),
m AS (SELECT MEDIAN(amenity_cnt) AS median_cnt FROM amen_ct)
SELECT
    ac.boundary_id,
    ac.amenity_cnt,
    ABS(ac.amenity_cnt - m.median_cnt) AS diff_from_median
FROM amen_ct ac, m
LIMIT 20;
