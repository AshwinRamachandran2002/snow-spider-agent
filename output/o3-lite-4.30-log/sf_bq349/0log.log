```sql
-- 5. Single‑boundary test: how many amenity nodes fall inside one boundary
WITH one_boundary AS (
  SELECT 
    pf."osm_id",
    TO_GEOGRAPHY(pf."geometry") AS bnd_geo
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
       LATERAL FLATTEN( INPUT => pf."all_tags") f
  WHERE pf."feature_type" = 'multipolygons'
    AND f.value:"key"::STRING = 'boundary'
    AND f.value:"value"::STRING = 'administrative'
  LIMIT 1            -- pick one boundary for demo
)
SELECT 
  ob."osm_id"          AS boundary_id,
  COUNT(*)             AS amenity_cnt
FROM one_boundary ob
JOIN (
    SELECT 
      pn."id",
      COALESCE(
         TO_GEOGRAPHY(pn."geometry"),
         ST_MAKEPOINT(pn."longitude"::DOUBLE, pn."latitude"::DOUBLE)
      ) AS node_geo
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_NODES" pn,
         LATERAL FLATTEN( INPUT => pn."all_tags") t
    WHERE t.value:"key"::STRING = 'amenity'
) amen
  ON ST_CONTAINS(ob.bnd_geo , amen.node_geo)
LIMIT 20;
```

```sql
-- 6. Count amenity‑tagged POIs for every administrative boundary (limited sample)
WITH admin_bounds AS (
  SELECT 
    COALESCE(pf."osm_id", pf."osm_way_id") AS boundary_id,
    TO_GEOGRAPHY(pf."geometry")            AS bnd_geo
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
       LATERAL FLATTEN( INPUT => pf."all_tags") f
  WHERE pf."feature_type" = 'multipolygons'
    AND f.value:"key"::STRING = 'boundary'
    AND f.value:"value"::STRING = 'administrative'
  LIMIT 200      -- sample for speed
),
amen_nodes AS (
  SELECT 
    pn."id",
    COALESCE(
       TO_GEOGRAPHY(pn."geometry"),
       ST_MAKEPOINT(pn."longitude"::DOUBLE, pn."latitude"::DOUBLE)
    ) AS node_geo
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_NODES" pn,
       LATERAL FLATTEN( INPUT => pn."all_tags") t
  WHERE t.value:"key"::STRING = 'amenity'
)
SELECT 
  ab.boundary_id,
  COUNT(amen.id) AS amenity_cnt
FROM admin_bounds ab
LEFT JOIN amen_nodes amen
  ON ST_CONTAINS(ab.bnd_geo , amen.node_geo)
GROUP BY ab.boundary_id
LIMIT 20;
```

```sql
-- 7. Derive the median of those amenity counts
WITH amen_ct AS (
  SELECT 
    COALESCE(pf."osm_id", pf."osm_way_id") AS boundary_id,
    COUNT(*) AS amenity_cnt
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES"   pf,
       LATERAL FLATTEN( INPUT => pf."all_tags") f,
       LATERAL (
         SELECT pn.*
         FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_NODES" pn,
              LATERAL FLATTEN( INPUT => pn."all_tags") t
         WHERE t.value:"key"::STRING = 'amenity'
           AND ST_CONTAINS( TO_GEOGRAPHY(pf."geometry"),
                             COALESCE( TO_GEOGRAPHY(pn."geometry"),
                                       ST_MAKEPOINT(pn."longitude"::DOUBLE, pn."latitude"::DOUBLE)))
       ) node_match
  WHERE pf."feature_type" = 'multipolygons'
    AND f.value:"key"::STRING = 'boundary'
    AND f.value:"value"::STRING = 'administrative'
  GROUP BY boundary_id
)
SELECT MEDIAN(amenity_cnt) AS median_cnt
FROM amen_ct
LIMIT 20;
```

```sql
-- 8. Compute each boundary’s deviation from the median
WITH amen_ct AS (
  SELECT 
    COALESCE(pf."osm_id", pf."osm_way_id") AS boundary_id,
    COUNT(*) AS amenity_cnt
  FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES"   pf,
       LATERAL FLATTEN( INPUT => pf."all_tags") f,
       LATERAL (
         SELECT pn.*
         FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_NODES" pn,
              LATERAL FLATTEN( INPUT => pn."all_tags") t
         WHERE t.value:"key"::STRING = 'amenity'
           AND ST_CONTAINS( TO_GEOGRAPHY(pf."geometry"),
                             COALESCE( TO_GEOGRAPHY(pn."geometry"),
                                       ST_MAKEPOINT(pn."longitude"::DOUBLE, pn."latitude"::DOUBLE)))
       ) node_match
  WHERE pf."feature_type" = 'multipolygons'
    AND f.value:"key"::STRING = 'boundary'
    AND f.value:"value"::STRING = 'administrative'
  GROUP BY boundary_id
),
m AS ( SELECT MEDIAN(amenity_cnt) AS median_cnt FROM amen_ct )
SELECT 
  a.boundary_id,
  a.amenity_cnt,
  ABS(a.amenity_cnt - m.median_cnt) AS diff_from_median
FROM amen_ct a, m
LIMIT 20;
```

```sql
-- 9. Order boundaries by closeness to the median
WITH amen_ct AS ( /* same CTE as previous */ ),
m AS ( SELECT MEDIAN(amenity_cnt) AS median_cnt FROM amen_ct )
SELECT 
  a.boundary_id,
  a.amenity_cnt,
  ABS(a.amenity_cnt - m.median_cnt) AS diff_from_median
FROM amen_ct a, m
ORDER BY diff_from_median ASC, a.boundary_id
LIMIT 20;
```

```sql
-- 10. Boundary (OpenStreetMap ID) whose amenity count is closest to the median
WITH amen_ct AS ( /* same CTE build as before */ ),
m AS ( SELECT MEDIAN(amenity_cnt) AS median_cnt FROM amen_ct ),
ranked AS (
  SELECT 
    a.boundary_id,
    a.amenity_cnt,
    ABS(a.amenity_cnt - m.median_cnt) AS diff_from_median,
    ROW_NUMBER() OVER (ORDER BY ABS(a.amenity_cnt - m.median_cnt)) AS rn
  FROM amen_ct a, m
)
SELECT boundary_id
FROM ranked
WHERE rn = 1
LIMIT 20;
```

Each query builds on the previous ones, moving from simple inspection (Queries 1–4) through spatial joins and aggregation (Queries 5–8) to finally isolate the administrative boundary whose amenity‑POI total is nearest to the overall median (Queries 9–10).
