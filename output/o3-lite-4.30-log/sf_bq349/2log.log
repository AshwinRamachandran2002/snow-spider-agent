```sql
-- 7.  Example spatial join: one boundary with up to 20 amenity nodes inside it
WITH one_boundary AS (
  SELECT pf."osm_way_id",
         TO_GEOGRAPHY(pf."geometry") AS "b_geom"
  FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
         LATERAL FLATTEN(input => pf."all_tags") tag
  WHERE  pf."feature_type" = 'multipolygons'
    AND  tag.value:"key"  = 'boundary'
    AND  tag.value:"value" = 'administrative'
  LIMIT 1
)
SELECT ob."osm_way_id" AS "boundary_id",
       pn."id"         AS "amenity_node_id"
FROM   one_boundary ob,
       GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_NODES pn,
       LATERAL FLATTEN(input => pn."all_tags") tag
WHERE  tag.value:"key" = 'amenity'
  AND  ST_CONTAINS( ob."b_geom",
        COALESCE(TO_GEOGRAPHY(pn."geometry"),
                 ST_MAKEPOINT(pn."longitude", pn."latitude")) )
LIMIT 20;
```

```sql
-- 8.  Count amenity nodes inside each administrative multipolygon (sample 20)
WITH boundaries AS (
  SELECT pf."osm_way_id"        AS "boundary_id",
         TO_GEOGRAPHY(pf."geometry") AS "b_geom"
  FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
         LATERAL FLATTEN(input => pf."all_tags") tag
  WHERE  pf."feature_type" = 'multipolygons'
    AND  tag.value:"key"  = 'boundary'
    AND  tag.value:"value" = 'administrative'
),
amenity_nodes AS (
  SELECT pn."id" AS "node_id",
         COALESCE(TO_GEOGRAPHY(pn."geometry"),
                  ST_MAKEPOINT(pn."longitude", pn."latitude")) AS "n_geom"
  FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_NODES pn,
         LATERAL FLATTEN(input => pn."all_tags") tag
  WHERE  tag.value:"key" = 'amenity'
)
SELECT b."boundary_id",
       COUNT(*) AS "poi_cnt"
FROM   boundaries b
JOIN   amenity_nodes n
  ON   ST_CONTAINS(b."b_geom", n."n_geom")
GROUP  BY b."boundary_id"
LIMIT 20;
```

```sql
-- 9.  Compute median of the POI counts across all boundaries
WITH boundary_counts AS (
  SELECT b."boundary_id",
         COUNT(*) AS "poi_cnt"
  FROM (
        SELECT pf."osm_way_id" AS "boundary_id",
               TO_GEOGRAPHY(pf."geometry") AS "b_geom"
        FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
               LATERAL FLATTEN(input => pf."all_tags") tag
        WHERE  pf."feature_type" = 'multipolygons'
          AND  tag.value:"key"  = 'boundary'
          AND  tag.value:"value" = 'administrative'
       ) b
  JOIN (
        SELECT pn."id",
               COALESCE(TO_GEOGRAPHY(pn."geometry"),
                        ST_MAKEPOINT(pn."longitude", pn."latitude")) AS "n_geom"
        FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_NODES pn,
               LATERAL FLATTEN(input => pn."all_tags") tag
        WHERE  tag.value:"key" = 'amenity'
       ) n
  ON ST_CONTAINS(b."b_geom", n."n_geom")
  GROUP BY b."boundary_id"
)
SELECT MEDIAN("poi_cnt") AS "median_poi_cnt"
FROM   boundary_counts;
```

```sql
-- 10.  Retrieve the boundary whose POI count is closest to the median
WITH boundary_counts AS (
  SELECT b."boundary_id",
         COUNT(*) AS "poi_cnt"
  FROM (
        SELECT pf."osm_way_id" AS "boundary_id",
               TO_GEOGRAPHY(pf."geometry") AS "b_geom"
        FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
               LATERAL FLATTEN(input => pf."all_tags") tag
        WHERE  pf."feature_type" = 'multipolygons'
          AND  tag.value:"key"  = 'boundary'
          AND  tag.value:"value" = 'administrative'
       ) b
  JOIN (
        SELECT pn."id",
               COALESCE(TO_GEOGRAPHY(pn."geometry"),
                        ST_MAKEPOINT(pn."longitude", pn."latitude")) AS "n_geom"
        FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_NODES pn,
               LATERAL FLATTEN(input => pn."all_tags") tag
        WHERE  tag.value:"key" = 'amenity'
       ) n
  ON ST_CONTAINS(b."b_geom", n."n_geom")
  GROUP BY b."boundary_id"
),
stats AS (
  SELECT MEDIAN("poi_cnt") AS "median_val" FROM boundary_counts
)
SELECT bc."boundary_id"        AS "osm_way_id",
       bc."poi_cnt",
       ABS(bc."poi_cnt" - s."median_val") AS "abs_diff_from_median"
FROM   boundary_counts bc
CROSS  JOIN stats s
ORDER  BY "abs_diff_from_median"
LIMIT 20;
```
