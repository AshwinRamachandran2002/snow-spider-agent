    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_NODES pn,
           LATERAL FLATTEN(input => pn."all_tags") tag
    WHERE  tag.value:"key" = 'amenity'
      AND  (pn."geometry" IS NOT NULL
            OR (pn."longitude" IS NOT NULL AND pn."latitude" IS NOT NULL))
),
boundary_counts AS (
    SELECT b."boundary_id",
           COUNT(*) AS "poi_cnt"
    FROM   boundaries b
    JOIN   amenity_nodes n
      ON   n."n_geom" IS NOT NULL
     AND  ST_CONTAINS(b."b_geom", n."n_geom")
    GROUP  BY b."boundary_id"
)
SELECT MEDIAN("poi_cnt") AS "median_poi_cnt"
FROM   boundary_counts;
```

