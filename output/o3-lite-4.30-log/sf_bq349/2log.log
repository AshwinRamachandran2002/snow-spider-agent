--Description: Retrieve the administrative multipolygons whose amenity‑POI
--counts are closest to the median (top 20).  Uses APPROX_PERCENTILE for a fast
--median calculation; NULL geometries are filtered out.
WITH boundaries AS (
    SELECT pf."osm_way_id"                     AS "boundary_id",
           TO_GEOGRAPHY(pf."geometry")         AS "b_geom"
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
           LATERAL FLATTEN(input => pf."all_tags") tag
    WHERE  pf."feature_type" = 'multipolygons'
      AND  tag.value:"key"  = 'boundary'
      AND  tag.value:"value" = 'administrative'
      AND  pf."geometry" IS NOT NULL
),
amenity_nodes AS (
    SELECT pn."id",
           COALESCE( TO_GEOGRAPHY(pn."geometry"),
                     ST_MAKEPOINT(pn."longitude", pn."latitude") ) AS "n_geom"
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_NODES pn,
           LATERAL FLATTEN(input => pn."all_tags") tag
    WHERE  tag.value:"key" = 'amenity'
      AND  (pn."geometry" IS NOT NULL
            OR (pn."longitude" IS NOT NULL AND pn."latitude" IS NOT NULL))
),
boundary_counts AS (
    SELECT b."boundary_id",
           COUNT(*) AS "poi_cnt"
    FROM   boundaries b
    JOIN   amenity_nodes n
      ON   n."n_geom" IS NOT NULL
     AND  ST_CONTAINS(b."b_geom", n."n_geom")
    GROUP  BY b."boundary_id"
),
stats AS (
    SELECT APPROX_PERCENTILE("poi_cnt", 0.5) AS "median_val"
    FROM   boundary_counts
)
SELECT bc."boundary_id"                    AS "osm_way_id",
       bc."poi_cnt",
       ABS(bc."poi_cnt" - s."median_val")  AS "diff_from_median"
FROM   boundary_counts bc
CROSS  JOIN stats s
ORDER  BY "diff_from_median" ASC
LIMIT 20;
