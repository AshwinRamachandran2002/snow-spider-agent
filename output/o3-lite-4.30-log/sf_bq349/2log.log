--Description:  Count how many amenity‑tagged nodes fall inside each
--administrative multipolygon boundary, then pick the boundaries whose counts
--are closest to the (approximate) median of those counts.  APPROX_PERCENTILE is
--used for a fast median; geometry is taken from WKB when present, otherwise a
--point is built from longitude/latitude.  Finally we show the 20 closest
--boundaries (osm_way_id plus their POI count and distance to the median).
WITH boundaries AS (                                                    -- all admin boundaries
    SELECT pf."osm_way_id"                    AS "boundary_id",
           TO_GEOGRAPHY(pf."geometry")        AS "b_geom"
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
           LATERAL FLATTEN(input => pf."all_tags") t
    WHERE  pf."feature_type" = 'multipolygons'
      AND  t.value:"key"  = 'boundary'
      AND  t.value:"value" = 'administrative'
      AND  pf."geometry" IS NOT NULL
),
amenity_nodes AS (                                                       -- all amenity POIs
    SELECT pn."id"                           AS "node_id",
           COALESCE( TO_GEOGRAPHY(pn."geometry"),
                     ST_MAKEPOINT(pn."longitude", pn."latitude") ) AS "n_geom"
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_NODES pn,
           LATERAL FLATTEN(input => pn."all_tags") t
    WHERE  t.value:"key" = 'amenity'
),
boundary_counts AS (                                                     -- POI count per boundary
    SELECT b."boundary_id",
           COUNT(*) AS "poi_cnt"
    FROM   boundaries b
    JOIN   amenity_nodes n
      ON   ST_CONTAINS(b."b_geom", n."n_geom")
    GROUP  BY b."boundary_id"
),
stats AS (                                                               -- approximate median
    SELECT APPROX_PERCENTILE("poi_cnt", 0.5) AS "median_val"
    FROM   boundary_counts
)
SELECT bc."boundary_id"              AS "osm_way_id",
       bc."poi_cnt",
       ABS(bc."poi_cnt" - s."median_val") AS "diff_from_median"
FROM   boundary_counts bc
CROSS  JOIN stats s
ORDER  BY "diff_from_median" ASC
LIMIT 20;
