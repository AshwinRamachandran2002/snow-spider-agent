-- 10. Final answer: last names and quintile, ordered from First → Fifth
WITH best AS (
    SELECT ss."StudentID", MAX(ss."Grade") AS "Best_Grade"
    FROM "Student_Schedules" AS ss
    JOIN (
        SELECT c."ClassID"
        FROM "Classes" AS c
        JOIN "Subjects" AS s
          ON c."SubjectID" = s."SubjectID"
        WHERE s."CategoryID" = 'ENG'
    ) AS eng_classes
      ON ss."ClassID" = eng_classes."ClassID"
    WHERE ss."ClassStatus" = 2
    GROUP BY ss."StudentID"
),
ranked AS (
    SELECT b."StudentID",
           (SELECT COUNT(*) FROM best b2
             WHERE b2."Best_Grade" >= b."Best_Grade") AS "Rank_Pos"
    FROM best AS b
), totals AS (SELECT COUNT(*) AS "Total" FROM best),
quintile AS (
    SELECT r."StudentID",
           CASE
               WHEN 1.0 * r."Rank_Pos" / t."Total" <= 0.20 THEN 'First'
               WHEN 1.0 * r."Rank_Pos" / t."Total" <= 0.40 THEN 'Second'
               WHEN 1.0 * r."Rank_Pos" / t."Total" <= 0.60 THEN 'Third'
               WHEN 1.0 * r."Rank_Pos" / t."Total" <= 0.80 THEN 'Fourth'
               ELSE 'Fifth'
           END AS "Quintile"
    FROM ranked AS r, totals AS t
)
SELECT s."StudLastName" AS "LastName",
       q."Quintile"
FROM quintile AS q
JOIN "Students" AS s
  ON s."StudentID" = q."StudentID"
ORDER BY CASE q."Quintile"
           WHEN 'First'  THEN 1
           WHEN 'Second' THEN 2
           WHEN 'Third'  THEN 3
           WHEN 'Fourth' THEN 4
           WHEN 'Fifth'  THEN 5
         END
LIMIT 20;
