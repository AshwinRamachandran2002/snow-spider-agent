2025-05-01 03:26:13 - Thread-1378 (execute) - INFO - [Exploration]
Relevant tables / columns and how they will be used  

• Student_Schedules  
  – StudentID : join to Students to get the last‑name  
  – ClassID    : link to Classes so we know which subject the class belongs to  
  – ClassStatus : keep only rows = 2 (Completed)  
  – Grade     : numeric value on which we will rank / create quintiles  

• Classes  
  – ClassID    : join key coming from Student_Schedules  
  – SubjectID : points to the actual discipline of the course  

• Subjects  
  – SubjectID    : join key coming from Classes  
  – CategoryID  : we need English courses only → value = 'ENG'  

• Students  
  – StudentID    : join key coming from Student_Schedules  
  – StudLastName : the item we have to return  

Filtering conditions that will be applied  
1. Student_Schedules.ClassStatus = 2  (Completed)  
2. Subjects.CategoryID = 'ENG'    (English courses only)  

Below are 10 exploratory → progressive SQL queries (LIMIT 20 each) that walk from the simplest look‑ups to the final answer.  
All table/column names with capitals are wrapped in double‑quotes to stay SQLite‑safe.

```sql
-- 1. Distinct subject categories – verify the code for English is available
SELECT DISTINCT "CategoryID"
FROM "Subjects"
LIMIT 20;
```

```sql
-- 2. Show a few English subjects (where CategoryID = 'ENG')
SELECT "SubjectID", "CategoryID", "SubjectCode", "SubjectName"
FROM "Subjects"
WHERE "CategoryID" = 'ENG'
LIMIT 20;
```

```sql
-- 3. Retrieve ClassIDs that belong to English subjects
SELECT c."ClassID", c."SubjectID"
FROM "Classes" AS c
JOIN "Subjects" AS s
  ON c."SubjectID" = s."SubjectID"
WHERE s."CategoryID" = 'ENG'
LIMIT 20;
```

```sql
-- 4. Student schedule rows that are completed English classes
SELECT ss."StudentID", ss."ClassID", ss."Grade"
FROM "Student_Schedules" AS ss
JOIN (
    SELECT c."ClassID"
    FROM "Classes" AS c
    JOIN "Subjects" AS s
      ON c."SubjectID" = s."SubjectID"
    WHERE s."CategoryID" = 'ENG'
) AS eng_classes
  ON ss."ClassID" = eng_classes."ClassID"
WHERE ss."ClassStatus" = 2
LIMIT 20;
```

```sql
-- 5. Count of unique students who have completed at least one English course
SELECT COUNT(DISTINCT ss."StudentID") AS "English_Students_Count"
FROM "Student_Schedules" AS ss
JOIN (
    SELECT c."ClassID"
    FROM "Classes" AS c
    JOIN "Subjects" AS s
      ON c."SubjectID" = s."SubjectID"
    WHERE s."CategoryID" = 'ENG'
) AS eng_classes
  ON ss."ClassID" = eng_classes."ClassID"
WHERE ss."ClassStatus" = 2;
```

```sql
-- 6. Each student’s best (highest) grade among completed English classes
SELECT ss."StudentID",
       MAX(ss."Grade") AS "Best_English_Grade"
FROM "Student_Schedules" AS ss
JOIN (
    SELECT c."ClassID"
    FROM "Classes" AS c
    JOIN "Subjects" AS s
      ON c."SubjectID" = s."SubjectID"
    WHERE s."CategoryID" = 'ENG'
) AS eng_classes
  ON ss."ClassID" = eng_classes."ClassID"
WHERE ss."ClassStatus" = 2
GROUP BY ss."StudentID"
LIMIT 20;
```

```sql
-- 7. Rank each student by number of students having a grade ≥ theirs
WITH best AS (
    SELECT ss."StudentID",
           MAX(ss."Grade") AS "Best_Grade"
    FROM "Student_Schedules" AS ss
    JOIN (
        SELECT c."ClassID"
        FROM "Classes" AS c
        JOIN "Subjects" AS s
          ON c."SubjectID" = s."SubjectID"
        WHERE s."CategoryID" = 'ENG'
    ) AS eng_classes
      ON ss."ClassID" = eng_classes."ClassID"
    WHERE ss."ClassStatus" = 2
    GROUP BY ss."StudentID"
), totals AS (SELECT COUNT(*) AS "Total" FROM best)
SELECT b."StudentID",
       b."Best_Grade",
       (SELECT COUNT(*) FROM best b2
         WHERE b2."Best_Grade" >= b."Best_Grade") AS "Rank_Pos",
       t."Total"
FROM best AS b, totals AS t
LIMIT 20;
```

```sql
-- 8. Convert that rank position into a percentile
WITH best AS (
    SELECT ss."StudentID", MAX(ss."Grade") AS "Best_Grade"
    FROM "Student_Schedules" AS ss
    JOIN (
        SELECT c."ClassID"
        FROM "Classes" AS c
        JOIN "Subjects" AS s
          ON c."SubjectID" = s."SubjectID"
        WHERE s."CategoryID" = 'ENG'
    ) AS eng_classes
      ON ss."ClassID" = eng_classes."ClassID"
    WHERE ss."ClassStatus" = 2
    GROUP BY ss."StudentID"
),
ranked AS (
    SELECT b."StudentID",
           b."Best_Grade",
           (SELECT COUNT(*) FROM best b2
             WHERE b2."Best_Grade" >= b."Best_Grade") AS "Rank_Pos"
    FROM best AS b
), totals AS (SELECT COUNT(*) AS "Total" FROM best)
SELECT r."StudentID",
       r."Best_Grade",
       1.0 * r."Rank_Pos" / t."Total" AS "Percentile"
FROM ranked AS r, totals AS t
LIMIT 20;
```

```sql
-- 9. Translate percentile into the requested quintile labels
WITH best AS (
    SELECT ss."StudentID", MAX(ss."Grade") AS "Best_Grade"
    FROM "Student_Schedules" AS ss
    JOIN (
        SELECT c."ClassID"
        FROM "Classes" AS c
        JOIN "Subjects" AS s
          ON c."SubjectID" = s."SubjectID"
        WHERE s."CategoryID" = 'ENG'
    ) AS eng_classes
      ON ss."ClassID" = eng_classes."ClassID"
    WHERE ss."ClassStatus" = 2
    GROUP BY ss."StudentID"
),
ranked AS (
    SELECT b."StudentID",
           (SELECT COUNT(*) FROM best b2
             WHERE b2."Best_Grade" >= b."Best_Grade") AS "Rank_Pos"
    FROM best AS b
), totals AS (SELECT COUNT(*) AS "Total" FROM best)
SELECT r."StudentID",
       CASE
           WHEN 1.0 * r."Rank_Pos" / t."Total" <= 0.20 THEN 'First'
           WHEN 1.0 * r."Rank_Pos" / t."Total" <= 0.40 THEN 'Second'
           WHEN 1.0 * r."Rank_Pos" / t."Total" <= 0.60 THEN 'Third'
           WHEN 1.0 * r."Rank_Pos" / t."Total" <= 0.80 THEN 'Fourth'
           ELSE 'Fifth'
       END AS "Quintile"
FROM ranked AS r, totals AS t
LIMIT 20;
```

```sql
-- 10. Final answer: last names and quintile, ordered from First → Fifth
WITH best AS (
    SELECT ss."StudentID", MAX(ss."Grade") AS "Best_Grade"
    FROM "Student_Schedules" AS ss
    JOIN (
        SELECT c."ClassID"
        FROM "Classes" AS c
        JOIN "Subjects" AS s
          ON c."SubjectID" = s."SubjectID"
        WHERE s."CategoryID" = 'ENG'
    ) AS eng_classes
      ON ss."ClassID" = eng_classes."ClassID"
    WHERE ss."ClassStatus" = 2
    GROUP BY ss."StudentID"
),
ranked AS (
    SELECT b."StudentID",
           (SELECT COUNT(*) FROM best b2
             WHERE b2."Best_Grade" >= b."Best_Grade") AS "Rank_Pos"
    FROM best AS b
), totals AS (SELECT COUNT(*) AS "Total" FROM best),
quintile AS (
    SELECT r."StudentID",
           CASE
               WHEN 1.0 * r."Rank_Pos" / t."Total" <= 0.20 THEN 'First'
               WHEN 1.0 * r."Rank_Pos" / t."Total" <= 0.40 THEN 'Second'
               WHEN 1.0 * r."Rank_Pos" / t."Total" <= 0.60 THEN 'Third'
               WHEN 1.0 * r."Rank_Pos" / t."Total" <= 0.80 THEN 'Fourth'
               ELSE 'Fifth'
           END AS "Quintile"
    FROM ranked AS r, totals AS t
)
SELECT s."StudLastName" AS "LastName",
       q."Quintile"
FROM quintile AS q
JOIN "Students" AS s
  ON s."StudentID" = q."StudentID"
ORDER BY CASE q."Quintile"
           WHEN 'First'  THEN 1
           WHEN 'Second' THEN 2
           WHEN 'Third'  THEN 3
           WHEN 'Fourth' THEN 4
           WHEN 'Fifth'  THEN 5
         END
LIMIT 20;
```

The 10th query returns exactly what the task asks: every student’s last name who completed English courses together with their quintile label, sorted from the highest‑performing quintile (“First”) down to the lowest (“Fifth”).
