),
event_cnt AS (
    SELECT
        "session",
        COUNT(*) AS cnt
    FROM pre_events
    GROUP BY "session"
),
min_cnt AS (
    SELECT MIN(cnt) AS min_value FROM event_cnt
)
SELECT
    p."session"  AS session_id,
    p."path",
    p."search_type"
FROM pre_events p
JOIN event_cnt c ON c."session" = p."session"
JOIN min_cnt  m ON m.min_value  = c.cnt
ORDER BY p."session", p."stamp";
