```sql
WITH first_target AS (
    /* 1. time of the first /detail or /complete for every session */
    SELECT "session",
           MIN("stamp") AS first_target_stamp
    FROM   "activity_log"
    WHERE  "path" IN ('/detail', '/complete')
    GROUP BY "session"
),
pre_counts AS (
    /* 2. number of events with non‑empty search_type that happened before it */
    SELECT ft."session",
           SUM(
               CASE
                   WHEN al."stamp" < ft.first_target_stamp
                    AND al."search_type" IS NOT NULL
                    AND al."search_type" <> '' THEN 1
                   ELSE 0
               END
           ) AS cnt
    FROM   first_target ft
    LEFT JOIN "activity_log" al
           ON al."session" = ft."session"
    GROUP BY ft."session"
),
min_cnt AS (
    /* 3. minimum of those counts */
    SELECT MIN(cnt) AS min_cnt FROM pre_counts
),
qual_sessions AS (
    /* 4. sessions that have that minimum count */
    SELECT pc."session"
    FROM   pre_counts pc
    JOIN   min_cnt    mc ON pc.cnt = mc.min_cnt
),
first_target_event AS (
    /* 5. the first /detail or /complete row for each qualifying session */
    SELECT  al."session",
            MIN(al."path")        AS path,
            MIN(al."search_type") AS search_type
    FROM    "activity_log" al
    JOIN    first_target ft
           ON al."session" = ft."session"
          AND al."stamp"   = ft.first_target_stamp
    WHERE   al."path" IN ('/detail', '/complete')
    GROUP BY al."session"
)
SELECT  fte."session" AS session_id,
        fte."path",
        fte."search_type"
FROM    first_target_event fte
JOIN    qual_sessions     qs  ON fte."session" = qs."session"
ORDER BY fte."session";
```
