WITH first_target AS (
    /* earliest /detail or /complete inside each session */
    SELECT "session",
           MIN("stamp") AS first_target_stamp
    FROM   "activity_log"
    WHERE  "path" IN ('/detail', '/complete')
    GROUP BY "session"
),
pre_events AS (
    /* events with non‑empty search_type that occur before that moment */
    SELECT a."session",
           a."stamp",
           a."path",
           a."search_type"
    FROM   "activity_log" AS a
    JOIN   first_target  AS f
           ON a."session" = f."session"
          AND a."stamp"   < f.first_target_stamp
    WHERE  a."search_type" IS NOT NULL
      AND  a."search_type" <> ''
),
counts AS (
    /* how many such pre‑events per session */
    SELECT "session",
           COUNT(*) AS cnt
    FROM   pre_events
    GROUP BY "session"
),
min_cnt AS (
    /* smallest count */
    SELECT MIN(cnt) AS min_cnt FROM counts
)
SELECT  p."session" AS session_id,
        p."path",
        p."search_type"
FROM    pre_events p
JOIN    counts   c ON p."session" = c."session"
JOIN    min_cnt  m ON c.cnt       = m.min_cnt
ORDER BY p."session", p."stamp";
