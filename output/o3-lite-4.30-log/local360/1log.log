WITH
first_target AS (
    /* 1.  First time a session reaches /detail or /complete */
    SELECT "session",
           MIN("stamp") AS first_target_stamp
    FROM   "activity_log"
    WHERE  "path" IN ('/detail', '/complete')
    GROUP BY "session"
),
counts AS (
    /* 2.  How many non‑empty‑search_type events occur before that moment?   */
    SELECT  f."session",
            SUM(
                CASE
                     WHEN a."stamp" < f.first_target_stamp
                      AND a."search_type" IS NOT NULL
                      AND a."search_type" <> ''  THEN 1
                     ELSE 0
                END
            ) AS pre_event_cnt
    FROM    first_target AS f
    LEFT JOIN "activity_log" AS a
           ON a."session" = f."session"
    GROUP BY f."session"
),
min_cnt AS (
    /* 3.  Smallest such count over all sessions */
    SELECT MIN(pre_event_cnt) AS min_cnt
    FROM   counts
),
target_event AS (
    /* 4.  The actual /detail or /complete record that was reached first */
    SELECT  a."session",
            a."path",
            a."search_type"
    FROM    "activity_log" AS a
    JOIN    first_target  AS f
           ON a."session" = f."session"
          AND a."stamp"   = f.first_target_stamp
)
SELECT  c."session"  AS session_id,
        t."path",
        t."search_type"
FROM    counts       AS c
JOIN    min_cnt      AS m  ON c.pre_event_cnt = m.min_cnt
JOIN    target_event AS t  ON c."session" = t."session"
