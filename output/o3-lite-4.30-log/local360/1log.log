WITH first_target AS (
    /* first /detail or /complete event in each session */
    SELECT "session",
           MIN("stamp")                           AS first_target_stamp,
           MIN(CASE WHEN "stamp" = MIN("stamp") OVER (PARTITION BY "session")
                    THEN "path" END)              AS path,
           MIN(CASE WHEN "stamp" = MIN("stamp") OVER (PARTITION BY "session")
                    THEN "search_type" END)       AS search_type
    FROM   "activity_log"
    WHERE  "path" IN ('/detail', '/complete')
    GROUP BY "session"
),
pre_counts AS (
    /* count events with non‑empty search_type that occurred beforehand */
    SELECT  f."session",
            SUM(
                CASE
                     WHEN a."stamp" < f.first_target_stamp
                      AND a."search_type" IS NOT NULL
                      AND a."search_type" <> '' THEN 1
                     ELSE 0
                END
            ) AS cnt
    FROM    first_target  f
    LEFT    JOIN "activity_log" a
             ON a."session" = f."session"
    GROUP BY f."session"
),
min_cnt AS (
    SELECT MIN(cnt) AS min_cnt
    FROM   pre_counts
)
SELECT  f."session"     AS session_id,
        f."path",
        f."search_type"
FROM    first_target f
JOIN    pre_counts  c ON f."session" = c."session"
JOIN    min_cnt     m ON c.cnt       = m.min_cnt
ORDER BY f."session";
