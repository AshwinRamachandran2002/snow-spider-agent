```sql
--Description:
-- ❶ first_target  : for every session that ever reached a page whose path starts with
--    '/detail' or '/complete', record the earliest time‑stamp of that page.
-- ❷ target_event  : fetch that very row (so we can later return its path & search_type).
-- ❸ counts        : left‑join activity_log to count how many rows with a non‑empty
--    search_type occurred *before* the first_target_stamp inside each session
--    (sessions with zero such rows get cnt = 0).
-- ❹ min_cnt       : find the smallest of those counts.
-- ❺ final SELECT  : keep the session(s) whose count equals that minimum and return
--    the session id together with the path & search_type of their first target page.
WITH first_target AS (
    SELECT
        "session",
        MIN("stamp") AS first_target_stamp
    FROM "activity_log"
    WHERE "path" LIKE '/detail%'     -- matches '/detail' or '/detail/'
       OR "path" LIKE '/complete%'   -- matches '/complete' or '/complete/'
    GROUP BY "session"
),
target_event AS (
    SELECT a."session",
           a."path",
           a."search_type"
    FROM "activity_log" a
    JOIN first_target f
      ON a."session" = f."session"
     AND a."stamp"   = f.first_target_stamp
),
counts AS (
    SELECT
        f."session",
        COUNT(a."stamp") AS cnt
    FROM first_target  f
    LEFT JOIN "activity_log" a
           ON a."session" = f."session"
          AND a."stamp"   < f.first_target_stamp      -- strictly before target
          AND a."search_type" IS NOT NULL
          AND a."search_type" <> ''                   -- non‑empty search_type
    GROUP BY f."session"
),
min_cnt AS (
    SELECT MIN(cnt) AS min_cnt FROM counts
)
SELECT
    t."session",
    t."path",
    t."search_type"
FROM counts      c
JOIN min_cnt     m ON c.cnt = m.min_cnt
JOIN target_event t ON t."session" = c."session"
ORDER BY t."session";
