WITH first_target AS (
    /* first /detail or /complete inside each session */
    SELECT "session",
           MIN("stamp") AS first_target_stamp
    FROM   "activity_log"
    WHERE  "path" IN ('/detail', '/complete')
    GROUP BY "session"
),
events_before AS (
    /* events that have a non‑empty search_type and occur before that moment */
    SELECT a."session",
           a."stamp",
           a."path",
           a."search_type"
    FROM   "activity_log" AS a
    JOIN   first_target  AS f
           ON a."session" = f."session"
          AND a."stamp"   < f.first_target_stamp
    WHERE  a."search_type" IS NOT NULL
      AND  a."search_type" <> ''
),
cnt AS (
    /* number of such events per session (include zero) */
    SELECT f."session",
           COUNT(e."session") AS cnt
    FROM   first_target  AS f
    LEFT  JOIN events_before AS e
           ON f."session" = e."session"
    GROUP BY f."session"
),
min_cnt AS (
    SELECT MIN(cnt) AS min_cnt FROM cnt
),
qual_sessions AS (
    SELECT "session" FROM cnt, min_cnt
    WHERE  cnt = min_cnt
)
SELECT e."session"     AS session_id,
       e."path",
       e."search_type"
FROM   events_before e
