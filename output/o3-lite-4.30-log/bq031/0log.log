Relevant columns & their potential usage  
------------------------------------------------  
`stations.name`:  search for station records whose text contains “Rochester”.  
`stations.usaf` & `stations.wban`:  station‑ID keys that link a station to GSOD daily data.  
`stations.state`, `stations.country`:  help keep only the Rochester that is in the desired state / country (often MN, NY, etc.).  
`gsod2019.stn` & `gsod2019.wban`:  station‑ID keys that join to the stations table.  
`gsod2019.year`, `gsod2019.mo`, `gsod2019.da`:  build a YYYY‑MM‑DD date.  
`gsod2019.temp` (ºF), `gsod2019.prcp` (in), `gsod2019.wdsp` (knots):  daily weather variables to be converted to the requested units.  
Conditions that will be used  
•  LOWER(`name`) LIKE '%rochester%'  
•  `year` = '2019' AND CAST(CONCAT(year, '-', mo, '-', da) AS DATE) BETWEEN '2019-01-01' AND '2019-03-31'  
•  `wdsp`   != '999.9'      -- remove missing wind values  
•  `temp`   !=  9999.9      -- remove missing temperature  
•  `prcp`   !=  99.99       -- remove missing precipitation  

Ten exploratory‑to‑final SQL queries  
-------------------------------------

```sql
-- 1. See all station names that contain “Rochester”.
SELECT DISTINCT
  usaf,
  wban,
  TRIM(name) AS station_name,
  country,
  state
FROM `bigquery-public-data.noaa_gsod.stations`
WHERE LOWER(name) LIKE '%rochester%'
ORDER BY station_name
LIMIT 20;
```

```sql
-- 2. Check how many “Rochester” stations reported data in 2019.
SELECT
  s.usaf,
  s.wban,
  TRIM(s.name) AS station_name,
  COUNT(*) AS num_2019_rows
FROM `bigquery-public-data.noaa_gsod.stations` AS s
JOIN `bigquery-public-data.noaa_gsod.gsod2019` AS g
  ON g.stn = s.usaf AND g.wban = s.wban
WHERE LOWER(s.name) LIKE '%rochester%'
  AND g.year = '2019'
GROUP BY 1,2,3
ORDER BY num_2019_rows DESC
LIMIT 20;
```

```sql
-- 3. Preview daily rows (Jan–Mar 2019) for the most complete Rochester station.
SELECT
  g.stn  AS usaf,
  g.wban,
  g.year, g.mo, g.da,
  g.temp, g.prcp, g.wdsp
FROM `bigquery-public-data.noaa_gsod.gsod2019` AS g
WHERE (g.stn, g.wban) IN (('726440','14925'))      -- swap with code found in query 2
  AND DATE(CONCAT(year,'-',mo,'-',da)) BETWEEN '2019-01-01' AND '2019-03-31'
LIMIT 20;
```

```sql
-- 4. Convert temperature from °F to °C (one sample station, first 5 rows).
SELECT
  DATE(CONCAT(year,'-',mo,'-',da)) AS dte,
  ROUND((temp - 32) * 5/9, 1) AS temp_c
FROM `bigquery-public-data.noaa_gsod.gsod2019`
WHERE stn = '726440' AND wban = '14925'
  AND DATE(CONCAT(year,'-',mo,'-',da)) BETWEEN '2019-01-01' AND '2019-03-31'
ORDER BY dte
LIMIT 5;
```

```sql
-- 5. Convert precipitation from inches to centimeters.
SELECT
  DATE(CONCAT(year,'-',mo,'-',da)) AS dte,
  ROUND(prcp * 2.54 , 1) AS prcp_cm
FROM `bigquery-public-data.noaa_gsod.gsod2019`
WHERE stn = '726440' AND wban = '14925'
  AND prcp != 99.99
  AND DATE(CONCAT(year,'-',mo,'-',da)) BETWEEN '2019-01-01' AND '2019-03-31'
ORDER BY dte
LIMIT 5;
```

```sql
-- 6. Convert mean wind speed from knots to m/s.
SELECT
  DATE(CONCAT(year,'-',mo,'-',da)) AS dte,
  ROUND(CAST(wdsp AS FLOAT64) * 0.514444, 1) AS wind_ms
FROM `bigquery-public-data.noaa_gsod.gsod2019`
WHERE stn = '726440' AND wban = '14925'
  AND wdsp != '999.9'
  AND DATE(CONCAT(year,'-',mo,'-',da)) BETWEEN '2019-01-01' AND '2019-03-31'
ORDER BY dte
LIMIT 5;
```

```sql
-- 7. Build one row per day with all three converted variables.
SELECT
  DATE(CONCAT(year,'-',mo,'-',da))                       AS dte,
  ROUND((temp - 32) * 5/9, 1)                            AS temp_c,
  ROUND(prcp * 2.54, 1)                                  AS prcp_cm,
  ROUND(CAST(wdsp AS FLOAT64) * 0.514444, 1)             AS wind_ms
FROM `bigquery-public-data.noaa_gsod.gsod2019`
WHERE stn = '726440' AND wban = '14925'
  AND DATE(CONCAT(year,'-',mo,'-',da)) BETWEEN '2019-01-01' AND '2019-03-31'
ORDER BY dte
LIMIT 20;
```

```sql
-- 8. Add 8‑day moving average for temperature only (to confirm window logic).
SELECT
  dte,
  temp_c,
  ROUND(AVG(temp_c) OVER (ORDER BY dte ROWS BETWEEN 7 PRECEDING AND CURRENT ROW), 1) AS ma8_temp_c
FROM (
  SELECT
    DATE(CONCAT(year,'-',mo,'-',da)) AS dte,
    ROUND((temp - 32) * 5/9, 1)      AS temp_c
  FROM `bigquery-public-data.noaa_gsod.gsod2019`
  WHERE stn = '726440' AND wban = '14925'
    AND DATE(CONCAT(year,'-',mo,'-',da)) BETWEEN '2019-01-01' AND '2019-03-31'
) 
ORDER BY dte
LIMIT 20;
```

```sql
-- 9. Demonstrate lag‑difference for the 8‑day moving temperature average.
WITH t AS (
  SELECT
    DATE(CONCAT(year,'-',mo,'-',da)) AS dte,
    ROUND((temp - 32) * 5/9, 1)      AS temp_c
  FROM `bigquery-public-data.noaa_gsod.gsod2019`
  WHERE stn = '726440' AND wban = '14925'
    AND DATE(CONCAT(year,'-',mo,'-',da)) BETWEEN '2019-01-01' AND '2019-03-31')
SELECT
  dte,
  ROUND(AVG(temp_c) OVER (ORDER BY dte ROWS BETWEEN 7 PRECEDING AND CURRENT ROW),1) AS ma8_temp_c,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,1)  OVER (ORDER BY dte),1) AS diff_lag1,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,2)  OVER (ORDER BY dte),1) AS diff_lag2
FROM t
ORDER BY dte
LIMIT 20;
```

```sql
-- 10. Final answer:  daily values + 8‑day moving averages +
--     differences to lag1 … lag8, for temperature, precipitation, wind.
WITH base AS (
  SELECT
    DATE(CONCAT(year,'-',mo,'-',da))                           AS dte,
    ROUND((temp - 32) * 5/9, 1)                                AS temp_c,
    ROUND(prcp * 2.54, 1)                                      AS prcp_cm,
    ROUND(CAST(wdsp AS FLOAT64) * 0.514444, 1)                 AS wind_ms
  FROM `bigquery-public-data.noaa_gsod.gsod2019`
  WHERE stn = '726440'                  -- Rochester station code obtained earlier
    AND wban = '14925'
    AND DATE(CONCAT(year,'-',mo,'-',da)) BETWEEN '2019-01-01' AND '2019-03-31'
)
SELECT
  dte,
  temp_c,
  prcp_cm,
  wind_ms,
  -- 8‑day moving averages
  ROUND(AVG(temp_c)  OVER (ORDER BY dte ROWS BETWEEN 7 PRECEDING AND CURRENT ROW),1) AS ma8_temp_c,
  ROUND(AVG(prcp_cm) OVER (ORDER BY dte ROWS BETWEEN 7 PRECEDING AND CURRENT ROW),1) AS ma8_prcp_cm,
  ROUND(AVG(wind_ms) OVER (ORDER BY dte ROWS BETWEEN 7 PRECEDING AND CURRENT ROW),1) AS ma8_wind_ms,
  -- lag‑differences for temperature
  ROUND(ma8_temp_c - LAG(ma8_temp_c,1) OVER (ORDER BY dte),1) AS diff_temp_lag1,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,2) OVER (ORDER BY dte),1) AS diff_temp_lag2,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,3) OVER (ORDER BY dte),1) AS diff_temp_lag3,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,4) OVER (ORDER BY dte),1) AS diff_temp_lag4,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,5) OVER (ORDER BY dte),1) AS diff_temp_lag5,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,6) OVER (ORDER BY dte),1) AS diff_temp_lag6,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,7) OVER (ORDER BY dte),1) AS diff_temp_lag7,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,8) OVER (ORDER BY dte),1) AS diff_temp_lag8,
  -- lag‑differences for precipitation
  ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,1) OVER (ORDER BY dte),1) AS diff_prcp_lag1,
  ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,2) OVER (ORDER BY dte),1) AS diff_prcp_lag2,
  ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,3) OVER (ORDER BY dte),1) AS diff_prcp_lag3,
  ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,4) OVER (ORDER BY dte),1) AS diff_prcp_lag4,
  ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,5) OVER (ORDER BY dte),1) AS diff_prcp_lag5,
  ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,6) OVER (ORDER BY dte),1) AS diff_prcp_lag6,
  ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,7) OVER (ORDER BY dte),1) AS diff_prcp_lag7,
  ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,8) OVER (ORDER BY dte),1) AS diff_prcp_lag8,
  -- lag‑differences for wind speed
  ROUND(ma8_wind_ms - LAG(ma8_wind_ms,1) OVER (ORDER BY dte),1) AS diff_wind_lag1,
  ROUND(ma8_wind_ms - LAG(ma8_wind_ms,2) OVER (ORDER BY dte),1) AS diff_wind_lag2,
  ROUND(ma8_wind_ms - LAG(ma8_wind_ms,3) OVER (ORDER BY dte),1) AS diff_wind_lag3,
  ROUND(ma8_wind_ms - LAG(ma8_wind_ms,4) OVER (ORDER BY dte),1) AS diff_wind_lag4,
  ROUND(ma8_wind_ms - LAG(ma8_wind_ms,5) OVER (ORDER BY dte),1) AS diff_wind_lag5,
  ROUND(ma8_wind_ms - LAG(ma8_wind_ms,6) OVER (ORDER BY dte),1) AS diff_wind_lag6,
  ROUND(ma8_wind_ms - LAG(ma8_wind_ms,7) OVER (ORDER BY dte),1) AS diff_wind_lag7,
  ROUND(ma8_wind_ms - LAG(ma8_wind_ms,8) OVER (ORDER BY dte),1) AS diff_wind_lag8
FROM base
QUALIFY dte >= '2019-01-09'            -- start when the first full 8‑day window exists
ORDER BY dte;
```

Each query progressively builds understanding until the final query (Query 10) produces the requested dataset, rounded to one decimal place and ordered from 9 Jan 2019 through 31 Mar 2019.
