Begin Exploring Related Columns
Relevant columns and their possible roles  

bigquery-public-data.noaa_gsod.stations  
• usaf           : station id –‑ join key to daily file  
• wban           : station id –‑ 2nd part of join key  
• name           : search for “ROCHESTER” stations  
• country        : keep US stations (country = 'US')  
• state          : decide which Rochester (NY = “NY”, MN = “MN”, etc.)  
• lat / lon      : geographical check if several stations match  
• begin / end    : be sure the station was active in 2019  

bigquery-public-data.noaa_gsod.gsod2019  
• stn / wban     : join to “usaf / wban” in stations  
• year / mo / da : build the date field  
• temp           : mean daily air temperature (°F) → convert to °C  
• prcp           : daily precipitation (inch) → convert to cm  
• wdsp           : mean wind speed (knots, stored as string) → convert to m s‑¹  
• any “9999.9 / 999.9 / 999.9” : missing value flags –‑ filter out or turn into NULL  

Typical filters / conditions that will be used  
• LOWER(name) LIKE '%rochester%'  
• country = 'US'  
• CONCAT(year,'-',mo,'-',da) BETWEEN '2019-01-01' AND '2019-03-31'  
• temp  <> 9999.9, prcp <> 99.99, CAST(wdsp AS FLOAT64) <> 999.9  

-------------------------------------------------------------------
Ten exploratory → final BigQuery SQL snippets  
(Replace YOUR‑PROJECT if you copy to your own project; every query ends with LIMIT 20)

```sql
-- 1. Find every station whose name contains “Rochester”
SELECT usaf, wban, name, state, country, lat, lon
FROM `bigquery-public-data.noaa_gsod.stations`
WHERE LOWER(name) LIKE '%rochester%'
  AND country = 'US'
LIMIT 20;
```

```sql
-- 2. Check the operating period of those Rochester stations
SELECT usaf, wban, name, begin, `end`
FROM `bigquery-public-data.noaa_gsod.stations`
WHERE LOWER(name) LIKE '%rochester%'
  AND country = 'US'
ORDER BY usaf
LIMIT 20;
```

```sql
-- 3. Peek at 2019 daily records for one Rochester station (use any usaf/wban you found)
SELECT stn AS usaf, wban,
       CONCAT(year,'-',mo,'-',da) AS yyyymmdd,
       temp, prcp, wdsp
FROM `bigquery-public-data.noaa_gsod.gsod2019`
WHERE stn = '726058'   -- <=== change to the station chosen
  AND wban = '94756'   -- <=== change likewise
  AND CONCAT(year,'-',mo,'-',da) BETWEEN '2019-01-01' AND '2019-03-31'
LIMIT 20;
```

```sql
-- 4. Same sample but convert the three variables to metric units
SELECT CONCAT(year,'-',mo,'-',da) AS dt,
       ROUND((temp - 32) * 5/9, 1)      AS temp_c,
       ROUND(prcp * 2.54, 1)            AS prcp_cm,
       ROUND(CAST(wdsp AS FLOAT64)*0.514444, 1) AS wind_ms
FROM `bigquery-public-data.noaa_gsod.gsod2019`
WHERE stn = '726058' AND wban = '94756'
  AND CONCAT(year,'-',mo,'-',da) BETWEEN '2019-01-01' AND '2019-03-31'
  AND temp <> 9999.9 AND prcp <> 99.99 AND CAST(wdsp AS FLOAT64) <> 999.9
LIMIT 20;
```

```sql
-- 5. Calculate an 8‑day moving average of temperature over the period
WITH src AS (
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS dt,
         ROUND((temp - 32)*5/9,1) AS temp_c
  FROM `bigquery-public-data.noaa_gsod.gsod2019`
  WHERE stn = '726058' AND wban = '94756'
    AND CONCAT(year,'-',mo,'-',da) BETWEEN '2019-01-01' AND '2019-03-31'
    AND temp <> 9999.9
)
SELECT dt,
       temp_c,
       ROUND(AVG(temp_c) OVER (ORDER BY dt
                               ROWS BETWEEN 7 PRECEDING AND CURRENT ROW),1) AS ma8_temp_c
FROM src
LIMIT 20;
```

```sql
-- 6. Same idea for precipitation (centimeters)
WITH src AS (
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS dt,
         ROUND(prcp*2.54,1) AS prcp_cm
  FROM `bigquery-public-data.noaa_gsod.gsod2019`
  WHERE stn = '726058' AND wban = '94756'
    AND CONCAT(year,'-',mo,'-',da) BETWEEN '2019-01-01' AND '2019-03-31'
    AND prcp <> 99.99
)
SELECT dt,
       prcp_cm,
       ROUND(AVG(prcp_cm) OVER (ORDER BY dt
                                ROWS BETWEEN 7 PRECEDING AND CURRENT ROW),1) AS ma8_prcp_cm
FROM src
LIMIT 20;
```

```sql
-- 7. Wind‑speed (convert knots→m s‑¹) with 8‑day moving average
WITH src AS (
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS dt,
         ROUND(CAST(wdsp AS FLOAT64)*0.514444,1) AS wind_ms
  FROM `bigquery-public-data.noaa_gsod.gsod2019`
  WHERE stn = '726058' AND wban = '94756'
    AND CONCAT(year,'-',mo,'-',da) BETWEEN '2019-01-01' AND '2019-03-31'
    AND CAST(wdsp AS FLOAT64) <> 999.9
)
SELECT dt,
       wind_ms,
       ROUND(AVG(wind_ms) OVER (ORDER BY dt
                                ROWS BETWEEN 7 PRECEDING AND CURRENT ROW),1) AS ma8_wind_ms
FROM src
LIMIT 20;
```

```sql
-- 8. Show 8‑day moving average of temperature plus its lag‑1 to lag‑8 differences
WITH src AS (
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS dt,
         ROUND((temp - 32)*5/9,1) AS temp_c
  FROM `bigquery-public-data.noaa_gsod.gsod2019`
  WHERE stn = '726058' AND wban = '94756'
    AND CONCAT(year,'-',mo,'-',da) BETWEEN '2019-01-01' AND '2019-03-31'
    AND temp <> 9999.9
), ma AS (
  SELECT dt,
         temp_c,
         ROUND(AVG(temp_c) OVER (ORDER BY dt ROWS BETWEEN 7 PRECEDING AND CURRENT ROW),1) AS ma8
  FROM src
)
SELECT dt, temp_c, ma8,
       ROUND(ma8 - LAG(ma8,1)  OVER (ORDER BY dt),1) AS diff_lag1,
       ROUND(ma8 - LAG(ma8,2)  OVER (ORDER BY dt),1) AS diff_lag2,
       ROUND(ma8 - LAG(ma8,3)  OVER (ORDER BY dt),1) AS diff_lag3,
       ROUND(ma8 - LAG(ma8,4)  OVER (ORDER BY dt),1) AS diff_lag4,
       ROUND(ma8 - LAG(ma8,5)  OVER (ORDER BY dt),1) AS diff_lag5,
       ROUND(ma8 - LAG(ma8,6)  OVER (ORDER BY dt),1) AS diff_lag6,
       ROUND(ma8 - LAG(ma8,7)  OVER (ORDER BY dt),1) AS diff_lag7,
       ROUND(ma8 - LAG(ma8,8)  OVER (ORDER BY dt),1) AS diff_lag8
FROM ma
WHERE dt >= '2019-01-09'   -- first date with a full 8‑day MA
LIMIT 20;
```

```sql
-- 9. Combine the three variables with their 8‑day MAs (no lags yet)
WITH base AS (
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS dt,
         ROUND((temp - 32)*5/9,1)                       AS temp_c,
         ROUND(prcp*2.54,1)                             AS prcp_cm,
         ROUND(CAST(wdsp AS FLOAT64)*0.514444,1)        AS wind_ms
  FROM `bigquery-public-data.noaa_gsod.gsod2019`
  WHERE stn = '726058' AND wban = '94756'
    AND CONCAT(year,'-',mo,'-',da) BETWEEN '2019-01-01' AND '2019-03-31'
    AND temp <> 9999.9 AND prcp <> 99.99 AND CAST(wdsp AS FLOAT64) <> 999.9
)
SELECT dt,
       temp_c,
       ROUND(AVG(temp_c)  OVER (ORDER BY dt ROWS BETWEEN 7 PRECEDING AND CURRENT ROW),1) AS ma8_temp_c,
       prcp_cm,
       ROUND(AVG(prcp_cm) OVER (ORDER BY dt ROWS BETWEEN 7 PRECEDING AND CURRENT ROW),1) AS ma8_prcp_cm,
       wind_ms,
       ROUND(AVG(wind_ms) OVER (ORDER BY dt ROWS BETWEEN 7 PRECEDING AND CURRENT ROW),1) AS ma8_wind_ms
FROM base
WHERE dt >= '2019-01-09'
LIMIT 20;
```

```sql
-- 10. FINAL: everything requested – metrics, 8‑day MAs, lag‑1…lag‑8 differences, ordered from Jan‑09 onward
WITH base AS (
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS dt,
         ROUND((temp - 32)*5/9,1)                AS temp_c,
         ROUND(prcp*2.54,1)                      AS prcp_cm,
         ROUND(CAST(wdsp AS FLOAT64)*0.514444,1) AS wind_ms
  FROM `bigquery-public-data.noaa_gsod.gsod2019`
  WHERE stn = '726058' AND wban = '94756'                   -- <=== Rochester station
    AND CONCAT(year,'-',mo,'-',da) BETWEEN '2019-01-01' AND '2019-03-31'
    AND temp <> 9999.9 AND prcp <> 99.99 AND CAST(wdsp AS FLOAT64) <> 999.9
), ma AS (
  SELECT *,
         ROUND(AVG(temp_c)  OVER (ORDER BY dt ROWS BETWEEN 7 PRECEDING AND CURRENT ROW),1) AS ma8_temp_c,
         ROUND(AVG(prcp_cm) OVER (ORDER BY dt ROWS BETWEEN 7 PRECEDING AND CURRENT ROW),1) AS ma8_prcp_cm,
         ROUND(AVG(wind_ms) OVER (ORDER BY dt ROWS BETWEEN 7 PRECEDING AND CURRENT ROW),1) AS ma8_wind_ms
  FROM base
)
SELECT dt,
       temp_c, ma8_temp_c,
       ROUND(ma8_temp_c - LAG(ma8_temp_c,1) OVER (ORDER BY dt),1) AS d1_temp,
       ROUND(ma8_temp_c - LAG(ma8_temp_c,2) OVER (ORDER BY dt),1) AS d2_temp,
       ROUND(ma8_temp_c - LAG(ma8_temp_c,3) OVER (ORDER BY dt),1) AS d3_temp,
       ROUND(ma8_temp_c - LAG(ma8_temp_c,4) OVER (ORDER BY dt),1) AS d4_temp,
       ROUND(ma8_temp_c - LAG(ma8_temp_c,5) OVER (ORDER BY dt),1) AS d5_temp,
       ROUND(ma8_temp_c - LAG(ma8_temp_c,6) OVER (ORDER BY dt),1) AS d6_temp,
       ROUND(ma8_temp_c - LAG(ma8_temp_c,7) OVER (ORDER BY dt),1) AS d7_temp,
       ROUND(ma8_temp_c - LAG(ma8_temp_c,8) OVER (ORDER BY dt),1) AS d8_temp,
       prcp_cm, ma8_prcp_cm,
       ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,1) OVER (ORDER BY dt),1) AS d1_prcp,
       ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,2) OVER (ORDER BY dt),1) AS d2_prcp,
       ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,3) OVER (ORDER BY dt),1) AS d3_prcp,
       ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,4) OVER (ORDER BY dt),1) AS d4_prcp,
       ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,5) OVER (ORDER BY dt),1) AS d5_prcp,
       ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,6) OVER (ORDER BY dt),1) AS d6_prcp,
       ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,7) OVER (ORDER BY dt),1) AS d7_prcp,
       ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,8) OVER (ORDER BY dt),1) AS d8_prcp,
       wind_ms, ma8_wind_ms,
       ROUND(ma8_wind_ms - LAG(ma8_wind_ms,1) OVER (ORDER BY dt),1) AS d1_wind,
       ROUND(ma8_wind_ms - LAG(ma8_wind_ms,2) OVER (ORDER BY dt),1) AS d2_wind,
       ROUND(ma8_wind_ms - LAG(ma8_wind_ms,3) OVER (ORDER BY dt),1) AS d3_wind,
       ROUND(ma8_wind_ms - LAG(ma8_wind_ms,4) OVER (ORDER BY dt),1) AS d4_wind,
       ROUND(ma8_wind_ms - LAG(ma8_wind_ms,5) OVER (ORDER BY dt),1) AS d5_wind,
       ROUND(ma8_wind_ms - LAG(ma8_wind_ms,6) OVER (ORDER BY dt),1) AS d6_wind,
       ROUND(ma8_wind_ms - LAG(ma8_wind_ms,7) OVER (ORDER BY dt),1) AS d7_wind,
       ROUND(ma8_wind_ms - LAG(ma8_wind_ms,8) OVER (ORDER BY dt),1) AS d8_wind
FROM ma
WHERE dt >= '2019-01-09'      -- first date where an 8‑day MA exists
ORDER BY dt
LIMIT 20;
```

Each subsequent query builds on the previous one, moving from the simplest station search to a full answer that meets every element of the requirement (daily values, 8‑day moving averages, and lag‑1 … lag‑8 differences, rounded to one decimal).
