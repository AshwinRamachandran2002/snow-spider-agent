  WHERE stn = '725290'
    AND wban = '14768'
    AND DATE(CONCAT(year,'-',mo,'-',da)) BETWEEN '2019-01-01' AND '2019-03-31'
    AND prcp <> 99.99
)
SELECT
  dt,
  prcp_cm,
  ROUND(AVG(prcp_cm) OVER (ORDER BY dt ROWS BETWEEN 7 PRECEDING AND CURRENT ROW), 1) AS ma8_prcp_cm
FROM src
LIMIT 20;
