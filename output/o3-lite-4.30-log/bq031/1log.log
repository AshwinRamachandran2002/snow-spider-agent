--Description:
-- Build the complete result requested for Rochester‑NY (Greater Rochester International Airport,
-- stn(usaf)=725290, wban=14768) between 1‑Jan‑2019 and 31‑Mar‑2019.
-- 1) Convert raw units to metric:  temp °F→°C, prcp in→cm, wind knots→m s‑¹.
-- 2) Compute an 8‑day moving average (current day + previous 7) for each variable.
-- 3) For every moving‑average series, calculate the difference between today’s value and
--    the MA from 1‑day‑ago through 8‑days‑ago (lag1 … lag8).
-- 4) Start the output on 9‑Jan‑2019 (first day with a complete 8‑day window), round all
--    numeric results to one decimal, and order chronologically.

WITH base AS (
  SELECT
    DATE(CONCAT(year, '-', mo, '-', da))                             AS dt,
    ROUND((temp - 32) * 5/9, 1)                                      AS temp_c,      -- °C
    ROUND(prcp * 2.54, 1)                                            AS prcp_cm,     -- cm
    ROUND(CAST(wdsp AS FLOAT64) * 0.514444, 1)                       AS wind_ms      -- m s‑¹
  FROM `bigquery-public-data.noaa_gsod.gsod2019`
  WHERE stn  = '725290'
    AND wban = '14768'
    AND DATE(CONCAT(year, '-', mo, '-', da)) BETWEEN '2019-01-01' AND '2019-03-31'
    AND temp <> 9999.9
    AND prcp <> 99.99
    AND CAST(wdsp AS FLOAT64) <> 999.9
),
ma AS (
  SELECT
    *,
    ROUND(AVG(temp_c)  OVER (ORDER BY dt ROWS BETWEEN 7 PRECEDING AND CURRENT ROW), 1) AS ma8_temp,
    ROUND(AVG(prcp_cm) OVER (ORDER BY dt ROWS BETWEEN 7 PRECEDING AND CURRENT ROW), 1) AS ma8_prcp,
    ROUND(AVG(wind_ms) OVER (ORDER BY dt ROWS BETWEEN 7 PRECEDING AND CURRENT ROW), 1) AS ma8_wind
  FROM base
)
SELECT
  dt,

  -- temperature (°C)
  temp_c,
  ma8_temp,
  ROUND(ma8_temp - LAG(ma8_temp, 1) OVER (ORDER BY dt), 1) AS diff_temp_lag1,
  ROUND(ma8_temp - LAG(ma8_temp, 2) OVER (ORDER BY dt), 1) AS diff_temp_lag2,
  ROUND(ma8_temp - LAG(ma8_temp, 3) OVER (ORDER BY dt), 1) AS diff_temp_lag3,
  ROUND(ma8_temp - LAG(ma8_temp, 4) OVER (ORDER BY dt), 1) AS diff_temp_lag4,
  ROUND(ma8_temp - LAG(ma8_temp, 5) OVER (ORDER BY dt), 1) AS diff_temp_lag5,
  ROUND(ma8_temp - LAG(ma8_temp, 6) OVER (ORDER BY dt), 1) AS diff_temp_lag6,
