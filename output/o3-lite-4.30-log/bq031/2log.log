Relevant columns and their potential usage
• stations.usaf & stations.wban:           join‐keys to link a station’s meta data with daily observations.  
• stations.name / stations.state / stations.country:  used to find the Rochester station(s).  
• gsod2019.stn  (a.k.a. usaf in stations): key to join with stations.  
• gsod2019.wban:  key to join with stations.  
• gsod2019.year , mo , da:  build the calendar date and restrict to 2019‑01‑01 … 2019‑03‑31.  
• gsod2019.temp:  mean air temperature (°F) – will be converted to °C.  
• gsod2019.prcp:  daily precipitation (inches) – will be converted to cm.  
• gsod2019.wdsp:  mean wind speed (knots) – will be converted to m s‑¹.  

Typical conditions that will be used
• LOWER(stations.name) LIKE '%rochester%'  (find Rochester station).  
• year='2019' AND mo IN ('01','02','03')   (date filter).  
• CAST(temp  AS FLOAT64) <> 9999.9, CAST(prcp AS FLOAT64) <> 99.99, CAST(wdsp AS FLOAT64) <> 999.9  (remove the “missing‑value” codes).  

Below are ten step‑by‑step exploratory → final queries (all capped with LIMIT 20 for safety).

```sql
-- 1.  List every station whose name contains 'Rochester'
SELECT DISTINCT usaf, wban, TRIM(name) AS station_name, country, state
FROM `bigquery-public-data.noaa_gsod.stations`
WHERE LOWER(name) LIKE '%rochester%'
LIMIT 20;
```

```sql
-- 2.  Get the geographic position of each Rochester station
SELECT usaf, wban, TRIM(name) AS station_name, lat, lon, elev
FROM `bigquery-public-data.noaa_gsod.stations`
WHERE LOWER(name) LIKE '%rochester%'
LIMIT 20;
```

```sql
-- 3.  Fetch a few 2019 rows for one Rochester station (using the first usaf from #1)
SELECT stn, wban, year, mo, da, temp, prcp, wdsp
FROM `bigquery-public-data.noaa_gsod.gsod2019`
WHERE stn = '726320'      -- change to real usaf after #1
  AND wban = '14768'      -- change to real wban after #1
  AND year = '2019'
LIMIT 20;
```

```sql
-- 4.  All distinct stn / wban pairs that have data Jan–Mar‑2019 and belong to Rochester
SELECT DISTINCT g.stn, g.wban
FROM   `bigquery-public-data.noaa_gsod.gsod2019` AS g
JOIN   `bigquery-public-data.noaa_gsod.stations` AS s
  ON   g.stn  = s.usaf
 AND   g.wban = s.wban
WHERE  LOWER(s.name) LIKE '%rochester%'
  AND  g.year = '2019'
  AND  g.mo   IN ('01','02','03')
LIMIT 20;
```

```sql
-- 5.  Convert °F ➜ °C for temperature (Jan–Mar 2019, Rochester)
SELECT
  DATE(CAST(year AS INT64), CAST(mo AS INT64), CAST(da AS INT64)) AS obs_date,
  ROUND( (temp - 32) * 5/9 , 1) AS temp_c
FROM `bigquery-public-data.noaa_gsod.gsod2019`
WHERE stn = '726320'
  AND wban = '14768'
  AND year = '2019'
  AND mo IN ('01','02','03')
  AND temp <> 9999.9
LIMIT 20;
```

```sql
-- 6.  Convert inches ➜ cm (precip) and knots ➜ m/s (wind)
SELECT
  DATE(CAST(year AS INT64), CAST(mo AS INT64), CAST(da AS INT64)) AS obs_date,
  ROUND( prcp * 2.54 , 1)          AS prcp_cm,
  ROUND( CAST(wdsp AS FLOAT64) * 0.514444 , 1) AS wind_ms
FROM `bigquery-public-data.noaa_gsod.gsod2019`
WHERE stn = '726320'
  AND wban = '14768'
  AND year = '2019'
  AND mo IN ('01','02','03')
  AND prcp <> 99.99
  AND CAST(wdsp AS FLOAT64) <> 999.9
LIMIT 20;
```

```sql
-- 7.  Calculate 8‑day moving average for temperature (needs window over date)
WITH base AS (
  SELECT
    DATE(CAST(year AS INT64), CAST(mo AS INT64), CAST(da AS INT64)) AS obs_date,
    ROUND( (temp - 32) * 5/9 , 1) AS temp_c
  FROM `bigquery-public-data.noaa_gsod.gsod2019`
  WHERE stn = '726320' AND wban = '14768'
    AND year = '2019' AND mo IN ('01','02','03')
    AND temp <> 9999.9
)
SELECT
  obs_date,
  temp_c,
  ROUND( AVG(temp_c) OVER (ORDER BY obs_date ROWS BETWEEN 7 PRECEDING AND CURRENT ROW) , 1) AS ma8_temp_c
FROM base
ORDER BY obs_date
LIMIT 20;
```

```sql
-- 8.  Same idea for precip & wind, plus temp, one CTE, three moving averages
WITH base AS (
  SELECT
    DATE(CAST(year AS INT64), CAST(mo AS INT64), CAST(da AS INT64)) AS obs_date,
    ROUND((temp - 32) * 5/9 , 1)                       AS temp_c,
    ROUND(prcp * 2.54 , 1)                             AS prcp_cm,
    ROUND(CAST(wdsp AS FLOAT64) * 0.514444 , 1)        AS wind_ms
  FROM `bigquery-public-data.noaa_gsod.gsod2019`
  WHERE stn = '726320' AND wban = '14768'
    AND year = '2019' AND mo IN ('01','02','03')
)
SELECT
  obs_date,
  temp_c,
  prcp_cm,
  wind_ms,
  ROUND(AVG(temp_c ) OVER w,1) AS ma8_temp_c,
  ROUND(AVG(prcp_cm) OVER w,1) AS ma8_prcp_cm,
  ROUND(AVG(wind_ms) OVER w,1) AS ma8_wind_ms
FROM base
WINDOW w AS (ORDER BY obs_date ROWS BETWEEN 7 PRECEDING AND CURRENT ROW)
ORDER BY obs_date
LIMIT 20;
```

```sql
-- 9.  Show moving‑average lag differences for temperature only
WITH base AS (
  SELECT
    DATE(CAST(year AS INT64), CAST(mo AS INT64), CAST(da AS INT64)) AS obs_date,
    ROUND((temp - 32) * 5/9 , 1) AS temp_c
  FROM `bigquery-public-data.noaa_gsod.gsod2019`
  WHERE stn = '726320' AND wban = '14768'
    AND year = '2019' AND mo IN ('01','02','03')
),
calc AS (
  SELECT
    obs_date,
    temp_c,
    ROUND(AVG(temp_c) OVER (ORDER BY obs_date ROWS BETWEEN 7 PRECEDING AND CURRENT ROW) ,1) AS ma8_temp_c
  FROM base
)
SELECT
  obs_date,
  temp_c,
  ma8_temp_c,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,1) OVER (ORDER BY obs_date),1) AS diff_lag1,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,2) OVER (ORDER BY obs_date),1) AS diff_lag2,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,3) OVER (ORDER BY obs_date),1) AS diff_lag3,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,4) OVER (ORDER BY obs_date),1) AS diff_lag4,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,5) OVER (ORDER BY obs_date),1) AS diff_lag5,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,6) OVER (ORDER BY obs_date),1) AS diff_lag6,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,7) OVER (ORDER BY obs_date),1) AS diff_lag7,
  ROUND(ma8_temp_c - LAG(ma8_temp_c,8) OVER (ORDER BY obs_date),1) AS diff_lag8
FROM calc
ORDER BY obs_date
LIMIT 20;
```

```sql
-- 10.  FINAL: Daily values, 8‑day moving averages, and lag‑1 … lag‑8 differences
--       for Temp (°C), Precip (cm), Wind (m/s) – output starts 2019‑01‑09
WITH base AS (
  SELECT
    DATE(CAST(year AS INT64), CAST(mo AS INT64), CAST(da AS INT64)) AS obs_date,
    ROUND((temp - 32) * 5/9 , 1)                AS temp_c,
    ROUND(prcp * 2.54 , 1)                      AS prcp_cm,
    ROUND(CAST(wdsp AS FLOAT64) * 0.514444 , 1) AS wind_ms
  FROM `bigquery-public-data.noaa_gsod.gsod2019`
  WHERE stn = '726320'  AND wban = '14768'
    AND year = '2019'   AND mo IN ('01','02','03')
),
ma AS (
  SELECT
    *,
    ROUND(AVG(temp_c ) OVER w ,1) AS ma8_temp_c,
    ROUND(AVG(prcp_cm) OVER w ,1) AS ma8_prcp_cm,
    ROUND(AVG(wind_ms) OVER w ,1) AS ma8_wind_ms
  FROM base
  WINDOW w AS (ORDER BY obs_date ROWS BETWEEN 7 PRECEDING AND CURRENT ROW)
),
lags AS (
  SELECT
    obs_date,
    temp_c, prcp_cm, wind_ms,
    ma8_temp_c, ma8_prcp_cm, ma8_wind_ms,
    -- Temperature lags
    ROUND(ma8_temp_c - LAG(ma8_temp_c,1) OVER (ORDER BY obs_date),1) AS temp_diff_lag1,
    ROUND(ma8_temp_c - LAG(ma8_temp_c,2) OVER (ORDER BY obs_date),1) AS temp_diff_lag2,
    ROUND(ma8_temp_c - LAG(ma8_temp_c,3) OVER (ORDER BY obs_date),1) AS temp_diff_lag3,
    ROUND(ma8_temp_c - LAG(ma8_temp_c,4) OVER (ORDER BY obs_date),1) AS temp_diff_lag4,
    ROUND(ma8_temp_c - LAG(ma8_temp_c,5) OVER (ORDER BY obs_date),1) AS temp_diff_lag5,
    ROUND(ma8_temp_c - LAG(ma8_temp_c,6) OVER (ORDER BY obs_date),1) AS temp_diff_lag6,
    ROUND(ma8_temp_c - LAG(ma8_temp_c,7) OVER (ORDER BY obs_date),1) AS temp_diff_lag7,
    ROUND(ma8_temp_c - LAG(ma8_temp_c,8) OVER (ORDER BY obs_date),1) AS temp_diff_lag8,
    -- Precipitation lags
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,1) OVER (ORDER BY obs_date),1) AS prcp_diff_lag1,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,2) OVER (ORDER BY obs_date),1) AS prcp_diff_lag2,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,3) OVER (ORDER BY obs_date),1) AS prcp_diff_lag3,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,4) OVER (ORDER BY obs_date),1) AS prcp_diff_lag4,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,5) OVER (ORDER BY obs_date),1) AS prcp_diff_lag5,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,6) OVER (ORDER BY obs_date),1) AS prcp_diff_lag6,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,7) OVER (ORDER BY obs_date),1) AS prcp_diff_lag7,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm,8) OVER (ORDER BY obs_date),1) AS prcp_diff_lag8,
    -- Wind lags
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms,1) OVER (ORDER BY obs_date),1) AS wind_diff_lag1,
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms,2) OVER (ORDER BY obs_date),1) AS wind_diff_lag2,
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms,3) OVER (ORDER BY obs_date),1) AS wind_diff_lag3,
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms,4) OVER (ORDER BY obs_date),1) AS wind_diff_lag4,
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms,5) OVER (ORDER BY obs_date),1) AS wind_diff_lag5,
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms,6) OVER (ORDER BY obs_date),1) AS wind_diff_lag6,
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms,7) OVER (ORDER BY obs_date),1) AS wind_diff_lag7,
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms,8) OVER (ORDER BY obs_date),1) AS wind_diff_lag8
  FROM ma
)
SELECT *
FROM lags
WHERE obs_date BETWEEN '2019-01-09' AND '2019-03-31'
ORDER BY obs_date
LIMIT 20;
```

