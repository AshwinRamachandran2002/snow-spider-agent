--Description:  #6 – Convert daily precipitation to cm and wind speed to m s‑¹
--              for Rochester, NY’s “GREATER ROCHESTER INTERNATIONAL” airport
--              during Jan–Mar 2019.  A first CTE (“target”) locates the station
--              code with the most 2019 records whose name matches “greater
--              rochester”.  The outer query joins to that code, converts units,
--              removes missing values, and lists the first 20 dates.
WITH target AS (
  SELECT g.stn, g.wban
  FROM `bigquery-public-data.noaa_gsod.gsod2019`  AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn  = s.usaf
   AND g.wban = s.wban
  WHERE LOWER(s.name) LIKE '%greater%rochester%'
    AND g.year = '2019'
  GROUP BY g.stn, g.wban
  ORDER BY COUNT(*) DESC
  LIMIT 1
)
SELECT
  DATE(CAST(g.year AS INT64),
       CAST(g.mo   AS INT64),
       CAST(g.da   AS INT64))                 AS obs_date,
  ROUND(g.prcp * 2.54, 1)                     AS prcp_cm,
  ROUND(CAST(g.wdsp AS FLOAT64) * 0.514444, 1) AS wind_ms
FROM `bigquery-public-data.noaa_gsod.gsod2019` AS g
JOIN target t
  ON g.stn = t.stn
 AND g.wban = t.wban
WHERE g.year = '2019'
  AND g.mo IN ('01', '02', '03')
  AND g.prcp <> 99.99
  AND CAST(g.wdsp AS FLOAT64) <> 999.9
ORDER BY obs_date
LIMIT 20
