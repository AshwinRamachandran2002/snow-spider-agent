--Description:  #10 – FINAL query: daily values, 8‑day moving averages, and
--              lag‑1…lag‑8 differences for temperature (°C), precipitation (cm),
--              and wind (m s‑¹) for Rochester airport, 2019‑01‑01 through 03‑31.
WITH target AS (
  SELECT stn, wban
  FROM `bigquery-public-data.noaa_gsod.gsod2019` g
  JOIN `bigquery-public-data.noaa_gsod.stations` s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE LOWER(s.name) LIKE '%monroe co%'
    AND g.year = '2019'
  GROUP BY stn, wban
  ORDER BY COUNT(*) DESC
  LIMIT 1
),
base AS (
  SELECT
    DATE(CAST(year AS INT64), CAST(mo AS INT64), CAST(da AS INT64)) AS obs_date,
    ROUND((temp - 32) * 5/9, 1)                AS temp_c,
    ROUND(prcp * 2.54, 1)                      AS prcp_cm,
    ROUND(CAST(wdsp AS FLOAT64) * 0.514444, 1) AS wind_ms
  FROM `bigquery-public-data.noaa_gsod.gsod2019` g
  JOIN target USING (stn, wban)
  WHERE g.year = '2019'
    AND g.mo IN ('01','02','03')
),
ma AS (
  SELECT
    *,
    ROUND(AVG(temp_c ) OVER w, 1) AS ma8_temp_c,
    ROUND(AVG(prcp_cm) OVER w, 1) AS ma8_prcp_cm,
    ROUND(AVG(wind_ms) OVER w, 1) AS ma8_wind_ms
  FROM base
  WINDOW w AS (ORDER BY obs_date ROWS BETWEEN 7 PRECEDING AND CURRENT ROW)
),
lags AS (
  SELECT
    obs_date,
    temp_c, prcp_cm, wind_ms,
    ma8_temp_c, ma8_prcp_cm, ma8_wind_ms,
    -- temp diffs
    ROUND(ma8_temp_c - LAG(ma8_temp_c, 1) OVER (ORDER BY obs_date), 1) AS temp_diff_lag1,
    ROUND(ma8_temp_c - LAG(ma8_temp_c, 2) OVER (ORDER BY obs_date), 1) AS temp_diff_lag2,
    ROUND(ma8_temp_c - LAG(ma8_temp_c, 3) OVER (ORDER BY obs_date), 1) AS temp_diff_lag3,
    ROUND(ma8_temp_c - LAG(ma8_temp_c, 4) OVER (ORDER BY obs_date), 1) AS temp_diff_lag4,
    ROUND(ma8_temp_c - LAG(ma8_temp_c, 5) OVER (ORDER BY obs_date), 1) AS temp_diff_lag5,
    ROUND(ma8_temp_c - LAG(ma8_temp_c, 6) OVER (ORDER BY obs_date), 1) AS temp_diff_lag6,
    ROUND(ma8_temp_c - LAG(ma8_temp_c, 7) OVER (ORDER BY obs_date), 1) AS temp_diff_lag7,
    ROUND(ma8_temp_c - LAG(ma8_temp_c, 8) OVER (ORDER BY obs_date), 1) AS temp_diff_lag8,
    -- precip diffs
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm, 1) OVER (ORDER BY obs_date), 1) AS prcp_diff_lag1,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm, 2) OVER (ORDER BY obs_date), 1) AS prcp_diff_lag2,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm, 3) OVER (ORDER BY obs_date), 1) AS prcp_diff_lag3,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm, 4) OVER (ORDER BY obs_date), 1) AS prcp_diff_lag4,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm, 5) OVER (ORDER BY obs_date), 1) AS prcp_diff_lag5,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm, 6) OVER (ORDER BY obs_date), 1) AS prcp_diff_lag6,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm, 7) OVER (ORDER BY obs_date), 1) AS prcp_diff_lag7,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm, 8) OVER (ORDER BY obs_date), 1) AS prcp_diff_lag8,
    -- wind diffs
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms, 1) OVER (ORDER BY obs_date), 1) AS wind_diff_lag1,
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms, 2) OVER (ORDER BY obs_date), 1) AS wind_diff_lag2,
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms, 3) OVER (ORDER BY obs_date), 1) AS wind_diff_lag3,
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms, 4) OVER (ORDER BY obs_date), 1) AS wind_diff_lag4,
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms, 5) OVER (ORDER BY obs_date), 1) AS wind_diff_lag5,
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms, 6) OVER (ORDER BY obs_date), 1) AS wind_diff_lag6,
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms, 7) OVER (ORDER BY obs_date), 1) AS wind_diff_lag7,
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms, 8) OVER (ORDER BY obs_date), 1) AS wind_diff_lag8
  FROM ma
)
SELECT *
FROM lags
WHERE obs_date BETWEEN '2019-01-09' AND '2019-03-31'
ORDER BY obs_date
LIMIT 20;
