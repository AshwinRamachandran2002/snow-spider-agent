-- 1) We need Rochester weather data for 2019; first we must learn which station
--    identifiers (stn / wban) actually HAVE 2019 observations.
-- 2) The metadata table `stations` contains every station name; the daily
--    observations for 2019 live in `gsod2019`.
-- 3) By joining gsod2019 ↔ stations on (usaf = stn) AND (wban), and keeping
--    ONLY names that contain “rochester”, we can see which station‑code pairs
--    appear in the 2019 data set.
-- 4) We SELECT DISTINCT pairs so each station is listed once.
-- 5) The result will guide all later queries (temperature, precip, etc.).
-------------------------------------------------------------------------------

SELECT DISTINCT
  g.stn,                        -- USAF identifier in daily table
  g.wban,                       -- WBAN identifier in daily table
  TRIM(s.name) AS station_name, -- cleaned‑up station name
  s.state,
