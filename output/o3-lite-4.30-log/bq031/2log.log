    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm, 5) OVER (ORDER BY obs_date), 1) AS prcp_diff_lag5,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm, 6) OVER (ORDER BY obs_date), 1) AS prcp_diff_lag6,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm, 7) OVER (ORDER BY obs_date), 1) AS prcp_diff_lag7,
    ROUND(ma8_prcp_cm - LAG(ma8_prcp_cm, 8) OVER (ORDER BY obs_date), 1) AS prcp_diff_lag8,
    -- wind diffs
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms, 1) OVER (ORDER BY obs_date), 1) AS wind_diff_lag1,
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms, 2) OVER (ORDER BY obs_date), 1) AS wind_diff_lag2,
    ROUND(ma8_wind_ms - LAG(ma8_wind_ms, 3) OVER (ORDER BY obs_date), 1) AS wind_diff_lag3,
