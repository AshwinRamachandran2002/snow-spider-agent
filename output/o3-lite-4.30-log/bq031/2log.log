```sql
--Description:  Compute the 8‑day moving average of mean temperature (°C)
--              for Rochester, NY’s “GREATER ROCHESTER INTERNATIONAL” airport
--              during Jan–Mar 2019.  
--              • CTE “target” automatically finds the (stn, wban) pair for that
--                airport by matching the station name and choosing the one with
--                the most 2019 records.  
--              • CTE “base” converts daily mean temperature from °F to °C and
--                keeps only valid values.  
--              • The final SELECT adds the 8‑day moving average (current day
--                plus previous 7 days) using a window function and lists the
--                first 20 rows chronologically.

WITH target AS (
  SELECT
    g.stn  AS stn,
    g.wban AS wban
  FROM `bigquery-public-data.noaa_gsod.gsod2019`  AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn  = s.usaf
   AND g.wban = s.wban
  WHERE LOWER(s.name) LIKE '%greater%rochester%'   -- airport identifier
    AND g.year = '2019'
  GROUP BY g.stn, g.wban
  ORDER BY COUNT(*) DESC                           -- most complete series
  LIMIT 1
),
base AS (
  SELECT
    DATE(CAST(g.year AS INT64),
         CAST(g.mo   AS INT64),
         CAST(g.da   AS INT64))             AS obs_date,
    ROUND((g.temp - 32) * 5/9, 1)           AS temp_c
  FROM `bigquery-public-data.noaa_gsod.gsod2019` AS g
  JOIN target t
    ON g.stn = t.stn
   AND g.wban = t.wban
  WHERE g.year = '2019'
    AND g.mo IN ('01', '02', '03')
    AND g.temp <> 9999.9                    -- exclude missing temperature
)
SELECT
  obs_date,
  temp_c,
  ROUND(
    AVG(temp_c) OVER (ORDER BY obs_date ROWS BETWEEN 7 PRECEDING AND CURRENT ROW)
  , 1)                                       AS ma8_temp_c
FROM base
