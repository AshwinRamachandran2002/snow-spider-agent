--Description:  #10 – FINAL: daily values, 8‑day moving averages, and lag‑1…lag‑8
--              differences for temperature (°C), precipitation (cm), and wind
--              (m s‑¹) for Rochester’s main airport; output covers 2019‑01‑09
--              through 2019‑03‑31.
WITH target AS (
  SELECT g.stn, g.wban
  FROM `bigquery-public-data.noaa_gsod.gsod2019` g
  JOIN `bigquery-public-data.noaa_gsod.stations`  s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE LOWER(s.name) LIKE '%greater%rochester%'
    AND g.year = '2019'
  GROUP BY g.stn, g.wban
  ORDER BY COUNT(*) DESC
  LIMIT 1
),
base AS (
  SELECT
    DATE(CAST(g.year AS INT64),
         CAST(g.mo   AS INT64),
         CAST(g.da   AS INT64))            AS obs_date,
    ROUND((g.temp - 32) * 5/9, 1)          AS temp_c,
    ROUND(g.prcp * 2.54, 1)                AS prcp_cm,
    ROUND(CAST(g.wdsp AS FLOAT64) * 0.514444, 1) AS wind_ms
  FROM `bigquery-public-data.noaa_gsod.gsod2019` AS g
  JOIN target t ON g.stn = t.stn AND g.wban = t.wban
  WHERE g.year = '2019'
    AND g.mo IN ('01', '02', '03')
),
ma AS (
  SELECT
    *,
    ROUND(AVG(temp_c ) OVER w, 1) AS ma8_temp_c,
    ROUND(AVG(prcp_cm) OVER w, 1) AS ma8_prcp_cm,
    ROUND(AVG(wind_ms) OVER w, 1) AS ma8_wind_ms
  FROM base
  WINDOW w AS (ORDER BY obs_date ROWS BETWEEN 7 PRECEDING AND CURRENT ROW)
),
lags AS (
  SELECT
    obs_date,
