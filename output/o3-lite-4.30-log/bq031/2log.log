```sql
--Description:  #4 – List every Rochester‑named station that truly has daily data
--              during Jan–Mar 2019 (gives the valid stn / wban codes).
SELECT DISTINCT
  g.stn,
  g.wban,
  TRIM(s.name) AS station_name,
  s.state,
  s.country
FROM `bigquery-public-data.noaa_gsod.gsod2019`  AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn = s.usaf AND g.wban = s.wban
WHERE LOWER(s.name) LIKE '%rochester%'
  AND g.year = '2019'
  AND g.mo IN ('01','02','03')
LIMIT 20;
```

```sql
--Description:  #5 – Convert daily temperature to °C for the Rochester airport
--              (Monroe County); the target station is selected automatically.
WITH target AS (
  SELECT stn, wban
  FROM `bigquery-public-data.noaa_gsod.gsod2019` g
  JOIN `bigquery-public-data.noaa_gsod.stations` s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE LOWER(s.name) LIKE '%monroe co%'      -- Rochester Monroe County Arpt
    AND g.year = '2019'
  GROUP BY stn, wban
  ORDER BY COUNT(*) DESC                      -- pick the one with most rows
  LIMIT 1
)
SELECT
  DATE(CAST(year AS INT64), CAST(mo AS INT64), CAST(da AS INT64)) AS obs_date,
  ROUND((temp - 32) * 5/9, 1) AS temp_c
FROM `bigquery-public-data.noaa_gsod.gsod2019` g
JOIN target USING (stn, wban)
WHERE g.year = '2019'
  AND g.mo IN ('01','02','03')
  AND temp <> 9999.9
ORDER BY obs_date
LIMIT 20;
```

```sql
