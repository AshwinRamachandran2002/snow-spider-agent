JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn  = s.usaf
 AND g.wban = s.wban
WHERE LOWER(s.name) LIKE '%rochester%'   -- focus on Rochester locations
  AND g.year = '2019'                    -- restrict to year 2019
LIMIT 20;
