WITH date_bounds AS (
    /*  Today assumed to be 2024‑04‑01 → previous year = 2023
        First two full weeks (14 days) are skipped; we then take the next 7‑day span. */
    SELECT
        DATEADD(
            day, 14,
            DATE_FROM_PARTS(YEAR('2024-04-01'::DATE) - 1, 1, 1)
        )                                         AS week_start,        -- 2023‑01‑15
        DATEADD(
            day, 20,
            DATE_FROM_PARTS(YEAR('2024-04-01'::DATE) - 1, 1, 1)
        )                                         AS week_end          -- 2023‑01‑21
)
