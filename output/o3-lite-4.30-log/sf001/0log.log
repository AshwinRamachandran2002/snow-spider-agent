WITH week_window AS (
    /* ----------------------------------------------------------
       Calculate the Monday‑to‑Sunday week that ENDS right after
       the first two complete weeks of the previous year.
       (Assuming “today” is 2024‑04‑01)
       ---------------------------------------------------------- */
    SELECT
        /* first day of previous year */
        DATE_TRUNC('YEAR', DATEADD('YEAR', -1, CURRENT_DATE()))                         AS yr_start,
        /* start of first full week (Monday) */
        DATE_TRUNC('WEEK', DATE_TRUNC('YEAR', DATEADD('YEAR', -1, CURRENT_DATE())))     AS wk1_start,
        /* start of 3rd week = wk1_start + 2 weeks */
        DATEADD('WEEK', 2, DATE_TRUNC('WEEK', DATE_TRUNC('YEAR',
                 DATEADD('YEAR', -1, CURRENT_DATE()))))                                AS wk3_start
)
SELECT
    "POSTAL_CODE"                                     AS postal_code,
    TO_CHAR("DATE_VALID_STD", 'YYYY-MM-DD')           AS date,
    TO_DECIMAL("TOT_SNOWFALL_IN", 10, 4)              AS snowfall_inches
FROM GLOBAL_WEATHER__CLIMATE_DATA_FOR_BI.STANDARD_TILE."HISTORY_DAY"
JOIN week_window
  ON "DATE_VALID_STD" BETWEEN wk3_start AND DATEADD('DAY', 6, wk3_start)  -- Monday‑Sunday of 3rd week
WHERE "COUNTRY" = 'US'
  AND "TOT_SNOWFALL_IN" > 6
ORDER BY
    "DATE_VALID_STD",
    "POSTAL_CODE";
