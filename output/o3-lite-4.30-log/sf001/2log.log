```sql
WITH date_params AS (
    /*  Previous year starts on 1 Jan of last year; skip the first two full weeks (14 days)
        and capture the seven‑day window that follows.  */
    SELECT
        DATEADD(
            day,
            14,
            DATE_TRUNC('week', DATEADD(year, -1, CURRENT_DATE()))
        )                         AS week_start ,          -- 2023‑01‑15
        DATEADD(
            day,
            20,
            DATE_TRUNC('week', DATEADD(year, -1, CURRENT_DATE()))
        )                         AS week_end             -- 2023‑01‑21
),
source_union AS (
    /*  Combine history and forecast tables first, as required  */
    SELECT "POSTAL_CODE",
           "DATE_VALID_STD",
           "TOT_SNOWFALL_IN",
           "COUNTRY"
    FROM "GLOBAL_WEATHER__CLIMATE_DATA_FOR_BI"."STANDARD_TILE"."HISTORY_DAY"
    
    UNION ALL
    
    SELECT "POSTAL_CODE",
           "DATE_VALID_STD",
           "TOT_SNOWFALL_IN",
           "COUNTRY"
    FROM "GLOBAL_WEATHER__CLIMATE_DATA_FOR_BI"."STANDARD_TILE"."FORECAST_DAY"
)
SELECT
    su."POSTAL_CODE"       AS postal_code,
    su."DATE_VALID_STD"    AS date,
    su."TOT_SNOWFALL_IN"   AS snowfall_inches
FROM source_union su
JOIN date_params dp
  ON su."DATE_VALID_STD" BETWEEN dp.week_start AND dp.week_end
WHERE su."COUNTRY" = 'US'
  AND su."TOT_SNOWFALL_IN" > 6          -- snowfall greater than 6 inches
ORDER BY postal_code, date;
```
