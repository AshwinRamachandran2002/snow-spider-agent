SELECT DISTINCT "DOY_STD"
FROM   "GLOBAL_WEATHER__CLIMATE_DATA_FOR_BI"."STANDARD_TILE"."HISTORY_DAY"
WHERE  "DATE_VALID_STD" BETWEEN '2023-01-15' AND '2023-01-21'
ORDER  BY "DOY_STD"
LIMIT 20;
```

```sql
-- 6. Description: Same third week but using DOY_STD (15‑21) to verify equivalence
