2025-05-01 03:40:26 - Thread-1572 (execute) - INFO - [Exploration]
Relevant columns and why they matter  
• "TOT_SNOWFALL_IN": daily snowfall amount – metric we need (> 6 inches)  
• "DATE_VALID_STD": calendar date – lets us isolate the exact week (2023‑01‑15 ↔ 2023‑01‑21)  
• "DOY_STD": day–of‑year – alternate way to bracket the same week (15–21)  
• "POSTAL_CODE": ZIP – the geographic key requested  
• "COUNTRY": filter to 'US' so only U.S. ZIP codes are returned  

---------------------------------------------------------------------------  
Ten exploratory → final Snowflake SQL statements  
(every query is different, shows at most 20 rows, and all identifiers are double‑quoted)

```sql
-- 1. Description: Peek at how snowfall values look in the history table
SELECT "POSTAL_CODE",
       "DATE_VALID_STD",
       "TOT_SNOWFALL_IN"
FROM "GLOBAL_WEATHER__CLIMATE_DATA_FOR_BI"."STANDARD_TILE"."HISTORY_DAY"
LIMIT 20;
```

```sql
-- 2. Description: Find the range of years we have in the history table
SELECT DISTINCT YEAR("DATE_VALID_STD") AS "YEAR"
FROM "GLOBAL_WEATHER__CLIMATE_DATA_FOR_BI"."STANDARD_TILE"."HISTORY_DAY"
ORDER BY "YEAR"
LIMIT 20;
```

```sql
-- 3. Description: Quick snowfall snapshot for January 2023 only
SELECT "POSTAL_CODE",
       "DATE_VALID_STD",
       "TOT_SNOWFALL_IN"
FROM   "GLOBAL_WEATHER__CLIMATE_DATA_FOR_BI"."STANDARD_TILE"."HISTORY_DAY"
WHERE  "DATE_VALID_STD" BETWEEN '2023-01-01' AND '2023-01-31'
ORDER  BY "DATE_VALID_STD"
LIMIT 20;
```

```sql
-- 4. Description: Show all U.S. rows where daily snowfall exceeded 6 inches any time in 2023
SELECT "POSTAL_CODE",
       "DATE_VALID_STD",
       "TOT_SNOWFALL_IN"
FROM   "GLOBAL_WEATHER__CLIMATE_DATA_FOR_BI"."STANDARD_TILE"."HISTORY_DAY"
WHERE  "COUNTRY" = 'US'
  AND  "TOT_SNOWFALL_IN" > 6
  AND  YEAR("DATE_VALID_STD") = 2023
ORDER  BY "TOT_SNOWFALL_IN" DESC
LIMIT 20;
```

```sql
-- 5. Description: Pull distinct day‑of‑year values for the third week of 2023
SELECT DISTINCT "DOY_STD"
FROM   "GLOBAL_WEATHER__CLIMATE_DATA_FOR_BI"."STANDARD_TILE"."HISTORY_DAY"
WHERE  "DATE_VALID_STD" BETWEEN '2023-01-15' AND '2023-01-21'
ORDER  BY "DOY_STD"
LIMIT 20;
```

```sql
-- 6. Description: Same third week but using DOY_STD (15‑21) to verify equivalence
SELECT "POSTAL_CODE",
       "DATE_VALID_STD",
       "TOT_SNOWFALL_IN"
FROM   "GLOBAL_WEATHER__CLIMATE_DATA_FOR_BI"."STANDARD_TILE"."HISTORY_DAY"
WHERE  "COUNTRY" = 'US'
  AND  "DOY_STD" BETWEEN 15 AND 21
  AND  YEAR("DATE_VALID_STD") = 2023
ORDER  BY "DATE_VALID_STD"
LIMIT 20;
```

```sql
-- 7. Description: Distinct ZIP codes that saw > 6" in the target week
SELECT DISTINCT "POSTAL_CODE"
FROM   "GLOBAL_WEATHER__CLIMATE_DATA_FOR_BI"."STANDARD_TILE"."HISTORY_DAY"
WHERE  "COUNTRY" = 'US'
  AND  "DATE_VALID_STD" BETWEEN '2023-01-15' AND '2023-01-21'
  AND  "TOT_SNOWFALL_IN" > 6
LIMIT 20;
```

```sql
-- 8. Description: How many heavy‑snow (>6") days each ZIP had in that week
SELECT "POSTAL_CODE",
       COUNT(*) AS "DAYS_HEAVY_SNOW"
FROM   "GLOBAL_WEATHER__CLIMATE_DATA_FOR_BI"."STANDARD_TILE"."HISTORY_DAY"
WHERE  "COUNTRY" = 'US'
  AND  "DATE_VALID_STD" BETWEEN '2023-01-15' AND '2023-01-21'
  AND  "TOT_SNOWFALL_IN" > 6
GROUP  BY "POSTAL_CODE"
ORDER  BY "DAYS_HEAVY_SNOW" DESC
LIMIT 20;
```

```sql
-- 9. Description: Top 20 heaviest single‑day snowfalls in that week
SELECT "POSTAL_CODE",
       "DATE_VALID_STD",
       "TOT_SNOWFALL_IN"
FROM   "GLOBAL_WEATHER__CLIMATE_DATA_FOR_BI"."STANDARD_TILE"."HISTORY_DAY"
WHERE  "COUNTRY" = 'US'
  AND  "DATE_VALID_STD" BETWEEN '2023-01-15' AND '2023-01-21'
ORDER  BY "TOT_SNOWFALL_IN" DESC
LIMIT 20;
```

```sql
-- 10. Description: FINAL ANSWER – every U.S. ZIP, date and snowfall > 6" 
--                  for the week ending after the first two full weeks of 2023
SELECT "POSTAL_CODE",
       "DATE_VALID_STD",
       "TOT_SNOWFALL_IN"
FROM   "GLOBAL_WEATHER__CLIMATE_DATA_FOR_BI"."STANDARD_TILE"."HISTORY_DAY"
WHERE  "COUNTRY" = 'US'
  AND  "DATE_VALID_STD" BETWEEN '2023-01-15' AND '2023-01-21'
  AND  "TOT_SNOWFALL_IN" > 6
ORDER  BY "POSTAL_CODE", "DATE_VALID_STD"
LIMIT 20;
```
