```sql
WITH week_range AS (
    /* Determine the week that ENDS after the first two full weeks of last year.
       – Take January 1 of the previous year.
       – Truncate to the Monday that begins the ISO‑week containing Jan 1.
       – Add 3 weeks → Monday of the 3rd full week.
       – The target week is Monday‑Sunday of that week. */
    SELECT
        DATEADD(
            week,
            3,
            DATE_TRUNC(
                'week',
                DATE_FROM_PARTS(YEAR(CURRENT_DATE()) - 1, 1, 1)
            )
        )                                       AS week_start,          -- e.g., 2023‑01‑16
        DATEADD(
            day,
            6,
            DATEADD(
                week,
                3,
                DATE_TRUNC(
                    'week',
                    DATE_FROM_PARTS(YEAR(CURRENT_DATE()) - 1, 1, 1)
                )
            )
        )                                       AS week_end            -- e.g., 2023‑01‑22
)
SELECT
    "POSTAL_CODE"      AS postal_code,
    "DATE_VALID_STD"   AS date,
    "TOT_SNOWFALL_IN"  AS snowfall_inches
FROM "GLOBAL_WEATHER__CLIMATE_DATA_FOR_BI"."STANDARD_TILE"."HISTORY_DAY" hd
JOIN week_range wr
  ON hd."DATE_VALID_STD" BETWEEN wr.week_start AND wr.week_end
WHERE hd."COUNTRY" = 'US'
  AND hd."TOT_SNOWFALL_IN" > 6             -- snowfall greater than 6 inches
ORDER BY postal_code, date;
```
