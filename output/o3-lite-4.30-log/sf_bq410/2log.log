[{'state': 'Alabama', 'postal_code': 'AL', 'fips': 1}, {'state': 'Arkansas', 'postal_code': 'AR', 'fips': 5}, {'state': 'Hawaii', 'postal_code': 'HI', 'fips': 15}, {'state': 'Idaho', 'postal_code': 'ID', 'fips': 16}, {'state': 'Illinois', 'postal_code': 'IL', 'fips': 17}]

