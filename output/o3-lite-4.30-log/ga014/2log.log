    WHEN source = '(direct)' AND medium IN ('(not set)', '(none)')           THEN 'Direct'
    WHEN medium = 'referral'                                                THEN 'Referral'
    WHEN REGEXP_CONTAINS(medium, r'^(cpc|ppc|paid.*)$')                      THEN 'Paid Search'
    WHEN REGEXP_CONTAINS(medium, r'display|banner|cpm')                      THEN 'Display'
    WHEN REGEXP_CONTAINS(source, r'(facebook|instagram|linkedin|pinterest|tiktok|twitter|whatsapp|badoo)')
         AND NOT REGEXP_CONTAINS(medium, r'^(cpc|ppc|paid.*)$')              THEN 'Organic Social'
    ELSE 'Unassigned'
  END AS channel_group,
  COUNT(DISTINCT session_key) AS sessions
FROM dec_sessions
GROUP BY channel_group
ORDER BY sessions DESC;
