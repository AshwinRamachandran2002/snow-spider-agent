/* ---------- one row per GA4 session ---------- */
sessions AS (
  SELECT
    -- unique session identifier (user_pseudo_id + ga_session_id)
    CONCAT(
      user_pseudo_id, '-',
      CAST((
        SELECT ep.value.int_value
        FROM   UNNEST(event_params) AS ep
        WHERE  ep.key = 'ga_session_id'
      ) AS STRING)
    )                                             AS session_key,

    LOWER(
      COALESCE(
        (SELECT ep.value.string_value
         FROM   UNNEST(event_params) ep
         WHERE  ep.key = 'source'),
        traffic_source.source)
    )                                             AS source,

    LOWER(
      COALESCE(
        (SELECT ep.value.string_value
         FROM   UNNEST(event_params) ep
         WHERE  ep.key = 'medium'),
        traffic_source.medium)
    )                                             AS medium
  FROM dec2020
  WHERE event_name = 'session_start'              -- exactly one event per session
),

/* ---------- map to traffic‑channel grouping ---------- */
classified AS (
  SELECT
    CASE
      WHEN source = '(direct)'
           AND medium IN ('(not set)', '(none)')                            THEN 'Direct'
      WHEN medium = 'referral'                                              THEN 'Referral'
      WHEN REGEXP_CONTAINS(medium, r'^(cpc|ppc|paid.*)$')                   THEN 'Paid Search'
      WHEN REGEXP_CONTAINS(medium, r'display|banner|cpm')                   THEN 'Display'
      WHEN REGEXP_CONTAINS(source,
             r'(facebook|instagram|linkedin|pinterest|tiktok|twitter|whatsapp|badoo)')
           AND NOT REGEXP_CONTAINS(medium, r'^(cpc|ppc|paid.*)$')           THEN 'Organic Social'
      ELSE 'Unassigned'
    END AS traffic_channel,
    session_key
  FROM sessions
)

/* ---------- final result ---------- */
SELECT
  traffic_channel,
  COUNT(DISTINCT session_key) AS total_sessions
FROM classified
GROUP BY traffic_channel
ORDER BY total_sessions DESC;
