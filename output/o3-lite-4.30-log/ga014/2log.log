--Description: FINAL – total number of December 2020 GA4 sessions by traffic channel
-- Fix: bring source / medium into scope first (CTE), then map to channel group and count sessions.
WITH dec_sessions AS (
  SELECT
    -- unique identifier for every session
    CONCAT(
      user_pseudo_id, '-',
      CAST((
        SELECT ep.value.int_value
        FROM   UNNEST(event_params) AS ep
        WHERE  ep.key = 'ga_session_id'
      ) AS STRING)
    ) AS session_key,

    -- source (event‑level first, then user‑level fallback)
    LOWER(COALESCE(
      (SELECT ep.value.string_value
       FROM   UNNEST(event_params) ep
       WHERE  ep.key = 'source'),
      traffic_source.source))  AS source,

    -- medium (event‑level first, then user‑level fallback)
    LOWER(COALESCE(
      (SELECT ep.value.string_value
       FROM   UNNEST(event_params) ep
       WHERE  ep.key = 'medium'),
      traffic_source.medium))  AS medium
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE event_name = 'session_start'          -- one row per session
)

SELECT
  CASE
    WHEN source = '(direct)' AND medium IN ('(not set)', '(none)')           THEN 'Direct'
    WHEN medium = 'referral'                                                THEN 'Referral'
    WHEN REGEXP_CONTAINS(medium, r'^(cpc|ppc|paid.*)$')                      THEN 'Paid Search'
    WHEN REGEXP_CONTAINS(medium, r'display|banner|cpm')                      THEN 'Display'
    WHEN REGEXP_CONTAINS(source, r'(facebook|instagram|linkedin|pinterest|tiktok|twitter|whatsapp|badoo)')
         AND NOT REGEXP_CONTAINS(medium, r'^(cpc|ppc|paid.*)$')              THEN 'Organic Social'
    ELSE 'Unassigned'
  END AS channel_group,
  COUNT(DISTINCT session_key) AS sessions
FROM dec_sessions
GROUP BY channel_group
ORDER BY sessions DESC
