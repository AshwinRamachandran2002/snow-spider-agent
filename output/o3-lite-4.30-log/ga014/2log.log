```sql
-- 9) Description: Sessions by channel group on Christmas Day 2020
SELECT
  channel_group,
  COUNT(DISTINCT session_key) AS sessions
FROM (
  SELECT
    CONCAT(user_pseudo_id,'-',CAST(
      (SELECT ep.value.int_value FROM UNNEST(event_params) ep WHERE ep.key = 'ga_session_id')
    AS STRING))                                             AS session_key,
    CASE
      WHEN source = '(direct)' AND medium IN ('(not set)', '(none)')        THEN 'Direct'
      WHEN medium = 'referral'                                             THEN 'Referral'
      WHEN REGEXP_CONTAINS(medium, r'^(cpc|ppc|paid.*)$')                  THEN 'Paid Search'
      WHEN REGEXP_CONTAINS(medium, r'display|banner|cpm')                  THEN 'Display'
      ELSE 'Unassigned'
    END AS channel_group
  FROM (
    SELECT
      user_pseudo_id,
      (SELECT ep.value.int_value   FROM UNNEST(event_params) ep WHERE ep.key = 'ga_session_id') AS ga_session_id,
      LOWER(COALESCE((SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'source'),
                     traffic_source.source))                                                    AS source,
      LOWER(COALESCE((SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'medium'),
                     traffic_source.medium))                                                    AS medium
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201225`
    WHERE event_name = 'session_start'
  )
)
GROUP BY channel_group
LIMIT 20;
```

```sql
--10) Description: FINAL – total number of December 2020 sessions by traffic channel (all 31 daily tables)
SELECT
  channel_group,
  COUNT(DISTINCT session_key) AS sessions
FROM (
  SELECT
    CONCAT(user_pseudo_id,'-',CAST(
        (SELECT ep.value.int_value FROM UNNEST(event_params) ep WHERE ep.key = 'ga_session_id')
      AS STRING)) AS session_key,
    CASE
      WHEN source = '(direct)' AND medium IN ('(not set)', '(none)')                                    THEN 'Direct'
      WHEN medium = 'referral'                                                                         THEN 'Referral'
      WHEN REGEXP_CONTAINS(medium, r'^(cpc|ppc|paid.*)$')                                              THEN 'Paid Search'
      WHEN REGEXP_CONTAINS(medium, r'display|banner|cpm')                                              THEN 'Display'
      WHEN REGEXP_CONTAINS(medium, r'social|facebook|instagram|twitter|linkedin|pinterest|tiktok') 
           AND NOT REGEXP_CONTAINS(medium, r'^(cpc|ppc|paid.*)$')                                       THEN 'Organic Social'
      ELSE 'Unassigned'
    END AS channel_group
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE event_name = 'session_start'
)
GROUP BY channel_group
LIMIT 20;
```

