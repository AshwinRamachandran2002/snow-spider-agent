--Description: FINAL – total number of December 2020 GA4 sessions by traffic channel
-- Fix: bring source / medium into scope first (CTE), then map to channel group and count sessions.
WITH dec_sessions AS (
  SELECT
    -- unique identifier for every session
    CONCAT(
      user_pseudo_id, '-',
      CAST((
        SELECT ep.value.int_value
        FROM   UNNEST(event_params) AS ep
        WHERE  ep.key = 'ga_session_id'
      ) AS STRING)
    ) AS session_key,

    -- source (event‑level first, then user‑level fallback)
    LOWER(COALESCE(
      (SELECT ep.value.string_value
       FROM   UNNEST(event_params) ep
