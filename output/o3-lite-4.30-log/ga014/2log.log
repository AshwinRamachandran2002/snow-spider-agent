```sql
--Description ─ Thinking process embedded as comments
-- Goal:  Count distinct GA4 sessions for every traffic‑channel in December 2020.
-- Steps
-- ①  Read all December tables via events_202012* wildcard.
-- ②  Keep only the “session_start” event (one record per session).
-- ③  Extract ga_session_id from the repeated event_params array.
-- ④  Extract source / medium the same way; if they don’t exist at event level
--     fall back to the user‑level traffic_source.* fields (COALESCE).
-- ⑤  Build a unique session_key = user_pseudo_id ‑ ga_session_id to avoid duplicates.
-- ⑥  Translate (source, medium) pairs into Channel Groups with a CASE expression
--     (basic version: Direct, Referral, Paid Search, Display, otherwise Unassigned).
-- ⑦  Aggregate by channel_group and count DISTINCT session_key values.

WITH dec_sessions AS (
  SELECT
    CONCAT(
      user_pseudo_id, '-',
      CAST((
        SELECT ep.value.int_value
        FROM   UNNEST(event_params) AS ep
        WHERE  ep.key = 'ga_session_id'
      ) AS STRING)
    ) AS session_key,

    LOWER(COALESCE(
      (SELECT ep.value.string_value
       FROM   UNNEST(event_params) AS ep
       WHERE  ep.key = 'source'),
      traffic_source.source))     AS source,

    LOWER(COALESCE(
      (SELECT ep.value.string_value
       FROM   UNNEST(event_params) AS ep
       WHERE  ep.key = 'medium'),
      traffic_source.medium))     AS medium
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE event_name = 'session_start'
)

SELECT
  CASE
    WHEN source = '(direct)' AND medium IN ('(not set)', '(none)')          THEN 'Direct'
    WHEN medium = 'referral'                                               THEN 'Referral'
    WHEN REGEXP_CONTAINS(medium, r'^(cpc|ppc|paid.*)$')                    THEN 'Paid Search'
    WHEN REGEXP_CONTAINS(medium, r'display|banner|cpm')                    THEN 'Display'
    ELSE 'Unassigned'
  END AS channel_group,
  COUNT(DISTINCT session_key) AS sessions
FROM dec_sessions
GROUP BY channel_group
ORDER BY sessions DESC;
```
