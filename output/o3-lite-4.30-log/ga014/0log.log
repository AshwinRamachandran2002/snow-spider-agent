),

resolved_sessions AS (
  SELECT
    -- unique session identifier
    CONCAT(user_pseudo_id, '-', CAST(ga_session_id AS STRING)) AS session_key,
    -- resolved source & medium (traffic_source.* first, else event_params)
    COALESCE(traffic_source.source,
             (SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'source')
            ) AS source,
    COALESCE(traffic_source.medium,
             (SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'medium')
            ) AS medium
  FROM session_events
  -- pull ga_session_id from nested params
  CROSS JOIN (
    SELECT ep.value.int_value AS ga_session_id
    FROM UNNEST(event_params) ep
    WHERE ep.key = 'ga_session_id'
    LIMIT 1
  )
  WHERE ga_session_id IS NOT NULL
)

SELECT
  CASE
      WHEN source = '(direct)' AND medium IN ('(not set)', '(none)')                                      THEN 'Direct'
      WHEN medium = 'referral'                                                                            THEN 'Referral'
      WHEN REGEXP_CONTAINS(medium , r'email|e-mail|e_mail|e mail')  OR REGEXP_CONTAINS(source, r'email')   THEN 'Email'
      WHEN REGEXP_CONTAINS(medium , r'display|banner|expandable|interstitial|cpm')                         THEN 'Display'
      WHEN REGEXP_CONTAINS(medium , r'ppc|cpc|paid') AND REGEXP_CONTAINS(source , r'(baidu|bing|duckduckgo|ecosia|google|yahoo|yandex)') THEN 'Paid Search'
      ELSE 'Unassigned'
  END                                                             AS traffic_channel,
  COUNT(DISTINCT session_key)                                     AS total_sessions
FROM resolved_sessions
GROUP BY traffic_channel
ORDER BY total_sessions DESC;
```
