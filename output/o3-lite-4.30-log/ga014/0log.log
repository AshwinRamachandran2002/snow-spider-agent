```sql
-- 9) Aggregate sessions per channel across all December tables
--Description: wildcard across events_202012*, still LIMIT 20 to preview
SELECT
  channel,
  COUNT(*) AS sessions_sample
FROM (
  SELECT DISTINCT
    CONCAT(user_pseudo_id, '-', CAST(ga_session_id AS STRING)) AS session_key,
    CASE
      WHEN source = '(direct)' AND medium IN ('(not set)','(none)')                THEN 'Direct'
      WHEN medium = 'referral'                                                    THEN 'Referral'
      WHEN REGEXP_CONTAINS(medium, r'email|e-mail|e_mail|e mail')                 THEN 'Email'
      WHEN REGEXP_CONTAINS(medium, r'display|banner|cpm')                         THEN 'Display'
      ELSE 'Unassigned'
    END AS channel
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND event_name = 'session_start'
  CROSS JOIN UNNEST([STRUCT(
    COALESCE(traffic_source.source,
             (SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key='source'))  AS source,
    COALESCE(traffic_source.medium,
             (SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key='medium'))  AS medium,
    (SELECT ep2.value.int_value FROM UNNEST(event_params) ep2 WHERE ep2.key='ga_session_id')    AS ga_session_id
  )])
)
GROUP BY channel
LIMIT 20;
```

```sql
-- 10) FINAL QUERY – total sessions per default channel group in Dec‑2020
--Description: remove LIMIT when ready; uses full channel taxonomy (shortened here)
SELECT
  channel,
  COUNT(*) AS total_sessions
FROM (
  SELECT DISTINCT
    CONCAT(user_pseudo_id, '-', CAST(ga_session_id AS STRING)) AS session_key,
    CASE
      WHEN source = '(direct)' AND medium IN ('(not set)','(none)')                                     THEN 'Direct'
      WHEN medium = 'referral'                                                                          THEN 'Referral'
      WHEN REGEXP_CONTAINS(medium , r'email|e-mail|e_mail|e mail')  OR REGEXP_CONTAINS(source, r'email') THEN 'Email'
      WHEN REGEXP_CONTAINS(medium , r'display|banner|expandable|interstitial|cpm')                       THEN 'Display'
      WHEN REGEXP_CONTAINS(medium , r'ppc|cpc|paid') AND REGEXP_CONTAINS(source , r'(bing|google|yahoo)') THEN 'Paid Search'
      -- ...add the other channel rules here as needed...
      ELSE 'Unassigned'
    END AS channel
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND event_name = 'session_start'
  -- create helper fields once
  CROSS JOIN UNNEST([STRUCT(
    COALESCE(traffic_source.source,
             (SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key='source'))  AS source,
    COALESCE(traffic_source.medium,
             (SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key='medium'))  AS medium,
    (SELECT ep2.value.int_value FROM UNNEST(event_params) ep2 WHERE ep2.key='ga_session_id')    AS ga_session_id
  )])
)
GROUP BY channel
ORDER BY total_sessions DESC
LIMIT 20;
```

