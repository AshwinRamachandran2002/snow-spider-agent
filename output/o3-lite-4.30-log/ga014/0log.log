```sql
/*  Thinking process
    =================
    Objective: Count GA4 sessions in December‑2020 by traffic channel.

    1. Data scope            : Wild‑card tables `events_*` where _TABLE_SUFFIX is 20201201‑20201231.
    2. Session definition    : Each `session_start` event marks a session.
    3. Session uniqueness    : Build key = user_pseudo_id || '-' || ga_session_id
                               (ga_session_id is stored in event_params).
    4. Source / Medium rules : Prefer traffic_source.source / medium, otherwise take the
                               same keys from event_params.
    5. Channel grouping      : Simple CASE logic:
         • Direct     – source='(direct)' AND medium IN ('(not set)','(none)')
         • Referral   – medium='referral'
         • Email      – medium contains email variants
         • Display    – medium contains display‑ad terms
         • Unassigned – everything else
    6. Aggregation           : DISTINCT session keys → COUNT by channel.
    7. LIMIT 20              : Keep result small for preview (remove for full list).
*/
SELECT
  channel,
  COUNT(*) AS total_sessions
FROM (
  SELECT DISTINCT
    CONCAT(user_pseudo_id, '-', CAST(ga_session_id AS STRING)) AS session_key,
    CASE
      WHEN source_calc = '(direct)'
           AND medium_calc IN ('(not set)', '(none)')                          THEN 'Direct'
      WHEN medium_calc = 'referral'                                            THEN 'Referral'
      WHEN REGEXP_CONTAINS(medium_calc, r'email|e-mail|e_mail|e mail')         THEN 'Email'
      WHEN REGEXP_CONTAINS(medium_calc, r'display|banner|expandable|cpm')      THEN 'Display'
      ELSE 'Unassigned'
    END AS channel
  FROM (
    SELECT
      user_pseudo_id,

      -- Extract ga_session_id from event_params
      (SELECT ep.value.int_value
       FROM UNNEST(event_params) ep
       WHERE ep.key = 'ga_session_id')                                         AS ga_session_id,

      -- Resolve source (prefer traffic_source.* else event_params)
      COALESCE(
        traffic_source.source,
        (SELECT ep.value.string_value
         FROM UNNEST(event_params) ep
         WHERE ep.key = 'source')
      ) AS source_calc,

      -- Resolve medium (prefer traffic_source.* else event_params)
      COALESCE(
        traffic_source.medium,
        (SELECT ep.value.string_value
         FROM UNNEST(event_params) ep
         WHERE ep.key = 'medium')
      ) AS medium_calc
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
      AND event_name = 'session_start'
  )
)
GROUP BY channel
LIMIT 20;
