```sql
-- Description: 10) FINAL ANSWER – total number of December‑2020 sessions for each channel group
SELECT
  channel_group,
  COUNT(DISTINCT CONCAT(user_pseudo_id,'_',CAST(ga_session_id AS STRING))) AS total_sessions_dec2020
FROM (
  -- pull one row per session with its acquisition source & medium
  SELECT
    user_pseudo_id,
    MAX(CASE WHEN ep.key='ga_session_id' THEN CAST(ep.value.int_value AS INT64) END) AS ga_session_id,
    COALESCE(
      MAX(CASE WHEN ep.key='source' THEN ep.value.string_value END),
      traffic_source.source
    ) AS source,
    COALESCE(
      MAX(CASE WHEN ep.key='medium' THEN ep.value.string_value END),
      traffic_source.medium
    ) AS medium
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
  UNNEST(event_params) AS ep
  WHERE _TABLE_SUFFIX BETWEEN '01' AND '31'
    AND event_name = 'session_start'
  GROUP BY user_pseudo_id, traffic_source.source, traffic_source.medium
)
-- map to Channel Group (simplified ruleset)
CROSS JOIN UNNEST([STRUCT(
  CASE
    WHEN LOWER(source) = '(direct)' AND medium IN ('(not set)', '(none)')                           THEN 'Direct'
    WHEN medium = 'organic'                                                                        THEN 'Organic Search'
    WHEN REGEXP_CONTAINS(medium, r'(.*cp.*|ppc|paid.*)')    AND REGEXP_CONTAINS(source, r'(bing|google|yahoo|yandex|baidu|duckduckgo)') THEN 'Paid Search'
    WHEN REGEXP_CONTAINS(medium, r'(.*cp.*|ppc|retargeting|paid.*)')  AND REGEXP_CONTAINS(source, r'(facebook|instagram|pinterest|tiktok|twitter|whatsapp|linkedin)')       THEN 'Paid Social'
    WHEN medium = 'referral'                                                                       THEN 'Referral'
    ELSE 'Unassigned'
  END AS channel_group
)]) AS cg
GROUP BY channel_group
ORDER BY total_sessions_dec2020 DESC
LIMIT 20;
```

