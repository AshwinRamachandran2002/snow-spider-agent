/* one row per December‑2020 session (based solely on session_start and event_params) */
sessions AS (
  SELECT
    user_pseudo_id,
    MAX(IF(ep.key = 'ga_session_id', CAST(ep.value.int_value AS INT64), NULL)) AS ga_session_id,
    MAX(IF(ep.key = 'source', LOWER(ep.value.string_value), NULL))              AS source,
