  COUNT(DISTINCT CONCAT(user_pseudo_id,'_',CAST(ga_session_id AS STRING))) AS sessions
FROM (
  SELECT
    user_pseudo_id,
    MAX(CASE WHEN ep.key='ga_session_id' THEN CAST(ep.value.int_value AS INT64) END) AS ga_session_id,
    MAX(CASE WHEN ep.key='source'        THEN ep.value.string_value END)             AS source,
    MAX(CASE WHEN ep.key='medium'        THEN ep.value.string_value END)             AS medium
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
  UNNEST(event_params) AS ep
  WHERE _TABLE_SUFFIX BETWEEN '01' AND '31'
    AND event_name = 'session_start'
  GROUP BY user_pseudo_id
)
GROUP BY channel_group
ORDER BY sessions DESC
LIMIT 20;
