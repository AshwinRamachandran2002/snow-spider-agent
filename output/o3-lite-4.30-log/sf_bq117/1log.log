Relevant columns and their potential usage  
• “damage_property”: numerical value that lets us rank events and keep only the 100 storms that produced the greatest property‑loss over the period of interest.  
• “event_begin_time”: numeric micro‑seconds‐since‑epoch timestamp from which both “year” and “month” can be derived; used to (a) restrict the study to the most‑recent 15 calendar years and (b) discover the single month that contains the largest number of the TOP‑100 costliest events.  
• “event_id”: unique identifier of an individual severe‑storm event; used when we need one row per event (e.g., COUNT DISTINCT).  
Conditions that will normally be needed  
1. “event_begin_time” ≥ (<epoch‑value that represents Jan‑01‑2009 00:00:00 UTC) → keeps only the last 15 years (2009‑01‑01 through 2024‑12‑31).  
2. “damage_property” IS NOT NULL and, usually, “damage_property” > 0.  
3. ORDER BY “damage_property” DESC LIMIT 100 → keeps only the 100 largest property‑loss events.  

Below are 10 different Snowflake SQL queries (LIMIT 20 rows each) that progressively explore the data and culminate in counting the events that fall in the single most‑affected month for the TOP‑100 list.  
All identifiers are fully quoted.

```sql
-- 1) Description: Quick look at the 20 most costly storms recorded in 2023.
SELECT  "event_id",
        "event_begin_time",
        "damage_property"
FROM    "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023"
WHERE   "damage_property" IS NOT NULL
ORDER BY "damage_property" DESC
LIMIT 20;
```

```sql
-- 2) Description: Sample of 20 events from 2022 to verify the epoch‑time pattern.
SELECT  "event_id",
        "event_begin_time",
        "damage_property"
FROM    "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2022"
ORDER BY "event_begin_time" DESC
LIMIT 20;
```

```sql
-- 3) Description: Distinct years contained in the 2009 table (sanity check that table really covers 2009).
SELECT  DISTINCT TO_CHAR(TO_TIMESTAMP("event_begin_time"/1000000),'YYYY')   AS "year"
FROM    "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2009"
LIMIT 20;
```

```sql
-- 4) Description: Show how many severe‑storm events took place in each MONTH of 2023.
SELECT  TO_CHAR(TO_TIMESTAMP("event_begin_time"/1000000),'YYYY‑MM') AS "month",
        COUNT(*)                                                    AS "events_in_month"
FROM    "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023"
GROUP BY 1
ORDER BY "events_in_month" DESC
LIMIT 20;
```

```sql
-- 5) Description: Pull the 20 highest property‑loss events from 2019–2020 combined.
SELECT  "event_id",
        "event_begin_time",
        "damage_property"
FROM   (
        SELECT "event_id","event_begin_time","damage_property"
        FROM   "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2019"
        UNION ALL
        SELECT "event_id","event_begin_time","damage_property"
        FROM   "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2020"
       ) t
WHERE   "damage_property" IS NOT NULL
ORDER BY "damage_property" DESC
LIMIT 20;
```

```sql
-- 6) Description: Gather the TOP‑100 costliest events for the most‑recent 15‑year window (2009‑01‑01 onward).
WITH union15 AS (
  SELECT "event_id","event_begin_time","damage_property"
  FROM   "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2009"
  UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2010"
  UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2011"
  UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2012"
  UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2013"
  UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2014"
  UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2015"
  UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2016"
  UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2017"
  UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2018"
  UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2019"
  UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2020"
  UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2021"
  UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2022"
  UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023"
  UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2024"
)
SELECT  "event_id","event_begin_time","damage_property"
FROM    union15
WHERE   "event_begin_time" >= 1230768000000000      -- epoch µs for 2009‑01‑01
  AND   "damage_property" IS NOT NULL
ORDER BY "damage_property" DESC
LIMIT 100;
```

```sql
-- 7) Description: Take the previous TOP‑100 list and assign each event to its calendar month.
WITH top100 AS ( /* copy of query 6 but wrapped so we can reuse */ 
  SELECT  "event_id", "event_begin_time", "damage_property"
  FROM   (
          SELECT "event_id","event_begin_time","damage_property"
          FROM   "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2009"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2010"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2011"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2012"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2013"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2014"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2015"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2016"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2017"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2018"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2019"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2020"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2021"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2022"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2024"
        )
  WHERE   "event_begin_time" >= 1230768000000000
    AND   "damage_property" IS NOT NULL
  ORDER BY "damage_property" DESC
  LIMIT 100
)
SELECT  TO_CHAR(TO_TIMESTAMP("event_begin_time"/1000000),'YYYY‑MM') AS "month",
        COUNT(*)                                                   AS "events_top100"
FROM    top100
GROUP BY 1
ORDER BY "events_top100" DESC
LIMIT 20;
```

```sql
-- 8) Description: Identify the single month with the greatest number of TOP‑100 events.
WITH ranked_months AS (
  SELECT  TO_CHAR(TO_TIMESTAMP("event_begin_time"/1000000),'YYYY‑MM') AS "month",
          COUNT(*)                                                   AS "events_in_month",
          ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC)                 AS "rn"
  FROM   (
          /* reuse the top100 CTE of query 7 */
          SELECT  "event_id","event_begin_time"
          FROM   (
                   SELECT "event_id","event_begin_time","damage_property"
                   FROM   "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2009"
                   UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2010"
                   UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2011"
                   UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2012"
                   UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2013"
                   UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2014"
                   UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2015"
                   UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2016"
                   UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2017"
                   UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2018"
                   UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2019"
                   UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2020"
                   UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2021"
                   UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2022"
                   UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023"
                   UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2024"
                 )
          WHERE "event_begin_time" >= 1230768000000000
          ORDER BY "damage_property" DESC
          LIMIT 100
        ) t
  GROUP BY 1
)
SELECT  "month","events_in_month"
FROM    ranked_months
WHERE   "rn" = 1
LIMIT 20;
```

```sql
-- 9) Description: Retrieve raw details for every TOP‑100 event that falls inside the month singled out in query 8.
WITH top100 AS ( /* same logic as query 6 */ 
  SELECT  "event_id","event_begin_time","damage_property"
  FROM   (
          SELECT "event_id","event_begin_time","damage_property"
          FROM   "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2009"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2010"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2011"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2012"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2013"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2014"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2015"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2016"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2017"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2018"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2019"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2020"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2021"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2022"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023"
          UNION ALL SELECT * FROM "NOAA_DATA"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2024"
        )
  WHERE   "event_begin_time" >= 1230768000000000
  ORDER BY "damage_property" DESC
  LIMIT 100
),
most_month AS (
  SELECT  TO_CHAR(TO_TIMESTAMP("event_begin_time"/1000000),'YYYY‑MM') AS "month"
  FROM    top100
  GROUP BY 1
  ORDER BY COUNT(*) DESC
  LIMIT 1
)
SELECT  t.*
FROM    top100 t
JOIN    most_month m
  ON    TO_CHAR(TO_TIMESTAMP(t."event_begin_time"/1000000),'YYYY‑MM') = m."month"
LIMIT 20;
```

