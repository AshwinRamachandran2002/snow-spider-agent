──────────────────────────────────
```sql
-- 1. Description: Quick peek at some 2024 rows (property damage + begin time)
SELECT "event_id",
       "event_begin_time",
       "damage_property",
       "event_type"
FROM   NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024"
LIMIT  20;
```

```sql
-- 2. Description: What distinct event types exist in 2024?
SELECT DISTINCT "event_type"
FROM   NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024"
LIMIT  20;
```

```sql
-- 3. Description: Highest property‑damage events recorded in 2024
SELECT "event_id",
       "damage_property",
       "state",
       "event_type"
FROM   NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024"
ORDER  BY "damage_property" DESC
LIMIT  20;
```

```sql
-- 4. Description: Inspect raw and converted timestamps (2023 sample)
SELECT "event_id",
       "event_begin_time",
       TO_TIMESTAMP_LTZ("event_begin_time"/1e6)   AS "begin_ts",
       "damage_property"
FROM   NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"
ORDER  BY "damage_property" DESC
LIMIT  20;
```

```sql
-- 5. Description: Combine 2023 & 2024 to view ten costliest events
SELECT "event_id",
       "damage_property",
       "state",
       TO_TIMESTAMP_LTZ("event_begin_time"/1e6) AS "begin_ts"
FROM   (
        SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"
        UNION ALL
        SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024"
       )
ORDER  BY "damage_property" DESC
LIMIT  20;
```

```sql
-- 6. Description: Show how months distribute for 2022 table
SELECT MONTH(TO_TIMESTAMP_LTZ("event_begin_time"/1e6)) AS "month_no",
       COUNT(*)                                       AS "event_cnt"
FROM   NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2022"
GROUP  BY "month_no"
ORDER  BY "event_cnt" DESC
LIMIT  20;
```

```sql
-- 7. Description: Build a 15‑year union (2009‑2024) & preview damage values
WITH last15 AS (
      SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2009"
      UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2010"
      UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2011"
      UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2012"
      UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2013"
      UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2014"
      UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2015"
      UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2016"
      UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2017"
      UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2018"
      UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2019"
      UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2020"
      UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021"
      UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2022"
      UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"
      UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024"
)
SELECT "event_id",
       "damage_property",
       TO_TIMESTAMP_LTZ("event_begin_time"/1e6) AS "begin_ts"
FROM   last15
ORDER  BY "damage_property" DESC
LIMIT  20;
```

```sql
-- 8. Description: Pick the top‑100 costliest events (2009‑2024) & show month
WITH last15 AS ( /* same UNION ALL block as in query 7 */ ),
     top100 AS (
        SELECT *
        FROM   last15
        ORDER  BY "damage_property" DESC
        LIMIT  100
)
SELECT "event_id",
       "damage_property",
       MONTH(TO_TIMESTAMP_LTZ("event_begin_time"/1e6)) AS "month_no"
FROM   top100
ORDER  BY "damage_property" DESC
LIMIT  20;
```

```sql
-- 9. Description: Count how many of those top‑100 fall in each calendar month
WITH last15 AS ( /* same UNION ALL block as in query 7 */ ),
     top100 AS (
        SELECT *
        FROM   last15
        ORDER  BY "damage_property" DESC
        LIMIT  100
)
SELECT MONTH(TO_TIMESTAMP_LTZ("event_begin_time"/1e6)) AS "month_no",
       COUNT(*)                                        AS "events_in_month"
FROM   top100
GROUP  BY "month_no"
ORDER  BY "events_in_month" DESC
LIMIT  20;
```

```sql
-- 10. Description: Return the single most affected month and its event count
WITH last15 AS ( /* same UNION ALL block as in query 7 */ ),
     top100 AS (
        SELECT *
        FROM   last15
        ORDER  BY "damage_property" DESC
        LIMIT  100
),
     by_month AS (
        SELECT MONTH(TO_TIMESTAMP_LTZ("event_begin_time"/1e6)) AS "month_no",
               COUNT(*)                                        AS "events_in_month"
        FROM   top100
        GROUP  BY "month_no"
)
SELECT "month_no",
       "events_in_month"
FROM   by_month
ORDER  BY "events_in_month" DESC
LIMIT  1;
```
