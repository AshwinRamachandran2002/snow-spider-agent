-- 9. Description: Count how many of those top‑100 fall in each calendar month
WITH last15 AS ( /* same UNION ALL block as in query 7 */ ),
     top100 AS (
        SELECT *
        FROM   last15
        ORDER  BY "damage_property" DESC
        LIMIT  100
)
SELECT MONTH(TO_TIMESTAMP_LTZ("event_begin_time"/1e6)) AS "month_no",
       COUNT(*)                                        AS "events_in_month"
FROM   top100
