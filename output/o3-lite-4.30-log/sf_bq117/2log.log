    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2016"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2017"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2018"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2019"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2020"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2022"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024"
  )
  ORDER BY "damage_property" DESC
  LIMIT 100
)
SELECT TO_CHAR("evt_ts",'YYYY-MM') AS "year_month",
       COUNT(*) AS "num_events"
FROM top100
GROUP BY "year_month"
ORDER BY "num_events" DESC
LIMIT 20;
```

```sql
-- 9) Isolate the month holding the maximum top‑100 count
WITH top100 AS (
  SELECT "event_id",
         TO_TIMESTAMP("event_begin_time"/1000000) AS "evt_ts"
  FROM (
    SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2010"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2011"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2012"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2013"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2014"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2015"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2016"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2017"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2018"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2019"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2020"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2022"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024"
  )
  ORDER BY "damage_property" DESC
  LIMIT 100
),
month_stats AS (
  SELECT TO_CHAR("evt_ts",'YYYY-MM') AS "year_month",
         COUNT(*) AS "num_events"
  FROM top100
  GROUP BY "year_month"
)
SELECT *
FROM month_stats
QUALIFY "num_events" = (SELECT MAX("num_events") FROM month_stats)
LIMIT 20;
```

```sql
-- 10) Final: supply the total number of severe‑storm events in that most‑affected month
WITH fifteen AS (
    SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2010"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2011"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2012"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2013"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2014"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2015"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2016"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2017"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2018"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2019"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2020"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2022"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"
    UNION ALL SELECT * FROM NOAA_DATA.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024"
),
top100 AS (
    SELECT "event_id",
           TO_TIMESTAMP("event_begin_time"/1000000) AS "evt_ts",
           "damage_property"
    FROM fifteen
    ORDER BY "damage_property" DESC
    LIMIT 100
),
month_counts AS (
    SELECT DATE_TRUNC('month',"evt_ts") AS "month_start",
           COUNT(*) AS "cnt"
    FROM top100
    GROUP BY "month_start"
)
SELECT "month_start",
       "cnt"  -- <-- total number of events in the most‑affected month
FROM month_counts
QUALIFY "cnt" = (SELECT MAX("cnt") FROM month_counts)
LIMIT 20;
```

These 10 queries progress from quick column peeks to a full aggregation that returns the required total for the month that hosts the greatest number of the 100 most damaging events over the last 15 years.
