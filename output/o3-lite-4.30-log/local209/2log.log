Begin Exploring Related Columns
Relevant columns and their potential usage  
• orders.order_id: unique identifier to count total orders per store.  
• orders.store_id: foreign key to join each order with its store.  
• orders.delivery_order_id: key to join an order to the deliveries table.  
• stores.store_id: primary key, used to join with orders.  
• stores.store_name: human‑readable store name for the results.  
• deliveries.delivery_order_id: equals orders.delivery_order_id, used for the join.  
• deliveries.delivery_status: filter to keep only rows whose status is 'DELIVERED'.

Typical conditions you will apply  
• JOIN orders o ON o.store_id = s.store_id  
• LEFT JOIN deliveries d ON d.delivery_order_id = o.delivery_order_id  
• WHERE d.delivery_status = 'DELIVERED'  

The 10 exploratory‑to‑final SQL queries (each returns ≤20 rows with DISTINCT where useful)

```sql
-- 1) See a sample of different store IDs present in the orders table
SELECT DISTINCT o."store_id"
FROM "orders" AS o
LIMIT 20;
```

```sql
-- 2) List a few store names to understand what we have in the stores table
SELECT DISTINCT s."store_id",
       s."store_name"
FROM "stores" AS s
LIMIT 20;
```

```sql
-- 3) Simple count of orders per store (without names yet)
SELECT o."store_id",
       COUNT(*) AS "total_orders"
FROM "orders" AS o
GROUP BY o."store_id"
ORDER BY "total_orders" DESC
LIMIT 20;
```

```sql
-- 4) Add the store name to the count by joining with stores
SELECT s."store_name",
       COUNT(*) AS "total_orders"
FROM "orders"  AS o
JOIN "stores"  AS s ON s."store_id" = o."store_id"
GROUP BY s."store_id", s."store_name"
ORDER BY "total_orders" DESC
LIMIT 20;
```

```sql
-- 5) Identify the single store with the highest number of orders
SELECT s."store_id",
       s."store_name",
       COUNT(*) AS "total_orders"
FROM "orders"  AS o
JOIN "stores"  AS s ON s."store_id" = o."store_id"
GROUP BY s."store_id", s."store_name"
ORDER BY "total_orders" DESC
LIMIT 1;
```

```sql
-- 6) Look at the first 20 orders that belong to that top‑ordering store
SELECT o."order_id",
       o."delivery_order_id"
FROM "orders" AS o
WHERE o."store_id" = (
     SELECT s2."store_id"
     FROM "orders" AS o2
     JOIN "stores" AS s2 ON s2."store_id" = o2."store_id"
     GROUP BY s2."store_id"
     ORDER BY COUNT(*) DESC
     LIMIT 1)
LIMIT 20;
```

```sql
-- 7) Check how many of those orders have a row in deliveries (any status)
SELECT COUNT(*) AS "orders_with_delivery_row"
FROM "orders"     AS o
LEFT JOIN "deliveries" AS d
       ON d."delivery_order_id" = o."delivery_order_id"
WHERE o."store_id" = (
     SELECT s2."store_id"
     FROM "orders" AS o2
     GROUP BY s2."store_id"
     ORDER BY COUNT(*) DESC
     LIMIT 1);
```

```sql
-- 8) Count only the rows whose delivery status is 'DELIVERED' for that store
SELECT COUNT(*) AS "delivered_orders"
FROM "orders"     AS o
JOIN "deliveries" AS d
     ON d."delivery_order_id" = o."delivery_order_id"
WHERE o."store_id" = (
     SELECT s2."store_id"
     FROM "orders" AS o2
     GROUP BY s2."store_id"
     ORDER BY COUNT(*) DESC
     LIMIT 1)
  AND d."delivery_status" = 'DELIVERED';
```

```sql
-- 9) Bring total orders and delivered orders together for the same store
SELECT total."store_id",
       total."total_orders",
       delivered."delivered_orders"
FROM (
     SELECT o."store_id",
            COUNT(*) AS "total_orders"
     FROM "orders" AS o
     GROUP BY o."store_id"
) AS total
LEFT JOIN (
     SELECT o."store_id",
            COUNT(*) AS "delivered_orders"
     FROM "orders"     AS o
     JOIN "deliveries" AS d
          ON d."delivery_order_id" = o."delivery_order_id"
     WHERE d."delivery_status" = 'DELIVERED'
     GROUP BY o."store_id"
) AS delivered
ON delivered."store_id" = total."store_id"
ORDER BY total."total_orders" DESC
LIMIT 20;
```

```sql
-- 10) Final answer: store with most orders, total orders, delivered orders,
--     and ratio (delivered / total)
SELECT s."store_name",
       t."total_orders",
       d."delivered_orders",
       ROUND(1.0 * d."delivered_orders" / t."total_orders", 3) AS "delivered_ratio"
FROM (
     SELECT o."store_id",
            COUNT(*) AS "total_orders"
     FROM "orders" AS o
     GROUP BY o."store_id"
) AS t
JOIN (
     SELECT o."store_id",
            COUNT(*) AS "delivered_orders"
     FROM "orders"     AS o
     JOIN "deliveries" AS d
          ON d."delivery_order_id" = o."delivery_order_id"
     WHERE d."delivery_status" = 'DELIVERED'
     GROUP BY o."store_id"
) AS d
ON d."store_id" = t."store_id"
JOIN "stores" AS s ON s."store_id" = t."store_id"
ORDER BY t."total_orders" DESC
LIMIT 1;
```
