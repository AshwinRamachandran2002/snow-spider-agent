```sql
--Description: In one shot, (1) compute total orders per store and locate the single store with the highest volume (window ROW_NUMBER in CTE totals ⇒ CTE top_store); 
--(2) count how many of that store’s orders have a matching record in deliveries marked ‘DELIVERED’; 
--(3) join to stores for the name and return total orders, delivered orders, and the delivered‑to‑total ratio.
WITH totals AS (                       -- total order count for every store
        SELECT o.store_id,
               COUNT(*) AS total_orders,
               ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn
        FROM   orders AS o
        GROUP  BY o.store_id
), 
top_store AS (                          -- keep only the #1 store
        SELECT store_id, total_orders
        FROM   totals
        WHERE  rn = 1
), 
delivered AS (                          -- delivered‑order count per store
        SELECT o.store_id,
               COUNT(*) AS delivered_orders
        FROM   orders     AS o
        JOIN   deliveries AS d
               ON d.delivery_order_id = o.delivery_order_id
        WHERE  d.delivery_status = 'DELIVERED'
        GROUP  BY o.store_id
) 
SELECT  s.store_name,
        ts.total_orders,
        COALESCE(d.delivered_orders, 0) AS delivered_orders,
        ROUND(1.0 * COALESCE(d.delivered_orders, 0) / ts.total_orders, 4) AS delivered_ratio
FROM    top_store AS ts
JOIN    stores    AS s ON s.store_id = ts.store_id
LEFT JOIN delivered AS d ON d.store_id = ts.store_id;
```
