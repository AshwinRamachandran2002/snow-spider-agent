SELECT
  channelGrouping,
  geoNetwork_country,
  SUM(totals_transactions) AS total_txns
FROM (
  SELECT DISTINCT
         channelGrouping,
         geoNetwork_country,
         totals_transactions
  FROM `data-to-insights.ecommerce.rev_transactions`
  WHERE totals_transactions IS NOT NULL
)
GROUP BY channelGrouping, geoNetwork_country
LIMIT 20;
```

