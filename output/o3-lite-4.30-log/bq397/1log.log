Relevant columns and their potential usage  
• `channelGrouping`: traffic acquisition dimension that we need to group by.  
• `geoNetwork_country`: country of the visitor; used to find the top‑performing country inside each channel.  
• `totals_transactions`: number of transactions in the row; will be summed to get the totals.  
• `visitId`, `fullVisitorId`, `hits_time`, `hits_transaction_transactionId` (not always populated): can be used in a de‑duplication step (e.g. choosing `DISTINCT` on these keys).

Typical conditions / filters that might be used  
• `totals_transactions IS NOT NULL` – keep rows that actually contain transaction counts.  
• De‑duplicate by using a sub‑query with `SELECT DISTINCT` (or grouping on identifying keys).  
• `HAVING COUNT(DISTINCT geoNetwork_country) > 1` – keep only channels present in more than one country.  
• A window function (`ROW_NUMBER` / `RANK`) partitioned by `channelGrouping` ordered by summed transactions DESC to pick the top country per channel.

Ten exploratory‑to‑final SQL queries
```sql
-- 1. Description: Quick look at 20 raw rows from rev_transactions
SELECT *
FROM `data-to-insights.ecommerce.rev_transactions`
LIMIT 20;
```

```sql
-- 2. Description: List of distinct channel groupings in the dataset
SELECT DISTINCT channelGrouping
FROM `data-to-insights.ecommerce.rev_transactions`
LIMIT 20;
```

```sql
-- 3. Description: List of distinct countries that have at least one transaction record
SELECT DISTINCT geoNetwork_country
FROM `data-to-insights.ecommerce.rev_transactions`
WHERE totals_transactions IS NOT NULL
LIMIT 20;
```

```sql
-- 4. Description: Distinct combination of channel and country (after de‑dupe)
SELECT DISTINCT channelGrouping, geoNetwork_country
FROM `data-to-insights.ecommerce.rev_transactions`
WHERE totals_transactions IS NOT NULL
LIMIT 20;
```

```sql
-- 5. Description: Sum of transactions by channel & country (de‑duplicated at row level)
SELECT
  channelGrouping,
  geoNetwork_country,
  SUM(totals_transactions) AS total_txns
FROM (
  SELECT DISTINCT
         channelGrouping,
         geoNetwork_country,
         totals_transactions
  FROM `data-to-insights.ecommerce.rev_transactions`
  WHERE totals_transactions IS NOT NULL
)
GROUP BY channelGrouping, geoNetwork_country
LIMIT 20;
```

```sql
-- 6. Description: How many different countries appear in each channel
SELECT
  channelGrouping,
  COUNT(DISTINCT geoNetwork_country) AS countries_with_txns
FROM (
  SELECT DISTINCT channelGrouping, geoNetwork_country
  FROM `data-to-insights.ecommerce.rev_transactions`
  WHERE totals_transactions IS NOT NULL
)
GROUP BY channelGrouping
ORDER BY countries_with_txns DESC
LIMIT 20;
```

```sql
-- 7. Description: Same as #5 but keep only channels active in >1 country
SELECT
  channelGrouping,
  geoNetwork_country,
  SUM(totals_transactions) AS total_txns
FROM (
  SELECT DISTINCT channelGrouping, geoNetwork_country, totals_transactions
  FROM `data-to-insights.ecommerce.rev_transactions`
  WHERE totals_transactions IS NOT NULL
)
GROUP BY channelGrouping, geoNetwork_country
HAVING channelGrouping IN (
  SELECT channelGrouping
  FROM (
    SELECT channelGrouping, COUNT(DISTINCT geoNetwork_country) AS c
    FROM `data-to-insights.ecommerce.rev_transactions`
    WHERE totals_transactions IS NOT NULL
    GROUP BY channelGrouping
  )
  WHERE c > 1
)
LIMIT 20;
```

```sql
-- 8. Description: Using a window function to rank countries by transactions within each channel
WITH country_totals AS (
  SELECT
    channelGrouping,
    geoNetwork_country,
    SUM(totals_transactions) AS total_txns
  FROM (
    SELECT DISTINCT channelGrouping, geoNetwork_country, totals_transactions
    FROM `data-to-insights.ecommerce.rev_transactions`
    WHERE totals_transactions IS NOT NULL
  )
  GROUP BY channelGrouping, geoNetwork_country
),
ranked AS (
  SELECT
    channelGrouping,
    geoNetwork_country,
    total_txns,
    RANK() OVER (PARTITION BY channelGrouping ORDER BY total_txns DESC) AS r
  FROM country_totals
)
SELECT *
FROM ranked
WHERE r = 1
LIMIT 20;
```

```sql
-- 9. Description: Apply the multi‑country requirement directly in the ranking CTE
WITH country_totals AS (
  SELECT
    channelGrouping,
    geoNetwork_country,
    SUM(totals_transactions) AS total_txns
  FROM (
    SELECT DISTINCT channelGrouping, geoNetwork_country, totals_transactions
    FROM `data-to-insights.ecommerce.rev_transactions`
    WHERE totals_transactions IS NOT NULL
  )
  GROUP BY channelGrouping, geoNetwork_country
),
channels_multi_country AS (
  SELECT channelGrouping
  FROM country_totals
  GROUP BY channelGrouping
  HAVING COUNT(DISTINCT geoNetwork_country) > 1
),
ranked AS (
  SELECT
    ct.channelGrouping,
    ct.geoNetwork_country,
    ct.total_txns,
    ROW_NUMBER() OVER (PARTITION BY ct.channelGrouping ORDER BY ct.total_txns DESC) AS rn
  FROM country_totals ct
  JOIN channels_multi_country mc
    ON ct.channelGrouping = mc.channelGrouping
)
SELECT *
FROM ranked
WHERE rn = 1
LIMIT 20;
```

```sql
-- 10. Description: FINAL answer – top country by summed transactions
-- for every channelGrouping that has transactions in more than one country
WITH de_duped AS (
  -- Step 1: Remove duplicate transaction rows
  SELECT DISTINCT
         channelGrouping,
         geoNetwork_country,
         totals_transactions
  FROM `data-to-insights.ecommerce.rev_transactions`
  WHERE totals_transactions IS NOT NULL
),
country_totals AS (
  -- Step 2: Aggregate to country level per channel
  SELECT
    channelGrouping,
    geoNetwork_country,
    SUM(totals_transactions) AS total_txns
  FROM de_duped
  GROUP BY channelGrouping, geoNetwork_country
),
channels_multi_country AS (
  -- Step 3: Keep only channels appearing in >1 country
  SELECT channelGrouping
  FROM country_totals
  GROUP BY channelGrouping
  HAVING COUNT(DISTINCT geoNetwork_country) > 1
),
ranked AS (
  -- Step 4: Rank countries inside each qualified channel
  SELECT
    ct.channelGrouping,
    ct.geoNetwork_country AS top_country,
    ct.total_txns,
    ROW_NUMBER() OVER (PARTITION BY ct.channelGrouping ORDER BY ct.total_txns DESC) AS rn
  FROM country_totals ct
  JOIN channels_multi_country mc
    ON ct.channelGrouping = mc.channelGrouping
)
-- Step 5: Return only the #1 country per channel
SELECT
  channelGrouping,
  top_country,
  total_txns
FROM ranked
WHERE rn = 1
ORDER BY channelGrouping;
```
