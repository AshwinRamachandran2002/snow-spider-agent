-- 2) distinct_visits – unique surrogate keys.  
--If rows_in_table > distinct_visits, duplicate rows exist.
SELECT
  COUNT(*) AS rows_in_table,
  COUNT(DISTINCT CONCAT(fullVisitorId, '#', CAST(visitId AS STRING))) AS distinct_visits
FROM `data-to-insights.ecommerce.rev_transactions`;
