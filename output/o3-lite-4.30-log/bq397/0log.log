Successfully executed. SQL:
--Description: 
--🔟  Same goal as #9 but demonstrates an alternative solution with
--     ARRAY_AGG.  After de‑duplication and aggregation, we collect the
--     (country , total_tx) structs, sort by total_tx, and pluck the
--     first element for each channelGrouping.  The HAVING clause keeps
--     only channels present in more than one country.
WITH dedup AS (
  SELECT DISTINCT
    `fullVisitorId`,
    `visitId`,
    `channelGrouping`,
    `geoNetwork_country`,
    `totals_transactions`
  FROM `data-to-insights.ecommerce.rev_transactions`
), tx_by_country AS (
  SELECT
    `channelGrouping`,
    `geoNetwork_country` AS country,
    SUM(`totals_transactions`) AS total_tx
  FROM dedup
  WHERE `totals_transactions` IS NOT NULL
  GROUP BY 1,2
), top_per_channel AS (
  SELECT
    `channelGrouping`,
    ARRAY_AGG(
      STRUCT(country, total_tx) ORDER BY total_tx DESC
    )[SAFE_OFFSET(0)] AS best
  FROM tx_by_country
  GROUP BY `channelGrouping`
  HAVING COUNT(*) > 1          -- channel in >1 country
)
SELECT
  `channelGrouping`,
  best.country      AS top_country,
  best.total_tx     AS sum_transactions
FROM top_per_channel
ORDER BY `channelGrouping`
