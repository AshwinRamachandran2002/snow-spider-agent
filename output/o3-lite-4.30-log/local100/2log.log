Relevant columns and their potential usage  

• Person.PID: unique identifier for every person – needed to join cast records that belong to a given actor/actress.  
• Person.Name: used to locate “Shahrukh Khan” with a LIKE (or = if we know the exact spelling).  
• M_Cast.MID: movie identifier appearing in the cast list – links an actor to a film.  
• M_Cast.PID: actor identifier of the performer appearing in the film – lets us collect all co‑stars.  
• Movie.MID / Movie.title / Movie.year (optional): may be joined for readability or additional filtering but are not strictly required for computing the number.  

Typical conditions that will be used  

1. Person.Name LIKE '%Shahrukh%Khan%'         -- to find Shahrukh Khan’s PID.  
2. M_Cast.PID = <Shahrukh‑PID>                -- rows of the films he acted in.  
3. M_Cast.MID IN (…)                          -- set inclusion when we already know the films.  
4. M_Cast.PID <> <Shahrukh‑PID>               -- to exclude Shahrukh himself when listing co‑stars.  
5. NOT IN (…)                                 -- to remove Shahrukh and his direct co‑stars from the degree‑2 list.  

Below are 10 exploratory SQL queries (each limited to 20 rows) that start from the very basics and end with the single query that returns the requested count of “Shahrukh number 2” actors.  

```sql
-- 1. Description: Show every person whose name contains ‘Shahrukh’.
SELECT DISTINCT
       "PID",
       TRIM("Name") AS "Name"
FROM   "Person"
WHERE  TRIM("Name") LIKE '%Shahrukh%Khan%'
LIMIT 20;
```

```sql
-- 2. Description: List (at most 20) movie IDs in which Shahrukh Khan acted.
SELECT DISTINCT
       mc."MID"
FROM   "Person"   p
JOIN   "M_Cast"   mc ON mc."PID" = p."PID"
WHERE  TRIM(p."Name") LIKE '%Shahrukh%Khan%'
LIMIT 20;
```

```sql
-- 3. Description: List titles of the first 20 Shahrukh‑Khan movies (joining Movie for readability).
SELECT DISTINCT
       m."MID",
       m."title",
       m."year"
FROM   "Person"    p
JOIN   "M_Cast"    mc ON mc."PID" = p."PID"
JOIN   "Movie"     m  ON m."MID"  = mc."MID"
WHERE  TRIM(p."Name") LIKE '%Shahrukh%Khan%'
LIMIT 20;
```

```sql
-- 4. Description: Find the first 20 direct co‑stars (Shahrukh number = 1).
SELECT DISTINCT
       co."PID",
       TRIM(per."Name") AS "CoStar_Name"
FROM   "Person"   srk
JOIN   "M_Cast"   srk_mc ON srk_mc."PID" = srk."PID"
JOIN   "M_Cast"   co     ON co."MID"     = srk_mc."MID"
JOIN   "Person"   per    ON per."PID"    = co."PID"
WHERE  TRIM(srk."Name") LIKE '%Shahrukh%Khan%'
  AND  co."PID" <> srk."PID"
LIMIT 20;
```

```sql
-- 5. Description: Show the first 20 films of one of Shahrukh’s co‑stars (replace <PID> manually if needed).
SELECT DISTINCT
       mc."MID"
FROM   "M_Cast" mc
WHERE  mc."PID" = '<PID_of_some_costar>'
LIMIT 20;
```

```sql
-- 6. Description: Collect (max 20) movies that ANY direct co‑star was in, excluding Shahrukh’s own movies.
WITH srk_movies AS (
    SELECT DISTINCT mc."MID"
    FROM   "Person" p
    JOIN   "M_Cast" mc ON mc."PID" = p."PID"
    WHERE  TRIM(p."Name") LIKE '%Shahrukh%Khan%'
), srk_costars AS (
    SELECT DISTINCT co."PID"
    FROM   "Person"   p
    JOIN   "M_Cast"   p_mc ON p_mc."PID" = p."PID"
    JOIN   "M_Cast"   co   ON co."MID"   = p_mc."MID"
    WHERE  TRIM(p."Name") LIKE '%Shahrukh%Khan%'
      AND  co."PID" <> p."PID"
)
SELECT DISTINCT
       mc."MID"
FROM   "M_Cast" mc
JOIN   srk_costars c ON c."PID" = mc."PID"
WHERE  mc."MID" NOT IN (SELECT * FROM srk_movies)
LIMIT 20;
```

```sql
-- 7. Description: First 20 candidate actors who acted with a Shahrukh co‑star, but in a different movie.
WITH srk_movies AS (
    SELECT DISTINCT mc."MID"
    FROM   "Person" p
    JOIN   "M_Cast" mc ON mc."PID" = p."PID"
    WHERE  TRIM(p."Name") LIKE '%Shahrukh%Khan%'
), srk_costars AS (
    SELECT DISTINCT co."PID"
    FROM   "Person"   p
    JOIN   "M_Cast"   p_mc ON p_mc."PID" = p."PID"
    JOIN   "M_Cast"   co   ON co."MID"   = p_mc."MID"
    WHERE  TRIM(p."Name") LIKE '%Shahrukh%Khan%'
      AND  co."PID" <> p."PID"
)
SELECT DISTINCT
       mc2."PID",
       TRIM(per."Name") AS "Candidate_Name"
FROM   "M_Cast" mc1              -- role of the direct co‑star
JOIN   srk_costars c   ON c."PID" = mc1."PID"
JOIN   "M_Cast" mc2    ON mc2."MID" = mc1."MID"   -- same movie
JOIN   "Person" per    ON per."PID" = mc2."PID"
WHERE  mc2."PID" NOT IN (SELECT * FROM srk_costars)
  AND  mc2."PID" NOT IN (SELECT p."PID"
                         FROM "Person" p
                         WHERE TRIM(p."Name") LIKE '%Shahrukh%Khan%')
  AND  mc1."MID" NOT IN (SELECT * FROM srk_movies) -- be sure that movie has no Shahrukh
LIMIT 20;
```

```sql
-- 8. Description: Verify that no candidate is a direct co‑star by LEFT JOIN (sanity check, 20 rows).
WITH srk_costars AS (
    SELECT DISTINCT co."PID"
    FROM   "Person"   p
    JOIN   "M_Cast"   p_mc ON p_mc."PID" = p."PID"
    JOIN   "M_Cast"   co   ON co."MID"   = p_mc."MID"
    WHERE  TRIM(p."Name") LIKE '%Shahrukh%Khan%'
      AND  co."PID" <> p."PID"
), candidates AS (
    SELECT DISTINCT mc2."PID"
    FROM   srk_costars c
    JOIN   "M_Cast" mc1 ON mc1."PID" = c."PID"
    JOIN   "M_Cast" mc2 ON mc2."MID" = mc1."MID"
    WHERE  mc2."PID" NOT IN (SELECT * FROM srk_costars)
)
SELECT c."PID"                      AS "Candidate_PID",
       CASE WHEN s."PID" IS NULL
            THEN 'Not direct co‑star'
            ELSE 'ERROR direct co‑star' END AS "Check"
FROM   candidates c
LEFT JOIN srk_costars s ON s."PID" = c."PID"
LIMIT 20;
```

```sql
-- 9. Description: Show the first 20 Shahrukh‑number‑2 actors with their total count of ‘second‑degree’ movies.
WITH srk_movies AS (
    SELECT DISTINCT mc."MID"
    FROM   "Person" p
    JOIN   "M_Cast" mc ON mc."PID" = p."PID"
    WHERE  TRIM(p."Name") LIKE '%Shahrukh%Khan%'
), srk_costars AS (
    SELECT DISTINCT co."PID"
    FROM   "Person"   p
    JOIN   "M_Cast"   p_mc ON p_mc."PID" = p."PID"
    JOIN   "M_Cast"   co   ON co."MID"   = p_mc."MID"
    WHERE  TRIM(p."Name") LIKE '%Shahrukh%Khan%'
      AND  co."PID" <> p."PID"
), degree2 AS (
    SELECT DISTINCT mc2."PID", mc2."MID"
    FROM   srk_costars c
    JOIN   "M_Cast" mc1 ON mc1."PID" = c."PID"        -- movie of a direct co‑star
    JOIN   "M_Cast" mc2 ON mc2."MID" = mc1."MID"      -- everyone in that movie
    WHERE  mc2."PID" NOT IN (SELECT * FROM srk_costars)           -- exclude degree‑1
      AND  mc2."PID" NOT IN (SELECT "PID" FROM "Person"
                             WHERE TRIM("Name") LIKE '%Shahrukh%Khan%')   -- exclude SRK
      AND  mc1."MID" NOT IN (SELECT * FROM srk_movies)            -- movie must not contain SRK
)
SELECT d2."PID",
       TRIM(p."Name") AS "Actor_Name",
       COUNT(DISTINCT d2."MID") AS "SecondDeg_Movie_Count"
FROM   degree2 d2
JOIN   "Person" p ON p."PID" = d2."PID"
GROUP  BY d2."PID"
ORDER  BY "SecondDeg_Movie_Count" DESC
LIMIT 20;
```

