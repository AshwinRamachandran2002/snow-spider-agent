--Description: 10. FINAL – count of actors whose seed‑number equals 2: they acted
--with someone who acted with the seed actor, but never acted directly with the seed actor.
WITH t_cast AS (
    SELECT TRIM("PID") AS PID, "MID"
    FROM   "M_Cast"
), seed_actor AS (
    SELECT PID FROM t_cast LIMIT 1
), seed_movies AS (
    SELECT DISTINCT "MID"
    FROM   t_cast
    WHERE  PID IN (SELECT PID FROM seed_actor)
), seed_costars AS (
    SELECT DISTINCT PID
    FROM   t_cast
    WHERE  "MID" IN (SELECT "MID" FROM seed_movies)
      AND  PID NOT IN (SELECT PID FROM seed_actor)
), other_movies AS (
    SELECT DISTINCT "MID"
    FROM   t_cast
    WHERE  PID IN (SELECT PID FROM seed_costars)
      AND  "MID" NOT IN (SELECT "MID" FROM seed_movies)
), degree2_actors AS (
    SELECT DISTINCT t2.PID
    FROM   t_cast t2
    WHERE  t2."MID" IN (SELECT "MID" FROM other_movies)
      AND  t2.PID NOT IN (SELECT PID FROM seed_costars)
      AND  t2.PID NOT IN (SELECT PID FROM seed_actor)
)
SELECT COUNT(*) AS "SeedActor_number_2_actors"
FROM   degree2_actors
