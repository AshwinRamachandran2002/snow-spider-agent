--Description: 8. Verify that the degree‑2 candidates above are NOT also direct
--co‑stars of the seed actor (sanity check, 20 rows).
WITH t_cast AS (
    SELECT TRIM("PID") AS PID, "MID" FROM "M_Cast"
), seed_actor AS (SELECT PID FROM t_cast LIMIT 1),
seed_movies AS (SELECT DISTINCT "MID" FROM t_cast WHERE PID IN (SELECT PID FROM seed_actor)),
seed_costars AS (
    SELECT DISTINCT PID FROM t_cast
    WHERE "MID" IN (SELECT "MID" FROM seed_movies)
      AND PID NOT IN (SELECT PID FROM seed_actor)
), other_movies AS (
    SELECT DISTINCT "MID" FROM t_cast
    WHERE PID IN (SELECT PID FROM seed_costars)
      AND "MID" NOT IN (SELECT "MID" FROM seed_movies)
), candidates AS (
    SELECT DISTINCT PID FROM t_cast
    WHERE "MID" IN (SELECT "MID" FROM other_movies)
      AND PID NOT IN (SELECT PID FROM seed_costars)
      AND PID NOT IN (SELECT PID FROM seed_actor)
)
SELECT c.PID AS "Candidate_PID",
       CASE WHEN sc.PID IS NULL
            THEN 'Not direct co‑star'
            ELSE 'ERROR direct co‑star' END AS "Check"
FROM   candidates c
LEFT JOIN seed_costars sc ON sc.PID = c.PID
