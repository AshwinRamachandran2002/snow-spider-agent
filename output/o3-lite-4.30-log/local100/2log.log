--Description: 9. Show up to 20 seed‑number‑2 actors and how many qualifying second‑degree
--movies each appeared in, relative to the seed actor.  All PIDs are trimmed.
WITH t_cast AS (
    SELECT TRIM("PID") AS PID, "MID"
    FROM   "M_Cast"
), seed_actor AS (
    SELECT PID FROM t_cast LIMIT 1
), seed_movies AS (
    SELECT DISTINCT "MID"
    FROM   t_cast
    WHERE  PID IN (SELECT PID FROM seed_actor)
), seed_costars AS (
    SELECT DISTINCT PID
    FROM   t_cast
    WHERE  "MID" IN (SELECT "MID" FROM seed_movies)
      AND  PID NOT IN (SELECT PID FROM seed_actor)
), other_movies AS (
    SELECT DISTINCT "MID"
    FROM   t_cast
    WHERE  PID IN (SELECT PID FROM seed_costars)
      AND  "MID" NOT IN (SELECT "MID" FROM seed_movies)
), degree2 AS (
    SELECT t2.PID, t2."MID"
    FROM   t_cast t2
    WHERE  t2."MID" IN (SELECT "MID" FROM other_movies)
      AND  t2.PID NOT IN (SELECT PID FROM seed_costars)
      AND  t2.PID NOT IN (SELECT PID FROM seed_actor)
)
SELECT d2.PID,
       TRIM(p."Name") AS "Actor_Name",
       COUNT(DISTINCT d2."MID") AS "SecondDeg_Movie_Count"
FROM   degree2 d2
JOIN   "Person" p ON p."PID" = d2.PID
GROUP  BY d2.PID
ORDER  BY "SecondDeg_Movie_Count" DESC
LIMIT 20
