FROM "M_Cast" AS c1          -- direct co‑actors
JOIN "M_Cast" AS c2 ON c1."PID" = c2."PID"
WHERE c1."PID" IN (          -- list of direct co‑actor PIDs
  SELECT DISTINCT p2."PID"
  FROM "Person"  AS p2
  JOIN "M_Cast" AS c3 ON c3."PID" = p2."PID"
  WHERE c3."MID" IN (
    SELECT DISTINCT "MID"
    FROM "M_Cast"
    WHERE "PID" = (SELECT "PID" FROM "Person" WHERE "Name" LIKE '%Shahrukh%' LIMIT 1)
  )
)
AND c2."MID" NOT IN (        -- exclude any SRK movie
  SELECT DISTINCT "MID"
  FROM "M_Cast"
  WHERE "PID" = (SELECT "PID" FROM "Person" WHERE "Name" LIKE '%Shahrukh%' LIMIT 1)
)
LIMIT 20;
```

