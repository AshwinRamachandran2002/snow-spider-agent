  LIMIT 1
),
srk_movies AS (
  SELECT DISTINCT "MID"
  FROM "M_Cast"
  WHERE "PID" = (SELECT srk_pid FROM srk)
),
direct_coactors AS (
  SELECT DISTINCT "PID"
  FROM "M_Cast"
  WHERE "MID" IN (SELECT "MID" FROM srk_movies)
  AND "PID" <> (SELECT srk_pid FROM srk)
),
coactor_movies AS (
  SELECT DISTINCT "MID"
  FROM "M_Cast"
  WHERE "PID" IN (SELECT "PID" FROM direct_coactors)
  AND "MID" NOT IN (SELECT "MID" FROM srk_movies)
),
second_degree_actors AS (
  SELECT DISTINCT "PID"
  FROM "M_Cast"
  WHERE "MID" IN (SELECT "MID" FROM coactor_movies)
  AND "PID" NOT IN (SELECT srk_pid FROM srk)
  AND "PID" NOT IN (SELECT "PID" FROM direct_coactors)
)
SELECT COUNT(*) AS shahrukh_number_2_count
FROM second_degree_actors;
