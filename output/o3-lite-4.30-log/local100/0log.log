--Description: the Person row for the Bollywood star contains a leading blank in both
--             Name (" Shah Rukh Khan") and PID values stored in M_Cast also carry a
--             leading blank (e.g., " nm0451321").  By wrapping each side of the join
--             in TRIM() we align the keys; then, after again trimming the Name, we
--             match it exactly to 'Shah Rukh Khan'.  Finally we list every distinct
--             movie‑id associated with him (preview limited to 20).
SELECT DISTINCT c."MID"
FROM   "Person"  AS p
JOIN   "M_Cast" AS c
       ON TRIM(c."PID") = TRIM(p."PID")
WHERE  TRIM(p."Name") = 'Shah Rukh Khan'
LIMIT 20;
