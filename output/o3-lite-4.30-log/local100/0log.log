JOIN   "M_Cast" AS mc2 ON mc1."MID" = mc2."MID"                    -- co‑actors’ cast entries
JOIN   "Person"  AS p2  ON TRIM(mc2."PID") = TRIM(p2."PID")        -- names of co‑actors
WHERE  TRIM(p1."Name") = 'Shah Rukh Khan'
LIMIT 20;
