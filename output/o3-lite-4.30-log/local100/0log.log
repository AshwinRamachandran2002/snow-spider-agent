```sql
--Description: Step 3 – all actors who ever appeared with Shah Rukh Khan (Shahrukh‑number = 1);
--             we solve the whitespace mismatch by trimming both PID columns in the joins
--             and identify Shah Rukh Khan with TRIM(Name) = 'Shah Rukh Khan'.
SELECT DISTINCT TRIM(mc2."PID") AS "PID"
FROM   "Person"  AS p
JOIN   "M_Cast" AS mc1 ON TRIM(mc1."PID") = TRIM(p."PID")          -- Shah Rukh’s own cast rows
JOIN   "M_Cast" AS mc2 ON mc1."MID" = mc2."MID"                    -- everybody in the same movies
WHERE  TRIM(p."Name") = 'Shah Rukh Khan'
LIMIT 20;
