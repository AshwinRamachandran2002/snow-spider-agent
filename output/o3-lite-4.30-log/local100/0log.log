```sql
--Description: We need all films in which the real Bollywood star has acted.
-- 1. Person table shows one exact entry “ Shah Rukh Khan” (with a leading space).
-- 2. To avoid picking the other “Shahrukh” names we:
--      • TRIM() the Name column and compare to the precise string 'Shah Rukh Khan'.
-- 3. Join that single row to M_Cast on PID and collect the distinct movie IDs.
SELECT DISTINCT c."MID"
FROM   "Person"  AS p
JOIN   "M_Cast" AS c
       ON c."PID" = p."PID"
WHERE  TRIM(p."Name") = 'Shah Rukh Khan'
LIMIT 20;
```
