```sql
/* Thinking Process (inline comments):

   Goal: Identify, for each customer category, the largest lost‑order value (orders that were
         never invoiced) and find which category’s maximum is closest to the average of all
         category maxima.

   Steps
   ────────────────────────────────────────────────────────────────────────────────
   1. lost_orders   – Orders whose OrderID is absent from SALES_INVOICES.
   2. order_values  – Sum Quantity*UnitPrice for each lost order; attach category.
   3. category_max  – Maximum lost‑order value per CustomerCategory.
   4. overall_avg   – Average of those maxima.
   5. Final SELECT  – Show every category’s maximum, overall average, and absolute
                     difference; sort by smallest difference so first row answers the question.
*/
WITH lost_orders AS (
    SELECT
        o."OrderID",
        o."CustomerID"
    FROM WIDE_WORLD_IMPORTERS.WIDE_WORLD_IMPORTERS."SALES_ORDERS"  o
    LEFT JOIN WIDE_WORLD_IMPORTERS.WIDE_WORLD_IMPORTERS."SALES_INVOICES" i
           ON o."OrderID" = i."OrderID"
    WHERE i."OrderID" IS NULL               -- not invoiced
), order_values AS (
    SELECT
        lo."OrderID",
        cu."CustomerCategoryID",
        SUM(ol."Quantity" * ol."UnitPrice") AS "OrderValue"
    FROM lost_orders                                                 lo
    JOIN WIDE_WORLD_IMPORTERS.WIDE_WORLD_IMPORTERS."SALES_ORDERLINES"   ol
      ON lo."OrderID" = ol."OrderID"
    JOIN WIDE_WORLD_IMPORTERS.WIDE_WORLD_IMPORTERS."SALES_CUSTOMERS"    cu
      ON lo."CustomerID" = cu."CustomerID"
    GROUP BY cu."CustomerCategoryID", lo."OrderID"
), category_max AS (
    SELECT
        "CustomerCategoryID",
        MAX("OrderValue") AS "MaxLostOrderValue"
    FROM order_values
    GROUP BY "CustomerCategoryID"
), overall_avg AS (
    SELECT AVG("MaxLostOrderValue") AS "AvgMax"
    FROM category_max
)
SELECT
    cm."CustomerCategoryID",
    cat."CustomerCategoryName",
    cm."MaxLostOrderValue",
    oa."AvgMax",
    ABS(cm."MaxLostOrderValue" - oa."AvgMax") AS "DistanceToAvg"
FROM category_max                                      cm
CROSS JOIN overall_avg                                 oa
JOIN WIDE_WORLD_IMPORTERS.WIDE_WORLD_IMPORTERS."SALES_CUSTOMERCATEGORIES" cat
     ON cm."CustomerCategoryID" = cat."CustomerCategoryID"
ORDER BY "DistanceToAvg"
LIMIT 20;
