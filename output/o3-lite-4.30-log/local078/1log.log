```sql
--Description: Find each interest category’s peak composition value, capture the month it occured,
--             attach the interest name, then output the 10 largest peaks (TOP 10) and 10 smallest
--             peaks (BOTTOM 10).  ORDER BY resides inside each sub‑query so SQLite accepts the
--             UNION ALL.

WITH max_comp AS (                      -- 1. highest composition per interest
    SELECT interest_id,
           MAX(composition) AS max_comp
    FROM interest_metrics
    GROUP BY interest_id
),
peak_row AS (                           -- 2. row(s) where that peak occurs
    SELECT im.interest_id,
           im.month_year,
           mc.max_comp AS composition_value
    FROM max_comp mc
    JOIN interest_metrics im
      ON im.interest_id = mc.interest_id
     AND im.composition = mc.max_comp
),
named AS (                              -- 3. add readable interest_name
    SELECT mp.interest_name,
           pr.month_year,
           pr.composition_value
    FROM peak_row pr
    JOIN interest_map mp
      ON mp.id = pr.interest_id
)

-- 4. produce TOP 10 and BOTTOM 10 with UNION ALL
(
  SELECT 'TOP 10'   AS bucket,
         interest_name,
         month_year,
         composition_value
  FROM named
  ORDER BY composition_value DESC
  LIMIT 10
)
UNION ALL
(
  SELECT 'BOTTOM 10' AS bucket,
         interest_name,
         month_year,
         composition_value
  FROM named
  ORDER BY composition_value ASC
  LIMIT 10
);
```
