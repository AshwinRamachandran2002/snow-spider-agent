-- 6. Retrieve, for every interest_id, the month_year in which
--    that maximum composition occurred (ties keep the first one SQLite meets)
WITH max_comp AS (
  SELECT interest_id,
         MAX(composition) AS max_comp
  FROM interest_metrics
  GROUP BY interest_id
)
SELECT m.interest_id,
       i.month_year,
       m.max_comp
FROM max_comp AS m
JOIN interest_metrics AS i
  ON i.interest_id = m.interest_id
 AND i.composition   = m.max_comp
LIMIT 20;
