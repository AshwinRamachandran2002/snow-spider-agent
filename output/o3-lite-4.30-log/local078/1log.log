```sql
--Description:  For every interest category we first identify the highest “composition” value
--              ever recorded (max_comp) in interest_metrics.  We then capture the month_year
--              row(s) where that peak occurred and attach the readable interest_name from
--              interest_map.  From this full list we extract two subsets: the 10 categories
--              with the greatest peaks (TOP 10) and the 10 with the smallest peaks (BOTTOM 10).
--              Each subset orders and limits independently inside its own CTE, allowing us to
--              UNION ALL them safely because SQLite forbids ORDER BY between UNION branches.

WITH max_comp AS (                       -- 1. peak composition per category
    SELECT
        interest_id,
        MAX(composition) AS max_comp
    FROM interest_metrics
    GROUP BY interest_id
),
peak_rows AS (                           -- 2. rows where that peak occurs
    SELECT
        im.interest_id,
        im.month_year,
        mc.max_comp AS composition_value
    FROM max_comp mc
    JOIN interest_metrics im
         ON im.interest_id = mc.interest_id
        AND im.composition = mc.max_comp
),
named AS (                               -- 3. add human‑readable interest_name
    SELECT
        mp.interest_name,
        pr.month_year,
        pr.composition_value
    FROM peak_rows pr
    JOIN interest_map mp
         ON mp.id = pr.interest_id
),
top10 AS (                               -- 4a. ten largest peaks
    SELECT
        'TOP 10'        AS bucket,
        interest_name,
        month_year,
        composition_value
    FROM named
    ORDER BY composition_value DESC
    LIMIT 10
),
bottom10 AS (                            -- 4b. ten smallest peaks
    SELECT
        'BOTTOM 10'     AS bucket,
        interest_name,
        month_year,
        composition_value
    FROM named
    ORDER BY composition_value ASC
    LIMIT 10
)

-- 5. combine and output
SELECT * FROM top10
UNION ALL
SELECT * FROM bottom10;
```
