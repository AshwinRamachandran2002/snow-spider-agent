Query:
--Description:  This corrected “Final answer” query returns the 10 interest categories
--              with the largest peak composition values (TOP 10) and the 10 with the
--              smallest peak composition values (BOTTOM 10).  Because SQLite does not
--              allow ORDER BY + LIMIT directly before a UNION ALL, each subset is first
--              materialised in its own CTE (top10 and bottom10); afterwards they are
--              UNIONed together.

WITH max_comp AS (                 -- 1. peak composition per category
    SELECT
        interest_id,
        MAX(composition) AS max_comp
    FROM interest_metrics
    GROUP BY interest_id
),
best_rows AS (                     -- 2. row(s) where that peak occurs
    SELECT
        im.interest_id,
        im.month_year,
        mc.max_comp AS composition_value
    FROM max_comp mc
    JOIN interest_metrics im
      ON im.interest_id = mc.interest_id
     AND im.composition = mc.max_comp
),
ranked AS (                        -- 3. attach human‑readable name
    SELECT
        mp.interest_name,
        br.month_year,
        br.composition_value
    FROM best_rows br
    JOIN interest_map mp
      ON mp.id = br.interest_id
),
top10 AS (                         -- 4a. 10 largest peaks
    SELECT
        'TOP 10'        AS bucket,
        interest_name,
        month_year,
        composition_value
    FROM ranked
    ORDER BY composition_value DESC
    LIMIT 10
),
bottom10 AS (                      -- 4b. 10 smallest peaks
    SELECT
        'BOTTOM 10'     AS bucket,
        interest_name,
        month_year,
        composition_value
    FROM ranked
    ORDER BY composition_value ASC
    LIMIT 10
)

-- 5. combine and output
SELECT * FROM top10
UNION ALL
SELECT * FROM bottom10
