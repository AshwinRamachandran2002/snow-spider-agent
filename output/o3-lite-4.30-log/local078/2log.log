```sql
/*  THINKING PROCESS
    Objective: list 10 highest‑scoring (TOP) and 10 lowest‑scoring (BOTTOM)
    interest categories based on their greatest composition value observed
    across all months.  Required columns: month_year (MM‑YYYY), interest_name,
    composition.

    Steps
    1. best_month  – For every interest_id pick the row with the maximum
       composition using ROW_NUMBER().
    2. extremes    – Join those rows to interest_map to obtain names.
    3. top10       – Highest 10 compositions from extremes.
       bottom10    – Lowest 10 compositions from extremes.
    4. UNION ALL the two 10‑row sets.

    Output: 20 rows, each tagged as TOP or BOTTOM.
*/
WITH best_month AS (
    SELECT
        im."interest_id",
        im."month_year",
        im."composition",
        ROW_NUMBER() OVER (
            PARTITION BY im."interest_id"
            ORDER BY im."composition" DESC
        ) AS rn
    FROM "interest_metrics" AS im
),
extremes AS (
    SELECT
        bm."month_year",
        mp."interest_name",
        bm."composition"
    FROM best_month AS bm
    JOIN "interest_map" AS mp
      ON bm."interest_id" = mp."id"
    WHERE bm.rn = 1
),
top10 AS (
    SELECT
        'TOP' AS segment,
        month_year,
        interest_name,
        composition
    FROM extremes
    ORDER BY composition DESC
    LIMIT 10
),
bottom10 AS (
    SELECT
        'BOTTOM' AS segment,
        month_year,
        interest_name,
        composition
    FROM extremes
    ORDER BY composition ASC
    LIMIT 10
)
SELECT * FROM top10
UNION ALL
SELECT * FROM bottom10;
```
