--Description: Final formatted answer – returns the 10 highest (“TOP”) and
--10 lowest (“BOTTOM”) interest categories by their single best composition
--value, including the month (MM‑YYYY) in which that best value occurred.
WITH best_month AS (          -- keep only the row with the max composition per interest
    SELECT
        im."interest_id",
        im."month_year",
        im."composition",
        ROW_NUMBER() OVER (
            PARTITION BY im."interest_id"
            ORDER BY im."composition" DESC
        ) AS rn
    FROM "interest_metrics" AS im
),
extremes AS (                 -- attach readable interest names
    SELECT
        bm."month_year",
        mp."interest_name",
        bm."composition"
    FROM best_month AS bm
    JOIN "interest_map" AS mp
      ON bm."interest_id" = mp."id"
    WHERE bm.rn = 1
),
top_10 AS (                   -- 10 highest max‑composition categories
    SELECT
        'TOP' AS segment,
        month_year,
        interest_name,
        composition
    FROM extremes
    ORDER BY composition DESC
    LIMIT 10
),
bottom_10 AS (                -- 10 lowest max‑composition categories
    SELECT
        'BOTTOM' AS segment,
        month_year,
        interest_name,
        composition
    FROM extremes
    ORDER BY composition ASC
    LIMIT 10
)
SELECT *
FROM   top_10
UNION ALL
SELECT *
FROM   bottom_10
ORDER  BY segment DESC,       -- TOP rows first, then BOTTOM; inside each keep their order
