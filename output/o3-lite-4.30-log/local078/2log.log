```sql
--Description: Find each interest category’s single best (maximum) composition value
--and return two 10‑row sets: the 10 categories with the highest maxima (segment = 'TOP')
--and the 10 with the lowest maxima (segment = 'BOTTOM').  Steps performed inside CTEs:
-- 1. best_month  – use ROW_NUMBER() to keep only the row with the highest composition
--    for every interest_id in interest_metrics.
-- 2. extremes    – join those rows to interest_map to attach human‑readable names.
-- 3. top_10      – select the 10 rows with the largest composition values.
-- 4. bottom_10   – select the 10 rows with the smallest composition values.
-- 5. UNION ALL   – combine the two sets and order so TOP rows come first, each
--    internally sorted by descending composition.
WITH best_month AS (
    SELECT
        im."interest_id",
        im."month_year",
        im."composition",
        ROW_NUMBER() OVER (
            PARTITION BY im."interest_id"
            ORDER BY im."composition" DESC
        ) AS rn
    FROM "interest_metrics" AS im
),
extremes AS (
    SELECT
        bm."month_year",
        mp."interest_name",
        bm."composition"
    FROM best_month AS bm
    JOIN "interest_map" AS mp
      ON bm."interest_id" = mp."id"
    WHERE bm.rn = 1                -- keep only the max row per interest
),
top_10 AS (
    SELECT
        'TOP' AS segment,
        month_year,
        interest_name,
        composition
    FROM extremes
    ORDER BY composition DESC
    LIMIT 10
),
bottom_10 AS (
    SELECT
        'BOTTOM' AS segment,
        month_year,
        interest_name,
        composition
    FROM extremes
    ORDER BY composition ASC
    LIMIT 10
)
SELECT *
FROM   top_10
UNION ALL
SELECT *
FROM   bottom_10
ORDER BY segment DESC,              -- 'TOP' rows first, then 'BOTTOM'
         composition DESC;          -- within each segment, higher composition first
```
