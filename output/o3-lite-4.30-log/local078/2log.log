        ROW_NUMBER() OVER (ORDER BY bn."composition" ASC, bn."interest_name") AS pos
    FROM best_named bn
    ORDER BY bn."composition" ASC
    LIMIT 10
),
combined AS (
    SELECT * FROM top
    UNION ALL
    SELECT * FROM bottom
)
SELECT
    "month_year" AS time,
    "interest_name",
    printf('%.4f',"composition") AS composition_value
FROM combined
ORDER BY grp, pos;
```
