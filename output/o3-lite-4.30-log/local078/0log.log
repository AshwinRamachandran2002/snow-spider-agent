2025-05-01 03:21:37 - Thread-1348 (execute) - INFO - [Exploration]
Relevant tables and columns

interest_metrics.month_year: month in the required MM‑YYYY text format – needed for the final output   
interest_metrics.interest_id: foreign‑key that identifies each interest category   
interest_metrics.composition: the metric we must compare – we want the highest value reached by each category   
interest_map.id: joins to interest_metrics.interest_id   
interest_map.interest_name: the friendly name that must be returned in the final answer   

Main join condition  
interest_metrics.interest_id = interest_map.id  

Other filters/clauses we may use  
• GROUP BY interest_id (to aggregate and obtain each category’s maximum composition)  
• ORDER BY max_composition DESC / ASC to isolate the top or bottom 10 categories  
• LIMIT 10 to keep only the ten rows required in each list  
• A sub‑query (or CTE) to retrieve the month_year that corresponds to the maximum composition for every category  

--------------------------------------------------------------------
Ten exploratory → final SQL statements
--------------------------------------------------------------------

```sql
-- 1. List some distinct month‑year values that exist in the metrics table
SELECT DISTINCT month_year
FROM interest_metrics
LIMIT 20;
```

```sql
-- 2. Inspect a few distinct interest_id values recorded in the metrics table
SELECT DISTINCT interest_id
FROM interest_metrics
LIMIT 20;
```

```sql
-- 3. Map a handful of interest_id values to their names
SELECT im.interest_id,
       mp.interest_name
FROM   interest_metrics AS im
JOIN   interest_map     AS mp
       ON im.interest_id = mp.id
GROUP  BY im.interest_id
LIMIT 20;
```

```sql
-- 4. Preview composition figures for several interests and months
SELECT month_year,
       interest_id,
       composition
FROM   interest_metrics
ORDER  BY RANDOM()
LIMIT 20;
```

```sql
-- 5. For each category, show its single highest composition ever achieved
SELECT   im.interest_id,
         mp.interest_name,
         MAX(im.composition) AS max_composition
FROM     interest_metrics AS im
JOIN     interest_map     AS mp
         ON im.interest_id = mp.id
GROUP BY im.interest_id
ORDER BY max_composition DESC
LIMIT 20;
```

```sql
-- 6. Top‑10 interest categories by their maximum composition values
WITH max_comp AS (
  SELECT   im.interest_id,
           mp.interest_name,
           MAX(im.composition) AS max_comp
  FROM     interest_metrics AS im
  JOIN     interest_map     AS mp
           ON im.interest_id = mp.id
  GROUP BY im.interest_id
)
SELECT *
FROM   max_comp
ORDER  BY max_comp DESC
LIMIT 10;
```

```sql
-- 7. Bottom‑10 interest categories by their maximum composition values
WITH max_comp AS (
  SELECT   im.interest_id,
           mp.interest_name,
           MAX(im.composition) AS max_comp
  FROM     interest_metrics AS im
  JOIN     interest_map     AS mp
           ON im.interest_id = mp.id
  GROUP BY im.interest_id
)
SELECT *
FROM   max_comp
ORDER  BY max_comp ASC
LIMIT 10;
```

```sql
-- 8. Bring in the month when each TOP category reached its peak
WITH per_interest_max AS (
  SELECT  interest_id,
          MAX(composition) AS max_comp
  FROM    interest_metrics
  GROUP BY interest_id
),
top10 AS (
  SELECT  pim.interest_id,
          mp.interest_name,
          pim.max_comp
  FROM    per_interest_max AS pim
  JOIN    interest_map     AS mp
         ON pim.interest_id = mp.id
  ORDER BY pim.max_comp DESC
  LIMIT 10
)
SELECT im.month_year,
       t.interest_name,
       t.max_comp AS composition
FROM   top10           AS t
JOIN   interest_metrics AS im
       ON im.interest_id   = t.interest_id
      AND im.composition   = t.max_comp
ORDER  BY t.max_comp DESC;
```

```sql
-- 9. Bring in the month when each BOTTOM category reached its peak
WITH per_interest_max AS (
  SELECT  interest_id,
          MAX(composition) AS max_comp
  FROM    interest_metrics
  GROUP BY interest_id
),
bottom10 AS (
  SELECT  pim.interest_id,
          mp.interest_name,
          pim.max_comp
  FROM    per_interest_max AS pim
  JOIN    interest_map     AS mp
         ON pim.interest_id = mp.id
  ORDER BY pim.max_comp ASC
  LIMIT 10
)
SELECT im.month_year,
       b.interest_name,
       b.max_comp AS composition
FROM   bottom10         AS b
JOIN   interest_metrics AS im
       ON im.interest_id   = b.interest_id
      AND im.composition   = b.max_comp
ORDER  BY b.max_comp ASC;
```

```sql
-- 10. Final answer: union of TOP‑10 and BOTTOM‑10 with a label
WITH per_interest_max AS (
  SELECT  interest_id,
          MAX(composition) AS max_comp
  FROM    interest_metrics
  GROUP BY interest_id
),
ranked AS (
  SELECT pim.*,
         mp.interest_name,
         RANK() OVER (ORDER BY pim.max_comp DESC) AS desc_rank,
         RANK() OVER (ORDER BY pim.max_comp ASC)  AS asc_rank
  FROM   per_interest_max AS pim
  JOIN   interest_map     AS mp
         ON pim.interest_id = mp.id
),
extremes AS (
  SELECT interest_id,
         interest_name,
         max_comp,
         CASE WHEN desc_rank <= 10 THEN 'Top‑10'
              WHEN asc_rank  <= 10 THEN 'Bottom‑10'
         END AS category_band
  FROM   ranked
  WHERE  desc_rank <= 10
     OR  asc_rank  <= 10
)
SELECT  im.month_year         AS time,
        e.interest_name,
        e.max_comp            AS composition,
        e.category_band
FROM    extremes         AS e
JOIN    interest_metrics AS im
       ON im.interest_id = e.interest_id
      AND im.composition = e.max_comp
ORDER BY (e.category_band = 'Top‑10') DESC,   -- Top list first
         e.max_comp       DESC;               -- Then by composition
```

The last statement returns exactly 20 rows: the ten interests that achieved the highest composition values and the ten whose highest compositions are the lowest, each accompanied by the month‑year in which that peak occurred, the interest name, and the corresponding composition figure.
