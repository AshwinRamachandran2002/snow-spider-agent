-- 10. Final answer: union of TOP‑10 and BOTTOM‑10 with a label
WITH per_interest_max AS (
  SELECT  interest_id,
          MAX(composition) AS max_comp
  FROM    interest_metrics
  GROUP BY interest_id
),
ranked AS (
  SELECT pim.*,
         mp.interest_name,
         RANK() OVER (ORDER BY pim.max_comp DESC) AS desc_rank,
         RANK() OVER (ORDER BY pim.max_comp ASC)  AS asc_rank
  FROM   per_interest_max AS pim
  JOIN   interest_map     AS mp
         ON pim.interest_id = mp.id
),
extremes AS (
  SELECT interest_id,
         interest_name,
         max_comp,
         CASE WHEN desc_rank <= 10 THEN 'Top‑10'
              WHEN asc_rank  <= 10 THEN 'Bottom‑10'
         END AS category_band
  FROM   ranked
  WHERE  desc_rank <= 10
     OR  asc_rank  <= 10
)
SELECT  im.month_year         AS time,
        e.interest_name,
        e.max_comp            AS composition,
        e.category_band
FROM    extremes         AS e
JOIN    interest_metrics AS im
       ON im.interest_id = e.interest_id
