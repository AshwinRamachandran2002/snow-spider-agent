```sql
WITH per_interest_max AS (       -- peak composition for every interest
    SELECT
        interest_id,
        MAX(composition) AS max_comp
    FROM interest_metrics
    GROUP BY interest_id
),
ranked AS (                      -- rank the peaks high‑to‑low and low‑to‑high
    SELECT
        pim.interest_id,
        pim.max_comp,
        im.interest_name,
        RANK() OVER (ORDER BY pim.max_comp DESC) AS desc_rank,
        RANK() OVER (ORDER BY pim.max_comp ASC)  AS asc_rank
    FROM per_interest_max pim
    JOIN interest_map im
      ON pim.interest_id = im.id
),
extremes AS (                    -- keep only the top‑10 and bottom‑10 categories
    SELECT
        interest_id,
        interest_name,
        max_comp
    FROM ranked
    WHERE desc_rank <= 10
       OR asc_rank  <= 10
),
peak_time AS (                   -- find when each category reached its peak
    SELECT
        em.interest_id,
        MIN(em.month_year) AS time          -- earliest month if peak is repeated
    FROM interest_metrics em
    JOIN extremes ex
      ON em.interest_id = ex.interest_id
     AND em.composition = ex.max_comp
    GROUP BY em.interest_id
)
SELECT
    pt.time                            AS time,
    ex.interest_name                   AS interest_name,
    ROUND(ex.max_comp, 4)              AS composition_value
FROM extremes ex
JOIN peak_time pt
  ON pt.interest_id = ex.interest_id
ORDER BY ex.max_comp DESC;             -- top 10 first, bottom 10 last
```
