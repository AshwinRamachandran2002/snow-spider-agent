/*  Visitor IDs whose very first recorded transaction happened on a
    device explicitly labelled as “mobile”, and that transaction was
    on a later calendar date than the visitor’s first‑ever session   */

WITH all_sessions AS (          -- bring together every session row
  SELECT
    fullVisitorId,
    date,
    totals.transactions           AS transactions,
    device.deviceCategory         AS deviceCategory
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
),

-- first session date for every visitor -----------------------------
first_visit AS (
  SELECT
    fullVisitorId,
    MIN(date) AS first_visit_date
  FROM all_sessions
  GROUP BY fullVisitorId
),

-- first MOBILE transaction date for every visitor ------------------
first_mobile_txn AS (
  SELECT
    fullVisitorId,
    MIN(date) AS first_mobile_txn_date
  FROM all_sessions
  WHERE transactions > 0
    AND LOWER(deviceCategory) = 'mobile'
  GROUP BY fullVisitorId
)

-- keep only the visitors that satisfy the rule ---------------------
SELECT
  fv.fullVisitorId AS visitor_id
FROM first_visit        fv
JOIN first_mobile_txn   fmt
USING (fullVisitorId)
WHERE fmt.first_mobile_txn_date > fv.first_visit_date
ORDER BY visitor_id;
