    device.isMobile                AS isMobile,
    device.deviceCategory          AS deviceCategory
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_2017*`
),
first_visit AS (
  SELECT
    fullVisitorId,
    MIN(date) AS first_visit_date
  FROM all_sessions
  GROUP BY fullVisitorId
),
first_mobile_txn AS (
  SELECT
    fullVisitorId,
    MIN(date) AS first_mobile_txn_date
  FROM all_sessions
  WHERE transactions > 0
    AND (isMobile = TRUE OR deviceCategory = 'mobile')
  GROUP BY fullVisitorId
)
SELECT
  v.fullVisitorId AS visitor_id
FROM first_visit v
JOIN first_mobile_txn t USING (fullVisitorId)
WHERE t.first_mobile_txn_date > v.first_visit_date
LIMIT 20
