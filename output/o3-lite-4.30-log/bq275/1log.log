```sql
WITH all_sessions AS (
  SELECT
    fullVisitorId,
    visitStartTime,                      -- epoch‑seconds (numeric order)
    totals.transactions   AS transactions,
    device.deviceCategory AS device_category
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
),

-- first‑ever session for every visitor
first_visit AS (
  SELECT
    fullVisitorId,
    visitStartTime AS first_visit_ts
  FROM (
    SELECT
      fullVisitorId,
      visitStartTime,
      ROW_NUMBER() OVER (PARTITION BY fullVisitorId
                         ORDER BY visitStartTime) AS rn
    FROM all_sessions
  )
  WHERE rn = 1
),

-- first session that contains a transaction for every visitor
first_tx AS (
  SELECT
    fullVisitorId,
    visitStartTime AS first_tx_ts,
    device_category
  FROM (
    SELECT
      fullVisitorId,
      visitStartTime,
      device_category,
      ROW_NUMBER() OVER (PARTITION BY fullVisitorId
                         ORDER BY visitStartTime) AS rn
    FROM all_sessions
    WHERE transactions IS NOT NULL AND transactions > 0
  )
  WHERE rn = 1
)

SELECT
  fv.fullVisitorId AS visitor_id
FROM first_visit AS fv
JOIN first_tx    AS ftx
ON  fv.fullVisitorId = ftx.fullVisitorId
WHERE ftx.device_category = 'mobile'        -- first transaction on a mobile device
  AND ftx.first_tx_ts > fv.first_visit_ts   -- occurs after the very first visit
ORDER BY visitor_id;
```
