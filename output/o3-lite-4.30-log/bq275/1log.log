```sql
/*  visitor IDs whose very first session with a transaction happened on a
    device explicitly tagged as “mobile” **after** their first‐ever session  */

WITH all_sessions AS (
  SELECT
    fullVisitorId,
    date,                         -- YYYYMMDD string
    totals.transactions,
    device.deviceCategory
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
),

-- first session (any device) per user
first_visit AS (
  SELECT
    fullVisitorId,
    MIN(date) AS first_visit_date
  FROM all_sessions
  GROUP BY fullVisitorId
),

-- first mobile session that contains a transaction per user
first_mobile_tx AS (
  SELECT
    fullVisitorId,
    MIN(date) AS first_mobile_tx_date
  FROM all_sessions
  WHERE totals.transactions IS NOT NULL     -- ≥1 transaction
    AND device.deviceCategory = 'mobile'    -- explicitly mobile
  GROUP BY fullVisitorId
)

SELECT
  v.fullVisitorId AS visitor_id
FROM first_visit      AS v
JOIN first_mobile_tx  AS t
ON  v.fullVisitorId = t.fullVisitorId
WHERE t.first_mobile_tx_date > v.first_visit_date
ORDER BY visitor_id;
```
