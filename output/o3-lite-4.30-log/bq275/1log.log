WITH all_sessions AS (
  SELECT
    fullVisitorId,
    date,
    visitStartTime,
    totals.transactions            AS transactions,
    device.deviceCategory          AS device_category
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
),
-- earliest session (any device)
first_visit AS (
  SELECT
    fullVisitorId,
    MIN(STRUCT(visitStartTime, date)) AS first_visit_struct
  FROM all_sessions
  GROUP BY fullVisitorId
),
-- earliest session that contains a transaction
first_tx AS (
  SELECT
    fullVisitorId,
    MIN(STRUCT(visitStartTime, device_category, date)) AS first_tx_struct
  FROM all_sessions
  WHERE transactions IS NOT NULL AND transactions > 0
  GROUP BY fullVisitorId
)
SELECT
  fv.fullVisitorId AS visitor_id
FROM first_visit AS fv
JOIN first_tx     AS ftx
ON  fv.fullVisitorId = ftx.fullVisitorId
WHERE ftx.first_tx_struct.device_category = 'mobile'            -- first tx on mobile
  AND ftx.first_tx_struct.visitStartTime > fv.first_visit_struct.visitStartTime  -- after 1st visit
ORDER BY visitor_id;
