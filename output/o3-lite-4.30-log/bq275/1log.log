```sql
--Description:
--Goal: list visitor IDs whose very first session occurs before their very first MOBILE session that contains a transaction.
--
--Reasoning & steps in this query:
--1. Use visitStartTime (INT64 epoch‑seconds) as the time key because MIN/MAX work on simple scalars.
--2. CTE first_visit        → earliest visitStartTime for every visitor (any device, any session).
--3. CTE first_mobile_tx    → earliest visitStartTime for every visitor, but only for sessions
--                            where:  a) totals.transactions > 0  AND  b) device.isMobile = TRUE.
--4. Join the two CTEs by fullVisitorId and keep those where first_mobile_tx_ts > first_session_ts.
--5. Return qualifying visitor IDs (LIMIT 20 for sample; drop LIMIT for full list).
WITH first_visit AS (
  SELECT
    fullVisitorId,
    MIN(visitStartTime) AS first_session_ts
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  GROUP BY fullVisitorId
),
first_mobile_tx AS (
  SELECT
    fullVisitorId,
    MIN(visitStartTime) AS first_mobile_tx_ts
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE totals.transactions IS NOT NULL   -- session includes at least one transaction
    AND device.isMobile = TRUE            -- session tagged as mobile
  GROUP BY fullVisitorId
)
SELECT
  v.fullVisitorId
FROM first_visit     AS v
JOIN first_mobile_tx AS t
ON  v.fullVisitorId = t.fullVisitorId
WHERE t.first_mobile_tx_ts > v.first_session_ts   -- transaction occurs after first session
LIMIT 20;
