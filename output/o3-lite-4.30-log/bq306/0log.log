--Description:  Top‑10 Stack Overflow tags for user 1908967 based solely on answers
--posted *before* 7 Jun 2018.  For every qualifying answer we count:
--   • up‑votes   (vote_type_id = 2) worth 10 points each
--   • accept‑flags (vote_type_id = 1) worth 15 points each
--We then sum those answer scores per tag that belongs to the parent question and
--return the ten tags with the highest total scores.
WITH user_answers AS (               -- all answers by the user in time window
  SELECT id AS answer_id,
         parent_id AS question_id
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  WHERE  owner_user_id = 1908967
    AND  creation_date < '2018-06-07'
),
vote_totals AS (                     -- up‑vote & accept counts per answer
  SELECT v.post_id AS answer_id,
         COUNTIF(v.vote_type_id = 2) AS up,
         COUNTIF(v.vote_type_id = 1) AS acc
  FROM   `bigquery-public-data.stackoverflow.votes` v
  JOIN   user_answers ua
         ON ua.answer_id = v.post_id
  WHERE  v.vote_type_id IN (1,2)
  GROUP  BY answer_id
),
answer_scores AS (                   -- numeric score per answer
  SELECT ua.answer_id,
         ua.question_id,
         10 * IFNULL(vt.up,  0) +
         15 * IFNULL(vt.acc, 0) AS answer_score
  FROM   user_answers ua
  LEFT JOIN vote_totals vt
         ON vt.answer_id = ua.answer_id
),
tagged_scores AS (                   -- attach every tag of the parent question
  SELECT t.tag,
         a.answer_score
  FROM   answer_scores a
  JOIN   `bigquery-public-data.stackoverflow.posts_questions` q
         ON q.id = a.question_id
  CROSS JOIN UNNEST(SPLIT(q.tags, '|')) AS t(tag)
