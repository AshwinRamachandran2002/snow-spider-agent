Query:
--Description: FINAL QUERY – top‑10 tags (by total score) for answers written by
--             user 1908967 before 7 Jun 2018.  Tag parsing removes angle brackets
--             and splits on ‘|’.  Score = 10 × up‑votes + 15 × accepted‑answer votes.
WITH user_answers AS (
  SELECT id AS answer_id,
         parent_id
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  WHERE  owner_user_id = 1908967
    AND  creation_date < '2018-06-07'
),
vote_totals AS (
  SELECT ua.answer_id,
         10 * COUNTIF(v.vote_type_id = 2) +
         15 * COUNTIF(v.vote_type_id = 1) AS answer_score
  FROM   user_answers AS ua
  LEFT JOIN `bigquery-public-data.stackoverflow.votes` AS v
         ON v.post_id = ua.answer_id
            AND v.vote_type_id IN (1, 2)
  GROUP BY ua.answer_id
),
tags_per_answer AS (
  SELECT ua.answer_id,
         tag
  FROM   user_answers                                AS ua
  JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
         ON q.id = ua.parent_id
  CROSS JOIN UNNEST(
             SPLIT(REGEXP_REPLACE(q.tags, r'[<>]', ''), '|')
           ) AS tag
  WHERE  tag <> ''
)
SELECT tpa.tag,
       SUM(vt.answer_score) AS total_score
FROM   tags_per_answer AS tpa
JOIN   vote_totals     AS vt
  ON   vt.answer_id = tpa.answer_id
GROUP BY tpa.tag
ORDER BY total_score DESC
LIMIT 10
