--Description: 7) Join answers → parent question → exploded tags (first 20 rows)
--             using robust tag parsing that removes angle brackets and splits on '|'.
SELECT a.id AS answer_id,
       tag
FROM   `bigquery-public-data.stackoverflow.posts_answers`   AS a
JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
       ON q.id = a.parent_id
CROSS JOIN UNNEST(
