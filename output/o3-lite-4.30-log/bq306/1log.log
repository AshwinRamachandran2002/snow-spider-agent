```sql
--Description: 8) Compute the score for each individual answer / tag pair.
--             Uses COUNTIF over a LEFT JOIN so answers with zero votes still show.
WITH ans AS (
  SELECT id, parent_id
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  WHERE  owner_user_id = 1908967
    AND  creation_date < '2018-06-07'
), vote_score AS (
  SELECT a.id AS answer_id,
         10 * COUNTIF(v.vote_type_id = 2) +
         15 * COUNTIF(v.vote_type_id = 1) AS score
  FROM   ans AS a
  LEFT JOIN `bigquery-public-data.stackoverflow.votes` AS v
         ON v.post_id = a.id
            AND v.vote_type_id IN (1, 2)
  GROUP BY answer_id
)
SELECT vs.answer_id,
       tag,
       vs.score
FROM   vote_score                               AS vs
JOIN   ans                                      AS a  ON a.id = vs.answer_id
JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
       ON q.id = a.parent_id
CROSS JOIN UNNEST(REGEXP_EXTRACT_ALL(q.tags, r'<([^>]+)>')) AS tag
LIMIT 20;
```

```sql
--Description: 9) Aggregate scores per tag (no final ordering yet).
WITH ans AS (
  SELECT id, parent_id
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  WHERE  owner_user_id = 1908967
    AND  creation_date < '2018-06-07'
), vote_score AS (
  SELECT a.id AS answer_id,
         10 * COUNTIF(v.vote_type_id = 2) +
         15 * COUNTIF(v.vote_type_id = 1) AS score
  FROM   ans AS a
  LEFT JOIN `bigquery-public-data.stackoverflow.votes` AS v
         ON v.post_id = a.id
            AND v.vote_type_id IN (1, 2)
  GROUP BY answer_id
), answer_tag AS (
  SELECT a.id  AS answer_id,
         tag
  FROM   ans AS a
  JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
         ON q.id = a.parent_id
  CROSS JOIN UNNEST(REGEXP_EXTRACT_ALL(q.tags, r'<([^>]+)>')) AS tag
)
SELECT at.tag,
       SUM(vs.score) AS total_score
FROM   answer_tag AS at
JOIN   vote_score AS vs  ON vs.answer_id = at.answer_id
GROUP BY at.tag
LIMIT 20;
```

```sql
--Description: 10) FINAL QUERY – top‑10 tags by total score for user 1908967,
--             considering only answers before 7 Jun 2018 and the scoring rule
--             (10 × up‑votes + 15 × accepted‑answer votes).
WITH user_answers AS (
  SELECT id AS answer_id,
         parent_id
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  WHERE  owner_user_id = 1908967
    AND  creation_date < '2018-06-07'
), vote_totals AS (
  SELECT ua.answer_id,
         10 * COUNTIF(v.vote_type_id = 2) +
         15 * COUNTIF(v.vote_type_id = 1) AS answer_score
  FROM   user_answers                              AS ua
  LEFT JOIN `bigquery-public-data.stackoverflow.votes` AS v
         ON v.post_id = ua.answer_id
            AND v.vote_type_id IN (1, 2)
  GROUP BY ua.answer_id
), tags_per_answer AS (
  SELECT ua.answer_id,
         tag
  FROM   user_answers                               AS ua
  JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
         ON q.id = ua.parent_id
  CROSS JOIN UNNEST(REGEXP_EXTRACT_ALL(q.tags, r'<([^>]+)>')) AS tag
)
SELECT tpa.tag,
       SUM(vt.answer_score) AS total_score
FROM   tags_per_answer AS tpa
JOIN   vote_totals     AS vt  ON vt.answer_id = tpa.answer_id
GROUP BY tpa.tag
ORDER BY total_score DESC
LIMIT 10;
```
