```sql
--Description: 1) Look at the first 20 answers written by the user before 7 Jun 2018
SELECT id, parent_id, creation_date
FROM `bigquery-public-data.stackoverflow.posts_answers`
WHERE owner_user_id = 1908967
  AND creation_date < '2018-06-07'
ORDER BY creation_date
LIMIT 20;
```

```sql
--Description: 2) Confirm that those answers really belong to the user (distinct IDs)
SELECT DISTINCT owner_user_id
FROM `bigquery-public-data.stackoverflow.posts_answers`
WHERE owner_user_id = 1908967
  AND creation_date < '2018-06-07'
LIMIT 20;
```

```sql
--Description: 3) Sample raw votes for one of the user’s answers
SELECT v.*
FROM `bigquery-public-data.stackoverflow.votes` v
WHERE v.post_id = 21048655   -- replace with any answer_id returned above
  AND v.vote_type_id IN (1,2)
LIMIT 20;
```

```sql
--Description: 4) Count up‑votes and accepted‑answer votes per answer (small subset)
SELECT post_id,
       SUM(CASE WHEN vote_type_id = 2 THEN 1 END) AS upvotes,
       SUM(CASE WHEN vote_type_id = 1 THEN 1 END) AS accepted_votes
FROM `bigquery-public-data.stackoverflow.votes`
WHERE post_id IN (SELECT id
                  FROM `bigquery-public-data.stackoverflow.posts_answers`
                  WHERE owner_user_id = 1908967
                    AND creation_date < '2018-06-07')
  AND vote_type_id IN (1,2)
GROUP BY post_id
LIMIT 20;
```

```sql
--Description: 5) Pull the tag string for the parent questions of the user’s answers
SELECT qa.id         AS question_id,
       qa.tags
FROM `bigquery-public-data.stackoverflow.posts_questions` qa
WHERE qa.id IN (SELECT parent_id
                FROM `bigquery-public-data.stackoverflow.posts_answers`
                WHERE owner_user_id = 1908967
                  AND creation_date < '2018-06-07')
LIMIT 20;
```

```sql
--Description: 6) Split the tag string of one question into individual tags
SELECT q.id AS question_id,
       tag
FROM `bigquery-public-data.stackoverflow.posts_questions` q,
     UNNEST(REGEXP_EXTRACT_ALL(q.tags, r'<([^>]+)>')) AS tag
WHERE q.id = 24449808      -- replace with any question_id from above
LIMIT 20;
```

```sql
--Description: 7) Join answers → parent question → exploded tags (for first 20 rows)
SELECT a.id   AS answer_id,
       tag
FROM `bigquery-public-data.stackoverflow.posts_answers`  a
JOIN `bigquery-public-data.stackoverflow.posts_questions` q
  ON q.id = a.parent_id
CROSS JOIN UNNEST(REGEXP_EXTRACT_ALL(q.tags, r'<([^>]+)>')) AS tag
WHERE a.owner_user_id = 1908967
  AND a.creation_date < '2018-06-07'
LIMIT 20;
```

```sql
--Description: 8) Compute the score for each individual answer / tag pair
WITH ans AS (
  SELECT id, parent_id
  FROM `bigquery-public-data.stackoverflow.posts_answers`
  WHERE owner_user_id = 1908967
    AND creation_date < '2018-06-07'
),
votes AS (
  SELECT post_id,
         SUM(CASE WHEN vote_type_id = 2 THEN 1 END) AS up,
         SUM(CASE WHEN vote_type_id = 1 THEN 1 END) AS acc
  FROM `bigquery-public-data.stackoverflow.votes`
  WHERE vote_type_id IN (1,2)
  GROUP BY post_id
)
SELECT a.id AS answer_id,
       tag,
       10*IFNULL(v.up,0) + 15*IFNULL(v.acc,0) AS score
FROM ans a
LEFT JOIN votes v  ON v.post_id = a.id
JOIN `bigquery-public-data.stackoverflow.posts_questions` q
  ON q.id = a.parent_id
CROSS JOIN UNNEST(REGEXP_EXTRACT_ALL(q.tags, r'<([^>]+)>')) AS tag
LIMIT 20;
```

```sql
--Description: 9) Aggregate scores per tag (no final ordering yet)
WITH ans AS (
  SELECT id, parent_id
  FROM `bigquery-public-data.stackoverflow.posts_answers`
  WHERE owner_user_id = 1908967
    AND creation_date < '2018-06-07'
),
votes AS (
  SELECT post_id,
         SUM(CASE WHEN vote_type_id = 2 THEN 1 END) AS up,
         SUM(CASE WHEN vote_type_id = 1 THEN 1 END) AS acc
  FROM `bigquery-public-data.stackoverflow.votes`
  WHERE vote_type_id IN (1,2)
  GROUP BY post_id
),
answer_tag AS (
  SELECT a.id AS answer_id,
         tag
  FROM ans a
  JOIN `bigquery-public-data.stackoverflow.posts_questions` q
    ON q.id = a.parent_id
  CROSS JOIN UNNEST(REGEXP_EXTRACT_ALL(q.tags, r'<([^>]+)>')) AS tag
)
SELECT tag,
       SUM(10*IFNULL(v.up,0) + 15*IFNULL(v.acc,0)) AS total_score
FROM answer_tag at
LEFT JOIN votes v  ON v.post_id = at.answer_id
GROUP BY tag
LIMIT 20;
```

```sql
--Description: 10) FINAL QUERY – top‑10 tags by total score
WITH user_answers AS (
  SELECT id AS answer_id,
         parent_id     -- question id
  FROM `bigquery-public-data.stackoverflow.posts_answers`
  WHERE owner_user_id = 1908967
    AND creation_date < '2018-06-07'
),
vote_totals AS (
  SELECT post_id,
         SUM(CASE WHEN vote_type_id = 2 THEN 1 END) AS up,
         SUM(CASE WHEN vote_type_id = 1 THEN 1 END) AS acc
  FROM `bigquery-public-data.stackoverflow.votes`
  WHERE vote_type_id IN (1,2)
  GROUP BY post_id
),
tags_per_answer AS (
  SELECT ua.answer_id,
         tag
  FROM user_answers ua
  JOIN `bigquery-public-data.stackoverflow.posts_questions` q
    ON q.id = ua.parent_id
  CROSS JOIN UNNEST(REGEXP_EXTRACT_ALL(q.tags, r'<([^>]+)>')) AS tag
)
SELECT tag,
       SUM(10*IFNULL(vt.up,0) + 15*IFNULL(vt.acc,0)) AS total_score
FROM tags_per_answer ta
LEFT JOIN vote_totals vt
  ON vt.post_id = ta.answer_id
GROUP BY tag
ORDER BY total_score DESC
LIMIT 10;
```
