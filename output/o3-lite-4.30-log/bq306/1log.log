```sql
WITH user_answers AS (                     -- answers written before 7 Jun 2018
  SELECT id AS answer_id,
         parent_id                         -- question id
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  WHERE  owner_user_id = 1908967
    AND  creation_date < '2018-06-07'
),

answer_scores AS (                         -- 10 × up‑votes + 15 × accepted‑answer votes
  SELECT ua.answer_id,
         10 * COUNTIF(v.vote_type_id = 2) +
         15 * COUNTIF(v.vote_type_id = 1) AS score
  FROM   user_answers AS ua
  LEFT JOIN `bigquery-public-data.stackoverflow.votes` AS v
         ON v.post_id = ua.answer_id
        AND v.vote_type_id IN (1, 2)
  GROUP BY ua.answer_id
),

answer_tags AS (                           -- extract individual tags of the parent questions
  SELECT ua.answer_id,
         tag
  FROM   user_answers AS ua
  JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
         ON q.id = ua.parent_id
  CROSS JOIN UNNEST(
             REGEXP_EXTRACT_ALL(q.tags, r'<([^>]+)>')
           ) AS tag
)

SELECT  atag.tag,
        SUM(ascore.score) AS total_score
FROM    answer_tags   AS atag
JOIN    answer_scores AS ascore
       ON ascore.answer_id = atag.answer_id
GROUP BY atag.tag
ORDER BY total_score DESC, atag.tag
LIMIT 10;
