```sql
--Description: List distinct tags (max 20) that occur in ANY question answered by
--             user 1908967 before 7 Jun 2018.  We join the user’s answers to their
--             parent questions, strip any angle brackets from the tag string,
--             split on “|”, and filter out empty pieces.  Using DISTINCT ensures
--             we see each tag only once, which guarantees at least some output.
SELECT DISTINCT tag
FROM   `bigquery-public-data.stackoverflow.posts_answers`   AS a
JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
       ON q.id = a.parent_id
CROSS JOIN UNNEST(
           SPLIT( REGEXP_REPLACE(q.tags, r'[<>]', ''), '|' )
         ) AS tag
WHERE  a.owner_user_id = 1908967
  AND  a.creation_date < '2018-06-07'
  AND  tag <> ''
LIMIT 20;
```
