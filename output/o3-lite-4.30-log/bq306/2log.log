Relevant columns & why they matter  
• posts_answers.id : primary key of every answer – needed to join with votes  
• posts_answers.owner_user_id : lets us keep only answers written by user 1908967 (condition owner_user_id = 1908967)  
• posts_answers.creation_date : we keep answers created before 2018‑06‑07 (condition creation_date < TIMESTAMP '2018‑06‑07')  
• posts_answers.parent_id : the id of the question the answer belongs to – needed to reach the question’s tags  
• posts_questions.id : join‑key back to parent_id  
• posts_questions.tags : angle‑bracket–delimited list of tags (<tag1><tag2> …) – we will split it into individual tag names  
• votes.post_id : join‑key to the answer whose votes we are counting  
• votes.vote_type_id : 1 = accepted‑by‑originator, 2 = up‑vote – used to count accepted answers and up‑votes, respectively  

Extra conditions that will be used  
• votes.vote_type_id IN (1, 2)  
• For scoring: score_per_answer = 10 × upvotes + 15 × accepted  

Below are ten progressively richer BigQuery SQL queries (each capped with LIMIT 20 unless stated).  
All table and column identifiers are wrapped in back‑ticks for safety.

```sql
-- 1) Description: Peek at a handful of answers written by user 1908967
SELECT id, parent_id, creation_date
FROM `bigquery-public-data.stackoverflow.posts_answers`
WHERE owner_user_id = 1908967
LIMIT 20;
```

```sql
-- 2) Description: Same answers, but only those created before 7 Jun 2018
SELECT id, parent_id, creation_date
FROM `bigquery-public-data.stackoverflow.posts_answers`
WHERE owner_user_id = 1908967
  AND creation_date < TIMESTAMP '2018-06-07'
LIMIT 20;
```

```sql
-- 3) Description: Join the previous result to its parent questions in order to see the raw <tag> string
SELECT a.id AS answer_id,
       q.id AS question_id,
       q.tags
FROM `bigquery-public-data.stackoverflow.posts_answers` AS a
JOIN `bigquery-public-data.stackoverflow.posts_questions` AS q
  ON q.id = a.parent_id
WHERE a.owner_user_id = 1908967
  AND a.creation_date < TIMESTAMP '2018-06-07'
LIMIT 20;
```

```sql
-- 4) Description: Look at the votes each of those answers received, restricted to up‑votes (2) or accepted (1)
SELECT v.post_id,
       v.vote_type_id,
       v.creation_date
FROM `bigquery-public-data.stackoverflow.votes` AS v
JOIN `bigquery-public-data.stackoverflow.posts_answers` AS a
  ON a.id = v.post_id
WHERE a.owner_user_id = 1908967
  AND a.creation_date < TIMESTAMP '2018-06-07'
  AND v.vote_type_id IN (1, 2)
LIMIT 20;
```

```sql
-- 5) Description: Aggregate the number of up‑votes per answer
SELECT v.post_id                AS answer_id,
       COUNTIF(v.vote_type_id = 2) AS upvote_cnt
FROM `bigquery-public-data.stackoverflow.votes` v
JOIN `bigquery-public-data.stackoverflow.posts_answers` a
  ON a.id = v.post_id
WHERE a.owner_user_id = 1908967
  AND a.creation_date < TIMESTAMP '2018-06-07'
  AND v.vote_type_id = 2
GROUP BY answer_id
LIMIT 20;
```

```sql
-- 6) Description: Aggregate the number of accepted‑answer votes per answer
SELECT v.post_id                AS answer_id,
       COUNTIF(v.vote_type_id = 1) AS accepted_cnt
FROM `bigquery-public-data.stackoverflow.votes` v
JOIN `bigquery-public-data.stackoverflow.posts_answers` a
  ON a.id = v.post_id
WHERE a.owner_user_id = 1908967
  AND a.creation_date < TIMESTAMP '2018-06-07'
  AND v.vote_type_id = 1
GROUP BY answer_id
LIMIT 20;
```

```sql
-- 7) Description: Combine up‑votes and accepted counts in one step and compute the score of each answer
SELECT v.post_id                                AS answer_id,
       SUM(CASE WHEN v.vote_type_id = 2 THEN 1 ELSE 0 END)    AS upvote_cnt,
       SUM(CASE WHEN v.vote_type_id = 1 THEN 1 ELSE 0 END)    AS accepted_cnt,
       10 * SUM(CASE WHEN v.vote_type_id = 2 THEN 1 ELSE 0 END)
     + 15 * SUM(CASE WHEN v.vote_type_id = 1 THEN 1 ELSE 0 END) AS answer_score
FROM `bigquery-public-data.stackoverflow.votes` v
JOIN `bigquery-public-data.stackoverflow.posts_answers` a
  ON a.id = v.post_id
WHERE a.owner_user_id = 1908967
  AND a.creation_date < TIMESTAMP '2018-06-07'
  AND v.vote_type_id IN (1, 2)
GROUP BY answer_id
LIMIT 20;
```

```sql
-- 8) Description: Attach the parent question’s tags and explode them so that each tag appears on its own row with the answer’s score
WITH answer_scores AS (
  SELECT v.post_id AS answer_id,
         10*SUM(v.vote_type_id = 2) +
         15*SUM(v.vote_type_id = 1) AS answer_score
  FROM `bigquery-public-data.stackoverflow.votes` v
  JOIN `bigquery-public-data.stackoverflow.posts_answers` a
    ON a.id = v.post_id
  WHERE a.owner_user_id = 1908967
    AND a.creation_date < TIMESTAMP '2018-06-07'
    AND v.vote_type_id IN (1,2)
  GROUP BY answer_id
)
SELECT ascore.answer_id,
       tag AS single_tag,
       ascore.answer_score
FROM answer_scores AS ascore
JOIN `bigquery-public-data.stackoverflow.posts_answers` a
  ON a.id = ascore.answer_id
JOIN `bigquery-public-data.stackoverflow.posts_questions` q
  ON q.id = a.parent_id,
UNNEST(
  SPLIT(REGEXP_REPLACE(q.tags, r'[<>]', ' '), ' ')
) AS tag
WHERE tag <> ''
LIMIT 20;
```

```sql
-- 9) Description: Sum those answer scores per tag
WITH answer_scores AS (
  SELECT v.post_id AS answer_id,
         10*SUM(v.vote_type_id = 2) +
         15*SUM(v.vote_type_id = 1) AS answer_score
  FROM `bigquery-public-data.stackoverflow.votes` v
  JOIN `bigquery-public-data.stackoverflow.posts_answers` a
    ON a.id = v.post_id
  WHERE a.owner_user_id = 1908967
    AND a.creation_date < TIMESTAMP '2018-06-07'
    AND v.vote_type_id IN (1,2)
  GROUP BY answer_id
),
tagged_scores AS (
  SELECT tag,
         ascore.answer_score
  FROM answer_scores AS ascore
  JOIN `bigquery-public-data.stackoverflow.posts_answers` a
    ON a.id = ascore.answer_id
  JOIN `bigquery-public-data.stackoverflow.posts_questions` q
    ON q.id = a.parent_id,
  UNNEST(SPLIT(REGEXP_REPLACE(q.tags, r'[<>]', ' '), ' ')) AS tag
  WHERE tag <> ''
)
SELECT tag,
       SUM(answer_score) AS total_tag_score
FROM tagged_scores
GROUP BY tag
ORDER BY total_tag_score DESC
LIMIT 20;
```

```sql
-- 10) Description: Final query – top‑10 tags (highest total score) for user 1908967 based on answers before 7 Jun 2018
WITH answer_scores AS (
  SELECT v.post_id AS answer_id,
         10*SUM(CASE WHEN v.vote_type_id = 2 THEN 1 ELSE 0 END) +
         15*SUM(CASE WHEN v.vote_type_id = 1 THEN 1 ELSE 0 END) AS answer_score
  FROM `bigquery-public-data.stackoverflow.votes` v
  JOIN `bigquery-public-data.stackoverflow.posts_answers` a
    ON a.id = v.post_id
  WHERE a.owner_user_id = 1908967
    AND a.creation_date < TIMESTAMP '2018-06-07'
    AND v.vote_type_id IN (1,2)
  GROUP BY answer_id
),
tagged_scores AS (
  SELECT
    tag,
    ascore.answer_score
  FROM answer_scores AS ascore
  JOIN `bigquery-public-data.stackoverflow.posts_answers` a
    ON a.id = ascore.answer_id
  JOIN `bigquery-public-data.stackoverflow.posts_questions` q
    ON q.id = a.parent_id,
  UNNEST(SPLIT(REGEXP_REPLACE(q.tags, r'[<>]', ' '), ' ')) AS tag
  WHERE tag <> ''
)
SELECT
  tag,
  SUM(answer_score) AS total_tag_score
FROM tagged_scores
GROUP BY tag
ORDER BY total_tag_score DESC
LIMIT 10;
```

