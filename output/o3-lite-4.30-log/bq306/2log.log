```sql
--Description: 
-- Goal: top‑10 tags for user 1908967, considering only answers written before 2018‑06‑07.
-- Scoring rule: 10 × (# up‑votes)  +  15 × (# accepted‑answer votes) for each answer.
-- Plan
-- 1. answer_scores  – compute the score of every qualifying answer.  
-- 2. tagged_scores  – join those answers to their parent questions, explode the
--    question’s tag string (handles either ‘<tag1><tag2>’ or ‘tag1|tag2’ formats),
--    and attach the answer’s score to every individual tag.  
-- 3. Final SELECT   – aggregate scores per tag, sort, and keep the best ten.

WITH answer_scores AS (
  SELECT
    v.post_id                                            AS answer_id,
    10 * COUNTIF(v.vote_type_id = 2) +                   -- up‑votes
    15 * COUNTIF(v.vote_type_id = 1)                     -- accepted‑answer votes
      AS answer_score
  FROM `bigquery-public-data.stackoverflow.votes`         AS v
  JOIN `bigquery-public-data.stackoverflow.posts_answers` AS a
    ON a.id = v.post_id
  WHERE a.owner_user_id = 1908967
    AND a.creation_date < TIMESTAMP '2018-06-07'
    AND v.vote_type_id IN (1, 2)                         -- keep only needed vote types
  GROUP BY answer_id
),
tagged_scores AS (
  SELECT
    TRIM(tag)                   AS tag,
    ascore.answer_score
  FROM answer_scores AS ascore
  JOIN `bigquery-public-data.stackoverflow.posts_answers`    AS a
    ON a.id = ascore.answer_id
  JOIN `bigquery-public-data.stackoverflow.posts_questions`  AS q
    ON q.id = a.parent_id
  CROSS JOIN UNNEST(
    SPLIT(
      REGEXP_REPLACE(q.tags, r'[<>]', ''),                 -- strip angle brackets
      '|'                                                  -- split on pipe (or single tag)
    )
  ) AS tag
  WHERE tag <> ''                                          -- discard empty fragments
)
SELECT
  tag,
  SUM(answer_score) AS total_tag_score
FROM tagged_scores
GROUP BY tag
ORDER BY total_tag_score DESC
LIMIT 10;
