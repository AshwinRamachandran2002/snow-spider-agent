            LOWER(f.value:"value"::STRING) LIKE '%hospital%'
         OR LOWER(f.value:"value"::STRING) LIKE '%clinic%'
         OR LOWER(f.value:"value"::STRING) LIKE '%doctors%'
          )
      AND CAST(n."longitude" AS DOUBLE) BETWEEN 31.1798246 AND 54.3798246
      AND CAST(n."latitude"  AS DOUBLE) BETWEEN 18.4519921 AND 33.6519921
)
SELECT
    h."username"  AS username,
    COUNT(*)      AS removed_nodes
FROM hist h
LEFT JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_NODES" p
       ON h."id" = p."id"
WHERE p."id" IS NULL
GROUP BY h."username"
ORDER BY removed_nodes DESC NULLS LAST, username
LIMIT 3;
