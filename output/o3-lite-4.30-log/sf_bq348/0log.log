```sql
--Description / thinking process:
--Goal: find top‑3 usernames whose historical nodes, located in the specified rectangle,
--were once tagged with amenity = hospital / clinic / doctors, but whose node‑ids are NOT
--present in today’s PLANET_NODES (i.e., they disappeared).
--Approach in a single query:
-- 1. Pull HISTORY_NODES (alias h); flatten its VARIANT column "all_tags" (alias f) to inspect key/value pairs.
-- 2. Retain rows where tag_key = 'amenity' and tag_value is one of the three health‑care strings (use ILIKE ANY for fuzziness).
-- 3. Apply the bounding‑box filter on numeric columns h."latitude" and h."longitude".
-- 4. LEFT JOIN to PLANET_NODES (alias p) on id; keep rows with p.id IS NULL (vanished).
-- 5. GROUP BY h."username" and count rows; order descending and limit to 3.

SELECT
       h."username",
       COUNT(*) AS "vanished_nodes"
FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."HISTORY_NODES" h
       , LATERAL FLATTEN(input => h."all_tags") f
       LEFT JOIN "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_NODES" p
              ON h."id" = p."id"
WHERE  f.value:"key"::STRING  = 'amenity'
  AND  f.value:"value"::STRING ILIKE ANY ('%hospital%','%clinic%','%doctors%')
  AND  h."longitude" BETWEEN 31.1798246 AND 54.3798246
  AND  h."latitude"  BETWEEN 18.4519921 AND 33.6519921
  AND  p."id" IS NULL                         -- disappeared nodes only
GROUP BY h."username"
ORDER BY "vanished_nodes" DESC
LIMIT 3;
```
