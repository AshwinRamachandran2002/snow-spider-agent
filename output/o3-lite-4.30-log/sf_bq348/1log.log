Query:
--Description: 9) Count, per username, of historical nodes whose *amenity* tag contains
--             “hospital”, “clinic”, or “doctor” **anywhere in the world** and whose IDs
--             are missing from the current PLANET_NODES table (i.e., nodes that vanished).
SELECT hn."username",
       COUNT(*) AS "disappeared_amenity_nodes"
FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.HISTORY_NODES hn
LEFT JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_NODES pn
       ON hn."id" = pn."id",
     LATERAL FLATTEN(input => hn."all_tags") tag
WHERE pn."id" IS NULL
  AND tag.value:"key"::STRING = 'amenity'
  AND ( tag.value:"value"::STRING ILIKE '%hospital%'
     OR tag.value:"value"::STRING ILIKE '%clinic%'
     OR tag.value:"value"::STRING ILIKE '%doctor%' )
GROUP BY hn."username"
ORDER BY "disappeared_amenity_nodes" DESC
LIMIT 20
