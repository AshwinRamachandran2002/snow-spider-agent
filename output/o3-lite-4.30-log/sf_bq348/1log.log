WITH hist AS (   -- all historical nodes in the bbox tagged as hospital / clinic / doctor*
    SELECT DISTINCT
           hn."id",
           hn."username"
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."HISTORY_NODES" hn,
         LATERAL FLATTEN(input => hn."all_tags") tag
    WHERE hn."latitude"  BETWEEN 18.4519921 AND 33.6519921
      AND hn."longitude" BETWEEN 31.1798246 AND 54.3798246
      AND tag.value:"key"::STRING = 'amenity'
      AND ( tag.value:"value"::STRING ILIKE 'hospital%' 
         OR tag.value:"value"::STRING ILIKE 'clinic%' 
         OR tag.value:"value"::STRING ILIKE 'doctor%' )
),                                                        
missing AS (           -- nodes that are no longer present in current planet_nodes
    SELECT
        h."id",
        h."username"
    FROM hist h
    LEFT JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_NODES" pn
           ON h."id" = pn."id"
    WHERE pn."id" IS NULL
)
SELECT
    "username",
    COUNT(*) AS removed_nodes
FROM missing
GROUP BY "username"
ORDER BY removed_nodes DESC NULLS LAST, "username"
LIMIT 3;
