WITH original_amenity_nodes AS (          -- node version when it was first created
    SELECT 
        hn."id",
        hn."username"
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."HISTORY_NODES" hn,
         LATERAL FLATTEN(input => hn."all_tags") tag
    WHERE hn."version" = 1
      AND hn."latitude"  BETWEEN 18.4519921 AND 33.6519921
      AND hn."longitude" BETWEEN 31.1798246 AND 54.3798246
      AND tag.value:"key"::STRING   = 'amenity'
      AND LOWER(tag.value:"value"::STRING) IN ('hospital','clinic','doctors')
),
removed_nodes AS (                       -- nodes that no longer exist today
    SELECT DISTINCT
        oan."id",
        oan."username"
    FROM original_amenity_nodes oan
    LEFT JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_NODES" pn
           ON oan."id" = pn."id"
    WHERE pn."id" IS NULL
)
SELECT 
    "username",
    COUNT(*) AS removed_nodes
FROM removed_nodes
GROUP BY "username"
ORDER BY removed_nodes DESC NULLS LAST, "username"
LIMIT 3;
```

