--Description:  Verify that highway ways with stored geometry fall inside a simple
--              rectangular window that approximates Denmark (longitude 8–16 E, latitude 54–58 N).
--              This avoids depending on the exact Wikidata boundary and should return rows,
--              demonstrating that geometry + spatial predicates work before re‑applying the
--              precise Denmark multipolygon.
WITH bbox AS (
    SELECT ST_MAKEPOLYGON(
             ST_MAKELINE(
                 ARRAY_CONSTRUCT(
                     ST_MAKEPOINT(8 , 54),   -- SW corner  (lon, lat)
                     ST_MAKEPOINT(16, 54),   -- SE corner
                     ST_MAKEPOINT(16, 58),   -- NE corner
                     ST_MAKEPOINT(8 , 58),   -- NW corner
                     ST_MAKEPOINT(8 , 54)    -- close ring
                 )
             )
           ) AS geom
)
SELECT  w."id",
        f.value:"value"::STRING                  AS "highway_type",
        ST_LENGTH( TO_GEOGRAPHY(w."geometry") )  AS "len_m"
FROM    "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS" w
