```sql
WITH denmark AS (
    SELECT TO_GEOGRAPHY(pr."geometry") AS geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_RELATIONS pr,
         LATERAL FLATTEN(input => pr."all_tags") tag
    WHERE tag.value:"key"  = 'wikidata'
      AND tag.value:"value" = 'Q35'
      AND pr."geometry" IS NOT NULL
      AND ST_ISVALID(TO_GEOGRAPHY(pr."geometry"))
    LIMIT 1
)
SELECT
       f.value:"value"::STRING                                AS highway_type,
       ROUND(SUM(ST_LENGTH(TO_GEOGRAPHY(w."geometry"))), 4)  AS total_length_m
FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_WAYS w
JOIN denmark d
  ON ST_INTERSECTS(d.geom, TO_GEOGRAPHY(w."geometry"))
JOIN LATERAL FLATTEN(input => w."all_tags") f
  ON f.value:"key" = 'highway'
WHERE w."geometry" IS NOT NULL
  AND ST_ISVALID(TO_GEOGRAPHY(w."geometry"))
GROUP BY highway_type
ORDER BY total_length_m DESC NULLS LAST, highway_type
LIMIT 5;
```
