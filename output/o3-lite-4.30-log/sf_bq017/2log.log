--Description: Five longest highway types inside a loose Denmark bounding box
--             (8–16 E, 54–58 N).  Uses WKT polygon to avoid earlier boundary issues.
WITH bbox AS (
    SELECT TO_GEOGRAPHY('POLYGON((8 54, 16 54, 16 58, 8 58, 8 54))') AS geom
)
SELECT  f.value:"value"::STRING                           AS "highway_type",
        SUM(ST_LENGTH(TO_GEOGRAPHY(w."geometry")))        AS "total_len_m"
FROM    "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS" w
        CROSS JOIN bbox b,
        LATERAL FLATTEN(input => w."all_tags") f
WHERE   f.value:"key"    = 'highway'
  AND   w."geometry"     IS NOT NULL
  AND   ST_INTERSECTS(b.geom, TO_GEOGRAPHY(w."geometry"))
GROUP BY 1
ORDER BY "total_len_m" DESC
LIMIT  5;
```
