```sql
--Description:  Find the five longest highway classes that lie within 300 km of the
--              point 12 E / 56 N (central Denmark).  Using ST_DWITHIN with a radius
--              avoids problems we had with exact boundaries, yet still focuses the
--              search on Denmark and its immediate surroundings.  We convert every
--              way’s geometry to GEOGRAPHY, keep only those that carry a “highway”
--              tag and have non‑NULL geometry, then sum the lengths per class and
--              return the top five.
WITH dk_center AS (
    SELECT TO_GEOGRAPHY('POINT(12 56)') AS geom   -- approx. Denmark centroid
)
SELECT  f.value:"value"::STRING                    AS "highway_type",
        SUM( ST_LENGTH( TO_GEOGRAPHY(w."geometry") ) ) AS "total_len_m"
FROM    "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
        dk_center c,
        LATERAL FLATTEN(input => w."all_tags") f
WHERE   w."geometry" IS NOT NULL
  AND   f.value:"key" = 'highway'
  AND   ST_DWITHIN( TO_GEOGRAPHY(w."geometry"), c.geom, 300000 )   -- 300 km radius
GROUP BY 1
ORDER BY "total_len_m" DESC
LIMIT  5;
```
