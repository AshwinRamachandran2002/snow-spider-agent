        LATERAL FLATTEN(input => w."all_tags") f
WHERE   f.value:"key" = 'highway'
  AND   w."geometry" IS NOT NULL
  AND   ST_INTERSECTS( b.geom, TO_GEOGRAPHY(w."geometry") )
LIMIT  20;
