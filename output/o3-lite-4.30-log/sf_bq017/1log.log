```sql
--Description: 8) Aggregate total highway length (meters) by type inside Denmark; uses TO_GEOGRAPHY.
WITH denmark AS (
    SELECT TO_GEOGRAPHY("geometry") AS geom
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" d
         , LATERAL FLATTEN(INPUT => d."all_tags") dt
    WHERE dt.value:"key"::STRING  = 'wikidata'
      AND dt.value:"value"::STRING = 'Q35'
      AND d."feature_type" = 'multipolygons'
    LIMIT 1
)
SELECT ft.value:"value"::STRING                             AS "highway_type",
       SUM( ST_LENGTH( TO_GEOGRAPHY(pf."geometry") ) )      AS "total_len_m"
FROM denmark,
     "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf
     , LATERAL FLATTEN(INPUT => pf."all_tags") ft
WHERE pf."feature_type" = 'lines'
  AND ft.value:"key"::STRING = 'highway'
  AND ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), denmark.geom )
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
--Description: 9) Same as #8 but convert totals to kilometers and round; TO_GEOGRAPHY for geometries.
WITH denmark AS (
    SELECT TO_GEOGRAPHY("geometry") AS geom
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" d
         , LATERAL FLATTEN(INPUT => d."all_tags") dt
    WHERE dt.value:"key"::STRING  = 'wikidata'
      AND dt.value:"value"::STRING = 'Q35'
      AND d."feature_type" = 'multipolygons'
    LIMIT 1
)
SELECT ft.value:"value"::STRING                    AS "highway_type",
       ROUND( SUM( ST_LENGTH( TO_GEOGRAPHY(pf."geometry") ) ) / 1000 , 2) AS "total_km"
FROM denmark,
     "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf
     , LATERAL FLATTEN(INPUT => pf."all_tags") ft
WHERE pf."feature_type" = 'lines'
  AND ft.value:"key"::STRING = 'highway'
  AND ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), denmark.geom )
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

