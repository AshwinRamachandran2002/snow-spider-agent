```sql
--Description: Identify Denmark’s multipolygon by its wikidata tag (Q35) without using an unsupported correlated FLATTEN subquery. 
--             We FLATTEN the tags once, flag rows that hold wikidata = 'Q35', then with QUALIFY keep only partitions (osm_id) 
--             where that flag exists. Finally, list every (key,value) tag for Denmark’s multipolygon.
SELECT
       t.value:"key"::STRING   AS "key",
       t.value:"value"::STRING AS "value"
FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
       LATERAL FLATTEN(INPUT => pf."all_tags") t
WHERE  pf."feature_type" = 'multipolygons'
QUALIFY MAX(CASE
               WHEN t.value:"key"::STRING  = 'wikidata'
                AND t.value:"value"::STRING = 'Q35'
             THEN 1 ELSE 0 END) 
        OVER (PARTITION BY pf."osm_id") = 1
LIMIT 20;
```
