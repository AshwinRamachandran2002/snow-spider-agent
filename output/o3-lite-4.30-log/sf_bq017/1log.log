    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" d,
         LATERAL FLATTEN(input => d."all_tags") dt
    WHERE dt.value:"key"::STRING  = 'wikidata'
      AND dt.value:"value"::STRING = 'Q35'
      AND d."feature_type" = 'multipolygons'
    LIMIT 1
)
SELECT pf."osm_way_id",
       ft.value:"value"::STRING                           AS "highway_type",
       ST_LENGTH( ST_MAKEGEOGRAPHY(pf."geometry") )       AS "len_m"
FROM denmark,
     "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf,
     LATERAL FLATTEN(input => pf."all_tags") ft
WHERE pf."feature_type" = 'lines'
  AND ft.value:"key"::STRING = 'highway'
  AND ST_INTERSECTS( ST_MAKEGEOGRAPHY(pf."geometry"), denmark.geom )
LIMIT 20;
```

