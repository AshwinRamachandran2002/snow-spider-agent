--Description: Extract Denmark’s multipolygon (tagged wikidata = 'Q35'), convert its WKB “geometry” to
--             GEOGRAPHY with TO_GEOGRAPHY, and output the WKT to verify the shape.
WITH denmark AS (
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" pf
           , LATERAL FLATTEN(INPUT => pf."all_tags") tag
    WHERE  tag.value:"key"::STRING  = 'wikidata'
      AND  tag.value:"value"::STRING = 'Q35'
      AND  pf."feature_type" = 'multipolygons'
    LIMIT 1
)
SELECT ST_ASWKT(geom) AS "wkt_sample"
FROM   denmark;
```
