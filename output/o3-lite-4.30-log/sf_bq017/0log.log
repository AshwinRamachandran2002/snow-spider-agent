```sql
/* five longest highway categories whose geometry lies inside the Denmark
   multipolygon (Wikidata = Q35)                                    */

WITH denmark AS (          -- union every Denmark multipolygon into one GEOGRAPHY
    SELECT ST_UNION_AGG( ST_GEOGFROMWKB(p."geometry") ) AS denmark_geog
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES"   p,
         LATERAL FLATTEN( INPUT => p."all_tags")                     t
    WHERE p."feature_type"                = 'multipolygons'
      AND t.value:"key"::STRING           = 'wikidata'
      AND t.value:"value"::STRING         = 'Q35'
)

SELECT
    hw.value:"value"::STRING                                   AS "highway_type",
    ROUND( SUM(
             ST_LENGTH(
               ST_INTERSECTION(
                 ST_GEOGFROMWKB(w."geometry"),                 -- way geometry
                 d.denmark_geog                                -- clipped to Denmark
               )
             )
           ), 4)                                               AS "total_length_m"
FROM  "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS"  w,
      LATERAL FLATTEN( INPUT => w."all_tags")                hw,
      denmark                                                d
WHERE w."visible"                             = TRUE
  AND hw.value:"key"::STRING                  = 'highway'     -- keep only highway ways
  AND ST_INTERSECTS(
        ST_GEOGFROMWKB(w."geometry"),
        d.denmark_geog
      )
GROUP BY hw.value:"value"::STRING
ORDER BY "total_length_m" DESC NULLS LAST, "highway_type"
LIMIT 5;
```
