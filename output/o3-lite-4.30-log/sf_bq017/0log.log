/* Return the 5 highway categories with the greatest cumulative length that
   intersect the Denmark multipolygon (identified with Wikidata = Q35). */

WITH denmark AS (  -- union any Denmark polygons into one GEOGRAPHY object
    SELECT ST_UNION_AGG( ST_GEOGFROMWKB(p."geometry") ) AS denmark_geog
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" p,
           LATERAL FLATTEN( INPUT => p."all_tags") tag
    WHERE  tag.value:"key"::STRING  = 'wikidata'
       AND tag.value:"value"::STRING = 'Q35'
       AND p."geometry" IS NOT NULL
)

SELECT
    hw.value:"value"::STRING                           AS "highway_type",
    ROUND(
        SUM(
            ST_LENGTH( ST_GEOGFROMWKB(w."geometry") )
        ),
        4
    )                                                 AS "total_length_m"
FROM   denmark d,
       "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
       LATERAL FLATTEN( INPUT => w."all_tags")        hw
WHERE  w."visible" = TRUE
  AND  w."geometry" IS NOT NULL
  AND  hw.value:"key"::STRING = 'highway'
  AND  ST_INTERSECTS(
         ST_GEOGFROMWKB(w."geometry"),
         d.denmark_geog
       )
GROUP BY "highway_type"
ORDER BY "total_length_m" DESC NULLS LAST, "highway_type"
LIMIT 5;
```
