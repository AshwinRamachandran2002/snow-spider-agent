--Description: Retrieve every key/value tag that belongs to Denmark’s administrative multipolygon
--             (identified by the tag pair wikidata = Q35).  Strategy:
--             • First CTE “denmark” selects the single multipolygon whose flattened tags include
--               wikidata/Q35 and keeps its full all_tags array.
--             • The outer query flattens that array again (alias TAG) so each individual tag appears
--               as a separate row for inspection.
--             • LIMIT 20 simply samples the output.
WITH denmark AS (
    SELECT t."all_tags"
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" t,
         LATERAL FLATTEN(input => t."all_tags") f
    WHERE t."feature_type" = 'multipolygons'
      AND f.value:"key"::STRING  = 'wikidata'
      AND f.value:"value"::STRING = 'Q35'
    LIMIT 1
)
SELECT
    tag.value:"key"::STRING   AS "tag_key",
    tag.value:"value"::STRING AS "tag_value"
FROM denmark,
     LATERAL FLATTEN(input => denmark."all_tags") tag
LIMIT 20;
```
