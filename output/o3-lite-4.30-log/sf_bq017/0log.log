```sql
/* 5 longest highway categories whose geometries intersect the Denmark
   administrative boundary (relation carrying Wikidata = Q35)       */

WITH denmark AS (
    SELECT ST_GEOGFROMWKB(r."geometry") AS denmark_geog
    FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_RELATIONS" r,
           LATERAL FLATTEN(INPUT => r."all_tags") tag
    WHERE  tag.value:"key"::STRING   = 'wikidata'
       AND tag.value:"value"::STRING = 'Q35'
       AND r."geometry" IS NOT NULL
    LIMIT 1                -- keep exactly one geometry for Denmark
)

SELECT
       hw.value:"value"::STRING                         AS "highway_type",
       ROUND(
             SUM(
                 ST_LENGTH( ST_GEOGFROMWKB(w."geometry") )
             ),
             4
       )                                               AS "total_length_m"
FROM   "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS" w
JOIN   LATERAL FLATTEN(INPUT => w."all_tags")          hw        ON TRUE
JOIN   denmark                                         d         ON
       ST_INTERSECTS( ST_GEOGFROMWKB(w."geometry"), d.denmark_geog )
WHERE  w."visible" = TRUE
  AND  w."geometry" IS NOT NULL
  AND  hw.value:"key"::STRING = 'highway'
GROUP BY "highway_type"
ORDER BY "total_length_m" DESC NULLS LAST, "highway_type"
LIMIT 5;
```
