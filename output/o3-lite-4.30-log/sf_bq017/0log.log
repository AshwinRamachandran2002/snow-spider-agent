```sql
-- 6. Description: A sample of highway ways that intersect Denmark (spatial filter).
WITH denmark AS (
    SELECT ST_GEOGFROMWKB(t."geometry") AS denmark_geog
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" t,
         LATERAL FLATTEN(input => t."all_tags") tag
    WHERE t."feature_type" = 'multipolygons'
      AND tag.value:"key"::STRING = 'wikidata'
      AND tag.value:"value"::STRING = 'Q35'
    LIMIT 1
)
SELECT 
    w."id",
    hwtag.value:"value"::STRING AS "highway_type"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
     LATERAL FLATTEN(input => w."all_tags") hwtag,
     denmark
WHERE hwtag.value:"key"::STRING = 'highway'
  AND w."visible" = TRUE
  AND ST_INTERSECTS(
