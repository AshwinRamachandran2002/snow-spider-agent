```sql
--Description: Fetch 20 highway ways whose geometries lie within 300 km of Denmark’s rough
--             geographic centre (10 °E, 56 °N).  This relaxed distance filter guarantees sample
--             rows even when a precise polygon‑intersection returns none.  Steps:
--             1) CTE “dk_centroid” creates a GEOGRAPHY point at 10 °E / 56 °N.
--             2) Flatten each way’s all_tags array to find rows that contain the key = 'highway'.
--             3) Keep only ways with non‑NULL geometries whose geodesic distance to the centroid
--                is ≤ 300 000 m (≈ 300 km).
--             4) Show way id and highway_type; LIMIT 20 for quick inspection.
WITH dk_centroid AS (
    SELECT ST_MAKEPOINT(10, 56) AS geog
)
SELECT
    w."id",
    hwtag.value:"value"::STRING AS "highway_type"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
     LATERAL FLATTEN(input => w."all_tags") hwtag,
     dk_centroid
WHERE hwtag.value:"key"::STRING = 'highway'
  AND w."geometry" IS NOT NULL
  AND ST_DWITHIN(
        ST_GEOGFROMWKB(w."geometry"),
        dk_centroid.geog,
        300000        -- radius in meters
      )
LIMIT 20;
```
