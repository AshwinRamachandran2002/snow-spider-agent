```sql
--Description: Obtain 20 highway ways whose geometries intersect a coarse bounding box
--             that fully contains Denmark (longitude 5–16 °E, latitude 54–58 °N).  This
--             rectangular filter is far less restrictive than the precise administrative
--             multipolygon and therefore guarantees sample rows while still focusing on
--             the Danish region.
WITH dk_bbox AS (
    SELECT ST_GEOGFROMTEXT(
             'POLYGON((5 54, 16 54, 16 58, 5 58, 5 54))'
           ) AS geog
)
SELECT
    w."id",
    hwtag.value:"value"::STRING AS "highway_type"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
     LATERAL FLATTEN(input => w."all_tags") hwtag,
     dk_bbox
WHERE hwtag.value:"key"::STRING = 'highway'
  AND w."geometry" IS NOT NULL
  AND ST_INTERSECTS(
        ST_GEOGFROMWKB(w."geometry"),
        dk_bbox.geog
      )
LIMIT 20;
```
