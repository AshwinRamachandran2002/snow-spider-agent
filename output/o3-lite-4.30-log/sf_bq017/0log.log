```sql
--Description: Provide a quick sample (20 rows) of highway ways that lie within 100 km of the
--             approximate geographic centre of Denmark (10 °E, 56 °N).  Using a distance
--             filter rather than the exact Denmark multipolygon ensures that some rows are
--             returned while still keeping the results in Denmark’s vicinity.
WITH dk_centroid AS (
    SELECT ST_MAKEPOINT(10, 56) AS geog          -- rough centre of Denmark
)
SELECT
    w."id",
    hwtag.value:"value"::STRING AS "highway_type",
    ST_LENGTH(ST_GEOGFROMWKB(w."geometry")) AS way_length_m
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS"  w,
     LATERAL FLATTEN(input => w."all_tags")                   hwtag,
     dk_centroid
WHERE hwtag.value:"key"::STRING = 'highway'   -- keep only highway‑tagged ways
  AND w."geometry" IS NOT NULL                -- require geometry
  AND ST_DWITHIN(
        ST_GEOGFROMWKB(w."geometry"),         -- way geometry as GEOGRAPHY
        dk_centroid.geog,                     -- Denmark centre point
        100000                                -- radius: 100 000 m (≈ 100 km)
      )
LIMIT 20;
```
