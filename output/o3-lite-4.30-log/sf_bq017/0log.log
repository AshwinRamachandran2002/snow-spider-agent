Begin Exploring Related Columns
Relevant columns and possible uses  

• GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES  
  – "geometry": polygon that describes the boundary of objects (e.g., the Denmark multipolygon); can be converted with ST_GEOGFROMWKB().  
  – "all_tags": JSON/VARIANT; filter on `"key" = 'wikidata' AND "value" = 'Q35'` to isolate the Denmark relation; also holds other tags.  
  – "feature_type": choose only 'multipolygons' so we are sure we get the boundary polygon.  

• GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_WAYS  
  – "geometry": WKB line‐strings for every way; convert to GEOGRAPHY for length & spatial overlay tests.  
  – "all_tags": filter on `"key" = 'highway'` to obtain roads; retrieve the value of “highway” (motorway, residential, etc.).  
  – "visible": keep only TRUE (current data).  
  – "id": unique OSM way id (optional in results).  

Typical conditions that might be used  
1. t."feature_type" = 'multipolygons'  
2. tag.value:"key"::STRING = 'wikidata' AND tag.value:"value"::STRING = 'Q35'  
3. hwtag.value:"key"::STRING = 'highway'  
4. w."visible" = TRUE  
5. ST_INTERSECTS( ST_GEOGFROMWKB(w."geometry"), denmark_geog )  

Below are ten step‑by‑step Snowflake SQL snippets (each limited to 20 rows) that progressively explore the data needed for the task.  

```sql
-- 1. Description: Inspect any multipolygons tagged with Wikidata Q35 (Denmark).
SELECT 
    t."feature_type",
    t."geometry",
    tag.value:"key"::STRING  AS "tag_key",
    tag.value:"value"::STRING AS "tag_val"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" t,
     LATERAL FLATTEN(input => t."all_tags") tag
WHERE t."feature_type" = 'multipolygons'
  AND tag.value:"key"::STRING = 'wikidata'
  AND tag.value:"value"::STRING = 'Q35'
LIMIT 20;
```

```sql
-- 2. Description: Preview other descriptive tags for the Denmark multipolygon.
SELECT 
    tag.*
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" t,
     LATERAL FLATTEN(input => t."all_tags") tag
WHERE t."feature_type" = 'multipolygons'
  AND EXISTS (
        SELECT 1
        FROM LATERAL FLATTEN(input => t."all_tags") f
        WHERE f.value:"key"::STRING = 'wikidata'
          AND f.value:"value"::STRING = 'Q35'
      )
LIMIT 20;
```

```sql
-- 3. Description: List a few highway ways anywhere (not spatially filtered yet).
SELECT 
    w."id",
    hwtag.value:"value"::STRING AS "highway_type",
    w."geometry"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
     LATERAL FLATTEN(input => w."all_tags") hwtag
WHERE hwtag.value:"key"::STRING = 'highway'
  AND w."visible" = TRUE
LIMIT 20;
```

```sql
-- 4. Description: Distinct highway categories present in the planet data.
SELECT DISTINCT 
    hwtag.value:"value"::STRING AS "highway_type"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
     LATERAL FLATTEN(input => w."all_tags") hwtag
WHERE hwtag.value:"key"::STRING = 'highway'
LIMIT 20;
```

```sql
-- 5. Description: Grab the Denmark polygon as GEOGRAPHY for later use.
WITH denmark AS (
    SELECT ST_GEOGFROMWKB(t."geometry") AS denmark_geog
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" t,
         LATERAL FLATTEN(input => t."all_tags") tag
    WHERE t."feature_type" = 'multipolygons'
      AND tag.value:"key"::STRING = 'wikidata'
      AND tag.value:"value"::STRING = 'Q35'
    LIMIT 1
)
SELECT * FROM denmark LIMIT 20;
```

```sql
-- 6. Description: A sample of highway ways that intersect Denmark (spatial filter).
WITH denmark AS (
    SELECT ST_GEOGFROMWKB(t."geometry") AS denmark_geog
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" t,
         LATERAL FLATTEN(input => t."all_tags") tag
    WHERE t."feature_type" = 'multipolygons'
      AND tag.value:"key"::STRING = 'wikidata'
      AND tag.value:"value"::STRING = 'Q35'
    LIMIT 1
)
SELECT 
    w."id",
    hwtag.value:"value"::STRING AS "highway_type"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
     LATERAL FLATTEN(input => w."all_tags") hwtag,
     denmark
WHERE hwtag.value:"key"::STRING = 'highway'
  AND w."visible" = TRUE
  AND ST_INTERSECTS(
        ST_GEOGFROMWKB(w."geometry"), 
        denmark.denmark_geog
      )
LIMIT 20;
```

```sql
-- 7. Description: Compute length (in meters) of each intersecting highway segment.
WITH denmark AS (
    SELECT ST_GEOGFROMWKB(t."geometry") AS denmark_geog
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" t,
         LATERAL FLATTEN(input => t."all_tags") tag
    WHERE t."feature_type" = 'multipolygons'
      AND tag.value:"key"::STRING = 'wikidata'
      AND tag.value:"value"::STRING = 'Q35'
    LIMIT 1
)
SELECT 
    w."id",
    hwtag.value:"value"::STRING       AS "highway_type",
    ST_LENGTH(ST_GEOGFROMWKB(w."geometry")) AS "way_length_m"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
     LATERAL FLATTEN(input => w."all_tags") hwtag,
     denmark
WHERE hwtag.value:"key"::STRING = 'highway'
  AND w."visible" = TRUE
  AND ST_INTERSECTS(
        ST_GEOGFROMWKB(w."geometry"), 
        denmark.denmark_geog
      )
LIMIT 20;
```

```sql
-- 8. Description: Aggregate total length per highway type (still limited).
WITH denmark AS (
    SELECT ST_GEOGFROMWKB(t."geometry") AS denmark_geog
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" t,
         LATERAL FLATTEN(input => t."all_tags") tag
    WHERE t."feature_type" = 'multipolygons'
      AND tag.value:"key"::STRING = 'wikidata'
      AND tag.value:"value"::STRING = 'Q35'
    LIMIT 1
)
SELECT 
    hwtag.value:"value"::STRING       AS "highway_type",
    SUM(
        ST_LENGTH(ST_GEOGFROMWKB(w."geometry"))
    ) AS "total_length_m"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
     LATERAL FLATTEN(input => w."all_tags") hwtag,
     denmark
WHERE hwtag.value:"key"::STRING = 'highway'
  AND w."visible" = TRUE
  AND ST_INTERSECTS(
        ST_GEOGFROMWKB(w."geometry"), 
        denmark.denmark_geog
      )
GROUP BY hwtag.value:"value"::STRING
LIMIT 20;
```

```sql
-- 9. Description: Order the aggregated list by length descending.
WITH denmark AS (
    SELECT ST_GEOGFROMWKB(t."geometry") AS denmark_geog
    FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_FEATURES" t,
         LATERAL FLATTEN(input => t."all_tags") tag
    WHERE t."feature_type" = 'multipolygons'
      AND tag.value:"key"::STRING = 'wikidata'
      AND tag.value:"value"::STRING = 'Q35'
    LIMIT 1
)
SELECT 
    hwtag.value:"value"::STRING       AS "highway_type",
    SUM(
        ST_LENGTH(ST_GEOGFROMWKB(w."geometry"))
    ) AS "total_length_m"
FROM "GEO_OPENSTREETMAP"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
     LATERAL FLATTEN(input => w."all_tags") hwtag,
     denmark
WHERE hwtag.value:"key"::STRING = 'highway'
  AND w."visible" = TRUE
  AND ST_INTERSECTS(
        ST_GEOGFROMWKB(w."geometry"), 
        denmark.denmark_geog
      )
GROUP BY hwtag.value:"value"::STRING
ORDER BY "total_length_m" DESC
LIMIT 20;
```

