  WHERE spc_latin IS NOT NULL
    AND spc_latin <> ''
  GROUP BY latin_name
),

-- 2015 census summary ---------------------------------------------------------
c2015 AS (
  SELECT
    UPPER(spc_latin)                                   AS latin_name,
    ANY_VALUE(spc_common)                              AS common_name_2015,
    COUNT(*)                                           AS total_2015,
    SUM(CASE WHEN UPPER(status) IN ('DEAD','STUMP')
             THEN 1 ELSE 0 END)                       AS dead_2015,
    SUM(CASE WHEN UPPER(status) IN ('DEAD','STUMP')
             THEN 0 ELSE 1 END)                       AS alive_2015
