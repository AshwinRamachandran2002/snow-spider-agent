-- Top‑10 NY tree species: counts & growth between 1995 and 2015
WITH c1995 AS (
  SELECT
    UPPER(spc_latin)                           AS latin_name,
    ANY_VALUE(spc_common)                      AS common_name_1995,
    COUNT(*)                                   AS total_1995,
    SUM(CASE WHEN UPPER(status) IN ('DEAD','STUMP') THEN 1 ELSE 0 END) AS dead_1995,
    SUM(CASE WHEN UPPER(status) IN ('DEAD','STUMP') THEN 0 ELSE 1 END) AS alive_1995
  FROM `bigquery-public-data.new_york.tree_census_1995`
  WHERE spc_latin IS NOT NULL
    AND spc_latin <> ''
  GROUP BY latin_name
),
c2015 AS (
  SELECT
    UPPER(spc_latin)                           AS latin_name,
    ANY_VALUE(spc_common)                      AS common_name_2015,
    COUNT(*)                                   AS total_2015,
    SUM(CASE WHEN UPPER(status) IN ('DEAD','STUMP') THEN 1 ELSE 0 END) AS dead_2015,
    SUM(CASE WHEN UPPER(status) IN ('DEAD','STUMP') THEN 0 ELSE 1 END) AS alive_2015
  FROM `bigquery-public-data.new_york.tree_census_2015`
  WHERE spc_latin IS NOT NULL
    AND spc_latin <> ''
  GROUP BY latin_name
),
merged AS (
  SELECT
    c2015.latin_name,
    COALESCE(c2015.common_name_2015, c1995.common_name_1995) AS common_name,
    c1995.total_1995,
    c2015.total_2015,
    c2015.total_2015 - c1995.total_1995                      AS growth_total,
    c1995.alive_1995,
    c2015.alive_2015,
    c2015.alive_2015 - c1995.alive_1995                      AS growth_alive,
    c1995.dead_1995,
    c2015.dead_2015,
    c2015.dead_2015 - c1995.dead_1995                        AS growth_dead
  FROM c1995
  JOIN c2015 USING (latin_name)
)
SELECT
  latin_name,
  common_name,
  total_1995,
  total_2015,
  growth_total,
  alive_1995,
  alive_2015,
  growth_alive,
  dead_1995,
  dead_2015,
  growth_dead
FROM merged
ORDER BY growth_total DESC, latin_name
LIMIT 10;Empty results in Column ['dead_2015']. Please correct them.

