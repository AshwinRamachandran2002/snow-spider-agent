```sql
-- 10. Final‑style query assembling counts & growth (alive / dead / totals) between 1995 and 2015
WITH base_1995 AS (
  SELECT UPPER(spc_latin) AS latin_name,
         spc_common,
         COUNT(*) AS total_1995,
         SUM(CASE WHEN UPPER(status) IN ('DEAD','STUMP') THEN 1 ELSE 0 END)  AS dead_1995,
         SUM(CASE WHEN UPPER(status) NOT IN ('DEAD','STUMP') THEN 1 ELSE 0 END) AS alive_1995
  FROM `bigquery-public-data.new_york.tree_census_1995`
  WHERE spc_latin IS NOT NULL AND spc_latin <> ''
  GROUP BY latin_name, spc_common
),
base_2015 AS (
  SELECT UPPER(spc_latin) AS latin_name,
         COUNT(*) AS total_2015,
         SUM(CASE WHEN UPPER(status) IN ('DEAD','STUMP') THEN 1 ELSE 0 END)  AS dead_2015,
         SUM(CASE WHEN UPPER(status) NOT IN ('DEAD','STUMP') THEN 1 ELSE 0 END) AS alive_2015
  FROM `bigquery-public-data.new_york.tree_census_2015`
  WHERE spc_latin IS NOT NULL AND spc_latin <> ''
  GROUP BY latin_name
),
merged AS (
  SELECT b15.latin_name,
         b95.spc_common                                         AS common_name,
         total_1995, total_2015,
         alive_1995, alive_2015,
         dead_1995,  dead_2015,
         total_2015 - total_1995 AS diff_total,
         alive_2015 - alive_1995 AS diff_alive,
         dead_2015  - dead_1995  AS diff_dead
  FROM base_1995 b95
  JOIN base_2015 b15 USING(latin_name)
)
SELECT latin_name,
       common_name,
       total_1995, alive_1995, dead_1995,
       total_2015, alive_2015, dead_2015,
       diff_total, diff_alive, diff_dead
FROM merged
ORDER BY diff_total DESC
LIMIT 20;
```

