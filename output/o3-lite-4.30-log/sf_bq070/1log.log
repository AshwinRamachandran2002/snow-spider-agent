```sql
--Description: (#9) Count normal vs. tumor SM slides (by SNOMED code) within lung TCGA
--collections (luad/lusc substrings), considering only JPEG/JPEG2000 compressed VOLUME images.
WITH base AS (
  SELECT t."SOPInstanceUID",
         CASE sd.value:"CodeValue"::STRING
              WHEN '17621005' THEN 'normal'
              WHEN '86049000' THEN 'tumor'
         END AS tissue_type
  FROM   "IDC"."IDC_V17"."DICOM_ALL" t,
         LATERAL FLATTEN (input => t."SpecimenDescriptionSequence") sd
  WHERE  t."Modality" = 'SM'
    AND EXISTS (SELECT 1 FROM LATERAL FLATTEN (input => t."ImageType") it WHERE it.value::STRING = 'VOLUME')
    AND t."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',
                                  '1.2.840.10008.1.2.4.90','1.2.840.10008.1.2.4.91',
                                  '1.2.840.10008.1.2.4.92','1.2.840.10008.1.2.4.93')
    AND sd.value:"CodeValue"::STRING IN ('17621005','86049000')
    AND (
          LOWER(t."collection_id")   LIKE '%luad%'  OR
          LOWER(t."collection_id")   LIKE '%lusc%'  OR
          LOWER(t."collection_name") LIKE '%luad%'  OR
          LOWER(t."collection_name") LIKE '%lusc%'
        )
)
SELECT tissue_type,
       COUNT(DISTINCT "SOPInstanceUID") AS slide_count
FROM   base
GROUP  BY tissue_type
LIMIT 20;
```

```sql
--Description: (#10) Assemble the requested metadata for SM VOLUME slides in TCGA-LUAD/LUSC
--collections (identified via luad/lusc substrings) that are JPEG/JPEG2000 compressed,
--contain tissue freezing medium, and encode normal (17621005) or tumor (86049000) tissue.
SELECT
    t."SeriesInstanceUID"                     AS "digital_slide_id",
    t."StudyInstanceUID"                      AS "case_id",
    sd.value:"SpecimenUID"::STRING            AS "physical_slide_id",
    t."PatientID"                             AS "patient_id",
    t."collection_id"                         AS "collection_id",
    t."SOPInstanceUID"                        AS "instance_id",
    t."gcs_url"                               AS "gcs_url",
    t."Columns"                               AS "width_px",
    t."Rows"                                  AS "height_px",
    ARRAY_TO_STRING(t."PixelSpacing", ',')    AS "pixel_spacing_mm",
    CASE
        WHEN t."TransferSyntaxUID" = '1.2.840.10008.1.2.4.50' THEN 'jpeg'
        WHEN t."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.90',
                                       '1.2.840.10008.1.2.4.91',
                                       '1.2.840.10008.1.2.4.92',
                                       '1.2.840.10008.1.2.4.93') THEN 'jpeg2000'
        ELSE 'other'
    END                                           AS "compression_type",
    CASE sd.value:"CodeValue"::STRING
         WHEN '17621005' THEN 'normal'
         WHEN '86049000' THEN 'tumor'
    END                                           AS "tissue_type",
    CASE
        WHEN LOWER(t."collection_id") LIKE '%luad%'  THEN 'luad'
        WHEN LOWER(t."collection_id") LIKE '%lusc%'  THEN 'lscc'
    END                                           AS "cancer_subtype"
FROM   "IDC"."IDC_V17"."DICOM_ALL" t
       , LATERAL FLATTEN (input => t."SpecimenDescriptionSequence") sd
       , LATERAL FLATTEN (input => t."AcquisitionContextSequence")  ac
WHERE  t."Modality" = 'SM'
  AND EXISTS (SELECT 1 FROM LATERAL FLATTEN (input => t."ImageType") it WHERE it.value::STRING = 'VOLUME')
  AND t."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',
                                '1.2.840.10008.1.2.4.90','1.2.840.10008.1.2.4.91',
                                '1.2.840.10008.1.2.4.92','1.2.840.10008.1.2.4.93')
  AND sd.value:"CodeValue"::STRING IN ('17621005','86049000')
  AND ILIKE(ac.value:"TextValue"::STRING, '%tissue%freezing%medium%')
  AND (
        LOWER(t."collection_id")   LIKE '%luad%'  OR
        LOWER(t."collection_id")   LIKE '%lusc%'  OR
        LOWER(t."collection_name") LIKE '%luad%'  OR
        LOWER(t."collection_name") LIKE '%lusc%'
      )
ORDER BY t."SOPInstanceUID"
LIMIT 20;
