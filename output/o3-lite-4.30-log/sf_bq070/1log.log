FROM "IDC"."IDC_V17"."DICOM_ALL" t,
     LATERAL FLATTEN(input => t."AcquisitionContextSequence") ac
WHERE t."Modality" = 'SM'
  AND (t."collection_id" ILIKE 'tcga-luad' OR t."collection_id" ILIKE 'tcga-lusc')
  AND ILIKE(ac.value:"TextValue"::STRING, '%tissue%freezing%medium%')
LIMIT 20;
```

```sql
-- 7️⃣  Collect rows whose SpecimenDescriptionSequence contains tissue codes 17621005 or 86049000.
SELECT DISTINCT t."SOPInstanceUID",
       sd.value:"CodeValue"::STRING AS "code_val",
       sd.value:"CodeMeaning"::STRING AS "code_meaning"
FROM "IDC"."IDC_V17"."DICOM_ALL" t,
     LATERAL FLATTEN(input => t."SpecimenDescriptionSequence") sd
WHERE t."Modality" = 'SM'
  AND (t."collection_id" ILIKE 'tcga-luad' OR t."collection_id" ILIKE 'tcga-lusc')
  AND sd.value:"CodeValue"::STRING IN ('17621005', '86049000')
LIMIT 20;
```

```sql
-- 8️⃣  Verify pixel spacing values for a few candidate slides.
SELECT t."SOPInstanceUID",
       t."Rows"  AS "height_px",
       t."Columns" AS "width_px",
       ps.value::FLOAT AS "pixel_spacing_mm"
FROM "IDC"."IDC_V17"."DICOM_ALL" t,
     LATERAL FLATTEN(input => t."PixelSpacing") ps
WHERE t."Modality" = 'SM'
  AND ARRAY_CONTAINS(t."ImageType", 'VOLUME')
  AND t."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',
                                '1.2.840.10008.1.2.4.90','1.2.840.10008.1.2.4.91',
                                '1.2.840.10008.1.2.4.92','1.2.840.10008.1.2.4.93')
LIMIT 20;
```

```sql
-- 9️⃣  Aggregate counts of normal vs tumor tissue within the eligible rows.
SELECT CASE sd.value:"CodeValue"::STRING
           WHEN '17621005' THEN 'normal'
           WHEN '86049000' THEN 'tumor'
       END                           AS "tissue_type",
       COUNT(DISTINCT t."SOPInstanceUID") AS "slide_count"
FROM "IDC"."IDC_V17"."DICOM_ALL" t,
     LATERAL FLATTEN(input => t."SpecimenDescriptionSequence") sd
WHERE t."Modality" = 'SM'
  AND ARRAY_CONTAINS(t."ImageType", 'VOLUME')
  AND t."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',
                                '1.2.840.10008.1.2.4.90','1.2.840.10008.1.2.4.91',
                                '1.2.840.10008.1.2.4.92','1.2.840.10008.1.2.4.93')
  AND ILIKE(ANY_VALUE(ac.value:"TextValue"::STRING), '%tissue%freezing%medium%')
  AND (t."collection_id" ILIKE 'tcga-luad' OR t."collection_id" ILIKE 'tcga-lusc')
GROUP BY 1
LIMIT 20;
```

```sql
-- 🔟  Final‑form query assembling the requested metadata (limit 20 for test; remove limit for full run).
SELECT
    t."SeriesInstanceUID"                    AS "digital_slide_id",
    t."StudyInstanceUID"                     AS "case_id",
    sd.value:"SpecimenUID"::STRING           AS "physical_slide_id",
    t."PatientID"                            AS "patient_id",
    t."collection_id"                        AS "collection_id",
    t."SOPInstanceUID"                       AS "instance_id",
    t."gcs_url"                              AS "gcs_url",
    t."Columns"                              AS "width_px",
    t."Rows"                                 AS "height_px",
    ARRAY_TO_STRING(t."PixelSpacing", ',')   AS "pixel_spacing_mm",
    CASE
        WHEN t."TransferSyntaxUID" = '1.2.840.10008.1.2.4.50' THEN 'jpeg'
        WHEN t."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.90',
                                       '1.2.840.10008.1.2.4.91',
                                       '1.2.840.10008.1.2.4.92',
                                       '1.2.840.10008.1.2.4.93')
             THEN 'jpeg2000'
        ELSE 'other'
    END                                       AS "compression_type",
    CASE sd.value:"CodeValue"::STRING
         WHEN '17621005' THEN 'normal'
         WHEN '86049000' THEN 'tumor'
    END                                       AS "tissue_type",
    CASE
        WHEN LOWER(t."collection_id") = 'tcga-luad' THEN 'luad'
        WHEN LOWER(t."collection_id") = 'tcga-lusc' THEN 'lscc'
    END                                       AS "cancer_subtype"
FROM "IDC"."IDC_V17"."DICOM_ALL" t
     -- Tissue code extraction
     , LATERAL FLATTEN(input => t."SpecimenDescriptionSequence") sd
     -- Embedding medium verification
     , LATERAL FLATTEN(input => t."AcquisitionContextSequence") ac
WHERE t."Modality" = 'SM'
  AND ARRAY_CONTAINS(t."ImageType", 'VOLUME')
  AND t."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',
                                '1.2.840.10008.1.2.4.90','1.2.840.10008.1.2.4.91',
                                '1.2.840.10008.1.2.4.92','1.2.840.10008.1.2.4.93')
  AND sd.value:"CodeValue"::STRING IN ('17621005', '86049000')
  AND ILIKE(ac.value:"TextValue"::STRING, '%tissue%freezing%medium%')
  AND (t."collection_id" ILIKE 'tcga-luad' OR t."collection_id" ILIKE 'tcga-lusc')
ORDER BY t."SOPInstanceUID" ASC
LIMIT 20;
```

The final query (#10) can be executed without the `LIMIT` clause to obtain the complete, clean dataset required for downstream analysis.
