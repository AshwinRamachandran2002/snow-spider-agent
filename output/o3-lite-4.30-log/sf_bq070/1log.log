       sd.value:"CodeValue"::STRING      AS "code_val",
       sd.value:"CodeMeaning"::STRING    AS "code_meaning"
FROM "IDC"."IDC_V17"."DICOM_ALL" t,
     LATERAL FLATTEN(input => t."SpecimenDescriptionSequence") sd
WHERE t."Modality" = 'SM'
  AND (t."collection_id" ILIKE 'tcga-luad' OR t."collection_id" ILIKE 'tcga-lusc')
  AND sd.value IS NOT NULL
