--Description: 2️⃣  Verify that SM modality exists in LUAD / LUSC collections
--The collection IDs may not exactly equal 'tcga-luad' or 'tcga-lusc', so
--match either column by a broad, case‑insensitive substring search.
SELECT DISTINCT "Modality"
FROM IDC.IDC_V17.DICOM_ALL
WHERE ("collection_id"   ILIKE '%luad%' OR "collection_name" ILIKE '%luad%'
    OR  "collection_id"   ILIKE '%lusc%' OR "collection_name" ILIKE '%lusc%')
  AND "Modality" IS NOT NULL
LIMIT 20
