/*  Digital slides from TCGA‑LUAD and TCGA‑LUSC that
    – are SM / VOLUME images,
    – are JPEG or JPEG2000 compressed,
    – have “Tissue freezing medium” as embedding medium,
    – contain normal (17621005) or tumor (86049000) tissue                */

SELECT
    d."SeriesInstanceUID"                                            AS digital_slide_id,     -- slide (= series) UID
    d."StudyInstanceUID"                                             AS case_id,              -- study UID
    d."InstanceNumber"                                               AS physical_slide_id,    -- laboratory slide number
    d."PatientID"                                                    AS patient_id,           -- submitter‑provided
    d."collection_id"                                                AS collection_id,        -- tcga-luad / tcga-lusc
    d."SOPInstanceUID"                                               AS instance_id,          -- instance UID
    d."gcs_url"                                                      AS gcs_url,              -- GCS location
    d."Columns"                                                      AS width_px,             -- pixel width
    d."Rows"                                                         AS height_px,            -- pixel height
    d."PixelSpacing"::STRING                                         AS pixel_spacing_mm_per_px,
    CASE                                                             -- compression label
        WHEN d."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',
                                       '1.2.840.10008.1.2.4.51',
                                       '1.2.840.10008.1.2.4.57',
                                       '1.2.840.10008.1.2.4.70')    THEN 'jpeg'
        WHEN d."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.90',
                                       '1.2.840.10008.1.2.4.91')    THEN 'jpeg2000'
    END                                                              AS compression_type,
    CASE ar.code_value
        WHEN '17621005' THEN 'normal'
        WHEN '86049000' THEN 'tumor'
    END                                                              AS tissue_type,
    CASE LOWER(d."collection_id")
        WHEN 'tcga-luad' THEN 'luad'
        WHEN 'tcga-lusc' THEN 'lscc'
    END                                                              AS cancer_subtype
FROM   IDC.IDC_V17."DICOM_ALL" d
       /* one matching anatomy code (normal / tumor) */
       , LATERAL (
           SELECT  ar.value:"CodeValue"::STRING AS code_value
           FROM   TABLE(FLATTEN(INPUT => d."AnatomicRegionSequence")) ar
           WHERE  ar.value:"CodeValue"::STRING IN ('17621005','86049000')
           LIMIT 1
         ) ar
WHERE  d."collection_id" IN ('tcga-luad','tcga-lusc')
  AND  d."Modality" = 'SM'
  /* image is a VOLUME slide */
  AND  EXISTS (
         SELECT 1
         FROM   TABLE(FLATTEN(INPUT => d."ImageType")) it
         WHERE  it.value::STRING ILIKE '%VOLUME%'
       )
  /* embedding medium = Tissue freezing medium */
  AND  EXISTS (
         SELECT 1
         FROM   TABLE(FLATTEN(INPUT => d."SpecimenDescriptionSequence")) sd
         WHERE  LOWER(sd.value::STRING) ILIKE '%tissue freezing medium%'
       )
  /* JPEG / JPEG2000 transfer syntaxes only */
  AND  d."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',
                                 '1.2.840.10008.1.2.4.51',
                                 '1.2.840.10008.1.2.4.57',
                                 '1.2.840.10008.1.2.4.70',
                                 '1.2.840.10008.1.2.4.90',
                                 '1.2.840.10008.1.2.4.91')
ORDER BY instance_id ASC;
```
