/*  TCGA‑LUAD / TCGA‑LUSC SM VOLUME slides
    JPEG / JPEG2000 only, embedding medium = “Tissue freezing medium”,
    tissue type = normal (17621005) or tumor (86049000)               */

SELECT DISTINCT
       d."SeriesInstanceUID"                         AS digital_slide_id,
       d."StudyInstanceUID"                          AS case_id,
       d."InstanceNumber"                            AS physical_slide_id,
       d."PatientID"                                 AS patient_id,
       d."collection_id"                             AS collection_id,
       d."SOPInstanceUID"                            AS instance_id,
       d."gcs_url"                                   AS gcs_url,
       d."Columns"                                   AS width_px,
       d."Rows"                                      AS height_px,
       d."PixelSpacing"::STRING                      AS pixel_spacing_mm_per_px,
       CASE
         WHEN d."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',
                                        '1.2.840.10008.1.2.4.51',
                                        '1.2.840.10008.1.2.4.57',
                                        '1.2.840.10008.1.2.4.70') THEN 'jpeg'
         WHEN d."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.90',
                                        '1.2.840.10008.1.2.4.91') THEN 'jpeg2000'
       END                                           AS compression_type,
       CASE ar.value:"CodeValue"::STRING
         WHEN '17621005' THEN 'normal'
         WHEN '86049000' THEN 'tumor'
       END                                           AS tissue_type,
       CASE LOWER(d."collection_id")
         WHEN 'tcga-luad' THEN 'luad'
         WHEN 'tcga-lusc' THEN 'lscc'
       END                                           AS cancer_subtype
FROM   IDC.IDC_V17."DICOM_ALL" d
       , LATERAL FLATTEN(INPUT => d."ImageType")                it   -- ensure VOLUME
       , LATERAL FLATTEN(INPUT => d."AnatomicRegionSequence")   ar   -- tissue code
       , LATERAL FLATTEN(INPUT => d."SpecimenDescriptionSequence") sd -- embedding medium
WHERE  d."collection_id"              IN ('tcga-luad', 'tcga-lusc')
  AND  d."Modality"                   =  'SM'
  AND  it.value::STRING               ILIKE '%VOLUME%'
  AND  ar.value:"CodeValue"::STRING   IN ('17621005','86049000')
  AND  LOWER(sd.value::STRING)        ILIKE '%tissue freezing medium%'
  AND  d."TransferSyntaxUID"          IN ('1.2.840.10008.1.2.4.50',
                                          '1.2.840.10008.1.2.4.51',
