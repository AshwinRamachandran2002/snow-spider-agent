WITH base AS (
    SELECT *
    FROM "IDC"."IDC_V17"."DICOM_ALL"
    WHERE "collection_id" IN ('tcga_luad', 'tcga_lusc')
      AND "Modality" = 'SM'
      AND (   "ImageType" ILIKE '%VOLUME%'
           OR "FrameType" ILIKE '%VOLUME%' )
      AND "TransferSyntaxUID" IN ( '1.2.840.10008.1.2.4.50',   -- JPEG
                                   '1.2.840.10008.1.2.4.70',
                                   '1.2.840.10008.1.2.4.90',
                                   '1.2.840.10008.1.2.4.91',
                                   '1.2.840.10008.1.2.4.95')    -- JPEG‑2000
),
specimen_flags AS (
    SELECT
        b."SeriesInstanceUID"                                    AS digital_slide_id,
        b."idc_case_id"                                          AS case_id,
        b."ContainerIdentifier"                                  AS physical_slide_id,
        b."PatientID"                                            AS patient_id,
        b."collection_id"                                        AS collection_id,
        b."SOPInstanceUID"                                       AS instance_id,
        b."gcs_url"                                              AS gcs_url,
        b."Columns"                                              AS width_px,
        b."Rows"                                                 AS height_px,
        COALESCE(b."ImagerPixelSpacing", b."PixelSpacing")       AS pixel_spacing_mm_per_px,
        CASE
             WHEN b."TransferSyntaxUID" = '1.2.840.10008.1.2.4.95' THEN 'jpeg2000'
             ELSE 'jpeg'
        END                                                      AS compression_type,
        MAX(CASE WHEN f.value::STRING ILIKE '%freezing%medium%' THEN 1 ELSE 0 END)  AS has_freezing_medium,
        MAX(CASE WHEN f.value::STRING ILIKE '%17621005%'        THEN 1 ELSE 0 END)  AS has_normal_code,
        MAX(CASE WHEN f.value::STRING ILIKE '%86049000%'        THEN 1 ELSE 0 END)  AS has_tumor_code
    FROM   base b,
           LATERAL FLATTEN(input => b."SpecimenDescriptionSequence") f
    GROUP  BY
        digital_slide_id, case_id, physical_slide_id, patient_id,
        collection_id, instance_id, gcs_url, width_px, height_px,
        pixel_spacing_mm_per_px, compression_type
)
SELECT
    digital_slide_id,
    case_id,
    physical_slide_id,
    patient_id,
    collection_id,
    instance_id,
    gcs_url,
    width_px,
    height_px,
    pixel_spacing_mm_per_px,
    compression_type,
    CASE
         WHEN has_normal_code = 1 THEN 'normal'
         WHEN has_tumor_code  = 1 THEN 'tumor'
    END  AS tissue_type,
    CASE
         WHEN collection_id = 'tcga_luad' THEN 'luad'
         ELSE 'lscc'
    END  AS cancer_subtype
FROM   specimen_flags
WHERE  has_freezing_medium = 1
  AND (has_normal_code = 1 OR has_tumor_code = 1)
ORDER BY instance_id ASC;
```
