```sql
--Description: Integrated query that performs all required filters in‑line.
-- Each comment line explains the thinking behind the immediately following clause.

SELECT
       /* unique identifier of the DICOM instance (slide file) */
       d."SOPInstanceUID"                      AS "instance_id",

       /* treat SeriesInstanceUID as the digital‑slide ID (all SM WSIs have one instance per series) */
       d."SeriesInstanceUID"                   AS "digital_slide_id",

       /* physical glass‑slide barcode recorded by submitter */
       d."ContainerIdentifier"                 AS "physical_slide_id",

       /* patient and case identifiers */
       d."PatientID"                           AS "patient_id",
       d."idc_case_id"                         AS "case_id",

       /* original TCGA collection */
       d."collection_id",

       /* derive cancer subtype directly from collection_id */
       CASE WHEN d."collection_id" = 'tcga_luad'  THEN 'luad'
            WHEN d."collection_id" = 'tcga_lusc' THEN 'lscc'
       END                                      AS "cancer_subtype",

       /* Google Cloud Storage URL of the DICOM file */
       d."gcs_url",

       /* image dimensions */
       d."Columns"                             AS "width_px",
       d."Rows"                                AS "height_px",

       /* pixel spacing (prefer ImagerPixelSpacing, fall back to PixelSpacing) */
       COALESCE(d."ImagerPixelSpacing", d."PixelSpacing") AS "pixel_spacing",

       /* classify compression type from TransferSyntaxUID */
       CASE WHEN d."TransferSyntaxUID" = '1.2.840.10008.1.2.4.95'
            THEN 'jpeg2000'
            ELSE 'jpeg'
       END                                      AS "compression_type",

       /* deduce tissue_type from presence of SNOMED codes in SpecimenDescriptionSequence */
       CASE
            WHEN EXISTS (
                  SELECT 1
                  FROM   TABLE(FLATTEN(input => d."SpecimenDescriptionSequence")) t
                  WHERE  t.value::STRING ILIKE '%86049000%'            -- tumor
                 )
            THEN 'tumor'
            ELSE 'normal'                                             -- 17621005 found via filter below
       END                                      AS "tissue_type"

FROM   "IDC"."IDC_V17"."DICOM_ALL" d

/* keep only LUAD or LUSC TCGA collections */
WHERE  d."collection_id" IN ('tcga_luad','tcga_lusc')

/* slide‑microscopy images */
  AND  d."Modality" = 'SM'

/* restrict to whole‑slide (volume) images; the keyword may appear in ImageType or FrameType */
  AND  (d."ImageType" ILIKE '%VOLUME%' OR d."FrameType" ILIKE '%VOLUME%')

/* allow only JPEG or JPEG‑2000 compressed instances */
  AND  d."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',           -- JPEG baseline
                                 '1.2.840.10008.1.2.4.70',           -- JPEG lossless
                                 '1.2.840.10008.1.2.4.90',           -- JPEG‑LS
                                 '1.2.840.10008.1.2.4.91',           -- JPEG‑LS lossless
                                 '1.2.840.10008.1.2.4.95')           -- JPEG‑2000

/* make sure specimen preparation step mentions Tissue freezing medium */
  AND EXISTS (
        SELECT 1
        FROM   TABLE(FLATTEN(input => d."SpecimenDescriptionSequence")) s
        WHERE  s.value::STRING ILIKE '%freezing%medium%'
      )

/* ensure the specimen encodes either normal (17621005) or tumor (86049000) tissue */
  AND EXISTS (
        SELECT 1
        FROM   TABLE(FLATTEN(input => d."SpecimenDescriptionSequence")) c
        WHERE  c.value::STRING ILIKE '%17621005%'     -- normal
           OR  c.value::STRING ILIKE '%86049000%'     -- tumor
      )

/* sort to satisfy output requirement */
ORDER BY "instance_id";
```
