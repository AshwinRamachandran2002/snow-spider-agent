            THEN 'tumor'
            ELSE 'normal'
       END                                       AS "tissue_type"

FROM   "IDC"."IDC_V17"."DICOM_ALL" d

/* 1 ─ Only TCGA‑LUAD and TCGA‑LUSC collections */
WHERE  d."collection_id" IN ('tcga_luad','tcga_lusc')

/* 2 ─ Slide‑microscopy modality */
