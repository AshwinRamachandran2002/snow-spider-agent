--Description: 
-- One complete statement that retrieves whole‑slide microscopy (SM) VOLUME images
-- from TCGA‑LUAD and TCGA‑LUSC.  Filtering logic (explained inline):
--   1. collection_id ∈ {tcga_luad, tcga_lusc}          → target datasets.
--   2. Modality = 'SM'                                 → slide‑microscopy instances.
--   3. ImageType OR FrameType contains 'VOLUME'        → full‑slide images only.
--   4. TransferSyntaxUID in JPEG / JPEG‑2000 list      → exclude “other” compression.
--   5. SpecimenDescriptionSequence contains the phrase
--      “Tissue freezing medium”                        → embedding method constraint.
--   6. Same sequence contains SNOMED code 17621005
--      (normal) OR 86049000 (tumor)                    → tissue‑type constraint.
-- Output columns satisfy requested metadata; cancer_subtype, compression_type and
-- tissue_type are derived on the fly.  Sorted by instance_id for reproducibility.

SELECT
       d."SOPInstanceUID"                                   AS "instance_id",       -- unique file
       d."SeriesInstanceUID"                                AS "digital_slide_id",  -- slide
       d."ContainerIdentifier"                              AS "physical_slide_id", -- glass‑slide barcode
       d."PatientID"                                        AS "patient_id",
       d."idc_case_id"                                      AS "case_id",
       d."collection_id",
       CASE WHEN d."collection_id" = 'tcga_luad'  THEN 'luad'
            WHEN d."collection_id" = 'tcga_lusc' THEN 'lscc'
       END                                                  AS "cancer_subtype",
       d."gcs_url",
       d."Columns"                                          AS "width_px",
       d."Rows"                                             AS "height_px",
       COALESCE(d."ImagerPixelSpacing", d."PixelSpacing")   AS "pixel_spacing",
       CASE WHEN d."TransferSyntaxUID" = '1.2.840.10008.1.2.4.95'
            THEN 'jpeg2000' ELSE 'jpeg' END                 AS "compression_type",
       CASE WHEN EXISTS (
                SELECT 1
                FROM   TABLE(FLATTEN(input => d."SpecimenDescriptionSequence")) ts
                WHERE  ts.value::STRING ILIKE '%86049000%' ) -- tumor code present
            THEN 'tumor'
            ELSE 'normal'                                   -- otherwise normal
       END                                                  AS "tissue_type"
FROM   "IDC"."IDC_V17"."DICOM_ALL" d
WHERE  d."collection_id" IN ('tcga_luad','tcga_lusc')          -- (1)
  AND  d."Modality" = 'SM'                                     -- (2)
  AND  (d."ImageType" ILIKE '%VOLUME%' OR d."FrameType" ILIKE '%VOLUME%')  -- (3)
  AND  d."TransferSyntaxUID" IN (                              -- (4)
        '1.2.840.10008.1.2.4.50',  -- JPEG baseline
        '1.2.840.10008.1.2.4.70',  -- JPEG lossless
        '1.2.840.10008.1.2.4.90',  -- JPEG‑LS
        '1.2.840.10008.1.2.4.91',  -- JPEG‑LS lossless
        '1.2.840.10008.1.2.4.95')  -- JPEG‑2000
  AND EXISTS (                                                   -- (5)
        SELECT 1
        FROM   TABLE(FLATTEN(input => d."SpecimenDescriptionSequence")) fm
        WHERE  fm.value::STRING ILIKE '%freezing%medium%' )
  AND EXISTS (                                                   -- (6)
        SELECT 1
        FROM   TABLE(FLATTEN(input => d."SpecimenDescriptionSequence")) tc
        WHERE  tc.value::STRING ILIKE '%17621005%'   -- normal
           OR  tc.value::STRING ILIKE '%86049000%'   -- tumor
      )
ORDER BY d."SOPInstanceUID";
