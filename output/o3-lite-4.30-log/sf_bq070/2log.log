/* 3 ─ Whole‑slide images (keyword VOLUME may appear in either ImageType or FrameType) */
  AND  (d."ImageType" ILIKE '%VOLUME%' OR d."FrameType" ILIKE '%VOLUME%')

/* 4 ─ Accept only JPEG or JPEG‑2000 compression syntaxes */
