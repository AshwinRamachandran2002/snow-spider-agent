       END                                       AS "cancer_subtype",

       /* cloud‑storage location of the DICOM file */
       d."gcs_url",

       /* image dimensions */
       d."Columns"                              AS "width_px",
       d."Rows"                                 AS "height_px",

       /* physical resolution of a pixel (prefer ImagerPixelSpacing if present) */
