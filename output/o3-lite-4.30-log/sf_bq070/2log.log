SELECT
    d."SeriesInstanceUID"                                   AS "digital_slide_id",
    d."idc_case_id"                                         AS "case_id",
    d."ContainerIdentifier"                                 AS "physical_slide_id",
    d."PatientID"                                           AS "patient_id",
    d."collection_id"                                       AS "collection_id",
    d."SOPInstanceUID"                                      AS "instance_id",
    d."gcs_url"                                             AS "gcs_url",
    d."Columns"                                             AS "width_px",
    d."Rows"                                                AS "height_px",
    COALESCE(d."ImagerPixelSpacing", d."PixelSpacing")      AS "pixel_spacing_mm_per_px",
    CASE
         WHEN d."TransferSyntaxUID" = '1.2.840.10008.1.2.4.95' THEN 'jpeg2000'
         ELSE 'jpeg'
    END                                                     AS "compression_type",
    CASE
         WHEN EXISTS (SELECT 1
                      FROM   LATERAL FLATTEN(input => d."SpecimenDescriptionSequence") t
                      WHERE  t.value::STRING ILIKE '%17621005%')
              THEN 'normal'
         WHEN EXISTS (SELECT 1
                      FROM   LATERAL FLATTEN(input => d."SpecimenDescriptionSequence") t
                      WHERE  t.value::STRING ILIKE '%86049000%')
              THEN 'tumor'
    END                                                     AS "tissue_type",
    CASE
         WHEN d."collection_id" = 'tcga_luad' THEN 'luad'
         ELSE 'lscc'
    END                                                     AS "cancer_subtype"
FROM   "IDC"."IDC_V17"."DICOM_ALL" d
WHERE  d."collection_id" IN ('tcga_luad', 'tcga_lusc')
  AND  d."Modality" = 'SM'
  AND  (d."ImageType" ILIKE '%VOLUME%' OR d."FrameType" ILIKE '%VOLUME%')
  AND  d."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',   -- JPEG baseline
                                 '1.2.840.10008.1.2.4.70',   -- JPEG lossless
                                 '1.2.840.10008.1.2.4.90',   -- JPEG‑LS
                                 '1.2.840.10008.1.2.4.91',   -- JPEG‑LS lossless
                                 '1.2.840.10008.1.2.4.95')   -- JPEG‑2000 lossless
  AND  EXISTS (  -- embedding medium = Tissue freezing medium
         SELECT 1
         FROM   LATERAL FLATTEN(input => d."SpecimenDescriptionSequence") s
         WHERE  s.value::STRING ILIKE '%freezing%medium%')
  AND  (
         EXISTS (SELECT 1
                 FROM   LATERAL FLATTEN(input => d."SpecimenDescriptionSequence") t
                 WHERE  t.value::STRING ILIKE '%17621005%')  -- normal
      OR EXISTS (SELECT 1
                 FROM   LATERAL FLATTEN(input => d."SpecimenDescriptionSequence") t
                 WHERE  t.value::STRING ILIKE '%86049000%')  -- tumor
      )
ORDER BY "instance_id" ASC;
