```sql
-- 7. Description: percentage of articles mentioning “education” (two‑decimal precision)  
SELECT category,
       COUNT(*)                                   AS total_articles,
       COUNTIF(LOWER(body) LIKE '%education%')    AS education_mentions,
       ROUND(100 * COUNTIF(LOWER(body) LIKE '%education%') / COUNT(*), 2) AS pct_education
FROM   `bigquery-public-data.bbc_news.fulltext`
GROUP  BY category
ORDER  BY pct_education DESC
LIMIT 20;
```

```sql
-- 8. Description: categories where >10 % of stories mention “education”  
