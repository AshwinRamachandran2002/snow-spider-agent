Query:
-- 10) Description: Final answer – full breakdown of categories, totals, and education percentages (ordered by percentage desc).
SELECT
  `category`,
  COUNT(*)                                                          AS total_in_category,
  SUM( CASE WHEN LOWER(`body`) LIKE '%education%'
             OR  LOWER(`title`) LIKE '%education%' THEN 1 ELSE 0 END ) AS education_mentions,
  ROUND( 100 * SUM( CASE WHEN LOWER(`body`) LIKE '%education%'
                          OR  LOWER(`title`) LIKE '%education%' THEN 1 ELSE 0 END )
           / COUNT(*), 2)                                             AS pct_with_education
FROM `bigquery-public-data.bbc_news.fulltext`
GROUP BY `category`
ORDER BY pct_with_education DESC
LIMIT 20;
