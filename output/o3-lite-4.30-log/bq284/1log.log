         COUNT(DISTINCT `filename`) AS total_articles,
         COUNT(DISTINCT IF(LOWER(`body`) LIKE '%education%' OR LOWER(`title`) LIKE '%education%', `filename`, NULL)) AS edu_articles
  FROM `bigquery-public-data.bbc_news.fulltext`
  GROUP BY `category`
)
ORDER BY category
LIMIT 20;
```

