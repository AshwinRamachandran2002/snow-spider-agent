--Description: 8) Use a WITH clause for readability, keep only categories with ≥50 stories
WITH source AS (
  SELECT `category`,
         COUNT(DISTINCT `filename`) AS total_articles,
         COUNT(DISTINCT IF(LOWER(`body`) LIKE '%education%' OR LOWER(`title`) LIKE '%education%', `filename`, NULL)) AS edu_articles
  FROM `bigquery-public-data.bbc_news.fulltext`
  GROUP BY `category`
)
SELECT category,
       total_articles,
       edu_articles,
       SAFE_DIVIDE(edu_articles, total_articles) * 100 AS pct_education
FROM source
WHERE total_articles >= 50
ORDER BY pct_education DESC
LIMIT 20;
