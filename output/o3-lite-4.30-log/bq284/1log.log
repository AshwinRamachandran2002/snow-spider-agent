Query:
--Description: 6) Combine total vs. education counts for each category via two subqueries and a JOIN
SELECT
  tot.category,
  tot.total_articles,
  COALESCE(edu.edu_articles, 0) AS edu_articles
FROM (
  SELECT `category`, COUNT(DISTINCT `filename`) AS total_articles
  FROM `bigquery-public-data.bbc_news.fulltext`
  GROUP BY `category`
) AS tot
LEFT JOIN (
  SELECT `category`, COUNT(DISTINCT `filename`) AS edu_articles
  FROM `bigquery-public-data.bbc_news.fulltext`
  WHERE LOWER(`body`) LIKE '%education%' OR LOWER(`title`) LIKE '%education%'
  GROUP BY `category`
) AS edu
ON tot.category = edu.category
ORDER BY tot.total_articles DESC
LIMIT 20;
