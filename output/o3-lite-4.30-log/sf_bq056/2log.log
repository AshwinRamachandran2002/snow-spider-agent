```sql
--Description / thinking process:
-- ① In CTE “ca” fetch California’s boundary from GEO_US_BOUNDARIES.STATES
--    and convert its WKB BINARY into a GEOMETRY object via TO_GEOMETRY.
-- ② Scan GEO_OPENSTREETMAP.PLANET_WAYS; ignore rows whose "geometry" is NULL,
--    and convert each WKB into GEOMETRY so spatial predicates work.
-- ③ ST_INTERSECTS( way_geom , ca.ca_geom ) keeps only ways that lie in or touch California.
-- ④ Use LATERAL FLATTEN on "all_tags" to break the JSON array into key/value rows
--    and filter for tag_key = 'highway' and tag_value in (motorway, trunk, primary, secondary, residential).
-- ⑤ DISTINCT ensures a way listed once even if it has duplicate tags.
-- ⑥ LIMIT 20 just shows a sample of qualifying way IDs.

WITH ca AS (
    SELECT TO_GEOMETRY("state_geom") AS ca_geom
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
    WHERE  "state_name" = 'California'
)
SELECT DISTINCT w."id"
FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w,
       ca,
       LATERAL FLATTEN(input => w."all_tags") tag
WHERE  w."geometry" IS NOT NULL
  AND  ST_INTERSECTS( TO_GEOMETRY(w."geometry"), ca.ca_geom )
  AND  tag.value:"key"::STRING   = 'highway'
  AND  tag.value:"value"::STRING IN ('motorway','trunk','primary','secondary','residential')
LIMIT 20;
