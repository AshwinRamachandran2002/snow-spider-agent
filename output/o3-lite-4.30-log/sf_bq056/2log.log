```sql
--Description / thinking process:
-- 1. California boundary: pull the polygon from GEO_US_BOUNDARIES.STATES and convert the WKB blob
--    in "state_geom" to a GEOMETRY object with TO_GEOMETRY.  Wrap that in CTE “ca”.
-- 2. From PLANET_WAYS pick rows whose "geometry" exists; convert each WKB blob to GEOMETRY
--    so ST_INTERSECTS can compare geometries.
-- 3. ST_INTERSECTS( way_geom , ca.ca_geom ) keeps only ways that lie in California.
-- 4. Use LATERAL FLATTEN on "all_tags" and an EXISTS sub‑query to ensure each way has a
--    tag key = 'highway' and its value is one of motorway | trunk | primary | secondary | residential.
-- 5. LIMIT 20 just samples the qualifying way IDs.

WITH ca AS (
    SELECT TO_GEOMETRY("state_geom") AS ca_geom
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
    WHERE  "state_name" = 'California'
)
SELECT w."id"
FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w,
       ca
WHERE  w."geometry" IS NOT NULL
  AND  ST_INTERSECTS(
         TO_GEOMETRY(w."geometry"),
         ca.ca_geom
       )
  AND  EXISTS (
        SELECT 1
        FROM   LATERAL FLATTEN(input => w."all_tags") t
        WHERE  t.value:"key"::STRING  = 'highway'
          AND  t.value:"value"::STRING IN
               ('motorway','trunk','primary','secondary','residential')
      )
LIMIT 20;
