    AND  EXISTS (SELECT 1 FROM LATERAL FLATTEN(input => w."all_tags") t
                 WHERE t.value:"key"::STRING='highway'
                   AND t.value:"value"::STRING IN
                       ('motorway','trunk','primary','secondary','residential'))
    AND  NOT EXISTS (SELECT 1 FROM LATERAL FLATTEN(input => w."all_tags") t2
                     WHERE t2.value:"key"::STRING='bridge')
),
pairs AS (
  SELECT a."id" AS "wayA", b."id" AS "wayB"
  FROM   hw a
  JOIN   hw b
    ON   a."id" < b."id"
   AND   ST_INTERSECTS(a."geometry", b."geometry")
   AND   NOT EXISTS (
         SELECT 1 FROM LATERAL FLATTEN(input => a."nodes") n1
         JOIN   LATERAL FLATTEN(input => b."nodes") n2
           ON   n1.value::NUMBER = n2.value::NUMBER)
