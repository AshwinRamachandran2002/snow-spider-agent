```sql
--Description:
-- Find 20 pairs of DIFFERENT California roads that
--  • overlap geometrically,
--  • are tagged highway = motorway | trunk | primary | secondary | residential,
--  • have NO bridge tag,
--  • and share NO common node IDs.
-- Method:
-- 1. Convert California’s outline to GEOMETRY (ca).
-- 2. Scan PLANET_WAYS once (flags) to build per‑way flags (has_hwy, has_bridge) and keep
--    geometry + nodes.  Ignore rows with NULL geometry.
-- 3. Keep only the ways that intersect California, have has_hwy = 1, and has_bridge = 0 (hw).
-- 4. Explode each way’s node array into node_map; from this build shared_nodes, the set of
--    way‑pairs that share ≥1 node.
-- 5. Build geom_pairs = every pair of qualifying ways whose geometries intersect.
-- 6. Anti‑join geom_pairs with shared_nodes so only pairs with ZERO shared nodes remain.
-- 7. LIMIT 20 to show a sample.

WITH ca AS (
    SELECT TO_GEOMETRY("state_geom") AS ca_geom
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
    WHERE  "state_name" = 'California'
),
flags AS (
    SELECT  w."id",
            TO_GEOMETRY(w."geometry")                   AS geom,
            w."nodes"                                   AS nodes,
            MAX(IFF(tag.value:"key"::STRING = 'highway'
                     AND tag.value:"value"::STRING IN
                        ('motorway','trunk','primary','secondary','residential'),1,0)) AS has_hwy,
            MAX(IFF(tag.value:"key"::STRING = 'bridge',1,0))                            AS has_bridge
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w,
           LATERAL FLATTEN(input => w."all_tags") tag
    WHERE  w."geometry" IS NOT NULL
    GROUP  BY w."id", w."geometry", w."nodes"
),
hw AS (
    SELECT f."id", f.geom, f.nodes
    FROM   flags f, ca
    WHERE  f.has_hwy = 1
      AND  f.has_bridge = 0
      AND  ST_INTERSECTS(f.geom, ca.ca_geom)
),
node_map AS (
    SELECT h.id AS way_id,
           n.value::NUMBER AS node_id
    FROM   hw h,
           LATERAL FLATTEN(input => h.nodes) n
),
shared_nodes AS (   -- way pairs that share ≥1 node
    SELECT DISTINCT
           LEAST(n1.way_id, n2.way_id)  AS wayA,
           GREATEST(n1.way_id, n2.way_id) AS wayB
    FROM   node_map n1
    JOIN   node_map n2
      ON   n1.node_id = n2.node_id
     AND   n1.way_id  < n2.way_id
),
geom_pairs AS (     -- geometrically overlapping way pairs
    SELECT a.id AS wayA,
           b.id AS wayB
    FROM   hw a
    JOIN   hw b
      ON   a.id < b.id
     AND   ST_INTERSECTS(a.geom, b.geom)
)
SELECT gp.wayA,
       gp.wayB
FROM   geom_pairs gp
LEFT  JOIN shared_nodes sn
       ON  gp.wayA = sn.wayA
      AND gp.wayB = sn.wayB
WHERE  sn.wayA IS NULL          -- keep only pairs with NO shared nodes
LIMIT 20;
```
