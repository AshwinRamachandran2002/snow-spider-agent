```sql
--Description:  (#9) Total count of distinct overlapping‑without‑shared‑node
--road pairs in California that satisfy the highway / no‑bridge criteria.

WITH ca AS (
    SELECT TO_GEOMETRY("state_geom") AS ca_geom
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
    WHERE  "state_name" = 'California'
), flags AS (
    SELECT  w."id",
            TO_GEOMETRY(w."geometry")                   AS geom,
            w."nodes",
            MAX(IFF(tag.value:"key"::STRING = 'highway'
                    AND tag.value:"value"::STRING IN 
                        ('motorway','trunk','primary','secondary','residential'),1,0)) AS has_hwy,
            MAX(IFF(tag.value:"key"::STRING = 'bridge',1,0))                           AS has_bridge
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w,
           LATERAL FLATTEN(input => w."all_tags") tag
    WHERE  w."geometry" IS NOT NULL
    GROUP  BY w."id", w."geometry", w."nodes"
), hw AS (
    SELECT f."id", f.geom, f."nodes"
    FROM   flags f
    JOIN   ca
      ON   ST_INTERSECTS(f.geom, ca.ca_geom)
    WHERE  f.has_hwy = 1
      AND  f.has_bridge = 0
), pairs AS (
    SELECT a."id" AS wayA, b."id" AS wayB
    FROM   hw a
    JOIN   hw b
      ON   a."id" < b."id"
     AND   ST_INTERSECTS(a.geom, b.geom)
     AND   NOT EXISTS (SELECT 1
                       FROM   LATERAL FLATTEN(input => a."nodes") n1
                       JOIN   LATERAL FLATTEN(input => b."nodes") n2
                         ON   n1.value::NUMBER = n2.value::NUMBER)
)
SELECT COUNT(*) AS distinct_pair_count
FROM   pairs
LIMIT 20;
