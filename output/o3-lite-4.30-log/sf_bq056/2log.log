```sql
--Description: 
-- Count, per California county, the number of DISTINCT road‑pairs that
-- • geometrically overlap, 
-- • are tagged highway = motorway | trunk | primary | secondary | residential,
-- • have NO bridge tag, and
-- • share NO common node IDs.
-- Steps
-- 1. ca           : convert California outline to GEOMETRY.
-- 2. flags        : scan PLANET_WAYS once; build has_hwy / has_bridge flags, keep geometry & nodes.
-- 3. hw           : retain only ways inside California with has_hwy = 1 and has_bridge = 0.
-- 4. pairs        : self‑join hw to form overlapping way pairs that pass the “no shared node” test 
--                   (NOT EXISTS with two FLATTEN() calls, using WHERE instead of ON).
-- 5. county_geom  : load California county polygons as GEOMETRY.
-- 6. final SELECT : intersect one geometry from each pair with counties and count pairs per county,
--                   showing the 20 counties with highest counts.

WITH ca AS (
    SELECT TO_GEOMETRY("state_geom") AS ca_geom
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
    WHERE  "state_name" = 'California'
),
flags AS (
    SELECT  w."id",
            TO_GEOMETRY(w."geometry")                   AS geom,
            w."nodes"                                   AS nodes,
            MAX(IFF(tag.value:"key"::STRING = 'highway'
                    AND tag.value:"value"::STRING IN
                        ('motorway','trunk','primary','secondary','residential'), 1, 0)) AS has_hwy,
            MAX(IFF(tag.value:"key"::STRING = 'bridge', 1, 0))                             AS has_bridge
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w,
           LATERAL FLATTEN(input => w."all_tags") tag
    WHERE  w."geometry" IS NOT NULL
    GROUP  BY w."id", w."geometry", w."nodes"
),
hw AS (
    SELECT f."id", f.geom, f.nodes
    FROM   flags f, ca
    WHERE  f.has_hwy = 1
      AND  f.has_bridge = 0
      AND  ST_INTERSECTS(f.geom, ca.ca_geom)
),
pairs AS (
    SELECT a."id" AS wayA,
           b."id" AS wayB,
           a.geom AS geomA            -- pick geometry from first member for county test
    FROM   hw a
    JOIN   hw b
      ON   a."id" < b."id"
     AND   ST_INTERSECTS(a.geom, b.geom)
     AND   NOT EXISTS (
           SELECT 1
           FROM   TABLE(FLATTEN(input => a.nodes)) n1,
                  TABLE(FLATTEN(input => b.nodes)) n2
           WHERE  n1.value::NUMBER = n2.value::NUMBER
           )
),
county_geom AS (
    SELECT "county_name",
           TO_GEOMETRY("county_geom") AS c_geom
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.COUNTIES
    WHERE  "state_fips_code" = '06'              -- California FIPS
)
SELECT cg."county_name",
       COUNT(*) AS pair_count
FROM   pairs p
JOIN   county_geom cg
  ON   ST_INTERSECTS(p.geomA, cg.c_geom)
GROUP  BY cg."county_name"
ORDER  BY pair_count DESC
LIMIT 20;
