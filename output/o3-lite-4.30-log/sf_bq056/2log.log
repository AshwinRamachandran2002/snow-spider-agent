Relevant columns and their potential usage for solving the task  
(only columns that appear in the statements below are listed)

• GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS  
  • "id"            : identify each road (way).  
  • "geometry"      : linestring geometry used with ST_INTERSECTS to detect overlaps and to clip to California.  
  • "all_tags"      : JSON‐like array that contains {key,value} pairs; used to keep rows whose `"highway"` tag is motorway|trunk|primary|secondary|residential, and to be sure the way has no `"bridge"` tag.  
  • "nodes"         : JSON array with the node‑IDs that build the way; used to make sure two overlapping ways do not share any node.

• GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES  
  • "state_name"    : filter for ‘California’.  
  • "state_geom"    : polygon geometry of California; used with ST_INTERSECTS to restrict the search area.  


--------------------------------------------------------------------
Sample, progressively‑more‑complex Snowflake SQL statements  
(all double‑quoted column names, 20‑row cap, one query per code block)

```sql
--1. Peek at a few tags to verify the highway values that exist
SELECT w."id",
       tag.value:"key"::STRING  AS "tag_key",
       tag.value:"value"::STRING AS "tag_val"
FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w,
       LATERAL FLATTEN(input => w."all_tags") tag
WHERE  tag.value:"key"::STRING = 'highway'
LIMIT  20;
```

```sql
--2. Retrieve California’s multipolygon once (will be re‑used later)
SELECT "state_geom"
FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
WHERE  "state_name" = 'California'
LIMIT  20;
```

```sql
--3. List 20 California ways whose highway class is in scope
WITH ca AS (
  SELECT "state_geom"
  FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
  WHERE  "state_name" = 'California'
)
SELECT w."id"
FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w,
       ca
WHERE  ST_INTERSECTS(w."geometry", ca."state_geom")
  AND  EXISTS (SELECT 1
               FROM   LATERAL FLATTEN(input => w."all_tags") t
               WHERE  t.value:"key"::STRING  = 'highway'
                 AND  t.value:"value"::STRING IN
                      ('motorway','trunk','primary','secondary','residential'))
LIMIT  20;
```

```sql
--4. Same as #3 but be sure the way has NO bridge tag
WITH ca AS (
  SELECT "state_geom"
  FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
  WHERE  "state_name" = 'California'
)
SELECT w."id"
FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w,
       ca
WHERE  ST_INTERSECTS(w."geometry", ca."state_geom")
  AND  EXISTS (SELECT 1
               FROM   LATERAL FLATTEN(input => w."all_tags") t1
               WHERE  t1.value:"key"::STRING  = 'highway'
                 AND  t1.value:"value"::STRING IN
                      ('motorway','trunk','primary','secondary','residential'))
  AND  NOT EXISTS (SELECT 1
                   FROM   LATERAL FLATTEN(input => w."all_tags") t2
                   WHERE  t2.value:"key"::STRING = 'bridge')
LIMIT  20;
```

```sql
--5. Inspect the node arrays for a handful of filtered California ways
WITH ca AS (
  SELECT "state_geom"
  FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
  WHERE  "state_name" = 'California'
),
hw AS (
  SELECT w."id", w."nodes"
  FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w, ca
  WHERE  ST_INTERSECTS(w."geometry", ca."state_geom")
    AND  EXISTS (SELECT 1
                 FROM   LATERAL FLATTEN(input => w."all_tags") t
                 WHERE  t.value:"key"::STRING  = 'highway'
                   AND  t.value:"value"::STRING IN
                        ('motorway','trunk','primary','secondary','residential'))
    AND  NOT EXISTS (SELECT 1
                     FROM   LATERAL FLATTEN(input => w."all_tags") t2
                     WHERE  t2.value:"key"::STRING = 'bridge')
)
SELECT *
FROM   hw
LIMIT  20;
```

```sql
--6. Quickly show 20 pairs of DIFFERENT ways that spatially overlap in CA
WITH ca AS (
  SELECT "state_geom"
  FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
  WHERE  "state_name" = 'California'
),
hw AS (
  SELECT w."id", w."geometry"
  FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w, ca
  WHERE  ST_INTERSECTS(w."geometry", ca."state_geom")
    AND  EXISTS (SELECT 1 FROM LATERAL FLATTEN(input => w."all_tags") t
                 WHERE t.value:"key"::STRING='highway'
                   AND t.value:"value"::STRING IN
                       ('motorway','trunk','primary','secondary','residential'))
    AND  NOT EXISTS (SELECT 1 FROM LATERAL FLATTEN(input => w."all_tags") t2
                     WHERE t2.value:"key"::STRING='bridge')
)
SELECT a."id" AS "wayA", b."id" AS "wayB"
FROM   hw a
JOIN   hw b
  ON   a."id" < b."id"
 AND   ST_INTERSECTS(a."geometry", b."geometry")
LIMIT  20;
```

```sql
--7. Add a NOT‑SHARED‑NODE check for those overlapping pairs
WITH ca AS (
  SELECT "state_geom"
  FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
  WHERE  "state_name" = 'California'
),
hw AS (
  SELECT w."id", w."geometry", w."nodes"
  FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w, ca
  WHERE  ST_INTERSECTS(w."geometry", ca."state_geom")
    AND  EXISTS (SELECT 1 FROM LATERAL FLATTEN(input => w."all_tags") t
                 WHERE t.value:"key"::STRING='highway'
                   AND t.value:"value"::STRING IN
                       ('motorway','trunk','primary','secondary','residential'))
    AND  NOT EXISTS (SELECT 1 FROM LATERAL FLATTEN(input => w."all_tags") t2
                     WHERE t2.value:"key"::STRING='bridge')
),
pairs AS (
  SELECT a."id" AS "wayA", b."id" AS "wayB"
  FROM   hw a
  JOIN   hw b
    ON   a."id" < b."id"
   AND   ST_INTERSECTS(a."geometry", b."geometry")
   AND   NOT EXISTS (
         SELECT 1
         FROM   LATERAL FLATTEN(input => a."nodes") n1
         JOIN   LATERAL FLATTEN(input => b."nodes") n2
           ON   n1.value::NUMBER = n2.value::NUMBER)
)
SELECT *
FROM   pairs
LIMIT  20;
```

```sql
--8. Show how many such unique pairs appear in EACH county (exploratory)
WITH ca AS (
  SELECT "state_geom"
  FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
  WHERE  "state_name" = 'California'
),
hw AS (
  SELECT w."id", w."geometry", w."nodes"
  FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w, ca
  WHERE  ST_INTERSECTS(w."geometry", ca."state_geom")
    AND  EXISTS (SELECT 1 FROM LATERAL FLATTEN(input => w."all_tags") t
                 WHERE t.value:"key"::STRING='highway'
                   AND t.value:"value"::STRING IN
                       ('motorway','trunk','primary','secondary','residential'))
    AND  NOT EXISTS (SELECT 1 FROM LATERAL FLATTEN(input => w."all_tags") t2
                     WHERE t2.value:"key"::STRING='bridge')
),
pairs AS (
  SELECT a."id" AS "wayA", b."id" AS "wayB", a."geometry"
  FROM   hw a
  JOIN   hw b
    ON   a."id" < b."id"
   AND   ST_INTERSECTS(a."geometry", b."geometry")
   AND   NOT EXISTS (
         SELECT 1 FROM LATERAL FLATTEN(input => a."nodes") n1
         JOIN   LATERAL FLATTEN(input => b."nodes") n2
           ON   n1.value::NUMBER = n2.value::NUMBER)
),
county_geom AS (
  SELECT "county_name", "county_geom"
  FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.COUNTIES
  WHERE  "state_fips_code" = '06'          -- California FIPS
)
SELECT cg."county_name",
       COUNT(*) AS "pair_cnt"
FROM   pairs p
JOIN   county_geom cg
  ON   ST_INTERSECTS(p."geometry", cg."county_geom")
GROUP  BY cg."county_name"
ORDER  BY "pair_cnt" DESC
LIMIT  20;
```

```sql
--9. Raw count of all distinct overlapping‑without‑shared‑node pairs in CA
WITH ca AS (
