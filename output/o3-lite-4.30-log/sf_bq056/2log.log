```sql
--Description: 
-- Return 20 sample pairs of DIFFERENT California roads whose geometries overlap,
-- are classified as motorway / trunk / primary / secondary / residential, and carry no bridge tag.
-- Approach
-- 1. ca CTE: convert California outline (WKB) to a GEOMETRY object.
-- 2. flags CTE: scan PLANET_WAYS once, explode all_tags, and for every way
--      • compute has_hwy  (≥1 desired highway tag)
--      • compute has_bridge (≥1 bridge tag)
--    Only keep rows where geometry is non‑NULL.
-- 3. hw CTE: retain only ways that intersect California, have has_hwy = 1 and has_bridge = 0.
--    Geometry is already converted with TO_GEOMETRY for later use.
-- 4. Final SELECT self‑joins hw to pick overlapping pairs (id inequality + ST_INTERSECTS)
--    and shows 20 examples.

WITH ca AS (
    SELECT TO_GEOMETRY("state_geom") AS ca_geom
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
    WHERE  "state_name" = 'California'
), flags AS (
    SELECT  w."id",
            TO_GEOMETRY(w."geometry")          AS geom,
            MAX(IFF(tag.value:"key"::STRING = 'highway'
                    AND tag.value:"value"::STRING IN
                        ('motorway','trunk','primary','secondary','residential'),1,0)) AS has_hwy,
            MAX(IFF(tag.value:"key"::STRING = 'bridge',1,0))                            AS has_bridge
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w,
           LATERAL FLATTEN(input => w."all_tags") tag
    WHERE  w."geometry" IS NOT NULL
    GROUP  BY w."id", w."geometry"
), hw AS (
    SELECT f."id", f.geom
    FROM   flags f, ca
    WHERE  f.has_hwy = 1
      AND  f.has_bridge = 0
      AND  ST_INTERSECTS(f.geom, ca.ca_geom)
)
SELECT a."id" AS wayA,
       b."id" AS wayB
FROM   hw a
JOIN   hw b
  ON   a."id" < b."id"                 -- different ways
 AND   ST_INTERSECTS(a.geom, b.geom)   -- overlapping geometries
LIMIT 20;
