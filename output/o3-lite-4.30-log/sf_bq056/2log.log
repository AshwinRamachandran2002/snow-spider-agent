```sql
--Description:  (#4) 20 California ways whose highway class is in scope AND have no bridge tag.
--Creates one scan of PLANET_WAYS, explodes all_tags, aggregates per way to determine
--has_highway / has_bridge flags, then filters.  Geometry blobs are converted with TO_GEOMETRY.
WITH ca AS (
    SELECT TO_GEOMETRY("state_geom") AS ca_geom
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
    WHERE  "state_name" = 'California'
), flags AS (
    SELECT  w."id",
            w."geometry",
            MAX( IFF(tag.value:"key"::STRING = 'highway'
                     AND tag.value:"value"::STRING IN
                         ('motorway','trunk','primary','secondary','residential'), 1, 0) ) AS has_hwy,
            MAX( IFF(tag.value:"key"::STRING = 'bridge', 1, 0) )                               AS has_bridge
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w,
           LATERAL FLATTEN(input => w."all_tags") tag
    WHERE  w."geometry" IS NOT NULL
    GROUP  BY w."id", w."geometry"
)
SELECT DISTINCT f."id"
FROM   flags f, ca
WHERE  has_hwy = 1
  AND  has_bridge = 0
  AND  ST_INTERSECTS( TO_GEOMETRY(f."geometry"), ca.ca_geom )
LIMIT 20;
```

```sql
--Description:  (#5) Inspect the node arrays for 20 filtered California ways
--using the same flag logic (highway present, no bridge) and returning the nodes column.
WITH ca AS (
    SELECT TO_GEOMETRY("state_geom") AS ca_geom
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
    WHERE  "state_name" = 'California'
), flags AS (
    SELECT  w."id",
            w."geometry",
            w."nodes",
            MAX( IFF(tag.value:"key"::STRING = 'highway'
                     AND tag.value:"value"::STRING IN
                         ('motorway','trunk','primary','secondary','residential'), 1, 0) ) AS has_hwy,
            MAX( IFF(tag.value:"key"::STRING = 'bridge', 1, 0) )                               AS has_bridge
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w,
           LATERAL FLATTEN(input => w."all_tags") tag
    WHERE  w."geometry" IS NOT NULL
    GROUP  BY w."id", w."geometry", w."nodes"
)
SELECT f."id", f."nodes"
FROM   flags f, ca
WHERE  has_hwy = 1
  AND  has_bridge = 0
  AND  ST_INTERSECTS( TO_GEOMETRY(f."geometry"), ca.ca_geom )
LIMIT 20;
```

```sql
--Description:  (#6) Show 20 pairs of DIFFERENT California ways that geometrically overlap,
--meet the highway criteria, and have no bridge tag.  Geometry blobs are converted once
--in hw CTE so ST_INTERSECTS works on proper GEOMETRY objects.
WITH ca AS (
    SELECT TO_GEOMETRY("state_geom") AS ca_geom
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
    WHERE  "state_name" = 'California'
), hw AS (
    SELECT  w."id",
            TO_GEOMETRY(w."geometry") AS geom
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w,
           LATERAL FLATTEN(input => w."all_tags") tag
    WHERE  w."geometry" IS NOT NULL
      AND  tag.value:"key"::STRING   = 'highway'
      AND  tag.value:"value"::STRING IN ('motorway','trunk','primary','secondary','residential')
      AND  NOT EXISTS ( SELECT 1
                        FROM   LATERAL FLATTEN(input => w."all_tags") br
                        WHERE  br.value:"key"::STRING = 'bridge')
      AND  ST_INTERSECTS( TO_GEOMETRY(w."geometry"), (SELECT ca_geom FROM ca) )
    GROUP BY w."id", w."geometry"
)
SELECT a."id" AS "wayA",
       b."id" AS "wayB"
FROM   hw a
JOIN   hw b
  ON   a."id" < b."id"
 AND   ST_INTERSECTS(a.geom, b.geom)
LIMIT 20;
```

```sql
--Description:  (#7) Same as #6, but additionally require the two overlapping ways
--to share NO nodes.  Uses node arrays with LATERAL FLATTEN inside NOT EXISTS.
WITH ca AS (
    SELECT TO_GEOMETRY("state_geom") AS ca_geom
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
    WHERE  "state_name" = 'California'
), hw AS (
    SELECT  w."id",
            TO_GEOMETRY(w."geometry") AS geom,
            w."nodes"
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w,
           LATERAL FLATTEN(input => w."all_tags") tag
    WHERE  w."geometry" IS NOT NULL
      AND  tag.value:"key"::STRING   = 'highway'
      AND  tag.value:"value"::STRING IN ('motorway','trunk','primary','secondary','residential')
      AND  NOT EXISTS ( SELECT 1
                        FROM   LATERAL FLATTEN(input => w."all_tags") br
                        WHERE  br.value:"key"::STRING = 'bridge')
      AND  ST_INTERSECTS( TO_GEOMETRY(w."geometry"), (SELECT ca_geom FROM ca) )
    GROUP BY w."id", w."geometry", w."nodes"
), pairs AS (
    SELECT a."id" AS wayA, b."id" AS wayB
    FROM   hw a
    JOIN   hw b
      ON   a."id" < b."id"
     AND   ST_INTERSECTS(a.geom, b.geom)
     AND   NOT EXISTS (SELECT 1
                       FROM   LATERAL FLATTEN(input => a."nodes") n1
                       JOIN   LATERAL FLATTEN(input => b."nodes") n2
                         ON   n1.value::NUMBER = n2.value::NUMBER)
)
SELECT *
FROM   pairs
LIMIT 20;
```

```sql
--Description:  (#8) Count, per California county, how many overlapping‑without‑shared‑node
--road pairs meet the criteria.  Re‑uses CTEs hw and pairs from #7, intersects each
--pair geometry (geom from hw) with county polygons.
WITH ca AS (
    SELECT TO_GEOMETRY("state_geom") AS ca_geom
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
    WHERE  "state_name" = 'California'
), hw AS (
    SELECT  w."id",
            TO_GEOMETRY(w."geometry") AS geom,
            w."nodes"
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w,
           LATERAL FLATTEN(input => w."all_tags") tag
    WHERE  w."geometry" IS NOT NULL
      AND  tag.value:"key"::STRING   = 'highway'
      AND  tag.value:"value"::STRING IN ('motorway','trunk','primary','secondary','residential')
      AND  NOT EXISTS ( SELECT 1
                        FROM   LATERAL FLATTEN(input => w."all_tags") br
                        WHERE  br.value:"key"::STRING = 'bridge')
      AND  ST_INTERSECTS( TO_GEOMETRY(w."geometry"), (SELECT ca_geom FROM ca) )
    GROUP BY w."id", w."geometry", w."nodes"
), pairs AS (
    SELECT a."id" AS wayA, b."id" AS wayB, a.geom AS geomA
    FROM   hw a
    JOIN   hw b
      ON   a."id" < b."id"
     AND   ST_INTERSECTS(a.geom, b.geom)
     AND   NOT EXISTS (SELECT 1
                       FROM   LATERAL FLATTEN(input => a."nodes") n1
                       JOIN   LATERAL FLATTEN(input => b."nodes") n2
                         ON   n1.value::NUMBER = n2.value::NUMBER)
), county_geom AS (
    SELECT "county_name",
           TO_GEOMETRY("county_geom") AS c_geom
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.COUNTIES
    WHERE  "state_fips_code" = '06'
)
SELECT cg."county_name",
       COUNT(*) AS pair_cnt
FROM   pairs p
JOIN   county_geom cg
  ON   ST_INTERSECTS(p.geomA, cg.c_geom)
GROUP  BY cg."county_name"
ORDER  BY pair_cnt DESC
LIMIT 20;
