FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w,
       ca,
       LATERAL FLATTEN(input => w."all_tags") tag
WHERE  w."geometry" IS NOT NULL
  AND  ST_INTERSECTS( TO_GEOMETRY(w."geometry"), ca.ca_geom )
  AND  tag.value:"key"::STRING   = 'highway'
  AND  tag.value:"value"::STRING IN ('motorway','trunk','primary','secondary','residential')
LIMIT 20;
