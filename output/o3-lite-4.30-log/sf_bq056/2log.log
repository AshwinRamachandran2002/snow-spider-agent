--Description: 
-- Retrieve 20 distinct pairs of California roads (OpenStreetMap ways) that:
--   1) spatially overlap (ST_INTERSECTS), 
--   2) are tagged highway = motorway | trunk | primary | secondary | residential,
--   3) do NOT contain a bridge tag, and
--   4) share NO common node IDs.
-- Approach
-- • ca     : convert the California state polygon (WKB) to GEOMETRY.  
-- • flags  : scan PLANET_WAYS once; explode all_tags to create two flags per way
--            (has_hwy and has_bridge) while retaining geometry and nodes.  
-- • hw     : keep only ways that intersect California and satisfy has_hwy = 1 and has_bridge = 0.  
-- • Final  : self‑join hw on geometry overlap, enforce id inequality, and apply a NOT‑EXISTS
--            subquery (with comma‑join FLATTENs) to guarantee the two ways do not share
--            any node IDs.  LIMIT 20 shows a sample of such pairs.

WITH ca AS (
    SELECT TO_GEOMETRY("state_geom") AS ca_geom
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
    WHERE  "state_name" = 'California'
),
flags AS (
    SELECT  w."id",
            TO_GEOMETRY(w."geometry")                   AS geom,
            w."nodes"                                   AS nodes,
            MAX(
                IFF(
                    tag.value:"key"::STRING = 'highway'
                    AND tag.value:"value"::STRING IN 
                        ('motorway','trunk','primary','secondary','residential'),
                    1, 0)
            ) AS has_hwy,
            MAX(
                IFF(tag.value:"key"::STRING = 'bridge', 1, 0)
            ) AS has_bridge
    FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w,
           LATERAL FLATTEN(input => w."all_tags") tag
    WHERE  w."geometry" IS NOT NULL
    GROUP  BY w."id", w."geometry", w."nodes"
),
hw AS (
    SELECT f."id", f.geom, f.nodes
    FROM   flags f, ca
    WHERE  f.has_hwy = 1
      AND  f.has_bridge = 0
      AND  ST_INTERSECTS(f.geom, ca.ca_geom)
)
SELECT a."id" AS wayA,
       b."id" AS wayB
FROM   hw a
JOIN   hw b
  ON   a."id" < b."id"                       -- ensure different ways
 AND   ST_INTERSECTS(a.geom, b.geom)         -- overlapping geometries
WHERE  NOT EXISTS (                          -- confirm NO shared node IDs
        SELECT 1
        FROM   TABLE(FLATTEN(input => a.nodes)) n1,
               TABLE(FLATTEN(input => b.nodes)) n2
        WHERE  n1.value::NUMBER = n2.value::NUMBER
      )
LIMIT 20;
