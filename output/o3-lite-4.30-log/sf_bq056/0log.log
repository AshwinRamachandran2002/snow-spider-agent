```sql
--Description:  Retrieve up to 20 node IDs that compose a single OSM way.  
--              The “nodes” array may hold bare numeric values (e.g., 123456)
--              or objects like {"id":123456}.  COALESCE tries the object
--              path first (value:"id"), and if null falls back to the raw
--              scalar value; the chosen value is then cast to NUMBER.
SELECT  w."id",
        COALESCE( n.value:"id"::NUMBER,    -- object form
                  n.value::NUMBER ) 
        AS "node_id"
FROM    "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_OPENSTREETMAP"."PLANET_WAYS" AS w,
        LATERAL FLATTEN( input => w."nodes" )                             AS n
WHERE   w."id" = 73165139      -- replace with the way ID you want to inspect
LIMIT   20;
