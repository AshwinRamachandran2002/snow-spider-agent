--Description: 8) From the first 100 qualified California ways, list pairs that
--              overlap geometrically but share no nodes.  All geometry arguments
--              converted from WKB to GEOMETRY; tag logic via HAVING.
WITH ca AS (
    SELECT TO_GEOMETRY("state_geom") AS "ca_geom"
    FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_US_BOUNDARIES"."STATES"
    WHERE  "state" = 'CA'
),
ca_ways AS (
    SELECT w."id",
           w."geometry",
           w."nodes"
    FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_OPENSTREETMAP"."PLANET_WAYS" AS w,
           ca,
           LATERAL FLATTEN(input => w."all_tags")                            AS tag
    WHERE  w."geometry" IS NOT NULL
      AND  ST_INTERSECTS( TO_GEOMETRY(w."geometry"), ca."ca_geom" )
    GROUP  BY w."id", w."geometry", w."nodes"
    HAVING MAX( IFF(tag.value:"key"::STRING = 'highway'
                    AND tag.value:"value"::STRING IN ('motorway','trunk','primary',
                                                      'secondary','residential'), 1, 0) ) = 1
       AND MAX( IFF(tag.value:"key"::STRING = 'bridge', 1, 0) ) = 0
    LIMIT 100
)
SELECT w1."id" AS "way_id_1",
       w2."id" AS "way_id_2"
FROM   ca_ways w1
JOIN   ca_ways w2
       ON w1."id" < w2."id"
      AND ST_INTERSECTS( TO_GEOMETRY(w1."geometry"), TO_GEOMETRY(w2."geometry") )
      AND NOT EXISTS (SELECT 1
                      FROM   LATERAL FLATTEN(input => w1."nodes") n1
                      JOIN   LATERAL FLATTEN(input => w2."nodes") n2
                        ON n1.value = n2.value)
LIMIT 20;
