--Description: 6) Verify (for 20 samples) that qualifying California ways have NO “bridge” tag.  
--              Tag logic done via aggregation in HAVING to avoid correlated sub‑queries.
WITH ca AS (
        SELECT "state_geom"
        FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_US_BOUNDARIES"."STATES"
        WHERE  "state" = 'CA'
)
