-- 8. Description: Produce a small pairwise intersection check within a tiny subset (first 100 CA ways) to validate logic.
WITH ca AS (
       SELECT "state_geom"
       FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_US_BOUNDARIES"."STATES"
       WHERE  "state" = 'CA'
),
ca_ways AS (
