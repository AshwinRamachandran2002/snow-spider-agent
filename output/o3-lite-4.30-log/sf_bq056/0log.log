```sql
--Description:  Extract the first 20 node IDs that compose a chosen OSM “way”.
--              The column "nodes" is an array of VARIANT elements that can be
--              either a simple numeric value (e.g., 123456) or an object
--              storing the ID under the key "id" (e.g., {"id":123456}).
--              Directly casting the entire VARIANT to NUMBER fails on the
--              object form, so we use COALESCE:
--                 • n.value:"id"::NUMBER handles the object form.
--                 • n.value::NUMBER handles the scalar form.
--              COALESCE returns the first non‑NULL match, giving a clean
--              numeric node ID in either situation.
SELECT  w."id",
        COALESCE( n.value:"id"::NUMBER,      -- object form {"id": ...}
                  n.value::NUMBER ) AS "node_id"  -- scalar form
FROM    "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_OPENSTREETMAP"."PLANET_WAYS"  AS w,
        LATERAL FLATTEN(input => w."nodes")                               AS n
WHERE   w."id" = 73165139           -- replace with the desired way ID
LIMIT   20;
```
