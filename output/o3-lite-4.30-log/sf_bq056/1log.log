--Description: Build a list of California ways that (a) have a highway tag equal to
--             motorway, trunk, primary, secondary, or residential, (b) have NO bridge
--             tag, (c) contain a non‑NULL geometry that intersects the California
--             state boundary, and (d) then self‑join this list to return 20 pairs of
--             different ways whose geometries intersect one another (id1 < id2).
WITH ca AS (
    SELECT TO_GEOMETRY("state_geom") AS ca_geom
    FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_US_BOUNDARIES"."STATES"
    WHERE  "state" = 'CA'
),
target_ways AS (
    SELECT DISTINCT
           w."id",
           TO_GEOMETRY(w."geometry") AS geom
    FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
           ca
    WHERE  w."geometry" IS NOT NULL
      AND  ST_INTERSECTS(TO_GEOMETRY(w."geometry"), ca.ca_geom)
      AND  EXISTS (                                -- desired highway class
            SELECT 1
            FROM   TABLE(FLATTEN(input => w."all_tags")) h
            WHERE  h.value:"key"::STRING  = 'highway'
              AND  h.value:"value"::STRING IN ('motorway','trunk','primary','secondary','residential')
      )
      AND  NOT EXISTS (                            -- exclude bridge tag
            SELECT 1
            FROM   TABLE(FLATTEN(input => w."all_tags")) b
            WHERE  b.value:"key"::STRING = 'bridge'
      )
)
SELECT t1."id" AS way_id_1,
       t2."id" AS way_id_2
FROM   target_ways t1
JOIN   target_ways t2
  ON   t1."id" < t2."id"
WHERE  ST_INTERSECTS(t1.geom, t2.geom)
LIMIT 20;
