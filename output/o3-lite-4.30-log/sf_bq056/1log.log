```sql
-- 8️⃣  Candidate pairs of California roads (same filter) whose geometries intersect
--      (no bridge tag yet, no node check yet)
WITH ca AS (
    SELECT "state_geom"
    FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_US_BOUNDARIES"."STATES"
    WHERE  "state" = 'CA'
),
target_ways AS (
    SELECT w."id",
           w."geometry"
    FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
           LATERAL FLATTEN(input => w."all_tags") h,
           ca
    WHERE  h.value:"key"::STRING  = 'highway'
      AND  h.value:"value"::STRING IN ('motorway','trunk','primary','secondary','residential')
      AND  NOT EXISTS (
            SELECT 1
            FROM   LATERAL FLATTEN(input => w."all_tags") b
            WHERE  b.value:"key"::STRING = 'bridge'
      )
      AND  ST_INTERSECTS(w."geometry", ca."state_geom")
)
SELECT t1."id"  AS "way_id_1",
       t2."id"  AS "way_id_2"
FROM   target_ways t1
JOIN   target_ways t2
  ON   t1."id" < t2."id"
 WHERE ST_INTERSECTS(t1."geometry", t2."geometry")
LIMIT 20;
```

```sql
-- 9️⃣  Check whether two sample ways share at least one node (flatten nodes arrays)
--      This illustrates how to detect shared nodes
SELECT w1."id" AS "way_id_1",
       w2."id" AS "way_id_2",
       n1.value::NUMBER AS "shared_node"
FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_OPENSTREETMAP"."PLANET_WAYS" w1,
       LATERAL FLATTEN(input => w1."nodes") n1,
       "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_OPENSTREETMAP"."PLANET_WAYS" w2,
       LATERAL FLATTEN(input => w2."nodes") n2
WHERE  w1."id" <> w2."id"
  AND  n1.value::NUMBER = n2.value::NUMBER      -- same node appears in both ways
LIMIT 20;
```

```sql
-- 🔟  Combine everything: pairs of California roads in the five classes that
--     intersect geometrically, have no bridge tag, and do not share nodes.
--     Showing only 20 pairs as a sanity‑check (final answer would remove LIMIT)
WITH ca AS (
    SELECT "state_geom"
    FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_US_BOUNDARIES"."STATES"
    WHERE  "state" = 'CA'
),
filtered AS (
    SELECT w."id",
           w."geometry",
           w."nodes"
    FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
           LATERAL FLATTEN(input => w."all_tags") h,
           ca
    WHERE  h.value:"key"::STRING  = 'highway'
      AND  h.value:"value"::STRING IN ('motorway','trunk','primary','secondary','residential')
      AND  NOT EXISTS (
            SELECT 1
            FROM   LATERAL FLATTEN(input => w."all_tags") bt
            WHERE  bt.value:"key"::STRING = 'bridge'
      )
      AND  ST_INTERSECTS(w."geometry", ca."state_geom")
),
pairs AS (
    SELECT f1."id" AS id1,
           f2."id" AS id2
    FROM   filtered f1
    JOIN   filtered f2
      ON   f1."id" < f2."id"
     AND   ST_INTERSECTS(f1."geometry", f2."geometry")
)
SELECT p.id1,
       p.id2
FROM   pairs p
WHERE  NOT EXISTS (   -- ensure they do NOT share nodes
          SELECT 1
          FROM   filtered w1,
                 LATERAL FLATTEN(input => w1."nodes") n1,
                 filtered w2,
                 LATERAL FLATTEN(input => w2."nodes") n2
          WHERE  w1."id" = p.id1
            AND  w2."id" = p.id2
            AND  n1.value::NUMBER = n2.value::NUMBER
       )
LIMIT 20;
```

