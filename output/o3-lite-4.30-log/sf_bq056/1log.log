--Description: Build a qualified list of California roads (motorway / trunk / primary /
--             secondary / residential, no bridge tag, geometry intersects California),
--             then return 20 distinct pairs whose geometries intersect each other.
--             All WKB blobs are converted to GEOMETRY with TO_GEOMETRY, and tag
--             filtering uses EXISTS / NOT EXISTS with TABLE(FLATTEN()) to avoid
--             unsupported correlated‑lateral sub‑queries.
WITH ca AS (                       -- California boundary as GEOMETRY
    SELECT TO_GEOMETRY("state_geom") AS ca_geom
    FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_US_BOUNDARIES"."STATES"
    WHERE  "state" = 'CA'
),
target_ways AS (                   -- roads that meet every criterion
    SELECT DISTINCT
           w."id",
           TO_GEOMETRY(w."geometry") AS geom
    FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
           ca
    WHERE  w."geometry" IS NOT NULL
      AND  ST_INTERSECTS(TO_GEOMETRY(w."geometry"), ca.ca_geom)
      AND  EXISTS (                       -- highway tag must be one of the 5 classes
            SELECT 1
            FROM   TABLE(FLATTEN(input => w."all_tags")) h
            WHERE  h.value:"key"::STRING  = 'highway'
              AND  h.value:"value"::STRING IN
                  ('motorway','trunk','primary','secondary','residential')
      )
      AND  NOT EXISTS (                   -- must NOT have bridge tag
            SELECT 1
            FROM   TABLE(FLATTEN(input => w."all_tags")) b
            WHERE  b.value:"key"::STRING = 'bridge'
      )
)
SELECT t1."id" AS way_id_1,
       t2."id" AS way_id_2
FROM   target_ways t1
JOIN   target_ways t2
  ON   t1."id" < t2."id"            -- avoid duplicates and self‑pairs
WHERE  ST_INTERSECTS(t1.geom, t2.geom)
LIMIT 20;
