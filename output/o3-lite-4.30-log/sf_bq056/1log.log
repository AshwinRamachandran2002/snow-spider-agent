    FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_US_BOUNDARIES"."STATES"
    WHERE  "state" = 'CA'
),
filtered AS (
    SELECT
        w."id",
        TO_GEOMETRY(w."geometry") AS geom,
        w."nodes"
    FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
           LATERAL FLATTEN(input => w."all_tags") h,
           ca
    WHERE  h.value:"key"::STRING  = 'highway'
      AND  h.value:"value"::STRING IN ('motorway','trunk','primary','secondary','residential')
      AND  NOT EXISTS (                       -- exclude ways with a bridge tag
              SELECT 1
              FROM   LATERAL FLATTEN(input => w."all_tags") b
              WHERE  b.value:"key"::STRING = 'bridge'
           )
      AND  w."geometry" IS NOT NULL           -- geometry must exist
      AND  ST_INTERSECTS(TO_GEOMETRY(w."geometry"), ca.geom)   -- inside CA
),
pair_list AS (                                -- build intersecting pairs
    SELECT
        f1."id" AS id1,
        f2."id" AS id2
    FROM   filtered f1
    JOIN   filtered f2
      ON   f1."id" < f2."id"
     AND   ST_INTERSECTS(f1.geom, f2.geom)    -- geometries overlap
    WHERE  ARRAY_SIZE(                        -- ensure no shared nodes
              ARRAY_INTERSECTION(
                  COALESCE(f1."nodes", PARSE_JSON('[]')),
                  COALESCE(f2."nodes", PARSE_JSON('[]'))
              )
           ) = 0
)
SELECT COUNT(*) AS pair_count
FROM   pair_list;
