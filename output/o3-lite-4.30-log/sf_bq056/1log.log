--Description:  Build a list of California ways that
--              • have a “highway” tag equal to motorway, trunk, primary, secondary, or residential,
--              • do NOT have any “bridge” tag,
--              • possess non‑NULL geometry that intersects the California state polygon.
--              Then self‑join that list (id1 < id2) to return 20 distinct pairs whose
--              geometries intersect one another.  All WKB blobs are converted to GEOMETRY
--              with TO_GEOMETRY for spatial predicates so ST_INTERSECTS works.
WITH ca AS (   -- California boundary as GEOMETRY
    SELECT TO_GEOMETRY("state_geom") AS ca_geom
    FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_US_BOUNDARIES"."STATES"
    WHERE  "state" = 'CA'
),
target_ways AS (   -- qualified roads inside California
    SELECT DISTINCT
           w."id",
           TO_GEOMETRY(w."geometry") AS geom
    FROM   "GEO_OPENSTREETMAP_BOUNDARIES"."GEO_OPENSTREETMAP"."PLANET_WAYS" w,
           ca
    WHERE  w."geometry" IS NOT NULL
      AND  ST_INTERSECTS(TO_GEOMETRY(w."geometry"), ca.ca_geom)     -- inside CA
      AND  EXISTS (                                                 -- highway class filter
            SELECT 1
            FROM   TABLE(FLATTEN(input => w."all_tags")) h
            WHERE  h.value:"key"::STRING  = 'highway'
              AND  h.value:"value"::STRING IN ('motorway','trunk','primary','secondary','residential')
      )
      AND  NOT EXISTS (                                             -- exclude bridges
            SELECT 1
            FROM   TABLE(FLATTEN(input => w."all_tags")) b
            WHERE  b.value:"key"::STRING = 'bridge'
      )
)
SELECT t1."id" AS way_id_1,
       t2."id" AS way_id_2
FROM   target_ways t1
JOIN   target_ways t2
  ON   t1."id" < t2."id"                      -- avoid duplicates / self‑pairs
WHERE  ST_INTERSECTS(t1.geom, t2.geom)        -- geometries overlap
LIMIT 20;                                     -- sample result set
