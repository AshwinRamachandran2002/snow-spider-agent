Begin Exploring Related Columns
Relevant columns and their potential usage
• collisions.case_id: join-key that links a crash record to its calendar year  
• case_ids.case_id: join‑key from the year table  
• case_ids.db_year: calendar year of each crash – lets us group “by year”  
• collisions.pcf_violation_category: text field that tells us the “cause” (PCF = primary‑collision‑factor)  
• collisions.primary_collision_factor (optional): generic wording (“vehicle code violation”, “other than driver”, …) – can be inspected but pcf_violation_category is the specific cause we need  

Typical conditions  
• collisions.pcf_violation_category IS NOT NULL  
• use GROUP BY db_year, pcf_violation_category to count crashes per cause per year  
• use window / ranking functions (ROW_NUMBER / RANK / DENSE_RANK) or ORDER BY … DESC LIMIT 2 to isolate the two most‑common causes within each year  

Below are ten exploratory → analytical queries (each limited to 20 rows) that build up to the final answer.

```sql
-- 1. List all years that exist in the database
SELECT DISTINCT ci."db_year"
FROM "case_ids" AS ci
ORDER BY ci."db_year"
LIMIT 20;
```

```sql
-- 2. How many crashes are recorded for each year?
SELECT ci."db_year",
       COUNT(*) AS "crash_cnt"
FROM   "collisions" AS co
JOIN   "case_ids"   AS ci  ON co."case_id" = ci."case_id"
GROUP  BY ci."db_year"
ORDER  BY ci."db_year"
LIMIT 20;
```

```sql
-- 3. Inspect the list of possible PCF‑violation categories (causes)
SELECT DISTINCT co."pcf_violation_category"
FROM   "collisions" AS co
WHERE  co."pcf_violation_category" IS NOT NULL
ORDER  BY co."pcf_violation_category"
LIMIT 20;
```

```sql
-- 4. Overall top causes, ignoring year
SELECT co."pcf_violation_category",
       COUNT(*) AS "crash_cnt"
FROM   "collisions" AS co
WHERE  co."pcf_violation_category" IS NOT NULL
GROUP  BY co."pcf_violation_category"
ORDER  BY "crash_cnt" DESC
LIMIT 20;
```

```sql
-- 5. Same as (4) but only for the most recent year (example: 2021)
SELECT co."pcf_violation_category",
       COUNT(*) AS "crash_cnt"
FROM   "collisions" AS co
JOIN   "case_ids"   AS ci ON co."case_id" = ci."case_id"
WHERE  ci."db_year" = 2021
  AND  co."pcf_violation_category" IS NOT NULL
GROUP  BY co."pcf_violation_category"
ORDER  BY "crash_cnt" DESC
LIMIT 20;
```

```sql
-- 6. Cause counts broken down by year and cause
SELECT ci."db_year",
       co."pcf_violation_category",
       COUNT(*) AS "crash_cnt"
FROM   "collisions" AS co
JOIN   "case_ids"   AS ci ON co."case_id" = ci."case_id"
WHERE  co."pcf_violation_category" IS NOT NULL
GROUP  BY ci."db_year", co."pcf_violation_category"
ORDER  BY ci."db_year", "crash_cnt" DESC
LIMIT 20;
```

```sql
-- 7. Use a window function to rank causes within each year
SELECT db_year,
       pcf_violation_category,
       crash_cnt,
       RANK() OVER (PARTITION BY db_year ORDER BY crash_cnt DESC) AS rk
FROM (
      SELECT ci."db_year"         AS db_year,
             co."pcf_violation_category",
             COUNT(*)             AS crash_cnt
      FROM   "collisions" AS co
      JOIN   "case_ids"   AS ci ON co."case_id" = ci."case_id"
      WHERE  co."pcf_violation_category" IS NOT NULL
      GROUP  BY ci."db_year", co."pcf_violation_category"
) sub
ORDER BY db_year, rk
LIMIT 20;
```

```sql
-- 8. Retrieve just the TOP‑2 causes per year
SELECT *
FROM (
      SELECT db_year,
             pcf_violation_category,
             crash_cnt,
             RANK() OVER (PARTITION BY db_year ORDER BY crash_cnt DESC) AS rk
      FROM (
            SELECT ci."db_year"         AS db_year,
                   co."pcf_violation_category",
                   COUNT(*)             AS crash_cnt
            FROM   "collisions" AS co
            JOIN   "case_ids"   AS ci ON co."case_id" = ci."case_id"
            WHERE  co."pcf_violation_category" IS NOT NULL
            GROUP  BY ci."db_year", co."pcf_violation_category"
      )
) WHERE rk <= 2
ORDER BY db_year, rk
LIMIT 20;
```

```sql
-- 9. Find the *overall* TOP‑2 causes (across all years)
WITH overall AS (
   SELECT co."pcf_violation_category",
          COUNT(*) AS crash_cnt
   FROM   "collisions" AS co
   WHERE  co."pcf_violation_category" IS NOT NULL
   GROUP  BY co."pcf_violation_category"
   ORDER  BY crash_cnt DESC
   LIMIT 2
)
SELECT * FROM overall;
```

```sql
-- 10. Identify the year(s) whose two most common causes differ
WITH overall AS (
   SELECT co."pcf_violation_category"
   FROM   "collisions" AS co
   WHERE  co."pcf_violation_category" IS NOT NULL
   GROUP  BY co."pcf_violation_category"
   ORDER  BY COUNT(*) DESC
   LIMIT 2                                       -- overall top‑2 causes
),
yearly AS (
   SELECT db_year,
          pcf_violation_category,
          crash_cnt,
          ROW_NUMBER() OVER (PARTITION BY db_year ORDER BY crash_cnt DESC) AS rn
   FROM (
         SELECT ci."db_year" AS db_year,
                co."pcf_violation_category",
                COUNT(*) AS crash_cnt
         FROM   "collisions" AS co
         JOIN   "case_ids"   AS ci
                ON co."case_id" = ci."case_id"
         WHERE  co."pcf_violation_category" IS NOT NULL
         GROUP  BY ci."db_year", co."pcf_violation_category"
   )
   WHERE rn <= 2                                -- top‑2 causes within each year
)
SELECT y.db_year
FROM   yearly y
LEFT   JOIN overall o
       ON y.pcf_violation_category = o.pcf_violation_category
GROUP  BY y.db_year
HAVING SUM(CASE WHEN o.pcf_violation_category IS NULL THEN 1 ELSE 0 END) > 0
       -- at least one of its top‑2 causes is NOT in the overall top‑2
   AND SUM(CASE WHEN o.pcf_violation_category IS NULL THEN 1 ELSE 0 END) = 2
       -- both of its top‑2 differ from the overall top‑2
ORDER  BY y.db_year
LIMIT 20;
```

Running the last query will list the year(s) whose top two crash‑causes are *both* different from the prevailing pair of causes seen in the other years.
