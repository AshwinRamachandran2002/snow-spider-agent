```sql
--Description: We want to know which calendar year’s TWO most‑frequent crash causes
--             (column pcf_violation_category) do NOT match the pair of causes that
--             is most common in the other years.  The query proceeds in five steps:
--             1. year_cte   – count crashes by (year, cause) and rank the causes
--                             inside each year by descending frequency.
--             2. year_top2  – keep only the top‑2 causes for every year.
--             3. year_sig   – turn those two causes into an order‑independent
--                             signature MIN(cause)||'|'||MAX(cause).
--             4. overall_sig– find the signature that appears in the greatest
--                             number of years (the “usual” pair of causes).
--             5. final      – return the year(s) whose signature is different
--                             from that overall (modal) pair.
WITH year_cte AS (
    SELECT ci."db_year"                        AS yr,
           co."pcf_violation_category"         AS cause,
           COUNT(*)                            AS cnt,
           RANK() OVER (PARTITION BY ci."db_year"
                        ORDER BY COUNT(*) DESC) AS rk
    FROM   "collisions"  AS co
    JOIN   "case_ids"    AS ci
           ON ci."case_id" = co."case_id"
    WHERE  co."pcf_violation_category" IS NOT NULL
    GROUP  BY ci."db_year", co."pcf_violation_category"
),
year_top2 AS (
    SELECT yr, cause
    FROM   year_cte
    WHERE  rk <= 2                                   -- top‑2 causes per year
),
year_sig AS (
    SELECT yr,
           MIN(cause) || '|' || MAX(cause) AS sig    -- order‑independent pair
    FROM   year_top2
    GROUP  BY yr
),
overall_sig AS (
    SELECT sig
    FROM (
         SELECT sig, COUNT(*) AS freq
         FROM   year_sig
         GROUP  BY sig
         ORDER  BY freq DESC
         LIMIT 1                                     -- the most common signature
    )
)
SELECT ys.yr AS year_with_different_top2
FROM   year_sig  AS ys
WHERE  ys.sig <> (SELECT sig FROM overall_sig)
ORDER  BY ys.yr;
