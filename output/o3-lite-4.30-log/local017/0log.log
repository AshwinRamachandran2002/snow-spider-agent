```sql
--Description:  Identify any calendar year whose TWO most‑frequent crash causes
--              (columns: pcf_violation_category) are BOTH different from the two
--              most‑frequent causes observed when we pool all years together.
--              ----------------------------------------------------------------
--              1. overall_top2 : compute the global TOP‑2 violation categories.
--              2. yr_counts    : count crashes for each (year, category) pair.
--              3. yr_ranked    : rank categories within each year by frequency.
--              4. yr_top2      : keep only rank 1 and 2 per year.
--              5. final list   : for each year, if both of its top‑2 categories
--                                are NOT in overall_top2, return that year.
WITH overall_top2 AS (
     SELECT "pcf_violation_category"
     FROM   "collisions"
     WHERE  "pcf_violation_category" IS NOT NULL
     GROUP  BY "pcf_violation_category"
     ORDER  BY COUNT(*) DESC
     LIMIT  2
),
yr_counts AS (
     SELECT ci."db_year"                    AS yr,
            co."pcf_violation_category"     AS cat,
            COUNT(*)                        AS cnt
     FROM   "collisions" AS co
     JOIN   "case_ids"  AS ci
            ON ci."case_id" = co."case_id"
     WHERE  co."pcf_violation_category" IS NOT NULL
     GROUP  BY ci."db_year", co."pcf_violation_category"
),
yr_ranked AS (
     SELECT yr,
            cat,
            cnt,
            ROW_NUMBER() OVER (PARTITION BY yr ORDER BY cnt DESC) AS rk
     FROM   yr_counts
),
yr_top2 AS (
     SELECT yr, cat
     FROM   yr_ranked
     WHERE  rk <= 2                         -- the two most common causes per year
)
SELECT yt.yr AS year_with_different_top2
FROM   yr_top2 AS yt
LEFT   JOIN overall_top2 AS ot
       ON yt.cat = ot."pcf_violation_category"
GROUP  BY yt.yr
HAVING SUM(CASE WHEN ot."pcf_violation_category" IS NULL THEN 1 ELSE 0 END) = 2
       -- both categories are outside the global TOP‑2
ORDER  BY yt.yr;
```
