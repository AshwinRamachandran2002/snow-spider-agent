--Description: Years whose Top‑2 causes differ from the global Top‑2. 
--1) global_top  – overall two most frequent causes. 
--2) counts      – per‑year counts per cause. 
--3) ranked      – rank within each year. 
--4) yearly_top2 – keep rank ≤ 2. 
--5) diff_years  – years whose Top‑2 set misses at least one global Top‑2 cause.
WITH global_top AS (
    SELECT
        co.pcf_violation_category
    FROM   collisions AS co
    JOIN   case_ids   AS ci ON ci.case_id = co.case_id
    WHERE  co.pcf_violation_category IS NOT NULL
    GROUP  BY co.pcf_violation_category
    ORDER  BY COUNT(*) DESC
    LIMIT 2
),
counts AS (
    SELECT
        ci.db_year,
        co.pcf_violation_category,
        COUNT(*) AS crash_cnt
    FROM   collisions AS co
    JOIN   case_ids   AS ci ON ci.case_id = co.case_id
    WHERE  co.pcf_violation_category IS NOT NULL
    GROUP  BY ci.db_year, co.pcf_violation_category
),
ranked AS (
    SELECT
        db_year,
        pcf_violation_category,
        crash_cnt,
        ROW_NUMBER() OVER (PARTITION BY db_year ORDER BY crash_cnt DESC) AS rn
    FROM counts
),
yearly_top2 AS (
    SELECT
        db_year,
        pcf_violation_category
    FROM   ranked
    WHERE  rn <= 2
),
diff_years AS (
    SELECT
        db_year
    FROM   yearly_top2
    GROUP  BY db_year
    HAVING SUM(
              CASE
                  WHEN pcf_violation_category IN (SELECT pcf_violation_category FROM global_top)
                  THEN 1 ELSE 0
              END
           ) < 2   -- missing at least one of global Top‑2
)
SELECT DISTINCT db_year
FROM   diff_years
ORDER  BY db_year
LIMIT 20
