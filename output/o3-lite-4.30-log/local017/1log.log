```sql
--Description: Identify the year whose two most common collision‑cause categories
--(pcf_violation_category) are different from those of every other year.
--Steps inside this single SQL statement:
-- 1.  per_year_rank  – rank causes by frequency within each year.
-- 2.  per_year_top2  – keep only rank 1 and 2 (the “Top‑2”) for every year.
-- 3.  combo_strings  – convert each year’s Top‑2 set into one canonical string
--                      (alphabetically ordered so that ‘A,B’ and ‘B,A’ look the same).
-- 4.  majority_combo – find the Top‑2 combination that appears in the greatest
--                      number of years (i.e., the “usual” pair).
-- 5.  odd_years      – return the year(s) whose Top‑2 combo differs from that
--                      majority combo.

WITH per_year_rank AS (
    SELECT
        ci."db_year",
        co."pcf_violation_category",
        COUNT(*) AS crash_cnt,
        ROW_NUMBER() OVER (
            PARTITION BY ci."db_year"
            ORDER BY COUNT(*) DESC
        ) AS rn
    FROM "collisions" AS co
    JOIN "case_ids"  AS ci ON ci."case_id" = co."case_id"
    WHERE co."pcf_violation_category" IS NOT NULL
    GROUP BY ci."db_year", co."pcf_violation_category"
),
per_year_top2 AS (
    SELECT "db_year", "pcf_violation_category"
    FROM   per_year_rank
    WHERE  rn <= 2
),
combo_strings AS (
    SELECT
        "db_year",
        -- order the two categories alphabetically, then glue with a comma
        GROUP_CONCAT("pcf_violation_category", ', ' ORDER BY "pcf_violation_category") AS combo
    FROM per_year_top2
    GROUP BY "db_year"
),
majority_combo AS (
    SELECT combo
    FROM   combo_strings
    GROUP  BY combo
    ORDER  BY COUNT(*) DESC       -- most frequent combination among years
    LIMIT 1
),
odd_years AS (
    SELECT cs."db_year"
    FROM   combo_strings AS cs
    WHERE  cs.combo <> (SELECT combo FROM majority_combo)
)
SELECT DISTINCT "db_year"
FROM   odd_years
ORDER  BY "db_year";
```
