Query:
--Description: Top‑2 causes for every year. 
--1) counts – aggregate crashes per (year, cause). 
--2) ranked – add ROW_NUMBER ranking within each year. 
--3) final SELECT – keep rank ≤ 2, show first 20 rows.
WITH counts AS (
    SELECT
        ci.db_year,
        co.pcf_violation_category,
        COUNT(*) AS crash_cnt
    FROM   collisions AS co
    JOIN   case_ids  AS ci ON ci.case_id = co.case_id
    WHERE  co.pcf_violation_category IS NOT NULL
    GROUP  BY ci.db_year, co.pcf_violation_category
),
ranked AS (
    SELECT
        db_year,
        pcf_violation_category,
        crash_cnt,
        ROW_NUMBER() OVER (PARTITION BY db_year ORDER BY crash_cnt DESC) AS rn
    FROM counts
)
SELECT *
FROM   ranked
WHERE  rn <= 2
ORDER  BY db_year, rn
LIMIT 20
