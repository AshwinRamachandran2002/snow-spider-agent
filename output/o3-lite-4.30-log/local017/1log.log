--Description: For each year, concatenate its Top‑2 causes into one string. 
--1) counts – aggregate per (year, cause). 
--2) ranked – rank causes inside each year. 
--3) top2 – keep rank ≤ 2 and build comma‑delimited list.
WITH counts AS (
    SELECT
        ci.db_year,
        co.pcf_violation_category,
        COUNT(*) AS crash_cnt
    FROM   collisions AS co
    JOIN   case_ids  AS ci ON ci.case_id = co.case_id
    WHERE  co.pcf_violation_category IS NOT NULL
    GROUP  BY ci.db_year, co.pcf_violation_category
),
ranked AS (
    SELECT
        db_year,
        pcf_violation_category,
        crash_cnt,
        ROW_NUMBER() OVER (PARTITION BY db_year ORDER BY crash_cnt DESC) AS rn
    FROM counts
),
top2 AS (
    SELECT
        db_year,
        GROUP_CONCAT(pcf_violation_category, ', ') AS top2_causes
    FROM   ranked
    WHERE  rn <= 2
    GROUP  BY db_year
)
SELECT *
FROM   top2
ORDER  BY db_year
