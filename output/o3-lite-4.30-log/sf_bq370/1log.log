             ON il."InvoiceID" = i."InvoiceID"
        GROUP BY i."CustomerID"
     ) ci
  ON ci."CustomerID" = co."CustomerID"
WHERE co."OrderCnt"    = ci."InvoiceCnt"
  AND co."OrderTotal"  = ci."InvoiceTotal"
LIMIT 20;
