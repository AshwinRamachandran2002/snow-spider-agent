LIMIT 20;
```

```sql
-- 5. Derive total order value per order (line‑level roll‑up)
-- Description: sum Quantity * UnitPrice for each order
SELECT
  ol."OrderID",
  SUM(ol."Quantity" * ol."UnitPrice") AS "OrderValue"
FROM
  "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_ORDERLINES" ol
GROUP BY
  ol."OrderID"
LIMIT 20;
```

```sql
-- 6. Derive total invoice value per invoice (line‑level roll‑up)
-- Description: use ExtendedPrice to sum per invoice
SELECT
  il."InvoiceID",
  SUM(il."ExtendedPrice") AS "InvoiceValue"
FROM
  "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" il
GROUP BY
  il."InvoiceID"
LIMIT 20;
```

```sql
-- 7. Compare each order with its related invoice on value
-- Description: keep rows where order value equals invoice value
WITH ord_val AS
(
  SELECT
    ol."OrderID",
    SUM(ol."Quantity" * ol."UnitPrice") AS "OrderValue"
  FROM
    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_ORDERLINES" ol
  GROUP BY
    ol."OrderID"
),
inv_val AS
(
  SELECT
    i."OrderID",
    SUM(il."ExtendedPrice") AS "InvoiceValue"
  FROM
    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"  i
    JOIN "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" il
          ON i."InvoiceID" = il."InvoiceID"
  WHERE
    i."IsCreditNote" = 0
  GROUP BY
    i."OrderID"
)
SELECT
  ord_val."OrderID",
  ord_val."OrderValue",
  inv_val."InvoiceValue"
FROM
  ord_val
  JOIN inv_val USING ("OrderID")
WHERE
  ord_val."OrderValue" = inv_val."InvoiceValue"
LIMIT 20;
```

```sql
-- 8. Count how many order lines exactly match invoice lines per order
-- Description: check line‑item equality (same StockItem, Qty, Price)
SELECT
  o."OrderID",
  COUNT(*) AS "LineMatchCnt"
FROM
  "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_ORDERLINES"  o
  JOIN "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES" i
        ON i."OrderID" = o."OrderID"
  JOIN "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" il
        ON il."InvoiceID"   = i."InvoiceID"
       AND il."StockItemID" = o."StockItemID"
       AND il."Quantity"    = o."Quantity"
       AND il."UnitPrice"   = o."UnitPrice"
WHERE
  i."IsCreditNote" = 0
GROUP BY
  o."OrderID"
LIMIT 20;
```

```sql
-- 9. Aggregate at customer level: orders vs invoices counts & values
-- Description: compute order_cnt, invoice_cnt, order_val, invoice_val per customer
WITH order_summary AS
(
  SELECT
    so."CustomerID",
    COUNT(DISTINCT so."OrderID")                             AS "OrderCnt",
    SUM(ol."Quantity" * ol."UnitPrice")                      AS "OrderValue"
  FROM
    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_ORDERS"      so
    JOIN "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_ORDERLINES" ol
          ON ol."OrderID" = so."OrderID"
  GROUP BY
    so."CustomerID"
),
invoice_summary AS
(
  SELECT
    si."CustomerID",
    COUNT(DISTINCT si."InvoiceID")                            AS "InvoiceCnt",
    SUM(il."ExtendedPrice")                                   AS "InvoiceValue"
  FROM
    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"     si
    JOIN "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" il
          ON il."InvoiceID" = si."InvoiceID"
  WHERE
    si."IsCreditNote" = 0
  GROUP BY
    si."CustomerID"
)
SELECT
  o."CustomerID",
  o."OrderCnt",
  i."InvoiceCnt",
  o."OrderValue",
  i."InvoiceValue"
FROM
  order_summary  o
  JOIN invoice_summary i
        ON i."CustomerID" = o."CustomerID"
LIMIT 20;
```

```sql
-- 10. FINAL: number of customers whose order & invoice counts and values match
-- Description: answer the task – returns the count of such customers
WITH order_summary AS
(
  SELECT
    so."CustomerID",
    COUNT(DISTINCT so."OrderID")                             AS "OrderCnt",
    SUM(ol."Quantity" * ol."UnitPrice")                      AS "OrderValue"
  FROM
    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_ORDERS"      so
    JOIN "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_ORDERLINES" ol
          ON ol."OrderID" = so."OrderID"
  GROUP BY
    so."CustomerID"
),
invoice_summary AS
(
  SELECT
    si."CustomerID",
    COUNT(DISTINCT si."InvoiceID")                            AS "InvoiceCnt",
    SUM(il."ExtendedPrice")                                   AS "InvoiceValue"
  FROM
    "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"     si
    JOIN "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" il
          ON il."InvoiceID" = si."InvoiceID"
  WHERE
    si."IsCreditNote" = 0
  GROUP BY
    si."CustomerID"
)
SELECT
  COUNT(*) AS "Customers_With_Perfect_Order_Invoice_Match"
FROM
  order_summary  o
  JOIN invoice_summary i
        ON i."CustomerID" = o."CustomerID"
WHERE
      o."OrderCnt"    = i."InvoiceCnt"
  AND o."OrderValue"  = i."InvoiceValue";
