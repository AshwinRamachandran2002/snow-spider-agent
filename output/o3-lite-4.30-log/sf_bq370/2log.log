Query:
--Description: Order‑vs‑Invoice line‑item comparison per order.  
--             For every OrderID we calculate:  
--               • total number of order‑lines,  
--               • total number of invoice‑lines (non‑credit),  
--               • total number of “perfect” matches where StockItemID, Quantity and UnitPrice are identical.  
--             Display the first 20 orders together with these counts and the differences, so we can
--             see how close each order comes to a one‑for‑one match at the line level.
WITH ord_lines AS (
    SELECT
        "OrderID",
        COUNT(*) AS "OrderLineCnt"
    FROM
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_ORDERLINES"
    GROUP BY
        "OrderID"
),
inv_lines AS (
    SELECT
        i."OrderID",
        COUNT(*) AS "InvoiceLineCnt"
    FROM
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"      i
    JOIN
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES"  il
          ON il."InvoiceID" = i."InvoiceID"
    WHERE
        i."IsCreditNote" = 0
    GROUP BY
        i."OrderID"
),
matched_lines AS (
    SELECT
        o."OrderID",
        COUNT(*) AS "MatchedLineCnt"
    FROM
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_ORDERLINES"    o
    JOIN
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"      i
          ON i."OrderID" = o."OrderID"
    JOIN
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES"  il
          ON  il."InvoiceID"   = i."InvoiceID"
          AND il."StockItemID" = o."StockItemID"
          AND il."Quantity"    = o."Quantity"
          AND il."UnitPrice"   = o."UnitPrice"
    WHERE
        i."IsCreditNote" = 0
    GROUP BY
        o."OrderID"
)
SELECT
    o."OrderID",
    o."OrderLineCnt",
    v."InvoiceLineCnt",
    m."MatchedLineCnt",
    (o."OrderLineCnt" - v."InvoiceLineCnt")  AS "LineCntDifference",
    (m."MatchedLineCnt" - o."OrderLineCnt")  AS "UnmatchedOrderLines"
FROM
    ord_lines        o
LEFT JOIN
    inv_lines        v ON v."OrderID" = o."OrderID"
LEFT JOIN
    matched_lines    m ON m."OrderID" = o."OrderID"
LIMIT 20
