    COUNT(*) AS matching_customer_count
FROM customer_all_orders   ao
JOIN customer_all_invoices ai ON ai."CustomerID" = ao."CustomerID"
JOIN customer_perfect      cp ON cp."CustomerID" = ao."CustomerID"
WHERE     ao."total_orders"      = ai."total_invoices"
      AND ao."total_orders"      = cp."perfect_orders"
      AND ao."total_order_value" = ai."total_invoice_value"
      AND ao."total_order_value" = cp."perfect_value";
