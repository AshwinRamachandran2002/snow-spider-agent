  "InvoiceID",
  "OrderID",
  "CustomerID",
  "InvoiceDate",
  "IsCreditNote"
FROM
  "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"
WHERE
  "IsCreditNote" = 0
LIMIT 20;
```

```sql
-- 4. Peek at invoice‑line details
-- Description: show 20 invoice lines with quantity and extended price
SELECT
  "InvoiceLineID",
  "InvoiceID",
  "StockItemID",
  "Quantity",
  "UnitPrice",
  "ExtendedPrice"
FROM
