--Description: Order‑vs‑Invoice line‑item comparison per order.  
--             For every OrderID we calculate:  
--               • total number of order‑lines,  
--               • total number of invoice‑lines (non‑credit),  
--               • total number of “perfect” matches where StockItemID, Quantity and UnitPrice are identical.  
--             Display the first 20 orders together with these counts and the differences, so we can
--             see how close each order comes to a one‑for‑one match at the line level.
WITH ord_lines AS (
    SELECT
        "OrderID",
        COUNT(*) AS "OrderLineCnt"
    FROM
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_ORDERLINES"
    GROUP BY
        "OrderID"
),
inv_lines AS (
    SELECT
        i."OrderID",
        COUNT(*) AS "InvoiceLineCnt"
    FROM
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"      i
    JOIN
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES"  il
          ON il."InvoiceID" = i."InvoiceID"
    WHERE
        i."IsCreditNote" = 0
    GROUP BY
        i."OrderID"
),
matched_lines AS (
    SELECT
        o."OrderID",
        COUNT(*) AS "MatchedLineCnt"
    FROM
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_ORDERLINES"    o
    JOIN
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"      i
          ON i."OrderID" = o."OrderID"
    JOIN
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES"  il
          ON  il."InvoiceID"   = i."InvoiceID"
          AND il."StockItemID" = o."StockItemID"
          AND il."Quantity"    = o."Quantity"
          AND il."UnitPrice"   = o."UnitPrice"
    WHERE
        i."IsCreditNote" = 0
    GROUP BY
        o."OrderID"
)
SELECT
    o."OrderID",
    o."OrderLineCnt",
    v."InvoiceLineCnt",
    m."MatchedLineCnt",
    (o."OrderLineCnt" - v."InvoiceLineCnt")  AS "LineCntDifference",
    (m."MatchedLineCnt" - o."OrderLineCnt")  AS "UnmatchedOrderLines"
FROM
    ord_lines        o
LEFT JOIN
    inv_lines        v ON v."OrderID" = o."OrderID"
LEFT JOIN
    matched_lines    m ON m."OrderID" = o."OrderID"
LIMIT 20;
```

```sql
--Description: Customer‑level aggregation of orders vs invoices.  
--             We show counts and values for each side plus the differences, rounded to 2 decimals,
--             for the first 20 customers.  This helps confirm where mismatches arise.
WITH order_summary AS (
    SELECT
        so."CustomerID",
        COUNT(DISTINCT so."OrderID")                AS "OrderCnt",
        SUM(ol."Quantity" * ol."UnitPrice")         AS "OrderValue"
    FROM
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_ORDERS"      so
    JOIN
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_ORDERLINES"  ol
          ON ol."OrderID" = so."OrderID"
    GROUP BY
        so."CustomerID"
),
invoice_summary AS (
    SELECT
        si."CustomerID",
        COUNT(DISTINCT si."InvoiceID")              AS "InvoiceCnt",
        SUM(il."ExtendedPrice")                     AS "InvoiceValue"
    FROM
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"     si
    JOIN
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" il
          ON il."InvoiceID" = si."InvoiceID"
    WHERE
        si."IsCreditNote" = 0
    GROUP BY
        si."CustomerID"
)
SELECT
    o."CustomerID",
    o."OrderCnt",
    i."InvoiceCnt",
    (i."InvoiceCnt" - o."OrderCnt")                     AS "CntDifference",
    ROUND(o."OrderValue",   2)                          AS "OrderValue",
    ROUND(i."InvoiceValue", 2)                          AS "InvoiceValue",
    ROUND(i."InvoiceValue" - o."OrderValue", 2)         AS "ValueDifference"
FROM
    order_summary  o
JOIN
    invoice_summary i ON i."CustomerID" = o."CustomerID"
LIMIT 20;
```

```sql
--Description: Final answer – count of customers whose number of orders equals number of non‑credit
--             invoices *and* whose rounded total order value equals the rounded total invoice value.
--             Rounding to 2 decimals prevents tiny floating‑point discrepancies from disqualifying
--             what are effectively equal totals.
WITH order_summary AS (
    SELECT
        so."CustomerID",
        COUNT(DISTINCT so."OrderID")            AS "OrderCnt",
        ROUND(SUM(ol."Quantity" * ol."UnitPrice"), 2) AS "OrderValue"
    FROM
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_ORDERS"      so
    JOIN
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_ORDERLINES"  ol
          ON ol."OrderID" = so."OrderID"
    GROUP BY
        so."CustomerID"
),
invoice_summary AS (
    SELECT
        si."CustomerID",
        COUNT(DISTINCT si."InvoiceID")          AS "InvoiceCnt",
        ROUND(SUM(il."ExtendedPrice"), 2)       AS "InvoiceValue"
    FROM
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"     si
    JOIN
        "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" il
          ON il."InvoiceID" = si."InvoiceID"
    WHERE
        si."IsCreditNote" = 0
    GROUP BY
        si."CustomerID"
)
SELECT
    COUNT(*) AS "Customers_With_Perfect_Order_Invoice_Match"
FROM
    order_summary  o
JOIN
    invoice_summary i ON i."CustomerID" = o."CustomerID"
WHERE
      o."OrderCnt"   = i."InvoiceCnt"
  AND o."OrderValue" = i."InvoiceValue";
```
