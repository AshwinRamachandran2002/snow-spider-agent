    JOIN "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICES"     si
          ON si."OrderID" = o."OrderID"
         AND si."IsCreditNote" = 0
    JOIN "WIDE_WORLD_IMPORTERS"."WIDE_WORLD_IMPORTERS"."SALES_INVOICELINES" il
          ON il."InvoiceID"   = si."InvoiceID"
         AND il."StockItemID" = o."StockItemID"
         AND il."Quantity"    = o."Quantity"
         AND il."UnitPrice"   = o."UnitPrice"
    GROUP BY o."OrderID"
),
perfect_orders AS (       -- orders whose invoice(s) match perfectly line‑by‑line
    SELECT
        od."CustomerID",
        od."OrderID",
        od."order_value"
    FROM order_details  od
    JOIN invoice_details id ON id."OrderID" = od."OrderID"
    JOIN line_matches   lm ON lm."OrderID" = od."OrderID"
    WHERE     od."order_line_cnt"  = id."invoice_line_cnt"
          AND od."order_line_cnt"  = lm."matched_line_cnt"
          AND od."order_value"     = id."invoice_value"
),
customer_all_orders AS (  -- summary of *all* orders per customer
    SELECT
        "CustomerID",
        COUNT(DISTINCT "OrderID")       AS "total_orders",
        SUM("order_value")              AS "total_order_value"
    FROM order_details
    GROUP BY "CustomerID"
),
customer_all_invoices AS ( -- summary of *all* invoices per customer
    SELECT
        "CustomerID",
        COUNT(DISTINCT "OrderID")       AS "total_invoices",
        SUM("invoice_value")            AS "total_invoice_value"
    FROM invoice_details
    GROUP BY "CustomerID"
),
customer_perfect AS (     -- summary of only the perfectly‑matched orders
    SELECT
        "CustomerID",
        COUNT(DISTINCT "OrderID")       AS "perfect_orders",
        SUM("order_value")              AS "perfect_value"
    FROM perfect_orders
    GROUP BY "CustomerID"
)
