2025-05-01 03:26:30 - Thread-1414 (execute) - INFO - [Exploration]
Relevant columns for the task  
• FacRank: grouping faculty members by rank so we can calculate an average salary for each rank.  
• FacSalary: used to compute the average salary for every rank and to compare each individual’s salary to that average.  
• FacFirstName / FacLastName: identify the faculty members whose salaries are closest to the average.  
No special filter conditions are needed beyond matching ranks within the same table.

Below are ten exploratory‑to‑final SQL queries (all limited to 20 rows where practical).  

```sql
-- 1. Description: See what faculty ranks exist.
SELECT DISTINCT "FacRank"
FROM "university_faculty"
LIMIT 20;
```

```sql
-- 2. Description: Peek at first & last names with their ranks and salaries.
SELECT "FacFirstName",
       "FacLastName",
       "FacRank",
       "FacSalary"
FROM   "university_faculty"
LIMIT 20;
```

```sql
-- 3. Description: Count of faculty members in each rank.
SELECT "FacRank",
       COUNT(*) AS "num_faculty"
FROM   "university_faculty"
GROUP  BY "FacRank"
LIMIT 20;
```

```sql
-- 4. Description: Overall average salary across all ranks.
SELECT AVG("FacSalary") AS "overall_avg_salary"
FROM   "university_faculty";
```

```sql
-- 5. Description: Average salary for every rank.
SELECT "FacRank",
       AVG("FacSalary") AS "avg_salary_by_rank"
FROM   "university_faculty"
GROUP  BY "FacRank"
LIMIT 20;
```

```sql
-- 6. Description: Add absolute difference between each salary
--                 and the average salary of its rank.
SELECT f."FacRank",
       f."FacFirstName",
       f."FacLastName",
       f."FacSalary",
       ABS(f."FacSalary" - r."avg_salary") AS "diff_from_avg"
FROM   "university_faculty" AS f
JOIN  ( SELECT "FacRank",
               AVG("FacSalary") AS "avg_salary"
        FROM   "university_faculty"
        GROUP  BY "FacRank"
      ) AS r
      ON f."FacRank" = r."FacRank"
LIMIT 20;
```

```sql
-- 7. Description: For each rank, find the minimum difference
--                 between an individual's salary and that rank’s average.
SELECT  r."FacRank",
        MIN(ABS(f."FacSalary" - r."avg_salary")) AS "min_diff"
FROM    "university_faculty" AS f
JOIN   ( SELECT "FacRank",
                AVG("FacSalary") AS "avg_salary"
         FROM   "university_faculty"
         GROUP  BY "FacRank"
       ) AS r
       ON f."FacRank" = r."FacRank"
GROUP BY r."FacRank"
LIMIT 20;
```

```sql
-- 8. Description: Join the previous result back to the faculty table
--                 so we keep only those whose difference equals the minimum.
WITH rank_avg AS (
        SELECT "FacRank",
               AVG("FacSalary") AS "avg_salary"
        FROM   "university_faculty"
        GROUP  BY "FacRank"
),
rank_min_diff AS (
        SELECT  ra."FacRank",
                MIN(ABS(f."FacSalary" - ra."avg_salary")) AS "min_diff"
        FROM    "university_faculty" f
        JOIN    rank_avg ra
               ON f."FacRank" = ra."FacRank"
        GROUP BY ra."FacRank"
)
SELECT  f."FacRank",
        f."FacFirstName",
        f."FacLastName",
        f."FacSalary"
FROM    "university_faculty" f
JOIN    rank_avg ra
       ON f."FacRank" = ra."FacRank"
JOIN    rank_min_diff md
       ON f."FacRank" = md."FacRank"
      AND ABS(f."FacSalary" - ra."avg_salary") = md."min_diff"
LIMIT 20;
```

```sql
-- 9. Description: Same logic as #8 but without LIMIT so we get all
--                 closest‐to‐average faculty for every rank.
WITH rank_avg AS (
        SELECT "FacRank",
               AVG("FacSalary") AS "avg_salary"
        FROM   "university_faculty"
        GROUP  BY "FacRank"
),
rank_min_diff AS (
        SELECT  ra."FacRank",
                MIN(ABS(f."FacSalary" - ra."avg_salary")) AS "min_diff"
        FROM    "university_faculty" f
        JOIN    rank_avg ra
               ON f."FacRank" = ra."FacRank"
        GROUP BY ra."FacRank"
)
SELECT  f."FacRank",
        f."FacFirstName",
        f."FacLastName",
        f."FacSalary"
FROM    "university_faculty" f
JOIN    rank_avg ra
       ON f."FacRank" = ra."FacRank"
JOIN    rank_min_diff md
       ON f."FacRank" = md."FacRank"
      AND ABS(f."FacSalary" - ra."avg_salary") = md."min_diff";
```

```sql
-- 10. Description: Final answer, ordered alphabetically by rank
--                  (duplicate of #9 but sorted).
WITH rank_avg AS (
        SELECT "FacRank",
               AVG("FacSalary") AS "avg_salary"
        FROM   "university_faculty"
        GROUP  BY "FacRank"
),
rank_min_diff AS (
        SELECT  ra."FacRank",
                MIN(ABS(f."FacSalary" - ra."avg_salary")) AS "min_diff"
        FROM    "university_faculty" f
        JOIN    rank_avg ra
               ON f."FacRank" = ra."FacRank"
        GROUP BY ra."FacRank"
)
SELECT  f."FacRank",
        f."FacFirstName",
        f."FacLastName",
        f."FacSalary"
FROM    "university_faculty" f
JOIN    rank_avg ra
       ON f."FacRank" = ra."FacRank"
JOIN    rank_min_diff md
       ON f."FacRank" = md."FacRank"
      AND ABS(f."FacSalary" - ra."avg_salary") = md."min_diff"
ORDER BY f."FacRank";
```

