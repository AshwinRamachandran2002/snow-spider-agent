```

```sql
--Description:
--4) Inspect maturity dates beside closing prices for the priciest trades.
SELECT `OrderID`, `MaturityDate`, `StrikePrice`
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
ORDER BY `StrikePrice` DESC
LIMIT 20;
```

```sql
--Description:
--5) Extract and map the algorithm from TargetCompID.
SELECT 
  `OrderID`,
  `TargetCompID`,
  CASE SUBSTR(`TargetCompID`, 1, 4)
    WHEN 'MOMO' THEN 'Momentum'
    WHEN 'LUCK' THEN 'Feeling Lucky'
    WHEN 'PRED' THEN 'Prediction'
  END AS algorithm
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
LIMIT 20;
```

```sql
--Description:
--6) Unnest Sides to view trade directions tied to each order.
SELECT 
  t.`OrderID`,
  s.`Side` AS tradeDirection
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t,
UNNEST(t.`Sides`) AS s
LIMIT 20;
```

```sql
--Description:
--7) Show distinct trade directions.
SELECT DISTINCT s.`Side`
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t,
UNNEST(t.`Sides`) AS s
LIMIT 20;
```

```sql
--Description:
--8) Combine algorithm and tradeDirection for the highest 20 closing prices.
SELECT 
  t.`OrderID`,
  CASE SUBSTR(t.`TargetCompID`, 1, 4)
    WHEN 'MOMO' THEN 'Momentum'
    WHEN 'LUCK' THEN 'Feeling Lucky'
    WHEN 'PRED' THEN 'Prediction'
  END AS algorithm,
  s.`Side` AS tradeDirection,
  t.`StrikePrice` AS closePrice
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t,
UNNEST(t.`Sides`) AS s
ORDER BY closePrice DESC
LIMIT 20;
```

```sql
--Description:
--9) Add a multiplier based on LONG/SHORT.
SELECT 
  t.`OrderID`,
  s.`Side` AS tradeDirection,
  CASE s.`Side` WHEN 'LONG' THEN 1 WHEN 'SHORT' THEN -1 END AS tradeMultiplier
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t,
UNNEST(t.`Sides`) AS s
LIMIT 20;
```

```sql
--Description:
--10) Final answer: top 6 trade reports with the highest closing prices,
--     returning all requested analytical fields.
SELECT
  t.`OrderID`                         AS tradeID,
  t.`MaturityDate`                   AS tradeTimestamp,
  CASE SUBSTR(t.`TargetCompID`, 1, 4)
    WHEN 'MOMO' THEN 'Momentum'
    WHEN 'LUCK' THEN 'Feeling Lucky'
    WHEN 'PRED' THEN 'Prediction'
  END                                 AS algorithm,
  t.`Symbol`                          AS symbol,
  t.`LastPx`                          AS openPrice,
  t.`StrikePrice`                     AS closePrice,
  s.`Side`                            AS tradeDirection,
  CASE s.`Side`
    WHEN 'LONG'  THEN  1
    WHEN 'SHORT' THEN -1
  END                                 AS tradeMultiplier
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t
JOIN UNNEST(t.`Sides`) AS s
ORDER BY closePrice DESC
LIMIT 6;
```
