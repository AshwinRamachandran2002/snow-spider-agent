```sql
--Description: Daily delivery counts per driver (raw aggregation)
SELECT d."driver_id",
       o."order_created_year",
       o."order_created_month",
       o."order_created_day",
       COUNT(*) AS "daily_deliveries"
FROM   "deliveries" AS d
JOIN   "orders"     AS o
       ON o."order_id" = d."delivery_order_id"
GROUP  BY d."driver_id",
         o."order_created_year",
         o."order_created_month",
         o."order_created_day"
LIMIT 20;
```

```sql
--Description: Number of active (worked) days per driver
SELECT sub."driver_id",
       COUNT(*) AS "active_days"
FROM (
       SELECT d."driver_id",
              o."order_created_year",
              o."order_created_month",
              o."order_created_day"
       FROM   "deliveries" AS d
       JOIN   "orders"     AS o
              ON o."order_id" = d."delivery_order_id"
       GROUP  BY d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day"
     ) AS sub
GROUP BY sub."driver_id"
LIMIT 20;
```

```sql
--Description: Average daily deliveries per driver (DELIVERED orders only)
SELECT agg."driver_id",
       AVG(agg."daily_deliveries") AS "avg_daily_deliveries"
FROM (
       SELECT d."driver_id",
              o."order_created_year",
              o."order_created_month",
              o."order_created_day",
              COUNT(*) AS "daily_deliveries"
       FROM   "deliveries" AS d
       JOIN   "orders"     AS o
              ON o."order_id" = d."delivery_order_id"
       WHERE  d."delivery_status" = 'DELIVERED'
         AND  o."order_status"    = 'DELIVERED'
       GROUP  BY d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day"
     ) AS agg
GROUP BY agg."driver_id"
LIMIT 20;
```

```sql
