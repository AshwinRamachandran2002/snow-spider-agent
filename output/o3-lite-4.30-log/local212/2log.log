Begin Exploring Related Columns
Relevant columns and their potential usage
• deliveries.driver_id : key field that tells which driver executed each delivery; used to group deliveries by driver.  
• deliveries.delivery_order_id : foreign‑key that links a delivery to the corresponding order (orders.order_id).  
• deliveries.delivery_status : lets us keep only completed jobs (e.g., 'DELIVERED').  
• orders.order_id : primary key of the order; used to join with deliveries.delivery_order_id.  
• orders.order_status : additional filter to keep only finished orders (‘DELIVERED’).  
• orders.order_moment_delivered (or order_created_day / month / year): date (or date‑parts) that lets us count how many deliveries a driver performs per calendar day.  
• drivers.driver_id : joins the aggregated result to the drivers table.  
• drivers.driver_modal, drivers.driver_type : optional descriptive attributes to show together with the driver_id.

Typical conditions that may be used
• deliveries.delivery_status = 'DELIVERED'  
• orders.order_status     = 'DELIVERED'  
• orders.order_moment_delivered IS NOT NULL  

------------------------------------------------------------------------
Exploratory‑to‑final SQLs  
Each statement is limited to 20 rows and enclosed in ```sql``` blocks.

```sql
--Description: Distinct delivery statuses recorded in the “deliveries” table
SELECT DISTINCT "delivery_status"
FROM "deliveries"
LIMIT 20;
```

```sql
--Description: Distinct order statuses recorded in the “orders” table
SELECT DISTINCT "order_status"
FROM "orders"
LIMIT 20;
```

```sql
--Description: Distinct years present in the orders table (quick idea of time span)
SELECT DISTINCT "order_created_year"
FROM "orders"
LIMIT 20;
```

```sql
--Description: Sample link between a delivery and its order, showing delivered‑at timestamp
SELECT d."driver_id",
       o."order_id",
       o."order_moment_delivered"
FROM   "deliveries" AS d
JOIN   "orders"     AS o
       ON o."order_id" = d."delivery_order_id"
LIMIT 20;
```

```sql
--Description: Daily delivery counts per driver (raw aggregation)
SELECT d."driver_id",
       o."order_created_year",
       o."order_created_month",
       o."order_created_day",
       COUNT(*) AS "daily_deliveries"
FROM   "deliveries" AS d
JOIN   "orders"     AS o
       ON o."order_id" = d."delivery_order_id"
GROUP  BY d."driver_id",
         o."order_created_year",
         o."order_created_month",
         o."order_created_day"
LIMIT 20;
```

```sql
--Description: Number of active (worked) days per driver
SELECT sub."driver_id",
       COUNT(*) AS "active_days"
FROM (
       SELECT d."driver_id",
              o."order_created_year",
              o."order_created_month",
              o."order_created_day"
       FROM   "deliveries" AS d
       JOIN   "orders"     AS o
              ON o."order_id" = d."delivery_order_id"
       GROUP  BY d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day"
     ) AS sub
GROUP BY sub."driver_id"
LIMIT 20;
```

```sql
--Description: Average daily deliveries per driver (DELIVERED orders only)
SELECT agg."driver_id",
       AVG(agg."daily_deliveries") AS "avg_daily_deliveries"
FROM (
       SELECT d."driver_id",
              o."order_created_year",
              o."order_created_month",
              o."order_created_day",
              COUNT(*) AS "daily_deliveries"
       FROM   "deliveries" AS d
       JOIN   "orders"     AS o
              ON o."order_id" = d."delivery_order_id"
       WHERE  d."delivery_status" = 'DELIVERED'
         AND  o."order_status"    = 'DELIVERED'
       GROUP  BY d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day"
     ) AS agg
GROUP BY agg."driver_id"
LIMIT 20;
```

```sql
--Description: Join the previous result with drivers table to show modal/type information
SELECT dr."driver_modal",
       dr."driver_type",
       a."driver_id",
       a."avg_daily_deliveries"
FROM   "drivers" AS dr
JOIN (
       SELECT agg."driver_id",
              AVG(agg."daily_deliveries") AS "avg_daily_deliveries"
       FROM (
              SELECT d."driver_id",
                     o."order_created_year",
                     o."order_created_month",
                     o."order_created_day",
                     COUNT(*) AS "daily_deliveries"
              FROM   "deliveries" AS d
              JOIN   "orders"     AS o
                     ON o."order_id" = d."delivery_order_id"
              WHERE  d."delivery_status" = 'DELIVERED'
                AND  o."order_status"    = 'DELIVERED'
              GROUP  BY d."driver_id",
                        o."order_created_year",
                        o."order_created_month",
                        o."order_created_day"
            ) AS agg
       GROUP BY agg."driver_id"
     ) AS a
       ON dr."driver_id" = a."driver_id"
ORDER BY a."avg_daily_deliveries" DESC
LIMIT 20;
```

```sql
--Description: Same as above, but ordered and limited to the top 10 drivers
SELECT dr."driver_modal",
       dr."driver_type",
       a."driver_id",
       a."avg_daily_deliveries"
FROM   "drivers" AS dr
JOIN (
       SELECT agg."driver_id",
              AVG(agg."daily_deliveries") AS "avg_daily_deliveries"
       FROM (
              SELECT d."driver_id",
                     o."order_created_year",
                     o."order_created_month",
                     o."order_created_day",
                     COUNT(*) AS "daily_deliveries"
              FROM   "deliveries" AS d
              JOIN   "orders"     AS o
                     ON o."order_id" = d."delivery_order_id"
              WHERE  d."delivery_status" = 'DELIVERED'
                AND  o."order_status"    = 'DELIVERED'
              GROUP  BY d."driver_id",
                        o."order_created_year",
                        o."order_created_month",
                        o."order_created_day"
            ) AS agg
       GROUP BY agg."driver_id"
     ) AS a
       ON dr."driver_id" = a."driver_id"
ORDER BY a."avg_daily_deliveries" DESC
LIMIT 10;
```

```sql
--Description: FINAL – Top 5 delivery drivers with the highest average number of daily deliveries
SELECT dr."driver_id",
       dr."driver_modal",
       dr."driver_type",
       a."avg_daily_deliveries"
FROM   "drivers" AS dr
JOIN (
       SELECT agg."driver_id",
              AVG(agg."daily_deliveries") AS "avg_daily_deliveries"
       FROM (
              /* Count how many deliveries each driver made on each calendar date */
              SELECT d."driver_id",
                     DATE(o."order_moment_delivered")            AS "delivery_date",
                     COUNT(*)                                    AS "daily_deliveries"
              FROM   "deliveries" AS d
              JOIN   "orders"     AS o
                     ON o."order_id" = d."delivery_order_id"
              WHERE  d."delivery_status" = 'DELIVERED'
                AND  o."order_status"    = 'DELIVERED'
                AND  o."order_moment_delivered" IS NOT NULL
              GROUP  BY d."driver_id",
                        DATE(o."order_moment_delivered")
            ) AS agg
       GROUP BY agg."driver_id"
     ) AS a
       ON dr."driver_id" = a."driver_id"
ORDER BY a."avg_daily_deliveries" DESC
LIMIT 5;          -- returns the 5 drivers with the highest average daily deliveries
```
