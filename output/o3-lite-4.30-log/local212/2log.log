```sql
--Description:  We need the five drivers whose average number of completed deliveries per calendar day is highest.  
--              The calculation proceeds in two layers:  
--              (1)  Subquery “day_totals” counts how many deliveries each driver completed on each distinct date.  
--                   We rely on orders.order_created_year / month / day columns, avoiding any NULL‑timestamp pitfalls.  
--                   Only rows where BOTH tables say 'DELIVERED' are considered completed.  
--              (2)  The outer query averages those per‑day counts for every driver, joins the drivers table to expose
--                   driver_modal and driver_type, orders by the average in descending order, and limits to 5.  
SELECT
        dr.driver_id,
        dr.driver_modal,
        dr.driver_type,
        ROUND(AVG(day_totals.deliveries_in_day), 2) AS avg_daily_deliveries
FROM    drivers AS dr
JOIN   (
          SELECT d.driver_id,
                 o.order_created_year,
                 o.order_created_month,
                 o.order_created_day,
                 COUNT(*) AS deliveries_in_day
          FROM   deliveries AS d
          JOIN   orders     AS o
                 ON o.order_id = d.delivery_order_id
          WHERE  d.delivery_status = 'DELIVERED'
            AND  o.order_status    = 'DELIVERED'
          GROUP BY d.driver_id,
                   o.order_created_year,
                   o.order_created_month,
                   o.order_created_day
       ) AS day_totals
       ON day_totals.driver_id = dr.driver_id
GROUP BY
        dr.driver_id,
        dr.driver_modal,
        dr.driver_type
ORDER BY
        avg_daily_deliveries DESC
LIMIT 5;
```
