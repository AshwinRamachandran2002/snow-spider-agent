```sql
--Description: FINAL – Top 5 delivery drivers with the highest average number of daily deliveries
SELECT dr."driver_id",
       dr."driver_modal",
       dr."driver_type",
       a."avg_daily_deliveries"
FROM   "drivers" AS dr
JOIN (
       SELECT agg."driver_id",
              AVG(agg."daily_deliveries") AS "avg_daily_deliveries"
       FROM (
              /* Count how many deliveries each driver made on each calendar date */
              SELECT d."driver_id",
                     DATE(o."order_moment_delivered")            AS "delivery_date",
                     COUNT(*)                                    AS "daily_deliveries"
              FROM   "deliveries" AS d
              JOIN   "orders"     AS o
                     ON o."order_id" = d."delivery_order_id"
              WHERE  d."delivery_status" = 'DELIVERED'
                AND  o."order_status"    = 'DELIVERED'
                AND  o."order_moment_delivered" IS NOT NULL
              GROUP  BY d."driver_id",
                        DATE(o."order_moment_delivered")
            ) AS agg
       GROUP BY agg."driver_id"
     ) AS a
       ON dr."driver_id" = a."driver_id"
ORDER BY a."avg_daily_deliveries" DESC
LIMIT 5;          -- returns the 5 drivers with the highest average daily deliveries
