Begin Exploring Related Columns
Relevant columns, usage and typical conditions
• deliveries.driver_id : identifies the courier we have to evaluate  
• deliveries.delivery_status : keep only finished trips → WHERE delivery_status = 'DELIVERED'  
• deliveries.delivery_order_id : key that links each trip to an order  
• orders.order_id : primary‐key of the order – join with deliveries.delivery_order_id  
• orders.order_created_day / order_created_month / order_created_year (or order_moment_created) : give the calendar day so we can count “deliveries per day”  
• (optional) orders.order_status : can be restricted to ‘FINISHED’/’DELIVERED’ if desired, but delivery_status is usually enough  


10 exploratory → final SQL statements
```sql
-- 1) Show distinct driver_id values that exist in the deliveries table
SELECT DISTINCT "driver_id"
FROM "deliveries"
LIMIT 20;
```

```sql
-- 2) Check every delivery status value that appears
SELECT DISTINCT "delivery_status"
FROM "deliveries"
LIMIT 20;
```

```sql
-- 3) Look at a sample of delivered trips with their order link
SELECT DISTINCT "delivery_id",
       "delivery_order_id",
       "driver_id",
       "delivery_status"
FROM "deliveries"
WHERE "delivery_status" = 'DELIVERED'
LIMIT 20;
```

```sql
-- 4) Inspect the date components that exist in the orders table
SELECT DISTINCT "order_created_year",
       "order_created_month",
       "order_created_day"
FROM "orders"
LIMIT 20;
```

```sql
-- 5) Join one trip to its order to make sure the relationship works
SELECT DISTINCT d."driver_id",
       d."delivery_order_id",
       o."order_created_year",
       o."order_created_month",
       o."order_created_day"
FROM   "deliveries" AS d
JOIN   "orders"     AS o
       ON o."order_id" = d."delivery_order_id"
WHERE  d."delivery_status" = 'DELIVERED'
LIMIT 20;
```

```sql
-- 6) Count how many deliveries each driver made on each calendar day
SELECT DISTINCT d."driver_id",
       o."order_created_year",
       o."order_created_month",
       o."order_created_day",
       COUNT(*) AS "daily_deliveries"
FROM   "deliveries" AS d
JOIN   "orders"     AS o
       ON o."order_id" = d."delivery_order_id"
WHERE  d."delivery_status" = 'DELIVERED'
GROUP  BY d."driver_id",
          o."order_created_year",
          o."order_created_month",
          o."order_created_day"
LIMIT 20;
```

```sql
-- 7) For every driver show total delivered orders and number of active days
SELECT DISTINCT t."driver_id",
       t."total_deliveries",
       t."active_days"
FROM (
      SELECT d."driver_id",
             COUNT(*)                                             AS "total_deliveries",
             COUNT(DISTINCT printf('%04d-%02d-%02d',
                                 o."order_created_year",
                                 o."order_created_month",
                                 o."order_created_day"))         AS "active_days"
      FROM   "deliveries" AS d
      JOIN   "orders"     AS o
             ON o."order_id" = d."delivery_order_id"
      WHERE  d."delivery_status" = 'DELIVERED'
      GROUP  BY d."driver_id"
) AS t
LIMIT 20;
```

```sql
-- 8) Compute the average number of deliveries per active day for each driver
SELECT DISTINCT t."driver_id",
       ROUND(1.0 * t."total_deliveries" / t."active_days", 2) AS "avg_daily_deliveries"
FROM (
      SELECT d."driver_id",
             COUNT(*)                                             AS "total_deliveries",
             COUNT(DISTINCT printf('%04d-%02d-%02d',
                                 o."order_created_year",
                                 o."order_created_month",
                                 o."order_created_day"))         AS "active_days"
      FROM   "deliveries" AS d
      JOIN   "orders"     AS o
             ON o."order_id" = d."delivery_order_id"
      WHERE  d."delivery_status" = 'DELIVERED'
      GROUP  BY d."driver_id"
) AS t
ORDER  BY "avg_daily_deliveries" DESC
LIMIT 20;
```

```sql
-- 9) Show the top‑10 couriers with the highest average number of daily deliveries
SELECT DISTINCT t."driver_id",
       ROUND(1.0 * t."total_deliveries" / t."active_days", 2) AS "avg_daily_deliveries"
FROM (
      SELECT d."driver_id",
             COUNT(*)                                             AS "total_deliveries",
             COUNT(DISTINCT printf('%04d-%02d-%02d',
                                 o."order_created_year",
                                 o."order_created_month",
                                 o."order_created_day"))         AS "active_days"
      FROM   "deliveries" AS d
      JOIN   "orders"     AS o
             ON o."order_id" = d."delivery_order_id"
      WHERE  d."delivery_status" = 'DELIVERED'
      GROUP  BY d."driver_id"
) AS t
ORDER  BY "avg_daily_deliveries" DESC
LIMIT 10;
```

```sql
-- 10) FINAL: retrieve the 5 drivers with the highest average daily deliveries
SELECT t."driver_id",
       ROUND(1.0 * t."total_deliveries" / t."active_days", 2) AS "avg_daily_deliveries"
FROM (
      SELECT d."driver_id",
             COUNT(*)                                             AS "total_deliveries",
             COUNT(DISTINCT printf('%04d-%02d-%02d',
                                 o."order_created_year",
                                 o."order_created_month",
                                 o."order_created_day"))         AS "active_days"
      FROM   "deliveries" AS d
      JOIN   "orders"     AS o
             ON o."order_id" = d."delivery_order_id"
      WHERE  d."delivery_status" = 'DELIVERED'
      GROUP  BY d."driver_id"
) AS t
ORDER  BY "avg_daily_deliveries" DESC
LIMIT 5;
```
