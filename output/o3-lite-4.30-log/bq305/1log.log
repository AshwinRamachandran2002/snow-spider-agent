```sql
--Description: 4) Compute, for every question, the total score of its answers and
--              the number of answers, then list the 20 questions whose answers
--              accumulated the highest total score.
SELECT
  parent_id AS question_id,
  SUM(score) AS total_answer_score,
  COUNT(*)   AS answers
FROM `bigquery-public-data.stackoverflow.posts_answers`
GROUP BY parent_id
ORDER BY total_answer_score DESC
LIMIT 20;
```

```sql
--Description: 5) Retrieve the 20 answers with score higher than 5, showing the
--              answer id, its parent question id, the answer author and the score.
SELECT
  id          AS answer_id,
  parent_id   AS question_id,
  owner_user_id,
  score
FROM `bigquery-public-data.stackoverflow.posts_answers`
WHERE score > 5
ORDER BY score DESC
LIMIT 20;
```

```sql
--Description: 6) List answers whose score is positive and exceeds 20 % of the
--              total score of all answers to their respective question; include
--              the question’s total score for reference.  Display the top 20 by
--              answer score.
WITH totals AS (
  SELECT
    parent_id AS question_id,
    SUM(score) AS total_score
  FROM `bigquery-public-data.stackoverflow.posts_answers`
  GROUP BY parent_id
)
SELECT
  a.id          AS answer_id,
  a.parent_id   AS question_id,
  a.owner_user_id,
  a.score,
  t.total_score
FROM `bigquery-public-data.stackoverflow.posts_answers` AS a
JOIN totals AS t
  ON a.parent_id = t.question_id
WHERE a.score > 0
  AND a.score > 0.20 * t.total_score
ORDER BY a.score DESC
LIMIT 20;
