2025-05-01 02:16:07 - Thread-746 (execute) - INFO - [Exploration]
Relevant columns and how they will be used  

(posts_questions)  
• id : question identifier – join to answers.parent_id and to votes.post_id (if you need extra information)  
• owner_user_id : user that asked the question – counts as an ‘associated’ user  
• accepted_answer_id : id of the accepted answer – used to find the answer‑owner who is also ‘associated’  
• view_count : number of views that must be summed for every “associated” user  
• answer_count / score / tags / creation_date : can be handy for filters or checking we are on questions only  

(posts_answers)  
• id : answer identifier – used to compare with accepted_answer_id and to rank answers  
• parent_id : question id – main join back to posts_questions.id  
• owner_user_id : user that wrote the answer – ‘associated’ if any of the conditions is satisfied  
• score :  needed for the three “score”‑based conditions ( >5,  >20 % of total answer score,  in top‑3 per question)  

(users)  
• id : user identifier – join so we can later show the user’s display_name  
• display_name : the text to show in the final answer  

(we do not strictly need the votes table because answers already contain the aggregated score column).  


Typical conditions that will be required  

1. Question owner ⇒  posts_questions.owner_user_id = users.id  
2. Accepted answer owner ⇒  posts_questions.accepted_answer_id = posts_answers.id  
3. Answer score > 5 ⇒  posts_answers.score > 5  
4. Answer score > 0 and > 20 % of total score of all answers of that question  
5. Answer in the 3 highest scores for its question (ties allowed)  

-------------------------------------------------------------------------------
Sample / exploratory queries (each returns at most 20 rows)

```sql
-- 1. Inspect questions: id, owner, views
SELECT id AS question_id, owner_user_id, view_count
FROM `bigquery-public-data.stackoverflow.posts_questions`
ORDER BY view_count DESC
LIMIT 20;
```

```sql
-- 2. Top‑viewed questions together with their accepted_answer_id
SELECT id AS question_id, accepted_answer_id, view_count
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE accepted_answer_id IS NOT NULL
ORDER BY view_count DESC
LIMIT 20;
```

```sql
-- 3. All answers (id, parent_id, score, owner) for one concrete question
--    (replace 12345 with an actual question_id found above)
SELECT id AS answer_id, parent_id AS question_id, owner_user_id, score
FROM `bigquery-public-data.stackoverflow.posts_answers`
WHERE parent_id = 12345
ORDER BY score DESC
LIMIT 20;
```

```sql
-- 4. Compute total answer score for each question (first 20)
SELECT parent_id AS question_id,
       SUM(score) AS total_answer_score,
       COUNT(*)  AS answers
FROM `bigquery-public-data.stackoverflow.posts_answers`
GROUP BY question_id
ORDER BY total_answer_score DESC
LIMIT 20;
```

```sql
-- 5. Answers whose score is >5  (simple “high score” condition)
SELECT id AS answer_id, parent_id AS question_id, owner_user_id, score
FROM `bigquery-public-data.stackoverflow.posts_answers`
WHERE score > 5
ORDER BY score DESC
LIMIT 20;
```

```sql
-- 6. Answers that exceed 20 % of the total score of their question
WITH totals AS (
  SELECT parent_id      AS question_id,
         SUM(score)     AS total_score
  FROM `bigquery-public-data.stackoverflow.posts_answers`
  GROUP BY question_id
)
SELECT a.id       AS answer_id,
       a.parent_id AS question_id,
       a.owner_user_id,
       a.score,
       t.total_score
FROM   `bigquery-public-data.stackoverflow.posts_answers` AS a
JOIN   totals AS t
  ON   a.parent_id = t.question_id
WHERE  a.score  > 0
  AND  a.score  > 0.20 * t.total_score
ORDER BY a.score DESC
LIMIT 20;
```

```sql
-- 7. Top‑3 scoring answers per question (ties included)
WITH ranked AS (
  SELECT parent_id      AS question_id,
         id             AS answer_id,
         owner_user_id,
         score,
         DENSE_RANK() OVER(PARTITION BY parent_id ORDER BY score DESC) AS rnk
  FROM `bigquery-public-data.stackoverflow.posts_answers`
)
SELECT *
FROM   ranked
WHERE  rnk <= 3
ORDER BY question_id, rnk
LIMIT 20;
```

```sql
-- 8. Put all four answer‑based association rules together for each question
WITH
totals AS (
  SELECT parent_id AS question_id, SUM(score) AS total_score
  FROM `bigquery-public-data.stackoverflow.posts_answers`
  GROUP BY question_id
),
ranked AS (
  SELECT parent_id      AS question_id,
         id             AS answer_id,
         owner_user_id,
         score,
         DENSE_RANK() OVER(PARTITION BY parent_id ORDER BY score DESC) AS rnk
  FROM `bigquery-public-data.stackoverflow.posts_answers`
),
qualified AS (
  SELECT r.*
  FROM   ranked AS r
  JOIN   totals AS t  ON r.question_id = t.question_id
  WHERE  r.score > 5
     OR  (r.score > 0 AND r.score > 0.20 * t.total_score)
     OR  r.rnk <= 3
)
SELECT *
FROM   qualified
ORDER BY score DESC
LIMIT 20;
```

```sql
-- 9. List every question together with ALL associated user_ids
WITH
-- a) question owners
q_owner AS (
  SELECT id AS question_id, owner_user_id
  FROM   `bigquery-public-data.stackoverflow.posts_questions`
  WHERE  owner_user_id IS NOT NULL
),
-- b) accepted answer owners
accepted AS (
  SELECT q.id AS question_id, a.owner_user_id
  FROM   `bigquery-public-data.stackoverflow.posts_questions` AS q
  JOIN   `bigquery-public-data.stackoverflow.posts_answers`  AS a
    ON   q.accepted_answer_id = a.id
),
-- c) qualified answers (using previous CTE “qualified”)
totals AS (
  SELECT parent_id AS question_id, SUM(score) AS total_score
  FROM `bigquery-public-data.stackoverflow.posts_answers`
  GROUP BY question_id
),
ranked AS (
  SELECT parent_id AS question_id,
         id,
         owner_user_id,
         score,
         DENSE_RANK() OVER(PARTITION BY parent_id ORDER BY score DESC) AS rnk
  FROM `bigquery-public-data.stackoverflow.posts_answers`
),
qual_ans AS (
  SELECT question_id, owner_user_id
  FROM   ranked  AS r
  JOIN   totals  AS t  ON r.question_id = t.question_id
  WHERE  r.score > 5
     OR  (r.score > 0 AND r.score > 0.20 * t.total_score)
     OR  r.rnk  <= 3
)
SELECT DISTINCT question_id, owner_user_id
FROM (
  SELECT * FROM q_owner
  UNION ALL
  SELECT * FROM accepted
  UNION ALL
  SELECT * FROM qual_ans
)
LIMIT 20;
```

```sql
-- 10. Final answer: top 10 users with the highest combined view_count
WITH
-- list of associated (question_id, user_id) pairs  (same logic as #9)
q_owner AS (
  SELECT id AS question_id, owner_user_id
  FROM   `bigquery-public-data.stackoverflow.posts_questions`
  WHERE  owner_user_id IS NOT NULL
),
accepted AS (
  SELECT q.id AS question_id, a.owner_user_id
  FROM   `bigquery-public-data.stackoverflow.posts_questions` AS q
  JOIN   `bigquery-public-data.stackoverflow.posts_answers`  AS a
    ON   q.accepted_answer_id = a.id
),
totals AS (
  SELECT parent_id AS question_id, SUM(score) AS total_score
  FROM `bigquery-public-data.stackoverflow.posts_answers`
  GROUP BY question_id
),
ranked AS (
  SELECT parent_id AS question_id,
         id,
         owner_user_id,
         score,
         DENSE_RANK() OVER(PARTITION BY parent_id ORDER BY score DESC) AS rnk
  FROM `bigquery-public-data.stackoverflow.posts_answers`
),
qual_ans AS (
  SELECT question_id, owner_user_id
  FROM   ranked  AS r
  JOIN   totals  AS t  ON r.question_id = t.question_id
  WHERE  r.score > 5
     OR  (r.score > 0 AND r.score > 0.20 * t.total_score)
     OR  r.rnk  <= 3
),
all_assoc AS (
  SELECT * FROM q_owner
  UNION ALL
  SELECT * FROM accepted
  UNION ALL
  SELECT * FROM qual_ans
),
-- Sum the view_count of every question for each associated user
joined AS (
  SELECT a.owner_user_id                             AS user_id,
         SUM(q.view_count)                           AS total_views
  FROM   all_assoc          AS a
  JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
    ON   a.question_id = q.id
  GROUP  BY user_id
)
SELECT u.id           AS user_id,
       u.display_name,
       j.total_views
FROM   joined AS j
JOIN   `bigquery-public-data.stackoverflow.users` AS u
  ON   u.id = j.user_id
ORDER  BY j.total_views DESC
LIMIT 10;
```

The first nine queries are purely exploratory, gradually building up every required element; the tenth query puts everything together and returns the requested result set: the 10 users that have the largest summed view counts over all questions with which they are “associated” under any of the five stated rules.
