```sql
--Description:
-- Task : Find the 10 users whose associated questions (by any of the five given rules)
--         accumulate the largest total view_count.
-- Thinking process (inline as comments):
--  1.  Identify every (question_id, user_id) pair that satisfies at least one rule.
--      • Rule A – the question owner.
--      • Rule B – owner of the accepted answer.
--      • Rule C – any answer whose score > 5.
--      • Rule D – any answer whose score > 0 AND > 20 % of the total score of all answers
--                 to that question.
--      • Rule E – the three highest‑scoring answers for the question (ties allowed).
--  2.  UNION ALL the pairs coming from each rule into a single list (all_assoc).
--      DISTINCT is applied later when we aggregate, so duplicates are harmless.
--  3.  Join that list to posts_questions to fetch each question’s view_count.
--  4.  Aggregate by user_id to sum up view_count.
--  5.  Join to users to show display_name, then return the top‑10 totals.

WITH
/* ---------------------------------------------------------
   Rule A : question owner
--------------------------------------------------------- */
q_owner AS (
  SELECT id AS question_id,
         owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_questions`
  WHERE  owner_user_id IS NOT NULL
),

/* ---------------------------------------------------------
   Rule B : accepted answer owner
--------------------------------------------------------- */
accepted AS (
  SELECT q.id                AS question_id,
         a.owner_user_id     AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_questions` AS q
  JOIN   `bigquery-public-data.stackoverflow.posts_answers`   AS a
         ON a.id = q.accepted_answer_id
  WHERE  a.owner_user_id IS NOT NULL
),

/* ---------------------------------------------------------
   Pre‑work for Rules C, D, E : per‑question totals & answer ranks
--------------------------------------------------------- */
answer_totals AS (          -- total score per question
  SELECT parent_id AS question_id,
         SUM(score) AS total_answer_score
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  GROUP  BY parent_id
),
ranked_answers AS (         -- rank answers by score within each question
  SELECT parent_id                 AS question_id,
         id                        AS answer_id,
         owner_user_id             AS user_id,
         score,
         DENSE_RANK() OVER (PARTITION BY parent_id
                            ORDER BY score DESC) AS rank_in_question
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  WHERE  owner_user_id IS NOT NULL
),

/* ---------------------------------------------------------
   Rule C : answers with score > 5
--------------------------------------------------------- */
rule_c AS (
  SELECT question_id, user_id
  FROM   ranked_answers
  WHERE  score > 5
),

/* ---------------------------------------------------------
   Rule D : answers with score > 0 AND > 20 % of total answer score
--------------------------------------------------------- */
rule_d AS (
  SELECT r.question_id, r.user_id
  FROM   ranked_answers AS r
  JOIN   answer_totals AS t
         ON r.question_id = t.question_id
  WHERE  r.score > 0
    AND  r.score > 0.20 * t.total_answer_score
),

/* ---------------------------------------------------------
   Rule E : top‑3 answers (ties included)
--------------------------------------------------------- */
rule_e AS (
  SELECT question_id, user_id
  FROM   ranked_answers
  WHERE  rank_in_question <= 3
),

/* ---------------------------------------------------------
   Combine all rules
--------------------------------------------------------- */
all_assoc AS (
  SELECT * FROM q_owner
  UNION ALL
  SELECT * FROM accepted
  UNION ALL
  SELECT * FROM rule_c
  UNION ALL
  SELECT * FROM rule_d
  UNION ALL
  SELECT * FROM rule_e
),

/* ---------------------------------------------------------
   Sum question view_counts for each associated user
--------------------------------------------------------- */
user_views AS (
  SELECT a.user_id,
         SUM(q.view_count) AS total_views
  FROM   all_assoc AS a
  JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
         ON q.id = a.question_id
  GROUP  BY a.user_id
)

/* ---------------------------------------------------------
   Final output : 10 users with the highest totals
--------------------------------------------------------- */
SELECT u.id           AS user_id,
       u.display_name,
       user_views.total_views
FROM   user_views
JOIN   `bigquery-public-data.stackoverflow.users` AS u
       ON u.id = user_views.user_id
ORDER  BY user_views.total_views DESC
LIMIT 10;
```
