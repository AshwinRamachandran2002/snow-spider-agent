  JOIN   `bigquery-public-data.stackoverflow.posts_answers`   AS a
         ON a.id = q.accepted_answer_id
  WHERE  a.owner_user_id IS NOT NULL
),

/* ---------------------------------------------------------
   Pre‑work for Rules C, D, E : per‑question totals & answer ranks
--------------------------------------------------------- */
answer_totals AS (          -- total score per question
  SELECT parent_id AS question_id,
         SUM(score) AS total_answer_score
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  GROUP  BY parent_id
),
ranked_answers AS (         -- rank answers by score within each question
  SELECT parent_id                 AS question_id,
         id                        AS answer_id,
         owner_user_id             AS user_id,
         score,
         DENSE_RANK() OVER (PARTITION BY parent_id
                            ORDER BY score DESC) AS rank_in_question
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  WHERE  owner_user_id IS NOT NULL
),

/* ---------------------------------------------------------
   Rule C : answers with score > 5
--------------------------------------------------------- */
rule_c AS (
  SELECT question_id, user_id
  FROM   ranked_answers
  WHERE  score > 5
),

/* ---------------------------------------------------------
   Rule D : answers with score > 0 AND > 20 % of total answer score
--------------------------------------------------------- */
rule_d AS (
  SELECT r.question_id, r.user_id
  FROM   ranked_answers AS r
  JOIN   answer_totals AS t
         ON r.question_id = t.question_id
  WHERE  r.score > 0
    AND  r.score > 0.20 * t.total_answer_score
),

/* ---------------------------------------------------------
   Rule E : top‑3 answers (ties included)
--------------------------------------------------------- */
rule_e AS (
  SELECT question_id, user_id
  FROM   ranked_answers
  WHERE  rank_in_question <= 3
),

/* ---------------------------------------------------------
   Combine all rules
--------------------------------------------------------- */
all_assoc AS (
  SELECT * FROM q_owner
  UNION ALL
  SELECT * FROM accepted
  UNION ALL
  SELECT * FROM rule_c
  UNION ALL
  SELECT * FROM rule_d
  UNION ALL
  SELECT * FROM rule_e
),

/* ---------------------------------------------------------
   Sum question view_counts for each associated user
--------------------------------------------------------- */
user_views AS (
  SELECT a.user_id,
         SUM(q.view_count) AS total_views
  FROM   all_assoc AS a
  JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
         ON q.id = a.question_id
  GROUP  BY a.user_id
)

/* ---------------------------------------------------------
   Final output : 10 users with the highest totals
--------------------------------------------------------- */
SELECT u.id           AS user_id,
       u.display_name,
       user_views.total_views
FROM   user_views
JOIN   `bigquery-public-data.stackoverflow.users` AS u
       ON u.id = user_views.user_id
ORDER  BY user_views.total_views DESC
LIMIT 10;
