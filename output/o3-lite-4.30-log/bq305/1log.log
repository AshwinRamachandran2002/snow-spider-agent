--Description: 8) Combine the three answer–based rules (score > 5, >20 % of total,
--              or in top‑3) into one set called “qualified”; list 20 sample rows.
WITH totals AS (
  SELECT parent_id AS question_id, SUM(score) AS total_score
  FROM `bigquery-public-data.stackoverflow.posts_answers`
  GROUP BY parent_id
),
ranked AS (
  SELECT parent_id AS question_id,
         id        AS answer_id,
         owner_user_id,
         score,
         DENSE_RANK() OVER (PARTITION BY parent_id ORDER BY score DESC) AS rnk
  FROM `bigquery-public-data.stackoverflow.posts_answers`
),
qualified AS (
  SELECT r.*
  FROM   ranked AS r
  JOIN   totals AS t
    ON   r.question_id = t.question_id
  WHERE  r.score > 5
     OR  (r.score > 0 AND r.score > 0.20 * t.total_score)
     OR  r.rnk  <= 3
)
SELECT *
FROM qualified
ORDER BY score DESC
LIMIT 20
