Query:
--Description: Return the 10 users who accumulate the largest total of
--             question views, counting every question with which they are
--             “associated”.  Association is defined by five rules:
--               1. They own the question.
--               2. They authored the accepted answer.
--               3. They authored an answer whose score > 5.
--               4. They authored one of the three highest‑scoring answers.
--               5. They authored an answer whose score is > 0 and also
--                  greater than 20 % of the sum of all answer scores for
--                  that question.
--             Each rule is implemented in its own CTE, then UNIONed into
--             one set of (question_id,user_id) pairs (assoc).  Finally the
--             query sums view_count per user and returns the top‑10.
WITH
/*---------------------------------------------------------------
  Rule 1 – the question owner
----------------------------------------------------------------*/
owners AS (
  SELECT id           AS question_id,
         owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_questions`
  WHERE  owner_user_id IS NOT NULL
),
/*---------------------------------------------------------------
  Rule 2 – author of the accepted answer
----------------------------------------------------------------*/
accepted AS (
  SELECT q.id            AS question_id,
         a.owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN   `bigquery-public-data.stackoverflow.posts_answers`  a
         ON q.accepted_answer_id = a.id
  WHERE  a.owner_user_id IS NOT NULL
),
/*---------------------------------------------------------------
  Rule 3 – any answer with score > 5
----------------------------------------------------------------*/
score_gt5 AS (
  SELECT parent_id    AS question_id,
         owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  WHERE  score > 5
    AND  owner_user_id IS NOT NULL
),
/*---------------------------------------------------------------
  Rule 4 – the three highest‑scoring answers for each question
----------------------------------------------------------------*/
top3 AS (
  SELECT parent_id    AS question_id,
         owner_user_id AS user_id
  FROM (
        SELECT parent_id,
               owner_user_id,
               ROW_NUMBER() OVER (PARTITION BY parent_id
                                  ORDER BY score DESC) AS rnk
        FROM   `bigquery-public-data.stackoverflow.posts_answers`
        WHERE  owner_user_id IS NOT NULL
  )
  WHERE rnk <= 3
),
/*---------------------------------------------------------------
  Rule 5 – answers with score > 0 and > 20 % of total answer score
----------------------------------------------------------------*/
pct20 AS (
  /* totals of positive scores per question */
  WITH totals AS (
    SELECT parent_id AS question_id,
           SUM(score) AS total_positive
    FROM   `bigquery-public-data.stackoverflow.posts_answers`
    WHERE  score > 0
    GROUP  BY parent_id
  )
  SELECT a.parent_id     AS question_id,
         a.owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_answers` a
  JOIN   totals t
         ON a.parent_id = t.question_id
  WHERE  a.score > 0
    AND  a.score > 0.20 * t.total_positive
    AND  a.owner_user_id IS NOT NULL
),
/*---------------------------------------------------------------
  Union of all associations, 1 row per (question,user)
----------------------------------------------------------------*/
assoc AS (
  SELECT DISTINCT question_id, user_id FROM owners
  UNION DISTINCT
  SELECT DISTINCT question_id, user_id FROM accepted
  UNION DISTINCT
  SELECT DISTINCT question_id, user_id FROM score_gt5
  UNION DISTINCT
  SELECT DISTINCT question_id, user_id FROM top3
  UNION DISTINCT
  SELECT DISTINCT question_id, user_id FROM pct20
)
/*---------------------------------------------------------------
  Aggregate view counts per user and return the top‑10
----------------------------------------------------------------*/
SELECT u.id                 AS user_id,
       u.display_name,
       SUM(q.view_count)    AS total_views
FROM   assoc                       a
JOIN   `bigquery-public-data.stackoverflow.posts_questions` q
       ON a.question_id = q.id
JOIN   `bigquery-public-data.stackoverflow.users`          u
       ON a.user_id = u.id
WHERE  q.view_count IS NOT NULL
GROUP  BY user_id, display_name
ORDER  BY total_views DESC
LIMIT 10
