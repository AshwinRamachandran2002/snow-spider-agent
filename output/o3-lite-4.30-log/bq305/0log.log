Relevant tables / columns and how they will be used  

• bigquery-public-data.stackoverflow.posts_questions  
  – id                     : primary‑key of the question → used to join to answers  
  – view_count      : number of views that must be summed for qualified users  
  – owner_user_id  : gives the user that “owns” the question (direct association)  
  – accepted_answer_id : id of the answer that was accepted → used to associate its author  
  – answer_count / score / tags … (not strictly needed but sometimes handy)  

• bigquery-public-data.stackoverflow.posts_answers  
  – id                     : primary‑key of the answer  
  – parent_id        : id of the question it answers (foreign‑key into posts_questions.id)  
  – owner_user_id  : the author of the answer (user we might associate)  
  – score             : answer score – used for the different “association” rules  

• bigquery-public-data.stackoverflow.users  
  – id                     : user id (to fetch a display name at the end)  
  – display_name    : name to show in the final list (optional for debugging)

Those three tables are sufficient to solve the problem; all other Stack Overflow tables are not needed for the requested metric.

Below are ten exploratory / incremental BigQuery SQL snippets (each limited to 20 rows) that get progressively closer to the final solution.

```sql
-- 1. Peek at some questions
SELECT id, owner_user_id, view_count, accepted_answer_id
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE view_count IS NOT NULL
LIMIT 20;
```

```sql
-- 2. Inspect answers together with their parent questions
SELECT a.id AS answer_id,
       a.parent_id AS question_id,
       a.owner_user_id AS answer_user,
       a.score
FROM `bigquery-public-data.stackoverflow.posts_answers` AS a
WHERE a.score IS NOT NULL
LIMIT 20;
```

```sql
-- 3. Join Q ↔ A and fetch accepted–answer information
SELECT q.id                 AS question_id,
       q.accepted_answer_id AS accepted_ans_id,
       a.id                 AS answer_id,
       a.owner_user_id      AS answer_owner
FROM `bigquery-public-data.stackoverflow.posts_questions` AS q
LEFT JOIN `bigquery-public-data.stackoverflow.posts_answers`  AS a
       ON q.accepted_answer_id = a.id
WHERE q.accepted_answer_id IS NOT NULL
LIMIT 20;
```

```sql
-- 4. Total answer‑scores per question (needed for the “20 % of total” rule)
SELECT parent_id        AS question_id,
       SUM(score)       AS total_answer_score
FROM   `bigquery-public-data.stackoverflow.posts_answers`
WHERE  score IS NOT NULL
GROUP  BY parent_id
LIMIT 20;
```

```sql
-- 5. Pick answers whose score > 5  (one of the eligibility rules)
SELECT id      AS answer_id,
       parent_id AS question_id,
       owner_user_id,
       score
FROM   `bigquery-public-data.stackoverflow.posts_answers`
WHERE  score > 5
LIMIT 20;
```

```sql
-- 6. Top‑three answers (by score) for each question
SELECT *
FROM (
    SELECT parent_id        AS question_id,
           id               AS answer_id,
           owner_user_id    AS answer_owner,
           score,
           ROW_NUMBER() OVER (PARTITION BY parent_id ORDER BY score DESC) AS rnk
    FROM   `bigquery-public-data.stackoverflow.posts_answers`
    WHERE  score IS NOT NULL
)
WHERE rnk <= 3
LIMIT 20;
```

```sql
-- 7. Answers whose score is > 0 and > 20 % of the total answer scores for that question
WITH total AS (
  SELECT parent_id AS question_id, SUM(score) AS total_score
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  WHERE  score > 0
  GROUP  BY parent_id
)
SELECT a.id            AS answer_id,
       a.parent_id     AS question_id,
       a.owner_user_id AS answer_owner,
       a.score,
       t.total_score
FROM   `bigquery-public-data.stackoverflow.posts_answers` AS a
JOIN   total                                 AS t
       ON a.parent_id = t.question_id
WHERE  a.score > 0
  AND  a.score > 0.2 * t.total_score
LIMIT 20;
```

```sql
-- 8. All “associated” users for each question (union of all rules, 1 row per (question,user))
WITH
q AS (
  SELECT id AS question_id,
         owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_questions`
  WHERE  owner_user_id IS NOT NULL
),
accepted AS (
  SELECT q.id            AS question_id,
         a.owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_questions` AS q
  JOIN   `bigquery-public-data.stackoverflow.posts_answers`  AS a
         ON q.accepted_answer_id = a.id
),
score_gt5 AS (
  SELECT parent_id AS question_id,
         owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  WHERE  score > 5
),
top3 AS (
  SELECT question_id, answer_owner AS user_id
  FROM (
      SELECT parent_id AS question_id,
             owner_user_id AS answer_owner,
             ROW_NUMBER() OVER (PARTITION BY parent_id ORDER BY score DESC) AS rnk
      FROM   `bigquery-public-data.stackoverflow.posts_answers`
  )
  WHERE rnk <= 3
),
pct20 AS (
  WITH tot AS (
     SELECT parent_id AS question_id, SUM(score) AS total_score
     FROM   `bigquery-public-data.stackoverflow.posts_answers`
     WHERE  score > 0
     GROUP  BY parent_id
  )
  SELECT a.parent_id AS question_id,
         a.owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_answers` a
  JOIN   tot t ON a.parent_id = t.question_id
  WHERE  a.score > 0
    AND  a.score > 0.2 * t.total_score
)
SELECT DISTINCT question_id, user_id
FROM   (SELECT * FROM q
        UNION ALL SELECT * FROM accepted
        UNION ALL SELECT * FROM score_gt5
        UNION ALL SELECT * FROM top3
        UNION ALL SELECT * FROM pct20)
LIMIT 20;
```

```sql
-- 9. Add the view_count of each question to every associated user
WITH assoc AS (   -- same CTE from step 8
  SELECT DISTINCT question_id, user_id
  FROM (
        /*  COPY‑PASTE the UNION block from step‑8 here  */
  )
)
SELECT a.user_id,
       q.view_count
FROM   assoc AS a
JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
       ON a.question_id = q.id
WHERE  q.view_count IS NOT NULL
LIMIT 20;
```

```sql
-- 10. FINAL: top 10 users by cumulative view_count over all associated questions
WITH
/* ---------- build the association set (same as step 8) ---------- */
owners AS (
  SELECT id AS question_id, owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_questions`
  WHERE  owner_user_id IS NOT NULL
),
accepted AS (
  SELECT q.id AS question_id, a.owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN   `bigquery-public-data.stackoverflow.posts_answers`  a
         ON q.accepted_answer_id = a.id
),
score_gt5 AS (
  SELECT parent_id AS question_id, owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  WHERE  score > 5
),
top3 AS (
  SELECT parent_id AS question_id, owner_user_id AS user_id
  FROM (
      SELECT parent_id, owner_user_id,
             ROW_NUMBER() OVER (PARTITION BY parent_id ORDER BY score DESC) AS rnk
      FROM   `bigquery-public-data.stackoverflow.posts_answers`
  )
  WHERE rnk <= 3
),
pct20 AS (
  WITH tot AS (
     SELECT parent_id, SUM(score) AS tot_score
     FROM   `bigquery-public-data.stackoverflow.posts_answers`
     WHERE  score > 0
     GROUP  BY parent_id
  )
  SELECT a.parent_id AS question_id, a.owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_answers` a
  JOIN   tot ON tot.parent_id = a.parent_id
  WHERE  a.score > 0
    AND  a.score > 0.2 * tot.tot_score
),
assoc AS (
  SELECT DISTINCT * FROM owners
  UNION DISTINCT SELECT * FROM accepted
  UNION DISTINCT SELECT * FROM score_gt5
  UNION DISTINCT SELECT * FROM top3
  UNION DISTINCT SELECT * FROM pct20
)
/* ---------- aggregate views over users ---------- */
SELECT u.id           AS user_id,
       u.display_name,
       SUM(q.view_count) AS total_views
FROM   assoc AS a
JOIN   `bigquery-public-data.stackoverflow.posts_questions`  q
       ON a.question_id = q.id
JOIN   `bigquery-public-data.stackoverflow.users`            u
       ON a.user_id = u.id
WHERE  q.view_count IS NOT NULL
GROUP  BY user_id, display_name
ORDER  BY total_views DESC
LIMIT 10;
```

These ten queries move from simple inspection of the data all the way to a complete answer that returns the ten users with the highest combined view counts, based strictly on the association criteria given.
