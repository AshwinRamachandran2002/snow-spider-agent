Query:
--Description:  Return the 10 users who are associated with the most‑viewed
--questions (association defined by the five rules).  The query:
--  • Builds one CTE for every rule to obtain (question_id,user_id) pairs.
--  • Unions these CTEs, removes duplicates and rows where user_id IS NULL.
--  • Joins the resulting associations with the questions table to obtain the
--    view_count for each question.
--  • Aggregates view_count per user and orders by the total, showing the top 10
--    together with the users’ display names.

WITH
/*──────── Rule 1: question authors ────────*/
question_owners AS (
  SELECT id AS question_id,
         owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_questions`
  WHERE  owner_user_id IS NOT NULL
),
/*──────── Rule 2: accepted‑answer authors ────────*/
accepted_answerers AS (
  SELECT q.id            AS question_id,
         a.owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN   `bigquery-public-data.stackoverflow.posts_answers`   a
         ON q.accepted_answer_id = a.id
),
/*──────── Rule 3: answers with score > 5 ────────*/
answers_score_gt5 AS (
  SELECT parent_id     AS question_id,
         owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  WHERE  score > 5
),
/*──────── Rule 4: answers whose score ≥ 20 % of total (and > 0) ────────*/
answers_pct20 AS (
  WITH total AS (
    SELECT parent_id AS question_id,
           SUM(score) AS total_score
    FROM   `bigquery-public-data.stackoverflow.posts_answers`
    GROUP  BY question_id
  )
  SELECT a.parent_id     AS question_id,
         a.owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_answers` a
  JOIN   total t ON a.parent_id = t.question_id
  WHERE  a.score > 0
    AND  a.score >= 0.20 * t.total_score
),
/*──────── Rule 5: top‑3 highest‑scoring answers per question ────────*/
top3_answers AS (
  SELECT question_id,
         owner_user_id AS user_id
  FROM (
    SELECT parent_id AS question_id,
           owner_user_id,
           DENSE_RANK() OVER (PARTITION BY parent_id ORDER BY score DESC) AS rnk
    FROM   `bigquery-public-data.stackoverflow.posts_answers`
  )
  WHERE rnk <= 3
),
/*──────── Combine all rules, drop duplicates & NULL users ────────*/
all_associations AS (
  SELECT DISTINCT question_id, user_id FROM (
    SELECT * FROM question_owners
    UNION ALL
    SELECT * FROM accepted_answerers
    UNION ALL
    SELECT * FROM answers_score_gt5
    UNION ALL
    SELECT * FROM answers_pct20
    UNION ALL
    SELECT * FROM top3_answers
  )
  WHERE user_id IS NOT NULL
),
/*──────── Question view counts ────────*/
question_views AS (
  SELECT id AS question_id,
         view_count
  FROM   `bigquery-public-data.stackoverflow.posts_questions`
  WHERE  view_count IS NOT NULL
),
/*──────── Aggregate total views per user ────────*/
user_view_totals AS (
  SELECT a.user_id,
         SUM(q.view_count) AS total_views
  FROM   all_associations a
  JOIN   question_views   q USING (question_id)
  GROUP  BY a.user_id
)
/*──────── Final list with display names ────────*/
SELECT u.user_id,
       p.display_name,
       u.total_views AS combined_view_count
FROM   user_view_totals u
JOIN   `bigquery-public-data.stackoverflow.users` p
       ON u.user_id = p.id
ORDER  BY combined_view_count DESC
LIMIT  10
