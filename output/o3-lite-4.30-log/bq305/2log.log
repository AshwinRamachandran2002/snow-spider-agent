```sql
--Description / Thinking process:
-- 1. Identify every (question_id, user_id) pair that satisfies at least
--    one of the five association rules spelled out in the task.
-- 2. UNION ALL those rule‑specific result sets and SELECT DISTINCT to
--    obtain a de‑duplicated association list.
-- 3. Join that list with the question table to pick up each question’s
--    view_count (ignoring questions without a recorded view_count).
-- 4. SUM the view_count per user_id.
-- 5. Sort by the aggregated view total and return the top 20 users.
--
-- CTE layout mirrors these steps: one CTE for each rule, one CTE to unify
-- them, one CTE for question views, and the final SELECT.

WITH
/* ───────── Rule 1: question owners ───────── */
question_owners AS (
  SELECT id AS question_id,
         owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_questions`
  WHERE  owner_user_id IS NOT NULL
),
/* ───────── Rule 2: accepted‑answer authors ───────── */
accepted_answerers AS (
  SELECT q.id              AS question_id,
         a.owner_user_id   AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_questions` q
  JOIN   `bigquery-public-data.stackoverflow.posts_answers`   a
    ON   q.accepted_answer_id = a.id
),
/* ───────── Rule 3: answers with score > 5 ───────── */
answers_score_gt5 AS (
  SELECT parent_id     AS question_id,
         owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_answers`
  WHERE  score > 5
),
/* ───── Rule 4: answers ≥ 20 % of total answer score (and > 0) ───── */
answers_pct20 AS (
  /* first compute total answer score per question */
  WITH totals AS (
    SELECT parent_id AS question_id,
           SUM(score) AS total_score
    FROM   `bigquery-public-data.stackoverflow.posts_answers`
    GROUP  BY question_id
  )
  SELECT a.parent_id     AS question_id,
         a.owner_user_id AS user_id
  FROM   `bigquery-public-data.stackoverflow.posts_answers` a
  JOIN   totals t ON a.parent_id = t.question_id
  WHERE  a.score > 0
    AND  a.score >= 0.20 * t.total_score
),
/* ───────── Rule 5: top‑3 scoring answers per question ───────── */
top3_answers AS (
  SELECT question_id,
         owner_user_id AS user_id
  FROM (
    SELECT parent_id        AS question_id,
           owner_user_id,
           DENSE_RANK() OVER (PARTITION BY parent_id ORDER BY score DESC) AS rnk
    FROM   `bigquery-public-data.stackoverflow.posts_answers`
  )
  WHERE rnk <= 3
),
/* ───────── Combine rules (distinct pairs) ───────── */
associations AS (
  SELECT DISTINCT question_id, user_id FROM (
    SELECT * FROM question_owners
    UNION ALL
    SELECT * FROM accepted_answerers
    UNION ALL
    SELECT * FROM answers_score_gt5
    UNION ALL
    SELECT * FROM answers_pct20
    UNION ALL
    SELECT * FROM top3_answers
  )
),
/* ───────── Question view counts ───────── */
question_views AS (
  SELECT id AS question_id,
         view_count
  FROM   `bigquery-public-data.stackoverflow.posts_questions`
  WHERE  view_count IS NOT NULL
)
/* ───────── Final aggregation ───────── */
SELECT a.user_id,
       SUM(q.view_count) AS combined_view_count
FROM   associations   a
JOIN   question_views q USING (question_id)
GROUP  BY a.user_id
ORDER  BY combined_view_count DESC
LIMIT  20;
