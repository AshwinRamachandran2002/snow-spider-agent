```sql
--10. Description: Illustrative query that computes pairwise distances between the first 20 amenities
--                 inside Philadelphia and returns the shortest one (sample only).
WITH phila AS (
  SELECT ST_GEOMFROMWKB(pl."place_geom") AS "poly"
  FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_US_CENSUS_PLACES"."PLACES_PENNSYLVANIA" pl
  WHERE pl."place_name" = 'Philadelphia'
  LIMIT 1
),
amenities AS (
  SELECT pt."osm_id",
         ST_GEOMFROMWKB(pt."geometry") AS "geom"
  FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
       phila,
       LATERAL FLATTEN( INPUT => pt."all_tags" ) f
  WHERE f.value:"key"::STRING = 'amenity'
    AND f.value:"value"::STRING ILIKE ANY ( '%library%', '%place%worship%', '%community%centre%' )
    AND ST_CONTAINS( (SELECT "poly" FROM phila), ST_GEOMFROMWKB(pt."geometry") )
  LIMIT 20
)
SELECT a1."osm_id"  AS "amenity_id_1",
       a2."osm_id"  AS "amenity_id_2",
       ST_DISTANCE(a1."geom", a2."geom") AS "distance_meters"
FROM amenities a1
JOIN amenities a2
  ON a1."osm_id" < a2."osm_id"
ORDER BY "distance_meters"
LIMIT 20;
```

