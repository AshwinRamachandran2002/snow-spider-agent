--Description: 8) List the first 20 amenity points (library, place_of_worship, community centre/center)
--             located in or on the boundary of Philadelphia, returning their coordinates.
WITH philly AS (
    SELECT ST_GEOMFROMWKB("place_geom") AS geom
    FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_US_CENSUS_PLACES"."PLACES_PENNSYLVANIA"
    WHERE "place_id" = '4260000'
