```sql
--Description: 9) Pairwise distances between the first 10 Philadelphia amenity points (sample).
WITH philly AS (
  SELECT ST_GEOMFROMWKB("place_geom") AS geom
  FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_US_CENSUS_PLACES"."PLACES_PENNSYLVANIA"
  WHERE "place_name" ILIKE '%Philadelphia%'
  LIMIT 1
),
amen AS (
  SELECT 
    pt."osm_id",
    ST_GEOMFROMWKB(pt."geometry") AS geom_pt
  FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
       LATERAL FLATTEN( input => pt."all_tags" ) f,
       philly
  WHERE f.value:"key"::STRING = 'amenity'
    AND ( f.value:"value"::STRING ILIKE '%library%' 
          OR f.value:"value"::STRING ILIKE '%place%worship%'
          OR f.value:"value"::STRING ILIKE '%community%centre%'
          OR f.value:"value"::STRING ILIKE '%community%center%' )
    AND ST_CONTAINS( philly.geom , ST_GEOMFROMWKB(pt."geometry") )
  LIMIT 10
)
SELECT a1."osm_id"  AS "amenity_id_1",
       a2."osm_id"  AS "amenity_id_2",
       ST_DISTANCE( a1.geom_pt , a2.geom_pt ) AS "meters_distance"
FROM amen a1
JOIN amen a2
  ON a1."osm_id" < a2."osm_id"
LIMIT 20;
```

