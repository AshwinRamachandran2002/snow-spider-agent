10 exploratory / step‑by‑step Snowflake SQL queries (each returns ≤ 20 rows)

```sql
--Description: 1) Inspect Pennsylvania places whose name contains “Philadelphia”.
SELECT 
  "place_id",
  "place_name",
  "state_fips_code",
  "area_land_meters"
FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_US_CENSUS_PLACES"."PLACES_PENNSYLVANIA"
WHERE "place_name" ILIKE '%Philadelphia%'
LIMIT 20;
```

```sql
--Description: 2) Visualise WKT of Philadelphia polygon for manual checking.
SELECT 
  "place_id",
  ST_ASWKT( ST_GEOMFROMWKB("place_geom") ) AS "philadelphia_wkt"
FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_US_CENSUS_PLACES"."PLACES_PENNSYLVANIA"
WHERE "place_name" ILIKE '%Philadelphia%'
LIMIT 20;
```

```sql
--Description: 3) Look at raw OSM point tags – explode `all_tags` for a random sample.
SELECT 
  pt."osm_id",
  f.value:"key"::STRING   AS "tag_key",
  f.value:"value"::STRING AS "tag_value"
FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
     LATERAL FLATTEN( input => pt."all_tags" ) f
LIMIT 20;
```

```sql
--Description: 4) Distinct amenity values that exist in the data set (sample).
SELECT DISTINCT
  f.value:"value"::STRING AS "amenity_value"
FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
     LATERAL FLATTEN( input => pt."all_tags" ) f
WHERE f.value:"key"::STRING = 'amenity'
LIMIT 20;
```

```sql
--Description: 5) Fetch points whose amenity looks like library / worship / community (fuzzy).
SELECT 
  pt."osm_id",
  f.value:"value"::STRING AS "amenity",
  ST_ASWKT( ST_GEOMFROMWKB(pt."geometry") ) AS "wkt_point"
FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
     LATERAL FLATTEN( input => pt."all_tags" ) f
WHERE f.value:"key"::STRING = 'amenity'
  AND ( f.value:"value"::STRING ILIKE '%library%' 
        OR f.value:"value"::STRING ILIKE '%place%worship%'
        OR f.value:"value"::STRING ILIKE '%community%centre%'
        OR f.value:"value"::STRING ILIKE '%community%center%' )
LIMIT 20;
```

```sql
--Description: 6) Attach Philadelphia polygon and keep only amenities inside it.
WITH philly AS (
  SELECT ST_GEOMFROMWKB("place_geom") AS geom
  FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_US_CENSUS_PLACES"."PLACES_PENNSYLVANIA"
  WHERE "place_name" ILIKE '%Philadelphia%'
  LIMIT 1
)
SELECT 
  pt."osm_id",
  f.value:"value"::STRING AS "amenity",
  pt."osm_timestamp"
FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
     LATERAL FLATTEN( input => pt."all_tags" ) f,
     philly
WHERE f.value:"key"::STRING = 'amenity'
  AND ( f.value:"value"::STRING ILIKE '%library%' 
        OR f.value:"value"::STRING ILIKE '%place%worship%'
        OR f.value:"value"::STRING ILIKE '%community%centre%'
        OR f.value:"value"::STRING ILIKE '%community%center%' )
  AND ST_CONTAINS( philly.geom , ST_GEOMFROMWKB(pt."geometry") )
LIMIT 20;
```

```sql
--Description: 7) Number of each amenity type inside Philadelphia (quick aggregation).
WITH philly AS (
  SELECT ST_GEOMFROMWKB("place_geom") AS geom
  FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_US_CENSUS_PLACES"."PLACES_PENNSYLVANIA"
  WHERE "place_name" ILIKE '%Philadelphia%'
  LIMIT 1
),
amenities AS (
  SELECT 
    f.value:"value"::STRING AS amenity,
    ST_GEOMFROMWKB(pt."geometry") AS geom_pt
  FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
       LATERAL FLATTEN( input => pt."all_tags" ) f
  WHERE f.value:"key"::STRING = 'amenity'
    AND ( f.value:"value"::STRING ILIKE '%library%' 
          OR f.value:"value"::STRING ILIKE '%place%worship%'
          OR f.value:"value"::STRING ILIKE '%community%centre%'
          OR f.value:"value"::STRING ILIKE '%community%center%' )
)
SELECT amenity, COUNT(*) AS cnt
FROM amenities, philly
WHERE ST_CONTAINS( philly.geom , amenities.geom_pt )
GROUP BY amenity
LIMIT 20;
```

```sql
--Description: 8) Retrieve first 20 Philadelphia amenity points with their coordinates.
WITH philly AS (
  SELECT ST_GEOMFROMWKB("place_geom") AS geom
  FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_US_CENSUS_PLACES"."PLACES_PENNSYLVANIA"
  WHERE "place_name" ILIKE '%Philadelphia%'
  LIMIT 1
)
SELECT 
  pt."osm_id",
  f.value:"value"::STRING  AS "amenity",
  ST_X( ST_GEOMFROMWKB(pt."geometry") ) AS "lon",
  ST_Y( ST_GEOMFROMWKB(pt."geometry") ) AS "lat"
FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
     LATERAL FLATTEN( input => pt."all_tags" ) f,
     philly
WHERE f.value:"key"::STRING = 'amenity'
  AND ( f.value:"value"::STRING ILIKE '%library%' 
        OR f.value:"value"::STRING ILIKE '%place%worship%'
        OR f.value:"value"::STRING ILIKE '%community%centre%'
        OR f.value:"value"::STRING ILIKE '%community%center%' )
  AND ST_CONTAINS( philly.geom , ST_GEOMFROMWKB(pt."geometry") )
LIMIT 20;
```

```sql
--Description: 9) Pairwise distances between the first 10 Philadelphia amenity points (sample).
WITH philly AS (
  SELECT ST_GEOMFROMWKB("place_geom") AS geom
  FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_US_CENSUS_PLACES"."PLACES_PENNSYLVANIA"
  WHERE "place_name" ILIKE '%Philadelphia%'
  LIMIT 1
),
amen AS (
  SELECT 
    pt."osm_id",
    ST_GEOMFROMWKB(pt."geometry") AS geom_pt
  FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
       LATERAL FLATTEN( input => pt."all_tags" ) f,
       philly
  WHERE f.value:"key"::STRING = 'amenity'
    AND ( f.value:"value"::STRING ILIKE '%library%' 
          OR f.value:"value"::STRING ILIKE '%place%worship%'
          OR f.value:"value"::STRING ILIKE '%community%centre%'
          OR f.value:"value"::STRING ILIKE '%community%center%' )
    AND ST_CONTAINS( philly.geom , ST_GEOMFROMWKB(pt."geometry") )
  LIMIT 10
)
SELECT a1."osm_id"  AS "amenity_id_1",
       a2."osm_id"  AS "amenity_id_2",
       ST_DISTANCE( a1.geom_pt , a2.geom_pt ) AS "meters_distance"
FROM amen a1
JOIN amen a2
  ON a1."osm_id" < a2."osm_id"
LIMIT 20;
```

```sql
--Description: 10) Compute the shortest distance between ANY two amenities in Philadelphia.
WITH philly AS (
  SELECT ST_GEOMFROMWKB("place_geom") AS geom
  FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_US_CENSUS_PLACES"."PLACES_PENNSYLVANIA"
  WHERE "place_name" ILIKE '%Philadelphia%'
  LIMIT 1
),
amen AS (
  SELECT 
    pt."osm_id",
    ST_GEOMFROMWKB(pt."geometry") AS geom_pt
  FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt,
       LATERAL FLATTEN( input => pt."all_tags" ) f,
       philly
  WHERE f.value:"key"::STRING = 'amenity'
    AND ( f.value:"value"::STRING ILIKE '%library%' 
          OR f.value:"value"::STRING ILIKE '%place%worship%'
          OR f.value:"value"::STRING ILIKE '%community%centre%'
          OR f.value:"value"::STRING ILIKE '%community%center%' )
    AND ST_CONTAINS( philly.geom , ST_GEOMFROMWKB(pt."geometry") )
)
SELECT MIN( ST_DISTANCE(a1.geom_pt , a2.geom_pt) ) AS "min_distance_meters"
FROM amen a1
JOIN amen a2
  ON a1."osm_id" < a2."osm_id"
LIMIT 20;
```
