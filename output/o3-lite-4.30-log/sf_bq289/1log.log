```sql
--Description: Thinking process – earlier query returned no rows, possibly because the amenity value
--list was too strict or because points lie on the border and ST_CONTAINS excluded them.  
--Step‑by‑step logic below is embedded in the single SQL:
--  1. Pull Philadelphia’s polygon by its unique "place_id" = 4260000.  
--  2. Flatten each point’s "all_tags" array to expose key / value pairs.  
--  3. Keep only rows where key = 'amenity' and the value loosely matches any of our targets
--     (library, place_of_worship, or the various spellings of community centre / center).  
--  4. Use ST_INTERSECTS (more permissive than ST_CONTAINS) to catch points on or within the boundary.  
--  5. Display the first 20 matches with WKT geometry so we can verify that the query does return data.  
WITH philly AS (
    SELECT ST_GEOMFROMWKB("place_geom") AS geom
    FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_US_CENSUS_PLACES"."PLACES_PENNSYLVANIA"
    WHERE "place_id" = '4260000'          -- Philadelphia
)
SELECT
    pt."osm_id",
    f.value:"value"::STRING AS "amenity",
    ST_ASWKT( ST_GEOMFROMWKB(pt."geometry") ) AS "wkt_point"
FROM "GEO_OPENSTREETMAP_CENSUS_PLACES"."GEO_OPENSTREETMAP"."PLANET_FEATURES_POINTS" pt
     ,LATERAL FLATTEN( input => pt."all_tags" ) f
     ,philly
WHERE f.value:"key"::STRING = 'amenity'
  AND (
        f.value:"value"::STRING ILIKE 'library'
        OR f.value:"value"::STRING ILIKE 'place_of_worship'
        OR f.value:"value"::STRING ILIKE 'community%centre'
        OR f.value:"value"::STRING ILIKE 'community%center'
      )
  AND ST_INTERSECTS( philly.geom , ST_GEOMFROMWKB(pt."geometry") )
LIMIT 20;
