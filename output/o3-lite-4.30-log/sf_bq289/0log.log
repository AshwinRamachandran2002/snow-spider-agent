```sql
--Description:  Goal ─ find the shortest distance (in meters) between any two amenities
--              (library, place_of_worship, community_centre) that lie INSIDE the
--              Philadelphia census‑place polygon.  Steps encoded below:
--              ①  Build CTE “philly_poly”   → fetch Philadelphia’s polygon.
--              ②  Build CTE “philly_amen”   → pull OSM point features, flatten all_tags,
--                 keep rows whose key = 'amenity' and value matches target list,
--                 and spatially filter with ST_CONTAINS against Philadelphia’s polygon.
--              ③  Self‑join philly_amen to itself (id_a < id_b) so every unordered
--                 pair appears once.
--              ④  Use ST_DISTANCE on the two geometries and take MIN() to obtain
--                 the single shortest distance.
WITH philly_poly AS (
    SELECT "place_geom"
    FROM GEO_OPENSTREETMAP_CENSUS_PLACES.GEO_US_CENSUS_PLACES.PLACES_PENNSYLVANIA
    WHERE "place_name" = 'Philadelphia'            -- exact match found earlier
    LIMIT 1
),
philly_amen AS (
    SELECT
           poi."osm_id",
           poi_amenity.value:"value"::STRING  AS amenity_type,
           poi."geometry"
    FROM GEO_OPENSTREETMAP_CENSUS_PLACES.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS poi,
         LATERAL FLATTEN( input => poi."all_tags" )                               poi_amenity,
         philly_poly
    WHERE poi_amenity.value:"key"::STRING = 'amenity'
      AND poi_amenity.value:"value"::STRING ILIKE ANY
            ('%library%', '%place_of_worship%', '%community_centre%')
      AND ST_CONTAINS( TO_GEOGRAPHY(philly_poly."place_geom"),
                       TO_GEOGRAPHY(poi."geometry") )
)
SELECT
       MIN( ST_DISTANCE( TO_GEOGRAPHY(a."geometry"),
                         TO_GEOGRAPHY(b."geometry") ) ) AS shortest_distance_meters
FROM philly_amen a
JOIN philly_amen b
  ON a."osm_id" < b."osm_id";
```
