Begin Exploring Related Columns
column name: potential usage  
• "type": identify the kind of GitHub event (“PullRequestEvent”).  
• "payload": JSON string that contains the pull‑request “action” field – look for `"opened"`.  
• "created_at": numeric timestamp – filter to events that happened on 2023‑01‑18.  
• "repo": JSON object whose key `name` is the repository full name – join to the languages table.  
• "repo_name": repository full name in the languages table – join key.  
• "language": VARIANT that lists the languages used in a repo – look for an element that equals `"JavaScript"` (case‑insensitive).

Typical conditions that will be useful  
1. "type" = 'PullRequestEvent'  
2. TRY_PARSE_JSON("payload"):action::STRING = 'opened'  
3. DATE_FROM_PARTS(2023,1,18) = TO_DATE(TO_TIMESTAMP("created_at"/1e6))   -- adjust if the unit is µs  
4. ARRAY_CONTAINS(LOWER(value)::STRING, 'javascript') when flattening the "language" array  
5. Join on  TRY_PARSE_JSON("repo"):name::STRING = "repo_name"  

Below are 10 Snowflake SQL snippets (all capped with LIMIT 20) that progressively explore the data and end with the count.  
Each query is wrapped in ```sql``` and starts with a comment that explains what it does.

```sql
-- Description: Quick glance at 2023 event rows to see the structure.
SELECT 
    "type",
    "created_at",
    "payload",
    "repo"
FROM GITHUB_REPOS_DATE.YEAR."_2023"
LIMIT 20;
```

```sql
-- Description: Extract repo name and action field from the JSON payload to verify parsing.
SELECT
    TRY_PARSE_JSON("repo"):name::STRING              AS "repo_name",
    TRY_PARSE_JSON("payload"):action::STRING         AS "pr_action",
    "type",
    "created_at"
FROM GITHUB_REPOS_DATE.YEAR."_2023"
WHERE "type" = 'PullRequestEvent'
LIMIT 20;
```

```sql
-- Description: Inspect languages data – confirm how JavaScript appears.
SELECT 
    "repo_name",
    "language"
FROM GITHUB_REPOS_DATE.GITHUB_REPOS.LANGUAGES
WHERE "language" IS NOT NULL
LIMIT 20;
```

```sql
-- Description: Show only repos whose language array contains 'JavaScript'.
SELECT 
    l."repo_name",
    l."language"
FROM GITHUB_REPOS_DATE.GITHUB_REPOS.LANGUAGES  AS l,
     LATERAL FLATTEN(input => l."language")    AS f
WHERE LOWER(f.value::STRING) = 'javascript'
LIMIT 20;
```

```sql
-- Description: Combine previous steps – pull‑request events *opened* on 18‑Jan‑2023.
SELECT
    TRY_PARSE_JSON("repo"):name::STRING              AS "repo_name",
    "created_at",
    TRY_PARSE_JSON("payload"):action::STRING         AS "pr_action"
FROM GITHUB_REPOS_DATE.YEAR."_2023"
WHERE "type" = 'PullRequestEvent'
  AND TRY_PARSE_JSON("payload"):action::STRING = 'opened'
  AND TO_DATE(TO_TIMESTAMP("created_at" / 1e6)) = '2023-01-18'
LIMIT 20;
```

```sql
-- Description: Join the above event list with the JavaScript‑repos list.
SELECT
    e."repo_name",
    e."created_at"
FROM (
    SELECT
        TRY_PARSE_JSON("repo"):name::STRING      AS "repo_name",
        "created_at"
    FROM GITHUB_REPOS_DATE.YEAR."_2023"
    WHERE "type" = 'PullRequestEvent'
      AND TRY_PARSE_JSON("payload"):action::STRING = 'opened'
      AND TO_DATE(TO_TIMESTAMP("created_at" / 1e6)) = '2023-01-18'
) AS e
JOIN (
    SELECT DISTINCT l."repo_name"
    FROM GITHUB_REPOS_DATE.GITHUB_REPOS.LANGUAGES  AS l,
         LATERAL FLATTEN(input => l."language")    AS f
    WHERE LOWER(f.value::STRING) = 'javascript'
) AS j
ON e."repo_name" = j."repo_name"
LIMIT 20;
```

```sql
-- Description: Same as previous, but include a few sample JSON language arrays for verification.
SELECT
    e."repo_name",
    e."created_at",
    l."language"
FROM (
    SELECT
        TRY_PARSE_JSON("repo"):name::STRING      AS "repo_name",
        "created_at"
    FROM GITHUB_REPOS_DATE.YEAR."_2023"
    WHERE "type" = 'PullRequestEvent'
      AND TRY_PARSE_JSON("payload"):action::STRING = 'opened'
      AND TO_DATE(TO_TIMESTAMP("created_at" / 1e6)) = '2023-01-18'
) AS e
JOIN GITHUB_REPOS_DATE.GITHUB_REPOS.LANGUAGES l
      ON e."repo_name" = l."repo_name",
     LATERAL FLATTEN(input => l."language") f
WHERE LOWER(f.value::STRING) = 'javascript'
LIMIT 20;
```

```sql
-- Description: Count pull‑request creation events on 18‑Jan‑2023 for JavaScript repos.
SELECT 
    COUNT(*) AS "pull_request_opened_js_repos"
FROM (
    SELECT
        TRY_PARSE_JSON("repo"):name::STRING      AS "repo_name"
    FROM GITHUB_REPOS_DATE.YEAR."_2023"
    WHERE "type" = 'PullRequestEvent'
      AND TRY_PARSE_JSON("payload"):action::STRING = 'opened'
      AND TO_DATE(TO_TIMESTAMP("created_at" / 1e6)) = '2023-01-18'
) AS e
JOIN (
    SELECT DISTINCT l."repo_name"
    FROM GITHUB_REPOS_DATE.GITHUB_REPOS.LANGUAGES  AS l,
         LATERAL FLATTEN(input => l."language")    AS f
    WHERE LOWER(f.value::STRING) = 'javascript'
) AS j
ON e."repo_name" = j."repo_name"
LIMIT 20;
```

```sql
-- Description: Group by repository to check how many PRs each JavaScript repo opened that day.
SELECT 
    j."repo_name",
    COUNT(*) AS "pr_opened_on_2023_01_18"
FROM (
    SELECT
        TRY_PARSE_JSON("repo"):name::STRING      AS "repo_name"
    FROM GITHUB_REPOS_DATE.YEAR."_2023"
    WHERE "type" = 'PullRequestEvent'
      AND TRY_PARSE_JSON("payload"):action::STRING = 'opened'
      AND TO_DATE(TO_TIMESTAMP("created_at" / 1e6)) = '2023-01-18'
) AS e
JOIN (
    SELECT DISTINCT l."repo_name"
    FROM GITHUB_REPOS_DATE.GITHUB_REPOS.LANGUAGES  AS l,
         LATERAL FLATTEN(input => l."language")    AS f
    WHERE LOWER(f.value::STRING) = 'javascript'
) AS j
ON e."repo_name" = j."repo_name"
GROUP BY j."repo_name"
ORDER BY "pr_opened_on_2023_01_18" DESC
LIMIT 20;
```

