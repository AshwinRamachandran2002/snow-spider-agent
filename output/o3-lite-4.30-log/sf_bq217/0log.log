Query:
-- Description (Fix for SQL #5):
--   Retrieve pull‑request “opened” events that occurred on 18‑Jan‑2023.
--   1) Parse the TEXT "payload" to VARIANT with PARSE_JSON so we can access :action.
--   2) Extract :action and compare to 'opened'.
--   3) "created_at" is stored in micro‑seconds‑since‑epoch, therefore divide by 1_000_000
--      before converting with TO_TIMESTAMP_NTZ; then reduce to DATE for filtering.
SELECT
       t."repo":name::STRING                    AS "repo_name",
       (PARSE_JSON(t."payload"):action)::STRING AS "action",
       TO_TIMESTAMP_NTZ(t."created_at" / 1000000)  AS "event_ts"
FROM   "GITHUB_REPOS_DATE"."YEAR"."_2023" t
WHERE  t."type" = 'PullRequestEvent'
  AND  (PARSE_JSON(t."payload"):action)::STRING = 'opened'
  AND  TO_DATE(TO_TIMESTAMP_NTZ(t."created_at" / 1000000)) = '2023-01-18'
LIMIT 20
