```

```sql
-- 5. Description:  Earliest install (first_open) timestamp per user in Aug‑Sep 2018.
SELECT user_pseudo_id,
       MIN(event_timestamp) AS first_open_ts
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
  AND event_name = 'first_open'
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
-- 6. Description:  Earliest uninstall (app_remove) timestamp per user in Aug‑Sep 2018.
SELECT user_pseudo_id,
       MIN(event_timestamp) AS uninstall_ts
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
  AND event_name = 'app_remove'
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
-- 7. Description:  Combine install & uninstall info to see the interval (µs) between them.
WITH installs AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS first_open_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
),
uninstalls AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS uninstall_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
)
SELECT i.user_pseudo_id,
       i.first_open_ts,
       u.uninstall_ts,
       (u.uninstall_ts - i.first_open_ts) AS microseconds_between
FROM installs i
LEFT JOIN uninstalls u
ON i.user_pseudo_id = u.user_pseudo_id
LIMIT 20;
```

```sql
-- 8. Description:  Flag users who either never uninstalled OR uninstalled after 7 days.
WITH installs AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS first_open_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
),
uninstalls AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS uninstall_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
)
SELECT i.user_pseudo_id,
       CASE
         WHEN u.uninstall_ts IS NULL THEN 'never_uninstalled'
         WHEN u.uninstall_ts - i.first_open_ts > 7*24*60*60*1e6 THEN 'after_7_days'
         ELSE 'within_7_days'
       END AS uninstall_status
FROM installs i
LEFT JOIN uninstalls u
ON i.user_pseudo_id = u.user_pseudo_id
LIMIT 20;
```

```sql
-- 9. Description:  Count users per uninstall_status.
WITH installs AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS first_open_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
),
uninstalls AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS uninstall_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
),
flags AS (
  SELECT i.user_pseudo_id,
         CASE
           WHEN u.uninstall_ts IS NULL THEN 'never_uninstalled'
           WHEN u.uninstall_ts - i.first_open_ts > 7*24*60*60*1e6 THEN 'after_7_days'
           ELSE 'within_7_days'
         END AS uninstall_status
  FROM installs i
  LEFT JOIN uninstalls u
  ON i.user_pseudo_id = u.user_pseudo_id
)
SELECT uninstall_status,
       COUNT(*) AS users
FROM flags
GROUP BY uninstall_status
LIMIT 20;
```

```sql
--10. Description:  Final query – percentage of users who
--                  (a) never uninstalled OR (b) uninstalled after 7 days.
WITH installs AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS first_open_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
),
uninstalls AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS uninstall_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
),
flags AS (
  SELECT i.user_pseudo_id,
         CASE
           WHEN u.uninstall_ts IS NULL THEN 1                                        -- kept
           WHEN u.uninstall_ts - i.first_open_ts > 7*24*60*60*1e6 THEN 1            -- kept
           ELSE 0                                                                   -- churned in ≤7 days
         END AS kept_flag
  FROM installs i
  LEFT JOIN uninstalls u
  ON i.user_pseudo_id = u.user_pseudo_id
)
SELECT
  SUM(kept_flag)  AS kept_users,
  COUNT(*)        AS total_users,
  ROUND(100 * SUM(kept_flag) / COUNT(*), 2) AS pct_kept_or_late_uninstall
FROM flags
LIMIT 20;
```

The last query (`pct_kept_or_late_uninstall`) returns the requested percentage.
