The table structure information is (table names): 
['actor', 'country', 'city', 'address', 'language', 'category', 'customer', 'film', 'film_actor', 'film_category', 'film_text', 'inventory', 'staff', 'store', 'payment', 'rental']
Begin Exploring Related Columns
Relevant columns and their potential usage  
rental.rental_date: determine when the rental started (needed to calculate hours)  
rental.return_date: determine when the rental ended (needed to calculate hours)  
rental.customer_id: connect a rental to the customer who made it  
customer.address_id: connect a customer to his / her physical address  
address.city_id: connect an address to the city in which it is located  
city.city: the city name to be filtered (name starts with 'A' or contains '-')  
inventory.inventory_id: connect a rental to the physical copy that was rented  
inventory.film_id: connect a rental (through inventory) to the rented film  
film_category.film_id: connect a film to its category  
film_category.category_id: connect a film to the category id  
category.category_id: connect to the category’s descriptive name  
category.name: the category name we finally want to pick  
Conditions that will be needed  
city.city LIKE 'A%' OR city.city LIKE '%-%'        -- city starts with A or has a hyphen  
rental.return_date IS NOT NULL                      -- make sure the rental was returned  
(julianday(rental.return_date)-julianday(rental.rental_date))*24  -- rental hours  

Ten exploratory‑to‑final SQL statements  
(sqlite syntax, each limited to 20 rows)

```sql
--Description: 1) Look at a few cities whose names either start with 'A' or contain a hyphen
SELECT DISTINCT "city_id",
       "city"
FROM   "city"
WHERE  "city" LIKE 'A%' OR "city" LIKE '%-%'
LIMIT  20;
```

```sql
--Description: 2) Inspect some customers who live in the above cities
SELECT DISTINCT cu."customer_id",
       cu."first_name",
       cu."last_name",
       ci."city"
FROM   "customer"          AS cu
JOIN   "address"           AS ad  ON cu."address_id" = ad."address_id"
JOIN   "city"              AS ci  ON ad."city_id"    = ci."city_id"
WHERE  ci."city" LIKE 'A%' OR ci."city" LIKE '%-%'
LIMIT  20;
```

```sql
--Description: 3) Sample rentals made by customers in the selected cities
SELECT DISTINCT r."rental_id",
       r."rental_date",
       r."return_date",
       ci."city"
FROM   "rental"            AS r
JOIN   "customer"          AS cu  ON r."customer_id" = cu."customer_id"
JOIN   "address"           AS ad  ON cu."address_id" = ad."address_id"
JOIN   "city"              AS ci  ON ad."city_id"    = ci."city_id"
WHERE  (ci."city" LIKE 'A%' OR ci."city" LIKE '%-%')
LIMIT  20;
```

```sql
--Description: 4) Inspect the inventory (film copies) associated with those rentals
SELECT DISTINCT r."rental_id",
       r."inventory_id",
       i."film_id",
       ci."city"
FROM   "rental"    AS r
JOIN   "inventory" AS i  ON r."inventory_id" = i."inventory_id"
JOIN   "customer"  AS cu ON r."customer_id"  = cu."customer_id"
JOIN   "address"   AS ad ON cu."address_id"  = ad."address_id"
JOIN   "city"      AS ci ON ad."city_id"     = ci."city_id"
WHERE  (ci."city" LIKE 'A%' OR ci."city" LIKE '%-%')
LIMIT  20;
```

```sql
--Description: 5) Map those films to their categories
SELECT DISTINCT i."film_id",
       fc."category_id",
       c."name"      AS "category_name"
FROM   "inventory"      AS i
JOIN   "film_category"  AS fc ON i."film_id"   = fc."film_id"
JOIN   "category"       AS c  ON fc."category_id" = c."category_id"
LIMIT  20;
```

```sql
--Description: 6) Compute the rental hours for each qualifying rental
SELECT r."rental_id",
       ROUND( (julianday(r."return_date") - julianday(r."rental_date")) * 24 , 2) AS "rental_hours"
FROM   "rental" AS r
WHERE  r."return_date" IS NOT NULL
LIMIT  20;
```

```sql
--Description: 7) Combine rentals, customers and cities; show rental hours in qualifying cities
SELECT r."rental_id",
       ci."city",
       ROUND( (julianday(r."return_date") - julianday(r."rental_date")) * 24 , 2) AS "rental_hours"
FROM   "rental"   AS r
JOIN   "customer" AS cu ON r."customer_id" = cu."customer_id"
JOIN   "address"  AS ad ON cu."address_id" = ad."address_id"
JOIN   "city"     AS ci ON ad."city_id"    = ci."city_id"
WHERE  (ci."city" LIKE 'A%' OR ci."city" LIKE '%-%')
  AND  r."return_date" IS NOT NULL
LIMIT  20;
```

```sql
--Description: 8) Attach category and show hours per category for rentals in the chosen cities
SELECT c."name"                                        AS "category_name",
       ROUND( (julianday(r."return_date") - julianday(r."rental_date")) * 24 , 2) AS "rental_hours"
FROM   "rental"       AS r
JOIN   "inventory"    AS i  ON r."inventory_id" = i."inventory_id"
JOIN   "film_category" AS fc ON i."film_id"      = fc."film_id"
JOIN   "category"      AS c  ON fc."category_id" = c."category_id"
JOIN   "customer"      AS cu ON r."customer_id"  = cu."customer_id"
JOIN   "address"       AS ad ON cu."address_id"  = ad."address_id"
JOIN   "city"          AS ci ON ad."city_id"     = ci."city_id"
WHERE  (ci."city" LIKE 'A%' OR ci."city" LIKE '%-%')
  AND  r."return_date" IS NOT NULL
LIMIT  20;
```

```sql
--Description: 9) Aggregate total rental hours per category (still limited for quick look)
SELECT c."name"                               AS "category_name",
       SUM( (julianday(r."return_date") - julianday(r."rental_date")) * 24 ) AS "total_rental_hours"
FROM   "rental"       AS r
JOIN   "inventory"    AS i  ON r."inventory_id" = i."inventory_id"
JOIN   "film_category" AS fc ON i."film_id"      = fc."film_id"
JOIN   "category"      AS c  ON fc."category_id" = c."category_id"
JOIN   "customer"      AS cu ON r."customer_id"  = cu."customer_id"
JOIN   "address"       AS ad ON cu."address_id"  = ad."address_id"
JOIN   "city"          AS ci ON ad."city_id"     = ci."city_id"
WHERE  (ci."city" LIKE 'A%' OR ci."city" LIKE '%-%')
  AND  r."return_date" IS NOT NULL
GROUP  BY c."name"
ORDER  BY "total_rental_hours" DESC
LIMIT  20;
```

```sql
--Description: 10) FINAL ANSWER – category with the highest total rental hours in cities starting with 'A' or containing a hyphen
SELECT c."name"                               AS "top_category",
       SUM( (julianday(r."return_date") - julianday(r."rental_date")) * 24 ) AS "total_rental_hours"
FROM   "rental"       AS r
JOIN   "inventory"    AS i  ON r."inventory_id" = i."inventory_id"
JOIN   "film_category" AS fc ON i."film_id"      = fc."film_id"
JOIN   "category"      AS c  ON fc."category_id" = c."category_id"
JOIN   "customer"      AS cu ON r."customer_id"  = cu."customer_id"
JOIN   "address"       AS ad ON cu."address_id"  = ad."address_id"
JOIN   "city"          AS ci ON ad."city_id"     = ci."city_id"
WHERE  (ci."city" LIKE 'A%' OR ci."city" LIKE '%-%')
  AND  r."return_date" IS NOT NULL
GROUP  BY c."name"
ORDER  BY "total_rental_hours" DESC
LIMIT  1;
```
