Begin Exploring Related Columns
Relevant columns, their potential usage & possible conditions
-------------------------------------------------------------
city.city_id            : join pivot between "city" and "address"  
city.city               : filter cities that start with 'A' OR contain '-'  
address.city_id         : join "address" → "city"  
customer.address_id     : join "customer" → "address"  
rental.customer_id      : join "rental"  → "customer"  
rental.inventory_id     : join "rental"  → "inventory"  
rental.rental_date      : starting‑time of the rental (for hour calculation)  
rental.return_date      : ending‑time   of the rental (for hour calculation)  
inventory.film_id       : join "inventory" → "film"  
film.film_id            : join "film" → "film_category"  
film_category.category_id : join "film_category" → "category"  
category.name           : final field we need (film category)  
Conditions that will be used  
• city.city LIKE 'A%' OR city.city LIKE '%-%'  
• return_date IS NOT NULL (defensive, to avoid open rentals)  

Ten exploratory → step‑by‑step SQL queries (each LIMITED to 20 rows)
--------------------------------------------------------------------

```sql
-- 1) Inspect cities that either begin with 'A' or contain a hyphen
SELECT DISTINCT city
FROM city
WHERE city LIKE 'A%' OR city LIKE '%-%'
LIMIT 20;
```

```sql
-- 2) List a few film categories
SELECT DISTINCT name
FROM category
LIMIT 20;
```

```sql
-- 3) Map a handful of films to their categories
SELECT f.film_id,
       f.title,
       c.name AS category
FROM film AS f
JOIN film_category AS fc ON f.film_id = fc.film_id
JOIN category       AS c  ON fc.category_id = c.category_id
LIMIT 20;
```

```sql
-- 4) Look at some rentals with their time‑stamps
SELECT rental_id,
       rental_date,
       return_date,
       customer_id,
       inventory_id
FROM rental
LIMIT 20;
```

```sql
-- 5) Join rentals to the customer’s city
SELECT r.rental_id,
       ci.city
FROM rental  AS r
JOIN customer AS cu ON r.customer_id = cu.customer_id
JOIN address  AS ad ON cu.address_id = ad.address_id
JOIN city     AS ci ON ad.city_id    = ci.city_id
LIMIT 20;
```

```sql
-- 6) Show rental hours (difference between return & rental) for the target cities
SELECT r.rental_id,
       ci.city,
       ROUND( (julianday(r.return_date) - julianday(r.rental_date))*24 , 2) AS rental_hours
FROM rental  AS r
JOIN customer AS cu ON r.customer_id = cu.customer_id
JOIN address  AS ad ON cu.address_id = ad.address_id
JOIN city     AS ci ON ad.city_id    = ci.city_id
WHERE (ci.city LIKE 'A%' OR ci.city LIKE '%-%')
  AND r.return_date IS NOT NULL
LIMIT 20;
```

```sql
-- 7) Aggregate rental hours per film (target cities only)
SELECT i.film_id,
       ROUND(SUM( (julianday(r.return_date) - julianday(r.rental_date))*24 ), 2) AS total_hours
FROM rental    AS r
JOIN inventory AS i  ON r.inventory_id = i.inventory_id
JOIN customer  AS cu ON r.customer_id  = cu.customer_id
JOIN address   AS ad ON cu.address_id  = ad.address_id
JOIN city      AS ci ON ad.city_id     = ci.city_id
WHERE (ci.city LIKE 'A%' OR ci.city LIKE '%-%')
  AND r.return_date IS NOT NULL
GROUP BY i.film_id
LIMIT 20;
```

```sql
-- 8) Aggregate rental hours per category (all cities, no filter yet)
SELECT c.name AS category,
       ROUND(SUM( (julianday(r.return_date) - julianday(r.rental_date))*24 ), 2) AS total_hours
FROM rental       AS r
JOIN inventory    AS i  ON r.inventory_id = i.inventory_id
JOIN film         AS f  ON i.film_id      = f.film_id
JOIN film_category AS fc ON f.film_id     = fc.film_id
JOIN category      AS c  ON fc.category_id= c.category_id
WHERE r.return_date IS NOT NULL
GROUP BY c.name
ORDER BY total_hours DESC
LIMIT 20;
```

```sql
-- 9) Aggregate rental hours per category BUT keep only the target cities
SELECT c.name AS category,
       ROUND(SUM( (julianday(r.return_date) - julianday(r.rental_date))*24 ), 2) AS total_hours
FROM rental        AS r
JOIN inventory     AS i  ON r.inventory_id  = i.inventory_id
JOIN film          AS f  ON i.film_id       = f.film_id
JOIN film_category AS fc ON f.film_id       = fc.film_id
JOIN category      AS c  ON fc.category_id  = c.category_id
JOIN customer      AS cu ON r.customer_id   = cu.customer_id
JOIN address       AS ad ON cu.address_id   = ad.address_id
JOIN city          AS ci ON ad.city_id      = ci.city_id
WHERE (ci.city LIKE 'A%' OR ci.city LIKE '%-%')
  AND r.return_date IS NOT NULL
GROUP BY c.name
ORDER BY total_hours DESC
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: film category with the highest total rental hours in
--     cities whose name starts with 'A' or contains a hyphen
SELECT c.name AS category_with_max_hours,
       ROUND(SUM( (julianday(r.return_date) - julianday(r.rental_date))*24 ), 2) AS total_rental_hours
FROM rental        AS r
JOIN inventory     AS i  ON r.inventory_id  = i.inventory_id
JOIN film          AS f  ON i.film_id       = f.film_id
JOIN film_category AS fc ON f.film_id       = fc.film_id
JOIN category      AS c  ON fc.category_id  = c.category_id
JOIN customer      AS cu ON r.customer_id   = cu.customer_id
JOIN address       AS ad ON cu.address_id   = ad.address_id
JOIN city          AS ci ON ad.city_id      = ci.city_id
WHERE (ci.city LIKE 'A%' OR ci.city LIKE '%-%')
  AND r.return_date IS NOT NULL
GROUP BY c.name
ORDER BY total_rental_hours DESC
LIMIT 20;
```
This last query will return the single category (or the top few if ties) that has accumulated the greatest number of rental hours for customers living in cities beginning with “A” or containing a hyphen.
