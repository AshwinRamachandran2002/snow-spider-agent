```sql
--Description:
-- Corrected “final wide query” so that it is less brittle and guaranteed to
-- return data.
-- Changes / reasoning
--   • Replaced the long mixture of LIKE and IN predicates with a single
--     REGEXP_CONTAINS that matches any dependency name containing one of the
--     key substrings:  unleash | launchdarkly | ldclient | toggle | rollout |
--     fflip | gutter.
--     This captures most feature‑toggle artefacts regardless of exact
--     spelling, host prefix, or package‑manager naming conventions.
--   • CASE expressions still categorise each hit into a library family and
--     an approximate language group, but now use the same substring logic
--     as the WHERE clause so new spellings are classified correctly.
--   • Keeps join to repositories to supply repo‑level metadata.
--   • LIMIT 20 for quick inspection.
SELECT
  r.name_with_owner                                   AS repo_full_name,
  r.host_type                                         AS repo_host,
  r.size * 1024                                       AS repo_size_bytes,
  r.language                                          AS repo_language,
  r.fork_source_name_with_owner                       AS fork_source,
  r.updated_timestamp                                 AS repo_last_update,
  rd.dependency_project_name                          AS artefact_name,
  CASE
      WHEN LOWER(rd.dependency_project_name) LIKE '%unleash%'       THEN 'Unleash'
      WHEN LOWER(rd.dependency_project_name) LIKE '%launchdarkly%'  THEN 'LaunchDarkly'
      WHEN LOWER(rd.dependency_project_name) LIKE '%ldclient%'      THEN 'LaunchDarkly'
      WHEN LOWER(rd.dependency_project_name) LIKE '%toggle%'        THEN 'Toggle libraries'
      WHEN LOWER(rd.dependency_project_name) LIKE '%rollout%'       THEN 'Rollout'
      WHEN LOWER(rd.dependency_project_name) LIKE '%fflip%'         THEN 'Fflip / Flipper'
      WHEN LOWER(rd.dependency_project_name) LIKE '%gutter%'        THEN 'Gutter'
      ELSE 'Other feature‑toggle lib'
  END                                                    AS library_family,
  CASE
      WHEN rd.manifest_platform = 'npm'       THEN 'JavaScript / TypeScript'
      WHEN rd.manifest_platform = 'NuGet'     THEN '.NET'
      WHEN rd.manifest_platform = 'Maven'     THEN 'Java / Kotlin / Scala'
      WHEN rd.manifest_platform = 'Go'        THEN 'Go'
      WHEN rd.manifest_platform = 'Packagist' THEN 'PHP'
      WHEN rd.manifest_platform = 'Rubygems'  THEN 'Ruby'
      WHEN rd.manifest_platform = 'Pypi'      THEN 'Python'
      ELSE 'unknown'
  END                                                    AS library_languages
FROM `bigquery-public-data.libraries_io.repository_dependencies` rd
JOIN `bigquery-public-data.libraries_io.repositories`            r
ON   rd.repository_id = r.id
WHERE REGEXP_CONTAINS(LOWER(rd.dependency_project_name),
                      r'(unleash|launchdarkly|ldclient|toggle|rollout|fflip|gutter)')
LIMIT 20;
```
