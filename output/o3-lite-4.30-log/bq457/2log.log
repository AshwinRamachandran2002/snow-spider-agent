```sql
-- 1) Distinct dependency names that contain the word “unleash”
SELECT DISTINCT rd.dependency_project_name
FROM   `bigquery-public-data.libraries_io.repository_dependencies` rd
WHERE  LOWER(rd.dependency_project_name) LIKE '%unleash%'
LIMIT  20;
```

```sql
-- 2) Distinct package‑manager platforms associated with those “unleash” dependencies
SELECT DISTINCT p.platform
FROM   `bigquery-public-data.libraries_io.repository_dependencies` rd
JOIN   `bigquery-public-data.libraries_io.projects` p
       ON p.id = rd.dependency_project_id
WHERE  LOWER(rd.dependency_project_name) LIKE '%unleash%'
LIMIT  20;
```

```sql
-- 3) A sample of GitHub repositories that depend on any LaunchDarkly library
SELECT DISTINCT r.name_with_owner, r.language, r.stars_count
FROM   `bigquery-public-data.libraries_io.repository_dependencies` rd
JOIN   `bigquery-public-data.libraries_io.projects`                p
       ON p.id = rd.dependency_project_id
JOIN   `bigquery-public-data.libraries_io.repositories`            r
       ON r.id = rd.repository_id
WHERE  LOWER(p.name) LIKE '%launchdarkly%'
  AND  r.host_type = 'GitHub'
LIMIT  20;
```

```sql
-- 4) Count of repositories per host that use “Togglz”
SELECT r.host_type, COUNT(DISTINCT r.id) AS repo_cnt
FROM   `bigquery-public-data.libraries_io.repository_dependencies` rd
JOIN   `bigquery-public-data.libraries_io.projects`                p
       ON p.id = rd.dependency_project_id
JOIN   `bigquery-public-data.libraries_io.repositories`            r
       ON r.id = rd.repository_id
WHERE  p.name = 'org.togglz:togglz-core'
GROUP  BY r.host_type
LIMIT  20;
```

```sql
-- 5) Languages of repositories that use the npm package “ember-feature-flags”
SELECT r.language, COUNT(*) AS repos
FROM   `bigquery-public-data.libraries_io.repository_dependencies` rd
JOIN   `bigquery-public-data.libraries_io.repositories`            r
       ON r.id = rd.repository_id
WHERE  rd.dependency_project_name = 'ember-feature-flags'
GROUP  BY r.language
ORDER  BY repos DESC
LIMIT  20;
```

```sql
-- 6) Top 20 starred repositories that depend on “flipper” Ruby gem
SELECT r.name_with_owner,
       r.stars_count
FROM   `bigquery-public-data.libraries_io.repository_dependencies` rd
JOIN   `bigquery-public-data.libraries_io.repositories`            r
       ON r.id = rd.repository_id
WHERE  rd.dependency_project_name = 'flipper'
ORDER  BY r.stars_count DESC
LIMIT  20;
```

```sql
-- 7) Example of Maven coordinates stored literally in dependency_project_name
SELECT DISTINCT rd.dependency_project_name
FROM   `bigquery-public-data.libraries_io.repository_dependencies` rd
WHERE  rd.dependency_project_name LIKE 'no.finn.unleash:%'
LIMIT  20;
```

```sql
-- 8) Fork relationships of repos using “django‑waffle”
SELECT r.name_with_owner,
       r.fork_source_name_with_owner AS forked_from
FROM   `bigquery-public-data.libraries_io.repository_dependencies` rd
JOIN   `bigquery-public-data.libraries_io.repositories`            r
       ON r.id = rd.repository_id
WHERE  rd.dependency_project_name = 'django-waffle'
LIMIT  20;
```

```sql
-- 9) Size distribution (in MiB) of repos that depend on “ff4j-core”
SELECT APPROX_QUANTILES(r.size / 1024.0, 5) AS size_mib_quintiles
FROM   `bigquery-public-data.libraries_io.repository_dependencies` rd
JOIN   `bigquery-public-data.libraries_io.repositories`            r
       ON r.id = rd.repository_id
WHERE  rd.dependency_project_name = 'org.ff4j:ff4j-core'
LIMIT  20;
```

```sql
-- 10) Final result prototype: repositories and the toggle library they use
SELECT
       r.name_with_owner                                          AS repo_full_name,
       r.host_type                                                AS repo_host,
       r.size * 1024                                              AS repo_size_bytes,
