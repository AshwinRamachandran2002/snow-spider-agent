Query:
-- 9) Description: Bring the library metadata into the same result – we now
--    know the repo, the package it uses, the package manager and the package
--    language.
SELECT r.name_with_owner,
       r.host_type,
       (r.size * 1024)                         AS size_bytes,
       r.language                              AS repo_language,
       r.fork_source_name_with_owner,
       r.updated_timestamp,
       rd.dependency_project_name              AS library_artifact,
       p.name                                  AS library_name,
       p.platform                              AS library_platform,
       p.language                              AS library_language
FROM   `bigquery-public-data.libraries_io.repository_dependencies` rd
JOIN   `bigquery-public-data.libraries_io.repositories` r
       ON r.id = rd.repository_id
JOIN   `bigquery-public-data.libraries_io.projects`     p
       ON p.id = rd.dependency_project_id
WHERE  LOWER(rd.dependency_project_name) IN (
        'unleash',
        'ldclient-js', 'ldclient-node', 'ldclient-rb',
        'flipper', 'toggle', 'featuretoggle',
        'fflip', 'feature_toggles', 'ember-feature-flags',
        'django-waffle', 'gargoyle', 'bandiera-client')
LIMIT  20;
