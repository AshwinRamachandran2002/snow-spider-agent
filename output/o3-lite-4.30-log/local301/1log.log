Begin Exploring Related Columns
Relevant tables, columns and how they will be used  
• cleaned_weekly_sales.week_date      : ISO‐like date of each Monday – lets us isolate weeks before/after 15 June  
• cleaned_weekly_sales.week_number    : Calendar week index – handy for “four weeks before / after” logic  
• cleaned_weekly_sales.month_number   : Lets us quickly focus on June (6)  
• cleaned_weekly_sales.calendar_year  : Separate the three years requested (2018‑2020)  
• cleaned_weekly_sales.sales          : Metric that must be summed and later compared  
Conditions that will probably be used  
• calendar_year IN (2018,2019,2020)  
• month_number = 6                    (to locate the mid‑June anchor week)  
• week_number BETWEEN anchor‑4 AND anchor‑1   → “four weeks leading up to 15 June”  
• week_number BETWEEN anchor+1 AND anchor+4   → “four weeks following 15 June”  

Below are ten exploratory SQL queries (all limited to 20 rows) that go from simple inspection to a complete percentage‑change calculation.

```sql
-- 1) Distinct calendar years available in the cleaned weekly sales data
SELECT DISTINCT calendar_year
FROM cleaned_weekly_sales
ORDER BY calendar_year
LIMIT 20;
```

```sql
-- 2) For each of the years of interest, list the distinct week numbers that fall in June
SELECT DISTINCT calendar_year, week_number
FROM cleaned_weekly_sales
WHERE calendar_year IN (2018,2019,2020)
  AND month_number = 6
ORDER BY calendar_year, week_number
LIMIT 20;
```

```sql
-- 3) Identify the exact “mid‑June” week (the week that contains 15 June) for every year
SELECT calendar_year,
       week_number,
       week_date
FROM cleaned_weekly_sales
WHERE calendar_year IN (2018,2019,2020)
  AND week_date LIKE '%-06-1%'          -- catches dates 10‑19 June
ORDER BY calendar_year, week_date
LIMIT 20;
```

```sql
-- 4) Quick glance at total sales for June (month_number = 6) in each year
SELECT calendar_year,
       SUM(sales) AS june_sales
FROM cleaned_weekly_sales
WHERE calendar_year IN (2018,2019,2020)
  AND month_number = 6
GROUP BY calendar_year
ORDER BY calendar_year
LIMIT 20;
```

```sql
-- 5) Pull all weekly rows from five weeks before to five weeks after the mid‑June week in 2020
WITH jun_anchor AS (
  SELECT week_number
  FROM cleaned_weekly_sales
  WHERE calendar_year = 2020
    AND week_date LIKE '%-06-1%'     -- mid‑June week
  LIMIT 1
)
SELECT cws.week_number,
       cws.week_date,
       cws.sales
FROM cleaned_weekly_sales AS cws,
     jun_anchor
WHERE cws.calendar_year = 2020
  AND cws.week_number BETWEEN jun_anchor.week_number-5 AND jun_anchor.week_number+5
ORDER BY cws.week_number
LIMIT 20;
```

```sql
-- 6) Aggregate the “4‑weeks‑before” and “4‑weeks‑after” sales for each year
WITH anchor AS (
  SELECT calendar_year,
         MIN(week_number) AS wk        -- the first week that contains 15 June
  FROM cleaned_weekly_sales
  WHERE week_date LIKE '%-06-1%'
    AND calendar_year IN (2018,2019,2020)
  GROUP BY calendar_year
)
SELECT c.calendar_year,
       SUM(CASE WHEN c.week_number BETWEEN a.wk-4 AND a.wk-1 THEN c.sales END) AS sales_before,
       SUM(CASE WHEN c.week_number BETWEEN a.wk+1 AND a.wk+4 THEN c.sales END) AS sales_after
FROM cleaned_weekly_sales AS c
JOIN anchor AS a
  ON c.calendar_year = a.calendar_year
WHERE c.week_number BETWEEN a.wk-4 AND a.wk+4
GROUP BY c.calendar_year
ORDER BY c.calendar_year
LIMIT 20;
```

```sql
-- 7) Compute percentage change using the sums produced above
WITH anchor AS (
  SELECT calendar_year,
         MIN(week_number) AS wk
  FROM cleaned_weekly_sales
  WHERE week_date LIKE '%-06-1%'
    AND calendar_year IN (2018,2019,2020)
  GROUP BY calendar_year
),
sums AS (
  SELECT c.calendar_year,
         SUM(CASE WHEN c.week_number BETWEEN a.wk-4 AND a.wk-1 THEN c.sales END) AS sales_before,
         SUM(CASE WHEN c.week_number BETWEEN a.wk+1 AND a.wk+4 THEN c.sales END) AS sales_after
  FROM cleaned_weekly_sales AS c
  JOIN anchor AS a
    ON c.calendar_year = a.calendar_year
  WHERE c.week_number BETWEEN a.wk-4 AND a.wk+4
  GROUP BY c.calendar_year
)
SELECT calendar_year,
       sales_before,
       sales_after,
       ROUND( (sales_after - sales_before)*100.0 / sales_before , 2) AS pct_change
FROM sums
ORDER BY calendar_year
LIMIT 20;
```

```sql
-- 8) Same as (7) but showing underlying weekly numbers for 2019 only
WITH anchor AS (
  SELECT MIN(week_number) AS wk
  FROM cleaned_weekly_sales
  WHERE week_date LIKE '%-06-1%'
    AND calendar_year = 2019
),
wks AS (
  SELECT c.week_number,
         c.week_date,
         c.sales,
         CASE
           WHEN c.week_number BETWEEN a.wk-4 AND a.wk-1 THEN 'Before'
           WHEN c.week_number = a.wk                         THEN 'Anchor'
           WHEN c.week_number BETWEEN a.wk+1 AND a.wk+4 THEN 'After'
         END AS period
  FROM cleaned_weekly_sales AS c, anchor AS a
  WHERE c.calendar_year = 2019
    AND c.week_number BETWEEN a.wk-4 AND a.wk+4
)
SELECT *
FROM wks
ORDER BY week_number
LIMIT 20;
```

```sql
-- 9) Check that every anchor week actually contains the date 15 June (sanity)
SELECT calendar_year,
       week_date
FROM cleaned_weekly_sales
WHERE calendar_year IN (2018,2019,2020)
  AND week_date LIKE '%-06-15'
LIMIT 20;
```

```sql
-- 10) Final concise result: percentage change in sales around 15 June for 2018‑2020
WITH anchor AS (
  SELECT calendar_year,
         MIN(week_number) AS wk
  FROM cleaned_weekly_sales
  WHERE week_date LIKE '%-06-1%'      -- identifies week of 10‑19 June
    AND calendar_year BETWEEN 2018 AND 2020
  GROUP BY calendar_year
),
sums AS (
  SELECT c.calendar_year,
         SUM(CASE WHEN c.week_number BETWEEN a.wk-4 AND a.wk-1 THEN c.sales END) AS sales_before,
         SUM(CASE WHEN c.week_number BETWEEN a.wk+1 AND a.wk+4 THEN c.sales END) AS sales_after
  FROM cleaned_weekly_sales AS c
  JOIN anchor AS a
    ON c.calendar_year = a.calendar_year
  WHERE c.week_number BETWEEN a.wk-4 AND a.wk+4
  GROUP BY c.calendar_year
)
SELECT calendar_year,
       sales_before,
       sales_after,
       ROUND( (sales_after - sales_before)*100.0 / sales_before , 2) AS pct_change
FROM sums
ORDER BY calendar_year
LIMIT 20;
```

Each successive query builds understanding from basic structure checks to the final computation of the requested percentage‑change metric.
