```sql
--Description: 
-- Determine, for each of the inventory years 2015‑2017, the state that has
-- (a) the largest average SUBPLOT area and (b) the largest average MACROPLOT
--     area, limited to live‑forest conditions (condition_status_code = 1) and
--     “current expansion” population records (evaluation_type = 'EXPCURR').
-- Logic
--   1. Join condition → population on plot_sequence_number and inventory_year.
--   2. For SUBP records:  area = expansion_factor * condition_proportion_unadjusted * adj_factor_subplot.
--      For MACR records:  area = expansion_factor * condition_proportion_unadjusted * adj_factor_macroplot.
--   3. Average those areas by state & year, rank each state within a year,
--      and keep the top one for each plot type (SUBP or MACR).
--   4. UNION the winners from both plot types and list them chronologically.
WITH
-- average subplot area by state/year
sub_avg AS (
  SELECT
    c.inventory_year AS yr,
    c.state_code     AS st,
    AVG(p.expansion_factor *
        c.condition_proportion_unadjusted *
        p.adjustment_factor_for_the_subplot) AS avg_area
  FROM `bigquery-public-data.usfs_fia.condition`  AS c
  JOIN `bigquery-public-data.usfs_fia.population` AS p
    ON p.plot_sequence_number = c.plot_sequence_number
   AND p.inventory_year      = c.inventory_year
  WHERE c.condition_status_code = 1
    AND p.evaluation_type      = 'EXPCURR'
    AND c.proportion_basis     = 'SUBP'
    AND c.inventory_year BETWEEN 2015 AND 2017
  GROUP BY yr, st
),
-- average macroplot area by state/year
macr_avg AS (
  SELECT
    c.inventory_year AS yr,
    c.state_code     AS st,
    AVG(p.expansion_factor *
        c.condition_proportion_unadjusted *
        p.adjustment_factor_for_the_macroplot) AS avg_area
  FROM `bigquery-public-data.usfs_fia.condition`  AS c
  JOIN `bigquery-public-data.usfs_fia.population` AS p
    ON p.plot_sequence_number = c.plot_sequence_number
   AND p.inventory_year      = c.inventory_year
  WHERE c.condition_status_code = 1
    AND p.evaluation_type      = 'EXPCURR'
    AND c.proportion_basis     = 'MACR'
    AND c.inventory_year BETWEEN 2015 AND 2017
  GROUP BY yr, st
),
-- pick the max‑average state for each year (subplot)
sub_winner AS (
  SELECT 'Subplot' AS plot_type, yr, st, avg_area
  FROM (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY yr ORDER BY avg_area DESC) AS rk
    FROM sub_avg )
  WHERE rk = 1
),
-- pick the max‑average state for each year (macroplot)
macr_winner AS (
  SELECT 'Macroplot' AS plot_type, yr, st, avg_area
  FROM (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY yr ORDER BY avg_area DESC) AS rk
    FROM macr_avg )
  WHERE rk = 1
)
-- final combined list
SELECT plot_type,
       yr  AS year,
       st  AS state_code,
       avg_area
FROM (SELECT * FROM sub_winner
      UNION ALL
      SELECT * FROM macr_winner)
ORDER BY year, plot_type;
```
