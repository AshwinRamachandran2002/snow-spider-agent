```sql
--Description: 
-- Query 9 – for SUBPLOTs, rank states by average area within each year and
-- keep the largest one (live forest, EXPCURR, 2015‑2017).
WITH sub AS (
  SELECT
    c.inventory_year AS yr,
    c.state_code     AS st,
    AVG(p.expansion_factor * c.condition_proportion_unadjusted *
        p.adjustment_factor_for_the_subplot) AS avg_area
  FROM `bigquery-public-data.usfs_fia.condition`  AS c
  JOIN `bigquery-public-data.usfs_fia.population` AS p
    ON p.plot_sequence_number = c.plot_sequence_number
   AND p.inventory_year       = c.inventory_year
  WHERE c.condition_status_code = 1
    AND p.evaluation_type       = 'EXPCURR'
    AND c.proportion_basis      = 'SUBP'
    AND c.inventory_year BETWEEN 2015 AND 2017
  GROUP BY yr, st
)
SELECT
  'Subplot'  AS plot_type,
  yr         AS year,
  st         AS state_code,
  avg_area
FROM (
  SELECT sub.*,
         ROW_NUMBER() OVER (PARTITION BY yr ORDER BY avg_area DESC) AS rn
  FROM sub
)
WHERE rn = 1
ORDER BY year;
```

```sql
--Description: 
-- Query 10 – FINAL: combine winners for both SUBPLOT and MACROPLOT types, i.e.,
-- the state with the largest average area for each plot type in 2015‑2017.
WITH
-- Step 1: compute avg subplot area by state/year
sub_base AS (
  SELECT
    c.inventory_year AS yr,
    c.state_code     AS st,
    AVG(p.expansion_factor * c.condition_proportion_unadjusted *
        p.adjustment_factor_for_the_subplot) AS avg_area
  FROM `bigquery-public-data.usfs_fia.condition`  AS c
  JOIN `bigquery-public-data.usfs_fia.population` AS p
    ON p.plot_sequence_number = c.plot_sequence_number
   AND p.inventory_year       = c.inventory_year
  WHERE c.condition_status_code = 1
    AND p.evaluation_type       = 'EXPCURR'
    AND c.proportion_basis      = 'SUBP'
    AND c.inventory_year BETWEEN 2015 AND 2017
  GROUP BY yr, st
),
sub_winner AS (
  SELECT 'Subplot' AS plot_type, yr, st, avg_area
  FROM (
    SELECT sub_base.*,
           ROW_NUMBER() OVER (PARTITION BY yr ORDER BY avg_area DESC) AS rk
    FROM sub_base
  )
  WHERE rk = 1
),
-- Step 2: compute avg macroplot area by state/year
macr_base AS (
  SELECT
    c.inventory_year AS yr,
    c.state_code     AS st,
    AVG(p.expansion_factor * c.condition_proportion_unadjusted *
        p.adjustment_factor_for_the_macroplot) AS avg_area
  FROM `bigquery-public-data.usfs_fia.condition`  AS c
  JOIN `bigquery-public-data.usfs_fia.population` AS p
    ON p.plot_sequence_number = c.plot_sequence_number
   AND p.inventory_year       = c.inventory_year
  WHERE c.condition_status_code = 1
    AND p.evaluation_type       = 'EXPCURR'
    AND c.proportion_basis      = 'MACR'
    AND c.inventory_year BETWEEN 2015 AND 2017
  GROUP BY yr, st
),
macr_winner AS (
  SELECT 'Macroplot' AS plot_type, yr, st, avg_area
  FROM (
    SELECT macr_base.*,
           ROW_NUMBER() OVER (PARTITION BY yr ORDER BY avg_area DESC) AS rk
    FROM macr_base
  )
  WHERE rk = 1
)
SELECT
  plot_type,
  yr  AS year,
  st  AS state_code,
  avg_area
FROM sub_winner
UNION ALL
SELECT
  plot_type,
  yr,
  st,
  avg_area
FROM macr_winner
ORDER BY year, plot_type;
