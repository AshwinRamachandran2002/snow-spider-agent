Query:
-- 10. FINAL ANSWER: states with the largest average subplot size 
--     and largest average macroplot size for 2015‑2017.
WITH subplot AS (
  SELECT 'SUBPLOT' AS plot_type,
         pop.inventory_year,
         pop.state_code,
         AVG(pop.expansion_factor *
             cond.condition_proportion_unadjusted *
             pop.adjustment_factor_for_the_subplot) AS avg_size,
         ROW_NUMBER() OVER (PARTITION BY pop.inventory_year
                            ORDER BY AVG(pop.expansion_factor *
                                         cond.condition_proportion_unadjusted *
                                         pop.adjustment_factor_for_the_subplot) DESC) AS rn
  FROM `bigquery-public-data.usfs_fia.population`  AS pop
  JOIN `bigquery-public-data.usfs_fia.condition`    AS cond
    ON pop.plot_sequence_number = cond.plot_sequence_number
   AND pop.inventory_year       = cond.inventory_year
  WHERE pop.evaluation_type      = 'EXPCURR'
    AND cond.condition_status_code = 1
    AND cond.proportion_basis      = 'SUBP'
    AND pop.adjustment_factor_for_the_subplot > 0
    AND pop.inventory_year IN (2015, 2016, 2017)
  GROUP BY pop.inventory_year, pop.state_code
),
macroplot AS (
  SELECT 'MACROPLOT' AS plot_type,
         pop.inventory_year,
         pop.state_code,
         AVG(pop.expansion_factor *
             cond.condition_proportion_unadjusted *
             pop.adjustment_factor_for_the_macroplot) AS avg_size,
         ROW_NUMBER() OVER (PARTITION BY pop.inventory_year
                            ORDER BY AVG(pop.expansion_factor *
                                         cond.condition_proportion_unadjusted *
                                         pop.adjustment_factor_for_the_macroplot) DESC) AS rn
  FROM `bigquery-public-data.usfs_fia.population`  AS pop
  JOIN `bigquery-public-data.usfs_fia.condition`    AS cond
    ON pop.plot_sequence_number = cond.plot_sequence_number
   AND pop.inventory_year       = cond.inventory_year
  WHERE pop.evaluation_type      = 'EXPCURR'
    AND cond.condition_status_code = 1
    AND cond.proportion_basis      = 'MACR'
    AND pop.adjustment_factor_for_the_macroplot > 0
    AND pop.inventory_year IN (2015, 2016, 2017)
  GROUP BY pop.inventory_year, pop.state_code
)
SELECT plot_type,
       inventory_year,
       state_code,
       avg_size AS average_size
FROM (
  SELECT * FROM subplot WHERE rn = 1
  UNION ALL
  SELECT * FROM macroplot WHERE rn = 1
)
ORDER BY inventory_year, plot_type;
