--Description: Build a 2021 side‑by‑side comparison of race‑ and gender‑share
--percentages for (1) Google overall hiring, (2) Google overall workforce
--representation, (3) the 2021 CPS row whose text hierarchy contains “internet”
--(captures “Internet publishing … web search portals”), and (4) any 2021 CPS
--row whose hierarchy contains “computer systems” (captures “Computer systems
--design and related services”).  Each slice is placed in a CTE (with LIMIT 1
--for the BLS slices) so that the final UNION ALL returns at most one row per
--source and avoids LIMIT‑inside‑UNION syntax errors.

WITH google_hiring AS (
  SELECT 'Google Hiring 2021' AS source,
         race_asian,
         race_black,
         race_hispanic_latinx,
         race_white,
         gender_us_women AS percent_women,
         gender_us_men   AS percent_men
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_hiring`
  WHERE workforce = 'overall' AND report_year = 2021
),

google_representation AS (
  SELECT 'Google Representation 2021' AS source,
         race_asian,
         race_black,
         race_hispanic_latinx,
         race_white,
         gender_us_women AS percent_women,
         gender_us_men   AS percent_men
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall' AND report_year = 2021
),

bls_internet AS (
  SELECT 'BLS Internet‑related 2021' AS source,
         percent_asian                        AS race_asian,
         percent_black_or_african_american    AS race_black,
         percent_hispanic_or_latino           AS race_hispanic_latinx,
         percent_white                        AS race_white,
         percent_women,
         1 - percent_women                    AS percent_men
  FROM `bigquery-public-data.bls.cpsaat18`
  WHERE year = 2021
    AND LOWER(
          CONCAT(
            sector, ' ',
            COALESCE(subsector, ''), ' ',
            COALESCE(industry_group, ''), ' ',
            COALESCE(industry, '')
          )
        ) LIKE '%internet%'
  LIMIT 1
),

bls_compsys AS (
  SELECT 'BLS Computer Systems Design 2021' AS source,
         percent_asian                      AS race_asian,
         percent_black_or_african_american  AS race_black,
         percent_hispanic_or_latino         AS race_hispanic_latinx,
         percent_white                      AS race_white,
         percent_women,
         1 - percent_women                  AS percent_men
  FROM `bigquery-public-data.bls.cpsaat18`
  WHERE year = 2021
    AND LOWER(
          CONCAT(
            sector, ' ',
            COALESCE(subsector, ''), ' ',
            COALESCE(industry_group, ''), ' ',
            COALESCE(industry, '')
          )
        ) LIKE '%computer systems%'
  LIMIT 1
)

SELECT * FROM google_hiring
UNION ALL
SELECT * FROM google_representation
UNION ALL
SELECT * FROM bls_internet
UNION ALL
SELECT * FROM bls_compsys;
