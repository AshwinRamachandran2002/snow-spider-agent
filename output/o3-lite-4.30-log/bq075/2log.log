Query:
--Description: Compare gender shares for two tech‑related industry rows in 2021.
--Because CPS Table 18 may store the key phrases in any hierarchy column,
--search the concatenation of sector / subsector / industry_group / industry
--for “internet” or “computer systems”.  Display the text hierarchy and
--gender percentages so we can see which exact rows are returned.
SELECT
  sector,
  subsector,
  industry_group,
  industry,
  percent_women,
  1 - percent_women AS percent_men
FROM `bigquery-public-data.bls.cpsaat18`
WHERE year = 2021
  AND (
        LOWER(
          CONCAT(
            sector, ' ',
            COALESCE(subsector, ''), ' ',
            COALESCE(industry_group, ''), ' ',
            COALESCE(industry, '')
          )
        ) LIKE '%internet%'
     OR LOWER(
          CONCAT(
            sector, ' ',
            COALESCE(subsector, ''), ' ',
            COALESCE(industry_group, ''), ' ',
            COALESCE(industry, '')
          )
        ) LIKE '%computer systems%'
  )
ORDER BY industry
LIMIT 20
