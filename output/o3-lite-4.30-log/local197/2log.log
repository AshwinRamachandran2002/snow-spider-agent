Begin Exploring Related Columns
Relevant columns, their potential usage, and possible conditions
payment.customer_id : identify each customer’s payments  
payment.amount      : monetary value needed to calculate totals and differences  
payment.payment_date: date‑time used to (a) rank customers by total paid and (b) aggregate by month (e.g., with strftime('%Y‑%m', …) in SQLite)  

Typical conditions you may need
• amount > 0  – ignore any zero/negative rows (not expected in sample, but safe)  
• payment_date IS NOT NULL – be sure all rows carry a timestamp  
• customer_id IN ( …top‑10 list… ) – restrict computations to the ten biggest spenders  

Below are ten progressive SQLite queries (each capped with LIMIT 20) that move step‑by‑step from exploring the data to answering the question.  
Every query is preceded by a comment line beginning with “--Description:”.

```sql
--Description: 1) Peek at the raw payment table (first 20 rows)
SELECT *
FROM payment
LIMIT 20;
```

```sql
--Description: 2) Show how much each customer has paid in total (top 20 customers)
SELECT customer_id,
       ROUND(SUM(amount), 2) AS total_paid
FROM payment
GROUP BY customer_id
ORDER BY total_paid DESC
LIMIT 20;
```

```sql
--Description: 3) Capture the exact top‑10 paying customers (with a CTE) and list them
WITH top10 AS (
    SELECT customer_id
    FROM payment
    GROUP BY customer_id
    ORDER BY SUM(amount) DESC
    LIMIT 10
)
SELECT *
FROM top10;
```

```sql
--Description: 4) Aggregate payments by customer and month (top‑10 customers only)
WITH top10 AS (
    SELECT customer_id
    FROM payment
    GROUP BY customer_id
    ORDER BY SUM(amount) DESC
    LIMIT 10
)
SELECT p.customer_id,
       strftime('%Y-%m', p.payment_date) AS yr_month,
       ROUND(SUM(p.amount), 2)           AS month_total
FROM payment AS p
JOIN top10  USING (customer_id)
GROUP BY p.customer_id, yr_month
ORDER BY p.customer_id, yr_month
LIMIT 20;
```

```sql
--Description: 5) For one illustrative customer (replace 1 with any id) show monthly totals in order
SELECT strftime('%Y-%m', payment_date) AS yr_month,
       ROUND(SUM(amount), 2) AS month_total
FROM payment
WHERE customer_id = 1
GROUP BY yr_month
ORDER BY yr_month
LIMIT 20;
```

```sql
--Description: 6) For each top‑10 customer compute month‑over‑month differences
WITH top10 AS (
    SELECT customer_id
    FROM payment
    GROUP BY customer_id
    ORDER BY SUM(amount) DESC
    LIMIT 10
),
monthlies AS (
    SELECT p.customer_id,
           strftime('%Y-%m', p.payment_date) AS yr_month,
           SUM(p.amount) AS month_total
    FROM payment AS p
    JOIN top10 USING (customer_id)
    GROUP BY p.customer_id, yr_month
),
diffs AS (
    SELECT m.customer_id,
           m.yr_month                                              AS curr_month,
           m.month_total                                           AS curr_total,
           LAG(m.month_total) OVER (PARTITION BY m.customer_id
                                    ORDER BY m.yr_month)           AS prev_total,
           ROUND(m.month_total - LAG(m.month_total) OVER (
                     PARTITION BY m.customer_id ORDER BY m.yr_month), 2) AS diff
    FROM monthlies AS m
)
SELECT *
FROM diffs
ORDER BY customer_id, curr_month
LIMIT 20;
```

```sql
--Description: 7) Filter out NULL diffs (first available month) and sort by absolute change
WITH top10 AS (
    SELECT customer_id
    FROM payment
    GROUP BY customer_id
    ORDER BY SUM(amount) DESC
    LIMIT 10
),
monthlies AS (
    SELECT p.customer_id,
           strftime('%Y-%m', p.payment_date) AS yr_month,
           SUM(p.amount) AS month_total
    FROM payment AS p
    JOIN top10 USING (customer_id)
    GROUP BY p.customer_id, yr_month
),
diffs AS (
    SELECT m.customer_id,
           m.yr_month  AS curr_month,
           m.month_total,
           LAG(m.month_total) OVER (PARTITION BY m.customer_id ORDER BY m.yr_month) AS prev_total,
           m.month_total - LAG(m.month_total) OVER (PARTITION BY m.customer_id ORDER BY m.yr_month) AS diff
    FROM monthlies AS m
)
SELECT customer_id,
       curr_month,
       ROUND(diff, 2) AS diff
FROM diffs
WHERE diff IS NOT NULL
ORDER BY ABS(diff) DESC
LIMIT 20;
```

```sql
--Description: 8) Identify the single largest month‑to‑month jump (positive or negative) among top‑10
WITH top10 AS (
    SELECT customer_id
    FROM payment
    GROUP BY customer_id
    ORDER BY SUM(amount) DESC
    LIMIT 10
),
monthlies AS (
    SELECT p.customer_id,
           strftime('%Y-%m', p.payment_date) AS yr_month,
           SUM(p.amount) AS month_total
    FROM payment AS p
    JOIN top10 USING (customer_id)
    GROUP BY p.customer_id, yr_month
),
diffs AS (
    SELECT m.customer_id,
           m.yr_month AS curr_month,
           m.month_total,
           LAG(m.month_total) OVER (PARTITION BY m.customer_id ORDER BY m.yr_month) AS prev_total,
           m.month_total - LAG(m.month_total) OVER (PARTITION BY m.customer_id ORDER BY m.yr_month) AS diff
    FROM monthlies AS m
)
SELECT customer_id,
       curr_month,
       ROUND(diff, 2) AS diff
FROM diffs
WHERE diff IS NOT NULL
ORDER BY ABS(diff) DESC
LIMIT 1;
```

```sql
--Description: 9) Same as #8 but keep only positive differences (biggest uptick)
WITH top10 AS (
    SELECT customer_id
    FROM payment
    GROUP BY customer_id
    ORDER BY SUM(amount) DESC
    LIMIT 10
),
monthlies AS (
    SELECT p.customer_id,
           strftime('%Y-%m', p.payment_date) AS yr_month,
           SUM(p.amount) AS month_total
    FROM payment AS p
    JOIN top10 USING (customer_id)
    GROUP BY p.customer_id, yr_month
),
diffs AS (
    SELECT m.customer_id,
