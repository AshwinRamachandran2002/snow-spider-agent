    SELECT customer_id
    FROM payment
    GROUP BY customer_id
    ORDER BY SUM(amount) DESC
    LIMIT 10
),
monthlies AS (
    SELECT p.customer_id,
           strftime('%Y-%m', p.payment_date) AS yr_month,
           SUM(p.amount) AS month_total
    FROM payment AS p
    JOIN top10 USING (customer_id)
    GROUP BY p.customer_id, yr_month
),
diffs AS (
    SELECT m.customer_id,
           m.yr_month AS curr_month,
           m.month_total -
           LAG(m.month_total) OVER (PARTITION BY m.customer_id ORDER BY m.yr_month) AS diff
    FROM monthlies AS m
)
