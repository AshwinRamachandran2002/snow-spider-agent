           m.month_total - LAG(m.month_total) OVER (PARTITION BY m.customer_id ORDER BY m.yr_month) AS diff
    FROM monthlies AS m
)
SELECT customer_id,
       curr_month,
       ROUND(diff, 2) AS diff
FROM diffs
WHERE diff > 0
ORDER BY diff DESC
LIMIT 1;
```

```sql
--Description: 10) FINAL ANSWER: show customer, month and the largest absolute month‑over‑month change, rounded to 2 decimals
