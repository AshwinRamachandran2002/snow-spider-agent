Below are ten exploratory → progressively complex SQLite queries (LIMIT 20
when rows are shown) that lead up to the final answer.

```sql
-- 1) Show 20 distinct matches that have ball-by-ball data
SELECT DISTINCT b.match_id
FROM ball_by_ball AS b
LIMIT 20;
```

```sql
-- 2) Show 20 distinct striker IDs appearing in ball_by_ball
SELECT DISTINCT b.striker
FROM ball_by_ball AS b
LIMIT 20;
```

```sql
-- 3) Map 20 striker IDs to player names
SELECT DISTINCT p.player_id, p.player_name
FROM player AS p
JOIN ball_by_ball AS b
  ON p.player_id = b.striker
LIMIT 20;
```

```sql
-- 4) Inspect 20 deliveries with their runs_scored values
SELECT b.match_id, b.over_id, b.ball_id,
       b.striker,
       s.runs_scored
FROM ball_by_ball AS b
JOIN batsman_scored AS s
  ON b.match_id   = s.match_id
 AND b.over_id    = s.over_id
 AND b.ball_id    = s.ball_id
 AND b.innings_no = s.innings_no
LIMIT 20;
```

```sql
-- 5) Total runs of every striker in one sample match (e.g., 335987)
SELECT b.match_id,
       b.striker,
       SUM(s.runs_scored) AS total_runs
FROM ball_by_ball AS b
JOIN batsman_scored AS s
  ON b.match_id   = s.match_id
 AND b.over_id    = s.over_id
 AND b.ball_id    = s.ball_id
 AND b.innings_no = s.innings_no
WHERE b.match_id = 335987
GROUP BY b.match_id, b.striker;
```

```sql
-- 6) Same as (5) but return only those strikers who scored > 50 in that match
SELECT b.striker,
       SUM(s.runs_scored) AS total_runs
FROM ball_by_ball AS b
JOIN batsman_scored AS s
  ON b.match_id   = s.match_id
 AND b.over_id    = s.over_id
 AND b.ball_id    = s.ball_id
 AND b.innings_no = s.innings_no
WHERE b.match_id = 335987
GROUP BY b.striker
HAVING SUM(s.runs_scored) > 50;
```

```sql
-- 7) Compute total runs for every striker in every match
SELECT b.match_id,
       b.striker,
       SUM(s.runs_scored) AS total_runs
FROM ball_by_ball AS b
JOIN batsman_scored AS s
  ON b.match_id   = s.match_id
 AND b.over_id    = s.over_id
 AND b.ball_id    = s.ball_id
 AND b.innings_no = s.innings_no
GROUP BY b.match_id, b.striker
LIMIT 20;
```

```sql
-- 8) Keep only those (match, striker) pairs where total runs > 50
SELECT b.match_id,
       b.striker,
       SUM(s.runs_scored) AS total_runs
FROM ball_by_ball AS b
JOIN batsman_scored AS s
  ON b.match_id   = s.match_id
 AND b.over_id    = s.over_id
 AND b.ball_id    = s.ball_id
 AND b.innings_no = s.innings_no
GROUP BY b.match_id, b.striker
HAVING SUM(s.runs_scored) > 50
LIMIT 20;
```

```sql
-- 9) Show striker names with their 50+ scores (first 20 rows)
SELECT p.player_name,
       t.total_runs
FROM (
       SELECT b.striker,
              SUM(s.runs_scored) AS total_runs
       FROM ball_by_ball AS b
       JOIN batsman_scored AS s
         ON b.match_id   = s.match_id
        AND b.over_id    = s.over_id
        AND b.ball_id    = s.ball_id
        AND b.innings_no = s.innings_no
       GROUP BY b.match_id, b.striker
       HAVING SUM(s.runs_scored) > 50
     ) AS t
JOIN player AS p
  ON p.player_id = t.striker
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: average of total runs by strikers who scored > 50 in a single match
SELECT AVG(total_runs) AS average_runs
FROM (
       SELECT b.match_id,
              b.striker,
              SUM(s.runs_scored) AS total_runs
       FROM ball_by_ball AS b
       JOIN batsman_scored AS s
         ON b.match_id   = s.match_id
        AND b.over_id    = s.over_id
        AND b.ball_id    = s.ball_id
        AND b.innings_no = s.innings_no
       GROUP BY b.match_id, b.striker
       HAVING SUM(s.runs_scored) > 50
     );
```
