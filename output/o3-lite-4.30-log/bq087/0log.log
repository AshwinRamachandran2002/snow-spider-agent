LIMIT 20;
```

```sql
-- 3. Pull the 2019 weekly anosmia index for the five NYC counties.
SELECT date, sub_region_2, symptom_anosmia
FROM `bigquery-public-data.covid19_symptom_search.symptom_search_sub_region_2_weekly`
WHERE country_region_code = 'US'
  AND sub_region_1        = 'New York'
  AND sub_region_2 IN ('Bronx County','Queens County','Kings County',
                       'New York County','Richmond County')
  AND DATE(date) BETWEEN '2019-01-01' AND '2019-12-31'
LIMIT 20;
```

```sql
-- 4. Same as #3 but for 2020 to look at the other period.
SELECT date, sub_region_2, symptom_anosmia
FROM `bigquery-public-data.covid19_symptom_search.symptom_search_sub_region_2_weekly`
WHERE country_region_code = 'US'
  AND sub_region_1        = 'New York'
  AND sub_region_2 IN ('Bronx County','Queens County','Kings County',
                       'New York County','Richmond County')
  AND DATE(date) BETWEEN '2020-01-01' AND '2020-12-31'
LIMIT 20;
```

```sql
-- 5. Average weekly anosmia index per county for 2019.
SELECT sub_region_2,
       AVG(CAST(symptom_anosmia AS FLOAT64)) AS avg_anosmia_2019
FROM `bigquery-public-data.covid19_symptom_search.symptom_search_sub_region_2_weekly`
WHERE country_region_code = 'US'
  AND sub_region_1        = 'New York'
  AND sub_region_2 IN ('Bronx County','Queens County','Kings County',
                       'New York County','Richmond County')
  AND DATE(date) BETWEEN '2019-01-01' AND '2019-12-31'
GROUP BY sub_region_2
LIMIT 20;
```

```sql
-- 6. Average weekly anosmia index per county for 2020.
SELECT sub_region_2,
       AVG(CAST(symptom_anosmia AS FLOAT64)) AS avg_anosmia_2020
FROM `bigquery-public-data.covid19_symptom_search.symptom_search_sub_region_2_weekly`
WHERE country_region_code = 'US'
  AND sub_region_1        = 'New York'
  AND sub_region_2 IN ('Bronx County','Queens County','Kings County',
                       'New York County','Richmond County')
  AND DATE(date) BETWEEN '2020-01-01' AND '2020-12-31'
GROUP BY sub_region_2
LIMIT 20;
```

```sql
-- 7. Combined (aggregate over the five counties) average for each year.
SELECT
  EXTRACT(YEAR FROM DATE(date)) AS yr,
  AVG(CAST(symptom_anosmia AS FLOAT64))  AS avg_anosmia
FROM `bigquery-public-data.covid19_symptom_search.symptom_search_sub_region_2_weekly`
WHERE country_region_code = 'US'
  AND sub_region_1        = 'New York'
  AND sub_region_2 IN ('Bronx County','Queens County','Kings County',
                       'New York County','Richmond County')
  AND DATE(date) BETWEEN '2019-01-01' AND '2020-12-31'
GROUP BY yr
ORDER BY yr
LIMIT 20;
```

```sql
-- 8. Same as #7 but show weekly values before averaging, in case one wants a time series.
SELECT DATE(date) AS week_start,
       AVG(CAST(symptom_anosmia AS FLOAT64)) AS avg_anosmia_5cnty
FROM `bigquery-public-data.covid19_symptom_search.symptom_search_sub_region_2_weekly`
WHERE country_region_code = 'US'
  AND sub_region_1        = 'New York'
  AND sub_region_2 IN ('Bronx County','Queens County','Kings County',
                       'New York County','Richmond County')
  AND DATE(date) BETWEEN '2019-01-01' AND '2020-12-31'
GROUP BY week_start
ORDER BY week_start
LIMIT 20;
```

```sql
-- 9. Put the two yearly averages in separate columns for easier percentage‑change math.
WITH yr_avg AS (
  SELECT
    EXTRACT(YEAR FROM DATE(date)) AS yr,
    AVG(CAST(symptom_anosmia AS FLOAT64)) AS avg_anosmia
  FROM `bigquery-public-data.covid19_symptom_search.symptom_search_sub_region_2_weekly`
  WHERE country_region_code = 'US'
    AND sub_region_1        = 'New York'
    AND sub_region_2 IN ('Bronx County','Queens County','Kings County',
                         'New York County','Richmond County')
    AND DATE(date) BETWEEN '2019-01-01' AND '2020-12-31'
  GROUP BY yr
)
SELECT
  MAX(CASE WHEN yr = 2019 THEN avg_anosmia END) AS avg_2019,
  MAX(CASE WHEN yr = 2020 THEN avg_anosmia END) AS avg_2020
FROM yr_avg;
```

```sql
-- 10. FINAL ANSWER: overall % change in the average weekly anosmia index, 2020 vs 2019.
WITH yr_avg AS (
  SELECT
    EXTRACT(YEAR FROM DATE(date)) AS yr,
    AVG(CAST(symptom_anosmia AS FLOAT64)) AS avg_anosmia
  FROM `bigquery-public-data.covid19_symptom_search.symptom_search_sub_region_2_weekly`
  WHERE country_region_code = 'US'
    AND sub_region_1        = 'New York'
    AND sub_region_2 IN ('Bronx County','Queens County','Kings County',
                         'New York County','Richmond County')
    AND DATE(date) BETWEEN '2019-01-01' AND '2020-12-31'
  GROUP BY yr
)
SELECT
  AVG_2020,
  AVG_2019,
  SAFE_DIVIDE(AVG_2020 - AVG_2019, AVG_2019) * 100 AS pct_change_2020_vs_2019
FROM (
  SELECT
    MAX(CASE WHEN yr = 2019 THEN avg_anosmia END) AS AVG_2019,
    MAX(CASE WHEN yr = 2020 THEN avg_anosmia END) AS AVG_2020
  FROM yr_avg
);
```

