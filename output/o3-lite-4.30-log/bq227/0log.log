```sql
--Description / Thinking process
--We need the annual percentage share (rounded to 2 dp) of the five minor crime
--categories that were most frequent in 2008.
--Steps embedded as CTEs:
--  1. top_5:   pick the 5 highest‑count minor categories from 2008.
--  2. year_totals: overall crime totals for every year.
--  3. cat_year: yearly totals for each of those five categories.
--  4. Final SELECT: join (2) and (3), compute percentage share, round,
--     and collect the five results into an ARRAY so each year is one row.
--Ordering inside ARRAY_AGG uses the share expression directly (no alias) to
--avoid the alias‑in‑ORDER‑BY error we saw earlier.

WITH top_5 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
),
year_totals AS (
  SELECT year,
         SUM(value) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
),
cat_year AS (
  SELECT c.year,
         c.minor_category,
         SUM(c.value) AS cat_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
  JOIN top_5                                           AS t
    ON c.minor_category = t.minor_category
  GROUP BY c.year, c.minor_category
)
SELECT
  y.year,
  ARRAY_AGG(
    STRUCT(
      cy.minor_category                                      AS minor_category,
      ROUND(100 * cy.cat_crimes / y.total_crimes, 2)         AS pct_share
    )
    ORDER BY ROUND(100 * cy.cat_crimes / y.total_crimes, 2) DESC
  ) AS category_shares
FROM year_totals AS y
JOIN cat_year    AS cy
  ON y.year = cy.year
GROUP BY y.year
ORDER BY y.year;
