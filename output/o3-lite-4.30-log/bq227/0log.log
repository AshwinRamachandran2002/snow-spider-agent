```sql
--Description: Correct the earlier “final answer” query by avoiding BigQuery’s
--             unsupported subquery inside the PIVOT IN‑list.  Instead we
--             perform a conditional aggregation that turns each of the
--             five 2008 top‑minor‑categories into its own percentage column.
--             (Those five categories are taken from step‑6 results and
--             hard‑coded below: Other Theft, Theft From Motor Vehicle,
--             Possession Of Drugs, Burglary in a Dwelling, Assault with Injury.)
WITH top_5 AS (                          -- 1. top 5 minor categories in 2008
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
),                                       
year_totals AS (                          -- 2. total crimes per year
  SELECT year,
         SUM(value) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
),
cat_year AS (                             -- 3. totals per (year, top‑5 category)
  SELECT c.year,
         c.minor_category,
         SUM(c.value) AS cat_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
  JOIN top_5                                           AS t
    ON c.minor_category = t.minor_category
  GROUP BY c.year, c.minor_category
),
shares AS (                               -- 4. % share rounded to 2 dp
  SELECT
    y.year,
    cy.minor_category,
    ROUND(100 * cy.cat_crimes / y.total_crimes, 2) AS pct_share
  FROM year_totals AS y
  JOIN cat_year    AS cy
    ON y.year = cy.year
)
SELECT
  year,
  MAX(CASE WHEN minor_category = 'Other Theft'            THEN pct_share END) AS pct_other_theft,
  MAX(CASE WHEN minor_category = 'Theft From Motor Vehicle' THEN pct_share END) AS pct_theft_from_mv,
  MAX(CASE WHEN minor_category = 'Possession Of Drugs'    THEN pct_share END) AS pct_possession_drugs,
  MAX(CASE WHEN minor_category = 'Burglary in a Dwelling' THEN pct_share END) AS pct_burglary_dwelling,
  MAX(CASE WHEN minor_category = 'Assault with Injury'    THEN pct_share END) AS pct_assault_injury
FROM shares
GROUP BY year
ORDER BY year;
