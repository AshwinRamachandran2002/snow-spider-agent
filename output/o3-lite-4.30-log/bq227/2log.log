```sql
--Description / thinking process:
-- We need annual percentage shares for the five minor‑crime categories that were most common in 2008.
-- Approach:
--   1. top5  : identify those five categories from 2008.
--   2. catyr : compute each year’s total crimes for those categories.
--   3. yrall : compute each year’s grand total of crimes (denominator).
--   4. pct   : calculate the % share = catyr / yrall * 100, rounded.
--   5. Final : pivot with conditional aggregation so each year is one row,
--              each category one column.

WITH top5 AS (               -- 1. 2008 top‑5 minor categories
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
),
catyr AS (                   -- 2. yearly totals for those categories
  SELECT year,
         minor_category,
         SUM(value) AS cat_total
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE minor_category IN (SELECT minor_category FROM top5)
  GROUP BY year, minor_category
),
yrall AS (                   -- 3. yearly totals for all crimes
  SELECT year,
         SUM(value) AS grand_total
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
),
pct AS (                     -- 4. percentage share per (year, category)
  SELECT c.year,
         c.minor_category,
         ROUND(100 * c.cat_total / y.grand_total, 2) AS pct_share
  FROM catyr c
  JOIN yrall y USING (year)
)
SELECT                       -- 5. pivot via conditional aggregation
  year,
  MAX(IF(minor_category = 'Other Theft',              pct_share, NULL)) AS other_theft_pct,
  MAX(IF(minor_category = 'Theft From Motor Vehicle', pct_share, NULL)) AS theft_from_motor_vehicle_pct,
  MAX(IF(minor_category = 'Possession Of Drugs',      pct_share, NULL)) AS possession_of_drugs_pct,
  MAX(IF(minor_category = 'Burglary in a Dwelling',   pct_share, NULL)) AS burglary_in_dwelling_pct,
  MAX(IF(minor_category = 'Assault with Injury',      pct_share, NULL)) AS assault_with_injury_pct
FROM pct
GROUP BY year
ORDER BY year;
```
