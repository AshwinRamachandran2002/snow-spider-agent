Begin Exploring Related Columns
Relevant columns and why they matter  
• minor_category: to identify the crime sub‑types that we will rank and later track every year.  
• value: numeric field we sum to obtain crime totals.  
• year: used to (a) pick the base year 2008 when we look for the “top‑5” minor categories and (b) calculate annual totals and shares afterwards.  

Typical conditions that will be useful  
• WHERE year = 2008  – select the base year for ranking.  
• WHERE minor_category IN ( … ) – restrict later queries to the five categories we just found.  


10 step‑by‑step exploration queries (all limited to 20 rows to keep the output short).  
Each query builds a little more logic than the previous one.

```sql
-- 1. Peek at the raw crime table
SELECT *
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
LIMIT 20;
```

```sql
-- 2. See all years available
SELECT DISTINCT year
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
ORDER BY year
LIMIT 20;
```

```sql
-- 3. List a sample of the minor crime categories
SELECT DISTINCT minor_category
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
ORDER BY minor_category
LIMIT 20;
```

```sql
-- 4. Crime totals per minor category in 2008
SELECT minor_category, SUM(value) AS crimes_2008
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE year = 2008
GROUP BY minor_category
ORDER BY crimes_2008 DESC
LIMIT 20;
```

```sql
-- 5. The top‑5 minor categories in 2008 only
SELECT minor_category, SUM(value) AS crimes_2008
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE year = 2008
GROUP BY minor_category
ORDER BY crimes_2008 DESC
LIMIT 5;
```

```sql
-- 6. Annual total crimes for the whole city (all categories)
SELECT year, SUM(value) AS total_crimes
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
-- 7. Annual totals for the five biggest 2008 categories
WITH top5 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
)
SELECT c.year,
       c.minor_category,
       SUM(c.value) AS cat_crimes
FROM  `bigquery-public-data.london_crime.crime_by_lsoa` AS c
JOIN  top5 t
ON    c.minor_category = t.minor_category
GROUP BY c.year, c.minor_category
ORDER BY c.year, cat_crimes DESC
LIMIT 20;
```

```sql
-- 8. Put yearly totals and category totals together so we can compute shares
WITH top5 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
),
year_totals AS (
  SELECT year, SUM(value) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
)
SELECT  y.year,
        c.minor_category,
        SUM(c.value) AS cat_crimes,
        y.total_crimes
FROM    year_totals y
LEFT JOIN `bigquery-public-data.london_crime.crime_by_lsoa` c
       ON c.year = y.year
JOIN    top5 t
       ON c.minor_category = t.minor_category
GROUP BY y.year, c.minor_category, y.total_crimes
ORDER BY y.year, cat_crimes DESC
LIMIT 20;
```

```sql
-- 9. Same as #8 but now show the % share (rounded)
WITH top5 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
),
year_totals AS (
  SELECT year, SUM(value) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
),
cat_year AS (
  SELECT c.year, c.minor_category, SUM(c.value) AS cat_crimes
  FROM  `bigquery-public-data.london_crime.crime_by_lsoa` c
  JOIN  top5 t
  ON    c.minor_category = t.minor_category
  GROUP BY c.year, c.minor_category
)
SELECT  cy.year,
        cy.minor_category,
        ROUND(100 * cy.cat_crimes / yt.total_crimes, 2) AS pct_share
FROM    cat_year cy
JOIN    year_totals yt
ON      cy.year = yt.year
ORDER BY cy.year, pct_share DESC
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER
--     One row per year, five columns = % share for each 2008 top‑5 category
WITH top5 AS (
  SELECT minor_category, 
         ROW_NUMBER() OVER (ORDER BY SUM(value) DESC) AS rn
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY rn
  LIMIT 5
),
year_totals AS (
  SELECT year, SUM(value) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
),
cat_year AS (
  SELECT c.year,
         c.minor_category,
         SUM(c.value) AS cat_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa` c
  JOIN top5 t
  USING (minor_category)
  GROUP BY c.year, c.minor_category
),
pct AS (
  SELECT cy.year,
         cy.minor_category,
         ROUND(100 * cy.cat_crimes / yt.total_crimes, 2) AS pct_share
  FROM  cat_year cy
  JOIN  year_totals yt
       ON cy.year = yt.year
)
SELECT
  p.year,
  MAX(CASE WHEN p.minor_category = (SELECT minor_category FROM top5 WHERE rn = 1) THEN p.pct_share END) AS `Top1_%`,
  MAX(CASE WHEN p.minor_category = (SELECT minor_category FROM top5 WHERE rn = 2) THEN p.pct_share END) AS `Top2_%`,
  MAX(CASE WHEN p.minor_category = (SELECT minor_category FROM top5 WHERE rn = 3) THEN p.pct_share END) AS `Top3_%`,
  MAX(CASE WHEN p.minor_category = (SELECT minor_category FROM top5 WHERE rn = 4) THEN p.pct_share END) AS `Top4_%`,
  MAX(CASE WHEN p.minor_category = (SELECT minor_category FROM top5 WHERE rn = 5) THEN p.pct_share END) AS `Top5_%`
FROM pct AS p
GROUP BY p.year
ORDER BY p.year
LIMIT 20;
```

The last query returns, for every calendar year in the dataset, the percentage contribution (rounded to two decimals) of each of the five most common minor crime categories identified in 2008, with every year shown in a single row.
