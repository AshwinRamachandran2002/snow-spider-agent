    GROUP BY customer_id, DATE(txn_date)
),
/* running balance for every calendar day, negatives clipped to 0 */
daily_balance AS (
    SELECT
        c.customer_id,
        c.cal_date,
        MAX(
            0,
            SUM(COALESCE(d.net_change,0))
            OVER (PARTITION BY c.customer_id ORDER BY c.cal_date)
        ) AS balance
    FROM calendar AS c
    LEFT JOIN daily_change AS d
           ON c.customer_id = d.customer_id
          AND c.cal_date    = d.txn_date
),
/* highest daily balance each customer reached in every month */
customer_monthly_max AS (
    SELECT
        customer_id,
        STRFTIME('%Y-%m', cal_date) AS month,
        MAX(balance)                AS max_daily_balance
    FROM daily_balance
    GROUP BY customer_id, month
)
SELECT
    month,
    SUM(max_daily_balance) AS total_max_daily_balance
FROM customer_monthly_max
GROUP BY month
ORDER BY month;
