           ON  c."customer_id" = d."customer_id"
           AND c."cal_date"    = d."txn_date"
)
SELECT "customer_id",
       strftime('%Y-%m', "cal_date") AS "month",
       MAX("balance")                AS "max_daily_balance"
FROM   daily_balance
GROUP  BY "customer_id", "month"
ORDER  BY "customer_id", "month"
LIMIT 20;
