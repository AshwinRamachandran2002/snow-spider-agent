                    ELSE 0 END) AS "net_change"
    FROM   "customer_transactions"
    GROUP  BY "customer_id", date("txn_date")
),
daily_balance AS (
    SELECT c."customer_id",
           c."cal_date",
           MAX(0,
               SUM(COALESCE(d."net_change",0))
               OVER (PARTITION BY c."customer_id"
                     ORDER BY c."cal_date")) AS "balance"
    FROM   calendar AS c
