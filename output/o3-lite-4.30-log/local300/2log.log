Relevant tables and columns – what they are useful for

customer_transactions
• customer_id : primary key to identify each customer  
• txn_date    : the calendar date on which the transaction occurred  
• txn_type    : tells us whether the amount should be added to (e.g. ‘deposit’) or sub‑tracted from (e.g. ‘withdrawal’) the running balance  
• txn_amount  : the value to be applied (+ for deposits, − for withdrawals)  
Conditions that may be useful  
• WHERE txn_type = 'deposit'  (positive change)  
• WHERE txn_type = 'withdrawal' (negative change – we will multiply by –1)

(Other tables are not needed for the requested balance‑calculation task.)

Ten exploratory‑to‑final SQLite queries
Each query is limited to 20 rows and shows one more step toward the required result.

```sql
-- 1) Look at the different transaction types that exist
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 2) Earliest and latest dates in the whole data set
SELECT MIN(date("txn_date"))  AS "earliest_date",
       MAX(date("txn_date"))  AS "latest_date"
FROM   "customer_transactions";
```

```sql
-- 3) Earliest and latest transaction dates per customer (first 20 customers)
SELECT "customer_id",
       MIN(date("txn_date")) AS "start_date",
       MAX(date("txn_date")) AS "end_date"
FROM   "customer_transactions"
GROUP  BY "customer_id"
ORDER  BY "customer_id"
LIMIT 20;
```

```sql
-- 4) All transactions for one sample customer (id = 1)
SELECT date("txn_date")   AS "txn_date",
       "txn_type",
       "txn_amount"
FROM   "customer_transactions"
WHERE  "customer_id" = 1
ORDER  BY date("txn_date")
LIMIT 20;
```

```sql
-- 5) Net daily change (deposit = +, withdrawal = –) for the first 20 rows
SELECT "customer_id",
       date("txn_date") AS "txn_date",
       SUM(CASE WHEN "txn_type" = 'deposit'     THEN  "txn_amount"
                WHEN "txn_type" = 'withdrawal'  THEN - "txn_amount"
                ELSE 0 END)                    AS "net_change"
FROM   "customer_transactions"
GROUP  BY "customer_id", date("txn_date")
ORDER  BY "customer_id", "txn_date"
LIMIT 20;
```

```sql
-- 6) Build the per‑customer calendar of dates (recursive CTE, first 20 rows)
WITH cust_limits AS (
    SELECT "customer_id",
           MIN(date("txn_date")) AS "start_date",
           MAX(date("txn_date")) AS "end_date"
    FROM   "customer_transactions"
    GROUP  BY "customer_id"
),
calendar AS (
    SELECT "customer_id", "start_date" AS "cal_date"
    FROM   cust_limits
    UNION ALL
    SELECT "customer_id",
           date("cal_date",' +1 day')
    FROM   calendar
    JOIN   cust_limits USING ("customer_id")
    WHERE  "cal_date" <  "end_date"
)
SELECT * FROM calendar
ORDER  BY "customer_id", "cal_date"
LIMIT 20;
```

```sql
-- 7) Merge calendar with net daily change and produce the running balance
--    (first 20 rows, negative balances clipped to 0)
WITH cust_limits AS (
    SELECT "customer_id",
           MIN(date("txn_date")) AS "start_date",
           MAX(date("txn_date")) AS "end_date"
    FROM   "customer_transactions"
    GROUP  BY "customer_id"
),
calendar AS (
    SELECT "customer_id", "start_date" AS "cal_date"
    FROM   cust_limits
    UNION ALL
    SELECT "customer_id",
           date("cal_date",' +1 day')
    FROM   calendar
    JOIN   cust_limits USING ("customer_id")
    WHERE  "cal_date" <  "end_date"
),
daily_change AS (
    SELECT "customer_id",
           date("txn_date") AS "txn_date",
           SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                    WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                    ELSE 0 END) AS "net_change"
    FROM   "customer_transactions"
    GROUP  BY "customer_id", date("txn_date")
)
SELECT c."customer_id",
       c."cal_date",
       MAX(0,
           SUM(COALESCE(d."net_change",0))
           OVER (PARTITION BY c."customer_id"
                 ORDER BY c."cal_date"))        AS "running_balance"
FROM   calendar AS c
LEFT   JOIN daily_change AS d
       ON  c."customer_id" = d."customer_id"
       AND c."cal_date"    = d."txn_date"
ORDER  BY c."customer_id", c."cal_date"
LIMIT 20;
```

```sql
-- 8) Highest daily balance per customer per month (limit 20 rows)
WITH cust_limits AS (
    SELECT "customer_id",
           MIN(date("txn_date")) AS "start_date",
           MAX(date("txn_date")) AS "end_date"
    FROM   "customer_transactions"
    GROUP  BY "customer_id"
),
calendar AS (
    SELECT "customer_id", "start_date" AS "cal_date"
    FROM   cust_limits
    UNION ALL
    SELECT "customer_id",
           date("cal_date",' +1 day')
    FROM   calendar
    JOIN   cust_limits USING ("customer_id")
    WHERE  "cal_date" <  "end_date"
),
daily_change AS (
    SELECT "customer_id",
           date("txn_date") AS "txn_date",
           SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                    WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                    ELSE 0 END) AS "net_change"
    FROM   "customer_transactions"
    GROUP  BY "customer_id", date("txn_date")
),
daily_balance AS (
    SELECT c."customer_id",
           c."cal_date",
           MAX(0,
               SUM(COALESCE(d."net_change",0))
               OVER (PARTITION BY c."customer_id"
                     ORDER BY c."cal_date")) AS "balance"
    FROM   calendar AS c
    LEFT   JOIN daily_change AS d
           ON  c."customer_id" = d."customer_id"
           AND c."cal_date"    = d."txn_date"
)
SELECT "customer_id",
       strftime('%Y-%m', "cal_date") AS "month",
       MAX("balance")                AS "max_daily_balance"
FROM   daily_balance
GROUP  BY "customer_id", "month"
ORDER  BY "customer_id", "month"
LIMIT 20;
```

```sql
-- 9) Monthly total = sum of customers’ max daily balances (limit first 20)
WITH cust_limits AS (
    SELECT "customer_id",
           MIN(date("txn_date")) AS "start_date",
           MAX(date("txn_date")) AS "end_date"
    FROM   "customer_transactions"
    GROUP  BY "customer_id"
),
calendar AS (
    SELECT "customer_id", "start_date" AS "cal_date"
    FROM   cust_limits
    UNION ALL
    SELECT "customer_id",
           date("cal_date",' +1 day')
    FROM   calendar
    JOIN   cust_limits USING ("customer_id")
    WHERE  "cal_date" <  "end_date"
),
daily_change AS (
    SELECT "customer_id",
           date("txn_date") AS "txn_date",
           SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                    WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                    ELSE 0 END) AS "net_change"
    FROM   "customer_transactions"
    GROUP  BY "customer_id", date("txn_date")
),
daily_balance AS (
    SELECT c."customer_id",
           c."cal_date",
           MAX(0,
               SUM(COALESCE(d."net_change",0))
               OVER (PARTITION BY c."customer_id"
                     ORDER BY c."cal_date")) AS "balance"
    FROM   calendar AS c
    LEFT   JOIN daily_change AS d
           ON  c."customer_id" = d."customer_id"
           AND c."cal_date"    = d."txn_date"
),
customer_monthly_max AS (
    SELECT "customer_id",
           strftime('%Y-%m', "cal_date") AS "month",
           MAX("balance")                AS "max_daily_balance"
    FROM   daily_balance
    GROUP  BY "customer_id", "month"
)
SELECT "month",
       SUM("max_daily_balance") AS "monthly_total_max_balance"
FROM   customer_monthly_max
GROUP  BY "month"
ORDER  BY "month"
LIMIT 20;
