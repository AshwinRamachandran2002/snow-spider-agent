['weekly_sales', 'shopping_cart_users', 'bitcoin_members', 'interest_metrics', 'customer_regions', 'customer_transactions', 'bitcoin_transactions', 'customer_nodes', 'cleaned_weekly_sales', 'veg_txn_df', 'shopping_cart_events', 'shopping_cart_page_hierarchy', 'bitcoin_prices', 'interest_map', 'veg_loss_rate_df', 'shopping_cart_campaign_identifier', 'veg_cat', 'veg_whsle_df', 'shopping_cart_event_identifier']
Begin Exploring Related Columns
Relevant columns and their potential usage  
• customer_transactions.customer_id – primary key to identify each customer for all balance calculations and aggregations.  
• customer_transactions.txn_date – calendar date of every transaction; used to create the complete daily timeline, to derive month buckets (e.g., strftime('%Y‑%m', txn_date)) and to order rows for running‑balance logic.  
• customer_transactions.txn_type – indicates whether the amount should increase (e.g., ‘deposit’) or decrease the balance (e.g., ‘withdrawal’, ‘purchase’).  
• customer_transactions.txn_amount – the numeric value that is added to / subtracted from the running balance.  
Typical conditions that may be used  
• WHERE txn_type = 'deposit'    -- keep only positive inflows  
• WHERE txn_type <> 'deposit'   -- inspect outflows (negative impact)  
• strftime('%Y-%m', txn_date) = '2020‑03' -- focus on a given month  
• ORDER BY customer_id , txn_date  -- ensure correct row order for running sums  
• HAVING MAX(daily_balance) > 0   -- ignore customers who never go above zero  

Ten exploratory SQL queries (all limited to 20 rows)  
```sql
-- 1. List all distinct transaction types that exist.
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 2. For each customer, show their first and last transaction dates.
SELECT "customer_id",
       MIN("txn_date") AS "earliest_date",
       MAX("txn_date") AS "latest_date"
FROM "customer_transactions"
GROUP BY "customer_id"
LIMIT 20;
```

```sql
-- 3. Find the total net amount (inflows – outflows) per customer per day.
SELECT "customer_id",
       "txn_date",
       SUM(CASE
              WHEN "txn_type" = 'deposit' THEN  "txn_amount"
              ELSE                         - "txn_amount"
           END) AS "net_amount"
FROM "customer_transactions"
GROUP BY "customer_id", "txn_date"
LIMIT 20;
```

```sql
-- 4. Produce a running (cumulative) balance for every
--    customer across all of their transaction dates.
SELECT "customer_id",
       "txn_date",
       SUM(CASE
              WHEN "txn_type" = 'deposit' THEN  "txn_amount"
              ELSE                         - "txn_amount"
           END)
       OVER (PARTITION BY "customer_id"
             ORDER BY "txn_date"
             ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
FROM "customer_transactions"
ORDER BY "customer_id", "txn_date"
LIMIT 20;
```

```sql
-- 5. Convert the running balance into a daily balance
--    that cannot drop below zero.
SELECT "customer_id",
       "txn_date",
       CASE
            WHEN "running_balance" < 0 THEN 0
            ELSE "running_balance"
       END AS "daily_balance"
FROM (
       SELECT "customer_id",
              "txn_date",
              SUM(CASE
                     WHEN "txn_type" = 'deposit' THEN  "txn_amount"
                     ELSE                         - "txn_amount"
                  END)
              OVER (PARTITION BY "customer_id"
                    ORDER BY "txn_date"
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
       FROM "customer_transactions"
     )
LIMIT 20;
```

```sql
-- 6. Derive, for every customer and calendar month,
--    the maximum daily balance they reached.
SELECT "customer_id",
       strftime('%Y-%m', "txn_date") AS "calendar_month",
       MAX("daily_balance")          AS "max_daily_balance"
FROM (
       SELECT "customer_id",
              "txn_date",
              CASE
                   WHEN "running_balance" < 0 THEN 0
                   ELSE "running_balance"
              END AS "daily_balance"
       FROM (
              SELECT "customer_id",
                     "txn_date",
                     SUM(CASE
                            WHEN "txn_type" = 'deposit' THEN  "txn_amount"
                            ELSE                         - "txn_amount"
                         END)
                     OVER (PARTITION BY "customer_id"
                           ORDER BY "txn_date"
                           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
              FROM "customer_transactions"
            )
     )
GROUP BY "customer_id", strftime('%Y-%m', "txn_date")
LIMIT 20;
```

```sql
-- 7. Obtain the monthly total by summing the
--    customer‑level maximum balances for each month.
SELECT "calendar_month",
       SUM("max_daily_balance") AS "monthly_total_balance"
FROM (
       SELECT "customer_id",
              strftime('%Y-%m', "txn_date") AS "calendar_month",
              MAX("daily_balance")           AS "max_daily_balance"
       FROM (
              SELECT "customer_id",
                     "txn_date",
                     CASE
                          WHEN "running_balance" < 0 THEN 0
                          ELSE "running_balance"
                     END AS "daily_balance"
              FROM (
                     SELECT "customer_id",
                            "txn_date",
                            SUM(CASE
                                   WHEN "txn_type" = 'deposit' THEN  "txn_amount"
                                   ELSE                         - "txn_amount"
                                END)
                            OVER (PARTITION BY "customer_id"
                                  ORDER BY "txn_date"
                                  ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
                     FROM "customer_transactions"
                   )
            )
       GROUP BY "customer_id", strftime('%Y-%m', "txn_date")
     )
GROUP BY "calendar_month"
ORDER BY "calendar_month"
LIMIT 20;
```

```sql
-- 8. Quick view of months for which transactions exist.
SELECT DISTINCT strftime('%Y-%m', "txn_date") AS "calendar_month"
FROM "customer_transactions"
ORDER BY "calendar_month"
LIMIT 20;
```

```sql
-- 9. Inspect transactions that are not deposits
--    (potential outflows) to verify sign handling.
SELECT "customer_id",
       "txn_date",
       "txn_type",
       "txn_amount"
FROM "customer_transactions"
WHERE "txn_type" <> 'deposit'
LIMIT 20;
```

```sql
--10. Spot‑check final monthly totals (joined back to regional info
--    if you later need to analyse by customer region).
SELECT cr."region_name",
       mt."calendar_month",
       SUM(mt."max_daily_balance") AS "regional_monthly_total"
FROM (
       SELECT "customer_id",
              strftime('%Y-%m', "txn_date") AS "calendar_month",
              MAX(
                  CASE
                       WHEN "running_balance" < 0 THEN 0
                       ELSE "running_balance"
                  END
              ) AS "max_daily_balance"
       FROM (
              SELECT ct."customer_id",
                     ct."txn_date",
                     SUM(CASE
                            WHEN ct."txn_type" = 'deposit' THEN  ct."txn_amount"
                            ELSE                          - ct."txn_amount"
                         END)
                     OVER (PARTITION BY ct."customer_id"
                           ORDER BY ct."txn_date"
                           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
              FROM "customer_transactions" AS ct
            )
       GROUP BY "customer_id", strftime('%Y-%m', "txn_date")
     ) AS mt
LEFT JOIN "customer_nodes"   AS cn ON mt."customer_id" = cn."customer_id"
LEFT JOIN "customer_regions" AS cr ON cn."region_id"  = cr."region_id"
GROUP BY cr."region_name", mt."calendar_month"
LIMIT 20;
```

The ten queries gradually explore the data set—from simply inspecting transaction types to producing the month‑level totals that satisfy the business requirement, while remaining within the constraints (SELECT‑only, DISTINCT where meaningful, LIMIT 20).
