--Description: Sample inspection query – builds daily balances for all customers,
--             extracts each customer’s monthly peak and returns the first 20
--             months of the company‑wide total.
WITH
daily_net AS (
    SELECT
        customer_id,
        txn_date,
        SUM(CASE
                WHEN txn_type = 'deposit'    THEN  txn_amount
                WHEN txn_type = 'withdrawal' THEN -txn_amount
                ELSE 0
            END) AS net_change
    FROM customer_transactions
    GROUP BY customer_id, txn_date
),
span AS (
    SELECT
        customer_id,
        MIN(txn_date) AS start_d,
        MAX(txn_date) AS end_d
    FROM daily_net
    GROUP BY customer_id
),
calendar AS (
    SELECT
        customer_id,
        start_d AS cal_date,
        end_d
    FROM span
    UNION ALL
    SELECT
        customer_id,
        DATE(cal_date,'+1 day'),
        end_d
    FROM calendar
    WHERE cal_date < end_d
),
series AS (   -- gaps → 0
    SELECT
        cal.customer_id,
        cal.cal_date,
        COALESCE(dn.net_change,0) AS net_change
    FROM   calendar AS cal
    LEFT  JOIN daily_net  AS dn
           ON dn.customer_id = cal.customer_id
          AND dn.txn_date    = cal.cal_date
),
balances AS ( -- running balance, negatives floored at 0
    SELECT
        customer_id,
        cal_date,
        MAX(0,
            SUM(net_change) OVER
            (PARTITION BY customer_id
             ORDER BY cal_date
             ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
        ) AS daily_balance
    FROM series
),
cust_month_max AS (  -- customer’s max balance each month
    SELECT
        customer_id,
        STRFTIME('%Y-%m', cal_date) AS month,
        MAX(daily_balance)          AS max_balance_in_month
    FROM balances
    GROUP BY customer_id, month
)
SELECT
    month,
    SUM(max_balance_in_month) AS monthly_peak_total
FROM cust_month_max
GROUP BY month
ORDER BY month
LIMIT 20
