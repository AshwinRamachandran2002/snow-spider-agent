--Description:  End‑to‑end solution that
--   1) converts every customer’s raw transactions into a net daily movement
--      (+ deposit, − withdrawal),
--   2) creates a calendar row for every intervening day so we can carry the
--      balance forward when no transaction occurs,
--   3) calculates the running cumulative balance per customer (negatives are
--      floored at 0),
--   4) finds, for each customer and month, the single highest daily balance,
--   5) and finally sums those customer‑monthly peaks to give the company‑wide
--      peak total per month.
--      The query is self‑contained; only the final SELECT is returned.
WITH
daily_net AS (                       -- net change per customer on txn days
    SELECT
        ct.customer_id,
        ct.txn_date,
        SUM(
            CASE
                WHEN ct.txn_type = 'deposit'    THEN  ct.txn_amount
                WHEN ct.txn_type = 'withdrawal' THEN -ct.txn_amount
                ELSE 0
            END
        ) AS net_change
    FROM customer_transactions AS ct
    GROUP BY ct.customer_id, ct.txn_date
),
span AS (                            -- first and last txn date for each customer
    SELECT
        dn.customer_id,
        MIN(dn.txn_date) AS start_d,
        MAX(dn.txn_date) AS end_d
    FROM daily_net AS dn
    GROUP BY dn.customer_id
),
calendar AS (                        -- recursive list of every day in each span
    SELECT
        sp.customer_id,
        sp.start_d AS cal_date,
        sp.end_d
    FROM span AS sp
    UNION ALL
    SELECT
        cal.customer_id,
        DATE(cal.cal_date,'+1 day') AS cal_date,
        cal.end_d
    FROM calendar AS cal
    WHERE cal.cal_date < cal.end_d
),
series AS (                          -- join calendar to daily_net, fill gaps with 0
    SELECT
        cal.customer_id,
        cal.cal_date,
        COALESCE(dn.net_change,0) AS net_change
    FROM calendar AS cal
    LEFT JOIN daily_net AS dn
           ON dn.customer_id = cal.customer_id
          AND dn.txn_date    = cal.cal_date
),
balances AS (                        -- running balance per customer, floor at 0
    SELECT
        s.customer_id,
        s.cal_date,
        MAX(
            0,
            SUM(s.net_change) OVER (
                PARTITION BY s.customer_id
                ORDER BY s.cal_date
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
            )
        ) AS daily_balance
    FROM series AS s
),
cust_month_max AS (                  -- customer’s highest balance in each month
    SELECT
        b.customer_id,
        STRFTIME('%Y-%m', b.cal_date) AS month,
        MAX(b.daily_balance)          AS max_balance_in_month
    FROM balances AS b
    GROUP BY b.customer_id, month
)
SELECT
    cmm.month,
    SUM(cmm.max_balance_in_month) AS monthly_peak_total
FROM cust_month_max AS cmm
GROUP BY cmm.month
ORDER BY cmm.month;
