```sql
--Description: compute, for every customer, the highest daily balance attained
--             in each calendar month.  The query builds the “balances” data
--             set on the fly and then aggregates it.
--  • cust_span   : determine each customer’s first and last transaction date.
--  • calendar    : recursively emit every day within that span (per customer).
--  • net_daily   : net cash movement for each customer on each transaction day
--                  (+deposit, −withdrawal, ignore any other txn_type).
--  • daily_series: join calendar to net_daily, inserting 0 where no movement.
--  • balances    : running cumulative total per customer, negatives clipped
--                  to 0 via MAX(0,…).
--  • final SELECT: group by customer + month and keep the maximum balance.
WITH
cust_span AS (
    SELECT
        ct.customer_id,
        MIN(ct.txn_date) AS start_d,
        MAX(ct.txn_date) AS end_d
    FROM customer_transactions AS ct
    GROUP BY ct.customer_id
),
calendar AS (
    SELECT
        cs.customer_id,
        cs.start_d AS cal_date,
        cs.end_d
    FROM cust_span AS cs
    UNION ALL
    SELECT
        cal.customer_id,
        DATE(cal.cal_date,'+1 day') AS cal_date,
        cal.end_d
    FROM calendar AS cal
    WHERE cal.cal_date < cal.end_d
),
net_daily AS (
    SELECT
        ct.customer_id,
        ct.txn_date,
        SUM(
            CASE
                WHEN ct.txn_type = 'deposit'    THEN  ct.txn_amount
                WHEN ct.txn_type = 'withdrawal' THEN -ct.txn_amount
                ELSE 0
            END
        ) AS net_chg
    FROM customer_transactions AS ct
    GROUP BY ct.customer_id, ct.txn_date
),
daily_series AS (
    SELECT
        cal.customer_id,
        cal.cal_date,
        COALESCE(nd.net_chg,0) AS net_change
    FROM calendar AS cal
    LEFT JOIN net_daily AS nd
           ON nd.customer_id = cal.customer_id
          AND nd.txn_date    = cal.cal_date
),
balances AS (
    SELECT
        ds.customer_id,
        ds.cal_date,
        MAX(
            0,
            SUM(ds.net_change) OVER (
                PARTITION BY ds.customer_id
                ORDER BY ds.cal_date
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
            )
        ) AS daily_balance
    FROM daily_series AS ds
)
SELECT
    b.customer_id,
    STRFTIME('%Y-%m', b.cal_date) AS month,
    MAX(b.daily_balance)          AS max_balance_in_month
FROM balances AS b
GROUP BY b.customer_id, month
ORDER BY b.customer_id, month
LIMIT 20;
