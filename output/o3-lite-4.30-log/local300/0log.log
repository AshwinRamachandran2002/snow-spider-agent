```sql
--Description: Build a calendar‑filled data set for (sample) 20 customers,
--             then calculate their running balance day‑by‑day (negatives
--             clipped to 0).  Fully‑qualified columns prevent ambiguity.
WITH
cust_span AS (                        -- first/last txn dates (limit to 20 customers)
    SELECT
        ct.customer_id,
        MIN(ct.txn_date) AS start_d,
        MAX(ct.txn_date) AS end_d
    FROM customer_transactions AS ct
    GROUP BY ct.customer_id
    LIMIT 20
),
calendar AS (                         -- recursive day‑by‑day calendar
    SELECT
        cs.customer_id,
        cs.start_d AS cal_date,
        cs.end_d
    FROM cust_span AS cs
    UNION ALL
    SELECT
        cal.customer_id,
        DATE(cal.cal_date,'+1 day') AS cal_date,
        cal.end_d
    FROM calendar AS cal
    WHERE cal.cal_date < cal.end_d
),
net_daily AS (                        -- net (+deposit, –withdrawal) per customer/day
    SELECT
        ct.customer_id,
        ct.txn_date,
        SUM(
            CASE
                WHEN ct.txn_type = 'deposit'    THEN  ct.txn_amount
                WHEN ct.txn_type = 'withdrawal' THEN -ct.txn_amount
                ELSE 0
            END
        ) AS net_chg
    FROM customer_transactions AS ct
    GROUP BY ct.customer_id, ct.txn_date
),
daily_series AS (                     -- join calendar to net_daily, fill gaps with 0
    SELECT
        cal.customer_id,
        cal.cal_date,
        COALESCE(nd.net_chg,0) AS net_change
    FROM calendar AS cal
    LEFT JOIN net_daily AS nd
           ON nd.customer_id = cal.customer_id
          AND nd.txn_date    = cal.cal_date
),
balances AS (                         -- running total, negatives forced to 0
    SELECT
        ds.customer_id,
        ds.cal_date,
        MAX(
            0,
            SUM(ds.net_change) OVER (
                PARTITION BY ds.customer_id
                ORDER BY ds.cal_date
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
            )
        ) AS daily_balance
    FROM daily_series AS ds
)
SELECT *
FROM balances
ORDER BY balances.customer_id, balances.cal_date
LIMIT 20;
```

