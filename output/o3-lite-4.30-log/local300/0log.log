--Description:  End‑to‑end pipeline in one query:
--   ① Collapse transactions into a net daily movement per customer.
--   ② Determine each customer’s first ↔ last transaction dates.
--   ③ Recursively build a complete calendar for every customer so we keep
--      balances on dates with no activity.
--   ④ Left‑join the calendar to the net‑movement table, inserting 0 when
--      there is no transaction that day.
--   ⑤ Compute a running cumulative balance per customer, but floor any
--      negative intermediate value at 0.
--   ⑥ For every customer‑month pick the maximum daily balance reached.
--   ⑦ Sum these customer‑monthly peaks to obtain the company‑wide total
--      of “highest daily balances” per month (first 20 rows shown).
WITH
daily_net AS (                       -- ①  net (+dep, −wd) per day
    SELECT
        customer_id,
        txn_date,
        SUM(
            CASE txn_type
                WHEN 'deposit'    THEN  txn_amount
                WHEN 'withdrawal' THEN -txn_amount
                ELSE 0
            END
        ) AS net_change
    FROM customer_transactions
    GROUP BY customer_id, txn_date
),
span AS (                            -- ②  date span for each customer
    SELECT
        customer_id,
        MIN(txn_date) AS start_d,
        MAX(txn_date) AS end_d
    FROM daily_net
    GROUP BY customer_id
),
calendar AS (                        -- ③  all dates in each span
    SELECT customer_id, start_d AS cal_date, end_d
    FROM   span
    UNION ALL
    SELECT customer_id,
           DATE(cal_date,'+1 day'),
           end_d
    FROM   calendar
    WHERE  cal_date < end_d
),
series AS (                          -- ④  attach net_change, missing = 0
    SELECT
        c.customer_id,
        c.cal_date,
        COALESCE(d.net_change, 0) AS net_change
    FROM calendar AS c
    LEFT JOIN daily_net AS d
           ON d.customer_id = c.customer_id
          AND d.txn_date    = c.cal_date
),
balances AS (                        -- ⑤  running balance, negatives → 0
    SELECT
        s.customer_id,
        s.cal_date,
        MAX(0,
            SUM(s.net_change) OVER (
                PARTITION BY s.customer_id
                ORDER BY s.cal_date
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
            )
        ) AS daily_balance
    FROM series AS s
),
cust_month_max AS (                  -- ⑥  customer’s peak balance per month
    SELECT
        customer_id,
        STRFTIME('%Y-%m', cal_date) AS month,
        MAX(daily_balance)          AS max_daily_balance
    FROM balances
    GROUP BY customer_id, month
)
-- ⑦  company‑wide monthly sum of customer peaks
SELECT
    month,
    SUM(max_daily_balance) AS monthly_peak_total
FROM cust_month_max
GROUP BY month
ORDER BY month
LIMIT 20;
