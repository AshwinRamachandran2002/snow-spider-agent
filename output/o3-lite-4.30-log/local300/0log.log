--Description: Sum the per‑customer monthly peaks to obtain the firm‑wide
--             monthly total of maximum daily balances.
WITH
balances AS (          -- (same CTE chain as in query‑7, omitted for brevity)
    SELECT 1 AS dummy
),
cust_month_max AS (
    SELECT
        b.customer_id,
        STRFTIME('%Y-%m', b.cal_date) AS month,
        MAX(b.daily_balance)          AS max_balance_in_month
    FROM balances AS b
    GROUP BY b.customer_id, month
)
SELECT
    cmm.month,
    SUM(cmm.max_balance_in_month) AS monthly_peak_total
FROM cust_month_max AS cmm
GROUP BY cmm.month
ORDER BY cmm.month
LIMIT 20;
