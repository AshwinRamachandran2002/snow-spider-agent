Begin Exploring Related Columns
Relevant tables / columns and their role in the task    
• customer_transactions.customer_id – identifies the customer whose balance we track  
• customer_transactions.txn_date – the calendar date on which money moved (anchor for daily balance)  
• customer_transactions.txn_type – direction of the movement (expected values: ‘deposit’, ‘withdrawal’ etc.); will be used to add or subtract amounts  
• customer_transactions.txn_amount – amount of the movement we add/subtract when computing the running balance  

(Everything else in the schema is irrelevant for “customer balance” calculations.)

Typical conditions that will be used  
• WHERE txn_type = 'deposit'          -- treat as positive inflow  
• WHERE txn_type IN ('withdrawal','purchase')  -- treat as negative outflow  
• Dates will be cast or compared as texts in ISO‑8601 format (YYYY‑MM‑DD) because that is how they are stored.

Exploratory –‑to‑‑solution SQLs                                                              
(Each query limited to 20 rows and accompanied by a short comment.)

```sql
-- 1. Look at the different kinds of transaction directions we have
SELECT DISTINCT txn_type
FROM customer_transactions
LIMIT 20;
```

```sql
-- 2. Inspect the span (earliest vs latest) of activity for a few customers
SELECT customer_id,
       MIN(txn_date) AS first_txn,
       MAX(txn_date) AS last_txn
FROM customer_transactions
GROUP BY customer_id
ORDER BY customer_id
LIMIT 20;
```

```sql
-- 3. What does an individual customer’s raw ledger look like?
SELECT *
FROM customer_transactions
WHERE customer_id = 1
ORDER BY txn_date
LIMIT 20;
```

```sql
-- 4. Aggregate same‑day movements into net daily change for every customer
SELECT customer_id,
       txn_date,
       SUM(CASE WHEN txn_type = 'deposit'    THEN txn_amount
                WHEN txn_type = 'withdrawal' THEN -txn_amount
                ELSE 0 END) AS net_change
FROM customer_transactions
GROUP BY customer_id, txn_date
ORDER BY customer_id, txn_date
LIMIT 20;
```

```sql
-- 5. Running balance (cumulative sum) per customer, negative days clipped to zero
SELECT customer_id,
       txn_date,
       CASE 
         WHEN running_balance < 0 THEN 0 
         ELSE running_balance 
       END AS daily_balance
FROM (
  SELECT customer_id,
         txn_date,
         SUM(CASE WHEN txn_type = 'deposit'    THEN txn_amount
                  WHEN txn_type = 'withdrawal' THEN -txn_amount
                  ELSE 0 END)
           OVER (PARTITION BY customer_id
                 ORDER BY txn_date
                 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_balance
  FROM customer_transactions
) t
ORDER BY customer_id, txn_date
LIMIT 20;
```

```sql
-- 6. For each day and customer make sure missing days have previous balance.
--    (This uses a recursive calendar to demonstrate the technique.)
WITH
cust_span AS (
  SELECT customer_id,
         MIN(txn_date) AS start_d,
         MAX(txn_date) AS end_d
  FROM customer_transactions
  GROUP BY customer_id
  LIMIT 20      -- only sample 20 customers for inspection
),
calendar AS (
  SELECT customer_id, start_d AS cal_date, end_d
  FROM cust_span
  UNION ALL
  SELECT customer_id,
         date(cal_date,'+1 day'),
         end_d
  FROM calendar
  WHERE cal_date < end_d
),
net_daily AS (
  SELECT customer_id,
         txn_date,
         SUM(CASE WHEN txn_type='deposit' THEN txn_amount
                  WHEN txn_type='withdrawal' THEN -txn_amount
             END) AS net_chg
  FROM customer_transactions
  GROUP BY customer_id, txn_date
)
SELECT c.customer_id,
       c.cal_date,
       COALESCE(net_daily.net_chg,0) AS net_change
FROM calendar c
LEFT JOIN net_daily
       ON net_daily.customer_id = c.customer_id
      AND net_daily.txn_date   = c.cal_date
ORDER BY customer_id, cal_date
LIMIT 20;
```

```sql
-- 7. Attach a running total to the calendar‑filled table (still sample)
WITH
daily_series AS (
  -- (reuse the CTE from query 6 here)
  SELECT customer_id, cal_date, COALESCE(net_change,0) AS net_change
  FROM ( /* same content as netted calendar above */ )
),
balances AS (
  SELECT customer_id,
         cal_date,
         MAX(0,
             SUM(net_change)
             OVER (PARTITION BY customer_id
                   ORDER BY cal_date
                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
         ) AS daily_balance
  FROM daily_series
)
SELECT *
FROM balances
ORDER BY customer_id, cal_date
LIMIT 20;
```

```sql
-- 8. Extract the highest balance each customer hit within each month
WITH balances AS ( /* see query‑7 balances CTE */ )
SELECT customer_id,
       strftime('%Y-%m', cal_date) AS month,
       MAX(daily_balance)          AS max_balance_in_month
FROM balances
GROUP BY customer_id, month
ORDER BY customer_id, month
LIMIT 20;
```

```sql
-- 9. Sum the customers’ peaks to get the company‑wide monthly total
WITH balances AS ( /* see query‑7 balances CTE */ ),
cust_month_max AS (
  SELECT customer_id,
         strftime('%Y-%m', cal_date) AS month,
         MAX(daily_balance)          AS max_balance_in_month
  FROM balances
  GROUP BY customer_id, month
)
SELECT month,
       SUM(max_balance_in_month) AS monthly_peak_total
FROM cust_month_max
GROUP BY month
ORDER BY month
LIMIT 20;
```

```sql
-- 10. Put everything together (no LIMIT now) – final answer query
WITH
daily_net AS (
  SELECT customer_id,
         txn_date,
         SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                  WHEN txn_type='withdrawal' THEN -txn_amount
                  ELSE 0 END) AS net_change
  FROM customer_transactions
  GROUP BY customer_id, txn_date
),
span AS (
  SELECT customer_id, MIN(txn_date) AS start_d, MAX(txn_date) AS end_d
  FROM customer_transactions
  GROUP BY customer_id
),
calendar AS (
  SELECT customer_id, start_d AS cal_date, end_d
  FROM span
  UNION ALL
  SELECT customer_id, date(cal_date,'+1 day'), end_d
  FROM calendar
  WHERE cal_date < end_d
),
series AS (
  SELECT c.customer_id,
         c.cal_date,
         COALESCE(daily_net.net_change,0) AS net_change
  FROM calendar c
  LEFT JOIN daily_net
         ON daily_net.customer_id = c.customer_id
        AND daily_net.txn_date    = c.cal_date
),
balances AS (
  SELECT customer_id,
         cal_date,
         MAX(0,
             SUM(net_change)
             OVER (PARTITION BY customer_id
                   ORDER BY cal_date
                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
         ) AS daily_balance
  FROM series
),
cust_month_max AS (
  SELECT customer_id,
         strftime('%Y-%m', cal_date) AS month,
         MAX(daily_balance)          AS max_balance_in_month
  FROM balances
  GROUP BY customer_id, month
)
SELECT month,
       SUM(max_balance_in_month) AS monthly_peak_total
FROM cust_month_max
GROUP BY month
ORDER BY month;
```

These 10 queries progressively explore the data and culminate in the complete computation of “monthly total of each customer’s highest daily balance,” exactly matching the stated requirement.
