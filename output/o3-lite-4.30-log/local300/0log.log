```sql
--Description:  In a single query this script
--  1. Converts each customer’s transactions to “net change per day”.
--  2. Finds every customer’s first and last‑ever transaction date.
--  3. Recursively produces a full calendar of days for each customer so that
--     days without activity still appear.
--  4. Joins that calendar to the net‑change table, inserting 0 when a customer
--     had no movement on a given date.
--  5. Calculates a running cumulative balance per customer; if the cumulative
--     balance drops below zero, it is floored at 0.
--  6. Determines, for each customer and month, the highest daily balance the
--     customer attained in that month.
--  7. Sums those customer‑monthly peaks to produce the company‑wide monthly
--     total of “highest daily balances”.  The final list is limited to 20 rows
--     for quick inspection.
WITH
-- 1. net movement ( +deposit , −withdrawal ) for every txn date
daily_net AS (
    SELECT
        customer_id,
        txn_date,
        SUM(CASE
                WHEN txn_type = 'deposit'    THEN  txn_amount
                WHEN txn_type = 'withdrawal' THEN -txn_amount
                ELSE 0
            END) AS net_change
    FROM customer_transactions
    GROUP BY customer_id, txn_date
),
-- 2. first and last transaction date per customer
span AS (
    SELECT
        customer_id,
        MIN(txn_date) AS start_d,
        MAX(txn_date) AS end_d
    FROM daily_net
    GROUP BY customer_id
),
-- 3. recursive calendar of every day in each customer’s span
calendar AS (
    SELECT
        customer_id,
        start_d AS cal_date,
        end_d
    FROM span
    UNION ALL
    SELECT
        customer_id,
        DATE(cal_date,'+1 day') AS cal_date,
        end_d
    FROM calendar
    WHERE cal_date < end_d
),
-- 4. attach net_change to every calendar day (missing = 0)
series AS (
    SELECT
        c.customer_id,
        c.cal_date,
        COALESCE(d.net_change,0) AS net_change
    FROM calendar AS c
    LEFT JOIN daily_net AS d
           ON d.customer_id = c.customer_id
          AND d.txn_date    = c.cal_date
),
-- 5. running cumulative balance per customer, negatives floored
balances AS (
    SELECT
        customer_id,
        cal_date,
        MAX(0,
            SUM(net_change) OVER (
                PARTITION BY customer_id
                ORDER BY cal_date
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
            )
        ) AS daily_balance
    FROM series
),
-- 6. customer’s maximum daily balance in each calendar month
cust_month_max AS (
    SELECT
        customer_id,
        STRFTIME('%Y-%m', cal_date) AS month,
        MAX(daily_balance) AS peak_balance
    FROM balances
    GROUP BY customer_id, month
)
-- 7. company‑wide monthly total of those peaks
SELECT
    month,
    SUM(peak_balance) AS monthly_peak_total
FROM cust_month_max
GROUP BY month
ORDER BY month
LIMIT 20;
