--Description:  End‑to‑end solution in a single statement.
-- 1. daily_net      – collapse each customer’s activity into one net figure per day
--                     (+deposit, –withdrawal, 0 otherwise).
-- 2. span           – find every customer’s first and last transaction date.
-- 3. calendar       – recursively generate every calendar day between those two
--                     dates (per customer).  This supplies rows for dates with
--                     no transactions.
-- 4. series         – join calendar to daily_net, substituting 0 where a customer
--                     had no movement on that day.
-- 5. balances       – running cumulative sum of daily changes per customer,
--                     but clip any negative running balance to 0 (MAX(0,…)).
-- 6. cust_month_max – for each customer/month, pick the highest balance
--                     observed during that month.
-- 7. Final SELECT   – sum those per‑customer peaks to return the firm‑wide
--                     monthly total of maximum daily balances.
WITH
daily_net AS (
    SELECT
        ct.customer_id,
        ct.txn_date,
        SUM(
            CASE
                WHEN ct.txn_type = 'deposit'    THEN  ct.txn_amount
                WHEN ct.txn_type = 'withdrawal' THEN -ct.txn_amount
                ELSE 0
            END
        ) AS net_change
    FROM customer_transactions AS ct
    GROUP BY ct.customer_id, ct.txn_date
),
span AS (
    SELECT
        dn.customer_id,
        MIN(dn.txn_date) AS start_d,
        MAX(dn.txn_date) AS end_d
    FROM daily_net AS dn
    GROUP BY dn.customer_id
),
calendar AS (
    SELECT
        sp.customer_id,
        sp.start_d AS cal_date,
        sp.end_d
    FROM span AS sp
    UNION ALL
    SELECT
        cal.customer_id,
        DATE(cal.cal_date,'+1 day') AS cal_date,
        cal.end_d
    FROM calendar AS cal
    WHERE cal.cal_date < cal.end_d
),
series AS (
    SELECT
        cal.customer_id,
        cal.cal_date,
        COALESCE(dn.net_change,0) AS net_change
    FROM calendar AS cal
    LEFT JOIN daily_net AS dn
           ON dn.customer_id = cal.customer_id
          AND dn.txn_date    = cal.cal_date
),
balances AS (
    SELECT
        s.customer_id,
        s.cal_date,
        MAX(0,
            SUM(s.net_change) OVER (
                PARTITION BY s.customer_id
                ORDER BY s.cal_date
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
        ) AS daily_balance
    FROM series AS s
),
cust_month_max AS (
    SELECT
        b.customer_id,
        STRFTIME('%Y-%m', b.cal_date) AS month,
        MAX(b.daily_balance)          AS max_daily_balance
    FROM balances AS b
    GROUP BY b.customer_id, month
)
SELECT
    cmm.month,
    SUM(cmm.max_daily_balance) AS monthly_peak_total
FROM cust_month_max AS cmm
GROUP BY cmm.month
ORDER BY cmm.month;
