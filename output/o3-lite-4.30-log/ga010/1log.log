2025-05-01 03:01:24 - Thread-1145 (execute) - INFO - [Exploration]
Relevant columns and how they can help  

event_date           : filter rows to December 2020 ( '20201201' – '20201231' ).  
event_name           : isolate the ‟session_start” event (one row per GA4 session).  
event_params         : extract the parameter ga_session_id (unique id of every session).  
user_pseudo_id       : when combined with ga_session_id ⇢ one unique session key.  
traffic_source.source: needed for Channel‑group logic (see mapping table).  
traffic_source.medium: needed for Channel‑group logic (see mapping table).  

Typical conditions you’ll use  

event_date BETWEEN '20201201' AND '20201231'  
AND event_name = 'session_start'  

--------------------------------------------------------------------
10 exploratory → final queries
--------------------------------------------------------------------

```sql
--Description: 1) Peek at any December 1st rows just to eyeball the schema.
SELECT *
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
LIMIT 20;
```

```sql
--Description: 2) Which different event types exist during December?
SELECT DISTINCT event_name
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
WHERE event_date BETWEEN '20201201' AND '20201231'
LIMIT 20;
```

```sql
--Description: 3) Daily count of rows whose event_name = 'session_start'.
SELECT event_date, COUNT(*) AS session_start_rows
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
WHERE event_name = 'session_start'
GROUP BY event_date
ORDER BY event_date
LIMIT 20;
```

```sql
--Description: 4) Sample pairs of traffic_source.source / medium we are going to map.
SELECT DISTINCT
       traffic_source.source  AS src,
       traffic_source.medium  AS med
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
WHERE event_name = 'session_start'
LIMIT 20;
```

```sql
--Description: 5) Inspect the event_params array so we can see how ga_session_id is stored.
SELECT
  ep.key,
  ep.value.int_value,
  ep.value.string_value
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`,
     UNNEST(event_params) AS ep
WHERE event_name = 'session_start'
LIMIT 20;
```

```sql
--Description: 6) Pull out the ga_session_id for Dec‑01 to ensure parsing works.
SELECT
  user_pseudo_id,
  ep.value.int_value AS ga_session_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`,
     UNNEST(event_params) AS ep
WHERE event_name = 'session_start'
  AND ep.key = 'ga_session_id'
LIMIT 20;
```

```sql
--Description: 7) Build one session key (user_pseudo_id+ga_session_id) and show 20 examples.
WITH sessions AS (
  SELECT
    user_pseudo_id,
    ep.value.int_value AS ga_session_id,
    traffic_source.source,
    traffic_source.medium
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(event_params) AS ep
  WHERE event_name = 'session_start'
    AND ep.key = 'ga_session_id'
    AND event_date BETWEEN '20201201' AND '20201231'
)
SELECT *
FROM sessions
LIMIT 20;
```

```sql
--Description: 8) Apply the channel‑grouping rules (partial CASE) and preview counts.
WITH sessions AS (
  SELECT
    user_pseudo_id,
    ep.value.int_value AS ga_session_id,
    LOWER(COALESCE(traffic_source.source,''))  AS src,
    LOWER(COALESCE(traffic_source.medium,''))  AS med
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(event_params) AS ep
  WHERE event_name = 'session_start'
    AND ep.key = 'ga_session_id'
    AND event_date BETWEEN '20201201' AND '20201231'
),
chan AS (
  SELECT DISTINCT
    user_pseudo_id,
    ga_session_id,
    CASE
      WHEN src = '(direct)'                AND med IN ('(not set)','(none)')              THEN 'Direct'
      WHEN med IN ('display','banner','expandable','interstitial','cpm')                  THEN 'Display'
      WHEN med = 'affiliate'                                                             THEN 'Affiliates'
      WHEN med = 'referral'                                                              THEN 'Referral'
      WHEN med LIKE '%email%' OR src LIKE '%email%'                                      THEN 'Email'
      -- … (other WHEN branches shortened for brevity) …
      ELSE 'Unassigned'
    END AS channel_group
  FROM sessions
)
SELECT channel_group, COUNT(*) AS sessions
FROM chan
GROUP BY channel_group
ORDER BY sessions DESC
LIMIT 20;
```

```sql
--Description: 9) Rank the channel groups by session count for December‑2020.
WITH sessions AS (
  SELECT
    user_pseudo_id,
    ep.value.int_value AS ga_session_id,
    LOWER(COALESCE(traffic_source.source,''))  AS src,
    LOWER(COALESCE(traffic_source.medium,''))  AS med
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(event_params) AS ep
  WHERE event_name = 'session_start'
    AND ep.key = 'ga_session_id'
    AND event_date BETWEEN '20201201' AND '20201231'
),
chan AS (
  SELECT DISTINCT
    user_pseudo_id,
    ga_session_id,
    CASE
      WHEN src = '(direct)'                AND med IN ('(not set)','(none)')              THEN 'Direct'
      WHEN med IN ('display','banner','expandable','interstitial','cpm')                  THEN 'Display'
      WHEN med = 'affiliate'                                                             THEN 'Affiliates'
      WHEN med = 'referral'                                                              THEN 'Referral'
      WHEN med LIKE '%email%' OR src LIKE '%email%'                                      THEN 'Email'
      -- … (same CASE as previous query) …
      ELSE 'Unassigned'
    END AS channel_group
  FROM sessions
),
ranked AS (
  SELECT channel_group,
         COUNT(*) AS sessions,
         DENSE_RANK() OVER(ORDER BY COUNT(*) DESC) AS rnk
  FROM chan
  GROUP BY channel_group
)
SELECT *
FROM ranked
ORDER BY rnk
LIMIT 20;
```

```sql
--Description: 10) Retrieve the channel that sits in 4ᵗʰ place for December 2020 sessions.
