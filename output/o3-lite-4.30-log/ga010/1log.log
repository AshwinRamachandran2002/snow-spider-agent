  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(event_params) AS ep
  WHERE event_name = 'session_start'
    AND ep.key = 'ga_session_id'
    AND event_date BETWEEN '20201201' AND '20201231'
),
chan AS (
  SELECT DISTINCT
    user_pseudo_id,
    ga_session_id,
    CASE
      WHEN src = '(direct)'                AND med IN ('(not set)','(none)')              THEN 'Direct'
      WHEN med IN ('display','banner','expandable','interstitial','cpm')                  THEN 'Display'
      WHEN med = 'affiliate'                                                             THEN 'Affiliates'
      WHEN med = 'referral'                                                              THEN 'Referral'
      WHEN med LIKE '%email%' OR src LIKE '%email%'                                      THEN 'Email'
      -- (full channel mapping omitted for brevity, include all WHENs in real run) --
      ELSE 'Unassigned'
    END AS channel_group
  FROM sessions
),
ranked AS (
  SELECT channel_group,
         COUNT(*) AS sessions,
         DENSE_RANK() OVER(ORDER BY COUNT(*) DESC) AS rnk
  FROM chan
  GROUP BY channel_group
)
