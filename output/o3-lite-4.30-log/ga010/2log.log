Begin Exploring Related Columns
Relevant columns and their possible use for “sessions by channel in December‑2020”

• event_date : filter to the December 2020 tables (values 20201201 … 20201231).  
• event_params : holds the key = 'ga_session_id'; we need it to identify one GA4 session.  
• user_pseudo_id : a user key that, together with ga_session_id, uniquely identifies a session.  
• traffic_source.medium : medium text used in the Channel‑grouping logic.  
• traffic_source.source : source text used in the Channel‑grouping logic.  
• traffic_source.name (campaign name) : occasionally required by some channel rules.  
• event_name : contains “session_start”; sometimes useful if you want to count only one event per session. (Condition: event_name = 'session_start')  

Typical conditions you will combine  
• event_date BETWEEN '20201201' AND '20201231'  (or simply query the daily tables events_20201201 … events_20201231)  
• event_name = 'session_start'  – optional if you prefer to count a single event per session.  
• ga_session_id IS NOT NULL  – extract from event_params.  

Below are ten exploratory queries (each limited to 20 rows) that gradually build up to “channel with the 4‑th highest number of sessions in December‑2020”.

```sql
-- 1) Peek at any data on 1‑Dec‑2020
SELECT
  event_date,
  event_timestamp,
  event_name,
  user_pseudo_id,
  traffic_source.*
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
LIMIT 20;
```

```sql
-- 2) List the distinct event_param keys so we can verify ga_session_id exists
SELECT DISTINCT ep.key
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`,
     UNNEST(event_params) AS ep
LIMIT 20;
```

```sql
-- 3) Sample ga_session_id values together with user_pseudo_id
SELECT
  user_pseudo_id,
  (SELECT value.int_value
     FROM UNNEST(event_params)
     WHERE key = 'ga_session_id') AS ga_session_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201205`
WHERE ga_session_id IS NOT NULL
LIMIT 20;
```

```sql
-- 4) What “medium” values appear in December‑2020?
SELECT DISTINCT traffic_source.medium
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201210`
LIMIT 20;
```

```sql
-- 5) What “source” values appear in December‑2020?
SELECT DISTINCT traffic_source.source
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201215`
LIMIT 20;
```

```sql
-- 6) Quick session count by SOURCE for a single day (Dec‑18)
SELECT
  traffic_source.source,
  COUNT(DISTINCT CONCAT(user_pseudo_id,'-', 
        (SELECT value.int_value FROM UNNEST(event_params) WHERE key='ga_session_id')
       )) AS sessions
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201218`
GROUP BY traffic_source.source
ORDER BY sessions DESC
LIMIT 20;
```

```sql
-- 7) Same idea but by MEDIUM for a different day (Dec‑21)
SELECT
  traffic_source.medium,
  COUNT(DISTINCT CONCAT(user_pseudo_id,'-', 
        (SELECT value.int_value FROM UNNEST(event_params) WHERE key='ga_session_id')
       )) AS sessions
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201221`
GROUP BY traffic_source.medium
ORDER BY sessions DESC
LIMIT 20;
```

```sql
-- 8) Build a CASE statement to derive a rudimentary Default‑Channel‑Group for one table
SELECT
  CASE
      WHEN LOWER(traffic_source.medium) IN ('display','banner','cpm','interstitial','expandable') THEN 'Display'
      WHEN LOWER(traffic_source.medium) = 'affiliate' THEN 'Affiliates'
      WHEN LOWER(traffic_source.medium) = 'email' OR LOWER(traffic_source.source) = 'email' THEN 'Email'
      WHEN traffic_source.source = '(direct)' AND traffic_source.medium IN ('(not set)','(none)') THEN 'Direct'
      WHEN LOWER(traffic_source.medium) = 'referral' THEN 'Referral'
      ELSE 'Unassigned'
  END AS channel_group,
  COUNT(DISTINCT CONCAT(user_pseudo_id,'-', 
        (SELECT value.int_value FROM UNNEST(event_params) WHERE key='ga_session_id')
       )) AS sessions
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201224`
GROUP BY channel_group
ORDER BY sessions DESC
LIMIT 20;
```

```sql
-- 9) Aggregate all December tables with wildcard and return the ranking of channels
SELECT
  channel_group,
  sessions,
  RANK() OVER (ORDER BY sessions DESC) AS channel_rank
FROM (
  SELECT
    CASE
        WHEN LOWER(traffic_source.medium) IN ('display','banner','cpm','interstitial','expandable') THEN 'Display'
        WHEN LOWER(traffic_source.medium) = 'affiliate' THEN 'Affiliates'
        WHEN LOWER(traffic_source.medium) = 'email' OR LOWER(traffic_source.source) = 'email' THEN 'Email'
        WHEN traffic_source.source = '(direct)' AND traffic_source.medium IN ('(not set)','(none)') THEN 'Direct'
        WHEN LOWER(traffic_source.medium) = 'referral' THEN 'Referral'
        ELSE 'Unassigned'
    END AS channel_group,
    COUNT(DISTINCT CONCAT(user_pseudo_id,'-', 
          (SELECT value.int_value FROM UNNEST(event_params) WHERE key='ga_session_id')
         )) AS sessions
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  GROUP BY channel_group
)
ORDER BY channel_rank
LIMIT 20;
```

```sql
-- 10) Final answer: the 4‑th highest‑session channel in Dec‑2020
SELECT channel_group, sessions
FROM (
  SELECT
    CASE
        WHEN LOWER(traffic_source.medium) IN ('display','banner','cpm','interstitial','expandable') THEN 'Display'
        WHEN LOWER(traffic_source.medium) = 'affiliate' THEN 'Affiliates'
        WHEN LOWER(traffic_source.medium) = 'email' OR LOWER(traffic_source.source) = 'email' THEN 'Email'
        WHEN traffic_source.source = '(direct)' AND traffic_source.medium IN ('(not set)','(none)') THEN 'Direct'
        WHEN LOWER(traffic_source.medium) = 'referral' THEN 'Referral'
        ELSE 'Unassigned'
    END AS channel_group,
    COUNT(DISTINCT CONCAT(user_pseudo_id,'-', 
          (SELECT value.int_value FROM UNNEST(event_params) WHERE key='ga_session_id')
         )) AS sessions
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  GROUP BY channel_group
)
QUALIFY RANK() OVER (ORDER BY sessions DESC) = 4;
```

