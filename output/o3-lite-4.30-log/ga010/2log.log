  SELECT
    CASE
        WHEN LOWER(medium) IN ('display','banner','cpm','interstitial','expandable') THEN 'Display'
        WHEN LOWER(medium) = 'affiliate'  THEN 'Affiliates'
        WHEN LOWER(medium) = 'email' OR LOWER(source) = 'email'               THEN 'Email'
        WHEN source = '(direct)' AND medium IN ('(not set)', '(none)')        THEN 'Direct'
        WHEN LOWER(medium) = 'referral'                                       THEN 'Referral'
        ELSE 'Unassigned'
    END AS channel_group,
    COUNT(DISTINCT CONCAT(user_pseudo_id,'-', ga_session_id)) AS sessions
  FROM dec_sessions
  WHERE ga_session_id IS NOT NULL
  GROUP BY channel_group
)
