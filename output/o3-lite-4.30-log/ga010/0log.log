--Description: 6) Distinct combinations of Source / Medium for all December‑2020
--              session_start hits.  Uses two correlated scalar sub‑queries to
--              read the `source` and `medium` keys – avoids any duplicate‑offset
--              issue because UNNEST is executed only inside the sub‑selects.
WITH params AS (
  SELECT
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'source') AS source,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'medium') AS medium
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE event_name = 'session_start'
)
SELECT DISTINCT source, medium
FROM params
LIMIT 20
