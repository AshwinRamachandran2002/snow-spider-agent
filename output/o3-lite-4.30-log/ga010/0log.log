           AND med NOT LIKE '%paid%' AND med NOT LIKE '%cp%' AND med NOT LIKE '%ppc%'       THEN 'Organic Social'
      WHEN REGEXP_CONTAINS(src, '(dailymotion|disneyplus|netflix|youtube|vimeo|twitch)')
