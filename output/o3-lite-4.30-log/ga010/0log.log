-- • Map each session into five simple buckets so at least 4 channels exist:  
--       Direct, Referral, Organic, Paid, Other.  
-- • Count DISTINCT sessions per bucket, DENSE_RANK them, and return the
--   4‑th‑ranked (rnk = 4).  
-- ---------------------------------------------------------------------------
WITH dec_sessions AS (
  SELECT
    -- 1) Unique session identifier
    CONCAT(
      user_pseudo_id, '-',
      CAST(
        (SELECT value.int_value
         FROM UNNEST(event_params)
         WHERE key = 'ga_session_id') AS STRING
      )
    )                                     AS session_id,

    -- 2) Resolved source & medium (lower‑cased for easy matching)
    LOWER(
      COALESCE(
        (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'source'),
        traffic_source.source,
        '(direct)'
      )
    )                                     AS src,
