```sql
--Description:
-- THINKING PROCESS -----------------------------------------------------------
-- • Objective: inspect 20 sessions that started on 5‑Dec‑2020 and display the
--   Source / Medium attached to each session_start hit.
-- • Problem in the former attempt: UNNEST() was done twice, and BigQuery gave a
--   “Duplicate alias offset” error because each UNNEST automatically produces an
--   OFFSET column with the same name.
-- • Remedy: UNNEST the array only once and pivot its contents with conditional
--   aggregation (MAX + IF) so we can pull both key/value pairs in one pass.
-- • Outcome: one row per session_start event, safe from alias conflicts.
-- ---------------------------------------------------------------------------
SELECT
  user_pseudo_id,
  MAX(IF(ep.key = 'source', ep.value.string_value, NULL)) AS source,
  MAX(IF(ep.key = 'medium', ep.value.string_value, NULL)) AS medium
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201205`,
UNNEST(event_params) AS ep
WHERE event_name = 'session_start'
GROUP BY user_pseudo_id, event_timestamp
LIMIT 20;
