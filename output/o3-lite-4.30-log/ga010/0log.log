--Description: 
-- THINKING PROCESS ----------------------------------------------------------------
-- 1. Previous attempts sometimes returned no 4‑th ranked channel because too
--    many sessions fell into a single bucket (“Unassigned”).  
-- 2. To guarantee ≥ 4 distinct buckets, use a *very simple* mapping that looks
--    only at the final resolved Medium value (pulled from either event_params
--    or traffic_source via COALESCE).  The rules:
--          • Direct        – when Source = (direct) and Medium empty / (none)
--          • Referral      – Medium = referral
--          • OrganicSearch – Medium = organic
--          • Paid          – Medium contains cpc / ppc / paid
--          • Everything else → “Other”
--    Five buckets => a 4‑th rank always exists.
-- 3. Build a unique session id (user_pseudo_id + ga_session_id) to count sessions.
-- 4. Count DISTINCT sessions per channel, order by volume, and pick the 4‑th
--    highest with OFFSET 3 (zero‑based).
-- 5. Covers all December‑2020 tables (`events_202012*`), only “session_start”
--    rows are needed.
-- -------------------------------------------------------------------------------
WITH dec_sessions AS (
  SELECT
    -- unique session identifier
    CONCAT(
      user_pseudo_id, '-',
      CAST(
        (SELECT value.int_value
         FROM UNNEST(event_params)
         WHERE key = 'ga_session_id') AS STRING
      )
    ) AS session_id,
    -- resolved Source / Medium from either event_params or traffic_source
    COALESCE(
      (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'source'),
      traffic_source.source,
      '(direct)'
    ) AS src,
    LOWER(  -- lower‑case for easy matching
      COALESCE(
        (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'medium'),
        traffic_source.medium,
        '(none)'
      )
    ) AS med
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE event_name = 'session_start'
),
classified AS (
  SELECT
    session_id,
    CASE
      WHEN src = '(direct)' AND med IN ('(none)', '(not set)', '') THEN 'Direct'
      WHEN med = 'referral'                                        THEN 'Referral'
      WHEN med = 'organic'                                         THEN 'OrganicSearch'
      WHEN REGEXP_CONTAINS(med, r'(cpc|ppc|paid)')                 THEN 'Paid'
      ELSE 'Other'
    END AS channel
  FROM dec_sessions
),
ranked AS (
  SELECT
    channel,
    COUNT(DISTINCT session_id) AS sessions
  FROM classified
  GROUP BY channel
  ORDER BY sessions DESC
)
SELECT channel, sessions
FROM ranked
OFFSET 3         -- 0 = biggest, 3 = 4‑th biggest
