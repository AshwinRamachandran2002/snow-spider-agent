2025-05-01 01:01:32 - Thread-167 (execute) - INFO - [Exploration]
Relevant columns and their potential usage for finding package names inside a “require”‑like JSON section  

• GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  
  – "sample_path": filter for files that usually carry dependency declarations (e.g. composer.json, package.json, bower.json, etc.).  
  – "content": full text of each file – use PARSE_JSON() ➜ locate the “require”, “dependencies”, or similar objects.  
  – "sample_repo_name": optional context, lets you know which repository the file belongs to.  

Typical conditions you will use  
• "sample_path" ILIKE '%composer.json%'                   -- PHP/Composer projects  
• "sample_path" ILIKE '%package.json%'                    -- NodeJS/NPM projects  
• "sample_path" ILIKE '%bower.json%'                      -- Bower dependencies  
• PARSE_JSON("content"):require IS NOT NULL               -- keep rows whose JSON has a “require” section  
• f.key NOT ILIKE '%php'                                  -- remove platform entries when needed (example Composer)  

Below are ten exploratory Snowflake SQL queries (LIMIT 20 each) that gradually move from simple inspection toward counting the package names.  
Make sure to replace … with the proper warehouse / role in your session before running.

```sql
-- 1. Description: Show 20 composer.json files and their raw text
SELECT 
    "sample_repo_name",
    "sample_path",
    "content"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE "sample_path" ILIKE '%composer.json%'
LIMIT 20;
```

```sql
-- 2. Description: Preview the parsed “require” object for those composer.json files
SELECT 
    "sample_repo_name",
    "sample_path",
    PARSE_JSON("content"):require AS "require_object"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE "sample_path" ILIKE '%composer.json%'
LIMIT 20;
```

```sql
-- 3. Description: List each individual package found in the “require” section (one row per package) for composer.json
SELECT 
    "sample_repo_name",
    "sample_path",
    f.key     AS "package_name",
    f.value   AS "required_version"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  t,
     LATERAL FLATTEN(input => PARSE_JSON(t."content"):require) f
WHERE t."sample_path" ILIKE '%composer.json%'
LIMIT 20;
```

```sql
-- 4. Description: Count how often every package appears in composer.json require sections
SELECT 
    f.key                       AS "package_name",
    COUNT(*)                    AS "frequency"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  t,
     LATERAL FLATTEN(input => PARSE_JSON(t."content"):require) f
WHERE t."sample_path" ILIKE '%composer.json%'
GROUP BY f.key
ORDER BY "frequency" DESC
LIMIT 20;
```

```sql
-- 5. Description: Same as #4 but ignore platform packages that start with "php"
SELECT 
    f.key                       AS "package_name",
    COUNT(*)                    AS "frequency"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  t,
     LATERAL FLATTEN(input => PARSE_JSON(t."content"):require) f
WHERE t."sample_path" ILIKE '%composer.json%'
  AND f.key NOT ILIKE 'php%'
GROUP BY f.key
ORDER BY "frequency" DESC
LIMIT 20;
```

```sql
-- 6. Description: Inspect package.json files (NodeJS) – raw dependencies object
SELECT 
    "sample_repo_name",
    "sample_path",
    PARSE_JSON("content"):dependencies AS "dependencies"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE "sample_path" ILIKE '%package.json%'
LIMIT 20;
```

```sql
-- 7. Description: Flatten dependencies from package.json and list each package / version
SELECT 
    "sample_repo_name",
    f.key   AS "package_name",
    f.value AS "required_version"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
     LATERAL FLATTEN(input => PARSE_JSON(t."content"):dependencies) f
WHERE t."sample_path" ILIKE '%package.json%'
LIMIT 20;
```

```sql
-- 8. Description: Combined frequency count from both composer.json and package.json files
WITH deps AS (
    SELECT f.key AS pkg
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
         LATERAL FLATTEN(input => PARSE_JSON(t."content"):require) f
    WHERE t."sample_path" ILIKE '%composer.json%'
    UNION ALL
    SELECT f.key AS pkg
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
         LATERAL FLATTEN(input => PARSE_JSON(t."content"):dependencies) f
    WHERE t."sample_path" ILIKE '%package.json%'
)
SELECT 
    pkg AS "package_name",
    COUNT(*) AS "frequency"
FROM deps
GROUP BY pkg
ORDER BY "frequency" DESC
LIMIT 20;
```

```sql
-- 9. Description: Show the top 20 repositories that depend on “laravel/framework” in any require block
SELECT 
    "sample_repo_name",
    "sample_path"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
     LATERAL FLATTEN(input => PARSE_JSON(t."content"):require) f
WHERE t."sample_path" ILIKE '%composer.json%'
  AND f.key = 'laravel/framework'
LIMIT 20;
```

```sql
--10. Description: For NodeJS, count devDependencies + dependencies together per package
WITH node_pkgs AS (
    SELECT f.key AS pkg
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
         LATERAL FLATTEN(input => PARSE_JSON(t."content"):dependencies) f
    WHERE t."sample_path" ILIKE '%package.json%'
    UNION ALL
    SELECT f.key
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
         LATERAL FLATTEN(input => PARSE_JSON(t."content"):devDependencies) f
    WHERE t."sample_path" ILIKE '%package.json%'
)
SELECT 
    pkg AS "package_name",
    COUNT(*) AS "frequency"
FROM node_pkgs
GROUP BY pkg
ORDER BY "frequency" DESC
LIMIT 20;
```
