```sql
--Description / Thinking process:
-- Goal: count how many times each Composer package is referenced anywhere in a repo’s
--       composer.json, whether inside "require" or "require-dev".
-- Problem we hit earlier: OBJECT_AGG needs exactly one key/value pair per call, so
--       merging two different objects in a single OBJECT_AGG invocation caused
--       “too many arguments” error.
-- Fix:   (1) Extract keys from "require"
--        (2) Extract keys from "require-dev"
--        (3) UNION ALL the two sets so every package name becomes one row
--        (4) GROUP BY package name to count total mentions
-- Filters: only non‑binary blobs, file path contains composer.json.
-- Output: top 20 packages by frequency.
SELECT
    deps."package_name",
    COUNT(*) AS "total_mentions"
FROM
(
    /* (1) packages in "require" */
    SELECT
        dep.key::STRING AS "package_name"
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
         LATERAL FLATTEN(INPUT => PARSE_JSON(t."content"):"require") dep
    WHERE t."sample_path" ILIKE '%composer.json%'
      AND t."binary" = FALSE

    UNION ALL

    /* (2) packages in "require-dev" */
    SELECT
        dep.key::STRING AS "package_name"
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
         LATERAL FLATTEN(INPUT => PARSE_JSON(t."content"):"require-dev") dep
    WHERE t."sample_path" ILIKE '%composer.json%'
      AND t."binary" = FALSE
) deps
GROUP BY deps."package_name"
ORDER BY "total_mentions" DESC
LIMIT 20;
```
