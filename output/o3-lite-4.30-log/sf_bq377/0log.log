    WHERE t."sample_path" ILIKE '%composer.json%'
      AND t."binary" = FALSE

    UNION ALL

    /* (2) packages in "require-dev" */
    SELECT
        dep.key::STRING AS "package_name"
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
         LATERAL FLATTEN(INPUT => PARSE_JSON(t."content"):"require-dev") dep
    WHERE t."sample_path" ILIKE '%composer.json%'
      AND t."binary" = FALSE
) deps
GROUP BY deps."package_name"
ORDER BY "total_mentions" DESC
LIMIT 20;
