Query:
--Description / Thinking process:
-- Produce a frequency table of package names that appear in the "require" section
-- of composer.json files.  We cast the JSON key to STRING, alias it as "package_name",
-- then GROUP BY that alias so aggregation works on the string value.  Finally,
-- return the top 20 packages by occurrence count.
SELECT
  r.key::STRING AS "package_name",
  COUNT(*)      AS "frequency"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
     LATERAL FLATTEN(INPUT => PARSE_JSON(t."content"):"require") r
WHERE t."sample_path" ILIKE '%composer.json%'
  AND t."binary" = FALSE
GROUP BY "package_name"
ORDER BY "frequency" DESC
LIMIT 20
