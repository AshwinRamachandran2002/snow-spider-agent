Column name: date Type: DATE Description: Date as DATE - CAST('2000-12-31' AS DATE); [1582-10-15, 2199-12-31]
Column name: date_str Type: STRING Description: Date as STRING - '20001231'
Column name: date_int Type: INT64 Description: Date as INTEGER - 20001231
