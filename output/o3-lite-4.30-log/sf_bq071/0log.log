```

```sql
--Description: 5) Build a GEOGRAPHY point for each hurricane (preview only).
SELECT "sid",
       ST_MAKEPOINT("longitude", "latitude") AS "pt_geog"
FROM "NOAA_DATA_PLUS"."NOAA_HURRICANES"."HURRICANES"
WHERE "latitude" IS NOT NULL 
  AND "longitude" IS NOT NULL
