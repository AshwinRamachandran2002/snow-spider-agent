```sql
--Description / Thinking process:
-- 1. Tables involved
--      a) GEO_US_BOUNDARIES.ZIP_CODES  – gives ZIP polygon ("zip_code_geom"), "city", "zip_code", "state_code".
--      b) NOAA_HURRICANES.HURRICANES   – gives storm centre coordinates ("latitude","longitude") and "name".
-- 2. Filter out unnamed storms (TRIM(name) <> '').
-- 3. Turn every hurricane position into a GEOGRAPHY point with ST_MAKEPOINT.
-- 4. Convert each ZIP polygon (stored as WKB BINARY) into GEOGRAPHY via TO_GEOGRAPHY.
-- 5. Spatial join with ST_WITHIN(point, polygon) to keep hurricane points that fall inside the ZIP.
-- 6. Aggregate by city / zip / state:
--      • COUNT(DISTINCT name) as hurricane_count
--      • LISTAGG(DISTINCT name, ', ') WITHIN GROUP (ORDER BY name) as hurricane_list
-- 7. Order results by hurricane_count descending (highest first).
SELECT
    z."city",
    z."zip_code",
    z."state_code"                                         AS "state",
    COUNT(DISTINCT h."name")                               AS "hurricane_count",
    LISTAGG(DISTINCT h."name", ', ')
        WITHIN GROUP (ORDER BY h."name")                   AS "hurricane_list"
FROM "NOAA_DATA_PLUS"."GEO_US_BOUNDARIES"."ZIP_CODES"   z
JOIN "NOAA_DATA_PLUS"."NOAA_HURRICANES"."HURRICANES"    h
  ON ST_WITHIN(
         ST_MAKEPOINT(h."longitude", h."latitude"),
         TO_GEOGRAPHY(z."zip_code_geom")
     )
WHERE TRIM(h."name") <> ''                                -- exclude unnamed storms
GROUP BY z."city", z."zip_code", z."state_code"
ORDER BY "hurricane_count" DESC;
```
