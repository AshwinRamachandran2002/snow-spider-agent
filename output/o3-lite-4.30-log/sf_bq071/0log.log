```

```sql
--Description: 6) Test ST_WITHIN on one random ZIP to confirm geometry works.
SELECT h."sid", h."name", z."zip_code", 
       ST_WITHIN(ST_MAKEPOINT(h."longitude", h."latitude"), z."zip_code_geom") AS "inside_zip"
FROM "NOAA_DATA_PLUS"."NOAA_HURRICANES"."HURRICANES" h
CROSS JOIN (
