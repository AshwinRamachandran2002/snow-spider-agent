```sql
--Description: Create a ZIP‑code‑level summary of distinct, named hurricanes that passed
--             inside each ZIP polygon.  The query (i) fixes longitudes reported in
--             0‑360° format by translating values >180° into the canonical −180‑180°
--             range, (ii) builds GEOGRAPHY points for storm positions, (iii) applies
--             ST_WITHIN to test containment by each ZIP polygon, (iv) excludes unnamed
--             storms, and (v) aggregates per city‑ZIP‑state with a count and an
--             alphabetical, comma‑separated list of hurricane names.  Results are
--             ordered by the hurricane count in descending order.
SELECT
    z."city",
    z."zip_code",
    z."state_code"                                             AS "state",
    COUNT(DISTINCT h."name")                                   AS "hurricane_count",
    LISTAGG(DISTINCT h."name", ', ')
        WITHIN GROUP (ORDER BY h."name")                       AS "hurricane_list"
FROM "NOAA_DATA_PLUS"."GEO_US_BOUNDARIES"."ZIP_CODES"     z
JOIN "NOAA_DATA_PLUS"."NOAA_HURRICANES"."HURRICANES"       h
  ON ST_WITHIN(
         ST_MAKEPOINT(
             CASE
                 WHEN h."longitude" >  180 THEN h."longitude" - 360
                 WHEN h."longitude" < -180 THEN h."longitude" + 360
                 ELSE h."longitude"
             END,
             h."latitude"
         ),
         TO_GEOGRAPHY(z."zip_code_geom")
     )
WHERE h."name" IS NOT NULL
  AND TRIM(h."name") <> ''                -- exclude unnamed storms
  AND h."latitude" BETWEEN -90 AND 90
  AND h."longitude" BETWEEN -360 AND 360
GROUP BY z."city", z."zip_code", z."state_code"
ORDER BY "hurricane_count" DESC;
```
