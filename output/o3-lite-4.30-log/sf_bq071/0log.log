SELECT COUNT(*) AS "points_in_any_zip"
FROM "NOAA_DATA_PLUS"."NOAA_HURRICANES"."HURRICANES" h
JOIN "NOAA_DATA_PLUS"."GEO_US_BOUNDARIES"."ZIP_CODES" z
  ON ST_WITHIN(ST_MAKEPOINT(h."longitude", h."latitude"), z."zip_code_geom")
WHERE TRIM(h."name") <> '';
```

```sql
--Description: 8) Count named hurricanes for each (city, zip) combination.
SELECT z."city", z."zip_code", COUNT(*) AS "hurricane_points"
FROM "NOAA_DATA_PLUS"."GEO_US_BOUNDARIES"."ZIP_CODES" z
JOIN "NOAA_DATA_PLUS"."NOAA_HURRICANES"."HURRICANES" h
  ON ST_WITHIN(ST_MAKEPOINT(h."longitude", h."latitude"), z."zip_code_geom")
WHERE TRIM(h."name") <> ''
GROUP BY z."city", z."zip_code"
ORDER BY "hurricane_points" DESC
LIMIT 20;
