```sql
--Description:  For every ZIP code in the U.S. boundaries table, count how many
--              distinct named hurricanes had a reported centre located inside
--              that ZIP polygon, after (i) normalising longitudes from 0‑360° to
--              the standard −180‑180° range, (ii) converting storm positions to
--              GEOGRAPHY points, and (iii) excluding unnamed storms.  Then build
--              an alphabetical comma‑separated list of those hurricane names.
--              Results are grouped by city, ZIP, and state, sorted by the count
--              in descending order, and limited to the 20 ZIP codes with the
--              highest hurricane counts.
SELECT
    z."city",
    z."zip_code",
    z."state_code",
    COUNT(DISTINCT h."name")                                   AS "hurricane_count",
    LISTAGG(DISTINCT h."name", ', ')
        WITHIN GROUP (ORDER BY h."name")                       AS "hurricane_list"
FROM "NOAA_DATA_PLUS"."GEO_US_BOUNDARIES"."ZIP_CODES" z
JOIN "NOAA_DATA_PLUS"."NOAA_HURRICANES"."HURRICANES"   h
  ON ST_WITHIN(
         ST_MAKEPOINT(
             CASE
                 WHEN h."longitude" >  180 THEN h."longitude" - 360
                 WHEN h."longitude" < -180 THEN h."longitude" + 360
                 ELSE h."longitude"
             END,
             h."latitude"
         ),
         TO_GEOGRAPHY(z."zip_code_geom")
     )
WHERE TRIM(h."name") <> ''                     -- exclude unnamed storms
  AND h."latitude"  BETWEEN -90  AND 90
  AND h."longitude" BETWEEN -360 AND 360
GROUP BY z."city", z."zip_code", z."state_code"
ORDER BY "hurricane_count" DESC
LIMIT 20;
```
