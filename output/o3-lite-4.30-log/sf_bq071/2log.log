    ARRAY_TO_STRING( ARRAY_SORT( ARRAY_AGG(DISTINCT h."name") ), ', ' ) AS "hurricane_list"
FROM "NOAA_DATA_PLUS"."NOAA_HURRICANES"."HURRICANES" h
JOIN "NOAA_DATA_PLUS"."GEO_US_BOUNDARIES"."ZIP_CODES" z
  ON ST_WITHIN(ST_POINT(h."longitude", h."latitude"), z."zip_code_geom")
WHERE h."name" IS NOT NULL AND TRIM(h."name") <> ''
GROUP BY z."zip_code", z."city", z."state_code"
LIMIT 20;
