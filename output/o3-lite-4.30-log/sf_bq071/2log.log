    ARRAY_TO_STRING( ARRAY_SORT( ARRAY_AGG(DISTINCT h."name") ), ', ' ) AS "hurricane_names"
FROM "NOAA_DATA_PLUS"."NOAA_HURRICANES"."HURRICANES" h
