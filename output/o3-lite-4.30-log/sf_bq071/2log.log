```sql
--Description: A few hurricane rows carry invalid coordinates (longitude outside −180..180 or latitude outside −90..90).
--             ST_POINT fails on those rows, so we first filter them out.  We also exclude unnamed storms.
--             After that, we cast the ZIP‑code WKB polygon to GEOGRAPHY with TO_GEOGRAPHY, then use ST_WITHIN
--             to check whether each (valid) hurricane point falls inside a ZIP polygon.  Return 20 sample matches.
SELECT
    h."sid",
    h."name",
    z."zip_code",
    z."city",
    z."state_code"
FROM "NOAA_DATA_PLUS"."NOAA_HURRICANES"."HURRICANES" h
JOIN "NOAA_DATA_PLUS"."GEO_US_BOUNDARIES"."ZIP_CODES" z
  ON ST_WITHIN(
       ST_POINT(h."longitude", h."latitude"),
       TO_GEOGRAPHY(z."zip_code_geom")
     )
WHERE h."name" IS NOT NULL
  AND TRIM(h."name") <> ''
  AND h."longitude" BETWEEN -180 AND 180
  AND h."latitude"  BETWEEN  -90 AND  90
LIMIT 20;
```
