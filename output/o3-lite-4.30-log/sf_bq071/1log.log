JOIN NOAA_DATA_PLUS.GEO_US_BOUNDARIES.ZIP_CODES AS ZIP
      ON ZIP."zip_code" = '33109'
WHERE ST_WITHIN(
        ST_MAKEPOINT(HUR."longitude", HUR."latitude"),   -- hurricane position
        TO_GEOGRAPHY(ZIP."zip_code_geom")                -- ZIP boundary
