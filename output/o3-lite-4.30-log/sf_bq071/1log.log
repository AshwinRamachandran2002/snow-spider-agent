    "zip_code",
    "state_code",
    "area_land_meters"
FROM NOAA_DATA_PLUS.GEO_US_BOUNDARIES.ZIP_CODES
LIMIT 20;
```

```sql
-- 2. Description: List distinct hurricane names (excluding blanks) for a quick look
SELECT DISTINCT 
    "name"
FROM NOAA_DATA_PLUS.NOAA_HURRICANES.HURRICANES
WHERE "name" IS NOT NULL
  AND TRIM("name") <> ''
LIMIT 20;
```

```sql
-- 3. Description: Show sample hurricane fixes with lat/lon and name
SELECT 
    "sid",
    "name",
    "latitude",
    "longitude",
    "iso_time"
FROM NOAA_DATA_PLUS.NOAA_HURRICANES.HURRICANES
WHERE "latitude" IS NOT NULL
  AND "longitude" IS NOT NULL
LIMIT 20;
```

```sql
-- 4. Description: Verify that a point geometry can be built from lat/lon
SELECT 
    "sid",
    ST_ASWKT( ST_MAKEPOINT("longitude", "latitude") ) AS "wkt_point"
FROM NOAA_DATA_PLUS.NOAA_HURRICANES.HURRICANES
WHERE "latitude" IS NOT NULL
  AND "longitude" IS NOT NULL
LIMIT 20;
```

```sql
-- 5. Description: Count how many hurricane fixes fall inside an arbitrary ZIP (e.g., 33109, Miami Beach)
SELECT 
    COUNT(*) AS "fixes_inside_zip"
FROM NOAA_DATA_PLUS.NOAA_HURRICANES.HURRICANES HUR
JOIN NOAA_DATA_PLUS.GEO_US_BOUNDARIES.ZIP_CODES ZIP
      ON ZIP."zip_code" = '33109'
WHERE ST_WITHIN( ST_MAKEPOINT(HUR."longitude", HUR."latitude"), ZIP."zip_code_geom" )
LIMIT 20;
```

```sql
-- 6. Description: Retrieve distinct storm IDs that ever entered ZIP 33109 (still limited)
SELECT DISTINCT 
    HUR."sid",
    HUR."name"
FROM NOAA_DATA_PLUS.NOAA_HURRICANES.HURRICANES HUR
JOIN NOAA_DATA_PLUS.GEO_US_BOUNDARIES.ZIP_CODES ZIP
      ON ZIP."zip_code" = '33109'
WHERE ST_WITHIN( ST_MAKEPOINT(HUR."longitude", HUR."latitude"), ZIP."zip_code_geom" )
  AND TRIM(HUR."name") <> ''
LIMIT 20;
```

```sql
-- 7. Description: Aggregate number of unique storms by ZIP for the whole state of Florida (sample)
SELECT 
    ZIP."city",
    ZIP."zip_code",
    COUNT(DISTINCT HUR."sid") AS "hurricane_cnt"
FROM NOAA_DATA_PLUS.GEO_US_BOUNDARIES.ZIP_CODES ZIP
LEFT JOIN NOAA_DATA_PLUS.NOAA_HURRICANES.HURRICANES HUR
       ON ST_WITHIN( ST_MAKEPOINT(HUR."longitude", HUR."latitude"), ZIP."zip_code_geom" )
      AND TRIM(HUR."name") <> ''
WHERE ZIP."state_code" = 'FL'
GROUP BY ZIP."city", ZIP."zip_code"
ORDER BY "hurricane_cnt" DESC
LIMIT 20;
```

```sql
-- 8. Description: Same as #7 but also list the comma‑separated storm names
SELECT 
    ZIP."city",
    ZIP."zip_code",
    COUNT(DISTINCT HUR."sid")                AS "hurricane_cnt",
    LISTAGG(DISTINCT HUR."name", ', ' ) 
        WITHIN GROUP (ORDER BY HUR."name")   AS "hurricanes"
FROM NOAA_DATA_PLUS.GEO_US_BOUNDARIES.ZIP_CODES ZIP
LEFT JOIN NOAA_DATA_PLUS.NOAA_HURRICANES.HURRICANES HUR
       ON ST_WITHIN( ST_MAKEPOINT(HUR."longitude", HUR."latitude"), ZIP."zip_code_geom" )
      AND TRIM(HUR."name") <> ''
WHERE ZIP."state_code" = 'FL'
GROUP BY ZIP."city", ZIP."zip_code"
ORDER BY "hurricane_cnt" DESC
LIMIT 20;
```

```sql
-- 9. Description: Preview top ZIP codes nationwide by hurricane count
SELECT 
    ZIP."city",
    ZIP."zip_code",
    ZIP."state_code",
    COUNT(DISTINCT HUR."sid") AS "hurricane_cnt"
FROM NOAA_DATA_PLUS.GEO_US_BOUNDARIES.ZIP_CODES ZIP
JOIN NOAA_DATA_PLUS.NOAA_HURRICANES.HURRICANES HUR
     ON ST_WITHIN( ST_MAKEPOINT(HUR."longitude", HUR."latitude"), ZIP."zip_code_geom" )
    AND TRIM(HUR."name") <> ''
GROUP BY ZIP."city", ZIP."zip_code", ZIP."state_code"
ORDER BY "hurricane_cnt" DESC
LIMIT 20;
```

```sql
-- 10. Description: Full query template that would ultimately satisfy the task (nation‑wide, final form)
SELECT
    ZIP."city",
    ZIP."zip_code",
    ZIP."state_code"                         AS "state",
    COUNT(DISTINCT HUR."sid")                AS "hurricane_cnt",
    LISTAGG(DISTINCT HUR."name", ', ') 
        WITHIN GROUP (ORDER BY HUR."name")   AS "hurricanes"
FROM NOAA_DATA_PLUS.GEO_US_BOUNDARIES.ZIP_CODES ZIP
JOIN NOAA_DATA_PLUS.NOAA_HURRICANES.HURRICANES HUR
     ON ST_WITHIN( ST_MAKEPOINT(HUR."longitude", HUR."latitude"), ZIP."zip_code_geom" )
    AND TRIM(HUR."name") <> ''
    AND UPPER(TRIM(HUR."name")) <> 'UNNAMED'
GROUP BY ZIP."city", ZIP."zip_code", ZIP."state_code"
ORDER BY "hurricane_cnt" DESC
LIMIT 20;
```

These ten queries move from simple column inspections to building the essential spatial join, counting unique storms, collecting hurricane names, and finally presenting the full answer layout—while still capping each result set at 20 rows for exploration purposes.
