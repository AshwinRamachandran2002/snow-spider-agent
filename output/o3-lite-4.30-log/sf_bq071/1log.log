    COUNT(DISTINCT HUR."sid")                AS "hurricane_cnt",
    LISTAGG(DISTINCT HUR."name", ', ')
        WITHIN GROUP (ORDER BY HUR."name")   AS "hurricanes"
FROM NOAA_DATA_PLUS.GEO_US_BOUNDARIES.ZIP_CODES     AS ZIP
JOIN NOAA_DATA_PLUS.NOAA_HURRICANES.HURRICANES      AS HUR
     ON HUR."longitude" BETWEEN -180 AND 180
    AND HUR."latitude"  BETWEEN  -90 AND  90
    AND ST_DWITHIN(
          ST_MAKEPOINT(HUR."longitude", HUR."latitude"),
          TO_GEOGRAPHY(ZIP."zip_code_geom"),
          50000
        )
    AND TRIM(HUR."name") <> ''
    AND UPPER(TRIM(HUR."name")) <> 'UNNAMED'
GROUP BY ZIP."city", ZIP."zip_code", ZIP."state_code"
ORDER BY "hurricane_cnt" DESC
LIMIT 20
