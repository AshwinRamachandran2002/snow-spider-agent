--Description: Previous attempts returned no rows when requiring the storm centre to be
--strictly inside ZIP 33109.  To capture nearby passages, look for hurricane fixes whose
--locations are within 50 km (50 000 m) of the ZIP‑code polygon using ST_DWITHIN.
--Steps:
-- 1) Filter out fixes with impossible coordinates (lon outside −180..180 or lat outside −90..90).
-- 2) Convert the ZIP WKB binary to GEOGRAPHY (TO_GEOGRAPHY) so it is comparable with the
--    GEOGRAPHY point from ST_MAKEPOINT.
-- 3) Apply ST_DWITHIN with a 50 000 m radius and return distinct storm IDs and names.
SELECT DISTINCT
       HUR."sid",
       HUR."name"
FROM NOAA_DATA_PLUS.NOAA_HURRICANES.HURRICANES  AS HUR
JOIN NOAA_DATA_PLUS.GEO_US_BOUNDARIES.ZIP_CODES AS ZIP
      ON ZIP."zip_code" = '33109'
WHERE HUR."longitude" BETWEEN -180 AND 180
  AND HUR."latitude"  BETWEEN  -90 AND  90
  AND ST_DWITHIN(
        ST_MAKEPOINT(HUR."longitude", HUR."latitude"),   -- hurricane fix (GEOGRAPHY)
        TO_GEOGRAPHY(ZIP."zip_code_geom"),               -- ZIP boundary (GEOGRAPHY)
        50000                                            -- distance threshold in metres
      )
LIMIT 20;
