Query:
--Description: Aggregate the number of unique storms that passed within 50 km of every Florida
--ZIP‑code polygon.  Uses a LEFT JOIN so ZIPs with zero storms still appear.  The join keeps hurricane
--fixes whose coordinates are valid and whose positions lie within 50 000 m of the ZIP boundary
--(ST_DWITHIN with TO_GEOGRAPHY).  Blank storm names are ignored.
SELECT
    ZIP."city",
    ZIP."zip_code",
    COUNT(DISTINCT HUR."sid") AS "hurricane_cnt"
FROM NOAA_DATA_PLUS.GEO_US_BOUNDARIES.ZIP_CODES           AS ZIP
LEFT JOIN NOAA_DATA_PLUS.NOAA_HURRICANES.HURRICANES       AS HUR
       ON HUR."longitude" BETWEEN -180 AND 180
      AND HUR."latitude"  BETWEEN  -90 AND  90
      AND ST_DWITHIN(
            ST_MAKEPOINT(HUR."longitude", HUR."latitude"),
            TO_GEOGRAPHY(ZIP."zip_code_geom"),
            50000          -- 50 km buffer
          )
      AND TRIM(HUR."name") <> ''
WHERE ZIP."state_code" = 'FL'
GROUP BY ZIP."city", ZIP."zip_code"
ORDER BY "hurricane_cnt" DESC
LIMIT 20
