),
best_per_user AS (
  SELECT 
    m."PostUserId",
    MAX(s."MessageScore") AS "BestMessageScore"
  FROM scores              s
  JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGES" m
