Ten exploratory Snowflake SQL snippets (each returns ≤ 20 rows)

```sql
--Description: 1) All push‑notification SEND events within the 1‑hour window
SELECT *
FROM "BRAZE_USER_EVENT_DEMO_DATASET"."PUBLIC"."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
WHERE "TIME" >= 1685635200
  AND "TIME" < 1685638800
LIMIT 20;
```

```sql
--Description: 2) Distinct users who received a push in that window
SELECT DISTINCT "USER_ID"
FROM "BRAZE_USER_EVENT_DEMO_DATASET"."PUBLIC"."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
WHERE "TIME" >= 1685635200
  AND "TIME" < 1685638800
LIMIT 20;
```

```sql
--Description: 3) Compare SEND vs OPEN counts per user (simple UNION ALL view)
SELECT "USER_ID", 'send'  AS "event_type"
FROM "BRAZE_USER_EVENT_DEMO_DATASET"."PUBLIC"."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
WHERE "TIME" BETWEEN 1685635200 AND 1685638799
UNION ALL
SELECT "USER_ID", 'open' AS "event_type"
FROM "BRAZE_USER_EVENT_DEMO_DATASET"."PUBLIC"."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"
WHERE "TIME" BETWEEN 1685635200 AND 1685638799
LIMIT 20;
```

```sql
--Description: 4) BOUNCE events during the window with platform information
SELECT "USER_ID",
       "CAMPAIGN_ID",
       "PLATFORM",
       "COUNTRY",
       "DEVICE_MODEL",
       "TIME"
FROM "BRAZE_USER_EVENT_DEMO_DATASET"."PUBLIC"."USERS_MESSAGES_PUSHNOTIFICATION_BOUNCE_VIEW"
WHERE "TIME" >= 1685635200
  AND "TIME" < 1685638800
LIMIT 20;
```

```sql
--Description: 5) Influenced OPEN events with SDK & OS details
SELECT "USER_ID",
       "CAMPAIGN_ID",
       "SDK_VERSION",
       "OS_VERSION",
       "TIME"
FROM "BRAZE_USER_EVENT_DEMO_DATASET"."PUBLIC"."USERS_MESSAGES_PUSHNOTIFICATION_INFLUENCEDOPEN_VIEW"
WHERE "TIME" >= 1685635200
  AND "TIME" < 1685638800
LIMIT 20;
```

```sql
--Description: 6) Quick roll‑up of event counts per type in the window
SELECT 'send'             AS "event_type", COUNT(*) AS "events"
FROM "BRAZE_USER_EVENT_DEMO_DATASET"."PUBLIC"."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
WHERE "TIME" BETWEEN 1685635200 AND 1685638799
UNION ALL
SELECT 'bounce', COUNT(*)
FROM "BRAZE_USER_EVENT_DEMO_DATASET"."PUBLIC"."USERS_MESSAGES_PUSHNOTIFICATION_BOUNCE_VIEW"
WHERE "TIME" BETWEEN 1685635200 AND 1685638799
UNION ALL
SELECT 'open', COUNT(*)
FROM "BRAZE_USER_EVENT_DEMO_DATASET"."PUBLIC"."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"
WHERE "TIME" BETWEEN 1685635200 AND 1685638799
UNION ALL
SELECT 'influenced_open', COUNT(*)
FROM "BRAZE_USER_EVENT_DEMO_DATASET"."PUBLIC"."USERS_MESSAGES_PUSHNOTIFICATION_INFLUENCEDOPEN_VIEW"
WHERE "TIME" BETWEEN 1685635200 AND 1685638799
LIMIT 20;
```

```sql
--Description: 7) Campaign‑level send & open counts (separate aggregation)
SELECT "CAMPAIGN_ID",
       COUNT(*) AS "push_notification_sends"
FROM "BRAZE_USER_EVENT_DEMO_DATASET"."PUBLIC"."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
WHERE "TIME" >= 1685635200 AND "TIME" < 1685638800
GROUP BY "CAMPAIGN_ID"
LIMIT 20;
```

```sql
--Description: 8) Message‑variation performance (opens per variation)
SELECT "MESSAGE_VARIATION_ID",
       COUNT(*) AS "push_notification_opens"
FROM "BRAZE_USER_EVENT_DEMO_DATASET"."PUBLIC"."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"
WHERE "TIME" >= 1685635200 AND "TIME" < 1685638800
GROUP BY "MESSAGE_VARIATION_ID"
LIMIT 20;
```

```sql
--Description: 9) Platform vs ad‑tracking segmentation for SEND events
SELECT "PLATFORM",
       "AD_TRACKING_ENABLED",
       COUNT(*) AS "events"
FROM "BRAZE_USER_EVENT_DEMO_DATASET"."PUBLIC"."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
WHERE "TIME" BETWEEN 1685635200 AND 1685638799
GROUP BY "PLATFORM", "AD_TRACKING_ENABLED"
LIMIT 20;
```

```sql
--Description: 10) Join SEND and OPEN to estimate open‑rate per campaign
SELECT s."CAMPAIGN_ID",
       COUNT(DISTINCT s."USER_ID") AS "sent_users",
       COUNT(DISTINCT o."USER_ID") AS "opened_users"
FROM "BRAZE_USER_EVENT_DEMO_DATASET"."PUBLIC"."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"  s
LEFT JOIN "BRAZE_USER_EVENT_DEMO_DATASET"."PUBLIC"."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW" o
       ON  s."SEND_ID" = o."SEND_ID"
      AND o."TIME" BETWEEN 1685635200 AND 1685638799
WHERE s."TIME" BETWEEN 1685635200 AND 1685638799
GROUP BY s."CAMPAIGN_ID"
LIMIT 20;
```

