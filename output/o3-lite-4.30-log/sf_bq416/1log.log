2025-05-01 16:35:44 - Thread-62 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
"ADDRESS": contract address the event originated from – filter to USDT (0xa614f8…)  
"EVENT_HASH": indexed topic that identifies the event type – filter to Transfer hash (0xddf252…)  
"ARGS": JSON array that holds the decoded event parameters – index 0 = from, 1 = to, 2 = raw value  
"BLOCK_NUMBER": block height the transfer happened in – output column  
"BLOCK_TIMESTAMP": optional inspection of time (not required for the final list)  
"TRANSACTION_HASH": can be used for look‑ups / troubleshooting  
Conditions that will be useful  
"ADDRESS" = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'  
"EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'  

Below are ten exploratory → final Snowflake SQL statements (each returns at most 20 rows).  
All identifiers are double‑quoted, comments explain every step.

```sql
--Description: 1) Look at a handful of rows for the USDT contract to confirm field structure
SELECT *
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "ADDRESS" = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
LIMIT 20;
```

```sql
--Description: 2) Check which event signatures occur on that contract
SELECT DISTINCT "EVENT_SIGNATURE"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "ADDRESS" = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
LIMIT 20;
```

```sql
--Description: 3) Verify the unique hashes that belong to the Transfer event
SELECT DISTINCT "EVENT_HASH", "EVENT_SIGNATURE"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" ILIKE '%Transfer%'
  AND "ADDRESS" = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
LIMIT 20;
```

```sql
--Description: 4) Display 20 raw Transfer events for USDT (hex addresses / raw value)
SELECT "BLOCK_NUMBER",
       "ARGS"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "ADDRESS" = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
LIMIT 20;
```

```sql
--Description: 5) Parse ARGS into individual columns (hex ↔ Ethereum style)
SELECT "BLOCK_NUMBER",
       PARSE_JSON("ARGS")[0]::STRING        AS "from_hex",
       PARSE_JSON("ARGS")[1]::STRING        AS "to_hex",
       PARSE_JSON("ARGS")[2]::NUMBER        AS "raw_value"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "ADDRESS" = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
LIMIT 20;
```

```sql
--Description: 6) Convert raw_value to human‑readable USDT (divide by 1,000,000)
SELECT "BLOCK_NUMBER",
       PARSE_JSON("ARGS")[0]::STRING        AS "from_hex",
       PARSE_JSON("ARGS")[1]::STRING        AS "to_hex",
       (PARSE_JSON("ARGS")[2]::NUMBER / 1_000_000) AS "usdt_amount"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "ADDRESS" = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
LIMIT 20;
```

```sql
--Description: 7) Order all transfers by value descending to see the biggest 20
SELECT "BLOCK_NUMBER",
       PARSE_JSON("ARGS")[0]::STRING        AS "from_hex",
       PARSE_JSON("ARGS")[1]::STRING        AS "to_hex",
       (PARSE_JSON("ARGS")[2]::NUMBER / 1_000_000) AS "usdt_amount"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "ADDRESS" = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
ORDER BY "usdt_amount" DESC
LIMIT 20;
```

