```sql
--Description: Direct NUMERIC casts overflow on huge uint256 values, so:
-- 1. Pull only events with signature 'Transfer(address,address,uint256)'.
-- 2. Take the third ARGS element (value), convert it to STRING, and use
--    TRY_TO_NUMBER to safely cast; rows that still overflow return NULL.
-- 3. Filter out those NULL rows.
-- 4. Divide by 1,000,000 to convert 6‑decimal tokens (USDT‑style).
-- 5. Order by the resulting amount to show the 20 biggest transfers.
SELECT
    "BLOCK_NUMBER",
    PARSE_JSON("ARGS")[0]::STRING  AS "from_hex",
    PARSE_JSON("ARGS")[1]::STRING  AS "to_hex",
    TRY_TO_NUMBER(PARSE_JSON("ARGS")[2]::STRING) / 1e6  AS "token_amount"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND TRY_TO_NUMBER(PARSE_JSON("ARGS")[2]::STRING) IS NOT NULL
ORDER BY "token_amount" DESC
LIMIT 20;
```
