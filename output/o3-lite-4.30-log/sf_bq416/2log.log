  AND "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
ORDER BY "usdt_amount" DESC
LIMIT 20;
```

```sql
--Description: 9) Filter to transfers larger than 10 million USDT for a quick high‑value scan.
SELECT "BLOCK_NUMBER",
       PARSE_JSON("ARGS")[0]              AS "from_hex",
       HEX_TO_TRON(PARSE_JSON("ARGS")[1]) AS "to_tron",
       (PARSE_JSON("ARGS")[2]::NUMBER / 1e6) AS "usdt_amount"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "ADDRESS"         = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND (PARSE_JSON("ARGS")[2]::NUMBER / 1e6) >= 10000000
ORDER BY "usdt_amount" DESC
LIMIT 20;
```

```sql
--Description: 10) Final query – return the top three largest USDT transfers on TRON, showing
--                block, sender, recipient (TronLink), and amount (USDT, 6 decimals).
SELECT "BLOCK_NUMBER",
       PARSE_JSON("ARGS")[0]              AS "from_hex",
       HEX_TO_TRON(PARSE_JSON("ARGS")[1]) AS "to_tron",
       (PARSE_JSON("ARGS")[2]::NUMBER / 1e6)  AS "usdt_amount"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "ADDRESS"         = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
ORDER BY "usdt_amount" DESC
LIMIT 20;               -- change to LIMIT 3 when you only need the very top three
```

