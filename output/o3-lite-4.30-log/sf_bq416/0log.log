```sql
--Description: 
-- Surface the three largest ERC‑20 “Transfer” events in the Arbitrum‑US decoded‑events table
-- while avoiding JSON‑parsing and numeric‑overflow errors.
-- • Filter by topic‑0 hash = canonical Transfer hash (0xddf252ad…3b3ef) and keep only
--   non‑orphaned logs (REMOVED = FALSE).  
-- • Use TRY_PARSE_JSON to safely parse the "ARGS" column; rows whose ARGS cannot be
--   parsed are discarded.  Index‑0 = sender, index‑1 = recipient, index‑2 = value.  
-- • Because the value may exceed Snowflake’s numeric limit, cast it to STRING.  
-- • Emulate numeric ordering by sorting first on the length of that string (digit count)
--   and then lexicographically, which preserves descending numerical order for
--   non‑negative integers.  
-- • Return block number, token contract, sender, recipient, and the raw value string
--   for the three largest transfers discovered.
SELECT
    "BLOCK_NUMBER",
    "ADDRESS"                                          AS "TOKEN_CONTRACT",
    TRY_PARSE_JSON("ARGS")[0]::STRING                  AS "FROM_ADDRESS_HEX",
    TRY_PARSE_JSON("ARGS")[1]::STRING                  AS "TO_ADDRESS_HEX",
    TRY_PARSE_JSON("ARGS")[2]::STRING                  AS "VALUE_RAW_STRING"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
WHERE "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND "REMOVED"   = FALSE
  AND TRY_PARSE_JSON("ARGS") IS NOT NULL
ORDER BY LENGTH(TRY_PARSE_JSON("ARGS")[2]::STRING) DESC,
         TRY_PARSE_JSON("ARGS")[2]::STRING        DESC
LIMIT 3;
```
