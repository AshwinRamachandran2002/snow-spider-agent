```sql
--Description: 7) Convert RAW_VALUE to human‑readable USDT amount (divide by 1,000,000).
SELECT "BLOCK_NUMBER",
       PARSE_JSON("ARGS")[0]::STRING AS "FROM",
       PARSE_JSON("ARGS")[1]::STRING AS "TO",
       (PARSE_JSON("ARGS")[2]::NUMBER) / 1_000_000 AS "USDT_AMOUNT"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
WHERE "ADDRESS"    = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND "REMOVED"    = FALSE
LIMIT 20;
```

```sql
--Description: 8) (If a JavaScript UDF named hexToTron exists) convert “TO” to TronLink format.
SELECT "BLOCK_NUMBER",
       hexToTron(PARSE_JSON("ARGS")[0]::STRING)  AS "FROM_TRON",
       hexToTron(PARSE_JSON("ARGS")[1]::STRING)  AS "TO_TRON",
       (PARSE_JSON("ARGS")[2]::NUMBER) / 1_000_000 AS "USDT_AMOUNT"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
WHERE "ADDRESS"    = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND "REMOVED"    = FALSE
LIMIT 20;
```

```sql
--Description: 9) Order all transfers by largest value first (raw amount still divided).
SELECT "BLOCK_NUMBER",
       PARSE_JSON("ARGS")[0]::STRING AS "FROM",
       PARSE_JSON("ARGS")[1]::STRING AS "TO",
       (PARSE_JSON("ARGS")[2]::NUMBER) / 1_000_000 AS "USDT_AMOUNT"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
WHERE "ADDRESS"    = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND "REMOVED"    = FALSE
ORDER BY "USDT_AMOUNT" DESC
LIMIT 20;
```

```sql
