```sql
WITH usdt_logs AS (
    SELECT
        "BLOCK_NUMBER",
        LOWER('0x' || RIGHT(PARSE_JSON("TOPICS")[1]::STRING, 40))             AS from_address,
        LOWER('0x' || RIGHT(PARSE_JSON("TOPICS")[2]::STRING, 40))             AS to_address,
        TRY_TO_NUMBER(SUBSTR("DATA", 3), 16) / 1e6                            AS amount_usdt
    FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
    WHERE "ADDRESS" = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'            -- USDT (TRON)
      AND PARSE_JSON("TOPICS")[0]::STRING = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'  -- Transfer
      AND "REMOVED" = FALSE
      AND TRY_TO_NUMBER(SUBSTR("DATA", 3), 16) IS NOT NULL
)
SELECT
    "BLOCK_NUMBER" AS block_number,
    from_address,
    to_address,
    ROUND(amount_usdt, 4) AS amount_usdt
FROM usdt_logs
ORDER BY amount_usdt DESC NULLS LAST, block_number DESC
LIMIT 3;
```
