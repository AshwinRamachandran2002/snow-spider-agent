    SELECT "family_id"
    FROM (
        SELECT "family_id",
               COUNT(*) AS "pub_cnt"
        FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
        WHERE "family_id" <> '-1'
        GROUP BY "family_id"
        ORDER BY "pub_cnt" DESC
        LIMIT 6
    )
)
