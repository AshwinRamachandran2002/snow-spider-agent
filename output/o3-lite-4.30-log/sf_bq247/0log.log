       COUNT(*) AS "pub_cnt"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
GROUP BY "family_id"
ORDER BY "pub_cnt" DESC
LIMIT 20;
```

```sql
-- Description: Same aggregation but explicitly excluding the placeholder family_id = -1.
SELECT "family_id",
       COUNT(*) AS "pub_cnt"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
WHERE "family_id" <> '-1'
GROUP BY "family_id"
ORDER BY "pub_cnt" DESC
LIMIT 20;
```

```sql
-- Description: Look at publication_numbers for one high‑volume family to verify they exist in ABS_AND_EMB.
SELECT p."publication_number"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
WHERE p."family_id" = '<<replace_with_a_family_id>>'
LIMIT 20;
```

```sql
-- Description: Quick check of ABS_AND_EMB to confirm abstract content and non‑null values.
SELECT "publication_number",
       LEFT("abstract", 200) AS "abstract_snippet"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB
WHERE "abstract" IS NOT NULL
LIMIT 20;
```

```sql
-- Description: Simple join to ensure linkage between PUBLICATIONS and ABS_AND_EMB.
SELECT p."publication_number",
       p."family_id",
       a."abstract"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
  ON p."publication_number" = a."publication_number"
WHERE p."family_id" <> '-1'
  AND a."abstract" IS NOT NULL
LIMIT 20;
```

```sql
-- Description: For each of the six most‑prolific families, list counts of publications that have an abstract.
WITH top_fams AS (
  SELECT "family_id"
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
  WHERE "family_id" <> '-1'
  GROUP BY "family_id"
  ORDER BY COUNT(*) DESC
  LIMIT 6
)
SELECT p."family_id",
       COUNT(*) AS "pub_with_abs"
FROM top_fams tf
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
  ON p."family_id" = tf."family_id"
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
  ON a."publication_number" = p."publication_number"
WHERE a."abstract" IS NOT NULL
GROUP BY p."family_id"
ORDER BY "pub_with_abs" DESC;
```

```sql
-- Description: Retrieve every non‑empty abstract for one of the top six families (parameterized).
SELECT p."family_id",
       p."publication_number",
       a."abstract"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
  ON p."publication_number" = a."publication_number"
WHERE p."family_id" = '<<top_family_id_here>>'
  AND a."abstract" IS NOT NULL
  AND TRIM(a."abstract") <> ''
LIMIT 20;
```

```sql
-- Description: Final production query template – returns the six busiest families (excluding -1) and every non‑empty abstract tied to their publications.
WITH fam_ranks AS (
  SELECT "family_id",
         COUNT(*) AS "pub_cnt"
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
  WHERE "family_id" <> '-1'
  GROUP BY "family_id"
  ORDER BY "pub_cnt" DESC
  LIMIT 6
)
SELECT p."family_id",
       a."abstract"
FROM fam_ranks fr
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
  ON p."family_id" = fr."family_id"
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
  ON a."publication_number" = p."publication_number"
WHERE a."abstract" IS NOT NULL
  AND TRIM(a."abstract") <> ''
LIMIT 20;
```

