FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210107`
WHERE event_name = 'user_engagement'
LIMIT 20;
```

```sql
-- 3. Description: extract engagement_time_msec for several rows on 2021‑01‑07
SELECT
  user_pseudo_id,
  ep.value.int_value AS engagement_time_msec
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210107`,
     UNNEST(event_params) AS ep
WHERE event_name = 'user_engagement'
  AND ep.key = 'engagement_time_msec'
LIMIT 20;
```

```sql
-- 4. Description: list distinct users with positive engagement on 1‑Jan‑2021
SELECT DISTINCT user_pseudo_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210101`,
     UNNEST(event_params) AS ep
WHERE event_name = 'user_engagement'
  AND ep.key  = 'engagement_time_msec'
  AND ep.value.int_value > 0
LIMIT 20;
```

```sql
-- 5. Description: same as above but on 6‑Jan‑2021 to prepare for 2‑day window
SELECT DISTINCT user_pseudo_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210106`,
     UNNEST(event_params) AS ep
WHERE event_name = 'user_engagement'
  AND ep.key  = 'engagement_time_msec'
  AND ep.value.int_value > 0
LIMIT 20;
```

```sql
-- 6. Description: use a wildcard to pull the whole 7‑day window at once
SELECT DISTINCT user_pseudo_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20210101' AND '20210107'
  AND event_name = 'user_engagement'
  AND EXISTS (
        SELECT 1 FROM UNNEST(event_params) AS ep
        WHERE ep.key = 'engagement_time_msec'
          AND ep.value.int_value > 0 )
LIMIT 20;
```

```sql
-- 7. Description: same idea but only the 2‑day window (6‑Jan & 7‑Jan)
SELECT DISTINCT user_pseudo_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20210106' AND '20210107'
  AND event_name = 'user_engagement'
  AND EXISTS (
        SELECT 1 FROM UNNEST(event_params) AS ep
        WHERE ep.key = 'engagement_time_msec'
          AND ep.value.int_value > 0 )
LIMIT 20;
```

```sql
-- 8. Description: build two CTEs (7‑day users and 2‑day users) and show users in 7‑day but NOT in 2‑day
WITH seven_day AS (
    SELECT DISTINCT user_pseudo_id
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20210101' AND '20210107'
      AND event_name = 'user_engagement'
      AND EXISTS (
            SELECT 1 FROM UNNEST(event_params) ep
            WHERE ep.key = 'engagement_time_msec'
              AND ep.value.int_value > 0 )
),
two_day AS (
    SELECT DISTINCT user_pseudo_id
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20210106' AND '20210107'
      AND event_name = 'user_engagement'
      AND EXISTS (
            SELECT 1 FROM UNNEST(event_params) ep
            WHERE ep.key = 'engagement_time_msec'
              AND ep.value.int_value > 0 )
)
SELECT user_pseudo_id
FROM   seven_day
WHERE  user_pseudo_id NOT IN (SELECT user_pseudo_id FROM two_day)
LIMIT 20;
```

```sql
-- 9. Description: the same logic as #8, but we also compute each user's total engagement time in the 7‑day window
WITH seven_day AS (
    SELECT user_pseudo_id,
           SUM( IF(ep.key='engagement_time_msec', ep.value.int_value, 0) ) AS total_eng_time
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
         UNNEST(event_params) ep
    WHERE _TABLE_SUFFIX BETWEEN '20210101' AND '20210107'
      AND event_name = 'user_engagement'
    GROUP BY user_pseudo_id
),
two_day AS (
    SELECT DISTINCT user_pseudo_id
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
         UNNEST(event_params) ep
    WHERE _TABLE_SUFFIX BETWEEN '20210106' AND '20210107'
      AND event_name = 'user_engagement'
      AND ep.key = 'engagement_time_msec'
      AND ep.value.int_value > 0
)
SELECT user_pseudo_id, total_eng_time
FROM seven_day
WHERE total_eng_time > 0
  AND user_pseudo_id NOT IN (SELECT user_pseudo_id FROM two_day)
LIMIT 20;
```

```sql
-- 10. Description (FINAL ANSWER QUERY): count distinct pseudo users that
-- had positive engagement in the 7‑day window but NONE in the 2‑day window
WITH seven_day_users AS (
    SELECT DISTINCT user_pseudo_id
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20210101' AND '20210107'
      AND event_name = 'user_engagement'
      AND EXISTS (
            SELECT 1 FROM UNNEST(event_params) ep
            WHERE ep.key = 'engagement_time_msec'
              AND ep.value.int_value > 0 )
),
two_day_users AS (
    SELECT DISTINCT user_pseudo_id
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20210106' AND '20210107'
      AND event_name = 'user_engagement'
      AND EXISTS (
            SELECT 1 FROM UNNEST(event_params) ep
            WHERE ep.key = 'engagement_time_msec'
              AND ep.value.int_value > 0 )
)
SELECT COUNT(*) AS distinct_users_7d_but_not_2d
FROM   seven_day_users
WHERE  user_pseudo_id NOT IN (SELECT user_pseudo_id FROM two_day_users);
```

Each query is self‑contained, uses only the permitted tables, and is limited to 20 rows except for the final aggregation that naturally must return exactly one row (the answer).
