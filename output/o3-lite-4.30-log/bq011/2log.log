Begin Exploring Related Columns
Relevant columns and how they will be used 

• event_date : filter the seven‑day window (20210101‑20210107) and the two‑day window (20210106‑20210107)  
• event_name : keep only the “user_engagement” event, the one that carries the engagement time information  
• event_params : look for the struct whose key = 'engagement_time_msec'; the corresponding value.int_value must be > 0 to qualify as “positive engagement time”  
• user_pseudo_id : identify each pseudo‑user and deduplicate / count them  

Typical conditions that may be used  

• event_name = 'user_engagement'  
• EXISTS (SELECT 1 FROM UNNEST(event_params) ep WHERE ep.key = 'engagement_time_msec' AND ep.value.int_value > 0)  
• _TABLE_SUFFIX BETWEEN '20210101' AND '20210107'      -- seven‑day window  
• _TABLE_SUFFIX BETWEEN '20210106' AND '20210107'      -- two‑day window  


Below are ten exploratory BigQuery queries (each different, limited to 20 rows) that gradually build up to the final answer.  
Replace PROJECT with your own project id if you copy‑paste; the public dataset is already referenced by project “bigquery‑public‑data”.

```sql
-- 1. Inspect a handful of raw rows for Jan‑07
SELECT *
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210107`
LIMIT 20;
```

```sql
-- 2. Show event_name values that exist on Jan‑07 (distinct)
SELECT DISTINCT event_name
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210107`
LIMIT 20;
```

```sql
-- 3. Inspect one event’s parameters to see the shape of engagement_time_msec
SELECT event_timestamp,
       (SELECT ep.value.int_value
        FROM UNNEST(event_params) ep
        WHERE ep.key = 'engagement_time_msec')     AS engagement_ms
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210107`
WHERE event_name = 'user_engagement'
LIMIT 20;
```

```sql
-- 4. Pull only the rows that have positive engagement time on Jan‑07
SELECT user_pseudo_id,
       (SELECT ep.value.int_value
        FROM UNNEST(event_params) ep
        WHERE ep.key = 'engagement_time_msec')     AS engagement_ms
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210107`
WHERE event_name = 'user_engagement'
  AND EXISTS (SELECT 1
              FROM UNNEST(event_params) ep
              WHERE ep.key = 'engagement_time_msec'
                AND ep.value.int_value > 0)
LIMIT 20;
```

```sql
-- 5. Distinct users with positive engagement on one specific day (Jan‑07)
SELECT DISTINCT user_pseudo_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210107`
WHERE event_name = 'user_engagement'
  AND EXISTS (SELECT 1
              FROM UNNEST(event_params) ep
              WHERE ep.key = 'engagement_time_msec'
                AND ep.value.int_value > 0)
LIMIT 20;
```

```sql
-- 6. Use wildcard tables: list any date’s distinct users that had positive engagement
SELECT _TABLE_SUFFIX AS event_date,
       COUNT(DISTINCT user_pseudo_id) AS users_with_engagement
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20210101' AND '20210107'
  AND event_name = 'user_engagement'
  AND EXISTS (SELECT 1
              FROM UNNEST(event_params) ep
              WHERE ep.key = 'engagement_time_msec'
                AND ep.value.int_value > 0)
GROUP BY event_date
ORDER BY event_date
LIMIT 20;
```

```sql
-- 7. Build the seven‑day user set (Jan‑01 .. Jan‑07)
SELECT DISTINCT user_pseudo_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20210101' AND '20210107'
  AND event_name = 'user_engagement'
  AND EXISTS (SELECT 1
              FROM UNNEST(event_params) ep
              WHERE ep.key = 'engagement_time_msec'
                AND ep.value.int_value > 0)
LIMIT 20;
```

```sql
-- 8. Build the two‑day user set (Jan‑06 .. Jan‑07)
SELECT DISTINCT user_pseudo_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20210106' AND '20210107'
  AND event_name = 'user_engagement'
  AND EXISTS (SELECT 1
              FROM UNNEST(event_params) ep
              WHERE ep.key = 'engagement_time_msec'
                AND ep.value.int_value > 0)
LIMIT 20;
```

```sql
-- 9. Seven‑day users minus the two‑day users (shows a sample of pseudo‑ids)
WITH seven AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20210101' AND '20210107'
    AND event_name = 'user_engagement'
    AND EXISTS (SELECT 1
                FROM UNNEST(event_params) ep
                WHERE ep.key = 'engagement_time_msec'
                  AND ep.value.int_value > 0)
),
two AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20210106' AND '20210107'
    AND event_name = 'user_engagement'
    AND EXISTS (SELECT 1
                FROM UNNEST(event_params) ep
                WHERE ep.key = 'engagement_time_msec'
                  AND ep.value.int_value > 0)
)
SELECT seven.user_pseudo_id
FROM seven
LEFT JOIN two
  ON seven.user_pseudo_id = two.user_pseudo_id
WHERE two.user_pseudo_id IS NULL
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: How many distinct pseudo users meet the requirement?
WITH seven AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20210101' AND '20210107'
    AND event_name = 'user_engagement'
    AND EXISTS (SELECT 1
                FROM UNNEST(event_params) ep
                WHERE ep.key = 'engagement_time_msec'
                  AND ep.value.int_value > 0)
),
two AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20210106' AND '20210107'
    AND event_name = 'user_engagement'
    AND EXISTS (SELECT 1
                FROM UNNEST(event_params) ep
                WHERE ep.key = 'engagement_time_msec'
                  AND ep.value.int_value > 0)
)
SELECT COUNT(*) AS distinct_users_7d_not_2d
FROM seven
LEFT JOIN two
  ON seven.user_pseudo_id = two.user_pseudo_id
WHERE two.user_pseudo_id IS NULL
LIMIT 20;
```

