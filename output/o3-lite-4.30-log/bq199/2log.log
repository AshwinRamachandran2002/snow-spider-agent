WHERE EXTRACT(YEAR FROM date) = 2021
  AND sale_dollars > 0
  AND volume_sold_liters > 0
LIMIT 20;
```

```sql
-- 5. Average per‑liter retail price for each category in 2021
SELECT
  category,
  category_name,
  AVG(sale_dollars / volume_sold_liters) AS avg_price_per_liter_2021
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM date) = 2021
  AND sale_dollars > 0
  AND volume_sold_liters > 0
GROUP BY category, category_name
ORDER BY avg_price_per_liter_2021 DESC
LIMIT 20;
```

```sql
-- 6. Top‑10 categories of 2021 by highest avg per‑liter retail price
SELECT
  category,
  category_name,
  AVG(sale_dollars / volume_sold_liters) AS avg_price_per_liter_2021
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM date) = 2021
  AND sale_dollars > 0
  AND volume_sold_liters > 0
GROUP BY category, category_name
ORDER BY avg_price_per_liter_2021 DESC
LIMIT 10;
```

```sql
-- 7. Capture those 2021 top‑10 categories in a WITH‑subquery
WITH top10 AS (
  SELECT category
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM date) = 2021
    AND sale_dollars > 0
    AND volume_sold_liters > 0
  GROUP BY category
  ORDER BY AVG(sale_dollars / volume_sold_liters) DESC
  LIMIT 10
)
SELECT DISTINCT t.category
FROM top10 t
LIMIT 20;
```

```sql
-- 8. Compute yearly averages (2019‑2021) just for those top‑10 categories
WITH top10 AS (
  SELECT category
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM date) = 2021
    AND sale_dollars > 0
    AND volume_sold_liters > 0
  GROUP BY category
  ORDER BY AVG(sale_dollars / volume_sold_liters) DESC
  LIMIT 10
)
SELECT
  EXTRACT(YEAR FROM date) AS sales_year,
  category,
  AVG(sale_dollars / volume_sold_liters) AS avg_price_per_liter
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE category IN (SELECT category FROM top10)
  AND EXTRACT(YEAR FROM date) IN (2019,2020,2021)
  AND sale_dollars > 0
  AND volume_sold_liters > 0
GROUP BY sales_year, category
ORDER BY category, sales_year
LIMIT 20;
```

```sql
-- 9. Same as #8, but pivoted to have separate columns per year
WITH top10 AS (
  SELECT category, category_name
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM date) = 2021
    AND sale_dollars > 0
    AND volume_sold_liters > 0
  GROUP BY category, category_name
  ORDER BY AVG(sale_dollars / volume_sold_liters) DESC
  LIMIT 10
)
SELECT
  c.category,
  c.category_name,
  AVG(CASE WHEN EXTRACT(YEAR FROM s.date) = 2019 THEN s.sale_dollars / s.volume_sold_liters END) AS avg_2019,
  AVG(CASE WHEN EXTRACT(YEAR FROM s.date) = 2020 THEN s.sale_dollars / s.volume_sold_liters END) AS avg_2020,
  AVG(CASE WHEN EXTRACT(YEAR FROM s.date) = 2021 THEN s.sale_dollars / s.volume_sold_liters END) AS avg_2021
FROM `bigquery-public-data.iowa_liquor_sales.sales` AS s
JOIN top10 AS c
USING (category)
WHERE EXTRACT(YEAR FROM s.date) IN (2019,2020,2021)
  AND s.sale_dollars > 0
  AND s.volume_sold_liters > 0
GROUP BY c.category, c.category_name
ORDER BY avg_2021 DESC
LIMIT 20;
```

```sql
-- 10. Final full answer: top‑10 2021 categories with their 2019‑2021 avg per‑liter retail prices
WITH ranked AS (
  SELECT
    category,
    category_name,
    AVG(sale_dollars / volume_sold_liters) AS avg_price_per_liter_2021
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM date) = 2021
    AND sale_dollars > 0
    AND volume_sold_liters > 0
  GROUP BY category, category_name
  ORDER BY avg_price_per_liter_2021 DESC
  LIMIT 10
)
SELECT
  r.category,
  r.category_name,
  -- Yearly averages
  AVG(CASE WHEN EXTRACT(YEAR FROM s.date) = 2019 THEN s.sale_dollars / s.volume_sold_liters END) AS avg_per_liter_2019,
  AVG(CASE WHEN EXTRACT(YEAR FROM s.date) = 2020 THEN s.sale_dollars / s.volume_sold_liters END) AS avg_per_liter_2020,
  AVG(CASE WHEN EXTRACT(YEAR FROM s.date) = 2021 THEN s.sale_dollars / s.volume_sold_liters END) AS avg_per_liter_2021
FROM `bigquery-public-data.iowa_liquor_sales.sales` AS s
JOIN ranked AS r
USING (category)
WHERE EXTRACT(YEAR FROM s.date) IN (2019,2020,2021)
  AND s.sale_dollars > 0
  AND s.volume_sold_liters > 0
GROUP BY r.category, r.category_name
ORDER BY avg_per_liter_2021 DESC
LIMIT 20;
```
