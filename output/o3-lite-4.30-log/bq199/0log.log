```sql
--Description: Query #8 ― reusable CTE that produces the average per‑liter retail price
--             for every (category, year) pair between 2019‑2021.  The year field is
--             renamed to `sale_year` to avoid any alias collision.
WITH txn AS (
  SELECT
    category_name,
    EXTRACT(YEAR FROM `date`) AS sale_year,
    SAFE_DIVIDE(sale_dollars, volume_sold_liters) AS price_per_liter
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) BETWEEN 2019 AND 2021
    AND volume_sold_liters <> 0
)
SELECT
  category_name,
  sale_year,
  AVG(price_per_liter) AS avg_price_per_liter
FROM txn
GROUP BY category_name, sale_year
ORDER BY category_name, sale_year
LIMIT 20;
```

```sql
--Description: Query #9 ― rank liquor categories by their 2021 average per‑liter price
--             and list the top 10.  Uses the `sale_year` column name to prevent the
--             earlier STRUCT‑vs‑INT comparison error.
WITH txn AS (
  SELECT
    category_name,
    EXTRACT(YEAR FROM `date`) AS sale_year,
    SAFE_DIVIDE(sale_dollars, volume_sold_liters) AS price_per_liter
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) BETWEEN 2019 AND 2021
    AND volume_sold_liters <> 0
),
cat_year AS (
  SELECT
    category_name,
    sale_year,
    AVG(price_per_liter) AS avg_price_per_liter
  FROM txn
  GROUP BY category_name, sale_year
),
ranked AS (
  SELECT
    category_name,
    avg_price_per_liter,
    ROW_NUMBER() OVER (ORDER BY avg_price_per_liter DESC) AS rnk
  FROM cat_year
  WHERE sale_year = 2021
)
SELECT *
FROM ranked
WHERE rnk <= 10
ORDER BY rnk
LIMIT 20;
```

```sql
--Description: Query #10 ― final answer.  Retrieves the 10 categories with the highest
--             average price per liter in 2021 and shows their averages for 2019‑2021.
--             All references use the `sale_year` column name to avoid alias conflicts.
WITH txn AS (
  SELECT
    category_name,
    EXTRACT(YEAR FROM `date`) AS sale_year,
    SAFE_DIVIDE(sale_dollars, volume_sold_liters) AS price_per_liter
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) BETWEEN 2019 AND 2021
    AND volume_sold_liters <> 0
),
cat_year AS (
  SELECT
    category_name,
    sale_year,
    AVG(price_per_liter) AS avg_price_per_liter
  FROM txn
  GROUP BY category_name, sale_year
),
top2021 AS (
  SELECT
    category_name,
    avg_price_per_liter AS avg_2021
  FROM cat_year
  WHERE sale_year = 2021
  ORDER BY avg_price_per_liter DESC
  LIMIT 10
)
SELECT
  t.category_name,
  MAX(CASE WHEN c.sale_year = 2019 THEN c.avg_price_per_liter END) AS avg_price_per_liter_2019,
  MAX(CASE WHEN c.sale_year = 2020 THEN c.avg_price_per_liter END) AS avg_price_per_liter_2020,
  MAX(CASE WHEN c.sale_year = 2021 THEN c.avg_price_per_liter END) AS avg_price_per_liter_2021
FROM top2021 AS t
JOIN cat_year AS c
  ON t.category_name = c.category_name
GROUP BY t.category_name
ORDER BY avg_price_per_liter_2021 DESC;
