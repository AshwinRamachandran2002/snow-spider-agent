```

```sql
-- 6. Grab the same metric for 2020 for a sense‑check (top‑20, unsorted)
SELECT
  category_name,
  AVG(SAFE_DIVIDE(sale_dollars, volume_sold_liters)) AS avg_retail_per_liter_2020
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2020
  AND volume_sold_liters <> 0
GROUP BY category_name
LIMIT 20;
```

```sql
-- 7. Combine 2020 and 2021 in one query for quick comparison (top‑20 categories by 2021 metric)
WITH yr AS (
  SELECT
    category_name,
    EXTRACT(YEAR FROM `date`) AS yr,
    SAFE_DIVIDE(sale_dollars, volume_sold_liters) AS price_per_liter
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2020, 2021)
    AND volume_sold_liters <> 0
)
SELECT
  category_name,
  AVG(CASE WHEN yr = 2020 THEN price_per_liter END) AS avg_2020,
  AVG(CASE WHEN yr = 2021 THEN price_per_liter END) AS avg_2021
FROM yr
GROUP BY category_name
ORDER BY avg_2021 DESC
LIMIT 20;
```

```sql
-- 8. Prepare a reusable CTE that yields average per‑liter retail price per category and year
WITH txn AS (
  SELECT
    category_name,
    EXTRACT(YEAR FROM `date`) AS yr,
    SAFE_DIVIDE(sale_dollars, volume_sold_liters) AS price_per_liter
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) BETWEEN 2019 AND 2021
    AND volume_sold_liters <> 0
)
SELECT
  category_name,
  yr,
  AVG(price_per_liter) AS avg_price_per_liter
FROM txn
GROUP BY category_name, yr
ORDER BY category_name, yr
LIMIT 20;
```

```sql
-- 9. Rank the categories by their 2021 average and keep the top‑10
WITH txn AS (
  SELECT
    category_name,
    EXTRACT(YEAR FROM `date`) AS yr,
    SAFE_DIVIDE(sale_dollars, volume_sold_liters) AS price_per_liter
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) BETWEEN 2019 AND 2021
    AND volume_sold_liters <> 0
),
cat_year AS (
  SELECT
    category_name,
    yr,
    AVG(price_per_liter) AS avg_price_per_liter
  FROM txn
  GROUP BY category_name, yr
),
ranked AS (
  SELECT
    category_name,
    avg_price_per_liter,
    ROW_NUMBER() OVER (ORDER BY avg_price_per_liter DESC) AS rnk
  FROM cat_year
  WHERE yr = 2021
)
SELECT *
FROM ranked
WHERE rnk <= 10
ORDER BY rnk
LIMIT 20;
```

```sql
-- 10. Final answer: top‑10 2021 categories with their average per‑liter retail prices for 2019‑2021
WITH txn AS (
  SELECT
    category_name,
    EXTRACT(YEAR FROM `date`) AS yr,
    SAFE_DIVIDE(sale_dollars, volume_sold_liters) AS price_per_liter
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) BETWEEN 2019 AND 2021
    AND volume_sold_liters <> 0
),
cat_year AS (
  SELECT
    category_name,
    yr,
    AVG(price_per_liter) AS avg_price_per_liter
  FROM txn
  GROUP BY category_name, yr
),
top2021 AS (
  SELECT
    category_name,
    avg_price_per_liter AS avg_2021
  FROM cat_year
  WHERE yr = 2021
  ORDER BY avg_price_per_liter DESC
  LIMIT 10
)
SELECT
  t.category_name,
  -- Pull in the historical averages
  AVG(CASE WHEN c.yr = 2019 THEN c.avg_price_per_liter END) AS avg_price_per_liter_2019,
  AVG(CASE WHEN c.yr = 2020 THEN c.avg_price_per_liter END) AS avg_price_per_liter_2020,
  AVG(CASE WHEN c.yr = 2021 THEN c.avg_price_per_liter END) AS avg_price_per_liter_2021
FROM top2021 AS t
JOIN cat_year AS c
ON t.category_name = c.category_name
GROUP BY t.category_name, t.avg_2021
ORDER BY t.avg_2021 DESC
LIMIT 20;
```

The last query (`#10`) returns the requested result set: the ten liquor categories with the highest average transaction‑level retail price per liter in 2021, along with their corresponding averages for 2019 and 2020.
