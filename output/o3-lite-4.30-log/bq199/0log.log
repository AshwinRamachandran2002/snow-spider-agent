--Description:
--Goal: list the 10 liquor categories that had the highest average transaction‑level
--      retail price per liter in 2021 and show their averages for 2019, 2020, 2021.
--Thinking process:
-- 1) Work at the transaction level: compute price_per_liter = sale_dollars / volume_sold_liters
--    using SAFE_DIVIDE to avoid division‑by‑zero errors; keep only 2019‑2021 data.
-- 2) Aggregate to get avg_price_per_liter for each (category, year) pair.
-- 3) Rank categories by their 2021 average and keep the top 10.
-- 4) Pivot those 3 yearly averages into columns for the final output.
WITH txn AS (
  SELECT
    category_name,
    EXTRACT(YEAR FROM `date`) AS sale_year,
    SAFE_DIVIDE(sale_dollars, volume_sold_liters) AS price_per_liter
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) BETWEEN 2019 AND 2021
    AND volume_sold_liters <> 0
),
