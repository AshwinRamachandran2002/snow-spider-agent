```

```sql
-- 5. The top‑10 categories in 2021 by the average transaction‑level per‑liter retail price
SELECT
  category_name,
  AVG(SAFE_DIVIDE(sale_dollars, volume_sold_liters)) AS avg_retail_per_liter_2021
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2021
  AND volume_sold_liters <> 0
GROUP BY category_name
