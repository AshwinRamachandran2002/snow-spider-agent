```sql
WITH order_need AS (                       -- how many of each product the order requires
    SELECT product_id,
           SUM(qty) AS need_qty
    FROM   orderlines
    WHERE  order_id = 423
    GROUP  BY product_id
),
inv AS (                                   -- stock that is in warehouse 1
    SELECT  i.id                     AS inventory_id,
            i.product_id,
            i.qty                    AS bin_qty,
            COALESCE(p.purchased,'9999-12-31') AS purchased,   -- null‑safe for sorting
            l.aisle,
            l.position
    FROM    inventory  i
    JOIN    locations  l ON l.id = i.location_id
    LEFT    JOIN purchases p ON p.id = i.purchase_id
    WHERE   l.warehouse = 1
      AND   i.product_id IN (SELECT product_id FROM order_need)
),
calc AS (                                 -- running stock total in priority order
    SELECT  inv.*,
            oned.need_qty,
            SUM(inv.bin_qty) OVER (
                  PARTITION BY inv.product_id
                  ORDER BY     inv.purchased, inv.bin_qty, inv.inventory_id
                  ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
            ) AS cum_prior            -- stock quantity BEFORE this bin
    FROM    inv
    JOIN    order_need oned USING (product_id)
)
SELECT  product_id,
        aisle,
        position,
        CASE                                   -- how much to pick from this bin
             WHEN COALESCE(cum_prior,0) >= need_qty         THEN 0
             WHEN COALESCE(cum_prior,0) + bin_qty <= need_qty
                                                         THEN bin_qty
             ELSE  need_qty - COALESCE(cum_prior,0)
        END AS pick_qty
FROM    calc
WHERE   pick_qty > 0                          -- keep only the bins we have to visit
ORDER BY product_id,
         purchased,
         bin_qty,
         inventory_id;
```
