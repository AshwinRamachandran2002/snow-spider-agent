```sql
-- Thinking process embedded step‑by‑step:
-- • We must pick for order 423 → locate its products and quantities.
-- • Work only with inventory that is in warehouse 1 (locations.warehouse = 1).
-- • Follow FIFO: oldest purchase first (purchases.purchased ASC) and,
--   within the same date, pick from smaller lots first (inventory.qty ASC).
-- • For each product keep a running total (window function) to know how much of the
--   order is already satisfied before the current row.
-- • Determine qty_to_pick for each row: take the whole lot unless it would overshoot
--   the order quantity, in which case take only what is still missing.
-- • Return rows where qty_to_pick > 0, listing product, aisle, position and quantity.
SELECT
    pick.product_id,
    pick.aisle,
    pick.position,
    pick.qty_to_pick
FROM (
    -----------------------------------------------------------------------
    -- inner query builds FIFO‑sorted inventory rows and decides how much
    -- to take from each one to meet order 423 exactly
    -----------------------------------------------------------------------
    SELECT
        inv.id             AS inventory_id,
        inv.product_id,
        loc.aisle,
        loc.position,
        CASE
             WHEN run.running_qty + inv.qty <= ord.total_order_qty
                  THEN inv.qty               -- we can take the entire lot
             ELSE ord.total_order_qty - run.running_qty  -- take what remains
        END               AS qty_to_pick
    FROM (
        -- inventory rows (warehouse 1) with running total per product
        SELECT
            inv.id,
            inv.product_id,
            inv.qty,
            pur.purchased,
            loc.aisle,
            loc.position,
            SUM(inv.qty) OVER (
                PARTITION BY inv.product_id
                ORDER BY pur.purchased, inv.qty
                ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
            ) AS running_qty
        FROM inventory  AS inv
        JOIN purchases  AS pur ON pur.id = inv.purchase_id
        JOIN locations  AS loc ON loc.id = inv.location_id
        WHERE loc.warehouse = 1
          AND inv.product_id IN (
                SELECT product_id
                FROM orderlines
                WHERE order_id = 423
              )
    ) AS run
    JOIN inventory AS inv        ON inv.id          = run.id
    JOIN locations AS loc        ON loc.id          = inv.location_id
    JOIN (
        -- total quantity required per product for order 423
        SELECT product_id, SUM(qty) AS total_order_qty
        FROM orderlines
        WHERE order_id = 423
        GROUP BY product_id
    ) AS ord ON ord.product_id    = inv.product_id
) AS pick
WHERE pick.qty_to_pick > 0
ORDER BY pick.product_id, pick.aisle, pick.position;
