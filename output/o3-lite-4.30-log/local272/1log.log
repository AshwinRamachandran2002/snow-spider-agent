    SELECT  i."id"              AS "inventory_id",
            i."product_id",
            i."qty",
            p."purchased",
            l."aisle",
            l."position",
            SUM(i."qty") OVER (          -- running total before current row
                PARTITION BY i."product_id"
                ORDER BY p."purchased", i."qty", i."id"
                ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
