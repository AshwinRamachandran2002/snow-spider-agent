Relevant columns and how they will be used  
(only the columns that really matter for building the pick list for order 423)

orders.id     : id of the order we have to pick (423)  
orderlines.order_id : link every line back to the order (423)  
orderlines.product_id : which products are needed  
orderlines.qty   : quantity requested per line (sequence must be respected)  

inventory.product_id : connects inventory to the ordered product  
inventory.location_id : tells where the stock is stored  
inventory.qty    : quantity that can still be picked  
inventory.purchase_id : lets us find when that stock was bought (FIFO rule)  

purchases.id    : joins to inventory.purchase_id  
purchases.purchased : date of purchase – older first (FIFO)  

locations.id     : joins to inventory.location_id  
locations.warehouse : must be = 1 (only pick from warehouse 1)  
locations.aisle   : aisle to show on the picking list  
locations.position  : position (slot) inside the aisle  

Typical WHERE / JOIN conditions that will be used  
• orders.id = 423  
• orderlines.order_id = orders.id  
• inventory.product_id = orderlines.product_id  
• inventory.purchase_id = purchases.id  
• inventory.location_id = locations.id  
• locations.warehouse = 1  
• inventory.qty > 0  

Below are ten exploratory SQLite queries (LIMIT 20) that go from very simple
inspection to an almost‑complete pick‑allocation query.  
All names are wrapped in double quotes to stay on the safe side.

```sql
-- 1. Show every order‑line that belongs to order 423
SELECT *
FROM "orderlines"
WHERE "order_id" = 423
LIMIT 20;
```

```sql
-- 2. Aggregate the total quantity needed for each product in order 423
SELECT "product_id",
       SUM("qty") AS "total_order_qty"
FROM "orderlines"
WHERE "order_id" = 423
GROUP BY "product_id"
LIMIT 20;
```

```sql
-- 3. See raw inventory rows for the products in order 423 (all warehouses)
SELECT *
FROM "inventory"
WHERE "product_id" IN (
      SELECT "product_id"
      FROM "orderlines"
      WHERE "order_id" = 423)
LIMIT 20;
```

```sql
-- 4. Same as #3 but restricted to inventory that sits in warehouse 1
SELECT inv."id"          AS "inventory_id",
       inv."product_id",
       loc."aisle",
       loc."position",
       inv."qty"
FROM   "inventory"  AS inv
JOIN   "locations"  AS loc ON loc."id" = inv."location_id"
WHERE  loc."warehouse" = 1
  AND  inv."product_id" IN (
          SELECT "product_id"
          FROM   "orderlines"
          WHERE  "order_id" = 423)
LIMIT 20;
```

```sql
-- 5. Add purchase date to be able to apply FIFO later
SELECT inv."id"          AS "inventory_id",
       inv."product_id",
       pur."purchased",
       loc."aisle",
       loc."position",
       inv."qty"
FROM   "inventory" AS inv
JOIN   "purchases" AS pur ON pur."id" = inv."purchase_id"
JOIN   "locations" AS loc ON loc."id" = inv."location_id"
WHERE  loc."warehouse" = 1
  AND  inv."product_id" IN (
          SELECT "product_id"
          FROM   "orderlines"
          WHERE  "order_id" = 423)
ORDER BY pur."purchased"
LIMIT 20;
```

```sql
-- 6. FIFO + “smallest‑qty first” ordering inside each product
SELECT inv."id",
       inv."product_id",
       pur."purchased",
       loc."aisle",
       loc."position",
       inv."qty"
FROM   "inventory" AS inv
JOIN   "purchases" AS pur ON pur."id" = inv."purchase_id"
JOIN   "locations" AS loc ON loc."id" = inv."location_id"
WHERE  loc."warehouse" = 1
  AND  inv."product_id" IN (
          SELECT "product_id"
          FROM   "orderlines"
          WHERE  "order_id" = 423)
ORDER BY inv."product_id",         -- group per product
         pur."purchased",          -- oldest stock first
         inv."qty"                 -- then smaller lots first
LIMIT 20;
```

```sql
-- 7. Total on‑hand (warehouse 1) versus each product in the order
SELECT inv."product_id",
       SUM(inv."qty") AS "total_inventory_warehouse1"
FROM   "inventory" AS inv
JOIN   "locations" AS loc ON loc."id" = inv."location_id"
WHERE  loc."warehouse" = 1
  AND  inv."product_id" IN (
          SELECT "product_id"
          FROM   "orderlines"
          WHERE  "order_id" = 423)
GROUP BY inv."product_id"
LIMIT 20;
```

```sql
-- 8. Compare ordered quantity to available quantity (warehouse 1)
SELECT ord."product_id",
       ord."total_order_qty",
       inv."total_inventory_warehouse1"
FROM  (SELECT "product_id",
              SUM("qty") AS "total_order_qty"
       FROM   "orderlines"
       WHERE  "order_id" = 423
       GROUP BY "product_id")  AS ord
LEFT JOIN
      (SELECT inv."product_id",
              SUM(inv."qty") AS "total_inventory_warehouse1"
       FROM   "inventory" AS inv
       JOIN   "locations" AS loc ON loc."id" = inv."location_id"
       WHERE  loc."warehouse" = 1
       GROUP BY inv."product_id") AS inv
ON   inv."product_id" = ord."product_id"
LIMIT 20;
```

```sql
-- 9. Compute the exact quantity to pick from every inventory row
--    (window function tracks running total so we stop at ordered qty)
SELECT pick."inventory_id",
       pick."product_id",
       pick."aisle",
       pick."position",
       pick."qty_to_pick"
FROM (
    SELECT inv."id"  AS "inventory_id",
           inv."product_id",
           loc."aisle",
           loc."position",
           CASE                                    -- how much to take here?
             WHEN running_qty + inv."qty" <= ord."total_order_qty"
                  THEN inv."qty"                  -- take it all
             ELSE ord."total_order_qty" - running_qty
           END AS "qty_to_pick"
    FROM (
        SELECT inv."id",
               inv."product_id",
               inv."qty",
               pur."purchased",
               loc."aisle",
               loc."position",
               COALESCE(
                    SUM(inv."qty") OVER (
                       PARTITION BY inv."product_id"
                       ORDER BY pur."purchased", inv."qty"
                       ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING),
                    0)                             AS "running_qty"
        FROM   "inventory" AS inv
        JOIN   "purchases" AS pur ON pur."id" = inv."purchase_id"
        JOIN   "locations" AS loc ON loc."id" = inv."location_id"
        WHERE  loc."warehouse" = 1
          AND  inv."product_id" IN (
                  SELECT "product_id"
                  FROM   "orderlines"
                  WHERE  "order_id" = 423)
    ) AS inv
    JOIN (SELECT "product_id",
                 SUM("qty") AS "total_order_qty"
          FROM   "orderlines"
          WHERE  "order_id" = 423
          GROUP BY "product_id") AS ord
      ON ord."product_id" = inv."product_id"
) AS pick
WHERE pick."qty_to_pick" > 0
LIMIT 20;
```

```sql
-- 10. Final concise pick‑list (one row per location that supplies stock)
SELECT pick."product_id",
       pick."aisle",
       pick."position",
       SUM(pick."qty_to_pick") AS "pick_qty"
FROM  (
    /* same inner sub‑query as #9 */
    SELECT inv."id"  AS "inventory_id",
           inv."product_id",
           loc."aisle",
           loc."position",
           CASE
             WHEN running_qty + inv."qty" <= ord."total_order_qty"
                  THEN inv."qty"
             ELSE ord."total_order_qty" - running_qty
           END AS "qty_to_pick"
    FROM (
        SELECT inv."id",
               inv."product_id",
               inv."qty",
               pur."purchased",
               loc."aisle",
               loc."position",
               COALESCE(
                    SUM(inv."qty") OVER (
                       PARTITION BY inv."product_id"
                       ORDER BY pur."purchased", inv."qty"
                       ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING),
                    0) AS "running_qty"
        FROM   "inventory" AS inv
        JOIN   "purchases" AS pur ON pur."id" = inv."purchase_id"
        JOIN   "locations" AS loc ON loc."id" = inv."location_id"
        WHERE  loc."warehouse" = 1
          AND  inv."product_id" IN (
                  SELECT "product_id"
                  FROM   "orderlines"
                  WHERE  "order_id" = 423)
    ) AS inv
    JOIN (SELECT "product_id",
                 SUM("qty") AS "total_order_qty"
          FROM   "orderlines"
          WHERE  "order_id" = 423
          GROUP BY "product_id") AS ord
      ON ord."product_id" = inv."product_id"
) AS pick
WHERE pick."qty_to_pick" > 0
GROUP BY pick."product_id", pick."aisle", pick."position"
ORDER BY pick."product_id", pick."aisle", pick."position"
LIMIT 20;
```

These ten queries gradually expose the data needed and culminate in a
FIFO‑respecting, minimum‑split picking proposal that meets the exact ordered
quantities without exhausting any inventory location in warehouse 1.
