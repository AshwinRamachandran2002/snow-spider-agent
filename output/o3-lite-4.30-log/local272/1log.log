Query:
--Description: “Final concise pick‑list” fixed so that every column reference lives in the right
--scope.  The inner‑most subquery (inv_raw) brings in aisle/position; the middle layer (inv)
--carries them forward, so the outer CASE and SELECT now refer to inv.* – not to a vanished
--loc alias or an unscoped running_qty.  The result lists, per warehouse‑1 location, the exact
--quantity to pick for order 423, aggregated by product/aisle/position.
SELECT
    pick.product_id,
    pick.aisle,
    pick.position,
    SUM(pick.qty_to_pick) AS pick_qty
FROM (
    --------------------------------------------------------------------
    -- decide how much to take from each inventory row (FIFO + small lot)
    --------------------------------------------------------------------
    SELECT
        inv.inventory_id,
        inv.product_id,
        inv.aisle,
        inv.position,
        CASE
            WHEN inv.running_qty + inv.qty <= ord.total_order_qty
                 THEN inv.qty                         -- take entire lot
            ELSE ord.total_order_qty - inv.running_qty-- take remainder
        END AS qty_to_pick
    FROM (
        ---------------------------------------------------------------
        -- warehouse‑1 inventory rows, ordered FIFO with running total
        ---------------------------------------------------------------
        SELECT
            inv_raw.id   AS inventory_id,
            inv_raw.product_id,
            inv_raw.qty,
            pur.purchased,
            loc.aisle,
            loc.position,
            SUM(inv_raw.qty) OVER (
                PARTITION BY inv_raw.product_id
                ORDER BY pur.purchased, inv_raw.qty
                ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
            ) AS running_qty
        FROM inventory  AS inv_raw
        JOIN purchases  AS pur ON pur.id = inv_raw.purchase_id
        JOIN locations  AS loc ON loc.id = inv_raw.location_id
        WHERE loc.warehouse = 1
          AND inv_raw.product_id IN (
                SELECT product_id
                FROM orderlines
                WHERE order_id = 423
              )
    ) AS inv
    /* total quantity required per product in order 423 */
    JOIN (
        SELECT product_id, SUM(qty) AS total_order_qty
        FROM orderlines
        WHERE order_id = 423
        GROUP BY product_id
    ) AS ord ON ord.product_id = inv.product_id
) AS pick
WHERE pick.qty_to_pick > 0
GROUP BY pick.product_id, pick.aisle, pick.position
ORDER BY pick.product_id, pick.aisle, pick.position
LIMIT 20
