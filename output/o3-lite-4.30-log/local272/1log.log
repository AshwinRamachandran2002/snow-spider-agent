```sql
-- 9. Compute the exact quantity to pick from every inventory row
--    (window function tracks running total so we stop at ordered qty)
SELECT pick."inventory_id",
       pick."product_id",
       pick."aisle",
       pick."position",
       pick."qty_to_pick"
FROM (
    SELECT inv."id"  AS "inventory_id",
           inv."product_id",
           loc."aisle",
           loc."position",
           CASE                                    -- how much to take here?
             WHEN running_qty + inv."qty" <= ord."total_order_qty"
                  THEN inv."qty"                  -- take it all
             ELSE ord."total_order_qty" - running_qty
           END AS "qty_to_pick"
    FROM (
        SELECT inv."id",
               inv."product_id",
               inv."qty",
               pur."purchased",
               loc."aisle",
               loc."position",
               COALESCE(
                    SUM(inv."qty") OVER (
                       PARTITION BY inv."product_id"
                       ORDER BY pur."purchased", inv."qty"
                       ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING),
                    0)                             AS "running_qty"
        FROM   "inventory" AS inv
        JOIN   "purchases" AS pur ON pur."id" = inv."purchase_id"
        JOIN   "locations" AS loc ON loc."id" = inv."location_id"
        WHERE  loc."warehouse" = 1
          AND  inv."product_id" IN (
                  SELECT "product_id"
                  FROM   "orderlines"
                  WHERE  "order_id" = 423)
    ) AS inv
    JOIN (SELECT "product_id",
                 SUM("qty") AS "total_order_qty"
          FROM   "orderlines"
          WHERE  "order_id" = 423
          GROUP BY "product_id") AS ord
      ON ord."product_id" = inv."product_id"
) AS pick
WHERE pick."qty_to_pick" > 0
LIMIT 20;
```

