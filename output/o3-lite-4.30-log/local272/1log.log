               WHEN running_qty + qty <= order_qty    THEN qty
               ELSE order_qty - running_qty
            END AS "pick_qty"
    FROM    inv_ranked
)
SELECT  "product_id",
        "aisle",
        "position",
        ROUND(SUM("pick_qty"),4) AS "pick_qty"
FROM    pick_rows
WHERE   "pick_qty" > 0
GROUP BY "product_id", "aisle", "position"
ORDER BY "product_id",
         MIN("purchased") OVER (PARTITION BY "product_id", "aisle", "position"),
         "aisle", "position";
