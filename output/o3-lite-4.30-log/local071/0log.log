Begin Exploring Related Columns
Relevant tables / columns and how they will help  

cities  
• country_code_2 : country we want to rank  
• insert_date  : the calendar day the row was inserted — used to locate June‑2022 data and build day‑to‑day streaks  
Other columns (city_name, latitude …) are not needed for this task.

Typical date filter we will reuse  

WHERE insert_date BETWEEN '2022‑06‑01' AND '2022‑06‑30'   -- restrict to June‑2022 rows


10 exploratory → analytical queries
```sql
-- 1. All the insert dates we actually have in June‑2022 (deduplicated, sorted)
SELECT DISTINCT insert_date
FROM   cities
WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
ORDER  BY insert_date
LIMIT 20;

-- 2. Which countries have at least one city row in that month?
SELECT DISTINCT country_code_2
FROM   cities
WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
LIMIT 20;

-- 3. Number of June‑2022 rows per country
SELECT country_code_2,
       COUNT(*) AS june_rows
FROM   cities
WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
GROUP  BY country_code_2
ORDER  BY june_rows DESC
LIMIT 20;

-- 4. First and last June date for every country
SELECT country_code_2,
       MIN(insert_date) AS first_day,
       MAX(insert_date) AS last_day
FROM   cities
WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
GROUP  BY country_code_2
LIMIT 20;

-- 5. All June rows for one sample country (replace 'us' to inspect another)
SELECT insert_date, city_name
FROM   cities
WHERE  country_code_2 = 'us'
  AND  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
ORDER  BY insert_date
LIMIT 20;

-- 6. Assign a running day number inside each country (to help find gaps)
SELECT country_code_2,
       insert_date,
       ROW_NUMBER() OVER (PARTITION BY country_code_2
                          ORDER BY insert_date)       AS rn
FROM   cities
WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
LIMIT 20;

-- 7. Transform dates to Julian day numbers and compute a “gap id”
--    Consecutive dates share the same (julian_day - rn) value.
WITH j AS (
  SELECT country_code_2,
         insert_date,
         JULIANDAY(insert_date)                AS jd,
         ROW_NUMBER() OVER (PARTITION BY country_code_2
                            ORDER BY insert_date) AS rn
  FROM   cities
  WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
)
SELECT country_code_2,
       insert_date,
       jd - rn          AS gap_id
FROM   j
ORDER  BY country_code_2, insert_date
LIMIT 20;

-- 8. Length of every consecutive‐day streak per country
WITH j AS (
  SELECT country_code_2,
         insert_date,
         JULIANDAY(insert_date) -
         ROW_NUMBER() OVER (PARTITION BY country_code_2
                            ORDER BY insert_date) AS gap_id
  FROM   cities
  WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
)
SELECT country_code_2,
       gap_id,
       COUNT(*) AS streak_len,
       MIN(insert_date) AS streak_start,
       MAX(insert_date) AS streak_end
FROM   j
GROUP  BY country_code_2, gap_id
ORDER  BY streak_len DESC
LIMIT 20;

-- 9. Maximum streak length each country achieved in June‑2022
WITH j AS (
  SELECT country_code_2,
         JULIANDAY(insert_date) -
         ROW_NUMBER() OVER (PARTITION BY country_code_2
                            ORDER BY insert_date) AS gap_id
  FROM   cities
  WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
),
streaks AS (
  SELECT country_code_2,
         COUNT(*) AS streak_len
  FROM   j
  GROUP  BY country_code_2, gap_id
)
SELECT country_code_2,
       MAX(streak_len) AS max_streak_len
FROM   streaks
GROUP  BY country_code_2
ORDER  BY max_streak_len DESC
LIMIT 20;

-- 10. Final answer – country codes that share the overall longest streak
WITH j AS (
  SELECT country_code_2,
         JULIANDAY(insert_date) -
         ROW_NUMBER() OVER (PARTITION BY country_code_2
                            ORDER BY insert_date) AS gap_id
  FROM   cities
  WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
),
streaks AS (
  SELECT country_code_2,
         COUNT(*) AS streak_len
  FROM   j
  GROUP  BY country_code_2, gap_id
),
max_each AS (
  SELECT country_code_2,
         MAX(streak_len) AS max_streak_len
  FROM   streaks
  GROUP  BY country_code_2
),
overall AS (
  SELECT MAX(max_streak_len) AS global_max
  FROM   max_each
)
SELECT m.country_code_2
FROM   max_each  AS m
JOIN   overall   AS o
  ON   m.max_streak_len = o.global_max;
```
