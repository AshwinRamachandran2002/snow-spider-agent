```sql
--Description / Thinking process:
-- 1. Repositories to keep: those whose LANGUAGES.language string does NOT mention “python”.
-- 2. Denominator (total_files): every file (any path) coming from those repositories.
-- 3. Numerator: among the same set, files whose path contains “readme.md”
--    AND whose full text contains “Copyright (c)” (both case‑insensitive).
-- 4. Join SAMPLE_FILES to LANGUAGES for repo filtering, then left‑join
--    SAMPLE_CONTENTS on file id to inspect content.
-- 5. Aggregate counts and compute proportion using NULLIF(denominator,0)
--    to avoid a divide‑by‑zero error.
SELECT
       SUM( CASE WHEN f."path" ILIKE '%readme.md%'
                  AND c."content" ILIKE '%copyright %(c)%'
                 THEN 1 ELSE 0 END
           )::FLOAT
       /
       NULLIF( COUNT(*), 0 )                                AS "proportion_readme_with_copyright"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"        AS f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"           AS l
       ON f."repo_name" = l."repo_name"
LEFT  JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
       ON f."id" = c."id"
WHERE  l."language" NOT ILIKE '%python%';
```
