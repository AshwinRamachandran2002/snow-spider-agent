Begin Exploring Related Columns
Relevant columns and their potential usages:

• LANGUAGES."repo_name": repository identifier – lets us decide which repos to keep / exclude.  
• LANGUAGES."language": Variant‑typed list / string of the languages a repo uses – used to eliminate repos whose language list (case‑insensitively) contains the substring “python”.  
• SAMPLE_FILES."repo_name": repository identifier – used to join to LANGUAGES so we only look at files that belong to repos we kept.  
• SAMPLE_FILES."path": full path of every file – lets us pick only those paths that include “readme.md”.  
• SAMPLE_FILES."id": blob‐sha of the file – used to join to SAMPLE_CONTENTS in order to read the file body.  
• SAMPLE_CONTENTS."id": same blob‑sha, allows us to look‑up the text body of each file chosen in SAMPLE_FILES.  
• SAMPLE_CONTENTS."content": full textual contents – searched for the phrase “Copyright (c)”.  

Below are ten exploratory Snowflake SQL queries (each limited to 20 rows) that gradually build toward the final computation.  
All column names are enclosed in double quotations and every query is preceded by a short comment.

```sql
-- 1. List a few distinct language strings just to see what the raw values look like
SELECT DISTINCT CAST("language" AS STRING) AS "language_str"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"
LIMIT 20;
```

```sql
-- 2. Show some repositories whose language list includes the substring 'python'
SELECT "repo_name",
       CAST("language" AS STRING) AS "language_str"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"
WHERE CAST("language" AS STRING) ILIKE '%python%'
LIMIT 20;
```

```sql
-- 3. Show some repositories whose language list does NOT include 'python'
SELECT "repo_name",
       CAST("language" AS STRING) AS "language_str"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"
WHERE CAST("language" AS STRING) NOT ILIKE '%python%'
LIMIT 20;
```

```sql
-- 4. Display a sample of files that belong to repos without any 'python' language usage
SELECT f."repo_name",
       f."path",
       f."id"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"     l
  ON f."repo_name" = l."repo_name"
WHERE CAST(l."language" AS STRING) NOT ILIKE '%python%'
LIMIT 20;
```

```sql
-- 5. Narrow those files down to ones whose paths contain 'readme.md'
SELECT f."repo_name",
       f."path",
       f."id"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"     l
  ON f."repo_name" = l."repo_name"
WHERE CAST(l."language" AS STRING) NOT ILIKE '%python%'
  AND f."path" ILIKE '%readme.md%'                 -- case‑insensitive match
LIMIT 20;
```

```sql
-- 6. Join to SAMPLE_CONTENTS so we can look at file contents for those README files
SELECT f."repo_name",
       f."path",
       c."size",
       c."content"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"     l
  ON f."repo_name" = l."repo_name"
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
  ON c."id" = f."id"
WHERE CAST(l."language" AS STRING) NOT ILIKE '%python%'
  AND f."path" ILIKE '%readme.md%'
LIMIT 20;
```

```sql
-- 7. Same join as above but further filter to README files whose content contains 'Copyright (c)'
SELECT f."repo_name",
       f."path",
       LEFT(c."content", 200) AS "content_snippet"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"     l
  ON f."repo_name" = l."repo_name"
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
  ON c."id" = f."id"
WHERE CAST(l."language" AS STRING) NOT ILIKE '%python%'
  AND f."path" ILIKE '%readme.md%'
  AND c."content" ILIKE '%copyright (c)%'
LIMIT 20;
```

```sql
-- 8. Count of README.md files in repos without Python
SELECT COUNT(*) AS "total_readme_md_files"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"     l
  ON f."repo_name" = l."repo_name"
WHERE CAST(l."language" AS STRING) NOT ILIKE '%python%'
  AND f."path" ILIKE '%readme.md%'
LIMIT 20;
```

```sql
-- 9. Count of README.md files (same population) whose content contains 'Copyright (c)'
SELECT COUNT(*) AS "copyright_readme_md_files"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"     l
  ON f."repo_name" = l."repo_name"
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
  ON c."id" = f."id"
WHERE CAST(l."language" AS STRING) NOT ILIKE '%python%'
  AND f."path" ILIKE '%readme.md%'
  AND c."content" ILIKE '%copyright (c)%'
LIMIT 20;
```

```sql
-- 10. Compute the proportion of README.md files that contain the phrase, for repos without Python
SELECT
    (COUNT_IF(c."content" ILIKE '%copyright (c)%')
     ::FLOAT)
  / NULLIF(COUNT(*), 0)                           AS "proportion_copyright_in_readme_md"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"     l
  ON f."repo_name" = l."repo_name"
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
  ON c."id" = f."id"
WHERE CAST(l."language" AS STRING) NOT ILIKE '%python%'
  AND f."path" ILIKE '%readme.md%'
LIMIT 20;
```

