  CAST(wdsp AS FLOAT64) AS wdsp,
  prcp
FROM `bigquery-public-data.noaa_gsod.gsod2020`
WHERE stn = '725030'
  AND mo = '06'
  AND da = '12'
LIMIT 20;
```

```sql
--Description: 5.  See which of the years 2011‑2020 actually have a June‑12 record.
