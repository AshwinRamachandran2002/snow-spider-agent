SELECT DISTINCT year
FROM `bigquery-public-data.noaa_gsod.gsod2020`
WHERE stn = '725030'
  AND mo = '06'
  AND da = '12'
LIMIT 20;
```

```sql
--Description: 6.  Bring back the June‑12 row for every year 2011‑2015 in one shot.
SELECT
  year,
  temp,
  CAST(wdsp AS FLOAT64) AS wdsp,
  prcp
FROM `bigquery-public-data.noaa_gsod.gsod201*`      -- 2011‑2015 fall in this pattern
WHERE stn = '725030'
  AND mo = '06'
  AND da = '12'
  AND year BETWEEN '2011' AND '2015'
ORDER BY year
LIMIT 20;
```

```sql
--Description: 7.  Same idea for 2016‑2020 (requires two wildcards because of '2020').
SELECT
  year,
  temp,
  CAST(wdsp AS FLOAT64) AS wdsp,
  prcp
FROM `bigquery-public-data.noaa_gsod.gsod20*`
WHERE stn = '725030'
  AND mo = '06'
  AND da = '12'
  AND year BETWEEN '2016' AND '2020'
ORDER BY year
LIMIT 20;
```

```sql
--Description: 8.  Combine 2011‑2020 with UNION ALL and calculate a single‑day “avg” (same as value).
SELECT
  year,
  AVG(temp)                       AS avg_temp_f,
  AVG(CAST(wdsp AS FLOAT64))      AS avg_wdsp_kt,
  AVG(prcp)                       AS prcp_in
FROM (
  SELECT * FROM `bigquery-public-data.noaa_gsod.gsod201*`
  UNION ALL
  SELECT * FROM `bigquery-public-data.noaa_gsod.gsod2020`
)
WHERE stn = '725030'
  AND mo = '06'
  AND da = '12'
  AND year BETWEEN '2011' AND '2020'
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--Description: 9.  Same as #8 but round output and remove missing‑value rows (99 / 9999 codes).
SELECT
  year,
  ROUND(AVG(NULLIF(temp , 9999.9)), 1)              AS avg_temp_f,
  ROUND(AVG(NULLIF(CAST(wdsp AS FLOAT64), 999.9)),1) AS avg_wdsp_kt,
  ROUND(AVG(NULLIF(prcp , 99.99)), 2)                AS prcp_in
FROM (
  SELECT * FROM `bigquery-public-data.noaa_gsod.gsod201*`
  UNION ALL
  SELECT * FROM `bigquery-public-data.noaa_gsod.gsod2020`
)
WHERE stn = '725030'
  AND mo = '06'
  AND da = '12'
  AND year BETWEEN '2011' AND '2020'
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--Description: 10.  Final concise answer query for the entire 2011‑2020 span (ready for production; remove LIMIT when done).
