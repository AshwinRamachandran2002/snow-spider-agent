--Description: To deliver the requested 12‑June climatology for LaGuardia (station 725030)
--             from 2011‑2020 in one step, we must:
--             1) UNION the yearly tables, but first project the exact same columns
--                (year, temp, wdsp, prcp, stn, mo, da) so every SELECT has an
--                identical schema and avoids the previous “mismatched column count”.
--             2) Filter for month 06, day 12, station 725030, and years 2011‑2020.
--             3) Convert wind‑speed (wdsp) to FLOAT64, strip the NOAA “missing‑value”
--                codes (9999.9, 999.9, 99.99) with NULLIF, and then compute rounded
--                averages for temperature (°F), wind speed (kt), and precipitation (in).
SELECT
  year                                                            AS obs_year,
  ROUND(AVG(NULLIF(temp , 9999.9)), 1)               AS mean_temp_f,
  ROUND(AVG(NULLIF(CAST(wdsp AS FLOAT64), 999.9)),1) AS mean_wind_speed_kt,
  ROUND(AVG(NULLIF(prcp , 99.99)), 2)                AS precip_in
