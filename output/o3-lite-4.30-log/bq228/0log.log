FROM `bigquery-public-data.london_crime.crime_by_lsoa`
LIMIT 20;
```

```sql
-- 3. Verify the exact spelling of the borough we need
SELECT DISTINCT borough
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE LOWER(borough) LIKE '%barking%'
LIMIT 20;
```

```sql
-- 4. List all major categories that appear in Barking and Dagenham
SELECT DISTINCT major_category
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Barking and Dagenham'
LIMIT 20;
```

```sql
-- 5. Look at minor categories inside one major category for the borough
SELECT DISTINCT minor_category
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Barking and Dagenham'
  AND major_category = 'Violence Against the Person'
LIMIT 20;
```

```sql
-- 6. Show monthly figures for one major category (sanity‑check ‘value’)
SELECT year, month, SUM(value) AS incidents
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Barking and Dagenham'
  AND major_category = 'Violence Against the Person'
GROUP BY year, month
ORDER BY year, month
LIMIT 20;
```

```sql
-- 7. Yearly totals for every major category in the borough
SELECT year, major_category, SUM(value) AS incidents
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Barking and Dagenham'
GROUP BY year, major_category
ORDER BY year, major_category
LIMIT 20;
```

```sql
-- 8. Total offences (all years) by major category, unsorted
SELECT major_category, SUM(value) AS incidents
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Barking and Dagenham'
GROUP BY major_category
LIMIT 20;
```

```sql
-- 9. Same as #8 but ordered to see the descending ranking
SELECT major_category, SUM(value) AS incidents
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Barking and Dagenham'
GROUP BY major_category
ORDER BY incidents DESC
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER – top three major crime categories in Barking and Dagenham
SELECT
  major_category,
  SUM(value) AS incidents
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Barking and Dagenham'
GROUP BY major_category
ORDER BY incidents DESC
LIMIT 3;
