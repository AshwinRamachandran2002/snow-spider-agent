Begin Exploring Related Columns
Relevant columns and their possible usage for the task “ How many distinct users viewed the most frequently visited page during January 2021? ”

• event_date : restrict rows to 20210101 … 20210131 (January 2021)  
• event_name : keep only the GA4 event that represents a page view (usually ‘page_view’)  
• event_params : unpack to obtain the page identifier – commonly the key = 'page_location' (full URL) or 'page_title' (title)  
• user_pseudo_id : treat as the user identifier; count DISTINCT values to know how many users saw a page  
• _TABLE_SUFFIX (pseudo‑column when querying with wildcards) : lets us query all daily tables in one shot and still limit them to the January 2021 range  

Typical filter conditions  
  WHERE event_name = 'page_view'  
    AND _TABLE_SUFFIX BETWEEN '20210101' AND '20210131'  

10 exploration → solution queries
(Each query is limited to 20 rows so it can be run safely. Replace **project.dataset** with the actual names shown below.)

```sql
-- 1.  List all GA4 event names that appear on one January day
SELECT DISTINCT event_name
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210101`
LIMIT 20;
```

```sql
-- 2.  Look at all parameter keys for a single page_view event record
SELECT ep.key, ep.value.string_value, ep.value.int_value
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210101`,
UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
LIMIT 20;
```

```sql
-- 3.  Check a few sample values of page_location on 9 Jan 2021
SELECT ep.value.string_value AS page_location
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210109`,
UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
LIMIT 20;
```

```sql
-- 4.  Count page views per page_location for 9 Jan 2021
SELECT
  ep.value.string_value AS page_location,
  COUNT(*) AS pv
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210109`,
UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
GROUP BY page_location
ORDER BY pv DESC
LIMIT 20;
```

```sql
-- 5.  Same as #4 but for two specific dates to see stability
SELECT
  _TABLE_SUFFIX AS event_day,
  ep.value.string_value AS page_location,
  COUNT(*) AS pv
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_2021010*`,
UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
GROUP BY event_day, page_location
ORDER BY pv DESC
LIMIT 20;
```

```sql
-- 6.  Aggregate page_view counts for the whole month of Jan 2021
SELECT
  ep.value.string_value AS page_location,
  COUNT(*) AS page_views
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
  AND _TABLE_SUFFIX BETWEEN '20210101' AND '20210131'
GROUP BY page_location
ORDER BY page_views DESC
LIMIT 20;
```

```sql
-- 7.  Identify the single most visited page for January 2021
SELECT
  ep.value.string_value AS page_location,
  COUNT(*) AS page_views
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
  AND _TABLE_SUFFIX BETWEEN '20210101' AND '20210131'
GROUP BY page_location
ORDER BY page_views DESC
LIMIT 1;
```

```sql
-- 8.  Verify what other identifiers are present for that top page
WITH top_page AS (
  SELECT ep.value.string_value AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(event_params) AS ep
  WHERE event_name = 'page_view'
    AND ep.key = 'page_location'
    AND _TABLE_SUFFIX BETWEEN '20210101' AND '20210131'
  GROUP BY page_location
  ORDER BY COUNT(*) DESC
  LIMIT 1
)
SELECT DISTINCT ep.key
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
UNNEST(event_params) AS ep,
top_page
WHERE event_name = 'page_view'
  AND ep.value.string_value = top_page.page_location
  AND _TABLE_SUFFIX BETWEEN '20210101' AND '20210131'
LIMIT 20;
```

```sql
-- 9.  List 20 sample users who viewed the (still unknown) most visited page
WITH top_page AS (
  SELECT ep.value.string_value AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(event_params) AS ep
  WHERE event_name = 'page_view'
    AND ep.key = 'page_location'
    AND _TABLE_SUFFIX BETWEEN '20210101' AND '20210131'
  GROUP BY page_location
  ORDER BY COUNT(*) DESC
  LIMIT 1
)
SELECT DISTINCT user_pseudo_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
     UNNEST(event_params) AS ep,
     top_page
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
  AND ep.value.string_value = top_page.page_location
  AND _TABLE_SUFFIX BETWEEN '20210101' AND '20210131'
LIMIT 20;
```

```sql
-- 10.  FINAL ANSWER: how many distinct users viewed the most visited page in Jan 2021
WITH top_page AS (
  SELECT ep.value.string_value AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(event_params) AS ep
  WHERE event_name = 'page_view'
    AND ep.key = 'page_location'
    AND _TABLE_SUFFIX BETWEEN '20210101' AND '20210131'
  GROUP BY page_location
  ORDER BY COUNT(*) DESC
  LIMIT 1
)
SELECT
  top_page.page_location AS most_visited_page,
  COUNT(DISTINCT user_pseudo_id) AS distinct_users_viewed
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
     UNNEST(event_params) AS ep,
     top_page
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
  AND ep.value.string_value = top_page.page_location
  AND _TABLE_SUFFIX BETWEEN '20210101' AND '20210131'
LIMIT 20;
```

Running query 10 will output one row with the page URL (or title) and the number of unique GA4 users who saw it in January 2021.
