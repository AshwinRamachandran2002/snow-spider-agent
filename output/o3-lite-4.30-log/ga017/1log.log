FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210109`,
UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
LIMIT 20;
```

```sql
-- 4.  Count page views per page_location for 9 Jan 2021
SELECT
  ep.value.string_value AS page_location,
  COUNT(*) AS pv
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210109`,
UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
GROUP BY page_location
ORDER BY pv DESC
LIMIT 20;
```

```sql
-- 5.  Same as #4 but for two specific dates to see stability
SELECT
  _TABLE_SUFFIX AS event_day,
  ep.value.string_value AS page_location,
  COUNT(*) AS pv
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_2021010*`,
UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
GROUP BY event_day, page_location
ORDER BY pv DESC
LIMIT 20;
```

```sql
-- 6.  Aggregate page_view counts for the whole month of Jan 2021
SELECT
  ep.value.string_value AS page_location,
  COUNT(*) AS page_views
