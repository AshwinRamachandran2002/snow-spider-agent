--date range, joins each event record to the single‑row CTE, filters rows whose
--page_location equals the top URL, and finally counts DISTINCT user_pseudo_id.  The
--result is one row: the URL and the number of unique users who saw it.

WITH top_page AS (
  SELECT
    ep.value.string_value AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(event_params) AS ep
  WHERE event_name = 'page_view'
    AND ep.key = 'page_location'
    AND _TABLE_SUFFIX BETWEEN '20210101' AND '20210131'
  GROUP BY page_location
  ORDER BY COUNT(*) DESC
  LIMIT 1
)

SELECT
  tp.page_location                 AS most_visited_page,
  COUNT(DISTINCT e.user_pseudo_id) AS distinct_users_viewed
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
CROSS JOIN top_page tp
JOIN UNNEST(e.event_params) AS ep
WHERE e.event_name = 'page_view'
  AND ep.key = 'page_location'
  AND ep.value.string_value = tp.page_location
  AND _TABLE_SUFFIX BETWEEN '20210101' AND '20210131'
GROUP BY tp.page_location;
