```sql
-- 10.  FINAL ANSWER: how many distinct users viewed the most visited page in Jan 2021
WITH top_page AS (
  SELECT ep.value.string_value AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(event_params) AS ep
  WHERE event_name = 'page_view'
    AND ep.key = 'page_location'
    AND _TABLE_SUFFIX BETWEEN '20210101' AND '20210131'
  GROUP BY page_location
  ORDER BY COUNT(*) DESC
  LIMIT 1
)
SELECT
  top_page.page_location AS most_visited_page,
  COUNT(DISTINCT user_pseudo_id) AS distinct_users_viewed
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
     UNNEST(event_params) AS ep,
     top_page
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
  AND ep.value.string_value = top_page.page_location
  AND _TABLE_SUFFIX BETWEEN '20210101' AND '20210131'
LIMIT 20;
```

