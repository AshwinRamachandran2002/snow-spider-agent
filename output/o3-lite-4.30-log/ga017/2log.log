Relevant columns and their possible usage  
• event_date : restrict the scan to January 2021 ( '20210101'‑'20210131' )  
• event_name : keep only page‑view events ( event_name = 'page_view' )  
• event_params.key / event_params.value.string_value : take the value of the
  parameter where key = 'page_location' (full page URL) – this tells us which
  page was visited.  
• user_pseudo_id : the anonymous user identifier; use DISTINCT on it to count
  unique users.  

Typical conditions  
• WHERE event_name = 'page_view'  
• AND event_date BETWEEN '20210101' AND '20210131'  
• AND ep.key = 'page_location'  

Below are ten exploration queries, from very simple inspection to the final
one that returns the number of distinct users who viewed the single most
frequently visited page in January 2021.  
(Replace any optional LIMIT value if you want more rows – every query is
capped at 20 rows here.)

```sql
-- 1. Peek at a handful of raw rows from 1‑Jan‑2021
SELECT event_date,
       event_name,
       user_pseudo_id
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210101`
LIMIT  20;
```

```sql
-- 2. List all distinct event names occurring on 1‑Jan‑2021
SELECT DISTINCT event_name
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210101`
LIMIT  20;
```

```sql
-- 3. Extract all key/value pairs stored in event_params for one day
SELECT ep.key,
       ep.value.string_value,
       ep.value.int_value
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210101`,
       UNNEST(event_params) AS ep
WHERE  event_name = 'page_view'
LIMIT  20;
```

```sql
-- 4. Pull the page_location parameter for 1‑Jan‑2021
SELECT ep.value.string_value  AS page_location,
       user_pseudo_id
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210101`,
       UNNEST(event_params) AS ep
WHERE  event_name = 'page_view'
  AND  ep.key = 'page_location'
LIMIT  20;
```

```sql
-- 5. Count the top‑visited pages on 1‑Jan‑2021
SELECT ep.value.string_value  AS page_location,
       COUNT(*)               AS pageviews
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210101`,
       UNNEST(event_params) AS ep
WHERE  event_name = 'page_view'
  AND  ep.key   = 'page_location'
GROUP BY page_location
ORDER BY pageviews DESC
LIMIT  20;
```

```sql
-- 6. Same idea, but for the whole month of January 2021
SELECT ep.value.string_value  AS page_location,
       COUNT(*)               AS pageviews
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
       UNNEST(event_params) AS ep
WHERE  event_name = 'page_view'
  AND  ep.key   = 'page_location'
GROUP BY page_location
ORDER BY pageviews DESC
LIMIT  20;
```

```sql
-- 7. Identify the single most‑frequently visited page in January 2021
SELECT ep.value.string_value  AS page_location,
       COUNT(*)               AS pageviews
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
       UNNEST(event_params) AS ep
WHERE  event_name = 'page_view'
  AND  ep.key   = 'page_location'
GROUP BY page_location
ORDER BY pageviews DESC
LIMIT  1;
```

```sql
-- 8. Show up to 20 user IDs who visited that top page (sub‑query for page)
WITH top_page AS (
  SELECT ep.value.string_value AS page_location
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
         UNNEST(event_params) AS ep
  WHERE  event_name = 'page_view'
    AND  ep.key   = 'page_location'
  GROUP BY page_location
  ORDER BY COUNT(*) DESC
  LIMIT 1
)
SELECT DISTINCT e.user_pseudo_id
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*` AS e
JOIN   UNNEST(e.event_params) AS ep
       ON TRUE
JOIN   top_page tp
       ON ep.key = 'page_location'
      AND ep.value.string_value = tp.page_location
WHERE  e.event_name = 'page_view'
LIMIT  20;
```

```sql
-- 9. Count how many distinct users visited that top page
WITH top_page AS (
  SELECT ep.value.string_value AS page_location
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
         UNNEST(event_params) AS ep
  WHERE  event_name = 'page_view'
    AND  ep.key   = 'page_location'
  GROUP BY page_location
  ORDER BY COUNT(*) DESC
  LIMIT 1
)
SELECT COUNT(DISTINCT e.user_pseudo_id) AS distinct_users
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*` AS e
JOIN   UNNEST(e.event_params) AS ep
       ON TRUE
JOIN   top_page tp
       ON ep.key = 'page_location'
      AND ep.value.string_value = tp.page_location
WHERE  e.event_name = 'page_view'
LIMIT  20;
```

```sql
-- 10. Everything in one shot – page URL, total views, distinct users
SELECT tp.page_location,
       tp.pageviews,
       COUNT(DISTINCT e.user_pseudo_id) AS distinct_users
FROM  (
        -- derive the top page
        SELECT ep.value.string_value AS page_location,
               COUNT(*)               AS pageviews
        FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
               UNNEST(event_params) AS ep
        WHERE  event_name = 'page_view'
          AND  ep.key   = 'page_location'
        GROUP  BY page_location
        ORDER  BY pageviews DESC
        LIMIT  1
      ) AS tp
JOIN  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*` AS e
      ON TRUE
JOIN  UNNEST(e.event_params) AS ep
      ON ep.key = 'page_location'
     AND ep.value.string_value = tp.page_location
WHERE e.event_name = 'page_view'
GROUP BY tp.page_location,
         tp.pageviews
LIMIT  20;
```

