Begin Exploring Related Columns
Relevant tables / columns and how they will be used  

• races  
  – race_id : joins to results to know in which round / year a driver took part.  
  – year : groups a season.  
  – round : ordering of the races inside every season (used to detect gaps).  

• results  
  – race_id : joins to races.  
  – driver_id : identifies the driver.  
  – constructor_id : team with which the driver entered that race (used to check if the driver switched teams before / after the hiatus).  

Those three columns are all that are strictly necessary for the requested calculation, but several other columns can help with inspection / validation:

• results.position_text / results.points : show that the row really represents a classified entry (not strictly needed for the calculation, but useful to inspect).  
• races.name : human‑readable grand‑prix name when checking results manually.  

Below are ten exploratory SQL queries (each limited to 20 rows) that gradually build an understanding of the data needed to craft the final solution.

```sql
-- 1. Show how many rounds exist in every season (top 20 seasons)
SELECT r.year,
       COUNT(*) AS rounds_in_season
FROM races AS r
GROUP BY r.year
ORDER BY r.year
LIMIT 20;
```

```sql
-- 2. List all distinct drivers that have ever started a race (sample 20)
SELECT DISTINCT driver_id
FROM results
LIMIT 20;
```

```sql
-- 3. List the races a particular driver (e.g. driver_id = 1) entered in 2009
SELECT r.year,
       r.round,
       r.name,
       res.constructor_id
FROM results  AS res
JOIN races    AS r  ON r.race_id = res.race_id
WHERE res.driver_id = 1
  AND r.year = 2009
ORDER BY r.round
LIMIT 20;
```

```sql
-- 4. See the gaps (missed rounds) of driver_id = 1 in 2009
--   (compare against all rounds of the season)
SELECT all_rounds.round,
       CASE WHEN res.driver_id IS NULL THEN 'MISSED' ELSE 'STARTED' END AS race_presence
FROM ( SELECT round
       FROM races
       WHERE year = 2009 ) AS all_rounds
LEFT JOIN (
       SELECT r.round,
              res.driver_id
       FROM results AS res
       JOIN races   AS r ON r.race_id = res.race_id
       WHERE res.driver_id = 1
         AND r.year = 2009
) AS res
ON res.round = all_rounds.round
ORDER BY all_rounds.round
LIMIT 20;
```

```sql
-- 5. Find all “hiatus segments” for every driver/year where fewer than three
--    consecutive rounds were missed
WITH driver_rounds AS (
    SELECT r.year,
           r.round,
           res.driver_id
    FROM races AS r
    LEFT JOIN results AS res
           ON res.race_id = r.race_id
)
SELECT *
FROM driver_rounds
WHERE driver_id IS NULL   -- rows that were missed
LIMIT 20;
```

```sql
-- 6. Bring in the constructor from the race BEFORE and AFTER a hiatus
--    (simplified to one driver/year for investigation)
WITH season AS (
    SELECT r.round,
           res.constructor_id,
           res.driver_id
    FROM races   AS r
    LEFT JOIN results AS res
           ON res.race_id = r.race_id
    WHERE r.year = 2009
      AND (res.driver_id = 1 OR res.driver_id IS NULL)
)
SELECT *
FROM season
ORDER BY round
LIMIT 20;
```

```sql
-- 7. Verify that constructor IDs differ immediately before & after the hiatus
--    (again for one driver/year, shows neighbouring rounds)
WITH season AS (
    SELECT r.round,
           res.constructor_id,
           res.driver_id
    FROM races   AS r
    LEFT JOIN results AS res
           ON res.race_id = r.race_id
    WHERE r.year = 2009
      AND (res.driver_id = 1 OR res.driver_id IS NULL)
),
gaps AS (
    SELECT s.round                                                 AS missed_round,
           LAG(s.constructor_id)  OVER (ORDER BY s.round)         AS constructor_before,
           LEAD(s.constructor_id) OVER (ORDER BY s.round)         AS constructor_after
    FROM season AS s
    WHERE s.driver_id IS NULL
)
SELECT *
FROM gaps
WHERE constructor_before IS NOT NULL
  AND constructor_after  IS NOT NULL
  AND constructor_before <> constructor_after
LIMIT 20;
```

```sql
-- 8. Count consecutive missed rounds for every driver/year (dense_rank trick)
WITH driver_calendar AS (
    SELECT r.year,
           r.round,
           COALESCE(res.driver_id, -1)  AS driver_id        -- -1 marks “no entry”
    FROM races AS r
    LEFT JOIN results AS res ON res.race_id = r.race_id
),
seq AS (
    SELECT year,
           round,
           driver_id,
           round - ROW_NUMBER() OVER (PARTITION BY year, driver_id ORDER BY round) AS grp
    FROM driver_calendar
)
SELECT year,
       driver_id,
       MIN(round)  AS first_round,
       MAX(round)  AS last_round,
       COUNT(*)    AS gap_len
FROM seq
WHERE driver_id = -1       -- missed races
GROUP BY year, grp
HAVING COUNT(*) < 3
LIMIT 20;
```

```sql
-- 9. Attach constructor_before / constructor_after for those small gaps
WITH driver_calendar AS (
    SELECT r.year,
           r.round,
           res.driver_id,
           res.constructor_id
    FROM races AS r
    LEFT JOIN results AS res ON res.race_id = r.race_id
),
seq AS (
    SELECT *,
           (round - ROW_NUMBER() OVER (PARTITION BY year, driver_id ORDER BY round)) AS grp
    FROM driver_calendar
),
gaps AS (
    SELECT year,
           grp,
           MIN(round)  AS first_missed_round,
           MAX(round)  AS last_missed_round,
           COUNT(*)    AS gap_len
    FROM seq
    WHERE driver_id IS NULL
    GROUP BY year, grp
    HAVING COUNT(*) < 3
),
constructors AS (
    SELECT g.*,
           ( SELECT constructor_id
             FROM driver_calendar AS dc
             WHERE dc.year  = g.year
               AND dc.round = g.first_missed_round - 1
             LIMIT 1) AS constructor_before,
           ( SELECT constructor_id
             FROM driver_calendar AS dc
             WHERE dc.year  = g.year
               AND dc.round = g.last_missed_round + 1
             LIMIT 1) AS constructor_after
    FROM gaps AS g
)
SELECT *
FROM constructors
WHERE constructor_before IS NOT NULL
  AND constructor_after  IS NOT NULL
  AND constructor_before <> constructor_after
LIMIT 20;
```

```sql
-- 10. (Near‑final) Compute overall averages of first & last missed rounds
--     across all qualifying hiatuses (no per‑year grouping)
WITH driver_calendar AS (
    SELECT r.year,
           r.round,
           res.driver_id,
           res.constructor_id
    FROM races AS r
    LEFT JOIN results AS res ON res.race_id = r.race_id
),
seq AS (
    SELECT *,
           (round - ROW_NUMBER()
                    OVER (PARTITION BY year, driver_id ORDER BY round)) AS grp
    FROM driver_calendar
),
missed AS (
    SELECT year,
           driver_id,
           grp,
           MIN(round) AS first_round,
           MAX(round) AS last_round,
           COUNT(*)   AS missed_races
    FROM seq
    WHERE driver_id IS NULL               -- races the driver did NOT start
    GROUP BY year, driver_id, grp
    HAVING COUNT(*) < 3                   -- fewer than three missed races
),
valid_gaps AS (
    SELECT m.*,
           -- constructor right before gap
           (SELECT constructor_id
            FROM driver_calendar dc
            WHERE dc.year  = m.year
              AND dc.driver_id = m.driver_id
              AND dc.round = m.first_round - 1
            LIMIT 1) AS constructor_before,
           -- constructor right after gap
           (SELECT constructor_id
            FROM driver_calendar dc
            WHERE dc.year  = m.year
              AND dc.driver_id = m.driver_id
              AND dc.round = m.last_round + 1
            LIMIT 1) AS constructor_after
    FROM missed m
),
filtered_gaps AS (
    SELECT *
    FROM valid_gaps
    WHERE constructor_before IS NOT NULL
      AND constructor_after  IS NOT NULL
      AND constructor_before <> constructor_after   -- switched teams
)
SELECT AVG(first_round) AS avg_first_missed_round,
       AVG(last_round)  AS avg_last_missed_round
FROM filtered_gaps;
```

Each query incrementally inspects or builds a part of the logic required to calculate the “overall average first round” and “overall average last round” of short ( <3‑race ) hiatuses where a driver returned with a different team.
