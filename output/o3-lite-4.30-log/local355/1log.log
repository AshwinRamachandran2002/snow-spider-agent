Query:
--Description: #9  ─ For each short (<3) hiatus found in query #8, attach the
--                 driver’s constructor in the race immediately BEFORE and AFTER
--                 that hiatus, then keep only the cases where the two differ.
WITH seasons AS (
    SELECT year, round
    FROM races
),
drivers AS (
    SELECT DISTINCT driver_id
    FROM results
),
calendar AS (
    SELECT d.driver_id, s.year, s.round
    FROM drivers d
    JOIN seasons s
),
calendar_results AS (
    SELECT c.driver_id,
           c.year,
           c.round,
           res.constructor_id
    FROM calendar     c
    LEFT JOIN races   ra  ON ra.year  = c.year
                         AND ra.round = c.round
    LEFT JOIN results res ON res.race_id  = ra.race_id
                         AND res.driver_id = c.driver_id
),
seq AS (
    SELECT *,
           (round
            - ROW_NUMBER() OVER (PARTITION BY driver_id, year ORDER BY round)
           ) AS grp_key
    FROM calendar_results
),
missed AS (
    SELECT driver_id,
           year,
           MIN(round) AS first_round,
           MAX(round) AS last_round,
           COUNT(*)   AS gap_len
    FROM seq
    WHERE constructor_id IS NULL
    GROUP BY driver_id, year, grp_key
    HAVING gap_len < 3
),
with_constructors AS (
    SELECT m.*,
           (SELECT cr.constructor_id
            FROM calendar_results cr
            WHERE cr.driver_id = m.driver_id
              AND cr.year      = m.year
              AND cr.round     = m.first_round - 1
            LIMIT 1) AS constructor_before,
           (SELECT cr.constructor_id
            FROM calendar_results cr
            WHERE cr.driver_id = m.driver_id
              AND cr.year      = m.year
              AND cr.round     = m.last_round + 1
            LIMIT 1) AS constructor_after
    FROM missed m
)
SELECT *
FROM with_constructors
WHERE constructor_before IS NOT NULL
  AND constructor_after  IS NOT NULL
  AND constructor_before <> constructor_after
LIMIT 20
