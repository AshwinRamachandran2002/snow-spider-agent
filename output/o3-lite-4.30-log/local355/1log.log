--Description: Overall‑dataset calculation, step by step in CTEs
--  1) rounds            – every (year, round) that exists in `races`.
--  2) drivers_years     – every (driver, year) combination in which the driver
--                         appeared at least once (so we know who should have
--                         been “around” that season).
--  3) calendar          – Cartesian calendar of all rounds each such driver
--                         could have entered that year.
--  4) calendar_results  – attach the driver’s constructor_id when he actually
--                         started the race; NULL means he missed it.
--  5) seq               – create a grouping key (round‑ROW_NUMBER) so that
--                         consecutive rows with the same “missed/present”
--                         status share the same key.
--  6) missed_segments   – contiguous blocks where the driver was absent
--                         (<3 rounds long, i.e. gap_len < 3).
--  7) with_constructors – fetch constructor_id of the driver in the race
--                         immediately BEFORE and AFTER each hiatus.
--  8) filtered          – keep only those hiatuses where the bordering
--                         constructors both exist and are DIFFERENT (team
--                         switch occurred during the break).
--  9) Final SELECT      – return the overall averages of the first and last
--                         missed‑round indices across all such qualifying gaps.
WITH rounds AS (
    SELECT year, round
    FROM races
),
drivers_years AS (
    SELECT DISTINCT res.driver_id, r.year
    FROM results res
    JOIN races   r ON r.race_id = res.race_id
),
calendar AS (
    SELECT dy.driver_id, ro.year, ro.round
    FROM drivers_years dy
    JOIN rounds       ro ON ro.year = dy.year
),
calendar_results AS (
    SELECT c.driver_id,
           c.year,
           c.round,
           res.constructor_id
    FROM calendar  c
    LEFT JOIN races   ra  ON ra.year  = c.year
                         AND ra.round = c.round
    LEFT JOIN results res ON res.race_id  = ra.race_id
                         AND res.driver_id = c.driver_id
),
seq AS (
    SELECT *,
           (CASE WHEN constructor_id IS NULL THEN 1 ELSE 0 END)      AS missed_flag,
           (round
            - ROW_NUMBER() OVER (PARTITION BY driver_id, year
                                 ORDER BY round))                   AS grp_key
    FROM calendar_results
),
missed_segments AS (
    SELECT driver_id,
           year,
           MIN(round)                 AS first_round,
           MAX(round)                 AS last_round,
           COUNT(*)                   AS gap_len
    FROM seq
    WHERE missed_flag = 1
    GROUP BY driver_id, year, grp_key
    HAVING gap_len < 3
),
with_constructors AS (
    SELECT ms.*,
           (SELECT cr.constructor_id
            FROM calendar_results cr
            WHERE cr.driver_id = ms.driver_id
              AND cr.year      = ms.year
              AND cr.round     = ms.first_round - 1
            LIMIT 1) AS constructor_before,
           (SELECT cr.constructor_id
            FROM calendar_results cr
            WHERE cr.driver_id = ms.driver_id
              AND cr.year      = ms.year
              AND cr.round     = ms.last_round + 1
            LIMIT 1) AS constructor_after
    FROM missed_segments ms
),
filtered AS (
    SELECT *
    FROM with_constructors
    WHERE constructor_before IS NOT NULL
      AND constructor_after  IS NOT NULL
      AND constructor_before <> constructor_after
)
SELECT AVG(first_round) AS avg_first_missed_round,
       AVG(last_round)  AS avg_last_missed_round
FROM filtered;
