--Description: #8  ─ Identify, for every driver‑season, all contiguous blocks of
--                 missed races that are shorter than three rounds.
--                 Shows year, driver_id, first & last missed round and length.
WITH seasons AS (                         -- every season / round that exists
    SELECT year, round
    FROM races
),
drivers AS (                              -- every driver that ever appeared
    SELECT DISTINCT driver_id
    FROM results
),
calendar AS (                             -- Cartesian grid of driver × season × round
    SELECT d.driver_id, s.year, s.round
    FROM drivers d
    JOIN seasons s
),
calendar_results AS (                     -- attach constructor_id where driver started
    SELECT c.driver_id,
           c.year,
           c.round,
           res.constructor_id
    FROM calendar       AS c
    LEFT JOIN races     AS ra  ON ra.year  = c.year
                              AND ra.round = c.round
    LEFT JOIN results   AS res ON res.race_id  = ra.race_id
                              AND res.driver_id = c.driver_id
),
seq AS (                                  -- grouping key to split contiguous blocks
    SELECT *,
           (round
            - ROW_NUMBER() OVER (PARTITION BY driver_id, year ORDER BY round)
           ) AS grp_key
    FROM calendar_results
),
missed AS (                               -- consecutive missed‑race segments (<3)
    SELECT driver_id,
           year,
           MIN(round) AS first_round,
           MAX(round) AS last_round,
           COUNT(*)   AS gap_len
    FROM seq
    WHERE constructor_id IS NULL          -- driver absent
    GROUP BY driver_id, year, grp_key
    HAVING gap_len < 3
)
SELECT *
FROM missed
LIMIT 20
