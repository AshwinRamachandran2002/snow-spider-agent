2025-05-01 03:41:45 - Thread-1585 (execute) - INFO - [Exploration]
Relevant tables, columns & how they will be used  

• drives  
  – year: season to analyse per driver  
  – driver_id: identifies the driver  
  – constructor_id: team with which the driver appeared in that stint  
  – first_round: first GP round of the stint (before a possible hiatus)  
  – last_round: last GP round of the stint (just before a possible hiatus)  
  – Conditions:  
    • (next_first_round – last_round – 1) < 3 → driver missed < 3 races  
    • constructor_id ≠ next_constructor_id → team switch after hiatus  

• constructors / constructors_ext  
  – constructor_id / name: only for readability in ad‑hoc checks  

No other tables are strictly required; “drives” already tells us where a driver raced (and, by omission, where he did not).

-------------------------------------------------------------------
10 exploratory / step‑by‑step queries
-------------------------------------------------------------------

```sql
-- 1. Peek at a few drive records
SELECT *
FROM "drives"
LIMIT 20;
```

```sql
-- 2. Distinct seasons contained in the drives table
SELECT DISTINCT "year"
FROM "drives"
ORDER BY "year"
LIMIT 20;
```

```sql
-- 3. Show one season’s drives with constructor names
SELECT d."year",
       d."driver_id",
       c."name"  AS "team",
       d."first_round",
       d."last_round"
FROM   "drives"        AS d
JOIN   "constructors"  AS c USING ("constructor_id")
WHERE  d."year" = 1950
LIMIT 20;
```

```sql
-- 4. List all stints for a sample driver (id = 1)
SELECT *
FROM   "drives"
WHERE  "driver_id" = 1
ORDER BY "year", "first_round"
LIMIT 20;
```

```sql
-- 5. Use window functions to see the next stint for every driver‑year pair
SELECT d.*,
       LEAD(d."constructor_id") OVER (PARTITION BY d."year", d."driver_id"
                                      ORDER BY d."first_round")      AS "next_team",
       LEAD(d."first_round")     OVER (PARTITION BY d."year", d."driver_id"
                                      ORDER BY d."first_round")      AS "next_first_round"
FROM   "drives" AS d
LIMIT 20;
```

```sql
-- 6. Compute the number of races missed between consecutive stints
WITH ordered AS (
    SELECT d.*,
           LEAD(d."constructor_id") OVER (PARTITION BY d."year", d."driver_id"
                                          ORDER BY d."first_round")  AS "next_team",
           LEAD(d."first_round")     OVER (PARTITION BY d."year", d."driver_id"
                                          ORDER BY d."first_round")  AS "next_first_round"
    FROM   "drives" d
)
SELECT "year","driver_id","constructor_id","last_round",
       "next_team",
       "next_first_round",
       ("next_first_round" - "last_round" - 1) AS "races_missed"
FROM   ordered
WHERE  "next_team" IS NOT NULL
LIMIT 20;
```

```sql
-- 7. Filter to gaps of 1–2 races (missed < 3) with a team change
WITH ordered AS (
    SELECT d.*,
           LEAD(d."constructor_id") OVER (PARTITION BY d."year", d."driver_id"
                                          ORDER BY d."first_round")  AS "next_team",
           LEAD(d."first_round")     OVER (PARTITION BY d."year", d."driver_id"
                                          ORDER BY d."first_round")  AS "next_first_round"
    FROM   "drives" d
)
SELECT "year","driver_id","constructor_id",
       "last_round"            AS "round_before_break",
       ("last_round" + 1)      AS "first_missed_round",
       ("next_first_round" - 1)AS "last_missed_round",
       ("next_first_round" - "last_round" - 1) AS "races_missed",
       "next_team"
FROM   ordered
WHERE  "next_team" IS NOT NULL
  AND  "constructor_id" <> "next_team"
  AND  ("next_first_round" - "last_round" - 1) BETWEEN 1 AND 2
LIMIT 20;
```

```sql
-- 8. Confirm which constructors are involved in those switches
WITH switches AS (
    SELECT "constructor_id"     AS "old_team",
           "next_team"          AS "new_team"
    FROM   (
        SELECT d.*,
               LEAD(d."constructor_id") OVER (PARTITION BY d."year", d."driver_id"
                                              ORDER BY d."first_round") AS "next_team",
               LEAD(d."first_round")    OVER (PARTITION BY d."year", d."driver_id"
                                              ORDER BY d."first_round") AS "next_first_round"
        FROM   "drives" d
    )
    WHERE "next_team" IS NOT NULL
      AND "constructor_id" <> "next_team"
      AND ("next_first_round" - "last_round" - 1) BETWEEN 1 AND 2
)
SELECT DISTINCT
       c1."name" AS "old_team",
       c2."name" AS "new_team"
FROM   switches
JOIN   "constructors" AS c1 ON c1."constructor_id" = switches."old_team"
JOIN   "constructors" AS c2 ON c2."constructor_id" = switches."new_team"
LIMIT 20;
```

```sql
-- 9. Produce the list of all valid hiatuses with first/last missed rounds
WITH ordered AS (
    SELECT d.*,
           LEAD(d."constructor_id") OVER (PARTITION BY d."year", d."driver_id"
                                          ORDER BY d."first_round")  AS "next_team",
           LEAD(d."first_round")     OVER (PARTITION BY d."year", d."driver_id"
                                          ORDER BY d."first_round")  AS "next_first_round"
    FROM   "drives" d
)
SELECT "year", "driver_id",
       ("last_round" + 1)       AS "first_missed_round",
       ("next_first_round" - 1) AS "last_missed_round"
FROM   ordered
WHERE  "next_team" IS NOT NULL
  AND  "constructor_id" <> "next_team"
  AND  ("next_first_round" - "last_round" - 1) BETWEEN 1 AND 2
LIMIT 20;
```

```sql
-- 10. FINAL: overall average first & last missed rounds across all seasons
WITH ordered AS (
    SELECT d.*,
           LEAD(d."constructor_id") OVER (PARTITION BY d."year", d."driver_id"
                                          ORDER BY d."first_round")  AS "next_team",
           LEAD(d."first_round")     OVER (PARTITION BY d."year", d."driver_id"
                                          ORDER BY d."first_round")  AS "next_first_round"
    FROM   "drives" d
), gaps AS (
    SELECT ("last_round" + 1)       AS "first_missed_round",
           ("next_first_round" - 1) AS "last_missed_round"
    FROM   ordered
    WHERE  "next_team" IS NOT NULL
      AND  "constructor_id" <> "next_team"
      AND  ("next_first_round" - "last_round" - 1) BETWEEN 1 AND 2
)
SELECT AVG("first_missed_round") AS "avg_first_missed_round",
       AVG("last_missed_round")  AS "avg_last_missed_round"
FROM   gaps
LIMIT 20;
```

Each successive query deepens the exploration, finishing with a single‑row result that fulfils the task: the overall average first and last missed‑race rounds for drivers who (a) skipped fewer than three GPs and (b) changed teams immediately before and after the gap.
