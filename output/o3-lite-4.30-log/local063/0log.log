2025-05-01 03:16:37 - Thread-1282 (execute) - INFO - [Exploration]
Relevant tables, columns & possible conditions
------------------------------------------------
sales.amount_sold: value used to measure sales  
sales.quantity_sold: alternative volume metric  
sales.promo_id: filter promo_id = 999  
sales.time_id: join to times; pick the two quarters  
sales.prod_id: identify individual products  

customers.cust_id: join to sales  
customers.country_id: link to countries (keep United States)  
customers.cust_city: aggregate at city level  

countries.country_name / country_id: find the id for “United States”  
times.calendar_quarter_id: pick Q4‑2019 (=1772) & Q4‑2020 (=1776)  
times.time_id: join to sales rows  

Typical fixed conditions that will re‑appear  
• sales.promo_id = 999  
• countries.country_name = 'United States'        -- or LIKE 'United States%'  
• times.calendar_quarter_id IN (1772,1776)        -- Q4‑2019 & Q4‑2020  


Ten explorative → final SQL queries
-----------------------------------

```sql
-- 1.  United States rows in countries – to discover its country_id
SELECT DISTINCT country_id, country_name 
FROM   countries
WHERE  country_name LIKE 'United States%';
```

```sql
-- 2.  Sample of U.S. customers (limit 20)
SELECT DISTINCT cust_id, cust_city, country_id
FROM   customers
WHERE  country_id IN (
       SELECT country_id FROM countries WHERE country_name LIKE 'United States%')
LIMIT 20;
```

```sql
-- 3.  Distinct U.S. cities that have at least one customer
SELECT DISTINCT cust_city
FROM   customers
WHERE  country_id IN (
       SELECT country_id FROM countries WHERE country_name LIKE 'United States%')
LIMIT 20;
```

```sql
-- 4.  Show the two quarter‑codes we need in the times table
SELECT DISTINCT calendar_quarter_id, calendar_quarter_desc, calendar_year
FROM   times
WHERE  calendar_quarter_id IN (1772,1776);
```

```sql
-- 5.  Raw sales rows for Q4‑2019, promo 999, U.S. customers
SELECT  s.*
FROM    sales   AS s
JOIN    customers AS c   ON c.cust_id = s.cust_id
JOIN    countries AS co  ON co.country_id = c.country_id
JOIN    times     AS t   ON t.time_id   = s.time_id
WHERE   co.country_name LIKE 'United States%'
  AND   s.promo_id = 999
  AND   t.calendar_quarter_id = 1772
LIMIT 20;
```

```sql
-- 6.  Raw sales rows for Q4‑2020, promo 999, U.S. customers
SELECT  s.*
FROM    sales   AS s
JOIN    customers AS c   ON c.cust_id = s.cust_id
JOIN    countries AS co  ON co.country_id = c.country_id
JOIN    times     AS t   ON t.time_id   = s.time_id
WHERE   co.country_name LIKE 'United States%'
  AND   s.promo_id = 999
  AND   t.calendar_quarter_id = 1776
LIMIT 20;
```

```sql
-- 7.  City‑level totals in Q4‑2019 (amount_sold)
SELECT  c.cust_city,
        SUM(s.amount_sold) AS sales_2019
FROM    sales   AS s
JOIN    customers AS c   ON c.cust_id = s.cust_id
JOIN    countries AS co  ON co.country_id = c.country_id
JOIN    times     AS t   ON t.time_id   = s.time_id
WHERE   co.country_name LIKE 'United States%'
  AND   s.promo_id = 999
  AND   t.calendar_quarter_id = 1772
GROUP BY c.cust_city
LIMIT 20;
```

```sql
-- 8.  City‑level totals in Q4‑2020 (amount_sold)
SELECT  c.cust_city,
        SUM(s.amount_sold) AS sales_2020
FROM    sales   AS s
JOIN    customers AS c   ON c.cust_id = s.cust_id
JOIN    countries AS co  ON co.country_id = c.country_id
JOIN    times     AS t   ON t.time_id   = s.time_id
WHERE   co.country_name LIKE 'United States%'
  AND   s.promo_id = 999
  AND   t.calendar_quarter_id = 1776
GROUP BY c.cust_city
LIMIT 20;
```

```sql
-- 9.  Cities with ≥ 20 % growth from Q4‑2019 to Q4‑2020
WITH sales19 AS (
    SELECT c.cust_city, SUM(s.amount_sold) AS amt19
    FROM   sales s
    JOIN   customers c  ON c.cust_id = s.cust_id
    JOIN   countries co ON co.country_id = c.country_id
    JOIN   times t      ON t.time_id   = s.time_id
    WHERE  co.country_name LIKE 'United States%'
      AND  s.promo_id = 999
      AND  t.calendar_quarter_id = 1772
    GROUP  BY c.cust_city
),
sales20 AS (
    SELECT c.cust_city, SUM(s.amount_sold) AS amt20
    FROM   sales s
    JOIN   customers c  ON c.cust_id = s.cust_id
    JOIN   countries co ON co.country_id = c.country_id
    JOIN   times t      ON t.time_id   = s.time_id
    WHERE  co.country_name LIKE 'United States%'
      AND  s.promo_id = 999
      AND  t.calendar_quarter_id = 1776
    GROUP  BY c.cust_city
)
SELECT s20.cust_city,
       amt19, amt20,
       (amt20 - amt19) * 1.0 / NULLIF(amt19,0) AS growth_rate
FROM   sales20 s20
LEFT JOIN sales19 s19 ON s19.cust_city = s20.cust_city
WHERE  (amt20 - amt19) * 1.0 / NULLIF(amt19,0) >= 0.20
LIMIT 20;
```

```sql
-- 10.  FINAL: product in top 20 % of sales that shows the smallest
--       change in share of total sales between the two quarters
WITH city_ok AS (          -- cities that grew ≥20 %
    /* reuse CTE built in query 9 */
    WITH s19 AS (
        SELECT c.cust_city, SUM(s.amount_sold) AS amt19
        FROM   sales s
        JOIN   customers c  ON c.cust_id = s.cust_id
        JOIN   countries co ON co.country_id = c.country_id
        JOIN   times t      ON t.time_id   = s.time_id
        WHERE  co.country_name LIKE 'United States%'
          AND  s.promo_id = 999
          AND  t.calendar_quarter_id = 1772
        GROUP  BY c.cust_city
    ),
    s20 AS (
        SELECT c.cust_city, SUM(s.amount_sold) AS amt20
        FROM   sales s
        JOIN   customers c  ON c.cust_id = s.cust_id
        JOIN   countries co ON co.country_id = c.country_id
        JOIN   times t      ON t.time_id   = s.time_id
        WHERE  co.country_name LIKE 'United States%'
          AND  s.promo_id = 999
          AND  t.calendar_quarter_id = 1776
        GROUP  BY c.cust_city
    )
    SELECT s20.cust_city
    FROM   s20
    JOIN   s19 ON s19.cust_city = s20.cust_city
    WHERE  (s20.amt20 - s19.amt19) * 1.0 / NULLIF(s19.amt19,0) >= 0.20
),
sales_qtrs AS (            -- sales in the two quarters, filtered
    SELECT s.prod_id,
           CASE WHEN t.calendar_quarter_id = 1772 THEN 'Q4_2019'
                WHEN t.calendar_quarter_id = 1776 THEN 'Q4_2020' END AS which_qtr,
           s.amount_sold
    FROM   sales      s
    JOIN   customers  c  ON c.cust_id = s.cust_id
    JOIN   countries  co ON co.country_id = c.country_id
    JOIN   times      t  ON t.time_id   = s.time_id
    WHERE  co.country_name LIKE 'United States%'
      AND  s.promo_id = 999
      AND  t.calendar_quarter_id IN (1772,1776)
      AND  c.cust_city IN (SELECT cust_city FROM city_ok)
),
tot_per_prod AS (          -- per‑product totals each quarter
    SELECT prod_id,
           which_qtr,
           SUM(amount_sold) AS prod_amt
    FROM   sales_qtrs
    GROUP  BY prod_id, which_qtr
),
tot_all AS (               -- overall totals each quarter
    SELECT which_qtr,
           SUM(amount_sold) AS all_amt
    FROM   sales_qtrs
    GROUP  BY which_qtr
),
shares AS (                -- product’s share each quarter
    SELECT p.prod_id,
           p.which_qtr,
           p.prod_amt * 1.0 / a.all_amt AS share
    FROM   tot_per_prod p
    JOIN   tot_all      a
          ON a.which_qtr = p.which_qtr
),
combined AS (              -- combine Q4‑2019 & Q4‑2020 rows
    SELECT s19.prod_id,
           s19.share AS share19,
           s20.share AS share20,
           (s20.share - s19.share) AS pp_change
    FROM   shares s19
    JOIN   shares s20
          ON s20.prod_id = s19.prod_id
         AND s19.which_qtr = 'Q4_2019'
         AND s20.which_qtr = 'Q4_2020'
),
ranking AS (               -- find top 20 % products by total sales
    SELECT prod_id,
           (SUM(prod_amt)) AS total_amt,
           NTILE(5) OVER (ORDER BY SUM(prod_amt) DESC) AS quintile
    FROM   tot_per_prod
    GROUP  BY prod_id
)
SELECT  c.prod_id,
        c.share19,
        c.share20,
        c.pp_change
FROM    combined c
JOIN    ranking  r ON r.prod_id = c.prod_id
WHERE   r.quintile = 1               -- top 20 %
ORDER BY ABS(c.pp_change)            -- smallest change first
LIMIT 1;
```
