-- 10.  FINAL: product in top 20 % of sales that shows the smallest
--       change in share of total sales between the two quarters
WITH city_ok AS (          -- cities that grew ≥20 %
    /* reuse CTE built in query 9 */
    WITH s19 AS (
        SELECT c.cust_city, SUM(s.amount_sold) AS amt19
        FROM   sales s
        JOIN   customers c  ON c.cust_id = s.cust_id
        JOIN   countries co ON co.country_id = c.country_id
        JOIN   times t      ON t.time_id   = s.time_id
        WHERE  co.country_name LIKE 'United States%'
          AND  s.promo_id = 999
          AND  t.calendar_quarter_id = 1772
        GROUP  BY c.cust_city
    ),
    s20 AS (
        SELECT c.cust_city, SUM(s.amount_sold) AS amt20
        FROM   sales s
        JOIN   customers c  ON c.cust_id = s.cust_id
        JOIN   countries co ON co.country_id = c.country_id
        JOIN   times t      ON t.time_id   = s.time_id
        WHERE  co.country_name LIKE 'United States%'
          AND  s.promo_id = 999
          AND  t.calendar_quarter_id = 1776
        GROUP  BY c.cust_city
    )
    SELECT s20.cust_city
    FROM   s20
    JOIN   s19 ON s19.cust_city = s20.cust_city
    WHERE  (s20.amt20 - s19.amt19) * 1.0 / NULLIF(s19.amt19,0) >= 0.20
),
sales_qtrs AS (            -- sales in the two quarters, filtered
    SELECT s.prod_id,
           CASE WHEN t.calendar_quarter_id = 1772 THEN 'Q4_2019'
                WHEN t.calendar_quarter_id = 1776 THEN 'Q4_2020' END AS which_qtr,
           s.amount_sold
    FROM   sales      s
    JOIN   customers  c  ON c.cust_id = s.cust_id
    JOIN   countries  co ON co.country_id = c.country_id
    JOIN   times      t  ON t.time_id   = s.time_id
    WHERE  co.country_name LIKE 'United States%'
      AND  s.promo_id = 999
      AND  t.calendar_quarter_id IN (1772,1776)
      AND  c.cust_city IN (SELECT cust_city FROM city_ok)
),
tot_per_prod AS (          -- per‑product totals each quarter
    SELECT prod_id,
           which_qtr,
           SUM(amount_sold) AS prod_amt
    FROM   sales_qtrs
    GROUP  BY prod_id, which_qtr
),
tot_all AS (               -- overall totals each quarter
    SELECT which_qtr,
           SUM(amount_sold) AS all_amt
    FROM   sales_qtrs
    GROUP  BY which_qtr
),
shares AS (                -- product’s share each quarter
    SELECT p.prod_id,
           p.which_qtr,
           p.prod_amt * 1.0 / a.all_amt AS share
    FROM   tot_per_prod p
    JOIN   tot_all      a
          ON a.which_qtr = p.which_qtr
),
combined AS (              -- combine Q4‑2019 & Q4‑2020 rows
    SELECT s19.prod_id,
           s19.share AS share19,
           s20.share AS share20,
           (s20.share - s19.share) AS pp_change
    FROM   shares s19
    JOIN   shares s20
          ON s20.prod_id = s19.prod_id
         AND s19.which_qtr = 'Q4_2019'
         AND s20.which_qtr = 'Q4_2020'
),
ranking AS (               -- find top 20 % products by total sales
    SELECT prod_id,
           (SUM(prod_amt)) AS total_amt,
           NTILE(5) OVER (ORDER BY SUM(prod_amt) DESC) AS quintile
    FROM   tot_per_prod
    GROUP  BY prod_id
)
SELECT  c.prod_id,
        c.share19,
        c.share20,
        c.pp_change
FROM    combined c
JOIN    ranking  r ON r.prod_id = c.prod_id
WHERE   r.quintile = 1               -- top 20 %
ORDER BY ABS(c.pp_change)            -- smallest change first
LIMIT 1;
