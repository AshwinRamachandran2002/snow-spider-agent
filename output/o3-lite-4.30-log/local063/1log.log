```sql
--Description: single statement that shows the step‑by‑step reasoning (as CTEs) and
--returns the product (promo‑999, U‑S customers) that
--  • is sold in cities whose sales grew ≥20 % from Q4‑2019 (1772) to Q4‑2020 (1776),
--  • belongs to the top 20 % of those products by total sales (both quarters),
--  • has the smallest absolute percentage‑point change in its share of total sales
--    between the two quarters.
WITH
/* 1. 2019‑Q4 city totals */
city_2019 AS (
    SELECT c.cust_city            AS city,
           SUM(s.amount_sold)     AS amt_2019
    FROM   sales s
    JOIN   customers c ON c.cust_id    = s.cust_id
    JOIN   countries k ON k.country_id = c.country_id
    JOIN   times     t ON t.time_id    = s.time_id
    WHERE  s.promo_id = 999
      AND  k.country_name = 'United States of America'
      AND  t.calendar_quarter_id = 1772
    GROUP  BY c.cust_city
),
/* 2. 2020‑Q4 city totals */
city_2020 AS (
    SELECT c.cust_city            AS city,
           SUM(s.amount_sold)     AS amt_2020
    FROM   sales s
    JOIN   customers c ON c.cust_id    = s.cust_id
    JOIN   countries k ON k.country_id = c.country_id
    JOIN   times     t ON t.time_id    = s.time_id
    WHERE  s.promo_id = 999
      AND  k.country_name = 'United States of America'
      AND  t.calendar_quarter_id = 1776
    GROUP  BY c.cust_city
),
/* 3. Cities with ≥20 % growth */
good_cities AS (
    SELECT a.city
    FROM   city_2019 a
    JOIN   city_2020 b USING (city)
    WHERE  (b.amt_2020 - a.amt_2019) * 1.0 / a.amt_2019 >= 0.20
),
/* 4. Product sales by quarter within those cities */
product_qtr AS (
    SELECT s.prod_id,
           t.calendar_quarter_id  AS qtr,
           SUM(s.amount_sold)     AS sales_amt
    FROM   sales s
    JOIN   customers c ON c.cust_id = s.cust_id
    JOIN   times     t ON t.time_id = s.time_id
    WHERE  s.promo_id = 999
      AND  t.calendar_quarter_id IN (1772,1776)
      AND  c.cust_city IN (SELECT city FROM good_cities)
    GROUP  BY s.prod_id, t.calendar_quarter_id
),
/* 5. Quarter totals used as denominator for share */
total_qtr AS (
    SELECT qtr, SUM(sales_amt) AS total_sales
    FROM   product_qtr
    GROUP  BY qtr
),
/* 6. Product share of quarter total */
product_share AS (
    SELECT p.prod_id,
           p.qtr,
           p.sales_amt * 1.0 / t.total_sales AS share
    FROM   product_qtr p
    JOIN   total_qtr  t USING (qtr)
),
/* 7. Change in share between the two quarters */
share_change AS (
    SELECT a.prod_id,
           a.share AS share_2019,
           b.share AS share_2020,
           (b.share - a.share) AS pp_change
    FROM   product_share a
    JOIN   product_share b ON b.prod_id = a.prod_id
    WHERE  a.qtr = 1772 AND b.qtr = 1776
),
/* 8. Attach total sales across both quarters for ranking */
ranked AS (
    SELECT sc.*,
           (SELECT SUM(sales_amt) FROM product_qtr WHERE prod_id = sc.prod_id) AS total_sales_all
    FROM   share_change sc
),
/* 9. Keep top 20 % products by total sales */
top_20pct AS (
    SELECT *
    FROM   ranked
    ORDER  BY total_sales_all DESC
    LIMIT  CAST((SELECT COUNT(*)*0.20 FROM ranked) AS INTEGER)
)
/* 10. Pick product with smallest absolute change in share */
SELECT tp.prod_id,
       p.prod_name,
       ROUND(tp.share_2019,4) AS share_2019Q4,
       ROUND(tp.share_2020,4) AS share_2020Q4,
       ROUND(tp.pp_change,4)  AS pp_change
FROM   top_20pct tp
JOIN   products  p ON p.prod_id = tp.prod_id
ORDER  BY ABS(tp.pp_change) ASC
LIMIT 1;
```
