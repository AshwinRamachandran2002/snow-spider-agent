Relevant tables and columns for the task  
(products sold in U‑S cities, promo 999, Q4‑2019 vs Q4‑2020 growth)

• sales  
  • prod_id : sale’s product to evaluate top‑20 % performers  
  • cust_id : join to customer / city / country  
  • time_id : join to calendar_quarter_id (1772, 1776)  
  • promo_id : filter = 999  
  • quantity_sold / amount_sold : measure of sales & shares  

• customers  
  • cust_id : join to sales  
  • cust_city : city level to measure growth  
  • country_id : join to countries to keep only U‑S customers  

• countries  
  • country_id : join to customers  
  • country_name : filter “United States” (or similar)  

• times  
  • time_id : join to sales  
  • calendar_quarter_id : choose 1772 (Q4‑2019) and 1776 (Q4‑2020)  

• products  
  • prod_id : descriptive name for final answer  
  • prod_name : show winning product  

--------------------------------------------------
Exploratory SQL queries  
(each query limited to 20 rows, all use DISTINCT where reasonable)

```sql
-- 1. See what the country names look like
SELECT DISTINCT country_name
FROM countries
LIMIT 20;
```

```sql
-- 2. Confirm the country_id that represents the United States
SELECT country_id, country_iso_code, country_name
FROM countries
WHERE country_name LIKE '%United%'
LIMIT 20;
```

```sql
-- 3. Inspect the calendar‑quarter mapping for 2019‑Q4 (1772) & 2020‑Q4 (1776)
SELECT DISTINCT calendar_quarter_id,
       calendar_quarter_desc,
       time_id
FROM times
WHERE calendar_quarter_id IN (1772, 1776)
LIMIT 20;
```

```sql
-- 4. Sample sales rows in Q4‑2019 under promo 999
SELECT s.prod_id,
       s.cust_id,
       s.time_id,
       s.quantity_sold,
       s.amount_sold
FROM sales AS s
JOIN times  AS t ON t.time_id = s.time_id
WHERE s.promo_id = 999
  AND t.calendar_quarter_id = 1772
LIMIT 20;
```

```sql
-- 5. Join customers & countries to keep only U‑S sales (promo 999, Q4‑2019)
SELECT s.prod_id,
       c.cust_city,
       c.country_id,
       cnt.country_name,
       s.amount_sold
FROM   sales      AS s
JOIN   customers  AS c   ON c.cust_id   = s.cust_id
JOIN   countries  AS cnt ON cnt.country_id = c.country_id
JOIN   times      AS t   ON t.time_id = s.time_id
WHERE  s.promo_id = 999
  AND  t.calendar_quarter_id = 1772
  AND  cnt.country_name LIKE 'United States%'
LIMIT 20;
```

```sql
-- 6. City‑level totals for each quarter (needed for 20 % growth test)
SELECT c.cust_city,
       t.calendar_quarter_id,
       SUM(s.amount_sold) AS city_sales
FROM   sales      AS s
JOIN   customers  AS c   ON c.cust_id = s.cust_id
JOIN   countries  AS cnt ON cnt.country_id = c.country_id
JOIN   times      AS t   ON t.time_id   = s.time_id
WHERE  s.promo_id           = 999
  AND  cnt.country_name LIKE 'United States%'
  AND  t.calendar_quarter_id IN (1772, 1776)
GROUP  BY c.cust_city, t.calendar_quarter_id
LIMIT 20;
```

```sql
-- 7. Compute % growth from Q4‑2019 to Q4‑2020 for every city
WITH city_qtr AS (
    SELECT c.cust_city          AS city,
           t.calendar_quarter_id AS qtr,
           SUM(s.amount_sold)    AS sales_amt
    FROM   sales AS s
    JOIN   customers  AS c   ON c.cust_id = s.cust_id
    JOIN   countries  AS cnt ON cnt.country_id = c.country_id
    JOIN   times      AS t   ON t.time_id   = s.time_id
    WHERE  s.promo_id = 999
      AND  cnt.country_name LIKE 'United States%'
      AND  t.calendar_quarter_id IN (1772, 1776)
    GROUP  BY c.cust_city, t.calendar_quarter_id
)
SELECT a.city,
       a.sales_amt  AS sales_2019Q4,
       b.sales_amt  AS sales_2020Q4,
       ROUND( (b.sales_amt - a.sales_amt) * 1.0 / a.sales_amt, 2) AS pct_growth
FROM   city_qtr AS a
JOIN   city_qtr AS b
       ON  b.city = a.city
       AND b.qtr  = 1776
WHERE  a.qtr = 1772
LIMIT 20;
```

```sql
-- 8. List cities whose promo‑999 sales grew ≥20 %
WITH city_growth AS (
    -- (reuse CTE in query 7)
    SELECT a.city,
           a.sales_amt  AS sales_2019Q4,
           b.sales_amt  AS sales_2020Q4,
           (b.sales_amt - a.sales_amt) * 1.0 / a.sales_amt AS pct_growth
    FROM (
        SELECT c.cust_city AS city,
               SUM(s.amount_sold) AS sales_amt
        FROM   sales AS s
        JOIN   customers  AS c   ON c.cust_id = s.cust_id
        JOIN   countries  AS cnt ON cnt.country_id = c.country_id
        JOIN   times      AS t   ON t.time_id   = s.time_id
        WHERE  s.promo_id = 999
          AND  cnt.country_name LIKE 'United States%'
          AND  t.calendar_quarter_id = 1772
        GROUP  BY c.cust_city
    ) AS a
    JOIN (
        SELECT c.cust_city AS city,
               SUM(s.amount_sold) AS sales_amt
        FROM   sales AS s
        JOIN   customers  AS c   ON c.cust_id = s.cust_id
        JOIN   countries  AS cnt ON cnt.country_id = c.country_id
        JOIN   times      AS t   ON t.time_id   = s.time_id
        WHERE  s.promo_id = 999
          AND  cnt.country_name LIKE 'United States%'
          AND  t.calendar_quarter_id = 1776
        GROUP  BY c.cust_city
    ) AS b
    ON b.city = a.city
)
SELECT city, sales_2019Q4, sales_2020Q4, ROUND(pct_growth,2) AS pct_growth
FROM   city_growth
WHERE  pct_growth >= 0.20
LIMIT 20;
```

```sql
-- 9. Total sales per product in the ‘qualified’ growth‑cities for each quarter
WITH good_cities AS (
    -- cities with ≥20 % growth (reuse logic above)
    SELECT city
    FROM (
        -- same inner computation as query 8 (abbreviated here)
        SELECT a.city,
               (b.sales_amt - a.sales_amt)*1.0/a.sales_amt AS pct_growth
        FROM (
            SELECT c.cust_city AS city, SUM(s.amount_sold) AS sales_amt
            FROM sales s
            JOIN customers c  ON c.cust_id = s.cust_id
            JOIN countries k  ON k.country_id = c.country_id
            JOIN times t      ON t.time_id  = s.time_id
            WHERE s.promo_id = 999
              AND k.country_name LIKE 'United States%'
              AND t.calendar_quarter_id = 1772
            GROUP BY c.cust_city
        ) a
        JOIN (
            SELECT c.cust_city AS city, SUM(s.amount_sold) AS sales_amt
            FROM sales s
            JOIN customers c  ON c.cust_id = s.cust_id
            JOIN countries k  ON k.country_id = c.country_id
            JOIN times t      ON t.time_id  = s.time_id
            WHERE s.promo_id = 999
              AND k.country_name LIKE 'United States%'
              AND t.calendar_quarter_id = 1776
            GROUP BY c.cust_city
        ) b ON b.city = a.city
    ) WHERE pct_growth >= 0.20
)
SELECT p.prod_id,
       pr.prod_name,
       t.calendar_quarter_id,
       SUM(p.amount_sold) AS product_sales
FROM   sales      AS p
JOIN   customers  AS c   ON c.cust_id = p.cust_id
JOIN   times      AS t   ON t.time_id = p.time_id
JOIN   products   AS pr  ON pr.prod_id = p.prod_id
WHERE  p.promo_id = 999
  AND  t.calendar_quarter_id IN (1772,1776)
  AND  c.cust_city IN (SELECT city FROM good_cities)
GROUP  BY p.prod_id, t.calendar_quarter_id
LIMIT 20;
```

```sql
-- 10. Rank products (top 20 % by total sales) and find the one with 
--     the smallest change in share between the two quarters
WITH good_cities AS (  -- same as in query 9
    SELECT city
    FROM (
        SELECT a.city,
               (b.sales_amt - a.sales_amt)*1.0/a.sales_amt AS pct_growth
        FROM (
            SELECT c.cust_city AS city, SUM(s.amount_sold) AS sales_amt
            FROM sales s
            JOIN customers c ON c.cust_id = s.cust_id
            JOIN countries k ON k.country_id = c.country_id
            JOIN times t     ON t.time_id  = s.time_id
            WHERE s.promo_id = 999
              AND k.country_name LIKE 'United States%'
              AND t.calendar_quarter_id = 1772
            GROUP BY c.cust_city
        ) a
        JOIN (
            SELECT c.cust_city AS city, SUM(s.amount_sold) AS sales_amt
            FROM sales s
            JOIN customers c ON c.cust_id = s.cust_id
            JOIN countries k ON k.country_id = c.country_id
            JOIN times t     ON t.time_id  = s.time_id
            WHERE s.promo_id = 999
              AND k.country_name LIKE 'United States%'
              AND t.calendar_quarter_id = 1776
            GROUP BY c.cust_city
        ) b ON b.city = a.city
    ) WHERE (b.sales_amt - a.sales_amt)*1.0/a.sales_amt >= 0.20
),
product_qtr AS (
    SELECT s.prod_id,
           t.calendar_quarter_id                 AS qtr,
           SUM(s.amount_sold)                    AS sales_amt
    FROM   sales     AS s
    JOIN   customers AS c  ON c.cust_id = s.cust_id
    JOIN   times     AS t  ON t.time_id = s.time_id
    WHERE  s.promo_id = 999
      AND  t.calendar_quarter_id IN (1772,1776)
      AND  c.cust_city IN (SELECT city FROM good_cities)
    GROUP  BY s.prod_id, t.calendar_quarter_id
),
total_qtr AS (
    SELECT qtr, SUM(sales_amt) AS total_sales
    FROM   product_qtr
    GROUP  BY qtr
),
product_share AS (
    SELECT p.prod_id,
           p.qtr,
           p.sales_amt * 1.0 / t.total_sales  AS share
    FROM   product_qtr  AS p
    JOIN   total_qtr    AS t ON t.qtr = p.qtr
),
share_change AS (
    SELECT a.prod_id,
           a.share AS share_2019Q4,
           b.share AS share_2020Q4,
           (b.share - a.share) AS pp_change
    FROM   product_share a
    JOIN   product_share b
           ON b.prod_id = a.prod_id
          AND a.qtr = 1772
          AND b.qtr = 1776
),
ranked AS (
    SELECT sc.*,
           (SELECT SUM(sales_amt) FROM product_qtr WHERE prod_id = sc.prod_id) AS total_sales_across_qtrs
    FROM   share_change sc
),
top_20pct AS (
    SELECT *
    FROM   ranked
    ORDER  BY total_sales_across_qtrs DESC
    LIMIT  CAST((SELECT COUNT(*)*0.20 FROM ranked) AS INTEGER)
)
SELECT r.prod_id,
       pr.prod_name,
       ROUND(r.share_2019Q4,4) AS share_2019Q4,
       ROUND(r.share_2020Q4,4) AS share_2020Q4,
       ROUND(r.pp_change,4)    AS pp_change
FROM   top_20pct AS r
JOIN   products  AS pr ON pr.prod_id = r.prod_id
ORDER  BY ABS(r.pp_change) ASC
LIMIT 20;
```

The final query (No. 10) identifies, among the top‑20 % highest‑selling promo‑999 products in qualified U‑S cities, the product whose share of total sales changed the least (smallest percentage‑point difference) from Q4‑2019 to Q4‑2020.
