-- 9. Total sales per product in the ‘qualified’ growth‑cities for each quarter
WITH good_cities AS (
    -- cities with ≥20 % growth (reuse logic above)
    SELECT city
    FROM (
        -- same inner computation as query 8 (abbreviated here)
        SELECT a.city,
               (b.sales_amt - a.sales_amt)*1.0/a.sales_amt AS pct_growth
        FROM (
            SELECT c.cust_city AS city, SUM(s.amount_sold) AS sales_amt
            FROM sales s
            JOIN customers c  ON c.cust_id = s.cust_id
            JOIN countries k  ON k.country_id = c.country_id
            JOIN times t      ON t.time_id  = s.time_id
            WHERE s.promo_id = 999
              AND k.country_name LIKE 'United States%'
              AND t.calendar_quarter_id = 1772
            GROUP BY c.cust_city
        ) a
        JOIN (
            SELECT c.cust_city AS city, SUM(s.amount_sold) AS sales_amt
            FROM sales s
            JOIN customers c  ON c.cust_id = s.cust_id
            JOIN countries k  ON k.country_id = c.country_id
            JOIN times t      ON t.time_id  = s.time_id
            WHERE s.promo_id = 999
              AND k.country_name LIKE 'United States%'
              AND t.calendar_quarter_id = 1776
            GROUP BY c.cust_city
        ) b ON b.city = a.city
    ) WHERE pct_growth >= 0.20
)
SELECT p.prod_id,
       pr.prod_name,
       t.calendar_quarter_id,
       SUM(p.amount_sold) AS product_sales
FROM   sales      AS p
JOIN   customers  AS c   ON c.cust_id = p.cust_id
JOIN   times      AS t   ON t.time_id = p.time_id
JOIN   products   AS pr  ON pr.prod_id = p.prod_id
WHERE  p.promo_id = 999
  AND  t.calendar_quarter_id IN (1772,1776)
  AND  c.cust_city IN (SELECT city FROM good_cities)
GROUP  BY p.prod_id, t.calendar_quarter_id
LIMIT 20;
