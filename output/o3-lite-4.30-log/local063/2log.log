--Description: Identify cities whose promo‑999 sales grew ≥ 20 % from Q4‑2019 to Q4‑2020 for any country name containing “United”.
WITH q19 AS (
    SELECT cu."cust_city" AS city,
           SUM(s."amount_sold") AS amt19
    FROM   "sales"      AS s
    JOIN   "times"      AS t  ON s."time_id" = t."time_id"
    JOIN   "customers"  AS cu ON s."cust_id" = cu."cust_id"
    JOIN   "countries"  AS co ON cu."country_id" = co."country_id"
    WHERE  co."country_name" LIKE '%United%'
      AND  s."promo_id" = 999
      AND  t."calendar_quarter_id" = 1772
    GROUP  BY cu."cust_city"
), q20 AS (
    SELECT cu."cust_city" AS city,
           SUM(s."amount_sold") AS amt20
    FROM   "sales"      AS s
    JOIN   "times"      AS t  ON s."time_id" = t."time_id"
    JOIN   "customers"  AS cu ON s."cust_id" = cu."cust_id"
    JOIN   "countries"  AS co ON cu."country_id" = co."country_id"
    WHERE  co."country_name" LIKE '%United%'
      AND  s."promo_id" = 999
      AND  t."calendar_quarter_id" = 1776
    GROUP  BY cu."cust_city"
)
SELECT q20.city,
       q19.amt19,
       q20.amt20,
       ROUND(100.0 * (q20.amt20 - q19.amt19) / q19.amt19, 1) AS pct_growth
FROM   q19
JOIN   q20 ON q19.city = q20.city
WHERE  q20.amt20 >= 1.20 * q19.amt19
ORDER  BY pct_growth DESC
LIMIT  20
