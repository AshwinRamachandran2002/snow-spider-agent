WITH good_cities AS (          -- cities whose promo‑999 sales grew ≥20 %
    WITH q19 AS (
        SELECT cu."cust_city" AS city,
               SUM(s."amount_sold") AS amt19
        FROM "sales"      s
        JOIN "times"      t  ON s."time_id"   = t."time_id"
        JOIN "customers"  cu ON s."cust_id"   = cu."cust_id"
        JOIN "countries"  co ON cu."country_id" = co."country_id"
        WHERE co."country_name" = 'United States'
          AND s."promo_id" = 999
          AND t."calendar_quarter_id" = 1772          -- Q4‑2019
        GROUP BY cu."cust_city"
    ),
    q20 AS (
        SELECT cu."cust_city" AS city,
               SUM(s."amount_sold") AS amt20
        FROM "sales"      s
        JOIN "times"      t  ON s."time_id"   = t."time_id"
        JOIN "customers"  cu ON s."cust_id"   = cu."cust_id"
        JOIN "countries"  co ON cu."country_id" = co."country_id"
        WHERE co."country_name" = 'United States'
          AND s."promo_id" = 999
          AND t."calendar_quarter_id" = 1776          -- Q4‑2020
        GROUP BY cu."cust_city"
    )
    SELECT q19.city
    FROM   q19
    JOIN   q20 ON q19.city = q20.city
    WHERE  q20.amt20 >= 1.20 * q19.amt19
),
sales_scope AS (               -- promo‑999 sales in growth cities (both quarters)
    SELECT p."prod_id",
           t."calendar_quarter_id" AS qtr,
           SUM(s."amount_sold")    AS amt
    FROM   "sales"      s
    JOIN   "times"      t  ON s."time_id"   = t."time_id"
    JOIN   "customers"  cu ON s."cust_id"   = cu."cust_id"
    JOIN   good_cities  gc ON cu."cust_city" = gc.city
    JOIN   "products"   p  ON s."prod_id"    = p."prod_id"
    WHERE  s."promo_id" = 999
      AND  t."calendar_quarter_id" IN (1772,1776)
    GROUP  BY p."prod_id", t."calendar_quarter_id"
),
totals AS (                    -- total amount for each quarter
    SELECT qtr, SUM(amt) AS tot_amt
    FROM   sales_scope
    GROUP  BY qtr
),
pivot AS (                     -- per‑product amounts per quarter
    SELECT ss."prod_id",
           COALESCE(MAX(CASE WHEN ss.qtr = 1772 THEN ss.amt END),0) AS amt19,
           COALESCE(MAX(CASE WHEN ss.qtr = 1776 THEN ss.amt END),0) AS amt20
    FROM   sales_scope ss
    GROUP  BY ss."prod_id"
),
shares AS (                    -- convert to market share & compute total amount
    SELECT p."prod_id",
           (p.amt19 + p.amt20)                                  AS total_amt,
           COALESCE(p.amt19 / (SELECT tot_amt FROM totals WHERE qtr = 1772),0) AS share19,
           COALESCE(p.amt20 / (SELECT tot_amt FROM totals WHERE qtr = 1776),0) AS share20
    FROM   pivot p
),
ranked AS (                    -- rank products by total amount
    SELECT s.*,
           ROW_NUMBER() OVER(ORDER BY total_amt DESC) AS rn,
           (SELECT COUNT(*) FROM shares)              AS cnt
    FROM   shares s
),
top20 AS (                     -- keep top 20 % of products
    SELECT *
    FROM   ranked
    WHERE  rn <= cnt * 0.20
),
result AS (                    -- product with smallest %‑point change
    SELECT "prod_id"                             AS product_id,
           ROUND( (share20 - share19) * 100, 4 ) AS percentage_point_change_in_share_of_total_sales
    FROM   top20
    ORDER  BY ABS(share20 - share19)             -- smallest change
    LIMIT  1
)
SELECT product_id,
       percentage_point_change_in_share_of_total_sales
FROM   result;
```
