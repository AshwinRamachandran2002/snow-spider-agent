--Description: Final step—among top‑20 % products (by aggregate sales) in growth cities, find the one whose share of promo‑999 sales changed the least between Q4‑2019 and Q4‑2020; uses relaxed “United” country filter throughout.
WITH good_cities AS (
    WITH q19 AS (
        SELECT cu."cust_city" AS city,
               SUM(s."amount_sold") AS amt19
        FROM   "sales"      AS s
        JOIN   "times"      AS t ON s."time_id" = t."time_id"
        JOIN   "customers"  AS cu ON s."cust_id" = cu."cust_id"
        JOIN   "countries"  AS co ON cu."country_id" = co."country_id"
        WHERE  co."country_name" LIKE '%United%'
          AND  s."promo_id" = 999
          AND  t."calendar_quarter_id" = 1772
        GROUP  BY cu."cust_city"
    ), q20 AS (
        SELECT cu."cust_city" AS city,
               SUM(s."amount_sold") AS amt20
        FROM   "sales"      AS s
        JOIN   "times"      AS t ON s."time_id" = t."time_id"
        JOIN   "customers"  AS cu ON s."cust_id" = cu."cust_id"
        JOIN   "countries"  AS co ON cu."country_id" = co."country_id"
        WHERE  co."country_name" LIKE '%United%'
          AND  s."promo_id" = 999
          AND  t."calendar_quarter_id" = 1776
        GROUP  BY cu."cust_city"
    )
    SELECT q19.city
    FROM   q19 JOIN q20 ON q19.city = q20.city
    WHERE  q20.amt20 >= 1.20 * q19.amt19
),
sales_in_scope AS (
    SELECT p."prod_id",
           p."prod_name",
           t."calendar_quarter_id" AS qtr,
           SUM(s."amount_sold") AS amt
    FROM   "sales"      AS s
    JOIN   "times"      AS t  ON s."time_id" = t."time_id"
    JOIN   "customers"  AS cu ON s."cust_id" = cu."cust_id"
    JOIN   good_cities  AS gc ON cu."cust_city" = gc.city
    JOIN   "products"   AS p  ON s."prod_id" = p."prod_id"
    WHERE  s."promo_id" = 999
      AND  t."calendar_quarter_id" IN (1772, 1776)
    GROUP  BY p."prod_id", p."prod_name", t."calendar_quarter_id"
),
totals AS (
    SELECT qtr,
           SUM(amt) AS tot_amt
    FROM   sales_in_scope
    GROUP  BY qtr
),
pivot AS (
    SELECT s."prod_id",
           s."prod_name",
           MAX(CASE WHEN s.qtr = 1772 THEN 1.0 * s.amt / t.tot_amt END) AS share_2019,
           MAX(CASE WHEN s.qtr = 1776 THEN 1.0 * s.amt / t.tot_amt END) AS share_2020,
           SUM(s.amt)  AS total_amt
    FROM   sales_in_scope AS s
    JOIN   totals         AS t ON s.qtr = t.qtr
    GROUP  BY s."prod_id", s."prod_name"
),
with_rank AS (
    SELECT p.*,
           ROW_NUMBER() OVER (ORDER BY total_amt DESC) AS rn,
           COUNT(*)  OVER () AS cnt
    FROM   pivot AS p
),
top20 AS (
    /* keep rows in the top 20 % */
    SELECT *
    FROM   with_rank
    WHERE  rn <= 0.20 * cnt
),
diffs AS (
    SELECT prod_id,
           prod_name,
           ROUND( (share_2020 - share_2019) * 100.0, 2 ) AS pct_point_change
    FROM   top20
)
SELECT prod_id,
       prod_name,
       pct_point_change
FROM   diffs
ORDER  BY ABS(pct_point_change)
LIMIT  20
