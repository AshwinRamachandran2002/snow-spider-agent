```sql
-- 7.  Cities whose Q4 sales grew by at least 20 %
WITH q19 AS (
    SELECT cu."cust_city" AS city, SUM(s."amount_sold") AS amt19
    FROM "sales" AS s
    JOIN "times" AS t  ON s."time_id" = t."time_id"
    JOIN "customers" AS cu ON s."cust_id" = cu."cust_id"
    JOIN "countries" AS co ON cu."country_id" = co."country_id"
    WHERE co."country_name" = 'United States'
      AND s."promo_id" = 999
      AND t."calendar_quarter_id" = 1772
    GROUP BY cu."cust_city"
), q20 AS (
    SELECT cu."cust_city" AS city, SUM(s."amount_sold") AS amt20
    FROM "sales" AS s
    JOIN "times" AS t  ON s."time_id" = t."time_id"
    JOIN "customers" AS cu ON s."cust_id" = cu."cust_id"
    JOIN "countries" AS co ON cu."country_id" = co."country_id"
    WHERE co."country_name" = 'United States'
      AND s."promo_id" = 999
      AND t."calendar_quarter_id" = 1776
    GROUP BY cu."cust_city"
)
SELECT q20.city,
       q19.amt19,
       q20.amt20,
       ROUND( (q20.amt20 - q19.amt19) * 100.0 / q19.amt19 , 1) AS pct_growth
FROM q19
JOIN q20 ON q19.city = q20.city
WHERE q20.amt20 >= 1.20 * q19.amt19
ORDER BY pct_growth DESC
LIMIT 20;
```

```sql
-- 8.  Total promo‑999 sales (both quarters combined) per product
WITH good_cities AS (
    /* reuse the growth‑qualified cities from step 7 */
    WITH q19 AS (
        SELECT cu."cust_city" AS city, SUM(s."amount_sold") AS amt19
        FROM "sales" AS s
        JOIN "times" AS t  ON s."time_id" = t."time_id"
        JOIN "customers" AS cu ON s."cust_id" = cu."cust_id"
        JOIN "countries" AS co ON cu."country_id" = co."country_id"
        WHERE co."country_name" = 'United States'
          AND s."promo_id" = 999
          AND t."calendar_quarter_id" = 1772
        GROUP BY cu."cust_city"
    ), q20 AS (
        SELECT cu."cust_city" AS city, SUM(s."amount_sold") AS amt20
        FROM "sales" AS s
        JOIN "times" AS t  ON s."time_id" = t."time_id"
        JOIN "customers" AS cu ON s."cust_id" = cu."cust_id"
        JOIN "countries" AS co ON cu."country_id" = co."country_id"
        WHERE co."country_name" = 'United States'
          AND s."promo_id" = 999
          AND t."calendar_quarter_id" = 1776
        GROUP BY cu."cust_city"
    )
    SELECT q19.city
    FROM q19
    JOIN q20 ON q19.city = q20.city
    WHERE q20.amt20 >= 1.20 * q19.amt19
)
SELECT p."prod_id",
       p."prod_name",
       SUM(s."amount_sold") AS total_sales
FROM "sales" AS s
JOIN "times" AS t   ON s."time_id" = t."time_id"
JOIN "customers" AS cu ON s."cust_id" = cu."cust_id"
JOIN good_cities AS gc ON cu."cust_city" = gc.city
JOIN "products" AS p ON s."prod_id" = p."prod_id"
WHERE s."promo_id" = 999
  AND t."calendar_quarter_id" IN (1772, 1776)
GROUP BY p."prod_id", p."prod_name"
ORDER BY total_sales DESC
LIMIT 20;
```

```sql
-- 9.  Per‑quarter sales & share of total for each product (only growth cities)
WITH good_cities AS (
    /* same CTE as above */
    WITH q19 AS (
        SELECT cu."cust_city" AS city, SUM(s."amount_sold") AS amt19
        FROM "sales" AS s
        JOIN "times" AS t ON s."time_id" = t."time_id"
        JOIN "customers" AS cu ON s."cust_id" = cu."cust_id"
        JOIN "countries" AS co ON cu."country_id" = co."country_id"
        WHERE co."country_name" = 'United States'
          AND s."promo_id" = 999
          AND t."calendar_quarter_id" = 1772
        GROUP BY cu."cust_city"
    ), q20 AS (
        SELECT cu."cust_city" AS city, SUM(s."amount_sold") AS amt20
        FROM "sales" AS s
        JOIN "times" AS t ON s."time_id" = t."time_id"
        JOIN "customers" AS cu ON s."cust_id" = cu."cust_id"
        JOIN "countries" AS co ON cu."country_id" = co."country_id"
        WHERE co."country_name" = 'United States'
          AND s."promo_id" = 999
          AND t."calendar_quarter_id" = 1776
        GROUP BY cu."cust_city"
    )
    SELECT q19.city
    FROM q19 JOIN q20 ON q19.city = q20.city
    WHERE q20.amt20 >= 1.20 * q19.amt19
),
base AS (
    SELECT p."prod_id",
           p."prod_name",
           t."calendar_quarter_id" AS qtr,
           SUM(s."amount_sold") AS amt
    FROM "sales" AS s
    JOIN "times" AS t   ON s."time_id" = t."time_id"
    JOIN "customers" AS cu ON s."cust_id" = cu."cust_id"
    JOIN good_cities AS gc ON cu."cust_city" = gc.city
    JOIN "products" AS p ON s."prod_id" = p."prod_id"
    WHERE s."promo_id" = 999
      AND t."calendar_quarter_id" IN (1772, 1776)
    GROUP BY p."prod_id", p."prod_name", t."calendar_quarter_id"
),
totals AS (
    SELECT qtr, SUM(amt) AS tot_amt
    FROM base
    GROUP BY qtr
)
SELECT b."prod_id",
       b."prod_name",
       b.qtr,
       b.amt,
       ROUND(100.0 * b.amt / t.tot_amt, 2) AS pct_share
FROM base AS b
JOIN totals AS t ON b.qtr = t.qtr
ORDER BY b."prod_id", b.qtr
LIMIT 20;
```

```sql
-- 10.  FINAL: product (in top 20 % of total sales) with smallest change in share between Q4‑2019 and Q4‑2020
WITH good_cities AS (
    /* identical logic to previous steps – growth ≥ 20 % */
    WITH q19 AS (
        SELECT cu."cust_city" AS city, SUM(s."amount_sold") AS amt19
        FROM "sales" AS s
        JOIN "times" AS t ON s."time_id" = t."time_id"
        JOIN "customers" AS cu ON s."cust_id" = cu."cust_id"
        JOIN "countries" AS co ON cu."country_id" = co."country_id"
        WHERE co."country_name" = 'United States'
          AND s."promo_id" = 999
          AND t."calendar_quarter_id" = 1772
        GROUP BY cu."cust_city"
    ), q20 AS (
        SELECT cu."cust_city" AS city, SUM(s."amount_sold") AS amt20
        FROM "sales" AS s
        JOIN "times" AS t ON s."time_id" = t."time_id"
        JOIN "customers" AS cu ON s."cust_id" = cu."cust_id"
        JOIN "countries" AS co ON cu."country_id" = co."country_id"
        WHERE co."country_name" = 'United States'
          AND s."promo_id" = 999
          AND t."calendar_quarter_id" = 1776
        GROUP BY cu."cust_city"
    )
    SELECT q19.city
    FROM q19 JOIN q20 ON q19.city = q20.city
    WHERE q20.amt20 >= 1.20 * q19.amt19
),
sales_in_scope AS (
    SELECT p."prod_id",
           p."prod_name",
           t."calendar_quarter_id" AS qtr,
           SUM(s."amount_sold") AS amt
    FROM "sales" AS s
    JOIN "times" AS t   ON s."time_id" = t."time_id"
    JOIN "customers" AS cu ON s."cust_id" = cu."cust_id"
    JOIN good_cities AS gc ON cu."cust_city" = gc.city
    JOIN "products" AS p ON s."prod_id" = p."prod_id"
    WHERE s."promo_id" = 999
      AND t."calendar_quarter_id" IN (1772, 1776)
    GROUP BY p."prod_id", p."prod_name", t."calendar_quarter_id"
),
totals AS (
    SELECT qtr, SUM(amt) AS tot_amt
    FROM sales_in_scope
    GROUP BY qtr
),
shares AS (
    SELECT s."prod_id",
           s."prod_name",
           s.qtr,
           1.0 * s.amt / t.tot_amt AS share
    FROM sales_in_scope AS s
    JOIN totals AS t ON s.qtr = t.qtr
),
pivot AS (
    SELECT prod_id,
           prod_name,
           MAX(CASE WHEN qtr = 1772 THEN share END) AS share_2019,
           MAX(CASE WHEN qtr = 1776 THEN share END) AS share_2020,
           SUM(amt) AS total_amt        -- over both quarters
    FROM sales_in_scope
    GROUP BY prod_id, prod_name
),
ranked AS (
    /* Determine top 20 % products by total sales */
    SELECT p.*,
           (SELECT COUNT(*) FROM pivot)     AS total_products,
           (SELECT COUNT(*) FROM pivot AS x
            WHERE x.total_amt > p.total_amt) AS better_than
    FROM pivot AS p
),
top20 AS (
    /* keep rows whose rank is within top 20 %  */
    SELECT *
    FROM ranked
    WHERE better_than < 0.20 * total_products
),
diffs AS (
    SELECT prod_id,
           prod_name,
           ROUND( (share_2020 - share_2019) * 100.0 , 2) AS pct_point_change
    FROM top20
)
SELECT prod_id,
       prod_name,
       pct_point_change
FROM diffs
ORDER BY ABS(pct_point_change)        -- smallest absolute change first
LIMIT 20;
```

The tenth query brings together every element described in the task:  
• filters on U.S. customers only, promo_id = 999, and the two quarters of interest  
• restricts the analysis to cities whose sales grew by ≥ 20 %  
• computes each product’s share of total sales in the two quarters  
• keeps only products in the top 20 % by total sales  
• returns the product(s) with the smallest percentage‑point change in share between Q4‑2019 and Q4‑2020.
