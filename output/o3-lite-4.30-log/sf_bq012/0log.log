--Description: Join BLOCKS (b) and TRANSACTIONS (t) on their numeric identifiers
-- (b."number" = t."block_number") to align each transaction with the miner of
-- its block.  For every (block, miner) pair, multiply t."gas_price" by
-- t."receipt_gas_used" to compute the gas fee paid in Wei, sum these values to
-- obtain the miner’s total gas‑fee revenue for that block, then return the
-- latest 20 blocks for verification.
SELECT
       b."number"                                   AS "block_number",
       b."miner",
       SUM(t."gas_price" * t."receipt_gas_used")    AS "miner_fee_wei"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."BLOCKS"        b
JOIN   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TRANSACTIONS"  t
       ON b."number" = t."block_number"
GROUP BY
       b."number",
       b."miner"
ORDER BY
       b."number" DESC
LIMIT 20;
