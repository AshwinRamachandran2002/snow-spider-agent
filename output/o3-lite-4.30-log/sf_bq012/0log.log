--Description: Join BLOCKS (b) and TRANSACTIONS (t) on their numeric identifiers 
-- (b."number" = t."block_number") so each transaction is linked to the miner who 
-- produced the block.  Calculate the gas fee for every transaction as 
-- COALESCE(t."gas_price",0) * COALESCE(t."receipt_gas_used",0) to avoid NULL‑
-- related nullification, then sum these fees per miner to obtain each miner’s 
-- total gas‑fee revenue.  Order the results by the largest totals and display 
-- a sample of 20 miners.
SELECT
       b."miner"                                                       AS "address",
       SUM(COALESCE(t."gas_price",0) * COALESCE(t."receipt_gas_used",0)) AS "total_gas_earned_wei"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."BLOCKS"        b
JOIN   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TRANSACTIONS"  t
       ON b."number" = t."block_number"
GROUP BY
       b."miner"
ORDER BY
       "total_gas_earned_wei" DESC
LIMIT 20;
