```sql
--Description:  Link each transaction to the miner of its block by joining
--  TRANSACTIONS (t) on BLOCKS (b) through the numeric identifiers
--  t."block_number" = b."number".  Consider only successful transactions
--  (t."receipt_status" = 1) and rows with valid gas metrics, then calculate
--  the fee per transaction as "gas_price" * "receipt_gas_used".  Aggregate
--  these fees per miner address to obtain the total amount of gas fees each
--  miner has earned.  Display the 20 miners with the highest cumulative fees.
SELECT
       b."miner"                                   AS "address",
       SUM(t."gas_price" * t."receipt_gas_used")   AS "total_gas_earned_wei"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TRANSACTIONS" t
JOIN   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."BLOCKS"       b
       ON t."block_number" = b."number"
WHERE  t."receipt_status" = 1
  AND  t."gas_price" IS NOT NULL
  AND  t."receipt_gas_used" IS NOT NULL
GROUP BY
       b."miner"
ORDER BY
       "total_gas_earned_wei" DESC
LIMIT 20;
```
