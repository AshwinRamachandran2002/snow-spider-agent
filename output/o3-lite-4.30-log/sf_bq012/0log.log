```sql
--Description: Join BLOCKS (alias b) with TRANSACTIONS (alias t) on the numeric
-- identifier (b."number" = t."block_number").  Filter to successful transactions
-- (t."receipt_status" = 1).  For each miner in each block, add up gas fees paid
-- by all transactions in that block (fee = "gas_price" * "receipt_gas_used").
-- Show the first 20 (block_number, miner, miner_fee_wei) rows.
SELECT
       b."number"                                        AS "block_number",
       b."miner",
       SUM(t."gas_price" * t."receipt_gas_used")         AS "miner_fee_wei"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."BLOCKS"       b
JOIN   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TRANSACTIONS"  t
       ON b."number" = t."block_number"
WHERE  t."receipt_status" = 1
GROUP BY
       b."number",
       b."miner"
LIMIT 20;
