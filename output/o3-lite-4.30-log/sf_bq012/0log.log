```sql
--Description: Retrieve a quick preview of miner gas‑fee revenue by:
-- 1) joining TRANSACTIONS (alias t) to BLOCKS (alias b) on their numeric IDs
--    (t."block_number" = b."number"); this links each transaction to its block
--    and corresponding miner address.
-- 2) calculating gas fee per transaction as t."gas_price" * t."receipt_gas_used".
-- 3) summing those fees for every (block, miner) pair to obtain total revenue
--    earned by the miner in that block.
-- 4) returning 20 rows (ordered by block_number descending) to confirm data.
SELECT
       b."number"                                   AS "block_number",
       b."miner",
       SUM(t."gas_price" * t."receipt_gas_used")    AS "miner_fee_wei"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TRANSACTIONS" t
JOIN   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."BLOCKS"       b
       ON t."block_number" = b."number"
GROUP BY
       b."number",
       b."miner"
ORDER BY
       b."number" DESC
LIMIT 20;
```
