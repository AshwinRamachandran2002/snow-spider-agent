```sql
--Description:  Pair each transaction with the miner of its block by joining
--  TRANSACTIONS (t) to BLOCKS (b) on their shared numeric identifier
--  (t."block_number" = b."number").  Keep only successful transactions
--  (t."receipt_status" = 1).  For every miner, multiply "gas_price" by
--  "receipt_gas_used" to get the gas fee paid in Wei, then sum those fees to
--  obtain the total gas‑fee revenue earned by that miner across all blocks.
--  Show the 20 miners with the highest totals.
SELECT
       b."miner"                                   AS "address",
       SUM(t."gas_price" * t."receipt_gas_used")   AS "total_gas_earned_wei"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TRANSACTIONS" t
JOIN   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."BLOCKS"       b
       ON t."block_number" = b."number"
WHERE  t."receipt_status" = 1
GROUP BY
       b."miner"
ORDER BY
       "total_gas_earned_wei" DESC
LIMIT 20;
