```sql
--Description: Preview gas‑fee revenue for the miner of each of the 20 most‑recent blocks.  
--Reasoning steps:  
--1. A transaction’s gas fee equals gas_price × receipt_gas_used; that fee goes to the block’s miner.  
--2. Instead of joining on the block hash (which can miss rows if hashes differ in case/format),  
--   join BLOCKS and TRANSACTIONS on their shared numeric field block_number to ensure matches.  
--3. Replace any NULL gas_price or receipt_gas_used with 0 via COALESCE so rows with missing
--   data contribute 0 rather than being dropped.  
--4. Group by block_number and miner to obtain per‑block totals, order by the latest block_number,
--   and limit to 20 rows for a concise preview.  
SELECT
    b."number"                                                       AS "block_number",
    b."miner"                                                        AS "miner_address",
    SUM( COALESCE(t."gas_price", 0) * COALESCE(t."receipt_gas_used", 0) ) 
        AS "gas_fee_wei"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.BLOCKS        b
JOIN ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS  t
      ON b."number" = t."block_number"
GROUP BY b."number", b."miner"
ORDER BY b."number" DESC
LIMIT 20;
```
