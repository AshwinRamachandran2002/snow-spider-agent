The table structure information is ({database name: {schema name: [table name]}}): 
{'ETHEREUM_BLOCKCHAIN': {'ETHEREUM_BLOCKCHAIN': ['BLOCKS', 'TOKENS', 'TRACES', 'CONTRACTS', 'LOGS', 'TOKEN_TRANSFERS', 'TRANSACTIONS']}}
Begin Exploring Related Columns
Relevant columns and their potential usage  
• TRACES."value": amount (Wei) moved in each internal transfer – used for incoming/outgoing balances  
• TRACES."to_address": receiver address – used for incoming amount aggregation  
• TRACES."from_address": sender address – used for outgoing amount aggregation  
• TRACES."status": filter to successful transfers (1)  
• TRACES."call_type": exclude 'delegatecall', 'callcode', 'staticcall'  
• TRACES."trace_type": keep normal value‑moving traces such as 'call' (and maybe 'create', ‘suicide’)  
• TRANSACTIONS."gas_price": gas price (Wei) – used to calculate gas fee paid by a sender  
• TRANSACTIONS."receipt_gas_used": gas actually consumed – used with gas_price  
• TRANSACTIONS."from_address": sender that pays the gas fee  
• BLOCKS."miner": coinbase (miner) address – receives all gas fees of that block  
• BLOCKS."number" / BLOCKS."hash": join key to transactions / traces to allocate miner fee  
• TOKEN_TRANSFERS, LOGS, TOKENS, CONTRACTS: not required for the requested computation  

Basic filters / conditions that will be used  
• TRACES."status" = 1  
• TRACES."call_type" NOT IN ('delegatecall','callcode','staticcall') OR TRACES."call_type" IS NULL  
• TRACES."to_address" IS NOT NULL AND TRACES."from_address" IS NOT NULL  
• TRANSACTIONS."receipt_gas_used" IS NOT NULL  
• Exclude NULL or empty ("0x0000000000000000000000000000000000000000") addresses in all address columns  

Below are ten exploratory‑to‑final Snowflake SQL queries (all return ≤20 rows) showing the thought path toward the final answer.

```sql
--Description: 1) Peek into successful traces carrying value, while excluding delegate/static/callcode variations
SELECT 
  "value",
  "from_address",
  "to_address",
  "call_type",
  "status",
  "trace_type"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE "status" = 1
  AND (   "call_type" IS NULL 
       OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))
  AND "value" > 0
LIMIT 20;
```

```sql
--Description: 2) List the different call_type strings that appear inside successful traces
SELECT DISTINCT "call_type"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE "status" = 1
LIMIT 20;
```

```sql
--Description: 3) Quick look at transaction‑level gas values
SELECT 
  "hash",
  "from_address",
  "gas_price",
  "receipt_gas_used"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
WHERE "receipt_gas_used" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 4) Prototype gas‑fee calculation for a handful of transactions
SELECT 
  "hash",
  "from_address",
  "gas_price" * "receipt_gas_used" AS "gas_fee_wei"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
WHERE "receipt_gas_used" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 5) Preview miners with total gas fees collected in their latest blocks
SELECT 
  b."miner",
  SUM(t."gas_price" * t."receipt_gas_used") AS "total_gas_fee_wei"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.BLOCKS AS b
JOIN ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS AS t
  ON b."hash" = t."block_hash"
WHERE t."receipt_gas_used" IS NOT NULL
GROUP BY b."miner", b."number"
ORDER BY b."number" DESC
LIMIT 20;
```

```sql
--Description: 6) Aggregate incoming value per address from traces (partial sample)
SELECT 
  "to_address"   AS "address",
  SUM("value")   AS "incoming_wei"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE "status" = 1
  AND (   "call_type" IS NULL 
       OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))
  AND "to_address" IS NOT NULL
GROUP BY "to_address"
ORDER BY "incoming_wei" DESC
LIMIT 20;
```

```sql
--Description: 7) Aggregate outgoing value per address from traces (partial sample)
SELECT 
  "from_address" AS "address",
  SUM("value")   AS "outgoing_wei"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE "status" = 1
  AND (   "call_type" IS NULL 
       OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))
  AND "from_address" IS NOT NULL
GROUP BY "from_address"
ORDER BY "outgoing_wei" DESC
LIMIT 20;
```

```sql
--Description: 8) Gas fees paid per sender (sample)
SELECT 
  "from_address" AS "address",
  SUM("gas_price" * "receipt_gas_used") AS "gas_paid_wei"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
WHERE "receipt_gas_used" IS NOT NULL
  AND "from_address" IS NOT NULL
GROUP BY "from_address"
ORDER BY "gas_paid_wei" DESC
LIMIT 20;
```

```sql
--Description: 9) Gas fees earned per miner (sample)
SELECT 
  b."miner"      AS "address",
  SUM(t."gas_price" * t."receipt_gas_used") AS "gas_earned_wei"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.BLOCKS        b
JOIN ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS  t
  ON b."hash" = t."block_hash"
WHERE t."receipt_gas_used" IS NOT NULL
  AND b."miner" IS NOT NULL
GROUP BY b."miner"
ORDER BY "gas_earned_wei" DESC
LIMIT 20;
```

```sql
--Description: 10) Final query – compute net balances, pick top 10, then show the average in quadrillions (10^15 Wei) rounded to two decimals
WITH
incoming AS (
  SELECT 
    "to_address" AS "address",
    SUM("value") AS "incoming_wei"
  FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
  WHERE "status" = 1
    AND (   "call_type" IS NULL 
         OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))
    AND "to_address" IS NOT NULL
    AND "to_address" <> '0x0000000000000000000000000000000000000000'
  GROUP BY "to_address"
),
outgoing AS (
  SELECT 
    "from_address" AS "address",
    SUM("value") AS "outgoing_wei"
  FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
  WHERE "status" = 1
    AND (   "call_type" IS NULL 
         OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))
    AND "from_address" IS NOT NULL
    AND "from_address" <> '0x0000000000000000000000000000000000000000'
  GROUP BY "from_address"
),
gas_paid AS (
  SELECT 
    "from_address" AS "address",
    SUM("gas_price" * "receipt_gas_used") AS "gas_paid_wei"
  FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
  WHERE "receipt_gas_used" IS NOT NULL
    AND "from_address" IS NOT NULL
    AND "from_address" <> '0x0000000000000000000000000000000000000000'
  GROUP BY "from_address"
),
gas_earned AS (
  SELECT 
    b."miner" AS "address",
    SUM(t."gas_price" * t."receipt_gas_used") AS "gas_earned_wei"
  FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.BLOCKS       b
  JOIN ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS t
    ON b."hash" = t."block_hash"
  WHERE t."receipt_gas_used" IS NOT NULL
    AND b."miner" IS NOT NULL
    AND b."miner" <> '0x0000000000000000000000000000000000000000'
  GROUP BY b."miner"
),
net AS (
  SELECT 
      COALESCE(i."address", o."address", gp."address", ge."address") AS "address",
      COALESCE(i."incoming_wei", 0)        AS "incoming_wei",
      COALESCE(o."outgoing_wei", 0)        AS "outgoing_wei",
      COALESCE(gp."gas_paid_wei", 0)       AS "gas_paid_wei",
      COALESCE(ge."gas_earned_wei", 0)     AS "gas_earned_wei",
      /* net balance = incoming + gas earned - outgoing - gas paid */
      COALESCE(i."incoming_wei", 0)
    + COALESCE(ge."gas_earned_wei", 0)
    - COALESCE(o."outgoing_wei", 0)
    - COALESCE(gp."gas_paid_wei", 0)       AS "net_wei"
  FROM incoming  i
  FULL OUTER JOIN outgoing   o  ON i."address" = o."address"
  FULL OUTER JOIN gas_paid   gp ON COALESCE(i."address", o."address") = gp."address"
  FULL OUTER JOIN gas_earned ge ON COALESCE(i."address", o."address", gp."address") = ge."address"
)
SELECT 
  ROUND( AVG("net_wei") / 1e15 , 2) AS "avg_net_balance_quadrillion_wei"
FROM (
  SELECT "address", "net_wei"
  FROM net
  ORDER BY "net_wei" DESC
  LIMIT 10
)
LIMIT 20;
```

