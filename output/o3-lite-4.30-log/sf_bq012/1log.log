--Description: Compute lifetime gas‑fee revenue for each Ethereum miner and list the top‑20.  
--Reasoning:  
-- 1. A transaction’s gas fee equals gas_price × receipt_gas_used; that fee is credited to the block’s miner.  
-- 2. Join TRANSACTIONS to BLOCKS on their shared numeric key block_number (more robust than block_hash).  
-- 3. Wrap gas_price and receipt_gas_used with COALESCE to convert NULLs to 0, avoiding loss of rows.  
-- 4. Aggregate the fees by miner, order by the total descending, and limit to 20 for a concise preview.  
SELECT
    b."miner"                                                    AS "miner_address",
    SUM( COALESCE(t."gas_price", 0) * COALESCE(t."receipt_gas_used", 0) )
        AS "gas_earned_wei"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.BLOCKS        b
JOIN ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS  t
      ON b."number" = t."block_number"
WHERE b."miner" IS NOT NULL
GROUP BY b."miner"
ORDER BY "gas_earned_wei" DESC
LIMIT 20;
