```sql
--Description:  Compute total gas‑fee revenue for each miner (top‑20).
--Thought path:
--  • Every transaction pays its block’s miner gas_price * receipt_gas_used.
--  • Joining TRANSACTIONS to BLOCKS on block_number (t."block_number" = b."number") reliably links each
--    transaction with its miner, avoiding hash‑format mismatches that previously produced empty output.
--  • NULL gas_price or receipt_gas_used would otherwise drop rows; wrapping them in COALESCE(value,0)
--    keeps the rows and simply adds 0 to the sum when data is missing.
--  • Aggregate the fees per miner, order by the total descending, and LIMIT 20 to preview the biggest earners.
SELECT
    b."miner"                                                    AS "miner_address",
    SUM( COALESCE(t."gas_price", 0) * COALESCE(t."receipt_gas_used", 0) ) AS "gas_earned_wei"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.BLOCKS        b
JOIN ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS  t
      ON b."number" = t."block_number"
WHERE b."miner" IS NOT NULL
GROUP BY b."miner"
ORDER BY "gas_earned_wei" DESC
LIMIT 20;
```
