```sql
--Description: Calculate gas‑fee rewards for the most recent 20 blocks.  
--Thought path:  
--• Each transaction pays its block’s miner gas_price * receipt_gas_used.  
--• Joining TRANSACTIONS to BLOCKS via block_hash gives the miner for every transaction.  
--• Grouping by block_number + miner (one miner per block) lets us add up all fees inside a block.  
--• Ordering by block_number DESC surfaces the latest blocks; LIMIT 20 keeps output small.  
SELECT
    b."number"                         AS "block_number",
    b."miner"                          AS "miner_address",
    SUM( COALESCE(t."gas_price",0) 
        * COALESCE(t."receipt_gas_used",0) ) AS "gas_fee_earned_wei"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.BLOCKS        b
JOIN ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS  t
     ON b."hash" = t."block_hash"
GROUP BY b."number", b."miner"
ORDER BY b."number" DESC
LIMIT 20;
