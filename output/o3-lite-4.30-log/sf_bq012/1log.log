```sql
--Description:  Calculate lifetime gas‑fee revenue for each miner and list the top 20 earners.
--Thinking process:
-- 1.  A transaction’s gas fee equals gas_price * receipt_gas_used; that fee is credited to the
--     miner of the block containing the transaction.
-- 2.  Join TRANSACTIONS to BLOCKS on their shared numeric key block_number (t."block_number"
--     = b."number") to reliably pair every transaction with its miner.
-- 3.  Some transactions store NULL in gas_price or receipt_gas_used.  Using COALESCE(value,0)
--     converts those NULLs to 0 so they contribute nothing instead of eliminating the row.
-- 4.  Aggregate the fee per miner with SUM, sort by the total descending, and LIMIT 20 to get
--     a concise preview of the highest‑earning miners.
SELECT
    b."miner"                                                     AS "miner_address",
    SUM( COALESCE(t."gas_price", 0) * COALESCE(t."receipt_gas_used", 0) )
        AS "total_gas_fee_wei"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS  t
JOIN ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.BLOCKS        b
      ON t."block_number" = b."number"
WHERE b."miner" IS NOT NULL
GROUP BY b."miner"
ORDER BY "total_gas_fee_wei" DESC
LIMIT 20;
```
