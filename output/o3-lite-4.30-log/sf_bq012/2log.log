Query:
--Description: Combine net TRACE flows with gas fees paid (senders) and earned (miners)
--             using the simplified miner‑fee calculation that joins BLOCKS ↔ TRANSACTIONS
--             directly.  The query produces the top 20 addresses by overall net balance.
WITH
-- 1) Net ETH movement from successful traces (value transfers only)
trace_filters AS (
    SELECT *
    FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
    WHERE "status" = 1
      AND "trace_type" IN ('call','create')
      AND ( "call_type" IS NULL
            OR "call_type" NOT IN ('delegatecall','callcode','staticcall') )
),
incoming AS (
    SELECT "to_address"   AS "address",
           SUM("value")   AS "wei_delta"
    FROM   trace_filters
    GROUP  BY "to_address"
),
outgoing AS (
    SELECT "from_address" AS "address",
           -SUM("value")  AS "wei_delta"
    FROM   trace_filters
    GROUP  BY "from_address"
),
trace_net AS (
    SELECT * FROM incoming
    UNION ALL
    SELECT * FROM outgoing
),

-- 2) Gas fees paid by transaction senders (negative balance impact)
gas_paid AS (
    SELECT
           "from_address" AS "address",
           -SUM( COALESCE("receipt_gas_used",0) * COALESCE("gas_price",0) ) AS "wei_delta"
    FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
    GROUP  BY "from_address"
),

-- 3) Gas fees earned by miners (positive balance impact) – simplified join
gas_earned AS (
    SELECT
           b."miner" AS "address",
           SUM( COALESCE(t."receipt_gas_used",0) * COALESCE(t."gas_price",0) ) AS "wei_delta"
    FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.BLOCKS        AS b
    LEFT  JOIN ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS AS t
           ON t."block_number" = b."number"
    GROUP  BY b."miner"
)

SELECT
       combined."address",
       SUM(combined."wei_delta") AS "current_net_wei"
FROM   (
        SELECT * FROM trace_net
        UNION ALL
        SELECT * FROM gas_paid
        UNION ALL
        SELECT * FROM gas_earned
) AS combined
WHERE  combined."address" NOT ILIKE '0x0000000000000000000000000000000000000000'
GROUP  BY combined."address"
ORDER  BY "current_net_wei" DESC
LIMIT  20
