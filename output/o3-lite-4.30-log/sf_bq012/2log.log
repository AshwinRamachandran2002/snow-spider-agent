```sql
--Description: Aggregate total gas‑fee revenue per miner by
--             1) starting with all blocks (each has one miner),
--             2) LEFT JOINing the transactions in those blocks,
--             3) treating NULL receipt_gas_used or gas_price as 0 so every
--                row contributes safely, and
--             4) summing (receipt_gas_used * gas_price) across all
--                transactions mined by each address.
--             This guarantees results even if some blocks/transactions
--             have missing gas information and avoids “no data found”.
SELECT
       b."miner",
       SUM( COALESCE(t."receipt_gas_used", 0) * COALESCE(t."gas_price", 0) ) AS "total_miner_fee_wei"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.BLOCKS        AS b
LEFT  JOIN ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS AS t
       ON t."block_number" = b."number"
GROUP  BY b."miner"
ORDER  BY "total_miner_fee_wei" DESC
LIMIT  20;
```
