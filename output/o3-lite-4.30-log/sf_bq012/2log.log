2025-05-01 01:35:03 - Thread-366 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  

• TRACES  
  – "from_address": Ether sender (outflow)  
  – "to_address": Ether receiver (inflow)  
  – "value": Wei transferred  
  – "status": keep only successful traces ( = 1 )  
  – "trace_type": want only ‘call’ & ‘create’ (money‑moving)  
  – "call_type": exclude 'delegatecall' , 'callcode' , 'staticcall'  
  – "block_number": join helper for chronology / miner fees  

• TRANSACTIONS  
  – "from_address": pays the gas fee (outflow)  
  – "receipt_gas_used": gas actually consumed  
  – "gas_price": Wei per gas ‑> fee = gas_used*gas_price  
  – "block_number": to attribute fees to miner  
  – "hash": join key if needed  

• BLOCKS  
  – "miner": receives block fees (inflow)  
  – "number": join key to aggregate fees per block  

Basic conditions that will be useful  

1. "status" = 1                             -- successful traces only  
2. "trace_type" IN ('call','create')        -- real value transfers  
3. "call_type" IS NULL OR "call_type" NOT IN ('delegatecall','callcode','staticcall')  
4. "from_address" NOT ILIKE '0x0000000000000000000000000000000000000000'  
   AND "to_address"   NOT ILIKE '0x0000000000000000000000000000000000000000'  

Below are 10 exploratory Snowflake SQL queries (each limited to 20 rows) that gradually move from simple inspection to the full calculation outline.  
Every column name is double‑quoted; table references use the exact catalog path ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.<TABLE>.  

```sql
-- 1. Description: Quick look at the different trace and call types that exist.
SELECT DISTINCT 
       "trace_type",
       "call_type"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
LIMIT  20;
```

```sql
-- 2. Description: Sample of successful money‑moving traces after the basic filters.
SELECT 
       "from_address",
       "to_address",
       "value",
       "block_number"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE  "status" = 1
  AND  "trace_type" IN ('call','create')
  AND ( "call_type" IS NULL 
        OR "call_type" NOT IN ('delegatecall','callcode','staticcall') )
LIMIT  20;
```

```sql
-- 3. Description: Top receivers by total incoming value (Wei) – preview only.
SELECT 
       "to_address",
       SUM("value") AS "total_incoming_wei"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE  "status" = 1
  AND  "trace_type" IN ('call','create')
  AND ( "call_type" IS NULL 
        OR "call_type" NOT IN ('delegatecall','callcode','staticcall') )
GROUP  BY "to_address"
ORDER  BY "total_incoming_wei" DESC
LIMIT  20;
```

```sql
-- 4. Description: Top senders by total outgoing value (Wei) – preview only.
SELECT 
       "from_address",
       SUM("value") AS "total_outgoing_wei"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE  "status" = 1
  AND  "trace_type" IN ('call','create')
  AND ( "call_type" IS NULL 
        OR "call_type" NOT IN ('delegatecall','callcode','staticcall') )
GROUP  BY "from_address"
ORDER  BY "total_outgoing_wei" DESC
LIMIT  20;
```

```sql
-- 5. Description: Net trace balance (incoming‑outgoing) per address – sample.
WITH trace_flows AS (
    SELECT "to_address"   AS "address", SUM("value") AS "in_wei"
    FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
    WHERE  "status" = 1
      AND  "trace_type" IN ('call','create')
      AND ( "call_type" IS NULL 
            OR "call_type" NOT IN ('delegatecall','callcode','staticcall') )
    GROUP  BY "to_address"

    UNION ALL

    SELECT "from_address" AS "address", -SUM("value") AS "in_wei"
    FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
    WHERE  "status" = 1
      AND  "trace_type" IN ('call','create')
      AND ( "call_type" IS NULL 
            OR "call_type" NOT IN ('delegatecall','callcode','staticcall') )
    GROUP  BY "from_address"
)
SELECT "address",
       SUM("in_wei") AS "net_trace_wei"
FROM   trace_flows
GROUP  BY "address"
ORDER  BY "net_trace_wei" DESC
LIMIT  20;
```

```sql
-- 6. Description: Inspect how gas fees look on the TRANSACTIONS table.
SELECT 
       "hash",
       "from_address",
       "receipt_gas_used",
       "gas_price",
       ("receipt_gas_used" * "gas_price") AS "gas_fee_wei",
       "block_number"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
WHERE  "receipt_gas_used" IS NOT NULL
  AND  "gas_price"        IS NOT NULL
LIMIT  20;
```

```sql
-- 7. Description: Aggregate total gas fees paid by each sender – sample.
SELECT 
       "from_address",
       SUM("receipt_gas_used" * "gas_price") AS "total_gas_paid_wei"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
WHERE  "receipt_gas_used" IS NOT NULL
  AND  "gas_price"        IS NOT NULL
GROUP  BY "from_address"
ORDER  BY "total_gas_paid_wei" DESC
LIMIT  20;
```

```sql
-- 8. Description: Aggregate total gas fees earned by each block miner – sample.
WITH block_fees AS (
    SELECT 
           "block_number",
           SUM("receipt_gas_used" * "gas_price") AS "block_fee_wei"
    FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
    WHERE  "receipt_gas_used" IS NOT NULL
      AND  "gas_price"        IS NOT NULL
    GROUP  BY "block_number"
)
SELECT 
       b."miner",
       SUM(f."block_fee_wei") AS "total_miner_fee_wei"
FROM   block_fees f
JOIN   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.BLOCKS b
       ON b."number" = f."block_number"
GROUP  BY b."miner"
ORDER  BY "total_miner_fee_wei" DESC
LIMIT  20;
```

```sql
-- 9. Description: Combine net trace movements with gas fees (paid & earned) – preview net balance.
WITH trace_net AS (   -- from query 5
    SELECT "address",
           SUM("in_wei") AS "wei_delta"
    FROM (
        SELECT "to_address"   AS "address",  SUM("value") AS "in_wei"
        FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
        WHERE  "status" = 1
          AND  "trace_type" IN ('call','create')
          AND ( "call_type" IS NULL 
                OR "call_type" NOT IN ('delegatecall','callcode','staticcall') )
        GROUP  BY "to_address"
        UNION ALL
        SELECT "from_address" AS "address", -SUM("value") AS "in_wei"
        FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
        WHERE  "status" = 1
          AND  "trace_type" IN ('call','create')
          AND ( "call_type" IS NULL 
                OR "call_type" NOT IN ('delegatecall','callcode','staticcall') )
        GROUP  BY "from_address"
    )
    GROUP  BY "address"
),
gas_paid AS (         -- from query 7
    SELECT "from_address" AS "address",
           -SUM("receipt_gas_used" * "gas_price") AS "wei_delta"
    FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
    WHERE  "receipt_gas_used" IS NOT NULL
      AND  "gas_price"        IS NOT NULL
    GROUP  BY "from_address"
),
gas_earned AS (       -- from query 8
    WITH block_fees AS (
        SELECT "block_number",
               SUM("receipt_gas_used" * "gas_price") AS "block_fee_wei"
        FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
        WHERE  "receipt_gas_used" IS NOT NULL
          AND  "gas_price"        IS NOT NULL
        GROUP  BY "block_number"
    )
    SELECT b."miner" AS "address",
           SUM(f."block_fee_wei") AS "wei_delta"
    FROM   block_fees f
    JOIN   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.BLOCKS b
           ON b."number" = f."block_number"
    GROUP  BY b."miner"
)
SELECT "address",
       SUM("wei_delta") AS "current_net_wei"
FROM   (
        SELECT * FROM trace_net
        UNION ALL
        SELECT * FROM gas_paid
        UNION ALL
        SELECT * FROM gas_earned
)
WHERE  "address" NOT ILIKE '0x0000000000000000000000000000000000000000'
GROUP  BY "address"
ORDER  BY "current_net_wei" DESC
LIMIT  20;
```

```sql
-- 10. Description: Calculate the average balance (in quadrillions, 10^15) of the top 10 addresses.
WITH balances AS (  -- reuse CTE logic from query 9 for full dataset
    /*  ... same CTEs trace_net, gas_paid, gas_earned as above ... */
    /*  For brevity, assume they’re already defined exactly as in query 9 */
    SELECT "address",
           SUM("wei_delta") AS "net_wei"
    FROM (
          SELECT * FROM trace_net
          UNION ALL
          SELECT * FROM gas_paid
          UNION ALL
          SELECT * FROM gas_earned
    )
    WHERE  "address" NOT ILIKE '0x0000000000000000000000000000000000000000'
    GROUP  BY "address"
)
SELECT ROUND( (AVG("net_wei") / 1e15), 2 ) AS "avg_balance_quadrillions"
FROM   (
       SELECT "net_wei"
       FROM   balances
       ORDER  BY "net_wei" DESC
       LIMIT  10
);
```

Each successive query builds understanding and pieces needed to deliver the requested figure while staying within the allowed exploratory scope.
