Relevant tables, columns, and typical conditions  
  
bigquery-public-data.noaa_gsod.stations  
• usaf / wban : join‑keys to the yearly GSOD tables  
• name        : human‑readable station name (include in final list)  
• lat / lon   : build GEOGRAPHY points and limit stations to a 20‑mile (≈32 186.88 m) radius of Chappaqua  
  Condition → ST_DWITHIN(ST_GEOGPOINT(lon,lat), ST_GEOGPOINT(-73.764, 41.197), 32186.88) = TRUE  

bigquery-public-data.noaa_gsod.gsod20YY (2011 … 2020)  
• stn  / wban : join keys ( stn = usaf )  
• temp        : mean daily temperature; valid when temp ≠ 9999.9  
• year        : text year (‘2011’…‘2020’) – already fixed by table name but still useful in UNION queries  
  Condition → temp <> 9999.9 (exclude missing)  

Goal → for every station within the radius, count all valid temperature rows from 2011‑2020.  

------------------------------------------------------------------------  
Ten exploratory → complex example queries (each capped with LIMIT 20)  

```sql
-- 1. Peek at the stations reference table
SELECT usaf, wban, name, lat, lon
FROM `bigquery-public-data.noaa_gsod.stations`
LIMIT 20;
```

```sql
-- 2. Compute straight‑line distance (miles) from Chappaqua for a sample of stations
SELECT usaf,
       wban,
       name,
       ROUND(ST_DISTANCE(ST_GEOGPOINT(lon,lat),
                         ST_GEOGPOINT(-73.764,41.197))/1609.34,2) AS dist_miles
FROM `bigquery-public-data.noaa_gsod.stations`
ORDER BY dist_miles
LIMIT 20;
```

```sql
-- 3. Stations that lie within exactly 20 miles of Chappaqua
SELECT usaf, wban, name, lat, lon
FROM `bigquery-public-data.noaa_gsod.stations`
WHERE ST_DWITHIN(ST_GEOGPOINT(lon,lat),
                 ST_GEOGPOINT(-73.764,41.197),
                 32186.88)
LIMIT 20;
```

```sql
-- 4. Look at one close‑by station’s 2011 raw GSOD rows
SELECT stn, wban, year, mo, da, temp
FROM `bigquery-public-data.noaa_gsod.gsod2011`
WHERE stn = '725060'              -- <<< replace with one usaf you found
  AND wban = '14732'
LIMIT 20;
```

```sql
-- 5. Count *valid* 2011 temperature rows for each station inside 20 miles
WITH near AS (
  SELECT usaf, wban
  FROM `bigquery-public-data.noaa_gsod.stations`
  WHERE ST_DWITHIN(ST_GEOGPOINT(lon,lat),
                   ST_GEOGPOINT(-73.764,41.197),
                   32186.88)
)
SELECT g.stn AS usaf,
       g.wban,
       COUNT(*) AS valid_temp_2011
FROM   `bigquery-public-data.noaa_gsod.gsod2011` AS g
JOIN   near n
  ON   n.usaf = g.stn AND n.wban = g.wban
WHERE  g.temp <> 9999.9
GROUP  BY usaf, g.wban
ORDER  BY valid_temp_2011 DESC
LIMIT 20;
```

```sql
-- 6. Same idea but union two years (2011 + 2012) to see growth
WITH near AS (
  SELECT usaf, wban
  FROM `bigquery-public-data.noaa_gsod.stations`
  WHERE ST_DWITHIN(ST_GEOGPOINT(lon,lat),
                   ST_GEOGPOINT(-73.764,41.197),
                   32186.88)
),
u AS (
  SELECT stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2011`
  UNION ALL
  SELECT stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2012`
)
SELECT stn AS usaf,
       wban,
       COUNT(*) AS valid_temp_2011_2012
FROM   u
JOIN   near n
  ON   n.usaf = stn AND n.wban = wban
WHERE  temp <> 9999.9
GROUP  BY usaf, wban
ORDER  BY valid_temp_2011_2012 DESC
LIMIT 20;
```

```sql
-- 7. Year‑by‑year trend for one nearby station
WITH yearly AS (
  SELECT '2011' AS yy, * FROM `bigquery-public-data.noaa_gsod.gsod2011`
  UNION ALL
  SELECT '2012', * FROM `bigquery-public-data.noaa_gsod.gsod2012`
  UNION ALL
  SELECT '2013', * FROM `bigquery-public-data.noaa_gsod.gsod2013`
)
SELECT yy AS year,
       COUNT(*) AS valid_rows
FROM   yearly
WHERE  stn  = '725060'   -- replace
  AND  wban = '14732'
  AND  temp <> 9999.9
GROUP  BY year
ORDER  BY year
LIMIT 20;
```

```sql
-- 8. Pre‑compute the list of all 2011‑2020 GSOD tables we’ll need
SELECT table_name
FROM `bigquery-public-data.noaa_gsod.__TABLES_SUMMARY__`
WHERE table_name BETWEEN 'gsod2011' AND 'gsod2020'
ORDER BY table_name
LIMIT 20;
```

```sql
-- 9. Build a single UNION ALL view for 2011‑2020 (show sample rows)
WITH gsod_all AS (
  SELECT '2011' AS yr, stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2011`
  UNION ALL
  SELECT '2012', stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2012`
  UNION ALL
  SELECT '2013', stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2013`
  UNION ALL
  SELECT '2014', stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2014`
  UNION ALL
  SELECT '2015', stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2015`
  UNION ALL
  SELECT '2016', stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2016`
  UNION ALL
  SELECT '2017', stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2017`
  UNION ALL
  SELECT '2018', stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2018`
  UNION ALL
  SELECT '2019', stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2019`
  UNION ALL
  SELECT '2020', stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2020`
)
SELECT *
FROM   gsod_all
WHERE  temp <> 9999.9
LIMIT 20;
```

```sql
-- 10. FINAL – stations within 20 miles of Chappaqua and their count of valid 2011‑2020 temperature observations
WITH stations_near AS (
  SELECT usaf, wban, name, lat, lon
  FROM   `bigquery-public-data.noaa_gsod.stations`
  WHERE  ST_DWITHIN(
           ST_GEOGPOINT(lon,lat),
           ST_GEOGPOINT(-73.764,41.197),
           32186.88      -- 20 miles in metres
         )
),
gsod_all AS (
  SELECT stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2011`
  UNION ALL SELECT stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2012`
  UNION ALL SELECT stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2013`
  UNION ALL SELECT stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2014`
  UNION ALL SELECT stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2015`
  UNION ALL SELECT stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2016`
  UNION ALL SELECT stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2017`
  UNION ALL SELECT stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2018`
  UNION ALL SELECT stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2019`
  UNION ALL SELECT stn, wban, temp FROM `bigquery-public-data.noaa_gsod.gsod2020`
),
valid_counts AS (
  SELECT stn,
         wban,
         COUNT(*) AS valid_temp_obs
  FROM   gsod_all
  WHERE  temp <> 9999.9
  GROUP  BY stn, wban
)
SELECT s.usaf,
       s.wban,
       s.name,
       valid_temp_obs
FROM   stations_near  AS s
LEFT  JOIN valid_counts AS v
       ON v.stn  = s.usaf
      AND v.wban = s.wban
ORDER BY valid_temp_obs DESC
LIMIT 20;
```

