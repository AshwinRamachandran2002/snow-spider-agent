```sql
--Description:  
--1. Identify all weather stations whose geographic coordinates fall within a 20‑mile (≈32 186.88 m) radius of the point
--   (‑73.764 lon, 41.197 lat) that represents Chappaqua, NY, using ST_DWITHIN.  
--2. From the GSOD daily‑weather tables, pull every row from the years 2011‑2020 by exploiting the wildcard
--   `gsod*` and filtering with _TABLE_SUFFIX BETWEEN '2011' AND '2020'.  
--3. Exclude rows whose temperature is the sentinel value 9999.9 (meaning “missing”).  
--4. Count how many valid‑temperature rows each nearby station contributed during 2011‑2020.  
--5. Return the station ID (USAF & WBAN), the station name, and the count, sorted by highest count first.  
--   LIMIT 20 just shows a sample of the results.  Removing LIMIT would give the full list.
WITH stations_near AS (
  SELECT
    usaf,
    wban,
    name,
    lat,
    lon
  FROM
    `bigquery-public-data.noaa_gsod.stations`
  WHERE
    ST_DWITHIN(
      ST_GEOGPOINT(lon, lat),
      ST_GEOGPOINT(-73.764, 41.197),   -- Chappaqua, NY
      32186.88                         -- 20 miles in metres
    )
),
gsod_2011_2020 AS (
  SELECT
    _TABLE_SUFFIX AS yr,   -- keeps track of the year the row came from
    stn,
    wban,
    temp
  FROM
    `bigquery-public-data.noaa_gsod.gsod*`
  WHERE
    _TABLE_SUFFIX BETWEEN '2011' AND '2020'
    AND temp <> 9999.9                -- keep only valid temperature readings
)
SELECT
  s.usaf,
  s.wban,
  s.name,
  COUNT(*) AS valid_temp_obs_2011_2020
FROM
  gsod_2011_2020 g
JOIN
  stations_near s
ON
  s.usaf = g.stn
  AND s.wban = g.wban
GROUP BY
  s.usaf,
  s.wban,
  s.name
ORDER BY
  valid_temp_obs_2011_2020 DESC
LIMIT 20;
