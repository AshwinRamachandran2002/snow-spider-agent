```sql
--Description: Build a single UNION‑ALL sample of rows from every GSOD table whose name ends
--with a year between 2011 and 2020.  The wildcard pattern `gsod*` together with the
--_TABLE_SUFFIX filter guarantees we only touch those annual tables.  We also filter out the
--placeholder temperature value 9999.9.  LIMIT 20 provides a quick look at the combined data.
SELECT
  _TABLE_SUFFIX AS yr,
  stn,
  wban,
  temp
FROM `bigquery-public-data.noaa_gsod.gsod*`
WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
  AND temp <> 9999.9
LIMIT 20;
```

```sql
--Description: Final answer — for every weather station located within 20 miles of Chappaqua, NY,
--return the total count of daily records that contain a *valid* mean temperature (temp ≠ 9999.9)
--over the entire 2011‑2020 period.  The query:
--  • builds a list of nearby stations (stations_near) using ST_DWITHIN,
--  • scans all annual GSOD tables 2011‑2020 in one pass via the wildcard and _TABLE_SUFFIX filter,
--  • aggregates the valid‑temperature rows for each (stn, wban) pair,
--  • and joins the counts back to the station list.  Results are sorted by the count and capped at 20.
WITH stations_near AS (
  SELECT usaf, wban, name
  FROM `bigquery-public-data.noaa_gsod.stations`
  WHERE ST_DWITHIN(
          ST_GEOGPOINT(lon, lat),
          ST_GEOGPOINT(-73.764, 41.197),   -- Chappaqua, NY
          32186.88                         -- 20 miles in metres
        )
),
gsod_2011_2020 AS (
  SELECT stn, wban, temp
  FROM `bigquery-public-data.noaa_gsod.gsod*`
  WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
    AND temp <> 9999.9
),
valid_counts AS (
  SELECT
    stn,
    wban,
    COUNT(*) AS valid_temp_obs
  FROM gsod_2011_2020
  GROUP BY stn, wban
)
SELECT
  s.usaf,
  s.wban,
  s.name,
  COALESCE(v.valid_temp_obs, 0) AS valid_temp_obs_2011_2020
FROM stations_near AS s
LEFT JOIN valid_counts AS v
  ON v.stn = s.usaf
 AND v.wban = s.wban
ORDER BY valid_temp_obs_2011_2020 DESC
LIMIT 20;
```
