```sql
--Description:  Goal ‑ list every NOAA GSOD station located ≤ 20 statute miles 
--             from Chappaqua, NY (41.197 N, ‑73.764 W) and count how many daily
--             temperature records it reported during 2011‑2020 that are NOT the
--             sentinel 9999.9 (i.e. valid). 
--             
-- 1.  Each yearly GSOD table has many columns, but *all* years share at least
--     stn, wban, year and temp.  Selecting only those four avoids the UNION
--     column‑count error we hit earlier. 
-- 2.  UNION ALL merges the ten yearly tables into one stream (2011‑2020). 
-- 3.  Join that stream to the stations catalogue for coordinates and names. 
-- 4.  Keep only stations inside the 20‑mile geodesic buffer using ST_DWITHIN
--     (20 mi × 1 609.344 m ≈ 32 186.88 m). 
-- 5.  Discard rows where temp = 9999.9 (missing/invalid). 
-- 6.  GROUP BY station to aggregate a simple count of valid temperature
--     observations across the full decade.  Also compute the exact distance
--     (in miles) for context.  Ordering by distance shows the closest first. 
SELECT
  CONCAT(s.usaf,'-',s.wban)                                AS station_id,
  s.name                                                   AS station_name,
  ROUND(ST_DISTANCE(
          ST_GEOGPOINT(s.lon, s.lat),
          ST_GEOGPOINT(-73.764, 41.197) ) / 1609.344, 2)   AS miles_from_chappaqua,
  COUNT(*)                                                 AS valid_temp_observations_2011_2020
FROM (
  SELECT stn, wban, year, temp FROM `bigquery-public-data.noaa_gsod.gsod2011`
  UNION ALL SELECT stn, wban, year, temp FROM `bigquery-public-data.noaa_gsod.gsod2012`
  UNION ALL SELECT stn, wban, year, temp FROM `bigquery-public-data.noaa_gsod.gsod2013`
  UNION ALL SELECT stn, wban, year, temp FROM `bigquery-public-data.noaa_gsod.gsod2014`
  UNION ALL SELECT stn, wban, year, temp FROM `bigquery-public-data.noaa_gsod.gsod2015`
  UNION ALL SELECT stn, wban, year, temp FROM `bigquery-public-data.noaa_gsod.gsod2016`
  UNION ALL SELECT stn, wban, year, temp FROM `bigquery-public-data.noaa_gsod.gsod2017`
  UNION ALL SELECT stn, wban, year, temp FROM `bigquery-public-data.noaa_gsod.gsod2018`
  UNION ALL SELECT stn, wban, year, temp FROM `bigquery-public-data.noaa_gsod.gsod2019`
  UNION ALL SELECT stn, wban, year, temp FROM `bigquery-public-data.noaa_gsod.gsod2020`
) AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn  = s.usaf
 AND g.wban = s.wban
WHERE ST_DWITHIN(
        ST_GEOGPOINT(s.lon, s.lat),
        ST_GEOGPOINT(-73.764, 41.197),
        32186.88      -- 20 miles in metres
      )
  AND g.temp != 9999.9
GROUP BY station_id, station_name, miles_from_chappaqua
ORDER BY miles_from_chappaqua;
```
