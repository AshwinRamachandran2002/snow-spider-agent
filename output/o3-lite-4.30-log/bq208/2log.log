```sql
--Description:  (#8)  Aggregate the 2011‑2020 decade into ONE total count of
--             valid (temp ≠ 9999.9) observations per station within 20 mi of
--             Chappaqua.  We UNION only common columns (stn, wban, temp) to
--             avoid column‑count mismatches.
SELECT
  s.usaf,
  s.wban,
  s.name,
  COUNT(*) AS valid_temp_days_2011_2020
