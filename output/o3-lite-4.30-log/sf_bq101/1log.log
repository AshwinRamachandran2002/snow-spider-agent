```sql
--Description: Identify the 10 Java packages that appear most frequently in
--             import statements across SAMPLE_CONTENTS.
-- Thinking process:
--   1. Restrict to Java source files by filtering rows whose "sample_path"
--      ends with '.java'.
--   2. Split each file’s "content" into individual lines (SPLIT + LATERAL FLATTEN).
--   3. Retain only the lines whose left‑trimmed text starts with 'import '.
--   4. REGEXP_SUBSTR captures the fully‑qualified identifier immediately following
--      the keyword.
--   5. REGEXP_REPLACE strips the keyword; TRIM removes any trailing semicolon.
--   6. A second REGEXP_REPLACE removes the last dot‑segment (class name or “*”),
--      leaving the pure package name.
--   7. The outer query groups by package, counts how often each appears,
--      orders by the count, and limits to the top 10.
SELECT
       pkg."pure_package" AS "package",
       COUNT(*)           AS "imports_count"
FROM (
      SELECT REGEXP_REPLACE(                                   -- Step 6
               TRIM(                                           -- Step 5b
                 REGEXP_REPLACE(                               -- Step 5a
                   REGEXP_SUBSTR(                              -- Step 4
                     LTRIM(l.value::STRING),
                     '^import\\s+([A-Za-z0-9_\\.]+)',
                     1, 1, 'e'
                   ),
                   '^import\\s+',
                   ''
                 ),
                 ';'
               ),
               '\\.[^.]+$',
               ''
             ) AS "pure_package"
      FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS sc
      ,      LATERAL FLATTEN(INPUT => SPLIT(sc."content", '\n')) l      -- Step 2
      WHERE  sc."sample_path" ILIKE '%.java'                            -- Step 1
        AND  LTRIM(l.value::STRING) LIKE 'import %'                     -- Step 3
     ) pkg
GROUP BY pkg."pure_package"
ORDER BY "imports_count" DESC
LIMIT 10;
