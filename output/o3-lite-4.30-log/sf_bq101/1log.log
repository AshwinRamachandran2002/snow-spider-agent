--Description: Find the 10 Java packages most often referenced in import
--             statements.  Reasoning steps:
--   1. Restrict to Java source files by filtering rows whose "sample_path" ends with '.java'.
--   2. Split each file’s "content" into individual lines (SPLIT + LATERAL FLATTEN).
--   3. Keep only lines whose left‑trimmed text begins with 'import '.
--   4. Use REGEXP_SUBSTR to capture the fully‑qualified identifier after the keyword.
--   5. Strip the keyword via REGEXP_REPLACE and trim any trailing semicolon via TRIM.
--   6. Remove the final dot‑segment (class name or “*”) with another REGEXP_REPLACE
--      to yield a pure package name.
--   7. Group by package, count occurrences, order by count, and limit to 10.
SELECT
       pkg."pure_package" AS "package",
       COUNT(*)           AS "imports_count"
FROM (
      SELECT REGEXP_REPLACE(                                   -- Step 6
               TRIM(                                           -- Step 5b
                 REGEXP_REPLACE(                               -- Step 5a
                   REGEXP_SUBSTR(                              -- Step 4
                     LTRIM(l.value::STRING),
                     '^import\\s+([A-Za-z0-9_\\.]+)',
                     1, 1, 'e'
                   ),
                   '^import\\s+', ''
                 ),
                 ';'
               ),
               '\\.[^.]+$',
               ''
             ) AS "pure_package"
      FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS sc,
             LATERAL FLATTEN( INPUT => SPLIT(sc."content", '\n') ) l
      WHERE  sc."sample_path" ILIKE '%.java'            -- Step 1
        AND  LTRIM(l.value::STRING) LIKE 'import %'     -- Step 3
     ) pkg
GROUP BY pkg."pure_package"
ORDER BY "imports_count" DESC
LIMIT 10;
