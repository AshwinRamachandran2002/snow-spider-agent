Relevant columns and their potential usage  
• SAMPLE_CONTENTS."content": Java source code to be scanned line‑by‑line for import statements.  
• SAMPLE_CONTENTS."sample_path": file‑system path; filter rows whose path ends in “.java”.  
• SAMPLE_CONTENTS."sample_repo_name": optional, allows grouping or joining back to repository‑level information if desired.  
(Other tables are not strictly required, because every piece of information we need—the file text and its extension—already lives in SAMPLE_CONTENTS.)

Typical filter conditions  
• WHERE "sample_path" ILIKE '%.java' – keeps only Java source files.  
• WHERE REGEXP_LIKE(line, '^\\s*import\\s+[a-zA-Z0-9_\\.]+') – keeps only syntactically valid import lines.  

Below are ten exploratory Snowflake SQL snippets (each limited to 20 rows) that progress from simple inspection to the final, fully‑formed query that yields the ten most frequent imported packages.  
(Replace … with any other projections you want to see.)

```sql
-- 1. Show a few Java files that exist in the SAMPLE_CONTENTS table
SELECT "sample_repo_name",
       "sample_path"
FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE  "sample_path" ILIKE '%.java'
LIMIT  20;
```

```sql
-- 2. Peek at the first 500 characters of one random Java file
SELECT "sample_repo_name",
       "sample_path",
       SUBSTR("content", 1, 500) AS "preview"
FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE  "sample_path" ILIKE '%.java'
LIMIT  20;
```

```sql
-- 3. Split a single file into lines so we can examine how imports look
SELECT  l.value::STRING AS "line"
FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
        LATERAL FLATTEN(input => SPLIT(t."content", '\n')) l
WHERE   t."sample_path" ILIKE '%.java'
LIMIT   20;
```

```sql
-- 4. Keep only lines that look like Java import statements (raw lines)
SELECT  l.value::STRING AS "import_line"
FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
        LATERAL FLATTEN(input => SPLIT(t."content", '\n')) l
WHERE   t."sample_path" ILIKE '%.java'
  AND   REGEXP_LIKE(l.value::STRING, '^\\s*import\\s+[a-zA-Z0-9_\\.]+')
LIMIT   20;
```

```sql
-- 5. Extract the entire package (still including the optional trailing ".*")
SELECT  REGEXP_SUBSTR(l.value::STRING,
                      '^\\s*import\\s+([a-zA-Z0-9_\\.]+(\\.\\*))',
                      1, 1, 'e') AS "raw_pkg"
FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
        LATERAL FLATTEN(input => SPLIT(t."content", '\n')) l
WHERE   t."sample_path" ILIKE '%.java'
  AND   REGEXP_LIKE(l.value::STRING, '^\\s*import\\s+[a-zA-Z0-9_\\.]+')
LIMIT   20;
```

```sql
-- 6. Extract the package without the keyword "import" and without the semicolon
SELECT  TRIM(
          REGEXP_REPLACE(
              REGEXP_SUBSTR(l.value::STRING,
                             '^\\s*import\\s+([a-zA-Z0-9_\\.]+)',
                             1, 1, 'e'),
              '^\\s*import\\s+', ''      -- strip leading "import"
          ),
          ';'                            -- strip trailing ";"
       ) AS "package_name"
FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
        LATERAL FLATTEN(input => SPLIT(t."content", '\n')) l
WHERE   t."sample_path" ILIKE '%.java'
  AND   REGEXP_LIKE(l.value::STRING, '^\\s*import\\s+[a-zA-Z0-9_\\.]+')
LIMIT   20;
```

```sql
-- 7. Remove any class element after the last dot; keep only the package
SELECT  REGEXP_REPLACE(
          TRIM(
            REGEXP_REPLACE(
                REGEXP_SUBSTR(l.value::STRING,
                               '^\\s*import\\s+([a-zA-Z0-9_\\.]+)',
                               1, 1, 'e'),
                '^\\s*import\\s+', ''
            ),
            ';'
          ),
          '\\.[^.]+$',
          ''                                 -- everything after last '.'
       ) AS "pure_package"
FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
        LATERAL FLATTEN(input => SPLIT(t."content", '\n')) l
WHERE   t."sample_path" ILIKE '%.java'
  AND   REGEXP_LIKE(l.value::STRING, '^\\s*import\\s+[a-zA-Z0-9_\\.]+')
LIMIT   20;
```

```sql
-- 8. Count how many times each package appears (no ordering yet)
SELECT  pkg."pure_package",
        COUNT(*) AS "cnt"
FROM   (
        SELECT REGEXP_REPLACE(
                 TRIM(
                   REGEXP_REPLACE(
                       REGEXP_SUBSTR(l.value::STRING,
                                      '^\\s*import\\s+([a-zA-Z0-9_\\.]+)',
                                      1, 1, 'e'),
                       '^\\s*import\\s+', ''
                   ),
                   ';'
                 ),
                 '\\.[^.]+$',
                 ''
               ) AS "pure_package"
        FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
               LATERAL FLATTEN(input => SPLIT(t."content", '\n')) l
        WHERE  t."sample_path" ILIKE '%.java'
          AND  REGEXP_LIKE(l.value::STRING, '^\\s*import\\s+[a-zA-Z0-9_\\.]+')
      ) AS pkg
GROUP  BY pkg."pure_package"
LIMIT  20;
```

```sql
-- 9. Order the counts in descending order to see the most common packages
SELECT  pkg."pure_package",
        COUNT(*) AS "cnt"
FROM   (
        SELECT REGEXP_REPLACE(
                 TRIM(
                   REGEXP_REPLACE(
                       REGEXP_SUBSTR(l.value::STRING,
                                      '^\\s*import\\s+([a-zA-Z0-9_\\.]+)',
                                      1, 1, 'e'),
                       '^\\s*import\\s+', ''
                   ),
                   ';'
                 ),
                 '\\.[^.]+$',
                 ''
               ) AS "pure_package"
        FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
               LATERAL FLATTEN(input => SPLIT(t."content", '\n')) l
        WHERE  t."sample_path" ILIKE '%.java'
          AND  REGEXP_LIKE(l.value::STRING, '^\\s*import\\s+[a-zA-Z0-9_\\.]+')
      ) AS pkg
GROUP  BY pkg."pure_package"
ORDER  BY "cnt" DESC
LIMIT  20;
```

```sql
-- 10. Final query: return the 10 most frequently imported package names
SELECT  pkg."pure_package"              AS "package",
        COUNT(*)                        AS "imports_count"
FROM  (
        SELECT REGEXP_REPLACE(
                 TRIM(
                   REGEXP_REPLACE(
                       REGEXP_SUBSTR(l.value::STRING,
                                      '^\\s*import\\s+([a-zA-Z0-9_\\.]+)',
                                      1, 1, 'e'),
                       '^\\s*import\\s+', ''
                   ),
                   ';'
                 ),
                 '\\.[^.]+$',
                 ''
               ) AS "pure_package"
        FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
               LATERAL FLATTEN(input => SPLIT(t."content", '\n')) l
        WHERE  t."sample_path" ILIKE '%.java'
          AND  REGEXP_LIKE(l.value::STRING, '^\\s*import\\s+[a-zA-Z0-9_\\.]+')
      ) AS pkg
GROUP  BY pkg."pure_package"
ORDER  BY "imports_count" DESC
LIMIT  10;
```

