```sql
--Description: Thinking process –
--  • Focus on Java source files ("sample_path" ends with .java).
--  • Split every file’s text into individual lines (LATERAL FLATTEN + SPLIT).
--  • Keep only lines whose left‑trimmed text starts with the keyword “import”.
--  • From each such line extract what looks like the fully‑qualified class reference.
--  • Strip the final class element (everything after the last dot) to leave just the package.
--  • Group by that package name and count how often it appears,
--    ordering by the frequency so we can later inspect the most common ones.
--  • Show the first 20 rows to confirm the logic works before tightening to a top‑10 list.
SELECT
       pkg."package_name",
       COUNT(*) AS "imports_count"
FROM (
      SELECT
             -- Extract the package portion of the import statement
             REGEXP_REPLACE(                         -- remove the trailing ".ClassName"
                TRIM(
                   REGEXP_REPLACE(                   -- remove leading "import "
                      REGEXP_SUBSTR(
                         LTRIM(l.value::STRING),    -- left‑trimmed line
                         '^import\\s+([a-zA-Z0-9_\\.]+)', 1, 1, 'e'
                      ),
                      '^import\\s+', ''
                   ),
                   ';'                              -- trim an eventual semicolon
                ),
                '\\.[^.]+$',
                ''
             ) AS "package_name"
      FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS sc,
             LATERAL FLATTEN(input => SPLIT(sc."content", '\n')) l
      WHERE  sc."sample_path" ILIKE '%.java'
        AND  REGEXP_LIKE(LTRIM(l.value::STRING), '^import\\s+')
     ) pkg
GROUP BY pkg."package_name"
ORDER BY "imports_count" DESC
LIMIT 20;
```
