```sql
--Description: Identify the 10 most frequently imported Java packages
--  across all sampled repositories.  Method:
--    1. Filter SAMPLE_CONTENTS to Java files ("sample_path" ends with ".java").
--    2. Split each file’s text into lines (SPLIT + LATERAL FLATTEN).
--    3. Keep only lines whose left‑trimmed text starts with 'import '.
--    4. From each such line extract the identifier that follows the keyword,
--       strip the keyword and any trailing semicolon.
--    5. Remove the final dot‑segment (class name or '*') to obtain the pure package.
--    6. Group by package, count occurrences, order by frequency, and return the top 10.
SELECT pkg."pure_package"   AS "package",
       COUNT(*)             AS "imports_count"
FROM (
      SELECT REGEXP_REPLACE(                                  -- step 5
               TRIM(                                          -- remove trailing ';'
                 REGEXP_REPLACE(                              -- strip keyword
                   REGEXP_SUBSTR(                             -- step 4
                     LTRIM(l.value::STRING),                  -- left‑trim line
                     '^import\\s+([A-Za-z0-9_\\.]+)',
                     1, 1, 'e'
                   ),
                   '^import\\s+',
                   ''
                 ),
                 ';'
               ),
               '\\.[^.]+$',
               ''
             ) AS "pure_package"
      FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS sc,
             LATERAL FLATTEN(input => SPLIT(sc."content", '\n')) l
      WHERE  sc."sample_path" ILIKE '%.java'                  -- step 1
        AND  LTRIM(l.value::STRING) LIKE 'import %'           -- step 3
     ) pkg
GROUP BY pkg."pure_package"
ORDER BY "imports_count" DESC
LIMIT 10;
```
