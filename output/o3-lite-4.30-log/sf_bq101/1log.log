--   5. REGEXP_REPLACE removes the keyword, and TRIM removes any trailing semicolon.
--   6. REGEXP_REPLACE removes the final dot‑segment (class name or “*”) to yield
--      the pure package name.
--   7. Group by package, count occurrences, sort by count, and limit to the top 10.
SELECT
       pkg."pure_package" AS "package",
       COUNT(*)           AS "imports_count"
FROM (
      SELECT REGEXP_REPLACE(                                  -- Step 6
               TRIM(                                          -- Step 5b
                 REGEXP_REPLACE(                              -- Step 5a
                   REGEXP_SUBSTR(                             -- Step 4
                     LTRIM(l.value::STRING),                  -- left‑trimmed line
                     '^import\\s+([A-Za-z0-9_\\.]+)',
                     1, 1, 'e'
                   ),
                   '^import\\s+', ''
                 ),
                 ';'
               ),
               '\\.[^.]+$',
               ''
             ) AS "pure_package"
      FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS sc,
             LATERAL FLATTEN(INPUT => SPLIT(sc."content", '\n')) l      -- Step 2
      WHERE  sc."sample_path" ILIKE '%.java'                           -- Step 1
        AND  LTRIM(l.value::STRING) LIKE 'import %'                    -- Step 3
     ) pkg
GROUP BY pkg."pure_package"
ORDER BY "imports_count" DESC
LIMIT 10;
