--Description: Identify the 10 most frequently imported Java packages in the
--             dataset.  Reasoning steps:
--   1. Limit to Java source files by checking that "sample_path" ends with '.java'.
--   2. Split each file’s text into individual lines (SPLIT + LATERAL FLATTEN).
--   3. Keep only lines whose left‑trimmed text starts with the keyword 'import '.
--   4. Extract the identifier following the keyword using REGEXP_SUBSTR.
--   5. Remove the keyword with REGEXP_REPLACE and trim away any trailing semicolon.
--   6. Remove the final dot‑segment (class name or “*”) so only the package remains.
--   7. Group by the resulting package name and count how often each appears.
--   8. Order the counts in descending order and return the top 10.
SELECT
       pkg."pure_package" AS "package",
       COUNT(*)           AS "imports_count"
FROM (
      SELECT REGEXP_REPLACE(                                 -- step 6: drop '.ClassOrStar'
               TRIM(                                         -- step 5b: remove ';'
                 REGEXP_REPLACE(                             -- step 5a: strip keyword
                   REGEXP_SUBSTR(                            -- step 4: capture identifier
                     LTRIM(l.value::STRING),                 -- left‑trimmed line
                     '^import\\s+([A-Za-z0-9_\\.]+)',
                     1, 1, 'e'
                   ),
                   '^import\\s+',
                   ''
                 ),
                 ';'
               ),
               '\\.[^.]+$',
               ''
             ) AS "pure_package"
      FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS sc,
             LATERAL FLATTEN( INPUT => SPLIT(sc."content", '\n') ) l  -- step 2
      WHERE  sc."sample_path" ILIKE '%.java'                          -- step 1
        AND  LTRIM(l.value::STRING) LIKE 'import %'                   -- step 3
     ) pkg
GROUP BY pkg."pure_package"
ORDER BY "imports_count" DESC
LIMIT 10;
