```sql
WITH imports AS (
    SELECT
        /* extract the fully‑qualified symbol and trim the final class/constant to keep only the package */
        REGEXP_REPLACE(
            REGEXP_SUBSTR(
                f.value,
                'import\\s+(?:static\\s+)?([A-Za-z0-9_\\.]+)',
                1, 1, 'e', 1
            ),
            '\\.[^\\.]+$',
            ''
        ) AS package_name
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS c,
         LATERAL SPLIT_TO_TABLE(c."content", '\n') f
    WHERE c."sample_path" ILIKE '%.java'      -- consider only Java files
      AND f.value ILIKE 'import %'            -- keep lines that start with “import”
      AND REGEXP_SUBSTR(
              f.value,
              'import\\s+(?:static\\s+)?([A-Za-z0-9_\\.]+)',
              1, 1, 'e', 1
          ) IS NOT NULL                       -- ensure a match was found
)
SELECT
    package_name,
    COUNT(*) AS total_imports
FROM imports
GROUP BY package_name
ORDER BY total_imports DESC NULLS LAST, package_name
LIMIT 10;
```
