--          ^import\s+             → line begins with “import ”
--          (?:static\s+)?         → optional “static ” (ignored for package capture)
--          ([A-Za-z0-9_\.]+)      → capture group 1 = package (dot‑separated)
--          \.[A-Za-z0-9_*]+       → final segment (class name or *)
--          \s*;?                  → optional whitespace and semicolon
--   6) Aggregate counts per package, order descending, and return the top 10.
WITH java_sources AS (
    SELECT c."content"
    FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" f
    JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
           ON f."id" = c."id"
    WHERE  f."path" ILIKE '%.java'
),
lines AS (
