    WHERE  REGEXP_LIKE(line, '^import\\s+', 'i')               -- starts with import
      AND  NOT REGEXP_LIKE(line, '^import\\s+static\\s+', 'i') -- exclude static imports
),
packages AS (
    SELECT REGEXP_SUBSTR(
               line,
               '^import\\s+(?:static\\s+)?([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_*]+\\s*;?',
               1, 1, 'i', 1   -- capture group 1
           ) AS package
    FROM   import_lines
    WHERE  package IS NOT NULL
)
