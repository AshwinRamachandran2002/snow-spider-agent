Exploratory Snowflake SQL queries
(each returns ≤ 20 rows and every identifier is double‑quoted)

```sql
-- 1. Description: Peek at a couple of records in SAMPLE_FILES to verify general structure.
SELECT *
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
LIMIT 20;
```

```sql
-- 2. Description: List distinct file extensions that occur, just to be sure ".java" exists.
SELECT DISTINCT SPLIT_PART("path", '.', -1) AS "file_extension"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
LIMIT 20;
```

```sql
-- 3. Description: Show 20 random Java files (.java) from SAMPLE_FILES.
SELECT "repo_name", "path", "id"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%.java'
LIMIT 20;
```

```sql
-- 4. Description: Count how many Java source files are present overall.
SELECT COUNT(*) AS "java_file_count"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%.java';
```

```sql
-- 5. Description: Display total Java files per repository (top 20 by volume).
SELECT "repo_name",
       COUNT(*) AS "java_files"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%.java'
GROUP BY "repo_name"
ORDER BY "java_files" DESC
LIMIT 20;
```

```sql
-- 6. Description: Join one Java file with its content so we can inspect how "import" lines look.
SELECT f."path",
       c."content"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"     f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"  c
       ON f."id" = c."id"
WHERE  f."path" ILIKE '%.java'
LIMIT 20;
```

```sql
-- 7. Description: Pull only lines that begin with the Java keyword 'import' from a few files.
SELECT f."path",
       REGEXP_SUBSTR(c."content", '(?mi)(^import\\s+.*$)', 1, 1, 'e') AS "import_line_example"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"     f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"  c
       ON f."id" = c."id"
WHERE  f."path" ILIKE '%.java'
      AND REGEXP_LIKE(c."content", '(?mi)^import\\s+')
LIMIT 20;
```

```sql
-- 8. Description: Return every distinct raw 'import …' line across Java files (sampling 20).
SELECT DISTINCT REGEXP_SUBSTR(c."content", '(?mi)(^import\\s+.*$)', 1, 1, 'e') AS "import_line"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
       ON f."id" = c."id"
WHERE  f."path" ILIKE '%.java'
      AND REGEXP_LIKE(c."content", '(?mi)^import\\s+')
LIMIT 20;
```

```sql
-- 9. Description: Extract just the package portion (drop the trailing class if present) 
--                 from matched import statements (sampling 20 results).
SELECT DISTINCT
       REGEXP_SUBSTR( REGEXP_SUBSTR(c."content",
                                    '(?mi)(^import\\s+.*$)', 1, 1, 'e'),
                      '(?mi)^import\\s+([a-zA-Z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;?', 1, 1, 'e', 1)
       AS "imported_package"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
       ON f."id" = c."id"
WHERE  f."path" ILIKE '%.java'
      AND REGEXP_LIKE(c."content", '(?mi)^import\\s+')
LIMIT 20;
```

```sql
-- 10. Description: Count occurrences of every imported package and
--                  list the top 20 most frequent (proxy for final result).
WITH imports AS (
    SELECT
        REGEXP_SUBSTR( line,
                       '(?mi)^import\\s+([a-zA-Z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;?', 1, 1, 'e', 1) 
        AS "pkg"
    FROM (
        SELECT SPLIT(c."content", '\n') AS "lines"
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" f
        JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
               ON f."id" = c."id"
        WHERE  f."path" ILIKE '%.java'
    ), LATERAL FLATTEN(input => "lines") l
    LET line = l.value::STRING
    WHERE REGEXP_LIKE(line, '(?mi)^import\\s+')
)
SELECT "pkg",
       COUNT(*) AS "occurrences"
FROM   imports
WHERE  "pkg" IS NOT NULL
GROUP  BY "pkg"
ORDER  BY "occurrences" DESC
LIMIT 20;
```
