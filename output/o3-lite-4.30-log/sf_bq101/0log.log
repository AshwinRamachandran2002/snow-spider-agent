```sql
--Description:
-- Earlier queries failed because inline flag syntax (?mi) is unsupported by Snowflake.
-- To reliably obtain a sample of Java import statements we:
--   1) Filter SAMPLE_FILES for paths ending in “.java”.
--   2) Join to SAMPLE_CONTENTS on "id" to read the file text.
--   3) Split each file’s content into individual lines, then FLATTEN so each row is
--      one line (which eliminates the need for multiline regex flags).
--   4) Use REGEXP_LIKE with flag 'i' (case‑insensitive) to keep only lines that start
--      with the keyword `import`.
--   5) SELECT DISTINCT lines and LIMIT 20 for a concise preview.
SELECT DISTINCT
       line AS "import_line"
FROM (
    SELECT l.value::STRING AS line
    FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"     f
    JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"  c
           ON f."id" = c."id",
           LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) l
    WHERE  f."path" ILIKE '%.java'
) t
WHERE  REGEXP_LIKE(line, '^import\\s+', 'i')   -- retain lines beginning with 'import '
LIMIT 20;
```
