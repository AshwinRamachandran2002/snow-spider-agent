--Description: Return 20 distinct raw Java `import` lines without using inline
--             regex flags (which Snowflake rejects).  Strategy:
--             1) Keep only rows from SAMPLE_FILES whose "path" ends in ".java".
--             2) Join to SAMPLE_CONTENTS on "id" for file text.
--             3) SPLIT the text into individual lines and FLATTEN so each row
--                is one line—this removes the need for multiline regex flags.
--             4) Use REGEXP_LIKE with flag 'i' (case‑insensitive) to retain
--                lines that begin with the keyword `import`.
--             5) DISTINCT for unique lines, LIMIT 20 for a sample.
SELECT DISTINCT
       l.value::STRING AS "import_line"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"     f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"  c
       ON f."id" = c."id",
       LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) l
