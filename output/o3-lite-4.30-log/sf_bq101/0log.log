```sql
--Description:
-- Find the 10 most frequently imported Java packages.
-- • Step‑1: keep only *.java files and grab their text (FILES ⟶ CONTENTS join on "id").
-- • Step‑2: split each file into lines with SPLIT + FLATTEN so every row is one line.
-- • Step‑3: filter to lines that begin with the keyword `import`.
-- • Step‑4: from each import line, capture just the package portion that precedes the
--           final class name or “*”.  The pattern uses:
--              ^import\s+(?:static\s+)?      → line starts with `import` (optional `static`)
--              ([A-Za-z0-9_\.]+)             → group‑1 = package (dots allowed)
--              \.[A-Za-z0-9_*]+              → final segment (class or *)
--           Flags: 'i' for case‑insensitive (multiline not needed because each row is a line).
-- • Step‑5: aggregate counts per package, order descending, and keep the top 10.
WITH java_sources AS (
    SELECT f."id", c."content"
    FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" f
    JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
           ON f."id" = c."id"
    WHERE  f."path" ILIKE '%.java'
),
import_lines AS (
    SELECT
        REGEXP_SUBSTR(
            l.value::STRING,
            '^import\\s+(?:static\\s+)?([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_*]+\\s*;?',
            1, 1, 'i', 1
        ) AS "package"
    FROM   java_sources js,
           LATERAL FLATTEN( input => SPLIT(js."content", '\n') ) l
    WHERE  REGEXP_LIKE(l.value::STRING, '^import\\s+', 'i')     -- keep only import lines
)
SELECT "package",
       COUNT(*) AS "import_count"
FROM   import_lines
WHERE  "package" IS NOT NULL
GROUP  BY "package"
ORDER  BY "import_count" DESC
LIMIT 10;
```
