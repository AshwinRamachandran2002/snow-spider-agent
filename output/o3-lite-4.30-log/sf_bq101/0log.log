FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
       ON f."id" = c."id"
WHERE  f."path" ILIKE '%.java'
      AND REGEXP_LIKE(c."content", '(?mi)^import\\s+')
LIMIT 20;
```

```sql
-- 9. Description: Extract just the package portion (drop the trailing class if present) 
--                 from matched import statements (sampling 20 results).
SELECT DISTINCT
       REGEXP_SUBSTR( REGEXP_SUBSTR(c."content",
                                    '(?mi)(^import\\s+.*$)', 1, 1, 'e'),
                      '(?mi)^import\\s+([a-zA-Z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;?', 1, 1, 'e', 1)
       AS "imported_package"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
       ON f."id" = c."id"
WHERE  f."path" ILIKE '%.java'
      AND REGEXP_LIKE(c."content", '(?mi)^import\\s+')
LIMIT 20;
```

```sql
-- 10. Description: Count occurrences of every imported package and
--                  list the top 20 most frequent (proxy for final result).
WITH imports AS (
    SELECT
        REGEXP_SUBSTR( line,
                       '(?mi)^import\\s+([a-zA-Z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;?', 1, 1, 'e', 1) 
        AS "pkg"
    FROM (
        SELECT SPLIT(c."content", '\n') AS "lines"
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" f
        JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
               ON f."id" = c."id"
        WHERE  f."path" ILIKE '%.java'
    ), LATERAL FLATTEN(input => "lines") l
    LET line = l.value::STRING
    WHERE REGEXP_LIKE(line, '(?mi)^import\\s+')
)
SELECT "pkg",
       COUNT(*) AS "occurrences"
FROM   imports
WHERE  "pkg" IS NOT NULL
GROUP  BY "pkg"
ORDER  BY "occurrences" DESC
LIMIT 20;
```
