```sql
--Description (thinking process):
-- We want the 10 most frequently imported *package* names in Java source files.
-- 1.  Filter SAMPLE_FILES for paths ending in ".java" to keep Java sources only.
-- 2.  Join to SAMPLE_CONTENTS (same "id") to obtain each file’s text.
-- 3.  Split every file’s content into separate lines with SPLIT(..., '\n')
--     and FLATTEN so each line becomes its own row.
-- 4.  Keep only lines that begin with `import` (ignoring case and allowing multiline)
--     but exclude the rare `import static` lines because they name classes more often
--     than packages.  (You can include them by removing that condition.)
-- 5.  Use REGEXP_SUBSTR to capture just the package portion **before** the last dot.
--     Pattern explanation:
--       ^import\\s+(?:static\\s+)?        -> line starts with `import` (optional `static`)
--       ([a-zA-Z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+  -> capture package (group‑1) preceding final segment
--       \\s*;?                            -> optional whitespace and semicolon
-- 6.  GROUP BY the extracted package and COUNT how often it appears.
-- 7.  ORDER by that count descending and return the Top‑10.
WITH java_files AS (
    SELECT f."id"
    FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" f
    WHERE  f."path" ILIKE '%.java'
),
lines AS (
    SELECT
        FL.value::STRING AS "line"
    FROM   java_files jf
    JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
           ON jf."id" = c."id",
           LATERAL FLATTEN( input => SPLIT(c."content", '\n') ) FL
),
imports AS (
    SELECT
        REGEXP_SUBSTR(
            "line",
            '^import\\s+(?:static\\s+)?([a-zA-Z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;?',
            1, 1, 'i', 1   -- flags: i = case‑insensitive, subgroup 1 = package
        ) AS "package"
    FROM lines
    WHERE REGEXP_LIKE("line", '^import\\s+', 'i')
      AND NOT REGEXP_LIKE("line", '^import\\s+static\\s+', 'i')  -- exclude static imports
)
SELECT "package",
       COUNT(*) AS "import_count"
FROM   imports
WHERE  "package" IS NOT NULL
GROUP  BY "package"
ORDER  BY "import_count" DESC
LIMIT 10;
```
