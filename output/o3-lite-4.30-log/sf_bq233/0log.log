```sql
--Description:  Count how often a Python module is imported across the sample corpus.                
--Logic                                                                                              
-- 1.  Join SAMPLE_FILES and SAMPLE_CONTENTS on “id”.                                                
-- 2.  Keep only files whose path ends with “.py”.                                                   
-- 3.  Look for either pattern:                                                                     
--        •  import <module>                                                                         
--        •  from <module> import <something>                                                        
-- 4.  Use COALESCE to capture whichever pattern matches first; if both are present, “from …”        
--     wins because it is checked first.                                                             
-- 5.  Aggregate by extracted module name and list the 20 most frequent.                             
-- 6.  We skip a binary‑file filter because many rows have NULL in that flag and text blobs          
--     are still readable.                                                                           
SELECT
       "module",
       COUNT(*) AS "occurrences"
FROM (
        SELECT
               COALESCE(
                   REGEXP_SUBSTR(c."content",
                                 'from[[:space:]]+([A-Za-z0-9_\\.]+)[[:space:]]+import', 1, 1, 'e', 1),
                   REGEXP_SUBSTR(c."content",
                                 'import[[:space:]]+([A-Za-z0-9_]+)',            1, 1, 'e', 1)
               ) AS "module"
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"    AS f
        JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
               ON f."id" = c."id"
        WHERE  LOWER(f."path") LIKE '%.py'
      ) AS sub
WHERE  "module" IS NOT NULL
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```
