```sql
--Description: 10) One‑shot pipeline that counts imported Python modules and R packages (library/require) per file.
--Adjustments: 
--  • Removed the “c.\"binary\" = FALSE” filter to avoid excluding rows with NULL in that flag.  
--  • Expanded the regex for R to capture either library() or require().  
--  • Structured the WHERE clause so each language’s regex is evaluated only on matching file types.
SELECT
       CASE
         WHEN LOWER(f."path") LIKE '%.py' THEN 'Python'
         WHEN LOWER(f."path") LIKE '%.r'  THEN 'R'
       END AS "language",
       COALESCE(
         REGEXP_SUBSTR(c."content",
                       'import[[:space:]]+([A-Za-z0-9_]+)', 1, 1, 'e', 1),
         REGEXP_SUBSTR(c."content",
                       '(?:library|require)[[:space:]]*\\([[:space:]]*([A-Za-z0-9.]+)', 1, 1, 'e', 1)
       ) AS "package",
       COUNT(*) AS "occurrences"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"      AS f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"   AS c
       ON f."id" = c."id"
WHERE  (LOWER(f."path") LIKE '%.py' 
        AND REGEXP_LIKE(c."content", 'import[[:space:]]+[A-Za-z0-9_]+', 'i'))
