         LATERAL SPLIT_TO_TABLE(rf."content", '\n') t
    WHERE REGEXP_SUBSTR(t.value,
                        '\\blibrary\\s*\\(\\s*([A-Za-z0-9\\.]+)',
                        1, 1, 'e', 1) IS NOT NULL
),
modules_union AS (
    SELECT 'Python' AS language, module FROM python_imports
    UNION ALL
    SELECT 'Python', module FROM python_from_imports
    UNION ALL
    SELECT 'R', module FROM r_libraries
)
SELECT language,
       module,
       COUNT(*) AS occurrences
FROM   modules_union
GROUP  BY language, module
ORDER  BY language,
         occurrences DESC NULLS LAST,
         module;
