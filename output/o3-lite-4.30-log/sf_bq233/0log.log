--Description: 4) Join Python files with their full contents (first 20 rows)
SELECT f."repo_name",
       f."path",
       c."size",
       c."content"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  AS f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
       ON f."id" = c."id"
WHERE  LOWER(f."path") LIKE '%.py'
  AND  c."binary" = FALSE
LIMIT 20;
