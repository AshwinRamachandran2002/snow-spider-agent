Query:
--Description: 9) Cross‑check language tags for repositories that contain at least one Python file.
--Instead of a direct join (which could drop repos missing from LANGUAGES), we keep every row in LANGUAGES
--and use EXISTS to test whether the repo has any “.py” file listed in SAMPLE_FILES.
SELECT DISTINCT
       l."repo_name",
       l."language"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" AS l
WHERE  EXISTS (
        SELECT 1
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" AS f
        WHERE  f."repo_name" = l."repo_name"
          AND  LOWER(f."path") LIKE '%.py'
      )
LIMIT 20
Answer:
repo_name,language
