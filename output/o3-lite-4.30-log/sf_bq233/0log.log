SELECT "repo_name",
       "path",
       "id"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE LOWER("path") LIKE '%.py'
LIMIT 20;
```

```sql
--Description: 3) Show only paths that appear to be R files
SELECT "repo_name",
       "path",
       "id"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE LOWER("path") LIKE '%.r'
LIMIT 20;
```

```sql
--Description: 4) Join Python files with their full contents (first 20 rows)
SELECT f."repo_name",
       f."path",
       c."size",
       c."content"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  AS f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
       ON f."id" = c."id"
WHERE  LOWER(f."path") LIKE '%.py'
  AND  c."binary" = FALSE
LIMIT 20;
```

```sql
--Description: 5) Extract lines that contain the keyword 'import' from Python sources (simple LIKE filter)
SELECT f."repo_name",
       f."path",
       c."content"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  AS f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
       ON f."id" = c."id"
WHERE  LOWER(f."path") LIKE '%.py'
  AND  c."binary" = FALSE
  AND  c."content" ILIKE '%import %'
LIMIT 20;
```

```sql
--Description: 6) Extract lines that contain 'library(' in R sources
SELECT f."repo_name",
       f."path",
       c."content"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  AS f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
       ON f."id" = c."id"
WHERE  LOWER(f."path") LIKE '%.r'
  AND  c."binary" = FALSE
  AND  c."content" ILIKE '%library(%'
LIMIT 20;
```

```sql
--Description: 7) Use REGEXP_SUBSTR to pull a simple first imported module name in Python (naïve regex)
SELECT REGEXP_SUBSTR(c."content",
                     'import[[:space:]]+([A-Za-z0-9_]+)',
                     1, 1, 'e', 1)   AS "module",
       COUNT(*)                      AS "occurrences"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  AS f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
       ON f."id" = c."id"
WHERE  LOWER(f."path") LIKE '%.py'
  AND  c."binary" = FALSE
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
--Description: 8) Similar regex for R library calls
SELECT REGEXP_SUBSTR(c."content",
                     'library[[:space:]]*\\([[:space:]]*([A-Za-z0-9.]+)',
                     1, 1, 'e', 1)   AS "library",
       COUNT(*)                      AS "occurrences"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  AS f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
       ON f."id" = c."id"
WHERE  LOWER(f."path") LIKE '%.r'
  AND  c."binary" = FALSE
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
--Description: 9) Cross‑check language tag from LANGUAGES table for repos that have Python files
SELECT DISTINCT l."repo_name",
       l."language"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES" AS l
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" AS f
       ON l."repo_name" = f."repo_name"
WHERE  LOWER(f."path") LIKE '%.py'
LIMIT 20;
```

```sql
--Description: 10) Full pipeline in one shot – count extracted modules/libraries for both languages
SELECT CASE
         WHEN LOWER(f."path") LIKE '%.py' THEN 'Python'
         WHEN LOWER(f."path") LIKE '%.r'  THEN 'R'
       END                           AS "language",
       COALESCE(
         REGEXP_SUBSTR(c."content",
                       'import[[:space:]]+([A-Za-z0-9_]+)', 1, 1, 'e', 1),
         REGEXP_SUBSTR(c."content",
                       'library[[:space:]]*\\([[:space:]]*([A-Za-z0-9.]+)', 1, 1, 'e', 1)
       )                             AS "package",
       COUNT(*)                      AS "occurrences"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  AS f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
       ON f."id" = c."id"
WHERE  (LOWER(f."path") LIKE '%.py' OR LOWER(f."path") LIKE '%.r')
  AND  c."binary" = FALSE
  AND  (
         c."content" ILIKE '%import %'      -- Python heuristic
         OR c."content" ILIKE '%library(%'  -- R heuristic
       )
GROUP BY 1, 2
ORDER BY 1, 3 DESC
LIMIT 20;
```

