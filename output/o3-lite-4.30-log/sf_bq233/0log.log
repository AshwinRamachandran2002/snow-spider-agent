--Description: 5) Extract lines that contain the keyword 'import' from Python sources (simple LIKE filter)
SELECT f."repo_name",
       f."path",
       c."content"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  AS f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
       ON f."id" = c."id"
WHERE  LOWER(f."path") LIKE '%.py'
  AND  c."binary" = FALSE
  AND  c."content" ILIKE '%import %'
LIMIT 20;
