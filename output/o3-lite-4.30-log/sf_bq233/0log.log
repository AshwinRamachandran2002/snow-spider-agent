```sql
--Description: 8) Similar regex for R library calls
SELECT REGEXP_SUBSTR(c."content",
                     'library[[:space:]]*\\([[:space:]]*([A-Za-z0-9.]+)',
                     1, 1, 'e', 1)   AS "library",
       COUNT(*)                      AS "occurrences"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  AS f
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
       ON f."id" = c."id"
WHERE  LOWER(f."path") LIKE '%.r'
  AND  c."binary" = FALSE
