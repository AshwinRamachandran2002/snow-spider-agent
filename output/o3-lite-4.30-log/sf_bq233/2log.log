```sql
--Description: Aggregate (simple heuristic) Python module names and rank
--             them by frequency.  Requires source text, so INNER JOIN is
--             appropriate.
WITH py AS (
  SELECT
    REGEXP_SUBSTR(
        c."content",
        '(^|\\n)[[:space:]]*(import|from)[[:space:]]+([A-Za-z0-9_\\.]+)',
        1, 1, 'e', 3
    ) AS "module"
  FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES        f
  JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS     c
    ON f."id" = c."id"
  WHERE f."path" ILIKE '%.py'
)
SELECT
  "module",
  COUNT(*) AS "occurrences"
FROM py
WHERE "module" IS NOT NULL
GROUP BY "module"
ORDER BY "occurrences" DESC
LIMIT 20;
```

```sql
--Description: Combine Python modules and R libraries into one list with
--             counts.  Both subqueries need source text, so INNER JOIN is
--             used inside each CTE; final result orders by language and
--             descending frequency.
WITH py AS (
  SELECT
    REGEXP_SUBSTR(
        c."content",
        '(^|\\n)[[:space:]]*(import|from)[[:space:]]+([A-Za-z0-9_\\.]+)',
        1, 1, 'e', 3
    ) AS "name"
  FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES        f
  JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS     c
    ON f."id" = c."id"
  WHERE f."path" ILIKE '%.py'
), r AS (
  SELECT
    REGEXP_SUBSTR(
        c."content",
        'library[[:space:]]*\\([[:space:]]*([A-Za-z0-9_\\.]+)',
        1, 1, 'e', 1
    ) AS "name"
  FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES        f
  JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS     c
    ON f."id" = c."id"
  WHERE f."path" ILIKE '%.r'
)
SELECT 'Python' AS "language", "name", COUNT(*) AS "occurrences"
FROM py
WHERE "name" IS NOT NULL
GROUP BY "name"
UNION ALL
SELECT 'R'      AS "language", "name", COUNT(*) AS "occurrences"
FROM r
WHERE "name" IS NOT NULL
GROUP BY "name"
ORDER BY "language", "occurrences" DESC
LIMIT 20;
```
