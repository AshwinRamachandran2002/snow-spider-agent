2025-05-01 00:57:22 - Thread-141 (execute) - INFO - [Exploration]
Relevant tables / columns and their potential usages

1. GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES  
   • "repo_name": repository identifier – join key and for reporting.  
   • "path": full file path – filter files that end with '.py' or '.r'.  
   • "id": blob / tree‑object SHA – join key to the real source in SAMPLE_CONTENTS.  
   • "ref": branch / tag – optional filter or reporting.  

2. GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  
   • "id": blob SHA – join to SAMPLE_FILES."id".  
   • "content": complete file body – scan for “import …”, “from … import …”, or “library(…)”.  
   • "sample_repo_name", "sample_path", "sample_ref": redundant but may help debugging.  

Typical join condition   
ON  f."id" = c."id"   

Typical file filters  
WHERE f."path" ILIKE '%.py'     -- Python source files  
   OR f."path" ILIKE '%.r'      -- R source files  

--------------------------------------------------------------------
Ten exploratory Snowflake SQL queries (each limited to 20 rows)

```sql
-- 1. List a handful of Python files that are present in the sample
--    file catalogue.
SELECT
  f."repo_name",
  f."path"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES f
WHERE f."path" ILIKE '%.py'
LIMIT 20;
```

```sql
-- 2. List a handful of R files that are present in the sample
SELECT
  f."repo_name",
  f."path"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES f
WHERE f."path" ILIKE '%.r'
LIMIT 20;
```

```sql
-- 3. Bring back the raw source text for a few Python files by
--    joining with SAMPLE_CONTENTS through the shared blob "id".
SELECT
  f."repo_name",
  f."path",
  c."content"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
  ON f."id" = c."id"
WHERE f."path" ILIKE '%.py'
LIMIT 20;
```

```sql
-- 4. Same join but for R files, to inspect their contents.
SELECT
  f."repo_name",
  f."path",
  c."content"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
  ON f."id" = c."id"
WHERE f."path" ILIKE '%.r'
LIMIT 20;
```

```sql
-- 5. Preview Python files that actually contain the word 'import'.
SELECT
  f."repo_name",
  f."path"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
  ON f."id" = c."id"
WHERE f."path" ILIKE '%.py'
  AND c."content" ILIKE '%import %'
LIMIT 20;
```

```sql
-- 6. Extract (one) first module that appears after the word 'import'
--    or after 'from ' … ' import' in Python source, for a quick look.
SELECT
  f."repo_name",
  f."path",
  REGEXP_SUBSTR(c."content",
                '(^|\\n)[[:space:]]*(import|from)[[:space:]]+([A-Za-z0-9_\\.]+)',
                1, 1, 'e', 3)          AS "module_guess"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
  ON f."id" = c."id"
WHERE f."path" ILIKE '%.py'
LIMIT 20;
```

```sql
-- 7. Extract (one) first package appearing in library(<pkg>) for R.
SELECT
  f."repo_name",
  f."path",
  REGEXP_SUBSTR(c."content",
                'library[[:space:]]*\\([[:space:]]*([A-Za-z0-9_\\.]+)',
                1, 1, 'e', 1)          AS "r_library_guess"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
  ON f."id" = c."id"
WHERE f."path" ILIKE '%.r'
LIMIT 20;
```

```sql
-- 8. Count how many Python files mention at least one import line.
SELECT
  COUNT(*) AS "python_files_with_import"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
  ON f."id" = c."id"
WHERE f."path" ILIKE '%.py'
  AND c."content" ILIKE '%import %';
```

```sql
-- 9. Aggregate Python module names (simple heuristic) and rank them.
WITH py AS (
  SELECT
    REGEXP_SUBSTR(c."content",
                  '(^|\\n)[[:space:]]*(import|from)[[:space:]]+([A-Za-z0-9_\\.]+)',
                  1, 1, 'e', 3) AS "module"
  FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
  JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
    ON f."id" = c."id"
  WHERE f."path" ILIKE '%.py'
)
SELECT
  "module",
  COUNT(*) AS "occurrences"
FROM py
WHERE "module" IS NOT NULL
GROUP BY "module"
ORDER BY "occurrences" DESC
LIMIT 20;
```

```sql
-- 10. Combine Python modules and R libraries into a single view that
--     labels the language, aggregates counts, and orders descending.
WITH py AS (
  SELECT
    REGEXP_SUBSTR(c."content",
                  '(^|\\n)[[:space:]]*(import|from)[[:space:]]+([A-Za-z0-9_\\.]+)',
                  1, 1, 'e', 3) AS "name"
  FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
  JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
    ON f."id" = c."id"
  WHERE f."path" ILIKE '%.py'
), r AS (
  SELECT
    REGEXP_SUBSTR(c."content",
                  'library[[:space:]]*\\([[:space:]]*([A-Za-z0-9_\\.]+)',
                  1, 1, 'e', 1) AS "name"
  FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
  JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
    ON f."id" = c."id"
  WHERE f."path" ILIKE '%.r'
)
SELECT 'Python' AS "language", "name", COUNT(*) AS "occurrences"
FROM py
WHERE "name" IS NOT NULL
GROUP BY "name"
UNION ALL
SELECT 'R'      AS "language", "name", COUNT(*) AS "occurrences"
FROM r
WHERE "name" IS NOT NULL
GROUP BY "name"
ORDER BY "language", "occurrences" DESC
LIMIT 20;
```

These queries progress from simple exploration to a combined aggregation that matches the requested final analysis, while always enclosing column names in double quotes and limiting results to 20 rows for safety.
