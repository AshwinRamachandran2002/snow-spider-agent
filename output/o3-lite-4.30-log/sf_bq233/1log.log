Query:
--Description: #10  Final aggregation: produce full list of packages across Python & R,
--             grouped by language, ordered by occurrence count (descending within language),
--             limited to 20 rows for display.
SELECT *
FROM (
      /* Python packages */
      SELECT 'python' AS "language",
             LOWER(mod_name) AS "package",
             COUNT(*)       AS "occurrences"
      FROM (
              SELECT REGEXP_SUBSTR(l.value,
                                   '^\\s*import\\s+([A-Za-z0-9_]+)',
                                   1, 1, 'e', 1) AS mod_name
              FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS",
                     LATERAL SPLIT_TO_TABLE("content", '\n') AS l
              WHERE  "sample_path" ILIKE '%.py'
              UNION ALL
              SELECT REGEXP_SUBSTR(l.value,
                                   '^\\s*from\\s+([A-Za-z0-9_\\.]+)',
                                   1, 1, 'e', 1)
              FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS",
                     LATERAL SPLIT_TO_TABLE("content", '\n') AS l
              WHERE  "sample_path" ILIKE '%.py'
           ) p(mod_name)
      WHERE mod_name IS NOT NULL
      GROUP BY 1,2

      UNION ALL

      /* R packages */
      SELECT 'r' AS "language",
             LOWER(lib_name) AS "package",
             COUNT(*)       AS "occurrences"
      FROM (
              SELECT REGEXP_SUBSTR(l.value,
                                   '\\b(library|require)\\s*\\(\\s*([A-Za-z0-9\\.]+)',
                                   1, 1, 'e', 2) AS lib_name
              FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS",
                     LATERAL SPLIT_TO_TABLE("content", '\n') AS l
              WHERE  "sample_path" ILIKE '%.r'
           ) r(lib_name)
      WHERE lib_name IS NOT NULL
      GROUP BY 1,2
     ) all_pkgs
ORDER BY "language", "occurrences" DESC
LIMIT 20
