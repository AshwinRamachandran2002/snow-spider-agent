Relevant columns and potential usages
• "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  
  – "repo_name": repository key to join with contents  
  – "path": to keep only files that end in “.py” or “.r”  
  – "id": blob/object id to join with contents  

• "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"  
  – "sample_repo_name": repository key to join with SAMPLE_FILES."repo_name"  
  – "sample_path": file path to join with SAMPLE_FILES."path" (if desired)  
  – "id": alternative join key (same blob/object id)  
  – "content": holds full source; scan for  
        · Python:  lines starting with “import ” or “from … import …”  
        · R:       lines containing “library(…)” or “require(…)”  

Conditions that will usually be applied in later queries  
• "path" ILIKE '%.py'  OR "path" ILIKE '%.r'  
• optional join on "SAMPLE_FILES"."id" = "SAMPLE_CONTENTS"."id"  
• REGEXP to pull module/library names  

Below are ten exploratory Snowflake SQL queries (each limited to 20 rows) growing from very simple to the complete aggregation.  
All identifiers are double‑quoted, and comments precede each statement.

```sql
-- 1. List a few file paths that look like Python or R source files
SELECT "repo_name",
       "path"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE  "path" ILIKE '%.py' OR "path" ILIKE '%.r'
LIMIT  20;
```

```sql
-- 2. Inspect corresponding blobs from SAMPLE_CONTENTS for those paths
SELECT  f."repo_name",
        f."path",
        c."size",
        c."binary"
FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"    f
JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
       ON f."id" = c."id"
WHERE   f."path" ILIKE '%.py' OR f."path" ILIKE '%.r'
LIMIT   20;
```

```sql
-- 3. Pull just the first 200 characters of content for a visual sanity check
SELECT  c."sample_repo_name",
        c."sample_path",
        LEFT(c."content", 200) AS "snippet"
FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
WHERE   c."sample_path" ILIKE '%.py' OR c."sample_path" ILIKE '%.r'
LIMIT   20;
```

```sql
-- 4. Extract Python “import xxx” single‑word modules
SELECT  REGEXP_SUBSTR(line, '^\\s*import\\s+([A-Za-z0-9_]+)', 1, 1, 'e', 1) AS "python_module"
FROM    (
          SELECT SPLIT_TO_TABLE(c."content", '\n') AS line
          FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
          WHERE  c."sample_path" ILIKE '%.py'
          LIMIT  20
        )
WHERE   "python_module" IS NOT NULL
LIMIT   20;
```

```sql
-- 5. Extract Python “from aaa import …” root package names
SELECT  REGEXP_SUBSTR(line, '^\\s*from\\s+([A-Za-z0-9_\\.]+)', 1, 1, 'e', 1)  AS "python_module"
FROM    (
          SELECT SPLIT_TO_TABLE(c."content", '\n') AS line
          FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
          WHERE  c."sample_path" ILIKE '%.py'
          LIMIT  20
        )
WHERE   "python_module" IS NOT NULL
LIMIT   20;
```

```sql
-- 6. Extract R “library(…)” or “require(…)” calls
SELECT  REGEXP_SUBSTR(line, '\\b(library|require)\\s*\\(\\s*([A-Za-z0-9\\.]+)', 1, 1, 'e', 2) AS "r_library"
FROM    (
          SELECT SPLIT_TO_TABLE(c."content", '\n') AS line
          FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
          WHERE  c."sample_path" ILIKE '%.r'
          LIMIT  20
        )
WHERE   "r_library" IS NOT NULL
LIMIT   20;
```

```sql
-- 7. Count occurrences of every Python import (both syntaxes combined)
SELECT  LOWER(mod_name)                           AS "python_module",
        COUNT(*)                                  AS "occurrences"
FROM   (
        /* harvest “import aaa” */
        SELECT REGEXP_SUBSTR(line, '^\\s*import\\s+([A-Za-z0-9_]+)',1,1,'e',1) AS mod_name
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS", LATERAL SPLIT_TO_TABLE("content", '\n') AS line
        WHERE  "sample_path" ILIKE '%.py'
        UNION ALL
        /* harvest “from aaa import …” */
        SELECT REGEXP_SUBSTR(line, '^\\s*from\\s+([A-Za-z0-9_\\.]+)',1,1,'e',1) AS mod_name
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS", LATERAL SPLIT_TO_TABLE("content", '\n') AS line
        WHERE  "sample_path" ILIKE '%.py'
      ) t
WHERE  mod_name IS NOT NULL
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 8. Count occurrences of every R library / require call
SELECT  LOWER(lib_name)           AS "r_library",
        COUNT(*)                  AS "occurrences"
FROM   (
        SELECT REGEXP_SUBSTR(line, '\\b(library|require)\\s*\\(\\s*([A-Za-z0-9\\.]+)',1,1,'e',2) AS lib_name
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS", LATERAL SPLIT_TO_TABLE("content", '\n') AS line
        WHERE  "sample_path" ILIKE '%.r'
      ) t
WHERE  lib_name IS NOT NULL
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 9. Union Python & R counts and tag each row with language flag
SELECT 'python' AS "language",
       LOWER(mod_name) AS "package",
       COUNT(*)        AS "occurrences"
FROM  (
        SELECT REGEXP_SUBSTR(line, '^\\s*import\\s+([A-Za-z0-9_]+)',1,1,'e',1) AS mod_name
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS", LATERAL SPLIT_TO_TABLE("content", '\n') AS line
        WHERE  "sample_path" ILIKE '%.py'
        UNION ALL
        SELECT REGEXP_SUBSTR(line, '^\\s*from\\s+([A-Za-z0-9_\\.]+)',1,1,'e',1)
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS", LATERAL SPLIT_TO_TABLE("content", '\n') AS line
        WHERE  "sample_path" ILIKE '%.py'
     ) p(mod_name)
WHERE mod_name IS NOT NULL
GROUP BY 1,2
UNION ALL
SELECT 'r' AS "language",
       LOWER(lib_name) AS "package",
       COUNT(*)        AS "occurrences"
FROM (
        SELECT REGEXP_SUBSTR(line, '\\b(library|require)\\s*\\(\\s*([A-Za-z0-9\\.]+)',1,1,'e',2) AS lib_name
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS", LATERAL SPLIT_TO_TABLE("content", '\n') AS line
        WHERE  "sample_path" ILIKE '%.r'
     ) r(lib_name)
WHERE lib_name IS NOT NULL
GROUP BY 1,2
LIMIT 20;
```

```sql
-- 10. Final aggregated result sorted by language then descending occurrence
SELECT  *
FROM    (
          /* wrap the union query from #9 into a single derived table */
          SELECT 'python' AS "language",
                 LOWER(mod_name) AS "package",
                 COUNT(*)        AS "occurrences"
          FROM  (
                  SELECT REGEXP_SUBSTR(line, '^\\s*import\\s+([A-Za-z0-9_]+)',1,1,'e',1) AS mod_name
                  FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS", LATERAL SPLIT_TO_TABLE("content", '\n') AS line
                  WHERE  "sample_path" ILIKE '%.py'
                  UNION ALL
                  SELECT REGEXP_SUBSTR(line, '^\\s*from\\s+([A-Za-z0-9_\\.]+)',1,1,'e',1)
                  FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS", LATERAL SPLIT_TO_TABLE("content", '\n') AS line
                  WHERE  "sample_path" ILIKE '%.py'
               ) p(mod_name)
          WHERE  mod_name IS NOT NULL
          GROUP BY 1,2

          UNION ALL

          SELECT 'r' AS "language",
                 LOWER(lib_name) AS "package",
                 COUNT(*)        AS "occurrences"
          FROM   (
                  SELECT REGEXP_SUBSTR(line, '\\b(library|require)\\s*\\(\\s*([A-Za-z0-9\\.]+)',1,1,'e',2) AS lib_name
                  FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS", LATERAL SPLIT_TO_TABLE("content", '\n') AS line
                  WHERE  "sample_path" ILIKE '%.r'
               ) r(lib_name)
          WHERE  lib_name IS NOT NULL
          GROUP BY 1,2
        ) all_pkgs
ORDER BY "language", "occurrences" DESC
LIMIT 20;
```

These ten statements incrementally explore relevant columns, join sources, extract import/library calls, and finally aggregate counts by language. Each query is limited to 20 rows for safety.
