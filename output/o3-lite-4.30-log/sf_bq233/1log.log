--Description: #7  Count occurrences of every Python module imported via either “import …”
--             or “from … import …” across all .py files; explode each file into lines,
--             harvest module names, group, and order by frequency.
SELECT  LOWER(mod_name)            AS "python_module",
        COUNT(*)                   AS "occurrences"
FROM  (
        /* pattern: import aaa */
        SELECT REGEXP_SUBSTR(l.value,
                             '^\\s*import\\s+([A-Za-z0-9_]+)',
                             1, 1, 'e', 1) AS mod_name
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS", 
               LATERAL SPLIT_TO_TABLE("content", '\n') AS l
        WHERE  "sample_path" ILIKE '%.py'
        UNION ALL
        /* pattern: from aaa import … */
        SELECT REGEXP_SUBSTR(l.value,
                             '^\\s*from\\s+([A-Za-z0-9_\\.]+)',
                             1, 1, 'e', 1)
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS", 
               LATERAL SPLIT_TO_TABLE("content", '\n') AS l
        WHERE  "sample_path" ILIKE '%.py'
      ) t
WHERE  mod_name IS NOT NULL
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20
