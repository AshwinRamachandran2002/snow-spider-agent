--Description / Thinking process:
-- We want to list Python modules referenced by simple lines of the form “import <module>”.
-- 1) Work on SAMPLE_CONTENTS restricted to files whose path ends in .py.
-- 2) Snowflake’s SPLIT_TO_TABLE text‑splitting function turns one file’s content
--    into multiple rows (one per line); we join it LATERALLY so it can see each row’s content.
-- 3) For every resulting line we apply REGEXP_SUBSTR with the pattern:
--       ^\s*import\s+([A-Za-z0-9_]+)
--    This captures the module name as the first capture group.
-- 4) Keep only matches (non‑NULL).
-- 5) Return up to 20 module names for quick verification.
SELECT
       REGEXP_SUBSTR(lines.value,
                     '^\\s*import\\s+([A-Za-z0-9_]+)',
                     1, 1, 'e', 1) AS "python_module"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS sc
     , LATERAL SPLIT_TO_TABLE(sc."content", '\n')      AS lines
WHERE  sc."sample_path" ILIKE '%.py'
  AND  REGEXP_SUBSTR(lines.value,
                     '^\\s*import\\s+([A-Za-z0-9_]+)',
                     1, 1, 'e', 1) IS NOT NULL
LIMIT 20;
