```sql
WITH lines AS (
    SELECT
        c."sample_path"  AS "path",
        SPLIT_TO_TABLE(c."content", '\n') AS "line"
    FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
),

/* ----------- Python: collect modules from ‘import …’ and ‘from … import …’ ----------- */
python_modules AS (
    /* pattern: import <module> */
    SELECT LOWER(REGEXP_SUBSTR(l.value,
                               '^\\s*import\\s+([A-Za-z0-9_]+)',
                               1, 1, 'e', 1)) AS "module"
    FROM lines l
    WHERE l."path" ILIKE '%.py'
      AND REGEXP_SUBSTR(l.value,
                        '^\\s*import\\s+([A-Za-z0-9_]+)',
                        1, 1, 'e', 1) IS NOT NULL

    UNION ALL

    /* pattern: from <module> import … */
    SELECT LOWER(REGEXP_SUBSTR(l.value,
                               '^\\s*from\\s+([A-Za-z0-9_\\.]+)',
                               1, 1, 'e', 1)) AS "module"
    FROM lines l
    WHERE l."path" ILIKE '%.py'
      AND REGEXP_SUBSTR(l.value,
                        '^\\s*from\\s+([A-Za-z0-9_\\.]+)',
                        1, 1, 'e', 1) IS NOT NULL
),

/* --------------------------- R: collect library calls --------------------------- */
r_modules AS (
    SELECT LOWER(REGEXP_SUBSTR(l.value,
                               '\\b(library|require)\\s*\\(\\s*([A-Za-z0-9\\.]+)',
                               1, 1, 'e', 2)) AS "module"
    FROM lines l
    WHERE l."path" ILIKE '%.r'
      AND REGEXP_SUBSTR(l.value,
                        '\\b(library|require)\\s*\\(\\s*([A-Za-z0-9\\.]+)',
                        1, 1, 'e', 2) IS NOT NULL
),

/* ---------------------------- Aggregate counts by language ---------------------------- */
aggregated AS (
    SELECT 'python' AS "language", "module", COUNT(*) AS "occurrences"
    FROM python_modules
    GROUP BY "module"

    UNION ALL

    SELECT 'r'      AS "language", "module", COUNT(*) AS "occurrences"
    FROM r_modules
    GROUP BY "module"
)

/* ----------------------------- Final ordered result ----------------------------- */
SELECT
    "language",
    "module",
    "occurrences"
FROM aggregated
ORDER BY
    "language",
    "occurrences" DESC NULLS LAST,
    "module";
```
