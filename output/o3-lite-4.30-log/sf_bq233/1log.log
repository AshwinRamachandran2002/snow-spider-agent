      LATERAL TABLE(SPLIT_TO_TABLE(src."content", '\n')) AS line
WHERE REGEXP_SUBSTR(line.value,
                    '^\\s*import\\s+([A-Za-z0-9_]+)',
                    1, 1, 'e', 1) IS NOT NULL
LIMIT 20;
