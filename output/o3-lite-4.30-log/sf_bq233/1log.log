```sql
--Description: #7  Count occurrences of every Python module imported via either “import …”
--             or “from … import …” across all .py files; explode each file into lines,
--             harvest module names, group, and order by frequency.
SELECT  LOWER(mod_name)            AS "python_module",
        COUNT(*)                   AS "occurrences"
FROM  (
        /* pattern: import aaa */
        SELECT REGEXP_SUBSTR(l.value,
                             '^\\s*import\\s+([A-Za-z0-9_]+)',
                             1, 1, 'e', 1) AS mod_name
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS", 
               LATERAL SPLIT_TO_TABLE("content", '\n') AS l
        WHERE  "sample_path" ILIKE '%.py'
        UNION ALL
        /* pattern: from aaa import … */
        SELECT REGEXP_SUBSTR(l.value,
                             '^\\s*from\\s+([A-Za-z0-9_\\.]+)',
                             1, 1, 'e', 1)
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS", 
               LATERAL SPLIT_TO_TABLE("content", '\n') AS l
        WHERE  "sample_path" ILIKE '%.py'
      ) t
WHERE  mod_name IS NOT NULL
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
--Description: #8  Count occurrences of every R package referenced by library()/require() in
--             all .r files; explode content into lines, capture package names, aggregate.
SELECT  LOWER(lib_name)            AS "r_library",
        COUNT(*)                   AS "occurrences"
FROM  (
        SELECT REGEXP_SUBSTR(l.value,
                             '\\b(library|require)\\s*\\(\\s*([A-Za-z0-9\\.]+)',
                             1, 1, 'e', 2) AS lib_name
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS", 
               LATERAL SPLIT_TO_TABLE("content", '\n') AS l
        WHERE  "sample_path" ILIKE '%.r'
      ) t
WHERE  lib_name IS NOT NULL
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
--Description: #9  Combine Python and R package counts, tagging each row with language;
--             for Python combine both import syntaxes, for R use library()/require();
--             present up to 20 rows of the union.
SELECT 'python'                    AS "language",
       LOWER(mod_name)             AS "package",
       COUNT(*)                    AS "occurrences"
FROM (
        SELECT REGEXP_SUBSTR(l.value,
                             '^\\s*import\\s+([A-Za-z0-9_]+)',
                             1, 1, 'e', 1) AS mod_name
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS",
               LATERAL SPLIT_TO_TABLE("content", '\n') AS l
        WHERE  "sample_path" ILIKE '%.py'
        UNION ALL
        SELECT REGEXP_SUBSTR(l.value,
                             '^\\s*from\\s+([A-Za-z0-9_\\.]+)',
                             1, 1, 'e', 1)
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS",
               LATERAL SPLIT_TO_TABLE("content", '\n') AS l
        WHERE  "sample_path" ILIKE '%.py'
     ) p(mod_name)
WHERE mod_name IS NOT NULL
GROUP BY 1,2
UNION ALL
SELECT 'r'                         AS "language",
       LOWER(lib_name)             AS "package",
       COUNT(*)                    AS "occurrences"
FROM (
        SELECT REGEXP_SUBSTR(l.value,
                             '\\b(library|require)\\s*\\(\\s*([A-Za-z0-9\\.]+)',
                             1, 1, 'e', 2) AS lib_name
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS",
               LATERAL SPLIT_TO_TABLE("content", '\n') AS l
        WHERE  "sample_path" ILIKE '%.r'
     ) r(lib_name)
WHERE lib_name IS NOT NULL
GROUP BY 1,2
LIMIT 20;
