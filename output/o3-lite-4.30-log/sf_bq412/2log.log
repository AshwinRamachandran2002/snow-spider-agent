     LATERAL FLATTEN (input => t."region_stats") rs
WHERE rs.value:"region_code" = 'HR'
LIMIT 20;
```

```sql
-- 6. Description: Croatia rows where impression counts are between 10k and 25k
SELECT 
    t."creative_page_url",
    rs.value:"times_shown_lower_bound"::NUMBER AS "lower_bnd",
    rs.value:"times_shown_upper_bound"::NUMBER AS "upper_bnd"
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."REMOVED_CREATIVE_STATS" t,
     LATERAL FLATTEN (input => t."region_stats") rs
WHERE rs.value:"region_code"              = 'HR'
  AND rs.value:"times_shown_lower_bound"::NUMBER > 10000
  AND rs.value:"times_shown_upper_bound"::NUMBER < 25000
LIMIT 20;
```

```sql
