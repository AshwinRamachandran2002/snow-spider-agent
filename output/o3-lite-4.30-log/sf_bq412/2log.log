```

```sql
-- 9. Description: Filter rows that use at least one non‑unused audience approach
SELECT 
    "creative_page_url",
    "audience_selection_approach_info":"demographic_info"::STRING      AS "demographic_info",
    "audience_selection_approach_info":"geo_location"::STRING          AS "geo_location",
    "audience_selection_approach_info":"contextual_signals"::STRING    AS "contextual_signals",
    "audience_selection_approach_info":"customer_lists"::STRING        AS "customer_lists",
    "audience_selection_approach_info":"topics_of_interest"::STRING    AS "topics_of_interest"
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."REMOVED_CREATIVE_STATS"
WHERE (
       "audience_selection_approach_info":"demographic_info"     <> 'CRITERIA_NOT_USED'
    OR "audience_selection_approach_info":"geo_location"         <> 'CRITERIA_NOT_USED'
    OR "audience_selection_approach_info":"contextual_signals"   <> 'CRITERIA_NOT_USED'
