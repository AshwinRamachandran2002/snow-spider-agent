```sql
/*  Thinking process (inline comments)
    ------------------------------------------------------------
    1.  We must work only with the table GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.REMOVED_CREATIVE_STATS.
    2.  “region_stats” is an array of JSON objects → flatten it to pick the rows whose region_code = 'HR'.
    3.  Apply numeric / NULL filters:
          • times_shown_availability_date IS NULL
          • times_shown_lower_bound  > 10 000
          • times_shown_upper_bound  < 25 000
    4.  “audience_selection_approach_info” is a JSON object.  
        To confirm that at least one audience dimension (demographic_info, geo_location,
        contextual_signals, customer_lists, or topics_of_interest) is **used**, flatten the
        object and look for any value not containing “UNUSED”.
    5.  The “disapproval” field is a JSON array → flatten it to get removal_reason &
        violation_category (outer => TRUE keeps rows even if the array is empty).
    6.  Order the qualifying ads by last_shown DESC and keep only the five most recent.
*/
WITH croatia AS (
    SELECT
        t."creative_page_url",
        rs.value:"first_shown"::DATE                 AS first_shown,
        rs.value:"last_shown"::DATE                  AS last_shown,
        rs.value:"times_shown_lower_bound"::INTEGER  AS lower_bound,
        rs.value:"times_shown_upper_bound"::INTEGER  AS upper_bound,
        rs.value:"times_shown_availability_date"     AS availability_date,
        t."audience_selection_approach_info"         AS aud_info,
        t."disapproval"                              AS disapproval_json
    FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."REMOVED_CREATIVE_STATS" t,
         LATERAL FLATTEN(input => t."region_stats") rs                          -- explode region_stats
    WHERE rs.value:"region_code"::STRING = 'HR'                                 -- Croatia
      AND rs.value:"times_shown_availability_date" IS NULL                      -- availability date still unknown
      AND rs.value:"times_shown_lower_bound"::INTEGER > 10000                   -- lower bound > 10k
      AND rs.value:"times_shown_upper_bound"::INTEGER < 25000                   -- upper bound < 25k
      -- Verify at least one real audience signal is used
      AND EXISTS (
            SELECT 1
            FROM LATERAL FLATTEN(input => t."audience_selection_approach_info") aud
            WHERE aud.key IN ('demographic_info','geo_location',
                              'contextual_signals','customer_lists','topics_of_interest')
              AND aud.value::STRING NOT ILIKE '%UNUSED%'
          )
)
SELECT
       c."creative_page_url"                                                       AS page_url,
       c.first_shown,
       c.last_shown,
       d.value:"removal_reason"::STRING                                            AS removal_reason,
       d.value:"violation_category"::STRING                                        AS violation_category,
       c.lower_bound                                                               AS times_shown_lower_bound,
       c.upper_bound                                                               AS times_shown_upper_bound
FROM croatia c
     LATERAL FLATTEN(input => c.disapproval_json, outer => TRUE) d                -- explode disapproval
ORDER BY c.last_shown DESC
LIMIT 5;
```
