```sql
--Description: Produce the 5 most‑recently removed ads that ran in Croatia and satisfy
--             all requested transparency‑center constraints.  The logic is expressed
--             directly in one statement; inline comments explain each step.
SELECT
       t."creative_page_url"                                                AS page_url,
       rs.value:"first_shown"::DATE                                         AS first_shown,
       rs.value:"last_shown"::DATE                                          AS last_shown,
       dp.value:"removal_reason"::STRING                                    AS removal_reason,
       dp.value:"violation_category"::STRING                                AS violation_category,
       rs.value:"times_shown_lower_bound"::INTEGER                          AS times_shown_lower_bound,
       rs.value:"times_shown_upper_bound"::INTEGER                          AS times_shown_upper_bound
FROM   "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."REMOVED_CREATIVE_STATS" t
       /* 1.  explode region‑level statistics                                          */
       ,LATERAL FLATTEN(input => t."region_stats")                    rs
       /* 2.  explode audience‑selection object to test each key/value pair            */
       ,LATERAL FLATTEN(input => t."audience_selection_approach_info") aud
       /* 3.  explode disapproval array to retrieve removal details (outer keeps null) */
       ,LATERAL FLATTEN(input => t."disapproval", outer => TRUE)      dp
WHERE  rs.value:"region_code"::STRING = 'HR'                                 -- Croatia
  AND  rs.value:"times_shown_availability_date" IS NULL                      -- times‑shown data not yet public
  AND  rs.value:"times_shown_lower_bound"::INTEGER > 10000                   -- lower bound > 10 000
  AND  rs.value:"times_shown_upper_bound"::INTEGER < 25000                   -- upper bound < 25 000
  AND  aud.key IN ('demographic_info','geo_location',
                   'contextual_signals','customer_lists','topics_of_interest')-- relevant audience dimensions
  AND  aud.value::STRING NOT ILIKE '%UNUSED%'                                -- dimension actually used
/* 4. Keep only one record per creative (the most‑recent “last_shown”) before final ordering */
QUALIFY ROW_NUMBER() OVER (PARTITION BY t."creative_page_url"
                           ORDER BY rs.value:"last_shown"::DATE DESC) = 1
ORDER BY last_shown DESC
LIMIT 5;
```
