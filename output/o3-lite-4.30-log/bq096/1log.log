Ten exploratory SQL queries  
(Replace … with your own project if you copied the public dataset to a private
location.  All queries use the original public table in its public project.)

```sql
-- 1. Quick peek at 20 raw rows for the species
--    Check what the important columns look like.
SELECT 
  gbifid,
  scientificname,
  species,
  decimallatitude,
  decimallongitude,
  year,
  month,
  day
FROM `bigquery-public-data.gbif.occurrences`
WHERE LOWER(scientificname) LIKE '%sterna paradisaea%'
LIMIT 20;
```

```sql
-- 2. Distinct years in which the species was reported (anywhere in the world)
SELECT DISTINCT year
FROM `bigquery-public-data.gbif.occurrences`
WHERE species = 'Sterna paradisaea'
  AND year IS NOT NULL
ORDER BY year
LIMIT 20;
```

```sql
-- 3. Distinct years with the species north of 40° lat and after January
SELECT DISTINCT year
FROM `bigquery-public-data.gbif.occurrences`
WHERE species = 'Sterna paradisaea'
  AND decimallatitude > 40
  AND month > 1
ORDER BY year
LIMIT 20;
```

```sql
-- 4. For one example year (e.g. 2015), list how many sightings per day north of 40°
SELECT 
  year, month, day, 
  COUNT(*) AS sightings
FROM `bigquery-public-data.gbif.occurrences`
WHERE species = 'Sterna paradisaea'
  AND decimallatitude > 40
  AND month > 1
  AND year = 2015
GROUP BY year, month, day
ORDER BY month, day
LIMIT 20;
```

```sql
-- 5. All years: the first calendar day (after Jan) on which >10 sightings occurred
--    (but keep multiple rows per year if tied)
SELECT
  year,
  month,
  day,
  COUNT(*) AS sightings
FROM `bigquery-public-data.gbif.occurrences`
WHERE species = 'Sterna paradisaea'
  AND decimallatitude > 40
  AND month > 1
GROUP BY year, month, day
HAVING COUNT(*) > 10
ORDER BY year, month, day
LIMIT 20;
```

```sql
-- 6. Same as (5) but use eventdate for a sanity check
SELECT
  year,
  month,
  day,
  MIN(eventdate) AS min_event_ts,
  COUNT(*)        AS sightings
FROM `bigquery-public-data.gbif.occurrences`
WHERE species = 'Sterna paradisaea'
  AND decimallatitude > 40
  AND month > 1
GROUP BY year, month, day
HAVING COUNT(*) > 10
ORDER BY year, month, day
LIMIT 20;
```

```sql
-- 7. Earliest qualifying date for every year (after Jan) with >10 sightings
WITH daily AS (
  SELECT
    year,
    month,
    day,
    COUNT(*) AS sightings
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE species = 'Sterna paradisaea'
    AND decimallatitude > 40
    AND month > 1
  GROUP BY year, month, day
  HAVING COUNT(*) > 10
)
SELECT
  year,
  MIN(PARSE_DATE('%Y-%m-%d', CONCAT(CAST(year AS STRING),'-',LPAD(CAST(month AS STRING),2,'0'),'-',LPAD(CAST(day AS STRING),2,'0')))) 
      AS first_big_day
FROM daily
GROUP BY year
ORDER BY first_big_day
LIMIT 20;
```

```sql
-- 8. Check the raw counts on the earliest day of each year (join with query 7)
WITH daily AS (
  SELECT
    year,
    month,
    day,
    COUNT(*) AS sightings
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE species = 'Sterna paradisaea'
    AND decimallatitude > 40
    AND month > 1
  GROUP BY year, month, day
  HAVING COUNT(*) > 10
),
first_day AS (
  SELECT
    year,
    MIN(DATE(year,month,day)) AS first_big_day
  FROM daily
  GROUP BY year
)
SELECT 
  d.*
FROM daily AS d
JOIN first_day AS f
ON d.year = f.year
 AND DATE(d.year,d.month,d.day) = f.first_big_day
ORDER BY f.first_big_day
LIMIT 20;
```

```sql
-- 9. Finally pick the single year whose "first_big_day" is the earliest overall
WITH daily AS (
  SELECT
    year,
    month,
    day,
    COUNT(*) AS sightings
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE species = 'Sterna paradisaea'
    AND decimallatitude > 40
    AND month > 1
  GROUP BY year, month, day
  HAVING COUNT(*) > 10
),
first_day AS (
  SELECT
    year,
    MIN(DATE(year,month,day)) AS first_big_day
  FROM daily
  GROUP BY year
)
SELECT
  year,
  first_big_day
FROM first_day
ORDER BY first_big_day        -- earliest first
LIMIT 1;
```

```sql
-- 10. Same as (9) but return the actual daily count for transparency
WITH daily AS (
  SELECT
    year,
    month,
    day,
    COUNT(*) AS sightings
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE species = 'Sterna paradisaea'
    AND decimallatitude > 40
    AND month > 1
  GROUP BY year, month, day
  HAVING COUNT(*) > 10
),
first_day AS (
  SELECT
    year,
    MIN(DATE(year,month,day)) AS first_big_day
  FROM daily
  GROUP BY year
),
ranked AS (
  SELECT 
    fd.year,
    fd.first_big_day,
    d.sightings
  FROM first_day AS fd
  JOIN daily      AS d
  ON  DATE(d.year,d.month,d.day) = fd.first_big_day
  AND d.year = fd.year
)
SELECT *
FROM ranked
ORDER BY first_big_day
LIMIT 1;
```

Run the last query (9) or (10) to get the final answer:  
the year whose first post‑January date with > 10 north‑of‑40° sightings of Sterna paradisaea is the earliest among all years.
