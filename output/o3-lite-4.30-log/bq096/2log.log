3. `month > 1`  or `EXTRACT(MONTH FROM eventdate) > 1`.  
4. `COUNT(*) > 10` in a GROUP BY on each date.  

Below are ten illustrative BigQuery SQL statements, moving from very simple exploration to the final query that returns the requested year.  
(Each ends with `LIMIT 20` so it can be run safely for inspection.)

```sql
-- 1. Description: Peek at a handful of Arctic‑tern records in the whole table
SELECT gbifid, species, scientificname, decimallatitude, eventdate
FROM `bigquery-public-data.gbif.occurrences`
WHERE LOWER(species) = 'sterna paradisaea'
LIMIT 20;
```

```sql
-- 2. Description: List distinct `scientificname` values that mention “sterna paradisaea”
SELECT DISTINCT scientificname
FROM `bigquery-public-data.gbif.occurrences`
WHERE LOWER(scientificname) LIKE '%sterna%paradisaea%'
LIMIT 20;
```

```sql
-- 3. Description: Check latitude distribution of the species
SELECT decimallatitude
FROM `bigquery-public-data.gbif.occurrences`
WHERE LOWER(species) = 'sterna paradisaea'
ORDER BY decimallatitude DESC
LIMIT 20;
```

```sql
-- 4. Description: Inspect sample rows north of 40° latitude
SELECT gbifid, decimallatitude, decimallongitude, eventdate
FROM `bigquery-public-data.gbif.occurrences`
WHERE LOWER(species) = 'sterna paradisaea'
  AND decimallatitude > 40
LIMIT 20;
```

```sql
-- 5. Description: Show month distribution (after January) north of 40°
SELECT month, COUNT(*) AS n_obs
FROM `bigquery-public-data.gbif.occurrences`
WHERE LOWER(species) = 'sterna paradisaea'
  AND decimallatitude > 40
  AND month > 1
GROUP BY month
ORDER BY month
LIMIT 20;
```

```sql
-- 6. Description: How many sightings per day (any year) after January
SELECT DATE(eventdate) AS obs_date, COUNT(*) AS n_obs
FROM `bigquery-public-data.gbif.occurrences`
WHERE LOWER(species) = 'sterna paradisaea'
  AND decimallatitude > 40
  AND EXTRACT(MONTH FROM eventdate) > 1
GROUP BY obs_date
HAVING n_obs > 10
ORDER BY obs_date
LIMIT 20;
```

```sql
-- 7. Description: First qualifying date for a single year (e.g., 2018)
WITH daily AS (
  SELECT DATE(eventdate) AS obs_date, COUNT(*) AS n_obs
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE LOWER(species) = 'sterna paradisaea'
    AND decimallatitude > 40
    AND EXTRACT(YEAR  FROM eventdate) = 2018
    AND EXTRACT(MONTH FROM eventdate) > 1
  GROUP BY obs_date
  HAVING n_obs > 10
)
SELECT MIN(obs_date) AS first_date_over_10
FROM daily
LIMIT 20;
```

```sql
-- 8. Description: Compute the first qualifying date for every year
WITH daily AS (
  SELECT EXTRACT(YEAR FROM eventdate) AS yr,
         DATE(eventdate)             AS obs_date,
         COUNT(*)                    AS n_obs
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE LOWER(species) = 'sterna paradisaea'
    AND decimallatitude > 40
    AND EXTRACT(MONTH FROM eventdate) > 1
  GROUP BY yr, obs_date
  HAVING n_obs > 10
),
first_per_year AS (
  SELECT yr,
         MIN(obs_date) AS first_date
  FROM daily
  GROUP BY yr
)
SELECT *
FROM first_per_year
ORDER BY first_date
LIMIT 20;
```

```sql
-- 9. Description: Return the year whose first qualifying date is earliest overall
WITH daily AS (
  SELECT EXTRACT(YEAR FROM eventdate) AS yr,
         DATE(eventdate)             AS obs_date,
         COUNT(*)                    AS n_obs
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE LOWER(species) = 'sterna paradisaea'
    AND decimallatitude > 40
    AND EXTRACT(MONTH FROM eventdate) > 1
  GROUP BY yr, obs_date
  HAVING n_obs > 10
),
first_per_year AS (
  SELECT yr,
         MIN(obs_date) AS first_date
  FROM daily
  GROUP BY yr
)
SELECT yr AS year_with_earliest_date,
       first_date AS earliest_date
FROM first_per_year
ORDER BY first_date
LIMIT 20;
```

```sql
-- 10. Description: Same as #9 but showing only the single earliest year/date pair
WITH daily AS (
  SELECT EXTRACT(YEAR FROM eventdate) AS yr,
         DATE(eventdate)             AS obs_date,
         COUNT(*)                    AS n_obs
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE LOWER(species) = 'sterna paradisaea'
    AND decimallatitude > 40
    AND EXTRACT(MONTH FROM eventdate) > 1
  GROUP BY yr, obs_date
  HAVING n_obs > 10
),
first_per_year AS (
  SELECT yr,
         MIN(obs_date) AS first_date
  FROM daily
  GROUP BY yr
),
overall_earliest AS (
  SELECT *
  FROM first_per_year
  ORDER BY first_date
  LIMIT 1
)
SELECT yr  AS year_with_earliest_post_jan_date_over_10_sightings,
       first_date
FROM overall_earliest
LIMIT 20;
```

