{'bigquery-public-data': {'eclipse_megamovie': ['astrometry_match_v_0_4', 'photos_v_0_2', 'photos_v_0_3', 'astrometry_index_v_0_4', 'astrometry_corr_v_0_4', 'astrometry_rdls_v_0_4', 'photos_v_0_1']}}
Begin Exploring Related Columns
Relevant columns & how they will be used  

`user`            : the photographer’s (uploader’s) id – this is the column we will GROUP BY to count “clicks” (photos).  
`id`              : each photo’s unique identifier – we COUNT them per `user` to obtain the number of clicks.  
`uploaded_date`   : can be used when we want to check time ranges or eliminate accidental duplicates shot‑in‑a‑row (not needed for the final answer, but handy for experiments).  
`image_type`      : may be used for conditional filters (e.g. JPEG only) while testing.  
`width`,`height`  : could be used to keep only “real” photos (e.g. width > 0) if necessary.  

Typical conditions that might be applied during exploration  

• `WHERE user IS NOT NULL` – ignore rows without a user id.  
• `WHERE width > 0 AND height > 0` – make sure the row really represents an image.  
• `WHERE uploaded_date BETWEEN TIMESTAMP '2017‑08‑01' AND TIMESTAMP '2017‑09‑01'` – limit to the eclipse campaign period.  

Below are ten progressive BigQuery SQL snippets (all use `LIMIT 20`) that go from the simplest look‑ups to a final query that gives the single user with the highest total number of “clicks” (photo rows) across the three photo tables.

```sql
-- 1. Preview: first 20 users in photos_v_0_1
SELECT user, id
FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_1`
LIMIT 20;
```

```sql
-- 2. Count clicks per user in photos_v_0_1
SELECT user, COUNT(*) AS clicks_p01
FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_1`
WHERE user IS NOT NULL
GROUP BY user
ORDER BY clicks_p01 DESC
LIMIT 20;
```

```sql
-- 3. Count clicks per user in photos_v_0_2
SELECT user, COUNT(*) AS clicks_p02
FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_2`
WHERE user IS NOT NULL
GROUP BY user
ORDER BY clicks_p02 DESC
LIMIT 20;
```

```sql
-- 4. Count clicks per user in photos_v_0_3
SELECT user, COUNT(*) AS clicks_p03
FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_3`
WHERE user IS NOT NULL
GROUP BY user
ORDER BY clicks_p03 DESC
LIMIT 20;
```

```sql
-- 5. Union ALL the three tables and look at one user's first 20 photo ids
SELECT id, user
FROM (
  SELECT id, user FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_1`
  UNION ALL
  SELECT id, user FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_2`
  UNION ALL
  SELECT id, user FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_3`
)
WHERE user = 'put‑a‑real‑user‑id‑here'
LIMIT 20;
```

```sql
-- 6. Aggregate per table, then combine with FULL JOIN (handy for diagnostics)
WITH
p01 AS (
  SELECT user, COUNT(*) AS c01
  FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_1`
  WHERE user IS NOT NULL
  GROUP BY user
),
p02 AS (
  SELECT user, COUNT(*) AS c02
  FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_2`
  WHERE user IS NOT NULL
  GROUP BY user
),
p03 AS (
  SELECT user, COUNT(*) AS c03
  FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_3`
  WHERE user IS NOT NULL
  GROUP BY user
)
SELECT *
FROM p01
FULL JOIN p02 USING (user)
FULL JOIN p03 USING (user)
ORDER BY COALESCE(c01,0)+COALESCE(c02,0)+COALESCE(c03,0) DESC
LIMIT 20;
```

```sql
-- 7. One‑liner that counts total clicks via UNION ALL
SELECT user, COUNT(*) AS total_clicks
FROM (
  SELECT user FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_1`
  UNION ALL
  SELECT user FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_2`
  UNION ALL
  SELECT user FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_3`
)
WHERE user IS NOT NULL
GROUP BY user
ORDER BY total_clicks DESC
LIMIT 20;
```

```sql
-- 8. Same as #7 but using QUALIFY and a window function (shows top 20)
SELECT user,
       COUNT(*) AS total_clicks,
       RANK() OVER (ORDER BY COUNT(*) DESC) AS rnk
FROM (
  SELECT user FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_1`
  UNION ALL
  SELECT user FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_2`
  UNION ALL
  SELECT user FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_3`
)
WHERE user IS NOT NULL
GROUP BY user
QUALIFY rnk <= 20
ORDER BY rnk;
```

```sql
-- 9. Retrieve detailed rows for the current champion (first step: find the champion)
WITH all_photos AS (
  SELECT user, id, uploaded_date
  FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_1`
  UNION ALL
  SELECT user, id, uploaded_date
  FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_2`
  UNION ALL
  SELECT user, id, uploaded_date
  FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_3`
),
champion AS (
  SELECT user
  FROM all_photos
  WHERE user IS NOT NULL
  GROUP BY user
  ORDER BY COUNT(*) DESC
  LIMIT 1
)
SELECT p.*
FROM all_photos AS p
JOIN champion USING (user)
LIMIT 20;
```

