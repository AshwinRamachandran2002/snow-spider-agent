```sql
--Description / thinking process:
-- Task:  For Canadian (country_code = 'CA') patent publications between 1960‑01‑01 and 2020‑12‑31,
--        return, for each 5‑year interval (1960‑1964, 1965‑1969, …, 2020),
--        • total number of publications, and
--        • average number of inventors per patent (consider only patents that list at least one inventor).
--
-- Steps:
--   1) ca_all  – select every CA publication in the date range; extract publication year.
--   2) ca_inv  – flatten the JSON array "inventor" to count inventors per publication;
--               keep only publications with ≥1 inventor.
--   3) bucketed – attach a 5‑year bucket to each publication (period_start).
--   4) final aggregation – group by period_start, count DISTINCT publications,
--               and average inventor_cnt (NULLs from LEFT JOIN ensure patents without inventor data
--               do not contribute to the average).
--
-- The earlier “ambiguous column name pub_year” error is avoided by computing period_start
-- in the bucketed CTE rather than in the final SELECT.

WITH ca_all AS (                         -- 1) all CA publications in range
    SELECT  "publication_number",
            FLOOR("publication_date" / 10000) AS pub_year
    FROM    PATENTS.PATENTS.PUBLICATIONS
    WHERE   "country_code" = 'CA'
      AND   "publication_date" BETWEEN 19600101 AND 20201231
),
ca_inv AS (                              -- 2) inventor counts per publication
    SELECT  p."publication_number",
            COUNT(inv.value) AS inventor_cnt
    FROM    PATENTS.PATENTS.PUBLICATIONS p,
            LATERAL FLATTEN(input => p."inventor") inv
    WHERE   p."country_code" = 'CA'
      AND   p."publication_date" BETWEEN 19600101 AND 20201231
    GROUP BY p."publication_number"
    HAVING  COUNT(inv.value) > 0          -- keep only if ≥1 inventor
),
bucketed AS (                            -- 3) assign 5‑year bucket
    SELECT  a."publication_number",
            1960 + 5 * FLOOR( (a.pub_year - 1960) / 5 ) AS period_start
    FROM    ca_all a
)
SELECT  b.period_start,
        COUNT(DISTINCT b."publication_number") AS total_pubs,
        AVG(i.inventor_cnt)                     AS avg_inventors_per_patent
FROM    bucketed b
LEFT JOIN ca_inv i
       ON b."publication_number" = i."publication_number"
GROUP BY b.period_start
ORDER  BY b.period_start;
```
