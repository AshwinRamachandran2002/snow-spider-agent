Begin Exploring Related Columns
Relevant columns, their potential usage, and likely conditions
--------------------------------------------------------------
"publication_number":  uniquely identifies each patent publication; use for counting  
"country_code":        filter to Canadian publications →  WHERE "country_code" = 'CA'  
"publication_date":    extract year, build 5‑year buckets 1960‑1964 … 2015‑2019, 2020 →  
                       WHERE "publication_date" BETWEEN 19600101 AND 20201231  
"inventor":            VARIANT array of inventors; must be non‑null and have ≥1 element  
                       (check with IS NOT NULL, ARRAY_SIZE(), or FLATTEN + COUNT)  
"inventor_harmonized": alternative inventor list (same handling as above)  

Typical extra predicates  
• exclude records without inventors →  "inventor" IS NOT NULL AND ARRAY_SIZE("inventor") > 0  
• bucket start year (yyyy) →  FLOOR("publication_date" / 10000)  
• 5‑year period begin →  
  1960 + 5 * FLOOR( (FLOOR("publication_date"/10000) - 1960) / 5 )

Exploratory Snowflake SQL queries (10 progressively richer examples)
--------------------------------------------------------------------

```sql
-- 1. Quick look at a few Canadian patent publications and their inventors
SELECT "publication_number",
       "publication_date",
       "country_code",
       "inventor"
FROM   PATENTS.PATENTS.PUBLICATIONS
WHERE  "country_code" = 'CA'
LIMIT  20;
```

```sql
-- 2. Distinct publication years for Canadian patents
SELECT DISTINCT FLOOR("publication_date" / 10000) AS "year"
FROM   PATENTS.PATENTS.PUBLICATIONS
WHERE  "country_code" = 'CA'
ORDER  BY "year"
LIMIT  20;
```

```sql
-- 3. Sample of Canadian patents that actually list inventors
SELECT "publication_number",
       "inventor"
FROM   PATENTS.PATENTS.PUBLICATIONS
WHERE  "country_code" = 'CA'
  AND  "inventor" IS NOT NULL
LIMIT  20;
```

```sql
-- 4. Flatten the inventor array to show one row per inventor name
SELECT  p."publication_number",
        inv.value::STRING AS "inventor_name"
FROM    PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."inventor") inv
WHERE   p."country_code" = 'CA'
LIMIT   20;
```

```sql
-- 5. Count how many inventors each Canadian patent lists
SELECT  p."publication_number",
        COUNT(inv.value) AS "inventor_count"
FROM    PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."inventor") inv
WHERE   p."country_code" = 'CA'
GROUP BY p."publication_number"
LIMIT   20;
```

```sql
-- 6. Verify that we have data from 1960‑2020 for Canada
SELECT  MIN("publication_date") AS "earliest_ca_pub",
        MAX("publication_date") AS "latest_ca_pub"
FROM    PATENTS.PATENTS.PUBLICATIONS
WHERE   "country_code" = 'CA';
```

```sql
-- 7. 5‑year bucket, total publication count (no inventor filter yet)
SELECT  1960 + 5 * FLOOR( (FLOOR("publication_date" / 10000) - 1960) / 5 ) AS "period_start",
        COUNT(DISTINCT "publication_number")                               AS "pubs_in_period"
FROM    PATENTS.PATENTS.PUBLICATIONS
WHERE   "country_code" = 'CA'
  AND   "publication_date" BETWEEN 19600101 AND 20201231
GROUP BY 1
ORDER  BY 1
LIMIT  20;
```

```sql
-- 8. Same 5‑year bucket but only patents that list ≥1 inventor
WITH ca_with_inv AS (
    SELECT  p."publication_number",
            FLOOR(p."publication_date" / 10000) AS "pub_year",
            COUNT(inv.value)                     AS "inventor_cnt"
    FROM    PATENTS.PATENTS.PUBLICATIONS p,
            LATERAL FLATTEN(input => p."inventor") inv
    WHERE   p."country_code" = 'CA'
    GROUP  BY p."publication_number",
             FLOOR(p."publication_date" / 10000)
    HAVING  COUNT(inv.value) > 0
)
SELECT  1960 + 5 * FLOOR( ("pub_year" - 1960) / 5 )   AS "period_start",
        COUNT(*)                                      AS "pubs_with_inv"
FROM    ca_with_inv
GROUP BY 1
ORDER  BY 1
LIMIT  20;
```

```sql
-- 9. Average number of inventors per patent by 5‑year period
WITH ca_inv AS (
    SELECT  p."publication_number",
            FLOOR(p."publication_date" / 10000) AS "pub_year",
            COUNT(inv.value)                     AS "inventor_cnt"
    FROM    PATENTS.PATENTS.PUBLICATIONS p,
            LATERAL FLATTEN(input => p."inventor") inv
    WHERE   p."country_code" = 'CA'
    GROUP  BY p."publication_number",
             FLOOR(p."publication_date" / 10000)
    HAVING  COUNT(inv.value) > 0
)
SELECT  1960 + 5 * FLOOR( ("pub_year" - 1960) / 5 )          AS "period_start",
        AVG("inventor_cnt")                                  AS "avg_inventors_per_patent"
FROM    ca_inv
GROUP BY 1
ORDER  BY 1
LIMIT  20;
```

```sql
-- 10. Final combined query: total CA publications and average inventors per patent (1960‑2020)
WITH ca_all AS (
    SELECT  "publication_number",
            FLOOR("publication_date" / 10000) AS "pub_year"
    FROM    PATENTS.PATENTS.PUBLICATIONS
    WHERE   "country_code" = 'CA'
      AND   "publication_date" BETWEEN 19600101 AND 20201231
),
ca_inv AS (
    SELECT  p."publication_number",
            FLOOR(p."publication_date" / 10000) AS "pub_year",
            COUNT(inv.value)                     AS "inventor_cnt"
    FROM    PATENTS.PATENTS.PUBLICATIONS p,
            LATERAL FLATTEN(input => p."inventor") inv
    WHERE   p."country_code" = 'CA'
      AND   p."publication_date" BETWEEN 19600101 AND 20201231
    GROUP  BY p."publication_number",
             FLOOR(p."publication_date" / 10000)
    HAVING  COUNT(inv.value) > 0
)
SELECT  1960 + 5 * FLOOR( ("pub_year" - 1960) / 5 )                AS "period_start",
        COUNT(DISTINCT ca_all."publication_number")                AS "total_pubs",
        AVG(ca_inv."inventor_cnt")                                 AS "avg_inventors_per_patent"
FROM    ca_all
LEFT JOIN ca_inv
  ON    ca_all."publication_number" = ca_inv."publication_number"
GROUP BY 1
ORDER  BY 1
LIMIT  20;
```

Each query is capped with `LIMIT 20` for safe exploration. Adjust or remove limits once column contents and record counts are well understood.
