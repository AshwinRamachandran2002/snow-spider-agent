```sql
WITH inventor_count AS (
    /* 1.  Count inventors for every Canadian patent publication (1960‑2020) and
           assign the publication to a 5‑year interval start year                */
    SELECT
        p."publication_number",
        /* e.g. 1960, 1965, …, 2020 */
        1960 + 5 * FLOOR((FLOOR(p."publication_date" / 10000) - 1960) / 5) 
            AS "period_start_year",
        COUNT(f.value)                                                   AS "inventor_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS AS p,
         LATERAL FLATTEN(INPUT => p."inventor") AS f
    WHERE p."country_code" = 'CA'
      AND p."publication_date" BETWEEN 19600101 AND 20201231
    GROUP BY p."publication_number", p."publication_date"
),
period_stats AS (
    /* 2.  Aggregate by 5‑year period, keeping only publications
           that list at least one inventor                                  */
    SELECT
        "period_start_year",
        CONCAT("period_start_year", '-', "period_start_year" + 4) 
            AS "five_year_period",
        AVG("inventor_cnt")                           AS "avg_inventors_per_patent",
        COUNT(*)                                      AS "total_patent_publications"
    FROM inventor_count
    WHERE "inventor_cnt" > 0
    GROUP BY "period_start_year"
)
SELECT
    "five_year_period",
    "avg_inventors_per_patent",
    "total_patent_publications"
FROM period_stats
ORDER BY "period_start_year";
```
