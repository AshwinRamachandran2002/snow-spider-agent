Begin Exploring Related Columns
Below are the pieces you would normally explore (columns, filters, and 10 exploratory → final queries).  
Each query is wrapped in back‑ticks and limited to 20 rows (except the last one) so you can run them in BigQuery exactly as written.

────────────────────────────────────────
Key columns and their purpose
• bigquery-public-data.census_bureau_acs.censustract_2017_5yr  
  – geo_id : joins to the Washington‑tract geometry table  
  – total_pop : tract population to be proportionally allocated  
  – income_per_capita : lets us build tract‑level total income (total_pop × income_per_capita)  

• bigquery-public-data.geo_census_tracts.census_tracts_washington  
  – geo_id : joins to ACS table  
  – tract_geom ( GEOGRAPHY ) : polygon we intersect with ZIP polygons  

• bigquery-public-data.geo_us_boundaries.zip_codes  
  – zip_code_geom ( GEOGRAPHY ) : ZIP polygon used for intersection  
  – state_code = 'WA' : keep only Washington ZIPs  
  – internal_point_geom : used with ST_DWithin to get ZIPs within 5‑mile radius of  
    ST_GEOGPOINT(‑122.191667, 47.685833)  

Main conditions you will use
1.  ST_DWithin(internal_point_geom, ST_GEOGPOINT(-122.191667, 47.685833), 8046.72)  
    →  5 miles ≈ 8 046.72 meters  
2.  ST_INTERSECTS(zip_code_geom , tract_geom)  
3.  Area ratio = ST_AREA( ST_INTERSECTION(zip_code_geom , tract_geom) )  
                ÷ ST_AREA(tract_geom)

────────────────────────────────────────
10 progressively richer SQL samples
(Feel free to run/modify them while developing—the last one is the required answer.)

```sql
--1️⃣  Description: Peek at a few Washington‑state ZIP polygons and their centroids
SELECT zip_code, state_code, ST_ASWKT(internal_point_geom) AS centroid_wkt
FROM `bigquery-public-data.geo_us_boundaries.zip_codes`
WHERE state_code = 'WA'
LIMIT 20;
```

```sql
--2️⃣  Description: Inspect some Washington tract geometries
SELECT geo_id, tract_name, ST_AREA(tract_geom)/1e6 AS area_sqkm
FROM `bigquery-public-data.geo_census_tracts.census_tracts_washington`
LIMIT 20;
```

```sql
--3️⃣  Description: Quick look at ACS population & per‑capita‑income columns
SELECT geo_id, total_pop, income_per_capita
FROM `bigquery-public-data.census_bureau_acs.censustract_2017_5yr`
LIMIT 20;
```

```sql
--4️⃣  Description: Which ZIPs fall within 5 miles of the given point?
SELECT zip_code
FROM `bigquery-public-data.geo_us_boundaries.zip_codes`
WHERE state_code = 'WA'
  AND ST_DWithin(
        internal_point_geom,
        ST_GEOGPOINT(-122.191667,47.685833),
        8046.72)    -- 5 miles in metres
LIMIT 20;
```

```sql
--5️⃣  Description: One random tract / ZIP pair that intersects (proves geometry works)
SELECT z.zip_code, t.geo_id,
       ST_INTERSECTS(z.zip_code_geom, t.tract_geom) AS they_touch
FROM `bigquery-public-data.geo_us_boundaries.zip_codes` AS z
JOIN `bigquery-public-data.geo_census_tracts.census_tracts_washington` AS t
ON ST_INTERSECTS(z.zip_code_geom, t.tract_geom)
WHERE z.state_code='WA'
LIMIT 20;
```

```sql
--6️⃣  Description: Compute raw intersection area for a single pair
SELECT
  z.zip_code,
  t.geo_id,
  ST_AREA( ST_INTERSECTION(z.zip_code_geom, t.tract_geom) ) AS overlap_m2
FROM `bigquery-public-data.geo_us_boundaries.zip_codes` AS z
JOIN `bigquery-public-data.geo_census_tracts.census_tracts_washington` AS t
ON z.zip_code='98052'            -- pick a sample ZIP
   AND t.geo_id LIKE '53033%'    -- King County tracts
   AND ST_INTERSECTS(z.zip_code_geom, t.tract_geom)
LIMIT 20;
```

```sql
--7️⃣  Description: Add tract area to get proportional share of population
SELECT
  t.geo_id,
  z.zip_code,
  t.total_pop,
  ST_AREA( ST_INTERSECTION(z.zip_code_geom, t.tract_geom) )
    / ST_AREA(t.tract_geom) AS pct_of_tract
FROM `bigquery-public-data.census_bureau_acs.censustract_2017_5yr`  AS a
JOIN `bigquery-public-data.geo_census_tracts.census_tracts_washington` AS t
USING (geo_id)
JOIN `bigquery-public-data.geo_us_boundaries.zip_codes` AS z
ON ST_INTERSECTS(z.zip_code_geom, t.tract_geom)
WHERE z.zip_code='98052'
LIMIT 20;
```

```sql
--8️⃣  Description: Turn that share into allocated population & income for one ZIP
SELECT
  z.zip_code,
  SUM(t.total_pop * ratio)                       AS pop_alloc,
  SUM(t.total_pop * t.income_per_capita * ratio) AS income_alloc
FROM (
  SELECT
    tt.geo_id,
    tt.total_pop,
    tt.income_per_capita,
    gz.zip_code,
    ST_AREA( ST_INTERSECTION(gz.zip_code_geom, gt.tract_geom) )
      / ST_AREA(gt.tract_geom) AS ratio
  FROM `bigquery-public-data.census_bureau_acs.censustract_2017_5yr`  tt
  JOIN `bigquery-public-data.geo_census_tracts.census_tracts_washington` gt
    USING (geo_id)
  JOIN `bigquery-public-data.geo_us_boundaries.zip_codes` gz
    ON gz.zip_code = '98052'
   AND ST_INTERSECTS(gz.zip_code_geom, gt.tract_geom)
) AS t
JOIN `bigquery-public-data.geo_us_boundaries.zip_codes` z
  ON z.zip_code = t.zip_code
GROUP BY z.zip_code
LIMIT 20;
```

```sql
--9️⃣  Description: List every ZIP within 5 miles together with one allocated figure
WITH zip_radius AS (
  SELECT zip_code, zip_code_geom
  FROM `bigquery-public-data.geo_us_boundaries.zip_codes`
  WHERE state_code = 'WA'
    AND ST_DWithin(internal_point_geom,
                   ST_GEOGPOINT(-122.191667,47.685833),
                   8046.72)
)
SELECT zr.zip_code, COUNT(*) AS intersecting_tracts
FROM zip_radius zr
JOIN `bigquery-public-data.geo_census_tracts.census_tracts_washington` gt
ON ST_INTERSECTS(zr.zip_code_geom, gt.tract_geom)
GROUP BY zr.zip_code
LIMIT 20;
```

```sql
--🔟  Description: FINAL ANSWER – population & average individual income
WITH zip_wa AS (
  -- Washington ZIPs within 5‑mile radius
  SELECT
    zip_code,
    zip_code_geom
  FROM `bigquery-public-data.geo_us_boundaries.zip_codes`
  WHERE state_code = 'WA'
    AND ST_DWithin(internal_point_geom,
                   ST_GEOGPOINT(-122.191667,47.685833),
                   8046.72)
),
tracts AS (
  -- Tracts with geometry & ACS fields
  SELECT
    a.geo_id,
    a.total_pop,
    a.income_per_capita,
    gt.tract_geom,
    ST_AREA(gt.tract_geom) AS tract_area_m2
  FROM `bigquery-public-data.census_bureau_acs.censustract_2017_5yr`  AS a
  JOIN `bigquery-public-data.geo_census_tracts.census_tracts_washington` AS gt
    USING (geo_id)
),
pairwise AS (
  -- Compute overlap ratios & allocate population / income
  SELECT
    z.zip_code,
    ( ST_AREA(ST_INTERSECTION(z.zip_code_geom , t.tract_geom))
      / t.tract_area_m2 )                 AS ratio,
    t.total_pop,
    t.income_per_capita
  FROM zip_wa z
  JOIN tracts t
    ON ST_INTERSECTS(z.zip_code_geom , t.tract_geom)
),
alloc AS (
  SELECT
    zip_code,
    SUM(total_pop * ratio)                           AS pop_alloc,
    SUM(total_pop * income_per_capita * ratio)       AS income_alloc
  FROM pairwise
  GROUP BY zip_code
)
SELECT
  zip_code,
  ROUND(pop_alloc , 1)                                       AS total_population,
  ROUND(income_alloc / NULLIF(pop_alloc,0) , 1)              AS average_individual_income
FROM alloc
ORDER BY average_individual_income DESC;
```

