         SUM(CASE WHEN shot_made THEN 1 ELSE 0 END)     AS made,
         AVG(adj_x) AS avg_x,
         AVG(adj_y) AS avg_y
  FROM valid_shots
  GROUP BY game_id, shot_type
)
SELECT shot_type,
       AVG(avg_x)      AS avg_x_coord,
       AVG(avg_y)      AS avg_y_coord,
       AVG(attempts)   AS avg_attempts,
       AVG(made)       AS avg_made
FROM per_game
GROUP BY shot_type
ORDER BY shot_type;
