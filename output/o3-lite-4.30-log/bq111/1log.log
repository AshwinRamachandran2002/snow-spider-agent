```sql
/*  Correlate copy‑number aberration (Amp / Gain / Loss / Deletion) 
    frequencies between Mitelman (breast‑cancer: Morph 3111, Topo 0401) 
    and TCGA‑BRCA.  Pearson r and two‑sided p‑value are reported for every
    chromosome × aberration_type combination with ≥ 5 matched cytobands.   */

WITH
/* ------------------------- 1) Mitelman cohort ------------------------- */
breast_cases AS (             -- unique Mitelman breast‑cancer cases
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111' AND Topo = '0401'
),
total_mitelman AS (           -- number of Mitelman breast cases
  SELECT COUNT(*) AS n_cases FROM breast_cases
),
mit_band_presence AS (        -- one row ⇔ case × band × aberration_type
  SELECT DISTINCT
         CONCAT('chr', CAST(cb.chromosome AS STRING))     AS chr_lbl,
         cb.cytoband_name                                AS band,
         CASE
           WHEN cc.Type = 'Amplification' THEN 'Amplification'
           WHEN cc.Type = 'Gain'         THEN 'Gain'
           WHEN cc.Type = 'Loss'         THEN 'Loss'
           WHEN cc.Type = 'Deletion'     THEN 'Deletion'
         END                                             AS aberration_type,
         cc.RefNo,
         cc.CaseNo
  FROM   `mitelman-db.prod.CytoConverted`   cc
  JOIN   breast_cases                       bc   USING (RefNo, CaseNo)
  JOIN   `mitelman-db.prod.CytoBands_hg38`  cb
           ON  cc.Chr  = cb.chromosome
           AND cc.Start < cb.hg38_stop
           AND cc.End   > cb.hg38_start
  WHERE  cc.Type IN ('Amplification','Gain','Loss','Deletion')
),
mit_freq AS (                -- frequency per band & aberration_type
  SELECT
    chr_lbl        AS chromosome,
    band           AS cytoband,
    aberration_type,
    COUNT(DISTINCT CONCAT(RefNo,'-',CaseNo)) / tm.n_cases  AS freq_mitelman
  FROM   mit_band_presence, total_mitelman tm
  GROUP  BY chromosome, cytoband, aberration_type, tm.n_cases
),

/* --------------------------- 2) TCGA cohort --------------------------- */
tcga_seg AS (                -- TCGA‑BRCA copy‑number segments (hg38)
  SELECT
    case_barcode,
    CONCAT('chr', chromosome)          AS chr_lbl,
    start_position                     AS seg_start,
    end_position                       AS seg_end,
    segment_mean
  FROM  `isb-cgc.TCGA_hg38_data_v0.Copy_Number_Segment_Masked`
  WHERE project_short_name = 'TCGA-BRCA'
),
total_tcga AS (               -- number of TCGA‑BRCA cases
  SELECT COUNT(DISTINCT case_barcode) AS n_cases
  FROM   tcga_seg
),
tcga_band_presence AS (       -- one row ⇔ case × band × aberration_type
  SELECT DISTINCT
         ts.case_barcode,
         ts.chr_lbl                         AS chromosome,
         cb.cytoband_name                   AS cytoband,
         CASE
           WHEN ts.segment_mean >=  0.90 THEN 'Amplification'
           WHEN ts.segment_mean >=  0.20 THEN 'Gain'
           WHEN ts.segment_mean <= -0.90 THEN 'Deletion'
           WHEN ts.segment_mean <= -0.20 THEN 'Loss'
         END                                AS aberration_type
  FROM   tcga_seg               ts
  JOIN   `mitelman-db.prod.CytoBands_hg38` cb
           ON  ts.chr_lbl = cb.chromosome
           AND ts.seg_start < cb.hg38_stop
           AND ts.seg_end   > cb.hg38_start
  WHERE  ( (ts.segment_mean >=  0.90) OR (ts.segment_mean >= 0.20 AND ts.segment_mean < 0.90)
        OR (ts.segment_mean <= -0.90) OR (ts.segment_mean <= -0.20 AND ts.segment_mean > -0.90) )
),
tcga_freq AS (                -- frequency per band & aberration_type
  SELECT
    chromosome,
    cytoband,
    aberration_type,
    COUNT(DISTINCT case_barcode) / tt.n_cases   AS freq_tcga
  FROM   tcga_band_presence, total_tcga tt
  GROUP  BY chromosome, cytoband, aberration_type, tt.n_cases
),

/* ----------------------- 3) Match & correlate ------------------------- */
matched AS (                  -- bands present in BOTH datasets
  SELECT
    m.chromosome,
    m.cytoband,
    m.aberration_type,
    m.freq_mitelman,
    t.freq_tcga
  FROM   mit_freq  m
  JOIN   tcga_freq t
    USING (chromosome, cytoband, aberration_type)
),
per_chr_type AS (             -- correlation & sample size (N bands)
  SELECT
    chromosome,
    aberration_type,
    CORR(freq_mitelman, freq_tcga)  AS pearson_r,
    COUNT(*)                        AS n_bands
  FROM   matched
  GROUP  BY chromosome, aberration_type
  HAVING n_bands >= 5
)
SELECT
  chromosome,
  aberration_type,
  pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(pearson_r, n_bands) AS p_value
FROM   per_chr_type
ORDER  BY chromosome, aberration_type;
```
