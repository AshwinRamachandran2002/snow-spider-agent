--10) Description: Example intra‑Mitelman Pearson correlation:
--      gain counts (CytoConverted) vs loss counts (RecurrentNumData).
WITH breast_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111' AND Topo = '0401'
),
cyto_gain AS (
  SELECT REPLACE(cc.Chr,'chr','') AS Chromosome
  FROM   `mitelman-db.prod.CytoConverted` AS cc
  JOIN   breast_cases USING (RefNo, CaseNo)
  WHERE  cc.Type = 'Gain'
  GROUP  BY RefNo, CaseNo, Chromosome      -- 1 per case/chr
),
gain_cnt AS (
  SELECT Chromosome, COUNT(*) AS gain_cases
  FROM   cyto_gain
  GROUP  BY Chromosome
),
loss_cnt AS (
  SELECT Chromosome,
         SUM(CAST(TotalCases AS INT64)) AS loss_cases
  FROM   `mitelman-db.prod.RecurrentNumData`
  WHERE  Morph = '3111' AND Topo = '0401'
    AND  STARTS_WITH(Abnormality,'-')
  GROUP  BY Chromosome
),
joined AS (
  SELECT g.Chromosome,
         g.gain_cases,
         l.loss_cases
  FROM   gain_cnt AS g
  JOIN   loss_cnt AS l USING (Chromosome)
  WHERE  g.gain_cases >= 5 AND l.loss_cases >= 5
)
SELECT CORR(gain_cases, loss_cases) AS pearson_corr,
       COUNT(*)                     AS chromosomes_compared
FROM   joined;
