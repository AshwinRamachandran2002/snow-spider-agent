),
per_chr_type AS (
  SELECT
    chromosome,
    aberration_type,
    CORR(freq_mitelman, freq_tcga) AS pearson_r,
    COUNT(*)                       AS n_bands
  FROM   matched
  GROUP  BY chromosome, aberration_type
  HAVING n_bands >= 5
)
SELECT
  chromosome,
  aberration_type,
  pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(pearson_r, n_bands) AS p_value
FROM   per_chr_type
ORDER  BY chromosome, aberration_type;
