-- 9) Description: Aggregate RecurrentNumData into Gain / Loss buckets (≥5 only).
WITH agg AS (
  SELECT Chromosome,
         CASE 
           WHEN STARTS_WITH(Abnormality,'+') THEN 'Gain'
           WHEN STARTS_WITH(Abnormality,'-') THEN 'Loss'
           ELSE 'Other'
         END AS AberrationType,
         SUM(CAST(TotalCases AS INT64)) AS cases
  FROM   `mitelman-db.prod.RecurrentNumData`
  WHERE  Morph = '3111' AND Topo = '0401'
  GROUP  BY Chromosome, AberrationType
)
SELECT Chromosome, AberrationType, cases
FROM   agg
WHERE  cases >= 5
ORDER  BY Chromosome, AberrationType
LIMIT 20;
