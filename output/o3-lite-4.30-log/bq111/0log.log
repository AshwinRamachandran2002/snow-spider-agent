```sql
--Description ─ thinking process (in‑line):
--  • Goal: correlation, by CNA category, between Mitelman breast‑cancer cases
--    (Morph=3111, Topo=0401) and chromosome‑level counts stored in
--    RecurrentNumData (a TCGA‑like aggregate).
--  • Difficulty met earlier: chromosome names differ (“chr1” vs “1”); also
--    RecurrentNumData distinguishes only “+” and “–” (whole‑chromosome gains
--    and losses).  It has no explicit “Amp” flag, so correlations can be
--    computed only for ‘Gain’ and ‘Loss/Deletion’.  We therefore:
--      1) Build “mitelman” counts, stripping the “chr” prefix and collapsing
--         ‘Loss’, ‘Del’, ‘Deletion’ into a single ‘Loss’.
--      2) Build “tcga” counts, mapping “+” → Gain, “–” → Loss.
--      3) Join on Chromosome + CNA_Type; keep only chromosomes present in both.
--      4) For each CNA_Type, calculate Pearson r and its p‑value (BigQuery
--         UDF), but only if at least 5 chromosomes participate.
WITH mitelman AS (
  SELECT
    SUBSTR(cc.Chr, 4)                                                       AS Chromosome,            -- e.g. 'chr7' → '7'
    CASE
      WHEN cc.Type = 'Gain'                          THEN 'Gain'
      WHEN cc.Type IN ('Loss','Del','Deletion')      THEN 'Loss'
    END                                                                     AS CNA_Type,
    COUNT(DISTINCT FORMAT('%d-%s', cc.RefNo, cc.CaseNo))                    AS mitelman_cases
  FROM `mitelman-db.prod.CytoConverted` AS cc
  JOIN `mitelman-db.prod.Cytogen`       AS c
    ON cc.RefNo  = c.RefNo
   AND cc.CaseNo = c.CaseNo
  WHERE c.Morph = '3111'
    AND c.Topo  = '0401'
    AND cc.Type IN ('Gain','Loss','Del','Deletion')                         -- ‘Amp’ omitted; no TCGA match
  GROUP BY Chromosome, CNA_Type
),
tcga AS (
  SELECT
    Chromosome,
    CASE WHEN Abnormality LIKE '+%' THEN 'Gain' ELSE 'Loss' END             AS CNA_Type,
    CAST(TotalCases AS INT64)                                               AS tcga_cases
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE Morph = '3111'
    AND Topo  = '0401'
    AND (Abnormality LIKE '+%' OR Abnormality LIKE '-%')                    -- whole‑chr ± only
),
paired AS (
  SELECT
    m.Chromosome,
    m.CNA_Type,
    m.mitelman_cases,
    t.tcga_cases
  FROM mitelman AS m
  JOIN tcga     AS t
    ON m.Chromosome = t.Chromosome
   AND m.CNA_Type   = t.CNA_Type
)
SELECT
  CNA_Type,
  CORR(mitelman_cases, tcga_cases)                                          AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`
        (CORR(mitelman_cases, tcga_cases), COUNT(Chromosome))               AS p_value,
  COUNT(Chromosome)                                                         AS n_points
FROM paired
GROUP BY CNA_Type
HAVING n_points >= 5                                                        -- only robust results
ORDER BY CNA_Type;
