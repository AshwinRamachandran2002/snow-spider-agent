```sql
--Description / thinking process:
-- Goal → For the two broad CNA classes (“Gain” ≙ Gain+Amp, “Loss” ≙ Loss+Deletion)
--        calculate chromosome‑level Pearson correlations between
--        (a) Mitelman breast‑cancer cases (Morph 3111, Topo 0401) and
--        (b) the external summary counts in RecurrentNumData (used here as a TCGA proxy).
-- Rationale for design choices
--   • RecurrentNumData records events as “+” or “‑”; CytoConverted records four labels.
--     We harmonise them into two classes.
--   • CytoConverted chromosomes are “chr7” etc.; we strip the “chr” prefix so they
--     match RecurrentNumData’s “7”.
--   • Use COUNT(*) for the cohort and SUM(TotalCases) for the external table.
--   • SAFE.CORR avoids errors when variance is zero (returns NULL instead).
--   • Keep only classes represented on ≥5 chromosomes for a meaningful correlation.
--   • Skip p‑value calculation to stay within core BigQuery functions and guarantee
--     the query runs without requiring external UDF permissions.

WITH brca AS (
  SELECT
    REPLACE(conv.Chr, 'chr', '')                                           AS chromosome,
    CASE WHEN conv.Type IN ('Gain','Amp')        THEN 'Gain'
         WHEN conv.Type IN ('Loss','Deletion')   THEN 'Loss'
    END                                                                    AS cna_class,
    COUNT(*)                                                               AS x_count      -- breast cohort
  FROM `mitelman-db.prod.Cytogen`        AS cy
  JOIN `mitelman-db.prod.CytoConverted`  AS conv
    ON cy.RefNo  = conv.RefNo
   AND cy.CaseNo = conv.CaseNo
  WHERE cy.Morph = '3111'
    AND cy.Topo  = '0401'
    AND conv.Type IN ('Gain','Amp','Loss','Deletion')
  GROUP BY chromosome, cna_class
),
external AS (
  SELECT
    Chromosome                                                             AS chromosome,
    CASE WHEN LEFT(Abnormality,1) = '+' THEN 'Gain'
         WHEN LEFT(Abnormality,1) = '-' THEN 'Loss'
    END                                                                    AS cna_class,
    SUM(CAST(TotalCases AS INT64))                                         AS y_count      -- external proxy
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE LEFT(Abnormality,1) IN ('+','-')
  GROUP BY chromosome, cna_class
),
paired AS (
  SELECT
    b.cna_class,
    b.chromosome,
    b.x_count AS x,
    e.y_count AS y
  FROM brca     AS b
  JOIN external AS e
    ON  b.chromosome = e.chromosome
   AND b.cna_class   = e.cna_class
)
SELECT
  cna_class                             AS aberration_type,
  SAFE.CORR(x, y)                       AS pearson_r,
  COUNT(*)                              AS n_chromosomes
FROM paired
GROUP BY cna_class
HAVING n_chromosomes >= 5;
