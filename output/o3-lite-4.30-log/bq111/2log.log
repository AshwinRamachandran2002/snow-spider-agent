--Description / thinking process:
-- We must redo the earlier Pearson‑correlation query but ensure the external UDF
-- `corr_pvalue_current` is referenced correctly.  Because the project id
-- “isb-cgc-bq” contains a dash, the *entire* three‑part identifier must be
-- wrapped in back‑ticks.  The plan:
--   1. brca   – count Gain/Amp events per chromosome for breast‑cancer cases
--               (Morph = 3111, Topo = 0401).
--   2. whole  – count Gain/Amp events per chromosome for the full database.
--   3. merge  – inner‑join on chromosome to create paired vectors x and y.
--   4. Compute CORR(x,y)  ➜  Pearson r, and then feed (r,n) into the UDF
--      `isb-cgc-bq.functions.corr_pvalue_current` to obtain the p‑value.
--   5. Return results only if at least five chromosomes are represented.

WITH brca AS (
  SELECT
    conv.Chr           AS chromosome,
    COUNT(*)           AS x               -- breast‑cohort gains
  FROM `mitelman-db.prod.Cytogen`        AS c
  JOIN `mitelman-db.prod.CytoConverted`  AS conv
    ON c.RefNo  = conv.RefNo
   AND c.CaseNo = conv.CaseNo
  WHERE c.Morph = '3111'
    AND c.Topo  = '0401'
    AND conv.Type IN ('Gain', 'Amp')
  GROUP BY conv.Chr
),
whole AS (
  SELECT
    Chr                AS chromosome,
    COUNT(*)           AS y               -- whole‑database gains
  FROM `mitelman-db.prod.CytoConverted`
  WHERE Type IN ('Gain', 'Amp')
  GROUP BY Chr
),
merge AS (
  SELECT
    b.chromosome,
    b.x,
    w.y
  FROM brca  AS b
  JOIN whole AS w
    USING (chromosome)
)

SELECT
  corr_xy                                  AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(corr_xy, n_chr) AS p_value,
  n_chr                                    AS n_chromosomes
FROM (
  SELECT
    CORR(x, y) AS corr_xy,
    COUNT(*)   AS n_chr
  FROM merge
)
WHERE n_chr >= 5;
