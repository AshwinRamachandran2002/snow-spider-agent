```sql
-- Pearson correlation (per aberration type) between Mitelman BRCA
-- (copy‑number segments typed by CytoConverter, Morph = 3111, Topo = 0401)
-- and TCGA‑BRCA copy‑number segments (hg38; masked)                         
WITH mitelman AS (      -- counts per chromosome & aberration type
  SELECT
      conv.Chr                          AS chromosome,                      -- e.g. 'chr1'
      conv.Type                         AS aberration_type,                 -- Gain / Amp / Loss / Deletion
      COUNT(*)                          AS mitelman_ct
  FROM   `mitelman-db.prod.Cytogen`      AS cy
  JOIN   `mitelman-db.prod.CytoConverted` AS conv
         ON cy.RefNo  = conv.RefNo
        AND cy.CaseNo = conv.CaseNo
  WHERE  cy.Morph = '3111'                   -- breast carcinoma
    AND  cy.Topo  = '0401'                   -- breast site
    AND  conv.Type IN ('Gain','Amp','Loss','Deletion')
  GROUP  BY chromosome, aberration_type
),
tcga AS (          -- counts per chromosome & aberration type for TCGA‑BRCA
  SELECT
      CONCAT('chr', Chromosome)          AS chromosome,      -- harmonise label (‘chr1’, …)
      CASE
        WHEN SegmentMean >=  1.0  THEN 'Amp'
        WHEN SegmentMean >=  0.3  THEN 'Gain'
        WHEN SegmentMean <= -1.0  THEN 'Deletion'
        WHEN SegmentMean <= -0.3  THEN 'Loss'
      END                                AS aberration_type,
      COUNT(*)                           AS tcga_ct
  FROM  `isb-cgc.TCGA_hg38_data_v0.Copy_Number_Segment_Masked`
  WHERE ParticipantBarcode LIKE 'TCGA-BRCA-%'               -- limit to BRCA samples
    AND ( SegmentMean >=  0.3 OR SegmentMean <= -0.3 )      -- only aberrant segments
  GROUP BY chromosome, aberration_type
  HAVING aberration_type IS NOT NULL                        -- drop ‘normal’
),
joined AS (        -- chromosomes present in BOTH datasets
  SELECT
      m.chromosome,
      m.aberration_type,
      m.mitelman_ct  AS x,
      t.tcga_ct      AS y
  FROM   mitelman AS m
  JOIN   tcga     AS t
         ON m.chromosome      = t.chromosome
        AND m.aberration_type = t.aberration_type
)
-- compute correlation per aberration type, require ≥5 chromosomes
SELECT
    aberration_type,
    CORR(x, y)                                                   AS pearson_r,
    `isb-cgc-bq.functions.corr_pvalue_current`(CORR(x, y),
                                               COUNT(*))         AS p_value
FROM joined
GROUP BY aberration_type
HAVING COUNT(*) >= 5
ORDER BY aberration_type;
```

