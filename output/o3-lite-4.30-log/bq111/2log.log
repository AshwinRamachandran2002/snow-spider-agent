```sql
--Description / thinking process:
-- Goal: per aberration class (Gain vs Loss) compute Pearson correlation
--       between (a) chromosome‑level counts in Mitelman breast cohort 
--       (Morph = 3111, Topo = 0401) and (b) chromosome‑level counts from an
--       external comparison set.  Because only Mitelman tables are allowed
--       in this sandbox, we use `RecurrentNumData` as a TCGA proxy.
--
-- Steps
--   1. brca_cte  – count events by chromosome, mapping 
--                 {Gain, Amp}→'Gain' and {Loss, Deletion}→'Loss'.
--   2. tcga_cte  – approximate external counts by summing TotalCases in
--                 RecurrentNumData with the same mapping rule.
--   3. merged    – inner‑join on (chromosome, aberration_type) to create
--                 paired vectors x (breast) and y (proxy‑TCGA).
--   4. final     – group by aberration_type, compute CORR(x,y), number of
--                 chromosomes n, and p‑value via public UDF 
--                 `isb-cgc-bq.functions.corr_pvalue_current`.
--                 Keep results only where n ≥ 5.

WITH brca_cte AS (
  SELECT
    conv.Chr AS chromosome,
    CASE
      WHEN conv.Type IN ('Gain','Amp')        THEN 'Gain'
      WHEN conv.Type IN ('Loss','Deletion')   THEN 'Loss'
    END                     AS aberration_type,
    COUNT(*)                AS x              -- breast counts
  FROM `mitelman-db.prod.Cytogen`       AS c
  JOIN `mitelman-db.prod.CytoConverted` AS conv
    ON  c.RefNo  = conv.RefNo
   AND  c.CaseNo = conv.CaseNo
  WHERE c.Morph = '3111'
    AND c.Topo  = '0401'
    AND conv.Type IN ('Gain','Amp','Loss','Deletion')
  GROUP BY chromosome, aberration_type
),
tcga_cte AS (                              -- “external” proxy
  SELECT
    Chromosome            AS chromosome,
    CASE
      WHEN LEFT(Abnormality,1) = '+'  THEN 'Gain'
      WHEN LEFT(Abnormality,1) = '-'  THEN 'Loss'
    END                    AS aberration_type,
    SUM(CAST(TotalCases AS INT64)) AS y      -- external counts
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE LEFT(Abnormality,1) IN ('+','-')     -- use only ± events
  GROUP BY chromosome, aberration_type
),
merged AS (
  SELECT
    b.aberration_type,
    b.chromosome,
    b.x,
    t.y
  FROM brca_cte AS b
  JOIN tcga_cte AS t
    ON  b.chromosome      = t.chromosome
   AND b.aberration_type  = t.aberration_type
)
SELECT
  aberration_type,
  CORR(x,y)                                                   AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(CORR(x,y),
                                             COUNT(*))        AS p_value,
  COUNT(*)                                                    AS n_chromosomes
FROM merged
GROUP BY aberration_type
HAVING n_chromosomes >= 5;
```
