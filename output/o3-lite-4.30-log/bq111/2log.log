--              calculate the chromosome‑level Pearson correlation between
--              (a) Mitelman breast‑cancer cases (Morph = 3111, Topo = 0401)
--                  and
--              (b) the external summary counts held in RecurrentNumData.
--
--  Why this design?
--     • CytoConverted provides genomic segments with four labels; RecurrentNumData
--       distinguishes only “+” or “–”.  Collapsing to two classes maximises overlap.
--     • CytoConverted uses “chr7”, RecurrentNumData uses “7”; we strip the “chr”.
--     • The public UDF `isb-cgc-bq.functions.corr_pvalue_current` supplies the
--       p‑value for a given correlation coefficient and sample size.
--     • We report results only when at least five chromosomes contribute
--       (HAVING n_chr ≥ 5).
--
--  Outline of the query:
--     1. brca_cte  – tally x‑counts per (chromosome, class) for the breast cohort.
--     2. ext_cte   – tally y‑counts per (chromosome, class) from RecurrentNumData.
--     3. joined    – inner‑join to align the two vectors.
--     4. stats     – per class, compute Pearson r and number of chromosomes.
--     5. final     – append p‑value and apply ≥ 5 chromosome filter.

WITH brca_cte AS (
  SELECT
    REPLACE(conv.Chr, 'chr', '')                      AS chromosome,
    CASE
      WHEN conv.Type IN ('Gain', 'Amp')       THEN 'Gain'
      WHEN conv.Type IN ('Loss', 'Deletion')  THEN 'Loss'
    END                                             AS cna_class,
    COUNT(*)                                        AS x_count          -- breast
  FROM `mitelman-db.prod.Cytogen`        AS cy
  JOIN `mitelman-db.prod.CytoConverted`  AS conv
    ON cy.RefNo  = conv.RefNo
   AND cy.CaseNo = conv.CaseNo
  WHERE cy.Morph = '3111'                                 -- breast carcinoma
    AND cy.Topo  = '0401'                                 -- breast site
    AND conv.Type IN ('Gain','Amp','Loss','Deletion')
  GROUP BY chromosome, cna_class
),
ext_cte AS (
  SELECT
    Chromosome                                       AS chromosome,
    CASE
      WHEN LEFT(Abnormality,1) = '+' THEN 'Gain'
      WHEN LEFT(Abnormality,1) = '-' THEN 'Loss'
    END                                             AS cna_class,
    SUM(CAST(TotalCases AS INT64))                  AS y_count          -- external
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE LEFT(Abnormality,1) IN ('+','-')
  GROUP BY chromosome, cna_class
),
joined AS (
  SELECT
    b.cna_class,
    b.chromosome,
    b.x_count AS x,
    e.y_count AS y
  FROM brca_cte AS b
  JOIN ext_cte AS e
    ON  b.chromosome = e.chromosome
   AND b.cna_class  = e.cna_class
),
stats AS (
  SELECT
    cna_class,
    CORR(x, y) AS r_value,
    COUNT(*)   AS n_chr
  FROM joined
  GROUP BY cna_class
)
SELECT
  cna_class                                                  AS aberration_type,
  r_value                                                    AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(r_value, n_chr) AS p_value,
  n_chr                                                      AS n_chromosomes
FROM stats
WHERE n_chr >= 5;
