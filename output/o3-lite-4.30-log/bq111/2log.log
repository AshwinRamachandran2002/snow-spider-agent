-- 10. End‑to‑end example that
--     a) produces gain, loss, amp, deletion frequencies for breast cohort
--     b) joins to RecurrentNumData as a surrogate “external” data set
--     c) computes per‑aberration Pearson correlations (filter n>=5)
WITH brca AS (
  SELECT conv.Chr         AS chromosome,
         conv.Type        AS aberration_type,
         COUNT(*)         AS brca_ct
  FROM   `mitelman-db.prod.Cytogen`      AS cy
  JOIN   `mitelman-db.prod.CytoConverted` AS conv
    ON   cy.RefNo  = conv.RefNo
   AND   cy.CaseNo = conv.CaseNo
  WHERE  cy.Morph = '3111'
    AND  cy.Topo  = '0401'
    AND  conv.Type IN ('Gain','Amp','Loss','Deletion')
  GROUP  BY chromosome, aberration_type
),
rec AS (
  -- RecurrentNumData holds total‑case counts for each (chromosome, abnormality)
  -- Map its 'Abnormality' prefix to a generic aberration type
  SELECT chromosome             AS chromosome,
         CASE
           WHEN LEFT(Abnormality,1) = '+' THEN 'Gain'
           WHEN LEFT(Abnormality,1) = '-' THEN 'Loss'
           ELSE 'Other'
         END                    AS aberration_type,
         SUM(CAST(TotalCases AS INT64)) AS rec_ct
  FROM   `mitelman-db.prod.RecurrentNumData`
  GROUP  BY chromosome, aberration_type
),
joined AS (
  SELECT b.chromosome,
         b.aberration_type,
         b.brca_ct        AS x,
         r.rec_ct         AS y
  FROM   brca AS b
  JOIN   rec  AS r
    ON   b.chromosome       = r.chromosome
   AND   b.aberration_type  = r.aberration_type
)
SELECT aberration_type,
       CORR(x, y)  AS pearson_r,
       isb-cgc-bq.functions.corr_pvalue_current(CORR(x,y), COUNT(*)) AS p_value,
       COUNT(*)    AS n_chromosomes
FROM   joined
GROUP  BY aberration_type
HAVING n_chromosomes >= 5
LIMIT 20;
