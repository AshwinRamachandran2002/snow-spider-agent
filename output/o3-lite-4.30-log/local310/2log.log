Begin Exploring Related Columns
Relevant columns and their potential usage
• results.result_id  : not needed for aggregation but useful for row inspection  
• results.race_id   : links each result to a particular race (and, by joining to races, to a year)  
• results.driver_id  : used to aggregate a driver’s points inside a season  
• results.constructor_id: used to aggregate a constructor’s points inside a season  
• results.points    : the measure we have to sum  
• races.year     : lets us group every result by championship‑year  
Condition hints  
• WHERE r.points IS NOT NULL  – ignore null‑point rows (optional, the sum of NULL is zero anyway)  
• JOIN races ra ON ra.race_id = r.race_id – to obtain the year that every result belongs to  

Ten exploratory SQL queries (all limited to 20 rows)  
```sql
-- 1. Inspect a handful of raw rows from the results table
SELECT *
FROM   results
LIMIT  20;
```

```sql
-- 2. See which seasons are present in the data set
SELECT DISTINCT ra.year
FROM   results  AS r
JOIN   races    AS ra  ON ra.race_id = r.race_id
ORDER  BY ra.year
LIMIT  20;
```

```sql
-- 3. Total points earned by every driver in every year
SELECT ra.year,
       r.driver_id,
       SUM(r.points) AS driver_year_pts
FROM   results AS r
JOIN   races   AS ra ON ra.race_id = r.race_id
GROUP  BY ra.year, r.driver_id
ORDER  BY ra.year, driver_year_pts DESC
LIMIT  20;
```

```sql
-- 4. The single highest‑scoring driver of each year
SELECT ra.year,
       r.driver_id,
       SUM(r.points) AS top_driver_pts
FROM   results AS r
JOIN   races   AS ra ON ra.race_id = r.race_id
GROUP  BY ra.year, r.driver_id
HAVING SUM(r.points) = (
         SELECT MAX(SUM(r2.points))
         FROM   results AS r2
         JOIN   races   AS ra2 ON ra2.race_id = r2.race_id
         WHERE  ra2.year = ra.year
         GROUP  BY r2.driver_id
       )
ORDER  BY ra.year
LIMIT  20;
```

```sql
-- 5. Total points earned by every constructor in every year
SELECT ra.year,
       r.constructor_id,
       SUM(r.points) AS constructor_year_pts
FROM   results AS r
JOIN   races   AS ra ON ra.race_id = r.race_id
GROUP  BY ra.year, r.constructor_id
ORDER  BY ra.year, constructor_year_pts DESC
LIMIT  20;
```

```sql
-- 6. The single highest‑scoring constructor of each year
SELECT ra.year,
       r.constructor_id,
       SUM(r.points) AS top_constructor_pts
FROM   results AS r
JOIN   races   AS ra ON ra.race_id = r.race_id
GROUP  BY ra.year, r.constructor_id
HAVING SUM(r.points) = (
         SELECT MAX(SUM(r2.points))
         FROM   results AS r2
         JOIN   races   AS ra2 ON ra2.race_id = r2.race_id
         WHERE  ra2.year = ra.year
         GROUP  BY r2.constructor_id
       )
ORDER  BY ra.year
LIMIT  20;
```

```sql
-- 7. Highest driver total and highest constructor total side‑by‑side per year
WITH driver_max AS (
    SELECT ra.year,
           MAX(SUM(r.points)) AS max_driver_pts
    FROM   results AS r
    JOIN   races   AS ra ON ra.race_id = r.race_id
    GROUP  BY ra.year, r.driver_id
),
constructor_max AS (
    SELECT ra.year,
           MAX(SUM(r.points)) AS max_constructor_pts
    FROM   results AS r
    JOIN   races   AS ra ON ra.race_id = r.race_id
    GROUP  BY ra.year, r.constructor_id
)
SELECT d.year,
       d.max_driver_pts,
       c.max_constructor_pts,
       d.max_driver_pts + c.max_constructor_pts AS combined_pts
FROM   driver_max      AS d
JOIN   constructor_max AS c ON c.year = d.year
ORDER  BY d.year
LIMIT  20;
```

```sql
-- 8. Same as above but ordered by the combined total (ascending)
WITH driver_max AS (
    SELECT ra.year,
           MAX(SUM(r.points)) AS max_driver_pts
    FROM   results AS r
    JOIN   races   AS ra ON ra.race_id = r.race_id
    GROUP  BY ra.year, r.driver_id
),
constructor_max AS (
    SELECT ra.year,
           MAX(SUM(r.points)) AS max_constructor_pts
    FROM   results AS r
    JOIN   races   AS ra ON ra.race_id = r.race_id
    GROUP  BY ra.year, r.constructor_id
)
SELECT d.year,
       d.max_driver_pts + c.max_constructor_pts AS combined_pts
FROM   driver_max      AS d
JOIN   constructor_max AS c ON c.year = d.year
ORDER  BY combined_pts ASC
LIMIT  20;
```

```sql
-- 9. Show the three seasons with the smallest such combined total
WITH driver_max AS (
    SELECT ra.year,
           MAX(SUM(r.points)) AS max_driver_pts
    FROM   results AS r
    JOIN   races   AS ra ON ra.race_id = r.race_id
    GROUP  BY ra.year, r.driver_id
),
constructor_max AS (
    SELECT ra.year,
           MAX(SUM(r.points)) AS max_constructor_pts
    FROM   results AS r
    JOIN   races   AS ra ON ra.race_id = r.race_id
    GROUP  BY ra.year, r.constructor_id
),
year_totals AS (
    SELECT d.year,
           d.max_driver_pts + c.max_constructor_pts AS combined_pts
    FROM   driver_max      AS d
    JOIN   constructor_max AS c ON c.year = d.year
)
SELECT year, combined_pts
FROM   year_totals
ORDER  BY combined_pts ASC, year ASC
LIMIT  3;
```

```sql
-- 10. Final, concise query – returns exactly the requested list of 3 years
WITH driver_max AS (
    SELECT ra.year,
           MAX(SUM(r.points)) AS max_driver
    FROM   results AS r
    JOIN   races   AS ra ON ra.race_id = r.race_id
    GROUP  BY ra.year, r.driver_id
),
constructor_max AS (
    SELECT ra.year,
           MAX(SUM(r.points)) AS max_constructor
    FROM   results AS r
    JOIN   races   AS ra ON ra.race_id = r.race_id
    GROUP  BY ra.year, r.constructor_id
)
SELECT d.year
FROM   driver_max      AS d
JOIN   constructor_max AS c ON c.year = d.year
ORDER  BY (d.max_driver + c.max_constructor) ASC, d.year ASC
LIMIT  3;
```
Each query is capped with `LIMIT 20` (except the last two, where returning only three rows satisfies that limit) and can be run in order to move from data inspection to the precise answer.
