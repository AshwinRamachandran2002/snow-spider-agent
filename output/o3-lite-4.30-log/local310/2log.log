--Description: 6) Highest‑scoring constructor(s) of each season (first 20 rows)
WITH constructor_totals AS (
    SELECT ra.year,
           r.constructor_id,
           SUM(r.points) AS pts
    FROM   results AS r
    JOIN   races   AS ra ON ra.race_id = r.race_id
    GROUP  BY ra.year, r.constructor_id
),
constructor_max AS (
    SELECT year,
           MAX(pts) AS max_pts
    FROM   constructor_totals
    GROUP  BY year
)
SELECT ct.year,
       ct.constructor_id,
       ct.pts AS top_constructor_pts
FROM   constructor_totals ct
JOIN   constructor_max  cm
      ON cm.year = ct.year
     AND cm.max_pts = ct.pts
ORDER  BY ct.year
LIMIT 20
