```sql
--Description: find the highest‑scoring driver in every season (first 20 seasons listed).
--The query works in three layers bundled into one statement:
--  a) driver_totals  : aggregate points per (year, driver).
--  b) driver_max     : for each year pick the maximum aggregated points.
--  c) final SELECT   : join a) and b) to retain only those driver rows whose
--                      totals equal the annual maximum.
WITH driver_totals AS (
    SELECT r."year",
           res."driver_id",
           SUM(res."points") AS driver_points
    FROM "results" AS res
    JOIN "races"  AS r ON r."race_id" = res."race_id"
    GROUP BY r."year", res."driver_id"
),
driver_max AS (
    SELECT "year",
           MAX(driver_points) AS max_points
    FROM driver_totals
    GROUP BY "year"
)
SELECT dt."year",
       dt."driver_id",
       dt.driver_points
FROM driver_totals AS dt
JOIN driver_max AS dm
  ON dm."year" = dt."year"
 AND dm.max_points = dt.driver_points
ORDER BY dt."year"
LIMIT 20;
```
