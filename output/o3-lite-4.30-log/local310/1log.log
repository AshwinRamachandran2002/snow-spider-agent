--Description: FINAL – the three seasons whose (best driver pts + best constructor pts)
--sum is the smallest, ordered by that combined total then by year.
WITH driver_totals AS (
    SELECT r."year", res."driver_id", SUM(res."points") AS pts
    FROM "results" AS res
    JOIN "races"  AS r ON r."race_id" = res."race_id"
    GROUP BY r."year", res."driver_id"
),
driver_max AS (
    SELECT "year", MAX(pts) AS best_driver_pts
    FROM driver_totals
    GROUP BY "year"
),
constructor_totals AS (
    SELECT r."year", res."constructor_id", SUM(res."points") AS pts
    FROM "results" AS res
    JOIN "races"  AS r ON r."race_id" = res."race_id"
    GROUP BY r."year", res."constructor_id"
),
constructor_max AS (
    SELECT "year", MAX(pts) AS best_constructor_pts
    FROM constructor_totals
    GROUP BY "year"
),
combined AS (
    SELECT dm."year",
           dm.best_driver_pts + cm.best_constructor_pts AS combined_total
    FROM driver_max      AS dm
    JOIN constructor_max AS cm
      ON cm."year" = dm."year"
)
SELECT "year",
       combined_total
FROM combined
ORDER BY combined_total ASC, "year" ASC
LIMIT 3
