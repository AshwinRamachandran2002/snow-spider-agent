Query:
--Description: Highest‑scoring constructor for every season (first 20 seasons listed).
--The pattern mirrors the earlier driver query:
-- 1. constructor_totals : yearly sum of points per constructor.
-- 2. constructor_max    : maximum of those sums per year.
-- 3. Final SELECT       : retain only constructor rows that equal the max.
WITH constructor_totals AS (
    SELECT r."year",
           res."constructor_id",
           SUM(res."points") AS constructor_points
    FROM "results" AS res
    JOIN "races"  AS r ON r."race_id" = res."race_id"
    GROUP BY r."year", res."constructor_id"
),
constructor_max AS (
    SELECT "year",
           MAX(constructor_points) AS max_points
    FROM constructor_totals
    GROUP BY "year"
)
SELECT ct."year",
       ct."constructor_id",
       ct.constructor_points
FROM constructor_totals AS ct
JOIN constructor_max   AS cm
  ON cm."year"       = ct."year"
 AND cm.max_points   = ct.constructor_points
ORDER BY ct."year"
LIMIT 20
