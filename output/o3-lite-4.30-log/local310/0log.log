2025-05-01 03:44:34 - Thread-1612 (execute) - INFO - [Exploration]
Relevant tables and columns                                                  
• results                                                                       
  – race_id : link each result to a particular race (→ season year)            
  – driver_id : identify the driver who scored the points                      
  – constructor_id : identify the constructor that scored the points           
  – points : championship points awarded for that finishing position           

• races                                                                        
  – race_id : primary key, lets us join to results                             
  – year : season year in which the race took place                            

Typical conditions that will be needed                                          
• results."race_id" = races."race_id"               – to obtain the year       
• GROUP BY races."year", results."driver_id"        – to total a driver’s pts  
• GROUP BY races."year", results."constructor_id"   – to total a constructor’s pts  
• MAX(…) OVER (PARTITION BY races."year") or HAVING MAX – to pick the season‑best totals  
• ORDER BY combined_total ASC LIMIT 3             – to isolate three smallest sums  

Exploratory → final SQL queries (LIMIT 20 rows each)                           
```sql
-- 1. Peek at raw results data
SELECT * 
FROM "results" 
LIMIT 20;

-- 2. Peek at races table to see the years we have
SELECT DISTINCT "year"
FROM "races"
ORDER BY "year"
LIMIT 20;

-- 3. Join results to races to see points with the corresponding year
SELECT r."year",
       res."driver_id",
       res."constructor_id",
       res."points"
FROM "results" AS res
JOIN "races"  AS r
  ON res."race_id" = r."race_id"
LIMIT 20;

-- 4. Total points per driver per season
SELECT r."year",
       res."driver_id",
       SUM(res."points") AS driver_pts
FROM "results" AS res
JOIN "races"  AS r
  ON res."race_id" = r."race_id"
GROUP BY r."year", res."driver_id"
ORDER BY r."year", driver_pts DESC
LIMIT 20;

-- 5. Highest‑scoring driver in each season
SELECT t."year",
       t."driver_id",
       MAX(t."driver_pts") AS top_driver_pts
FROM (
     SELECT r."year",
            res."driver_id",
            SUM(res."points") AS driver_pts
     FROM "results" AS res
     JOIN "races"  AS r
       ON res."race_id" = r."race_id"
     GROUP BY r."year", res."driver_id"
) AS t
GROUP BY t."year"
ORDER BY t."year"
LIMIT 20;

-- 6. Total points per constructor per season
SELECT r."year",
       res."constructor_id",
       SUM(res."points") AS team_pts
FROM "results" AS res
JOIN "races"  AS r
  ON res."race_id" = r."race_id"
GROUP BY r."year", res."constructor_id"
ORDER BY r."year", team_pts DESC
LIMIT 20;

-- 7. Highest‑scoring constructor in each season
SELECT t."year",
       t."constructor_id",
       MAX(t."team_pts") AS top_team_pts
FROM (
     SELECT r."year",
            res."constructor_id",
            SUM(res."points") AS team_pts
     FROM "results" AS res
     JOIN "races"  AS r
       ON res."race_id" = r."race_id"
     GROUP BY r."year", res."constructor_id"
) AS t
GROUP BY t."year"
ORDER BY t."year"
LIMIT 20;

-- 8. Combine the two season‑best numbers
WITH best_driver AS (
     SELECT r."year",
            SUM(res."points")  AS top_driver_pts
     FROM "results" AS res
     JOIN "races"  AS r
       ON res."race_id" = r."race_id"
     GROUP BY r."year", res."driver_id"
), best_driver_max AS (
     SELECT "year", MAX(top_driver_pts) AS top_driver_pts
     FROM best_driver
     GROUP BY "year"
), best_team AS (
     SELECT r."year",
            SUM(res."points")  AS top_team_pts
     FROM "results" AS res
     JOIN "races"  AS r
       ON res."race_id" = r."race_id"
     GROUP BY r."year", res."constructor_id"
), best_team_max AS (
     SELECT "year", MAX(top_team_pts) AS top_team_pts
     FROM best_team
     GROUP BY "year"
)
SELECT d."year",
       d."top_driver_pts",
       t."top_team_pts"
FROM best_driver_max AS d
JOIN best_team_max  AS t
  ON d."year" = t."year"
ORDER BY d."year"
LIMIT 20;

-- 9. Add the two numbers together for each season
WITH best_driver AS (
     SELECT r."year",
            SUM(res."points") AS driver_pts
     FROM "results" AS res
     JOIN "races"  AS r
       ON res."race_id" = r."race_id"
     GROUP BY r."year", res."driver_id"
), driver_max AS (
     SELECT "year", MAX(driver_pts) AS top_driver_pts
     FROM best_driver
     GROUP BY "year"
), best_team AS (
     SELECT r."year",
            SUM(res."points") AS team_pts
     FROM "results" AS res
     JOIN "races"  AS r
       ON res."race_id" = r."race_id"
     GROUP BY r."year", res."constructor_id"
), team_max AS (
     SELECT "year", MAX(team_pts) AS top_team_pts
     FROM best_team
     GROUP BY "year"
)
SELECT d."year",
       d."top_driver_pts" + t."top_team_pts" AS combined_top_pts
FROM driver_max AS d
JOIN team_max   AS t
  ON d."year" = t."year"
ORDER BY combined_top_pts ASC
LIMIT 20;

-- 10. Three seasons with the smallest combined total
WITH best_driver AS (
     SELECT r."year",
            SUM(res."points") AS driver_pts
     FROM "results" AS res
     JOIN "races"  AS r
       ON res."race_id" = r."race_id"
     GROUP BY r."year", res."driver_id"
), driver_max AS (
     SELECT "year", MAX(driver_pts) AS top_driver_pts
     FROM best_driver
     GROUP BY "year"
), best_team AS (
     SELECT r."year",
            SUM(res."points") AS team_pts
     FROM "results" AS res
     JOIN "races"  AS r
       ON res."race_id" = r."race_id"
     GROUP BY r."year", res."constructor_id"
), team_max AS (
     SELECT "year", MAX(team_pts) AS top_team_pts
     FROM best_team
     GROUP BY "year"
)
SELECT d."year",
       d."top_driver_pts",
       t."top_team_pts",
       d."top_driver_pts" + t."top_team_pts" AS combined_top_pts
FROM driver_max AS d
JOIN team_max   AS t
  ON d."year" = t."year"
ORDER BY combined_top_pts ASC, d."year"
LIMIT 3;
```
