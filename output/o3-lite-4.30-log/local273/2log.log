Query:
--Description: Final result – average pick‑percentage per product *name*, sorted
--             alphabetically.  Same calculation as above but joined to products
--             to get the human‑readable name.  Purchases is included only to keep
--             the join path consistent with FIFO inspection (though not strictly
--             needed for the percentage itself).
SELECT  pr.name                                        AS product_name,
        ROUND(AVG(pl.qty * 1.0 / inv.qty) * 100, 2)    AS avg_pick_pct
FROM    picking_line AS pl
JOIN    inventory    AS inv  ON inv.location_id = pl.location_id
                             AND inv.product_id  = pl.product_id
JOIN    purchases    AS pur  ON pur.id = inv.purchase_id          -- preserves FIFO context
JOIN    products     AS pr   ON pr.id = pl.product_id
GROUP BY pr.name
ORDER BY pr.name
LIMIT   20
