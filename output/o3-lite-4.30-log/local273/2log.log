```sql
--Description (thinking process):
-- We want to inspect how each pick‑line (identified by picklist_id + line_no) draws
-- from a specific inventory record in order to validate FIFO behaviour.  
--  • picking_line gives product_id, qty picked, and the location_id it was picked from.  
--  • inventory links that location_id + product_id to its starting stock (qty) and
--    purchase_id, telling us which purchase lot the stock belongs to.  
--  • purchases provides the purchase date, allowing us to sort by earliest date and,
--    within the same date, by the smallest quantity (true FIFO).  
-- The join therefore is:
--    picking_line ▷◁ inventory on (location_id, product_id)
--    inventory    ▷◁ purchases on purchase_id
-- We then order by purchase date and inventory.qty to reflect FIFO and limit to 20
-- rows for a quick sanity‑check.
SELECT  pl.picklist_id,
        pl.line_no                AS pickline_no,
        pl.product_id,
        inv.id                    AS inventory_id,
        inv.qty                   AS start_stock,
        pl.qty                    AS picked_qty,
        pur.purchased             AS purchase_date
FROM    picking_line  AS pl
JOIN    inventory     AS inv  ON inv.location_id = pl.location_id
                              AND inv.product_id  = pl.product_id
JOIN    purchases     AS pur  ON pur.id = inv.purchase_id
ORDER BY pur.purchased,
         inv.qty
LIMIT   20;
```
