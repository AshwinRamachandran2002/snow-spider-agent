```sql
--Description: Compute the pick‑percentage (= picked_qty / starting_stock) for each individual
--             pick‑line.  Since picking_line has no single “id” column, the unique key is
--             (picklist_id, line_no).  We therefore output those two columns to identify the
--             pick.  The percentage is rounded to two decimals.
SELECT  pl.picklist_id,
        pl.line_no               AS pickline_no,
        pl.product_id,
        ROUND(100.0 * pl.qty / inv.qty, 2)  AS pick_pct
FROM    picking_line AS pl
JOIN    inventory    AS inv  ON inv.location_id = pl.location_id
                             AND inv.product_id  = pl.product_id
LIMIT   20;
```

```sql
--Description: Verify FIFO for one product (here: 6520) by listing every inventory lot’s
--             purchase date and quantity, ordered first by the earliest purchase date and
--             then by the smallest quantity available in that lot.
SELECT  inv.product_id,
        pur.purchased,
        inv.qty
FROM    inventory  AS inv
JOIN    purchases  AS pur  ON pur.id = inv.purchase_id
WHERE   inv.product_id = 6520
ORDER BY pur.purchased,
         inv.qty
LIMIT   20;
```

```sql
--Description: Average pick‑percentage per product_id (ignoring the product name for now).
--             For each pick‑line we take picked_qty / start_stock, then average over all
--             pick‑lines belonging to the same product.
SELECT  pl.product_id,
        ROUND(AVG(pl.qty * 1.0 / inv.qty) * 100, 2)  AS avg_pick_pct
FROM    picking_line AS pl
JOIN    inventory    AS inv  ON inv.location_id = pl.location_id
                             AND inv.product_id  = pl.product_id
GROUP BY pl.product_id
LIMIT   20;
```

```sql
--Description: Final result – average pick‑percentage per product *name*, sorted
--             alphabetically.  Same calculation as above but joined to products
--             to get the human‑readable name.  Purchases is included only to keep
--             the join path consistent with FIFO inspection (though not strictly
--             needed for the percentage itself).
SELECT  pr.name                                        AS product_name,
        ROUND(AVG(pl.qty * 1.0 / inv.qty) * 100, 2)    AS avg_pick_pct
FROM    picking_line AS pl
JOIN    inventory    AS inv  ON inv.location_id = pl.location_id
                             AND inv.product_id  = pl.product_id
JOIN    purchases    AS pur  ON pur.id = inv.purchase_id          -- preserves FIFO context
JOIN    products     AS pr   ON pr.id = pl.product_id
GROUP BY pr.name
ORDER BY pr.name
LIMIT   20;
```
