--Description: Compute the pick‑percentage (= picked_qty / starting_stock) for each individual
--             pick‑line.  Since picking_line has no single “id” column, the unique key is
--             (picklist_id, line_no).  We therefore output those two columns to identify the
--             pick.  The percentage is rounded to two decimals.
SELECT  pl.picklist_id,
        pl.line_no               AS pickline_no,
        pl.product_id,
        ROUND(100.0 * pl.qty / inv.qty, 2)  AS pick_pct
FROM    picking_line AS pl
JOIN    inventory    AS inv  ON inv.location_id = pl.location_id
                             AND inv.product_id  = pl.product_id
