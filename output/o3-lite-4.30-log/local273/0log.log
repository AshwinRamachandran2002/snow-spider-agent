```sql
WITH ordered AS (          -- total quantity requested per order & product
    SELECT
        "order_id",
        "product_id",
        SUM("qty") AS ordered_qty
    FROM "orderlines"
    GROUP BY "order_id", "product_id"
),

picked AS (                -- quantity that was actually picked (FIFO already recorded)
    SELECT
        "order_id",
        "product_id",
        SUM("qty") AS picked_qty
    FROM "picking_line"
    GROUP BY "order_id", "product_id"
),

order_vs_pick AS (         -- merge ordered and picked quantities
    SELECT
        o."product_id",
        o.ordered_qty,
        COALESCE(p.picked_qty, 0) AS picked_qty
    FROM ordered o
    LEFT JOIN picked p
      ON p."order_id"  = o."order_id"
     AND p."product_id" = o."product_id"
),

percentages AS (           -- pick‑percentage for every order–product pair
    SELECT
        product_id,
        CASE
            WHEN ordered_qty = 0 THEN 0.0
            ELSE picked_qty * 1.0 / ordered_qty
        END AS pick_pct
    FROM order_vs_pick
)

SELECT
    pr."name"                                   AS product_name,
    ROUND(AVG(pick_pct) * 100, 4)               AS average_pick_percentage
FROM percentages AS pc
JOIN "products"  AS pr
  ON pr."id" = pc."product_id"
GROUP BY pr."name"
ORDER BY pr."name";
```
