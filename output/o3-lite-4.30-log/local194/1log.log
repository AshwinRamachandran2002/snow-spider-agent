Successfully corrected. SQL:
--Description: Find, for every actor, the TOP‑3 money‑making films (based on total film
--             revenue that we split equally among all actors in that film) and show:
--                 • the actor‑film revenue share
--                 • the actor’s average share across those three films
--             Logical path
--               1. film_rev  : total revenue by film (payment → rental → inventory).
--               2. actor_cnt : number of actors in each film (film_actor).
--               3. rev_share : actor‑film rows with equal revenue share.
--               4. ranked    : rank those rows per actor, keep only the best three.
--               5. avg3      : compute each actor’s average of the three shares.
--               6. Final SELECT joins names and returns ≤3 rows per actor plus the avg.
WITH film_rev AS (                 -- 1. total $ per film
    SELECT i.film_id,
           SUM(p.amount) AS total_revenue
    FROM payment  p
    JOIN rental   r ON p.rental_id   = r.rental_id
    JOIN inventory i ON r.inventory_id = i.inventory_id
    GROUP BY i.film_id
),
actor_cnt AS (                     -- 2. #actors per film
    SELECT film_id,
           COUNT(*) AS num_actors
    FROM film_actor
    GROUP BY film_id
),
rev_share AS (                     -- 3. actor’s equal share
    SELECT fa.actor_id,
           fa.film_id,
           fr.total_revenue * 1.0 / ac.num_actors AS revenue_share
    FROM film_actor fa
    JOIN film_rev  fr ON fa.film_id = fr.film_id
    JOIN actor_cnt ac ON fa.film_id = ac.film_id
),
ranked AS (                        -- 4. top‑3 per actor
    SELECT rs.*,
           ROW_NUMBER() OVER (PARTITION BY actor_id
                              ORDER BY revenue_share DESC) AS rn
    FROM rev_share rs
),
avg3 AS (                          -- 5. average of actor’s top‑3
    SELECT actor_id,
           AVG(revenue_share) AS avg_top3_revenue
    FROM ranked
    WHERE rn <= 3
    GROUP BY actor_id
)
-- 6. final output
SELECT  a.actor_id,
        a.first_name || ' ' || a.last_name AS actor_name,
        f.film_id,
        f.title,
        r.revenue_share,
        ag.avg_top3_revenue
FROM ranked r
JOIN actor a ON r.actor_id = a.actor_id
JOIN film  f ON r.film_id  = f.film_id
JOIN avg3  ag ON r.actor_id = ag.actor_id
WHERE r.rn <= 3
ORDER BY a.actor_id, r.revenue_share DESC
LIMIT 100;
