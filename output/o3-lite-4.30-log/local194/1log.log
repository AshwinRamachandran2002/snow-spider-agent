Begin Exploring Related Columns
Relevant columns and their potential usages
• actor.actor_id: primary key for each actor, allows matching to film_actor  
• actor.first_name / actor.last_name: display actor’s name in final output  
• film.film_id: primary key for each film, used to link to inventory and film_actor  
• film.title: film name to show in result set  
• film_actor.film_id: links an actor to a film  
• film_actor.actor_id: links a film to an actor  
• payment.amount: revenue amount received from a rental transaction  
• payment.rental_id ↔ rental.rental_id: joins a payment to the corresponding rental  
• rental.inventory_id ↔ inventory.inventory_id: joins a rental to a physical film copy  
• inventory.film_id: tells which film the inventory item belongs to  
Conditions / joins that may be used  
• film_actor.actor_id  = actor.actor_id  
• film_actor.film_id   = film.film_id  
• inventory.film_id    = film.film_id  
• rental.inventory_id  = inventory.inventory_id  
• payment.rental_id    = rental.rental_id  

Exploratory & build‑up SQL queries  
```sql
-- 1) Basic look at actor table
SELECT DISTINCT actor_id, first_name, last_name
FROM actor
LIMIT 20;
```

```sql
-- 2) Basic look at film titles and ids
SELECT DISTINCT film_id, title
FROM film
LIMIT 20;
```

```sql
-- 3) How many actors appear in each film?
SELECT film_id, COUNT(*) AS actor_cnt
FROM film_actor
GROUP BY film_id
LIMIT 20;
```

```sql
-- 4) Inspect individual payment rows (revenue) with rental_ids
SELECT payment_id, rental_id, amount
FROM payment
LIMIT 20;
```

```sql
-- 5) Map a few payments to the films they belong to
SELECT p.payment_id, p.amount, i.film_id, f.title
FROM payment AS p
JOIN rental   AS r ON p.rental_id   = r.rental_id
JOIN inventory AS i ON r.inventory_id = i.inventory_id
JOIN film      AS f ON i.film_id      = f.film_id
LIMIT 20;
```

```sql
-- 6) Aggregate total revenue per film
SELECT i.film_id, f.title, SUM(p.amount) AS film_revenue
FROM payment  AS p
JOIN rental   AS r ON p.rental_id   = r.rental_id
JOIN inventory AS i ON r.inventory_id = i.inventory_id
JOIN film      AS f ON i.film_id      = f.film_id
GROUP BY i.film_id
ORDER BY film_revenue DESC
LIMIT 20;
```

```sql
-- 7) Combine revenue and actor count for each film
SELECT fr.film_id,
       fr.film_revenue,
       fa.actor_cnt,
       (fr.film_revenue * 1.0) / fa.actor_cnt AS revenue_per_actor
FROM (
    SELECT i.film_id, SUM(p.amount) AS film_revenue
    FROM payment AS p
    JOIN rental   AS r ON p.rental_id   = r.rental_id
    JOIN inventory AS i ON r.inventory_id = i.inventory_id
    GROUP BY i.film_id
) AS fr
JOIN (
    SELECT film_id, COUNT(*) AS actor_cnt
    FROM film_actor
    GROUP BY film_id
) AS fa  ON fr.film_id = fa.film_id
LIMIT 20;
```

```sql
-- 8) Attach actors to their revenue share in each film
SELECT a.actor_id,
       a.first_name || ' ' || a.last_name AS actor_name,
       f.film_id,
       f.title,
       x.revenue_per_actor
FROM (
    SELECT fr.film_id,
           fr.revenue_per_actor
    FROM (
        SELECT i.film_id, SUM(p.amount) AS film_revenue
        FROM payment AS p
        JOIN rental   AS r ON p.rental_id   = r.rental_id
        JOIN inventory AS i ON r.inventory_id = i.inventory_id
        GROUP BY i.film_id
    ) AS fr
    JOIN (
        SELECT film_id, COUNT(*) AS actor_cnt
        FROM film_actor
        GROUP BY film_id
    ) AS fa ON fr.film_id = fa.film_id
) AS x
JOIN film_actor  AS fa2 ON x.film_id = fa2.film_id
JOIN actor       AS a   ON fa2.actor_id = a.actor_id
JOIN film        AS f   ON x.film_id = f.film_id
LIMIT 20;
```

```sql
-- 9) Rank films for each actor by the revenue he/she earned
WITH revenue_per_film AS (
    SELECT i.film_id, SUM(p.amount) AS film_revenue
    FROM payment AS p
    JOIN rental   AS r ON p.rental_id   = r.rental_id
    JOIN inventory AS i ON r.inventory_id = i.inventory_id
    GROUP BY i.film_id
),
actor_cnt AS (
    SELECT film_id, COUNT(*) AS actor_cnt
    FROM film_actor
    GROUP BY film_id
),
revenue_per_actor AS (
    SELECT fa.actor_id,
           fa.film_id,
           (rf.film_revenue * 1.0) / ac.actor_cnt AS revenue_share
    FROM film_actor  AS fa
    JOIN revenue_per_film AS rf ON fa.film_id = rf.film_id
    JOIN actor_cnt      AS ac ON fa.film_id = ac.film_id
)
SELECT rpa.*,
       ROW_NUMBER() OVER (PARTITION BY actor_id ORDER BY revenue_share DESC) AS rn
FROM revenue_per_actor AS rpa
LIMIT 20;
```

```sql
-- 10) Final answer: top 3 revenue‑generating films for each actor and the average revenue per actor
WITH revenue_per_film AS (
    SELECT i.film_id, SUM(p.amount) AS film_revenue
    FROM payment AS p
    JOIN rental   AS r ON p.rental_id   = r.rental_id
    JOIN inventory AS i ON r.inventory_id = i.inventory_id
    GROUP BY i.film_id
),
actor_cnt AS (
    SELECT film_id, COUNT(*) AS actor_cnt
    FROM film_actor
    GROUP BY film_id
),
revenue_per_actor AS (
    SELECT fa.actor_id,
           fa.film_id,
           (rf.film_revenue * 1.0) / ac.actor_cnt AS revenue_share
    FROM film_actor  AS fa
    JOIN revenue_per_film AS rf ON fa.film_id = rf.film_id
    JOIN actor_cnt      AS ac ON fa.film_id = ac.film_id
),
ranked AS (
    SELECT rpa.*,
           ROW_NUMBER() OVER (PARTITION BY actor_id ORDER BY revenue_share DESC) AS rn
    FROM revenue_per_actor AS rpa
)
SELECT a.actor_id,
       a.first_name || ' ' || a.last_name AS actor_name,
       f.film_id,
       f.title,
       r.revenue_share
FROM ranked AS r
JOIN actor AS a ON r.actor_id = a.actor_id
JOIN film  AS f ON r.film_id  = f.film_id
WHERE r.rn <= 3
ORDER BY a.actor_id, r.revenue_share DESC
LIMIT 100;
```
