Query:
--Description: Final answer – list each actor’s TOP‑3 revenue‑generating films and the
--             actor’s average revenue share across those three films.
--             Logic:
--               1. revenue_per_film : total revenue per film.
--               2. actor_cnt        : cast size per film.
--               3. revenue_per_actor: equal share for each actor‑film.
--               4. ranked           : rank films per actor by share, keep best three.
--               5. avg_top3         : average of those top three shares per actor.
--               6. Final SELECT     : return ≤3 rows per actor with the average column.
WITH revenue_per_film AS (      -- 1
    SELECT i.film_id,
           SUM(p.amount) AS film_revenue
    FROM payment  p
    JOIN rental   r ON p.rental_id   = r.rental_id
    JOIN inventory i ON r.inventory_id = i.inventory_id
    GROUP BY i.film_id
),
actor_cnt AS (                  -- 2
    SELECT film_id,
           COUNT(*) AS actor_cnt
    FROM film_actor
    GROUP BY film_id
),
revenue_per_actor AS (          -- 3
    SELECT fa.actor_id,
           fa.film_id,
           rf.film_revenue * 1.0 / ac.actor_cnt AS revenue_share
    FROM film_actor fa
    JOIN revenue_per_film rf ON fa.film_id = rf.film_id
    JOIN actor_cnt       ac ON fa.film_id = ac.film_id
),
ranked AS (                     -- 4
    SELECT rpa.*,
           ROW_NUMBER() OVER (PARTITION BY actor_id
                              ORDER BY revenue_share DESC) AS rn
    FROM revenue_per_actor rpa
),
avg_top3 AS (                   -- 5
    SELECT actor_id,
           AVG(revenue_share) AS avg_revenue_top3
    FROM ranked
    WHERE rn <= 3
    GROUP BY actor_id
)
-- 6. Output
SELECT  a.actor_id,
        a.first_name || ' ' || a.last_name AS actor_name,
        f.film_id,
        f.title,
        r.revenue_share,
        at.avg_revenue_top3
FROM ranked r
JOIN actor    a  ON r.actor_id = a.actor_id
JOIN film     f  ON r.film_id  = f.film_id
JOIN avg_top3 at ON r.actor_id = at.actor_id
WHERE r.rn <= 3
ORDER BY a.actor_id, r.revenue_share DESC
LIMIT 100
