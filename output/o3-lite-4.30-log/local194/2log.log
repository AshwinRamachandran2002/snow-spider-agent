Query:
-- 7. Description: Combine revenue and actor count, derive revenue‑per‑actor
WITH film_rev AS (
    SELECT i."film_id",
           SUM(p."amount") AS "film_revenue"
    FROM   "payment"  AS p
    JOIN   "rental"   AS r ON r."rental_id"   = p."rental_id"
    JOIN   "inventory"AS i ON i."inventory_id"= r."inventory_id"
    GROUP  BY i."film_id"
),
actor_cnt AS (
    SELECT "film_id",
           COUNT("actor_id") AS "actor_cnt"
    FROM   "film_actor"
    GROUP  BY "film_id"
)
SELECT f."film_id",
       f."title",
       fr."film_revenue",
       ac."actor_cnt",
       ROUND(fr."film_revenue" * 1.0 / ac."actor_cnt", 2) AS "revenue_per_actor"
FROM   "film" AS f
JOIN   film_rev AS fr ON fr."film_id" = f."film_id"
JOIN   actor_cnt AS ac ON ac."film_id" = f."film_id"
ORDER  BY fr."film_revenue" DESC
LIMIT  20;
