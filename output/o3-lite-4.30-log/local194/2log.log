2025-05-01 03:27:13 - Thread-1422 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
• payment.amount: revenue that each rental contributed to the film’s income  
• payment.rental_id ↔ rental.rental_id: link every payment to the corresponding rental  
• rental.inventory_id ↔ inventory.inventory_id: link the rental to a physical copy of a film  
• inventory.film_id ↔ film.film_id: identify which film that inventory item belongs to  
• film.title / film.film_id: film name & primary key to aggregate revenue by film  
• film_actor.film_id ↔ film.film_id: connect a film to all its actors  
• film_actor.actor_id ↔ actor.actor_id: connect actors to the films they acted in  
• actor.first_name / actor.last_name: show actor’s full name for the result set  

Typical join / filter conditions that will be used  
payment.rental_id = rental.rental_id  
rental.inventory_id = inventory.inventory_id  
inventory.film_id     = film.film_id  
film.film_id           = film_actor.film_id  
film_actor.actor_id    = actor.actor_id  


Below are ten exploratory SQLite queries (from simple inspection to the final ranking) that help confirm values and logic.  
Every query is limited to 20 rows and wrapped in back‑ticks for copy‑paste.

```sql
-- 1. Description: List a few actors to see the naming convention
SELECT DISTINCT "actor_id",
       "first_name",
       "last_name"
FROM   "actor"
LIMIT  20;
```

```sql
-- 2. Description: Inspect some film titles and ids
SELECT DISTINCT "film_id",
       "title"
FROM   "film"
LIMIT  20;
```

```sql
-- 3. Description: Glimpse at raw payment rows and amounts
SELECT DISTINCT "payment_id",
       "rental_id",
       "amount"
FROM   "payment"
LIMIT  20;
```

```sql
-- 4. Description: Show actor‑film combinations (who played in what)
SELECT DISTINCT fa."actor_id",
       a."first_name" || ' ' || a."last_name" AS "actor_name",
       fa."film_id"
FROM   "film_actor" AS fa
JOIN   "actor"      AS a  ON a."actor_id" = fa."actor_id"
LIMIT  20;
```

```sql
-- 5. Description: Compute total revenue per film (first 20)
SELECT       f."film_id",
             f."title",
             SUM(p."amount") AS "film_revenue"
FROM         "payment"  AS p
JOIN         "rental"   AS r  ON r."rental_id"   = p."rental_id"
JOIN         "inventory"AS i  ON i."inventory_id"= r."inventory_id"
JOIN         "film"     AS f  ON f."film_id"     = i."film_id"
GROUP BY     f."film_id", f."title"
ORDER BY     "film_revenue" DESC
LIMIT        20;
```

```sql
-- 6. Description: Count actors appearing in each film (first 20 films)
SELECT       f."film_id",
             f."title",
             COUNT(fa."actor_id") AS "actor_cnt"
FROM         "film"       AS f
JOIN         "film_actor" AS fa ON fa."film_id" = f."film_id"
GROUP BY     f."film_id", f."title"
ORDER BY     f."film_id"
LIMIT        20;
```

```sql
-- 7. Description: Combine revenue and actor count, derive revenue‑per‑actor
WITH film_rev AS (
    SELECT i."film_id",
           SUM(p."amount") AS "film_revenue"
    FROM   "payment"  AS p
    JOIN   "rental"   AS r ON r."rental_id"   = p."rental_id"
    JOIN   "inventory"AS i ON i."inventory_id"= r."inventory_id"
    GROUP  BY i."film_id"
),
actor_cnt AS (
    SELECT "film_id",
           COUNT("actor_id") AS "actor_cnt"
    FROM   "film_actor"
    GROUP  BY "film_id"
)
SELECT f."film_id",
       f."title",
       fr."film_revenue",
       ac."actor_cnt",
       ROUND(fr."film_revenue" * 1.0 / ac."actor_cnt", 2) AS "revenue_per_actor"
FROM   "film" AS f
JOIN   film_rev AS fr ON fr."film_id" = f."film_id"
JOIN   actor_cnt AS ac ON ac."film_id" = f."film_id"
ORDER  BY fr."film_revenue" DESC
LIMIT  20;
```

```sql
-- 8. Description: Attach each actor to every film they acted in and compute the actor’s share
WITH film_rev AS (
    SELECT i."film_id",
           SUM(p."amount") AS "film_revenue"
    FROM   "payment"  AS p
    JOIN   "rental"   AS r ON r."rental_id"   = p."rental_id"
    JOIN   "inventory"AS i ON i."inventory_id"= r."inventory_id"
    GROUP  BY i."film_id"
),
actor_cnt AS (
    SELECT "film_id",
           COUNT("actor_id") AS "actor_cnt"
    FROM   "film_actor"
    GROUP  BY "film_id"
)
SELECT   fa."actor_id",
         a."first_name" || ' ' || a."last_name" AS "actor_name",
         f."film_id",
         f."title",
         fr."film_revenue",
         ROUND(fr."film_revenue" * 1.0 / ac."actor_cnt", 2) AS "revenue_per_actor"
FROM     "film_actor" AS fa
JOIN     "actor"      AS a  ON a."actor_id"  = fa."actor_id"
JOIN     "film"       AS f  ON f."film_id"   = fa."film_id"
JOIN     film_rev     AS fr ON fr."film_id"  = f."film_id"
JOIN     actor_cnt    AS ac ON ac."film_id"  = f."film_id"
LIMIT    20;
```

```sql
-- 9. Description: Rank films by total revenue for each actor
WITH film_rev AS (
    SELECT i."film_id", SUM(p."amount") AS "film_revenue"
    FROM   "payment" AS p
    JOIN   "rental"  AS r ON r."rental_id" = p."rental_id"
    JOIN   "inventory" AS i ON i."inventory_id" = r."inventory_id"
    GROUP  BY i."film_id"
),
actor_cnt AS (
    SELECT "film_id", COUNT("actor_id") AS "actor_cnt"
    FROM   "film_actor"
    GROUP  BY "film_id"
),
actor_film AS (
    SELECT fa."actor_id",
           f."film_id",
           fr."film_revenue",
           ac."actor_cnt",
           ROUND(fr."film_revenue" * 1.0 / ac."actor_cnt", 2) AS "revenue_per_actor"
    FROM   "film_actor" AS fa
    JOIN   film_rev     AS fr ON fr."film_id" = fa."film_id"
    JOIN   actor_cnt    AS ac ON ac."film_id" = fa."film_id"
    JOIN   "film"       AS f  ON f."film_id"  = fa."film_id"
)
SELECT  af.*,
        ROW_NUMBER() OVER (PARTITION BY af."actor_id"
                           ORDER BY af."film_revenue" DESC) AS "rnk"
FROM    actor_film AS af
LIMIT   20;
```

```sql
-- 10. Description: Final answer layout – top 3 revenue‑generating films per actor
WITH film_rev AS (
    SELECT i."film_id", SUM(p."amount") AS "film_revenue"
    FROM   "payment" AS p
    JOIN   "rental"  AS r ON r."rental_id" = p."rental_id"
    JOIN   "inventory" AS i ON i."inventory_id" = r."inventory_id"
    GROUP  BY i."film_id"
),
actor_cnt AS (
    SELECT "film_id", COUNT("actor_id") AS "actor_cnt"
    FROM   "film_actor"
    GROUP  BY "film_id"
),
actor_film AS (
    SELECT fa."actor_id",
           a."first_name" || ' ' || a."last_name" AS "actor_name",
           f."title"                                AS "film_title",
           fr."film_revenue",
           ROUND(fr."film_revenue" * 1.0 / ac."actor_cnt", 2) AS "revenue_per_actor"
    FROM   "film_actor" AS fa
    JOIN   "actor"      AS a  ON a."actor_id"  = fa."actor_id"
    JOIN   "film"       AS f  ON f."film_id"   = fa."film_id"
    JOIN   film_rev     AS fr ON fr."film_id"  = f."film_id"
    JOIN   actor_cnt    AS ac ON ac."film_id"  = f."film_id"
),
ranked AS (
    SELECT af.*,
           ROW_NUMBER() OVER (PARTITION BY af."actor_id"
                              ORDER BY af."film_revenue" DESC) AS "rnk"
    FROM   actor_film AS af
)
SELECT "actor_id",
       "actor_name",
       "film_title",
       "film_revenue",
       "revenue_per_actor"
FROM   ranked
WHERE  "rnk" <= 3
ORDER  BY "actor_id", "rnk"
LIMIT  20;
```

These queries progressively examine the data and culminate in producing, for every actor, his or her three highest‑grossing films together with the revenue share each actor would receive when the film’s total revenue is divided evenly among its cast.
