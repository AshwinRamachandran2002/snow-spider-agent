           f."film_id",
           fr."film_revenue",
           ac."actor_cnt",
           ROUND(fr."film_revenue" * 1.0 / ac."actor_cnt", 2) AS "revenue_per_actor"
    FROM   "film_actor" AS fa
    JOIN   film_rev     AS fr ON fr."film_id" = fa."film_id"
    JOIN   actor_cnt    AS ac ON ac."film_id" = fa."film_id"
    JOIN   "film"       AS f  ON f."film_id"  = fa."film_id"
)
SELECT  af.*,
        ROW_NUMBER() OVER (PARTITION BY af."actor_id"
                           ORDER BY af."film_revenue" DESC) AS "rnk"
FROM    actor_film AS af
LIMIT   20;
```

```sql
-- 10. Description: Final answer layout – top 3 revenue‑generating films per actor
WITH film_rev AS (
    SELECT i."film_id", SUM(p."amount") AS "film_revenue"
    FROM   "payment" AS p
    JOIN   "rental"  AS r ON r."rental_id" = p."rental_id"
    JOIN   "inventory" AS i ON i."inventory_id" = r."inventory_id"
