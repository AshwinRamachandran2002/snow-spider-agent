),
actor_film AS (
    SELECT fa."actor_id",
           a."first_name" || ' ' || a."last_name" AS "actor_name",
           f."title"                                AS "film_title",
           fr."film_revenue",
           ROUND(fr."film_revenue" * 1.0 / ac."actor_cnt", 2) AS "revenue_per_actor"
    FROM   "film_actor" AS fa
    JOIN   "actor"      AS a  ON a."actor_id"  = fa."actor_id"
    JOIN   "film"       AS f  ON f."film_id"   = fa."film_id"
    JOIN   film_rev     AS fr ON fr."film_id"  = f."film_id"
    JOIN   actor_cnt    AS ac ON ac."film_id"  = f."film_id"
),
ranked AS (
    SELECT af.*,
           ROW_NUMBER() OVER (PARTITION BY af."actor_id"
                              ORDER BY af."film_revenue" DESC) AS "rnk"
    FROM   actor_film AS af
)
SELECT "actor_id",
       "actor_name",
       "film_title",
       "film_revenue",
       "revenue_per_actor"
FROM   ranked
WHERE  "rnk" <= 3
ORDER  BY "actor_id", "rnk"
LIMIT  20;
```

