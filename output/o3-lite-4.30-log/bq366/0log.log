2025-05-01 02:18:47 - Thread-784 (execute) - INFO - [Exploration]
Relevant columns and how they will be used  

• objects.object_id : join‐key that uniquely identifies every artwork  
• objects.period     : historical period for each artwork (the “group by” field)  
• vision_api_data.object_id : join‐key coming from Vision API output  
• vision_api_data.labelAnnotations.description : text label Google Vision assigned to the artwork image  
• (unnest(labelAnnotations) AS l) : turns the repeated field into rows so we can count labels  

Typical conditions / manipulations  

• JOIN `bigquery-public-data.the_met.objects`  o  
       ON o.object_id = v.object_id  
• WHERE o.period IS NOT NULL                             -- ignore artworks with no stated period  
• UNNEST(v.labelAnnotations) AS l                        -- explode labels  
• GROUP BY o.period , l.description                      -- count labels per period  
• HAVING COUNT(DISTINCT o.object_id) >= 500              -- keep labels appearing on ≥500 artworks  
• QUALIFY ROW_NUMBER() OVER (PARTITION BY o.period 
                             ORDER BY cnt DESC) <= 3      -- keep the top‑3 labels per period  



Below are ten exploratory queries (from very simple to the final answer) that progressively build up to the required result.  
Each is limited to 20 rows so it can be run safely in the UI.

```sql
-- 1. Quick peek at artworks and their periods
SELECT object_id, title, period
FROM `bigquery-public-data.the_met.objects`
WHERE period IS NOT NULL
LIMIT 20;
```

```sql
-- 2. List distinct historical periods that exist in the collection
SELECT DISTINCT period
FROM `bigquery-public-data.the_met.objects`
WHERE period IS NOT NULL
ORDER BY period
LIMIT 20;
```

```sql
-- 3. Inspect raw Vision‑API labelAnnotation records for a few objects
SELECT object_id, labelAnnotations
FROM `bigquery-public-data.the_met.vision_api_data`
LIMIT 20;
```

```sql
-- 4. Unnest labelAnnotations to see individual label descriptions
SELECT v.object_id,
       l.description AS label
FROM   `bigquery-public-data.the_met.vision_api_data` v,
       UNNEST(v.labelAnnotations) AS l
LIMIT 20;
```

```sql
-- 5. Overall popularity of labels (number of artworks each appears in)
SELECT l.description AS label,
       COUNT(DISTINCT v.object_id) AS artworks
FROM   `bigquery-public-data.the_met.vision_api_data` v,
       UNNEST(v.labelAnnotations) AS l
GROUP  BY label
ORDER  BY artworks DESC
LIMIT 20;
```

```sql
-- 6. Sample join: connect an artwork’s period with each of its labels
SELECT o.object_id,
       o.period,
       l.description AS label
FROM   `bigquery-public-data.the_met.objects`        o
JOIN   `bigquery-public-data.the_met.vision_api_data` v
       ON o.object_id = v.object_id,
       UNNEST(v.labelAnnotations) AS l
WHERE  o.period IS NOT NULL
LIMIT 20;
```

```sql
-- 7. Count how many artworks belong to each (period, label) pair
SELECT o.period,
       l.description AS label,
       COUNT(DISTINCT o.object_id) AS artworks
FROM   `bigquery-public-data.the_met.objects`        o
JOIN   `bigquery-public-data.the_met.vision_api_data` v
       ON o.object_id = v.object_id,
       UNNEST(v.labelAnnotations) AS l
WHERE  o.period IS NOT NULL
GROUP  BY o.period, label
ORDER  BY artworks DESC
LIMIT 20;
```

```sql
-- 8. Keep only labels linked to ≥500 artworks (across all periods)
SELECT o.period,
       l.description AS label,
       COUNT(DISTINCT o.object_id) AS artworks
FROM   `bigquery-public-data.the_met.objects`        o
JOIN   `bigquery-public-data.the_met.vision_api_data` v
       ON o.object_id = v.object_id,
       UNNEST(v.labelAnnotations) AS l
WHERE  o.period IS NOT NULL
GROUP  BY o.period, label
HAVING artworks >= 500
ORDER  BY artworks DESC
LIMIT 20;
```

```sql
-- 9. Rank labels within each period and pick the top three
SELECT period,
       label,
       artworks
FROM (
    SELECT o.period,
           l.description AS label,
           COUNT(DISTINCT o.object_id) AS artworks,
           ROW_NUMBER() OVER (PARTITION BY o.period
                              ORDER BY COUNT(DISTINCT o.object_id) DESC) AS rnk
    FROM   `bigquery-public-data.the_met.objects`        o
    JOIN   `bigquery-public-data.the_met.vision_api_data` v
           ON o.object_id = v.object_id,
           UNNEST(v.labelAnnotations) AS l
    WHERE  o.period IS NOT NULL
    GROUP  BY o.period, label
    HAVING COUNT(DISTINCT o.object_id) >= 500
)
WHERE rnk <= 3
ORDER BY period, artworks DESC
LIMIT 20;
```

```sql
-- 10. Final answer query (drop LIMIT when you need the full list)
SELECT period,
       label,
       artworks
FROM (
    SELECT o.period,
           l.description AS label,
           COUNT(DISTINCT o.object_id) AS artworks,
           ROW_NUMBER() OVER (PARTITION BY o.period
                              ORDER BY COUNT(DISTINCT o.object_id) DESC) AS rnk
    FROM   `bigquery-public-data.the_met.objects`        o
    JOIN   `bigquery-public-data.the_met.vision_api_data` v
           ON o.object_id = v.object_id,
           UNNEST(v.labelAnnotations) AS l
    WHERE  o.period IS NOT NULL
    GROUP  BY o.period, label
    HAVING COUNT(DISTINCT o.object_id) >= 500
)
WHERE rnk <= 3
ORDER BY period, artworks DESC
LIMIT 20;
```

