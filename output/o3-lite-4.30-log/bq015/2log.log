```sql
--Description:
-- Objective: return the ten Stack Overflow tags whose questions are most often cited
--            inside Hacker News comments posted on or after 2014‑01‑01.
--
-- Accessible data:
--   1. fh-bigquery.hackernews.full_partitioned
--        • holds every HN item; restrict to rows where type='comment'.
--        • contains the comment body in `text` and a TIMESTAMP column `timestamp`.
--
--   2. fh-bigquery.hackernews.full_partition_extra
--        • holds HN “story” rows; when the URL points to a Stack Overflow question the
--          ARRAY<STRING> field `tags` stores its tag list.
--
-- Steps:
--   a. Extract each Stack Overflow question id (so_qid) that appears in comments since 2014.
--   b. Count how many times every so_qid is mentioned.
--   c. From story rows, map each so_qid to its tag list.
--   d. Join counts to tag lists, explode tags, aggregate by tag, sort, and limit to 10.

WITH mention_raw AS (
  SELECT
    REGEXP_EXTRACT(LOWER(text), r'/questions/([0-9]+)') AS so_qid
  FROM `fh-bigquery.hackernews.full_partitioned`
  WHERE type = 'comment'
    AND timestamp >= '2014-01-01'
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
),
mention_counts AS (
  SELECT
    so_qid,
    COUNT(*) AS mentions
  FROM mention_raw
  WHERE so_qid IS NOT NULL
  GROUP BY so_qid
),
question_tags AS (
  SELECT
    REGEXP_EXTRACT(LOWER(url), r'/questions/([0-9]+)') AS so_qid,
    tags                                                AS tag_array
  FROM `fh-bigquery.hackernews.full_partition_extra`
  WHERE type = 'story'
    AND LOWER(url) LIKE '%stackoverflow.com/questions/%'
)
SELECT
  tag,
  SUM(mc.mentions) AS total_mentions
FROM mention_counts AS mc
JOIN question_tags  AS qt USING (so_qid)
JOIN UNNEST(qt.tag_array) AS tag
GROUP BY tag
ORDER BY total_mentions DESC
LIMIT 10;
```
