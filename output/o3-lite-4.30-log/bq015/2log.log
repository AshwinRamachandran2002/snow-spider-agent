```sql
--Description:
-- We need one final query that answers: “Which ten Stack Overflow tags are associated with
-- the questions most frequently mentioned in Hacker News comments since 2014‑01‑01?”
--
-- Steps explained inline:
-- 1.  Pull all rows from `commentsV2` whose text contains a Stack Overflow question URL.
--     Extract the numeric question id (so_qid) with REGEXP_EXTRACT and keep only rows
--     from 2014‑01‑01 onward.  This is CTE mention_raw.
-- 2.  Aggregate mention_raw to count how many times each question id was referenced
--     (mention_counts).
-- 3.  From `full_partition_extra`, collect every HN story whose URL points to a
--     Stack Overflow question; each such story row already includes `tags`
--     (an ARRAY<STRING> that stores a single pipe‑delimited tag string).  We convert the
--     array to a single string so we can split it later (question_tags).
-- 4.  Join mention_counts with question_tags on the common question id, then split the
--     tag string, UNNEST into individual tag values, and sum the mention counts per tag.
-- 5.  Order the tags by total mentions and return the top 10.

WITH mention_raw AS (
  SELECT
    REGEXP_EXTRACT(LOWER(text), r'/questions/([0-9]+)') AS so_qid
  FROM `fh-bigquery.hackernews.commentsV2`
  WHERE timestamp >= '2014-01-01'
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
),
mention_counts AS (
  SELECT
    so_qid,
    COUNT(*) AS mentions
  FROM mention_raw
  WHERE so_qid IS NOT NULL
  GROUP BY so_qid
),
question_tags AS (
  SELECT
    REGEXP_EXTRACT(LOWER(url), r'/questions/([0-9]+)') AS so_qid,
    ARRAY_TO_STRING(tags, '|')                         AS tag_str
  FROM `fh-bigquery.hackernews.full_partition_extra`
  WHERE type = 'story'
    AND LOWER(url) LIKE '%stackoverflow.com/questions/%'
)
SELECT
  tag,
  SUM(mc.mentions) AS total_mentions
FROM mention_counts AS mc
JOIN question_tags  AS qt USING (so_qid)
JOIN UNNEST(SPLIT(qt.tag_str, '|')) AS tag
GROUP BY tag
ORDER BY total_mentions DESC
LIMIT 10;
```
