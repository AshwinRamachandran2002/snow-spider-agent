Relevant columns, their potential usage and typical filtering conditions
• `comments.text` : body of each Hacker News comment – search for “stackoverflow.com/questions/”  
• `comments.time` : Unix‑epoch seconds – restrict to comments ≥ 2014‑01‑01 ( 1388534400 )  
• `comments.id`    : comment id – identifier for later joins / debugging  
• `full_partition_extra.url` : full URL that a Hacker News item points to – grab the canonical Stack Overflow question URL  
• `full_partition_extra.tags` : ARRAY<STRING> that (when present) contains the tag string coming from the target page; individual tags are concatenated with “|”  
• `full_partition_extra.id`   : internal id; can be used together with `url` for a join (or just join on the URL itself)  
• `full_partition_extra.type` : only keep rows whose URL really is a Stack Overflow question (`LIKE '%stackoverflow.com/questions/%'`)  
Conditions you will usually see  
    WHERE LOWER(text)      LIKE '%stackoverflow.com/questions/%'  
      AND time             >= 1388534400           -- 2014‑01‑01  
      AND LOWER(url)       LIKE '%stackoverflow.com/questions/%'  
      AND tags IS NOT NULL AND ARRAY_LENGTH(tags)>0  

Below are ten exploratory → increasingly complete queries; each limited to 20 rows except the final answer query.  
Copy / run them in order to understand the data and finally obtain the “Top‑10 Stack Overflow tags mentioned in HN comments (2014‑‑)”.


```sql
-- 1. Peek at recent comments that contain a Stack Overflow question link (after 2014)
SELECT id,
       TIMESTAMP_SECONDS(time)  AS comment_ts,
       text
FROM   `fh-bigquery.hackernews.comments`
WHERE  time >= 1388534400
  AND  LOWER(text) LIKE '%stackoverflow.com/questions/%'
LIMIT 20;
```

```sql
-- 2. Extract the distinct SO‑question URLs and the numeric question ids mentioned
SELECT DISTINCT
       REGEXP_EXTRACT(LOWER(text),
                      r'(https?://[^\\s"\'>]*stackoverflow.com/questions/\\d+/[^\\s"\'>]*)')
         AS so_question_url,
       CAST(REGEXP_EXTRACT(LOWER(text),
                      r'stackoverflow.com/questions/(\\d+)') AS INT64) AS so_question_id
FROM   `fh-bigquery.hackernews.comments`
WHERE  time >= 1388534400
  AND  LOWER(text) LIKE '%stackoverflow.com/questions/%'
LIMIT 20;
```

```sql
-- 3. Count how many times every individual question gets referenced
WITH refs AS (
  SELECT CAST(REGEXP_EXTRACT(LOWER(text),
                    r'stackoverflow.com/questions/(\\d+)') AS INT64) AS so_question_id
  FROM   `fh-bigquery.hackernews.comments`
  WHERE  time >= 1388534400
    AND  LOWER(text) LIKE '%stackoverflow.com/questions/%'
)
SELECT so_question_id,
       COUNT(*) AS mention_cnt
FROM   refs
GROUP  BY so_question_id
ORDER  BY mention_cnt DESC
LIMIT 20;
```

```sql
-- 4. Inspect hackernews.full_partition_extra rows that point at a Stack Overflow question
SELECT id,
       url,
       tags
FROM   `fh-bigquery.hackernews.full_partition_extra`
WHERE  LOWER(url) LIKE '%stackoverflow.com/questions/%'
  AND  tags IS NOT NULL
LIMIT 20;
```

```sql
-- 5. Join the comment‑side references with the HN‑item list to pick up the tag strings
WITH comment_refs AS (
  SELECT
    CAST(REGEXP_EXTRACT(LOWER(text),
          r'stackoverflow.com/questions/(\\d+)') AS INT64) AS so_question_id,
    COUNT(*) AS times_mentioned
  FROM `fh-bigquery.hackernews.comments`
  WHERE time >= 1388534400
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
  GROUP BY so_question_id
)
SELECT c.so_question_id,
       c.times_mentioned,
       f.tags
FROM   comment_refs AS c
JOIN   `fh-bigquery.hackernews.full_partition_extra`  AS f
  ON   CAST(REGEXP_EXTRACT(LOWER(f.url),
            r'stackoverflow.com/questions/(\\d+)') AS INT64) = c.so_question_id
WHERE  f.tags IS NOT NULL
LIMIT 20;
```

```sql
-- 6. Split the pipe‑delimited tag strings into individual tags
WITH joined AS (
  SELECT
    c.so_question_id,
    c.times_mentioned,
    SPLIT(tag_str, '|') AS tag_arr           -- convert single string into ARRAY
  FROM (
      SELECT
        c.so_question_id,
        c.times_mentioned,
        STRING_AGG(t, '|') AS tag_str
      FROM (
        SELECT c.so_question_id,
               c.times_mentioned,
               t AS t
        FROM (
          /* previous JOIN inlined */
          SELECT
            c.so_question_id,
            c.times_mentioned,
            f.tags AS tag_array
          FROM (
              SELECT
                CAST(REGEXP_EXTRACT(LOWER(text),
                  r'stackoverflow.com/questions/(\\d+)') AS INT64) AS so_question_id,
                COUNT(*) AS times_mentioned
              FROM `fh-bigquery.hackernews.comments`
              WHERE time >= 1388534400
                AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
              GROUP BY so_question_id
          ) AS c
          JOIN `fh-bigquery.hackernews.full_partition_extra` AS f
            ON CAST(REGEXP_EXTRACT(LOWER(f.url),
                 r'stackoverflow.com/questions/(\\d+)') AS INT64) = c.so_question_id
          WHERE f.tags IS NOT NULL
        ), UNNEST(tag_array) AS t
      )
      GROUP BY c.so_question_id, c.times_mentioned
  )
)
SELECT *
FROM   joined
LIMIT 20;
```

```sql
-- 7. Aggregate: weight each tag by how many times its question was cited
WITH comment_refs AS (
  SELECT
    CAST(REGEXP_EXTRACT(LOWER(text),
         r'stackoverflow.com/questions/(\\d+)') AS INT64) AS so_question_id,
    COUNT(*) AS mentions
  FROM `fh-bigquery.hackernews.comments`
  WHERE time >= 1388534400
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
  GROUP BY so_question_id
),
question_tags AS (
  SELECT
    CAST(REGEXP_EXTRACT(LOWER(url),
         r'stackoverflow.com/questions/(\\d+)') AS INT64) AS so_question_id,
    tags
  FROM `fh-bigquery.hackernews.full_partition_extra`
  WHERE LOWER(url) LIKE '%stackoverflow.com/questions/%'
    AND tags IS NOT NULL
)
SELECT
  tag,
  SUM(cr.mentions) AS total_mentions
FROM comment_refs AS cr
JOIN question_tags AS qt
  USING (so_question_id)
CROSS JOIN UNNEST(qt.tags) AS tag
GROUP  BY tag
ORDER  BY total_mentions DESC
LIMIT 20;
```

```sql
-- 8. FINAL answer query – Top‑10 Stack Overflow tags most frequently referenced via HN comments (≥2014)
WITH comment_refs AS (
  SELECT
    CAST(REGEXP_EXTRACT(LOWER(text),
         r'stackoverflow.com/questions/(\\d+)') AS INT64) AS so_question_id,
    COUNT(*) AS mentions
  FROM `fh-bigquery.hackernews.comments`
  WHERE time >= 1388534400              -- on / after 2014‑01‑01
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
  GROUP BY so_question_id
),
question_tags AS (
  SELECT
    CAST(REGEXP_EXTRACT(LOWER(url),
         r'stackoverflow.com/questions/(\\d+)') AS INT64) AS so_question_id,
    tags                                    -- ARRAY<STRING>, pipe‑delimited
  FROM `fh-bigquery.hackernews.full_partition_extra`
  WHERE LOWER(url) LIKE '%stackoverflow.com/questions/%'
    AND tags IS NOT NULL
)
SELECT
  tag,
  SUM(mentions) AS total_mentions
FROM  comment_refs
JOIN  question_tags USING (so_question_id)
CROSS JOIN UNNEST( SPLIT(REGEXP_REPLACE(  -- ensure we split on "|"
                          ARRAY_TO_STRING(question_tags.tags,'|'),
                          r'\\s','') ,'|') ) AS tag
GROUP BY tag
ORDER BY total_mentions DESC
LIMIT 10;
```

```sql
-- 9. Same logic but driven by the comments_convolution table
SELECT
  tag,
  SUM(cnt) AS total_mentions
FROM (
  SELECT
    CAST(REGEXP_EXTRACT(LOWER(text),
         r'stackoverflow.com/questions/(\\d+)') AS INT64) AS qid,
    COUNT(*) AS cnt
  FROM `fh-bigquery.hackernews.comments_convolution`
  WHERE time >= 1388534400
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
  GROUP BY qid
) c
JOIN `fh-bigquery.hackernews.full_partition_extra` f
  ON CAST(REGEXP_EXTRACT(LOWER(f.url),
       r'stackoverflow.com/questions/(\\d+)') AS INT64) = c.qid
CROSS JOIN UNNEST(f.tags) AS tag
GROUP BY tag
ORDER BY total_mentions DESC
LIMIT 20;
```

