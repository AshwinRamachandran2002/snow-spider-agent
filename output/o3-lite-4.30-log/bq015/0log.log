```sql
--Description:
-- Goal: list the 10 most‑referenced Stack Overflow tags whose questions were linked
--       from Hacker News comments posted on or after 2014‑01‑01.
-- Steps (thinking process):
--   1. From public HN comments, keep only those containing “stackoverflow.com/questions/”
--      and extract the numeric question‑id with REGEXP_EXTRACT.
--   2. Count how many times each question is mentioned.
--   3. Join those ids to Stack Overflow’s posts_questions table to obtain each
--      question’s Tags string (stored as “<tag1><tag2>…”).
--   4. Convert that angle‑bracket format into a pipe‑delimited string, split it,
--      and explode into individual tags.
--   5. Aggregate the mention counts per tag and return the top 10.
WITH comment_refs AS (
  SELECT
    CAST(REGEXP_EXTRACT(LOWER(text),
         r'stackoverflow\.com/questions/(\d+)') AS INT64) AS question_id
  FROM `bigquery-public-data.hacker_news.comments`
  WHERE time >= 1388534400                     -- 2014‑01‑01
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
),
question_mentions AS (
  SELECT
    question_id,
    COUNT(*) AS mention_cnt
  FROM comment_refs
  WHERE question_id IS NOT NULL
  GROUP BY question_id
),
question_tags AS (
  SELECT
    qm.mention_cnt,
    -- change "<tag1><tag2>" -> "tag1|tag2" then split
    REGEXP_REPLACE( REGEXP_REPLACE(q.Tags, r'^<|>$', ''), r'><', '|') AS tag_pipe
  FROM question_mentions AS qm
  JOIN `bigquery-public-data.stackoverflow.posts_questions` AS q
    ON q.Id = qm.question_id
  WHERE q.Tags IS NOT NULL
),
tag_totals AS (
  SELECT
    tag,
    SUM(mention_cnt) AS total_mentions
  FROM question_tags,
  UNNEST(SPLIT(tag_pipe, '|')) AS tag
  GROUP BY tag
)
SELECT
  tag,
  total_mentions
FROM tag_totals
ORDER BY total_mentions DESC
LIMIT 10;
```
