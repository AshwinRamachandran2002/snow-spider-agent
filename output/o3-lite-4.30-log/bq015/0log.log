--Description: 7) Aggregate: weight each tag by the number of times its question was
--             cited in HN comments (≥2014) and list top 20 tags.
WITH comment_refs AS (
  SELECT
    CAST(REGEXP_EXTRACT(LOWER(text),
         r'stackoverflow\.com/questions/(\d+)') AS INT64) AS so_question_id,
    COUNT(*) AS mentions
  FROM `bigquery-public-data.hacker_news.full`
  WHERE type = 'comment'
    AND time >= 1388534400
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
  GROUP BY so_question_id
),
question_tags AS (
  SELECT
    q.Id            AS so_question_id,
    q.Tags          AS tags_angle,
    cr.mentions
  FROM comment_refs AS cr
  JOIN `bigquery-public-data.stackoverflow.posts_questions` AS q
    ON q.Id = cr.so_question_id
  WHERE q.Tags IS NOT NULL
)
SELECT
  tag,
  SUM(mentions) AS total_mentions
FROM question_tags,
UNNEST(
  SPLIT(
    REGEXP_REPLACE(
      REGEXP_REPLACE(tags_angle, r'^<|>$', ''), r'><', '|'
    ), '|')
) AS tag
GROUP BY tag
ORDER BY total_mentions DESC
LIMIT 20
