```sql
/*  Top‑10 Stack Overflow tags that appear in questions referenced
    from Hacker News comments (on or after 2014)                     */

WITH comment_refs AS (                   -- how many times each SO question is mentioned
  SELECT
    CAST(
      REGEXP_EXTRACT(LOWER(text),
                     r'stackoverflow\.com/questions/([0-9]+)') AS INT64
    )            AS question_id,
    COUNT(*)     AS mentions
  FROM `fh-bigquery.hackernews.comments`
  WHERE time >= 1388534400                                   -- 2014‑01‑01
    AND REGEXP_CONTAINS(LOWER(text),
                        r'stackoverflow\.com/questions/[0-9]+')
  GROUP BY question_id
  HAVING question_id IS NOT NULL
),

question_tags AS (                     -- distinct tag‑list for every SO question
  SELECT
    question_id,
    ARRAY_AGG(DISTINCT tag) AS tags
  FROM (
    SELECT
      CAST(
        REGEXP_EXTRACT(LOWER(url),
                       r'stackoverflow\.com/questions/([0-9]+)') AS INT64
      )         AS question_id,
      tag
    FROM `fh-bigquery.hackernews.full_partition_extra`,
         UNNEST(tags) AS tag
    WHERE REGEXP_CONTAINS(LOWER(url),
                          r'stackoverflow\.com/questions/[0-9]+')
      AND tags IS NOT NULL AND ARRAY_LENGTH(tags) > 0
  )
  GROUP BY question_id
)

SELECT
  tag,
  SUM(cr.mentions) AS mention_count
FROM comment_refs            AS cr
JOIN question_tags           AS qt  USING (question_id)
CROSS JOIN UNNEST(qt.tags)   AS tag
GROUP BY tag
ORDER BY mention_count DESC, tag
LIMIT 10;
```
