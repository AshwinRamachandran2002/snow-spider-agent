```sql
--Description: Determine the 10 Stack Overflow tags that appear most often in questions
--             linked from Hacker News comments since 2014.  The query proceeds in four
--             conceptual steps, each expressed as a CTE:
--               1) comment_refs  – scan the public HN “full” table, keep rows that are
--                  comments (type='comment'), dated ≥ 2014‑01‑01, and containing the
--                  pattern “stackoverflow.com/questions/”.  Extract the numeric
--                  question‑id from each matched URL.
--               2) question_hits – count how many times each SO question id is mentioned
--                  across all such comments.
--               3) so_questions  – join those question ids to the public Stack Overflow
--                  posts_questions table to fetch the Tags string for each question.
--               4) tag_counts    – transform the angle‑bracket tag string
--                  (“<python><regex>”) into individual tags, aggregate the mention
--                  counts per tag, rank, and return the top ten.
WITH comment_refs AS (
  SELECT
    CAST(REGEXP_EXTRACT(LOWER(text),
         r'stackoverflow\.com/questions/(\d+)') AS INT64) AS question_id
  FROM `bigquery-public-data.hacker_news.full`
  WHERE type = 'comment'
    AND time >= 1388534400                           -- 2014‑01‑01
    AND text IS NOT NULL
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
),
question_hits AS (
  SELECT
    question_id,
    COUNT(*) AS mention_cnt
  FROM comment_refs
  WHERE question_id IS NOT NULL
  GROUP BY question_id
),
so_questions AS (
  SELECT
    q.Id            AS question_id,
    q.Tags          AS tags_angle,   -- format "<tag1><tag2>..."
    h.mention_cnt
  FROM `bigquery-public-data.stackoverflow.posts_questions` AS q
  JOIN question_hits AS h
    ON q.Id = h.question_id
  WHERE q.Tags IS NOT NULL
),
tag_counts AS (
  SELECT
    LOWER(tag)         AS tag,
    SUM(mention_cnt)   AS total_mentions
  FROM so_questions,
  UNNEST(
    SPLIT(
      REGEXP_REPLACE(          -- convert "<a><b>" -> "a|b"
        REGEXP_REPLACE(tags_angle, r'^<|>$', ''), r'><', '|'
      )
    , '|')
  ) AS tag
  GROUP BY tag
)
SELECT
  tag,
  total_mentions
FROM tag_counts
ORDER BY total_mentions DESC
LIMIT 10;
```
