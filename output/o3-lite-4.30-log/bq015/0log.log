-- 10. Lightweight inspection of how many rows in full_partition_extra actually carry non‑empty tags
SELECT COUNT(*) AS total_items,
       SUM(CASE WHEN tags IS NOT NULL 
                    AND ARRAY_LENGTH(tags)>0 THEN 1 ELSE 0 END) AS items_with_tags
FROM   `fh-bigquery.hackernews.full_partition_extra`;
