--Description: 6) Demonstrate splitting the angle‑bracket tag string for each question
--             into an ARRAY of individual tags, keeping mention counts.
WITH comment_refs AS (
  SELECT
    CAST(REGEXP_EXTRACT(LOWER(text),
         r'stackoverflow\.com/questions/(\d+)') AS INT64) AS so_question_id,
    COUNT(*) AS times_mentioned
  FROM `bigquery-public-data.hacker_news.full`
  WHERE type = 'comment'
    AND time >= 1388534400
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
  GROUP BY so_question_id
)
SELECT
  c.so_question_id,
  c.times_mentioned,
  SPLIT(
    REGEXP_REPLACE(
      REGEXP_REPLACE(q.Tags, r'^<|>$', ''), r'><', '|'
    ), '|'
  ) AS tag_array
FROM comment_refs AS c
JOIN `bigquery-public-data.stackoverflow.posts_questions` AS q
  ON q.Id = c.so_question_id
WHERE q.Tags IS NOT NULL
LIMIT 20;
