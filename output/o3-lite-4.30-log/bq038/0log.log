Query:
--Description: Corrected “Final answer” query – calculates the proportion of group loop rides
--             (same start/end dock, ≥2 departures inside a 2‑minute window) and returns the
--             20 highest‑ranked stations.  The join to `citibike_stations` is fixed by casting
--             our INT64 station code to STRING (instead of the reverse) to avoid “Bad int64 value”.
WITH loop_trips AS (                           -- loop rides only, plus 2‑min bucket
  SELECT
    start_station_id,
    TIMESTAMP_SECONDS(120 * DIV(UNIX_SECONDS(starttime), 120)) AS bucket_start
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE start_station_id = end_station_id
),
group_flag AS (                                -- count trips per (station,bucket)
  SELECT
    start_station_id AS station,
    COUNT(*) OVER (
      PARTITION BY start_station_id, bucket_start
    ) AS trips_in_bucket
  FROM loop_trips
),
group_ct AS (                                  -- numerator: trips in buckets with ≥2 rides
  SELECT
    station,
    COUNTIF(trips_in_bucket > 1) AS group_trips
  FROM group_flag
  GROUP BY station
),
total_ct AS (                                  -- denominator: all trips ending at station
  SELECT
    end_station_id AS station,
    COUNT(*) AS total_trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  GROUP BY station
)
SELECT
  COALESCE(s.name, CAST(g.station AS STRING)) AS station_name,
  g.group_trips,
  t.total_trips,
  SAFE_DIVIDE(g.group_trips, t.total_trips)   AS proportion_group
FROM group_ct g
JOIN total_ct t USING (station)
LEFT JOIN `bigquery-public-data.new_york.citibike_stations` s
  ON s.station_id = CAST(g.station AS STRING)  -- cast INT64 → STRING to prevent errors
ORDER BY proportion_group DESC
LIMIT 20
