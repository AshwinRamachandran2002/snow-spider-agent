2025-05-01 01:39:40 - Thread-378 (execute) - INFO - [Exploration]
Relevant columns and their possible use  

citibike_trips.starttime            : departure timestamp, needed to build 2‑minute windows  
citibike_trips.stoptime             : return timestamp (not strictly needed, but available)  
citibike_trips.start_station_id     : departure station id, used for grouping/rate calculation  
citibike_trips.end_station_id       : return station id, used to ❶ keep only “same‑station” rides and ❷ count total returns  
citibike_trips.start_station_name   : added readability when we look at results  
citibike_trips.end_station_name     : idem  
citibike_trips.tripduration         : can be ignored here  
citibike_stations.station_id        : join key to fetch the official station name / capacity (optional)  
citibike_stations.name              : pretty label to show in the final list  

Typical conditions we will use  

• start_station_id = end_station_id    – self‑loop trips  
• UNIX_SECONDS(starttime) DIV 120      – 2‑minute “bucket” used to find simultaneous departures  
• COUNT(*) OVER(…) > 1                 – flag a trip as belonging to a “group ride” (≥2 departures in the same window)  

Below are 10 exploratory → production BigQuery SQL statements (all limited to 20 rows except the final answer).  
Each subsequent query adds complexity, finishing with the requested top‑10 table.

```sql
-- 1. Quick look at raw Citi Bike trip records
SELECT *
FROM `bigquery-public-data.new_york.citibike_trips`
LIMIT 20;
```

```sql
-- 2. Distinct start stations that appear in the data
SELECT DISTINCT start_station_id, start_station_name
FROM `bigquery-public-data.new_york.citibike_trips`
WHERE start_station_id IS NOT NULL
LIMIT 20;
```

```sql
-- 3. How many trips end at each station?
SELECT end_station_id, COUNT(*) AS total_end_trips
FROM `bigquery-public-data.new_york.citibike_trips`
WHERE end_station_id IS NOT NULL
GROUP BY end_station_id
ORDER BY total_end_trips DESC
LIMIT 20;
```

```sql
-- 4. Count of trips that start and end at the SAME station (candidate pool for “group rides”)
SELECT start_station_id AS station_id, COUNT(*) AS same_station_trips
FROM `bigquery-public-data.new_york.citibike_trips`
WHERE start_station_id = end_station_id
GROUP BY station_id
ORDER BY same_station_trips DESC
LIMIT 20;
```

```sql
-- 5. Create 2‑minute buckets for those same‑station trips
SELECT
  start_station_id                           AS station_id,
  TIMESTAMP_SECONDS(120 * DIV(UNIX_SECONDS(starttime), 120)) AS bucket_start,
  COUNT(*)                                   AS trips_in_bucket
FROM `bigquery-public-data.new_york.citibike_trips`
WHERE start_station_id = end_station_id
GROUP BY station_id, bucket_start
ORDER BY trips_in_bucket DESC
LIMIT 20;
```

```sql
-- 6. Identify “group‑ride” buckets (≥2 trips in the same 2‑minute window)
SELECT *
FROM (
  SELECT
    start_station_id                         AS station_id,
    TIMESTAMP_SECONDS(120 * DIV(UNIX_SECONDS(starttime), 120)) AS bucket_start,
    COUNT(*) AS trips_in_bucket
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE start_station_id = end_station_id
  GROUP BY station_id, bucket_start
)
WHERE trips_in_bucket > 1
ORDER BY trips_in_bucket DESC
LIMIT 20;
```

```sql
-- 7. Flag each individual trip if it belongs to a “group ride”
SELECT
  trip_id,                    -- synthetic id just for illustration
  start_station_id            AS station_id,
  starttime,
  bucket_start,
  CASE WHEN trips_in_bucket > 1 THEN 1 ELSE 0 END AS is_group_ride
FROM (
  SELECT
    GENERATE_UUID() AS trip_id,              -- creates a unique row id
    t.*,
    TIMESTAMP_SECONDS(120 * DIV(UNIX_SECONDS(starttime), 120)) AS bucket_start,
    COUNT(*) OVER (PARTITION BY start_station_id,
                              TIMESTAMP_SECONDS(120 * DIV(UNIX_SECONDS(starttime), 120))
                  ) AS trips_in_bucket
  FROM `bigquery-public-data.new_york.citibike_trips` AS t
  WHERE start_station_id = end_station_id
)
LIMIT 20;
```

```sql
-- 8. Aggregate number of group‑ride trips for every station
WITH tagged AS (
  SELECT
    end_station_id                            AS station_id,
    CASE
      WHEN start_station_id = end_station_id AND
           COUNT(*) OVER (PARTITION BY start_station_id,
                                   TIMESTAMP_SECONDS(120 * DIV(UNIX_SECONDS(starttime),120))
                          ) > 1
      THEN 1 ELSE 0
    END AS is_group_ride
  FROM `bigquery-public-data.new_york.citibike_trips`
)
SELECT
  station_id,
  SUM(is_group_ride) AS group_ride_trips
FROM tagged
GROUP BY station_id
ORDER BY group_ride_trips DESC
LIMIT 20;
```

```sql
-- 9. Join with citibike_stations to see readable names + capacities
WITH grouped AS (
  SELECT
    station_id,
    SUM(is_group_ride) AS group_trips
  FROM (
    SELECT
      end_station_id AS station_id,
      CASE
        WHEN start_station_id = end_station_id AND
             COUNT(*) OVER (PARTITION BY start_station_id,
                                         TIMESTAMP_SECONDS(120 * DIV(UNIX_SECONDS(starttime),120))
                            ) > 1
        THEN 1 ELSE 0
      END AS is_group_ride
    FROM `bigquery-public-data.new_york.citibike_trips`
  )
  GROUP BY station_id
),
totals AS (
  SELECT end_station_id AS station_id, COUNT(*) AS total_end_trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  GROUP BY station_id
)
SELECT
  s.name,
  g.group_trips,
  t.total_end_trips
FROM grouped AS g
JOIN totals  AS t USING (station_id)
LEFT JOIN `bigquery-public-data.new_york.citibike_stations` AS s
       ON s.station_id = CAST(g.station_id AS STRING)
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER – Top‑10 stations by highest proportion of group rides
WITH trip_flags AS (
  SELECT
    end_station_id AS station_id,
    CASE
      WHEN start_station_id = end_station_id
       AND COUNT(*) OVER (PARTITION BY start_station_id,
                                        TIMESTAMP_SECONDS(120 * DIV(UNIX_SECONDS(starttime),120))
                          ) > 1
      THEN 1 ELSE 0
    END AS is_group_ride
  FROM `bigquery-public-data.new_york.citibike_trips`
),
per_station AS (
  SELECT
    station_id,
    SUM(is_group_ride)                     AS group_ride_trips,
    COUNT(*)                               AS total_end_trips,
    SAFE_DIVIDE(SUM(is_group_ride), COUNT(*)) AS proportion_group
  FROM trip_flags
  GROUP BY station_id
)
SELECT
  s.name                                            AS station_name,
  p.group_ride_trips,
  p.total_end_trips,
  ROUND(p.proportion_group, 4)                      AS proportion_group
FROM per_station AS p
LEFT JOIN `bigquery-public-data.new_york.citibike_stations` AS s
       ON s.station_id = CAST(p.station_id AS STRING)
ORDER BY proportion_group DESC
LIMIT 10;
```

The last query calculates for every station:  
• total trips ending there (`total_end_trips`)  
• trips that belong to a “group‑ride” as defined (`group_ride_trips`)  
• their ratio (`proportion_group`)  

Then it orders by that ratio and shows the 10 highest‑proportion stations.
