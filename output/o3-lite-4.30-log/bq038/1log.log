```sql
-- Description / Thinking process:
-- ----------------------------------------------------------------------
-- Objective: Find the 10 Citi Bike stations where “group rides”
-- (loop rides with ≥2 departures in the same 2‑minute bucket)
-- make up the largest share of all trips that END at that station.
--
-- Definitions
--   Loop ride         : start_station_id = end_station_id
--   2‑minute bucket   : FLOOR(UNIX_SECONDS(starttime) / 120)
--   Group bucket      : (station , bucket) that contains ≥2 loop rides
--   Numerator         : every trip that belongs to a group bucket
--   Denominator       : every trip whose end_station_id = station
--   Ratio             : numerator / denominator
--
-- Implementation outline (one query with CTEs):
--   1. ended_trips      – denominator counts.
--   2. loop_rides       – all loop trips with bucket key.
--   3. group_buckets    – qualifying buckets (≥2 rides).
--   4. group_ride_trips – numerator counts.
--   5. ratios           – compute share.
--   6. Final 10 rows with station names (SAFE_CAST protects from
--      non‑numeric station_id strings in citibike_stations).
-- ----------------------------------------------------------------------

WITH ended_trips AS (                       -- Denominator
  SELECT
    end_station_id AS station_id,
    COUNT(*) AS total_ending_trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE end_station_id IS NOT NULL
  GROUP BY station_id
),
loop_rides AS (                             -- Loop trips with 2‑min bucket
  SELECT
    start_station_id AS station_id,
    FLOOR(UNIX_SECONDS(starttime) / 120) AS bucket_2min
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE start_station_id = end_station_id
),
group_buckets AS (                          -- Buckets that have ≥2 loop rides
  SELECT
    station_id,
    bucket_2min
  FROM loop_rides
  GROUP BY station_id, bucket_2min
  HAVING COUNT(*) > 1
),
group_ride_trips AS (                       -- Numerator
  SELECT
    l.station_id,
    COUNT(*) AS group_ride_trips
  FROM loop_rides AS l
  JOIN group_buckets AS g
  USING (station_id, bucket_2min)
  GROUP BY l.station_id
),
ratios AS (                                 -- Share of group rides per station
  SELECT
    e.station_id,
    g.group_ride_trips,
    e.total_ending_trips,
    SAFE_DIVIDE(g.group_ride_trips, e.total_ending_trips) AS group_ride_ratio
  FROM ended_trips AS e
  JOIN group_ride_trips AS g USING (station_id)
)

SELECT
  s.name AS station_name,
  r.station_id,
  r.group_ride_trips,
  r.total_ending_trips,
  r.group_ride_ratio
FROM ratios AS r
LEFT JOIN `bigquery-public-data.new_york.citibike_stations` AS s
  ON r.station_id = SAFE_CAST(s.station_id AS INT64)  -- avoid bad INT64 casts
ORDER BY r.group_ride_ratio DESC
LIMIT 10;
```
