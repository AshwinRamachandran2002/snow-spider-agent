Query:
-- 9) Join numerator & denominator to compute the group‑ride ratio
SELECT e.station_id,
       g.group_ride_trips,
       e.total_ending_trips,
       SAFE_DIVIDE(g.group_ride_trips , e.total_ending_trips) AS group_ride_ratio
FROM (
  SELECT end_station_id AS station_id,
         COUNT(*) AS total_ending_trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE end_station_id IS NOT NULL
  GROUP BY station_id
) AS e
LEFT JOIN (
  SELECT station_id,
         COUNT(*) AS group_ride_trips
  FROM (
    SELECT t.start_station_id AS station_id,
           FLOOR(UNIX_SECONDS(t.starttime)/120) AS bucket_2min
    FROM `bigquery-public-data.new_york.citibike_trips` AS t
    WHERE t.start_station_id = t.end_station_id
  ) AS t
  JOIN (
    SELECT start_station_id AS station_id,
           FLOOR(UNIX_SECONDS(starttime)/120) AS bucket_2min,
           COUNT(*) AS riders_in_window
    FROM `bigquery-public-data.new_york.citibike_trips`
    WHERE start_station_id = end_station_id
    GROUP BY station_id, bucket_2min
    HAVING riders_in_window > 1
  ) AS g
  USING (station_id, bucket_2min)
  GROUP BY station_id
) AS g
ON e.station_id = g.station_id
LIMIT 20;
