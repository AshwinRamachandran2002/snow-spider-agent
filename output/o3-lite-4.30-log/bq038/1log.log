Begin Exploring Related Columns
Relevant tables & columns for the task  

citibike_trips  
• starttime : departure time – build 2‑minute windows (120‑second buckets).  
• stoptime  : arrival time – not strictly required but can be inspected.  
• start_station_id : station where the bike was taken – used to form the window key.  
• end_station_id   : station where the bike was returned – used for (1) loop–ride filter (start=end) and (2) denominator (all trips ending at a station).  
• start_station_name / end_station_name : optional, human readable labels.  
• tripduration : can be checked for outliers if desired.  

citibike_stations  
• station_id : join key to look‑up a station’s name. (STRING → cast to INT64).  
• name       : published name of the station – show in the final list.  

Typical conditions that will be used  
1. start_station_id = end_station_id                        -- self loop (ride starts & ends at same dock).  
2. start_station_id IS NOT NULL AND end_station_id IS NOT NULL   -- ignore incomplete records.  
3. 2‑minute window key → FLOOR(UNIX_SECONDS(starttime)/120).  
4. GROUP BY station_id , window HAVING COUNT(*) > 1           -- windows that truly have a “group” (≥2 riders).  

────────────────────────────────────────────  
Ten step‑by‑step exploratory / building‑block queries  
(Each query limited to 20 rows unless otherwise noted)

```sql
-- 1) Quick look at the raw Citibike trip records
SELECT starttime, start_station_id, start_station_name,
       end_station_id, end_station_name, tripduration
FROM `bigquery-public-data.new_york.citibike_trips`
LIMIT 20;
```

```sql
-- 2) Sample trips that start and end at the same station (candidate group rides)
SELECT starttime, start_station_id AS station_id, start_station_name,
       end_station_id, tripduration
FROM `bigquery-public-data.new_york.citibike_trips`
WHERE start_station_id = end_station_id
LIMIT 20;
```

```sql
-- 3) How many loop rides per station?  (top 20 stations)
SELECT start_station_id AS station_id,
       COUNT(*) AS loop_ride_cnt
FROM `bigquery-public-data.new_york.citibike_trips`
WHERE start_station_id = end_station_id
GROUP BY station_id
ORDER BY loop_ride_cnt DESC
LIMIT 20;
```

```sql
-- 4) Attach a 2‑minute window bucket to each loop ride
SELECT start_station_id AS station_id,
       starttime,
       FLOOR(UNIX_SECONDS(starttime)/120) AS bucket_2min
FROM `bigquery-public-data.new_york.citibike_trips`
WHERE start_station_id = end_station_id
LIMIT 20;
```

```sql
-- 5) Find (station , 2‑minute window) combos that have ≥2 riders
SELECT station_id,
       bucket_2min,
       COUNT(*) AS riders_in_window
FROM (
  SELECT start_station_id AS station_id,
         FLOOR(UNIX_SECONDS(starttime)/120) AS bucket_2min
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE start_station_id = end_station_id
)
GROUP BY station_id, bucket_2min
HAVING riders_in_window > 1
ORDER BY riders_in_window DESC
LIMIT 20;
```

```sql
-- 6) Flag each loop ride row as group / not‑group (1/0 sample)
SELECT t.start_station_id AS station_id,
       t.starttime,
       IF(g.riders_in_window > 1, 1, 0) AS is_group_ride
FROM `bigquery-public-data.new_york.citibike_trips` AS t
LEFT JOIN (
  -- pre‑computed (station , bucket) that qualify as group windows
  SELECT station_id, bucket_2min, riders_in_window
  FROM (
    SELECT start_station_id AS station_id,
           FLOOR(UNIX_SECONDS(starttime)/120) AS bucket_2min,
           COUNT(*) AS riders_in_window
    FROM `bigquery-public-data.new_york.citibike_trips`
    WHERE start_station_id = end_station_id
    GROUP BY station_id, bucket_2min
    HAVING riders_in_window > 1
  )
) AS g
ON g.station_id = t.start_station_id
AND g.bucket_2min = FLOOR(UNIX_SECONDS(t.starttime)/120)
WHERE t.start_station_id = t.end_station_id
LIMIT 20;
```

```sql
-- 7) Number of trips that belong to a group, per station
SELECT station_id,
       COUNT(*) AS group_ride_trips
FROM (
  SELECT t.start_station_id AS station_id,
         FLOOR(UNIX_SECONDS(t.starttime)/120) AS bucket_2min
  FROM `bigquery-public-data.new_york.citibike_trips` AS t
  WHERE t.start_station_id = t.end_station_id
) AS t
JOIN (
  SELECT start_station_id AS station_id,
         FLOOR(UNIX_SECONDS(starttime)/120) AS bucket_2min,
         COUNT(*) AS riders_in_window
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE start_station_id = end_station_id
  GROUP BY station_id, bucket_2min
  HAVING riders_in_window > 1
) AS g
USING (station_id, bucket_2min)
GROUP BY station_id
ORDER BY group_ride_trips DESC
LIMIT 20;
```

```sql
-- 8) Total number of trips that END at each station (denominator)
SELECT end_station_id AS station_id,
       COUNT(*) AS total_ending_trips
FROM `bigquery-public-data.new_york.citibike_trips`
WHERE end_station_id IS NOT NULL
GROUP BY station_id
ORDER BY total_ending_trips DESC
LIMIT 20;
```

```sql
-- 9) Join numerator & denominator to compute the group‑ride ratio
SELECT e.station_id,
       g.group_ride_trips,
       e.total_ending_trips,
       SAFE_DIVIDE(g.group_ride_trips , e.total_ending_trips) AS group_ride_ratio
FROM (
  SELECT end_station_id AS station_id,
         COUNT(*) AS total_ending_trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE end_station_id IS NOT NULL
  GROUP BY station_id
) AS e
LEFT JOIN (
  SELECT station_id,
         COUNT(*) AS group_ride_trips
  FROM (
    SELECT t.start_station_id AS station_id,
           FLOOR(UNIX_SECONDS(t.starttime)/120) AS bucket_2min
    FROM `bigquery-public-data.new_york.citibike_trips` AS t
    WHERE t.start_station_id = t.end_station_id
  ) AS t
  JOIN (
    SELECT start_station_id AS station_id,
           FLOOR(UNIX_SECONDS(starttime)/120) AS bucket_2min,
           COUNT(*) AS riders_in_window
    FROM `bigquery-public-data.new_york.citibike_trips`
    WHERE start_station_id = end_station_id
    GROUP BY station_id, bucket_2min
    HAVING riders_in_window > 1
  ) AS g
  USING (station_id, bucket_2min)
  GROUP BY station_id
) AS g
ON e.station_id = g.station_id
LIMIT 20;
```

```sql
-- 10) FINAL – Top 10 stations with the highest proportion of group rides
SELECT s.name AS station_name,
       r.station_id,
       r.group_ride_trips,
       r.total_ending_trips,
       r.group_ride_ratio
FROM (
  SELECT e.station_id,
         g.group_ride_trips,
         e.total_ending_trips,
         SAFE_DIVIDE(g.group_ride_trips , e.total_ending_trips) AS group_ride_ratio
  FROM (
    SELECT end_station_id AS station_id,
           COUNT(*) AS total_ending_trips
    FROM `bigquery-public-data.new_york.citibike_trips`
    WHERE end_station_id IS NOT NULL
    GROUP BY station_id
  ) AS e
  JOIN (
    SELECT station_id,
           COUNT(*) AS group_ride_trips
    FROM (
      SELECT t.start_station_id AS station_id,
             FLOOR(UNIX_SECONDS(t.starttime)/120) AS bucket_2min
      FROM `bigquery-public-data.new_york.citibike_trips` AS t
      WHERE t.start_station_id = t.end_station_id
    ) AS t
    JOIN (
      SELECT start_station_id AS station_id,
             FLOOR(UNIX_SECONDS(starttime)/120) AS bucket_2min,
             COUNT(*) AS riders_in_window
      FROM `bigquery-public-data.new_york.citibike_trips`
      WHERE start_station_id = end_station_id
      GROUP BY station_id, bucket_2min
      HAVING riders_in_window > 1
    ) AS g
    USING (station_id, bucket_2min)
    GROUP BY station_id
  ) AS g
  ON e.station_id = g.station_id
) AS r
LEFT JOIN `bigquery-public-data.new_york.citibike_stations` AS s
ON CAST(s.station_id AS INT64) = r.station_id
ORDER BY r.group_ride_ratio DESC
LIMIT 10;
```

The tenth query returns the requested result set: the 10 Citibike stations that have the highest share of “group rides” (loops that launched/ended in the same 2‑minute window with ≥2 riders) relative to all trips finishing at that station.
