```sql
-- 10. FINAL ANSWER:
--     Top‑50 most‑viewed questions per Android tag (only tags having ≥50 such questions)
WITH raw AS (
  SELECT id, title, body, view_count,
         REGEXP_EXTRACT_ALL(tags, r'<([^>]+)>') AS tag_arr
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  WHERE (REGEXP_CONTAINS(LOWER(title), r'\bhow\b')
         OR REGEXP_CONTAINS(LOWER(body) , r'\bhow\b'))
    AND NOT REGEXP_CONTAINS(LOWER(title || ' ' || body),
         r'\b(fail|problem|error|wrong|fix|bug|issue|solve|trouble)\b')
    AND REGEXP_CONTAINS(tags,
         r'<(android-layout|android-activity|android-intent|android-edittext|android-fragments|android-recyclerview|listview|android-actionbar|google-maps|android-asynctask)>')
),
exploded AS (
  SELECT id, title, view_count, tag
  FROM raw, UNNEST(tag_arr) AS tag
  WHERE tag IN ('android-layout','android-activity','android-intent',
                'android-edittext','android-fragments','android-recyclerview',
                'listview','android-actionbar','google-maps','android-asynctask')
),
tag_ok AS (
  SELECT tag, COUNT(*) AS cnt
  FROM exploded
  GROUP BY tag
  HAVING cnt >= 50
),
ranked AS (
  SELECT tag, id, title, view_count,
         ROW_NUMBER() OVER (PARTITION BY tag ORDER BY view_count DESC) AS rn
  FROM exploded
  WHERE tag IN (SELECT tag FROM tag_ok)
)
SELECT tag, id, title, view_count
FROM ranked
WHERE rn <= 50
ORDER BY tag, view_count DESC;
```

