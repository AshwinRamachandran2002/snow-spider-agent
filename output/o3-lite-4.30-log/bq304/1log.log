--Description:
-- We need the number of Stack Overflow questions that contain each of ten Android‑related
-- tags.  Because tags in this dataset are stored as a single pipe‑delimited string
-- (e.g. "android|android-intent|firebase"), we must:
--   • Convert the string to lowercase for uniform matching.
--   • Split it on the pipe character to create an array of individual tags.
--   • Unnest that array so each tag becomes its own row.
--   • Keep only rows whose tag is one of the ten we care about.
--   • Group by tag and count rows to get the total questions per tag.
--   • Sort by the count, show up to 20 results.
SELECT
  tag,
  COUNT(*) AS total_qs
FROM
  `bigquery-public-data.stackoverflow.posts_questions`
CROSS JOIN
  UNNEST(SPLIT(LOWER(tags), '|')) AS tag
WHERE
  tag IN ('android-layout', 'android-activity', 'android-intent',
          'android-edittext', 'android-fragments', 'android-recyclerview',
          'listview', 'android-actionbar', 'google-maps', 'android-asynctask')
GROUP BY
  tag
ORDER BY
  total_qs DESC
LIMIT
  20;
