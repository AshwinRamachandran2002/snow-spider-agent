Query:
--Description: (10)  FINAL ANSWER – top 50 most‑viewed questions for every Android tag
--that has at least 50 qualifying “how” questions, excluding troubleshooting words.
WITH raw AS (
  SELECT
    id,
    title,
    body,
    view_count,
    SPLIT(LOWER(tags), '|') AS tag_arr
  FROM
    `bigquery-public-data.stackoverflow.posts_questions`
  WHERE
    (REGEXP_CONTAINS(LOWER(title), r'\bhow\b')
     OR REGEXP_CONTAINS(LOWER(body) , r'\bhow\b'))
    AND NOT REGEXP_CONTAINS(LOWER(title || ' ' || body),
         r'\b(fail|problem|error|wrong|fix|bug|issue|solve|trouble)\b')
    AND (
         LOWER(tags) LIKE '%android-layout%'     OR LOWER(tags) LIKE '%android-activity%'   OR
         LOWER(tags) LIKE '%android-intent%'     OR LOWER(tags) LIKE '%android-edittext%'  OR
         LOWER(tags) LIKE '%android-fragments%'  OR LOWER(tags) LIKE '%android-recyclerview%' OR
         LOWER(tags) LIKE '%listview%'           OR LOWER(tags) LIKE '%android-actionbar%' OR
         LOWER(tags) LIKE '%google-maps%'        OR LOWER(tags) LIKE '%android-asynctask%'
        )
),
exploded AS (
  SELECT
    id,
    title,
    view_count,
    tag
  FROM
    raw,
    UNNEST(tag_arr) AS tag
  WHERE
    tag IN ('android-layout','android-activity','android-intent',
            'android-edittext','android-fragments','android-recyclerview',
            'listview','android-actionbar','google-maps','android-asynctask')
),
tag_ok AS (
  SELECT
    tag,
    COUNT(*) AS cnt
  FROM
    exploded
  GROUP BY
    tag
  HAVING
    cnt >= 50
