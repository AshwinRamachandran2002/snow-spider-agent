```sql
-- 6. Return only those tags that already have >= 50 qualifying questions
WITH filtered AS (
  SELECT id, tags
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  WHERE (REGEXP_CONTAINS(LOWER(title), r'\bhow\b')
         OR REGEXP_CONTAINS(LOWER(body) , r'\bhow\b'))
    AND NOT REGEXP_CONTAINS(LOWER(title || ' ' || body),
         r'\b(fail|problem|error|wrong|fix|bug|issue|solve|trouble)\b')
), exploded AS (
  SELECT id, tag
  FROM filtered, UNNEST(REGEXP_EXTRACT_ALL(tags, r'<([^>]+)>')) AS tag
  WHERE tag IN ('android-layout','android-activity','android-intent',
