Begin Exploring Related Columns
Relevant columns (and how they will be used)

• `posts_questions.id`           : unique id of each question – needed in the result  
• `posts_questions.title`        : search for the word ‘how’ / exclude trouble‑shooting words  
• `posts_questions.body`         : same textual filters as above  
• `posts_questions.tags`         : locate the Android‑related tags (`<android-layout>` …)  
• `posts_questions.view_count`   : order questions by popularity  
• (derived) `tag`                : individual tag obtained after splitting/unnesting `tags`

Main filter conditions

1. Tag filter  
   REGEXP_CONTAINS(tags,
      r'<(android-layout|android-activity|android-intent|android-edittext|android-fragments|android-recyclerview|listview|android-actionbar|google-maps|android-asynctask)>')

2. Contains the word “how” (case‑insensitive) somewhere  
   REGEXP_CONTAINS(LOWER(title), r'\bhow\b') OR  
   REGEXP_CONTAINS(LOWER(body) , r'\bhow\b')

3. Must NOT contain any trouble‑shooting words (case‑insensitive)  
   NOT REGEXP_CONTAINS(LOWER(title || ' ' || body),
      r'\b(fail|problem|error|wrong|fix|bug|issue|solve|trouble)\b')

Below are 10 exploratory → final queries (each limited to 20 rows except the last one).  
Replace `project.dataset.table` with the real table when you reuse outside this answer.

```sql
-- 1. Peek at a few questions that have the tag <android-layout>
SELECT id, title, tags, view_count
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE REGEXP_CONTAINS(tags, r'<android-layout>')
LIMIT 20;
```

```sql
-- 2. How many total questions exist for each of the 10 tags?
SELECT tag, COUNT(*) AS total_qs
FROM `bigquery-public-data.stackoverflow.posts_questions`,
UNNEST(REGEXP_EXTRACT_ALL(tags, r'<([^>]+)>')) AS tag
WHERE tag IN ('android-layout','android-activity','android-intent',
              'android-edittext','android-fragments','android-recyclerview',
              'listview','android-actionbar','google-maps','android-asynctask')
GROUP BY tag
LIMIT 20;
```

```sql
-- 3. Examples that contain the word “how” (any tag)
SELECT id, title, tags
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE (REGEXP_CONTAINS(LOWER(title), r'\bhow\b')
       OR REGEXP_CONTAINS(LOWER(body) , r'\bhow\b'))
  AND REGEXP_CONTAINS(tags, r'<(android|google).*>')
LIMIT 20;
```

```sql
-- 4. Same as (3) but be sure they do NOT contain any trouble‑shooting word
SELECT id, title
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE (REGEXP_CONTAINS(LOWER(title), r'\bhow\b')
       OR REGEXP_CONTAINS(LOWER(body) , r'\bhow\b'))
  AND NOT REGEXP_CONTAINS(LOWER(title || ' ' || body),
       r'\b(fail|problem|error|wrong|fix|bug|issue|solve|trouble)\b')
  AND REGEXP_CONTAINS(tags, r'<(android|google).*>')
LIMIT 20;
```

```sql
-- 5. Count per tag AFTER the positive/negative text filters
WITH filtered AS (
  SELECT id, tags
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  WHERE (REGEXP_CONTAINS(LOWER(title), r'\bhow\b')
         OR REGEXP_CONTAINS(LOWER(body) , r'\bhow\b'))
    AND NOT REGEXP_CONTAINS(LOWER(title || ' ' || body),
         r'\b(fail|problem|error|wrong|fix|bug|issue|solve|trouble)\b')
)
SELECT tag, COUNT(*) AS ok_questions
FROM filtered, UNNEST(REGEXP_EXTRACT_ALL(tags, r'<([^>]+)>')) AS tag
WHERE tag IN ('android-layout','android-activity','android-intent',
              'android-edittext','android-fragments','android-recyclerview',
              'listview','android-actionbar','google-maps','android-asynctask')
GROUP BY tag
LIMIT 20;
```

```sql
-- 6. Return only those tags that already have >= 50 qualifying questions
WITH filtered AS (
  SELECT id, tags
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  WHERE (REGEXP_CONTAINS(LOWER(title), r'\bhow\b')
         OR REGEXP_CONTAINS(LOWER(body) , r'\bhow\b'))
    AND NOT REGEXP_CONTAINS(LOWER(title || ' ' || body),
         r'\b(fail|problem|error|wrong|fix|bug|issue|solve|trouble)\b')
), exploded AS (
  SELECT id, tag
  FROM filtered, UNNEST(REGEXP_EXTRACT_ALL(tags, r'<([^>]+)>')) AS tag
  WHERE tag IN ('android-layout','android-activity','android-intent',
                'android-edittext','android-fragments','android-recyclerview',
                'listview','android-actionbar','google-maps','android-asynctask')
)
SELECT tag, COUNT(*) AS qualified_cnt
FROM exploded
GROUP BY tag
HAVING qualified_cnt >= 50
LIMIT 20;
```

```sql
-- 7. For one tag (e.g., android-layout) get the TOP 20 viewed questions
SELECT id, title, view_count
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE REGEXP_CONTAINS(tags, r'<android-layout>')
  AND (REGEXP_CONTAINS(LOWER(title), r'\bhow\b')
       OR REGEXP_CONTAINS(LOWER(body) , r'\bhow\b'))
  AND NOT REGEXP_CONTAINS(LOWER(title || ' ' || body),
       r'\b(fail|problem|error|wrong|fix|bug|issue|solve|trouble)\b')
ORDER BY view_count DESC
LIMIT 20;
```

```sql
-- 8. Same as (7) but using QUALIFY ROW_NUMBER() instead of ORDER BY … LIMIT
SELECT id, title, view_count
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE REGEXP_CONTAINS(tags, r'<android-intent>')
  AND (REGEXP_CONTAINS(LOWER(title), r'\bhow\b')
       OR REGEXP_CONTAINS(LOWER(body) , r'\bhow\b'))
  AND NOT REGEXP_CONTAINS(LOWER(title || ' ' || body),
       r'\b(fail|problem|error|wrong|fix|bug|issue|solve|trouble)\b')
QUALIFY ROW_NUMBER() OVER (ORDER BY view_count DESC) <= 20;
```

```sql
-- 9. Explode tags and keep only the 10 Android tags, show one sample row each
SELECT DISTINCT tag, id, title
FROM `bigquery-public-data.stackoverflow.posts_questions`,
UNNEST(REGEXP_EXTRACT_ALL(tags, r'<([^>]+)>')) AS tag
WHERE tag IN ('android-layout','android-activity','android-intent',
              'android-edittext','android-fragments','android-recyclerview',
              'listview','android-actionbar','google-maps','android-asynctask')
  AND (REGEXP_CONTAINS(LOWER(title), r'\bhow\b')
       OR REGEXP_CONTAINS(LOWER(body) , r'\bhow\b'))
  AND NOT REGEXP_CONTAINS(LOWER(title || ' ' || body),
       r'\b(fail|problem|error|wrong|fix|bug|issue|solve|trouble)\b')
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER:
--     Top‑50 most‑viewed questions per Android tag (only tags having ≥50 such questions)
WITH raw AS (
  SELECT id, title, body, view_count,
         REGEXP_EXTRACT_ALL(tags, r'<([^>]+)>') AS tag_arr
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  WHERE (REGEXP_CONTAINS(LOWER(title), r'\bhow\b')
         OR REGEXP_CONTAINS(LOWER(body) , r'\bhow\b'))
    AND NOT REGEXP_CONTAINS(LOWER(title || ' ' || body),
         r'\b(fail|problem|error|wrong|fix|bug|issue|solve|trouble)\b')
    AND REGEXP_CONTAINS(tags,
         r'<(android-layout|android-activity|android-intent|android-edittext|android-fragments|android-recyclerview|listview|android-actionbar|google-maps|android-asynctask)>')
),
exploded AS (
  SELECT id, title, view_count, tag
  FROM raw, UNNEST(tag_arr) AS tag
  WHERE tag IN ('android-layout','android-activity','android-intent',
                'android-edittext','android-fragments','android-recyclerview',
                'listview','android-actionbar','google-maps','android-asynctask')
),
tag_ok AS (
  SELECT tag, COUNT(*) AS cnt
  FROM exploded
  GROUP BY tag
  HAVING cnt >= 50
),
ranked AS (
  SELECT tag, id, title, view_count,
         ROW_NUMBER() OVER (PARTITION BY tag ORDER BY view_count DESC) AS rn
  FROM exploded
  WHERE tag IN (SELECT tag FROM tag_ok)
)
SELECT tag, id, title, view_count
FROM ranked
WHERE rn <= 50
ORDER BY tag, view_count DESC;
```

