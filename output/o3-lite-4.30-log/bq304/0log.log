```sql
--Description:
-- Thinking process:
-- 1) Identify the 10 Android‑related tags we care about; place them in a CTE (tag_list).
-- 2) Scan the Stack Overflow questions table once, joining each row to its tag via a
--    case‑insensitive LIKE so we don’t miss rows whose tag string lacks angle brackets.
-- 3) Retain only questions that (a) contain the word “how” in title or body, and
--    (b) do NOT contain any common troubleshooting words.
-- 4) For each tag, calculate:
--       • rn  = rank of the question by view_count (highest first),
--       • tag_total = total qualifying questions for that tag.
-- 5) Keep tags whose tag_total ≥ 50 and, within each, keep the top‑50 questions (rn ≤ 50).
-- 6) Finally, LIMIT 20 to show a quick sample.
WITH tag_list AS (
  SELECT 'android-layout'  AS tag UNION ALL SELECT 'android-activity' UNION ALL
  SELECT 'android-intent'           UNION ALL SELECT 'android-edittext'  UNION ALL
  SELECT 'android-fragments'        UNION ALL SELECT 'android-recyclerview' UNION ALL
  SELECT 'listview'                 UNION ALL SELECT 'android-actionbar' UNION ALL
  SELECT 'google-maps'              UNION ALL SELECT 'android-asynctask'
),
qualified AS (
  SELECT
    tl.tag,
    q.id,
    q.title,
    q.view_count,
    ROW_NUMBER() OVER (PARTITION BY tl.tag ORDER BY q.view_count DESC) AS rn,
    COUNT(*)     OVER (PARTITION BY tl.tag)                            AS tag_total
  FROM tag_list AS tl
  JOIN `bigquery-public-data.stackoverflow.posts_questions` AS q
    ON LOWER(q.tags) LIKE CONCAT('%', tl.tag, '%')
  WHERE (REGEXP_CONTAINS(LOWER(q.title), r'\bhow\b')
         OR REGEXP_CONTAINS(LOWER(q.body),  r'\bhow\b'))
    AND NOT REGEXP_CONTAINS(LOWER(q.title), r'\b(fail|problem|error|wrong|fix|bug|issue|solve|trouble)\b')
    AND NOT REGEXP_CONTAINS(LOWER(q.body),  r'\b(fail|problem|error|wrong|fix|bug|issue|solve|trouble)\b')
)
SELECT
  tag,
  id,
  title,
  view_count
FROM qualified
WHERE tag_total >= 50   -- keep only tags with ≥ 50 qualifying questions
  AND rn <= 50          -- within each tag, top 50 by views
LIMIT 20;               -- return a 20‑row preview
