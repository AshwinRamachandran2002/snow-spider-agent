  WHERE status IN ('active','closed')
    AND EXTRACT(YEAR FROM modified_date) = 2014
  GROUP BY status
)
SELECT
  w.status,
  COALESCE(c.cnt, 0) AS num_stations_2014
FROM wanted_status AS w
LEFT JOIN counts      AS c USING (status)
ORDER BY w.status;
```

```sql
--Description:  Corrected version of “#9 – Pivot counts (2013‑2014)”.
--              Creates a two‑column (active, closed) pivot and back‑fills
--              missing years with zeros.
WITH target_years AS (SELECT 2013 AS year UNION ALL SELECT 2014),
counts AS (
  SELECT
    EXTRACT(YEAR FROM modified_date)                              AS year,
    COUNT(DISTINCT IF(status = 'active', station_id, NULL)) AS active_stations,
    COUNT(DISTINCT IF(status = 'closed', station_id, NULL)) AS closed_stations
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  WHERE status IN ('active','closed')
  GROUP BY year
)
SELECT
  t.year,
