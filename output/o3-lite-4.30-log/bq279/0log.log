Query:
--Description:  Corrected version of “#6 – Distinct stations for 2013‑2014
--              but only active/closed”.  Because the table has no rows for
--              those years, we (1) build every (year,status) pair we care
--              about and (2) left‑join the real counts, filling gaps with 0.
WITH target_pairs AS (
  SELECT 2013 AS year, 'active' AS status UNION ALL
  SELECT 2013, 'closed' UNION ALL
  SELECT 2014, 'active' UNION ALL
  SELECT 2014, 'closed'
),
actual_counts AS (
  SELECT
    EXTRACT(YEAR FROM modified_date) AS year,
    status,
    COUNT(DISTINCT station_id)       AS num_stations
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  WHERE status IN ('active','closed')
  GROUP BY year, status
)
SELECT
  t.year,
  t.status,
  COALESCE(a.num_stations, 0) AS num_stations
FROM target_pairs AS t
LEFT JOIN actual_counts AS a
  ON t.year = a.year AND t.status = a.status
ORDER BY t.year, t.status
Answer:
year,status,num_stations
2013,active,0
2013,closed,0
2014,active,0
2014,closed,0
