```sql
--Description:  The station table shows data only for the years 2021‑2022, so
--              there are no records whose modified_date falls in 2013 or
--              2014.  To explicitly answer the question (“How many distinct
--              active and closed stations were there in 2013 and 2014?”) we
--              1) build a small list containing just those two target years,
--              2) aggregate the station table for active/closed counts,
--              3) left‑join the aggregates onto the target‑year list so that
--                 missing years return zeros instead of dropping rows.
WITH target_years AS (
  SELECT 2013 AS year UNION ALL
  SELECT 2014
),
yearly_counts AS (
  SELECT
    EXTRACT(YEAR FROM modified_date) AS year,
    status,
    COUNT(DISTINCT station_id)       AS station_cnt
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  WHERE status IN ('active','closed')
  GROUP BY year, status
)
SELECT
  t.year,
  COALESCE(MAX(CASE WHEN status = 'active' THEN station_cnt END), 0) AS active_station_count,
  COALESCE(MAX(CASE WHEN status = 'closed' THEN station_cnt END), 0) AS closed_station_count
FROM target_years AS t
LEFT JOIN yearly_counts AS y
  ON t.year = y.year
GROUP BY t.year
ORDER BY t.year;
```
