The table structure information is ({database name: {schema name: [table name]}}): 
{'bigquery-public-data': {'austin_311': ['311_service_requests'], 'austin_bikeshare': ['bikeshare_stations', 'bikeshare_trips'], 'austin_crime': ['crime'], 'austin_incidents': ['incidents_2011', 'incidents_2008', 'incidents_2016', 'incidents_2009', 'incidents_2010'], 'austin_waste': ['waste_and_diversion']}}
Begin Exploring Related Columns
Relevant columns and how we will use them  
• `station_id`: to identify each bikeshare station – we must count DISTINCT values.  
• `status`: tells whether a station record is coded as `active`, `closed`, or something else – we will filter on the two words we care about.  
• `modified_date`: timestamp of the station record – we will EXTRACT the year so we can focus on 2013 and 2014.

Typical filter conditions  
• `EXTRACT(YEAR FROM modified_date) IN (2013, 2014)` – restrict the rows to only those two years.  
• `LOWER(status) IN ('active', 'closed')` – include only the two statuses we are comparing; the LOWER() guard handles any letter‑case variation.

Below are 10 exploratory → increasingly‑complex queries (each limited to 20 rows where a LIMIT makes sense) that build toward the final answer. Replace the project id if you query from a different billing project; here we keep the fully‑qualified table name:

```sql
-- 1. Inspect the distinct years that appear in the table
SELECT DISTINCT EXTRACT(YEAR FROM `modified_date`) AS yr
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
ORDER BY yr
LIMIT 20;
```

```sql
-- 2. See all distinct status values for years 2013 or 2014
SELECT DISTINCT LOWER(`status`) AS status_clean
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE EXTRACT(YEAR FROM `modified_date`) IN (2013, 2014)
ORDER BY status_clean;
```

```sql
-- 3. List the first 20 station‑id / status rows for 2013
SELECT `station_id`, `status`, `modified_date`
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE EXTRACT(YEAR FROM `modified_date`) = 2013
ORDER BY `station_id`
LIMIT 20;
```

```sql
-- 4. Count how many distinct stations had each status in 2013
SELECT LOWER(`status`) AS status_clean,
       COUNT(DISTINCT `station_id`) AS station_ct_2013
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE EXTRACT(YEAR FROM `modified_date`) = 2013
  AND LOWER(`status`) IN ('active', 'closed')
GROUP BY status_clean
LIMIT 20;
```

```sql
-- 5. Repeat the previous count for 2014
SELECT LOWER(`status`) AS status_clean,
       COUNT(DISTINCT `station_id`) AS station_ct_2014
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE EXTRACT(YEAR FROM `modified_date`) = 2014
  AND LOWER(`status`) IN ('active', 'closed')
GROUP BY status_clean
LIMIT 20;
```

```sql
-- 6. Get year, status, and distinct‑station count for the two target years
SELECT EXTRACT(YEAR FROM `modified_date`) AS yr,
       LOWER(`status`) AS status_clean,
       COUNT(DISTINCT `station_id`) AS station_ct
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE EXTRACT(YEAR FROM `modified_date`) IN (2013, 2014)
  AND LOWER(`status`) IN ('active', 'closed')
GROUP BY yr, status_clean
ORDER BY yr, status_clean
LIMIT 20;
```

```sql
-- 7. Same as #6 but with a common table expression (CTE)
WITH yr_status AS (
  SELECT EXTRACT(YEAR FROM `modified_date`) AS yr,
         LOWER(`status`) AS status_clean,
         `station_id`
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  WHERE EXTRACT(YEAR FROM `modified_date`) IN (2013, 2014)
    AND LOWER(`status`) IN ('active', 'closed')
)
SELECT yr,
       status_clean,
       COUNT(DISTINCT station_id) AS station_ct
FROM yr_status
GROUP BY yr, status_clean
ORDER BY yr, status_clean
LIMIT 20;
```

```sql
-- 8. Use UNION ALL to split the two years, then aggregate
SELECT yr,
       status_clean,
       COUNT(DISTINCT station_id) AS station_ct
FROM (
  SELECT 2013 AS yr,
         LOWER(`status`) AS status_clean,
         `station_id`
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  WHERE EXTRACT(YEAR FROM `modified_date`) = 2013
    AND LOWER(`status`) IN ('active', 'closed')
  UNION ALL
  SELECT 2014,
         LOWER(`status`) AS status_clean,
         `station_id`
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  WHERE EXTRACT(YEAR FROM `modified_date`) = 2014
    AND LOWER(`status`) IN ('active', 'closed')
)
GROUP BY yr, status_clean
ORDER BY yr, status_clean
LIMIT 20;
```

```sql
-- 9. Pivot the year / status result into columns (optional view)
SELECT status_clean,
       SUM(CASE WHEN yr = 2013 THEN station_ct ELSE 0 END) AS stations_2013,
       SUM(CASE WHEN yr = 2014 THEN station_ct ELSE 0 END) AS stations_2014
FROM (
  SELECT EXTRACT(YEAR FROM `modified_date`) AS yr,
         LOWER(`status`) AS status_clean,
         COUNT(DISTINCT `station_id`) AS station_ct
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  WHERE EXTRACT(YEAR FROM `modified_date`) IN (2013, 2014)
    AND LOWER(`status`) IN ('active', 'closed')
  GROUP BY yr, status_clean
)
GROUP BY status_clean
ORDER BY status_clean
LIMIT 20;
```

```sql
-- 10. Final answer: number of distinct active vs closed stations for 2013 and 2014
SELECT
  EXTRACT(YEAR FROM `modified_date`) AS year,
  LOWER(`status`) AS station_status,
  COUNT(DISTINCT `station_id`) AS num_distinct_stations
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE EXTRACT(YEAR FROM `modified_date`) IN (2013, 2014)
  AND LOWER(`status`) IN ('active', 'closed')
GROUP BY year, station_status
ORDER BY year, station_status;
```

