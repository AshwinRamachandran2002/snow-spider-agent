```sql
WITH abakan_airports AS (
    SELECT airport_code
    FROM airports_data
    WHERE json_extract(city,'$.en') = 'Abakan'
),
flight_coords AS (
    SELECT
        -- departure longitude & latitude
        CAST(SUBSTR(da.coordinates, 2,
             INSTR(da.coordinates, ',') - 2) AS REAL)               AS dep_lon,
        CAST(SUBSTR(da.coordinates,
             INSTR(da.coordinates, ',') + 1,
             INSTR(da.coordinates, ')') - INSTR(da.coordinates, ',') - 1) AS REAL) AS dep_lat,
        -- arrival longitude & latitude
        CAST(SUBSTR(aa.coordinates, 2,
             INSTR(aa.coordinates, ',') - 2) AS REAL)               AS arr_lon,
        CAST(SUBSTR(aa.coordinates,
             INSTR(aa.coordinates, ',') + 1,
             INSTR(aa.coordinates, ')') - INSTR(aa.coordinates, ',') - 1) AS REAL) AS arr_lat
    FROM flights f
    JOIN airports_data da ON da.airport_code = f.departure_airport
    JOIN airports_data aa ON aa.airport_code = f.arrival_airport
    WHERE f.departure_airport IN (SELECT airport_code FROM abakan_airports)
       OR f.arrival_airport   IN (SELECT airport_code FROM abakan_airports)
),
distances AS (
    SELECT
        6371 * acos(
            CASE
                WHEN v >  1 THEN  1       -- protect against rounding overflow
                WHEN v < -1 THEN -1
                ELSE v
            END
        ) AS distance_km
    FROM (
        SELECT
              cos(dep_lat * pi()/180.0) * cos(arr_lat * pi()/180.0)
            * cos((arr_lon - dep_lon) * pi()/180.0)
            + sin(dep_lat * pi()/180.0) * sin(arr_lat * pi()/180.0) AS v
        FROM flight_coords
    )
)
SELECT ROUND(MAX(distance_km),4) AS distance_km
FROM distances;
```
