Relevant columns and their potential usage  
airports_data.city: identify rows where the English (or Russian) city name is ‘Abakan’.  
airports_data.airport_code: obtain the IATA code(s) of Abakan airport(s).  
airports_data.coordinates: longitude / latitude (stored in the Postgres point type) needed to calculate distances.  
flights.departure_airport: match flights that leave from Abakan.  
flights.arrival_airport: match flights that land in Abakan.  
flights.flight_id / flight_no: allow us to join and inspect individual routes.  

Typical conditions that may be used  
json_extract(ad.city,'$.en') = 'Abakan'                          -- Abakan city in English  
OR json_extract(ad.city,'$.ru') LIKE '%Абакан%'                 -- Abakan city in Russian  
WHERE f.departure_airport IN (…Abakan airport codes…) OR  
      f.arrival_airport    IN (…Abakan airport codes…)          -- pick flights touching Abakan  

Below are ten exploratory → final‐answer queries (all limited to 20 rows for safety).  
Each successive query goes a step further, finishing with the query that returns
“the distance of the longest route where Abakan is either the departure or destination city (in kilometres)”.

```sql
-- 1. List all English city names to verify spelling
SELECT DISTINCT json_extract(a.city,'$.en') AS city_en
FROM airports_data AS a
ORDER BY city_en
LIMIT 20;
```

```sql
-- 2. Find the airport code(s) whose city is Abakan (EN or RU)
SELECT a.airport_code,
       json_extract(a.city,'$.en') AS city_en,
       json_extract(a.city,'$.ru') AS city_ru
FROM airports_data AS a
WHERE json_extract(a.city,'$.en') = 'Abakan'
   OR json_extract(a.city,'$.ru') LIKE '%Абакан%'
LIMIT 20;
```

```sql
-- 3. Show Abakan airport coordinates (longitude, latitude)
SELECT a.airport_code,
       (a.coordinates)[0] AS lon,
       (a.coordinates)[1] AS lat
FROM airports_data AS a
WHERE json_extract(a.city,'$.en') = 'Abakan'
LIMIT 20;
```

```sql
-- 4. Flights that DEPART from Abakan
SELECT f.flight_id,
       f.flight_no,
       f.departure_airport,
       f.arrival_airport
FROM flights AS f
WHERE f.departure_airport IN (
        SELECT airport_code
        FROM airports_data
        WHERE json_extract(city,'$.en') = 'Abakan'
      )
LIMIT 20;
```

```sql
-- 5. Flights that ARRIVE to Abakan
SELECT f.flight_id,
       f.flight_no,
       f.departure_airport,
       f.arrival_airport
FROM flights AS f
WHERE f.arrival_airport IN (
        SELECT airport_code
        FROM airports_data
        WHERE json_extract(city,'$.en') = 'Abakan'
      )
LIMIT 20;
```

```sql
-- 6. Join flights touching Abakan with both airports’ coordinates
SELECT f.flight_id,
       da.airport_code AS dep_code,
       (da.coordinates)[1] AS dep_lat,
       (da.coordinates)[0] AS dep_lon,
       aa.airport_code AS arr_code,
       (aa.coordinates)[1] AS arr_lat,
       (aa.coordinates)[0] AS arr_lon
FROM flights        AS f
JOIN airports_data  AS da ON da.airport_code = f.departure_airport
JOIN airports_data  AS aa ON aa.airport_code = f.arrival_airport
WHERE da.airport_code IN (
        SELECT airport_code FROM airports_data
        WHERE json_extract(city,'$.en') = 'Abakan'
      )
   OR aa.airport_code IN (
        SELECT airport_code FROM airports_data
        WHERE json_extract(city,'$.en') = 'Abakan'
      )
LIMIT 20;
```

```sql
-- 7. Compute great‑circle distance (km) for each route departing Abakan
SELECT f.flight_id,
       f.flight_no,
       ROUND(
         111.111 *
         ACOS( LEAST(1,
           COS(RADIANS((da.coordinates)[1])) * COS(RADIANS((aa.coordinates)[1])) *
           COS(RADIANS((aa.coordinates)[0] - (da.coordinates)[0])) +
           SIN(RADIANS((da.coordinates)[1])) * SIN(RADIANS((aa.coordinates)[1]))
         )), 1) AS distance_km
FROM flights        AS f
JOIN airports_data  AS da ON da.airport_code = f.departure_airport
JOIN airports_data  AS aa ON aa.airport_code = f.arrival_airport
WHERE da.airport_code IN (
        SELECT airport_code FROM airports_data
        WHERE json_extract(city,'$.en') = 'Abakan'
      )
LIMIT 20;
```

```sql
-- 8. Compute great‑circle distance (km) for each route arriving Abakan
SELECT f.flight_id,
       f.flight_no,
       ROUND(
         111.111 *
         ACOS( LEAST(1,
           COS(RADIANS((da.coordinates)[1])) * COS(RADIANS((aa.coordinates)[1])) *
           COS(RADIANS((aa.coordinates)[0] - (da.coordinates)[0])) +
           SIN(RADIANS((da.coordinates)[1])) * SIN(RADIANS((aa.coordinates)[1]))
         )), 1) AS distance_km
FROM flights        AS f
JOIN airports_data  AS da ON da.airport_code = f.departure_airport
JOIN airports_data  AS aa ON aa.airport_code = f.arrival_airport
WHERE aa.airport_code IN (
        SELECT airport_code FROM airports_data
        WHERE json_extract(city,'$.en') = 'Abakan'
      )
LIMIT 20;
```

```sql
-- 9. Combine both directions, attach distance, order by distance desc
SELECT DISTINCT f.flight_id,
       f.flight_no,
       da.airport_code AS dep,
       aa.airport_code AS arr,
       ROUND(
         111.111 *
         ACOS( LEAST(1,
           COS(RADIANS((da.coordinates)[1])) * COS(RADIANS((aa.coordinates)[1])) *
           COS(RADIANS((aa.coordinates)[0] - (da.coordinates)[0])) +
           SIN(RADIANS((da.coordinates)[1])) * SIN(RADIANS((aa.coordinates)[1]))
         )), 1) AS distance_km
FROM flights        AS f
JOIN airports_data  AS da ON da.airport_code = f.departure_airport
JOIN airports_data  AS aa ON aa.airport_code = f.arrival_airport
WHERE da.airport_code IN (
        SELECT airport_code FROM airports_data
        WHERE json_extract(city,'$.en') = 'Abakan'
      )
   OR aa.airport_code IN (
        SELECT airport_code FROM airports_data
        WHERE json_extract(city,'$.en') = 'Abakan'
      )
ORDER BY distance_km DESC
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: the longest distance (km) for any route where Abakan is 
--     origin OR destination
SELECT MAX(
       111.111 *
       ACOS( LEAST(1,
         COS(RADIANS((da.coordinates)[1])) * COS(RADIANS((aa.coordinates)[1])) *
         COS(RADIANS((aa.coordinates)[0] - (da.coordinates)[0])) +
         SIN(RADIANS((da.coordinates)[1])) * SIN(RADIANS((aa.coordinates)[1]))
       ))
     ) AS longest_route_km
FROM flights        AS f
JOIN airports_data  AS da ON da.airport_code = f.departure_airport
JOIN airports_data  AS aa ON aa.airport_code = f.arrival_airport
WHERE da.airport_code IN (
        SELECT airport_code FROM airports_data
        WHERE json_extract(city,'$.en') = 'Abakan'
      )
   OR aa.airport_code IN (
        SELECT airport_code FROM airports_data
        WHERE json_extract(city,'$.en') = 'Abakan'
      );
```
