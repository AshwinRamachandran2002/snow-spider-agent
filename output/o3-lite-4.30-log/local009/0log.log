```sql
WITH RECURSIVE
    abakan_airports AS (
        SELECT airport_code
        FROM airports_data
        WHERE json_extract(city,'$.en') = 'Abakan'
    ),
    coords AS (
        SELECT
            airport_code,
            CAST(substr(coordinates, 2, instr(coordinates, ',') - 2) AS REAL)  AS lon,
            CAST(substr(coordinates,
                        instr(coordinates, ',') + 1,
                        instr(coordinates, ')') - instr(coordinates, ',') - 1) AS REAL) AS lat
        FROM airports_data
    ),
    routes AS (
        SELECT f.flight_id,
               f.departure_airport AS dep_code,
               f.arrival_airport   AS arr_code
        FROM flights AS f
        JOIN abakan_airports a
          ON f.departure_airport = a.airport_code
          OR f.arrival_airport   = a.airport_code
    ),
    haversine AS (
        SELECT
            r.flight_id,
            (
                sin((arr.lat - dep.lat) * 3.141592653589793 / 360.0)
              * sin((arr.lat - dep.lat) * 3.141592653589793 / 360.0)
              +
                cos(dep.lat * 3.141592653589793 / 180.0)
              * cos(arr.lat * 3.141592653589793 / 180.0)
              * sin((arr.lon - dep.lon) * 3.141592653589793 / 360.0)
              * sin((arr.lon - dep.lon) * 3.141592653589793 / 360.0)
            ) AS a_val
        FROM routes r
        JOIN coords dep ON dep.airport_code = r.dep_code
        JOIN coords arr ON arr.airport_code = r.arr_code
    ),
    /* Newton–Raphson iterations to approximate sqrt(a_val) */
    sqrt_iter(flight_id, a_val, x, i) AS (
        SELECT flight_id, a_val, 1.0, 0
        FROM haversine
        UNION ALL
        SELECT flight_id,
               a_val,
               (x + a_val / x) / 2.0,
               i + 1
        FROM sqrt_iter
        WHERE i < 10
    ),
    sqrt_final AS (
        SELECT flight_id, x AS sqrt_a
        FROM sqrt_iter
        WHERE i = 10
    ),
    distances AS (
        SELECT
            2 * 6371 * asin(CASE WHEN a_val = 0 THEN 0 ELSE sqrt_a END) AS distance_km
        FROM sqrt_final
        JOIN haversine USING (flight_id)
    )
SELECT ROUND(MAX(distance_km), 4) AS distance_km
FROM distances;
