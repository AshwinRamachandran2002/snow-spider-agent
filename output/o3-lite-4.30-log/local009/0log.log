Relevant columns and their purpose  
• airports_data.city ( jsonb ): look‑up rows where the English city name is ‘Abakan’.  
• airports_data.airport_code: Abakan’s three‑letter IATA code(s); join key to flights.  
• airports_data.coordinates ( point ): longitude (x) and latitude (y) of every airport; needed to calculate great‑circle distance.  
• flights.departure_airport / flights.arrival_airport: identify every route that starts or ends in Abakan.

Below are ten exploratory → analytic queries (each limited to 20 rows where applicable) that progress from finding Abakan’s airport to computing the maximum distance.  
All queries are written for Postgre‑SQL/SQLite syntax used in the supplied schema.

```sql
-- 1. See how the city is written in the JSON column
SELECT DISTINCT city
FROM airports_data
WHERE city ->> 'en' ILIKE '%abakan%'
LIMIT 20;
```

```sql
-- 2. Fetch the IATA code(s) of Abakan airport(s)
SELECT airport_code
FROM airports_data
WHERE city ->> 'en' = 'Abakan';
```

```sql
-- 3. List flights that DEPART from Abakan
SELECT flight_no, scheduled_departure, arrival_airport
FROM flights
WHERE departure_airport IN (
      SELECT airport_code
      FROM airports_data
      WHERE city ->> 'en' = 'Abakan')
LIMIT 20;
```

```sql
-- 4. List flights that ARRIVE at Abakan
SELECT flight_no, scheduled_departure, departure_airport
FROM flights
WHERE arrival_airport IN (
      SELECT airport_code
      FROM airports_data
      WHERE city ->> 'en' = 'Abakan')
LIMIT 20;
```

```sql
-- 5. Show all the other airports that are paired with Abakan
SELECT DISTINCT
       CASE
           WHEN f.departure_airport = aba.airport_code THEN f.arrival_airport
           ELSE f.departure_airport
       END AS other_airport
FROM flights AS f
JOIN airports_data AS aba
  ON aba.airport_code = ANY(ARRAY[f.departure_airport, f.arrival_airport])
WHERE aba.city ->> 'en' = 'Abakan'
LIMIT 20;
```

```sql
-- 6. Display coordinates of Abakan and its counterpart airports
SELECT a1.airport_code AS abakan_code,
       a1.coordinates    AS abakan_point,
       a2.airport_code   AS other_code,
       a2.coordinates    AS other_point
FROM airports_data a1
JOIN flights       f  ON f.departure_airport = a1.airport_code
JOIN airports_data a2 ON a2.airport_code     = f.arrival_airport
WHERE a1.city ->> 'en' = 'Abakan'
LIMIT 20;
```

```sql
-- 7. Extract numeric longitude / latitude from the point column
SELECT airport_code,
       coordinates[0] AS lon,
       coordinates[1] AS lat
FROM airports_data
WHERE airport_code IN ('ABA')   -- replace with result from query #2
LIMIT 20;
```

```sql
-- 8. Compute great‑circle distance (Haversine) for every Abakan route
WITH abakan AS (
     SELECT airport_code FROM airports_data WHERE city ->> 'en' = 'Abakan'
)
SELECT f.flight_no,
       dep.airport_code AS dep_code,
       arr.airport_code AS arr_code,
       ROUND(
         2 * 6371 * ASIN(
             SQRT(
                 POWER(SIN(RADIANS((arr.coordinates[1]-dep.coordinates[1])/2)),2)
               + COS(RADIANS(dep.coordinates[1]))
               * COS(RADIANS(arr.coordinates[1]))
               * POWER(SIN(RADIANS((arr.coordinates[0]-dep.coordinates[0])/2)),2)
             )
         )
       ) AS distance_km
FROM flights f
JOIN airports_data dep ON dep.airport_code = f.departure_airport
JOIN airports_data arr ON arr.airport_code = f.arrival_airport
WHERE f.departure_airport IN (SELECT airport_code FROM abakan)
   OR f.arrival_airport   IN (SELECT airport_code FROM abakan)
LIMIT 20;
```

```sql
-- 9. Rank Abakan routes by distance
WITH abakan AS (
     SELECT airport_code FROM airports_data WHERE city ->> 'en' = 'Abakan'
),
dists AS (
     SELECT
         f.flight_no,
         dep.airport_code AS dep_code,
         arr.airport_code AS arr_code,
         ROUND(
           2 * 6371 * ASIN(
               SQRT(
                   POWER(SIN(RADIANS((arr.coordinates[1]-dep.coordinates[1])/2)),2)
                 + COS(RADIANS(dep.coordinates[1]))
                 * COS(RADIANS(arr.coordinates[1]))
                 * POWER(SIN(RADIANS((arr.coordinates[0]-dep.coordinates[0])/2)),2)
               )
           )
         ) AS distance_km
     FROM flights f
     JOIN airports_data dep ON dep.airport_code = f.departure_airport
     JOIN airports_data arr ON arr.airport_code = f.arrival_airport
     WHERE f.departure_airport IN (SELECT airport_code FROM abakan)
        OR f.arrival_airport   IN (SELECT airport_code FROM abakan)
)
SELECT *
FROM dists
ORDER BY distance_km DESC
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: the longest Abakan route (distance in kilometres)
WITH abakan AS (
     SELECT airport_code FROM airports_data WHERE city ->> 'en' = 'Abakan'
),
dists AS (
     SELECT
         ROUND(
           2 * 6371 * ASIN(
               SQRT(
                   POWER(SIN(RADIANS((arr.coordinates[1]-dep.coordinates[1])/2)),2)
                 + COS(RADIANS(dep.coordinates[1]))
                 * COS(RADIANS(arr.coordinates[1]))
                 * POWER(SIN(RADIANS((arr.coordinates[0]-dep.coordinates[0])/2)),2)
               )
           )
         ) AS distance_km
     FROM flights f
     JOIN airports_data dep ON dep.airport_code = f.departure_airport
     JOIN airports_data arr ON arr.airport_code = f.arrival_airport
     WHERE f.departure_airport IN (SELECT airport_code FROM abakan)
        OR f.arrival_airport   IN (SELECT airport_code FROM abakan)
)
SELECT MAX(distance_km) AS longest_abakan_route_km
FROM dists;
```

Running the last query returns the required single value: the distance (in kilometres) of the longest flight where Abakan is either the departure or the destination city.
