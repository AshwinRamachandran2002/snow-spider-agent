LIMIT 20;
```

```sql
-- 4. List flights that ARRIVE at Abakan
SELECT flight_no, scheduled_departure, departure_airport
FROM flights
WHERE arrival_airport IN (
      SELECT airport_code
      FROM airports_data
      WHERE city ->> 'en' = 'Abakan')
LIMIT 20;
