Begin Exploring Related Columns
Relevant columns and their possible usage  

airports_data  
• airport_code : to join with flights.departure_airport / flights.arrival_airport  
• city (jsonb) : city‑name, use WHERE city ->> 'en' LIKE '%Abakan%' to locate Abakan airport(s)  
• coordinates (point stored as text “(lon,lat)”) : needed to compute great‑circle distance  

flights  
• departure_airport / arrival_airport : to find routes that start or end in Abakan  
• flight_id (and other columns)   : to filter / aggregate by individual flight legs  

Typical conditions we will use  
• city ->> 'en' LIKE '%Abakan%'                -- identify Abakan airport(s)  
• departure_airport IN ( … ) OR arrival_airport IN ( … )   -- flights touching Abakan  
• HAVERSINE formula on the two coordinates to measure distance  
   (lat & lon will be extracted from the “(lon,lat)” string inside coordinates)

Below are ten exploratory SQLite‑style queries that gradually reach the final answer.  
(All queries are read‑only, use DISTINCT when helpful and show at most 20 rows.)

```sql
-- 1. List every city value so we see how Abakan is stored
SELECT DISTINCT json_extract(city, '$.en') AS city_en
FROM airports_data
LIMIT 20;
```

```sql
-- 2. Find the airport code(s) whose English city name contains 'Abakan'
SELECT airport_code,
       json_extract(city, '$.en') AS city_en,
       json_extract(airport_name, '$.en') AS airport_en
FROM airports_data
WHERE json_extract(city, '$.en') LIKE '%Abakan%'
LIMIT 20;
```

```sql
-- 3. Show a few flights that DEPART from Abakan
SELECT flight_id,
       flight_no,
       departure_airport,
       arrival_airport,
       scheduled_departure
FROM flights
WHERE departure_airport IN (                 -- Abakan airport(s)
      SELECT airport_code
      FROM airports_data
      WHERE json_extract(city, '$.en') LIKE '%Abakan%')
LIMIT 20;
```

```sql
-- 4. Show a few flights that ARRIVE in Abakan
SELECT flight_id,
       flight_no,
       departure_airport,
       arrival_airport,
       scheduled_arrival
FROM flights
WHERE arrival_airport IN (
      SELECT airport_code
      FROM airports_data
      WHERE json_extract(city, '$.en') LIKE '%Abakan%')
LIMIT 20;
```

```sql
-- 5. Collect all distinct airport pairs that contain Abakan in either end
SELECT DISTINCT departure_airport,
       arrival_airport
FROM flights
WHERE departure_airport IN (
          SELECT airport_code
          FROM airports_data
          WHERE json_extract(city, '$.en') LIKE '%Abakan%')
   OR  arrival_airport   IN (
          SELECT airport_code
          FROM airports_data
          WHERE json_extract(city, '$.en') LIKE '%Abakan%')
LIMIT 20;
```

```sql
-- 6. Bring in the coordinates of both airports for those routes
SELECT f.departure_airport,
       f.arrival_airport,
       a1.coordinates  AS dep_coord,
       a2.coordinates  AS arr_coord
FROM   flights AS f
JOIN   airports_data AS a1 ON a1.airport_code = f.departure_airport
JOIN   airports_data AS a2 ON a2.airport_code = f.arrival_airport
WHERE  f.departure_airport IN (
           SELECT airport_code
           FROM airports_data
           WHERE json_extract(city, '$.en') LIKE '%Abakan%')
    OR f.arrival_airport   IN (
           SELECT airport_code
           FROM airports_data
           WHERE json_extract(city, '$.en') LIKE '%Abakan%')
LIMIT 20;
```

```sql
-- 7. Extract numeric longitude / latitude from the “(lon,lat)” text point
--    for the departure side only (check the parsing works)
SELECT airport_code,
       CAST(substr(coordinates, 2, instr(coordinates, ',') - 2) AS REAL) AS lon,
       CAST(substr(coordinates,
                   instr(coordinates, ',') + 1,
                   instr(coordinates, ')') - instr(coordinates, ',') - 1) AS REAL) AS lat
FROM   airports_data
WHERE  json_extract(city, '$.en') LIKE '%Abakan%'
LIMIT 20;
```

```sql
-- 8. Compute the great‑circle distance (Haversine) for each route touching Abakan
--    6371 km is Earth radius. All trig functions in SQLite use radians.
WITH abakan_routes AS (
     SELECT f.flight_id,
            f.departure_airport,
            f.arrival_airport,
            -- dep lon/lat
            CAST(substr(a1.coordinates,2,
                 instr(a1.coordinates,',')-2) AS REAL) AS dep_lon,
            CAST(substr(a1.coordinates,
                 instr(a1.coordinates,',')+1,
                 instr(a1.coordinates,')')-instr(a1.coordinates,',')-1) AS REAL) AS dep_lat,
            -- arr lon/lat
            CAST(substr(a2.coordinates,2,
                 instr(a2.coordinates,',')-2) AS REAL) AS arr_lon,
            CAST(substr(a2.coordinates,
                 instr(a2.coordinates,',')+1,
                 instr(a2.coordinates,')')-instr(a2.coordinates,',')-1) AS REAL) AS arr_lat
     FROM  flights AS f
     JOIN  airports_data AS a1 ON a1.airport_code = f.departure_airport
     JOIN  airports_data AS a2 ON a2.airport_code = f.arrival_airport
     WHERE f.departure_airport IN (
               SELECT airport_code
               FROM airports_data
               WHERE json_extract(city, '$.en') LIKE '%Abakan%')
        OR f.arrival_airport   IN (
               SELECT airport_code
               FROM airports_data
               WHERE json_extract(city, '$.en') LIKE '%Abakan%')
)
SELECT flight_id,
       departure_airport,
       arrival_airport,
       6371.0 * acos(
            cos(radians(dep_lat)) * cos(radians(arr_lat)) *
            cos(radians(arr_lon) - radians(dep_lon)) +
            sin(radians(dep_lat)) * sin(radians(arr_lat))
       ) AS distance_km
FROM   abakan_routes
LIMIT 20;
```

```sql
-- 9. Aggregate: get the maximum distance among those routes
WITH abakan_routes AS (
     SELECT f.flight_id,
            f.departure_airport,
            f.arrival_airport,
            CAST(substr(a1.coordinates,2,
                 instr(a1.coordinates,',')-2) AS REAL) AS dep_lon,
            CAST(substr(a1.coordinates,
                 instr(a1.coordinates,',')+1,
                 instr(a1.coordinates,')')-instr(a1.coordinates,',')-1) AS REAL) AS dep_lat,
            CAST(substr(a2.coordinates,2,
                 instr(a2.coordinates,',')-2) AS REAL) AS arr_lon,
            CAST(substr(a2.coordinates,
                 instr(a2.coordinates,',')+1,
                 instr(a2.coordinates,')')-instr(a2.coordinates,',')-1) AS REAL) AS arr_lat
     FROM  flights AS f
     JOIN  airports_data AS a1 ON a1.airport_code = f.departure_airport
     JOIN  airports_data AS a2 ON a2.airport_code = f.arrival_airport
     WHERE f.departure_airport IN (
               SELECT airport_code
               FROM airports_data
               WHERE json_extract(city, '$.en') LIKE '%Abakan%')
        OR f.arrival_airport   IN (
               SELECT airport_code
               FROM airports_data
               WHERE json_extract(city, '$.en') LIKE '%Abakan%')
)
SELECT MAX(6371.0 * acos(
            cos(radians(dep_lat)) * cos(radians(arr_lat)) *
            cos(radians(arr_lon) - radians(dep_lon)) +
            sin(radians(dep_lat)) * sin(radians(arr_lat))
       ))    AS longest_distance_km
FROM   abakan_routes;
```

```sql
-- 10. Return the single longest route with its distance and the other city’s name
WITH abakan_routes AS (
     SELECT f.flight_id,
            f.departure_airport,
            f.arrival_airport,
            CAST(substr(a1.coordinates,2,
                 instr(a1.coordinates,',')-2) AS REAL) AS dep_lon,
            CAST(substr(a1.coordinates,
                 instr(a1.coordinates,',')+1,
                 instr(a1.coordinates,')')-instr(a1.coordinates,',')-1) AS REAL) AS dep_lat,
            CAST(substr(a2.coordinates,2,
                 instr(a2.coordinates,',')-2) AS REAL) AS arr_lon,
            CAST(substr(a2.coordinates,
                 instr(a2.coordinates,',')+1,
                 instr(a2.coordinates,')')-instr(a2.coordinates,',')-1) AS REAL) AS arr_lat
     FROM  flights AS f
     JOIN  airports_data AS a1 ON a1.airport_code = f.departure_airport
     JOIN  airports_data AS a2 ON a2.airport_code = f.arrival_airport
     WHERE f.departure_airport IN (
               SELECT airport_code
               FROM airports_data
               WHERE json_extract(city, '$.en') LIKE '%Abakan%')
        OR f.arrival_airport   IN (
               SELECT airport_code
               FROM airports_data
               WHERE json_extract(city, '$.en') LIKE '%Abakan%')
), calc AS (
     SELECT *,
            6371.0 * acos(
               cos(radians(dep_lat)) * cos(radians(arr_lat)) *
               cos(radians(arr_lon) - radians(dep_lon)) +
               sin(radians(dep_lat)) * sin(radians(arr_lat))
            ) AS distance_km
     FROM abakan_routes
)
SELECT flight_id,
       departure_airport,
       arrival_airport,
       ROUND(distance_km, 1) AS distance_km
FROM   calc
ORDER  BY distance_km DESC
LIMIT 1;
```

Running query 9 (or 10) will give you the required number:  
the maximum distance, in kilometres, of any flight leg whose origin or destination city is Abakan.
