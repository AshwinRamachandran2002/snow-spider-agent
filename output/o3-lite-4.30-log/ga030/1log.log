SELECT
  user_pseudo_id,
  MIN(PARSE_DATE('%Y%m%d',event_date)) AS first_session_date
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE event_name = 'session_start'
  AND PARSE_DATE('%Y%m%d',event_date) >= DATE '2018-07-02'
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
--Description: 5.  Transform the first visit date into the Monday of its week (cohort_week)
SELECT
  user_pseudo_id,
  DATE_TRUNC(MIN(PARSE_DATE('%Y%m%d',event_date)), WEEK(MONDAY)) AS cohort_week
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE event_name = 'session_start'
  AND PARSE_DATE('%Y%m%d',event_date) >= DATE '2018-07-02'
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
--Description: 6.  Count how many users are in each weekly cohort
SELECT
  DATE_TRUNC(MIN(PARSE_DATE('%Y%m%d',event_date)), WEEK(MONDAY)) AS cohort_week,
  COUNT(DISTINCT user_pseudo_id)                          AS cohort_users
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE event_name = 'session_start'
  AND PARSE_DATE('%Y%m%d',event_date) >= DATE '2018-07-02'
GROUP BY cohort_week
ORDER BY cohort_week
LIMIT 20;
```

```sql
--Description: 7.  Mark every user who came back in his/her 4th week (day 22–28 after day‑0)
WITH first_visit AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d',event_date))                      AS first_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d',event_date) >= DATE '2018-07-02'
  GROUP BY user_pseudo_id
)
SELECT
  fv.user_pseudo_id,
  fv.first_date,
  MIN(Date_diff(PARSE_DATE('%Y%m%d',e.event_date), fv.first_date, DAY)) AS min_delta
FROM first_visit fv
JOIN `firebase-public-project.analytics_153293282.events_*` e
  ON e.user_pseudo_id = fv.user_pseudo_id
WHERE e.event_name = 'session_start'
  AND Date_diff(PARSE_DATE('%Y%m%d',e.event_date), fv.first_date, DAY) BETWEEN 22 AND 28
GROUP BY fv.user_pseudo_id, fv.first_date
LIMIT 20;
```

```sql
--Description: 8.  Calculate the 4th‑week return flag for every user
WITH first_visit AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d',event_date))                      AS first_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d',event_date) >= DATE '2018-07-02'
  GROUP BY user_pseudo_id
), fourth_week_return AS (
  SELECT DISTINCT user_pseudo_id
  FROM first_visit fv
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = fv.user_pseudo_id
  WHERE e.event_name = 'session_start'
    AND Date_diff(PARSE_DATE('%Y%m%d',e.event_date), fv.first_date, DAY) BETWEEN 22 AND 28
)
SELECT
  fv.user_pseudo_id,
  fv.first_date,
  IF(fwr.user_pseudo_id IS NULL, 0, 1) AS returned_wk4
FROM first_visit fv
LEFT JOIN fourth_week_return fwr
  ON fv.user_pseudo_id = fwr.user_pseudo_id
LIMIT 20;
```

```sql
--Description: 9.  Compute the 4th‑week retention rate for every weekly cohort
WITH first_visit AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d',event_date))                      AS first_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d',event_date) >= DATE '2018-07-02'
  GROUP BY user_pseudo_id
), fourth_week_return AS (
  SELECT DISTINCT user_pseudo_id
  FROM first_visit fv
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = fv.user_pseudo_id
  WHERE e.event_name = 'session_start'
    AND Date_diff(PARSE_DATE('%Y%m%d',e.event_date), fv.first_date, DAY) BETWEEN 22 AND 28
)
SELECT
  DATE_TRUNC(first_date, WEEK(MONDAY))                                 AS cohort_week,
  COUNT(*)                                                             AS cohort_users,
  SUM(IF(user_pseudo_id IN (SELECT * FROM fourth_week_return), 1, 0))  AS wk4_returning_users,
  SAFE_DIVIDE(SUM(IF(user_pseudo_id IN (SELECT * FROM fourth_week_return), 1, 0)),
              COUNT(*))                                                AS wk4_retention_rate
FROM first_visit
GROUP BY cohort_week
ORDER BY cohort_week
LIMIT 20;
```

```sql
--Description: 10.  Final answer – pick the cohort (Monday) that shows the highest 4th‑week retention
WITH first_visit AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d',event_date))                      AS first_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d',event_date) >= DATE '2018-07-02'
  GROUP BY user_pseudo_id
), fourth_week_return AS (
  SELECT DISTINCT user_pseudo_id
  FROM first_visit fv
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = fv.user_pseudo_id
  WHERE e.event_name = 'session_start'
    AND Date_diff(PARSE_DATE('%Y%m%d',e.event_date), fv.first_date, DAY) BETWEEN 22 AND 28
), cohort_stats AS (
  SELECT
    DATE_TRUNC(first_date, WEEK(MONDAY))                                 AS cohort_week,
    COUNT(*)                                                             AS cohort_users,
    SUM(IF(user_pseudo_id IN (SELECT * FROM fourth_week_return), 1, 0))  AS wk4_returning_users,
    SAFE_DIVIDE(SUM(IF(user_pseudo_id IN (SELECT * FROM fourth_week_return), 1, 0)),
                COUNT(*))                                                AS wk4_retention_rate
  FROM first_visit
  GROUP BY cohort_week
)
SELECT
  FORMAT_DATE('%Y-%m-%d', cohort_week) AS cohort_monday
FROM cohort_stats
ORDER BY wk4_retention_rate DESC
LIMIT 1;
```

Running the last statement will return a single value in the requested format, e.g.  

```
+---------------+
| cohort_monday |
+---------------+
| 2018-07-30    |
+---------------+
```

