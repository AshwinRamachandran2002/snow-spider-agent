```sql
--Description: Identify the Monday‑dated cohort (users grouped by the Monday of
--             their first session_start week, beginning 2018‑07‑02) that shows
--             the highest 4th‑week retention.  
--             ───────────────────────────────────────────────────────────────
-- Thinking process (kept as inline comments):
-- 1. first_visit  : for each user, capture their first session date and its
--                   corresponding Monday (cohort label).
-- 2. wk4_return   : flag users who record another session_start 22‑28 days
--                   after their first visit (the 4th week window).
-- 3. cohort_stats : aggregate by cohort_week to compute total users,
--                   returning users, and the retention rate.
-- 4. Final SELECT : return the cohort_week (formatted YYYY‑MM‑DD) with the
--                   highest 4‑week retention.
WITH first_visit AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_date,
    DATE_TRUNC(MIN(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY)) AS cohort_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d', event_date) >= DATE '2018-07-02'
  GROUP BY user_pseudo_id
),
wk4_return AS (
  SELECT DISTINCT fv.user_pseudo_id
  FROM first_visit fv
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = fv.user_pseudo_id
  WHERE e.event_name = 'session_start'
    AND DATE_DIFF(PARSE_DATE('%Y%m%d', e.event_date), fv.first_date, DAY)
        BETWEEN 22 AND 28            -- 4th‑week window (days 22‑28)
),
cohort_stats AS (
  SELECT
    cohort_week,
    COUNT(*) AS cohort_users,
    COUNTIF(user_pseudo_id IN (SELECT user_pseudo_id FROM wk4_return)) AS wk4_users,
    SAFE_DIVIDE(
      COUNTIF(user_pseudo_id IN (SELECT user_pseudo_id FROM wk4_return)),
      COUNT(*)
    ) AS wk4_retention_rate
  FROM first_visit
  GROUP BY cohort_week
)
SELECT FORMAT_DATE('%Y-%m-%d', cohort_week) AS cohort_monday
FROM cohort_stats
ORDER BY wk4_retention_rate DESC
LIMIT 1;
```
