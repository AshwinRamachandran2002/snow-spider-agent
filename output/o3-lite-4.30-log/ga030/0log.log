Begin Exploring Related Columns
Relevant columns and how they will be used  

• event_name : to isolate only the `"session_start"` events (sessions).  
• event_date : to know the calendar date of each event and to convert it to a DATE type.  
• user_pseudo_id : the anonymous user identifier that allows us to follow a single person over time.  
• event_timestamp : optional time ordering inside one day, but not required for weekly‑level retention.  

Main filter / conditions we will need  

• event_name = 'session_start' – keep only session events.  
• _TABLE_SUFFIX BETWEEN '20180702' AND '20181003' – the daily tables we need (July 2 → Oct 3 2018).  
• PARSE_DATE('%Y%m%d', event_date) >= DATE '2018‑07‑02' – start the cohort analysis on/after that Monday.  

Below are ten exploratory → increasingly complex SQL queries (all return ≤ 20 rows) that gradually build up to the final cohort‑retention answer.  



```sql
-- 1. List a few different event names that exist on 2 Jul 2018
SELECT DISTINCT event_name
FROM `firebase-public-project.analytics_153293282.events_20180702`
LIMIT 20;
```

```sql
-- 2. Show a random sample of raw "session_start" events on 2 Jul 2018
SELECT user_pseudo_id, event_date, event_timestamp
FROM `firebase-public-project.analytics_153293282.events_20180702`
WHERE event_name = 'session_start'
LIMIT 20;
```

```sql
-- 3. Check what calendar days are present across all tables we are allowed to query
SELECT DISTINCT PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) AS event_day
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180701' AND '20180810'
ORDER BY event_day
LIMIT 20;
```

```sql
-- 4. Earliest "session_start" date for 20 random users (to see the idea of a user's first day)
WITH first_sess AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_day
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
  GROUP BY user_pseudo_id
)
SELECT *
FROM first_sess
ORDER BY first_day
LIMIT 20;
```

```sql
-- 5. Attach each user to the Monday of the week in which their first session occurs
WITH first_sess AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_day
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
  GROUP BY user_pseudo_id
)
SELECT
  user_pseudo_id,
  first_day,
  DATE_TRUNC(first_day, WEEK(MONDAY)) AS cohort_monday
FROM first_sess
WHERE first_day >= DATE '2018-07-02'
LIMIT 20;
```

```sql
-- 6. Count the number of users in each weekly cohort (starting 2 Jul 2018)
WITH first_sess AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_day
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
  GROUP BY user_pseudo_id
)
SELECT
  DATE_TRUNC(first_day, WEEK(MONDAY)) AS cohort_monday,
  COUNT(*) AS users_in_cohort
FROM first_sess
WHERE first_day >= DATE '2018-07-02'
GROUP BY cohort_monday
ORDER BY cohort_monday
LIMIT 20;
```

```sql
-- 7. Pull back any 4‑th‑week session of each user (day 22–28 after the cohort Monday)
WITH first_sess AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_day
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
  GROUP BY user_pseudo_id
),
cohorts AS (
  SELECT
    user_pseudo_id,
    first_day,
    DATE_TRUNC(first_day, WEEK(MONDAY)) AS cohort_monday
  FROM first_sess
  WHERE first_day >= DATE '2018-07-02'
),
fourth_week_sessions AS (
  SELECT DISTINCT
    c.user_pseudo_id,
    c.cohort_monday
  FROM cohorts c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = c.user_pseudo_id
  WHERE e.event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d', e.event_date)
        BETWEEN c.cohort_monday + 21 AND c.cohort_monday + 27
)
SELECT *
FROM fourth_week_sessions
LIMIT 20;
```

```sql
-- 8. Calculate 4‑th‑week retention numbers for each cohort
WITH first_sess AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_day
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
  GROUP BY user_pseudo_id
),
cohorts AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(first_day, WEEK(MONDAY)) AS cohort_monday
  FROM first_sess
  WHERE first_day >= DATE '2018-07-02'
),
fourth_week_sessions AS (
  SELECT DISTINCT
    c.user_pseudo_id,
    c.cohort_monday
  FROM cohorts c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = c.user_pseudo_id
  WHERE e.event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d', e.event_date)
        BETWEEN c.cohort_monday + 21 AND c.cohort_monday + 27
)
SELECT
  cohort_monday,
  COUNT(DISTINCT user_pseudo_id) AS retained_week4
FROM fourth_week_sessions
GROUP BY cohort_monday
ORDER BY cohort_monday
LIMIT 20;
```

```sql
-- 9. Full retention rate (users retained / users in cohort) for each weekly cohort
WITH first_sess AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_day
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
  GROUP BY user_pseudo_id
),
cohorts AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(first_day, WEEK(MONDAY)) AS cohort_monday
  FROM first_sess
  WHERE first_day >= DATE '2018-07-02'
),
fourth_week_sessions AS (
  SELECT DISTINCT
    c.user_pseudo_id,
    c.cohort_monday
  FROM cohorts c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = c.user_pseudo_id
  WHERE e.event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d', e.event_date)
        BETWEEN c.cohort_monday + 21 AND c.cohort_monday + 27
),
cohort_sizes AS (
  SELECT cohort_monday, COUNT(*) AS total_users
  FROM cohorts
  GROUP BY cohort_monday
)
SELECT
  s.cohort_monday,
  r.retained_week4,
  s.total_users,
  SAFE_DIVIDE(r.retained_week4, s.total_users) AS week4_retention_rate
FROM cohort_sizes s
LEFT JOIN (
