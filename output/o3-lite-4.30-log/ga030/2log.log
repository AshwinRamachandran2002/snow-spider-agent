         DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(event_date)), WEEK(MONDAY)) AS cohort_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND event_date >= '20180702'
  GROUP BY user_pseudo_id
), week4 AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*` e
  JOIN firsts f USING (user_pseudo_id)
  WHERE event_name = 'session_start'
    AND DATE_DIFF(
          DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)),
          f.cohort_week, WEEK(MONDAY)) = 3
)
SELECT f.cohort_week,
       COUNT(*)                          AS cohort_size,
       COUNT(w.user_pseudo_id)           AS week4_retained,
       COUNT(w.user_pseudo_id)/COUNT(*)  AS week4_rate
FROM firsts f
LEFT JOIN week4 w USING (user_pseudo_id)
GROUP BY cohort_week
ORDER BY cohort_week
LIMIT 20;
```

```sql
-- 9. Find the cohort that has the maximum week‑4 retention rate
WITH firsts AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(event_date)), WEEK(MONDAY)) AS cohort_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND event_date >= '20180702'
  GROUP BY user_pseudo_id
), week4 AS (
  SELECT DISTINCT e.user_pseudo_id,
         f.cohort_week
  FROM `firebase-public-project.analytics_153293282.events_*` e
  JOIN firsts f USING (user_pseudo_id)
  WHERE e.event_name = 'session_start'
    AND DATE_DIFF(
          DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)),
          f.cohort_week, WEEK(MONDAY)) = 3
)
SELECT f.cohort_week,
       COUNT(*)                           AS cohort_size,
       COUNT(w.user_pseudo_id)            AS week4_retained,
       COUNT(w.user_pseudo_id)/COUNT(*)   AS week4_rate
FROM firsts f
LEFT JOIN week4 w USING (user_pseudo_id)
GROUP BY cohort_week
ORDER BY week4_rate DESC
LIMIT 20;
