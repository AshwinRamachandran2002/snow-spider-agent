```sql
-- 6. For one cohort (2018‑07‑09) find users retained in week 4
WITH base AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(event_date)), WEEK(MONDAY)) AS cohort_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND event_date >= '20180702'
  GROUP BY user_pseudo_id
),
events AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS event_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND event_date >= '20180702'
)
SELECT COUNT(DISTINCT e.user_pseudo_id) AS retained_users
FROM base b
JOIN events e
  ON e.user_pseudo_id = b.user_pseudo_id
WHERE b.cohort_week = '2018-07-09'
  AND DATE_DIFF(e.event_week, b.cohort_week, WEEK(MONDAY)) = 3
LIMIT 20;
```

```sql
-- 7. Compute size and week‑4 retention for the first three cohorts
WITH firsts AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(event_date)), WEEK(MONDAY)) AS cohort_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND event_date >= '20180702'
  GROUP BY user_pseudo_id
),
events AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS event_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND event_date >= '20180702'
)
SELECT cohort_week,
       COUNT(DISTINCT user_pseudo_id)                           AS users_in_cohort,
       COUNT(DISTINCT IF(DATE_DIFF(event_week, cohort_week, WEEK(MONDAY)) = 3,
                         user_pseudo_id, NULL))                AS week4_retained
FROM firsts
LEFT JOIN events USING (user_pseudo_id)
GROUP BY cohort_week
ORDER BY cohort_week
LIMIT 20;
```

```sql
