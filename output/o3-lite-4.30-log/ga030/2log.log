```sql
-- 6. For one cohort (2018‑07‑09) find users retained in week 4
WITH base AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(event_date)), WEEK(MONDAY)) AS cohort_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND event_date >= '20180702'
  GROUP BY user_pseudo_id
),
events AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS event_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND event_date >= '20180702'
)
SELECT COUNT(DISTINCT e.user_pseudo_id) AS retained_users
FROM base b
JOIN events e
  ON e.user_pseudo_id = b.user_pseudo_id
WHERE b.cohort_week = '2018-07-09'
  AND DATE_DIFF(e.event_week, b.cohort_week, WEEK(MONDAY)) = 3
LIMIT 20;
```

```sql
-- 7. Compute size and week‑4 retention for the first three cohorts
WITH firsts AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(event_date)), WEEK(MONDAY)) AS cohort_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND event_date >= '20180702'
  GROUP BY user_pseudo_id
),
events AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS event_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND event_date >= '20180702'
)
SELECT cohort_week,
       COUNT(DISTINCT user_pseudo_id)                           AS users_in_cohort,
       COUNT(DISTINCT IF(DATE_DIFF(event_week, cohort_week, WEEK(MONDAY)) = 3,
                         user_pseudo_id, NULL))                AS week4_retained
FROM firsts
LEFT JOIN events USING (user_pseudo_id)
GROUP BY cohort_week
ORDER BY cohort_week
LIMIT 20;
```

```sql
-- 8. Same as #7 but only week‑4 retention rate
WITH firsts AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(event_date)), WEEK(MONDAY)) AS cohort_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND event_date >= '20180702'
  GROUP BY user_pseudo_id
), week4 AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*` e
  JOIN firsts f USING (user_pseudo_id)
  WHERE event_name = 'session_start'
    AND DATE_DIFF(
          DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)),
          f.cohort_week, WEEK(MONDAY)) = 3
)
SELECT f.cohort_week,
       COUNT(*)                          AS cohort_size,
       COUNT(w.user_pseudo_id)           AS week4_retained,
       COUNT(w.user_pseudo_id)/COUNT(*)  AS week4_rate
FROM firsts f
LEFT JOIN week4 w USING (user_pseudo_id)
GROUP BY cohort_week
ORDER BY cohort_week
LIMIT 20;
```

```sql
-- 9. Find the cohort that has the maximum week‑4 retention rate
WITH firsts AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(event_date)), WEEK(MONDAY)) AS cohort_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND event_date >= '20180702'
  GROUP BY user_pseudo_id
), week4 AS (
  SELECT DISTINCT e.user_pseudo_id,
         f.cohort_week
  FROM `firebase-public-project.analytics_153293282.events_*` e
  JOIN firsts f USING (user_pseudo_id)
  WHERE e.event_name = 'session_start'
    AND DATE_DIFF(
          DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)),
          f.cohort_week, WEEK(MONDAY)) = 3
)
SELECT f.cohort_week,
       COUNT(*)                           AS cohort_size,
       COUNT(w.user_pseudo_id)            AS week4_retained,
       COUNT(w.user_pseudo_id)/COUNT(*)   AS week4_rate
FROM firsts f
LEFT JOIN week4 w USING (user_pseudo_id)
GROUP BY cohort_week
ORDER BY week4_rate DESC
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: returns the Monday date (YYYY-MM-DD) of the cohort with the highest week‑4 retention rate
WITH first_touch AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(event_date)), WEEK(MONDAY)) AS cohort_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND event_date >= '20180702'
  GROUP BY user_pseudo_id
),
week4_return AS (
  SELECT DISTINCT e.user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*` e
  JOIN first_touch f USING (user_pseudo_id)
  WHERE e.event_name = 'session_start'
    -- event happened in the 4th week (week index 3)
    AND DATE_DIFF(
          DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)),
          f.cohort_week, WEEK(MONDAY)) = 3
)
SELECT cohort_week AS best_cohort_monday
FROM (
  SELECT cohort_week,
         COUNT(*)                         AS cohort_size,
         COUNT(w.user_pseudo_id)          AS week4_retained,
         COUNT(w.user_pseudo_id)/COUNT(*) AS week4_rate,
         RANK() OVER (ORDER BY COUNT(w.user_pseudo_id)/COUNT(*) DESC) AS rnk
  FROM first_touch f
  LEFT JOIN week4_return w USING (user_pseudo_id)
  GROUP BY cohort_week
)
WHERE rnk = 1;
```

Running the last query will output a single row with the value formatted as `YYYY-MM-DD`; that date is the Monday‑based cohort whose users exhibit the highest 4‑week retention rate.
