Relevant columns, their potential usage, and typical conditions  

• citibike_trips.starttime / stoptime : restrict to 2016 rides (WHERE EXTRACT(YEAR FROM starttime)=2016)  
• citibike_trips.tripduration       : average/aggregate Citi‑Bike travel time (seconds)  
• citibike_trips.start_station_id , end_station_id : identify a “route”; used for counts and joins  
• citibike_trips.start_station_latitude / start_station_longitude  
• citibike_trips.end_station_latitude   / end_station_longitude : round to 3 decimals to align with taxi GPS  
• citibike_trips.start_station_name     : returned in the final answer  

• tlc_yellow_trips_2016.pickup_datetime / dropoff_datetime : compute taxi travel time  
• tlc_yellow_trips_2016.pickup_latitude / pickup_longitude  
• tlc_yellow_trips_2016.dropoff_latitude / dropoff_longitude : round to 3 decimals to pair with bike coordinates  

Typical conditions  
– Ignore obvious outliers (e.g. WHERE tripduration > 0 AND tripduration < 7200)  
– Ignore taxi rows with null / zero coordinates (WHERE pickup_latitude IS NOT NULL AND dropoff_latitude IS NOT NULL)  
– Round coordinates to 3 decimals: ROUND(pickup_latitude,3)  

--------------------------------------------------
Ten exploratory → final queries (all LIMIT 20)  

```sql
-- 1. Peek at Citi‑Bike rides in 2016
SELECT starttime, stoptime, tripduration
FROM `bigquery-public-data.new_york.citibike_trips`
WHERE EXTRACT(YEAR FROM starttime)=2016
LIMIT 20;
```

```sql
-- 2. Top 20 Citi‑Bike routes of 2016 by raw trip count
SELECT start_station_id, end_station_id, COUNT(*) AS rides
FROM `bigquery-public-data.new_york.citibike_trips`
WHERE EXTRACT(YEAR FROM starttime)=2016
GROUP BY start_station_id, end_station_id
ORDER BY rides DESC
LIMIT 20;
```

```sql
-- 3. Same list but add rounded GPS for later matching
SELECT
  start_station_id, end_station_id,
  ROUND(start_station_latitude,3)  AS s_lat3,
  ROUND(start_station_longitude,3) AS s_lon3,
  ROUND(end_station_latitude,3)    AS e_lat3,
  ROUND(end_station_longitude,3)   AS e_lon3,
  COUNT(*) AS rides
FROM `bigquery-public-data.new_york.citibike_trips`
WHERE EXTRACT(YEAR FROM starttime)=2016
GROUP BY 1,2,3,4,5,6
ORDER BY rides DESC
LIMIT 20;
```

```sql
-- 4. Average Citi‑Bike duration for those top 20 routes
WITH top20 AS (
  SELECT start_station_id, end_station_id
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime)=2016
  GROUP BY 1,2
  ORDER BY COUNT(*) DESC
  LIMIT 20)
SELECT t.start_station_id,
       t.end_station_id,
       AVG(tripduration) AS avg_bike_sec
FROM `bigquery-public-data.new_york.citibike_trips` b
JOIN top20 t
ON b.start_station_id = t.start_station_id
AND b.end_station_id   = t.end_station_id
WHERE EXTRACT(YEAR FROM b.starttime)=2016
GROUP BY 1,2
LIMIT 20;
```

```sql
-- 5. Sample yellow‑taxi trips with useful fields
SELECT pickup_datetime,
       dropoff_datetime,
       ROUND(pickup_latitude,3)  AS p_lat3,
       ROUND(pickup_longitude,3) AS p_lon3,
       ROUND(dropoff_latitude,3) AS d_lat3,
       ROUND(dropoff_longitude,3)AS d_lon3,
       TIMESTAMP_DIFF(dropoff_datetime, pickup_datetime, SECOND) AS taxi_sec
FROM `bigquery-public-data.new_york.tlc_yellow_trips_2016`
WHERE pickup_latitude IS NOT NULL
  AND dropoff_latitude IS NOT NULL
  AND taxi_sec BETWEEN 1 AND 7200
LIMIT 20;
```

```sql
-- 6. Average taxi duration for each rounded‑coord “route”
SELECT
  ROUND(pickup_latitude,3)  AS s_lat3,
  ROUND(pickup_longitude,3) AS s_lon3,
  ROUND(dropoff_latitude,3) AS e_lat3,
  ROUND(dropoff_longitude,3)AS e_lon3,
  AVG(TIMESTAMP_DIFF(dropoff_datetime, pickup_datetime, SECOND)) AS avg_taxi_sec,
  COUNT(*) AS taxi_trips
FROM `bigquery-public-data.new_york.tlc_yellow_trips_2016`
WHERE pickup_latitude IS NOT NULL
  AND dropoff_latitude IS NOT NULL
GROUP BY 1,2,3,4
HAVING taxi_trips >= 50   -- reduce noise
LIMIT 20;
```

```sql
-- 7. Prepare top 20 bike routes with their rounded coords & bike stats
WITH top20 AS (
  SELECT start_station_id, end_station_id,
         ROUND(start_station_latitude,3)  AS s_lat3,
         ROUND(start_station_longitude,3) AS s_lon3,
         ROUND(end_station_latitude,3)    AS e_lat3,
         ROUND(end_station_longitude,3)   AS e_lon3,
         COUNT(*) AS rides,
         AVG(tripduration) AS avg_bike_sec
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime)=2016
  GROUP BY 1,2,3,4,5,6
  ORDER BY rides DESC
  LIMIT 20)
SELECT *
FROM top20
LIMIT 20;
```

```sql
-- 8. Join bike top‑20 with taxi averages
WITH taxi AS (
  SELECT
    ROUND(pickup_latitude,3)  AS s_lat3,
    ROUND(pickup_longitude,3) AS s_lon3,
    ROUND(dropoff_latitude,3) AS e_lat3,
    ROUND(dropoff_longitude,3)AS e_lon3,
    AVG(TIMESTAMP_DIFF(dropoff_datetime, pickup_datetime, SECOND)) AS avg_taxi_sec
  FROM `bigquery-public-data.new_york.tlc_yellow_trips_2016`
  WHERE pickup_latitude IS NOT NULL
    AND dropoff_latitude IS NOT NULL
  GROUP BY 1,2,3,4)
SELECT b.*, t.avg_taxi_sec
FROM (
  /* query 7’s result */
  SELECT start_station_id, end_station_id,
         s_lat3, s_lon3, e_lat3, e_lon3,
         rides, avg_bike_sec
  FROM `project.dataset.tmp_top20`   -- assume materialised tmp from query 7
) AS b
JOIN taxi t
ON  b.s_lat3 = t.s_lat3
AND b.s_lon3 = t.s_lon3
AND b.e_lat3 = t.e_lat3
AND b.e_lon3 = t.e_lon3
LIMIT 20;
```

```sql
-- 9. Routes (within those 20) where Citi‑Bike is faster than taxis
/* reuse CTEs from query 8 directly */
WITH top20 AS (
  SELECT start_station_id, end_station_id,
         ROUND(start_station_latitude,3)  AS s_lat3,
         ROUND(start_station_longitude,3) AS s_lon3,
         ROUND(end_station_latitude,3)    AS e_lat3,
         ROUND(end_station_longitude,3)   AS e_lon3,
         COUNT(*) AS rides,
         AVG(tripduration) AS avg_bike_sec
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime)=2016
  GROUP BY 1,2,3,4,5,6
  ORDER BY rides DESC
  LIMIT 20),
taxi AS (
  SELECT
    ROUND(pickup_latitude,3)  AS s_lat3,
    ROUND(pickup_longitude,3) AS s_lon3,
    ROUND(dropoff_latitude,3) AS e_lat3,
    ROUND(dropoff_longitude,3)AS e_lon3,
    AVG(TIMESTAMP_DIFF(dropoff_datetime, pickup_datetime, SECOND)) AS avg_taxi_sec
  FROM `bigquery-public-data.new_york.tlc_yellow_trips_2016`
  WHERE pickup_latitude IS NOT NULL
    AND dropoff_latitude IS NOT NULL
  GROUP BY 1,2,3,4)
SELECT b.*, t.avg_taxi_sec
FROM top20 b
JOIN taxi t
USING (s_lat3, s_lon3, e_lat3, e_lon3)
WHERE b.avg_bike_sec < t.avg_taxi_sec
LIMIT 20;
```

```sql
-- 10. Final answer: which of those “faster‑than‑taxi” routes
--     has the longest average bike time?  Return its start station name.
WITH top20 AS (
  SELECT start_station_id, end_station_id, start_station_name,
         ROUND(start_station_latitude,3)  AS s_lat3,
         ROUND(start_station_longitude,3) AS s_lon3,
         ROUND(end_station_latitude,3)    AS e_lat3,
         ROUND(end_station_longitude,3)   AS e_lon3,
         COUNT(*) AS rides,
         AVG(tripduration) AS avg_bike_sec
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime)=2016
  GROUP BY 1,2,3,4,5,6,7
  ORDER BY rides DESC
  LIMIT 20),
taxi AS (
  SELECT
    ROUND(pickup_latitude,3)  AS s_lat3,
    ROUND(pickup_longitude,3) AS s_lon3,
    ROUND(dropoff_latitude,3) AS e_lat3,
    ROUND(dropoff_longitude,3)AS e_lon3,
    AVG(TIMESTAMP_DIFF(dropoff_datetime, pickup_datetime, SECOND)) AS avg_taxi_sec
  FROM `bigquery-public-data.new_york.tlc_yellow_trips_2016`
  WHERE pickup_latitude IS NOT NULL
    AND dropoff_latitude IS NOT NULL
  GROUP BY 1,2,3,4)
SELECT start_station_name
FROM top20 b
JOIN taxi t
USING (s_lat3, s_lon3, e_lat3, e_lon3)
WHERE b.avg_bike_sec < t.avg_taxi_sec
ORDER BY b.avg_bike_sec DESC
LIMIT 1;
```

Running the very last query will return one value – the start‑station name of the Citi‑Bike route (among the 2016 top‑20 routes) that is still faster than yellow taxis yet has the longest average bike duration.
