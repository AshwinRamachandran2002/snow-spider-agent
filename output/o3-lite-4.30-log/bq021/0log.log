```sql
--Description: 6)  Average yellow‑taxi duration (2016) for every origin‑destination pair
--             identified by their pickup / drop‑off coordinates rounded to 3 decimals.
--             A sub‑query first calculates each trip’s duration (taxi_sec) so that we
--             can keep only “reasonable” rides (1‑7 200 s).  After grouping, we retain
--             routes that have at least 50 taxi trips to reduce noise.
WITH trips AS (
  SELECT
    ROUND(pickup_latitude ,3) AS s_lat3,
    ROUND(pickup_longitude,3) AS s_lon3,
    ROUND(dropoff_latitude,3) AS e_lat3,
    ROUND(dropoff_longitude,3)AS e_lon3,
    TIMESTAMP_DIFF(dropoff_datetime, pickup_datetime, SECOND) AS taxi_sec
  FROM `bigquery-public-data.new_york.tlc_yellow_trips_2016`
  WHERE pickup_latitude  IS NOT NULL
    AND dropoff_latitude IS NOT NULL
)
SELECT
  s_lat3, s_lon3, e_lat3, e_lon3,
  AVG(taxi_sec) AS avg_taxi_sec,
  COUNT(*)      AS taxi_trips
FROM trips
WHERE taxi_sec BETWEEN 1 AND 7200
GROUP BY s_lat3, s_lon3, e_lat3, e_lon3
HAVING COUNT(*) >= 50
LIMIT 20;
```

```sql
--Description: 7)  Build a temporary table (top20) containing the 20 most‑frequent
--             Citi‑Bike routes in 2016, along with rounded 3‑decimal coordinates,
--             ride counts, and average bike trip durations.
WITH top20 AS (
  SELECT
    start_station_id, end_station_id,
    ROUND(start_station_latitude ,3) AS s_lat3,
    ROUND(start_station_longitude,3) AS s_lon3,
    ROUND(end_station_latitude   ,3) AS e_lat3,
    ROUND(end_station_longitude  ,3) AS e_lon3,
    COUNT(*)          AS rides,
    AVG(tripduration) AS avg_bike_sec
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime)=2016
  GROUP BY 1,2,3,4,5,6
  ORDER BY rides DESC
  LIMIT 20
)
SELECT *
FROM top20
LIMIT 20;
```

```sql
--Description: 8)  Join those top‑20 bike routes with their matching yellow‑taxi
--             origin‑destination pairs (rounded to 3 decimals) to attach the
--             average taxi travel time.  Both top20 and taxi averages are created
--             inside CTEs so no temp tables are required.
WITH top20 AS (
  SELECT
    start_station_id, end_station_id,
    ROUND(start_station_latitude ,3) AS s_lat3,
    ROUND(start_station_longitude,3) AS s_lon3,
    ROUND(end_station_latitude   ,3) AS e_lat3,
    ROUND(end_station_longitude  ,3) AS e_lon3,
    COUNT(*)          AS rides,
    AVG(tripduration) AS avg_bike_sec
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime)=2016
  GROUP BY 1,2,3,4,5,6
  ORDER BY rides DESC
  LIMIT 20
),
taxi AS (
  SELECT
    s_lat3, s_lon3, e_lat3, e_lon3,
    AVG(taxi_sec) AS avg_taxi_sec
  FROM (
    SELECT
      ROUND(pickup_latitude ,3) AS s_lat3,
      ROUND(pickup_longitude,3) AS s_lon3,
      ROUND(dropoff_latitude,3) AS e_lat3,
      ROUND(dropoff_longitude,3)AS e_lon3,
      TIMESTAMP_DIFF(dropoff_datetime, pickup_datetime, SECOND) AS taxi_sec
    FROM `bigquery-public-data.new_york.tlc_yellow_trips_2016`
    WHERE pickup_latitude  IS NOT NULL
      AND dropoff_latitude IS NOT NULL
      AND dropoff_datetime > pickup_datetime
  )
  WHERE taxi_sec BETWEEN 1 AND 7200
  GROUP BY s_lat3, s_lon3, e_lat3, e_lon3
)
SELECT b.*, t.avg_taxi_sec
FROM top20 AS b
JOIN taxi  AS t
USING (s_lat3, s_lon3, e_lat3, e_lon3)
LIMIT 20;
```

```sql
--Description: 9)  From the joined data, keep only those top‑20 bike routes whose
--             average bike duration is strictly lower than the corresponding
--             average taxi duration (i.e., Citi‑Bike is faster).  Show both
--             timings and ride counts for inspection.
WITH top20 AS (
  SELECT
    start_station_id, end_station_id,
    ROUND(start_station_latitude ,3) AS s_lat3,
    ROUND(start_station_longitude,3) AS s_lon3,
    ROUND(end_station_latitude   ,3) AS e_lat3,
    ROUND(end_station_longitude  ,3) AS e_lon3,
    COUNT(*)          AS rides,
    AVG(tripduration) AS avg_bike_sec
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime)=2016
  GROUP BY 1,2,3,4,5,6
  ORDER BY rides DESC
  LIMIT 20
),
taxi AS (
  SELECT
    s_lat3, s_lon3, e_lat3, e_lon3,
    AVG(taxi_sec) AS avg_taxi_sec
  FROM (
    SELECT
      ROUND(pickup_latitude ,3) AS s_lat3,
      ROUND(pickup_longitude,3) AS s_lon3,
      ROUND(dropoff_latitude,3) AS e_lat3,
      ROUND(dropoff_longitude,3)AS e_lon3,
      TIMESTAMP_DIFF(dropoff_datetime, pickup_datetime, SECOND) AS taxi_sec
    FROM `bigquery-public-data.new_york.tlc_yellow_trips_2016`
    WHERE pickup_latitude  IS NOT NULL
      AND dropoff_latitude IS NOT NULL
      AND dropoff_datetime > pickup_datetime
  )
  WHERE taxi_sec BETWEEN 1 AND 7200
  GROUP BY s_lat3, s_lon3, e_lat3, e_lon3
)
SELECT
  b.start_station_id,
  b.end_station_id,
  b.rides,
  b.avg_bike_sec,
  t.avg_taxi_sec
FROM top20 AS b
JOIN taxi  AS t
USING (s_lat3, s_lon3, e_lat3, e_lon3)
WHERE b.avg_bike_sec < t.avg_taxi_sec
LIMIT 20;
