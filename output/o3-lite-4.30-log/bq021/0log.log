--Description: 8)  Join those top‑20 bike routes with their matching yellow‑taxi
--             origin‑destination pairs (rounded to 3 decimals) to attach the
--             average taxi travel time.  Both top20 and taxi averages are created
--             inside CTEs so no temp tables are required.
WITH top20 AS (
  SELECT
    start_station_id, end_station_id,
    ROUND(start_station_latitude ,3) AS s_lat3,
    ROUND(start_station_longitude,3) AS s_lon3,
    ROUND(end_station_latitude   ,3) AS e_lat3,
    ROUND(end_station_longitude  ,3) AS e_lon3,
    COUNT(*)          AS rides,
    AVG(tripduration) AS avg_bike_sec
