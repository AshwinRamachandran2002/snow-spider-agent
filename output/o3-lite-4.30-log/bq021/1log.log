Begin Exploring Related Columns
Relevant columns, their potential uses and typical conditions  

• citibike_trips  
  – starttime / stoptime : filter 2016 rides, compute ride length if desired  
  – tripduration        : average/median duration for the route (seconds)  
  – start_station_latitude / start_station_longitude  
  – end_station_latitude   / end_station_longitude : round to 3‑decimals to define an origin‑destination “route”  
  – start_station_name / end_station_name : human readable route label  
  – start_station_id / end_station_id : alternative route key  

• tlc_yellow_trips_2016  
  – pickup_datetime / dropoff_datetime : TIMESTAMP_DIFF() gives taxi trip duration (seconds)  
  – pickup_latitude / pickup_longitude  
  – dropoff_latitude / dropoff_longitude : round to 3‑decimals to match the bike routes  
  – trip_distance, total_amount … : can be ignored for this task  
  – Common data‑quality filters: latitude/longitude IS NOT NULL, != 0, and inside NYC box  

Typical WHERE clauses  
  EXTRACT(YEAR FROM starttime)=2016  
  pickup_datetime BETWEEN '2016-01-01' AND '2016-12-31'  
  pickup_latitude BETWEEN 40 AND 41 AND pickup_longitude BETWEEN -75 AND -73  

──────────────────────────────────────────  
Ten exploratory‑to‑solution queries
```sql
-- 1. Peek at raw Citi Bike trips in 2016
SELECT *
FROM   `bigquery-public-data.new_york.citibike_trips`
WHERE  EXTRACT(YEAR FROM starttime)=2016
LIMIT 20;

-- 2. Distinct origin‑destination station name pairs in 2016
SELECT DISTINCT start_station_name, end_station_name
FROM   `bigquery-public-data.new_york.citibike_trips`
WHERE  EXTRACT(YEAR FROM starttime)=2016
LIMIT 20;

-- 3. Top 20 Citi Bike routes (by ride count) in 2016
SELECT  start_station_name,
        end_station_name,
        COUNT(*) AS rides
FROM    `bigquery-public-data.new_york.citibike_trips`
WHERE   EXTRACT(YEAR FROM starttime)=2016
GROUP BY 1,2
ORDER BY rides DESC
LIMIT 20;

-- 4. Top 20 routes with 3‑decimal rounded coordinates
SELECT  ROUND(start_station_latitude ,3) AS o_lat,
        ROUND(start_station_longitude,3) AS o_lon,
        ROUND(end_station_latitude   ,3) AS d_lat,
        ROUND(end_station_longitude  ,3) AS d_lon,
        COUNT(*) AS rides
FROM   `bigquery-public-data.new_york.citibike_trips`
WHERE  EXTRACT(YEAR FROM starttime)=2016
GROUP BY 1,2,3,4
ORDER BY rides DESC
LIMIT 20;

-- 5. Average bike duration (sec) for those top 20 coordinate routes
WITH top20 AS (
  SELECT  ROUND(start_station_latitude ,3) AS o_lat,
          ROUND(start_station_longitude,3) AS o_lon,
          ROUND(end_station_latitude   ,3) AS d_lat,
          ROUND(end_station_longitude  ,3) AS d_lon,
          COUNT(*) AS rides
  FROM   `bigquery-public-data.new_york.citibike_trips`
  WHERE  EXTRACT(YEAR FROM starttime)=2016
  GROUP BY 1,2,3,4
  ORDER BY rides DESC
  LIMIT 20)
SELECT t.*, 
       AVG(c.tripduration) AS avg_bike_sec
FROM   top20 t
JOIN   `bigquery-public-data.new_york.citibike_trips` c
  ON   ROUND(c.start_station_latitude ,3)=t.o_lat
 AND  ROUND(c.start_station_longitude,3)=t.o_lon
 AND  ROUND(c.end_station_latitude   ,3)=t.d_lat
 AND  ROUND(c.end_station_longitude  ,3)=t.d_lon
WHERE  EXTRACT(YEAR FROM c.starttime)=2016
GROUP BY t.o_lat,t.o_lon,t.d_lat,t.d_lon,t.rides
LIMIT 20;

-- 6. Quick look at 2016 yellow‑taxi trips with good coordinates
SELECT pickup_datetime, dropoff_datetime,
       pickup_latitude,  pickup_longitude,
       dropoff_latitude, dropoff_longitude
FROM   `bigquery-public-data.new_york.tlc_yellow_trips_2016`
WHERE  pickup_latitude  BETWEEN 40 AND 41
  AND  pickup_longitude BETWEEN -75 AND -73
  AND  dropoff_latitude BETWEEN 40 AND 41
  AND  dropoff_longitude BETWEEN -75 AND -73
LIMIT 20;

-- 7. Taxi durations with coordinates rounded to 3 decimals
SELECT ROUND(pickup_latitude ,3)  AS o_lat,
       ROUND(pickup_longitude,3)  AS o_lon,
       ROUND(dropoff_latitude,3)  AS d_lat,
       ROUND(dropoff_longitude,3) AS d_lon,
       TIMESTAMP_DIFF(dropoff_datetime,pickup_datetime,SECOND) AS taxi_sec
FROM   `bigquery-public-data.new_york.tlc_yellow_trips_2016`
WHERE  pickup_datetime BETWEEN '2016-01-01' AND '2016-12-31'
  AND  pickup_latitude  BETWEEN 40 AND 41
  AND  pickup_longitude BETWEEN -75 AND -73
  AND  dropoff_latitude BETWEEN 40 AND 41
  AND  dropoff_longitude BETWEEN -75 AND -73
LIMIT 20;

-- 8. Average taxi duration (sec) for the same 3‑dec routes
WITH taxi AS (
  SELECT ROUND(pickup_latitude ,3)  AS o_lat,
         ROUND(pickup_longitude,3)  AS o_lon,
         ROUND(dropoff_latitude,3)  AS d_lat,
         ROUND(dropoff_longitude,3) AS d_lon,
         TIMESTAMP_DIFF(dropoff_datetime,pickup_datetime,SECOND) AS taxi_sec
  FROM   `bigquery-public-data.new_york.tlc_yellow_trips_2016`
  WHERE  pickup_datetime BETWEEN '2016-01-01' AND '2016-12-31'
    AND  pickup_latitude  BETWEEN 40 AND 41
    AND  pickup_longitude BETWEEN -75 AND -73
    AND  dropoff_latitude BETWEEN 40 AND 41
    AND  dropoff_longitude BETWEEN -75 AND -73)
SELECT  o_lat,o_lon,d_lat,d_lon,
        AVG(taxi_sec) AS avg_taxi_sec
FROM    taxi
GROUP BY 1,2,3,4
LIMIT 20;

-- 9. Compare average durations for top 20 bike routes
WITH bike AS (
  SELECT  ROUND(start_station_latitude ,3) AS o_lat,
          ROUND(start_station_longitude,3) AS o_lon,
          ROUND(end_station_latitude   ,3) AS d_lat,
          ROUND(end_station_longitude  ,3) AS d_lon,
          AVG(tripduration) AS avg_bike_sec,
          COUNT(*) AS bike_rides
  FROM   `bigquery-public-data.new_york.citibike_trips`
  WHERE  EXTRACT(YEAR FROM starttime)=2016
  GROUP BY 1,2,3,4),
top20 AS (
  SELECT * FROM bike ORDER BY bike_rides DESC LIMIT 20),
taxi AS (
  SELECT  ROUND(pickup_latitude ,3)  AS o_lat,
          ROUND(pickup_longitude,3)  AS o_lon,
          ROUND(dropoff_latitude,3)  AS d_lat,
          ROUND(dropoff_longitude,3) AS d_lon,
          AVG( TIMESTAMP_DIFF(dropoff_datetime,pickup_datetime,SECOND) ) AS avg_taxi_sec
  FROM   `bigquery-public-data.new_york.tlc_yellow_trips_2016`
  WHERE  pickup_datetime BETWEEN '2016-01-01' AND '2016-12-31'
    AND  pickup_latitude  BETWEEN 40 AND 41
    AND  pickup_longitude BETWEEN -75 AND -73
    AND  dropoff_latitude BETWEEN 40 AND 41
    AND  dropoff_longitude BETWEEN -75 AND -73
  GROUP BY 1,2,3,4)
SELECT t20.*, tx.avg_taxi_sec
FROM   top20 t20
JOIN   taxi tx USING (o_lat,o_lon,d_lat,d_lon)
WHERE  t20.avg_bike_sec < tx.avg_taxi_sec
ORDER BY t20.avg_bike_sec DESC
LIMIT 20;

-- 10. Final answer: start station name of the bike‑is‑faster route
WITH rounded_bike AS (
  SELECT  ROUND(start_station_latitude ,3) AS o_lat,
          ROUND(start_station_longitude,3) AS o_lon,
          ROUND(end_station_latitude   ,3) AS d_lat,
          ROUND(end_station_longitude  ,3) AS d_lon,
          start_station_name,
          end_station_name,
          AVG(tripduration) AS avg_bike_sec,
          COUNT(*) AS bike_rides
  FROM   `bigquery-public-data.new_york.citibike_trips`
  WHERE  EXTRACT(YEAR FROM starttime)=2016
  GROUP BY 1,2,3,4,5,6),
top20 AS (
  SELECT * FROM rounded_bike ORDER BY bike_rides DESC LIMIT 20),
taxi AS (
  SELECT  ROUND(pickup_latitude ,3)  AS o_lat,
          ROUND(pickup_longitude,3)  AS o_lon,
          ROUND(dropoff_latitude,3)  AS d_lat,
          ROUND(dropoff_longitude,3) AS d_lon,
          AVG( TIMESTAMP_DIFF(dropoff_datetime,pickup_datetime,SECOND) ) AS avg_taxi_sec
  FROM   `bigquery-public-data.new_york.tlc_yellow_trips_2016`
  WHERE  pickup_datetime BETWEEN '2016-01-01' AND '2016-12-31'
    AND  pickup_latitude  BETWEEN 40 AND 41
    AND  pickup_longitude BETWEEN -75 AND -73
    AND  dropoff_latitude BETWEEN 40 AND 41
    AND  dropoff_longitude BETWEEN -75 AND -73
  GROUP BY 1,2,3,4)
SELECT start_station_name
FROM   top20  b
JOIN   taxi   t USING (o_lat,o_lon,d_lat,d_lon)
WHERE  b.avg_bike_sec < t.avg_taxi_sec          -- bike is faster
ORDER BY b.avg_bike_sec DESC                    -- longest bike duration among the faster ones
LIMIT 1;
```
Each successive query builds knowledge about the data, culminating in the final query that returns the required start‑station name for the specific route.
