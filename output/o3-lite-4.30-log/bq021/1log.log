WITH taxi AS (
  SELECT ROUND(pickup_latitude ,3)  AS o_lat,
         ROUND(pickup_longitude,3)  AS o_lon,
         ROUND(dropoff_latitude,3)  AS d_lat,
         ROUND(dropoff_longitude,3) AS d_lon,
         TIMESTAMP_DIFF(dropoff_datetime,pickup_datetime,SECOND) AS taxi_sec
  FROM   `bigquery-public-data.new_york.tlc_yellow_trips_2016`
  WHERE  pickup_datetime BETWEEN '2016-01-01' AND '2016-12-31'
    AND  pickup_latitude  BETWEEN 40 AND 41
    AND  pickup_longitude BETWEEN -75 AND -73
    AND  dropoff_latitude BETWEEN 40 AND 41
    AND  dropoff_longitude BETWEEN -75 AND -73)
SELECT  o_lat,o_lon,d_lat,d_lon,
        AVG(taxi_sec) AS avg_taxi_sec
FROM    taxi
GROUP BY 1,2,3,4
LIMIT 20
