```sql
--Description:  Single query that explains each step inline and returns the three races
--              whose 2021 Google overall‑hiring shares diverge the most (percentage‑point
--              difference) from the 2021 BLS average for four technology industries.
--              Steps:
--              1) bls   – filter cpsaat18 for 2021 rows in the four tech categories and
--                         compute the average race shares (bls_*).
--              2) google – pull Google’s 2021 overall hiring race shares; alias as g_*.
--              3) combined – CROSS JOIN the one‑row CTEs so every bls_* and g_* column is
--                            available in a single record.
--              4) diffs – UNPIVOT by using UNION ALL, calculating Google – BLS gaps
--                         multiplied by 100 to get percentage‑points; each branch includes
--                         the alias gap to keep column names consistent.
--              5) Final SELECT – order by absolute gap and keep the top three races.
WITH bls AS (   -- BLS tech‑industry averages for 2021
  SELECT
    AVG(percent_white)                     AS bls_white,
    AVG(percent_black_or_african_american) AS bls_black,
    AVG(percent_asian)                     AS bls_asian,
    AVG(percent_hispanic_or_latino)        AS bls_hispanic
  FROM `bigquery-public-data.bls.cpsaat18`
  WHERE year = 2021
    AND (
          LOWER(industry) IN (
            'internet publishing and broadcasting and web search portals',
            'software publishers',
            'data processing, hosting, and related services'
          )
          OR LOWER(industry_group) = 'computer systems design and related services'
        )
),
google AS (   -- Google overall hiring shares for 2021
  SELECT
    race_white           AS g_white,
    race_black           AS g_black,
    race_asian           AS g_asian,
    race_hispanic_latinx AS g_hispanic
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_hiring`
  WHERE workforce = 'overall'
    AND report_year = 2021
),
combined AS (  -- One row containing both Google and BLS numbers
  SELECT * FROM google CROSS JOIN bls
),
diffs AS (     -- Unpivot to calculate gaps
  SELECT 'White'    AS race, 100 * (g_white   - bls_white   ) AS gap FROM combined UNION ALL
  SELECT 'Black'    AS race, 100 * (g_black   - bls_black   ) AS gap FROM combined UNION ALL
  SELECT 'Asian'    AS race, 100 * (g_asian   - bls_asian   ) AS gap FROM combined UNION ALL
  SELECT 'Hispanic' AS race, 100 * (g_hispanic- bls_hispanic) AS gap FROM combined
)
SELECT race,
       ROUND(gap, 3) AS pct_point_gap
FROM diffs
ORDER BY ABS(gap) DESC
LIMIT 3;
```
