  FROM `bigquery-public-data.google_dei.dar_non_intersectional_hiring`
  WHERE workforce = 'overall'
    AND report_year = 2021
),
diffs AS (
  SELECT 'White'    AS race, 100*(google_white   - bls_white   ) AS gap FROM google, bls UNION ALL
  SELECT 'Black'    AS race, 100*(google_black   - bls_black   ) UNION ALL
  SELECT 'Asian'    AS race, 100*(google_asian   - bls_asian   ) UNION ALL
  SELECT 'Hispanic' AS race, 100*(google_hispanic- bls_hispanic)
)
SELECT race, ROUND(gap,3) AS pct_point_gap
