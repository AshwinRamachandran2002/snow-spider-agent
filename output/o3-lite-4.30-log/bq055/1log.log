```sql
--Description:  Find the three races with the largest 2021 percentage‑point gaps between
--              Google’s overall U.S. hiring mix and the 2021 BLS average for four tech
--              industries (“Internet publishing …”, “Software publishers”, “Data processing …”,
--              and “Computer systems design …”).  Steps:
--              1) bls CTE – filter cpsaat18 to those industries in 2021 and average the race
--                 shares, producing bls_white, bls_black, bls_asian, bls_hispanic.
--              2) google CTE – grab Google’s 2021 overall‑hiring race shares (aliased g_*).
--              3) diffs CTE – unpivot and compute Google‑minus‑BLS gaps in pct‑points (×100).
--              4) final SELECT – return the three races with the largest absolute gaps.
WITH bls AS (
  SELECT
    AVG(percent_white)                     AS bls_white,
    AVG(percent_black_or_african_american) AS bls_black,
    AVG(percent_asian)                     AS bls_asian,
    AVG(percent_hispanic_or_latino)        AS bls_hispanic
  FROM `bigquery-public-data.bls.cpsaat18`
  WHERE year = 2021
    AND (
          LOWER(industry) IN ('internet publishing and broadcasting and web search portals',
                              'software publishers',
                              'data processing, hosting, and related services')
          OR LOWER(industry_group) = 'computer systems design and related services'
        )
),
google AS (
  SELECT
    race_white           AS g_white,
    race_black           AS g_black,
    race_asian           AS g_asian,
    race_hispanic_latinx AS g_hispanic
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_hiring`
  WHERE workforce = 'overall'
    AND report_year = 2021
),
diffs AS (
  SELECT 'White'    AS race, 100 * (g_white   - bls_white   ) AS gap FROM google CROSS JOIN bls UNION ALL
  SELECT 'Black'    AS race, 100 * (g_black   - bls_black   ) UNION ALL
  SELECT 'Asian'    AS race, 100 * (g_asian   - bls_asian   ) UNION ALL
  SELECT 'Hispanic' AS race, 100 * (g_hispanic- bls_hispanic)
)
SELECT race,
       ROUND(gap, 3) AS pct_point_gap
FROM diffs
ORDER BY ABS(gap) DESC
LIMIT 3;
