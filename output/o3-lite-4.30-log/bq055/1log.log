FROM `bigquery-public-data.google_dei.dar_non_intersectional_hiring`
LIMIT 20;
```

```sql
-- 2) Description: 2021 overall Google hiring percentages by race
SELECT `race_asian`, `race_black`, `race_hispanic_latinx`,
       `race_native_american`, `race_white`
FROM `bigquery-public-data.google_dei.dar_non_intersectional_hiring`
WHERE `workforce` = 'overall'
  AND `report_year` = 2021
LIMIT 20;
```

```sql
-- 3) Description: Distinct years available in BLS cpsaat18
SELECT DISTINCT `year`
FROM `bigquery-public-data.bls.cpsaat18`
ORDER BY `year` DESC
LIMIT 20;
```

```sql
-- 4) Description: Sample industry names in cpsaat18 that contain “software”
SELECT DISTINCT `industry`
FROM `bigquery-public-data.bls.cpsaat18`
WHERE LOWER(`industry`) LIKE '%software%'
LIMIT 20;
```

```sql
-- 5) Description: BLS 2021 rows for the four required tech categories
SELECT `sector`, `subsector`, `industry_group`, `industry`,
       `percent_white`, `percent_black_or_african_american`,
       `percent_asian`, `percent_hispanic_or_latino`
FROM `bigquery-public-data.bls.cpsaat18`
WHERE `year` = 2021
  AND (
        LOWER(industry) IN (LOWER('Internet publishing and broadcasting and web search portals'),
                            LOWER('Software publishers'),
                            LOWER('Data processing, hosting, and related services'))
     OR LOWER(industry_group) = LOWER('Computer systems design and related services')
  )
LIMIT 20;
```

```sql
-- 6) Description: Average 2021 BLS race percentages across the four tech categories
SELECT AVG(`percent_white`)   AS bls_white,
       AVG(`percent_black_or_african_american`) AS bls_black,
       AVG(`percent_asian`)   AS bls_asian,
       AVG(`percent_hispanic_or_latino`) AS bls_hispanic
FROM `bigquery-public-data.bls.cpsaat18`
WHERE `year` = 2021
  AND (
        LOWER(industry) IN (LOWER('Internet publishing and broadcasting and web search portals'),
                            LOWER('Software publishers'),
                            LOWER('Data processing, hosting, and related services'))
     OR LOWER(industry_group) = LOWER('Computer systems design and related services')
  );
```

```sql
-- 7) Description: Put Google 2021 hiring percentages in one row (for join later)
SELECT 'google' AS src,
       `race_white`            AS google_white,
       `race_black`            AS google_black,
       `race_asian`            AS google_asian,
       `race_hispanic_latinx`  AS google_hispanic
FROM `bigquery-public-data.google_dei.dar_non_intersectional_hiring`
WHERE `workforce` = 'overall'
  AND `report_year` = 2021;
```

```sql
-- 8) Description: Combine Google and averaged BLS tech percentages, compute differences
WITH bls AS (
  SELECT AVG(`percent_white`)   AS bls_white,
         AVG(`percent_black_or_african_american`) AS bls_black,
         AVG(`percent_asian`)   AS bls_asian,
         AVG(`percent_hispanic_or_latino`) AS bls_hispanic
  FROM `bigquery-public-data.bls.cpsaat18`
  WHERE `year` = 2021
    AND (
          LOWER(industry) IN (LOWER('Internet publishing and broadcasting and web search portals'),
                              LOWER('Software publishers'),
                              LOWER('Data processing, hosting, and related services'))
       OR LOWER(industry_group) = LOWER('Computer systems design and related services')
    )
),
google AS (
  SELECT `race_white`            AS google_white,
         `race_black`            AS google_black,
         `race_asian`            AS google_asian,
         `race_hispanic_latinx`  AS google_hispanic
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_hiring`
  WHERE `workforce` = 'overall'
    AND `report_year` = 2021
)
SELECT google_white - bls_white      AS diff_white,
       google_black - bls_black      AS diff_black,
       google_asian - bls_asian      AS diff_asian,
       google_hispanic - bls_hispanic AS diff_hispanic
FROM google, bls;
```

```sql
-- 9) Description: Unpivot the differences into (race, diff) rows for easy ranking
WITH bls AS (
  SELECT AVG(`percent_white`)   AS bls_white,
         AVG(`percent_black_or_african_american`) AS bls_black,
         AVG(`percent_asian`)   AS bls_asian,
         AVG(`percent_hispanic_or_latino`) AS bls_hispanic
  FROM `bigquery-public-data.bls.cpsaat18`
  WHERE `year` = 2021
    AND (
          LOWER(industry) IN (LOWER('Internet publishing and broadcasting and web search portals'),
                              LOWER('Software publishers'),
                              LOWER('Data processing, hosting, and related services'))
       OR LOWER(industry_group) = LOWER('Computer systems design and related services')
    )
),
google AS (
  SELECT `race_white`            AS google_white,
         `race_black`            AS google_black,
         `race_asian`            AS google_asian,
         `race_hispanic_latinx`  AS google_hispanic
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_hiring`
  WHERE `workforce` = 'overall'
    AND `report_year` = 2021
),
diffs AS (
  SELECT 'White'    AS race, google_white   - bls_white    AS diff FROM google, bls UNION ALL
  SELECT 'Black'    AS race, google_black   - bls_black    AS diff UNION ALL
  SELECT 'Asian'    AS race, google_asian   - bls_asian    AS diff UNION ALL
  SELECT 'Hispanic' AS race, google_hispanic- bls_hispanic AS diff
)
SELECT *
FROM diffs
ORDER BY ABS(diff) DESC
LIMIT 20;
```

```sql
-- 10) Description: Final query – top 3 races with the largest percentage differences
WITH bls AS (
  SELECT AVG(`percent_white`)   AS bls_white,
         AVG(`percent_black_or_african_american`) AS bls_black,
         AVG(`percent_asian`)   AS bls_asian,
         AVG(`percent_hispanic_or_latino`) AS bls_hispanic
  FROM `bigquery-public-data.bls.cpsaat18`
  WHERE `year` = 2021
    AND (
          LOWER(industry) IN (LOWER('Internet publishing and broadcasting and web search portals'),
                              LOWER('Software publishers'),
                              LOWER('Data processing, hosting, and related services'))
       OR LOWER(industry_group) = LOWER('Computer systems design and related services')
    )
),
google AS (
  SELECT `race_white`            AS google_white,
         `race_black`            AS google_black,
         `race_asian`            AS google_asian,
         `race_hispanic_latinx`  AS google_hispanic
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_hiring`
  WHERE `workforce` = 'overall'
    AND `report_year` = 2021
),
diffs AS (
  SELECT 'White'    AS race, ROUND(100*(google_white   - bls_white   ),3) AS pct_point_diff FROM google, bls UNION ALL
  SELECT 'Black'    AS race, ROUND(100*(google_black   - bls_black   ),3) AS pct_point_diff UNION ALL
  SELECT 'Asian'    AS race, ROUND(100*(google_asian   - bls_asian   ),3) AS pct_point_diff UNION ALL
  SELECT 'Hispanic' AS race, ROUND(100*(google_hispanic- bls_hispanic),3) AS pct_point_diff
)
SELECT race, pct_point_diff
FROM diffs
ORDER BY ABS(pct_point_diff) DESC
LIMIT 3;
```  

