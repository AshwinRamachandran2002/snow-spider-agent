```sql
--Description:  Drop all year filters and probe the cpsaat18 table for any occurrence
--              of the word “software” (case‑insensitive, word‑boundary match) in either
--              the industry_group or industry columns.  Using REGEXP_CONTAINS with
--              COALESCE removes NULL issues and ensures we catch values like
--              “Software publishers”.  DISTINCT limits duplicates so we can quickly
--              see where—and if—the term exists.
SELECT DISTINCT
       industry_group,
       industry
FROM `bigquery-public-data.bls.cpsaat18`
WHERE REGEXP_CONTAINS(LOWER(COALESCE(industry_group, '')), r'\bsoftware\b')
   OR REGEXP_CONTAINS(LOWER(COALESCE(industry,       '')), r'\bsoftware\b')
LIMIT 20;
```
