```sql
-- 8. Description:  Combine the four tech industries and compute their average race shares.
WITH tech_bls AS (
  SELECT percent_white,
         percent_black_or_african_american AS percent_black,
         percent_asian,
         percent_hispanic_or_latino AS percent_hispanic
  FROM `bigquery-public-data.bls.cpsaat18`
  WHERE year = 2021
    AND LOWER(industry) IN (
        'internet publishing and broadcasting and web search portals',
        'software publishers',
        'data processing, hosting, and related services',
        'computer systems design and related services')
)
SELECT AVG(percent_white)    AS bls_white,
       AVG(percent_black)    AS bls_black,
       AVG(percent_asian)    AS bls_asian,
       AVG(percent_hispanic) AS bls_hispanic
FROM tech_bls;
```

```sql
-- 9. Description:  Bring in Google 2021 hiring and show the side‑by‑side values.
WITH google AS (
  SELECT race_white   AS g_white,
         race_black   AS g_black,
         race_asian   AS g_asian,
         race_hispanic_latinx AS g_hispanic
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_hiring`
  WHERE workforce = 'overall' AND report_year = 2021
),
bls AS (
  SELECT AVG(percent_white)    AS bls_white,
         AVG(percent_black_or_african_american) AS bls_black,
         AVG(percent_asian)    AS bls_asian,
         AVG(percent_hispanic_or_latino) AS bls_hispanic
  FROM `bigquery-public-data.bls.cpsaat18`
  WHERE year = 2021
    AND LOWER(industry) IN (
        'internet publishing and broadcasting and web search portals',
        'software publishers',
        'data processing, hosting, and related services',
        'computer systems design and related services')
)
SELECT *
FROM google, bls;
```

```sql
-- 10. Description:  FINAL – compute absolute percentage gaps and return the three largest.
WITH google AS (
  SELECT race_white   AS g_white,
         race_black   AS g_black,
         race_asian   AS g_asian,
         race_hispanic_latinx AS g_hispanic
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_hiring`
  WHERE workforce = 'overall' AND report_year = 2021
),
bls AS (
  SELECT AVG(percent_white)    AS bls_white,
         AVG(percent_black_or_african_american) AS bls_black,
         AVG(percent_asian)    AS bls_asian,
         AVG(percent_hispanic_or_latino) AS bls_hispanic
  FROM `bigquery-public-data.bls.cpsaat18`
  WHERE year = 2021
    AND LOWER(industry) IN (
        'internet publishing and broadcasting and web search portals',
        'software publishers',
        'data processing, hosting, and related services',
        'computer systems design and related services')
),
diff AS (
  SELECT 'White'    AS race, g_white    - bls_white    AS pct_diff FROM google, bls UNION ALL
  SELECT 'Black'    AS race, g_black    - bls_black    AS pct_diff FROM google, bls UNION ALL
  SELECT 'Asian'    AS race, g_asian    - bls_asian    AS pct_diff FROM google, bls UNION ALL
  SELECT 'Hispanic' AS race, g_hispanic - bls_hispanic AS pct_diff FROM google, bls
)
SELECT race,
       pct_diff,
       ABS(pct_diff) AS abs_diff
FROM diff
ORDER BY abs_diff DESC
LIMIT 3;
```
