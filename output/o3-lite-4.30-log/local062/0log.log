Relevant tables / columns for the task
• countries.country_name / country_id : locate Italy and get its ID  
• customers.cust_id , customers.country_id : pick all customers whose country_id = Italy’s ID  
• sales.cust_id , sales.prod_id , sales.time_id , sales.quantity_sold : get every Dec‑2021 transaction for those customers  
• costs.prod_id , costs.time_id , costs.unit_price , costs.unit_cost : bring in price and cost to compute “profit = quantity_sold × (unit_price – unit_cost)”  
• times.time_id , times.calendar_month_number , times.calendar_year : keep only rows where month = 12 and year = 2021  

Typical filter conditions  
• countries.country_name = 'Italy'  
• times.calendar_month_number = 12 AND times.calendar_year = 2021  
• sales.time_id = costs.time_id (to pair each sale with the matching cost record)  
• customers.country_id = countries.country_id  
• sales.cust_id = customers.cust_id  

Exploratory queries (all limited to 20 rows)

```sql
-- 1. Italy’s row in the countries table
SELECT * 
FROM   "countries" 
WHERE  "country_name" = 'Italy' 
LIMIT 20;
```

```sql
-- 2. Sample Italian customers (cust_id, names)
SELECT DISTINCT "cust_id",
       "cust_first_name",
       "cust_last_name"
FROM   "customers"
WHERE  "country_id" = (
       SELECT "country_id"
       FROM   "countries"
       WHERE  "country_name" = 'Italy')
LIMIT 20;
```

```sql
-- 3. December‑2021 sales done by Italian customers (basic fields)
SELECT DISTINCT s."cust_id",
       s."prod_id",
       s."time_id",
       s."quantity_sold"
FROM   "sales"   AS s
JOIN   "customers" AS c  ON c."cust_id"   = s."cust_id"
JOIN   "countries" AS co ON co."country_id" = c."country_id"
WHERE  co."country_name" = 'Italy'
  AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- 4. Check that the times dimension has the right December‑2021 rows
SELECT DISTINCT "time_id",
       "calendar_month_number",
       "calendar_year"
FROM   "times"
WHERE  "calendar_month_number" = 12
  AND  "calendar_year"        = 2021
LIMIT 20;
```

```sql
-- 5. Sample cost records that fall in December‑2021
SELECT DISTINCT "prod_id",
       "time_id",
       "unit_cost",
       "unit_price"
FROM   "costs"
WHERE  "time_id" BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- 6. One‑row profit example for an Italian customer in December‑2021
SELECT s."cust_id",
       s."prod_id",
       s."quantity_sold",
       (s."quantity_sold" * (co."unit_price" - co."unit_cost")) AS "profit"
FROM   "sales"  AS s
JOIN   "costs"  AS co ON co."prod_id" = s."prod_id"
                   AND co."time_id" = s."time_id"
JOIN   "customers" AS cu ON cu."cust_id" = s."cust_id"
JOIN   "countries" AS cr ON cr."country_id" = cu."country_id"
WHERE  cr."country_name" = 'Italy'
  AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- 7. Total December‑2021 profit per Italian customer
SELECT s."cust_id",
       SUM(s."quantity_sold" * (co."unit_price" - co."unit_cost")) AS "total_profit"
FROM   "sales"  AS s
JOIN   "costs"  AS co ON co."prod_id" = s."prod_id"
                   AND co."time_id" = s."time_id"
JOIN   "customers" AS cu ON cu."cust_id" = s."cust_id"
JOIN   "countries" AS cr ON cr."country_id" = cu."country_id"
WHERE  cr."country_name" = 'Italy'
  AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
GROUP  BY s."cust_id"
LIMIT 20;
```

```sql
-- 8. Overall min / max of those customer‑level profits
SELECT MIN("total_profit") AS "min_profit",
       MAX("total_profit") AS "max_profit"
FROM (
      SELECT s."cust_id",
             SUM(s."quantity_sold" * (co."unit_price" - co."unit_cost")) AS "total_profit"
      FROM   "sales"  AS s
      JOIN   "costs"  AS co ON co."prod_id" = s."prod_id"
                         AND co."time_id" = s."time_id"
      JOIN   "customers" AS cu ON cu."cust_id" = s."cust_id"
      JOIN   "countries" AS cr ON cr."country_id" = cu."country_id"
      JOIN   "times"     AS t  ON t."time_id" = s."time_id"
      WHERE  cr."country_name" = 'Italy'
        AND  t."calendar_month_number" = 12
        AND  t."calendar_year"        = 2021
      GROUP  BY s."cust_id"
);
```

```sql
-- 9. Attach a bucket number (1‑10) to each customer using equal‑width ranges
WITH profits AS (
     SELECT s."cust_id",
            SUM(s."quantity_sold" * (co."unit_price" - co."unit_cost")) AS "total_profit"
     FROM   "sales"  AS s
     JOIN   "costs"  AS co ON co."prod_id" = s."prod_id"
                        AND co."time_id" = s."time_id"
     JOIN   "customers" AS cu ON cu."cust_id" = s."cust_id"
     JOIN   "countries" AS cr ON cr."country_id" = cu."country_id"
     JOIN   "times"     AS t  ON t."time_id" = s."time_id"
     WHERE  cr."country_name" = 'Italy'
       AND  t."calendar_month_number" = 12
       AND  t."calendar_year"        = 2021
     GROUP  BY s."cust_id"
),
stats AS (
     SELECT MIN("total_profit") AS "min_p",
            MAX("total_profit") AS "max_p"
     FROM   profits
)
SELECT p."cust_id",
       p."total_profit",
       /* bucket 1‑10, equal‑width on profit range */
       CAST(((p."total_profit" - stats."min_p") /
             ((stats."max_p" - stats."min_p") / 10.0)) AS INTEGER) + 1
       AS "bucket"
FROM   profits AS p, stats
LIMIT 20;
```

```sql
-- 10. Final bucket summary: customers, min & max profit per bucket
WITH profits AS (
     SELECT s."cust_id",
            SUM(s."quantity_sold" * (co."unit_price" - co."unit_cost")) AS "total_profit"
     FROM   "sales"  AS s
     JOIN   "costs"  AS co ON co."prod_id" = s."prod_id"
                        AND co."time_id" = s."time_id"
     JOIN   "customers" AS cu ON cu."cust_id" = s."cust_id"
     JOIN   "countries" AS cr ON cr."country_id" = cu."country_id"
     JOIN   "times"     AS t  ON t."time_id" = s."time_id"
     WHERE  cr."country_name" = 'Italy'
       AND  t."calendar_month_number" = 12
       AND  t."calendar_year"        = 2021
     GROUP  BY s."cust_id"
),
stats AS (
     SELECT MIN("total_profit") AS "min_p",
            MAX("total_profit") AS "max_p"
     FROM   profits
),
profits_with_bucket AS (
     SELECT p."cust_id",
            p."total_profit",
            CAST(((p."total_profit" - stats."min_p") /
                  ((stats."max_p" - stats."min_p") / 10.0)) AS INTEGER) + 1
            AS "bucket"
     FROM   profits AS p, stats
)
SELECT "bucket",
       COUNT(*)              AS "num_customers",
       MIN("total_profit")   AS "bucket_min_profit",
       MAX("total_profit")   AS "bucket_max_profit"
FROM   profits_with_bucket
GROUP  BY "bucket"
ORDER  BY "bucket"
LIMIT 20;
```

These ten queries progress from simple look‑ups to the final bucketed summary required for the analysis.
