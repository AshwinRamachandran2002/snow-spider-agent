                                ON c2."country_id" = co2."country_id"
                         WHERE  co2."country_name" = 'Italy')
    AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
  GROUP BY s."cust_id"
),
limits AS (
  SELECT MIN("total_profit") AS min_p,
