2025-05-01 03:17:57 - Thread-1301 (execute) - INFO - [Exploration]
Relevant columns, their possible usage and the main filters we will need
• countries.country_name : to find the country we need (“Italy”).  
• countries.country_id   : joins to customers.country_id.  
• customers.cust_id      : the customer key that finally gets bucketed.  
• sales.cust_id          : joins to customers.cust_id so that we only keep the Italian buyers.  
• sales.time_id          : filter to the month we want ( 2021‑12‑01 … 2021‑12‑31 ).  
• sales.prod_id / promo_id / channel_id : join keys to costs in order to read unit prices / costs that correspond to the same transaction.  
• sales.quantity_sold    : used in the profit formula.  
• costs.unit_price – costs.unit_cost : margin per unit; together with quantity_sold gives the profit for one sales row.  
• costs.time_id / promo_id / channel_id / prod_id : used to line‑up the correct price/cost record with each sales row.

Main conditions  
1. countries.country_name = 'Italy'                                 (Italian customers)  
2. sales.time_id BETWEEN '2021‑12‑01' AND '2021‑12‑31'               (December 2021)  

--------------------------------------------------------------------
Ten exploratory → final SQL statements
--------------------------------------------------------------------

```sql
-- 1) Check that we have the correct country_id for Italy
SELECT DISTINCT "country_id", "country_name"
FROM "countries"
WHERE "country_name" = 'Italy'
LIMIT 20;
```

```sql
-- 2) List the first Italian customers (cust_id & name parts)
SELECT DISTINCT c."cust_id",
       c."cust_first_name" || ' ' || c."cust_last_name" AS "cust_name"
FROM   "customers"  AS c
JOIN   "countries"  AS co
       ON c."country_id" = co."country_id"
WHERE  co."country_name" = 'Italy'
LIMIT 20;
```

```sql
-- 3) Show Italian customers’ sales rows in December‑2021
SELECT DISTINCT s."cust_id", s."prod_id", s."time_id",
       s."quantity_sold", s."promo_id", s."channel_id"
FROM   "sales"      AS s
WHERE  s."cust_id" IN (SELECT c."cust_id"
                       FROM   "customers"  AS c
                       JOIN   "countries"  AS co
                              ON c."country_id" = co."country_id"
                       WHERE  co."country_name" = 'Italy')
  AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- 4) Look at the cost records that belong to December‑2021
SELECT DISTINCT "prod_id", "time_id", "promo_id", "channel_id",
       "unit_cost", "unit_price"
FROM   "costs"
WHERE  "time_id" BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- 5) Join sales & costs for Italian customers, calculate line‑level profit
SELECT DISTINCT s."cust_id",
       s."prod_id",
       s."time_id",
       s."quantity_sold" *
       ("unit_price" - "unit_cost")            AS "profit"
FROM   "sales"  AS s
JOIN   "costs"  AS c
       ON  c."prod_id"   = s."prod_id"
       AND c."time_id"   = s."time_id"
       AND c."promo_id"  = s."promo_id"
       AND c."channel_id"= s."channel_id"
WHERE  s."cust_id" IN (SELECT c."cust_id"
                       FROM   "customers" AS c
                       JOIN   "countries" AS co
                              ON c."country_id" = co."country_id"
                       WHERE  co."country_name" = 'Italy')
  AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- 6) Aggregate to total December‑2021 profit per Italian customer
WITH cust_profit AS (
  SELECT s."cust_id",
         SUM(s."quantity_sold" * (c."unit_price" - c."unit_cost")) AS "total_profit"
  FROM   "sales"  AS s
  JOIN   "costs"  AS c
         ON  c."prod_id"    = s."prod_id"
         AND c."time_id"    = s."time_id"
         AND c."promo_id"   = s."promo_id"
         AND c."channel_id" = s."channel_id"
  WHERE  s."cust_id" IN (SELECT c2."cust_id"
                         FROM   "customers"  AS c2
                         JOIN   "countries"  AS co2
                                ON c2."country_id" = co2."country_id"
                         WHERE  co2."country_name" = 'Italy')
    AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
  GROUP BY s."cust_id"
)
SELECT *
FROM   cust_profit
LIMIT 20;
```

```sql
-- 7) Find the overall minimum & maximum profit among those customers
WITH cust_profit AS (
  SELECT s."cust_id",
         SUM(s."quantity_sold" * (c."unit_price" - c."unit_cost")) AS "total_profit"
  FROM   "sales"  AS s
  JOIN   "costs"  AS c
         ON  c."prod_id"    = s."prod_id"
         AND c."time_id"    = s."time_id"
         AND c."promo_id"   = s."promo_id"
         AND c."channel_id" = s."channel_id"
  WHERE  s."cust_id" IN (SELECT c2."cust_id"
                         FROM   "customers"  AS c2
                         JOIN   "countries"  AS co2
                                ON c2."country_id" = co2."country_id"
                         WHERE  co2."country_name" = 'Italy')
    AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
  GROUP BY s."cust_id"
)
SELECT MIN("total_profit") AS "min_profit",
       MAX("total_profit") AS "max_profit"
FROM   cust_profit;
```

```sql
-- 8) Compute a dynamic bucket number (1‑10) for every customer
WITH cust_profit AS (
  SELECT s."cust_id",
         SUM(s."quantity_sold" * (c."unit_price" - c."unit_cost")) AS "total_profit"
  FROM   "sales"  AS s
  JOIN   "costs"  AS c
         ON  c."prod_id"    = s."prod_id"
         AND c."time_id"    = s."time_id"
         AND c."promo_id"   = s."promo_id"
         AND c."channel_id" = s."channel_id"
  WHERE  s."cust_id" IN (SELECT c2."cust_id"
                         FROM   "customers"  AS c2
                         JOIN   "countries"  AS co2
                                ON c2."country_id" = co2."country_id"
                         WHERE  co2."country_name" = 'Italy')
    AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
  GROUP BY s."cust_id"
),
limits AS (
  SELECT MIN("total_profit") AS min_p,
         MAX("total_profit") AS max_p
  FROM   cust_profit
)
SELECT cp."cust_id",
       cp."total_profit",
       CASE
         WHEN cp."total_profit" = (SELECT max_p FROM limits) THEN 10
         ELSE CAST( ((cp."total_profit" - (SELECT min_p FROM limits)) /
                    ((SELECT max_p FROM limits) - (SELECT min_p FROM limits)) ) * 10 AS INTEGER) + 1
       END AS "bucket"
FROM   cust_profit AS cp
LIMIT 20;
```

```sql
-- 9) Produce the 10 buckets with count of customers + min/max profit inside each bucket
WITH cust_profit AS (
  SELECT s."cust_id",
         SUM(s."quantity_sold" * (c."unit_price" - c."unit_cost")) AS "total_profit"
  FROM   "sales"  AS s
  JOIN   "costs"  AS c
         ON  c."prod_id"    = s."prod_id"
         AND c."time_id"    = s."time_id"
         AND c."promo_id"   = s."promo_id"
         AND c."channel_id" = s."channel_id"
  WHERE  s."cust_id" IN (SELECT c2."cust_id"
                         FROM   "customers"  AS c2
                         JOIN   "countries"  AS co2
                                ON c2."country_id" = co2."country_id"
                         WHERE  co2."country_name" = 'Italy')
    AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
  GROUP BY s."cust_id"
),
limits AS (
  SELECT MIN("total_profit") AS min_p,
         MAX("total_profit") AS max_p
  FROM   cust_profit
),
bucketed AS (
  SELECT cp.*,
         CASE
           WHEN cp."total_profit" = (SELECT max_p FROM limits) THEN 10
           ELSE CAST( ((cp."total_profit" - (SELECT min_p FROM limits)) /
                      ((SELECT max_p FROM limits) - (SELECT min_p FROM limits)) ) * 10 AS INTEGER) + 1
         END AS "bucket"
  FROM   cust_profit AS cp
)
SELECT "bucket"                               AS "profit_bucket",
       COUNT(*)                               AS "customers_in_bucket",
       MIN("total_profit")                    AS "min_profit_in_bucket",
       MAX("total_profit")                    AS "max_profit_in_bucket"
FROM   bucketed
GROUP BY "bucket"
ORDER BY "bucket";
```

```sql
-- 10) Optional – inspect one bucket’s customers (example: bucket #5)
WITH cust_profit AS (
  SELECT s."cust_id",
         SUM(s."quantity_sold" * (c."unit_price" - c."unit_cost")) AS "total_profit"
  FROM   "sales"  AS s
  JOIN   "costs"  AS c
         ON  c."prod_id"    = s."prod_id"
         AND c."time_id"    = s."time_id"
         AND c."promo_id"   = s."promo_id"
         AND c."channel_id" = s."channel_id"
  WHERE  s."cust_id" IN (SELECT c2."cust_id"
                         FROM   "customers"  AS c2
                         JOIN   "countries"  AS co2
                                ON c2."country_id" = co2."country_id"
                         WHERE  co2."country_name" = 'Italy')
    AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
  GROUP BY s."cust_id"
),
limits AS (
  SELECT MIN("total_profit") AS min_p,
         MAX("total_profit") AS max_p
  FROM   cust_profit
),
bucketed AS (
  SELECT cp.*,
         CASE
           WHEN cp."total_profit" = (SELECT max_p FROM limits) THEN 10
           ELSE CAST( ((cp."total_profit" - (SELECT min_p FROM limits)) /
                      ((SELECT max_p FROM limits) - (SELECT min_p FROM limits)) ) * 10 AS INTEGER) + 1
         END AS "bucket"
  FROM   cust_profit AS cp
)
SELECT *
FROM   bucketed
WHERE  "bucket" = 5
LIMIT 20;
```

The first nine queries progressively build up to the final answer (query 9) that supplies the required ten profit buckets, the number of Italian customers in each, and the minimum / maximum total profits that fall inside every bucket.
