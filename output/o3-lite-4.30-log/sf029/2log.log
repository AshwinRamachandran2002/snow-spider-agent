Begin Exploring Related Columns
Relevant columns & potential usage  
• "RETAIL_ANALYTICS_SALES"."DATE": join key & day filter (2022‑01‑08 ‑ 2022‑02‑06)  
• "RETAIL_ANALYTICS_SALES"."ASIN": join key (product)  
• "RETAIL_ANALYTICS_SALES"."PROGRAM": keep “Amazon Retail” rows  
• "RETAIL_ANALYTICS_SALES"."PERIOD": keep “DAILY” rows  
• "RETAIL_ANALYTICS_SALES"."DISTRIBUTOR_VIEW": keep “Manufacturing” rows  
• "RETAIL_ANALYTICS_SALES"."ORDERED_UNITS": total ordered units  
• "RETAIL_ANALYTICS_SALES"."ORDERED_REVENUE": ordered revenue  
• "RETAIL_ANALYTICS_SALES"."SHIPPED_UNITS": shipped units  
• "RETAIL_ANALYTICS_SALES"."SHIPPED_REVENUE": shipped revenue  
• "RETAIL_ANALYTICS_TRAFFIC"."GLANCE_VIEWS": product page views  
• "RETAIL_ANALYTICS_TRAFFIC"."DATE/ASIN/PROGRAM/PERIOD/DISTRIBUTOR_VIEW": join keys  
• "RETAIL_ANALYTICS_NET_PPM"."NET_PPM": net pure profit margin – average per day  
• "RETAIL_ANALYTICS_INVENTORY"."PROCURABLE_PRODUCT_OOS": % OOS  
• "RETAIL_ANALYTICS_INVENTORY"."SELLABLE_ON_HAND_UNITS": on‑hand units (count)  
• "RETAIL_ANALYTICS_INVENTORY"."SELLABLE_ON_HAND_INVENTORY": on‑hand value (£/$)  
• "RETAIL_ANALYTICS_INVENTORY"."NET_RECEIVED_UNITS": units newly received  
• "RETAIL_ANALYTICS_INVENTORY"."NET_RECEIVED": value newly received  
• "RETAIL_ANALYTICS_INVENTORY"."OPEN_PURCHASE_ORDER_QUANTITY": open PO qty  
• "RETAIL_ANALYTICS_INVENTORY"."UNFILLED_CUSTOMER_ORDERED_UNITS": unfilled demand  
• "RETAIL_ANALYTICS_INVENTORY"."VENDOR_CONFIRMATION_RATE": vendor confirmation rate  
• "RETAIL_ANALYTICS_INVENTORY"."RECEIVE_FILL_RATE": receive fill rate  
• "RETAIL_ANALYTICS_INVENTORY"."SELL_THROUGH_RATE": sell‑through rate  
• "RETAIL_ANALYTICS_INVENTORY"."OVERALL_VENDOR_LEAD_TIME_DAYS": vendor lead time  

Typical conditions  
• "DISTRIBUTOR_VIEW" = 'Manufacturing'  
• "PROGRAM"       = 'Amazon Retail'  
• "PERIOD"        = 'DAILY'  
• "DATE" BETWEEN '2022‑01‑08' AND '2022‑02‑06'  

Below are 10 exploratory Snowflake SQL snippets (LIMIT 20) that progress from simple checks to multi‑table joins. All identifiers are double‑quoted.

```sql
-- 1. Check distinct days available in sales during the 30‑day window
SELECT DISTINCT "DATE"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"
WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND "PROGRAM" = 'Amazon Retail'
  AND "PERIOD"  = 'DAILY'
  AND "DATE" BETWEEN '2022-01-08' AND '2022-02-06'
ORDER BY "DATE"
LIMIT 20;
```

```sql
-- 2. List ASINs that have traffic data in the same window
SELECT DISTINCT "ASIN"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_TRAFFIC"
WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND "PROGRAM" = 'Amazon Retail'
  AND "PERIOD"  = 'DAILY'
  AND "DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```

```sql
-- 3. Quick glance at ordered units & revenue for one ASIN
SELECT "DATE",
       "ASIN",
       "ORDERED_UNITS",
       "ORDERED_REVENUE"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"
WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND "PROGRAM" = 'Amazon Retail'
  AND "PERIOD"  = 'DAILY'
  AND "ASIN"    = 'ASIN_5'
  AND "DATE" BETWEEN '2022-01-08' AND '2022-02-06'
ORDER BY "DATE"
LIMIT 20;
```

```sql
-- 4. Compute daily average selling price (ASP) for sample ASINs
SELECT "DATE",
       "ASIN",
       "ORDERED_UNITS",
       "ORDERED_REVENUE",
       CASE WHEN "ORDERED_UNITS" > 0 THEN "ORDERED_REVENUE" / "ORDERED_UNITS" END AS "ASP"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"
WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND "PROGRAM" = 'Amazon Retail'
  AND "PERIOD"  = 'DAILY'
  AND "DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```

```sql
-- 5. Join sales & traffic to inspect conversion rate (ordered units / glance views)
SELECT s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       t."GLANCE_VIEWS",
       CASE WHEN t."GLANCE_VIEWS" > 0 THEN s."ORDERED_UNITS" / t."GLANCE_VIEWS" END AS "CONVERSION_RATE"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"   s
JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_TRAFFIC" t
  ON  s."DATE"             = t."DATE"
  AND s."ASIN"             = t."ASIN"
  AND s."PROGRAM"          = t."PROGRAM"
  AND s."PERIOD"           = t."PERIOD"
  AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."PROGRAM" = 'Amazon Retail'
  AND s."PERIOD"  = 'DAILY'
  AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```

```sql
-- 6. Add inventory to see on‑hand units & procurable OOS %
SELECT j."DATE",
       j."ASIN",
       j."ORDERED_UNITS",
       j."GLANCE_VIEWS",
       i."SELLABLE_ON_HAND_UNITS",
       i."PROCURABLE_PRODUCT_OOS"
FROM (
     SELECT s."DATE", s."ASIN", s."ORDERED_UNITS", t."GLANCE_VIEWS"
     FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"   s
     JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_TRAFFIC" t
       ON s."DATE" = t."DATE"
      AND s."ASIN" = t."ASIN"
      AND s."PROGRAM" = t."PROGRAM"
      AND s."PERIOD"  = t."PERIOD"
      AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
     WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
       AND s."PROGRAM" = 'Amazon Retail'
       AND s."PERIOD"  = 'DAILY'
       AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
) j
JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_INVENTORY" i
  ON  j."DATE" = i."DATE"
  AND j."ASIN" = i."ASIN"
  AND i."PROGRAM" = 'Amazon Retail'
  AND i."PERIOD"  = 'DAILY'
  AND i."DISTRIBUTOR_VIEW" = 'Manufacturing'
LIMIT 20;
```

```sql
-- 7. Bring in net PPM to observe daily profitability
SELECT s."DATE",
       s."ASIN",
       s."ORDERED_REVENUE",
       n."NET_PPM"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES" s
JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_NET_PPM" n
  ON s."DATE" = n."DATE"
 AND s."ASIN" = n."ASIN"
 AND s."PROGRAM" = n."PROGRAM"
 AND s."PERIOD"  = n."PERIOD"
 AND s."DISTRIBUTOR_VIEW" = n."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."PROGRAM" = 'Amazon Retail'
  AND s."PERIOD"  = 'DAILY'
  AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```

```sql
-- 8. Inspect vendor operational metrics from inventory
SELECT "DATE",
       "ASIN",
       "OPEN_PURCHASE_ORDER_QUANTITY",
