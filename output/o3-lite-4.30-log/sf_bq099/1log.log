WHERE c.value::STRING ILIKE 'A01B3%'
LIMIT 20;
```

```sql
-- 4. Description: List distinct assignee names that have applications in CPC class A01B3.
SELECT DISTINCT a.value:"name"::STRING AS "assignee_name"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc")  c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE c.value::STRING ILIKE 'A01B3%'
  AND a.value:"name" IS NOT NULL
LIMIT 20;
```

```sql
-- 5. Description: Retrieve the top 10 assignees by application count in class A01B3.
SELECT a.value:"name"::STRING         AS "assignee_name",
       COUNT(*)                       AS "application_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc")  c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE c.value::STRING ILIKE 'A01B3%'
GROUP BY a.value:"name"::STRING
ORDER BY "application_cnt" DESC
LIMIT 20;
```

```sql
-- 6. Description: Show filing‑year distribution for the single most‑frequent assignee (replace <TOP_ASSIGNEE> after observing query #5).
SELECT FLOOR(p."filing_date"/10000)  AS "filing_year",
       COUNT(*)                      AS "yearly_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc")  c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE c.value::STRING ILIKE 'A01B3%'
  AND a.value:"name"::STRING = '<TOP_ASSIGNEE>'
GROUP BY FLOOR(p."filing_date"/10000)
ORDER BY "yearly_cnt" DESC
LIMIT 20;
```

```sql
-- 7. Description: Yearly application counts for the global top 3 assignees in class A01B3.
WITH top3 AS (
    SELECT a.value:"name"::STRING AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")  c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value::STRING ILIKE 'A01B3%'
    GROUP BY a.value:"name"::STRING
    ORDER BY COUNT(*) DESC
    LIMIT 3
)
SELECT a.value:"name"::STRING        AS "assignee_name",
       FLOOR(p."filing_date"/10000)  AS "filing_year",
       COUNT(*)                      AS "application_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc")  c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a,
     top3
WHERE c.value::STRING ILIKE 'A01B3%'
  AND a.value:"name"::STRING = top3."assignee_name"
GROUP BY a.value:"name"::STRING, FLOOR(p."filing_date"/10000)
ORDER BY "assignee_name", "application_cnt" DESC
LIMIT 20;
```

```sql
-- 8. Description: Within the peak year of one assignee, display the country codes that appear most frequently.
WITH peak_year AS (
    SELECT FLOOR(p."filing_date"/10000)   AS "best_year",
           COUNT(*)                       AS "cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")  c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value::STRING ILIKE 'A01B3%'
      AND a.value:"name"::STRING = '<TOP_ASSIGNEE>'
    GROUP BY FLOOR(p."filing_date"/10000)
    ORDER BY "cnt" DESC
    LIMIT 1
)
SELECT p."country_code",
       COUNT(*) AS "applications_in_peak_year"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc")  c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a,
     peak_year
WHERE c.value::STRING ILIKE 'A01B3%'
  AND a.value:"name"::STRING = '<TOP_ASSIGNEE>'
  AND FLOOR(p."filing_date"/10000) = peak_year."best_year"
GROUP BY p."country_code"
ORDER BY "applications_in_peak_year" DESC
LIMIT 20;
```

```sql
-- 9. Description: For every assignee in the global top 3, derive its peak filing year and application count in that year.
WITH top3 AS (
    SELECT a.value:"name"::STRING AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")  c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value::STRING ILIKE 'A01B3%'
    GROUP BY a.value:"name"::STRING
    ORDER BY COUNT(*) DESC
    LIMIT 3
),
yearly AS (
    SELECT a.value:"name"::STRING        AS "assignee_name",
           FLOOR(p."filing_date"/10000)  AS "filing_year",
           COUNT(*)                      AS "yearly_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")  c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a,
         top3
    WHERE c.value::STRING ILIKE 'A01B3%'
      AND a.value:"name"::STRING = top3."assignee_name"
    GROUP BY a.value:"name"::STRING, FLOOR(p."filing_date"/10000)
)
SELECT *
FROM (
      SELECT y.*,
             ROW_NUMBER() OVER (PARTITION BY y."assignee_name" ORDER BY y."yearly_cnt" DESC) AS rn
      FROM yearly y
     )
WHERE rn = 1
LIMIT 20;
```

```sql
-- 10. Description: Final summary ‑‑ each of the top 3 assignees, their total application count,
--     their peak year, applications in that year, and the country code with most filings in the peak year.
WITH top3 AS (
    SELECT a.value:"name"::STRING AS "assignee_name",
           COUNT(*)               AS "total_apps"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")  c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value::STRING ILIKE 'A01B3%'
    GROUP BY a.value:"name"::STRING
    ORDER BY "total_apps" DESC
    LIMIT 3
),
yearly AS (
    SELECT a.value:"name"::STRING        AS "assignee_name",
           FLOOR(p."filing_date"/10000)  AS "filing_year",
           COUNT(*)                      AS "yearly_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")  c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a,
         top3
    WHERE c.value::STRING ILIKE 'A01B3%'
      AND a.value:"name"::STRING = top3."assignee_name"
    GROUP BY a.value:"name"::STRING, FLOOR(p."filing_date"/10000)
),
peak_year AS (
    SELECT y.*,
           ROW_NUMBER() OVER (PARTITION BY y."assignee_name" ORDER BY y."yearly_cnt" DESC) AS rn
    FROM yearly y
),
country_peak AS (
    SELECT a.value:"name"::STRING        AS "assignee_name",
           FLOOR(p."filing_date"/10000)  AS "filing_year",
           p."country_code",
           COUNT(*)                      AS "cnt_country"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")  c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a,
         peak_year py
    WHERE c.value::STRING ILIKE 'A01B3%'
      AND a.value:"name"::STRING = py."assignee_name"
      AND FLOOR(p."filing_date"/10000)  = py."filing_year"
      AND py.rn = 1
    GROUP BY a.value:"name"::STRING, FLOOR(p."filing_date"/10000), p."country_code"
),
best_country AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY "assignee_name", "filing_year"
                              ORDER BY "cnt_country" DESC) AS rn
    FROM country_peak
)
SELECT t."assignee_name",
       t."total_apps",
       py."filing_year"        AS "peak_year",
       py."yearly_cnt"         AS "apps_in_peak_year",
       bc."country_code"       AS "top_country_in_peak_year"
FROM      top3 t
JOIN      peak_year py ON t."assignee_name" = py."assignee_name" AND py.rn = 1
JOIN      best_country bc ON t."assignee_name" = bc."assignee_name"
                          AND py."filing_year" = bc."filing_year"
                          AND bc.rn = 1
LIMIT 20;
```

These ten queries progress from basic inspection of CPC codes to the final, composite answer that meets all requested requirements for class A01B3.
