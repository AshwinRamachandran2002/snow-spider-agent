--Description: For one specific assignee (<TOP_ASSIGNEE>), find the publication country distribution
--             in that assignee’s peak filing year for A01B3 applications.
WITH peak_year AS (
    SELECT FLOOR(p."filing_date"/10000) AS "best_year",
           COUNT(*)                     AS "cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")               c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
      AND a.value:"name"::STRING = '<TOP_ASSIGNEE>'
      AND p."filing_date" > 0
    GROUP BY FLOOR(p."filing_date"/10000)
    ORDER BY "cnt" DESC
    LIMIT 1
)
SELECT p."country_code",
       COUNT(*) AS "applications_in_peak_year"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc")               c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a,
     peak_year
WHERE c.value:"code"::STRING ILIKE 'A01B3%'
  AND a.value:"name"::STRING = '<TOP_ASSIGNEE>'
  AND FLOOR(p."filing_date"/10000) = peak_year."best_year"
GROUP BY p."country_code"
ORDER BY "applications_in_peak_year" DESC
LIMIT 20;
