    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
      AND a.value:"name"::STRING = t.assignee_name
      AND p."filing_date" > 0
    GROUP BY FLOOR(p."filing_date"/10000)
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
