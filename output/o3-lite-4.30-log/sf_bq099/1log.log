--Description: Identify, for each of the global top‑3 assignees in A01B3, its single peak filing year
--             (largest number of applications) and the corresponding application count.
WITH top3 AS (   -- step‑1: who are the top‑3 assignees?
    SELECT a.value:"name"::STRING AS assignee_name
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")                c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
    GROUP BY a.value:"name"::STRING
    ORDER BY COUNT(*) DESC
    LIMIT 3
),
yearly AS (      -- step‑2: yearly counts for those assignees
    SELECT a.value:"name"::STRING        AS assignee_name,
           FLOOR(p."filing_date"/10000)  AS filing_year,
           COUNT(*)                      AS yearly_cnt
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")                c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a,
         top3
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
      AND a.value:"name"::STRING = top3.assignee_name
      AND p."filing_date" > 0
    GROUP BY a.value:"name"::STRING, FLOOR(p."filing_date"/10000)
)
SELECT assignee_name,
