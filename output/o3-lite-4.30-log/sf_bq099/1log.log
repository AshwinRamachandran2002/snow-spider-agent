WHERE c.value:"code"::STRING ILIKE 'A01B3%'
  AND a.value:"name"::STRING = t.assignee_name
  AND p."filing_date" > 0
  AND FLOOR(p."filing_date"/10000) = peak_year.best_year
GROUP BY p."country_code"
