SELECT DISTINCT c.value::STRING AS "a01b3_cpc_code"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") c
WHERE c.value::STRING ILIKE 'A01B3%'
LIMIT 20;
```

```sql
-- 3. Description: Pull a few publication rows that contain at least one 'A01B3' CPC code.
SELECT p."publication_number",
       p."application_number",
       p."filing_date",
       p."country_code",
       c.value::STRING AS "a01b3_symbol"
FROM PATENTS.PATENTS.PUBLICATIONS p,
