```sql
--Description: For each of the global top‑3 assignees, determine its peak filing year
--             and the number of A01B3 applications in that year.
WITH top3 AS (
    SELECT a.value:"name"::STRING AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")               c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
    GROUP BY a.value:"name"::STRING
    ORDER BY COUNT(*) DESC
    LIMIT 3
), yearly AS (
    SELECT a.value:"name"::STRING        AS "assignee_name",
           FLOOR(p."filing_date"/10000)  AS "filing_year",
           COUNT(*)                      AS "yearly_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")               c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a,
         top3
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
      AND a.value:"name"::STRING = top3."assignee_name"
      AND p."filing_date" > 0
    GROUP BY a.value:"name"::STRING, FLOOR(p."filing_date"/10000)
)
SELECT *
FROM (
    SELECT y.*,
           ROW_NUMBER() OVER (PARTITION BY y."assignee_name"
                              ORDER BY y."yearly_cnt" DESC) AS rn
    FROM yearly y
) sub
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: Final summary for the top‑3 assignees in A01B3 – total apps, peak year,
--             apps in that peak year, and the dominant country that year.
WITH top3 AS (
    SELECT a.value:"name"::STRING AS "assignee_name",
           COUNT(*)               AS "total_apps"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")               c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
    GROUP BY a.value:"name"::STRING
    ORDER BY "total_apps" DESC
    LIMIT 3
), yearly AS (
    SELECT a.value:"name"::STRING        AS "assignee_name",
           FLOOR(p."filing_date"/10000)  AS "filing_year",
           COUNT(*)                      AS "yearly_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")               c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a,
         top3
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
      AND a.value:"name"::STRING = top3."assignee_name"
      AND p."filing_date" > 0
    GROUP BY a.value:"name"::STRING, FLOOR(p."filing_date"/10000)
), peak_year AS (
    SELECT y.*,
           ROW_NUMBER() OVER (PARTITION BY y."assignee_name"
                              ORDER BY y."yearly_cnt" DESC) AS rn
    FROM yearly y
), country_peak AS (
    SELECT a.value:"name"::STRING        AS "assignee_name",
           FLOOR(p."filing_date"/10000)  AS "filing_year",
           p."country_code",
           COUNT(*)                      AS "cnt_country"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")               c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a,
         peak_year py
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
      AND a.value:"name"::STRING = py."assignee_name"
      AND FLOOR(p."filing_date"/10000)  = py."filing_year"
      AND py.rn = 1
    GROUP BY a.value:"name"::STRING,
             FLOOR(p."filing_date"/10000),
             p."country_code"
), best_country AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY "assignee_name", "filing_year"
                              ORDER BY "cnt_country" DESC) AS rn
    FROM country_peak
)
SELECT t."assignee_name",
       t."total_apps",
       py."filing_year"  AS "peak_year",
       py."yearly_cnt"   AS "apps_in_peak_year",
       bc."country_code" AS "top_country_in_peak_year"
FROM      top3 t
JOIN      peak_year   py ON t."assignee_name" = py."assignee_name" AND py.rn = 1
JOIN      best_country bc ON py."assignee_name" = bc."assignee_name"
                          AND py."filing_year"  = bc."filing_year"
                          AND bc.rn = 1
LIMIT 20;
```
