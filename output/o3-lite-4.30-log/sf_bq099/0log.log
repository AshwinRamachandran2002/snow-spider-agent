--Description: Build one query to answer the task for CPC class A01B3.  
--Steps inside CTEs:  
-- 1) a01b_apps: collect every publication whose CPC JSON "code" starts with 'A01B3', aliasing "publication_number" as pub_num for safe reuse, and keep year & country.  
-- 2) total_by_assignee: count distinct publications per assignee and keep the top‑3 assignees overall.  
-- 3) year_counts: for those assignees, count publications per year and pick each assignee’s busiest year.  
-- 4) country_counts: within each (assignee, busiest‑year) pair, count publications per country and keep the most frequent country code.  
-- Final SELECT returns: assignee name, total applications, peak year, applications in that year, and top country in that year, ordered by total applications.
WITH a01b_apps AS (
    SELECT
        t."publication_number"                                   AS pub_num,
        (t."publication_date" / 10000)::INT                      AS pub_year,
        t."country_code",
        ah.value::STRING                                         AS assignee_name
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc")                    f,
         LATERAL FLATTEN(input => t."assignee_harmonized")   ah
    WHERE f.value:"code"::STRING ILIKE 'A01B3%'
),
total_by_assignee AS (
    SELECT
        assignee_name,
        COUNT(DISTINCT pub_num) AS total_apps
    FROM a01b_apps
    GROUP BY assignee_name
    ORDER BY total_apps DESC
    LIMIT 3
),
year_counts AS (
    SELECT
        a.assignee_name,
        a.pub_year,
        COUNT(DISTINCT a.pub_num) AS apps_in_year,
        ROW_NUMBER() OVER (
            PARTITION BY a.assignee_name
            ORDER BY COUNT(DISTINCT a.pub_num) DESC
        ) AS rn
    FROM a01b_apps a
    JOIN total_by_assignee t
      ON a.assignee_name = t.assignee_name
    GROUP BY a.assignee_name, a.pub_year
),
top_year AS (
    SELECT
        assignee_name,
        pub_year,
        apps_in_year
    FROM year_counts
    WHERE rn = 1
),
country_counts AS (
    SELECT
        a.assignee_name,
        a.pub_year,
        a."country_code",
        COUNT(DISTINCT a.pub_num) AS apps_in_country,
        ROW_NUMBER() OVER (
            PARTITION BY a.assignee_name, a.pub_year
            ORDER BY COUNT(DISTINCT a.pub_num) DESC
        ) AS rn
    FROM a01b_apps a
    JOIN top_year y
      ON a.assignee_name = y.assignee_name
     AND a.pub_year      = y.pub_year
    GROUP BY a.assignee_name, a.pub_year, a."country_code"
)
SELECT
    y.assignee_name,
    t.total_apps,
    y.pub_year                  AS peak_year,
    y.apps_in_year,
    c."country_code"            AS top_country_in_peak_year
FROM top_year y
JOIN total_by_assignee t
  ON y.assignee_name = t.assignee_name
JOIN country_counts c
  ON y.assignee_name = c.assignee_name
 AND y.pub_year      = c.pub_year
WHERE c.rn = 1
ORDER BY t.total_apps DESC;
