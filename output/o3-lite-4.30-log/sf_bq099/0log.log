```sql
--Description: 8) Count applications per assignee per year for A01B3* (sample 20 rows)
SELECT ah.value::STRING                       AS assignee_name,
       ( t."publication_date" / 10000 )::INT  AS pub_year,
       COUNT(DISTINCT t."publication_number") AS apps_in_year
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN ( input => t."cpc" ) f,
     LATERAL FLATTEN ( input => t."assignee_harmonized" ) ah
WHERE f.value:"symbol"::STRING ILIKE 'A01B3%'
GROUP BY assignee_name, pub_year
ORDER BY apps_in_year DESC
LIMIT 20;
```

```sql
--Description: 9) For the (assignee, year) pairs with the most filings, also return country counts (sample)
SELECT ah.value::STRING                       AS assignee_name,
       ( t."publication_date" / 10000 )::INT  AS pub_year,
       t."country_code",
       COUNT(DISTINCT t."publication_number") AS apps_in_country
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN ( input => t."cpc" ) f,
     LATERAL FLATTEN ( input => t."assignee_harmonized" ) ah
WHERE f.value:"symbol"::STRING ILIKE 'A01B3%'
GROUP BY assignee_name, pub_year, t."country_code"
ORDER BY apps_in_country DESC
LIMIT 20;
```

```sql
--Description: 10) One‑shot query to produce: top‑3 assignees (by total apps), their busiest year, apps in that year, and the most‑common country in that year
WITH a01b_apps AS (
    SELECT t."publication_number",
           ( t."publication_date" / 10000 )::INT         AS pub_year,
           t."country_code",
           ah.value::STRING                               AS assignee_name
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN ( input => t."cpc" ) f,
         LATERAL FLATTEN ( input => t."assignee_harmonized" ) ah
    WHERE f.value:"symbol"::STRING ILIKE 'A01B3%'
),
total_by_assignee AS (
    SELECT assignee_name,
           COUNT(DISTINCT publication_number) AS total_apps
    FROM a01b_apps
    GROUP BY assignee_name
    ORDER BY total_apps DESC
    LIMIT 3
),
year_counts AS (
    SELECT a.assignee_name,
           a.pub_year,
           COUNT(DISTINCT a.publication_number) AS apps_in_year,
           ROW_NUMBER() OVER (PARTITION BY a.assignee_name
                              ORDER BY COUNT(DISTINCT a.publication_number) DESC) AS rn
    FROM a01b_apps a
    JOIN total_by_assignee t ON a.assignee_name = t.assignee_name
    GROUP BY a.assignee_name, a.pub_year
),
top_year AS (
    SELECT assignee_name,
           pub_year,
           apps_in_year
    FROM year_counts
    WHERE rn = 1
),
country_counts AS (
    SELECT a.assignee_name,
           a.pub_year,
           a.country_code,
           COUNT(DISTINCT a.publication_number) AS apps_in_country,
           ROW_NUMBER() OVER (PARTITION BY a.assignee_name, a.pub_year
                              ORDER BY COUNT(DISTINCT a.publication_number) DESC) AS rn
    FROM a01b_apps a
    JOIN top_year y
         ON a.assignee_name = y.assignee_name
        AND a.pub_year      = y.pub_year
    GROUP BY a.assignee_name, a.pub_year, a.country_code
)
SELECT y.assignee_name,
       t.total_apps,
       y.pub_year  AS peak_year,
       y.apps_in_year,
       c.country_code AS top_country_in_peak_year
FROM top_year y
JOIN total_by_assignee t ON y.assignee_name = t.assignee_name
JOIN country_counts   c ON y.assignee_name = c.assignee_name
                       AND y.pub_year     = c.pub_year
WHERE c.rn = 1
ORDER BY t.total_apps DESC;
```
