```sql
--Description: 10) Full aggregation for the top 3 assignees in A01B3 (all CPC lookups use "code")
WITH top_assignees AS (
  SELECT 
    a.value::STRING AS assignee,
    COUNT(DISTINCT t."application_number") AS total_apps
  FROM PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."cpc") f,
       LATERAL FLATTEN(input => t."assignee_harmonized") a
  WHERE f.value:"code"::STRING LIKE 'A01B3%'
  GROUP BY a.value::STRING
  ORDER BY total_apps DESC
  LIMIT 3
), apps_per_year AS (
  SELECT 
    a.value::STRING AS assignee,
    SUBSTRING(TO_VARCHAR(t."filing_date"),1,4) AS filing_year,
    COUNT(DISTINCT t."application_number") AS apps_in_year
  FROM PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."cpc") f,
       LATERAL FLATTEN(input => t."assignee_harmonized") a
  WHERE f.value:"code"::STRING LIKE 'A01B3%'
    AND a.value::STRING IN (SELECT assignee FROM top_assignees)
  GROUP BY a.value::STRING, SUBSTRING(TO_VARCHAR(t."filing_date"),1,4)
), max_year AS (
  SELECT 
    assignee,
    FIRST_VALUE(filing_year) OVER (PARTITION BY assignee ORDER BY apps_in_year DESC) AS best_year,
    MAX(apps_in_year) AS max_apps
  FROM apps_per_year
  GROUP BY assignee
)
SELECT 
  ta.assignee,
  ta.total_apps,
  my.best_year,
  my.max_apps AS apps_in_best_year,
  (
    SELECT p."country_code"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f2,
         LATERAL FLATTEN(input => p."assignee_harmonized") a2
    WHERE f2.value:"code"::STRING LIKE 'A01B3%'
      AND a2.value::STRING = ta.assignee
      AND SUBSTRING(TO_VARCHAR(p."filing_date"),1,4) = my.best_year
    GROUP BY p."country_code"
    ORDER BY COUNT(DISTINCT p."application_number") DESC
    LIMIT 1
  ) AS top_country_in_best_year
FROM top_assignees ta
JOIN max_year my
  ON ta.assignee = my.assignee
LIMIT 20;
```
