```sql
--Description: THINKING PROCESS
--We need:  top‑3 assignees in CPC subclass A01B3, their total applications, the busiest filing year,
--          #apps in that year, and which country filed most that year.
--Key JSON fields: "cpc" → each element has "code"; "assignee_harmonized" → list with "name".
--Steps:
-- 1) top_assignees : count distinct application numbers with cpc.code LIKE 'A01B3%' and keep three highest.
-- 2) apps_per_year : for those assignees, count applications per filing year.
-- 3) best_year     : per assignee, pick year with max apps (ROW_NUMBER = 1).
-- 4) final select  : join totals + best_year and, via a scalar sub‑query, find the country_code that
--                    contributed the most filings for that assignee in that year.
WITH top_assignees AS (           -- step‑1
    SELECT
        a.value::STRING AS assignee,
        COUNT(DISTINCT p."application_number") AS total_apps
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")   f,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE f.value:"code"::STRING LIKE 'A01B3%'
    GROUP BY a.value::STRING
    ORDER BY total_apps DESC
    LIMIT 3
),
apps_per_year AS (                -- step‑2
    SELECT
        a.value::STRING AS assignee,
        SUBSTRING(TO_VARCHAR(p."filing_date"),1,4) AS filing_year,
        COUNT(DISTINCT p."application_number") AS apps_in_year
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")   f,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE f.value:"code"::STRING LIKE 'A01B3%'
      AND a.value::STRING IN (SELECT assignee FROM top_assignees)
    GROUP BY a.value::STRING,
             SUBSTRING(TO_VARCHAR(p."filing_date"),1,4)
),
best_year AS (                    -- step‑3
    SELECT
        assignee,
        filing_year  AS best_year,
        apps_in_year AS max_apps
    FROM (
        SELECT
            assignee,
            filing_year,
            apps_in_year,
            ROW_NUMBER() OVER (PARTITION BY assignee ORDER BY apps_in_year DESC) AS rn
        FROM apps_per_year
    )
    WHERE rn = 1
)
SELECT                              -- step‑4 (final output)
    ta.assignee,
    ta.total_apps,
    bys.best_year,
    bys.max_apps AS apps_in_best_year,
    (
        SELECT p."country_code"
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(input => p."cpc")   f2,
             LATERAL FLATTEN(input => p."assignee_harmonized") a2
        WHERE f2.value:"code"::STRING LIKE 'A01B3%'
          AND a2.value::STRING = ta.assignee
          AND SUBSTRING(TO_VARCHAR(p."filing_date"),1,4) = bys.best_year
        GROUP BY p."country_code"
        ORDER BY COUNT(DISTINCT p."application_number") DESC
        LIMIT 1
    ) AS top_country_in_best_year
FROM top_assignees  ta
JOIN best_year      bys
  ON ta.assignee = bys.assignee
LIMIT 20;
