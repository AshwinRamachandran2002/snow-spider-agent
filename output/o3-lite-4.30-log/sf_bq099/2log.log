--Description: Single‑statement solution (with inline thinking) to retrieve:
--   • assignee name
--   • total #A01B3 applications
--   • busiest filing year
--   • #applications in that year
--   • country that filed most applications in that year
--Steps (all implemented with CTEs):
-- 1) t_ass  – top‑3 assignees by distinct applications containing CPC codes LIKE 'A01B3%'.
-- 2) apy    – application counts per assignee & filing year.
-- 3) byr    – select, for each assignee, the year with the highest count (ROW_NUMBER = 1).
-- 4) cc     – for those assignees, count apps per year & country.
-- 5) bc     – choose, for each assignee/year, the country with the most apps.
--Final SELECT joins these to deliver the five requested columns.
WITH t_ass AS (   -- top assignees
    SELECT
        a.value::STRING AS assignee,
        COUNT(DISTINCT p."application_number") AS total_apps
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE f.value:"code"::STRING LIKE 'A01B3%'
    GROUP BY a.value::STRING
    ORDER BY total_apps DESC
    LIMIT 3
),
apy AS (          -- apps per year
    SELECT
        a.value::STRING AS assignee,
        SUBSTRING(TO_VARCHAR(p."filing_date"),1,4) AS filing_year,
        COUNT(DISTINCT p."application_number") AS apps_in_year
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE f.value:"code"::STRING LIKE 'A01B3%'
      AND a.value::STRING IN (SELECT assignee FROM t_ass)
    GROUP BY a.value::STRING,
             SUBSTRING(TO_VARCHAR(p."filing_date"),1,4)
),
byr AS (          -- busiest year per assignee
    SELECT
        assignee,
        filing_year AS best_year,
        apps_in_year AS max_apps
    FROM (
        SELECT
            assignee,
            filing_year,
            apps_in_year,
            ROW_NUMBER() OVER (PARTITION BY assignee ORDER BY apps_in_year DESC) AS rn
        FROM apy
    )
    WHERE rn = 1
),
cc AS (           -- country counts
    SELECT
        a.value::STRING AS assignee,
        SUBSTRING(TO_VARCHAR(p."filing_date"),1,4) AS filing_year,
        p."country_code",
        COUNT(DISTINCT p."application_number") AS apps
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE f.value:"code"::STRING LIKE 'A01B3%'
      AND a.value::STRING IN (SELECT assignee FROM t_ass)
    GROUP BY a.value::STRING,
             SUBSTRING(TO_VARCHAR(p."filing_date"),1,4),
             p."country_code"
),
bc AS (           -- top country in busiest year
    SELECT
        assignee,
        filing_year,
        country_code AS top_country_in_best_year
    FROM (
        SELECT
            assignee,
            filing_year,
            country_code,
            ROW_NUMBER() OVER (PARTITION BY assignee, filing_year ORDER BY apps DESC) AS rn
        FROM cc
    )
    WHERE rn = 1
)
SELECT
    t_ass.assignee,
    t_ass.total_apps,
    byr.best_year,
    byr.max_apps            AS apps_in_best_year,
    COALESCE(bc.top_country_in_best_year,'') AS top_country_in_best_year
FROM t_ass
JOIN byr
  ON t_ass.assignee = byr.assignee
LEFT JOIN bc
  ON bc.assignee    = t_ass.assignee
 AND bc.filing_year = byr.best_year
LIMIT 20;
