--Description: One‑step solution (with inline thinking) for the A01B3 analysis.
--Goal: For the three assignees owning the most applications that have a CPC “code” starting
--      with 'A01B3', return:
--        • assignee name
--        • total applications
--        • busiest filing year
--        • number of applications in that year
--        • country code with the most applications in that year
--Approach:
-- 1) top_assignees  – count distinct application numbers and keep the top 3 assignees.
-- 2) apps_per_year  – for those assignees, count apps per filing year.
-- 3) best_year      – choose, per assignee, the year with the highest count (ROW_NUMBER technique).
-- 4) country_counts – still limited to top assignees, count apps by (assignee, year, country).
-- 5) best_country   – pick, per (assignee, best year), the country with the highest count.
-- 6) final SELECT   – merge everything into the requested output columns.
WITH top_assignees AS (
    SELECT
        a.value::STRING AS assignee,
        COUNT(DISTINCT p."application_number") AS total_apps
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE f.value:"code"::STRING LIKE 'A01B3%'
    GROUP BY a.value::STRING
    ORDER BY total_apps DESC
    LIMIT 3
),
apps_per_year AS (
    SELECT
        a.value::STRING AS assignee,
        SUBSTRING(TO_VARCHAR(p."filing_date"), 1, 4) AS filing_year,
        COUNT(DISTINCT p."application_number") AS apps_in_year
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE f.value:"code"::STRING LIKE 'A01B3%'
      AND a.value::STRING IN (SELECT assignee FROM top_assignees)
    GROUP BY a.value::STRING,
             SUBSTRING(TO_VARCHAR(p."filing_date"), 1, 4)
),
best_year AS (
    SELECT
        assignee,
        filing_year  AS best_year,
        apps_in_year AS max_apps
    FROM (
        SELECT
            assignee,
            filing_year,
            apps_in_year,
            ROW_NUMBER() OVER (PARTITION BY assignee ORDER BY apps_in_year DESC) AS rn
        FROM apps_per_year
    )
    WHERE rn = 1
),
country_counts AS (
    SELECT
        a.value::STRING AS assignee,
        SUBSTRING(TO_VARCHAR(p."filing_date"), 1, 4) AS filing_year,
        p."country_code",
        COUNT(DISTINCT p."application_number") AS apps
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE f.value:"code"::STRING LIKE 'A01B3%'
      AND a.value::STRING IN (SELECT assignee FROM top_assignees)
    GROUP BY a.value::STRING,
             SUBSTRING(TO_VARCHAR(p."filing_date"), 1, 4),
             p."country_code"
),
best_country AS (
    SELECT
        assignee,
        filing_year,
        country_code AS top_country_in_best_year
    FROM (
        SELECT
            assignee,
            filing_year,
            country_code,
            ROW_NUMBER() OVER (
                PARTITION BY assignee, filing_year
                ORDER BY apps DESC
            ) AS rn
        FROM country_counts
    )
    WHERE rn = 1
)
SELECT
    ta.assignee,
    ta.total_apps,
    by.best_year,
    by.max_apps      AS apps_in_best_year,
    bc.top_country_in_best_year
FROM top_assignees ta
JOIN best_year    by ON ta.assignee = by.assignee
LEFT JOIN best_country bc
       ON bc.assignee    = ta.assignee
      AND bc.filing_year = by.best_year
LIMIT 20;
