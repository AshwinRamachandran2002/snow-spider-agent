Begin Exploring Related Columns
Relevant columns and their potential usage  
• PUBLICATIONS."cpc": CPC symbols; needed to locate class codes that start with 'A01B3'  
• PUBLICATIONS."assignee_harmonized": normalised owner names; key for counting applications per assignee  
• PUBLICATIONS."assignee": raw owner names (backup if harmonised empty)  
• PUBLICATIONS."application_number": unique application identifier; lets us count applications  
• PUBLICATIONS."filing_date": YYYYMMDD integer; we can derive the year in which an application was filed  
• PUBLICATIONS."publication_date": YYYYMMDD integer; alternative source for year if filing date is 0/null  
• PUBLICATIONS."country_code": two–letter patent‑office code; used to find the country with most applications in a given year  
• PUBLICATIONS."family_id": allows grouping related publications (optional)  

Typical filter / join conditions that may be required  
• LATERAL FLATTEN(input => t."cpc") f  – unnest the CPC array  
• WHERE f.value:"symbol"::STRING ILIKE 'A01B3%'  – keep only CPC codes of subclass A01B3  
• LATERAL FLATTEN(input => t."assignee_harmonized") a  – unnest the assignee list  
• COALESCE(a.value::STRING, r.value::STRING) IS NOT NULL  – pick harmonised name (fallback to raw)  
• YEAR extraction: SUBSTRING(TO_VARCHAR(t."filing_date"),1,4) AS filing_year  

Below are ten exploratory Snowflake SQL queries (each limited to 20 rows) that gradually move from simple inspection to the complete aggregation required.  

```sql
--Description: 1) Quick look at a handful of rows to understand the PUBLICATIONS table structure
SELECT 
  "publication_number",
  "cpc",
  "assignee_harmonized",
  "filing_date",
  "country_code"
FROM PATENTS.PATENTS.PUBLICATIONS
LIMIT 20;
```

```sql
--Description: 2) Show 20 flattened CPC symbols to verify the JSON path for the symbol field
SELECT 
  t."publication_number",
  f.value:"symbol"::STRING AS "cpc_code"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") f
LIMIT 20;
```

```sql
--Description: 3) Retrieve distinct CPC symbols that start with ‘A01B3’ (fuzzy match)
SELECT DISTINCT 
  f.value:"symbol"::STRING AS "a01b3_cpc"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") f
WHERE f.value:"symbol"::STRING ILIKE 'A01B3%'
LIMIT 20;
```

```sql
--Description: 4) List publication numbers and harmonised assignees that carry CPC codes ‘A01B3%’
SELECT 
  t."publication_number",
  a.value::STRING AS "assignee",
  f.value:"symbol"::STRING AS "cpc_code"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") f,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE f.value:"symbol"::STRING ILIKE 'A01B3%'
LIMIT 20;
```

```sql
--Description: 5) Distinct harmonised assignee names active in A01B3
SELECT DISTINCT 
  a.value::STRING AS "assignee"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") f,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE f.value:"symbol"::STRING ILIKE 'A01B3%'
LIMIT 20;
```

```sql
--Description: 6) Count total A01B3 applications per harmonised assignee
SELECT 
  a.value::STRING AS "assignee",
  COUNT(DISTINCT t."application_number") AS "total_apps"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") f,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE f.value:"symbol"::STRING ILIKE 'A01B3%'
GROUP BY a.value::STRING
ORDER BY "total_apps" DESC
LIMIT 20;
```

```sql
--Description: 7) Extract filing year and count applications per assignee per year (A01B3 only)
SELECT 
  a.value::STRING AS "assignee",
  SUBSTRING(TO_VARCHAR(t."filing_date"),1,4) AS "filing_year",
  COUNT(DISTINCT t."application_number") AS "apps_in_year"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") f,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE f.value:"symbol"::STRING ILIKE 'A01B3%'
GROUP BY a.value::STRING, SUBSTRING(TO_VARCHAR(t."filing_date"),1,4)
ORDER BY "apps_in_year" DESC
LIMIT 20;
```

```sql
--Description: 8) For each assignee/year pair show distribution across country codes
SELECT 
  a.value::STRING AS "assignee",
  SUBSTRING(TO_VARCHAR(t."filing_date"),1,4) AS "filing_year",
  t."country_code",
  COUNT(DISTINCT t."application_number") AS "apps"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") f,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE f.value:"symbol"::STRING ILIKE 'A01B3%'
GROUP BY a.value::STRING,
         SUBSTRING(TO_VARCHAR(t."filing_date"),1,4),
         t."country_code"
ORDER BY "apps" DESC
LIMIT 20;
```

```sql
--Description: 9) Identify the top 3 assignees by total A01B3 application count
SELECT 
  "assignee",
  "total_apps"
FROM (
  SELECT 
    a.value::STRING AS "assignee",
    COUNT(DISTINCT t."application_number") AS "total_apps"
  FROM PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."cpc") f,
       LATERAL FLATTEN(input => t."assignee_harmonized") a
  WHERE f.value:"symbol"::STRING ILIKE 'A01B3%'
  GROUP BY a.value::STRING
) q
ORDER BY "total_apps" DESC
LIMIT 3;
```

```sql
--Description: 10) Full aggregation: for the top 3 assignees, find (a) total applications, (b) their most‑active year, (c) apps in that year, (d) country with most apps that year
WITH top_assignees AS (
  SELECT 
    a.value::STRING AS assignee,
    COUNT(DISTINCT t."application_number") AS total_apps
  FROM PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."cpc") f,
       LATERAL FLATTEN(input => t."assignee_harmonized") a
  WHERE f.value:"symbol"::STRING ILIKE 'A01B3%'
  GROUP BY a.value::STRING
  ORDER BY total_apps DESC
  LIMIT 3
), apps_per_year AS (
  SELECT 
    a.value::STRING AS assignee,
    SUBSTRING(TO_VARCHAR(t."filing_date"),1,4) AS filing_year,
    COUNT(DISTINCT t."application_number") AS apps_in_year
  FROM PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."cpc") f,
       LATERAL FLATTEN(input => t."assignee_harmonized") a
  WHERE f.value:"symbol"::STRING ILIKE 'A01B3%'
    AND a.value::STRING IN (SELECT assignee FROM top_assignees)
  GROUP BY a.value::STRING, SUBSTRING(TO_VARCHAR(t."filing_date"),1,4)
), max_year AS (
  SELECT 
    t.assignee,
    FIRST_VALUE(filing_year) OVER (PARTITION BY assignee ORDER BY apps_in_year DESC) AS best_year,
    MAX(apps_in_year) AS max_apps
  FROM apps_per_year t
  GROUP BY assignee
)
SELECT 
  ta.assignee,
  ta.total_apps,
  my.best_year,
  my.max_apps AS apps_in_best_year,
  (SELECT country_code
     FROM PATENTS.PATENTS.PUBLICATIONS p,
          LATERAL FLATTEN(input => p."cpc") f2,
          LATERAL FLATTEN(input => p."assignee_harmonized") a2
     WHERE f2.value:"symbol"::STRING ILIKE 'A01B3%'
       AND a2.value::STRING = ta.assignee
       AND SUBSTRING(TO_VARCHAR(p."filing_date"),1,4) = my.best_year
     GROUP BY country_code
     ORDER BY COUNT(DISTINCT p."application_number") DESC
     LIMIT 1) AS top_country_in_best_year
FROM top_assignees ta
JOIN max_year my
  ON ta.assignee = my.assignee
LIMIT 20;
```
