Query:
--Description:  (10) FINAL – pick, for every store, the single year‑month that has the 
--              greatest number of rentals.  Uses ROW_NUMBER() to rank months per store
--              and then keeps only the top‑ranked (rn = 1).
WITH monthly AS (
     SELECT i."store_id",
            strftime('%Y', r."rental_date") AS "year",
            strftime('%m', r."rental_date") AS "month",
            COUNT(*)                       AS "rentals_in_month"
     FROM   "rental"    AS r
     JOIN   "inventory" AS i
            ON i."inventory_id" = r."inventory_id"
     GROUP  BY i."store_id",
              strftime('%Y', r."rental_date"),
              strftime('%m', r."rental_date")
),
ranked AS (
     SELECT monthly.*,
            ROW_NUMBER() OVER (
                 PARTITION BY store_id
                 ORDER BY rentals_in_month DESC
            ) AS rn
     FROM   monthly
)
SELECT store_id,
       year,
       month,
       rentals_in_month AS total_rentals
FROM   ranked
WHERE  rn = 1
ORDER  BY store_id
Answer:
store_id,year,month,total_rentals
1,2005,07,3334
2,2005,07,3375
