```sql
--Description: We want the year + month with the MOST rentals for every store.  
--Step‑1  Join rental → inventory to attach each rental to its store.  
--Step‑2  Group by store, year, month and count rows (one row = one rental).  
--Step‑3  Rank those (year,month) buckets per store by the rental count, highest first.  
--Step‑4  Keep the top‑ranked row (rn=1) for each store → that is the peak month.  
WITH monthly AS (                              -- Step‑1 & Step‑2
     SELECT i.store_id,
            strftime('%Y', r.rental_date) AS year,
            strftime('%m', r.rental_date) AS month,
            COUNT(*)                      AS rentals_in_month
     FROM   rental    AS r
     JOIN   inventory AS i
            ON i.inventory_id = r.inventory_id
     GROUP  BY i.store_id,
              strftime('%Y', r.rental_date),
              strftime('%m', r.rental_date)
),
ranked AS (                                   -- Step‑3
     SELECT monthly.*,
            ROW_NUMBER() OVER (
                 PARTITION BY store_id
                 ORDER BY rentals_in_month DESC
            ) AS rn
     FROM   monthly
)
SELECT store_id,                              -- Step‑4 (final output)
       year,
       month,
       rentals_in_month AS total_rentals
FROM   ranked
WHERE  rn = 1
ORDER  BY store_id;
```
