```sql
-- 6) Description: Add month‑over‑month % growth in unique orders for each category
WITH m AS (
  SELECT TO_CHAR(TO_TIMESTAMP("oi"."created_at" / 1000000), 'YYYY‑MM') AS "yyyymm",
         "p"."category",
         COUNT(DISTINCT "oi"."order_id") AS "orders_cnt"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" AS "oi"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    AS "p"
        ON "oi"."product_id" = "p"."id"
  WHERE "oi"."status" = 'Complete'
  GROUP BY 1, 2
)
SELECT "category",
       "yyyymm",
       "orders_cnt",
       LAG("orders_cnt") OVER (PARTITION BY "category" ORDER BY "yyyymm")          AS "prev_orders",
       ROUND(
         100.0 * ("orders_cnt" - LAG("orders_cnt") OVER (PARTITION BY "category" ORDER BY "yyyymm"))
         / NULLIF(LAG("orders_cnt") OVER (PARTITION BY "category" ORDER BY "yyyymm"), 0), 2
       ) AS "pct_growth_orders"
FROM m
ORDER BY "category", "yyyymm"
LIMIT 20;
```

```sql
-- 7) Description: Average monthly % growth rate in orders for every category
WITH m AS (
  SELECT TO_CHAR(TO_TIMESTAMP("oi"."created_at" / 1000000), 'YYYY‑MM') AS "yyyymm",
         "p"."category",
         COUNT(DISTINCT "oi"."order_id") AS "orders_cnt"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" AS "oi"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    AS "p"
        ON "oi"."product_id" = "p"."id"
  WHERE "oi"."status" = 'Complete'
  GROUP BY 1, 2
), g AS (
  SELECT "category",
         ROUND(AVG(
           100.0 * ("orders_cnt" - "prev_orders") / NULLIF("prev_orders", 0)
         ), 2) AS "avg_pct_growth_orders"
  FROM (
    SELECT "category",
           "orders_cnt",
           LAG("orders_cnt") OVER (PARTITION BY "category" ORDER BY "yyyymm") AS "prev_orders"
    FROM m
  ) q
  WHERE "prev_orders" IS NOT NULL
  GROUP BY "category"
)
SELECT *
FROM g
ORDER BY "avg_pct_growth_orders" DESC
LIMIT 20;
```

