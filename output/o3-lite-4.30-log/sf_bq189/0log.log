Query:
--Description:  Compute the average month‑over‑month revenue %‑growth for the
--              product category that itself has the highest average MoM growth
--              in DISTINCT completed orders.  The query:
--              1) builds monthly DISTINCT‑order counts per category,
--              2) finds the category with the greatest average MoM order‑growth,
--              3) calculates monthly revenue for that “best” category,
--              4) derives MoM revenue % changes, and
--              5) returns the category name together with its average revenue‑growth.

WITH "monthly_orders" AS (          -- step 1
    SELECT
        TO_CHAR(TO_TIMESTAMP("oi"."created_at" / 1000000), 'YYYY-MM') AS "yyyymm",
        "p"."category",
        COUNT(DISTINCT "oi"."order_id")                               AS "orders_cnt"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" AS "oi"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    AS "p"
          ON "oi"."product_id" = "p"."id"
    WHERE "oi"."status" = 'Complete'
    GROUP BY 1, 2
),
"order_growth" AS (                 -- step 2
    SELECT
        "category",
        ( "orders_cnt"
          - LAG("orders_cnt") OVER (PARTITION BY "category" ORDER BY "yyyymm") )
        / NULLIF( LAG("orders_cnt") OVER (PARTITION BY "category" ORDER BY "yyyymm"), 0 )
        AS "pct_growth"
    FROM "monthly_orders"
),
"best_category" AS (                -- pick the winner
    SELECT "category"
    FROM   "order_growth"
    WHERE  "pct_growth" IS NOT NULL
    GROUP  BY "category"
    ORDER  BY AVG("pct_growth") DESC
    LIMIT  1
),
"monthly_revenue" AS (              -- step 3
    SELECT
        TO_CHAR(TO_TIMESTAMP("oi"."created_at" / 1000000), 'YYYY-MM') AS "yyyymm",
        SUM("oi"."sale_price")                                        AS "revenue"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" AS "oi"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    AS "p"
          ON "oi"."product_id" = "p"."id"
    JOIN "best_category" bc
          ON "p"."category" = bc."category"
    WHERE "oi"."status" = 'Complete'
    GROUP BY 1
),
"revenue_growth" AS (               -- step 4
    SELECT
        ( "revenue"
          - LAG("revenue") OVER (ORDER BY "yyyymm") )
        / NULLIF( LAG("revenue") OVER (ORDER BY "yyyymm"), 0 )        AS "pct_growth"
    FROM "monthly_revenue"
)
SELECT
    (SELECT "category" FROM "best_category")                AS "category",
    ROUND( AVG("pct_growth") * 100 , 2)                     AS "avg_pct_growth_revenue"
FROM "revenue_growth"
WHERE "pct_growth" IS NOT NULL
Answer:
category,avg_pct_growth_revenue
