```sql
-- 9) Description: Monthly revenue & MoM revenue % change for the winning category (replace X with actual category from query 8)
WITH base AS (
  SELECT TO_CHAR(TO_TIMESTAMP("oi"."created_at" / 1000000), 'YYYY‑MM') AS "yyyymm",
         SUM("oi"."sale_price") AS "revenue"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" AS "oi"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    AS "p"
        ON "oi"."product_id" = "p"."id"
  WHERE "oi"."status" = 'Complete'
    AND "p"."category" = 'X'              -- put category name here
  GROUP BY 1
)
SELECT "yyyymm",
       "revenue",
       LAG("revenue") OVER (ORDER BY "yyyymm")                      AS "prev_revenue",
       ROUND(
         100.0 * ("revenue" - LAG("revenue") OVER (ORDER BY "yyyymm"))
         / NULLIF(LAG("revenue") OVER (ORDER BY "yyyymm"), 0), 2
       ) AS "pct_growth_revenue"
FROM base
ORDER BY "yyyymm"
LIMIT 20;
```

```sql
-- 10) Description: Average monthly revenue growth rate for the highest‑growth category
WITH base AS (
  SELECT TO_CHAR(TO_TIMESTAMP("oi"."created_at" / 1000000), 'YYYY‑MM') AS "yyyymm",
         SUM("oi"."sale_price") AS "revenue"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" AS "oi"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    AS "p"
        ON "oi"."product_id" = "p"."id"
  WHERE "oi"."status" = 'Complete'
    AND "p"."category" = 'X'          -- same category as above
  GROUP BY 1
), final AS (
  SELECT ("revenue" - "prev_revenue") / NULLIF("prev_revenue", 0) AS "growth"
  FROM (
    SELECT "revenue",
           LAG("revenue") OVER (ORDER BY "yyyymm") AS "prev_revenue"
    FROM base
  ) t
  WHERE "prev_revenue" IS NOT NULL
)
SELECT ROUND(AVG("growth") * 100, 2) AS "avg_pct_growth_revenue"
FROM final
LIMIT 20;
```

