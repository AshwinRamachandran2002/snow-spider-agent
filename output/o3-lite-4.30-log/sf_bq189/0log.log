```

```sql
-- 4) Description: Join order‑items to products to see category information
SELECT "oi"."order_id",
       "oi"."product_id",
       "p"."category",
       "oi"."sale_price",
       "oi"."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" AS "oi"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"  AS "p"
      ON "oi"."product_id" = "p"."id"
WHERE "oi"."status" = 'Complete'
LIMIT 20;
```

```sql
-- 5) Description: Count DISTINCT orders per category per calendar month
SELECT TO_CHAR(TO_TIMESTAMP("oi"."created_at" / 1000000), 'YYYY‑MM') AS "yyyymm",
       "p"."category",
       COUNT(DISTINCT "oi"."order_id")                   AS "orders_in_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" AS "oi"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    AS "p"
      ON "oi"."product_id" = "p"."id"
WHERE "oi"."status" = 'Complete'
GROUP BY 1, 2
ORDER BY 2, 1
LIMIT 20;
```

```sql
-- 6) Description: Add month‑over‑month % growth in unique orders for each category
WITH m AS (
  SELECT TO_CHAR(TO_TIMESTAMP("oi"."created_at" / 1000000), 'YYYY‑MM') AS "yyyymm",
         "p"."category",
         COUNT(DISTINCT "oi"."order_id") AS "orders_cnt"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" AS "oi"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    AS "p"
        ON "oi"."product_id" = "p"."id"
  WHERE "oi"."status" = 'Complete'
  GROUP BY 1, 2
)
SELECT "category",
       "yyyymm",
       "orders_cnt",
       LAG("orders_cnt") OVER (PARTITION BY "category" ORDER BY "yyyymm")          AS "prev_orders",
       ROUND(
         100.0 * ("orders_cnt" - LAG("orders_cnt") OVER (PARTITION BY "category" ORDER BY "yyyymm"))
         / NULLIF(LAG("orders_cnt") OVER (PARTITION BY "category" ORDER BY "yyyymm"), 0), 2
       ) AS "pct_growth_orders"
FROM m
ORDER BY "category", "yyyymm"
LIMIT 20;
```

```sql
-- 7) Description: Average monthly % growth rate in orders for every category
WITH m AS (
  SELECT TO_CHAR(TO_TIMESTAMP("oi"."created_at" / 1000000), 'YYYY‑MM') AS "yyyymm",
         "p"."category",
         COUNT(DISTINCT "oi"."order_id") AS "orders_cnt"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" AS "oi"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    AS "p"
        ON "oi"."product_id" = "p"."id"
  WHERE "oi"."status" = 'Complete'
  GROUP BY 1, 2
), g AS (
  SELECT "category",
         ROUND(AVG(
           100.0 * ("orders_cnt" - "prev_orders") / NULLIF("prev_orders", 0)
         ), 2) AS "avg_pct_growth_orders"
  FROM (
    SELECT "category",
           "orders_cnt",
           LAG("orders_cnt") OVER (PARTITION BY "category" ORDER BY "yyyymm") AS "prev_orders"
    FROM m
  ) q
  WHERE "prev_orders" IS NOT NULL
  GROUP BY "category"
)
SELECT *
FROM g
ORDER BY "avg_pct_growth_orders" DESC
LIMIT 20;
```

```sql
-- 8) Description: Identify the single category with the highest avg order growth
WITH m AS (
  SELECT TO_CHAR(TO_TIMESTAMP("oi"."created_at" / 1000000), 'YYYY‑MM') AS "yyyymm",
         "p"."category",
         COUNT(DISTINCT "oi"."order_id") AS "orders_cnt"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" AS "oi"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    AS "p"
        ON "oi"."product_id" = "p"."id"
  WHERE "oi"."status" = 'Complete'
  GROUP BY 1, 2
), g AS (
  SELECT "category",
         AVG( ("orders_cnt" - "prev_orders") / NULLIF("prev_orders", 0) ) AS "avg_growth"
  FROM (
    SELECT "category",
           "orders_cnt",
           LAG("orders_cnt") OVER (PARTITION BY "category" ORDER BY "yyyymm") AS "prev_orders"
    FROM m
  ) q
  WHERE "prev_orders" IS NOT NULL
  GROUP BY "category"
)
SELECT "category"
FROM g
ORDER BY "avg_growth" DESC
LIMIT 1;
```

```sql
-- 9) Description: Monthly revenue & MoM revenue % change for the winning category (replace X with actual category from query 8)
WITH base AS (
  SELECT TO_CHAR(TO_TIMESTAMP("oi"."created_at" / 1000000), 'YYYY‑MM') AS "yyyymm",
         SUM("oi"."sale_price") AS "revenue"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" AS "oi"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    AS "p"
        ON "oi"."product_id" = "p"."id"
  WHERE "oi"."status" = 'Complete'
    AND "p"."category" = 'X'              -- put category name here
  GROUP BY 1
)
SELECT "yyyymm",
       "revenue",
       LAG("revenue") OVER (ORDER BY "yyyymm")                      AS "prev_revenue",
       ROUND(
         100.0 * ("revenue" - LAG("revenue") OVER (ORDER BY "yyyymm"))
         / NULLIF(LAG("revenue") OVER (ORDER BY "yyyymm"), 0), 2
       ) AS "pct_growth_revenue"
FROM base
ORDER BY "yyyymm"
LIMIT 20;
```

```sql
-- 10) Description: Average monthly revenue growth rate for the highest‑growth category
WITH base AS (
  SELECT TO_CHAR(TO_TIMESTAMP("oi"."created_at" / 1000000), 'YYYY‑MM') AS "yyyymm",
         SUM("oi"."sale_price") AS "revenue"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" AS "oi"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    AS "p"
        ON "oi"."product_id" = "p"."id"
  WHERE "oi"."status" = 'Complete'
    AND "p"."category" = 'X'          -- same category as above
  GROUP BY 1
), final AS (
  SELECT ("revenue" - "prev_revenue") / NULLIF("prev_revenue", 0) AS "growth"
  FROM (
    SELECT "revenue",
           LAG("revenue") OVER (ORDER BY "yyyymm") AS "prev_revenue"
    FROM base
  ) t
  WHERE "prev_revenue" IS NOT NULL
)
SELECT ROUND(AVG("growth") * 100, 2) AS "avg_pct_growth_revenue"
FROM final
LIMIT 20;
```

Each query is capped at 20 rows and wrapped in double quotes for all column identifiers to conform to Snowflake best practices.
