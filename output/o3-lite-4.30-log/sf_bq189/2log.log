    ROUND(tc."avg_mo_order_growth_pct",2)  AS "avg_mo_order_growth_pct",
    ROUND(arg."avg_mo_revenue_growth_pct",2) AS "avg_mo_revenue_growth_pct"
FROM top_category  tc
CROSS JOIN avg_revenue_growth arg;
