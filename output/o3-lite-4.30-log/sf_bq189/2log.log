WHERE o."status" = 'Complete'
LIMIT 20;
```

```sql
-- 6. Add product information (to bring in the category dimension)
SELECT oi."order_id",
       p."category",
       oi."sale_price",
       o."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
  ON o."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
  ON p."id" = oi."product_id"
WHERE o."status" = 'Complete'
LIMIT 20;
```

```sql
-- 7. Monthly distinct‑order count by category (first building block)
SELECT TO_CHAR(TO_TIMESTAMP(o."created_at"/1e6), 'YYYY‑MM') AS "yr_mo",
       p."category",
       COUNT(DISTINCT o."order_id")                         AS "unique_orders"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"        o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"   oi
  ON o."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
  ON p."id" = oi."product_id"
WHERE o."status" = 'Complete'
GROUP BY 1,2
ORDER BY 2,1
LIMIT 20;
```

```sql
-- 8. Compute month‑over‑month % growth in unique orders for each category
WITH month_orders AS (
  SELECT TO_CHAR(TO_TIMESTAMP(o."created_at"/1e6), 'YYYY‑MM') AS "yr_mo",
         p."category",
         COUNT(DISTINCT o."order_id")                         AS "unique_orders"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"        o
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"   oi
    ON o."order_id" = oi."order_id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
    ON p."id" = oi."product_id"
  WHERE o."status" = 'Complete'
  GROUP BY 1,2
)
SELECT "category",
       "yr_mo",
       "unique_orders",
       LAG("unique_orders")  OVER (PARTITION BY "category" ORDER BY "yr_mo") AS "prev_month_orders",
       CASE
         WHEN LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "yr_mo") = 0 THEN NULL
         ELSE ROUND( ( "unique_orders" - LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "yr_mo") )
                     / LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "yr_mo") * 100 , 2)
       END AS "pct_growth_orders"
FROM month_orders
ORDER BY "category", "yr_mo"
LIMIT 20;
```

```sql
-- 9. Average monthly order‑growth rate per category (identify highest performer)
WITH month_orders AS (
  SELECT TO_CHAR(TO_TIMESTAMP(o."created_at"/1e6), 'YYYY‑MM') AS "yr_mo",
         p."category",
         COUNT(DISTINCT o."order_id")                         AS "unique_orders"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"        o
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"   oi
    ON o."order_id" = oi."order_id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
    ON p."id" = oi."product_id"
  WHERE o."status" = 'Complete'
  GROUP BY 1,2
), growth AS (
  SELECT "category",
         "yr_mo",
         ( "unique_orders"
           - LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "yr_mo") )
         / NULLIF( LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "yr_mo"), 0) * 100
         AS "pct_growth_orders"
  FROM month_orders
)
SELECT "category",
       ROUND(AVG("pct_growth_orders"),2) AS "avg_mo_order_growth_pct"
FROM growth
WHERE "pct_growth_orders" IS NOT NULL
GROUP BY "category"
ORDER BY "avg_mo_order_growth_pct" DESC
LIMIT 20;
```

```sql
-- 10. For the top‑growing category, compute average monthly revenue growth
WITH order_lines AS (
  SELECT oi."sale_price",
         TO_CHAR(TO_TIMESTAMP(o."created_at"/1e6), 'YYYY‑MM') AS "yr_mo",
         p."category"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"   oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"        o
    ON o."order_id" = oi."order_id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
    ON p."id" = oi."product_id"
  WHERE o."status" = 'Complete'
    AND p."category" = /*YOUR_CATEGORY*/
), month_revenue AS (
  SELECT "yr_mo",
         SUM("sale_price") AS "revenue"
  FROM order_lines
  GROUP BY 1
), rev_growth AS (
  SELECT "yr_mo",
         "revenue",
         LAG("revenue") OVER (ORDER BY "yr_mo") AS "prev_rev",
         ( "revenue" - LAG("revenue") OVER (ORDER BY "yr_mo") )
         / NULLIF( LAG("revenue") OVER (ORDER BY "yr_mo"), 0) * 100 AS "pct_growth_rev"
  FROM month_revenue
)
SELECT ROUND(AVG("pct_growth_rev"),2) AS "avg_mo_revenue_growth_pct"
FROM rev_growth
WHERE "pct_growth_rev" IS NOT NULL
LIMIT 20;
```

