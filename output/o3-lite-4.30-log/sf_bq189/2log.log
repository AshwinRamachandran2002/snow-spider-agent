```sql
--Description: End‑to‑end solution in one statement.
-- 1) Build monthly distinct‑order counts per product category (month_orders).
-- 2) Calculate month‑over‑month % growth in those counts (order_growth).
-- 3) Average the monthly growth per category (avg_growth) and pick the category
--    with the highest average growth (top_cat).
-- 4) For that winning category, aggregate monthly revenue from completed orders,
--    compute month‑over‑month % revenue growth (rev_growth), and average it.
-- 5) Return a single row containing:
--       • top‑growing category
--       • its average monthly order‑growth %
--       • its average monthly revenue‑growth %

WITH month_orders AS (
    SELECT
        TO_CHAR(TO_TIMESTAMP(o."created_at" / 1e6), 'YYYY-MM') AS "yr_mo",
        p."category",
        COUNT(DISTINCT o."order_id")                           AS "unique_orders"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"        o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"   oi
      ON o."order_id" = oi."order_id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
      ON p."id" = oi."product_id"
    WHERE o."status" = 'Complete'
    GROUP BY "yr_mo", p."category"
),
order_growth AS (
    SELECT
        "category",
        "yr_mo",
        ( "unique_orders"
          - LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "yr_mo") )
        / NULLIF( LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "yr_mo"), 0 )
        * 100                                                     AS "pct_growth_orders"
    FROM month_orders
),
avg_growth AS (
    SELECT
        "category",
        ROUND(AVG("pct_growth_orders"), 2) AS "avg_mo_order_growth_pct"
    FROM order_growth
    WHERE "pct_growth_orders" IS NOT NULL
    GROUP BY "category"
),
top_cat AS (      -- choose the category with the highest avg order growth
    SELECT
        "category",
        "avg_mo_order_growth_pct"
    FROM avg_growth
    QUALIFY ROW_NUMBER() OVER (ORDER BY "avg_mo_order_growth_pct" DESC) = 1
),
order_lines AS (  -- all completed order lines for the top category
    SELECT
        oi."sale_price",
        TO_CHAR(TO_TIMESTAMP(o."created_at" / 1e6), 'YYYY-MM') AS "yr_mo"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
      ON o."order_id" = oi."order_id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
      ON p."id" = oi."product_id"
    JOIN top_cat tc
      ON p."category" = tc."category"
    WHERE o."status" = 'Complete'
),
month_revenue AS (
    SELECT
        "yr_mo",
        SUM("sale_price") AS "revenue"
    FROM order_lines
    GROUP BY "yr_mo"
),
rev_growth AS (
    SELECT
        ( "revenue" - LAG("revenue") OVER (ORDER BY "yr_mo") )
        / NULLIF( LAG("revenue") OVER (ORDER BY "yr_mo"), 0 ) * 100 AS "pct_growth_rev"
    FROM month_revenue
)
SELECT
    tc."category"                       AS "top_category",
    tc."avg_mo_order_growth_pct",
    ROUND(AVG(rg."pct_growth_rev"), 2)  AS "avg_mo_revenue_growth_pct"
FROM top_cat tc
LEFT JOIN rev_growth rg
  ON 1=1                -- join to bring the revenue growth rows into aggregation
WHERE rg."pct_growth_rev" IS NOT NULL
GROUP BY tc."category", tc."avg_mo_order_growth_pct";
