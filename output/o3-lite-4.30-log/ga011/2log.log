```sql
--Description: We must identify the page (URL path) with the SECOND‑highest number of
--             page‑views on the host “shop.googlemerchandisestore.com” during
--             December 2020.  The steps embedded in this one query are:
--   • Read every events table whose suffix starts with 202012 (all December days).
--   • Keep only rows where event_name = 'page_view'.
--   • Unnest event_params to isolate the element where key = 'page_location';
--     this contains the full visited URL.
--   • Filter to URLs whose host is our target domain.
--   • From each URL, extract ONLY the pathname (everything after the first slash
--     that follows the domain) and replace multiple slashes with a single slash,
--     yielding a clean canonical path.
--   • Aggregate (COUNT) page‑views per clean path.
--   • Order the aggregates by count descending, skip the very top record, and
--     return the next one, which is the 2nd‑most‑viewed page.
WITH december_paths AS (
  SELECT
    -- Extract the pathname and normalise any duplicate slashes.
    REGEXP_REPLACE(
      REGEXP_EXTRACT(ep.value.string_value, r'https?://[^/]+(/.*)'),
      r'/+',
      '/'
    ) AS clean_path,
    COUNT(*) AS page_views
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
       , UNNEST(event_params) AS ep
  WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'   -- limit to December 2020
    AND event_name = 'page_view'                          -- only page view events
    AND ep.key = 'page_location'                          -- URL parameter
    AND LOWER(ep.value.string_value)
        LIKE '%shop.googlemerchandisestore.com%'          -- domain filter
  GROUP BY clean_path
)
SELECT clean_path, page_views
FROM december_paths
ORDER BY page_views DESC
OFFSET 1      -- skip the most‑viewed page, giving us the 2nd place
LIMIT 1;
