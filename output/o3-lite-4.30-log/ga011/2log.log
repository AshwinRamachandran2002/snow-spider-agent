```sql
-- 6. Extract only the pathname part of the URL
SELECT
  REGEXP_EXTRACT(
    ep.value.string_value,
    r'https?://[^/]+(/.*)'
  ) AS raw_path
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
UNNEST(event_params) AS ep
WHERE _TABLE_SUFFIX LIKE '202012%'
  AND event_name = 'page_view'
  AND ep.key     = 'page_location'
  AND LOWER(ep.value.string_value) LIKE '%shop.googlemerchandisestore.com%'
LIMIT 20;
```

```sql
-- 7. Clean the pathname by collapsing duplicated slashes (“//” ➜ “/”)
SELECT
  REGEXP_REPLACE(
    REGEXP_EXTRACT(ep.value.string_value, r'https?://[^/]+(/.*)'),
    r'/+',
    '/'
  ) AS clean_path
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
UNNEST(event_params) AS ep
WHERE _TABLE_SUFFIX LIKE '202012%'
  AND event_name = 'page_view'
  AND ep.key     = 'page_location'
  AND LOWER(ep.value.string_value) LIKE '%shop.googlemerchandisestore.com%'
LIMIT 20;
```

```sql
-- 8. Count page‑views per cleaned path for one December day
SELECT
  REGEXP_REPLACE(
    REGEXP_EXTRACT(ep.value.string_value, r'https?://[^/]+(/.*)'),
    r'/+',
    '/'
  ) AS clean_path,
  COUNT(*) AS page_views
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`,
UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
  AND LOWER(ep.value.string_value) LIKE '%shop.googlemerchandisestore.com%'
GROUP BY clean_path
ORDER BY page_views DESC
LIMIT 20;
```

```sql
-- 9. Aggregate across the whole month and list top 20 pages
SELECT
  REGEXP_REPLACE(
    REGEXP_EXTRACT(ep.value.string_value, r'https?://[^/]+(/.*)'),
    r'/+',
    '/'
  ) AS clean_path,
  COUNT(*) AS total_page_views
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
UNNEST(event_params) AS ep
WHERE _TABLE_SUFFIX LIKE '202012%'
  AND event_name = 'page_view'
  AND ep.key     = 'page_location'
  AND LOWER(ep.value.string_value) LIKE '%shop.googlemerchandisestore.com%'
GROUP BY clean_path
ORDER BY total_page_views DESC
LIMIT 20;
```

```sql
-- 10. Return the page with the 2nd‑highest number of page‑views in Dec‑2020
--    (after URL clean‑up)
WITH monthly AS (
  SELECT
    REGEXP_REPLACE(
      REGEXP_EXTRACT(ep.value.string_value, r'https?://[^/]+(/.*)'),
      r'/+',
      '/'
    ) AS clean_path,
    COUNT(*) AS total_page_views
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
  UNNEST(event_params) AS ep
  WHERE _TABLE_SUFFIX LIKE '202012%'
    AND event_name = 'page_view'
    AND ep.key     = 'page_location'
    AND LOWER(ep.value.string_value) LIKE '%shop.googlemerchandisestore.com%'
  GROUP BY clean_path
)
SELECT clean_path, total_page_views
FROM monthly
ORDER BY total_page_views DESC
OFFSET 1            -- skip the highest
LIMIT 20;            -- show the 2nd‑highest (plus extra if tie)
```

The final query (No. 10) delivers the required answer: the cleaned `clean_path` whose total December 2020 page‑views rank second on the host `shop.googlemerchandisestore.com`.
