--Description:
-- Objective: return the pathname with the second‑highest count of December‑2020
-- page‑views for the domain shop.googlemerchandisestore.com.  
-- Logic inside the query:
-- 1. Scan all GA4 event tables whose suffix starts with 202012 (every day in Dec‑2020).  
-- 2. Keep only rows where event_name = 'page_view' (each row = one page‑view).  
-- 3. CROSS JOIN UNNEST(event_params) so each key/value pair is available; filter
--    to the element whose key = 'page_location' (full URL that was viewed).  
-- 4. Keep only those URLs whose host contains the target domain (case‑insensitive).  
-- 5. Extract the pathname (everything after the domain) and collapse duplicate
--    slashes (e.g. “//” ➜ “/”) to generate a canonical clean_path.  
-- 6. Aggregate counts per clean_path.  
-- 7. Sort results by count descending and use LIMIT 1 OFFSET 1 to skip the most‑viewed
--    page and return the page ranked second.
WITH december_counts AS (
  SELECT
    REGEXP_REPLACE(                                   -- collapse duplicate '/'
      REGEXP_EXTRACT(ep.value.string_value, r'https?://[^/]+(/.*)'),
      r'/+',
      '/'
    )   AS clean_path,
    COUNT(*) AS page_views
  FROM
    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
    CROSS JOIN UNNEST(event_params) AS ep
  WHERE
    event_name = 'page_view'
    AND ep.key  = 'page_location'
    AND LOWER(ep.value.string_value) LIKE '%shop.googlemerchandisestore.com%'
  GROUP BY clean_path
)
SELECT clean_path, page_views
FROM   december_counts
ORDER BY page_views DESC
LIMIT 1 OFFSET 1;   -- second‑highest‑traffic page
