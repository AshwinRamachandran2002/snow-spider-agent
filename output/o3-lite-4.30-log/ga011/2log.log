-- 6. Count page‑views per `clean_path`.
-- 7. Order by page‑views descending, skip the very top row, and return the next
--    one — the page with the second‑highest total page‑views.
WITH paths AS (
  SELECT
    REGEXP_REPLACE(                                      -- collapse duplicate '/'
      REGEXP_EXTRACT(ep.value.string_value, r'https?://[^/]+(/.*)'),
      r'/+',
      '/'
    ) AS clean_path,
