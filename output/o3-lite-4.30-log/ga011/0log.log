paths AS (
  SELECT
    REGEXP_REPLACE(
      REGEXP_REPLACE(
        REGEXP_EXTRACT(pl, r'^[^?#]+'),   -- keep part before ? or #
        r'^https?://[^/]+', ''            -- drop scheme & host
      ),
      r'/+', '/'                          -- collapse multiple slashes
    )                      AS page_path,
    COUNT(*)               AS total_page_views
  FROM (
    SELECT
      (SELECT value.string_value
       FROM UNNEST(event_params)
       WHERE key = 'page_location') AS pl
    FROM dec2020
    WHERE event_name = 'page_view'
  )
  WHERE LOWER(SPLIT(pl, '/')[OFFSET(2)]) = 'shop.googlemerchandisestore.com'
  GROUP BY page_path
)
SELECT
  page_path,
  total_page_views
FROM (
  SELECT
    page_path,
    total_page_views,
    DENSE_RANK() OVER (ORDER BY total_page_views DESC) AS rnk
  FROM paths
)
WHERE rnk = 2;
