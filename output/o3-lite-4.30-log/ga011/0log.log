--Description: (#7) Clean up each URL (remove scheme+host, drop query/fragment, collapse multiple
--slashes), count page‑views per cleaned path and list the 20 most‑viewed paths.
SELECT
  REGEXP_REPLACE(                                   -- collapse //, /// …
    REGEXP_REPLACE(                                 -- strip scheme & host
      REGEXP_EXTRACT(pl, r'^[^?#]+'),               -- keep part before ? or #
      r'^https?://[^/]+', ''
    ),
    r'/+', '/'
  )                         AS clean_path,
  COUNT(*)                  AS pageviews
FROM (
  SELECT
    (SELECT value.string_value
     FROM UNNEST(event_params)
     WHERE key = 'page_location') AS pl
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE event_name = 'page_view'
)
WHERE LOWER(SPLIT(pl,'/')[OFFSET(2)]) = 'shop.googlemerchandisestore.com'
GROUP BY clean_path
ORDER BY pageviews DESC
LIMIT 20
