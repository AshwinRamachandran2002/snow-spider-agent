Relevant columns and how they will be used  

event_date               : restrict the scan to the month of interest (20201201‑20201231)  
event_name               : keep only the “page_view” events  
event_params             : UNNEST to reach individual parameters (page_location, page_path, page_hostname …)  
  └─ key                 : name of the parameter (e.g. 'page_location')  
  └─ value.string_value  : the string that holds the parameter value  
event_timestamp          : could be used for ordering, not strictly necessary here  

Typical filter / join conditions that will appear in most queries  

• event_name = 'page_view'  
• event_date BETWEEN '20201201' AND '20201231'  
• ep.key        = 'page_location' (or 'page_path', 'page_hostname' etc.)  
• REGEXP_EXTRACT(ep.value.string_value,r'://([^/]+)') = 'shop.googlemerchandisestore.com'  

--------------------------------------------------------------------
Ten exploratory → final queries  
(the dataset only allows the listed tables, so we use the daily partitions
`bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`)  

```sql
-- 1. Quick glance at all event names occurring in December 2020
SELECT DISTINCT event_name
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
LIMIT 20;
```

```sql
-- 2. Inspect all parameter keys that appear in "page_view" events
SELECT DISTINCT ep.key
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
     UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
LIMIT 20;
```

```sql
-- 3. Look at a few raw page_location values
SELECT ep.value.string_value AS page_location
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
     UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key      = 'page_location'
LIMIT 20;
```

```sql
-- 4. Extract only the hostname part from page_location
SELECT
  REGEXP_EXTRACT(ep.value.string_value, r'://([^/]+)') AS hostname,
  COUNT(*)                                            AS views
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
     UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key      = 'page_location'
GROUP BY hostname
ORDER BY views DESC
LIMIT 20;
```

```sql
-- 5. Pull the pure path from page_location and collapse multiple slashes
SELECT
  REGEXP_REPLACE(           -- collapse //, /// ...
    REGEXP_EXTRACT(ep.value.string_value, r'://[^/]+(/.*)'), 
  r'/+', '/') AS clean_path
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201215`,
     UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key      = 'page_location'
  AND REGEXP_EXTRACT(ep.value.string_value, r'://([^/]+)') = 'shop.googlemerchandisestore.com'
LIMIT 20;
```

```sql
-- 6. Page‑view counts for one day (15‑Dec‑2020) on the requested site
SELECT
  REGEXP_REPLACE(REGEXP_EXTRACT(ep.value.string_value,r'://[^/]+(/.*)'),r'/+','/') AS clean_path,
  COUNT(*) AS pageviews
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201215`,
     UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key      = 'page_location'
  AND REGEXP_EXTRACT(ep.value.string_value,r'://([^/]+)') = 'shop.googlemerchandisestore.com'
GROUP BY clean_path
ORDER BY pageviews DESC
LIMIT 20;
```

```sql
-- 7. Same idea but for all of December 2020
SELECT
  REGEXP_REPLACE(REGEXP_EXTRACT(ep.value.string_value,r'://[^/]+(/.*)'),r'/+','/') AS clean_path,
  COUNT(*) AS pageviews
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
     UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key      = 'page_location'
  AND REGEXP_EXTRACT(ep.value.string_value,r'://([^/]+)') = 'shop.googlemerchandisestore.com'
GROUP BY clean_path
ORDER BY pageviews DESC
LIMIT 20;
```

```sql
-- 8. Rank every path by total December page‑views (include a rank column)
SELECT
  clean_path,
  pageviews,
  DENSE_RANK() OVER(ORDER BY pageviews DESC) AS rnk
FROM (
  SELECT
    REGEXP_REPLACE(REGEXP_EXTRACT(ep.value.string_value,r'://[^/]+(/.*)'),r'/+','/') AS clean_path,
    COUNT(*) AS pageviews
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(event_params) AS ep
  WHERE event_name = 'page_view'
    AND ep.key      = 'page_location'
    AND REGEXP_EXTRACT(ep.value.string_value,r'://([^/]+)') = 'shop.googlemerchandisestore.com'
  GROUP BY clean_path
)
ORDER BY pageviews DESC
LIMIT 20;
```

```sql
-- 9. Fetch precisely the 2nd‑ranked path (method 1: use rank filter)
SELECT clean_path
FROM (
  SELECT
    REGEXP_REPLACE(REGEXP_EXTRACT(ep.value.string_value,r'://[^/]+(/.*)'),r'/+','/') AS clean_path,
    COUNT(*) AS pageviews,
    DENSE_RANK() OVER(ORDER BY COUNT(*) DESC) AS rnk
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(event_params) AS ep
  WHERE event_name = 'page_view'
    AND ep.key      = 'page_location'
    AND REGEXP_EXTRACT(ep.value.string_value,r'://([^/]+)') = 'shop.googlemerchandisestore.com'
  GROUP BY clean_path
)
WHERE rnk = 2
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER QUERY – returns the page with the 2nd‑highest December 2020 page‑views
--     (collapses repeated slashes, isolates the proper path)
SELECT clean_path AS second_most_viewed_page
FROM (
  SELECT
    REGEXP_REPLACE(
      REGEXP_EXTRACT(ep.value.string_value, r'://[^/]+(/.*)'),
      r'/+',
      '/'
    )                                             AS clean_path,
    COUNT(*)                                      AS pageviews,
    DENSE_RANK() OVER (ORDER BY COUNT(*) DESC)    AS rnk
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(event_params) AS ep
  WHERE event_name = 'page_view'
    AND ep.key      = 'page_location'
    AND REGEXP_EXTRACT(ep.value.string_value, r'://([^/]+)') = 'shop.googlemerchandisestore.com'
  GROUP BY clean_path
)
WHERE rnk = 2
LIMIT 20;
```

