2025-05-01 01:04:05 - Thread-175 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
(PYPI.PYPI.DISTRIBUTION_METADATA)  
• "name": package identifier – join key to downloads, used for grouping  
• "version": package release – used for selecting latest release per package  
• "upload_time": numeric epoch‑like timestamp – derive most‑recent version  
• "project_urls": VARIANT containing labelled links – source for GitHub URL  
• "home_page": fallback single link – possible GitHub URL  
• "summary": helpful for quick visual checks (optional)  

(PYPI.PYPI.FILE_DOWNLOADS)  
• "project": package identifier – join key to metadata."name"  
• "url": file path – not needed for counting but available  
• "timestamp": download time – can be aggregated by day if desired  
Conditions likely used  
• Join on metadata."name" = downloads."project"  
• Aggregation: COUNT(*) AS download_cnt  
• Latest version: QUALIFY ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) = 1  
• GitHub link filter: ILIKE '%github.com/%'  
• Cleaning URL: REGEXP_REPLACE(url, '/(issues|pull|blob|tree).*', '')  

Ten exploratory Snowflake SQL queries (each limited to 20 rows)  
```sql
--Description: 1) Quick glance at a few package names in metadata
SELECT DISTINCT "name"
FROM PYPI.PYPI.DISTRIBUTION_METADATA
LIMIT 20;
```

```sql
--Description: 2) Inspect the structure of "project_urls" for one random package
SELECT "name", "project_urls"
FROM PYPI.PYPI.DISTRIBUTION_METADATA
WHERE "project_urls" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 3) Flatten "project_urls" to see individual label‑URL pairs
SELECT t."name",
       f.key   AS "url_label",
       f.value AS "url_value"
FROM PYPI.PYPI.DISTRIBUTION_METADATA t,
     LATERAL FLATTEN(input => t."project_urls") f
LIMIT 20;
```

```sql
--Description: 4) Preview packages whose Home‑page points to GitHub
SELECT "name",
       "home_page"
FROM PYPI.PYPI.DISTRIBUTION_METADATA
WHERE "home_page" ILIKE '%github.com/%'
LIMIT 20;
```

```sql
--Description: 5) Extract all GitHub links from flattened project_urls
SELECT t."name",
       f.value::STRING AS "raw_github_url"
FROM PYPI.PYPI.DISTRIBUTION_METADATA t,
     LATERAL FLATTEN(input => t."project_urls") f
WHERE f.value::STRING ILIKE '%github.com/%'
LIMIT 20;
```

```sql
--Description: 6) Clean the GitHub URLs (remove /issues, /pull, /blob, /tree etc.)
SELECT DISTINCT
       REGEXP_REPLACE(f.value::STRING,
                      '/(issues|pull|blob|tree).*',
                      '')                                     AS "clean_repo_url"
FROM PYPI.PYPI.DISTRIBUTION_METADATA t,
     LATERAL FLATTEN(input => t."project_urls") f
WHERE f.value::STRING ILIKE '%github.com/%'
LIMIT 20;
```

```sql
--Description: 7) Determine most recent version of each package
SELECT "name",
       "version",
       "upload_time"
FROM (
      SELECT "name",
             "version",
             "upload_time",
             ROW_NUMBER() OVER (PARTITION BY "name"
                                ORDER BY "upload_time" DESC) AS rn
      FROM PYPI.PYPI.DISTRIBUTION_METADATA
     )
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: 8) Basic download counts per project
SELECT "project",
       COUNT(*) AS "download_cnt"
FROM PYPI.PYPI.FILE_DOWNLOADS
GROUP BY "project"
ORDER BY "download_cnt" DESC
LIMIT 20;
```

```sql
--Description: 9) Combine latest‑version metadata with download counts
WITH latest AS (
     SELECT *
     FROM (
          SELECT "name",
                 "version",
                 "upload_time",
                 ROW_NUMBER() OVER (PARTITION BY "name"
                                    ORDER BY "upload_time" DESC) AS rn
          FROM PYPI.PYPI.DISTRIBUTION_METADATA )
     WHERE rn = 1
)
SELECT l."name",
       l."version",
       d.download_cnt
FROM latest l
JOIN (
     SELECT "project",
            COUNT(*) AS download_cnt
     FROM PYPI.PYPI.FILE_DOWNLOADS
     GROUP BY "project"
) d
ON l."name" = d."project"
ORDER BY d.download_cnt DESC
LIMIT 20;
```

```sql
--Description: 10) Full query to retrieve cleaned GitHub repo URLs for the three most‑downloaded packages
WITH latest AS (
     SELECT *
     FROM (
          SELECT "name",
                 "upload_time",
                 ROW_NUMBER() OVER (PARTITION BY "name"
                                    ORDER BY "upload_time" DESC) AS rn
          FROM PYPI.PYPI.DISTRIBUTION_METADATA )
     WHERE rn = 1
),
github_urls AS (
     SELECT DISTINCT
            t."name",
            REGEXP_REPLACE(f.value::STRING,
                           '/(issues|pull|blob|tree).*',
                           '') AS "repo_url"
     FROM PYPI.PYPI.DISTRIBUTION_METADATA t,
          LATERAL FLATTEN(input => t."project_urls") f
     WHERE f.value::STRING ILIKE '%github.com/%'
),
downloads AS (
     SELECT "project",
            COUNT(*) AS download_cnt
     FROM PYPI.PYPI.FILE_DOWNLOADS
     GROUP BY "project"
)
SELECT g."repo_url"
FROM downloads d
JOIN latest   l ON d."project" = l."name"
JOIN github_urls g ON g."name"  = l."name"
ORDER BY d.download_cnt DESC
LIMIT 3;
```
