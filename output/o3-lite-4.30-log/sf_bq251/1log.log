```sql
--Description:
-- 9. Retrieve a 20‑row sample of cleaned GitHub URLs from the latest release
--    of every package.  Replaces the unsupported LEFT JOIN LATERAL syntax with
--    a comma join that uses LATERAL FLATTEN … OUTER => TRUE, which behaves like
--    a LEFT join.  The URL is cleaned by removing /issues, /pull*, /blob*,
--    /tree*, and any trailing slash, then converted to lower‑case.
SELECT
    LOWER(
        REGEXP_REPLACE(
            REGEXP_REPLACE(
                REGEXP_SUBSTR(COALESCE(pu.value::STRING, md."home_page"),
                               'https?://[^ ,]+'),
                '/(issues|pull[^/]*|blob[^/]*|tree[^/]*)(/.*)*$',
                ''
            ),
            '/+$', ''
        )
    ) AS "clean_repo_url"
FROM (
    SELECT *
    FROM (
        SELECT *,
               ROW_NUMBER() OVER (PARTITION BY "name"
                                  ORDER BY "upload_time" DESC) AS rn
        FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA"
    )
    WHERE rn = 1
) md,
LATERAL FLATTEN(input => md."project_urls", OUTER => TRUE) pu
WHERE COALESCE(pu.value::STRING, md."home_page") ILIKE '%github.com%'
LIMIT 20;
