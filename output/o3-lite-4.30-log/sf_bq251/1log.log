```sql
--Description:
-- Return the cleaned GitHub repository URLs for the three most‑downloaded PyPI
-- packages.  Thinking process encoded in comments:
--  1. FILE_DOWNLOADS: aggregate total download counts per project.
--  2. DISTRIBUTION_METADATA: keep only the most‑recent release for every package
--     (ROW_NUMBER() over upload_time DESC).
--  3. LATERAL FLATTEN (OUTER => TRUE) expands the “project_urls” array; packages
--     without that column survive because of OUTER => TRUE.
--  4. For each package take a URL candidate: flattened value first, otherwise
--     “home_page”.
--  5. Extract the real URL with REGEXP_SUBSTR (handles strings like
--     "Source, https://github.com/user/repo").
--  6. Keep rows whose URL points at GitHub.
--  7. Normalise to lower‑case and strip unwanted path suffixes such as
--     /issues, /pull…, /blob…, /tree…, plus trailing slashes.
--  8. Join to downloads, rank by download_count, and pick the top 3.
SELECT
       gh_top3."clean_repo_url"
FROM  (
        /* ----------  aggregate download counts  ---------- */
        SELECT   "project",
                 COUNT(*) AS download_count
        FROM     "PYPI"."PYPI"."FILE_DOWNLOADS"
        GROUP BY "project"
       ) dl
JOIN (
        /* ----------  extract & clean one GitHub URL per latest release  ---------- */
        SELECT
               md."name"                                                    AS package_name,
               LOWER(
                 REGEXP_REPLACE(
                   REGEXP_REPLACE(
                     REGEXP_SUBSTR(          -- step 5: pull the actual URL
                       COALESCE(pu.value::STRING, md."home_page"),
                       'https?://[^ ,]+'
                     ),
                     '/(issues|pull[^/]*|blob[^/]*|tree[^/]*)(/.*)*$',     -- step 7a: drop noise
                     ''
                   ),
                   '/+$', ''                                                -- step 7b: drop trailing '/'
                 )
               )                                                            AS clean_repo_url
        FROM  (
               /* latest distribution row per package */
               SELECT *
               FROM  (
                      SELECT *,
                             ROW_NUMBER() OVER (PARTITION BY "name"
                                                ORDER BY "upload_time" DESC) AS rn
                      FROM   "PYPI"."PYPI"."DISTRIBUTION_METADATA"
                     )
               WHERE  rn = 1
              ) md,
              LATERAL FLATTEN( input => md."project_urls", OUTER => TRUE ) pu
        WHERE  COALESCE(pu.value::STRING, md."home_page") ILIKE '%github.com%'
       ) gh
     ON dl."project" = gh.package_name
QUALIFY ROW_NUMBER() OVER (ORDER BY dl.download_count DESC) <= 3;  -- step 8: top 3
