Query:
--Description:
-- 10. Produce the cleaned GitHub repository URLs for the three most‑downloaded
--     PyPI projects.  Uses CTEs to: (a) aggregate download counts, (b) pick
--     the latest metadata per package, (c) pull a GitHub URL from project_urls
--     or fall back to home_page, (d) clean the URL, (e) rank by download_count.
WITH download_counts AS (                 -- total downloads per project
    SELECT "project",
           COUNT(*) AS download_count
    FROM   "PYPI"."PYPI"."FILE_DOWNLOADS"
    GROUP  BY "project"
),
latest_release AS (                       -- newest metadata row per package
    SELECT *
    FROM (
        SELECT *,
               ROW_NUMBER() OVER (PARTITION BY "name"
                                  ORDER BY "upload_time" DESC) AS rn
        FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA"
    )
    WHERE rn = 1
),
urls AS (                                 -- GitHub‑like URL from project_urls or home_page
    SELECT
        lr."name" AS package_name,
        COALESCE(pu.value::STRING, lr."home_page") AS raw_url
    FROM   latest_release lr,
           LATERAL FLATTEN(input => lr."project_urls", OUTER => TRUE) pu
    WHERE  COALESCE(pu.value::STRING, lr."home_page") ILIKE '%github.com%'
),
cleaned_urls AS (                         -- clean URL to repository root
    SELECT
        package_name,
        LOWER(
            REGEXP_REPLACE(
                REGEXP_REPLACE(
                    REGEXP_SUBSTR(raw_url, 'https?://[^ ,]+'),
                    '/(issues|pull[^/]*|blob[^/]*|tree[^/]*)(/.*)*$',
                    ''
                ),
                '/+$', ''
            )
        ) AS clean_repo_url
    FROM urls
),
ranked_urls AS (                          -- rank by download_count
    SELECT
        cu.clean_repo_url,
        ROW_NUMBER() OVER (ORDER BY dc.download_count DESC) AS rk
    FROM   cleaned_urls cu
    JOIN   download_counts dc
      ON   cu.package_name = dc."project"
)
SELECT clean_repo_url
FROM   ranked_urls
WHERE  rk <= 3
Answer:
CLEAN_REPO_URL
