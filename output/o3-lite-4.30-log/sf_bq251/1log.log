--Description:
-- Compute the three most‑downloaded PyPI projects and return their cleaned
-- GitHub repository URLs.
--  • download_counts  – total FILE_DOWNLOADS rows per project.
--  • latest_release   – newest DISTRIBUTION_METADATA row for each package.
--  • urls             – expand latest_release.project_urls with LATERAL FLATTEN
--                       (OUTER => TRUE keeps rows that lack project_urls);
--                       fall back to home_page; keep only github links.
--  • cleaned_urls     – extract the first URL, lowercase it, drop “/issues”,
--                       “/pull*”, “/blob*”, “/tree*”, and trailing “/”.
--  • ranked_urls      – join to download_counts, rank by download_count, and
--                       keep rows with rk ≤ 3.
WITH download_counts AS (
    SELECT "project",
           COUNT(*) AS download_count
    FROM   "PYPI"."PYPI"."FILE_DOWNLOADS"
    GROUP  BY "project"
),
latest_release AS (
    SELECT *
    FROM (
        SELECT *,
               ROW_NUMBER() OVER (PARTITION BY "name"
                                  ORDER BY "upload_time" DESC) AS rn
        FROM   "PYPI"."PYPI"."DISTRIBUTION_METADATA"
    )
    WHERE rn = 1
),
urls AS (
    SELECT
        lr."name" AS package_name,
        COALESCE(pu.value::STRING, lr."home_page") AS raw_url
    FROM   latest_release lr,
           LATERAL FLATTEN(input => lr."project_urls", OUTER => TRUE) pu
    WHERE  COALESCE(pu.value::STRING, lr."home_page") ILIKE '%github.com%'
),
cleaned_urls AS (
    SELECT
        package_name,
        LOWER(
            REGEXP_REPLACE(                                      -- strip noisy segments
                REGEXP_REPLACE(
                    REGEXP_SUBSTR(raw_url, 'https?://[^ ,]+'),   -- extract URL
                    '/(issues|pull[^/]*|blob[^/]*|tree[^/]*)(/.*)*$',
                    ''
                ),
                '/+$', ''                                        -- remove trailing slash
            )
        ) AS clean_repo_url
    FROM urls
),
ranked_urls AS (
    SELECT
        cu.clean_repo_url,
        dc.download_count,
        ROW_NUMBER() OVER (ORDER BY dc.download_count DESC) AS rk
    FROM   cleaned_urls cu
    JOIN   download_counts dc
      ON   cu.package_name = dc."project"
)
SELECT clean_repo_url
FROM   ranked_urls
WHERE  rk <= 3;
