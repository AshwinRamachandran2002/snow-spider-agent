```sql
--Description:
-- Find the cleaned GitHub repository URLs for the three most‑downloaded PyPI
-- projects.  Steps woven into CTEs:
--   1) download_counts  – aggregate total downloads per "project".
--   2) latest_release   – pick the most‑recent metadata row for every package.
--   3) urls             – expand project_urls via LATERAL FLATTEN (OUTER => TRUE)
--                         and fall back to home_page; keep only GitHub links.
--   4) cleaned_urls     – extract the URL string, make lowercase, remove
--                         trailing /issues, /pull*, /blob*, /tree*, and any
--                         trailing slash.
--   5) Final SELECT     – join cleaned_urls to download_counts, order by
--                         download_count, and return the top 3 repo URLs.
WITH download_counts AS (
    SELECT "project",
           COUNT(*) AS download_count
    FROM   "PYPI"."PYPI"."FILE_DOWNLOADS"
    GROUP  BY "project"
),
latest_release AS (
    SELECT *
    FROM (
        SELECT *,
               ROW_NUMBER() OVER (PARTITION BY "name"
                                  ORDER BY "upload_time" DESC) AS rn
        FROM   "PYPI"."PYPI"."DISTRIBUTION_METADATA"
    )
    WHERE rn = 1
),
urls AS (
    SELECT
        lr."name" AS package_name,
        COALESCE(pu.value::STRING, lr."home_page") AS raw_url
    FROM   latest_release lr,
           LATERAL FLATTEN(input => lr."project_urls", OUTER => TRUE) pu
    WHERE  COALESCE(pu.value::STRING, lr."home_page") ILIKE '%github.com%'
),
cleaned_urls AS (
    SELECT
        package_name,
        LOWER(
            REGEXP_REPLACE(
                REGEXP_REPLACE(
                    REGEXP_SUBSTR(raw_url, 'https?://[^ ,]+'),
                    '/(issues|pull[^/]*|blob[^/]*|tree[^/]*)(/.*)*$', ''
                ),
                '/+$', ''
            )
        ) AS clean_repo_url
    FROM urls
)
SELECT DISTINCT
       cu.clean_repo_url
FROM   cleaned_urls cu
JOIN   download_counts dc
  ON   cu.package_name = dc."project"
ORDER  BY dc.download_count DESC
LIMIT 3;
```
