--Description: Corrected version of query 10 – returns cleaned GitHub repo URLs for the
--             three most‑downloaded PyPI projects.  Alias and identifier casing are
--             consistent (CLEANED_URL, download_count).
WITH latest AS (  -- newest metadata row per package
    SELECT *
    FROM (
        SELECT *,
               ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
        FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA"
    )
    WHERE rn = 1
),
dl AS (            -- total download events per project
    SELECT "project", COUNT(*) AS download_count
    FROM "PYPI"."PYPI"."FILE_DOWNLOADS"
    GROUP BY "project"
),
urls AS (          -- clean GitHub URLs from metadata
    -- from project_urls
    SELECT l."name",
           REGEXP_REPLACE(
               f.value::STRING,
               '^(https?://github\\.com/[^/]+/[^/#?]+).*',
               '\\1'
           ) AS CLEANED_URL
    FROM latest l,
         LATERAL FLATTEN(input => l."project_urls") f
    WHERE f.value::STRING ILIKE '%github.com%'

    UNION ALL
    -- from home_page
    SELECT l."name",
           REGEXP_REPLACE(
               l."home_page",
               '^(https?://github\\.com/[^/]+/[^/#?]+).*',
               '\\1'
           ) AS CLEANED_URL
    FROM latest l
    WHERE l."home_page" ILIKE '%github.com%'
),
combined AS (      -- join with downloads and deduplicate identical repos
    SELECT
        d.download_count,
        u.CLEANED_URL,
        ROW_NUMBER() OVER (PARTITION BY u.CLEANED_URL
                           ORDER BY d.download_count DESC) AS url_rank
    FROM urls u
    JOIN dl d
      ON u."name" = d."project"
)
SELECT CLEANED_URL
FROM combined
WHERE url_rank = 1   -- one row per unique repository
ORDER BY download_count DESC
LIMIT 3
