```sql
--Description: Preview a de‑duplicated sample of GitHub repository links found in PyPI
--             package metadata.  Strategy:
--   1. GitHub URLs can appear either inside the VARIANT column "project_urls"
--      or directly in the plain‑text column "home_page".
--   2. Since Snowflake does not allow OUTER JOIN with a table function,
--      handle each source in its own SELECT and UNION ALL them.
--   3. Apply ILIKE '%github.com%' in both branches to keep only GitHub links,
--      then SELECT DISTINCT to remove duplicates.
--   4. LIMIT 20 for a quick look.
SELECT DISTINCT raw_url
FROM (
        -- GitHub links located in project_urls
        SELECT f.value::STRING AS raw_url
        FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA" t,
             LATERAL FLATTEN(input => t."project_urls") f
        WHERE f.value::STRING ILIKE '%github.com%'

        UNION ALL

        -- GitHub links located in home_page
        SELECT t."home_page" AS raw_url
        FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA" t
        WHERE t."home_page" ILIKE '%github.com%'
) combined
LIMIT 20;
```
