```sql
--Description: Final step – obtain the three most‑downloaded PyPI projects that have
--             valid GitHub repository links and return only the cleaned repo URLs.
-- Thinking process:
--   1. latest  : pick the newest metadata row for every package.
--   2. dl      : aggregate total file‑download events per project.
--   3. urls    : extract GitHub links from both project_urls (using FLATTEN) and
--                home_page, cleaning each down to ‘https://github.com/user/repo’.
--   4. combined: join urls with dl, de‑duplicate identical repositories via
--                ROW_NUMBER() and order by download_count.
--   5. Select the top 3 repositories and output only the cleaned_url column.
WITH latest AS (
    SELECT *
    FROM (
        SELECT *,
               ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
        FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA"
    )
    WHERE rn = 1
),
dl AS (
    SELECT "project", COUNT(*) AS download_count
    FROM "PYPI"."PYPI"."FILE_DOWNLOADS"
    GROUP BY "project"
),
urls AS (
    -- GitHub URLs in project_urls
    SELECT l."name",
           REGEXP_REPLACE(
               f.value::STRING,
               '^(https?://github\\.com/[^/]+/[^/#?]+).*',
               '\\1'
           ) AS CLEANED_URL
    FROM latest l,
         LATERAL FLATTEN(input => l."project_urls") f
    WHERE f.value::STRING ILIKE '%github.com%'

    UNION ALL

    -- GitHub URLs in home_page
    SELECT l."name",
           REGEXP_REPLACE(
               l."home_page",
               '^(https?://github\\.com/[^/]+/[^/#?]+).*',
               '\\1'
           ) AS CLEANED_URL
    FROM latest l
    WHERE l."home_page" ILIKE '%github.com%'
),
combined AS (
    SELECT
        d.download_count,
        u.CLEANED_URL,
        ROW_NUMBER() OVER (PARTITION BY u.CLEANED_URL
                           ORDER BY d.download_count DESC) AS url_rank
    FROM urls u
    JOIN dl d
      ON u."name" = d."project"
)
SELECT CLEANED_URL
FROM combined
WHERE url_rank = 1          -- one row per unique repository
ORDER BY download_count DESC
LIMIT 3;
```
