Relevant columns and their potential usage
• DISTRIBUTION_METADATA."name": package name – join key with FILE_DOWNLOADS."project".  
• DISTRIBUTION_METADATA."version": specific release – choose latest per package.  
• DISTRIBUTION_METADATA."upload_time": numeric timestamp – to decide “most‑recent version”.  
• DISTRIBUTION_METADATA."project_urls": VARIANT holding many labelled URLs (Docs, Source, Bug Tracker, …).  
• DISTRIBUTION_METADATA."home_page": single URL that often mirrors “Source”.  
• FILE_DOWNLOADS."project": package name in each download record – used to aggregate download counts.  
• FILE_DOWNLOADS."timestamp": download event time – not required for counting but useful for recency filters.  

Typical filter conditions you will need  
• ILIKE '%github.com%' on URL columns to keep GitHub links only.  
• REGEXP_REPLACE(<url>, '.*/github.com/([^/]+/[^/#?]+).*', 'https://github.com/\\1') to trim *issues*, *pull*, *blob*, *tree* etc.  
• QUALIFY ROW_NUMBER() … OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) = 1 to keep newest metadata row per package.  

Example Snowflake SQL exploration queries  
```sql
--Description: 1) Peek at a handful of packages in the metadata table.
SELECT DISTINCT "name"
FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA"
LIMIT 20;
```

```sql
--Description: 2) Look at raw project_urls JSON for a few rows.
SELECT "name", "project_urls"
FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA"
WHERE "project_urls" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 3) Flatten the project_urls object into key/value pairs.
SELECT 
    t."name",
    f.key   AS "url_label",
    f.value AS "url_value"
FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA" t,
     LATERAL FLATTEN(input => t."project_urls") f
LIMIT 20;
```

```sql
--Description: 4) Preview GitHub URLs only, coming from either project_urls or home_page.
SELECT DISTINCT
       COALESCE(f.value::STRING, t."home_page") AS "raw_url"
FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA" t
LEFT JOIN LATERAL FLATTEN(input => t."project_urls") f ON TRUE
WHERE (f.value IS NOT NULL OR t."home_page" IS NOT NULL)
  AND COALESCE(f.value::STRING, t."home_page") ILIKE '%github.com%'
LIMIT 20;
```

```sql
--Description: 5) Keep only the most‑recent metadata row per package.
SELECT *
FROM (
      SELECT *,
             ROW_NUMBER() OVER (PARTITION BY "name"
                                ORDER BY "upload_time" DESC) AS rn
      FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA"
) 
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: 6) Aggregate download counts per project in FILE_DOWNLOADS.
SELECT "project",
       COUNT(*) AS "download_count"
FROM "PYPI"."PYPI"."FILE_DOWNLOADS"
GROUP BY "project"
ORDER BY "download_count" DESC
LIMIT 20;
```

```sql
--Description: 7) Join newest metadata with download counts to see which popular projects expose GitHub URLs.
WITH latest AS (
     SELECT *
     FROM (
           SELECT *,
                  ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
           FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA"
     ) WHERE rn = 1
),
dl AS (
     SELECT "project", COUNT(*) AS "download_count"
     FROM "PYPI"."PYPI"."FILE_DOWNLOADS"
     GROUP BY "project"
)
SELECT l."name",
       dl."download_count",
       l."project_urls",
       l."home_page"
FROM latest l
JOIN dl
  ON l."name" = dl."project"
ORDER BY dl."download_count" DESC
LIMIT 20;
```

```sql
--Description: 8) Extract and clean GitHub URLs for newest versions only.
WITH latest AS (
     SELECT *
     FROM (
           SELECT *,
                  ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
           FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA"
     ) WHERE rn = 1
),
urls AS (
     SELECT l."name",
            COALESCE(f.value::STRING, l."home_page")                       AS raw_url
     FROM latest l
     LEFT JOIN LATERAL FLATTEN(input => l."project_urls") f ON TRUE
     WHERE COALESCE(f.value::STRING, l."home_page") ILIKE '%github.com%'
)
SELECT DISTINCT
       REGEXP_REPLACE(raw_url,
                      '^(https?://github\\.com/[^/]+/[^/#?]+).*',
                      '\\1') AS cleaned_url
FROM urls
LIMIT 20;
```

```sql
--Description: 9) Retrieve download counts side‑by‑side with cleaned GitHub URLs.
WITH latest AS (
     SELECT *
     FROM (
           SELECT *,
                  ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
           FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA"
     ) WHERE rn = 1
),
dl AS (
     SELECT "project", COUNT(*) AS "download_count"
     FROM "PYPI"."PYPI"."FILE_DOWNLOADS"
     GROUP BY "project"
),
urls AS (
     SELECT l."name",
            REGEXP_REPLACE(
                COALESCE(f.value::STRING, l."home_page"),
                '^(https?://github\\.com/[^/]+/[^/#?]+).*',
                '\\1'
            ) AS cleaned_url
     FROM latest l
     LEFT JOIN LATERAL FLATTEN(input => l."project_urls") f ON TRUE
     WHERE COALESCE(f.value::STRING, l."home_page") ILIKE '%github.com%'
)
SELECT u."cleaned_url",
       d."download_count"
FROM urls u
JOIN dl  d ON u."name" = d."project"
ORDER BY d."download_count" DESC
LIMIT 20;
```

```sql
--Description: 10) Final query candidate – top 3 most‑downloaded projects with valid GitHub repo URLs (ready for the final answer step).
WITH latest AS (
     SELECT *
     FROM (
           SELECT *,
                  ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
           FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA"
     ) WHERE rn = 1
),
dl AS (
     SELECT "project", COUNT(*) AS "download_count"
     FROM "PYPI"."PYPI"."FILE_DOWNLOADS"
     GROUP BY "project"
),
urls AS (
     SELECT l."name",
            REGEXP_REPLACE(
                COALESCE(f.value::STRING, l."home_page"),
                '^(https?://github\\.com/[^/]+/[^/#?]+).*',
                '\\1'
            ) AS cleaned_url
     FROM latest l
     LEFT JOIN LATERAL FLATTEN(input => l."project_urls") f ON TRUE
     WHERE COALESCE(f.value::STRING, l."home_page") ILIKE '%github.com%'
),
combined AS (
     SELECT d."download_count",
            u."cleaned_url",
            ROW_NUMBER() OVER (PARTITION BY u."cleaned_url"
                               ORDER BY d."download_count" DESC) AS rank_per_url
     FROM urls u
     JOIN dl d ON u."name" = d."project"
)
SELECT "cleaned_url"
FROM combined
WHERE rank_per_url = 1           -- avoid double‑counting a repo when multiple URLs mapped
ORDER BY "download_count" DESC
LIMIT 3;
```
