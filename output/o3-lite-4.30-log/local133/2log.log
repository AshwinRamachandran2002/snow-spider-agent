2025-05-01 03:24:57 - Thread-1404 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
Musical_Preferences.StyleID : style to aggregate on  
Musical_Preferences.PreferenceSeq : ranking (1‑first, 2‑second, 3‑third) – used to assign weights (3, 2, 1)  
Musical_Preferences.CustomerID : not strictly needed, but shows how many customers voted for each style  
Musical_Styles.StyleID : join key to get the descriptive name of a style  
Musical_Styles.StyleName : the readable name to include in any report  

Typical filter / join conditions  
• Musical_Preferences.PreferenceSeq IN (1,2,3) – only the three valid ranks  
• Musical_Preferences.StyleID = Musical_Styles.StyleID – to obtain the style name  

Below are ten exploratory → final queries (each different, limited to 20 rows).  
All column / table names are enclosed in double quotes to stay portable.

```sql
-- 1. Distinct preference ranks that actually appear
SELECT DISTINCT "PreferenceSeq"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
-- 2. Distinct style IDs that have at least one preference entry
SELECT DISTINCT "StyleID"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
-- 3. See how many votes of any rank each style received
SELECT "StyleID",
       COUNT(*) AS "total_votes"
FROM   "Musical_Preferences"
GROUP  BY "StyleID"
ORDER  BY "total_votes" DESC
LIMIT 20;
```

```sql
-- 4. Same as above but show the style’s name
SELECT ms."StyleID",
       ms."StyleName",
       COUNT(*) AS "total_votes"
FROM   "Musical_Preferences"  AS mp
JOIN   "Musical_Styles"       AS ms
       ON ms."StyleID" = mp."StyleID"
GROUP  BY ms."StyleID", ms."StyleName"
ORDER  BY "total_votes" DESC
LIMIT 20;
```

```sql
-- 5. Count how many times each style was ranked 1st, 2nd, 3rd
SELECT "StyleID",
       SUM(CASE WHEN "PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "firsts",
       SUM(CASE WHEN "PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "seconds",
       SUM(CASE WHEN "PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "thirds"
FROM   "Musical_Preferences"
GROUP  BY "StyleID"
LIMIT 20;
```

```sql
-- 6. Weighted score for each style (3‑2‑1 method)
SELECT "StyleID",
       SUM(CASE 
             WHEN "PreferenceSeq" = 1 THEN 3
             WHEN "PreferenceSeq" = 2 THEN 2
             WHEN "PreferenceSeq" = 3 THEN 1
           END) AS "weighted_score"
FROM   "Musical_Preferences"
GROUP  BY "StyleID"
ORDER  BY "weighted_score" DESC
LIMIT 20;
```

```sql
-- 7. Add style names to the weighted scores
SELECT ms."StyleID",
       ms."StyleName",
       SUM(CASE 
             WHEN mp."PreferenceSeq" = 1 THEN 3
             WHEN mp."PreferenceSeq" = 2 THEN 2
             WHEN mp."PreferenceSeq" = 3 THEN 1
           END) AS "weighted_score"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms
       ON ms."StyleID" = mp."StyleID"
GROUP  BY ms."StyleID", ms."StyleName"
ORDER  BY "weighted_score" DESC
LIMIT 20;
```

```sql
-- 8. Calculate the average of those weighted scores (one row result)
WITH scores AS (
  SELECT "StyleID",
         SUM(CASE 
               WHEN "PreferenceSeq" = 1 THEN 3
               WHEN "PreferenceSeq" = 2 THEN 2
               WHEN "PreferenceSeq" = 3 THEN 1
             END) AS "score"
  FROM   "Musical_Preferences"
  GROUP  BY "StyleID"
)
SELECT AVG("score") AS "avg_weighted_score"
FROM   scores
LIMIT 20;
```

```sql
-- 9. Combine each style’s score with the overall average,
--    then show the absolute difference
WITH scores AS (
  SELECT "StyleID",
         SUM(CASE 
               WHEN "PreferenceSeq" = 1 THEN 3
               WHEN "PreferenceSeq" = 2 THEN 2
               WHEN "PreferenceSeq" = 3 THEN 1
             END) AS "score"
  FROM   "Musical_Preferences"
  GROUP  BY "StyleID"
),
avg_val AS (
  SELECT AVG("score") AS "avg_score" FROM scores
)
SELECT s."StyleID",
       s."score"                               AS "weighted_score",
       ABS(s."score" - a."avg_score")          AS "abs_diff_from_avg"
FROM   scores  AS s
CROSS  JOIN avg_val AS a
ORDER  BY "abs_diff_from_avg" DESC
LIMIT 20;
```

```sql
-- 10. FINAL REPORT:
--     style ID, name, weighted score, absolute difference from average
WITH scores AS (
  SELECT mp."StyleID",
         SUM(CASE 
               WHEN mp."PreferenceSeq" = 1 THEN 3
               WHEN mp."PreferenceSeq" = 2 THEN 2
               WHEN mp."PreferenceSeq" = 3 THEN 1
             END) AS "score"
  FROM   "Musical_Preferences" AS mp
  GROUP  BY mp."StyleID"
),
avg_val AS (
  SELECT AVG("score") AS "avg_score" FROM scores
)
SELECT ms."StyleID",
       ms."StyleName",
       s."score"                                 AS "weighted_score",
       ABS(s."score" - a."avg_score")            AS "abs_diff_from_avg"
FROM   scores          AS s
JOIN   "Musical_Styles" AS ms ON ms."StyleID" = s."StyleID"
CROSS  JOIN avg_val    AS a
ORDER  BY "abs_diff_from_avg" DESC
LIMIT 20;
```

The final query (10) gives, for every musical style that has at least one ranking, its total weighted score and how far that score sits from the average of all styles’ weighted scores.
