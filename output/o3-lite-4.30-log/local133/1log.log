Relevant tables & columns for the task  
• Musical_Preferences.StyleID : matches a musical style that somebody ranked.  
• Musical_Preferences.PreferenceSeq : tells whether the rank is 1st, 2nd or 3rd → drives the weighting rule (3 / 2 / 1 points).  
• Musical_Preferences.CustomerID : lets us know how many different customers voted; useful when we count rows.  
• Musical_Styles.StyleID : joins to Musical_Preferences so we can attach the human‑readable style name.  
• Musical_Styles.StyleName : final display column.  

Typical conditions we will use  
• Musical_Preferences.PreferenceSeq IN (1,2,3) – make sure we only score the three ranks we know about.  
• JOIN Musical_Styles USING (StyleID) – get the style name for reporting.  

Below are ten exploratory‑to‑final SQLite queries (each limited to 20 rows where a LIMIT clause makes sense).  
Every table/column that could need quoting is wrapped in double quotes.

```sql
-- 1. Peek at the raw rankings table
SELECT *
FROM "Musical_Preferences"
LIMIT 20;

-- 2. What PreferenceSeq values are actually present?
SELECT DISTINCT "PreferenceSeq"
FROM "Musical_Preferences"
LIMIT 20;

-- 3. All StyleID values that have been ranked at least once
SELECT DISTINCT "StyleID"
FROM "Musical_Preferences"
WHERE "PreferenceSeq" IN (1,2,3)
LIMIT 20;

-- 4. Show the readable names for those StyleIDs
SELECT DISTINCT ms."StyleID", ms."StyleName"
FROM "Musical_Styles" AS ms
JOIN "Musical_Preferences" AS mp USING ("StyleID")
WHERE mp."PreferenceSeq" IN (1,2,3)
LIMIT 20;

-- 5. Count of first‑choice rankings per style
SELECT "StyleID",
       COUNT(*) AS "first_choice_cnt"
FROM "Musical_Preferences"
WHERE "PreferenceSeq" = 1
GROUP BY "StyleID"
LIMIT 20;

-- 6. Weighted points contributed by each (StyleID, PreferenceSeq) pair
SELECT "StyleID",
       SUM(CASE "PreferenceSeq"
               WHEN 1 THEN 3
               WHEN 2 THEN 2
               WHEN 3 THEN 1
           END) AS "points"
FROM "Musical_Preferences"
WHERE "PreferenceSeq" IN (1,2,3)
GROUP BY "StyleID"
LIMIT 20;

-- 7. Weighted score with the style’s name attached
SELECT ms."StyleName",
       s."points"
FROM (
     SELECT "StyleID",
            SUM(CASE "PreferenceSeq"
                    WHEN 1 THEN 3
                    WHEN 2 THEN 2
                    WHEN 3 THEN 1
                END) AS "points"
     FROM "Musical_Preferences"
     WHERE "PreferenceSeq" IN (1,2,3)
     GROUP BY "StyleID"
) AS s
JOIN "Musical_Styles" AS ms USING ("StyleID")
ORDER BY s."points" DESC
LIMIT 20;

-- 8. Average weighted score across all ranked styles
WITH scores AS (
     SELECT "StyleID",
            SUM(CASE "PreferenceSeq"
                    WHEN 1 THEN 3
                    WHEN 2 THEN 2
                    WHEN 3 THEN 1
                END) AS "points"
     FROM "Musical_Preferences"
     WHERE "PreferenceSeq" IN (1,2,3)
     GROUP BY "StyleID"
)
SELECT AVG("points") AS "avg_points"
FROM scores;

-- 9. Final report: score, average, absolute difference
WITH scores AS (
     SELECT "StyleID",
            SUM(CASE "PreferenceSeq"
                    WHEN 1 THEN 3
                    WHEN 2 THEN 2
                    WHEN 3 THEN 1
                END) AS "points"
     FROM "Musical_Preferences"
     WHERE "PreferenceSeq" IN (1,2,3)
     GROUP BY "StyleID"
),
avg_val AS (
     SELECT AVG("points") AS "avg_points"
     FROM scores
)
SELECT ms."StyleName",
       s."points"                       AS "total_weighted_score",
       a."avg_points",
       ABS(s."points" - a."avg_points") AS "abs_diff_from_avg"
FROM scores AS s
CROSS JOIN avg_val AS a
JOIN "Musical_Styles" AS ms USING ("StyleID")
ORDER BY "abs_diff_from_avg" DESC
LIMIT 20;

-- 10. Same as #9 but showing every style that has been ranked (no LIMIT)
WITH scores AS (
     SELECT "StyleID",
            SUM(CASE "PreferenceSeq"
                    WHEN 1 THEN 3
                    WHEN 2 THEN 2
                    WHEN 3 THEN 1
                END) AS "points"
     FROM "Musical_Preferences"
     WHERE "PreferenceSeq" IN (1,2,3)
     GROUP BY "StyleID"
),
avg_val AS (
     SELECT AVG("points") AS "avg_points"
     FROM scores
)
SELECT ms."StyleName",
       s."points"                       AS "total_weighted_score",
       a."avg_points",
       ABS(s."points" - a."avg_points") AS "abs_diff_from_avg"
FROM scores AS s
CROSS JOIN avg_val AS a
JOIN "Musical_Styles" AS ms USING ("StyleID")
ORDER BY ms."StyleName";
```

