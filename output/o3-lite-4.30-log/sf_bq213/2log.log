Query:
--Description: 10) Final aggregation to reveal the single most common 4‑digit IPC code
SELECT 
  SUBSTR(ipc_item.value:"code"::STRING, 1, 4) AS "most_common_ipc4",
  COUNT(*) AS "publications_with_ipc4"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."ipc") ipc_item
WHERE p."country_code" = 'US'
  AND p."kind_code" = 'B2'
  AND p."application_kind" = 'A'
  AND p."grant_date" BETWEEN 20220601 AND 20220831
GROUP BY "most_common_ipc4"
ORDER BY "publications_with_ipc4" DESC
LIMIT 20;
