Query:
--Description: 8) Same as #7 but keeping only the main IPCs (when field "first" = TRUE, if present)
SELECT 
  SUBSTR(ipc_item.value:"code"::STRING, 1, 4) AS "ipc4",
  COUNT(*) AS "n_pub"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."ipc") ipc_item
WHERE p."country_code" = 'US'
  AND p."kind_code" = 'B2'
  AND p."application_kind" = 'A'
  AND p."grant_date" BETWEEN 20220601 AND 20220831
  AND COALESCE(ipc_item.value:"first"::BOOLEAN, FALSE) = TRUE
GROUP BY "ipc4"
ORDER BY "n_pub" DESC
LIMIT 20;
