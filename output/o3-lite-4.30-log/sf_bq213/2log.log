Query:
--Description: 9) Show which publication numbers contribute to the single most frequent 4‑digit IPC
WITH top_ipc AS (
  SELECT 
    SUBSTR(ipc_item.value:"code"::STRING, 1, 4) AS ipc4,
    COUNT(*) AS n_pub
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."ipc") ipc_item
  WHERE p."country_code" = 'US'
    AND p."kind_code" = 'B2'
    AND p."application_kind" = 'A'
    AND p."grant_date" BETWEEN 20220601 AND 20220831
  GROUP BY ipc4
  ORDER BY n_pub DESC
  LIMIT 1
)
SELECT 
  p."publication_number",
  SUBSTR(ipc_item.value:"code"::STRING, 1, 4) AS "top_ipc4"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."ipc") ipc_item,
     top_ipc
WHERE p."country_code" = 'US'
  AND p."kind_code" = 'B2'
  AND p."application_kind" = 'A'
  AND p."grant_date" BETWEEN 20220601 AND 20220831
  AND SUBSTR(ipc_item.value:"code"::STRING, 1, 4) = top_ipc.ipc4
LIMIT 20;
