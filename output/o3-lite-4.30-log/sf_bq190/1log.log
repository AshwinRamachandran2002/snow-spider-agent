LIMIT 20;
```

```sql
-- 5) Minimum and maximum ages for all users in the date window (no gender split yet)
SELECT MIN("age") AS "youngest_age",
       MAX("age") AS "oldest_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
LIMIT 20;
```

```sql
-- 6) Minimum and maximum ages broken out by gender
SELECT "gender",
       MIN("age") AS "youngest_age",
       MAX("age") AS "oldest_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
GROUP BY "gender"
LIMIT 20;
```

```sql
-- 7) Identify each gender’s youngest age and the users who have that age
SELECT u."gender",
       u."age"  AS "youngest_age",
       COUNT(*) AS "user_cnt_with_youngest_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS u
JOIN (  SELECT "gender", MIN("age") AS "youngest_age"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
        WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
        GROUP BY "gender"
     ) y
  ON u."gender" = y."gender"
 AND u."age"    = y."youngest_age"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363199000000
GROUP BY u."gender", u."age"
LIMIT 20;
```

```sql
-- 8) Identify each gender’s oldest age and the users who have that age
SELECT u."gender",
       u."age"  AS "oldest_age",
       COUNT(*) AS "user_cnt_with_oldest_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS u
JOIN (  SELECT "gender", MAX("age") AS "oldest_age"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
        WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
        GROUP BY "gender"
     ) o
  ON u."gender" = o."gender"
 AND u."age"    = o."oldest_age"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363199000000
GROUP BY u."gender", u."age"
LIMIT 20;
```

```sql
-- 9) Combined youngest & oldest counts per gender using UNION ALL
SELECT 'youngest'                 AS "age_group",
       u."gender",
       COUNT(*)                   AS "user_count",
       u."age"                    AS "age_value"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS u
JOIN (SELECT "gender", MIN("age") AS "age_value"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
      WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
      GROUP BY "gender") s
  ON u."gender" = s."gender"
 AND u."age"    = s."age_value"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363199000000
GROUP BY u."gender", u."age"
UNION ALL
SELECT 'oldest'                  AS "age_group",
       u."gender",
       COUNT(*)                  AS "user_count",
       u."age"                   AS "age_value"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS u
JOIN (SELECT "gender", MAX("age") AS "age_value"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
      WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
      GROUP BY "gender") s
  ON u."gender" = s."gender"
 AND u."age"    = s."age_value"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363199000000
GROUP BY u."gender", u."age"
LIMIT 20;
```

```sql
-- 10) Final concise summary: youngest & oldest user counts per gender (ready for answer)
SELECT CASE WHEN u."age" = s."youngest_age" THEN 'youngest'
            WHEN u."age" = s."oldest_age"  THEN 'oldest'
       END                         AS "age_group",
       u."gender",
       COUNT(*)                    AS "user_count",
       u."age"                     AS "age_value"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS u
JOIN ( SELECT "gender",
              MIN("age") AS "youngest_age",
              MAX("age") AS "oldest_age"
       FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
       WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
       GROUP BY "gender"
     ) s
  ON u."gender" = s."gender"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363199000000
  AND (u."age" = s."youngest_age" OR u."age" = s."oldest_age")
GROUP BY u."gender", u."age", "age_group"
LIMIT 20;
```

