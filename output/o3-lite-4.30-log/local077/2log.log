--Description: Retrieve each month’s top interest (Sep‑2018‑Aug‑2019) alongside the
--top interests & values from one and two months earlier.
WITH monthly AS (
  SELECT month_year,
         interest_id,
         ROUND(composition / index_value, 4) AS avg_comp
  FROM interest_metrics
  WHERE (_year * 100 + _month) BETWEEN 201809 AND 201908
