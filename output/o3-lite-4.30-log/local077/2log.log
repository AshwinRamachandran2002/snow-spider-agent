Begin Exploring Related Columns
Relevant tables and columns for the task  

interest_metrics  
• month_year : month label we will group by (e.g. ‘09‑2018’)  
• _month / _year : alternative month & year parts for filtering (we will still keep month_year for ease)  
• interest_id : joins to interest_map.id so we can retrieve the human‑readable interest name  
• composition : numerator for “average composition” calculation  
• index_value : denominator for “average composition” (division needed)  

interest_map  
• id : joins to interest_metrics.interest_id  
• interest_name : readable name to show in the results  

Key conditions we’ll apply  
• month_year between ‘09‑2018’ and ‘08‑2019’  
• index_value <> 0 to avoid division by zero  
• interest_metrics.interest_id = interest_map.id for the join  

Below are 10 exploratory → final SQL queries (each limited to 20 rows) that progressively build toward the required answer.

```sql
-- 1. List all month_year values inside our date window
SELECT DISTINCT month_year
FROM interest_metrics
WHERE month_year >= '09-2018'
  AND month_year <= '08-2019'
LIMIT 20;
```

```sql
-- 2. What distinct interest_id’s appear in that same window?
SELECT DISTINCT interest_id
FROM interest_metrics
WHERE month_year >= '09-2018'
  AND month_year <= '08-2019'
LIMIT 20;
```

```sql
-- 3. Join to get the first 20 interest names for sanity checking
SELECT DISTINCT im.interest_id,
       mp.interest_name
FROM interest_metrics AS im
JOIN interest_map   AS mp
  ON im.interest_id = mp.id
WHERE im.month_year >= '09-2018'
  AND im.month_year <= '08-2019'
LIMIT 20;
```

```sql
-- 4. Compute the average‑composition (composition / index_value) for a single month (Sep‑2018)
SELECT im.month_year,
       im.interest_id,
       ROUND(im.composition / im.index_value, 4) AS avg_composition
FROM interest_metrics AS im
WHERE im.month_year = '09-2018'
  AND im.index_value <> 0
LIMIT 20;
```

```sql
-- 5. Average‑composition of every interest for every month inside the window
SELECT im.month_year,
       im.interest_id,
       ROUND(im.composition / im.index_value, 4) AS avg_comp
FROM interest_metrics AS im
WHERE im.month_year >= '09-2018'
  AND im.month_year <= '08-2019'
  AND im.index_value <> 0
LIMIT 20;
```

```sql
-- 6. Highest avg_composition per month (numeric id only for now)
WITH monthly AS (
  SELECT month_year,
         interest_id,
         ROUND(composition / index_value, 4) AS avg_comp
  FROM interest_metrics
  WHERE month_year >= '09-2018'
    AND month_year <= '08-2019'
    AND index_value <> 0
)
SELECT month_year,
       interest_id,
       avg_comp AS max_index_composition
FROM (
  SELECT m.*,
         ROW_NUMBER() OVER (PARTITION BY month_year
                            ORDER BY avg_comp DESC) AS rn
  FROM monthly AS m
)
WHERE rn = 1
LIMIT 20;
```

```sql
-- 7. Same as #6 but attach the interest name
WITH monthly AS (
  SELECT month_year,
         interest_id,
         ROUND(composition / index_value, 4) AS avg_comp
  FROM interest_metrics
  WHERE month_year >= '09-2018'
    AND month_year <= '08-2019'
    AND index_value <> 0
),
tops AS (
  SELECT month_year,
         interest_id,
         avg_comp,
         ROW_NUMBER() OVER (PARTITION BY month_year
                            ORDER BY avg_comp DESC) AS rn
  FROM monthly
)
SELECT t.month_year,
       mp.interest_name,
       t.avg_comp AS max_index_composition
FROM tops AS t
JOIN interest_map AS mp
  ON t.interest_id = mp.id
WHERE t.rn = 1
LIMIT 20;
```

```sql
-- 8. Add previous month’s and two‑months‑ago top interests + their values
WITH monthly AS (
  SELECT month_year,
         interest_id,
         ROUND(composition / index_value, 4) AS avg_comp
  FROM interest_metrics
  WHERE month_year >= '09-2018'
    AND month_year <= '08-2019'
    AND index_value <> 0
),
tops AS (
  SELECT month_year,
         interest_id,
         avg_comp,
         ROW_NUMBER() OVER (PARTITION BY month_year
                            ORDER BY avg_comp DESC) AS rn
  FROM monthly
),
best AS (
  SELECT month_year,
         interest_id,
         avg_comp
  FROM tops
  WHERE rn = 1
)
SELECT b.month_year,
       mp.interest_name                                AS top_interest,
       b.avg_comp                                      AS max_index_comp,
       LAG(mp.interest_name, 1)  OVER (ORDER BY b.month_year) AS one_mo_ago_name,
       LAG(b.avg_comp,       1)  OVER (ORDER BY b.month_year) AS one_mo_ago_comp,
       LAG(mp.interest_name, 2)  OVER (ORDER BY b.month_year) AS two_mo_ago_name,
       LAG(b.avg_comp,       2)  OVER (ORDER BY b.month_year) AS two_mo_ago_comp
FROM best AS b
JOIN interest_map AS mp
  ON b.interest_id = mp.id
LIMIT 20;
```

```sql
-- 9. Three‑month rolling average of the monthly max_index_comp values
WITH monthly AS (
  SELECT month_year,
         interest_id,
         ROUND(composition / index_value, 4) AS avg_comp
  FROM interest_metrics
  WHERE month_year >= '09-2018'
    AND month_year <= '08-2019'
    AND index_value <> 0
),
tops AS (
  SELECT month_year,
         interest_id,
         avg_comp,
         ROW_NUMBER() OVER (PARTITION BY month_year
                            ORDER BY avg_comp DESC) AS rn
  FROM monthly
),
best AS (
  SELECT month_year,
         interest_id,
         avg_comp
  FROM tops
  WHERE rn = 1
)
SELECT b.month_year,
       mp.interest_name                            AS top_interest,
       b.avg_comp                                  AS max_index_comp,
       ROUND(AVG(b.avg_comp) OVER (
               ORDER BY b.month_year
               ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
       ), 4)                                       AS rolling_avg_3mo
FROM best AS b
JOIN interest_map AS mp
  ON b.interest_id = mp.id
LIMIT 20;
```

```sql
-- 10. Final comprehensive query requested in the task
WITH monthly AS (
  SELECT month_year,
         interest_id,
         ROUND(composition / index_value, 4) AS avg_comp
  FROM interest_metrics
  WHERE month_year >= '09-2018'
    AND month_year <= '08-2019'
    AND index_value <> 0
),
tops AS (
  SELECT month_year,
         interest_id,
         avg_comp,
         ROW_NUMBER() OVER (PARTITION BY month_year
                            ORDER BY avg_comp DESC) AS rn
  FROM monthly
),
best AS (
  SELECT month_year,
         interest_id,
         avg_comp
  FROM tops
  WHERE rn = 1
)
SELECT b.month_year                               AS date,
       mp.interest_name                           AS interest_name,
       b.avg_comp                                 AS max_index_composition,
       ROUND(AVG(b.avg_comp) OVER (
               ORDER BY b.month_year
               ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
       ), 4)                                      AS rolling_avg_3mo,
       LAG(prev_mp.interest_name, 1) OVER (ORDER BY b.month_year) AS one_month_ago_interest,
       LAG(b.avg_comp,            1) OVER (ORDER BY b.month_year) AS one_month_ago_max,
       LAG(prev2_mp.interest_name, 2) OVER (ORDER BY b.month_year) AS two_months_ago_interest,
       LAG(b.avg_comp,            2) OVER (ORDER BY b.month_year) AS two_months_ago_max
FROM best AS b
JOIN interest_map AS mp       ON b.interest_id = mp.id
LEFT JOIN interest_map AS prev_mp  ON prev_mp.id  = LAG(b.interest_id, 1) OVER (ORDER BY b.month_year)
LEFT JOIN interest_map AS prev2_mp ON prev2_mp.id = LAG(b.interest_id, 2) OVER (ORDER BY b.month_year)
LIMIT 20;
```

