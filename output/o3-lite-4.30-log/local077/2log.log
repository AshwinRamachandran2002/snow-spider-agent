       LAG(mp.interest_name, 2) OVER (ORDER BY b.month_year) AS two_mo_ago_name,
       LAG(b.avg_comp,       2) OVER (ORDER BY b.month_year) AS two_mo_ago_comp
FROM best AS b
JOIN interest_map AS mp ON b.interest_id = mp.id
LIMIT 20
