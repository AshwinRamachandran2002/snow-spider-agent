Query:
--Description: Final comprehensive output: for each month (Sep‑2018 → Aug‑2019) show the
--top interest, its max index composition, the 3‑month rolling average, and the names &
--compositions of the top interests from one and two months earlier.
WITH monthly AS (
  SELECT month_year,
         interest_id,
         ROUND(composition / index_value, 4) AS avg_comp
  FROM interest_metrics
  WHERE (_year * 100 + _month) BETWEEN 201809 AND 201908
    AND index_value <> 0
),
tops AS (
  SELECT month_year,
         interest_id,
         avg_comp,
         ROW_NUMBER() OVER (PARTITION BY month_year ORDER BY avg_comp DESC) AS rn
  FROM monthly
),
best AS (
  SELECT month_year,
         interest_id,
         avg_comp
  FROM tops
  WHERE rn = 1
),
lagged AS (
  SELECT month_year,
         interest_id,
         avg_comp,
         LAG(interest_id, 1) OVER (ORDER BY month_year) AS prev_id_1,
         LAG(avg_comp,  1) OVER (ORDER BY month_year) AS prev_comp_1,
         LAG(interest_id, 2) OVER (ORDER BY month_year) AS prev_id_2,
         LAG(avg_comp,  2) OVER (ORDER BY month_year) AS prev_comp_2,
         ROUND(AVG(avg_comp) OVER (
               ORDER BY month_year
               ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
         ), 4) AS rolling_avg_3mo
  FROM best
)
SELECT l.month_year                     AS date,
       m0.interest_name                 AS interest_name,
       l.avg_comp                       AS max_index_composition,
       l.rolling_avg_3mo,
       m1.interest_name                 AS one_month_ago_interest,
       l.prev_comp_1                    AS one_month_ago_max,
       m2.interest_name                 AS two_months_ago_interest,
       l.prev_comp_2                    AS two_months_ago_max
FROM lagged AS l
JOIN interest_map AS m0 ON m0.id = l.interest_id
LEFT JOIN interest_map AS m1 ON m1.id = l.prev_id_1
LEFT JOIN interest_map AS m2 ON m2.id = l.prev_id_2
LIMIT 20
