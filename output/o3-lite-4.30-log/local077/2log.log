--Description: Identify, for each month in Sep‑2018‑Aug‑2019, the interest with the highest
--average‑composition (numeric filter and ROW_NUMBER approach).
WITH monthly AS (
  SELECT month_year,
         interest_id,
         ROUND(composition / index_value, 4) AS avg_comp
  FROM interest_metrics
  WHERE (_year * 100 + _month) BETWEEN 201809 AND 201908
    AND index_value <> 0
)
SELECT month_year,
       interest_id,
       avg_comp AS max_index_composition
FROM (
  SELECT m.*,
         ROW_NUMBER() OVER (PARTITION BY month_year ORDER BY avg_comp DESC) AS rn
  FROM monthly AS m
)
WHERE rn = 1
LIMIT 20
