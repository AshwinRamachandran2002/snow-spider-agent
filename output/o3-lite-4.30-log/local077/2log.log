--Description: Calculate the 3‑month rolling average of the monthly maximum
--average‑composition values for the same Sep‑2018‑Aug‑2019 window.
WITH monthly AS (
  SELECT month_year,
         interest_id,
         ROUND(composition / index_value, 4) AS avg_comp
  FROM interest_metrics
  WHERE (_year * 100 + _month) BETWEEN 201809 AND 201908
    AND index_value <> 0
),
tops AS (
  SELECT month_year,
         interest_id,
         avg_comp,
         ROW_NUMBER() OVER (PARTITION BY month_year ORDER BY avg_comp DESC) AS rn
  FROM monthly
),
best AS (
  SELECT month_year,
         interest_id,
         avg_comp
  FROM tops
  WHERE rn = 1
)
SELECT b.month_year,
       mp.interest_name                       AS top_interest,
       b.avg_comp                             AS max_index_comp,
       ROUND(AVG(b.avg_comp) OVER (
             ORDER BY b.month_year
             ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
       ), 4)                                  AS rolling_avg_3mo
FROM best AS b
JOIN interest_map AS mp ON b.interest_id = mp.id
LIMIT 20
