```sql
--Description: 
-- 9. Retrieve the monthly winning interest together with the winners from
--    one‑month and two‑months earlier.
--    a) monthly_interest  – average‑composition for every (month, interest).
--    b) monthly_best      – select the single highest average‑composition
--                           (max_index_composition) per month via ROW_NUMBER().
--    c) final SELECT      – use LAG() to pull the interest IDs and their
--                           max_index_composition from 1‑ and 2‑months ago.

WITH monthly_interest AS (
    SELECT
        _year,
        _month,
        month_year,
        interest_id,
        AVG(composition * 1.0 / NULLIF(index_value, 0)) AS avg_comp
    FROM interest_metrics
    WHERE (_year = 2018 AND _month >= 9)
       OR (_year = 2019 AND _month <= 8)
    GROUP BY _year, _month, month_year, interest_id
),
monthly_best AS (
    SELECT
        _year,
        _month,
        month_year,
        interest_id,
        avg_comp AS max_index_composition
    FROM (
        SELECT
            _year,
            _month,
            month_year,
            interest_id,
            avg_comp,
            ROW_NUMBER() OVER (PARTITION BY _year, _month
                               ORDER BY avg_comp DESC) AS rn
        FROM monthly_interest
    )
    WHERE rn = 1
)
SELECT
    month_year,
    interest_id                              AS curr_interest,
    ROUND(max_index_composition, 4)          AS curr_max_comp,
    LAG(interest_id, 1) OVER (ORDER BY _year, _month)          AS prev1_interest,
    ROUND(LAG(max_index_composition, 1) OVER (ORDER BY _year, _month), 4) AS prev1_max_comp,
    LAG(interest_id, 2) OVER (ORDER BY _year, _month)          AS prev2_interest,
    ROUND(LAG(max_index_composition, 2) OVER (ORDER BY _year, _month), 4) AS prev2_max_comp
FROM monthly_best
ORDER BY _year, _month;
```

```sql
--Description: 
-- 10. Produce the consolidated report containing:
--      • date (month_year)
--      • current month’s top interest & its max_index_composition
--      • 3‑month rolling average of the max_index_composition
--      • names and values of the top interests from 1‑ and 2‑months ago.
--    Steps mirror SQL #9, but also join to interest_map for names and
--    calculate the rolling average with a window function.

WITH monthly_interest AS (
    SELECT
        _year,
        _month,
        month_year,
        interest_id,
        AVG(composition * 1.0 / NULLIF(index_value, 0)) AS avg_comp
    FROM interest_metrics
    WHERE (_year = 2018 AND _month >= 9)
       OR (_year = 2019 AND _month <= 8)
    GROUP BY _year, _month, month_year, interest_id
),
monthly_best AS (
    SELECT
        _year,
        _month,
        month_year,
        interest_id,
        avg_comp AS max_index_composition
    FROM (
        SELECT
            _year,
            _month,
            month_year,
            interest_id,
            avg_comp,
            ROW_NUMBER() OVER (PARTITION BY _year, _month
                               ORDER BY avg_comp DESC) AS rn
        FROM monthly_interest
    )
    WHERE rn = 1
),
with_names AS (
    SELECT
        mb.*,
        im.interest_name
    FROM monthly_best mb
    JOIN interest_map im ON im.id = mb.interest_id
)
SELECT
    month_year                                   AS date,
    interest_name                                AS top_interest,
    ROUND(max_index_composition, 4)              AS max_index_composition,
    ROUND(
        AVG(max_index_composition) OVER (
            ORDER BY _year, _month
            ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
        ), 4
    )                                            AS rolling_avg_3m,
    LAG(interest_name, 1) OVER (ORDER BY _year, _month)          AS top_interest_minus_1m,
    ROUND(LAG(max_index_composition, 1) OVER (ORDER BY _year, _month), 4) AS max_comp_minus_1m,
    LAG(interest_name, 2) OVER (ORDER BY _year, _month)          AS top_interest_minus_2m,
    ROUND(LAG(max_index_composition, 2) OVER (ORDER BY _year, _month), 4) AS max_comp_minus_2m
FROM with_names
ORDER BY _year, _month;
