Begin Exploring Related Columns
Relevant columns and their potential usages  
_interest_metrics._year: filter rows to 2018‑2019 window (>=2018‑09 and <=2019‑08)  
_interest_metrics._month: used together with _year for filtering and ordering  
_interest_metrics.month_year: convenient text label for each month (e.g. ‘09‑2018’)  
_interest_metrics.interest_id: joins to interest_map.id  
_interest_metrics.composition: numerator for average‑composition calculation  
_interest_metrics.index_value: denominator for average‑composition calculation  
interest_map.id: joins to interest_metrics.interest_id  
interest_map.interest_name: human‑readable name of each interest  

Typical date‑range condition that will be reused:  
WHERE ( (_year = 2018 AND _month >= 9) OR (_year = 2019 AND _month <= 8) )

Ten exploratory SQL queries (simple → complex) – each returns ≤20 rows

```sql
-- 1. List the available month_year labels in our analysis window
SELECT DISTINCT month_year
FROM interest_metrics
WHERE (_year = 2018 AND _month >= 9) OR (_year = 2019 AND _month <= 8)
ORDER BY _year, _month
LIMIT 20;
```

```sql
-- 2. Inspect a handful of composition and index_value pairs
SELECT month_year,
       interest_id,
       composition,
       index_value
FROM interest_metrics
WHERE (_year = 2018 AND _month >= 9) OR (_year = 2019 AND _month <= 8)
LIMIT 20;
```

```sql
-- 3. Bring in the interest names to make the data readable
SELECT im.month_year,
       mp.interest_name,
       im.composition,
       im.index_value
FROM interest_metrics AS im
JOIN interest_map    AS mp ON im.interest_id = mp.id
WHERE (im._year = 2018 AND im._month >= 9) OR (im._year = 2019 AND im._month <= 8)
LIMIT 20;
```

```sql
-- 4. Calculate the average‑composition (= composition / index_value) for each row
SELECT month_year,
       interest_id,
       ROUND(composition * 1.0 / NULLIF(index_value,0), 4) AS avg_composition
FROM interest_metrics
WHERE (_year = 2018 AND _month >= 9) OR (_year = 2019 AND _month <= 8)
LIMIT 20;
```

```sql
-- 5. Aggregate to get the average‑composition for each interest per month
SELECT month_year,
       interest_id,
       ROUND(AVG(composition * 1.0 / NULLIF(index_value,0)), 4) AS avg_composition
FROM interest_metrics
WHERE (_year = 2018 AND _month >= 9) OR (_year = 2019 AND _month <= 8)
GROUP BY month_year, interest_id
LIMIT 20;
```

```sql
-- 6. Identify the top interest (highest avg_composition) within each month
SELECT a.month_year,
       a.interest_id,
       a.avg_composition
FROM (
     SELECT month_year,
            interest_id,
            AVG(composition * 1.0 / NULLIF(index_value,0)) AS avg_composition,
            RANK() OVER (PARTITION BY month_year ORDER BY AVG(composition * 1.0 / NULLIF(index_value,0)) DESC) AS rnk
     FROM interest_metrics
     WHERE (_year = 2018 AND _month >= 9) OR (_year = 2019 AND _month <= 8)
     GROUP BY month_year, interest_id
) AS a
WHERE a.rnk = 1
LIMIT 20;
```

```sql
-- 7. Attach the interest names to those monthly winners
SELECT t.month_year,
       m.interest_name,
       ROUND(t.avg_composition,4) AS max_index_composition
FROM (
     SELECT month_year,
            interest_id,
            AVG(composition * 1.0 / NULLIF(index_value,0)) AS avg_composition,
            RANK() OVER (PARTITION BY month_year ORDER BY AVG(composition * 1.0 / NULLIF(index_value,0)) DESC) AS rnk
     FROM interest_metrics
     WHERE (_year = 2018 AND _month >= 9) OR (_year = 2019 AND _month <= 8)
     GROUP BY month_year, interest_id
) AS t
JOIN interest_map AS m ON t.interest_id = m.id
WHERE t.rnk = 1
LIMIT 20;
```

```sql
-- 8. Compute the 3‑month rolling average of the monthly max_index_composition
WITH monthly_best AS (
     SELECT month_year,
            AVG(composition * 1.0 / NULLIF(index_value,0)) AS max_index_composition
     FROM interest_metrics
     WHERE (_year = 2018 AND _month >= 9) OR (_year = 2019 AND _month <= 8)
     GROUP BY month_year, interest_id
     HAVING AVG(composition * 1.0 / NULLIF(index_value,0)) = (
            SELECT MAX(AVG(composition * 1.0 / NULLIF(index_value,0)))
            FROM interest_metrics
            WHERE month_year = im.month_year
            GROUP BY interest_id
     )
) -- im alias used in the correlated subquery
SELECT month_year,
       max_index_composition,
       ROUND(AVG(max_index_composition) OVER (ORDER BY month_year ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),4) AS rolling_avg_3m
FROM monthly_best
ORDER BY month_year
LIMIT 20;
```

```sql
-- 9. Retrieve the winning interest from 1‑month and 2‑months ago for comparison
WITH monthly_best AS (
     SELECT month_year,
            interest_id,
            AVG(composition * 1.0 / NULLIF(index_value,0)) AS max_index_composition
     FROM interest_metrics
     WHERE (_year = 2018 AND _month >= 9) OR (_year = 2019 AND _month <= 8)
     GROUP BY month_year, interest_id
     HAVING AVG(composition * 1.0 / NULLIF(index_value,0)) = (
            SELECT MAX(AVG(composition * 1.0 / NULLIF(index_value,0)))
            FROM interest_metrics
            WHERE month_year = im.month_year
            GROUP BY interest_id
     )
)
SELECT curr.month_year,
       curr.interest_id       AS curr_interest,
       curr.max_index_composition,
       prev1.interest_id      AS prev1_interest,
       prev1.max_index_composition AS prev1_max,
       prev2.interest_id      AS prev2_interest,
       prev2.max_index_composition AS prev2_max
FROM monthly_best AS curr
LEFT JOIN monthly_best AS prev1
       ON prev1.month_year = (
              SELECT month_year
              FROM monthly_best
              WHERE month_year < curr.month_year
              ORDER BY month_year DESC
              LIMIT 1)
LEFT JOIN monthly_best AS prev2
       ON prev2.month_year = (
              SELECT month_year
              FROM monthly_best
              WHERE month_year < curr.month_year
              ORDER BY month_year DESC
              LIMIT 1 OFFSET 1)
ORDER BY curr.month_year
LIMIT 20;
```

```sql
-- 10. Final consolidated output with date, interest name, max_index_composition,
--     3‑month rolling average, plus top interests from 1‑ and 2‑months ago
WITH monthly_ranked AS (
     SELECT month_year,
            interest_id,
            AVG(composition * 1.0 / NULLIF(index_value,0)) AS avg_comp,
            RANK() OVER (PARTITION BY month_year ORDER BY AVG(composition * 1.0 / NULLIF(index_value,0)) DESC) AS rnk
     FROM interest_metrics
     WHERE (_year = 2018 AND _month >= 9) OR (_year = 2019 AND _month <= 8)
     GROUP BY month_year, interest_id
), monthly_best AS (
     SELECT month_year,
            interest_id,
            avg_comp AS max_index_composition
     FROM monthly_ranked
     WHERE rnk = 1
), rolling AS (
     SELECT month_year,
            max_index_composition,
            ROUND(AVG(max_index_composition) OVER (ORDER BY month_year
                                                   ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),4)
            AS rolling_avg_3m
     FROM monthly_best
)
SELECT b.month_year                             AS date,
       m_curr.interest_name                     AS top_interest,
       b.max_index_composition,
       r.rolling_avg_3m,
       m_prev1.interest_name                    AS top_interest_minus_1m,
       p1.max_index_composition                 AS max_comp_minus_1m,
       m_prev2.interest_name                    AS top_interest_minus_2m,
       p2.max_index_composition                 AS max_comp_minus_2m
FROM monthly_best           AS b
JOIN rolling                AS r     ON r.month_year = b.month_year
JOIN interest_map           AS m_curr ON m_curr.id = b.interest_id
LEFT JOIN monthly_best      AS p1 ON p1.month_year = (
      SELECT month_year FROM monthly_best
      WHERE month_year < b.month_year
      ORDER BY month_year DESC LIMIT 1)
LEFT JOIN interest_map      AS m_prev1 ON m_prev1.id = p1.interest_id
LEFT JOIN monthly_best      AS p2 ON p2.month_year = (
      SELECT month_year FROM monthly_best
      WHERE month_year < b.month_year
      ORDER BY month_year DESC LIMIT 1 OFFSET 1)
LEFT JOIN interest_map      AS m_prev2 ON m_prev2.id = p2.interest_id
ORDER BY b.month_year
LIMIT 20;
```

These ten queries progressively explore the relevant columns, calculate the required metrics, and culminate in a single statement that produces every element requested in the task (date, winning interest, monthly max index composition, three‑month rolling average, plus the winning interests from the previous two months).
