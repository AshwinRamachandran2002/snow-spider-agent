```sql
--Description:
-- 1) monthly_interest  – for every interest in each month (Sep‑2018 → Aug‑2019),
--    compute its average‑composition = AVG(composition / index_value).
-- 2) monthly_best      – retain the single highest‑average‑composition
--    (max_index_composition) per month via ROW_NUMBER().
-- 3) final SELECT      – join to interest_map for interest names,
--    add 3‑month rolling average of the max_index_composition, and
--    use LAG() to fetch the winning interests and values from
--    one‑month and two‑months earlier.

WITH monthly_interest AS (
    SELECT
        _year,
        _month,
        month_year,
        interest_id,
        AVG(composition * 1.0 / NULLIF(index_value, 0)) AS avg_comp
    FROM interest_metrics
    WHERE (_year = 2018 AND _month >= 9)
       OR (_year = 2019 AND _month <= 8)
    GROUP BY _year, _month, month_year, interest_id
),
monthly_best AS (
    SELECT
        _year,
        _month,
        month_year,
        interest_id,
        avg_comp AS max_index_composition
    FROM (
        SELECT
            _year,
            _month,
            month_year,
            interest_id,
            avg_comp,
            ROW_NUMBER() OVER (PARTITION BY _year, _month
                               ORDER BY avg_comp DESC) AS rn
        FROM monthly_interest
    )
    WHERE rn = 1                -- keep only the monthly winner
)
SELECT
    mb.month_year                        AS date,
    im_curr.interest_name                AS top_interest,
    ROUND(mb.max_index_composition, 4)   AS max_index_composition,
    ROUND(
        AVG(mb.max_index_composition) OVER (
            ORDER BY mb._year, mb._month
            ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
        ), 4
    )                                    AS rolling_avg_3m,
    LAG(im_curr.interest_name, 1)
        OVER (ORDER BY mb._year, mb._month)  AS top_interest_minus_1m,
    ROUND(LAG(mb.max_index_composition, 1)
        OVER (ORDER BY mb._year, mb._month), 4) AS max_comp_minus_1m,
    LAG(im_curr.interest_name, 2)
        OVER (ORDER BY mb._year, mb._month)  AS top_interest_minus_2m,
    ROUND(LAG(mb.max_index_composition, 2)
        OVER (ORDER BY mb._year, mb._month), 4) AS max_comp_minus_2m
FROM monthly_best AS mb
JOIN interest_map AS im_curr
     ON im_curr.id = mb.interest_id
ORDER BY mb._year, mb._month;
```
