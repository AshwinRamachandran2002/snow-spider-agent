Begin Exploring Related Columns
Relevant tables and columns for this task  

interest_metrics  
 • _month: filter months in the analysis period (09‑2018 → 08‑2019)  
 • _year: same filter – used together with _month to build the time‑series  
 • month_year: handy “MM‑YYYY” text key for joins and display  
 • interest_id: links every record to an interest in interest_map  
 • composition: numerator in the “average composition” calculation  
 • index_value: denominator in the “average composition” calculation  

interest_map  
 • id: joins to interest_metrics.interest_id  
 • interest_name: the business‑friendly name we ultimately need in the report  

Typical conditions that will be needed  

WHERE (_year = 2018 AND _month BETWEEN 9 AND 12)  
   OR (_year = 2019 AND _month BETWEEN 1 AND 8)  

or, with month_year text:  

WHERE month_year BETWEEN '09-2018' AND '08-2019'  

───────────────────────────────────────────────────────────────────────────────
Exploratory → increasingly complex SQL snippets (all return ≤ 20 rows)  
───────────────────────────────────────────────────────────────────────────────
```sql
-- 1. Distinct month/year values that exist in the source table
SELECT DISTINCT
       "month_year"
FROM   "interest_metrics"
ORDER  BY _year, _month
LIMIT  20;
```

```sql
-- 2. Interest IDs present in the study window
SELECT DISTINCT
       "interest_id"
FROM   "interest_metrics"
WHERE  (_year = 2018 AND _month BETWEEN 9 AND 12)
    OR (_year = 2019 AND _month BETWEEN 1 AND 8)
LIMIT  20;
```

```sql
-- 3. Join to pull the human‑readable interest names
SELECT  im."interest_id",
        mp."interest_name"
FROM    "interest_metrics" AS im
JOIN    "interest_map"     AS mp
          ON im."interest_id" = mp."id"
WHERE   im."month_year" = '09-2018'
LIMIT   20;
```

```sql
-- 4. Compute the single‑row “average composition” for each record
SELECT  im."month_year",
        im."interest_id",
        ROUND(im."composition" / NULLIF(im."index_value",0), 4) AS "avg_comp"
FROM    "interest_metrics" AS im
WHERE   im."month_year" = '09-2018'
LIMIT   20;
```

```sql
-- 5. Monthly average composition per interest (sample month)
SELECT  im."month_year",
        im."interest_id",
        ROUND(AVG(im."composition" / NULLIF(im."index_value",0)), 4) AS "avg_comp"
FROM    "interest_metrics" AS im
WHERE   im."month_year" = '10-2018'
GROUP BY im."month_year", im."interest_id"
ORDER BY "avg_comp" DESC
LIMIT   20;
```

```sql
-- 6. Identify the interest with the highest avg composition in one month
WITH month_interest AS (
  SELECT  im."month_year",
          im."interest_id",
          ROUND(AVG(im."composition" / NULLIF(im."index_value",0)), 4) AS "avg_comp"
  FROM    "interest_metrics" AS im
  WHERE   im."month_year" = '11-2018'
  GROUP BY im."month_year", im."interest_id"
)
SELECT  mi."month_year",
        mp."interest_name",
        mi."avg_comp" AS "max_index_composition"
FROM    month_interest AS mi
JOIN    "interest_map"  AS mp
         ON mi."interest_id" = mp."id"
ORDER BY mi."avg_comp" DESC
LIMIT   1;
```

```sql
-- 7. Do the above for every month in the study period
WITH month_interest AS (
  SELECT  im."month_year",
          im."interest_id",
          ROUND(AVG(im."composition" / NULLIF(im."index_value",0)), 4) AS "avg_comp"
  FROM    "interest_metrics" AS im
  WHERE  (_year = 2018 AND _month BETWEEN 9 AND 12)
      OR (_year = 2019 AND _month BETWEEN 1 AND 8)
  GROUP BY im."month_year", im."interest_id"
),
month_max AS (
  SELECT  mi."month_year",
          mi."interest_id",
          mi."avg_comp",
          ROW_NUMBER() OVER (PARTITION BY mi."month_year" ORDER BY mi."avg_comp" DESC) AS rn
  FROM    month_interest AS mi
)
SELECT  mm."month_year",
        mp."interest_name",
        mm."avg_comp" AS "max_index_composition"
FROM    month_max AS mm
JOIN    "interest_map" AS mp
          ON mm."interest_id" = mp."id"
WHERE   mm.rn = 1
ORDER   BY mm."month_year"
LIMIT   20;
```

```sql
-- 8. Three‑month rolling average of the monthly max values
WITH month_interest AS (
  SELECT  im."month_year",
          im."interest_id",
          ROUND(AVG(im."composition" / NULLIF(im."index_value",0)), 4) AS "avg_comp"
  FROM    "interest_metrics" AS im
  WHERE  (_year = 2018 AND _month BETWEEN 9 AND 12)
      OR (_year = 2019 AND _month BETWEEN 1 AND 8)
  GROUP BY im."month_year", im."interest_id"
),
month_max AS (
  SELECT  mi."month_year",
          mi."interest_id",
          mi."avg_comp" AS max_index_comp,
          ROW_NUMBER() OVER (PARTITION BY mi."month_year" ORDER BY mi."avg_comp" DESC) AS rn
  FROM    month_interest AS mi
),
final_max AS (
  SELECT  mm."month_year",
          mm."interest_id",
          mm."max_index_comp"
  FROM    month_max AS mm
  WHERE   mm.rn = 1
)
SELECT  f1."month_year",
        mp."interest_name",
        f1."max_index_comp",
        ROUND(AVG(f2."max_index_comp"),4) AS "rolling_3m_avg"
FROM    final_max AS f1
LEFT    JOIN final_max AS f2
       ON f2."month_year" BETWEEN
          substr(f1."month_year",1,2) || '-' || CAST(CAST(substr(f1."month_year",4,4) AS INTEGER)-1 AS TEXT)
          AND f1."month_year"    -- simplistic textual range
GROUP BY f1."month_year", mp."interest_name", f1."max_index_comp"
JOIN    "interest_map" AS mp
          ON f1."interest_id" = mp."id"
ORDER  BY f1."month_year"
LIMIT  20;
```

```sql
-- 9. Pull the top‑interest names & values from 1‑ and 2‑months ago
WITH month_interest AS (
  SELECT  im."month_year",
          im."interest_id",
          ROUND(AVG(im."composition" / NULLIF(im."index_value",0)), 4) AS "avg_comp"
  FROM    "interest_metrics" AS im
  WHERE  (_year = 2018 AND _month BETWEEN 9 AND 12)
      OR (_year = 2019 AND _month BETWEEN 1 AND 8)
  GROUP BY im."month_year", im."interest_id"
),
month_max AS (
  SELECT  mi."month_year",
          mi."interest_id",
          mi."avg_comp",
          ROW_NUMBER() OVER (PARTITION BY mi."month_year" ORDER BY mi."avg_comp" DESC) AS rn
  FROM    month_interest AS mi
),
final_max AS (
  SELECT  mm."month_year",
          mm."interest_id",
          mm."avg_comp" AS max_index_comp
  FROM    month_max AS mm
  WHERE   mm.rn = 1
),
lagged AS (
  SELECT  fm.*,
          LAG(fm."interest_id",1)  OVER (ORDER BY fm."month_year") AS lag1_id,
          LAG(fm."max_index_comp",1) OVER (ORDER BY fm."month_year") AS lag1_val,
          LAG(fm."interest_id",2)  OVER (ORDER BY fm."month_year") AS lag2_id,
          LAG(fm."max_index_comp",2) OVER (ORDER BY fm."month_year") AS lag2_val
  FROM    final_max AS fm
)
SELECT  l."month_year",
        mp_now."interest_name"           AS "this_month_interest",
        l."max_index_comp"               AS "this_month_comp",
        mp_l1."interest_name"            AS "lag1_interest",
        l."lag1_val"                     AS "lag1_comp",
        mp_l2."interest_name"            AS "lag2_interest",
        l."lag2_val"                     AS "lag2_comp"
FROM    lagged AS l
LEFT JOIN "interest_map" AS mp_now ON mp_now."id" = l."interest_id"
LEFT JOIN "interest_map" AS mp_l1  ON mp_l1."id" = l."lag1_id"
LEFT JOIN "interest_map" AS mp_l2  ON mp_l2."id" = l."lag2_id"
ORDER  BY l."month_year"
LIMIT  20;
```

```sql
-- 10. Final all‑in‑one report: max index comp, 3‑month rolling avg, plus lag‑1 and lag‑2 interest info
WITH month_interest AS (
  SELECT  im."month_year",
          im."interest_id",
          ROUND(AVG(im."composition" / NULLIF(im."index_value",0)), 4) AS "avg_comp"
  FROM    "interest_metrics" AS im
  WHERE  (_year = 2018 AND _month BETWEEN 9 AND 12)
      OR (_year = 2019 AND _month BETWEEN 1 AND 8)
  GROUP BY im."month_year", im."interest_id"
),
month_max AS (
  SELECT  mi."month_year",
          mi."interest_id",
          mi."avg_comp",
          ROW_NUMBER() OVER (PARTITION BY mi."month_year" ORDER BY mi."avg_comp" DESC) AS rn
  FROM    month_interest AS mi
),
final_max AS (
  SELECT  mm."month_year",
          mm."interest_id",
          mm."avg_comp" AS max_index_comp
  FROM    month_max AS mm
  WHERE   mm.rn = 1
),
rolling AS (
  SELECT  fm.*,
          AVG(fm2."max_index_comp") AS rolling_3m_avg
  FROM    final_max AS fm
  JOIN    final_max AS fm2
    ON    DATE(substr(fm2."month_year",4,4) || '-' || substr(fm2."month_year",1,2) || '-01') BETWEEN
          DATE(substr(fm."month_year",4,4) || '-' || substr(fm."month_year",1,2) || '-01', '-2 months')
          AND DATE(substr(fm."month_year",4,4) || '-' || substr(fm."month_year",1,2) || '-01')
  GROUP BY fm."month_year", fm."interest_id", fm."max_index_comp"
),
lagged AS (
  SELECT  r.*,
          LAG(r."interest_id",1)  OVER (ORDER BY r."month_year") AS lag1_id,
          LAG(r."max_index_comp",1) OVER (ORDER BY r."month_year") AS lag1_val,
          LAG(r."interest_id",2)  OVER (ORDER BY r."month_year") AS lag2_id,
          LAG(r."max_index_comp",2) OVER (ORDER BY r."month_year") AS lag2_val
  FROM    rolling AS r
)
SELECT  l."month_year",
        mp_now."interest_name" AS "interest_name",
        l."max_index_comp"     AS "max_index_comp",
        ROUND(l."rolling_3m_avg",4) AS "rolling_3m_avg",
        mp_l1."interest_name"  AS "lag1_interest",
        l."lag1_val"           AS "lag1_comp",
        mp_l2."interest_name"  AS "lag2_interest",
        l."lag2_val"           AS "lag2_comp"
FROM    lagged AS l
LEFT JOIN "interest_map" AS mp_now ON mp_now."id" = l."interest_id"
LEFT JOIN "interest_map" AS mp_l1  ON mp_l1."id" = l."lag1_id"
LEFT JOIN "interest_map" AS mp_l2  ON mp_l2."id" = l."lag2_id"
ORDER  BY l."month_year"
LIMIT  20;
```

