--Description: end‑to‑end solution in ONE query (built with CTEs) showing the
-- reasoning inside comments.  Objectives:
--   • Work on Sep‑2018 → Aug‑2019 data.
--   • For every month, compute average_composition = composition / index_value
--     for each interest and pick the interest with the highest value.
--   • Produce the three‑month rolling average of those monthly maxima.
--   • Also display the top interests (and their max values) from one and two
--     months prior.
-- CTE flow:
--   1️⃣ month_interest : Avg‑composition per (month, interest).
--   2️⃣ month_max      : Rank interests each month, keep the winner.
--   3️⃣ final_max      : Add a real date field (month_start) for time windows.
--   4️⃣ rolling        : Compute 3‑month rolling average of the max values.
--   5️⃣ lagged         : Pull lag‑1 and lag‑2 interest IDs & comps.
WITH month_interest AS (   -- 1️⃣
    SELECT  month_year,
            interest_id,
            ROUND(AVG(composition / NULLIF(index_value,0)),4) AS avg_comp
    FROM    interest_metrics
    WHERE  (_year = 2018 AND _month BETWEEN 9 AND 12)
       OR  (_year = 2019 AND _month BETWEEN 1 AND 8)
    GROUP BY month_year, interest_id
),
month_max AS (             -- 2️⃣
    SELECT  month_year,
            interest_id,
            avg_comp AS max_index_comp,
            ROW_NUMBER() OVER (PARTITION BY month_year ORDER BY avg_comp DESC) AS rn
    FROM    month_interest
),
final_max AS (             -- 3️⃣
    SELECT  month_year,
            date(substr(month_year,4,4)||'-'||substr(month_year,1,2)||'-01') AS month_start,
            interest_id,
            max_index_comp
    FROM    month_max
    WHERE   rn = 1
),
rolling AS (               -- 4️⃣
    SELECT  fm.*,
            AVG(fm.max_index_comp) OVER (
                ORDER BY fm.month_start
                ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
            ) AS rolling_3m_avg
    FROM    final_max AS fm
),
lagged AS (                -- 5️⃣
    SELECT  r.*,
            LAG(r.interest_id,1)    OVER (ORDER BY r.month_start) AS lag1_id,
            LAG(r.max_index_comp,1) OVER (ORDER BY r.month_start) AS lag1_comp,
            LAG(r.interest_id,2)    OVER (ORDER BY r.month_start) AS lag2_id,
            LAG(r.max_index_comp,2) OVER (ORDER BY r.month_start) AS lag2_comp
    FROM    rolling AS r
)
SELECT  l.month_year,
        mp_now.interest_name      AS interest_name,
        l.max_index_comp          AS max_index_comp,
        ROUND(l.rolling_3m_avg,4) AS rolling_3m_avg,
        mp_l1.interest_name       AS lag1_interest,
        l.lag1_comp               AS lag1_comp,
        mp_l2.interest_name       AS lag2_interest,
        l.lag2_comp               AS lag2_comp
FROM    lagged AS l
LEFT JOIN interest_map AS mp_now ON mp_now.id = l.interest_id
LEFT JOIN interest_map AS mp_l1  ON mp_l1.id  = l.lag1_id
LEFT JOIN interest_map AS mp_l2  ON mp_l2.id  = l.lag2_id
ORDER BY l.month_start;
```
