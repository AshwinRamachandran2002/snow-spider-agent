{'bigquery-public-data': {'san_francisco': ['film_locations', 'bikeshare_stations', 'street_trees', 'sfpd_incidents', 'bikeshare_status', 'bikeshare_trips', '311_service_requests', 'sffd_service_calls']}}
Begin Exploring Related Columns
Relevant tables and columns for this task  

bigquery-public-data.san_francisco.bikeshare_trips  
• start_date : converts to YYYYMM; used to decide “first / last” by chronological order and to group results  
• duration_sec : converts to minutes (duration_sec / 60) for the four required statistics  
• start_station_id : will be joined to the station list so we can keep only San Francisco trips  

bigquery-public-data.san_francisco.bikeshare_stations  
• station_id : join key to bikeshare_trips.start_station_id  
• landmark : filter ‟San Francisco” so the analysis only covers SF trips  


Typical conditions that will be used  
• s.landmark = 'San Francisco'              -- keep only SF stations  
• FORMAT_DATE('%Y%m', DATE(t.start_date))   -- derive YYYYMM key  
• ORDER BY t.start_date ASC / DESC          -- decide “first” and “last” trip within each YYYYMM  
• duration_sec / 60.0                       -- convert seconds to minutes  


Ten exploratory‑to‑solution BigQuery SQLs  
Each query shows up to 20 rows and is commented.

```sql
-- 1. Show a handful of raw trip records
SELECT *
FROM `bigquery-public-data.san_francisco.bikeshare_trips`
LIMIT 20;
```

```sql
-- 2. Peek at SF stations (landmark = 'San Francisco')
SELECT station_id, name, landmark
FROM `bigquery-public-data.san_francisco.bikeshare_stations`
WHERE landmark = 'San Francisco'
LIMIT 20;
```

```sql
-- 3. Count how many trips start from SF stations
SELECT COUNT(*) AS sf_trip_cnt
FROM `bigquery-public-data.san_francisco.bikeshare_trips`  AS t
JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS s
  ON t.start_station_id = s.station_id
WHERE s.landmark = 'San Francisco';
```

```sql
-- 4. List distinct YYYYMM buckets for SF trips
SELECT DISTINCT
       FORMAT_DATE('%Y%m', DATE(t.start_date)) AS ym
FROM `bigquery-public-data.san_francisco.bikeshare_trips`  AS t
JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS s
  ON t.start_station_id = s.station_id
WHERE s.landmark = 'San Francisco'
ORDER BY ym
LIMIT 20;
```

```sql
-- 5. Show trip durations (minutes) for one month to eyeball ranges
SELECT
  FORMAT_DATE('%Y%m', DATE(t.start_date)) AS ym,
  t.start_date,
  ROUND(t.duration_sec / 60.0, 2) AS duration_min
FROM `bigquery-public-data.san_francisco.bikeshare_trips` AS t
JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS s
  ON t.start_station_id = s.station_id
WHERE s.landmark = 'San Francisco'
  AND FORMAT_DATE('%Y%m', DATE(t.start_date)) = '201508'
ORDER BY t.start_date
LIMIT 20;
```

```sql
-- 6. Earliest and latest start_date for every month (no durations yet)
SELECT
  ym,
  MIN(start_date) AS first_start,
  MAX(start_date) AS last_start
FROM (
  SELECT FORMAT_DATE('%Y%m', DATE(t.start_date)) AS ym,
         t.start_date
  FROM `bigquery-public-data.san_francisco.bikeshare_trips` AS t
  JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS s
    ON t.start_station_id = s.station_id
  WHERE s.landmark = 'San Francisco'
)
GROUP BY ym
ORDER BY ym
LIMIT 20;
```

```sql
-- 7. Min / max trip duration (minutes) for every YYYYMM
SELECT
  FORMAT_DATE('%Y%m', DATE(t.start_date)) AS ym,
  MIN(t.duration_sec) / 60.0 AS lowest_min,
  MAX(t.duration_sec) / 60.0 AS highest_min
FROM `bigquery-public-data.san_francisco.bikeshare_trips` AS t
JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS s
  ON t.start_station_id = s.station_id
WHERE s.landmark = 'San Francisco'
GROUP BY ym
ORDER BY ym
LIMIT 20;
```

```sql
-- 8. Pull first and last trip DURATIONS for each month using analytic functions
WITH sf_trips AS (
  SELECT
    FORMAT_DATE('%Y%m', DATE(t.start_date)) AS ym,
    t.start_date,
    t.duration_sec / 60.0 AS duration_min
  FROM `bigquery-public-data.san_francisco.bikeshare_trips` AS t
  JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS s
    ON t.start_station_id = s.station_id
  WHERE s.landmark = 'San Francisco'
)
SELECT
  ym,
  FIRST_VALUE(duration_min) OVER(PARTITION BY ym ORDER BY start_date ASC)  AS first_trip_min,
  FIRST_VALUE(duration_min) OVER(PARTITION BY ym ORDER BY start_date DESC) AS last_trip_min
FROM sf_trips
ORDER BY ym, start_date
LIMIT 20;
```

```sql
-- 9. Combine first/last/highest/lowest for one sample month
WITH sf_trips AS (
  SELECT
    FORMAT_DATE('%Y%m', DATE(t.start_date)) AS ym,
    t.start_date,
    t.duration_sec / 60.0 AS duration_min
  FROM `bigquery-public-data.san_francisco.bikeshare_trips` AS t
  JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS s
    ON t.start_station_id = s.station_id
  WHERE s.landmark = 'San Francisco'
    AND FORMAT_DATE('%Y%m', DATE(t.start_date)) = '201508'
)
SELECT DISTINCT
  ym,
  FIRST_VALUE(duration_min) OVER(ORDER BY start_date ASC)  AS first_trip_min,
  FIRST_VALUE(duration_min) OVER(ORDER BY start_date DESC) AS last_trip_min,
  MAX(duration_min) OVER()                                 AS highest_trip_min,
  MIN(duration_min) OVER()                                 AS lowest_trip_min
FROM sf_trips
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: first, last, highest and lowest trip durations (minutes)
--                   for every YYYYMM in San Francisco, sorted by YYYYMM
WITH sf_trips AS (
  SELECT
    FORMAT_DATE('%Y%m', DATE(t.start_date)) AS ym,
    t.start_date,
    t.duration_sec / 60.0 AS duration_min
  FROM `bigquery-public-data.san_francisco.bikeshare_trips`  AS t
  JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS s
       ON t.start_station_id = s.station_id
  WHERE s.landmark = 'San Francisco'
),
ranked AS (
  SELECT
    ym,
    start_date,
    duration_min,
    -- row numbers to identify first and last within each month
    ROW_NUMBER() OVER(PARTITION BY ym ORDER BY start_date ASC)  AS rn_first,
    ROW_NUMBER() OVER(PARTITION BY ym ORDER BY start_date DESC) AS rn_last
  FROM sf_trips
)
SELECT
  ym,
  -- first trip duration (earliest start_date)
  MAX(CASE WHEN rn_first = 1 THEN duration_min END) AS first_trip_min,
  -- last trip duration  (latest  start_date)
  MAX(CASE WHEN rn_last  = 1 THEN duration_min END) AS last_trip_min,
  -- highest / lowest duration in the entire month
  MAX(duration_min) AS highest_trip_min,
  MIN(duration_min) AS lowest_trip_min
FROM ranked
GROUP BY ym
ORDER BY ym;
```

Each query is limited to at most 20 rows except the final answer, which returns the complete year‑month summary sorted by YYYYMM.
