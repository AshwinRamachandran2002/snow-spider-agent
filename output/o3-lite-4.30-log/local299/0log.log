Begin Exploring Related Columns
Relevant columns and their possible roles
• customer_transactions.customer_id : primary key to identify each customer and allow all grouping operations  
• customer_transactions.txn_date   : the calendar date for each transaction – drives the daily balance, 30‑day window and month buckets  
• customer_transactions.txn_type   : tells us whether the money is a “deposit” (add to balance) or any other type (subtract from balance)  
• customer_transactions.txn_amount : dollar amount of the movement – positive value stored in the table, later signed ± according to txn_type  

Typical conditions we will need
• WHERE txn_type = 'deposit'          → add to balance  
• WHERE txn_type <> 'deposit'         → subtract from balance  
• Rolling window frame                → 30 days (ROWS BETWEEN 29 PRECEDING AND CURRENT ROW)  
• CASE WHEN avg_bal < 0 THEN 0 END    → replace negative 30‑day averages by zero  
• First month filter                  → EXCLUDE months that equal the customer’s MIN(txn_date) month  

Exploratory SQL queries  
(Each query is limited to 20 rows so you can inspect the data step‑by‑step.)

```sql
-- 1. Description: List all different transaction types that exist in the data
SELECT DISTINCT txn_type
FROM customer_transactions
LIMIT 20;
```

```sql
-- 2. Description: See the first 20 raw rows to understand the date format and values
SELECT *
FROM customer_transactions
LIMIT 20;
```

```sql
-- 3. Description: List distinct Year‑Month combinations found in the table
SELECT DISTINCT SUBSTR(txn_date, 1, 7) AS year_month
FROM customer_transactions
ORDER BY year_month
LIMIT 20;
```

```sql
-- 4. Description: For each customer, check the very first transaction date (baseline month indicator)
SELECT DISTINCT customer_id,
       MIN(txn_date) OVER (PARTITION BY customer_id) AS first_txn_date
FROM customer_transactions
LIMIT 20;
```

```sql
-- 5. Description: Daily net movement (+ for deposits, – for others) for each customer
SELECT DISTINCT customer_id,
       txn_date,
       SUM(CASE WHEN txn_type = 'deposit' THEN txn_amount
                ELSE -txn_amount END) AS net_amount
FROM customer_transactions
GROUP BY customer_id, txn_date
LIMIT 20;
```

```sql
-- 6. Description: Running balance for one sample customer (the smallest id in the table)
WITH first_cust AS (
  SELECT MIN(customer_id) AS cid FROM customer_transactions
)
SELECT DISTINCT ct.customer_id,
       ct.txn_date,
       SUM(CASE WHEN ct.txn_type = 'deposit' THEN ct.txn_amount
                ELSE -ct.txn_amount END)
       OVER (PARTITION BY ct.customer_id
             ORDER BY ct.txn_date
             ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_balance
FROM customer_transactions AS ct
JOIN first_cust ON ct.customer_id = first_cust.cid
LIMIT 20;
```

```sql
-- 7. Description: 30‑day rolling average balance (negative averages forced to zero) for that same customer
WITH first_cust AS (
  SELECT MIN(customer_id) AS cid FROM customer_transactions
),
daily_bal AS (
  SELECT customer_id,
         txn_date,
         SUM(CASE WHEN txn_type = 'deposit' THEN txn_amount
                  ELSE -txn_amount END) 
         OVER (PARTITION BY customer_id
               ORDER BY txn_date
               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_balance
  FROM customer_transactions
  WHERE customer_id = (SELECT cid FROM first_cust)
)
SELECT DISTINCT customer_id,
       txn_date,
       CASE 
         WHEN AVG(running_balance) OVER (PARTITION BY customer_id
                                         ORDER BY txn_date
                                         ROWS BETWEEN 29 PRECEDING AND CURRENT ROW) < 0
         THEN 0
         ELSE AVG(running_balance) OVER (PARTITION BY customer_id
                                         ORDER BY txn_date
                                         ROWS BETWEEN 29 PRECEDING AND CURRENT ROW)
       END AS avg_30d_balance
FROM daily_bal
LIMIT 20;
```

```sql
-- 8. Description: 30‑day rolling average balance for ALL customers (negative averages set to zero)
WITH daily_bal AS (
  SELECT customer_id,
         txn_date,
         SUM(CASE WHEN txn_type = 'deposit' THEN txn_amount
                  ELSE -txn_amount END) 
         OVER (PARTITION BY customer_id
               ORDER BY txn_date
               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_balance
  FROM customer_transactions
),
rolling_30 AS (
  SELECT customer_id,
         txn_date,
         MAX(0,
             AVG(running_balance) OVER (PARTITION BY customer_id
                                        ORDER BY txn_date
                                        ROWS BETWEEN 29 PRECEDING AND CURRENT ROW)
         ) AS avg_30d_balance
  FROM daily_bal
)
SELECT DISTINCT *
FROM rolling_30
LIMIT 20;
```

```sql
-- 9. Description: Each customer’s maximum 30‑day average balance within every month
WITH daily_bal AS (
  SELECT customer_id,
         txn_date,
         SUM(CASE WHEN txn_type = 'deposit' THEN txn_amount
                  ELSE -txn_amount END) 
         OVER (PARTITION BY customer_id
               ORDER BY txn_date
               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_balance
  FROM customer_transactions
),
rolling_30 AS (
  SELECT customer_id,
         txn_date,
         MAX(0,
             AVG(running_balance) OVER (PARTITION BY customer_id
                                        ORDER BY txn_date
                                        ROWS BETWEEN 29 PRECEDING AND CURRENT ROW)
         ) AS avg_30d_balance
  FROM daily_bal
),
cust_month_max AS (
  SELECT customer_id,
         SUBSTR(txn_date, 1, 7) AS year_month,
         MAX(avg_30d_balance)   AS max_30d_bal_in_month
  FROM rolling_30
  GROUP BY customer_id, year_month
)
SELECT DISTINCT *
FROM cust_month_max
LIMIT 20;
```

```sql
-- 10. Description: Final answer – sum of those monthly maxima over all customers, 
--                  excluding each customer’s first-month baseline
WITH first_month AS (
  SELECT customer_id,
         SUBSTR(MIN(txn_date), 1, 7) AS first_year_month
  FROM customer_transactions
  GROUP BY customer_id
),
daily_bal AS (
  SELECT customer_id,
         txn_date,
         SUM(CASE WHEN txn_type = 'deposit' THEN txn_amount
                  ELSE -txn_amount END) 
         OVER (PARTITION BY customer_id
               ORDER BY txn_date
               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_balance
  FROM customer_transactions
),
rolling_30 AS (
  SELECT customer_id,
         txn_date,
         MAX(0,
             AVG(running_balance) OVER (PARTITION BY customer_id
                                        ORDER BY txn_date
                                        ROWS BETWEEN 29 PRECEDING AND CURRENT ROW)
         ) AS avg_30d_balance
  FROM daily_bal
),
cust_month_max AS (
  SELECT customer_id,
         SUBSTR(txn_date, 1, 7) AS year_month,
         MAX(avg_30d_balance)   AS max_30d_bal_in_month
  FROM rolling_30
  GROUP BY customer_id, year_month
),
filtered AS (
  SELECT cmm.*
  FROM cust_month_max AS cmm
  LEFT JOIN first_month AS fm
         ON cmm.customer_id = fm.customer_id
        AND cmm.year_month = fm.first_year_month
  WHERE fm.customer_id IS NULL        -- drop the baseline month
)
SELECT DISTINCT year_month,
       SUM(max_30d_bal_in_month) AS total_max_30d_balance
FROM filtered
GROUP BY year_month
ORDER BY year_month
LIMIT 20;
```
