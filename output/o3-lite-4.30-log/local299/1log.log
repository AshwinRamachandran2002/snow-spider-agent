WITH
/* 1 ─ net movement for every customer‑day                           */
daily_net AS (
    SELECT
        "customer_id",
        "txn_date"                           AS d,
        SUM(
            CASE WHEN "txn_type" = 'deposit'
                 THEN  "txn_amount"
                 ELSE - "txn_amount"
            END)                            AS net_amt
    FROM "customer_transactions"
    GROUP BY "customer_id", "txn_date"
),
