WITH daily AS (                  /* net amount (+ deposit, – otherwise) per customer‑day */
    SELECT
        "customer_id",
        "txn_date",
        SUM(
            CASE WHEN "txn_type" = 'deposit'
                 THEN  1.0
                 ELSE -1.0
            END * "txn_amount"
        ) AS net_amount
    FROM "customer_transactions"
    GROUP BY "customer_id", "txn_date"
),
balance AS (                     /* running balance for every calendar day              */
    SELECT
        "customer_id",
        "txn_date",
        SUM(net_amount) OVER (
            PARTITION BY "customer_id"
            ORDER BY "txn_date"
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS running_balance
    FROM daily
),
rolling AS (                     /* 30‑day rolling average balance, negatives floored   */
    SELECT
        "customer_id",
        "txn_date",
        CASE
            WHEN avg_bal < 0 THEN 0
            ELSE avg_bal
        END AS rolling_30d_avg
    FROM (
        SELECT
            "customer_id",
            "txn_date",
            AVG(running_balance) OVER (               -- true 30‑day window
                PARTITION BY "customer_id"
                ORDER BY julianday("txn_date")
                RANGE BETWEEN 29 PRECEDING AND CURRENT ROW
            ) AS avg_bal
        FROM balance
    )
),
monthly_max AS (                 /* max 30‑day avg per customer‑month                   */
    SELECT
        "customer_id",
        strftime('%Y-%m', "txn_date") AS month_key,
        MAX(rolling_30d_avg)          AS max_30d_avg_in_month
    FROM rolling
    GROUP BY "customer_id", month_key
    HAVING max_30d_avg_in_month IS NOT NULL
),
first_month AS (                 /* each customer’s baseline month                      */
    SELECT
        "customer_id",
        MIN(strftime('%Y-%m', "txn_date")) AS first_month_key
    FROM "customer_transactions"
    GROUP BY "customer_id"
)
SELECT
    mm.month_key  AS month,
    ROUND(SUM(mm.max_30d_avg_in_month), 4) AS total_max_30day_avg_balance
FROM monthly_max AS mm
JOIN first_month AS fm
  ON mm."customer_id" = fm."customer_id"
WHERE mm.month_key <> fm.first_month_key          -- exclude baseline month
GROUP BY mm.month_key
ORDER BY mm.month_key;
