-- 10. Description: Final answer – sum of monthly maxima across customers, after excluding each customer’s first month.
WITH daily AS (
  SELECT "customer_id",
         "txn_date",
         SUM(CASE WHEN "txn_type"='deposit' THEN +1 ELSE -1 END * "txn_amount") AS net_amount
  FROM   "customer_transactions"
  GROUP  BY "customer_id","txn_date"
),
balance AS (
  SELECT "customer_id",
         "txn_date",
         SUM(net_amount) OVER (
             PARTITION BY "customer_id"
             ORDER BY "txn_date"
             ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
         ) AS running_balance
  FROM   daily
),
rolling AS (
  SELECT "customer_id",
         "txn_date",
         CASE 
           WHEN AVG(running_balance) OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "txn_date"
                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                ) < 0 THEN 0
           ELSE AVG(running_balance) OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "txn_date"
                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                )
         END AS rolling_30d_avg_non_neg
  FROM   balance
),
monthly_max AS (
  SELECT "customer_id",
         strftime('%Y-%m', "txn_date") AS month_key,
         MAX(rolling_30d_avg_non_neg) AS max_30d_avg_in_month
  FROM   rolling
  GROUP  BY "customer_id", month_key
),
first_mth AS (
  SELECT "customer_id",
         MIN(month_key) AS first_month_key
  FROM   monthly_max
  GROUP  BY "customer_id"
)
SELECT mm.month_key,
       SUM(mm.max_30d_avg_in_month) AS total_of_max_30d_avgs
FROM   monthly_max AS mm
JOIN   first_mth  AS fm
  ON   mm."customer_id" = fm."customer_id"
WHERE  mm.month_key <> fm.first_month_key          -- exclude baseline month
GROUP  BY mm.month_key
ORDER  BY mm.month_key
LIMIT 20
