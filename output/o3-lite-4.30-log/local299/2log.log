Begin Exploring Related Columns
Relevant columns and their potential usage
• customer_transactions."customer_id": identifies each customer for partitioning the running‑balance calculations.  
• customer_transactions."txn_date": the calendar date we will aggregate to a “daily” grain, drive the running totals, rolling 30‑day window, and month key.  
• customer_transactions."txn_type": tells us whether the row is a “deposit” (adds to balance) or some other type (subtracts from balance).  
• customer_transactions."txn_amount": dollar amount that is added or subtracted from the balance (sign will be flipped for non‑deposits).  

Typical conditions that will be required  
• CASE WHEN "txn_type" = 'deposit' THEN +1 ELSE -1 END to decide the sign of each transaction.  
• GROUP BY "customer_id", "txn_date" to get a net amount per day before calculating the running balance.  
• Window functions (SUM … OVER, AVG … OVER) ordered by "txn_date" with PARTITION BY "customer_id".  
• strftime('%Y-%m', "txn_date") to derive the month key.  
• Exclude the customer’s first month: WHERE month_key <> first_month_key.  

Below are 10 exploratory → increasingly complex queries (all limited to 20 rows) that step through the logic until the final answer.  
```sql
-- 1. Description: List every distinct transaction type that exists.
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;

-- 2. Description: Show how many transactions there are for every txn_type.
SELECT "txn_type",
       COUNT(*) AS txn_cnt
FROM   "customer_transactions"
GROUP  BY "txn_type"
ORDER  BY txn_cnt DESC
LIMIT 20;

-- 3. Description: Inspect the overall date span in the data.
SELECT MIN("txn_date") AS earliest_date,
       MAX("txn_date") AS latest_date
FROM   "customer_transactions"
LIMIT 20;

-- 4. Description: Daily net amount (deposits positive, everything else negative) for the first few customers.
SELECT "customer_id",
       "txn_date",
       SUM(CASE WHEN "txn_type"='deposit' THEN +1 ELSE -1 END * "txn_amount") AS net_amount
FROM   "customer_transactions"
GROUP  BY "customer_id","txn_date"
ORDER  BY "customer_id","txn_date"
LIMIT 20;

-- 5. Description: Running balance per customer, day by day.
WITH daily AS (
  SELECT "customer_id",
         "txn_date",
         SUM(CASE WHEN "txn_type"='deposit' THEN +1 ELSE -1 END * "txn_amount") AS net_amount
  FROM   "customer_transactions"
  GROUP  BY "customer_id","txn_date"
)
SELECT "customer_id",
       "txn_date",
       net_amount,
       SUM(net_amount) OVER (
           PARTITION BY "customer_id"
           ORDER BY "txn_date"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
       ) AS running_balance
FROM   daily
ORDER  BY "customer_id","txn_date"
LIMIT 20;

-- 6. Description: 30‑day rolling average balance (needs at least 30 days).
WITH daily AS (
  SELECT "customer_id",
         "txn_date",
         SUM(CASE WHEN "txn_type"='deposit' THEN +1 ELSE -1 END * "txn_amount") AS net_amount
  FROM   "customer_transactions"
  GROUP  BY "customer_id","txn_date"
),
balance AS (
  SELECT "customer_id",
         "txn_date",
         SUM(net_amount) OVER (
             PARTITION BY "customer_id"
             ORDER BY "txn_date"
             ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
         ) AS running_balance
  FROM   daily
)
SELECT "customer_id",
       "txn_date",
       running_balance,
       AVG(running_balance) OVER (
            PARTITION BY "customer_id"
            ORDER BY "txn_date"
            ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
       ) AS rolling_30d_avg
FROM   balance
ORDER  BY "customer_id","txn_date"
LIMIT 20;

-- 7. Description: Same as #6 but negative rolling averages are forced to 0.
WITH daily AS (
  SELECT "customer_id",
         "txn_date",
         SUM(CASE WHEN "txn_type"='deposit' THEN +1 ELSE -1 END * "txn_amount") AS net_amount
  FROM   "customer_transactions"
  GROUP  BY "customer_id","txn_date"
),
balance AS (
  SELECT "customer_id",
         "txn_date",
         SUM(net_amount) OVER (
             PARTITION BY "customer_id"
             ORDER BY "txn_date"
             ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
         ) AS running_balance
  FROM   daily
)
SELECT "customer_id",
       "txn_date",
       CASE 
         WHEN AVG(running_balance) OVER (
               PARTITION BY "customer_id"
               ORDER BY "txn_date"
               ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
            ) < 0
         THEN 0
         ELSE AVG(running_balance) OVER (
               PARTITION BY "customer_id"
               ORDER BY "txn_date"
               ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
            )
       END AS rolling_30d_avg_non_neg
FROM   balance
ORDER  BY "customer_id","txn_date"
LIMIT 20;

-- 8. Description: For every customer‑month, keep only the maximum 30‑day average balance.
WITH daily AS (
  SELECT "customer_id",
         "txn_date",
         SUM(CASE WHEN "txn_type"='deposit' THEN +1 ELSE -1 END * "txn_amount") AS net_amount
  FROM   "customer_transactions"
  GROUP  BY "customer_id","txn_date"
),
balance AS (
  SELECT "customer_id",
         "txn_date",
         SUM(net_amount) OVER (
             PARTITION BY "customer_id"
             ORDER BY "txn_date"
             ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
         ) AS running_balance
  FROM   daily
),
rolling AS (
  SELECT "customer_id",
         "txn_date",
         CASE 
           WHEN AVG(running_balance) OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "txn_date"
                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                ) < 0 THEN 0
           ELSE AVG(running_balance) OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "txn_date"
                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                )
         END AS rolling_30d_avg_non_neg
  FROM   balance
)
SELECT "customer_id",
       strftime('%Y-%m', "txn_date") AS month_key,
       MAX(rolling_30d_avg_non_neg) AS max_30d_avg_in_month
FROM   rolling
GROUP  BY "customer_id", month_key
ORDER  BY "customer_id", month_key
LIMIT 20;

-- 9. Description: Identify each customer’s first month (baseline period).
SELECT "customer_id",
       MIN(strftime('%Y-%m', "txn_date")) AS first_month_key
FROM   "customer_transactions"
GROUP  BY "customer_id"
LIMIT 20;

-- 10. Description: Final answer – sum of monthly maxima across customers, after excluding each customer’s first month.
WITH daily AS (
  SELECT "customer_id",
         "txn_date",
         SUM(CASE WHEN "txn_type"='deposit' THEN +1 ELSE -1 END * "txn_amount") AS net_amount
  FROM   "customer_transactions"
  GROUP  BY "customer_id","txn_date"
),
balance AS (
  SELECT "customer_id",
         "txn_date",
         SUM(net_amount) OVER (
             PARTITION BY "customer_id"
             ORDER BY "txn_date"
             ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
         ) AS running_balance
  FROM   daily
),
rolling AS (
  SELECT "customer_id",
         "txn_date",
         CASE 
           WHEN AVG(running_balance) OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "txn_date"
                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                ) < 0 THEN 0
           ELSE AVG(running_balance) OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "txn_date"
                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                )
         END AS rolling_30d_avg_non_neg
  FROM   balance
),
monthly_max AS (
  SELECT "customer_id",
         strftime('%Y-%m', "txn_date") AS month_key,
         MAX(rolling_30d_avg_non_neg) AS max_30d_avg_in_month
  FROM   rolling
  GROUP  BY "customer_id", month_key
),
first_mth AS (
  SELECT "customer_id",
         MIN(month_key) AS first_month_key
  FROM   monthly_max
  GROUP  BY "customer_id"
)
SELECT mm.month_key,
       SUM(mm.max_30d_avg_in_month) AS total_of_max_30d_avgs
FROM   monthly_max AS mm
JOIN   first_mth  AS fm
  ON   mm."customer_id" = fm."customer_id"
WHERE  mm.month_key <> fm.first_month_key          -- exclude baseline month
GROUP  BY mm.month_key
ORDER  BY mm.month_key
LIMIT 20;
