--Description: 10) One‑row summary: average loss rate, variance (σ²), and counts
--               of items BELOW / WITHIN / ABOVE one‑σ band (using variance test).
WITH metrics AS (
    SELECT
        AVG(lr."loss_rate_%")                                                   AS avg_rate,
        (AVG(lr."loss_rate_%"*lr."loss_rate_%") -
         AVG(lr."loss_rate_%")*AVG(lr."loss_rate_%"))                           AS var_rate
    FROM "veg_loss_rate_df" AS lr
    WHERE lr."item_code" IN (SELECT DISTINCT "item_code" FROM "veg_whsle_df")
),
classified AS (
    SELECT CASE
             WHEN ((lr."loss_rate_%" - m.avg_rate)*(lr."loss_rate_%" - m.avg_rate)) <  m.var_rate
                  THEN 'within_1sd'
             WHEN  lr."loss_rate_%" >  m.avg_rate                                THEN 'above_1sd'
             ELSE 'below_1sd'
           END AS band
    FROM "veg_loss_rate_df" AS lr
    JOIN metrics            AS m
    WHERE lr."item_code" IN (SELECT DISTINCT "item_code" FROM "veg_whsle_df")
)
SELECT
    m.avg_rate                                                     AS average_loss_rate,
    m.var_rate                                                     AS variance_loss_rate, -- √var_rate = σ
    SUM(CASE WHEN band = 'below_1sd'  THEN 1 ELSE 0 END)           AS cnt_below_1sd,
    SUM(CASE WHEN band = 'within_1sd' THEN 1 ELSE 0 END)           AS cnt_within_1sd,
    SUM(CASE WHEN band = 'above_1sd'  THEN 1 ELSE 0 END)           AS cnt_above_1sd
FROM   metrics AS m
CROSS JOIN classified
