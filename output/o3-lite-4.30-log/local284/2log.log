```

```sql
-- 3. Inspect the numeric spread of loss rates
SELECT DISTINCT lr."loss_rate_%"
FROM   "veg_loss_rate_df" AS lr
WHERE  lr."item_code" IN (SELECT DISTINCT "item_code" FROM "veg_whsle_df")
ORDER BY lr."loss_rate_%"
LIMIT 20;
```

```sql
-- 4. Compute the average loss rate across wholesale SKUs
SELECT AVG(lr."loss_rate_%") AS avg_loss_rate
FROM   "veg_loss_rate_df" AS lr
WHERE  lr."item_code" IN (SELECT DISTINCT "item_code" FROM "veg_whsle_df");
```

```sql
-- 5. Compute avg of squared values – helper for population stdev
SELECT AVG( (lr."loss_rate_%" * lr."loss_rate_%") ) AS avg_square
FROM   "veg_loss_rate_df" AS lr
WHERE  lr."item_code" IN (SELECT DISTINCT "item_code" FROM "veg_whsle_df");
```

```sql
-- 6. Bring average and stdev together in one CTE
WITH metrics AS (
  SELECT AVG(lr."loss_rate_%")                                            AS avg_rate,
         sqrt( AVG(lr."loss_rate_%"*lr."loss_rate_%") -
               AVG(lr."loss_rate_%")*AVG(lr."loss_rate_%") )              AS sd_rate
  FROM   "veg_loss_rate_df" AS lr
  WHERE  lr."item_code" IN (SELECT DISTINCT "item_code" FROM "veg_whsle_df")
)
SELECT *
FROM   metrics;
```

```sql
-- 7. Classify every wholesale SKU as BELOW / WITHIN / ABOVE one stdev band
WITH metrics AS (
  SELECT AVG(lr."loss_rate_%")                                            AS avg_rate,
         sqrt( AVG(lr."loss_rate_%"*lr."loss_rate_%") -
               AVG(lr."loss_rate_%")*AVG(lr."loss_rate_%") )              AS sd_rate
  FROM   "veg_loss_rate_df" AS lr
  WHERE  lr."item_code" IN (SELECT DISTINCT "item_code" FROM "veg_whsle_df")
)
SELECT lr."item_code",
       lr."item_name",
       lr."loss_rate_%",
       CASE
         WHEN lr."loss_rate_%" <  (m.avg_rate - m.sd_rate) THEN 'BELOW'
         WHEN lr."loss_rate_%" >  (m.avg_rate + m.sd_rate) THEN 'ABOVE'
         ELSE 'WITHIN'
       END AS band
FROM   "veg_loss_rate_df" AS lr
JOIN   metrics AS m
WHERE  lr."item_code" IN (SELECT DISTINCT "item_code" FROM "veg_whsle_df")
LIMIT 20;
```

```sql
-- 8. Count SKUs in each band (final summary part‑1)
WITH metrics AS (
  SELECT AVG(lr."loss_rate_%")                                            AS avg_rate,
         sqrt( AVG(lr."loss_rate_%"*lr."loss_rate_%") -
               AVG(lr."loss_rate_%")*AVG(lr."loss_rate_%") )              AS sd_rate
  FROM   "veg_loss_rate_df" AS lr
  WHERE  lr."item_code" IN (SELECT DISTINCT "item_code" FROM "veg_whsle_df")
),
classified AS (
  SELECT CASE
           WHEN lr."loss_rate_%" <  (m.avg_rate - m.sd_rate) THEN 'BELOW'
           WHEN lr."loss_rate_%" >  (m.avg_rate + m.sd_rate) THEN 'ABOVE'
           ELSE 'WITHIN'
         END AS band
  FROM   "veg_loss_rate_df" AS lr
  JOIN   metrics AS m
  WHERE  lr."item_code" IN (SELECT DISTINCT "item_code" FROM "veg_whsle_df")
)
SELECT band,
       COUNT(*) AS item_count
FROM   classified
GROUP  BY band;
```

```sql
-- 9. List the ‘BELOW’ items (optional detail)
WITH metrics AS (
  SELECT AVG(lr."loss_rate_%")                                            AS avg_rate,
         sqrt( AVG(lr."loss_rate_%"*lr."loss_rate_%") -
               AVG(lr."loss_rate_%")*AVG(lr."loss_rate_%") )              AS sd_rate
  FROM   "veg_loss_rate_df" AS lr
  WHERE  lr."item_code" IN (SELECT DISTINCT "item_code" FROM "veg_whsle_df")
)
SELECT lr."item_code",
       lr."item_name",
       lr."loss_rate_%"
FROM   "veg_loss_rate_df" AS lr
JOIN   metrics AS m
WHERE  lr."item_code" IN (SELECT DISTINCT "item_code" FROM "veg_whsle_df")
  AND   lr."loss_rate_%" < (m.avg_rate - m.sd_rate)
LIMIT 20;
```

```sql
-- 10. Final one‑row report including average, stdev and the three counts
WITH metrics AS (
  SELECT AVG(lr."loss_rate_%")                                            AS avg_rate,
         sqrt( AVG(lr."loss_rate_%"*lr."loss_rate_%") -
               AVG(lr."loss_rate_%")*AVG(lr."loss_rate_%") )              AS sd_rate
  FROM   "veg_loss_rate_df" AS lr
  WHERE  lr."item_code" IN (SELECT DISTINCT "item_code" FROM "veg_whsle_df")
),
classified AS (
  SELECT CASE
           WHEN lr."loss_rate_%" <  (m.avg_rate - m.sd_rate) THEN 'below_1sd'
           WHEN lr."loss_rate_%" >  (m.avg_rate + m.sd_rate) THEN 'above_1sd'
           ELSE 'within_1sd'
         END AS band
  FROM   "veg_loss_rate_df" AS lr
  JOIN   metrics AS m
  WHERE  lr."item_code" IN (SELECT DISTINCT "item_code" FROM "veg_whsle_df")
)
SELECT m.avg_rate                                       AS average_loss_rate,
       m.sd_rate                                        AS std_dev_loss_rate,
       SUM(CASE WHEN band='below_1sd'  THEN 1 ELSE 0 END) AS cnt_below_1sd,
       SUM(CASE WHEN band='within_1sd' THEN 1 ELSE 0 END) AS cnt_within_1sd,
       SUM(CASE WHEN band='above_1sd'  THEN 1 ELSE 0 END) AS cnt_above_1sd
FROM   metrics AS m,
       classified;
```

Running query 10 will directly give the requested summary:  
 • overall average loss rate  
 • population standard deviation  
 • counts of wholesale SKUs whose loss rates are below, within, and above one standard deviation of the mean.
