```sql
--Description / thinking process (inline):
--  • We need one figure for the “average” loss rate and one for “spread”.
--    Since sqrt() isn’t available we calculate the population variance instead;
--    the caller can take √variance outside SQL if they need the standard deviation.
--  • We restrict the analysis to items that are present in the wholesale table.
--  • We first derive two numbers (avg_rate, var_rate) in CTE metrics.
--  • Using those two numbers we classify every SKU as
--        BELOW  : lower than   avg_rate – √var_rate
--        WITHIN : between     avg_rate ± √var_rate   (implemented as (x‑μ)² < σ²)
--        ABOVE  : higher than  avg_rate + √var_rate
--    because σ² = var_rate and (x‑μ)² < σ² avoids the missing √.
--  • Finally we aggregate counts of SKUs in each band and output a one‑row report.

WITH metrics AS (
    SELECT
        AVG(lr."loss_rate_%")                                                    AS avg_rate,
        (AVG(lr."loss_rate_%" * lr."loss_rate_%")
         - AVG(lr."loss_rate_%") * AVG(lr."loss_rate_%"))                        AS var_rate
    FROM "veg_loss_rate_df" AS lr
    WHERE lr."item_code" IN (SELECT DISTINCT "item_code" FROM "veg_whsle_df")
),
classified AS (
    SELECT
        CASE
            WHEN ((lr."loss_rate_%" - m.avg_rate) * (lr."loss_rate_%" - m.avg_rate)) < m.var_rate
                 THEN 'WITHIN'
            WHEN lr."loss_rate_%" > m.avg_rate                                    THEN 'ABOVE'
            ELSE 'BELOW'
        END AS band
    FROM "veg_loss_rate_df" AS lr
    JOIN metrics AS m
    WHERE lr."item_code" IN (SELECT DISTINCT "item_code" FROM "veg_whsle_df")
)
SELECT
    m.avg_rate                                   AS average_loss_rate,
    m.var_rate                                   AS variance_loss_rate,     -- √var_rate = σ
    SUM(CASE WHEN c.band = 'BELOW'  THEN 1 ELSE 0 END) AS items_below_1sd,
    SUM(CASE WHEN c.band = 'WITHIN' THEN 1 ELSE 0 END) AS items_within_1sd,
    SUM(CASE WHEN c.band = 'ABOVE'  THEN 1 ELSE 0 END) AS items_above_1sd
FROM metrics AS m
CROSS JOIN classified AS c;
```
