--Description: Return up to 20 vegetables whose loss‑rate (%) falls within one
--             population standard deviation (σ) of the overall mean (μ).
--             Because SQRT/EXP/LOG are unavailable in this SQLite build, the
--             square‑root is approximated via Newton‑Raphson:
--                 g₀ = σ²/2,  gₖ₊₁ = (gₖ + σ² / gₖ) / 2   (20 iterations → convergence).
--             Steps:
--               1. stats      – compute μ = AVG(x) and E[x²] = AVG(x²).
--               2. variance   – derive σ² = E[x²] − μ² and keep μ.
--               3. sqrt_iter  – iterative square‑root to obtain σ.
--               4. final_stats– final μ and σ.
--               5. main SELECT– items with loss‑rate between μ − σ and μ + σ.
WITH stats AS (
    SELECT
        AVG("loss_rate_%")                   AS avg_lr,
        AVG("loss_rate_%" * "loss_rate_%")   AS mean_sq_lr
    FROM veg_loss_rate_df
),
variance AS (
    SELECT (mean_sq_lr - avg_lr * avg_lr) AS var,
           avg_lr
    FROM   stats
),
sqrt_iter(step, estimate) AS (
    SELECT 0, var / 2.0 FROM variance               -- initial guess g₀
    UNION ALL
    SELECT step + 1,
           (estimate + variance.var / estimate) / 2.0
    FROM   sqrt_iter
    JOIN   variance ON 1 = 1
    WHERE  step < 20                                -- 20 iterations
),
final_stats AS (
    SELECT variance.avg_lr  AS avg_lr,
           sqrt_iter.estimate AS std_lr
    FROM   sqrt_iter
    CROSS  JOIN variance
    ORDER  BY sqrt_iter.step DESC
    LIMIT 1
)
SELECT DISTINCT
       v."item_code",
       v."item_name",
       v."loss_rate_%"
FROM   veg_loss_rate_df AS v,
       final_stats
WHERE  v."loss_rate_%" BETWEEN (final_stats.avg_lr - final_stats.std_lr)
                           AND (final_stats.avg_lr + final_stats.std_lr)
LIMIT 20;
```
