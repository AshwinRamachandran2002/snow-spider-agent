           avg_lr
    FROM   stats
),
sqrt_iter(step, estimate) AS (
    SELECT 0, var / 2.0            FROM variance
    UNION ALL
    SELECT step + 1,
           (estimate + variance.var / estimate) / 2.0
    FROM   sqrt_iter
    JOIN   variance
    ON     1 = 1
    WHERE  step < 20
),
final_stats AS (
    SELECT avg_lr,
           estimate AS std_lr
    FROM   sqrt_iter
    ORDER  BY step DESC
    LIMIT 1
)
SELECT DISTINCT v."item_code",
       v."item_name",
       c."category_name",
       v."loss_rate_%"
FROM   veg_loss_rate_df AS v
LEFT   JOIN veg_cat      AS c ON v."item_code" = c."item_code",
       final_stats
