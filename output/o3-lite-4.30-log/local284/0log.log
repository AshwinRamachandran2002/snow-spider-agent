Query:
--Description: Query 9 — list up to 20 vegetables (with category) whose loss‑rate
--             is within ±1 σ of the population mean μ, where σ is approximated
--             via Newton‑Raphson (20 iterations) because SQRT/EXP/LOG are absent.
--             Steps:
--               1. stats      → μ and E[x²];  2. variance → σ² = E[x²] − μ².
--               3. sqrt_iter  → Newton iterations to obtain σ.
--               4. final_stats→ final μ (avg_lr) and σ (std_lr).
--               5. main SELECT→ items satisfying μ − σ ≤ loss_rate_% ≤ μ + σ,
--                               plus their category from veg_cat.
WITH stats AS (
    SELECT
        AVG("loss_rate_%")                   AS avg_lr,
        AVG("loss_rate_%" * "loss_rate_%")   AS mean_sq_lr
    FROM veg_loss_rate_df
),
variance AS (
    SELECT (mean_sq_lr - avg_lr * avg_lr) AS var,
           avg_lr
    FROM   stats
),
sqrt_iter(step, estimate) AS (
    SELECT 0, var / 2.0 FROM variance               -- initial guess g₀
    UNION ALL
    SELECT step + 1,
           (estimate + variance.var / estimate) / 2.0
    FROM   sqrt_iter
    JOIN   variance ON 1 = 1
    WHERE  step < 20                                -- 20 iterations give convergence
),
final_stats AS (
    SELECT variance.avg_lr        AS avg_lr,
           sqrt_iter.estimate     AS std_lr
    FROM   sqrt_iter
    CROSS  JOIN variance
    ORDER  BY sqrt_iter.step DESC
    LIMIT 1
)
SELECT DISTINCT
       v."item_code",
       v."item_name",
       c."category_name",
       v."loss_rate_%"
FROM   veg_loss_rate_df AS v
LEFT   JOIN veg_cat      AS c ON v."item_code" = c."item_code",
       final_stats
WHERE  v."loss_rate_%" BETWEEN (final_stats.avg_lr - final_stats.std_lr)
                           AND (final_stats.avg_lr + final_stats.std_lr)
LIMIT 20
Answer:
item_code,item_name,category_name,loss_rate_%
