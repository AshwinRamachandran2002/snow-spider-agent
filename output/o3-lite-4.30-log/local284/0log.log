```sql
--Description: Query 8 — list up to 20 items whose loss‑rate lies within ±1 σ of the mean.
-- 1. stats        : mean μ and variance σ² = E[x²] − μ².  
-- 2. sqrt_iter    : Newton–Raphson sequence to approximate σ (=√σ²) in 20 iterations.  
-- 3. final_stats  : pick the converged σ (std_lr) and μ (avg_lr).  
-- 4. main SELECT  : return items having loss‑rate between μ − σ and μ + σ.
WITH stats AS (
    SELECT
        AVG("loss_rate_%")                      AS avg_lr,
        AVG("loss_rate_%" * "loss_rate_%")      AS mean_sq_lr
    FROM veg_loss_rate_df
),
variance AS (
    SELECT (mean_sq_lr - avg_lr * avg_lr) AS var,
           avg_lr
    FROM   stats
),
sqrt_iter(step, estimate) AS (
    SELECT 0, var / 2.0            FROM variance
    UNION ALL
    SELECT step + 1,
           (estimate + variance.var / estimate) / 2.0
    FROM   sqrt_iter
    JOIN   variance
    ON     1 = 1
    WHERE  step < 20
),
final_stats AS (
    SELECT avg_lr,
           estimate AS std_lr
    FROM   sqrt_iter
    ORDER  BY step DESC
    LIMIT 1
)
SELECT DISTINCT v."item_code",
       v."item_name",
       v."loss_rate_%"
FROM   veg_loss_rate_df AS v,
       final_stats
WHERE  v."loss_rate_%" BETWEEN (final_stats.avg_lr - final_stats.std_lr)
                           AND (final_stats.avg_lr + final_stats.std_lr)
LIMIT 20;
```

