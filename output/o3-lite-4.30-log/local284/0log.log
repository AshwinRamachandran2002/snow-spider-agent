           sqrt_iter.estimate AS std_lr
    FROM   sqrt_iter
    CROSS  JOIN variance
    ORDER  BY sqrt_iter.step DESC
    LIMIT 1
)
SELECT
       ROUND(final_stats.avg_lr, 2) AS avg_loss_rate_pct,
