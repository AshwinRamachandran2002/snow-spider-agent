```sql
--Description: Compute the population standard deviation of veg_loss_rate_df."loss_rate_%"
--             without any unavailable math functions (SQRT, EXP, LOG, POW).
--             Steps:
--               1. stats CTE   : mean μ = AVG(x) and mean of squares E[x²] = AVG(x²).
--               2. variance CTE: σ² = E[x²] − μ².
--               3. sqrt_iter   : apply Newton–Raphson to approximate √σ²:
--                               g₀ = σ² / 2, gₖ₊₁ = (gₖ + σ² / gₖ) / 2.
--                               Run 20 iterations for convergence.
--               4. Return the final estimate (standard deviation) rounded to 2 d.p.

WITH stats AS (
    SELECT
        AVG("loss_rate_%")                      AS mean_lr,
        AVG("loss_rate_%" * "loss_rate_%")      AS mean_sq_lr
    FROM veg_loss_rate_df
),
variance AS (
    SELECT (mean_sq_lr - mean_lr * mean_lr) AS var
    FROM   stats
),
sqrt_iter(step, estimate) AS (
    SELECT 0, var / 2.0          -- initial guess g0
    FROM   variance
    UNION ALL
    SELECT step + 1,
           (estimate + variance.var / estimate) / 2.0  -- Newton step
    FROM   sqrt_iter
    CROSS  JOIN variance
    WHERE  step < 20            -- 20 iterations
)
SELECT ROUND(estimate, 2) AS std_dev_loss_rate_pct
FROM   sqrt_iter
ORDER  BY step DESC
LIMIT 1;
```
