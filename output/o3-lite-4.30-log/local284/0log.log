```sql
--Description: Query 10 — final summary: mean loss‑rate, standard deviation, and
--             counts of items below (μ−σ), within [μ−σ, μ+σ], and above (μ+σ).
WITH stats AS (
    SELECT
        AVG("loss_rate_%")                      AS avg_lr,
        AVG("loss_rate_%" * "loss_rate_%")      AS mean_sq_lr
    FROM veg_loss_rate_df
),
variance AS (
    SELECT (mean_sq_lr - avg_lr * avg_lr) AS var,
           avg_lr
    FROM   stats
),
sqrt_iter(step, estimate) AS (
    SELECT 0, var / 2.0            FROM variance
    UNION ALL
    SELECT step + 1,
           (estimate + variance.var / estimate) / 2.0
    FROM   sqrt_iter
    JOIN   variance
    ON     1 = 1
    WHERE  step < 20
),
final_stats AS (
    SELECT avg_lr,
           estimate AS std_lr
    FROM   sqrt_iter
    ORDER  BY step DESC
    LIMIT 1
)
SELECT
       ROUND(final_stats.avg_lr, 2) AS avg_loss_rate_pct,
       ROUND(final_stats.std_lr, 2) AS std_dev_pct,
       SUM( CASE WHEN v."loss_rate_%" <  final_stats.avg_lr - final_stats.std_lr THEN 1 END ) AS cnt_below_1std,
       SUM( CASE WHEN v."loss_rate_%" BETWEEN final_stats.avg_lr - final_stats.std_lr
                                          AND   final_stats.avg_lr + final_stats.std_lr THEN 1 END ) AS cnt_within_1std,
       SUM( CASE WHEN v."loss_rate_%" >  final_stats.avg_lr + final_stats.std_lr THEN 1 END ) AS cnt_above_1std
FROM   veg_loss_rate_df AS v
CROSS  JOIN final_stats;
