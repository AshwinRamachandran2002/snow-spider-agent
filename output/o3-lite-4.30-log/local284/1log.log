```sql
--Description: Query 8 (z‑scores) – replicate the original logic without relying on a built‑in SQRT.
-- 1️⃣ stats:   mean (μ) and mean of squares (E[x²]).
-- 2️⃣ var_cte: population variance σ² = E[x²] − μ².
-- 3️⃣ nr:      Newton‑Raphson recursion that converges on √σ².
-- 4️⃣ sd:      pick the most accurate guess (LIMIT 1) as σ.
-- 5️⃣ Return each item with its z‑score = (x − μ) / σ.  LIMIT 20.
WITH stats AS (
    SELECT
        AVG("loss_rate_%")                       AS mean_x,
        AVG("loss_rate_%" * "loss_rate_%")       AS mean_x2
    FROM "veg_loss_rate_df"
),
var_cte AS (
    SELECT (mean_x2 - mean_x * mean_x) AS variance
    FROM stats
),
nr(var, guess) AS (
    SELECT variance, variance / 2.0
    FROM var_cte
    UNION ALL
    SELECT
        var,
        (guess + var / guess) / 2.0
    FROM nr
    WHERE ABS(guess * guess - var) > 0.000001
),
sd AS (
    SELECT guess AS sigma
    FROM nr
    ORDER BY ABS(guess * guess - var)
    LIMIT 1
)
SELECT  v."item_code",
        v."item_name",
        v."loss_rate_%",
        ROUND( (v."loss_rate_%" - stats.mean_x) / sd.sigma , 2) AS z_score
FROM "veg_loss_rate_df" v
CROSS JOIN stats
CROSS JOIN sd
LIMIT 20;
```

