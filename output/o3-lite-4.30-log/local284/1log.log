```sql
--Description: ❶ Compute the mean (μ) and the mean of squares (E[x²]) of "loss_rate_%"
--               in CTE stats. ❷ Derive the population variance σ² = E[x²] − μ²
--               inside variance_cte. ❸ Because this SQLite build lacks SQRT,
--               use a recursive CTE (nr) to approximate √σ² via Newton‑Raphson:
--                  new_guess = (old_guess + σ² / old_guess) / 2
--               The recursion stops once |guess² − σ²| < 1e‑6, and the closest
--               guess is rounded to two decimals to yield the standard deviation.
WITH stats AS (
    SELECT
        AVG("loss_rate_%")                      AS mean_x,
        AVG("loss_rate_%" * "loss_rate_%")      AS mean_x2
    FROM "veg_loss_rate_df"
),
variance_cte AS (
    SELECT (mean_x2 - mean_x * mean_x) AS variance
    FROM stats
),
nr(var, guess) AS (
    SELECT variance, variance / 2.0            -- seed guess = σ² / 2
    FROM variance_cte
    UNION ALL
    SELECT
        var,
        (guess + var / guess) / 2.0            -- Newton‑Raphson update
    FROM nr
    WHERE ABS(guess * guess - var) > 0.000001  -- convergence check
)
SELECT ROUND(guess, 2) AS stddev_loss_rate
FROM nr
ORDER BY ABS(guess * guess - var)             -- smallest error → best guess
LIMIT 1;
```
