```sql
--Description: 1) In CTE “stats” we calculate the overall mean (avg_loss) and
--               population standard deviation (sd) of "loss_rate_%".
--            2) In the final SELECT we:
--                 • return the rounded mean and std‑dev,
--                 • count items whose loss rate is
--                     – below one sd (avg_loss − sd),
--                     – above one sd (avg_loss + sd),
--                     – and within that range.
--            3) We CROSS‑JOIN the table with “stats” so every row can
--               reference the same aggregate values while we tally.
WITH stats AS (
    SELECT
        AVG("loss_rate_%")                                             AS avg_loss,
        sqrt(AVG("loss_rate_%"
                 * "loss_rate_%") - AVG("loss_rate_%")*AVG("loss_rate_%")) AS sd
    FROM "veg_loss_rate_df"
)
SELECT
    ROUND(stats.avg_loss, 2)                                           AS avg_loss_rate,
    ROUND(stats.sd, 2)                                                 AS stddev_loss_rate,
    SUM(CASE WHEN v."loss_rate_%" <  stats.avg_loss - stats.sd THEN 1 END) AS cnt_below_1sd,
    SUM(CASE WHEN v."loss_rate_%" >  stats.avg_loss + stats.sd THEN 1 END) AS cnt_above_1sd,
    SUM(CASE WHEN v."loss_rate_%" BETWEEN stats.avg_loss - stats.sd
                                    AND     stats.avg_loss + stats.sd THEN 1 END) AS cnt_within_1sd
FROM "veg_loss_rate_df" v
CROSS JOIN stats;
