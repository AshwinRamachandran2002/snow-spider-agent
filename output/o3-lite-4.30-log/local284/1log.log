Begin Exploring Related Columns
Relevant tables, columns and why they matter  
• veg_loss_rate_df."item_code": primary key ­– lets us count how many distinct products we have.  
• veg_loss_rate_df."item_name": friendly description of the product (optional for the maths but useful to inspect).  
• veg_loss_rate_df."loss_rate_%": numeric field we must summarise (average, st‑dev and banding).  
Possible condition we may need:  
• WHERE "loss_rate_%" IS NOT NULL – make sure we exclude nulls (dataset sample shows none but it is safe).

Below are ten exploratory → analytical SELECT queries (all different, each with DISTINCT where helpful, each capped with LIMIT 20 unless the result set is intrinsically one row).  
They build up from simple inspection to the final answer.

```sql
-- 1. Peek at the first 20 loss‑rate records
SELECT "item_code",
       "item_name",
       "loss_rate_%"
FROM "veg_loss_rate_df"
LIMIT 20;
```

```sql
-- 2. View all distinct loss‑rate percentages that occur (rounded) – quick sanity check
SELECT DISTINCT ROUND("loss_rate_%",2) AS rounded_loss_rate
FROM "veg_loss_rate_df"
ORDER BY rounded_loss_rate
LIMIT 20;
```

```sql
-- 3. Count of unique items in the loss‑rate table
SELECT COUNT(DISTINCT "item_code") AS distinct_items
FROM "veg_loss_rate_df";
```

```sql
-- 4. Minimum and maximum loss rates observed
SELECT MIN("loss_rate_%") AS min_loss_rate,
       MAX("loss_rate_%") AS max_loss_rate
FROM "veg_loss_rate_df";
```

```sql
-- 5. Simple average loss rate (1 row)
SELECT AVG("loss_rate_%") AS avg_loss_rate
FROM "veg_loss_rate_df";
```

```sql
-- 6. Variance helper – average of the squared loss rate values
SELECT AVG("loss_rate_%"
          *"loss_rate_%") AS avg_of_squares
FROM "veg_loss_rate_df";
```

```sql
-- 7. Compute the (population) standard deviation in SQLite
WITH stats AS (
  SELECT AVG("loss_rate_%")                              AS avg_loss,
         AVG("loss_rate_%"
             *"loss_rate_%")                             AS avg_sq
  FROM "veg_loss_rate_df"
)
SELECT ROUND(
       SQRT(stats.avg_sq - stats.avg_loss*stats.avg_loss),2) AS stddev_loss_rate
FROM stats;
```

```sql
-- 8. Show every item together with its z‑score to verify the spread
WITH stats AS (
  SELECT AVG("loss_rate_%")                              AS avg_loss,
         SQRT(AVG("loss_rate_%"
                  *"loss_rate_%") -
               AVG("loss_rate_%")*AVG("loss_rate_%"))    AS sd
  FROM "veg_loss_rate_df"
)
SELECT v."item_code",
       v."item_name",
       v."loss_rate_%" ,
       ROUND( (v."loss_rate_%"-stats.avg_loss)/stats.sd ,2) AS z_score
FROM "veg_loss_rate_df" v
CROSS JOIN stats
LIMIT 20;
```

```sql
-- 9. Count how many items sit below / above one st‑dev (two separate numbers)
WITH stats AS (
  SELECT AVG("loss_rate_%")                              AS avg_loss,
         SQRT(AVG("loss_rate_%"
                  *"loss_rate_%") -
               AVG("loss_rate_%")*AVG("loss_rate_%"))    AS sd
  FROM "veg_loss_rate_df"
)
SELECT SUM(CASE WHEN v."loss_rate_%" < stats.avg_loss - stats.sd THEN 1 END) AS below_one_sd,
       SUM(CASE WHEN v."loss_rate_%" > stats.avg_loss + stats.sd THEN 1 END) AS above_one_sd
FROM "veg_loss_rate_df" v
CROSS JOIN stats;
```

```sql
-- 10. FINAL ANSWER ▸ average loss rate, the st‑dev and the item‑count split
WITH stats AS (
  SELECT AVG("loss_rate_%")                              AS avg_loss,
         SQRT(AVG("loss_rate_%"
                  *"loss_rate_%") -
               AVG("loss_rate_%")*AVG("loss_rate_%"))    AS sd
  FROM "veg_loss_rate_df"
)
SELECT ROUND(stats.avg_loss,2)                                            AS avg_loss_rate,
       ROUND(stats.sd,2)                                                  AS stddev_loss_rate,
       SUM(CASE WHEN v."loss_rate_%" <  stats.avg_loss - stats.sd THEN 1 END) AS cnt_below_1sd,
       SUM(CASE WHEN v."loss_rate_%" >  stats.avg_loss + stats.sd THEN 1 END) AS cnt_above_1sd,
       SUM(CASE WHEN v."loss_rate_%" BETWEEN stats.avg_loss - stats.sd
                                         AND     stats.avg_loss + stats.sd THEN 1 END) AS cnt_within_1sd
FROM "veg_loss_rate_df" v
CROSS JOIN stats;
```

