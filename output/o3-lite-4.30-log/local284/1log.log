--Description: Query 9 (counts below / above one σ) – replaces SQRT with Newton‑Raphson.
-- 1️⃣ stats / var_cte / nr / sd as before to obtain μ and σ.
-- 2️⃣ Tally items that fall below μ−σ and above μ+σ.
WITH stats AS (
    SELECT
        AVG("loss_rate_%")                       AS mean_x,
        AVG("loss_rate_%" * "loss_rate_%")       AS mean_x2
    FROM "veg_loss_rate_df"
),
var_cte AS (
    SELECT (mean_x2 - mean_x * mean_x) AS variance
    FROM stats
),
nr(var, guess) AS (
    SELECT variance, variance / 2.0
    FROM var_cte
    UNION ALL
    SELECT
        var,
        (guess + var / guess) / 2.0
    FROM nr
    WHERE ABS(guess * guess - var) > 0.000001
),
sd AS (
    SELECT guess AS sigma
    FROM nr
    ORDER BY ABS(guess * guess - var)
    LIMIT 1
)
SELECT
    SUM(CASE WHEN v."loss_rate_%" <  stats.mean_x - sd.sigma THEN 1 END) AS below_one_sd,
    SUM(CASE WHEN v."loss_rate_%" >  stats.mean_x + sd.sigma THEN 1 END) AS above_one_sd
FROM "veg_loss_rate_df" v
CROSS JOIN stats
CROSS JOIN sd
