Query:
--Description: Query 10 (final summary) – delivers average loss rate, σ, and item counts
--             below / within / above one σ, using the same Newton‑Raphson workaround.
WITH stats AS (
    SELECT
        AVG("loss_rate_%")                       AS mean_x,
        AVG("loss_rate_%" * "loss_rate_%")       AS mean_x2
    FROM "veg_loss_rate_df"
),
var_cte AS (
    SELECT (mean_x2 - mean_x * mean_x) AS variance
    FROM stats
),
nr(var, guess) AS (
    SELECT variance, variance / 2.0
    FROM var_cte
    UNION ALL
    SELECT
        var,
        (guess + var / guess) / 2.0
    FROM nr
    WHERE ABS(guess * guess - var) > 0.000001
),
sd AS (
    SELECT guess AS sigma
    FROM nr
    ORDER BY ABS(guess * guess - var)
    LIMIT 1
)
SELECT
    ROUND(stats.mean_x, 2)                                            AS avg_loss_rate,
    ROUND(sd.sigma, 2)                                                AS stddev_loss_rate,
    SUM(CASE WHEN v."loss_rate_%" <  stats.mean_x - sd.sigma THEN 1 END) AS cnt_below_1sd,
    SUM(CASE WHEN v."loss_rate_%" >  stats.mean_x + sd.sigma THEN 1 END) AS cnt_above_1sd,
    SUM(CASE WHEN v."loss_rate_%" BETWEEN stats.mean_x - sd.sigma
                                      AND     stats.mean_x + sd.sigma THEN 1 END) AS cnt_within_1sd
FROM "veg_loss_rate_df" v
CROSS JOIN stats
CROSS JOIN sd
