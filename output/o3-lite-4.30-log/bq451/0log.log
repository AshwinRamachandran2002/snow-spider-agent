    `genomics-public-data.1000_genomes.variants`,
    UNNEST(call) AS c
  WHERE
    reference_name = 'X'              -- focus on chromosome X
    AND ARRAY_LENGTH(c.genotype) > 0  -- keep only callable genotypes
