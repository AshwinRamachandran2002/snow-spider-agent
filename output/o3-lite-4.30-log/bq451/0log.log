```sql
--Description: One self‑contained statement that completes the entire assignment, with
--             inline comments explaining the reasoning (“thinking process”) step by step.
--             1) Work on chromosome X only and exclude the two pseudo‑autosomal regions.
--             2) Keep true single‑nucleotide polymorphisms: 1‑bp ref, exactly one 1‑bp alt.
--             3) Explode the `call` array to obtain one row per sample per variant.
--             4) Retain rows whose `genotype` array is non‑empty → “callable” sites.
--             5) Classify each genotype into hom_ref, hom_alt, or het.
--             6) Aggregate counts per sample, derive callable_sites & snv_sites.
--             7) Compute required percentages and order results as specified.
SELECT
  sample_id,
  callable_sites,
  hom_ref,
  hom_alt,
  het,
  snv_sites,
  SAFE_DIVIDE(het, snv_sites)     * 100 AS pct_het_in_snv,      -- % heterozygous among SNVs
  SAFE_DIVIDE(hom_alt, snv_sites) * 100 AS pct_hom_alt_in_snv   -- % homo‑alt among SNVs
FROM (
  /* Aggregate genotype categories per sample */
  SELECT
    c.call_set_name                               AS sample_id,
    COUNT(*)                                      AS callable_sites,
    COUNTIF(gt_type = 'hom_ref')                  AS hom_ref,
    COUNTIF(gt_type = 'hom_alt')                  AS hom_alt,
    COUNTIF(gt_type = 'het')                      AS het,
    COUNTIF(gt_type IN ('hom_alt', 'het'))        AS snv_sites
  FROM (
    /* Classify every callable genotype after all filters */
    SELECT
      c.call_set_name,
      CASE
        WHEN ARRAY_LENGTH(c.genotype) = 2
             AND c.genotype[OFFSET(0)] = 0
             AND c.genotype[OFFSET(1)] = 0
          THEN 'hom_ref'                                            -- both alleles reference
        WHEN ARRAY_LENGTH(c.genotype) = 2
             AND c.genotype[OFFSET(0)] = c.genotype[OFFSET(1)]
             AND c.genotype[OFFSET(0)] > 0
          THEN 'hom_alt'                                            -- both identical alt alleles
        ELSE 'het'                                                  -- any other non‑ref pattern
      END AS gt_type
    FROM `spider2-public-data.1000_genomes.variants`,
         UNNEST(call) AS c
    WHERE
      reference_name = 'X'                                          -- chr X only
      AND start NOT BETWEEN  59999     AND  2699519                 -- exclude PAR1
      AND start NOT BETWEEN 154931042  AND 155260559                -- exclude PAR2
      AND ARRAY_LENGTH(alternate_bases) = 1                         -- exactly one alt allele
      AND LENGTH(reference_bases) = 1                               -- 1‑bp reference
      AND LENGTH(alternate_bases[OFFSET(0)]) = 1                    -- 1‑bp alternate
      AND ARRAY_LENGTH(c.genotype) > 0                              -- callable genotype
  )
  GROUP BY sample_id
)
ORDER BY pct_het_in_snv DESC, sample_id;   -- final ordering requirement
