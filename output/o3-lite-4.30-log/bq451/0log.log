Query:
--Description: For a limited subset (first 1 000 calls) on chromosome X, count how
--             many hom_ref, hom_alt, and het genotypes each sample has in the
--             public `genomics-public-data.1000_genomes.variants` table.
SELECT
  sample,
  COUNTIF(gt_type = 'hom_ref') AS hom_ref,
  COUNTIF(gt_type = 'hom_alt') AS hom_alt,
  COUNTIF(gt_type = 'het')     AS het
FROM (
  SELECT
    c.call_set_name AS sample,
    CASE
      WHEN (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) AS a) = 1
           AND c.genotype[OFFSET(0)] = 0
        THEN 'hom_ref'
      WHEN (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) AS a) = 1
           AND c.genotype[OFFSET(0)] > 0
        THEN 'hom_alt'
      ELSE 'het'
    END AS gt_type
  FROM
    `genomics-public-data.1000_genomes.variants`,
    UNNEST(call) AS c
  WHERE
    reference_name = 'X'
    AND ARRAY_LENGTH(c.genotype) > 0
  LIMIT 1000
)
GROUP BY
  sample
LIMIT 20
