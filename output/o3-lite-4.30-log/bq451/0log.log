```sql
--Description: End‑to‑end solution on the public table
--             `genomics-public-data.1000_genomes.variants`.  Filters chromosome X,
--             removes pseudo‑autosomal regions, keeps only true SNPs, classifies
--             genotypes, aggregates per sample, and computes percentages.  Results
--             are ordered by % heterozygous among SNVs.
SELECT
  sample_id                                                       AS sample,
  callable_sites,
  hom_ref,
  hom_alt,
  het,
  snv_sites,
  SAFE_DIVIDE(het,     snv_sites) * 100 AS pct_het_in_snv,
  SAFE_DIVIDE(hom_alt, snv_sites) * 100 AS pct_hom_alt_in_snv
FROM (
  SELECT
    c.call_set_name                                   AS sample_id,
    COUNT(*)                                          AS callable_sites,
    COUNTIF(gt_type = 'hom_ref')                      AS hom_ref,
    COUNTIF(gt_type = 'hom_alt')                      AS hom_alt,
    COUNTIF(gt_type = 'het')                          AS het,
    COUNTIF(gt_type IN ('hom_alt','het'))             AS snv_sites
  FROM (
    /* Classify every callable genotype that passes all filters */
    SELECT
      c.call_set_name,
      CASE
        WHEN ARRAY_LENGTH(c.genotype) = 2
             AND c.genotype[OFFSET(0)] = 0
             AND c.genotype[OFFSET(1)] = 0
          THEN 'hom_ref'
        WHEN ARRAY_LENGTH(c.genotype) = 2
             AND c.genotype[OFFSET(0)] = c.genotype[OFFSET(1)]
             AND c.genotype[OFFSET(0)] > 0
          THEN 'hom_alt'
        ELSE 'het'
      END AS gt_type
    FROM
      `genomics-public-data.1000_genomes.variants`,
      UNNEST(call) AS c
    WHERE
      reference_name = 'X'
      AND start NOT BETWEEN  59999     AND   2699519    -- exclude PAR1
      AND start NOT BETWEEN 154931042  AND 155260559    -- exclude PAR2
      AND ARRAY_LENGTH(alternate_bases) = 1             -- single alt allele
      AND LENGTH(reference_bases)       = 1             -- 1‑bp ref
      AND LENGTH(alternate_bases[OFFSET(0)]) = 1        -- 1‑bp alt
      AND ARRAY_LENGTH(c.genotype) > 0                  -- callable genotype
  )
  GROUP BY
    sample_id
)
ORDER BY
  pct_het_in_snv DESC,
  sample;
