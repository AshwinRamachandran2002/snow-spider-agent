Query:
--Description: Classify a small sample of genotype calls from the public
--             `genomics-public-data.1000_genomes.variants` table into hom_ref,
--             hom_alt, and het on chromosome X, showing 20 example rows.
SELECT
  c.call_set_name AS sample,
  c.genotype      AS gt,
  CASE
    WHEN (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) AS a) = 1
         AND c.genotype[OFFSET(0)] = 0
      THEN 'hom_ref'
    WHEN (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) AS a) = 1
         AND c.genotype[OFFSET(0)] > 0
      THEN 'hom_alt'
    ELSE 'het'
  END AS gt_type
FROM
  `genomics-public-data.1000_genomes.variants`,
  UNNEST(call) AS c
WHERE
  reference_name = 'X'
  AND ARRAY_LENGTH(c.genotype) > 0
LIMIT 20
