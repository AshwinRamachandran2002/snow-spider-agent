Query:
--Description: Count how many alleles appear in each genotype array (sanity check) on
--             chromosome X, using the publicly accessible table
--             `genomics-public-data.1000_genomes.variants`.  We unnest the `call`
--             array, group by the length of each `genotype` array, and show the first
--             20 results.
SELECT
  ARRAY_LENGTH(c.genotype) AS alleles_per_gt,
  COUNT(*)                 AS n_rows
FROM
  `genomics-public-data.1000_genomes.variants`,
  UNNEST(call) AS c
WHERE
  reference_name = 'X'
GROUP BY
  alleles_per_gt
ORDER BY
  alleles_per_gt
LIMIT 20
