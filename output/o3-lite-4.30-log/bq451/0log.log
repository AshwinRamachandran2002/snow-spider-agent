FROM `spider2-public-data.1000_genomes.variants`, UNNEST(call) AS c
WHERE reference_name = 'X'
GROUP BY alleles_per_gt
ORDER BY alleles_per_gt
LIMIT 20;
```

```sql
-- 4. Rows that fall inside the two regions we must exclude (for QA)
SELECT start
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = 'X'
  AND ( (start BETWEEN 59999 AND 2699519)
     OR (start BETWEEN 154931042 AND 155260559) )
LIMIT 20;
```

```sql
-- 5. Validate that our SNP filter keeps only single‑nucleotide changes
SELECT reference_bases, alternate_bases
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = 'X'
  AND ARRAY_LENGTH(alternate_bases) = 1
  AND LENGTH(reference_bases) = 1
  AND LENGTH(alternate_bases[OFFSET(0)]) = 1
LIMIT 20;
```

```sql
-- 6. Classify each genotype call (small sample)
SELECT
  c.call_set_name AS sample,
  c.genotype AS gt,
  CASE
    WHEN (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) AS a) = 1
         AND c.genotype[OFFSET(0)] = 0
      THEN 'hom_ref'
    WHEN (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) AS a) = 1
         AND c.genotype[OFFSET(0)] > 0
      THEN 'hom_alt'
    ELSE 'het'
  END AS gt_type
FROM `spider2-public-data.1000_genomes.variants`, UNNEST(call) AS c
WHERE reference_name = 'X'
  AND ARRAY_LENGTH(c.genotype) > 0
LIMIT 20;
```

```sql
