           AND (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) a) = 1
           AND c.genotype[OFFSET(0)] > 0
        THEN 'hom_alt'                         -- homozygous alternate
      ELSE 'het'                               -- heterozygous
    END AS gt_type
