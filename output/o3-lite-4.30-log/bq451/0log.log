Query:
--Description: Build complete per‑sample counts and percentage metrics on chromosome X.
--             1) per_call CTE  – unnest `call`, classify each genotype as hom_ref,
--                hom_alt, or het.
--             2) per_sample    – aggregate counts per sample.
--             3) final SELECT  – compute
--                   callable_sites = hom_ref + hom_alt + het
--                   snv_sites      = hom_alt + het
--                   pct_het_in_snv and pct_hom_alt_in_snv,
--                then order by pct_het_in_snv (desc) & sample.  Only 20 rows shown.
WITH per_call AS (
  SELECT
    c.call_set_name AS sample,
    CASE
      WHEN ARRAY_LENGTH(c.genotype) > 0
           AND (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) a) = 1
           AND c.genotype[OFFSET(0)] = 0                                   THEN 'hom_ref'
      WHEN ARRAY_LENGTH(c.genotype) > 0
           AND (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) a) = 1
           AND c.genotype[OFFSET(0)] > 0                                   THEN 'hom_alt'
      ELSE 'het'
    END AS gt_type
  FROM
    `genomics-public-data.1000_genomes.variants`,
    UNNEST(call) AS c
  WHERE
    reference_name = 'X'
    AND ARRAY_LENGTH(c.genotype) > 0
),
per_sample AS (
  SELECT
    sample,
    COUNTIF(gt_type = 'hom_ref') AS hom_ref,
    COUNTIF(gt_type = 'hom_alt') AS hom_alt,
    COUNTIF(gt_type = 'het')     AS het
  FROM per_call
  GROUP BY sample
)
SELECT
  sample,
  hom_ref + hom_alt + het                            AS callable_sites,
  hom_alt + het                                      AS snv_sites,
  SAFE_DIVIDE(het,     hom_alt + het) * 100          AS pct_het_in_snv,
  SAFE_DIVIDE(hom_alt, hom_alt + het) * 100          AS pct_hom_alt_in_snv
FROM
  per_sample
ORDER BY
  pct_het_in_snv DESC,
  sample
LIMIT 20
