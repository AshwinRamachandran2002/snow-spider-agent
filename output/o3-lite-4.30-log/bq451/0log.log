Query:
--Description: End‑to‑end solution on the public table
--             `genomics-public-data.1000_genomes.variants`.
--             Filters chromosome X, excludes pseudo‑autosomal regions (PAR1 & PAR2),
--             retains true SNPs (1‑bp ref, exactly one 1‑bp alt), classifies every
--             callable genotype, aggregates per sample, and outputs counts & percentages.
WITH per_call AS (
  SELECT
    c.call_set_name AS sample,
    CASE
      WHEN ARRAY_LENGTH(c.genotype) > 0
           AND (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) a) = 1
           AND c.genotype[OFFSET(0)] = 0                                   THEN 'hom_ref'
      WHEN ARRAY_LENGTH(c.genotype) > 0
           AND (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) a) = 1
           AND c.genotype[OFFSET(0)] > 0                                   THEN 'hom_alt'
      ELSE 'het'
    END AS gt_type
  FROM
    `genomics-public-data.1000_genomes.variants`,
    UNNEST(call) AS c
  WHERE
    reference_name = 'X'
    -- exclude PAR1 and PAR2
    AND start NOT BETWEEN  59999     AND   2699519
    AND start NOT BETWEEN 154931042  AND 155260559
    -- retain single‑nucleotide polymorphisms
    AND ARRAY_LENGTH(alternate_bases)      = 1
    AND LENGTH(reference_bases)            = 1
    AND LENGTH(alternate_bases[OFFSET(0)]) = 1
    -- keep only callable genotypes
    AND ARRAY_LENGTH(c.genotype) > 0
),
per_sample AS (
  SELECT
    sample,
    COUNTIF(gt_type = 'hom_ref')                             AS hom_ref,
    COUNTIF(gt_type = 'hom_alt')                             AS hom_alt,
    COUNTIF(gt_type = 'het')                                 AS het
  FROM per_call
  GROUP BY sample
)
SELECT
  sample                                              AS sample_id,
  hom_ref + hom_alt + het                             AS callable_sites,
  hom_ref,
  hom_alt,
  het,
  hom_alt + het                                       AS snv_sites,
  SAFE_DIVIDE(het,     hom_alt + het) * 100           AS pct_het_in_snv,
  SAFE_DIVIDE(hom_alt, hom_alt + het) * 100           AS pct_hom_alt_in_snv
FROM
  per_sample
ORDER BY
  pct_het_in_snv DESC,
  sample_id
