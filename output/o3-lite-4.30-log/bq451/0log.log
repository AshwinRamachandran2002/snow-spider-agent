```sql
-- 10. FINAL answer – everything end‑to‑end, no row LIMIT
--   (replace comment markers with the derived expressions)
SELECT
  sample_id                                                       AS sample,
  callable_sites,
  hom_ref,
  hom_alt,
  het,
  snv_sites,
  SAFE_DIVIDE(het, snv_sites)      * 100 AS pct_het_in_snv,
  SAFE_DIVIDE(hom_alt, snv_sites)  * 100 AS pct_hom_alt_in_snv
FROM (
  SELECT
    c.call_set_name                                   AS sample_id,
    COUNT(*)                                          AS callable_sites,
    COUNTIF(gt_type = 'hom_ref')                      AS hom_ref,
    COUNTIF(gt_type = 'hom_alt')                      AS hom_alt,
    COUNTIF(gt_type = 'het')                          AS het,
    COUNTIF(gt_type IN ('hom_alt','het'))             AS snv_sites
  FROM (
    -- classify every call that passes the coordinate and SNP filters
    SELECT
      c.call_set_name,
      c.genotype,
      CASE
        WHEN (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) AS a) = 1
             AND c.genotype[OFFSET(0)] = 0
          THEN 'hom_ref'
        WHEN (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) AS a) = 1
             AND c.genotype[OFFSET(0)] > 0
          THEN 'hom_alt'
        ELSE 'het'
      END AS gt_type
    FROM `spider2-public-data.1000_genomes.variants`,
         UNNEST(call) AS c
    WHERE reference_name = 'X'
      AND start NOT BETWEEN 59999      AND 2699519
      AND start NOT BETWEEN 154931042  AND 155260559
      AND ARRAY_LENGTH(alternate_bases) = 1
      AND LENGTH(reference_bases) = 1
      AND LENGTH(alternate_bases[OFFSET(0)]) = 1
      AND ARRAY_LENGTH(c.genotype) > 0
  )
  GROUP BY sample_id
)
ORDER BY pct_het_in_snv DESC, sample;
```

