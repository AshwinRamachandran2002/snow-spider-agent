--                   het     : everything else (different alleles or mixture of 0/alt)
--             • per_sample  – aggregate the three genotype categories per sample.
--             • final step  – compute:
--                   callable_sites = hom_ref + hom_alt + het
--                   snv_sites      = hom_alt + het
--             The query returns 20 samples to verify the logic.
WITH per_call AS (
  SELECT
    c.call_set_name AS sample,
    CASE
      WHEN ARRAY_LENGTH(c.genotype) > 0
