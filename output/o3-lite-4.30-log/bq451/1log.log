Below are ten exploratory → increasingly complex BigQuery SQL snippets (each returns max 20 rows) that build toward the final solution.

```sql
-- 1) Inspect a handful of raw rows in the variants table
SELECT *
FROM `spider2-public-data.1000_genomes.variants`
LIMIT 20;
```

```sql
-- 2) What chromosomes are present?
SELECT DISTINCT reference_name
FROM `spider2-public-data.1000_genomes.variants`
LIMIT 20;
```

```sql
-- 3) Count how many variant records lie on chr X outside the two excluded regions
SELECT COUNT(*) AS variant_records_chrX_outside_PAR
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = 'X'
  AND NOT (start BETWEEN 59999 AND 2699519
           OR start BETWEEN 154931042 AND 155260559);
```

```sql
-- 4) Show 20 SNP records on chr X outside the excluded regions
SELECT reference_name, start, reference_bases, alternate_bases
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = 'X'
  AND NOT (start BETWEEN 59999 AND 2699519
           OR start BETWEEN 154931042 AND 155260559)
  AND LENGTH(reference_bases)=1
  AND ARRAY_LENGTH(alternate_bases)=1
  AND LENGTH(alternate_bases[OFFSET(0)])=1
LIMIT 20;
```

```sql
-- 5) Peek at per‑sample genotype arrays for a few SNPs
SELECT v.start,
       c.call_set_name AS sample_id,
       c.genotype AS genotype_array
FROM `spider2-public-data.1000_genomes.variants` AS v,
     UNNEST(v.call) AS c
WHERE v.reference_name = 'X'
  AND NOT (v.start BETWEEN 59999 AND 2699519
           OR v.start BETWEEN 154931042 AND 155260559)
  AND LENGTH(v.reference_bases)=1
  AND ARRAY_LENGTH(v.alternate_bases)=1
  AND LENGTH(v.alternate_bases[OFFSET(0)])=1
LIMIT 20;
```

```sql
-- 6) Keep only the genotype calls that have at least one allele
SELECT c.call_set_name AS sample_id,
       c.genotype
FROM `spider2-public-data.1000_genomes.variants` AS v,
     UNNEST(v.call) AS c
WHERE v.reference_name = 'X'
  AND LENGTH(v.reference_bases)=1
  AND ARRAY_LENGTH(v.alternate_bases)=1
  AND LENGTH(v.alternate_bases[OFFSET(0)])=1
  AND ARRAY_LENGTH(c.genotype) > 0
LIMIT 20;
```

```sql
-- 7) Classify each genotype call into HOM_REF / HOM_ALT / HET
SELECT c.call_set_name                                       AS sample_id,
       c.genotype                                            AS gt,
       CASE
         WHEN (SELECT COUNTIF(allele > 0)
               FROM UNNEST(c.genotype) allele) = 0                       THEN 'HOM_REF'
         WHEN ARRAY_LENGTH(ARRAY(SELECT DISTINCT allele
                                 FROM UNNEST(c.genotype) allele)) = 1
              AND (SELECT MAX(allele) FROM UNNEST(c.genotype)) > 0       THEN 'HOM_ALT'
         ELSE 'HET'
       END                                                   AS genotype_class
FROM `spider2-public-data.1000_genomes.variants` AS v,
     UNNEST(v.call)                   AS c
WHERE v.reference_name = 'X'
  AND NOT (v.start BETWEEN 59999 AND 2699519
           OR v.start BETWEEN 154931042 AND 155260559)
  AND LENGTH(v.reference_bases)=1
  AND ARRAY_LENGTH(v.alternate_bases)=1
  AND LENGTH(v.alternate_bases[OFFSET(0)])=1
  AND ARRAY_LENGTH(c.genotype) > 0
LIMIT 20;
```

```sql
-- 8) Aggregate counts per sample (callable, HOM_REF, HOM_ALT, HET) – first 20 samples
SELECT sample_id,
       COUNT(*)                                   AS callable_sites,
       COUNTIF(genotype_class = 'HOM_REF')        AS hom_ref,
       COUNTIF(genotype_class = 'HOM_ALT')        AS hom_alt,
       COUNTIF(genotype_class = 'HET')            AS het
FROM (
  SELECT c.call_set_name AS sample_id,
         CASE
           WHEN (SELECT COUNTIF(allele > 0)
                 FROM UNNEST(c.genotype) allele) = 0                     THEN 'HOM_REF'
           WHEN ARRAY_LENGTH(ARRAY(SELECT DISTINCT allele
                                   FROM UNNEST(c.genotype) allele)) = 1
                AND (SELECT MAX(allele) FROM UNNEST(c.genotype)) > 0     THEN 'HOM_ALT'
           ELSE 'HET'
         END AS genotype_class
  FROM `spider2-public-data.1000_genomes.variants` AS v,
       UNNEST(v.call) AS c
  WHERE v.reference_name = 'X'
    AND NOT (v.start BETWEEN 59999 AND 2699519
             OR v.start BETWEEN 154931042 AND 155260559)
    AND LENGTH(v.reference_bases)=1
    AND ARRAY_LENGTH(v.alternate_bases)=1
    AND LENGTH(v.alternate_bases[OFFSET(0)])=1
    AND ARRAY_LENGTH(c.genotype) > 0
)
GROUP BY sample_id
LIMIT 20;
```

```sql
-- 9) Add SNV count and percentages
SELECT sample_id,
       callable_sites,
       hom_ref,
       hom_alt,
       het,
       (hom_alt + het)                              AS snv_sites,
       ROUND(100 * het      / NULLIF(hom_alt + het,0), 2) AS pct_het_in_snv,
       ROUND(100 * hom_alt  / NULLIF(hom_alt + het,0), 2) AS pct_hom_alt_in_snv
FROM (
  -- sub‑query is identical to #8
  SELECT sample_id,
         COUNT(*)                                AS callable_sites,
         COUNTIF(genotype_class='HOM_REF')       AS hom_ref,
         COUNTIF(genotype_class='HOM_ALT')       AS hom_alt,
         COUNTIF(genotype_class='HET')           AS het
  FROM (
    SELECT c.call_set_name AS sample_id,
           CASE
             WHEN (SELECT COUNTIF(allele > 0)
                   FROM UNNEST(c.genotype) allele)=0                      THEN 'HOM_REF'
             WHEN ARRAY_LENGTH(ARRAY(SELECT DISTINCT allele
                                     FROM UNNEST(c.genotype) allele))=1
                  AND (SELECT MAX(allele) FROM UNNEST(c.genotype))>0      THEN 'HOM_ALT'
             ELSE 'HET'
           END AS genotype_class
    FROM `spider2-public-data.1000_genomes.variants` AS v,
         UNNEST(v.call) AS c
    WHERE v.reference_name = 'X'
      AND NOT (v.start BETWEEN 59999 AND 2699519
               OR v.start BETWEEN 154931042 AND 155260559)
      AND LENGTH(v.reference_bases)=1
      AND ARRAY_LENGTH(v.alternate_bases)=1
      AND LENGTH(v.alternate_bases[OFFSET(0)])=1
      AND ARRAY_LENGTH(c.genotype) > 0
  )
  GROUP BY sample_id
)
LIMIT 20;
```

```sql
-- 10) FINAL QUERY: full result ordered by % heterozygous among SNVs (desc), then sample id
SELECT
  sample_id,
  callable_sites,
  hom_ref,
  hom_alt,
  het,
  snv_sites,
  pct_het_in_snv,
  pct_hom_alt_in_snv
FROM (
  SELECT
    sample_id,
    callable_sites,
    hom_ref,
    hom_alt,
    het,
    hom_alt + het                                                AS snv_sites,
    ROUND(100 * het     / NULLIF(hom_alt + het,0), 2)            AS pct_het_in_snv,
    ROUND(100 * hom_alt / NULLIF(hom_alt + het,0), 2)            AS pct_hom_alt_in_snv
  FROM (
    SELECT
      c.call_set_name                                            AS sample_id,
      COUNT(*)                                                   AS callable_sites,
      COUNTIF(genotype_class = 'HOM_REF')                        AS hom_ref,
      COUNTIF(genotype_class = 'HOM_ALT')                        AS hom_alt,
      COUNTIF(genotype_class = 'HET')                            AS het
    FROM (
      SELECT
        v.start,
        c.call_set_name,
        CASE
          WHEN (SELECT COUNTIF(a > 0) FROM UNNEST(c.genotype) a) = 0             THEN 'HOM_REF'
          WHEN ARRAY_LENGTH(ARRAY(SELECT DISTINCT a FROM UNNEST(c.genotype) a))=1
               AND (SELECT MAX(a) FROM UNNEST(c.genotype)) > 0                  THEN 'HOM_ALT'
          ELSE 'HET'
        END AS genotype_class
      FROM `spider2-public-data.1000_genomes.variants` AS v,
           UNNEST(v.call) AS c
      WHERE v.reference_name = 'X'
        AND NOT (v.start BETWEEN 59999 AND 2699519
                 OR v.start BETWEEN 154931042 AND 155260559)
        AND LENGTH(v.reference_bases)=1
        AND ARRAY_LENGTH(v.alternate_bases)=1
        AND LENGTH(v.alternate_bases[OFFSET(0)])=1
        AND ARRAY_LENGTH(c.genotype) > 0
    ) AS classified
    GROUP BY sample_id
  )
)
ORDER BY pct_het_in_snv DESC, sample_id;
```
