--Description: Final report—compute per‑sample counts and percentages of genotype
--             classes for chromosome X non‑PAR SNPs, ordered by heterozygous
--             percentage among SNVs.  All Boolean SUMs are replaced with CASE.
SELECT
  sample_id                                   AS sample,
  callable_sites,
  n_hom_ref,
  n_hom_alt,
  n_het,
  snv_sites,
  ROUND(100 * n_het     / snv_sites, 2) AS pct_het_among_snvs,
  ROUND(100 * n_hom_alt / snv_sites, 2) AS pct_hom_alt_among_snvs
FROM (
  SELECT
    sample_id,
    SUM(CASE WHEN gt_type = 'homo_ref' THEN 1 ELSE 0 END)                      AS n_hom_ref,
    SUM(CASE WHEN gt_type = 'homo_alt' THEN 1 ELSE 0 END)                      AS n_hom_alt,
    SUM(CASE WHEN gt_type = 'het'      THEN 1 ELSE 0 END)                      AS n_het,
    COUNT(*)                                                                   AS callable_sites,
    SUM(CASE WHEN gt_type IN ('homo_alt','het') THEN 1 ELSE 0 END)             AS snv_sites
  FROM (
    SELECT
      c.call_set_name AS sample_id,
      CASE
        WHEN ARRAY_LENGTH(c.genotype) = 2
             AND c.genotype[OFFSET(0)] = 0
             AND c.genotype[OFFSET(1)] = 0                          THEN 'homo_ref'
        WHEN ARRAY_LENGTH(c.genotype) = 2
             AND c.genotype[OFFSET(0)] = c.genotype[OFFSET(1)]
             AND c.genotype[OFFSET(0)] > 0                          THEN 'homo_alt'
        WHEN ARRAY_LENGTH(c.genotype) = 2
             AND (c.genotype[OFFSET(0)] IS NULL
                  OR c.genotype[OFFSET(1)] IS NULL
                  OR c.genotype[OFFSET(0)] != c.genotype[OFFSET(1)])
             AND (c.genotype[OFFSET(0)] > 0
                  OR c.genotype[OFFSET(1)] > 0)                      THEN 'het'
        ELSE NULL
      END AS gt_type
    FROM `genomics-public-data.1000_genomes.variants` AS v
    CROSS JOIN UNNEST(v.call) AS c
    WHERE v.reference_name = 'X'
      AND NOT (v.start BETWEEN 59999 AND 2699519)        -- exclude PAR1
      AND NOT (v.start BETWEEN 154931042 AND 155260559)  -- exclude PAR2
      AND ARRAY_LENGTH(v.alternate_bases) = 1            -- keep SNPs
      AND ARRAY_LENGTH(c.genotype) >= 1                  -- ensure genotype exists
  )
  GROUP BY sample_id
)
ORDER BY pct_het_among_snvs DESC, sample
