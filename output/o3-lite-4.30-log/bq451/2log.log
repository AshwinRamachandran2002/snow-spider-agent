Ten exploratory → incremental queries (all limited to 20 rows unless noted)

```sql
-- 1. Description: See chromosomes available in the variants table.
SELECT DISTINCT reference_name
FROM `spider2-public-data.1000_genomes.variants`
LIMIT 20;
```

```sql
-- 2. Description: Count total rows on chromosome X.
SELECT COUNT(*) AS variant_rows_X
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = 'X';
```

```sql
-- 3. Description: Check a few start positions around the PAR1 exclusion
--    to verify coordinates are present.
SELECT start
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = 'X'
  AND start BETWEEN 55000 AND 65000
LIMIT 20;
```

```sql
-- 4. Description: Peek at one variant record with the nested `call` field.
SELECT reference_name, start, alternate_bases, call
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = 'X'
LIMIT 1;
```

```sql
-- 5. Description: Unnest the `call` array for chromosome X and display
--    sample IDs with their genotype arrays.
SELECT
  v.start,
  c.call_set_name AS sample_id,
  c.genotype
FROM `spider2-public-data.1000_genomes.variants`  AS v,
     UNNEST(v.call)                               AS c
WHERE v.reference_name = 'X'
LIMIT 20;
```

```sql
-- 6. Description: Restrict to non‑PAR regions & single‑nucleotide variants.
--    Show sample‑level genotypes for a quick look.
SELECT
  v.start,
  c.call_set_name AS sample_id,
  c.genotype
FROM `spider2-public-data.1000_genomes.variants`  AS v,
     UNNEST(v.call)                               AS c
WHERE v.reference_name = 'X'
  AND NOT (v.start BETWEEN 59999 AND 2699519)
  AND NOT (v.start BETWEEN 154931042 AND 155260559)
  AND ARRAY_LENGTH(v.alternate_bases) = 1
LIMIT 20;
```

```sql
-- 7. Description: Add a CASE statement to classify each genotype call
--    (homo‑ref / homo‑alt / het).  Display a sample of the classifications.
SELECT
  c.call_set_name                         AS sample_id,
  c.genotype,
  CASE
    WHEN ARRAY_LENGTH(c.genotype) = 2
         AND c.genotype[OFFSET(0)] = 0
         AND c.genotype[OFFSET(1)] = 0           THEN 'homo_ref'
    WHEN ARRAY_LENGTH(c.genotype) = 2
         AND c.genotype[OFFSET(0)] = c.genotype[OFFSET(1)]
         AND c.genotype[OFFSET(0)] > 0           THEN 'homo_alt'
    WHEN ARRAY_LENGTH(c.genotype) = 2
         AND (c.genotype[OFFSET(0)] IS NULL
              OR c.genotype[OFFSET(1)] IS NULL
              OR c.genotype[OFFSET(0)] != c.genotype[OFFSET(1)])
         AND (c.genotype[OFFSET(0)] > 0
              OR c.genotype[OFFSET(1)] > 0)      THEN 'het'
    ELSE NULL
  END AS gt_type
FROM `spider2-public-data.1000_genomes.variants` AS v,
     UNNEST(v.call)                              AS c
WHERE v.reference_name = 'X'
  AND NOT (v.start BETWEEN 59999 AND 2699519)
  AND NOT (v.start BETWEEN 154931042 AND 155260559)
  AND ARRAY_LENGTH(v.alternate_bases) = 1
LIMIT 20;
```

```sql
-- 8. Description: Aggregate counts of each genotype class per sample.
SELECT
  sample_id,
  SUM(gt_type = 'homo_ref') AS n_hom_ref,
  SUM(gt_type = 'homo_alt') AS n_hom_alt,
  SUM(gt_type = 'het')      AS n_het
FROM (
  SELECT
    c.call_set_name AS sample_id,
    CASE
      WHEN ARRAY_LENGTH(c.genotype) = 2
           AND c.genotype[OFFSET(0)] = 0
           AND c.genotype[OFFSET(1)] = 0 THEN 'homo_ref'
      WHEN ARRAY_LENGTH(c.genotype) = 2
           AND c.genotype[OFFSET(0)] = c.genotype[OFFSET(1)]
           AND c.genotype[OFFSET(0)] > 0 THEN 'homo_alt'
      WHEN ARRAY_LENGTH(c.genotype) = 2
           AND (c.genotype[OFFSET(0)] IS NULL
                OR c.genotype[OFFSET(1)] IS NULL
                OR c.genotype[OFFSET(0)] != c.genotype[OFFSET(1)])
           AND (c.genotype[OFFSET(0)] > 0
                OR c.genotype[OFFSET(1)] > 0) THEN 'het'
      ELSE NULL
    END AS gt_type
  FROM `spider2-public-data.1000_genomes.variants` AS v,
       UNNEST(v.call)                              AS c
  WHERE v.reference_name = 'X'
    AND NOT (v.start BETWEEN 59999 AND 2699519)
    AND NOT (v.start BETWEEN 154931042 AND 155260559)
    AND ARRAY_LENGTH(v.alternate_bases) = 1
)
GROUP BY sample_id
LIMIT 20;
```

```sql
-- 9. Description: Extend aggregation with total callable sites (all three
--    classes) and total SNVs (homo_alt + het).
SELECT
  sample_id,
  n_hom_ref,
  n_hom_alt,
  n_het,
  (n_hom_ref + n_hom_alt + n_het) AS callable_sites,
  (n_hom_alt + n_het)             AS snv_sites
FROM (
  SELECT
    sample_id,
    SUM(gt_type = 'homo_ref') AS n_hom_ref,
    SUM(gt_type = 'homo_alt') AS n_hom_alt,
    SUM(gt_type = 'het')      AS n_het
  FROM (
    SELECT
      c.call_set_name AS sample_id,
      CASE
        WHEN ARRAY_LENGTH(c.genotype) = 2
             AND c.genotype[OFFSET(0)] = 0
             AND c.genotype[OFFSET(1)] = 0 THEN 'homo_ref'
        WHEN ARRAY_LENGTH(c.genotype) = 2
             AND c.genotype[OFFSET(0)] = c.genotype[OFFSET(1)]
             AND c.genotype[OFFSET(0)] > 0 THEN 'homo_alt'
        WHEN ARRAY_LENGTH(c.genotype) = 2
             AND (c.genotype[OFFSET(0)] IS NULL
                  OR c.genotype[OFFSET(1)] IS NULL
                  OR c.genotype[OFFSET(0)] != c.genotype[OFFSET(1)])
             AND (c.genotype[OFFSET(0)] > 0
                  OR c.genotype[OFFSET(1)] > 0) THEN 'het'
        ELSE NULL
      END AS gt_type
    FROM `spider2-public-data.1000_genomes.variants` AS v,
         UNNEST(v.call)                              AS c
    WHERE v.reference_name = 'X'
      AND NOT (v.start BETWEEN 59999 AND 2699519)
      AND NOT (v.start BETWEEN 154931042 AND 155260559)
      AND ARRAY_LENGTH(v.alternate_bases) = 1
  )
  GROUP BY sample_id
)
LIMIT 20;
```

```sql
-- 10. Description (FINAL): Produce the requested output metrics, including
--     percentages, and order by percent heterozygous among SNVs (desc) then
--     by sample ID.
SELECT
  sample_id                                   AS sample,
  callable_sites,
  n_hom_ref,
  n_hom_alt,
  n_het,
  snv_sites,
  ROUND(100 * n_het      / snv_sites, 2) AS pct_het_among_snvs,
  ROUND(100 * n_hom_alt  / snv_sites, 2) AS pct_hom_alt_among_snvs
FROM (
  SELECT
    sample_id,
    SUM(gt_type = 'homo_ref')               AS n_hom_ref,
    SUM(gt_type = 'homo_alt')               AS n_hom_alt,
    SUM(gt_type = 'het')                    AS n_het,
    SUM(1)                                  AS callable_sites,
    SUM(gt_type IN ('homo_alt','het'))      AS snv_sites
  FROM (
    SELECT
      c.call_set_name AS sample_id,
      CASE
        WHEN ARRAY_LENGTH(c.genotype) = 2
             AND c.genotype[OFFSET(0)] = 0
             AND c.genotype[OFFSET(1)] = 0 THEN 'homo_ref'
        WHEN ARRAY_LENGTH(c.genotype) = 2
             AND c.genotype[OFFSET(0)] = c.genotype[OFFSET(1)]
             AND c.genotype[OFFSET(0)] > 0 THEN 'homo_alt'
        WHEN ARRAY_LENGTH(c.genotype) = 2
             AND (c.genotype[OFFSET(0)] IS NULL
                  OR c.genotype[OFFSET(1)] IS NULL
                  OR c.genotype[OFFSET(0)] != c.genotype[OFFSET(1)])
             AND (c.genotype[OFFSET(0)] > 0
                  OR c.genotype[OFFSET(1)] > 0) THEN 'het'
        ELSE NULL
      END AS gt_type
    FROM `spider2-public-data.1000_genomes.variants` AS v,
         UNNEST(v.call)                              AS c
    WHERE v.reference_name = 'X'
      AND NOT (v.start BETWEEN 59999 AND 2699519)
      AND NOT (v.start BETWEEN 154931042 AND 155260559)
      AND ARRAY_LENGTH(v.alternate_bases) = 1
      AND ARRAY_LENGTH(c.genotype) >= 1     -- make sure genotype exists
  )
  GROUP BY sample_id
)
ORDER BY pct_het_among_snvs DESC, sample_id
LIMIT 20;
```

