--Description: Final report—compute counts and percentages of genotype classes
--             on chromosome X non‑PAR single‑nucleotide variants, ordered by
--             heterozygous percentage among SNVs.
SELECT
  sample_id                                   AS sample,
  callable_sites,
  n_hom_ref,
  n_hom_alt,
  n_het,
  snv_sites,
  ROUND(100 * n_het      / snv_sites, 2) AS pct_het_among_snvs,
  ROUND(100 * n_hom_alt  / snv_sites, 2) AS pct_hom_alt_among_snvs
FROM (
  SELECT
