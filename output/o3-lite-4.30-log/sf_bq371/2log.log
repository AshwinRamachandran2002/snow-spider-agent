```sql
-- 9.  Average invoice total per quarter (2013)
WITH invoice_totals AS (
  SELECT
    iv."InvoiceID",
    TO_CHAR(TO_DATE(iv."InvoiceDate"), 'Q') AS "QuarterNum",
    SUM(il."UnitPrice" * il."Quantity")    AS "InvoiceTotal"
  FROM WIDE_WORLD_IMPORTERS.WIDE_WORLD_IMPORTERS.SALES_INVOICELINES il
  JOIN WIDE_WORLD_IMPORTERS.WIDE_WORLD_IMPORTERS.SALES_INVOICES   iv
    ON il."InvoiceID" = iv."InvoiceID"
  WHERE YEAR(TO_DATE(iv."InvoiceDate")) = 2013
  GROUP BY iv."InvoiceID", TO_CHAR(TO_DATE(iv."InvoiceDate"), 'Q')
)
SELECT
  'Q' || "QuarterNum"                        AS "Quarter",
  AVG("InvoiceTotal")                        AS "AvgInvoiceValue"
FROM invoice_totals
GROUP BY "QuarterNum"
ORDER BY "Quarter"
LIMIT 20;
```

```sql
-- 10.  Difference between the maximum and minimum of those quarterly averages
WITH invoice_totals AS (
  SELECT
    iv."InvoiceID",
    TO_CHAR(TO_DATE(iv."InvoiceDate"), 'Q') AS "QuarterNum",
    SUM(il."UnitPrice" * il."Quantity")    AS "InvoiceTotal"
  FROM WIDE_WORLD_IMPORTERS.WIDE_WORLD_IMPORTERS.SALES_INVOICELINES il
  JOIN WIDE_WORLD_IMPORTERS.WIDE_WORLD_IMPORTERS.SALES_INVOICES   iv
    ON il."InvoiceID" = iv."InvoiceID"
  WHERE YEAR(TO_DATE(iv."InvoiceDate")) = 2013
  GROUP BY iv."InvoiceID", TO_CHAR(TO_DATE(iv."InvoiceDate"), 'Q')
),
quarter_avgs AS (
  SELECT
    "QuarterNum",
    AVG("InvoiceTotal") AS "AvgInv"
  FROM invoice_totals
  GROUP BY "QuarterNum"
)
SELECT
  MAX("AvgInv") - MIN("AvgInv") AS "MaxMinusMinAvgInvoiceValue_2013"
FROM quarter_avgs;
```

