Below is a quick “road‑map” of what is useful in each table, followed by ten exploratory / progressively‑complex BigQuery examples you can run to build – and finally UNION together – the four requested leaderboards.  
(Replace `<project‑id>` with the Google Cloud project that has billing‑access to the public dataset if needed.)

RELEVANT COLUMNS & TYPICAL FILTERS  
• `bigquery-public-data.ncaa_basketball.mbb_teams`  
  – `venue_name`, `venue_capacity`, `market`, `name` →  Top Venues list  
  – No date in this table, so we will hard‑code `'N/A'` for the Date column.  

• `bigquery-public-data.ncaa_basketball.mbb_historical_tournament_games`  
  – `season`                            → season > 2015  
  – `round`                             → national championship = 2 teams remaining -> `round = 2`  
  – `win_market`,`win_name`,`win_pts`   |  
  – `lose_market`,`lose_name`,`lose_pts`|→ Biggest Championship Margins  
  – Margin = `ABS(win_pts - lose_pts)`  

• `bigquery-public-data.ncaa_basketball.mbb_games_sr`  
  – `season`                              → season > 2010  
  – `scheduled_date`                      → Date column  
  – `h_market`,`h_name`,`a_market`,`a_name` → Match‑up description  
  – `h_points`,`a_points`                 → Highest Scoring Games (total points)  
  – `h_three_points_made`,`a_three_points_made` → Total Threes (combined made)  

------------------------------------------------------------------------------
10 EXAMPLE QUERIES (each limited to 20 rows for inspection)

```sql
-- 1. Check raw venue data & capacities for schools
SELECT market, name, venue_name, venue_capacity
FROM `bigquery-public-data.ncaa_basketball.mbb_teams`
WHERE venue_capacity IS NOT NULL
ORDER BY venue_capacity DESC
LIMIT 20;
```

```sql
-- 2. Distinct venue names to see possible duplicates / shared arenas
SELECT DISTINCT venue_name
FROM `bigquery-public-data.ncaa_basketball.mbb_teams`
WHERE venue_name IS NOT NULL
LIMIT 20;
```

```sql
-- 3. Biggest capacities after deduplicating identical venue names
SELECT venue_name,
       MAX(venue_capacity) AS max_capacity
FROM `bigquery-public-data.ncaa_basketball.mbb_teams`
GROUP BY venue_name
ORDER BY max_capacity DESC
LIMIT 20;
```

```sql
-- 4. Inspect recent NCAA‑tournament championship games (round = 2, season > 2015)
SELECT season, game_date, win_market, win_name, win_pts,
       lose_market, lose_name, lose_pts, round
FROM `bigquery-public-data.ncaa_basketball.mbb_historical_tournament_games`
WHERE season > 2015
  AND round = 2
ORDER BY season DESC
LIMIT 20;
```

```sql
-- 5. Compute point margin for those title games
SELECT season, game_date,
       CONCAT(win_market, ' ', win_name, ' vs. ', lose_market, ' ', lose_name) AS matchup,
       win_pts - lose_pts AS margin
FROM `bigquery-public-data.ncaa_basketball.mbb_historical_tournament_games`
WHERE season > 2015
  AND round = 2
ORDER BY margin DESC
LIMIT 20;
```

```sql
-- 6. Highest scoring games since 2011 (total points)
SELECT season, scheduled_date,
       CONCAT(h_market, ' ', h_name, ' vs. ', a_market, ' ', a_name) AS matchup,
       (h_points + a_points) AS total_pts
FROM `bigquery-public-data.ncaa_basketball.mbb_games_sr`
WHERE season > 2010
  AND h_points IS NOT NULL AND a_points IS NOT NULL
ORDER BY total_pts DESC
LIMIT 20;
```

```sql
-- 7. Games with most combined made 3‑pointers since 2011
SELECT season, scheduled_date,
       CONCAT(h_market, ' ', h_name, ' vs. ', a_market, ' ', a_name) AS matchup,
       (h_three_points_made + a_three_points_made) AS total_threes
FROM `bigquery-public-data.ncaa_basketball.mbb_games_sr`
WHERE season > 2010
  AND h_three_points_made IS NOT NULL AND a_three_points_made IS NOT NULL
ORDER BY total_threes DESC
LIMIT 20;
```

```sql
-- 8. Verify that three‑pointer fields are populated for top‑scoring games
SELECT season, scheduled_date, h_three_points_made, a_three_points_made
FROM `bigquery-public-data.ncaa_basketball.mbb_games_sr`
WHERE season > 2010
  AND (h_points + a_points) > 220          -- just a sanity threshold
ORDER BY (h_points + a_points) DESC
LIMIT 20;
```

```sql
-- 9. Prepare TOP‑5 sub‑queries for each of the four leaderboards
WITH
top_venues AS (
  SELECT 'Top Venues' AS category,
         'N/A'        AS date,
         venue_name   AS matchup_or_venue,
         MAX(venue_capacity) AS key_metric
  FROM `bigquery-public-data.ncaa_basketball.mbb_teams`
  WHERE venue_capacity IS NOT NULL
  GROUP BY venue_name
  ORDER BY key_metric DESC
  LIMIT 5
),
champ_margins AS (
  SELECT 'Biggest Championship Margins' AS category,
         CAST(game_date AS STRING)      AS date,
         CONCAT(win_market, ' ', win_name, ' vs. ',
                lose_market, ' ', lose_name) AS matchup_or_venue,
         ABS(win_pts - lose_pts)        AS key_metric
  FROM `bigquery-public-data.ncaa_basketball.mbb_historical_tournament_games`
  WHERE season > 2015
    AND round = 2
  ORDER BY key_metric DESC
  LIMIT 5
),
hi_scores AS (
  SELECT 'Highest Scoring Games'        AS category,
         CAST(scheduled_date AS STRING) AS date,
         CONCAT(h_market, ' ', h_name, ' vs. ',
                a_market, ' ', a_name)  AS matchup_or_venue,
         (h_points + a_points)          AS key_metric
  FROM `bigquery-public-data.ncaa_basketball.mbb_games_sr`
  WHERE season > 2010
    AND h_points IS NOT NULL AND a_points IS NOT NULL
  ORDER BY key_metric DESC
  LIMIT 5
),
hi_threes AS (
  SELECT 'Total Threes'                 AS category,
         CAST(scheduled_date AS STRING) AS date,
         CONCAT(h_market, ' ', h_name, ' vs. ',
                a_market, ' ', a_name)  AS matchup_or_venue,
         (h_three_points_made + a_three_points_made) AS key_metric
  FROM `bigquery-public-data.ncaa_basketball.mbb_games_sr`
  WHERE season > 2010
    AND h_three_points_made IS NOT NULL AND a_three_points_made IS NOT NULL
  ORDER BY key_metric DESC
  LIMIT 5
)
SELECT *
FROM top_venues
UNION ALL
SELECT * FROM champ_margins
UNION ALL
SELECT * FROM hi_scores
UNION ALL
SELECT * FROM hi_threes;
```

```sql
