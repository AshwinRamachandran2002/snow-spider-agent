  /* Total Threes */
  SELECT
    'Total Threes'                        AS Category,
    CAST(scheduled_date AS STRING)        AS Date,
    CONCAT(h_market, ' vs ', a_market)    AS `Matchup or Venue`,
    CAST(threes_made AS STRING)           AS `Key Metric`,
    4                                     AS sort_cat,
    threes_made                           AS sort_val
  FROM most_threes
)
ORDER BY
  sort_cat,
  sort_val DESC;
```
