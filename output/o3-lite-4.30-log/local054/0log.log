2025-05-01 03:20:12 - Thread-1336 (execute) - INFO - [Exploration]
Relevant tables/columns and why they matter  
• artists.ArtistId – key for every artist, needed to know “best‑selling artist”  
• artists.Name – just to display / validate which artist wins the sales race  
• albums.AlbumId – links every album to its artist  
• albums.ArtistId – foreign key used in joins artist → album  
• tracks.TrackId – joins an album to a concrete track that can be bought  
• tracks.AlbumId – foreign key album → track  
• invoice_items.InvoiceId – reference to a concrete sale line inside an invoice  
• invoice_items.TrackId – lets us know which track was bought  
• invoice_items.UnitPrice, invoice_items.Quantity – multiplied to obtain revenue per line  
• invoices.InvoiceId – header table for a full purchase, connects a customer to many lines  
• invoices.CustomerId – foreign key invoice → customer  
• customers.CustomerId – key of the buyer  
• customers.FirstName – what the question finally wants to show  
  (the amount itself will be calculated with SUM(UnitPrice*Quantity) in the SQL)

Below are ten exploratory SELECT statements (each limited to 20 rows) that build up from very simple to the final answer.  
All tables/columns are enclosed in double quotes when used; every query has an explanatory comment.

```sql
-- 1. Peek at customer first names and Ids
SELECT DISTINCT "CustomerId",
       "FirstName"
FROM "customers"
LIMIT 20;
```

```sql
-- 2. List the first 20 artists and their Ids
SELECT DISTINCT "ArtistId",
       "Name"
FROM "artists"
LIMIT 20;
```

```sql
-- 3. Show how albums map to artists
SELECT DISTINCT a."ArtistId",
       ar."Name"  AS "ArtistName",
       a."AlbumId",
       a."Title"
FROM   "albums" AS a
JOIN   "artists" AS ar
       ON a."ArtistId" = ar."ArtistId"
LIMIT 20;
```

```sql
-- 4. Investigate tracks on the first 20 albums
SELECT DISTINCT t."TrackId",
       t."Name"  AS "TrackName",
       t."AlbumId"
FROM   "tracks" AS t
LIMIT 20;
```

```sql
-- 5. View 20 invoice lines with price * quantity (sales lines)
SELECT DISTINCT ii."InvoiceLineId",
       ii."TrackId",
       (ii."UnitPrice" * ii."Quantity") AS "LineValue"
FROM   "invoice_items" AS ii
LIMIT 20;
```

```sql
-- 6. Compute sales value per artist (top 20 by sales)
SELECT ar."ArtistId",
       ar."Name",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "ArtistRevenue"
FROM   "artists"        AS ar
JOIN   "albums"         AS al  ON al."ArtistId" = ar."ArtistId"
JOIN   "tracks"         AS t   ON t."AlbumId"   = al."AlbumId"
JOIN   "invoice_items"  AS ii  ON ii."TrackId"  = t."TrackId"
GROUP  BY ar."ArtistId"
ORDER  BY "ArtistRevenue" DESC
LIMIT 20;
```

```sql
-- 7. Identify the single best‑selling artist (highest total revenue)
SELECT ar."ArtistId",
       ar."Name",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "TotalRevenue"
FROM   "artists"        AS ar
JOIN   "albums"         AS al  ON al."ArtistId" = ar."ArtistId"
JOIN   "tracks"         AS t   ON t."AlbumId"   = al."AlbumId"
JOIN   "invoice_items"  AS ii  ON ii."TrackId"  = t."TrackId"
GROUP  BY ar."ArtistId"
ORDER  BY "TotalRevenue" DESC
LIMIT 1;
```

```sql
-- 8. Show how much each customer has spent on tracks from that best‑selling artist
WITH best_artist AS (
       SELECT ar."ArtistId"
       FROM   "artists"        AS ar
       JOIN   "albums"         AS al  ON al."ArtistId" = ar."ArtistId"
       JOIN   "tracks"         AS t   ON t."AlbumId"   = al."AlbumId"
       JOIN   "invoice_items"  AS ii  ON ii."TrackId"  = t."TrackId"
       GROUP  BY ar."ArtistId"
       ORDER  BY SUM(ii."UnitPrice" * ii."Quantity") DESC
       LIMIT 1
)
SELECT c."CustomerId",
       c."FirstName",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "SpendOnBestArtist"
FROM   "customers"      AS c
JOIN   "invoices"       AS i   ON i."CustomerId" = c."CustomerId"
JOIN   "invoice_items"  AS ii  ON ii."InvoiceId" = i."InvoiceId"
JOIN   "tracks"         AS t   ON t."TrackId"    = ii."TrackId"
JOIN   "albums"         AS al  ON al."AlbumId"   = t."AlbumId"
JOIN   best_artist      AS ba  ON ba."ArtistId"  = al."ArtistId"
GROUP  BY c."CustomerId"
LIMIT 20;
```

```sql
-- 9. Filter the previous result to customers who spent < $1
WITH best_artist AS (
       SELECT ar."ArtistId"
       FROM   "artists"        AS ar
       JOIN   "albums"         AS al  ON al."ArtistId" = ar."ArtistId"
       JOIN   "tracks"         AS t   ON t."AlbumId"   = al."AlbumId"
       JOIN   "invoice_items"  AS ii  ON ii."TrackId"  = t."TrackId"
       GROUP  BY ar."ArtistId"
       ORDER  BY SUM(ii."UnitPrice" * ii."Quantity") DESC
       LIMIT 1
)
SELECT c."CustomerId",
       c."FirstName",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "SpendOnBestArtist"
FROM   "customers"      AS c
JOIN   "invoices"       AS i   ON i."CustomerId" = c."CustomerId"
JOIN   "invoice_items"  AS ii  ON ii."InvoiceId" = i."InvoiceId"
JOIN   "tracks"         AS t   ON t."TrackId"    = ii."TrackId"
JOIN   "albums"         AS al  ON al."AlbumId"   = t."AlbumId"
JOIN   best_artist      AS ba  ON ba."ArtistId"  = al."ArtistId"
GROUP  BY c."CustomerId"
HAVING SUM(ii."UnitPrice" * ii."Quantity") < 1
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER – first names of customers who spent < $1 on the best‑selling artist, plus the amount
WITH best_artist AS (
       SELECT ar."ArtistId"
       FROM   "artists"        AS ar
       JOIN   "albums"         AS al  ON al."ArtistId" = ar."ArtistId"
       JOIN   "tracks"         AS t   ON t."AlbumId"   = al."AlbumId"
       JOIN   "invoice_items"  AS ii  ON ii."TrackId"  = t."TrackId"
       GROUP  BY ar."ArtistId"
       ORDER  BY SUM(ii."UnitPrice" * ii."Quantity") DESC
       LIMIT 1
)
SELECT DISTINCT
       c."FirstName",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "AmountSpent"
FROM   "customers"      AS c
JOIN   "invoices"       AS i   ON i."CustomerId" = c."CustomerId"
JOIN   "invoice_items"  AS ii  ON ii."InvoiceId" = i."InvoiceId"
JOIN   "tracks"         AS t   ON t."TrackId"    = ii."TrackId"
JOIN   "albums"         AS al  ON al."AlbumId"   = t."AlbumId"
JOIN   best_artist      AS ba  ON ba."ArtistId"  = al."ArtistId"
GROUP  BY c."CustomerId"
HAVING SUM(ii."UnitPrice" * ii."Quantity") < 1
ORDER  BY "AmountSpent" DESC
LIMIT 20;
```

Running the last query will list every customer first name, together with how much (under a dollar) that customer has spent on albums/tracks by the overall best‑selling artist.
