```sql
-- 1. Preview participation data: driver, constructor and round of every race
SELECT r.driver_id,
       d.surname AS driver_name,
       r.constructor_id,
       c.name  AS constructor_name,
       ra.year,
       ra.round
FROM   results       AS r
JOIN   races         AS ra ON ra.race_id = r.race_id
JOIN   drivers       AS d  ON d.driver_id = r.driver_id
JOIN   constructors  AS c  ON c.constructor_id = r.constructor_id
LIMIT 20;
```

```sql
-- 2. Distinct years that exist in the results set
SELECT DISTINCT ra.year
FROM   results r
JOIN   races   ra ON ra.race_id = r.race_id
LIMIT 20;
```

```sql
-- 3. All rounds a chosen driver (id = 1) contested in a single season (2009)
SELECT ra.round
FROM   results r
JOIN   races  ra ON ra.race_id = r.race_id
WHERE  r.driver_id = 1 
  AND  ra.year = 2009
ORDER BY ra.round
LIMIT 20;
```

```sql
-- 4. Add the next round the driver appears in (LEAD) to spot gaps
SELECT r.driver_id,
       ra.year,
       ra.round                         AS prev_round,
       LEAD(ra.round) OVER (PARTITION BY r.driver_id, ra.year 
                            ORDER BY ra.round)          AS next_round
FROM   results r
JOIN   races   ra ON ra.race_id = r.race_id
WHERE  r.driver_id = 1 
  AND  ra.year = 2009
ORDER BY ra.round
LIMIT 20;
```

```sql
-- 5. Show only gaps where 1–2 races were missed (next_round - prev_round - 1 = 1 or 2)
SELECT driver_id,
       year,
       prev_round,
       next_round,
       (next_round - prev_round - 1) AS missed_count
FROM (
    SELECT r.driver_id,
           ra.year,
           ra.round                              AS prev_round,
           LEAD(ra.round)        OVER (PARTITION BY r.driver_id, ra.year ORDER BY ra.round) AS next_round
    FROM   results r
    JOIN   races   ra ON ra.race_id = r.race_id
) 
WHERE next_round IS NOT NULL
  AND (next_round - prev_round - 1) BETWEEN 1 AND 2
LIMIT 20;
```

```sql
-- 6. Add constructors before and after the gap and keep only switches of team
SELECT driver_id,
       year,
       prev_round,
       next_round,
       prev_constructor_id,
       next_constructor_id
FROM (
    SELECT r.driver_id,
           ra.year,
           ra.round                                            AS prev_round,
           r.constructor_id                                    AS prev_constructor_id,
           LEAD(ra.round)          OVER (PARTITION BY r.driver_id, ra.year ORDER BY ra.round) AS next_round,
           LEAD(r.constructor_id)  OVER (PARTITION BY r.driver_id, ra.year ORDER BY ra.round) AS next_constructor_id
    FROM   results r
    JOIN   races   ra ON ra.race_id = r.race_id
)
WHERE next_round IS NOT NULL
  AND (next_round - prev_round - 1) BETWEEN 1 AND 2
  AND prev_constructor_id <> next_constructor_id
LIMIT 20;
```

```sql
-- 7. Compute first and last missed rounds for every qualifying gap
SELECT driver_id,
       year,
       prev_round + 1      AS first_missed_round,
       next_round - 1      AS last_missed_round
FROM (
    SELECT r.driver_id,
           ra.year,
           ra.round                                            AS prev_round,
           r.constructor_id                                    AS prev_constructor_id,
           LEAD(ra.round)          OVER (PARTITION BY r.driver_id, ra.year ORDER BY ra.round) AS next_round,
           LEAD(r.constructor_id)  OVER (PARTITION BY r.driver_id, ra.year ORDER BY ra.round) AS next_constructor_id
    FROM   results r
    JOIN   races   ra ON ra.race_id = r.race_id
)
WHERE next_round IS NOT NULL
  AND (next_round - prev_round - 1) BETWEEN 1 AND 2
  AND prev_constructor_id <> next_constructor_id
LIMIT 20;
```

```sql
-- 8. All such gaps across the whole dataset (no LIMIT so you can inspect all rows)
SELECT driver_id,
       year,
       prev_round + 1 AS first_missed_round,
       next_round - 1 AS last_missed_round
FROM (
    SELECT r.driver_id,
           ra.year,
           ra.round                                            AS prev_round,
           r.constructor_id                                    AS prev_constructor_id,
           LEAD(ra.round)          OVER (PARTITION BY r.driver_id, ra.year ORDER BY ra.round) AS next_round,
           LEAD(r.constructor_id)  OVER (PARTITION BY r.driver_id, ra.year ORDER BY ra.round) AS next_constructor_id
    FROM   results r
    JOIN   races   ra ON ra.race_id = r.race_id
)
WHERE next_round IS NOT NULL
  AND (next_round - prev_round - 1) BETWEEN 1 AND 2
  AND prev_constructor_id <> next_constructor_id;
```

```sql
-- 9. FINAL ANSWER: overall averages of the first and last missed rounds
WITH driver_year_participations AS (
    SELECT r.driver_id,
           ra.year,
           ra.round,
           r.constructor_id
    FROM   results r
    JOIN   races   ra ON ra.race_id = r.race_id
),
gaps AS (
    SELECT driver_id,
           year,
           round                                   AS prev_round,
           constructor_id                          AS prev_constructor_id,
           LEAD(round)          OVER (PARTITION BY driver_id, year ORDER BY round) AS next_round,
           LEAD(constructor_id) OVER (PARTITION BY driver_id, year ORDER BY round) AS next_constructor_id
    FROM   driver_year_participations
),
qualified_gaps AS (
    SELECT driver_id,
           year,
           prev_round + 1                      AS first_missed_round,
           next_round - 1                      AS last_missed_round
    FROM   gaps
    WHERE  next_round IS NOT NULL
      AND (next_round - prev_round - 1) BETWEEN 1 AND 2   -- missed < 3 races
      AND prev_constructor_id <> next_constructor_id      -- switched teams
)
SELECT AVG(first_missed_round) AS avg_first_missed_round,
       AVG(last_missed_round)  AS avg_last_missed_round
FROM   qualified_gaps;
```
