Query:
-- 1. Preview participation data: driver, constructor and round of every race
SELECT r.driver_id,
       d.surname AS driver_name,
       r.constructor_id,
       c.name  AS constructor_name,
       ra.year,
       ra.round
FROM   results       AS r
JOIN   races         AS ra ON ra.race_id = r.race_id
JOIN   drivers       AS d  ON d.driver_id = r.driver_id
JOIN   constructors  AS c  ON c.constructor_id = r.constructor_id
LIMIT 20;
