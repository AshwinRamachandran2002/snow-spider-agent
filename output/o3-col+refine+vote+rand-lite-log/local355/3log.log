Query:
-- 5. Show only gaps where 1–2 races were missed (next_round - prev_round - 1 = 1 or 2)
SELECT driver_id,
       year,
       prev_round,
       next_round,
       (next_round - prev_round - 1) AS missed_count
FROM (
    SELECT r.driver_id,
           ra.year,
           ra.round                              AS prev_round,
           LEAD(ra.round)        OVER (PARTITION BY r.driver_id, ra.year ORDER BY ra.round) AS next_round
    FROM   results r
    JOIN   races   ra ON ra.race_id = r.race_id
) 
WHERE next_round IS NOT NULL
  AND (next_round - prev_round - 1) BETWEEN 1 AND 2
LIMIT 20;
