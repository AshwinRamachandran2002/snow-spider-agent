Query:
-- 4. Add the next round the driver appears in (LEAD) to spot gaps
SELECT r.driver_id,
       ra.year,
       ra.round                         AS prev_round,
       LEAD(ra.round) OVER (PARTITION BY r.driver_id, ra.year 
                            ORDER BY ra.round)          AS next_round
FROM   results r
JOIN   races   ra ON ra.race_id = r.race_id
WHERE  r.driver_id = 1 
  AND  ra.year = 2009
ORDER BY ra.round
LIMIT 20;
