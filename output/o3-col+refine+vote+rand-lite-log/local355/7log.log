-- Description: Show illustrative cases where the driver missed exactly one race
--              and returned with a different constructor, to validate that the
--              gap logic works as intended.
WITH stints AS (
    SELECT
        "year",
        "driver_id",
        "constructor_id",
        "first_round",
        "last_round"
    FROM "drives"
),
gaps AS (
    SELECT
        s1."driver_id",
        s1."year",
        s1."last_round" + 1                        AS first_missed_round,
        s2."first_round" - 1                       AS last_missed_round,
        (s2."first_round" - s1."last_round" - 1)   AS races_missed,
        s1."constructor_id"                        AS before_constructor,
        s2."constructor_id"                        AS after_constructor
    FROM   stints AS s1
    JOIN   stints AS s2
      ON   s1."driver_id" = s2."driver_id"
     AND   s1."year"      = s2."year"
     AND   s1."last_round" < s2."first_round"
)
SELECT
    "driver_id",
    "year",
    first_missed_round,
    last_missed_round,
    races_missed,
    before_constructor,
    after_constructor
FROM   gaps
WHERE  races_missed = 1
  AND  before_constructor <> after_constructor
ORDER BY "year", "driver_id"
LIMIT 20
