  AND d1."year"      = 1950
ORDER BY d1."last_round"
LIMIT 20;
```

```sql
-- Description: Build a list of all mid-season gaps (<3 races missed) where the driver switched constructor afterwards.
WITH stints AS (
    SELECT "year",
           "driver_id",
           "constructor_id",
           "first_round",
           "last_round"
    FROM   "drives"
),
gaps AS (
    SELECT s1."driver_id",
           s1."year",
           s1."last_round" + 1            AS first_missed_round,
           s2."first_round" - 1           AS last_missed_round,
           (s2."first_round" - s1."last_round" - 1) AS races_missed,
           s1."constructor_id"            AS before_constructor,
           s2."constructor_id"            AS after_constructor
    FROM   stints AS s1
    JOIN   stints AS s2
      ON   s1."driver_id" = s2."driver_id"
     AND   s1."year"      = s2."year"
     AND   s1."last_round" < s2."first_round"
)
SELECT *
FROM   gaps
WHERE  races_missed > 0
  AND  races_missed < 3          -- fewer than three races missed
  AND  before_constructor <> after_constructor   -- constructor change
ORDER BY "year", "driver_id"
LIMIT 20;
```

```sql
-- Description: Compute the overall average first_round and last_round of the missed-race windows that satisfy the criteria.
WITH stints AS (
    SELECT "year",
           "driver_id",
           "constructor_id",
           "first_round",
           "last_round"
    FROM   "drives"
),
gaps AS (
    SELECT s1."driver_id",
           s1."year",
           s1."last_round" + 1              AS first_missed_round,
           s2."first_round" - 1             AS last_missed_round,
           (s2."first_round" - s1."last_round" - 1) AS races_missed,
           s1."constructor_id"              AS before_constructor,
           s2."constructor_id"              AS after_constructor
    FROM   stints AS s1
    JOIN   stints AS s2
      ON   s1."driver_id" = s2."driver_id"
     AND   s1."year"      = s2."year"
     AND   s1."last_round" < s2."first_round"
),
qualified_gaps AS (
    SELECT *
    FROM   gaps
    WHERE  races_missed > 0
      AND  races_missed < 3
      AND  before_constructor <> after_constructor
)
SELECT AVG(first_missed_round) AS avg_first_round_missed,
       AVG(last_missed_round)  AS avg_last_round_missed
FROM   qualified_gaps;
```

