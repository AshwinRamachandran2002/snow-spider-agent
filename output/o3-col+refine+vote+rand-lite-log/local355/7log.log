-- Description: Build a list of every mid-season gap in which (a) the driver missed fewer than
--              three races and (b) changed constructor after the hiatus.  It shows the round
--              numbers on each side of the gap, how many races were missed, and the teams
--              before/after the break.
WITH stints AS (
    SELECT
        "year",
        "driver_id",
        "constructor_id",
        "first_round",
        "last_round"
    FROM "drives"
),
gaps AS (
    SELECT
        s1."driver_id",
        s1."year",
        s1."last_round" + 1                        AS first_missed_round,
        s2."first_round" - 1                       AS last_missed_round,
        (s2."first_round" - s1."last_round" - 1)   AS races_missed,
        s1."constructor_id"                        AS before_constructor,
        s2."constructor_id"                        AS after_constructor
    FROM   stints AS s1
    JOIN   stints AS s2
      ON   s1."driver_id" = s2."driver_id"
     AND   s1."year"      = s2."year"
     AND   s1."last_round" < s2."first_round"
)
SELECT
    "driver_id",
    "year",
    first_missed_round,
    last_missed_round,
    races_missed,
    before_constructor,
    after_constructor
FROM   gaps
WHERE  races_missed BETWEEN 1 AND 2         -- fewer than three races missed
  AND  before_constructor <> after_constructor
ORDER BY "year", "driver_id"
LIMIT 20;
