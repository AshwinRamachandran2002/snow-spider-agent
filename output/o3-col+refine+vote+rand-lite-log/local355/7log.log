-- Description: Find driver-season pairs that contain more than one stint (possible mid-season gaps).
SELECT "year",
       "driver_id",
       COUNT(*) AS drive_stints
FROM "drives"
GROUP BY "year", "driver_id"
HAVING drive_stints > 1
ORDER BY "year", "driver_id"
LIMIT 20;
