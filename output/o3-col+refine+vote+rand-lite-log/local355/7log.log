```sql
-- Description (thinking process):
-- 1. Each row in the "drives" table is a continuous stint for a driver in a season,
--    telling us the constructor and the first/last grand-prix rounds of that stint.
-- 2. A mid-season “hiatus” exists when two stints for the same driver in the same
--    year are separated by at least one round:  s1.last_round < s2.first_round.
-- 3. For every such pair we can calculate:
--      • first_missed_round = s1.last_round + 1
--      • last_missed_round  = s2.first_round – 1
--      • races_missed       = s2.first_round – s1.last_round – 1
-- 4. We keep only those gaps where:
--      • races_missed is 1 or 2   (i.e., < 3 races missed), and
--      • the constructor before the gap differs from the constructor after the gap.
-- 5. Finally, we take the overall (not per-year) averages of first_missed_round
--    and last_missed_round across all qualified gaps.
WITH stints AS (
    SELECT
        "year",
        "driver_id",
        "constructor_id",
        "first_round",
        "last_round"
    FROM "drives"
),
gaps AS (
    SELECT
        s1."driver_id",
        s1."year",
        s1."last_round" + 1                        AS first_missed_round,
        s2."first_round" - 1                       AS last_missed_round,
        (s2."first_round" - s1."last_round" - 1)   AS races_missed,
        s1."constructor_id"                        AS before_constructor,
        s2."constructor_id"                        AS after_constructor
    FROM   stints AS s1
    JOIN   stints AS s2
      ON   s1."driver_id" = s2."driver_id"
     AND   s1."year"      = s2."year"
     AND   s1."last_round" < s2."first_round"
)
SELECT
    AVG(first_missed_round) AS avg_first_round_missed,
    AVG(last_missed_round)  AS avg_last_round_missed
FROM gaps
WHERE races_missed BETWEEN 1 AND 2        -- fewer than three races missed
  AND before_constructor <> after_constructor;
```
