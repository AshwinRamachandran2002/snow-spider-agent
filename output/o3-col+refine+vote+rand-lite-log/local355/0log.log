Query:
--Description: 3) For every driver-year start, append the next round and constructor to reveal gaps between consecutive appearances.
WITH driver_races AS (
  SELECT
         res.driver_id,
         r.year,
         r.round,
         res.constructor_id,
         LEAD(r.round)            OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS next_round,
         LEAD(res.constructor_id) OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS next_constructor
  FROM results AS res
  JOIN races   AS r ON r.race_id = res.race_id
)
SELECT *
FROM driver_races
WHERE next_round - round > 0            -- highlights any gap
ORDER BY driver_id, year, round
LIMIT 20
