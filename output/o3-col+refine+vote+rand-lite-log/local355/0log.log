         next_round - 1      AS last_missed_round,
         (next_round - round - 1) AS races_missed,
         constructor_id      AS before_constructor,
         next_constructor    AS after_constructor
  FROM driver_races
  WHERE next_round IS NOT NULL
    AND next_round - round > 1
),
qualified_hiatus AS (
  SELECT *
  FROM hiatus
  WHERE races_missed < 3
    AND before_constructor <> after_constructor
)
SELECT AVG(first_missed_round) AS avg_first_missed_round,
       AVG(last_missed_round)  AS avg_last_missed_round
FROM qualified_hiatus;
```
