```sql
-- 1) Preview a driver’s appearances with race year, round and constructor
SELECT DISTINCT r.year, r.round, dr.driver_id, d.forename || ' ' || d.surname AS driver,
       res.constructor_id
FROM results AS res
JOIN races   AS r  ON r.race_id = res.race_id
JOIN drivers AS d  ON d.driver_id = res.driver_id
WHERE d.driver_id = 1            -- Lewis Hamilton as example
ORDER BY r.year, r.round
LIMIT 20;
```

```sql
-- 2) List every driver-year appearance (one row per start)
SELECT DISTINCT res.driver_id,
       r.year,
       r.round,
       res.constructor_id
FROM results AS res
JOIN races   AS r  ON r.race_id = res.race_id
ORDER BY res.driver_id, r.year, r.round
LIMIT 20;
```

```sql
-- 3) For every driver-year, add the round of the next appearance
WITH driver_races AS (
  SELECT res.driver_id,
         r.year,
         r.round,
         res.constructor_id,
         LEAD(r.round)          OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS next_round,
         LEAD(res.constructor_id) OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS next_constructor
  FROM results AS res
  JOIN races   AS r ON r.race_id = res.race_id
)
SELECT *
FROM driver_races
WHERE next_round - round > 0        -- shows the gap size
ORDER BY driver_id, year, round
LIMIT 20;
```

```sql
-- 4) Identify every mid-season hiatus (gap between starts)
WITH driver_races AS (
  SELECT res.driver_id,
         r.year,
         r.round,
         res.constructor_id,
         LEAD(r.round)            OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS next_round,
         LEAD(res.constructor_id) OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS next_constructor
  FROM results AS res
  JOIN races   AS r ON r.race_id = res.race_id
),
hiatus AS (
  SELECT driver_id,
         year,
         round + 1                       AS first_missed_round,
         next_round - 1                  AS last_missed_round,
         (next_round - round - 1)        AS races_missed,
         constructor_id                  AS before_constructor,
         next_constructor                AS after_constructor
  FROM driver_races
  WHERE next_round IS NOT NULL
    AND next_round - round > 1           -- at least one race skipped
)
SELECT *
FROM hiatus
ORDER BY driver_id, year, first_missed_round
LIMIT 20;
```

```sql
-- 5) Keep only hiatuses of < 3 races and with a team switch
WITH driver_races AS (
  SELECT res.driver_id,
         r.year,
         r.round,
         res.constructor_id,
         LEAD(r.round)            OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS next_round,
         LEAD(res.constructor_id) OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS next_constructor
  FROM results AS res
  JOIN races   AS r ON r.race_id = res.race_id
),
hiatus AS (
  SELECT driver_id,
         year,
         round + 1           AS first_missed_round,
         next_round - 1      AS last_missed_round,
         (next_round - round - 1) AS races_missed,
         constructor_id      AS before_constructor,
         next_constructor    AS after_constructor
  FROM driver_races
  WHERE next_round IS NOT NULL
    AND next_round - round > 1
),
qualified_hiatus AS (
  SELECT *
  FROM hiatus
  WHERE races_missed < 3                -- missed fewer than three races
    AND before_constructor <> after_constructor   -- switched teams
)
SELECT *
FROM qualified_hiatus
ORDER BY year, driver_id
LIMIT 20;
```

```sql
