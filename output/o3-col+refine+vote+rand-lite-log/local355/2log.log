Query:
-- 6. Identify contiguous ‘hiatus’ segments (<3 races) inside those seasons
WITH calendar AS (
  SELECT ds."year",
         ds."driver_id",
         ra."round",
         CASE WHEN res."driver_id" IS NULL THEN 0 ELSE 1 END            AS started,
         res."constructor_id",
         LAG(CASE WHEN res."driver_id" IS NULL THEN 0 ELSE 1 END)
             OVER (PARTITION BY ds."year", ds."driver_id" ORDER BY ra."round") AS prev_started,
         LEAD(CASE WHEN res."driver_id" IS NULL THEN 0 ELSE 1 END)
             OVER (PARTITION BY ds."year", ds."driver_id" ORDER BY ra."round") AS next_started
  FROM   (SELECT r."year", res."driver_id"
          FROM   "results" AS res
          JOIN   "races"   AS r ON r."race_id" = res."race_id"
          GROUP  BY r."year", res."driver_id"
          HAVING (SELECT COUNT(*) FROM "races" WHERE "year" = r."year")
                 - COUNT(*) < 3) AS ds
  JOIN   "races"        AS ra   ON ra."year" = ds."year"
  LEFT JOIN "results"   AS res  ON res."race_id"   = ra."race_id"
                                AND res."driver_id" = ds."driver_id"
),
hiatuses AS (
  SELECT "year",
         "driver_id",
         "round"                     AS first_missed_round,
         (SELECT MIN("round")
          FROM   calendar AS c2
          WHERE  c2."year"      = c1."year"
            AND  c2."driver_id" = c1."driver_id"
            AND  c2."round"     >= c1."round"
            AND  c2."started"   = 0
            AND  (c2."round" = c1."round"
                 OR EXISTS (SELECT 1
                            WHERE c2."round" = c1."round" + 1
                              AND c1."started" = 0)))            AS last_missed_round
  FROM   calendar AS c1
  WHERE  c1."started" = 0
    AND  c1."prev_started" = 1       -- immediately preceded by a start
)
SELECT DISTINCT *
FROM   hiatuses
LIMIT 20;
Answer:
year,driver_id,first_missed_round,last_missed_round
