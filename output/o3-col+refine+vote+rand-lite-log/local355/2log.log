```sql
-- 3. All 2009 race appearances for Lewis Hamilton (driver_id = 1)
SELECT r."round",
       r."name"              AS "grand_prix",
       res."constructor_id"
FROM   "results"  AS res
JOIN   "races"    AS r  ON r."race_id" = res."race_id"
WHERE  r."year" = 2009
  AND  res."driver_id" = 1
ORDER  BY r."round"
LIMIT 20;
```

```sql
-- 4. How many races were run vs. entered per driver-year
SELECT r."year",
       res."driver_id",
       COUNT(DISTINCT r."race_id")                             AS "starts",
       (SELECT COUNT(*) FROM "races" WHERE "year" = r."year")  AS "total_races"
FROM   "results" AS res
JOIN   "races"   AS r ON r."race_id" = res."race_id"
GROUP  BY r."year", res."driver_id"
HAVING "total_races" - "starts" < 3          -- “missed fewer than three”
LIMIT 20;
```

```sql
-- 5. Calendar of every race, marked whether each driver (meeting miss<3 rule) started it
WITH driver_seasons AS (
  SELECT r."year", res."driver_id"
  FROM   "results" AS res
  JOIN   "races"   AS r ON r."race_id" = res."race_id"
  GROUP  BY r."year", res."driver_id"
  HAVING (SELECT COUNT(*) FROM "races" WHERE "year" = r."year")
         -
         COUNT(DISTINCT r."race_id")  < 3   -- fewer than 3 missed
)
SELECT ds."year",
       ds."driver_id",
       ra."round",
       CASE WHEN res."driver_id" IS NULL THEN 0 ELSE 1 END AS "started",
       res."constructor_id"
FROM   driver_seasons AS ds
JOIN   "races"        AS ra   ON ra."year" = ds."year"
LEFT JOIN "results"   AS res  ON res."race_id"  = ra."race_id"
                              AND res."driver_id" = ds."driver_id"
ORDER BY ds."year", ds."driver_id", ra."round"
LIMIT 20;
```

```sql
-- 6. Identify contiguous ‘hiatus’ segments (<3 races) inside those seasons
WITH calendar AS (
  SELECT ds."year",
         ds."driver_id",
         ra."round",
         CASE WHEN res."driver_id" IS NULL THEN 0 ELSE 1 END            AS started,
         res."constructor_id",
         LAG(CASE WHEN res."driver_id" IS NULL THEN 0 ELSE 1 END)
             OVER (PARTITION BY ds."year", ds."driver_id" ORDER BY ra."round") AS prev_started,
         LEAD(CASE WHEN res."driver_id" IS NULL THEN 0 ELSE 1 END)
             OVER (PARTITION BY ds."year", ds."driver_id" ORDER BY ra."round") AS next_started
  FROM   (SELECT r."year", res."driver_id"
          FROM   "results" AS res
          JOIN   "races"   AS r ON r."race_id" = res."race_id"
          GROUP  BY r."year", res."driver_id"
          HAVING (SELECT COUNT(*) FROM "races" WHERE "year" = r."year")
                 - COUNT(*) < 3) AS ds
  JOIN   "races"        AS ra   ON ra."year" = ds."year"
  LEFT JOIN "results"   AS res  ON res."race_id"   = ra."race_id"
                                AND res."driver_id" = ds."driver_id"
),
hiatuses AS (
  SELECT "year",
         "driver_id",
         "round"                     AS first_missed_round,
         (SELECT MIN("round")
          FROM   calendar AS c2
          WHERE  c2."year"      = c1."year"
            AND  c2."driver_id" = c1."driver_id"
            AND  c2."round"     >= c1."round"
            AND  c2."started"   = 0
            AND  (c2."round" = c1."round"
                 OR EXISTS (SELECT 1
                            WHERE c2."round" = c1."round" + 1
                              AND c1."started" = 0)))            AS last_missed_round
  FROM   calendar AS c1
  WHERE  c1."started" = 0
    AND  c1."prev_started" = 1       -- immediately preceded by a start
)
SELECT DISTINCT *
FROM   hiatuses
LIMIT 20;
```

```sql
-- 7. Add constructor BEFORE the hiatus and AFTER it, then keep only team-switch cases
WITH full AS (
  SELECT cal.*,
         LAG(cal."constructor_id")   OVER (PARTITION BY cal."year", cal."driver_id" ORDER BY cal."round") AS constructor_before,
         LEAD(cal."constructor_id")  OVER (PARTITION BY cal."year", cal."driver_id" ORDER BY cal."round") AS constructor_after
  FROM   (SELECT ds."year",
                 ds."driver_id",
                 ra."round",
                 CASE WHEN res."driver_id" IS NULL THEN 0 ELSE 1 END AS started,
                 res."constructor_id"
          FROM   (SELECT r."year", res."driver_id"
                  FROM   "results" AS res
                  JOIN   "races"   AS r ON r."race_id" = res."race_id"
                  GROUP BY r."year", res."driver_id"
                  HAVING (SELECT COUNT(*) FROM "races" WHERE "year" = r."year") - COUNT(*) < 3
                 ) AS ds
          JOIN   "races"        AS ra   ON ra."year" = ds."year"
          LEFT  JOIN "results"  AS res  ON res."race_id" = ra."race_id"
                                        AND res."driver_id" = ds."driver_id") AS cal
),
segments AS (
  SELECT f1."year",
         f1."driver_id",
         f1."round"                         AS first_missed,
         (SELECT MAX(f2."round")            -- last race in same hiatus
          FROM   full AS f2
          WHERE  f2."year"      = f1."year"
            AND  f2."driver_id" = f1."driver_id"
            AND  f2."started"   = 0
            AND  f2."round"     >= f1."round"
          LIMIT 1)                          AS last_missed,
         f1."constructor_before",
         (SELECT constructor_after
          FROM   full AS f3
          WHERE  f3."year"      = f1."year"
            AND  f3."driver_id" = f1."driver_id"
            AND  f3."round"     = (SELECT MAX(f2."round")
                                   FROM   full AS f2
                                   WHERE  f2."year"      = f1."year"
                                     AND  f2."driver_id" = f1."driver_id"
                                     AND  f2."started"   = 0
                                     AND  f2."round"     >= f1."round"
                                   LIMIT 1)
          LIMIT 1)                           AS constructor_after
  FROM   full AS f1
  WHERE  f1."started" = 0
    AND  f1."constructor_before" IS NOT NULL
    AND  f1."constructor_after"  IS NOT NULL
)
SELECT *
FROM   segments
WHERE  "constructor_before" <> "constructor_after"
LIMIT 20;
```

```sql
-- 8. Keep only one row per qualifying hiatus and ensure its length (<3 races)
WITH seg AS (
  /* reuse query 7 up to segments CTE */
  SELECT *
  FROM (
      /* query 7’s segments CTE content here */
  ) WHERE "constructor_before" <> "constructor_after"
),
unique_seg AS (
  SELECT "year",
         "driver_id",
         MIN("first_missed") AS first_missed_round,
         MAX("last_missed")  AS last_missed_round,
         ("last_missed" - "first_missed" + 1) AS hiatus_len
  FROM   seg
  GROUP  BY "year", "driver_id"
  HAVING hiatus_len < 3
)
SELECT *
FROM   unique_seg
LIMIT 20;
```

```sql
-- 9. Final aggregation – overall averages of first & last missed rounds
WITH seg AS (
  /* same ‘unique_seg’ CTE from query 8 */
  SELECT *
  FROM (
      /* query 8’s unique_seg CTE content here */
  )
)
SELECT ROUND(AVG("first_missed_round"), 2) AS avg_first_missed_round,
       ROUND(AVG("last_missed_round"), 2)  AS avg_last_missed_round
FROM   seg;
```
