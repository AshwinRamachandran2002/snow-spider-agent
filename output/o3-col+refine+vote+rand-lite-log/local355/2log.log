Query:
-- 4. How many races were run vs. entered per driver-year
SELECT r."year",
       res."driver_id",
       COUNT(DISTINCT r."race_id")                             AS "starts",
       (SELECT COUNT(*) FROM "races" WHERE "year" = r."year")  AS "total_races"
FROM   "results" AS res
JOIN   "races"   AS r ON r."race_id" = res."race_id"
GROUP  BY r."year", res."driver_id"
HAVING "total_races" - "starts" < 3          -- “missed fewer than three”
LIMIT 20;
