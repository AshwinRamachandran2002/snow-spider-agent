Query:
-- 7. Add constructor BEFORE the hiatus and AFTER it, then keep only team-switch cases
WITH full AS (
  SELECT cal.*,
         LAG(cal."constructor_id")   OVER (PARTITION BY cal."year", cal."driver_id" ORDER BY cal."round") AS constructor_before,
         LEAD(cal."constructor_id")  OVER (PARTITION BY cal."year", cal."driver_id" ORDER BY cal."round") AS constructor_after
  FROM   (SELECT ds."year",
                 ds."driver_id",
                 ra."round",
                 CASE WHEN res."driver_id" IS NULL THEN 0 ELSE 1 END AS started,
                 res."constructor_id"
          FROM   (SELECT r."year", res."driver_id"
                  FROM   "results" AS res
                  JOIN   "races"   AS r ON r."race_id" = res."race_id"
                  GROUP BY r."year", res."driver_id"
                  HAVING (SELECT COUNT(*) FROM "races" WHERE "year" = r."year") - COUNT(*) < 3
                 ) AS ds
          JOIN   "races"        AS ra   ON ra."year" = ds."year"
          LEFT  JOIN "results"  AS res  ON res."race_id" = ra."race_id"
                                        AND res."driver_id" = ds."driver_id") AS cal
),
segments AS (
  SELECT f1."year",
         f1."driver_id",
         f1."round"                         AS first_missed,
         (SELECT MAX(f2."round")            -- last race in same hiatus
          FROM   full AS f2
          WHERE  f2."year"      = f1."year"
            AND  f2."driver_id" = f1."driver_id"
            AND  f2."started"   = 0
            AND  f2."round"     >= f1."round"
          LIMIT 1)                          AS last_missed,
         f1."constructor_before",
         (SELECT constructor_after
          FROM   full AS f3
          WHERE  f3."year"      = f1."year"
            AND  f3."driver_id" = f1."driver_id"
            AND  f3."round"     = (SELECT MAX(f2."round")
                                   FROM   full AS f2
                                   WHERE  f2."year"      = f1."year"
                                     AND  f2."driver_id" = f1."driver_id"
                                     AND  f2."started"   = 0
                                     AND  f2."round"     >= f1."round"
                                   LIMIT 1)
          LIMIT 1)                           AS constructor_after
  FROM   full AS f1
  WHERE  f1."started" = 0
    AND  f1."constructor_before" IS NOT NULL
    AND  f1."constructor_after"  IS NOT NULL
)
SELECT *
FROM   segments
WHERE  "constructor_before" <> "constructor_after"
LIMIT 20;
