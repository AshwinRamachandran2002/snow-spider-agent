```sql
--Description:  Overall averages of the first and last rounds missed in any short
--(1–2-race) hiatus where  (a) the driver missed fewer than three races that season
--and (b) changed constructor between the race immediately before and after the
--break.  The query:
--  • finds driver-seasons with <3 absences,
--  • expands them to a full calendar marking starts/absences and constructor info,
--  • detects hiatus starts (first skipped race after a start),
--  • locates the next race the driver starts (return race),
--  • keeps hiatuses whose constructors differ before vs. after,
--  • and finally returns the all-time average first- and last-missed rounds.
WITH season_rounds AS (                 -- total rounds in each year
     SELECT year, COUNT(*) AS total_rounds
     FROM   races
     GROUP  BY year
),
driver_seasons AS (                     -- driver-years with <3 races missed
     SELECT r.year,
            res.driver_id,
            COUNT(*)                        AS starts,
            sr.total_rounds
     FROM   results res
     JOIN   races   r  ON r.race_id = res.race_id
     JOIN   season_rounds sr ON sr.year = r.year
     GROUP  BY r.year, res.driver_id
     HAVING sr.total_rounds - COUNT(*) < 3
),
calendar AS (                           -- every round for those driver-years
     SELECT ds.year,
            ds.driver_id,
            ra.round,
            CASE WHEN res.driver_id IS NULL THEN 0 ELSE 1 END                 AS started,
            res.constructor_id,
            LAG(res.constructor_id)
                OVER (PARTITION BY ds.year, ds.driver_id ORDER BY ra.round)   AS constructor_before,
            LAG(CASE WHEN res.driver_id IS NULL THEN 0 ELSE 1 END)
                OVER (PARTITION BY ds.year, ds.driver_id ORDER BY ra.round)   AS prev_started
     FROM   driver_seasons ds
     JOIN   races          ra  ON ra.year = ds.year
     LEFT  JOIN results     res ON res.race_id  = ra.race_id
                                AND res.driver_id = ds.driver_id
),
hiatus_start AS (                       -- first skipped race of each hiatus
     SELECT year,
            driver_id,
            round                                   AS first_missed_round,
            constructor_before                      AS constructor_before
     FROM   calendar
     WHERE  started = 0
       AND  prev_started = 1                        -- previous race was a start
       AND  constructor_before IS NOT NULL
),
return_races AS (                       -- first subsequent start after hiatus
     SELECT hs.year,
            hs.driver_id,
            hs.first_missed_round,
            MIN(c.round) AS return_round
     FROM   hiatus_start hs
     JOIN   calendar c   ON c.year      = hs.year
                        AND c.driver_id = hs.driver_id
                        AND c.round    > hs.first_missed_round
                        AND c.started   = 1
     GROUP  BY hs.year, hs.driver_id, hs.first_missed_round
),
segments AS (                           -- combine to form valid hiatus segments
     SELECT hs.year,
            hs.driver_id,
            hs.first_missed_round,
            rr.return_round - 1                      AS last_missed_round,
            hs.constructor_before,
            ca.constructor_id                        AS constructor_after
     FROM   hiatus_start hs
     JOIN   return_races rr ON rr.year  = hs.year
                           AND rr.driver_id = hs.driver_id
                           AND rr.first_missed_round = hs.first_missed_round
     JOIN   calendar ca     ON ca.year  = rr.year
                           AND ca.driver_id = rr.driver_id
                           AND ca.round = rr.return_round
     WHERE  ca.constructor_id IS NOT NULL
       AND  hs.constructor_before <> ca.constructor_id   -- team switch
)
SELECT ROUND(AVG(first_missed_round), 2) AS avg_first_missed_round,
       ROUND(AVG(last_missed_round),  2) AS avg_last_missed_round
FROM   segments;
