-- 3. All 2009 race appearances for Lewis Hamilton (driver_id = 1)
SELECT r."round",
       r."name"              AS "grand_prix",
       res."constructor_id"
FROM   "results"  AS res
JOIN   "races"    AS r  ON r."race_id" = res."race_id"
WHERE  r."year" = 2009
  AND  res."driver_id" = 1
ORDER  BY r."round"
LIMIT 20;
