Query:
-- 5. Calendar of every race, marked whether each driver (meeting miss<3 rule) started it
WITH driver_seasons AS (
  SELECT r."year", res."driver_id"
  FROM   "results" AS res
  JOIN   "races"   AS r ON r."race_id" = res."race_id"
  GROUP  BY r."year", res."driver_id"
  HAVING (SELECT COUNT(*) FROM "races" WHERE "year" = r."year")
         -
         COUNT(DISTINCT r."race_id")  < 3   -- fewer than 3 missed
)
SELECT ds."year",
       ds."driver_id",
       ra."round",
       CASE WHEN res."driver_id" IS NULL THEN 0 ELSE 1 END AS "started",
       res."constructor_id"
FROM   driver_seasons AS ds
JOIN   "races"        AS ra   ON ra."year" = ds."year"
LEFT JOIN "results"   AS res  ON res."race_id"  = ra."race_id"
                              AND res."driver_id" = ds."driver_id"
ORDER BY ds."year", ds."driver_id", ra."round"
LIMIT 20;
