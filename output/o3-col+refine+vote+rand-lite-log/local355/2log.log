Query:
--Description:  Correct version of the “final aggregation” query.  
--It rebuilds the necessary CTE chain (driver_seasons → calendar → full → segments → unique_seg)  
--and finally returns the overall average of the first and last rounds missed.  
--The query keeps only those driver-years in which (1) the driver skipped <3 races
--in total and (2) the constructor immediately before the break differs from the
--constructor immediately after, with the break itself lasting just 1–2 races.

WITH season_rounds AS (                       -- number of rounds each season
    SELECT year, COUNT(*) AS total_rounds
    FROM   races
    GROUP  BY year
),
driver_seasons AS (                           -- driver-years with <3 missed races
    SELECT r.year,
           res.driver_id,
           COUNT(*)                    AS starts,
           sr.total_rounds
    FROM   results res
    JOIN   races   r  ON r.race_id = res.race_id
    JOIN   season_rounds sr ON sr.year = r.year
    GROUP  BY r.year, res.driver_id
    HAVING sr.total_rounds - COUNT(*) < 3
),
calendar AS (                                 -- every round for those seasons
    SELECT ds.year,
           ds.driver_id,
           ra.round,
           CASE WHEN res.driver_id IS NULL THEN 0 ELSE 1 END       AS started,
           res.constructor_id
    FROM   driver_seasons ds
    JOIN   races          ra  ON ra.year = ds.year
    LEFT  JOIN results     res ON res.race_id  = ra.race_id
                               AND res.driver_id = ds.driver_id
),
full AS (                                     -- add constructors before/after
    SELECT c.*,
           LAG(c.constructor_id)  OVER (PARTITION BY c.year, c.driver_id
                                        ORDER BY c.round)          AS constructor_before,
           LEAD(c.constructor_id) OVER (PARTITION BY c.year, c.driver_id
                                        ORDER BY c.round)          AS constructor_after,
           LAG(c.started)         OVER (PARTITION BY c.year, c.driver_id
                                        ORDER BY c.round)          AS prev_started,
           LEAD(c.started)        OVER (PARTITION BY c.year, c.driver_id
                                        ORDER BY c.round)          AS next_started
    FROM   calendar c
),
segments AS (                                 -- each hiatus start row
    SELECT f.year,
           f.driver_id,
           f.round                             AS first_missed_round,
           (SELECT MAX(f2.round)               -- last skipped round in same hiatus
            FROM   full f2
            WHERE  f2.year      = f.year
              AND  f2.driver_id = f.driver_id
              AND  f2.started   = 0
              AND  f2.round    >= f.round)     AS last_missed_round,
           f.constructor_before,
           (SELECT constructor_after           -- constructor after hiatus
            FROM   full f3
            WHERE  f3.year      = f.year
              AND  f3.driver_id = f.driver_id
              AND  f3.round     = (
                     SELECT MIN(f4.round)      -- first START after hiatus
                     FROM   full f4
                     WHERE  f4.year      = f.year
                       AND  f4.driver_id = f.driver_id
                       AND  f4.round    > f.round
                       AND  f4.started   = 1)
           )                                   AS constructor_after
    FROM   full f
    WHERE  f.started       = 0                -- a skipped race
      AND  f.prev_started  = 1                -- preceded by a start (hiatus begins)
      AND  f.constructor_before IS NOT NULL
      AND  f.next_started  = 0                -- still within the hiatus (protects 1-race season edge)
),
unique_seg AS (                               -- one row per driver-year hiatus
    SELECT year,
           driver_id,
           MIN(first_missed_round) AS first_missed_round,
           MAX(last_missed_round)  AS last_missed_round,
           MAX(last_missed_round) - MIN(first_missed_round) + 1 AS hiatus_len,
           MIN(constructor_before) AS constructor_before,
           MIN(constructor_after)  AS constructor_after
    FROM   segments
    GROUP  BY year, driver_id
    HAVING hiatus_len BETWEEN 1 AND 2                 -- short break
       AND constructor_before <> constructor_after    -- team switch
)
SELECT ROUND(AVG(first_missed_round), 2) AS avg_first_missed_round,
       ROUND(AVG(last_missed_round),  2) AS avg_last_missed_round
FROM   unique_seg
