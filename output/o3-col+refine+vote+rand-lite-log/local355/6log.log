```sql
--Description: 
--Goal → Overall averages of the first and last round numbers of short driver hiatuses (< 3 missed GPs) 
--         where the driver changes constructor between the race before and after the gap.  
--Logical steps (as CTEs):  
-- 1. driver_year_rounds  – for every driver-season build a full calendar of rounds, 
--                          mark participation and record constructor used when present.  
-- 2. misses              – within that calendar keep only non-participation rows and form groups of
--                          consecutive missed rounds with the “round – row_number” trick.  
-- 3. miss_groups         – summarise each gap: first/last round missed and its length,  
--                          keep only gaps shorter than 3 races.  
-- 4. qualified           – add the constructor immediately before and after the gap
--                          (must both exist and be different → team switch).  
-- 5. final SELECT        – compute the overall averages of first_round_missed and last_round_missed.  
WITH driver_year_rounds AS (
    SELECT 
        dy.driver_id,
        r.year,
        r.round,
        CASE WHEN res.result_id IS NULL THEN 0 ELSE 1 END AS participated,
        res.constructor_id
    FROM (
        SELECT DISTINCT res.driver_id, r.year
        FROM results AS res
        JOIN races   AS r ON r.race_id = res.race_id
    ) AS dy
    JOIN races AS r
      ON r.year = dy.year                     -- calendar of all rounds that season
    LEFT JOIN results AS res
      ON res.race_id  = r.race_id            -- participation & constructor
     AND res.driver_id = dy.driver_id
), 
misses AS (                                   -- consecutive missed rounds, labelled by grp
    SELECT *,
           round - ROW_NUMBER() OVER (PARTITION BY driver_id, year ORDER BY round) AS grp
    FROM driver_year_rounds
    WHERE participated = 0
), 
miss_groups AS (                              -- one row per hiatus
    SELECT driver_id,
           year,
           grp,
           MIN(round) AS first_round_missed,
           MAX(round) AS last_round_missed,
           COUNT(*)   AS missed_len
    FROM misses
    GROUP BY driver_id, year, grp
    HAVING missed_len < 3                    -- keep gaps of 1 or 2 races
), 
qualified AS (                               -- add constructor before & after; filter team-switches
    SELECT mg.*,
           (SELECT constructor_id
              FROM driver_year_rounds
             WHERE driver_id = mg.driver_id
               AND year      = mg.year
               AND participated = 1
               AND round    < mg.first_round_missed
             ORDER BY round DESC LIMIT 1) AS pre_team,
           (SELECT constructor_id
              FROM driver_year_rounds
             WHERE driver_id = mg.driver_id
               AND year      = mg.year
               AND participated = 1
               AND round    > mg.last_round_missed
             ORDER BY round ASC LIMIT 1) AS post_team
    FROM miss_groups AS mg
)
SELECT 
       AVG(first_round_missed) AS avg_first_round_missed,
       AVG(last_round_missed)  AS avg_last_round_missed
FROM qualified
WHERE pre_team IS NOT NULL
  AND post_team IS NOT NULL
  AND pre_team <> post_team;
