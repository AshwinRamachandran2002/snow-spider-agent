```sql
-- 3. Create a driver-year calendar: every round in a season and whether a driver took part
WITH drv_yrs AS (
  SELECT DISTINCT res."driver_id", r."year"
  FROM "results" AS res
  JOIN "races"  AS r ON r."race_id" = res."race_id"
)
SELECT dyr."driver_id", r."year", r."round",
       CASE WHEN res."result_id" IS NULL THEN 0 ELSE 1 END AS "participated"
FROM drv_yrs AS dyr
JOIN "races"  AS r  ON r."year" = dyr."year"
LEFT JOIN "results" AS res
       ON res."race_id" = r."race_id"
      AND res."driver_id" = dyr."driver_id"
ORDER BY dyr."driver_id", r."year", r."round"
LIMIT 20;
```

```sql
-- 4. List missed rounds (participated = 0) for one driver-year (example: driver 1, 2009)
WITH drv_cal AS (
  SELECT r."round", 
         CASE WHEN res."result_id" IS NULL THEN 0 ELSE 1 END AS "in_race"
  FROM  "races"  AS r
  LEFT JOIN "results" AS res
         ON res."race_id" = r."race_id"
        AND res."driver_id" = 1
  WHERE r."year" = 2009
)
SELECT "round"
FROM drv_cal
WHERE "in_race" = 0
ORDER BY "round"
LIMIT 20;
```

```sql
-- 5. Identify every consecutive block of missed races for all driver-years
WITH driver_year_rounds AS (
  SELECT dyr."driver_id", r."year", r."round",
         CASE WHEN res."result_id" IS NULL THEN 0 ELSE 1 END AS "participated"
  FROM (SELECT DISTINCT res."driver_id", r."year"
        FROM "results" AS res
        JOIN "races"  AS r ON r."race_id" = res."race_id") AS dyr
  JOIN "races"  AS r ON r."year" = dyr."year"
  LEFT JOIN "results" AS res
         ON res."race_id" = r."race_id"
        AND res."driver_id" = dyr."driver_id"
),
misses AS (
  SELECT *,
         "round" - ROW_NUMBER() OVER (PARTITION BY "driver_id","year" ORDER BY "round") AS grp
  FROM driver_year_rounds
  WHERE "participated" = 0
)
SELECT "driver_id", "year",
       MIN("round") AS first_round_missed,
       MAX("round") AS last_round_missed,
       COUNT(*)     AS missed_len
FROM misses
GROUP BY "driver_id", "year", grp
HAVING missed_len < 3                               -- only gaps < 3 races
ORDER BY "driver_id", "year"
LIMIT 20;
```

```sql
-- 6. Add constructor before and after each gap, keep only gaps with a team switch
WITH driver_year_rounds AS (
  SELECT dyr."driver_id", r."year", r."round",
         CASE WHEN res."result_id" IS NULL THEN 0 ELSE 1 END AS "participated",
         res."constructor_id"
  FROM (SELECT DISTINCT res."driver_id", r."year"
        FROM "results" AS res
        JOIN "races"  AS r ON r."race_id" = res."race_id") AS dyr
  JOIN "races"  AS r ON r."year" = dyr."year"
  LEFT JOIN "results" AS res
         ON res."race_id" = r."race_id"
        AND res."driver_id" = dyr."driver_id"
),
misses AS (
  SELECT *, "round" - ROW_NUMBER() OVER (PARTITION BY "driver_id","year" ORDER BY "round") AS grp
  FROM driver_year_rounds
  WHERE "participated" = 0
),
miss_groups AS (
  SELECT "driver_id", "year", grp,
         MIN("round") AS first_round_missed,
         MAX("round") AS last_round_missed,
         COUNT(*)     AS missed_len
  FROM misses
  GROUP BY "driver_id","year", grp
  HAVING missed_len < 3
),
with_teams AS (
  SELECT mg.*,
         (SELECT d1."constructor_id"
            FROM driver_year_rounds AS d1
           WHERE d1."driver_id" = mg."driver_id"
             AND d1."year"      = mg."year"
             AND d1."participated" = 1
             AND d1."round"   < mg.first_round_missed
           ORDER BY d1."round" DESC
           LIMIT 1) AS pre_team,
         (SELECT d2."constructor_id"
            FROM driver_year_rounds AS d2
           WHERE d2."driver_id" = mg."driver_id"
             AND d2."year"      = mg."year"
             AND d2."participated" = 1
             AND d2."round"   > mg.last_round_missed
           ORDER BY d2."round" ASC
           LIMIT 1) AS post_team
  FROM miss_groups AS mg
)
SELECT *
FROM with_teams
WHERE pre_team IS NOT NULL
  AND post_team IS NOT NULL
  AND pre_team <> post_team
ORDER BY "driver_id", "year"
LIMIT 20;
```

```sql
-- 7. Compute the overall averages of the first/last rounds of the qualified gaps
WITH driver_year_rounds AS (
  SELECT dyr."driver_id", r."year", r."round",
         CASE WHEN res."result_id" IS NULL THEN 0 ELSE 1 END AS "participated",
         res."constructor_id"
  FROM (SELECT DISTINCT res."driver_id", r."year"
        FROM "results" AS res
        JOIN "races"  AS r ON r."race_id" = res."race_id") AS dyr
  JOIN "races"  AS r ON r."year" = dyr."year"
  LEFT JOIN "results" AS res
         ON res."race_id" = r."race_id"
        AND res."driver_id" = dyr."driver_id"
),
misses AS (
  SELECT *, "round" - ROW_NUMBER() OVER (PARTITION BY "driver_id","year" ORDER BY "round") AS grp
  FROM driver_year_rounds
  WHERE "participated" = 0
),
miss_groups AS (
  SELECT "driver_id", "year", grp,
         MIN("round") AS first_round_missed,
         MAX("round") AS last_round_missed,
         COUNT(*)     AS missed_len
  FROM misses
  GROUP BY "driver_id","year", grp
  HAVING missed_len < 3
),
qualified AS (
  SELECT mg.*,
         (SELECT d1."constructor_id"
            FROM driver_year_rounds AS d1
           WHERE d1."driver_id" = mg."driver_id"
             AND d1."year"      = mg."year"
             AND d1."participated" = 1
             AND d1."round"   < mg.first_round_missed
           ORDER BY d1."round" DESC
           LIMIT 1) AS pre_team,
         (SELECT d2."constructor_id"
            FROM driver_year_rounds AS d2
           WHERE d2."driver_id" = mg."driver_id"
             AND d2."year"      = mg."year"
             AND d2."participated" = 1
             AND d2."round"   > mg.last_round_missed
           ORDER BY d2."round" ASC
           LIMIT 1) AS post_team
  FROM miss_groups AS mg
)
SELECT AVG(first_round_missed) AS "avg_first_round_missed",
       AVG(last_round_missed)  AS "avg_last_round_missed"
FROM qualified
WHERE pre_team IS NOT NULL
  AND post_team IS NOT NULL
  AND pre_team <> post_team;
