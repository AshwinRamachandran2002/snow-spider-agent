Query:
--Description: For each short gap (< 3 races) add the constructor immediately before and after it,
--keeping only gaps where a driver switched teams.
WITH driver_year_rounds AS (
    SELECT
        dy.driver_id,
        r.year,
        r.round,
        CASE WHEN res.result_id IS NULL THEN 0 ELSE 1 END AS participated,
        res.constructor_id
    FROM (
        SELECT DISTINCT res.driver_id, r.year
        FROM results AS res
        JOIN races   AS r ON r.race_id = res.race_id
    ) AS dy
    JOIN races AS r ON r.year = dy.year
    LEFT JOIN results AS res
      ON res.race_id  = r.race_id
     AND res.driver_id = dy.driver_id
),
misses AS (
    SELECT *,
           round - ROW_NUMBER() OVER (PARTITION BY driver_id, year ORDER BY round) AS grp
    FROM driver_year_rounds
    WHERE participated = 0
),
miss_groups AS (
    SELECT
        driver_id,
        year,
        grp,
        MIN(round) AS first_round_missed,
        MAX(round) AS last_round_missed,
        COUNT(*)   AS missed_len
    FROM misses
    GROUP BY driver_id, year, grp
    HAVING missed_len < 3
),
with_teams AS (
    SELECT
        mg.*,
        (SELECT constructor_id
           FROM driver_year_rounds
          WHERE driver_id = mg.driver_id
            AND year      = mg.year
            AND participated = 1
            AND round    < mg.first_round_missed
          ORDER BY round DESC
          LIMIT 1) AS pre_team,
        (SELECT constructor_id
           FROM driver_year_rounds
          WHERE driver_id = mg.driver_id
            AND year      = mg.year
            AND participated = 1
            AND round    > mg.last_round_missed
          ORDER BY round ASC
          LIMIT 1) AS post_team
    FROM miss_groups AS mg
)
SELECT *
FROM with_teams
WHERE pre_team IS NOT NULL
  AND post_team IS NOT NULL
  AND pre_team <> post_team              -- team switch
ORDER BY driver_id, year
LIMIT 20
