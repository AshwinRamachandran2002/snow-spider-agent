--Description: Detect every consecutive block of missed races (< 3 GPs) for all driver-seasons.
WITH driver_year_rounds AS (                         -- full calendar with participation flag
    SELECT
        dy.driver_id,
        r.year,
        r.round,
        CASE WHEN res.result_id IS NULL THEN 0 ELSE 1 END AS participated
    FROM (
