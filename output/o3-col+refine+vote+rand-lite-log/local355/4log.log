Below is a step-by-step exploration that finishes with the required overall averages.  
Every SQL statement is wrapped in a code block and preceded by a short description.

```sql
-- 1) Distinct seasons available
SELECT DISTINCT year 
FROM races
ORDER BY year
LIMIT 20;
```

```sql
-- 2) All rounds that took place in the 2009 season (sample season)
SELECT year, round, name
FROM races
WHERE year = 2009
ORDER BY round
LIMIT 20;
```

```sql
-- 3) A driver’s appearances: year, round and constructor (Lewis Hamilton = driver_id 1 as an example)
SELECT r.year, r.round, res.driver_id, res.constructor_id
FROM results  AS res
JOIN races    AS r ON r.race_id = res.race_id
WHERE res.driver_id = 1
ORDER BY r.year, r.round
LIMIT 20;
```

```sql
-- 4) Same information but with the previous round/constructor
SELECT
  res.driver_id,
  r.year,
  r.round,
  res.constructor_id,
  LAG(r.round)          OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS prev_round,
  LAG(res.constructor_id) OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS prev_constructor
FROM results AS res
JOIN races   AS r ON r.race_id = res.race_id
WHERE res.driver_id = 1
ORDER BY r.year, r.round
LIMIT 20;
```

```sql
-- 5) All drivers: potential gaps between consecutive appearances (gap length shown)
WITH appearances AS (
  SELECT
    res.driver_id,
    r.year,
    r.round,
    res.constructor_id,
    LAG(r.round)          OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS prev_round,
    LAG(res.constructor_id) OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS prev_constructor
  FROM results AS res
  JOIN races   AS r ON r.race_id = res.race_id
)
SELECT
  driver_id,
  year,
  prev_round,
  round              AS next_round,
  round - prev_round - 1 AS races_missed
FROM appearances
WHERE prev_round IS NOT NULL
  AND round - prev_round - 1 > 0        -- at least one race missed
ORDER BY races_missed, year, driver_id
LIMIT 20;
```

```sql
-- 6) Keep only hiatuses of <3 races (1-2) AND constructor change across the gap
WITH appearances AS (
  SELECT
    res.driver_id,
    r.year,
    r.round,
    res.constructor_id,
    LAG(r.round)          OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS prev_round,
    LAG(res.constructor_id) OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS prev_constructor
  FROM results AS res
  JOIN races   AS r ON r.race_id = res.race_id
)
SELECT
  driver_id,
  year,
  prev_round,
  round                     AS next_round,
  prev_round + 1            AS first_round_missed,
  round - 1                 AS last_round_missed,
  round - prev_round - 1    AS races_missed
FROM appearances
WHERE prev_round IS NOT NULL
  AND round - prev_round - 1 BETWEEN 1 AND 2     -- fewer than three races missed
  AND prev_constructor <> constructor_id         -- switched teams
ORDER BY year, driver_id
LIMIT 20;
```

```sql
-- 7) Compute the first & last rounds missed for every qualifying hiatus
WITH appearances AS (
  SELECT
    res.driver_id,
    r.year,
    r.round,
    res.constructor_id,
    LAG(r.round)          OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS prev_round,
    LAG(res.constructor_id) OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS prev_constructor
  FROM results AS res
  JOIN races   AS r ON r.race_id = res.race_id
),
gaps AS (
  SELECT
    driver_id,
    year,
    prev_round + 1 AS first_round_missed,
    round - 1      AS last_round_missed
  FROM appearances
  WHERE prev_round IS NOT NULL
    AND round - prev_round - 1 BETWEEN 1 AND 2
    AND prev_constructor <> constructor_id
)
SELECT *
FROM gaps
ORDER BY year, driver_id
LIMIT 20;
```

```sql
-- 8) FINAL ANSWER – overall averages of the first and last missed rounds
WITH appearances AS (
  SELECT
    res.driver_id,
    r.year,
    r.round,
    res.constructor_id,
    LAG(r.round)          OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS prev_round,
    LAG(res.constructor_id) OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS prev_constructor
  FROM results AS res
  JOIN races   AS r ON r.race_id = res.race_id
),
gaps AS (
  SELECT
    prev_round + 1 AS first_round_missed,
    round - 1      AS last_round_missed
  FROM appearances
  WHERE prev_round IS NOT NULL
    AND round - prev_round - 1 BETWEEN 1 AND 2     -- fewer than three races missed
    AND prev_constructor <> constructor_id         -- constructor change
)
SELECT
  AVG(first_round_missed) AS avg_first_round_missed,
  AVG(last_round_missed)  AS avg_last_round_missed
FROM gaps;
```

