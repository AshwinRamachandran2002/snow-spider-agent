Query:
-- 5) All drivers: potential gaps between consecutive appearances (gap length shown)
WITH appearances AS (
  SELECT
    res.driver_id,
    r.year,
    r.round,
    res.constructor_id,
    LAG(r.round)          OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS prev_round,
    LAG(res.constructor_id) OVER (PARTITION BY res.driver_id, r.year ORDER BY r.round) AS prev_constructor
  FROM results AS res
  JOIN races   AS r ON r.race_id = res.race_id
)
SELECT
  driver_id,
  year,
  prev_round,
  round              AS next_round,
  round - prev_round - 1 AS races_missed
FROM appearances
WHERE prev_round IS NOT NULL
  AND round - prev_round - 1 > 0        -- at least one race missed
ORDER BY races_missed, year, driver_id
LIMIT 20;
