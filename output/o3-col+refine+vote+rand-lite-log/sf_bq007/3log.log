```sql
--Description:
--Sample of ZIPs with 2015 vs 2018 median-income change & their State code
SELECT
  b."state_code",
  b."zip_code",
  z18."median_income"  AS "median_2018",
  z15."median_income"  AS "median_2015",
  (z18."median_income" - z15."median_income") AS "median_change"
FROM CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"                b
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR"  z15
     ON b."zip_code" = z15."geo_id"
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"  z18
     ON b."zip_code" = z18."geo_id"
LIMIT 20;
```

```sql
--Description:
--Average 2015→2018 median-income change by State (sample 20 rows)
SELECT
  b."state_code",
  AVG(z18."median_income" - z15."median_income") AS "avg_median_change"
FROM CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"                b
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR"  z15
     ON b."zip_code" = z15."geo_id"
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"  z18
     ON b."zip_code" = z18."geo_id"
GROUP BY b."state_code"
LIMIT 20;
```

```sql
--Description:
--Combine vulnerable-population score with income-change by State  
--(shows first 20 rows of the joined data set)
WITH vuln AS (
  SELECT
    "geo_id",
    0.38423645320197042 * "employed_wholesale_trade" +
    0.48071410777129553 * "occupation_natural_resources_construction_maintenance" +
    0.89455676291236841 * "employed_arts_entertainment_recreation_accommodation_food" +
    0.31315240083507306 * "employed_information" +
    0.51000000000000000 * "employed_retail_trade" +
    0.03929929839422874 * "employed_public_administration" +
    0.36555534476489654 * "occupation_services" +
    0.20323178400562944 * "employed_education_health_social" +
    0.36805065936180870 * "employed_transportation_warehousing_utilities" +
    0.40618955512572535 * "employed_manufacturing"  AS "vulnerable_pop_score"
  FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."STATE_2017_5YR"
), income AS (
  SELECT
    b."state_code",
    AVG(z18."median_income" - z15."median_income") AS "avg_median_change"
  FROM CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"                b
  JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR"  z15
       ON b."zip_code" = z15."geo_id"
  JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"  z18
       ON b."zip_code" = z18."geo_id"
  GROUP BY b."state_code"
)
SELECT
  f."state",
  f."postal_code",
  v."vulnerable_pop_score",
  i."avg_median_change"
FROM vuln v
JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"  f
     ON v."geo_id" = TO_CHAR(f."fips")           --assuming geo_id stores numeric FIPS as text
JOIN income i
     ON f."postal_code" = i."state_code"
ORDER BY v."vulnerable_pop_score" DESC
LIMIT 20;
```

```sql
--Description:
--Final step-by-step query to return the TOP-10 states by vulnerable population  
--and their average 2015→2018 median-income change
WITH vuln AS (
  SELECT
    "geo_id",
    0.38423645320197042 * "employed_wholesale_trade" +
    0.48071410777129553 * "occupation_natural_resources_construction_maintenance" +
    0.89455676291236841 * "employed_arts_entertainment_recreation_accommodation_food" +
    0.31315240083507306 * "employed_information" +
    0.51000000000000000 * "employed_retail_trade" +
    0.03929929839422874 * "employed_public_administration" +
    0.36555534476489654 * "occupation_services" +
    0.20323178400562944 * "employed_education_health_social" +
    0.36805065936180870 * "employed_transportation_warehousing_utilities" +
    0.40618955512572535 * "employed_manufacturing"  AS "vulnerable_pop_score"
  FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."STATE_2017_5YR"
), income AS (
  SELECT
    b."state_code",
    AVG(z18."median_income" - z15."median_income") AS "avg_median_change"
  FROM CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"                b
  JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR"  z15
       ON b."zip_code" = z15."geo_id"
  JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"  z18
       ON b."zip_code" = z18."geo_id"
  GROUP BY b."state_code"
), joined AS (
  SELECT
    f."state",
    f."postal_code",
    v."vulnerable_pop_score",
    i."avg_median_change"
  FROM vuln v
  JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"  f
       ON v."geo_id" = TO_CHAR(f."fips")
  JOIN income i
       ON f."postal_code" = i."state_code"
)
SELECT *
FROM joined
ORDER BY "vulnerable_pop_score" DESC
LIMIT 10;
```
