Query:
-- Description: FINAL ANSWER – total quantity of every ingredient used
WITH delivered AS (
       SELECT c."order_id", c."pizza_id"
       FROM   "pizza_clean_customer_orders" AS c
       JOIN   "pizza_clean_runner_orders"   AS r
              ON r."order_id" = c."order_id"
       WHERE  r."cancellation" IS NULL
),
base AS (
       SELECT d."order_id",
              json_extract(t.value,'$') AS topping_id
       FROM   delivered d
       JOIN   "pizza_recipes" pr ON pr."pizza_id" = d."pizza_id",
              json_each('['||pr."toppings"||']') t
),
excl AS (
       SELECT "order_id","exclusions" AS topping_id
       FROM   "pizza_get_exclusions"
),
xt AS (
       SELECT "order_id","extras" AS topping_id,"extras_count" AS qty
       FROM   "pizza_get_extras"
),
ft AS (
       SELECT b."order_id", b."topping_id", 1 AS qty
       FROM   base b
       LEFT  JOIN excl e
              ON e."order_id"  = b."order_id"
             AND e."topping_id"= b."topping_id"
       WHERE  e."topping_id" IS NULL
       UNION ALL
       SELECT "order_id","topping_id",qty FROM xt
)
SELECT pt."topping_name"                    AS ingredient,
       SUM(ft.qty)                          AS total_quantity
FROM   ft
JOIN   "pizza_toppings" pt
       ON pt."topping_id" = ft."topping_id"
GROUP  BY pt."topping_name"
ORDER  BY total_quantity DESC
LIMIT  20;
