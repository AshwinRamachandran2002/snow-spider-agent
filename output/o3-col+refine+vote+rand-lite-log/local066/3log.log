--Description: Expand each pizza’s “toppings” CSV into individual rows (no DISTINCT, so any repeats are kept);
--             then count how many times each (pizza_id, topping_id) pair appears.
--             If the count (cnt) is greater than 1, that topping ID is duplicated in the recipe.
WITH recipe_expanded AS (
  SELECT
         pr."pizza_id",
         CAST(json_each.value AS INTEGER) AS topping_id
  FROM  "pizza_recipes" AS pr,
        json_each('[' || REPLACE(pr."toppings", ' ', '') || ']')   -- turn CSV into JSON array & explode
),
dup_check AS (
  SELECT
         "pizza_id",
         "topping_id",
         COUNT(*) AS cnt
  FROM   recipe_expanded
  GROUP  BY "pizza_id", "topping_id"
)
SELECT
       "pizza_id",
       "topping_id",
       cnt AS duplicate_count
FROM   dup_check
WHERE  cnt > 1;
