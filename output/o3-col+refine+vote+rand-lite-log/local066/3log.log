```sql
-- 9. Sanity-check: total toppings used should equal delivered pizzas × average recipe length
WITH delivered AS (
  SELECT "pizza_id", COUNT(*) AS delivered_qty
  FROM   "pizza_runner_orders" AS r
  JOIN   "pizza_customer_orders" AS c ON r."order_id" = c."order_id"
  WHERE  r."cancellation" IS NULL
  GROUP  BY "pizza_id"
),
recipe_length AS (
  SELECT "pizza_id",
         (LENGTH(REPLACE("toppings",' ','')) - LENGTH(REPLACE(REPLACE("toppings",' ',''), ',', '')) + 1) AS num_toppings
  FROM   "pizza_recipes"
)
SELECT DISTINCT
       SUM(d.delivered_qty * rl.num_toppings) AS expected_total_toppings,
       (SELECT SUM(quantity_used) FROM (
          SELECT re."topping_id", SUM(d.delivered_qty) AS quantity_used
          FROM   (
                   SELECT DISTINCT pr."pizza_id",
                          CAST(json_each.value AS INTEGER) AS topping_id
                   FROM   "pizza_recipes" AS pr,
                          json_each('[' || REPLACE(pr."toppings", ' ', '') || ']')
                 ) AS re
          JOIN delivered AS d ON re."pizza_id" = d."pizza_id"
          GROUP BY re."topping_id"
        )) AS actual_total_toppings
FROM   delivered AS d
JOIN   recipe_length AS rl USING ("pizza_id")
LIMIT 20;
```

