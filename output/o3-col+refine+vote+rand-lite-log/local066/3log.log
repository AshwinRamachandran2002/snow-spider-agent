```sql
--Description (thinking process):
-- 1. Each row in pizza_recipes stores a pizza_id and a CSV list of topping IDs.
-- 2. To test for duplicates we must expand that CSV into separate rows.
--    We convert the CSV to a JSON array by wrapping it in brackets [], stripping spaces,
--    then explode it with json_each().
-- 3. After expansion we GROUP BY pizza_id and topping_id and count the rows.
-- 4. Any (pizza_id, topping_id) with COUNT(*) > 1 means the same topping
--    was listed more than once in that pizza’s recipe (i.e., a duplicate).
-- 5. Return those duplicate cases; if no rows are returned, the recipes are clean.
WITH recipe_expanded AS (
  SELECT
    pr."pizza_id",
    CAST(json_each.value AS INTEGER) AS topping_id
  FROM "pizza_recipes" AS pr,
       json_each('[' || REPLACE(pr."toppings", ' ', '') || ']')   -- explode CSV
)
SELECT
  "pizza_id",
  "topping_id",
  COUNT(*) AS duplicate_count
FROM recipe_expanded
GROUP BY "pizza_id", "topping_id"
HAVING COUNT(*) > 1;
```
