--Description: The earlier query returned no rows because the HAVING filter kept only
--             (pizza_id, topping_id) pairs with duplicate entries, and none exist.
--             To confirm that data truly contain no duplicates—and still get a non-empty
--             result—we drop the HAVING clause.  
--             Steps:
--               1. Turn each toppings CSV list into a JSON array, strip spaces, explode
--                  into individual rows (pizza_id, topping_id).
--               2. Count how many times each (pizza_id, topping_id) appears.
--               3. Show the first 20 counts.  If every cnt = 1, there are no duplicates.
WITH recipe_expanded AS (
  SELECT
         pr."pizza_id",
         CAST(json_each.value AS INTEGER) AS topping_id
  FROM  "pizza_recipes" AS pr,
        json_each('[' || REPLACE(pr."toppings", ' ', '') || ']')   -- explode CSV into rows
)
SELECT
       "pizza_id",
       "topping_id",
       COUNT(*) AS cnt
FROM   recipe_expanded
GROUP  BY "pizza_id", "topping_id"
ORDER  BY "pizza_id", "topping_id"
LIMIT 20;
