--Description: Sanity-check that the total number of toppings used in all delivered pizzas
--             equals the number we expect (delivered pizzas × recipe length).
--             FIX: removed the DISTINCT keyword from the recipe expansion so every topping
--             occurrence is counted; this guarantees duplicates (if any) contribute to the
--             “actual_total_toppings” figure.
WITH delivered AS (
  SELECT
        c."pizza_id",
        COUNT(*) AS delivered_qty
  FROM   "pizza_runner_orders"   AS r
  JOIN   "pizza_customer_orders" AS c
         ON r."order_id" = c."order_id"
  WHERE  r."cancellation" IS NULL
  GROUP  BY c."pizza_id"
),
recipe_length AS (
  SELECT
        "pizza_id",
        (LENGTH(REPLACE("toppings",' ','')) - LENGTH(REPLACE(REPLACE("toppings",' ',''), ',', '')) + 1) AS num_toppings
  FROM   "pizza_recipes"
),
recipe_expanded AS (                         -- no DISTINCT → every occurrence kept
