```sql
--Description: 2) Peek at the cleaned runner-orders table  
SELECT DISTINCT *
FROM "pizza_clean_runner_orders"
LIMIT 20;
```

```sql
--Description: 3) Find all order_ids that were actually delivered (no cancellation)  
SELECT DISTINCT "order_id"
FROM "pizza_clean_runner_orders"
WHERE "cancellation" IS NULL
LIMIT 20;
```

```sql
--Description: 4) Link delivered orders back to the pizzas that were ordered  
SELECT DISTINCT cco."order_id",
       cco."pizza_id"
FROM   "pizza_clean_customer_orders" AS cco
JOIN   "pizza_clean_runner_orders"  AS cro
       USING ("order_id")
WHERE  cro."cancellation" IS NULL
LIMIT 20;
```

```sql
--Description: 5) List the distinct pizzas that ever got delivered  
SELECT DISTINCT "pizza_id"
FROM   "pizza_clean_customer_orders" AS cco
JOIN   "pizza_clean_runner_orders"  AS cro
       USING ("order_id")
WHERE  cro."cancellation" IS NULL
LIMIT 20;
```

```sql
--Description: 6) Inspect the recipe (comma-separated topping ids) for each delivered pizza  
SELECT DISTINCT pr."pizza_id",
       pr."toppings"
FROM   "pizza_recipes" AS pr
JOIN  (
        SELECT DISTINCT "pizza_id"
        FROM   "pizza_clean_customer_orders" AS cco
        JOIN   "pizza_clean_runner_orders"  AS cro
               USING ("order_id")
        WHERE  cro."cancellation" IS NULL
      ) AS d  USING ("pizza_id")
LIMIT 20;
```

```sql
--Description: 7) Split each recipe string into one row per topping id (uses json_each to split the list)  
SELECT DISTINCT pr."pizza_id",
       CAST(TRIM(f.value) AS INTEGER) AS "topping_id"
FROM   "pizza_recipes" AS pr,
       json_each('[' || pr."toppings" || ']') AS f
LIMIT 20;
```

```sql
--Description: 8) FINAL – total quantity of every topping used in all delivered pizzas  
WITH delivered_orders AS (               -- only orders that got delivered
     SELECT "order_id"
     FROM   "pizza_clean_runner_orders"
     WHERE  "cancellation" IS NULL
),
delivered_pizzas AS (                    -- their corresponding pizzas
     SELECT cco."order_id",
            cco."pizza_id"
     FROM   "pizza_clean_customer_orders" AS cco
     JOIN   delivered_orders             USING ("order_id")
),
all_toppings AS (                        -- explode comma list → one row per topping
     SELECT dp."order_id",
            CAST(TRIM(j.value) AS INTEGER) AS "topping_id"
     FROM   delivered_pizzas  AS dp
     JOIN   "pizza_recipes"   AS pr  USING ("pizza_id"),
            json_each('[' || pr."toppings" || ']') AS j
)
SELECT pt."topping_name"  AS "ingredient",
       COUNT(*)           AS "quantity"
FROM   all_toppings AS t
JOIN   "pizza_toppings" AS pt  USING ("topping_id")
GROUP  BY pt."topping_name"
ORDER  BY "quantity" DESC;
```
