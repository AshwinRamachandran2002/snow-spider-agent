```sql
-- 1) Description: Look at the pizzas available in the menu
SELECT DISTINCT
       "pizza_id",
       "pizza_name"
FROM   "pizza_names"
LIMIT  20;
```

```sql
-- 2) Description: Inspect the master list of individual toppings we can work with
SELECT DISTINCT
       "topping_id",
       "topping_name"
FROM   "pizza_toppings"
LIMIT  20;
```

```sql
-- 3) Description: See how every pizza is built (comma-separated topping id list)
SELECT DISTINCT
       "pizza_id",
       "toppings"
FROM   "pizza_recipes"
LIMIT  20;
```

```sql
-- 4) Description: Check the raw customer orders that were placed
SELECT DISTINCT
       "order_id",
       "customer_id",
       "pizza_id",
       "exclusions",
       "extras",
       "order_time"
FROM   "pizza_customer_orders"
LIMIT  20;
```

```sql
-- 5) Description: Identify runner-side orders that were **actually delivered**
SELECT DISTINCT
       "order_id",
       "runner_id",
       "pickup_time",
       "distance",
       "duration"
FROM   "pizza_runner_orders"
WHERE  "cancellation" IS NULL
LIMIT  20;
```

```sql
-- 6) Description: Join delivered runner orders with the customer orders to know which pizzas got delivered
SELECT DISTINCT
       r."order_id",
       c."pizza_id"
FROM   "pizza_runner_orders"  AS r
JOIN   "pizza_customer_orders" AS c
       ON r."order_id" = c."order_id"
WHERE  r."cancellation" IS NULL
LIMIT  20;
```

```sql
-- 7) Description: Break the recipe of every delivered pizza into one row per topping id
WITH delivered AS (         -- delivered order ↔ pizza
     SELECT r."order_id", c."pizza_id"
     FROM   "pizza_runner_orders"  r
     JOIN   "pizza_customer_orders" c
            ON r."order_id" = c."order_id"
     WHERE  r."cancellation" IS NULL
),
recipe_lines AS (           -- attach the CSV recipe string
     SELECT d."order_id",
            d."pizza_id",
            pr."toppings"
     FROM   delivered d
     JOIN   "pizza_recipes" pr
            ON d."pizza_id" = pr."pizza_id"
),
-- recursive splitter to convert '1, 2, 3' → 3 rows
split(recipe_order, rest, topping_id) AS (
     SELECT "order_id",
            trim("toppings"),                -- rest
            NULL                            -- dummy
     FROM   recipe_lines
     UNION ALL
     SELECT recipe_order,
            CASE
                 WHEN instr(rest, ',') = 0
                 THEN ''
                 ELSE substr(rest, instr(rest, ',') + 1)
            END,
            CAST(trim( CASE
                          WHEN instr(rest, ',') = 0
                          THEN rest
                          ELSE substr(rest, 1, instr(rest, ',') - 1)
                       END ) AS INTEGER)
     FROM   split
     WHERE  rest <> ''
)
SELECT DISTINCT
       recipe_order AS "order_id",
       topping_id
FROM   split
WHERE  topping_id IS NOT NULL        -- get only real rows
LIMIT  20;
```

```sql
-- 8) Description: Final answer – total quantity of each ingredient actually used in delivered pizzas
WITH delivered AS (         -- delivered order ↔ pizza
     SELECT r."order_id", c."pizza_id"
     FROM   "pizza_runner_orders"  r
     JOIN   "pizza_customer_orders" c
            ON r."order_id" = c."order_id"
     WHERE  r."cancellation" IS NULL
),
recipe_lines AS (
     SELECT d."order_id",
            pr."toppings"
     FROM   delivered d
     JOIN   "pizza_recipes" pr
            ON d."pizza_id" = pr."pizza_id"
),
split(rest, topping_id) AS (
     SELECT trim("toppings"), NULL
     FROM   recipe_lines
     UNION ALL
     SELECT CASE
                 WHEN instr(rest, ',') = 0 THEN ''
                 ELSE substr(rest, instr(rest, ',') + 1)
            END,
            CAST(trim( CASE
                          WHEN instr(rest, ',') = 0
                          THEN rest
                          ELSE substr(rest, 1, instr(rest, ',') - 1)
                       END ) AS INTEGER)
     FROM   split
     WHERE  rest <> ''
)
SELECT  t."topping_name"  AS "ingredient",
        COUNT(*)          AS "qty_used"
FROM    split     s
JOIN    "pizza_toppings" t
        ON t."topping_id" = s."topping_id"
WHERE   s."topping_id" IS NOT NULL
GROUP BY t."topping_name"
ORDER BY "qty_used" DESC
LIMIT  20;
```
