8,1
10,1
Query:
-- 7) Description: Break the recipe of every delivered pizza into one row per topping id
WITH delivered AS (         -- delivered order ↔ pizza
     SELECT r."order_id", c."pizza_id"
     FROM   "pizza_runner_orders"  r
     JOIN   "pizza_customer_orders" c
            ON r."order_id" = c."order_id"
     WHERE  r."cancellation" IS NULL
),
recipe_lines AS (           -- attach the CSV recipe string
     SELECT d."order_id",
            d."pizza_id",
            pr."toppings"
     FROM   delivered d
     JOIN   "pizza_recipes" pr
            ON d."pizza_id" = pr."pizza_id"
),
-- recursive splitter to convert '1, 2, 3' → 3 rows
split(recipe_order, rest, topping_id) AS (
     SELECT "order_id",
            trim("toppings"),                -- rest
            NULL                            -- dummy
     FROM   recipe_lines
     UNION ALL
     SELECT recipe_order,
            CASE
                 WHEN instr(rest, ',') = 0
                 THEN ''
                 ELSE substr(rest, instr(rest, ',') + 1)
            END,
            CAST(trim( CASE
                          WHEN instr(rest, ',') = 0
                          THEN rest
                          ELSE substr(rest, 1, instr(rest, ',') - 1)
                       END ) AS INTEGER)
     FROM   split
     WHERE  rest <> ''
)
SELECT DISTINCT
       recipe_order AS "order_id",
       topping_id
FROM   split
WHERE  topping_id IS NOT NULL        -- get only real rows
LIMIT  20;
