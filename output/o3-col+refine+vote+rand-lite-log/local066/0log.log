-- Description: Look at toppings that customers *removed* (exclusions)
--              for the set of delivered orders.
SELECT  e."order_id",
        e."exclusions"          AS "topping_id",
        e."total_exclusions"
FROM    "pizza_get_exclusions"  AS e
WHERE   e."order_id" IN (
          SELECT "order_id"
          FROM   "pizza_runner_orders"
          WHERE  "cancellation" IS NULL
)
LIMIT 20;
