-- Description: Split the recipe for one sample pizza (id = 1) into
--              individual topping-ids using json_each on a
--              JSON-wrapped string.
SELECT  pr."pizza_id",
        CAST(json_extract(j.value, '$') AS INTEGER) AS "topping_id"
FROM    "pizza_recipes" AS pr,
        json_each('[' || pr."toppings" || ']') AS j
WHERE   pr."pizza_id" = 1
LIMIT 20;
