```sql
-- Description: Expand every delivered order into its *base* toppings
--              (before applying customer changes).
WITH delivered_orders AS (
    SELECT  co."order_id",
            co."pizza_id"
    FROM    "pizza_customer_orders" AS co
    JOIN    "pizza_runner_orders"   AS ro
               ON co."order_id" = ro."order_id"
    WHERE   ro."cancellation" IS NULL
)
SELECT  d."order_id",
        d."pizza_id",
        CAST(json_extract(j.value, '$') AS INTEGER) AS "topping_id"
FROM    delivered_orders        AS d
JOIN    "pizza_recipes"         AS pr  ON d."pizza_id" = pr."pizza_id",
        json_each('[' || pr."toppings" || ']') AS j
LIMIT 20;
```

```sql
-- Description: Look at toppings that customers *removed* (exclusions)
--              for the set of delivered orders.
SELECT  e."order_id",
        e."exclusions"          AS "topping_id",
        e."total_exclusions"
FROM    "pizza_get_exclusions"  AS e
WHERE   e."order_id" IN (
          SELECT "order_id"
          FROM   "pizza_runner_orders"
          WHERE  "cancellation" IS NULL
)
LIMIT 20;
```

```sql
-- Description: Look at toppings that customers *added* (extras) together
--              with how many units of each extra were requested.
SELECT  ex."order_id",
        ex."extras"             AS "topping_id",
        ex."extras_count"
FROM    "pizza_get_extras"      AS ex
WHERE   ex."order_id" IN (
          SELECT "order_id"
          FROM   "pizza_runner_orders"
          WHERE  "cancellation" IS NULL
)
LIMIT 20;
```

```sql
-- Description: Build the final list of toppings actually used in each
--              delivered pizza after removing exclusions and adding extras.
WITH delivered_orders AS (
    SELECT  co."order_id",
            co."pizza_id"
    FROM    "pizza_customer_orders" AS co
    JOIN    "pizza_runner_orders"   AS ro
               ON co."order_id" = ro."order_id"
    WHERE   ro."cancellation" IS NULL
),
base AS (                                   -- one row per base topping
    SELECT  d."order_id",
            CAST(json_extract(j.value, '$') AS INTEGER) AS "topping_id"
    FROM    delivered_orders        AS d
    JOIN    "pizza_recipes"         AS pr ON d."pizza_id" = pr."pizza_id",
            json_each('[' || pr."toppings" || ']') AS j
),
excl AS (
    SELECT  "order_id",
            "exclusions"  AS "topping_id"
    FROM    "pizza_get_exclusions"
),
extras AS (
    SELECT  "order_id",
            "extras"      AS "topping_id",
            "extras_count"
    FROM    "pizza_get_extras"
),
base_after_excl AS (                        -- drop excluded toppings
    SELECT  b."order_id",
            b."topping_id"
    FROM    base b
    LEFT JOIN excl e
           ON b."order_id"  = e."order_id"
          AND b."topping_id"= e."topping_id"
    WHERE   e."order_id" IS NULL
),
all_toppings AS (                           -- union base & extras with qty
    SELECT  "topping_id", 1            AS qty
    FROM    base_after_excl
    UNION ALL
    SELECT  "topping_id", "extras_count" AS qty
    FROM    extras
    WHERE   "order_id" IN (SELECT "order_id" FROM delivered_orders)
)
SELECT *
FROM   all_toppings
LIMIT 20;
```

```sql
-- Description: FINAL ANSWER – total quantity of every ingredient that
--              went into pizzas we actually delivered.
WITH delivered_orders AS (
    SELECT  co."order_id",
            co."pizza_id"
    FROM    "pizza_customer_orders" AS co
    JOIN    "pizza_runner_orders"   AS ro
               ON co."order_id" = ro."order_id"
    WHERE   ro."cancellation" IS NULL
),
base AS (
    SELECT  d."order_id",
            CAST(json_extract(j.value, '$') AS INTEGER) AS "topping_id"
    FROM    delivered_orders        AS d
    JOIN    "pizza_recipes"         AS pr ON d."pizza_id" = pr."pizza_id",
            json_each('[' || pr."toppings" || ']') AS j
),
excl AS (
    SELECT  "order_id",
            "exclusions"  AS "topping_id"
    FROM    "pizza_get_exclusions"
),
extras AS (
    SELECT  "order_id",
            "extras"      AS "topping_id",
            "extras_count"
    FROM    "pizza_get_extras"
),
base_after_excl AS (
    SELECT  b."order_id",
            b."topping_id"
    FROM    base b
    LEFT JOIN excl e
           ON b."order_id"  = e."order_id"
          AND b."topping_id"= e."topping_id"
    WHERE   e."order_id" IS NULL
),
all_toppings AS (
    -- 1 unit of every remaining base topping
    SELECT  "topping_id", 1            AS qty
    FROM    base_after_excl
    UNION ALL
    -- extras may contribute multiple units
    SELECT  "topping_id", "extras_count" AS qty
    FROM    extras
    WHERE   "order_id" IN (SELECT "order_id" FROM delivered_orders)
)
SELECT  pt."topping_name"  AS "ingredient",
        SUM(at.qty)        AS "total_quantity"
FROM    all_toppings  AS at
JOIN    "pizza_toppings" AS pt
          ON at."topping_id" = pt."topping_id"
GROUP BY pt."topping_name"
ORDER BY "total_quantity" DESC;
```
