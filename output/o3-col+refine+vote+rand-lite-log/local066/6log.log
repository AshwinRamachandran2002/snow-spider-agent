Query:
-- 6) Join the delivered orders back to the pizzas that were ordered  
SELECT d.order_id,
       c.customer_id,
       c.pizza_id,
       pn.pizza_name
FROM  pizza_clean_runner_orders AS d
JOIN  pizza_clean_customer_orders AS c USING (order_id)
JOIN  pizza_names                AS pn USING (pizza_id)
WHERE d.cancellation IS NULL
LIMIT 20;
