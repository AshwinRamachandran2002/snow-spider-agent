```sql
-- 1) Inspect all available topping names and their ids  
SELECT DISTINCT topping_id, topping_name
FROM pizza_toppings
LIMIT 20;
```

```sql
-- 2) Look at the raw toppings string stored for every pizza recipe  
SELECT DISTINCT pizza_id, toppings
FROM pizza_recipes
LIMIT 20;
```

```sql
-- 3) Join recipes with pizza_names to see which pizza contains which (raw) toppings list  
SELECT pn.pizza_name, pr.toppings
FROM pizza_recipes  AS pr
JOIN pizza_names    AS pn USING (pizza_id)
LIMIT 20;
```

```sql
-- 4) Preview all customer orders that were placed (before delivery-clean-up)  
SELECT DISTINCT order_id, customer_id, pizza_id, exclusions, extras, order_time
FROM pizza_customer_orders
LIMIT 20;
```

```sql
-- 5) Check which runner orders were actually delivered (cancellation IS NULL)  
SELECT DISTINCT order_id, runner_id, pickup_time, distance, duration
FROM pizza_clean_runner_orders
WHERE cancellation IS NULL
LIMIT 20;
```

```sql
-- 6) Join the delivered orders back to the pizzas that were ordered  
SELECT d.order_id,
       c.customer_id,
       c.pizza_id,
       pn.pizza_name
FROM  pizza_clean_runner_orders AS d
JOIN  pizza_clean_customer_orders AS c USING (order_id)
JOIN  pizza_names                AS pn USING (pizza_id)
WHERE d.cancellation IS NULL
LIMIT 20;
```

```sql
-- 7) For one delivered pizza, explode its toppings into separate rows (string → JSON array → rows)  
SELECT d.order_id,
       json_extract(j.value, '$')        AS topping_id
FROM  pizza_clean_runner_orders AS d
JOIN  pizza_clean_customer_orders AS c USING (order_id)
JOIN  pizza_recipes              AS pr USING (pizza_id)
     CROSS JOIN json_each('[' || pr.toppings || ']') AS j
WHERE d.cancellation IS NULL
  AND d.order_id = 1               -- (sample order)
LIMIT 20;
```

```sql
-- 8) Gather every topping used in every successfully delivered pizza  
WITH delivered AS (
    SELECT c.order_id, c.pizza_id
    FROM   pizza_clean_runner_orders AS r
    JOIN   pizza_clean_customer_orders AS c USING (order_id)
    WHERE  r.cancellation IS NULL
),
exploded AS (
    SELECT d.order_id,
           CAST(json_extract(j.value, '$') AS INTEGER) AS topping_id
    FROM   delivered AS d
    JOIN   pizza_recipes AS pr USING (pizza_id)
           CROSS JOIN json_each('[' || pr.toppings || ']') AS j
)
SELECT e.order_id, e.topping_id, t.topping_name
FROM   exploded AS e
JOIN   pizza_toppings AS t USING (topping_id)
LIMIT 20;
```

```sql
-- 9) FINAL ANSWER – total quantity of each ingredient (topping) used in all delivered pizzas  
WITH delivered AS (
    SELECT c.order_id, c.pizza_id
    FROM   pizza_clean_runner_orders AS r
    JOIN   pizza_clean_customer_orders AS c USING (order_id)
    WHERE  r.cancellation IS NULL
),
exploded AS (
    SELECT CAST(json_extract(j.value, '$') AS INTEGER) AS topping_id
    FROM   delivered AS d
    JOIN   pizza_recipes AS pr USING (pizza_id)
           CROSS JOIN json_each('[' || pr.toppings || ']') AS j
)
SELECT t.topping_name   AS ingredient,
       COUNT(*)         AS quantity
FROM   exploded AS e
JOIN   pizza_toppings AS t USING (topping_id)
GROUP  BY t.topping_name
ORDER  BY quantity DESC;
```
