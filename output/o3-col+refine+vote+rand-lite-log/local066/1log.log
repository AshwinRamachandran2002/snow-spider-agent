```sql
-- 1. Inspect all customer orders
SELECT *
FROM pizza_clean_customer_orders
LIMIT 20;
```

```sql
-- 2. Inspect all runner deliveries (only rows with a real pickup and no cancellation are “delivered”)
SELECT *
FROM pizza_clean_runner_orders
WHERE cancellation IS NULL
  AND pickup_time IS NOT NULL
LIMIT 20;
```

```sql
-- 3. Show the toppings-recipe strings for every pizza type
SELECT *
FROM pizza_recipes
LIMIT 20;
```

```sql
-- 4. Convert every pizza recipe into one-row-per-topping
--    (json_each() is an easy splitter for the comma list)
SELECT r.pizza_id,
       CAST(j.value AS INTEGER)      AS topping_id
FROM  (SELECT pizza_id,
              '['||REPLACE(toppings,' ','')||']' AS toppings_json
       FROM   pizza_recipes)  AS r,
      json_each(r.toppings_json)      AS j
LIMIT 20;
```

```sql
-- 5. List every delivered order together with every one of its “base” toppings
WITH delivered AS (
     SELECT co.order_id,
            co.pizza_id
     FROM   pizza_clean_customer_orders  AS co
     JOIN   pizza_clean_runner_orders    AS ro USING (order_id)
     WHERE  ro.cancellation IS NULL
       AND  ro.pickup_time IS NOT NULL)
SELECT d.order_id,
       rt.topping_id
FROM   delivered          AS d
JOIN   (SELECT r.pizza_id,
               CAST(j.value AS INTEGER) AS topping_id
        FROM  (SELECT pizza_id,
                      '['||REPLACE(toppings,' ','')||']' AS toppings_json
               FROM   pizza_recipes) AS r,
              json_each(r.toppings_json) AS j)  AS rt
       USING (pizza_id)
LIMIT 20;
```

```sql
-- 6. Look at any toppings the customer asked to be removed
SELECT order_id,
       exclusions AS topping_id
FROM   pizza_get_exclusions
LIMIT 20;
```

```sql
-- 7. Look at any extra toppings the customer added (with how many extra portions)
SELECT order_id,
       extras        AS topping_id,
       extras_count  AS qty
FROM   pizza_get_extras
LIMIT 20;
```

```sql
-- 8. Base toppings *after* removing exclusions (still one per pizza)
WITH delivered AS (
     SELECT co.order_id,
            co.pizza_id
     FROM   pizza_clean_customer_orders AS co
     JOIN   pizza_clean_runner_orders   AS ro USING (order_id)
     WHERE  ro.cancellation IS NULL
       AND  ro.pickup_time IS NOT NULL),
recipe AS (
     SELECT r.pizza_id,
            CAST(j.value AS INTEGER) AS topping_id
     FROM  (SELECT pizza_id,
                   '['||REPLACE(toppings,' ','')||']' AS toppings_json
            FROM   pizza_recipes) AS r,
           json_each(r.toppings_json) AS j),
base AS (
     SELECT d.order_id,
            recipe.topping_id
     FROM   delivered AS d
     JOIN   recipe    USING (pizza_id)),
excluded AS (
     SELECT order_id,
            exclusions AS topping_id
     FROM   pizza_get_exclusions)
SELECT b.*
FROM   base  AS b
LEFT  JOIN excluded AS e
       ON  b.order_id  = e.order_id
       AND b.topping_id = e.topping_id
WHERE  e.topping_id IS NULL
LIMIT 20;
```

```sql
-- 9. Combine the “kept” base toppings with any extras, so we have every
--    topping instance (and its quantity) used in every delivered pizza
WITH delivered AS (
     SELECT co.order_id,
            co.pizza_id
     FROM   pizza_clean_customer_orders AS co
     JOIN   pizza_clean_runner_orders   AS ro USING (order_id)
     WHERE  ro.cancellation IS NULL
       AND  ro.pickup_time IS NOT NULL),
recipe AS (
     SELECT r.pizza_id,
            CAST(j.value AS INTEGER) AS topping_id
     FROM  (SELECT pizza_id,
                   '['||REPLACE(toppings,' ','')||']' AS toppings_json
            FROM   pizza_recipes) AS r,
           json_each(r.toppings_json) AS j),
base AS (
     SELECT d.order_id,
            recipe.topping_id,
            1 AS qty
     FROM   delivered AS d
     JOIN   recipe    USING (pizza_id)),
excluded AS (
     SELECT order_id,
            exclusions AS topping_id
     FROM   pizza_get_exclusions),
base_kept AS (
     SELECT b.*
     FROM   base AS b
     LEFT  JOIN excluded AS e
            ON  b.order_id  = e.order_id
            AND b.topping_id = e.topping_id
     WHERE  e.topping_id IS NULL),
extras AS (
     SELECT order_id,
            extras        AS topping_id,
            extras_count  AS qty
     FROM   pizza_get_extras)
SELECT *
FROM   base_kept
UNION ALL
SELECT *
FROM   extras
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: total quantity used for every ingredient
WITH delivered AS (
     SELECT co.order_id,
            co.pizza_id
     FROM   pizza_clean_customer_orders AS co
     JOIN   pizza_clean_runner_orders   AS ro USING (order_id)
     WHERE  ro.cancellation IS NULL
       AND  ro.pickup_time IS NOT NULL),
recipe AS (
     SELECT r.pizza_id,
            CAST(j.value AS INTEGER) AS topping_id
     FROM  (SELECT pizza_id,
                   '['||REPLACE(toppings,' ','')||']' AS toppings_json
            FROM   pizza_recipes) AS r,
           json_each(r.toppings_json) AS j),
base AS (
     SELECT d.order_id,
            recipe.topping_id,
            1 AS qty
     FROM   delivered AS d
     JOIN   recipe    USING (pizza_id)),
excluded AS (
     SELECT order_id,
            exclusions AS topping_id
     FROM   pizza_get_exclusions),
base_kept AS (
     SELECT b.*
     FROM   base AS b
     LEFT  JOIN excluded AS e
            ON  b.order_id  = e.order_id
            AND b.topping_id = e.topping_id
     WHERE  e.topping_id IS NULL),
extras AS (
     SELECT order_id,
            extras        AS topping_id,
            extras_count  AS qty
     FROM   pizza_get_extras),
all_toppings AS (
     SELECT topping_id, qty
     FROM   base_kept
     UNION ALL
     SELECT topping_id, qty
     FROM   extras)
SELECT  pt.topping_name   AS ingredient,
        SUM(a.qty)        AS quantity
FROM    all_toppings AS a
JOIN    pizza_toppings  AS pt
       USING (topping_id)
GROUP  BY pt.topping_name
ORDER  BY quantity DESC;
```
