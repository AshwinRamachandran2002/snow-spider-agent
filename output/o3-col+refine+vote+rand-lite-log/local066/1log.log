-- 4. Convert every pizza recipe into one-row-per-topping
--    (json_each() is an easy splitter for the comma list)
SELECT r.pizza_id,
       CAST(j.value AS INTEGER)      AS topping_id
FROM  (SELECT pizza_id,
              '['||REPLACE(toppings,' ','')||']' AS toppings_json
       FROM   pizza_recipes)  AS r,
      json_each(r.toppings_json)      AS j
LIMIT 20;
