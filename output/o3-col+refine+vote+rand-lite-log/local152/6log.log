```sql
-- 1. Look at some distinct directors’ IDs in the mapping table
SELECT DISTINCT "name_id"
FROM "director_mapping"
LIMIT 20;
```

```sql
-- 2. Bring the directors’ names
SELECT DISTINCT dm."name_id", n."name"
FROM "director_mapping" AS dm
JOIN "names" AS n ON n."id" = dm."name_id"
LIMIT 20;
```

```sql
-- 3. Top-20 directors by how many movies they have directed
SELECT dm."name_id",
       n."name",
       COUNT(*) AS "movie_count"
FROM "director_mapping" AS dm
JOIN "names" AS n  ON n."id" = dm."name_id"
GROUP BY dm."name_id"
ORDER BY "movie_count" DESC
LIMIT 20;
```

```sql
-- 4. Bring every director-movie pair together with movie runtime
SELECT DISTINCT dm."name_id",
       m."id"  AS "movie_id",
       m."duration",
       m."year"
FROM "director_mapping" AS dm
JOIN "movies"            AS m ON m."id" = dm."movie_id"
LIMIT 20;
```

```sql
-- 5. Same join, now also pulling the rating figures
SELECT DISTINCT dm."name_id",
       m."id"            AS "movie_id",
       r."avg_rating",
       r."total_votes"
FROM "director_mapping" AS dm
JOIN "movies"            AS m ON m."id" = dm."movie_id"
LEFT JOIN "ratings"      AS r ON r."movie_id" = m."id"
LIMIT 20;
```

```sql
-- 6. Aggregate ratings per director – avg, min, max, votes
SELECT dm."name_id",
       ROUND(AVG(r."avg_rating"),2) AS "avg_rating",
       MIN(r."avg_rating")          AS "min_rating",
       MAX(r."avg_rating")          AS "max_rating",
       SUM(r."total_votes")         AS "total_votes"
FROM "director_mapping" AS dm
JOIN "ratings"          AS r ON r."movie_id" = dm."movie_id"
GROUP BY dm."name_id"
LIMIT 20;
```

```sql
-- 7. Compute the year gap between consecutive movies for each director
WITH director_movies AS (
    SELECT dm."name_id",
           m."year",
           m."id"  AS "movie_id"
    FROM "director_mapping" AS dm
    JOIN "movies"            AS m ON m."id" = dm."movie_id"
),
ordered AS (
    SELECT *,
           LAG("year") OVER (PARTITION BY "name_id" ORDER BY "year") AS "prev_year"
    FROM director_movies
)
SELECT DISTINCT "name_id",
       ("year" - "prev_year") AS "year_gap"
FROM ordered
WHERE "prev_year" IS NOT NULL
LIMIT 20;
```

```sql
-- 8. Pull everything together for every director
WITH director_movies AS (
    SELECT dm."name_id",
           n."name",
           m."id"        AS "movie_id",
           m."year",
           m."duration",
           r."avg_rating",
           r."total_votes"
    FROM "director_mapping" AS dm
    JOIN "names"            AS n ON n."id" = dm."name_id"
    JOIN "movies"           AS m ON m."id" = dm."movie_id"
    LEFT JOIN "ratings"     AS r ON r."movie_id" = m."id"
),
gaps AS (
    SELECT *,
           LAG("year") OVER (PARTITION BY "name_id" ORDER BY "year") AS "prev_year"
    FROM director_movies
),
final_agg AS (
    SELECT "name_id",
           "name",
           COUNT(DISTINCT "movie_id")                     AS "movie_count",
           ROUND(AVG(CASE WHEN "prev_year" IS NOT NULL
                          THEN "year" - "prev_year" END)) AS "avg_inter_movie_duration",
           ROUND(AVG("avg_rating"),2)                     AS "avg_rating",
           SUM("total_votes")                             AS "total_votes",
           MIN("avg_rating")                              AS "min_rating",
           MAX("avg_rating")                              AS "max_rating",
           SUM("duration")                                AS "total_movie_duration"
    FROM gaps
    GROUP BY "name_id","name"
)
SELECT *
FROM final_agg
ORDER BY "movie_count" DESC,
         "total_movie_duration" DESC
LIMIT 9;
```

These eight queries progress from simple inspection to the complete answer, delivering:

• director ID  
• director name  
• number of movies directed  
• average inter-movie duration (year gap, rounded)  
• average rating (rounded to two decimals)  
• total votes across all movies  
• minimum rating  
• maximum rating  
• total movie duration  

and finally showing the top 9 directors, ordered by movie count (desc) then total duration (desc).
