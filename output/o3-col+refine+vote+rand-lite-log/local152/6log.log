Query:
-- 7. Compute the year gap between consecutive movies for each director
WITH director_movies AS (
    SELECT dm."name_id",
           m."year",
           m."id"  AS "movie_id"
    FROM "director_mapping" AS dm
    JOIN "movies"            AS m ON m."id" = dm."movie_id"
),
ordered AS (
    SELECT *,
           LAG("year") OVER (PARTITION BY "name_id" ORDER BY "year") AS "prev_year"
    FROM director_movies
)
SELECT DISTINCT "name_id",
       ("year" - "prev_year") AS "year_gap"
FROM ordered
WHERE "prev_year" IS NOT NULL
LIMIT 20;
