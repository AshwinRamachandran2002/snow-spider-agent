```sql
-- 1) Description: View some records from the director-to-movie bridge table.
SELECT DISTINCT *
FROM "director_mapping"
LIMIT 20;
```

```sql
-- 2) Description: Join directors with their names to confirm the mapping.
SELECT DISTINCT d."name_id"            AS director_id,
                n."name"               AS director_name,
                d."movie_id"
FROM   "director_mapping" AS d
JOIN   "names"            AS n
       ON d."name_id" = n."id"
LIMIT 20;
```

```sql
-- 3) Description: Inspect a handful of movies (id, title, year, runtime).
SELECT DISTINCT "id",
                "title",
                "year",
                "duration"
FROM   "movies"
LIMIT 20;
```

```sql
-- 4) Description: Combine directors with the movies they directed.
SELECT DISTINCT n."id"                 AS director_id,
                n."name"               AS director_name,
                m."id"                 AS movie_id,
                m."title",
                m."duration"
FROM   "director_mapping" AS d
JOIN   "names"            AS n ON d."name_id" = n."id"
JOIN   "movies"           AS m ON d."movie_id" = m."id"
LIMIT 20;
```

```sql
-- 5) Description: Check runtimes of movies for a single director (e.g. nm0003836).
SELECT DISTINCT m."id"      AS movie_id,
                m."title",
                m."duration"
FROM   "director_mapping" AS d
JOIN   "movies"           AS m ON d."movie_id" = m."id"
WHERE  d."name_id" = 'nm0003836'
LIMIT 20;
```

```sql
-- 6) Description: Look at rating information merged with directors' movies.
SELECT DISTINCT d."name_id"          AS director_id,
                r."movie_id",
                r."avg_rating",
                r."total_votes"
FROM   "director_mapping" AS d
JOIN   "ratings"          AS r ON d."movie_id" = r."movie_id"
LIMIT 20;
```

```sql
-- 7) Description: Count how many movies each director has in the database.
SELECT   d."name_id"                        AS director_id,
         COUNT(DISTINCT d."movie_id")       AS movie_count
FROM     "director_mapping" AS d
GROUP BY d."name_id"
ORDER BY movie_count DESC
LIMIT 20;
```

```sql
-- 8) Description: Calculate average runtime per director.
SELECT   d."name_id"                        AS director_id,
         ROUND(AVG(m."duration"))           AS avg_movie_duration
FROM     "director_mapping" AS d
JOIN     "movies"           AS m ON d."movie_id" = m."id"
GROUP BY d."name_id"
LIMIT 20;
```

```sql
-- 9) Description: Gather rating aggregates (avg, min, max, votes) per director.
SELECT   d."name_id"                         AS director_id,
         ROUND(AVG(r."avg_rating"), 2)       AS avg_rating,
         MIN(r."avg_rating")                 AS min_rating,
         MAX(r."avg_rating")                 AS max_rating,
         SUM(r."total_votes")                AS total_votes
FROM     "director_mapping" AS d
JOIN     "ratings"          AS r ON d."movie_id" = r."movie_id"
GROUP BY d."name_id"
LIMIT 20;
```

```sql
-- 10) Description: Final answer – top 9 directors by movie count with all requested metrics.
SELECT   n."id"                               AS director_id,
         n."name"                             AS director_name,
         COUNT(DISTINCT m."id")               AS movie_count,
         ROUND(AVG(m."duration"))             AS avg_inter_movie_duration,
         ROUND(AVG(r."avg_rating"), 2)        AS avg_rating,
         SUM(r."total_votes")                 AS total_votes,
         MIN(r."avg_rating")                  AS min_rating,
         MAX(r."avg_rating")                  AS max_rating,
         SUM(m."duration")                    AS total_movie_duration
FROM     "director_mapping" AS d
JOIN     "names"            AS n ON d."name_id" = n."id"
JOIN     "movies"           AS m ON d."movie_id" = m."id"
JOIN     "ratings"          AS r ON m."id"      = r."movie_id"
GROUP BY n."id", n."name"
ORDER BY movie_count DESC,
         total_movie_duration DESC
LIMIT 9;
```
