```

```sql
--Description: Look at some IDs and their corresponding names.
SELECT DISTINCT "id",
                "name"
FROM   "names"
LIMIT 20;
```

```sql
--Description: Join directors with their names to verify mapping integrity.
SELECT DISTINCT dm."name_id",
                n."name"
FROM   "director_mapping" AS dm
JOIN   "names"            AS n
       ON dm."name_id" = n."id"
LIMIT 20;
```

```sql
--Description: Inspect a few movies and their running times.
SELECT DISTINCT "id",
                "title",
                "duration"
FROM   "movies"
LIMIT 20;
```

```sql
--Description: Inspect a few movie–rating records.
SELECT DISTINCT "movie_id",
                "avg_rating",
                "total_votes"
FROM   "ratings"
LIMIT 20;
```

```sql
--Description: Combine directors, movies and ratings to view per-movie info for each director.
SELECT DISTINCT dm."name_id",
                n."name",
                m."id"  AS "movie_id",
                m."duration",
                r."avg_rating",
                r."total_votes"
FROM   "director_mapping" AS dm
JOIN   "names"            AS n
       ON n."id" = dm."name_id"
JOIN   "movies"           AS m
       ON m."id" = dm."movie_id"
LEFT  JOIN "ratings"      AS r
       ON r."movie_id" = m."id"
LIMIT 20;
```

```sql
--Description: Aggregate per director – movie count and total running time.
SELECT   dm."name_id",
         n."name",
         COUNT(DISTINCT m."id") AS "movie_count",
         SUM(m."duration")      AS "total_movie_duration"
FROM     "director_mapping" AS dm
JOIN     "names"            AS n ON n."id" = dm."name_id"
JOIN     "movies"           AS m ON m."id" = dm."movie_id"
GROUP BY dm."name_id"
ORDER BY "movie_count" DESC
LIMIT 20;
```

```sql
--Description: Aggregate per director – average/total ratings and durations with rounding.
SELECT   dm."name_id",
         n."name",
         ROUND(AVG(m."duration"))      AS "avg_movie_duration",
         ROUND(AVG(r."avg_rating"),2)  AS "avg_rating",
         MIN(r."avg_rating")           AS "min_rating",
         MAX(r."avg_rating")           AS "max_rating",
         SUM(r."total_votes")          AS "total_votes"
FROM     "director_mapping" AS dm
JOIN     "names"            AS n ON n."id" = dm."name_id"
JOIN     "movies"           AS m ON m."id" = dm."movie_id"
LEFT JOIN "ratings"         AS r ON r."movie_id" = m."id"
GROUP BY dm."name_id"
LIMIT 20;
```

```sql
--Description: Final query – top 9 directors by movie count, breaking ties by total movie duration.
SELECT
       dm."name_id"                              AS "director_id",
       n."name"                                  AS "director_name",
       COUNT(DISTINCT m."id")                    AS "movie_count",
       ROUND(AVG(m."duration"))                  AS "avg_movie_duration",
       ROUND(AVG(r."avg_rating"), 2)             AS "avg_rating",
       SUM(r."total_votes")                      AS "total_votes",
       MIN(r."avg_rating")                       AS "min_rating",
       MAX(r."avg_rating")                       AS "max_rating",
       SUM(m."duration")                         AS "total_movie_duration"
FROM   "director_mapping" AS dm
JOIN   "names"            AS n ON n."id" = dm."name_id"
JOIN   "movies"           AS m ON m."id" = dm."movie_id"
LEFT  JOIN "ratings"      AS r ON r."movie_id" = m."id"
GROUP BY dm."name_id"
ORDER BY "movie_count" DESC,
         "total_movie_duration" DESC
LIMIT 9;
```
