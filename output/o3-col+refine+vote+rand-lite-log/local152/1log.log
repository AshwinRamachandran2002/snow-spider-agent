JOIN   "movies"           AS m ON d."movie_id" = m."id"
JOIN   "ratings"          AS r ON m."id"      = r."movie_id"
GROUP  BY n."id"
ORDER  BY "movie_count" DESC,
          "total_movie_duration" DESC
LIMIT 9;
