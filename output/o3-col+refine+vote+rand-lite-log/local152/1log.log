```sql
--Description: Inspect a sample of movie–director pairs to understand how directors are linked with movies.  
SELECT DISTINCT "movie_id", "name_id" 
FROM "director_mapping" 
LIMIT 20;
```

```sql
--Description: Find the directors with the largest number of movies (movie_count).  
SELECT "name_id",
       COUNT(DISTINCT "movie_id") AS "movie_count"
FROM "director_mapping"
GROUP BY "name_id"
ORDER BY "movie_count" DESC
LIMIT 20;
```

```sql
--Description: Attach the director’s human-readable name to the previous result.  
SELECT d."name_id",
       n."name",
       COUNT(DISTINCT d."movie_id") AS "movie_count"
FROM   "director_mapping" AS d
JOIN   "names"            AS n ON d."name_id" = n."id"
GROUP  BY d."name_id"
ORDER  BY "movie_count" DESC,
          n."name"
LIMIT 20;
```

```sql
--Description: Verify that movie duration and year data exist once directors are joined to movies.  
SELECT d."name_id",
       n."name",
       m."duration",
       m."year"
FROM   "director_mapping" AS d
JOIN   "names"            AS n ON d."name_id" = n."id"
JOIN   "movies"           AS m ON d."movie_id" = m."id"
LIMIT 20;
```

```sql
--Description: Calculate each director’s average movie duration (rounded) and total movie duration.  
SELECT d."name_id",
       ROUND(AVG(m."duration"))  AS "avg_duration",
       SUM(m."duration")         AS "total_duration"
FROM   "director_mapping" AS d
JOIN   "movies"           AS m ON d."movie_id" = m."id"
GROUP  BY d."name_id"
ORDER  BY "total_duration" DESC
LIMIT 20;
```

```sql
--Description: Compute rating statistics for every director (average, min, max rating, plus total votes).  
SELECT d."name_id",
       ROUND(AVG(r."avg_rating"), 2) AS "avg_rating",
       SUM(r."total_votes")          AS "total_votes",
       MIN(r."avg_rating")           AS "min_rating",
       MAX(r."avg_rating")           AS "max_rating"
FROM   "director_mapping" AS d
JOIN   "ratings"          AS r ON d."movie_id" = r."movie_id"
GROUP  BY d."name_id"
ORDER  BY "total_votes" DESC
LIMIT 20;
```

```sql
--Description: Final answer – top 9 directors by movie count, with all requested statistics and ordering rules applied.  
SELECT n."id"                         AS "director_id",
       n."name",
       COUNT(DISTINCT m."id")         AS "movie_count",
       ROUND(AVG(m."duration"))       AS "avg_movie_duration",
       ROUND(AVG(r."avg_rating"), 2)  AS "avg_rating",
       SUM(r."total_votes")           AS "total_votes",
       MIN(r."avg_rating")            AS "min_rating",
       MAX(r."avg_rating")            AS "max_rating",
       SUM(m."duration")              AS "total_movie_duration"
FROM   "director_mapping" AS d
JOIN   "names"            AS n ON d."name_id" = n."id"
JOIN   "movies"           AS m ON d."movie_id" = m."id"
JOIN   "ratings"          AS r ON m."id"      = r."movie_id"
GROUP  BY n."id"
ORDER  BY "movie_count" DESC,
          "total_movie_duration" DESC
LIMIT 9;
```
