```sql
--Description: Inspect 20 sample rows linking a director to a movie (with the director’s name)
SELECT dm."name_id",
       n."name",
       dm."movie_id"
FROM   "director_mapping" AS dm
JOIN   "names"            AS n  ON dm."name_id" = n."id"
LIMIT  20;
```

```sql
--Description: See the movie years and durations for 20 director–movie pairs
SELECT dm."name_id",
       n."name",
       m."id"          AS movie_id,
       m."year",
       m."duration"
FROM   "director_mapping" AS dm
JOIN   "movies"           AS m ON dm."movie_id" = m."id"
JOIN   "names"            AS n ON dm."name_id" = n."id"
LIMIT  20;
```

```sql
--Description: Count how many movies each director has made (top-20)
SELECT   dm."name_id",
         n."name",
         COUNT(*) AS movie_count
FROM     "director_mapping" AS dm
JOIN     "names"            AS n ON dm."name_id" = n."id"
GROUP BY dm."name_id", n."name"
ORDER BY movie_count DESC
LIMIT    20;
```

```sql
--Description: Display ratings information attached to 20 director–movie pairs
SELECT dm."name_id",
       n."name",
       m."id"           AS movie_id,
       r."avg_rating",
       r."total_votes"
FROM   "director_mapping" AS dm
JOIN   "movies"           AS m ON dm."movie_id" = m."id"
JOIN   "names"            AS n ON dm."name_id" = n."id"
LEFT JOIN "ratings"       AS r ON m."id" = r."movie_id"
LIMIT  20;
```

```sql
--Description: For one sample director, view the year gaps between consecutive movies
SELECT name_id,
       name,
       movie_id,
       year,
       LEAD(year) OVER (PARTITION BY name_id ORDER BY year) - year AS gap_to_next
FROM (
    SELECT dm."name_id",
           n."name",
           m."id"   AS movie_id,
           m."year"
    FROM   "director_mapping" AS dm
    JOIN   "movies"           AS m ON dm."movie_id" = m."id"
    JOIN   "names"            AS n ON dm."name_id" = n."id"
    WHERE  dm."name_id" = (SELECT name_id                -- pick the most prolific director
                           FROM   "director_mapping"
                           GROUP  BY name_id
                           ORDER  BY COUNT(*) DESC
                           LIMIT  1)
) sub
LIMIT 20;
```

```sql
--Description: Aggregate per-director statistics: movie count, rating stats, vote sum, total duration
WITH director_movies AS (
    SELECT dm."name_id",
           n."name",
           m."id"            AS movie_id,
           m."year",
           m."duration",
           r."avg_rating",
           r."total_votes"
    FROM   "director_mapping" AS dm
    JOIN   "movies"           AS m ON dm."movie_id" = m."id"
    JOIN   "names"            AS n ON dm."name_id" = n."id"
    LEFT  JOIN "ratings"      AS r ON m."id" = r."movie_id"
), gaps AS (
    SELECT name_id,
           name,
           movie_id,
           year,
           duration,
           avg_rating,
           total_votes,
           LEAD(year) OVER (PARTITION BY name_id ORDER BY year) - year AS gap_to_next
    FROM   director_movies
), per_dir AS (
    SELECT name_id,
           name,
           COUNT(*)                         AS movie_count,
           ROUND(AVG(gap_to_next),0)        AS avg_inter_movie_years,
           ROUND(AVG(avg_rating),2)         AS avg_rating,
           SUM(total_votes)                 AS total_votes,
           MIN(avg_rating)                  AS min_rating,
           MAX(avg_rating)                  AS max_rating,
           SUM(duration)                    AS total_movie_duration
    FROM   gaps
    GROUP  BY name_id, name
)
SELECT *
FROM   per_dir
ORDER  BY movie_count DESC, total_movie_duration DESC
LIMIT  20;
```

```sql
--Description: FINAL ANSWER – top-9 directors by movie count (then by total duration) with all requested metrics
WITH director_movies AS (
    SELECT dm."name_id",
           n."name",
           m."id"            AS movie_id,
           m."year",
           m."duration",
           r."avg_rating",
           r."total_votes"
    FROM   "director_mapping" AS dm
    JOIN   "movies"           AS m ON dm."movie_id" = m."id"
    JOIN   "names"            AS n ON dm."name_id" = n."id"
    LEFT  JOIN "ratings"      AS r ON m."id" = r."movie_id"
), gaps AS (
    SELECT name_id,
           name,
           movie_id,
           year,
           duration,
           avg_rating,
           total_votes,
           LEAD(year) OVER (PARTITION BY name_id ORDER BY year) - year AS gap_to_next
    FROM   director_movies
), per_dir AS (
    SELECT name_id                              AS director_id,
           name,
           COUNT(*)                             AS movie_count,
           ROUND(AVG(gap_to_next),0)            AS avg_inter_movie_years,
           ROUND(AVG(avg_rating),2)             AS avg_rating,
           SUM(total_votes)                     AS total_votes,
           MIN(avg_rating)                      AS min_rating,
           MAX(avg_rating)                      AS max_rating,
           SUM(duration)                        AS total_movie_duration
    FROM   gaps
    GROUP  BY director_id, name
)
SELECT director_id,
       name,
       movie_count,
       avg_inter_movie_years,
       avg_rating,
       total_votes,
       min_rating,
       max_rating,
       total_movie_duration
FROM   per_dir
ORDER  BY movie_count DESC,
          total_movie_duration DESC
LIMIT  9;
```
