pair_distances AS (  -- pair-wise distances, keep distinct pairs only
    SELECT 
        ST_DISTANCE(a1.geog, a2.geog) AS distance_meters
    FROM amenities a1
    JOIN amenities a2 
      ON a1.id < a2.id
)
SELECT 
    MIN(distance_meters) AS "shortest_distance_meters"
FROM pair_distances;
