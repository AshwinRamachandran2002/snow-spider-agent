Query:
--Description: Count how many libraries, places of worship, and community centres lie inside a broad
--             Philadelphia bounding box (lat 39.8-40.2, lon −75.3 to −74.9).
WITH amenities AS (
  SELECT
      TO_GEOGRAPHY(p."geometry")            AS geog,
      f.value:"value"::STRING               AS amenity_type
  FROM GEO_OPENSTREETMAP_CENSUS_PLACES.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS p,
       LATERAL FLATTEN(input => TRY_PARSE_JSON(p."all_tags")) f
  WHERE f.value:"key"::STRING  = 'amenity'
    AND f.value:"value"::STRING IN ('library','place_of_worship','community_centre')
    AND ST_Y(TO_GEOGRAPHY(p."geometry")) BETWEEN 39.8 AND 40.2        -- latitude window
    AND ST_X(TO_GEOGRAPHY(p."geometry")) BETWEEN -75.3 AND -74.9      -- longitude window
)
SELECT
    amenity_type,
    COUNT(*) AS cnt
FROM amenities
GROUP BY amenity_type
LIMIT 20
