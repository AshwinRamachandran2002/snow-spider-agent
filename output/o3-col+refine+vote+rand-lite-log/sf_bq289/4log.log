--Description: Return the minimum distance (metres) between any two of the selected amenities
--             located within the Philadelphia bounding box.
WITH amenities AS (
  SELECT
      TO_GEOGRAPHY(p."geometry")            AS geog
  FROM GEO_OPENSTREETMAP_CENSUS_PLACES.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS p,
       LATERAL FLATTEN(input => TRY_PARSE_JSON(p."all_tags")) f
  WHERE f.value:"key"::STRING  = 'amenity'
    AND f.value:"value"::STRING IN ('library','place_of_worship','community_centre')
    AND ST_Y(TO_GEOGRAPHY(p."geometry")) BETWEEN 39.8 AND 40.2
    AND ST_X(TO_GEOGRAPHY(p."geometry")) BETWEEN -75.3 AND -74.9
),
pairs AS (
  SELECT
      ST_DISTANCE(a1.geog, a2.geog) AS distance_meters
  FROM amenities a1
  JOIN amenities a2
    ON a1.geog <> a2.geog
)
SELECT
    MIN(distance_meters) AS "shortest_distance_meters"
FROM pairs
LIMIT 20;
