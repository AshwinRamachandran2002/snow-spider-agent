```sql
--Description: Collect all three amenity types that fall inside the Philadelphia city polygon
WITH philly AS (
  SELECT TO_GEOGRAPHY("place_geom") AS geom
  FROM GEO_OPENSTREETMAP_CENSUS_PLACES.GEO_US_CENSUS_PLACES.PLACES_PENNSYLVANIA
  WHERE "place_name" ILIKE '%philadelphia%'
  LIMIT 1
)
SELECT 
  p."geometry"              AS "point_wkb",
  TO_GEOGRAPHY(p."geometry") AS "point_geog",
  f.value:"value"::STRING   AS "amenity"
FROM GEO_OPENSTREETMAP_CENSUS_PLACES.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS p,
     LATERAL FLATTEN(input => TRY_PARSE_JSON(p."all_tags")) f,
     philly
WHERE f.value:"key"::STRING  = 'amenity'
  AND f.value:"value"::STRING IN ('library','place_of_worship','community_centre')
  AND ST_CONTAINS(philly.geom, TO_GEOGRAPHY(p."geometry"))
LIMIT 20;
```

```sql
--Description: Count how many qualifying amenities lie within Philadelphia
WITH philly AS (
  SELECT TO_GEOGRAPHY("place_geom") AS geom
  FROM GEO_OPENSTREETMAP_CENSUS_PLACES.GEO_US_CENSUS_PLACES.PLACES_PENNSYLVANIA
  WHERE "place_name" ILIKE '%philadelphia%'
  LIMIT 1
),
amenities AS (
  SELECT 
    TO_GEOGRAPHY(p."geometry") AS geog,
    f.value:"value"::STRING    AS amenity_type
  FROM GEO_OPENSTREETMAP_CENSUS_PLACES.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS p,
       LATERAL FLATTEN(input => TRY_PARSE_JSON(p."all_tags")) f,
       philly
  WHERE f.value:"key"::STRING = 'amenity'
    AND f.value:"value"::STRING IN ('library','place_of_worship','community_centre')
    AND ST_CONTAINS(philly.geom, TO_GEOGRAPHY(p."geometry"))
)
SELECT 
  amenity_type,
  COUNT(*) AS cnt
FROM amenities
GROUP BY amenity_type
LIMIT 20;
```

```sql
--Description: Calculate pair-wise distances (in meters) between every two amenities inside Philadelphia
WITH philly AS (
  SELECT TO_GEOGRAPHY("place_geom") AS geom
  FROM GEO_OPENSTREETMAP_CENSUS_PLACES.GEO_US_CENSUS_PLACES.PLACES_PENNSYLVANIA
  WHERE "place_name" ILIKE '%philadelphia%'
  LIMIT 1
),
amenities AS (
  SELECT 
    TO_GEOGRAPHY(p."geometry") AS geog,
    f.value:"value"::STRING    AS amenity_type
  FROM GEO_OPENSTREETMAP_CENSUS_PLACES.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS p,
       LATERAL FLATTEN(input => TRY_PARSE_JSON(p."all_tags")) f,
       philly
  WHERE f.value:"key"::STRING = 'amenity'
    AND f.value:"value"::STRING IN ('library','place_of_worship','community_centre')
    AND ST_CONTAINS(philly.geom, TO_GEOGRAPHY(p."geometry"))
)
SELECT 
  a1.amenity_type AS amenity_1,
  a2.amenity_type AS amenity_2,
  ST_DISTANCE(a1.geog, a2.geog) AS distance_meters
FROM amenities a1
JOIN amenities a2
  ON a1.geog <> a2.geog
LIMIT 20;
```

```sql
--Description: Final query – return the minimum distance between any two of the selected amenities in Philadelphia
WITH philly AS (
  SELECT TO_GEOGRAPHY("place_geom") AS geom
  FROM GEO_OPENSTREETMAP_CENSUS_PLACES.GEO_US_CENSUS_PLACES.PLACES_PENNSYLVANIA
  WHERE "place_name" ILIKE '%philadelphia%'
  LIMIT 1
),
amenities AS (
  SELECT 
    TO_GEOGRAPHY(p."geometry") AS geog,
    f.value:"value"::STRING    AS amenity_type
  FROM GEO_OPENSTREETMAP_CENSUS_PLACES.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS p,
       LATERAL FLATTEN(input => TRY_PARSE_JSON(p."all_tags")) f,
       philly
  WHERE f.value:"key"::STRING = 'amenity'
    AND f.value:"value"::STRING IN ('library','place_of_worship','community_centre')
    AND ST_CONTAINS(philly.geom, TO_GEOGRAPHY(p."geometry"))
),
pairs AS (
  SELECT 
    ST_DISTANCE(a1.geog, a2.geog) AS distance_meters
  FROM amenities a1
  JOIN amenities a2
    ON a1.geog <> a2.geog
)
SELECT 
  MIN(distance_meters) AS "shortest_distance_meters"
FROM pairs
LIMIT 20;
```
