--Description (thinking process):
-- 1. We must compute each team’s season points using 3-1-0 scoring.
--    For every match we consider both “home” and “away” perspectives via
--    CROSS JOIN (side = 'home' / 'away'). This yields one row per team per match
--    with the points earned in that match.
-- 2. Aggregate those rows by season, league, and team → table team_totals.
-- 3. For each (season, league) find the maximum points (max_per_season).
-- 4. Keep only rows in team_totals that match that maximum → the champion(s).
-- 5. Join with Team, League, Country to translate ids to names.
-- 6. Return season, country, league, champion_team, points; order for readability.

WITH team_totals AS (
    SELECT
        m."season",
        m."league_id",
        CASE WHEN s.side = 'home'
             THEN m."home_team_api_id"
             ELSE m."away_team_api_id" END                AS team_api_id,
        SUM(
            CASE
                WHEN s.side = 'home' AND m."home_team_goal" > m."away_team_goal" THEN 3
                WHEN s.side = 'home' AND m."home_team_goal" = m."away_team_goal" THEN 1
                WHEN s.side = 'away' AND m."away_team_goal" > m."home_team_goal" THEN 3
                WHEN s.side = 'away' AND m."away_team_goal" = m."home_team_goal" THEN 1
                ELSE 0
            END
        )                                                 AS total_points
    FROM "Match" AS m
    CROSS JOIN (SELECT 'home' AS side UNION ALL SELECT 'away') AS s
    GROUP BY m."season", m."league_id", team_api_id
),
max_per_season AS (
    SELECT
        "season",
        "league_id",
        MAX(total_points) AS max_points
    FROM team_totals
    GROUP BY "season", "league_id"
)
SELECT
    tt."season",
    c."name"            AS country,
    l."name"            AS league,
    tm."team_long_name" AS champion_team,
    tt."total_points"   AS points
FROM   team_totals AS tt
JOIN   max_per_season AS mp
       ON  tt."season"       = mp."season"
       AND tt."league_id"    = mp."league_id"
       AND tt."total_points" = mp."max_points"
JOIN   "Team"    AS tm ON tt."team_api_id" = tm."team_api_id"
JOIN   "League"  AS l  ON tt."league_id"   = l."id"
JOIN   "Country" AS c  ON l."country_id"   = c."id"
ORDER BY tt."season", l."name";
```
