-- 9) Description: For every (season, league) find the maximum points tally.
WITH team_totals AS (
    SELECT "season",
           "league_id",
           "team_api_id",
           SUM(
               CASE
                   WHEN side = 'home' AND "home_team_goal" > "away_team_goal" THEN 3
                   WHEN side = 'home' AND "home_team_goal" = "away_team_goal" THEN 1
                   WHEN side = 'away' AND "away_team_goal" > "home_team_goal" THEN 3
                   WHEN side = 'away' AND "away_team_goal" = "home_team_goal" THEN 1
                   ELSE 0
               END
           ) AS total_points
    FROM   "Match"
    CROSS JOIN (SELECT 'home' AS side UNION ALL SELECT 'away')
    GROUP  BY "season", "league_id", "team_api_id"
),
max_per_season AS (
    SELECT "season",
           "league_id",
           MAX(total_points) AS max_points
    FROM   team_totals
    GROUP  BY "season", "league_id"
)
SELECT m."season",
       m."league_id",
       m."team_api_id",
       m."total_points"
FROM   team_totals AS m
JOIN   max_per_season AS p
       ON m."season"      = p."season"
      AND m."league_id"   = p."league_id"
      AND m."total_points"= p."max_points"
LIMIT 20;
