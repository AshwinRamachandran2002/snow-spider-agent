--                  with team, league, and country names, plus total points.
WITH team_totals AS (
    SELECT "season",
           "league_id",
           CASE
               WHEN side = 'home' THEN "home_team_api_id"
               ELSE "away_team_api_id"
           END                                  AS team_api_id,
           SUM(
               CASE
                   WHEN side = 'home' AND "home_team_goal" > "away_team_goal" THEN 3
                   WHEN side = 'home' AND "home_team_goal" = "away_team_goal" THEN 1
                   WHEN side = 'away' AND "away_team_goal" > "home_team_goal" THEN 3
                   WHEN side = 'away' AND "away_team_goal" = "home_team_goal" THEN 1
                   ELSE 0
               END
           )                                   AS total_points
    FROM   "Match"
    CROSS JOIN (SELECT 'home' AS side UNION ALL SELECT 'away')
    GROUP  BY "season", "league_id", team_api_id
),
max_per_season AS (
    SELECT "season",
           "league_id",
           MAX(total_points) AS max_points
    FROM   team_totals
    GROUP  BY "season", "league_id"
)
SELECT t."season",
       c."name"           AS country,
       l."name"           AS league,
       tm."team_long_name" AS champion_team,
       tt."total_points"  AS points
