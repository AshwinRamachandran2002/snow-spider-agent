```sql
-- 5) Description: Compute the number of points earned by the HOME team in each match.
SELECT "id"                       AS match_id,
       "season",
       "league_id",
       "home_team_api_id"         AS team_api_id,
       CASE
           WHEN "home_team_goal" > "away_team_goal" THEN 3
           WHEN "home_team_goal" = "away_team_goal" THEN 1
           ELSE 0
       END                        AS points
FROM   "Match"
LIMIT 20;
```

```sql
-- 6) Description: Compute the number of points earned by the AWAY team in each match.
SELECT "id"                       AS match_id,
       "season",
       "league_id",
       "away_team_api_id"         AS team_api_id,
       CASE
           WHEN "away_team_goal" > "home_team_goal" THEN 3
           WHEN "away_team_goal" = "home_team_goal" THEN 1
           ELSE 0
       END                        AS points
FROM   "Match"
LIMIT 20;
```

```sql
-- 7) Description: UNION the home-side and away-side queries so every team’s
--                 points for every match appear in one result set.
SELECT "id"        AS match_id,
       "season",
       "league_id",
       "home_team_api_id" AS team_api_id,
       CASE
           WHEN "home_team_goal" > "away_team_goal" THEN 3
           WHEN "home_team_goal" = "away_team_goal" THEN 1
           ELSE 0
       END         AS points
FROM   "Match"
UNION ALL
SELECT "id"        AS match_id,
       "season",
       "league_id",
       "away_team_api_id",
       CASE
           WHEN "away_team_goal" > "home_team_goal" THEN 3
           WHEN "away_team_goal" = "home_team_goal" THEN 1
           ELSE 0
       END
FROM   "Match"
LIMIT 20;
```

```sql
-- 8) Description: Aggregate total points per (season, league, team).
WITH team_points AS (
    SELECT "season",
           "league_id",
           CASE
               WHEN side = 'home' THEN "home_team_api_id"
               ELSE "away_team_api_id"
           END                                  AS team_api_id,
           CASE
               WHEN side = 'home' AND "home_team_goal" > "away_team_goal" THEN 3
               WHEN side = 'home' AND "home_team_goal" = "away_team_goal" THEN 1
               WHEN side = 'away' AND "away_team_goal" > "home_team_goal" THEN 3
               WHEN side = 'away' AND "away_team_goal" = "home_team_goal" THEN 1
               ELSE 0
           END                                  AS pts
    FROM   "Match"
    CROSS JOIN (SELECT 'home' AS side UNION ALL SELECT 'away')
)
SELECT "season",
       "league_id",
       "team_api_id",
       SUM(pts) AS total_points
FROM   team_points
GROUP  BY "season", "league_id", "team_api_id"
LIMIT 20;
```

```sql
-- 9) Description: For every (season, league) find the maximum points tally.
WITH team_totals AS (
    SELECT "season",
           "league_id",
           "team_api_id",
           SUM(
               CASE
                   WHEN side = 'home' AND "home_team_goal" > "away_team_goal" THEN 3
                   WHEN side = 'home' AND "home_team_goal" = "away_team_goal" THEN 1
                   WHEN side = 'away' AND "away_team_goal" > "home_team_goal" THEN 3
                   WHEN side = 'away' AND "away_team_goal" = "home_team_goal" THEN 1
                   ELSE 0
               END
           ) AS total_points
    FROM   "Match"
    CROSS JOIN (SELECT 'home' AS side UNION ALL SELECT 'away')
    GROUP  BY "season", "league_id", "team_api_id"
),
max_per_season AS (
    SELECT "season",
           "league_id",
           MAX(total_points) AS max_points
    FROM   team_totals
    GROUP  BY "season", "league_id"
)
SELECT m."season",
       m."league_id",
       m."team_api_id",
       m."total_points"
FROM   team_totals AS m
JOIN   max_per_season AS p
       ON m."season"      = p."season"
      AND m."league_id"   = p."league_id"
      AND m."total_points"= p."max_points"
LIMIT 20;
```

```sql
-- 10) Description: Final answer – champion team for every season & league,
--                  with team, league, and country names, plus total points.
WITH team_totals AS (
    SELECT "season",
           "league_id",
           CASE
               WHEN side = 'home' THEN "home_team_api_id"
               ELSE "away_team_api_id"
           END                                  AS team_api_id,
           SUM(
               CASE
                   WHEN side = 'home' AND "home_team_goal" > "away_team_goal" THEN 3
                   WHEN side = 'home' AND "home_team_goal" = "away_team_goal" THEN 1
                   WHEN side = 'away' AND "away_team_goal" > "home_team_goal" THEN 3
                   WHEN side = 'away' AND "away_team_goal" = "home_team_goal" THEN 1
                   ELSE 0
               END
           )                                   AS total_points
    FROM   "Match"
    CROSS JOIN (SELECT 'home' AS side UNION ALL SELECT 'away')
    GROUP  BY "season", "league_id", team_api_id
),
max_per_season AS (
    SELECT "season",
           "league_id",
           MAX(total_points) AS max_points
    FROM   team_totals
    GROUP  BY "season", "league_id"
)
SELECT t."season",
       c."name"           AS country,
       l."name"           AS league,
       tm."team_long_name" AS champion_team,
       tt."total_points"  AS points
FROM   team_totals AS tt
JOIN   max_per_season AS mp
       ON tt."season" = mp."season"
      AND tt."league_id" = mp."league_id"
      AND tt."total_points" = mp."max_points"
JOIN   "Team"    AS tm ON tt."team_api_id" = tm."team_api_id"
JOIN   "League"  AS l  ON tt."league_id"   = l."id"
JOIN   "Country" AS c  ON l."country_id"   = c."id"
LIMIT 20;
```
