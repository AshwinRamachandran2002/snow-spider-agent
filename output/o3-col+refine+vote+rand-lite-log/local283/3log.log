-- 6. Description:  Produce the same points for the AWAY side and UNION with the home side,
--                 giving every team-match pair one points value (sample 20 rows).
SELECT m.id,
       m.season,
       m.league_id,
       m.home_team_api_id      AS team_api_id,
       CASE
         WHEN m.home_team_goal > m.away_team_goal THEN 3
         WHEN m.home_team_goal = m.away_team_goal THEN 1
         ELSE 0
       END                    AS points
FROM Match AS m
UNION ALL
SELECT m.id,
       m.season,
       m.league_id,
       m.away_team_api_id      AS team_api_id,
       CASE
         WHEN m.away_team_goal > m.home_team_goal THEN 3
         WHEN m.away_team_goal = m.home_team_goal THEN 1
         ELSE 0
       END                    AS points
FROM Match AS m
LIMIT 20;
