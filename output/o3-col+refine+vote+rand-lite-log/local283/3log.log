```sql
-- 2. Description:  List the leagues that are in the database together with their id (first 20).
SELECT DISTINCT id AS league_id,
                name AS league_name
FROM League
LIMIT 20;
```

```sql
-- 3. Description:  Join League and Country to see which country each league belongs to (first 20 rows).
SELECT DISTINCT l.id   AS league_id,
                l.name AS league_name,
                c.name AS country_name
FROM League   AS l
JOIN Country  AS c
  ON l.country_id = c.id
LIMIT 20;
```

```sql
-- 4. Description:  Inspect a few matches with the long names of the home/away teams and final score.
SELECT m.season,
       m.date,
       th.team_long_name AS home_team,
       ta.team_long_name AS away_team,
       m.home_team_goal,
       m.away_team_goal
FROM Match AS m
JOIN Team  AS th ON m.home_team_api_id = th.team_api_id
JOIN Team  AS ta ON m.away_team_api_id = ta.team_api_id
LIMIT 20;
```

```sql
-- 5. Description:  For each match, award points to the HOME side only (sample 20 rows).
SELECT m.id,
       m.season,
       m.league_id,
       m.home_team_api_id      AS team_api_id,
       CASE
         WHEN m.home_team_goal > m.away_team_goal THEN 3
         WHEN m.home_team_goal = m.away_team_goal THEN 1
         ELSE 0
       END                    AS points_home
FROM Match AS m
LIMIT 20;
```

```sql
-- 6. Description:  Produce the same points for the AWAY side and UNION with the home side,
--                 giving every team-match pair one points value (sample 20 rows).
SELECT m.id,
       m.season,
       m.league_id,
       m.home_team_api_id      AS team_api_id,
       CASE
         WHEN m.home_team_goal > m.away_team_goal THEN 3
         WHEN m.home_team_goal = m.away_team_goal THEN 1
         ELSE 0
       END                    AS points
FROM Match AS m
UNION ALL
SELECT m.id,
       m.season,
       m.league_id,
       m.away_team_api_id      AS team_api_id,
       CASE
         WHEN m.away_team_goal > m.home_team_goal THEN 3
         WHEN m.away_team_goal = m.home_team_goal THEN 1
         ELSE 0
       END                    AS points
FROM Match AS m
LIMIT 20;
```

```sql
-- 7. Description:  Aggregate the previous result to obtain total points of each team
--                 per league & season (sample 20 rows ordered by points descending).
WITH match_points AS (
    SELECT m.id,
           m.season,
           m.league_id,
           m.home_team_api_id AS team_api_id,
           CASE
             WHEN m.home_team_goal > m.away_team_goal THEN 3
             WHEN m.home_team_goal = m.away_team_goal THEN 1
             ELSE 0
           END               AS points
    FROM Match AS m
    UNION ALL
    SELECT m.id,
           m.season,
           m.league_id,
           m.away_team_api_id AS team_api_id,
           CASE
             WHEN m.away_team_goal > m.home_team_goal THEN 3
             WHEN m.away_team_goal = m.home_team_goal THEN 1
             ELSE 0
           END               AS points
    FROM Match AS m
)
SELECT season,
       league_id,
       team_api_id,
       SUM(points) AS total_points
FROM match_points
GROUP BY season, league_id, team_api_id
ORDER BY total_points DESC
LIMIT 20;
```

```sql
-- 8. Description:  From the aggregation, select the champion team (max points)
--                 for every league & season (show 20 champions).
WITH match_points AS (
    SELECT m.id,
           m.season,
           m.league_id,
           m.home_team_api_id AS team_api_id,
           CASE
             WHEN m.home_team_goal > m.away_team_goal THEN 3
             WHEN m.home_team_goal = m.away_team_goal THEN 1
             ELSE 0
           END               AS points
    FROM Match AS m
    UNION ALL
    SELECT m.id,
           m.season,
           m.league_id,
           m.away_team_api_id AS team_api_id,
           CASE
             WHEN m.away_team_goal > m.home_team_goal THEN 3
             WHEN m.away_team_goal = m.home_team_goal THEN 1
             ELSE 0
           END               AS points
    FROM Match AS m
),
season_points AS (
    SELECT season,
           league_id,
           team_api_id,
           SUM(points) AS total_points
    FROM match_points
    GROUP BY season, league_id, team_api_id
),
ranked AS (
    SELECT sp.*,
           RANK() OVER (PARTITION BY season, league_id
                        ORDER BY total_points DESC) AS rk
    FROM season_points AS sp
)
SELECT r.season,
       r.league_id,
       r.team_api_id,
       r.total_points
FROM ranked AS r
WHERE r.rk = 1
LIMIT 20;
```

```sql
-- 9. Description:  Final query – champion team name, league, country and points
--                 for EVERY season (limited to first 20 rows for inspection).
WITH match_points AS (
    SELECT m.id,
           m.season,
           m.league_id,
           m.home_team_api_id AS team_api_id,
           CASE
             WHEN m.home_team_goal > m.away_team_goal THEN 3
             WHEN m.home_team_goal = m.away_team_goal THEN 1
             ELSE 0
           END AS points
    FROM Match AS m
    UNION ALL
    SELECT m.id,
           m.season,
           m.league_id,
           m.away_team_api_id AS team_api_id,
           CASE
             WHEN m.away_team_goal > m.home_team_goal THEN 3
             WHEN m.away_team_goal = m.home_team_goal THEN 1
             ELSE 0
           END AS points
    FROM Match AS m
),
season_points AS (
    SELECT season,
           league_id,
           team_api_id,
           SUM(points) AS total_points
    FROM match_points
    GROUP BY season, league_id, team_api_id
),
ranked AS (
    SELECT sp.*,
           RANK() OVER (PARTITION BY season, league_id
                        ORDER BY total_points DESC) AS rk
    FROM season_points AS sp
)
SELECT r.season,
       c.name  AS country,
       l.name  AS league,
       t.team_long_name AS champion_team,
       r.total_points
FROM ranked AS r
JOIN League  AS l ON r.league_id   = l.id
JOIN Country AS c ON l.country_id  = c.id
JOIN Team    AS t ON r.team_api_id = t.team_api_id
WHERE r.rk = 1
ORDER BY r.season,
         country,
         league
LIMIT 20;
```

```sql
-- 10. Description:  (Optional deeper dive) Display how many seasons each team has won
--                   across all leagues/countries (top 20 winners).
WITH match_points AS (
    SELECT m.id,
           m.season,
           m.league_id,
           m.home_team_api_id AS team_api_id,
           CASE
             WHEN m.home_team_goal > m.away_team_goal THEN 3
             WHEN m.home_team_goal = m.away_team_goal THEN 1
             ELSE 0
           END AS points
    FROM Match AS m
    UNION ALL
    SELECT m.id,
           m.season,
           m.league_id,
           m.away_team_api_id AS team_api_id,
           CASE
             WHEN m.away_team_goal > m.home_team_goal THEN 3
             WHEN m.away_team_goal = m.home_team_goal THEN 1
             ELSE 0
           END AS points
    FROM Match AS m
),
season_points AS (
    SELECT season,
           league_id,
           team_api_id,
           SUM(points) AS total_points
    FROM match_points
    GROUP BY season, league_id, team_api_id
),
ranked AS (
    SELECT sp.*,
           RANK() OVER (PARTITION BY season, league_id
                        ORDER BY total_points DESC) AS rk
    FROM season_points AS sp
),
champions AS (
    SELECT season,
           league_id,
           team_api_id
    FROM ranked
    WHERE rk = 1
)
SELECT t.team_long_name AS team_name,
       COUNT(*)         AS titles_won
FROM champions AS ch
JOIN Team AS t ON ch.team_api_id = t.team_api_id
GROUP BY t.team_long_name
ORDER BY titles_won DESC
LIMIT 20;
```
