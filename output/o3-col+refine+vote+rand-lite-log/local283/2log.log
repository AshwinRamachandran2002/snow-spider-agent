```sql
--Description: 4) Sample of matches with both team names and goals scored
SELECT M.season,
       M.match_api_id,
       TH.team_long_name AS home_team,
       TA.team_long_name AS away_team,
       M.home_team_goal,
       M.away_team_goal
FROM Match            AS M
JOIN Team             AS TH ON M.home_team_api_id = TH.team_api_id
JOIN Team             AS TA ON M.away_team_api_id = TA.team_api_id
LIMIT 20;
```

```sql
--Description: 5) For the same sample, calculate the points earned by each side
SELECT M.season,
       TH.team_long_name AS home_team,
       TA.team_long_name AS away_team,
       CASE
           WHEN M.home_team_goal > M.away_team_goal THEN 3
           WHEN M.home_team_goal = M.away_team_goal THEN 1
           ELSE 0
       END                AS home_points,
       CASE
           WHEN M.away_team_goal > M.home_team_goal THEN 3
           WHEN M.away_team_goal = M.home_team_goal THEN 1
           ELSE 0
       END                AS away_points
FROM Match            AS M
JOIN Team             AS TH ON M.home_team_api_id = TH.team_api_id
JOIN Team             AS TA ON M.away_team_api_id = TA.team_api_id
LIMIT 20;
```

```sql
--Description: 6) Aggregate – total points per team, per season & league
SELECT season,
       league_id,
       team_api_id,
       SUM(points) AS total_points
FROM (
        SELECT M.season,
               M.league_id,
               M.home_team_api_id      AS team_api_id,
               CASE
                   WHEN M.home_team_goal > M.away_team_goal THEN 3
                   WHEN M.home_team_goal = M.away_team_goal THEN 1
                   ELSE 0
               END                     AS points
        FROM Match AS M
        UNION ALL
        SELECT M.season,
               M.league_id,
               M.away_team_api_id      AS team_api_id,
               CASE
                   WHEN M.away_team_goal > M.home_team_goal THEN 3
                   WHEN M.away_team_goal = M.home_team_goal THEN 1
                   ELSE 0
               END                     AS points
        FROM Match AS M
     )
GROUP BY season,
         league_id,
         team_api_id
LIMIT 20;
```

```sql
--Description: 7) For every season-league, find the maximum points achieved
WITH team_points AS (
     SELECT season,
            league_id,
            team_api_id,
            SUM(points) AS total_points
     FROM (
             SELECT M.season,
                    M.league_id,
                    M.home_team_api_id      AS team_api_id,
                    CASE
                        WHEN M.home_team_goal > M.away_team_goal THEN 3
                        WHEN M.home_team_goal = M.away_team_goal THEN 1
                        ELSE 0
                    END                     AS points
             FROM Match AS M
             UNION ALL
             SELECT M.season,
                    M.league_id,
                    M.away_team_api_id      AS team_api_id,
                    CASE
                        WHEN M.away_team_goal > M.home_team_goal THEN 3
                        WHEN M.away_team_goal = M.home_team_goal THEN 1
                        ELSE 0
                    END                     AS points
             FROM Match AS M
          )
     GROUP BY season,
              league_id,
              team_api_id
)
SELECT season,
       league_id,
       MAX(total_points) AS max_points
FROM team_points
GROUP BY season,
         league_id
LIMIT 20;
```

```sql
--Description: 8) Retrieve the champion team_api_id for each season & league
WITH team_points AS (
     SELECT season,
            league_id,
            team_api_id,
            SUM(points) AS total_points
     FROM (
             SELECT M.season,
                    M.league_id,
                    M.home_team_api_id      AS team_api_id,
                    CASE
                        WHEN M.home_team_goal > M.away_team_goal THEN 3
                        WHEN M.home_team_goal = M.away_team_goal THEN 1
                        ELSE 0
                    END                     AS points
             FROM Match AS M
             UNION ALL
             SELECT M.season,
                    M.league_id,
                    M.away_team_api_id      AS team_api_id,
                    CASE
                        WHEN M.away_team_goal > M.home_team_goal THEN 3
                        WHEN M.away_team_goal = M.home_team_goal THEN 1
                        ELSE 0
                    END                     AS points
             FROM Match AS M
          )
     GROUP BY season,
              league_id,
              team_api_id
),
league_max AS (
     SELECT season,
            league_id,
            MAX(total_points) AS max_points
     FROM team_points
     GROUP BY season,
              league_id
)
SELECT tp.season,
       tp.league_id,
       tp.team_api_id,
       tp.total_points
FROM team_points  AS tp
JOIN league_max   AS lm
  ON tp.season      = lm.season
 AND tp.league_id   = lm.league_id
 AND tp.total_points= lm.max_points
LIMIT 20;
```

```sql
--Description: 9) Add the human-readable team & league names for the champions
WITH team_points AS (
     SELECT season,
            league_id,
            team_api_id,
            SUM(points) AS total_points
     FROM (
             SELECT M.season,
                    M.league_id,
                    M.home_team_api_id      AS team_api_id,
                    CASE
                        WHEN M.home_team_goal > M.away_team_goal THEN 3
                        WHEN M.home_team_goal = M.away_team_goal THEN 1
                        ELSE 0
                    END                     AS points
             FROM Match AS M
             UNION ALL
             SELECT M.season,
                    M.league_id,
                    M.away_team_api_id      AS team_api_id,
                    CASE
                        WHEN M.away_team_goal > M.home_team_goal THEN 3
                        WHEN M.away_team_goal = M.home_team_goal THEN 1
                        ELSE 0
                    END                     AS points
             FROM Match AS M
          )
     GROUP BY season,
              league_id,
              team_api_id
),
league_max AS (
     SELECT season,
            league_id,
            MAX(total_points) AS max_points
     FROM team_points
     GROUP BY season,
              league_id
),
champions AS (
     SELECT tp.season,
            tp.league_id,
            tp.team_api_id,
            tp.total_points
     FROM team_points AS tp
     JOIN league_max  AS lm
       ON tp.season       = lm.season
      AND tp.league_id    = lm.league_id
      AND tp.total_points = lm.max_points
)
SELECT ch.season,
       T.team_long_name AS team_name,
       L.name           AS league_name,
       ch.total_points
FROM champions AS ch
JOIN Team      AS T ON ch.team_api_id = T.team_api_id
JOIN League    AS L ON ch.league_id   = L.id
LIMIT 20;
```

```sql
--Description: 10) FINAL ANSWER – champion team, league, country & total points for every season
WITH team_points AS (
     SELECT season,
            league_id,
            team_api_id,
            SUM(points) AS total_points
     FROM (
             SELECT M.season,
                    M.league_id,
                    M.home_team_api_id      AS team_api_id,
                    CASE
                        WHEN M.home_team_goal > M.away_team_goal THEN 3
                        WHEN M.home_team_goal = M.away_team_goal THEN 1
                        ELSE 0
                    END                     AS points
             FROM Match AS M
             UNION ALL
             SELECT M.season,
                    M.league_id,
                    M.away_team_api_id      AS team_api_id,
                    CASE
                        WHEN M.away_team_goal > M.home_team_goal THEN 3
                        WHEN M.away_team_goal = M.home_team_goal THEN 1
                        ELSE 0
                    END                     AS points
             FROM Match AS M
          )
     GROUP BY season,
              league_id,
              team_api_id
),
league_max AS (
     SELECT season,
            league_id,
            MAX(total_points) AS max_points
     FROM team_points
     GROUP BY season,
              league_id
),
champions AS (
     SELECT tp.season,
            tp.league_id,
            tp.team_api_id,
            tp.total_points
     FROM team_points AS tp
     JOIN league_max  AS lm
       ON tp.season       = lm.season
      AND tp.league_id    = lm.league_id
      AND tp.total_points = lm.max_points
)
SELECT ch.season,
       T.team_long_name   AS team_name,
       L.name             AS league_name,
       C.name             AS country_name,
       ch.total_points
FROM champions AS ch
JOIN Team      AS T ON ch.team_api_id = T.team_api_id
JOIN League    AS L ON ch.league_id   = L.id
JOIN Country   AS C ON L.country_id   = C.id
ORDER BY ch.season,
         country_name,
         league_name
LIMIT 20;
```
