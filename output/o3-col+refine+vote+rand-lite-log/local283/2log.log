       END                AS home_points,
       CASE
           WHEN M.away_team_goal > M.home_team_goal THEN 3
           WHEN M.away_team_goal = M.home_team_goal THEN 1
           ELSE 0
       END                AS away_points
FROM Match            AS M
JOIN Team             AS TH ON M.home_team_api_id = TH.team_api_id
JOIN Team             AS TA ON M.away_team_api_id = TA.team_api_id
LIMIT 20;
