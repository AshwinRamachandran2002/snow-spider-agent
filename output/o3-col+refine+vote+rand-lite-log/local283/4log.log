```sql
--Description: Retrieve all seasons that exist in the Match table. 
SELECT DISTINCT season 
FROM "Match" 
LIMIT 20;
```

```sql
--Description: Inspect a handful of matches together with the goals scored. 
SELECT season,
       match_api_id,
       home_team_api_id,
       away_team_api_id,
       home_team_goal,
       away_team_goal
FROM "Match"
LIMIT 20;
```

```sql
--Description: Map a few team_api_id values to their proper long names. 
SELECT DISTINCT m.home_team_api_id AS team_api_id,
       t.team_long_name
FROM "Match" AS m
JOIN "Team"  AS t
  ON m.home_team_api_id = t.team_api_id
LIMIT 20;
```

```sql
--Description: Calculate the points earned by the home side in each match. 
SELECT season,
       home_team_api_id AS team_api_id,
       CASE 
           WHEN home_team_goal > away_team_goal THEN 3
           WHEN home_team_goal = away_team_goal THEN 1
           ELSE 0
       END AS points
FROM "Match"
LIMIT 20;
```

```sql
--Description: Calculate the points earned by the away side in each match. 
SELECT season,
       away_team_api_id AS team_api_id,
       CASE 
           WHEN away_team_goal > home_team_goal THEN 3
           WHEN away_team_goal = home_team_goal THEN 1
           ELSE 0
       END AS points
FROM "Match"
LIMIT 20;
```

```sql
--Description: Combine home-side and away-side points into one unified set. 
SELECT *
FROM (
    SELECT season,
           league_id,
           home_team_api_id AS team_api_id,
           CASE 
               WHEN home_team_goal > away_team_goal THEN 3
               WHEN home_team_goal = away_team_goal THEN 1
               ELSE 0
           END AS points
    FROM "Match"
    UNION ALL
    SELECT season,
           league_id,
           away_team_api_id,
           CASE 
               WHEN away_team_goal > home_team_goal THEN 3
               WHEN away_team_goal = home_team_goal THEN 1
               ELSE 0
           END
    FROM "Match"
) AS all_points
LIMIT 20;
```

```sql
--Description: Aggregate total points for every team within each league-season. 
SELECT season,
       league_id,
       team_api_id,
       SUM(points) AS total_points
FROM (
    SELECT season,
           league_id,
           home_team_api_id AS team_api_id,
           CASE 
               WHEN home_team_goal > away_team_goal THEN 3
               WHEN home_team_goal = away_team_goal THEN 1
               ELSE 0
           END AS points
    FROM "Match"
    UNION ALL
    SELECT season,
           league_id,
           away_team_api_id,
           CASE 
               WHEN away_team_goal > home_team_goal THEN 3
               WHEN away_team_goal = home_team_goal THEN 1
               ELSE 0
           END
    FROM "Match"
) AS all_points
GROUP BY season, league_id, team_api_id
LIMIT 20;
```

```sql
--Description: For each league-season determine the maximum points (i.e., champion points). 
SELECT season,
       league_id,
       MAX(total_points) AS max_points
FROM (
    SELECT season,
           league_id,
           team_api_id,
           SUM(points) AS total_points
    FROM (
        SELECT season,
               league_id,
               home_team_api_id AS team_api_id,
               CASE 
                   WHEN home_team_goal > away_team_goal THEN 3
                   WHEN home_team_goal = away_team_goal THEN 1
                   ELSE 0
               END AS points
        FROM "Match"
        UNION ALL
        SELECT season,
               league_id,
               away_team_api_id,
               CASE 
                   WHEN away_team_goal > home_team_goal THEN 3
                   WHEN away_team_goal = home_team_goal THEN 1
                   ELSE 0
               END
        FROM "Match"
    ) AS union_pts
    GROUP BY season, league_id, team_api_id
) AS team_totals
GROUP BY season, league_id
LIMIT 20;
```

```sql
--Description: Pull out the team(s) whose point total equals the max in each league-season. 
WITH points AS (
    SELECT season,
           league_id,
           home_team_api_id AS team_api_id,
           CASE 
               WHEN home_team_goal > away_team_goal THEN 3
               WHEN home_team_goal = away_team_goal THEN 1
               ELSE 0
           END AS pts
    FROM "Match"
    UNION ALL
    SELECT season,
           league_id,
           away_team_api_id,
           CASE 
               WHEN away_team_goal > home_team_goal THEN 3
               WHEN away_team_goal = home_team_goal THEN 1
               ELSE 0
           END
    FROM "Match"
), totals AS (
    SELECT season,
           league_id,
           team_api_id,
           SUM(pts) AS total_points
    FROM points
    GROUP BY season, league_id, team_api_id
), max_per_league AS (
    SELECT season,
           league_id,
           MAX(total_points) AS max_points
    FROM totals
    GROUP BY season, league_id
)
SELECT t.season,
       t.league_id,
       t.team_api_id,
       t.total_points
FROM totals t
JOIN max_per_league m
  ON t.season = m.season
 AND t.league_id = m.league_id
 AND t.total_points = m.max_points
LIMIT 20;
```

```sql
--Description: Final champion list – country, league, team name, season, and total points. 
WITH points AS (
    SELECT season,
           league_id,
           home_team_api_id AS team_api_id,
           CASE 
               WHEN home_team_goal > away_team_goal THEN 3
               WHEN home_team_goal = away_team_goal THEN 1
               ELSE 0
           END AS pts
    FROM "Match"
    UNION ALL
    SELECT season,
           league_id,
           away_team_api_id,
           CASE 
               WHEN away_team_goal > home_team_goal THEN 3
               WHEN away_team_goal = home_team_goal THEN 1
               ELSE 0
           END
    FROM "Match"
), totals AS (
    SELECT season,
           league_id,
           team_api_id,
           SUM(pts) AS total_points
    FROM points
    GROUP BY season, league_id, team_api_id
), max_per_league AS (
    SELECT season,
           league_id,
           MAX(total_points) AS max_points
    FROM totals
    GROUP BY season, league_id
), champions AS (
    SELECT t.season,
           t.league_id,
           t.team_api_id,
           t.total_points
    FROM totals t
    JOIN max_per_league m
      ON t.season   = m.season
     AND t.league_id = m.league_id
     AND t.total_points = m.max_points
)
SELECT c.name              AS country,
       l.name              AS league,
       tm.team_long_name   AS team,
       ch.total_points,
       ch.season
FROM champions  AS ch
JOIN "League"   AS l  ON ch.league_id  = l.id
JOIN "Country"  AS c  ON l.country_id  = c.id
JOIN "Team"     AS tm ON ch.team_api_id = tm.team_api_id
LIMIT 20;
```
