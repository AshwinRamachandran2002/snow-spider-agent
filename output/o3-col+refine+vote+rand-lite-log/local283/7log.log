```sql
-- 1) Distinct list of seasons that exist in the Match table  
SELECT DISTINCT "season"
FROM "Match"
LIMIT 20;
```

```sql
-- 2) Distinct (season , league) pairs so we see how many different
--    leagues are played per season
SELECT DISTINCT m."season",
                l."name"        AS "league_name"
FROM   "Match"  AS m
JOIN   "League" AS l
       ON m."league_id" = l."id"
ORDER  BY m."season" , l."name"
LIMIT 20;
```

```sql
-- 3) Take a quick look at one season’s raw match results with the
--    corresponding home / away team long names
SELECT m."season",
       m."date",
       th."team_long_name" AS "home_team",
       ta."team_long_name" AS "away_team",
       m."home_team_goal",
       m."away_team_goal"
FROM   "Match" AS m
JOIN   "Team"  AS th ON m."home_team_api_id" = th."team_api_id"
JOIN   "Team"  AS ta ON m."away_team_api_id" = ta."team_api_id"
WHERE  m."season" = '2013/2014'
LIMIT 20;
```

```sql
-- 4) Award points to the HOME side in every match (3-1-0 system)
SELECT m."id",
       m."season",
       m."home_team_api_id"                 AS "team_api_id",
       CASE
           WHEN m."home_team_goal" > m."away_team_goal" THEN 3
           WHEN m."home_team_goal" = m."away_team_goal" THEN 1
           ELSE 0
       END                                   AS "points"
FROM   "Match" AS m
LIMIT 20;
```

```sql
-- 5) Award points to the AWAY side in every match (3-1-0 system)
SELECT m."id",
       m."season",
       m."away_team_api_id"                 AS "team_api_id",
       CASE
           WHEN m."away_team_goal" > m."home_team_goal" THEN 3
           WHEN m."away_team_goal" = m."home_team_goal" THEN 1
           ELSE 0
       END                                   AS "points"
FROM   "Match" AS m
LIMIT 20;
```

```sql
-- 6) Combine home- and away-side points, aggregate to get total points
--    each team earned per season and per league
WITH points AS (
       SELECT m."season",
              m."league_id",
              m."home_team_api_id" AS "team_api_id",
              CASE
                  WHEN m."home_team_goal" > m."away_team_goal" THEN 3
                  WHEN m."home_team_goal" = m."away_team_goal" THEN 1
                  ELSE 0
              END AS "pts"
       FROM   "Match" AS m

       UNION ALL

       SELECT m."season",
              m."league_id",
              m."away_team_api_id",
              CASE
                  WHEN m."away_team_goal" > m."home_team_goal" THEN 3
                  WHEN m."away_team_goal" = m."home_team_goal" THEN 1
                  ELSE 0
              END
       FROM   "Match" AS m
)
SELECT   p."season",
         p."league_id",
         p."team_api_id",
         SUM(p."pts") AS "total_points"
FROM     points AS p
GROUP BY p."season", p."league_id", p."team_api_id"
ORDER BY p."season", "total_points" DESC
LIMIT 20;
```

```sql
-- 7) Attach the human-readable team name and league name to the point totals
WITH season_team_points AS (
       SELECT p."season",
              p."league_id",
              t."team_long_name"       AS "team_name",
              SUM(p."pts")             AS "points"
       FROM (
              SELECT m."season",
                     m."league_id",
                     m."home_team_api_id" AS "team_api_id",
                     CASE
                         WHEN m."home_team_goal" > m."away_team_goal" THEN 3
                         WHEN m."home_team_goal" = m."away_team_goal" THEN 1
                         ELSE 0
                     END AS "pts"
              FROM "Match" AS m

              UNION ALL

              SELECT m."season",
                     m."league_id",
                     m."away_team_api_id",
                     CASE
                         WHEN m."away_team_goal" > m."home_team_goal" THEN 3
                         WHEN m."away_team_goal" = m."home_team_goal" THEN 1
                         ELSE 0
                     END
              FROM "Match" AS m
       ) AS p
       JOIN "Team" AS t
            ON p."team_api_id" = t."team_api_id"
       GROUP BY p."season", p."league_id", p."team_api_id"
)
SELECT *
FROM   season_team_points
ORDER  BY "season", "points" DESC
LIMIT 20;
```

```sql
-- 8) Bring in league & country names to the aggregated points table
WITH season_team_points AS (
       SELECT p."season",
              p."league_id",
              t."team_long_name"       AS "team_name",
              SUM(p."pts")             AS "points"
       FROM (
              SELECT m."season",
                     m."league_id",
                     m."home_team_api_id" AS "team_api_id",
                     CASE
                         WHEN m."home_team_goal" > m."away_team_goal" THEN 3
                         WHEN m."home_team_goal" = m."away_team_goal" THEN 1
                         ELSE 0
                     END AS "pts"
              FROM "Match" AS m

              UNION ALL

              SELECT m."season",
                     m."league_id",
                     m."away_team_api_id",
                     CASE
                         WHEN m."away_team_goal" > m."home_team_goal" THEN 3
                         WHEN m."away_team_goal" = m."home_team_goal" THEN 1
                         ELSE 0
                     END
              FROM "Match" AS m
       ) AS p
       JOIN "Team" AS t
            ON p."team_api_id" = t."team_api_id"
       GROUP BY p."season", p."league_id", p."team_api_id"
)
SELECT stp."season",
       l."name"        AS "league_name",
       c."name"        AS "country_name",
       stp."team_name",
       stp."points"
FROM   season_team_points AS stp
JOIN   "League"  AS l ON stp."league_id" = l."id"
JOIN   "Country" AS c ON l."country_id" = c."id"
ORDER  BY stp."season", stp."points" DESC
LIMIT 20;
```

```sql
-- 9) For every (season , league) find the single champion
WITH season_team_points AS (
       SELECT p."season",
              p."league_id",
              t."team_long_name"       AS "team_name",
              SUM(p."pts")             AS "points"
       FROM (
              SELECT m."season",
                     m."league_id",
                     m."home_team_api_id" AS "team_api_id",
                     CASE
                         WHEN m."home_team_goal" > m."away_team_goal" THEN 3
                         WHEN m."home_team_goal" = m."away_team_goal" THEN 1
                         ELSE 0
                     END AS "pts"
              FROM "Match" AS m
              UNION ALL
              SELECT m."season",
                     m."league_id",
                     m."away_team_api_id",
                     CASE
                         WHEN m."away_team_goal" > m."home_team_goal" THEN 3
                         WHEN m."away_team_goal" = m."home_team_goal" THEN 1
                         ELSE 0
                     END
              FROM "Match" AS m
       ) AS p
       JOIN "Team" AS t
            ON p."team_api_id" = t."team_api_id"
       GROUP BY p."season", p."league_id", p."team_api_id"
),
ranked AS (
       SELECT stp.*,
              ROW_NUMBER() OVER (PARTITION BY stp."season", stp."league_id"
                                 ORDER BY stp."points" DESC) AS rn
       FROM   season_team_points AS stp
)
SELECT r."season",
       l."name"      AS "league_name",
       c."name"      AS "country_name",
       r."team_name",
       r."points"
FROM   ranked AS r
JOIN   "League"  AS l ON r."league_id" = l."id"
JOIN   "Country" AS c ON l."country_id" = c."id"
WHERE  r.rn = 1          -- champion
ORDER  BY r."season", l."name"
LIMIT 20;
```

```sql
-- 10) Return the champions for EVERY season across ALL leagues
--     (full answer, no LIMIT used here – remove it to get the entire list)
WITH season_team_points AS (
       SELECT p."season",
              p."league_id",
              t."team_long_name"       AS "team_name",
              SUM(p."pts")             AS "points"
       FROM (
              SELECT m."season",
                     m."league_id",
                     m."home_team_api_id" AS "team_api_id",
                     CASE
                         WHEN m."home_team_goal" > m."away_team_goal" THEN 3
                         WHEN m."home_team_goal" = m."away_team_goal" THEN 1
                         ELSE 0
                     END AS "pts"
              FROM "Match" AS m
              UNION ALL
              SELECT m."season",
                     m."league_id",
                     m."away_team_api_id",
                     CASE
                         WHEN m."away_team_goal" > m."home_team_goal" THEN 3
                         WHEN m."away_team_goal" = m."home_team_goal" THEN 1
                         ELSE 0
                     END
              FROM "Match" AS m
       ) AS p
       JOIN "Team" AS t
            ON p."team_api_id" = t."team_api_id"
       GROUP BY p."season", p."league_id", p."team_api_id"
),
champions AS (
       SELECT stp.*,
              ROW_NUMBER() OVER (PARTITION BY stp."season", stp."league_id"
                                 ORDER BY stp."points" DESC) AS rn
       FROM   season_team_points AS stp
)
SELECT c."name"      AS "country",
       l."name"      AS "league",
       ch."season",
       ch."team_name" AS "champion_team",
       ch."points"
FROM   champions AS ch
JOIN   "League"  AS l ON ch."league_id" = l."id"
JOIN   "Country" AS c ON l."country_id" = c."id"
WHERE  ch.rn = 1
ORDER  BY ch."season", c."name", l."name"
LIMIT 20;
```
