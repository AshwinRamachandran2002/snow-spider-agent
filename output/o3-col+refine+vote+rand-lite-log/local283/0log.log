Query:
-- 4. Description: Aggregate total points per team in one season / league
--                (here: Belgium Jupiler League 2008/2009, league_id = 1)
WITH match_points AS (
    SELECT "season",
           "league_id",
           "home_team_api_id" AS team_api_id,
           CASE
               WHEN "home_team_goal" > "away_team_goal" THEN 3
               WHEN "home_team_goal" = "away_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
    WHERE "season" = '2008/2009' AND "league_id" = 1
    UNION ALL
    SELECT "season",
           "league_id",
