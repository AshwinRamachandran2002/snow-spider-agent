```sql
-- 1. Description: A quick look at all seasons recorded in the Match table
SELECT DISTINCT "season"
FROM "Match"
LIMIT 20;
```

```sql
-- 2. Description: Inspect a handful of matches to see the goal columns we will use
SELECT "id",
       "season",
       "league_id",
       "home_team_api_id",
       "away_team_api_id",
       "home_team_goal",
       "away_team_goal"
FROM "Match"
LIMIT 20;
```

```sql
-- 3. Description: Compute the number of points the HOME side would
--                earn for the first 20 matches (3 win / 1 draw / 0 loss)
SELECT "id",
       "season",
       CASE
           WHEN "home_team_goal" > "away_team_goal" THEN 3
           WHEN "home_team_goal" = "away_team_goal" THEN 1
           ELSE 0
       END AS "home_points"
FROM "Match"
LIMIT 20;
```

```sql
-- 4. Description: Aggregate total points per team in one season / league
--                (here: Belgium Jupiler League 2008/2009, league_id = 1)
WITH match_points AS (
    SELECT "season",
           "league_id",
           "home_team_api_id" AS team_api_id,
           CASE
               WHEN "home_team_goal" > "away_team_goal" THEN 3
               WHEN "home_team_goal" = "away_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
    WHERE "season" = '2008/2009' AND "league_id" = 1
    UNION ALL
    SELECT "season",
           "league_id",
           "away_team_api_id" AS team_api_id,
           CASE
               WHEN "away_team_goal" > "home_team_goal" THEN 3
               WHEN "away_team_goal" = "home_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
    WHERE "season" = '2008/2009' AND "league_id" = 1
)
SELECT mp."team_api_id",
       SUM(mp.points) AS "total_points"
FROM match_points AS mp
GROUP BY mp."team_api_id"
ORDER BY "total_points" DESC
LIMIT 20;
```

```sql
-- 5. Description: Retrieve the Belgian champion in 2008/2009
WITH match_points AS (
    SELECT "season",
           "league_id",
           "home_team_api_id" AS team_api_id,
           CASE
               WHEN "home_team_goal" > "away_team_goal" THEN 3
               WHEN "home_team_goal" = "away_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
    WHERE "season" = '2008/2009' AND "league_id" = 1
    UNION ALL
    SELECT "season",
           "league_id",
           "away_team_api_id" AS team_api_id,
           CASE
               WHEN "away_team_goal" > "home_team_goal" THEN 3
               WHEN "away_team_goal" = "home_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
    WHERE "season" = '2008/2009' AND "league_id" = 1
), season_team_points AS (
    SELECT "team_api_id",
           SUM(points) AS total_points
    FROM match_points
    GROUP BY "team_api_id"
), champion AS (
    SELECT MAX(total_points) AS max_pts
    FROM season_team_points
)
SELECT t."team_long_name",
       stp."total_points"
FROM season_team_points AS stp
JOIN champion AS c ON stp.total_points = c.max_pts
JOIN "Team"  AS t ON t."team_api_id" = stp."team_api_id"
LIMIT 20;
```

```sql
-- 6. Description: Show a mapping of league → country for reference
SELECT DISTINCT l."id"            AS league_id,
       l."name"          AS league_name,
       c."name"          AS country_name
FROM "League" AS l
JOIN "Country" AS c ON c."id" = l."country_id"
LIMIT 20;
```

```sql
-- 7. Description: Build a reusable CTE that gives points for every match
--                (home + away rows) for the whole dataset (first 20 rows shown)
WITH match_points AS (
    SELECT "season",
           "league_id",
           "home_team_api_id" AS team_api_id,
           CASE
               WHEN "home_team_goal" > "away_team_goal" THEN 3
               WHEN "home_team_goal" = "away_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
    UNION ALL
    SELECT "season",
           "league_id",
           "away_team_api_id" AS team_api_id,
           CASE
               WHEN "away_team_goal" > "home_team_goal" THEN 3
               WHEN "away_team_goal" = "home_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
)
SELECT *
FROM match_points
LIMIT 20;
```

```sql
-- 8. Description: Total points per team, per season, per league (sample 20 rows)
WITH match_points AS (
    SELECT "season",
           "league_id",
           "home_team_api_id" AS team_api_id,
           CASE
               WHEN "home_team_goal" > "away_team_goal" THEN 3
               WHEN "home_team_goal" = "away_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
    UNION ALL
    SELECT "season",
           "league_id",
           "away_team_api_id" AS team_api_id,
           CASE
               WHEN "away_team_goal" > "home_team_goal" THEN 3
               WHEN "away_team_goal" = "home_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
)
SELECT "season",
       "league_id",
       "team_api_id",
       SUM(points) AS total_points
FROM match_points
GROUP BY "season","league_id","team_api_id"
LIMIT 20;
```

```sql
-- 9. Description: Identify, for every season & league, the highest points tally
WITH match_points AS (
    SELECT "season",
           "league_id",
           "home_team_api_id" AS team_api_id,
           CASE
               WHEN "home_team_goal" > "away_team_goal" THEN 3
               WHEN "home_team_goal" = "away_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
    UNION ALL
    SELECT "season",
           "league_id",
           "away_team_api_id" AS team_api_id,
           CASE
               WHEN "away_team_goal" > "home_team_goal" THEN 3
               WHEN "away_team_goal" = "home_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
),
season_team_points AS (
    SELECT "season",
           "league_id",
           "team_api_id",
           SUM(points) AS total_points
    FROM match_points
    GROUP BY "season","league_id","team_api_id"
)
SELECT "season",
       "league_id",
       MAX(total_points) AS max_points
FROM season_team_points
GROUP BY "season","league_id"
LIMIT 20;
```

```sql
-- 10. Description: FINAL ANSWER – Champion team for every season & league,
--                  with league and country names and their total points
WITH match_points AS (
    SELECT "season",
           "league_id",
           "home_team_api_id" AS team_api_id,
           CASE
               WHEN "home_team_goal" > "away_team_goal" THEN 3
               WHEN "home_team_goal" = "away_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
    UNION ALL
    SELECT "season",
           "league_id",
           "away_team_api_id" AS team_api_id,
           CASE
               WHEN "away_team_goal" > "home_team_goal" THEN 3
               WHEN "away_team_goal" = "home_team_goal" THEN 1
               ELSE 0
           END AS points
    FROM "Match"
),
season_team_points AS (
    SELECT "season",
           "league_id",
           "team_api_id",
           SUM(points) AS total_points
    FROM match_points
    GROUP BY "season","league_id","team_api_id"
),
season_league_max AS (
    SELECT "season",
           "league_id",
           MAX(total_points) AS max_points
    FROM season_team_points
    GROUP BY "season","league_id"
)
SELECT stp."season"                         AS season,
       t."team_long_name"                   AS champion_team,
       l."name"                             AS league,
       c."name"                             AS country,
       stp."total_points"                   AS points
FROM  season_team_points  AS stp
JOIN  season_league_max   AS slm
      ON  stp."season"      = slm."season"
      AND stp."league_id"   = slm."league_id"
      AND stp."total_points"= slm."max_points"
JOIN  "Team"    AS t ON t."team_api_id" = stp."team_api_id"
JOIN  "League"  AS l ON l."id"          = stp."league_id"
JOIN  "Country" AS c ON c."id"          = l."country_id"
ORDER BY stp."season",
         country,
         league,
         champion_team
LIMIT 20;
```
