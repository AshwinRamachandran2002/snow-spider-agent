-- 7) Champion of that league-season (highest total_points)
SELECT t.team_long_name,
       p.total_points
FROM   (
          SELECT team_api_id,
                 SUM(points) AS total_points
          FROM   (
                    SELECT home_team_api_id AS team_api_id,
                           CASE
                               WHEN home_team_goal > away_team_goal THEN 3
                               WHEN home_team_goal = away_team_goal THEN 1
                               ELSE 0
                           END AS points
                    FROM   "Match"
                    WHERE  league_id = 1729
                      AND  season    = '2008/2009'
                    UNION ALL
                    SELECT away_team_api_id,
                           CASE
                               WHEN away_team_goal > home_team_goal THEN 3
                               WHEN away_team_goal = home_team_goal THEN 1
                               ELSE 0
                           END
                    FROM   "Match"
                    WHERE  league_id = 1729
                      AND  season    = '2008/2009'
                 )
          GROUP BY team_api_id
       ) AS p
JOIN   "Team" AS t
       ON p.team_api_id = t.team_api_id
ORDER BY p.total_points DESC
LIMIT 1;
