```sql
-- 5) A quick look at one league-season: England Premier League, 2008/2009
SELECT id,
       season,
       home_team_api_id,
       away_team_api_id,
       home_team_goal,
       away_team_goal
FROM   "Match"
WHERE  league_id = 1729          -- England Premier League
  AND  season    = '2008/2009'
LIMIT 20;
```

```sql
-- 6) Points earned by every team in that single league-season (ENG 2008/2009)
SELECT team_api_id,
       SUM(points) AS total_points
FROM   (
          SELECT home_team_api_id AS team_api_id,
                 CASE
                     WHEN home_team_goal > away_team_goal THEN 3
                     WHEN home_team_goal = away_team_goal THEN 1
                     ELSE 0
                 END              AS points
          FROM   "Match"
          WHERE  league_id = 1729
            AND  season    = '2008/2009'
          UNION ALL
          SELECT away_team_api_id,
                 CASE
                     WHEN away_team_goal > home_team_goal THEN 3
                     WHEN away_team_goal = home_team_goal THEN 1
                     ELSE 0
                 END
          FROM   "Match"
          WHERE  league_id = 1729
            AND  season    = '2008/2009'
       )
GROUP BY team_api_id
ORDER BY total_points DESC
LIMIT 20;
```

```sql
-- 7) Champion of that league-season (highest total_points)
SELECT t.team_long_name,
       p.total_points
FROM   (
          SELECT team_api_id,
                 SUM(points) AS total_points
          FROM   (
                    SELECT home_team_api_id AS team_api_id,
                           CASE
                               WHEN home_team_goal > away_team_goal THEN 3
                               WHEN home_team_goal = away_team_goal THEN 1
                               ELSE 0
                           END AS points
                    FROM   "Match"
                    WHERE  league_id = 1729
                      AND  season    = '2008/2009'
                    UNION ALL
                    SELECT away_team_api_id,
                           CASE
                               WHEN away_team_goal > home_team_goal THEN 3
                               WHEN away_team_goal = home_team_goal THEN 1
                               ELSE 0
                           END
                    FROM   "Match"
                    WHERE  league_id = 1729
                      AND  season    = '2008/2009'
                 )
          GROUP BY team_api_id
       ) AS p
JOIN   "Team" AS t
       ON p.team_api_id = t.team_api_id
ORDER BY p.total_points DESC
LIMIT 1;
```

```sql
-- 8) Points table for EVERY league & season – one row per team
SELECT season,
       league_id,
       team_api_id,
       SUM(points) AS total_points
FROM   (
          /* Home points */
          SELECT season,
                 league_id,
                 home_team_api_id AS team_api_id,
                 CASE
                     WHEN home_team_goal > away_team_goal THEN 3
                     WHEN home_team_goal = away_team_goal THEN 1
                     ELSE 0
                 END AS points
          FROM   "Match"
          UNION ALL
          /* Away points */
          SELECT season,
                 league_id,
                 away_team_api_id,
                 CASE
                     WHEN away_team_goal > home_team_goal THEN 3
                     WHEN away_team_goal = home_team_goal THEN 1
                     ELSE 0
                 END
          FROM   "Match"
       )
GROUP BY season, league_id, team_api_id
LIMIT 20;
```

```sql
-- 9) Champion (team_id + points) for every league & season
WITH points AS (
     SELECT season,
            league_id,
            team_api_id,
            SUM(points) AS total_points
     FROM   (
               SELECT season,
                      league_id,
                      home_team_api_id AS team_api_id,
                      CASE
                          WHEN home_team_goal > away_team_goal THEN 3
                          WHEN home_team_goal = away_team_goal THEN 1
                          ELSE 0
                      END AS points
               FROM   "Match"
               UNION ALL
               SELECT season,
                      league_id,
                      away_team_api_id,
                      CASE
                          WHEN away_team_goal > home_team_goal THEN 3
                          WHEN away_team_goal = home_team_goal THEN 1
                          ELSE 0
                      END
               FROM   "Match"
            )
     GROUP BY season, league_id, team_api_id
),
max_pts AS (
     SELECT season,
            league_id,
            MAX(total_points) AS pts_needed
     FROM   points
     GROUP BY season, league_id
)
SELECT p.season,
       p.league_id,
       p.team_api_id,
       p.total_points
FROM   points  AS p
JOIN   max_pts AS m
       ON  p.season    = m.season
       AND p.league_id = m.league_id
       AND p.total_points = m.pts_needed
LIMIT 20;
```

```sql
-- 10) Final champion list with readable names (team, league, country, points)
WITH points AS (
     SELECT season,
            league_id,
            team_api_id,
            SUM(points) AS total_points
     FROM   (
               SELECT season,
                      league_id,
                      home_team_api_id AS team_api_id,
                      CASE
                          WHEN home_team_goal > away_team_goal THEN 3
                          WHEN home_team_goal = away_team_goal THEN 1
                          ELSE 0
                      END AS points
               FROM   "Match"
               UNION ALL
               SELECT season,
                      league_id,
                      away_team_api_id,
                      CASE
                          WHEN away_team_goal > home_team_goal THEN 3
                          WHEN away_team_goal = home_team_goal THEN 1
                          ELSE 0
                      END
               FROM   "Match"
            )
     GROUP BY season, league_id, team_api_id
),
max_pts AS (
     SELECT season,
            league_id,
            MAX(total_points) AS pts_needed
     FROM   points
     GROUP BY season, league_id
)
SELECT p.season,
       t.team_long_name        AS champion_team,
       l.name                  AS league_name,
       c.name                  AS country_name,
       p.total_points
FROM   points  AS p
JOIN   max_pts AS m
       ON  p.season    = m.season
       AND p.league_id = m.league_id
       AND p.total_points = m.pts_needed
JOIN   "Team"    AS t ON p.team_api_id = t.team_api_id
JOIN   "League"  AS l ON p.league_id   = l.id
JOIN   "Country" AS c ON l.country_id  = c.id
ORDER BY p.season, l.id
LIMIT 20;
```
