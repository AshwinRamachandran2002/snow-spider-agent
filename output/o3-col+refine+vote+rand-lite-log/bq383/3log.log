```sql
--Description: Year-by-year peaks for 2013-2016 (one row per year)
SELECT EXTRACT(YEAR FROM date)              AS yr,
       MAX(IF(element='PRCP', value, NULL))/10 AS max_prcp_mm,
       MIN(IF(element='TMIN', value, NULL))/10 AS min_temp_c,
       MAX(IF(element='TMAX', value, NULL))/10 AS max_temp_c
FROM (
  SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2013` UNION ALL
  SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2014` UNION ALL
  SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2015` UNION ALL
  SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
)
WHERE id = 'USW00094846'
  AND element IN ('PRCP','TMIN','TMAX')
  AND qflag IS NULL
  AND (SUBSTR(CAST(date AS STRING),6,5) BETWEEN '12-17' AND '12-31')
GROUP BY yr
ORDER BY yr
LIMIT 20;
```

```sql
--Description: Same as previous query but using UNNESTed list of years for flexibility
SELECT yr,
       MAX(IF(element='PRCP', value, NULL))/10 AS max_prcp_mm,
       MIN(IF(element='TMIN', value, NULL))/10 AS min_temp_c,
       MAX(IF(element='TMAX', value, NULL))/10 AS max_temp_c
FROM (
  -- build list of tables to UNION via array of year numbers
  SELECT * FROM UNNEST([2013,2014,2015,2016]) AS yr
  JOIN (
    SELECT * EXCEPT(table_year)
    FROM (
      -- 4 SELECTs, each annotated with the corresponding year
      SELECT 2013 AS table_year, * FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
      UNION ALL
      SELECT 2014, * FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
      UNION ALL
      SELECT 2015, * FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
      UNION ALL
      SELECT 2016, * FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
    )
  ) ON yr = table_year
)
WHERE id = 'USW00094846'
  AND element IN ('PRCP','TMIN','TMAX')
  AND qflag IS NULL
  AND (SUBSTR(CAST(date AS STRING),6,5) BETWEEN '12-17' AND '12-31')
GROUP BY yr
ORDER BY yr
LIMIT 20;
```
