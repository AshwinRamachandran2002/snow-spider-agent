  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
)
WHERE id = 'USW00094846'
  AND element IN ('PRCP', 'TMIN', 'TMAX')
  AND qflag IS NULL
  AND SUBSTR(CAST(date AS STRING), 6, 5) BETWEEN '12-17' AND '12-31'
GROUP BY yr
ORDER BY yr
