  AND element IN ('PRCP','TMIN','TMAX')                -- variables needed
  AND EXTRACT(MONTH FROM date) = 12                    -- December …
  AND EXTRACT(DAY   FROM date) BETWEEN 17 AND 31       -- … 17-31 (last 15 days)
GROUP BY yr
ORDER BY yr;
