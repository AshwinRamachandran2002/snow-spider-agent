```sql
--Description / Thinking process:
-- Objective: For weather station USW00094846, determine for each year 2013-2016, during the final
--            15 days of December (17-31):
--              • the highest daily precipitation (PRCP)   → mm
--              • the lowest  daily minimum temp (TMIN)    → °C
--              • the highest daily maximum temp (TMAX)    → °C
-- Data notes:  GHCN-D stores PRCP/TMIN/TMAX in tenths of mm / °C, so divide by 10.
-- Validation:  Retain only rows where qflag IS NULL (passed quality control) and value IS NOT NULL.
-- Approach:    UNION ALL the four annual tables, tag each row with its year, filter, then aggregate.
SELECT
  yr,
  MAX( CASE WHEN element = 'PRCP' THEN value END ) / 10.0  AS max_prcp_mm,
  MIN( CASE WHEN element = 'TMIN' THEN value END ) / 10.0  AS min_tmin_c,
  MAX( CASE WHEN element = 'TMAX' THEN value END ) / 10.0  AS max_tmax_c
FROM (
  SELECT 2013 AS yr, id, date, element, value, qflag FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  UNION ALL
  SELECT 2014, id, date, element, value, qflag       FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  UNION ALL
  SELECT 2015, id, date, element, value, qflag       FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  UNION ALL
  SELECT 2016, id, date, element, value, qflag       FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
) AS t
WHERE t.id       = 'USW00094846'
  AND t.element IN ('PRCP','TMIN','TMAX')
  AND t.qflag    IS NULL
  AND t.value    IS NOT NULL
  AND t.date BETWEEN DATE(yr,12,17) AND DATE(yr,12,31)
GROUP BY yr
ORDER BY yr;
```
