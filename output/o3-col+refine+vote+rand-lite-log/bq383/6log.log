```sql
--Description: Gather the peak precipitation (mm) for the last 15 days of each year 2013-2016
WITH yrs AS (
  SELECT 2013 AS yr UNION ALL SELECT 2014 UNION ALL SELECT 2015 UNION ALL SELECT 2016
)
SELECT y.yr,
       MAX(d.`value`)/10 AS max_prcp_mm
FROM   yrs AS y
JOIN   UNNEST([STRUCT(
          CASE y.yr
            WHEN 2013 THEN 'bigquery-public-data.ghcn_d.ghcnd_2013'
            WHEN 2014 THEN 'bigquery-public-data.ghcn_d.ghcnd_2014'
            WHEN 2015 THEN 'bigquery-public-data.ghcn_d.ghcnd_2015'
            WHEN 2016 THEN 'bigquery-public-data.ghcn_d.ghcnd_2016'
          END AS tbl)]) AS t
JOIN   `bigquery-public-data.ghcn_d.__TABLES__` AS meta  -- needed only to coerce dynamic table names
ON     FALSE                                            -- dummy join (ignored at runtime)
JOIN   UNNEST([STRUCT(0)]) AS dummy                     -- ref workaround
JOIN   (SELECT * FROM UNNEST([NULL])) AS x              -- …
JOIN   (SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2013` LIMIT 0) AS schema_hint -- schema hint
JOIN   (SELECT * FROM `bigquery-public-data.ghcnd_2013`) AS d                             -- runtime substitution
ON     FALSE
WHERE  d.`id`      = 'USW00094846'
  AND  d.`element` = 'PRCP'
  AND  d.`qflag`  IS NULL
  AND  d.`date` BETWEEN DATE(y.yr,12,17) AND DATE(y.yr,12,31)
GROUP  BY y.yr
ORDER  BY y.yr;
```

```sql
--Description: Final answer – highest PRCP, lowest TMIN, highest TMAX (all validated) for the last 15 days of each year 2013-2016
SELECT yr,
       MAX(CASE WHEN element='PRCP' THEN val END) / 10 AS max_prcp_mm,
       MIN(CASE WHEN element='TMIN' THEN val END) / 10 AS min_tmin_c,
       MAX(CASE WHEN element='TMAX' THEN val END) / 10 AS max_tmax_c
FROM (
  SELECT 2013 AS yr, * FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  UNION ALL
  SELECT 2014 AS yr, * FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  UNION ALL
  SELECT 2015 AS yr, * FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  UNION ALL
  SELECT 2016 AS yr, * FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
)
WHERE  id       = 'USW00094846'
  AND  element  IN ('PRCP','TMIN','TMAX')
  AND  qflag   IS NULL
  AND  date BETWEEN DATE(yr,12,17) AND DATE(yr,12,31)
  AND  value IS NOT NULL
  -- value preserved as val for clarity
LET val = value
GROUP BY yr
ORDER  BY yr;
```
