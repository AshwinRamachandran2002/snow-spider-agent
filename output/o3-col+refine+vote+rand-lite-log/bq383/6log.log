--Description: Lowest validated daily minimum temperature (°C) and highest validated daily maximum temperature (°C) for the last 15 days of 2013
SELECT MIN(CASE WHEN `element`='TMIN' THEN `value` END)/10 AS min_tmin_c_2013,
       MAX(CASE WHEN `element`='TMAX' THEN `value` END)/10 AS max_tmax_c_2013
FROM   `bigquery-public-data.ghcn_d.ghcnd_2013`
WHERE  `id` IN ('USW00094846')
  AND  `element` IN ('TMIN','TMAX')
  AND  `qflag` IS NULL
  AND  `date` BETWEEN DATE(2013,12,17) AND DATE(2013,12,31);
