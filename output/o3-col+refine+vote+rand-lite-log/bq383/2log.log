```sql
-- 🔟 Description: Final answer – highest validated precipitation (mm), minimum-temperature (°C),
--                 and maximum-temperature (°C) during the last 15 days of each year 2013-2016
WITH years AS (SELECT 2013 AS yr UNION ALL SELECT 2014 UNION ALL SELECT 2015 UNION ALL SELECT 2016),

element_max AS (
  SELECT
    yr AS year,
    element,
    MAX(value) AS max_val
  FROM (
    SELECT
      yr,
      element,
      value
    FROM years,
    UNNEST((
      SELECT ARRAY_AGG(STRUCT(element, value))
      FROM UNNEST(['PRCP','TMIN','TMAX']) AS element,
      `bigquery-public-data.ghcn_d.ghcnd_`||CAST(yr AS STRING)
      WHERE id = 'USW00094846'
        AND element IN ('PRCP','TMIN','TMAX')
        AND date BETWEEN CONCAT(CAST(yr AS STRING),'-12-17')
                    AND CONCAT(CAST(yr AS STRING),'-12-31')
        AND qflag IS NULL
    ))
  )
  GROUP BY year, element
)

SELECT
  year,
  MAX(CASE WHEN element = 'PRCP' THEN max_val/10 END) AS max_precip_mm,
  MAX(CASE WHEN element = 'TMIN' THEN max_val/10 END) AS highest_min_temp_c,
  MAX(CASE WHEN element = 'TMAX' THEN max_val/10 END) AS highest_max_temp_c
FROM element_max
GROUP BY year
ORDER BY year
LIMIT 20;
```
