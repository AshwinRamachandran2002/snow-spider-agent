```sql
--Description: Highest validated maximum temperature (°C) observed during 17-31 Dec
--             of each year 2013-2016 for station USW00094846.  Strategy: UNION the
--             four annual tables, keep only TMAX rows in the target window with no
--             quality-flag, then aggregate.
WITH unioned AS (
  SELECT 2013 AS yr, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id = 'USW00094846' AND element = 'TMAX'
    AND date BETWEEN '2013-12-17' AND '2013-12-31' AND qflag IS NULL
  
  UNION ALL
  SELECT 2014 AS yr, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id = 'USW00094846' AND element = 'TMAX'
    AND date BETWEEN '2014-12-17' AND '2014-12-31' AND qflag IS NULL
  
  UNION ALL
  SELECT 2015 AS yr, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id = 'USW00094846' AND element = 'TMAX'
    AND date BETWEEN '2015-12-17' AND '2015-12-31' AND qflag IS NULL
  
  UNION ALL
  SELECT 2016 AS yr, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id = 'USW00094846' AND element = 'TMAX'
    AND date BETWEEN '2016-12-17' AND '2016-12-31' AND qflag IS NULL
)
SELECT
  yr  AS year,
  MAX(value)/10 AS max_tmax_c      -- convert 0.1 °C → °C
FROM unioned
GROUP BY yr
ORDER BY yr;
```

```sql
