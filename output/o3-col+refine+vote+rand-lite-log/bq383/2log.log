--Description:  Final consolidated query (no dynamic SQL) that yields, for station
--              USW00094846, the highest validated precipitation (mm), highest minimum
--              temperature (°C) and highest maximum temperature (°C) recorded during
--              the 17 – 31 Dec window of each year 2013-2016.  Implementation:
--      1. UNION ALL the four annual GHCN-D tables while keeping only the three target
--         elements (PRCP, TMIN, TMAX), the date window, and rows with qflag IS NULL.
--      2. For every (year, element) pair compute MAX(value).  Values are stored in
--         tenths of the physical unit, so keep them in tenths for the MAX step.
--      3. Pivot the maxima into separate columns, dividing by 10 to convert to
--         millimetres / degrees Celsius, and order by year.
WITH unioned AS (
  SELECT 2013 AS yr, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2013-12-17' AND '2013-12-31'
    AND qflag IS NULL
  
  UNION ALL
  SELECT 2014, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2014-12-17' AND '2014-12-31'
    AND qflag IS NULL
  
  UNION ALL
  SELECT 2015, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2015-12-17' AND '2015-12-31'
    AND qflag IS NULL
  
  UNION ALL
  SELECT 2016, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2016-12-17' AND '2016-12-31'
    AND qflag IS NULL
),
peaks AS (
  SELECT
    yr,
    element,
    MAX(value) AS max_val_01        -- still in 0.1-unit scale
  FROM unioned
  GROUP BY yr, element
)
SELECT
  yr AS year,
  MAX(CASE WHEN element = 'PRCP' THEN max_val_01 / 10 END) AS max_precip_mm,
  MAX(CASE WHEN element = 'TMIN' THEN max_val_01 / 10 END) AS highest_min_temp_c,
  MAX(CASE WHEN element = 'TMAX' THEN max_val_01 / 10 END) AS highest_max_temp_c
FROM peaks
GROUP BY yr
ORDER BY yr
Results:
