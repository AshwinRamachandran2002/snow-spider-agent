--             of each year 2013-2016 for station USW00094846; identical approach to
--             the previous query but for element TMIN.
WITH unioned AS (
  SELECT 2013 AS yr, value FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id = 'USW00094846' AND element = 'TMIN'
    AND date BETWEEN '2013-12-17' AND '2013-12-31' AND qflag IS NULL
  
  UNION ALL
  SELECT 2014 AS yr, value FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id = 'USW00094846' AND element = 'TMIN'
    AND date BETWEEN '2014-12-17' AND '2014-12-31' AND qflag IS NULL
  
  UNION ALL
  SELECT 2015 AS yr, value FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id = 'USW00094846' AND element = 'TMIN'
    AND date BETWEEN '2015-12-17' AND '2015-12-31' AND qflag IS NULL
  
  UNION ALL
  SELECT 2016 AS yr, value FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id = 'USW00094846' AND element = 'TMIN'
    AND date BETWEEN '2016-12-17' AND '2016-12-31' AND qflag IS NULL
