```sql
--Description:  Single query to deliver the required answer (peak PRCP, TMIN, TMAX for
--              17-31 Dec of each year 2013-2016 at station USW00094846).  Thought steps:
--   • Data live in separate yearly tables, so we UNION them.
--   • Keep only rows where element is one of the three we need and qflag IS NULL
--     (validated data).  Restrict to 17-31 Dec window for each year.
--   • After unioning, find the MAX value for each (year, element) — still in tenths.
--   • Pivot the three maxima into columns and convert units (÷10 → mm / °C).
--   • Order chronologically.
WITH unioned AS (
  SELECT 2013 AS yr, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2013-12-17' AND '2013-12-31'
    AND qflag IS NULL
  
  UNION ALL
  SELECT 2014 AS yr, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2014-12-17' AND '2014-12-31'
    AND qflag IS NULL
  
  UNION ALL
  SELECT 2015 AS yr, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2015-12-17' AND '2015-12-31'
    AND qflag IS NULL
  
  UNION ALL
  SELECT 2016 AS yr, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN '2016-12-17' AND '2016-12-31'
    AND qflag IS NULL
),
peaks AS (
  SELECT
    yr,
    element,
    MAX(value) AS max_val              -- still ×0.1 units
  FROM unioned
  GROUP BY yr, element
)
SELECT
  yr AS year,
  MAX(CASE WHEN element = 'PRCP' THEN max_val/10 END) AS max_precip_mm,
  MAX(CASE WHEN element = 'TMIN' THEN max_val/10 END) AS highest_min_temp_c,
  MAX(CASE WHEN element = 'TMAX' THEN max_val/10 END) AS highest_max_temp_c
FROM peaks
GROUP BY yr
ORDER BY yr;
```
