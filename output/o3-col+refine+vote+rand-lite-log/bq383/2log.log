-- 9️⃣ Description: Combine precipitation, max-TMAX and max-TMIN into one result set per year  
WITH
  pr AS ( /* max PRCP */ SELECT * FROM ( /* query 6 without LIMIT */ ) ),
  tx AS ( /* max TMAX */ SELECT * FROM ( /* query 7 without LIMIT */ ) ),
  tn AS ( /* max TMIN */ SELECT * FROM ( /* query 8 without LIMIT */ ) )
SELECT pr.year,
       pr.max_prcp_mm,
       tn.max_tmin_c,
       tx.max_tmax_c
FROM pr
JOIN tn USING (year)
JOIN tx USING (year)
ORDER BY year
LIMIT 20;
