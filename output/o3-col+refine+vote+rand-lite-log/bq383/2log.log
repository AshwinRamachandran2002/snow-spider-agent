```sql
--Description: Combine the three separate maxima (PRCP, TMIN, TMAX) into one row per
--             year.  Each CTE re-computes the element-specific peak using the same
--             logic shown above, then the results are joined.
WITH
  pr AS (                  -- peak precipitation (mm)
    SELECT *
    FROM (
      WITH u AS (
        SELECT 2013 AS yr, value FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
         WHERE id='USW00094846' AND element='PRCP'
           AND date BETWEEN '2013-12-17' AND '2013-12-31' AND qflag IS NULL
        UNION ALL
        SELECT 2014, value FROM `bigquery-public-data.ghcnd_2014`
         WHERE id='USW00094846' AND element='PRCP'
           AND date BETWEEN '2014-12-17' AND '2014-12-31' AND qflag IS NULL
        UNION ALL
        SELECT 2015, value FROM `bigquery-public-data.ghcnd_2015`
         WHERE id='USW00094846' AND element='PRCP'
           AND date BETWEEN '2015-12-17' AND '2015-12-31' AND qflag IS NULL
        UNION ALL
        SELECT 2016, value FROM `bigquery-public-data.ghcnd_2016`
         WHERE id='USW00094846' AND element='PRCP'
           AND date BETWEEN '2016-12-17' AND '2016-12-31' AND qflag IS NULL )
      SELECT yr AS year, MAX(value)/10 AS max_prcp_mm FROM u GROUP BY yr
    )
  ),
  tx AS (                  -- peak TMAX (°C)
    SELECT *
    FROM (
      WITH u AS (
        SELECT 2013, value FROM `bigquery-public-data.ghcnd_2013`
         WHERE id='USW00094846' AND element='TMAX'
           AND date BETWEEN '2013-12-17' AND '2013-12-31' AND qflag IS NULL
        UNION ALL
        SELECT 2014, value FROM `bigquery-public-data.ghcnd_2014`
         WHERE id='USW00094846' AND element='TMAX'
           AND date BETWEEN '2014-12-17' AND '2014-12-31' AND qflag IS NULL
        UNION ALL
        SELECT 2015, value FROM `bigquery-public-data.ghcnd_2015`
         WHERE id='USW00094846' AND element='TMAX'
           AND date BETWEEN '2015-12-17' AND '2015-12-31' AND qflag IS NULL
        UNION ALL
        SELECT 2016, value FROM `bigquery-public-data.ghcnd_2016`
         WHERE id='USW00094846' AND element='TMAX'
           AND date BETWEEN '2016-12-17' AND '2016-12-31' AND qflag IS NULL )
      SELECT yr AS year, MAX(value)/10 AS max_tmax_c FROM u GROUP BY yr
    )
  ),
  tn AS (                  -- peak TMIN (°C)
    SELECT *
    FROM (
      WITH u AS (
        SELECT 2013, value FROM `bigquery-public-data.ghcnd_2013`
         WHERE id='USW00094846' AND element='TMIN'
           AND date BETWEEN '2013-12-17' AND '2013-12-31' AND qflag IS NULL
        UNION ALL
        SELECT 2014, value FROM `bigquery-public-data.ghcnd_2014`
         WHERE id='USW00094846' AND element='TMIN'
           AND date BETWEEN '2014-12-17' AND '2014-12-31' AND qflag IS NULL
        UNION ALL
        SELECT 2015, value FROM `bigquery-public-data.ghcnd_2015`
         WHERE id='USW00094846' AND element='TMIN'
           AND date BETWEEN '2015-12-17' AND '2015-12-31' AND qflag IS NULL
        UNION ALL
        SELECT 2016, value FROM `bigquery-public-data.ghcnd_2016`
         WHERE id='USW00094846' AND element='TMIN'
           AND date BETWEEN '2016-12-17' AND '2016-12-31' AND qflag IS NULL )
      SELECT yr AS year, MAX(value)/10 AS max_tmin_c FROM u GROUP BY yr
    )
  )
SELECT pr.year,
       pr.max_prcp_mm,
       tn.max_tmin_c,
       tx.max_tmax_c
FROM pr
JOIN tn USING (year)
JOIN tx USING (year)
ORDER BY year;
```

```sql
--Description: Final consolidated answer in one query (no dynamic SQL) that reports
--             the highest validated precipitation (mm), highest minimum temperature
--             (°C) and highest maximum temperature (°C) during 17-31 Dec of
--             2013-2016 at station USW00094846.  Approach: UNION the four yearly
--             tables, filter, find maxima per (year, element), then pivot.
WITH unioned AS (
  SELECT 2013 AS yr, element, value FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
   WHERE id='USW00094846' AND element IN ('PRCP','TMIN','TMAX')
     AND date BETWEEN '2013-12-17' AND '2013-12-31' AND qflag IS NULL
  UNION ALL
  SELECT 2014, element, value FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
   WHERE id='USW00094846' AND element IN ('PRCP','TMIN','TMAX')
     AND date BETWEEN '2014-12-17' AND '2014-12-31' AND qflag IS NULL
  UNION ALL
  SELECT 2015, element, value FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
   WHERE id='USW00094846' AND element IN ('PRCP','TMIN','TMAX')
     AND date BETWEEN '2015-12-17' AND '2015-12-31' AND qflag IS NULL
  UNION ALL
  SELECT 2016, element, value FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
   WHERE id='USW00094846' AND element IN ('PRCP','TMIN','TMAX')
     AND date BETWEEN '2016-12-17' AND '2016-12-31' AND qflag IS NULL
),
peaks AS (
  SELECT yr, element, MAX(value) AS max_val
  FROM unioned
  GROUP BY yr, element
)
SELECT
