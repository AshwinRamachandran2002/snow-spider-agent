```sql
-- Highest precipitation, lowest minimum temp and highest maximum temp
-- for the last 15 days of Dec (17-31) in 2013-2016 at station USW00094846,
-- using only validated rows (qflag IS NULL).  “value” is stored in tenths,
-- so divide by 10 to convert to mm or °C.

WITH filtered AS (
  SELECT
    CAST(_TABLE_SUFFIX AS INT64)         AS year,
    element,
    value / 10.0                         AS val
  FROM `bigquery-public-data.ghcn_d.ghcnd_20*`
  WHERE _TABLE_SUFFIX IN ('2013','2014','2015','2016')   -- target years
    AND id    = 'USW00094846'                            -- target station
    AND qflag IS NULL                                    -- validated data
    AND EXTRACT(MONTH FROM date) = 12                    -- December
    AND EXTRACT(DAY   FROM date) BETWEEN 17 AND 31       -- last 15 days
    AND element IN ('PRCP','TMAX','TMIN')                -- needed elements
)

SELECT
  year,
  MAX(CASE WHEN element = 'PRCP' THEN val END) AS highest_precip_mm,
  MIN(CASE WHEN element = 'TMIN' THEN val END) AS lowest_tmin_c,
  MAX(CASE WHEN element = 'TMAX' THEN val END) AS highest_tmax_c
FROM filtered
GROUP BY year
ORDER BY year;
