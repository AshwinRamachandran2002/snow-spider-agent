```sql
--Description: 
-- THINKING PROCESS ─────────────────────────────────────────────────────────
--  1. We need three statistics for station USW00094846, separately for each
--     year 2013-2016, limited to the final 15 days of December (Dec 17-31):
--        • highest 24-hour precipitation  (PRCP)  → mm
--        • lowest  daily minimum temp     (TMIN)  → °C
--        • highest daily maximum temp     (TMAX)  → °C
--  2. Each year’s data live in an annual table (ghcnd_2013 … ghcnd_2016).
--  3. Column “value” is stored in tenths of unit → divide by 10.
--  4. Use only validated observations → qflag IS NULL.
--  5. Gather the four years with UNION ALL in a CTE, then pivot/aggregate by
--     year using conditional MAX / MIN.
--  6. Return one row per year with the three requested numbers.
-- SQL IMPLEMENTATION ───────────────────────────────────────────────────────

WITH all_obs AS (
  -- 2013 -------------------------------------------------------------------
  SELECT 2013 AS yr, element, value/10.0 AS val
  FROM   `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE  id = 'USW00094846'
    AND  qflag IS NULL
    AND  element IN ('PRCP','TMAX','TMIN')
    AND  EXTRACT(MONTH FROM date) = 12
    AND  EXTRACT(DAY   FROM date) BETWEEN 17 AND 31

  UNION ALL
  -- 2014 -------------------------------------------------------------------
  SELECT 2014, element, value/10.0
  FROM   `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE  id = 'USW00094846'
    AND  qflag IS NULL
    AND  element IN ('PRCP','TMAX','TMIN')
    AND  EXTRACT(MONTH FROM date) = 12
    AND  EXTRACT(DAY   FROM date) BETWEEN 17 AND 31

  UNION ALL
  -- 2015 -------------------------------------------------------------------
  SELECT 2015, element, value/10.0
  FROM   `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE  id = 'USW00094846'
    AND  qflag IS NULL
    AND  element IN ('PRCP','TMAX','TMIN')
    AND  EXTRACT(MONTH FROM date) = 12
    AND  EXTRACT(DAY   FROM date) BETWEEN 17 AND 31

  UNION ALL
  -- 2016 -------------------------------------------------------------------
  SELECT 2016, element, value/10.0
  FROM   `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE  id = 'USW00094846'
    AND  qflag IS NULL
    AND  element IN ('PRCP','TMAX','TMIN')
    AND  EXTRACT(MONTH FROM date) = 12
    AND  EXTRACT(DAY   FROM date) BETWEEN 17 AND 31
)

SELECT
  yr AS year,
  MAX(CASE WHEN element = 'PRCP' THEN val END) AS highest_precip_mm,
  MIN(CASE WHEN element = 'TMIN' THEN val END) AS lowest_tmin_c,
  MAX(CASE WHEN element = 'TMAX' THEN val END) AS highest_tmax_c
FROM   all_obs
GROUP  BY yr
ORDER  BY yr;
```
