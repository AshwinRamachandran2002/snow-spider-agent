```sql
--Description: FINAL ANSWER – highest precipitation, lowest TMIN, and highest TMAX  
--             for the last 15 days of each year 2013-2016 at station USW00094846
WITH all_data AS (
  SELECT 2013 AS yr, * FROM `bigquery-public-data.ghcn_d.ghcnd_2013` UNION ALL
  SELECT 2014 AS yr, * FROM `bigquery-public-data.ghcn_d.ghcnd_2014` UNION ALL
  SELECT 2015 AS yr, * FROM `bigquery-public-data.ghcn_d.ghcnd_2015` UNION ALL
  SELECT 2016 AS yr, * FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
),
filtered AS (
  SELECT yr,
         element,
         value/10.0 AS val
  FROM   all_data
  WHERE  id = 'USW00094846'
    AND  qflag IS NULL                     -- validated observations only
    AND  EXTRACT(MONTH FROM date) = 12
    AND  EXTRACT(DAY   FROM date) BETWEEN 17 AND 31
    AND  element IN ('PRCP','TMAX','TMIN')
)
SELECT yr AS year,
       MAX(CASE WHEN element='PRCP' THEN val END) AS highest_precip_mm,
       MIN(CASE WHEN element='TMIN' THEN val END) AS lowest_tmin_c,
       MAX(CASE WHEN element='TMAX' THEN val END) AS highest_tmax_c
FROM   filtered
GROUP  BY yr
ORDER  BY yr;
```
