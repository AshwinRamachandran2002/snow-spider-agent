       MAX(value)/10.0 AS max_prcp_mm
FROM   yr
JOIN   UNNEST([STRUCT(2013, 'bigquery-public-data.ghcn_d.ghcnd_2013'),
               STRUCT(2014, 'bigquery-public-data.ghcn_d.ghcnd_2014'),
               STRUCT(2015, 'bigquery-public-data.ghcn_d.ghcnd_2015'),
               STRUCT(2016, 'bigquery-public-data.ghcn_d.ghcnd_2016')]) AS m(y, tbl)
ON     yr.y = m.y
