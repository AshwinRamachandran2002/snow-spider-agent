  FROM   `bigquery-public-data.ghcn_d.ghcnd_2016`
),
filtered AS (
  SELECT
    yr,
    element,
    value / 10.0 AS val
  FROM   all_data
  WHERE  id = 'USW00094846'
    AND  qflag IS NULL                       -- validated only
    AND  EXTRACT(MONTH FROM date) = 12
    AND  EXTRACT(DAY   FROM date) BETWEEN 17 AND 31
    AND  element IN ('PRCP','TMAX','TMIN')
)
SELECT
