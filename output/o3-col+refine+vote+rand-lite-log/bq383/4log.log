Query:
--Description: 
-- Corrected “FINAL ANSWER” query: returns, for station USW00094846,
-- the highest daily precipitation (mm), lowest daily minimum temp (°C),
-- and highest daily maximum temp (°C) observed in the last 15 days of
-- December (17 – 31) for each year 2013-2016, using only rows whose
-- quality-flag (qflag) is NULL (validated data).  The numeric “value”
-- field is stored in tenths of the unit, so divide by 10.
WITH all_data AS (
  SELECT 2013 AS yr, id, date, element, value, qflag
  FROM   `bigquery-public-data.ghcn_d.ghcnd_2013`
  UNION ALL
  SELECT 2014, id, date, element, value, qflag
  FROM   `bigquery-public-data.ghcn_d.ghcnd_2014`
  UNION ALL
  SELECT 2015, id, date, element, value, qflag
  FROM   `bigquery-public-data.ghcn_d.ghcnd_2015`
  UNION ALL
  SELECT 2016, id, date, element, value, qflag
  FROM   `bigquery-public-data.ghcn_d.ghcnd_2016`
),
filtered AS (
  SELECT
    yr,
    element,
    value / 10.0 AS val
  FROM   all_data
  WHERE  id = 'USW00094846'
    AND  qflag IS NULL                       -- validated only
    AND  EXTRACT(MONTH FROM date) = 12
    AND  EXTRACT(DAY   FROM date) BETWEEN 17 AND 31
    AND  element IN ('PRCP','TMAX','TMIN')
)
SELECT
  yr AS year,
  MAX(CASE WHEN element = 'PRCP' THEN val END) AS highest_precip_mm,
  MIN(CASE WHEN element = 'TMIN' THEN val END) AS lowest_tmin_c,
  MAX(CASE WHEN element = 'TMAX' THEN val END) AS highest_tmax_c
FROM filtered
GROUP BY yr
ORDER BY yr
Answer:
year,highest_precip_mm,lowest_tmin_c,highest_tmax_c
2013,7.9,-18.8,10.0
2014,8.1,-15.5,10.0
2015,37.3,-9.3,15.0
2016,5.8,-24.9,12.2
