--Description:  Lowest validated daily minimum-temperature (°C) recorded at
--weather station USW00094846 during the final 15 days (17–31 Dec) of each year
--2013-2016.  One table per year is UNIONed, the raw tenths-°C value is divided
--by 10, then the coldest (MIN) value is returned per year.
WITH tmin_last15 AS (
  SELECT 2013 AS yr, value/10.0 AS tmin_c
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id='USW00094846' AND element='TMIN' AND qflag IS NULL
    AND date BETWEEN DATE '2013-12-17' AND DATE '2013-12-31'
  UNION ALL
  SELECT 2014, value/10.0
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id='USW00094846' AND element='TMIN' AND qflag IS NULL
    AND date BETWEEN DATE '2014-12-17' AND DATE '2014-12-31'
  UNION ALL
  SELECT 2015, value/10.0
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id='USW00094846' AND element='TMIN' AND qflag IS NULL
    AND date BETWEEN DATE '2015-12-17' AND DATE '2015-12-31'
  UNION ALL
  SELECT 2016, value/10.0
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id='USW00094846' AND element='TMIN' AND qflag IS NULL
    AND date BETWEEN DATE '2016-12-17' AND DATE '2016-12-31'
)
