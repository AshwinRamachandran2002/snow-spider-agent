```sql
-- 7. Highest daily precipitation (mm) for each required year  
SELECT EXTRACT(YEAR FROM date) AS yr,
       MAX(value)/10.0 AS max_prcp_mm
FROM (
  SELECT date, value FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  UNION ALL
  SELECT date, value FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  UNION ALL
  SELECT date, value FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  UNION ALL
  SELECT date, value FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
)
WHERE id = 'USW00094846'
  AND element = 'PRCP'
  AND date BETWEEN DATE_SUB(DATE_TRUNC(date, YEAR), INTERVAL 15 - 1 DAY)  -- last 15 days
              AND DATE_TRUNC(date, YEAR) + 364   -- 31-Dec
  AND qflag IS NULL
GROUP BY yr
ORDER BY yr;
```

```sql
-- 8. Lowest daily minimum-temperature (°C) for each required year  
SELECT EXTRACT(YEAR FROM date) AS yr,
       MIN(value)/10.0 AS min_tmin_c
FROM (
  SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  UNION ALL
  SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  UNION ALL
  SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  UNION ALL
  SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
)
WHERE id = 'USW00094846'
  AND element = 'TMIN'
  AND date BETWEEN DATE(EXTRACT(YEAR FROM date) || '-12-17')
              AND DATE(EXTRACT(YEAR FROM date) || '-12-31')
  AND qflag IS NULL
GROUP BY yr
ORDER BY yr;
```

```sql
-- 9. Highest daily maximum-temperature (°C) for each required year  
