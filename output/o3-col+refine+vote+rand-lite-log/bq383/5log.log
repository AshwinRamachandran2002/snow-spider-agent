  CAST(_TABLE_SUFFIX AS INT64)                      AS year,
  ROUND(MAX(IF(element = 'PRCP', value/10.0, NULL)), 4) AS highest_prcp_mm,
  ROUND(MIN(IF(element = 'TMIN', value/10.0, NULL)), 4) AS lowest_tmin_c,
