Query:
--Description:  Lowest validated daily minimum-temperature (°C) recorded at
--weather station USW00094846 during the final 15 days (17–31 Dec) of each year
--2013-2016.  One table per year is UNIONed, the raw tenths-°C value is divided
--by 10, then the coldest (MIN) value is returned per year.
WITH tmin_last15 AS (
  SELECT 2013 AS yr, value/10.0 AS tmin_c
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id='USW00094846' AND element='TMIN' AND qflag IS NULL
    AND date BETWEEN DATE '2013-12-17' AND DATE '2013-12-31'
  UNION ALL
  SELECT 2014, value/10.0
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id='USW00094846' AND element='TMIN' AND qflag IS NULL
    AND date BETWEEN DATE '2014-12-17' AND DATE '2014-12-31'
  UNION ALL
  SELECT 2015, value/10.0
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id='USW00094846' AND element='TMIN' AND qflag IS NULL
    AND date BETWEEN DATE '2015-12-17' AND DATE '2015-12-31'
  UNION ALL
  SELECT 2016, value/10.0
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id='USW00094846' AND element='TMIN' AND qflag IS NULL
    AND date BETWEEN DATE '2016-12-17' AND DATE '2016-12-31'
)
SELECT yr,
       MIN(tmin_c) AS lowest_tmin_c
FROM tmin_last15
GROUP BY yr
ORDER BY yr
Answer:
yr,lowest_tmin_c
2013,-18.8
2014,-15.5
2015,-9.3
2016,-24.9
Query:
--Description:  Highest validated daily maximum-temperature (°C) recorded at
--weather station USW00094846 during the final 15 days (17–31 Dec) of each year
--2013-2016.  One table per year is UNIONed, the raw tenths-°C value is divided
--by 10, then the warmest (MAX) value is returned per year.
WITH tmax_last15 AS (
  SELECT 2013 AS yr, value/10.0 AS tmax_c
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id='USW00094846' AND element='TMAX' AND qflag IS NULL
    AND date BETWEEN DATE '2013-12-17' AND DATE '2013-12-31'
  UNION ALL
  SELECT 2014, value/10.0
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id='USW00094846' AND element='TMAX' AND qflag IS NULL
    AND date BETWEEN DATE '2014-12-17' AND DATE '2014-12-31'
  UNION ALL
  SELECT 2015, value/10.0
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id='USW00094846' AND element='TMAX' AND qflag IS NULL
    AND date BETWEEN DATE '2015-12-17' AND DATE '2015-12-31'
  UNION ALL
  SELECT 2016, value/10.0
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id='USW00094846' AND element='TMAX' AND qflag IS NULL
    AND date BETWEEN DATE '2016-12-17' AND DATE '2016-12-31'
)
SELECT yr,
       MAX(tmax_c) AS highest_tmax_c
FROM tmax_last15
GROUP BY yr
ORDER BY yr
Answer:
yr,highest_tmax_c
2013,10.0
2014,10.0
2015,15.0
2016,12.2
Query:
--Description:  Combined final answer for station USW00094846—peak precipitation
--(mm), coldest TMIN (°C), and warmest TMAX (°C) during 17-31 Dec of 2013-2016—
--using only validated observations (qflag IS NULL) and converting tenths-units
--to true units.
WITH last15 AS (
  -- 2013
  SELECT 2013 AS yr, element, value/10.0 AS val
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id='USW00094846' AND element IN ('PRCP','TMIN','TMAX')
    AND qflag IS NULL
    AND date BETWEEN DATE '2013-12-17' AND DATE '2013-12-31'
  UNION ALL
  -- 2014
  SELECT 2014, element, value/10.0
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id='USW00094846' AND element IN ('PRCP','TMIN','TMAX')
    AND qflag IS NULL
    AND date BETWEEN DATE '2014-12-17' AND DATE '2014-12-31'
  UNION ALL
  -- 2015
  SELECT 2015, element, value/10.0
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id='USW00094846' AND element IN ('PRCP','TMIN','TMAX')
    AND qflag IS NULL
    AND date BETWEEN DATE '2015-12-17' AND DATE '2015-12-31'
  UNION ALL
  -- 2016
  SELECT 2016, element, value/10.0
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id='USW00094846' AND element IN ('PRCP','TMIN','TMAX')
    AND qflag IS NULL
    AND date BETWEEN DATE '2016-12-17' AND DATE '2016-12-31'
)
SELECT
  yr,
  MAX(IF(element='PRCP', val, NULL)) AS highest_prcp_mm,
  MIN(IF(element='TMIN', val, NULL)) AS lowest_tmin_c,
  MAX(IF(element='TMAX', val, NULL)) AS highest_tmax_c
FROM last15
GROUP BY yr
ORDER BY yr
Answer:
yr,highest_prcp_mm,lowest_tmin_c,highest_tmax_c
2013,7.9,-18.8,10.0
2014,8.1,-15.5,10.0
2015,37.3,-9.3,15.0
2016,5.8,-24.9,12.2
