Query:
--Description: Sample of maximum-temperature (TMAX) records for the same period
--             in 2015, converted to °C (raw value is in tenths of °C).
SELECT date,
       value AS raw_value,
       value / 10.0 AS tmax_c
FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
WHERE id = 'USW00094846'
  AND element = 'TMAX'
  AND DATE(date) BETWEEN '2015-12-17' AND '2015-12-31'
  AND qflag IS NULL
LIMIT 20;
