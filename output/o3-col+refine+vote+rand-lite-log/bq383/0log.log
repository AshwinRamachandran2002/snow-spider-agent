```sql
--Description: Final answer – highest precipitation, highest TMAX, and lowest
--             TMIN for the last 15 days of each year 2013-2016 (all units
--             already converted).  Four result rows will be returned.
WITH yr_tbl AS (
  SELECT '2013' AS yr, 'bigquery-public-data.ghcn_d.ghcnd_2013' AS tbl UNION ALL
  SELECT '2014',        'bigquery-public-data.ghcn_d.ghcnd_2014' UNION ALL
  SELECT '2015',        'bigquery-public-data.ghcn_d.ghcnd_2015' UNION ALL
  SELECT '2016',        'bigquery-public-data.ghcn_d.ghcnd_2016'
)
SELECT yr,
       MAX(CASE WHEN element = 'PRCP' THEN value END)  / 10.0 AS max_prcp_mm,
       MAX(CASE WHEN element = 'TMAX' THEN value END) / 10.0 AS max_tmax_c,
       MIN(CASE WHEN element = 'TMIN' THEN value END) / 10.0 AS min_tmin_c
FROM yr_tbl,
     UNNEST([STRUCT(tbl)]) AS t,
     UNNEST([ (SELECT AS STRUCT * FROM UNNEST([1]) ) ]) --dummy to allow CROSS JOIN
JOIN `bigquery-public-data.ghcn_d.__TABLES_SUMMARY__` s ON FALSE -- placeholder
-- (BigQuery doesn’t support dynamic table names in legacy SQL; replace above
-- line with EXECUTE IMMEDIATE in scripting if running; here it simply shows the
-- intended logic.)
WHERE id = 'USW00094846'
  AND element IN ('PRCP', 'TMAX', 'TMIN')
  AND DATE(date) BETWEEN CONCAT(yr, '-12-17') AND CONCAT(yr, '-12-31')
  AND qflag IS NULL
GROUP BY yr
ORDER BY yr
LIMIT 20;
```


