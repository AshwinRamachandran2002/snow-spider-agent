Query:
--Description: Peek at validated (quality–flag-free) records for the station
--             USW00094846 during the last 15 days of 2013 to understand the rows.
SELECT *
FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
WHERE id = 'USW00094846'
  AND DATE(date) BETWEEN '2013-12-17' AND '2013-12-31'
  AND qflag IS NULL
LIMIT 20;
