SELECT '2013'  AS yr,
       MAX(value) / 10.0 AS max_prcp_mm
FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
WHERE id = 'USW00094846'
  AND element = 'PRCP'
  AND DATE(date) BETWEEN '2013-12-17' AND '2013-12-31'
  AND qflag IS NULL
LIMIT 20;
