--Description: Show the distinct measurement “elements” reported by the station
--             in 2014 so we know which codes to use (PRCP, TMAX, TMIN, …).
SELECT DISTINCT element
FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
WHERE id = 'USW00094846'
  AND qflag IS NULL
LIMIT 20;
