```sql
--Description:  We need one result row for each year 2013-2016 that contains
--              (a) the greatest daily precipitation, (b) the greatest maximum
--              temperature, and (c) the lowest minimum temperature observed at
--              station USW00094846 during the final 15-day window of the year
--              (-- 17 Dec through 31 Dec).  GHCN stores each calendar year in
--              its own table; therefore, we UNION the four year-specific tables
--              into a single CTE (all_data), tag each row with its year, filter
--              on station id, required elements, valid data (qflag IS NULL),
--              and the target dates.  Raw “value” fields are in tenths of the
--              desired unit, so we divide by 10 when aggregating.  Finally, we
--              aggregate by year, taking MAX for PRCP and TMAX, MIN for TMIN.
WITH all_data AS (
  -------------------------------------------------------------------- 2013
  SELECT '2013' AS yr, element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMAX','TMIN')
    AND qflag IS NULL
    AND DATE(date) BETWEEN '2013-12-17' AND '2013-12-31'
  UNION ALL
  -------------------------------------------------------------------- 2014
  SELECT '2014', element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMAX','TMIN')
    AND qflag IS NULL
    AND DATE(date) BETWEEN '2014-12-17' AND '2014-12-31'
  UNION ALL
  -------------------------------------------------------------------- 2015
  SELECT '2015', element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMAX','TMIN')
    AND qflag IS NULL
    AND DATE(date) BETWEEN '2015-12-17' AND '2015-12-31'
  UNION ALL
  -------------------------------------------------------------------- 2016
  SELECT '2016', element, value
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMAX','TMIN')
    AND qflag IS NULL
    AND DATE(date) BETWEEN '2016-12-17' AND '2016-12-31'
)
SELECT
  yr,
  MAX(CASE WHEN element = 'PRCP' THEN value END) / 10.0 AS max_prcp_mm,
  MAX(CASE WHEN element = 'TMAX' THEN value END) / 10.0 AS max_tmax_c,
  MIN(CASE WHEN element = 'TMIN' THEN value END) / 10.0 AS min_tmin_c
FROM all_data
GROUP BY yr
ORDER BY yr;
```
