Query:
--Description: Quick look at validated precipitation observations for the last
--             15 days of 2014 (raw ‘value’ is in tenths of millimetres).
SELECT date,
       value AS raw_value,
       value / 10.0 AS prcp_mm
FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
WHERE id = 'USW00094846'
  AND element = 'PRCP'
  AND DATE(date) BETWEEN '2014-12-17' AND '2014-12-31'
  AND qflag IS NULL
LIMIT 20;
