Query:
--Description: 6) Coldest (minimum) TMIN during the final 15 days of each
--              year 2013-2016 for station USW00094846.  A literal year
--              constant is supplied for every UNION ALL branch so no
--              non-aggregated column appears beside the aggregate MIN().
--              Units are converted from tenths of °C to °C.
SELECT *
FROM (
  SELECT 2013 AS year, MIN(value) / 10 AS coldest_tmin_c
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id = 'USW00094846'
    AND element = 'TMIN'
    AND date BETWEEN DATE '2013-12-17' AND DATE '2013-12-31'
    AND qflag IS NULL AND mflag IS NULL

  UNION ALL
  SELECT 2014, MIN(value) / 10
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id = 'USW00094846'
    AND element = 'TMIN'
    AND date BETWEEN DATE '2014-12-17' AND DATE '2014-12-31'
    AND qflag IS NULL AND mflag IS NULL

  UNION ALL
  SELECT 2015, MIN(value) / 10
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id = 'USW00094846'
    AND element = 'TMIN'
    AND date BETWEEN DATE '2015-12-17' AND DATE '2015-12-31'
    AND qflag IS NULL AND mflag IS NULL

  UNION ALL
  SELECT 2016, MIN(value) / 10
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id = 'USW00094846'
    AND element = 'TMIN'
    AND date BETWEEN DATE '2016-12-17' AND DATE '2016-12-31'
    AND qflag IS NULL AND mflag IS NULL
)
ORDER BY year
LIMIT 20
Answer:
year,coldest_tmin_c
2013,-18.8
2014,-15.5
2015,-9.3
2016,-24.9
Query:
--Description: 7) Hottest (maximum) TMAX during the final 15 days of each
--              year 2013-2016 for station USW00094846.  Same UNION-style
--              approach as query 6, but with MAX() and element = 'TMAX'.
SELECT *
FROM (
  SELECT 2013 AS year, MAX(value) / 10 AS hottest_tmax_c
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id = 'USW00094846'
    AND element = 'TMAX'
    AND date BETWEEN DATE '2013-12-17' AND DATE '2013-12-31'
    AND qflag IS NULL AND mflag IS NULL

  UNION ALL
  SELECT 2014, MAX(value) / 10
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id = 'USW00094846'
    AND element = 'TMAX'
    AND date BETWEEN DATE '2014-12-17' AND DATE '2014-12-31'
    AND qflag IS NULL AND mflag IS NULL

  UNION ALL
  SELECT 2015, MAX(value) / 10
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id = 'USW00094846'
    AND element = 'TMAX'
    AND date BETWEEN DATE '2015-12-17' AND DATE '2015-12-31'
    AND qflag IS NULL AND mflag IS NULL

  UNION ALL
  SELECT 2016, MAX(value) / 10
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id = 'USW00094846'
    AND element = 'TMAX'
    AND date BETWEEN DATE '2016-12-17' AND DATE '2016-12-31'
    AND qflag IS NULL AND mflag IS NULL
)
ORDER BY year
LIMIT 20
