```sql
--Description: 8) Combine all three metrics for one year (2015) – template check
SELECT
  '2015'                      AS year,
  MAX(CASE WHEN element='PRCP' THEN value END)/10 AS max_prcp_mm,
  MIN(CASE WHEN element='TMIN' THEN value END)/10 AS coldest_tmin_c,
  MAX(CASE WHEN element='TMAX' THEN value END)/10 AS hottest_tmax_c
FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
WHERE id='USW00094846'
  AND element IN ('PRCP','TMIN','TMAX')
  AND date BETWEEN DATE '2015-12-17' AND DATE '2015-12-31'
  AND qflag IS NULL
  AND mflag IS NULL
LIMIT 20;
```

```sql
--Description: 9) FINAL ANSWER – all requested years in one record set
SELECT
  yr AS year,
  MAX(IF(element='PRCP', val, NULL))  AS highest_precip_mm,
  MIN(IF(element='TMIN', val, NULL))  AS coldest_tmin_c,
  MAX(IF(element='TMAX', val, NULL))  AS hottest_tmax_c
FROM (
  -- bring four yearly tables together
  SELECT 2013 AS yr, element, value/10 AS val, date
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id='USW00094846'
        AND element IN ('PRCP','TMIN','TMAX')
        AND date BETWEEN DATE '2013-12-17' AND DATE '2013-12-31'
        AND qflag IS NULL AND mflag IS NULL
  UNION ALL
  SELECT 2014, element, value/10, date
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id='USW00094846'
        AND element IN ('PRCP','TMIN','TMAX')
        AND date BETWEEN DATE '2014-12-17' AND DATE '2014-12-31'
        AND qflag IS NULL AND mflag IS NULL
  UNION ALL
  SELECT 2015, element, value/10, date
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id='USW00094846'
        AND element IN ('PRCP','TMIN','TMAX')
        AND date BETWEEN DATE '2015-12-17' AND DATE '2015-12-31'
        AND qflag IS NULL AND mflag IS NULL
  UNION ALL
  SELECT 2016, element, value/10, date
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id='USW00094846'
        AND element IN ('PRCP','TMIN','TMAX')
        AND date BETWEEN DATE '2016-12-17' AND DATE '2016-12-31'
        AND qflag IS NULL AND mflag IS NULL
)
GROUP BY yr
ORDER BY yr;
```

The last query (Query 9) returns exactly what you asked for:

• highest_precip_mm – greatest single-day precipitation (mm)  
• coldest_tmin_c   – lowest daily minimum temperature (°C)  
• hottest_tmax_c   – highest daily maximum temperature (°C)  

All figures come only from validated rows (non-null value, no quality or measurement flags) and cover the final 15 calendar days of each year 2013-2016 for station USW00094846.
