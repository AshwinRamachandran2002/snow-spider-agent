--Description / thinking process:
-- Goal: For station USW00094846, find within the last 15 days of each year
--       (2013-2016) the
--          • highest single-day precipitation (mm),
--          • lowest single-day minimum temperature (°C), and
--          • highest single-day maximum temperature (°C),
--       using only validated rows (qflag IS NULL AND mflag IS NULL).
--
-- Steps embedded in the query:
--   1. For each year we scan the corresponding ghcnd_<year> table
--      (all those tables share an identical schema).
--   2. Restrict rows to the final 15 calendar days of that year.
--   3. Keep only three “element” codes of interest (PRCP, TMIN, TMAX).
--   4. Divide “value” by 10 (stored units are tenths of mm or °C).
--   5. UNION ALL the four yearly blocks so we have a single stream of
--      candidate rows with columns (year, element, val).
--   6. GROUP BY year, then apply conditional MAX / MIN aggregations to
--      pick the required extremes.
--   7. ORDER BY year for readability.
SELECT
  yr AS year,
  MAX(IF(element = 'PRCP', val, NULL)) AS highest_precip_mm,
  MIN(IF(element = 'TMIN', val, NULL)) AS coldest_tmin_c,
  MAX(IF(element = 'TMAX', val, NULL)) AS hottest_tmax_c
FROM (
  -- 2013 rows ---------------------------------------------------------------
  SELECT 2013 AS yr,
         element,
         value / 10 AS val
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN DATE '2013-12-17' AND DATE '2013-12-31'
    AND qflag IS NULL
    AND mflag IS NULL

  UNION ALL
  -- 2014 rows ---------------------------------------------------------------
  SELECT 2014,
         element,
         value / 10
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN DATE '2014-12-17' AND DATE '2014-12-31'
    AND qflag IS NULL
    AND mflag IS NULL

  UNION ALL
  -- 2015 rows ---------------------------------------------------------------
  SELECT 2015,
         element,
         value / 10
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN DATE '2015-12-17' AND DATE '2015-12-31'
    AND qflag IS NULL
    AND mflag IS NULL

  UNION ALL
  -- 2016 rows ---------------------------------------------------------------
  SELECT 2016,
         element,
         value / 10
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN DATE '2016-12-17' AND DATE '2016-12-31'
    AND qflag IS NULL
    AND mflag IS NULL
)
GROUP BY yr
ORDER BY yr;
