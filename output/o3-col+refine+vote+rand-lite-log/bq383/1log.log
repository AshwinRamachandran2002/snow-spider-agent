Query:
--Description: 8) Template check for a single year (2015) combining all three
--              metrics in one query.  No corrections needed except switching
--              the year literal from string to integer for consistency.
SELECT
  2015                                     AS year,
  MAX(CASE WHEN element = 'PRCP' THEN value END) / 10 AS max_prcp_mm,
  MIN(CASE WHEN element = 'TMIN' THEN value END) / 10 AS coldest_tmin_c,
  MAX(CASE WHEN element = 'TMAX' THEN value END) / 10 AS hottest_tmax_c
FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
WHERE id = 'USW00094846'
  AND element IN ('PRCP','TMIN','TMAX')
  AND date BETWEEN DATE '2015-12-17' AND DATE '2015-12-31'
  AND qflag IS NULL
  AND mflag IS NULL
LIMIT 20
Answer:
year,max_prcp_mm,coldest_tmin_c,hottest_tmax_c
2015,37.3,-9.3,15.0
Query:
--Description: 9) FINAL ANSWER query already conforms to BigQuery grouping
--              rules.  Only cosmetic tweak: drop the unused ‘date’ column
--              from the subquery to make the pipeline leaner.
SELECT
  yr AS year,
  MAX(IF(element = 'PRCP', val, NULL)) AS highest_precip_mm,
  MIN(IF(element = 'TMIN', val, NULL)) AS coldest_tmin_c,
  MAX(IF(element = 'TMAX', val, NULL)) AS hottest_tmax_c
FROM (
  SELECT 2013 AS yr, element, value / 10 AS val
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN DATE '2013-12-17' AND DATE '2013-12-31'
    AND qflag IS NULL AND mflag IS NULL
  UNION ALL
  SELECT 2014, element, value / 10
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN DATE '2014-12-17' AND DATE '2014-12-31'
    AND qflag IS NULL AND mflag IS NULL
  UNION ALL
  SELECT 2015, element, value / 10
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN DATE '2015-12-17' AND DATE '2015-12-31'
    AND qflag IS NULL AND mflag IS NULL
  UNION ALL
  SELECT 2016, element, value / 10
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND date BETWEEN DATE '2016-12-17' AND DATE '2016-12-31'
    AND qflag IS NULL AND mflag IS NULL
)
GROUP BY yr
ORDER BY yr
Answer:
year,highest_precip_mm,coldest_tmin_c,hottest_tmax_c
2013,7.9,-18.8,10.0
2014,8.1,-15.5,10.0
2015,37.3,-9.3,15.0
2016,5.8,-24.9,12.2
