    (SELECT v.value.string_value FROM UNNEST(event_params) AS v WHERE v.key = 'source')       AS source,
    (SELECT v.value.string_value FROM UNNEST(event_params) AS v WHERE v.key = 'medium')       AS medium
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
)
LIMIT 20;
```

```sql
-- 8. Add channel grouping logic (sample of sessions + channel)
SELECT
  user_pseudo_id,
  ga_session_id,
  source,
  medium,
  CASE
      WHEN LOWER(source) = '(direct)'
           AND (medium IS NULL OR LOWER(medium) IN ('(none)','(not set)'))          THEN 'Direct'
      WHEN LOWER(medium) = 'referral'                                              THEN 'Referral'
      WHEN LOWER(medium) = 'organic'                                               THEN 'Organic Search'
      WHEN LOWER(medium) IN ('email','e-mail','e_mail','e mail')
           OR LOWER(source) IN ('email','e-mail','e_mail','e mail')                THEN 'Email'
      WHEN LOWER(medium) = 'affiliate'                                             THEN 'Affiliates'
      WHEN REGEXP_CONTAINS(LOWER(medium), r'(.*cp.*|ppc|paid.*)')
           AND LOWER(source) IN ('google','bing','baidu','yahoo',
                                 'duckduckgo','ecosia','yandex')                   THEN 'Paid Search'
      ELSE 'Unassigned'
  END AS channel
FROM (
  SELECT DISTINCT
    user_pseudo_id,
    (SELECT v.value.int_value   FROM UNNEST(event_params) AS v WHERE v.key = 'ga_session_id') AS ga_session_id,
    (SELECT v.value.string_value FROM UNNEST(event_params) AS v WHERE v.key = 'source')       AS source,
    (SELECT v.value.string_value FROM UNNEST(event_params) AS v WHERE v.key = 'medium')       AS medium
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
)
LIMIT 20;
```

```sql
-- 9. FINAL – total number of sessions per traffic channel, December 2020
SELECT
  channel,
  COUNT(*) AS total_sessions
FROM (
  SELECT DISTINCT
    CONCAT(user_pseudo_id,'_',CAST(ga_session_id AS STRING))               AS session_key,
    CASE
        WHEN LOWER(source) = '(direct)'
             AND (medium IS NULL OR LOWER(medium) IN ('(none)','(not set)'))          THEN 'Direct'
        WHEN LOWER(medium) = 'referral'                                              THEN 'Referral'
        WHEN LOWER(medium) = 'organic'                                               THEN 'Organic Search'
        WHEN LOWER(medium) IN ('email','e-mail','e_mail','e mail')
             OR LOWER(source) IN ('email','e-mail','e_mail','e mail')                THEN 'Email'
        WHEN LOWER(medium) = 'affiliate'                                             THEN 'Affiliates'
        WHEN REGEXP_CONTAINS(LOWER(medium), r'(.*cp.*|ppc|paid.*)')
             AND LOWER(source) IN ('google','bing','baidu','yahoo',
                                   'duckduckgo','ecosia','yandex')                   THEN 'Paid Search'
        ELSE 'Unassigned'
    END AS channel
  FROM (
    SELECT
      user_pseudo_id,
      (SELECT v.value.int_value   FROM UNNEST(event_params) AS v WHERE v.key = 'ga_session_id') AS ga_session_id,
      (SELECT v.value.string_value FROM UNNEST(event_params) AS v WHERE v.key = 'source')       AS source,
      (SELECT v.value.string_value FROM UNNEST(event_params) AS v WHERE v.key = 'medium')       AS medium
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  )
)
GROUP BY channel
ORDER BY total_sessions DESC
LIMIT 20;
```

```sql
-- 10. (Optional) Verify the total number of sessions in December 2020
SELECT COUNT(DISTINCT CONCAT(user_pseudo_id,'_',
       CAST((SELECT v.value.int_value FROM UNNEST(event_params) AS v
             WHERE v.key='ga_session_id') AS STRING))) AS all_dec_sessions
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
LIMIT 20;
```
