```sql
--Description: 5) Build one-day session table (01-Dec) with a simple Channel Group label (first 20 rows).
WITH day_sessions AS (
  SELECT
    CONCAT(e.user_pseudo_id, '-', 
           CAST(MAX(CASE WHEN ep.key='ga_session_id' THEN ep.value.int_value END) AS STRING)
          ) AS session_id,
    MAX(CASE WHEN ep.key='source' THEN ep.value.string_value END) AS source,
    MAX(CASE WHEN ep.key='medium' THEN ep.value.string_value END) AS medium
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201` AS e
  CROSS JOIN UNNEST(e.event_params) AS ep
  WHERE e.event_name = 'session_start'
  GROUP BY e.user_pseudo_id, e.event_date
)
SELECT
  session_id,
  source,
  medium,
  CASE
    WHEN LOWER(source) = '(direct)' 
         AND (medium IS NULL OR medium IN ('(not set)', '(none)'))          THEN 'Direct'
    WHEN LOWER(medium) = 'referral'                                         THEN 'Referral'
    WHEN LOWER(medium) = 'organic'                                          THEN 'Organic Search'
    ELSE 'Unassigned'
  END AS channel_group
FROM day_sessions
LIMIT 20;
```

