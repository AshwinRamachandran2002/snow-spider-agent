Query:
--Description: 7) Create a CASE statement that maps every row to a Channel Grouping (sample of results)
WITH base AS (
  SELECT
    CONCAT(user_pseudo_id, '-', CAST((SELECT ep.value.int_value FROM UNNEST(event_params) ep WHERE ep.key = 'ga_session_id') AS STRING)) AS session_key,
    LOWER((SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'source'))  AS source,
    LOWER((SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'medium'))  AS medium
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE _TABLE_SUFFIX BETWEEN '01' AND '31'
)
SELECT
  session_key,
  source,
  medium,
  CASE
    WHEN source = '(direct)' AND medium IN ('(not set)', '(none)')                                       THEN 'Direct'
    WHEN medium = 'referral'                                                                              THEN 'Referral'
    WHEN medium = 'organic'
         OR REGEXP_CONTAINS(source, r'^(baidu|bing|duckduckgo|ecosia|google|yahoo|yandex)$')               THEN 'Organic Search'
    WHEN REGEXP_CONTAINS(source, r'(facebook|instagram|linkedin|pinterest|tiktok|twitter|whatsapp|badoo)')
         OR medium IN ('social','social-network','social-media','sm','social network','social media')     THEN 'Organic Social'
    WHEN medium IN ('email','e-mail','e_mail','e mail')  OR source IN ('email','e-mail','e_mail','e mail') THEN 'Email'
    WHEN medium IN ('display','banner','expandable','interstitial','cpm')                                  THEN 'Display'
    WHEN REGEXP_CONTAINS(medium, r'(cp|ppc|retargeting|paid)')
         AND REGEXP_CONTAINS(source, r'(baidu|bing|duckduckgo|ecosia|google|yahoo|yandex)')                THEN 'Paid Search'
    WHEN REGEXP_CONTAINS(medium, r'(cp|ppc|retargeting|paid)')
         AND REGEXP_CONTAINS(source, r'(facebook|instagram|linkedin|pinterest|tiktok|twitter|whatsapp)')   THEN 'Paid Social'
    ELSE 'Unassigned'
  END AS channel
FROM base
LIMIT 20;
