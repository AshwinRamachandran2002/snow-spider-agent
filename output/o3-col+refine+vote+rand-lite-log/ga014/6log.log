Query:
-- 8. Produce source-medium pairs with a preliminary channel bucket
WITH base AS (
  SELECT
    CONCAT(user_pseudo_id,
           CAST((SELECT value.int_value
                 FROM UNNEST(event_params)
                 WHERE key = 'ga_session_id') AS STRING))      AS session_key,
    COALESCE((SELECT value.string_value
              FROM UNNEST(event_params)
              WHERE key = 'source'), '(direct)')              AS source,
    COALESCE((SELECT value.string_value
              FROM UNNEST(event_params)
              WHERE key = 'medium'), '(not set)')             AS medium
  FROM
    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE
    _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND event_name = 'session_start'
)
SELECT
  source,
  medium,
  CASE
      WHEN LOWER(source) = '(direct)'
           AND LOWER(medium) IN ('(not set)', '(none)', '(not set)') THEN 'Direct'
      WHEN LOWER(medium) = 'referral'                               THEN 'Referral'
      WHEN LOWER(medium) = 'affiliate'                              THEN 'Affiliates'
      WHEN LOWER(medium) = 'email'                                  THEN 'Email'
      WHEN LOWER(medium) LIKE '%display%' OR LOWER(medium) IN ('banner','cpm','interstitial','expandable')
                                                                  THEN 'Display'
      WHEN LOWER(medium) = 'organic'
           AND REGEXP_CONTAINS(LOWER(source), r'(google|bing|yahoo|duckduckgo|baidu|yandex|ecosia)')
                                                                  THEN 'Organic Search'
      WHEN REGEXP_CONTAINS(LOWER(source), r'(facebook|instagram|linkedin|pinterest|tiktok|twitter|whatsapp|badoo)')
           AND LOWER(medium) = 'organic'                            THEN 'Organic Social'
      WHEN REGEXP_CONTAINS(LOWER(source), r'(google|bing|yahoo|duckduckgo|baidu|yandex|ecosia)')
           AND REGEXP_CONTAINS(LOWER(medium), r'(cp|ppc|paid|retargeting)')
                                                                  THEN 'Paid Search'
      WHEN REGEXP_CONTAINS(LOWER(source), r'(facebook|instagram|linkedin|pinterest|tiktok|twitter|whatsapp|badoo)')
           AND REGEXP_CONTAINS(LOWER(medium), r'(cp|ppc|paid|retargeting)')
                                                                  THEN 'Paid Social'
      ELSE 'Unassigned'
  END                                                              AS channel_group
FROM base
LIMIT 20;
