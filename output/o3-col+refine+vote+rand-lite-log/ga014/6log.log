Below is a progression of (max) 10 different BigQuery SQL statements – from very simple inspection queries to a complete solution that returns “total number of sessions for each traffic channel in December 2020”, all based only on values found in the `event_params` array.  
Every query is self-contained, uses only the allowed dataset, and ends with `LIMIT 20`.

```sql
-- 1. See how the raw event_params look for one December day (session_start events)
SELECT
  event_name,
  event_params
FROM
  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE
  _TABLE_SUFFIX = '20201201'
  AND event_name = 'session_start'
LIMIT 20;
```

```sql
-- 2. List the distinct keys that live inside event_params (December only)
SELECT DISTINCT
  ep.key
FROM
  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
  UNNEST(event_params) AS ep
WHERE
  _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
LIMIT 20;
```

```sql
-- 3. Inspect the different ‘medium’ values that appear in December 2020
SELECT DISTINCT
  COALESCE(ep.value.string_value,
           CAST(ep.value.int_value AS STRING)) AS medium
FROM
  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
  UNNEST(event_params) AS ep
WHERE
  _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND ep.key = 'medium'
LIMIT 20;
```

```sql
-- 4. Inspect the different ‘source’ values that appear in December 2020
SELECT DISTINCT
  COALESCE(ep.value.string_value,
           CAST(ep.value.int_value AS STRING)) AS source
FROM
  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
  UNNEST(event_params) AS ep
WHERE
  _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND ep.key = 'source'
LIMIT 20;
```

```sql
-- 5. Show sample user-session IDs coming from event_params
SELECT
  user_pseudo_id,
  (SELECT value.int_value
   FROM UNNEST(event_params)
   WHERE key = 'ga_session_id')                   AS session_id,
  event_timestamp
FROM
  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE
  _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND event_name = 'session_start'
LIMIT 20;
```

```sql
-- 6. Count sessions per raw “medium” (December 2020)
WITH b AS (
  SELECT
    CONCAT(user_pseudo_id,
           CAST((SELECT value.int_value
                 FROM UNNEST(event_params)
                 WHERE key = 'ga_session_id') AS STRING))      AS session_key,
    COALESCE((SELECT value.string_value
              FROM UNNEST(event_params)
              WHERE key = 'medium'), '(not set)')             AS medium
  FROM
    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE
    _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND event_name = 'session_start'
)
SELECT
  medium,
  COUNT(DISTINCT session_key) AS sessions
FROM b
GROUP BY medium
LIMIT 20;
```

```sql
-- 7. Count sessions per raw “source” (December 2020)
WITH b AS (
  SELECT
    CONCAT(user_pseudo_id,
           CAST((SELECT value.int_value
                 FROM UNNEST(event_params)
                 WHERE key = 'ga_session_id') AS STRING))      AS session_key,
    COALESCE((SELECT value.string_value
              FROM UNNEST(event_params)
              WHERE key = 'source'), '(direct)')              AS source
  FROM
    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE
    _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND event_name = 'session_start'
)
SELECT
  source,
  COUNT(DISTINCT session_key) AS sessions
FROM b
GROUP BY source
LIMIT 20;
```

```sql
-- 8. Produce source-medium pairs with a preliminary channel bucket
WITH base AS (
  SELECT
    CONCAT(user_pseudo_id,
           CAST((SELECT value.int_value
                 FROM UNNEST(event_params)
                 WHERE key = 'ga_session_id') AS STRING))      AS session_key,
    COALESCE((SELECT value.string_value
              FROM UNNEST(event_params)
              WHERE key = 'source'), '(direct)')              AS source,
    COALESCE((SELECT value.string_value
              FROM UNNEST(event_params)
              WHERE key = 'medium'), '(not set)')             AS medium
  FROM
    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE
    _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND event_name = 'session_start'
)
SELECT
  source,
  medium,
  CASE
      WHEN LOWER(source) = '(direct)'
           AND LOWER(medium) IN ('(not set)', '(none)', '(not set)') THEN 'Direct'
      WHEN LOWER(medium) = 'referral'                               THEN 'Referral'
      WHEN LOWER(medium) = 'affiliate'                              THEN 'Affiliates'
      WHEN LOWER(medium) = 'email'                                  THEN 'Email'
      WHEN LOWER(medium) LIKE '%display%' OR LOWER(medium) IN ('banner','cpm','interstitial','expandable')
                                                                  THEN 'Display'
      WHEN LOWER(medium) = 'organic'
           AND REGEXP_CONTAINS(LOWER(source), r'(google|bing|yahoo|duckduckgo|baidu|yandex|ecosia)')
                                                                  THEN 'Organic Search'
      WHEN REGEXP_CONTAINS(LOWER(source), r'(facebook|instagram|linkedin|pinterest|tiktok|twitter|whatsapp|badoo)')
           AND LOWER(medium) = 'organic'                            THEN 'Organic Social'
      WHEN REGEXP_CONTAINS(LOWER(source), r'(google|bing|yahoo|duckduckgo|baidu|yandex|ecosia)')
           AND REGEXP_CONTAINS(LOWER(medium), r'(cp|ppc|paid|retargeting)')
                                                                  THEN 'Paid Search'
      WHEN REGEXP_CONTAINS(LOWER(source), r'(facebook|instagram|linkedin|pinterest|tiktok|twitter|whatsapp|badoo)')
           AND REGEXP_CONTAINS(LOWER(medium), r'(cp|ppc|paid|retargeting)')
                                                                  THEN 'Paid Social'
      ELSE 'Unassigned'
  END                                                              AS channel_group
FROM base
LIMIT 20;
```

