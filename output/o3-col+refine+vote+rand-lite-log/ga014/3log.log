--Description: 10) (Optional sanity-check) Make sure we did not double-count – 
--               count distinct `ga_session_id` / `user_pseudo_id` pairs per channel.
WITH session_rows AS (
  SELECT
    (SELECT ep.value.int_value FROM UNNEST(`event_params`) ep WHERE ep.key = 'ga_session_id') AS ga_session_id,
    `user_pseudo_id`,
    CASE
      WHEN LOWER((SELECT ep.value.string_value FROM UNNEST(`event_params`) ep WHERE ep.key = 'source')) = '(direct)'
           AND LOWER((SELECT ep.value.string_value FROM UNNEST(`event_params`) ep WHERE ep.key = 'medium')) IN ('(not set)','(none)')
           THEN 'Direct'
      ELSE 'Other'
    END AS channel
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE `event_name` = 'session_start'
)
SELECT
  channel,
  COUNT(DISTINCT CONCAT(CAST(ga_session_id AS STRING),'-',`user_pseudo_id`)) AS distinct_sessions
FROM session_rows
GROUP BY channel
LIMIT 20;
