```sql
--Description:
-- Goal: Identify the single most-frequent sender of “Transfer” events since 2023-01-01,
--       where the recipient (“to”) is a real (non-zero) address.
-- Approach:
--   1. Parse ARGS JSON → sender (= element 0) and recipient (= element 1).
--   2. Keep rows whose recipient is not the zero address and begins with ‘0x’.
--   3. Exclude zero-address senders as well.
--   4. Aggregate to count transfers per sender.
--   5. Pick the sender with the highest count (ROW_NUMBER = 1).
--   6. Return that address as a full Cronoscan URL plus its count.
WITH sender_counts AS (
    SELECT
        PARSE_JSON("ARGS")[0]::STRING AS sender,
        COUNT(*)                     AS tx_cnt
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
    WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND "BLOCK_TIMESTAMP" >= 1672531200 * 1000000  -- µs since 2023-01-01
      AND PARSE_JSON("ARGS")[1]::STRING ILIKE '0x%'                   -- valid recipient
      AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
      AND PARSE_JSON("ARGS")[0]::STRING <> '0x0000000000000000000000000000000000000000'  -- non-zero sender
    GROUP BY 1
), top_sender AS (
    SELECT sender, tx_cnt
    FROM sender_counts
    QUALIFY ROW_NUMBER() OVER (ORDER BY tx_cnt DESC) = 1
)
SELECT
    'https://cronoscan.com/address/' || LOWER(sender) AS "cronoscan_url",
    tx_cnt                                            AS "transfer_count"
FROM top_sender;
```
