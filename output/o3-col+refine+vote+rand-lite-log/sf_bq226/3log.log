```sql
--Description:
-- Build the Cronoscan URL for the most-frequent sender of “Transfer” events (since 2023-01-01),
-- where the recipient is a real, non-zero address.  Steps:
--   1. Parse `ARGS` → sender (index 0) & recipient (index 1).
--   2. Filter out rows whose sender or recipient is the zero-address.
--   3. Count transfers per sender.
--   4. Pick the sender with the greatest count.
--   5. Concatenate that address into a full https://cronoscan.com URL.
WITH sender_counts AS (
    SELECT
        PARSE_JSON("ARGS")[0]::STRING AS sender,
        COUNT(*)                     AS tx_cnt
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
    WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND "BLOCK_TIMESTAMP" >= 1672531200 * 1000000                              -- ≥ 2023-01-01 (µs)
      AND PARSE_JSON("ARGS")[1]::STRING ILIKE '0x%'                               -- valid recipient
      AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
      AND PARSE_JSON("ARGS")[0]::STRING <> '0x0000000000000000000000000000000000000000'  -- non-zero sender
    GROUP BY 1
), top_sender AS (
    SELECT sender, tx_cnt
    FROM sender_counts
    QUALIFY ROW_NUMBER() OVER (ORDER BY tx_cnt DESC) = 1
)
SELECT
