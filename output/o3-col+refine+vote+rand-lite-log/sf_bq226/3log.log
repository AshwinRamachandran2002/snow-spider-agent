  AND PARSE_JSON("ARGS")[0]::STRING = :TOP_SENDER
  AND "BLOCK_TIMESTAMP" >= 1672531200 * 1000000
LIMIT 20;
```

```sql
--Description: Produce the complete Cronoscan URL for the most-frequent sender (replace :TOP_SENDER with actual address)
