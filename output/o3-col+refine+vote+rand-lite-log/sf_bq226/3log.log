```sql
/*  Most-frequent sender (since 2023-01-01) whose transfers
    went to a non-zero recipient AND occurred in blocks that
    contain at least one log whose “data” payload exceeds
    4 096 bytes (≈ 8 192 hex chars).  
    The result is returned as a complete Cronoscan URL.
*/
WITH big_blocks AS (          -- blocks that are “> 4 096 bytes”
    SELECT DISTINCT "BLOCK_NUMBER"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE (LENGTH("DATA") - 2) / 2 > 4096          -- strip “0x”, convert hex-chars → bytes
),
sender_counts AS (            -- count eligible transfers per sender
    SELECT
        LOWER(PARSE_JSON("ARGS")[0]::STRING) AS sender,
        COUNT(*)                             AS tx_cnt
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" ev
    WHERE ev."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND ev."BLOCK_TIMESTAMP" >= 1672531200 * 1000000            -- ≥ 2023-01-01 (µs)
      AND PARSE_JSON("ARGS")[1]::STRING ILIKE '0x%'               -- recipient present
      AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
      AND ev."BLOCK_NUMBER" IN (SELECT "BLOCK_NUMBER" FROM big_blocks)
    GROUP BY 1
)
SELECT
    'https://cronoscan.com/address/' || sender AS cronoscan_url,
    tx_cnt                                    AS transfer_count
FROM sender_counts
ORDER BY tx_cnt DESC NULLS LAST
LIMIT 1;
```
