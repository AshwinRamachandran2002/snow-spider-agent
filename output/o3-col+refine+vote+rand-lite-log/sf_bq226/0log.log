```sql
WITH "LARGE_LOGS" AS (
    -- Logs whose DATA payload exceeds 4 096 hex characters (≈ >4 096 bytes)
    SELECT
        "block_number",
        "transaction_hash",
        "log_index"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE "block_timestamp" >= 1672531200000000   -- 1-Jan-2023
      AND LENGTH("data") > 4096                   -- “large” blocks/logs
),
"TRANSFER_EVENTS" AS (
    -- ERC-20 Transfer events stemming from those large logs
    SELECT
        TRY_PARSE_JSON("ARGS")[0]::STRING AS "sender"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" AS e
    JOIN "LARGE_LOGS" AS l
      ON e."BLOCK_NUMBER"     = l."block_number"
     AND e."TRANSACTION_HASH" = l."transaction_hash"
     AND e."LOG_INDEX"        = l."log_index"
    WHERE e."EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'  -- Transfer
      AND TRY_PARSE_JSON(e."ARGS")[1] IS NOT NULL   -- non-null “to” address
)
-- Most-frequent sender address, returned as a Cronoscan URL
SELECT CONCAT('https://cronoscan.com/address/', "sender") AS "cronoscan_url"
FROM (
    SELECT "sender",
           COUNT(*) AS "tx_count"
    FROM "TRANSFER_EVENTS"
    GROUP BY "sender"
    ORDER BY "tx_count" DESC NULLS LAST
    LIMIT 1
);
```
