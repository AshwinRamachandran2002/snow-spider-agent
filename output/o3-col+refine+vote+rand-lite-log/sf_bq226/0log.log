```sql
--Description: Sample 20 ERC-20 Transfer events since 1-Jan-2023 from DECODED_EVENTS,
--             using correct upper-case column names.  No array access required here.
SELECT "BLOCK_NUMBER",
       "ARGS",
       "ADDRESS"
FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE  "BLOCK_TIMESTAMP" >= 1672531200000000
  AND  "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
LIMIT 20;
```

```sql
--Description: List distinct contract addresses whose DATA field is longer than 4 096 hex
--             characters in LOGS since 1-Jan-2023 (all lower-case column names).
SELECT DISTINCT "address"
FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE  LENGTH("data") > 4096
  AND  "block_timestamp" >= 1672531200000000
LIMIT 20;
```

```sql
--Description: Count how many large-payload logs (DATA length >4 096) each address emitted
--             since 1-Jan-2023 in the LOGS table.
SELECT "address",
       COUNT(*) AS "large_payload_logs"
FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE  LENGTH("data") > 4096
  AND  "block_timestamp" >= 1672531200000000
GROUP  BY "address"
ORDER  BY "large_payload_logs" DESC
LIMIT 20;
```

```sql
--Description: Extract sender, recipient, and amount from decoded ERC-20 Transfer events
--             (cast ARGS text to VARIANT, then use array indexing) to ensure TO is non-null.
SELECT ( "ARGS"::VARIANT )[0]::STRING AS "from_addr",
       ( "ARGS"::VARIANT )[1]::STRING AS "to_addr",
       ( "ARGS"::VARIANT )[2]::STRING AS "amount",
       "BLOCK_NUMBER"
FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE  "BLOCK_TIMESTAMP" >= 1672531200000000
  AND  "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND  ( "ARGS"::VARIANT )[1] IS NOT NULL
LIMIT 20;
```

```sql
--Description: Aggregate how often each sender address appears in decoded Transfer events
--             with a non-null recipient since 1-Jan-2023.
SELECT ( "ARGS"::VARIANT )[0]::STRING AS "sender",
       COUNT(*)                       AS "tx_count"
FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE  "BLOCK_TIMESTAMP" >= 1672531200000000
  AND  "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND  ( "ARGS"::VARIANT )[1] IS NOT NULL
GROUP  BY "sender"
ORDER  BY "tx_count" DESC
LIMIT 20;
```

```sql
--Description: Return the Cronoscan URL of the single most-frequent sender address found
--             in qualifying Transfer events since 1-Jan-2023.
SELECT CONCAT('https://cronoscan.com/address/', "sender") AS "cronoscan_url"
FROM (
    SELECT ( "ARGS"::VARIANT )[0]::STRING AS "sender",
           COUNT(*)                      AS "tx_count"
    FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
    WHERE  "BLOCK_TIMESTAMP" >= 1672531200000000
      AND  "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
      AND  ( "ARGS"::VARIANT )[1] IS NOT NULL
    GROUP  BY "sender"
    ORDER  BY "tx_count" DESC
    LIMIT 1
);
```
