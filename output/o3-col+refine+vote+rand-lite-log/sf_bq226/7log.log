Query:
--Description: 9) For the top sender calculated above, list its transfers with block_number ‑ helpful for additional inspections.
WITH top_sender AS (
  SELECT PARSE_JSON("ARGS")[0]::STRING AS "from_address",
         COUNT(*) AS "cnt"
  FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
  WHERE "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
    AND "BLOCK_TIMESTAMP" >= 1672531200000000
    AND PARSE_JSON("ARGS")[1] IS NOT NULL
  GROUP BY "from_address"
  ORDER BY "cnt" DESC
  LIMIT 1
)
SELECT 
  d."TRANSACTION_HASH",
  d."LOG_INDEX",
  d."BLOCK_NUMBER",
  PARSE_JSON(d."ARGS")[1]::STRING AS "to_address"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS d
JOIN top_sender t
  ON PARSE_JSON(d."ARGS")[0]::STRING = t."from_address"
WHERE d."EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
LIMIT 20;
