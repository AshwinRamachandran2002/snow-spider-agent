```sql
--Description: 1) Look at 20 raw log rows after 1-Jan-2023 (timestamps are in μs since epoch).
SELECT 
  "block_hash",
  "block_number",
  "block_timestamp",
  "transaction_hash",
  "log_index",
  "address",
  "topics",
  "data"
