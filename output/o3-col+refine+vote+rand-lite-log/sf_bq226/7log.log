WHERE "block_timestamp" >= 1672531200000000        -- 2023-01-01 00:00:00 UTC
LIMIT 20;
```

```sql
--Description: 2) Show distinct hashes of events that were decoded after 1-Jan-2023.
SELECT DISTINCT 
  "EVENT_HASH",
  "EVENT_SIGNATURE"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
WHERE "BLOCK_TIMESTAMP" >= 1672531200000000
LIMIT 20;
```

```sql
--Description: 3) Inspect some decoded `Transfer` events (hash = keccak of Transfer) after 1-Jan-2023.
SELECT 
  "TRANSACTION_HASH",
  "LOG_INDEX",
  "BLOCK_NUMBER",
  "ARGS"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
WHERE "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND "BLOCK_TIMESTAMP" >= 1672531200000000
LIMIT 20;
```

```sql
--Description: 4) Extract and show the `from_address` (index-0) and `to_address` (index-1) from the ARGS JSON array.
SELECT 
  PARSE_JSON("ARGS")[0]::STRING AS "from_address",
  PARSE_JSON("ARGS")[1]::STRING AS "to_address",
  PARSE_JSON("ARGS")[2]::STRING AS "amount",
  "BLOCK_NUMBER",
  "BLOCK_TIMESTAMP"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
WHERE "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND "BLOCK_TIMESTAMP" >= 1672531200000000
LIMIT 20;
```

```sql
--Description: 5) Count how many transfers each `from_address` made (only when `to_address` is non-null) since 1-Jan-2023.
SELECT 
  PARSE_JSON("ARGS")[0]::STRING AS "from_address",
  COUNT(*)                     AS "transfer_count"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
WHERE "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND "BLOCK_TIMESTAMP" >= 1672531200000000
  AND PARSE_JSON("ARGS")[1] IS NOT NULL
GROUP BY "from_address"
ORDER BY "transfer_count" DESC
LIMIT 20;
```

```sql
--Description: 6) Create the full Cronoscan URL for the top-sending addresses (string assembled in SQL).
SELECT 
  'https://cronoscan.com/address/' || PARSE_JSON("ARGS")[0]::STRING AS "cronoscan_url",
  COUNT(*) AS "transfer_count"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
WHERE "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND "BLOCK_TIMESTAMP" >= 1672531200000000
  AND PARSE_JSON("ARGS")[1] IS NOT NULL
GROUP BY "cronoscan_url"
ORDER BY "transfer_count" DESC
LIMIT 20;
```

```sql
--Description: 7) Same as previous but also show the raw sender address beside the URL.
SELECT 
  PARSE_JSON("ARGS")[0]::STRING                                       AS "from_address",
  'https://cronoscan.com/address/' || PARSE_JSON("ARGS")[0]::STRING   AS "cronoscan_url",
  COUNT(*)                                                            AS "transfer_count"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
WHERE "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND "BLOCK_TIMESTAMP" >= 1672531200000000
  AND PARSE_JSON("ARGS")[1] IS NOT NULL
GROUP BY "from_address", "cronoscan_url"
ORDER BY "transfer_count" DESC
LIMIT 20;
```

```sql
--Description: 8) Retrieve the absolute top sender address (most transfers) meeting the same conditions.
SELECT 
  PARSE_JSON("ARGS")[0]::STRING AS "from_address",
  COUNT(*)                     AS "transfer_count"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
WHERE "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND "BLOCK_TIMESTAMP" >= 1672531200000000
  AND PARSE_JSON("ARGS")[1] IS NOT NULL
GROUP BY "from_address"
ORDER BY "transfer_count" DESC
LIMIT 1;
```

```sql
--Description: 9) For the top sender calculated above, list its transfers with block_number ‑ helpful for additional inspections.
WITH top_sender AS (
  SELECT PARSE_JSON("ARGS")[0]::STRING AS "from_address",
         COUNT(*) AS "cnt"
  FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
  WHERE "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
    AND "BLOCK_TIMESTAMP" >= 1672531200000000
    AND PARSE_JSON("ARGS")[1] IS NOT NULL
  GROUP BY "from_address"
  ORDER BY "cnt" DESC
  LIMIT 1
)
SELECT 
  d."TRANSACTION_HASH",
  d."LOG_INDEX",
  d."BLOCK_NUMBER",
  PARSE_JSON(d."ARGS")[1]::STRING AS "to_address"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS d
JOIN top_sender t
  ON PARSE_JSON(d."ARGS")[0]::STRING = t."from_address"
WHERE d."EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
LIMIT 20;
```

```sql
--Description: 10) (Optional deeper dive) Show distribution of block sizes *if* any size metric exists in logs (else returns nothing).
