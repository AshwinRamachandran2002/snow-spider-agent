--Description: 5) Count how many transfers each `from_address` made (only when `to_address` is non-null) since 1-Jan-2023.
SELECT 
  PARSE_JSON("ARGS")[0]::STRING AS "from_address",
  COUNT(*)                     AS "transfer_count"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
WHERE "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND "BLOCK_TIMESTAMP" >= 1672531200000000
  AND PARSE_JSON("ARGS")[1] IS NOT NULL
GROUP BY "from_address"
ORDER BY "transfer_count" DESC
LIMIT 20;
