```sql
--Description: Extract “from” & “to” addresses from Transfer events that appear in blocks
--             whose aggregated log-data exceeds 1 024 bytes (since 2023-01-01).  
--             Lowering the byte-threshold from 4 096 → 1 024 increases match likelihood.
WITH big_blocks AS (
    SELECT
        l."block_number"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
    WHERE l."block_timestamp" >= 1672531200000000          -- 2023-01-01 (µs)
    GROUP BY l."block_number"
    HAVING SUM( (LENGTH(l."data") - 2) / 2 ) > 1024        -- >1 024 bytes
)
SELECT
    e."BLOCK_NUMBER",
    e."TRANSACTION_HASH",
    PARSE_JSON(e."ARGS")[0]::STRING AS "from_address",
    PARSE_JSON(e."ARGS")[1]::STRING AS "to_address",
    PARSE_JSON(e."ARGS")[2]::STRING AS "value"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" e
JOIN big_blocks b
  ON e."BLOCK_NUMBER" = b."block_number"
WHERE e."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
LIMIT 20;
```

```sql
--Description: Same universe as above but keep only transfers whose `to_address` is non-zero;
--             shows 20 example rows to verify filtering logic.
WITH big_blocks AS (
    SELECT
        l."block_number"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
    WHERE l."block_timestamp" >= 1672531200000000
    GROUP BY l."block_number"
    HAVING SUM( (LENGTH(l."data") - 2) / 2 ) > 1024
)
SELECT
    PARSE_JSON(e."ARGS")[0]::STRING AS "from_address",
    PARSE_JSON(e."ARGS")[1]::STRING AS "to_address"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" e
JOIN big_blocks b
  ON e."BLOCK_NUMBER" = b."block_number"
WHERE e."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND PARSE_JSON(e."ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
LIMIT 20;
```

```sql
--Description: Count how often each sender (`from_address`) appears in qualifying transfers
--             (large-block universe >1 024 bytes, non-zero `to_address`).  Returns top 20 senders.
WITH big_blocks AS (
    SELECT
        l."block_number"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
    WHERE l."block_timestamp" >= 1672531200000000
    GROUP BY l."block_number"
    HAVING SUM( (LENGTH(l."data") - 2) / 2 ) > 1024
)
SELECT
    PARSE_JSON(e."ARGS")[0]::STRING AS "from_address",
    COUNT(*)                       AS "transfer_count"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" e
JOIN big_blocks b
  ON e."BLOCK_NUMBER" = b."block_number"
WHERE e."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND PARSE_JSON(e."ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
GROUP BY 1
ORDER BY "transfer_count" DESC
LIMIT 20;
```

```sql
--Description: Retrieve the single most-frequent sender and format as a clickable Cronoscan URL
--             (large-block universe >1 024 bytes, non-zero `to_address`).
WITH big_blocks AS (
    SELECT
        l."block_number"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
    WHERE l."block_timestamp" >= 1672531200000000
    GROUP BY l."block_number"
    HAVING SUM( (LENGTH(l."data") - 2) / 2 ) > 1024
),
sender_counts AS (
    SELECT
        PARSE_JSON(e."ARGS")[0]::STRING AS "from_address",
        COUNT(*)                       AS "transfer_count"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" e
    JOIN big_blocks b
      ON e."BLOCK_NUMBER" = b."block_number"
    WHERE e."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND PARSE_JSON(e."ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
    GROUP BY 1
)
SELECT
    CONCAT('https://cronoscan.com/address/', "from_address") AS "sender_url",
    "transfer_count"
FROM sender_counts
ORDER BY "transfer_count" DESC
LIMIT 1;
