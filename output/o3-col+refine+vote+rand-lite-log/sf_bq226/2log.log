```sql
--Description: Keep only transfers with a non-zero “to” address (20 rows)
SELECT
  PARSE_JSON(e."ARGS")[0]::STRING  AS "from_address",
  PARSE_JSON(e."ARGS")[1]::STRING  AS "to_address"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" e
JOIN (
  SELECT
    l."block_number"
  FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
  WHERE l."block_timestamp" >= 1672531200000000
  GROUP BY l."block_number"
  HAVING SUM( (LENGTH(l."data") - 2) / 2 ) > 4096
) b
ON e."BLOCK_NUMBER" = b."block_number"
WHERE e."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND PARSE_JSON(e."ARGS")[1]::STRING ILIKE '0x%'
  AND PARSE_JSON(e."ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
LIMIT 20;
```

```sql
--Description: Count how often each sender appears in those qualifying transfers (top 20)
SELECT
  PARSE_JSON(e."ARGS")[0]::STRING  AS "from_address",
  COUNT(*)                         AS "transfer_count"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" e
JOIN (
  SELECT
    l."block_number"
  FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
  WHERE l."block_timestamp" >= 1672531200000000
  GROUP BY l."block_number"
  HAVING SUM( (LENGTH(l."data") - 2) / 2 ) > 4096
) b
ON e."BLOCK_NUMBER" = b."block_number"
WHERE e."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND PARSE_JSON(e."ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
GROUP BY 1
ORDER BY "transfer_count" DESC
LIMIT 20;
```

```sql
--Description: Return the single most-frequent sender; build the ready-to-click cronoscan URL
SELECT
  CONCAT('https://cronoscan.com/address/', top_sender."from_address") AS "sender_url",
  top_sender."transfer_count"
FROM (
  SELECT
    PARSE_JSON(e."ARGS")[0]::STRING  AS "from_address",
    COUNT(*)                         AS "transfer_count"
  FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" e
  JOIN (
    SELECT
      l."block_number"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
    WHERE l."block_timestamp" >= 1672531200000000
    GROUP BY l."block_number"
    HAVING SUM( (LENGTH(l."data") - 2) / 2 ) > 4096
  ) b
  ON e."BLOCK_NUMBER" = b."block_number"
  WHERE e."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
    AND PARSE_JSON(e."ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
  GROUP BY 1
  ORDER BY "transfer_count" DESC
  LIMIT 1
) top_sender;
