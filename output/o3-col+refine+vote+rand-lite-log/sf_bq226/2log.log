```sql
--Description: Identify each calendar month since 1-Jan-2023 and count how many distinct
--             blocks have more than 1 024 bytes of total log-data.  We first flag such
--             “big” blocks, then derive a month field that can be grouped without error.
WITH big_blocks AS (
    SELECT
        "block_number",
        MAX("block_timestamp") AS "block_timestamp"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE "block_timestamp" >= 1672531200000000            -- 2023-01-01 (µs)
    GROUP BY "block_number"
    HAVING SUM( (LENGTH("data") - 2) / 2 ) > 1024          -- total log-data > 1 024 bytes
)
SELECT
    DATE_TRUNC(
        'month',
        TO_TIMESTAMP_NTZ("block_timestamp" / 1000000)      -- µs → s
    )                               AS "month",
    COUNT(DISTINCT "block_number")  AS "large_block_count"
FROM big_blocks
GROUP BY "month"
ORDER BY "month"
LIMIT 20;
```
