```sql
--Description: Retrieve the single most-frequent sender in qualifying Transfer events
--             and format as a clickable Cronoscan URL.
WITH sender_counts AS (
    SELECT
        PARSE_JSON("ARGS")[0]::STRING AS "from_address",
        COUNT(*)                     AS "transfer_count"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
    WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND "BLOCK_TIMESTAMP" >= 1672531200000000
      AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
    GROUP BY 1
)
SELECT
    CONCAT('https://cronoscan.com/address/', "from_address") AS "sender_url",
    "transfer_count"
FROM sender_counts
ORDER BY "transfer_count" DESC
LIMIT 1;
```

```sql
--Description: Examine how many blocks per month (since 2023-01-01) have total log-data
--             greater than 1 024 bytes, for context on block activity.
SELECT
    DATE_TRUNC('month', TO_TIMESTAMP_NTZ(MAX("block_timestamp")/1000000)) AS "month",
    COUNT(DISTINCT "block_number")                                         AS "large_block_count"
FROM (
    SELECT
        "block_number",
        MAX("block_timestamp") AS "block_timestamp"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE "block_timestamp" >= 1672531200000000
    GROUP BY "block_number"
    HAVING SUM( (LENGTH("data") - 2) / 2 ) > 1024
) big
GROUP BY 1
ORDER BY 1
LIMIT 20;
```
