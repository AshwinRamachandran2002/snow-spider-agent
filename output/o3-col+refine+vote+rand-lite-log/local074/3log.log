--Description: 8) Cartesian frame: every customer × every calendar month (sparse view).
WITH
     months AS (
         SELECT DISTINCT substr("txn_date",1,7) AS "month_year"
         FROM   "customer_transactions"
     ),
     customers AS (
         SELECT DISTINCT "customer_id" FROM "customer_transactions"
     )
SELECT c."customer_id",
       m."month_year"
FROM   customers c
CROSS  JOIN months  m
ORDER  BY c."customer_id", m."month_year"
LIMIT 20;
