```sql
--Description: 2) Take a quick look at the raw transaction history (oldest first).
SELECT *
FROM "customer_transactions"
ORDER BY "txn_date", "customer_id"
LIMIT 20;
```

```sql
--Description: 3) List every calendar month that appears in the data.
SELECT DISTINCT substr("txn_date",1,7)  AS "month_year"
FROM "customer_transactions"
ORDER BY "month_year"
LIMIT 20;
```

```sql
--Description: 4) Net change per customer per month (+ for deposits, – for withdrawals).
SELECT
       "customer_id",
       substr("txn_date",1,7)  AS "month_year",
       SUM(CASE WHEN "txn_type"='deposit'
                THEN  "txn_amount"
                ELSE - "txn_amount" END)   AS "monthly_change"
FROM   "customer_transactions"
GROUP  BY "customer_id", "month_year"
ORDER  BY "customer_id", "month_year"
LIMIT 20;
```

```sql
--Description: 5) Identify the overall date range we must cover.
SELECT MIN("txn_date") AS "earliest_date",
       MAX("txn_date") AS "latest_date"
FROM   "customer_transactions";
```

```sql
--Description: 6) Build a list of every month in the observed range (recursive CTE).
WITH RECURSIVE months("month_year") AS (
      SELECT substr(MIN("txn_date"),1,7) 
      FROM   "customer_transactions"
      UNION ALL
      SELECT substr(date("month_year"||'-01','+1 month'),1,7)
      FROM   months
      WHERE  "month_year" < (SELECT substr(MAX("txn_date"),1,7)
                             FROM   "customer_transactions")
)
SELECT DISTINCT "month_year"
FROM   months
ORDER  BY "month_year"
LIMIT 20;
```

```sql
--Description: 7) Who are all the customers that ever appeared in the ledger?
SELECT DISTINCT "customer_id"
FROM   "customer_transactions"
ORDER  BY "customer_id"
LIMIT 20;
```

```sql
--Description: 8) Cartesian frame: every customer × every calendar month (sparse view).
WITH
     months AS (
         SELECT DISTINCT substr("txn_date",1,7) AS "month_year"
         FROM   "customer_transactions"
     ),
     customers AS (
         SELECT DISTINCT "customer_id" FROM "customer_transactions"
     )
SELECT c."customer_id",
       m."month_year"
FROM   customers c
CROSS  JOIN months  m
ORDER  BY c."customer_id", m."month_year"
LIMIT 20;
```

```sql
--Description: 9) Attach the monthly net-change figures to the full customer-month frame.
WITH
     months AS (
         SELECT DISTINCT substr("txn_date",1,7) AS "month_year"
         FROM   "customer_transactions"
     ),
     customers AS (
         SELECT DISTINCT "customer_id" FROM "customer_transactions"
     ),
     calendar AS (                     -- every customer in every month
         SELECT c."customer_id",
                m."month_year"
         FROM   customers c
         CROSS  JOIN months m
     ),
     net AS (                          -- net movement inside each month
         SELECT  "customer_id",
                 substr("txn_date",1,7)  AS "month_year",
                 SUM(CASE WHEN "txn_type"='deposit'
                          THEN  "txn_amount"
                          ELSE - "txn_amount" END) AS "monthly_change"
         FROM    "customer_transactions"
         GROUP   BY "customer_id","month_year"
     )
SELECT  cal."customer_id",
        cal."month_year",
        COALESCE(net."monthly_change",0) AS "monthly_change"
FROM    calendar cal
LEFT    JOIN net
       ON net."customer_id" = cal."customer_id"
      AND net."month_year"   = cal."month_year"
ORDER   BY cal."customer_id", cal."month_year"
LIMIT 20;
```

```sql
--Description: 10) Final report – monthly movement & running (closing) balance per customer.
WITH
     months AS (
         SELECT DISTINCT substr("txn_date",1,7) AS "month_year"
         FROM   "customer_transactions"
     ),
     customers AS (
         SELECT DISTINCT "customer_id" FROM "customer_transactions"
     ),
     calendar AS (
         SELECT c."customer_id",
                m."month_year"
         FROM   customers c
         CROSS  JOIN months m
     ),
     net AS (
         SELECT  "customer_id",
                 substr("txn_date",1,7)  AS "month_year",
                 SUM(CASE WHEN "txn_type"='deposit'
                          THEN  "txn_amount"
                          ELSE - "txn_amount" END) AS "monthly_change"
         FROM    "customer_transactions"
         GROUP   BY "customer_id","month_year"
     ),
     joined AS (
         SELECT  cal."customer_id",
                 cal."month_year",
                 COALESCE(net."monthly_change",0) AS "monthly_change"
         FROM    calendar cal
         LEFT    JOIN net
               ON net."customer_id" = cal."customer_id"
              AND net."month_year"  = cal."month_year"
     )
SELECT  j."customer_id",
        j."month_year",
        j."monthly_change",
        SUM(j."monthly_change")
             OVER (PARTITION BY j."customer_id"
                   ORDER BY     j."month_year") AS "closing_balance"
FROM    joined j
ORDER   BY j."customer_id", j."month_year"
LIMIT 20;
```
