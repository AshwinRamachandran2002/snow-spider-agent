--Description: 10) Final report – monthly movement & running (closing) balance per customer.
WITH
     months AS (
         SELECT DISTINCT substr("txn_date",1,7) AS "month_year"
         FROM   "customer_transactions"
     ),
     customers AS (
         SELECT DISTINCT "customer_id" FROM "customer_transactions"
     ),
     calendar AS (
         SELECT c."customer_id",
                m."month_year"
         FROM   customers c
         CROSS  JOIN months m
     ),
     net AS (
         SELECT  "customer_id",
                 substr("txn_date",1,7)  AS "month_year",
                 SUM(CASE WHEN "txn_type"='deposit'
                          THEN  "txn_amount"
                          ELSE - "txn_amount" END) AS "monthly_change"
         FROM    "customer_transactions"
         GROUP   BY "customer_id","month_year"
     ),
     joined AS (
         SELECT  cal."customer_id",
                 cal."month_year",
                 COALESCE(net."monthly_change",0) AS "monthly_change"
         FROM    calendar cal
         LEFT    JOIN net
               ON net."customer_id" = cal."customer_id"
              AND net."month_year"  = cal."month_year"
     )
SELECT  j."customer_id",
        j."month_year",
        j."monthly_change",
        SUM(j."monthly_change")
             OVER (PARTITION BY j."customer_id"
                   ORDER BY     j."month_year") AS "closing_balance"
FROM    joined j
ORDER   BY j."customer_id", j."month_year"
LIMIT 20;
