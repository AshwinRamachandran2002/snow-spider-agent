Query:
--Description: 9) Attach the monthly net-change figures to the full customer-month frame.
WITH
     months AS (
         SELECT DISTINCT substr("txn_date",1,7) AS "month_year"
         FROM   "customer_transactions"
     ),
     customers AS (
         SELECT DISTINCT "customer_id" FROM "customer_transactions"
     ),
     calendar AS (                     -- every customer in every month
         SELECT c."customer_id",
                m."month_year"
         FROM   customers c
         CROSS  JOIN months m
     ),
     net AS (                          -- net movement inside each month
         SELECT  "customer_id",
                 substr("txn_date",1,7)  AS "month_year",
                 SUM(CASE WHEN "txn_type"='deposit'
                          THEN  "txn_amount"
                          ELSE - "txn_amount" END) AS "monthly_change"
         FROM    "customer_transactions"
         GROUP   BY "customer_id","month_year"
     )
SELECT  cal."customer_id",
        cal."month_year",
        COALESCE(net."monthly_change",0) AS "monthly_change"
FROM    calendar cal
LEFT    JOIN net
       ON net."customer_id" = cal."customer_id"
      AND net."month_year"   = cal."month_year"
ORDER   BY cal."customer_id", cal."month_year"
LIMIT 20;
