```sql
--Description: Preview distinct transaction rows so we can confirm the raw format of dates, types and amounts.
SELECT DISTINCT "customer_id",
                "txn_date",
                "txn_type",
                "txn_amount"
FROM   "customer_transactions"
LIMIT 20;
```

```sql
--Description: List every transaction type that exists in the data set (e.g. deposit, withdrawal, fee …).
SELECT DISTINCT "txn_type"
FROM   "customer_transactions"
LIMIT 20;
```

```sql
--Description: See which calendar months (YYYY-MM) appear in the file.
SELECT DISTINCT substr("txn_date",1,7) AS "month_year"
FROM   "customer_transactions"
LIMIT 20;
```

```sql
--Description: Monthly total deposits for each customer so we know the positive side of the ledger.
SELECT substr("txn_date",1,7)         AS "month_year",
       "customer_id",
       SUM("txn_amount")              AS "total_deposit"
FROM   "customer_transactions"
WHERE  "txn_type" = 'deposit'
GROUP  BY "customer_id", substr("txn_date",1,7)
LIMIT 20;
```

```sql
--Description: Monthly net change (deposits minus withdrawals) per customer.
SELECT substr("txn_date",1,7) AS "month_year",
       "customer_id",
       SUM(CASE WHEN "txn_type" = 'deposit'     THEN  "txn_amount"
                WHEN "txn_type" = 'withdrawal'  THEN -"txn_amount"
                ELSE 0 END)                     AS "net_change"
FROM   "customer_transactions"
GROUP  BY "customer_id", substr("txn_date",1,7)
LIMIT 20;
```

```sql
--Description: Running (cumulative) balance by customer using the monthly net change.
SELECT "customer_id",
       substr("txn_date",1,7)                                              AS "month_year",
       SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                WHEN "txn_type"='withdrawal' THEN -"txn_amount"
                ELSE 0 END)                                                AS "net_change",
       SUM( SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                     WHEN "txn_type"='withdrawal' THEN -"txn_amount"
                     ELSE 0 END)
           ) OVER (PARTITION BY "customer_id"
                    ORDER BY substr("txn_date",1,7)
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)      AS "cumulative_balance"
FROM   "customer_transactions"
GROUP  BY "customer_id", substr("txn_date",1,7)
LIMIT 20;
```

```sql
--Description: Generate a 2020 month calendar (one row per month) and cross-join to a sample of customers.
WITH RECURSIVE months AS (
     SELECT '2020-01' AS month
     UNION ALL
     SELECT substr(date(month || '-01','+1 month'),1,7)
     FROM   months
     WHERE  month < '2020-12'
)
SELECT m."month",
       c."customer_id"
FROM   months AS m
CROSS  JOIN (SELECT DISTINCT "customer_id"
             FROM "customer_transactions"
             LIMIT 5) AS c
LIMIT 20;
```

```sql
--Description: Bring together the calendar of months and the net change table so missing months show 0.
WITH RECURSIVE months AS (
     SELECT '2020-01' AS month
     UNION ALL
     SELECT substr(date(month || '-01','+1 month'),1,7)
     FROM   months
     WHERE  month < '2020-12'
),
net_change AS (
     SELECT "customer_id",
            substr("txn_date",1,7) AS month,
            SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                     WHEN "txn_type"='withdrawal' THEN -"txn_amount"
                     ELSE 0 END)   AS net_change
     FROM   "customer_transactions"
     GROUP  BY "customer_id", substr("txn_date",1,7)
)
SELECT m."month",
       c."customer_id",
       COALESCE(n."net_change",0) AS "net_change"
FROM   months AS m
CROSS  JOIN (SELECT DISTINCT "customer_id" FROM "customer_transactions") AS c
LEFT   JOIN net_change n
       ON n."customer_id" = c."customer_id"
      AND n."month"       = m."month"
LIMIT 20;
```

```sql
--Description: Calculate closing balance (cumulative) for every customer/month, keeping zero rows for inactivity.
WITH RECURSIVE months AS (
     SELECT '2020-01' AS month
     UNION ALL
     SELECT substr(date(month || '-01','+1 month'),1,7)
     FROM   months
     WHERE  month < '2020-12'
),
net_change AS (
     SELECT "customer_id",
            substr("txn_date",1,7) AS month,
            SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                     WHEN "txn_type"='withdrawal' THEN -"txn_amount"
                     ELSE 0 END)   AS net_change
     FROM   "customer_transactions"
     GROUP  BY "customer_id", substr("txn_date",1,7)
)
SELECT m."month",
       c."customer_id",
       COALESCE(n."net_change",0)                                              AS "net_change",
       SUM(COALESCE(n."net_change",0))
            OVER (PARTITION BY c."customer_id"
                  ORDER BY m."month"
                  ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)            AS "closing_balance"
FROM   months AS m
CROSS  JOIN (SELECT DISTINCT "customer_id" FROM "customer_transactions") AS c
LEFT   JOIN net_change n
       ON n."customer_id" = c."customer_id"
      AND n."month"       = m."month"
LIMIT 20;
```

```sql
--Description: Quick look at each customer’s first & last transaction date and their lifetime net position.
SELECT "customer_id",
       MIN("txn_date")                                                        AS "first_txn",
       MAX("txn_date")                                                        AS "last_txn",
       SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                WHEN "txn_type"='withdrawal' THEN -"txn_amount"
                ELSE 0 END)                                                   AS "lifetime_net"
FROM   "customer_transactions"
GROUP  BY "customer_id"
LIMIT 20;
```
