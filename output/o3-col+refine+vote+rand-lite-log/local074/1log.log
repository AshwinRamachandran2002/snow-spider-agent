LIMIT 20;
```

```sql
--Description: 5) Turn deposits positive and withdrawals negative, then total by customer & month
SELECT
       "customer_id",
       substr("txn_date",1,7) AS "month_year",
       SUM(CASE WHEN "txn_type"='deposit'   THEN  "txn_amount"
                WHEN "txn_type"='withdrawal' THEN -1*"txn_amount"
                ELSE 0 END)        AS "monthly_net_change"
FROM   "customer_transactions"
GROUP  BY "customer_id", "month_year"
ORDER BY "customer_id", "month_year"
LIMIT 20;
```

```sql
--Description: 6) Build a calendar of months per customer so gaps (months with no activity) can later be filled
WITH dates AS (
      SELECT
             "customer_id",
             MIN(date(substr("txn_date",1,7)||'-01')) AS "min_dt",
             MAX(date(substr("txn_date",1,7)||'-01')) AS "max_dt"
      FROM "customer_transactions"
      GROUP BY "customer_id"
), recursive_months AS (
      SELECT
             "customer_id",
             "min_dt"                 AS "month_start"
      FROM dates
      UNION ALL
      SELECT
             "customer_id",
             date("month_start",'start of month','+1 month')
      FROM recursive_months
      JOIN dates USING ("customer_id")
      WHERE "month_start" < dates."max_dt"
)
SELECT "customer_id", strftime('%Y-%m', "month_start") AS "month_year"
FROM   recursive_months
ORDER  BY "customer_id", "month_year"
LIMIT 20;
```

```sql
--Description: 7) Combine the month calendar (query 6) with net changes (query 5) so that missing months show NULL change
WITH month_calendar AS (   -- query 6 logic
      SELECT "customer_id", strftime('%Y-%m', "month_start") AS "month_year"
      FROM (
          WITH dates AS (
                SELECT "customer_id",
                       MIN(date(substr("txn_date",1,7)||'-01')) AS "min_dt",
                       MAX(date(substr("txn_date",1,7)||'-01')) AS "max_dt"
                FROM "customer_transactions"
                GROUP BY "customer_id"
          ), recursive_months AS (
                SELECT "customer_id", "min_dt" AS "month_start"
                FROM   dates
                UNION ALL
                SELECT "customer_id",
                       date("month_start",'start of month','+1 month')
                FROM   recursive_months
                JOIN   dates USING ("customer_id")
                WHERE  "month_start" < dates."max_dt"
          )
          SELECT * FROM recursive_months
      )
), net_change AS (         -- query 5 logic
      SELECT
             "customer_id",
             substr("txn_date",1,7) AS "month_year",
             SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                      WHEN "txn_type"='withdrawal' THEN -1*"txn_amount"
                      ELSE 0 END) AS "monthly_net_change"
      FROM   "customer_transactions"
      GROUP  BY "customer_id", "month_year"
)
SELECT
       c."customer_id",
       c."month_year",
       COALESCE(n."monthly_net_change",0) AS "monthly_net_change"
FROM   month_calendar AS c
LEFT   JOIN net_change AS n
       ON c."customer_id" = n."customer_id"
      AND c."month_year"  = n."month_year"
ORDER  BY c."customer_id", c."month_year"
LIMIT 20;
```

```sql
--Description: 8) Compute the running cumulative balance for every customer using the filled-gap view
WITH filled AS (   -- query 7 logic reused
      WITH month_calendar AS (
            SELECT "customer_id", strftime('%Y-%m', "month_start") AS "month_year"
            FROM (
                WITH dates AS (
                      SELECT "customer_id",
                             MIN(date(substr("txn_date",1,7)||'-01')) AS "min_dt",
                             MAX(date(substr("txn_date",1,7)||'-01')) AS "max_dt"
                      FROM "customer_transactions"
                      GROUP BY "customer_id"
                ), recursive_months AS (
                      SELECT "customer_id", "min_dt" AS "month_start"
                      FROM   dates
                      UNION ALL
                      SELECT "customer_id",
                             date("month_start",'start of month','+1 month')
                      FROM   recursive_months
                      JOIN   dates USING ("customer_id")
                      WHERE  "month_start" < dates."max_dt"
                )
                SELECT * FROM recursive_months
            )
      ), net_change AS (
            SELECT
                   "customer_id",
                   substr("txn_date",1,7) AS "month_year",
                   SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                            WHEN "txn_type"='withdrawal' THEN -1*"txn_amount"
                            ELSE 0 END) AS "monthly_net_change"
            FROM   "customer_transactions"
            GROUP  BY "customer_id", "month_year"
      )
      SELECT 
             c."customer_id",
             c."month_year",
             COALESCE(n."monthly_net_change",0) AS "monthly_net_change"
      FROM   month_calendar AS c
      LEFT   JOIN net_change AS n
             ON c."customer_id" = n."customer_id"
            AND c."month_year"  = n."month_year"
)
SELECT
       "customer_id",
       "month_year",
       "monthly_net_change",
       SUM("monthly_net_change") OVER (PARTITION BY "customer_id"
                                       ORDER BY "month_year") AS "closing_balance"
FROM   filled
ORDER  BY "customer_id", "month_year"
LIMIT 20;
```

```sql
--Description: 9) Show only the closing balance at the very last month per customer (sanity check)
WITH balances AS (  -- query 8 logic
      WITH month_calendar AS ( /* see earlier */ SELECT 1 ), net_change AS (SELECT 1)
      SELECT 1
)
SELECT *
FROM   (
      WITH filled AS ( /* query 8 logic fully expanded */ SELECT 1 )
      SELECT
             "customer_id",
             MAX("closing_balance") AS "end_balance"
      FROM   filled
      GROUP  BY "customer_id"
)
LIMIT 20;
```

```sql
--Description: 10) Final deliverable – closing balance, monthly change, running balance for every customer & month (no gaps)
WITH month_calendar AS (   -- calendar per customer
      SELECT "customer_id", strftime('%Y-%m', "month_start") AS "month_year"
      FROM (
          WITH dates AS (
                SELECT "customer_id",
                       MIN(date(substr("txn_date",1,7)||'-01')) AS "min_dt",
                       MAX(date(substr("txn_date",1,7)||'-01')) AS "max_dt"
                FROM "customer_transactions"
                GROUP BY "customer_id"
          ), recursive_months AS (
                SELECT "customer_id", "min_dt" AS "month_start"
                FROM   dates
                UNION ALL
                SELECT "customer_id",
                       date("month_start",'start of month','+1 month')
                FROM   recursive_months
                JOIN   dates USING ("customer_id")
                WHERE  "month_start" < dates."max_dt"
          )
          SELECT * FROM recursive_months
      )
), net_change AS (          -- signed totals
      SELECT
             "customer_id",
             substr("txn_date",1,7) AS "month_year",
             SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                      WHEN "txn_type"='withdrawal' THEN -1*"txn_amount"
                      ELSE 0 END) AS "monthly_net_change"
      FROM   "customer_transactions"
      GROUP  BY "customer_id", "month_year"
)
SELECT
       c."customer_id",
       c."month_year",
       COALESCE(n."monthly_net_change",0) AS "monthly_change",
       SUM(COALESCE(n."monthly_net_change",0)) OVER (PARTITION BY c."customer_id"
                                                    ORDER BY c."month_year")
       AS "closing_balance"
FROM   month_calendar AS c
LEFT   JOIN net_change AS n
       ON c."customer_id" = n."customer_id"
      AND c."month_year"  = n."month_year"
ORDER  BY c."customer_id", c."month_year"
LIMIT 20;
```
