Query:
-- Description: 7) Produce the full grid of (customer × month) so that even
--               months with no activity are present.
WITH RECURSIVE months(month_start) AS (
     SELECT date(MIN(txn_date), 'start of month') 
     FROM   customer_transactions
     UNION ALL
     SELECT date(month_start, '+1 month')
     FROM   months
     WHERE  month_start < date((SELECT MAX(txn_date)
                                FROM   customer_transactions),
                               'start of month')
),
customers AS (
     SELECT DISTINCT customer_id
     FROM   customer_transactions
)
SELECT DISTINCT c.customer_id,
       strftime('%Y-%m', m.month_start) AS year_month
FROM   customers  AS c
CROSS  JOIN months AS m
ORDER  BY c.customer_id,
          year_month
LIMIT 20;
