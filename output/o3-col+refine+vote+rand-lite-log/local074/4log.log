LIMIT 20;
```

```sql
-- Description: 5) Aggregate each customer’s net change per month  
--               (deposits = +, withdrawals = –).
SELECT customer_id,
       substr(txn_date,1,7)                          AS year_month,
       SUM(CASE 
             WHEN txn_type = 'deposit'    THEN  txn_amount
             WHEN txn_type = 'withdrawal' THEN -txn_amount
             ELSE 0 END)                            AS monthly_change
FROM customer_transactions
GROUP BY customer_id, year_month
ORDER BY customer_id, year_month
LIMIT 20;
```

```sql
-- Description: 6) Generate every month between the earliest and latest
--               transaction-dates (recursive CTE = simple date calendar).
WITH RECURSIVE months(month_start) AS (
     SELECT date(MIN(txn_date), 'start of month') 
     FROM   customer_transactions
     UNION ALL
     SELECT date(month_start, '+1 month')
     FROM   months
     WHERE  month_start < date((SELECT MAX(txn_date)
                                FROM   customer_transactions),
                               'start of month')
)
SELECT DISTINCT month_start
FROM   months
LIMIT 20;
```

```sql
-- Description: 7) Produce the full grid of (customer × month) so that even
--               months with no activity are present.
WITH RECURSIVE months(month_start) AS (
     SELECT date(MIN(txn_date), 'start of month') 
     FROM   customer_transactions
     UNION ALL
     SELECT date(month_start, '+1 month')
     FROM   months
     WHERE  month_start < date((SELECT MAX(txn_date)
                                FROM   customer_transactions),
                               'start of month')
),
customers AS (
     SELECT DISTINCT customer_id
     FROM   customer_transactions
)
SELECT DISTINCT c.customer_id,
       strftime('%Y-%m', m.month_start) AS year_month
FROM   customers  AS c
CROSS  JOIN months AS m
ORDER  BY c.customer_id,
          year_month
LIMIT 20;
```

```sql
-- Description: 8) Overlay the monthly changes on the full grid
--               (missing months default to 0 change).
WITH RECURSIVE months(month_start) AS (
     SELECT date(MIN(txn_date), 'start of month') 
     FROM   customer_transactions
     UNION ALL
     SELECT date(month_start, '+1 month')
     FROM   months
     WHERE  month_start < date((SELECT MAX(txn_date)
                                FROM   customer_transactions),
                               'start of month')
),
customers AS (
     SELECT DISTINCT customer_id
     FROM   customer_transactions
),
month_customer AS (
     SELECT c.customer_id,
            strftime('%Y-%m', m.month_start) AS year_month
     FROM   customers c
     CROSS  JOIN months  m
),
monthly_change AS (
     SELECT customer_id,
            substr(txn_date,1,7)              AS year_month,
            SUM(CASE 
                  WHEN txn_type='deposit'     THEN  txn_amount
                  WHEN txn_type='withdrawal'  THEN -txn_amount
                  ELSE 0 END)                AS monthly_change
     FROM   customer_transactions
     GROUP  BY customer_id, year_month
)
SELECT DISTINCT mc_grid.customer_id,
       mc_grid.year_month,
       COALESCE(mchg.monthly_change,0) AS monthly_change
FROM   month_customer mc_grid
LEFT   JOIN monthly_change mchg
       ON  mc_grid.customer_id = mchg.customer_id
       AND mc_grid.year_month  = mchg.year_month
ORDER  BY mc_grid.customer_id,
          mc_grid.year_month
LIMIT 20;
```

```sql
-- Description: 9) Final report – monthly change and cumulative closing
--               balance for every customer, every month.
WITH RECURSIVE months(month_start) AS (
     SELECT date(MIN(txn_date), 'start of month') 
     FROM   customer_transactions
     UNION ALL
     SELECT date(month_start, '+1 month')
     FROM   months
     WHERE  month_start < date((SELECT MAX(txn_date)
                                FROM   customer_transactions),
                               'start of month')
),
customers AS (
     SELECT DISTINCT customer_id
     FROM   customer_transactions
),
month_customer AS (
     SELECT c.customer_id,
            strftime('%Y-%m', m.month_start) AS year_month
     FROM   customers c
     CROSS  JOIN months  m
),
monthly_change AS (
     SELECT customer_id,
            substr(txn_date,1,7)              AS year_month,
            SUM(CASE 
                  WHEN txn_type='deposit'     THEN  txn_amount
                  WHEN txn_type='withdrawal'  THEN -txn_amount
                  ELSE 0 END)                AS monthly_change
     FROM   customer_transactions
     GROUP  BY customer_id, year_month
),
grid_with_change AS (
     SELECT mc.customer_id,
            mc.year_month,
            COALESCE(mchg.monthly_change,0) AS monthly_change
     FROM   month_customer mc
     LEFT   JOIN monthly_change mchg
            ON  mc.customer_id = mchg.customer_id
            AND mc.year_month  = mchg.year_month
)
SELECT customer_id,
       year_month,
       monthly_change,
       SUM(monthly_change) OVER (PARTITION BY customer_id
                                 ORDER BY year_month) AS closing_balance
FROM   grid_with_change
ORDER  BY customer_id,
          year_month
LIMIT 20;
```
