```sql
-- 1) Distinct transaction types recorded for customers
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 2) Distinct Year-Month values that exist in the transactions table  
SELECT DISTINCT substr("txn_date",1,7) AS "year_month"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 3) Sample list of distinct customers that have any activity
SELECT DISTINCT "customer_id"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 4) Preview of single-row amounts with signed value  
--    (deposits = +amount, withdrawals = –amount)
SELECT "customer_id",
       "txn_date",
       "txn_type",
       "txn_amount",
       CASE WHEN "txn_type"='deposit'     THEN  1
            WHEN "txn_type"='withdrawal'  THEN -1
       END * "txn_amount"                AS "signed_amount"
FROM   "customer_transactions"
LIMIT 20;
```

```sql
-- 5) Net monthly change (sum of signed amounts) for every customer
SELECT "customer_id",
       date("txn_date",'start of month')     AS "month_start",
       SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                WHEN "txn_type"='withdrawal' THEN - "txn_amount"
           END)                              AS "monthly_change"
FROM   "customer_transactions"
GROUP  BY "customer_id", date("txn_date",'start of month')
LIMIT 20;
```

```sql
-- 6) Quick look at the overall date span of the data
SELECT DISTINCT
       MIN("txn_date") OVER () AS "min_txn_date",
       MAX("txn_date") OVER () AS "max_txn_date"
FROM   "customer_transactions"
LIMIT 1;
```

```sql
-- 7) Generate a continuous list of months that cover the full date range
WITH RECURSIVE all_months AS (
      SELECT date(MIN("txn_date"),'start of month') AS month_start,
             date(MAX("txn_date"),'start of month') AS month_end
      FROM   "customer_transactions"
      UNION ALL
      SELECT date(month_start,'+1 month'),
             month_end
      FROM   all_months
      WHERE  month_start < month_end
)
SELECT DISTINCT month_start
FROM   all_months
LIMIT 20;
```

```sql
-- 8) Cross-join every customer to every month (ensures “no-activity” months appear)
WITH RECURSIVE
     customers AS (SELECT DISTINCT "customer_id" FROM "customer_transactions"),
     months AS (
         SELECT date(MIN("txn_date"),'start of month') AS m,
                date(MAX("txn_date"),'start of month') AS max_m
         FROM   "customer_transactions"
         UNION ALL
         SELECT date(m,'+1 month'), max_m
         FROM   months
         WHERE  m < max_m
     )
SELECT DISTINCT c."customer_id", m.m AS "month_start"
FROM   customers c
CROSS  JOIN (SELECT m FROM months) m
LIMIT 20;
```

```sql
-- 9) Monthly change together with running (cumulative) balance  
--    – every month for every customer, including inactive months
WITH RECURSIVE
     customers AS (SELECT DISTINCT "customer_id" FROM "customer_transactions"),
     date_bounds AS (
         SELECT date(MIN("txn_date"),'start of month') AS min_m,
                date(MAX("txn_date"),'start of month') AS max_m
         FROM   "customer_transactions"),
     months AS (
         SELECT min_m AS m, max_m FROM date_bounds
         UNION ALL
         SELECT date(m,'+1 month'), max_m
         FROM   months
         WHERE  m < max_m
     ),
     customer_months AS (
         SELECT c."customer_id", m.m AS month_start
         FROM   customers c
         CROSS  JOIN (SELECT m FROM months) m
     ),
     monthly_change AS (
         SELECT "customer_id",
                date("txn_date",'start of month')   AS month_start,
                SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                         WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                    END)                            AS change_amt
         FROM   "customer_transactions"
         GROUP  BY "customer_id", date("txn_date",'start of month')
     ),
     joined AS (
         SELECT cm."customer_id",
                cm.month_start,
                COALESCE(mc.change_amt,0) AS monthly_change
         FROM   customer_months cm
         LEFT   JOIN monthly_change mc
           ON   cm."customer_id" = mc."customer_id"
          AND   cm.month_start   = mc.month_start
     )
SELECT "customer_id",
       month_start,
       monthly_change,
       SUM(monthly_change) OVER (PARTITION BY "customer_id"
                                 ORDER BY month_start
                                 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
           AS "cumulative_balance"
FROM   joined
ORDER  BY "customer_id", month_start
LIMIT 20;
```

```sql
-- 10) Same as Query-9 but narrowed to one example customer (e.g. id = 101)
SELECT *
FROM (
     /* The CTE block from Query-9 can be copied / reused here */
     WITH RECURSIVE
          customers AS (SELECT 101 AS "customer_id"),              -- pick one
          date_bounds AS (
              SELECT date(MIN("txn_date"),'start of month') AS min_m,
                     date(MAX("txn_date"),'start of month') AS max_m
              FROM   "customer_transactions"),
          months AS (
              SELECT min_m AS m, max_m FROM date_bounds
              UNION ALL
              SELECT date(m,'+1 month'), max_m
              FROM   months
              WHERE  m < max_m
          ),
          customer_months AS (
              SELECT c."customer_id", m.m AS month_start
              FROM   customers c
              CROSS  JOIN (SELECT m FROM months) m
          ),
          monthly_change AS (
              SELECT "customer_id",
                     date("txn_date",'start of month') AS month_start,
                     SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                              WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                         END)                           AS change_amt
              FROM   "customer_transactions"
              WHERE  "customer_id" = 101
              GROUP  BY "customer_id", date("txn_date",'start of month')
          ),
          joined AS (
              SELECT cm."customer_id",
                     cm.month_start,
                     COALESCE(mc.change_amt,0) AS monthly_change
              FROM   customer_months cm
              LEFT   JOIN monthly_change mc
                ON   cm."customer_id" = mc."customer_id"
               AND   cm.month_start   = mc.month_start
          )
     SELECT "customer_id",
            month_start,
            monthly_change,
            SUM(monthly_change) OVER (ORDER BY month_start) AS cumulative_balance
     FROM   joined
)
LIMIT 20;
```
