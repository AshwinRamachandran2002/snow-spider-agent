Query:
--Description: Final summary – closing balance at end of each month, monthly change, and cumulative balance
WITH
  monthly_change AS (
    SELECT "customer_id",
           substr("txn_date", 1, 7) AS "year_month",
           SUM(CASE 
                 WHEN lower("txn_type") = 'deposit'    THEN  1 * "txn_amount"
                 WHEN lower("txn_type") = 'withdrawal' THEN -1 * "txn_amount"
                 ELSE 0
               END) AS "monthly_net_change"
    FROM "customer_transactions"
    GROUP BY "customer_id", substr("txn_date", 1, 7)
  ),
  customers AS (
    SELECT DISTINCT "customer_id" FROM "customer_transactions"
  ),
  month_list("year_month") AS (
    SELECT (SELECT MIN(substr("txn_date", 1, 7)) FROM "customer_transactions")
    UNION ALL
    SELECT strftime('%Y-%m', date("year_month" || '-01', '+1 month'))
    FROM month_list
    WHERE "year_month" < (SELECT MAX(substr("txn_date", 1, 7)) FROM "customer_transactions")
  ),
  customer_month_grid AS (
    SELECT c."customer_id", m."year_month"
    FROM customers c
    CROSS JOIN month_list m
  ),
  grid_with_change AS (
    SELECT g."customer_id",
           g."year_month",
           COALESCE(mc."monthly_net_change", 0) AS "monthly_net_change"
    FROM customer_month_grid g
    LEFT JOIN monthly_change mc
      ON g."customer_id" = mc."customer_id"
     AND g."year_month" = mc."year_month"
  )
SELECT "customer_id",
       "year_month",
       "monthly_net_change",
       SUM("monthly_net_change") OVER (
            PARTITION BY "customer_id"
            ORDER BY "year_month"
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
       ) AS "closing_balance"
FROM grid_with_change
ORDER BY "customer_id", "year_month"
LIMIT 20;
