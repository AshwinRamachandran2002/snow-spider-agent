```sql
--Description: Inspect the different transaction types that exist in the customer_transactions table
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
--Description: View a sample of customer transactions with dates and amounts
SELECT "customer_id",
       "txn_date",
       "txn_type",
       "txn_amount"
FROM "customer_transactions"
ORDER BY "txn_date"
LIMIT 20;
```

```sql
--Description: List the distinct calendar months (YYYY-MM) that appear in the data
SELECT DISTINCT substr("txn_date", 1, 7) AS "year_month"
FROM "customer_transactions"
ORDER BY "year_month"
LIMIT 20;
```

```sql
--Description: Show a sample of distinct customers that appear in the data
SELECT DISTINCT "customer_id"
FROM "customer_transactions"
ORDER BY "customer_id"
LIMIT 20;
```

```sql
--Description: Calculate each customer’s net change (deposit positive, withdrawal negative) per calendar month
SELECT "customer_id",
       substr("txn_date", 1, 7) AS "year_month",
       SUM(CASE 
             WHEN lower("txn_type") = 'deposit'    THEN  1 * "txn_amount"
             WHEN lower("txn_type") = 'withdrawal' THEN -1 * "txn_amount"
             ELSE 0
           END) AS "monthly_net_change"
FROM "customer_transactions"
GROUP BY "customer_id", substr("txn_date", 1, 7)
ORDER BY "customer_id", "year_month"
LIMIT 20;
```

```sql
--Description: Determine overall date range of the transactions (first and last month in the data)
SELECT MIN(substr("txn_date", 1, 7)) AS "min_year_month",
       MAX(substr("txn_date", 1, 7)) AS "max_year_month"
FROM "customer_transactions";
```

```sql
--Description: Generate a complete list of calendar months between the global min and max month (inclusive)
WITH RECURSIVE month_list("year_month") AS (
  SELECT (SELECT MIN(substr("txn_date", 1, 7)) FROM "customer_transactions")
  UNION ALL
  SELECT strftime('%Y-%m', date("year_month" || '-01', '+1 month'))
  FROM month_list
  WHERE "year_month" < (SELECT MAX(substr("txn_date", 1, 7)) FROM "customer_transactions")
)
SELECT "year_month"
FROM month_list
ORDER BY "year_month"
LIMIT 20;
```

```sql
--Description: Create a customer-month grid so every customer has every month, even those without activity
WITH
  customers AS (
    SELECT DISTINCT "customer_id"
    FROM "customer_transactions"
  ),
  month_list("year_month") AS (
    SELECT (SELECT MIN(substr("txn_date", 1, 7)) FROM "customer_transactions")
    UNION ALL
    SELECT strftime('%Y-%m', date("year_month" || '-01', '+1 month'))
    FROM month_list
    WHERE "year_month" < (SELECT MAX(substr("txn_date", 1, 7)) FROM "customer_transactions")
  )
SELECT c."customer_id",
       m."year_month"
FROM customers AS c
CROSS JOIN month_list AS m
ORDER BY c."customer_id", m."year_month"
LIMIT 20;
```

```sql
--Description: Combine the customer-month grid with the monthly net changes (filling missing with 0)
WITH
  monthly_change AS (
    SELECT "customer_id",
           substr("txn_date", 1, 7) AS "year_month",
           SUM(CASE 
                 WHEN lower("txn_type") = 'deposit'    THEN  1 * "txn_amount"
                 WHEN lower("txn_type") = 'withdrawal' THEN -1 * "txn_amount"
                 ELSE 0
               END) AS "monthly_net_change"
    FROM "customer_transactions"
    GROUP BY "customer_id", substr("txn_date", 1, 7)
  ),
  customers AS (
    SELECT DISTINCT "customer_id" FROM "customer_transactions"
  ),
  month_list("year_month") AS (
    SELECT (SELECT MIN(substr("txn_date", 1, 7)) FROM "customer_transactions")
    UNION ALL
    SELECT strftime('%Y-%m', date("year_month" || '-01', '+1 month'))
    FROM month_list
    WHERE "year_month" < (SELECT MAX(substr("txn_date", 1, 7)) FROM "customer_transactions")
  ),
  customer_month_grid AS (
    SELECT c."customer_id", m."year_month"
    FROM customers c
    CROSS JOIN month_list m
  )
SELECT g."customer_id",
       g."year_month",
       COALESCE(mc."monthly_net_change", 0) AS "monthly_net_change"
FROM customer_month_grid AS g
LEFT JOIN monthly_change AS mc
  ON g."customer_id" = mc."customer_id"
 AND g."year_month" = mc."year_month"
ORDER BY g."customer_id", g."year_month"
LIMIT 20;
```

```sql
--Description: Final summary – closing balance at end of each month, monthly change, and cumulative balance
WITH
  monthly_change AS (
    SELECT "customer_id",
           substr("txn_date", 1, 7) AS "year_month",
           SUM(CASE 
                 WHEN lower("txn_type") = 'deposit'    THEN  1 * "txn_amount"
                 WHEN lower("txn_type") = 'withdrawal' THEN -1 * "txn_amount"
                 ELSE 0
               END) AS "monthly_net_change"
    FROM "customer_transactions"
    GROUP BY "customer_id", substr("txn_date", 1, 7)
  ),
  customers AS (
    SELECT DISTINCT "customer_id" FROM "customer_transactions"
  ),
  month_list("year_month") AS (
    SELECT (SELECT MIN(substr("txn_date", 1, 7)) FROM "customer_transactions")
    UNION ALL
    SELECT strftime('%Y-%m', date("year_month" || '-01', '+1 month'))
    FROM month_list
    WHERE "year_month" < (SELECT MAX(substr("txn_date", 1, 7)) FROM "customer_transactions")
  ),
  customer_month_grid AS (
    SELECT c."customer_id", m."year_month"
    FROM customers c
    CROSS JOIN month_list m
  ),
  grid_with_change AS (
    SELECT g."customer_id",
           g."year_month",
           COALESCE(mc."monthly_net_change", 0) AS "monthly_net_change"
    FROM customer_month_grid g
    LEFT JOIN monthly_change mc
      ON g."customer_id" = mc."customer_id"
     AND g."year_month" = mc."year_month"
  )
SELECT "customer_id",
       "year_month",
       "monthly_net_change",
       SUM("monthly_net_change") OVER (
            PARTITION BY "customer_id"
            ORDER BY "year_month"
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
       ) AS "closing_balance"
FROM grid_with_change
ORDER BY "customer_id", "year_month"
LIMIT 20;
```
