FROM "customer_transactions"
LIMIT 20;
```

```sql
-- Description: 5. Generate a complete month calendar (first day of each month) that spans the whole data range
WITH RECURSIVE m(d) AS (
  SELECT date((SELECT MIN("txn_date") FROM "customer_transactions"), 'start of month')
  UNION ALL
  SELECT date(d, '+1 month')
  FROM m
  WHERE d < date((SELECT MAX("txn_date") FROM "customer_transactions"), 'start of month')
)
SELECT strftime('%Y-%m', d) AS "month_year"
FROM m
LIMIT 20;
```

```sql
-- Description: 6. Aggregate monthly changes (deposits = +, withdrawals = −) for every customer
SELECT "customer_id",
       strftime('%Y-%m', "txn_date") AS "month_year",
       SUM(CASE 
             WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
             WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
             ELSE 0
           END)                         AS "monthly_change"
FROM   "customer_transactions"
GROUP  BY "customer_id", "month_year"
LIMIT 20;
```

```sql
-- Description: 7. Produce the customer-month matrix (every customer for every month, even if no activity)
WITH
  customers AS (SELECT DISTINCT "customer_id" FROM "customer_transactions"),
  months    AS (
      WITH RECURSIVE m(d) AS (
        SELECT date((SELECT MIN("txn_date") FROM "customer_transactions"), 'start of month')
        UNION ALL
        SELECT date(d, '+1 month') FROM m
        WHERE d < date((SELECT MAX("txn_date") FROM "customer_transactions"), 'start of month')
      )
      SELECT strftime('%Y-%m', d) AS "month_year" FROM m
  )
SELECT  c."customer_id",
        m."month_year"
FROM    customers AS c
CROSS JOIN months    AS m
ORDER  BY c."customer_id", m."month_year"
LIMIT 20;
```

```sql
-- Description: 8. Join the matrix with the monthly changes so missing months show zero activity
WITH
  customers AS (SELECT DISTINCT "customer_id" FROM "customer_transactions"),
  months    AS (
      WITH RECURSIVE m(d) AS (
        SELECT date((SELECT MIN("txn_date") FROM "customer_transactions"), 'start of month')
        UNION ALL
        SELECT date(d, '+1 month') FROM m
        WHERE d < date((SELECT MAX("txn_date") FROM "customer_transactions"), 'start of month')
      )
      SELECT strftime('%Y-%m', d) AS "month_year" FROM m
  ),
  base_grid AS (
      SELECT c."customer_id", m."month_year"
      FROM   customers AS c
      CROSS  JOIN months    AS m
  ),
  monthly_txn AS (
      SELECT "customer_id",
             strftime('%Y-%m', "txn_date") AS "month_year",
             SUM(CASE 
                   WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                   WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
                   ELSE 0
                 END) AS "monthly_change"
      FROM   "customer_transactions"
      GROUP  BY "customer_id", "month_year"
  )
SELECT bg."customer_id",
       bg."month_year",
       COALESCE(mt."monthly_change", 0) AS "monthly_change"
FROM   base_grid      AS bg
LEFT   JOIN monthly_txn AS mt
       ON bg."customer_id" = mt."customer_id"
      AND bg."month_year" = mt."month_year"
ORDER BY bg."customer_id", bg."month_year"
LIMIT 20;
```

```sql
-- Description: 9. FINAL ANSWER – closing balances at month-end, monthly change & running balance for every customer
WITH
  customers AS (SELECT DISTINCT "customer_id" FROM "customer_transactions"),
  months    AS (
      WITH RECURSIVE m(d) AS (
        SELECT date((SELECT MIN("txn_date") FROM "customer_transactions"), 'start of month')
        UNION ALL
        SELECT date(d, '+1 month') FROM m
        WHERE d < date((SELECT MAX("txn_date") FROM "customer_transactions"), 'start of month')
      )
      SELECT strftime('%Y-%m', d) AS "month_year" FROM m
  ),
  base_grid AS (
      SELECT c."customer_id", m."month_year"
      FROM   customers AS c
      CROSS  JOIN months    AS m
  ),
  monthly_txn AS (
      SELECT "customer_id",
             strftime('%Y-%m', "txn_date") AS "month_year",
             SUM(CASE 
                   WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                   WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
                   ELSE 0
                 END) AS "monthly_change"
      FROM   "customer_transactions"
      GROUP  BY "customer_id", "month_year"
  ),
  combined AS (
      SELECT bg."customer_id",
             bg."month_year",
             COALESCE(mt."monthly_change", 0) AS "monthly_change"
      FROM   base_grid      AS bg
      LEFT   JOIN monthly_txn AS mt
             ON bg."customer_id" = mt."customer_id"
            AND bg."month_year" = mt."month_year"
  )
SELECT  "customer_id",
        "month_year",
        "monthly_change",
        SUM("monthly_change") OVER (PARTITION BY "customer_id"
                                    ORDER BY "month_year") AS "closing_balance"
FROM    combined
ORDER  BY "customer_id", "month_year"
LIMIT 20;
```

```sql
-- Description: 10. (Optional deep dive) Show the first & last month + closing balance for each customer
WITH all_balances AS (
    -- re-use the “combined” CTE from Query 9
    WITH
      customers AS (SELECT DISTINCT "customer_id" FROM "customer_transactions"),
      months    AS (
          WITH RECURSIVE m(d) AS (
            SELECT date((SELECT MIN("txn_date") FROM "customer_transactions"), 'start of month')
            UNION ALL
            SELECT date(d, '+1 month') FROM m
            WHERE d < date((SELECT MAX("txn_date") FROM "customer_transactions"), 'start of month')
          )
          SELECT strftime('%Y-%m', d) AS "month_year" FROM m
      ),
      base_grid AS (
          SELECT c."customer_id", m."month_year"
          FROM   customers AS c
          CROSS  JOIN months    AS m
      ),
      monthly_txn AS (
          SELECT "customer_id",
                 strftime('%Y-%m', "txn_date") AS "month_year",
                 SUM(CASE 
                       WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                       WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
                       ELSE 0
                     END) AS "monthly_change"
          FROM   "customer_transactions"
          GROUP  BY "customer_id", "month_year"
      ),
      combined AS (
          SELECT bg."customer_id",
                 bg."month_year",
                 COALESCE(mt."monthly_change", 0) AS "monthly_change"
          FROM   base_grid      AS bg
          LEFT   JOIN monthly_txn AS mt
                 ON bg."customer_id" = mt."customer_id"
                AND bg."month_year" = mt."month_year"
      )
    SELECT  "customer_id",
            "month_year",
            "monthly_change",
            SUM("monthly_change") OVER (PARTITION BY "customer_id"
                                        ORDER BY "month_year") AS "closing_balance"
    FROM    combined
)
SELECT  "customer_id",
        MIN("month_year")  AS "first_month",
        MAX("month_year")  AS "last_month",
        MAX("closing_balance") AS "closing_balance_end_of_period"
FROM    all_balances
GROUP  BY "customer_id"
LIMIT 20;
```
