```sql
--Description: Italian country record (to get its country_id)
SELECT DISTINCT "country_id",
                "country_name"
FROM   "countries"
WHERE  "country_name" = 'Italy'
LIMIT  20;
```

```sql
--Description: Customers whose “country_id” belongs to Italy
SELECT DISTINCT c."cust_id",
                c."cust_first_name",
                c."cust_last_name",
                c."country_id"
FROM   "customers" AS c
WHERE  c."country_id" = (SELECT "country_id"
                         FROM   "countries"
                         WHERE  "country_name" = 'Italy'
                         LIMIT 1)
LIMIT  20;
```

```sql
--Description: Calendar dates that fall in December-2021
SELECT DISTINCT "time_id"
FROM   "times"
WHERE  "calendar_year"       = 2021
AND    "calendar_month_number" = 12
LIMIT  20;
```

```sql
--Description: Sales rows for Italian customers in December-2021
SELECT DISTINCT s."cust_id",
                s."prod_id",
                s."time_id",
                s."quantity_sold",
                s."amount_sold"
FROM   "sales"      AS s
JOIN   "customers"  AS cu ON cu."cust_id"   = s."cust_id"
JOIN   "countries"  AS co ON co."country_id"= cu."country_id"
JOIN   "times"      AS t  ON t."time_id"    = s."time_id"
WHERE  co."country_name"        = 'Italy'
AND    t."calendar_year"        = 2021
AND    t."calendar_month_number"= 12
LIMIT  20;
```

```sql
--Description: Matching cost details for the filtered sales rows
SELECT DISTINCT s."prod_id",
                s."time_id",
                s."channel_id",
                s."promo_id",
                s."quantity_sold",
                cst."unit_cost",
                cst."unit_price"
FROM   "sales"     AS s
JOIN   "customers" AS cu  ON cu."cust_id"    = s."cust_id"
JOIN   "countries" AS co  ON co."country_id" = cu."country_id"
JOIN   "times"     AS t   ON t."time_id"     = s."time_id"
JOIN   "costs"     AS cst ON cst."prod_id"   = s."prod_id"
                         AND cst."time_id"   = s."time_id"
                         AND cst."promo_id"  = s."promo_id"
                         AND cst."channel_id"= s."channel_id"
WHERE  co."country_name"        = 'Italy'
AND    t."calendar_year"        = 2021
AND    t."calendar_month_number"= 12
LIMIT  20;
```

```sql
--Description: Profit per individual sales line for Italian customers (Dec-2021)
SELECT DISTINCT s."cust_id",
       (s."quantity_sold" * (cst."unit_price" - cst."unit_cost")) AS "profit"
FROM   "sales"     AS s
JOIN   "customers" AS cu  ON cu."cust_id"    = s."cust_id"
JOIN   "countries" AS co  ON co."country_id" = cu."country_id"
JOIN   "times"     AS t   ON t."time_id"     = s."time_id"
JOIN   "costs"     AS cst ON cst."prod_id"   = s."prod_id"
                         AND cst."time_id"   = s."time_id"
                         AND cst."promo_id"  = s."promo_id"
                         AND cst."channel_id"= s."channel_id"
WHERE  co."country_name"        = 'Italy'
AND    t."calendar_year"        = 2021
AND    t."calendar_month_number"= 12
LIMIT  20;
```

```sql
--Description: Aggregate total December-2021 profit per Italian customer
SELECT DISTINCT "cust_id",
                SUM("profit") AS "total_profit"
FROM (
      SELECT s."cust_id",
             (s."quantity_sold" * (cst."unit_price" - cst."unit_cost")) AS "profit"
      FROM   "sales"     AS s
      JOIN   "customers" AS cu  ON cu."cust_id"    = s."cust_id"
      JOIN   "countries" AS co  ON co."country_id" = cu."country_id"
      JOIN   "times"     AS t   ON t."time_id"     = s."time_id"
      JOIN   "costs"     AS cst ON cst."prod_id"   = s."prod_id"
                               AND cst."time_id"   = s."time_id"
                               AND cst."promo_id"  = s."promo_id"
                               AND cst."channel_id"= s."channel_id"
      WHERE  co."country_name"        = 'Italy'
      AND    t."calendar_year"        = 2021
      AND    t."calendar_month_number"= 12
) AS profits
GROUP BY "cust_id"
LIMIT  20;
```

```sql
--Description: Place customers into ten profit-based tiers (NTILE = 10)
SELECT DISTINCT "cust_id",
                "total_profit",
                NTILE(10) OVER (ORDER BY "total_profit" DESC) AS "profit_tier"
FROM (
      SELECT "cust_id",
             SUM("profit") AS "total_profit"
      FROM (
            SELECT s."cust_id",
                   (s."quantity_sold" * (cst."unit_price" - cst."unit_cost")) AS "profit"
            FROM   "sales"     AS s
            JOIN   "customers" AS cu  ON cu."cust_id"    = s."cust_id"
            JOIN   "countries" AS co  ON co."country_id" = cu."country_id"
            JOIN   "times"     AS t   ON t."time_id"     = s."time_id"
            JOIN   "costs"     AS cst ON cst."prod_id"   = s."prod_id"
                                     AND cst."time_id"   = s."time_id"
                                     AND cst."promo_id"  = s."promo_id"
                                     AND cst."channel_id"= s."channel_id"
            WHERE  co."country_name"        = 'Italy'
            AND    t."calendar_year"        = 2021
            AND    t."calendar_month_number"= 12
      )
      GROUP BY "cust_id"
) AS customer_profits
LIMIT  20;
```

```sql
--Description: FINAL ANSWER – highest & lowest profits in each of the ten tiers
SELECT DISTINCT "profit_tier",
                MIN("total_profit") AS "lowest_profit",
                MAX("total_profit") AS "highest_profit"
FROM (
      SELECT "cust_id",
             "total_profit",
             NTILE(10) OVER (ORDER BY "total_profit" DESC) AS "profit_tier"
      FROM (
            SELECT "cust_id",
                   SUM("profit") AS "total_profit"
            FROM (
                  SELECT s."cust_id",
                         (s."quantity_sold" * (cst."unit_price" - cst."unit_cost")) AS "profit"
                  FROM   "sales"     AS s
                  JOIN   "customers" AS cu  ON cu."cust_id"    = s."cust_id"
                  JOIN   "countries" AS co  ON co."country_id" = cu."country_id"
                  JOIN   "times"     AS t   ON t."time_id"     = s."time_id"
                  JOIN   "costs"     AS cst ON cst."prod_id"   = s."prod_id"
                                           AND cst."time_id"   = s."time_id"
                                           AND cst."promo_id"  = s."promo_id"
                                           AND cst."channel_id"= s."channel_id"
                  WHERE  co."country_name"        = 'Italy'
                  AND    t."calendar_year"        = 2021
                  AND    t."calendar_month_number"= 12
            )
            GROUP BY "cust_id"
      )
)
GROUP BY "profit_tier"
ORDER BY "profit_tier"
LIMIT  20;
```
