```sql
-- Description: 1)  Find the country_id that corresponds to Italy.           
SELECT DISTINCT c.country_id, c.country_name, c.country_iso_code
FROM countries AS c
WHERE c.country_iso_code = 'IT'
LIMIT 20;
```

```sql
-- Description: 2)  List a few Italian customers to verify the link via country_id (= 52770 for Italy).  
SELECT DISTINCT cu.cust_id, cu.cust_first_name, cu.cust_last_name, cu.country_id
FROM customers AS cu
WHERE cu.country_id = 52770
LIMIT 20;
```

```sql
-- Description: 3)  Pull a sample of December-2021 sales made by those Italian customers.                
SELECT DISTINCT s.*
FROM   sales      AS s
JOIN   customers  AS cu  ON cu.cust_id = s.cust_id
WHERE  cu.country_id = 52770
  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- Description: 4)  Show how the matching cost rows look for those sales (they share 
--                 prod_id, time_id, channel_id, promo_id).                           
SELECT DISTINCT co.*
FROM   costs  AS co
JOIN   sales  AS s
       ON  s.prod_id   = co.prod_id
       AND s.time_id   = co.time_id
       AND s.channel_id= co.channel_id
       AND s.promo_id  = co.promo_id
JOIN   customers AS cu ON cu.cust_id = s.cust_id
WHERE  cu.country_id = 52770
  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- Description: 5)  Compute profit per individual sales row for Italian customers
--                 in December-2021 (amount_sold – unit_cost*quantity_sold).          
SELECT DISTINCT
       s.cust_id,
       s.prod_id,
       s.time_id,
       (s.amount_sold - co.unit_cost * s.quantity_sold)  AS profit
FROM   sales AS s
JOIN   costs AS co
       ON  co.prod_id = s.prod_id
       AND co.time_id = s.time_id
       AND co.channel_id = s.channel_id
       AND co.promo_id  = s.promo_id
JOIN   customers AS cu ON cu.cust_id = s.cust_id
WHERE  cu.country_id = 52770
  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- Description: 6)  Aggregate to total December-2021 profit per Italian customer.    
SELECT
       s.cust_id,
       SUM(s.amount_sold - co.unit_cost * s.quantity_sold) AS dec21_profit
FROM   sales AS s
JOIN   costs AS co
       ON  co.prod_id = s.prod_id
       AND co.time_id = s.time_id
       AND co.channel_id = s.channel_id
       AND co.promo_id  = s.promo_id
JOIN   customers AS cu ON cu.cust_id = s.cust_id
WHERE  cu.country_id = 52770
  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
GROUP  BY s.cust_id
LIMIT 20;
```

```sql
-- Description: 7)  Display the overall min & max December-2021 profit among 
--                 Italian customers (sanity check before tiering).                 
SELECT 
       MIN(dec21_profit) AS lowest_profit,
       MAX(dec21_profit) AS highest_profit
FROM (
    SELECT s.cust_id,
           SUM(s.amount_sold - co.unit_cost * s.quantity_sold) AS dec21_profit
    FROM   sales AS s
    JOIN   costs AS co
           ON  co.prod_id = s.prod_id
           AND co.time_id = s.time_id
           AND co.channel_id = s.channel_id
           AND co.promo_id  = s.promo_id
    JOIN   customers AS cu ON cu.cust_id = s.cust_id
    WHERE  cu.country_id = 52770
      AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
    GROUP  BY s.cust_id
);
```

```sql
-- Description: 8)  Assign each Italian customer to one of ten equal-sized profit tiers 
--                 using NTILE(10); show tier plus customer profit.                  
SELECT
       cust_id,
       dec21_profit,
       NTILE(10) OVER(ORDER BY dec21_profit) AS tier
FROM (
    SELECT s.cust_id,
           SUM(s.amount_sold - co.unit_cost * s.quantity_sold) AS dec21_profit
    FROM   sales AS s
    JOIN   costs AS co
           ON  co.prod_id = s.prod_id
           AND co.time_id = s.time_id
           AND co.channel_id = s.channel_id
           AND co.promo_id  = s.promo_id
    JOIN   customers AS cu ON cu.cust_id = s.cust_id
    WHERE  cu.country_id = 52770
      AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
    GROUP  BY s.cust_id
)
LIMIT 20;
```

```sql
-- Description: 9)  For each tier, return its highest and lowest customer profit.     
SELECT
       tier,
       MIN(dec21_profit) AS tier_lowest_profit,
       MAX(dec21_profit) AS tier_highest_profit
FROM (
    SELECT
           cust_id,
           dec21_profit,
           NTILE(10) OVER(ORDER BY dec21_profit) AS tier
    FROM (
        SELECT s.cust_id,
               SUM(s.amount_sold - co.unit_cost * s.quantity_sold) AS dec21_profit
        FROM   sales AS s
        JOIN   costs AS co
               ON  co.prod_id = s.prod_id
               AND co.time_id = s.time_id
               AND co.channel_id = s.channel_id
               AND co.promo_id  = s.promo_id
        JOIN   customers AS cu ON cu.cust_id = s.cust_id
        WHERE  cu.country_id = 52770
          AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
        GROUP  BY s.cust_id
    )
)
GROUP  BY tier
ORDER  BY tier;
```

```sql
-- Description: 10)  Final concise answer: highest & lowest December-2021 profits
--                   per each of the ten evenly-sized tiers for Italian customers.   
SELECT
       tier                                        AS "profit_decile",
       MIN(dec21_profit)                           AS "lowest_profit_in_tier",
       MAX(dec21_profit)                           AS "highest_profit_in_tier"
FROM (
    SELECT
           cust_id,
           dec21_profit,
           NTILE(10) OVER (ORDER BY dec21_profit)  AS tier
    FROM (
        SELECT
               s.cust_id,
               SUM(s.amount_sold - co.unit_cost * s.quantity_sold) AS dec21_profit
        FROM   sales AS s
        JOIN   costs AS co
               ON  co.prod_id   = s.prod_id
               AND co.time_id   = s.time_id
               AND co.channel_id= s.channel_id
               AND co.promo_id  = s.promo_id
        JOIN   customers AS cu ON cu.cust_id = s.cust_id
        WHERE  cu.country_id = 52770                          -- Italy
          AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31' -- December-2021
        GROUP  BY s.cust_id
    )
)
GROUP BY tier
ORDER BY tier;
```
