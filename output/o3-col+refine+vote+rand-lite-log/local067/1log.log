Query:
-- Description: 5)  Compute profit per individual sales row for Italian customers
--                 in December-2021 (amount_sold – unit_cost*quantity_sold).          
SELECT DISTINCT
       s.cust_id,
       s.prod_id,
       s.time_id,
       (s.amount_sold - co.unit_cost * s.quantity_sold)  AS profit
FROM   sales AS s
JOIN   costs AS co
       ON  co.prod_id = s.prod_id
       AND co.time_id = s.time_id
       AND co.channel_id = s.channel_id
       AND co.promo_id  = s.promo_id
JOIN   customers AS cu ON cu.cust_id = s.cust_id
WHERE  cu.country_id = 52770
  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
