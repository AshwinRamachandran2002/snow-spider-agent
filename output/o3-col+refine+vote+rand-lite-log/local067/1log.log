-- Description: 7)  Display the overall min & max December-2021 profit among 
--                 Italian customers (sanity check before tiering).                 
SELECT 
       MIN(dec21_profit) AS lowest_profit,
       MAX(dec21_profit) AS highest_profit
FROM (
    SELECT s.cust_id,
           SUM(s.amount_sold - co.unit_cost * s.quantity_sold) AS dec21_profit
    FROM   sales AS s
    JOIN   costs AS co
           ON  co.prod_id = s.prod_id
           AND co.time_id = s.time_id
           AND co.channel_id = s.channel_id
           AND co.promo_id  = s.promo_id
    JOIN   customers AS cu ON cu.cust_id = s.cust_id
    WHERE  cu.country_id = 52770
      AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
    GROUP  BY s.cust_id
);
