-- Description: 9)  For each tier, return its highest and lowest customer profit.     
SELECT
       tier,
       MIN(dec21_profit) AS tier_lowest_profit,
       MAX(dec21_profit) AS tier_highest_profit
FROM (
    SELECT
           cust_id,
           dec21_profit,
           NTILE(10) OVER(ORDER BY dec21_profit) AS tier
    FROM (
        SELECT s.cust_id,
               SUM(s.amount_sold - co.unit_cost * s.quantity_sold) AS dec21_profit
        FROM   sales AS s
        JOIN   costs AS co
               ON  co.prod_id = s.prod_id
               AND co.time_id = s.time_id
               AND co.channel_id = s.channel_id
               AND co.promo_id  = s.promo_id
        JOIN   customers AS cu ON cu.cust_id = s.cust_id
        WHERE  cu.country_id = 52770
          AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
        GROUP  BY s.cust_id
    )
)
GROUP  BY tier
ORDER  BY tier;
