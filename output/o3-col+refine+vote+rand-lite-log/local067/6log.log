--Description: 7) Assign each Italian customer to one of 10 profit-based tiers
SELECT  cust_id,
        profit_dec_2021,
        NTILE(10) OVER (ORDER BY profit_dec_2021 DESC) AS profit_tier
FROM   (
        SELECT   c.cust_id,
                 SUM(s.amount_sold - s.quantity_sold * cs.unit_cost) AS profit_dec_2021
        FROM     sales  AS s
        JOIN     costs  AS cs
               ON cs.prod_id   = s.prod_id
              AND cs.time_id   = s.time_id
              AND cs.channel_id= s.channel_id
              AND cs.promo_id  = s.promo_id
        JOIN     customers AS c   ON s.cust_id  = c.cust_id
        JOIN     countries AS co  ON c.country_id = co.country_id
        WHERE    co.country_name = 'Italy'
          AND    s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
        GROUP BY c.cust_id
       )
LIMIT 20;
