```sql
--Description: 1) Fetch the country_id that represents Italy
SELECT DISTINCT country_id, country_name
FROM countries
WHERE country_name = 'Italy'
LIMIT 20;
```

```sql
--Description: 2) Show a sample of Italian customers (cust_id + name)
SELECT DISTINCT c.cust_id,
       c.cust_first_name,
       c.cust_last_name
FROM customers AS c
JOIN countries  AS co
  ON c.country_id = co.country_id
WHERE co.country_name = 'Italy'
LIMIT 20;
```

```sql
--Description: 3) List December-2021 sales rows that belong to Italian customers
SELECT DISTINCT s.prod_id,
       s.cust_id,
       s.time_id,
       s.quantity_sold,
       s.amount_sold
FROM   sales      AS s
JOIN   customers  AS c   ON s.cust_id  = c.cust_id
JOIN   countries  AS co  ON c.country_id = co.country_id
WHERE  co.country_name = 'Italy'
  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: 4) Pull matching cost records for those same sales (sample)
SELECT DISTINCT s.prod_id,
       s.time_id,
       s.channel_id,
       s.promo_id,
       cs.unit_cost
FROM   sales AS s
JOIN   costs AS cs
  ON   cs.prod_id   = s.prod_id
 AND   cs.time_id   = s.time_id
 AND   cs.channel_id= s.channel_id
 AND   cs.promo_id  = s.promo_id
JOIN   customers AS c   ON s.cust_id  = c.cust_id
JOIN   countries AS co  ON c.country_id = co.country_id
WHERE  co.country_name = 'Italy'
  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: 5) Compute profit per sales line for Italian customers in Dec-2021
SELECT DISTINCT s.cust_id,
       s.time_id,
       (s.amount_sold - s.quantity_sold * cs.unit_cost) AS profit_line
FROM   sales  AS s
JOIN   costs  AS cs
  ON   cs.prod_id   = s.prod_id
 AND   cs.time_id   = s.time_id
 AND   cs.channel_id= s.channel_id
 AND   cs.promo_id  = s.promo_id
JOIN   customers AS c   ON s.cust_id  = c.cust_id
JOIN   countries AS co  ON c.country_id = co.country_id
WHERE  co.country_name = 'Italy'
  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: 6) Aggregate total December-2021 profit per Italian customer
SELECT   c.cust_id,
         SUM(s.amount_sold - s.quantity_sold * cs.unit_cost) AS profit_dec_2021
FROM     sales  AS s
JOIN     costs  AS cs
       ON cs.prod_id   = s.prod_id
      AND cs.time_id   = s.time_id
      AND cs.channel_id= s.channel_id
      AND cs.promo_id  = s.promo_id
JOIN     customers AS c   ON s.cust_id  = c.cust_id
JOIN     countries AS co  ON c.country_id = co.country_id
WHERE    co.country_name = 'Italy'
  AND    s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
GROUP BY c.cust_id
LIMIT 20;
```

```sql
--Description: 7) Assign each Italian customer to one of 10 profit-based tiers
SELECT  cust_id,
        profit_dec_2021,
        NTILE(10) OVER (ORDER BY profit_dec_2021 DESC) AS profit_tier
FROM   (
        SELECT   c.cust_id,
                 SUM(s.amount_sold - s.quantity_sold * cs.unit_cost) AS profit_dec_2021
        FROM     sales  AS s
        JOIN     costs  AS cs
               ON cs.prod_id   = s.prod_id
              AND cs.time_id   = s.time_id
              AND cs.channel_id= s.channel_id
              AND cs.promo_id  = s.promo_id
        JOIN     customers AS c   ON s.cust_id  = c.cust_id
        JOIN     countries AS co  ON c.country_id = co.country_id
        WHERE    co.country_name = 'Italy'
          AND    s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
        GROUP BY c.cust_id
       )
LIMIT 20;
```

```sql
--Description: 8) For every tier, return the highest & lowest profits (final answer)
SELECT  profit_tier,
        MAX(profit_dec_2021) AS highest_profit,
        MIN(profit_dec_2021) AS lowest_profit
FROM   (
        SELECT  cust_id,
                profit_dec_2021,
                NTILE(10) OVER (ORDER BY profit_dec_2021 DESC) AS profit_tier
        FROM   (
                SELECT   c.cust_id,
                         SUM(s.amount_sold - s.quantity_sold * cs.unit_cost) AS profit_dec_2021
                FROM     sales  AS s
                JOIN     costs  AS cs
                       ON cs.prod_id   = s.prod_id
                      AND cs.time_id   = s.time_id
                      AND cs.channel_id= s.channel_id
                      AND cs.promo_id  = s.promo_id
                JOIN     customers AS c   ON s.cust_id  = c.cust_id
                JOIN     countries AS co  ON c.country_id = co.country_id
                WHERE    co.country_name = 'Italy'
                  AND    s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
                GROUP BY c.cust_id
               )
       )
GROUP BY profit_tier
ORDER BY profit_tier;
```

```sql
--Description: 9) Same as #8, but also include how many customers fall in each tier
SELECT  profit_tier,
        COUNT(*)                      AS customers_in_tier,
        MAX(profit_dec_2021)          AS highest_profit,
        MIN(profit_dec_2021)          AS lowest_profit
FROM   (
        SELECT  cust_id,
                profit_dec_2021,
                NTILE(10) OVER (ORDER BY profit_dec_2021 DESC) AS profit_tier
        FROM   (
                SELECT   c.cust_id,
                         SUM(s.amount_sold - s.quantity_sold * cs.unit_cost) AS profit_dec_2021
                FROM     sales  AS s
                JOIN     costs  AS cs
                       ON cs.prod_id   = s.prod_id
                      AND cs.time_id   = s.time_id
                      AND cs.channel_id= s.channel_id
                      AND cs.promo_id  = s.promo_id
                JOIN     customers AS c   ON s.cust_id  = c.cust_id
                JOIN     countries AS co  ON c.country_id = co.country_id
                WHERE    co.country_name = 'Italy'
                  AND    s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
                GROUP BY c.cust_id
               )
       )
GROUP BY profit_tier
ORDER BY profit_tier
LIMIT 20;
```

These nine queries progress from identifying Italian customers to computing their December-2021 profits, assigning them to ten equal tiers, and finally reporting the highest and lowest profit values within each tier.
