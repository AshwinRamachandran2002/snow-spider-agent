```sql
--Description: Take a look at December-2021 sales records that belong to Italian customers
SELECT *
FROM   sales
WHERE  cust_id IN (SELECT cust_id
                   FROM   customers
                   WHERE  country_id IN (SELECT country_id 
                                          FROM   countries 
                                          WHERE  country_name = 'Italy'))
  AND  time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: Join sales with costs so we can calculate profit for each individual sale
SELECT s.cust_id,
       s.prod_id,
       s.time_id,
       s.quantity_sold,
       s.amount_sold,
       c.unit_cost,
       (s.amount_sold - s.quantity_sold * c.unit_cost) AS profit
FROM   sales  AS s
JOIN   costs  AS c
       ON  s.prod_id = c.prod_id
       AND s.time_id = c.time_id
WHERE  s.cust_id IN (SELECT cust_id
                     FROM   customers
                     WHERE  country_id IN (SELECT country_id 
                                            FROM   countries 
                                            WHERE  country_name = 'Italy'))
  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: Aggregate total December-2021 profit for every Italian customer
SELECT s.cust_id,
       SUM(s.amount_sold - s.quantity_sold * c.unit_cost) AS total_profit_dec2021
FROM   sales  AS s
JOIN   costs  AS c
       ON  s.prod_id = c.prod_id
       AND s.time_id = c.time_id
WHERE  s.cust_id IN (SELECT cust_id
                     FROM   customers
                     WHERE  country_id IN (SELECT country_id 
                                            FROM   countries 
                                            WHERE  country_name = 'Italy'))
  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
GROUP  BY s.cust_id
ORDER  BY total_profit_dec2021 DESC
LIMIT 20;
```

```sql
--Description: Put each Italian customer into one of ten profit tiers (deciles)
SELECT cust_id,
       total_profit_dec2021,
       NTILE(10) OVER (ORDER BY total_profit_dec2021 DESC) AS profit_decile
FROM  (
        SELECT s.cust_id,
               SUM(s.amount_sold - s.quantity_sold * c.unit_cost) AS total_profit_dec2021
        FROM   sales  AS s
        JOIN   costs  AS c
               ON  s.prod_id = c.prod_id
               AND s.time_id = c.time_id
        WHERE  s.cust_id IN (SELECT cust_id
                             FROM   customers
                             WHERE  country_id IN (SELECT country_id 
                                                    FROM   countries 
                                                    WHERE  country_name = 'Italy'))
          AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
        GROUP  BY s.cust_id
      ) AS t
LIMIT 20;
```

```sql
--Description: Highest December-2021 profit inside each profit decile
SELECT profit_decile,
       MAX(total_profit_dec2021) AS highest_profit
FROM  (
        SELECT cust_id,
               total_profit_dec2021,
               NTILE(10) OVER (ORDER BY total_profit_dec2021 DESC) AS profit_decile
        FROM  (
                SELECT s.cust_id,
                       SUM(s.amount_sold - s.quantity_sold * c.unit_cost) AS total_profit_dec2021
                FROM   sales  AS s
                JOIN   costs  AS c
                       ON  s.prod_id = c.prod_id
                       AND s.time_id = c.time_id
                WHERE  s.cust_id IN (SELECT cust_id
                                     FROM   customers
                                     WHERE  country_id IN (SELECT country_id 
                                                            FROM   countries 
                                                            WHERE  country_name = 'Italy'))
                  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
                GROUP  BY s.cust_id
              )
      ) AS deciles
GROUP BY profit_decile
ORDER BY profit_decile
LIMIT 20;
```

```sql
--Description: Lowest December-2021 profit inside each profit decile
SELECT profit_decile,
       MIN(total_profit_dec2021) AS lowest_profit
FROM  (
        SELECT cust_id,
               total_profit_dec2021,
               NTILE(10) OVER (ORDER BY total_profit_dec2021 DESC) AS profit_decile
        FROM  (
                SELECT s.cust_id,
                       SUM(s.amount_sold - s.quantity_sold * c.unit_cost) AS total_profit_dec2021
                FROM   sales  AS s
                JOIN   costs  AS c
                       ON  s.prod_id = c.prod_id
                       AND s.time_id = c.time_id
                WHERE  s.cust_id IN (SELECT cust_id
                                     FROM   customers
                                     WHERE  country_id IN (SELECT country_id 
                                                            FROM   countries 
                                                            WHERE  country_name = 'Italy'))
                  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
                GROUP  BY s.cust_id
              )
      ) AS deciles
GROUP BY profit_decile
ORDER BY profit_decile
LIMIT 20;
```

```sql
--Description: Show, per tier, both the highest and lowest profits in one consolidated result
SELECT profit_decile,
       MIN(total_profit_dec2021) AS lowest_profit,
       MAX(total_profit_dec2021) AS highest_profit
FROM  (
        SELECT cust_id,
               total_profit_dec2021,
               NTILE(10) OVER (ORDER BY total_profit_dec2021 DESC) AS profit_decile
        FROM  (
                SELECT s.cust_id,
                       SUM(s.amount_sold - s.quantity_sold * c.unit_cost) AS total_profit_dec2021
                FROM   sales  AS s
                JOIN   costs  AS c
                       ON  s.prod_id = c.prod_id
                       AND s.time_id = c.time_id
                WHERE  s.cust_id IN (SELECT cust_id
                                     FROM   customers
                                     WHERE  country_id IN (SELECT country_id 
                                                            FROM   countries 
                                                            WHERE  country_name = 'Italy'))
                  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
                GROUP  BY s.cust_id
              )
      ) AS deciles
GROUP BY profit_decile
ORDER BY profit_decile
LIMIT 20;
```

```sql
--Description: Attach customer names to their tier and profit for easy interpretation
SELECT d.profit_decile,
       d.total_profit_dec2021,
       c.cust_first_name || ' ' || c.cust_last_name AS customer_name
FROM  (
        SELECT cust_id,
               total_profit_dec2021,
               NTILE(10) OVER (ORDER BY total_profit_dec2021 DESC) AS profit_decile
        FROM  (
                SELECT s.cust_id,
                       SUM(s.amount_sold - s.quantity_sold * c.unit_cost) AS total_profit_dec2021
                FROM   sales  AS s
                JOIN   costs  AS c
                       ON  s.prod_id = c.prod_id
                       AND s.time_id = c.time_id
                WHERE  s.cust_id IN (SELECT cust_id
                                     FROM   customers
                                     WHERE  country_id IN (SELECT country_id 
                                                            FROM   countries 
                                                            WHERE  country_name = 'Italy'))
                  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
                GROUP  BY s.cust_id
              )
      ) AS d
JOIN   customers AS c
       ON d.cust_id = c.cust_id
LIMIT 20;
