        FROM  (
                SELECT s.cust_id,
                       SUM(s.amount_sold - s.quantity_sold * c.unit_cost) AS total_profit_dec2021
                FROM   sales  AS s
                JOIN   costs  AS c
                       ON  s.prod_id = c.prod_id
