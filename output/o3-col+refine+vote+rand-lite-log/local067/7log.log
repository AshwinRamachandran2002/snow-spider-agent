Query:
--Description: Join sales with costs so we can calculate profit for each individual sale
SELECT s.cust_id,
       s.prod_id,
       s.time_id,
       s.quantity_sold,
       s.amount_sold,
       c.unit_cost,
       (s.amount_sold - s.quantity_sold * c.unit_cost) AS profit
FROM   sales  AS s
JOIN   costs  AS c
       ON  s.prod_id = c.prod_id
       AND s.time_id = c.time_id
WHERE  s.cust_id IN (SELECT cust_id
                     FROM   customers
                     WHERE  country_id IN (SELECT country_id 
                                            FROM   countries 
                                            WHERE  country_name = 'Italy'))
  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
