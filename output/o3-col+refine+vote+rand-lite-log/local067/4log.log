```sql
--Description: Identify the internal key for Italy in the countries reference table.  
SELECT DISTINCT "country_id", "country_name"
FROM "countries"
WHERE "country_name" = 'Italy'
LIMIT 20;
```

```sql
--Description: List every customer that belongs to Italy.  
SELECT DISTINCT cu."cust_id"
FROM "customers" AS cu
JOIN "countries" AS co
  ON cu."country_id" = co."country_id"
WHERE co."country_name" = 'Italy'
LIMIT 20;
```

```sql
--Description: Show all December-2021 sales rows generated by Italian customers.  
SELECT DISTINCT s.*
FROM "sales"  AS s
WHERE s."cust_id" IN (
        SELECT cu."cust_id"
        FROM "customers" AS cu
        JOIN "countries"  AS co
          ON cu."country_id" = co."country_id"
        WHERE co."country_name" = 'Italy')
  AND s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: Display the matching cost records for those December-2021 Italian sales.  
SELECT DISTINCT c.*
FROM "costs" AS c
WHERE c."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
  AND (c."prod_id", c."time_id") IN (
        SELECT s."prod_id", s."time_id"
        FROM "sales" AS s
        WHERE s."cust_id" IN (
              SELECT cu."cust_id"
              FROM "customers" AS cu
              JOIN "countries"  AS co
                ON cu."country_id" = co."country_id"
              WHERE co."country_name" = 'Italy')
          AND s."time_id" BETWEEN '2021-12-01' AND '2021-12-31')
LIMIT 20;
```

```sql
--Description: Compute profit for each individual December-2021 sale line (revenue – cost).  
SELECT DISTINCT s."cust_id",
       (s."amount_sold" - c."unit_cost" * s."quantity_sold") AS "profit"
FROM "sales" AS s
JOIN "costs" AS c
  ON s."prod_id" = c."prod_id"
 AND s."time_id" = c."time_id"
WHERE s."cust_id" IN (
        SELECT cu."cust_id"
        FROM "customers" AS cu
        JOIN "countries"  AS co
          ON cu."country_id" = co."country_id"
        WHERE co."country_name" = 'Italy')
  AND s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: Aggregate total December-2021 profit for every Italian customer.  
SELECT DISTINCT s."cust_id",
       SUM(s."amount_sold" - c."unit_cost" * s."quantity_sold") AS "total_profit"
FROM "sales" AS s
JOIN "costs" AS c
  ON s."prod_id" = c."prod_id"
 AND s."time_id" = c."time_id"
WHERE s."cust_id" IN (
        SELECT cu."cust_id"
        FROM "customers" AS cu
        JOIN "countries"  AS co
          ON cu."country_id" = co."country_id"
        WHERE co."country_name" = 'Italy')
  AND s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
GROUP BY s."cust_id"
LIMIT 20;
```

```sql
--Description: Place each Italian customer into one of ten profit tiers (deciles).  
WITH "profit_per_cust" AS (
     SELECT s."cust_id",
            SUM(s."amount_sold" - c."unit_cost" * s."quantity_sold") AS "total_profit"
     FROM "sales" AS s
     JOIN "costs" AS c
       ON s."prod_id" = c."prod_id"
      AND s."time_id" = c."time_id"
     WHERE s."cust_id" IN (
             SELECT cu."cust_id"
             FROM "customers" AS cu
             JOIN "countries"  AS co
               ON cu."country_id" = co."country_id"
             WHERE co."country_name" = 'Italy')
       AND s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
     GROUP BY s."cust_id")
SELECT DISTINCT "cust_id",
       "total_profit",
       NTILE(10) OVER (ORDER BY "total_profit" DESC) AS "profit_tier"
FROM "profit_per_cust"
ORDER BY "total_profit" DESC
LIMIT 20;
```

```sql
--Description: For each tier, derive the highest and lowest customer profit values.  
WITH "profit_per_cust" AS (
     SELECT s."cust_id",
            SUM(s."amount_sold" - c."unit_cost" * s."quantity_sold") AS "total_profit"
     FROM "sales" AS s
     JOIN "costs" AS c
       ON s."prod_id" = c."prod_id"
      AND s."time_id" = c."time_id"
     WHERE s."cust_id" IN (
             SELECT cu."cust_id"
             FROM "customers" AS cu
             JOIN "countries"  AS co
               ON cu."country_id" = co."country_id"
             WHERE co."country_name" = 'Italy')
       AND s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
     GROUP BY s."cust_id"),
"tiered" AS (
     SELECT "cust_id",
            "total_profit",
            NTILE(10) OVER (ORDER BY "total_profit" DESC) AS "profit_tier"
     FROM "profit_per_cust")
SELECT DISTINCT "profit_tier",
       MAX("total_profit") AS "highest_profit",
       MIN("total_profit") AS "lowest_profit"
FROM "tiered"
GROUP BY "profit_tier"
ORDER BY "profit_tier"
LIMIT 20;
```

```sql
--Description: (Optional check) Show complete tier summary across all ten deciles (no LIMIT).  
WITH "profit_per_cust" AS (
     SELECT s."cust_id",
            SUM(s."amount_sold" - c."unit_cost" * s."quantity_sold") AS "total_profit"
     FROM "sales" AS s
     JOIN "costs" AS c
       ON s."prod_id" = c."prod_id"
      AND s."time_id" = c."time_id"
     WHERE s."cust_id" IN (
             SELECT cu."cust_id"
             FROM "customers" AS cu
             JOIN "countries"  AS co
               ON cu."country_id" = co."country_id"
             WHERE co."country_name" = 'Italy')
       AND s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
     GROUP BY s."cust_id"),
"tiered" AS (
     SELECT "cust_id",
            "total_profit",
            NTILE(10) OVER (ORDER BY "total_profit" DESC) AS "profit_tier"
     FROM "profit_per_cust")
SELECT DISTINCT "profit_tier",
       MAX("total_profit") AS "highest_profit",
       MIN("total_profit") AS "lowest_profit"
FROM "tiered"
GROUP BY "profit_tier"
ORDER BY "profit_tier";
```

