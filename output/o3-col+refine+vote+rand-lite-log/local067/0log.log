Below is a progressive set of (≤ 10) SQL statements, each limited to 20 rows and annotated so you can follow how to get “highest and lowest profits for Italian customers segmented into ten evenly-divided tiers based on their December-2021 sales profits”.

```sql
-- 1️⃣ Description: Find Italy’s country_id so we can isolate Italian customers
SELECT DISTINCT country_id, country_name
FROM countries
WHERE country_name = 'Italy'
LIMIT 20;
```

```sql
-- 2️⃣ Description: Show a few customers whose country_id matches Italy
SELECT DISTINCT cust_id, cust_first_name, cust_last_name, country_id
FROM customers
WHERE country_id IN (SELECT country_id FROM countries WHERE country_name = 'Italy')
LIMIT 20;
```

```sql
-- 3️⃣ Description: List sample December-2021 sales made by Italian customers
SELECT s.prod_id, s.cust_id, s.time_id, s.channel_id, s.promo_id,
       s.quantity_sold, s.amount_sold
FROM   sales AS s
JOIN   customers AS c  ON c.cust_id = s.cust_id
WHERE  c.country_id IN (SELECT country_id FROM countries WHERE country_name = 'Italy')
  AND  s.time_id LIKE '2021-12%'
LIMIT 20;
```

```sql
-- 4️⃣ Description: Look at matching cost rows for the same prod/time/channel/promo
SELECT DISTINCT c.prod_id, c.time_id, c.channel_id, c.promo_id,
       c.unit_cost, c.unit_price
FROM   costs AS c
WHERE  c.time_id LIKE '2021-12%'
LIMIT 20;
```

```sql
-- 5️⃣ Description: Compute profit for each individual December-2021 sale
SELECT s.prod_id, s.cust_id, s.time_id,
       (s.amount_sold - s.quantity_sold * co.unit_cost) AS profit
FROM   sales  AS s
JOIN   customers AS cu ON cu.cust_id  = s.cust_id
JOIN   costs     AS co ON co.prod_id  = s.prod_id
                      AND co.time_id  = s.time_id
                      AND co.channel_id = s.channel_id
                      AND co.promo_id   = s.promo_id
WHERE  cu.country_id IN (SELECT country_id FROM countries WHERE country_name = 'Italy')
  AND  s.time_id LIKE '2021-12%'
LIMIT 20;
```

```sql
-- 6️⃣ Description: Aggregate to total December-2021 profit per Italian customer
SELECT s.cust_id,
       SUM(s.amount_sold - s.quantity_sold * co.unit_cost) AS dec2021_profit
FROM   sales  AS s
JOIN   customers AS cu ON cu.cust_id  = s.cust_id
JOIN   costs     AS co ON co.prod_id  = s.prod_id
                      AND co.time_id  = s.time_id
                      AND co.channel_id = s.channel_id
                      AND co.promo_id   = s.promo_id
WHERE  cu.country_id IN (SELECT country_id FROM countries WHERE country_name = 'Italy')
  AND  s.time_id LIKE '2021-12%'
GROUP BY s.cust_id
LIMIT 20;
```

```sql
-- 7️⃣ Description: Place those customers into 10 evenly-sized profit tiers (deciles)
SELECT cust_id,
       dec2021_profit,
       NTILE(10) OVER (ORDER BY dec2021_profit DESC) AS profit_decile
FROM (
    SELECT s.cust_id,
           SUM(s.amount_sold - s.quantity_sold * co.unit_cost) AS dec2021_profit
    FROM   sales  AS s
    JOIN   customers AS cu ON cu.cust_id  = s.cust_id
    JOIN   costs     AS co ON co.prod_id  = s.prod_id
                          AND co.time_id  = s.time_id
                          AND co.channel_id = s.channel_id
                          AND co.promo_id   = s.promo_id
    WHERE  cu.country_id IN (SELECT country_id FROM countries WHERE country_name = 'Italy')
      AND  s.time_id LIKE '2021-12%'
    GROUP BY s.cust_id
) AS profits
LIMIT 20;
```

```sql
-- 8️⃣ Description: For each decile, show the highest & lowest customer profits
SELECT profit_decile,
       MAX(dec2021_profit) AS highest_profit,
       MIN(dec2021_profit) AS lowest_profit
FROM (
    SELECT cust_id,
           dec2021_profit,
           NTILE(10) OVER (ORDER BY dec2021_profit DESC) AS profit_decile
    FROM (
        SELECT s.cust_id,
               SUM(s.amount_sold - s.quantity_sold * co.unit_cost) AS dec2021_profit
        FROM   sales  AS s
        JOIN   customers AS cu ON cu.cust_id  = s.cust_id
        JOIN   costs     AS co ON co.prod_id  = s.prod_id
                              AND co.time_id  = s.time_id
                              AND co.channel_id = s.channel_id
                              AND co.promo_id   = s.promo_id
        WHERE  cu.country_id IN (SELECT country_id FROM countries WHERE country_name = 'Italy')
          AND  s.time_id LIKE '2021-12%'
        GROUP BY s.cust_id
    ) AS profits
) AS tiered
GROUP BY profit_decile
ORDER BY profit_decile
LIMIT 20;
```

These eight queries progressively • identify Italian customers • gather their December-2021 sales • join costs to compute profit • aggregate profit per customer • divide customers into ten equal-sized deciles • and finally display the highest and lowest profit figures in each tier.
