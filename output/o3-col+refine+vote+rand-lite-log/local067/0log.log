-- 7️⃣ Description: Place those customers into 10 evenly-sized profit tiers (deciles)
SELECT cust_id,
       dec2021_profit,
       NTILE(10) OVER (ORDER BY dec2021_profit DESC) AS profit_decile
FROM (
    SELECT s.cust_id,
           SUM(s.amount_sold - s.quantity_sold * co.unit_cost) AS dec2021_profit
    FROM   sales  AS s
    JOIN   customers AS cu ON cu.cust_id  = s.cust_id
    JOIN   costs     AS co ON co.prod_id  = s.prod_id
                          AND co.time_id  = s.time_id
                          AND co.channel_id = s.channel_id
                          AND co.promo_id   = s.promo_id
    WHERE  cu.country_id IN (SELECT country_id FROM countries WHERE country_name = 'Italy')
      AND  s.time_id LIKE '2021-12%'
    GROUP BY s.cust_id
) AS profits
LIMIT 20;
