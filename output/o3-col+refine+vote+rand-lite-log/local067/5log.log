```sql
-- Description: Preview December-2021 sales rows that belong to Italian customers  
SELECT s.*
FROM   sales      AS s
JOIN   customers  AS c  ON c.cust_id = s.cust_id
JOIN   countries  AS co ON co.country_id = c.country_id
WHERE  co.country_name LIKE 'Ital%'
  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- Description: Join sales with costs to compute profit for each Italian sale in Dec-2021  
SELECT s.cust_id,
       s.prod_id,
       s.time_id,
       s.quantity_sold,
       s.amount_sold,
       (s.amount_sold - s.quantity_sold * ct.unit_cost) AS profit
FROM   sales AS s
JOIN   costs AS ct
       ON  ct.prod_id    = s.prod_id
       AND ct.time_id    = s.time_id
       AND ct.channel_id = s.channel_id
       AND ct.promo_id   = s.promo_id
JOIN   customers  AS cu ON cu.cust_id   = s.cust_id
JOIN   countries  AS co ON co.country_id = cu.country_id
WHERE  co.country_name LIKE 'Ital%'
  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- Description: Calculate total December-2021 profit per Italian customer  
SELECT s.cust_id,
       SUM(s.amount_sold - s.quantity_sold * ct.unit_cost) AS total_profit
FROM   sales AS s
JOIN   costs AS ct
       ON  ct.prod_id    = s.prod_id
       AND ct.time_id    = s.time_id
       AND ct.channel_id = s.channel_id
       AND ct.promo_id   = s.promo_id
JOIN   customers  AS cu ON cu.cust_id   = s.cust_id
JOIN   countries  AS co ON co.country_id = cu.country_id
WHERE  co.country_name LIKE 'Ital%'
  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
GROUP BY s.cust_id
LIMIT 20;
```

```sql
-- Description: Attach each Italian customer to one of 10 evenly-sized profit tiers  
SELECT cust_id,
       total_profit,
       NTILE(10) OVER (ORDER BY total_profit) AS profit_tier
FROM (
      SELECT s.cust_id,
             SUM(s.amount_sold - s.quantity_sold * ct.unit_cost) AS total_profit
      FROM   sales AS s
      JOIN   costs AS ct
             ON  ct.prod_id    = s.prod_id
             AND ct.time_id    = s.time_id
             AND ct.channel_id = s.channel_id
             AND ct.promo_id   = s.promo_id
      JOIN   customers  AS cu ON cu.cust_id   = s.cust_id
      JOIN   countries  AS co ON co.country_id = cu.country_id
      WHERE  co.country_name LIKE 'Ital%'
        AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
      GROUP BY s.cust_id
     )
LIMIT 20;
```

```sql
-- Description: Final answer – highest & lowest profits in each of the 10 tiers for Italian customers’ Dec-2021 sales  
SELECT profit_tier,
       MIN(total_profit) AS lowest_profit,
       MAX(total_profit) AS highest_profit
FROM (
      SELECT cust_id,
             total_profit,
             NTILE(10) OVER (ORDER BY total_profit) AS profit_tier
      FROM (
            SELECT s.cust_id,
                   SUM(s.amount_sold - s.quantity_sold * ct.unit_cost) AS total_profit
            FROM   sales AS s
            JOIN   costs AS ct
                   ON  ct.prod_id    = s.prod_id
                   AND ct.time_id    = s.time_id
                   AND ct.channel_id = s.channel_id
                   AND ct.promo_id   = s.promo_id
            JOIN   customers  AS cu ON cu.cust_id   = s.cust_id
            JOIN   countries  AS co ON co.country_id = cu.country_id
            WHERE  co.country_name LIKE 'Ital%'
              AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
            GROUP BY s.cust_id
           )
     )
GROUP BY profit_tier
ORDER BY profit_tier;
```
