Query:
-- Description: Join sales with costs to compute profit for each Italian sale in Dec-2021  
SELECT s.cust_id,
       s.prod_id,
       s.time_id,
       s.quantity_sold,
       s.amount_sold,
       (s.amount_sold - s.quantity_sold * ct.unit_cost) AS profit
FROM   sales AS s
JOIN   costs AS ct
       ON  ct.prod_id    = s.prod_id
       AND ct.time_id    = s.time_id
       AND ct.channel_id = s.channel_id
       AND ct.promo_id   = s.promo_id
JOIN   customers  AS cu ON cu.cust_id   = s.cust_id
JOIN   countries  AS co ON co.country_id = cu.country_id
WHERE  co.country_name LIKE 'Ital%'
  AND  s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
