```sql
-- 2.  See the helmet‐related strings recorded in the primary safety-equipment field
SELECT DISTINCT "party_safety_equipment_1"
FROM "parties"
WHERE "statewide_vehicle_type" LIKE '%motorcycle%'
LIMIT 20;
```

```sql
-- 3.  …and in the secondary safety-equipment field
SELECT DISTINCT "party_safety_equipment_2"
FROM "parties"
WHERE "statewide_vehicle_type" LIKE '%motorcycle%'
LIMIT 20;
```

```sql
-- 4.  Check how many motorcycle parties are marked as “at-fault” (quick sanity-check)
SELECT "at_fault", COUNT(*) AS n_parties
FROM "parties"
WHERE "statewide_vehicle_type" LIKE '%motorcycle%'
GROUP BY "at_fault"
LIMIT 20;
```

```sql
-- 5.  List the injury-severity codes that appear in the victims table
SELECT DISTINCT "victim_degree_of_injury"
FROM "victims"
LIMIT 20;
```

```sql
-- 6.  Tie victims to parties (by case_id & party_number) to make sure we can
--     identify motorcyclist victims and their helmet usage
SELECT v."id" AS victim_id,
       v."victim_degree_of_injury",
       p."statewide_vehicle_type",
       p."party_safety_equipment_1",
       p."party_safety_equipment_2"
FROM   "victims"  AS v
JOIN   "parties"  AS p
       ON v."case_id" = p."case_id"
      AND v."party_number" = p."party_number"
WHERE  p."statewide_vehicle_type" LIKE '%motorcycle%'
LIMIT 20;
```

```sql
-- 7.  Verify that the collision-level flag (“motorcycle_collision”) matches
--     the presence of motorcycle parties
SELECT c."case_id",
       c."motorcycle_collision",
       COUNT(p."id") AS motorcycle_parties
FROM   "collisions" AS c
LEFT JOIN "parties" AS p
       ON c."case_id" = p."case_id"
      AND p."statewide_vehicle_type" LIKE '%motorcycle%'
GROUP BY c."case_id", c."motorcycle_collision"
LIMIT 20;
```

```sql
-- 8.  Pick out motorcycle collisions together with helmet usage (yes/no inferred
--     from safety-equipment strings) – initial inspection
SELECT DISTINCT p."party_safety_equipment_1"
FROM   "collisions" AS c
JOIN   "parties"     AS p
       ON c."case_id" = p."case_id"
WHERE  c."motorcycle_collision" = 1
  AND  p."statewide_vehicle_type" LIKE '%motorcycle%'
LIMIT 20;
```

```sql
-- 9.  Extract collisions involving motorcycle fatalities
--     (victim_degree_of_injury LIKE '%fatal%')
SELECT DISTINCT v."case_id"
FROM   "victims"  AS v
JOIN   "parties"  AS p
       ON v."case_id" = p."case_id"
      AND v."party_number" = p."party_number"
WHERE  p."statewide_vehicle_type" LIKE '%motorcycle%'
  AND  v."victim_degree_of_injury" LIKE '%fatal%'
LIMIT 20;
```

```sql
-- 10.  Quick count of all motorcycle collisions split by “helmet” versus “no helmet”
--      (helmet strings are fuzzy-matched here for exploration purposes)
SELECT
       CASE
         WHEN (p."party_safety_equipment_1"  LIKE '%helmet%'
            OR p."party_safety_equipment_2" LIKE '%helmet%')
              THEN 'helmet_used'
         ELSE 'no_helmet'
       END                                       AS helmet_flag,
       COUNT(DISTINCT c."case_id")               AS collisions
FROM   "collisions" AS c
JOIN   "parties"     AS p
       ON c."case_id" = p."case_id"
WHERE  p."statewide_vehicle_type" LIKE '%motorcycle%'
GROUP  BY helmet_flag
LIMIT 20;
```
