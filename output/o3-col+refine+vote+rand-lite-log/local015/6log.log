-- 6.  Tie victims to parties (by case_id & party_number) to make sure we can
--     identify motorcyclist victims and their helmet usage
SELECT v."id" AS victim_id,
       v."victim_degree_of_injury",
       p."statewide_vehicle_type",
       p."party_safety_equipment_1",
       p."party_safety_equipment_2"
FROM   "victims"  AS v
JOIN   "parties"  AS p
       ON v."case_id" = p."case_id"
      AND v."party_number" = p."party_number"
WHERE  p."statewide_vehicle_type" LIKE '%motorcycle%'
LIMIT 20;
