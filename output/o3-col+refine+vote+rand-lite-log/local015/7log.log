```sql
-- 1) Inspect the kinds of safety-equipment codes recorded for motorcyclists
SELECT DISTINCT "party_safety_equipment_1"
FROM "parties"
WHERE "statewide_vehicle_type" LIKE '%motorcycle%'
LIMIT 20;
```

```sql
-- 2) Inspect the optional second safety-equipment field for exactly the same group
SELECT DISTINCT "party_safety_equipment_2"
FROM "parties"
WHERE "statewide_vehicle_type" LIKE '%motorcycle%'
LIMIT 20;
```

```sql
-- 3) Confirm the values that mark a vehicle as a motorcycle
SELECT DISTINCT "statewide_vehicle_type"
FROM "parties"
WHERE "statewide_vehicle_type" LIKE '%motorcycle%'
LIMIT 20;
```

```sql
-- 4) How many total collisions are flagged as motorcycle collisions?
SELECT COUNT(DISTINCT "case_id") AS total_motorcycle_collisions
FROM "collisions"
WHERE "motorcycle_collision" = 1;
```

```sql
-- 5) All motorcycle-collision case_ids where at least one motorcyclist was
--    reported as wearing a helmet
SELECT DISTINCT c."case_id"
FROM   "collisions" AS c
JOIN   "parties"    AS p
       ON p."case_id" = c."case_id"
WHERE  c."motorcycle_collision" = 1
  AND  p."statewide_vehicle_type" LIKE '%motorcycle%'
  AND (p."party_safety_equipment_1" LIKE '%helmet%'
       OR p."party_safety_equipment_2" LIKE '%helmet%')
LIMIT 20;
```

```sql
-- 6) All motorcycle-collision case_ids where at least one motorcyclist was
--    reported as NOT wearing a helmet
SELECT DISTINCT c."case_id"
FROM   "collisions" AS c
JOIN   "parties"    AS p
       ON p."case_id" = c."case_id"
WHERE  c."motorcycle_collision" = 1
  AND  p."statewide_vehicle_type" LIKE '%motorcycle%'
  AND ( (p."party_safety_equipment_1" NOT LIKE '%helmet%' OR p."party_safety_equipment_1" IS NULL)
        AND
        (p."party_safety_equipment_2" NOT LIKE '%helmet%' OR p."party_safety_equipment_2" IS NULL) )
LIMIT 20;
```

```sql
-- 7) Compute collisions-with-helmet stats: number of collisions and total killed
SELECT
       COUNT(DISTINCT c."case_id")                   AS collisions_with_helmet,
       SUM(c."motorcyclist_killed_count")            AS killed_with_helmet
FROM   "collisions" AS c
WHERE  c."motorcycle_collision" = 1
  AND  c."case_id" IN (
        SELECT p."case_id"
        FROM   "parties" AS p
        WHERE  p."statewide_vehicle_type" LIKE '%motorcycle%'
          AND (p."party_safety_equipment_1" LIKE '%helmet%'
               OR p."party_safety_equipment_2" LIKE '%helmet%')
);
```

```sql
-- 8) Compute collisions-without-helmet stats and turn them into percentages
WITH helmet AS (
       SELECT
              COUNT(DISTINCT c."case_id")  AS coll_helmet,
              SUM(c."motorcyclist_killed_count") AS kill_helmet
       FROM   "collisions" c
       WHERE  c."motorcycle_collision" = 1
         AND  c."case_id" IN (
                SELECT p."case_id"
                FROM   "parties" p
                WHERE  p."statewide_vehicle_type" LIKE '%motorcycle%'
                  AND (p."party_safety_equipment_1" LIKE '%helmet%'
                       OR p."party_safety_equipment_2" LIKE '%helmet%')
       )
), no_helmet AS (
       SELECT
              COUNT(DISTINCT c."case_id")  AS coll_no,
              SUM(c."motorcyclist_killed_count") AS kill_no
       FROM   "collisions" c
       WHERE  c."motorcycle_collision" = 1
         AND  c."case_id" IN (
                SELECT p."case_id"
                FROM   "parties" p
                WHERE  p."statewide_vehicle_type" LIKE '%motorcycle%'
                  AND ( (p."party_safety_equipment_1" NOT LIKE '%helmet%' OR p."party_safety_equipment_1" IS NULL)
                        AND
                        (p."party_safety_equipment_2" NOT LIKE '%helmet%' OR p."party_safety_equipment_2" IS NULL) )
       )
)
SELECT
       ROUND(100.0 * kill_helmet / coll_helmet, 2) AS pct_fatal_helmet,
       ROUND(100.0 * kill_no     / coll_no,     2) AS pct_fatal_no_helmet
FROM   helmet, no_helmet;
```

Each successive query builds understanding of helmet-coding, identifies the two groups of collisions, and finally calculates the fatality rate for (1) motorcyclists wearing helmets and (2) motorcyclists not wearing helmets.
