Query:
-- Description: Count of motorcycle-collision case_ids where at least one rider was
-- recorded as wearing a helmet (“helmet … used” in either safety-equipment column).
SELECT COUNT(DISTINCT p."case_id") AS "helmet_collisions"
FROM "parties" AS p
WHERE p."statewide_vehicle_type" LIKE '%motorcycle%'
  AND (p."party_safety_equipment_1" LIKE '%helmet%used%'
       OR p."party_safety_equipment_2" LIKE '%helmet%used%');
