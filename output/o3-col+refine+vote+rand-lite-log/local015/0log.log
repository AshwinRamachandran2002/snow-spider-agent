```sql
-- Description: Look at the different labels that appear in the primary safety-equipment
-- field which contain the word “helmet” (to see how helmet usage is coded).
SELECT DISTINCT "party_safety_equipment_1"
FROM "parties"
WHERE "party_safety_equipment_1" LIKE '%helmet%'
LIMIT 20;
```

```sql
-- Description: Same inspection for the secondary safety-equipment field.
SELECT DISTINCT "party_safety_equipment_2"
FROM "parties"
WHERE "party_safety_equipment_2" LIKE '%helmet%'
LIMIT 20;
```

```sql
-- Description: Check the wording used for a motor-cyclist in the vehicle-type column.
SELECT DISTINCT "statewide_vehicle_type"
FROM "parties"
WHERE "statewide_vehicle_type" LIKE '%motorcycle%'
LIMIT 20;
```

```sql
-- Description: Count of motorcycle-collision case_ids where at least one rider was
-- recorded as wearing a helmet (“helmet … used” in either safety-equipment column).
SELECT COUNT(DISTINCT p."case_id") AS "helmet_collisions"
FROM "parties" AS p
WHERE p."statewide_vehicle_type" LIKE '%motorcycle%'
  AND (p."party_safety_equipment_1" LIKE '%helmet%used%'
       OR p."party_safety_equipment_2" LIKE '%helmet%used%');
```

```sql
-- Description: Count of motorcycle-collision case_ids where NO rider was recorded
-- as wearing a helmet (“helmet … not used”, or no helmet fields at all).
SELECT COUNT(DISTINCT p."case_id") AS "no_helmet_collisions"
FROM "parties" AS p
WHERE p."statewide_vehicle_type" LIKE '%motorcycle%'
  AND (p."party_safety_equipment_1" LIKE '%helmet%not%'
       OR p."party_safety_equipment_2" LIKE '%helmet%not%'
       OR (p."party_safety_equipment_1" IS NULL
           AND p."party_safety_equipment_2" IS NULL));
```

```sql
-- Description: Total number of motor-cyclist fatalities that occurred in the
-- helmet-collision set found above.
SELECT SUM(c."motorcyclist_killed_count") AS "helmet_fatalities"
FROM "collisions"  AS c
JOIN (
      SELECT DISTINCT "case_id"
      FROM "parties"
      WHERE "statewide_vehicle_type" LIKE '%motorcycle%'
        AND ("party_safety_equipment_1" LIKE '%helmet%used%'
             OR "party_safety_equipment_2" LIKE '%helmet%used%')
     ) AS h
ON c."case_id" = h."case_id";
```

```sql
-- Description: Total number of motor-cyclist fatalities that occurred in the
-- no-helmet collision set.
SELECT SUM(c."motorcyclist_killed_count") AS "no_helmet_fatalities"
FROM "collisions"  AS c
JOIN (
      SELECT DISTINCT "case_id"
      FROM "parties"
      WHERE "statewide_vehicle_type" LIKE '%motorcycle%'
        AND ("party_safety_equipment_1" LIKE '%helmet%not%'
             OR "party_safety_equipment_2" LIKE '%helmet%not%'
             OR ("party_safety_equipment_1" IS NULL
                 AND "party_safety_equipment_2" IS NULL))
     ) AS nh
ON c."case_id" = nh."case_id";
```

```sql
-- Description: Final calculation – fatality rate (%) for motorcycle collisions
-- with helmets vs without helmets.
SELECT
  ROUND(100.0 * helmet_grp.total_killed / helmet_grp.total_collisions, 2)
        AS "helmet_fatality_rate_pct",
  ROUND(100.0 * no_helmet_grp.total_killed / no_helmet_grp.total_collisions, 2)
        AS "no_helmet_fatality_rate_pct"
FROM
  ( SELECT COUNT(DISTINCT p."case_id") AS total_collisions,
           SUM(c."motorcyclist_killed_count") AS total_killed
    FROM "parties"     AS p
    JOIN "collisions"  AS c  ON p."case_id" = c."case_id"
    WHERE p."statewide_vehicle_type" LIKE '%motorcycle%'
      AND (p."party_safety_equipment_1" LIKE '%helmet%used%'
           OR p."party_safety_equipment_2" LIKE '%helmet%used%')
  ) AS helmet_grp,
  ( SELECT COUNT(DISTINCT p."case_id") AS total_collisions,
           SUM(c."motorcyclist_killed_count") AS total_killed
    FROM "parties"     AS p
    JOIN "collisions"  AS c  ON p."case_id" = c."case_id"
    WHERE p."statewide_vehicle_type" LIKE '%motorcycle%'
      AND (p."party_safety_equipment_1" LIKE '%helmet%not%'
           OR p."party_safety_equipment_2" LIKE '%helmet%not%'
           OR (p."party_safety_equipment_1" IS NULL
               AND p."party_safety_equipment_2" IS NULL))
  ) AS no_helmet_grp;
```
