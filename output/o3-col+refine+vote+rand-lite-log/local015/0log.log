-- Description: Final calculation – fatality rate (%) for motorcycle collisions
-- with helmets vs without helmets.
SELECT
  ROUND(100.0 * helmet_grp.total_killed / helmet_grp.total_collisions, 2)
        AS "helmet_fatality_rate_pct",
  ROUND(100.0 * no_helmet_grp.total_killed / no_helmet_grp.total_collisions, 2)
        AS "no_helmet_fatality_rate_pct"
FROM
  ( SELECT COUNT(DISTINCT p."case_id") AS total_collisions,
           SUM(c."motorcyclist_killed_count") AS total_killed
    FROM "parties"     AS p
    JOIN "collisions"  AS c  ON p."case_id" = c."case_id"
    WHERE p."statewide_vehicle_type" LIKE '%motorcycle%'
      AND (p."party_safety_equipment_1" LIKE '%helmet%used%'
           OR p."party_safety_equipment_2" LIKE '%helmet%used%')
  ) AS helmet_grp,
  ( SELECT COUNT(DISTINCT p."case_id") AS total_collisions,
           SUM(c."motorcyclist_killed_count") AS total_killed
    FROM "parties"     AS p
    JOIN "collisions"  AS c  ON p."case_id" = c."case_id"
    WHERE p."statewide_vehicle_type" LIKE '%motorcycle%'
      AND (p."party_safety_equipment_1" LIKE '%helmet%not%'
           OR p."party_safety_equipment_2" LIKE '%helmet%not%'
           OR (p."party_safety_equipment_1" IS NULL
