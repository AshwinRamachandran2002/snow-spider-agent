Query:
-- Description: Total number of motor-cyclist fatalities that occurred in the
-- helmet-collision set found above.
SELECT SUM(c."motorcyclist_killed_count") AS "helmet_fatalities"
FROM "collisions"  AS c
JOIN (
      SELECT DISTINCT "case_id"
      FROM "parties"
      WHERE "statewide_vehicle_type" LIKE '%motorcycle%'
        AND ("party_safety_equipment_1" LIKE '%helmet%used%'
             OR "party_safety_equipment_2" LIKE '%helmet%used%')
     ) AS h
ON c."case_id" = h."case_id";
