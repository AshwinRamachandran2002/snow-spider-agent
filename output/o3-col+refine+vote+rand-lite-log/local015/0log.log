Query:
-- Description: Count of motorcycle-collision case_ids where NO rider was recorded
-- as wearing a helmet (“helmet … not used”, or no helmet fields at all).
SELECT COUNT(DISTINCT p."case_id") AS "no_helmet_collisions"
FROM "parties" AS p
WHERE p."statewide_vehicle_type" LIKE '%motorcycle%'
  AND (p."party_safety_equipment_1" LIKE '%helmet%not%'
       OR p."party_safety_equipment_2" LIKE '%helmet%not%'
       OR (p."party_safety_equipment_1" IS NULL
           AND p."party_safety_equipment_2" IS NULL));
