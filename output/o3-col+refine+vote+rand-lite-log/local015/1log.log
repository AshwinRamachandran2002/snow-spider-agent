Query:
-- 7) Aggregate motorcycle collisions by helmet usage
--    (helmet_used vs helmet_not_used), counting collisions & fatalities
SELECT
       CASE
            WHEN LOWER(p."party_safety_equipment_1") LIKE '%helmet%used%' 
              OR LOWER(p."party_safety_equipment_2") LIKE '%helmet%used%'
                 THEN 'helmet_used'
            WHEN LOWER(p."party_safety_equipment_1") LIKE '%helmet%not%used%' 
              OR LOWER(p."party_safety_equipment_2") LIKE '%helmet%not%used%'
                 THEN 'helmet_not_used'
       END                                            AS "helmet_usage",
       COUNT(DISTINCT c."case_id")                    AS "collision_count",
       SUM(c."motorcyclist_killed_count")             AS "total_motorcyclist_killed"
FROM   "collisions" AS c
JOIN   "parties"     AS p
       ON c."case_id" = p."case_id"
WHERE  p."statewide_vehicle_type" LIKE '%motorcycle%'
  AND  (LOWER(p."party_safety_equipment_1") LIKE '%helmet%'
        OR LOWER(p."party_safety_equipment_2") LIKE '%helmet%')
GROUP  BY "helmet_usage";
Answer:
helmet_usage,collision_count,total_motorcyclist_killed
helmet_used,19,3
Query:
-- 8) Convert the previous aggregates into fatality-rate percentages
--    (fatalities per 100 collisions) for easy comparison
SELECT
       t."helmet_usage",
       100.0 * t."total_motorcyclist_killed" / t."collision_count" 
            AS "fatality_rate_percent"
FROM (
        SELECT
               CASE
                    WHEN LOWER(p."party_safety_equipment_1") LIKE '%helmet%used%' 
                      OR LOWER(p."party_safety_equipment_2") LIKE '%helmet%used%'
                         THEN 'helmet_used'
                    WHEN LOWER(p."party_safety_equipment_1") LIKE '%helmet%not%used%' 
                      OR LOWER(p."party_safety_equipment_2") LIKE '%helmet%not%used%'
                         THEN 'helmet_not_used'
               END                                   AS "helmet_usage",
               COUNT(DISTINCT c."case_id")           AS "collision_count",
               SUM(c."motorcyclist_killed_count")    AS "total_motorcyclist_killed"
        FROM   "collisions" AS c
        JOIN   "parties"     AS p
               ON c."case_id" = p."case_id"
        WHERE  p."statewide_vehicle_type" LIKE '%motorcycle%'
          AND  (LOWER(p."party_safety_equipment_1") LIKE '%helmet%'
                OR LOWER(p."party_safety_equipment_2") LIKE '%helmet%')
        GROUP  BY "helmet_usage"
     ) t;
