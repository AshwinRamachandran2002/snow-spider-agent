Query:
-- Description: Classify each collision that involves a motorcycle party into
-- “helmet” vs “no-helmet”, then aggregate fatalities and counts,
-- and finally compute the fatality rate for each group
WITH moto_parties           AS (
       SELECT DISTINCT case_id,
              CASE
                 WHEN LOWER(COALESCE(party_safety_equipment_1,'')) LIKE '%helmet%' 
                      OR LOWER(COALESCE(party_safety_equipment_2,'')) LIKE '%helmet%' 
                 THEN 1       -- helmet used
                 ELSE 0       -- no helmet recorded
              END AS helmet_flag
       FROM parties
       WHERE statewide_vehicle_type LIKE '%motorcycle%'
),
classified_collisions      AS (
       SELECT c.case_id,
              m.helmet_flag,
              c.motorcyclist_killed_count
       FROM collisions AS c
       JOIN moto_parties AS m
         ON c.case_id = m.case_id
)
SELECT helmet_flag         AS helmet_used,
       COUNT(*)            AS collisions_in_group,
       SUM(COALESCE(motorcyclist_killed_count,0)) AS killed_total,
       ROUND(100.0 * SUM(COALESCE(motorcyclist_killed_count,0))
                  / COUNT(*), 2)  AS fatality_rate_pct
FROM classified_collisions
GROUP BY helmet_flag
LIMIT 20;
