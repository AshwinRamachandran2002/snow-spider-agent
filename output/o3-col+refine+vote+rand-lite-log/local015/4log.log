Query:
-- Description: Join motorcycle parties to their collision record so we can see equipment together with deaths
SELECT p.case_id,
       p.party_number,
       p.party_safety_equipment_1,
       c.motorcyclist_killed_count
FROM parties AS p
JOIN collisions AS c
  ON p.case_id = c.case_id
WHERE p.statewide_vehicle_type LIKE '%motorcycle%'
LIMIT 20;
