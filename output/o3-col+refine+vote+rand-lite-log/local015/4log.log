FROM parties
WHERE statewide_vehicle_type LIKE '%motorcycle%'
LIMIT 20;
```

```sql
-- Description: Inspect some motorcycle parties together with both safety–equipment columns
SELECT case_id,
       party_number,
       party_type,
       party_safety_equipment_1,
       party_safety_equipment_2
FROM parties
WHERE statewide_vehicle_type LIKE '%motorcycle%'
LIMIT 20;
```

```sql
-- Description: Look at the fatality counters stored in the collisions table that concern motorcyclists
SELECT case_id,
       collision_severity,
       motorcyclist_killed_count,
       motorcyclist_injured_count
FROM collisions
WHERE motorcyclist_killed_count IS NOT NULL
LIMIT 20;
```

```sql
-- Description: Join motorcycle parties to their collision record so we can see equipment together with deaths
SELECT p.case_id,
       p.party_number,
       p.party_safety_equipment_1,
       c.motorcyclist_killed_count
FROM parties AS p
JOIN collisions AS c
  ON p.case_id = c.case_id
WHERE p.statewide_vehicle_type LIKE '%motorcycle%'
LIMIT 20;
```

```sql
-- Description: Classify each collision that involves a motorcycle party into
-- “helmet” vs “no-helmet”, then aggregate fatalities and counts,
-- and finally compute the fatality rate for each group
WITH moto_parties           AS (
       SELECT DISTINCT case_id,
              CASE
                 WHEN LOWER(COALESCE(party_safety_equipment_1,'')) LIKE '%helmet%' 
                      OR LOWER(COALESCE(party_safety_equipment_2,'')) LIKE '%helmet%' 
                 THEN 1       -- helmet used
                 ELSE 0       -- no helmet recorded
              END AS helmet_flag
       FROM parties
       WHERE statewide_vehicle_type LIKE '%motorcycle%'
),
classified_collisions      AS (
       SELECT c.case_id,
              m.helmet_flag,
              c.motorcyclist_killed_count
       FROM collisions AS c
       JOIN moto_parties AS m
         ON c.case_id = m.case_id
)
SELECT helmet_flag         AS helmet_used,
       COUNT(*)            AS collisions_in_group,
       SUM(COALESCE(motorcyclist_killed_count,0)) AS killed_total,
       ROUND(100.0 * SUM(COALESCE(motorcyclist_killed_count,0))
                  / COUNT(*), 2)  AS fatality_rate_pct
FROM classified_collisions
GROUP BY helmet_flag
LIMIT 20;
```
