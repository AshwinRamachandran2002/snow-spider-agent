```sql
--Description:  Determine the 10 liquor categories whose average per-liter
--              retail price was highest in 2021, then show (for those same
--              categories) the average per-liter retail price in 2019, 2020
--              and 2021.  Steps (CTEs):
--              1. 2021_averages – compute each category’s 2021 per-liter
--                 retail price average.
--              2. top10 – pick the 10 categories with the highest 2021 average.
--              3. final SELECT – join back to full data, filter to 2019-2021
--                 rows, and calculate the three-year averages side-by-side.

WITH 2021_averages AS (
  SELECT
    category,
    AVG(state_bottle_retail * 1000 / bottle_volume_ml) AS avg_per_liter_2021
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE date BETWEEN '2021-01-01' AND '2021-12-31'
    AND bottle_volume_ml > 0               -- avoid divide-by-zero
    AND state_bottle_retail > 0            -- ignore returns / negative prices
  GROUP BY category
),
top10 AS (
  SELECT category
  FROM 2021_averages
  ORDER BY avg_per_liter_2021 DESC
  LIMIT 10
)
SELECT
  s.category,
  ANY_VALUE(s.category_name) AS category_name,
  ROUND(AVG(IF(EXTRACT(YEAR FROM s.date)=2019,
               s.state_bottle_retail * 1000 / s.bottle_volume_ml,
               NULL)), 2) AS avg_per_liter_2019,
  ROUND(AVG(IF(EXTRACT(YEAR FROM s.date)=2020,
               s.state_bottle_retail * 1000 / s.bottle_volume_ml,
               NULL)), 2) AS avg_per_liter_2020,
  ROUND(AVG(IF(EXTRACT(YEAR FROM s.date)=2021,
               s.state_bottle_retail * 1000 / s.bottle_volume_ml,
               NULL)), 2) AS avg_per_liter_2021
FROM `bigquery-public-data.iowa_liquor_sales.sales` AS s
JOIN top10 USING (category)
WHERE EXTRACT(YEAR FROM s.date) IN (2019, 2020, 2021)
  AND s.bottle_volume_ml > 0
  AND s.state_bottle_retail > 0
GROUP BY s.category
ORDER BY avg_per_liter_2021 DESC;
