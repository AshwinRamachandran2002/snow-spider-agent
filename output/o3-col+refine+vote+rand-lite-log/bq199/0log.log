```

```sql
-- 8. Final answer:
--    For the top-10 categories (ranked by 2021 average per-liter retail price),
--    show their three-year averages side by side (one row per category).
WITH top10_2021 AS (
  SELECT
    category,
    category_name,
    AVG(state_bottle_retail * 1000 / bottle_volume_ml) AS avg_per_liter_2021
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE `date` BETWEEN '2021-01-01' AND '2021-12-31'
    AND bottle_volume_ml > 0
    AND state_bottle_retail > 0
  GROUP BY category, category_name
  ORDER BY avg_per_liter_2021 DESC
  LIMIT 10
)
SELECT
  t.category,
  t.category_name,
  ROUND(AVG(CASE WHEN EXTRACT(YEAR FROM s.`date`) = 2019
                 THEN s.state_bottle_retail * 1000 / s.bottle_volume_ml
            END), 2) AS avg_per_liter_2019,
  ROUND(AVG(CASE WHEN EXTRACT(YEAR FROM s.`date`) = 2020
                 THEN s.state_bottle_retail * 1000 / s.bottle_volume_ml
            END), 2) AS avg_per_liter_2020,
  ROUND(AVG(CASE WHEN EXTRACT(YEAR FROM s.`date`) = 2021
                 THEN s.state_bottle_retail * 1000 / s.bottle_volume_ml
            END), 2) AS avg_per_liter_2021
FROM `bigquery-public-data.iowa_liquor_sales.sales` s
JOIN top10_2021 t
  ON s.category = t.category
WHERE EXTRACT(YEAR FROM s.`date`) IN (2019, 2020, 2021)
  AND s.bottle_volume_ml > 0
  AND s.state_bottle_retail > 0
GROUP BY t.category, t.category_name
ORDER BY avg_per_liter_2021 DESC
LIMIT 20;
```

```sql
-- 9. (Optional) Inspect the resulting top categories to validate values
SELECT *
FROM (
  -- repeat query 8 here if you need to re-inspect
  SELECT
    t.category,
    t.category_name,
    ROUND(AVG(CASE WHEN EXTRACT(YEAR FROM s.`date`) = 2019
                   THEN s.state_bottle_retail * 1000 / s.bottle_volume_ml
              END), 2) AS avg_per_liter_2019,
    ROUND(AVG(CASE WHEN EXTRACT(YEAR FROM s.`date`) = 2020
                   THEN s.state_bottle_retail * 1000 / s.bottle_volume_ml
              END), 2) AS avg_per_liter_2020,
    ROUND(AVG(CASE WHEN EXTRACT(YEAR FROM s.`date`) = 2021
                   THEN s.state_bottle_retail * 1000 / s.bottle_volume_ml
              END), 2) AS avg_per_liter_2021
  FROM `bigquery-public-data.iowa_liquor_sales.sales` s
  JOIN (
    SELECT DISTINCT category
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE `date` BETWEEN '2021-01-01' AND '2021-12-31'
    GROUP BY category
    ORDER BY AVG(state_bottle_retail * 1000 / bottle_volume_ml) DESC
    LIMIT 10
  ) t
    ON s.category = t.category
  WHERE EXTRACT(YEAR FROM s.`date`) IN (2019, 2020, 2021)
    AND s.bottle_volume_ml > 0
    AND s.state_bottle_retail > 0
  GROUP BY t.category, t.category
)
LIMIT 20;
```

