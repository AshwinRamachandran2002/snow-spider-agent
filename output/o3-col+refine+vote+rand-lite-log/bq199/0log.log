```sql
--Description:  Identify the 10 liquor categories whose average retail price
--              per liter was highest in 2021, then display their average
--              per-liter retail prices for 2019, 2020, and 2021 in one view.
--              Steps implemented with CTEs:
--              1) calc_2021  – compute each category’s 2021 average price-per-liter.
--              2) top10      – select the 10 categories with the highest 2021 average.
--              3) Final      – for those 10 categories, calculate and show the
--                              three-year averages side-by-side.
WITH calc_2021 AS (          -- 1️⃣  Average price-per-liter for every category in 2021
  SELECT
    category,
    AVG(state_bottle_retail * 1000 / bottle_volume_ml) AS avg_liter_2021
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE date BETWEEN '2021-01-01' AND '2021-12-31'
        AND bottle_volume_ml > 0
        AND state_bottle_retail > 0
  GROUP BY category
),
top10 AS (                   -- 2️⃣  Pick the 10 priciest categories from 2021
  SELECT category
  FROM calc_2021
  ORDER BY avg_liter_2021 DESC
  LIMIT 10
)
SELECT                       -- 3️⃣  Show the three-year averages for those categories
  s.category,
  ANY_VALUE(s.category_name) AS category_name,
  ROUND(AVG(IF(EXTRACT(YEAR FROM s.date)=2019,
               s.state_bottle_retail * 1000 / s.bottle_volume_ml,
               NULL)), 2) AS avg_per_liter_2019,
  ROUND(AVG(IF(EXTRACT(YEAR FROM s.date)=2020,
               s.state_bottle_retail * 1000 / s.bottle_volume_ml,
               NULL)), 2) AS avg_per_liter_2020,
  ROUND(AVG(IF(EXTRACT(YEAR FROM s.date)=2021,
               s.state_bottle_retail * 1000 / s.bottle_volume_ml,
               NULL)), 2) AS avg_per_liter_2021
FROM `bigquery-public-data.iowa_liquor_sales.sales` AS s
JOIN top10 USING (category)
WHERE EXTRACT(YEAR FROM s.date) IN (2019, 2020, 2021)
      AND s.bottle_volume_ml > 0
      AND s.state_bottle_retail > 0
GROUP BY s.category
ORDER BY avg_per_liter_2021 DESC;
```
