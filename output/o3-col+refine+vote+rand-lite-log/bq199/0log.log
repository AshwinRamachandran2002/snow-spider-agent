  ROUND(AVG(state_bottle_retail * 1000 / bottle_volume_ml), 2) AS avg_retail_per_liter_2020
FROM `bigquery-public-data.iowa_liquor_sales.sales` s
JOIN top10_2021 t
  ON s.category = t.category
WHERE s.`date` BETWEEN '2020-01-01' AND '2020-12-31'
  AND s.bottle_volume_ml > 0
  AND s.state_bottle_retail > 0
