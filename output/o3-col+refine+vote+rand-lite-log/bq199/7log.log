```sql
--Description: Preview a few recent records to understand the main columns we’ll work with.
SELECT *
FROM `bigquery-public-data.iowa_liquor_sales.sales`
LIMIT 20;
```

```sql
--Description: Check the range of calendar years present in the data.
SELECT DISTINCT EXTRACT(YEAR FROM `date`) AS sales_year
FROM `bigquery-public-data.iowa_liquor_sales.sales`
ORDER BY sales_year
LIMIT 20;
```

```sql
--Description: Compute the per-liter retail price for a handful of 2021 rows
--             (retail price per bottle ÷ bottle size in liters).
SELECT
  `category_name`,
  `state_bottle_retail`,
  `bottle_volume_ml`,
  `state_bottle_retail` / ( `bottle_volume_ml` / 1000.0 ) AS retail_price_per_liter
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2021
LIMIT 20;
```

```sql
--Description: Find the average per-liter retail price by category for 2021.
SELECT
  `category_name`,
  AVG( `state_bottle_retail` / ( `bottle_volume_ml` / 1000.0 ) ) AS avg_price_per_liter_2021
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2021
GROUP BY `category_name`
ORDER BY avg_price_per_liter_2021 DESC
LIMIT 20;
```

```sql
--Description: List the ten categories with the highest 2021 average per-liter retail price.
SELECT
  `category_name`,
  AVG( `state_bottle_retail` / ( `bottle_volume_ml` / 1000.0 ) ) AS avg_price_per_liter_2021
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2021
GROUP BY `category_name`
ORDER BY avg_price_per_liter_2021 DESC
LIMIT 10;
```

```sql
--Description: For all categories, compute the average per-liter retail price
--             for each of the years 2019, 2020, and 2021.
SELECT
  `category_name`,
  EXTRACT(YEAR FROM `date`) AS sales_year,
  AVG( `state_bottle_retail` / ( `bottle_volume_ml` / 1000.0 ) ) AS avg_price_per_liter
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) IN (2019, 2020, 2021)
GROUP BY `category_name`, sales_year
ORDER BY `category_name`, sales_year
LIMIT 20;
```

```sql
--Description: Final answer – return the top-10 categories (by 2021 average per-liter price)
--             and show their average per-liter retail prices for 2019-2021.
WITH top10_2021 AS (
  SELECT
    `category_name`,
    AVG( `state_bottle_retail` / ( `bottle_volume_ml` / 1000.0 ) ) AS avg_price_per_liter_2021
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) = 2021
  GROUP BY `category_name`
  ORDER BY avg_price_per_liter_2021 DESC
  LIMIT 10
)
SELECT
  t.`category_name`,
  AVG(CASE WHEN EXTRACT(YEAR FROM s.`date`) = 2019
           THEN s.`state_bottle_retail` / ( s.`bottle_volume_ml` / 1000.0 ) END) AS avg_per_liter_2019,
  AVG(CASE WHEN EXTRACT(YEAR FROM s.`date`) = 2020
           THEN s.`state_bottle_retail` / ( s.`bottle_volume_ml` / 1000.0 ) END) AS avg_per_liter_2020,
  AVG(CASE WHEN EXTRACT(YEAR FROM s.`date`) = 2021
           THEN s.`state_bottle_retail` / ( s.`bottle_volume_ml` / 1000.0 ) END) AS avg_per_liter_2021
FROM top10_2021 AS t
JOIN `bigquery-public-data.iowa_liquor_sales.sales` AS s
ON t.`category_name` = s.`category_name`
WHERE EXTRACT(YEAR FROM s.`date`) IN (2019, 2020, 2021)
GROUP BY t.`category_name`
ORDER BY avg_per_liter_2021 DESC
LIMIT 20;
```
