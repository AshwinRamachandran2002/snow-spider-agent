Query:
--Description: Final answer – return the top-10 categories (by 2021 average per-liter price)
--             and show their average per-liter retail prices for 2019-2021.
WITH top10_2021 AS (
  SELECT
    `category_name`,
    AVG( `state_bottle_retail` / ( `bottle_volume_ml` / 1000.0 ) ) AS avg_price_per_liter_2021
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) = 2021
  GROUP BY `category_name`
  ORDER BY avg_price_per_liter_2021 DESC
  LIMIT 10
)
SELECT
  t.`category_name`,
  AVG(CASE WHEN EXTRACT(YEAR FROM s.`date`) = 2019
           THEN s.`state_bottle_retail` / ( s.`bottle_volume_ml` / 1000.0 ) END) AS avg_per_liter_2019,
  AVG(CASE WHEN EXTRACT(YEAR FROM s.`date`) = 2020
           THEN s.`state_bottle_retail` / ( s.`bottle_volume_ml` / 1000.0 ) END) AS avg_per_liter_2020,
  AVG(CASE WHEN EXTRACT(YEAR FROM s.`date`) = 2021
           THEN s.`state_bottle_retail` / ( s.`bottle_volume_ml` / 1000.0 ) END) AS avg_per_liter_2021
FROM top10_2021 AS t
JOIN `bigquery-public-data.iowa_liquor_sales.sales` AS s
ON t.`category_name` = s.`category_name`
WHERE EXTRACT(YEAR FROM s.`date`) IN (2019, 2020, 2021)
GROUP BY t.`category_name`
ORDER BY avg_per_liter_2021 DESC
LIMIT 20;
