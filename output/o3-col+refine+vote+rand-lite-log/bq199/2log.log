```

```sql
--Description: See which liquor categories actually appear in 2021.
SELECT DISTINCT category, category_name
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2021
LIMIT 20;
```

```sql
--Description: Compute a transaction-level per-liter retail price (retail $ per bottle ÷ liters per bottle) for a sample of 2021 rows.
SELECT
  invoice_and_item_number,
  category_name,
  state_bottle_retail,
  bottle_volume_ml,
  state_bottle_retail * 1000 / bottle_volume_ml AS per_liter_retail_price
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2021
  AND bottles_sold > 0               -- ignore returns/negative sales
LIMIT 20;
```

```sql
--Description: Average per-liter retail price for every category in 2021, ordered from highest to lowest.
SELECT
  category_name,
  AVG(state_bottle_retail * 1000 / bottle_volume_ml) AS avg_per_liter_retail_2021
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2021
  AND bottles_sold  > 0
  AND state_bottle_retail > 0
  AND bottle_volume_ml    > 0
GROUP BY category_name
ORDER BY avg_per_liter_retail_2021 DESC
LIMIT 20;
```

```sql
--Description: Identify the TOP 10 liquor categories in 2021 by their average per-liter retail price.
SELECT
  category_name,
  AVG(state_bottle_retail * 1000 / bottle_volume_ml) AS avg_per_liter_retail_2021
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2021
  AND bottles_sold  > 0
  AND state_bottle_retail > 0
  AND bottle_volume_ml    > 0
GROUP BY category_name
ORDER BY avg_per_liter_retail_2021 DESC
LIMIT 10;
```

```sql
--Description: Take those 2021 “top 10” categories and look at a few 2019 sales rows from them.
SELECT
  s.category_name,
  s.state_bottle_retail,
  s.bottle_volume_ml,
  s.state_bottle_retail * 1000 / s.bottle_volume_ml AS per_liter_retail_price
FROM `bigquery-public-data.iowa_liquor_sales.sales` AS s
JOIN (
  SELECT category_name
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) = 2021
    AND bottles_sold  > 0
    AND state_bottle_retail > 0
    AND bottle_volume_ml    > 0
  GROUP BY category_name
  ORDER BY AVG(state_bottle_retail * 1000 / bottle_volume_ml) DESC
  LIMIT 10
) AS top21
ON s.category_name = top21.category_name
WHERE EXTRACT(YEAR FROM s.`date`) = 2019
LIMIT 20;
```

```sql
--Description: For the same “top 10” categories, compute the average per-liter retail price in 2019, 2020, and 2021 (long / tidy form).
SELECT
  EXTRACT(YEAR FROM `date`) AS sale_year,
  category_name,
  AVG(state_bottle_retail * 1000 / bottle_volume_ml) AS avg_per_liter_retail
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) IN (2019, 2020, 2021)
  AND bottles_sold  > 0
  AND state_bottle_retail > 0
  AND bottle_volume_ml    > 0
  AND category_name IN (
        SELECT category_name
        FROM `bigquery-public-data.iowa_liquor_sales.sales`
        WHERE EXTRACT(YEAR FROM `date`) = 2021
          AND bottles_sold  > 0
          AND state_bottle_retail > 0
          AND bottle_volume_ml    > 0
        GROUP BY category_name
        ORDER BY AVG(state_bottle_retail * 1000 / bottle_volume_ml) DESC
        LIMIT 10
      )
GROUP BY sale_year, category_name
ORDER BY category_name, sale_year
LIMIT 20;
```

```sql
--Description: Pivot the same data so each row is a category and each column is a year
--             (this delivers the final answer for the assignment).
SELECT
  category_name,
  AVG(IF(EXTRACT(YEAR FROM `date`) = 2019,
         state_bottle_retail * 1000 / bottle_volume_ml, NULL)) AS avg_2019_per_liter_retail,
  AVG(IF(EXTRACT(YEAR FROM `date`) = 2020,
         state_bottle_retail * 1000 / bottle_volume_ml, NULL)) AS avg_2020_per_liter_retail,
  AVG(IF(EXTRACT(YEAR FROM `date`) = 2021,
         state_bottle_retail * 1000 / bottle_volume_ml, NULL)) AS avg_2021_per_liter_retail
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) IN (2019, 2020, 2021)
  AND bottles_sold  > 0
  AND state_bottle_retail > 0
  AND bottle_volume_ml    > 0
  AND category_name IN (
        SELECT category_name
        FROM `bigquery-public-data.iowa_liquor_sales.sales`
        WHERE EXTRACT(YEAR FROM `date`) = 2021
          AND bottles_sold  > 0
          AND state_bottle_retail > 0
          AND bottle_volume_ml    > 0
        GROUP BY category_name
        ORDER BY AVG(state_bottle_retail * 1000 / bottle_volume_ml) DESC
        LIMIT 10
      )
GROUP BY category_name
ORDER BY avg_2021_per_liter_retail DESC
LIMIT 10;
```

These eight queries progress from simple inspection all the way through to the final result: the 10 Iowa liquor categories with the highest 2021 average per-liter retail price, along with their comparable averages for 2019 and 2020.
