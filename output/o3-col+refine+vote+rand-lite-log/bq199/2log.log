```sql
--Description: Preview a handful of 2021 liquor-sales rows to remind ourselves of the fields we will be using.
SELECT *
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2021
