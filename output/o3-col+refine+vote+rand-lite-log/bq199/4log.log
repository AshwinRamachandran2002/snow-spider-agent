--Description: For those 10 categories, show average per-liter retail prices for 2019-2021.
WITH top10 AS (
  SELECT
    category_name
  FROM (
    SELECT
      category_name,
      AVG(state_bottle_retail / (bottle_volume_ml/1000.0)) AS avg_retail_per_liter_2021
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE EXTRACT(YEAR FROM date)=2021
      AND bottles_sold>0
      AND bottle_volume_ml>0
      AND state_bottle_retail>0
    GROUP BY category_name
    ORDER BY avg_retail_per_liter_2021 DESC
    LIMIT 10
  )
)
SELECT
  category_name,
  EXTRACT(YEAR FROM date) AS year,
  AVG(state_bottle_retail / (bottle_volume_ml/1000.0)) AS avg_retail_per_liter
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE category_name IN (SELECT category_name FROM top10)
  AND EXTRACT(YEAR FROM date) BETWEEN 2019 AND 2021
  AND bottles_sold>0
  AND bottle_volume_ml>0
  AND state_bottle_retail>0
