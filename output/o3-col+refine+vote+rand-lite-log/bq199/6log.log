```sql
-- 7. Pull the TOP-10 categories in 2021 by the average per-liter retail price
WITH per_txn_2021 AS (
  SELECT
    `category`,
    `category_name`,
    SAFE_DIVIDE(`sale_dollars`, `volume_sold_liters`) AS price_per_liter
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE `sale_dollars` > 0
    AND `volume_sold_liters` > 0
    AND EXTRACT(YEAR FROM `date`) = 2021
)
SELECT
  `category`,
  `category_name`,
  AVG(price_per_liter) AS avg_price_per_liter_2021
FROM per_txn_2021
GROUP BY `category`, `category_name`
ORDER BY avg_price_per_liter_2021 DESC
LIMIT 10;
