FROM `bigquery-public-data.iowa_liquor_sales.sales`
ORDER BY sales_year;
```

```sql
-- Description: 3) Inspect how per-liter retail price looks on a few 2021 lines
SELECT
  `invoice_and_item_number`,
  `category_name`,
  `state_bottle_retail`,
  `bottle_volume_ml`,
  -- retail price per litre = retail per bottle  / (ml / 1,000)
  ( `state_bottle_retail` * 1000.0 / `bottle_volume_ml` ) AS retail_per_liter
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2021
LIMIT 20;
```

```sql
-- Description: 4) Compute 2021 average per-liter retail price for every category
SELECT
  `category`,
  `category_name`,
  AVG( `state_bottle_retail` * 1000.0 / `bottle_volume_ml` ) AS avg_retail_per_liter_2021
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2021
GROUP BY `category`, `category_name`
ORDER BY avg_retail_per_liter_2021 DESC
LIMIT 20;
```

```sql
-- Description: 5) Grab the top-10 categories (highest 2021 avg per-liter retail price)
WITH cat21 AS (
  SELECT
    `category`,
    `category_name`,
    AVG( `state_bottle_retail` * 1000.0 / `bottle_volume_ml` ) AS avg_retail_per_liter_2021
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) = 2021
  GROUP BY `category`, `category_name`
)
SELECT *
FROM cat21
ORDER BY avg_retail_per_liter_2021 DESC
LIMIT 10;
```

```sql
-- Description: 6) Reuse the result above to compute 2019–2021 averages for ONLY those top-10 categories
WITH top10_2021 AS (
  SELECT
    `category`
  FROM (
    SELECT
      `category`,
      AVG( `state_bottle_retail` * 1000.0 / `bottle_volume_ml` ) AS avg_retail_per_liter_2021
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE EXTRACT(YEAR FROM `date`) = 2021
    GROUP BY `category`
    ORDER BY avg_retail_per_liter_2021 DESC
    LIMIT 10
  )
)
SELECT
  t.`category`,
  ANY_VALUE(s.`category_name`) AS category_name,
  EXTRACT(YEAR FROM s.`date`)            AS sales_year,
  AVG( s.`state_bottle_retail` * 1000.0 / s.`bottle_volume_ml` ) AS avg_retail_per_liter
FROM `bigquery-public-data.iowa_liquor_sales.sales` AS s
JOIN top10_2021            AS t
ON  s.`category` = t.`category`
WHERE EXTRACT(YEAR FROM s.`date`) IN (2019, 2020, 2021)
GROUP BY t.`category`, sales_year
ORDER BY t.`category`, sales_year;
```

```sql
-- Description: 7) Same as above but pivoted so every category shows 2019, 2020, 2021 averages side-by-side
WITH top10_2021 AS (
  SELECT
    `category`
  FROM (
    SELECT
      `category`,
      AVG( `state_bottle_retail` * 1000.0 / `bottle_volume_ml` ) AS avg_retail_per_liter_2021
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE EXTRACT(YEAR FROM `date`) = 2021
    GROUP BY `category`
    ORDER BY avg_retail_per_liter_2021 DESC
    LIMIT 10
  )
),
yr_avgs AS (
  SELECT
    s.`category`,
    ANY_VALUE(s.`category_name`) AS category_name,
    EXTRACT(YEAR FROM s.`date`)  AS sales_year,
    AVG( s.`state_bottle_retail` * 1000.0 / s.`bottle_volume_ml` ) AS avg_retail_per_liter
  FROM `bigquery-public-data.iowa_liquor_sales.sales` AS s
  JOIN top10_2021                AS t
  ON   s.`category` = t.`category`
  WHERE EXTRACT(YEAR FROM s.`date`) IN (2019, 2020, 2021)
  GROUP BY s.`category`, sales_year
)
SELECT
  `category`,
  `category_name`,
  MAX( CASE WHEN sales_year = 2019 THEN avg_retail_per_liter END ) AS avg_2019_per_liter,
  MAX( CASE WHEN sales_year = 2020 THEN avg_retail_per_liter END ) AS avg_2020_per_liter,
  MAX( CASE WHEN sales_year = 2021 THEN avg_retail_per_liter END ) AS avg_2021_per_liter
FROM yr_avgs
GROUP BY `category`, `category_name`
ORDER BY avg_2021_per_liter DESC;
```

```sql
