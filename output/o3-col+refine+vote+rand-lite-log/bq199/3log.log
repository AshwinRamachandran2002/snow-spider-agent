  `bottle_volume_ml`,
  `state_bottle_retail`
FROM `bigquery-public-data.iowa_liquor_sales.sales`
ORDER BY `date` DESC
LIMIT 20;
```

```sql
-- Description: 2) See the distinct calendar years present in the table
