Query:
--Description: 8) Final answer – pick the single year whose first >10-sighting day after January is earliest overall.
WITH daily_counts AS (
  SELECT year, month, day, COUNT(*) AS sightings
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE species = 'Sterna paradisaea'
    AND decimallatitude > 40
    AND month > 1                 -- after January
    AND day IS NOT NULL
  GROUP BY year, month, day
  HAVING sightings > 10
),
first_per_year AS (
  SELECT
    year,
    MIN(DATE(year, month, day)) AS first_big_day
  FROM daily_counts
  GROUP BY year
)
SELECT year, first_big_day
FROM first_per_year
ORDER BY first_big_day
LIMIT 1;
