```sql
--Description: 1) Peek at a few raw occurrence records for the species “Sterna paradisaea”.
SELECT
  gbifid,
  scientificname,
  species,
  decimallatitude,
  decimallongitude,
  day,
  month,
  year
FROM `bigquery-public-data.gbif.occurrences`
WHERE species = 'Sterna paradisaea'
LIMIT 20;
```

```sql
--Description: 2) Check the different values that appear in the species column for any possible spelling variations.
SELECT DISTINCT species
FROM `bigquery-public-data.gbif.occurrences`
WHERE LOWER(species) LIKE '%sterna paradisaea%'
LIMIT 20;
```

```sql
--Description: 3) Confirm how many “Sterna paradisaea” observations exist north of 40° N for some recent years.
SELECT year, COUNT(*) AS obs_north_of_40
FROM `bigquery-public-data.gbif.occurrences`
WHERE species = 'Sterna paradisaea'
  AND decimallatitude > 40
GROUP BY year
ORDER BY year DESC
LIMIT 20;
```

```sql
--Description: 4) Compute daily sighting counts for one sample year (2021) to see typical magnitudes.
SELECT
  DATE(year, month, day) AS sighting_date,
  COUNT(*) AS daily_sightings
FROM `bigquery-public-data.gbif.occurrences`
WHERE species = 'Sterna paradisaea'
  AND decimallatitude > 40
  AND year = 2021
  AND month > 1          -- after January
  AND day IS NOT NULL
GROUP BY sighting_date
ORDER BY daily_sightings DESC
LIMIT 20;
```

```sql
--Description: 5) Find the top-20 (all years) dates north of 40 ° N with more than 10 sightings, just to inspect them.
SELECT
  year,
  month,
  day,
  COUNT(*) AS sightings
FROM `bigquery-public-data.gbif.occurrences`
WHERE species = 'Sterna paradisaea'
  AND decimallatitude > 40
  AND month > 1
  AND day IS NOT NULL
GROUP BY year, month, day
HAVING COUNT(*) > 10
ORDER BY sightings DESC
LIMIT 20;
```

```sql
--Description: 6) For each year, grab the very first day after January that exceeded 10 sightings.
WITH daily_counts AS (
  SELECT year, month, day, COUNT(*) AS sightings
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE species = 'Sterna paradisaea'
    AND decimallatitude > 40
    AND month > 1
    AND day IS NOT NULL
  GROUP BY year, month, day
  HAVING sightings > 10
)
SELECT
  year,
  MIN(DATE(year, month, day)) AS first_big_day
FROM daily_counts
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--Description: 7) Order the per-year “first big day” list by calendar order to see which year’s happens earliest.
WITH daily_counts AS (
  SELECT year, month, day, COUNT(*) AS sightings
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE species = 'Sterna paradisaea'
    AND decimallatitude > 40
    AND month > 1
    AND day IS NOT NULL
  GROUP BY year, month, day
  HAVING sightings > 10
),
first_per_year AS (
  SELECT
    year,
    MIN(DATE(year, month, day)) AS first_big_day
  FROM daily_counts
  GROUP BY year
)
SELECT *
FROM first_per_year
ORDER BY first_big_day
LIMIT 20;
```

```sql
--Description: 8) Final answer – pick the single year whose first >10-sighting day after January is earliest overall.
WITH daily_counts AS (
  SELECT year, month, day, COUNT(*) AS sightings
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE species = 'Sterna paradisaea'
    AND decimallatitude > 40
    AND month > 1                 -- after January
    AND day IS NOT NULL
  GROUP BY year, month, day
  HAVING sightings > 10
),
first_per_year AS (
  SELECT
    year,
    MIN(DATE(year, month, day)) AS first_big_day
  FROM daily_counts
  GROUP BY year
)
SELECT year, first_big_day
FROM first_per_year
ORDER BY first_big_day
LIMIT 1;
```
