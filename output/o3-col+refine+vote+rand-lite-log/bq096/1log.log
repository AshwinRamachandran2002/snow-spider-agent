Query:
--Description: Corrected version of query 6 – find the earliest “first-big-day”
--             among all years (same logic as query 5 but returns only the best
--             year).  Fixes: include yr in GROUP BY inside the daily CTE and
--             replace direct month reference with EXTRACT(MONTH…).
WITH daily AS (                       -- daily counts per date
  SELECT
    DATE(eventdate) AS sighting_date,
    EXTRACT(YEAR FROM eventdate) AS yr,
    COUNT(*) AS n_records
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE species = 'Sterna paradisaea'
    AND decimallatitude > 40
    AND EXTRACT(MONTH FROM eventdate) > 1   -- after January
  GROUP BY sighting_date, yr
),
qualified AS (                        -- keep only >10-record days
  SELECT *
  FROM daily
  WHERE n_records > 10
),
earliest_per_year AS (                -- first such day per year
  SELECT
    yr,
    MIN(sighting_date) AS first_big_day
  FROM qualified
  GROUP BY yr
)
SELECT                                 -- earliest of them all
  yr  AS year_with_earliest_big_day,
  first_big_day
FROM earliest_per_year
ORDER BY first_big_day
LIMIT 1
