SELECT DISTINCT year
FROM `bigquery-public-data.gbif.occurrences`
WHERE species = 'Sterna paradisaea'
ORDER BY year
LIMIT 20;
```

```sql
-- 3. Count daily sightings north of 40° N, after January, by date
SELECT
  DATE(eventdate) AS sighting_date,
  COUNT(*)        AS n_records
FROM `bigquery-public-data.gbif.occurrences`
WHERE species              = 'Sterna paradisaea'
  AND decimallatitude      > 40
  AND month                > 1           -- after January
GROUP BY sighting_date
ORDER BY sighting_date
LIMIT 20;
```

```sql
-- 4. Confirm dates that already exceed 10 records
SELECT *
FROM (
  SELECT
    DATE(eventdate) AS sighting_date,
    COUNT(*)        AS n_records
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE species         = 'Sterna paradisaea'
    AND decimallatitude > 40
    AND month           > 1
  GROUP BY sighting_date )
WHERE n_records > 10
ORDER BY sighting_date
LIMIT 20;
```

```sql
-- 5. For every year, pick the FIRST post-January day with >10 records
WITH daily AS (
  SELECT
    DATE(eventdate)          AS sighting_date,
    EXTRACT(YEAR FROM eventdate) AS yr,
    COUNT(*) AS n_records
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE species         = 'Sterna paradisaea'
    AND decimallatitude > 40
    AND month           > 1
  GROUP BY sighting_date ),
qualified AS (
  SELECT *
  FROM daily
  WHERE n_records > 10 )
SELECT
  yr,
  MIN(sighting_date) AS first_big_day
FROM qualified
GROUP BY yr
ORDER BY first_big_day
LIMIT 20;
```

```sql
-- 6. Which of those years is the EARLIEST overall?
WITH daily AS (
  SELECT
    DATE(eventdate)          AS sighting_date,
    EXTRACT(YEAR FROM eventdate) AS yr,
    COUNT(*) AS n_records
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE species         = 'Sterna paradisaea'
    AND decimallatitude > 40
    AND month           > 1
  GROUP BY sighting_date ),
qualified AS (
  SELECT *
  FROM daily
  WHERE n_records > 10 ),
earliest_per_year AS (
  SELECT
    yr,
    MIN(sighting_date) AS first_big_day
  FROM qualified
  GROUP BY yr )
SELECT
  yr  AS year_with_earliest_big_day,
  first_big_day
FROM earliest_per_year
ORDER BY first_big_day
LIMIT 1;
```

