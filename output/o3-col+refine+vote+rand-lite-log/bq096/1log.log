```sql
-- THINKING PROCESS -----------------------------------------------------------
-- 1. Filter to Arctic-tern (Sterna paradisaea) occurrences north of 40 ° N
--    and strictly after January (month > 1).
-- 2. Aggregate by calendar date to count how many records occur on each day.
-- 3. Keep only those dates where the daily count exceeds 10 (our “big-day”).
-- 4. For every year, find the MIN() (earliest) such big-day => first_big_day.
-- 5. Order all years by their first_big_day and return the very earliest one.
-- ---------------------------------------------------------------------------

WITH daily AS (          -- step 1 & 2: daily counts
  SELECT
    DATE(eventdate) AS sighting_date,
    EXTRACT(YEAR  FROM eventdate) AS yr,
    COUNT(*) AS n_records
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE species = 'Sterna paradisaea'
    AND decimallatitude > 40                -- north of 40° N
    AND EXTRACT(MONTH FROM eventdate) > 1    -- after January
  GROUP BY sighting_date, yr
),
qual AS (               -- step 3: only days with >10 records
  SELECT *
  FROM daily
  WHERE n_records > 10
),
per_year AS (           -- step 4: first big-day per year
  SELECT
    yr,
    MIN(sighting_date) AS first_big_day
  FROM qual
  GROUP BY yr
)
-- step 5: which year’s first_big_day is earliest overall?
SELECT
  yr  AS year_with_earliest_big_day,
  first_big_day
FROM per_year
ORDER BY first_big_day
LIMIT 1;
```
