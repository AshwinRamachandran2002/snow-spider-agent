Query:
--Description: 8) Show all qualifying crowded days (>10 sightings) in the winning year
WITH crowded_days AS (
  SELECT DATE(eventdate) AS obs_date, COUNT(*) AS n
  FROM   `bigquery-public-data.gbif.occurrences`
  WHERE  LOWER(scientificname) LIKE 'sterna paradisaea%'
    AND  decimallatitude > 40
    AND  EXTRACT(MONTH FROM eventdate) > 1
  GROUP BY obs_date
  HAVING n > 10
),
first_day_per_year AS (
  SELECT EXTRACT(YEAR FROM obs_date) AS yr,
         MIN(obs_date)               AS first_crowded_day
  FROM   crowded_days
  GROUP  BY yr
  ORDER  BY first_crowded_day
  LIMIT 1
)
SELECT
  cd.obs_date,
  cd.n
FROM crowded_days cd
JOIN first_day_per_year fd
ON  EXTRACT(YEAR FROM cd.obs_date) = fd.yr
ORDER BY cd.obs_date
LIMIT 20
