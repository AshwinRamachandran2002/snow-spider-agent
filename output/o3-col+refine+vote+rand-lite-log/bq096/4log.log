```sql
--Description: 1) Peek at a few Arctic-tern records to verify how the species is written
SELECT `scientificname`, `eventdate`, `decimallatitude`
FROM   `bigquery-public-data.gbif.occurrences`
WHERE  LOWER(`scientificname`) LIKE '%sterna paradisaea%'
LIMIT  20;
```

```sql
--Description: 2) Check the yearly distribution of Arctic-tern records north of 40°N
SELECT  EXTRACT(YEAR  FROM `eventdate`)   AS yr,
        COUNT(*)                           AS n_records
FROM    `bigquery-public-data.gbif.occurrences`
WHERE   LOWER(`scientificname`) = 'sterna paradisaea'
  AND   `decimallatitude`  > 40
GROUP BY yr
ORDER BY yr
LIMIT 20;
```

```sql
--Description: 3) Look at the month distribution to make sure February and later have data
SELECT  EXTRACT(MONTH FROM `eventdate`) AS mm,
        COUNT(*)                        AS n
FROM    `bigquery-public-data.gbif.occurrences`
WHERE   LOWER(`scientificname`) = 'sterna paradisaea'
  AND   `decimallatitude`  > 40
GROUP BY mm
ORDER BY mm
LIMIT 20;
```

```sql
--Description: 4) Aggregate by exact calendar day to see how many observations occur per day
SELECT  DATE(`eventdate`)                AS obs_date,
        COUNT(*)                         AS n
FROM    `bigquery-public-data.gbif.occurrences`
WHERE   LOWER(`scientificname`) = 'sterna paradisaea'
  AND   `decimallatitude`  > 40
GROUP BY obs_date
ORDER BY n DESC, obs_date
LIMIT 20;
```

```sql
--Description: 5) Restrict to days after January and keep only those with >10 sightings
SELECT  DATE(`eventdate`)                AS obs_date,
        COUNT(*)                         AS n
FROM    `bigquery-public-data.gbif.occurrences`
WHERE   LOWER(`scientificname`) = 'sterna paradisaea'
  AND   `decimallatitude`  > 40
  AND   EXTRACT(MONTH FROM `eventdate`) > 1          -- after January
GROUP BY obs_date
HAVING  n > 10
ORDER  BY obs_date
LIMIT 20;
```

```sql
--Description: 6) For every year, find the first (earliest) day after January with >10 sightings north of 40°N
SELECT  EXTRACT(YEAR  FROM obs_date)     AS yr,
        MIN(obs_date)                    AS first_crowded_day
FROM  (
        SELECT DATE(`eventdate`) AS obs_date, COUNT(*) AS n
        FROM   `bigquery-public-data.gbif.occurrences`
        WHERE  LOWER(`scientificname`) = 'sterna paradisaea'
          AND  `decimallatitude`  > 40
          AND  EXTRACT(MONTH FROM `eventdate`) > 1      -- after January
        GROUP  BY obs_date
        HAVING COUNT(*) > 10
      )
GROUP BY yr
ORDER BY first_crowded_day
LIMIT 20;
```

```sql
--Description: 7) Identify the single year whose first “>10-sightings” day is earliest among all years
SELECT  yr, first_crowded_day
FROM  (
        SELECT  EXTRACT(YEAR  FROM obs_date) AS yr,
                MIN(obs_date)                AS first_crowded_day
        FROM (
               SELECT DATE(`eventdate`) AS obs_date
               FROM   `bigquery-public-data.gbif.occurrences`
               WHERE  LOWER(`scientificname`) = 'sterna paradisaea'
                 AND  `decimallatitude`  > 40
                 AND  EXTRACT(MONTH FROM `eventdate`) > 1
               GROUP  BY obs_date
               HAVING COUNT(*) > 10
             )
        GROUP BY yr
      )
ORDER BY first_crowded_day
LIMIT 1;
```

```sql
--Description: 8) (Optional) Show all days in that winning year that met the criterion
SELECT  DATE(`eventdate`)               AS obs_date,
        COUNT(*)                        AS n
FROM    `bigquery-public-data.gbif.occurrences`
