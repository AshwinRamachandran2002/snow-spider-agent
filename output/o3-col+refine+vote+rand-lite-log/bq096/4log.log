```sql
--Description / Thinking process:
--Goal: Find the year whose very first calendar day (after January) that has >10
--      Arctic-tern (Sterna paradisaea) observations north of 40° N
--      is the earliest among all years.
--Logic:
--  A. Identify relevant observations
--       • scientificName begins with “Sterna paradisaea” (author names may follow)
--       • latitude > 40
--       • month > 1  → after January
--  B. Aggregate to daily counts and keep only days where count > 10.
--  C. For each year obtain the earliest such day.
--  D. Return the year whose earliest day is the absolute earliest.

WITH daily_counts AS (
  SELECT
    DATE(eventdate)              AS obs_date,
    COUNT(*)                     AS n
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE LOWER(scientificname) LIKE 'sterna paradisaea%'   -- step A.1
    AND decimallatitude > 40                              -- step A.2
    AND EXTRACT(MONTH FROM eventdate) > 1                 -- step A.3
  GROUP BY obs_date
  HAVING n > 10                                           -- step B
),
first_day_per_year AS (
  SELECT
    EXTRACT(YEAR FROM obs_date) AS yr,
    MIN(obs_date)              AS first_crowded_day
  FROM daily_counts
  GROUP BY yr                                       -- step C
)
SELECT
  yr,
  first_crowded_day
FROM first_day_per_year
ORDER BY first_crowded_day                          -- step D
LIMIT 1;
```
