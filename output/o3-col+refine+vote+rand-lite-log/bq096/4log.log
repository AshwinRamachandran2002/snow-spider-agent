                       WHERE  LOWER(`scientificname`) = 'sterna paradisaea'
                         AND  `decimallatitude`  > 40
                         AND  EXTRACT(MONTH FROM `eventdate`) > 1
                       GROUP BY obs_date
                       HAVING COUNT(*) > 10
                     )
              GROUP BY yr
              ORDER BY first_crowded_day
              LIMIT 1
             )
  AND   EXTRACT(MONTH FROM `eventdate`) > 1
GROUP BY obs_date
HAVING COUNT(*) > 10
ORDER BY obs_date
LIMIT 20;
```

