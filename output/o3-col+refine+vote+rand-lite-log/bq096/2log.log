```sql
--Description: Check how the species is recorded and be sure of the exact string to match (“Sterna paradisaea”).
SELECT DISTINCT species
FROM `bigquery-public-data.gbif.occurrences`
WHERE LOWER(species) LIKE '%sterna paradisaea%'
LIMIT 20;
```

```sql
--Description: Take a quick look at a few records for Sterna paradisaea north of 40° N.
SELECT species,
       scientificname,
       DATE(eventdate) AS obs_date,
       year,
       month,
       day,
       decimallatitude,
       decimallongitude
FROM `bigquery-public-data.gbif.occurrences`
WHERE species = 'Sterna paradisaea'
  AND decimallatitude > 40
LIMIT 20;
```

```sql
--Description: Number of northern (>40 °N) Sterna paradisaea records by year.
SELECT year,
       COUNT(*) AS total_records
FROM `bigquery-public-data.gbif.occurrences`
WHERE species = 'Sterna paradisaea'
  AND decimallatitude > 40
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--Description: Daily counts (after January) for each year.
SELECT year,
       DATE(eventdate) AS obs_date,
       COUNT(*) AS records
FROM `bigquery-public-data.gbif.occurrences`
WHERE species = 'Sterna paradisaea'
  AND decimallatitude > 40
  AND month > 1                     -- “after January”
GROUP BY year, obs_date
ORDER BY year, obs_date
LIMIT 20;
```

```sql
--Description: For every year, find the first post-January day with > 10 sightings.
SELECT year,
       MIN(obs_date) AS first_day_gt10
FROM (
  SELECT year,
         DATE(eventdate) AS obs_date,
         COUNT(*) AS records
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE species = 'Sterna paradisaea'
    AND decimallatitude > 40
    AND month > 1
  GROUP BY year, obs_date
  HAVING records > 10
)
GROUP BY year
ORDER BY first_day_gt10
LIMIT 20;
```

```sql
--Description: Identify the single year whose earliest qualifying date is the earliest of all.
SELECT year
FROM (
  SELECT year,
         MIN(obs_date) AS first_day_gt10
  FROM (
    SELECT year,
           DATE(eventdate) AS obs_date,
           COUNT(*) AS records
    FROM `bigquery-public-data.gbif.occurrences`
    WHERE species = 'Sterna paradisaea'
      AND decimallatitude > 40
      AND month > 1
    GROUP BY year, obs_date
    HAVING records > 10
  )
  GROUP BY year
)
ORDER BY first_day_gt10      -- earliest date comes first
LIMIT 1;
```

```sql
--Description: See the counts on those “first > 10” days for every year.
SELECT y.year,
       y.first_day_gt10 AS obs_date,
       d.records
FROM (
  SELECT year,
         MIN(obs_date) AS first_day_gt10
  FROM (
    SELECT year,
           DATE(eventdate) AS obs_date,
           COUNT(*) AS records
    FROM `bigquery-public-data.gbif.occurrences`
    WHERE species = 'Sterna paradisaea'
      AND decimallatitude > 40
      AND month > 1
    GROUP BY year, obs_date
    HAVING records > 10
  )
  GROUP BY year
) AS y
JOIN (
  SELECT year,
         DATE(eventdate) AS obs_date,
         COUNT(*) AS records
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE species = 'Sterna paradisaea'
    AND decimallatitude > 40
    AND month > 1
  GROUP BY year, obs_date
) AS d
ON y.year = d.year
AND y.first_day_gt10 = d.obs_date
ORDER BY y.first_day_gt10
LIMIT 20;
```

These six queries explore the necessary columns, build daily counts, extract each year’s first day (after January) with more than ten sightings north of 40 °N, and finally pick the year whose earliest such date is the earliest overall.
