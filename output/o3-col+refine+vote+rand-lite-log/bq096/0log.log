Query:
-- 6. For every year, return the first (earliest) date after January that exceeds 10 sightings
SELECT yr,
       MIN(obs_date) AS first_big_day
FROM (
        SELECT DATE(`eventdate`)             AS obs_date,
               EXTRACT(YEAR FROM `eventdate`) AS yr,
               COUNT(1)                       AS n_sightings
        FROM   `bigquery-public-data.gbif.occurrences`
        WHERE  `species`         = 'Sterna paradisaea'
          AND  `decimallatitude` > 40
          AND  `eventdate`       IS NOT NULL
          AND  EXTRACT(MONTH FROM `eventdate`) > 1   -- after January
        GROUP  BY obs_date, yr
        HAVING n_sightings > 10
     )
GROUP  BY yr
ORDER  BY first_big_day
LIMIT 20;
Answer:
yr,first_big_day
1894,1894-05-23
1910,1910-06-30
1913,1913-07-13
