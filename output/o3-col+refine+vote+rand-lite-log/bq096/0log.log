```sql
-- 1. Preview the different values recorded in `species` that begin with “Sterna”
SELECT DISTINCT `species`
FROM   `bigquery-public-data.gbif.occurrences`
WHERE  LOWER(`species`) LIKE 'sterna%'
LIMIT 20;
```

```sql
-- 2. Check the overall temporal coverage for the target species
SELECT MIN(`year`)   AS first_year,
       MAX(`year`)   AS last_year,
       COUNT(1)      AS total_records
FROM   `bigquery-public-data.gbif.occurrences`
WHERE  `species` = 'Sterna paradisaea';
```

```sql
-- 3. Count how many records of the species lie north of 40° latitude
SELECT COUNT(1) AS north_of_40
FROM   `bigquery-public-data.gbif.occurrences`
WHERE  `species`         = 'Sterna paradisaea'
  AND  `decimallatitude` > 40;
```

```sql
-- 4. Inspect distribution by month to be sure most data are after January
SELECT `year`,
       `month`,
       COUNT(1) AS n_recs
FROM   `bigquery-public-data.gbif.occurrences`
WHERE  `species`         = 'Sterna paradisaea'
  AND  `decimallatitude` > 40
GROUP  BY `year`, `month`
ORDER  BY `year`, `month`
LIMIT 20;
```

```sql
-- 5. Get daily counts of sightings after January, north of 40° latitude
SELECT DATE(`eventdate`)             AS obs_date,
       EXTRACT(YEAR  FROM `eventdate`) AS yr,
       COUNT(1)                       AS n_sightings
FROM   `bigquery-public-data.gbif.occurrences`
WHERE  `species`         = 'Sterna paradisaea'
  AND  `decimallatitude` > 40
  AND  `eventdate`       IS NOT NULL
  AND  EXTRACT(MONTH FROM `eventdate`) > 1      -- after January
GROUP  BY obs_date, yr
ORDER  BY obs_date
LIMIT 20;
```

```sql
-- 6. For every year, return the first (earliest) date after January that exceeds 10 sightings
SELECT yr,
       MIN(obs_date) AS first_big_day
FROM (
        SELECT DATE(`eventdate`)             AS obs_date,
               EXTRACT(YEAR FROM `eventdate`) AS yr,
               COUNT(1)                       AS n_sightings
        FROM   `bigquery-public-data.gbif.occurrences`
        WHERE  `species`         = 'Sterna paradisaea'
          AND  `decimallatitude` > 40
          AND  `eventdate`       IS NOT NULL
          AND  EXTRACT(MONTH FROM `eventdate`) > 1   -- after January
        GROUP  BY obs_date, yr
        HAVING n_sightings > 10
     )
GROUP  BY yr
ORDER  BY first_big_day
LIMIT 20;
```

```sql
-- 7. Identify which year’s `first_big_day` is the earliest of all years
SELECT yr            AS year_with_earliest_date,
       first_big_day AS earliest_date
FROM (
       SELECT yr,
              MIN(obs_date) AS first_big_day
       FROM (
              SELECT DATE(`eventdate`)             AS obs_date,
                     EXTRACT(YEAR FROM `eventdate`) AS yr,
                     COUNT(1)                       AS n_sightings
              FROM   `bigquery-public-data.gbif.occurrences`
              WHERE  `species`         = 'Sterna paradisaea'
                AND  `decimallatitude` > 40
                AND  `eventdate`       IS NOT NULL
                AND  EXTRACT(MONTH FROM `eventdate`) > 1   -- after January
              GROUP  BY obs_date, yr
              HAVING n_sightings > 10
            )
       GROUP  BY yr
     )
ORDER BY earliest_date
LIMIT 1;
```

```sql
-- 8. (Optional validation) Show all years and their first qualifying date,
--    highlighting the one we just found
SELECT *
FROM (
        SELECT yr,
               MIN(obs_date) AS first_big_day
        FROM (
              SELECT DATE(`eventdate`)             AS obs_date,
                     EXTRACT(YEAR FROM `eventdate`) AS yr,
                     COUNT(1)                       AS n_sightings
              FROM   `bigquery-public-data.gbif.occurrences`
              WHERE  `species`         = 'Sterna paradisaea'
                AND  `decimallatitude` > 40
                AND  `eventdate`       IS NOT NULL
                AND  EXTRACT(MONTH FROM `eventdate`) > 1
              GROUP  BY obs_date, yr
              HAVING n_sightings > 10
             )
        GROUP  BY yr
     )
ORDER BY first_big_day
LIMIT 20;
```

The final answer you need is given by query #7, which returns the year whose first post-January date with >10 sightings north of 40° latitude is earlier than any other year.
