Query:
--Description: Restrict to days after January and keep only days with > 10 sightings
SELECT year,
       cal_date,
       n_sightings
FROM (
    SELECT year,
           DATE(eventdate) AS cal_date,
           COUNT(*) AS n_sightings
    FROM `bigquery-public-data.gbif.occurrences`
    WHERE LOWER(scientificname) LIKE 'sterna paradisaea%'
      AND decimallatitude > 40
    GROUP BY year, cal_date
)
WHERE EXTRACT(MONTH FROM cal_date) > 1      -- after January
  AND n_sightings > 10
ORDER BY year, cal_date
LIMIT 20
