```sql
--Description / Thinking process:
--We need, for every year, the earliest calendar date (after January) on which
--Arctic Tern (Sterna paradisaea) had >10 sightings north of 40 ° N.
--Steps:
-- 1) Filter records with scientificname starting “Sterna paradisaea” and latitude >40.
-- 2) Aggregate by (year, DATE(eventdate)) to count daily sightings.
-- 3) In HAVING keep only rows with COUNT(*) >10 and month > 1 (after January).
-- 4) From those, pick MIN(cal_date) per year → first “big day”.
-- 5) Sort by that date so the overall earliest year appears first.
SELECT
  year,
  MIN(cal_date) AS first_big_day
FROM (
  SELECT
    year,
    DATE(eventdate) AS cal_date,
    COUNT(*)        AS n_sightings
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE LOWER(scientificname) LIKE 'sterna paradisaea%'  -- ignore authority text
    AND decimallatitude > 40                             -- north of 40° N
  GROUP BY year, cal_date
  HAVING COUNT(*) > 10                                   -- more than 10 sightings
     AND EXTRACT(MONTH FROM cal_date) > 1                -- after January
)
GROUP BY year
ORDER BY first_big_day
LIMIT 20;
```
