```sql
--Description: Count how many S. paradisaea records occur on each calendar day (north of 40° N)
SELECT year,
       DATE(eventdate) AS cal_date,
       COUNT(*)        AS n_sightings
FROM `bigquery-public-data.gbif.occurrences`
WHERE LOWER(scientificname) = 'sterna paradisaea'
  AND decimallatitude > 40
GROUP BY year, cal_date
ORDER BY year, cal_date
LIMIT 20;
```

```sql
--Description: Restrict to days after January and keep only days with >10 sightings
SELECT year,
       cal_date,
       n_sightings
FROM (
    SELECT year,
           DATE(eventdate) AS cal_date,
           COUNT(*) AS n_sightings
    FROM `bigquery-public-data.gbif.occurrences`
    WHERE LOWER(scientificname) = 'sterna paradisaea'
      AND decimallatitude > 40
    GROUP BY year, cal_date
)
WHERE EXTRACT(MONTH FROM cal_date) > 1      -- after January
  AND n_sightings > 10
ORDER BY year, cal_date
LIMIT 20;
```

```sql
--Description: For every year, pick the first day after January with >10 sightings (north of 40° N)
SELECT year,
       MIN(cal_date) AS first_big_day
FROM (
    SELECT year,
           DATE(eventdate) AS cal_date,
           COUNT(*) AS n_sightings
    FROM `bigquery-public-data.gbif.occurrences`
    WHERE LOWER(scientificname) = 'sterna paradisaea'
      AND decimallatitude > 40
    GROUP BY year, cal_date
    HAVING COUNT(*) > 10                       -- more than 10 sightings
       AND EXTRACT(MONTH FROM DATE(eventdate)) > 1   -- after January
)
GROUP BY year
ORDER BY first_big_day
LIMIT 20;
```

```sql
