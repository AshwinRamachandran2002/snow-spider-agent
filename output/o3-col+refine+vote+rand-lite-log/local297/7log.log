               ELSE (curr.closing_balance - prev.closing_balance)
                    * 100.0 / ABS(prev.closing_balance)
           END AS growth_rate_pct
    FROM ranked AS curr
    LEFT JOIN ranked AS prev
      ON curr.customer_id = prev.customer_id AND prev.rn = 2
    WHERE curr.rn = 1
)
