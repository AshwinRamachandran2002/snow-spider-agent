```sql
-- 1️⃣ Description: Peek at the raw customer_transactions data (first 20 rows)
SELECT *
FROM customer_transactions
LIMIT 20;
```

```sql
-- 2️⃣ Description: What distinct transaction types exist? (e.g. ‘deposit’, ‘withdrawal’)
SELECT DISTINCT txn_type
FROM customer_transactions;
```

```sql
-- 3️⃣ Description: List the first-day-of-month “bucket” we will use 
-- (string slice YYYY-MM-01) together with the original date, to check formatting
SELECT customer_id,
       txn_date,
       SUBSTR(txn_date,1,7)||'-01' AS month_start
FROM customer_transactions
LIMIT 20;
```

```sql
-- 4️⃣ Description: For each customer & month, derive the signed net amount 
-- (deposits +, withdrawals ‑)  
SELECT customer_id,
       SUBSTR(txn_date,1,7)||'-01' AS month_start,
       SUM(CASE WHEN txn_type='deposit'     THEN txn_amount
                WHEN txn_type='withdrawal'  THEN -txn_amount
                ELSE 0 END) AS net_amount
FROM customer_transactions
GROUP BY customer_id,
         SUBSTR(txn_date,1,7)||'-01'
ORDER BY customer_id,
         month_start
LIMIT 20;
```

```sql
-- 5️⃣ Description: Calculate each customer’s cumulative closing balance 
-- after every month
WITH monthly_net AS (
    SELECT customer_id,
           SUBSTR(txn_date,1,7)||'-01' AS month_start,
           SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                    WHEN txn_type='withdrawal' THEN -txn_amount
                    ELSE 0 END) AS net_amount
    FROM customer_transactions
    GROUP BY customer_id, SUBSTR(txn_date,1,7)||'-01'
)
SELECT customer_id,
       month_start,
       net_amount,
       SUM(net_amount) OVER (PARTITION BY customer_id
                             ORDER BY month_start) AS closing_balance
FROM monthly_net
ORDER BY customer_id, month_start
LIMIT 20;
```

```sql
-- 6️⃣ Description: For each customer, find the most recent two months, their 
-- closing balances and compute the growth rate
WITH monthly_net AS (
    SELECT customer_id,
           SUBSTR(txn_date,1,7)||'-01' AS month_start,
           SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                    WHEN txn_type='withdrawal' THEN -txn_amount
                    ELSE 0 END) AS net_amount
    FROM customer_transactions
    GROUP BY customer_id, SUBSTR(txn_date,1,7)||'-01'
),
running_bal AS (
    SELECT customer_id,
           month_start,
           SUM(net_amount) OVER (PARTITION BY customer_id
                                 ORDER BY month_start) AS closing_balance
    FROM monthly_net
),
ranked AS (
    SELECT customer_id,
           month_start,
           closing_balance,
           ROW_NUMBER() OVER (PARTITION BY customer_id
                              ORDER BY month_start DESC) AS rn
    FROM running_bal
)
SELECT curr.customer_id,
       curr.month_start        AS most_recent_month,
       curr.closing_balance    AS current_balance,
       prev.closing_balance    AS prev_balance,
       CASE 
            WHEN prev.closing_balance = 0 OR prev.closing_balance IS NULL
                 THEN curr.closing_balance * 100.0
            ELSE (curr.closing_balance - prev.closing_balance)
                 * 100.0 / ABS(prev.closing_balance)
       END AS growth_rate_pct
FROM ranked AS curr
LEFT JOIN ranked AS prev
  ON curr.customer_id = prev.customer_id
 AND prev.rn = 2
WHERE curr.rn = 1
LIMIT 20;
```

```sql
-- 7️⃣ Description: Count customers whose most recent month’s growth rate > 5%
WITH monthly_net AS (
    SELECT customer_id,
           SUBSTR(txn_date,1,7)||'-01' AS month_start,
           SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                    WHEN txn_type='withdrawal' THEN -txn_amount
                    ELSE 0 END) AS net_amount
    FROM customer_transactions
    GROUP BY customer_id, SUBSTR(txn_date,1,7)||'-01'
),
running_bal AS (
    SELECT customer_id,
           month_start,
           SUM(net_amount) OVER (PARTITION BY customer_id
                                 ORDER BY month_start) AS closing_balance
    FROM monthly_net
),
ranked AS (
    SELECT customer_id,
           month_start,
           closing_balance,
           ROW_NUMBER() OVER (PARTITION BY customer_id
                              ORDER BY month_start DESC) AS rn
    FROM running_bal
),
growth AS (
    SELECT curr.customer_id,
           CASE 
               WHEN prev.closing_balance = 0 OR prev.closing_balance IS NULL
                    THEN curr.closing_balance * 100.0
               ELSE (curr.closing_balance - prev.closing_balance)
                    * 100.0 / ABS(prev.closing_balance)
           END AS growth_rate_pct
    FROM ranked AS curr
    LEFT JOIN ranked AS prev
      ON curr.customer_id = prev.customer_id AND prev.rn = 2
    WHERE curr.rn = 1
)
SELECT COUNT(*) AS customers_growth_gt_5,
       (SELECT COUNT(DISTINCT customer_id) FROM customer_transactions) AS total_customers,
       100.0 * COUNT(*) / (SELECT COUNT(DISTINCT customer_id)
                           FROM customer_transactions) AS pct_customers_gt_5
FROM growth
WHERE growth_rate_pct > 5.0;
```

```sql
-- 8️⃣ Description: Show which customer_ids make up the growth->5% cohort
WITH monthly_net AS (
    SELECT customer_id,
           SUBSTR(txn_date,1,7)||'-01' AS month_start,
           SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                    WHEN txn_type='withdrawal' THEN -txn_amount
                    ELSE 0 END) AS net_amount
    FROM customer_transactions
    GROUP BY customer_id, SUBSTR(txn_date,1,7)||'-01'
),
running_bal AS (
    SELECT customer_id,
           month_start,
           SUM(net_amount) OVER (PARTITION BY customer_id
                                 ORDER BY month_start) AS closing_balance
    FROM monthly_net
),
ranked AS (
    SELECT customer_id,
           month_start,
           closing_balance,
           ROW_NUMBER() OVER (PARTITION BY customer_id
                              ORDER BY month_start DESC) AS rn
    FROM running_bal
),
growth AS (
    SELECT curr.customer_id,
           CASE 
               WHEN prev.closing_balance = 0 OR prev.closing_balance IS NULL
                    THEN curr.closing_balance * 100.0
               ELSE (curr.closing_balance - prev.closing_balance)
                    * 100.0 / ABS(prev.closing_balance)
           END AS growth_rate_pct
    FROM ranked AS curr
    LEFT JOIN ranked AS prev
      ON curr.customer_id = prev.customer_id AND prev.rn = 2
    WHERE curr.rn = 1
)
SELECT DISTINCT customer_id
FROM growth
WHERE growth_rate_pct > 5.0
LIMIT 20;
