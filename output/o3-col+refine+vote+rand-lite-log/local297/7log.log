-- 5️⃣ Description: Calculate each customer’s cumulative closing balance 
-- after every month
WITH monthly_net AS (
    SELECT customer_id,
           SUBSTR(txn_date,1,7)||'-01' AS month_start,
           SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                    WHEN txn_type='withdrawal' THEN -txn_amount
                    ELSE 0 END) AS net_amount
    FROM customer_transactions
    GROUP BY customer_id, SUBSTR(txn_date,1,7)||'-01'
)
SELECT customer_id,
       month_start,
       net_amount,
       SUM(net_amount) OVER (PARTITION BY customer_id
                             ORDER BY month_start) AS closing_balance
FROM monthly_net
ORDER BY customer_id, month_start
LIMIT 20;
