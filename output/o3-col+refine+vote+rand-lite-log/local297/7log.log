```sql
-- 9️⃣ Description: Quick sanity check – distribution of growth rate buckets
WITH monthly_net AS (
    SELECT customer_id,
           SUBSTR(txn_date,1,7)||'-01' AS month_start,
           SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                    WHEN txn_type='withdrawal' THEN -txn_amount
                    ELSE 0 END) AS net_amount
    FROM customer_transactions
    GROUP BY customer_id, SUBSTR(txn_date,1,7)||'-01'
),
running_bal AS (
    SELECT customer_id,
           month_start,
           SUM(net_amount) OVER (PARTITION BY customer_id
                                 ORDER BY month_start) AS closing_balance
    FROM monthly_net
),
ranked AS (
    SELECT customer_id,
           month_start,
           closing_balance,
           ROW_NUMBER() OVER (PARTITION BY customer_id
                              ORDER BY month_start DESC) AS rn
    FROM running_bal
),
growth AS (
    SELECT curr.customer_id,
           CASE 
               WHEN prev.closing_balance = 0 OR prev.closing_balance IS NULL
                    THEN curr.closing_balance * 100.0
               ELSE (curr.closing_balance - prev.closing_balance)
                    * 100.0 / ABS(prev.closing_balance)
           END AS growth_rate_pct
    FROM ranked AS curr
    LEFT JOIN ranked AS prev
      ON curr.customer_id = prev.customer_id AND prev.rn = 2
    WHERE curr.rn = 1
)
SELECT 
  CASE 
      WHEN growth_rate_pct <=  0 THEN '<=0%'
      WHEN growth_rate_pct <=  5 THEN '0-5%'
      WHEN growth_rate_pct <= 25 THEN '5-25%'
      WHEN growth_rate_pct <= 50 THEN '25-50%'
      ELSE '>50%'
  END AS bucket,
  COUNT(*) AS customers
FROM growth
GROUP BY bucket
ORDER BY bucket;
```

```sql
-- 🔟 Description: The core query again, returning only the final percentage figure 
-- (useful if you just want the answer)
WITH monthly_net AS (
    SELECT customer_id,
           SUBSTR(txn_date,1,7)||'-01' AS month_start,
           SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                    WHEN txn_type='withdrawal' THEN -txn_amount
                    ELSE 0 END) AS net_amount
    FROM customer_transactions
    GROUP BY customer_id, SUBSTR(txn_date,1,7)||'-01'
),
running_bal AS (
    SELECT customer_id,
           month_start,
           SUM(net_amount) OVER (PARTITION BY customer_id
                                 ORDER BY month_start) AS closing_balance
    FROM monthly_net
),
ranked AS (
    SELECT customer_id,
           month_start,
           closing_balance,
           ROW_NUMBER() OVER (PARTITION BY customer_id
                              ORDER BY month_start DESC) AS rn
    FROM running_bal
),
growth AS (
    SELECT curr.customer_id,
           CASE 
               WHEN prev.closing_balance = 0 OR prev.closing_balance IS NULL
                    THEN curr.closing_balance * 100.0
               ELSE (curr.closing_balance - prev.closing_balance)
                    * 100.0 / ABS(prev.closing_balance)
           END AS growth_rate_pct
    FROM ranked AS curr
    LEFT JOIN ranked AS prev
      ON curr.customer_id = prev.customer_id AND prev.rn = 2
    WHERE curr.rn = 1
)
SELECT ROUND(100.0 * SUM(CASE WHEN growth_rate_pct > 5 THEN 1 ELSE 0 END)
                 / COUNT(*), 2) AS pct_customers_gt_5
FROM growth;
```
