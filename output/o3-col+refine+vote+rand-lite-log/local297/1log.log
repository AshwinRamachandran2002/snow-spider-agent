```sql
-- Description: inspect a handful of raw transactions (date, type, amount) to see positive/negative amounts
SELECT "customer_id",
       "txn_date",
       "txn_type",
       "txn_amount"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- Description: view the first–day-of-month bucket each transaction falls into
SELECT "customer_id",
       "txn_date",
       strftime('%Y-%m-01', "txn_date") AS "month_start"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- Description: compute monthly net (deposits – withdrawals) for a sample customer (e.g. id = 1)
SELECT strftime('%Y-%m-01', "txn_date") AS "month_start",
       SUM(CASE WHEN "txn_type" = 'deposit'     THEN  "txn_amount"
                WHEN "txn_type" = 'withdrawal'  THEN - "txn_amount"
           END) AS "monthly_net"
FROM   "customer_transactions"
WHERE  "customer_id" = 1
GROUP  BY "month_start"
ORDER  BY "month_start"
LIMIT 20;
```

```sql
-- Description: running (cumulative) month-end balance for the same sample customer
SELECT "month_start",
       SUM("monthly_net") OVER (ORDER BY "month_start") AS "closing_balance"
FROM  (
        SELECT strftime('%Y-%m-01', "txn_date") AS "month_start",
               SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                        WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                   END) AS "monthly_net"
        FROM   "customer_transactions"
        WHERE  "customer_id" = 1
        GROUP  BY "month_start"
      )
ORDER BY "month_start"
LIMIT 20;
```

```sql
-- Description: for every customer, derive each month’s closing balance
WITH monthly AS (
      SELECT "customer_id",
             strftime('%Y-%m-01', "txn_date") AS "month_start",
             SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                      WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                 END) AS "monthly_net"
      FROM   "customer_transactions"
      GROUP  BY "customer_id", "month_start"
)
SELECT "customer_id",
       "month_start",
       SUM("monthly_net") OVER (PARTITION BY "customer_id"
                                ORDER BY "month_start") AS "closing_balance"
FROM   monthly
ORDER  BY "customer_id", "month_start"
LIMIT 20;
```

```sql
-- Description: pick each customer’s most-recent and prior-month balances, side by side
WITH monthly AS (
      SELECT "customer_id",
             strftime('%Y-%m-01', "txn_date") AS "month_start",
             SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                      WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                 END) AS "monthly_net"
      FROM   "customer_transactions"
      GROUP  BY "customer_id", "month_start"
),
closing AS (
      SELECT "customer_id",
             "month_start",
             SUM("monthly_net") OVER (PARTITION BY "customer_id"
                                      ORDER BY "month_start") AS "closing_balance"
      FROM   monthly
),
latest AS (
      SELECT  c.*,
              LAG("closing_balance") OVER (PARTITION BY "customer_id"
                                           ORDER BY "month_start") AS "prev_balance"
      FROM    closing c
)
SELECT * 
FROM   latest
WHERE  "month_start" = (SELECT MAX("month_start")
                        FROM   closing AS x
                        WHERE  x."customer_id" = latest."customer_id")
LIMIT 20;
```

```sql
-- Description: calculate growth rate for the most-recent month of every customer
WITH monthly AS (
      SELECT "customer_id",
             strftime('%Y-%m-01', "txn_date") AS "month_start",
             SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                      WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                 END) AS "monthly_net"
      FROM   "customer_transactions"
      GROUP  BY "customer_id", "month_start"
),
closing AS (
      SELECT "customer_id",
             "month_start",
             SUM("monthly_net") OVER (PARTITION BY "customer_id"
                                      ORDER BY "month_start") AS "closing_balance"
      FROM   monthly
),
latest AS (
      SELECT  c."customer_id",
              c."month_start",
              c."closing_balance",
              LAG(c."closing_balance") OVER (PARTITION BY c."customer_id"
                                             ORDER BY c."month_start") AS "prev_balance"
      FROM    closing c
),
growth AS (
      SELECT "customer_id",
             "closing_balance",
             "prev_balance",
             CASE 
                 WHEN "prev_balance" = 0 OR "prev_balance" IS NULL
                      THEN ("closing_balance" * 100.0)
                 ELSE (("closing_balance" - "prev_balance") * 100.0) / ABS("prev_balance")
             END AS "growth_pct"
      FROM   latest
      WHERE  "month_start" = (SELECT MAX("month_start")
                              FROM   closing AS x
                              WHERE  x."customer_id" = latest."customer_id")
)
SELECT * 
FROM   growth
LIMIT 20;
```

```sql
-- Description: final percentage of customers whose most-recent growth rate exceeds 5%
WITH monthly AS (
      SELECT "customer_id",
             strftime('%Y-%m-01', "txn_date") AS "month_start",
             SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                      WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                 END) AS "monthly_net"
      FROM   "customer_transactions"
      GROUP  BY "customer_id", "month_start"
),
closing AS (
      SELECT "customer_id",
             "month_start",
             SUM("monthly_net") OVER (PARTITION BY "customer_id"
                                      ORDER BY "month_start") AS "closing_balance"
      FROM   monthly
),
latest AS (
      SELECT  c."customer_id",
              c."month_start",
              c."closing_balance",
              LAG(c."closing_balance") OVER (PARTITION BY c."customer_id"
                                             ORDER BY c."month_start") AS "prev_balance"
      FROM    closing c
),
growth AS (
      SELECT "customer_id",
             CASE 
                 WHEN "prev_balance" = 0 OR "prev_balance" IS NULL
                      THEN ("closing_balance" * 100.0)
                 ELSE (("closing_balance" - "prev_balance") * 100.0) / ABS("prev_balance")
             END AS "growth_pct"
      FROM   latest
      WHERE  "month_start" = (SELECT MAX("month_start")
                              FROM   closing AS x
                              WHERE  x."customer_id" = latest."customer_id")
)
SELECT ROUND(100.0 * SUM(CASE WHEN "growth_pct" > 5 THEN 1 ELSE 0 END)
                   / COUNT(*), 2) AS "percent_growth_gt_5"
FROM   growth;
```
