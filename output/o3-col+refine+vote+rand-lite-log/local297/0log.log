--Description: Add a running total (closing balance) for each customer by first
--             computing the signed monthly net (+deposit, –withdrawal) and then
--             applying a window-SUM.  Preview 20 rows.
SELECT
    m."customer_id",
    m."month",
    m."monthly_net",
    SUM(m."monthly_net") OVER (
        PARTITION BY m."customer_id"
        ORDER BY      m."month"
    ) AS "closing_balance"
FROM (
    SELECT
        "customer_id",
        substr("txn_date",1,7) AS "month",
        SUM(
            CASE
                 WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                 WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
                 ELSE 0
            END
        ) AS "monthly_net"
    FROM   "customer_transactions"
    GROUP BY
        "customer_id",
        substr("txn_date",1,7)
) AS m
LIMIT 20
