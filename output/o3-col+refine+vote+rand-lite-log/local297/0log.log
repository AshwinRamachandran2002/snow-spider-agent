--Description: Final answer – percentage of customers whose latest month shows
--             a growth rate above 5 %.  Proper aliasing and rn = 1 filter
--             ensure only the most-recent month per customer is considered.
SELECT
    ROUND(
        100.0 * SUM(CASE WHEN latest."growth_rate" > 5 THEN 1 ELSE 0 END) /
        COUNT(*),
        2
    ) AS "pct_customers_growth_gt_5"
FROM (
    SELECT
        latest_inner."customer_id",
        CASE
            WHEN COALESCE(latest_inner."prev_balance",0) = 0
                 THEN latest_inner."closing_balance"*100.0
            ELSE (latest_inner."closing_balance" - latest_inner."prev_balance")*100.0 /
                 ABS(latest_inner."prev_balance")
        END AS "growth_rate"
    FROM (
        SELECT
            cb."customer_id",
            cb."month",
            cb."closing_balance",
            LAG(cb."closing_balance") OVER (
                PARTITION BY cb."customer_id"
                ORDER BY      cb."month"
            ) AS "prev_balance",
            ROW_NUMBER() OVER (
                PARTITION BY cb."customer_id"
                ORDER BY      cb."month" DESC
            ) AS rn
        FROM (
            SELECT
                mn."customer_id",
                mn."month",
                SUM(mn."monthly_net") OVER (
                    PARTITION BY mn."customer_id"
                    ORDER BY      mn."month"
                ) AS "closing_balance"
            FROM (
                SELECT
                    "customer_id",
                    substr("txn_date",1,7) AS "month",
                    SUM(
                        CASE
                             WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                             WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
                             ELSE 0
                        END
                    ) AS "monthly_net"
                FROM   "customer_transactions"
                GROUP BY
                    "customer_id",
                    substr("txn_date",1,7)
            ) AS mn
        ) AS cb
    ) AS latest_inner
    WHERE latest_inner.rn = 1
) AS latest
