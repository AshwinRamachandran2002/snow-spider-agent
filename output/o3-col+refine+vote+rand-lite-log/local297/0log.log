Query:
--Description: Count how many customers have a growth rate > 5 % in their most
--             recent month.  All subqueries are properly aliased.
SELECT COUNT(*) AS "customers_growth_above_5"
FROM (
    SELECT
        latest."customer_id",
        CASE
            WHEN COALESCE(latest."prev_balance",0) = 0
                 THEN latest."closing_balance"*100.0
            ELSE (latest."closing_balance" - latest."prev_balance")*100.0 /
                 ABS(latest."prev_balance")
        END AS "growth_rate"
    FROM (
        SELECT
            cb."customer_id",
            cb."month",
            cb."closing_balance",
            LAG(cb."closing_balance") OVER (
                PARTITION BY cb."customer_id"
                ORDER BY      cb."month"
            ) AS "prev_balance",
            ROW_NUMBER() OVER (
                PARTITION BY cb."customer_id"
                ORDER BY      cb."month" DESC
            ) AS rn
        FROM (
            SELECT
                mn."customer_id",
                mn."month",
                SUM(mn."monthly_net") OVER (
                    PARTITION BY mn."customer_id"
                    ORDER BY      mn."month"
                ) AS "closing_balance"
            FROM (
                SELECT
                    "customer_id",
                    substr("txn_date",1,7) AS "month",
                    SUM(
                        CASE
                             WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                             WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
                             ELSE 0
                        END
                    ) AS "monthly_net"
                FROM   "customer_transactions"
                GROUP BY
                    "customer_id",
                    substr("txn_date",1,7)
            ) AS mn
        ) AS cb
    ) AS latest
    WHERE latest.rn = 1
) AS g
WHERE g."growth_rate" > 5
