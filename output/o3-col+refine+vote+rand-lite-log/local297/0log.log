                                 substr("txn_date",1,7)
                )
        )
)
WHERE  rn = 1
LIMIT 20;
```

```sql
-- 7. Compute the growth rate for those most-recent months  
--    (special rule when previous balance = 0)
SELECT  "customer_id",
        "month",
        "closing_balance",
        COALESCE("prev_balance",0)          AS "prev_balance",
        CASE
             WHEN COALESCE("prev_balance",0)=0
                  THEN "closing_balance"*100.0
             ELSE ("closing_balance"-"prev_balance")*100.0/
                  ABS("prev_balance")
        END                                AS "growth_rate"
FROM  (
        SELECT  "customer_id",
                "month",
                "closing_balance",
                LAG("closing_balance") OVER
                     (PARTITION BY "customer_id"
                      ORDER BY      "month")     AS "prev_balance",
                ROW_NUMBER() OVER
                     (PARTITION BY "customer_id"
                      ORDER BY      "month" DESC) AS rn
        FROM   (
                SELECT  "customer_id",
                        "month",
                        SUM("monthly_net") OVER
                             (PARTITION BY "customer_id"
                              ORDER BY      "month") AS "closing_balance"
                FROM   (
                        SELECT  "customer_id",
                                substr("txn_date",1,7) AS "month",
                                SUM(CASE WHEN "txn_type"='deposit'
                                         THEN  "txn_amount"
                                         ELSE - "txn_amount" END) AS "monthly_net"
                        FROM    "customer_transactions"
                        GROUP BY "customer_id",
                                 substr("txn_date",1,7)
                )
        )
)
WHERE  rn = 1
LIMIT 20;
```

```sql
-- 8. How many customers enjoy >5 % growth in their latest month?
SELECT COUNT(*) AS "customers_growth_above_5"
