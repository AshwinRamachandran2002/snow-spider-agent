--Description: Show each customer’s month-end balance together with the previous
--             month’s balance so later we can calculate growth rates.  The
--             subqueries now have proper aliases.
SELECT
    cb."customer_id",
    cb."month",
    cb."closing_balance",
    LAG(cb."closing_balance") OVER (
        PARTITION BY cb."customer_id"
        ORDER BY      cb."month"
    ) AS "prev_balance"
FROM (
    SELECT
        mn."customer_id",
        mn."month",
        SUM(mn."monthly_net") OVER (
            PARTITION BY mn."customer_id"
            ORDER BY      mn."month"
        ) AS "closing_balance"
    FROM (
        SELECT
            "customer_id",
            substr("txn_date",1,7) AS "month",
            SUM(
                CASE
                     WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                     WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
                     ELSE 0
                END
            ) AS "monthly_net"
        FROM   "customer_transactions"
        GROUP BY
            "customer_id",
            substr("txn_date",1,7)
    ) AS mn
) AS cb
LIMIT 20
