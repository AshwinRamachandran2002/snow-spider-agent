--Description: Isolate the most-recent month for every customer with both the
--             closing balance and the previous balance; attach a row number so
--             we can pick rn = 1 (latest).  Proper aliases added at every level.
SELECT *
FROM (
    SELECT
        cb."customer_id",
        cb."month",
        cb."closing_balance",
        LAG(cb."closing_balance") OVER (
            PARTITION BY cb."customer_id"
            ORDER BY      cb."month"
        ) AS "prev_balance",
        ROW_NUMBER() OVER (
            PARTITION BY cb."customer_id"
            ORDER BY      cb."month" DESC
        ) AS rn
    FROM (
        SELECT
            mn."customer_id",
            mn."month",
            SUM(mn."monthly_net") OVER (
                PARTITION BY mn."customer_id"
                ORDER BY      mn."month"
            ) AS "closing_balance"
        FROM (
            SELECT
                "customer_id",
                substr("txn_date",1,7) AS "month",
                SUM(
                    CASE
                         WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                         WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
                         ELSE 0
                    END
                ) AS "monthly_net"
            FROM   "customer_transactions"
            GROUP BY
                "customer_id",
                substr("txn_date",1,7)
        ) AS mn
    ) AS cb
) AS final
WHERE final.rn = 1
LIMIT 20
