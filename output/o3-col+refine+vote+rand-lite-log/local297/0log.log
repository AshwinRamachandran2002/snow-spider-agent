            mn."month",
            SUM(mn."monthly_net") OVER (
                PARTITION BY mn."customer_id"
                ORDER BY      mn."month"
            ) AS "closing_balance"
        FROM (
            SELECT
                "customer_id",
                substr("txn_date",1,7) AS "month",
                SUM(
                    CASE
                         WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                         WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
                         ELSE 0
                    END
