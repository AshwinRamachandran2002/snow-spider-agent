```sql
--Description: End-to-end calculation in one shot  
-- 1) “monthly_net” – sum signed deposits (+) & withdrawals (–) per customer-month  
-- 2) “running_bal” – cumulative closing balance per month using a window SUM  
-- 3) “latest”      – fetch each customer’s most-recent month plus previous balance  
-- 4) Final SELECT  – compute growth-rate with special zero-division rule, then
--                   return the % of customers whose latest-month growth > 5 %.
WITH monthly_net AS (
    SELECT  "customer_id",
            substr("txn_date",1,7)                        AS "month",
            SUM(
                CASE
                    WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                    WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
                    ELSE 0
                END
            )                                            AS "monthly_net"
    FROM    "customer_transactions"
    GROUP BY "customer_id",
             substr("txn_date",1,7)
),
running_bal AS (
    SELECT  "customer_id",
            "month",
            "monthly_net",
            SUM("monthly_net") OVER (
                PARTITION BY "customer_id"
                ORDER BY      "month"
            )                                            AS "closing_balance"
    FROM    monthly_net
),
latest AS (
    SELECT  "customer_id",
            "month",
            "closing_balance",
            LAG("closing_balance") OVER (
                PARTITION BY "customer_id"
                ORDER BY      "month"
            )                                            AS "prev_balance",
            ROW_NUMBER() OVER (
                PARTITION BY "customer_id"
                ORDER BY      "month" DESC
            )                                            AS rn
    FROM    running_bal
)
SELECT  ROUND(
            100.0 * SUM(CASE 
                            WHEN
                                CASE
                                    WHEN COALESCE("prev_balance",0)=0
                                         THEN "closing_balance"*100.0
                                    ELSE ("closing_balance"-"prev_balance")*100.0/
                                         ABS("prev_balance")
                                END  > 5
                            THEN 1 ELSE 0 END
            ) / COUNT(*)
        , 2)                                           AS "pct_customers_growth_gt_5"
FROM    latest
WHERE   rn = 1;
```
