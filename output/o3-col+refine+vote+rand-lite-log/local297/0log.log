```sql
-- 2. Check all possible transaction directions
SELECT DISTINCT "txn_type"
FROM "customer_transactions";
```

```sql
-- 3. Derive each customer’s signed net movement per calendar month  
--    (deposit = +amount, withdrawal = –amount)
SELECT  "customer_id",
        substr("txn_date",1,7) AS "month",
        SUM(CASE WHEN "txn_type" = 'deposit'
                 THEN  "txn_amount"
                 ELSE - "txn_amount" END)         AS "monthly_net"
FROM    "customer_transactions"
GROUP BY "customer_id",
         substr("txn_date",1,7")
LIMIT 20;
```

```sql
-- 4. Add a running total so we can see the closing balance
SELECT  "customer_id",
        "month",
        "monthly_net",
        SUM("monthly_net") OVER
            (PARTITION BY "customer_id"
             ORDER BY      "month")              AS "closing_balance"
FROM   (
        SELECT  "customer_id",
                substr("txn_date",1,7) AS "month",
                SUM(CASE WHEN "txn_type"='deposit'
                         THEN  "txn_amount"
                         ELSE - "txn_amount" END) AS "monthly_net"
        FROM    "customer_transactions"
        GROUP BY "customer_id",
                 substr("txn_date",1,7)
) m
LIMIT 20;
```

```sql
-- 5. Keep both the current and previous month’s balances for every customer
SELECT  "customer_id",
        "month",
        "closing_balance",
        LAG("closing_balance") OVER
             (PARTITION BY "customer_id"
              ORDER BY      "month")             AS "prev_balance"
FROM   (
        SELECT  "customer_id",
                "month",
                SUM("monthly_net") OVER
                     (PARTITION BY "customer_id"
                      ORDER BY      "month")     AS "closing_balance"
        FROM   (
                SELECT  "customer_id",
                        substr("txn_date",1,7)   AS "month",
                        SUM(CASE WHEN "txn_type"='deposit'
                                 THEN  "txn_amount"
                                 ELSE - "txn_amount" END) AS "monthly_net"
                FROM    "customer_transactions"
                GROUP BY "customer_id",
                         substr("txn_date",1,7)
        )
)
LIMIT 20;
```

```sql
-- 6. Isolate each customer’s most-recent month
SELECT *
FROM  (
        SELECT  "customer_id",
                "month",
                "closing_balance",
                LAG("closing_balance") OVER
                     (PARTITION BY "customer_id"
                      ORDER BY      "month")     AS "prev_balance",
                ROW_NUMBER() OVER
