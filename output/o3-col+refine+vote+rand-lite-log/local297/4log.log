```sql
--Description:
-- Goal: % of customers whose most-recent month’s balance grew >5 %.
-- Logical steps embedded into CTE layers:
--  1. monthly   – bucket every deposit (+) & withdrawal (–) into YYYY-MM and net them.
--  2. balances  – cumulative SUM per customer to get closing balance each month.
--  3. ranked    – label each customer’s months newest→oldest (rnk=1 latest, rnk=2 prior).
--  4. growth    – for each customer compute growth rate:
--        • if prev_balance IS NULL or =0 → growth = latest_balance*100
--        • else                           → (latest-prev)*100/prev
--  5. final     – percentage of customers with growth_rate >5.
WITH monthly AS (
    SELECT
        customer_id,
        substr(txn_date, 1, 7) AS year_month,
        SUM(CASE
                WHEN txn_type = 'deposit'    THEN  txn_amount
                WHEN txn_type = 'withdrawal' THEN -txn_amount
            END) AS monthly_net
    FROM customer_transactions
    WHERE txn_type IN ('deposit', 'withdrawal')
    GROUP BY customer_id, year_month
),
balances AS (
    SELECT
        customer_id,
        year_month,
        monthly_net,
        SUM(monthly_net) OVER (PARTITION BY customer_id
                               ORDER BY year_month) AS closing_balance
    FROM monthly
),
ranked AS (
    SELECT
        customer_id,
        year_month,
        closing_balance,
        ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY year_month DESC) AS rnk
    FROM balances
),
growth AS (
    SELECT
        cur.customer_id,
        cur.closing_balance                    AS latest_bal,
        prev.closing_balance                   AS prev_bal,
        CASE
            WHEN IFNULL(prev.closing_balance,0)=0
                 THEN cur.closing_balance * 100.0
            ELSE (cur.closing_balance - prev.closing_balance) * 100.0 / prev.closing_balance
        END AS growth_rate
    FROM ranked AS cur
    LEFT JOIN ranked AS prev
           ON cur.customer_id = prev.customer_id
          AND prev.rnk = 2
    WHERE cur.rnk = 1
)
SELECT ROUND(100.0 * SUM(CASE WHEN growth_rate > 5 THEN 1 ELSE 0 END) / COUNT(*), 2)
       AS percentage_customers_growth_gt_5
FROM growth;
```
