Query:
--Description: Derive running (closing) balance by month for the same customer using a window SUM
SELECT "year_month",
       "monthly_net",
       SUM("monthly_net") OVER (ORDER BY "year_month") AS "closing_balance"
FROM  (
        SELECT substr("txn_date", 1, 7) AS "year_month",
               SUM(CASE WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                        WHEN "txn_type" = 'withdrawal' THEN - "txn_amount" END) AS "monthly_net"
        FROM   "customer_transactions"
        WHERE  "customer_id" = 1
        GROUP  BY substr("txn_date", 1, 7)
      )
LIMIT 20;
