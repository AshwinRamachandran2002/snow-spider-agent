Query:
--Description: Calculate monthly net amount (deposits – withdrawals) for a sample customer (e.g., id = 1)
SELECT substr("txn_date", 1, 7) AS "year_month",
       SUM(CASE WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                WHEN "txn_type" = 'withdrawal' THEN - "txn_amount" END) AS "monthly_net"
FROM   "customer_transactions"
WHERE  "customer_id" = 1
GROUP  BY substr("txn_date", 1, 7)
ORDER  BY "year_month"
LIMIT 20;
