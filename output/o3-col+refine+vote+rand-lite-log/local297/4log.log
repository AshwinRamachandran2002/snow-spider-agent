```sql
--Description: Compute each customer’s most recent month, prior month, and the growth rate
WITH monthly AS (
  SELECT "customer_id",
         substr("txn_date", 1, 7) AS "year_month",
         SUM(CASE WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                  WHEN "txn_type" = 'withdrawal' THEN - "txn_amount" END) AS "monthly_net"
  FROM   "customer_transactions"
  GROUP  BY "customer_id", substr("txn_date", 1, 7)
),
running AS (
  SELECT "customer_id",
         "year_month",
         "monthly_net",
         SUM("monthly_net") OVER (PARTITION BY "customer_id"
                                  ORDER BY "year_month") AS "closing_balance"
  FROM   monthly
),
ranked AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY "customer_id"
                            ORDER BY "year_month" DESC) AS rnk
  FROM   running
)
SELECT cur."customer_id",
       cur."year_month"          AS "latest_month",
       cur."closing_balance"     AS "latest_balance",
       prev."closing_balance"    AS "prev_balance",
       ROUND(
         CASE
           WHEN prev."closing_balance" = 0 OR prev."closing_balance" IS NULL
             THEN cur."closing_balance" * 100.0
           ELSE (cur."closing_balance" - prev."closing_balance")
                * 100.0 / prev."closing_balance"
         END, 2
       )                         AS "growth_rate_%"
FROM   ranked  AS cur
LEFT   JOIN ranked AS prev
       ON  cur."customer_id" = prev."customer_id"
       AND prev.rnk = 2
WHERE  cur.rnk = 1
LIMIT 20;
```

```sql
--Description: Count the customers whose latest growth rate exceeds 5 %
WITH monthly AS (
  SELECT "customer_id",
         substr("txn_date", 1, 7) AS "year_month",
         SUM(CASE WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                  WHEN "txn_type" = 'withdrawal' THEN - "txn_amount" END) AS "monthly_net"
  FROM   "customer_transactions"
  GROUP  BY "customer_id", substr("txn_date", 1, 7)
),
running AS (
  SELECT "customer_id",
         "year_month",
         SUM("monthly_net") OVER (PARTITION BY "customer_id"
                                  ORDER BY "year_month") AS "closing_balance"
  FROM   monthly
),
ranked AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY "customer_id"
                            ORDER BY "year_month" DESC) AS rnk
  FROM   running
),
growth AS (
  SELECT cur."customer_id",
         cur."closing_balance"     AS "latest_bal",
         prev."closing_balance"    AS "prev_bal",
         CASE
           WHEN prev."closing_balance" = 0 OR prev."closing_balance" IS NULL
             THEN cur."closing_balance" * 100.0
           ELSE (cur."closing_balance" - prev."closing_balance") * 100.0 / prev."closing_balance"
         END                       AS "growth_rate"
  FROM   ranked AS cur
  LEFT   JOIN ranked AS prev
         ON  cur."customer_id" = prev."customer_id"
         AND prev.rnk = 2
  WHERE  cur.rnk = 1
)
SELECT 
       SUM(CASE WHEN "growth_rate" > 5 THEN 1 END) * 100.0 
       / COUNT(*) AS "pct_customers_growth_gt_5"
FROM   growth
LIMIT 20;
```

