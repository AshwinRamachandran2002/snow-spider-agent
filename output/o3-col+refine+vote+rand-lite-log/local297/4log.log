```sql
--Description: Compute each customer’s most-recent and previous closing balances, then derive
--             the individual growth rate (%).  Deposits are positive, withdrawals negative.
WITH monthly AS (
    SELECT
        customer_id,
        substr(txn_date, 1, 7) AS year_month,
        SUM(
            CASE
                WHEN txn_type = 'deposit'    THEN  txn_amount
                WHEN txn_type = 'withdrawal' THEN -txn_amount
            END
        ) AS monthly_net
    FROM customer_transactions
    WHERE txn_type IN ('deposit','withdrawal')
    GROUP BY customer_id, year_month
),
running_bal AS (
    SELECT
        customer_id,
        year_month,
        monthly_net,
        SUM(monthly_net) OVER (PARTITION BY customer_id ORDER BY year_month) AS closing_balance
    FROM monthly
),
ranked AS (
    SELECT
        customer_id,
        year_month,
        closing_balance,
        ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY year_month DESC) AS rnk
    FROM running_bal
)
SELECT
    cur.customer_id,
    cur.year_month               AS latest_month,
    cur.closing_balance          AS latest_balance,
    prev.closing_balance         AS prev_balance,
    ROUND(
        CASE
            WHEN IFNULL(prev.closing_balance,0)=0
                 THEN cur.closing_balance * 100.0
            ELSE (cur.closing_balance - prev.closing_balance)
                 * 100.0 / prev.closing_balance
        END, 2
    ) AS growth_rate_pct
FROM ranked AS cur
LEFT JOIN ranked AS prev
       ON cur.customer_id = prev.customer_id
      AND prev.rnk        = 2
WHERE cur.rnk = 1
LIMIT 20;
```

```sql
--Description: Count customers whose most-recent month’s growth rate exceeds 5 %.
WITH monthly AS (
    SELECT
        customer_id,
        substr(txn_date, 1, 7) AS year_month,
        SUM(
            CASE
                WHEN txn_type = 'deposit'    THEN  txn_amount
                WHEN txn_type = 'withdrawal' THEN -txn_amount
            END
        ) AS monthly_net
    FROM customer_transactions
    WHERE txn_type IN ('deposit','withdrawal')
    GROUP BY customer_id, year_month
),
running_bal AS (
    SELECT
        customer_id,
        year_month,
        SUM(monthly_net) OVER (PARTITION BY customer_id ORDER BY year_month) AS closing_balance,
        ROW_NUMBER()  OVER (PARTITION BY customer_id ORDER BY year_month DESC) AS rnk
    FROM monthly
),
latest AS (
    SELECT
        customer_id,
        closing_balance,
        LAG(closing_balance) OVER (PARTITION BY customer_id ORDER BY year_month) AS prev_balance
    FROM running_bal
    WHERE rnk = 1
),
growth AS (
    SELECT
        customer_id,
        CASE
            WHEN IFNULL(prev_balance,0)=0
                 THEN closing_balance * 100.0
            ELSE (closing_balance - prev_balance) * 100.0 / prev_balance
        END AS growth_rate
    FROM latest
)
SELECT COUNT(*) AS customers_growth_gt_5
FROM   growth
WHERE  growth_rate > 5
LIMIT 20;
```

```sql
--Description: Final metric – percentage of customers whose latest month’s balance grew by
--             more than 5 %.
WITH monthly AS (
    SELECT
        customer_id,
        substr(txn_date, 1, 7) AS year_month,
        SUM(
            CASE
                WHEN txn_type = 'deposit'    THEN  txn_amount
                WHEN txn_type = 'withdrawal' THEN -txn_amount
            END
        ) AS monthly_net
    FROM customer_transactions
    WHERE txn_type IN ('deposit','withdrawal')
    GROUP BY customer_id, year_month
),
running_bal AS (
    SELECT
        customer_id,
        year_month,
        SUM(monthly_net) OVER (PARTITION BY customer_id ORDER BY year_month) AS closing_balance,
        ROW_NUMBER()  OVER (PARTITION BY customer_id ORDER BY year_month DESC) AS rnk
    FROM monthly
),
paired AS (
    SELECT
        cur.customer_id,
        cur.closing_balance AS latest_bal,
        prev.closing_balance AS prev_bal
    FROM running_bal AS cur
    LEFT JOIN running_bal AS prev
           ON cur.customer_id = prev.customer_id
          AND prev.rnk        = 2
    WHERE cur.rnk = 1
),
growth AS (
    SELECT
        customer_id,
        CASE
            WHEN IFNULL(prev_bal,0)=0
                 THEN latest_bal * 100.0
            ELSE (latest_bal - prev_bal) * 100.0 / prev_bal
        END AS growth_rate
    FROM paired
)
SELECT
    ROUND(100.0 * SUM(CASE WHEN growth_rate > 5 THEN 1 ELSE 0 END) / COUNT(*), 2)
    AS percentage_customers_growth_gt_5
FROM growth;
