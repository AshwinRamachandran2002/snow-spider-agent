Below are step-by-step inspection queries (≤ 10) that move from simple exploration of “customer_transactions” toward the final metric.  
Each query is preceded by a short description.

```sql
--Description: 1) Check the two transaction directions that exist in the data set
SELECT DISTINCT "txn_type"
FROM "customer_transactions";
```

```sql
--Description: 2) Inspect the date range to confirm monthly granularity is possible
SELECT DISTINCT substr("txn_date",1,7) AS "year_month"
FROM "customer_transactions"
ORDER BY "year_month"
LIMIT 20;
```

```sql
--Description: 3) Peek at raw rows (deposits & withdrawals) to understand values
SELECT *
FROM "customer_transactions"
ORDER BY "txn_date"
LIMIT 20;
```

```sql
--Description: 4) For each customer and month-start, derive the monthly net (deposit – withdrawal)
SELECT 
       "customer_id",
       substr("txn_date",1,7)||'-01' AS "month_start",
       SUM(CASE WHEN "txn_type"='deposit'   THEN  "txn_amount"
                WHEN "txn_type"='withdrawal' THEN - "txn_amount"
           END) AS "monthly_net"
FROM   "customer_transactions"
GROUP  BY "customer_id", "month_start"
ORDER  BY "customer_id", "month_start"
LIMIT 20;
```

```sql
--Description: 5) Add a running total per customer to obtain the monthly closing balance
SELECT 
       "customer_id",
       "month_start",
       "monthly_net",
       SUM("monthly_net") 
         OVER (PARTITION BY "customer_id" 
               ORDER BY "month_start")          AS "closing_balance"
FROM (
       SELECT 
              "customer_id",
              substr("txn_date",1,7)||'-01' AS "month_start",
              SUM(CASE WHEN "txn_type"='deposit'   THEN  "txn_amount"
                       WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                  END) AS "monthly_net"
       FROM   "customer_transactions"
       GROUP  BY "customer_id", "month_start"
)
ORDER BY "customer_id", "month_start"
LIMIT 20;
```

```sql
--Description: 6) For every customer isolate the two most-recent months of balances
WITH monthly AS (
     SELECT 
            "customer_id",
            "month_start",
            SUM("monthly_net") 
              OVER (PARTITION BY "customer_id" 
                    ORDER BY "month_start")      AS "closing_balance"
     FROM (
           SELECT 
                  "customer_id",
                  substr("txn_date",1,7)||'-01' AS "month_start",
                  SUM(CASE WHEN "txn_type"='deposit'   THEN  "txn_amount"
                           WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                      END) AS "monthly_net"
           FROM   "customer_transactions"
           GROUP  BY "customer_id", "month_start"
     )
), ranked AS (
     SELECT *,
            ROW_NUMBER() OVER (PARTITION BY "customer_id" 
                               ORDER BY "month_start" DESC) AS rn
     FROM   monthly
)
SELECT *
FROM   ranked
WHERE  rn <= 2
ORDER  BY "customer_id", rn
LIMIT 20;
```

```sql
--Description: 7) Compute the most-recent growth rate for each customer
WITH monthly AS (
     SELECT 
            "customer_id",
            "month_start",
            SUM("monthly_net") 
              OVER (PARTITION BY "customer_id" 
                    ORDER BY "month_start")      AS "closing_balance"
     FROM (
           SELECT 
                  "customer_id",
                  substr("txn_date",1,7)||'-01' AS "month_start",
                  SUM(CASE WHEN "txn_type"='deposit'   THEN  "txn_amount"
                           WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                      END) AS "monthly_net"
           FROM   "customer_transactions"
           GROUP  BY "customer_id", "month_start"
     )
), ranked AS (
     SELECT *,
            ROW_NUMBER() OVER (PARTITION BY "customer_id" 
                               ORDER BY "month_start" DESC) AS rn
     FROM   monthly
), final AS (
     SELECT 
            cur."customer_id",
            cur."month_start"          AS "latest_month",
            cur."closing_balance"      AS "latest_balance",
            prev."closing_balance"     AS "prev_balance",
            CASE 
                 WHEN prev."closing_balance" = 0
                      THEN cur."closing_balance"*100.0
                 ELSE (cur."closing_balance" - prev."closing_balance") 
                      * 100.0 / prev."closing_balance"
            END                        AS "growth_rate_pct"
     FROM   ranked cur
     LEFT   JOIN ranked prev
            ON  cur."customer_id" = prev."customer_id"
            AND cur.rn = 1
            AND prev.rn = 2
     WHERE  cur.rn = 1
)
SELECT *
FROM   final
ORDER  BY "growth_rate_pct" DESC
LIMIT 20;
```

```sql
--Description: 8) Count customers whose most-recent growth rate > 5 %
WITH monthly AS (
     SELECT 
            "customer_id",
            "month_start",
            SUM("monthly_net") 
              OVER (PARTITION BY "customer_id" 
                    ORDER BY "month_start")      AS "closing_balance"
     FROM (
           SELECT 
                  "customer_id",
                  substr("txn_date",1,7)||'-01' AS "month_start",
                  SUM(CASE WHEN "txn_type"='deposit'   THEN  "txn_amount"
                           WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                      END) AS "monthly_net"
           FROM   "customer_transactions"
           GROUP  BY "customer_id", "month_start"
     )
), ranked AS (
     SELECT *,
            ROW_NUMBER() OVER (PARTITION BY "customer_id" 
                               ORDER BY "month_start" DESC) AS rn
     FROM   monthly
), final AS (
     SELECT 
            cur."customer_id",
            CASE 
                 WHEN prev."closing_balance" = 0
                      THEN cur."closing_balance"*100.0
                 ELSE (cur."closing_balance" - prev."closing_balance") 
                      * 100.0 / prev."closing_balance"
            END                        AS "growth_rate_pct"
     FROM   ranked cur
     LEFT   JOIN ranked prev
            ON  cur."customer_id" = prev."customer_id"
            AND cur.rn = 1
            AND prev.rn = 2
     WHERE  cur.rn = 1
)
SELECT COUNT(*) AS "customers_growth_gt_5pct"
FROM   final
WHERE  "growth_rate_pct" > 5;
```

```sql
--Description: 9) Total customers and percentage whose growth > 5 %
WITH monthly AS (
     SELECT 
            "customer_id",
            "month_start",
            SUM("monthly_net") 
              OVER (PARTITION BY "customer_id" 
                    ORDER BY "month_start")      AS "closing_balance"
     FROM (
           SELECT 
                  "customer_id",
                  substr("txn_date",1,7)||'-01' AS "month_start",
                  SUM(CASE WHEN "txn_type"='deposit'   THEN  "txn_amount"
                           WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                      END) AS "monthly_net"
           FROM   "customer_transactions"
           GROUP  BY "customer_id", "month_start"
     )
), ranked AS (
     SELECT *,
            ROW_NUMBER() OVER (PARTITION BY "customer_id" 
                               ORDER BY "month_start" DESC) AS rn
     FROM   monthly
), final AS (
     SELECT 
            cur."customer_id",
            CASE 
                 WHEN prev."closing_balance" = 0
                      THEN cur."closing_balance"*100.0
                 ELSE (cur."closing_balance" - prev."closing_balance") 
                      * 100.0 / prev."closing_balance"
            END                        AS "growth_rate_pct"
     FROM   ranked cur
     LEFT   JOIN ranked prev
            ON  cur."customer_id" = prev."customer_id"
            AND cur.rn = 1
            AND prev.rn = 2
     WHERE  cur.rn = 1
)
SELECT 
       ROUND(100.0 * SUM(CASE WHEN "growth_rate_pct" > 5 THEN 1 ELSE 0 END)
                 / COUNT(*), 2) AS "pct_customers_growth_gt_5pct"
FROM   final;
```

These nine SELECT statements reveal the data and progressively build up to the final percentage of customers whose latest-month balance grew by more than 5 %.
