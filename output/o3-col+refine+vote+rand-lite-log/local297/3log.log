     FROM   monthly
), final AS (
     SELECT 
            cur."customer_id",
            CASE 
                 WHEN prev."closing_balance" = 0
                      THEN cur."closing_balance"*100.0
                 ELSE (cur."closing_balance" - prev."closing_balance") 
                      * 100.0 / prev."closing_balance"
            END                        AS "growth_rate_pct"
     FROM   ranked cur
     LEFT   JOIN ranked prev
            ON  cur."customer_id" = prev."customer_id"
            AND cur.rn = 1
            AND prev.rn = 2
     WHERE  cur.rn = 1
)
SELECT 
       ROUND(100.0 * SUM(CASE WHEN "growth_rate_pct" > 5 THEN 1 ELSE 0 END)
                 / COUNT(*), 2) AS "pct_customers_growth_gt_5pct"
FROM   final;
