Query:
-- Description: Compute growth rate for the latest month for every customer
WITH month_net AS (
  SELECT 
        customer_id,
        DATE(SUBSTR(txn_date,1,7)||'-01') AS month_start,
        SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                 WHEN txn_type='withdrawal' THEN -txn_amount
                 ELSE 0 END)               AS net_amount
  FROM customer_transactions
  GROUP BY customer_id, month_start
), closing AS (
  SELECT 
        customer_id,
        month_start,
        SUM(net_amount) OVER (
            PARTITION BY customer_id
            ORDER BY month_start
        )                                   AS closing_balance
  FROM month_net
), latest AS (
  SELECT 
        customer_id,
        month_start,
        closing_balance,
        LAG(closing_balance) OVER
            (PARTITION BY customer_id ORDER BY month_start) AS prev_balance
  FROM closing
)
SELECT
       customer_id,
       closing_balance AS latest_bal,
       prev_balance    AS prev_bal,
       CASE 
              WHEN prev_balance = 0
                   THEN closing_balance * 100.0
              ELSE (closing_balance - prev_balance) * 100.0 / ABS(prev_balance)
       END            AS growth_rate_percent
FROM latest
WHERE month_start = (SELECT MAX(month_start) 
                     FROM closing c2 
                     WHERE c2.customer_id = latest.customer_id)
LIMIT 20;
