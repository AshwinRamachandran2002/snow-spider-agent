```sql
-- Description (thinking process):
-- 1. Aggregate each customer’s deposits (+) and withdrawals (−) by month to get a monthly “net_amount”.
-- 2. Calculate a running “closing_balance” for every customer across months.
-- 3. Use LAG() to fetch the “prev_balance” (closing balance of the prior month).
-- 4. Finally, count how many (customer, month) rows have prev_balance = 0 to confirm whether
--    the edge-case ever appears.  Selecting COUNT(*) keeps the query simple while still
--    revealing if such situations exist (a non-zero count means they do).

WITH month_net AS (
    SELECT
        customer_id,
        DATE(SUBSTR(txn_date, 1, 7) || '-01')          AS month_start,
        SUM(CASE
                WHEN txn_type = 'deposit'    THEN  txn_amount
                WHEN txn_type = 'withdrawal' THEN -txn_amount
                ELSE 0
            END)                                       AS net_amount
    FROM customer_transactions
    GROUP BY customer_id, month_start
),
closing AS (
    SELECT
        customer_id,
        month_start,
        SUM(net_amount) OVER (
            PARTITION BY customer_id
            ORDER BY month_start
        )                                             AS closing_balance
    FROM month_net
),
balances AS (
    SELECT
        customer_id,
        month_start,
        closing_balance,
        LAG(closing_balance) OVER (
            PARTITION BY customer_id
            ORDER BY month_start
        )                                             AS prev_balance
    FROM closing
)
SELECT COUNT(*) AS edge_case_rows
FROM balances
WHERE prev_balance = 0;
