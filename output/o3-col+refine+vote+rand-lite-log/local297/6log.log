-- Description: Isolate each customer’s most-recent month and the month right before it, alongside their closing balances
WITH month_net AS (
  SELECT 
        customer_id,
        DATE(SUBSTR(txn_date,1,7)||'-01')     AS month_start,
        SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                 WHEN txn_type='withdrawal' THEN -txn_amount
                 ELSE 0 END)                 AS net_amount
  FROM customer_transactions
  GROUP BY customer_id, month_start
), closing AS (
  SELECT 
        customer_id,
        month_start,
        net_amount,
        SUM(net_amount) OVER (
            PARTITION BY customer_id
            ORDER BY month_start
        )                                     AS closing_balance
  FROM month_net
)
SELECT *
FROM (
    SELECT 
           customer_id,
           month_start,
           closing_balance,
           LAG(closing_balance) OVER (PARTITION BY customer_id ORDER BY month_start) AS prev_balance
    FROM closing
) 
WHERE month_start = (SELECT MAX(month_start) FROM closing c2 WHERE c2.customer_id = customer_id)
LIMIT 20;
