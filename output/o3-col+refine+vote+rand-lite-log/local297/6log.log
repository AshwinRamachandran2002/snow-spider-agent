-- Description (thinking process):
-- Goal: identify customers whose latest month faces the edge-case where their
--       previous month’s closing balance equals 0.
-- Steps
--   1. month_net  – compute monthly net (deposits – withdrawals) per customer.
--   2. closing    – accumulate those nets to obtain a running closing balance.
--   3. latest_cte – add LAG(closing_balance) to fetch the previous balance and
--                  assign each month a row_number (1 = most-recent) per customer.
--   4. Final      – keep only the row where rn = 1 (latest month) AND the
--                  previous balance is exactly 0.  Display up to 20 rows.
WITH month_net AS (
    SELECT
        customer_id,
        DATE(SUBSTR(txn_date, 1, 7) || '-01')              AS month_start,
        SUM(CASE
                WHEN txn_type = 'deposit'    THEN txn_amount
                WHEN txn_type = 'withdrawal' THEN -txn_amount
                ELSE 0
            END)                                           AS net_amount
    FROM customer_transactions
    GROUP BY customer_id, month_start
),
closing AS (
    SELECT
        customer_id,
        month_start,
        SUM(net_amount) OVER (
            PARTITION BY customer_id
            ORDER BY month_start
        )                                                  AS closing_balance
    FROM month_net
),
latest_cte AS (
    SELECT
        customer_id,
        month_start,
        closing_balance,
        LAG(closing_balance) OVER (
            PARTITION BY customer_id
            ORDER BY month_start
        )                                                  AS prev_balance,
        ROW_NUMBER() OVER (
            PARTITION BY customer_id
            ORDER BY month_start DESC
        )                                                  AS rn
    FROM closing
)
SELECT *
FROM latest_cte
WHERE rn = 1            -- keep only the latest month per customer
  AND prev_balance = 0  -- edge-case: previous closing balance was zero
LIMIT 20;
