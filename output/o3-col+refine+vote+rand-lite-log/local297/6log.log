```sql
-- Description: Calculate the net amount (deposits – withdrawals) for each customer for every month
WITH month_net AS (
  SELECT 
        customer_id,
        DATE(SUBSTR(txn_date,1,7)||'-01')      AS month_start,
        SUM(CASE WHEN txn_type='deposit'    THEN txn_amount 
                 WHEN txn_type='withdrawal' THEN -txn_amount 
                 ELSE 0 END)                 AS net_amount
  FROM customer_transactions
  GROUP BY customer_id, month_start
)
SELECT *
FROM month_net
LIMIT 20;
```

```sql
-- Description: Compute a running (cumulative) closing balance for each customer across time
WITH month_net AS (
  SELECT 
        customer_id,
        DATE(SUBSTR(txn_date,1,7)||'-01')     AS month_start,
        SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                 WHEN txn_type='withdrawal' THEN -txn_amount
                 ELSE 0 END)                 AS net_amount
  FROM customer_transactions
  GROUP BY customer_id, month_start
)
SELECT 
       customer_id,
       month_start,
       net_amount,
       SUM(net_amount) OVER (
           PARTITION BY customer_id
           ORDER BY month_start
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
       )                                      AS closing_balance
FROM month_net
LIMIT 20;
```

```sql
-- Description: Isolate each customer’s most-recent month and the month right before it, alongside their closing balances
WITH month_net AS (
  SELECT 
        customer_id,
        DATE(SUBSTR(txn_date,1,7)||'-01')     AS month_start,
        SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                 WHEN txn_type='withdrawal' THEN -txn_amount
                 ELSE 0 END)                 AS net_amount
  FROM customer_transactions
  GROUP BY customer_id, month_start
), closing AS (
  SELECT 
        customer_id,
        month_start,
        net_amount,
        SUM(net_amount) OVER (
            PARTITION BY customer_id
            ORDER BY month_start
        )                                     AS closing_balance
  FROM month_net
)
SELECT *
FROM (
    SELECT 
           customer_id,
           month_start,
           closing_balance,
           LAG(closing_balance) OVER (PARTITION BY customer_id ORDER BY month_start) AS prev_balance
    FROM closing
) 
WHERE month_start = (SELECT MAX(month_start) FROM closing c2 WHERE c2.customer_id = customer_id)
LIMIT 20;
```

```sql
-- Description: Compute growth rate for the latest month for every customer
WITH month_net AS (
  SELECT 
        customer_id,
        DATE(SUBSTR(txn_date,1,7)||'-01') AS month_start,
        SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                 WHEN txn_type='withdrawal' THEN -txn_amount
                 ELSE 0 END)               AS net_amount
  FROM customer_transactions
  GROUP BY customer_id, month_start
), closing AS (
  SELECT 
        customer_id,
        month_start,
        SUM(net_amount) OVER (
            PARTITION BY customer_id
            ORDER BY month_start
        )                                   AS closing_balance
  FROM month_net
), latest AS (
  SELECT 
        customer_id,
        month_start,
        closing_balance,
        LAG(closing_balance) OVER
            (PARTITION BY customer_id ORDER BY month_start) AS prev_balance
  FROM closing
)
SELECT
       customer_id,
       closing_balance AS latest_bal,
       prev_balance    AS prev_bal,
       CASE 
              WHEN prev_balance = 0
                   THEN closing_balance * 100.0
              ELSE (closing_balance - prev_balance) * 100.0 / ABS(prev_balance)
       END            AS growth_rate_percent
FROM latest
WHERE month_start = (SELECT MAX(month_start) 
                     FROM closing c2 
                     WHERE c2.customer_id = latest.customer_id)
LIMIT 20;
```

```sql
-- Description: Find all customers whose latest month’s growth rate exceeds 5%
WITH month_net AS (
  SELECT 
        customer_id,
        DATE(SUBSTR(txn_date,1,7)||'-01') AS month_start,
        SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                 WHEN txn_type='withdrawal' THEN -txn_amount
                 ELSE 0 END)               AS net_amount
  FROM customer_transactions
  GROUP BY customer_id, month_start
), closing AS (
  SELECT 
        customer_id,
        month_start,
        SUM(net_amount) OVER (
            PARTITION BY customer_id
            ORDER BY month_start
        )                                   AS closing_balance
  FROM month_net
), latest AS (
  SELECT 
        customer_id,
        month_start,
        closing_balance,
        LAG(closing_balance) OVER
            (PARTITION BY customer_id ORDER BY month_start) AS prev_balance
  FROM closing
), growth AS (
  SELECT
       customer_id,
       CASE 
              WHEN prev_balance = 0
                   THEN closing_balance * 100.0
              ELSE (closing_balance - prev_balance) * 100.0 / ABS(prev_balance)
       END            AS growth_rate_percent
  FROM latest
  WHERE month_start = (SELECT MAX(month_start) 
                       FROM closing c2 
                       WHERE c2.customer_id = latest.customer_id)
)
SELECT DISTINCT customer_id
FROM growth
WHERE growth_rate_percent > 5
LIMIT 20;
```

```sql
-- Description: Compute the overall percentage of customers whose most-recent growth rate > 5 %
WITH month_net AS (
  SELECT 
        customer_id,
        DATE(SUBSTR(txn_date,1,7)||'-01') AS month_start,
        SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                 WHEN txn_type='withdrawal' THEN -txn_amount
                 ELSE 0 END)               AS net_amount
  FROM customer_transactions
  GROUP BY customer_id, month_start
), closing AS (
  SELECT 
        customer_id,
        month_start,
        SUM(net_amount) OVER (
            PARTITION BY customer_id
            ORDER BY month_start
        )                                   AS closing_balance
  FROM month_net
), latest AS (
  SELECT 
        customer_id,
        month_start,
        closing_balance,
        LAG(closing_balance) OVER
            (PARTITION BY customer_id ORDER BY month_start) AS prev_balance
  FROM closing
), growth AS (
  SELECT
       customer_id,
       CASE 
              WHEN prev_balance = 0
                   THEN closing_balance * 100.0
              ELSE (closing_balance - prev_balance) * 100.0 / ABS(prev_balance)
       END            AS growth_rate_percent
  FROM latest
  WHERE month_start = (SELECT MAX(month_start) 
                       FROM closing c2 
                       WHERE c2.customer_id = latest.customer_id)
)
SELECT 
       ROUND(100.0 * SUM(CASE WHEN growth_rate_percent > 5 THEN 1 ELSE 0 END) /
                  COUNT(DISTINCT customer_id), 2) 
       AS percent_customers_growth_gt_5
FROM growth
LIMIT 20;
```

