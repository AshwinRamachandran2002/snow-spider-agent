WITH monthly AS (
  SELECT "customer_id",
         strftime('%Y-%m-01', "txn_date") AS "month_start",
         SUM(CASE
               WHEN "txn_type" = 'deposit'    THEN + "txn_amount"
               WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
             END) AS "monthly_net"
  FROM   "customer_transactions"
  GROUP  BY "customer_id",
            strftime('%Y-%m-01', "txn_date")
),
closing AS (
  SELECT "customer_id",
         "month_start",
         SUM("monthly_net") OVER (
             PARTITION BY "customer_id"
             ORDER BY     "month_start"
         ) AS "closing_balance"
  FROM   monthly
),
growth AS (
  SELECT  c1."customer_id",
          CASE
            WHEN c0."closing_balance" = 0
                 OR c0."closing_balance" IS NULL
            THEN c1."closing_balance" * 100.0
            ELSE (c1."closing_balance" - c0."closing_balance")
                   * 100.0 / ABS(c0."closing_balance")
          END  AS "growth_rate_%"
  FROM   closing  AS c1
  LEFT   JOIN closing AS c0
         ON  c1."customer_id" = c0."customer_id"
         AND c0."month_start" = (
              SELECT MAX("month_start")
              FROM   closing AS z
              WHERE  z."customer_id" = c1."customer_id"
              AND    z."month_start" < c1."month_start"
            )
  WHERE  c1."month_start" = (
          SELECT MAX("month_start")
          FROM   closing AS y
          WHERE  y."customer_id" = c1."customer_id"
        )
)
SELECT  COUNT(CASE WHEN "growth_rate_%" > 5 THEN 1 END) AS "customers_gt_5%",
        COUNT(*)                                        AS "total_customers"
FROM    growth;
