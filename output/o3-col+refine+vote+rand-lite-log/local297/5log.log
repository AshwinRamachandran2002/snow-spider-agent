```sql
-- Description: Build the monthly net (deposits-withdrawals) for every customer  
SELECT "customer_id",
       /* first day of the month */ 
       strftime('%Y-%m-01', "txn_date") AS "month_start",
       SUM(CASE
             WHEN "txn_type" = 'deposit'    THEN  + "txn_amount"
             WHEN "txn_type" = 'withdrawal' THEN  - "txn_amount"
           END)                            AS "monthly_net"
FROM   "customer_transactions"
GROUP  BY "customer_id",
          strftime('%Y-%m-01', "txn_date")
ORDER  BY "customer_id",
          "month_start"
LIMIT 20;
```

```sql
-- Description: For each customer, generate a running closing balance  
WITH monthly AS (
  SELECT "customer_id",
         strftime('%Y-%m-01', "txn_date") AS "month_start",
         SUM(CASE
               WHEN "txn_type" = 'deposit'    THEN + "txn_amount"
               WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
             END) AS "monthly_net"
  FROM   "customer_transactions"
  GROUP  BY "customer_id",
            strftime('%Y-%m-01', "txn_date")
)
SELECT "customer_id",
       "month_start",
       "monthly_net",
       SUM("monthly_net") OVER (
           PARTITION BY "customer_id"
           ORDER BY     "month_start"
       ) AS "closing_balance"
FROM   monthly
ORDER BY "customer_id", "month_start"
LIMIT 20;
```

```sql
-- Description: Pull the current & previous month’s closing balance plus growth rate  
WITH monthly AS (
  SELECT "customer_id",
         strftime('%Y-%m-01', "txn_date") AS "month_start",
         SUM(CASE
               WHEN "txn_type" = 'deposit'    THEN + "txn_amount"
               WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
             END) AS "monthly_net"
  FROM   "customer_transactions"
  GROUP  BY "customer_id",
            strftime('%Y-%m-01', "txn_date")
),
closing AS (
  SELECT "customer_id",
         "month_start",
         SUM("monthly_net") OVER (
             PARTITION BY "customer_id"
             ORDER BY     "month_start"
         )                             AS "closing_balance"
  FROM   monthly
)
SELECT  c1."customer_id",
        c1."month_start"               AS "latest_month",
        c1."closing_balance"           AS "latest_close",
        c0."closing_balance"           AS "prev_close",
        CASE
          WHEN c0."closing_balance" = 0
               OR c0."closing_balance" IS NULL
          THEN c1."closing_balance" * 100.0
          ELSE (c1."closing_balance" - c0."closing_balance")
                 * 100.0 / ABS(c0."closing_balance")
        END                            AS "growth_rate_%"
FROM   closing  AS c1
LEFT   JOIN closing AS c0
       ON  c1."customer_id"  = c0."customer_id"
       AND c0."month_start"  = (
            SELECT MAX("month_start")
            FROM   closing  AS z
            WHERE  z."customer_id" = c1."customer_id"
            AND    z."month_start" < c1."month_start"
          )
WHERE  c1."month_start" = (
        SELECT MAX("month_start")
        FROM   closing  AS y
        WHERE  y."customer_id" = c1."customer_id"
      )
LIMIT 20;
```

```sql
-- Description: Classify every customer by whether their latest growth is > 5 %  
WITH monthly AS (
  SELECT "customer_id",
         strftime('%Y-%m-01', "txn_date") AS "month_start",
         SUM(CASE
               WHEN "txn_type" = 'deposit'    THEN + "txn_amount"
               WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
             END) AS "monthly_net"
  FROM   "customer_transactions"
  GROUP  BY "customer_id",
            strftime('%Y-%m-01', "txn_date")
),
closing AS (
  SELECT "customer_id",
         "month_start",
         SUM("monthly_net") OVER (
             PARTITION BY "customer_id"
             ORDER BY     "month_start"
         )                             AS "closing_balance"
  FROM   monthly
),
growth AS (
  SELECT  c1."customer_id",
          CASE
            WHEN c0."closing_balance" = 0
                 OR c0."closing_balance" IS NULL
            THEN c1."closing_balance" * 100.0
            ELSE (c1."closing_balance" - c0."closing_balance")
                   * 100.0 / ABS(c0."closing_balance")
          END  AS "growth_rate_%"
  FROM   closing  AS c1
  LEFT   JOIN closing AS c0
         ON  c1."customer_id" = c0."customer_id"
         AND c0."month_start" = (
              SELECT MAX("month_start")
              FROM   closing AS z
              WHERE  z."customer_id" = c1."customer_id"
              AND    z."month_start" < c1."month_start"
            )
  WHERE  c1."month_start" = (
          SELECT MAX("month_start")
          FROM   closing AS y
          WHERE  y."customer_id" = c1."customer_id"
        )
)
SELECT DISTINCT "customer_id",
       "growth_rate_%",
       CASE WHEN "growth_rate_%" > 5 THEN 1 ELSE 0 END AS "is_gt_5%"
FROM   growth
LIMIT 20;
```

```sql
-- Description: Summarise counts of customers with >5 % growth vs all customers  
WITH monthly AS (
  SELECT "customer_id",
         strftime('%Y-%m-01', "txn_date") AS "month_start",
         SUM(CASE
               WHEN "txn_type" = 'deposit'    THEN + "txn_amount"
               WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
             END) AS "monthly_net"
  FROM   "customer_transactions"
  GROUP  BY "customer_id",
            strftime('%Y-%m-01', "txn_date")
),
closing AS (
  SELECT "customer_id",
         "month_start",
         SUM("monthly_net") OVER (
             PARTITION BY "customer_id"
             ORDER BY     "month_start"
         ) AS "closing_balance"
  FROM   monthly
),
growth AS (
  SELECT  c1."customer_id",
          CASE
            WHEN c0."closing_balance" = 0
                 OR c0."closing_balance" IS NULL
            THEN c1."closing_balance" * 100.0
            ELSE (c1."closing_balance" - c0."closing_balance")
                   * 100.0 / ABS(c0."closing_balance")
          END  AS "growth_rate_%"
  FROM   closing  AS c1
  LEFT   JOIN closing AS c0
         ON  c1."customer_id" = c0."customer_id"
         AND c0."month_start" = (
              SELECT MAX("month_start")
              FROM   closing AS z
              WHERE  z."customer_id" = c1."customer_id"
              AND    z."month_start" < c1."month_start"
            )
  WHERE  c1."month_start" = (
          SELECT MAX("month_start")
          FROM   closing AS y
          WHERE  y."customer_id" = c1."customer_id"
        )
)
SELECT  COUNT(CASE WHEN "growth_rate_%" > 5 THEN 1 END) AS "customers_gt_5%",
        COUNT(*)                                        AS "total_customers"
FROM    growth;
```

```sql
-- Description: Final percentage of customers whose latest month grew by >5 %  
WITH monthly AS (
  SELECT "customer_id",
         strftime('%Y-%m-01', "txn_date") AS "month_start",
         SUM(CASE
               WHEN "txn_type" = 'deposit'    THEN + "txn_amount"
               WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
             END) AS "monthly_net"
  FROM   "customer_transactions"
  GROUP  BY "customer_id",
            strftime('%Y-%m-01', "txn_date")
),
closing AS (
  SELECT "customer_id",
         "month_start",
         SUM("monthly_net") OVER (
             PARTITION BY "customer_id"
             ORDER BY     "month_start"
         ) AS "closing_balance"
  FROM   monthly
),
growth AS (
  SELECT  c1."customer_id",
          CASE
            WHEN c0."closing_balance" = 0
                 OR c0."closing_balance" IS NULL
            THEN c1."closing_balance" * 100.0
            ELSE (c1."closing_balance" - c0."closing_balance")
                   * 100.0 / ABS(c0."closing_balance")
          END  AS "growth_rate_%"
  FROM   closing  AS c1
  LEFT   JOIN closing AS c0
         ON  c1."customer_id" = c0."customer_id"
         AND c0."month_start" = (
              SELECT MAX("month_start")
              FROM   closing AS z
              WHERE  z."customer_id" = c1."customer_id"
              AND    z."month_start" < c1."month_start"
            )
  WHERE  c1."month_start" = (
          SELECT MAX("month_start")
          FROM   closing AS y
          WHERE  y."customer_id" = c1."customer_id"
        )
)
SELECT ROUND(
         100.0 * SUM(CASE WHEN "growth_rate_%" > 5 THEN 1 ELSE 0 END)
              / COUNT(*)
       , 2) AS "pct_customers_gt_5%"
FROM   growth;
```

These eight queries progress from basic inspection all the way to the single-statement answer—the percentage of customers whose most recent monthly balance grew by more than 5 %.
