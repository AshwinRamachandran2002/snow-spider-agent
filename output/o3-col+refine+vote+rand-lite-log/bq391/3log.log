```sql
-- 1) Inspect patients’ names and the “active” flag
SELECT
  id                             AS patient_id,
  n.family                       AS last_name,
  n.given[OFFSET(0)]             AS first_name,
  active
FROM `bigquery-public-data.fhir_synthea.patient`,
     UNNEST(name) AS n
LIMIT 20;
```

```sql
-- 2) Living patients whose last names start with “A”
SELECT
  p.id                           AS patient_id,
  n.family                       AS last_name
FROM `bigquery-public-data.fhir_synthea.patient` AS p
JOIN UNNEST(p.name) AS n
WHERE p.active = TRUE
  AND UPPER(n.family) LIKE 'A%'
LIMIT 20;
```

```sql
-- 3) How many distinct conditions does each of those patients have?
SELECT
  c.subject.patientId            AS patient_id,
  COUNT(DISTINCT c.id)           AS condition_cnt
FROM `bigquery-public-data.fhir_synthea.condition`  AS c
WHERE c.subject.patientId IN (
        SELECT p.id
        FROM `bigquery-public-data.fhir_synthea.patient` AS p
        JOIN UNNEST(p.name) AS n
        WHERE p.active = TRUE
          AND UPPER(n.family) LIKE 'A%')
GROUP BY patient_id
LIMIT 20;
```

```sql
-- 4) Keep only patients who have exactly ONE distinct condition
SELECT
  patient_id
FROM (
  SELECT
    c.subject.patientId  AS patient_id,
    COUNT(DISTINCT c.id) AS condition_cnt
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  GROUP BY patient_id )
WHERE condition_cnt = 1
LIMIT 20;
```

```sql
-- 5) Retrieve the single condition’s code & text for each selected patient
SELECT
  c.subject.patientId                 AS patient_id,
  cod.display                         AS condition_display,
  cod.code                            AS condition_code
FROM `bigquery-public-data.fhir_synthea.condition` AS c,
     UNNEST(c.code.coding)            AS cod
WHERE c.subject.patientId IN ( /* patients with exactly one condition */
        SELECT patient_id
        FROM (
          SELECT subject.patientId AS patient_id,
                 COUNT(DISTINCT id) AS cnt
          FROM `bigquery-public-data.fhir_synthea.condition`
          GROUP BY patient_id )
        WHERE cnt = 1 )
LIMIT 20;
```

```sql
-- 6) Look at medication requests’ status values
SELECT DISTINCT status
FROM `bigquery-public-data.fhir_synthea.medication_request`
LIMIT 20;
```

```sql
-- 7) Active medication requests by the filtered patients
SELECT
  mr.subject.patientId               AS patient_id,
  med.code                           AS medication_code,
  med.display                        AS medication_display
FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr,
     UNNEST(mr.medication.codeableConcept.coding) AS med
WHERE mr.status = 'active'
  AND mr.subject.patientId IN (   /* living “A%” patients w/ 1 condition */
        SELECT patient_id
        FROM (
          SELECT p.id AS patient_id
          FROM `bigquery-public-data.fhir_synthea.patient` AS p
          JOIN UNNEST(p.name) AS n
          WHERE p.active = TRUE AND UPPER(n.family) LIKE 'A%') AS a
        INTERSECT DISTINCT
        SELECT patient_id
        FROM (
          SELECT subject.patientId AS patient_id,
                 COUNT(DISTINCT id) AS cnt
          FROM `bigquery-public-data.fhir_synthea.condition`
          GROUP BY patient_id
          HAVING cnt = 1))
LIMIT 20;
```

```sql
-- 8) Count different active medications per patient
SELECT
  patient_id,
  COUNT(DISTINCT medication_code) AS active_med_cnt
FROM (
  SELECT
    mr.subject.patientId               AS patient_id,
    med.code                           AS medication_code
  FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr,
       UNNEST(mr.medication.codeableConcept.coding) AS med
  WHERE mr.status = 'active')
WHERE patient_id IN ( /* qualified patients */ 
        SELECT patient_id
        FROM (
          SELECT p.id AS patient_id
          FROM `bigquery-public-data.fhir_synthea.patient` AS p
          JOIN UNNEST(p.name) AS n
          WHERE p.active = TRUE AND UPPER(n.family) LIKE 'A%') AS a
        INTERSECT DISTINCT
        SELECT patient_id
        FROM (
          SELECT subject.patientId AS patient_id,
                 COUNT(DISTINCT id) AS cnt
          FROM `bigquery-public-data.fhir_synthea.condition`
          GROUP BY patient_id
          HAVING cnt = 1))
GROUP BY patient_id
LIMIT 20;
```

```sql
-- 9) For each condition, find the MAX number of active medications
SELECT
  cond.condition_code,
  cond.condition_display,
  MAX(med_cnt.active_med_cnt) AS max_active_meds_any_patient
FROM (
  SELECT
    c.subject.patientId                 AS patient_id,
    cod.code                            AS condition_code,
    cod.display                         AS condition_display
  FROM `bigquery-public-data.fhir_synthea.condition` AS c,
       UNNEST(c.code.coding)            AS cod ) AS cond
JOIN (
  SELECT
    patient_id,
    COUNT(DISTINCT medication_code) AS active_med_cnt
  FROM (
    SELECT
      mr.subject.patientId               AS patient_id,
      med.code                           AS medication_code
    FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr,
         UNNEST(mr.medication.codeableConcept.coding) AS med
    WHERE mr.status = 'active')
  GROUP BY patient_id) AS med_cnt
ON  cond.patient_id = med_cnt.patient_id
WHERE cond.patient_id IN ( /* living “A%” patients w/ exactly 1 condition */
        SELECT patient_id
        FROM (
          SELECT p.id AS patient_id
          FROM `bigquery-public-data.fhir_synthea.patient` AS p
          JOIN UNNEST(p.name) AS n
          WHERE p.active = TRUE AND UPPER(n.family) LIKE 'A%') AS a
        INTERSECT DISTINCT
        SELECT patient_id
        FROM (
          SELECT subject.patientId AS patient_id,
                 COUNT(DISTINCT id) AS cnt
          FROM `bigquery-public-data.fhir_synthea.condition`
          GROUP BY patient_id
          HAVING cnt = 1))
GROUP BY condition_code, condition_display
LIMIT 20;
```

```sql
-- 10) Final answer: top 8 conditions by highest # of different active meds in any single patient
SELECT
  condition_display      AS condition_name,
  condition_code,
  max_active_meds_any_patient
FROM (
  SELECT
    cond.condition_code,
    cond.condition_display,
    MAX(med_cnt.active_med_cnt) AS max_active_meds_any_patient
  FROM (
    SELECT
      c.subject.patientId                 AS patient_id,
      cod.code                            AS condition_code,
      cod.display                         AS condition_display
    FROM `bigquery-public-data.fhir_synthea.condition` AS c,
         UNNEST(c.code.coding)            AS cod ) AS cond
  JOIN (
    SELECT
      patient_id,
      COUNT(DISTINCT medication_code) AS active_med_cnt
    FROM (
      SELECT
        mr.subject.patientId             AS patient_id,
        med.code                         AS medication_code
      FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr,
           UNNEST(mr.medication.codeableConcept.coding) AS med
      WHERE mr.status = 'active')
    GROUP BY patient_id) AS med_cnt
  ON cond.patient_id = med_cnt.patient_id
  WHERE cond.patient_id IN (
        SELECT patient_id
        FROM (
          SELECT p.id AS patient_id
          FROM `bigquery-public-data.fhir_synthea.patient` AS p
          JOIN UNNEST(p.name) AS n
          WHERE p.active = TRUE AND UPPER(n.family) LIKE 'A%') AS a
        INTERSECT DISTINCT
        SELECT patient_id
        FROM (
          SELECT subject.patientId AS patient_id,
                 COUNT(DISTINCT id) AS cnt
          FROM `bigquery-public-data.fhir_synthea.condition`
          GROUP BY patient_id
          HAVING cnt = 1))
  GROUP BY condition_code, condition_display)
ORDER BY max_active_meds_any_patient DESC
LIMIT 8;
```
