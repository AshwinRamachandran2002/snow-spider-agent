Query:
--Description: (3)  Count how many distinct conditions each patient whose last
--name starts with “A” has (no filter on the rarely-populated “active” flag).
SELECT
  c.subject.patientId            AS patient_id,
  COUNT(DISTINCT c.id)           AS condition_cnt
FROM `bigquery-public-data.fhir_synthea.condition` AS c
WHERE c.subject.patientId IN (
        SELECT p.id
        FROM `bigquery-public-data.fhir_synthea.patient` AS p
        JOIN UNNEST(p.name) AS n
        WHERE UPPER(n.family) LIKE 'A%')
GROUP BY patient_id
LIMIT 20
