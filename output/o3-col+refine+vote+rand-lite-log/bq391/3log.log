Query:
--Description: (9)  For every condition (among our filtered patients),
--find the maximum number of active medications held by ANY single patient.
SELECT
  cond.condition_code,
  cond.condition_display,
  MAX(med_cnt.active_med_cnt) AS max_active_meds_any_patient
FROM (
  SELECT
    c.subject.patientId   AS patient_id,
    cod.code              AS condition_code,
    cod.display           AS condition_display
  FROM `bigquery-public-data.fhir_synthea.condition` AS c,
       UNNEST(c.code.coding) AS cod
  WHERE c.subject.patientId IN (
        SELECT p.id
        FROM `bigquery-public-data.fhir_synthea.patient` AS p
        JOIN UNNEST(p.name) AS n
        WHERE UPPER(n.family) LIKE 'A%')) AS cond
JOIN (
  SELECT
    patient_id,
    COUNT(DISTINCT medication_code) AS active_med_cnt
  FROM (
    SELECT
      mr.subject.patientId         AS patient_id,
      med.code                     AS medication_code
    FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr,
         UNNEST(mr.medication.codeableConcept.coding) AS med
    WHERE mr.status = 'active')
  GROUP BY patient_id) AS med_cnt
ON cond.patient_id = med_cnt.patient_id
WHERE cond.patient_id IN (
      SELECT patient_id
      FROM (
        SELECT
          c.subject.patientId AS patient_id,
          COUNT(DISTINCT c.id) AS cnt
        FROM `bigquery-public-data.fhir_synthea.condition` AS c
        WHERE c.subject.patientId IN (
              SELECT p.id
              FROM `bigquery-public-data.fhir_synthea.patient` AS p
              JOIN UNNEST(p.name) AS n
              WHERE UPPER(n.family) LIKE 'A%')
        GROUP BY patient_id
        HAVING cnt = 1))
GROUP BY condition_code, condition_display
LIMIT 20
