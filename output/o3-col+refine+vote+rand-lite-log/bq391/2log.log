```sql
--Description: One-shot final query: eight conditions (code & name) that have the highest
--maximum number of medications for any single “A-surname, single-condition” patient.
WITH aliveA AS (
  SELECT DISTINCT p.id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient` p
  CROSS JOIN UNNEST(p.name) n
  WHERE n.family LIKE 'A%'
),
one_cond_patients AS (
  SELECT patient_id
  FROM (
    SELECT c.subject.patientId AS patient_id,
           COUNT(DISTINCT c.id) AS conds
    FROM `bigquery-public-data.fhir_synthea.condition` c
    GROUP BY patient_id
  )
  WHERE conds = 1
),
patient_meds AS (
  SELECT mr.subject.patientId AS patient_id,
         COUNT(DISTINCT mc.code) AS med_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request` mr
  CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) mc
  GROUP BY patient_id
)
SELECT
  cc.code    AS condition_code,
  cc.display AS condition_name,
  MAX(pm.med_cnt) AS max_medications
FROM aliveA a
JOIN one_cond_patients oc
  ON a.patient_id = oc.patient_id
JOIN `bigquery-public-data.fhir_synthea.condition` c
  ON c.subject.patientId = a.patient_id
JOIN UNNEST(c.code.coding) cc
JOIN patient_meds pm
  ON pm.patient_id = a.patient_id
GROUP BY cc.code, cc.display
ORDER BY max_medications DESC
LIMIT 8;
```
