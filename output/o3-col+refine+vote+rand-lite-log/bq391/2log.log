```sql
-- 7. Tie each patient’s unique condition to their active-medication count
SELECT
  cond.condition_code,
  cond.condition_display,
  meds.patient_id,
  meds.active_med_cnt
FROM (
  -- patient’s unique condition
  SELECT
    c.subject.patientId AS patient_id,
    cc.code             AS condition_code,
    cc.display          AS condition_display
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  CROSS JOIN UNNEST(c.code.coding) AS cc
  WHERE c.subject.patientId IN (SELECT patient_id FROM ( /* query #5 */ 
      SELECT patient_id
      FROM (
        SELECT
          c.subject.patientId AS patient_id,
          COUNT(DISTINCT c.id) AS num_conditions
        FROM `bigquery-public-data.fhir_synthea.condition` AS c
        WHERE c.subject.patientId IN (
                SELECT DISTINCT p.id
                FROM `bigquery-public-data.fhir_synthea.patient` p
                CROSS JOIN UNNEST(p.name) n
                WHERE p.active = TRUE AND n.family LIKE 'A%'
              )
        GROUP BY patient_id
      )
      WHERE num_conditions = 1 ))
) AS cond
JOIN (
  -- patient’s active medication count
  SELECT
    mr.subject.patientId  AS patient_id,
    COUNT(DISTINCT mc.code) AS active_med_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
  CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
  WHERE mr.status = 'active'
    AND mr.subject.patientId IN (SELECT patient_id FROM ( /* query #5 */ 
        SELECT patient_id
        FROM (
          SELECT
            c.subject.patientId AS patient_id,
            COUNT(DISTINCT c.id) AS num_conditions
          FROM `bigquery-public-data.fhir_synthea.condition` AS c
          WHERE c.subject.patientId IN (
                  SELECT DISTINCT p.id
                  FROM `bigquery-public-data.fhir_synthea.patient` p
                  CROSS JOIN UNNEST(p.name) n
                  WHERE p.active = TRUE AND n.family LIKE 'A%'
                )
          GROUP BY patient_id
        )
        WHERE num_conditions = 1 ))
  GROUP BY patient_id
) AS meds
ON cond.patient_id = meds.patient_id
ORDER BY meds.active_med_cnt DESC
LIMIT 20;
```

```sql
-- 8. Pick the eight conditions whose single best (max) patient shows the most distinct active medications
WITH one_condition_patients AS (
  SELECT patient_id
  FROM (
    SELECT
      c.subject.patientId AS patient_id,
      COUNT(DISTINCT c.id) AS num_conditions
    FROM `bigquery-public-data.fhir_synthea.condition` AS c
    WHERE c.subject.patientId IN (
            SELECT DISTINCT p.id
            FROM `bigquery-public-data.fhir_synthea.patient` p
            CROSS JOIN UNNEST(p.name) n
            WHERE p.active = TRUE AND n.family LIKE 'A%'
          )
    GROUP BY patient_id
  )
  WHERE num_conditions = 1
),
patient_medcnt AS (
  SELECT
    mr.subject.patientId        AS patient_id,
    COUNT(DISTINCT mc.code)     AS med_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
  CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
  WHERE mr.status = 'active'
    AND mr.subject.patientId IN (SELECT patient_id FROM one_condition_patients)
  GROUP BY patient_id
),
patient_condition AS (
  SELECT
    c.subject.patientId AS patient_id,
    cc.code             AS condition_code,
    cc.display          AS condition_display
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  CROSS JOIN UNNEST(c.code.coding) AS cc
  WHERE c.subject.patientId IN (SELECT patient_id FROM one_condition_patients)
)
SELECT
  pc.condition_code      AS condition_code,
  pc.condition_display   AS condition_name,
  MAX(pm.med_cnt)        AS max_active_medications
FROM patient_condition  AS pc
JOIN patient_medcnt     AS pm
  ON pc.patient_id = pm.patient_id
GROUP BY condition_code, condition_name
ORDER BY max_active_medications DESC
LIMIT 8;
```

```sql
-- 9. If you also want to see which single patient carries the biggest load per condition
WITH ranked AS (
  SELECT
    pc.condition_code,
    pc.condition_display,
    pm.patient_id,
    pm.med_cnt,
    ROW_NUMBER() OVER (PARTITION BY pc.condition_code ORDER BY pm.med_cnt DESC) AS rn
  FROM (
      SELECT
        c.subject.patientId AS patient_id,
        cc.code             AS condition_code,
        cc.display          AS condition_display
      FROM `bigquery-public-data.fhir_synthea.condition` AS c
      CROSS JOIN UNNEST(c.code.coding) AS cc
      WHERE c.subject.patientId IN (
            SELECT patient_id
            FROM (
              SELECT
                c.subject.patientId AS patient_id,
                COUNT(DISTINCT c.id) AS num_conditions
              FROM `bigquery-public-data.fhir_synthea.condition` AS c
              WHERE c.subject.patientId IN (
                      SELECT DISTINCT p.id
                      FROM `bigquery-public-data.fhir_synthea.patient` p
                      CROSS JOIN UNNEST(p.name) n
                      WHERE p.active = TRUE AND n.family LIKE 'A%'
                    )
              GROUP BY patient_id
            )
            WHERE num_conditions = 1
        )
  ) AS pc
  JOIN (
      SELECT
        mr.subject.patientId AS patient_id,
        COUNT(DISTINCT mc.code) AS med_cnt
      FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
      CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
      WHERE mr.status = 'active'
        AND mr.subject.patientId IN (
              SELECT patient_id
              FROM (
                SELECT
                  c.subject.patientId AS patient_id,
                  COUNT(DISTINCT c.id) AS num_conditions
                FROM `bigquery-public-data.fhir_synthea.condition` AS c
                WHERE c.subject.patientId IN (
                        SELECT DISTINCT p.id
                        FROM `bigquery-public-data.fhir_synthea.patient` p
                        CROSS JOIN UNNEST(p.name) n
                        WHERE p.active = TRUE AND n.family LIKE 'A%'
                      )
                GROUP BY patient_id
              )
              WHERE num_conditions = 1
            )
      GROUP BY patient_id
  ) AS pm
  ON pc.patient_id = pm.patient_id
)
SELECT
  condition_code,
  condition_display,
  patient_id,
  med_cnt
FROM ranked
WHERE rn = 1
ORDER BY med_cnt DESC
LIMIT 20;
```

```sql
-- 10. Final concise query (if starting fresh) that directly returns the requested eight conditions
SELECT
  cc.code      AS condition_code,
  cc.display   AS condition_name,
  MAX(med_cnt) AS max_active_medications_for_any_patient
FROM (
    -- all living patients whose last name starts with “A”
    SELECT DISTINCT p.id
    FROM `bigquery-public-data.fhir_synthea.patient` p
    CROSS JOIN UNNEST(p.name) n
    WHERE p.active = TRUE
      AND n.family LIKE 'A%'
) AS aliveA
JOIN `bigquery-public-data.fhir_synthea.condition`   c
  ON c.subject.patientId = aliveA.id
JOIN UNNEST(c.code.coding) AS cc
JOIN (
    -- count active meds per patient
    SELECT
      mr.subject.patientId AS patient_id,
      COUNT(DISTINCT mc.code) AS med_cnt
    FROM `bigquery-public-data.fhir_synthea.medication_request` mr
    CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) mc
    WHERE mr.status = 'active'
    GROUP BY patient_id
) pm
  ON pm.patient_id = c.subject.patientId
-- ensure patient has exactly one condition
WHERE c.subject.patientId IN (
        SELECT patient_id
        FROM (
            SELECT c.subject.patientId AS patient_id,
                   COUNT(DISTINCT c.id) AS conds
            FROM `bigquery-public-data.fhir_synthea.condition` c
            GROUP BY patient_id
        )
        WHERE conds = 1
      )
GROUP BY condition_code, condition_name
ORDER BY max_active_medications_for_any_patient DESC
LIMIT 8;
```
