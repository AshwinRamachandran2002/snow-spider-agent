```sql
--Description: Identify all patients whose last name starts with “A” and who have exactly
--one recorded condition; then count, for each of those patients, the number of distinct
--medication codes appearing in MedicationRequest records.  The HAVING clause enforces the
--“one condition” rule, and the inner query aliases the patient ID as `patient_id`, avoiding
--the previous “Unrecognized name” error.
SELECT
  mr.subject.patientId          AS patient_id,
  COUNT(DISTINCT mc.code)       AS med_cnt
FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
WHERE mr.subject.patientId IN (
  SELECT
    c.subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  WHERE c.subject.patientId IN (
    SELECT DISTINCT p.id
    FROM `bigquery-public-data.fhir_synthea.patient` AS p
    CROSS JOIN UNNEST(p.name) AS n
    WHERE n.family LIKE 'A%'
  )
  GROUP BY patient_id
  HAVING COUNT(DISTINCT c.id) = 1
)
GROUP BY patient_id
LIMIT 20;
```
