--Description:  Count how many distinct conditions each target patient has.
WITH target_patients AS (
  SELECT DISTINCT p.id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient` AS p
  JOIN UNNEST(p.name) AS n
  WHERE n.family LIKE 'A%'
    AND (p.active IS TRUE OR p.active IS NULL)
)
SELECT tp.patient_id,
       COUNT(DISTINCT c.id) AS condition_cnt
FROM target_patients  tp
JOIN `bigquery-public-data.fhir_synthea.condition` AS c
  ON c.subject.patientId = tp.patient_id
GROUP BY tp.patient_id
LIMIT 20;
```

```sql
--Description:  List those patients that have exactly ONE distinct condition and show that condition.
WITH target_patients AS (
  SELECT DISTINCT p.id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient` AS p
  JOIN UNNEST(p.name) AS n
  WHERE n.family LIKE 'A%'
    AND (p.active IS TRUE OR p.active IS NULL)
),
single_condition AS (
  SELECT tp.patient_id,
         ANY_VALUE(cc.code)    AS condition_code,
         ANY_VALUE(cc.display) AS condition_text,
         COUNT(DISTINCT c.id)  AS cond_cnt
  FROM target_patients tp
  JOIN `bigquery-public-data.fhir_synthea.condition`  c  ON c.subject.patientId = tp.patient_id
  JOIN UNNEST(c.code.coding)  AS cc
  GROUP BY tp.patient_id
  HAVING cond_cnt = 1
)
SELECT *
FROM single_condition
LIMIT 20;
