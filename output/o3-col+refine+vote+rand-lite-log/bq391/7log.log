```sql
--Description:
-- Find the eight single-diagnosis Conditions (code + text) that, among
-- living patients whose last names start with “A”, have the highest
-- number of DISTINCT active medications prescribed to any single patient.
-- -----------------------------------------------------------------------
-- 1. living_a_patients   : patients with surname beginning “A” and alive
-- 2. single_cond_pts     : restrict to patients who have exactly ONE Condition;
--                          capture that condition’s code/display.
-- 3. patient_med_counts  : for every such patient, count DISTINCT active
--                          medications (MedicationRequest.status = 'active').
-- 4. condition_rank      : per Condition, keep the MAX medication count
--                          achieved by any single patient.
-- 5. final SELECT        : list the top-8 Conditions by that maximum count.
WITH living_a_patients AS (
  SELECT DISTINCT p.id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient` p
  JOIN UNNEST(p.name) n
  WHERE n.family LIKE 'A%'                                   -- last name begins with A
    AND (p.active IS TRUE OR p.active IS NULL)               -- treat NULL as living
),
single_cond_pts AS (
  SELECT lap.patient_id,
         ANY_VALUE(cd.code)    AS condition_code,
         ANY_VALUE(cd.display) AS condition_text
  FROM living_a_patients lap
  JOIN `bigquery-public-data.fhir_synthea.condition` c
    ON c.subject.patientId = lap.patient_id
  JOIN UNNEST(c.code.coding) cd
  GROUP BY lap.patient_id
  HAVING COUNT(DISTINCT c.id) = 1                            -- exactly one Condition
),
patient_med_counts AS (
  SELECT scp.patient_id,
         scp.condition_code,
         scp.condition_text,
         COUNT(DISTINCT med.code) AS num_active_meds
  FROM single_cond_pts scp
  JOIN `bigquery-public-data.fhir_synthea.medication_request` mr
    ON mr.subject.patientId = scp.patient_id
  JOIN UNNEST(mr.medication.codeableConcept.coding) med
  WHERE mr.status = 'active'
  GROUP BY scp.patient_id, scp.condition_code, scp.condition_text
),
condition_rank AS (
  SELECT condition_code,
         condition_text,
         MAX(num_active_meds) AS max_distinct_active_meds_per_patient
  FROM patient_med_counts
  GROUP BY condition_code, condition_text
)
SELECT condition_code,
       condition_text,
       max_distinct_active_meds_per_patient
FROM condition_rank
ORDER BY max_distinct_active_meds_per_patient DESC
LIMIT 8;
```
