Query:
--Description: For each single-diagnosis Condition, return the MAX number of DISTINCT active medications any single patient received.
WITH living_a_patients AS (
  SELECT DISTINCT p.id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient` p
  JOIN UNNEST(p.name) n
  WHERE n.family LIKE 'A%'
    AND (p.active IS TRUE OR p.active IS NULL)
),
single_condition_pts AS (
  SELECT lap.patient_id,
         ANY_VALUE(cd.code)    AS condition_code,
         ANY_VALUE(cd.display) AS condition_text
  FROM living_a_patients lap
  JOIN `bigquery-public-data.fhir_synthea.condition` c
    ON c.subject.patientId = lap.patient_id
  JOIN UNNEST(c.code.coding) cd
  GROUP BY lap.patient_id
  HAVING COUNT(DISTINCT c.id) = 1
),
patient_med_counts AS (
  SELECT scp.patient_id,
         scp.condition_code,
         scp.condition_text,
         COUNT(DISTINCT med.code) AS num_meds
  FROM single_condition_pts scp
  JOIN `bigquery-public-data.fhir_synthea.medication_request` mr
    ON mr.subject.patientId = scp.patient_id
  JOIN UNNEST(mr.medication.codeableConcept.coding) AS med
  WHERE mr.status = 'active'
  GROUP BY scp.patient_id, scp.condition_code, scp.condition_text
)
SELECT condition_code,
       condition_text,
       MAX(num_meds) AS max_distinct_active_meds_per_patient
FROM patient_med_counts
GROUP BY condition_code, condition_text
ORDER BY max_distinct_active_meds_per_patient DESC
LIMIT 8
