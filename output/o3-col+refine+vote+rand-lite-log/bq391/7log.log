```sql
--Description:  Show all ACTIVE medications ordered for those single-condition patients.
WITH single_condition_patients AS (
  SELECT tp.patient_id
  FROM (
    SELECT tp.patient_id, COUNT(DISTINCT c.id) AS cond_cnt
    FROM (
      SELECT DISTINCT p.id AS patient_id
      FROM `bigquery-public-data.fhir_synthea.patient` p
      JOIN UNNEST(p.name) n
      WHERE n.family LIKE 'A%'
        AND (p.active IS TRUE OR p.active IS NULL)
    ) tp
    JOIN `bigquery-public-data.fhir_synthea.condition` c
      ON c.subject.patientId = tp.patient_id
    GROUP BY tp.patient_id
  )
  WHERE cond_cnt = 1
)
SELECT sc.patient_id,
       cc.code        AS medication_code,
       cc.display     AS medication_text,
       mr.status
FROM single_condition_patients sc
JOIN `bigquery-public-data.fhir_synthea.medication_request` mr
  ON mr.subject.patientId = sc.patient_id
JOIN UNNEST(mr.medication.codeableConcept.coding) cc
WHERE mr.status = 'active'
LIMIT 20;
```

```sql
--Description:  Count how many DIFFERENT active medications each eligible patient has.
WITH eligible_patients AS (
  SELECT tp.patient_id
  FROM (
    SELECT tp.patient_id, COUNT(DISTINCT c.id) AS cond_cnt
    FROM (
      SELECT DISTINCT p.id AS patient_id
      FROM `bigquery-public-data.fhir_synthea.patient` p
      JOIN UNNEST(p.name) n
      WHERE n.family LIKE 'A%'
        AND (p.active IS TRUE OR p.active IS NULL)
    ) tp
    JOIN `bigquery-public-data.fhir_synthea.condition` c
      ON c.subject.patientId = tp.patient_id
    GROUP BY tp.patient_id
  )
  WHERE cond_cnt = 1
),
meds AS (
  SELECT ep.patient_id, cc.code AS med_code
  FROM eligible_patients ep
  JOIN `bigquery-public-data.fhir_synthea.medication_request` mr
    ON mr.subject.patientId = ep.patient_id
  JOIN UNNEST(mr.medication.codeableConcept.coding) cc
  WHERE mr.status = 'active'
)
SELECT patient_id,
       COUNT(DISTINCT med_code) AS distinct_active_meds
FROM meds
GROUP BY patient_id
ORDER BY distinct_active_meds DESC
LIMIT 20;
```

```sql
--Description:  Derive, for each condition, the maximum number of distinct active medications
--              prescribed to ANY single patient who has that condition (and no others).
WITH eligible_patients AS (
  SELECT p.id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient` p
  JOIN UNNEST(p.name) n
  WHERE n.family LIKE 'A%'
    AND (p.active IS TRUE OR p.active IS NULL)
),
single_cond AS (
  SELECT ep.patient_id,
         ANY_VALUE(cc.code)    AS condition_code,
         ANY_VALUE(cc.display) AS condition_text
  FROM eligible_patients ep
  JOIN `bigquery-public-data.fhir_synthea.condition` c
    ON c.subject.patientId = ep.patient_id
  JOIN UNNEST(c.code.coding)  cc
  GROUP BY ep.patient_id
  HAVING COUNT(DISTINCT c.id) = 1
),
meds AS (
  SELECT sc.patient_id,
         sc.condition_code,
         sc.condition_text,
         md.code AS med_code
  FROM single_cond sc
  JOIN `bigquery-public-data.fhir_synthea.medication_request` mr
    ON mr.subject.patientId = sc.patient_id
  JOIN UNNEST(mr.medication.codeableConcept.coding) md
  WHERE mr.status = 'active'
),
med_counts AS (
  SELECT condition_code,
         condition_text,
         patient_id,
         COUNT(DISTINCT med_code) AS num_meds
  FROM meds
  GROUP BY condition_code, condition_text, patient_id
)
SELECT condition_code,
       condition_text,
       MAX(num_meds) AS max_distinct_active_meds_per_patient
FROM med_counts
GROUP BY condition_code, condition_text
ORDER BY max_distinct_active_meds_per_patient DESC
LIMIT 8;
```

```sql
--Description:  Show the patients responsible for those top-8 condition/medication counts.
WITH top_conditions AS (
  SELECT *
  FROM (
    -- same CTE chain as previous query
    WITH eligible_patients AS (
      SELECT p.id AS patient_id
      FROM `bigquery-public-data.fhir_synthea.patient` p
      JOIN UNNEST(p.name) n
      WHERE n.family LIKE 'A%'
        AND (p.active IS TRUE OR p.active IS NULL)
    ),
    single_cond AS (
      SELECT ep.patient_id,
             ANY_VALUE(cc.code)    AS condition_code,
             ANY_VALUE(cc.display) AS condition_text
      FROM eligible_patients ep
      JOIN `bigquery-public-data.fhir_synthea.condition` c
        ON c.subject.patientId = ep.patient_id
      JOIN UNNEST(c.code.coding)  cc
      GROUP BY ep.patient_id
      HAVING COUNT(DISTINCT c.id) = 1
    ),
    meds AS (
      SELECT sc.patient_id,
             sc.condition_code,
             sc.condition_text,
             md.code AS med_code
      FROM single_cond sc
      JOIN `bigquery-public-data.fhir_synthea.medication_request` mr
        ON mr.subject.patientId = sc.patient_id
      JOIN UNNEST(mr.medication.codeableConcept.coding) md
      WHERE mr.status = 'active'
    ),
    med_counts AS (
      SELECT condition_code,
             condition_text,
             patient_id,
             COUNT(DISTINCT med_code) AS num_meds
      FROM meds
      GROUP BY condition_code, condition_text, patient_id
    )
    SELECT condition_code,
           condition_text,
           patient_id,
           num_meds,
           RANK() OVER (PARTITION BY condition_code ORDER BY num_meds DESC) AS rnk
    FROM med_counts
  )
  WHERE rnk = 1           -- best patient for each condition
  ORDER BY num_meds DESC
  LIMIT 8
)
SELECT *
FROM top_conditions
LIMIT 20;
```

These nine exploratory queries progress from simple inspection to the final result:  
the eight single-condition diagnoses (condition_code / condition_text) that, among living patients whose surnames start with “A” and who have exactly one distinct condition, are associated with the greatest number of different active medications prescribed to any single patient.
