```sql
-- Among living (“active” = TRUE) patients whose surname starts with “A”
-- and who have exactly ONE distinct condition, find the eight conditions
-- for which any single such patient has the largest count of DIFFERENT
-- active medications.  Return the condition name, its code, and that
-- highest medication count.

WITH eligible_patients AS (
  SELECT DISTINCT p.id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient` AS p
  CROSS JOIN UNNEST(p.name) AS n
  WHERE p.active = TRUE            -- living patients
    AND n.family LIKE 'A%'         -- surname begins with “A”
),

patient_conditions AS (
  SELECT
    c.subject.patientId                              AS patient_id,
    c.code.coding[OFFSET(0)].code                    AS condition_code,
    c.code.coding[OFFSET(0)].display                 AS condition_name
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  JOIN eligible_patients        AS ep
    ON ep.patient_id = c.subject.patientId
),

-- keep only patients that carry exactly one distinct condition
single_condition_patients AS (
  SELECT
    patient_id,
    ANY_VALUE(condition_code)  AS condition_code,
    ANY_VALUE(condition_name)  AS condition_name
  FROM patient_conditions
  GROUP BY patient_id
  HAVING COUNT(DISTINCT condition_code) = 1
),

-- count distinct active medications per qualifying patient
patient_active_meds AS (
  SELECT
    mr.subject.patientId AS patient_id,
    COUNT(DISTINCT mr.medication.codeableConcept.coding[OFFSET(0)].code)
      AS active_med_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
  JOIN single_condition_patients AS scp
    ON scp.patient_id = mr.subject.patientId
  WHERE mr.status = 'active'
  GROUP BY patient_id
),

pat_cond_med AS (
  SELECT
    scp.patient_id,
    scp.condition_code,
    scp.condition_name,
    COALESCE(pam.active_med_cnt, 0) AS active_med_cnt
  FROM single_condition_patients AS scp
  LEFT JOIN patient_active_meds AS pam
    USING (patient_id)
),

condition_max_meds AS (
  SELECT
    condition_name,
    condition_code,
    MAX(active_med_cnt) AS highest_active_med_cnt_for_one_patient
  FROM pat_cond_med
  GROUP BY condition_name, condition_code
)

SELECT
  condition_name,
  condition_code,
  highest_active_med_cnt_for_one_patient
FROM condition_max_meds
ORDER BY highest_active_med_cnt_for_one_patient DESC
LIMIT 8;
```
