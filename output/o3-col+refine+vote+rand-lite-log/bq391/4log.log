Query:
--Description: Count how many distinct conditions each patient carries.  
--(Previously fine; no overly-restrictive filters to change.)
SELECT
    c.subject.patientId                                   AS patient_id,
    COUNT(DISTINCT c.code.coding[OFFSET(0)].code)         AS condition_cnt
FROM `bigquery-public-data.fhir_synthea.condition` AS c
GROUP BY patient_id
LIMIT 20
