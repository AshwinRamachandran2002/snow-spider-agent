            o.code.coding[OFFSET(0)].display             AS condition_name,
            COUNT(DISTINCT mr.medication.codeableConcept.coding[OFFSET(0)].code)
                   AS active_med_cnt
    FROM   `bigquery-public-data.fhir_synthea.patient` p
    JOIN   UNNEST(p.name) n
    JOIN   `bigquery-public-data.fhir_synthea.condition` o
           ON o.subject.patientId = p.id
    LEFT JOIN `bigquery-public-data.fhir_synthea.medication_request` mr
           ON mr.subject.patientId = p.id
          AND mr.status = 'active'
    WHERE  n.family LIKE 'A%'
      AND  (SELECT COUNT(DISTINCT c2.code.coding[OFFSET(0)].code)
             FROM   `bigquery-public-data.fhir_synthea.condition` c2
             WHERE  c2.subject.patientId = p.id) = 1
    GROUP  BY patient_id, condition_code, condition_name
)
SELECT  condition_name,
