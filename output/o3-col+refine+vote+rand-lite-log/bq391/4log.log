           ON o.subject.patientId = p.id
    LEFT JOIN `bigquery-public-data.fhir_synthea.medication_request` mr
           ON mr.subject.patientId = p.id
          AND mr.status = 'active'
    WHERE  n.family LIKE 'A%'
