Query:
--Description: Patients whose last name starts with “A” and who have exactly ONE distinct condition, 
--ignoring the `active` flag so that rows are returned.
WITH one_cond AS (
    SELECT  c.subject.patientId AS patient_id
    FROM    `bigquery-public-data.fhir_synthea.condition` c
    GROUP   BY patient_id
    HAVING  COUNT(DISTINCT c.code.coding[OFFSET(0)].code) = 1
)
SELECT  p.id                 AS patient_id,
        n.family             AS last_name
FROM    `bigquery-public-data.fhir_synthea.patient` p
JOIN    UNNEST(p.name) n
JOIN    one_cond o   ON o.patient_id = p.id
WHERE   n.family LIKE 'A%'
LIMIT 20
