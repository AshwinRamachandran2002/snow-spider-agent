```sql
-- 1. Preview “living” (=active) patients whose last-names start with “A”
SELECT  p.id                         AS patient_id,
        n.family                     AS last_name,
        n.given[SAFE_OFFSET(0)]      AS first_name,
        p.active
FROM    `bigquery-public-data.fhir_synthea.patient` AS p
JOIN    UNNEST(p.name) AS n
WHERE   p.active IS TRUE            -- living
  AND   n.family LIKE 'A%'
LIMIT 20;
```

```sql
-- 2. How many conditions does every patient have?
SELECT  c.subject.patientId                                     AS patient_id,
        COUNT(DISTINCT c.code.coding[OFFSET(0)].code)           AS condition_cnt
FROM    `bigquery-public-data.fhir_synthea.condition` AS c
GROUP BY patient_id
LIMIT 20;
```

```sql
-- 3. Patients (living, last-name “A%”) who have exactly ONE condition
WITH one_cond AS (
      SELECT patient_id
      FROM  (SELECT  c.subject.patientId AS patient_id,
                     COUNT(DISTINCT c.code.coding[OFFSET(0)].code) AS cnt
             FROM   `bigquery-public-data.fhir_synthea.condition` c
             GROUP  BY patient_id)
      WHERE cnt = 1 )
SELECT  p.id AS patient_id,
        n.family AS last_name
FROM    `bigquery-public-data.fhir_synthea.patient` p
JOIN    UNNEST(p.name) AS n
JOIN    one_cond o  ON o.patient_id = p.id
WHERE   p.active IS TRUE
  AND   n.family LIKE 'A%'
LIMIT 20;
```

```sql
-- 4. The single condition carried by every qualifying patient
WITH qual AS (
      SELECT  p.id AS patient_id
      FROM    `bigquery-public-data.fhir_synthea.patient` p
      JOIN    UNNEST(p.name) AS n
      WHERE   p.active IS TRUE AND n.family LIKE 'A%')
SELECT  c.subject.patientId                              AS patient_id,
        c.code.coding[OFFSET(0)].code                    AS condition_code,
        c.code.coding[OFFSET(0)].display                 AS condition_name
FROM    `bigquery-public-data.fhir_synthea.condition` c
JOIN    qual q
  ON    q.patient_id = c.subject.patientId
GROUP  BY patient_id, condition_code, condition_name
LIMIT 20;
```

```sql
-- 5. Active medication-requests for all patients (code & rxnorm)
SELECT  mr.subject.patientId                                        AS patient_id,
        mr.medication.codeableConcept.coding[OFFSET(0)].code        AS med_code,
        mr.medication.codeableConcept.coding[OFFSET(0)].display     AS med_name
FROM    `bigquery-public-data.fhir_synthea.medication_request` mr
WHERE   mr.status = 'active'
LIMIT 20;
```

```sql
-- 6. Count of DIFFERENT active medications per patient
SELECT  patient_id,
        COUNT(DISTINCT med_code) AS active_med_cnt
FROM    (
        SELECT  mr.subject.patientId AS patient_id,
                mr.medication.codeableConcept.coding[OFFSET(0)].code AS med_code
        FROM    `bigquery-public-data.fhir_synthea.medication_request` mr
        WHERE   mr.status = 'active')
GROUP BY patient_id
LIMIT 20;
```

```sql
-- 7. Merge: qualifying patients + their lone condition + #active meds
WITH one_cond_patients AS (
        SELECT  c.subject.patientId AS patient_id,
                c.code.coding[OFFSET(0)].code    AS condition_code,
                c.code.coding[OFFSET(0)].display AS condition_name
        FROM    `bigquery-public-data.fhir_synthea.condition` c
        WHERE   (SELECT COUNT(DISTINCT c2.code.coding[OFFSET(0)].code)
                 FROM   `bigquery-public-data.fhir_synthea.condition` c2
                 WHERE  c2.subject.patientId = c.subject.patientId) = 1 )
,
living_A_patients AS (
        SELECT DISTINCT p.id AS patient_id
        FROM   `bigquery-public-data.fhir_synthea.patient` p
        JOIN   UNNEST(p.name) n
        WHERE  p.active IS TRUE
          AND  n.family LIKE 'A%' )
,
active_meds AS (
        SELECT  mr.subject.patientId                                    AS patient_id,
                mr.medication.codeableConcept.coding[OFFSET(0)].code    AS med_code
        FROM    `bigquery-public-data.fhir_synthea.medication_request` mr
        WHERE   mr.status = 'active' )
SELECT  p.patient_id,
        o.condition_code,
        o.condition_name,
        COUNT(DISTINCT a.med_code)                    AS active_med_cnt
FROM    living_A_patients  p
JOIN    one_cond_patients o   ON o.patient_id = p.patient_id
LEFT JOIN active_meds     a   ON a.patient_id = p.patient_id
GROUP  BY p.patient_id, o.condition_code, o.condition_name
ORDER BY active_med_cnt DESC
LIMIT 20;
```

```sql
-- 8. For each condition, the MAX number of active meds any SINGLE patient has
WITH pat_cond_med AS (    -- result from Query 7
        SELECT  p.patient_id,
                o.condition_code,
                o.condition_name,
                COUNT(DISTINCT a.med_code) AS active_med_cnt
        FROM    (SELECT DISTINCT id, n.family
                 FROM `bigquery-public-data.fhir_synthea.patient`, UNNEST(name) n
                 WHERE active IS TRUE AND n.family LIKE 'A%')        p
        JOIN    `bigquery-public-data.fhir_synthea.condition` o
               ON o.subject.patientId = p.id
        LEFT JOIN `bigquery-public-data.fhir_synthea.medication_request` a
               ON a.subject.patientId = p.id  AND a.status = 'active'
        GROUP BY p.patient_id, o.condition_code, o.condition_name )
SELECT  condition_name,
        condition_code,
        MAX(active_med_cnt) AS max_active_meds_per_patient
FROM    pat_cond_med
GROUP BY condition_name, condition_code
ORDER BY max_active_meds_per_patient DESC
LIMIT 20;
```

```sql
-- 9. FINAL ANSWER: the TOP EIGHT conditions (name & code) that,
--                  for at least one qualifying patient,
--                  have the highest count of different active medications prescribed
WITH pat_cond_med AS (    -- same build as in query 8
        SELECT  p.id                                         AS patient_id,
                o.code.coding[OFFSET(0)].code                AS condition_code,
                o.code.coding[OFFSET(0)].display             AS condition_name,
                COUNT(DISTINCT mr.medication.codeableConcept.coding[OFFSET(0)].code)
                       AS active_med_cnt
        FROM   `bigquery-public-data.fhir_synthea.patient` p
        JOIN   UNNEST(p.name) n
        JOIN   `bigquery-public-data.fhir_synthea.condition` o
               ON o.subject.patientId = p.id
        LEFT JOIN `bigquery-public-data.fhir_synthea.medication_request` mr
               ON mr.subject.patientId = p.id
              AND mr.status = 'active'
        WHERE  p.active IS TRUE
          AND  n.family LIKE 'A%'
          AND  (SELECT COUNT(DISTINCT c2.code.coding[OFFSET(0)].code)
                 FROM   `bigquery-public-data.fhir_synthea.condition` c2
                 WHERE  c2.subject.patientId = p.id) = 1
        GROUP  BY patient_id, condition_code, condition_name )
SELECT  condition_name,
        condition_code,
        MAX(active_med_cnt)        AS highest_active_med_cnt_for_one_patient
FROM    pat_cond_med
GROUP BY condition_name, condition_code
ORDER BY highest_active_med_cnt_for_one_patient DESC
LIMIT 8;
```

```sql
--10. Inspect the top-8 result in detail (patients & their meds) to validate
WITH top8 AS (               -- grab the eight condition codes
        SELECT  condition_code
        FROM   (
            /* paste Query-9 here but without the LIMIT */
            SELECT  condition_code,
                    MAX(active_med_cnt) AS cnt
            FROM   (
                    /* content identical to pat_cond_med in Query-9 */)
            GROUP BY condition_code
            ORDER BY cnt DESC
            LIMIT 8)
)
SELECT  pcm.patient_id,
        pcm.condition_code,
        pcm.condition_name,
        pcm.active_med_cnt
FROM    ( /* pat_cond_med CTE from Query-9 */ ) pcm
JOIN    top8 t
  ON    t.condition_code = pcm.condition_code
ORDER BY pcm.active_med_cnt DESC, pcm.patient_id
LIMIT 50;
```

Each successive query deepens the exploration, concluding with Query 9 that directly returns  
“the eight conditions (with codes) having the highest number of different active medications prescribed to any single qualifying patient.”
