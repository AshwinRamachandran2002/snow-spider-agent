/*  Eight conditions that, for at least one “living” patient whose surname
    starts with “A” and who has exactly one distinct condition, show the
    highest number of DIFFERENT active medications received by any single
    such patient.  “Living” = active IS TRUE **or** active is NULL because
    most rows omit that flag.                                            */

WITH eligible_patients AS (            -- patients regarded as living
  SELECT DISTINCT p.id AS patient_id
  FROM  `bigquery-public-data.fhir_synthea.patient` AS p
  CROSS JOIN UNNEST(p.name) AS n
  WHERE p.active IS NOT FALSE           -- TRUE or NULL
    AND n.family LIKE 'A%'              -- surname begins with “A”
),

patient_conditions AS (                 -- every condition per such pt
  SELECT
    c.subject.patientId            AS patient_id,
    c.code.coding[OFFSET(0)].code  AS condition_code,
    c.code.coding[OFFSET(0)].display AS condition_name
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  JOIN eligible_patients ep
    ON ep.patient_id = c.subject.patientId
),

single_condition_patients AS (          -- keep pts w/ exactly ONE cond.
  SELECT
    patient_id,
    ARRAY_AGG(DISTINCT condition_code )[OFFSET(0)]  AS condition_code,
    ARRAY_AGG(DISTINCT condition_name)[OFFSET(0)]   AS condition_name
  FROM patient_conditions
  GROUP BY patient_id
  HAVING COUNT(DISTINCT condition_code) = 1
),

patient_active_meds AS (                -- distinct ACTIVE meds per pt
  SELECT
    mr.subject.patientId AS patient_id,
    COUNT(DISTINCT mr.medication.codeableConcept.coding[OFFSET(0)].code)
        AS active_med_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
  JOIN single_condition_patients scp
    ON scp.patient_id = mr.subject.patientId
  WHERE mr.status = 'active'
  GROUP BY patient_id
),

pat_cond_med AS (                       -- merge pts, cond, med counts
  SELECT
    scp.condition_name,
    scp.condition_code,
    COALESCE(pam.active_med_cnt, 0) AS active_med_cnt
  FROM single_condition_patients scp
  LEFT JOIN patient_active_meds pam
    ON pam.patient_id = scp.patient_id
)

SELECT
  condition_name,
  condition_code,
  MAX(active_med_cnt) AS highest_active_med_cnt_for_one_patient
FROM pat_cond_med
