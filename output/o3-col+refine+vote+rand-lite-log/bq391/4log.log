/*  Eight conditions that, for at least one living patient whose surname
    starts with “A” and who has exactly one condition, are treated with
    the greatest number of DIFFERENT active medications.               */

WITH eligible_patients AS (         -- living patients, surname “A%”
  SELECT DISTINCT p.id AS patient_id
  FROM  `bigquery-public-data.fhir_synthea.patient`  AS p
  CROSS JOIN UNNEST(p.name) AS n
  WHERE p.active = TRUE
    AND n.family LIKE 'A%'
),

patient_conditions AS (             -- every cond. carried by those pts
  SELECT
    c.subject.patientId                       AS patient_id,
    c.code.coding[OFFSET(0)].code             AS condition_code,
    c.code.coding[OFFSET(0)].display          AS condition_name
  FROM  `bigquery-public-data.fhir_synthea.condition` AS c
  JOIN  eligible_patients ep
    ON  ep.patient_id = c.subject.patientId
),

single_condition_patients AS (      -- keep pts w/ exactly ONE condition
  SELECT *
  FROM (
        SELECT
          patient_id,
          ARRAY_AGG(DISTINCT condition_code )[OFFSET(0)] AS condition_code,
          ARRAY_AGG(DISTINCT condition_name)[OFFSET(0)] AS condition_name,
          COUNT(DISTINCT condition_code)                AS condition_cnt
        FROM patient_conditions
        GROUP BY patient_id
       )
  WHERE condition_cnt = 1
),

patient_active_meds AS (            -- count different ACTIVE meds/pt
  SELECT
    mr.subject.patientId AS patient_id,
    COUNT(DISTINCT mr.medication.codeableConcept.coding[OFFSET(0)].code)
        AS active_med_cnt
  FROM  `bigquery-public-data.fhir_synthea.medication_request` mr
  JOIN  single_condition_patients scp
    ON  scp.patient_id = mr.subject.patientId
  WHERE mr.status = 'active'
  GROUP BY patient_id
),

pat_cond_med AS (                   -- combine pts, their cond., med-cnt
  SELECT
    scp.patient_id,
    scp.condition_code,
    scp.condition_name,
    IFNULL(pam.active_med_cnt ,0) AS active_med_cnt
  FROM single_condition_patients scp
  LEFT JOIN patient_active_meds pam
    USING (patient_id)
)

SELECT
  condition_name,
  condition_code,
  MAX(active_med_cnt) AS highest_active_med_cnt_for_one_patient
FROM pat_cond_med
GROUP BY condition_name, condition_code
ORDER BY highest_active_med_cnt_for_one_patient DESC
LIMIT 8;
