Query:
--Description: 10) Final answer – the eight conditions (code + text) whose *single* “A-surname”, one-condition
--                patient has the highest number of distinct active medications.
WITH single_cond AS (
  SELECT
    c.subject.patientId           AS patient_id,
    c.code.coding[OFFSET(0)].code AS condition_code,
    c.code.text                   AS condition_text
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  JOIN (
          SELECT patient_id
          FROM (
                SELECT
                  c.subject.patientId AS patient_id,
                  COUNT(DISTINCT c.code.coding[OFFSET(0)].code) AS cond_cnt
                FROM `bigquery-public-data.fhir_synthea.condition` AS c
                JOIN (
                        SELECT p.id AS patient_id
                        FROM `bigquery-public-data.fhir_synthea.patient` AS p
                        JOIN UNNEST(p.name) AS n
                        WHERE n.use = 'official'
                          AND STARTS_WITH(UPPER(n.family), 'A')
                          AND (p.active IS TRUE OR p.active IS NULL)
                     ) AS a
                ON c.subject.patientId = a.patient_id
                GROUP BY patient_id
          )
          WHERE cond_cnt = 1
       ) AS good
  ON c.subject.patientId = good.patient_id
),
med_counts AS (
  SELECT
    mr.subject.patientId AS patient_id,
    COUNT(DISTINCT mr.medication.codeableConcept.coding[OFFSET(0)].code) AS active_med_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
  WHERE LOWER(mr.status) = 'active'
  GROUP BY patient_id
),
cond_med AS (
  SELECT
    sc.condition_code,
    sc.condition_text,
    mc.active_med_cnt
  FROM single_cond AS sc
  JOIN med_counts  AS mc
  ON sc.patient_id = mc.patient_id
)
SELECT
  condition_code,
  condition_text,
  MAX(active_med_cnt) AS max_active_meds_for_any_patient
FROM cond_med
GROUP BY condition_code, condition_text
ORDER BY max_active_meds_for_any_patient DESC
LIMIT 8
