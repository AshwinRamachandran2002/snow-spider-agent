--Description: 3) Identify “A*” patients that have exactly ONE distinct condition.
--   Step-1: pull patient IDs whose family name begins with 'a'.
--   Step-2: count condition texts per patient.
--   Step-3: keep only those with condition_cnt = 1.
SELECT patient_id
FROM (
  SELECT
    c.subject.patientId        AS patient_id,
    COUNT(DISTINCT c.code.text) AS condition_cnt
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  WHERE c.subject.patientId IN (
        SELECT p.id
        FROM `bigquery-public-data.fhir_synthea.patient` AS p
        CROSS JOIN UNNEST(p.name) AS n
        WHERE LOWER(n.family) LIKE 'a%' )
  GROUP BY patient_id
)
WHERE condition_cnt = 1
LIMIT 20
