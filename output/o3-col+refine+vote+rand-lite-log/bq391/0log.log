```sql
-- 10. Final answer: top 8 single-condition diagnoses (code + text) among living 
--     “A*” patients, ranked by the highest number of different active meds any one
--     patient with that condition is taking
SELECT condition_code  AS code,
       condition_text  AS condition,
       max_active_meds_per_patient AS highest_active_med_count
FROM (
      SELECT condition_code,
             condition_text,
             MAX(active_med_cnt) AS max_active_meds_per_patient
      FROM (
            SELECT c.subject.patientId AS patient_id,
                   (SELECT coding.code
                    FROM   UNNEST(c.code.coding) AS coding
                    LIMIT  1)          AS condition_code,
                   c.code.text         AS condition_text,
                   COALESCE(m.med_cnt,0) AS active_med_cnt
            FROM   `bigquery-public-data.fhir_synthea.condition` AS c
            JOIN  (
                  SELECT mr.subject.patientId AS patient_id,
                         COUNT(DISTINCT (SELECT cd.code
                                         FROM UNNEST(mr.medication.codeableConcept.coding) cd LIMIT 1)) AS med_cnt
                  FROM   `bigquery-public-data.fhir_synthea.medication_request` mr
                  WHERE  LOWER(mr.status) = 'active'
                  GROUP  BY patient_id ) AS m
            ON     c.subject.patientId = m.patient_id
            WHERE  c.subject.patientId IN (
                   SELECT id
                   FROM   `bigquery-public-data.fhir_synthea.patient` p
                   CROSS JOIN UNNEST(p.name) n
                   WHERE  LOWER(n.family) LIKE 'a%'  AND p.active = TRUE )
            GROUP BY patient_id, condition_code, condition_text, active_med_cnt )
      GROUP BY condition_code, condition_text )
ORDER BY highest_active_med_count DESC
LIMIT 8;
```
