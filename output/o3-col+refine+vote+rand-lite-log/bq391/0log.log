Query:
--Description: 7) Combine each patient’s condition (from query-4) with their count of
--              active medications (from query-6).
WITH
  single_condition AS (   -- query-4 body
    SELECT
      c.subject.patientId AS patient_id,
      (SELECT cd.code FROM UNNEST(c.code.coding) cd LIMIT 1) AS condition_code,
      c.code.text        AS condition_text
    FROM `bigquery-public-data.fhir_synthea.condition` c
    WHERE c.subject.patientId IN (
          SELECT patient_id
          FROM (
            SELECT c.subject.patientId AS patient_id,
                   COUNT(DISTINCT c.code.text) AS cnt
            FROM `bigquery-public-data.fhir_synthea.condition` c
            WHERE c.subject.patientId IN (
                 SELECT p.id
                 FROM `bigquery-public-data.fhir_synthea.patient` p
                 CROSS JOIN UNNEST(p.name) n
                 WHERE LOWER(n.family) LIKE 'a%' )
            GROUP BY patient_id
            HAVING cnt = 1 ) ) ),
  med_counts AS (         -- query-6 body
    SELECT
      mr.subject.patientId AS patient_id,
      COUNT(DISTINCT (SELECT cd.code FROM UNNEST(mr.medication.codeableConcept.coding) cd LIMIT 1))
         AS active_med_cnt
    FROM `bigquery-public-data.fhir_synthea.medication_request` mr
    WHERE LOWER(mr.status) = 'active'
      AND mr.subject.patientId IN (SELECT patient_id FROM single_condition)
    GROUP BY patient_id )
SELECT
  sc.condition_code,
  sc.condition_text,
  sc.patient_id,
  mc.active_med_cnt
FROM single_condition sc
LEFT JOIN med_counts mc
ON  sc.patient_id = mc.patient_id
LIMIT 20
