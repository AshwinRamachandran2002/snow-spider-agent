--Description: 10) FINAL ANSWER – top-8 single-condition diagnoses (code & text) for “A*”
--                patients, together with the HIGHEST count of different active medications
--                taken by any single patient with that diagnosis.
WITH patient_ids AS (              -- eligible patients with 1 condition
  SELECT patient_id
  FROM (
    SELECT c.subject.patientId AS patient_id,
           COUNT(DISTINCT c.code.text) AS cnt
    FROM `bigquery-public-data.fhir_synthea.condition` c
    WHERE c.subject.patientId IN (
          SELECT p.id
          FROM `bigquery-public-data.fhir_synthea.patient` p
          CROSS JOIN UNNEST(p.name) n
          WHERE LOWER(n.family) LIKE 'a%' )
    GROUP BY patient_id
    HAVING cnt = 1 ) ),
cond_per_patient AS (              -- each patient’s lone condition
  SELECT
    c.subject.patientId AS patient_id,
    (SELECT cd.code FROM UNNEST(c.code.coding) cd LIMIT 1) AS condition_code,
    c.code.text         AS condition_text
  FROM `bigquery-public-data.fhir_synthea.condition` c
  WHERE c.subject.patientId IN (SELECT patient_id FROM patient_ids) ),
active_med_counts AS (             -- active medication count per patient
  SELECT
    mr.subject.patientId AS patient_id,
    COUNT(DISTINCT (SELECT cd.code
                    FROM UNNEST(mr.medication.codeableConcept.coding) cd LIMIT 1)) AS med_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request` mr
  WHERE LOWER(mr.status) = 'active'
    AND mr.subject.patientId IN (SELECT patient_id FROM patient_ids)
  GROUP BY patient_id )
SELECT
  cp.condition_code AS code,
  cp.condition_text AS condition,
  MAX(amc.med_cnt)  AS highest_active_med_count
FROM cond_per_patient cp
LEFT JOIN active_med_counts amc
ON  cp.patient_id = amc.patient_id
GROUP BY code, condition
ORDER BY highest_active_med_count DESC
LIMIT 8
