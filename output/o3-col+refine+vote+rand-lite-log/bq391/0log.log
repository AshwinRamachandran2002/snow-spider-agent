```sql
--Description: 6) Count how many DISTINCT active medication codes each single-condition
--              “A*” patient currently has.
SELECT
  mr.subject.patientId AS patient_id,
  COUNT( DISTINCT (SELECT cd.code FROM UNNEST(mr.medication.codeableConcept.coding) cd LIMIT 1) )
      AS active_med_cnt
FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
WHERE mr.subject.patientId IN (
        /* patient list from query-3 */
        SELECT patient_id
        FROM (
          SELECT c.subject.patientId  AS patient_id,
                 COUNT(DISTINCT c.code.text) AS cnt
          FROM `bigquery-public-data.fhir_synthea.condition` c
          WHERE c.subject.patientId IN (
               SELECT p.id
               FROM `bigquery-public-data.fhir_synthea.patient` p
               CROSS JOIN UNNEST(p.name) n
               WHERE LOWER(n.family) LIKE 'a%' )
          GROUP BY patient_id
          HAVING cnt = 1 ) )
  AND LOWER(mr.status) = 'active'
GROUP BY patient_id
LIMIT 20;
```

```sql
--Description: 7) Combine each patient’s condition (from query-4) with their count of
--              active medications (from query-6).
WITH
  single_condition AS (   -- query-4 body
    SELECT
      c.subject.patientId AS patient_id,
      (SELECT cd.code FROM UNNEST(c.code.coding) cd LIMIT 1) AS condition_code,
      c.code.text        AS condition_text
    FROM `bigquery-public-data.fhir_synthea.condition` c
    WHERE c.subject.patientId IN (
          SELECT patient_id
          FROM (
            SELECT c.subject.patientId AS patient_id,
                   COUNT(DISTINCT c.code.text) AS cnt
            FROM `bigquery-public-data.fhir_synthea.condition` c
            WHERE c.subject.patientId IN (
                 SELECT p.id
                 FROM `bigquery-public-data.fhir_synthea.patient` p
                 CROSS JOIN UNNEST(p.name) n
                 WHERE LOWER(n.family) LIKE 'a%' )
            GROUP BY patient_id
            HAVING cnt = 1 ) ) ),
  med_counts AS (         -- query-6 body
    SELECT
      mr.subject.patientId AS patient_id,
      COUNT(DISTINCT (SELECT cd.code FROM UNNEST(mr.medication.codeableConcept.coding) cd LIMIT 1))
         AS active_med_cnt
    FROM `bigquery-public-data.fhir_synthea.medication_request` mr
    WHERE LOWER(mr.status) = 'active'
      AND mr.subject.patientId IN (SELECT patient_id FROM single_condition)
    GROUP BY patient_id )
SELECT
  sc.condition_code,
  sc.condition_text,
  sc.patient_id,
  mc.active_med_cnt
FROM single_condition sc
LEFT JOIN med_counts mc
ON  sc.patient_id = mc.patient_id
LIMIT 20;
```

```sql
--Description: 8) For each condition, find the MAX number of active meds prescribed to
--              any one single-condition “A*” patient.
WITH patient_cond_med AS (  /* query-7 body */
  WITH
    single_condition AS (
      SELECT
        c.subject.patientId AS patient_id,
        (SELECT cd.code FROM UNNEST(c.code.coding) cd LIMIT 1) AS condition_code,
        c.code.text        AS condition_text
      FROM `bigquery-public-data.fhir_synthea.condition` c
      WHERE c.subject.patientId IN (
            SELECT patient_id
            FROM (
              SELECT c.subject.patientId AS patient_id,
                     COUNT(DISTINCT c.code.text) AS cnt
              FROM `bigquery-public-data.fhir_synthea.condition` c
              WHERE c.subject.patientId IN (
                   SELECT p.id
                   FROM `bigquery-public-data.fhir_synthea.patient` p
                   CROSS JOIN UNNEST(p.name) n
                   WHERE LOWER(n.family) LIKE 'a%' )
              GROUP BY patient_id
              HAVING cnt = 1 ) ) ),
    med_counts AS (
      SELECT
        mr.subject.patientId AS patient_id,
        COUNT(DISTINCT (SELECT cd.code
                        FROM UNNEST(mr.medication.codeableConcept.coding) cd LIMIT 1))
          AS active_med_cnt
      FROM `bigquery-public-data.fhir_synthea.medication_request` mr
      WHERE LOWER(mr.status) = 'active'
        AND mr.subject.patientId IN (SELECT patient_id FROM single_condition)
      GROUP BY patient_id )
  SELECT
    sc.condition_code,
    sc.condition_text,
    mc.active_med_cnt
  FROM single_condition sc
  LEFT JOIN med_counts mc
  ON sc.patient_id = mc.patient_id )
SELECT
  condition_code,
  condition_text,
  MAX(active_med_cnt) AS max_active_meds_per_patient
FROM patient_cond_med
GROUP BY condition_code, condition_text
ORDER BY max_active_meds_per_patient DESC
LIMIT 20;
```

```sql
--Description: 9) Retrieve the TOP-8 conditions with the highest maximum active-medication
--              count among eligible patients (derived from query-8).
WITH condition_max_meds AS ( /* query-8 body without LIMIT */
  WITH patient_cond_med AS (
    -- (same CTE definition as in query-8)
    WITH
      single_condition AS (
        SELECT
          c.subject.patientId AS patient_id,
          (SELECT cd.code FROM UNNEST(c.code.coding) cd LIMIT 1) AS condition_code,
          c.code.text        AS condition_text
        FROM `bigquery-public-data.fhir_synthea.condition` c
        WHERE c.subject.patientId IN (
              SELECT patient_id
              FROM (
                SELECT c.subject.patientId AS patient_id,
                       COUNT(DISTINCT c.code.text) AS cnt
                FROM `bigquery-public-data.fhir_synthea.condition` c
                WHERE c.subject.patientId IN (
                     SELECT p.id
                     FROM `bigquery-public-data.fhir_synthea.patient` p
                     CROSS JOIN UNNEST(p.name) n
                     WHERE LOWER(n.family) LIKE 'a%' )
                GROUP BY patient_id
                HAVING cnt = 1 ) ) ),
      med_counts AS (
        SELECT
          mr.subject.patientId AS patient_id,
          COUNT(DISTINCT (SELECT cd.code
                          FROM UNNEST(mr.medication.codeableConcept.coding) cd LIMIT 1))
            AS active_med_cnt
        FROM `bigquery-public-data.fhir_synthea.medication_request` mr
        WHERE LOWER(mr.status) = 'active'
          AND mr.subject.patientId IN (SELECT patient_id FROM single_condition)
        GROUP BY patient_id )
    SELECT
      sc.condition_code,
      sc.condition_text,
      mc.active_med_cnt
    FROM single_condition sc
    LEFT JOIN med_counts mc
    ON sc.patient_id = mc.patient_id )
  SELECT
    condition_code,
    condition_text,
    MAX(active_med_cnt) AS max_active_meds_per_patient
  FROM patient_cond_med
  GROUP BY condition_code, condition_text )
SELECT *
FROM condition_max_meds
ORDER BY max_active_meds_per_patient DESC
LIMIT 8;
```

```sql
--Description: 10) FINAL ANSWER – top-8 single-condition diagnoses (code & text) for “A*”
--                patients, together with the HIGHEST count of different active medications
--                taken by any single patient with that diagnosis.
WITH patient_ids AS (              -- eligible patients with 1 condition
  SELECT patient_id
  FROM (
    SELECT c.subject.patientId AS patient_id,
           COUNT(DISTINCT c.code.text) AS cnt
    FROM `bigquery-public-data.fhir_synthea.condition` c
    WHERE c.subject.patientId IN (
          SELECT p.id
          FROM `bigquery-public-data.fhir_synthea.patient` p
          CROSS JOIN UNNEST(p.name) n
          WHERE LOWER(n.family) LIKE 'a%' )
    GROUP BY patient_id
    HAVING cnt = 1 ) ),
cond_per_patient AS (              -- each patient’s lone condition
  SELECT
    c.subject.patientId AS patient_id,
    (SELECT cd.code FROM UNNEST(c.code.coding) cd LIMIT 1) AS condition_code,
    c.code.text         AS condition_text
  FROM `bigquery-public-data.fhir_synthea.condition` c
  WHERE c.subject.patientId IN (SELECT patient_id FROM patient_ids) ),
active_med_counts AS (             -- active medication count per patient
  SELECT
    mr.subject.patientId AS patient_id,
    COUNT(DISTINCT (SELECT cd.code
                    FROM UNNEST(mr.medication.codeableConcept.coding) cd LIMIT 1)) AS med_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request` mr
  WHERE LOWER(mr.status) = 'active'
    AND mr.subject.patientId IN (SELECT patient_id FROM patient_ids)
  GROUP BY patient_id )
SELECT
  cp.condition_code AS code,
  cp.condition_text AS condition,
  MAX(amc.med_cnt)  AS highest_active_med_count
FROM cond_per_patient cp
LEFT JOIN active_med_counts amc
ON  cp.patient_id = amc.patient_id
GROUP BY code, condition
ORDER BY highest_active_med_count DESC
LIMIT 8;
```
