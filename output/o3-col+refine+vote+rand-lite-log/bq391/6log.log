Query:
--Description: 8. Attach each patient’s single condition to their count of active meds.
--              No type conflicts; query unchanged.
WITH single_condition_patients AS (
  SELECT pc.patient_id,
         MIN(pc.condition_code)     AS condition_code,
         MIN(pc.condition_display)  AS condition_text
  FROM (
        SELECT c.subject.patientId AS patient_id,
               cc.code             AS condition_code,
               cc.display          AS condition_display
        FROM   `bigquery-public-data.fhir_synthea.condition` AS c
        CROSS  JOIN UNNEST(c.code.coding) AS cc
        WHERE  c.subject.patientId IN (
                 SELECT DISTINCT p.id
                 FROM   `bigquery-public-data.fhir_synthea.patient` AS p
                 CROSS  JOIN UNNEST(p.name) AS n
                 WHERE  n.family LIKE 'A%'
               )
       ) pc
  GROUP BY pc.patient_id
  HAVING COUNT(*) = 1
),
patient_med_counts AS (
  SELECT mr.subject.patientId   AS patient_id,
         COUNT(DISTINCT mc.code) AS active_med_cnt
  FROM   `bigquery-public-data.fhir_synthea.medication_request` AS mr
  CROSS  JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
  WHERE  mr.status = 'active'
  GROUP  BY patient_id
)
SELECT sc.patient_id,
       sc.condition_code,
       sc.condition_text,
       pm.active_med_cnt
FROM   single_condition_patients AS sc
JOIN   patient_med_counts       AS pm
ON     sc.patient_id = pm.patient_id
LIMIT 20
