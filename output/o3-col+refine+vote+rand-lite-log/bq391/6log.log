```sql
--Description: Determine the eight conditions (code + text) that, among living patients
--             whose last names start with “A” and who have exactly one distinct condition,
--             are linked to the highest number of DIFFERENT active medications prescribed
--             to any single patient.
--             Logic outline:
--   1. a_surname_patients – IDs of living/active patients whose family name begins with “A”.
--   2. single_condition_patients – of those IDs, keep only patients with exactly ONE
--      condition; capture that condition’s code & text.
--   3. med_counts_per_patient – for each of those patients, count DISTINCT medications
--      with MedicationRequest.status = 'active'.
--   4. per_patient_cond – join (2) and (3) so each row is (condition, active-med-count).
--   5. Aggregate by condition to get MAX(active_med_cnt) seen for any patient,
--      then return the top 8 conditions by that value.

WITH a_surname_patients AS (
  SELECT DISTINCT p.id AS patient_id
  FROM   `bigquery-public-data.fhir_synthea.patient` AS p
  CROSS  JOIN UNNEST(p.name) AS n
  WHERE  n.family LIKE 'A%'           -- surname begins with “A”
    AND  COALESCE(p.active, TRUE)     -- treat NULL as living/active
),
single_condition_patients AS (
  SELECT patient_id,
         MIN(condition_code)    AS condition_code,
         MIN(condition_display) AS condition_text
  FROM (
        SELECT c.subject.patientId AS patient_id,
               cc.code             AS condition_code,
               cc.display          AS condition_display
        FROM   `bigquery-public-data.fhir_synthea.condition` AS c
        CROSS  JOIN UNNEST(c.code.coding) AS cc
        WHERE  c.subject.patientId IN (SELECT patient_id FROM a_surname_patients)
       )
  GROUP BY patient_id
  HAVING COUNT(DISTINCT condition_code) = 1       -- exactly one condition
),
med_counts_per_patient AS (
  SELECT mr.subject.patientId    AS patient_id,
         COUNT(DISTINCT mc.code) AS active_med_cnt
  FROM   `bigquery-public-data.fhir_synthea.medication_request` AS mr
  CROSS  JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
  WHERE  mr.status = 'active'
    AND  mr.subject.patientId IN (SELECT patient_id FROM single_condition_patients)
  GROUP BY patient_id
),
per_patient_cond AS (
  SELECT sc.condition_code,
         sc.condition_text,
         mcpp.active_med_cnt
  FROM   single_condition_patients  AS sc
  JOIN   med_counts_per_patient     AS mcpp
  ON     sc.patient_id = mcpp.patient_id
)
SELECT condition_code,
       condition_text,
       MAX(active_med_cnt) AS max_active_meds_for_any_patient
FROM   per_patient_cond
GROUP BY condition_code, condition_text
ORDER BY max_active_meds_for_any_patient DESC
LIMIT 8;
```
