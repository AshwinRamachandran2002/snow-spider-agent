--Description: 10. FINAL ANSWER – top 8 conditions whose single-condition “A-surname” patients
--              have the highest count of different active medications.
--              Only potential issue was COALESCE with BOOL; here both arguments are BOOL
--              (p.active and TRUE), so no change needed.
WITH a_surname_patients AS (
  SELECT DISTINCT p.id AS patient_id
  FROM   `bigquery-public-data.fhir_synthea.patient` AS p
  CROSS  JOIN UNNEST(p.name) AS n
  WHERE  n.family LIKE 'A%'         -- last name begins with “A”
  AND    COALESCE(p.active, TRUE)   -- treat NULL as living/active
),
single_condition_patients AS (
  -- keep only patients with EXACTLY one distinct condition
  SELECT patient_id,
         MIN(condition_code)    AS condition_code,
         MIN(condition_display) AS condition_text
  FROM (
        SELECT c.subject.patientId AS patient_id,
               cc.code             AS condition_code,
               cc.display          AS condition_display
        FROM   `bigquery-public-data.fhir_synthea.condition` AS c
        CROSS  JOIN UNNEST(c.code.coding) AS cc
        WHERE  c.subject.patientId IN (SELECT patient_id FROM a_surname_patients)
       )
  GROUP BY patient_id
  HAVING COUNT(DISTINCT condition_code) = 1
),
patient_active_meds AS (
  SELECT mr.subject.patientId AS patient_id,
         mc.code              AS med_code
  FROM   `bigquery-public-data.fhir_synthea.medication_request` AS mr
  CROSS  JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
  WHERE  mr.status = 'active'
    AND  mr.subject.patientId IN (SELECT patient_id FROM single_condition_patients)
),
med_counts_per_patient AS (
  SELECT patient_id,
         COUNT(DISTINCT med_code) AS active_med_cnt
  FROM   patient_active_meds
  GROUP BY patient_id
)
SELECT sc.condition_code,
       sc.condition_text,
       MAX(mcpp.active_med_cnt) AS max_active_meds_for_any_patient
FROM   single_condition_patients  AS sc
JOIN   med_counts_per_patient    AS mcpp
ON     sc.patient_id = mcpp.patient_id
GROUP BY sc.condition_code,
         sc.condition_text
ORDER BY max_active_meds_for_any_patient DESC
LIMIT 8
