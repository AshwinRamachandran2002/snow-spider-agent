```sql
-- 8. Attach each patient’s SINGLE condition to the count of their active meds
WITH single_condition_patients AS (
  SELECT pc.patient_id,
         MIN(pc.condition_code)   AS condition_code,   -- only one per patient
         MIN(pc.condition_display) AS condition_text
  FROM (
        SELECT c.subject.patientId AS patient_id,
               cc.code             AS condition_code,
               cc.display          AS condition_display
        FROM   `bigquery-public-data.fhir_synthea.condition`  c
        CROSS  JOIN UNNEST(c.code.coding) cc
        WHERE  c.subject.patientId IN (
                 SELECT DISTINCT p.id
                 FROM   `bigquery-public-data.fhir_synthea.patient` p
                 CROSS  JOIN UNNEST(p.name) n
                 WHERE  n.family LIKE 'A%'
               )
       ) pc
  GROUP BY pc.patient_id
  HAVING COUNT(*) = 1
),
patient_med_counts AS (
  SELECT mr.subject.patientId   AS patient_id,
         COUNT(DISTINCT mc.code) AS active_med_cnt
  FROM   `bigquery-public-data.fhir_synthea.medication_request` mr
  CROSS  JOIN UNNEST(mr.medication.codeableConcept.coding) mc
  WHERE  mr.status = 'active'
  GROUP  BY patient_id
)
SELECT sc.patient_id,
       sc.condition_code,
       sc.condition_text,
       pm.active_med_cnt
FROM   single_condition_patients  sc
JOIN   patient_med_counts        pm
ON     sc.patient_id = pm.patient_id
LIMIT 20;
```

```sql
-- 9. Aggregate BY condition: how many active meds does the MOST-treated single patient have?
WITH single_condition_patients AS (
  SELECT pc.patient_id,
         MIN(pc.condition_code)    AS condition_code,
         MIN(pc.condition_display) AS condition_text
  FROM (
        SELECT c.subject.patientId AS patient_id,
               cc.code             AS condition_code,
               cc.display          AS condition_display
        FROM   `bigquery-public-data.fhir_synthea.condition`  c
        CROSS  JOIN UNNEST(c.code.coding) cc
        WHERE  c.subject.patientId IN (
                 SELECT DISTINCT p.id
                 FROM   `bigquery-public-data.fhir_synthea.patient` p
                 CROSS  JOIN UNNEST(p.name) n
                 WHERE  n.family LIKE 'A%'
               )
       ) pc
  GROUP BY pc.patient_id
  HAVING COUNT(*) = 1
),
patient_med_counts AS (
  SELECT mr.subject.patientId   AS patient_id,
         COUNT(DISTINCT mc.code) AS active_med_cnt
  FROM   `bigquery-public-data.fhir_synthea.medication_request` mr
  CROSS  JOIN UNNEST(mr.medication.codeableConcept.coding) mc
  WHERE  mr.status = 'active'
  GROUP  BY patient_id
)
SELECT sc.condition_code,
       sc.condition_text,
       MAX(pm.active_med_cnt) AS max_active_meds_for_any_patient
FROM   single_condition_patients sc
JOIN   patient_med_counts     pm
ON     sc.patient_id = pm.patient_id
GROUP BY sc.condition_code,
         sc.condition_text
ORDER BY max_active_meds_for_any_patient DESC
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER — eight conditions (code + text) with the highest number 
--     of different active medications prescribed to ANY single patient
WITH a_surname_patients AS (
  SELECT DISTINCT p.id AS patient_id
  FROM   `bigquery-public-data.fhir_synthea.patient` p
  CROSS  JOIN UNNEST(p.name) n
  WHERE  n.family LIKE 'A%'          -- last name begins with “A”
  AND    COALESCE(p.active, TRUE)    -- treat NULL as living/active
),
single_condition_patients AS (
  -- keep only patients with EXACTLY one distinct condition
  SELECT patient_id,
         MIN(condition_code)   AS condition_code,
         MIN(condition_display) AS condition_text
  FROM (
        SELECT c.subject.patientId AS patient_id,
               cc.code             AS condition_code,
               cc.display          AS condition_display
        FROM   `bigquery-public-data.fhir_synthea.condition`  c
        CROSS  JOIN UNNEST(c.code.coding) cc
        WHERE  c.subject.patientId IN (SELECT patient_id FROM a_surname_patients)
       )
  GROUP  BY patient_id
  HAVING COUNT(DISTINCT condition_code) = 1
),
patient_active_meds AS (
  SELECT mr.subject.patientId AS patient_id,
         mc.code              AS med_code
  FROM   `bigquery-public-data.fhir_synthea.medication_request` mr
  CROSS  JOIN UNNEST(mr.medication.codeableConcept.coding) mc
  WHERE  mr.status = 'active'
    AND  mr.subject.patientId IN (SELECT patient_id FROM single_condition_patients)
),
med_counts_per_patient AS (
  SELECT patient_id,
         COUNT(DISTINCT med_code) AS active_med_cnt
  FROM   patient_active_meds
  GROUP BY patient_id
)
SELECT sc.condition_code,
       sc.condition_text,
       MAX(mcpp.active_med_cnt) AS max_active_meds_for_any_patient
FROM   single_condition_patients  sc
JOIN   med_counts_per_patient   mcpp
ON     sc.patient_id = mcpp.patient_id
GROUP BY sc.condition_code,
         sc.condition_text
ORDER BY max_active_meds_for_any_patient DESC
LIMIT 8;
```
