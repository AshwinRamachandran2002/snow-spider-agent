```sql
-- Eight single-diagnosis conditions (code & text) whose “A-surname”, living
-- patients take the most different active medications
WITH a_patients AS (      -- living patients, surname starts with “A”
  SELECT DISTINCT p.id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient` AS p
  CROSS JOIN UNNEST(p.name) AS n
  WHERE n.family LIKE 'A%'            -- last name begins with A
    AND COALESCE(p.active, TRUE)      -- treat NULL as still living/active
),
patient_conditions AS (   -- every condition for those patients
  SELECT c.subject.patientId        AS patient_id,
         cc.code                    AS condition_code,
         cc.display                 AS condition_display
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  CROSS JOIN UNNEST(c.code.coding)  AS cc
  WHERE c.subject.patientId IN (SELECT patient_id FROM a_patients)
),
single_condition_patients AS (  -- keep only pts who have exactly one distinct condition
  SELECT patient_id,
         MIN(condition_code)    AS condition_code,
         MIN(condition_display) AS condition_display
  FROM patient_conditions
  GROUP BY patient_id
  HAVING COUNT(DISTINCT condition_code) = 1
),
patient_med_counts AS (   -- how many different active meds each such patient has
  SELECT mr.subject.patientId         AS patient_id,
         COUNT(DISTINCT mc.code)      AS active_med_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
  CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
  WHERE mr.status = 'active'
    AND mr.subject.patientId IN (SELECT patient_id FROM single_condition_patients)
  GROUP BY patient_id
),
condition_max_meds AS (   -- per condition, max #active meds taken by any single pt
  SELECT sc.condition_code,
         sc.condition_display,
         MAX(pmc.active_med_cnt) AS max_active_meds_for_any_patient
  FROM single_condition_patients AS sc
  JOIN patient_med_counts        AS pmc
    ON sc.patient_id = pmc.patient_id
  GROUP BY sc.condition_code, sc.condition_display
)
SELECT condition_code,
       condition_display,
       max_active_meds_for_any_patient
FROM condition_max_meds
ORDER BY max_active_meds_for_any_patient DESC
LIMIT 8;
