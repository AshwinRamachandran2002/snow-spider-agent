```sql
--Description:  Produce the eight conditions whose *single-condition*, living patients
--              (surname begins with “A”) have the largest number of DISTINCT active
--              medications taken by any one patient.  To avoid the “aggregation-of-
--              aggregations” error, we first deduplicate (patient, medication) pairs,
--              then COUNT(*) in a separate CTE; the outer query can safely take the
--              MAX() of those counts.

WITH a_surname_patients AS (                 -- 1) living patients with last name "A%"
  SELECT DISTINCT p.id AS patient_id
  FROM   `bigquery-public-data.fhir_synthea.patient` p
  CROSS  JOIN UNNEST(p.name) n
  WHERE  n.family LIKE 'A%'
    AND  COALESCE(p.active, TRUE)            -- treat NULL as living
),
single_condition_patients AS (               -- 2) keep only patients with exactly ONE condition
  SELECT patient_id,
         MIN(condition_code)    AS condition_code,
         MIN(condition_display) AS condition_text
  FROM (
        SELECT c.subject.patientId AS patient_id,
               cc.code             AS condition_code,
               cc.display          AS condition_display
        FROM   `bigquery-public-data.fhir_synthea.condition` c
        CROSS  JOIN UNNEST(c.code.coding) cc
        WHERE  c.subject.patientId IN (SELECT patient_id FROM a_surname_patients)
       )
  GROUP BY patient_id
  HAVING COUNT(DISTINCT condition_code) = 1
),
med_counts_per_patient AS (                  -- 3) DISTINCT active meds per patient
  SELECT patient_id,
         COUNT(*) AS active_med_cnt          -- simple COUNT after deduplication
  FROM (
        SELECT DISTINCT
               mr.subject.patientId AS patient_id,
               mc.code              AS med_code
        FROM   `bigquery-public-data.fhir_synthea.medication_request` mr
        CROSS  JOIN UNNEST(mr.medication.codeableConcept.coding) mc
        WHERE  mr.status = 'active'
          AND  mr.subject.patientId IN (SELECT patient_id FROM single_condition_patients)
       )
  GROUP BY patient_id
),
per_patient_cond AS (                        -- 4) join condition info with med counts
  SELECT sc.condition_code,
         sc.condition_text,
         mcpp.active_med_cnt
  FROM   single_condition_patients sc
  JOIN   med_counts_per_patient   mcpp
    ON   sc.patient_id = mcpp.patient_id
)
-- 5) per condition, take MAX meds any one patient is on, return top 8
SELECT condition_code,
       condition_text,
       MAX(active_med_cnt) AS max_active_meds_for_any_patient
FROM   per_patient_cond
GROUP BY condition_code, condition_text
ORDER BY max_active_meds_for_any_patient DESC
LIMIT 8;
```
