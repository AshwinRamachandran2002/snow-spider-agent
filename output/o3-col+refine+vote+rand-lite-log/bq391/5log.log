Query:
--Description: Active medication requests – return patient-id, RxNorm medication code and display text
--             for every prescription whose MedicationRequest.status = 'active'.  
--             (`UNNEST` is used to reach each coding element of the medication.)
SELECT mr.subject.patientId                      AS patient_id ,
       mc.code                                   AS med_code ,
       mc.display                                AS med_display
FROM   `bigquery-public-data.fhir_synthea.medication_request` AS mr
CROSS  JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
WHERE  mr.status = 'active'
LIMIT 20
Answer:
patient_id,med_code,med_display
