```sql
--Description: 1) List every music style that at least one customer has ranked
SELECT DISTINCT "StyleID"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
--Description: 2) Display the names of those ranked styles
SELECT DISTINCT ms."StyleID",
                ms."StyleName"
FROM "Musical_Styles"  AS ms
JOIN "Musical_Preferences" AS mp
  ON ms."StyleID" = mp."StyleID"
LIMIT 20;
```

```sql
--Description: 3) Check which preference positions (1-3) appear in the data
SELECT DISTINCT "PreferenceSeq"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
--Description: 4) Count how many times each style was chosen for every preference position
SELECT mp."StyleID",
       mp."PreferenceSeq",
       COUNT(*) AS "RankCount"
FROM   "Musical_Preferences" AS mp
GROUP  BY mp."StyleID",
          mp."PreferenceSeq"
ORDER  BY mp."StyleID",
          mp."PreferenceSeq"
LIMIT 20;
```

```sql
--Description: 5) Compute the weighted score for each style
SELECT mp."StyleID",
       SUM(CASE mp."PreferenceSeq"
               WHEN 1 THEN 3     -- 1st choice = 3 pts
               WHEN 2 THEN 2     -- 2nd choice = 2 pts
               WHEN 3 THEN 1     -- 3rd choice = 1 pt
               ELSE 0
           END) AS "WeightedScore"
FROM   "Musical_Preferences" AS mp
GROUP  BY mp."StyleID"
ORDER  BY "WeightedScore" DESC
LIMIT 20;
```

```sql
--Description: 6) Find the average weighted score across all ranked styles
WITH style_scores AS (
    SELECT mp."StyleID",
           SUM(CASE mp."PreferenceSeq"
                   WHEN 1 THEN 3
                   WHEN 2 THEN 2
                   WHEN 3 THEN 1
                   ELSE 0
               END) AS "WeightedScore"
    FROM   "Musical_Preferences" AS mp
    GROUP  BY mp."StyleID"
)
SELECT AVG("WeightedScore") AS "AvgWeightedScore"
FROM   style_scores
LIMIT 20;
```

```sql
--Description: 7) Final result – weighted score for each style and its absolute difference from the average
WITH style_scores AS (
    SELECT mp."StyleID",
           SUM(CASE mp."PreferenceSeq"
                   WHEN 1 THEN 3
                   WHEN 2 THEN 2
                   WHEN 3 THEN 1
                   ELSE 0
               END) AS "WeightedScore"
    FROM   "Musical_Preferences" AS mp
    GROUP  BY mp."StyleID"
),
avg_score AS (
    SELECT AVG("WeightedScore") AS "AvgScore"
    FROM   style_scores
)
SELECT ss."StyleID",
       ms."StyleName",
       ss."WeightedScore",
       ABS(ss."WeightedScore" - a."AvgScore") AS "AbsDiffFromAvg"
FROM   style_scores AS ss
JOIN   avg_score    AS a   ON 1=1
LEFT JOIN "Musical_Styles" AS ms ON ms."StyleID" = ss."StyleID"
ORDER BY ss."WeightedScore" DESC
LIMIT 20;
```
