Query:
-- 5. Description: Compute a weighted score for every style using the 3-2-1 scheme  
SELECT "StyleID",
       SUM(
           CASE "PreferenceSeq"
                WHEN 1 THEN 3
                WHEN 2 THEN 2
                WHEN 3 THEN 1
           END
       ) AS "WeightedScore"
FROM "Musical_Preferences"
GROUP BY "StyleID"
ORDER BY "WeightedScore" DESC
LIMIT 20;
