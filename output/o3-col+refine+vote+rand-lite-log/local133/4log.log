Query:
--Description: Re-compute each style’s 3-2-1 weighted score, calculate the overall average, 
--and show (StyleID, score, absolute difference from that average) for every style, ordered
--by largest difference first.  Using CROSS JOIN clarifies that AvgScore is a single-row
--result and avoids any implicit join ambiguity.
WITH Scores AS (
    SELECT "StyleID",
           SUM(CASE "PreferenceSeq"
                   WHEN 1 THEN 3
                   WHEN 2 THEN 2
                   WHEN 3 THEN 1
               END) AS "WeightedScore"
    FROM "Musical_Preferences"
    GROUP BY "StyleID"
),
AvgScore AS (
    SELECT AVG("WeightedScore") AS "AvgWeightedScore"
    FROM Scores
)
SELECT s."StyleID",
       s."WeightedScore",
       ABS(s."WeightedScore" - a."AvgWeightedScore") AS "AbsDifference"
FROM Scores  AS s
CROSS JOIN AvgScore AS a
ORDER BY "AbsDifference" DESC
LIMIT 20
