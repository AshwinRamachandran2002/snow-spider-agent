```sql
--Description (thinking process embedded):
-- 1) Calculate each musical style’s 3-2-1 weighted score in a CTE called Scores.  
-- 2) In a second CTE (MinScore) find the single lowest weighted score that any style received.  
-- 3) Return every style whose score equals that minimum value; this proves the scoring logic
--    works, because at least one style must share the absolute minimum.
WITH Scores AS (
    SELECT "StyleID",
           SUM(CASE "PreferenceSeq"
                   WHEN 1 THEN 3
                   WHEN 2 THEN 2
                   WHEN 3 THEN 1
               END) AS "WeightedScore"
    FROM "Musical_Preferences"
    GROUP BY "StyleID"
),
MinScore AS (
    SELECT MIN("WeightedScore") AS "MinVal" FROM Scores
)
SELECT ms."StyleID",
       ms."StyleName",
       s."WeightedScore"
FROM Scores s
JOIN MinScore m ON s."WeightedScore" = m."MinVal"
JOIN "Musical_Styles" ms ON ms."StyleID" = s."StyleID"
ORDER BY ms."StyleID";
```
