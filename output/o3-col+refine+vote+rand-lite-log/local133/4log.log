Query:
--Description: FINAL ANSWER – list every ranked musical style with its name, total 3-2-1
--weighted score, and absolute difference from the overall average.  A CROSS JOIN is used
--for the single-row AvgScore CTE, followed by an INNER JOIN to obtain the readable
--style name.
WITH Scores AS (
    SELECT "StyleID",
           SUM(CASE "PreferenceSeq"
                   WHEN 1 THEN 3
                   WHEN 2 THEN 2
                   WHEN 3 THEN 1
               END) AS "WeightedScore"
    FROM "Musical_Preferences"
    GROUP BY "StyleID"
),
AvgScore AS (
    SELECT AVG("WeightedScore") AS "AvgWeightedScore"
    FROM Scores
)
SELECT ms."StyleID",
       ms."StyleName",
       s."WeightedScore",
       ABS(s."WeightedScore" - a."AvgWeightedScore") AS "AbsDifferenceFromAvg"
FROM Scores      AS s
CROSS JOIN AvgScore AS a
JOIN "Musical_Styles" ms ON ms."StyleID" = s."StyleID"
ORDER BY ms."StyleID"
