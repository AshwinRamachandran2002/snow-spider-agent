Query:
-- 7. Description: Attach the human-readable style name to each weighted score  
WITH Scores AS (
    SELECT "StyleID",
           SUM(
               CASE "PreferenceSeq"
                    WHEN 1 THEN 3
                    WHEN 2 THEN 2
                    WHEN 3 THEN 1
               END
           ) AS "WeightedScore"
    FROM "Musical_Preferences"
    GROUP BY "StyleID"
)
SELECT ms."StyleID",
       ms."StyleName",
       s."WeightedScore"
FROM Scores s
JOIN "Musical_Styles" ms
  ON ms."StyleID" = s."StyleID"
ORDER BY s."WeightedScore" DESC
LIMIT 20;
