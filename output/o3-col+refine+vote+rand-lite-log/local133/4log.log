```sql
-- 1. Description: Look at a sample of customer musical‐style preferences to understand the data we’ll be scoring  
SELECT DISTINCT "CustomerID", "StyleID", "PreferenceSeq"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
-- 2. Description: List every distinct ranking (PreferenceSeq) that appears in the table  
SELECT DISTINCT "PreferenceSeq"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
-- 3. Description: See how many total rankings each style received (any rank)  
SELECT "StyleID", COUNT(*) AS "TotalRankings"
FROM "Musical_Preferences"
GROUP BY "StyleID"
ORDER BY "TotalRankings" DESC
LIMIT 20;
```

```sql
-- 4. Description: Count how many first-place votes (PreferenceSeq = 1) each style received  
SELECT "StyleID", COUNT(*) AS "FirstChoiceCount"
FROM "Musical_Preferences"
WHERE "PreferenceSeq" = 1
GROUP BY "StyleID"
ORDER BY "FirstChoiceCount" DESC
LIMIT 20;
```

```sql
-- 5. Description: Compute a weighted score for every style using the 3-2-1 scheme  
SELECT "StyleID",
       SUM(
           CASE "PreferenceSeq"
                WHEN 1 THEN 3
                WHEN 2 THEN 2
                WHEN 3 THEN 1
           END
       ) AS "WeightedScore"
FROM "Musical_Preferences"
GROUP BY "StyleID"
ORDER BY "WeightedScore" DESC
LIMIT 20;
```

```sql
-- 6. Description: Determine the average weighted score across all styles that received at least one vote  
WITH Scores AS (
    SELECT "StyleID",
           SUM(
               CASE "PreferenceSeq"
                    WHEN 1 THEN 3
                    WHEN 2 THEN 2
                    WHEN 3 THEN 1
               END
           ) AS "WeightedScore"
    FROM "Musical_Preferences"
    GROUP BY "StyleID"
)
SELECT AVG("WeightedScore") AS "AverageWeightedScore"
FROM Scores
LIMIT 20;
```

```sql
-- 7. Description: Attach the human-readable style name to each weighted score  
WITH Scores AS (
    SELECT "StyleID",
           SUM(
               CASE "PreferenceSeq"
                    WHEN 1 THEN 3
                    WHEN 2 THEN 2
                    WHEN 3 THEN 1
               END
           ) AS "WeightedScore"
    FROM "Musical_Preferences"
    GROUP BY "StyleID"
)
SELECT ms."StyleID",
       ms."StyleName",
       s."WeightedScore"
FROM Scores s
JOIN "Musical_Styles" ms
  ON ms."StyleID" = s."StyleID"
ORDER BY s."WeightedScore" DESC
LIMIT 20;
```

```sql
-- 8. Description: Verify there are no styles with zero weighted score (should be none after GROUP BY)  
WITH Scores AS (
    SELECT "StyleID",
           SUM(
               CASE "PreferenceSeq"
                    WHEN 1 THEN 3
                    WHEN 2 THEN 2
                    WHEN 3 THEN 1
               END
           ) AS "WeightedScore"
    FROM "Musical_Preferences"
    GROUP BY "StyleID"
)
SELECT DISTINCT "StyleID"
FROM Scores
WHERE "WeightedScore" = 0
LIMIT 20;
```

```sql
-- 9. Description: Compute absolute difference between each style’s score and the overall average  
WITH Scores AS (
    SELECT "StyleID",
           SUM(
               CASE "PreferenceSeq"
                    WHEN 1 THEN 3
                    WHEN 2 THEN 2
                    WHEN 3 THEN 1
               END
           ) AS "WeightedScore"
    FROM "Musical_Preferences"
    GROUP BY "StyleID"
),
AvgScore AS (
    SELECT AVG("WeightedScore") AS "AvgWeightedScore" FROM Scores
)
SELECT s."StyleID",
       s."WeightedScore",
       ABS(s."WeightedScore" - a."AvgWeightedScore") AS "AbsDifference"
FROM Scores s, AvgScore a
ORDER BY "AbsDifference" DESC
LIMIT 20;
```

```sql
-- 10. Description: FINAL ANSWER – style name, total weighted score, and absolute difference from the average for every ranked style  
WITH Scores AS (
    SELECT "StyleID",
           SUM(
               CASE "PreferenceSeq"
                    WHEN 1 THEN 3
                    WHEN 2 THEN 2
                    WHEN 3 THEN 1
               END
           ) AS "WeightedScore"
    FROM "Musical_Preferences"
    GROUP BY "StyleID"
),
AvgScore AS (
    SELECT AVG("WeightedScore") AS "AvgWeightedScore" FROM Scores
)
SELECT ms."StyleID",
       ms."StyleName",
       s."WeightedScore",
       ABS(s."WeightedScore" - a."AvgWeightedScore") AS "AbsDifferenceFromAvg"
FROM Scores s
JOIN AvgScore a
JOIN "Musical_Styles" ms
  ON ms."StyleID" = s."StyleID"
ORDER BY ms."StyleID"
LIMIT 20;
```
