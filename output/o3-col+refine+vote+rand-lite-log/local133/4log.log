Query:
-- 6. Description: Determine the average weighted score across all styles that received at least one vote  
WITH Scores AS (
    SELECT "StyleID",
           SUM(
               CASE "PreferenceSeq"
                    WHEN 1 THEN 3
                    WHEN 2 THEN 2
                    WHEN 3 THEN 1
               END
           ) AS "WeightedScore"
    FROM "Musical_Preferences"
    GROUP BY "StyleID"
)
SELECT AVG("WeightedScore") AS "AverageWeightedScore"
FROM Scores
LIMIT 20;
Answer:
