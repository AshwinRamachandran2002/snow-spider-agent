-- 10. FINAL ANSWER: each style’s total weighted score and its absolute deviation from the overall average
SELECT DISTINCT ms."StyleID",
                ms."StyleName",
                totals."TotalWeightedScore",
                ABS(totals."TotalWeightedScore" - avg_scores."AvgWeightedScore") AS "DifferenceToAvg"
FROM (
       SELECT "StyleID",
              SUM(CASE "PreferenceSeq"
                      WHEN 1 THEN 3
                      WHEN 2 THEN 2
                      WHEN 3 THEN 1
                  END) AS "TotalWeightedScore"
       FROM   "Musical_Preferences"
       GROUP  BY "StyleID"
     ) totals
JOIN  "Musical_Styles" ms  ON totals."StyleID" = ms."StyleID"
CROSS JOIN (
       SELECT AVG("TotalWeightedScore") AS "AvgWeightedScore"
       FROM (
             SELECT "StyleID",
                    SUM(CASE "PreferenceSeq"
                            WHEN 1 THEN 3
                            WHEN 2 THEN 2
                            WHEN 3 THEN 1
                        END) AS "TotalWeightedScore"
             FROM   "Musical_Preferences"
             GROUP  BY "StyleID"
            )
     ) avg_scores
ORDER BY "DifferenceToAvg" DESC
LIMIT 20;
