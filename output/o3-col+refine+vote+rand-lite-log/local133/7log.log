```sql
-- 1. Inspect distinct style IDs together with their ranking positions in Musical_Preferences
SELECT DISTINCT "StyleID",
                "PreferenceSeq"
FROM   "Musical_Preferences"
LIMIT 20;
```

```sql
-- 2. Verify style IDs against their names
SELECT DISTINCT mp."StyleID",
                ms."StyleName"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms ON mp."StyleID" = ms."StyleID"
LIMIT 20;
```

```sql
-- 3. Show the weight that each individual ranking contributes (3/2/1 points)
SELECT DISTINCT mp."CustomerID",
                mp."StyleID",
                CASE mp."PreferenceSeq"
                     WHEN 1 THEN 3
                     WHEN 2 THEN 2
                     WHEN 3 THEN 1
                END AS "WeightedScore"
FROM   "Musical_Preferences" AS mp
LIMIT 20;
```

```sql
-- 4. Count how often each rank (1st, 2nd, 3rd) appears
SELECT DISTINCT "PreferenceSeq",
                COUNT(*) AS "CountRanked"
FROM   "Musical_Preferences"
GROUP  BY "PreferenceSeq"
LIMIT 20;
```

```sql
-- 5. How many total rankings each style received (regardless of weight)
SELECT DISTINCT "StyleID",
                COUNT(*) AS "TimesRanked"
FROM   "Musical_Preferences"
GROUP  BY "StyleID"
LIMIT 20;
```

```sql
-- 6. Total weighted score accumulated by every style
SELECT DISTINCT "StyleID",
                SUM(CASE "PreferenceSeq"
                        WHEN 1 THEN 3
                        WHEN 2 THEN 2
                        WHEN 3 THEN 1
                    END) AS "TotalWeightedScore"
FROM   "Musical_Preferences"
GROUP  BY "StyleID"
LIMIT 20;
```

```sql
-- 7. Average of those total weighted scores across all styles that were ranked
SELECT AVG("TotalWeightedScore") AS "AvgWeightedScore"
FROM (
      SELECT "StyleID",
             SUM(CASE "PreferenceSeq"
                     WHEN 1 THEN 3
                     WHEN 2 THEN 2
                     WHEN 3 THEN 1
                 END) AS "TotalWeightedScore"
      FROM   "Musical_Preferences"
      GROUP  BY "StyleID"
     );
```

```sql
-- 8. List only the styles that actually appear in Musical_Preferences
SELECT DISTINCT ms."StyleID",
                ms."StyleName"
FROM   "Musical_Styles" ms
WHERE  ms."StyleID" IN (SELECT DISTINCT "StyleID" FROM "Musical_Preferences")
LIMIT 20;
```

```sql
-- 9. Combine total weighted score with style names (no average yet)
SELECT DISTINCT ms."StyleID",
                ms."StyleName",
                totals."TotalWeightedScore"
FROM  (
       SELECT "StyleID",
              SUM(CASE "PreferenceSeq"
                      WHEN 1 THEN 3
                      WHEN 2 THEN 2
                      WHEN 3 THEN 1
                  END) AS "TotalWeightedScore"
       FROM   "Musical_Preferences"
       GROUP  BY "StyleID"
      ) totals
JOIN  "Musical_Styles" ms ON totals."StyleID" = ms."StyleID"
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: each style’s total weighted score and its absolute deviation from the overall average
SELECT DISTINCT ms."StyleID",
                ms."StyleName",
                totals."TotalWeightedScore",
                ABS(totals."TotalWeightedScore" - avg_scores."AvgWeightedScore") AS "DifferenceToAvg"
FROM (
       SELECT "StyleID",
              SUM(CASE "PreferenceSeq"
                      WHEN 1 THEN 3
                      WHEN 2 THEN 2
                      WHEN 3 THEN 1
                  END) AS "TotalWeightedScore"
       FROM   "Musical_Preferences"
       GROUP  BY "StyleID"
     ) totals
JOIN  "Musical_Styles" ms  ON totals."StyleID" = ms."StyleID"
CROSS JOIN (
       SELECT AVG("TotalWeightedScore") AS "AvgWeightedScore"
       FROM (
             SELECT "StyleID",
                    SUM(CASE "PreferenceSeq"
                            WHEN 1 THEN 3
                            WHEN 2 THEN 2
                            WHEN 3 THEN 1
                        END) AS "TotalWeightedScore"
             FROM   "Musical_Preferences"
             GROUP  BY "StyleID"
            )
     ) avg_scores
ORDER BY "DifferenceToAvg" DESC
LIMIT 20;
```
