```sql
--Description: Inspect customers’ musical-preference rankings.
SELECT "CustomerID", "StyleID", "PreferenceSeq"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
--Description: Check the distinct ranking positions that actually appear.
SELECT DISTINCT "PreferenceSeq"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
--Description: Count how many times each style was chosen for every ranking level.
SELECT "StyleID",
       SUM(CASE WHEN "PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS FirstChoiceCount,
       SUM(CASE WHEN "PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS SecondChoiceCount,
       SUM(CASE WHEN "PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS ThirdChoiceCount
FROM "Musical_Preferences"
GROUP BY "StyleID"
LIMIT 20;
```

```sql
--Description: Compute the 3–2–1 weighted score for every musical style.
SELECT mp."StyleID",
       3 * SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) +
       2 * SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) +
       1 * SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS TotalWeightedScore
FROM "Musical_Preferences" AS mp
GROUP BY mp."StyleID"
LIMIT 20;
```

```sql
--Description: Calculate the average of the total weighted scores across all ranked styles.
SELECT AVG(TotalWeightedScore) AS AvgTotalWeightedScore
FROM (
    SELECT 3 * SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) +
           2 * SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) +
           1 * SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS TotalWeightedScore
    FROM "Musical_Preferences" AS mp
    GROUP BY mp."StyleID"
) AS scores;
```

```sql
--Description: Final report – total score for each style, overall average, and absolute difference.
SELECT ms."StyleID",
       ms."StyleName",
       s."TotalWeightedScore",
       avg_scores."AvgTotalWeightedScore",
       ABS(s."TotalWeightedScore" - avg_scores."AvgTotalWeightedScore") AS ScoreDifference
FROM (
    SELECT mp."StyleID",
           3 * SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) +
           2 * SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) +
           1 * SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS TotalWeightedScore
    FROM "Musical_Preferences" AS mp
    GROUP BY mp."StyleID"
) AS s
JOIN "Musical_Styles" AS ms
  ON ms."StyleID" = s."StyleID"
CROSS JOIN (
    SELECT AVG(TotalWeightedScore) AS AvgTotalWeightedScore
    FROM (
        SELECT 3 * SUM(CASE WHEN mp2."PreferenceSeq" = 1 THEN 1 ELSE 0 END) +
               2 * SUM(CASE WHEN mp2."PreferenceSeq" = 2 THEN 1 ELSE 0 END) +
               1 * SUM(CASE WHEN mp2."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS TotalWeightedScore
        FROM "Musical_Preferences" AS mp2
        GROUP BY mp2."StyleID"
    )
) AS avg_scores
ORDER BY ScoreDifference DESC, ms."StyleName"
LIMIT 20;
```
