Query:
--Description: Compute the weighted score (3/2/1 points) for each style
SELECT mp."StyleID",
       SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 3
                WHEN mp."PreferenceSeq" = 2 THEN 2
                WHEN mp."PreferenceSeq" = 3 THEN 1
           END) AS "TotalScore"
FROM "Musical_Preferences" AS mp
GROUP BY mp."StyleID"
LIMIT 20;
