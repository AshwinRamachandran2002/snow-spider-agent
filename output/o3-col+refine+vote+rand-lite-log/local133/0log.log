```sql
--Description: List all different musical styles that have ever been ranked by any user
SELECT DISTINCT "StyleID"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
--Description: Check the different ranking positions that appear (1-first, 2-second, 3-third)
SELECT DISTINCT "PreferenceSeq"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
--Description: Look at some raw preference rows together with the style names
SELECT mp."CustomerID",
       mp."StyleID",
       ms."StyleName",
       mp."PreferenceSeq"
FROM "Musical_Preferences" AS mp
JOIN "Musical_Styles"  AS ms
  ON mp."StyleID" = ms."StyleID"
LIMIT 20;
```

```sql
--Description: Count how many times every style was chosen in each ranking position
SELECT mp."StyleID",
       mp."PreferenceSeq",
       COUNT(*) AS "RankCount"
FROM "Musical_Preferences" AS mp
GROUP BY mp."StyleID", mp."PreferenceSeq"
LIMIT 20;
```

```sql
--Description: Compute the weighted score (3/2/1 points) for each style
SELECT mp."StyleID",
       SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 3
                WHEN mp."PreferenceSeq" = 2 THEN 2
                WHEN mp."PreferenceSeq" = 3 THEN 1
           END) AS "TotalScore"
FROM "Musical_Preferences" AS mp
GROUP BY mp."StyleID"
LIMIT 20;
```

```sql
--Description: Show the weighted scores together with the style names, highest scores first
SELECT ms."StyleName",
       ws."TotalScore"
FROM (
     SELECT mp."StyleID",
            SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 3
                     WHEN mp."PreferenceSeq" = 2 THEN 2
                     WHEN mp."PreferenceSeq" = 3 THEN 1
                END) AS "TotalScore"
     FROM "Musical_Preferences" AS mp
     GROUP BY mp."StyleID"
) AS ws
JOIN "Musical_Styles" AS ms
  ON ws."StyleID" = ms."StyleID"
ORDER BY ws."TotalScore" DESC
LIMIT 20;
```

```sql
--Description: Work out the average total weighted score across every ranked style
SELECT AVG(ws."TotalScore") AS "AvgScore"
FROM (
     SELECT mp."StyleID",
            SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 3
                     WHEN mp."PreferenceSeq" = 2 THEN 2
                     WHEN mp."PreferenceSeq" = 3 THEN 1
                END) AS "TotalScore"
     FROM "Musical_Preferences" AS mp
     GROUP BY mp."StyleID"
) AS ws
LIMIT 20;
```

```sql
--Description: Final result – absolute difference between each style’s score and the overall average
SELECT ms."StyleName",
       ws."TotalScore",
       ABS(ws."TotalScore" - avg_tbl."AvgScore") AS "ScoreDiff"
FROM (
     SELECT mp."StyleID",
            SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 3
                     WHEN mp."PreferenceSeq" = 2 THEN 2
                     WHEN mp."PreferenceSeq" = 3 THEN 1
                END) AS "TotalScore"
     FROM "Musical_Preferences" AS mp
     GROUP BY mp."StyleID"
) AS ws
JOIN (
     SELECT AVG(inner_ws."TotalScore") AS "AvgScore"
     FROM (
          SELECT mp2."StyleID",
                 SUM(CASE WHEN mp2."PreferenceSeq" = 1 THEN 3
                          WHEN mp2."PreferenceSeq" = 2 THEN 2
                          WHEN mp2."PreferenceSeq" = 3 THEN 1
                     END) AS "TotalScore"
          FROM "Musical_Preferences" AS mp2
          GROUP BY mp2."StyleID"
     ) AS inner_ws
) AS avg_tbl
JOIN "Musical_Styles" AS ms  ON ws."StyleID" = ms."StyleID"
ORDER BY "ScoreDiff" DESC
LIMIT 20;
```

```sql
--Description: Show only the two styles whose scores are furthest from the average (for a quick glance)
SELECT ms."StyleName",
       ABS(ws."TotalScore" - avg_tbl."AvgScore") AS "ScoreDiff"
FROM (
     SELECT mp."StyleID",
            SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 3
                     WHEN mp."PreferenceSeq" = 2 THEN 2
                     WHEN mp."PreferenceSeq" = 3 THEN 1
                END) AS "TotalScore"
     FROM "Musical_Preferences" AS mp
     GROUP BY mp."StyleID"
) AS ws
JOIN (
     SELECT AVG(inner_ws."TotalScore") AS "AvgScore"
     FROM (
          SELECT mp2."StyleID",
                 SUM(CASE WHEN mp2."PreferenceSeq" = 1 THEN 3
                          WHEN mp2."PreferenceSeq" = 2 THEN 2
                          WHEN mp2."PreferenceSeq" = 3 THEN 1
                     END) AS "TotalScore"
          FROM "Musical_Preferences" AS mp2
          GROUP BY mp2."StyleID"
     ) AS inner_ws
) AS avg_tbl
JOIN "Musical_Styles" AS ms  ON ws."StyleID" = ms."StyleID"
ORDER BY "ScoreDiff" DESC
LIMIT 2;
```
