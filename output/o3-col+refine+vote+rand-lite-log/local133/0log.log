Query:
--Description: Show the weighted scores together with the style names, highest scores first
SELECT ms."StyleName",
       ws."TotalScore"
FROM (
     SELECT mp."StyleID",
            SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 3
                     WHEN mp."PreferenceSeq" = 2 THEN 2
                     WHEN mp."PreferenceSeq" = 3 THEN 1
                END) AS "TotalScore"
     FROM "Musical_Preferences" AS mp
     GROUP BY mp."StyleID"
) AS ws
JOIN "Musical_Styles" AS ms
  ON ws."StyleID" = ms."StyleID"
ORDER BY ws."TotalScore" DESC
LIMIT 20;
