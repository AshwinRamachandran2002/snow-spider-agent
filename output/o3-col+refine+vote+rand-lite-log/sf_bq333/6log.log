```sql
--Description / Thinking process:
-- We need the three browsers with the shortest average session duration, 
-- but only if each browser owns more than 10 total sessions.
--
-- 1) At the innermost level (“sessions” CTE) we compute the length of every
--    individual session (identified by session_id) per browser:
--       session_seconds = (MAX(created_at) - MIN(created_at)) / 1,000,000
--    because created_at is stored in micro-seconds.
--
-- 2) In the next level (“browser_avgs” CTE) we aggregate those session lengths
--    by browser to obtain:
--       • avg_session_seconds  – average of all session lengths for that browser
--       • session_cnt          – number of sessions for that browser
--
-- 3) Finally, we keep only browsers whose session_cnt > 10, sort by the
--    smallest avg_session_seconds, and return the top-3.
WITH sessions AS (
    SELECT  "browser",
            ( MAX("created_at") - MIN("created_at") ) / 1000000 AS "session_seconds"
    FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP   BY "browser", "session_id"
),
browser_avgs AS (
    SELECT  "browser",
            AVG("session_seconds") AS "avg_session_seconds",
            COUNT(*)              AS "session_cnt"
    FROM    sessions
    GROUP   BY "browser"
    HAVING  COUNT(*) > 10          -- keep browsers with > 10 sessions
)
SELECT  "browser",
        "avg_session_seconds",
        "session_cnt"
FROM    browser_avgs
ORDER BY "avg_session_seconds" ASC
LIMIT 3;
```
