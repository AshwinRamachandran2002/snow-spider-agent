       "browser",
       (MAX("created_at") - MIN("created_at"))/1000000 AS "session_seconds"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
GROUP BY "session_id", "browser"
LIMIT 20;
```

```sql
--Description: 5) Compute each browser’s average session duration (all sessions included)  
SELECT "browser",
       AVG((MAX("created_at") - MIN("created_at"))/1000000) AS "avg_session_seconds",
       COUNT(DISTINCT "session_id")                     AS "session_cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
GROUP BY "browser"
ORDER BY "avg_session_seconds" ASC
LIMIT 20;
```

```sql
--Description: 6) Same as #5 but keep only browsers with > 10 sessions, show the three with the shortest averages  
SELECT "browser",
       AVG((MAX("created_at") - MIN("created_at"))/1000000) AS "avg_session_seconds",
       COUNT(DISTINCT "session_id")                         AS "session_cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
GROUP BY "browser"
HAVING COUNT(DISTINCT "session_id") > 10
ORDER BY "avg_session_seconds" ASC
LIMIT 3;
```

```sql
