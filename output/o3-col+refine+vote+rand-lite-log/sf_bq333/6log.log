Query:
--Description: 6)  Re-run the “shortest-average” query in a simpler form: 
--               (a) first derive every session’s length, 
--               (b) then keep only browsers with >10 sessions and list the 3 shortest.
WITH sessions AS (
    SELECT  "browser",
            ( MAX("created_at") - MIN("created_at") ) / 1000000 AS "session_seconds"
    FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP   BY "browser", "session_id"
)
SELECT  "browser",
        AVG("session_seconds") AS "avg_session_seconds",
        COUNT(*)              AS "session_cnt"
FROM    sessions
GROUP BY "browser"
HAVING  COUNT(*) > 10
ORDER BY "avg_session_seconds" ASC
LIMIT 3
