Query:
--Description: 10)  Build a quick “histogram” (per-minute buckets) of session lengths
--                 for the 3 browsers with the shortest average durations.
WITH sessions AS (
    SELECT  "browser",
            ( MAX("created_at") - MIN("created_at") ) / 1000000 AS "session_seconds"
    FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP   BY "browser", "session_id"
),
top3 AS (
    SELECT  "browser"
    FROM    sessions
    GROUP   BY "browser"
    HAVING  COUNT(*) > 10
    ORDER   BY AVG("session_seconds") ASC
    LIMIT 3
)
SELECT  s."browser",
        FLOOR( s."session_seconds" / 60 ) AS "minutes_bucket",
        COUNT(*)                          AS "sessions_in_bucket"
FROM    sessions s
JOIN    top3      t ON s."browser" = t."browser"
GROUP   BY s."browser", FLOOR( s."session_seconds" / 60 )
ORDER   BY s."browser", "minutes_bucket"
LIMIT 20
