-- Description: 8)  Show the three browsers that actually have the shortest average durations (again requiring >10 sessions)
WITH session_durations AS (
    SELECT "session_id",
           "browser",
           (MAX("created_at") - MIN("created_at"))/1000000 AS "duration_seconds"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP BY "browser", "session_id"
), browser_avgs AS (
    SELECT "browser",
           AVG("duration_seconds") AS "avg_session_seconds",
           COUNT(*)                AS "num_sessions"
    FROM session_durations
    GROUP BY "browser"
    HAVING COUNT(*) > 10
)
SELECT "browser",
