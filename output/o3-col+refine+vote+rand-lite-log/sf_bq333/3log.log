2025-05-05 02:43:00 - Thread-1292 (execute) - INFO - [Exploration]
```sql
-- Description: 1)  Look at the different browsers captured in the EVENTS table
SELECT DISTINCT "browser"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
LIMIT 20;
```

```sql
-- Description: 2)  Pull a small sample of EVENTS records just to see the time-stamp column (“created_at”), the session identifier and the browser together
SELECT "session_id",
       "browser",
       "created_at",
       "event_type"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
LIMIT 20;
```

```sql
-- Description: 3)  Count how many sessions each browser has (raw count of distinct session_id per browser)
SELECT "browser",
       COUNT(DISTINCT "session_id") AS "num_sessions"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
GROUP BY "browser"
ORDER BY "num_sessions" DESC
LIMIT 20;
```

```sql
-- Description: 4)  Pick one browser (e.g., 'Chrome') and look at one complete session to understand the spread of time-stamps
SELECT "session_id",
       MIN("created_at") AS "session_start",
       MAX("created_at") AS "session_end",
       (MAX("created_at") - MIN("created_at"))/1000000 AS "duration_seconds"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
WHERE "browser" = 'Chrome'
GROUP BY "session_id"
ORDER BY "duration_seconds" DESC
LIMIT 20;
```

```sql
-- Description: 5)  Create session-level durations for every browser (no browser filter) so that we can later aggregate
SELECT "session_id",
       "browser",
       (MAX("created_at") - MIN("created_at"))/1000000 AS "duration_seconds"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
GROUP BY "browser", "session_id"
LIMIT 20;
```

```sql
-- Description: 6)  Compute the average session duration for each browser (including ALL browsers, regardless of count)
WITH session_durations AS (
    SELECT "session_id",
           "browser",
           (MAX("created_at") - MIN("created_at"))/1000000 AS "duration_seconds"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP BY "browser", "session_id"
)
SELECT "browser",
       AVG("duration_seconds") AS "avg_session_seconds",
       COUNT(*)                AS "num_sessions"
FROM session_durations
GROUP BY "browser"
ORDER BY "avg_session_seconds" ASC
LIMIT 20;
```

```sql
-- Description: 7)  Restrict to browsers that have > 10 sessions, then rank by the shortest average duration
WITH session_durations AS (
    SELECT "session_id",
           "browser",
           (MAX("created_at") - MIN("created_at"))/1000000 AS "duration_seconds"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP BY "browser", "session_id"
), browser_avgs AS (
    SELECT "browser",
           AVG("duration_seconds") AS "avg_session_seconds",
           COUNT(*)                AS "num_sessions"
    FROM session_durations
    GROUP BY "browser"
    HAVING COUNT(*) > 10
)
SELECT "browser",
       "avg_session_seconds",
       "num_sessions"
FROM browser_avgs
ORDER BY "avg_session_seconds" ASC
LIMIT 10;
```

```sql
-- Description: 8)  Show the three browsers that actually have the shortest average durations (again requiring >10 sessions)
WITH session_durations AS (
    SELECT "session_id",
           "browser",
           (MAX("created_at") - MIN("created_at"))/1000000 AS "duration_seconds"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP BY "browser", "session_id"
), browser_avgs AS (
    SELECT "browser",
           AVG("duration_seconds") AS "avg_session_seconds",
           COUNT(*)                AS "num_sessions"
    FROM session_durations
    GROUP BY "browser"
    HAVING COUNT(*) > 10
)
SELECT "browser",
       "avg_session_seconds",
       "num_sessions"
FROM browser_avgs
ORDER BY "avg_session_seconds" ASC
LIMIT 3;
```

```sql
-- Description: 9)  (Optional)  Inspect one of those three browsers’ session durations in more detail
WITH session_durations AS (
    SELECT "session_id",
           "browser",
           (MAX("created_at") - MIN("created_at"))/1000000 AS "duration_seconds"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP BY "browser", "session_id"
)
SELECT *
FROM session_durations
WHERE "browser" ILIKE '%Safari%'          -- replace with one of the winners
ORDER BY "duration_seconds" ASC
LIMIT 20;
```

```sql
-- Description: 10) Final verification – double-check that the top-3 shortest browsers are correct by ordering the full list
WITH session_durations AS (
    SELECT "session_id",
           "browser",
           (MAX("created_at") - MIN("created_at"))/1000000 AS "duration_seconds"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP BY "browser", "session_id"
), browser_avgs AS (
    SELECT "browser",
           AVG("duration_seconds") AS "avg_session_seconds",
           COUNT(*)                AS "num_sessions"
    FROM session_durations
    GROUP BY "browser"
    HAVING COUNT(*) > 10
)
SELECT *
FROM browser_avgs
ORDER BY "avg_session_seconds" ASC
LIMIT 20;
```
