```sql
--Description: List all distinct browsers captured in the EVENTS table (first glance at the values we will be working with)
SELECT DISTINCT "browser"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
LIMIT 20;
```

```sql
--Description: Quick-check how many individual events exist for each browser
SELECT "browser",
       COUNT(*) AS "events_per_browser"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
GROUP BY "browser"
ORDER BY "events_per_browser" DESC
LIMIT 20;
```

```sql
--Description: Peek at the pairing of browser and session_id (shows what a “session” looks like)
SELECT "browser",
       "session_id",
       "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
ORDER BY "browser", "session_id"
LIMIT 20;
```

```sql
--Description: Count the number of unique session_id values per browser (needed to know which have >10 sessions)
SELECT "browser",
       COUNT(DISTINCT "session_id") AS "session_count"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
GROUP BY "browser"
ORDER BY "session_count" DESC
LIMIT 20;
```

```sql
--Description: Compute per-session start & end times (μs) and raw duration (μs) for a small sample to check logic
SELECT "browser",
       "session_id",
       MIN("created_at") AS "session_start",
       MAX("created_at") AS "session_end",
       (MAX("created_at") - MIN("created_at")) AS "duration_microseconds"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
GROUP BY "browser", "session_id"
ORDER BY "duration_microseconds" DESC
LIMIT 20;
```

```sql
--Description: Convert the per-session duration to seconds for the same small sample
SELECT "browser",
       "session_id",
       (MAX("created_at") - MIN("created_at")) / 1000000.0 AS "duration_seconds"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
GROUP BY "browser", "session_id"
ORDER BY "duration_seconds" DESC
LIMIT 20;
```

```sql
--Description: Average session duration (seconds) for every browser regardless of session count
WITH session_durations AS (
    SELECT "browser",
           "session_id",
           (MAX("created_at") - MIN("created_at")) / 1000000.0 AS "duration_seconds"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP BY "browser", "session_id"
)
SELECT "browser",
       AVG("duration_seconds") AS "avg_session_seconds"
FROM session_durations
GROUP BY "browser"
ORDER BY "avg_session_seconds" ASC
LIMIT 20;
```

```sql
--Description: Same as above but include only browsers with more than 10 total sessions
WITH session_durations AS (
    SELECT "browser",
           "session_id",
           (MAX("created_at") - MIN("created_at")) / 1000000.0 AS "duration_seconds"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP BY "browser", "session_id"
), browser_filter AS (
    SELECT "browser"
    FROM session_durations
    GROUP BY "browser"
    HAVING COUNT(*) > 10
)
SELECT sd."browser",
       AVG(sd."duration_seconds") AS "avg_session_seconds"
FROM session_durations sd
JOIN browser_filter bf
  ON sd."browser" = bf."browser"
GROUP BY sd."browser"
ORDER BY "avg_session_seconds" ASC
LIMIT 20;
```

```sql
--Description: Return the three browsers with the shortest average session duration (and their averages) – final analytic step
WITH session_durations AS (
    SELECT "browser",
           "session_id",
           (MAX("created_at") - MIN("created_at")) / 1000000.0 AS "duration_seconds"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP BY "browser", "session_id"
), browser_filter AS (
    SELECT "browser"
    FROM session_durations
    GROUP BY "browser"
    HAVING COUNT(*) > 10
)
SELECT sd."browser",
       AVG(sd."duration_seconds") AS "avg_session_seconds"
FROM session_durations sd
JOIN browser_filter bf
  ON sd."browser" = bf."browser"
GROUP BY sd."browser"
ORDER BY "avg_session_seconds" ASC
LIMIT 3;
```
