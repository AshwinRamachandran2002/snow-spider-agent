--Description: Compute per-session start & end times (μs) and raw duration (μs) for a small sample to check logic
SELECT "browser",
       "session_id",
       MIN("created_at") AS "session_start",
       MAX("created_at") AS "session_end",
       (MAX("created_at") - MIN("created_at")) AS "duration_microseconds"
