```sql
-- Description: Quick glance at the raw events data to understand the columns we will use
SELECT * 
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS" 
LIMIT 20;
```

```sql
-- Description: List of distinct browsers captured in the EVENTS table
SELECT DISTINCT "browser" 
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS" 
LIMIT 20;
```

```sql
-- Description: Count how many unique sessions each browser has (ordered by most sessions)
SELECT 
    "browser",
    COUNT(DISTINCT "session_id") AS "session_cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
GROUP BY "browser"
ORDER BY "session_cnt" DESC
LIMIT 20;
```

```sql
-- Description: Compute a per-session duration (in seconds) by browser for a sample of sessions
SELECT 
    "browser",
    "session_id",
    MIN("created_at") AS "min_ts",
    MAX("created_at") AS "max_ts",
    (MAX("created_at") - MIN("created_at")) / 1000000 AS "session_dur_sec"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
GROUP BY "browser", "session_id"
LIMIT 20;
```

```sql
-- Description: Average session duration by browser for every browser, without filters
SELECT
    t."browser",
    AVG(t."session_dur_sec") AS "avg_session_duration_sec"
FROM (
    SELECT 
        "browser",
        "session_id",
        (MAX("created_at") - MIN("created_at")) / 1000000 AS "session_dur_sec"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
    GROUP BY "browser", "session_id"
) t
GROUP BY t."browser"
ORDER BY "avg_session_duration_sec" ASC
LIMIT 20;
```

```sql
-- Description: Count of sessions and average session duration for browsers that have > 10 sessions
SELECT
    t."browser",
    COUNT(*)                                  AS "total_sessions",
    AVG(t."session_dur_sec")                  AS "avg_session_duration_sec"
FROM (
    SELECT 
        "browser",
        "session_id",
        (MAX("created_at") - MIN("created_at")) / 1000000 AS "session_dur_sec"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
    GROUP BY "browser", "session_id"
) t
GROUP BY t."browser"
HAVING COUNT(*) > 10
ORDER BY "avg_session_duration_sec" ASC
LIMIT 20;
```

```sql
-- Description: Final query – return the three browsers with the shortest average session duration
SELECT
    t."browser",
    AVG(t."session_dur_sec")                  AS "avg_session_duration_sec"
FROM (
    SELECT 
        "browser",
        "session_id",
        (MAX("created_at") - MIN("created_at")) / 1000000 AS "session_dur_sec"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
    GROUP BY "browser", "session_id"
) t
GROUP BY t."browser"
HAVING COUNT(*) > 10
ORDER BY "avg_session_duration_sec" ASC
LIMIT 3;
```
