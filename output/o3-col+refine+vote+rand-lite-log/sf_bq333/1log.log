```sql
--Description: 9) Verify counts and averages for those three browsers only (safety check)  
WITH session_durations AS (
  SELECT
    "session_id",
    "browser",
    (MAX("created_at") - MIN("created_at")) / 1000000 AS "session_seconds"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
  GROUP BY "session_id", "browser"
), top3 AS (
  SELECT
    "browser"
  FROM session_durations
  GROUP BY "browser"
  HAVING COUNT(*) > 10
  ORDER BY AVG("session_seconds")
  LIMIT 3
)
SELECT 
  sd."browser",
  AVG(sd."session_seconds") AS "avg_session_seconds",
  COUNT(*)                  AS "session_count"
FROM session_durations sd
JOIN top3 t
  ON sd."browser" = t."browser"
GROUP BY sd."browser"
LIMIT 20;
```

```sql
