```sql
--Description: 8) Show the three browsers with the shortest average session duration  
SELECT
  "browser",
  AVG((MAX("created_at") - MIN("created_at")) / 1000000) AS "avg_session_seconds"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
