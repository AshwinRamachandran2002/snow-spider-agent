Query:
--Description: 9) Verify counts and averages for those three browsers only (already used CTEs correctly, kept for clarity)  
WITH session_durations AS (                      -- each session’s duration
    SELECT
        "browser",
        "session_id",
        (MAX("created_at") - MIN("created_at")) / 1000000 AS "session_seconds"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
    GROUP BY "browser", "session_id"
), top3 AS (                                    -- pick top-3 fastest browsers
    SELECT
        "browser"
    FROM session_durations
    GROUP BY "browser"
    HAVING COUNT(*) > 10
    ORDER BY AVG("session_seconds") ASC
    LIMIT 3
)
SELECT
    sd."browser",
    AVG(sd."session_seconds") AS "avg_session_seconds",
    COUNT(*)                  AS "session_count"
FROM session_durations sd
JOIN top3 t
  ON sd."browser" = t."browser"
GROUP BY sd."browser"
Answer:
browser,avg_session_seconds,session_count
