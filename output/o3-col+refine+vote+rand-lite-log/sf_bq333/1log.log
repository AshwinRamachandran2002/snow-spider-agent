```sql
--Description: Goal → find the three browsers with the shortest average session duration  
--             ( average of MAX(created_at) − MIN(created_at) within each session ),  
--             but consider only browsers that occur in >10 sessions.  
--Logic in-query:  
--   1. Build CTE session_durations: one row per (browser, session_id) with its duration_seconds.  
--   2. Build CTE browser_stats : aggregate step-1 to browser level, compute average duration & session count, keep browsers with >10 sessions.  
--   3. Final SELECT: pick the three browsers having the smallest average session duration.  
WITH session_durations AS (                 -- Step-1: per-session duration in seconds
    SELECT
        "browser",
        "session_id",
        (MAX("created_at") - MIN("created_at")) / 1000000 AS "session_seconds"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
    GROUP BY "browser", "session_id"
), browser_stats AS (                       -- Step-2: per-browser averages & counts
    SELECT
        "browser",
        AVG("session_seconds") AS "avg_session_seconds",
        COUNT(*)               AS "total_sessions"
    FROM session_durations
    GROUP BY "browser"
    HAVING COUNT(*) > 10                    -- only browsers with >10 sessions
)
SELECT                                       -- Step-3: shortest three
    "browser",
    "avg_session_seconds",
    "total_sessions"
FROM browser_stats
ORDER BY "avg_session_seconds" ASC
LIMIT 3;
```
