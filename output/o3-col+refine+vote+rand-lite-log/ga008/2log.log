```sql
--Description: 6) Sample a few page-view events that belong to purchase users.
WITH purchase_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
  WHERE event_name = 'purchase'
)
SELECT event_date,
       user_pseudo_id,
       event_name,
       event_params
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
WHERE event_name = 'page_view'
  AND user_pseudo_id IN (SELECT user_pseudo_id FROM purchase_users)
LIMIT 20;
```

```sql
--Description: 7) Count page views per day (restricted to purchase users).
WITH purchase_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
  WHERE event_name = 'purchase'
)
SELECT event_date,
       COUNT(*) AS page_views
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
WHERE event_name = 'page_view'
  AND user_pseudo_id IN (SELECT user_pseudo_id FROM purchase_users)
GROUP BY event_date
ORDER BY event_date
LIMIT 20;
```

```sql
--Description: 8) Count distinct purchase users who generated page views each day.
WITH purchase_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
  WHERE event_name = 'purchase'
)
SELECT event_date,
       COUNT(DISTINCT user_pseudo_id) AS users_with_page_views
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
WHERE event_name = 'page_view'
  AND user_pseudo_id IN (SELECT user_pseudo_id FROM purchase_users)
GROUP BY event_date
ORDER BY event_date
LIMIT 20;
```

```sql
--Description: 9) Combine the two counts to get the average page views per user.
WITH purchase_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
  WHERE event_name = 'purchase'
),
daily_counts AS (
  SELECT
    event_date,
    COUNT(*)                          AS total_page_views,
    COUNT(DISTINCT user_pseudo_id)    AS users_viewing
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
  WHERE event_name = 'page_view'
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM purchase_users)
  GROUP BY event_date
)
SELECT
  event_date,
  total_page_views,
  SAFE_DIVIDE(total_page_views, users_viewing) AS avg_page_views_per_user
FROM daily_counts
ORDER BY event_date
LIMIT 20;
```

```sql
--Description: 10) Final answer – total and average page views for every day in Nov-2020
--               for users who made at least one purchase in that month.
WITH purchase_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
  WHERE event_name = 'purchase'
),
daily_counts AS (
  SELECT
    event_date,
    COUNT(*)                          AS total_page_views,
    COUNT(DISTINCT user_pseudo_id)    AS users_viewing
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
  WHERE event_name = 'page_view'
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM purchase_users)
  GROUP BY event_date
)
SELECT
  event_date,
  total_page_views,
  SAFE_DIVIDE(total_page_views, users_viewing) AS avg_page_views_per_user
FROM daily_counts
ORDER BY event_date;
```
