Below is a progressive set of BigQuery statements – from exploration to the final answer – that show how to obtain  

• the total number of page-views for every day in November 2020 and  
• the average number of page-views per user on those same days,  

restricted to users who made at least one purchase during that month.

```sql
-- 1. Description:  Display some distinct event names that occur in Nov-2020
SELECT DISTINCT event_name
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
LIMIT 20;
```

```sql
-- 2. Description:  Peek at a few purchase events to confirm their structure
SELECT
  _TABLE_SUFFIX            AS table_day,
  event_date,
  user_pseudo_id,
  event_name,
  event_params
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
  AND event_name = 'purchase'
LIMIT 20;
```

```sql
-- 3. Description:  Count how many unique users generated a purchase in Nov-2020
SELECT
  COUNT(DISTINCT user_pseudo_id) AS purchase_users_nov2020
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
  AND event_name = 'purchase'
LIMIT 20;
```

```sql
-- 4. Description:  Grab a small sample of those purchasing users
SELECT DISTINCT user_pseudo_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
  AND event_name = 'purchase'
LIMIT 20;
```

```sql
-- 5. Description:  Raw (all–user) page-view counts by day for context
SELECT
  event_date,
  COUNT(*) AS all_users_pageviews
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
  AND event_name = 'page_view'
GROUP BY event_date
ORDER BY event_date
LIMIT 20;
```

```sql
-- 6. Description:  Page-view totals per day produced ONLY by purchasing users
WITH purchase_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND event_name = 'purchase'
)
SELECT
  event_date,
  COUNT(*) AS pageviews_by_purchasers
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
  AND event_name = 'page_view'
  AND user_pseudo_id IN (SELECT user_pseudo_id FROM purchase_users)
GROUP BY event_date
ORDER BY event_date
LIMIT 20;
```

```sql
-- 7. Description:  For those same purchasing users, count how many of them
--                  generated at least one page view each day
WITH purchase_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND event_name = 'purchase'
)
SELECT
  event_date,
  COUNT(DISTINCT user_pseudo_id) AS purchasers_with_pageview
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
  AND event_name = 'page_view'
  AND user_pseudo_id IN (SELECT user_pseudo_id FROM purchase_users)
GROUP BY event_date
ORDER BY event_date
LIMIT 20;
```

```sql
-- 8. Description:  FINAL ANSWER – total page-views per day and
--                  average page-views per purchasing user (Nov-2020)
WITH purchase_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND event_name = 'purchase'
), pageviews AS (
  SELECT
    event_date,
    user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND event_name = 'page_view'
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM purchase_users)
)
SELECT
  event_date,
  COUNT(*)                                        AS total_page_views,
  COUNT(*) / COUNT(DISTINCT user_pseudo_id)       AS avg_pageviews_per_user
FROM pageviews
GROUP BY event_date
ORDER BY event_date
LIMIT 20;
```

