```sql
--Description: Calculate the exact quantities to pick for order 423. 
--Step-by-step in CTEs: 
-- 1) need  : total quantity required per product in the order. 
-- 2) inv   : inventory rows in warehouse 1 for those products (adds aisle/position & purchase date). 
-- 3) ranked: same rows but now with a running cumulative stock (oldest → newest, smaller lots first). 
--            The running total lets us see how much of each row is still needed. 
-- The final SELECT keeps only the rows that are actually used to fulfil the order and 
-- computes ‘pick_qty’ so that the cumulative picked amount exactly equals the order demand, 
-- never exceeding on-hand stock. 
WITH need AS (
    SELECT product_id,
           SUM(qty) AS need_qty
    FROM orderlines
    WHERE order_id = 423
    GROUP BY product_id
),
inv AS (
    SELECT i.id            AS inv_id,
           i.product_id,
           i.qty           AS stock_qty,
           p.purchased,
           l.aisle,
           l.position
    FROM inventory i
    JOIN locations l  ON l.id = i.location_id
    JOIN purchases p  ON p.id = i.purchase_id
    WHERE l.warehouse = 1
      AND i.product_id IN (SELECT product_id FROM need)
),
ranked AS (
    SELECT inv.*,
           n.need_qty,
           SUM(stock_qty) OVER (
                 PARTITION BY product_id
                 ORDER BY purchased, stock_qty, inv_id
           ) AS cum_qty
    FROM inv
    JOIN need n USING (product_id)
)
SELECT product_id,
       aisle,
       position,
       CASE 
            WHEN cum_qty - stock_qty >= need_qty         -- this row is already beyond demand
                 THEN 0
            ELSE MIN(stock_qty, need_qty - (cum_qty - stock_qty)) 
       END AS pick_qty
FROM ranked
WHERE cum_qty - stock_qty < need_qty                     -- only rows that contribute
ORDER BY product_id, purchased, stock_qty
LIMIT 20;
```
