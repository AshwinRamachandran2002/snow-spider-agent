WHERE o.order_id = 423
LIMIT 20;
```

```sql
-- 4) Join inventory with locations to see warehouse / aisle / position
SELECT DISTINCT i.id           AS inventory_id,
       i.product_id,
       l.warehouse,
       l.aisle,
       l.position,
       i.qty                    AS stock_qty
FROM inventory  AS i
JOIN locations  AS l  ON l.id = i.location_id
JOIN orderlines AS o  ON o.product_id = i.product_id
WHERE o.order_id = 423
  AND l.warehouse = 1          -- we only pick from warehouse 1
LIMIT 20;
```

```sql
-- 5) Add purchase date so we can pick oldest stock first
SELECT DISTINCT i.id           AS inventory_id,
       i.product_id,
       p.purchased,
       l.aisle,
       l.position,
       i.qty                    AS stock_qty
FROM inventory  AS i
JOIN purchases  AS p  ON p.id  = i.purchase_id
JOIN locations  AS l  ON l.id  = i.location_id
WHERE l.warehouse = 1
  AND i.product_id IN (SELECT product_id
                       FROM orderlines
                       WHERE order_id = 423)
LIMIT 20;
```

```sql
-- 6) Needed quantity per product for the order (one row per product)
SELECT DISTINCT product_id,
       SUM(qty) AS need_qty
FROM orderlines
WHERE order_id = 423
GROUP BY product_id
LIMIT 20;
```

```sql
-- 7) Combine stock with the needed quantity and sort by oldest purchase & smaller lots
WITH need AS (
    SELECT product_id, SUM(qty) AS need_qty
    FROM orderlines
    WHERE order_id = 423
    GROUP BY product_id
),
inv AS (
    SELECT i.id          AS inventory_id,
           i.product_id,
           i.qty         AS stock_qty,
           p.purchased,
           l.aisle,
           l.position
    FROM inventory i
    JOIN purchases p ON p.id = i.purchase_id
    JOIN locations l ON l.id = i.location_id
    WHERE l.warehouse = 1
      AND i.product_id IN (SELECT product_id FROM need)
)
SELECT DISTINCT inv.*,
       need.need_qty
FROM inv
JOIN need USING (product_id)
ORDER BY inv.product_id, inv.purchased, inv.stock_qty
LIMIT 20;
```

```sql
-- 8) FINAL: quantities to pick from each location (exactly filling the order, no over-picking)
WITH need AS (
    SELECT product_id, SUM(qty) AS need_qty
    FROM orderlines
    WHERE order_id = 423
    GROUP BY product_id
),
inv AS (
    SELECT i.id          AS inventory_id,
           i.product_id,
           i.qty         AS stock_qty,
           p.purchased,
           l.aisle,
           l.position
    FROM inventory i
    JOIN purchases p ON p.id = i.purchase_id
    JOIN locations l ON l.id = i.location_id
    WHERE l.warehouse = 1
      AND i.product_id IN (SELECT product_id FROM need)
),
sorted AS (
    SELECT inventory_id,
           product_id,
           stock_qty,
           aisle,
           position,
           purchased,
           need.need_qty,
           SUM(stock_qty) OVER (
                 PARTITION BY product_id
                 ORDER BY purchased, stock_qty, inventory_id
           ) AS running_total
    FROM inv
    JOIN need USING (product_id)
)
SELECT DISTINCT product_id,
       aisle,
       position,
       CASE
            WHEN running_total - stock_qty < need_qty
                 THEN MIN(stock_qty, need_qty - (running_total - stock_qty))
            ELSE 0
       END AS pick_qty
FROM sorted
WHERE CASE
          WHEN running_total - stock_qty < need_qty
               THEN MIN(stock_qty, need_qty - (running_total - stock_qty))
          ELSE 0
      END > 0
ORDER BY product_id, purchased, stock_qty
LIMIT 20;
```
