```sql
--Description: All inventory records that hold any of the products required for order 423
SELECT DISTINCT i."id"        AS "inv_id",
                i."product_id",
                i."location_id",
                i."purchase_id",
                i."qty"
FROM   "inventory" AS i
WHERE  i."product_id" IN (SELECT "product_id"
                          FROM   "orderlines"
                          WHERE  "order_id" = 423)
LIMIT 20;
```

```sql
--Description: Add warehouse, aisle and position information to the relevant inventory rows
SELECT DISTINCT i."id"      AS "inv_id",
                i."product_id",
                l."warehouse",
                l."aisle",
                l."position",
                i."qty"
FROM   "inventory" AS i
JOIN   "locations" AS l
       ON l."id" = i."location_id"
WHERE  i."product_id" IN (SELECT "product_id"
                          FROM   "orderlines"
                          WHERE  "order_id" = 423)
LIMIT 20;
```

```sql
--Description: Restrict the previous result to inventory that sits in warehouse 1 only
SELECT DISTINCT i."id"      AS "inv_id",
                i."product_id",
                l."aisle",
                l."position",
                i."qty"
FROM   "inventory" AS i
JOIN   "locations" AS l
       ON l."id" = i."location_id"
WHERE  l."warehouse" = 1
AND    i."product_id" IN (SELECT "product_id"
                          FROM   "orderlines"
                          WHERE  "order_id" = 423)
LIMIT 20;
```

```sql
--Description: Attach the original purchase date to each inventory row (needed for FIFO picking)
SELECT DISTINCT i."id"          AS "inv_id",
                i."product_id",
                p."purchased"   AS "purchased_date",
                l."aisle",
                l."position",
                i."qty"
FROM   "inventory" AS i
JOIN   "purchases" AS p
       ON p."id" = i."purchase_id"
JOIN   "locations" AS l
       ON l."id" = i."location_id"
WHERE  l."warehouse" = 1
AND    i."product_id" IN (SELECT "product_id"
                          FROM   "orderlines"
                          WHERE  "order_id" = 423)
ORDER BY i."product_id",
         p."purchased",          -- earliest purchase first
         i."qty"                 -- smaller lots first
LIMIT 20;
```

```sql
--Description: Summarise the on-hand quantity in warehouse 1 per product to make sure stock is sufficient
SELECT DISTINCT i."product_id",
                SUM(i."qty") AS "wh1_qty_available"
FROM   "inventory" AS i
JOIN   "locations" AS l
       ON l."id" = i."location_id"
WHERE  l."warehouse" = 1
AND    i."product_id" IN (SELECT "product_id"
                          FROM   "orderlines"
                          WHERE  "order_id" = 423)
GROUP  BY i."product_id"
LIMIT 20;
```

```sql
--Description: Compare required versus available quantity for each product (quick check)
SELECT DISTINCT ol."product_id",
                SUM(ol."qty")                      AS "qty_required",
                (SELECT SUM(i."qty")
                   FROM "inventory" AS i
                   JOIN "locations" AS l
                         ON l."id" = i."location_id"
                  WHERE l."warehouse" = 1
                    AND i."product_id" = ol."product_id") AS "wh1_qty_available"
FROM   "orderlines" AS ol
WHERE  ol."order_id" = 423
GROUP  BY ol."product_id"
LIMIT 20;
```

```sql
--Description: FIFO-ordered inventory list including cumulative running total to decide exact pick splits (uses window functions)
SELECT DISTINCT i."product_id",
                i."id"          AS "inv_id",
                p."purchased"   AS "purchased_date",
                l."aisle",
                l."position",
                i."qty",
                SUM(i."qty") OVER (PARTITION BY i."product_id"
                                   ORDER BY p."purchased", i."qty", i."id") AS "running_qty"
FROM   "inventory" AS i
JOIN   "purchases" AS p   ON p."id" = i."purchase_id"
JOIN   "locations" AS l   ON l."id" = i."location_id"
WHERE  l."warehouse" = 1
AND    i."product_id" IN (SELECT "product_id"
                          FROM   "orderlines"
                          WHERE  "order_id" = 423)
ORDER BY i."product_id",
         p."purchased",
         i."qty",
         i."id"
LIMIT 20;
```

```sql
--Description: Retrieve pick lines already created (if any) for order 423 to avoid double picking
SELECT DISTINCT pl."picklist_id",
                pl."line_no",
                pl."location_id",
                pl."product_id",
                pl."qty"
FROM   "picking_line" AS pl
WHERE  pl."order_id" = 423
LIMIT 20;
```

```sql
--Description: Provide a single ready-to-use list of product-aisle-position-qty that fulfils order 423 with FIFO & smallest-lot-first logic
SELECT DISTINCT x."product_id",
                x."aisle",
                x."position",
                CASE
                    WHEN x."running_qty" - x."qty" < r."qty_required"
                         THEN r."qty_required" - (x."running_qty" - x."qty")
                    ELSE 0
                END AS "qty_to_pick"
FROM  (
        SELECT  i."product_id",
                p."purchased",
                l."aisle",
                l."position",
                i."qty",
                SUM(i."qty") OVER (PARTITION BY i."product_id"
                                   ORDER BY p."purchased", i."qty", i."id") AS "running_qty"
        FROM    "inventory" AS i
        JOIN    "purchases" AS p ON p."id" = i."purchase_id"
        JOIN    "locations" AS l ON l."id" = i."location_id"
        WHERE   l."warehouse" = 1
        AND     i."product_id" IN (SELECT "product_id"
                                   FROM   "orderlines"
                                   WHERE  "order_id" = 423)
      ) AS x
JOIN (
        SELECT  "product_id",
                SUM("qty") AS "qty_required"
        FROM    "orderlines"
        WHERE   "order_id" = 423
        GROUP   BY "product_id"
      ) AS r
ON    r."product_id" = x."product_id"
WHERE x."running_qty" <= r."qty_required"
  OR (x."running_qty" - x."qty" < r."qty_required")
ORDER BY x."product_id",
         x."purchased"
LIMIT 20;
```
