```sql
--Description: Full pick-plan for order 423, built step-by-step inside one query.
-- 1. “req” CTE   → total quantity required per product in the order.
-- 2. “inv” CTE   → all inventory in warehouse 1 holding those products,
--                  including purchase-date (oldest first rule) and lot size.
-- 3. “ranked”    → add running total (cum_qty) per product ordered by
--                  purchase-date then smaller lots, plus each product’s need.
-- 4. “pick”      → decide how much to take from each location:
--                     a) demand met before this pallet → 0
--                     b) demand not yet met           → full pallet
--                     c) pallet would overshoot       → just the remainder.
-- 5. “final_pick”→ keep only locations actually used.
-- 6. Final SELECT returns, for every order-line, the aisle/position(s) and
--    exact quantity to pick, obeying: oldest stock first, no over-picking,
--    total picked per product = total ordered.
WITH req AS (
    SELECT product_id, SUM(qty) AS req_qty
    FROM   orderlines
    WHERE  order_id = 423
    GROUP  BY product_id
),
inv AS (
    SELECT i.id           AS inv_id,
           i.product_id,
           i.qty,
           p.purchased,
           l.aisle,
           l.position
    FROM   inventory i
    JOIN   locations l ON l.id = i.location_id
    JOIN   purchases p ON p.id = i.purchase_id
    WHERE  l.warehouse = 1
      AND  i.product_id IN (SELECT product_id FROM req)
),
ranked AS (
    SELECT inv.*,
           SUM(inv.qty) OVER (
               PARTITION BY inv.product_id
               ORDER BY inv.purchased, inv.qty
           )                          AS cum_qty,
           req.req_qty
    FROM   inv
    JOIN   req ON req.product_id = inv.product_id
),
pick AS (
    SELECT product_id,
           aisle,
           position,
           CASE
               WHEN cum_qty - qty >= req_qty THEN 0
               WHEN cum_qty <= req_qty       THEN qty
               ELSE req_qty - (cum_qty - qty)
           END AS pick_qty
    FROM   ranked
),
final_pick AS (
    SELECT * FROM pick WHERE pick_qty > 0
)
SELECT ol.id    AS orderline_id,
       ol.product_id,
       ol.qty   AS line_qty,
       fp.aisle,
       fp.position,
       fp.pick_qty
FROM   orderlines ol
JOIN   final_pick fp ON fp.product_id = ol.product_id
WHERE  ol.order_id = 423
ORDER  BY ol.id, fp.aisle, fp.position;
```
