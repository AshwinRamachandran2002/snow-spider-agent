Query:
-- 5. Build an ordered list of every pallet/box per product,
--    ranked by oldest purchase-date and then by the smaller quantity.
WITH inv AS (
  SELECT i."id"                AS "inv_id",
         i."product_id",
         i."qty",
         p."purchased",
         l."aisle",
         l."position"
  FROM   "inventory"  AS i
  JOIN   "locations"  AS l ON l."id" = i."location_id"
  JOIN   "purchases"  AS p ON p."id" = i."purchase_id"
  WHERE  l."warehouse" = 1
    AND  i."product_id" IN (SELECT "product_id"
                            FROM   "orderlines"
                            WHERE  "order_id" = 423)
)
SELECT DISTINCT inv.*,
       ROW_NUMBER() OVER (PARTITION BY inv."product_id"
                          ORDER BY inv."purchased", inv."qty") AS "rank_no"
FROM   inv
ORDER  BY inv."product_id", "rank_no"
LIMIT  20;
