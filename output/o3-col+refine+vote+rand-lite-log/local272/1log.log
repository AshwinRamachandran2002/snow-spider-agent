```sql
-- 3. Bring in the purchase date (needed for “oldest first” picking-rule).
SELECT DISTINCT i."id"          AS "inventory_id",
       i."product_id",
       i."qty"                  AS "inv_qty",
       p."purchased",
       l."aisle",
       l."position"
FROM   "inventory"  AS i
JOIN   "locations"  AS l  ON l."id" = i."location_id"
JOIN   "purchases"  AS p  ON p."id" = i."purchase_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN (SELECT "product_id"
                          FROM   "orderlines"
                          WHERE  "order_id" = 423)
