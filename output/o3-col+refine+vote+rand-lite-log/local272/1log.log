LIMIT  20;
```

```sql
-- 4. Verify that the total on-hand quantity is sufficient for every product needed.
SELECT DISTINCT i."product_id",
       SUM(i."qty") AS "stock_qty",
       r."req_qty"
FROM   "inventory" AS i
JOIN   "locations" AS l ON l."id" = i."location_id"
JOIN  (
        SELECT "product_id", SUM("qty") AS "req_qty"
        FROM   "orderlines"
        WHERE  "order_id" = 423
        GROUP  BY "product_id"
      ) AS r  ON r."product_id" = i."product_id"
WHERE  l."warehouse" = 1
GROUP  BY i."product_id"
LIMIT  20;
```

```sql
-- 5. Build an ordered list of every pallet/box per product,
--    ranked by oldest purchase-date and then by the smaller quantity.
WITH inv AS (
  SELECT i."id"                AS "inv_id",
         i."product_id",
         i."qty",
         p."purchased",
         l."aisle",
         l."position"
  FROM   "inventory"  AS i
  JOIN   "locations"  AS l ON l."id" = i."location_id"
  JOIN   "purchases"  AS p ON p."id" = i."purchase_id"
  WHERE  l."warehouse" = 1
    AND  i."product_id" IN (SELECT "product_id"
                            FROM   "orderlines"
                            WHERE  "order_id" = 423)
)
SELECT DISTINCT inv.*,
       ROW_NUMBER() OVER (PARTITION BY inv."product_id"
                          ORDER BY inv."purchased", inv."qty") AS "rank_no"
FROM   inv
ORDER  BY inv."product_id", "rank_no"
LIMIT  20;
```

```sql
-- 6. Add a running total (cum_qty) so we can calculate exactly how much
--    to take from each location while meeting, but not exceeding, demand.
WITH req AS (
  SELECT "product_id", SUM("qty") AS "req_qty"
  FROM   "orderlines"
  WHERE  "order_id" = 423
  GROUP  BY "product_id"
),
inv AS (
  SELECT i."id"          AS "inv_id",
         i."product_id",
         i."qty",
         p."purchased",
         l."aisle",
         l."position"
  FROM   "inventory"  AS i
  JOIN   "locations"  AS l ON l."id" = i."location_id"
  JOIN   "purchases"  AS p ON p."id" = i."purchase_id"
  WHERE  l."warehouse" = 1
    AND  i."product_id" IN (SELECT "product_id" FROM req)
),
ord AS (
  SELECT inv.*,
         SUM(inv."qty") OVER (PARTITION BY inv."product_id"
                              ORDER BY inv."purchased", inv."qty"
                              ROWS BETWEEN UNBOUNDED PRECEDING
                                       AND CURRENT ROW) AS "cum_qty"
  FROM   inv
)
SELECT DISTINCT ord.*,
       req."req_qty"
FROM   ord
JOIN   req  ON req."product_id" = ord."product_id"
ORDER  BY ord."product_id", ord."purchased", ord."qty"
LIMIT  20;
```

```sql
-- 7. Final allocation: how many units to pick from each location
--    (0 ⇢ skip) so cumulative picked equals exactly the requirement.
WITH req AS (
  SELECT "product_id", SUM("qty") AS "req_qty"
  FROM   "orderlines"
  WHERE  "order_id" = 423
  GROUP  BY "product_id"
),
inv AS (
  SELECT i."id"          AS "inv_id",
         i."product_id",
         i."qty",
         p."purchased",
         l."aisle",
         l."position"
  FROM   "inventory"  AS i
  JOIN   "locations"  AS l ON l."id" = i."location_id"
  JOIN   "purchases"  AS p ON p."id" = i."purchase_id"
  WHERE  l."warehouse" = 1
    AND  i."product_id" IN (SELECT "product_id" FROM req)
),
ord AS (
  SELECT inv.*,
         SUM(inv."qty") OVER (PARTITION BY inv."product_id"
                              ORDER BY inv."purchased", inv."qty"
                              ROWS BETWEEN UNBOUNDED PRECEDING
                                       AND CURRENT ROW)          AS "cum_qty",
         req."req_qty"
  FROM   inv
  JOIN   req ON req."product_id" = inv."product_id"
),
pick AS (
  SELECT ord."product_id",
         ord."aisle",
         ord."position",
         CASE
           WHEN ord."cum_qty" - ord."qty" >= ord."req_qty" THEN 0       -- already satisfied
           WHEN ord."cum_qty"        <= ord."req_qty" THEN ord."qty"    -- take all
           ELSE ord."req_qty" - (ord."cum_qty" - ord."qty")             -- take partial
         END AS "pick_qty"
  FROM   ord
)
SELECT DISTINCT "product_id",
       "aisle",
       "position",
       "pick_qty"
FROM   pick
WHERE  "pick_qty" > 0        -- ignore locations we don't need to visit
ORDER  BY "product_id", "aisle", "position"
LIMIT  20;
```

```sql
-- 8. Optional: match the sequence of individual order-lines
--    (relevant only when the same product appears several times).
SELECT DISTINCT ol."id"         AS "orderline_id",
       ol."product_id",
       ol."qty"                 AS "line_qty",
       pick."aisle",
       pick."position",
       pick."pick_qty"
FROM   "orderlines" AS ol
JOIN ( /* the pick CTE above */ ) AS pick
     ON pick."product_id" = ol."product_id"
WHERE  ol."order_id" = 423
ORDER  BY ol."id", pick."aisle", pick."position"
LIMIT  20;
```

These eight queries step from the basic demand (order-lines) through available stock, ranking and cumulative sums, and finally calculate exactly how many units to pick from each aisle/position while honoring:

• Warehouse 1 only  
• “Oldest purchase, smallest lot” priority  
• No location’s inventory taken in excess, and total picked = total ordered for every product.
