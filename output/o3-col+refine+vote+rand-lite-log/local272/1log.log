Query:
-- 6. Add a running total (cum_qty) so we can calculate exactly how much
--    to take from each location while meeting, but not exceeding, demand.
WITH req AS (
  SELECT "product_id", SUM("qty") AS "req_qty"
  FROM   "orderlines"
  WHERE  "order_id" = 423
  GROUP  BY "product_id"
),
inv AS (
  SELECT i."id"          AS "inv_id",
         i."product_id",
         i."qty",
         p."purchased",
         l."aisle",
         l."position"
  FROM   "inventory"  AS i
  JOIN   "locations"  AS l ON l."id" = i."location_id"
  JOIN   "purchases"  AS p ON p."id" = i."purchase_id"
  WHERE  l."warehouse" = 1
    AND  i."product_id" IN (SELECT "product_id" FROM req)
),
ord AS (
  SELECT inv.*,
         SUM(inv."qty") OVER (PARTITION BY inv."product_id"
                              ORDER BY inv."purchased", inv."qty"
                              ROWS BETWEEN UNBOUNDED PRECEDING
                                       AND CURRENT ROW) AS "cum_qty"
  FROM   inv
)
SELECT DISTINCT ord.*,
       req."req_qty"
FROM   ord
JOIN   req  ON req."product_id" = ord."product_id"
ORDER  BY ord."product_id", ord."purchased", ord."qty"
LIMIT  20;
