--Description: Final answer – top 3 states with the largest Clear-vs-Rain weekend accident gaps in 2016.
SELECT `state_name`,
       COALESCE(clear_count,0)  AS clear_weekend_accidents,
       COALESCE(rain_count ,0)  AS rain_weekend_accidents,
       ABS(COALESCE(clear_count,0) - COALESCE(rain_count,0)) AS difference
FROM (
    SELECT `state_name`,
           COUNTIF(`atmospheric_conditions_1_name` = 'Clear') AS clear_count,
           COUNTIF(`atmospheric_conditions_1_name` = 'Rain')  AS rain_count
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
    WHERE `day_of_week` IN (1,7)
    GROUP BY `state_name`
)
ORDER BY difference DESC
LIMIT 3;
