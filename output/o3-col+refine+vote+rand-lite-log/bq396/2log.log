Query:
--Description: Compute the absolute difference between Clear and Rain weekend crashes.
SELECT `state_name`,
       COALESCE(clear_count,0)  AS clear_count,
       COALESCE(rain_count ,0)  AS rain_count,
       ABS(COALESCE(clear_count,0) - COALESCE(rain_count,0)) AS diff
FROM (
    SELECT clear.`state_name`,
           clear.clear_count,
           rain.rain_count
    FROM (
        SELECT `state_name`, COUNT(*) AS clear_count
        FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
        WHERE `day_of_week` IN (1,7)
          AND `atmospheric_conditions_1_name` = 'Clear'
        GROUP BY `state_name`
    ) AS clear
    FULL JOIN (
        SELECT `state_name`, COUNT(*) AS rain_count
        FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
        WHERE `day_of_week` IN (1,7)
          AND `atmospheric_conditions_1_name` = 'Rain'
        GROUP BY `state_name`
    ) AS rain
    USING (`state_name`)
)
ORDER BY diff DESC
LIMIT 20;
