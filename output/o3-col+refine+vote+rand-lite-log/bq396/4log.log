```sql
-- 8. Combine Rain & Clear counts, compute absolute difference, rank all states
SELECT
  `state_name`,
  SUM(CASE WHEN LOWER(`atmospheric_conditions_1_name`) = 'rain'  THEN 1 ELSE 0 END) AS rain_crashes,
  SUM(CASE WHEN LOWER(`atmospheric_conditions_1_name`) = 'clear' THEN 1 ELSE 0 END) AS clear_crashes,
  ABS(SUM(CASE WHEN LOWER(`atmospheric_conditions_1_name`) = 'rain'  THEN 1 ELSE 0 END) -
