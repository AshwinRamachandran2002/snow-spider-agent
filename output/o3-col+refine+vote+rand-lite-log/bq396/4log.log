Query:
--Description: Count the number of weekend crashes that happened in “Rain”
--             for every state; order by the highest rain counts.
SELECT
  state_name,
  COUNT(*) AS rain_crashes
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE day_of_week IN (1, 7)
  AND LOWER(atmospheric_conditions_1_name) = 'rain'
GROUP BY state_name
ORDER BY rain_crashes DESC
LIMIT 20
