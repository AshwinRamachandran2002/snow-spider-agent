```sql
--Description:
--  Goal: identify the three states that show the greatest gap between the number
--  of weekend (Saturday/Sunday) fatal-crash records in “Rain” vs “Clear” weather
--  during 2016.
--  Approach inside one query:
--    1. Restrict rows to weekend crashes with day_of_week 1 (Sunday) or 7 (Saturday).
--    2. Count, for each state, the rows whose primary weather code is ‘Rain’
--       and separately those whose code is ‘Clear’ (case-insensitive).
--    3. Compute the absolute difference between the two counts.
--    4. Order results by that difference in descending order and return the top three.
SELECT
  state_name AS state,
  ABS(
    SUM(CASE WHEN LOWER(atmospheric_conditions_1_name) = 'rain'  THEN 1 ELSE 0 END) -
    SUM(CASE WHEN LOWER(atmospheric_conditions_1_name) = 'clear' THEN 1 ELSE 0 END)
  ) AS difference
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE day_of_week IN (1, 7)          -- weekend: 1 = Sunday, 7 = Saturday
GROUP BY state
ORDER BY difference DESC
LIMIT 3;
```
