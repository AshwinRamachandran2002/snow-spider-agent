Query:
--Description: Return the single user who owns the highest total number of clicks across all photo collections
WITH all_clicks AS (
  SELECT `user`
  FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_1`
  UNION ALL
  SELECT `user`
  FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_2`
  UNION ALL
  SELECT `user`
  FROM `bigquery-public-data.eclipse_megamovie.photos_v_0_3`
)
