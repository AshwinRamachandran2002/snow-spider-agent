Query:
--Description: Get distinct months (in YYYY-MM) present in ORDER_ITEMS prior to 2024 to confirm time coverage
SELECT DISTINCT 
       TO_CHAR(TO_TIMESTAMP_NTZ("created_at"/1000000), 'YYYY-MM') AS "order_month"
