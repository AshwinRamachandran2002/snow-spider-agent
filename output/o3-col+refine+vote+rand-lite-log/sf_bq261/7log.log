--Description: Aggregate total profit per product for one specific month (example 2023-12) to validate aggregation logic
SELECT 
    p."id"                       AS "product_id",
    p."name",
    SUM(oi."sale_price")         AS "total_sales",
    SUM(p."cost")                AS "total_cost",          -- cost per unit * number of items
    SUM(oi."sale_price" - p."cost") AS "total_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS AS oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     AS p
  ON oi."product_id" = p."id"
WHERE TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000), 'YYYY-MM') = '2023-12'
GROUP BY p."id", p."name"
ORDER BY "total_profit" DESC
LIMIT 20;
