FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.INVENTORY_ITEMS AS ii
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS       AS p
  ON ii."product_id" = p."id"
LIMIT 20;
```

```sql
--Description: Get distinct months (in YYYY-MM) present in ORDER_ITEMS prior to 2024 to confirm time coverage
SELECT DISTINCT 
       TO_CHAR(TO_TIMESTAMP_NTZ("created_at"/1000000), 'YYYY-MM') AS "order_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
WHERE TO_TIMESTAMP_NTZ("created_at"/1000000) < '2024-01-01'
ORDER BY "order_month"
LIMIT 20;
```

```sql
--Description: Aggregate total profit per product for one specific month (example 2023-12) to validate aggregation logic
SELECT 
    p."id"                       AS "product_id",
    p."name",
    SUM(oi."sale_price")         AS "total_sales",
    SUM(p."cost")                AS "total_cost",          -- cost per unit * number of items
    SUM(oi."sale_price" - p."cost") AS "total_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS AS oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     AS p
  ON oi."product_id" = p."id"
WHERE TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000), 'YYYY-MM') = '2023-12'
GROUP BY p."id", p."name"
ORDER BY "total_profit" DESC
LIMIT 20;
```

```sql
--Description: For multiple months, compute profit per product and pick the best product each month (intermediate step)
SELECT
    TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000), 'YYYY-MM')           AS "order_month",
    oi."product_id",
    SUM(oi."sale_price" - p."cost")                                         AS "total_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS AS oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     AS p
  ON oi."product_id" = p."id"
WHERE TO_TIMESTAMP_NTZ(oi."created_at"/1000000) < '2024-01-01'
GROUP BY 1, 2
ORDER BY "order_month", "total_profit" DESC
LIMIT 20;
```

```sql
--Description: Find, for each month, the single product with highest profit along with its total profit (CTE approach preview)
WITH monthly_profit AS (
    SELECT
        TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000), 'YYYY-MM') AS "order_month",
        oi."product_id",
        SUM(oi."sale_price" - p."cost")                               AS "total_profit",
        SUM(p."cost")                                                 AS "total_cost"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS AS oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     AS p
      ON oi."product_id" = p."id"
    WHERE TO_TIMESTAMP_NTZ(oi."created_at"/1000000) < '2024-01-01'
    GROUP BY 1, 2
)
SELECT *
FROM (
    SELECT 
        mp.*,
        ROW_NUMBER() OVER (PARTITION BY mp."order_month" ORDER BY mp."total_profit" DESC) AS rn
    FROM monthly_profit mp
) 
WHERE rn = 1
ORDER BY "order_month"
LIMIT 20;
```

```sql
--Description: Display the product names for the top-profit products per month (tie-breaker handled by ROW_NUMBER)
WITH monthly_profit AS (
    SELECT
        TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000), 'YYYY-MM') AS "order_month",
        oi."product_id",
        SUM(oi."sale_price" - p."cost")                               AS "total_profit",
        SUM(p."cost")                                                 AS "total_cost"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS AS oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     AS p
      ON oi."product_id" = p."id"
    WHERE TO_TIMESTAMP_NTZ(oi."created_at"/1000000) < '2024-01-01'
    GROUP BY 1, 2
),
ranked AS (
    SELECT 
        mp.*,
        ROW_NUMBER() OVER (PARTITION BY mp."order_month" ORDER BY mp."total_profit" DESC) AS rn
    FROM monthly_profit mp
)
SELECT 
    r."order_month",
    r."product_id",
    pr."name"          AS "product_name",
    r."total_cost",
    r."total_profit"
FROM ranked r
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS pr
  ON r."product_id" = pr."id"
WHERE r.rn = 1
ORDER BY r."order_month"
LIMIT 20;
```

```sql
--Description: Verify total profit calculation across all statuses by sampling some months and comparing 'Complete' vs all statuses
SELECT 
    TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000), 'YYYY-MM') AS "order_month",
    SUM(oi."sale_price" - p."cost")                               AS "profit_all_status",
    SUM(CASE WHEN oi."status" = 'Complete' THEN (oi."sale_price" - p."cost") END) AS "profit_complete_only"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS AS oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     AS p
  ON oi."product_id" = p."id"
WHERE TO_TIMESTAMP_NTZ(oi."created_at"/1000000) BETWEEN '2023-07-01' AND '2023-12-31'
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

