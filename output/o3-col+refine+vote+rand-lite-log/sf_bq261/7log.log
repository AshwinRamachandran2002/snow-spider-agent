```sql
--Description: Preview a simple join of ORDER_ITEMS with PRODUCTS to calculate line-level profit
SELECT 
    oi."id"                 AS "order_item_id",
    oi."product_id",
    oi."sale_price",
    p."cost",
    (oi."sale_price" - p."cost") AS "profit",
