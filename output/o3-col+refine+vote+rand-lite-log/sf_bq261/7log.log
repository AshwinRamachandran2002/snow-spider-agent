Query:
--Description: Verify total profit calculation across all statuses by sampling some months and comparing 'Complete' vs all statuses
SELECT 
    TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000), 'YYYY-MM') AS "order_month",
    SUM(oi."sale_price" - p."cost")                               AS "profit_all_status",
    SUM(CASE WHEN oi."status" = 'Complete' THEN (oi."sale_price" - p."cost") END) AS "profit_complete_only"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS AS oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     AS p
  ON oi."product_id" = p."id"
WHERE TO_TIMESTAMP_NTZ(oi."created_at"/1000000) BETWEEN '2023-07-01' AND '2023-12-31'
GROUP BY 1
ORDER BY 1
LIMIT 20;
