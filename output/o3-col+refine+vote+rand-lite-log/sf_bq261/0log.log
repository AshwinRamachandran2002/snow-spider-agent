```sql
--Description:  
--THINKING PROCESS:  
--1) We need, for every month before Jan-2024, the product whose total profit  
--   ( Σ(sale_price – cost) across all order items, any status ) is the highest.  
--2) We join ORDER_ITEMS to PRODUCTS to get both sale_price (per item) and cost (per product).  
--3) We convert ORDER_ITEMS.created_at microseconds → timestamp, then DATE_TRUNC to month.  
--4) For each (month, product) pair we aggregate TOTAL_COST (Σ cost) and TOTAL_PROFIT  
--   (Σ sale_price – cost).  
--5) Using the analytic RANK() function we keep only the top-profit product per month (rn = 1).  
--6) Finally we order chronologically so analysts can read month-by-month results.  
--   LIMIT 100 is added simply to keep the preview manageable. Remove for full list.  

SELECT
    month,
    product_name,
    total_cost,
    total_profit
FROM (
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000))               AS month,
        p."name"                                                                      AS product_name,
        SUM(p."cost")                                                                 AS total_cost,
        SUM(oi."sale_price" - p."cost")                                               AS total_profit,
        RANK() OVER (PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000))
                    ORDER BY SUM(oi."sale_price" - p."cost") DESC)                    AS rn
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
          ON oi."product_id" = p."id"
    WHERE DATE_TRUNC('year', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000)) < '2024-01-01'
    GROUP BY month, product_name
) t
WHERE rn = 1
ORDER BY month
LIMIT 100;
```
