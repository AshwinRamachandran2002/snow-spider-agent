```

```sql
-- Description: Calculate profit (sale_price ‑ cost) for a few joined order items as sanity check  
SELECT oi."id" AS "order_item_id",  
       oi."sale_price",  
       p."cost",  
       (oi."sale_price" - p."cost") AS "profit",  
       oi."created_at"  
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi  
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"  p  
     ON oi."product_id" = p."id"  
LIMIT 20;
```

```sql
-- Description: Aggregate total profit by product for a single month (e.g., January 2023)  
SELECT p."name",  
       SUM(oi."sale_price" - p."cost") AS "total_profit",  
       SUM(p."cost")                   AS "total_cost"  
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi  
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"  p  
     ON oi."product_id" = p."id"  
WHERE oi."created_at" BETWEEN 1672531200000000  -- 2023-01-01 00:00:00  
                         AND     1675209599000000  -- 2023-01-31 23:59:59  
GROUP BY p."name"  
ORDER BY "total_profit" DESC  
LIMIT 20;
```

```sql
-- Description: Find the single best-profit product for each month in 2023 (quick check)  
SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6))      AS "month_start",  
       p."name",  
       SUM(oi."sale_price" - p."cost")                                 AS "month_profit"  
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi  
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"  p  
     ON oi."product_id" = p."id"  
WHERE oi."created_at" BETWEEN 1672531200000000  -- 2023-01-01  
                         AND     1704067199000000  -- 2023-12-31  
GROUP BY "month_start", p."name"  
QUALIFY ROW_NUMBER() OVER (PARTITION BY "month_start" ORDER BY SUM(oi."sale_price" - p."cost") DESC) = 1  
ORDER BY "month_start"  
LIMIT 20;
```

```sql
-- Description: Verify that all months before 2024 exist in the data (distinct month list)  
SELECT DISTINCT DATE_TRUNC('month', TO_TIMESTAMP_NTZ("created_at"/1e6)) AS "month_start"  
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  
WHERE "created_at" < 1704067200000000  -- 2024-01-01  
ORDER BY "month_start"  
LIMIT 20;
```

```sql
-- Description: For a given month (e.g., June 2022) show cost & profit totals for the top product and also the remaining top-5 for comparison  
SELECT p."name",  
       SUM(p."cost")                         AS "total_cost",  
       SUM(oi."sale_price" - p."cost")       AS "total_profit"  
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi  
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"  p  
     ON oi."product_id" = p."id"  
WHERE oi."created_at" BETWEEN 1654041600000000  -- 2022-06-01  
                         AND     1656633599000000  -- 2022-06-30  
GROUP BY p."name"  
ORDER BY "total_profit" DESC  
LIMIT 20;
```

```sql
-- Description: Final-step style query: best-profit product per month for ALL months before 2024, including total cost & profit, ordered chronologically  
SELECT month_cte."month_start",  
       month_cte."product_name",  
       month_cte."total_cost",  
       month_cte."total_profit"  
FROM (  
        SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6))        AS "month_start",  
               p."name"                                                          AS "product_name",  
               SUM(p."cost")                                                     AS "total_cost",  
               SUM(oi."sale_price" - p."cost")                                   AS "total_profit",  
               ROW_NUMBER() OVER (PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6))  
                                   ORDER BY SUM(oi."sale_price" - p."cost") DESC) AS rn  
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi  
        JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"  p  
             ON oi."product_id" = p."id"  
        WHERE oi."created_at" < 1704067200000000  -- before 2024-01-01  
        GROUP BY DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6)), p."name"  
     ) month_cte  
WHERE rn = 1  
ORDER BY "month_start"  
LIMIT 20;
```
