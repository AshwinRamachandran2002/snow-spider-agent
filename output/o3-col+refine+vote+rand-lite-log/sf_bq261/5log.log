```sql
-- Description: Check whether every product in ORDER_ITEMS exists in PRODUCTS (small sample)  
SELECT oi."product_id", p."id" AS "prod_id_match"  
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi  
