Query:
-- Description: Aggregate total profit by product for a single month (e.g., January 2023)  
SELECT p."name",  
       SUM(oi."sale_price" - p."cost") AS "total_profit",  
       SUM(p."cost")                   AS "total_cost"  
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi  
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"  p  
     ON oi."product_id" = p."id"  
WHERE oi."created_at" BETWEEN 1672531200000000  -- 2023-01-01 00:00:00  
                         AND     1675209599000000  -- 2023-01-31 23:59:59  
GROUP BY p."name"  
ORDER BY "total_profit" DESC  
LIMIT 20;
