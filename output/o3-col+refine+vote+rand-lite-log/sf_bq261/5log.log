Query:
-- Description: Final-step style query: best-profit product per month for ALL months before 2024, including total cost & profit, ordered chronologically  
SELECT month_cte."month_start",  
       month_cte."product_name",  
       month_cte."total_cost",  
       month_cte."total_profit"  
FROM (  
        SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6))        AS "month_start",  
               p."name"                                                          AS "product_name",  
               SUM(p."cost")                                                     AS "total_cost",  
               SUM(oi."sale_price" - p."cost")                                   AS "total_profit",  
               ROW_NUMBER() OVER (PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6))  
                                   ORDER BY SUM(oi."sale_price" - p."cost") DESC) AS rn  
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi  
        JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"  p  
             ON oi."product_id" = p."id"  
        WHERE oi."created_at" < 1704067200000000  -- before 2024-01-01  
        GROUP BY DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6)), p."name"  
     ) month_cte  
WHERE rn = 1  
ORDER BY "month_start"  
LIMIT 20;
