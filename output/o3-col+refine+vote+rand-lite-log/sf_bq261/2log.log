```sql
--Description: 1) Peek at a few raw order–item rows (all statuses).
SELECT *
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
LIMIT 20;
```

```sql
--Description: 2) Sample the same rows joined to product master data to show
--              unit cost, sale price and a quick profit calculation.
SELECT 
       oi."order_id",
       oi."product_id",
       p."name"                         AS "product_name",
       p."cost"                         AS "unit_cost",
       oi."sale_price",
       (oi."sale_price" - p."cost")     AS "profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
LIMIT 20;
```

```sql
--Description: 3) Check the distinct life-cycle statuses used in ORDER_ITEMS.
SELECT DISTINCT oi."status"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
LIMIT 20;
```

```sql
--Description: 4) See how product categories and brands look.
SELECT DISTINCT 
       p."category",
       p."brand"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
LIMIT 20;
```

```sql
--Description: 5) Aggregate profit for each product across every order-item 
--              (no date filter yet) to judge data scale.
SELECT 
       oi."product_id",
       COUNT(*)                                 AS "qty",
       SUM(oi."sale_price")                     AS "total_revenue",
       SUM(p."cost")                            AS "total_cost",
       SUM(oi."sale_price" - p."cost")          AS "total_profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
GROUP  BY oi."product_id"
ORDER  BY "total_profit" DESC
LIMIT 20;
```

```sql
--Description: 6) Convert the micro-second epoch to a timestamp just to 
--              understand the real dates inside ORDER_ITEMS.
SELECT 
       oi."created_at",
       TO_TIMESTAMP(oi."created_at" / 1000000)  AS "created_ts"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
LIMIT 20;
```

```sql
--Description: 7) Grab profit aggregated per product per month (sample for 2023)
--              to verify month extraction works.
SELECT 
       DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))    AS "order_month",
       oi."product_id",
       SUM(oi."sale_price" - p."cost")                                 AS "profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
WHERE  TO_TIMESTAMP(oi."created_at" / 1000000) BETWEEN '2023-01-01' AND '2023-12-31 23:59:59'
GROUP  BY 1, 2
ORDER  BY "order_month", "profit" DESC
LIMIT 20;
```

```sql
--Description: 8) Inspect the list of distribution centres (they are not
--              required for profit, but help when validating joins).
SELECT *
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."DISTRIBUTION_CENTERS"
LIMIT 20;
```

```sql
--Description: 9) Look at inventory items together with their cost and the
--              distribution centre that holds them.
SELECT 
       ii."id"                       AS "inventory_item_id",
       ii."product_id",
       dc."name"                     AS "dc_name",
       ii."cost",
       ii."created_at",
       ii."sold_at"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS"        ii
LEFT JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."DISTRIBUTION_CENTERS" dc
       ON ii."product_distribution_center_id" = dc."id"
LIMIT 20;
```

```sql
--Description: 10) Final rich query – for every month prior to Jan-2024,
--               pick the single product with the highest total profit,
--               and report that product’s total cost and total profit.
SELECT *
FROM (
        SELECT 
               DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))      AS "order_month",
               oi."product_id",
               SUM(p."cost")                                                    AS "total_cost",
               SUM(oi."sale_price" - p."cost")                                  AS "total_profit",
               RANK() OVER (
                    PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))
                    ORDER BY SUM(oi."sale_price" - p."cost") DESC
               ) AS "rnk"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
        JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
               ON oi."product_id" = p."id"
        WHERE  TO_TIMESTAMP(oi."created_at" / 1000000) < '2024-01-01'
        GROUP  BY 1, 2
) dq
WHERE dq."rnk" = 1
ORDER BY dq."order_month"
LIMIT 20;
```
