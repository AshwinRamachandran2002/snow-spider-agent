```sql
--Description: Preview a handful of order items, focusing on price and the time-stamp column we will later bucket into months.
SELECT 
    "id",
    "order_id",
    "product_id",
    "sale_price",
    "created_at",
    "status"
FROM 
    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
LIMIT 20;
```

```sql
--Description: Inspect the products table to understand unit “cost”, “retail_price”, and distribution-center linkage.
SELECT 
    "id"            AS "product_id",
    "name",
    "brand",
    "category",
    "department",
    "cost",
    "retail_price"
FROM 
    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS
LIMIT 20;
```

```sql
--Description: Join a small sample of order items with the corresponding product records to calculate profit per item.
SELECT 
    oi."id"                         AS "order_item_id",
    oi."product_id",
    p."name",
    oi."sale_price",
    p."cost",
    (oi."sale_price" - p."cost")    AS "profit",
    oi."created_at"
FROM 
    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN 
    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
ON  oi."product_id" = p."id"
LIMIT 20;
```

```sql
--Description: Look at the distribution of raw “created_at” micro-second epochs to judge how we will derive calendar months.
SELECT 
    MIN("created_at") AS "earliest_created_at",
    MAX("created_at") AS "latest_created_at"
FROM 
    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS;
```

```sql
--Description: Quickly explore how many distinct month buckets appear when dividing epoch by 1,000,000 (seconds) then by 86,400 (days) /30 (~month proxy).  
--(This is only an exploration aid; we will refine in the final query.)
SELECT 
    FLOOR(("created_at")/1000000/86400/30)  AS "rough_month_bucket",
    COUNT(*)                                 AS "row_cnt"
FROM 
    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
GROUP BY 
    1
ORDER BY 
    1
LIMIT 20;
```

```sql
--Description: Compute total cost and total profit per product per month (rough epoch-month) to view magnitudes before ranking.
SELECT
    FLOOR(oi."created_at"/1000000/86400/30)                     AS "month_bucket",
    oi."product_id",
    SUM(p."cost")                                               AS "total_cost",
    SUM(oi."sale_price" - p."cost")                             AS "total_profit"
FROM 
    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN 
    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
ON  oi."product_id" = p."id"
GROUP BY 
    1, 2
ORDER BY 
    1, 4 DESC
LIMIT 20;
```

```sql
--Description: For each month_bucket, identify the product with the maximum total_profit using a window rank.
SELECT
    month_profit."month_bucket",
    month_profit."product_id",
    month_profit."total_cost",
    month_profit."total_profit",
    RANK() OVER (PARTITION BY month_profit."month_bucket" 
                 ORDER BY month_profit."total_profit" DESC) AS "rnk"
FROM (
    SELECT
        FLOOR(oi."created_at"/1000000/86400/30)                AS "month_bucket",
        oi."product_id",
        SUM(p."cost")                                          AS "total_cost",
        SUM(oi."sale_price" - p."cost")                        AS "total_profit"
    FROM 
        THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
    JOIN 
        THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
    ON  oi."product_id" = p."id"
    GROUP BY 
        1, 2
) month_profit
ORDER BY 
    month_profit."month_bucket",
    "rnk"
LIMIT 20;
```

```sql
--Description: Filter to only the top-ranked (rnk = 1) product for each month_bucket.
SELECT *
FROM (
    SELECT
        month_profit."month_bucket",
        month_profit."product_id",
        month_profit."total_cost",
        month_profit."total_profit",
        RANK() OVER (PARTITION BY month_profit."month_bucket"
                     ORDER BY month_profit."total_profit" DESC) AS "rnk"
    FROM (
        SELECT
            FLOOR(oi."created_at"/1000000/86400/30)                 AS "month_bucket",
            oi."product_id",
            SUM(p."cost")                                           AS "total_cost",
            SUM(oi."sale_price" - p."cost")                         AS "total_profit"
        FROM 
            THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
        JOIN 
            THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
        ON  oi."product_id" = p."id"
        GROUP BY 
            1, 2
    ) month_profit
)
WHERE "rnk" = 1
ORDER BY "month_bucket"
LIMIT 20;
```

```sql
--Description: Convert the micro-epoch to a proper calendar month (YYYY-MM) and exclude 2024-01 and beyond.
SELECT
    TO_CHAR(TO_TIMESTAMP_NTZ(("month_bucket_val"*30*86400)) , 'YYYY-MM') AS "month",
    "product_id",
    "total_cost",
    "total_profit"
FROM (
    SELECT
        FLOOR(oi."created_at"/1000000/86400/30)                 AS "month_bucket_val",
        oi."product_id",
        SUM(p."cost")                                           AS "total_cost",
        SUM(oi."sale_price" - p."cost")                         AS "total_profit",
        RANK() OVER (PARTITION BY FLOOR(oi."created_at"/1000000/86400/30)
                     ORDER BY SUM(oi."sale_price" - p."cost") DESC) AS "rnk"
    FROM 
        THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
    JOIN 
        THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
    ON  oi."product_id" = p."id"
    GROUP BY 
        1, 2
) ranked
WHERE "rnk" = 1
  AND TO_CHAR(TO_TIMESTAMP_NTZ(("month_bucket_val"*30*86400)), 'YYYY-MM') < '2024-01'
ORDER BY "month";
```

```sql
--Description: FINAL full query without LIMIT to deliver the requested chronological list (kept here for completeness, but trim with LIMIT 20 if exploring).
SELECT
    TO_CHAR(TO_TIMESTAMP_NTZ(("month_bucket_val"*30*86400)) , 'YYYY-MM') AS "month",
    "product_id",
    "total_cost",
    "total_profit"
FROM (
    SELECT
        FLOOR(oi."created_at"/1000000/86400/30)                 AS "month_bucket_val",
        oi."product_id",
        SUM(p."cost")                                           AS "total_cost",
        SUM(oi."sale_price" - p."cost")                         AS "total_profit",
        RANK() OVER (PARTITION BY FLOOR(oi."created_at"/1000000/86400/30)
                     ORDER BY SUM(oi."sale_price" - p."cost") DESC) AS "rnk"
    FROM 
        THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
    JOIN 
        THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
    ON  oi."product_id" = p."id"
    GROUP BY 
        1, 2
) ranked
WHERE "rnk" = 1
  AND TO_CHAR(TO_TIMESTAMP_NTZ(("month_bucket_val"*30*86400)), 'YYYY-MM') < '2024-01'
ORDER BY "month";
```
