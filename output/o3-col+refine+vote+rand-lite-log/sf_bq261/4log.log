Query:
--Description: Convert the micro-epoch to a proper calendar month (YYYY-MM) and exclude 2024-01 and beyond.
SELECT
    TO_CHAR(TO_TIMESTAMP_NTZ(("month_bucket_val"*30*86400)) , 'YYYY-MM') AS "month",
    "product_id",
    "total_cost",
    "total_profit"
FROM (
    SELECT
        FLOOR(oi."created_at"/1000000/86400/30)                 AS "month_bucket_val",
        oi."product_id",
        SUM(p."cost")                                           AS "total_cost",
        SUM(oi."sale_price" - p."cost")                         AS "total_profit",
        RANK() OVER (PARTITION BY FLOOR(oi."created_at"/1000000/86400/30)
                     ORDER BY SUM(oi."sale_price" - p."cost") DESC) AS "rnk"
    FROM 
        THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
    JOIN 
        THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
    ON  oi."product_id" = p."id"
    GROUP BY 
        1, 2
) ranked
WHERE "rnk" = 1
  AND TO_CHAR(TO_TIMESTAMP_NTZ(("month_bucket_val"*30*86400)), 'YYYY-MM') < '2024-01'
ORDER BY "month";
