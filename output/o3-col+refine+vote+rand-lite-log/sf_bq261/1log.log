```sql
--Description: 1) Peek at a few ORDER_ITEMS rows to understand basic columns, values & the micro-seconds epoch in "created_at".
SELECT *
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
LIMIT 20;
```

```sql
--Description: 2) Look at distinct years/months appearing in ORDER_ITEMS prior to 2024, converting micro-seconds to a month string.
SELECT DISTINCT 
       TO_CHAR(TO_TIMESTAMP_LTZ("created_at", 6), 'YYYY-MM')  AS "order_month"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
WHERE TO_TIMESTAMP_LTZ("created_at", 6) < '2024-01-01'
ORDER BY "order_month"
LIMIT 20;
```

```sql
--Description: 3) Join ORDER_ITEMS to PRODUCTS to view sale price, cost and a calculated per-row profit sample.
SELECT 
       oi."id"                       AS "order_item_id",
       oi."product_id",
       p."name"                      AS "product_name",
       oi."sale_price",
       p."cost"                      AS "product_cost",
       (oi."sale_price" - p."cost")  AS "profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON p."id" = oi."product_id"
LIMIT 20;
```

```sql
--Description: 4) See how many order items each status represents (to confirm we must include every status).
SELECT oi."status", COUNT(*) AS "cnt"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
GROUP  BY oi."status"
ORDER  BY "cnt" DESC
LIMIT 20;
```

```sql
--Description: 5) Aggregate total profit & total cost for each product within one month (sample month 2023-12) to check math.
SELECT 
       p."id"                 AS "product_id",
       p."name"               AS "product_name",
       SUM(p."cost")          AS "total_cost",
       SUM(oi."sale_price" - p."cost")  AS "total_profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON p."id" = oi."product_id"
WHERE  TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at", 6), 'YYYY-MM') = '2023-12'
GROUP  BY p."id", p."name"
ORDER  BY "total_profit" DESC
LIMIT 20;
```

```sql
--Description: 6) For every month (<2024-01) get each product’s totals; QUALIFY a RANK() to keep only the highest profit product per month.
SELECT 
       TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at", 6), 'YYYY-MM')             AS "order_month",
       p."id"                                                               AS "product_id",
       p."name"                                                             AS "product_name",
       SUM(p."cost")                                                        AS "total_cost",
       SUM(oi."sale_price" - p."cost")                                      AS "total_profit",
       RANK() OVER (PARTITION BY TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at",6),'YYYY-MM')
                    ORDER BY SUM(oi."sale_price" - p."cost") DESC)          AS "rnk_profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON p."id" = oi."product_id"
WHERE  TO_TIMESTAMP_LTZ(oi."created_at", 6) < '2024-01-01'
GROUP  BY "order_month", p."id", p."name"
QUALIFY "rnk_profit" = 1
ORDER  BY "order_month"
LIMIT 20;
```

```sql
--Description: 7) Verify that including all statuses (no filter) matches the expected row counts per month.
SELECT 
       TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at", 6), 'YYYY-MM') AS "order_month",
       COUNT(*)                                                 AS "total_order_items"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
WHERE  TO_TIMESTAMP_LTZ(oi."created_at", 6) < '2024-01-01'
GROUP  BY "order_month"
ORDER  BY "order_month"
LIMIT 20;
```

```sql
--Description: 8) Inspect one month’s top-profit product (e.g., 2022-05) in detail across its individual order items.
SELECT 
       oi."id"                      AS "order_item_id",
       oi."order_id",
       p."id"                       AS "product_id",
       p."name"                     AS "product_name",
       oi."sale_price",
       p."cost",
       (oi."sale_price" - p."cost") AS "profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON p."id" = oi."product_id"
WHERE  TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at", 6), 'YYYY-MM') = '2022-05'
  AND  p."id" = (
        SELECT  p2."id"
        FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi2
        JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p2
               ON p2."id" = oi2."product_id"
        WHERE   TO_CHAR(TO_TIMESTAMP_LTZ(oi2."created_at", 6), 'YYYY-MM') = '2022-05'
        GROUP   BY p2."id"
        ORDER   BY SUM(oi2."sale_price" - p2."cost") DESC
        LIMIT 1)
LIMIT 20;
```

```sql
--Description: 9) Confirm distinct PRODUCTS that ever became a monthly top-profit winner prior to 2024.
SELECT DISTINCT
       top_prod."product_id",
       p."name"         AS "product_name"
FROM (
    SELECT 
           TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at", 6), 'YYYY-MM') AS "order_month",
           p."id"                                                  AS "product_id",
           RANK() OVER (PARTITION BY TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at",6),'YYYY-MM')
                        ORDER BY SUM(oi."sale_price" - p."cost") DESC) AS "rnk_profit"
    FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
           ON p."id" = oi."product_id"
    WHERE  TO_TIMESTAMP_LTZ(oi."created_at", 6) < '2024-01-01'
    GROUP  BY "order_month", p."id"
    QUALIFY "rnk_profit" = 1
) top_prod
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
     ON p."id" = top_prod."product_id"
LIMIT 20;
```

```sql
--Description: 10) Final step query (returns all rows, but limited here) producing the exact deliverable: the month, top product, its total cost & total profit, ordered chronologically.
SELECT 
       TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at", 6), 'YYYY-MM')             AS "order_month",
       p."id"                                                               AS "product_id",
       p."name"                                                             AS "product_name",
       SUM(p."cost")                                                        AS "total_cost",
       SUM(oi."sale_price" - p."cost")                                      AS "total_profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON p."id" = oi."product_id"
WHERE  TO_TIMESTAMP_LTZ(oi."created_at", 6) < '2024-01-01'
GROUP  BY "order_month", p."id", p."name"
QUALIFY RANK() OVER (PARTITION BY "order_month"
                     ORDER BY SUM(oi."sale_price" - p."cost") DESC) = 1
ORDER  BY "order_month"
LIMIT 20;
```
