```sql
--Description: 1) Quick look at order-item facts that will drive the profit computation  
SELECT "id",
       "order_id",
       "product_id",
       "sale_price",
       "status",
       "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
LIMIT 20;
```

```sql
--Description: 2) Inspect the product master to get each product’s unit cost (needed for profit)  
SELECT "id"              AS "product_id",
       "name",
       "category",
       "brand",
       "cost",
       "retail_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS
LIMIT 20;
```

```sql
--Description: 3) Join a handful of order items to their products and show the row-level profit  
SELECT oi."id"                         AS "order_item_id",
       oi."product_id",
       p."name"                        AS "product_name",
       oi."sale_price",
       p."cost"                        AS "product_cost",
       (oi."sale_price" - p."cost")    AS "row_profit",
       oi."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
  ON oi."product_id" = p."id"
LIMIT 20;
```

```sql
--Description: 4) Preview monthly profit aggregation at product level (all statuses)  
SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))      AS "month_ts",
       oi."product_id",
       SUM(oi."sale_price")                      AS "total_revenue",
       SUM(p."cost")                             AS "total_cost",     -- cost per item
       SUM(oi."sale_price" - p."cost")           AS "total_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
  ON oi."product_id" = p."id"
GROUP BY 1, 2
ORDER BY 1, 5 DESC
LIMIT 20;
```

```sql
--Description: 5) For every month, rank products by highest total profit  
SELECT month_ts,
       "product_id",
       "total_profit",
       RANK() OVER(PARTITION BY month_ts ORDER BY "total_profit" DESC) AS "profit_rank"
FROM (
       SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS month_ts,
              oi."product_id",
              SUM(oi."sale_price" - p."cost")                            AS "total_profit"
       FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
       JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
         ON oi."product_id" = p."id"
       GROUP BY 1, 2
     ) t
ORDER BY month_ts, "profit_rank"
LIMIT 20;
```

```sql
--Description: 6) List top-profit product per month occurring strictly before 2024-01  
SELECT month_ts,
       "product_id",
       "total_profit"
FROM (
       SELECT month_ts,
              "product_id",
              "total_profit",
              ROW_NUMBER() OVER(PARTITION BY month_ts ORDER BY "total_profit" DESC) AS rn
       FROM (
              SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS month_ts,
                     oi."product_id",
                     SUM(oi."sale_price" - p."cost") AS "total_profit"
              FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
              JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
                ON oi."product_id" = p."id"
              WHERE DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) < '2024-01-01'
              GROUP BY 1, 2
            )
     )
WHERE rn = 1
ORDER BY month_ts
LIMIT 20;
```

```sql
--Description: 7) Verify the list of distinct months available in ORDER_ITEMS data  
SELECT DISTINCT DATE_TRUNC('month', TO_TIMESTAMP("created_at"/1000000)) AS "order_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
ORDER BY "order_month"
LIMIT 20;
```

```sql
--Description: 8) Check inventory table in case its cost differs (sanity check)  
SELECT "id",
       "product_id",
       "product_distribution_center_id",
       "cost",
       "sold_at",
       "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.INVENTORY_ITEMS
LIMIT 20;
```

```sql
--Description: 9) Inspect order-item statuses to confirm inclusion of all records regardless of state  
SELECT DISTINCT "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
LIMIT 20;
```

```sql
--Description: 10) Tie everything together: show full result set of top-profit product per month (pre-2024) with cost, profit and product name  
SELECT month_ts,
       p."name"               AS "product_name",
       total_cost,
       total_profit
FROM (
       SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS month_ts,
              oi."product_id",
              SUM(p."cost")                        AS total_cost,
              SUM(oi."sale_price" - p."cost")      AS total_profit,
              ROW_NUMBER() OVER(PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))
                               ORDER BY SUM(oi."sale_price" - p."cost") DESC) AS rn
       FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
       JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
         ON oi."product_id" = p."id"
       WHERE DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) < '2024-01-01'
       GROUP BY 1, 2
     ) t  
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p
  ON t."product_id" = p."id"
WHERE rn = 1
ORDER BY month_ts
LIMIT 20;
```
