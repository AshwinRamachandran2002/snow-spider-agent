```sql
-- Description: Preview PRODUCTS so we can see every product’s unit cost (needed for profit = sale_price – cost).
SELECT 
    "id"             AS "product_id",
    "name",
    "cost",
    "retail_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS
LIMIT 20;
```

```sql
-- Description: Join ORDER_ITEMS to PRODUCTS for a quick look at line-item profit (sale_price – cost) and confirm the arithmetic.
SELECT 
    oi."id"                      AS "order_item_id",
    oi."product_id",
    p."name"                     AS "product_name",
    oi."sale_price",
    p."cost",
    (oi."sale_price" - p."cost") AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
      ON oi."product_id" = p."id"
LIMIT 20;
```

```sql
-- Description: Aggregate total profit and total cost for every product by calendar month (based on ORDER_ITEMS.created_at).
SELECT
    TO_CHAR(TO_TIMESTAMP(oi."created_at" / 1e6), 'YYYY-MM') AS "month",
    oi."product_id",
    SUM(p."cost")                          AS "total_cost",
    SUM(oi."sale_price" - p."cost")        AS "total_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
      ON oi."product_id" = p."id"
GROUP BY
    TO_CHAR(TO_TIMESTAMP(oi."created_at" / 1e6), 'YYYY-MM'),
    oi."product_id"
LIMIT 20;
```

```sql
-- Description: For each month, rank products by total profit (1 = highest) so we can later pull only rank = 1.
SELECT
    sub."month",
    sub."product_id",
    sub."total_cost",
    sub."total_profit",
    RANK() OVER (PARTITION BY sub."month" ORDER BY sub."total_profit" DESC) AS "profit_rank"
FROM (
    SELECT
        TO_CHAR(TO_TIMESTAMP(oi."created_at" / 1e6), 'YYYY-MM') AS "month",
        oi."product_id",
        SUM(p."cost")                   AS "total_cost",
        SUM(oi."sale_price" - p."cost") AS "total_profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
          ON oi."product_id" = p."id"
    GROUP BY
        TO_CHAR(TO_TIMESTAMP(oi."created_at" / 1e6), 'YYYY-MM'),
        oi."product_id"
) sub
LIMIT 20;
```

```sql
-- Description: Same as previous, but return only the top-profit product (rank = 1) for each month before 2024-01, ordered chronologically.
SELECT *
FROM (
    SELECT
        sub."month",
        sub."product_id",
        sub."total_cost",
        sub."total_profit",
        RANK() OVER (PARTITION BY sub."month" ORDER BY sub."total_profit" DESC) AS "profit_rank"
    FROM (
        SELECT
            TO_CHAR(TO_TIMESTAMP(oi."created_at" / 1e6), 'YYYY-MM') AS "month",
            oi."product_id",
            SUM(p."cost")                   AS "total_cost",
            SUM(oi."sale_price" - p."cost") AS "total_profit"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
        JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
              ON oi."product_id" = p."id"
        GROUP BY
            TO_CHAR(TO_TIMESTAMP(oi."created_at" / 1e6), 'YYYY-MM'),
            oi."product_id"
    ) sub
) ranked
WHERE ranked."profit_rank" = 1
  AND ranked."month" < '2024-01'
ORDER BY ranked."month"
LIMIT 20;
```

```sql
-- Description: Retrieve human-readable product name along with the monthly winner query to make the final report more informative.
SELECT
    r."month",
    r."product_id",
    p."name"             AS "product_name",
    r."total_cost",
    r."total_profit"
FROM (
    SELECT *
    FROM (
        SELECT
            sub."month",
            sub."product_id",
            sub."total_cost",
            sub."total_profit",
            RANK() OVER (PARTITION BY sub."month" ORDER BY sub."total_profit" DESC) AS "profit_rank"
        FROM (
            SELECT
                TO_CHAR(TO_TIMESTAMP(oi."created_at" / 1e6), 'YYYY-MM') AS "month",
                oi."product_id",
                SUM(p."cost")                   AS "total_cost",
                SUM(oi."sale_price" - p."cost") AS "total_profit"
            FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
            JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
                  ON oi."product_id" = p."id"
            GROUP BY
                TO_CHAR(TO_TIMESTAMP(oi."created_at" / 1e6), 'YYYY-MM'),
                oi."product_id"
        ) sub
    ) ranked
    WHERE ranked."profit_rank" = 1
      AND ranked."month" < '2024-01'
) r
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p
     ON r."product_id" = p."id"
ORDER BY r."month"
LIMIT 20;
```

```sql
-- Description: Quick distinct list of all months available in ORDER_ITEMS before 2024-01 to ensure no gaps.
SELECT DISTINCT 
    TO_CHAR(TO_TIMESTAMP("created_at" / 1e6), 'YYYY-MM') AS "month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
WHERE TO_CHAR(TO_TIMESTAMP("created_at" / 1e6), 'YYYY-MM') < '2024-01'
ORDER BY "month"
LIMIT 20;
```

```sql
-- Description: Inspect a full month (e.g., 2023-12) to validate profit calculations for a single product winner.
SELECT
    oi."product_id",
    p."name"                     AS "product_name",
    COUNT(*)                     AS "items_sold",
    SUM(p."cost")                AS "total_cost",
    SUM(oi."sale_price")         AS "total_revenue",
    SUM(oi."sale_price" - p."cost") AS "total_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
      ON oi."product_id" = p."id"
WHERE TO_CHAR(TO_TIMESTAMP(oi."created_at" / 1e6), 'YYYY-MM') = '2023-12'
GROUP BY oi."product_id", p."name"
ORDER BY "total_profit" DESC
LIMIT 20;
```
