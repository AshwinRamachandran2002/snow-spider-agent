Query:
--Description: Compute an exponential moving average (EMA, α = 0.2) of annual filings for ONE sample CPC to ensure formula works  
WITH yearly AS (
    SELECT FLOOR(t."filing_date"/10000) AS "year",
           COUNT(*)                      AS "filings"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc") f
    WHERE f.index = 0
      AND f.value:"code"::STRING = 'H04L9/0844'   --sample CPC
      AND t."filing_date" > 0
      AND COALESCE(t."application_number",'') <> ''
    GROUP BY "year"
)
SELECT "year",
       "filings",
       -- EMA_t = 0.2*filings + 0.8*EMA_{t-1}
       SUM(0.2 * "filings") OVER (
           ORDER BY "year"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
       )
       -
       SUM(0.8 * 0.2 * "filings") OVER (
           ORDER BY "year"
           ROWS BETWEEN 1 PRECEDING AND CURRENT ROW
       ) AS "ema_alpha_0_2"
FROM yearly
ORDER BY "year"
LIMIT 20;
