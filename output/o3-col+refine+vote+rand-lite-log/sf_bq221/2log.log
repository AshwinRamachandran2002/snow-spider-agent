    WHERE f.index = 0
      AND t."filing_date" > 0
      AND COALESCE(t."application_number",'') <> ''
    GROUP BY "year", "first_cpc_code"
),
ema AS (          --exponential moving average with α = 0.2
    SELECT "year",
           "first_cpc_code",
           "filings",
           --EMA via recursive window sum
           SUM(0.2 * "filings") OVER (PARTITION BY "first_cpc_code"
                                       ORDER BY "year"
                                       ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
           -
           SUM(0.8 * 0.2 * "filings") OVER (PARTITION BY "first_cpc_code"
                                             ORDER BY "year"
                                             ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)          AS "ema_0_2"
    FROM yearly
),
best_year AS (    --highest EMA per CPC
    SELECT "first_cpc_code",
           MAX_BY("year","ema_0_2")    AS "best_year",
           MAX("ema_0_2")              AS "max_ema"
    FROM ema
    GROUP BY "first_cpc_code"
)
SELECT b."first_cpc_code",
       d."titleFull",
       b."best_year",
       b."max_ema"
FROM best_year b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b."first_cpc_code"
ORDER BY b."max_ema" DESC
LIMIT 20;
