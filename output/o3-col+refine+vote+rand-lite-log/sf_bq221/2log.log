```sql
--Description: Match first-CPC counts with their level-5 group title (simple equality join) to view sample results  
SELECT cpc_yearly."year",
       cpc_yearly."first_cpc_code",
       d."titleFull",
       cpc_yearly."patent_filings"
FROM (
    SELECT FLOOR(t."filing_date"/10000)          AS "year",
           f.value:"code"::STRING               AS "first_cpc_code",
           COUNT(*)                             AS "patent_filings"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc") f
    WHERE f.index = 0
      AND t."filing_date" > 0
      AND COALESCE(t."application_number",'') <> ''
    GROUP BY "year", "first_cpc_code"
) cpc_yearly
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = cpc_yearly."first_cpc_code"
LIMIT 20;
```

```sql
--Description: Compute an exponential moving average (EMA, α = 0.2) of annual filings for ONE sample CPC to ensure formula works  
WITH yearly AS (
    SELECT FLOOR(t."filing_date"/10000) AS "year",
           COUNT(*)                      AS "filings"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc") f
    WHERE f.index = 0
      AND f.value:"code"::STRING = 'H04L9/0844'   --sample CPC
      AND t."filing_date" > 0
      AND COALESCE(t."application_number",'') <> ''
    GROUP BY "year"
)
SELECT "year",
       "filings",
       -- EMA_t = 0.2*filings + 0.8*EMA_{t-1}
       SUM(0.2 * "filings") OVER (
           ORDER BY "year"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
       )
       -
       SUM(0.8 * 0.2 * "filings") OVER (
           ORDER BY "year"
           ROWS BETWEEN 1 PRECEDING AND CURRENT ROW
       ) AS "ema_alpha_0_2"
FROM yearly
ORDER BY "year"
LIMIT 20;
```

```sql
--Description: Bring everything together: compute EMA(α = 0.2) for every first-CPC, pick the best year (highest EMA) per CPC, and attach level-5 title  
WITH yearly AS (  --annual counts per CPC
    SELECT FLOOR(t."filing_date"/10000) AS "year",
           f.value:"code"::STRING       AS "first_cpc_code",
           COUNT(*)                     AS "filings"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc") f
    WHERE f.index = 0
      AND t."filing_date" > 0
      AND COALESCE(t."application_number",'') <> ''
    GROUP BY "year", "first_cpc_code"
),
ema AS (          --exponential moving average with α = 0.2
    SELECT "year",
           "first_cpc_code",
           "filings",
           --EMA via recursive window sum
           SUM(0.2 * "filings") OVER (PARTITION BY "first_cpc_code"
                                       ORDER BY "year"
                                       ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
           -
           SUM(0.8 * 0.2 * "filings") OVER (PARTITION BY "first_cpc_code"
                                             ORDER BY "year"
                                             ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)          AS "ema_0_2"
    FROM yearly
),
best_year AS (    --highest EMA per CPC
    SELECT "first_cpc_code",
           MAX_BY("year","ema_0_2")    AS "best_year",
           MAX("ema_0_2")              AS "max_ema"
    FROM ema
    GROUP BY "first_cpc_code"
)
SELECT b."first_cpc_code",
       d."titleFull",
       b."best_year",
       b."max_ema"
FROM best_year b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b."first_cpc_code"
ORDER BY b."max_ema" DESC
LIMIT 20;
```
