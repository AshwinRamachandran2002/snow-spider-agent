Query:
--Description: Build yearly publication counts for every CPC level-5 (first CPC code only).
WITH first_cpc AS (
    SELECT
        REGEXP_SUBSTR(
            c.value:"code"::STRING ,
            '^[A-Z][0-9]{2}[A-Z][0-9]/[0-9]{2}'
        )                              AS "cpc_lvl5",
        FLOOR(p."filing_date" / 10000) AS "filing_year"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c
    WHERE c.index = 0
      AND p."application_number" IS NOT NULL
      AND p."filing_date" > 0
)
SELECT
    "cpc_lvl5",
    "filing_year",
    COUNT(*) AS "pub_cnt"
FROM first_cpc
WHERE "cpc_lvl5" IS NOT NULL
GROUP BY 1, 2
ORDER BY 1, 2
LIMIT 20
