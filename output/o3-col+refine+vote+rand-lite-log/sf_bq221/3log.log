Query:
--Description: For every CPC level-5 group, compute the EMA (α = 0.2) of yearly counts
--             and keep the year with the highest EMA (“best_year”).
WITH yearly AS (
    SELECT
        REGEXP_SUBSTR(
            c.value:"code"::STRING ,
            '^[A-Z][0-9]{2}[A-Z][0-9]/[0-9]{2}'
        )                              AS "cpc_lvl5",
        FLOOR(p."filing_date" / 10000) AS "year",
        COUNT(*)                       AS "pub_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c
    WHERE c.index = 0
      AND p."application_number" IS NOT NULL
      AND p."filing_date" > 0
    GROUP BY 1, 2
    HAVING "cpc_lvl5" IS NOT NULL
), ordered AS (
    SELECT
        y.*,
        ROW_NUMBER() OVER (PARTITION BY "cpc_lvl5" ORDER BY "year") AS rn
    FROM yearly y
), max_rn AS (
    SELECT "cpc_lvl5", MAX(rn) AS max_rn
    FROM ordered
    GROUP BY 1
), ema AS (
    SELECT
        o."cpc_lvl5",
        o."year",
        o."pub_cnt",
        SUM( 0.2 * o."pub_cnt" * POWER(0.8, m.max_rn - o.rn) )
            OVER (PARTITION BY o."cpc_lvl5"
                  ORDER BY o.rn ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "ema_0_2"
    FROM ordered o
    JOIN max_rn m
      ON m."cpc_lvl5" = o."cpc_lvl5"
)
SELECT
    e."cpc_lvl5",
    e."year"       AS "best_year",
    e."ema_0_2"
FROM (
    SELECT
        ema.*,
        ROW_NUMBER() OVER (PARTITION BY "cpc_lvl5" ORDER BY "ema_0_2" DESC) AS rk
    FROM ema
) e
WHERE e.rk = 1
LIMIT 20
