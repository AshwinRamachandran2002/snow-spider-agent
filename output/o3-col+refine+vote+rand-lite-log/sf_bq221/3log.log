Query:
--Description: Attach CPC full titles to the “best year” EMA results for interpretation.
WITH yearly AS (
    SELECT
        REGEXP_SUBSTR(
            c.value:"code"::STRING ,
            '^[A-Z][0-9]{2}[A-Z][0-9]/[0-9]{2}'
        )                              AS "cpc_lvl5",
        FLOOR(p."filing_date" / 10000) AS "year",
        COUNT(*)                       AS "pub_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c
    WHERE c.index = 0
      AND p."application_number" IS NOT NULL
      AND p."filing_date" > 0
    GROUP BY 1, 2
    HAVING "cpc_lvl5" IS NOT NULL
), ordered AS (
    SELECT
        y.*,
        ROW_NUMBER() OVER (PARTITION BY "cpc_lvl5" ORDER BY "year") AS rn
    FROM yearly y
), max_rn AS (
    SELECT "cpc_lvl5", MAX(rn) AS max_rn
    FROM ordered
    GROUP BY 1
), ema AS (
    SELECT
        o."cpc_lvl5",
        o."year",
        o."pub_cnt",
        SUM( 0.2 * o."pub_cnt" * POWER(0.8, m.max_rn - o.rn) )
            OVER (PARTITION BY o."cpc_lvl5"
                  ORDER BY o.rn ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "ema_0_2"
    FROM ordered o
    JOIN max_rn m
      ON m."cpc_lvl5" = o."cpc_lvl5"
), best AS (
    SELECT
        e.*,
        ROW_NUMBER() OVER (PARTITION BY "cpc_lvl5" ORDER BY "ema_0_2" DESC) AS rk
    FROM ema e
)
SELECT
    b."cpc_lvl5",
    d."titleFull"    AS "cpc_full_title",
    b."year"         AS "best_year",
    b."ema_0_2"
FROM best b
JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON d."symbol" = b."cpc_lvl5"
WHERE b.rk = 1
LIMIT 20
