```sql
--Description: Calculate the exponential moving average (α = 0.2) of yearly counts for one CPC code
WITH yearly AS (
    SELECT 
        FLOOR(p."filing_date"/10000) AS "year",
        COUNT(*)                     AS "pub_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c
    WHERE c.index = 0
      AND p."application_number" IS NOT NULL
      AND p."filing_date" > 0
      AND c.value:"code"::STRING = 'H04L9/08'
    GROUP BY 1
), ordered AS (
    SELECT 
        "year",
        "pub_cnt",
        ROW_NUMBER() OVER (ORDER BY "year") AS rn
    FROM yearly
)
SELECT 
    o."year",
    o."pub_cnt",
    -- recursive-type EMA via running sum of weighted counts
    SUM( (0.2) * "pub_cnt" * POWER(0.8, (MAX(rn) OVER() - rn)) )
        OVER (ORDER BY rn ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "ema_alpha_0_2"
FROM ordered o
ORDER BY "year"
LIMIT 20;
```

```sql
--Description: Build yearly counts for ALL CPC codes (FIRST code only, truncate to group at level-5, e.g., keep portion before second '/')
WITH first_cpc AS (
    SELECT 
        REGEXP_SUBSTR(
            c.value:"code"::STRING , '^[A-Z][0-9]{2}[A-Z][0-9]/[0-9]{2}'
        )                              AS "cpc_lvl5",
        FLOOR(p."filing_date"/10000)   AS "filing_year"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c
    WHERE c.index = 0
      AND p."application_number" IS NOT NULL
      AND p."filing_date" > 0
)
SELECT 
    "cpc_lvl5",
    "filing_year",
    COUNT(*) AS "pub_cnt"
FROM first_cpc
GROUP BY 1,2
HAVING "cpc_lvl5" IS NOT NULL
ORDER BY 1,2
LIMIT 20;
```

```sql
--Description: For every CPC-level-5, compute EMA (α = 0.2) across years and pick year of highest EMA
WITH yearly AS (
    SELECT 
        REGEXP_SUBSTR(
            c.value:"code"::STRING , '^[A-Z][0-9]{2}[A-Z][0-9]/[0-9]{2}'
        )                              AS "cpc_lvl5",
        FLOOR(p."filing_date"/10000)   AS "year",
        COUNT(*)                       AS "pub_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c
    WHERE c.index = 0
      AND p."application_number" IS NOT NULL
      AND p."filing_date" > 0
    GROUP BY 1,2
    HAVING "cpc_lvl5" IS NOT NULL
), ordered AS (
    SELECT 
        y.*,
        ROW_NUMBER() OVER (PARTITION BY "cpc_lvl5" ORDER BY "year") AS rn,
        COUNT(*)     OVER (PARTITION BY "cpc_lvl5")                 AS n_years
    FROM yearly y
), ema AS (
    SELECT 
        o.*,
        SUM( (0.2) * "pub_cnt" * POWER(0.8, (n_years - rn)) )
            OVER (PARTITION BY "cpc_lvl5"
                  ORDER BY rn ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "ema_0_2"
    FROM ordered o
)
SELECT 
    "cpc_lvl5",
    "year"          AS "best_year",
    "ema_0_2"
FROM (
    SELECT 
        e.*,
        ROW_NUMBER() OVER (PARTITION BY "cpc_lvl5" ORDER BY "ema_0_2" DESC) AS rk
    FROM ema e
) t
WHERE rk = 1
LIMIT 20;
```

```sql
--Description: Combine the “best year” result with CPC full titles for interpretation
WITH best AS (
    /* Paste the query from step 9 here or reference it as a CTE */
    SELECT 
        "cpc_lvl5",
        "year"  AS "best_year",
        "ema_0_2"
    FROM (
        /* step-9 logic */
        SELECT 
            e.*,
            ROW_NUMBER() OVER (PARTITION BY "cpc_lvl5" ORDER BY "ema_0_2" DESC) AS rk
        FROM (
            /* ordered + ema logic from step-9 */
            SELECT 
                o.*,
                SUM( (0.2) * "pub_cnt" * POWER(0.8, (n_years - rn)) )
                    OVER (PARTITION BY "cpc_lvl5"
                          ORDER BY rn ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "ema_0_2"
            FROM (
                SELECT 
                    y.*,
                    ROW_NUMBER() OVER (PARTITION BY "cpc_lvl5" ORDER BY "year") AS rn,
                    COUNT(*)     OVER (PARTITION BY "cpc_lvl5")                 AS n_years
                FROM (
                    SELECT 
                        REGEXP_SUBSTR(
                            c.value:"code"::STRING , '^[A-Z][0-9]{2}[A-Z][0-9]/[0-9]{2}'
                        )                            AS "cpc_lvl5",
                        FLOOR(p."filing_date"/10000) AS "year",
                        COUNT(*)                     AS "pub_cnt"
                    FROM PATENTS.PATENTS.PUBLICATIONS p,
                         LATERAL FLATTEN(input => p."cpc") c
                    WHERE c.index = 0
                      AND p."application_number" IS NOT NULL
                      AND p."filing_date" > 0
                    GROUP BY 1,2
                    HAVING "cpc_lvl5" IS NOT NULL
                ) y
            ) o
        ) e
    ) 
    WHERE rk = 1
)
SELECT 
    b."cpc_lvl5",
    d."titleFull"   AS "cpc_full_title",
    b."best_year",
    b."ema_0_2"
FROM best b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b."cpc_lvl5"
LIMIT 20;
```
