/*  CPC technology areas (5-character group) whose patent-filing activity,
    measured with an exponential moving-average (α = 0.2),
    reaches its maximum (“best year”).                                    */

WITH first_cpc AS (      -- keep only the *first* CPC code per patent
    SELECT
        REGEXP_SUBSTR(f.value:"code"::STRING , '^[A-Z][0-9]{2}[A-Z][0-9]') AS "cpc_group_5",
        FLOOR(p."filing_date" / 10000)                                     AS "filing_year"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN (INPUT => p."cpc") f
    WHERE p."application_number" <> ''          -- must have application #
      AND p."filing_date"        IS NOT NULL    -- keep dated filings
      AND f.value:"first"::BOOLEAN = TRUE       -- first CPC only
),

yearly AS (            -- count filings per CPC group & year
    SELECT
        "cpc_group_5",
        "filing_year",
        COUNT(*) AS "yearly_filings"
    FROM first_cpc
    GROUP BY "cpc_group_5","filing_year"
),

seq AS (               -- chronological index inside each group
    SELECT
        y.*,
        ROW_NUMBER() OVER (PARTITION BY y."cpc_group_5"
                           ORDER BY y."filing_year") AS "rn"
    FROM yearly y
),

ema AS (               -- exponential moving-average with α = 0.2
    SELECT
        a."cpc_group_5",
        a."filing_year",
        SUM(b."yearly_filings"
            * POWER(0.8 , a."rn" - b."rn")) * 0.2       AS "ema_alpha_0_2"
    FROM seq a
    JOIN seq b
      ON a."cpc_group_5" = b."cpc_group_5"
     AND b."rn"         <= a."rn"
    GROUP BY a."cpc_group_5", a."filing_year", a."rn"
),

best_per_group AS (    -- pick the year with the highest EMA per group
    SELECT
        "cpc_group_5",
        "filing_year"   AS "best_year",
        "ema_alpha_0_2" AS "highest_ema",
        ROW_NUMBER() OVER (PARTITION BY "cpc_group_5"
                           ORDER BY "ema_alpha_0_2" DESC, "filing_year") AS "rk"
    FROM ema
)

SELECT
    b."cpc_group_5",
    FIRST_VALUE(d."titleFull") OVER (PARTITION BY b."cpc_group_5"
                                     ORDER BY d."level" NULLS LAST) AS "cpc_full_title",
    b."best_year",
    ROUND(b."highest_ema", 4)                                       AS "highest_ema"
FROM best_per_group b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b."cpc_group_5"
        OR d."symbol" LIKE b."cpc_group_5" || '/%'
WHERE b."rk" = 1                       -- keep only the maximal EMA per group
ORDER BY b."highest_ema" DESC NULLS LAST;
```
