```

```sql
--Description: 3) Flatten the CPC array and list individual CPC objects to see their structure
SELECT  p."publication_number",
        f.value                                                   AS "cpc_object"
FROM    PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."cpc") f
WHERE   p."application_number" <> ''
  AND   p."filing_date"        IS NOT NULL
LIMIT 20;
```

```sql
--Description: 4) Extract only the *first* CPC code for each publication
SELECT  p."publication_number",
        f.value:"code"::STRING                                    AS "cpc_code",
        f.value:"first"::BOOLEAN                                  AS "is_first"
FROM    PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."cpc") f
WHERE   p."application_number" <> ''
  AND   p."filing_date"        IS NOT NULL
  AND   f.value:"first"::BOOLEAN = TRUE
LIMIT 20;
```

```sql
--Description: 5) Convert the first CPC code to its 5-character *group* level (before the slash)
SELECT  DISTINCT
        REGEXP_SUBSTR(f.value:"code"::STRING , '^[A-Z][0-9]{2}[A-Z]') || SUBSTR(f.value:"code"::STRING , 4 ,1)  AS "cpc_group_5",
        f.value:"code"::STRING                                         AS "full_cpc_code"
FROM    PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."cpc") f
WHERE   p."application_number" <> ''
  AND   p."filing_date"        IS NOT NULL
  AND   f.value:"first"::BOOLEAN = TRUE
LIMIT 20;
```

```sql
--Description: 6) Count filings per CPC group & year (year = filing_date ÷ 10000)
WITH first_cpc AS (
  SELECT  REGEXP_SUBSTR(f.value:"code"::STRING , '^[A-Z][0-9]{2}[A-Z][0-9]')          AS "cpc_group_5",
          FLOOR(p."filing_date"/10000)                                                AS "filing_year"
  FROM    PATENTS.PATENTS.PUBLICATIONS p,
          LATERAL FLATTEN(input => p."cpc") f
  WHERE   p."application_number" <> ''
    AND   p."filing_date" IS NOT NULL
    AND   f.value:"first"::BOOLEAN = TRUE
)
SELECT  "cpc_group_5",
        "filing_year",
        COUNT(*)                                                                      AS "yearly_filings"
FROM    first_cpc
GROUP BY "cpc_group_5","filing_year"
ORDER BY "cpc_group_5","filing_year"
LIMIT 20;
```

```sql
--Description: 7) Add row numbers per group to prepare for an exponential moving-average (EMA) calculation
WITH counts AS (
  SELECT  "cpc_group_5",
          "filing_year",
          COUNT(*)                                                                    AS "yearly_filings"
  FROM   (
          SELECT  REGEXP_SUBSTR(f.value:"code"::STRING , '^[A-Z][0-9]{2}[A-Z][0-9]')  AS "cpc_group_5",
                  FLOOR(p."filing_date"/10000)                                        AS "filing_year"
          FROM    PATENTS.PATENTS.PUBLICATIONS p,
                  LATERAL FLATTEN(input => p."cpc") f
          WHERE   p."application_number" <> ''
            AND   p."filing_date" IS NOT NULL
            AND   f.value:"first"::BOOLEAN = TRUE
        )
  GROUP BY "cpc_group_5","filing_year"
)
SELECT  "cpc_group_5",
        "filing_year",
        "yearly_filings",
        ROW_NUMBER() OVER (PARTITION BY "cpc_group_5" ORDER BY "filing_year")         AS "rn"
FROM    counts
ORDER BY "cpc_group_5","filing_year"
LIMIT 20;
```

```sql
--Description: 8) Compute the EMA (α = 0.2) for each group & year using an exponential-decay window
WITH counts AS (
  SELECT  "cpc_group_5",
          "filing_year",
          COUNT(*)                                                                    AS "yearly_filings"
  FROM   (
          SELECT  REGEXP_SUBSTR(f.value:"code"::STRING , '^[A-Z][0-9]{2}[A-Z][0-9]')  AS "cpc_group_5",
                  FLOOR(p."filing_date"/10000)                                        AS "filing_year"
          FROM    PATENTS.PATENTS.PUBLICATIONS p,
                  LATERAL FLATTEN(input => p."cpc") f
          WHERE   p."application_number" <> ''
            AND   p."filing_date" IS NOT NULL
            AND   f.value:"first"::BOOLEAN = TRUE
        )
  GROUP BY "cpc_group_5","filing_year"
),
seq AS (
  SELECT  c.*,
          ROW_NUMBER() OVER (PARTITION BY "cpc_group_5" ORDER BY "filing_year")       AS "rn"
  FROM    counts c
),
ema AS (
  SELECT  a."cpc_group_5",
          a."filing_year",
          SUM(b."yearly_filings" * POWER(0.8 , a."rn" - b."rn")) * 0.2               AS "ema_alpha_point2"
  FROM    seq a
  JOIN    seq b
    ON    a."cpc_group_5" = b."cpc_group_5"
   AND    b."rn"            <= a."rn"
  GROUP BY a."cpc_group_5",a."filing_year",a."rn"
)
SELECT  *
FROM    ema
ORDER BY "ema_alpha_point2" DESC
LIMIT 20;
```

```sql
--Description: 9) For each CPC group, find the best (highest-EMA) year
WITH ema AS (
  /* identical CTEs as previous query */
  WITH counts AS (
    SELECT  "cpc_group_5",
            "filing_year",
            COUNT(*)                                                                  AS "yearly_filings"
    FROM   (
            SELECT  REGEXP_SUBSTR(f.value:"code"::STRING , '^[A-Z][0-9]{2}[A-Z][0-9]') AS "cpc_group_5",
                    FLOOR(p."filing_date"/10000)                                       AS "filing_year"
            FROM    PATENTS.PATENTS.PUBLICATIONS p,
                    LATERAL FLATTEN(input => p."cpc") f
            WHERE   p."application_number" <> ''
              AND   p."filing_date" IS NOT NULL
              AND   f.value:"first"::BOOLEAN = TRUE
          )
    GROUP BY "cpc_group_5","filing_year"
  ),
  seq AS (
    SELECT  c.*,
            ROW_NUMBER() OVER (PARTITION BY "cpc_group_5" ORDER BY "filing_year")     AS "rn"
    FROM    counts c
  )
  SELECT  a."cpc_group_5",
          a."filing_year",
          SUM(b."yearly_filings" * POWER(0.8 , a."rn" - b."rn")) * 0.2               AS "ema_alpha_point2"
  FROM    seq a
  JOIN    seq b
    ON    a."cpc_group_5" = b."cpc_group_5"
   AND    b."rn"            <= a."rn"
  GROUP BY a."cpc_group_5",a."filing_year",a."rn"
)
SELECT  e."cpc_group_5",
        e."filing_year"                 AS "best_year",
        e."ema_alpha_point2"            AS "highest_ema"
FROM    (
        SELECT  *,
                ROW_NUMBER() OVER (PARTITION BY "cpc_group_5"
                                   ORDER BY "ema_alpha_point2" DESC) AS "rk"
        FROM    ema
       ) e
WHERE   e."rk" = 1
ORDER BY e."highest_ema" DESC
LIMIT 20;
```

```sql
--Description: 10) Attach the full CPC title from CPC_DEFINITION for each group’s best year
WITH best AS (
  /* reuse query 9 but stop before LIMIT */
  WITH ema AS (
    WITH counts AS (
      SELECT  "cpc_group_5",
              "filing_year",
              COUNT(*)                                                              AS "yearly_filings"
      FROM   (
              SELECT  REGEXP_SUBSTR(f.value:"code"::STRING , '^[A-Z][0-9]{2}[A-Z][0-9]') AS "cpc_group_5",
                      FLOOR(p."filing_date"/10000)                                     AS "filing_year"
              FROM    PATENTS.PATENTS.PUBLICATIONS p,
                      LATERAL FLATTEN(input => p."cpc") f
              WHERE   p."application_number" <> ''
                AND   p."filing_date" IS NOT NULL
                AND   f.value:"first"::BOOLEAN = TRUE
            )
      GROUP BY "cpc_group_5","filing_year"
    ),
    seq AS (
      SELECT  c.*,
              ROW_NUMBER() OVER (PARTITION BY "cpc_group_5" ORDER BY "filing_year")   AS "rn"
      FROM    counts c
    )
    SELECT  a."cpc_group_5",
            a."filing_year",
            SUM(b."yearly_filings" * POWER(0.8 , a."rn" - b."rn")) * 0.2             AS "ema_alpha_point2"
    FROM    seq a
    JOIN    seq b
      ON    a."cpc_group_5" = b."cpc_group_5"
     AND    b."rn"            <= a."rn"
    GROUP BY a."cpc_group_5",a."filing_year",a."rn"
  )
  SELECT  e."cpc_group_5",
          e."filing_year"                       AS "best_year",
          e."ema_alpha_point2"                  AS "highest_ema"
  FROM    (
          SELECT  *,
                  ROW_NUMBER() OVER (PARTITION BY "cpc_group_5"
                                     ORDER BY "ema_alpha_point2" DESC) AS "rk"
          FROM    ema
         ) e
  WHERE   e."rk" = 1
)
SELECT  b."cpc_group_5",
        d."titleFull"                           AS "cpc_full_title",
        b."best_year",
        b."highest_ema"
FROM    best b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON  d."symbol" LIKE b."cpc_group_5" || '/%'
ORDER BY b."highest_ema" DESC
LIMIT 20;
```
