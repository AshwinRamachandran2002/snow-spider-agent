--Description:
-- THINKING PROCESS (inline comments):
--  A.  Derive 5-character CPC group code (e.g. “H01L2”) from the *first* CPC entry
--      for each patent publication that has both a filing_date and an application_number.
--  B.  Count filings per (CPC-group, year).  Year = filing_date DIV 10000 (numeric YYYYMMDD → YYYY).
--  C.  Within each CPC group, assign a chronological row number (rn) so we can measure the
--      distance between years.  The Exponential Moving Average (EMA, α = 0.2) weight for a
--      previous year k steps back is 0.2 × 0.8ᵏ.
--  D.  Compute EMA for every (group,year) by summing the weighted prior counts.
--  E.  Rank years inside each CPC group by EMA and keep the highest (rk = 1) — that is
--      the “best year”.
--  F.  Join to CPC_DEFINITION to fetch a human-readable CPC title (titleFull) for the group.
--  G.  Return top groups by EMA.
WITH counts AS (                 -- 1) yearly filing counts
    SELECT
        REGEXP_SUBSTR(f.value:"code"::STRING, '^[A-Z][0-9]{2}[A-Z][0-9]')   AS "cpc_group_5",
        FLOOR(p."filing_date" / 10000)                                      AS "filing_year",
        COUNT(*)                                                            AS "yearly_filings"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."application_number" <> ''
      AND p."filing_date"        IS NOT NULL
      AND f.value:"first"::BOOLEAN = TRUE
    GROUP BY "cpc_group_5", "filing_year"
), seq AS (                        -- 2) add sequential index per group
    SELECT
        c.*,
        ROW_NUMBER() OVER (PARTITION BY c."cpc_group_5"
                           ORDER BY c."filing_year")                        AS "rn"
    FROM counts c
), ema AS (                        -- 3) exponential moving average α = 0.2
    SELECT
        a."cpc_group_5",
        a."filing_year",
        SUM(b."yearly_filings" * POWER(0.8, a."rn" - b."rn")) * 0.2         AS "ema_alpha_0_2"
    FROM seq a
    JOIN seq b
      ON a."cpc_group_5" = b."cpc_group_5"
     AND b."rn"        <= a."rn"
    GROUP BY a."cpc_group_5", a."filing_year", a."rn"
), ranked AS (                      -- 4) pick highest-EMA year per group
    SELECT
        e.*,
        ROW_NUMBER() OVER (PARTITION BY e."cpc_group_5"
                           ORDER BY e."ema_alpha_0_2" DESC) AS "rk"
    FROM ema e
), best AS (
    SELECT
        "cpc_group_5",
        "filing_year"      AS "best_year",
        "ema_alpha_0_2"    AS "highest_ema"
    FROM ranked
    WHERE "rk" = 1
)
SELECT
    b."cpc_group_5",
    FIRST_VALUE(d."titleFull") OVER (PARTITION BY b."cpc_group_5"
                                     ORDER BY d."level" NULLS LAST)  AS "cpc_full_title",
    b."best_year",
    b."highest_ema"
FROM best b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" LIKE b."cpc_group_5" || '/%'      -- match the group in CPC hierarchy
ORDER BY b."highest_ema" DESC
LIMIT 20;
```
