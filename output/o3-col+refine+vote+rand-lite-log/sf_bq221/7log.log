Query:
--Description: Attach a human-readable CPC title to each CPC-5 group’s “best year”
--             (highest exponential moving-average of filings, α = 0.2).
--             This is the corrected version of the prior query: it aligns the
--             EMA column name (ema_alpha_0_2) consistently throughout and
--             safeguards the title selection with FIRST_VALUE in case a group
--             matches multiple definition rows.
WITH counts AS (            -- yearly filing totals for the first-CPC code
    SELECT
        REGEXP_SUBSTR(f.value:"code"::STRING , '^[A-Z][0-9]{2}[A-Z][0-9]') AS "cpc_group_5",
        FLOOR(p."filing_date" / 10000)                                     AS "filing_year",
        COUNT(*)                                                           AS "yearly_filings"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN (input => p."cpc") f
    WHERE p."application_number" <> ''
      AND p."filing_date"        IS NOT NULL
      AND f.value:"first"::BOOLEAN = TRUE
    GROUP BY "cpc_group_5","filing_year"
), seq AS (                 -- chronological index per group
    SELECT
        c.*,
        ROW_NUMBER() OVER (PARTITION BY c."cpc_group_5"
                           ORDER BY c."filing_year")                      AS "rn"
    FROM counts c
), ema AS (                 -- exponential moving average  α = 0.2
    SELECT
        a."cpc_group_5",
        a."filing_year",
        SUM(b."yearly_filings" * POWER(0.8 , a."rn" - b."rn")) * 0.2      AS "ema_alpha_0_2"
    FROM seq a
    JOIN seq b
      ON a."cpc_group_5" = b."cpc_group_5"
     AND b."rn"        <= a."rn"
    GROUP BY a."cpc_group_5", a."filing_year", a."rn"
), ranked AS (             -- pick highest EMA per group
    SELECT
        e.*,
        ROW_NUMBER() OVER (PARTITION BY e."cpc_group_5"
                           ORDER BY e."ema_alpha_0_2" DESC) AS "rk"
    FROM ema e
), best AS (               -- keep rk = 1
    SELECT
        "cpc_group_5",
        "filing_year"   AS "best_year",
        "ema_alpha_0_2" AS "highest_ema"
    FROM ranked
    WHERE "rk" = 1
)
SELECT
    b."cpc_group_5",
    FIRST_VALUE(d."titleFull") OVER (PARTITION BY b."cpc_group_5"
                                     ORDER BY d."level" NULLS LAST) AS "cpc_full_title",
    b."best_year",
    b."highest_ema"
FROM best b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" LIKE b."cpc_group_5" || '/%'      -- match definitions under that group
ORDER BY b."highest_ema" DESC
LIMIT 20
