/*  ──────────────────────────────────────────────────────────────────────────
    Best (highest-EMA) filing year for every CPC 5-character technology group
    ▸ EMA uses α = 0.2  ⇒  EMAᵗ = 0.2·xᵗ  +  0.8·EMAᵗ⁻¹
    ▸ Only the “first” CPC code of each patent (PUBLICATIONS) is considered
    ▸ PUBLICATIONS rows must contain a filing-date and non-empty application #
    ────────────────────────────────────────────────────────────────────────── */

WITH first_cpc AS (                      -- 1. isolate first-listed CPC code
    SELECT
        REGEXP_SUBSTR(f.value:"code"::STRING ,
                      '^[A-Z][0-9]{2}[A-Z][0-9]')            AS "cpc_group_5",
        FLOOR(p."filing_date" / 10000)                       AS "filing_year"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE p."application_number" <> ''
      AND p."filing_date"        IS NOT NULL
      AND f.value:"first"::BOOLEAN = TRUE
),

yearly AS (                           -- 2. yearly filing counts per group
    SELECT
        "cpc_group_5",
        "filing_year",
        COUNT(*)                                   AS "yearly_filings"
    FROM first_cpc
    GROUP BY "cpc_group_5", "filing_year"
),

ordered AS (                          -- 3. chronological index within group
    SELECT
        y.*,
        ROW_NUMBER() OVER (PARTITION BY y."cpc_group_5"
                           ORDER BY y."filing_year")          AS "rn"
    FROM yearly y
),

/* 4. linear-cost EMA via a recursive CTE  */
RECURSIVE ema_rec (cpc_group_5, rn, filing_year, ema_alpha_0_2) AS (
      /* anchor: first year in each group                                      */
    SELECT
        o."cpc_group_5",
        o."rn",
        o."filing_year",
        o."yearly_filings" * 0.2                            AS "ema_alpha_0_2"
    FROM ordered o
    WHERE o."rn" = 1

    UNION ALL

      /* recursion: EMAᵗ = 0.2·xᵗ + 0.8·EMAᵗ⁻¹                                */
    SELECT
        o."cpc_group_5",
        o."rn",
        o."filing_year",
        0.2 * o."yearly_filings" + 0.8 * e."ema_alpha_0_2"   AS "ema_alpha_0_2"
    FROM ema_rec  e
    JOIN ordered o
      ON o."cpc_group_5" = e."cpc_group_5"
     AND o."rn"         = e."rn" + 1
),

best AS (                              -- 5. pick highest-EMA year per group
    SELECT
        "cpc_group_5",
        "filing_year"   AS "best_year",
        "ema_alpha_0_2" AS "highest_ema",
        ROW_NUMBER() OVER (PARTITION BY "cpc_group_5"
                           ORDER BY "ema_alpha_0_2" DESC) AS "rk"
    FROM ema_rec
)

SELECT
    b."cpc_group_5",
    /* full CPC title – take the first (most specific) available definition */
    FIRST_VALUE(d."titleFull") OVER (PARTITION BY b."cpc_group_5"
                                     ORDER BY d."level" NULLS LAST)  AS "cpc_full_title",
    b."best_year",
    ROUND(b."highest_ema", 4)                                        AS "highest_ema"
FROM best b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON  d."symbol" = b."cpc_group_5"
        OR d."symbol" LIKE b."cpc_group_5" || '/%'
WHERE b."rk" = 1                       -- keep only the per-group maximum
ORDER BY b."highest_ema" DESC NULLS LAST;
```
