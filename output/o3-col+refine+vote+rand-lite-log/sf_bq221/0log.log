```sql
--Description / Thinking process:
-- Aim: obtain the *first* CPC code for every publication in PATENTS.PATENTS.PUBLICATIONS.
-- Method:
--   1. FLATTEN the “cpc” JSON array so each CPC element becomes its own row and exposes its array index.
--   2. Use MIN_BY( value , index ) to pick the CPC element whose index is the smallest (0) within each publication.
--   3. Group by publication_number to aggregate back to one row per publication.
--   4. LIMIT 20 just to preview the outcome.
SELECT
       p."publication_number",
       MIN_BY(f.value:"code"::STRING, f.index) AS "first_cpc_code"
FROM   PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc") f
GROUP  BY p."publication_number"
LIMIT  20;
```
