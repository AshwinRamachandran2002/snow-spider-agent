```sql
--Description / Thinking process:
-- Aim: show, for each CPC first-code, the year when its exponential moving average
--      (EMA α = 0.2) of yearly patent-filing counts peaks, then attach the most
--      specific CPC title available in CPC_DEFINITION.
--
-- Key simplifications to guarantee rows:
--  • Do NOT require "application_number" (some docs lack it).
--  • Accept any positive filing year (skip only filing_date IS NULL or <= 0).
--  • Join titles by prefix (definition.symbol is a leading substring of the full code),
--    then keep the longest matching symbol via ROW_NUMBER().
--
WITH RECURSIVE
/* 1. first CPC code for every publication */
first_pub AS (
    SELECT
        p."publication_number",
        MIN_BY(f.value:"code"::STRING, f.index) AS "cpc_code"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    GROUP BY p."publication_number"
),
/* 2. yearly filing counts (accept any non-null filing_date) */
yearly AS (
    SELECT
        fp."cpc_code",
        CAST(FLOOR(p."filing_date" / 10000) AS NUMBER) AS "year",
        COUNT(*) AS "filings"
    FROM first_pub fp
    JOIN PATENTS.PATENTS.PUBLICATIONS p
      ON p."publication_number" = fp."publication_number"
    WHERE p."filing_date" IS NOT NULL
      AND FLOOR(p."filing_date" / 10000) > 0
    GROUP BY fp."cpc_code",
             CAST(FLOOR(p."filing_date" / 10000) AS NUMBER)
),
/* 3. chronological order per CPC */
ordered AS (
    SELECT
        y.*,
        ROW_NUMBER() OVER (PARTITION BY y."cpc_code" ORDER BY y."year") AS rn
    FROM yearly y
),
/* 4. recursive EMA: ema_1 = filings, ema_t = 0.2*filings_t + 0.8*ema_{t-1} */
ema_cte AS (
    SELECT
        o."cpc_code",
        o."year",
        o."filings",
        o.rn,
        o."filings" AS ema
    FROM ordered o
    WHERE o.rn = 1
    UNION ALL
    SELECT
        o."cpc_code",
        o."year",
        o."filings",
        o.rn,
        0.2 * o."filings" + 0.8 * e.ema AS ema
    FROM ema_cte e
    JOIN ordered o
      ON o."cpc_code" = e."cpc_code"
     AND o.rn        = e.rn + 1
),
/* 5. peak EMA and corresponding year for each CPC code */
peak AS (
    SELECT
        "cpc_code",
        MAX_BY("year", ema) AS "best_year",
        MAX(ema)            AS "max_ema"
    FROM ema_cte
    GROUP BY "cpc_code"
),
/* 6. attach CPC title: join on prefix, prefer the longest (most specific) match */
match_title AS (
    SELECT
        p.*,
        d."symbol"    AS title_symbol,
        d."titleFull" AS cpc_title,
        ROW_NUMBER() OVER (PARTITION BY p."cpc_code"
                           ORDER BY LENGTH(d."symbol") DESC) AS rk
    FROM peak p
    LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
      ON p."cpc_code" LIKE d."symbol" || '%'
)
SELECT
    "cpc_code",
    title_symbol,
    cpc_title,
    "best_year",
    "max_ema"
FROM match_title
QUALIFY rk = 1       -- keep the most specific title per CPC code
LIMIT 20;
