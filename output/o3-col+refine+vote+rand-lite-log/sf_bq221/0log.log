```sql
--Description: Build yearly filing counts per first-CPC-code (raw data that the EMA will consume).
WITH first_cpc AS (
    SELECT
           p."publication_number",
           ARRAY_AGG(f.value:"code"::STRING ORDER BY f.index)[0] AS "cpc_code"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."cpc") f
    GROUP  BY p."publication_number"
)
SELECT
       fc."cpc_code",
       TO_NUMBER(LEFT(p."filing_date", 4)) AS "year",
       COUNT(*)                           AS "filings"
FROM   first_cpc fc
JOIN   PATENTS.PATENTS.PUBLICATIONS p
       ON p."publication_number" = fc."publication_number"
WHERE  p."application_number" IS NOT NULL
  AND  p."filing_date"       IS NOT NULL
GROUP  BY fc."cpc_code",
          TO_NUMBER(LEFT(p."filing_date", 4))
LIMIT  20;
```

```sql
--Description: Calculate the exponential moving average (EMA) with smoothing factor 0.2 for each CPC/year series.
WITH yearly AS (
    SELECT
           fc."cpc_code",
           TO_NUMBER(LEFT(p."filing_date", 4)) AS "year",
           COUNT(*)                           AS "filings"
    FROM   (
           SELECT
                  p."publication_number",
                  ARRAY_AGG(f.value:"code"::STRING ORDER BY f.index)[0] AS "cpc_code"
           FROM   PATENTS.PATENTS.PUBLICATIONS p,
                  LATERAL FLATTEN(input => p."cpc") f
           GROUP  BY p."publication_number"
           ) fc
    JOIN   PATENTS.PATENTS.PUBLICATIONS p
           ON p."publication_number" = fc."publication_number"
    WHERE  p."application_number" IS NOT NULL
      AND  p."filing_date"       IS NOT NULL
    GROUP  BY fc."cpc_code",
              TO_NUMBER(LEFT(p."filing_date", 4))
)
SELECT
       y."cpc_code",
       y."year",
       y."filings",
       EMA(y."filings", 0.2) OVER (PARTITION BY y."cpc_code"
                                   ORDER BY       y."year") AS "ema_0_2"
FROM   yearly y
LIMIT  20;
```

```sql
--Description: For each CPC group, find the year with the highest EMA value (the “best year”).
WITH ema_series AS (
    SELECT
           y."cpc_code",
           y."year",
           EMA(y."filings", 0.2) OVER (PARTITION BY y."cpc_code"
                                       ORDER BY       y."year") AS "ema_0_2"
    FROM (
           SELECT
                  fc."cpc_code",
                  TO_NUMBER(LEFT(p."filing_date", 4)) AS "year",
                  COUNT(*)                           AS "filings"
           FROM (
                  SELECT
                         p."publication_number",
                         ARRAY_AGG(f.value:"code"::STRING ORDER BY f.index)[0] AS "cpc_code"
                  FROM   PATENTS.PATENTS.PUBLICATIONS p,
                         LATERAL FLATTEN(input => p."cpc") f
                  GROUP  BY p."publication_number"
                ) fc
           JOIN   PATENTS.PATENTS.PUBLICATIONS p
                  ON p."publication_number" = fc."publication_number"
           WHERE  p."application_number" IS NOT NULL
             AND  p."filing_date"       IS NOT NULL
           GROUP  BY fc."cpc_code",
                     TO_NUMBER(LEFT(p."filing_date", 4))
         ) y
)
SELECT
       es."cpc_code",
       MAX_BY(es."year", es."ema_0_2") AS "best_year",
       MAX(es."ema_0_2")               AS "max_ema"
FROM   ema_series es
GROUP  BY es."cpc_code"
LIMIT  20;
```

```sql
--Description: Attach full CPC titles (level 5 only) to each CPC code’s best-year record.
WITH ema_rank AS (
    SELECT
           es."cpc_code",
           MAX_BY(es."year", es."ema_0_2") AS "best_year",
           MAX(es."ema_0_2")               AS "max_ema"
    FROM (
           SELECT
                  y."cpc_code",
                  y."year",
                  EMA(y."filings", 0.2) OVER (PARTITION BY y."cpc_code"
                                              ORDER BY       y."year") AS "ema_0_2"
           FROM (
                  SELECT
                         fc."cpc_code",
                         TO_NUMBER(LEFT(p."filing_date", 4)) AS "year",
                         COUNT(*)                           AS "filings"
                  FROM (
                         SELECT
                                p."publication_number",
                                ARRAY_AGG(f.value:"code"::STRING ORDER BY f.index)[0] AS "cpc_code"
                         FROM   PATENTS.PATENTS.PUBLICATIONS p,
                                LATERAL FLATTEN(input => p."cpc") f
                         GROUP  BY p."publication_number"
                       ) fc
                  JOIN   PATENTS.PATENTS.PUBLICATIONS p
                         ON p."publication_number" = fc."publication_number"
                  WHERE  p."application_number" IS NOT NULL
                    AND  p."filing_date"       IS NOT NULL
                  GROUP  BY fc."cpc_code",
                            TO_NUMBER(LEFT(p."filing_date", 4))
               ) y
         ) es
    GROUP  BY es."cpc_code"
)
SELECT
       er."cpc_code",
       d."titleFull" AS "cpc_title",
       er."best_year",
       er."max_ema"
FROM   ema_rank er
JOIN   PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = er."cpc_code"
WHERE  d."level" = 5
LIMIT  20;
```
