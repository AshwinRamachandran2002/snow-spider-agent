--Description: Build yearly filing counts per first-CPC-code (raw data for the EMA step); uses MIN_BY instead of ARRAY_AGG to fetch the first CPC element.
WITH first_cpc AS (
    SELECT
           p."publication_number",
           MIN_BY(f.value:"code"::STRING, f.index) AS "cpc_code"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."cpc") f
    GROUP  BY p."publication_number"
