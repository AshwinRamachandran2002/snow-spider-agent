    GROUP BY p."publication_number"
),
yearly AS (
    SELECT
        fp."cpc_code",
        CAST(FLOOR(p."filing_date" / 10000) AS NUMBER) AS "year",
        COUNT(*) AS "filings"
    FROM first_pub fp
    JOIN PATENTS.PATENTS.PUBLICATIONS p
      ON p."publication_number" = fp."publication_number"
    WHERE p."application_number" IS NOT NULL
      AND p."filing_date"        IS NOT NULL
      AND FLOOR(p."filing_date" / 10000) > 0
    GROUP BY fp."cpc_code",
             CAST(FLOOR(p."filing_date" / 10000) AS NUMBER)
),
ordered AS (
    SELECT
        y.*,
        ROW_NUMBER() OVER (PARTITION BY y."cpc_code" ORDER BY y."year") AS rn
    FROM yearly y
),
ema_cte AS (
    SELECT
        o."cpc_code",
        o."year",
        o."filings",
        o.rn,
        o."filings" AS ema
    FROM ordered o
    WHERE o.rn = 1
    UNION ALL
    SELECT
        o."cpc_code",
        o."year",
        o."filings",
        o.rn,
        0.2 * o."filings" + 0.8 * e.ema AS ema
    FROM ema_cte e
    JOIN ordered o
      ON o."cpc_code" = e."cpc_code"
     AND o.rn        = e.rn + 1
),
peak AS (                -- best year & max EMA per CPC
    SELECT
        "cpc_code",
        MAX_BY("year", ema) AS "best_year",
        MAX(ema)            AS "max_ema"
    FROM ema_cte
    GROUP BY "cpc_code"
)
SELECT
    p."cpc_code",
    d."titleFull" AS "cpc_title",
    p."best_year",
    p."max_ema"
FROM peak p
JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON d."symbol" = p."cpc_code"
WHERE d."level" = 5
LIMIT 20;
