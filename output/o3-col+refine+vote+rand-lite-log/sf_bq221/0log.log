--Description: For each CPC code, compute the EMA (α = 0.2) via a recursive CTE and
--             return the year in which that EMA peaks (“best_year”) together with
--             the peak EMA value (“max_ema”).
WITH RECURSIVE
first_pub AS (           -- 1. first CPC per publication
    SELECT
        p."publication_number",
        MIN_BY(f.value:"code"::STRING, f.index) AS "cpc_code"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    GROUP BY p."publication_number"
),
yearly AS (              -- 2. yearly filing counts
    SELECT
        fp."cpc_code",
        CAST(FLOOR(p."filing_date" / 10000) AS NUMBER) AS "year",
        COUNT(*) AS "filings"
    FROM first_pub fp
    JOIN PATENTS.PATENTS.PUBLICATIONS p
      ON p."publication_number" = fp."publication_number"
    WHERE p."application_number" IS NOT NULL
      AND p."filing_date"        IS NOT NULL
      AND FLOOR(p."filing_date" / 10000) > 0
    GROUP BY fp."cpc_code",
             CAST(FLOOR(p."filing_date" / 10000) AS NUMBER)
),
ordered AS (             -- 3. row numbers per CPC
    SELECT
        y.*,
        ROW_NUMBER() OVER (PARTITION BY y."cpc_code" ORDER BY y."year") AS rn
    FROM yearly y
),
ema_cte AS (             -- 4. recursive EMA computation
    SELECT
        o."cpc_code",
        o."year",
        o."filings",
        o.rn,
        o."filings" AS ema
    FROM ordered o
    WHERE o.rn = 1
    UNION ALL
    SELECT
        o."cpc_code",
        o."year",
        o."filings",
        o.rn,
        0.2 * o."filings" + 0.8 * e.ema AS ema
    FROM ema_cte e
    JOIN ordered o
      ON o."cpc_code" = e."cpc_code"
     AND o.rn        = e.rn + 1
)
SELECT
    "cpc_code",
    MAX_BY("year", ema) AS "best_year",
    MAX(ema)            AS "max_ema"
FROM ema_cte
GROUP BY "cpc_code"
LIMIT 20;
