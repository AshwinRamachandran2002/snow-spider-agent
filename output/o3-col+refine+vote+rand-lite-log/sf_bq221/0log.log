--Description / Thinking process:
-- Goal:  Identify CPC technology areas at LEVEL 5 whose exponential moving average
--        (EMA, α = 0.2) of yearly patent-filing counts peaks the highest and show that
--        “best year”, the peak EMA value, and the full CPC title.
--
-- Strategy to stay within time limits:
--  1.  Restrict to publications filed from 2000 forward (filing_date ≥ 20000000).
--  2.  Extract ONLY the *first* CPC code per publication (MIN_BY on FLATTEN index).
--  3.  Map every detailed CPC code to its level-5 ancestor by a prefix join with
--      CPC_DEFINITION (d.level = 5) and keep the LONGEST matching level-5 symbol
--      (ROW_NUMBER … ORDER BY length DESC).  The grouping key becomes that level-5
--      symbol (“group_code”).
--  4.  Count filings per (group_code, year).  Keep active groups (≥ 20 filings in
--      total after 2000) to reduce recursion depth.
--  5.  Compute EMA (α = 0.2) via a recursive CTE:
--         anchor row   →  ema = filings
--         recursive row→  ema = 0.2·filings + 0.8·ema_prev
--  6.  For each group, pull the year with the maximum EMA (“best_year”) and the
--      peak EMA value (“max_ema”).
--  7.  Return group_code, CPC title, best_year, and max_ema.
WITH RECURSIVE
/*---------------------------------------------------------*
 | 1. First CPC code (array index 0) per publication, 2000+ |
 *---------------------------------------------------------*/
first_cpc AS (
    SELECT
        p."publication_number",
        MIN_BY(f.value:"code"::STRING, f.index)  AS full_cpc
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."cpc") f
    WHERE  p."filing_date" IS NOT NULL
      AND  p."filing_date" >= 20000000          -- year ≥ 2000
    GROUP  BY p."publication_number"
),
/*---------------------------------------------------------*
 | 2. Map to level-5 CPC symbol & title (longest match)    |
 *---------------------------------------------------------*/
lvl5_map AS (
    SELECT
        fc."publication_number",
        d."symbol"      AS group_code,          -- level-5 CPC symbol
        d."titleFull"   AS group_title
    FROM   first_cpc fc
    JOIN   PATENTS.PATENTS.CPC_DEFINITION d
           ON fc.full_cpc LIKE d."symbol" || '%'
          AND d."level" = 5
    QUALIFY ROW_NUMBER() OVER (PARTITION BY fc."publication_number"
                               ORDER BY LENGTH(d."symbol") DESC) = 1
),
/*---------------------------------------------------------*
 | 3. Yearly filing counts per level-5 CPC group           |
 *---------------------------------------------------------*/
yearly AS (
    SELECT
        lm.group_code,
        lm.group_title,
        CAST(FLOOR(p."filing_date" / 10000) AS NUMBER) AS yr,
        COUNT(*) AS filings
    FROM   lvl5_map  lm
    JOIN   PATENTS.PATENTS.PUBLICATIONS p
           ON p."publication_number" = lm."publication_number"
    GROUP  BY lm.group_code,
             lm.group_title,
             CAST(FLOOR(p."filing_date" / 10000) AS NUMBER)
),
/*---------------------------------------------------------*
 | 4. Keep active groups (≥20 filings since 2000)          |
 *---------------------------------------------------------*/
active AS (
    SELECT *
    FROM   yearly
    WHERE  group_code IN (
           SELECT group_code
           FROM   yearly
           GROUP  BY group_code
           HAVING SUM(filings) >= 20 )
),
/*---------------------------------------------------------*
 | 5. Add row numbers (chronological)                      |
 *---------------------------------------------------------*/
ordered AS (
    SELECT
        a.*,
        ROW_NUMBER() OVER (PARTITION BY a.group_code ORDER BY a.yr) AS rn
    FROM active a
),
/*---------------------------------------------------------*
 | 6. Recursive EMA calculation (α = 0.2)                  |
 *---------------------------------------------------------*/
ema_cte AS (
    -- Anchor row
    SELECT
        o.group_code,
        o.group_title,
        o.yr,
        o.filings,
        o.rn,
        o.filings AS ema
    FROM   ordered o
    WHERE  o.rn = 1
    UNION ALL
    -- Recursive rows
    SELECT
        o.group_code,
        o.group_title,
        o.yr,
        o.filings,
        o.rn,
        0.2 * o.filings + 0.8 * e.ema AS ema
    FROM   ema_cte e
    JOIN   ordered o
           ON o.group_code = e.group_code
          AND o.rn        = e.rn + 1
),
/*---------------------------------------------------------*
 | 7. Peak EMA and best year per level-5 CPC group         |
 *---------------------------------------------------------*/
peak AS (
    SELECT
        group_code,
        group_title,
        MAX_BY(yr, ema) AS best_year,
        MAX(ema)        AS max_ema
    FROM   ema_cte
    GROUP  BY group_code, group_title
)
SELECT
    group_code  AS "cpc_group_level5",
    group_title AS "cpc_title",
    best_year,
    ROUND(max_ema, 2) AS peak_ema
FROM   peak
ORDER  BY peak_ema DESC
LIMIT  20;
