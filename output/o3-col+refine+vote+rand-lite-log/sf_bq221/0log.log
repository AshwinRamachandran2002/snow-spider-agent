```sql
--Description / Thinking process:
-- We must compute an exponential moving average (EMA, α = 0.2) of yearly patent-filing
-- counts for each publication’s *first* CPC code, and Snowflake has no built-in EMA
-- window function.  Therefore we:
--   1. Extract the first CPC code from each publication (MIN_BY on array index).
--   2. Aggregate filings by CPC code and calendar year.
--   3. Order the years within each CPC code and assign sequential row numbers.
--   4. Use a recursive CTE to calculate EMA:
--        • Anchor row (rn = 1):      ema = filings
--        • Recursive rows (rn > 1):  ema = 0.2*filings_t + 0.8*ema_{t-1}
--   5. Return a sample of CPC code, year, raw filings, and the computed EMA.
WITH RECURSIVE
first_pub AS (  -- step 1
    SELECT
        p."publication_number",
        MIN_BY(f.value:"code"::STRING, f.index) AS "cpc_code"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    GROUP BY p."publication_number"
),
yearly AS (      -- step 2
    SELECT
        fp."cpc_code",
        CAST(FLOOR(p."filing_date" / 10000) AS NUMBER) AS "year",
        COUNT(*) AS "filings"
    FROM first_pub fp
    JOIN PATENTS.PATENTS.PUBLICATIONS p
      ON p."publication_number" = fp."publication_number"
    WHERE p."application_number" IS NOT NULL
      AND p."filing_date"        IS NOT NULL
      AND FLOOR(p."filing_date" / 10000) > 0
    GROUP BY fp."cpc_code",
             CAST(FLOOR(p."filing_date" / 10000) AS NUMBER)
),
ordered AS (     -- step 3
    SELECT
        y.*,
        ROW_NUMBER() OVER (PARTITION BY y."cpc_code" ORDER BY y."year") AS rn
    FROM yearly y
),
ema_cte AS (     -- step 4  (recursive EMA computation)
    SELECT
        o."cpc_code",
        o."year",
        o."filings",
        o.rn,
        o."filings" AS ema
    FROM ordered o
    WHERE o.rn = 1
    UNION ALL
    SELECT
        o."cpc_code",
        o."year",
        o."filings",
        o.rn,
        0.2 * o."filings" + 0.8 * e.ema AS ema
    FROM ema_cte e
    JOIN ordered o
      ON o."cpc_code" = e."cpc_code"
     AND o.rn        = e.rn + 1
)
SELECT
    "cpc_code",
    "year",
    "filings",
    ema AS "ema_0_2"
FROM ema_cte
LIMIT 20;
```
