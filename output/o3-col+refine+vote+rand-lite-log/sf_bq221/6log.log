--Description: 
--6) Count yearly filings for each CPC level-5 code (uses first CPC only)
WITH first_codes AS (
    SELECT p."publication_number",
           f.value:"code"::STRING AS "cpc_code",
           p."filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE f.index = 0
      AND p."filing_date" IS NOT NULL
      AND p."application_number" IS NOT NULL
)
SELECT d."symbol"       AS "cpc_code",
       d."titleFull"    AS "cpc_title",
       FLOOR(first_codes."filing_date"/10000) AS "year",
       COUNT(*)          AS "filings"
FROM first_codes
JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON first_codes."cpc_code" = d."symbol"
WHERE d."level" = 5
GROUP BY d."symbol",
         d."titleFull",
         FLOOR(first_codes."filing_date"/10000)
LIMIT 20;
