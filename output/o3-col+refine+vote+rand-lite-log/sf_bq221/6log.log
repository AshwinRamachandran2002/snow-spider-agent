--Description: 
--Compute the exponentially-weighted moving average (EWMA, α = 0.2) of yearly patent-filing
--counts for each CPC level-5 subclass (4-character symbol).  
--Logic:  
--1. Take the first CPC code of every publication, truncate it to 4 chars → candidate subclass.  
--2. Keep publications with non-null filing_date and application_number (data quality).  
--3. Aggregate counts by (subclass, year) and ensure the subclass truly exists at level-5 via
--   CPC_DEFINITION.  
--4. Use Snowflake’s EWMA() window function (EMA is invalid) over PARTITION BY subclass ordered
--   by year to obtain the cumulative exponential moving average.  
--5. Return 20 sample rows ordered by subclass then year.
WITH first_codes AS (
    SELECT SUBSTR(f.value:"code"::STRING, 1, 4) AS "cpc_subclass",
           p."filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE f.index = 0
      AND p."application_number" IS NOT NULL
      AND p."filing_date"        IS NOT NULL
),
yearly AS (
    SELECT d."symbol"                      AS "cpc_code",
           FLOOR(f."filing_date" / 10000)  AS "year",
           COUNT(*)                        AS "filings"
    FROM first_codes f
    JOIN PATENTS.PATENTS.CPC_DEFINITION d
          ON d."symbol" = f."cpc_subclass"
    WHERE d."level" = 5
    GROUP BY d."symbol",
             FLOOR(f."filing_date" / 10000)
)
SELECT y."cpc_code",
       y."year",
       y."filings",
       EWMA(y."filings", 0.2)
         OVER (PARTITION BY y."cpc_code" ORDER BY y."year") AS "ema_0_2"
FROM yearly y
ORDER BY y."cpc_code", y."year"
LIMIT 20;
