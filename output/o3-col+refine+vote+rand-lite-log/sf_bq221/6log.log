```sql
--Description: 
--Problem: earlier joins returned no rows because patent CPC codes are usually *deeper* 
--(e.g. "A01N47/36") than the level-5 subclass symbols in CPC_DEFINITION (e.g. "A01N").  
--Solution (thinking):
--1. Take a large sample of publications and grab the *first* CPC code.  
--2. Truncate that code to its first 4 characters, which corresponds to the CPC **subclass** 
--   (level-5 symbol pattern: Letter + 2 digits + Letter, e.g. "H04L").  
--3. Join this 4-char subclass to CPC_DEFINITION restricted to level 5 to obtain titles.  
--4. DISTINCT avoids duplicates; LIMIT 20 shows a concise result set.
WITH first_codes AS (
    SELECT SUBSTR(f.value:"code"::STRING, 1, 4) AS "subclass_code"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE f.index = 0
    LIMIT 500000        -- large sample to ensure matches
)
SELECT DISTINCT fc."subclass_code"  AS "cpc_level5_symbol",
       d."titleFull"               AS "cpc_title"
FROM first_codes fc
JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON d."symbol" = fc."subclass_code"
WHERE d."level" = 5
LIMIT 20;
