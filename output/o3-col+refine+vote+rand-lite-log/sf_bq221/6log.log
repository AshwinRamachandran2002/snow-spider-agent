```sql
--Description: 
--Single-step solution with reasoning embedded:
--Snowflake lacks a direct EMA window function in all editions, so we build the
--exponentially-weighted moving average (EWMA, α = 0.2) manually with a recursive CTE.
--Workflow
-- 1.  Extract the FIRST CPC code of every publication, truncate to its first 4 characters
--     (the true level-5 subclass symbol) and keep only records that have both an
--     application number and a filing date.
-- 2.  Aggregate yearly filing counts per subclass, ensuring the subclass exists in
--     CPC_DEFINITION at level-5.
-- 3.  Within each subclass, sort the yearly rows chronologically and assign sequential
--     row numbers.
-- 4.  Recursive CTE computes EWMA:
--         EMA₁ = filings₁
--         EMAₖ = 0.2·filingsₖ + 0.8·EMAₖ₋₁
-- 5.  QUALIFY keeps only the year where the EWMA is maximal for each subclass.
-- 6.  Output the subclass symbol, its full CPC title, that “best” year, and the peak EWMA.
WITH first_codes AS (                          -- Step 1
    SELECT SUBSTR(f.value:"code"::STRING, 1, 4) AS cpc_subclass,
           p."filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE f.index = 0
      AND p."application_number" IS NOT NULL
      AND p."filing_date"        IS NOT NULL
),
yearly AS (                                    -- Step 2
    SELECT d."symbol"                     AS cpc_code,
           FLOOR(f."filing_date" / 10000) AS year,
           COUNT(*)                       AS filings
    FROM first_codes f
    JOIN PATENTS.PATENTS.CPC_DEFINITION d
          ON d."symbol" = f.cpc_subclass
    WHERE d."level" = 5
    GROUP BY d."symbol",
             FLOOR(f."filing_date" / 10000)
),
ordered AS (                                   -- Step 3
    SELECT y.*,
           ROW_NUMBER() OVER (PARTITION BY y.cpc_code ORDER BY y.year) AS rn
    FROM yearly y
),
RECURSIVE ema_calc AS (                        -- Step 4
    /* anchor row */
    SELECT cpc_code, year, filings, filings AS ema, rn
    FROM ordered
    WHERE rn = 1
    UNION ALL
    /* recursive formula */
    SELECT o.cpc_code,
           o.year,
           o.filings,
           0.2 * o.filings + 0.8 * e.ema AS ema,
           o.rn
    FROM ema_calc e
    JOIN ordered o
      ON o.cpc_code = e.cpc_code
     AND o.rn       = e.rn + 1
)
SELECT ec.cpc_code,
       d."titleFull"  AS cpc_title,
       ec.year        AS best_year,
       ec.ema         AS highest_ema
FROM ema_calc ec
JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON d."symbol" = ec.cpc_code
QUALIFY ec.ema = MAX(ec.ema) OVER (PARTITION BY ec.cpc_code)   -- Step 5
ORDER BY ec.highest_ema DESC
LIMIT 20;                                                      -- Step 6
```
