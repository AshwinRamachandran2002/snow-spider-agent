           p."filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE f.index = 0
      AND p."filing_date" IS NOT NULL
      AND p."application_number" IS NOT NULL
),
yearly AS (
    SELECT d."symbol"                             AS "cpc_code",
           FLOOR(f."filing_date" / 10000)         AS "year",
           COUNT(*)                               AS "filings"
    FROM first_codes f
    JOIN PATENTS.PATENTS.CPC_DEFINITION d
      ON d."symbol" = f."cpc_subclass"
    WHERE d."level" = 5
    GROUP BY d."symbol",
             FLOOR(f."filing_date" / 10000)
),
ema_calc AS (
    SELECT y."cpc_code",
           y."year",
           EMA(y."filings", 0.2)
             OVER (PARTITION BY y."cpc_code"
                   ORDER BY y."year"
                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "ema"
    FROM yearly y
),
best_year AS (
    SELECT *
    FROM ema_calc
    QUALIFY "ema" = MAX("ema") OVER (PARTITION BY "cpc_code")
)
SELECT b."cpc_code",
       d."titleFull" AS "cpc_title_full",
       b."year"      AS "best_year",
       b."ema"       AS "highest_ema"
FROM best_year b
JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON d."symbol" = b."cpc_code"
ORDER BY b."highest_ema" DESC
LIMIT 100;
