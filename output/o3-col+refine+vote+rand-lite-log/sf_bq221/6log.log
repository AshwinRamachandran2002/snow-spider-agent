```sql
--Description: 
--7) Compute an exponential moving average (EMA, α = 0.2) of yearly filings per CPC code
WITH first_codes AS (
    SELECT p."publication_number",
           f.value:"code"::STRING AS "cpc_code",
           p."filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE f.index = 0
      AND p."filing_date" IS NOT NULL
      AND p."application_number" IS NOT NULL
),
yearly AS (
    SELECT d."symbol" AS "cpc_code",
           FLOOR(f."filing_date"/10000) AS "year",
           COUNT(*) AS "filings"
    FROM first_codes f
    JOIN PATENTS.PATENTS.CPC_DEFINITION d
      ON f."cpc_code" = d."symbol"
    WHERE d."level" = 5
    GROUP BY d."symbol",
             FLOOR(f."filing_date"/10000)
)
SELECT y."cpc_code",
       y."year",
       y."filings",
       EMA(y."filings", 0.2)
         OVER (PARTITION BY y."cpc_code" ORDER BY y."year"
               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "ema_0_2"
FROM yearly y
ORDER BY y."cpc_code", y."year"
LIMIT 20;
```

```sql
--Description: 
--8) Pick the year with the highest EMA for each CPC level-5 code
WITH first_codes AS (
    SELECT p."publication_number",
           f.value:"code"::STRING AS "cpc_code",
           p."filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE f.index = 0
      AND p."filing_date" IS NOT NULL
      AND p."application_number" IS NOT NULL
),
yearly AS (
    SELECT d."symbol" AS "cpc_code",
           FLOOR(f."filing_date"/10000) AS "year",
           COUNT(*) AS "filings"
    FROM first_codes f
    JOIN PATENTS.PATENTS.CPC_DEFINITION d
      ON f."cpc_code" = d."symbol"
    WHERE d."level" = 5
    GROUP BY d."symbol",
             FLOOR(f."filing_date"/10000)
),
ema_calc AS (
    SELECT y."cpc_code",
           y."year",
           EMA(y."filings", 0.2)
             OVER (PARTITION BY y."cpc_code" ORDER BY y."year"
                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "ema"
    FROM yearly y
)
SELECT *
FROM ema_calc
QUALIFY "ema" = MAX("ema") OVER (PARTITION BY "cpc_code")
LIMIT 20;
```

```sql
--Description: 
--9) Combine the best-year EMA results with CPC full titles
WITH first_codes AS (
    SELECT p."publication_number",
           f.value:"code"::STRING AS "cpc_code",
           p."filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE f.index = 0
      AND p."filing_date" IS NOT NULL
      AND p."application_number" IS NOT NULL
),
yearly AS (
    SELECT d."symbol" AS "cpc_code",
           FLOOR(f."filing_date"/10000) AS "year",
           COUNT(*) AS "filings"
    FROM first_codes f
    JOIN PATENTS.PATENTS.CPC_DEFINITION d
      ON f."cpc_code" = d."symbol"
    WHERE d."level" = 5
    GROUP BY d."symbol",
             FLOOR(f."filing_date"/10000)
),
ema_calc AS (
    SELECT y."cpc_code",
           y."year",
           EMA(y."filings", 0.2)
             OVER (PARTITION BY y."cpc_code" ORDER BY y."year"
                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "ema"
    FROM yearly y
),
best_year AS (
    SELECT *
    FROM ema_calc
    QUALIFY "ema" = MAX("ema") OVER (PARTITION BY "cpc_code")
)
SELECT b."cpc_code",
       d."titleFull",
       b."year" AS "best_year",
       b."ema"  AS "highest_ema"
FROM best_year b
JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON b."cpc_code" = d."symbol"
ORDER BY b."ema" DESC
LIMIT 20;
```

