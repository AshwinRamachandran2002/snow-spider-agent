```sql
--Description: 
--Goal: identify, for every CPC level-5 subclass (4-char symbol), the single year in which its
--      exponential moving average (EMA, α = 0.2) of patent-filing counts is highest.  
--Thinking process:  
--1. Extract the FIRST CPC code per publication, truncate to 4 characters to map to the level-5 subclass.  
--2. Filter publications to those with non-null filing dates & application numbers (data quality).  
--3. Aggregate counts by (subclass, year). Keep only true level-5 symbols via CPC_DEFINITION.  
--4. Compute the cumulative EMA for each subclass using Snowflake’s EMA() window function
--   (no explicit frame clause).  
--5. QUALIFY each row to retain only the year where the EMA reaches its maximum for that subclass.  
--6. Return the subclass code, its full CPC title, best year, and the peak EMA value.
WITH first_codes AS (
    SELECT SUBSTR(f.value:"code"::STRING, 1, 4) AS "cpc_subclass",
           p."filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE f.index = 0
      AND p."application_number" IS NOT NULL
      AND p."filing_date"        IS NOT NULL
),
yearly AS (
    SELECT d."symbol"                     AS "cpc_code",
           FLOOR(f."filing_date"/10000)   AS "year",
           COUNT(*)                       AS "filings"
    FROM first_codes f
    JOIN PATENTS.PATENTS.CPC_DEFINITION d
          ON d."symbol" = f."cpc_subclass"
    WHERE d."level" = 5
    GROUP BY d."symbol",
             FLOOR(f."filing_date"/10000)
),
ema_calc AS (
    SELECT y."cpc_code",
           y."year",
           EMA(y."filings", 0.2)
             OVER (PARTITION BY y."cpc_code" ORDER BY y."year") AS "ema"
    FROM yearly y
)
SELECT e."cpc_code",
       d."titleFull"         AS "cpc_title",
       e."year"              AS "best_year",
       e."ema"               AS "highest_ema"
FROM ema_calc e
JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON d."symbol" = e."cpc_code"
QUALIFY e."ema" = MAX(e."ema") OVER (PARTITION BY e."cpc_code")
ORDER BY e."highest_ema" DESC
LIMIT 20;
```
