```sql
--Description: Calculate average X_VALUE per gene for female epithelial cells in cluster 41, 74-year-old stage
SELECT "FEATURE_NAME",
       AVG("X_VALUE") AS "avg_female_expr"
FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CLUSTERS" = '41'
  AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
  AND "CELL_TYPE" ILIKE '%epithelial%'
  AND "SEX" ILIKE '%female%'
GROUP BY "FEATURE_NAME"
LIMIT 20;
```

```sql
--Description: Do the same for male epithelial cells
SELECT "FEATURE_NAME",
       AVG("X_VALUE") AS "avg_male_expr"
FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CLUSTERS" = '41'
  AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
  AND "CELL_TYPE" ILIKE '%epithelial%'
  AND "SEX" ILIKE '%male%'
GROUP BY "FEATURE_NAME"
LIMIT 20;
```

```sql
--Description: Combine female & male averages, compute the expression difference (female – male)
SELECT f."FEATURE_NAME",
       f."avg_female_expr",
       m."avg_male_expr",
       (f."avg_female_expr" - m."avg_male_expr") AS "female_minus_male"
FROM (
      SELECT "FEATURE_NAME", AVG("X_VALUE") AS "avg_female_expr"
      FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
      WHERE "CLUSTERS" = '41'
        AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
        AND "CELL_TYPE" ILIKE '%epithelial%'
        AND "SEX" ILIKE '%female%'
      GROUP BY "FEATURE_NAME"
     ) f
JOIN (
      SELECT "FEATURE_NAME", AVG("X_VALUE") AS "avg_male_expr"
      FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
      WHERE "CLUSTERS" = '41'
        AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
        AND "CELL_TYPE" ILIKE '%epithelial%'
        AND "SEX" ILIKE '%male%'
      GROUP BY "FEATURE_NAME"
     ) m
ON f."FEATURE_NAME" = m."FEATURE_NAME"
LIMIT 20;
```

```sql
--Description: Retrieve the 20 genes with the greatest female-minus-male expression difference (final answer)
SELECT f."FEATURE_NAME",
       (f."avg_female_expr" - m."avg_male_expr") AS "female_minus_male"
FROM (
      SELECT "FEATURE_NAME", AVG("X_VALUE") AS "avg_female_expr"
      FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
      WHERE "CLUSTERS" = '41'
        AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
        AND "CELL_TYPE" ILIKE '%epithelial%'
        AND "SEX" ILIKE '%female%'
      GROUP BY "FEATURE_NAME"
     ) f
JOIN (
      SELECT "FEATURE_NAME", AVG("X_VALUE") AS "avg_male_expr"
      FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
      WHERE "CLUSTERS" = '41'
        AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
        AND "CELL_TYPE" ILIKE '%epithelial%'
        AND "SEX" ILIKE '%male%'
      GROUP BY "FEATURE_NAME"
     ) m
ON f."FEATURE_NAME" = m."FEATURE_NAME"
ORDER BY "female_minus_male" DESC
LIMIT 20;
```
