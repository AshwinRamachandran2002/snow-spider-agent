-- 5. Description:  Average monthly sales (already in USD after conversion) for France in 2019
WITH fr_sales_2019 AS (
    SELECT  strftime('%m', s.time_id) AS mon,
            SUM(s.amount_sold) / NULLIF(cu.to_us,0)  AS amt_usd
    FROM   sales          AS s
    JOIN   customers      AS c  USING (cust_id)
    JOIN   countries      AS co USING (country_id)
    JOIN   times          AS t  ON t.time_id = s.time_id
    JOIN   promotions     AS p  USING (promo_id)
    JOIN   channels       AS ch USING (channel_id)
    JOIN   currency       AS cu 
           ON cu.country = 'France' 
          AND cu.year    = t.calendar_year 
          AND cu.month   = t.calendar_month_number
    WHERE  co.country_name        = 'France'
      AND  t.calendar_year        = 2019
      AND  p.promo_total_id       = 1
      AND  ch.channel_total_id    = 1
    GROUP  BY mon
)
SELECT mon, AVG(amt_usd) AS avg_usd_2019
FROM fr_sales_2019
GROUP BY mon
ORDER BY mon
LIMIT 20;
