```sql
-- 4. Description:  Check exchange-rates for France in 2019 (month & to_us factor)
SELECT DISTINCT *
FROM currency
WHERE country = 'France' 
  AND year  = 2019
ORDER BY month
LIMIT 20;
```

```sql
-- 5. Description:  Average monthly sales (already in USD after conversion) for France in 2019
WITH fr_sales_2019 AS (
    SELECT  strftime('%m', s.time_id) AS mon,
            SUM(s.amount_sold) / NULLIF(cu.to_us,0)  AS amt_usd
    FROM   sales          AS s
    JOIN   customers      AS c  USING (cust_id)
    JOIN   countries      AS co USING (country_id)
    JOIN   times          AS t  ON t.time_id = s.time_id
    JOIN   promotions     AS p  USING (promo_id)
    JOIN   channels       AS ch USING (channel_id)
    JOIN   currency       AS cu 
           ON cu.country = 'France' 
          AND cu.year    = t.calendar_year 
          AND cu.month   = t.calendar_month_number
    WHERE  co.country_name        = 'France'
      AND  t.calendar_year        = 2019
      AND  p.promo_total_id       = 1
      AND  ch.channel_total_id    = 1
    GROUP  BY mon
)
SELECT mon, AVG(amt_usd) AS avg_usd_2019
FROM fr_sales_2019
GROUP BY mon
ORDER BY mon
LIMIT 20;
```

```sql
-- 6. Description:  Average monthly sales in USD for France in 2020 (same filters)
WITH fr_sales_2020 AS (
    SELECT  strftime('%m', s.time_id) AS mon,
            SUM(s.amount_sold) / NULLIF(cu.to_us,0)  AS amt_usd
    FROM   sales          AS s
    JOIN   customers      AS c  USING (cust_id)
    JOIN   countries      AS co USING (country_id)
    JOIN   times          AS t  ON t.time_id = s.time_id
    JOIN   promotions     AS p  USING (promo_id)
    JOIN   channels       AS ch USING (channel_id)
    JOIN   currency       AS cu 
           ON cu.country = 'France' 
          AND cu.year    = t.calendar_year 
          AND cu.month   = t.calendar_month_number
    WHERE  co.country_name        = 'France'
      AND  t.calendar_year        = 2020
      AND  p.promo_total_id       = 1
      AND  ch.channel_total_id    = 1
    GROUP  BY mon
)
SELECT mon, AVG(amt_usd) AS avg_usd_2020
FROM fr_sales_2020
GROUP BY mon
ORDER BY mon
LIMIT 20;
```

```sql
-- 7. Description:  Project 2021 monthly averages by applying the 2019→2020 growth-rate
WITH
s19 AS (   -- monthly avg 2019
  SELECT strftime('%m', s.time_id) AS mon,
         AVG(s.amount_sold/cu.to_us) AS avg19
  FROM  sales s
  JOIN  customers c   USING (cust_id)
  JOIN  countries co  USING (country_id)
  JOIN  times t       ON t.time_id = s.time_id
  JOIN  promotions p  USING (promo_id)
  JOIN  channels  ch  USING (channel_id)
  JOIN  currency  cu  ON cu.country='France' 
                     AND cu.year=t.calendar_year 
                     AND cu.month=t.calendar_month_number
  WHERE co.country_name='France'
    AND t.calendar_year=2019
    AND p.promo_total_id=1
    AND ch.channel_total_id=1
  GROUP BY mon
),
s20 AS (   -- monthly avg 2020
  SELECT strftime('%m', s.time_id) AS mon,
         AVG(s.amount_sold/cu.to_us) AS avg20
  FROM  sales s
  JOIN  customers c   USING (cust_id)
  JOIN  countries co  USING (country_id)
  JOIN  times t       ON t.time_id = s.time_id
  JOIN  promotions p  USING (promo_id)
  JOIN  channels  ch  USING (channel_id)
  JOIN  currency  cu  ON cu.country='France' 
                     AND cu.year=t.calendar_year 
                     AND cu.month=t.calendar_month_number
  WHERE co.country_name='France'
    AND t.calendar_year=2020
    AND p.promo_total_id=1
    AND ch.channel_total_id=1
  GROUP BY mon
),
growth AS (            -- compute growth factor & projected 2021
  SELECT s20.mon,
         s20.avg20,
         s19.avg19,
         CASE WHEN s19.avg19>0 THEN s20.avg20 / s19.avg19 ELSE NULL END AS growth_factor,
         CASE WHEN s19.avg19>0 THEN (s20.avg20)*(s20.avg20 / s19.avg19) END AS proj21
  FROM s20
  JOIN s19 USING (mon)
)
SELECT mon, growth_factor, proj21
FROM growth
ORDER BY mon
LIMIT 20;
```

```sql
-- 8. Description:  Median of the 2021 projected monthly averages (USD)
WITH
s19 AS (
  SELECT strftime('%m', s.time_id) AS mon,
         AVG(s.amount_sold/cu.to_us) AS avg19
  FROM  sales s
  JOIN  customers c   USING (cust_id)
  JOIN  countries co  USING (country_id)
  JOIN  times t       ON t.time_id = s.time_id
  JOIN  promotions p  USING (promo_id)
  JOIN  channels  ch  USING (channel_id)
  JOIN  currency  cu  ON cu.country='France' 
                     AND cu.year=t.calendar_year 
                     AND cu.month=t.calendar_month_number
  WHERE co.country_name='France'
    AND t.calendar_year=2019
    AND p.promo_total_id=1
    AND ch.channel_total_id=1
  GROUP BY mon
),
s20 AS (
  SELECT strftime('%m', s.time_id) AS mon,
         AVG(s.amount_sold/cu.to_us) AS avg20
  FROM  sales s
  JOIN  customers c   USING (cust_id)
  JOIN  countries co  USING (country_id)
  JOIN  times t       ON t.time_id = s.time_id
  JOIN  promotions p  USING (promo_id)
  JOIN  channels  ch  USING (channel_id)
  JOIN  currency  cu  ON cu.country='France' 
                     AND cu.year=t.calendar_year 
                     AND cu.month=t.calendar_month_number
  WHERE co.country_name='France'
    AND t.calendar_year=2020
    AND p.promo_total_id=1
    AND ch.channel_total_id=1
  GROUP BY mon
),
proj21 AS (
  SELECT s20.mon,
         CASE WHEN s19.avg19>0 
              THEN (s20.avg20)*(s20.avg20 / s19.avg19) 
         END AS proj21_usd
  FROM s20
  JOIN s19 USING (mon)
)
SELECT ROUND(AVG(proj21_usd),2) AS median_proj_2021_usd   -- median via AVG of 6th & 7th after sort
FROM (
    SELECT proj21_usd,
           ROW_NUMBER() OVER (ORDER BY proj21_usd)  AS rn,
           COUNT(*)  OVER ()                       AS cnt
    FROM   proj21
)
WHERE rn IN ( (cnt+1)/2 , (cnt+2)/2 );   -- works for both even & odd counts
```

These eight queries start from the basic identification of France, confirm required filters, examine exchange-rates, calculate monthly averages for 2019 & 2020, project the 2021 monthly averages by applying the 2019→2020 growth rate, and finally compute the median of those 2021 projections (in USD).
