-- 8. Description:  Median of the 2021 projected monthly averages (USD)
WITH
s19 AS (
  SELECT strftime('%m', s.time_id) AS mon,
         AVG(s.amount_sold/cu.to_us) AS avg19
  FROM  sales s
  JOIN  customers c   USING (cust_id)
  JOIN  countries co  USING (country_id)
  JOIN  times t       ON t.time_id = s.time_id
  JOIN  promotions p  USING (promo_id)
  JOIN  channels  ch  USING (channel_id)
  JOIN  currency  cu  ON cu.country='France' 
                     AND cu.year=t.calendar_year 
                     AND cu.month=t.calendar_month_number
  WHERE co.country_name='France'
    AND t.calendar_year=2019
    AND p.promo_total_id=1
    AND ch.channel_total_id=1
  GROUP BY mon
),
s20 AS (
  SELECT strftime('%m', s.time_id) AS mon,
         AVG(s.amount_sold/cu.to_us) AS avg20
  FROM  sales s
  JOIN  customers c   USING (cust_id)
  JOIN  countries co  USING (country_id)
  JOIN  times t       ON t.time_id = s.time_id
  JOIN  promotions p  USING (promo_id)
  JOIN  channels  ch  USING (channel_id)
  JOIN  currency  cu  ON cu.country='France' 
                     AND cu.year=t.calendar_year 
                     AND cu.month=t.calendar_month_number
  WHERE co.country_name='France'
    AND t.calendar_year=2020
    AND p.promo_total_id=1
    AND ch.channel_total_id=1
  GROUP BY mon
),
proj21 AS (
  SELECT s20.mon,
         CASE WHEN s19.avg19>0 
              THEN (s20.avg20)*(s20.avg20 / s19.avg19) 
         END AS proj21_usd
  FROM s20
  JOIN s19 USING (mon)
)
SELECT ROUND(AVG(proj21_usd),2) AS median_proj_2021_usd   -- median via AVG of 6th & 7th after sort
FROM (
    SELECT proj21_usd,
           ROW_NUMBER() OVER (ORDER BY proj21_usd)  AS rn,
           COUNT(*)  OVER ()                       AS cnt
    FROM   proj21
)
WHERE rn IN ( (cnt+1)/2 , (cnt+2)/2 );   -- works for both even & odd counts
