```sql
--Description:  One-shot query that returns the median of France’s projected 2021
--              average monthly sales in USD (considering only rows where
--              promo_total_id = 1 and channel_total_id = 1).
--              Pipeline:
--              ① pull 2019-2020 France sales → monthly totals;
--              ② compute each year’s average of the 12 monthly totals;
--              ③ growth-rate g = (avg_2020-avg_2019) / avg_2019;
--              ④ multiply every 2020 month by (1+g) → 2021 projection (local);
--              ⑤ multiply by 2021 FX (currency table) → USD;
--              ⑥ sort the 12 USD values, pick rows 6 & 7 and average → median.
WITH ---------------------------------------------------------------- 2019 & 2020 monthly
month_tot AS (
    SELECT t.calendar_year   AS yr,
           t.calendar_month_number AS mon,
           SUM(s.amount_sold) AS tot
    FROM   sales      s
    JOIN   customers  cu ON cu.cust_id    = s.cust_id
    JOIN   countries  co ON co.country_id = cu.country_id
    JOIN   promotions p  ON p.promo_id    = s.promo_id
    JOIN   channels   ch ON ch.channel_id = s.channel_id
    JOIN   times      t  ON t.time_id     = s.time_id
    WHERE  co.country_name     = 'France'
      AND  p.promo_total_id    = 1
      AND  ch.channel_total_id = 1
      AND  t.calendar_year IN (2019, 2020)
    GROUP  BY yr, mon
),
------------------------------------------------------------------- yearly averages
yr_avg AS (
    SELECT yr, AVG(tot) AS avg_mon
    FROM   month_tot
    GROUP  BY yr
),
------------------------------------------------------------------- growth rate
g AS (
    SELECT (MAX(CASE WHEN yr = 2020 THEN avg_mon END) -
            MAX(CASE WHEN yr = 2019 THEN avg_mon END))
           / MAX(CASE WHEN yr = 2019 THEN avg_mon END) AS rate
    FROM   yr_avg
),
------------------------------------------------------------------- 2020 monthly totals
m20 AS (
    SELECT mon, tot AS tot20
    FROM   month_tot
    WHERE  yr = 2020
),
------------------------------------------------------------------- project 2021 (local)
proj_local AS (
    SELECT m20.mon,
           m20.tot20 * (1 + g.rate) AS local21
    FROM   m20, g
),
------------------------------------------------------------------- convert to USD
proj_usd AS (
    SELECT pl.mon,
           pl.local21 * fx.to_us AS usd21
    FROM   proj_local pl
    JOIN   currency   fx
         ON fx.country = 'France'
        AND fx.year    = 2021
        AND fx.month   = pl.mon
),
------------------------------------------------------------------- median of 12 values
ordered AS (
    SELECT usd21,
           ROW_NUMBER() OVER (ORDER BY usd21) AS rn,
           COUNT(*)    OVER ()               AS cnt
    FROM   proj_usd
)
SELECT ROUND(AVG(usd21), 2) AS median_projected_2021_usd
FROM   ordered
WHERE  rn IN ( (cnt + 1) / 2, (cnt + 2) / 2 );
```
