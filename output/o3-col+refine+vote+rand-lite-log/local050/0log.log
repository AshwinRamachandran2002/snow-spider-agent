```sql
-- 5. Sample rows of 2019/2020 French sales that satisfy both filters
SELECT DISTINCT s."cust_id", s."time_id", s."promo_id", s."channel_id", s."amount_sold"
FROM   "sales"      AS s
JOIN   "customers"  AS cu  ON cu."cust_id"   = s."cust_id"
JOIN   "countries"  AS co  ON co."country_id"= cu."country_id"
JOIN   "promotions" AS p   ON p."promo_id"   = s."promo_id"
JOIN   "channels"   AS ch  ON ch."channel_id"= s."channel_id"
JOIN   "times"      AS t   ON t."time_id"    = s."time_id"
WHERE  co."country_name"   = 'France'
  AND  p."promo_total_id"  = 1
  AND  ch."channel_total_id" = 1
  AND  t."calendar_year" IN (2019,2020)
LIMIT 20;
```

```sql
-- 6. Monthly totals for France in 2019 (after the required filters)
WITH french_sales AS (
  SELECT s."amount_sold", t."calendar_month_number" AS mon
  FROM   "sales"      AS s
  JOIN   "customers"  AS cu  ON cu."cust_id"   = s."cust_id"
  JOIN   "countries"  AS co  ON co."country_id"= cu."country_id"
  JOIN   "promotions" AS p   ON p."promo_id"   = s."promo_id"
  JOIN   "channels"   AS ch  ON ch."channel_id"= s."channel_id"
  JOIN   "times"      AS t   ON t."time_id"    = s."time_id"
  WHERE  co."country_name"   = 'France'
    AND  p."promo_total_id"  = 1
    AND  ch."channel_total_id" = 1
    AND  t."calendar_year"    = 2019
)
SELECT mon AS "month", SUM("amount_sold") AS "total_2019"
FROM   french_sales
GROUP  BY mon
ORDER  BY mon
LIMIT 20;
```

```sql
-- 7. Monthly totals for France in 2020 (same filters)
WITH french_sales AS (
  SELECT s."amount_sold", t."calendar_month_number" AS mon
  FROM   "sales"      AS s
  JOIN   "customers"  AS cu  ON cu."cust_id"   = s."cust_id"
  JOIN   "countries"  AS co  ON co."country_id"= cu."country_id"
  JOIN   "promotions" AS p   ON p."promo_id"   = s."promo_id"
  JOIN   "channels"   AS ch  ON ch."channel_id"= s."channel_id"
  JOIN   "times"      AS t   ON t."time_id"    = s."time_id"
  WHERE  co."country_name"   = 'France'
    AND  p."promo_total_id"  = 1
    AND  ch."channel_total_id" = 1
    AND  t."calendar_year"    = 2020
)
SELECT mon AS "month", SUM("amount_sold") AS "total_2020"
FROM   french_sales
GROUP  BY mon
ORDER  BY mon
LIMIT 20;
```

```sql
-- 8. Average monthly totals for 2019 & 2020 and the growth rate
WITH yr_avgs AS (
  SELECT t."calendar_year" AS yr,
         AVG(month_tot)    AS avg_mon
  FROM (
     SELECT t."calendar_year",
            t."calendar_month_number",
            SUM(s."amount_sold") AS month_tot
     FROM   "sales"      AS s
     JOIN   "customers"  AS cu  ON cu."cust_id"   = s."cust_id"
     JOIN   "countries"  AS co  ON co."country_id"= cu."country_id"
     JOIN   "promotions" AS p   ON p."promo_id"   = s."promo_id"
     JOIN   "channels"   AS ch  ON ch."channel_id"= s."channel_id"
     JOIN   "times"      AS t   ON t."time_id"    = s."time_id"
     WHERE  co."country_name"   = 'France'
       AND  p."promo_total_id"  = 1
       AND  ch."channel_total_id" = 1
       AND  t."calendar_year" IN (2019,2020)
     GROUP  BY t."calendar_year", t."calendar_month_number"
  ) AS tmp
  GROUP BY yr
)
SELECT  a2019."avg_mon" AS "avg_2019",
        a2020."avg_mon" AS "avg_2020",
        (a2020."avg_mon" - a2019."avg_mon") / a2019."avg_mon" AS "growth_rate"
FROM    yr_avgs AS a2019
JOIN    yr_avgs AS a2020 ON a2019.yr = 2019 AND a2020.yr = 2020
LIMIT 20;
```

```sql
-- 9. Project each 2021 month:  total_2020_month × (1 + growth_rate)
WITH monthly_20 AS (
   SELECT t."calendar_month_number" AS mon,
          SUM(s."amount_sold")      AS tot20
   FROM   "sales"      AS s
   JOIN   "customers"  AS cu  ON cu."cust_id"   = s."cust_id"
   JOIN   "countries"  AS co  ON co."country_id"= cu."country_id"
   JOIN   "promotions" AS p   ON p."promo_id"   = s."promo_id"
   JOIN   "channels"   AS ch  ON ch."channel_id"= s."channel_id"
   JOIN   "times"      AS t   ON t."time_id"    = s."time_id"
   WHERE  co."country_name"        = 'France'
     AND  p."promo_total_id"       = 1
     AND  ch."channel_total_id"    = 1
     AND  t."calendar_year"        = 2020
   GROUP  BY mon
), growth AS (
   SELECT (AVG(CASE WHEN yr=2020 THEN avg_mon END) -
           AVG(CASE WHEN yr=2019 THEN avg_mon END))
          / AVG(CASE WHEN yr=2019 THEN avg_mon END) AS g
   FROM (
      SELECT t."calendar_year"      AS yr,
             AVG(month_tot)         AS avg_mon
      FROM (
        SELECT t."calendar_year",
               t."calendar_month_number",
               SUM(s."amount_sold") AS month_tot
        FROM   "sales"      AS s
        JOIN   "customers"  AS cu  ON cu."cust_id"   = s."cust_id"
        JOIN   "countries"  AS co  ON co."country_id"= cu."country_id"
        JOIN   "promotions" AS p   ON p."promo_id"   = s."promo_id"
        JOIN   "channels"   AS ch  ON ch."channel_id"= s."channel_id"
        JOIN   "times"      AS t   ON t."time_id"    = s."time_id"
        WHERE  co."country_name"    = 'France'
          AND  p."promo_total_id"   = 1
          AND  ch."channel_total_id"= 1
          AND  t."calendar_year" IN (2019,2020)
        GROUP  BY t."calendar_year", t."calendar_month_number"
      ) AS tmp
      GROUP BY yr
   )
), projected AS (
   SELECT m.mon,
          m.tot20 * (1 + g.g)             AS proj_local
   FROM   monthly_20 AS m
          CROSS JOIN growth AS g
)
SELECT p.mon, p.proj_local
FROM   projected AS p
ORDER  BY p.mon
LIMIT 20;
```

```sql
-- 10. Convert projections to USD, then calculate the median of the 12 monthly values
WITH monthly_20 AS (
   SELECT t."calendar_month_number" AS mon,
          SUM(s."amount_sold")      AS tot20
   FROM   "sales"      AS s
   JOIN   "customers"  AS cu  ON cu."cust_id"   = s."cust_id"
   JOIN   "countries"  AS co  ON co."country_id"= cu."country_id"
   JOIN   "promotions" AS p   ON p."promo_id"   = s."promo_id"
   JOIN   "channels"   AS ch  ON ch."channel_id"= s."channel_id"
   JOIN   "times"      AS t   ON t."time_id"    = s."time_id"
   WHERE  co."country_name"        = 'France'
     AND  p."promo_total_id"       = 1
     AND  ch."channel_total_id"    = 1
     AND  t."calendar_year"        = 2020
   GROUP  BY mon
), growth AS (
   SELECT (AVG(CASE WHEN yr=2020 THEN avg_mon END) -
           AVG(CASE WHEN yr=2019 THEN avg_mon END))
          / AVG(CASE WHEN yr=2019 THEN avg_mon END) AS g
   FROM (
      SELECT t."calendar_year"      AS yr,
             AVG(month_tot)         AS avg_mon
      FROM (
        SELECT t."calendar_year",
               t."calendar_month_number",
               SUM(s."amount_sold") AS month_tot
        FROM   "sales"      AS s
        JOIN   "customers"  AS cu  ON cu."cust_id"   = s."cust_id"
        JOIN   "countries"  AS co  ON co."country_id"= cu."country_id"
        JOIN   "promotions" AS p   ON p."promo_id"   = s."promo_id"
        JOIN   "channels"   AS ch  ON ch."channel_id"= s."channel_id"
        JOIN   "times"      AS t   ON t."time_id"    = s."time_id"
        WHERE  co."country_name"    = 'France'
          AND  p."promo_total_id"   = 1
          AND  ch."channel_total_id"= 1
          AND  t."calendar_year" IN (2019,2020)
        GROUP  BY t."calendar_year", t."calendar_month_number"
      ) AS tmp
      GROUP BY yr
   )
), projected AS (
   SELECT m.mon,
          m.tot20 * (1 + g.g)             AS proj_local
   FROM   monthly_20 AS m
          CROSS JOIN growth AS g
), proj_usd AS (
   SELECT pr.mon,
          pr.proj_local * cu."to_us"      AS proj_usd
   FROM   projected  AS pr
   JOIN   "currency" AS cu
          ON  cu."country" = 'France'
          AND cu."year"    = 2021
          AND cu."month"   = pr.mon
)
SELECT AVG(val) AS "median_projected_2021_usd"
FROM (
   SELECT proj_usd AS val,
          ROW_NUMBER() OVER (ORDER BY proj_usd) AS rn
   FROM   proj_usd
) AS ordered
WHERE rn IN (6,7);   -- average of 6th & 7th rows gives the median of 12 items
```
