```sql
--Description / Thinking process:
-- 1) Filter France’s sales (promo_total_id = 1, channel_total_id = 1).
-- 2) Build monthly totals for 2019 and for 2020.
-- 3) Take each year’s AVERAGE of those 12 monthly totals → avg_2019 & avg_2020.
-- 4) Growth-rate g = (avg_2020 − avg_2019) / avg_2019.
-- 5) Project every 2021 month by taking the 2020 monthly total × (1+g).
-- 6) Convert each projected figure to USD with 2021 FX in table “currency”.
-- 7) Order the 12 USD values, take the middle two (rows 6 & 7) and average
--    them → the median of the projected 2021 monthly averages.
WITH -------------------------------------------------------------- 2019 monthly
monthly_2019 AS (
    SELECT  t."calendar_month_number" AS mon,
            SUM(s."amount_sold")      AS tot19
    FROM    "sales"      s
    JOIN    "customers"  cu  ON cu."cust_id"    = s."cust_id"
    JOIN    "countries"  co  ON co."country_id" = cu."country_id"
    JOIN    "promotions" p   ON p."promo_id"    = s."promo_id"
    JOIN    "channels"   ch  ON ch."channel_id" = s."channel_id"
    JOIN    "times"      t   ON t."time_id"     = s."time_id"
    WHERE   co."country_name"     = 'France'
      AND   p."promo_total_id"    = 1
      AND   ch."channel_total_id" = 1
      AND   t."calendar_year"     = 2019
    GROUP BY mon
),
------------------------------------------------------------------- 2020 monthly
monthly_2020 AS (
    SELECT  t."calendar_month_number" AS mon,
            SUM(s."amount_sold")      AS tot20
    FROM    "sales"      s
    JOIN    "customers"  cu  ON cu."cust_id"    = s."cust_id"
    JOIN    "countries"  co  ON co."country_id" = cu."country_id"
    JOIN    "promotions" p   ON p."promo_id"    = s."promo_id"
    JOIN    "channels"   ch  ON ch."channel_id" = s."channel_id"
    JOIN    "times"      t   ON t."time_id"     = s."time_id"
    WHERE   co."country_name"     = 'France'
      AND   p."promo_total_id"    = 1
      AND   ch."channel_total_id" = 1
      AND   t."calendar_year"     = 2020
    GROUP BY mon
),
------------------------------------------------------------------- yearly avgs
yr_avgs AS (
    SELECT 2019 AS yr, AVG(tot19) AS avg_mon FROM monthly_2019
    UNION ALL
    SELECT 2020,       AVG(tot20) FROM monthly_2020
),
------------------------------------------------------------------- growth rate
growth AS (
    SELECT (MAX(CASE WHEN yr=2020 THEN avg_mon END) -
            MAX(CASE WHEN yr=2019 THEN avg_mon END))
           / MAX(CASE WHEN yr=2019 THEN avg_mon END) AS g
    FROM   yr_avgs
),
------------------------------------------------------------------- projection
projected AS (
    SELECT m.mon,
           m.tot20 * (1 + g.g) AS proj_local
    FROM   monthly_2020 m
    CROSS  JOIN growth  g
),
------------------------------------------------------------------- FX to USD
proj_usd AS (
    SELECT pr.mon,
           pr.proj_local * fx."to_us" AS proj_usd
    FROM   projected pr
    JOIN   "currency" fx
           ON  fx."country" = 'France'
           AND fx."year"    = 2021
           AND fx."month"   = pr.mon
),
------------------------------------------------------------------- median
ordered AS (
    SELECT proj_usd,
           ROW_NUMBER() OVER (ORDER BY proj_usd)          AS rn,
           COUNT(*)    OVER ()                            AS cnt
    FROM   proj_usd
)
SELECT AVG(proj_usd) AS median_projected_2021_usd
FROM   ordered
WHERE  rn IN ( (cnt + 1) / 2, (cnt + 2) / 2 );   -- middle value(s)
```
