```sql
--Description: Show a sample of raw sales rows in 2019 for French customers, joined to “total” channel & promo rows
SELECT DISTINCT s.prod_id,
       s.cust_id,
       s.time_id,
       s.channel_id,
       s.promo_id,
       s.quantity_sold,
       s.amount_sold
FROM   sales AS s
JOIN   customers  AS cu  ON s.cust_id  = cu.cust_id
JOIN   countries  AS co  ON cu.country_id = co.country_id
JOIN   channels   AS ch  ON s.channel_id = ch.channel_id
JOIN   promotions AS pr  ON s.promo_id  = pr.promo_id
WHERE  co.country_name = 'France'
  AND  pr.promo_total_id   = 1
  AND  ch.channel_total_id = 1
  AND  s.time_id BETWEEN '2019-01-01' AND '2019-12-31'
LIMIT 20;
```

```sql
--Description: Compute France’s monthly sales (sum of amount_sold) for 2019 ‑ restricted to promo_total_id = 1 & channel_total_id = 1
SELECT STRFTIME('%Y-%m', t.time_id)        AS year_month,
       SUM(s.amount_sold)                  AS amount_sold_2019
FROM   sales        AS s
JOIN   customers    AS cu ON s.cust_id  = cu.cust_id
JOIN   countries    AS co ON cu.country_id = co.country_id
JOIN   channels     AS ch ON s.channel_id = ch.channel_id
JOIN   promotions   AS pr ON s.promo_id  = pr.promo_id
JOIN   times        AS t  ON s.time_id   = t.time_id
WHERE  co.country_name      = 'France'
  AND  pr.promo_total_id     = 1
  AND  ch.channel_total_id   = 1
  AND  t.calendar_year       = 2019
GROUP  BY year_month
ORDER  BY year_month
LIMIT 20;
```

```sql
--Description: Compute France’s monthly sales (sum of amount_sold) for 2020 under the same filters
SELECT STRFTIME('%Y-%m', t.time_id)        AS year_month,
       SUM(s.amount_sold)                  AS amount_sold_2020
FROM   sales        AS s
JOIN   customers    AS cu ON s.cust_id  = cu.cust_id
JOIN   countries    AS co ON cu.country_id = co.country_id
JOIN   channels     AS ch ON s.channel_id = ch.channel_id
JOIN   promotions   AS pr ON s.promo_id  = pr.promo_id
JOIN   times        AS t  ON s.time_id   = t.time_id
WHERE  co.country_name      = 'France'
  AND  pr.promo_total_id     = 1
  AND  ch.channel_total_id   = 1
  AND  t.calendar_year       = 2020
GROUP  BY year_month
ORDER  BY year_month
LIMIT 20;
```

```sql
--Description: Combine the 2019 and 2020 monthly aggregates to derive the growth rate (2020 / 2019) for each month
SELECT a.year_month,
       a.amount_sold_2019,
       b.amount_sold_2020,
       CASE
            WHEN a.amount_sold_2019 > 0
            THEN (b.amount_sold_2020 * 1.0) / a.amount_sold_2019
       END                                           AS growth_rate_20_vs_19
FROM (
        /* 2019 aggregates */
        SELECT STRFTIME('%m', t.time_id) AS month,
               SUM(s.amount_sold)        AS amount_sold_2019,
               STRFTIME('%m', t.time_id) || '-any' AS year_month
        FROM   sales AS s
        JOIN   customers    AS cu ON s.cust_id  = cu.cust_id
        JOIN   countries    AS co ON cu.country_id = co.country_id
        JOIN   channels     AS ch ON s.channel_id = ch.channel_id
        JOIN   promotions   AS pr ON s.promo_id  = pr.promo_id
        JOIN   times        AS t  ON s.time_id   = t.time_id
        WHERE  co.country_name='France'
          AND  pr.promo_total_id   = 1
          AND  ch.channel_total_id = 1
          AND  t.calendar_year     = 2019
        GROUP  BY month
     ) AS a
JOIN (
        /* 2020 aggregates */
        SELECT STRFTIME('%m', t.time_id) AS month,
               SUM(s.amount_sold)        AS amount_sold_2020
        FROM   sales AS s
        JOIN   customers    AS cu ON s.cust_id  = cu.cust_id
        JOIN   countries    AS co ON cu.country_id = co.country_id
        JOIN   channels     AS ch ON s.channel_id = ch.channel_id
        JOIN   promotions   AS pr ON s.promo_id  = pr.promo_id
        JOIN   times        AS t  ON s.time_id   = t.time_id
        WHERE  co.country_name='France'
          AND  pr.promo_total_id   = 1
          AND  ch.channel_total_id = 1
          AND  t.calendar_year     = 2020
        GROUP  BY month
     ) AS b
ON a.month = b.month
ORDER BY a.month
LIMIT 20;
```

```sql
--Description: Pull the 2021 France FX rates so that once we project 2021 sales (using growth), we can convert to USD
SELECT DISTINCT year, month, to_us
FROM currency
WHERE country = 'France'
  AND year     = 2021
ORDER BY month
LIMIT 20;
```
