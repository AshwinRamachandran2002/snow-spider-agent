```sql
-- Description: show pairs where customer’s first & second preferences match entertainer’s first & second strengths in the same order
SELECT  c."CustomerID", e."EntertainerID"
FROM   (
        SELECT mp."CustomerID",
               MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS "pref1",
               MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS "pref2"
        FROM   "Musical_Preferences" AS mp
        GROUP  BY mp."CustomerID"
        HAVING COUNT(*) <= 3
       ) AS c
JOIN  (
        SELECT es."EntertainerID",
               MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS "style1",
               MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS "style2"
        FROM   "Entertainer_Styles" AS es
        GROUP  BY es."EntertainerID"
        HAVING COUNT(*) <= 3
      ) AS e
      ON  c."pref1" = e."style1"
      AND c."pref2" = e."style2"
LIMIT 20;
```

```sql
-- Description: show pairs where customer’s first & second preferences match entertainer’s first & second strengths but in the reverse order
SELECT  c."CustomerID", e."EntertainerID"
FROM   (
        SELECT mp."CustomerID",
               MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS "pref1",
               MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS "pref2"
        FROM   "Musical_Preferences" AS mp
        GROUP  BY mp."CustomerID"
        HAVING COUNT(*) <= 3
       ) AS c
JOIN  (
        SELECT es."EntertainerID",
               MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS "style1",
               MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS "style2"
        FROM   "Entertainer_Styles" AS es
        GROUP  BY es."EntertainerID"
        HAVING COUNT(*) <= 3
      ) AS e
      ON  c."pref1" = e."style2"
      AND c."pref2" = e."style1"
LIMIT 20;
```

```sql
-- Description: combine the two matching rules above and return the entertainer’s stage name with the customer’s last name
SELECT DISTINCT en."EntStageName"   AS "Entertainer",
                cu."CustLastName"   AS "Customer"
FROM   (
        SELECT mp."CustomerID",
               MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS "pref1",
               MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS "pref2"
        FROM   "Musical_Preferences" AS mp
        GROUP  BY mp."CustomerID"
        HAVING COUNT(*) <= 3
       )                           AS c
JOIN   (
        SELECT es."EntertainerID",
               MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS "style1",
               MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS "style2"
        FROM   "Entertainer_Styles" AS es
        GROUP  BY es."EntertainerID"
        HAVING COUNT(*) <= 3
       )                           AS e
          ON  (c."pref1" = e."style1" AND c."pref2" = e."style2")
          OR  (c."pref1" = e."style2" AND c."pref2" = e."style1")
JOIN   "Entertainers"              AS en  ON en."EntertainerID" = e."EntertainerID"
JOIN   "Customers"                 AS cu  ON cu."CustomerID"    = c."CustomerID"
LIMIT 20;
```

