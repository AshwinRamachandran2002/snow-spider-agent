```sql
-- Description: return every entertainer / customer pair whose first two styles match
--              (either in the same or the reverse order), limiting both sides to
--              max-three styles or preferences.  (Combined-rules version – LIMIT 20)
SELECT DISTINCT
       en."EntStageName" AS "Entertainer",
       cu."CustLastName" AS "Customer"
FROM  (                                -- Customers (≤3 prefs) + their first two
        SELECT mp."CustomerID",
               MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS pref1,
               MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS pref2
        FROM   "Musical_Preferences" mp
        GROUP  BY mp."CustomerID"
        HAVING COUNT(*) <= 3
      )  AS c
JOIN  (                                -- Entertainers (≤3 styles) + their first two
        SELECT es."EntertainerID",
               MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS style1,
               MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS style2
        FROM   "Entertainer_Styles" es
        GROUP  BY es."EntertainerID"
        HAVING COUNT(*) <= 3
      )  AS e
      ON  (c.pref1 = e.style1 AND c.pref2 = e.style2)   -- same order
       OR (c.pref1 = e.style2 AND c.pref2 = e.style1)   -- reverse order
JOIN "Entertainers" en ON en."EntertainerID" = e."EntertainerID"
JOIN "Customers"   cu ON cu."CustomerID"    = c."CustomerID"
LIMIT 20;
