```sql
-- 1. See all musical preferences to know the sequence numbers used
SELECT DISTINCT "CustomerID",
       "StyleID",
       "PreferenceSeq"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
-- 2. Look at entertainers’ style strengths and their ranks
SELECT DISTINCT "EntertainerID",
       "StyleID",
       "StyleStrength"
FROM "Entertainer_Styles"
LIMIT 20;
```

```sql
-- 3. How many style–rows does each entertainer have?
SELECT "EntertainerID",
       COUNT(*) AS "StyleRows"
FROM "Entertainer_Styles"
GROUP BY "EntertainerID"
LIMIT 20;
```

```sql
-- 4. How many preference-rows does each customer have?
SELECT "CustomerID",
       COUNT(*) AS "PrefRows"
FROM "Musical_Preferences"
GROUP BY "CustomerID"
LIMIT 20;
```

```sql
-- 5. Pick entertainers with ≤ 3 style strengths and expose their first two
SELECT "EntertainerID",
       MAX(CASE WHEN "StyleStrength" = 1 THEN "StyleID" END) AS "Style1",
       MAX(CASE WHEN "StyleStrength" = 2 THEN "StyleID" END) AS "Style2"
FROM "Entertainer_Styles"
GROUP BY "EntertainerID"
HAVING COUNT(*) <= 3
LIMIT 20;
```

```sql
-- 6. Pick customers with ≤ 3 preferences and expose their first two
SELECT "CustomerID",
       MAX(CASE WHEN "PreferenceSeq" = 1 THEN "StyleID" END) AS "Pref1",
       MAX(CASE WHEN "PreferenceSeq" = 2 THEN "StyleID" END) AS "Pref2"
FROM "Musical_Preferences"
GROUP BY "CustomerID"
HAVING COUNT(*) <= 3
LIMIT 20;
```

```sql
-- 7. Join the previous two result sets to match first & second styles in either order
SELECT DISTINCT e."EntStageName",
       c."CustLastName"
FROM "Entertainers"                AS e
JOIN (
     SELECT "EntertainerID",
            MAX(CASE WHEN "StyleStrength" = 1 THEN "StyleID" END) AS "Style1",
            MAX(CASE WHEN "StyleStrength" = 2 THEN "StyleID" END) AS "Style2",
            COUNT(*) AS "StrengthCnt"
     FROM "Entertainer_Styles"
     GROUP BY "EntertainerID"
     HAVING "StrengthCnt" <= 3
) AS es
     ON es."EntertainerID" = e."EntertainerID"
JOIN (
     SELECT "CustomerID",
            MAX(CASE WHEN "PreferenceSeq" = 1 THEN "StyleID" END) AS "Pref1",
            MAX(CASE WHEN "PreferenceSeq" = 2 THEN "StyleID" END) AS "Pref2",
            COUNT(*) AS "PrefCnt"
     FROM "Musical_Preferences"
     GROUP BY "CustomerID"
     HAVING "PrefCnt" <= 3
) AS mp
     ON  ( mp."Pref1" = es."Style1" AND mp."Pref2" = es."Style2")
      OR ( mp."Pref1" = es."Style2" AND mp."Pref2" = es."Style1")
JOIN "Customers"   AS c ON c."CustomerID" = mp."CustomerID"
LIMIT 20;
```

The final (7th) query returns every entertainer–customer pair in which both parties have at most three style rows, and the customer’s first two style preferences match the entertainer’s first two style strengths (in either order).  Only the entertainer’s stage name and the customer’s last name are shown.
