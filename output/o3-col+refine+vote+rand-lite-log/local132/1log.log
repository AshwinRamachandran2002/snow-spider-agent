Query:
--Description: Find entertainer–customer pairs where Pref1 = Strength1 AND Pref2 = Strength2 (same order).
SELECT  e."EntertainerID",
        c."CustomerID"
FROM   (SELECT  es1."EntertainerID",
                es1."StyleID" AS "S1",
                es2."StyleID" AS "S2"
        FROM   "Entertainer_Styles" AS es1
        JOIN   "Entertainer_Styles" AS es2
               ON es1."EntertainerID" = es2."EntertainerID"
              AND es1."StyleStrength" = 1
              AND es2."StyleStrength" = 2
        WHERE  (SELECT COUNT(*) 
                FROM   "Entertainer_Styles" AS t
                WHERE  t."EntertainerID" = es1."EntertainerID") <= 3) AS e
JOIN   (SELECT  mp1."CustomerID",
                mp1."StyleID" AS "P1",
                mp2."StyleID" AS "P2"
        FROM   "Musical_Preferences" AS mp1
        JOIN   "Musical_Preferences" AS mp2
               ON mp1."CustomerID" = mp2."CustomerID"
              AND mp1."PreferenceSeq" = 1
              AND mp2."PreferenceSeq" = 2
        WHERE  (SELECT COUNT(*)
                FROM   "Musical_Preferences" AS t
                WHERE  t."CustomerID" = mp1."CustomerID") <= 3) AS c
       ON e."S1" = c."P1"  -- same order
      AND e."S2" = c."P2"
LIMIT 20;
