```sql
--Description: Show first and second musical preferences for customers that have at most three preferences.
SELECT  mp1."CustomerID",
        mp1."StyleID" AS "Pref1",
        mp2."StyleID" AS "Pref2"
FROM   (SELECT "CustomerID"
        FROM   "Musical_Preferences"
        GROUP  BY "CustomerID"
        HAVING COUNT(*) <= 3) AS c
JOIN   "Musical_Preferences" AS mp1
       ON c."CustomerID" = mp1."CustomerID"
      AND mp1."PreferenceSeq" = 1
JOIN   "Musical_Preferences" AS mp2
       ON c."CustomerID" = mp2."CustomerID"
      AND mp2."PreferenceSeq" = 2
ORDER BY mp1."CustomerID"
LIMIT 20;
