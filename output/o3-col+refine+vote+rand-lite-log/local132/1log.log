        es1."StyleID" AS "Strength1",
        es2."StyleID" AS "Strength2"
FROM   (SELECT "EntertainerID"
        FROM   "Entertainer_Styles"
        GROUP  BY "EntertainerID"
        HAVING COUNT(*) <= 3) AS e
JOIN   "Entertainer_Styles" AS es1
       ON e."EntertainerID" = es1."EntertainerID"
      AND es1."StyleStrength" = 1
JOIN   "Entertainer_Styles" AS es2
       ON e."EntertainerID" = es2."EntertainerID"
      AND es2."StyleStrength" = 2
ORDER BY es1."EntertainerID"
LIMIT 20;
