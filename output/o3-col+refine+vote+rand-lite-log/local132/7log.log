```sql
--Description / thinking process:
-- 1. Build a list of entertainers who have no more than three styles recorded,
--    and capture their 1st- and 2nd-strongest styles (StyleStrength = 1 or 2).
-- 2. Build a list of customers who have no more than three musical preferences,
--    and capture their 1st- and 2nd-preference styles (PreferenceSeq = 1 or 2).
-- 3. Join those two result sets twice-filtered:
--        a) same-order match:  Style1 = Pref1 AND Style2 = Pref2
--        b) reverse-order match: Style1 = Pref2 AND Style2 = Pref1
-- 4. Finally return the entertainer’s stage name and the customer’s last name.

WITH e AS (
    SELECT es."EntertainerID",
           MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS Style1,
           MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS Style2
    FROM   "Entertainer_Styles" AS es
    GROUP  BY es."EntertainerID"
    HAVING MAX(es."StyleStrength") <= 3               -- up to three strengths
),
c AS (
    SELECT mp."CustomerID",
           MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS Pref1,
           MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS Pref2
    FROM   "Musical_Preferences" AS mp
    GROUP  BY mp."CustomerID"
    HAVING MAX(mp."PreferenceSeq") <= 3               -- up to three prefs
)
SELECT DISTINCT en."EntStageName",
                cu."CustLastName"
FROM   e
JOIN   c  ON ( (e.Style1 = c.Pref1 AND e.Style2 = c.Pref2)   -- same order
           OR (e.Style1 = c.Pref2 AND e.Style2 = c.Pref1) )  -- reverse order
JOIN   "Entertainers" AS en ON en."EntertainerID" = e."EntertainerID"
JOIN   "Customers"    AS cu ON cu."CustomerID"    = c."CustomerID"
LIMIT 20;
```
