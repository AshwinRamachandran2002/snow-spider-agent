```sql
--Description: Final answer – entertainer stage name and customer last name
--             using JOIN (not CROSS JOIN) and allowing either order match.
WITH e AS (                                         -- keep entertainers with 2 recorded strengths
        SELECT es."EntertainerID",
               MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS Style1,
               MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS Style2
        FROM   "Entertainer_Styles" AS es
        GROUP  BY es."EntertainerID"
        HAVING MAX(es."StyleStrength") <= 3
           AND COUNT(CASE WHEN es."StyleStrength" IN (1,2) THEN 1 END) = 2
     ),
     c AS (                                         -- keep customers with 2 recorded prefs
        SELECT mp."CustomerID",
               MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS Pref1,
               MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS Pref2
        FROM   "Musical_Preferences" AS mp
        GROUP  BY mp."CustomerID"
        HAVING MAX(mp."PreferenceSeq") <= 3
           AND COUNT(CASE WHEN mp."PreferenceSeq" IN (1,2) THEN 1 END) = 2
     )
SELECT DISTINCT en."EntStageName",
                cu."CustLastName"
FROM   e
JOIN   c   ON  (e.Style1 = c.Pref1 AND e.Style2 = c.Pref2)     -- same order
        OR   (e.Style1 = c.Pref2 AND e.Style2 = c.Pref1)       -- reverse order
JOIN   "Entertainers" AS en ON en."EntertainerID" = e."EntertainerID"
JOIN   "Customers"    AS cu ON cu."CustomerID"    = c."CustomerID"
LIMIT 20;
