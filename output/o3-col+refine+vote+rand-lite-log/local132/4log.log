```sql
--Description: We first create 2 small derived tables:
--   ent  → entertainers that have 1-to-3 style rows; we pull the StyleID whose
--           StyleStrength = 1 (s1) and = 2 (s2).
--   cust → customers that have 1-to-3 preference rows; we pull the StyleID whose
--           PreferenceSeq = 1 (p1) and = 2 (p2).
--A pair is acceptable when the customer’s 1st & 2nd preferences match the
--entertainer’s 1st & 2nd strengths in the same order OR in the reverse order
--( (s1=p1 AND s2=p2)  OR  (s1=p2 AND s2=p1) ).
--Finally, return only the columns requested: entertainer’s stage name and
--customer’s last name.
WITH ent AS (
    SELECT "EntertainerID",
           MAX(CASE WHEN "StyleStrength" = 1 THEN "StyleID" END) AS s1,
           MAX(CASE WHEN "StyleStrength" = 2 THEN "StyleID" END) AS s2,
           COUNT(*) AS style_cnt
    FROM "Entertainer_Styles"
    GROUP BY "EntertainerID"
    HAVING style_cnt <= 3            -- up-to-three style strengths
),
cust AS (
    SELECT "CustomerID",
           MAX(CASE WHEN "PreferenceSeq" = 1 THEN "StyleID" END) AS p1,
           MAX(CASE WHEN "PreferenceSeq" = 2 THEN "StyleID" END) AS p2,
           COUNT(*) AS pref_cnt
    FROM "Musical_Preferences"
    GROUP BY "CustomerID"
    HAVING pref_cnt <= 3             -- up-to-three style preferences
)
SELECT DISTINCT en."EntStageName",
       cu."CustLastName"
FROM ent  e
JOIN cust c
      ON (e.s1 = c.p1 AND e.s2 = c.p2)     -- same order
      OR (e.s1 = c.p2 AND e.s2 = c.p1)     -- reverse order
JOIN "Entertainers" en ON en."EntertainerID" = e."EntertainerID"
JOIN "Customers"   cu ON cu."CustomerID"   = c."CustomerID"
LIMIT 20;
```
