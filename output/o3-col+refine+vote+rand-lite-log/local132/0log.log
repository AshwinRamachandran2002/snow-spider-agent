```sql
--Description: Build the answer in three steps (inside one statement):
--  1) Ent CTE – keep entertainers that list three-or-fewer styles and capture the
--     StyleID ranked #1 (S1) and #2 (S2) via StyleStrength.
--  2) Cust CTE – keep customers that list three-or-fewer preferences and capture the
--     StyleID ranked #1 (P1) and #2 (P2) via PreferenceSeq.
--  3) In Pairs, join the two sets where the first-two IDs match either in the same
--     order or reversed.  Finally return the entertainer’s stage name together with
--     the customer’s last name (limit 20 just to sample the result).
WITH Ent AS (
    SELECT
        es."EntertainerID",
        MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS S1,
        MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS S2
    FROM "Entertainer_Styles" es
    GROUP BY es."EntertainerID"
    HAVING COUNT(*) <= 3
),
Cust AS (
    SELECT
        mp."CustomerID",
        MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS P1,
        MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS P2
    FROM "Musical_Preferences" mp
    GROUP BY mp."CustomerID"
    HAVING COUNT(*) <= 3
),
Pairs AS (
    SELECT
        e."EntertainerID",
        c."CustomerID"
    FROM Ent e
    JOIN Cust c
      ON (c.P1 = e.S1 AND c.P2 = e.S2)   -- same order
       OR (c.P1 = e.S2 AND c.P2 = e.S1)  -- reversed order
)
SELECT DISTINCT
       en."EntStageName",
       cu."CustLastName"
FROM   Pairs p
JOIN   Entertainers en ON en."EntertainerID" = p."EntertainerID"
JOIN   Customers    cu ON cu."CustomerID"    = p."CustomerID"
LIMIT 20;
```
