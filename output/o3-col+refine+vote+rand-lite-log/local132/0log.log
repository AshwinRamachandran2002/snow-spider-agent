```sql
--Description: Match customers and entertainers whose first & second choices line up in the same order.  
WITH Ent AS (
      SELECT es."EntertainerID",
             MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS "S1",
             MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS "S2"
      FROM "Entertainer_Styles" es
      GROUP BY es."EntertainerID"
      HAVING COUNT(*) <= 3
),
Cust AS (
      SELECT mp."CustomerID",
             MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS "P1",
             MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS "P2"
      FROM "Musical_Preferences" mp
      GROUP BY mp."CustomerID"
      HAVING COUNT(*) <= 3
)
SELECT DISTINCT e."EntertainerID", c."CustomerID"
FROM Ent  e
JOIN Cust c
     ON  c."P1" = e."S1"
     AND c."P2" = e."S2"
LIMIT 20;
```

```sql
--Description: Match customers and entertainers when the customer’s first/second preferences match the entertainer’s second/first strengths (reverse order).  
WITH Ent AS (
      SELECT es."EntertainerID",
             MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS "S1",
             MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS "S2"
      FROM "Entertainer_Styles" es
      GROUP BY es."EntertainerID"
      HAVING COUNT(*) <= 3
),
Cust AS (
      SELECT mp."CustomerID",
             MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS "P1",
             MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS "P2"
      FROM "Musical_Preferences" mp
      GROUP BY mp."CustomerID"
      HAVING COUNT(*) <= 3
)
SELECT DISTINCT e."EntertainerID", c."CustomerID"
FROM Ent  e
JOIN Cust c
     ON  c."P1" = e."S2"
     AND c."P2" = e."S1"
LIMIT 20;
```

```sql
--Description: Combine both match directions, keeping only entertainer/customer pairs that satisfy either rule.  
WITH Ent AS (
      SELECT es."EntertainerID",
             MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS "S1",
             MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS "S2"
      FROM "Entertainer_Styles" es
      GROUP BY es."EntertainerID"
      HAVING COUNT(*) <= 3
),
Cust AS (
      SELECT mp."CustomerID",
             MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS "P1",
             MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS "P2"
      FROM "Musical_Preferences" mp
      GROUP BY mp."CustomerID"
      HAVING COUNT(*) <= 3
)
SELECT DISTINCT e."EntertainerID", c."CustomerID"
FROM Ent e
JOIN Cust c
  ON (c."P1" = e."S1" AND c."P2" = e."S2")
  OR (c."P1" = e."S2" AND c."P2" = e."S1")
LIMIT 20;
```

```sql
--Description: FINAL – show the entertainer’s stage name and the customer’s last name for every pair meeting the style-matching rules.  
WITH Ent AS (
      SELECT es."EntertainerID",
             MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS "S1",
             MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS "S2"
      FROM "Entertainer_Styles" es
      GROUP BY es."EntertainerID"
      HAVING COUNT(*) <= 3
),
Cust AS (
      SELECT mp."CustomerID",
             MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS "P1",
             MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS "P2"
      FROM "Musical_Preferences" mp
      GROUP BY mp."CustomerID"
      HAVING COUNT(*) <= 3
)
SELECT DISTINCT en."EntStageName",
                cu."CustLastName"
FROM            Ent            AS es
JOIN            Entertainers   AS en ON en."EntertainerID" = es."EntertainerID"
JOIN            Cust           AS cs
                  ON (cs."P1" = es."S1" AND cs."P2" = es."S2")
                  OR (cs."P1" = es."S2" AND cs."P2" = es."S1")
JOIN            Customers      AS cu ON cu."CustomerID" = cs."CustomerID"
LIMIT 20;
```
