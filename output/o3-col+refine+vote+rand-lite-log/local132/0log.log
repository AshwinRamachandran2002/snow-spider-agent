--             (P1 = S1 AND P2 = S2)  OR  (P1 = S2 AND P2 = S1),
--             provided each side has no more than three style rows.
WITH Ent AS (                       -- entertainers, keep strengths 1 & 2
     SELECT
         es."EntertainerID",
         MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS S1,
         MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS S2
     FROM "Entertainer_Styles" es
     GROUP BY es."EntertainerID"
     HAVING COUNT(*) <= 3
),
Cust AS (                           -- customers, keep prefs 1 & 2
     SELECT
         mp."CustomerID",
         MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS P1,
         MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS P2
     FROM "Musical_Preferences" mp
     GROUP BY mp."CustomerID"
     HAVING COUNT(*) <= 3
)
SELECT DISTINCT
       e."EntertainerID",
       c."CustomerID"
FROM   Ent  e
JOIN   Cust c
  ON  (c.P1 = e.S1 AND c.P2 = e.S2)
   OR (c.P1 = e.S2 AND c.P2 = e.S1)
LIMIT 20
