```sql
--Description: 1) Look at the style lookup table – what StyleID values mean.
SELECT DISTINCT "StyleID", "StyleName"
FROM "Musical_Styles"
LIMIT 20;
```

```sql
--Description: 2) Inspect the raw style-strength rows each entertainer has.
SELECT DISTINCT "EntertainerID", "StyleID", "StyleStrength"
FROM "Entertainer_Styles"
ORDER BY "EntertainerID", "StyleStrength" DESC
LIMIT 20;
```

```sql
--Description: 3) How many style strengths does every entertainer have?
SELECT DISTINCT "EntertainerID",
       COUNT(*) AS "StyleCnt"
FROM "Entertainer_Styles"
GROUP BY "EntertainerID"
LIMIT 20;
```

```sql
--Description: 4) How many musical preferences does every customer have?
SELECT DISTINCT "CustomerID",
       COUNT(*) AS "PrefCnt"
FROM "Musical_Preferences"
GROUP BY "CustomerID"
LIMIT 20;
```

```sql
--Description: 5) For each entertainer keep only the first three strongest styles
--   (rn = 1,2,3) based on StyleStrength descending, StyleID tie-breaker.
WITH e AS (
  SELECT "EntertainerID",
         "StyleID",
         ROW_NUMBER() OVER (PARTITION BY "EntertainerID"
                            ORDER BY "StyleStrength" DESC, "StyleID") AS rn
  FROM "Entertainer_Styles"
)
SELECT DISTINCT *
FROM e
WHERE rn <= 3
ORDER BY "EntertainerID", rn
LIMIT 20;
```

```sql
--Description: 6) For each customer keep only the first three preferences
--   (PreferenceSeq already stores ranking 1,2,3).
WITH c AS (
  SELECT "CustomerID",
         "StyleID",
         ROW_NUMBER() OVER (PARTITION BY "CustomerID"
                            ORDER BY "PreferenceSeq") AS rn
  FROM "Musical_Preferences"
)
SELECT DISTINCT *
FROM c
WHERE rn <= 3
ORDER BY "CustomerID", rn
LIMIT 20;
```

```sql
--Description: 7) Pairs where customer’s pref #1 = entertainer’s strength #1
--   AND customer’s pref #2 = entertainer’s strength #2 (same order).
WITH e AS (
  SELECT "EntertainerID",
         "StyleID",
         ROW_NUMBER() OVER (PARTITION BY "EntertainerID"
                            ORDER BY "StyleStrength" DESC, "StyleID") AS rn,
         COUNT(*) OVER (PARTITION BY "EntertainerID") AS e_cnt
  FROM "Entertainer_Styles"
),
c AS (
  SELECT "CustomerID",
         "StyleID",
         ROW_NUMBER() OVER (PARTITION BY "CustomerID"
                            ORDER BY "PreferenceSeq") AS rn,
         COUNT(*) OVER (PARTITION BY "CustomerID") AS c_cnt
  FROM "Musical_Preferences"
)
SELECT DISTINCT e1."EntertainerID", c1."CustomerID"
FROM e   e1
JOIN e   e2  ON e1."EntertainerID" = e2."EntertainerID" AND e2.rn = 2
JOIN c   c1  ON 1=1
JOIN c   c2  ON c1."CustomerID" = c2."CustomerID"        AND c2.rn = 2
WHERE e1.rn = 1
  AND c1.rn = 1
  AND e1."StyleID" = c1."StyleID"
  AND e2."StyleID" = c2."StyleID"
  AND e1.e_cnt <= 3
  AND c1.c_cnt <= 3
LIMIT 20;
```

```sql
--Description: 8) Pairs where customer pref #1 matches entertainer strength #2
--   AND customer pref #2 matches entertainer strength #1 (reverse order).
WITH e AS (
  SELECT "EntertainerID",
         "StyleID",
         ROW_NUMBER() OVER (PARTITION BY "EntertainerID"
                            ORDER BY "StyleStrength" DESC, "StyleID") AS rn,
         COUNT(*) OVER (PARTITION BY "EntertainerID") AS e_cnt
  FROM "Entertainer_Styles"
),
c AS (
  SELECT "CustomerID",
         "StyleID",
         ROW_NUMBER() OVER (PARTITION BY "CustomerID"
                            ORDER BY "PreferenceSeq") AS rn,
         COUNT(*) OVER (PARTITION BY "CustomerID") AS c_cnt
  FROM "Musical_Preferences"
)
SELECT DISTINCT e1."EntertainerID", c1."CustomerID"
FROM e   e1
JOIN e   e2  ON e1."EntertainerID" = e2."EntertainerID" AND e2.rn = 2
JOIN c   c1  ON 1=1
JOIN c   c2  ON c1."CustomerID" = c2."CustomerID"        AND c2.rn = 2
WHERE e1.rn = 1
  AND c1.rn = 1
  AND e1."StyleID" = c2."StyleID"
  AND e2."StyleID" = c1."StyleID"
  AND e1.e_cnt <= 3
  AND c1.c_cnt <= 3
LIMIT 20;
```

```sql
--Description: 9) Combine the two orderings, keep unique E-C pairs
--   and attach readable names.
WITH
e_ranks AS (
  SELECT "EntertainerID",
         "StyleID",
         ROW_NUMBER() OVER (PARTITION BY "EntertainerID"
                            ORDER BY "StyleStrength" DESC, "StyleID") AS rn,
         COUNT(*) OVER (PARTITION BY "EntertainerID") AS e_cnt
  FROM "Entertainer_Styles"
),
c_ranks AS (
  SELECT "CustomerID",
         "StyleID",
         ROW_NUMBER() OVER (PARTITION BY "CustomerID"
                            ORDER BY "PreferenceSeq") AS rn,
         COUNT(*) OVER (PARTITION BY "CustomerID") AS c_cnt
  FROM "Musical_Preferences"
),
pairs_same AS (
  SELECT e1."EntertainerID", c1."CustomerID"
  FROM e_ranks e1
  JOIN e_ranks e2 ON e1."EntertainerID" = e2."EntertainerID" AND e2.rn = 2
  JOIN c_ranks c1 ON e1."StyleID" = c1."StyleID"             AND c1.rn = 1
  JOIN c_ranks c2 ON c1."CustomerID" = c2."CustomerID"       AND c2.rn = 2
  WHERE e1.rn = 1
    AND e2."StyleID" = c2."StyleID"
    AND e1.e_cnt <= 3
    AND c1.c_cnt <= 3
),
pairs_rev AS (
  SELECT e1."EntertainerID", c1."CustomerID"
  FROM e_ranks e1
  JOIN e_ranks e2 ON e1."EntertainerID" = e2."EntertainerID" AND e2.rn = 2
  JOIN c_ranks c1 ON e2."StyleID" = c1."StyleID"             AND c1.rn = 1
  JOIN c_ranks c2 ON c1."CustomerID" = c2."CustomerID"       AND c2.rn = 2
  WHERE e1.rn = 1
    AND e1."StyleID" = c2."StyleID"
    AND e1.e_cnt <= 3
    AND c1.c_cnt <= 3
),
all_pairs AS (
  SELECT * FROM pairs_same
  UNION
  SELECT * FROM pairs_rev
)
SELECT DISTINCT ent."EntStageName"        AS "EntertainerStageName",
                cust."CustLastName"       AS "CustomerLastName"
FROM all_pairs p
JOIN "Entertainers" ent ON ent."EntertainerID" = p."EntertainerID"
JOIN "Customers"   cust ON cust."CustomerID"   = p."CustomerID"
LIMIT 20;
```

```sql
--Description: 10) Final concise answer – only stage name & customer last name
--   for every qualifying pair (no LIMIT here – fetch all).
WITH
e_ranks AS (
  SELECT "EntertainerID",
         "StyleID",
         ROW_NUMBER() OVER (PARTITION BY "EntertainerID"
                            ORDER BY "StyleStrength" DESC, "StyleID") AS rn,
         COUNT(*) OVER (PARTITION BY "EntertainerID") AS e_cnt
  FROM "Entertainer_Styles"
),
c_ranks AS (
  SELECT "CustomerID",
         "StyleID",
         ROW_NUMBER() OVER (PARTITION BY "CustomerID"
                            ORDER BY "PreferenceSeq") AS rn,
         COUNT(*) OVER (PARTITION BY "CustomerID") AS c_cnt
  FROM "Musical_Preferences"
),
pairs_same AS (
  SELECT e1."EntertainerID", c1."CustomerID"
  FROM e_ranks e1
  JOIN e_ranks e2 ON e1."EntertainerID" = e2."EntertainerID" AND e2.rn = 2
  JOIN c_ranks c1 ON e1."StyleID" = c1."StyleID"             AND c1.rn = 1
  JOIN c_ranks c2 ON c1."CustomerID" = c2."CustomerID"       AND c2.rn = 2
  WHERE e1.rn = 1
    AND e2."StyleID" = c2."StyleID"
    AND e1.e_cnt <= 3
    AND c1.c_cnt <= 3
),
pairs_rev AS (
  SELECT e1."EntertainerID", c1."CustomerID"
  FROM e_ranks e1
  JOIN e_ranks e2 ON e1."EntertainerID" = e2."EntertainerID" AND e2.rn = 2
  JOIN c_ranks c1 ON e2."StyleID" = c1."StyleID"             AND c1.rn = 1
  JOIN c_ranks c2 ON c1."CustomerID" = c2."CustomerID"       AND c2.rn = 2
  WHERE e1.rn = 1
    AND e1."StyleID" = c2."StyleID"
    AND e1.e_cnt <= 3
    AND c1.c_cnt <= 3
),
all_pairs AS (
  SELECT * FROM pairs_same
  UNION
  SELECT * FROM pairs_rev
)
SELECT DISTINCT ent."EntStageName"  AS "EntertainerStageName",
                cust."CustLastName" AS "CustomerLastName"
FROM all_pairs p
JOIN "Entertainers" ent ON ent."EntertainerID" = p."EntertainerID"
JOIN "Customers"   cust ON cust."CustomerID"   = p."CustomerID";
```
