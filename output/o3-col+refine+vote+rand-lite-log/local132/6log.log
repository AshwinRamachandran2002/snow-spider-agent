Query:
--Description: 7) Pairs where customer’s pref #1 = entertainer’s strength #1
--   AND customer’s pref #2 = entertainer’s strength #2 (same order).
WITH e AS (
  SELECT "EntertainerID",
         "StyleID",
         ROW_NUMBER() OVER (PARTITION BY "EntertainerID"
                            ORDER BY "StyleStrength" DESC, "StyleID") AS rn,
         COUNT(*) OVER (PARTITION BY "EntertainerID") AS e_cnt
  FROM "Entertainer_Styles"
),
c AS (
  SELECT "CustomerID",
         "StyleID",
         ROW_NUMBER() OVER (PARTITION BY "CustomerID"
                            ORDER BY "PreferenceSeq") AS rn,
         COUNT(*) OVER (PARTITION BY "CustomerID") AS c_cnt
  FROM "Musical_Preferences"
)
SELECT DISTINCT e1."EntertainerID", c1."CustomerID"
FROM e   e1
JOIN e   e2  ON e1."EntertainerID" = e2."EntertainerID" AND e2.rn = 2
JOIN c   c1  ON 1=1
JOIN c   c2  ON c1."CustomerID" = c2."CustomerID"        AND c2.rn = 2
WHERE e1.rn = 1
  AND c1.rn = 1
  AND e1."StyleID" = c1."StyleID"
  AND e2."StyleID" = c2."StyleID"
  AND e1.e_cnt <= 3
  AND c1.c_cnt <= 3
LIMIT 20;
