```sql
--Description: 9) Combine the ordered and reversed matches into one result set
SELECT DISTINCT "EntStageName", "CustLastName" FROM (
    /* ordered */
    SELECT  e."EntStageName", c."CustLastName"
    FROM    (SELECT  mp."CustomerID",
                    MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS "Pref1",
                    MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS "Pref2"
             FROM   "Musical_Preferences" AS mp
             GROUP BY mp."CustomerID"
             HAVING COUNT(*) <= 3) AS cp
    JOIN "Customers" AS c ON c."CustomerID" = cp."CustomerID"
    JOIN (SELECT es."EntertainerID",
                 MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS "Style1",
                 MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS "Style2"
          FROM   "Entertainer_Styles" AS es
          GROUP BY es."EntertainerID"
          HAVING COUNT(*) <= 3) AS st
         ON cp."Pref1" = st."Style1" AND cp."Pref2" = st."Style2"
    JOIN "Entertainers" AS e ON e."EntertainerID" = st."EntertainerID"
    UNION
    /* reversed */
    SELECT  e."EntStageName", c."CustLastName"
    FROM    (SELECT  mp."CustomerID",
                    MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS "Pref1",
                    MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS "Pref2"
             FROM   "Musical_Preferences" AS mp
             GROUP BY mp."CustomerID"
             HAVING COUNT(*) <= 3) AS cp
    JOIN "Customers" AS c ON c."CustomerID" = cp."CustomerID"
    JOIN (SELECT es."EntertainerID",
                 MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS "Style1",
                 MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS "Style2"
          FROM   "Entertainer_Styles" AS es
          GROUP BY es."EntertainerID"
          HAVING COUNT(*) <= 3) AS st
         ON cp."Pref1" = st."Style2" AND cp."Pref2" = st."Style1"
    JOIN "Entertainers" AS e ON e."EntertainerID" = st."EntertainerID"
) 
LIMIT 20;
