```sql
--Description: 9) Combine customer/entertainer matches into one result set (order-independent)
--             A pair is returned when BOTH of the customer’s first two preferences are found
--             within the entertainer’s first two style strengths, regardless of sequence.
WITH cp AS (          -- customers (≤3 prefs) and their first two preferences
    SELECT  mp."CustomerID",
            MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS "Pref1",
            MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS "Pref2"
    FROM    "Musical_Preferences" mp
    GROUP BY mp."CustomerID"
    HAVING  COUNT(*) <= 3
),
st AS (          -- entertainers (≤3 strengths) and their strongest two styles
    SELECT  es."EntertainerID",
            MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS "Style1",
            MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS "Style2"
    FROM    "Entertainer_Styles" es
    GROUP BY es."EntertainerID"
    HAVING  COUNT(*) <= 3
)
SELECT DISTINCT
       e."EntStageName",
       c."CustLastName"
FROM       cp
JOIN       "Customers"    c ON c."CustomerID"     = cp."CustomerID"
JOIN       st               ON  cp."Pref1" IN (st."Style1", st."Style2")
                            AND cp."Pref2" IN (st."Style1", st."Style2")
JOIN       "Entertainers" e ON e."EntertainerID" = st."EntertainerID"
LIMIT 20;
