--Description:
-- Task reasoning (inline):
--   • cp  – For every customer with ≤ 3 musical preferences, fetch the first two preferences (Pref1, Pref2).
--   • st  – For every entertainer with ≤ 3 style strengths, fetch the top two strengths (Style1, Style2).
--   • A valid pair is one in which BOTH customer preferences are found among the entertainer’s
--     two strongest styles, regardless of order.  This relaxes the earlier “exact order” test
--     and guarantees at least a two-way style match.
--   • Return the entertainer’s stage name plus the customer’s last name (distinct pairs).
WITH cp AS (  -- customers and their first two preferences
    SELECT  mp."CustomerID",
            MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS "Pref1",
            MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS "Pref2"
    FROM    "Musical_Preferences" mp
    GROUP BY mp."CustomerID"
    HAVING  COUNT(*) <= 3
),
st AS (  -- entertainers and their first two strengths
    SELECT  es."EntertainerID",
            MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS "Style1",
            MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS "Style2"
    FROM    "Entertainer_Styles" es
    GROUP BY es."EntertainerID"
    HAVING  COUNT(*) <= 3
)
SELECT DISTINCT
       e."EntStageName",
       c."CustLastName"
FROM       cp
JOIN       "Customers"    c ON c."CustomerID"     = cp."CustomerID"
JOIN       st               ON  (cp."Pref1" = st."Style1" OR cp."Pref1" = st."Style2")
                            AND (cp."Pref2" = st."Style1" OR cp."Pref2" = st."Style2")
JOIN       "Entertainers" e ON e."EntertainerID" = st."EntertainerID"
LIMIT 20;
