```sql
-- Description: List distinct page paths in activity_log that include the word 'detail'.
SELECT DISTINCT "path"
FROM "activity_log"
WHERE "path" LIKE '%/detail%'
LIMIT 20;
```

```sql
-- Description: Count how many '/detail' page views exist in activity_log.
SELECT COUNT(*) AS "detail_views"
FROM "activity_log"
WHERE "path" = '/detail';
```

```sql
-- Description: Show page-visit sequence for sessions that contain at least two '/detail' visits.
SELECT "session", "stamp", "path"
FROM "activity_log"
WHERE "session" IN (
  SELECT "session"
  FROM "activity_log"
  GROUP BY "session"
  HAVING SUM(CASE WHEN "path" = '/detail' THEN 1 ELSE 0 END) >= 2
)
ORDER BY "session", "stamp"
LIMIT 20;
```

```sql
-- Description: Build row numbers inside each session to identify two consecutive '/detail' visits and their following page.
WITH ordered AS (
  SELECT
    "session",
    "path",
    "stamp",
    ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp") AS rn
  FROM "activity_log"
)
SELECT o1."session",
       o1."stamp"  AS "first_detail_time",
       o2."stamp"  AS "second_detail_time",
       o3."stamp"  AS "third_page_time",
       o3."path"   AS "third_page"
FROM ordered o1
JOIN ordered o2 ON o2."session" = o1."session" AND o2.rn = o1.rn + 1
JOIN ordered o3 ON o3."session" = o1."session" AND o3.rn = o1.rn + 2
WHERE o1."path" = '/detail'
  AND o2."path" = '/detail'
LIMIT 20;
```

```sql
-- Description: Count the most frequent third-page visits observed immediately after two consecutive '/detail' page visits (top 3).
WITH ordered AS (
  SELECT
    "session",
    "path",
    "stamp",
    ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp") AS rn
  FROM "activity_log"
),
third_page_after_double_detail AS (
  SELECT o3."path" AS third_page
  FROM ordered o1
  JOIN ordered o2 ON o2."session" = o1."session" AND o2.rn = o1.rn + 1
  JOIN ordered o3 ON o3."session" = o1."session" AND o3.rn = o1.rn + 2
  WHERE o1."path" = '/detail'
    AND o2."path" = '/detail'
)
SELECT
  "third_page",
  COUNT(*) AS "occurrences"
FROM third_page_after_double_detail
GROUP BY "third_page"
ORDER BY "occurrences" DESC
LIMIT 3;
```
