```sql
-- 1) Show the different page-paths that are stored in activity_log
SELECT DISTINCT "path"
FROM "activity_log"
LIMIT 20;
```

```sql
-- 2) Check which paths look like product detail pages
SELECT DISTINCT "path"
FROM "activity_log"
WHERE "path" LIKE '%/detail%'
LIMIT 20;
```

```sql
-- 3) Look at one whole session in chronological order to see page sequences
SELECT "session", "stamp", "path"
FROM "activity_log"
WHERE "session" = '989004ea'          -- ← replace with any session you want to inspect
ORDER BY "stamp"
LIMIT 20;
```

```sql
-- 4) For every row add the immediately previous path (prev1) in the same session
SELECT
  "session",
  "stamp",
  "path",
  LAG("path",1) OVER (PARTITION BY "session" ORDER BY "stamp") AS "prev1"
FROM "activity_log"
LIMIT 20;
```

```sql
-- 5) For every row add the two previous paths (prev1, prev2) in the same session
SELECT
  "session",
  "stamp",
  "path",
  LAG("path",1) OVER (PARTITION BY "session" ORDER BY "stamp") AS "prev1",
  LAG("path",2) OVER (PARTITION BY "session" ORDER BY "stamp") AS "prev2"
FROM "activity_log"
LIMIT 20;
```

```sql
-- 6) Extract the candidate third-page visits that directly follow *two* consecutive '/detail' pages
SELECT
  "session",
  "stamp",
  "path"                   AS "third_page"
FROM (
  SELECT
    "session",
    "stamp",
    "path",
    LAG("path",1) OVER (PARTITION BY "session" ORDER BY "stamp") AS "prev1",
    LAG("path",2) OVER (PARTITION BY "session" ORDER BY "stamp") AS "prev2"
  FROM "activity_log"
)
WHERE "prev1" LIKE '%/detail%'  -- the 1st previous page
  AND "prev2" LIKE '%/detail%'  -- the 2nd previous page
LIMIT 20;
```

```sql
-- 7) FINAL ANSWER  – three most frequent third pages and their counts
SELECT
  "third_page",
  COUNT(*) AS "cnt"
FROM (
  SELECT
    "session",
    "stamp",
    "path" AS "third_page",
    LAG("path",1) OVER (PARTITION BY "session" ORDER BY "stamp") AS "prev1",
    LAG("path",2) OVER (PARTITION BY "session" ORDER BY "stamp") AS "prev2"
  FROM "activity_log"
)
WHERE "prev1" LIKE '%/detail%'   -- immediately after a detail page
  AND "prev2" LIKE '%/detail%'   -- and the page before that also a detail page
GROUP BY "third_page"
ORDER BY "cnt" DESC
LIMIT 3;
```
