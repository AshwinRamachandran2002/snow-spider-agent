```sql
-- 1. Preview activity_log to understand stamp ordering & path values  
SELECT "stamp", "session", "action", "option", "path"  
FROM "activity_log"  
ORDER BY "stamp"  
LIMIT 20;
```

```sql
-- 2. What kinds of pages contain the word “detail”?  
SELECT DISTINCT "path"  
FROM "activity_log"  
WHERE "path" LIKE '%/detail%'  
LIMIT 20;
```

```sql
-- 3. Check neighbouring pages around a “/detail” view for one session  
SELECT "session",
       "stamp",
       "path",
       LAG("path",1)  OVER (PARTITION BY "session" ORDER BY "stamp") AS prev_path,
       LEAD("path",1) OVER (PARTITION BY "session" ORDER BY "stamp") AS next_path
FROM "activity_log"
WHERE "session" = (SELECT "session" FROM "activity_log" WHERE "path" LIKE '%/detail%' LIMIT 1)
ORDER BY "stamp"
LIMIT 20;
```

```sql
-- 4. For every row, add the next two paths within the same session  
WITH ordered AS (
  SELECT "session",
         "stamp",
         "path",
         LEAD("path",1) OVER (PARTITION BY "session" ORDER BY "stamp") AS next_path,
         LEAD("path",2) OVER (PARTITION BY "session" ORDER BY "stamp") AS third_path
  FROM "activity_log"
)
SELECT *  
FROM ordered  
LIMIT 20;
```

```sql
-- 5. Extract only the cases where the first and second pages are “/detail”  
WITH ordered AS (
  SELECT "session",
         "path",
         LEAD("path",1) OVER (PARTITION BY "session" ORDER BY "stamp") AS next_path,
         LEAD("path",2) OVER (PARTITION BY "session" ORDER BY "stamp") AS third_path
  FROM "activity_log"
)
SELECT "session", "path" AS first_page, next_path AS second_page, third_path  
FROM ordered  
WHERE "path"      LIKE '%/detail%'  
  AND next_path   LIKE '%/detail%'  
  AND third_path IS NOT NULL  
LIMIT 20;
```

```sql
-- 6. Count every distinct third-page that appears after two consecutive “/detail” pages  
WITH ordered AS (
  SELECT "session",
         "path",
         LEAD("path",1) OVER (PARTITION BY "session" ORDER BY "stamp") AS next_path,
         LEAD("path",2) OVER (PARTITION BY "session" ORDER BY "stamp") AS third_path
  FROM "activity_log"
), triples AS (
  SELECT third_path
  FROM ordered
  WHERE "path"    LIKE '%/detail%'
    AND next_path LIKE '%/detail%'
    AND third_path IS NOT NULL
)
SELECT third_path, COUNT(*) AS visit_cnt
FROM triples
GROUP BY third_path
ORDER BY visit_cnt DESC
LIMIT 20;
```

```sql
-- 7. Show the final ranking – the three most frequent third-page visits  
WITH ordered AS (
  SELECT "session",
         "path",
         LEAD("path",1) OVER (PARTITION BY "session" ORDER BY "stamp") AS next_path,
         LEAD("path",2) OVER (PARTITION BY "session" ORDER BY "stamp") AS third_path
  FROM "activity_log"
), triples AS (
  SELECT third_path
  FROM ordered
  WHERE "path"    LIKE '%/detail%'
    AND next_path LIKE '%/detail%'
    AND third_path IS NOT NULL
)
SELECT third_path  AS "third_page",
       COUNT(*)    AS "occurrences"
FROM triples
GROUP BY third_path
ORDER BY "occurrences" DESC, "third_page"
LIMIT 3;
```

