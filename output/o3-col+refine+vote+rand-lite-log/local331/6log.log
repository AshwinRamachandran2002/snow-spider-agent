```sql
-- Description: 1) Inspect the variety of paths recorded in the “activity_log”.
SELECT DISTINCT "path"
FROM "activity_log"
LIMIT 20;
```

```sql
-- Description: 2) Check how many “detail”-page views exist (any path that starts with “/detail”).
SELECT DISTINCT "session", "stamp", "path"
FROM "activity_log"
WHERE "path" LIKE '/detail%'
ORDER BY "session", "stamp"
LIMIT 20;
```

```sql
-- Description: 3) For every row keep the two immediately-preceding paths in the same session (using window functions).
SELECT
  "session",
  "stamp",
  "path",
  LAG("path",1) OVER (PARTITION BY "session" ORDER BY "stamp")  AS "prev_path_1",
  LAG("path",2) OVER (PARTITION BY "session" ORDER BY "stamp")  AS "prev_path_2"
FROM "activity_log"
ORDER BY "session", "stamp"
LIMIT 20;
```

```sql
-- Description: 4) Extract rows whose two previous paths were both “/detail…”; keep the current (third) page only.
SELECT
  "path" AS "third_page_path"
FROM (
  SELECT
    "session",
    "path",
    LAG("path",1) OVER (PARTITION BY "session" ORDER BY "stamp") AS "prev1",
    LAG("path",2) OVER (PARTITION BY "session" ORDER BY "stamp") AS "prev2"
  FROM "activity_log"
) AS t
WHERE "prev1" LIKE '/detail%'   -- second page
  AND "prev2" LIKE '/detail%'   -- first page
LIMIT 20;
```

```sql
-- Description: 5) Count how many times each such third page occurs.
SELECT
  "third_page_path",
  COUNT(*) AS "visit_cnt"
FROM (
  SELECT
    "path" AS "third_page_path",
    LAG("path",1) OVER (PARTITION BY "session" ORDER BY "stamp") AS "prev1",
    LAG("path",2) OVER (PARTITION BY "session" ORDER BY "stamp") AS "prev2"
  FROM "activity_log"
) AS t
WHERE "prev1" LIKE '/detail%'
  AND "prev2" LIKE '/detail%'
GROUP BY "third_page_path"
ORDER BY "visit_cnt" DESC
LIMIT 20;
```

```sql
-- Description: 6) FINAL ANSWER – the three most frequent third-page visits and their counts.
SELECT
  "third_page_path"      AS "third_page_after_two_detail",
  COUNT(*)               AS "times_observed"
FROM (
  SELECT
    "session",
    "path" AS "third_page_path",
    LAG("path",1) OVER (PARTITION BY "session" ORDER BY "stamp") AS "prev1",
    LAG("path",2) OVER (PARTITION BY "session" ORDER BY "stamp") AS "prev2"
  FROM "activity_log"
) AS seq
WHERE "prev1" LIKE '/detail%'
  AND "prev2" LIKE '/detail%'
GROUP BY "third_page_path"
ORDER BY "times_observed" DESC
LIMIT 3;
```
