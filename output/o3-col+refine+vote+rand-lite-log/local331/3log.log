```sql
-- Description: For every hit, show the previous 1-step and 2-step paths within the same session
SELECT
  "session",
  "stamp",
  "path"                                     AS current_path,
  LAG("path", 1) OVER (PARTITION BY "session" ORDER BY "stamp") AS prev_path_1,
  LAG("path", 2) OVER (PARTITION BY "session" ORDER BY "stamp") AS prev_path_2
FROM "activity_log"
LIMIT 20;
```

```sql
-- Description: Filter only those rows where the two immediately previous pages were “/detail”
SELECT
  "session",
  "stamp",
  "path"  AS third_page
FROM (
  SELECT
    "session",
    "stamp",
    "path",
    LAG("path", 1) OVER (PARTITION BY "session" ORDER BY "stamp") AS prev1,
    LAG("path", 2) OVER (PARTITION BY "session" ORDER BY "stamp") AS prev2
  FROM "activity_log"
) AS t
WHERE prev1 LIKE '/detail%' AND prev2 LIKE '/detail%'
LIMIT 20;
```

```sql
-- Description: Count every third-page path that follows two consecutive “/detail” pages
SELECT
  "third_page",
  COUNT(*) AS visit_cnt
FROM (
  SELECT
    "path" AS third_page,
    LAG("path", 1) OVER (PARTITION BY "session" ORDER BY "stamp") AS prev1,
    LAG("path", 2) OVER (PARTITION BY "session" ORDER BY "stamp") AS prev2
  FROM "activity_log"
) AS seq
WHERE prev1 LIKE '/detail%' AND prev2 LIKE '/detail%'
GROUP BY "third_page"
ORDER BY visit_cnt DESC;
```

```sql
-- Description: Retrieve the top three most frequent third-page paths and their counts
SELECT
  "third_page",
  COUNT(*) AS visit_cnt
FROM (
  SELECT
    "path" AS third_page,
    LAG("path", 1) OVER (PARTITION BY "session" ORDER BY "stamp") AS prev1,
    LAG("path", 2) OVER (PARTITION BY "session" ORDER BY "stamp") AS prev2
  FROM "activity_log"
) AS seq
WHERE prev1 LIKE '/detail%' AND prev2 LIKE '/detail%'
GROUP BY "third_page"
ORDER BY visit_cnt DESC
LIMIT 3;
