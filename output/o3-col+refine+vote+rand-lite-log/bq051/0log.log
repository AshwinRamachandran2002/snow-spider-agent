      SELECT DATE AS prcp_date,
             CASE WHEN value/10.0 > 5 THEN 'Rainy' ELSE 'Non-rainy' END AS rain_flag
      FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
      WHERE id = 'USW00094728'
        AND element = 'PRCP'
        AND qflag IS NULL
     ) AS prcp
ON trips.trip_date = prcp.prcp_date
GROUP BY prcp.rain_flag
