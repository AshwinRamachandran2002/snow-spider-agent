  prcp.rain_flag,
  ROUND(AVG(trips.trips),0) AS average_daily_citibike_trips_2016
FROM (
      SELECT DATE(starttime) AS trip_date,
             COUNT(*)        AS trips
      FROM `bigquery-public-data.new_york.citibike_trips`
