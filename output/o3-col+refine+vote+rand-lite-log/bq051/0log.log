Query:
-- 7. Combine trips with precipitation & flag rainy days (>5 mm)
WITH prcp AS (
  SELECT
    date          AS prcp_date,
    value/10.0    AS prcp_mm,
    CASE WHEN value/10.0 > 5 THEN 1 ELSE 0 END AS is_rainy
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id='USW00094728' AND element='PRCP' AND qflag IS NULL
),
trips AS (
  SELECT
    DATE(starttime) AS trip_date,
    COUNT(*)        AS trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime)=2016
  GROUP BY trip_date
)
SELECT
  t.trip_date,
  t.trips,
  p.prcp_mm,
  p.is_rainy
FROM trips t
LEFT JOIN prcp p
ON t.trip_date = p.prcp_date
ORDER BY t.trip_date
LIMIT 20;
