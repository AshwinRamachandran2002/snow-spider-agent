--Description (thinking process):
--  • Goal: compare average Citi Bike trips on “Rainy” vs “Non-rainy” 2016 days.
--  • Weather: choose Central Park station (USW00094728); it is <4 km from downtown and has a complete 2016 record.
--  • Rain definition: total-day precipitation > 5 mm (raw GHCN PRCP / 10).
--  • Steps:
--      1. prcp CTE → pull 2016 PRCP, convert to mm, label each date Rainy/Non-rainy, keep only good (qflag IS NULL).
--      2. trips CTE → count Citi Bike rides per calendar day in 2016.
--      3. Join on date; aggregate average trips for each weather flag.
--  • Output: two rows with average trips on Rainy and Non-rainy days.

WITH prcp AS (
  SELECT
    DATE              AS prcp_date,
    CASE WHEN value/10.0 > 5 THEN 'Rainy' ELSE 'Non-rainy' END AS rain_flag
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id = 'USW00094728'             -- Central Park
    AND element = 'PRCP'
    AND qflag  IS NULL
),
trips AS (
  SELECT
    DATE(starttime) AS trip_date,
    COUNT(*)        AS trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime) = 2016
  GROUP BY trip_date
)
SELECT
  p.rain_flag,
  AVG(t.trips) AS avg_daily_trips
FROM trips t
JOIN prcp p
  ON t.trip_date = p.prcp_date
GROUP BY p.rain_flag;
