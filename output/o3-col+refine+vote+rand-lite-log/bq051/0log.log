--Description:  One-step answer: average daily Citi Bike trips in 2016 for each weather class (Rainy / Non-rainy),
--              using Central Park precipitation.  Ensures AVG receives only the numeric trips column.
SELECT
  prcp.rain_flag,
  ROUND(AVG(trips.trips),0) AS average_daily_citibike_trips_2016
FROM (
      SELECT DATE(starttime) AS trip_date,
             COUNT(*)        AS trips
      FROM `bigquery-public-data.new_york.citibike_trips`
      WHERE EXTRACT(YEAR FROM starttime) = 2016
      GROUP BY trip_date
     ) AS trips
JOIN (
      SELECT DATE AS prcp_date,
             CASE WHEN value/10.0 > 5 THEN 'Rainy' ELSE 'Non-rainy' END AS rain_flag
      FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
      WHERE id = 'USW00094728'
        AND element = 'PRCP'
        AND qflag IS NULL
     ) AS prcp
ON trips.trip_date = prcp.prcp_date
GROUP BY prcp.rain_flag
