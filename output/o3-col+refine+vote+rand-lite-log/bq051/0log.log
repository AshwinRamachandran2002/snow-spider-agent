```sql
-- 8. Average Citi Bike trips on rainy vs non-rainy days in 2016
WITH prcp AS (
  SELECT
    date                         AS prcp_date,
    CASE WHEN value/10.0 > 5 THEN 'Rainy' ELSE 'Non-rainy' END AS rain_flag
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id='USW00094728' AND element='PRCP' AND qflag IS NULL
),
trips AS (
  SELECT
    DATE(starttime) AS trip_date,
    COUNT(*)        AS trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime)=2016
  GROUP BY trip_date
)
SELECT
  rain_flag,
  AVG(trips) AS avg_daily_trips
FROM trips
JOIN prcp
  ON trips.trip_date = prcp.prcp_date
GROUP BY rain_flag
LIMIT 20;
```

```sql
-- 9. (Optional) Show the difference between averages
WITH summary AS (
  SELECT
    rain_flag,
    AVG(trips) AS avg_daily_trips
  FROM (
    SELECT DATE(starttime) AS trip_date, COUNT(*) AS trips
    FROM `bigquery-public-data.new_york.citibike_trips`
    WHERE EXTRACT(YEAR FROM starttime)=2016
    GROUP BY trip_date
  ) t
  JOIN (
    SELECT date AS prcp_date,
           CASE WHEN value/10.0 > 5 THEN 'Rainy' ELSE 'Non-rainy' END AS rain_flag
    FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
    WHERE id='USW00094728' AND element='PRCP' AND qflag IS NULL
  ) p
  ON t.trip_date=p.prcp_date
  GROUP BY rain_flag
)
SELECT
  MAX(CASE WHEN rain_flag='Rainy'     THEN avg_daily_trips END) AS avg_trips_rainy,
  MAX(CASE WHEN rain_flag='Non-rainy' THEN avg_daily_trips END) AS avg_trips_non_rainy,
  MAX(CASE WHEN rain_flag='Non-rainy' THEN avg_daily_trips END) -
  MAX(CASE WHEN rain_flag='Rainy'     THEN avg_daily_trips END) AS difference
FROM summary;
```

```sql
-- 10. Final concise answer in one shot
SELECT
  rain_flag,
  ROUND(AVG(trips)) AS average_daily_citibike_trips_2016
FROM (
  SELECT DATE(starttime) AS trip_date, COUNT(*) AS trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime)=2016
  GROUP BY trip_date
) trips
JOIN (
  SELECT date AS prcp_date,
         CASE WHEN value/10.0 > 5 THEN 'Rainy' ELSE 'Non-rainy' END AS rain_flag
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  WHERE id='USW00094728'
    AND element='PRCP'
    AND qflag IS NULL
) prcp
ON trips.trip_date = prcp.prcp_date
GROUP BY rain_flag;
```
