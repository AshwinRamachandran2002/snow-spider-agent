```sql
--Description:
--THINKING PROCESS INLINE AS COMMENTS → single SQL returning the requested dataset
--1.  Build a sub-query “fatals” from person_2016
--      • persons_in_accident  = # distinct people
--      • fatal_persons        = # people whose injury_severity = 4
--      • keep only rows where persons_in_accident > 1 (requirement)
--2.  Build sub-query “sd” from vehicle_2016
--      • keep vehicle rows with travel_speed ∈ [0,151]  (exclude 997-999)
--      • keep rows with speed_limit  ∈ [5,80]   (exclude 98-99)
--      • avg_diff = AVG(|travel_speed − speed_limit|) per accident
--3.  Build sub-query “v” to fetch ANY body_type per accident
--4.  Join accident_2016 (a) with sd, v, fatals
--5.  Create predictors + engineered speed_diff_level bucketed in 20-mph steps
--6.  work_zone is TEXT, so compare to string 'None' for binary flag
--7.  multi_fatal_label = 1 when fatal_persons > 1 else 0
--8.  LIMIT 20 just to view a sample
SELECT
  a.state_number,
  v.body_type,
  a.number_of_drunk_drivers,
  a.day_of_week,
  a.hour_of_crash,
  CASE WHEN a.work_zone = 'None' THEN 0 ELSE 1 END AS in_work_zone,
  CASE
    WHEN sd.avg_diff < 20 THEN 0
    WHEN sd.avg_diff < 40 THEN 1
    WHEN sd.avg_diff < 60 THEN 2
    WHEN sd.avg_diff < 80 THEN 3
    ELSE 4
  END AS speed_diff_level,
  CASE WHEN fatals.fatal_persons > 1 THEN 1 ELSE 0 END AS multi_fatal_label
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` AS a
JOIN (
    SELECT
      state_number,
      consecutive_number,
      AVG(ABS(travel_speed - speed_limit)) AS avg_diff
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
    WHERE travel_speed BETWEEN 0 AND 151
      AND speed_limit  BETWEEN 5 AND 80
    GROUP BY state_number, consecutive_number
) AS sd
  ON a.state_number = sd.state_number
 AND a.consecutive_number = sd.consecutive_number
JOIN (
    SELECT
      state_number,
      consecutive_number,
      ANY_VALUE(body_type) AS body_type
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
    GROUP BY state_number, consecutive_number
) AS v
  ON a.state_number = v.state_number
 AND a.consecutive_number = v.consecutive_number
JOIN (
    SELECT
      state_number,
      consecutive_number,
      COUNT(DISTINCT person_number)                       AS persons_in_accident,
      SUM(CASE WHEN injury_severity = 4 THEN 1 ELSE 0 END) AS fatal_persons
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
    GROUP BY state_number, consecutive_number
    HAVING persons_in_accident > 1
) AS fatals
  ON a.state_number = fatals.state_number
 AND a.consecutive_number = fatals.consecutive_number
LIMIT 20;
