```sql
--Description:
--9) Build the label (1 if >1 fatal persons) for accidents with >1 person
SELECT
  cnt.state_number,
  cnt.consecutive_number,
  CASE WHEN fatals.fatal_persons > 1 THEN 1 ELSE 0 END AS multi_fatal_label
FROM (
  SELECT state_number, consecutive_number,
         COUNT(DISTINCT person_number) AS persons_in_accident
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
  GROUP BY state_number, consecutive_number
  HAVING persons_in_accident > 1
) AS cnt
LEFT JOIN (
  SELECT state_number, consecutive_number,
         SUM(CASE WHEN injury_severity = 4 THEN 1 ELSE 0 END) AS fatal_persons
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
  GROUP BY state_number, consecutive_number
) AS fatals
USING (state_number, consecutive_number)
LIMIT 20;
```

```sql
--Description:
--10) Final feature set (plus engineered speed_diff_level) for modelling
SELECT
  a.state_number,
  v.body_type,
  a.number_of_drunk_drivers,
  a.day_of_week,
  a.hour_of_crash,
  CASE WHEN a.work_zone = 0 THEN 0 ELSE 1 END AS in_work_zone,
  -- engineered avg |travel_speed - speed_limit| bucketed 0-4
  CASE
    WHEN avg_diff < 20 THEN 0
    WHEN avg_diff < 40 THEN 1
    WHEN avg_diff < 60 THEN 2
    WHEN avg_diff < 80 THEN 3
    ELSE 4
  END AS speed_diff_level,
  -- label
  CASE WHEN fatals.fatal_persons > 1 THEN 1 ELSE 0 END AS multi_fatal_label
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` AS a
JOIN (
  -- average absolute speed difference per accident using only valid codes
  SELECT
    state_number,
    consecutive_number,
    AVG(ABS(travel_speed - speed_limit)) AS avg_diff
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  WHERE travel_speed BETWEEN 0 AND 151
    AND speed_limit BETWEEN 5 AND 80
  GROUP BY state_number, consecutive_number
) AS sd
USING (state_number, consecutive_number)
JOIN (
  -- take one representative vehicle row to supply body_type
  SELECT AS STRUCT *
  FROM (
    SELECT
      state_number,
      consecutive_number,
      ANY_VALUE(body_type) AS body_type
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
    GROUP BY state_number, consecutive_number
  )
) AS v
USING (state_number, consecutive_number)
JOIN (
  -- counts of fatal persons per accident
  SELECT
    state_number,
    consecutive_number,
    SUM(CASE WHEN injury_severity = 4 THEN 1 ELSE 0 END) AS fatal_persons,
    COUNT(DISTINCT person_number) AS persons_in_accident
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
  GROUP BY state_number, consecutive_number
  HAVING persons_in_accident > 1      -- keep only multi-person accidents
) AS fatals
USING (state_number, consecutive_number)
LIMIT 20;
```
