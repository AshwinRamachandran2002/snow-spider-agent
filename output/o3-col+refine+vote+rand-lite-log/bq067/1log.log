```sql
--Description: Build a 20-row sample of the final labelled dataset (one row per crash).
--  • Step-1 (person_agg): keep crashes that involve >1 distinct person and count
--    how many of those persons had fatal injuries (injury_severity = 4).
--  • Step-2 (speed_bins): for each crash, compute the average absolute difference
--    between travel_speed and speed_limit, using only valid numeric codes
--    (travel_speed 0-151; speed_limit 5-80), then bucket that average into
--    20-mph intervals 0-4.
--  • Main SELECT: join accident_2016 with the two CTEs and vehicle_2016;
--    – body_type        : ANY_VALUE from the vehicles in the crash
--    – work_zone_ind    : 1 if work_zone is not NULL and not 'None' (work_zone is STRING)
--    – label            : 1 if the crash has >1 fatality, else 0.
WITH person_agg AS (
  SELECT
    state_number,
    consecutive_number,
    COUNT(DISTINCT person_number)            AS person_cnt,
    COUNTIF(injury_severity = 4)             AS fatal_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
  GROUP BY state_number, consecutive_number
  HAVING person_cnt > 1
),
speed_bins AS (
  SELECT
    state_number,
    consecutive_number,
    CASE
      WHEN avg_diff < 20 THEN 0
      WHEN avg_diff < 40 THEN 1
      WHEN avg_diff < 60 THEN 2
      WHEN avg_diff < 80 THEN 3
      ELSE 4
    END AS speed_diff_bin
  FROM (
    SELECT
      state_number,
      consecutive_number,
      AVG(ABS(travel_speed - speed_limit)) AS avg_diff
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
    WHERE travel_speed BETWEEN 0 AND 151      -- exclude special codes 997-999
      AND speed_limit  BETWEEN 5 AND 80       -- exclude special codes 98-99
    GROUP BY state_number, consecutive_number
  )
)
SELECT
  a.state_number,
  a.consecutive_number,
  ANY_VALUE(v.body_type)                     AS body_type,
  a.number_of_drunk_drivers,
  a.day_of_week,
  a.hour_of_crash,
  IF(a.work_zone IS NOT NULL
     AND a.work_zone != 'None', 1, 0)        AS work_zone_ind,
  sb.speed_diff_bin,
  IF(p.fatal_cnt > 1, 1, 0)                  AS label
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` a
JOIN person_agg           p  USING (state_number, consecutive_number)
LEFT JOIN speed_bins      sb USING (state_number, consecutive_number)
LEFT JOIN `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016` v
       USING (state_number, consecutive_number)
GROUP BY
