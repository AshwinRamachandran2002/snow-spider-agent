--Description: Return a 20-row sample of multi-person crashes whose label = 0  
--             (no more than one fatal injury), fixing the work-zone indicator
--             comparison exactly as in the corrected main build query.  
--             Steps:  
--               1. person_agg  – keep crashes with >1 person & count fatals.  
--               2. speed_bins  – compute avg |travel_speed-speed_limit| for valid codes and bucket it.  
--               3. Main SELECT – join accident, vehicle, person_agg, speed_bins;  
--                  • work_zone_ind = 1 if work_zone IS NOT NULL AND <> 'None'.  
--                  • label        = 1 when fatal_cnt > 1, else 0.  
--               4. Filter label = 0, LIMIT 20.
WITH person_agg AS (
  SELECT
    state_number,
    consecutive_number,
    COUNT(DISTINCT person_number)            AS person_cnt,
    COUNTIF(injury_severity = 4)             AS fatal_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
  GROUP BY state_number, consecutive_number
  HAVING person_cnt > 1
),
speed_bins AS (
  SELECT
    state_number,
    consecutive_number,
    CASE
      WHEN avg_diff < 20 THEN 0
      WHEN avg_diff < 40 THEN 1
      WHEN avg_diff < 60 THEN 2
      WHEN avg_diff < 80 THEN 3
      ELSE 4
    END AS speed_diff_bin
  FROM (
    SELECT
      state_number,
      consecutive_number,
      AVG(ABS(travel_speed - speed_limit)) AS avg_diff
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
    WHERE travel_speed BETWEEN 0 AND 151        -- exclude codes 997-999
      AND speed_limit  BETWEEN 5 AND 80         -- exclude codes 98-99
    GROUP BY state_number, consecutive_number
  )
)
SELECT
  a.state_number,
  a.consecutive_number,
  ANY_VALUE(v.body_type)                     AS body_type,
  a.number_of_drunk_drivers,
  a.day_of_week,
  a.hour_of_crash,
  IF(a.work_zone IS NOT NULL
     AND a.work_zone != 'None', 1, 0)        AS work_zone_ind,
  sb.speed_diff_bin,
  0 AS label                                 -- ensured by WHERE clause
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` a
JOIN person_agg           p  USING (state_number, consecutive_number)
LEFT JOIN speed_bins      sb USING (state_number, consecutive_number)
LEFT JOIN `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016` v
       USING (state_number, consecutive_number)
WHERE p.fatal_cnt <= 1                         -- label = 0
GROUP BY
  a.state_number,
  a.consecutive_number,
  a.number_of_drunk_drivers,
  a.day_of_week,
  a.hour_of_crash,
