```sql
--Description: Find crashes that involve more than one distinct person and count fatal injuries per crash
SELECT `state_number`,
       `consecutive_number`,
       COUNT(DISTINCT `person_number`)            AS person_cnt,
       COUNTIF(`injury_severity` = 4)             AS fatal_cnt
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
GROUP BY `state_number`, `consecutive_number`
HAVING person_cnt > 1
LIMIT 20;
```

```sql
--Description: Look at the different vehicle body types present in 2016 fatal crashes
SELECT DISTINCT `body_type`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
LIMIT 20;
```

```sql
--Description: Inspect plausible travel speeds (0-151 mph) and their distribution
SELECT DISTINCT `travel_speed`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
WHERE `travel_speed` BETWEEN 0 AND 151
ORDER BY `travel_speed`
LIMIT 20;
```

```sql
--Description: Compute the average absolute speed-difference per crash after filtering out special codes
SELECT `state_number`,
       `consecutive_number`,
       AVG(ABS(`travel_speed` - `speed_limit`)) AS avg_speed_diff
FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
WHERE `travel_speed` BETWEEN 0 AND 151           -- keep measured speeds only
  AND `speed_limit`  BETWEEN 5 AND 80            -- keep posted limits only
GROUP BY `state_number`, `consecutive_number`
LIMIT 20;
```

```sql
--Description: Bucket the average speed-difference into 20 mph ranges (0-4) for each crash
SELECT `state_number`,
       `consecutive_number`,
       CASE
         WHEN avg_speed_diff < 20 THEN 0
         WHEN avg_speed_diff < 40 THEN 1
         WHEN avg_speed_diff < 60 THEN 2
         WHEN avg_speed_diff < 80 THEN 3
         ELSE 4
       END AS speed_diff_bin
FROM (
  SELECT `state_number`,
         `consecutive_number`,
         AVG(ABS(`travel_speed` - `speed_limit`)) AS avg_speed_diff
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  WHERE `travel_speed` BETWEEN 0 AND 151
    AND `speed_limit`  BETWEEN 5 AND 80
  GROUP BY `state_number`, `consecutive_number`
)
LIMIT 20;
```

```sql
--Description: Assemble the labeled feature set (one row per crash) ready for modelling
SELECT a.`state_number`,
       ANY_VALUE(v.`body_type`)                    AS body_type,
       a.`number_of_drunk_drivers`,
       a.`day_of_week`,
       a.`hour_of_crash`,
       IF(a.`work_zone` = 0, 0, 1)                AS work_zone_ind,
       sd.`speed_diff_bin`,
       IF(p.fatal_cnt > 1, 1, 0)                  AS label              -- 1: >1 fatality
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` a
JOIN (
  -- person aggregation: crashes with >1 person
  SELECT `state_number`,
         `consecutive_number`,
         COUNT(DISTINCT `person_number`)            AS person_cnt,
         COUNTIF(`injury_severity` = 4)             AS fatal_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
  GROUP BY `state_number`, `consecutive_number`
  HAVING person_cnt > 1
) p
ON  a.`state_number`       = p.`state_number`
AND a.`consecutive_number` = p.`consecutive_number`
JOIN (
  -- speed-difference buckets
  SELECT `state_number`,
         `consecutive_number`,
         CASE
           WHEN avg_speed_diff < 20 THEN 0
           WHEN avg_speed_diff < 40 THEN 1
           WHEN avg_speed_diff < 60 THEN 2
           WHEN avg_speed_diff < 80 THEN 3
           ELSE 4
         END AS speed_diff_bin
  FROM (
    SELECT `state_number`,
           `consecutive_number`,
           AVG(ABS(`travel_speed` - `speed_limit`)) AS avg_speed_diff
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
    WHERE `travel_speed` BETWEEN 0 AND 151
      AND `speed_limit`  BETWEEN 5 AND 80
    GROUP BY `state_number`, `consecutive_number`
  )
) sd
ON  a.`state_number`       = sd.`state_number`
AND a.`consecutive_number` = sd.`consecutive_number`
JOIN `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016` v
ON  a.`state_number`       = v.`state_number`
AND a.`consecutive_number` = v.`consecutive_number`
LIMIT 20;
```

```sql
--Description: Show a sample of multi-person crashes with no more than one fatality (label = 0)
SELECT *
FROM (
  -- re-use the previous assembled dataset
