```sql
--Description:  The join error occurs because `consecutive_number` is STRING in
--              `accident_2016` but INT64 in `vehicle_2016`.  To fix it, we CAST
--              the INT64 from VEHICLE to STRING so both sides share the same type,
--              then join on the harmonised keys (`state_number`, `consecutive_number`).
--              • vehicle_redux  – one row per crash with the smallest BODY_TYPE
--                (proxy vehicle feature), casting the key to STRING.
--              • accident_core  – required accident-level predictors plus a binary
--                work-zone flag (0 = None, 1 = any work zone).
--              Finally we join the CTEs and preview 20 combined rows; this verifies
--              the type mismatch is resolved.
WITH vehicle_redux AS (
  SELECT
      state_number,
      CAST(consecutive_number AS STRING) AS consecutive_number,  -- harmonise to STRING
      MIN(body_type) AS body_type_min
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  GROUP BY state_number, consecutive_number
),
accident_core AS (
  SELECT
      state_number,
      consecutive_number,                                        -- already STRING
      day_of_week,
      hour_of_crash,
      CASE WHEN work_zone = 0 THEN 0 ELSE 1 END AS in_work_zone,
      number_of_drunk_drivers
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
)
SELECT
    a.state_number,
    a.consecutive_number,
    v.body_type_min        AS body_type,
    a.number_of_drunk_drivers,
    a.day_of_week,
    a.hour_of_crash,
    a.in_work_zone
FROM accident_core a
JOIN vehicle_redux v
  ON a.state_number       = v.state_number
 AND a.consecutive_number = v.consecutive_number
LIMIT 20;
