-- 7) Description:  Average the absolute speed-difference per accident
WITH valid_speeds AS (
  SELECT state_number, consecutive_number,
         ABS(travel_speed - speed_limit) AS abs_speed_diff
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  WHERE  travel_speed BETWEEN 0 AND 151
     AND speed_limit  BETWEEN 5 AND 80 )
SELECT state_number,
       consecutive_number,
       AVG(abs_speed_diff) AS avg_abs_speed_diff
FROM   valid_speeds
GROUP  BY state_number, consecutive_number
LIMIT 20;
