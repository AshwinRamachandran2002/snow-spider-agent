```sql
-- 7) Description:  Average the absolute speed-difference per accident
WITH valid_speeds AS (
  SELECT state_number, consecutive_number,
         ABS(travel_speed - speed_limit) AS abs_speed_diff
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  WHERE  travel_speed BETWEEN 0 AND 151
     AND speed_limit  BETWEEN 5 AND 80 )
SELECT state_number,
       consecutive_number,
       AVG(abs_speed_diff) AS avg_abs_speed_diff
FROM   valid_speeds
GROUP  BY state_number, consecutive_number
LIMIT 20;
```

```sql
-- 8) Description:  Bucket the average absolute speed-difference into 0–4 (20-mph width)
WITH avg_diff AS (
  SELECT state_number, consecutive_number,
         AVG(ABS(travel_speed - speed_limit)) AS avg_abs_speed_diff
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  WHERE  travel_speed BETWEEN 0 AND 151
     AND speed_limit  BETWEEN 5 AND 80
  GROUP  BY state_number, consecutive_number )
SELECT state_number,
       consecutive_number,
       avg_abs_speed_diff,
       CASE
         WHEN avg_abs_speed_diff <  20 THEN 0
         WHEN avg_abs_speed_diff <  40 THEN 1
         WHEN avg_abs_speed_diff <  60 THEN 2
         WHEN avg_abs_speed_diff <  80 THEN 3
         ELSE 4
       END AS speed_diff_bin
FROM   avg_diff
LIMIT 20;
```

```sql
-- 9) Description:  Prepare one vehicle-level value per accident (pick the smallest BODY_TYPE code)  
--                  and join with the work-zone indicator and temporal predictors from ACCIDENT
WITH vehicle_redux AS (
  SELECT state_number, consecutive_number,
         MIN(body_type) AS body_type_min
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  GROUP  BY state_number, consecutive_number ),

accident_core AS (
  SELECT state_number, consecutive_number,
         day_of_week,
         hour_of_crash,
         CASE WHEN work_zone = 0 THEN 0 ELSE 1 END AS in_work_zone,
         number_of_drunk_drivers
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` )

SELECT a.state_number,
       a.consecutive_number,
       v.body_type_min       AS body_type,
       a.number_of_drunk_drivers,
       a.day_of_week,
       a.hour_of_crash,
       a.in_work_zone
FROM   accident_core a
JOIN   vehicle_redux v
ON     a.state_number      = v.state_number
   AND a.consecutive_number = v.consecutive_number
LIMIT 20;
```

```sql
-- 10) Description:  Final labeled dataset combining all engineered pieces  
--                   (only crashes with >1 person; label = 1 if >1 fatal persons)
WITH person_stats AS (
    SELECT state_number, consecutive_number,
           COUNT(DISTINCT person_number)                            AS persons_all,
           SUM(CASE WHEN injury_severity = 4 THEN 1 ELSE 0 END)    AS persons_fatal
    FROM   `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
    GROUP  BY state_number, consecutive_number
    HAVING COUNT(DISTINCT person_number) > 1 ),

speed_bin AS (
    SELECT state_number, consecutive_number,
           CASE
             WHEN AVG(ABS(travel_speed - speed_limit)) <  20 THEN 0
             WHEN AVG(ABS(travel_speed - speed_limit)) <  40 THEN 1
             WHEN AVG(ABS(travel_speed - speed_limit)) <  60 THEN 2
             WHEN AVG(ABS(travel_speed - speed_limit)) <  80 THEN 3
             ELSE 4
           END AS speed_diff_bin
    FROM   `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
    WHERE  travel_speed BETWEEN 0 AND 151
       AND speed_limit  BETWEEN 5 AND 80
    GROUP  BY state_number, consecutive_number ),

vehicle_pick AS (
    SELECT state_number, consecutive_number,
           MIN(body_type) AS body_type
    FROM   `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
    GROUP  BY state_number, consecutive_number ),

acc_core AS (
    SELECT state_number, consecutive_number,
           day_of_week,
           hour_of_crash,
           CASE WHEN work_zone = 0 THEN 0 ELSE 1 END AS in_work_zone,
           number_of_drunk_drivers
    FROM   `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` )

SELECT p.state_number,
       p.consecutive_number,
       v.body_type,
       a.number_of_drunk_drivers,
       a.day_of_week,
       a.hour_of_crash,
       a.in_work_zone,
       s.speed_diff_bin,
       CASE WHEN p.persons_fatal > 1 THEN 1 ELSE 0 END AS label
FROM   person_stats  p
JOIN   acc_core      a ON a.state_number = p.state_number AND a.consecutive_number = p.consecutive_number
JOIN   vehicle_pick  v ON v.state_number = p.state_number AND v.consecutive_number = p.consecutive_number
LEFT  JOIN speed_bin s ON s.state_number = p.state_number AND s.consecutive_number = p.consecutive_number
LIMIT 20;
```
