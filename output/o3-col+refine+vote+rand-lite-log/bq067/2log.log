```sql
-- 4) Description:  Label each accident: 1 if >1 fatal persons, 0 otherwise  
--                  (and keep only crashes with >1 distinct persons overall)
WITH person_ct AS (
    SELECT state_number, consecutive_number,
           COUNT(DISTINCT person_number)                            AS persons_all,
           SUM(CASE WHEN injury_severity = 4 THEN 1 ELSE 0 END)    AS persons_fatal
    FROM   `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
    GROUP  BY state_number, consecutive_number )
SELECT state_number,
       consecutive_number,
       persons_all,
       persons_fatal,
       CASE WHEN persons_fatal > 1 THEN 1 ELSE 0 END AS label
FROM   person_ct
WHERE  persons_all > 1
LIMIT 20;
