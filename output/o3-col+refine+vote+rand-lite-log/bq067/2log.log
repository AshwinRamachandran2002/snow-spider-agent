--              sets label = 1 if >1 fatal persons.  LIMIT 20 previews the result.

WITH person_stats AS (
  SELECT
      state_number,
      consecutive_number                           AS consec_num,        -- INT64 native
      COUNT(DISTINCT person_number)                AS persons_all,
      SUM(CASE WHEN injury_severity = 4 THEN 1 END) AS persons_fatal
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
  GROUP BY state_number, consec_num
  HAVING persons_all > 1
