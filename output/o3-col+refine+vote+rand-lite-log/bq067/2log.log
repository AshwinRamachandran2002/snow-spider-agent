```sql
--Description:  Earlier the join failed because ACCIDENT.consecutive_number is stored as
--              STRING while VEHICLE.consecutive_number is INT64.  The simplest repair is
--              to cast the ACCIDENT value to INT64 (discarding rows that can’t be cast).  
--              Steps:
--              1) vehicle_redux  – collapse VEHICLE_2016 to one row per crash, choosing
--                 the smallest BODY_TYPE (proxy feature for vehicle composition).
--              2) accident_core  – pull desired predictors from ACCIDENT_2016, convert
--                 its consecutive_number to INT64, and turn WORK_ZONE into a binary flag.
--              3) Join on (state_number, consecutive_number) where both are INT64 and
--                 preview 20 combined rows to verify the fix.

WITH vehicle_redux AS (
  SELECT
      state_number,
      consecutive_number,                 -- native INT64
      MIN(body_type) AS body_type_min
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  GROUP BY state_number, consecutive_number
),
accident_core AS (
  SELECT
      state_number,
      SAFE_CAST(consecutive_number AS INT64) AS consecutive_number,  -- harmonise to INT64
      day_of_week,
      hour_of_crash,
      CASE WHEN work_zone = 0 THEN 0 ELSE 1 END AS in_work_zone,
      number_of_drunk_drivers
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
