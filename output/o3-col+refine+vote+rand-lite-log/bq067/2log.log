```sql
/*----------------------------------------------------------
  Labeled dataset:  “Does a multi-person crash have >1 fatality?”
-----------------------------------------------------------*/
WITH person_summary AS (         -- persons & fatalities per crash
  SELECT
    state_number,
    consecutive_number,
    COUNT(DISTINCT person_number)                              AS persons_all,
    SUM(CASE WHEN injury_severity = 4 THEN 1 ELSE 0 END)      AS persons_fatal
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
  GROUP BY state_number, consecutive_number
  HAVING persons_all > 1                                       -- keep only multi-person crashes
),

labels AS (                  -- 1 if >1 fatal person, else 0
  SELECT
    state_number,
    consecutive_number,
    CASE WHEN persons_fatal > 1 THEN 1 ELSE 0 END AS label
  FROM person_summary
),

speed_avg AS (               -- average |travel_speed – speed_limit| (valid rows only)
  SELECT
    state_number,
    consecutive_number,
    AVG(ABS(travel_speed - speed_limit)) AS avg_abs_speed_diff
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  WHERE travel_speed BETWEEN 0  AND 151     -- exclude 997-999 codes
    AND speed_limit  BETWEEN 5  AND 80      -- exclude 98-99 codes
  GROUP BY state_number, consecutive_number
),

speed_binned AS (            -- bucket the average diff into 0-4 (20-mph width)
  SELECT
    state_number,
    consecutive_number,
    CASE
      WHEN avg_abs_speed_diff < 20 THEN 0
      WHEN avg_abs_speed_diff < 40 THEN 1
      WHEN avg_abs_speed_diff < 60 THEN 2
      WHEN avg_abs_speed_diff < 80 THEN 3
      ELSE 4
    END AS speed_diff_bin
  FROM speed_avg
),

accident_feats AS (          -- crash-level predictors
  SELECT
    state_number,
    consecutive_number,
    number_of_drunk_drivers,
    day_of_week,
    hour_of_crash,
    CASE WHEN work_zone = 0 THEN 0 ELSE 1 END AS work_zone_ind
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
)

-- Final dataset: one row per (accident × vehicle)
SELECT
  lbl.state_number,
  lbl.consecutive_number,
  veh.body_type,                    -- vehicle-level predictor
  acc.number_of_drunk_drivers,
  acc.day_of_week,
  acc.hour_of_crash,
  acc.work_zone_ind,
  spd.speed_diff_bin,               -- engineered feature (0-4)
  lbl.label                         -- target variable
FROM labels              AS lbl
JOIN accident_feats      AS acc
  ON acc.state_number      = lbl.state_number
 AND acc.consecutive_number = lbl.consecutive_number
JOIN `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016` AS veh
  ON veh.state_number      = lbl.state_number
 AND veh.consecutive_number = lbl.consecutive_number
LEFT JOIN speed_binned    AS spd
  ON spd.state_number      = lbl.state_number
 AND spd.consecutive_number = lbl.consecutive_number;
```
