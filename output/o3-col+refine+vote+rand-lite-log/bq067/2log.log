--              All joins use the harmonised STRING keys (state_number, consecutive_number).
--              The final SELECT returns predictors and label (1 if >1 fatal persons).  
--              Preview 20 rows.
WITH person_stats AS (
  SELECT
      state_number,
      CAST(consecutive_number AS STRING) AS consecutive_number,
      COUNT(DISTINCT person_number)                            AS persons_all,
      SUM(CASE WHEN injury_severity = 4 THEN 1 ELSE 0 END)    AS persons_fatal
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
  GROUP BY state_number, consecutive_number
  HAVING persons_all > 1                                         -- keep multi-person crashes
),
speed_bin AS (
  SELECT
      state_number,
      CAST(consecutive_number AS STRING) AS consecutive_number,
      CASE
        WHEN AVG(ABS(travel_speed - speed_limit)) <  20 THEN 0
        WHEN AVG(ABS(travel_speed - speed_limit)) <  40 THEN 1
        WHEN AVG(ABS(travel_speed - speed_limit)) <  60 THEN 2
        WHEN AVG(ABS(travel_speed - speed_limit)) <  80 THEN 3
        ELSE 4
      END AS speed_diff_bin
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  WHERE travel_speed BETWEEN 0 AND 151
    AND speed_limit  BETWEEN 5 AND 80
  GROUP BY state_number, consecutive_number
),
vehicle_pick AS (
  SELECT
      state_number,
      CAST(consecutive_number AS STRING) AS consecutive_number,
      MIN(body_type) AS body_type
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  GROUP BY state_number, consecutive_number
),
acc_core AS (
  SELECT
      state_number,
      consecutive_number,                       -- already STRING
      day_of_week,
      hour_of_crash,
      CASE WHEN work_zone = 0 THEN 0 ELSE 1 END AS in_work_zone,
      number_of_drunk_drivers
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
)
SELECT
    p.state_number,
    p.consecutive_number,
    v.body_type,
    a.number_of_drunk_drivers,
    a.day_of_week,
    a.hour_of_crash,
    a.in_work_zone,
    COALESCE(s.speed_diff_bin, -1) AS speed_diff_bin,   -- -1 when no valid speed data
