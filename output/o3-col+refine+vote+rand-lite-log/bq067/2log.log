-----------------------------------------------------------*/

WITH person_summary AS (        -- persons & fatalities per crash
  SELECT
    state_number,
    CAST(consecutive_number AS STRING)                          AS cons_num,
    COUNT(DISTINCT person_number)                               AS persons_all,
    SUM(CASE WHEN injury_severity = 4 THEN 1 ELSE 0 END)        AS persons_fatal
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
  GROUP BY 1, 2
  HAVING persons_all > 1                                         -- keep only multi-person crashes
),

labels AS (                    -- target: 1  if >1 fatal person, else 0
  SELECT
    state_number,
    cons_num,
    CASE WHEN persons_fatal > 1 THEN 1 ELSE 0 END AS label
  FROM person_summary
),

/*----------- engineered speed feature --------------------*/
speed_avg AS (                 -- average |travel_speed – speed_limit|
  SELECT
    state_number,
    CAST(consecutive_number AS STRING)                          AS cons_num,
    AVG(ABS(travel_speed - speed_limit))                        AS avg_abs_speed_diff
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  WHERE travel_speed BETWEEN 0  AND 151     -- exclude codes 997-999
    AND speed_limit  BETWEEN 5  AND 80      -- exclude codes 98-99
  GROUP BY 1, 2
),

speed_binned AS (              -- bucket the average diff into 0–4 (20-mph width)
  SELECT
    state_number,
    cons_num,
    CASE
      WHEN avg_abs_speed_diff < 20 THEN 0
      WHEN avg_abs_speed_diff < 40 THEN 1
      WHEN avg_abs_speed_diff < 60 THEN 2
      WHEN avg_abs_speed_diff < 80 THEN 3
      ELSE 4
    END AS speed_diff_bin
  FROM speed_avg
),

/*----------- crash-level predictors ----------------------*/
accident_feats AS (
  SELECT
    state_number,
    CAST(consecutive_number AS STRING)                          AS cons_num,
    number_of_drunk_drivers,
    day_of_week,
    hour_of_crash,
    CASE WHEN work_zone = 0 THEN 0 ELSE 1 END                   AS work_zone_ind
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
),

/*----------- vehicle-level predictor (body_type) ----------*/
vehicle_basic AS (
  SELECT
    state_number,
    CAST(consecutive_number AS STRING)                          AS cons_num,
