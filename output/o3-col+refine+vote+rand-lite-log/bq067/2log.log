        WHEN AVG(ABS(travel_speed - speed_limit)) <  20 THEN 0
        WHEN AVG(ABS(travel_speed - speed_limit)) <  40 THEN 1
        WHEN AVG(ABS(travel_speed - speed_limit)) <  60 THEN 2
        WHEN AVG(ABS(travel_speed - speed_limit)) <  80 THEN 3
        ELSE 4
      END AS speed_diff_bin
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  WHERE travel_speed BETWEEN 0 AND 151
    AND speed_limit  BETWEEN 5 AND 80
  GROUP BY state_number, consec_num
),
vehicle_pick AS (
  SELECT
      state_number,
      consecutive_number                           AS consec_num,        -- INT64
      MIN(body_type) AS body_type
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  GROUP BY state_number, consec_num
),
acc_core AS (
  SELECT
      state_number,
      SAFE_CAST(consecutive_number AS INT64)       AS consec_num,        -- cast to INT64
      day_of_week,
      hour_of_crash,
      CASE WHEN work_zone = 0 THEN 0 ELSE 1 END    AS in_work_zone,
      number_of_drunk_drivers
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE SAFE_CAST(consecutive_number AS INT64) IS NOT NULL               -- retain castable rows
)
SELECT
    p.state_number,
    p.consec_num        AS consecutive_number,
    v.body_type,
    a.number_of_drunk_drivers,
    a.day_of_week,
    a.hour_of_crash,
