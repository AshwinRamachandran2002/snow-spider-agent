```sql
--Description: Build the binary label required by the task.
--THINKING PROCESS
-- 1. We need a Boolean indicator per crash: “more than one fatally-injured person?”
--    A fatally-injured person is identified by injury_severity = 4 in person_2016.
-- 2. We must keep only crashes that involve more than one distinct person overall.
-- 3. accident_2016 is one row per crash; person_2016 is one row per person, so
--    we JOIN on the composite key (state_number, consecutive_number).
-- 4. COUNTIF tallies the fatally-injured persons; we test whether that count > 1.
-- 5. CAST( … AS INT64) converts the resulting TRUE/FALSE to 1/0, avoiding the
--    prior error that INT64() cannot take a Boolean directly.
-- 6. GROUP BY the crash key, HAVING clause enforces the “>1 person in crash”.
-- 7. LIMIT 20 just samples a few rows.
SELECT
  a.state_number,
  a.consecutive_number,
  CAST(COUNTIF(p.injury_severity = 4) > 1 AS INT64) AS label
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` AS a
JOIN `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`  AS p
  ON a.state_number       = p.state_number
 AND a.consecutive_number = p.consecutive_number
GROUP BY a.state_number, a.consecutive_number
HAVING COUNT(DISTINCT p.person_number) > 1
LIMIT 20;
