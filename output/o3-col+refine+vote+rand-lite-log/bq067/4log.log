```sql
--Description: 8) Convert that average speed-gap to 0-4 categorical levels.
SELECT
  state_number,
  consecutive_number,
  CASE
    WHEN avg_diff < 20 THEN 0
    WHEN avg_diff < 40 THEN 1
    WHEN avg_diff < 60 THEN 2
    WHEN avg_diff < 80 THEN 3
    ELSE 4
  END AS speed_diff_level
FROM (
  SELECT
    state_number,
    consecutive_number,
    AVG(ABS(travel_speed - speed_limit)) AS avg_diff
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  WHERE travel_speed BETWEEN 0 AND 151
    AND speed_limit  BETWEEN 5 AND 80
  GROUP BY state_number, consecutive_number
)
LIMIT 20;
```

```sql
--Description: 9) Join crashes with persons to add the label (1 = >1 fatal) and keep only
--               crashes containing >1 person overall.
SELECT
  a.state_number,
  a.consecutive_number,
  INT64(COUNTIF(p.injury_severity = 4) > 1) AS label
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` AS a
JOIN `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`  AS p
  ON a.state_number      = p.state_number
 AND a.consecutive_number = p.consecutive_number
GROUP BY a.state_number, a.consecutive_number
HAVING COUNT(DISTINCT p.person_number) > 1
LIMIT 20;
```

```sql
--Description: 10) FINAL — produce the modeling dataset with required predictors, the engineered
--                 speed-difference feature, and the binary label.
SELECT
  a.state_number,
  sf.body_type,
  a.number_of_drunk_drivers,
  a.day_of_week,
  a.hour_of_crash,
  IF(a.work_zone = 0, 0, 1)                        AS is_work_zone,
  sf.speed_diff_level                              AS avg_speed_diff_level,
  pr.label                                         AS label
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` AS a
JOIN (
  -- person summary: crashes that involve >1 person & the fatal-count label
  SELECT
    state_number,
    consecutive_number,
    INT64(COUNTIF(injury_severity = 4) > 1) AS label,
    COUNT(DISTINCT person_number)           AS person_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
  GROUP BY state_number, consecutive_number
  HAVING person_cnt > 1
) AS pr
  ON a.state_number      = pr.state_number
 AND a.consecutive_number = pr.consecutive_number
JOIN (
  -- speed feature per crash, plus a representative body_type
  SELECT
    state_number,
    consecutive_number,
    ANY_VALUE(body_type)                       AS body_type,
    CASE
      WHEN avg_diff < 20 THEN 0
      WHEN avg_diff < 40 THEN 1
      WHEN avg_diff < 60 THEN 2
      WHEN avg_diff < 80 THEN 3
      ELSE 4
    END                                        AS speed_diff_level
  FROM (
    SELECT
      state_number,
      consecutive_number,
      ANY_VALUE(body_type)                     AS body_type,
      AVG(ABS(travel_speed - speed_limit))     AS avg_diff
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
    WHERE travel_speed BETWEEN 0 AND 151
      AND speed_limit  BETWEEN 5 AND 80
    GROUP BY state_number, consecutive_number
  )
) AS sf
  ON a.state_number      = sf.state_number
 AND a.consecutive_number = sf.consecutive_number
LIMIT 20;
```
