```sql
--Description: One-step query that produces the modelling dataset.
--THINKING PROCESS
-- 1.  pr  – From person_2016, build crash-level label:
--         • COUNTIF(injury_severity = 4) tallies fatals.
--         • CAST(… > 1 AS INT64) → 1 if >1 fatal, else 0.
--         • HAVING keeps crashes with >1 distinct person.
-- 2.  sf  – From vehicle_2016, engineer features per crash:
--         • Restrict to valid speed / limit codes.
--         • AVG(|travel_speed − speed_limit|) = avg_diff.
--         • ANY_VALUE(body_type) supplies a representative body_type.
--         • Bucket avg_diff into 20-mph levels 0–4.
-- 3.  Join accident_2016 with pr (label) and sf (vehicle features).
-- 4.  Derive is_work_zone (0 when work_zone = 'None', else 1).
-- 5.  Return requested predictors + label; LIMIT 20 for sample.
SELECT
  a.state_number,
  sf.body_type,
  a.number_of_drunk_drivers,
  a.day_of_week,
  a.hour_of_crash,
  IF(a.work_zone = 'None', 0, 1)                       AS is_work_zone,
  sf.speed_diff_level                                  AS avg_speed_diff_level,
  pr.label                                             AS label
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` AS a
JOIN (
  /* pr: crash-level label and >1-person filter */
  SELECT
    state_number,
    consecutive_number,
    CAST(COUNTIF(injury_severity = 4) > 1 AS INT64) AS label
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
  GROUP BY state_number, consecutive_number
  HAVING COUNT(DISTINCT person_number) > 1
) AS pr
  ON a.state_number       = pr.state_number
 AND a.consecutive_number = pr.consecutive_number
JOIN (
  /* sf: speed difference bucket + body_type per crash */
  SELECT
    v.state_number,
    v.consecutive_number,
    v.body_type,
    CASE
      WHEN v.avg_diff < 20 THEN 0
      WHEN v.avg_diff < 40 THEN 1
      WHEN v.avg_diff < 60 THEN 2
      WHEN v.avg_diff < 80 THEN 3
      ELSE 4
    END AS speed_diff_level
  FROM (
    SELECT
      state_number,
      consecutive_number,
      ANY_VALUE(body_type)                 AS body_type,
      AVG(ABS(travel_speed - speed_limit)) AS avg_diff
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
    WHERE travel_speed BETWEEN 0  AND 151     -- exclude 997, 998, 999
      AND speed_limit  BETWEEN 5  AND 80      -- exclude 0, 98, 99
    GROUP BY state_number, consecutive_number
  ) AS v
) AS sf
  ON a.state_number       = sf.state_number
 AND a.consecutive_number = sf.consecutive_number
LIMIT 20;
