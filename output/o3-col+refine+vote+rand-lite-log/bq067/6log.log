```sql
--Description / thinking process ----------------------------------------------------
-- Goal: create one row per crash that
--   • has >1 distinct persons involved
--   • carries a label = 1 when >1 persons have injury_severity = 4, else 0
-- Predictors to include
--   1.  state_number                                (from accident_2016)
--   2.  body_type (representative vehicle)          (from vehicle_2016)
--   3.  number_of_drunk_drivers                     (accident_2016)
--   4.  day_of_week                                 (accident_2016)
--   5.  hour_of_crash                               (accident_2016)
--   6.  is_work_zone  : 1 if work_zone ≠ 'None'     (accident_2016)
--   7.  speed_diff_level : bucketed mean |speed-limit|
--         – compute mean |travel_speed – speed_limit| per crash
--         – keep only vehicle rows with   travel_speed 0-151   (drop 997/998/999)
--                                           speed_limit  5-80   (drop 98/99)
--         – bucket into 0 [0,20), 1 [20,40), 2 [40,60), 3 [60,80), 4 [80,+)
-- Approach:
--   • Build three helper subqueries, then join:
--       sp   : average speed difference
--       lbl  : keep crashes with >1 persons and set label
--       veh  : representative body_type (ANY_VALUE)
--   • Join helpers to accident_2016 (a); derive features; LIMIT 20 for sample.
-------------------------------------------------------------------------------------
SELECT
  a.state_number,
  veh.body_type,
  a.number_of_drunk_drivers,
  a.day_of_week,
  a.hour_of_crash,
  IF(a.work_zone = 'None' OR a.work_zone IS NULL, 0, 1)              AS is_work_zone,
  CASE
      WHEN sp.avg_speed_diff < 20 THEN 0
      WHEN sp.avg_speed_diff < 40 THEN 1
      WHEN sp.avg_speed_diff < 60 THEN 2
      WHEN sp.avg_speed_diff < 80 THEN 3
      ELSE 4
  END                                                               AS speed_diff_level,
  lbl.label
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` AS a
JOIN (  -- average absolute speed difference per crash (valid rows only)
      SELECT
        state_number,
        consecutive_number,
        AVG(ABS(travel_speed - speed_limit)) AS avg_speed_diff
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
      WHERE travel_speed BETWEEN 0 AND 151      -- exclude code 997/998/999
        AND speed_limit BETWEEN 5 AND 80        -- exclude code 98/99
      GROUP BY state_number, consecutive_number
     ) sp
  USING (state_number, consecutive_number)
JOIN (  -- crashes with >1 persons and multi-fatality label
      SELECT
        state_number,
        consecutive_number,
        IF(SUM(CASE WHEN injury_severity = 4 THEN 1 ELSE 0 END) > 1, 1, 0) AS label
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
      GROUP BY state_number, consecutive_number
      HAVING COUNT(DISTINCT person_number) > 1
     ) lbl
  USING (state_number, consecutive_number)
JOIN (  -- pick one body_type per crash
      SELECT
        state_number,
        consecutive_number,
        ANY_VALUE(body_type) AS body_type
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
      GROUP BY state_number, consecutive_number
     ) veh
  USING (state_number, consecutive_number)
LIMIT 20;
```
