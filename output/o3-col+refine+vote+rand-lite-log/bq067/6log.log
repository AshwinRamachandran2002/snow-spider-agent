```sql
-- 10)  Final feature matrix (one row per crash) with engineered variables & label
SELECT
  a.`state_number`,
  veh.body_type,
  a.`number_of_drunk_drivers`,
  a.`day_of_week`,
  a.`hour_of_crash`,
  IF(a.`work_zone` = 0, 0, 1)                AS is_work_zone,
  CASE
    WHEN sp.avg_speed_diff < 20 THEN 0
    WHEN sp.avg_speed_diff < 40 THEN 1
    WHEN sp.avg_speed_diff < 60 THEN 2
    WHEN sp.avg_speed_diff < 80 THEN 3
    ELSE 4
  END                                         AS speed_diff_level,
  lbl.label
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`          AS a
JOIN (
      -- per-crash average speed difference (valid rows only)
      SELECT
        `state_number`,
        `consecutive_number`,
        AVG(ABS(`travel_speed` - `speed_limit`)) AS avg_speed_diff
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
      WHERE `travel_speed` BETWEEN 0 AND 151
        AND `speed_limit` BETWEEN 5 AND 80
      GROUP BY `state_number`, `consecutive_number`
     ) AS sp
  USING (`state_number`, `consecutive_number`)
JOIN (
      -- crashes with >1 distinct persons and the binary label
      SELECT
        `state_number`,
        `consecutive_number`,
        COUNT(DISTINCT `person_number`)                                     AS person_cnt,
        IF(SUM(CASE WHEN `injury_severity` = 4 THEN 1 ELSE 0 END) > 1, 1, 0) AS label
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
      GROUP BY `state_number`, `consecutive_number`
      HAVING person_cnt > 1
     ) AS lbl
  USING (`state_number`, `consecutive_number`)
JOIN (
      -- pick one body_type per crash (ANY_VALUE is OK for features)
      SELECT
        `state_number`,
        `consecutive_number`,
        ANY_VALUE(`body_type`) AS body_type
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
      GROUP BY `state_number`, `consecutive_number`
     ) AS veh
  USING (`state_number`, `consecutive_number`)
LIMIT 20;
```

