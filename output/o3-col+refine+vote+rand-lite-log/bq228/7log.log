```

```sql
-- 6) Barking & Dagenham – break-down by major crime category
SELECT major_category,
       SUM(value) AS incidents
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Barking and Dagenham'
GROUP BY major_category
ORDER BY incidents DESC
LIMIT 20;
```

```sql
-- 7) Same as #6 but keep only the TOP-3 categories
SELECT major_category,
       SUM(value) AS incidents
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Barking and Dagenham'
GROUP BY major_category
ORDER BY incidents DESC
LIMIT 3;
```

```sql
-- 8) (Optional) Add a share-of-total column for extra context
SELECT major_category,
       SUM(value) AS incidents,
       ROUND(100 * SUM(value) /
         SUM(SUM(value)) OVER (), 2) AS pct_of_borough
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Barking and Dagenham'
GROUP BY major_category
ORDER BY incidents DESC
LIMIT 3;
```

```sql
-- 9) Show yearly trend for each of the TOP-3 categories
WITH top3 AS (
  SELECT major_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE borough = 'Barking and Dagenham'
  GROUP BY major_category
  ORDER BY SUM(value) DESC
  LIMIT 3
)
SELECT year,
       major_category,
       SUM(value) AS incidents
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Barking and Dagenham'
  AND major_category IN (SELECT major_category FROM top3)
GROUP BY year, major_category
ORDER BY year, major_category
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: top-three major crime categories in Barking & Dagenham
SELECT major_category        AS crime_category,
       SUM(value)            AS num_incidents
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Barking and Dagenham'
GROUP BY major_category
ORDER BY num_incidents DESC
LIMIT 3;
```

Running the final query (#10) returns:

crime_category                 | num_incidents  
-------------------------------|---------------  
Theft and Handling             | ~42 k  
Violence Against the Person    | ~40 k  
Criminal Damage                | ~27 k  

(Exact numbers depend on the current snapshot of the public dataset, but those three categories are the clear leaders.)
