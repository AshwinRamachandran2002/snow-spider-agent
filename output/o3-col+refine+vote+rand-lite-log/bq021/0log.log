```sql
-- 5. For those same top-20 routes: average bike duration (minutes) and rounded co-ords  
WITH top20 AS (                 -- list from query 3
  SELECT  start_station_id,
          end_station_id,
          COUNT(*) AS trips
  FROM    `bigquery-public-data.new_york.citibike_trips`
  WHERE   EXTRACT(YEAR FROM starttime)=2016
  GROUP BY 1,2
  ORDER BY trips DESC
  LIMIT 20 )

SELECT
  s_from.name             AS start_name,
  s_to.name               AS end_name,
  ROUND(AVG(t.tripduration)/60,2) AS bike_avg_min,
  s_from.lat3  AS from_lat3,  s_from.lon3 AS from_lon3,
  s_to.lat3    AS to_lat3,    s_to.lon3   AS to_lon3
FROM   top20 tp
JOIN   `bigquery-public-data.new_york.citibike_trips` t
       ON  t.start_station_id=tp.start_station_id
       AND t.end_station_id  =tp.end_station_id
       AND EXTRACT(YEAR FROM t.starttime)=2016
JOIN   (SELECT station_id, name, ROUND(latitude ,3) AS lat3,
                       ROUND(longitude,3) AS lon3
        FROM `bigquery-public-data.new_york.citibike_stations`) s_from
       ON s_from.station_id = tp.start_station_id
JOIN   (SELECT station_id, name, ROUND(latitude ,3) AS lat3,
                       ROUND(longitude,3) AS lon3
        FROM `bigquery-public-data.new_york.citibike_stations`) s_to
       ON s_to.station_id   = tp.end_station_id
GROUP  BY start_name,end_name,from_lat3,from_lon3,to_lat3,to_lon3
ORDER  BY bike_avg_min DESC
LIMIT 20;
```

```sql
-- 6. Average yellow-taxi duration (minutes) between the same rounded co-ordinates in 2016  
WITH taxi_2016 AS (
  SELECT
    ROUND(pickup_latitude ,3)  AS from_lat3,
    ROUND(pickup_longitude,3)  AS from_lon3,
    ROUND(dropoff_latitude ,3) AS to_lat3,
    ROUND(dropoff_longitude,3) AS to_lon3,
    (UNIX_SECONDS(dropoff_datetime)-UNIX_SECONDS(pickup_datetime))/60.0 AS trip_min
  FROM  `bigquery-public-data.new_york.tlc_yellow_trips_2016`
  WHERE pickup_datetime  IS NOT NULL
    AND dropoff_datetime IS NOT NULL )
SELECT
  from_lat3,from_lon3,to_lat3,to_lon3,
  ROUND(AVG(trip_min),2) AS taxi_avg_min,
  COUNT(*)               AS taxi_trips
FROM taxi_2016
GROUP BY 1,2,3,4
HAVING taxi_trips>50        -- keep only routes with a bit of volume
LIMIT 20;
```

```sql
-- 7. Combine bike (query 5) and taxi (query 6) to see where bikes are faster  
WITH bike AS (   -- query 5 without the LIMIT  
  ...                                                -- same CTE as in query 5
),
taxi AS (        -- query 6 without the LIMIT  
  ... )
SELECT
  bike.start_name,
  bike.end_name,
  bike.bike_avg_min,
  taxi.taxi_avg_min,
  taxi.taxi_trips
FROM bike
JOIN taxi
  ON  bike.from_lat3=taxi.from_lat3  AND bike.from_lon3=taxi.from_lon3
  AND bike.to_lat3  =taxi.to_lat3    AND bike.to_lon3  =taxi.to_lon3
WHERE bike.bike_avg_min < taxi.taxi_avg_min      -- bikes are faster
ORDER BY bike.bike_avg_min DESC                  -- longest bike trip among the faster ones
LIMIT 20;
```

```sql
-- 8. Identify the single route (among those faster than taxis) whose bike rides
--    take the longest on average; return only its start-station name  
WITH top20 AS (                              -- same as query 3
