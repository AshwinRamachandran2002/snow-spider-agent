WITH
-- 1. 20 most-frequent Citi Bike origin-destination pairs in 2016
top20 AS (
  SELECT
    start_station_id,
    end_station_id,
    COUNT(*) AS trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime) = 2016
  GROUP BY 1,2
  ORDER BY trips DESC
  LIMIT 20
),

-- 2. Station lookup (rounded to 3-decimal grid)
