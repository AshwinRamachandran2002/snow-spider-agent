```sql
--Description: Average 2016 yellow-taxi trip time (minutes) between each pair of
--rounded-to-0.001° pickup/ drop-off coordinates; keep pairs with ≥50 taxi trips.
WITH taxi_2016 AS (
  SELECT
    ROUND(pickup_latitude ,3)  AS from_lat3,
    ROUND(pickup_longitude,3)  AS from_lon3,
    ROUND(dropoff_latitude ,3) AS to_lat3,
    ROUND(dropoff_longitude,3) AS to_lon3,
    (UNIX_SECONDS(dropoff_datetime)
     -UNIX_SECONDS(pickup_datetime)) / 60.0 AS trip_min
  FROM `bigquery-public-data.new_york.tlc_yellow_trips_2016`
  WHERE pickup_datetime IS NOT NULL
    AND dropoff_datetime IS NOT NULL )
SELECT
  from_lat3, from_lon3, to_lat3, to_lon3,
  ROUND(AVG(trip_min),2) AS taxi_avg_min,
  COUNT(*)               AS taxi_trips
FROM taxi_2016
GROUP BY 1,2,3,4
HAVING taxi_trips >= 50
LIMIT 20;
```

```sql
--Description: Merge bike-route averages (for the 20 busiest Citi-Bike OD pairs) with
--matching taxi averages; list routes where bikes are faster than taxis, showing both
--times and taxi-trip counts.
WITH
-- busiest 20 Citi-Bike OD pairs in 2016
top20 AS (
  SELECT start_station_id,
         end_station_id,
         COUNT(*) AS trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime)=2016
  GROUP BY 1,2
  ORDER BY trips DESC
  LIMIT 20),
-- station data (coords rounded; id kept STRING)
stations AS (
  SELECT station_id,
         name,
         ROUND(latitude ,3) AS lat3,
         ROUND(longitude,3) AS lon3
  FROM `bigquery-public-data.new_york.citibike_stations`),
-- bike averages for those 20 routes
bike AS (
  SELECT
    tp.start_station_id,
    tp.end_station_id,
    s_from.name AS start_name,
    s_to.name   AS end_name,
    ROUND(AVG(t.tripduration)/60,2) AS bike_avg_min,
    s_from.lat3 AS from_lat3, s_from.lon3 AS from_lon3,
    s_to.lat3   AS to_lat3  , s_to.lon3   AS to_lon3
  FROM top20 tp
  JOIN `bigquery-public-data.new_york.citibike_trips` t
    ON t.start_station_id=tp.start_station_id
   AND t.end_station_id  =tp.end_station_id
   AND EXTRACT(YEAR FROM t.starttime)=2016
  JOIN stations s_from ON s_from.station_id=CAST(tp.start_station_id AS STRING)
  JOIN stations s_to   ON s_to.station_id  =CAST(tp.end_station_id   AS STRING)
  GROUP BY 1,2,3,4,6,7,8,9),
-- taxi averages between same rounded coordinate pairs (same logic as query 6 but no LIMIT)
taxi AS (
  SELECT
    from_lat3,from_lon3,to_lat3,to_lon3,
    ROUND(AVG(trip_min),2) AS taxi_avg_min,
    COUNT(*)               AS taxi_trips
  FROM (
    SELECT
      ROUND(pickup_latitude ,3)  AS from_lat3,
      ROUND(pickup_longitude,3)  AS from_lon3,
      ROUND(dropoff_latitude ,3) AS to_lat3,
      ROUND(dropoff_longitude,3) AS to_lon3,
      (UNIX_SECONDS(dropoff_datetime)-UNIX_SECONDS(pickup_datetime))/60.0 AS trip_min
    FROM `bigquery-public-data.new_york.tlc_yellow_trips_2016`
    WHERE pickup_datetime IS NOT NULL
      AND dropoff_datetime IS NOT NULL )
  GROUP BY 1,2,3,4
  HAVING COUNT(*) >= 50)
SELECT
  bike.start_name,
  bike.end_name,
  bike.bike_avg_min,
  taxi.taxi_avg_min,
  taxi.taxi_trips
FROM bike
JOIN taxi
  ON bike.from_lat3=taxi.from_lat3 AND bike.from_lon3=taxi.from_lon3
 AND bike.to_lat3  =taxi.to_lat3   AND bike.to_lon3  =taxi.to_lon3
WHERE bike.bike_avg_min < taxi.taxi_avg_min         -- bikes faster
ORDER BY bike.bike_avg_min DESC                     -- longest bike avg among faster
LIMIT 20;
