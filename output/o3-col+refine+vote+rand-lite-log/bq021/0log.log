```sql
--Description:  Re-run the bike-vs-taxi comparison but relax the coordinate
--rounding from 3 to 2 decimals so more yellow-taxi trips align with the 20
--busiest Citi-Bike routes of 2016.  We keep every bike route (LEFT JOIN) yet
--filter at the end to rows where a taxi average exists and the bike average
--is still faster.  Ordering by the longest bike average among those “bike-
--faster” routes shows whether any route satisfies the question.

WITH
-- 1. 20 most-frequent Citi-Bike OD station pairs in 2016
top20 AS (
  SELECT start_station_id,
         end_station_id,
         COUNT(*) AS trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime)=2016
  GROUP BY 1,2
  ORDER BY trips DESC
  LIMIT 20
),

-- 2. Station lookup (coords rounded to 0.01°; id is STRING)
stations AS (
  SELECT station_id,
         name,
         ROUND(latitude ,2) AS lat2,
         ROUND(longitude,2) AS lon2
  FROM `bigquery-public-data.new_york.citibike_stations`
),

-- 3. Average bike duration (minutes) for those 20 routes, plus 2-dec coords
bike AS (
  SELECT
    tp.start_station_id,
    tp.end_station_id,
    s_from.name                        AS start_name,
    s_to.name                          AS end_name,
    ROUND(AVG(t.tripduration)/60,2)    AS bike_min,
    s_from.lat2 AS from_lat2, s_from.lon2 AS from_lon2,
    s_to.lat2   AS to_lat2  , s_to.lon2   AS to_lon2
  FROM   top20 tp
  JOIN   `bigquery-public-data.new_york.citibike_trips` t
         ON t.start_station_id = tp.start_station_id
        AND t.end_station_id   = tp.end_station_id
        AND EXTRACT(YEAR FROM t.starttime)=2016
  JOIN   stations s_from
         ON s_from.station_id = CAST(tp.start_station_id AS STRING)
  JOIN   stations s_to
         ON s_to.station_id   = CAST(tp.end_station_id   AS STRING)
  GROUP  BY 1,2,3,4,6,7,8,9
),

-- 4. 2016 yellow-taxi trips rounded to same 2-dec grid, matched to bike coords
taxi AS (
  SELECT
    b.start_station_id,
    b.end_station_id,
    ROUND(AVG( (UNIX_SECONDS(dropoff_datetime)
                - UNIX_SECONDS(pickup_datetime)) / 60.0 ),2) AS taxi_min,
    COUNT(*)                                                AS taxi_trips
  FROM `bigquery-public-data.new_york.tlc_yellow_trips_2016` t
  JOIN bike b
    ON ROUND(t.pickup_latitude ,2)=b.from_lat2
   AND ROUND(t.pickup_longitude,2)=b.from_lon2
   AND ROUND(t.dropoff_latitude ,2)=b.to_lat2
   AND ROUND(t.dropoff_longitude,2)=b.to_lon2
  WHERE pickup_datetime IS NOT NULL
    AND dropoff_datetime IS NOT NULL
  GROUP BY b.start_station_id,b.end_station_id
)

-- 5. Final comparison: bike routes that are faster than taxis
SELECT
  b.start_name,
  b.end_name,
  b.bike_min        AS avg_bike_minutes,
  t.taxi_min        AS avg_taxi_minutes,
  t.taxi_trips
FROM bike b
LEFT JOIN taxi t
  ON b.start_station_id=t.start_station_id
 AND b.end_station_id  =t.end_station_id
WHERE t.taxi_min IS NOT NULL           -- only keep routes with taxi data
  AND b.bike_min < t.taxi_min          -- bike faster than taxi
ORDER BY b.bike_min DESC               -- longest (but still faster) bike time first
LIMIT 20;
```
