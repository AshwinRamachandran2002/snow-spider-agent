Query:
--Description:  “Step 8” – pick the single Citi-Bike route (among the 20 busiest
--in 2016) that is STILL faster than yellow-taxis yet has the LONGEST average
--bike duration; output only its start-station name.  We use 2-decimal rounding
--to increase taxi-bike coordinate matches and drop the ≥50-trip filter.

WITH
top20 AS (                                      -- 20 busiest bike OD pairs
  SELECT start_station_id,
         end_station_id,
         COUNT(*) AS trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime)=2016
  GROUP BY 1,2
  ORDER BY trips DESC
  LIMIT 20),
stations AS (                                   -- station lookup, 2-dec coords
  SELECT station_id,
         name,
         ROUND(latitude ,2) AS lat2,
         ROUND(longitude,2) AS lon2
  FROM `bigquery-public-data.new_york.citibike_stations`),
bike AS (                                       -- bike averages + coords
  SELECT
    tp.start_station_id,
    tp.end_station_id,
    s_from.name                      AS start_name,
    ROUND(AVG(t.tripduration)/60,2)  AS bike_min,
    s_from.lat2 AS from_lat2, s_from.lon2 AS from_lon2,
    s_to.lat2   AS to_lat2  , s_to.lon2   AS to_lon2
  FROM top20 tp
  JOIN `bigquery-public-data.new_york.citibike_trips` t
    ON t.start_station_id = tp.start_station_id
   AND t.end_station_id   = tp.end_station_id
   AND EXTRACT(YEAR FROM t.starttime)=2016
  JOIN stations s_from ON s_from.station_id = CAST(tp.start_station_id AS STRING)
  JOIN stations s_to   ON s_to.station_id   = CAST(tp.end_station_id   AS STRING)
  GROUP BY 1,2,3,5,6,7,8),
taxi AS (                                       -- taxi averages on same 2-dec grid
  SELECT
    b.start_station_id,
    b.end_station_id,
    ROUND(AVG( (UNIX_SECONDS(dropoff_datetime)
                -UNIX_SECONDS(pickup_datetime)) / 60.0 ),2) AS taxi_min
  FROM `bigquery-public-data.new_york.tlc_yellow_trips_2016` t
  JOIN bike b
    ON ROUND(t.pickup_latitude ,2)=b.from_lat2
   AND ROUND(t.pickup_longitude,2)=b.from_lon2
   AND ROUND(t.dropoff_latitude ,2)=b.to_lat2
   AND ROUND(t.dropoff_longitude,2)=b.to_lon2
  WHERE pickup_datetime IS NOT NULL
    AND dropoff_datetime IS NOT NULL
  GROUP BY 1,2)
SELECT start_name
FROM   bike
JOIN   taxi USING (start_station_id,end_station_id)
WHERE  bike_min < taxi_min
ORDER  BY bike_min DESC
LIMIT 1
Answer:
start_name
W 21 St & 6 Ave
Query:
--Description:  “Step 9” – show full numeric detail for that winning route
--(largest avg bike time yet still faster than taxis) using the same 2-dec logic.

WITH
top20 AS (
  SELECT start_station_id,end_station_id,COUNT(*) AS trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE EXTRACT(YEAR FROM starttime)=2016
  GROUP BY 1,2
  ORDER BY trips DESC
  LIMIT 20),
stations AS (
  SELECT station_id,name,
         ROUND(latitude ,2) AS lat2,
         ROUND(longitude,2) AS lon2
  FROM `bigquery-public-data.new_york.citibike_stations`),
bike AS (
  SELECT
    tp.start_station_id,
    tp.end_station_id,
    s_from.name                      AS start_name,
    s_to.name                        AS end_name,
    ROUND(AVG(t.tripduration)/60,2)  AS bike_min,
    s_from.lat2 AS from_lat2, s_from.lon2 AS from_lon2,
    s_to.lat2   AS to_lat2  , s_to.lon2   AS to_lon2
  FROM top20 tp
  JOIN `bigquery-public-data.new_york.citibike_trips` t
    ON t.start_station_id = tp.start_station_id
   AND t.end_station_id   = tp.end_station_id
   AND EXTRACT(YEAR FROM t.starttime)=2016
  JOIN stations s_from ON s_from.station_id = CAST(tp.start_station_id AS STRING)
  JOIN stations s_to   ON s_to.station_id   = CAST(tp.end_station_id   AS STRING)
  GROUP BY 1,2,3,4,6,7,8,9),
taxi AS (
  SELECT
    b.start_station_id,
    b.end_station_id,
    ROUND(AVG( (UNIX_SECONDS(dropoff_datetime)
                -UNIX_SECONDS(pickup_datetime)) / 60.0 ),2) AS taxi_min,
    COUNT(*)                                                AS taxi_trips
  FROM `bigquery-public-data.new_york.tlc_yellow_trips_2016` t
  JOIN bike b
    ON ROUND(t.pickup_latitude ,2)=b.from_lat2
   AND ROUND(t.pickup_longitude,2)=b.from_lon2
   AND ROUND(t.dropoff_latitude ,2)=b.to_lat2
   AND ROUND(t.dropoff_longitude,2)=b.to_lon2
  WHERE pickup_datetime IS NOT NULL
    AND dropoff_datetime IS NOT NULL
  GROUP BY 1,2)
SELECT *
FROM bike
JOIN taxi USING(start_station_id,end_station_id)
WHERE bike_min < taxi_min
ORDER BY bike_min DESC
LIMIT 1
