```sql
--Description: 3) List the distinct female names occurring in 2021 (all states)
SELECT DISTINCT name
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE gender = 'F'
  AND year = 2021
LIMIT 20;
```

```sql
--Description: 4) Aggregate the total number of female babies for each name across all states in 2021
SELECT name,
       SUM(number) AS total_female_us
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE gender = 'F'
  AND year = 2021
GROUP BY name
ORDER BY total_female_us DESC
LIMIT 20;
```

```sql
--Description: 5) Aggregate the number of female babies for each name inside Wyoming in 2021
SELECT name,
       SUM(number) AS wy_female
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE state = 'WY'
  AND gender = 'F'
  AND year = 2021
GROUP BY name
ORDER BY wy_female DESC
LIMIT 20;
```

```sql
--Description: 6) Join the two aggregates to compute the Wyoming-share (proportion) for each female name in 2021
WITH wy AS (
  SELECT name, SUM(number) AS wy_female
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE state = 'WY' AND gender = 'F' AND year = 2021
  GROUP BY name
),
us AS (
  SELECT name, SUM(number) AS total_female_us
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE gender = 'F' AND year = 2021
  GROUP BY name
)
SELECT
  wy.name,
  wy.wy_female,
  us.total_female_us,
  SAFE_DIVIDE(wy_female, total_female_us) AS wy_share
FROM wy
JOIN us USING (name)
ORDER BY wy_share DESC
LIMIT 20;
```

```sql
--Description: 7) Final answer: name with the highest Wyoming share among female babies in 2021
WITH wy AS (
  SELECT name, SUM(number) AS wy_female
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE state = 'WY' AND gender = 'F' AND year = 2021
  GROUP BY name
),
us AS (
  SELECT name, SUM(number) AS total_female_us
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE gender = 'F' AND year = 2021
  GROUP BY name
)
SELECT
  wy.name
FROM wy
JOIN us USING (name)
ORDER BY SAFE_DIVIDE(wy_female, total_female_us) DESC
LIMIT 1;
```
