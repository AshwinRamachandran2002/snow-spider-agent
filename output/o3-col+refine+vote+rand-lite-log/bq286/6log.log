```sql
--Description: Look at the 20 most frequent female names in Wyoming for 2021  
SELECT `state`, `gender`, `year`, `name`, `number`
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE `state` = 'WY'
  AND `gender` = 'F'
  AND `year`   = 2021
ORDER BY `number` DESC
LIMIT 20;
```

```sql
--Description: Total female-baby counts per name across ALL states for 2021  
SELECT `name`,
       SUM(`number`) AS total_female_2021
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE `gender` = 'F'
  AND `year`   = 2021
GROUP BY `name`
ORDER BY total_female_2021 DESC
LIMIT 20;
```

```sql
--Description: Female-baby counts per name in Wyoming only for 2021  
SELECT `name`,
       SUM(`number`) AS wy_female_2021
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE `state`  = 'WY'
  AND `gender` = 'F'
  AND `year`   = 2021
GROUP BY `name`
ORDER BY wy_female_2021 DESC
LIMIT 20;
```

```sql
--Description: Join WY counts to total counts to compute WY proportion for each name  
SELECT wy.`name`,
       wy.wy_female_2021,
       tot.total_female_2021,
       SAFE_DIVIDE(wy.wy_female_2021, tot.total_female_2021) AS wy_proportion
FROM (
      SELECT `name`, SUM(`number`) AS wy_female_2021
      FROM `bigquery-public-data.usa_names.usa_1910_current`
      WHERE `state`='WY' AND `gender`='F' AND `year`=2021
      GROUP BY `name`
     ) AS wy
JOIN (
      SELECT `name`, SUM(`number`) AS total_female_2021
      FROM `bigquery-public-data.usa_names.usa_1910_current`
      WHERE `gender`='F' AND `year`=2021
      GROUP BY `name`
     ) AS tot
USING (`name`)
ORDER BY wy_proportion DESC
LIMIT 20;
```

```sql
--Description: Compute WY percentage share directly in one query (all names)  
SELECT `name`,
       ROUND(100 * SAFE_DIVIDE(SUM(CASE WHEN `state`='WY' THEN `number` END),
                               SUM(`number`)), 4) AS wy_percentage
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE `gender`='F' AND `year`=2021
GROUP BY `name`
HAVING wy_percentage IS NOT NULL
ORDER BY wy_percentage DESC
LIMIT 20;
```

```sql
--Description: Use a window function – each WY record’s share of its name’s 2021 total  
SELECT `name`,
       ROUND(100 * SAFE_DIVIDE(`number`,
                               SUM(`number`) OVER (PARTITION BY `name`, `gender`, `year`)
                              ), 4) AS wy_share_percent
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE `state`='WY' AND `gender`='F' AND `year`=2021
ORDER BY wy_share_percent DESC
LIMIT 20;
```

```sql
--Description: Final answer – name with the highest WY-to-nation proportion for female babies in 2021  
SELECT `name`
FROM (
      SELECT `name`,
             SAFE_DIVIDE(SUM(CASE WHEN `state`='WY' THEN `number` END),
                         SUM(`number`)) AS wy_prop
      FROM `bigquery-public-data.usa_names.usa_1910_current`
      WHERE `gender`='F' AND `year`=2021
      GROUP BY `name`
     )
ORDER BY wy_prop DESC
LIMIT 1;
```
