FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE `state` = 'WY' AND `gender` = 'F' AND `year` = 2021
ORDER BY `number` DESC
LIMIT 20;
```

```sql
--Description: 3. Aggregate 2021 female name totals across ALL states (national totals).
SELECT `name`, SUM(`number`) AS total_us
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE `gender` = 'F' AND `year` = 2021
GROUP BY `name`
ORDER BY total_us DESC
LIMIT 20;
```

```sql
--Description: 4. Aggregate 2021 female name counts only for Wyoming.
SELECT `name`, SUM(`number`) AS wy_total
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE `state` = 'WY' AND `gender` = 'F' AND `year` = 2021
GROUP BY `name`
ORDER BY wy_total DESC
LIMIT 20;
```

```sql
--Description: 5. Join Wyoming counts with national totals to compute proportion of each name that comes from Wyoming.
SELECT
  wy.`name`,
  wy.wy_total,
  us.total_us,
  SAFE_DIVIDE(wy.wy_total, us.total_us) AS wy_share
FROM (
  SELECT `name`, SUM(`number`) AS wy_total
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE `state` = 'WY' AND `gender` = 'F' AND `year` = 2021
  GROUP BY `name`
) AS wy
JOIN (
  SELECT `name`, SUM(`number`) AS total_us
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE `gender` = 'F' AND `year` = 2021
  GROUP BY `name`
) AS us
ON wy.`name` = us.`name`
ORDER BY wy_share DESC
LIMIT 20;
```

```sql
