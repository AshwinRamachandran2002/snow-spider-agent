ORDER BY wy_total DESC
LIMIT 20;
```

```sql
--Description: Total 2021 female counts for all states (top-20 names)
SELECT name, SUM(number) AS us_total
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE gender = 'F' AND year = 2021
GROUP BY name
ORDER BY us_total DESC
LIMIT 20;
```

```sql
--Description: Compute the 2021 Wyoming-share for a sample name (“Olivia”)
SELECT
  'Olivia' AS name,
  SUM(CASE WHEN state = 'WY' THEN number END) AS wy_count,
  SUM(number) AS us_count,
  SUM(CASE WHEN state = 'WY' THEN number END) / SUM(number) AS wy_share
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE gender = 'F' AND year = 2021 AND name = 'Olivia'
LIMIT 20;
```

```sql
--Description: Wyoming share for every 2021 female name (top-20 by share)
WITH wy AS (
  SELECT name, SUM(number) AS wy_count
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE state = 'WY' AND gender = 'F' AND year = 2021
  GROUP BY name
),
us AS (
  SELECT name, SUM(number) AS us_count
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE gender = 'F' AND year = 2021
  GROUP BY name
)
SELECT
  wy.name,
  wy.wy_count,
  us.us_count,
  wy.wy_count / us.us_count AS wy_share
FROM wy
JOIN us USING (name)
ORDER BY wy_share DESC
LIMIT 20;
```

```sql
--Description: Same as above but keep only names that appear at least 5 times in WY (2021) to avoid tiny denominators
WITH wy AS (
  SELECT name, SUM(number) AS wy_count
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE state = 'WY' AND gender = 'F' AND year = 2021
  GROUP BY name
  HAVING wy_count >= 5
),
us AS (
  SELECT name, SUM(number) AS us_count
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE gender = 'F' AND year = 2021
  GROUP BY name
)
SELECT
  wy.name,
  wy.wy_count / us.us_count AS wy_share
FROM wy
JOIN us USING (name)
ORDER BY wy_share DESC
LIMIT 20;
```

