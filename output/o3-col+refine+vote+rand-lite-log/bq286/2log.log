```sql
--Description: 1) Peek at some 2021 rows in the “current” table
SELECT *
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE year = 2021
LIMIT 20;
```

```sql
--Description: 2) List distinct states that have female-baby records for 2021
SELECT DISTINCT state
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE year = 2021
  AND gender = 'F'
LIMIT 20;
```

```sql
--Description: 3) Show the female-baby name counts in Wyoming (WY) for 2021
SELECT name,
       number AS wy_count
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE year = 2021
  AND gender = 'F'
  AND state = 'WY'
ORDER BY wy_count DESC
LIMIT 20;
```

```sql
--Description: 4) Compute total female-baby counts for every name across all states in 2021
SELECT name,
       SUM(number) AS total_us_count
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE year = 2021
  AND gender = 'F'
GROUP BY name
ORDER BY total_us_count DESC
LIMIT 20;
```

```sql
--Description: 5) Join WY counts to U.S. totals to get Wyoming’s share (proportion)
SELECT wy.name,
       wy.wy_count,
       us.total_us_count,
       SAFE_DIVIDE(wy.wy_count, us.total_us_count) AS wy_share
FROM (
      SELECT name, number AS wy_count
      FROM `bigquery-public-data.usa_names.usa_1910_current`
      WHERE year = 2021 AND gender = 'F' AND state = 'WY'
     ) AS wy
JOIN (
      SELECT name, SUM(number) AS total_us_count
      FROM `bigquery-public-data.usa_names.usa_1910_current`
      WHERE year = 2021 AND gender = 'F'
      GROUP BY name
     ) AS us
ON wy.name = us.name
ORDER BY wy_share DESC
LIMIT 20;
```

```sql
--Description: 6) Verify proportions for a random subset (names starting with ‘E’), ordered by highest share
SELECT wy.name,
       wy.wy_count,
       us.total_us_count,
       SAFE_DIVIDE(wy.wy_count, us.total_us_count) AS wy_share
FROM (
      SELECT name, number AS wy_count
      FROM `bigquery-public-data.usa_names.usa_1910_current`
      WHERE year = 2021 AND gender = 'F' AND state = 'WY' AND name LIKE 'E%'
     ) AS wy
JOIN (
      SELECT name, SUM(number) AS total_us_count
      FROM `bigquery-public-data.usa_names.usa_1910_current`
      WHERE year = 2021 AND gender = 'F' AND name LIKE 'E%'
      GROUP BY name
     ) AS us
ON wy.name = us.name
ORDER BY wy_share DESC
LIMIT 20;
```

