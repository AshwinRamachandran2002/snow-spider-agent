```sql
--Description: 1) Look at all female birth records in 2021 to make sure the table contains that year.
SELECT *
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE `year` = 2021
  AND `gender` = 'F'
LIMIT 20;
```

```sql
--Description: 2) Check what states appear in 2021-female data.
SELECT DISTINCT `state`
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE `year` = 2021
  AND `gender` = 'F'
LIMIT 20;
```

```sql
--Description: 3) See the raw counts of female baby names born in Wyoming (WY) in 2021.
SELECT `name`,
       `number`
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE `year`   = 2021
  AND `gender` = 'F'
  AND `state`  = 'WY'
ORDER BY `number` DESC
LIMIT 20;
```

```sql
--Description: 4) Compute the total 2021-female counts for every name across all states.
SELECT `name`,
       SUM(`number`) AS total_us_2021_f
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE `year`   = 2021
  AND `gender` = 'F'
GROUP BY `name`
ORDER BY total_us_2021_f DESC
LIMIT 20;
```

```sql
--Description: 5) Put Wyoming’s 2021-female counts side-by-side with the nationwide totals.
WITH wy AS (
  SELECT `name`,
         `number` AS wy_2021_f
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE `year`   = 2021
    AND `gender` = 'F'
    AND `state`  = 'WY'
),
us AS (
  SELECT `name`,
         SUM(`number`) AS us_2021_f
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE `year`   = 2021
    AND `gender` = 'F'
  GROUP BY `name`
)
SELECT wy.`name`,
       wy.wy_2021_f,
       us.us_2021_f
FROM wy
JOIN us USING (`name`)
ORDER BY wy.wy_2021_f DESC
LIMIT 20;
```

```sql
--Description: 6) Calculate the proportion of each name’s Wyoming births to its total U.S. births in 2021.
WITH wy AS (
  SELECT `name`,
         `number` AS wy_2021_f
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE `year`   = 2021
    AND `gender` = 'F'
    AND `state`  = 'WY'
),
us AS (
  SELECT `name`,
         SUM(`number`) AS us_2021_f
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE `year`   = 2021
    AND `gender` = 'F'
  GROUP BY `name`
)
SELECT wy.`name`,
       wy.wy_2021_f,
       us.us_2021_f,
       SAFE_DIVIDE(wy.wy_2021_f, us.us_2021_f) AS wy_share_of_us
FROM wy
JOIN us USING (`name`)
ORDER BY wy_share_of_us DESC
LIMIT 20;
```

```sql
