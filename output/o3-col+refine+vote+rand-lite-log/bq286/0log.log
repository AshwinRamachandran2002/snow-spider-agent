```sql
-- Description: Wyoming-female 2021 name counts
SELECT name,
       SUM(number) AS wy_count
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE state  = 'WY'
  AND gender = 'F'
  AND year   = 2021
GROUP BY name
ORDER BY wy_count DESC
LIMIT 20;
```

```sql
-- Description: Total U.S. female 2021 counts per name
SELECT name,
       SUM(number) AS total_count
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE gender = 'F'
  AND year   = 2021
GROUP BY name
ORDER BY total_count DESC
LIMIT 20;
```

```sql
-- Description: Compare Wyoming counts to U.S. totals (top 20 by proportion)
WITH wy AS (
  SELECT name, SUM(number) AS wy_count
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE state='WY' AND gender='F' AND year=2021
  GROUP BY name
),
us AS (
  SELECT name, SUM(number) AS us_count
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE gender='F' AND year=2021
  GROUP BY name
)
SELECT wy.name,
       wy.wy_count,
       us.us_count,
       SAFE_DIVIDE(wy.wy_count, us.us_count) AS proportion
FROM wy
JOIN us USING (name)
ORDER BY proportion DESC
LIMIT 20;
```

```sql
-- Description: Name with the highest Wyoming-share among 2021 female babies
WITH wy AS (
  SELECT name, SUM(number) AS wy_count
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE state='WY' AND gender='F' AND year=2021
  GROUP BY name
),
us AS (
  SELECT name, SUM(number) AS us_count
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE gender='F' AND year=2021
  GROUP BY name
)
SELECT wy.name,
       SAFE_DIVIDE(wy.wy_count, us.us_count) AS proportion
FROM wy
JOIN us USING (name)
ORDER BY proportion DESC
LIMIT 1;
```

These queries progress from basic exploration to computing the proportion and finally isolating the single most popular female baby name in Wyoming for 2021 by its share of national occurrences.
