```sql
--Description: 8. Final answer – the single most popular 2021 female baby name in Wyoming by share of all U.S. female babies with that name
WITH wy AS (
  SELECT `name`, SUM(`number`) AS wy_cnt
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE `state` = 'WY' AND `gender` = 'F' AND `year` = 2021
  GROUP BY `name`
),
us AS (
  SELECT `name`, SUM(`number`) AS us_cnt
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE `gender` = 'F' AND `year` = 2021
  GROUP BY `name`
)
SELECT wy.`name`
FROM wy
JOIN us USING (`name`)
ORDER BY SAFE_DIVIDE(wy.wy_cnt, us.us_cnt) DESC
LIMIT 1;
```
