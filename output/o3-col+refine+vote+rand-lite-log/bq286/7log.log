```sql
--Description: 3. Total 2021 female babies for each name in every state (needed for the denominator)
SELECT `name`,
       SUM(`number`) AS total_us_female_2021
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE `gender` = 'F'
  AND `year` = 2021
GROUP BY `name`
ORDER BY total_us_female_2021 DESC
LIMIT 20;
```

```sql
--Description: 4. 2021 female-baby counts for each name in Wyoming only (numerator)
SELECT `name`,
       SUM(`number`) AS wy_female_2021
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE `state` = 'WY'
  AND `gender` = 'F'
  AND `year` = 2021
GROUP BY `name`
ORDER BY wy_female_2021 DESC
LIMIT 20;
```

```sql
--Description: 5. Join the two previous sub-aggregations and compute the Wyoming share of each female name in 2021
WITH wy AS (
  SELECT `name`, SUM(`number`) AS wy_female_2021
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE `state` = 'WY' AND `gender` = 'F' AND `year` = 2021
  GROUP BY `name`
),
us AS (
  SELECT `name`, SUM(`number`) AS total_us_female_2021
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE `gender` = 'F' AND `year` = 2021
  GROUP BY `name`
)
SELECT wy.`name`,
       wy.wy_female_2021,
       us.total_us_female_2021,
       SAFE_DIVIDE(wy.wy_female_2021, us.total_us_female_2021) AS wy_share
FROM wy
JOIN us USING (`name`)
ORDER BY wy_share DESC
LIMIT 20;
```

```sql
--Description: 6. Display only the name and its share, sorted by highest Wyoming share
WITH wy AS (
  SELECT `name`, SUM(`number`) AS wy_cnt
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE `state` = 'WY' AND `gender` = 'F' AND `year` = 2021
  GROUP BY `name`
),
us AS (
  SELECT `name`, SUM(`number`) AS us_cnt
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE `gender` = 'F' AND `year` = 2021
  GROUP BY `name`
)
SELECT wy.`name`,
       SAFE_DIVIDE(wy.wy_cnt, us.us_cnt) AS wy_share
FROM wy
JOIN us USING (`name`)
ORDER BY wy_share DESC
LIMIT 20;
```

```sql
--Description: 7. Verify that the top result truly has the greatest proportion
WITH wy AS (
  SELECT `name`, SUM(`number`) AS wy_cnt
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE `state` = 'WY' AND `gender` = 'F' AND `year` = 2021
  GROUP BY `name`
),
us AS (
  SELECT `name`, SUM(`number`) AS us_cnt
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE `gender` = 'F' AND `year` = 2021
  GROUP BY `name`
)
SELECT wy.`name`,
       wy.wy_cnt,
       us.us_cnt,
       SAFE_DIVIDE(wy.wy_cnt, us.us_cnt) AS wy_share
FROM wy
JOIN us USING (`name`)
ORDER BY wy_share DESC, wy.wy_cnt DESC
LIMIT 5;
