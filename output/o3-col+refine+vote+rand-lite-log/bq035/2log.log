[{'tree_id': 113066, 'legal_status': '', 'species': 'Cupressus macrocarpa :: Monterey Cypress', 'address': '2X Cranleigh Dr', 'site_order': 7, 'site_info': ':', 'plant_type': 'Tree', 'care_taker': 'DPW', 'care_assistant': '', 'plant_date': '2015-09-09 13:08:00+00:00', 'dbh': '3', 'plot_size': '', 'permit_notes': '', 'x_coordinate': 5991370.3, 'y_coordinate': 2095943.7, 'latitude': 37.7345659248964, 'longitude': -122.472270103664, 'location': '(37.7345659248964, -122.472270103664)'}, {'tree_id': 97434, 'legal_status': '', 'species': 'Ulmus parvifolia :: Chinese Elm', 'address': '1380x Newcomb Ave', 'site_order': 5, 'site_info': 'Median : Cutout', 'plant_type': 'Tree', 'care_taker': 'DPW', 'care_assistant': '', 'plant_date': '2011-09-30 00:00:00+00:00', 'dbh': '3', 'plot_size': '', 'permit_notes': '', 'x_coordinate': 6016360.63733, 'y_coordinate': 2094893.94179, 'latitude': 37.7330981190079, 'longitude': -122.385796183605, 'location': '(37.7330981190079, -122.385796183605)'}, {'tree_id': 91166, 'legal_status': '', 'species': 'Cercis canadensis :: Eastern Redbud', 'address': '1548x Quesada Ave', 'site_order': 4, 'site_info': 'Median : Cutout', 'plant_type': 'Tree', 'care_taker': 'DPW', 'care_assistant': '', 'plant_date': '2009-01-31 00:00:00+00:00', 'dbh': '3', 'plot_size': '', 'permit_notes': '', 'x_coordinate': 6015526.48125, 'y_coordinate': 2094420.051093, 'latitude': 37.7317507154659, 'longitude': -122.388647039673, 'location': '(37.7317507154659, -122.388647039673)'}, {'tree_id': 87422, 'legal_status': '', 'species': 'Lophostemon confertus :: Brisbane Box', 'address': '45X Jones St', 'site_order': 1, 'site_info': 'Sidewalk: Curb side : Cutout', 'plant_type': 'Tree', 'care_taker': 'DPW', 'care_assistant': '', 'plant_date': '2008-04-22 00:00:00+00:00', 'dbh': '', 'plot_size': '', 'permit_notes': '', 'x_coordinate': 6009092.517834, 'y_coordinate': 2112687.614007, 'latitude': 37.7815506408215, 'longitude': -122.412181237011, 'location': '(37.7815506408215, -122.412181