SELECT *
FROM `bigquery-public-data.san_francisco.bikeshare_trips`
LIMIT 20;
```

```sql
--Description: Inspect the station reference table (names, IDs, lat / lon)
SELECT station_id, name, latitude, longitude
FROM `bigquery-public-data.san_francisco.bikeshare_stations`
LIMIT 20;
```

```sql
--Description: How many trips have start-station IDs that do NOT appear in the
--             station look-up table?  (Expect 0 – a quick data-quality check)
SELECT COUNT(*) AS trips_with_unknown_station
FROM `bigquery-public-data.san_francisco.bikeshare_trips`  AS t
LEFT JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS s
       ON t.start_station_id = s.station_id
WHERE s.station_id IS NULL;
```

```sql
--Description: Join ONE trip to its start & end station coordinates
--             to make sure the join keys work (shows 20 samples)
SELECT
  t.trip_id,
  t.bike_number,
  t.start_station_id,
  ss.latitude  AS start_lat,
  ss.longitude AS start_lon,
  t.end_station_id,
  es.latitude  AS end_lat,
  es.longitude AS end_lon
FROM `bigquery-public-data.san_francisco.bikeshare_trips`     AS t
JOIN `bigquery-public-data.san_francisco.bikeshare_stations`  AS ss
     ON t.start_station_id = ss.station_id
JOIN `bigquery-public-data.san_francisco.bikeshare_stations`  AS es
     ON t.end_station_id   = es.station_id
LIMIT 20;
```

```sql
--Description: Compute the point-to-point (great-circle) distance for 20 trips
--             and show it in both meters and miles
SELECT
  t.trip_id,
  t.bike_number,
  ROUND(
    ST_DISTANCE(
      ST_GEOGPOINT(ss.longitude, ss.latitude),
      ST_GEOGPOINT(es.longitude, es.latitude)
    ), 2)                                AS distance_meters,
  ROUND(
    ST_DISTANCE(
      ST_GEOGPOINT(ss.longitude, ss.latitude),
      ST_GEOGPOINT(es.longitude, es.latitude)
    ) / 1609.34 , 3)                     AS distance_miles
FROM `bigquery-public-data.san_francisco.bikeshare_trips`    AS t
JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS ss
     ON t.start_station_id = ss.station_id
JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS es
     ON t.end_station_id   = es.station_id
LIMIT 20;
```

```sql
--Description: Average trip distance (miles) by subscriber type
SELECT
  t.subscriber_type,
  ROUND(AVG(
    ST_DISTANCE(
      ST_GEOGPOINT(ss.longitude, ss.latitude),
      ST_GEOGPOINT(es.longitude, es.latitude)
    ) / 1609.34), 3)  AS avg_distance_miles
FROM `bigquery-public-data.san_francisco.bikeshare_trips`    AS t
JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS ss
     ON t.start_station_id = ss.station_id
JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS es
     ON t.end_station_id   = es.station_id
GROUP BY t.subscriber_type
LIMIT 20;
```

```sql
--Description: Year-by-year distance ridden by each bike (20 bikes sample)
SELECT
  EXTRACT(YEAR FROM t.start_date)         AS ride_year,
  t.bike_number,
  ROUND(SUM(
    ST_DISTANCE(
      ST_GEOGPOINT(ss.longitude, ss.latitude),
      ST_GEOGPOINT(es.longitude, es.latitude)
    ) / 1609.34), 2)                     AS miles_in_year
FROM `bigquery-public-data.san_francisco.bikeshare_trips`    AS t
JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS ss
     ON t.start_station_id = ss.station_id
JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS es
     ON t.end_station_id   = es.station_id
GROUP BY ride_year, t.bike_number
ORDER BY ride_year, miles_in_year DESC
LIMIT 20;
```

```sql
--Description: FINAL – total distance traveled by every bike
SELECT
  t.bike_number,
  ROUND(SUM(
    ST_DISTANCE(
      ST_GEOGPOINT(ss.longitude, ss.latitude),
      ST_GEOGPOINT(es.longitude, es.latitude)
    ) / 1609.34), 2)   AS total_miles_traveled
FROM `bigquery-public-data.san_francisco.bikeshare_trips`    AS t
JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS ss
     ON t.start_station_id = ss.station_id
JOIN `bigquery-public-data.san_francisco.bikeshare_stations` AS es
     ON t.end_station_id   = es.station_id
GROUP BY t.bike_number
ORDER BY total_miles_traveled DESC
LIMIT 20;
```
