Table full name: bigquery-public-data.san_francisco.sfpd_incidents
Column name: unique_key Type: INT64 Description: The unique incident number for this accident
Column name: category Type: STRING
Column name: descript Type: STRING
Column name: dayofweek Type: STRING
Column name: pddistrict Type: STRING Description: Police Department district
Column name: resolution Type: STRING Description: Whether there was an arrest, citation, booking, etc.
Column name: address Type: STRING
Column name: longitude Type: FLOAT64
Column name: latitude Type: FLOAT64
Column name: location Type: STRING Description: Latitude/Longitude
Column name: pdid Type: INT64 Description: Unique Identifier for use in update and insert operations
