```sql
-- 1) Peek at individual payment records (customer, amount, date)
SELECT DISTINCT "payment_id", "customer_id", "amount", "payment_date"
FROM "payment"
LIMIT 20;
```

```sql
-- 2) Look at the year-month extracted from each payment
SELECT DISTINCT strftime('%Y-%m', "payment_date") AS "yr_month"
FROM "payment"
LIMIT 20;
```

```sql
-- 3) Calculate total amount each customer paid in every year-month
SELECT DISTINCT
       "customer_id",
       strftime('%Y-%m', "payment_date") AS "yr_month",
       SUM("amount")                      AS "month_total"
FROM   "payment"
GROUP  BY "customer_id", "yr_month"
LIMIT 20;
```

```sql
-- 4) For every customer, find the month-to-month change (absolute difference) in totals
SELECT DISTINCT
       "customer_id",
       "yr_month",
       ABS("month_total" -
           LAG("month_total") OVER (PARTITION BY "customer_id"
                                    ORDER BY "yr_month"))       AS "month_diff"
FROM (
        SELECT "customer_id",
               strftime('%Y-%m', "payment_date") AS "yr_month",
               SUM("amount")                      AS "month_total"
        FROM   "payment"
        GROUP  BY "customer_id", "yr_month"
     )
LIMIT 20;
```

```sql
-- 5) Compute each customer’s average monthly change
SELECT DISTINCT
       "customer_id",
       AVG("month_diff") AS "avg_month_change"
FROM (
        SELECT "customer_id",
               "yr_month",
               ABS("month_total" -
                   LAG("month_total") OVER (PARTITION BY "customer_id"
                                            ORDER BY "yr_month")) AS "month_diff"
        FROM (
                SELECT "customer_id",
                       strftime('%Y-%m', "payment_date") AS "yr_month",
                       SUM("amount")                      AS "month_total"
                FROM   "payment"
                GROUP  BY "customer_id", "yr_month"
             )
     )
WHERE  "month_diff" IS NOT NULL
GROUP  BY "customer_id"
ORDER  BY "avg_month_change" DESC
LIMIT 20;
```

```sql
-- 6) Retrieve the customer whose average monthly change is the highest
SELECT DISTINCT
       ("c"."first_name" || ' ' || "c"."last_name") AS "full_name"
FROM (
        SELECT "customer_id",
               AVG("month_diff") AS "avg_month_change"
        FROM (
                SELECT "customer_id",
                       ABS("month_total" -
                           LAG("month_total") OVER (PARTITION BY "customer_id"
                                                    ORDER BY "yr_month"))
                       AS "month_diff"
                FROM (
                        SELECT "customer_id",
                               strftime('%Y-%m', "payment_date") AS "yr_month",
                               SUM("amount")                      AS "month_total"
                        FROM   "payment"
                        GROUP  BY "customer_id", "yr_month"
                     )
             )
        WHERE  "month_diff" IS NOT NULL
        GROUP  BY "customer_id"
        ORDER  BY "avg_month_change" DESC
        LIMIT 1
     ) AS top
JOIN "customer" AS "c"
  ON "c"."customer_id" = top."customer_id";
```
