-- 4) For every customer, find the month-to-month change (absolute difference) in totals
SELECT DISTINCT
       "customer_id",
       "yr_month",
       ABS("month_total" -
           LAG("month_total") OVER (PARTITION BY "customer_id"
                                    ORDER BY "yr_month"))       AS "month_diff"
FROM (
        SELECT "customer_id",
               strftime('%Y-%m', "payment_date") AS "yr_month",
               SUM("amount")                      AS "month_total"
        FROM   "payment"
        GROUP  BY "customer_id", "yr_month"
     )
LIMIT 20;
