SELECT *
FROM payment
LIMIT 20;
```

```sql
-- Description: List up to 20 distinct customer_id values that appear in the payment table
SELECT DISTINCT customer_id
FROM payment
LIMIT 20;
```

```sql
-- Description: Retrieve each paying customer’s first and last name (sample of 20)
SELECT DISTINCT p.customer_id,
       c.first_name,
       c.last_name
FROM payment AS p
JOIN customer AS c ON p.customer_id = c.customer_id
LIMIT 20;
```

```sql
-- Description: Show (year-month) and total amount paid per customer for 20 (customer, month) pairs
SELECT p.customer_id,
       strftime('%Y-%m', p.payment_date) AS yyyymm,
       SUM(p.amount) AS month_total
FROM payment AS p
GROUP BY p.customer_id,
         yyyymm
LIMIT 20;
```

```sql
-- Description: For one customer (id = 1), list their month_totals in chronological order (first 20 rows)
SELECT strftime('%Y-%m', p.payment_date) AS yyyymm,
       SUM(p.amount) AS month_total
FROM payment AS p
WHERE p.customer_id = 1
GROUP BY yyyymm
ORDER BY yyyymm
LIMIT 20;
```

```sql
-- Description: Compute month_totals for every customer and include the previous month’s total using LAG (first 20 rows)
SELECT t.customer_id,
       t.yyyymm,
       t.month_total,
       LAG(t.month_total) OVER (PARTITION BY t.customer_id ORDER BY t.yyyymm) AS prev_month_total
FROM (
    SELECT p.customer_id,
           strftime('%Y-%m', p.payment_date) AS yyyymm,
           SUM(p.amount) AS month_total
    FROM payment AS p
    GROUP BY p.customer_id, yyyymm
) AS t
LIMIT 20;
```

```sql
-- Description: Calculate each customer’s month-to-month change in total payments (first 20 rows)
SELECT customer_id,
       yyyymm,
       month_total - prev_month_total AS month_change
FROM (
    SELECT t.*,
           LAG(t.month_total) OVER (PARTITION BY t.customer_id ORDER BY t.yyyymm) AS prev_month_total
    FROM (
        SELECT p.customer_id,
               strftime('%Y-%m', p.payment_date) AS yyyymm,
               SUM(p.amount) AS month_total
        FROM payment AS p
        GROUP BY p.customer_id, yyyymm
    ) AS t
) AS x
WHERE prev_month_total IS NOT NULL
LIMIT 20;
```

```sql
-- Description: For every customer, compute the average of their month-to-month payment changes (first 20 customers)
SELECT customer_id,
       AVG(month_change) AS avg_monthly_change
FROM (
    SELECT customer_id,
           month_total - prev_month_total AS month_change
    FROM (
        SELECT t.*,
               LAG(t.month_total) OVER (PARTITION BY t.customer_id ORDER BY t.yyyymm) AS prev_month_total
        FROM (
            SELECT p.customer_id,
                   strftime('%Y-%m', p.payment_date) AS yyyymm,
                   SUM(p.amount) AS month_total
            FROM payment AS p
            GROUP BY p.customer_id, yyyymm
        ) AS t
    )
    WHERE prev_month_total IS NOT NULL
) AS changes
GROUP BY customer_id
LIMIT 20;
```

```sql
-- Description: Identify the customer_id with the highest average monthly change in payments
SELECT customer_id
FROM (
    SELECT customer_id,
           AVG(month_change) AS avg_monthly_change
    FROM (
        SELECT customer_id,
               month_total - prev_month_total AS month_change
        FROM (
            SELECT t.*,
                   LAG(t.month_total) OVER (PARTITION BY t.customer_id ORDER BY t.yyyymm) AS prev_month_total
            FROM (
                SELECT p.customer_id,
                       strftime('%Y-%m', p.payment_date) AS yyyymm,
                       SUM(p.amount) AS month_total
                FROM payment AS p
                GROUP BY p.customer_id, yyyymm
            ) AS t
        )
        WHERE prev_month_total IS NOT NULL
    )
    GROUP BY customer_id
) AS avg_change
ORDER BY avg_monthly_change DESC
LIMIT 1;
```

```sql
-- Description: Return the full name of the customer who has the highest average monthly change in payment amounts
SELECT c.first_name || ' ' || c.last_name AS full_name
FROM customer AS c
WHERE c.customer_id = (
    SELECT customer_id
    FROM (
        SELECT customer_id,
               AVG(month_change) AS avg_monthly_change
        FROM (
            SELECT customer_id,
                   month_total - prev_month_total AS month_change
            FROM (
                SELECT t.*,
                       LAG(t.month_total) OVER (PARTITION BY t.customer_id ORDER BY t.yyyymm) AS prev_month_total
                FROM (
                    SELECT p.customer_id,
                           strftime('%Y-%m', p.payment_date) AS yyyymm,
                           SUM(p.amount) AS month_total
                    FROM payment AS p
                    GROUP BY p.customer_id, yyyymm
                ) AS t
            )
            WHERE prev_month_total IS NOT NULL
        )
        GROUP BY customer_id
    )
    ORDER BY avg_monthly_change DESC
    LIMIT 1
);
```
