Query:
-- Description: For every customer, compute the average of their month-to-month payment changes (first 20 customers)
SELECT customer_id,
       AVG(month_change) AS avg_monthly_change
FROM (
    SELECT customer_id,
           month_total - prev_month_total AS month_change
    FROM (
        SELECT t.*,
               LAG(t.month_total) OVER (PARTITION BY t.customer_id ORDER BY t.yyyymm) AS prev_month_total
        FROM (
            SELECT p.customer_id,
                   strftime('%Y-%m', p.payment_date) AS yyyymm,
                   SUM(p.amount) AS month_total
            FROM payment AS p
            GROUP BY p.customer_id, yyyymm
        ) AS t
    )
    WHERE prev_month_total IS NOT NULL
) AS changes
GROUP BY customer_id
LIMIT 20;
