```sql
--Description: 1) Glimpse of raw payment records (one row per payment)
SELECT DISTINCT "customer_id", "amount", "payment_date"
FROM "payment"
LIMIT 20;
```

```sql
--Description: 2) Monthly-granularity: total amount each customer paid per calendar month
SELECT DISTINCT
       "customer_id",
       strftime('%Y-%m', "payment_date") AS "yyyymm",
       SUM("amount")                      AS "month_total"
FROM   "payment"
GROUP  BY "customer_id", "yyyymm"
LIMIT 20;
```

```sql
--Description: 3) Show consecutive month totals side-by-side for every customer
SELECT DISTINCT
       t."customer_id",
       t."yyyymm",
       t."month_total",
       LAG(t."month_total") OVER (PARTITION BY t."customer_id"
                                  ORDER BY t."yyyymm") AS "prev_month_total"
FROM (
        SELECT "customer_id",
               strftime('%Y-%m', "payment_date") AS "yyyymm",
               SUM("amount") AS "month_total"
        FROM   "payment"
        GROUP  BY "customer_id", "yyyymm"
     ) AS t
LIMIT 20;
```

```sql
--Description: 4) Compute absolute change between consecutive months for every customer
SELECT DISTINCT
       "customer_id",
       ABS("month_total" - "prev_month_total") AS "month_change"
FROM (
        SELECT "customer_id",
               "yyyymm",
               "month_total",
               LAG("month_total") OVER (PARTITION BY "customer_id"
                                        ORDER BY "yyyymm") AS "prev_month_total"
        FROM (
               SELECT "customer_id",
                      strftime('%Y-%m', "payment_date") AS "yyyymm",
                      SUM("amount") AS "month_total"
               FROM   "payment"
               GROUP  BY "customer_id", "yyyymm"
             )
      )
WHERE "prev_month_total" IS NOT NULL          -- need two months to form a change
LIMIT 20;
```

```sql
--Description: 5) Average monthly change in payments for every customer
SELECT DISTINCT
       "customer_id",
       AVG("month_change") AS "avg_monthly_change"
FROM (
        SELECT "customer_id",
               ABS("month_total" - "prev_month_total") AS "month_change"
        FROM (
                SELECT "customer_id",
                       "yyyymm",
                       "month_total",
                       LAG("month_total") OVER (PARTITION BY "customer_id"
                                                ORDER BY "yyyymm") AS "prev_month_total"
                FROM (
                        SELECT "customer_id",
                               strftime('%Y-%m', "payment_date") AS "yyyymm",
                               SUM("amount") AS "month_total"
                        FROM   "payment"
                        GROUP  BY "customer_id", "yyyymm"
                     )
             )
        WHERE "prev_month_total" IS NOT NULL
     )
GROUP  BY "customer_id"
LIMIT 20;
```

```sql
--Description: 6) Identify the customer_id with the highest average monthly change
SELECT DISTINCT "customer_id"
FROM (
        SELECT "customer_id",
               AVG("month_change") AS "avg_monthly_change"
        FROM (
               SELECT "customer_id",
                      ABS("month_total" - "prev_month_total") AS "month_change"
               FROM (
                       SELECT "customer_id",
                              "yyyymm",
                              "month_total",
                              LAG("month_total") OVER (PARTITION BY "customer_id"
                                                       ORDER BY "yyyymm") AS "prev_month_total"
                       FROM (
                               SELECT "customer_id",
                                      strftime('%Y-%m', "payment_date") AS "yyyymm",
                                      SUM("amount") AS "month_total"
                               FROM   "payment"
                               GROUP  BY "customer_id", "yyyymm"
                            )
                    )
               WHERE "prev_month_total" IS NOT NULL
             )
        GROUP BY "customer_id"
        ORDER BY "avg_monthly_change" DESC
        LIMIT 1
     );
```

```sql
--Description: 7) Retrieve the full name of the customer who tops the list
SELECT DISTINCT
       c."first_name" || ' ' || c."last_name" AS "full_name"
FROM   "customer" AS c
WHERE  c."customer_id" = (
         SELECT "customer_id"
         FROM (
                 SELECT "customer_id",
                        AVG("month_change") AS "avg_monthly_change"
                 FROM (
                        SELECT "customer_id",
                               ABS("month_total" - "prev_month_total") AS "month_change"
                        FROM (
                                SELECT "customer_id",
                                       "yyyymm",
                                       "month_total",
                                       LAG("month_total") OVER (PARTITION BY "customer_id"
                                                                ORDER BY "yyyymm") AS "prev_month_total"
                                FROM (
                                        SELECT "customer_id",
                                               strftime('%Y-%m', "payment_date") AS "yyyymm",
                                               SUM("amount") AS "month_total"
                                        FROM   "payment"
                                        GROUP  BY "customer_id", "yyyymm"
                                     )
                             )
                        WHERE "prev_month_total" IS NOT NULL
                      )
                 GROUP  BY "customer_id"
                 ORDER  BY "avg_monthly_change" DESC
                 LIMIT 1
              )
       )
LIMIT 20;
```

The final query (7) returns exactly one row: the full name of the customer who has the highest average month-to-month change in payment amounts.
