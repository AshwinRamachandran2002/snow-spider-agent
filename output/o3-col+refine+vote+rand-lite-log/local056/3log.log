Query:
--Description: 5) Average monthly change in payments for every customer
SELECT DISTINCT
       "customer_id",
       AVG("month_change") AS "avg_monthly_change"
FROM (
        SELECT "customer_id",
               ABS("month_total" - "prev_month_total") AS "month_change"
        FROM (
                SELECT "customer_id",
                       "yyyymm",
                       "month_total",
                       LAG("month_total") OVER (PARTITION BY "customer_id"
                                                ORDER BY "yyyymm") AS "prev_month_total"
                FROM (
                        SELECT "customer_id",
                               strftime('%Y-%m', "payment_date") AS "yyyymm",
                               SUM("amount") AS "month_total"
                        FROM   "payment"
                        GROUP  BY "customer_id", "yyyymm"
                     )
             )
        WHERE "prev_month_total" IS NOT NULL
     )
GROUP  BY "customer_id"
LIMIT 20;
