Query:
--Description: 4) Compute absolute change between consecutive months for every customer
SELECT DISTINCT
       "customer_id",
       ABS("month_total" - "prev_month_total") AS "month_change"
FROM (
        SELECT "customer_id",
               "yyyymm",
               "month_total",
               LAG("month_total") OVER (PARTITION BY "customer_id"
                                        ORDER BY "yyyymm") AS "prev_month_total"
        FROM (
               SELECT "customer_id",
                      strftime('%Y-%m', "payment_date") AS "yyyymm",
                      SUM("amount") AS "month_total"
               FROM   "payment"
               GROUP  BY "customer_id", "yyyymm"
             )
      )
WHERE "prev_month_total" IS NOT NULL          -- need two months to form a change
LIMIT 20;
