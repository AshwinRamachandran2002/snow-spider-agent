```sql
--Description: View a sample of payment data (id, customer, amount, date)
SELECT payment_id, customer_id, amount, payment_date
FROM payment
LIMIT 20;
```

```sql
--Description: Show some distinct customer IDs that appear in the payment table
SELECT DISTINCT customer_id
FROM payment
LIMIT 20;
```

```sql
--Description: Calculate each customer’s total payment amount per month (sample 20 rows)
SELECT customer_id,
       strftime('%Y-%m', payment_date) AS yr_month,
       SUM(amount) AS monthly_total
FROM payment
GROUP BY customer_id, yr_month
LIMIT 20;
```

```sql
--Description: Inspect the month-by-month totals for one customer (customer_id = 1)
SELECT customer_id,
       yr_month,
       monthly_total
FROM (
  SELECT customer_id,
         strftime('%Y-%m', payment_date) AS yr_month,
         SUM(amount) AS monthly_total
  FROM payment
  GROUP BY customer_id, yr_month
)
WHERE customer_id = 1
ORDER BY yr_month
LIMIT 20;
```

```sql
--Description: For every customer-month row, compute the absolute difference from the previous month
SELECT customer_id,
       yr_month,
       monthly_total,
       LAG(monthly_total) OVER (PARTITION BY customer_id ORDER BY yr_month)         AS prev_month_total,
       ABS(monthly_total - LAG(monthly_total) OVER (PARTITION BY customer_id ORDER BY yr_month))
         AS month_diff
FROM (
  SELECT customer_id,
         strftime('%Y-%m', payment_date) AS yr_month,
         SUM(amount) AS monthly_total
  FROM payment
  GROUP BY customer_id, yr_month
)
LIMIT 20;
```

```sql
--Description: Compute each customer’s average monthly change in payments
SELECT customer_id,
       AVG(month_diff) AS avg_monthly_change
FROM (
  SELECT customer_id,
         yr_month,
         monthly_total,
         ABS(monthly_total - LAG(monthly_total) OVER (PARTITION BY customer_id ORDER BY yr_month)) AS month_diff
  FROM (
    SELECT customer_id,
           strftime('%Y-%m', payment_date) AS yr_month,
           SUM(amount) AS monthly_total
    FROM payment
    GROUP BY customer_id, yr_month
  )
)
GROUP BY customer_id
LIMIT 20;
```

```sql
--Description: List customers ordered by their average monthly change (largest first)
SELECT customer_id,
       avg_monthly_change
FROM (
  SELECT customer_id,
         AVG(month_diff) AS avg_monthly_change
  FROM (
    SELECT customer_id,
           yr_month,
           monthly_total,
           ABS(monthly_total - LAG(monthly_total) OVER (PARTITION BY customer_id ORDER BY yr_month)) AS month_diff
    FROM (
      SELECT customer_id,
             strftime('%Y-%m', payment_date) AS yr_month,
             SUM(amount) AS monthly_total
      FROM payment
      GROUP BY customer_id, yr_month
    )
  )
  GROUP BY customer_id
)
ORDER BY avg_monthly_change DESC
LIMIT 20;
```

```sql
--Description: Attach customer names to their average monthly change, show top 20
SELECT c.customer_id,
       c.first_name || ' ' || c.last_name AS full_name,
       t.avg_monthly_change
FROM (
  SELECT customer_id,
         AVG(month_diff) AS avg_monthly_change
  FROM (
    SELECT customer_id,
           yr_month,
           monthly_total,
           ABS(monthly_total - LAG(monthly_total) OVER (PARTITION BY customer_id ORDER BY yr_month)) AS month_diff
    FROM (
      SELECT customer_id,
             strftime('%Y-%m', payment_date) AS yr_month,
             SUM(amount) AS monthly_total
      FROM payment
      GROUP BY customer_id, yr_month
    )
  )
  GROUP BY customer_id
) AS t
JOIN customer AS c ON c.customer_id = t.customer_id
ORDER BY t.avg_monthly_change DESC
LIMIT 20;
```

```sql
--Description: FINAL – customer with the highest average monthly change in payments
SELECT c.first_name || ' ' || c.last_name AS full_name
FROM (
  SELECT customer_id,
         AVG(month_diff) AS avg_monthly_change
  FROM (
    SELECT customer_id,
           yr_month,
           monthly_total,
           ABS(monthly_total - LAG(monthly_total) OVER (PARTITION BY customer_id ORDER BY yr_month)) AS month_diff
    FROM (
      SELECT customer_id,
             strftime('%Y-%m', payment_date) AS yr_month,
             SUM(amount) AS monthly_total
      FROM payment
      GROUP BY customer_id, yr_month
    )
  )
  GROUP BY customer_id
  ORDER BY avg_monthly_change DESC
  LIMIT 1
) AS top_cust
JOIN customer AS c
  ON c.customer_id = top_cust.customer_id;
```
