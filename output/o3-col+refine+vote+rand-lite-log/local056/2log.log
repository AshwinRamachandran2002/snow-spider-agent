Query:
--Description: Calculate month-to-month change in payment totals for every customer (sample rows).
SELECT t."customer_id",
       t."year_month",
       t."monthly_total",
       (t."monthly_total" -
        LAG(t."monthly_total") OVER (PARTITION BY t."customer_id"
                                     ORDER BY t."year_month")) AS "monthly_change"
FROM (
        SELECT "customer_id",
               strftime('%Y-%m', "payment_date") AS "year_month",
               SUM("amount")                      AS "monthly_total"
        FROM   "payment"
        GROUP  BY "customer_id", "year_month"
     ) AS t
ORDER  BY t."customer_id", t."year_month"
LIMIT 20;
