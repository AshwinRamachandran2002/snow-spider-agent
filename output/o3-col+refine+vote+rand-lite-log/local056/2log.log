```sql
--Description: Inspect the first 20 payment rows to understand amounts and dates.
SELECT "payment_id",
       "customer_id",
       "amount",
       "payment_date"
FROM   "payment"
LIMIT 20;
```

```sql
--Description: See which (year-month) periods exist in the payment history.
SELECT DISTINCT strftime('%Y-%m', "payment_date") AS "year_month"
FROM   "payment"
ORDER  BY "year_month"
LIMIT 20;
```

```sql
--Description: List some distinct customers that appear in the payments table.
SELECT DISTINCT "customer_id"
FROM   "payment"
LIMIT 20;
```

```sql
--Description: Compute each customer’s total payment amount per month (sample rows).
SELECT "customer_id",
       strftime('%Y-%m', "payment_date") AS "year_month",
       SUM("amount")                    AS "monthly_total"
FROM   "payment"
GROUP  BY "customer_id", "year_month"
ORDER  BY "customer_id", "year_month"
LIMIT 20;
```

```sql
--Description: Calculate month-to-month change in payment totals for every customer (sample rows).
SELECT t."customer_id",
       t."year_month",
       t."monthly_total",
       (t."monthly_total" -
        LAG(t."monthly_total") OVER (PARTITION BY t."customer_id"
                                     ORDER BY t."year_month")) AS "monthly_change"
FROM (
        SELECT "customer_id",
               strftime('%Y-%m', "payment_date") AS "year_month",
               SUM("amount")                      AS "monthly_total"
        FROM   "payment"
        GROUP  BY "customer_id", "year_month"
     ) AS t
ORDER  BY t."customer_id", t."year_month"
LIMIT 20;
```

```sql
--Description: For every customer, find the average absolute monthly change and show the highest 20 values.
SELECT "customer_id",
       AVG(ABS("monthly_change")) AS "avg_monthly_change"
FROM (
        SELECT t."customer_id",
               t."year_month",
               t."monthly_total",
               (t."monthly_total" -
                LAG(t."monthly_total") OVER (PARTITION BY t."customer_id"
                                             ORDER BY t."year_month")) AS "monthly_change"
        FROM (
                SELECT "customer_id",
                       strftime('%Y-%m', "payment_date") AS "year_month",
                       SUM("amount")                      AS "monthly_total"
                FROM   "payment"
                GROUP  BY "customer_id", "year_month"
             ) AS t
     ) AS diff
WHERE  "monthly_change" IS NOT NULL
GROUP  BY "customer_id"
ORDER  BY "avg_monthly_change" DESC
LIMIT 20;
```

```sql
--Description: Obtain the customer_id having the single highest average monthly change.
SELECT "customer_id"
FROM (
        SELECT "customer_id",
               AVG(ABS("monthly_change")) AS "avg_monthly_change"
        FROM (
                SELECT t."customer_id",
                       t."year_month",
                       t."monthly_total",
                       (t."monthly_total" -
                        LAG(t."monthly_total") OVER (PARTITION BY t."customer_id"
                                                     ORDER BY t."year_month")) AS "monthly_change"
                FROM (
                        SELECT "customer_id",
                               strftime('%Y-%m', "payment_date") AS "year_month",
                               SUM("amount")                      AS "monthly_total"
                        FROM   "payment"
                        GROUP  BY "customer_id", "year_month"
                     ) AS t
             ) AS diff
        WHERE  "monthly_change" IS NOT NULL
        GROUP  BY "customer_id"
     ) AS avg_diff
ORDER  BY "avg_monthly_change" DESC
LIMIT 1;
```

```sql
--Description: Return the full name of the customer with the highest average monthly payment change.
SELECT c."first_name" || ' ' || c."last_name" AS "full_name"
FROM   "customer" AS c
WHERE  c."customer_id" = (
        SELECT "customer_id"
        FROM (
                SELECT "customer_id",
                       AVG(ABS("monthly_change")) AS "avg_monthly_change"
                FROM (
                        SELECT t."customer_id",
                               t."year_month",
                               t."monthly_total",
                               (t."monthly_total" -
                                LAG(t."monthly_total") OVER (PARTITION BY t."customer_id"
                                                             ORDER BY t."year_month")) AS "monthly_change"
                        FROM (
                                SELECT "customer_id",
                                       strftime('%Y-%m', "payment_date") AS "year_month",
                                       SUM("amount")                      AS "monthly_total"
                                FROM   "payment"
                                GROUP  BY "customer_id", "year_month"
                             ) AS t
                     ) AS diff
                WHERE  "monthly_change" IS NOT NULL
                GROUP  BY "customer_id"
             ) AS avg_diff
        ORDER  BY "avg_monthly_change" DESC
        LIMIT 1
);
```
