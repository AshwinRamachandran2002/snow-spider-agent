```sql
--Description: Preview some payment records with dates and amounts.  
SELECT DISTINCT "payment_id", "customer_id", "amount", "payment_date"
FROM "payment"
LIMIT 20;
```

```sql
--Description: Look up the customers’ full names so we can match IDs to names.  
SELECT DISTINCT "customer_id", "first_name", "last_name"
FROM "customer"
LIMIT 20;
```

```sql
--Description: Aggregate each customer’s total payments by calendar month (YYYY-MM).  
SELECT "customer_id",
       strftime('%Y-%m', "payment_date") AS "year_month",
       SUM("amount") AS "monthly_total"
FROM "payment"
GROUP BY "customer_id", "year_month"
LIMIT 20;
```

```sql
--Description: For one customer (id = 1) show month-to-month change to verify logic.  
SELECT "customer_id",
       "year_month",
       "monthly_total",
       "monthly_total" - LAG("monthly_total") OVER (PARTITION BY "customer_id"
                                                    ORDER BY "year_month") AS "diff_from_prev"
FROM (
  SELECT "customer_id",
         strftime('%Y-%m', "payment_date") AS "year_month",
         SUM("amount") AS "monthly_total"
  FROM "payment"
  GROUP BY "customer_id", "year_month"
) AS m
WHERE "customer_id" = 1
LIMIT 20;
```

```sql
--Description: Compute each customer’s average absolute change from one month to the next.  
SELECT "customer_id",
       AVG(ABS("diff_from_prev")) AS "avg_monthly_change"
FROM (
  SELECT "customer_id",
         "year_month",
         "monthly_total",
         "monthly_total" - LAG("monthly_total") OVER (PARTITION BY "customer_id"
                                                      ORDER BY "year_month") AS "diff_from_prev"
  FROM (
    SELECT "customer_id",
           strftime('%Y-%m', "payment_date") AS "year_month",
           SUM("amount") AS "monthly_total"
    FROM "payment"
    GROUP BY "customer_id", "year_month"
  )
)
WHERE "diff_from_prev" IS NOT NULL
GROUP BY "customer_id"
LIMIT 20;
```

```sql
--Description: Identify the customer ID with the highest average monthly change.  
SELECT "customer_id"
FROM (
  SELECT "customer_id",
         AVG(ABS("diff_from_prev")) AS "avg_monthly_change"
  FROM (
    SELECT "customer_id",
           "year_month",
           "monthly_total",
           "monthly_total" - LAG("monthly_total") OVER (PARTITION BY "customer_id"
                                                        ORDER BY "year_month") AS "diff_from_prev"
    FROM (
      SELECT "customer_id",
             strftime('%Y-%m', "payment_date") AS "year_month",
             SUM("amount") AS "monthly_total"
      FROM "payment"
      GROUP BY "customer_id", "year_month"
    )
  )
  WHERE "diff_from_prev" IS NOT NULL
  GROUP BY "customer_id"
) AS stats
ORDER BY "avg_monthly_change" DESC
LIMIT 1;
```

```sql
--Description: Retrieve that customer’s full name – this answers the task.  
SELECT DISTINCT c."first_name" || ' ' || c."last_name" AS "full_name"
FROM "customer"        AS c
JOIN (
  SELECT "customer_id"
  FROM (
    SELECT "customer_id",
           AVG(ABS("diff_from_prev")) AS "avg_monthly_change"
    FROM (
      SELECT "customer_id",
             "year_month",
             "monthly_total",
             "monthly_total" - LAG("monthly_total") OVER (PARTITION BY "customer_id"
                                                          ORDER BY "year_month") AS "diff_from_prev"
      FROM (
        SELECT "customer_id",
               strftime('%Y-%m', "payment_date") AS "year_month",
               SUM("amount") AS "monthly_total"
        FROM "payment"
        GROUP BY "customer_id", "year_month"
      )
    )
    WHERE "diff_from_prev" IS NOT NULL
    GROUP BY "customer_id"
    ORDER BY "avg_monthly_change" DESC
    LIMIT 1
  )
) AS top ON c."customer_id" = top."customer_id";
```

Running the last query returns the full name of the customer who shows the highest average month-to-month change in payment amounts.
