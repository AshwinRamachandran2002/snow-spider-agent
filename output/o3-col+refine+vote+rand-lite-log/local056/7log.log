Query:
--Description: For one customer (id = 1) show month-to-month change to verify logic.  
SELECT "customer_id",
       "year_month",
       "monthly_total",
       "monthly_total" - LAG("monthly_total") OVER (PARTITION BY "customer_id"
                                                    ORDER BY "year_month") AS "diff_from_prev"
FROM (
  SELECT "customer_id",
         strftime('%Y-%m', "payment_date") AS "year_month",
         SUM("amount") AS "monthly_total"
  FROM "payment"
  GROUP BY "customer_id", "year_month"
) AS m
WHERE "customer_id" = 1
LIMIT 20;
