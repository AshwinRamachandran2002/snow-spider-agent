Query:
-- Description: Add friendly and hostile PERCENTAGES for each of those top-10 states
SELECT s."state",
       SUM(CASE WHEN a."aggressive" = 0 THEN 1 ELSE 0 END)*1.0/COUNT(*) AS "friendly_pct",
       SUM(CASE WHEN a."aggressive" = 1 THEN 1 ELSE 0 END)*1.0/COUNT(*) AS "hostile_pct",
       AVG(a."age")                                                    AS "average_age"
FROM   (
        SELECT "state"
        FROM   "alien_data"
        GROUP  BY "state"
        ORDER  BY COUNT(*) DESC
        LIMIT  10
       ) AS s
JOIN   "alien_data" AS a
  ON   a."state" = s."state"
GROUP  BY s."state"
LIMIT 20;
