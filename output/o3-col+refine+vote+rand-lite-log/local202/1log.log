```sql
-- Description: Show alien population by state, ordered from largest to smallest
SELECT "state",
       COUNT(*) AS "population"
FROM "alien_data"
GROUP BY "state"
ORDER BY "population" DESC
LIMIT 20;
```

```sql
-- Description: Retrieve the TOP 10 states with the greatest number of aliens
SELECT "state",
       COUNT(*) AS "population"
FROM "alien_data"
GROUP BY "state"
ORDER BY "population" DESC
LIMIT 10;
```

```sql
-- Description: For those top-10 states, compute friendly/hostile counts and average age
SELECT s."state",
       SUM(CASE WHEN a."aggressive" = 0 THEN 1 ELSE 0 END) AS "friendly_count",
       SUM(CASE WHEN a."aggressive" = 1 THEN 1 ELSE 0 END) AS "hostile_count",
       AVG(a."age")                                           AS "average_age"
FROM (
     SELECT "state"
     FROM   "alien_data"
     GROUP  BY "state"
     ORDER  BY COUNT(*) DESC
     LIMIT  10
) AS s
JOIN "alien_data" AS a
  ON a."state" = s."state"
GROUP BY s."state"
LIMIT 20;
```

```sql
-- Description: Add friendly and hostile PERCENTAGES for each of those top-10 states
SELECT s."state",
       SUM(CASE WHEN a."aggressive" = 0 THEN 1 ELSE 0 END)*1.0/COUNT(*) AS "friendly_pct",
       SUM(CASE WHEN a."aggressive" = 1 THEN 1 ELSE 0 END)*1.0/COUNT(*) AS "hostile_pct",
       AVG(a."age")                                                    AS "average_age"
FROM   (
        SELECT "state"
        FROM   "alien_data"
        GROUP  BY "state"
        ORDER  BY COUNT(*) DESC
        LIMIT  10
       ) AS s
JOIN   "alien_data" AS a
  ON   a."state" = s."state"
GROUP  BY s."state"
LIMIT 20;
```

```sql
-- Description: Keep only states where friendly % > hostile % AND average age > 200
SELECT s."state",
       SUM(CASE WHEN a."aggressive" = 0 THEN 1 ELSE 0 END)*1.0/COUNT(*) AS "friendly_pct",
       SUM(CASE WHEN a."aggressive" = 1 THEN 1 ELSE 0 END)*1.0/COUNT(*) AS "hostile_pct",
       AVG(a."age")                                                    AS "average_age"
FROM   (
        SELECT "state"
        FROM   "alien_data"
        GROUP  BY "state"
        ORDER  BY COUNT(*) DESC
        LIMIT  10
       ) AS s
JOIN   "alien_data" AS a
  ON   a."state" = s."state"
GROUP  BY s."state"
HAVING "friendly_pct" > "hostile_pct"
   AND "average_age"  > 200
LIMIT 20;
```

```sql
-- Description: FINAL answer – number of the top-10 states that satisfy the criteria
SELECT COUNT(*) AS "num_states"
FROM (
      SELECT s."state"
      FROM   (
              SELECT "state"
              FROM   "alien_data"
              GROUP  BY "state"
              ORDER  BY COUNT(*) DESC
              LIMIT  10
             ) AS s
      JOIN   "alien_data" AS a
        ON   a."state" = s."state"
      GROUP  BY s."state"
      HAVING SUM(CASE WHEN a."aggressive" = 0 THEN 1 ELSE 0 END)*1.0/COUNT(*) 
             > SUM(CASE WHEN a."aggressive" = 1 THEN 1 ELSE 0 END)*1.0/COUNT(*)
         AND AVG(a."age") > 200
) AS t
LIMIT 20;
```
