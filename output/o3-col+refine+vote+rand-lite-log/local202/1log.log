Query:
-- Description: FINAL answer – number of the top-10 states that satisfy the criteria
SELECT COUNT(*) AS "num_states"
FROM (
      SELECT s."state"
      FROM   (
              SELECT "state"
              FROM   "alien_data"
              GROUP  BY "state"
              ORDER  BY COUNT(*) DESC
              LIMIT  10
             ) AS s
      JOIN   "alien_data" AS a
        ON   a."state" = s."state"
      GROUP  BY s."state"
      HAVING SUM(CASE WHEN a."aggressive" = 0 THEN 1 ELSE 0 END)*1.0/COUNT(*) 
             > SUM(CASE WHEN a."aggressive" = 1 THEN 1 ELSE 0 END)*1.0/COUNT(*)
         AND AVG(a."age") > 200
) AS t
LIMIT 20;
