Query:
--Description: FINAL ANSWER – Number of TOP-10 states whose friendly percentage exceeds hostile AND average age > 200
WITH top10 AS (
    SELECT state,
           SUM(CASE WHEN aggressive = 0 THEN 1 ELSE 0 END) AS friendly,
           SUM(CASE WHEN aggressive = 1 THEN 1 ELSE 0 END) AS hostile,
           AVG(age)                                        AS avg_age
    FROM alien_data
    GROUP BY state
    ORDER BY COUNT(*) DESC
    LIMIT 10
)
SELECT COUNT(*) AS qualifying_states
FROM top10
WHERE friendly > hostile
  AND avg_age > 200;
