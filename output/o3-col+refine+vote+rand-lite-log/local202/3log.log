```sql
--Description: Check distinct U.S. states in the aliens table
SELECT DISTINCT state 
FROM alien_data
LIMIT 20;
```

```sql
--Description: How many aliens live in each state?
SELECT state,
       COUNT(*) AS total_aliens
FROM alien_data
GROUP BY state
ORDER BY total_aliens DESC
LIMIT 20;
```

```sql
--Description: Count of friendly (aggressive = 0) aliens by state
SELECT state,
       COUNT(*) AS friendly_aliens
FROM alien_data
WHERE aggressive = 0
GROUP BY state
ORDER BY friendly_aliens DESC
LIMIT 20;
```

```sql
--Description: Count of hostile (aggressive = 1) aliens by state
SELECT state,
       COUNT(*) AS hostile_aliens
FROM alien_data
WHERE aggressive = 1
GROUP BY state
ORDER BY hostile_aliens DESC
LIMIT 20;
```

```sql
--Description: Combine friendly-vs-hostile counts with average age per state
SELECT state,
       COUNT(*)                                             AS total_aliens,
       SUM(CASE WHEN aggressive = 0 THEN 1 ELSE 0 END)     AS friendly,
       SUM(CASE WHEN aggressive = 1 THEN 1 ELSE 0 END)     AS hostile,
       AVG(age)                                             AS avg_age
FROM alien_data
GROUP BY state
ORDER BY total_aliens DESC
LIMIT 20;
```

```sql
--Description: Retrieve the TOP 10 states by alien population with their friend/hostile counts & average age
SELECT state,
       COUNT(*)                                             AS total_aliens,
       SUM(CASE WHEN aggressive = 0 THEN 1 ELSE 0 END)     AS friendly,
       SUM(CASE WHEN aggressive = 1 THEN 1 ELSE 0 END)     AS hostile,
       AVG(age)                                             AS avg_age
FROM alien_data
GROUP BY state
ORDER BY total_aliens DESC
LIMIT 10;
```

```sql
--Description: Of those TOP 10 states, show only those where friendly > hostile
WITH top10 AS (
    SELECT state,
           SUM(CASE WHEN aggressive = 0 THEN 1 ELSE 0 END) AS friendly,
           SUM(CASE WHEN aggressive = 1 THEN 1 ELSE 0 END) AS hostile,
           AVG(age)                                        AS avg_age
    FROM alien_data
    GROUP BY state
    ORDER BY COUNT(*) DESC
    LIMIT 10
)
SELECT *
FROM top10
WHERE friendly > hostile
LIMIT 20;
```

```sql
--Description: From the same TOP 10, show only the states whose average age > 200
WITH top10 AS (
    SELECT state,
           SUM(CASE WHEN aggressive = 0 THEN 1 ELSE 0 END) AS friendly,
           SUM(CASE WHEN aggressive = 1 THEN 1 ELSE 0 END) AS hostile,
           AVG(age)                                        AS avg_age
    FROM alien_data
    GROUP BY state
    ORDER BY COUNT(*) DESC
    LIMIT 10
)
SELECT *
FROM top10
WHERE avg_age > 200
LIMIT 20;
```

```sql
--Description: Intersection of both conditions (friendly > hostile AND avg_age > 200) within the TOP 10
WITH top10 AS (
    SELECT state,
           SUM(CASE WHEN aggressive = 0 THEN 1 ELSE 0 END) AS friendly,
           SUM(CASE WHEN aggressive = 1 THEN 1 ELSE 0 END) AS hostile,
           AVG(age)                                        AS avg_age
    FROM alien_data
    GROUP BY state
    ORDER BY COUNT(*) DESC
    LIMIT 10
)
SELECT *
FROM top10
WHERE friendly > hostile
  AND avg_age > 200
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – Number of TOP-10 states whose friendly percentage exceeds hostile AND average age > 200
WITH top10 AS (
    SELECT state,
           SUM(CASE WHEN aggressive = 0 THEN 1 ELSE 0 END) AS friendly,
           SUM(CASE WHEN aggressive = 1 THEN 1 ELSE 0 END) AS hostile,
           AVG(age)                                        AS avg_age
    FROM alien_data
    GROUP BY state
    ORDER BY COUNT(*) DESC
    LIMIT 10
)
SELECT COUNT(*) AS qualifying_states
FROM top10
WHERE friendly > hostile
  AND avg_age > 200;
```
