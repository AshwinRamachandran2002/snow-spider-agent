Query:
--Description: Of those TOP 10 states, show only those where friendly > hostile
WITH top10 AS (
    SELECT state,
           SUM(CASE WHEN aggressive = 0 THEN 1 ELSE 0 END) AS friendly,
           SUM(CASE WHEN aggressive = 1 THEN 1 ELSE 0 END) AS hostile,
           AVG(age)                                        AS avg_age
    FROM alien_data
    GROUP BY state
    ORDER BY COUNT(*) DESC
    LIMIT 10
)
SELECT *
FROM top10
WHERE friendly > hostile
LIMIT 20;
