Query:
--Description: Intersection of both conditions (friendly > hostile AND avg_age > 200) within the TOP 10
WITH top10 AS (
    SELECT state,
           SUM(CASE WHEN aggressive = 0 THEN 1 ELSE 0 END) AS friendly,
           SUM(CASE WHEN aggressive = 1 THEN 1 ELSE 0 END) AS hostile,
           AVG(age)                                        AS avg_age
    FROM alien_data
    GROUP BY state
    ORDER BY COUNT(*) DESC
    LIMIT 10
)
SELECT *
FROM top10
