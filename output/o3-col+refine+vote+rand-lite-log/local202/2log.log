--Description: Finally, count how many of those top-10 states satisfy all the criteria
WITH top_states AS (
    SELECT "state"
    FROM "alien_data"
    GROUP BY "state"
    ORDER BY COUNT(*) DESC
    LIMIT 10
),
state_stats AS (
    SELECT ad."state",
