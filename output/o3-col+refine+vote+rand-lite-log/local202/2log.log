```sql
--Description: Inspect what U.S. states are present in the alien data
SELECT DISTINCT "state"
FROM "alien_data"
LIMIT 20;
```

```sql
--Description: See the total alien population by state, ordered from highest to lowest
SELECT "state",
       COUNT(*) AS "alien_count"
FROM "alien_data"
GROUP BY "state"
ORDER BY "alien_count" DESC
LIMIT 20;
```

```sql
--Description: Preview the top-10 states with the largest alien populations
SELECT "state",
       COUNT(*) AS "alien_count"
FROM "alien_data"
GROUP BY "state"
ORDER BY "alien_count" DESC
LIMIT 10;
```

```sql
--Description: For every state, calculate friendly vs. hostile counts, percentages, and average age
SELECT "state",
       COUNT(*)                                          AS "total_aliens",
       AVG("age")                                        AS "avg_age",
       SUM(CASE WHEN "aggressive" = 0 THEN 1 END)        AS "friendly",
       SUM(CASE WHEN "aggressive" = 1 THEN 1 END)        AS "hostile",
       1.0 * SUM(CASE WHEN "aggressive" = 0 THEN 1 END) / COUNT(*) AS "pct_friendly",
       1.0 * SUM(CASE WHEN "aggressive" = 1 THEN 1 END) / COUNT(*) AS "pct_hostile"
FROM "alien_data"
GROUP BY "state"
ORDER BY "total_aliens" DESC
LIMIT 20;
```

```sql
--Description: Store the 10 most-populated states in a Common Table Expression (CTE) for reuse
WITH top_states AS (
    SELECT "state"
    FROM "alien_data"
    GROUP BY "state"
    ORDER BY COUNT(*) DESC
    LIMIT 10
)
SELECT *
FROM top_states;
```

```sql
--Description: For those top-10 states, recompute friendly vs. hostile counts and average age
WITH top_states AS (
    SELECT "state"
    FROM "alien_data"
    GROUP BY "state"
    ORDER BY COUNT(*) DESC
    LIMIT 10
)
SELECT ad."state",
       COUNT(*)                                          AS "total_aliens",
       AVG(ad."age")                                     AS "avg_age",
       SUM(CASE WHEN ad."aggressive" = 0 THEN 1 END)     AS "friendly",
       SUM(CASE WHEN ad."aggressive" = 1 THEN 1 END)     AS "hostile"
FROM "alien_data" AS ad
JOIN top_states        ts ON ad."state" = ts."state"
GROUP BY ad."state";
```

```sql
--Description: Filter those top-10 states to just the ones whose avg age > 200 and pct friendly > pct hostile
WITH top_states AS (
    SELECT "state"
    FROM "alien_data"
    GROUP BY "state"
    ORDER BY COUNT(*) DESC
    LIMIT 10
),
state_stats AS (
    SELECT ad."state",
           AVG(ad."age")                                 AS "avg_age",
           SUM(CASE WHEN ad."aggressive" = 0 THEN 1 END) AS "friendly",
           SUM(CASE WHEN ad."aggressive" = 1 THEN 1 END) AS "hostile",
           COUNT(*)                                      AS "total"
    FROM "alien_data" AS ad
    JOIN top_states        ts ON ad."state" = ts."state"
    GROUP BY ad."state"
)
SELECT "state",
       "avg_age",
       1.0 * "friendly" / "total"  AS "pct_friendly",
       1.0 * "hostile" / "total"   AS "pct_hostile"
FROM state_stats
WHERE "avg_age" > 200
  AND "friendly" > "hostile";
```

```sql
--Description: Return just the states that meet all three conditions (top-10, friendlier, avg age > 200)
WITH top_states AS (
    SELECT "state"
    FROM "alien_data"
    GROUP BY "state"
    ORDER BY COUNT(*) DESC
    LIMIT 10
),
state_stats AS (
    SELECT ad."state",
           AVG(ad."age")                                 AS "avg_age",
           SUM(CASE WHEN ad."aggressive" = 0 THEN 1 END) AS "friendly",
           SUM(CASE WHEN ad."aggressive" = 1 THEN 1 END) AS "hostile",
           COUNT(*)                                      AS "total"
    FROM "alien_data" AS ad
    JOIN top_states        ts ON ad."state" = ts."state"
    GROUP BY ad."state"
)
SELECT "state"
FROM state_stats
WHERE "avg_age"  > 200
  AND "friendly" >  "hostile";
```

```sql
--Description: Finally, count how many of those top-10 states satisfy all the criteria
WITH top_states AS (
    SELECT "state"
    FROM "alien_data"
    GROUP BY "state"
    ORDER BY COUNT(*) DESC
    LIMIT 10
),
state_stats AS (
    SELECT ad."state",
           AVG(ad."age")                                 AS "avg_age",
           SUM(CASE WHEN ad."aggressive" = 0 THEN 1 END) AS "friendly",
           SUM(CASE WHEN ad."aggressive" = 1 THEN 1 END) AS "hostile",
           COUNT(*)                                      AS "total"
    FROM "alien_data" AS ad
    JOIN top_states        ts ON ad."state" = ts."state"
    GROUP BY ad."state"
)
SELECT COUNT(*) AS "num_states_meeting_criteria"
FROM state_stats
WHERE "avg_age"  > 200
  AND "friendly" > "hostile";
```

```sql
--Description: Quick sanity check—show the states that did NOT meet the criteria (optional)
WITH top_states AS (
    SELECT "state"
    FROM "alien_data"
    GROUP BY "state"
    ORDER BY COUNT(*) DESC
    LIMIT 10
),
state_stats AS (
    SELECT ad."state",
           AVG(ad."age")                                 AS "avg_age",
           SUM(CASE WHEN ad."aggressive" = 0 THEN 1 END) AS "friendly",
           SUM(CASE WHEN ad."aggressive" = 1 THEN 1 END) AS "hostile",
           COUNT(*)                                      AS "total"
    FROM "alien_data" AS ad
    JOIN top_states        ts ON ad."state" = ts."state"
    GROUP BY ad."state"
)
SELECT "state",
       "avg_age",
       "friendly",
       "hostile",
       "total"
FROM state_stats
WHERE NOT ("avg_age" > 200 AND "friendly" > "hostile");
```
