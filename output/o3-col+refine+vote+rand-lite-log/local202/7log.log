```sql
-- Description: View a sample of aliens with their state, age, and aggression flag to understand the basic data we will work with
SELECT "id", "state", "age", "aggressive"
FROM "alien_data"
LIMIT 20;
```

```sql
-- Description: See how many total aliens are recorded for each state
SELECT "state",
       COUNT(*) AS total_aliens
FROM "alien_data"
GROUP BY "state"
ORDER BY total_aliens DESC
LIMIT 20;
```

```sql
-- Description: Identify the 10 states with the largest alien populations
SELECT "state",
       COUNT(*) AS total_aliens
FROM "alien_data"
GROUP BY "state"
ORDER BY total_aliens DESC
LIMIT 10;
```

```sql
-- Description: For every state, calculate the number of friendly (aggressive = 0) and hostile (aggressive = 1) aliens
SELECT "state",
       SUM(CASE WHEN "aggressive" = 0 THEN 1 ELSE 0 END) AS friendly_aliens,
       SUM(CASE WHEN "aggressive" = 1 THEN 1 ELSE 0 END) AS hostile_aliens
FROM "alien_data"
GROUP BY "state"
LIMIT 20;
```

```sql
-- Description: Compute state-level statistics we will need (friendly vs hostile counts and average age)
SELECT "state",
       COUNT(*)                                                AS total_aliens,
       SUM(CASE WHEN "aggressive" = 0 THEN 1 ELSE 0 END)       AS friendly_aliens,
       SUM(CASE WHEN "aggressive" = 1 THEN 1 ELSE 0 END)       AS hostile_aliens,
       AVG("age")                                              AS avg_age
FROM "alien_data"
GROUP BY "state"
LIMIT 20;
```

```sql
-- Description: Build a CTE that limits the data to the 10 most-populated states, then keep only those with
--  (1) more friendly than hostile aliens AND (2) average age > 200.  List those states and their stats.
WITH top_states AS (
    SELECT "state"
    FROM "alien_data"
    GROUP BY "state"
    ORDER BY COUNT(*) DESC
    LIMIT 10
)
SELECT a."state",
       COUNT(*)                                                AS total_aliens,
       SUM(CASE WHEN a."aggressive" = 0 THEN 1 ELSE 0 END)     AS friendly_aliens,
       SUM(CASE WHEN a."aggressive" = 1 THEN 1 ELSE 0 END)     AS hostile_aliens,
       AVG(a."age")                                            AS avg_age
FROM   "alien_data" AS a
JOIN   top_states   AS t
  ON   a."state" = t."state"
GROUP BY a."state"
HAVING friendly_aliens > hostile_aliens
   AND avg_age       > 200;
```

```sql
-- Description: Final answer – count how many of the top 10 states satisfy both conditions
WITH top_states AS (
    SELECT "state"
    FROM "alien_data"
    GROUP BY "state"
    ORDER BY COUNT(*) DESC
    LIMIT 10
),
state_stats AS (
    SELECT a."state",
           SUM(CASE WHEN a."aggressive" = 0 THEN 1 ELSE 0 END) AS friendly_aliens,
           SUM(CASE WHEN a."aggressive" = 1 THEN 1 ELSE 0 END) AS hostile_aliens,
           AVG(a."age")                                         AS avg_age
    FROM   "alien_data" AS a
    JOIN   top_states   AS t
      ON   a."state" = t."state"
    GROUP BY a."state"
)
SELECT COUNT(*) AS qualifying_states
FROM   state_stats
WHERE  friendly_aliens > hostile_aliens
  AND  avg_age         > 200;
```
