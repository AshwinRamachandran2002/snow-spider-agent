2025-05-05 04:45:50 - Thread-3878 (execute) - INFO - [Exploration]
```sql
--Description: Inspect the different U.S. states recorded for aliens
SELECT DISTINCT "state"
FROM "alien_data"
LIMIT 20;
```

```sql
--Description: Count alien population per state (ordered, all states)
SELECT LOWER("state") AS "state",
       COUNT(*)       AS "population"
FROM   "alien_data"
GROUP  BY LOWER("state")
ORDER  BY "population" DESC
LIMIT 20;
```

```sql
--Description: Retrieve the 10 states with the largest alien populations
SELECT LOWER("state") AS "state",
       COUNT(*)       AS "population"
FROM   "alien_data"
GROUP  BY LOWER("state")
ORDER  BY "population" DESC
LIMIT 10;
```

```sql
--Description: Friendly vs. hostile counts for every state
SELECT LOWER("state")                                   AS "state",
       SUM(CASE WHEN "aggressive" = 0 THEN 1 END)       AS "friendly_count",
       SUM(CASE WHEN "aggressive" = 1 THEN 1 END)       AS "hostile_count"
FROM   "alien_data"
GROUP  BY LOWER("state")
LIMIT 20;
```

```sql
--Description: Friendly-versus-hostile percentages for each state
SELECT "state",
       "friendly_count" * 1.0 / ("friendly_count" + "hostile_count") AS "pct_friendly",
       "hostile_count"  * 1.0 / ("friendly_count" + "hostile_count") AS "pct_hostile"
FROM (
      SELECT LOWER("state")                              AS "state",
             SUM(CASE WHEN "aggressive" = 0 THEN 1 END)  AS "friendly_count",
             SUM(CASE WHEN "aggressive" = 1 THEN 1 END)  AS "hostile_count"
      FROM   "alien_data"
      GROUP  BY LOWER("state")
     )
LIMIT 20;
```

```sql
--Description: Average alien age per state (only those with avg age > 200)
SELECT LOWER("state") AS "state",
       AVG("age")     AS "avg_age"
FROM   "alien_data"
GROUP  BY LOWER("state")
HAVING AVG("age") > 200
LIMIT 20;
```

```sql
--Description: Combine population, friendliness, and average age for the 10 most-populated states
SELECT t."state",
       t."population",
       t."friendly_count",
       t."hostile_count",
       t."avg_age"
FROM (
      SELECT LOWER("state")                              AS "state",
             COUNT(*)                                    AS "population",
             SUM(CASE WHEN "aggressive" = 0 THEN 1 END)  AS "friendly_count",
             SUM(CASE WHEN "aggressive" = 1 THEN 1 END)  AS "hostile_count",
             AVG("age")                                  AS "avg_age"
      FROM   "alien_data"
      GROUP  BY LOWER("state")
     ) AS t
ORDER BY t."population" DESC
LIMIT 10;
```

```sql
--Description: FINAL – How many of the top-10 states have more friendly than hostile aliens and avg age > 200?
SELECT COUNT(*) AS "states_friendly_over_hostile"
FROM (
      SELECT LOWER("state")                              AS "state",
             COUNT(*)                                    AS "population",
             SUM(CASE WHEN "aggressive" = 0 THEN 1 END)  AS "friendly_count",
             SUM(CASE WHEN "aggressive" = 1 THEN 1 END)  AS "hostile_count",
             AVG("age")                                  AS "avg_age"
      FROM   "alien_data"
      GROUP  BY LOWER("state")
      ORDER  BY "population" DESC
      LIMIT 10
     ) AS "top_states"
WHERE "friendly_count" > "hostile_count"
  AND  "avg_age" > 200;
```
