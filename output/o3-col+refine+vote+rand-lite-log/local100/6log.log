--Description: 4) Count the number of “Khan-number 1” actors.  
--A Khan-number 1 actor appears in a movie with at least one “Khan”-named
--actor but is not a “Khan” actor themselves.  Because PIDs inside M_Cast
--contain leading blanks, TRIM() is used whenever we compare to Person.PID.
SELECT COUNT(DISTINCT TRIM(c.PID)) AS num_khan_number_1
FROM M_Cast AS c
WHERE c.MID IN (                              -- any movie with a Khan actor
        SELECT DISTINCT mc.MID
        FROM M_Cast AS mc
