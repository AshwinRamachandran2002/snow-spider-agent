    WHERE mc.MID IN (
            SELECT DISTINCT mc2.MID
            FROM M_Cast AS mc2
            WHERE mc2.PID IN (
                  SELECT DISTINCT c.PID
                  FROM M_Cast AS c
                  WHERE c.MID IN (SELECT DISTINCT MID
                                  FROM M_Cast
                                  WHERE PID IN (SELECT PID
                                                FROM Person
                                                WHERE Name LIKE '%Shahrukh%Khan%'))
                    AND c.PID NOT IN (SELECT PID
                                      FROM Person
                                      WHERE Name LIKE '%Shahrukh%Khan%')
            )
    )
    AND mc.PID NOT IN (SELECT PID
                       FROM Person
                       WHERE Name LIKE '%Shahrukh%Khan%')
    AND mc.PID NOT IN (
            SELECT DISTINCT c.PID
            FROM M_Cast AS c
            WHERE c.MID IN (SELECT DISTINCT MID
                            FROM M_Cast
                            WHERE PID IN (SELECT PID
                                          FROM Person
                                          WHERE Name LIKE '%Shahrukh%Khan%'))
              AND c.PID NOT IN (SELECT PID
                                FROM Person
                                WHERE Name LIKE '%Shahrukh%Khan%')
    )
) AS t;
```

These eight queries progressively discover Shahrukh Khan’s co-actors (number 1), then the actors who worked with those co-actors but never directly with Shahrukh, finally returning the total count of such Shahrukh-number 2 actors.
