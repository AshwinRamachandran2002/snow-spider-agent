--Description: 8) Final tally: count how many distinct actors have a
--Khan-number 2 (co-actors-of-co-actors who never worked with a Khan actor).
SELECT COUNT(*) AS num_khan_number_2
FROM (
        SELECT DISTINCT TRIM(mc.PID) AS PID
        FROM M_Cast AS mc
        WHERE mc.MID IN (
                SELECT DISTINCT m2.MID
                FROM M_Cast AS m2
                WHERE TRIM(m2.PID) IN (
                        SELECT DISTINCT TRIM(c.PID)    -- Khan-number 1 list
                        FROM M_Cast AS c
                        WHERE c.MID IN (
                                SELECT DISTINCT k.MID
                                FROM M_Cast AS k
                                WHERE TRIM(k.PID) IN (SELECT PID
                                                      FROM Person
                                                      WHERE Name LIKE '%Khan%')
                        )
                        AND TRIM(c.PID) NOT IN (SELECT PID
                                               FROM Person
                                               WHERE Name LIKE '%Khan%')
                )
        )
        AND TRIM(mc.PID) NOT IN (SELECT PID
                                 FROM Person
                                 WHERE Name LIKE '%Khan%')       -- remove Khan actors
        AND TRIM(mc.PID) NOT IN (                                -- remove Khan-num 1
                SELECT DISTINCT TRIM(c.PID)
                FROM M_Cast AS c
                WHERE c.MID IN (
                        SELECT DISTINCT k.MID
                        FROM M_Cast AS k
                        WHERE TRIM(k.PID) IN (SELECT PID
                                              FROM Person
                                              WHERE Name LIKE '%Khan%')
                )
                AND TRIM(c.PID) NOT IN (SELECT PID
                                       FROM Person
                                       WHERE Name LIKE '%Khan%')
        )
) AS t
