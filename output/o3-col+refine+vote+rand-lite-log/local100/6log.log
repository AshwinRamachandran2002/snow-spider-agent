--Description: Check whether any “Khan”-named individuals actually appear in the cast list.
--We join Person and M_Cast on a trimmed PID (to remove the leading space stored in M_Cast)
--and list up to 20 (MID, PID, Name) records. If this returns no rows, it confirms
--that none of the “Khan” actors are linked to any movie in M_Cast, explaining the earlier emptiness.
SELECT DISTINCT mc.MID,
                p.PID,
                p.Name
FROM Person AS p
JOIN M_Cast AS mc
     ON TRIM(mc.PID) = p.PID
WHERE p.Name LIKE '%Khan%'
LIMIT 20;
