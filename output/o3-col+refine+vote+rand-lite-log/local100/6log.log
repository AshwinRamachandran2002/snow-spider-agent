                FROM M_Cast AS m2
                WHERE TRIM(m2.PID) IN (SELECT PID
                                        FROM Person
                                        WHERE Name LIKE '%Khan%')
        )
        AND TRIM(c.PID) NOT IN (SELECT PID
                               FROM Person
                               WHERE Name LIKE '%Khan%')
)
LIMIT 20
