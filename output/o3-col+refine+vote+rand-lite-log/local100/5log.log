```sql
--Description: One-shot query to count actors whose “Shahrukh-number” is 2.  
--Logic inside CTEs:  
-- 1) shahrukh   : identify Shahrukh Khan’s PID(s) (trimmed because of leading spaces).  
-- 2) first_deg  : anyone who shares a movie with Shahrukh, excluding Shahrukh himself.  
-- 3) second_raw : anyone who shares a movie with at least one first-degree actor.  
-- 4) Final SELECT counts distinct PIDs in second_raw that are neither Shahrukh nor first-degree.  
--    NOT EXISTS is used instead of NOT IN to sidestep NULL / empty-set issues.
WITH
  shahrukh AS (
      SELECT TRIM("PID") AS pid
      FROM "Person"
      WHERE "Name" LIKE '%Shahrukh%'
  ),
  first_deg AS (
      SELECT DISTINCT TRIM(c2."PID") AS pid
      FROM shahrukh      s
      JOIN "M_Cast"      cS ON TRIM(cS."PID") = s.pid      -- Shahrukh’s movie rows
      JOIN "M_Cast"      c2 ON cS."MID"    = c2."MID"      -- co-actors in those movies
      WHERE NOT EXISTS (SELECT 1 FROM shahrukh WHERE pid = TRIM(c2."PID"))
  ),
  second_raw AS (
      SELECT DISTINCT TRIM(c3."PID") AS pid
      FROM first_deg     f
      JOIN "M_Cast"      cF ON TRIM(cF."PID") = f.pid      -- movies with a first-degree actor
      JOIN "M_Cast"      c3 ON cF."MID"    = c3."MID"      -- all cast in those movies
  )
SELECT COUNT(DISTINCT sr.pid) AS shahrukh_number_2
FROM second_raw sr
WHERE NOT EXISTS (SELECT 1 FROM shahrukh  s WHERE s.pid = sr.pid)   -- exclude Shahrukh
  AND NOT EXISTS (SELECT 1 FROM first_deg f WHERE f.pid = sr.pid);  -- exclude first degree
```
