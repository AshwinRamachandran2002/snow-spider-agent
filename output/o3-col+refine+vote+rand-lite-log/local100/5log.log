Query:
--Description: 3. First-degree co-actors (actors who appeared in at least one movie with Shahrukh, excluding Shahrukh himself).  
--Every equality on PID is wrapped in TRIM() to neutralise the leading-space issue.
SELECT DISTINCT TRIM(c2."PID") AS "PID", p2."Name"
FROM "Person"   AS pS                                    -- Shahrukh rows
JOIN "M_Cast"   AS cS  ON TRIM(pS."PID") = TRIM(cS."PID")
JOIN "M_Cast"   AS c2  ON cS."MID"    = c2."MID"         -- all cast in the same movies
JOIN "Person"   AS p2  ON TRIM(p2."PID") = TRIM(c2."PID")
WHERE pS."Name" LIKE '%Shahrukh%'
  AND p2."Name" NOT LIKE '%Shahrukh%'                    -- drop Shahrukh himself
LIMIT 20
