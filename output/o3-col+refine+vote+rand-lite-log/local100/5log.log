Query:
--Description: 7. Second-degree candidates with Shahrukh and all first-degree actors removed.
WITH first_deg AS (
        SELECT DISTINCT TRIM(c2."PID") AS pid
        FROM "Person"  AS pS
        JOIN "M_Cast"  AS cS ON TRIM(pS."PID") = TRIM(cS."PID")
        JOIN "M_Cast"  AS c2 ON cS."MID" = c2."MID"
        JOIN "Person"  AS p2 ON TRIM(p2."PID") = TRIM(c2."PID")
        WHERE pS."Name" LIKE '%Shahrukh%'
          AND p2."Name" NOT LIKE '%Shahrukh%'
), second_raw AS (
        SELECT DISTINCT TRIM(mc3."PID") AS pid
        FROM first_deg
        JOIN "M_Cast" AS mc_fd ON TRIM(mc_fd."PID") = first_deg.pid
        JOIN "M_Cast" AS mc3   ON mc_fd."MID" = mc3."MID"
)
SELECT DISTINCT p."PID", p."Name"
FROM second_raw sr
JOIN "Person"  p ON TRIM(p."PID") = sr.pid
WHERE p."Name" NOT LIKE '%Shahrukh%'              -- drop Shahrukh
  AND sr.pid NOT IN (SELECT pid FROM first_deg)   -- drop first degree
LIMIT 20
