```sql
--Description: 10. Final succinct count of actors whose Shahrukh-number is exactly 2
WITH
    shahrukh_pid AS (                -- Shahrukh himself
        SELECT TRIM("PID") AS pid
        FROM "Person"
        WHERE "Name" LIKE '%Shahrukh%'
    ),
    first_deg AS (                   -- degree-1 actors
        SELECT DISTINCT TRIM(c2."PID") AS pid
        FROM shahrukh_pid  s
        JOIN "M_Cast"      cS  ON TRIM(cS."PID") = s.pid
        JOIN "M_Cast"      c2  ON cS."MID" = c2."MID"
        WHERE TRIM(c2."PID") NOT IN (SELECT pid FROM shahrukh_pid)
    ),
    second_deg_raw AS (              -- anybody who worked with first-degree
        SELECT DISTINCT TRIM(c3."PID") AS pid
        FROM first_deg      f
        JOIN "M_Cast"       cF ON TRIM(cF."PID") = f.pid
        JOIN "M_Cast"       c3 ON cF."MID" = c3."MID"
    )
SELECT COUNT(DISTINCT pid) AS shahrukh_number_2
FROM second_deg_raw
WHERE pid NOT IN (SELECT pid FROM first_deg)      -- remove 1-degree
  AND pid NOT IN (SELECT pid FROM shahrukh_pid);  -- remove Shahrukh
```
