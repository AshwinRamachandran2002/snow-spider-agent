  AND p."PID" NOT IN (                           -- remove number-1 actors
      SELECT mc2."PID"
      FROM "M_Cast" AS mc1
      JOIN "Person" AS srk ON mc1."PID" = srk."PID"
      JOIN "M_Cast"  AS mc2 ON mc1."MID" = mc2."MID"
      WHERE srk."Name" LIKE '%Shahrukh%Khan%'
        AND mc2."PID" <> srk."PID")
  AND p."PID" NOT IN (                           -- remove Shahrukh himself
      SELECT srk."PID" FROM "Person" AS srk WHERE srk."Name" LIKE '%Shahrukh%Khan%')
LIMIT 20;
