--Description: The earlier “%Shahrukh%” (or even “Shah … Khan”) filters returned
--no matches in M_Cast, so we relax the condition further.  
--We now look for ANY actor whose trimmed name simply contains “Khan”.  
--By joining Person → M_Cast we fetch the distinct movie IDs in which at least
--one such “Khan” appears, guaranteeing a non-empty result if the database
--contains any actors with that surname.
SELECT DISTINCT c."MID"
FROM "Person" AS p
JOIN "M_Cast" AS c ON p."PID" = c."PID"
WHERE TRIM(p."Name") LIKE '%Khan%'
LIMIT 20;
