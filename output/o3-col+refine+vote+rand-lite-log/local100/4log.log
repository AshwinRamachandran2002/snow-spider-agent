```sql
--Description: The earlier search with “%Shahrukh%” returned no rows, so we broaden
--the criteria.  We join Person → M_Cast and look for any cast member whose
--trimmed name simultaneously contains the substrings “Shah” and “Khan”.
--This captures possible spellings such as “Shah Rukh Khan”, “Shahrukh Khan”,
--etc., and returns the distinct movie IDs in which that person appears.
SELECT DISTINCT c."MID"
FROM "M_Cast"  AS c
JOIN "Person" AS p ON p."PID" = c."PID"
WHERE TRIM(p."Name") LIKE '%Shah%'   -- contains “Shah”
  AND TRIM(p."Name") LIKE '%Khan%'   -- contains “Khan”
LIMIT 20;
```
