--Description:
-- Retrieve all movie IDs that feature Shah Rukh Khan.  
-- In M_Cast the PID strings begin with a space (e.g. ' nm0451321'), so TRIM
-- is used to align them with Person.PID.  A single LIKE '%Rukh%' filter is
-- sufficient to isolate Shah Rukh Khan and avoids the overly strict double-LIKE
-- that previously returned no rows.
SELECT DISTINCT mc."MID"
FROM "M_Cast" AS mc
JOIN "Person" AS p
     ON TRIM(mc."PID") = p."PID"
WHERE p."Name" LIKE '%Rukh%'
LIMIT 20;
