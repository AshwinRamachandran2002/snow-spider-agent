Query:
--Description:
-- 3. Show titles of movies that feature Shah Rukh Khan.
--    Use TRIM on mc."PID" to match the space-prefixed IDs in M_Cast,
--    and a single LIKE '%Rukh%' to identify the actor.
SELECT DISTINCT m."MID",
       m."title"
FROM   "Movie"  AS m
JOIN   "M_Cast" AS mc  ON mc."MID" = m."MID"
JOIN   "Person" AS p   ON TRIM(mc."PID") = p."PID"
WHERE  p."Name" LIKE '%Rukh%'
LIMIT 20
