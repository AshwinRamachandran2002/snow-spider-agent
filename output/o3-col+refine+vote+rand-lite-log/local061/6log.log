```sql
-- 4) Description: For French customers, look at one month of 2019 sales that satisfy both the “good” channels and promotions
SELECT DISTINCT s.prod_id, s.cust_id, s.time_id, s.channel_id, s.promo_id, s.amount_sold
FROM sales            AS s
JOIN customers        AS c  ON c.cust_id = s.cust_id
JOIN countries        AS co ON co.country_id = c.country_id
WHERE co.country_name = 'France'
  AND s.channel_id IN (SELECT channel_id FROM channels WHERE channel_total_id = 1)
  AND s.promo_id   IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
  AND s.time_id BETWEEN '2019-01-01' AND '2019-01-31'
LIMIT 20;
```

```sql
-- 5) Description: Same sample for 2020 to check that there is data for the next year
SELECT DISTINCT s.prod_id, s.cust_id, s.time_id, s.amount_sold
FROM sales            AS s
JOIN customers        AS c  ON c.cust_id = s.cust_id
JOIN countries        AS co ON co.country_id = c.country_id
WHERE co.country_name = 'France'
  AND s.channel_id IN (SELECT channel_id FROM channels WHERE channel_total_id = 1)
  AND s.promo_id   IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
  AND s.time_id BETWEEN '2020-01-01' AND '2020-01-31'
LIMIT 20;
```

```sql
