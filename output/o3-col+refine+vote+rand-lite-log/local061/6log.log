```

```sql
-- 8) Description: Aggregate 2019 French sales (valid channels & promos) per product per month
SELECT strftime('%Y-%m', s.time_id)  AS year_month,
       s.prod_id,
       SUM(s.amount_sold)            AS amt_2019
FROM   sales            AS s
JOIN   customers        AS c  ON c.cust_id = s.cust_id
JOIN   countries        AS co ON co.country_id = c.country_id
WHERE  co.country_name = 'France'
  AND  s.channel_id IN (SELECT channel_id FROM channels WHERE channel_total_id = 1)
  AND  s.promo_id   IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
  AND  strftime('%Y', s.time_id) = '2019'
GROUP  BY year_month, s.prod_id
LIMIT 20;
```

```sql
-- 9) Description: Aggregate 2020 French sales per product per month (same filters) to later derive growth
SELECT strftime('%Y-%m', s.time_id)  AS year_month,
       s.prod_id,
       SUM(s.amount_sold)            AS amt_2020
FROM   sales            AS s
JOIN   customers        AS c  ON c.cust_id = s.cust_id
JOIN   countries        AS co ON co.country_id = c.country_id
WHERE  co.country_name = 'France'
  AND  s.channel_id IN (SELECT channel_id FROM channels WHERE channel_total_id = 1)
  AND  s.promo_id   IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
  AND  strftime('%Y', s.time_id) = '2020'
GROUP  BY year_month, s.prod_id
LIMIT 20;
```

```sql
-- 10) Description: Join the 2019 & 2020 aggregates together so we can inspect growth rates before projecting 2021 sales
WITH y19 AS (
     SELECT strftime('%m', s.time_id) AS mon,
            s.prod_id,
            SUM(s.amount_sold)       AS amt_2019
     FROM   sales s
     JOIN   customers c  ON c.cust_id = s.cust_id
     JOIN   countries co ON co.country_id = c.country_id
     WHERE  co.country_name = 'France'
       AND  s.channel_id IN (SELECT channel_id FROM channels WHERE channel_total_id = 1)
       AND  s.promo_id   IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
       AND  strftime('%Y', s.time_id) = '2019'
     GROUP  BY mon, s.prod_id
), y20 AS (
     SELECT strftime('%m', s.time_id) AS mon,
            s.prod_id,
            SUM(s.amount_sold)       AS amt_2020
     FROM   sales s
     JOIN   customers c  ON c.cust_id = s.cust_id
     JOIN   countries co ON co.country_id = c.country_id
     WHERE  co.country_name = 'France'
       AND  s.channel_id IN (SELECT channel_id FROM channels WHERE channel_total_id = 1)
       AND  s.promo_id   IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
       AND  strftime('%Y', s.time_id) = '2020'
     GROUP  BY mon, s.prod_id
)
SELECT DISTINCT y19.mon,
       y19.prod_id,
       y19.amt_2019,
       y20.amt_2020,
       ROUND((y20.amt_2020 - y19.amt_2019) / NULLIF(y19.amt_2019,0), 4) AS growth_rate
FROM y19
JOIN y20 USING (mon, prod_id)
LIMIT 20;
```
