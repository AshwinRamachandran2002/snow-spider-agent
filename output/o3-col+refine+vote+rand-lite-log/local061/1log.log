       JOIN "channels"   AS ch ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
       WHERE c."country_id" = (SELECT "country_id" FROM "countries" WHERE "country_name" = 'France')
         AND strftime('%Y', s."time_id") = '2020'
       GROUP BY "month", s."prod_id"
)
SELECT s20."month",
       s20."prod_id",
       s20."sales20",
       s19."sales19",
       CASE
            WHEN s19."sales19" > 0
            THEN ( (s20."sales20" - s19."sales19") * 1.0 / s19."sales19" )
            ELSE 0
       END                         AS "growth_rate",
       /* Projected 2021 (apply growth to 2020 figure) */
       s20."sales20" * (1 + CASE
                                WHEN s19."sales19" > 0
                                THEN ( (s20."sales20" - s19."sales19") * 1.0 / s19."sales19" )
                                ELSE 0
                           END)   AS "proj_sales_2021"
FROM sales20 s20
LEFT JOIN sales19 s19
       ON s19."month"   = s20."month"
      AND s19."prod_id" = s20."prod_id"
LIMIT 20;
