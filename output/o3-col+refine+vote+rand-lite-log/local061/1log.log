```sql
-- 5) Sample sales rows for French customers, limited to qualifying promos/channels
SELECT DISTINCT s."prod_id",
       s."cust_id",
       s."time_id",
       s."quantity_sold",
       s."amount_sold"
FROM "sales"       AS s
JOIN "customers"   AS c ON c."cust_id" = s."cust_id"
JOIN "promotions"  AS p ON p."promo_id" = s."promo_id"    AND p."promo_total_id" = 1
JOIN "channels"    AS ch ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
WHERE c."country_id" = (SELECT "country_id" FROM "countries" WHERE "country_name" = 'France')
  AND strftime('%Y', s."time_id") IN ('2019','2020')
LIMIT 20;
```

```sql
-- 6) Monthly product sales for 2019 (France, good promos/channels)
SELECT strftime('%m', s."time_id") AS "month",
       s."prod_id",
       SUM(s."amount_sold") AS "sales_2019"
FROM "sales"  AS s
JOIN "customers"  AS c  ON c."cust_id" = s."cust_id"
JOIN "promotions" AS p  ON p."promo_id" = s."promo_id"  AND p."promo_total_id" = 1
JOIN "channels"   AS ch ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
WHERE c."country_id" = (SELECT "country_id" FROM "countries" WHERE "country_name" = 'France')
  AND strftime('%Y', s."time_id") = '2019'
GROUP BY "month", s."prod_id"
LIMIT 20;
```

```sql
-- 7) Monthly product sales for 2020 (same filters)
SELECT strftime('%m', s."time_id") AS "month",
       s."prod_id",
       SUM(s."amount_sold") AS "sales_2020"
FROM "sales"  AS s
JOIN "customers"  AS c  ON c."cust_id" = s."cust_id"
JOIN "promotions" AS p  ON p."promo_id" = s."promo_id"  AND p."promo_total_id" = 1
JOIN "channels"   AS ch ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
WHERE c."country_id" = (SELECT "country_id" FROM "countries" WHERE "country_name" = 'France')
  AND strftime('%Y', s."time_id") = '2020'
GROUP BY "month", s."prod_id"
LIMIT 20;
```

```sql
-- 8) Compute growth rate and projected 2021 sales per product & month
WITH sales19 AS (
       SELECT strftime('%m', s."time_id") AS "month",
              s."prod_id",
              SUM(s."amount_sold") AS "sales19"
       FROM "sales" AS s
       JOIN "customers"  AS c  ON c."cust_id" = s."cust_id"
       JOIN "promotions" AS p  ON p."promo_id" = s."promo_id" AND p."promo_total_id" = 1
       JOIN "channels"   AS ch ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
       WHERE c."country_id" = (SELECT "country_id" FROM "countries" WHERE "country_name" = 'France')
         AND strftime('%Y', s."time_id") = '2019'
       GROUP BY "month", s."prod_id"
),
sales20 AS (
       SELECT strftime('%m', s."time_id") AS "month",
              s."prod_id",
              SUM(s."amount_sold") AS "sales20"
       FROM "sales" AS s
       JOIN "customers"  AS c  ON c."cust_id" = s."cust_id"
       JOIN "promotions" AS p  ON p."promo_id" = s."promo_id" AND p."promo_total_id" = 1
       JOIN "channels"   AS ch ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
       WHERE c."country_id" = (SELECT "country_id" FROM "countries" WHERE "country_name" = 'France')
         AND strftime('%Y', s."time_id") = '2020'
       GROUP BY "month", s."prod_id"
)
SELECT s20."month",
       s20."prod_id",
       s20."sales20",
       s19."sales19",
       CASE
            WHEN s19."sales19" > 0
            THEN ( (s20."sales20" - s19."sales19") * 1.0 / s19."sales19" )
            ELSE 0
       END                         AS "growth_rate",
       /* Projected 2021 (apply growth to 2020 figure) */
       s20."sales20" * (1 + CASE
                                WHEN s19."sales19" > 0
                                THEN ( (s20."sales20" - s19."sales19") * 1.0 / s19."sales19" )
                                ELSE 0
                           END)   AS "proj_sales_2021"
FROM sales20 s20
LEFT JOIN sales19 s19
       ON s19."month"   = s20."month"
      AND s19."prod_id" = s20."prod_id"
LIMIT 20;
```

```sql
-- 9) Convert the projected 2021 sales to USD using 2021 FX rates
WITH projections AS (
     /* reuse the CTE logic from query 8 but keep only proj_sales_2021 */
     WITH sales19 AS (
          SELECT strftime('%m', s."time_id") AS "month",
                 s."prod_id",
                 SUM(s."amount_sold") AS "sales19"
          FROM "sales" AS s
          JOIN "customers"  AS c  ON c."cust_id" = s."cust_id"
          JOIN "promotions" AS p  ON p."promo_id" = s."promo_id" AND p."promo_total_id" = 1
          JOIN "channels"   AS ch ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
          WHERE c."country_id" = (SELECT "country_id" FROM "countries" WHERE "country_name" = 'France')
            AND strftime('%Y', s."time_id") = '2019'
          GROUP BY "month", s."prod_id"
     ),
     sales20 AS (
          SELECT strftime('%m', s."time_id") AS "month",
                 s."prod_id",
                 SUM(s."amount_sold") AS "sales20"
          FROM "sales" AS s
          JOIN "customers"  AS c  ON c."cust_id" = s."cust_id"
          JOIN "promotions" AS p  ON p."promo_id" = s."promo_id" AND p."promo_total_id" = 1
          JOIN "channels"   AS ch ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
          WHERE c."country_id" = (SELECT "country_id" FROM "countries" WHERE "country_name" = 'France')
            AND strftime('%Y', s."time_id") = '2020'
          GROUP BY "month", s."prod_id"
     )
     SELECT s20."month",
            s20."prod_id",
            s20."sales20" * (1 + CASE
                                     WHEN s19."sales19" > 0
                                     THEN ( (s20."sales20" - s19."sales19") * 1.0 / s19."sales19" )
                                     ELSE 0
                                END)  AS "proj_sales_2021"
     FROM sales20 s20
     LEFT JOIN sales19 s19
            ON s19."month"   = s20."month"
           AND s19."prod_id" = s20."prod_id"
)
SELECT pr."month",
       pr."prod_id",
       pr."proj_sales_2021",
       cu."to_us",
       pr."proj_sales_2021" / cu."to_us" AS "proj_sales_2021_usd"
FROM projections  AS pr
JOIN "currency"   AS cu
     ON cu."country" = 'France'
    AND cu."year"    = 2021
    AND cu."month"   = CAST(pr."month" AS INTEGER)
LIMIT 20;
```

```sql
-- 10) Final answer – average projected monthly sales in USD for France (2021)
WITH sales19 AS (
       SELECT strftime('%m', s."time_id") AS "month",
              s."prod_id",
              SUM(s."amount_sold") AS "sales19"
       FROM "sales" AS s
       JOIN "customers" AS c  ON c."cust_id" = s."cust_id"
       JOIN "promotions" AS p ON p."promo_id" = s."promo_id" AND p."promo_total_id" = 1
       JOIN "channels"   AS ch ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
       WHERE c."country_id" = (SELECT "country_id" FROM "countries" WHERE "country_name" = 'France')
         AND strftime('%Y', s."time_id") = '2019'
       GROUP BY "month", s."prod_id"
),
sales20 AS (
       SELECT strftime('%m', s."time_id") AS "month",
              s."prod_id",
              SUM(s."amount_sold") AS "sales20"
       FROM "sales" AS s
       JOIN "customers" AS c  ON c."cust_id" = s."cust_id"
       JOIN "promotions" AS p ON p."promo_id" = s."promo_id" AND p."promo_total_id" = 1
       JOIN "channels"   AS ch ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
       WHERE c."country_id" = (SELECT "country_id" FROM "countries" WHERE "country_name" = 'France')
         AND strftime('%Y', s."time_id") = '2020'
       GROUP BY "month", s."prod_id"
),
projections AS (
       SELECT s20."month",
              s20."prod_id",
              s20."sales20" * (1 + CASE
                                       WHEN s19."sales19" > 0
                                       THEN ( (s20."sales20" - s19."sales19") * 1.0 / s19."sales19" )
                                       ELSE 0
                                  END)  AS "proj_sales_2021"
       FROM sales20 s20
       LEFT JOIN sales19 s19
              ON s19."month"   = s20."month"
             AND s19."prod_id" = s20."prod_id"
),
proj_usd AS (
       SELECT pr."month",
              pr."prod_id",
              pr."proj_sales_2021" / cu."to_us" AS "proj_sales_2021_usd"
       FROM projections AS pr
       JOIN "currency"  AS cu
         ON cu."country" = 'France'
        AND cu."year"    = 2021
        AND cu."month"   = CAST(pr."month" AS INTEGER)
)
SELECT pr."month",
       AVG(pr."proj_sales_2021_usd") AS "avg_projected_sales_usd_2021"
FROM proj_usd pr
GROUP BY pr."month"
ORDER BY pr."month"
LIMIT 20;
```
