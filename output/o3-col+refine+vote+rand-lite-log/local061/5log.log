```sql
--Description: Sample France sales rows in 2019 that meet all filter rules (promo_total_id = 1, channel_total_id = 1). 
SELECT s.time_id,
       s.amount_sold
FROM   sales      AS s
JOIN   customers  AS c  ON s.cust_id  = c.cust_id
JOIN   countries  AS co ON c.country_id = co.country_id
JOIN   promotions AS p  ON s.promo_id = p.promo_id
JOIN   channels   AS ch ON s.channel_id = ch.channel_id
WHERE  co.country_name = 'France'
  AND  p.promo_total_id = 1
  AND  ch.channel_total_id = 1
  AND  s.time_id IN (SELECT time_id FROM times WHERE calendar_year = 2019)
LIMIT 20;
```

```sql
--Description: Sample France sales rows in 2020 under the same filter rules (used later for growth rate). 
SELECT s.time_id,
       s.amount_sold
FROM   sales      AS s
JOIN   customers  AS c  ON s.cust_id  = c.cust_id
JOIN   countries  AS co ON c.country_id = co.country_id
JOIN   promotions AS p  ON s.promo_id = p.promo_id
JOIN   channels   AS ch ON s.channel_id = ch.channel_id
WHERE  co.country_name = 'France'
  AND  p.promo_total_id = 1
  AND  ch.channel_total_id = 1
  AND  s.time_id IN (SELECT time_id FROM times WHERE calendar_year = 2020)
LIMIT 20;
```

```sql
--Description: Aggregate 2019 monthly sales for France with all filters; this will be paired with 2020 totals for growth. 
SELECT t.calendar_month_number  AS month,
       SUM(s.amount_sold)       AS total_sales_2019
FROM   sales      AS s
JOIN   customers  AS c  ON s.cust_id  = c.cust_id
JOIN   countries  AS co ON c.country_id = co.country_id
JOIN   promotions AS p  ON s.promo_id = p.promo_id
JOIN   channels   AS ch ON s.channel_id = ch.channel_id
JOIN   times      AS t  ON s.time_id = t.time_id
WHERE  co.country_name = 'France'
  AND  p.promo_total_id = 1
  AND  ch.channel_total_id = 1
  AND  t.calendar_year   = 2019
GROUP BY t.calendar_month_number
ORDER BY month
LIMIT 20;
```

```sql
--Description: Obtain the 2021 FX (to_us) rates for France to convert projected 2021 sales into USD. 
SELECT *
FROM   currency
WHERE  country = 'France'
  AND  year    = 2021
LIMIT 20;
```
