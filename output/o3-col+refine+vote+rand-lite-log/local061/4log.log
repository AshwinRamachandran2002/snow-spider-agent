```sql
-- Description: List a few French customers so we can later link them to sales
SELECT DISTINCT
       c."cust_id",
       c."cust_last_name",
       c."country_id"
FROM   "customers" AS c
WHERE  c."country_id" = (
           SELECT "country_id"
           FROM   "countries"
           WHERE  "country_name" = 'France'
       )
LIMIT 20;
```

```sql
-- Description: Look at the promotions that are part of the grand‐total bucket (promo_total_id = 1)
SELECT DISTINCT
       "promo_id",
       "promo_name",
       "promo_category",
       "promo_total_id"
FROM   "promotions"
WHERE  "promo_total_id" = 1
LIMIT 20;
```

```sql
-- Description: Check which channel_id values belong to the overall channel total bucket (channel_total_id = 1)
SELECT DISTINCT
       "channel_id",
       "channel_desc",
       "channel_class",
       "channel_total_id"
FROM   "channels"
WHERE  "channel_total_id" = 1
LIMIT 20;
```

