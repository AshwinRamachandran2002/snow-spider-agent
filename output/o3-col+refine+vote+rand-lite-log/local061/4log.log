```sql
-- Description: Sample 2019 sales for French customers with qualifying channels and promotions
SELECT DISTINCT
       s."prod_id",
       s."cust_id",
       s."time_id",
       s."channel_id",
       s."promo_id",
       s."amount_sold"
FROM   "sales"      AS s
JOIN   "customers"  AS c ON c."cust_id" = s."cust_id"
WHERE  c."country_id" = (
           SELECT "country_id"
           FROM   "countries"
           WHERE  "country_name" = 'France'
       )
  AND  s."promo_id" IN (SELECT "promo_id" FROM "promotions" WHERE "promo_total_id" = 1)
  AND  s."channel_id" IN (SELECT "channel_id" FROM "channels"   WHERE "channel_total_id" = 1)
  AND  s."time_id" BETWEEN '2019-01-01' AND '2019-12-31'
LIMIT 20;
```

```sql
-- Description: Sample 2020 sales for French customers with the same promotion & channel filters
SELECT DISTINCT
       s."prod_id",
       s."cust_id",
       s."time_id",
       s."channel_id",
       s."promo_id",
       s."amount_sold"
FROM   "sales"      AS s
JOIN   "customers"  AS c ON c."cust_id" = s."cust_id"
WHERE  c."country_id" = (
           SELECT "country_id"
           FROM   "countries"
           WHERE  "country_name" = 'France'
       )
  AND  s."promo_id" IN (SELECT "promo_id" FROM "promotions" WHERE "promo_total_id" = 1)
  AND  s."channel_id" IN (SELECT "channel_id" FROM "channels"   WHERE "channel_total_id" = 1)
  AND  s."time_id" BETWEEN '2020-01-01' AND '2020-12-31'
LIMIT 20;
```

```sql
-- Description: Retrieve 2021 FX rates (to_us) for France so we can convert projected 2021 amounts
