       s.cust_id,
       s.time_id,
       s.channel_id,
       s.promo_id,
       s.amount_sold
FROM sales      AS s
JOIN customers  AS c   ON s.cust_id  = c.cust_id
JOIN countries  AS ct  ON c.country_id = ct.country_id
