```sql
--Description: Sample of France’s 2019 sales that respect the requested promo & channel filters
SELECT s.prod_id,
       s.cust_id,
       s.time_id,
       s.channel_id,
       s.promo_id,
       s.amount_sold
FROM sales      AS s
JOIN customers  AS c   ON s.cust_id  = c.cust_id
JOIN countries  AS ct  ON c.country_id = ct.country_id
JOIN promotions AS p   ON s.promo_id = p.promo_id
JOIN channels   AS ch  ON s.channel_id = ch.channel_id
JOIN times      AS t   ON s.time_id  = t.time_id
WHERE ct.country_name = 'France'
  AND p.promo_total_id = 1
  AND ch.channel_total_id = 1
  AND t.calendar_year = 2019
LIMIT 20;
```

```sql
--Description: Same sample but for the year 2020 (to compare with 2019)
SELECT s.prod_id,
       s.cust_id,
       s.time_id,
       s.channel_id,
       s.promo_id,
       s.amount_sold
FROM sales      AS s
