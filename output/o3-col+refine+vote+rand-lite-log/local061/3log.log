Query:
--Description: Compute growth rate (2019→2020) per product & month for France
SELECT a.prod_id,
       a.month,
       ROUND(
           (b.total_amount_2020 - a.total_amount_2019) * 1.0
           / NULLIF(a.total_amount_2019,0), 3
       ) AS growth_rate
FROM (
      SELECT t.calendar_month_number AS month,
             s.prod_id,
             SUM(s.amount_sold)      AS total_amount_2019
      FROM sales s
      JOIN customers  c  ON s.cust_id = c.cust_id
      JOIN countries  ct ON c.country_id = ct.country_id
      JOIN promotions p  ON s.promo_id = p.promo_id
      JOIN channels   ch ON s.channel_id = ch.channel_id
      JOIN times      t  ON s.time_id  = t.time_id
      WHERE ct.country_name = 'France'
        AND p.promo_total_id = 1
        AND ch.channel_total_id = 1
        AND t.calendar_year = 2019
      GROUP BY t.calendar_month_number, s.prod_id
) a
JOIN (
      SELECT t.calendar_month_number AS month,
             s.prod_id,
             SUM(s.amount_sold)      AS total_amount_2020
      FROM sales s
      JOIN customers  c  ON s.cust_id = c.cust_id
      JOIN countries  ct ON c.country_id = ct.country_id
      JOIN promotions p  ON s.promo_id = p.promo_id
      JOIN channels   ch ON s.channel_id = ch.channel_id
      JOIN times      t  ON s.time_id  = t.time_id
      WHERE ct.country_name = 'France'
        AND p.promo_total_id = 1
        AND ch.channel_total_id = 1
        AND t.calendar_year = 2020
      GROUP BY t.calendar_month_number, s.prod_id
) b
ON a.prod_id = b.prod_id AND a.month = b.month
LIMIT 20;
