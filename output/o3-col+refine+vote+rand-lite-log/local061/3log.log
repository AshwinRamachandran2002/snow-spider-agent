--Description: Project 2021 monthly sales in USD and average them for France (final step)
SELECT proj.month,
       ROUND(AVG(proj.projected_amount_usd), 2) AS avg_projected_monthly_sales_usd
FROM (
      SELECT gr.prod_id,
             gr.month,
             (gr.total_amount_2020 * (1 + gr.growth_rate))           AS projected_2021_local,
             (gr.total_amount_2020 * (1 + gr.growth_rate)) / cur.to_us AS projected_amount_usd
      FROM (
             -- Subquery: compute growth per product & month
             SELECT a.prod_id,
                    a.month,
                    a.total_amount_2019,
                    b.total_amount_2020,
                    CASE WHEN a.total_amount_2019 = 0 THEN 0
                         ELSE (b.total_amount_2020 - a.total_amount_2019)*1.0 / a.total_amount_2019
                    END AS growth_rate
             FROM (
                   SELECT t.calendar_month_number AS month,
                          s.prod_id,
                          SUM(s.amount_sold) AS total_amount_2019
                   FROM sales s
                   JOIN customers  c  ON s.cust_id = c.cust_id
                   JOIN countries  ct ON c.country_id = ct.country_id
                   JOIN promotions p  ON s.promo_id = p.promo_id
                   JOIN channels   ch ON s.channel_id = ch.channel_id
                   JOIN times      t  ON s.time_id  = t.time_id
                   WHERE ct.country_name = 'France'
                     AND p.promo_total_id = 1
                     AND ch.channel_total_id = 1
                     AND t.calendar_year = 2019
                   GROUP BY t.calendar_month_number, s.prod_id
             ) a
             JOIN (
                   SELECT t.calendar_month_number AS month,
                          s.prod_id,
                          SUM(s.amount_sold) AS total_amount_2020
                   FROM sales s
                   JOIN customers  c  ON s.cust_id = c.cust_id
                   JOIN countries  ct ON c.country_id = ct.country_id
                   JOIN promotions p  ON s.promo_id = p.promo_id
                   JOIN channels   ch ON s.channel_id = ch.channel_id
                   JOIN times      t  ON s.time_id  = t.time_id
                   WHERE ct.country_name = 'France'
                     AND p.promo_total_id = 1
                     AND ch.channel_total_id = 1
                     AND t.calendar_year = 2020
                   GROUP BY t.calendar_month_number, s.prod_id
             ) b
             ON a.prod_id = b.prod_id AND a.month = b.month
      ) gr
      JOIN currency cur
        ON cur.country = 'France'
       AND cur.year    = 2021
       AND cur.month   = gr.month
) proj
GROUP BY proj.month
ORDER BY proj.month
LIMIT 20;
