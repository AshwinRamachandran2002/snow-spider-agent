```sql
--Description: Take a quick look at raw 2019–2020 sales rows for French customers, restricted to valid channels & promos
SELECT s.prod_id,
       s.cust_id,
       s.time_id,
       s.channel_id,
       s.promo_id,
       s.amount_sold
FROM   sales       AS s
JOIN   customers   AS c ON c.cust_id = s.cust_id
JOIN   times       AS t ON t.time_id = s.time_id
WHERE  c.country_id = (SELECT country_id FROM countries WHERE country_name = 'France')
  AND  t.calendar_year IN (2019, 2020)
  AND  s.channel_id  IN (SELECT channel_id FROM channels   WHERE channel_total_id = 1)
  AND  s.promo_id    IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
LIMIT 20;
```

```sql
--Description: Aggregate monthly 2019 sales (in local currency) for every product bought in France
SELECT s.prod_id,
       t.calendar_month_number  AS month,
       SUM(s.amount_sold)       AS sales_2019
FROM   sales       AS s
JOIN   customers   AS c ON c.cust_id = s.cust_id
JOIN   times       AS t ON t.time_id = s.time_id
WHERE  c.country_id = (SELECT country_id FROM countries WHERE country_name = 'France')
  AND  t.calendar_year = 2019
  AND  s.channel_id  IN (SELECT channel_id FROM channels   WHERE channel_total_id = 1)
  AND  s.promo_id    IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
GROUP BY s.prod_id, t.calendar_month_number
LIMIT 20;
```

```sql
--Description: Aggregate monthly 2020 sales (in local currency) for every product bought in France
SELECT s.prod_id,
       t.calendar_month_number  AS month,
       SUM(s.amount_sold)       AS sales_2020
FROM   sales       AS s
JOIN   customers   AS c ON c.cust_id = s.cust_id
JOIN   times       AS t ON t.time_id = s.time_id
WHERE  c.country_id = (SELECT country_id FROM countries WHERE country_name = 'France')
  AND  t.calendar_year = 2020
  AND  s.channel_id  IN (SELECT channel_id FROM channels   WHERE channel_total_id = 1)
  AND  s.promo_id    IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
GROUP BY s.prod_id, t.calendar_month_number
LIMIT 20;
```

```sql
--Description: Combine 2019 & 2020 aggregates to compute month-by-month growth rates per product
WITH sales_19 AS (
    SELECT s.prod_id,
           t.calendar_month_number AS month,
           SUM(s.amount_sold)      AS sales_2019
    FROM   sales s
    JOIN   customers c ON c.cust_id = s.cust_id
    JOIN   times t      ON t.time_id = s.time_id
    WHERE  c.country_id = (SELECT country_id FROM countries WHERE country_name = 'France')
      AND  t.calendar_year = 2019
      AND  s.channel_id IN (SELECT channel_id FROM channels WHERE channel_total_id = 1)
      AND  s.promo_id   IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
    GROUP BY s.prod_id, t.calendar_month_number
),
sales_20 AS (
    SELECT s.prod_id,
           t.calendar_month_number AS month,
           SUM(s.amount_sold)      AS sales_2020
    FROM   sales s
    JOIN   customers c ON c.cust_id = s.cust_id
    JOIN   times t      ON t.time_id = s.time_id
    WHERE  c.country_id = (SELECT country_id FROM countries WHERE country_name = 'France')
      AND  t.calendar_year = 2020
      AND  s.channel_id IN (SELECT channel_id FROM channels WHERE channel_total_id = 1)
      AND  s.promo_id   IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
    GROUP BY s.prod_id, t.calendar_month_number
)
SELECT a.prod_id,
       a.month,
       a.sales_2019,
       b.sales_2020,
       CASE WHEN a.sales_2019 > 0
            THEN (b.sales_2020 - a.sales_2019) * 1.0 / a.sales_2019
       END                                   AS growth_rate
FROM   sales_19 AS a
JOIN   sales_20 AS b
       ON a.prod_id = b.prod_id
      AND a.month   = b.month
LIMIT 20;
```

```sql
--Description: Project 2021 sales per product & month using the growth rate, then convert to USD
WITH sales_19 AS (
    SELECT s.prod_id,
           t.calendar_month_number AS month,
           SUM(s.amount_sold)      AS sales_2019
    FROM   sales s
    JOIN   customers c ON c.cust_id = s.cust_id
    JOIN   times t      ON t.time_id = s.time_id
    WHERE  c.country_id = (SELECT country_id FROM countries WHERE country_name = 'France')
      AND  t.calendar_year = 2019
      AND  s.channel_id IN (SELECT channel_id FROM channels WHERE channel_total_id = 1)
      AND  s.promo_id   IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
    GROUP BY s.prod_id, t.calendar_month_number
),
sales_20 AS (
    SELECT s.prod_id,
           t.calendar_month_number AS month,
           SUM(s.amount_sold)      AS sales_2020
    FROM   sales s
    JOIN   customers c ON c.cust_id = s.cust_id
    JOIN   times t      ON t.time_id = s.time_id
    WHERE  c.country_id = (SELECT country_id FROM countries WHERE country_name = 'France')
      AND  t.calendar_year = 2020
      AND  s.channel_id IN (SELECT channel_id FROM channels WHERE channel_total_id = 1)
      AND  s.promo_id   IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
    GROUP BY s.prod_id, t.calendar_month_number
),
growth AS (
    SELECT a.prod_id,
           a.month,
           a.sales_2019,
           b.sales_2020,
           CASE WHEN a.sales_2019 > 0
                THEN (b.sales_2020 - a.sales_2019) * 1.0 / a.sales_2019
           END AS growth_rate
    FROM   sales_19 a
    JOIN   sales_20 b
           ON a.prod_id = b.prod_id
          AND a.month   = b.month
),
proj_2021 AS (
    SELECT g.prod_id,
           g.month,
           (g.sales_2020 * (1 + COALESCE(g.growth_rate,0))) AS projected_local
    FROM   growth g
)
SELECT p.month,
       p.prod_id,
       p.projected_local,
       (p.projected_local * cu.to_us) AS projected_usd
FROM   proj_2021 p
JOIN   currency cu
       ON cu.country = 'France'
      AND cu.year    = 2021
      AND cu.month   = p.month
LIMIT 20;
```

```sql
--Description: Final answer – average projected 2021 monthly sales (USD) for France
WITH sales_19 AS (
    SELECT s.prod_id,
           t.calendar_month_number AS month,
           SUM(s.amount_sold)      AS sales_2019
    FROM   sales s
    JOIN   customers c ON c.cust_id = s.cust_id
    JOIN   times t      ON t.time_id = s.time_id
    WHERE  c.country_id = (SELECT country_id FROM countries WHERE country_name = 'France')
      AND  t.calendar_year = 2019
      AND  s.channel_id IN (SELECT channel_id FROM channels WHERE channel_total_id = 1)
      AND  s.promo_id   IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
    GROUP BY s.prod_id, t.calendar_month_number
),
sales_20 AS (
    SELECT s.prod_id,
           t.calendar_month_number AS month,
           SUM(s.amount_sold)      AS sales_2020
    FROM   sales s
    JOIN   customers c ON c.cust_id = s.cust_id
    JOIN   times t      ON t.time_id = s.time_id
    WHERE  c.country_id = (SELECT country_id FROM countries WHERE country_name = 'France')
      AND  t.calendar_year = 2020
      AND  s.channel_id IN (SELECT channel_id FROM channels WHERE channel_total_id = 1)
      AND  s.promo_id   IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
    GROUP BY s.prod_id, t.calendar_month_number
),
growth AS (
    SELECT a.prod_id,
           a.month,
           a.sales_2019,
           b.sales_2020,
           CASE WHEN a.sales_2019 > 0
                THEN (b.sales_2020 - a.sales_2019) * 1.0 / a.sales_2019
           END AS growth_rate
    FROM   sales_19 a
    JOIN   sales_20 b
           ON a.prod_id = b.prod_id
          AND a.month   = b.month
),
proj_2021 AS (
    SELECT g.prod_id,
           g.month,
           (g.sales_2020 * (1 + COALESCE(g.growth_rate,0))) AS projected_local
    FROM   growth g
),
proj_2021_usd AS (
    SELECT p.month,
           (p.projected_local * cu.to_us) AS projected_usd
    FROM   proj_2021 p
    JOIN   currency cu
           ON cu.country = 'France'
          AND cu.year    = 2021
          AND cu.month   = p.month
)
SELECT month,
       AVG(projected_usd) AS avg_projected_monthly_sales_usd
FROM   proj_2021_usd
GROUP  BY month
ORDER  BY month
LIMIT 20;
```
