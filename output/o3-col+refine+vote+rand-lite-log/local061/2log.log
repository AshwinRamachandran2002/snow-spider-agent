Query:
--Description: Combine 2019 & 2020 aggregates to compute month-by-month growth rates per product
WITH sales_19 AS (
    SELECT s.prod_id,
           t.calendar_month_number AS month,
           SUM(s.amount_sold)      AS sales_2019
    FROM   sales s
    JOIN   customers c ON c.cust_id = s.cust_id
    JOIN   times t      ON t.time_id = s.time_id
    WHERE  c.country_id = (SELECT country_id FROM countries WHERE country_name = 'France')
      AND  t.calendar_year = 2019
      AND  s.channel_id IN (SELECT channel_id FROM channels WHERE channel_total_id = 1)
      AND  s.promo_id   IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
    GROUP BY s.prod_id, t.calendar_month_number
),
sales_20 AS (
    SELECT s.prod_id,
           t.calendar_month_number AS month,
           SUM(s.amount_sold)      AS sales_2020
    FROM   sales s
    JOIN   customers c ON c.cust_id = s.cust_id
    JOIN   times t      ON t.time_id = s.time_id
    WHERE  c.country_id = (SELECT country_id FROM countries WHERE country_name = 'France')
      AND  t.calendar_year = 2020
      AND  s.channel_id IN (SELECT channel_id FROM channels WHERE channel_total_id = 1)
      AND  s.promo_id   IN (SELECT promo_id   FROM promotions WHERE promo_total_id = 1)
    GROUP BY s.prod_id, t.calendar_month_number
)
SELECT a.prod_id,
       a.month,
       a.sales_2019,
       b.sales_2020,
       CASE WHEN a.sales_2019 > 0
            THEN (b.sales_2020 - a.sales_2019) * 1.0 / a.sales_2019
       END                                   AS growth_rate
FROM   sales_19 AS a
JOIN   sales_20 AS b
       ON a.prod_id = b.prod_id
      AND a.month   = b.month
LIMIT 20;
