```sql
--Description: Sample raw 2019 sales rows for French customers, limited to qualifying promos & channels  
SELECT DISTINCT s.prod_id, s.cust_id, s.time_id, s.channel_id, s.promo_id, s.amount_sold
FROM   sales      AS s
JOIN   customers  AS c  ON c.cust_id = s.cust_id
JOIN   promotions AS p  ON p.promo_id = s.promo_id  AND p.promo_total_id = 1
JOIN   channels   AS ch ON ch.channel_id = s.channel_id AND ch.channel_total_id = 1
WHERE  c.country_id = (SELECT country_id FROM countries WHERE country_name = 'France')
  AND  strftime('%Y', s.time_id) = '2019'
LIMIT 20;
```

```sql
--Description: Aggregate monthly 2019 sales amounts (EUR) per product for France  
SELECT DISTINCT s.prod_id,
       strftime('%m', s.time_id) AS month,
       SUM(s.amount_sold)       AS amt_2019
FROM   sales      AS s
JOIN   customers  AS c  ON c.cust_id = s.cust_id
JOIN   promotions AS p  ON p.promo_id = s.promo_id  AND p.promo_total_id = 1
JOIN   channels   AS ch ON ch.channel_id = s.channel_id AND ch.channel_total_id = 1
WHERE  c.country_id = (SELECT country_id FROM countries WHERE country_name = 'France')
  AND  strftime('%Y', s.time_id) = '2019'
GROUP  BY s.prod_id, month
LIMIT 20;
```

```sql
--Description: Aggregate monthly 2020 sales amounts (EUR) per product for France  
SELECT DISTINCT s.prod_id,
       strftime('%m', s.time_id) AS month,
       SUM(s.amount_sold)       AS amt_2020
FROM   sales      AS s
JOIN   customers  AS c  ON c.cust_id = s.cust_id
JOIN   promotions AS p  ON p.promo_id = s.promo_id  AND p.promo_total_id = 1
JOIN   channels   AS ch ON ch.channel_id = s.channel_id AND ch.channel_total_id = 1
WHERE  c.country_id = (SELECT country_id FROM countries WHERE country_name = 'France')
  AND  strftime('%Y', s.time_id) = '2020'
GROUP  BY s.prod_id, month
LIMIT 20;
```

```sql
--Description: Project 2021 monthly sales for France, convert to USD, then take the average per month  
WITH france          AS (SELECT country_id FROM countries WHERE country_name = 'France'),
     base_sales      AS (
         SELECT s.prod_id,
                strftime('%Y', s.time_id) AS yr,
                strftime('%m', s.time_id) AS mon,
                SUM(s.amount_sold)        AS amt
         FROM   sales      AS s
         JOIN   customers  AS c  ON c.cust_id = s.cust_id
         JOIN   promotions AS p  ON p.promo_id = s.promo_id  AND p.promo_total_id = 1
         JOIN   channels   AS ch ON ch.channel_id = s.channel_id AND ch.channel_total_id = 1
         WHERE  c.country_id = (SELECT country_id FROM france)
           AND  strftime('%Y', s.time_id) IN ('2019','2020')
         GROUP  BY s.prod_id, yr, mon
     ),
     pivot           AS (
         SELECT prod_id,
                mon,
                SUM(CASE WHEN yr='2019' THEN amt END) AS amt2019,
                SUM(CASE WHEN yr='2020' THEN amt END) AS amt2020
         FROM   base_sales
         GROUP BY prod_id, mon
     ),
     projection      AS (
         SELECT prod_id,
                mon,
                COALESCE(
                    CASE 
                      WHEN amt2019 > 0 
                      THEN (amt2020 - amt2019) / amt2019 
                      ELSE 0 
                    END, 0)                        AS growth_rate,
                amt2020 * (1 + 
                    COALESCE(
                        CASE 
                          WHEN amt2019 > 0 
                          THEN (amt2020 - amt2019) / amt2019 
                          ELSE 0 
                        END, 0)
                )                                   AS proj_2021_eur
         FROM   pivot
     ),
     fx_2021         AS (
         SELECT month AS mon, to_us
         FROM   currency
         WHERE  country = 'France'
           AND  year    = 2021
     ),
     converted_2021  AS (
         SELECT p.prod_id,
                p.mon,
                p.proj_2021_eur,
                p.proj_2021_eur * f.to_us AS proj_2021_usd
         FROM   projection AS p
         JOIN   fx_2021    AS f USING (mon)
     )
SELECT mon                               AS month_2021,
       AVG(proj_2021_usd)                AS avg_projected_sales_usd
FROM   converted_2021
GROUP  BY mon
ORDER  BY mon;
```
