```sql
--Description: 1) Check what calendar years are present in the data set
SELECT DISTINCT ci.db_year
FROM case_ids AS ci
ORDER BY ci.db_year
LIMIT 20;
```

```sql
--Description: 2) Look at a few 2021 collision records and their primary‐collision–factor (PCF) violation category
SELECT c.case_id,
       ci.db_year,
       c.pcf_violation_category
FROM collisions AS c
JOIN case_ids AS ci
  ON ci.case_id = c.case_id
WHERE ci.db_year = 2021
LIMIT 20;
```

```sql
--Description: 3) Count 2021 collisions by PCF violation category to see which one is the most common
SELECT c.pcf_violation_category,
       COUNT(*) AS collisions_2021
FROM collisions AS c
JOIN case_ids  AS ci
  ON ci.case_id = c.case_id
WHERE ci.db_year = 2021
GROUP BY c.pcf_violation_category
ORDER BY collisions_2021 DESC
LIMIT 20;
```

```sql
--Description: 4) Identify the single most frequent PCF violation category in 2021
SELECT c.pcf_violation_category,
       COUNT(*) AS collisions_2021
FROM collisions AS c
JOIN case_ids AS ci
  ON ci.case_id = c.case_id
WHERE ci.db_year = 2021
GROUP BY c.pcf_violation_category
ORDER BY collisions_2021 DESC
LIMIT 1;
```

```sql
--Description: 5) Total number of collisions that happened in 2021 (needed to compute the share)
SELECT COUNT(*) AS total_collisions_2021
FROM collisions AS c
JOIN case_ids AS ci
  ON ci.case_id = c.case_id
WHERE ci.db_year = 2021
LIMIT 20;
```

```sql
--Description: 6) Collisions in 2021 for the most-frequent PCF category (substitute X with the category found in Query 4)
SELECT COUNT(*) AS top_category_collisions_2021
FROM collisions AS c
JOIN case_ids AS ci
  ON ci.case_id = c.case_id
WHERE ci.db_year = 2021
  AND c.pcf_violation_category = 'X'
LIMIT 20;
```

```sql
--Description: 7) Collisions in 2011 for that same PCF category
SELECT COUNT(*) AS top_category_collisions_2011
FROM collisions AS c
JOIN case_ids AS ci
  ON ci.case_id = c.case_id
WHERE ci.db_year = 2011
  AND c.pcf_violation_category = 'X'
LIMIT 20;
```

```sql
--Description: 8) Total number of collisions that happened in 2011
SELECT COUNT(*) AS total_collisions_2011
FROM collisions AS c
JOIN case_ids AS ci
  ON ci.case_id = c.case_id
WHERE ci.db_year = 2011
LIMIT 20;
```

```sql
--Description: 9) Compute the 2011 and 2021 percentage shares for that top-2021 PCF category
SELECT
  100.0 * SUM(CASE WHEN ci.db_year = 2021 AND c.pcf_violation_category = 'X' THEN 1 END) /
          SUM(CASE WHEN ci.db_year = 2021 THEN 1 END) AS share_2021_pct,
  100.0 * SUM(CASE WHEN ci.db_year = 2011 AND c.pcf_violation_category = 'X' THEN 1 END) /
          SUM(CASE WHEN ci.db_year = 2011 THEN 1 END) AS share_2011_pct
FROM collisions AS c
JOIN case_ids AS ci
  ON ci.case_id = c.case_id
WHERE ci.db_year IN (2011, 2021)
LIMIT 20;
```

```sql
--Description: 10) Final calculation: decrease in percentage points from 2011 to 2021
SELECT 
  (share_2011_pct - share_2021_pct) AS decrease_in_percentage_points
FROM (
  SELECT
    100.0 * SUM(CASE WHEN ci.db_year = 2021 AND c.pcf_violation_category = 'X' THEN 1 END) /
            SUM(CASE WHEN ci.db_year = 2021 THEN 1 END) AS share_2021_pct,
    100.0 * SUM(CASE WHEN ci.db_year = 2011 AND c.pcf_violation_category = 'X' THEN 1 END) /
            SUM(CASE WHEN ci.db_year = 2011 THEN 1 END) AS share_2011_pct
  FROM collisions AS c
  JOIN case_ids AS ci
    ON ci.case_id = c.case_id
  WHERE ci.db_year IN (2011, 2021)
) AS t
LIMIT 20;
```

