```sql
-- 7) Description: Share (%) of each PCF category in 2021 out of all 2021 crashes (top-20 shown).  
SELECT c."pcf_violation_category",
       100.0 * COUNT(*) / t1."total" AS "share_2021_pct"
FROM   "collisions" AS c
JOIN   "case_ids"   AS ci USING ("case_id"),
       (SELECT COUNT(*) AS "total"
        FROM   "collisions" AS c2
        JOIN   "case_ids"  AS ci2 USING ("case_id")
        WHERE  ci2."db_year" = 2021) AS t1
WHERE  ci."db_year" = 2021
GROUP  BY c."pcf_violation_category"
ORDER  BY "share_2021_pct" DESC
LIMIT 20;
```

```sql
-- 8) Description: Share (%) of each PCF category in 2011 out of all 2011 crashes (top-20 shown).  
SELECT c."pcf_violation_category",
       100.0 * COUNT(*) / t1."total" AS "share_2011_pct"
FROM   "collisions" AS c
JOIN   "case_ids"   AS ci USING ("case_id"),
       (SELECT COUNT(*) AS "total"
        FROM   "collisions" AS c2
        JOIN   "case_ids"  AS ci2 USING ("case_id")
        WHERE  ci2."db_year" = 2011) AS t1
WHERE  ci."db_year" = 2011
GROUP  BY c."pcf_violation_category"
ORDER  BY "share_2011_pct" DESC
LIMIT 20;
```

```sql
-- 9) Description: For the 2021 most-common PCF category, calculate its share in 2021 vs 2011  
--    and the resulting decrease (positive figure = percentage-point drop).  
WITH top_2021 AS (  /* most common 2021 PCF category */
    SELECT c."pcf_violation_category"
    FROM   "collisions" AS c
    JOIN   "case_ids"   AS ci USING ("case_id")
    WHERE  ci."db_year" = 2021
    GROUP  BY c."pcf_violation_category"
    ORDER  BY COUNT(*) DESC
    LIMIT 1
),
totals AS (         /* total crash counts per year */
    SELECT 2021 AS yr, COUNT(*) AS tot
    FROM   "collisions" AS c
    JOIN   "case_ids"   AS ci USING ("case_id")
    WHERE  ci."db_year" = 2021
    UNION ALL
    SELECT 2011, COUNT(*)
    FROM   "collisions" AS c
    JOIN   "case_ids"   AS ci USING ("case_id")
    WHERE  ci."db_year" = 2011
)
SELECT  pcf."pcf_violation_category",
        100.0 * SUM(CASE WHEN ci."db_year" = 2021 THEN 1 END) /
        (SELECT tot FROM totals WHERE yr = 2021)     AS "share_2021_pct",
        100.0 * SUM(CASE WHEN ci."db_year" = 2011 THEN 1 END) /
        (SELECT tot FROM totals WHERE yr = 2011)     AS "share_2011_pct",
        (100.0 * SUM(CASE WHEN ci."db_year" = 2011 THEN 1 END) /
         (SELECT tot FROM totals WHERE yr = 2011))
      - (100.0 * SUM(CASE WHEN ci."db_year" = 2021 THEN 1 END) /
         (SELECT tot FROM totals WHERE yr = 2021))   AS "percentage_point_decrease"
FROM    "collisions" AS c
JOIN    "case_ids"   AS ci USING ("case_id")
JOIN    top_2021     AS pcf
  ON    c."pcf_violation_category" = pcf."pcf_violation_category"
WHERE   ci."db_year" IN (2011, 2021)
GROUP   BY pcf."pcf_violation_category"
LIMIT   20;
```
