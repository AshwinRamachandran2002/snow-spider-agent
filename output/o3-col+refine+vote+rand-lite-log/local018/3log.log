Query:
--Description: 
-- Corrected version of “SQL #9”, eliminating the missing‐year issue by deriving
-- crash year directly from the “collision_date” column instead of joining to
-- “case_ids”.  Workflow:
--   1) Tag each collision with calendar year (substring of collision_date);
--      retain only 2011 & 2021 records.
--   2) Inside the 2021 subset, find the most frequent PCF-violation category
--      (target_cat).
--   3) For both years, count total crashes and crashes that match target_cat.
--   4) Convert counts to percentage shares and show the percentage-point
--      decrease from 2011 to 2021.

WITH year_tagged AS (                -- Step-1: add year, keep 2011 & 2021 only
    SELECT
        CAST(substr("collision_date",1,4) AS INT) AS yr,
        "pcf_violation_category"
    FROM "collisions"
    WHERE substr("collision_date",1,4) IN ('2011','2021')
),
top_2021 AS (                        -- Step-2: most common 2021 PCF category
    SELECT "pcf_violation_category" AS target_cat
    FROM   year_tagged
    WHERE  yr = 2021
    GROUP  BY "pcf_violation_category"
    ORDER  BY COUNT(*) DESC
    LIMIT 1
),
counts AS (                          -- Step-3: totals and target_cat counts
    SELECT
        yt.yr,
        COUNT(*)                                                    AS total_crashes,
        SUM(CASE WHEN yt."pcf_violation_category" = t.target_cat
                 THEN 1 ELSE 0 END)                                AS target_crashes
    FROM year_tagged AS yt
    CROSS JOIN top_2021  AS t
    GROUP BY yt.yr
)
SELECT
    (SELECT target_cat FROM top_2021)                                       AS violation_category,
    100.0 * MAX(CASE WHEN yr = 2021 THEN target_crashes END) /
           MAX(CASE WHEN yr = 2021 THEN total_crashes  END)                 AS share_2021_pct,
    100.0 * MAX(CASE WHEN yr = 2011 THEN target_crashes END) /
           MAX(CASE WHEN yr = 2011 THEN total_crashes  END)                 AS share_2011_pct,
    100.0 * MAX(CASE WHEN yr = 2011 THEN target_crashes END) /
           MAX(CASE WHEN yr = 2011 THEN total_crashes  END)
  - 100.0 * MAX(CASE WHEN yr = 2021 THEN target_crashes END) /
           MAX(CASE WHEN yr = 2021 THEN total_crashes  END)                 AS percentage_point_decrease
FROM counts
Answer:
violation_category,share_2021_pct,share_2011_pct,percentage_point_decrease
