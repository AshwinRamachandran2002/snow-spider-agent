--Description (thinking process included as comments):
-- We need the percentage-point change for the PCF-violation category that was
-- most common in 2021.  Steps:
-- 1.  From the “collisions” table, tag each row with its calendar year by
--     taking the first four characters of “collision_date”.  Keep only 2011
--     and 2021 records (these are the comparison years we care about).
-- 2.  Within the 2021 subset, determine which PCF-violation category appears
--     most frequently; call this “target_cat”.
-- 3.  For each of the two years, count:
--        • total crashes
--        • crashes whose category equals target_cat
-- 4.  Convert those counts into percentage shares (target_cat crashes ÷ total
--     crashes) for 2011 and 2021.
-- 5.  Return the two shares plus the percentage-point decrease
--     (share_2011 − share_2021).

WITH year_tagged AS (                       -- Step-1: add year, filter to 2011 & 2021
    SELECT
        CAST(substr("collision_date", 1, 4) AS INT)  AS yr,
        "pcf_violation_category"
    FROM "collisions"
    WHERE substr("collision_date", 1, 4) IN ('2011', '2021')
),
top_2021 AS (                               -- Step-2: find most common 2021 category
    SELECT "pcf_violation_category" AS target_cat
    FROM   year_tagged
    WHERE  yr = 2021
    GROUP  BY "pcf_violation_category"
    ORDER  BY COUNT(*) DESC
    LIMIT 1
),
counts AS (                                 -- Step-3: totals & target_cat counts
    SELECT
        yt.yr,
        COUNT(*)                                                  AS total_crashes,
        SUM(CASE WHEN yt."pcf_violation_category" = t.target_cat
                 THEN 1 ELSE 0 END)                              AS target_crashes
    FROM year_tagged AS yt
    CROSS JOIN top_2021  AS t       -- join once to reference target_cat
    GROUP BY yt.yr
)
SELECT
    (SELECT target_cat FROM top_2021)                                      AS violation_category,
    100.0 * MAX(CASE WHEN yr = 2021 THEN target_crashes END) /
           MAX(CASE WHEN yr = 2021 THEN total_crashes  END)                AS share_2021_pct,
    100.0 * MAX(CASE WHEN yr = 2011 THEN target_crashes END) /
           MAX(CASE WHEN yr = 2011 THEN total_crashes  END)                AS share_2011_pct,
    100.0 * MAX(CASE WHEN yr = 2011 THEN target_crashes END) /
           MAX(CASE WHEN yr = 2011 THEN total_crashes  END)
  - 100.0 * MAX(CASE WHEN yr = 2021 THEN target_crashes END) /
           MAX(CASE WHEN yr = 2021 THEN total_crashes  END)                AS percentage_point_decrease
FROM counts;
