FROM   "collisions"  AS col
JOIN   "case_ids"    AS ci
       ON col."case_id" = ci."case_id"
GROUP  BY ci."db_year"
ORDER  BY ci."db_year"
LIMIT 20;
```

```sql
-- 3. Count 2021 crashes by every violation category to learn which one was most common  
SELECT col."pcf_violation_category",
       COUNT(*) AS "cnt_2021"
FROM   "collisions" AS col
JOIN   "case_ids"   AS ci
       ON col."case_id" = ci."case_id"
WHERE  ci."db_year" = 2021
GROUP  BY col."pcf_violation_category"
ORDER  BY "cnt_2021" DESC
LIMIT 20;
```

```sql
-- 4. Grab the single most-frequent violation category for 2021  
SELECT col."pcf_violation_category"
FROM   "collisions" AS col
JOIN   "case_ids"   AS ci
       ON col."case_id" = ci."case_id"
WHERE  ci."db_year" = 2021
GROUP  BY col."pcf_violation_category"
ORDER  BY COUNT(*) DESC
LIMIT 1;
```

```sql
-- 5. Compute that top-category’s share of all 2021 crashes  
WITH top_cat AS (
    SELECT col."pcf_violation_category" AS cat
    FROM   "collisions" AS col
    JOIN   "case_ids"   AS ci
           ON col."case_id" = ci."case_id"
    WHERE  ci."db_year" = 2021
    GROUP  BY col."pcf_violation_category"
    ORDER  BY COUNT(*) DESC
    LIMIT 1
)
SELECT 100.0 *
       SUM(CASE WHEN col."pcf_violation_category" = (SELECT cat FROM top_cat) THEN 1 ELSE 0 END)
/      COUNT(*)             AS "share_pct_2021"
FROM   "collisions" AS col
JOIN   "case_ids"   AS ci
       ON col."case_id" = ci."case_id"
WHERE  ci."db_year" = 2021
LIMIT 20;
```

```sql
-- 6. Compute that same category’s share of all 2011 crashes  
WITH top_cat AS (
    SELECT col."pcf_violation_category" AS cat
    FROM   "collisions" AS col
    JOIN   "case_ids"   AS ci
           ON col."case_id" = ci."case_id"
    WHERE  ci."db_year" = 2021
    GROUP  BY col."pcf_violation_category"
    ORDER  BY COUNT(*) DESC
    LIMIT 1
)
SELECT 100.0 *
       SUM(CASE WHEN col."pcf_violation_category" = (SELECT cat FROM top_cat) THEN 1 ELSE 0 END)
/      COUNT(*)             AS "share_pct_2011"
FROM   "collisions" AS col
JOIN   "case_ids"   AS ci
       ON col."case_id" = ci."case_id"
WHERE  ci."db_year" = 2011
LIMIT 20;
```

```sql
-- 7. One‐step query: difference in percentage points between 2011 and 2021 shares  
WITH top_cat AS (
    SELECT col."pcf_violation_category" AS cat
    FROM   "collisions" AS col
    JOIN   "case_ids"   AS ci
           ON col."case_id" = ci."case_id"
    WHERE  ci."db_year" = 2021
    GROUP  BY col."pcf_violation_category"
    ORDER  BY COUNT(*) DESC
    LIMIT 1
),
shares AS (
    SELECT ci."db_year"                                                  AS yr,
           100.0 * SUM(CASE WHEN col."pcf_violation_category" = (SELECT cat FROM top_cat)
                            THEN 1 ELSE 0 END) / COUNT(*)               AS pct
    FROM   "collisions" AS col
    JOIN   "case_ids"   AS ci
           ON col."case_id" = ci."case_id"
    WHERE  ci."db_year" IN (2011, 2021)
    GROUP  BY ci."db_year"
)
SELECT MAX(CASE WHEN yr = 2011 THEN pct END)
     - MAX(CASE WHEN yr = 2021 THEN pct END)   AS "percentage_point_decrease"
FROM   shares
LIMIT 20;
```

These seven queries (all capped with `LIMIT 20` for inspection) let you:
1. inspect the possible PCP categories,
2. detect the most common one in 2021,
3. calculate its percentage share in 2021 and 2011, and
4. obtain the number of percentage points by which its share fell over the decade.
