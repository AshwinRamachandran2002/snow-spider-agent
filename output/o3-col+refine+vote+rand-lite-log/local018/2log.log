```sql
-- 9) Compute that top category’s 2021 share and its 2011 share  
WITH year_totals AS (
    SELECT c."db_year",
           COUNT(*) AS "year_total"
    FROM   "collisions" AS p
    JOIN   "case_ids"  AS c
           ON p."case_id" = c."case_id"
    WHERE  c."db_year" IN (2011, 2021)
    GROUP  BY c."db_year"
),
top_cat AS (
    SELECT p."pcf_violation_category" AS "top_cat"
    FROM   "collisions" AS p
    JOIN   "case_ids"  AS c
           ON p."case_id" = c."case_id"
    WHERE  c."db_year" = 2021
    GROUP  BY p."pcf_violation_category"
    ORDER  BY COUNT(*) DESC
    LIMIT 1
),
cat_year_counts AS (
    SELECT c."db_year",
           COUNT(*) AS "cat_count"
    FROM   "collisions" AS p
    JOIN   "case_ids"  AS c
           ON p."case_id" = c."case_id"
    JOIN   top_cat t
           ON p."pcf_violation_category" = t."top_cat"
    WHERE  c."db_year" IN (2011, 2021)
    GROUP  BY c."db_year"
)
SELECT  cy."db_year",
        cy."cat_count",
        y."year_total",
        ROUND( (cy."cat_count" * 100.0) / y."year_total", 2) AS "share_percent"
FROM    cat_year_counts cy
JOIN    year_totals    y
        ON cy."db_year" = y."db_year"
ORDER BY cy."db_year";
```

```sql
-- 10) Final answer: percentage-point decrease from 2011 to 2021  
WITH year_totals AS (
    SELECT c."db_year",
           COUNT(*) AS "year_total"
    FROM   "collisions" AS p
    JOIN   "case_ids"  AS c
           ON p."case_id" = c."case_id"
    WHERE  c."db_year" IN (2011, 2021)
    GROUP  BY c."db_year"
),
top_cat AS (
    SELECT p."pcf_violation_category" AS "top_cat"
    FROM   "collisions" AS p
    JOIN   "case_ids"  AS c
           ON p."case_id" = c."case_id"
    WHERE  c."db_year" = 2021
    GROUP  BY p."pcf_violation_category"
    ORDER  BY COUNT(*) DESC
    LIMIT 1
),
cat_year_counts AS (
    SELECT c."db_year",
           COUNT(*) AS "cat_count"
    FROM   "collisions" AS p
    JOIN   "case_ids"  AS c
           ON p."case_id" = c."case_id"
    JOIN   top_cat t
           ON p."pcf_violation_category" = t."top_cat"
    WHERE  c."db_year" IN (2011, 2021)
    GROUP  BY c."db_year"
),
shares AS (
    SELECT cy."db_year",
           (cy."cat_count" * 100.0) / y."year_total" AS "share_pct"
    FROM   cat_year_counts cy
    JOIN   year_totals y
           ON cy."db_year" = y."db_year"
)
SELECT ROUND( (SELECT share_pct FROM shares WHERE db_year = 2011) -
              (SELECT share_pct FROM shares WHERE db_year = 2021)
            , 2) AS "percentage_point_decrease";
```
