Query:
--Description: Compute that top category’s share of collisions in 2021 and in 2011.
WITH year_totals AS (
    SELECT substr("collision_date", 1, 4) AS "yr",
           COUNT(*)                     AS "year_total"
    FROM   "collisions"
    WHERE  substr("collision_date", 1, 4) IN ('2011', '2021')
    GROUP  BY "yr"
),
top_cat AS (
    SELECT  "pcf_violation_category" AS "top_cat"
    FROM    "collisions"
    WHERE   substr("collision_date", 1, 4) = '2021'
    GROUP   BY "pcf_violation_category"
    ORDER   BY COUNT(*) DESC
    LIMIT 1
),
cat_year_counts AS (
    SELECT substr("collision_date", 1, 4) AS "yr",
           COUNT(*)                      AS "cat_count"
    FROM   "collisions", top_cat
    WHERE  substr("collision_date", 1, 4) IN ('2011', '2021')
      AND  "pcf_violation_category" = top_cat."top_cat"
    GROUP  BY "yr"
)
SELECT  cy."yr"               AS "year",
        cy."cat_count",
        yt."year_total",
        ROUND(cy."cat_count" * 100.0 / yt."year_total", 2) AS "share_percent"
FROM    cat_year_counts cy
JOIN    year_totals    yt
        ON cy."yr" = yt."yr"
ORDER BY cy."yr"
