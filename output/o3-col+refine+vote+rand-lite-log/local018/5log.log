    JOIN   "case_ids"    ci ON ci."case_id" = co."case_id"
    WHERE  ci."db_year" = 2021
    GROUP  BY cat
    ORDER  BY COUNT(*) DESC
    LIMIT 1
),
year_tot AS (                         -- total collisions in 2011 & 2021
    SELECT ci."db_year", COUNT(*) AS tot
    FROM   "collisions"  co
