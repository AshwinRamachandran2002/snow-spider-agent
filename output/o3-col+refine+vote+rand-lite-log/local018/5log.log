```sql
--Description: Find the primary-collision-factor (PCF) violation category that caused the most crashes in 2021,
--             compute that category’s share of all crashes in 2021 and in 2011, and then
--             show the percentage-point change (2011 – 2021).
--             If 2011 has no collision data, the 2011 share – and thus the change – will be NULL.
WITH top21 AS (  -- most common PCF category in 2021
    SELECT co."pcf_violation_category" AS cat
    FROM   "collisions"  co
    JOIN   "case_ids"    ci ON ci."case_id" = co."case_id"
    WHERE  ci."db_year" = 2021
    GROUP  BY cat
    ORDER  BY COUNT(*) DESC
    LIMIT 1
),
year_totals AS ( -- total collisions in 2011 & 2021
    SELECT ci."db_year", COUNT(*) AS total_collisions
    FROM   "collisions"  co
    JOIN   "case_ids"    ci ON ci."case_id" = co."case_id"
    WHERE  ci."db_year" IN (2011, 2021)
    GROUP  BY ci."db_year"
),
cat_totals AS (  -- collisions in those years for the top-2021 category
    SELECT ci."db_year", COUNT(*) AS cat_collisions
    FROM   "collisions"  co
    JOIN   "case_ids"    ci ON ci."case_id" = co."case_id"
    JOIN   top21         t  ON t.cat = co."pcf_violation_category"
    WHERE  ci."db_year" IN (2011, 2021)
    GROUP  BY ci."db_year"
)
SELECT
    t.cat                                                   AS "pcf_violation_category",
    ROUND(100.0 * ct11.cat_collisions / yt11.total_collisions, 2) AS "share_2011_pct",
    ROUND(100.0 * ct21.cat_collisions / yt21.total_collisions, 2) AS "share_2021_pct",
    ROUND(
        (100.0 * ct11.cat_collisions / yt11.total_collisions) -
        (100.0 * ct21.cat_collisions / yt21.total_collisions), 2
    )                                                       AS "percentage_point_decrease"
FROM        top21       t
LEFT JOIN   cat_totals  ct11 ON ct11."db_year" = 2011
LEFT JOIN   cat_totals  ct21 ON ct21."db_year" = 2021
LEFT JOIN   year_totals yt11 ON yt11."db_year" = 2011
LEFT JOIN   year_totals yt21 ON yt21."db_year" = 2021;
```
