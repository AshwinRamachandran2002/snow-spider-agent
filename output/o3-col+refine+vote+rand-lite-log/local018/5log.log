LIMIT 20;            -- shows the most frequent categories, top row is the #1 cause
```

```sql
-- 5. Total number of collisions in 2021 (denominator for shares)
SELECT COUNT(*) AS "total_2021_collisions"
FROM   "collisions" AS co
JOIN   "case_ids"   AS ci ON co."case_id" = ci."case_id"
WHERE  ci."db_year" = 2021;
```

```sql
-- 6. Count collisions by the same PCF category list for the comparison year 2011
SELECT ci."db_year",
       co."pcf_violation_category",
       COUNT(*) AS "cnt_2011"
FROM   "collisions" AS co
JOIN   "case_ids"  AS ci ON co."case_id" = ci."case_id"
WHERE  ci."db_year" = 2011
GROUP  BY co."pcf_violation_category"
ORDER  BY "cnt_2011" DESC
LIMIT 20;
```

```sql
-- 7. Total collisions in 2011 (another denominator we need)
SELECT COUNT(*) AS "total_2011_collisions"
FROM   "collisions" AS co
JOIN   "case_ids"   AS ci ON co."case_id" = ci."case_id"
WHERE  ci."db_year" = 2011;
```

```sql
-- 8. Put 2021 shares (percentage of all 2021 crashes) in one list
WITH yr_tot AS (
  SELECT ci."db_year", COUNT(*) AS tot
  FROM   "collisions" AS co
  JOIN   "case_ids"   AS ci ON co."case_id" = ci."case_id"
  GROUP  BY ci."db_year")
SELECT co."pcf_violation_category",
       ROUND(100.0 * COUNT(*) / yt.tot, 2)  AS "share_2021_pct"
FROM   "collisions" AS co
JOIN   "case_ids"  AS ci ON co."case_id" = ci."case_id"
JOIN   yr_tot       AS yt ON yt."db_year" = ci."db_year"
WHERE  ci."db_year" = 2021
GROUP  BY co."pcf_violation_category"
ORDER  BY "share_2021_pct" DESC
LIMIT 20;           -- first row again tells us the #1 category and its 2021 share
```

```sql
-- 9. 2011 shares for exactly that #1 2021 category
WITH top21 AS (      -- fetch the single top violation category of 2021
  SELECT co."pcf_violation_category"
  FROM   "collisions" AS co
  JOIN   "case_ids"  AS ci ON co."case_id" = ci."case_id"
  WHERE  ci."db_year" = 2021
  GROUP  BY co."pcf_violation_category"
  ORDER  BY COUNT(*) DESC
  LIMIT 1
),
totals AS (
  SELECT ci."db_year", COUNT(*) AS tot
  FROM   "collisions" AS co
  JOIN   "case_ids"   AS ci ON co."case_id" = ci."case_id"
  GROUP  BY ci."db_year"
)
SELECT '2011' AS "year",
       ROUND(100.0*SUM(CASE WHEN ci."db_year" = 2011 THEN 1 END)/MAX(CASE WHEN ci."db_year"=2011 THEN totals.tot END),2) AS "share_2011_pct"
FROM   "collisions" AS co
JOIN   "case_ids"  AS ci ON co."case_id" = ci."case_id"
JOIN   top21        ON top21."pcf_violation_category" = co."pcf_violation_category"
JOIN   totals       ON totals."db_year" = ci."db_year"
WHERE  ci."db_year" = 2011;
```

```sql
-- 10.  Finally, compute the percentage-point decrease of that
--      top-2021 category’s share from 2011 to 2021
WITH top21 AS (
  SELECT co."pcf_violation_category"
  FROM   "collisions" AS co
  JOIN   "case_ids"  AS ci ON co."case_id" = ci."case_id"
  WHERE  ci."db_year" = 2021
  GROUP  BY co."pcf_violation_category"
  ORDER  BY COUNT(*) DESC
  LIMIT 1
),
yr_tot AS (
  SELECT ci."db_year", COUNT(*) AS tot
  FROM   "collisions" AS co
  JOIN   "case_ids"   AS ci ON co."case_id" = ci."case_id"
  GROUP  BY ci."db_year"
),
shares AS (
  SELECT ci."db_year",
         ROUND(100.0 * COUNT(*) / yt.tot, 2) AS share_pct
  FROM   "collisions" AS co
  JOIN   "case_ids"  AS ci ON co."case_id" = ci."case_id"
  JOIN   yr_tot       AS yt ON yt."db_year" = ci."db_year"
  JOIN   top21        ON top21."pcf_violation_category" = co."pcf_violation_category"
  GROUP  BY ci."db_year"
)
SELECT 
  (SELECT share_pct FROM shares WHERE "db_year" = 2011)  -
  (SELECT share_pct FROM shares WHERE "db_year" = 2021)  AS "percentage_point_decrease";
```
