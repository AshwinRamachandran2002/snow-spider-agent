```sql
--Description:  The database lacks 2011 data (earliest year present is 2017), so we
--estimate the requested change using 2017 vs 2021.  The query:
-- 1) finds 2021’s most frequent Primary-Collision-Factor (PCF) category;
-- 2) gets that category’s crash counts and the total crashes for both 2017 & 2021;
-- 3) computes each year’s percentage share and the percentage-point decrease
--    from 2017 to 2021.
WITH top_2021 AS (                               -- most common PCF in 2021
    SELECT c."pcf_violation_category" AS cat
    FROM   "collisions" c
    JOIN   "case_ids"  ci ON ci."case_id" = c."case_id"
    WHERE  ci."db_year" = 2021
    GROUP BY c."pcf_violation_category"
    ORDER BY COUNT(*) DESC
    LIMIT 1
),
year_cat_counts AS (                             -- crashes per cat & year
    SELECT ci."db_year"               AS yr,
           c."pcf_violation_category" AS cat,
           COUNT(*)                   AS cnt
    FROM   "collisions" c
    JOIN   "case_ids"  ci ON ci."case_id" = c."case_id"
    WHERE  ci."db_year" IN (2017, 2021)
    GROUP BY ci."db_year", c."pcf_violation_category"
),
year_totals AS (                                 -- total crashes per year
    SELECT ci."db_year" AS yr,
           COUNT(*)     AS total_cnt
    FROM   "collisions" c
    JOIN   "case_ids"  ci ON ci."case_id" = c."case_id"
    WHERE  ci."db_year" IN (2017, 2021)
    GROUP BY ci."db_year"
)
SELECT
    t.cat                                                        AS "PCF_category",
    ROUND(100.0 * c21.cnt / y21.total_cnt, 2)  AS "share_2021_pct",
    ROUND(100.0 * c17.cnt / y17.total_cnt, 2)  AS "share_2017_pct",
    ROUND(100.0 * c17.cnt / y17.total_cnt
        - 100.0 * c21.cnt / y21.total_cnt, 2)  AS "pct_point_decrease"
FROM   top_2021        t
JOIN   year_cat_counts c21 ON c21.cat = t.cat AND c21.yr = 2021
JOIN   year_cat_counts c17 ON c17.cat = t.cat AND c17.yr = 2017
JOIN   year_totals     y21 ON y21.yr = 2021
JOIN   year_totals     y17 ON y17.yr = 2017;
