--Description: Total number of collisions that occurred in calendar-year 2011,
--derived directly from the “collision_date” field because 2011 records are
--missing from the case_ids table.
SELECT
    COUNT(*) AS "total_2011_collisions"
FROM
    "collisions"
WHERE
    substr("collision_date", 1, 4) = '2011'
