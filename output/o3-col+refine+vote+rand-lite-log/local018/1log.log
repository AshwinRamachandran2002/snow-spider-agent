```sql
-- 8. Final answer: percentage-point decrease in share for the 2021 top PCF category vs. its 2011 share.
WITH yearly_cat_counts AS (
    SELECT ci."db_year"               AS yr,
           c."pcf_violation_category" AS cat,
           COUNT(*)                   AS cnt
    FROM   "collisions" AS c
    JOIN   "case_ids"  AS ci
           ON ci."case_id" = c."case_id"
    WHERE  ci."db_year" IN (2011, 2021)
    GROUP BY ci."db_year", c."pcf_violation_category"
),
yearly_totals AS (
    SELECT ci."db_year" AS yr,
           COUNT(*)     AS total_cnt
    FROM   "collisions" AS c
    JOIN   "case_ids"  AS ci
           ON ci."case_id" = c."case_id"
    WHERE  ci."db_year" IN (2011, 2021)
    GROUP BY ci."db_year"
),
top_cat_2021 AS (
    SELECT cat
    FROM   yearly_cat_counts
    WHERE  yr = 2021
    ORDER BY cnt DESC
    LIMIT 1
)
SELECT t.cat                                                         AS "PCF_violation_category",
       ROUND(100.0 * c21.cnt / yt21.total_cnt, 2)                    AS "share_2021(%)",
       ROUND(100.0 * c11.cnt / yt11.total_cnt, 2)                    AS "share_2011(%)",
       ROUND(100.0 * c11.cnt / yt11.total_cnt
            - 100.0 * c21.cnt / yt21.total_cnt, 2)                   AS "percentage_point_decrease"
FROM   top_cat_2021            AS t
JOIN   yearly_cat_counts AS c21 ON c21.cat = t.cat AND c21.yr = 2021
JOIN   yearly_cat_counts AS c11 ON c11.cat = t.cat AND c11.yr = 2011
JOIN   yearly_totals      AS yt21 ON yt21.yr = 2021
JOIN   yearly_totals      AS yt11 ON yt11.yr = 2011;
```
