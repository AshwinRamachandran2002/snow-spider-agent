Query:
-- 7. Collision counts for that top category in both 2011 and 2021.
SELECT ci."db_year",
       COUNT(*) AS "top_cat_collisions"
FROM "collisions" AS c
JOIN "case_ids"  AS ci ON ci."case_id" = c."case_id"
WHERE c."pcf_violation_category" = (
        SELECT c2."pcf_violation_category"
        FROM "collisions" AS c2
        JOIN "case_ids"  AS ci2 ON ci2."case_id" = c2."case_id"
        WHERE ci2."db_year" = 2021
        GROUP BY c2."pcf_violation_category"
        ORDER BY COUNT(*) DESC
        LIMIT 1
      )
  AND ci."db_year" IN (2011, 2021)
GROUP BY ci."db_year";
