Query:
--Description: 
-- 8. List every California county’s vaccination-site count (no population join)
--     and compute the simple proportion of each county’s sites relative to the
--     statewide total.  This removes the previous join to the ACS table and
--     therefore avoids the missing‐column error.
WITH county_sites AS (
  SELECT
    facility_sub_region_2 AS county_name,
    COUNT(DISTINCT facility_name) AS site_cnt
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
),
state_total AS (
  SELECT SUM(site_cnt) AS ca_total_sites
  FROM county_sites
)
SELECT
  c.county_name,
  c.site_cnt,
  ROUND(100.0 * c.site_cnt / t.ca_total_sites, 2) AS pct_of_state_sites
FROM county_sites AS c
CROSS JOIN state_total AS t
ORDER BY c.county_name
LIMIT 20
