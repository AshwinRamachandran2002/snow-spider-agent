/*  Vaccine sites per-1,000 residents for each California county           */

WITH county_pop AS (         -- 2018 ACS 5-year population (FIPS = 06***)
  SELECT
    geo_id,
    SAFE_CAST(total_pop AS FLOAT64) AS total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'            -- 06 = California
),

county_names AS (           -- Map FIPS → “<County> County” text label
  SELECT
    geoid AS geo_id,
    CONCAT(name, ' County') AS county_name
  FROM `bigquery-public-data.geo_us_boundaries.counties`
  WHERE geoid LIKE '06%'              -- California counties only
),

pop_with_name AS (          -- Combine population with readable name
  SELECT
    n.county_name,
    p.total_pop
  FROM county_pop  AS p
  JOIN county_names AS n
  USING (geo_id)
),

site_counts AS (            -- Distinct vaccination sites per county
  SELECT
    facility_sub_region_2 AS county_name,
    COUNT(DISTINCT facility_name) AS site_cnt
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
)

SELECT
  s.county_name,
  s.site_cnt,
  p.total_pop,
  ROUND( (s.site_cnt / p.total_pop) * 1000, 4) AS sites_per_1000_people
FROM site_counts    AS s
JOIN pop_with_name  AS p
USING (county_name)
ORDER BY sites_per_1000_people DESC;
```
