```sql
-- 4. Inspect the vaccination-site master list for California (the “all” mode table).
SELECT DISTINCT facility_name,
       facility_sub_region_1,
       facility_sub_region_2
FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
WHERE facility_sub_region_1 = 'California'
LIMIT 20;
```

```sql
-- 5. For a sanity-check: how many distinct facilities are recorded per California county?
SELECT facility_sub_region_2  AS county_name,
       COUNT(DISTINCT facility_name) AS facility_cnt
FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
WHERE facility_sub_region_1 = 'California'
GROUP BY county_name
ORDER BY facility_cnt DESC
LIMIT 20;
```

```sql
-- 6. Pull the 2018 population for every California county (keep only needed columns).
SELECT geo_id,
       REGEXP_EXTRACT(name, r'^(.*? County)')            AS county_name,
       CAST(total_pop AS FLOAT64)                        AS total_pop_2018
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE geo_id LIKE '06%';
```

```sql
-- 7. Join population to facility counts to get vaccine-site rate per 1,000 people.
WITH pop AS (
  SELECT REGEXP_EXTRACT(name, r'^(.*? County)') AS county_name,
         CAST(total_pop AS FLOAT64)             AS total_pop_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
),
sites AS (
  SELECT facility_sub_region_2 AS county_name,
         COUNT(DISTINCT facility_name)         AS site_cnt
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
)
SELECT p.county_name,
       p.total_pop_2018,
       s.site_cnt,
       ROUND(1000 * s.site_cnt / p.total_pop_2018, 3) AS sites_per_1k_pop
FROM pop AS p
LEFT JOIN sites AS s
USING (county_name)
ORDER BY sites_per_1k_pop DESC
LIMIT 20;
```

```sql
-- 8. Same result but show all counties and suppress NULLs (counties with zero sites become 0).
WITH pop AS (
  SELECT REGEXP_EXTRACT(name, r'^(.*? County)') AS county_name,
         CAST(total_pop AS FLOAT64)             AS total_pop_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
),
sites AS (
  SELECT facility_sub_region_2 AS county_name,
         COUNT(DISTINCT facility_name) AS site_cnt
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
)
SELECT p.county_name,
       p.total_pop_2018,
       IFNULL(s.site_cnt,0)                               AS site_cnt,
       ROUND(1000 * IFNULL(s.site_cnt,0) / p.total_pop_2018,3) AS sites_per_1k_pop
FROM pop AS p
LEFT JOIN sites AS s
USING (county_name)
ORDER BY county_name
LIMIT 20;
```

```sql
