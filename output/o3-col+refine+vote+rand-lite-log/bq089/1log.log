```sql
--Description: 
-- 8. List every California county’s vaccination-site count (no population join)
--     and compute the simple proportion of each county’s sites relative to the
--     statewide total.  This removes the previous join to the ACS table and
--     therefore avoids the missing‐column error.
WITH county_sites AS (
  SELECT
    facility_sub_region_2 AS county_name,
    COUNT(DISTINCT facility_name) AS site_cnt
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
),
state_total AS (
  SELECT SUM(site_cnt) AS ca_total_sites
  FROM county_sites
)
SELECT
  c.county_name,
  c.site_cnt,
  ROUND(100.0 * c.site_cnt / t.ca_total_sites, 2) AS pct_of_state_sites
FROM county_sites AS c
CROSS JOIN state_total AS t
ORDER BY c.county_name
LIMIT 20;
```

```sql
--Description: 
-- 9. Check for duplicates: compare raw row count versus distinct facility names
--     inside each California county in the vaccination table.
SELECT
  facility_sub_region_2 AS county_name,
  COUNT(*)                        AS raw_rows,
  COUNT(DISTINCT facility_name)   AS distinct_sites
FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
WHERE facility_sub_region_1 = 'California'
GROUP BY county_name
ORDER BY raw_rows DESC
LIMIT 20;
```

```sql
--Description: 
-- 10. Final list of California counties with population and sites per 1,000 people,
--      using a robust text join that matches the vaccination table’s county label
--      “<Name> County”.  The ACS table does not expose a `name` column, so we
--      construct the same text pattern from an external lookup of county names
--      contained in the 2021 ACS one-year release, which *does* include `name`.
WITH pop AS (                     -- 2018 five-year population
  SELECT
    geo_id,
    CAST(total_pop AS FLOAT64) AS total_pop_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'                         -- California
),
names AS (                    -- readable county names (from the 2021 one-year file)
  SELECT
    geo_id,
    CONCAT(REGEXP_EXTRACT(name, r'^(.*) County.*'), ' County') AS county_name
  FROM `bigquery-public-data.census_bureau_acs.county_2021_1yr`
  WHERE geo_id LIKE '06%'
),
sites AS (                     -- vaccination-site counts
  SELECT
    facility_sub_region_2 AS county_name,
    COUNT(DISTINCT facility_name) AS site_cnt
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
)
SELECT
  n.county_name,
  p.total_pop_2018,
  IFNULL(s.site_cnt, 0)                                         AS site_cnt,
  ROUND(1000 * IFNULL(s.site_cnt, 0) / p.total_pop_2018, 3)     AS sites_per_1k_pop
FROM pop AS p
JOIN names AS n USING (geo_id)      -- attach readable county label
LEFT JOIN sites AS s USING (county_name)
ORDER BY sites_per_1k_pop DESC
LIMIT 20;
```
