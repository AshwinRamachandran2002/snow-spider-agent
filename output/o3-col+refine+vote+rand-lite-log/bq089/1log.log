```sql
--Description:
-- Final, complete computation of vaccination-site density for every California county.
-- Data sources
--   1. `county_2018_5yr`  – 2018 ACS 5-year; gives population and 5-digit county FIPS (geo_id).
--   2. `facility_boundary_us_all`  – master vaccination-site list; gives county_fips,
--      readable county name (facility_sub_region_2) and facility_provider_id (unique site id).
--
-- Logic
--   • Build CTE “pop” with 2018 population for all CA counties (geo_id LIKE '06%').
--   • Build CTE “sites” counting DISTINCT facility_provider_id per county_fips.
--   • LEFT JOIN pop ⇢ sites on the shared FIPS code so counties with zero sites still appear.
--   • Compute sites per 1,000 people.
--   • Order by descending rate; you can remove ORDER BY or LIMIT for different views.
WITH pop AS (
  SELECT
    geo_id                     AS county_fips,
    CAST(total_pop AS FLOAT64) AS total_pop_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'                         -- California only
),
sites AS (
  SELECT
    county_fips,
    ANY_VALUE(facility_sub_region_2) AS county_name,
    COUNT(DISTINCT facility_provider_id) AS site_cnt
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_fips
)
SELECT
  COALESCE(s.county_name, CONCAT('FIPS ', p.county_fips)) AS county_name,
  p.total_pop_2018,
  IFNULL(s.site_cnt, 0)                                   AS site_cnt,
  ROUND(1000 * IFNULL(s.site_cnt, 0) / p.total_pop_2018, 3) AS sites_per_1k_pop
FROM pop AS p
LEFT JOIN sites AS s
USING (county_fips)
ORDER BY sites_per_1k_pop DESC;
```
