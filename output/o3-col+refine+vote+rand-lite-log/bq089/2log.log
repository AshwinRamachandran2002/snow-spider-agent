```sql
/*  Vaccine-site density (sites per 1,000 residents) for every California county  */
WITH ca_county_pop AS (        -- 2018 ACS 5-year population for California counties
  SELECT
    pop.geo_id                             AS county_fips,          -- 5-digit FIPS
    pop.total_pop,
    b.name                                 AS county_name_clean,    -- e.g. Alameda
    CONCAT(b.name, ' County')              AS county_name_match     -- e.g. Alameda County
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`   AS pop
  JOIN `bigquery-public-data.geo_us_boundaries.counties`          AS b
    ON pop.geo_id = b.geoid                                       -- exact FIPS match
  WHERE b.state_fips = '06'                                       -- California
),

ca_vax_sites AS (             -- Count of unique vaccination sites per county
  SELECT
    facility_sub_region_2                       AS county_name_match,
    COUNT(DISTINCT facility_name)               AS site_count
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name_match
)

SELECT
  p.county_fips,
  p.county_name_clean        AS county,
  p.total_pop,
  COALESCE(v.site_count, 0)  AS vaccine_sites,
  ROUND(COALESCE(v.site_count, 0) * 1000 / p.total_pop, 4) AS sites_per_1000_pop
FROM ca_county_pop p
LEFT JOIN ca_vax_sites v
  ON UPPER(p.county_name_match) = UPPER(v.county_name_match)
ORDER BY sites_per_1000_pop DESC;
