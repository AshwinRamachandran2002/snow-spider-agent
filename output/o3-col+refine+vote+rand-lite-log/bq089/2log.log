```sql
--Description: Get California county names for the 2018 five-year ACS by joining its `geo_id`s
--             to the 2018 one-year ACS (which contains the `name` field).  Strip the trailing
--             “ County, California” so we obtain clean county names.
WITH pop AS (
  SELECT geo_id
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'                 -- California FIPS prefix
),
names AS (
  SELECT
    geo_id,
    REGEXP_REPLACE(name, r' County, California$', '') AS county_name
  FROM `bigquery-public-data.census_bureau_acs.county_2018_1yr`
  WHERE geo_id LIKE '06%'
)
SELECT DISTINCT county_name
FROM pop
JOIN names USING (geo_id)
LIMIT 20;
