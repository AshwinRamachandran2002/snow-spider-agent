```sql
--1 Description: Look at the raw structure of the 2018 five-year ACS county table.
SELECT *
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
LIMIT 20;
```

```sql
--2 Description: Check how California counties are recorded (notice the “name” pattern).
SELECT DISTINCT name
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE geo_id LIKE '06%'            -- “06” = California FIPS state code
LIMIT 20;
```

```sql
--3 Description: Extract just the county name (drop “ County, California”).
SELECT DISTINCT
  REGEXP_REPLACE(name, r' County, California$', '') AS county_name_clean
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE geo_id LIKE '06%'
LIMIT 20;
```

```sql
--4 Description: Pull the 2018 population for every California county.
SELECT
  REGEXP_REPLACE(name, r' County, California$', '') AS county_name,
  total_pop
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE geo_id LIKE '06%'
LIMIT 58;          -- 58 California counties
```

```sql
--5 Description: Count distinct vaccination sites per California county
--               (using the master “all‐modes” facility table).
SELECT
  facility_sub_region_2  AS county_name,
  COUNT(DISTINCT facility_name) AS vaccine_sites
FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
WHERE facility_sub_region_1 = 'California'
GROUP BY county_name
ORDER BY vaccine_sites DESC
LIMIT 20;
```

```sql
--6 Description: Join population and site counts to compute sites per 1,000 residents.
SELECT
  pop.county_name,
  pop.total_pop,
  sites.vaccine_sites,
  sites.vaccine_sites * 1000 / pop.total_pop AS sites_per_1000
FROM (
  SELECT
    REGEXP_REPLACE(name, r' County, California$', '') AS county_name,
    total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
) AS pop
JOIN (
  SELECT
    facility_sub_region_2 AS county_name,
    COUNT(DISTINCT facility_name) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
) AS sites
USING (county_name)
LIMIT 20;
```

```sql
--7 Description: Include counties that have zero recorded sites (LEFT JOIN).
SELECT
  pop.county_name,
  pop.total_pop,
  COALESCE(sites.vaccine_sites, 0)          AS vaccine_sites,
  COALESCE(sites.vaccine_sites, 0) * 1000 / pop.total_pop AS sites_per_1000
FROM (
  SELECT
    REGEXP_REPLACE(name, r' County, California$', '') AS county_name,
    total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
) AS pop
LEFT JOIN (
  SELECT
    facility_sub_region_2 AS county_name,
    COUNT(DISTINCT facility_name) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
) AS sites
USING (county_name)
ORDER BY sites_per_1000 DESC
LIMIT 20;
```

```sql
--8 Description: Show the statewide average (population-weighted) sites per 1,000 people.
WITH pop AS (
  SELECT
    total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
),
sites AS (
  SELECT
    COUNT(DISTINCT facility_name) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
)
SELECT
  sites.vaccine_sites,
  SUM(pop.total_pop)              AS state_pop,
  sites.vaccine_sites * 1000 / SUM(pop.total_pop) AS state_sites_per_1000
FROM pop, sites;
```

```sql
--9 Description: Final formatted answer – every California county with vaccine sites per 1,000 people.
SELECT
  pop.county_name                        AS county,
  ROUND(pop.total_pop)                   AS population_2018,
  COALESCE(sites.vaccine_sites, 0)       AS vaccine_sites,
  ROUND(COALESCE(sites.vaccine_sites, 0) * 1000 / pop.total_pop, 3) AS sites_per_1000
FROM (
  SELECT
    REGEXP_REPLACE(name, r' County, California$', '') AS county_name,
    total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
) AS pop
LEFT JOIN (
  SELECT
    facility_sub_region_2 AS county_name,
    COUNT(DISTINCT facility_name) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
) AS sites
USING (county_name)
ORDER BY county
LIMIT 58;
```

```sql
--10 Description: Verify one county—Los Angeles—to sanity check the calculation.
SELECT
  pop.county_name,
  pop.total_pop,
  sites.vaccine_sites,
  sites.vaccine_sites * 1000 / pop.total_pop AS sites_per_1000
FROM (
  SELECT
    REGEXP_REPLACE(name, r' County, California$', '') AS county_name,
    total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06037'            -- FIPS for Los Angeles County
) AS pop
LEFT JOIN (
  SELECT
    facility_sub_region_2 AS county_name,
    COUNT(DISTINCT facility_name) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
    AND facility_sub_region_2 = 'Los Angeles County'
  GROUP BY county_name
) AS sites
USING (county_name);
```
