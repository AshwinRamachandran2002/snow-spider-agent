/* Vaccine-site density (sites per 1,000 residents) for every California county */
WITH ca_county_names AS (     -- California county names & 5-digit FIPS codes
  SELECT
    geoid                                    AS county_fips,          -- e.g. 06037
    name                                     AS county_name,          -- e.g. Los Angeles
    CONCAT(name, ' County')                  AS county_name_match     -- e.g. Los Angeles County
  FROM `bigquery-public-data.geo_us_boundaries.counties`
  WHERE state_name = 'California'            -- limit to California
),

ca_county_pop AS (           -- 2018 ACS 5-year population for those counties
  SELECT
    geo_id                                    AS county_fips,
    SAFE_CAST(total_pop AS NUMERIC)           AS total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE LEFT(geo_id, 2) = '06'               -- California state FIPS
),

ca_vax_sites AS (            -- Count of unique vaccination sites per county
  SELECT
    facility_sub_region_2                     AS county_name_match,
    COUNT(DISTINCT facility_name)             AS site_count
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name_match
)

SELECT
  n.county_fips,
  n.county_name,
  p.total_pop,
  COALESCE(v.site_count, 0)                                       AS vaccine_sites,
  ROUND(COALESCE(v.site_count, 0) * 1000 / p.total_pop, 4)        AS sites_per_1000_pop
FROM ca_county_names n
LEFT JOIN ca_county_pop  p USING (county_fips)
LEFT JOIN ca_vax_sites   v ON UPPER(n.county_name_match) = UPPER(v.county_name_match)
ORDER BY sites_per_1000_pop DESC;
