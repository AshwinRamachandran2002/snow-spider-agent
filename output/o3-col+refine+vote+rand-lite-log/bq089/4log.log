```sql
--Description: Count the total number of vaccination facilities in every California
--county (site table = “all” travel-mode layer).
SELECT
  facility_sub_region_2 AS county_name,
  COUNT(*)               AS num_sites
FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
WHERE facility_sub_region_1 = 'California'
GROUP BY county_name
ORDER BY num_sites DESC
LIMIT 20;
```

```sql
--Description: Pull the latest (2018 5-yr) ACS population for every California county,
--and strip off the trailing “, California” so the name can line up with the site table.
SELECT
  REGEXP_REPLACE(name, r', California$', '')      AS county_name,
  total_pop
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE LOWER(name) LIKE '%, california'
LIMIT 20;
```

```sql
--Description: Verify that the cleaned county names from both sources really match
--by doing an inner join and showing a few pairs side-by-side.
SELECT
  pop.county_name,
  pop.total_pop,
  sites.num_sites
FROM (
  SELECT REGEXP_REPLACE(name, r', California$', '') AS county_name, total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE LOWER(name) LIKE '%, california'
) AS pop
JOIN (
  SELECT facility_sub_region_2 AS county_name, COUNT(*) AS num_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
) AS sites
USING (county_name)
ORDER BY county_name
LIMIT 20;
```

```sql
--Description: Compute the number of vaccination sites per 1,000 residents for each
--California county.
SELECT
  county_name,
  total_pop,
  num_sites,
  ROUND( 1000 * num_sites / total_pop , 3) AS sites_per_1000
FROM (
  SELECT REGEXP_REPLACE(name, r', California$', '') AS county_name, total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE LOWER(name) LIKE '%, california'
) AS pop
JOIN (
  SELECT facility_sub_region_2 AS county_name, COUNT(*) AS num_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
) AS sites
USING (county_name)
ORDER BY sites_per_1000 DESC
LIMIT 20;
```

```sql
--Description: Show counties whose vaccination-site density is below the statewide
--median (quick sense-check of the distribution).
WITH per_cnty AS (
  SELECT
    county_name,
    ROUND( 1000 * num_sites / total_pop , 3) AS sites_per_1000
  FROM (
    SELECT REGEXP_REPLACE(name, r', California$', '') AS county_name, total_pop
    FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
    WHERE LOWER(name) LIKE '%, california'
  ) AS pop
  JOIN (
    SELECT facility_sub_region_2 AS county_name, COUNT(*) AS num_sites
    FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
    WHERE facility_sub_region_1 = 'California'
    GROUP BY county_name
  ) AS sites
  USING (county_name)
)
SELECT *
FROM per_cnty
WHERE sites_per_1000 < (SELECT APPROX_QUANTILES(sites_per_1000, 2)[OFFSET(1)] FROM per_cnty)
ORDER BY sites_per_1000
LIMIT 20;
```

```sql
--Description: Produce the complete final table of every California county with its
--vaccination-site density (sites per 1,000 people), sorted high to low.
SELECT
  county_name,
  total_pop,
  num_sites,
  ROUND(1000 * num_sites / total_pop, 3) AS sites_per_1000
FROM (
  SELECT REGEXP_REPLACE(name, r', California$', '') AS county_name, total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE LOWER(name) LIKE '%, california'
) AS pop
LEFT JOIN (
  SELECT facility_sub_region_2 AS county_name, COUNT(*) AS num_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
) AS sites
USING (county_name)
ORDER BY sites_per_1000 DESC;
```

```sql
--Description: Get the statewide overall number of sites per 1,000 people
--(California total sites divided by California total population).
WITH ca_sites AS (
  SELECT COUNT(*) AS total_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
),
ca_pop AS (
  SELECT SUM(total_pop) AS total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE LOWER(name) LIKE '%, california'
)
SELECT
  total_sites,
  total_pop,
  ROUND(1000 * total_sites / total_pop, 3) AS sites_per_1000_statewide
FROM ca_sites CROSS JOIN ca_pop;
```
