  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
)
SELECT
  x.county_name,
  p.total_pop,
  s.num_sites
FROM county_xwalk   AS x
LEFT JOIN acs_pop   AS p ON p.county_fips = x.county_fips
LEFT JOIN site_counts AS s USING (county_name)
ORDER BY county_name
LIMIT 20;
