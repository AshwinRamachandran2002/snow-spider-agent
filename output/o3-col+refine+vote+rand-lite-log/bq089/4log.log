```sql
--Description:  In the `county_2018_5yr` table the county label column `name`
--does not exist; counties are identified solely by their 5-digit FIPS code in
--`geo_id`.  California’s state FIPS code is “06”, so every California county’s
--`geo_id` begins with “06”.  To obtain the 2018 five-year ACS population for
--each California county, filter on that prefix and return the FIPS code together
--with its total-population estimate.
SELECT
  geo_id      AS county_fips,           -- 5-digit county FIPS (06xxx = CA)
  total_pop   AS pop_2018_5yr
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE SUBSTR(geo_id, 1, 2) = '06'       -- keep only California counties
ORDER BY geo_id
LIMIT 20;
```
