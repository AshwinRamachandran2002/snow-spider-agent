    STRUCT('San Diego County','06073'),STRUCT('San Francisco County','06075'),
    STRUCT('San Joaquin County','06077'),STRUCT('San Luis Obispo County','06079'),
    STRUCT('San Mateo County','06081'),STRUCT('Santa Barbara County','06083'),
    STRUCT('Santa Clara County','06085'),STRUCT('Santa Cruz County','06087'),
    STRUCT('Shasta County','06089'),STRUCT('Sierra County','06091'),
    STRUCT('Siskiyou County','06093'),STRUCT('Solano County','06095'),
    STRUCT('Sonoma County','06097'),STRUCT('Stanislaus County','06099'),
    STRUCT('Sutter County','06101'),STRUCT('Tehama County','06103'),
    STRUCT('Trinity County','06105'),STRUCT('Tulare County','06107'),
    STRUCT('Tuolumne County','06109'),STRUCT('Ventura County','06111'),
    STRUCT('Yolo County','06113'),STRUCT('Yuba County','06115')
  ]) AS county_name, county_fips
),
acs_pop AS (
  SELECT geo_id AS county_fips, total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE SUBSTR(geo_id,1,2)='06'
),
site_counts AS (
  SELECT facility_sub_region_2 AS county_name, COUNT(*) AS num_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1='California'
  GROUP BY county_name
),
per_cnty AS (
  SELECT
    x.county_name,
    p.total_pop,
    COALESCE(s.num_sites,0) AS num_sites,
    1000*COALESCE(s.num_sites,0)/p.total_pop AS sites_per_1000
  FROM county_xwalk x
  JOIN acs_pop p   ON p.county_fips = x.county_fips
  LEFT JOIN site_counts s USING (county_name)
)
SELECT *
FROM per_cnty
WHERE sites_per_1000 < (SELECT APPROX_QUANTILES(sites_per_1000,2)[OFFSET(1)] FROM per_cnty)
ORDER BY sites_per_1000
LIMIT 20;
