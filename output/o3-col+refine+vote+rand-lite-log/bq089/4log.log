```sql
--Description:  Calculate California’s statewide vaccination-site density.
--Step-by-step logic:
-- 1. ca_sites CTE counts every vaccination facility whose
--    `facility_sub_region_1` = 'California'.
-- 2. ca_pop CTE sums 2018 5-year ACS population for all counties whose
--    FIPS code (`geo_id`) starts with the California state prefix “06”.
-- 3. Cross-join the two single-row CTEs to put total sites and total
--    population on one row, then compute sites per 1,000 residents.
WITH ca_sites AS (
  SELECT COUNT(*) AS total_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
),
ca_pop AS (
  SELECT SUM(total_pop) AS total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE SUBSTR(geo_id, 1, 2) = '06'          -- California counties
)
SELECT
  total_sites,
  total_pop,
  ROUND(1000 * total_sites / total_pop, 3) AS sites_per_1000_statewide
FROM ca_sites CROSS JOIN ca_pop;
```
