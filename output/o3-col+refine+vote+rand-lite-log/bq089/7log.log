```sql
--Description: Prepare a cleaned California-county population list for joining
SELECT
  geo_id,
  REGEXP_REPLACE(name, r', California$', '')   AS county_name,
  total_pop
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE geo_id LIKE '06%'
LIMIT 20;
```

```sql
--Description: Join vaccination-site counts with population to get sites per 1,000 residents
WITH pop AS (
  SELECT
    REGEXP_REPLACE(name, r', California$', '') AS county_name,
    total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
),
vax AS (
  SELECT
    facility_sub_region_2 AS county_name,
    COUNT(DISTINCT facility_name) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
)
SELECT
  pop.county_name,
  pop.total_pop,
  vax.vaccine_sites,
  ROUND(vax.vaccine_sites * 1000 / pop.total_pop, 4) AS sites_per_1000
FROM pop
JOIN vax
USING (county_name)
ORDER BY sites_per_1000 DESC
LIMIT 20;
```

```sql
--Description: Final answer – vaccine sites per 1,000 people (top 20 California counties)
WITH pop AS (
  SELECT
    REGEXP_REPLACE(name, r', California$', '') AS county_name,
    total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
),
vax AS (
  SELECT
    facility_sub_region_2          AS county_name,
    COUNT(DISTINCT facility_name)  AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
)
SELECT
  pop.county_name,
  ROUND(vax.vaccine_sites * 1000 / pop.total_pop, 4) AS vaccine_sites_per_1000
FROM pop
JOIN vax
USING (county_name)
ORDER BY vaccine_sites_per_1000 DESC
LIMIT 20;
```
