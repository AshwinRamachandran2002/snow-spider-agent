```sql
--Description:
-- Objective: obtain 2018 five-year ACS total population figures for every California county.
-- Reasoning:
-- 1. Table `county_2018_5yr` stores one row per U.S. county with a `geo_id` (state+county FIPS)
--    and many demographic columns, including `total_pop`.
-- 2. California’s state FIPS code is 06, so every California county `geo_id` starts with '06'.
-- 3. The table has no “name” column, so we simply project the columns that exist: `geo_id`
--    (to identify the county) and `total_pop` (population estimate).
-- 4. A LIMIT is added for a quick preview.
SELECT
  geo_id,            -- 5-digit FIPS (06xxx = California counties)
  total_pop          -- 2018 ACS 5-year population estimate
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE geo_id LIKE '06%'      -- filter to California counties
LIMIT 20;
```
