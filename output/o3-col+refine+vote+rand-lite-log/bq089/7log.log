--Description: 
-- Corrected version of the “cleaned California-county population list” query.
-- The `county_2018_5yr` table does not contain a `name` column, so we simply
-- return the available identifier (`geo_id`) and the 2018 population estimate
-- (`total_pop`).  The alias `county_id` will be used later if we decide to join
-- on FIPS codes instead of county names.
SELECT
  geo_id AS county_id,   -- 5-digit California county FIPS (06xxx)
  total_pop              -- 2018 five-year ACS population estimate
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE geo_id LIKE '06%'      -- limit to California counties
LIMIT 20
