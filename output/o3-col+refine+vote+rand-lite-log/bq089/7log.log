```sql
-- Description:  For every California county, compute the number of distinct
-- COVID-19 vaccination sites per 1,000 residents, using the 2018 five-year
-- ACS county-level population estimates.

WITH site_counts AS (          -- vaccination-site counts
  SELECT
    facility_sub_region_2 AS county_name,              -- e.g. “Los Angeles County”
    COUNT(DISTINCT facility_name) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
),

county_pop AS (                -- 2018 ACS population + county names
  SELECT
    CONCAT(b.name, ' County') AS county_name,          -- make wording match site table
    p.total_pop
  FROM `bigquery-public-data.geo_us_boundaries.counties`            AS b
  JOIN `bigquery-public-data.census_bureau_acs.county_2018_5yr`    AS p
    ON b.geoid = p.geo_id                                           -- 5-digit FIPS
  WHERE b.state_name = 'California'
)

SELECT
  sc.county_name,
  sc.vaccine_sites,
  cp.total_pop,
  ROUND(sc.vaccine_sites / cp.total_pop * 1000, 4) AS sites_per_1000
FROM site_counts sc
JOIN county_pop  cp USING (county_name)
ORDER BY sites_per_1000 DESC;
```
