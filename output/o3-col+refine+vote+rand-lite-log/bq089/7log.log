```sql
-- Description: For each California county, compute the number of distinct
-- COVID-19 vaccination sites per 1,000 residents, using 2018 five-year ACS
-- population estimates.

WITH site_counts AS (
  -- Count distinct vaccination sites for each California county
  SELECT
    facility_sub_region_2 AS county_name,          -- e.g. “Los Angeles County”
    COUNT(DISTINCT facility_name) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
),
county_pop AS (
  -- 2018 ACS population, matched to county names from US boundaries dataset
  SELECT
    b.name      AS county_name,                    -- expected to include “County”
    p.total_pop AS total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr` AS p
  JOIN `bigquery-public-data.geo_us_boundaries.counties` AS b
    ON b.fips = p.geo_id                           -- 5-digit FIPS match
  WHERE b.state_name = 'California'
)
SELECT
  sc.county_name,
  sc.vaccine_sites,
  cp.total_pop,
  ROUND(sc.vaccine_sites / cp.total_pop * 1000, 4) AS sites_per_1000
FROM site_counts sc
JOIN county_pop cp
  ON LOWER(sc.county_name) = LOWER(cp.county_name) -- case-insensitive match
ORDER BY sites_per_1000 DESC;
