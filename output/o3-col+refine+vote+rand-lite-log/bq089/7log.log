```sql
-- Description:  For each California county, compute the number of distinct
-- vaccination sites recorded in the “facility_boundary_us_all” table per
-- 1,000 residents, using the 2018 five-year ACS county-level population
-- estimates.

WITH ca_sites AS (
  -- All vaccination sites located in California
  SELECT
    facility_sub_region_2 AS county_name,        -- e.g. “Los Angeles County”
    facility_name
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
),
site_counts AS (
  -- Distinct site count by county
  SELECT
    county_name,
    COUNT(DISTINCT facility_name) AS vaccine_sites
  FROM ca_sites
  GROUP BY county_name
),
county_pop AS (
  -- 2018 five-year ACS population for California counties
  SELECT
    -- Strip the trailing “, California” to match the facility table’s wording
    REGEXP_REPLACE(name, r', California$', '') AS county_name,
    total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
