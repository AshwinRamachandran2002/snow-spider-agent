```

```sql
--Description: Repeat the density calculation but with *all* facility polygons
--instead of just drive-time polygons, using the same name/geo_id strategy.
WITH pop AS (
  SELECT geo_id, total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
),
names AS (
  SELECT geo_id, name
  FROM `bigquery-public-data.census_bureau_acs.county_2018_1yr`
  WHERE LOWER(name) LIKE '%, california'
),
all_sites AS (
  SELECT 
    facility_sub_region_2 AS county_name,
    COUNT(DISTINCT facility_name) AS num_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
)
SELECT
  n.name                                     AS county_name,
  all_sites.num_sites                        AS all_polygons_sites,
  p.total_pop,
  ROUND(all_sites.num_sites / p.total_pop * 1000, 4) AS sites_per_1000_all
FROM pop AS p
JOIN names AS n      USING (geo_id)
JOIN all_sites       ON LOWER(n.name) LIKE CONCAT(LOWER(all_sites.county_name), '%')
ORDER BY sites_per_1000_all DESC
LIMIT 20;
