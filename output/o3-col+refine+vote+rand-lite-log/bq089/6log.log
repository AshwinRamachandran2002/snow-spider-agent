/*  Vaccine-site density (sites per 1 000 residents) for every California county.
    – Population: 2018 five-year ACS county table.
    – Sites     : distinct facility_name values in the “all-polygons” vaccination
                  site table.
*/
WITH pop AS (
  SELECT
    b.name                     AS county_name,
    c.total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`   AS c
  JOIN `bigquery-public-data.geo_us_boundaries.counties`          AS b
    ON c.geo_id = b.geoid
  WHERE b.state_name = 'California'
),
sites AS (
  SELECT
    facility_sub_region_2      AS county_name,
    COUNT(DISTINCT facility_name) AS num_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
)
SELECT
  p.county_name,
  s.num_sites,
  p.total_pop,
  ROUND(s.num_sites / p.total_pop * 1000, 4) AS sites_per_1000
FROM pop AS p
LEFT JOIN sites AS s
  USING (county_name)
ORDER BY sites_per_1000 DESC;
