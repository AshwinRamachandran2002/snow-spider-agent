```sql
--Description: Combine vaccination-site counts with 2018 5-year ACS population to
--compute sites per 1 000 people for each California county.
--We join 5-year population (for accuracy) to 1-year names (to obtain `name` values).
WITH pop AS (
  SELECT p.geo_id, p.total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr` AS p
  WHERE p.geo_id LIKE '06%'
),
names AS (
  SELECT geo_id, name
  FROM `bigquery-public-data.census_bureau_acs.county_2018_1yr`
  WHERE LOWER(name) LIKE '%, california'
),
sites AS (
  SELECT
    facility_sub_region_2  AS county_name,
    COUNT(DISTINCT facility_provider_id) AS num_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_drive`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
)
SELECT
  n.name                          AS county_name,
  s.num_sites,
  p.total_pop,
  ROUND(s.num_sites / p.total_pop * 1000, 4) AS sites_per_1000
FROM pop  AS p
JOIN names AS n USING (geo_id)
JOIN sites AS s  ON LOWER(n.name) LIKE CONCAT(LOWER(s.county_name), '%')
ORDER BY sites_per_1000 DESC
LIMIT 20;
```

```sql
--Description: List any vaccination-table county names that failed to find a match
