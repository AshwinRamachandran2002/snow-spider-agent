-- 1. Peek at the 2018 five-year ACS county table to see what columns are available
SELECT * 
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
LIMIT 20;
```

```sql
-- 2. Which rows in that table are California counties?  
-- The county “name” field normally ends with “, California”.
SELECT name, total_pop
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE LOWER(name) LIKE '%, california'
LIMIT 20;
```

```sql
-- 3. Confirm we really have one line per California county
SELECT COUNT(*) AS ca_counties
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE LOWER(name) LIKE '%, california';
```

```sql
-- 4. Inspect the vaccination-site table that includes a stable id (drive-time polygons)
SELECT facility_provider_id, facility_name, facility_sub_region_1, facility_sub_region_2
FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_drive`
WHERE facility_sub_region_1 = 'California'
LIMIT 20;
```

```sql
-- 5. How many distinct vaccination sites are reported for each California county?
SELECT 
  facility_sub_region_2            AS county_name,
  COUNT(DISTINCT facility_provider_id) AS num_sites
FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_drive`
WHERE facility_sub_region_1 = 'California'
GROUP BY county_name
ORDER BY num_sites DESC
LIMIT 20;
```

```sql
-- 6. Check that county names from both tables line up (simple inner join test)
SELECT DISTINCT c.name, f.county_name
FROM (
  SELECT name
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE LOWER(name) LIKE '%, california'
) AS c
JOIN (
  SELECT DISTINCT facility_sub_region_2 AS county_name
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_drive`
  WHERE facility_sub_region_1 = 'California'
) AS f
ON LOWER(c.name) LIKE CONCAT(LOWER(f.county_name), '%')
LIMIT 20;
```

```sql
-- 7. Bring the two pieces together: vaccination-site density (sites per 1 000 people)
SELECT
  c.name                                            AS county_name,
  f.num_sites,
  c.total_pop,
  ROUND(f.num_sites / c.total_pop * 1000, 4)        AS sites_per_1000
FROM (
  SELECT name, total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE LOWER(name) LIKE '%, california'
) AS c
JOIN (
  SELECT 
    facility_sub_region_2 AS county_name,
    COUNT(DISTINCT facility_provider_id) AS num_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_drive`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
) AS f
ON LOWER(c.name) LIKE CONCAT(LOWER(f.county_name), '%')
ORDER BY sites_per_1000 DESC
LIMIT 20;
```

```sql
-- 8. If you want to double-check the match quality, list counties that failed to join
SELECT f.county_name
FROM (
  SELECT DISTINCT facility_sub_region_2 AS county_name
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_drive`
  WHERE facility_sub_region_1 = 'California'
) AS f
LEFT JOIN (
  SELECT name
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE LOWER(name) LIKE '%, california'
) AS c
ON LOWER(c.name) LIKE CONCAT(LOWER(f.county_name), '%')
WHERE c.name IS NULL
LIMIT 20;
```

```sql
-- 9. (Optional) recompute using *all* facility polygons to compare results
SELECT
  c.name                                 AS county_name,
  COUNT(DISTINCT a.facility_name)        AS all_polygons_sites,
  c.total_pop,
  ROUND(COUNT(DISTINCT a.facility_name)/c.total_pop*1000, 4) AS sites_per_1000_all
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr` AS c
JOIN `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all` AS a
  ON LOWER(c.name) LIKE CONCAT(LOWER(a.facility_sub_region_2), '%')
WHERE LOWER(c.name) LIKE '%, california'
GROUP BY county_name, c.total_pop
ORDER BY sites_per_1000_all DESC
LIMIT 20;
```

```sql
-- 10. Final tidy answer ordered alphabetically (drive table version)
SELECT
  c.name                              AS county_name,
  f.num_sites,
  c.total_pop,
  ROUND(f.num_sites / c.total_pop * 1000, 4) AS sites_per_1000
FROM (
  SELECT name, total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE LOWER(name) LIKE '%, california'
) AS c
JOIN (
  SELECT 
    facility_sub_region_2 AS county_name,
    COUNT(DISTINCT facility_provider_id) AS num_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_drive`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
) AS f
ON LOWER(c.name) LIKE CONCAT(LOWER(f.county_name), '%')
ORDER BY county_name
LIMIT 58;     -- 58 counties in California
```
