/* Vaccine-site density (sites per 1 000 residents) for each California county */
WITH ca_boundaries AS (
  -- County names and GEOIDs whose FIPS prefix “06” denotes California
  SELECT
    CONCAT(name, ' County') AS county_name,
    geoid                   AS geo_id
  FROM `bigquery-public-data.geo_us_boundaries.counties`
  WHERE geoid LIKE '06%'          -- California counties
),
pop AS (
  -- 2018 five-year ACS population for each California county
  SELECT
    cb.county_name,
    c.total_pop
  FROM ca_boundaries AS cb
  JOIN `bigquery-public-data.census_bureau_acs.county_2018_5yr` AS c
    ON c.geo_id = cb.geo_id
),
sites AS (
  -- Distinct vaccination sites per California county (all travel modes)
  SELECT
    facility_sub_region_2 AS county_name,
    COUNT(DISTINCT facility_name) AS num_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
)
SELECT
  p.county_name,
  COALESCE(s.num_sites, 0)                       AS num_sites,
  p.total_pop,
  ROUND(COALESCE(s.num_sites, 0) / p.total_pop * 1000, 4) AS sites_per_1000
FROM pop AS p
LEFT JOIN sites AS s USING (county_name)
ORDER BY sites_per_1000 DESC;
