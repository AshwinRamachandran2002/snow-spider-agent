Query:
--Description: 
--Compute the statewide density of vaccination sites using the *all-polygons*
--facility table (instead of the drive-time version).  We again bypass the need
--for county names because ACS county tables do not include them.  
--  • pop   – total 2018 five-year ACS population for California (GEOID prefix “06”).  
--  • sites – total distinct vaccination sites in the “facility_boundary_us_all” table
--            whose state is California.  
--Return the statewide totals and the number of sites per 1 000 residents.
WITH pop AS (
  SELECT SUM(total_pop) AS ca_total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
),
sites AS (
  SELECT COUNT(DISTINCT facility_name) AS ca_num_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
)
SELECT
  ca_num_sites,
  ca_total_pop,
  ROUND(ca_num_sites / ca_total_pop * 1000, 4) AS sites_per_1000
FROM pop CROSS JOIN sites
Answer:
ca_num_sites,ca_total_pop,sites_per_1000
2810,39148760.0,0.0718
