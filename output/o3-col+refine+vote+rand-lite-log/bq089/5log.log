```sql
-- Description: Compute vaccination sites per 1,000 residents (highest values first). 
WITH pop AS (
  SELECT
    TRIM(SPLIT(name, ',')[OFFSET(0)]) AS county_name,
    total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
),
sites AS (
  SELECT
    facility_sub_region_2 AS county_name,
    COUNT(*) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
)
SELECT
  p.county_name,
  p.total_pop,
  s.vaccine_sites,
  ROUND(s.vaccine_sites / p.total_pop * 1000, 4) AS sites_per_1000
FROM pop p
JOIN sites s USING (county_name)
ORDER BY sites_per_1000 DESC
LIMIT 20;
```

