Query:
--Description: Vaccination sites per 1,000 residents (highest values first);
--             uses LEFT JOIN and COALESCE to avoid null-division errors.
WITH pop AS (
  SELECT
    geo_id AS county_key,
    total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
),
sites AS (
