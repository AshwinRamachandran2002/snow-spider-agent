Query:
--Description: Combine California county population (ACS 2018 5-yr) with vaccination-site
--             counts; single-line comments ensure valid syntax.
WITH pop AS (
  SELECT
    geo_id AS county_key,
    total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
),
sites AS (
  SELECT
    facility_sub_region_2 AS county_key,
    COUNT(*) AS vaccine_sites
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_key
)
SELECT
  p.county_key,
  p.total_pop,
  COALESCE(s.vaccine_sites, 0) AS vaccine_sites
FROM pop p
LEFT JOIN sites s USING (county_key)
ORDER BY p.county_key
LIMIT 20
