```sql
/*  Distinct vaccination-site locations per 1,000 residents
    for every California county, using 2018 ACS 5-year population. */

WITH
-- 1) 2018 ACS population by California county -------------------------
ca_pop AS (
  SELECT
    LOWER(REGEXP_REPLACE(c.name, r' County$', '')) AS county_name,   -- cleaned name
    p.total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr` AS p
  JOIN `bigquery-public-data.geo_us_boundaries.counties`        AS c
        ON p.geo_id = c.geo_id                                  -- 5-digit county FIPS
  WHERE p.geo_id LIKE '06%'                                     -- State FIPS 06 = CA
),

-- 2) Distinct vaccination-site count per California county -----------
ca_sites AS (
  SELECT
    LOWER(REGEXP_REPLACE(facility_sub_region_2, r' County$', '')) AS county_name,
    COUNT(DISTINCT facility_name)                                 AS site_count
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
)

-- 3) Join population & site counts; compute sites per 1,000 residents -
SELECT
  INITCAP(p.county_name)                    AS county_name,
  s.site_count,
  p.total_pop,
  ROUND(s.site_count * 1000 / p.total_pop, 4) AS sites_per_1000
FROM ca_pop p
JOIN ca_sites s USING (county_name)
ORDER BY sites_per_1000 DESC;
```
