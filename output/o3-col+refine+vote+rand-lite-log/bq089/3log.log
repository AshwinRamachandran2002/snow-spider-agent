Query:
--Description:  
-- Corrected version of query #7.  
-- The 2018 5-year ACS county table contains no column called `name`, so we cannot parse
-- a readable county string there.  Instead, we (a) keep its existing columns (`geo_id`,
-- `total_pop`) and (b) keep the vaccination-site counts by county name.  
-- This query therefore shows the two source pieces side-by-side in separate CTEs; it no
-- longer attempts to JOIN them on a non–existent text field.

WITH
-- California county population (FIPS + population)
pop AS (
  SELECT
    geo_id   AS county_fips,
    total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'                 -- California counties
  LIMIT 20                                -- trim for inspection
),

-- Vaccination-site counts by county name
sites AS (
  SELECT
    facility_sub_region_2                 AS county_name,
    COUNT(DISTINCT facility_name)         AS site_count
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
  ORDER BY site_count DESC
  LIMIT 20                                -- trim for inspection
)

-- Simply select from each CTE so the analyst can review the outputs
SELECT * FROM pop
