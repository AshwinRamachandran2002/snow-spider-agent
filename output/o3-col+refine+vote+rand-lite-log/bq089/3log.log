```sql
/*  Number of distinct vaccination sites per 1,000 people
    for every California county (2018 ACS 5-year population).            */

WITH
----------------------------------------------------------------------
-- 1. 2018 ACS population for California counties
----------------------------------------------------------------------
ca_pop AS (
  SELECT
    p.geo_id                                               AS county_fips,
    REGEXP_REPLACE(c.name, r' County$', '')                AS county_name,
    p.total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr` AS p
  JOIN `bigquery-public-data.geo_us_boundaries.counties`        AS c
        ON p.geo_id = c.fips                                   -- exact FIPS match
  WHERE p.geo_id LIKE '06%'                                    -- state-FIPS 06 = CA
),

----------------------------------------------------------------------
-- 2. Distinct vaccination-site count per California county
----------------------------------------------------------------------
ca_sites AS (
  SELECT
    REGEXP_REPLACE(facility_sub_region_2, r' County$', '')  AS county_name,
    COUNT(DISTINCT facility_name)                           AS site_count
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county_name
)

----------------------------------------------------------------------
-- 3. Combine counts with population & compute sites per 1,000 people
----------------------------------------------------------------------
SELECT
  p.county_name,
  s.site_count,
  p.total_pop,
  ROUND( (s.site_count * 1000) / p.total_pop , 4) AS sites_per_1000_people
FROM ca_pop   AS p
JOIN ca_sites AS s
  USING (county_name)
ORDER BY sites_per_1000_people DESC;
```
