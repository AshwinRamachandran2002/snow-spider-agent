```sql
-- 1) Peek at the 2018 five-year ACS county table to see what columns are available
SELECT *
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
LIMIT 20;
```

```sql
-- 2) Pull California-only rows with the three fields we will need: geo_id, name and population
SELECT geo_id,
       name,
       total_pop
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE geo_id LIKE '06%'                         -- “06” = California FIPS prefix
LIMIT 20;
```

```sql
-- 3) Look at a few vaccination-site records that sit inside California
SELECT facility_name,
       facility_sub_region_2                    -- county label
FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
WHERE facility_sub_region_1 = 'California'
LIMIT 20;
```

```sql
-- 4) Raw count of ALL vaccination-site rows per California county
SELECT facility_sub_region_2   AS county_name,
       COUNT(*)                AS raw_site_rows
FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
WHERE facility_sub_region_1 = 'California'
GROUP BY county_name
ORDER BY raw_site_rows DESC
LIMIT 20;
```

```sql
-- 5) Count DISTINCT facility names so one store that appears several times is not over-counted
SELECT facility_sub_region_2           AS county_name,
       COUNT(DISTINCT facility_name)   AS distinct_sites
FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
WHERE facility_sub_region_1 = 'California'
GROUP BY county_name
ORDER BY distinct_sites DESC
LIMIT 20;
```

```sql
-- 6) Extract a clean “County” label (drop “County, California” prose) from the ACS name field
SELECT geo_id,
       REGEXP_EXTRACT(name, r'^(.*) County') AS county_clean,
       total_pop
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE geo_id LIKE '06%'
LIMIT 20;
```

```sql
-- 7) Join the facility counts with the population figures to verify the keys line up
WITH pop AS (
  SELECT REGEXP_EXTRACT(name, r'^(.*) County') AS county,
         total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
),
sites AS (
  SELECT facility_sub_region_2 AS county,
         COUNT(DISTINCT facility_name) AS site_count
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county
)
SELECT s.county,
       s.site_count,
       p.total_pop
FROM sites AS s
JOIN pop  AS p
ON LOWER(s.county) = LOWER(p.county)
LIMIT 20;
```

```sql
-- 8) Compute the number of vaccine sites per 1 000 residents (top 20 counties shown)
WITH pop AS (
  SELECT REGEXP_EXTRACT(name, r'^(.*) County') AS county,
         total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
),
sites AS (
  SELECT facility_sub_region_2 AS county,
         COUNT(DISTINCT facility_name) AS site_count
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county
)
SELECT p.county,
       site_count,
       total_pop,
       ROUND(site_count / (total_pop / 1000), 3) AS sites_per_1000_people
FROM pop AS p
LEFT JOIN sites USING (county)
ORDER BY sites_per_1000_people DESC
LIMIT 20;
```

```sql
-- 9) Same calculation, but sorted by population to check small-county effects
WITH pop AS (
  SELECT REGEXP_EXTRACT(name, r'^(.*) County') AS county,
         total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
),
sites AS (
  SELECT facility_sub_region_2 AS county,
         COUNT(DISTINCT facility_name) AS site_count
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county
)
SELECT p.county,
       site_count,
       total_pop,
       ROUND(site_count / (total_pop / 1000), 3) AS sites_per_1000_people
FROM pop AS p
LEFT JOIN sites USING (county)
ORDER BY total_pop DESC
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: vaccine sites per 1 000 people for every California county, alphabetically
WITH pop AS (
  SELECT REGEXP_EXTRACT(name, r'^(.*) County') AS county,
         total_pop
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE geo_id LIKE '06%'
),
sites AS (
  SELECT facility_sub_region_2 AS county,
         COUNT(DISTINCT facility_name) AS site_count
  FROM `bigquery-public-data.covid19_vaccination_access.facility_boundary_us_all`
  WHERE facility_sub_region_1 = 'California'
  GROUP BY county
)
SELECT p.county,
       site_count,
       total_pop,
       ROUND(site_count / (total_pop / 1000), 3) AS sites_per_1000_people
FROM pop AS p
LEFT JOIN sites USING (county)
ORDER BY p.county
LIMIT 20;
```
