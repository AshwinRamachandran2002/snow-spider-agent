```sql
--Description: Attach storage location (series_aws_url) and instance_size for the filtered cohort
SELECT DISTINCT m."PatientID",
       m."PatientAge",
       m."PatientSex",
       m."StudyInstanceUID",
       m."SeriesInstanceUID",
       a."series_aws_url",
       a."instance_size"
FROM IDC.IDC_V17.DICOM_METADATA  AS m
JOIN IDC.IDC_V17.DICOM_ALL       AS a
  ON m."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE m."BodyPartExamined" = 'MEDIASTINUM'
  AND REGEXP_REPLACE(m."PatientAge",'[^0-9]','') = '18'
  AND m."PatientSex" = 'M'
  AND m."StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
--Description: Compute total instance_size per SeriesInstanceUID for the cohort
SELECT m."SeriesInstanceUID",
       m."StudyInstanceUID",
       m."PatientID",
       SUM(a."instance_size") AS "total_size_bytes"
FROM IDC.IDC_V17.DICOM_METADATA  AS m
JOIN IDC.IDC_V17.DICOM_ALL       AS a
  ON m."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE m."BodyPartExamined" = 'MEDIASTINUM'
  AND REGEXP_REPLACE(m."PatientAge",'[^0-9]','') = '18'
  AND m."PatientSex" = 'M'
  AND m."StudyDate" > '2014-09-01'
GROUP BY m."SeriesInstanceUID",
         m."StudyInstanceUID",
         m."PatientID"
LIMIT 20;
```

```sql
--Description: Convert total size to MB (rounded) and include the series AWS location
SELECT sub."PatientID",
       sub."StudyInstanceUID",
       sub."SeriesInstanceUID",
       ROUND(sub."total_size_bytes" / 1000000.0, 2) AS "series_size_MB",
       a."series_aws_url"
FROM (
      SELECT m."SeriesInstanceUID",
             m."StudyInstanceUID",
             m."PatientID",
             SUM(a."instance_size") AS "total_size_bytes"
      FROM IDC.IDC_V17.DICOM_METADATA  AS m
      JOIN IDC.IDC_V17.DICOM_ALL       AS a
        ON m."SeriesInstanceUID" = a."SeriesInstanceUID"
      WHERE m."BodyPartExamined" = 'MEDIASTINUM'
        AND REGEXP_REPLACE(m."PatientAge",'[^0-9]','') = '18'
        AND m."PatientSex" = 'M'
        AND m."StudyDate" > '2014-09-01'
      GROUP BY m."SeriesInstanceUID",
               m."StudyInstanceUID",
               m."PatientID"
     ) AS sub
JOIN IDC.IDC_V17.DICOM_ALL AS a
  ON sub."SeriesInstanceUID" = a."SeriesInstanceUID"
LIMIT 20;
```

