Query:
--Description: Provide a consolidated view with patient, study, series, storage location,
--and series size (MB) for 20 arbitrary series in the dataset (no PatientAge filter).
--This confirms that data are present and shows the format of key columns before
--introducing stricter conditions.
SELECT DISTINCT m."PatientID",
       m."PatientAge",
       m."PatientSex",
       m."StudyDate",
       m."StudyInstanceUID",
       m."SeriesInstanceUID",
       a."series_aws_url",
       ROUND(SUM(a."instance_size") OVER (PARTITION BY m."SeriesInstanceUID") / 1000000.0, 2) AS "series_size_MB"
FROM IDC.IDC_V17.DICOM_METADATA AS m
JOIN IDC.IDC_V17.DICOM_ALL      AS a
  ON m."SeriesInstanceUID" = a."SeriesInstanceUID"
LIMIT 20
