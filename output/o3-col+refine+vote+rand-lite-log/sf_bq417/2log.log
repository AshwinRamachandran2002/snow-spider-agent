Query:
--Description: Count potential qualifying series in DICOM_METADATA (male, 18 years, mediastinum, post-2014-09-01)
SELECT COUNT(*) AS "candidate_series_cnt"
FROM IDC.IDC_V17.DICOM_METADATA
WHERE "BodyPartExamined" = 'MEDIASTINUM'
  AND REGEXP_REPLACE("PatientAge",'[^0-9]','') = '18'
  AND "PatientSex" = 'M'
  AND "StudyDate" > '2014-09-01';
