```sql
/*  Male patients, exactly 18 years old, MEDIASTINUM studies after 2014-09-01  */
WITH eligible_series AS (
    SELECT
        m."PatientID",
        m."StudyInstanceUID",
        m."SeriesInstanceUID",
        m."StudyDate"
    FROM IDC.IDC_V17.DICOM_METADATA AS m
    WHERE m."BodyPartExamined" = 'MEDIASTINUM'
      AND m."PatientSex"      = 'M'
      AND m."StudyDate"       > '2014-09-01'
      -- keep numeric chars only; ensure the value equals 18
      AND TRY_TO_NUMBER(REGEXP_REPLACE(m."PatientAge",'[^0-9]','')) = 18
),
series_sizes AS (
    SELECT
        e."PatientID",
        e."StudyInstanceUID",
        e."SeriesInstanceUID",
        e."StudyDate",
        MIN(a."series_aws_url")                                   AS "series_aws_url",
        ROUND(SUM(a."instance_size") / 1000000.0, 2)              AS "series_size_MB"
    FROM eligible_series              AS e
    JOIN IDC.IDC_V17.DICOM_ALL        AS a
      ON e."SeriesInstanceUID" = a."SeriesInstanceUID"
    GROUP BY
        e."PatientID",
        e."StudyInstanceUID",
        e."SeriesInstanceUID",
        e."StudyDate"
)

SELECT
    "PatientID",
    "StudyDate",
    "StudyInstanceUID",
    "SeriesInstanceUID",
    "series_aws_url",
    "series_size_MB"
FROM series_sizes
ORDER BY "series_size_MB" DESC NULLS LAST;
```
