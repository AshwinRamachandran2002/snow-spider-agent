```sql
--Description: 4) Add the study-date filter (strictly after 2014-09-01).  
SELECT "PatientID",
       "StudyInstanceUID",
       "SeriesInstanceUID",
       "StudyDate",
       "BodyPartExamined",
       "PatientAge",
       "PatientSex"
FROM IDC.IDC_V17.DICOM_PIVOT
WHERE "PatientSex" = 'M'
  AND "PatientAge" = '018Y'
  AND "BodyPartExamined" = 'MEDIASTINUM'
  AND "StudyDate" > '2014-09-01'
ORDER BY "StudyDate"
LIMIT 20;
```

```sql
--Description: 5) Join PIVOT with ALL to add storage URLs (AWS) for those same criteria.  
SELECT p."PatientID",
       p."StudyInstanceUID",
       p."SeriesInstanceUID",
       p."StudyDate",
       a."series_aws_url"
FROM IDC.IDC_V17.DICOM_PIVOT  p
JOIN IDC.IDC_V17.DICOM_ALL    a
  ON p."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE p."PatientSex" = 'M'
  AND p."PatientAge" = '018Y'
  AND p."BodyPartExamined" = 'MEDIASTINUM'
  AND p."StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
--Description: 6) Inspect instance sizes within one qualifying series to confirm byte counts.  
SELECT a."SeriesInstanceUID",
       a."instance_size"
FROM IDC.IDC_V17.DICOM_ALL a
WHERE a."SeriesInstanceUID" = (
      SELECT p."SeriesInstanceUID"
      FROM IDC.IDC_V17.DICOM_PIVOT p
      WHERE p."PatientSex" = 'M'
        AND p."PatientAge" = '018Y'
        AND p."BodyPartExamined" = 'MEDIASTINUM'
        AND p."StudyDate" > '2014-09-01'
      LIMIT 1)
LIMIT 20;
```

```sql
--Description: 7) Compute total series size (MB) for every qualified series.  
SELECT p."SeriesInstanceUID",
       ROUND(SUM(a."instance_size")/1000000, 2) AS "series_size_mb"
FROM IDC.IDC_V17.DICOM_PIVOT p
JOIN IDC.IDC_V17.DICOM_ALL   a
  ON p."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE p."PatientSex" = 'M'
  AND p."PatientAge" = '018Y'
  AND p."BodyPartExamined" = 'MEDIASTINUM'
  AND p."StudyDate" > '2014-09-01'
GROUP BY p."SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 8) Combine identification, study, series, storage URL, and computed size (MB).  
SELECT p."PatientID",
       p."StudyInstanceUID",
       p."SeriesInstanceUID",
       p."StudyDate",
       ROUND(SUM(a."instance_size")/1000000, 2) AS "series_size_mb",
       MAX(a."series_aws_url") AS "series_aws_url"
FROM IDC.IDC_V17.DICOM_PIVOT p
JOIN IDC.IDC_V17.DICOM_ALL   a
  ON p."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE p."PatientSex" = 'M'
  AND p."PatientAge" = '018Y'
  AND p."BodyPartExamined" = 'MEDIASTINUM'
  AND p."StudyDate" > '2014-09-01'
GROUP BY p."PatientID",
         p."StudyInstanceUID",
         p."SeriesInstanceUID",
         p."StudyDate"
LIMIT 20;
```

```sql
