  AND UPPER(p."BodyPartExamined") = 'MEDIASTINUM'
  AND p."StudyDate" > '2014-09-01'
GROUP BY
    p."PatientID",
    p."StudyInstanceUID",
    p."SeriesInstanceUID",
    p."StudyDate"
ORDER BY
    "series_size_mb" DESC NULLS LAST;
```
