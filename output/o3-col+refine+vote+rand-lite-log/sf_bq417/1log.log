Query:
-- 9) Description: Compute aggregated total series size (in MB) for the filtered cohort
SELECT p."SeriesInstanceUID",
       ROUND(SUM(a."instance_size") / 1000000, 2) AS "series_size_mb"
FROM IDC.IDC_V17.DICOM_PIVOT  p
JOIN IDC.IDC_V17.DICOM_ALL    a
  ON p."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE p."PatientSex" = 'M'
  AND p."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND (p."PatientAge" LIKE '18Y%' OR p."PatientAge" LIKE '018Y%')
  AND p."StudyDate" > '2014-09-01'
GROUP BY p."SeriesInstanceUID"
LIMIT 20;
