```sql
--Description:
-- Goal: return series information (patient, study, series IDs, study date, AWS series location, size in MB)
--       for 18-year-old male patients whose body part examined is exactly ‘MEDIASTINUM’ and whose study date
--       is after 2014-09-01.
-- Key steps / thinking process
--   • Identify relevant rows in IDC_V17.DICOM_PIVOT (contains PatientAge, Sex, BodyPartExamined, StudyDate).
--   • Extract numeric age safely: REGEXP_REPLACE strips non-digits; TRY_TO_NUMBER converts to number and
--     prevents errors when the field is blank or malformed.  We keep rows where the result = 18.
--   • Join to IDC_V17.DICOM_ALL on SeriesInstanceUID to obtain the series’ AWS URL and individual instance sizes.
--   • Aggregate instance_size bytes per series, convert to megabytes (÷ 1 000 000) and round to 2 decimals.
--   • GROUP BY identifiers so each output row is one unique imaging series meeting all criteria.
--   • LIMIT 20 to keep the result set concise.
SELECT
       p."PatientID",
       p."StudyInstanceUID",
       p."SeriesInstanceUID",
       p."StudyDate",
       a."series_aws_url",
       ROUND(SUM(a."instance_size") / 1000000, 2) AS "total_size_mb"
FROM   IDC.IDC_V17.DICOM_PIVOT  AS p
JOIN   IDC.IDC_V17.DICOM_ALL    AS a
       ON p."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE  p."PatientSex" = 'M'
  AND  p."BodyPartExamined" = 'MEDIASTINUM'
  AND  TRY_TO_NUMBER(REGEXP_REPLACE(p."PatientAge", '[^0-9]', '')) = 18
  AND  p."StudyDate" > '2014-09-01'
GROUP BY
       p."PatientID",
       p."StudyInstanceUID",
       p."SeriesInstanceUID",
       p."StudyDate",
       a."series_aws_url"
LIMIT 20;
```
