```sql
-- 8) Description: Bring in storage information by joining to DICOM_ALL on “SeriesInstanceUID”
SELECT p."PatientID",
       p."SeriesInstanceUID",
       p."StudyInstanceUID",
       p."StudyDate",
       p."BodyPartExamined",
       a."series_aws_url",
       a."instance_size"
FROM IDC.IDC_V17.DICOM_PIVOT  p
JOIN IDC.IDC_V17.DICOM_ALL    a
  ON p."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE p."PatientSex" = 'M'
  AND p."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND (p."PatientAge" LIKE '18Y%' OR p."PatientAge" LIKE '018Y%')
  AND p."StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
-- 9) Description: Compute aggregated total series size (in MB) for the filtered cohort
SELECT p."SeriesInstanceUID",
       ROUND(SUM(a."instance_size") / 1000000, 2) AS "series_size_mb"
FROM IDC.IDC_V17.DICOM_PIVOT  p
JOIN IDC.IDC_V17.DICOM_ALL    a
  ON p."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE p."PatientSex" = 'M'
  AND p."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND (p."PatientAge" LIKE '18Y%' OR p."PatientAge" LIKE '018Y%')
  AND p."StudyDate" > '2014-09-01'
GROUP BY p."SeriesInstanceUID"
LIMIT 20;
```

```sql
-- 10) Description: Final comprehensive query returning identification, study / series info,
--                  storage location, and total series size (MB) for 18-year-old male patients
SELECT DISTINCT
       p."PatientID",
       p."StudyInstanceUID",
       p."SeriesInstanceUID",
       p."StudyDate",
       p."BodyPartExamined",
       a."series_aws_url",
       ROUND(SUM(a."instance_size") / 1000000, 2) AS "total_size_mb"
FROM IDC.IDC_V17.DICOM_PIVOT  p
JOIN IDC.IDC_V17.DICOM_ALL    a
  ON p."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE p."PatientSex" = 'M'
  AND p."BodyPartExamined" = 'MEDIASTINUM'
  AND TO_NUMBER(REGEXP_REPLACE(p."PatientAge", '[^0-9]', '')) = 18
  AND p."StudyDate" > '2014-09-01'
GROUP BY
       p."PatientID",
       p."StudyInstanceUID",
       p."SeriesInstanceUID",
       p."StudyDate",
       p."BodyPartExamined",
       a."series_aws_url"
LIMIT 20;
```
