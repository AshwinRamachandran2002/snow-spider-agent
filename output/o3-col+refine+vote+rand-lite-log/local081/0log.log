```sql
-- 1) Distinct years present in the Orders table (to verify 1998 exists)
SELECT DISTINCT strftime('%Y', "orderdate") AS "order_year"
FROM "orders"
LIMIT 20;
```

```sql
-- 2) Sample of orders placed during 1998
SELECT *
FROM "orders"
WHERE strftime('%Y', "orderdate") = '1998'
LIMIT 20;
```

```sql
-- 3) Customers who placed at least one order in 1998
SELECT DISTINCT "customerid"
FROM "orders"
WHERE strftime('%Y', "orderdate") = '1998'
LIMIT 20;
```

```sql
-- 4) Order-detail lines (UnitPrice * Quantity, discount ignored) for 1998 orders
SELECT od."orderid",
       od."productid",
       od."unitprice",
       od."quantity",
       (od."unitprice" * od."quantity") AS "line_total"
FROM "order_details" AS od
JOIN "orders"          AS o  ON o."orderid" = od."orderid"
WHERE strftime('%Y', o."orderdate") = '1998'
LIMIT 20;
```

```sql
-- 5) Total amount each customer spent on 1998 orders (discounts excluded)
SELECT o."customerid",
       ROUND(SUM(od."unitprice" * od."quantity"), 2) AS "customer_total"
FROM "orders"         AS o
JOIN "order_details"  AS od ON od."orderid" = o."orderid"
WHERE strftime('%Y', o."orderdate") = '1998'
GROUP BY o."customerid"
LIMIT 20;
```

```sql
-- 6) Inspect spending-group thresholds
SELECT *
FROM "customergroupthreshold"
LIMIT 20;
```

```sql
-- 7) Assign each 1998 customer to the correct spending group
SELECT c98."customerid",
       c98."customer_total",
       t."groupname"
FROM (
      SELECT o."customerid",
             SUM(od."unitprice" * od."quantity") AS "customer_total"
      FROM "orders"        AS o
      JOIN "order_details" AS od ON od."orderid" = o."orderid"
      WHERE strftime('%Y', o."orderdate") = '1998'
      GROUP BY o."customerid"
     ) AS c98
JOIN "customergroupthreshold" AS t
  ON c98."customer_total" BETWEEN t."rangebottom" AND t."rangetop"
LIMIT 20;
```

```sql
-- 8) How many customers fall into each spending group for 1998 orders
SELECT grp."groupname",
       COUNT(*) AS "customers_in_group"
FROM (
      SELECT o."customerid",
             SUM(od."unitprice" * od."quantity") AS "customer_total"
      FROM "orders"        AS o
      JOIN "order_details" AS od ON od."orderid" = o."orderid"
      WHERE strftime('%Y', o."orderdate") = '1998'
      GROUP BY o."customerid"
     ) AS c98
JOIN "customergroupthreshold" AS grp
  ON c98."customer_total" BETWEEN grp."rangebottom" AND grp."rangetop"
GROUP BY grp."groupname"
LIMIT 20;
```

```sql
-- 9) Final answer: count and percentage of 1998 customers in each spending group
SELECT grp."groupname",
       COUNT(*)                            AS "customers_in_group",
       ROUND(100.0 * COUNT(*) / tot.cnt, 2) || '%' AS "percent_of_1998_customers"
FROM (
      SELECT o."customerid",
             SUM(od."unitprice" * od."quantity") AS "customer_total"
      FROM "orders"        AS o
      JOIN "order_details" AS od ON od."orderid" = o."orderid"
      WHERE strftime('%Y', o."orderdate") = '1998'
      GROUP BY o."customerid"
     ) AS c98
JOIN "customergroupthreshold" AS grp
  ON c98."customer_total" BETWEEN grp."rangebottom" AND grp."rangetop",
     (SELECT COUNT(DISTINCT o."customerid") AS cnt
      FROM "orders" AS o
      WHERE strftime('%Y', o."orderdate") = '1998') AS tot
GROUP BY grp."groupname"
LIMIT 20;
```
