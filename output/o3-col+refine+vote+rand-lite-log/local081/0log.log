Query:
-- 7) Assign each 1998 customer to the correct spending group
SELECT c98."customerid",
       c98."customer_total",
       t."groupname"
FROM (
      SELECT o."customerid",
             SUM(od."unitprice" * od."quantity") AS "customer_total"
      FROM "orders"        AS o
      JOIN "order_details" AS od ON od."orderid" = o."orderid"
      WHERE strftime('%Y', o."orderdate") = '1998'
      GROUP BY o."customerid"
     ) AS c98
JOIN "customergroupthreshold" AS t
  ON c98."customer_total" BETWEEN t."rangebottom" AND t."rangetop"
LIMIT 20;
