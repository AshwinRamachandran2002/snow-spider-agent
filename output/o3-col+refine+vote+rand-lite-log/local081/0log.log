-- 5) Total amount each customer spent on 1998 orders (discounts excluded)
SELECT o."customerid",
       ROUND(SUM(od."unitprice" * od."quantity"), 2) AS "customer_total"
FROM "orders"         AS o
JOIN "order_details"  AS od ON od."orderid" = o."orderid"
WHERE strftime('%Y', o."orderdate") = '1998'
GROUP BY o."customerid"
LIMIT 20;
