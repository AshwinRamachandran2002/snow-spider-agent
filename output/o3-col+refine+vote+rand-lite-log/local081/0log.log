Query:
-- 8) How many customers fall into each spending group for 1998 orders
SELECT grp."groupname",
       COUNT(*) AS "customers_in_group"
FROM (
      SELECT o."customerid",
             SUM(od."unitprice" * od."quantity") AS "customer_total"
      FROM "orders"        AS o
      JOIN "order_details" AS od ON od."orderid" = o."orderid"
      WHERE strftime('%Y', o."orderdate") = '1998'
      GROUP BY o."customerid"
     ) AS c98
JOIN "customergroupthreshold" AS grp
  ON c98."customer_total" BETWEEN grp."rangebottom" AND grp."rangetop"
GROUP BY grp."groupname"
LIMIT 20;
