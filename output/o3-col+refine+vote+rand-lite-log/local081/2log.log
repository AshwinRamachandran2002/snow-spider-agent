```sql
--Description: Take a look at line-item values (unit price × quantity) for 1998 orders
SELECT  o."orderid",
        o."customerid",
        d."productid",
        d."unitprice",
        d."quantity",
        d."unitprice" * d."quantity"  AS "line_total"
FROM    "orders"        AS o
JOIN    "order_details" AS d ON d."orderid" = o."orderid"
WHERE   o."orderdate" LIKE '1998-%'
LIMIT   20;
```

```sql
--Description: Aggregate total spend (ignoring discounts) per customer for 1998
SELECT  o."customerid",
        SUM(d."unitprice" * d."quantity") AS "total_spent"
FROM    "orders"        AS o
JOIN    "order_details" AS d ON d."orderid" = o."orderid"
WHERE   o."orderdate" LIKE '1998-%'
GROUP BY o."customerid"
LIMIT   20;
```

```sql
--Description: Inspect the customer-spending threshold table
SELECT *
FROM   "customergroupthreshold"
LIMIT  20;
```

```sql
--Description: Combine each 1998 customer’s spend with its company name
SELECT  c."customerid",
        cu."companyname",
        SUM(d."unitprice" * d."quantity") AS "total_spent"
FROM    "orders"        AS c
JOIN    "order_details" AS d  ON d."orderid" = c."orderid"
JOIN    "customers"     AS cu ON cu."customerid" = c."customerid"
WHERE   c."orderdate" LIKE '1998-%'
GROUP BY c."customerid", cu."companyname"
LIMIT   20;
```

```sql
--Description: Assign every 1998 customer to a spending group (Low/Medium/High)
SELECT  t."customerid",
        t."total_spent",
        g."groupname"
FROM  (
        SELECT  o."customerid",
                SUM(d."unitprice" * d."quantity") AS "total_spent"
        FROM    "orders"        AS o
        JOIN    "order_details" AS d ON d."orderid" = o."orderid"
        WHERE   o."orderdate" LIKE '1998-%'
        GROUP BY o."customerid"
      ) AS t
JOIN  "customergroupthreshold" AS g
  ON  t."total_spent" >= g."rangebottom"
  AND t."total_spent" <= g."rangetop"
LIMIT 20;
```

```sql
--Description: Count how many customers fall into each spending group
SELECT  g."groupname",
        COUNT(*) AS "customer_count"
FROM  (
        SELECT  o."customerid",
                SUM(d."unitprice" * d."quantity") AS "total_spent"
        FROM    "orders"        AS o
        JOIN    "order_details" AS d ON d."orderid" = o."orderid"
        WHERE   o."orderdate" LIKE '1998-%'
        GROUP BY o."customerid"
      ) AS t
JOIN  "customergroupthreshold" AS g
  ON  t."total_spent" >= g."rangebottom"
  AND t."total_spent" <= g."rangetop"
GROUP BY g."groupname"
LIMIT 20;
```

```sql
--Description: Get the total number of customers who placed orders in 1998
SELECT COUNT(DISTINCT "customerid") AS "total_1998_customers"
FROM   "orders"
WHERE  "orderdate" LIKE '1998-%'
LIMIT  20;
```

```sql
--Description: FINAL ANSWER – customers per group and their share of all 1998 customers
WITH "customer_spend" AS (
     SELECT  o."customerid",
             SUM(d."unitprice" * d."quantity") AS "total_spent"
     FROM    "orders"        AS o
     JOIN    "order_details" AS d ON d."orderid" = o."orderid"
     WHERE   o."orderdate" LIKE '1998-%'
     GROUP BY o."customerid"
),
"grouped" AS (
     SELECT  cs."customerid",
             cs."total_spent",
             cg."groupname"
     FROM    "customer_spend"        AS cs
     JOIN    "customergroupthreshold" AS cg
       ON    cs."total_spent" >= cg."rangebottom"
       AND   cs."total_spent" <= cg."rangetop"
)
SELECT  "groupname",
        COUNT(*)                                     AS "customer_count",
        ROUND(100.0 * COUNT(*) / (SELECT COUNT(*) FROM "grouped"), 2)
                                                   AS "percentage_of_total"
FROM    "grouped"
GROUP BY "groupname"
ORDER BY "customer_count" DESC
LIMIT   20;
```
