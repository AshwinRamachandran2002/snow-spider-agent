Query:
-- 9) Count customers per spending group and calculate percentage of 1998 customers
WITH cust1998 AS (
      SELECT o.customerid,
             SUM(od.unitprice * od.quantity) AS customer_total
      FROM orders AS o
      JOIN order_details AS od
             ON o.orderid = od.orderid
      WHERE o.orderdate LIKE '1998%'
      GROUP BY o.customerid
), grouped AS (
      SELECT ct.groupname
      FROM cust1998 AS c98
      JOIN customergroupthreshold AS ct
           ON c98.customer_total BETWEEN ct.rangebottom AND ct.rangetop
)
SELECT g.groupname,
       COUNT(*) AS customer_count,
       ROUND(100.0 * COUNT(*) / (SELECT COUNT(*) FROM cust1998), 2) AS percentage_of_total
FROM grouped AS g
GROUP BY g.groupname
LIMIT 20;
