```sql
-- 5) Total amount per order (sum of lines) for 1998
SELECT od.orderid,
       SUM(od.unitprice * od.quantity) AS order_total
FROM order_details AS od
JOIN orders AS o
     ON o.orderid = od.orderid
WHERE o.orderdate LIKE '1998%'
GROUP BY od.orderid
LIMIT 20;
```

```sql
-- 6) Aggregate to customer level: total spending in 1998
SELECT o.customerid,
       SUM(od.unitprice * od.quantity) AS customer_total
FROM orders AS o
JOIN order_details AS od
     ON o.orderid = od.orderid
WHERE o.orderdate LIKE '1998%'
GROUP BY o.customerid
ORDER BY customer_total DESC
LIMIT 20;
```

```sql
-- 7) Display the threshold table that defines the spending groups
SELECT DISTINCT *
FROM customergroupthreshold
LIMIT 20;
```

```sql
-- 8) Assign each 1998 customer to a spending group (Low/Medium/High)
SELECT c.customerid,
       ct.groupname,
       cust_spend.customer_total
FROM (
        SELECT o.customerid,
               SUM(od.unitprice * od.quantity) AS customer_total
        FROM orders AS o
        JOIN order_details AS od
             ON o.orderid = od.orderid
        WHERE o.orderdate LIKE '1998%'
        GROUP BY o.customerid
     ) AS cust_spend
JOIN customergroupthreshold AS ct
     ON cust_spend.customer_total BETWEEN ct.rangebottom AND ct.rangetop
JOIN customers AS c
     ON c.customerid = cust_spend.customerid
LIMIT 20;
```

```sql
-- 9) Count customers per spending group and calculate percentage of 1998 customers
WITH cust1998 AS (
      SELECT o.customerid,
             SUM(od.unitprice * od.quantity) AS customer_total
      FROM orders AS o
      JOIN order_details AS od
             ON o.orderid = od.orderid
      WHERE o.orderdate LIKE '1998%'
      GROUP BY o.customerid
), grouped AS (
      SELECT ct.groupname
      FROM cust1998 AS c98
      JOIN customergroupthreshold AS ct
           ON c98.customer_total BETWEEN ct.rangebottom AND ct.rangetop
)
SELECT g.groupname,
       COUNT(*) AS customer_count,
       ROUND(100.0 * COUNT(*) / (SELECT COUNT(*) FROM cust1998), 2) AS percentage_of_total
FROM grouped AS g
GROUP BY g.groupname
LIMIT 20;
```
