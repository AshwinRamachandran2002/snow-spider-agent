Query:
--Description: 3) List the distinct engaged sessions (session_engaged = '1')
--   for a single day (1-Dec-2020).  One row = one engaged session.
SELECT DISTINCT
  user_pseudo_id,
  (SELECT ep.value.int_value FROM UNNEST(event_params) ep WHERE ep.key = 'ga_session_id') AS ga_session_id
FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
WHERE (SELECT ep.value.string_value
       FROM UNNEST(event_params) ep
       WHERE ep.key = 'session_engaged') = '1'
LIMIT 20;
