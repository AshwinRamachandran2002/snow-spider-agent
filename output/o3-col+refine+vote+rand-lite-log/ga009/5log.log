Query:
--Description: 4) Count how many engaged sessions each user had on 1-Dec-2020.
SELECT
  user_pseudo_id,
  COUNT(DISTINCT (SELECT ep.value.int_value
                  FROM UNNEST(event_params) ep
                  WHERE ep.key = 'ga_session_id')) AS engaged_sessions
FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
WHERE (SELECT ep.value.string_value
       FROM UNNEST(event_params) ep
       WHERE ep.key = 'session_engaged') = '1'
GROUP BY user_pseudo_id
LIMIT 20;
