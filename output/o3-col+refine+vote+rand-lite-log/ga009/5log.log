--Description: 2) Inspect both “session_engaged” and “ga_session_id” side-by-side
--   for a handful of events on 1-Dec-2020.
SELECT
  user_pseudo_id,
  (SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'session_engaged')  AS session_engaged,
  (SELECT ep.value.int_value    FROM UNNEST(event_params) ep WHERE ep.key = 'ga_session_id')   AS ga_session_id,
  event_name
FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
LIMIT 20;
