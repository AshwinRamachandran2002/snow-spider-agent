Query:
-- 6. Count engaged sessions per user during December-2020
SELECT
  user_pseudo_id,
  COUNT(DISTINCT CONCAT(user_pseudo_id, '-', CAST(ga_session_id AS STRING))) AS engaged_sessions
FROM (
  SELECT
    user_pseudo_id,
