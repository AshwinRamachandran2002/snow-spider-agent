```sql
--Description: We want to know for legislator B000944 whether he is still in office
--on each December-31 of the first twenty years after his very first recorded start date.
--Steps inside one WITH clause:
-- 1) seq CTE builds integers 0‒19 via WITH RECURSIVE.
-- 2) first_term CTE grabs the legislator’s earliest “term_start”.
-- 3) dec31 CTE cross-joins the two to create twenty check-dates, each offset n years.
-- 4) Final SELECT: for every offset n, test (EXISTS) if any of that legislator’s
--    terms surrounds the Dec-31 date; return 1 if so, 0 otherwise.
WITH RECURSIVE seq(n) AS (
        SELECT 0
        UNION ALL
        SELECT n + 1 FROM seq WHERE n < 19
),
first_term AS (
        SELECT "id_bioguide",
               MIN(DATE("term_start")) AS first_start
        FROM   "legislators_terms"
        WHERE  "id_bioguide" = 'B000944'
),
dec31 AS (
        SELECT f."id_bioguide",
               s.n,
               (CAST(STRFTIME('%Y', f.first_start) AS INT) + s.n) || '-12-31' AS check_date
        FROM   first_term f
        CROSS JOIN seq s
)
SELECT d.n AS years_after_start,
       d.check_date,
       CASE
           WHEN EXISTS (
                 SELECT 1
                 FROM   "legislators_terms" t
                 WHERE  t."id_bioguide" = d."id_bioguide"
                   AND  DATE(t."term_start") <= d.check_date
                   AND  DATE(t."term_end")   >= d.check_date
             )
           THEN 1 ELSE 0
       END AS still_in_office
FROM   dec31 d
ORDER  BY d.n;
```
