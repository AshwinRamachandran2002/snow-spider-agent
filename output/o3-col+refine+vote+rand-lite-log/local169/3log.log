--Description: Revised FINAL query (#10) — delivers the 20-year annual
--retention rate for all legislators whose first term began between
--1917-01-01 and 1999-12-31.  The WITH RECURSIVE header now appears once
--at the very start, producing the year-offset sequence (seq) before all
--other CTEs, which fixes the prior syntax issue.
WITH RECURSIVE seq(n) AS (
    SELECT 0
    UNION ALL
    SELECT n + 1 FROM seq WHERE n < 19
),
first_terms AS (
    SELECT "id_bioguide",
           MIN(DATE("term_start")) AS first_start
    FROM   "legislators_terms"
    GROUP  BY "id_bioguide"
),
cohort AS (
    SELECT *
    FROM   first_terms
    WHERE  first_start BETWEEN '1917-01-01' AND '1999-12-31'
),
cohort_size AS (
    SELECT COUNT(*) AS total FROM cohort
),
dec31 AS (
    SELECT c."id_bioguide",
           s.n,
           (CAST(STRFTIME('%Y', c.first_start) AS INT) + s.n) || '-12-31' AS dec_date
    FROM   cohort c
    CROSS JOIN seq s
),
active AS (
    SELECT d.n,
           d."id_bioguide"
    FROM   dec31 d
    JOIN   "legislators_terms" t
      ON   t."id_bioguide" = d."id_bioguide"
     AND   DATE(t."term_start") <= d.dec_date
     AND   DATE(t."term_end")   >= d.dec_date
),
by_year AS (
    SELECT n,
           COUNT(DISTINCT "id_bioguide") AS retained
    FROM   active
    GROUP  BY n
)
SELECT s.n                       AS years_after_start,
       COALESCE(b.retained, 0)   AS retained_count,
       ROUND(
           COALESCE(b.retained, 0) * 1.0 / cs.total, 4
       )                         AS retention_rate
FROM   seq            AS s
CROSS JOIN cohort_size AS cs
LEFT  JOIN by_year    AS b  ON b.n = s.n
ORDER  BY s.n
