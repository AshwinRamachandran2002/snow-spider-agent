```sql
-- 8) For a sample legislator, test whether he/she was still
--    in office on 20 successive Dec-31 dates after first term began
WITH first_term AS (
    SELECT "id_bioguide",
           MIN(DATE("term_start")) AS first_start
    FROM   "legislators_terms"
    WHERE  "id_bioguide" = 'B000944'      -- sample id
)
, RECURSIVE seq(n) AS (
    SELECT 0 UNION ALL SELECT n+1 FROM seq WHERE n < 19
)
, dec31 AS (
    SELECT f."id_bioguide",
           n,
           (CAST(STRFTIME('%Y', f.first_start) AS INT) + n) || '-12-31' AS dec_date
    FROM   first_term f, seq
)
SELECT d.n,
       d.dec_date,
       CASE
           WHEN EXISTS (
               SELECT 1
               FROM   "legislators_terms" t
               WHERE  t."id_bioguide" = d."id_bioguide"
                 AND  DATE(t."term_start") <= d.dec_date
                 AND  DATE(t."term_end")   >= d.dec_date
           )
           THEN 1 ELSE 0
       END AS still_in_office
FROM   dec31 d
ORDER  BY d.n
LIMIT 20;
```

```sql
-- 9) Size of the cohort and how many are still in office, year-by-year
WITH first_terms AS (
    SELECT "id_bioguide",
           MIN(DATE("term_start")) AS first_start
    FROM   "legislators_terms"
    GROUP  BY "id_bioguide"
)
, cohort AS (
    SELECT *
    FROM   first_terms
    WHERE  first_start BETWEEN '1917-01-01' AND '1999-12-31'
)
, RECURSIVE seq(n) AS (
    SELECT 0 UNION ALL SELECT n+1 FROM seq WHERE n < 19
)
, dec31 AS (
    SELECT c."id_bioguide",
           c.first_start,
           n,
           (CAST(STRFTIME('%Y', c.first_start) AS INT) + n) || '-12-31' AS dec_date
    FROM   cohort c
    CROSS JOIN seq
)
, active AS (
    SELECT d.n,
           d."id_bioguide"
    FROM   dec31 d
    JOIN   "legislators_terms" t
           ON  t."id_bioguide" = d."id_bioguide"
          AND DATE(t."term_start") <= d.dec_date
          AND DATE(t."term_end")   >= d.dec_date
)
SELECT a.n AS years_after_start,
       COUNT(DISTINCT a."id_bioguide") AS retained_members
FROM   active a
GROUP  BY a.n
ORDER  BY a.n
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: 20-year annual retention rate for the 1917-1999 cohort
WITH first_terms AS (
    -- Earliest recorded start date for every legislator
    SELECT "id_bioguide",
           MIN(DATE("term_start")) AS first_start
    FROM   "legislators_terms"
    GROUP  BY "id_bioguide"
)
, cohort AS (
    -- Keep only those whose first term started 1917-01-01 … 1999-12-31
    SELECT *
    FROM   first_terms
    WHERE  first_start BETWEEN '1917-01-01' AND '1999-12-31'
)
, cohort_size AS (
    SELECT COUNT(*) AS total FROM cohort
)
, RECURSIVE seq(n) AS (
    -- Generate integers 0 … 19 (years after initial start)
    SELECT 0
    UNION ALL
    SELECT n+1 FROM seq WHERE n < 19
)
, dec31 AS (
    -- Build a Dec-31 date for each cohort member & each offset year
    SELECT c."id_bioguide",
           n,
           (CAST(STRFTIME('%Y', c.first_start) AS INT) + n) || '-12-31' AS dec_date
    FROM   cohort c
    CROSS JOIN seq
)
, active AS (
    -- Legislator is “active” if any term covers that Dec-31 date
    SELECT d.n,
           d."id_bioguide"
    FROM   dec31 d
    JOIN   "legislators_terms" t
           ON  t."id_bioguide" = d."id_bioguide"
          AND DATE(t."term_start") <= d.dec_date
          AND DATE(t."term_end")   >= d.dec_date
)
, by_year AS (
    -- Count of retained legislators for each offset year
    SELECT n,
           COUNT(DISTINCT "id_bioguide") AS retained
    FROM   active
    GROUP  BY n
)
-- Return 20 periods (0-19) even if 0 retained
SELECT s.n                   AS years_after_start,
       COALESCE(b.retained, 0) AS retained_count,
       ROUND(
            COALESCE(b.retained, 0) * 1.0 / cs.total, 4
       )                     AS retention_rate
FROM   seq        AS s
CROSS JOIN cohort_size AS cs
LEFT  JOIN by_year AS b  ON b.n = s.n
ORDER BY s.n;
```

The final query:

• Builds the cohort (first-term starts 1917-1999).  
• Generates 0-19 “years-after-start.”  
• Tests, for every Dec-31 date, whether the legislator was still in office.  
• Counts how many remain each year and divides by the cohort size to produce the annual retention rate. All 20 periods are returned in sequence, even if a year has zero retained members.
