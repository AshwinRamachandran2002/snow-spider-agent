--clause now creates the integer series (seq) before the other CTEs,
--avoiding the earlier syntax error.
WITH RECURSIVE seq(n) AS (
    SELECT 0
    UNION ALL
    SELECT n + 1 FROM seq WHERE n < 19
),
first_terms AS (
    SELECT "id_bioguide",
           MIN(DATE("term_start")) AS first_start
    FROM   "legislators_terms"
    GROUP  BY "id_bioguide"
),
cohort AS (
    SELECT *
    FROM   first_terms
    WHERE  first_start BETWEEN '1917-01-01' AND '1999-12-31'
),
dec31 AS (
    SELECT c."id_bioguide",
           c.first_start,
           s.n,
           (CAST(STRFTIME('%Y', c.first_start) AS INT) + s.n) || '-12-31' AS dec_date
    FROM   cohort c
    CROSS JOIN seq s
),
active AS (
    SELECT d.n,
           d."id_bioguide"
    FROM   dec31 d
    JOIN   "legislators_terms" t
      ON   t."id_bioguide" = d."id_bioguide"
     AND   DATE(t."term_start") <= d.dec_date
     AND   DATE(t."term_end")   >= d.dec_date
)
SELECT a.n AS years_after_start,
       COUNT(DISTINCT a."id_bioguide") AS retained_members
FROM   active a
GROUP  BY a.n
ORDER  BY a.n
LIMIT 20
