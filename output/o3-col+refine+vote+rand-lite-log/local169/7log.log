```sql
--Description: 8) Compute the retention rate for each of the first 20 years after a legislator’s initial start date
WITH cohort AS (
  SELECT lt."id_bioguide",
         MIN(date(lt."term_start")) AS first_start
  FROM "legislators_terms" AS lt
  GROUP BY lt."id_bioguide"
  HAVING first_start BETWEEN '1917-01-01' AND '1999-12-31'
),
calendar AS (           -- 0 through 19 years after entry
  SELECT 0 AS yr UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL
  SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL
  SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL
  SELECT 9 UNION ALL SELECT 10 UNION ALL SELECT 11 UNION ALL
  SELECT 12 UNION ALL SELECT 13 UNION ALL SELECT 14 UNION ALL
  SELECT 15 UNION ALL SELECT 16 UNION ALL SELECT 17 UNION ALL
  SELECT 18 UNION ALL SELECT 19
),
still_in_office_dates AS (   -- build (legislator, check-date) pairs
  SELECT c."id_bioguide",
         cal.yr,
         date(strftime('%Y', c.first_start) + cal.yr || '-12-31') AS check_date
  FROM cohort AS c
  CROSS JOIN calendar AS cal
),
active AS (                  -- which legislators are active on each check date
  SELECT s.yr,
         COUNT(DISTINCT s."id_bioguide") AS active_cnt
  FROM still_in_office_dates AS s
  JOIN "legislators_terms"  AS lt
    ON lt."id_bioguide" = s."id_bioguide"
   AND date(lt."term_start") <= s.check_date
   AND date(lt."term_end")   >= s.check_date
  GROUP BY s.yr
),
tot AS (                     -- size of cohort
  SELECT COUNT(*) AS cohort_total FROM cohort
)
SELECT a.yr                  AS years_since_first_term,
       ROUND(1.0 * a.active_cnt / t.cohort_total, 4) AS retention_rate
FROM active AS a
CROSS JOIN tot AS t
ORDER BY a.yr
LIMIT 20;
```
