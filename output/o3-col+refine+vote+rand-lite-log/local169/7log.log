```sql
--Description:  Compute retention rate (yrs 0-19) for legislators whose first term started
--              1917-01-01 – 1999-12-31.  Steps:
--              1) cohort      – first term_start per legislator within window
--              2) calendar    – literal list 0-19 (years since entry)
--              3) check_dates – build 31-Dec check-date for each (legislator,yr)
--              4) active      – legislators whose any term covers that check-date
--              5) cohort_size – total cohort count
--              6) Final       – left-join calendar→active so all yrs appear; compute rate
WITH cohort AS (
    SELECT lt.id_bioguide,
           MIN(DATE(lt.term_start)) AS first_start                 -- entry date
    FROM   legislators_terms AS lt
    GROUP  BY lt.id_bioguide
    HAVING first_start BETWEEN '1917-01-01' AND '1999-12-31'
),
calendar AS (                                                     -- 0-19 literal rows
    SELECT 0 AS yr UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL
    SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9 UNION ALL
    SELECT 10 UNION ALL SELECT 11 UNION ALL SELECT 12 UNION ALL SELECT 13 UNION ALL SELECT 14 UNION ALL
    SELECT 15 UNION ALL SELECT 16 UNION ALL SELECT 17 UNION ALL SELECT 18 UNION ALL SELECT 19
),
check_dates AS (
    -- For each legislator and yr, construct 31-Dec of (first_start + yr)
    SELECT c.id_bioguide,
           cal.yr,
           DATE(STRFTIME('%Y', DATE(c.first_start,'+'||cal.yr||' years')) || '-12-31') AS check_date
    FROM   cohort  AS c
    CROSS  JOIN calendar AS cal
),
active AS (
    -- Count legislators whose term_start ≤ check_date ≤ term_end (NULL end → 9999-12-31)
    SELECT cd.yr,
           COUNT(DISTINCT cd.id_bioguide) AS active_cnt
    FROM   check_dates       AS cd
    JOIN   legislators_terms AS lt
          ON lt.id_bioguide             = cd.id_bioguide
         AND DATE(lt.term_start)        <= cd.check_date
         AND DATE(COALESCE(lt.term_end,'9999-12-31')) >= cd.check_date
    GROUP  BY cd.yr
),
cohort_size AS (SELECT COUNT(*) AS n FROM cohort)

SELECT cal.yr                                        AS years_since_first_term,
       ROUND(1.0 * COALESCE(a.active_cnt,0) / cs.n, 4) AS retention_rate
FROM   calendar     AS cal
LEFT   JOIN active  AS a  ON a.yr = cal.yr
CROSS  JOIN cohort_size cs
ORDER  BY cal.yr;
```
