          /* legislator must be in office on Dec-31 of the offset year  */
          AND date(t."term_start") <= date(c."first_start",
                                           '+'||y||' years',
                                           'start of year',
                                           '+11 months',
                                           '+30 days')   -- 31-Dec
          AND date(t."term_end")   >= date(c."first_start",
                                           '+'||y||' years',
                                           'start of year',
                                           '+11 months',
                                           '+30 days')
CROSS JOIN cohort_size cs                  -- denominator
GROUP BY y
ORDER BY y;
