                                           '+11 months',
                                           '+30 days')   -- 31-Dec
          AND date(t."term_end")   >= date(c.first_start,
                                           '+' || y || ' years',
                                           'start of year',
                                           '+11 months',
                                           '+30 days')
CROSS JOIN cohort_size cs
GROUP BY y
ORDER BY y;
```
