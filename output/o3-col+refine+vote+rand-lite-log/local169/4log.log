```sql
--3. For every legislator, find the first term-start date (one per person)
SELECT "id_bioguide",
       MIN("term_start") AS "first_start"
FROM   "legislators_terms"
GROUP  BY "id_bioguide"
LIMIT 20;
```

```sql
--4. Restrict that first-term cohort to members whose very first term
--   began between 1-Jan-1917 and 31-Dec-1999
SELECT "id_bioguide",
       MIN("term_start") AS "first_start"
FROM   "legislators_terms"
GROUP  BY "id_bioguide"
HAVING "first_start" BETWEEN '1917-01-01' AND '1999-12-31'
LIMIT 20;
```

```sql
--5. Count how many legislators are in the 1917-1999 first-term cohort
SELECT COUNT(*) AS "cohort_size"
FROM (
        SELECT "id_bioguide",
               MIN("term_start") AS "first_start"
        FROM   "legislators_terms"
        GROUP  BY "id_bioguide"
        HAVING "first_start" BETWEEN '1917-01-01' AND '1999-12-31'
     ) AS c;
```

```sql
--6. Check (for the same cohort) who was still in office on the
--   *first* December-31 following their start year (offset 0)
WITH cohort AS (
        SELECT "id_bioguide",
               MIN("term_start") AS "first_start"
        FROM   "legislators_terms"
        GROUP  BY "id_bioguide"
        HAVING "first_start" BETWEEN '1917-01-01' AND '1999-12-31'
)
SELECT DISTINCT c."id_bioguide"
FROM   cohort                    AS c
JOIN   "legislators_terms"       AS t
       ON t."id_bioguide" = c."id_bioguide"
-- evaluation date: 31-Dec in the *same* year as first_start
WHERE  date(t."term_start") <= date(c."first_start", 'start of year', '+11 months', '+30 days')
  AND  date(t."term_end")   >= date(c."first_start", 'start of year', '+11 months', '+30 days')
LIMIT 20;
```

```sql
--7. Build a list 0-20 (years after first term) with a recursive CTE
WITH RECURSIVE years(y) AS (
        SELECT 0
        UNION ALL
        SELECT y+1 FROM years WHERE y < 20
)
SELECT * FROM years;
```

```sql
--8. For one example legislator, show on which Dec-31 dates they were in office
--   (helps validate the logic to be used for everyone)
WITH one AS (
        SELECT "id_bioguide",
               MIN("term_start") AS "first_start"
        FROM   "legislators_terms"
        WHERE  "id_bioguide" = 'B000944'          -- pick Sherrod Brown
)
SELECT 0 AS "offset",
       '----' AS divider,
       '1917-01-01' AS sample            -- placeholder just to demonstrate shape
LIMIT 20;
```

```sql
--9. Compute the retained count for every offset year (0-20) for the whole cohort
WITH cohort AS (
        SELECT "id_bioguide",
               MIN("term_start") AS "first_start"
        FROM   "legislators_terms"
        GROUP  BY "id_bioguide"
        HAVING "first_start" BETWEEN '1917-01-01' AND '1999-12-31'
),
years(y) AS (
        SELECT 0
        UNION ALL
        SELECT y+1 FROM years WHERE y < 20
)
SELECT y AS "year_offset",
       COUNT(DISTINCT c."id_bioguide") AS "retained_cnt"
FROM   years
LEFT  JOIN cohort            AS c
JOIN   "legislators_terms"   AS t
      ON t."id_bioguide" = c."id_bioguide"
     AND date(t."term_start") <= date(c."first_start",
                                      '+'||y||' years',
                                      'start of year',
                                      '+11 months',
                                      '+30 days')   -- Dec-31 evaluation date
     AND date(t."term_end")   >= date(c."first_start",
                                      '+'||y||' years',
                                      'start of year',
                                      '+11 months',
                                      '+30 days')
GROUP BY y
ORDER BY y;
```

```sql
--10. Turn the retained counts into retention *rates* (percentage of cohort)
WITH cohort AS (
        SELECT "id_bioguide",
               MIN("term_start") AS "first_start"
        FROM   "legislators_terms"
        GROUP  BY "id_bioguide"
        HAVING "first_start" BETWEEN '1917-01-01' AND '1999-12-31'
),
cohort_size AS (
        SELECT COUNT(*) AS n FROM cohort
),
years(y) AS (
        SELECT 0 UNION ALL SELECT y+1 FROM years WHERE y < 20
)
SELECT  y                       AS "year_offset",
        ROUND(100.0 * COUNT(DISTINCT c."id_bioguide") / cs.n, 2) 
                                   AS "retention_rate_pct"
FROM    years
LEFT   JOIN cohort            AS c
JOIN    "legislators_terms"   AS t
       ON t."id_bioguide" = c."id_bioguide"
      AND date(t."term_start") <= date(c."first_start",
                                       '+'||y||' years',
                                       'start of year',
                                       '+11 months',
                                       '+30 days')
      AND date(t."term_end")   >= date(c."first_start",
                                       '+'||y||' years',
                                       'start of year',
                                       '+11 months',
                                       '+30 days')
CROSS  JOIN cohort_size cs
GROUP   BY y
ORDER   BY y;
```
