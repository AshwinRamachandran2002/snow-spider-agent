```

```sql
-- Description: Identify the first‐term record for each legislator
SELECT lt."id_bioguide",
       MIN(lt."term_start")      AS "first_term_start",
       MIN(lt."term_number")     AS "first_term_number"
FROM   "legislators_terms" AS lt
GROUP  BY lt."id_bioguide"
LIMIT 20;
```

```sql
-- Description: Pull the cohort that began between 1917-01-01 and 1999-12-31
SELECT lt."id_bioguide",
       MIN(lt."term_start") AS "first_term_start"
FROM   "legislators_terms" AS lt
GROUP  BY lt."id_bioguide"
HAVING DATE(MIN(lt."term_start")) BETWEEN DATE('1917-01-01') AND DATE('1999-12-31')
LIMIT 20;
```

```sql
-- Description: Count how many legislators are in that 1917-1999 first-term cohort
SELECT COUNT(*) AS "cohort_size"
FROM (
    SELECT lt."id_bioguide"
    FROM   "legislators_terms" AS lt
    GROUP  BY lt."id_bioguide"
    HAVING DATE(MIN(lt."term_start")) BETWEEN DATE('1917-01-01') AND DATE('1999-12-31')
) AS cohort;
```

```sql
-- Description: For a sample of cohort members, list every term they ever served
SELECT lt."id_bioguide",
       lt."term_number",
       lt."term_start",
       lt."term_end"
FROM   "legislators_terms" AS lt
WHERE  lt."id_bioguide" IN (
    SELECT c."id_bioguide"
    FROM (
        SELECT lt2."id_bioguide"
        FROM   "legislators_terms" AS lt2
        GROUP  BY lt2."id_bioguide"
        HAVING DATE(MIN(lt2."term_start")) BETWEEN DATE('1917-01-01') AND DATE('1999-12-31')
        LIMIT 5
    ) AS c
)
ORDER BY lt."id_bioguide", lt."term_start"
LIMIT 20;
```

```sql
-- Description: Determine the last term_end for each legislator in the cohort
SELECT lt."id_bioguide",
       MAX(lt."term_end") AS "last_term_end"
FROM   "legislators_terms" AS lt
WHERE  lt."id_bioguide" IN (
    SELECT lt2."id_bioguide"
    FROM   "legislators_terms" AS lt2
    GROUP  BY lt2."id_bioguide"
    HAVING DATE(MIN(lt2."term_start")) BETWEEN DATE('1917-01-01') AND DATE('1999-12-31')
)
GROUP  BY lt."id_bioguide"
LIMIT 20;
```

```sql
-- Description: Extract, for one example year (e.g., 1930-12-31), who was still in office then
SELECT DISTINCT lt."id_bioguide"
FROM   "legislators_terms" AS lt
WHERE  DATE('1930-12-31') BETWEEN DATE(lt."term_start") AND DATE(lt."term_end")
LIMIT 20;
```
