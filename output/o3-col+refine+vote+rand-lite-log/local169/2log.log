WHERE  "id_bioguide" = (
         SELECT "id_bioguide"
         FROM   "legislators_terms"
         WHERE  "term_start" BETWEEN '1917-01-01' AND '1999-12-31'
         LIMIT  1
       )
ORDER  BY "term_start"
LIMIT  20;
```

```sql
-- 7. Description: For the target cohort, get the last recorded "term_end" (needed to test if still in office)
SELECT DISTINCT
       lt."id_bioguide",
       MIN(lt."term_start") AS first_term_start,
       MAX(lt."term_end")   AS last_term_end
FROM   "legislators_terms" AS lt
GROUP  BY lt."id_bioguide"
HAVING first_term_start BETWEEN '1917-01-01' AND '1999-12-31'
LIMIT  20;
```

```sql
-- 8. Description: Count how many terms cross a given December-31 “checkpoint” (e.g., 5 years after start) for one checkpoint year
SELECT COUNT(*) AS still_in_office_on_1922_12_31
FROM   "legislators_terms" AS lt
WHERE  lt."term_start" <= '1922-12-31'
  AND  lt."term_end"   >  '1922-12-31'
  AND  lt."id_bioguide" IN (
         SELECT "id_bioguide"
         FROM   "legislators_terms"
         GROUP  BY "id_bioguide"
         HAVING MIN("term_start") BETWEEN '1917-01-01' AND '1917-12-31'
       );
```

```sql
-- 9. Description: Join back to legislators table to pull the human-readable names for the cohort
SELECT DISTINCT
       l."full_name",
       lt_first.first_term_start
FROM   (
        SELECT "id_bioguide", MIN("term_start") AS first_term_start
        FROM   "legislators_terms"
        GROUP  BY "id_bioguide"
        HAVING first_term_start BETWEEN '1917-01-01' AND '1999-12-31'
       ) AS lt_first
JOIN   "legislators" AS l
  ON   l."id_bioguide" = lt_first."id_bioguide"
LIMIT  20;
```

```sql
-- 10. Description: Create a year-by-year matrix (first 20 years) for one legislator to verify logic before scaling up
SELECT 
       0  AS years_after_start,
       CASE WHEN '1920-12-31' BETWEEN lt."term_start" AND lt."term_end" THEN 1 ELSE 0 END AS retained_in_year0,
       CASE WHEN '1921-12-31' BETWEEN lt."term_start" AND lt."term_end" THEN 1 ELSE 0 END AS retained_in_year1,
       CASE WHEN '1922-12-31' BETWEEN lt."term_start" AND lt."term_end" THEN 1 ELSE 0 END AS retained_in_year2
       -- …continue up to year 19 as needed…
FROM   "legislators_terms" AS lt
WHERE  lt."id_bioguide" = 'B000944'          -- example
  AND  lt."term_start" = (
        SELECT MIN("term_start") 
        FROM   "legislators_terms"
        WHERE  "id_bioguide" = 'B000944'
      )
LIMIT  20;
```
