```sql
-- 2. Description: Find the first term_start for each legislator (we'll need this to isolate the 1917-1999 cohort)
SELECT DISTINCT 
       "id_bioguide",
       MIN("term_start") AS first_term_start
FROM   "legislators_terms"
GROUP  BY "id_bioguide"
LIMIT  20;
```

```sql
-- 3. Description: Count how many legislators began their 1st term between 1917-01-01 and 1999-12-31
SELECT COUNT(*) AS cohort_size
FROM  (
