     FROM "legislators_terms"
     GROUP BY "id_bioguide"
     HAVING date(MIN("term_start")) BETWEEN date('1917-01-01') AND date('1999-12-31')
) AS cohort
ON cohort."id_bioguide" = lt."id_bioguide"
