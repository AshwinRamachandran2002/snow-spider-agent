```sql
-- 7. Description: Show how many of those cohort members were still serving on 1937-12-31 (20-year check example).
SELECT COUNT(DISTINCT lt."id_bioguide") AS "active_on_1937_12_31"
FROM "legislators_terms" AS lt
JOIN (
     SELECT "id_bioguide",
            MIN("term_start") AS "first_start"
     FROM "legislators_terms"
     GROUP BY "id_bioguide"
     HAVING date(MIN("term_start")) BETWEEN date('1917-01-01') AND date('1999-12-31')
) AS cohort
ON cohort."id_bioguide" = lt."id_bioguide"
WHERE date('1937-12-31') BETWEEN date(lt."term_start") AND date(lt."term_end");
```

