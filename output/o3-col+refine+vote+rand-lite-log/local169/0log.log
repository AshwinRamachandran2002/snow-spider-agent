```sql
-- 7) Verify, for a single chosen offset (e.g., 5th anniversary), who is still in office  
WITH cohort AS (
      SELECT "id_bioguide",
             DATE(MIN("term_start")) AS "first_start"
      FROM   "legislators_terms"
      GROUP  BY "id_bioguide"
      HAVING "first_start" BETWEEN '1917-01-01' AND '1999-12-31'
)
SELECT c."id_bioguide"
FROM   cohort AS c
JOIN   "legislators_terms" AS lt
       ON lt."id_bioguide" = c."id_bioguide"
WHERE  DATE(lt."term_start") <= DATE(c."first_start", '+5 years')
  AND  DATE(lt."term_end")   >= DATE(c."first_start", '+5 years')
LIMIT 20;
```

```sql
-- 8) Compute retained vs. total for EACH of the first 20 anniversaries  
WITH cohort AS (
      SELECT "id_bioguide",
             DATE(MIN("term_start")) AS "first_start"
      FROM   "legislators_terms"
      GROUP  BY "id_bioguide"
      HAVING "first_start" BETWEEN '1917-01-01' AND '1999-12-31'
), years AS (
      SELECT 0 AS y UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL
      SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL
      SELECT 8 UNION ALL SELECT 9 UNION ALL SELECT 10 UNION ALL SELECT 11 UNION ALL
      SELECT 12 UNION ALL SELECT 13 UNION ALL SELECT 14 UNION ALL SELECT 15 UNION ALL
      SELECT 16 UNION ALL SELECT 17 UNION ALL SELECT 18 UNION ALL SELECT 19
), stats AS (
      SELECT y.y                                  AS "year_offset",
             COUNT(DISTINCT c."id_bioguide")       AS "cohort_total",
             COUNT(DISTINCT CASE
                  WHEN lt."id_bioguide" IS NOT NULL THEN c."id_bioguide"
             END)                                 AS "retained"
      FROM years   AS y
      CROSS JOIN cohort AS c
      LEFT JOIN  "legislators_terms" AS lt
             ON  lt."id_bioguide" = c."id_bioguide"
             AND DATE(lt."term_start") <= DATE(c."first_start", '+' || y.y || ' years')
             AND DATE(lt."term_end")   >= DATE(c."first_start", '+' || y.y || ' years')
      GROUP BY y.y
)
SELECT "year_offset",
       ROUND(1.0 * "retained" / "cohort_total", 4) AS "retention_rate"
FROM   stats
ORDER  BY "year_offset";
```

```sql
-- 9) Same query as #8 but also returning rows even when no one is retained,
--    ensuring all 20 periods appear
WITH cohort AS (
      SELECT "id_bioguide",
             DATE(MIN("term_start")) AS "first_start"
      FROM   "legislators_terms"
      GROUP  BY "id_bioguide"
      HAVING "first_start" BETWEEN '1917-01-01' AND '1999-12-31'
), years AS (
      SELECT 0 AS y UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL
      SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL
      SELECT 8 UNION ALL SELECT 9 UNION ALL SELECT 10 UNION ALL SELECT 11 UNION ALL
      SELECT 12 UNION ALL SELECT 13 UNION ALL SELECT 14 UNION ALL SELECT 15 UNION ALL
      SELECT 16 UNION ALL SELECT 17 UNION ALL SELECT 18 UNION ALL SELECT 19
), stats AS (
      SELECT y.y                                  AS "year_offset",
             COUNT(DISTINCT c."id_bioguide")       AS "cohort_total",
             COUNT(DISTINCT CASE
                  WHEN lt."id_bioguide" IS NOT NULL THEN c."id_bioguide"
             END)                                 AS "retained"
      FROM years   AS y
      CROSS JOIN cohort AS c
      LEFT JOIN  "legislators_terms" AS lt
             ON  lt."id_bioguide" = c."id_bioguide"
             AND DATE(lt."term_start") <= DATE(c."first_start", '+' || y.y || ' years')
             AND DATE(lt."term_end")   >= DATE(c."first_start", '+' || y.y || ' years')
      GROUP BY y.y
)
SELECT "year_offset",
       "cohort_total",
       "retained",
       ROUND(1.0 * "retained" / "cohort_total", 4) AS "retention_rate"
FROM   stats
ORDER  BY "year_offset";
```

```sql
-- 10) Final concise answer: only offset & retention ratio for the 20 years
WITH cohort AS (
      SELECT "id_bioguide",
             DATE(MIN("term_start")) AS "first_start"
      FROM   "legislators_terms"
      GROUP  BY "id_bioguide"
      HAVING "first_start" BETWEEN '1917-01-01' AND '1999-12-31'
), years AS (
      SELECT 0 AS y UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL
      SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL
      SELECT 8 UNION ALL SELECT 9 UNION ALL SELECT 10 UNION ALL SELECT 11 UNION ALL
      SELECT 12 UNION ALL SELECT 13 UNION ALL SELECT 14 UNION ALL SELECT 15 UNION ALL
      SELECT 16 UNION ALL SELECT 17 UNION ALL SELECT 18 UNION ALL SELECT 19
), stats AS (
      SELECT y.y,
             COUNT(*)                                         AS "cohort_total",
             SUM(CASE WHEN lt."id_bioguide" IS NOT NULL THEN 1 ELSE 0 END) AS "retained"
      FROM years   AS y
      CROSS JOIN cohort AS c
      LEFT JOIN  "legislators_terms" AS lt
             ON  lt."id_bioguide" = c."id_bioguide"
             AND DATE(lt."term_start") <= DATE(c."first_start", '+' || y.y || ' years')
             AND DATE(lt."term_end")   >= DATE(c."first_start", '+' || y.y || ' years')
      GROUP BY y.y
)
SELECT y             AS "years_after_first_term",
       ROUND(1.0 * "retained" / "cohort_total", 4) AS "annual_retention_rate"
FROM   stats
ORDER  BY y;
```
