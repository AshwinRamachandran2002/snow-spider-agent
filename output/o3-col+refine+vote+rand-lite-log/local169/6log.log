```sql
--Description / thinking process:
-- Goal: compute, for legislators whose very first term began between 1917-01-01 and 1999-12-31,
--       the proportion still serving on 31-Dec of each of the first 20 years that FOLLOW that start.
-- Steps (all in one WITH-chain):
--   1. offsets        – recursively generate integers 0-19 (20 periods).
--   2. first_terms    – first term_start for every legislator.
--   3. cohort         – keep only those whose first_start is in the 1917-1999 window.
--   4. cohort_size    – total size of that cohort (denominator).
--   5. check_dates    – for every legislator & offset, build the 31-Dec “check-date”
--                       (date of 31-Dec in first_start’s year + offset years).
--   6. retained       – for each (legislator, offset) keep rows where check-date
--                       falls inside one of the person’s terms (still in office).
--   7. retention_summary – count how many legislators are retained for every offset.
--   8. Final SELECT   – divide retained_cnt by cohort_size to get the retention rate,
--                       label the periods 1-20, and return all 20 rows in order.

WITH RECURSIVE
    offsets(n) AS (                      -- 0 … 19  (20 periods)
        SELECT 0
        UNION ALL
        SELECT n + 1 FROM offsets WHERE n < 19
    ),
    first_terms AS (                     -- first start date for every legislator
        SELECT "id_bioguide",
               MIN("term_start") AS first_start
        FROM   "legislators_terms"
        GROUP BY "id_bioguide"
    ),
    cohort AS (                          -- restrict to requested window
        SELECT *
        FROM   first_terms
        WHERE  first_start BETWEEN '1917-01-01' AND '1999-12-31'
    ),
    cohort_size AS (                     -- denominator once
        SELECT COUNT(*) AS total_cnt FROM cohort
    ),
    check_dates AS (                     -- build 31-Dec check-dates
        SELECT c."id_bioguide",
               n,                                        -- 0-19
               DATE(STRFTIME('%Y', c.first_start) || '-12-31', '+' || n || ' years') AS check_date
        FROM   cohort AS c
        CROSS JOIN offsets
    ),
    retained AS (                        -- still serving on that date?
        SELECT cd."id_bioguide",
               cd.n
        FROM   check_dates cd
        JOIN   "legislators_terms" lt
          ON   lt."id_bioguide" = cd."id_bioguide"
         AND   lt."term_start"  <= cd.check_date
         AND   lt."term_end"    >= cd.check_date
        GROUP BY cd."id_bioguide", cd.n
    ),
    retention_summary AS (               -- count retained per offset
        SELECT n,
               COUNT(r."id_bioguide") AS retained_cnt
        FROM   offsets o
        LEFT JOIN retained r ON r.n = o.n
        GROUP BY n
    )
SELECT n + 1                                AS year_after_start,   -- label 1-20
       ROUND(1.0 * retained_cnt / cs.total_cnt, 4) AS retention_rate
FROM   retention_summary
CROSS JOIN cohort_size cs
ORDER  BY year_after_start;
```
