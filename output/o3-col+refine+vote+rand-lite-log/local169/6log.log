```sql
--Description: Count, for the full cohort, how many are still in office for each of the first 20 offset years
WITH first_terms AS (
    SELECT lt."id_bioguide",
           MIN(lt."term_start") AS "first_start"
    FROM   "legislators_terms" AS lt
    GROUP BY lt."id_bioguide"
),
cohort AS (
    SELECT * 
    FROM   first_terms
    WHERE  "first_start" BETWEEN '1917-01-01' AND '1999-12-31'
),
RECURSIVE offsets(n) AS (
    SELECT 1
    UNION ALL
    SELECT n+1 FROM offsets WHERE n < 20
),
check_dates AS (
    SELECT c."id_bioguide",
           n AS "offset_year",
           DATE(STRFTIME('%Y', c."first_start") || '-12-31', '+' || (n) || ' year') AS "check_date"
    FROM   cohort AS c
    CROSS JOIN offsets
),
retained AS (
    SELECT cd."id_bioguide",
           cd."offset_year"
    FROM   check_dates AS cd
    JOIN   "legislators_terms" AS lt
      ON   lt."id_bioguide" = cd."id_bioguide"
     AND   lt."term_start"  <= cd."check_date"
     AND   lt."term_end"    >= cd."check_date"
    GROUP BY cd."id_bioguide", cd."offset_year"
)
SELECT cd."offset_year",
       COUNT(r."id_bioguide") AS "retained_cnt"
FROM   check_dates AS cd
LEFT JOIN retained AS r
       ON r."id_bioguide" = cd."id_bioguide"
      AND r."offset_year" = cd."offset_year"
GROUP BY cd."offset_year"
ORDER BY cd."offset_year";
```

```sql
--Description: FINAL ANSWER – compute the annual retention rate (retained ÷ total cohort) for each of the first 20 years after entry
WITH first_terms AS (
    SELECT lt."id_bioguide",
           MIN(lt."term_start") AS "first_start"
    FROM   "legislators_terms" AS lt
    GROUP BY lt."id_bioguide"
),
cohort AS (
    SELECT * 
    FROM   first_terms
    WHERE  "first_start" BETWEEN '1917-01-01' AND '1999-12-31'
),
RECURSIVE offsets(n) AS (
    SELECT 1
    UNION ALL
    SELECT n+1 FROM offsets WHERE n < 20
),
check_dates AS (
    SELECT c."id_bioguide",
           n AS "offset_year",
           DATE(STRFTIME('%Y', c."first_start") || '-12-31', '+' || (n) || ' year') AS "check_date"
    FROM   cohort AS c
    CROSS JOIN offsets
),
retained AS (
    SELECT cd."id_bioguide",
           cd."offset_year"
    FROM   check_dates AS cd
    JOIN   "legislators_terms" AS lt
      ON   lt."id_bioguide" = cd."id_bioguide"
     AND   lt."term_start"  <= cd."check_date"
     AND   lt."term_end"    >= cd."check_date"
    GROUP BY cd."id_bioguide", cd."offset_year"
),
totals AS (
    SELECT cd."offset_year",
           COUNT(r."id_bioguide") AS "retained_cnt"
    FROM   check_dates AS cd
    LEFT JOIN retained AS r
           ON r."id_bioguide" = cd."id_bioguide"
          AND r."offset_year" = cd."offset_year"
    GROUP BY cd."offset_year"
),
cohort_size AS (
    SELECT COUNT(*) AS "total_cnt"
    FROM   cohort
)
SELECT t."offset_year"                          AS "year_after_start",
       ROUND(1.0 * t."retained_cnt" / cs."total_cnt", 4) AS "retention_rate"
FROM   totals AS t
CROSS JOIN cohort_size AS cs
ORDER BY t."offset_year";
```
