--Description: Verify, for 5 sample cohort legislators, whether they were in office on each 31-Dec
--             of the first 5 years after their initial term-start (ambiguity in “n” fixed).
WITH
first_terms AS (
    SELECT "id_bioguide",
           MIN("term_start") AS first_start
    FROM   "legislators_terms"
    GROUP BY "id_bioguide"
),
cohort AS (                               -- pick 5 examples in the 1917-1999 cohort
    SELECT *
    FROM   first_terms
    WHERE  first_start BETWEEN '1917-01-01' AND '1999-12-31'
    LIMIT 5
),
offsets(n) AS (                           -- generate 1 … 5
    SELECT 1
    UNION ALL
    SELECT n + 1 FROM offsets WHERE n < 5
),
check_dates AS (                          -- 31-Dec check-dates for each offset
    SELECT c."id_bioguide",
           o.n        AS offset_year,
