Query:
--Description: Count, for the full cohort, how many legislators are still in office on 31-Dec
--             of each of the first 20 years after their initial start (ambiguity in “n” fixed).
WITH
first_terms AS (
    SELECT "id_bioguide",
           MIN("term_start") AS first_start
    FROM   "legislators_terms"
    GROUP BY "id_bioguide"
),
cohort AS (
    SELECT *
    FROM   first_terms
    WHERE  first_start BETWEEN '1917-01-01' AND '1999-12-31'
),
offsets(n) AS (                           -- generate 1 … 20
    SELECT 1
    UNION ALL
    SELECT n + 1 FROM offsets WHERE n < 20
),
check_dates AS (
    SELECT c."id_bioguide",
           o.n AS offset_year,
           DATE(STRFTIME('%Y', c.first_start) || '-12-31', '+' || o.n || ' years') AS check_date
    FROM   cohort AS c
    CROSS JOIN offsets AS o
),
retained AS (
    SELECT cd."id_bioguide",
           cd.offset_year
    FROM   check_dates cd
    JOIN   "legislators_terms" lt
      ON   lt."id_bioguide" = cd."id_bioguide"
     AND   lt."term_start"  <= cd.check_date
     AND   lt."term_end"    >= cd.check_date
    GROUP BY cd."id_bioguide", cd.offset_year
)
SELECT cd.offset_year,
       COUNT(r."id_bioguide") AS retained_cnt
FROM   check_dates cd
LEFT JOIN retained r
       ON r."id_bioguide" = cd."id_bioguide"
      AND r.offset_year   = cd.offset_year
GROUP BY cd.offset_year
ORDER  BY cd.offset_year
