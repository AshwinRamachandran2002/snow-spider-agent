```sql
--Description: 7 (single-query with thinking process).  
--The prior failure showed that “*_name” columns are not present in the live
--`pbtype_2015` table even though they were in the documentation, so we must
--use the coded fields (`crash_location_pedestrian` and `crash_location_bicycle`)
--instead.  This query counts how many crashes each code appears in for
--Pedestrians and Bicyclists, giving a quick feel for where (intersection,
--non-intersection, etc.) these fatal crashes happened.
WITH pb AS (
  SELECT
    `person_type_name`,
    -- Pedestrians use the pedestrian-specific field; cyclists use bicycle field
    IF(`person_type_name` = 'Pedestrian',
       `crash_location_pedestrian`,
       `crash_location_bicycle`) AS crash_location_code
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.pbtype_2015`
  WHERE `person_type_name` IN ('Pedestrian', 'Bicyclist')
)
SELECT
  `person_type_name`,
  crash_location_code,
  COUNT(*) AS crashes
FROM pb
GROUP BY `person_type_name`, crash_location_code
ORDER BY `person_type_name`, crashes DESC
LIMIT 20;
```
