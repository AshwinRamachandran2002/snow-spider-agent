--Description: 1. Quick look at the most frequent lighting conditions in fatal crashes.
SELECT 
  `light_condition`,
  COUNT(*) AS crashes
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015`
GROUP BY `light_condition`
ORDER BY crashes DESC
LIMIT 20;
