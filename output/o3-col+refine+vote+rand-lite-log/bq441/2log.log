```sql
--Description: 1. Quick look at the most frequent lighting conditions in fatal crashes.
SELECT 
  `light_condition`,
  COUNT(*) AS crashes
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015`
GROUP BY `light_condition`
ORDER BY crashes DESC
LIMIT 20;
```

```sql
--Description: 2. Sample crash-level rows with pre-computed delays to scene / hospital.
SELECT 
  `consecutive_number`,
  `hour_of_crash`,
  `hour_of_arrival_at_scene`,
  CASE 
      WHEN `hour_of_arrival_at_scene` BETWEEN 0 AND 23 THEN (`hour_of_arrival_at_scene` - `hour_of_crash`)
  END AS delay_to_scene,
  `hour_of_ems_arrival_at_hospital`,
  CASE 
      WHEN `hour_of_ems_arrival_at_hospital` BETWEEN 0 AND 23 THEN (`hour_of_ems_arrival_at_hospital` - `hour_of_crash`)
  END AS delay_to_hospital,
  `type_of_intersection`,
  `light_condition`,
  `atmospheric_conditions_1`,
  `number_of_fatalities`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015`
LIMIT 20;
```

```sql
--Description: 3. Person details – derive “survived” flag and a numeric “restraint” score.
SELECT DISTINCT
  `consecutive_number`,
  `age`,
  `person_type`,
  `injury_severity`,
  CASE WHEN `injury_severity` = 4 THEN 1 ELSE 0 END AS survived,
  `restraint_system_helmet_use`,
  CASE 
      WHEN `restraint_system_helmet_use` = 0 THEN 0
      WHEN `restraint_system_helmet_use` = 1 THEN 0.33
      WHEN `restraint_system_helmet_use` = 2 THEN 0.67
      WHEN `restraint_system_helmet_use` = 3 THEN 1.0
      ELSE 0.5
  END AS restraint_score,
  `police_reported_alcohol_involvement` AS alcohol_text,
  CASE WHEN LOWER(`police_reported_alcohol_involvement`) LIKE '%yes%' THEN 1 ELSE 0 END AS alcohol
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
LIMIT 20;
```

```sql
--Description: 4. Vehicle-level snapshot with capped/coded harm-related fields and speeding flag.
SELECT 
  `consecutive_number`,
  `hour_of_crash`,
  `body_type`,
  `travel_speed`,
  `speeding_related`,
  CASE WHEN LOWER(`speeding_related`) LIKE '%yes%' THEN 1 ELSE 0 END AS speeding_flag,
  `rollover`,
  CASE WHEN `first_harmful_event` < 90 THEN `first_harmful_event` ELSE 0 END AS first_harmful_event_norm,
  CASE WHEN `most_harmful_event` < 90 THEN `most_harmful_event` ELSE 0 END AS most_harmful_event_norm,
  CASE WHEN CAST(`manner_of_collision` AS INT64) > 11 THEN 11 ELSE `manner_of_collision` END AS manner_of_collision_capped
FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`
LIMIT 20;
```

```sql
--Description: 5. Distinct vehicle body types present in 2015 fatal crashes.
SELECT DISTINCT
  `body_type`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`
LIMIT 20;
```

```sql
--Description: 6. Join crashes & vehicles to list crashes that involved at least one rollover vehicle.
SELECT DISTINCT
  a.`consecutive_number`,
  a.`hour_of_crash`,
  v.`rollover`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015`  AS a
JOIN `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`    AS v
ON  a.`consecutive_number` = v.`consecutive_number`
WHERE v.`rollover` <> 'No Rollover'
LIMIT 20;
```

```sql
--Description: 7. Pedestrian & bicyclist crash type examples from PBTYPE table.
SELECT 
  `consecutive_number`,
  `person_type_name`,
  `crash_type_pedestrian_name`,
  `crash_type_bicycle_name`,
  `crash_location_pedestrian_name`,
  `crash_location_bicycle_name`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.pbtype_2015`
LIMIT 20;
```

```sql
--Description: 8. Events data – sample rollover/overturn events at vehicle-event level.
SELECT 
  `consecutive_number`,
  `vehicle_number`,
  `vehicle_event_number`,
  `sequence_of_events_name`,
  `area_of_Impact_associated_with_the_event_name`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.vsoe_2015`
WHERE `sequence_of_events_name` = 'Rollover/Overturn'
LIMIT 20;
```

```sql
--Description: 9. Sample of non-motorist impairment conditions reported by officers.
SELECT DISTINCT
  `consecutive_number`,
  `condition_impairment_at_time_of_crash_non_motorist_name`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.nmimpair_2015`
LIMIT 20;
```

```sql
--Description: 10. Non-motorist contributing circumstances observed at crash level.
SELECT 
  `consecutive_number`,
  `non_motorist_contributing_circumstances`,
  `non_motorist_contributing_circumstances_name`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.nmcrash_2015`
LIMIT 20;
```
