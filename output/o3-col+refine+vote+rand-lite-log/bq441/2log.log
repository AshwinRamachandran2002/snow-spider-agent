Query:
--Description: 3. Person details – derive “survived” flag and a numeric “restraint” score.
SELECT DISTINCT
  `consecutive_number`,
  `age`,
  `person_type`,
  `injury_severity`,
  CASE WHEN `injury_severity` = 4 THEN 1 ELSE 0 END AS survived,
  `restraint_system_helmet_use`,
  CASE 
      WHEN `restraint_system_helmet_use` = 0 THEN 0
      WHEN `restraint_system_helmet_use` = 1 THEN 0.33
      WHEN `restraint_system_helmet_use` = 2 THEN 0.67
      WHEN `restraint_system_helmet_use` = 3 THEN 1.0
      ELSE 0.5
  END AS restraint_score,
  `police_reported_alcohol_involvement` AS alcohol_text,
  CASE WHEN LOWER(`police_reported_alcohol_involvement`) LIKE '%yes%' THEN 1 ELSE 0 END AS alcohol
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
LIMIT 20;
Answer:
consecutive_number,age,person_type,injury_severity,survived,restraint_system_helmet_use,restraint_score,alcohol_text,alcohol
