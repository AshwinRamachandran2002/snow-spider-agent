Query:
--Description: 4. Vehicle-level snapshot with capped/coded harm-related fields and speeding flag.
SELECT 
  `consecutive_number`,
  `hour_of_crash`,
  `body_type`,
  `travel_speed`,
  `speeding_related`,
  CASE WHEN LOWER(`speeding_related`) LIKE '%yes%' THEN 1 ELSE 0 END AS speeding_flag,
  `rollover`,
  CASE WHEN `first_harmful_event` < 90 THEN `first_harmful_event` ELSE 0 END AS first_harmful_event_norm,
  CASE WHEN `most_harmful_event` < 90 THEN `most_harmful_event` ELSE 0 END AS most_harmful_event_norm,
  CASE WHEN CAST(`manner_of_collision` AS INT64) > 11 THEN 11 ELSE `manner_of_collision` END AS manner_of_collision_capped
FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`
LIMIT 20;
