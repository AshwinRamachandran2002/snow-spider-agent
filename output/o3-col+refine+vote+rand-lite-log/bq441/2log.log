Query:
--Description: 2. Sample crash-level rows with pre-computed delays to scene / hospital.
SELECT 
  `consecutive_number`,
  `hour_of_crash`,
  `hour_of_arrival_at_scene`,
  CASE 
      WHEN `hour_of_arrival_at_scene` BETWEEN 0 AND 23 THEN (`hour_of_arrival_at_scene` - `hour_of_crash`)
  END AS delay_to_scene,
  `hour_of_ems_arrival_at_hospital`,
  CASE 
      WHEN `hour_of_ems_arrival_at_hospital` BETWEEN 0 AND 23 THEN (`hour_of_ems_arrival_at_hospital` - `hour_of_crash`)
  END AS delay_to_hospital,
  `type_of_intersection`,
  `light_condition`,
  `atmospheric_conditions_1`,
  `number_of_fatalities`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015`
LIMIT 20;
