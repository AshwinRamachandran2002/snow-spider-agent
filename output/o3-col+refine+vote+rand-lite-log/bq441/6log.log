Query:
--Description: 6) Join accident & vehicle tables to relate crash context with speeding vehicles.
SELECT
  a.`consecutive_number`,
  a.`hour_of_crash`,
  a.`light_condition`,
  v.`body_type`,
  v.`travel_speed`,
  CASE WHEN LOWER(v.`speeding_related`) LIKE '%yes%' THEN 1 ELSE 0 END AS speeding_flag
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS a
JOIN `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`   AS v
USING (`consecutive_number`)
WHERE v.`travel_speed` <> 998          -- exclude “Not Reported”
LIMIT 20;
