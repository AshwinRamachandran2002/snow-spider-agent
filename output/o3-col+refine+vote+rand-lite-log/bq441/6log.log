--Description (thinking process inline):
-- 1. Goal: view non-motorist crash location information together with any noted impairments.
-- 2. Table `pbtype_2015` stores non-motorist records.  After the earlier error I confirmed
--    that the columns ending in “_name” are NOT present; the numeric code fields ARE present.
--    Therefore, use:
--         • crash_location_pedestrian   (for pedestrians)
--         • crash_location_bicycle      (for bicyclists)
-- 3. Table `nmimpair_2015` contains impairment codes/descriptions and shares the key
--    `consecutive_number`, so a LEFT JOIN will append impairment info when available.
-- 4. Select a concise set of columns and LIMIT 20 for a quick sanity check.
SELECT
  pb.`consecutive_number`,
  pb.`person_type_name`,
  pb.`crash_location_pedestrian` AS crash_location_ped_code,
  pb.`crash_location_bicycle`   AS crash_location_bike_code,
  ni.`condition_impairment_at_time_of_crash_non_motorist_name`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.pbtype_2015` AS pb
LEFT JOIN `bigquery-public-data.nhtsa_traffic_fatalities.nmimpair_2015` AS ni
USING (`consecutive_number`)
LIMIT 20;
```
