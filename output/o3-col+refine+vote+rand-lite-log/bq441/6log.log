Query:
--Description: 8) Vehicles that struck pedestrians (sequence_of_events = 8) along with impact area.
SELECT
  `consecutive_number`,
  `vehicle_number`,
  `vehicle_event_number`,
  `sequence_of_events_name`,
  `area_of_Impact_associated_with_the_event_name`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.vsoe_2015`
WHERE `sequence_of_events` = 8         -- Pedestrian
LIMIT 20
