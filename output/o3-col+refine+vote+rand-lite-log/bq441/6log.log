Query:
--Description: 3) Person-level view – compute restraint score & survived flag.
SELECT
  p.`consecutive_number`,
  p.`person_type`,
  p.`injury_severity`,
  CASE
    WHEN p.`restraint_system_helmet_use` = 0 THEN 0
    WHEN p.`restraint_system_helmet_use` = 1 THEN 0.33
    WHEN p.`restraint_system_helmet_use` = 2 THEN 0.67
    WHEN p.`restraint_system_helmet_use` = 3 THEN 1.0
    ELSE 0.5
  END                                               AS restraint,
  CASE WHEN p.`injury_severity` = 4 THEN 1 ELSE 0 END AS survived,
  p.`seating_position`,
  p.`age`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015` AS p
LIMIT 20;
Answer:
consecutive_number,person_type,injury_severity,restraint,survived,seating_position,age
