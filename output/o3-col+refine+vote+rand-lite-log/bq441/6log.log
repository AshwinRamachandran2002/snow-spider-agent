Query:
--Description: 5) Vehicle-level details with speeding, rollover & damage information.
SELECT
  `consecutive_number`,
  `body_type`,
  `travel_speed`,
  CASE WHEN LOWER(`speeding_related`) LIKE '%yes%' THEN 1 ELSE 0 END AS speeding_related_flag,
  CASE WHEN `rollover` = 'No Rollover' THEN 0 ELSE 1 END             AS rollover_flag,
  `extent_of_damage`,
  `vehicle_removal`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`
LIMIT 20;
Answer:
consecutive_number,body_type,travel_speed,speeding_related_flag,rollover_flag,extent_of_damage,vehicle_removal
