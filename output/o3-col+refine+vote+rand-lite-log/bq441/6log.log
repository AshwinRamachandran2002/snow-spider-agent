```sql
--Description: 1) Basic crash-level snapshot with calculated delay_to_scene and delay_to_hospital.
SELECT
  `consecutive_number`,
  `hour_of_crash`,
  `hour_of_arrival_at_scene`,
  `hour_of_ems_arrival_at_hospital`,
  (`hour_of_arrival_at_scene` - `hour_of_crash`)  AS delay_to_scene,
  (CASE WHEN `hour_of_ems_arrival_at_hospital` BETWEEN 0 AND 23
        THEN `hour_of_ems_arrival_at_hospital` - `hour_of_crash` END) AS delay_to_hospital,
  `type_of_intersection`,
  `light_condition`,
  `atmospheric_conditions_1`,
  `number_of_fatalities`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015`
LIMIT 20;
```

```sql
--Description: 2) Distinct list of light conditions reported in crashes.
SELECT DISTINCT
  `light_condition`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015`
LIMIT 20;
```

```sql
--Description: 3) Person-level view – compute restraint score & survived flag.
SELECT
  p.`consecutive_number`,
  p.`person_type`,
  p.`injury_severity`,
  CASE
    WHEN p.`restraint_system_helmet_use` = 0 THEN 0
    WHEN p.`restraint_system_helmet_use` = 1 THEN 0.33
    WHEN p.`restraint_system_helmet_use` = 2 THEN 0.67
    WHEN p.`restraint_system_helmet_use` = 3 THEN 1.0
    ELSE 0.5
  END                                               AS restraint,
  CASE WHEN p.`injury_severity` = 4 THEN 1 ELSE 0 END AS survived,
  p.`seating_position`,
  p.`age`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015` AS p
LIMIT 20;
```

```sql
--Description: 4) Binary alcohol / drug involvement indicators.
SELECT
  `consecutive_number`,
  `police_reported_alcohol_involvement`,
  `police_reported_drug_involvement`,
  CASE WHEN LOWER(`police_reported_alcohol_involvement`) LIKE '%yes%' THEN 1 ELSE 0 END AS alcohol,
  CASE WHEN LOWER(`police_reported_drug_involvement`)   LIKE '%yes%' THEN 1 ELSE 0 END AS drugs
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
LIMIT 20;
```

```sql
--Description: 5) Vehicle-level details with speeding, rollover & damage information.
SELECT
  `consecutive_number`,
  `body_type`,
  `travel_speed`,
  CASE WHEN LOWER(`speeding_related`) LIKE '%yes%' THEN 1 ELSE 0 END AS speeding_related_flag,
  CASE WHEN `rollover` = 'No Rollover' THEN 0 ELSE 1 END             AS rollover_flag,
  `extent_of_damage`,
  `vehicle_removal`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`
LIMIT 20;
```

```sql
--Description: 6) Join accident & vehicle tables to relate crash context with speeding vehicles.
SELECT
  a.`consecutive_number`,
  a.`hour_of_crash`,
  a.`light_condition`,
  v.`body_type`,
  v.`travel_speed`,
  CASE WHEN LOWER(v.`speeding_related`) LIKE '%yes%' THEN 1 ELSE 0 END AS speeding_flag
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS a
JOIN `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`   AS v
USING (`consecutive_number`)
WHERE v.`travel_speed` <> 998          -- exclude “Not Reported”
LIMIT 20;
```

```sql
--Description: 7) Non-motorist focus – crash location & impairment for pedestrians/bicyclists.
SELECT
  pb.`consecutive_number`,
  pb.`person_type_name`,
  pb.`crash_location_pedestrian_name`,
  pb.`crash_location_bicycle_name`,
  ni.`condition_impairment_at_time_of_crash_non_motorist_name`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.pbtype_2015` AS pb
LEFT JOIN `bigquery-public-data.nhtsa_traffic_fatalities.nmimpair_2015` AS ni
USING (`consecutive_number`)
LIMIT 20;
```

```sql
--Description: 8) Vehicles that struck pedestrians (sequence_of_events = 8) and corresponding impact area.
SELECT
  `consecutive_number`,
  `vehicle_number`,
  `vehicle_event_number`,
  `sequence_of_events_name`,
  `area_of_Impact_associated_with_the_event_name`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.vsoe_2015`
WHERE `sequence_of_events` = 8         -- Pedestrian
LIMIT 20;
```

```sql
--Description: 9) Aggregate – number of fatal crashes by intersection type.
SELECT
  `type_of_intersection`,
  COUNT(*) AS crashes
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015`
GROUP BY `type_of_intersection`
ORDER BY crashes DESC
LIMIT 20;
```

```sql
--Description: 10) Summary of first vs most harmful events for vehicles (values < 90 only).
SELECT
  `consecutive_number`,
  `first_harmful_event`,
  `most_harmful_event`,
  CASE WHEN `first_harmful_event` < 90 THEN `first_harmful_event` ELSE 0 END AS first_event_capped,
  CASE WHEN `most_harmful_event`  < 90 THEN `most_harmful_event`  ELSE 0 END AS most_event_capped
FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`
LIMIT 20;
```
