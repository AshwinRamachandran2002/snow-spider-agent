  v.`consecutive_number`,
  v.`speeding_related`,
  v.`roadway_surface_condition`,
  a.`atmospheric_conditions_1`,
  a.`hour_of_crash`
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`  AS v
JOIN  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS a
ON    v.`consecutive_number` = a.`consecutive_number`
WHERE v.`roadway_surface_condition` = 2
  AND LOWER(v.`speeding_related`) LIKE '%yes%'
LIMIT 20
