Query:
--Description:
--10)  Provide a sample of night-time crashes (light_condition = 2: Dark, not lighted)
--     that had at least one drunk driver.  Join accident_2015 with vehicle_2015 to
--     list each involved vehicle and its driver_drinking flag.
SELECT
  a.`consecutive_number`,
  a.`hour_of_crash`,
  a.`light_condition`,
  a.`number_of_drunk_drivers`,
  v.`vehicle_number`,
  v.`driver_drinking`
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS a
JOIN  `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`  AS v
ON    a.`consecutive_number` = v.`consecutive_number`
WHERE a.`light_condition` = 2     -- Dark, not lighted
  AND a.`number_of_drunk_drivers` >= 1
LIMIT 20
