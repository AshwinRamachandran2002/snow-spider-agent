```sql
-- 1)  Quick look at the main crash record – when, where, weather + derived time-delays
SELECT 
  `consecutive_number`,
  `hour_of_crash`,
  `county`,
  `type_of_intersection`,
  `light_condition`,
  `atmospheric_conditions_1`,
  -- delay (hrs) from crash to EMS arrival on scene
  CASE 
      WHEN hour_of_arrival_at_scene BETWEEN 0 AND 23 
      THEN hour_of_arrival_at_scene - hour_of_crash 
  END AS delay_to_scene,
  -- delay (hrs) from crash to EMS arrival at hospital
  CASE 
      WHEN hour_of_ems_arrival_at_hospital BETWEEN 0 AND 23 
      THEN hour_of_ems_arrival_at_hospital - hour_of_crash 
  END AS delay_to_hospital
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015`
LIMIT 20;
```

```sql
-- 2)  Distinct intersection types actually present in 2015 crashes
SELECT DISTINCT
  `type_of_intersection`
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015`
LIMIT 20;
```

```sql
-- 3)  First harmful event values (<90 kept, otherwise 0) that appear most frequently
SELECT
  CASE WHEN first_harmful_event < 90 THEN first_harmful_event ELSE 0 END AS first_harmful_event_capped,
  COUNT(*) AS n_crashes
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015`
GROUP BY first_harmful_event_capped
ORDER BY n_crashes DESC
LIMIT 20;
```

```sql
-- 4)  Person level – age, seat, injury, alcohol, drugs, restraint score & “survived” flag
SELECT
  `consecutive_number`,
  `age`,
  `seating_position`,
  `injury_severity`,
  -- survived (1 = injury severity 4)
  CASE WHEN injury_severity = 4 THEN 1 ELSE 0 END AS survived,
  -- alcohol involvement flag
  CASE WHEN LOWER(`police_reported_alcohol_involvement`) LIKE '%yes%' THEN 1 ELSE 0 END AS alcohol,
  -- drug involvement flag
  CASE WHEN LOWER(`police_reported_drug_involvement`)   LIKE '%yes%' THEN 1 ELSE 0 END AS drugs,
  -- restraint scale
  CASE restraint_system_helmet_use
      WHEN 0 THEN 0
      WHEN 1 THEN 0.33
      WHEN 2 THEN 0.67
      WHEN 3 THEN 1.0
      ELSE 0.5
  END AS restraint
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
LIMIT 20;
```

```sql
-- 5)  Vehicle level – speed, damage, rollover flag, speeding flag, driver drinking
SELECT
  `consecutive_number`,
  `travel_speed`,
  `extent_of_damage`,
  -- rollover binary
  CASE WHEN rollover LIKE 'No Rollover' THEN 0 ELSE 1 END AS rollover_flag,
  -- speeding binary
  CASE WHEN LOWER(speeding_related) LIKE '%yes%' THEN 1 ELSE 0 END AS speeding_flag,
  `roadway_surface_condition`,
  `driver_drinking`
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`
LIMIT 20;
```

```sql
-- 6)  Non-motorists (pedestrians/bicyclists) – main crash & site characteristics
SELECT
  `consecutive_number`,
  `person_type_name`,
  `age`,
  `sex`,
  `crash_type_pedestrian_name`,
  `crash_type_bicycle_name`,
  `crash_location_pedestrian_name`,
  `crash_location_bicycle_name`,
  `marked_crosswalk_present`,
  `sidewalk_present`
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.pbtype_2015`
LIMIT 20;
```

```sql
-- 7)  Crashes that involved at least one pedestrian (join crash & person tables)
SELECT DISTINCT
  a.consecutive_number,
  a.hour_of_crash,
  a.light_condition,
  p.person_type   AS pedestrian_code,
  p.injury_severity
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS a
JOIN  `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`   AS p
ON    a.consecutive_number = p.consecutive_number
WHERE p.person_type = 5               -- 5 = Pedestrian
LIMIT 20;
```

```sql
-- 8)  Wet-surface crashes with speeding vehicles (accident + vehicle)
SELECT DISTINCT
  v.consecutive_number,
  v.speeding_related,
  v.roadway_surface_condition,
  a.atmospheric_conditions_1,
  a.hour_of_crash
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`  AS v
JOIN  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS a
ON    v.consecutive_number = a.consecutive_number
WHERE v.roadway_surface_condition = 2          -- 2 = Wet
  AND LOWER(v.speeding_related) LIKE '%yes%'
LIMIT 20;
```

```sql
-- 9)  Vehicle sequence-of-events rows that include a pedestrian impact
SELECT
  `consecutive_number`,
  `vehicle_number`,
  `vehicle_event_number`,
  `sequence_of_events_name`,
  `area_of_Impact_associated_with_the_event_name`
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.vsoe_2015`
WHERE sequence_of_events = 8       -- 8 = Pedestrian
LIMIT 20;
```

```sql
--10)  Summary sample: crashes at night with ≥1 drunk driver, listing involved vehicles & driver alcohol
SELECT
  a.consecutive_number,
  a.hour_of_crash,
  a.light_condition,
  a.number_of_drunk_drivers,
  v.vehicle_number,
  v.driver_drinking
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS a
JOIN  `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`  AS v
ON    a.consecutive_number = v.consecutive_number
WHERE a.light_condition = 2      -- 2 = Dark (not lighted)
  AND a.number_of_drunk_drivers >= 1
LIMIT 20;
```
