Query:
--Description:
-- 7)  List crashes that involved at least one pedestrian.  We join the crash-level
--     table (accident_2015) to the person-level table (person_2015) and keep rows
--     where the person_type code equals 5 (pedestrian).  Only standard columns are
--     used, so no “*_name” fields are referenced.
SELECT DISTINCT
  a.`consecutive_number`,
  a.`hour_of_crash`,
  a.`light_condition`,
  p.`person_type` AS pedestrian_code,
  p.`injury_severity`
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS a
JOIN  `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`   AS p
ON    a.`consecutive_number` = p.`consecutive_number`
WHERE p.`person_type` = 5      -- 5 = Pedestrian
LIMIT 20
