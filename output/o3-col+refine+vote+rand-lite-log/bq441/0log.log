  CASE WHEN rollover LIKE 'No Rollover' THEN 0 ELSE 1 END AS rollover_flag,
  -- speeding binary
  CASE WHEN LOWER(speeding_related) LIKE '%yes%' THEN 1 ELSE 0 END AS speeding_flag,
  `roadway_surface_condition`,
  `driver_drinking`
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`
LIMIT 20;
