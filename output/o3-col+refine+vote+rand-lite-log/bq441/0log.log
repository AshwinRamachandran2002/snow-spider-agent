```sql
--Description:
-- 7)  List crashes that involved at least one pedestrian.  We join the crash-level
--     table (accident_2015) to the person-level table (person_2015) and keep rows
--     where the person_type code equals 5 (pedestrian).  Only standard columns are
--     used, so no “*_name” fields are referenced.
SELECT DISTINCT
  a.`consecutive_number`,
  a.`hour_of_crash`,
  a.`light_condition`,
  p.`person_type` AS pedestrian_code,
  p.`injury_severity`
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS a
JOIN  `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`   AS p
ON    a.`consecutive_number` = p.`consecutive_number`
WHERE p.`person_type` = 5      -- 5 = Pedestrian
LIMIT 20;
```

```sql
--Description:
-- 8)  Identify wet-surface crashes that also involved at least one speeding vehicle.
--     We join vehicle_2015 with accident_2015 and filter for roadway_surface_condition = 2
--     (wet) and a “Yes” flag inside the speeding_related text.  All referenced columns exist.
SELECT DISTINCT
  v.`consecutive_number`,
  v.`speeding_related`,
  v.`roadway_surface_condition`,
  a.`atmospheric_conditions_1`,
  a.`hour_of_crash`
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`  AS v
JOIN  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS a
ON    v.`consecutive_number` = a.`consecutive_number`
WHERE v.`roadway_surface_condition` = 2
  AND LOWER(v.`speeding_related`) LIKE '%yes%'
LIMIT 20;
```

```sql
--Description:
-- 9)  Fetch vehicle sequence-of-events records that specifically include a pedestrian
--     impact (sequence_of_events = 8).  Column names checked: the table contains 
--     sequence_of_events_name and area_of_impact_associated_with_the_event_name (all lower-case),
--     so we reference those exact names to avoid errors.
SELECT
  `consecutive_number`,
  `vehicle_number`,
  `vehicle_event_number`,
  `sequence_of_events_name`,
  `area_of_impact_associated_with_the_event_name`
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.vsoe_2015`
WHERE `sequence_of_events` = 8          -- 8 = Pedestrian event
LIMIT 20;
```

```sql
--Description:
--10)  Provide a sample of night-time crashes (light_condition = 2: Dark, not lighted)
--     that had at least one drunk driver.  Join accident_2015 with vehicle_2015 to
--     list each involved vehicle and its driver_drinking flag.
SELECT
  a.`consecutive_number`,
  a.`hour_of_crash`,
  a.`light_condition`,
  a.`number_of_drunk_drivers`,
  v.`vehicle_number`,
  v.`driver_drinking`
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS a
JOIN  `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2015`  AS v
ON    a.`consecutive_number` = v.`consecutive_number`
WHERE a.`light_condition` = 2     -- Dark, not lighted
  AND a.`number_of_drunk_drivers` >= 1
LIMIT 20;
```
