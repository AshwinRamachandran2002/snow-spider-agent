-- 3)  First harmful event values (<90 kept, otherwise 0) that appear most frequently
SELECT
  CASE WHEN first_harmful_event < 90 THEN first_harmful_event ELSE 0 END AS first_harmful_event_capped,
  COUNT(*) AS n_crashes
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015`
GROUP BY first_harmful_event_capped
ORDER BY n_crashes DESC
LIMIT 20;
