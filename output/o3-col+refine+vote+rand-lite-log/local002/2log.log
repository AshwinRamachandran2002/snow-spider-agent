```sql
--Description: Daily toy-sales counts between 2017-01-01 and 2018-08-29
SELECT DATE(o."order_purchase_timestamp") AS "sales_date",
       COUNT(*)                           AS "toy_sales"
FROM   "order_items" AS oi
JOIN   "orders"      AS o ON o."order_id"  = oi."order_id"
JOIN   "products"    AS p ON p."product_id" = oi."product_id"
WHERE  p."product_category_name" = 'brinquedos'
  AND  DATE(o."order_purchase_timestamp") 
       BETWEEN '2017-01-01' AND '2018-08-29'
GROUP  BY DATE(o."order_purchase_timestamp")
ORDER  BY "sales_date"
LIMIT 20;
```

```sql
--Description: Compute slope & intercept of simple linear regression on the daily toy-sales series
WITH daily_sales AS (
  SELECT DATE(o."order_purchase_timestamp") AS sales_date,
         COUNT(*)                           AS toy_sales
  FROM   "order_items" AS oi
  JOIN   "orders"      AS o ON o."order_id"  = oi."order_id"
  JOIN   "products"    AS p ON p."product_id" = oi."product_id"
  WHERE  p."product_category_name" = 'brinquedos'
    AND  DATE(o."order_purchase_timestamp") 
         BETWEEN '2017-01-01' AND '2018-08-29'
  GROUP  BY DATE(o."order_purchase_timestamp")
),
indexed AS (
  SELECT ROW_NUMBER() OVER (ORDER BY sales_date) AS idx,
         toy_sales
  FROM   daily_sales
)
SELECT COUNT(*)                                            AS n,
       SUM(idx)                                            AS sum_x,
       SUM(toy_sales)                                      AS sum_y,
       SUM(idx * toy_sales)                                AS sum_xy,
       SUM(idx * idx)                                      AS sum_x2,
       (COUNT(*)*SUM(idx*toy_sales) - SUM(idx)*SUM(toy_sales)) * 1.0 /
       (COUNT(*)*SUM(idx*idx)      - SUM(idx)*SUM(idx))    AS slope,
       (SUM(toy_sales)*1.0/COUNT(*)) -
       ((COUNT(*)*SUM(idx*toy_sales) - SUM(idx)*SUM(toy_sales)) * 1.0 /
        (COUNT(*)*SUM(idx*idx)      - SUM(idx)*SUM(idx))) *
       (SUM(idx)*1.0/COUNT(*))                             AS intercept
FROM   indexed
LIMIT 20;
```

```sql
--Description: Predict toy sales for 2018-12-03 … 2018-12-10 using the regression
WITH params AS (
  /* slope & intercept (same logic as prior query) */
  SELECT (COUNT(*)*SUM(idx*toy_sales) - SUM(idx)*SUM(toy_sales))*1.0 /
         (COUNT(*)*SUM(idx*idx)       - SUM(idx)*SUM(idx)) AS slope,
         (SUM(toy_sales)*1.0/COUNT(*)) -
         ((COUNT(*)*SUM(idx*toy_sales) - SUM(idx)*SUM(toy_sales))*1.0 /
          (COUNT(*)*SUM(idx*idx)       - SUM(idx)*SUM(idx)))*
         (SUM(idx)*1.0/COUNT(*))                           AS intercept
  FROM  (
         SELECT ROW_NUMBER() OVER (ORDER BY sales_date) AS idx,
                toy_sales
         FROM  (
                SELECT DATE(o."order_purchase_timestamp") AS sales_date,
                       COUNT(*)                           AS toy_sales
                FROM   "order_items" AS oi
                JOIN   "orders"      AS o ON o."order_id"  = oi."order_id"
                JOIN   "products"    AS p ON p."product_id" = oi."product_id"
                WHERE  p."product_category_name" = 'brinquedos'
                  AND  DATE(o."order_purchase_timestamp") 
                       BETWEEN '2017-01-01' AND '2018-08-29'
                GROUP  BY DATE(o."order_purchase_timestamp")
         )
  )
),
dates AS (
  SELECT '2018-12-03' AS d UNION ALL SELECT '2018-12-04' UNION ALL
  SELECT '2018-12-05' UNION ALL SELECT '2018-12-06' UNION ALL
  SELECT '2018-12-07' UNION ALL SELECT '2018-12-08' UNION ALL
  SELECT '2018-12-09' UNION ALL SELECT '2018-12-10'
)
SELECT d,
       (SELECT intercept FROM params) +
       (SELECT slope     FROM params) *
       (julianday(d) - julianday('2017-01-01') + 1)        AS predicted_sales
FROM   dates
LIMIT 20;
```

```sql
--Description: 5-day symmetric moving averages (MA₅) for the prediction window
WITH params AS (
  /* slope & intercept – same CTE as before */
  SELECT (COUNT(*)*SUM(idx*toy_sales) - SUM(idx)*SUM(toy_sales))*1.0 /
         (COUNT(*)*SUM(idx*idx)       - SUM(idx)*SUM(idx)) AS slope,
         (SUM(toy_sales)*1.0/COUNT(*)) -
         ((COUNT(*)*SUM(idx*toy_sales) - SUM(idx)*SUM(toy_sales))*1.0 /
          (COUNT(*)*SUM(idx*idx)       - SUM(idx)*SUM(idx)))*
         (SUM(idx)*1.0/COUNT(*))                           AS intercept
  FROM  (
         SELECT ROW_NUMBER() OVER (ORDER BY sales_date) AS idx,
                toy_sales
         FROM  (
                SELECT DATE(o."order_purchase_timestamp") AS sales_date,
                       COUNT(*)                           AS toy_sales
                FROM   "order_items" AS oi
                JOIN   "orders"      AS o ON o."order_id"  = oi."order_id"
                JOIN   "products"    AS p ON p."product_id" = oi."product_id"
                WHERE  p."product_category_name" = 'brinquedos'
                  AND  DATE(o."order_purchase_timestamp") 
                       BETWEEN '2017-01-01' AND '2018-08-29'
                GROUP  BY DATE(o."order_purchase_timestamp")
         )
  )
),
dates AS (
  SELECT '2018-12-03' AS d UNION ALL SELECT '2018-12-04' UNION ALL
  SELECT '2018-12-05' UNION ALL SELECT '2018-12-06' UNION ALL
  SELECT '2018-12-07' UNION ALL SELECT '2018-12-08' UNION ALL
  SELECT '2018-12-09' UNION ALL SELECT '2018-12-10'
),
predictions AS (
  SELECT d,
         (SELECT intercept FROM params) +
         (SELECT slope     FROM params) *
         (julianday(d) - julianday('2017-01-01') + 1) AS predicted_sales
  FROM   dates
),
moving_avg AS (
  SELECT p1.d,
         (SELECT AVG(p2.predicted_sales)
          FROM   predictions p2
          WHERE  julianday(p2.d) BETWEEN julianday(p1.d) - 2
                                      AND     julianday(p1.d) + 2)  AS ma5
  FROM   predictions p1
)
SELECT d,
       ma5
FROM   moving_avg
WHERE  d BETWEEN '2018-12-05' AND '2018-12-08'
LIMIT 20;
```

```sql
--Description: Sum of the four 5-day symmetric moving averages for 5-Dec-2018 to 8-Dec-2018
WITH params AS (
  /* slope & intercept – same CTE as before */
  SELECT (COUNT(*)*SUM(idx*toy_sales) - SUM(idx)*SUM(toy_sales))*1.0 /
         (COUNT(*)*SUM(idx*idx)       - SUM(idx)*SUM(idx)) AS slope,
         (SUM(toy_sales)*1.0/COUNT(*)) -
         ((COUNT(*)*SUM(idx*toy_sales) - SUM(idx)*SUM(toy_sales))*1.0 /
          (COUNT(*)*SUM(idx*idx)       - SUM(idx)*SUM(idx)))*
         (SUM(idx)*1.0/COUNT(*))                           AS intercept
  FROM  (
         SELECT ROW_NUMBER() OVER (ORDER BY sales_date) AS idx,
                toy_sales
         FROM  (
                SELECT DATE(o."order_purchase_timestamp") AS sales_date,
                       COUNT(*)                           AS toy_sales
                FROM   "order_items" AS oi
                JOIN   "orders"      AS o ON o."order_id"  = oi."order_id"
                JOIN   "products"    AS p ON p."product_id" = oi."product_id"
                WHERE  p."product_category_name" = 'brinquedos'
                  AND  DATE(o."order_purchase_timestamp") 
                       BETWEEN '2017-01-01' AND '2018-08-29'
                GROUP  BY DATE(o."order_purchase_timestamp")
         )
  )
),
dates AS (
  SELECT '2018-12-03' AS d UNION ALL SELECT '2018-12-04' UNION ALL
  SELECT '2018-12-05' UNION ALL SELECT '2018-12-06' UNION ALL
  SELECT '2018-12-07' UNION ALL SELECT '2018-12-08' UNION ALL
  SELECT '2018-12-09' UNION ALL SELECT '2018-12-10'
),
predictions AS (
  SELECT d,
         (SELECT intercept FROM params) +
         (SELECT slope     FROM params) *
         (julianday(d) - julianday('2017-01-01') + 1) AS predicted_sales
  FROM   dates
),
moving_avg AS (
  SELECT p1.d,
         (SELECT AVG(p2.predicted_sales)
          FROM   predictions p2
          WHERE  julianday(p2.d) BETWEEN julianday(p1.d) - 2
                                      AND     julianday(p1.d) + 2)  AS ma5
  FROM   predictions p1
)
SELECT SUM(ma5) AS sum_of_ma5
FROM   moving_avg
WHERE  d BETWEEN '2018-12-05' AND '2018-12-08'
LIMIT 20;
```

Running the final query returns the single value “sum_of_ma5”, i.e., the sum of the four 5-day symmetric moving averages for December 5–8 2018 based on the linear-regression forecast of toy sales.
