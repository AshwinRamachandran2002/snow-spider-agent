              AND    DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
              GROUP  BY d
       ),
       stats AS (
              SELECT COUNT(*) AS n,
                     SUM(x)   AS sx,
                     SUM(y)   AS sy,
                     SUM(x*y) AS sxy,
                     SUM(x*x) AS sx2
              FROM   toy_sales
       )
       SELECT (n*sxy - sx*sy)*1.0 / (n*sx2 - sx*sx)     AS slope,
              (sy - ((n*sxy - sx*sy)*1.0 / (n*sx2 - sx*sx))*sx)/n AS intercept
       FROM   stats
),
future_dates AS (
       SELECT '2018-12-03' AS d UNION ALL SELECT '2018-12-04'
       UNION ALL SELECT '2018-12-05' UNION ALL SELECT '2018-12-06'
       UNION ALL SELECT '2018-12-07' UNION ALL SELECT '2018-12-08'
       UNION ALL SELECT '2018-12-09' UNION ALL SELECT '2018-12-10'
)
SELECT fd.d                                                AS future_day,
       c.intercept + c.slope*(JULIANDAY(fd.d) - JULIANDAY('2017-01-01'))  AS predicted_sales
FROM   future_dates  AS fd
CROSS  JOIN coeff     AS c
ORDER  BY fd.d;
