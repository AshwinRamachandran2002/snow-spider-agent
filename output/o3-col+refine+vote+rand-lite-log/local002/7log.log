--8. Compute the 5-day symmetric moving-average (MA5) over those predicted values
WITH coeff AS (
       WITH toy_sales AS (
              SELECT DATE(o."order_purchase_timestamp") AS d,
                     COUNT(*)                           AS y,
                     (JULIANDAY(DATE(o."order_purchase_timestamp")) -
                      JULIANDAY('2017-01-01'))          AS x
              FROM   "order_items"  AS oi
              JOIN   "orders"       AS o  ON o."order_id" = oi."order_id"
              WHERE  oi."product_id" IN (
                        SELECT "product_id"
                        FROM   "products"
                        WHERE  "product_category_name" IN ('brinquedos','bebes_brincadeiras','brinquedos_partes_e_pecas')
                    )
              AND    DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
              GROUP  BY d
       ),
       stats AS (
              SELECT COUNT(*) AS n,
                     SUM(x)   AS sx,
                     SUM(y)   AS sy,
                     SUM(x*y) AS sxy,
                     SUM(x*x) AS sx2
              FROM   toy_sales
       )
       SELECT (n*sxy - sx*sy)*1.0 / (n*sx2 - sx*sx)      AS slope,
              (sy - ((n*sxy - sx*sy)*1.0 / (n*sx2 - sx*sx))*sx)/n  AS intercept
       FROM   stats
),
future AS (
       SELECT  d,
               (SELECT intercept + slope*(JULIANDAY(d) - JULIANDAY('2017-01-01'))
                FROM   coeff)                       AS yhat
       FROM  (SELECT '2018-12-03' AS d UNION ALL SELECT '2018-12-04'
              UNION ALL SELECT '2018-12-05' UNION ALL SELECT '2018-12-06'
              UNION ALL SELECT '2018-12-07' UNION ALL SELECT '2018-12-08'
              UNION ALL SELECT '2018-12-09' UNION ALL SELECT '2018-12-10')
),
ma5 AS (
       SELECT a.d,
              (SELECT AVG(b.yhat)
               FROM   future b
               WHERE  JULIANDAY(b.d) BETWEEN JULIANDAY(a.d)-2 AND JULIANDAY(a.d)+2
              ) AS ma5_value
       FROM   future a
)
SELECT d, ma5_value
FROM   ma5
WHERE  d BETWEEN '2018-12-05' AND '2018-12-08'
ORDER  BY d;
