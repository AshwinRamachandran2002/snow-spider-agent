       WHERE  oi."product_id" IN (
                 SELECT "product_id"
                 FROM   "products"
                 WHERE  "product_category_name" IN ('brinquedos','bebes_brincadeiras','brinquedos_partes_e_pecas')
             )
       AND    DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
       GROUP  BY d
),
stats AS (
       SELECT COUNT(*)            AS n,
              SUM(x)              AS sx,
              SUM(y)              AS sy,
              SUM(x*y)            AS sxy,
              SUM(x*x)            AS sx2
       FROM   toy_sales
)
SELECT (n*sxy - sx*sy)*1.0 / (n*sx2 - sx*sx)                    AS slope,
       (sy - ((n*sxy - sx*sy)*1.0 / (n*sx2 - sx*sx))*sx)/n      AS intercept
FROM   stats
