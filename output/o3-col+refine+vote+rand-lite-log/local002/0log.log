LIMIT 20;
```

```sql
-- 7) Pull the same daily series but now include price to inspect revenue signal
SELECT DISTINCT SUBSTR(o."order_purchase_timestamp",1,10) AS "purchase_date",
       SUM(oi."price")                                    AS "toy_revenue"
FROM   "orders"      AS o
JOIN   "order_items" AS oi ON oi."order_id" = o."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english" LIKE '%toy%'
  AND  "purchase_date" BETWEEN '2017-01-01' AND '2018-08-29'
GROUP  BY "purchase_date"
ORDER  BY "purchase_date"
LIMIT 20;
```

```sql
-- 8) Count number of toy items (not just orders) sold per day
SELECT DISTINCT SUBSTR(o."order_purchase_timestamp",1,10) AS "purchase_date",
       COUNT(*)                                           AS "toy_items"
FROM   "orders"      AS o
JOIN   "order_items" AS oi ON oi."order_id" = o."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english" LIKE '%toy%'
  AND  "purchase_date" BETWEEN '2017-01-01' AND '2018-08-29'
GROUP  BY "purchase_date"
ORDER  BY "purchase_date"
LIMIT 20;
```

```sql
-- 9) Quick peek at December-2018 toy sales (to see actual vs forecast horizon)
SELECT DISTINCT SUBSTR(o."order_purchase_timestamp",1,10) AS "purchase_date",
       COUNT(*)                                           AS "toy_items"
FROM   "orders"      AS o
JOIN   "order_items" AS oi ON oi."order_id" = o."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english" LIKE '%toy%'
  AND  "purchase_date" BETWEEN '2018-12-01' AND '2018-12-31'
GROUP  BY "purchase_date"
ORDER  BY "purchase_date"
LIMIT 20;
```

```sql
-- 10) Same December window but aggregating 5-day symmetric moving-average buckets
SELECT DISTINCT ( (CAST(SUBSTR(o."order_purchase_timestamp",9,2) AS INTEGER)-2) / 5 ) AS "five_day_group",
       AVG(COUNT(*)) OVER (PARTITION BY ( (CAST(SUBSTR(o."order_purchase_timestamp",9,2) AS INTEGER)-2) / 5 )) 
       AS "approx_5d_avg_items"
FROM   "orders"      AS o
JOIN   "order_items" AS oi ON oi."order_id" = o."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english" LIKE '%toy%'
  AND  SUBSTR(o."order_purchase_timestamp",1,7) = '2018-12'
GROUP  BY SUBSTR(o."order_purchase_timestamp",1,10)
LIMIT 20;
```

(The above 10 queries help explore toy-category sales, letting you build the linear-regression forecast from Jan-2017 → Aug-2018, compute the 5-day symmetric moving averages for 5-Dec to 8-Dec-2018, and then sum them.)
