```sql
--Description: Need to confirm toy-category sales during December 2018.  
--1) Join orders → order_items → products → product_category_name_translation.  
--2) Keep rows whose English category name contains the substring “toy”.  
--3) Filter purchase timestamps with LIKE '2018-12-%' to capture any date in that month.  
--4) Aggregate by day (first 10 chars of timestamp) and count toy items sold.  
--5) Sort chronologically and return up to 20 rows for inspection.  
SELECT SUBSTR(o."order_purchase_timestamp", 1, 10) AS "purchase_date",
       COUNT(*)                                    AS "toy_items"
FROM   "orders"      AS o
JOIN   "order_items" AS oi ON oi."order_id" = o."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
JOIN   "product_category_name_translation" AS t
         ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english" LIKE '%toy%'
  AND  o."order_purchase_timestamp" LIKE '2018-12-%'
