```sql
-- 1) Find the Portuguese category name(s) whose English translation contains the word “toy”
SELECT DISTINCT "product_category_name",
                "product_category_name_english"
FROM   "product_category_name_translation"
WHERE  "product_category_name_english" LIKE '%toy%'
LIMIT 20;
```

```sql
-- 2) Get 20 sample products that belong to those “toy” categories
SELECT DISTINCT p."product_id",
                p."product_category_name"
FROM   "products"            AS p
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english" LIKE '%toy%'
LIMIT 20;
```

```sql
-- 3) List 20 sample order-item rows that correspond to toy products
SELECT DISTINCT oi."order_id",
                oi."product_id",
                oi."price"
FROM   "order_items" AS oi
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english" LIKE '%toy%'
LIMIT 20;
```

```sql
-- 4) Show 20 distinct purchase dates for toy orders (Jan-2017 to Aug-2018 range)
SELECT DISTINCT SUBSTR(o."order_purchase_timestamp",1,10) AS "purchase_date"
FROM   "orders"      AS o
JOIN   "order_items" AS oi ON oi."order_id" = o."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english" LIKE '%toy%'
  AND  "purchase_date" BETWEEN '2017-01-01' AND '2018-08-29'
LIMIT 20;
```

```sql
-- 5) Daily toy-sales volume (distinct orders) in the training window
SELECT DISTINCT SUBSTR(o."order_purchase_timestamp",1,10) AS "purchase_date",
       COUNT(DISTINCT o."order_id")                       AS "toy_orders"
FROM   "orders"      AS o
JOIN   "order_items" AS oi ON oi."order_id" = o."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english" LIKE '%toy%'
  AND  "purchase_date" BETWEEN '2017-01-01' AND '2018-08-29'
GROUP  BY "purchase_date"
ORDER  BY "purchase_date"
LIMIT 20;
```

```sql
-- 6) Verify that there are toy sales close to the forecast period (late Aug-2018)
SELECT DISTINCT SUBSTR(o."order_purchase_timestamp",1,10) AS "purchase_date",
       COUNT(DISTINCT o."order_id")                       AS "toy_orders"
FROM   "orders"      AS o
JOIN   "order_items" AS oi ON oi."order_id" = o."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english" LIKE '%toy%'
  AND  "purchase_date" >= '2018-08-15'
