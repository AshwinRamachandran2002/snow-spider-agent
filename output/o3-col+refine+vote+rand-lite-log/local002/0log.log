```sql
--Description: Simplify the inspection by ignoring product/category filters entirely.
--             We only want to see whether *any* orders exist in December 2018.
--             1) Take the “orders” table.  
--             2) Keep rows whose purchase timestamp begins with '2018-12-' (i.e., any date in Dec-2018).  
--             3) Aggregate by day (first 10 chars of timestamp) and count all order records.  
--             4) Sort chronologically and return up to 20 rows.
SELECT SUBSTR(o."order_purchase_timestamp", 1, 10) AS "purchase_date",
       COUNT(*)                                    AS "total_orders"
FROM   "orders" AS o
WHERE  o."order_purchase_timestamp" LIKE '2018-12-%'
GROUP  BY "purchase_date"
ORDER  BY "purchase_date"
LIMIT 20;
```
