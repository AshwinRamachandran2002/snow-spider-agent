```sql
--Description: Inspect all available English category names to locate the one that refers to toys.
SELECT DISTINCT "product_category_name_english"
FROM "product_category_name_translation"
LIMIT 20;
```

```sql
--Description: Retrieve the Portuguese category names whose English translation contains the word “toy”.
SELECT DISTINCT "product_category_name", "product_category_name_english"
FROM "product_category_name_translation"
WHERE "product_category_name_english" LIKE '%toy%'
LIMIT 20;
```

```sql
--Description: List a few product entries that belong to the (English) toy category found above.
SELECT DISTINCT p."product_id", p."product_category_name"
FROM "products"  AS p
JOIN "product_category_name_translation" AS t
  ON p."product_category_name" = t."product_category_name"
WHERE t."product_category_name_english" LIKE '%toy%'
LIMIT 20;
```

```sql
--Description: Display one week of orders (any) together with their purchase date, for a quick look at the date format used in the orders table.
SELECT DISTINCT "order_id", "order_purchase_timestamp"
FROM "orders"
ORDER BY "order_purchase_timestamp"
LIMIT 20;
```

```sql
--Description: Show some toy order-items (one row per item) together with the purchase date.
SELECT DISTINCT oi."order_id",
       o."order_purchase_timestamp",
       oi."product_id",
       oi."price"
FROM "order_items" AS oi
JOIN "orders"      AS o  ON o."order_id" = oi."order_id"
JOIN "products"    AS p  ON p."product_id" = oi."product_id"
JOIN "product_category_name_translation" AS t
     ON p."product_category_name" = t."product_category_name"
WHERE t."product_category_name_english" LIKE '%toy%'
LIMIT 20;
```

```sql
--Description: Aggregate daily toy sales revenue (total price) between 2017-01-01 and 2018-08-29.
SELECT DATE(o."order_purchase_timestamp")  AS "sale_date",
       SUM(oi."price")                     AS "daily_revenue"
FROM   "order_items" AS oi
JOIN   "orders"      AS o  ON o."order_id" = oi."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english"  LIKE '%toy%'
  AND DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
GROUP  BY DATE(o."order_purchase_timestamp")
ORDER  BY "sale_date"
LIMIT 20;
```

```sql
--Description: Same as above but counting number of toy items sold each day (useful for units-sold based forecasting).
SELECT DATE(o."order_purchase_timestamp") AS "sale_date",
       COUNT(*)                           AS "daily_units"
FROM   "order_items" AS oi
JOIN   "orders"      AS o  ON o."order_id" = oi."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english" LIKE '%toy%'
  AND  DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
GROUP  BY DATE(o."order_purchase_timestamp")
ORDER  BY "sale_date"
LIMIT 20;
```

```sql
--Description: List the final few dates (in August 2018) to confirm we indeed have data only up to 2018-08-29.
SELECT DATE(o."order_purchase_timestamp") AS "sale_date",
       SUM(oi."price")                    AS "daily_revenue"
FROM   "order_items" AS oi
JOIN   "orders"      AS o  ON o."order_id" = oi."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english" LIKE '%toy%'
  AND  DATE(o."order_purchase_timestamp") >= '2018-08-20'
GROUP  BY DATE(o."order_purchase_timestamp")
ORDER  BY "sale_date"
LIMIT 20;
```

```sql
--Description: Prepare a view-like result with a continuous date series (implicitly via LEFT JOIN on a calendar sub-query) to simplify later regression outside SQLite.
SELECT d."dt" AS "sale_date",
       COALESCE(r."daily_revenue", 0) AS "daily_revenue"
FROM   (SELECT DATE('2017-01-01', '+' || ROW_NUMBER() OVER() || ' day') AS "dt"
        FROM   (SELECT 1 FROM "orders" LIMIT 1000)  -- create enough rows for a calendar
        LIMIT 1000                                  -- covers ~3 years
       ) AS d
LEFT JOIN (
    SELECT DATE(o."order_purchase_timestamp") AS "sale_date",
           SUM(oi."price")                    AS "daily_revenue"
    FROM   "order_items" AS oi
    JOIN   "orders"      AS o  ON o."order_id" = oi."order_id"
    JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
    JOIN   "product_category_name_translation" AS t
           ON p."product_category_name" = t."product_category_name"
    WHERE  t."product_category_name_english" LIKE '%toy%'
      AND  DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
    GROUP  BY DATE(o."order_purchase_timestamp")
) AS r  ON r."sale_date" = d."dt"
WHERE  d."dt" BETWEEN '2017-01-01' AND '2018-08-29'
ORDER BY d."dt"
LIMIT 20;
```

```sql
--Description: Extract the already-computed linear-regression predictions (assuming done externally) and the corresponding 5-day symmetric moving averages for 2018-12-05 to 2018-12-08 (this dummy query shows intended final format).
SELECT '2018-12-05' AS "prediction_date", 123.45 AS "five_day_symmetric_ma" UNION ALL
SELECT '2018-12-06', 127.89 UNION ALL
SELECT '2018-12-07', 130.01 UNION ALL
SELECT '2018-12-08', 128.76;
```
