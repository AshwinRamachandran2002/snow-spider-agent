Query:
--Description: Aggregate daily toy sales revenue (total price) between 2017-01-01 and 2018-08-29.
SELECT DATE(o."order_purchase_timestamp")  AS "sale_date",
       SUM(oi."price")                     AS "daily_revenue"
FROM   "order_items" AS oi
JOIN   "orders"      AS o  ON o."order_id" = oi."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english"  LIKE '%toy%'
  AND DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
GROUP  BY DATE(o."order_purchase_timestamp")
ORDER  BY "sale_date"
LIMIT 20;
