2025-05-05 04:27:55 - Thread-3157 (execute) - INFO - [Exploration]
Below is a step-by-step exploration (8 queries) that finishes with the single value that answers the question – the sum of the four (Dec 5 → Dec 8 2018) five-day symmetric moving-averages of the *predicted* daily toy sales obtained with a simple linear-regression model built on the period 2017-01-01 … 2018-08-29.

```sql
-- 1) Which Portuguese categories translate to English strings containing “toy”?
SELECT DISTINCT
       t."product_category_name",
       t."product_category_name_english"
FROM   "product_category_name_translation" AS t
WHERE  LOWER(t."product_category_name_english") LIKE '%toy%'
LIMIT 20;
```

```sql
-- 2) Check a few products that belong to one of those “toy” categories
SELECT DISTINCT
       p."product_id",
       p."product_category_name"
FROM   "products"              AS p
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  LOWER(t."product_category_name_english") LIKE '%toy%'
LIMIT 20;
```

```sql
-- 3) Build daily toy–sales (units) between 2017-01-01 and 2018-08-29
SELECT DISTINCT
       DATE(o."order_purchase_timestamp") AS "sale_date",
       COUNT(*)                           AS "units_sold"
FROM   "orders"       AS o
JOIN   "order_items"  AS oi USING("order_id")
JOIN   "products"     AS p  ON p."product_id" = oi."product_id"
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  LOWER(t."product_category_name_english") LIKE '%toy%'
  AND  DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
GROUP  BY "sale_date"
ORDER  BY "sale_date"
LIMIT 20;
```

```sql
-- 4) Compute regression statistics (n, Σx, Σy, Σxy, Σx²) on that daily series
WITH daily AS (
  SELECT DATE(o."order_purchase_timestamp")                    AS d,
         COUNT(*)                                              AS y,
         (JULIANDAY(DATE(o."order_purchase_timestamp"))
          - JULIANDAY('2017-01-01'))                           AS x
  FROM   "orders"      AS o
  JOIN   "order_items" AS oi USING("order_id")
  JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
  JOIN   "product_category_name_translation" AS t
         ON p."product_category_name" = t."product_category_name"
  WHERE  LOWER(t."product_category_name_english") LIKE '%toy%'
    AND  DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
  GROUP  BY d
)
SELECT DISTINCT
       COUNT(*)                 AS n,
       SUM(x)                   AS sum_x,
       SUM(y)                   AS sum_y,
       SUM(x*y)                 AS sum_xy,
       SUM(x*x)                 AS sum_x2
FROM   daily;
```

```sql
-- 5) Turn those aggregates into the regression coefficients (slope & intercept)
WITH stats AS (
  /* << same CTE as in query (4) — repeated here for self-containment >> */
  SELECT COUNT(*) AS n,
         SUM(x)   AS sum_x,
         SUM(y)   AS sum_y,
         SUM(x*y) AS sum_xy,
         SUM(x*x) AS sum_x2
  FROM (
    SELECT DATE(o."order_purchase_timestamp")                    AS d,
           COUNT(*)                                              AS y,
           (JULIANDAY(DATE(o."order_purchase_timestamp"))
            - JULIANDAY('2017-01-01'))                           AS x
    FROM   "orders"      AS o
    JOIN   "order_items" AS oi USING("order_id")
    JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
    JOIN   "product_category_name_translation" AS t
           ON p."product_category_name" = t."product_category_name"
    WHERE  LOWER(t."product_category_name_english") LIKE '%toy%'
      AND  DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
    GROUP  BY d
  )
)
SELECT DISTINCT
       (1.0*stats.n*stats.sum_xy - stats.sum_x*stats.sum_y)
/      (1.0*stats.n*stats.sum_x2 - stats.sum_x*stats.sum_x)       AS slope,
       (stats.sum_y - ((1.0*stats.n*stats.sum_xy - stats.sum_x*stats.sum_y)
/                      (1.0*stats.n*stats.sum_x2 - stats.sum_x*stats.sum_x))*stats.sum_x)
/      (1.0*stats.n)                                              AS intercept
FROM   stats;
```

```sql
-- 6) Produce daily predictions for 2018-12-03 … 2018-12-10
WITH RECURSIVE future_dates(d) AS (
  SELECT '2018-12-03'
  UNION ALL
  SELECT DATE(d,'+1 day') FROM future_dates WHERE d < '2018-12-10'
),
coeff AS ( /* reuse query (5) to get slope & intercept */
  SELECT (1.0*n*sum_xy - sum_x*sum_y)/(1.0*n*sum_x2 - sum_x*sum_x) AS slope,
         (sum_y - ((1.0*n*sum_xy - sum_x*sum_y)/(1.0*n*sum_x2 - sum_x*sum_x))*sum_x)
/        (1.0*n)                                                    AS intercept
  FROM ( /* the stats sub-query is identical to that of query (5) */ 
    SELECT COUNT(*) AS n, SUM(x) AS sum_x, SUM(y) AS sum_y,
           SUM(x*y) AS sum_xy, SUM(x*x) AS sum_x2
    FROM (
      SELECT DATE(o."order_purchase_timestamp") AS d,
             COUNT(*)                           AS y,
             (JULIANDAY(DATE(o."order_purchase_timestamp"))
              - JULIANDAY('2017-01-01'))        AS x
      FROM   "orders"      AS o
      JOIN   "order_items" AS oi USING("order_id")
      JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
      JOIN   "product_category_name_translation" AS t
             ON p."product_category_name" = t."product_category_name"
      WHERE  LOWER(t."product_category_name_english") LIKE '%toy%'
        AND  DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
      GROUP  BY d
    )
  )
)
SELECT DISTINCT
       fd.d                               AS "date",
       coeff.slope *
          (JULIANDAY(fd.d) - JULIANDAY('2017-01-01')) +
          coeff.intercept                 AS "predicted_units"
FROM   future_dates AS fd, coeff
ORDER  BY fd.d
LIMIT 20;
```

```sql
-- 7) 5-day centred moving-average around each target date (Dec 5-8 2018)
WITH preds AS ( /* query (6) re-used, but keep only the 8 predicted rows */
  SELECT fd.d,
         coeff.slope *
         (JULIANDAY(fd.d) - JULIANDAY('2017-01-01')) +
         coeff.intercept  AS yhat
  FROM (
    WITH RECURSIVE future_dates(d) AS (
      SELECT '2018-12-03'
      UNION ALL
      SELECT DATE(d,'+1 day') FROM future_dates WHERE d < '2018-12-10'
    ) SELECT * FROM future_dates
  ) AS fd,
  ( /* coefficients CTE, identical to prev. queries */ 
    SELECT (1.0*n*sum_xy - sum_x*sum_y)/(1.0*n*sum_x2 - sum_x*sum_x) AS slope,
           (sum_y - ((1.0*n*sum_xy - sum_x*sum_y)/(1.0*n*sum_x2 - sum_x*sum_x))*sum_x)
/          (1.0*n)                                                    AS intercept
    FROM ( /* same stats sub-query */ 
      SELECT COUNT(*) AS n, SUM(x) AS sum_x, SUM(y) AS sum_y,
             SUM(x*y) AS sum_xy, SUM(x*x) AS sum_x2
      FROM (
        SELECT DATE(o."order_purchase_timestamp") AS d,
               COUNT(*)                           AS y,
               (JULIANDAY(DATE(o."order_purchase_timestamp"))
                - JULIANDAY('2017-01-01'))        AS x
        FROM   "orders"      AS o
        JOIN   "order_items" AS oi USING("order_id")
        JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
        JOIN   "product_category_name_translation" AS t
               ON p."product_category_name" = t."product_category_name"
        WHERE  LOWER(t."product_category_name_english") LIKE '%toy%'
          AND  DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
        GROUP  BY d
      )
    )
  )  AS coeff
),
centre_ma AS (
  SELECT DISTINCT
         p1.d                             AS centre_day,
         (SELECT AVG(p2.yhat)
            FROM preds AS p2
            WHERE p2.d BETWEEN DATE(p1.d,'-2 day') AND DATE(p1.d,'+2 day')
         )                                AS ma5
  FROM   preds AS p1
  WHERE  p1.d BETWEEN '2018-12-05' AND '2018-12-08'
)
SELECT DISTINCT * FROM centre_ma;
```

```sql
-- 8) Sum of the four 5-day moving-averages (final answer)
WITH preds AS ( /* identical to query (7) */
  SELECT fd.d,
         coeff.slope *
         (JULIANDAY(fd.d) - JULIANDAY('2017-01-01')) +
         coeff.intercept  AS yhat
  FROM (
    WITH RECURSIVE future_dates(d) AS (
      SELECT '2018-12-03'
      UNION ALL
      SELECT DATE(d,'+1 day') FROM future_dates WHERE d < '2018-12-10'
    ) SELECT * FROM future_dates
  ) AS fd,
  ( /* coefficients */ 
    SELECT (1.0*n*sum_xy - sum_x*sum_y)/(1.0*n*sum_x2 - sum_x*sum_x) AS slope,
           (sum_y - ((1.0*n*sum_xy - sum_x*sum_y)/(1.0*n*sum_x2 - sum_x*sum_x))*sum_x)
/          (1.0*n)                                                    AS intercept
    FROM (
      SELECT COUNT(*) AS n, SUM(x) AS sum_x, SUM(y) AS sum_y,
             SUM(x*y) AS sum_xy, SUM(x*x) AS sum_x2
      FROM (
        SELECT DATE(o."order_purchase_timestamp") AS d,
               COUNT(*)                           AS y,
               (JULIANDAY(DATE(o."order_purchase_timestamp"))
                - JULIANDAY('2017-01-01'))        AS x
        FROM   "orders"      AS o
        JOIN   "order_items" AS oi USING("order_id")
        JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
        JOIN   "product_category_name_translation" AS t
               ON p."product_category_name" = t."product_category_name"
        WHERE  LOWER(t."product_category_name_english") LIKE '%toy%'
          AND  DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
        GROUP  BY d
      )
    )
  ) AS coeff
),
ma AS (
  SELECT p1.d AS centre_day,
         (SELECT AVG(p2.yhat)
          FROM preds AS p2
          WHERE p2.d BETWEEN DATE(p1.d,'-2 day') AND DATE(p1.d,'+2 day')
         ) AS ma5
  FROM preds AS p1
  WHERE p1.d BETWEEN '2018-12-05' AND '2018-12-08'
)
SELECT DISTINCT SUM(ma5) AS "sum_of_4_moving_averages"
FROM   ma;
```

Running the last query (`query 8`) returns a single number – the requested sum of the four 5-day symmetric moving-averages of the predicted toy sales for 5-Dec, 6-Dec, 7-Dec and 8-Dec 2018.
