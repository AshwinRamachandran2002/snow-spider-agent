Query:
-- 6) Produce daily predictions for 2018-12-03 … 2018-12-10
WITH RECURSIVE future_dates(d) AS (
  SELECT '2018-12-03'
  UNION ALL
  SELECT DATE(d,'+1 day') FROM future_dates WHERE d < '2018-12-10'
),
coeff AS ( /* reuse query (5) to get slope & intercept */
  SELECT (1.0*n*sum_xy - sum_x*sum_y)/(1.0*n*sum_x2 - sum_x*sum_x) AS slope,
         (sum_y - ((1.0*n*sum_xy - sum_x*sum_y)/(1.0*n*sum_x2 - sum_x*sum_x))*sum_x)
/        (1.0*n)                                                    AS intercept
  FROM ( /* the stats sub-query is identical to that of query (5) */ 
    SELECT COUNT(*) AS n, SUM(x) AS sum_x, SUM(y) AS sum_y,
           SUM(x*y) AS sum_xy, SUM(x*x) AS sum_x2
    FROM (
      SELECT DATE(o."order_purchase_timestamp") AS d,
             COUNT(*)                           AS y,
             (JULIANDAY(DATE(o."order_purchase_timestamp"))
              - JULIANDAY('2017-01-01'))        AS x
      FROM   "orders"      AS o
      JOIN   "order_items" AS oi USING("order_id")
      JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
      JOIN   "product_category_name_translation" AS t
             ON p."product_category_name" = t."product_category_name"
      WHERE  LOWER(t."product_category_name_english") LIKE '%toy%'
        AND  DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
      GROUP  BY d
    )
  )
)
SELECT DISTINCT
       fd.d                               AS "date",
       coeff.slope *
          (JULIANDAY(fd.d) - JULIANDAY('2017-01-01')) +
          coeff.intercept                 AS "predicted_units"
FROM   future_dates AS fd, coeff
ORDER  BY fd.d
LIMIT 20;
