Query:
-- 5) Turn those aggregates into the regression coefficients (slope & intercept)
WITH stats AS (
  /* << same CTE as in query (4) — repeated here for self-containment >> */
  SELECT COUNT(*) AS n,
         SUM(x)   AS sum_x,
         SUM(y)   AS sum_y,
         SUM(x*y) AS sum_xy,
         SUM(x*x) AS sum_x2
  FROM (
    SELECT DATE(o."order_purchase_timestamp")                    AS d,
           COUNT(*)                                              AS y,
           (JULIANDAY(DATE(o."order_purchase_timestamp"))
            - JULIANDAY('2017-01-01'))                           AS x
    FROM   "orders"      AS o
    JOIN   "order_items" AS oi USING("order_id")
    JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
    JOIN   "product_category_name_translation" AS t
           ON p."product_category_name" = t."product_category_name"
    WHERE  LOWER(t."product_category_name_english") LIKE '%toy%'
      AND  DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
    GROUP  BY d
  )
)
SELECT DISTINCT
       (1.0*stats.n*stats.sum_xy - stats.sum_x*stats.sum_y)
/      (1.0*stats.n*stats.sum_x2 - stats.sum_x*stats.sum_x)       AS slope,
       (stats.sum_y - ((1.0*stats.n*stats.sum_xy - stats.sum_x*stats.sum_y)
/                      (1.0*stats.n*stats.sum_x2 - stats.sum_x*stats.sum_x))*stats.sum_x)
/      (1.0*stats.n)                                              AS intercept
FROM   stats;
