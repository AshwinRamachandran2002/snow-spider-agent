Query:
--Description:  Corrected version of query 7 – computes the 5-day symmetric moving-average
--              of predicted toy sales (using linear-regression coefficients) and lists
--              the values for 05- to 08-Dec-2018.  The only change is the introduction
--              of a CTE “num” with column n (0‒7) to build the eight future dates,
--              replacing the missing alias “i”.
WITH coeff AS (                               /* regression slope & intercept */
    WITH daily AS (
        SELECT DATE(o."order_purchase_timestamp")                                AS dt,
               COUNT(*)                                                          AS y,
               CAST(julianday(DATE(o."order_purchase_timestamp")) -
                    julianday('2017-01-01')                                      AS REAL) AS x
        FROM   "order_items" AS oi
        JOIN   "orders"      AS o ON o."order_id" = oi."order_id"
        JOIN   "products"    AS p ON p."product_id" = oi."product_id"
        WHERE  p."product_category_name" = 'brinquedos'
          AND  DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
        GROUP  BY dt
    ),
    stats AS (
        SELECT COUNT(*) AS n, SUM(x) AS sx, SUM(y) AS sy,
               SUM(x*x) AS sx2, SUM(x*y) AS sxy
        FROM daily
    )
    SELECT (n*sxy - sx*sy) / (n*sx2 - sx*sx)                       AS m,
           (sy - ((n*sxy - sx*sy)/(n*sx2 - sx*sx))*sx) / n         AS b
    FROM stats
),
num AS (                      /* generator 0‒7  =>  eight forecast days */
    SELECT 0 AS n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3
    UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7
),
future AS (                   /* 03-Dec-2018 … 10-Dec-2018 */
    SELECT DATE('2018-12-03','+'||n||' day') AS d FROM num
),
pred AS (                     /* predicted sales per date */
    SELECT d,
           (m * (julianday(d) - julianday('2017-01-01')) + b) AS yhat
    FROM   future, coeff
),
ma5 AS (                      /* 5-day centred moving average */
    SELECT p1.d,
           (SELECT AVG(p2.yhat)
              FROM pred AS p2
             WHERE p2.d BETWEEN DATE(p1.d,'-2 day') AND DATE(p1.d,'+2 day')) AS ma_5day
    FROM pred AS p1
)
SELECT DISTINCT d, ma_5day
FROM   ma5
WHERE  d BETWEEN '2018-12-05' AND '2018-12-08'
ORDER  BY d
LIMIT 20
