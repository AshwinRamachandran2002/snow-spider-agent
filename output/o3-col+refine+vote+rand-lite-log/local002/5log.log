Below are eight SQLite queries – from exploratory to the final computation – that can be executed sequentially.  
They extract the “toy” category, inspect a few products and sales, build the daily-sales time-series (01-Jan-2017 to 29-Aug-2018), fit a simple linear-regression model, project sales for 03-Dec-2018-–-10-Dec-2018, compute the 5-day symmetric moving-average for 05-Dec-2018-–-08-Dec-2018, and finally return the requested sum of those four moving-averages.

```sql
-- 1. Which Portuguese category name translates to English “toys” ?
SELECT DISTINCT "product_category_name", "product_category_name_english"
FROM "product_category_name_translation"
WHERE "product_category_name_english" LIKE '%toy%'        -- expect: brinquedos → toys
LIMIT 20;
```

```sql
-- 2. Peek at a few products that belong to that category (e.g., brinquedos).
SELECT DISTINCT "product_id", "product_category_name"
FROM "products"
WHERE "product_category_name" = 'brinquedos'
LIMIT 20;
```

```sql
-- 3. Sample order-items of toys together with their purchase dates.
SELECT DISTINCT oi."order_id", o."order_purchase_timestamp", oi."product_id"
FROM "order_items"  AS oi
JOIN "orders"       AS o ON o."order_id" = oi."order_id"
JOIN "products"     AS p ON p."product_id" = oi."product_id"
WHERE p."product_category_name" = 'brinquedos'
LIMIT 20;
```

```sql
-- 4. Build the daily toy-sales time-series (items sold per day).
SELECT DISTINCT DATE(o."order_purchase_timestamp") AS "sale_date",
       COUNT(*)                                   AS "toys_sold"
FROM "order_items"  AS oi
JOIN "orders"       AS o ON o."order_id" = oi."order_id"
JOIN "products"     AS p ON p."product_id" = oi."product_id"
WHERE p."product_category_name" = 'brinquedos'
  AND DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
GROUP BY "sale_date"
ORDER BY "sale_date"
LIMIT 20;
```

```sql
-- 5. Derive regression slope & intercept on that daily series.
WITH daily AS (
    SELECT DATE(o."order_purchase_timestamp") AS dt,
           COUNT(*)                           AS y,
           CAST(julianday(DATE(o."order_purchase_timestamp")) -
                julianday('2017-01-01')       AS REAL)      AS x
    FROM "order_items" AS oi
    JOIN "orders"      AS o ON o."order_id" = oi."order_id"
    JOIN "products"    AS p ON p."product_id" = oi."product_id"
    WHERE p."product_category_name" = 'brinquedos'
      AND DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
    GROUP BY dt
),
stats AS (
    SELECT COUNT(*)          AS n,
           SUM(x)            AS sum_x,
           SUM(y)            AS sum_y,
           SUM(x*x)          AS sum_x2,
           SUM(x*y)          AS sum_xy
    FROM daily
)
SELECT DISTINCT
       (n*sum_xy - sum_x*sum_y) / (n*sum_x2 - sum_x*sum_x)         AS "slope",
       (sum_y - ((n*sum_xy - sum_x*sum_y)/(n*sum_x2 - sum_x*sum_x))*sum_x) / n
                                                                   AS "intercept"
FROM stats;
```

```sql
-- 6. Predict toy sales for 03-Dec-2018 to 10-Dec-2018 (inclusive).
WITH coeff AS (
    -- same CTE as query 5 but kept minimal here by re-computing
    WITH daily AS (
        SELECT DATE(o."order_purchase_timestamp") AS dt,
               COUNT(*) AS y,
               CAST(julianday(DATE(o."order_purchase_timestamp")) -
                    julianday('2017-01-01') AS REAL) AS x
        FROM "order_items" AS oi
        JOIN "orders"      AS o ON o."order_id" = oi."order_id"
        JOIN "products"    AS p ON p."product_id" = oi."product_id"
        WHERE p."product_category_name" = 'brinquedos'
          AND DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
        GROUP BY dt
    ), stats AS (
        SELECT COUNT(*) AS n, SUM(x) AS sum_x, SUM(y) AS sum_y,
               SUM(x*x) AS sum_x2, SUM(x*y) AS sum_xy
        FROM daily
    )
    SELECT (n*sum_xy - sum_x*sum_y) / (n*sum_x2 - sum_x*sum_x) AS m,
           (sum_y - ((n*sum_xy - sum_x*sum_y)/(n*sum_x2 - sum_x*sum_x))*sum_x) / n AS b
    FROM stats
),
future_dates AS (
    SELECT DATE('2018-12-03', '+' || i || ' day') AS d
    FROM (SELECT 0 UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3
          UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7)
)
SELECT DISTINCT d AS "date_predicted",
       (m * (julianday(d) - julianday('2017-01-01')) + b) AS "predicted_sales"
FROM future_dates, coeff
ORDER BY d
LIMIT 20;
```

```sql
-- 7.  Five-day symmetric moving average of the projected series.
WITH coeff AS ( /* same as query 6 */ 
    WITH daily AS (
        SELECT DATE(o."order_purchase_timestamp") AS dt,
               COUNT(*) AS y,
               CAST(julianday(DATE(o."order_purchase_timestamp")) -
                    julianday('2017-01-01') AS REAL) AS x
        FROM "order_items" AS oi
        JOIN "orders"      AS o ON o."order_id" = oi."order_id"
        JOIN "products"    AS p ON p."product_id" = oi."product_id"
        WHERE p."product_category_name" = 'brinquedos'
          AND DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
        GROUP BY dt
    ), stats AS (
        SELECT COUNT(*) AS n, SUM(x) AS sum_x, SUM(y) AS sum_y,
               SUM(x*x) AS sum_x2, SUM(x*y) AS sum_xy
        FROM daily
    )
    SELECT (n*sum_xy - sum_x*sum_y) / (n*sum_x2 - sum_x*sum_x) AS m,
           (sum_y - ((n*sum_xy - sum_x*sum_y)/(n*sum_x2 - sum_x*sum_x))*sum_x) / n AS b
    FROM stats
),
future AS (
    SELECT DATE('2018-12-03', '+' || i || ' day') AS d
    FROM (SELECT 0 UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3
          UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7)
),
pred AS (
    SELECT d,
           (m * (julianday(d) - julianday('2017-01-01')) + b) AS yhat
    FROM future, coeff
),
ma5 AS (
    SELECT p1.d,
           (SELECT AVG(p2.yhat)
            FROM pred AS p2
            WHERE p2.d BETWEEN DATE(p1.d,'-2 day') AND DATE(p1.d,'+2 day')
           ) AS ma_5day
    FROM pred AS p1
)
SELECT DISTINCT d, ma_5day
FROM ma5
WHERE d BETWEEN '2018-12-05' AND '2018-12-08'
LIMIT 20;
```

```sql
-- 8. Sum of the four 5-day symmetric moving-averages (05-Dec-2018 → 08-Dec-2018).
WITH coeff AS ( /* identical coefficient CTE */ 
    WITH daily AS (
        SELECT DATE(o."order_purchase_timestamp") AS dt,
               COUNT(*) AS y,
               CAST(julianday(DATE(o."order_purchase_timestamp")) -
                    julianday('2017-01-01') AS REAL) AS x
        FROM "order_items" AS oi
        JOIN "orders"      AS o ON o."order_id" = oi."order_id"
        JOIN "products"    AS p ON p."product_id" = oi."product_id"
        WHERE p."product_category_name" = 'brinquedos'
          AND DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
        GROUP BY dt
    ), stats AS (
        SELECT COUNT(*) AS n, SUM(x) AS sum_x, SUM(y) AS sum_y,
               SUM(x*x) AS sum_x2, SUM(x*y) AS sum_xy
        FROM daily
    )
    SELECT (n*sum_xy - sum_x*sum_y) / (n*sum_x2 - sum_x*sum_x) AS m,
           (sum_y - ((n*sum_xy - sum_x*sum_y)/(n*sum_x2 - sum_x*sum_x))*sum_x) / n AS b
    FROM stats
),
future AS (
    SELECT DATE('2018-12-03', '+' || i || ' day') AS d
    FROM (SELECT 0 UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3
          UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7)
),
pred AS (
    SELECT d,
           (m * (julianday(d) - julianday('2017-01-01')) + b) AS yhat
    FROM future, coeff
),
ma5 AS (
    SELECT p1.d,
           (SELECT AVG(p2.yhat)
            FROM pred AS p2
            WHERE p2.d BETWEEN DATE(p1.d,'-2 day') AND DATE(p1.d,'+2 day')
           ) AS ma_5day
    FROM pred AS p1
)
SELECT DISTINCT SUM(ma_5day) AS "sum_5day_MA_dec5_to_dec8"
FROM ma5
WHERE d BETWEEN '2018-12-05' AND '2018-12-08';
```

Running the final query (No. 8) yields the single number required: the sum of the four 5-day symmetric moving-averages centred on 05-Dec-2018, 06-Dec-2018, 07-Dec-2018 and 08-Dec-2018.
