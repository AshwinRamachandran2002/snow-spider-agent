```sql
--Description:  In a single shot, compute the sum of the 5-day symmetric moving-averages
--              centred on 05-, 06-, 07-, 08-Dec-2018 for the “toys” category.
--              Steps embedded:
--              (1) Build historical daily toy-sales (01-Jan-2017–29-Aug-2018).
--              (2) Derive simple-linear-regression coefficients m (slope) & b (intercept).
--              (3) Generate the eight forecast dates 03-Dec-2018-–-10-Dec-2018.
--              (4) Predict sales for each using  ŷ = m·x + b  (x = days since 01-Jan-2017).
--              (5) From those eight values, form a 5-day centred moving-average for every
--                  date (needs ±2-day window, thus the 8-day span).
--              (6) Filter to the four centres 05-…-08-Dec-2018 and SUM their MAs.
WITH
coeff AS (                        /* steps 1 & 2: slope (m) and intercept (b) */
    WITH daily AS (
        SELECT DATE(o."order_purchase_timestamp")                                AS dt,
               COUNT(*)                                                          AS y,
               CAST(julianday(DATE(o."order_purchase_timestamp")) -
                    julianday('2017-01-01')                                      AS REAL) AS x
        FROM   "order_items" AS oi
        JOIN   "orders"      AS o  ON o."order_id"  = oi."order_id"
        JOIN   "products"    AS p  ON p."product_id"= oi."product_id"
        WHERE  p."product_category_name" = 'brinquedos'
          AND  DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
        GROUP  BY dt
    ),
    stats AS (
        SELECT COUNT(*) AS n,
               SUM(x)    AS sx,
               SUM(y)    AS sy,
               SUM(x*x)  AS sx2,
               SUM(x*y)  AS sxy
        FROM daily
    )
    SELECT (n*sxy - sx*sy) / (n*sx2 - sx*sx)                       AS m,
           (sy - ((n*sxy - sx*sy)/(n*sx2 - sx*sx))*sx) / n         AS b
    FROM stats
),
num AS (                        /* step 3: integers 0–7 → 8 forecast days */
    SELECT 0 AS n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3
    UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7
),
future AS (
    SELECT DATE('2018-12-03','+'||n||' day') AS d FROM num
),
pred AS (                       /* step 4: predicted sales for each date */
    SELECT d,
           (m * (julianday(d) - julianday('2017-01-01')) + b)  AS yhat
    FROM   future, coeff
),
ma5 AS (                        /* step 5: 5-day symmetric moving average */
    SELECT p1.d,
           (SELECT AVG(p2.yhat)
              FROM pred p2
             WHERE p2.d BETWEEN DATE(p1.d,'-2 day') AND DATE(p1.d,'+2 day')
           ) AS ma_5day
    FROM pred p1
)
SELECT SUM(ma_5day) AS sum_of_5day_MAs_05_to_08_Dec_2018          /* step 6 */
FROM   ma5
WHERE  d BETWEEN '2018-12-05' AND '2018-12-08';
```
