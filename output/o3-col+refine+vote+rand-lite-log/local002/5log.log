Query:
-- 5. Derive regression slope & intercept on that daily series.
WITH daily AS (
    SELECT DATE(o."order_purchase_timestamp") AS dt,
           COUNT(*)                           AS y,
           CAST(julianday(DATE(o."order_purchase_timestamp")) -
                julianday('2017-01-01')       AS REAL)      AS x
    FROM "order_items" AS oi
    JOIN "orders"      AS o ON o."order_id" = oi."order_id"
    JOIN "products"    AS p ON p."product_id" = oi."product_id"
    WHERE p."product_category_name" = 'brinquedos'
      AND DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
    GROUP BY dt
),
stats AS (
    SELECT COUNT(*)          AS n,
           SUM(x)            AS sum_x,
           SUM(y)            AS sum_y,
           SUM(x*x)          AS sum_x2,
           SUM(x*y)          AS sum_xy
    FROM daily
)
SELECT DISTINCT
       (n*sum_xy - sum_x*sum_y) / (n*sum_x2 - sum_x*sum_x)         AS "slope",
       (sum_y - ((n*sum_xy - sum_x*sum_y)/(n*sum_x2 - sum_x*sum_x))*sum_x) / n
                                                                   AS "intercept"
FROM stats;
