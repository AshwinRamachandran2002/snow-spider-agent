```sql
--Description: 1) Find the Portuguese name that translates to the English word “toys”.
SELECT DISTINCT "product_category_name",
                "product_category_name_english"
FROM   "product_category_name_translation"
WHERE  "product_category_name_english" = 'toys'
LIMIT 20;
```

```sql
--Description: 2) List a few product_ids that belong to the “toys” category.
SELECT DISTINCT p."product_id"
FROM   "products"                       AS p
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english" = 'toys'
LIMIT 20;
```

```sql
--Description: 3) Sample order-items that are toy products together with their selling price.
SELECT DISTINCT oi."order_id",
                oi."product_id",
                oi."price"
FROM   "order_items"                    AS oi
JOIN   "products"                       AS p  ON oi."product_id" = p."product_id"
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english" = 'toys'
LIMIT 20;
```

```sql
--Description: 4) Show individual toy sales (price) by purchase-date inside the modelling horizon.
SELECT DISTINCT date(o."order_purchase_timestamp") AS "sale_date",
                oi."price"
FROM   "orders"     AS o
JOIN   "order_items" AS oi ON o."order_id" = oi."order_id"
JOIN   "products"    AS p  ON oi."product_id" = p."product_id"
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english" = 'toys'
  AND  o."order_status" = 'delivered'
  AND  date(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
LIMIT 20;
```

```sql
--Description: 5) Aggregate to DAILY toy revenue for the modelling window.
SELECT DISTINCT date(o."order_purchase_timestamp")         AS "sale_date",
                SUM(oi."price")                            AS "daily_revenue"
FROM   "orders"     AS o
JOIN   "order_items" AS oi ON o."order_id" = oi."order_id"
JOIN   "products"    AS p  ON oi."product_id" = p."product_id"
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
WHERE  t."product_category_name_english" = 'toys'
  AND  o."order_status" = 'delivered'
  AND  date(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
GROUP  BY date(o."order_purchase_timestamp")
ORDER  BY "sale_date"
LIMIT 20;
```

```sql
--Description: 6) Collect the regression Sufficient-Statistics ( n, Σx, Σy, Σxy, Σx² ).
WITH toy_sales AS (
  SELECT date(o."order_purchase_timestamp") AS sale_date,
         SUM(oi."price")                    AS daily_sales
  FROM   "orders"   AS o
  JOIN   "order_items" AS oi ON o."order_id" = oi."order_id"
  JOIN   "products"  AS p  ON oi."product_id" = p."product_id"
  JOIN   "product_category_name_translation" AS t
         ON p."product_category_name" = t."product_category_name"
  WHERE  t."product_category_name_english" = 'toys'
    AND  o."order_status" = 'delivered'
    AND  date(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
  GROUP  BY sale_date
)
SELECT DISTINCT
       COUNT(*)                                                         AS n,
       SUM(JULIANDAY(sale_date) - JULIANDAY('2017-01-01'))              AS sum_x,
       SUM(daily_sales)                                                 AS sum_y,
       SUM((JULIANDAY(sale_date) - JULIANDAY('2017-01-01'))*daily_sales) AS sum_xy,
       SUM((JULIANDAY(sale_date) - JULIANDAY('2017-01-01'))*
           (JULIANDAY(sale_date) - JULIANDAY('2017-01-01')))            AS sum_xx
FROM   toy_sales
LIMIT 20;
```

```sql
--Description: 7) Translate those statistics into the LINEAR-REGRESSION parameters (slope & intercept).
WITH stats AS (
  /*  same toy_sales CTE as above  */
  WITH toy_sales AS (
    SELECT date(o."order_purchase_timestamp") AS sale_date,
           SUM(oi."price")                    AS daily_sales
    FROM   "orders"   AS o
    JOIN   "order_items" AS oi ON o."order_id" = oi."order_id"
    JOIN   "products"  AS p  ON oi."product_id" = p."product_id"
    JOIN   "product_category_name_translation" AS t
           ON p."product_category_name" = t."product_category_name"
    WHERE  t."product_category_name_english" = 'toys'
      AND  o."order_status" = 'delivered'
      AND  date(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
    GROUP  BY sale_date
  )
  SELECT COUNT(*)                                                      AS n,
         SUM(JULIANDAY(sale_date)-JULIANDAY('2017-01-01'))             AS sum_x,
         SUM(daily_sales)                                              AS sum_y,
         SUM((JULIANDAY(sale_date)-JULIANDAY('2017-01-01'))*daily_sales) AS sum_xy,
         SUM((JULIANDAY(sale_date)-JULIANDAY('2017-01-01'))*
             (JULIANDAY(sale_date)-JULIANDAY('2017-01-01')))           AS sum_xx
  FROM   toy_sales
)
SELECT DISTINCT
       ((n*sum_xy)-(sum_x*sum_y)) / ((n*sum_xx)-(sum_x*sum_x))         AS "slope",
       (sum_y - (((n*sum_xy)-(sum_x*sum_y))/
                 ((n*sum_xx)-(sum_x*sum_x)))*sum_x) / n               AS "intercept"
FROM   stats
LIMIT 20;
```

```sql
--Description: 8) Using the model, PREDICT daily toy sales for 3-Dec-2018 ► 10-Dec-2018.
WITH model AS (
  /* slope & intercept derived exactly as in Query-7 */
  WITH toy_sales AS (
    SELECT date(o."order_purchase_timestamp") AS sale_date,
           SUM(oi."price")                    AS daily_sales
    FROM   "orders"   AS o
    JOIN   "order_items" AS oi ON o."order_id" = oi."order_id"
    JOIN   "products"  AS p  ON oi."product_id" = p."product_id"
    JOIN   "product_category_name_translation" AS t
           ON p."product_category_name" = t."product_category_name"
    WHERE  t."product_category_name_english" = 'toys'
      AND  o."order_status" = 'delivered'
      AND  date(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
    GROUP  BY sale_date
  ),
  stats AS (
    SELECT COUNT(*) AS n,
           SUM(JULIANDAY(sale_date)-JULIANDAY('2017-01-01'))       AS sum_x,
           SUM(daily_sales)                                        AS sum_y,
           SUM((JULIANDAY(sale_date)-JULIANDAY('2017-01-01'))*
                daily_sales)                                       AS sum_xy,
           SUM((JULIANDAY(sale_date)-JULIANDAY('2017-01-01'))*
               (JULIANDAY(sale_date)-JULIANDAY('2017-01-01')))     AS sum_xx
    FROM   toy_sales
  )
  SELECT ((n*sum_xy)-(sum_x*sum_y))/((n*sum_xx)-(sum_x*sum_x))     AS slope,
         (sum_y - (((n*sum_xy)-(sum_x*sum_y))/((n*sum_xx)-(sum_x*sum_x)))*sum_x)/n AS intercept
  FROM   stats
),
forecast_days AS (
  SELECT date('2018-12-03','+'||i||' days') AS forecast_date
  FROM   (SELECT 0 AS i UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL
          SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL
          SELECT 6 UNION ALL SELECT 7)
),
predicted AS (
  SELECT f."forecast_date",
         m."intercept" +
         m."slope" * (JULIANDAY(f."forecast_date") - JULIANDAY('2017-01-01')) AS "predicted_sales"
  FROM   forecast_days f, model m
)
SELECT DISTINCT * FROM predicted
LIMIT 20;
```

```sql
--Description: 9) Compute each 5-day symmetric moving-average for 5-Dec-2018→8-Dec-2018 and sum them.
WITH model AS (
  /* identical derivation of slope & intercept as above */
  WITH toy_sales AS (
    SELECT date(o."order_purchase_timestamp") AS sale_date,
           SUM(oi."price")                    AS daily_sales
    FROM   "orders"   AS o
    JOIN   "order_items" AS oi ON o."order_id" = oi."order_id"
    JOIN   "products"  AS p  ON oi."product_id" = p."product_id"
    JOIN   "product_category_name_translation" AS t
           ON p."product_category_name" = t."product_category_name"
    WHERE  t."product_category_name_english" = 'toys'
      AND  o."order_status" = 'delivered'
      AND  date(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
    GROUP  BY sale_date
  ),
  stats AS (
    SELECT COUNT(*) AS n,
           SUM(JULIANDAY(sale_date)-JULIANDAY('2017-01-01'))       AS sum_x,
           SUM(daily_sales)                                        AS sum_y,
           SUM((JULIANDAY(sale_date)-JULIANDAY('2017-01-01'))*
                daily_sales)                                       AS sum_xy,
           SUM((JULIANDAY(sale_date)-JULIANDAY('2017-01-01'))*
               (JULIANDAY(sale_date)-JULIANDAY('2017-01-01')))     AS sum_xx
    FROM   toy_sales
  )
  SELECT ((n*sum_xy)-(sum_x*sum_y))/((n*sum_xx)-(sum_x*sum_x))     AS slope,
         (sum_y - (((n*sum_xy)-(sum_x*sum_y))/((n*sum_xx)-(sum_x*sum_x)))*sum_x)/n AS intercept
  FROM   stats
),
forecast_days AS (
  -- we forecast 1-Dec-2018 through 10-Dec-2018 so a 5-day window is complete
  SELECT date('2018-12-01','+'||i||' days') AS forecast_date
  FROM   (SELECT 0 AS i UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL
          SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL
          SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL
          SELECT 9)
),
predicted AS (
  SELECT f."forecast_date",
         m."intercept" +
         m."slope" * (JULIANDAY(f."forecast_date") - JULIANDAY('2017-01-01')) AS "predicted_sales"
  FROM   forecast_days f, model m
),
ma5 AS (
  -- 5-day symmetric moving average centred on each date
  SELECT p1."forecast_date",
         (SELECT AVG(p2."predicted_sales")
          FROM   predicted p2
          WHERE  p2."forecast_date"
                 BETWEEN date(p1."forecast_date",'-2 days')
                     AND date(p1."forecast_date",'+2 days')) AS "ma5"
  FROM   predicted p1
),
target AS (
  SELECT "ma5"
  FROM   ma5
  WHERE  "forecast_date" BETWEEN '2018-12-05' AND '2018-12-08'
)
SELECT DISTINCT SUM("ma5") AS "sum_of_four_ma5"
FROM   target
LIMIT 20;
```

These nine progressively more complex queries:

1. Locate the Portuguese “brinquedos” category.  
2. Fetch toy product_ids.  
3. Show toy order-items.  
4. Bring in purchase dates for toy orders.  
5. Aggregate daily toy revenue from 2017-01-01 to 2018-08-29.  
6. Gather regression statistics.  
7. Derive slope & intercept of the simple linear regression.  
8. Predict daily toy sales for 03-Dec-2018 → 10-Dec-2018.  
9. Calculate the 5-day symmetric moving averages for 05-Dec-2018 → 08-Dec-2018 and finally output the requested SUM of those four averages.
