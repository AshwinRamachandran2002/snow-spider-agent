```sql
-- Description: Find what the Portuguese category name is for “toys”.
SELECT DISTINCT "product_category_name",
                "product_category_name_english"
FROM   "product_category_name_translation"
WHERE  "product_category_name_english" LIKE '%toy%';
```

```sql
-- Description: Show 20 products that belong to the “brinquedos” (toys) category.
SELECT DISTINCT "product_id",
                "product_category_name"
FROM   "products"
WHERE  "product_category_name" = 'brinquedos'
LIMIT  20;
```

```sql
-- Description: Pick 20 toy‐item rows and look at their selling price & freight.
SELECT oi."order_id",
       oi."product_id",
       oi."price",
       oi."freight_value"
FROM   "order_items" AS oi
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
WHERE  p."product_category_name" = 'brinquedos'
LIMIT  20;
```

```sql
-- Description: Join orders with toy items to see the purchase date of each toy sale.
SELECT o."order_purchase_timestamp",
       oi."price"
FROM   "orders"      AS o
JOIN   "order_items" AS oi ON oi."order_id" = o."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
WHERE  p."product_category_name" = 'brinquedos'
LIMIT  20;
```

```sql
-- Description: Aggregate daily toy revenue (price only) – first 20 days returned.
SELECT DATE(o."order_purchase_timestamp")  AS "sale_date",
       SUM(oi."price")                     AS "daily_toy_revenue"
FROM   "orders"      AS o
JOIN   "order_items" AS oi ON oi."order_id" = o."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
WHERE  p."product_category_name" = 'brinquedos'
  AND  DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
GROUP  BY "sale_date"
ORDER  BY "sale_date"
LIMIT  20;
```

```sql
-- Description: Check that the daily toy series really starts on 2017-01-01.
SELECT MIN(DATE(o."order_purchase_timestamp")) AS "first_toy_date",
       MAX(DATE(o."order_purchase_timestamp")) AS "last_toy_date"
FROM   "orders"      AS o
JOIN   "order_items" AS oi ON oi."order_id" = o."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
WHERE  p."product_category_name" = 'brinquedos';
```

```sql
-- Description: Inspect toy sales on the last day we are allowed to use (2018-08-29).
SELECT DATE(o."order_purchase_timestamp") AS "sale_date",
       COUNT(*)                           AS "items_sold",
       SUM(oi."price")                    AS "revenue"
FROM   "orders"      AS o
JOIN   "order_items" AS oi ON oi."order_id" = o."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
WHERE  p."product_category_name" = 'brinquedos'
  AND  DATE(o."order_purchase_timestamp") = '2018-08-29'
GROUP  BY "sale_date";
```

```sql
-- Description: Grab the 20 most recent toy sales before 2018-08-29 to eyeball trend.
SELECT DATE(o."order_purchase_timestamp") AS "sale_date",
       SUM(oi."price")                    AS "daily_revenue"
FROM   "orders"      AS o
JOIN   "order_items" AS oi ON oi."order_id" = o."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
WHERE  p."product_category_name" = 'brinquedos'
  AND  DATE(o."order_purchase_timestamp") <= '2018-08-29'
GROUP  BY "sale_date"
ORDER  BY "sale_date" DESC
LIMIT  20;
```

```sql
-- Description: Daily count of toy orders (rather than item count) to see volume.
SELECT DATE(o."order_purchase_timestamp") AS "sale_date",
       COUNT(DISTINCT o."order_id")       AS "toy_orders"
FROM   "orders"      AS o
JOIN   "order_items" AS oi ON oi."order_id" = o."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
WHERE  p."product_category_name" = 'brinquedos'
  AND  DATE(o."order_purchase_timestamp") BETWEEN '2017-01-01' AND '2018-08-29'
GROUP  BY "sale_date"
ORDER  BY "sale_date"
LIMIT  20;
```

```sql
-- Description: Show toy revenue for an arbitrary in-season week to confirm data density.
SELECT DATE(o."order_purchase_timestamp") AS "sale_date",
       SUM(oi."price")                    AS "revenue"
FROM   "orders"      AS o
JOIN   "order_items" AS oi ON oi."order_id" = o."order_id"
JOIN   "products"    AS p  ON p."product_id" = oi."product_id"
WHERE  p."product_category_name" = 'brinquedos'
  AND  DATE(o."order_purchase_timestamp") BETWEEN '2017-12-01' AND '2017-12-07'
GROUP  BY "sale_date"
ORDER  BY "sale_date";
```

These 10 inspection queries reveal the daily series of toy sales needed to fit a linear regression (Jan 1 2017 → Aug 29 2018). With that regression we would forecast daily toy sales for Dec 5, 6, 7, 8 of 2018, take each day’s 5-day symmetric moving average (window centered on the day, i.e. two days before & after), and finally sum the four 5-day averages.
