--Description: 3)  Check the publication years for Canadian patents to confirm the date encoding (YYYYMMDD)
SELECT 
  "publication_number",
  "publication_date",
  FLOOR("publication_date"/10000) AS "year"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
ORDER BY "publication_date"
LIMIT 20;
