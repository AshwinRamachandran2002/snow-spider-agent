  COUNT(inv.value) AS "inventor_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS,
     LATERAL FLATTEN(input => "inventor") inv
WHERE "country_code" = 'CA'
GROUP BY "publication_number"
LIMIT 20;
```

```sql
--Description: 8)  Aggregate Canadian publications by 5-year period: total pubs & average inventors (pre-lim check)
SELECT 
  TO_CHAR( 1960 + 5 * FLOOR( (yr - 1960) / 5 ) ) || '-' || 
  TO_CHAR( 1964 + 5 * FLOOR( (yr - 1960) / 5 ) )                  AS "period_5yr",
  COUNT(DISTINCT "publication_number")                            AS "pub_cnt",
  AVG("inventor_cnt")                                             AS "avg_inventors"
FROM (
    SELECT 
      "publication_number",
      FLOOR("publication_date"/10000)           AS yr,
      COUNT(inv.value)                          AS inventor_cnt
    FROM PATENTS.PATENTS.PUBLICATIONS,
         LATERAL FLATTEN(input => "inventor") inv
    WHERE "country_code" = 'CA'
    GROUP BY "publication_number", yr
) t
GROUP BY "period_5yr"
ORDER BY "period_5yr"
LIMIT 20;
```

```sql
--Description: 9)  Same as above but restricted to the 1960-2020 window only
SELECT 
  "period_5yr",
  COUNT(*)         AS "pub_cnt",
  AVG("inv_cnt")   AS "avg_inventors"
FROM (
    SELECT 
      "publication_number",
      TO_CHAR( 1960 + 5*FLOOR( (yr-1960)/5 ) ) || '-' || TO_CHAR(1964+5*FLOOR( (yr-1960)/5 )) AS "period_5yr",
      COUNT(inv.value) AS "inv_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS,
         LATERAL FLATTEN(input => "inventor") inv
    WHERE "country_code" = 'CA'
      AND yr BETWEEN 1960 AND 2020
    GROUP BY "publication_number", "period_5yr"
) s
GROUP BY "period_5yr"
ORDER BY "period_5yr"
LIMIT 20;
```

```sql
--Description: 10)  Final query blueprint (no LIMIT) for the required answer—average inventors & pub count per 5-year period, 1960-2020, Canadian patents with ≥1 inventor
SELECT 
  "period_5yr",
  COUNT(*)                     AS "publication_count",
  AVG("inventor_count")        AS "avg_inventors_per_patent"
FROM (
    SELECT 
      "publication_number",
      TO_CHAR(1960 + 5*FLOOR((yr-1960)/5)) || '-' || TO_CHAR(1964 + 5*FLOOR((yr-1960)/5)) AS "period_5yr",
      COUNT(inv.value) AS "inventor_count"
    FROM PATENTS.PATENTS.PUBLICATIONS,
         LATERAL FLATTEN(input => "inventor") inv
    WHERE "country_code" = 'CA'
      AND "inventor" IS NOT NULL
      AND COUNT(inv.value) > 0 -- ensures at least one inventor
      AND yr BETWEEN 1960 AND 2020
    GROUP BY "publication_number", yr
)
GROUP BY "period_5yr"
ORDER BY "period_5yr";
```
