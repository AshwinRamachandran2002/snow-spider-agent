```sql
--Description / Thinking process:
-- • Target: Canadian patent publications (country_code = 'CA') between 1960-2020.
-- • Step-1: In a sub-query flatten the JSON array "inventor" to count inventors per
--           publication -> "inventor_cnt".  Filter out publications that end up with 0 inventors.
-- • Step-2: Derive the 5-year bucket for each publication year using
--           1960 + 5*FLOOR((year-1960)/5)   (lower bound)  and 1964 + … (upper bound).
-- • Step-3: In the outer query group by that bucket, return:
--             1) COUNT of distinct publications,
--             2) AVG of inventor counts.
-- • All identifiers are double-quoted to avoid Snowflake case-sensitivity issues.

SELECT
    TO_CHAR(1960 + 5 * FLOOR( ("yr" - 1960) / 5 )) || '-' ||
    TO_CHAR(1964 + 5 * FLOOR( ("yr" - 1960) / 5 ))          AS "period_5yr",
    COUNT(DISTINCT "publication_number")                    AS "publication_count",
    AVG("inventor_cnt")                                     AS "avg_inventors_per_patent"
FROM (
    SELECT
        "publication_number",
        FLOOR("publication_date" / 10000)                   AS "yr",
        COUNT(inv.value)                                    AS "inventor_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS,
         LATERAL FLATTEN(input => "inventor") inv
    WHERE "country_code" = 'CA'
    GROUP BY "publication_number", "yr"
    HAVING COUNT(inv.value) > 0
) t
WHERE "yr" BETWEEN 1960 AND 2020
GROUP BY "period_5yr"
ORDER BY "period_5yr";
```
