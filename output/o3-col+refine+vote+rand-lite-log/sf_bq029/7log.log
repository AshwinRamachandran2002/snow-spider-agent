--Description: 6)  Flatten inventors to view individual names for a handful of Canadian records
SELECT 
  "publication_number",
  inv.value::STRING AS "inventor_name"
FROM PATENTS.PATENTS.PUBLICATIONS,
     LATERAL FLATTEN(input => "inventor") inv
WHERE "country_code" = 'CA'
LIMIT 20;
