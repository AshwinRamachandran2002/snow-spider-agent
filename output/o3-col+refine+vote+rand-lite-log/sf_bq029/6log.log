Query:
--Description: 5) Check distribution of inventor counts (how many publications have N inventors)
SELECT
  inventor_cnt,
  COUNT(*) AS pub_cnt
FROM (
    SELECT
      t."publication_number",
      COUNT(f.value) AS inventor_cnt
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN( INPUT => t."inventor") f
    WHERE t."country_code" = 'CA'
    GROUP BY t."publication_number"
) s
GROUP BY inventor_cnt
ORDER BY inventor_cnt
LIMIT 20;
