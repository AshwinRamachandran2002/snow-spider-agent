```sql
--Description / Thinking process:
-- Goal: For Canadian (CA) patent publications between 1960-2020:
--   • Put each publication into a 5-year bucket (1960-1964, 1965-1969, … , 2020 only reaches 2020).
--   • Count inventors per publication (need ≥1, ensured by flattening the JSON array “inventor”).
--   • For every bucket, return total number of publications and the average inventor count.
-- Steps:
--   1. In sub-query “x”:
--        ‑ Flatten inventor array → COUNT(f.value) as inventor_cnt.
--        ‑ Derive publication year from yyyymmdd integer (publication_date / 10000).
--        ‑ Build bucket start: FLOOR((year-1960)/5)*5 + 1960  AS period_start.
--        ‑ GROUP BY publication_number to keep one row per patent.
--   2. In outer query:
--        ‑ GROUP BY period_start to aggregate pub count and AVG(inventor_cnt).
--   3. Order chronologically.

SELECT
    period_start                   AS "period_start_year",
    period_start + 4               AS "period_end_year",
    COUNT(*)                       AS "publication_cnt",
    AVG(inventor_cnt)::DECIMAL(10,2) AS "avg_inventor_cnt"
FROM (
    SELECT
        /* 5-year bucket calculation */
        FLOOR(((t."publication_date" / 10000)::INT - 1960) / 5) * 5 + 1960 AS period_start,
        t."publication_number",
        COUNT(f.value) AS inventor_cnt
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(INPUT => t."inventor") f
    WHERE t."country_code" = 'CA'
      AND (t."publication_date" / 10000) BETWEEN 1960 AND 2020
    GROUP BY period_start, t."publication_number"
) x
GROUP BY period_start
ORDER BY period_start;
```
