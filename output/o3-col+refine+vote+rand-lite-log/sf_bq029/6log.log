```sql
--Description: 2) Extract the publication year so we can later build 5-year buckets
SELECT 
  "publication_number",
  ( "publication_date" / 10000 )::INT AS "pub_year"          --yyyymmdd → yyyy
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
LIMIT 20;
```

```sql
--Description: 3) Flatten the inventor JSON array for a few CA records to inspect its structure
SELECT 
  t."publication_number",
  f.value::STRING AS "inventor_name"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN( INPUT => t."inventor") f
WHERE t."country_code" = 'CA'
LIMIT 20;
```

```sql
--Description: 4) Count inventors per publication (sample of 20) to verify counting logic
SELECT
  t."publication_number",
  COUNT(f.value) AS "inventor_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN( INPUT => t."inventor") f
WHERE t."country_code" = 'CA'
GROUP BY t."publication_number"
LIMIT 20;
```

```sql
--Description: 5) Check distribution of inventor counts (how many publications have N inventors)
SELECT
  inventor_cnt,
  COUNT(*) AS pub_cnt
FROM (
    SELECT
      t."publication_number",
      COUNT(f.value) AS inventor_cnt
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN( INPUT => t."inventor") f
    WHERE t."country_code" = 'CA'
    GROUP BY t."publication_number"
) s
GROUP BY inventor_cnt
ORDER BY inventor_cnt
LIMIT 20;
```

```sql
--Description: 6) List distinct publication years for CA to see available time-range
SELECT DISTINCT
  ( "publication_date" / 10000 )::INT AS "pub_year"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
ORDER BY "pub_year"
LIMIT 20;
```

```sql
--Description: 7) Build 5-year buckets for CA publications (sample) to verify bucket logic
SELECT
  "publication_number",
  ( "publication_date" / 10000 )::INT AS "pub_year",
  FLOOR( ( ( "publication_date" / 10000 )::INT - 1960 ) / 5 ) * 5 + 1960 AS "period_start"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
  AND ( "publication_date" / 10000 ) BETWEEN 1960 AND 2020
LIMIT 20;
```

```sql
--Description: 8) Aggregate inventor counts per publication together with 5-year period (no limit yet)
SELECT
  FLOOR( ( ( t."publication_date" / 10000 )::INT - 1960 ) / 5 ) * 5 + 1960 AS "period_start",
  s."inventor_cnt"
FROM (
    SELECT
      t."publication_number",
      t."publication_date",
      COUNT(f.value) AS inventor_cnt
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN( INPUT => t."inventor") f
    WHERE t."country_code" = 'CA'
      AND ( t."publication_date" / 10000 ) BETWEEN 1960 AND 2020
    GROUP BY t."publication_number", t."publication_date"
) s
JOIN PATENTS.PATENTS.PUBLICATIONS t
  ON s."publication_number" = t."publication_number"
LIMIT 20;
```

```sql
--Description: 9) FINAL – compute, for each 5-year interval 1960-2020, the total number of CA publications
--            and the average number of inventors per publication (only those with ≥1 inventor)
SELECT
  period_start                                 AS "period_start_year",
  period_start + 4                             AS "period_end_year",
  COUNT(*)                                     AS "publication_cnt",
  AVG(inventor_cnt)::DECIMAL(10,2)             AS "avg_inventor_cnt"
FROM (
    SELECT
      FLOOR( ( ( t."publication_date" / 10000 )::INT - 1960 ) / 5 ) * 5 + 1960 AS period_start,
      t."publication_number",
      COUNT(f.value) AS inventor_cnt
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN( INPUT => t."inventor") f
    WHERE t."country_code" = 'CA'
      AND ( t."publication_date" / 10000 ) BETWEEN 1960 AND 2020
    GROUP BY period_start, t."publication_number"
) x
GROUP BY period_start
ORDER BY period_start;
```

