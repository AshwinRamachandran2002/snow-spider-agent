--Description: Compute Canadian publications (1960-2020) by 5-year buckets:
--             • total publication count
--             • average number of inventors per publication (≥1 inventor).
SELECT
    x.period_start                      AS "period_start_year",
    x.period_start + 4                  AS "period_end_year",
    COUNT(*)                            AS "publication_cnt",
    AVG(x.inventor_cnt)::DECIMAL(10,2)  AS "avg_inventor_cnt"
FROM (
    SELECT
        /* derive 5-year bucket beginning */
        FLOOR(((t."publication_date" / 10000)::INT - 1960) / 5) * 5 + 1960 AS period_start,
        t."publication_number",
        COUNT(f.value) AS inventor_cnt
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(INPUT => t."inventor") f
    WHERE t."country_code" = 'CA'
      AND (t."publication_date" / 10000) BETWEEN 1960 AND 2020
    GROUP BY period_start, t."publication_number"
) x
GROUP BY x.period_start
ORDER BY x.period_start;
