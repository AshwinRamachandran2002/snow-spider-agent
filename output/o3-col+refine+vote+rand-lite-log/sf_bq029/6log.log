Query:
--Description: 7) Build 5-year buckets for CA publications (sample) to verify bucket logic
SELECT
  "publication_number",
  ( "publication_date" / 10000 )::INT AS "pub_year",
  FLOOR( ( ( "publication_date" / 10000 )::INT - 1960 ) / 5 ) * 5 + 1960 AS "period_start"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
  AND ( "publication_date" / 10000 ) BETWEEN 1960 AND 2020
LIMIT 20;
