```sql
--Description: 1) View 20 distinct country codes available in the PUBLICATIONS table
SELECT DISTINCT "country_code"
FROM PATENTS.PATENTS.PUBLICATIONS
LIMIT 20;
```

```sql
--Description: 2) Show 20 sample Canadian (CA) patent publications with their publication dates
SELECT "publication_number",
       "publication_date",
       "family_id",
       "inventor"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
LIMIT 20;
```

```sql
--Description: 3) Quick look at earliest & latest publication dates for Canadian patents
SELECT MIN("publication_date") AS "min_pub_date",
       MAX("publication_date") AS "max_pub_date"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA';
```

```sql
--Description: 4) Inspect the raw JSON structure of the "inventor" column for Canadian publications
SELECT "publication_number",
       "inventor"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
LIMIT 20;
```

```sql
--Description: 5) Flatten the inventor array for Canadian publications to list individual inventors
SELECT t."publication_number",
       f.value::STRING AS "inventor_name"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."inventor") f
WHERE t."country_code" = 'CA'
LIMIT 20;
```

```sql
--Description: 6) Count number of inventors per Canadian publication (first 20 rows)
SELECT t."publication_number",
       COUNT(f.value) AS "inventor_count"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."inventor") f
WHERE t."country_code" = 'CA'
GROUP BY t."publication_number"
LIMIT 20;
```

```sql
--Description: 7) Compute inventor counts per patent and show ones published between 1960-1964
SELECT t."publication_number",
       t."publication_date",
       COUNT(f.value) AS "inventor_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."inventor") f
WHERE t."country_code" = 'CA'
  AND t."publication_date" BETWEEN 19600101 AND 19641231
GROUP BY t."publication_number", t."publication_date"
LIMIT 20;
```

```sql
--Description: 8) Aggregate to 5-year buckets (1960-1964, 1965-1969, …) – show inventor totals & publication counts (first 20 buckets if any)
SELECT FLOOR(("publication_date"/10000 - 1960) / 5) AS "bucket_idx",
       COUNT(DISTINCT t."publication_number") AS "pub_count",
       SUM("inventor_per_patent") AS "total_inventors"
FROM (
    SELECT t."publication_number",
           t."publication_date",
           COUNT(f.value) AS "inventor_per_patent"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."inventor") f
    WHERE t."country_code" = 'CA'
    GROUP BY t."publication_number", t."publication_date"
) t
GROUP BY FLOOR((t."publication_date"/10000 - 1960) / 5)
ORDER BY "bucket_idx"
LIMIT 20;
```

```sql
--Description: 9) Extend previous query to compute average inventors per patent for each 5-year bucket (limit 20 results)
SELECT (1960 + "bucket_idx"*5) AS "start_year",
       (1964 + "bucket_idx"*5) AS "end_year",
       "pub_count",
       ROUND("total_inventors"::FLOAT / "pub_count", 2) AS "avg_inventors_per_patent"
FROM (
    SELECT FLOOR(("publication_date"/10000 - 1960) / 5) AS "bucket_idx",
           COUNT(DISTINCT "publication_number") AS "pub_count",
           SUM("inventor_per_patent") AS "total_inventors"
    FROM (
        SELECT t."publication_number",
               t."publication_date",
               COUNT(f.value) AS "inventor_per_patent"
        FROM PATENTS.PATENTS.PUBLICATIONS t,
             LATERAL FLATTEN(input => t."inventor") f
        WHERE t."country_code" = 'CA'
        GROUP BY t."publication_number", t."publication_date"
    ) s
    GROUP BY FLOOR((s."publication_date"/10000 - 1960) / 5)
) q
ORDER BY "start_year"
LIMIT 20;
```

```sql
--Description: 10) Verify that every record used in aggregation actually had at least one inventor listed (quick sanity sample)
SELECT "publication_number",
       "publication_date",
       ARRAY_SIZE("inventor") AS "raw_inventor_array_len"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
  AND ARRAY_SIZE("inventor") > 0
LIMIT 20;
```
