Query:
-- Description: 7) Convert numeric yyyymmdd into its 4–digit year and derive a five-year bucket label.
SELECT
  "publication_number",
  "publication_date",
  CAST(SUBSTRING("publication_date", 1, 4) AS INTEGER) AS "pub_year",
  CONCAT(
        5 * FLOOR( (CAST(SUBSTRING("publication_date", 1, 4) AS INTEGER) - 1960) / 5 ) + 1960,
        '-',
        5 * FLOOR( (CAST(SUBSTRING("publication_date", 1, 4) AS INTEGER) - 1960) / 5 ) + 1964
       ) AS "five_year_period"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
LIMIT 20;
