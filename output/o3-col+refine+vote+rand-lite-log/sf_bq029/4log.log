Query:
-- Description: 6) Build a helper view (inline) giving each CA publication its inventor count; return only those having ≥1 inventor.
SELECT
  pub_with_inv."publication_number",
  pub_with_inv."publication_date",
  pub_with_inv."inventor_cnt"
FROM (
  SELECT
    p."publication_number",
    p."publication_date",
    COUNT(i.value) AS "inventor_cnt"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."inventor") i
  WHERE p."country_code" = 'CA'
  GROUP BY p."publication_number", p."publication_date"
) pub_with_inv
WHERE pub_with_inv."inventor_cnt" > 0
LIMIT 20;
