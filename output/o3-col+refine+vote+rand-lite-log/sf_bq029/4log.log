```sql
-- Description: 1) Peek at a few Canadian (“CA”) publications to confirm the key fields we will use.
SELECT 
  "publication_number",
  "country_code",
  "publication_date",
  "inventor"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
LIMIT 20;
```

```sql
-- Description: 2) Inspect distinct year‐values (first 4 digits of publication_date) for Canadian records.
SELECT DISTINCT 
  SUBSTRING("publication_date", 1, 4) AS "pub_year"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
ORDER BY "pub_year"
LIMIT 20;
```

```sql
-- Description: 3) Look at the raw JSON array stored in "inventor" for a few Canadian publications.
SELECT 
  "publication_number",
  "inventor"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
  AND "inventor" <> '[]'
LIMIT 20;
```

```sql
-- Description: 4) Flatten the "inventor" array so each inventor appears in its own row (sample).
SELECT 
  p."publication_number",
  i.value::STRING AS "inventor_name"
FROM PATENTS.PATENTS.PUBLICATIONS  p,
     LATERAL FLATTEN(input => p."inventor") i
WHERE p."country_code" = 'CA'
LIMIT 20;
```

```sql
-- Description: 5) Count inventors per publication for Canadian grants/applications.
SELECT
  p."publication_number",
  COUNT(i.value) AS "inventor_count"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."inventor") i
WHERE p."country_code" = 'CA'
GROUP BY p."publication_number"
LIMIT 20;
```

```sql
-- Description: 6) Build a helper view (inline) giving each CA publication its inventor count; return only those having ≥1 inventor.
SELECT
  pub_with_inv."publication_number",
  pub_with_inv."publication_date",
  pub_with_inv."inventor_cnt"
FROM (
  SELECT
    p."publication_number",
    p."publication_date",
    COUNT(i.value) AS "inventor_cnt"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."inventor") i
  WHERE p."country_code" = 'CA'
  GROUP BY p."publication_number", p."publication_date"
) pub_with_inv
WHERE pub_with_inv."inventor_cnt" > 0
LIMIT 20;
```

```sql
-- Description: 7) Convert numeric yyyymmdd into its 4–digit year and derive a five-year bucket label.
SELECT
  "publication_number",
  "publication_date",
  CAST(SUBSTRING("publication_date", 1, 4) AS INTEGER) AS "pub_year",
  CONCAT(
        5 * FLOOR( (CAST(SUBSTRING("publication_date", 1, 4) AS INTEGER) - 1960) / 5 ) + 1960,
        '-',
        5 * FLOOR( (CAST(SUBSTRING("publication_date", 1, 4) AS INTEGER) - 1960) / 5 ) + 1964
       ) AS "five_year_period"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
LIMIT 20;
```

```sql
-- Description: 8) Combine inventor counting with the five-year period calculation (sample rows).
SELECT
  base."publication_number",
  base."inventor_cnt",
  base."five_year_period"
FROM (
  SELECT
    p."publication_number",
    COUNT(i.value)                    AS "inventor_cnt",
    CONCAT(
          5 * FLOOR( (CAST(SUBSTRING(p."publication_date", 1, 4) AS INTEGER) - 1960) / 5 ) + 1960,
          '-',
          5 * FLOOR( (CAST(SUBSTRING(p."publication_date", 1, 4) AS INTEGER) - 1960) / 5 ) + 1964
         )                            AS "five_year_period"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."inventor") i
  WHERE p."country_code" = 'CA'
  GROUP BY p."publication_number", p."publication_date"
) base
WHERE base."inventor_cnt" > 0
LIMIT 20;
```

```sql
-- Description: 9) Aggregate to get the average number of inventors and the total count of CA publications per five-year period (full list).
SELECT
  period_stats."five_year_period",
  COUNT(*)                                            AS "total_publications",
  AVG(period_stats."inventor_cnt")                    AS "avg_inventors_per_patent"
FROM (
  SELECT
    p."publication_number",
    COUNT(i.value) AS "inventor_cnt",
    CONCAT(
          5 * FLOOR( (CAST(SUBSTRING(p."publication_date", 1, 4) AS INTEGER) - 1960) / 5 ) + 1960,
          '-',
          5 * FLOOR( (CAST(SUBSTRING(p."publication_date", 1, 4) AS INTEGER) - 1960) / 5 ) + 1964
         )        AS "five_year_period"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."inventor") i
  WHERE p."country_code" = 'CA'
  GROUP BY p."publication_number", p."publication_date"
) period_stats
WHERE period_stats."inventor_cnt" > 0
GROUP BY period_stats."five_year_period"
ORDER BY period_stats."five_year_period"
LIMIT 20;
```

```sql
-- Description: 10) Same as (9) but restricted to periods 1960-2020 inclusive and ordered chronologically.
SELECT
  period_stats."five_year_period",
  COUNT(*)                             AS "total_publications",
  AVG(period_stats."inventor_cnt")     AS "avg_inventors_per_patent"
FROM (
  SELECT
    p."publication_number",
    COUNT(i.value) AS "inventor_cnt",
    CONCAT(
          5 * FLOOR( (CAST(SUBSTRING(p."publication_date", 1, 4) AS INTEGER) - 1960) / 5 ) + 1960,
          '-',
          5 * FLOOR( (CAST(SUBSTRING(p."publication_date", 1, 4) AS INTEGER) - 1960) / 5 ) + 1964
         ) AS "five_year_period"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."inventor") i
  WHERE p."country_code" = 'CA'
  GROUP BY p."publication_number", p."publication_date"
) period_stats
WHERE period_stats."inventor_cnt" > 0
  AND TO_NUMBER(SUBSTRING(period_stats."five_year_period", 1, 4)) BETWEEN 1960 AND 2020
GROUP BY period_stats."five_year_period"
ORDER BY TO_NUMBER(SUBSTRING(period_stats."five_year_period", 1, 4))
LIMIT 20;
```
