Query:
-- Description: 10) Same as (9) but restricted to periods 1960-2020 inclusive and ordered chronologically.
SELECT
  period_stats."five_year_period",
  COUNT(*)                             AS "total_publications",
  AVG(period_stats."inventor_cnt")     AS "avg_inventors_per_patent"
FROM (
  SELECT
    p."publication_number",
    COUNT(i.value) AS "inventor_cnt",
    CONCAT(
          5 * FLOOR( (CAST(SUBSTRING(p."publication_date", 1, 4) AS INTEGER) - 1960) / 5 ) + 1960,
          '-',
          5 * FLOOR( (CAST(SUBSTRING(p."publication_date", 1, 4) AS INTEGER) - 1960) / 5 ) + 1964
         ) AS "five_year_period"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."inventor") i
  WHERE p."country_code" = 'CA'
  GROUP BY p."publication_number", p."publication_date"
) period_stats
WHERE period_stats."inventor_cnt" > 0
  AND TO_NUMBER(SUBSTRING(period_stats."five_year_period", 1, 4)) BETWEEN 1960 AND 2020
GROUP BY period_stats."five_year_period"
ORDER BY TO_NUMBER(SUBSTRING(period_stats."five_year_period", 1, 4))
LIMIT 20;
