```sql
--Description: Show how to assign each CA patent to a 5-year period bucket between 1960-2020  
SELECT "publication_number",
       FLOOR("publication_date" / 10000) AS "pub_year",
       1960 + 5 * FLOOR((FLOOR("publication_date" / 10000) - 1960) / 5) AS "period_start"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
  AND "publication_date" BETWEEN 19600101 AND 20201231
LIMIT 20;
```

```sql
--Description: Compute inventor counts and 5-year buckets for CA patents (intermediate result)  
WITH inventor_cnt AS (
  SELECT p."publication_number",
         COUNT(*) AS "inventor_cnt",
         FLOOR(p."publication_date" / 10000) AS "pub_year"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => PARSE_JSON(p."inventor")) f
  WHERE p."country_code" = 'CA'
    AND p."publication_date" BETWEEN 19600101 AND 20201231
    AND p."inventor" IS NOT NULL
    AND ARRAY_SIZE(PARSE_JSON(p."inventor")) > 0
  GROUP BY p."publication_number", FLOOR(p."publication_date" / 10000)
)
SELECT *,
       1960 + 5 * FLOOR((pub_year - 1960) / 5) AS "period_start"
FROM inventor_cnt
LIMIT 20;
```

```sql
--Description: Final aggregation – average inventors per patent and total publications per 5-year period (limited preview)  
WITH inventor_cnt AS (
  SELECT p."publication_number",
         COUNT(*) AS "inventor_cnt",
         FLOOR(p."publication_date" / 10000) AS "pub_year"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => PARSE_JSON(p."inventor")) f
  WHERE p."country_code" = 'CA'
    AND p."publication_date" BETWEEN 19600101 AND 20201231
    AND p."inventor" IS NOT NULL
    AND ARRAY_SIZE(PARSE_JSON(p."inventor")) > 0
  GROUP BY p."publication_number", FLOOR(p."publication_date" / 10000)
)
SELECT 1960 + 5 * FLOOR((pub_year - 1960) / 5) AS "period_start",
       COUNT(*) AS "total_publications",
       AVG(inventor_cnt) AS "avg_inventors_per_patent"
FROM inventor_cnt
GROUP BY 1960 + 5 * FLOOR((pub_year - 1960) / 5)
ORDER BY "period_start"
LIMIT 20;
```

