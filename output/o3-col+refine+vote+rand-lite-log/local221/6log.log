```sql
--Description: Inspect a sample of distinct teams available in the data set.
SELECT DISTINCT "team_long_name", "team_api_id"
FROM "Team"
LIMIT 20;
```

```sql
--Description: Look at a handful of matches to understand the goal columns that will let us decide who won.
SELECT "match_api_id",
       "home_team_api_id",
       "away_team_api_id",
       "home_team_goal",
       "away_team_goal"
FROM "Match"
LIMIT 20;
```

```sql
--Description: Count wins that happened while the team was playing at home (home-team wins).
SELECT "home_team_api_id" AS team_api_id,
       COUNT(*)            AS home_wins
FROM "Match"
WHERE "home_team_goal" > "away_team_goal"
GROUP BY "home_team_api_id"
ORDER BY home_wins DESC
LIMIT 20;
```

```sql
--Description: Count wins that happened while the team was playing away (away-team wins).
SELECT "away_team_api_id" AS team_api_id,
       COUNT(*)            AS away_wins
FROM "Match"
WHERE "away_team_goal" > "home_team_goal"
GROUP BY "away_team_api_id"
ORDER BY away_wins DESC
LIMIT 20;
```

```sql
--Description: Combine home-wins and away-wins to get total wins per team.
SELECT team_api_id,
       SUM(wins) AS total_wins
FROM (
        SELECT "home_team_api_id" AS team_api_id,
               COUNT(*)           AS wins
        FROM "Match"
        WHERE "home_team_goal" > "away_team_goal"
        GROUP BY "home_team_api_id"
        UNION ALL
        SELECT "away_team_api_id" AS team_api_id,
               COUNT(*)           AS wins
        FROM "Match"
        WHERE "away_team_goal" > "home_team_goal"
        GROUP BY "away_team_api_id"
     )
GROUP BY team_api_id
ORDER BY total_wins DESC
LIMIT 20;
```

```sql
--Description: Join the total-wins table with the Team table to attach readable team names.
SELECT t."team_long_name",
       w."total_wins"
FROM (
        SELECT team_api_id,
               SUM(wins) AS total_wins
        FROM (
                SELECT "home_team_api_id" AS team_api_id,
                       COUNT(*)           AS wins
                FROM "Match"
                WHERE "home_team_goal" > "away_team_goal"
                GROUP BY "home_team_api_id"
                UNION ALL
                SELECT "away_team_api_id" AS team_api_id,
                       COUNT(*)           AS wins
                FROM "Match"
                WHERE "away_team_goal" > "home_team_goal"
                GROUP BY "away_team_api_id"
             )
        GROUP BY team_api_id
     ) AS w
JOIN "Team" AS t
  ON t."team_api_id" = w.team_api_id
ORDER BY w.total_wins DESC
LIMIT 20;
```

```sql
--Description: Final answer – the top-10 teams with the most wins across the entire league history.
SELECT t."team_long_name" AS team,
       w."total_wins"     AS wins
FROM (
        SELECT team_api_id,
               SUM(wins) AS total_wins
        FROM (
                SELECT "home_team_api_id" AS team_api_id,
                       COUNT(*)           AS wins
                FROM "Match"
                WHERE "home_team_goal" > "away_team_goal"
                GROUP BY "home_team_api_id"
                UNION ALL
                SELECT "away_team_api_id" AS team_api_id,
                       COUNT(*)           AS wins
                FROM "Match"
                WHERE "away_team_goal" > "home_team_goal"
                GROUP BY "away_team_api_id"
             )
        GROUP BY team_api_id
     ) AS w
JOIN "Team" AS t
  ON t."team_api_id" = w.team_api_id
ORDER BY wins DESC
LIMIT 10;
```
