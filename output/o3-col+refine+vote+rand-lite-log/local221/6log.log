Query:
--Description: Count wins that happened while the team was playing at home (home-team wins).
SELECT "home_team_api_id" AS team_api_id,
       COUNT(*)            AS home_wins
FROM "Match"
WHERE "home_team_goal" > "away_team_goal"
GROUP BY "home_team_api_id"
ORDER BY home_wins DESC
LIMIT 20;
