```sql
--Description: Look at a few matches to understand where the home/away team and score information live.
SELECT DISTINCT "id",
       "home_team_api_id",
       "away_team_api_id",
       "home_team_goal",
       "away_team_goal"
FROM   "Match"
LIMIT 20;
```

```sql
--Description: Identify the teams that won when playing at home (just show 20 distinct winners to check).
SELECT DISTINCT "home_team_api_id" AS "team_api_id"
FROM   "Match"
WHERE  "home_team_goal" > "away_team_goal"
LIMIT 20;
```

```sql
--Description: Identify the teams that won when playing away (again, a quick look at 20).
SELECT DISTINCT "away_team_api_id" AS "team_api_id"
FROM   "Match"
WHERE  "away_team_goal" > "home_team_goal"
LIMIT 20;
```

```sql
--Description: Count how many times each team won at home and list the top ones (preview – 20 rows).
SELECT DISTINCT "home_team_api_id" AS "team_api_id",
       COUNT(*) AS "home_wins"
FROM   "Match"
WHERE  "home_team_goal" > "away_team_goal"
GROUP BY "home_team_api_id"
ORDER BY "home_wins" DESC
LIMIT 20;
```

```sql
--Description: Count how many times each team won away and list the top ones (preview – 20 rows).
SELECT DISTINCT "away_team_api_id" AS "team_api_id",
       COUNT(*) AS "away_wins"
FROM   "Match"
WHERE  "away_team_goal" > "home_team_goal"
GROUP BY "away_team_api_id"
ORDER BY "away_wins" DESC
LIMIT 20;
```

```sql
--Description: Combine home-win and away-win counts, sum them, and list the 10 teams with the most total wins.
SELECT DISTINCT t."team_long_name",
       (COALESCE(hw."home_wins",0) + COALESCE(aw."away_wins",0)) AS "total_wins"
FROM   "Team" AS t
LEFT JOIN (
        SELECT "home_team_api_id" AS "team_api_id",
               COUNT(*)           AS "home_wins"
        FROM   "Match"
        WHERE  "home_team_goal" > "away_team_goal"
        GROUP BY "home_team_api_id"
) AS hw
       ON t."team_api_id" = hw."team_api_id"
LEFT JOIN (
        SELECT "away_team_api_id" AS "team_api_id",
               COUNT(*)           AS "away_wins"
        FROM   "Match"
        WHERE  "away_team_goal" > "home_team_goal"
        GROUP BY "away_team_api_id"
) AS aw
       ON t."team_api_id" = aw."team_api_id"
ORDER BY "total_wins" DESC
LIMIT 10;
```
