```sql
--Description: Explore the list of teams – their internal “team_api_id” and human-readable name.
SELECT DISTINCT "team_api_id",
       "team_long_name"
FROM   "Team"
LIMIT 20;
```

```sql
--Description: Have a look at how goals are stored in the Match table.
SELECT "match_api_id",
       "home_team_api_id",
       "away_team_api_id",
       "home_team_goal",
       "away_team_goal"
FROM   "Match"
LIMIT 20;
```

```sql
--Description: Pull one row for every HOME-side victory (to see the pattern).
SELECT DISTINCT "home_team_api_id"   AS "team_api_id",
                "match_api_id"
FROM   "Match"
WHERE  "home_team_goal" > "away_team_goal"
LIMIT 20;
```

```sql
--Description: Count the number of HOME wins per team.
SELECT "home_team_api_id"            AS "team_api_id",
       COUNT(*)                      AS "home_wins"
FROM   "Match"
WHERE  "home_team_goal" > "away_team_goal"
GROUP  BY "home_team_api_id"
LIMIT 20;
```

```sql
--Description: Count the number of AWAY wins per team.
SELECT "away_team_api_id"            AS "team_api_id",
       COUNT(*)                      AS "away_wins"
FROM   "Match"
WHERE  "away_team_goal" > "home_team_goal"
GROUP  BY "away_team_api_id"
LIMIT 20;
```

```sql
--Description: Combine home-win and away-win counts for every team.
SELECT DISTINCT hw."team_api_id",
       (IFNULL(hw."home_wins",0) + IFNULL(aw."away_wins",0)) AS "total_wins"
FROM   (SELECT "home_team_api_id" AS "team_api_id",
               COUNT(*)          AS "home_wins"
        FROM   "Match"
        WHERE  "home_team_goal" > "away_team_goal"
        GROUP  BY "home_team_api_id")               AS hw
LEFT JOIN
       (SELECT "away_team_api_id" AS "team_api_id",
               COUNT(*)          AS "away_wins"
        FROM   "Match"
        WHERE  "away_team_goal" > "home_team_goal"
        GROUP  BY "away_team_api_id")               AS aw
ON     hw."team_api_id" = aw."team_api_id"
LIMIT 20;
```

```sql
--Description: Alternative way – union every individual win and then aggregate (easier to read).
SELECT DISTINCT "team_api_id",
       SUM("wins") AS "total_wins"
FROM  (SELECT "home_team_api_id" AS "team_api_id", 1 AS "wins"
       FROM   "Match"
       WHERE  "home_team_goal" > "away_team_goal"
       UNION ALL
       SELECT "away_team_api_id" AS "team_api_id", 1 AS "wins"
       FROM   "Match"
       WHERE  "away_team_goal" > "home_team_goal")
GROUP BY "team_api_id"
LIMIT 20;
```

```sql
--Description: Attach the real team names to those total-win figures.
SELECT DISTINCT t."team_long_name",
                w."total_wins"
FROM  (SELECT "team_api_id",
              SUM("wins") AS "total_wins"
       FROM  (SELECT "home_team_api_id" AS "team_api_id", 1 AS "wins"
              FROM   "Match"
              WHERE  "home_team_goal" > "away_team_goal"
              UNION ALL
              SELECT "away_team_api_id" AS "team_api_id", 1 AS "wins"
              FROM   "Match"
              WHERE  "away_team_goal" > "home_team_goal")
       GROUP BY "team_api_id")                       AS w
JOIN  "Team"                                         AS t
ON    t."team_api_id" = w."team_api_id"
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – the 10 teams with the most wins in the entire database.
SELECT DISTINCT t."team_long_name"          AS "team",
                w."total_wins"
FROM  (SELECT "team_api_id",
              SUM("wins") AS "total_wins"
       FROM  (SELECT "home_team_api_id" AS "team_api_id", 1 AS "wins"
              FROM   "Match"
              WHERE  "home_team_goal" > "away_team_goal"
              UNION ALL
              SELECT "away_team_api_id" AS "team_api_id", 1 AS "wins"
              FROM   "Match"
              WHERE  "away_team_goal" > "home_team_goal")
       GROUP BY "team_api_id")                       AS w
JOIN  "Team"                                         AS t
ON    t."team_api_id" = w."team_api_id"
ORDER BY w."total_wins" DESC
LIMIT 10;
```
