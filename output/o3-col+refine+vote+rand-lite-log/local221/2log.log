        /* away-side victories */
        SELECT
            "away_team_api_id" AS "team_api_id",
            1                  AS "win_flag"
        FROM "Match"
        WHERE "away_team_goal" > "home_team_goal"
    )
    GROUP BY "team_api_id"
) AS w
JOIN "Team" AS t
  ON t."team_api_id" = w."team_api_id"
