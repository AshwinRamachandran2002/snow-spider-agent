Query:
--Description: FINAL ANSWER – the 10 teams with the most wins in the entire database.
SELECT DISTINCT t."team_long_name"          AS "team",
                w."total_wins"
FROM  (SELECT "team_api_id",
              SUM("wins") AS "total_wins"
       FROM  (SELECT "home_team_api_id" AS "team_api_id", 1 AS "wins"
              FROM   "Match"
              WHERE  "home_team_goal" > "away_team_goal"
              UNION ALL
              SELECT "away_team_api_id" AS "team_api_id", 1 AS "wins"
              FROM   "Match"
              WHERE  "away_team_goal" > "home_team_goal")
       GROUP BY "team_api_id")                       AS w
JOIN  "Team"                                         AS t
ON    t."team_api_id" = w."team_api_id"
ORDER BY w."total_wins" DESC
LIMIT 10;
