Query:
--Description: Attach the human-readable team names to the win totals (top 20)
SELECT  T."team_long_name",
        W."total_wins"
FROM   (
        SELECT "team_id",
               SUM("num_wins") AS "total_wins"
        FROM  (
                SELECT "home_team_api_id" AS "team_id", 1 AS "num_wins"
                FROM   "Match"
                WHERE  "home_team_goal" > "away_team_goal"
                UNION ALL
                SELECT "away_team_api_id" AS "team_id", 1 AS "num_wins"
                FROM   "Match"
                WHERE  "away_team_goal" > "home_team_goal"
              )
        GROUP BY "team_id"
      ) AS W
JOIN   "Team" AS T
ON     T."team_api_id" = W."team_id"
ORDER BY W."total_wins" DESC
LIMIT 20;
