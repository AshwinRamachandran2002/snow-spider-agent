```sql
--Description: Count home-side wins for every team (home goals > away goals), ordered by most home wins
SELECT "home_team_api_id"  AS "team_id",
       COUNT(*)            AS "home_wins"
FROM   "Match"
WHERE  "home_team_goal" > "away_team_goal"
GROUP  BY "home_team_api_id"
ORDER  BY "home_wins" DESC
LIMIT 20;
```

```sql
--Description: Count away-side wins for every team (away goals > home goals), ordered by most away wins
SELECT "away_team_api_id"  AS "team_id",
       COUNT(*)            AS "away_wins"
FROM   "Match"
WHERE  "away_team_goal" > "home_team_goal"
GROUP  BY "away_team_api_id"
ORDER  BY "away_wins" DESC
LIMIT 20;
```

```sql
--Description: Combine both home and away wins for each team and list the totals (top 20 shown)
SELECT "team_id",
       SUM("num_wins") AS "total_wins"
FROM  (
        SELECT "home_team_api_id" AS "team_id", 1 AS "num_wins"
        FROM   "Match"
        WHERE  "home_team_goal" > "away_team_goal"
        UNION ALL
        SELECT "away_team_api_id" AS "team_id", 1 AS "num_wins"
        FROM   "Match"
        WHERE  "away_team_goal" > "home_team_goal"
      )
GROUP BY "team_id"
ORDER BY "total_wins" DESC
LIMIT 20;
```

```sql
--Description: Attach the human-readable team names to the win totals (top 20)
SELECT  T."team_long_name",
        W."total_wins"
FROM   (
        SELECT "team_id",
               SUM("num_wins") AS "total_wins"
        FROM  (
                SELECT "home_team_api_id" AS "team_id", 1 AS "num_wins"
                FROM   "Match"
                WHERE  "home_team_goal" > "away_team_goal"
                UNION ALL
                SELECT "away_team_api_id" AS "team_id", 1 AS "num_wins"
                FROM   "Match"
                WHERE  "away_team_goal" > "home_team_goal"
              )
        GROUP BY "team_id"
      ) AS W
JOIN   "Team" AS T
ON     T."team_api_id" = W."team_id"
ORDER BY W."total_wins" DESC
LIMIT 20;
```

```sql
--Description: Same as above but restricted to the Premier League (league_id = 1729) to ensure cross-checking of results
SELECT  T."team_long_name",
        COUNT(*) AS "wins_in_EPL"
FROM   (
        SELECT "id",
               "home_team_api_id" AS "team_id"
        FROM   "Match"
        WHERE  "league_id" = 1729
        AND    "home_team_goal" > "away_team_goal"
        UNION ALL
        SELECT "id",
               "away_team_api_id" AS "team_id"
        FROM   "Match"
        WHERE  "league_id" = 1729
        AND    "away_team_goal" > "home_team_goal"
       ) AS M
JOIN   "Team"  AS T
ON     T."team_api_id" = M."team_id"
GROUP  BY M."team_id"
ORDER  BY "wins_in_EPL" DESC
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – top-10 teams with the most wins across the whole database (all leagues & seasons)
SELECT  T."team_long_name"        AS "team",
        W."total_wins"            AS "wins"
FROM   (
        SELECT "team_id",
               SUM("num_wins") AS "total_wins"
        FROM  (
                SELECT "home_team_api_id" AS "team_id", 1 AS "num_wins"
                FROM   "Match"
                WHERE  "home_team_goal" > "away_team_goal"
                UNION ALL
                SELECT "away_team_api_id" AS "team_id", 1 AS "num_wins"
                FROM   "Match"
                WHERE  "away_team_goal" > "home_team_goal"
              )
        GROUP BY "team_id"
      ) AS W
JOIN   "Team" AS T
ON     T."team_api_id" = W."team_id"
ORDER BY W."total_wins" DESC
LIMIT 10;
```
