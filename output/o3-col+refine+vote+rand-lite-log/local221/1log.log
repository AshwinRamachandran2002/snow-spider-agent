Query:
--Description: Combine home & away wins (UNION ALL) then total them, keeping the 20 best.
SELECT "team_long_name",
       SUM("wins") AS "total_wins"
FROM   (SELECT t."team_long_name",
               COUNT(*) AS "wins"
        FROM   "Match" AS m
        JOIN   "Team"  AS t
               ON m."home_team_api_id" = t."team_api_id"
        WHERE  m."home_team_goal" > m."away_team_goal"
        GROUP  BY t."team_long_name"
        UNION ALL
        SELECT t."team_long_name",
               COUNT(*) AS "wins"
        FROM   "Match" AS m
        JOIN   "Team"  AS t
               ON m."away_team_api_id" = t."team_api_id"
        WHERE  m."away_team_goal" > m."home_team_goal"
        GROUP  BY t."team_long_name") AS win_table
GROUP  BY "team_long_name"
ORDER  BY "total_wins" DESC
LIMIT 20;
