```sql
--Description: Inspect the main result columns in the Match table (home/away goals & teams).
SELECT DISTINCT "match_api_id",
                "home_team_api_id",
                "away_team_api_id",
                "home_team_goal",
                "away_team_goal"
FROM   "Match"
LIMIT 20;
```

```sql
--Description: Collect some sample home-winning team IDs (home goals ­> away goals).
SELECT DISTINCT "home_team_api_id"
FROM   "Match"
WHERE  "home_team_goal" > "away_team_goal"
LIMIT 20;
```

```sql
--Description: Show a few home-winning team names by joining with Team.
SELECT DISTINCT m."home_team_api_id",
                t."team_long_name"
FROM   "Match" AS m
JOIN   "Team"  AS t
       ON m."home_team_api_id" = t."team_api_id"
WHERE  m."home_team_goal" > m."away_team_goal"
LIMIT 20;
```

```sql
--Description: Count home wins for every team and list the 20 highest.
SELECT t."team_long_name",
       COUNT(*) AS "home_wins"
FROM   "Match" AS m
JOIN   "Team"  AS t
       ON m."home_team_api_id" = t."team_api_id"
WHERE  m."home_team_goal" > m."away_team_goal"
GROUP  BY t."team_long_name"
ORDER  BY "home_wins" DESC
LIMIT 20;
```

```sql
--Description: Count away wins for every team and list the 20 highest.
SELECT t."team_long_name",
       COUNT(*) AS "away_wins"
FROM   "Match" AS m
JOIN   "Team"  AS t
       ON m."away_team_api_id" = t."team_api_id"
WHERE  m."away_team_goal" > m."home_team_goal"
GROUP  BY t."team_long_name"
ORDER  BY "away_wins" DESC
LIMIT 20;
```

```sql
--Description: Combine home & away wins (UNION ALL) then total them, keeping the 20 best.
SELECT "team_long_name",
       SUM("wins") AS "total_wins"
FROM   (SELECT t."team_long_name",
               COUNT(*) AS "wins"
        FROM   "Match" AS m
        JOIN   "Team"  AS t
               ON m."home_team_api_id" = t."team_api_id"
        WHERE  m."home_team_goal" > m."away_team_goal"
        GROUP  BY t."team_long_name"
        UNION ALL
        SELECT t."team_long_name",
               COUNT(*) AS "wins"
        FROM   "Match" AS m
        JOIN   "Team"  AS t
               ON m."away_team_api_id" = t."team_api_id"
        WHERE  m."away_team_goal" > m."home_team_goal"
        GROUP  BY t."team_long_name") AS win_table
GROUP  BY "team_long_name"
ORDER  BY "total_wins" DESC
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – the 10 teams with the most total wins (home + away).
SELECT "team_long_name",
       "total_wins"
FROM   (SELECT "team_long_name",
               SUM("wins") AS "total_wins"
        FROM   (SELECT t."team_long_name",
                       COUNT(*) AS "wins"
                FROM   "Match" AS m
                JOIN   "Team"  AS t
                       ON m."home_team_api_id" = t."team_api_id"
                WHERE  m."home_team_goal" > m."away_team_goal"
                GROUP  BY t."team_long_name"
                UNION ALL
                SELECT t."team_long_name",
                       COUNT(*) AS "wins"
                FROM   "Match" AS m
                JOIN   "Team"  AS t
                       ON m."away_team_api_id" = t."team_api_id"
                WHERE  m."away_team_goal" > m."home_team_goal"
                GROUP  BY t."team_long_name") AS allwins
        GROUP  BY "team_long_name") AS totals
ORDER  BY "total_wins" DESC
LIMIT 10;
```

```sql
--Description: (Bonus) Show home-/away-split along with total wins for the 20 best teams.
SELECT t."team_long_name",
       COALESCE(hw."home_wins", 0)  AS "home_wins",
       COALESCE(aw."away_wins", 0)  AS "away_wins",
       COALESCE(hw."home_wins", 0) + COALESCE(aw."away_wins", 0) AS "total_wins"
FROM   "Team" AS t
LEFT JOIN (SELECT m."home_team_api_id" AS "team_api_id",
                  COUNT(*)            AS "home_wins"
           FROM   "Match" AS m
           WHERE  m."home_team_goal" > m."away_team_goal"
           GROUP  BY m."home_team_api_id") AS hw
       ON t."team_api_id" = hw."team_api_id"
LEFT JOIN (SELECT m."away_team_api_id" AS "team_api_id",
                  COUNT(*)            AS "away_wins"
           FROM   "Match" AS m
           WHERE  m."away_team_goal" > m."home_team_goal"
           GROUP  BY m."away_team_api_id") AS aw
       ON t."team_api_id" = aw."team_api_id"
ORDER  BY "total_wins" DESC
LIMIT 20;
```

```sql
--Description: (Bonus) Retrieve the 10 team_api_ids with the highest overall win counts.
SELECT "team_api_id",
       "total_wins"
FROM   (SELECT "team_api_id",
               SUM("wins") AS "total_wins"
        FROM   (SELECT m."home_team_api_id" AS "team_api_id",
                       COUNT(*)            AS "wins"
                FROM   "Match" AS m
                WHERE  m."home_team_goal" > m."away_team_goal"
                GROUP  BY m."home_team_api_id"
                UNION ALL
                SELECT m."away_team_api_id",
                       COUNT(*)
                FROM   "Match" AS m
                WHERE  m."away_team_goal" > m."home_team_goal"
                GROUP  BY m."away_team_api_id") AS allwins
        GROUP  BY "team_api_id") AS totals
ORDER  BY "total_wins" DESC
LIMIT 10;
```
