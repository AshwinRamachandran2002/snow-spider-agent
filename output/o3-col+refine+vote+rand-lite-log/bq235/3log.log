Query:
-- Description: 8) Build a “combined average cost” (outpatient ≈ submitted charge; inpatient ≈ Medicare payment)  
--               and show the top 20 most expensive providers on that combined figure. 
SELECT `npi`,
       `nppes_provider_last_org_name`,
       `nppes_provider_first_name`,
       `average_submitted_chrg_amt`  AS outpatient_avg,
       `average_medicare_payment_amt` AS inpatient_avg,
       (`average_submitted_chrg_amt` + `average_medicare_payment_amt`) AS combined_avg_cost
FROM   `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
ORDER  BY combined_avg_cost DESC
LIMIT 20;
