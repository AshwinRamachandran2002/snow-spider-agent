```sql
-- 7) For every provider, SUM their average Medicare-allowed amounts
--    for the INPATIENT code set (99221-99239)
SELECT
  npi,
  nppes_provider_last_org_name  AS last_name,
  nppes_provider_first_name     AS first_name,
  SUM(average_medicare_allowed_amt) AS inpatient_avg_allowed
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
WHERE hcpcs_code BETWEEN '99221' AND '99239'
GROUP BY npi, last_name, first_name
ORDER BY inpatient_avg_allowed DESC
LIMIT 20;
```

```sql
-- 8) For every provider, SUM their average Medicare-allowed amounts
--    for the OUTPATIENT code set (99201-99215)
SELECT
  npi,
  nppes_provider_last_org_name  AS last_name,
  nppes_provider_first_name     AS first_name,
  SUM(average_medicare_allowed_amt) AS outpatient_avg_allowed
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
WHERE hcpcs_code BETWEEN '99201' AND '99215'
GROUP BY npi, last_name, first_name
ORDER BY outpatient_avg_allowed DESC
LIMIT 20;
```

```sql
-- 9) Join the inpatient & outpatient aggregates, then rank by the
--    combined average allowed amount to find the highest-cost provider
WITH inpatient AS (
  SELECT
    npi,
    SUM(average_medicare_allowed_amt) AS inpatient_avg_allowed
  FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
  WHERE hcpcs_code BETWEEN '99221' AND '99239'
  GROUP BY npi
),
outpatient AS (
  SELECT
    npi,
    SUM(average_medicare_allowed_amt) AS outpatient_avg_allowed
  FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
  WHERE hcpcs_code BETWEEN '99201' AND '99215'
  GROUP BY npi
)
SELECT
  i.npi,
  t.nppes_provider_last_org_name  AS last_name,
  t.nppes_provider_first_name     AS first_name,
  i.inpatient_avg_allowed,
  o.outpatient_avg_allowed,
  (i.inpatient_avg_allowed + o.outpatient_avg_allowed) AS combined_avg_allowed
FROM inpatient  i
JOIN outpatient o ON i.npi = o.npi
-- grab a single row for the name; any row for that NPI will do
JOIN `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014` AS t
  ON i.npi = t.npi
ORDER BY combined_avg_allowed DESC
LIMIT 20;
```

