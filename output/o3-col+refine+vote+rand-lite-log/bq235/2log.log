  AVG(average_medicare_allowed_amt)  AS avg_allowed_amt,
  AVG(average_submitted_chrg_amt)    AS avg_submitted_charge_amt
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
WHERE npi = (
  SELECT npi
  FROM (
      SELECT
        npi,
        SUM(average_medicare_allowed_amt) AS combined_avg_allowed_amt
      FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
      WHERE place_of_service IN ('O','F')
      GROUP BY npi
      ORDER BY combined_avg_allowed_amt DESC
      LIMIT 1
  )
)
GROUP BY place_of_service
LIMIT 20;
Answer:
place_of_service,avg_allowed_amt,avg_submitted_charge_amt
O,23357.085813140002,31009.5073502
Query:
-- 9) FINAL ANSWER – one-liner returning the healthcare provider that has the 
--    highest combined average Medicare-allowed amount across Outpatient & Inpatient services in 2014
SELECT
  npi,
  nppes_provider_last_org_name  AS last_name_or_org,
  nppes_provider_first_name     AS first_name,
  SUM(average_medicare_allowed_amt) AS highest_combined_avg_allowed_amt
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
WHERE place_of_service IN ('O','F')
GROUP BY npi, last_name_or_org, first_name
ORDER BY highest_combined_avg_allowed_amt DESC
LIMIT 1;
