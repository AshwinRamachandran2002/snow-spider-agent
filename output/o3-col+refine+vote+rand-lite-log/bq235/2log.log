2025-05-05 01:00:46 - Thread-491 (execute) - INFO - [Exploration]
```sql
-- 1) Quick look at the first 20 rows to understand the columns we will use 
SELECT *
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
LIMIT 20;
```

```sql
-- 2) See the possible values for place-of-service (e.g. 'O' = Outpatient/Office, 'F' = Facility/In-/Out-patient)
SELECT DISTINCT place_of_service
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
LIMIT 20;
```

```sql
-- 3) How big are the average Medicare-allowed amounts for each place-of-service?
SELECT
  place_of_service,
  AVG(average_medicare_allowed_amt) AS avg_allowed_amt
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
GROUP BY place_of_service
LIMIT 20;
```

```sql
-- 4) Which NPIs (providers) have BOTH an outpatient ('O') and an inpatient/facility ('F') record?
SELECT
  npi,
  COUNT(DISTINCT place_of_service) AS pos_cnt
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
GROUP BY npi
HAVING pos_cnt = 2
LIMIT 20;
```

```sql
-- 5) For those providers, calculate the summed average Medicare-allowed amount 
--    across BOTH places-of-service (O + F)
SELECT
  npi,
  SUM(average_medicare_allowed_amt) AS combined_avg_allowed_amt
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
WHERE place_of_service IN ('O','F')
GROUP BY npi
LIMIT 20;
```

```sql
-- 6) Rank the providers by that combined amount (highest first) to see who the top spenders are
SELECT
  npi,
  SUM(average_medicare_allowed_amt) AS combined_avg_allowed_amt
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
WHERE place_of_service IN ('O','F')
GROUP BY npi
ORDER BY combined_avg_allowed_amt DESC
LIMIT 20;
```

```sql
-- 7) Pull the name of the #1 provider found in the previous step
SELECT DISTINCT
  npi,
  nppes_provider_last_org_name  AS last_name_or_org,
  nppes_provider_first_name     AS first_name
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
WHERE npi = (
  SELECT npi
  FROM (
      SELECT
        npi,
        SUM(average_medicare_allowed_amt) AS combined_avg_allowed_amt
      FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
      WHERE place_of_service IN ('O','F')
      GROUP BY npi
      ORDER BY combined_avg_allowed_amt DESC
      LIMIT 1
  )
)
LIMIT 20;
```

```sql
-- 8) (Optional check) Show BOTH allowed & submitted charge amounts for that same top provider
SELECT
  place_of_service,
  AVG(average_medicare_allowed_amt)  AS avg_allowed_amt,
  AVG(average_submitted_chrg_amt)    AS avg_submitted_charge_amt
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
WHERE npi = (
  SELECT npi
  FROM (
      SELECT
        npi,
        SUM(average_medicare_allowed_amt) AS combined_avg_allowed_amt
      FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
      WHERE place_of_service IN ('O','F')
      GROUP BY npi
      ORDER BY combined_avg_allowed_amt DESC
      LIMIT 1
  )
)
GROUP BY place_of_service
LIMIT 20;
```

```sql
-- 9) FINAL ANSWER – one-liner returning the healthcare provider that has the 
--    highest combined average Medicare-allowed amount across Outpatient & Inpatient services in 2014
SELECT
  npi,
  nppes_provider_last_org_name  AS last_name_or_org,
  nppes_provider_first_name     AS first_name,
  SUM(average_medicare_allowed_amt) AS highest_combined_avg_allowed_amt
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
WHERE place_of_service IN ('O','F')
GROUP BY npi, last_name_or_org, first_name
ORDER BY highest_combined_avg_allowed_amt DESC
LIMIT 1;
```

