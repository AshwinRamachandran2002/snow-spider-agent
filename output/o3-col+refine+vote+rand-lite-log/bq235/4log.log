Query:
--Description: Aggregate by NPI so each provider appears once, summing their combined costs; show the 20 highest-cost providers.
SELECT
  npi,
  ANY_VALUE(nppes_provider_last_org_name) AS last_name,
  ANY_VALUE(nppes_provider_first_name)    AS first_name,
  SUM(average_medicare_payment_amt + average_medicare_standard_amt) AS provider_combined_cost
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
GROUP BY npi
ORDER BY provider_combined_cost DESC
LIMIT 20
