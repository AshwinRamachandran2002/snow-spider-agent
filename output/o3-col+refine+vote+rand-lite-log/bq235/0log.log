--is to treat every row as a service line and add up the four average cost fields
--for each provider.  We then pick the provider whose summed Average Medicare
--Allowed Amount is highest (this value is the most commonly used cost benchmark).
--The query aggregates those four average-cost fields per provider and returns the
--top provider by total_avg_allowed, along with the other summed averages for
--context.
WITH provider_totals AS (
  SELECT
    npi,
    nppes_provider_last_org_name,
    nppes_provider_first_name,
    SUM(average_medicare_allowed_amt)   AS total_avg_allowed,
    SUM(average_submitted_chrg_amt)     AS total_avg_submitted,
    SUM(average_medicare_payment_amt)   AS total_avg_payment,
    SUM(average_medicare_standard_amt)  AS total_avg_standard
