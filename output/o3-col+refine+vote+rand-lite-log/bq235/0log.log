```sql
--Description: 5) Aggregate TOTAL average-allowed amounts for outpatient services by provider (top 20).
SELECT `npi`,
       `nppes_provider_last_org_name`,
       `nppes_provider_first_name`,
       SUM(`average_medicare_allowed_amt`) AS outpatient_avg_allowed
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
WHERE LOWER(`provider_type`) LIKE '%outpatient%'
GROUP BY `npi`, `nppes_provider_last_org_name`, `nppes_provider_first_name`
ORDER BY outpatient_avg_allowed DESC
LIMIT 20;
```

```sql
--Description: 6) Aggregate TOTAL average-allowed amounts for inpatient services by provider (top 20).
SELECT `npi`,
       `nppes_provider_last_org_name`,
       `nppes_provider_first_name`,
       SUM(`average_medicare_allowed_amt`) AS inpatient_avg_allowed
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
WHERE LOWER(`provider_type`) LIKE '%inpatient%'
GROUP BY `npi`, `nppes_provider_last_org_name`, `nppes_provider_first_name`
ORDER BY inpatient_avg_allowed DESC
LIMIT 20;
```

```sql
--Description: 7) Combine outpatient + inpatient average-allowed totals per provider, keep only providers that have BOTH kinds of services (top 20 combined).
WITH outpatient AS (
  SELECT `npi`,
         `nppes_provider_last_org_name`,
         `nppes_provider_first_name`,
         SUM(`average_medicare_allowed_amt`) AS outpatient_avg_allowed
  FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
  WHERE LOWER(`provider_type`) LIKE '%outpatient%'
  GROUP BY `npi`, `nppes_provider_last_org_name`, `nppes_provider_first_name`
),
inpatient AS (
  SELECT `npi`,
         SUM(`average_medicare_allowed_amt`) AS inpatient_avg_allowed
  FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
  WHERE LOWER(`provider_type`) LIKE '%inpatient%'
  GROUP BY `npi`
)
SELECT o.`npi`,
       o.`nppes_provider_last_org_name`,
       o.`nppes_provider_first_name`,
       o.outpatient_avg_allowed,
       i.inpatient_avg_allowed,
       (o.outpatient_avg_allowed + i.inpatient_avg_allowed) AS combined_avg_allowed
FROM outpatient AS o
JOIN inpatient  AS i
USING (`npi`)
ORDER BY combined_avg_allowed DESC
LIMIT 20;
```

