Query:
--Description: Total OUTPATIENT (“O”) average-allowed amounts per provider (top 20).
SELECT
  npi,
  ANY_VALUE(nppes_provider_last_org_name) AS last_name,
  ANY_VALUE(nppes_provider_first_name)    AS first_name,
  SUM(average_medicare_allowed_amt)       AS outpatient_allowed_sum
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
WHERE place_of_service = 'O'
GROUP BY npi
ORDER BY outpatient_allowed_sum DESC
LIMIT 20
