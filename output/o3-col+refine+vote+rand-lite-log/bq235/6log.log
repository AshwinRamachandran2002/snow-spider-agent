```sql
-- 1. Preview a handful of 2014 Medicare provider cost records
SELECT *
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
LIMIT 20;
```

```sql
-- 2. Look at a sample of distinct provider last / organization names
SELECT DISTINCT nppes_provider_last_org_name
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
LIMIT 20;
```

```sql
-- 3. Compute a quick “combined-cost” proxy  
--    (allowed + submitted amounts) for every record
SELECT
  npi,
  nppes_provider_last_org_name,
  nppes_provider_first_name,
  (average_medicare_allowed_amt + average_submitted_chrg_amt) AS combined_avg_cost
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
LIMIT 20;
```

```sql
-- 4. Rank all records by that combined average cost, largest first
SELECT
  npi,
  nppes_provider_last_org_name,
  nppes_provider_first_name,
  (average_medicare_allowed_amt + average_submitted_chrg_amt) AS combined_avg_cost
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
ORDER BY combined_avg_cost DESC
LIMIT 20;
```

```sql
-- 5. Pull the single record with the highest combined cost
SELECT
  npi,
  nppes_provider_last_org_name,
  nppes_provider_first_name,
  (average_medicare_allowed_amt + average_submitted_chrg_amt) AS combined_avg_cost
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
ORDER BY combined_avg_cost DESC
LIMIT 1;
```

```sql
-- 6. Add other cost metrics (payment & standardized) to inspect the top 20
SELECT
  npi,
  nppes_provider_last_org_name,
  nppes_provider_first_name,
  average_medicare_allowed_amt,
  average_submitted_chrg_amt,
  average_medicare_payment_amt,
  average_medicare_standard_amt,
  (average_medicare_allowed_amt + average_submitted_chrg_amt)   AS combined_avg_cost
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
ORDER BY combined_avg_cost DESC
LIMIT 20;
```

```sql
-- 7. Treat “total average cost” as (allowed + submitted + payment + standard)  
--    and list the top 20 by that wider definition
SELECT
  npi,
  nppes_provider_last_org_name,
  nppes_provider_first_name,
  (average_medicare_allowed_amt
   + average_submitted_chrg_amt
   + average_medicare_payment_amt
   + average_medicare_standard_amt) AS total_avg_cost
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
ORDER BY total_avg_cost DESC
LIMIT 20;
```

```sql
-- 8. Find the single provider with the highest “total average cost” definition above
SELECT
  npi,
  nppes_provider_last_org_name,
  nppes_provider_first_name,
  (average_medicare_allowed_amt
   + average_submitted_chrg_amt
   + average_medicare_payment_amt
   + average_medicare_standard_amt) AS total_avg_cost
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
ORDER BY total_avg_cost DESC
LIMIT 1;
```

```sql
-- 9. Summarize by provider (in case an NPI has multiple rows) and rank
SELECT
  npi,
  ANY_VALUE(nppes_provider_last_org_name)  AS last_name_org,
  ANY_VALUE(nppes_provider_first_name)     AS first_name,
  SUM(average_medicare_allowed_amt
      + average_submitted_chrg_amt)        AS combined_avg_cost
FROM `bigquery-public-data.cms_medicare.physicians_and_other_supplier_2014`
GROUP BY npi
ORDER BY combined_avg_cost DESC
LIMIT 20;
```

```sql
-- 10. Return the single provider with the largest summed combined cost across all rows
SELECT
  npi,
