--Description: Using the same 20-Jan-2022 → 22-Jan-2022 window, calculate the total rows, the number of capital-city rows (capital = 1), and the resulting capital-city proportion.
SELECT  COUNT(*)                                                    AS total_rows,
        SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END)               AS capital_rows,
        ROUND(1.0 * SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END) /
              COUNT(*), 3)                                         AS capital_ratio
FROM    cities
WHERE   country_code_2 = 'ir'
  AND   insert_date BETWEEN '2022-01-20' AND '2022-01-22'
