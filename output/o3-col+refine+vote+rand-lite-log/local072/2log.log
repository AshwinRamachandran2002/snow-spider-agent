```sql
-- 5. List all the distinct January-2022 insert dates for that country (replace '??' once the code is known)
SELECT DISTINCT insert_date
FROM cities
WHERE country_code_2 = '??'
  AND insert_date LIKE '2022-01-%'
ORDER BY insert_date;
```

```sql
-- 6. Use window functions to partition these dates into consecutive-day blocks
SELECT insert_date,
       ROW_NUMBER() OVER (ORDER BY insert_date)                                   AS rn,
       JULIANDAY(insert_date) -
       ROW_NUMBER() OVER (ORDER BY insert_date)                                   AS grp_key
FROM (
        SELECT DISTINCT insert_date
        FROM cities
        WHERE country_code_2 = '??'
          AND insert_date LIKE '2022-01-%'
) AS d
ORDER BY insert_date;
```

```sql
-- 7. Count the length of every consecutive-day block found in step-6
WITH consec AS (
    SELECT insert_date,
           JULIANDAY(insert_date) -
           ROW_NUMBER() OVER (ORDER BY insert_date) AS grp_key
    FROM (
            SELECT DISTINCT insert_date
            FROM cities
            WHERE country_code_2 = '??'
              AND insert_date LIKE '2022-01-%'
    )
)
SELECT grp_key,
       MIN(insert_date) AS start_date,
       MAX(insert_date) AS end_date,
       COUNT(*)         AS num_days
FROM consec
GROUP BY grp_key
ORDER BY num_days DESC
LIMIT 20;
```

```sql
-- 8. Identify the single longest consecutive January-2022 period for that country
WITH consec AS (
    SELECT insert_date,
           JULIANDAY(insert_date) -
           ROW_NUMBER() OVER (ORDER BY insert_date) AS grp_key
    FROM (
            SELECT DISTINCT insert_date
            FROM cities
            WHERE country_code_2 = '??'
              AND insert_date LIKE '2022-01-%'
    )
),
periods AS (
    SELECT grp_key,
           MIN(insert_date) AS start_date,
           MAX(insert_date) AS end_date,
           COUNT(*)         AS num_days
    FROM consec
    GROUP BY grp_key
)
SELECT *
FROM periods
ORDER BY num_days DESC
LIMIT 1;
```

