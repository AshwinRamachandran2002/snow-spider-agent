--Description: Partition the nine January-2022 dates for Iran (‘ir’) into consecutive-day groups so we can later measure the length of each streak.
SELECT  insert_date,
        ROW_NUMBER() OVER (ORDER BY insert_date)                                AS rn,
        JULIANDAY(insert_date) - ROW_NUMBER() OVER (ORDER BY insert_date)       AS grp_key
FROM   (
        SELECT DISTINCT insert_date
        FROM   cities
        WHERE  country_code_2 = 'ir'
          AND  insert_date BETWEEN '2022-01-01' AND '2022-01-31'
) AS d
ORDER BY insert_date
