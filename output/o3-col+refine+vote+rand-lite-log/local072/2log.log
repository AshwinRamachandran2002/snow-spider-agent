--Description: Count the size (number of days) of every consecutive-day block for Iran in January-2022.
WITH consec AS (
    SELECT  insert_date,
            JULIANDAY(insert_date) - ROW_NUMBER() OVER (ORDER BY insert_date) AS grp_key
    FROM   (
            SELECT DISTINCT insert_date
            FROM   cities
            WHERE  country_code_2 = 'ir'
              AND  insert_date BETWEEN '2022-01-01' AND '2022-01-31'
    )
)
SELECT  grp_key,
        MIN(insert_date) AS start_date,
        MAX(insert_date) AS end_date,
        COUNT(*)         AS num_days
FROM    consec
GROUP BY grp_key
ORDER BY num_days DESC
LIMIT 20
