    ROUND(1.0 * SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END) 
             / COUNT(*), 3)                  AS capital_ratio
FROM cities
WHERE country_code_2 = '??'
  AND insert_date BETWEEN '2022-01-DD' AND '2022-01-DD';      -- plug same range
```
