```sql
-- 5.  List the nine January-2022 dates (chronological) for that target country  
SELECT DISTINCT "insert_date"
FROM   "cities"
WHERE  "country_code_2" = (SELECT "country_code_2" FROM (
                                SELECT "country_code_2"
                                FROM   "cities"
                                WHERE  "insert_date" LIKE '2022-01%'
                                GROUP  BY "country_code_2"
                                HAVING COUNT(DISTINCT "insert_date") = 9
                                LIMIT 1) )
  AND  "insert_date" LIKE '2022-01%'
ORDER BY "insert_date";
```

```sql
-- 6.  Break those nine dates into consecutive-day blocks, keep their lengths  
WITH target AS (
     SELECT "country_code_2"
     FROM   "cities"
     WHERE  "insert_date" LIKE '2022-01%'
     GROUP  BY "country_code_2"
     HAVING COUNT(DISTINCT "insert_date") = 9
     LIMIT 1
), jan_rows AS (
     SELECT  c."insert_date",
             julianday(c."insert_date")              AS jd,
             ROW_NUMBER() OVER (ORDER BY c."insert_date") AS rn
     FROM    "cities"  c
     WHERE   c."country_code_2" = (SELECT "country_code_2" FROM target)
       AND   c."insert_date"     LIKE '2022-01%'
     GROUP BY c."insert_date"
), grp AS (
     SELECT *, jd - rn AS grp_key
     FROM   jan_rows
)
SELECT  grp_key,
        MIN("insert_date") AS start_date,
        MAX("insert_date") AS end_date,
        COUNT(*)           AS consecutive_days
FROM    grp
GROUP BY grp_key
ORDER BY consecutive_days DESC;
```

```sql
-- 7.  Capture ONLY the longest consecutive-day window for that country  
WITH target AS ( ...same as above... ),
     jan_rows AS ( ...same as above... ),
     grp AS     ( ...same as above... ),
     longest AS (
         SELECT grp_key, 
                MIN("insert_date") AS start_date,
                MAX("insert_date") AS end_date,
                COUNT(*)           AS days
         FROM   grp
         GROUP  BY grp_key
         ORDER  BY days DESC
         LIMIT 1
)
SELECT * FROM longest;
```

```sql
-- 8.  Rows inside that longest window; show how many come from the capital city  
WITH target AS ( ...same as above... ),
     jan_rows AS ( ...same as above... ),
     grp AS     ( ...same as above... ),
     longest AS ( ...same as 7 ... ),
     win_rows AS (
         SELECT c.*
         FROM   "cities"  c,
                longest   l,
                target    t
         WHERE  c."country_code_2" = t."country_code_2"
           AND  c."insert_date"   BETWEEN l.start_date AND l.end_date
)
SELECT  COUNT(*)                                         AS total_rows,
        SUM(CASE WHEN "capital" = 1 THEN 1 ELSE 0 END)  AS capital_rows
FROM    win_rows;
```

```sql
-- 9.  Final answer: country code, longest-window dates, days, and capital-city share  
WITH target AS (
     SELECT "country_code_2"
     FROM   "cities"
     WHERE  "insert_date" LIKE '2022-01%'
     GROUP  BY "country_code_2"
     HAVING COUNT(DISTINCT "insert_date") = 9
     LIMIT 1
), jan_rows AS (
     SELECT  c."insert_date",
             julianday(c."insert_date")              AS jd,
             ROW_NUMBER() OVER (ORDER BY c."insert_date") AS rn
     FROM    "cities"  c
     WHERE   c."country_code_2" = (SELECT "country_code_2" FROM target)
       AND   c."insert_date"     LIKE '2022-01%'
     GROUP BY c."insert_date"
), grp AS (
     SELECT *, jd - rn AS grp_key
     FROM   jan_rows
), longest AS (
     SELECT grp_key,
            MIN("insert_date") AS start_date,
            MAX("insert_date") AS end_date,
            COUNT(*)           AS days
     FROM   grp
     GROUP  BY grp_key
     ORDER  BY days DESC
     LIMIT 1
), win_rows AS (
     SELECT c.*
     FROM   "cities"  c
     JOIN   target    t  ON c."country_code_2" = t."country_code_2"
     JOIN   longest   l  ON c."insert_date" BETWEEN l.start_date AND l.end_date
)
SELECT  (SELECT "country_code_2" FROM target)                 AS country_code,
        (SELECT start_date     FROM longest)                  AS streak_start,
        (SELECT end_date       FROM longest)                  AS streak_end,
        (SELECT days           FROM longest)                  AS consecutive_days,
        ROUND( SUM(CASE WHEN "capital" = 1 THEN 1 ELSE 0 END) * 1.0
              / COUNT(*), 3)                                  AS capital_city_share
FROM    win_rows;
```

The final (9th) query returns:

• the country whose cities table has rows on nine distinct January-2022 days  
• the start and end dates of its longest consecutive insertion window in that month  
• the length of that window (in days)  
• and the proportion of rows in that window that come from its capital city.
