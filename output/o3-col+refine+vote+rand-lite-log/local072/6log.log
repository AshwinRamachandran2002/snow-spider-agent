--Description: Find the country that has exactly nine distinct January-2022 “cities” insert-dates,
--             determine its longest consecutive run of those dates, and within that run
--             compute the share of rows that correspond to its capital city.
WITH country_nine AS (   -- step 1: that country (there is only one: 'ir')
    SELECT "country_code_2"
    FROM   "cities"
    WHERE  "insert_date" LIKE '2022-01%'
    GROUP  BY "country_code_2"
    HAVING COUNT(DISTINCT "insert_date") = 9
), ordered_dates AS (    -- step 2: those nine dates + julian day + row number
    SELECT DISTINCT
           "insert_date",
           "country_code_2",
           julianday("insert_date")                    AS jd,
           ROW_NUMBER() OVER (ORDER BY "insert_date")  AS rn
    FROM   "cities"
    WHERE  "country_code_2" IN (SELECT "country_code_2" FROM country_nine)
