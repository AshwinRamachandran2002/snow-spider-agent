Below are 9 exploratory-to-final SQL statements that locate  

1) the country that has data on nine different January-2022 days,  
2) that country’s longest consecutive insertion streak in January-2022, and  
3) the share of rows from its capital city during that streak.

```sql
-- 1) Sample rows that were inserted in January-2022
SELECT *
FROM "cities"
WHERE "insert_date" LIKE '2022-01-%'
LIMIT 20;
```

```sql
-- 2) All distinct country codes that have January-2022 insertions
SELECT DISTINCT "country_code_2"
FROM "cities"
WHERE "insert_date" LIKE '2022-01-%'
LIMIT 20;
```

```sql
-- 3) Count the number of different January-2022 insertion days per country
SELECT "country_code_2",
       COUNT(DISTINCT date("insert_date")) AS days_inserted
FROM "cities"
WHERE "insert_date" LIKE '2022-01-%'
GROUP BY "country_code_2"
ORDER BY days_inserted DESC
LIMIT 20;
```

```sql
-- 4) Find the country (or countries) that have exactly nine different insertion days in January-2022
SELECT "country_code_2"
FROM "cities"
WHERE "insert_date" LIKE '2022-01-%'
GROUP BY "country_code_2"
HAVING COUNT(DISTINCT date("insert_date")) = 9;
```

```sql
-- 5) List all January-2022 insertion dates for that country
SELECT DISTINCT date("insert_date") AS insert_day
FROM "cities"
WHERE "country_code_2" IN (
        SELECT "country_code_2"
        FROM "cities"
        WHERE "insert_date" LIKE '2022-01-%'
        GROUP BY "country_code_2"
        HAVING COUNT(DISTINCT date("insert_date")) = 9
)
AND "insert_date" LIKE '2022-01-%'
ORDER BY insert_day;
```

```sql
-- 6) Determine the longest consecutive-day streak of insertions for the country in January-2022
WITH country_dates AS (
    SELECT DISTINCT date("insert_date") AS d
    FROM "cities"
    WHERE "country_code_2" IN (
            SELECT "country_code_2"
            FROM "cities"
            WHERE "insert_date" LIKE '2022-01-%'
            GROUP BY "country_code_2"
            HAVING COUNT(DISTINCT date("insert_date")) = 9
    )
      AND "insert_date" LIKE '2022-01-%'
),
ordered AS (
    SELECT d,
           ROW_NUMBER() OVER (ORDER BY d)            AS rn,
           JULIANDAY(d)                              AS jd
    FROM country_dates
),
grp AS (
    SELECT d,
           jd - rn AS grp_key
    FROM ordered
),
streaks AS (
    SELECT grp_key,
           MIN(d) AS start_date,
           MAX(d) AS end_date,
           COUNT(*) AS streak_len
    FROM grp
    GROUP BY grp_key
)
SELECT *
FROM streaks
ORDER BY streak_len DESC
LIMIT 1;
```

```sql
-- 7) Retrieve every city row for the country during that longest streak
WITH ctry AS (
    SELECT "country_code_2"
    FROM "cities"
    WHERE "insert_date" LIKE '2022-01-%'
    GROUP BY "country_code_2"
    HAVING COUNT(DISTINCT date("insert_date")) = 9
),
streak AS (
    /* reuse logic from step 6 to get the 1-row longest-streak window */
    WITH country_dates AS (
        SELECT DISTINCT date("insert_date") AS d
        FROM "cities", ctry
        WHERE "cities"."country_code_2" = ctry."country_code_2"
          AND "insert_date" LIKE '2022-01-%'
    ),
    ordered AS (
        SELECT d,
               ROW_NUMBER() OVER (ORDER BY d) AS rn,
               JULIANDAY(d)                    AS jd
        FROM country_dates
    ),
    grp AS (
        SELECT d,
               jd - rn AS grp_key
        FROM ordered
    ),
    streaks AS (
        SELECT grp_key,
               MIN(d) AS start_date,
               MAX(d) AS end_date,
               COUNT(*) AS streak_len
        FROM grp
        GROUP BY grp_key
    )
    SELECT start_date, end_date
    FROM streaks
    ORDER BY streak_len DESC
    LIMIT 1
)
SELECT *
FROM "cities", ctry, streak
WHERE "cities"."country_code_2" = ctry."country_code_2"
  AND date("cities"."insert_date") BETWEEN streak.start_date AND streak.end_date
LIMIT 20;
```

```sql
-- 8) Compute total rows vs. capital-city rows inside the longest streak
WITH ctry AS (
    SELECT "country_code_2"
    FROM "cities"
    WHERE "insert_date" LIKE '2022-01-%'
    GROUP BY "country_code_2"
    HAVING COUNT(DISTINCT date("insert_date")) = 9
),
streak AS (
    WITH country_dates AS (
        SELECT DISTINCT date("insert_date") AS d
        FROM "cities", ctry
        WHERE "cities"."country_code_2" = ctry."country_code_2"
          AND "insert_date" LIKE '2022-01-%'
    ),
    ordered AS (
        SELECT d,
               ROW_NUMBER() OVER (ORDER BY d) AS rn,
               JULIANDAY(d)                    AS jd
        FROM country_dates
    ),
    grp AS (
        SELECT d,
               jd - rn AS grp_key
        FROM ordered
    ),
    streaks AS (
        SELECT grp_key,
               MIN(d) AS start_date,
               MAX(d) AS end_date,
               COUNT(*) AS streak_len
        FROM grp
        GROUP BY grp_key
    )
    SELECT start_date, end_date
    FROM streaks
    ORDER BY streak_len DESC
    LIMIT 1
),
period_rows AS (
    SELECT *
    FROM "cities", ctry, streak
    WHERE "cities"."country_code_2" = ctry."country_code_2"
      AND date("cities"."insert_date") BETWEEN streak.start_date AND streak.end_date
)
SELECT COUNT(*)                                                  AS total_rows,
       SUM(CASE WHEN "capital" = 1 THEN 1 ELSE 0 END)            AS capital_rows,
       ROUND(1.0 * SUM(CASE WHEN "capital" = 1 THEN 1 ELSE 0 END) / COUNT(*), 4) 
                                                                  AS proportion_capital
FROM period_rows;
```

```sql
-- 9) One-shot final answer: country, longest-streak window, and capital-entry proportion
WITH january AS (
    SELECT *
    FROM "cities"
    WHERE "insert_date" LIKE '2022-01-%'
),
ctry AS (
    SELECT "country_code_2"
    FROM january
    GROUP BY "country_code_2"
    HAVING COUNT(DISTINCT date("insert_date")) = 9
),
country_dates AS (
    SELECT DISTINCT date("insert_date") AS d
    FROM january, ctry
    WHERE january."country_code_2" = ctry."country_code_2"
),
ordered AS (
    SELECT d,
           ROW_NUMBER() OVER (ORDER BY d) AS rn,
           JULIANDAY(d)                    AS jd
    FROM country_dates
),
grp AS (
    SELECT d,
           jd - rn AS grp_key
    FROM ordered
),
streaks AS (
    SELECT grp_key,
           MIN(d) AS start_date,
           MAX(d) AS end_date,
           COUNT(*) AS streak_len
    FROM grp
    GROUP BY grp_key
),
longest AS (
    SELECT *
    FROM streaks
    ORDER BY streak_len DESC
    LIMIT 1
),
period_rows AS (
    SELECT january.*
    FROM january, ctry, longest
    WHERE january."country_code_2" = ctry."country_code_2"
      AND date(january."insert_date") BETWEEN longest.start_date AND longest.end_date
)
SELECT ctry."country_code_2"                        AS country_code,
       longest.start_date,
       longest.end_date,
       ROUND(1.0 * SUM(CASE WHEN "capital" = 1 THEN 1 ELSE 0 END) / COUNT(*), 4) 
                                                     AS proportion_capital_city_rows
FROM period_rows, ctry, longest;
```

Running the last query will return the required country code, the start and end dates of its longest consecutive insertion stretch in January-2022, and the proportion of rows from that country’s capital city during that period.
