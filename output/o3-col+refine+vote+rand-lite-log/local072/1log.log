-- 8) Compute total rows vs. capital-city rows inside the longest streak
WITH ctry AS (
    SELECT "country_code_2"
    FROM "cities"
    WHERE "insert_date" LIKE '2022-01-%'
    GROUP BY "country_code_2"
    HAVING COUNT(DISTINCT date("insert_date")) = 9
),
streak AS (
    WITH country_dates AS (
        SELECT DISTINCT date("insert_date") AS d
        FROM "cities", ctry
        WHERE "cities"."country_code_2" = ctry."country_code_2"
          AND "insert_date" LIKE '2022-01-%'
    ),
    ordered AS (
        SELECT d,
               ROW_NUMBER() OVER (ORDER BY d) AS rn,
               JULIANDAY(d)                    AS jd
        FROM country_dates
    ),
    grp AS (
        SELECT d,
               jd - rn AS grp_key
        FROM ordered
    ),
    streaks AS (
        SELECT grp_key,
               MIN(d) AS start_date,
               MAX(d) AS end_date,
               COUNT(*) AS streak_len
        FROM grp
        GROUP BY grp_key
    )
    SELECT start_date, end_date
    FROM streaks
    ORDER BY streak_len DESC
    LIMIT 1
),
period_rows AS (
    SELECT *
    FROM "cities", ctry, streak
    WHERE "cities"."country_code_2" = ctry."country_code_2"
      AND date("cities"."insert_date") BETWEEN streak.start_date AND streak.end_date
)
SELECT COUNT(*)                                                  AS total_rows,
       SUM(CASE WHEN "capital" = 1 THEN 1 ELSE 0 END)            AS capital_rows,
       ROUND(1.0 * SUM(CASE WHEN "capital" = 1 THEN 1 ELSE 0 END) / COUNT(*), 4) 
                                                                  AS proportion_capital
FROM period_rows;
