```sql
-- Description: Show the distinct January-2022 dates (sorted) for that country
SELECT DISTINCT insert_date
FROM cities
WHERE country_code_2 = '??'
  AND insert_date BETWEEN '2022-01-01' AND '2022-01-31'
ORDER BY insert_date;
```

```sql
-- Description: Label consecutive-day streaks for that country inside January-2022
WITH d AS (
    SELECT DATE(insert_date) AS d
    FROM cities
    WHERE country_code_2 = '??'
      AND insert_date BETWEEN '2022-01-01' AND '2022-01-31'
    GROUP BY d
),
seq AS (
    SELECT d,
           ROW_NUMBER() OVER (ORDER BY d)                                  AS rn,
           julianday(d) - ROW_NUMBER() OVER (ORDER BY d)                   AS grp
    FROM d
)
SELECT grp,
       MIN(d)  AS seq_start,
       MAX(d)  AS seq_end,
       COUNT(*) AS seq_len
FROM seq
GROUP BY grp
ORDER BY seq_len DESC
LIMIT 20;
```

```sql
-- Description: Isolate the single LONGEST consecutive-day period for that country in January-2022
WITH d AS (
    SELECT DATE(insert_date) AS d
    FROM cities
    WHERE country_code_2 = '??'
      AND insert_date BETWEEN '2022-01-01' AND '2022-01-31'
    GROUP BY d
),
seq AS (
    SELECT d,
           ROW_NUMBER() OVER (ORDER BY d)                              AS rn,
           julianday(d) - ROW_NUMBER() OVER (ORDER BY d)               AS grp
    FROM d
),
longest AS (
    SELECT grp,
           MIN(d) AS seq_start,
           MAX(d) AS seq_end,
           COUNT(*) AS seq_len
    FROM seq
    GROUP BY grp
    ORDER BY seq_len DESC
    LIMIT 1
)
SELECT seq_start, seq_end
FROM longest;
```

```sql
-- Description: Count total rows & capital-city rows that fall INSIDE that longest streak
WITH longest AS (
    -- same logic as above to get seq_start & seq_end
    WITH d AS (
        SELECT DATE(insert_date) AS d
        FROM cities
        WHERE country_code_2 = '??'
          AND insert_date BETWEEN '2022-01-01' AND '2022-01-31'
        GROUP BY d
    ),
    seq AS (
        SELECT d,
               ROW_NUMBER() OVER (ORDER BY d)                        AS rn,
               julianday(d) - ROW_NUMBER() OVER (ORDER BY d)         AS grp
        FROM d
    )
    SELECT MIN(d) AS seq_start,
           MAX(d) AS seq_end
    FROM seq
    GROUP BY grp
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT
    COUNT(*)                                                         AS total_rows,
    SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END)                     AS capital_rows
FROM cities, longest
WHERE country_code_2 = '??'
  AND insert_date BETWEEN seq_start AND seq_end;
```

```sql
-- Description: Compute the proportion of capital-city records within that longest consecutive period
WITH longest AS (
    WITH d AS (
        SELECT DATE(insert_date) AS d
        FROM cities
        WHERE country_code_2 = '??'
          AND insert_date BETWEEN '2022-01-01' AND '2022-01-31'
        GROUP BY d
    ),
    seq AS (
        SELECT d,
               ROW_NUMBER() OVER (ORDER BY d)                        AS rn,
               julianday(d) - ROW_NUMBER() OVER (ORDER BY d)         AS grp
        FROM d
    )
    SELECT MIN(d) AS seq_start,
           MAX(d) AS seq_end
    FROM seq
    GROUP BY grp
    ORDER BY COUNT(*) DESC
    LIMIT 1
),
totals AS (
    SELECT
        COUNT(*)                                    AS total_rows,
        SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END) AS capital_rows
    FROM cities, longest
    WHERE country_code_2 = '??'
      AND insert_date BETWEEN seq_start AND seq_end
)
SELECT capital_rows * 1.0 / total_rows AS capital_proportion
FROM totals;
```
