```sql
--Description: Net balance (received – sent) for each address, ordered ascending (smallest positive first)
WITH ins  AS (
    SELECT "TO_ADDRESS"   AS "ADDR", SUM("VALUE"::NUMBER) AS "IN_AMT"
    FROM CRYPTO.CRYPTO_ETHEREUM."TOKEN_TRANSFERS"
    WHERE "TOKEN_ADDRESS" = '0xa92a861fc11b99b24296af880011b47f9cafb5ab'
    GROUP BY "TO_ADDRESS"
),
outs AS (
    SELECT "FROM_ADDRESS" AS "ADDR", SUM("VALUE"::NUMBER) AS "OUT_AMT"
    FROM CRYPTO.CRYPTO_ETHEREUM."TOKEN_TRANSFERS"
    WHERE "TOKEN_ADDRESS" = '0xa92a861fc11b99b24296af880011b47f9cafb5ab'
    GROUP BY "FROM_ADDRESS"
)
SELECT i."ADDR",
       COALESCE(i."IN_AMT",0)  - COALESCE(o."OUT_AMT",0) AS "NET_BAL"
FROM ins i
LEFT JOIN outs o USING ("ADDR")
WHERE (COALESCE(i."IN_AMT",0)  - COALESCE(o."OUT_AMT",0)) > 0
ORDER BY "NET_BAL"
LIMIT 20;
```

```sql
--Description: Same net-balance query but returning exactly the three smallest positive balances
WITH ins  AS (
    SELECT "TO_ADDRESS"   AS "ADDR", SUM("VALUE"::NUMBER) AS "IN_AMT"
    FROM CRYPTO.CRYPTO_ETHEREUM."TOKEN_TRANSFERS"
    WHERE "TOKEN_ADDRESS" = '0xa92a861fc11b99b24296af880011b47f9cafb5ab'
    GROUP BY "TO_ADDRESS"
),
outs AS (
    SELECT "FROM_ADDRESS" AS "ADDR", SUM("VALUE"::NUMBER) AS "OUT_AMT"
    FROM CRYPTO.CRYPTO_ETHEREUM."TOKEN_TRANSFERS"
    WHERE "TOKEN_ADDRESS" = '0xa92a861fc11b99b24296af880011b47f9cafb5ab'
    GROUP BY "FROM_ADDRESS"
)
SELECT i."ADDR",
       COALESCE(i."IN_AMT",0)  - COALESCE(o."OUT_AMT",0) AS "NET_BAL"
FROM ins i
LEFT JOIN outs o USING ("ADDR")
WHERE (COALESCE(i."IN_AMT",0)  - COALESCE(o."OUT_AMT",0)) > 0
ORDER BY "NET_BAL"
LIMIT 3;
```

