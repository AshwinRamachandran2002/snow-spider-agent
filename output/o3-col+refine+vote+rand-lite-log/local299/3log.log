```sql
/* ------------------------------------------------------------
   Monthly totals of customers’ maximum 30-day running-balance
   averages (baseline month for every customer excluded)
------------------------------------------------------------*/
WITH daily_net AS (          -- 1. net movement per customer per day
    SELECT
        "customer_id",
        DATE("txn_date")                         AS "txn_date",
        SUM(CASE WHEN "txn_type" = 'deposit'
                 THEN  "txn_amount"
                 ELSE - "txn_amount" END)        AS "net_amount"
    FROM "customer_transactions"
    GROUP BY "customer_id", DATE("txn_date")
),

running_balance AS (         -- 2. daily running balance
    SELECT
        dn."customer_id",
        dn."txn_date",
        SUM(dn."net_amount") OVER (
            PARTITION BY dn."customer_id"
            ORDER BY       dn."txn_date"
        )                                         AS "running_balance"
    FROM daily_net dn
),

rolling_avg_raw AS (         -- 3. 30-day rolling average (negatives → 0)
    SELECT
        rb."customer_id",
        rb."txn_date",
        /* average over current day + 29 preceding */
        MAX(0,
            AVG(rb."running_balance") OVER (
                PARTITION BY rb."customer_id"
                ORDER BY       rb."txn_date"
                ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
            )
        )                                     AS "avg_30d_bal",
        /* how many rows in the 30-day window? */
        COUNT(*) OVER (
            PARTITION BY rb."customer_id"
            ORDER BY       rb."txn_date"
            ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
        )                                     AS "row_cnt"
    FROM running_balance rb
),

rolling_avg AS (             -- 4. keep rows only after 30 days of data
    SELECT
        "customer_id",
        "txn_date",
        "avg_30d_bal"
    FROM rolling_avg_raw
    WHERE "row_cnt" = 30
),

customer_first_month AS (    -- 5. first (baseline) calendar month per customer
    SELECT
        "customer_id",
        strftime('%Y-%m', MIN(DATE("txn_date"))) AS "baseline_month"
    FROM "customer_transactions"
    GROUP BY "customer_id"
),

monthly_max AS (             -- 6. max 30-day average per customer per month
    SELECT
        ra."customer_id",
        strftime('%Y-%m', ra."txn_date")         AS "year_month",
        MAX(ra."avg_30d_bal")                    AS "max_30d_bal"
    FROM rolling_avg ra
    GROUP BY ra."customer_id",
             strftime('%Y-%m', ra."txn_date")
),

monthly_max_excl_base AS (   -- 7. exclude each customer’s baseline month
    SELECT
        mm.*
    FROM monthly_max         AS mm
    JOIN customer_first_month AS cf
      ON mm."customer_id" = cf."customer_id"
    WHERE mm."year_month" <> cf."baseline_month"
)

-- 8. final monthly totals across all customers
SELECT
    "year_month",
    ROUND(SUM("max_30d_bal"), 4) AS "total_max_30d_bal"
FROM monthly_max_excl_base
GROUP BY "year_month"
ORDER BY "year_month";
```
