--Description: Demonstrate a 30-day rolling average balance for one customer (negative averages coerced to zero)
WITH daily_txn AS (
    SELECT
        "txn_date",
        SUM(CASE WHEN "txn_type" = 'deposit' THEN "txn_amount"
                 ELSE                       - "txn_amount" END) AS "net_amount"
    FROM "customer_transactions"
    WHERE "customer_id" = 1
    GROUP BY "txn_date"
),
running_bal AS (
    SELECT
        "txn_date",
        SUM("net_amount") OVER (ORDER BY "txn_date") AS "running_balance"
    FROM daily_txn
),
rolling_avg AS (
    SELECT
        "txn_date",
        MAX(0, AVG("running_balance") OVER (
                 ORDER BY "txn_date"
                 ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
             )) AS "avg_30d_bal"
    FROM running_bal
)
SELECT DISTINCT *
FROM rolling_avg
WHERE "avg_30d_bal" IS NOT NULL
LIMIT 20;
