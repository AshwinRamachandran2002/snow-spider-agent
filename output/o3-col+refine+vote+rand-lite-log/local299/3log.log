```sql
--Description: View the different transaction types recorded in the customer‐level ledger
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
--Description: See a snapshot of raw transaction data for the first five customers (by id) and first 20 rows
SELECT *
FROM "customer_transactions"
WHERE "customer_id" IN (
       SELECT DISTINCT "customer_id"
       FROM "customer_transactions"
       ORDER BY "customer_id"
       LIMIT 5
)
LIMIT 20;
```

```sql
--Description: Check the date span of all customer transactions
SELECT DISTINCT
       MIN("txn_date") AS "earliest_txn_date",
       MAX("txn_date") AS "latest_txn_date"
FROM "customer_transactions";
```

```sql
--Description: Retrieve each customer’s first (baseline) transaction date
SELECT DISTINCT
       "customer_id",
       MIN("txn_date") AS "first_txn_date"
FROM "customer_transactions"
GROUP BY "customer_id"
LIMIT 20;
```

```sql
--Description: List the distinct calendar months that have any customer activity
SELECT DISTINCT
       strftime('%Y-%m', "txn_date") AS "year_month"
FROM "customer_transactions"
ORDER BY "year_month"
LIMIT 20;
```

```sql
--Description: Compare transaction activity with region information by joining to customer_nodes
SELECT DISTINCT
       ct."customer_id",
       cn."region_id",
       ct."txn_type",
       ct."txn_amount",
       ct."txn_date"
FROM "customer_transactions" AS ct
JOIN "customer_nodes"       AS cn
  ON ct."customer_id" = cn."customer_id"
LIMIT 20;
```

```sql
--Description: Inspect the distribution of transaction amounts (rounded to nearest $100)
SELECT DISTINCT
       (CAST("txn_amount" / 100 AS INTEGER) * 100) AS "rounded_amount",
       COUNT(*)                                  AS "txn_cnt"
FROM "customer_transactions"
GROUP BY "rounded_amount"
ORDER BY "txn_cnt" DESC
LIMIT 20;
```

```sql
--Description: Compute daily net movement (deposits positive, everything else negative) for a single sample customer
WITH daily_txn AS (
    SELECT
        "txn_date",
        SUM(CASE WHEN "txn_type" = 'deposit' THEN "txn_amount"
                 ELSE                       - "txn_amount" END) AS "net_amount"
    FROM "customer_transactions"
    WHERE "customer_id" = 1
    GROUP BY "txn_date"
)
SELECT DISTINCT *
FROM daily_txn
ORDER BY "txn_date"
LIMIT 20;
```

```sql
--Description: Show the running balance for a sample customer after each day
WITH daily_txn AS (
    SELECT
        "txn_date",
        SUM(CASE WHEN "txn_type" = 'deposit' THEN "txn_amount"
                 ELSE                       - "txn_amount" END) AS "net_amount"
    FROM "customer_transactions"
    WHERE "customer_id" = 1
    GROUP BY "txn_date"
),
running_bal AS (
    SELECT
        "txn_date",
        SUM("net_amount") OVER (ORDER BY "txn_date") AS "running_balance"
    FROM daily_txn
)
SELECT DISTINCT *
FROM running_bal
ORDER BY "txn_date"
LIMIT 20;
```

```sql
--Description: Demonstrate a 30-day rolling average balance for one customer (negative averages coerced to zero)
WITH daily_txn AS (
    SELECT
        "txn_date",
        SUM(CASE WHEN "txn_type" = 'deposit' THEN "txn_amount"
                 ELSE                       - "txn_amount" END) AS "net_amount"
    FROM "customer_transactions"
    WHERE "customer_id" = 1
    GROUP BY "txn_date"
),
running_bal AS (
    SELECT
        "txn_date",
        SUM("net_amount") OVER (ORDER BY "txn_date") AS "running_balance"
    FROM daily_txn
),
rolling_avg AS (
    SELECT
        "txn_date",
        MAX(0, AVG("running_balance") OVER (
                 ORDER BY "txn_date"
                 ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
             )) AS "avg_30d_bal"
    FROM running_bal
)
SELECT DISTINCT *
FROM rolling_avg
WHERE "avg_30d_bal" IS NOT NULL
LIMIT 20;
```
