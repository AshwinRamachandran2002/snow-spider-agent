Query:
--Description: 8.  Maximum positive 30-day rolling-average balance per customer
--              and month.  To ensure results even when a customer holds fewer
--              than 30 daily records, we DROP the “rn ≥ 30” filter and instead
--              keep every day while clipping negative averages to zero.
WITH daily_net AS (                             -- daily net cash-flow
    SELECT  "customer_id",
            DATE("txn_date") AS "txn_day",
            SUM(CASE WHEN "txn_type" = 'deposit'
                     THEN  "txn_amount"
                     ELSE - "txn_amount" END) AS "net_amount"
    FROM    "customer_transactions"
    GROUP   BY "customer_id", DATE("txn_date")
),
running_bal AS (                                -- running balance
    SELECT  dn.*,
            SUM(dn."net_amount") OVER (
                PARTITION BY dn."customer_id"
                ORDER BY      dn."txn_day"
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
            ) AS "balance"
    FROM    daily_net dn
),
rolling_avg AS (                                -- 30-day rolling average
    SELECT  rb."customer_id",
            rb."txn_day",
            AVG(rb."balance") OVER (
                PARTITION BY rb."customer_id"
                ORDER BY      rb."txn_day"
                ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
            ) AS "avg_bal_30d"
    FROM    running_bal rb
),
positive30 AS (                                 -- negative → 0
    SELECT  "customer_id",
            "txn_day",
            CASE WHEN "avg_bal_30d" < 0 THEN 0 ELSE "avg_bal_30d" END AS "avg_bal_30d_pos"
    FROM    rolling_avg
)
SELECT  p."customer_id",
        strftime('%Y-%m', p."txn_day") AS "year_month",
        MAX(p."avg_bal_30d_pos")       AS "max_avg_30d"
FROM    positive30 p
GROUP  BY p."customer_id", strftime('%Y-%m', p."txn_day")
