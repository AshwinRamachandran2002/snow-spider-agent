```sql
--Description: 10.  FINAL ANSWER – monthly totals of summed maximum 30-day averages,
--                   excluding each customer’s baseline month.
WITH daily_net AS (
       SELECT "customer_id",
              DATE("txn_date")                          AS "txn_day",
              SUM(CASE WHEN "txn_type"='deposit'
                       THEN  "txn_amount"
                       ELSE - "txn_amount" END)         AS "net_amount"
       FROM   "customer_transactions"
       GROUP  BY "customer_id", DATE("txn_date")
),
 --Generate a full calendar per customer so balances persist on days without activity
date_span AS (
       SELECT dn."customer_id",
              MIN(dn."txn_day") AS "min_day",
              MAX(dn."txn_day") AS "max_day"
       FROM   daily_net dn
       GROUP  BY dn."customer_id"
),
calendar(customer_id, cal_day) AS (
       SELECT ds."customer_id", ds."min_day"
       FROM   date_span ds
       UNION ALL
       SELECT c."customer_id",
              DATE(c."cal_day", '+1 day')
       FROM   calendar c
       JOIN   date_span ds
         ON   ds."customer_id" = c."customer_id"
        AND  DATE(c."cal_day", '+1 day') <= ds."max_day"
),
daily_bal AS (
       SELECT c."customer_id",
              c."cal_day",
              COALESCE(dn."net_amount", 0)          AS "net_amount"
       FROM   calendar  c
       LEFT  JOIN daily_net dn
              ON  dn."customer_id" = c."customer_id"
              AND dn."txn_day"     = c."cal_day"
),
running_bal AS (
       SELECT db.*,
              SUM(db."net_amount") OVER (
                   PARTITION BY db."customer_id"
                   ORDER BY      db."cal_day"
                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
              )                                     AS "balance"
       FROM   daily_bal db
),
rolling30 AS (
       SELECT rb."customer_id",
              rb."cal_day",
              AVG(rb."balance") OVER (
                  PARTITION BY rb."customer_id"
                  ORDER BY      rb."cal_day"
                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
              )                                     AS "avg_bal_30d"
       FROM   running_bal rb
       WHERE  ROW_NUMBER() OVER (
                 PARTITION BY rb."customer_id"
                 ORDER BY      rb."cal_day"
             ) >= 30
),
positive30 AS (
       SELECT "customer_id",
              "cal_day",
              CASE WHEN "avg_bal_30d" < 0 THEN 0 ELSE "avg_bal_30d" END AS "avg_bal_30d_pos"
       FROM   rolling30
),
month_max AS (
       SELECT p."customer_id",
              strftime('%Y-%m', p."cal_day")        AS "year_month",
              MAX(p."avg_bal_30d_pos")              AS "max_30d_avg"
       FROM   positive30 p
       GROUP  BY p."customer_id", strftime('%Y-%m', p."cal_day")
),
baseline AS (
       SELECT "customer_id",
              MIN("year_month")                     AS "first_month"
       FROM   month_max
       GROUP  BY "customer_id"
)
SELECT mm."year_month",
       SUM(mm."max_30d_avg")                        AS "sum_max_30d_avg_all_customers"
FROM   month_max  mm
LEFT  JOIN baseline b
       ON  b."customer_id" = mm."customer_id"
WHERE  mm."year_month" <> b."first_month"          --exclude baseline month
GROUP  BY mm."year_month"
ORDER  BY mm."year_month";
```
