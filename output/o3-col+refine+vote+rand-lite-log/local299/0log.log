--Description: 9.  First (baseline) month of transactions for every customer.
SELECT  "customer_id",
        MIN(strftime('%Y-%m', "txn_date")) AS "first_month"
FROM    "customer_transactions"
GROUP  BY "customer_id"
LIMIT   20;
