                PARTITION BY dn."customer_id"
                ORDER BY      dn."txn_day"
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
            ) AS "balance"
    FROM    daily_net dn
),
rolling_calc AS (
    SELECT  rb."customer_id",
            rb."txn_day",
            AVG(rb."balance") OVER (
                PARTITION BY rb."customer_id"
                ORDER BY      rb."txn_day"
                ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
            ) AS "avg_bal_30d",
            ROW_NUMBER() OVER (
                PARTITION BY rb."customer_id"
                ORDER BY      rb."txn_day"
            ) AS "rn"
    FROM    running_bal rb
),
positive30 AS (
    SELECT  "customer_id",
            "txn_day",
            CASE WHEN "avg_bal_30d" < 0 THEN 0 ELSE "avg_bal_30d" END AS "avg_bal_30d_pos"
    FROM    rolling_calc
    WHERE   "rn" >= 30
)
SELECT  p."customer_id",
        strftime('%Y-%m', p."txn_day") AS "year_month",
        MAX(p."avg_bal_30d_pos")       AS "max_avg_30d"
FROM    positive30 p
GROUP  BY p."customer_id", strftime('%Y-%m', p."txn_day")
LIMIT  20;
```

