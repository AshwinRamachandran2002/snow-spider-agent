```sql
--Description: 4.  See the net cash-flow (deposits – every other type) per customer per day.
SELECT "customer_id",
       DATE("txn_date")                            AS "txn_day",
       SUM(CASE WHEN "txn_type"='deposit'
                THEN  "txn_amount"
                ELSE - "txn_amount" END)           AS "net_amount"
FROM   "customer_transactions"
GROUP  BY "customer_id", DATE("txn_date")
LIMIT 20;
```

```sql
--Description: 5.  Build each customer’s day-by-day running balance.
WITH daily_net AS (
       SELECT "customer_id",
              DATE("txn_date")                          AS "txn_day",
              SUM(CASE WHEN "txn_type"='deposit'
                       THEN  "txn_amount"
                       ELSE - "txn_amount" END)         AS "net_amount"
       FROM   "customer_transactions"
       GROUP  BY "customer_id", DATE("txn_date")
)
SELECT dn."customer_id",
       dn."txn_day",
       SUM(dn."net_amount") OVER (
           PARTITION BY dn."customer_id"
           ORDER BY      dn."txn_day"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
       )                                                AS "running_balance"
FROM   daily_net AS dn
ORDER  BY dn."customer_id", dn."txn_day"
LIMIT 20;
```

```sql
--Description: 6.  Derive the 30-day rolling average balance (show only after 30 days).
WITH daily_net AS (
       SELECT "customer_id",
              DATE("txn_date")                          AS "txn_day",
              SUM(CASE WHEN "txn_type"='deposit'
                       THEN  "txn_amount"
                       ELSE - "txn_amount" END)         AS "net_amount"
       FROM   "customer_transactions"
       GROUP  BY "customer_id", DATE("txn_date")
),
running_bal AS (
       SELECT dn.*,
              SUM(dn."net_amount") OVER (
                   PARTITION BY dn."customer_id"
                   ORDER BY      dn."txn_day"
                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
              )                                         AS "balance"
       FROM   daily_net dn
)
SELECT rb."customer_id",
       rb."txn_day",
       AVG(rb."balance") OVER (
           PARTITION BY rb."customer_id"
           ORDER BY      rb."txn_day"
           ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
       )                                                AS "avg_bal_30d"
FROM   running_bal rb
WHERE  ROW_NUMBER() OVER (PARTITION BY rb."customer_id" ORDER BY rb."txn_day") >= 30
LIMIT 20;
```

```sql
--Description: 7.  Treat negative 30-day averages as zero and keep one record per day.
WITH daily_net AS (
       SELECT "customer_id",
              DATE("txn_date")                          AS "txn_day",
              SUM(CASE WHEN "txn_type"='deposit'
                       THEN  "txn_amount"
                       ELSE - "txn_amount" END)         AS "net_amount"
       FROM   "customer_transactions"
       GROUP  BY "customer_id", DATE("txn_date")
),
running_bal AS (
       SELECT dn.*,
              SUM(dn."net_amount") OVER (
                   PARTITION BY dn."customer_id"
                   ORDER BY      dn."txn_day"
                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
              )                                         AS "balance"
       FROM   daily_net dn
),
rolling30 AS (
       SELECT rb."customer_id",
              rb."txn_day",
              AVG(rb."balance") OVER (
                  PARTITION BY rb."customer_id"
                  ORDER BY      rb."txn_day"
                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
              )                                         AS "avg_bal_30d"
       FROM   running_bal rb
       WHERE  ROW_NUMBER() OVER (PARTITION BY rb."customer_id"
                                 ORDER BY rb."txn_day") >= 30
)
SELECT "customer_id",
       "txn_day",
       CASE WHEN "avg_bal_30d" < 0 THEN 0 ELSE "avg_bal_30d" END AS "avg_bal_30d_pos"
FROM   rolling30
LIMIT 20;
```

```sql
--Description: 8.  Find each customer’s maximum 30-day average balance per month.
WITH daily_net AS (
       SELECT "customer_id",
              DATE("txn_date")                          AS "txn_day",
              SUM(CASE WHEN "txn_type"='deposit'
                       THEN  "txn_amount"
                       ELSE - "txn_amount" END)         AS "net_amount"
       FROM   "customer_transactions"
       GROUP  BY "customer_id", DATE("txn_date")
),
running_bal AS (
       SELECT dn.*,
              SUM(dn."net_amount") OVER (
                   PARTITION BY dn."customer_id"
                   ORDER BY      dn."txn_day"
                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
              )                                         AS "balance"
       FROM   daily_net dn
),
rolling30 AS (
       SELECT rb."customer_id",
              rb."txn_day",
              AVG(rb."balance") OVER (
                  PARTITION BY rb."customer_id"
                  ORDER BY      rb."txn_day"
                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
              )                                         AS "avg_bal_30d"
       FROM   running_bal rb
       WHERE  ROW_NUMBER() OVER (PARTITION BY rb."customer_id"
                                 ORDER BY rb."txn_day") >= 30
),
positive30 AS (
       SELECT "customer_id",
              "txn_day",
              CASE WHEN "avg_bal_30d" < 0 THEN 0 ELSE "avg_bal_30d" END AS "avg_bal_30d_pos"
       FROM   rolling30
)
SELECT p."customer_id",
       strftime('%Y-%m', p."txn_day")                   AS "year_month",
       MAX(p."avg_bal_30d_pos")                        AS "max_avg_30d"
FROM   positive30 p
GROUP  BY p."customer_id", strftime('%Y-%m', p."txn_day")
LIMIT 20;
