```sql
--Description:  Simplified view ─ just build each customer’s day-by-day running
--              balance (no further 30-day filter) so rows will always appear.
--              1️⃣ daily_net  : net cash-flow per customer per calendar day
--              2️⃣ running_bal: cumulative balance per customer
--              Show first 20 rows to verify data exists.
WITH daily_net AS (                         -- net movement (+deposit, –others)
    SELECT  "customer_id",
            DATE("txn_date") AS "txn_day",
            SUM(CASE WHEN "txn_type" = 'deposit'
                     THEN  "txn_amount"
                     ELSE - "txn_amount" END) AS "net_amount"
    FROM    "customer_transactions"
    GROUP   BY "customer_id", DATE("txn_date")
),
running_bal AS (                            -- cumulative balance
    SELECT  dn.*,
            SUM(dn."net_amount") OVER (
                PARTITION BY dn."customer_id"
                ORDER BY      dn."txn_day"
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
            ) AS "running_balance"
    FROM    daily_net dn
)
SELECT  "customer_id",
        "txn_day",
        "running_balance"
FROM    running_bal
ORDER BY "customer_id", "txn_day"
LIMIT 20;
