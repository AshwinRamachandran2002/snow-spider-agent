```sql
--Description: 10.  Final result – for every calendar month, sum the maximum
--                 positive 30-day average balances across customers, excluding
--                 each customer’s baseline month.  All row-number filters are
--                 handled in an outer CTE so no window function appears in a
--                 WHERE clause.
WITH daily_net AS (
    SELECT  "customer_id",
            DATE("txn_date") AS "txn_day",
            SUM(CASE WHEN "txn_type"='deposit'
                     THEN  "txn_amount"
                     ELSE - "txn_amount" END) AS "net_amount"
    FROM    "customer_transactions"
    GROUP   BY "customer_id", DATE("txn_date")
),
date_span AS (                                  -- span per customer
    SELECT  "customer_id",
            MIN("txn_day") AS "min_day",
            MAX("txn_day") AS "max_day"
    FROM    daily_net
    GROUP   BY "customer_id"
),
calendar(customer_id, cal_day) AS (             -- recursive, full calendar
    SELECT  ds."customer_id", ds."min_day" FROM date_span ds
    UNION ALL
    SELECT  c."customer_id", DATE(c."cal_day", '+1 day')
    FROM    calendar c
    JOIN    date_span ds
           ON ds."customer_id" = c."customer_id"
          AND DATE(c."cal_day", '+1 day') <= ds."max_day"
),
daily_bal AS (                                  -- include zero-activity days
    SELECT  cal."customer_id",
            cal."cal_day",
            COALESCE(dn."net_amount", 0) AS "net_amount"
    FROM    calendar cal
    LEFT JOIN daily_net dn
           ON dn."customer_id" = cal."customer_id"
          AND dn."txn_day"     = cal."cal_day"
),
running_bal AS (                                -- running balance
    SELECT  db.*,
            SUM(db."net_amount") OVER (
                PARTITION BY db."customer_id"
                ORDER BY      db."cal_day"
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
            ) AS "balance"
    FROM    daily_bal db
),
rolling_calc AS (                               -- 30-day average + row index
    SELECT  rb."customer_id",
            rb."cal_day",
            AVG(rb."balance") OVER (
                PARTITION BY rb."customer_id"
                ORDER BY      rb."cal_day"
                ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
            ) AS "avg_bal_30d",
            ROW_NUMBER() OVER (
                PARTITION BY rb."customer_id"
                ORDER BY      rb."cal_day"
            ) AS "rn"
    FROM    running_bal rb
),
positive30 AS (                                 -- keep ≥30 days, negatives→0
    SELECT  "customer_id",
            "cal_day",
            CASE WHEN "avg_bal_30d" < 0 THEN 0 ELSE "avg_bal_30d" END AS "avg_bal_30d_pos"
    FROM    rolling_calc
    WHERE   "rn" >= 30
),
month_max AS (                                  -- max per month & customer
    SELECT  "customer_id",
            strftime('%Y-%m', "cal_day") AS "year_month",
            MAX("avg_bal_30d_pos")        AS "max_30d_avg"
    FROM    positive30
    GROUP  BY "customer_id", strftime('%Y-%m', "cal_day")
),
baseline AS (                                   -- first month per customer
    SELECT  "customer_id",
            MIN("year_month") AS "first_month"
    FROM    month_max
    GROUP  BY "customer_id"
)
SELECT  mm."year_month",
        SUM(mm."max_30d_avg") AS "sum_max_30d_avg_all_customers"
FROM    month_max mm
JOIN    baseline b
      ON b."customer_id" = mm."customer_id"
WHERE   mm."year_month" <> b."first_month"      -- exclude baseline month
GROUP  BY mm."year_month"
ORDER BY mm."year_month";
```
