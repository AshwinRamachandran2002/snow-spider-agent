```sql
--Description: 7.  30-day rolling average balance (negative values forced to 0).
--              The row-number filter is now performed in an outer query so that
--              the window function is never used inside a WHERE clause.
WITH daily_net AS (                            -- daily net movement
    SELECT  "customer_id",
            DATE("txn_date") AS "txn_day",
            SUM(CASE WHEN "txn_type"='deposit'
                     THEN  "txn_amount"
                     ELSE - "txn_amount" END) AS "net_amount"
    FROM    "customer_transactions"
    GROUP   BY "customer_id", DATE("txn_date")
),
running_bal AS (                               -- cumulative balance
    SELECT  dn.*,
            SUM(dn."net_amount") OVER (
                PARTITION BY dn."customer_id"
                ORDER BY      dn."txn_day"
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
            ) AS "balance"
    FROM    daily_net dn
),
rolling_calc AS (                              -- 30-day rolling avg + row index
    SELECT  rb."customer_id",
            rb."txn_day",
            AVG(rb."balance") OVER (
                PARTITION BY rb."customer_id"
                ORDER BY      rb."txn_day"
                ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
            ) AS "avg_bal_30d",
            ROW_NUMBER() OVER (
                PARTITION BY rb."customer_id"
                ORDER BY      rb."txn_day"
            ) AS "rn"
    FROM    running_bal rb
)
SELECT  "customer_id",
        "txn_day",
        CASE WHEN "avg_bal_30d" < 0 THEN 0 ELSE "avg_bal_30d" END AS "avg_bal_30d_pos"
FROM    rolling_calc
WHERE   "rn" >= 30
LIMIT   20;
