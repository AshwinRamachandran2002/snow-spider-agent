```sql
--Description:  Build daily running balances, then calculate a 30-day rolling average
--              balance per customer.  Because SQLite does not allow a window
--              function directly in the WHERE clause, we first number each
--              customer’s rows (rn) inside a CTE and afterwards keep only rows
--              with rn ≥ 30 so every retained record already has 30 days of
--              balance history behind it.  Finally, show 20 sample rows.
WITH daily_net AS (                            -- 1️⃣ daily net cash-flow
    SELECT  "customer_id",
            DATE("txn_date") AS "txn_day",
            SUM(CASE WHEN "txn_type"='deposit'
                     THEN  "txn_amount"
                     ELSE - "txn_amount" END) AS "net_amt"
    FROM    "customer_transactions"
    GROUP   BY "customer_id", DATE("txn_date")
),
running_bal AS (                               -- 2️⃣ running balance
    SELECT  dn.*,
            SUM(dn."net_amt") OVER (
                PARTITION BY dn."customer_id"
                ORDER BY      dn."txn_day"
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
            ) AS "balance"
    FROM    daily_net dn
),
rolling AS (                                   -- 3️⃣ 30-day rolling avg + row index
    SELECT  rb."customer_id",
            rb."txn_day",
            AVG(rb."balance") OVER (
                PARTITION BY rb."customer_id"
                ORDER BY      rb."txn_day"
                ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
            ) AS "avg_bal_30d",
            ROW_NUMBER() OVER (
                PARTITION BY rb."customer_id"
                ORDER BY      rb."txn_day"
            ) AS "rn"
    FROM    running_bal rb
)
SELECT  "customer_id",
        "txn_day",
        "avg_bal_30d"
FROM    rolling
WHERE   "rn" >= 30                              -- ensure 30-day window exists
LIMIT   20;
```
