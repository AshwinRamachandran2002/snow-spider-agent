```sql
--Description: 30-day rolling average balance for each customer/day (shown once 30 days of data exist)  
WITH daily_bal AS (
  SELECT "customer_id",
         "txn_date",
         SUM(CASE WHEN "txn_type" = 'deposit'
                  THEN  "txn_amount"
                  ELSE - "txn_amount" END) AS "delta"
  FROM   "customer_transactions"
  GROUP  BY "customer_id", "txn_date"
),
running AS (
  SELECT db."customer_id",
         db."txn_date",
         SUM(db."delta") OVER (PARTITION BY db."customer_id"
                               ORDER BY db."txn_date"
                               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "balance"
  FROM   daily_bal AS db
)
SELECT r."customer_id",
       r."txn_date",
       MAX(0, AVG(r."balance") OVER (PARTITION BY r."customer_id"
                                     ORDER BY r."txn_date"
                                     ROWS BETWEEN 29 PRECEDING AND CURRENT ROW)) AS "avg_30d_balance"
FROM   running AS r
WHERE  (julianday(r."txn_date") -
       MIN(julianday(r."txn_date")) OVER (PARTITION BY r."customer_id")) >= 29
LIMIT 20;
```

```sql
--Description: Customer’s maximum 30-day average balance for each month (sample of 20 rows)  
WITH daily_avg AS (
  /* use the CTE from the previous query, omit WHERE/LIMIT for full set */
  SELECT r."customer_id",
         SUBSTR(r."txn_date", 1, 7) AS "year_month",
         MAX(0, AVG(r."balance") OVER (PARTITION BY r."customer_id"
                                       ORDER BY r."txn_date"
                                       ROWS BETWEEN 29 PRECEDING AND CURRENT ROW)) AS "avg_30d_balance",
         MIN(r."txn_date") OVER (PARTITION BY r."customer_id") AS "first_txn_date"
  FROM  (
        SELECT "customer_id",
               "txn_date",
               SUM(CASE WHEN "txn_type" = 'deposit'
                        THEN  "txn_amount"
                        ELSE - "txn_amount" END) AS "delta"
        FROM  "customer_transactions"
        GROUP BY "customer_id", "txn_date"
  ) AS d
  JOIN (
        SELECT "customer_id",
               "txn_date",
               SUM("delta") OVER (PARTITION BY "customer_id"
                                  ORDER BY "txn_date"
                                  ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "balance"
        FROM (
             SELECT "customer_id",
                    "txn_date",
                    SUM(CASE WHEN "txn_type" = 'deposit'
                             THEN  "txn_amount"
                             ELSE - "txn_amount" END) AS "delta"
             FROM "customer_transactions"
             GROUP BY "customer_id","txn_date"
        )
  ) AS r USING ("customer_id","txn_date")
)
SELECT DISTINCT "customer_id",
       "year_month",
       MAX("avg_30d_balance") AS "max_30d_avg_bal"
FROM   daily_avg
WHERE  "year_month" > SUBSTR("first_txn_date",1,7)   -- exclude baseline month
GROUP  BY "customer_id", "year_month"
LIMIT 20;
```

```sql
--Description: Final monthly totals – sum of customers’ maximum 30-day averages, excluding baseline month  
WITH daily_avg AS (
  /* Same CTE as previous step but without LIMITs so full data is processed */
  SELECT r."customer_id",
         SUBSTR(r."txn_date", 1, 7) AS "year_month",
         MAX(0, AVG(r."balance") OVER (PARTITION BY r."customer_id"
                                       ORDER BY r."txn_date"
                                       ROWS BETWEEN 29 PRECEDING AND CURRENT ROW)) AS "avg_30d_balance",
         MIN(r."txn_date") OVER (PARTITION BY r."customer_id") AS "first_txn_date"
  FROM  (
        SELECT "customer_id",
               "txn_date",
               SUM(CASE WHEN "txn_type" = 'deposit'
                        THEN  "txn_amount"
                        ELSE - "txn_amount" END) AS "delta"
        FROM  "customer_transactions"
        GROUP BY "customer_id", "txn_date"
  ) AS d
  JOIN (
        SELECT "customer_id",
               "txn_date",
               SUM("delta") OVER (PARTITION BY "customer_id"
                                  ORDER BY "txn_date"
                                  ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "balance"
        FROM (
             SELECT "customer_id",
                    "txn_date",
                    SUM(CASE WHEN "txn_type" = 'deposit'
                             THEN  "txn_amount"
                             ELSE - "txn_amount" END) AS "delta"
             FROM "customer_transactions"
             GROUP BY "customer_id","txn_date"
        )
  ) AS r USING ("customer_id","txn_date")
),
monthly_max AS (
  SELECT "customer_id",
         "year_month",
         MAX("avg_30d_balance") AS "max_30d_avg_bal"
  FROM   daily_avg
  WHERE  "year_month" > SUBSTR("first_txn_date",1,7)    -- drop the baseline month
  GROUP  BY "customer_id", "year_month"
)
SELECT   "year_month",
         SUM("max_30d_avg_bal") AS "monthly_total_max_30d_avg_balance"
FROM     monthly_max
GROUP    BY "year_month"
ORDER    BY "year_month"
LIMIT 20;
