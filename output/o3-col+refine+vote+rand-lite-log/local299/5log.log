--Description: Running balance by customer/day (sample of 20 rows)  
WITH daily_deltas AS (
  SELECT "customer_id",
         "txn_date",
         SUM(CASE WHEN "txn_type" = 'deposit'
                  THEN  "txn_amount"
                  ELSE - "txn_amount" END) AS "delta"
  FROM   "customer_transactions"
  GROUP  BY "customer_id", "txn_date"
)
SELECT dd."customer_id",
       dd."txn_date",
       SUM(dd."delta") OVER (PARTITION BY dd."customer_id"
                             ORDER BY dd."txn_date"
                             ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
FROM   daily_deltas AS dd
LIMIT 20;
