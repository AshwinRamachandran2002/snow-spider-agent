--Description: End-to-end computation of the question in one statement.
-- • daily   : net movement per customer-day (deposit = +, else = –).
-- • running : cumulative balance per customer-day.
-- • avg30   : 30-day rolling average balance, negatives forced to 0.
-- • month_max: highest 30-day average for each customer in each month.
-- • baseline : first calendar month seen for every customer.
-- The final SELECT drops baseline months and totals the monthly peaks
-- across all customers, returning the bank-wide figure per month.
WITH daily AS (
     SELECT customer_id,
            txn_date,
            SUM(CASE WHEN txn_type = 'deposit'
                     THEN txn_amount
                     ELSE -txn_amount END)         AS daily_net
     FROM   customer_transactions
     GROUP  BY customer_id, txn_date
),
running AS (
     SELECT customer_id,
            txn_date,
            SUM(daily_net) OVER (
                PARTITION BY customer_id
                ORDER BY   txn_date
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
            )                                      AS running_balance
     FROM   daily
),
avg30 AS (
     SELECT customer_id,
            txn_date,
            MAX(0,
                AVG(running_balance) OVER (
                    PARTITION BY customer_id
                    ORDER BY   txn_date
                    ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                )
            )                                     AS avg_30d_balance
     FROM   running
),
month_max AS (
     SELECT customer_id,
            strftime('%Y-%m', txn_date)           AS month_year,
            MAX(avg_30d_balance)                  AS max_30d_balance_in_month
     FROM   avg30
     GROUP  BY customer_id, month_year
),
baseline AS (
     SELECT customer_id,
            MIN(month_year)                       AS baseline_month
     FROM   month_max
     GROUP  BY customer_id
)
SELECT month_max.month_year,
       SUM(month_max.max_30d_balance_in_month)    AS total_peak_30d_balance
FROM   month_max
LEFT   JOIN baseline
       ON baseline.customer_id    = month_max.customer_id
      AND baseline.baseline_month = month_max.month_year
WHERE  baseline.baseline_month IS NULL            -- exclude baseline month
GROUP  BY month_max.month_year
ORDER  BY month_max.month_year
LIMIT 20;
