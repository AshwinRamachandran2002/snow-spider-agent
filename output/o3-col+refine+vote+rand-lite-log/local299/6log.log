-- 5) Still for customer 1, create a running (cumulative) balance by day
WITH daily AS (
  SELECT "customer_id",
         "txn_date",
         SUM(CASE WHEN "txn_type" = 'deposit' 
                  THEN "txn_amount" 
                  ELSE -1 * "txn_amount" END) AS "daily_net"
  FROM "customer_transactions"
  WHERE "customer_id" = 1
  GROUP BY "customer_id", "txn_date"
)
SELECT "customer_id",
       "txn_date",
       "daily_net",
       SUM("daily_net") OVER (
           PARTITION BY "customer_id"
           ORDER BY "txn_date"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
       ) AS "running_balance"
FROM daily
ORDER BY "txn_date"
LIMIT 20;
