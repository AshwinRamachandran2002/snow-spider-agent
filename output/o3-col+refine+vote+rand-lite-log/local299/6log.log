  FROM daily
),
avg30 AS (
  SELECT "customer_id",
         "txn_date",
         CASE 
           WHEN AVG("running_balance") OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "txn_date"
                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                ) < 0
           THEN 0
           ELSE AVG("running_balance") OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "txn_date"
                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                )
         END AS "avg_30d_balance"
  FROM running
),
month_max AS (
  SELECT "customer_id",
         strftime('%Y-%m', "txn_date") AS "month_year",
         MAX("avg_30d_balance") AS "max_30d_balance_in_month"
  FROM avg30
  GROUP BY "customer_id", "month_year"
),
baseline AS (
  SELECT "customer_id",
         MIN("month_year") AS "baseline_month"
  FROM month_max
  GROUP BY "customer_id"
)
SELECT m."month_year",
       SUM(m."max_30d_balance_in_month") AS "total_peak_30d_balance"
FROM month_max AS m
LEFT JOIN baseline AS b
      ON b."customer_id" = m."customer_id"
     AND b."baseline_month" = m."month_year"
WHERE b."baseline_month" IS NULL        -- removes the baseline month
GROUP BY m."month_year"
ORDER BY m."month_year"
LIMIT 20;
