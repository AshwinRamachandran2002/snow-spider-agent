```

```sql
-- 4) For one customer (id = 1), calculate the daily net cash movement  
--    (deposits add, everything else subtracts)
SELECT "customer_id",
       "txn_date",
       SUM(CASE WHEN "txn_type" = 'deposit' 
                THEN "txn_amount" 
                ELSE -1 * "txn_amount" END) AS "daily_net"
FROM "customer_transactions"
WHERE "customer_id" = 1
GROUP BY "customer_id", "txn_date"
ORDER BY "txn_date"
LIMIT 20;
```

```sql
-- 5) Still for customer 1, create a running (cumulative) balance by day
WITH daily AS (
  SELECT "customer_id",
         "txn_date",
         SUM(CASE WHEN "txn_type" = 'deposit' 
                  THEN "txn_amount" 
                  ELSE -1 * "txn_amount" END) AS "daily_net"
  FROM "customer_transactions"
  WHERE "customer_id" = 1
  GROUP BY "customer_id", "txn_date"
)
SELECT "customer_id",
       "txn_date",
       "daily_net",
       SUM("daily_net") OVER (
           PARTITION BY "customer_id"
           ORDER BY "txn_date"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
       ) AS "running_balance"
FROM daily
ORDER BY "txn_date"
LIMIT 20;
```

```sql
-- 6) For that same customer, derive a 30-day rolling average balance  
--    (only shows after 30 days; negatives clipped to 0)
WITH daily AS (
  SELECT "customer_id",
         "txn_date",
         SUM(CASE WHEN "txn_type" = 'deposit' 
                  THEN "txn_amount" 
                  ELSE -1 * "txn_amount" END) AS "daily_net"
  FROM "customer_transactions"
  WHERE "customer_id" = 1
  GROUP BY "customer_id", "txn_date"
),
running AS (
  SELECT "customer_id",
         "txn_date",
         SUM("daily_net") OVER (
           PARTITION BY "customer_id"
           ORDER BY "txn_date"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
         ) AS "running_balance"
  FROM daily
)
SELECT "customer_id",
       "txn_date",
       "running_balance",
       CASE 
         WHEN AVG("running_balance") OVER (
                PARTITION BY "customer_id"
                ORDER BY "txn_date"
                ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
            ) < 0
         THEN 0
         ELSE AVG("running_balance") OVER (
                PARTITION BY "customer_id"
                ORDER BY "txn_date"
                ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
            )
       END AS "avg_30d_balance"
FROM running
ORDER BY "txn_date"
LIMIT 20;
```

```sql
-- 7) Extend to *all* customers: compute each day's 30-day average balance
--    (negatives = 0) and keep the maximum value inside each month
WITH daily AS (
  SELECT "customer_id",
         "txn_date",
         SUM(CASE WHEN "txn_type" = 'deposit' 
                  THEN "txn_amount" 
                  ELSE -1 * "txn_amount" END) AS "daily_net"
  FROM "customer_transactions"
  GROUP BY "customer_id", "txn_date"
),
running AS (
  SELECT "customer_id",
         "txn_date",
         SUM("daily_net") OVER (
           PARTITION BY "customer_id"
           ORDER BY "txn_date"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
         ) AS "running_balance"
  FROM daily
),
avg30 AS (
  SELECT "customer_id",
         "txn_date",
         CASE 
           WHEN AVG("running_balance") OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "txn_date"
                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                ) < 0
           THEN 0
           ELSE AVG("running_balance") OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "txn_date"
                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                )
         END AS "avg_30d_balance"
  FROM running
)
SELECT "customer_id",
       strftime('%Y-%m', "txn_date") AS "month_year",
       MAX("avg_30d_balance") AS "max_30d_balance_in_month"
FROM avg30
GROUP BY "customer_id", "month_year"
ORDER BY "customer_id", "month_year"
LIMIT 20;
```

```sql
-- 8) For every customer, capture the very first month that appears in their history
SELECT DISTINCT "customer_id",
       MIN(strftime('%Y-%m', "txn_date")) AS "baseline_month"
FROM "customer_transactions"
GROUP BY "customer_id"
LIMIT 20;
```

```sql
-- 9) Produce the final result:  
--    • discard each customer’s baseline month  
--    • sum the monthly peak 30-day averages across all customers
WITH daily AS (
  SELECT "customer_id",
         "txn_date",
         SUM(CASE WHEN "txn_type" = 'deposit' 
                  THEN "txn_amount" 
                  ELSE -1 * "txn_amount" END) AS "daily_net"
  FROM "customer_transactions"
  GROUP BY "customer_id", "txn_date"
),
running AS (
  SELECT "customer_id",
         "txn_date",
         SUM("daily_net") OVER (
           PARTITION BY "customer_id"
           ORDER BY "txn_date"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
         ) AS "running_balance"
  FROM daily
),
avg30 AS (
  SELECT "customer_id",
         "txn_date",
         CASE 
           WHEN AVG("running_balance") OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "txn_date"
                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                ) < 0
           THEN 0
           ELSE AVG("running_balance") OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "txn_date"
                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                )
         END AS "avg_30d_balance"
  FROM running
),
month_max AS (
  SELECT "customer_id",
         strftime('%Y-%m', "txn_date") AS "month_year",
         MAX("avg_30d_balance") AS "max_30d_balance_in_month"
  FROM avg30
  GROUP BY "customer_id", "month_year"
),
baseline AS (
  SELECT "customer_id",
         MIN("month_year") AS "baseline_month"
  FROM month_max
  GROUP BY "customer_id"
)
SELECT m."month_year",
       SUM(m."max_30d_balance_in_month") AS "total_peak_30d_balance"
FROM month_max AS m
LEFT JOIN baseline AS b
      ON b."customer_id" = m."customer_id"
     AND b."baseline_month" = m."month_year"
WHERE b."baseline_month" IS NULL        -- removes the baseline month
GROUP BY m."month_year"
ORDER BY m."month_year"
LIMIT 20;
```

