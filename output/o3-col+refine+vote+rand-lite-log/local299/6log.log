Query:
-- 6) For that same customer, derive a 30-day rolling average balance  
--    (only shows after 30 days; negatives clipped to 0)
WITH daily AS (
  SELECT "customer_id",
         "txn_date",
         SUM(CASE WHEN "txn_type" = 'deposit' 
                  THEN "txn_amount" 
                  ELSE -1 * "txn_amount" END) AS "daily_net"
  FROM "customer_transactions"
  WHERE "customer_id" = 1
  GROUP BY "customer_id", "txn_date"
),
running AS (
  SELECT "customer_id",
         "txn_date",
         SUM("daily_net") OVER (
           PARTITION BY "customer_id"
           ORDER BY "txn_date"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
         ) AS "running_balance"
  FROM daily
)
SELECT "customer_id",
       "txn_date",
       "running_balance",
       CASE 
         WHEN AVG("running_balance") OVER (
                PARTITION BY "customer_id"
                ORDER BY "txn_date"
                ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
            ) < 0
         THEN 0
         ELSE AVG("running_balance") OVER (
                PARTITION BY "customer_id"
                ORDER BY "txn_date"
                ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
            )
       END AS "avg_30d_balance"
FROM running
ORDER BY "txn_date"
LIMIT 20;
