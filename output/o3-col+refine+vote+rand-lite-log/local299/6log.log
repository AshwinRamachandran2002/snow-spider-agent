-- 4) For one customer (id = 1), calculate the daily net cash movement  
--    (deposits add, everything else subtracts)
SELECT "customer_id",
       "txn_date",
       SUM(CASE WHEN "txn_type" = 'deposit' 
                THEN "txn_amount" 
                ELSE -1 * "txn_amount" END) AS "daily_net"
FROM "customer_transactions"
WHERE "customer_id" = 1
GROUP BY "customer_id", "txn_date"
ORDER BY "txn_date"
LIMIT 20;
