Query:
--Description: Final answer – sum each month’s customer-level maximum 30-day averages
--             while excluding every customer’s own first (baseline) month.
WITH daily AS (
    SELECT "customer_id",
           DATE("txn_date") AS "txn_date",
           SUM(CASE WHEN "txn_type" = 'deposit'
                    THEN  "txn_amount"
                    ELSE - "txn_amount" END) AS "net_amount"
    FROM   "customer_transactions"
    GROUP  BY "customer_id", DATE("txn_date")
),
balance AS (
    SELECT "customer_id",
           "txn_date",
           SUM("net_amount") OVER (PARTITION BY "customer_id"
                                   ORDER BY "txn_date") AS "daily_balance"
    FROM   daily
),
avg30 AS (
    SELECT "customer_id",
           "txn_date",
           CASE
               WHEN AVG("daily_balance") OVER (
                        PARTITION BY "customer_id"
                        ORDER BY "txn_date"
                        ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                    ) < 0
               THEN 0
               ELSE AVG("daily_balance") OVER (
                        PARTITION BY "customer_id"
                        ORDER BY "txn_date"
                        ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                    )
           END AS "adj_avg_30_balance"
    FROM   balance
),
cust_month_max AS (
    SELECT "customer_id",
           STRFTIME('%Y-%m', "txn_date") AS "month_year",
           MAX("adj_avg_30_balance")     AS "max_30_balance"
    FROM   avg30
    GROUP  BY "customer_id", STRFTIME('%Y-%m', "txn_date")
),
first_month AS (
    SELECT "customer_id",
           SUBSTR(MIN("txn_date"), 1, 7) AS "first_month"
    FROM   "customer_transactions"
    GROUP  BY "customer_id"
)
SELECT c."month_year",
       SUM(c."max_30_balance") AS "total_max_30_balance"
FROM   cust_month_max AS c
JOIN   first_month    AS f
  ON   c."customer_id" = f."customer_id"
WHERE  c."month_year" <> f."first_month"      -- exclude baseline month
GROUP  BY c."month_year"
ORDER  BY c."month_year"
LIMIT 20
