/*-----------------------------------------------------------------------
  Monthly sum of customers’ peak 30-day rolling-average balances
  (negative averages floored to 0 and customers’ first calendar
   month removed from the final totals)
-----------------------------------------------------------------------*/
WITH daily AS (      -- 1. Net cash-flow per customer & day
    SELECT  "customer_id",
            DATE("txn_date")                        AS "txn_date",
            SUM(CASE WHEN "txn_type" = 'deposit'
                     THEN  "txn_amount"
                     ELSE - "txn_amount"
                END)                                AS "net_amount"
    FROM    "customer_transactions"
    GROUP   BY "customer_id",
             DATE("txn_date")
),
balance AS (         -- 2. Cumulative end-of-day balance
    SELECT  "customer_id",
            "txn_date",
            SUM("net_amount") OVER (
                PARTITION BY "customer_id"
                ORDER BY     "txn_date"
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
            ) AS "daily_balance"
    FROM    daily
),
b_ranked AS (        -- 3. Add running row number to know when 30 days exist
    SELECT  *,
            ROW_NUMBER() OVER (
                PARTITION BY "customer_id"
                ORDER BY     "txn_date"
            ) AS rn
    FROM    balance
),
avg30 AS (           -- 4. 30-day rolling average (only after 30 daily rows)
    SELECT  "customer_id",
            "txn_date",
            CASE
                WHEN rn >= 30 THEN                  -- full 30-day history exists
                     CASE
                         WHEN AVG("daily_balance") OVER (
                                  PARTITION BY "customer_id"
                                  ORDER BY     "txn_date"
                                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                              ) < 0
                         THEN 0
                         ELSE AVG("daily_balance") OVER (
                                  PARTITION BY "customer_id"
                                  ORDER BY     "txn_date"
                                  ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                              )
                     END
            END                                   AS "adj_avg_30_balance"
    FROM    b_ranked
),
cust_month_max AS (  -- 5. Customer-level monthly peak of 30-day averages
    SELECT  "customer_id",
            STRFTIME('%Y-%m', "txn_date") AS "month_year",
            MAX("adj_avg_30_balance")     AS "max_30_balance"
    FROM    avg30
    WHERE   "adj_avg_30_balance" IS NOT NULL     -- keep only rows with 30-day avg
    GROUP   BY "customer_id",
             STRFTIME('%Y-%m', "txn_date")
),
first_month AS (     -- 6. Each customer’s very first calendar month
    SELECT  "customer_id",
            SUBSTR(MIN("txn_date"), 1, 7) AS "first_month"
    FROM    "customer_transactions"
    GROUP   BY "customer_id"
)
-- 7. Final answer: sum customers’ monthly peaks, excluding their baseline month
SELECT  c."month_year",
        ROUND(SUM(c."max_30_balance"), 4) AS "total_max_30_balance"
FROM    cust_month_max  AS c
JOIN    first_month     AS f
  ON    c."customer_id" = f."customer_id"
WHERE   c."month_year" <> f."first_month"          -- drop baseline month
GROUP BY c."month_year"
ORDER BY c."month_year";
