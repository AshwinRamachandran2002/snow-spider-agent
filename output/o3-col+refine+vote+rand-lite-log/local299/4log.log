```sql
--Description: End-to-end derivation (thinking process embedded):
--   a)  base_txns   – give every transaction a sign: + for deposit, – otherwise.
--   b)  run_bal     – per customer, cumulative (running) balance by date.
--   c)  roll30      – 30-day rolling average of that balance; negatives become 0.
--   d)  month_max   – for each customer & month, keep the maximum of those 30-day avgs.
--   e)  baseline    – first (earliest) month seen for every customer (baseline).
--   f)  result      – exclude baseline month, then sum customers’ monthly maxima.
WITH
base_txns AS (                       -- a)
    SELECT
        customer_id,
        date(txn_date) AS txn_date,  -- normalise to DATE for SQLite functions
        CASE WHEN txn_type = 'deposit'
             THEN  txn_amount        -- deposits add
             ELSE -txn_amount        -- purchases / withdrawals subtract
        END AS signed_amt
    FROM customer_transactions
),
run_bal AS (                         -- b)
    SELECT
        customer_id,
        txn_date,
        SUM(signed_amt) OVER (
            PARTITION BY customer_id
            ORDER BY     txn_date
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS running_balance
    FROM base_txns
),
roll30 AS (                          -- c)
    SELECT
        customer_id,
        txn_date,
        CASE 
            WHEN AVG(running_balance) OVER (
                     PARTITION BY customer_id
                     ORDER BY     txn_date
                     ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                 ) < 0
            THEN 0                      -- floor negatives to zero
            ELSE AVG(running_balance) OVER (
                     PARTITION BY customer_id
                     ORDER BY     txn_date
                     ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                 )
        END AS avg_30d_nonneg
    FROM run_bal
),
month_max AS (                       -- d)
    SELECT
        customer_id,
        strftime('%Y-%m', txn_date)            AS month,
        MAX(avg_30d_nonneg)                    AS max_30d_avg_in_month
    FROM roll30
    WHERE avg_30d_nonneg IS NOT NULL          -- need full 30-day window
    GROUP BY customer_id, month
),
baseline AS (                        -- e)
    SELECT
        customer_id,
        MIN(strftime('%Y-%m', txn_date)) AS baseline_month
    FROM customer_transactions
    GROUP BY customer_id
)
-- f) final answer
SELECT
    m.month,
    SUM(m.max_30d_avg_in_month) AS sum_max_30d_avg
FROM   month_max  AS m
JOIN   baseline   AS b
  ON   m.customer_id = b.customer_id
 WHERE m.month <> b.baseline_month          -- exclude baseline month
GROUP BY m.month
ORDER  BY m.month;
```
