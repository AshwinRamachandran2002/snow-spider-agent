```sql
--Description: 1.  Inspect the kinds of transaction types recorded in the bank ledger
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
--Description: 2.  Peek at one customer (id = 155) to see the raw sequence of dates and amounts
SELECT "customer_id",
       "txn_date",
       "txn_type",
       "txn_amount"
FROM   "customer_transactions"
WHERE  "customer_id" = 155
ORDER  BY "txn_date"
LIMIT 20;
```

```sql
--Description: 3.  For a single customer, generate a running daily balance (deposit +, everything else –)
SELECT "customer_id",
       "txn_date",
       SUM(CASE WHEN "txn_type" = 'deposit'
                THEN  "txn_amount"
                ELSE - "txn_amount"
           END)
           OVER (PARTITION BY "customer_id"
                 ORDER BY "txn_date"
                 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
FROM   "customer_transactions"
WHERE  "customer_id" = 155
ORDER  BY "txn_date"
LIMIT 20;
```

```sql
--Description: 4.  Compute each customer’s day-by-day running balance (all customers)
SELECT "customer_id",
       "txn_date",
       SUM(CASE WHEN "txn_type" = 'deposit'
                THEN  "txn_amount"
                ELSE - "txn_amount"
           END)
           OVER (PARTITION BY "customer_id"
                 ORDER BY "txn_date"
                 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
FROM   "customer_transactions"
ORDER  BY "customer_id", "txn_date"
LIMIT 20;
```

```sql
--Description: 5.  Using the running balance, calculate a 30-day rolling average balance (window of 30 rows = 30 calendar days)
SELECT "customer_id",
       "txn_date",
       AVG("running_balance")
           OVER (PARTITION BY "customer_id"
                 ORDER BY "txn_date"
                 ROWS BETWEEN 29 PRECEDING AND CURRENT ROW) AS "avg_30d_bal"
FROM (
        SELECT "customer_id",
               "txn_date",
               SUM(CASE WHEN "txn_type" = 'deposit'
                        THEN  "txn_amount"
                        ELSE - "txn_amount"
                   END)
                   OVER (PARTITION BY "customer_id"
                         ORDER BY "txn_date"
                         ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
        FROM   "customer_transactions"
     )
LIMIT 20;
```

```sql
--Description: 6.  Zero-out any negative 30-day averages
SELECT "customer_id",
       "txn_date",
       CASE WHEN "avg_30d_bal" < 0 THEN 0 ELSE "avg_30d_bal" END AS "avg_30d_nonneg"
FROM (
        SELECT "customer_id",
               "txn_date",
               AVG("running_balance")
                   OVER (PARTITION BY "customer_id"
                         ORDER BY "txn_date"
                         ROWS BETWEEN 29 PRECEDING AND CURRENT ROW) AS "avg_30d_bal"
        FROM (
              SELECT "customer_id",
                     "txn_date",
                     SUM(CASE WHEN "txn_type" = 'deposit'
                              THEN  "txn_amount"
                              ELSE - "txn_amount"
                         END)
                         OVER (PARTITION BY "customer_id"
                               ORDER BY "txn_date"
                               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
              FROM   "customer_transactions"
             )
     )
WHERE  "avg_30d_bal" IS NOT NULL       -- ensures at least 30 rows exist
LIMIT 20;
```

```sql
--Description: 7.  For every customer & calendar month, grab the maximum 30-day non-negative average balance
SELECT  "customer_id",
        strftime('%Y-%m', "txn_date") AS "yyyy_mm",
        MAX("avg_30d_nonneg")         AS "max_30d_avg_in_month"
FROM (
        SELECT "customer_id",
               "txn_date",
               CASE WHEN "avg_30d_bal" < 0 THEN 0 ELSE "avg_30d_bal" END AS "avg_30d_nonneg"
        FROM (
                SELECT "customer_id",
                       "txn_date",
                       AVG("running_balance")
                           OVER (PARTITION BY "customer_id"
                                 ORDER BY "txn_date"
                                 ROWS BETWEEN 29 PRECEDING AND CURRENT ROW) AS "avg_30d_bal"
                FROM (
                      SELECT "customer_id",
                             "txn_date",
                             SUM(CASE WHEN "txn_type" = 'deposit'
                                      THEN  "txn_amount"
                                      ELSE - "txn_amount"
                                 END)
                                 OVER (PARTITION BY "customer_id"
                                       ORDER BY "txn_date"
                                       ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
                      FROM   "customer_transactions"
                     )
             )
        WHERE "avg_30d_bal" IS NOT NULL
     )
GROUP  BY "customer_id", strftime('%Y-%m', "txn_date")
LIMIT 20;
```

```sql
--Description: 8.  Identify each customer’s very first transaction month (the baseline period)
SELECT "customer_id",
       MIN(strftime('%Y-%m', "txn_date")) AS "baseline_month"
FROM   "customer_transactions"
GROUP  BY "customer_id"
LIMIT 20;
```

```sql
--Description: 9.  Exclude the baseline month then sum monthly maxima over all customers
SELECT  t."yyyy_mm"                               AS "month",
        SUM(t."max_30d_avg_in_month")             AS "sum_max_30d_avg"
FROM   (
          -- reuse query (7)
          SELECT  m."customer_id",
                  m."yyyy_mm",
                  m."max_30d_avg_in_month"
          FROM   (
                    SELECT  "customer_id",
                            strftime('%Y-%m', "txn_date") AS "yyyy_mm",
                            MAX("avg_30d_nonneg")          AS "max_30d_avg_in_month"
                    FROM (
                            SELECT "customer_id",
                                   "txn_date",
                                   CASE WHEN "avg_30d_bal" < 0 THEN 0 ELSE "avg_30d_bal" END AS "avg_30d_nonneg"
                            FROM (
                                    SELECT "customer_id",
                                           "txn_date",
                                           AVG("running_balance")
                                               OVER (PARTITION BY "customer_id"
                                                     ORDER BY "txn_date"
                                                     ROWS BETWEEN 29 PRECEDING AND CURRENT ROW) AS "avg_30d_bal"
                                    FROM (
                                          SELECT "customer_id",
                                                 "txn_date",
                                                 SUM(CASE WHEN "txn_type" = 'deposit'
                                                          THEN  "txn_amount"
                                                          ELSE - "txn_amount"
                                                     END)
                                                     OVER (PARTITION BY "customer_id"
                                                           ORDER BY "txn_date"
                                                           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
                                          FROM   "customer_transactions"
                                         )
                                 )
                            WHERE "avg_30d_bal" IS NOT NULL
                         )
                    GROUP  BY "customer_id", "yyyy_mm"
                  ) AS m
          JOIN   (
                    SELECT "customer_id",
                           MIN(strftime('%Y-%m', "txn_date")) AS "baseline_month"
                    FROM   "customer_transactions"
                    GROUP  BY "customer_id"
                  ) AS b
          ON     m."customer_id" = b."customer_id"
          WHERE  m."yyyy_mm" <> b."baseline_month"          -- exclude baseline
       ) AS t
GROUP BY t."yyyy_mm"
LIMIT 20;
```

```sql
--Description: 10.  Quick look at the final month-level totals (already shown above but in isolation)
SELECT *
FROM (
        SELECT  t."yyyy_mm"  AS "month",
                SUM(t."max_30d_avg_in_month") AS "sum_max_30d_avg"
        FROM   (...)    -- same sub-query as step 9
        GROUP  BY t."yyyy_mm"
     )
ORDER BY "month"
LIMIT 20;
```
