```sql
--Description: 10) Sum, by calendar month, all customers’ maximum 30-day averages
--               while excluding each customer’s baseline month
WITH first_mth AS (
  SELECT  "customer_id",
          MIN(strftime('%Y-%m', "txn_date")) AS "first_month"
  FROM    "customer_transactions"
  GROUP  BY "customer_id"),
cust_monthly_peak AS (
  /* query from step 8 */
  SELECT  "customer_id",
          strftime('%Y-%m', "dte")      AS "month",
          MAX("non_neg_avg_30d_bal")    AS "max_30d_avg_in_month"
  FROM    (
    /* same non-negative 30-day average CTE chain as earlier */ )
  GROUP BY "customer_id", strftime('%Y-%m', "dte"))
SELECT  "month",
        SUM("max_30d_avg_in_month") AS "sum_of_monthly_customer_maxes"
FROM    cust_monthly_peak
WHERE   ("customer_id", "month") NOT IN (
        SELECT "customer_id", "first_month" FROM first_mth)
GROUP  BY "month"
ORDER  BY "month"
LIMIT 20;
```
