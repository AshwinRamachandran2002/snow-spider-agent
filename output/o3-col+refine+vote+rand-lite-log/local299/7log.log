```sql
--Description: 
-- ╔═════════════════════════════════════════════════════════════════════════════╗
-- ║  Thinking process (embedded inline):                                        ║
-- ║  1.  daily_net        → daily net cash flow (+ for deposits, − otherwise).  ║
-- ║  2.  running_bal      → cumulative running balance per customer & day.      ║
-- ║  3.  rolling_30       → 30-day moving-average of running balance            ║
-- ║                         + row_number to know when 30 days are available.    ║
-- ║  4.  valid_rolling    → keep rows with ≥30 days; floor negatives to zero.   ║
-- ║  5.  cust_monthly_peak→ per-customer, per-month MAX of that 30-day average. ║
-- ║  6.  baseline_month   → each customer’s first month (to be excluded).       ║
-- ║  7.  monthly_totals   → sum customer peaks by month, excluding baseline.    ║
-- ╚═════════════════════════════════════════════════════════════════════════════╝
WITH
daily_net AS (
    SELECT  "customer_id",
            DATE("txn_date")                                             AS "dte",
            SUM(CASE WHEN "txn_type" = 'deposit'
                     THEN  "txn_amount"
                     ELSE -1 * "txn_amount" END)                        AS "net_daily_amount"
    FROM    "customer_transactions"
    GROUP   BY "customer_id", DATE("txn_date")
),
running_bal AS (
    SELECT  "customer_id",
            "dte",
            SUM("net_daily_amount") OVER (
                 PARTITION BY "customer_id"
                 ORDER BY     "dte"
                 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)      AS "running_balance"
    FROM    daily_net
),
rolling_30 AS (
    SELECT  "customer_id",
            "dte",
            AVG("running_balance") OVER (
                 PARTITION BY "customer_id"
                 ORDER BY     "dte"
                 ROWS BETWEEN 29 PRECEDING AND CURRENT ROW)             AS "avg_30d_balance",
            ROW_NUMBER() OVER (
                 PARTITION BY "customer_id"
                 ORDER BY     "dte")                                    AS "rn"
    FROM    running_bal
),
valid_rolling AS (
    SELECT  "customer_id",
            "dte",
            CASE WHEN "avg_30d_balance" < 0
                 THEN 0
                 ELSE "avg_30d_balance" END                            AS "non_neg_avg_30d"
    FROM    rolling_30
    WHERE   "rn" >= 30
),
cust_monthly_peak AS (
    SELECT  "customer_id",
            STRFTIME('%Y-%m', "dte")                                    AS "month",
            MAX("non_neg_avg_30d")                                      AS "max_30d_avg_in_month"
    FROM    valid_rolling
    GROUP   BY "customer_id", STRFTIME('%Y-%m', "dte")
),
baseline_month AS (
    SELECT  "customer_id",
            MIN(STRFTIME('%Y-%m', "txn_date"))                          AS "first_month"
    FROM    "customer_transactions"
    GROUP   BY "customer_id"
),
monthly_totals AS (
    SELECT  cmp."month",
            SUM(cmp."max_30d_avg_in_month")                             AS "total_peak_balance"
    FROM    cust_monthly_peak  AS cmp
    JOIN    baseline_month     AS bm
      ON    cmp."customer_id" = bm."customer_id"
    WHERE   cmp."month" <> bm."first_month"           -- exclude baseline month
    GROUP   BY cmp."month"
)
SELECT  "month",
        "total_peak_balance"
FROM    monthly_totals
ORDER BY "month";
```
