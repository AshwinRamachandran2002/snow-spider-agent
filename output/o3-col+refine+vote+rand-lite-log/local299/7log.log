```sql
--Description: 4) Aggregate each customer’s daily net cash movement
SELECT "customer_id",
       "txn_date",
       SUM(CASE WHEN "txn_type" = 'deposit' THEN  "txn_amount"
                ELSE                       -1 * "txn_amount" END) AS "net_daily_amount"
FROM   "customer_transactions"
GROUP  BY "customer_id", "txn_date"
ORDER  BY "customer_id", "txn_date"
LIMIT 20;
```

```sql
--Description: 5) Calculate the running balance for every customer (using the net daily totals)
WITH daily_movements AS (
  SELECT "customer_id",
         date("txn_date")                         AS "dte",
         SUM(CASE WHEN "txn_type" = 'deposit'
                  THEN  "txn_amount"
                  ELSE -1 * "txn_amount" END)     AS "net_daily_amount"
  FROM   "customer_transactions"
  GROUP  BY "customer_id", date("txn_date"))
SELECT "customer_id",
       "dte",
       SUM("net_daily_amount") OVER (
           PARTITION BY "customer_id"
           ORDER BY     "dte"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
FROM   daily_movements
ORDER  BY "customer_id", "dte"
LIMIT 20;
```

```sql
--Description: 6) Produce each customer’s 30-day rolling average balance (only after 30 days)
WITH daily_bal AS (
  /* reuse running balance from the previous step */
  SELECT "customer_id",
         "dte",
         SUM("net_daily_amount") OVER (
             PARTITION BY "customer_id"
             ORDER BY     "dte"
             ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
  FROM (
    SELECT "customer_id",
           date("txn_date")                         AS "dte",
           SUM(CASE WHEN "txn_type" = 'deposit'
                    THEN  "txn_amount"
                    ELSE -1 * "txn_amount" END)     AS "net_daily_amount"
    FROM   "customer_transactions"
    GROUP  BY "customer_id", date("txn_date")))
SELECT "customer_id",
       "dte",
       AVG("running_balance") OVER (
           PARTITION BY "customer_id"
           ORDER BY     "dte"
           ROWS BETWEEN 29 PRECEDING AND CURRENT ROW) AS "avg_30d_balance"
FROM   daily_bal
WHERE  ROW_NUMBER() OVER (
           PARTITION BY "customer_id"
           ORDER BY     "dte") >= 30
ORDER  BY "customer_id", "dte"
LIMIT 20;
```

```sql
--Description: 7) Treat negative 30-day averages as zero
WITH avg30 AS (
  /* query from step 6 */
  SELECT "customer_id",
         "dte",
         CASE WHEN "avg_30d_balance" < 0
              THEN 0
              ELSE "avg_30d_balance" END AS "non_neg_avg_30d_bal"
  FROM (
    WITH daily_bal AS (
      SELECT "customer_id",
             "dte",
             SUM("net_daily_amount") OVER (
                 PARTITION BY "customer_id"
                 ORDER BY     "dte"
                 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
      FROM (
        SELECT "customer_id",
               date("txn_date")                         AS "dte",
               SUM(CASE WHEN "txn_type" = 'deposit'
                        THEN  "txn_amount"
                        ELSE -1 * "txn_amount" END)     AS "net_daily_amount"
        FROM   "customer_transactions"
        GROUP  BY "customer_id", date("txn_date")))
    SELECT "customer_id",
           "dte",
           AVG("running_balance") OVER (
               PARTITION BY "customer_id"
               ORDER BY     "dte"
               ROWS BETWEEN 29 PRECEDING AND CURRENT ROW) AS "avg_30d_balance"
    FROM   daily_bal
    WHERE  ROW_NUMBER() OVER (
               PARTITION BY "customer_id"
               ORDER BY     "dte") >= 30 ))
SELECT *
FROM   avg30
LIMIT 20;
```

```sql
--Description: 8) For every month, capture each customer’s maximum 30-day average balance
WITH non_neg AS (
  /* re-use step 7 */
  SELECT "customer_id",
         "dte",
         "non_neg_avg_30d_bal"
  FROM (
    /* (identical inner work as step 7, trimmed here for brevity) */
    SELECT *
    FROM   avg30)
)
SELECT  "customer_id",
        strftime('%Y-%m', "dte")      AS "month",
        MAX("non_neg_avg_30d_bal")    AS "max_30d_avg_in_month"
FROM    non_neg
GROUP BY "customer_id", strftime('%Y-%m', "dte")
ORDER  BY "customer_id", "month"
LIMIT 20;
```

