--Description: 7) Re-compute each customer’s 30-day rolling-average balance and
--              immediately floor any negative values to zero (no ≥30-day filter)
WITH daily_net AS (
    SELECT  "customer_id",
            DATE("txn_date")                                            AS "dte",
            SUM(CASE WHEN "txn_type" = 'deposit'
                     THEN  "txn_amount"
                     ELSE -1 * "txn_amount" END)                       AS "net_amt"
    FROM    "customer_transactions"
    GROUP   BY "customer_id", DATE("txn_date")
),
running_bal AS (
    SELECT  "customer_id",
            "dte",
            SUM("net_amt") OVER (
                    PARTITION BY "customer_id"
                    ORDER BY     "dte"
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)  AS "running_balance"
    FROM    daily_net
),
rolling_30 AS (
    SELECT  "customer_id",
            "dte",
            AVG("running_balance") OVER (
                    PARTITION BY "customer_id"
                    ORDER BY     "dte"
                    ROWS BETWEEN 29 PRECEDING AND CURRENT ROW)         AS "avg_30d"
    FROM    running_bal
)
SELECT  "customer_id",
        "dte",
        CASE WHEN "avg_30d" < 0 THEN 0 ELSE "avg_30d" END              AS "non_neg_avg_30d_bal"
FROM    rolling_30
ORDER BY "customer_id", "dte"
LIMIT 20
