```sql
/* ------------------------------------------------------------
   1)  Build a daily running balance for every customer
   2)  Compute a 30-day rolling average of that balance
   3)  Floor any negative averages to zero
   4)  Per (customer, month) keep the maximum 30-day average
   5)  Sum those maxima by month, excluding each customer’s
       own first calendar month of activity
------------------------------------------------------------- */

WITH daily_net AS (               -- net $ movement per customer per calendar day
    SELECT  "customer_id",
            DATE("txn_date")                                            AS "dte",
            SUM(CASE WHEN "txn_type" = 'deposit'
                     THEN  "txn_amount"
                     ELSE -1 * "txn_amount" END)                       AS "net_amt"
    FROM    "customer_transactions"
    GROUP   BY "customer_id", DATE("txn_date")
),

running_bal AS (                  -- cumulative running balance
    SELECT  "customer_id",
            "dte",
            SUM("net_amt") OVER (
                    PARTITION BY "customer_id"
                    ORDER BY     "dte"
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)  AS "running_balance"
    FROM    daily_net
),

rolling_30 AS (                   -- 30-day rolling average balance
    SELECT  rb."customer_id",
            rb."dte",
            AVG(rb."running_balance") OVER (
                    PARTITION BY rb."customer_id"
                    ORDER BY     rb."dte"
                    RANGE BETWEEN 29 DAY PRECEDING AND CURRENT ROW)    AS "avg_30d"
    FROM    running_bal AS rb
),

first_txn_date AS (               -- earliest transaction date for each customer
    SELECT  "customer_id",
            MIN(DATE("txn_date")) AS "first_dte"
    FROM    "customer_transactions"
    GROUP   BY "customer_id"
),

valid_rolling AS (                -- only retain rows once 30 calendar days have elapsed
    SELECT  r."customer_id",
            r."dte",
            CASE WHEN r."avg_30d" < 0 THEN 0 ELSE r."avg_30d" END       AS "clean_avg_30d"
    FROM    rolling_30  AS r
    JOIN    first_txn_date AS f
           ON r."customer_id" = f."customer_id"
    WHERE   JULIANDAY(r."dte") - JULIANDAY(f."first_dte") >= 29         -- full 30-day window
),

cust_monthly_peak AS (            -- each customer’s peak 30-day avg per month
    SELECT  "customer_id",
            STRFTIME('%Y-%m', "dte")                                    AS "month",
            MAX("clean_avg_30d")                                        AS "max_30d_avg_in_month"
    FROM    valid_rolling
    GROUP   BY "customer_id", STRFTIME('%Y-%m', "dte")
),

baseline_month AS (               -- every customer’s first calendar month
    SELECT  "customer_id",
            MIN(STRFTIME('%Y-%m', "txn_date")) AS "first_month"
    FROM    "customer_transactions"
    GROUP   BY "customer_id"
)

SELECT  cmp."month",
        ROUND(SUM(cmp."max_30d_avg_in_month"), 4) AS "sum_of_monthly_customer_maxes"
FROM    cust_monthly_peak AS cmp
JOIN    baseline_month    AS bm
      ON cmp."customer_id" = bm."customer_id"
WHERE   cmp."month" <> bm."first_month"            -- exclude baseline month
GROUP  BY cmp."month"
ORDER  BY cmp."month";
