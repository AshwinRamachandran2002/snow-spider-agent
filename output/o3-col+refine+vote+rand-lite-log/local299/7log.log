WITH daily_net AS (           -- 1) net movement per customer per calendar day
    SELECT  "customer_id",
            DATE("txn_date")                                            AS "dte",
            SUM(CASE WHEN "txn_type" = 'deposit'
                     THEN  "txn_amount"
                     ELSE -1 * "txn_amount" END)                       AS "net_amt"
    FROM    "customer_transactions"
    GROUP   BY "customer_id", DATE("txn_date")
),

running_bal AS (              -- 2) cumulative running balance
    SELECT  "customer_id",
            "dte",
            SUM("net_amt") OVER (
                    PARTITION BY "customer_id"
                    ORDER BY     "dte"
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)  AS "running_balance"
    FROM    daily_net
),

rolling_30 AS (               -- 3) 30-day rolling statistics
    SELECT  "customer_id",
            "dte",
            COUNT(*) OVER (                                             -- days inside the frame
                    PARTITION BY "customer_id"
                    ORDER BY     "dte"
                    ROWS BETWEEN 29 PRECEDING AND CURRENT ROW)          AS "cnt_30d",
            AVG("running_balance") OVER (                               -- 30-day avg balance
                    PARTITION BY "customer_id"
                    ORDER BY     "dte"
                    ROWS BETWEEN 29 PRECEDING AND CURRENT ROW)          AS "avg_30d"
    FROM    running_bal
),

valid_rolling AS (            -- 4) keep only FULL 30-day windows, floor negatives to zero
    SELECT  "customer_id",
            "dte",
            CASE WHEN "avg_30d" < 0 THEN 0 ELSE "avg_30d" END           AS "clean_avg_30d"
    FROM    rolling_30
    WHERE   "cnt_30d" = 30                                             -- ensure 30 days of data
),

cust_monthly_peak AS (        -- 5) each customer’s monthly peak 30-day average
    SELECT  "customer_id",
            STRFTIME('%Y-%m', "dte")                                    AS "month",
            MAX("clean_avg_30d")                                        AS "max_30d_avg_in_month"
    FROM    valid_rolling
    GROUP   BY "customer_id", STRFTIME('%Y-%m', "dte")
),

baseline_month AS (           -- 6) identify every customer’s first transaction month
    SELECT  "customer_id",
            MIN(STRFTIME('%Y-%m', "txn_date")) AS "first_month"
    FROM    "customer_transactions"
    GROUP   BY "customer_id"
)

-- 7) sum the monthly customer maxima, excluding each customer’s baseline month
SELECT  cmp."month",
        ROUND(SUM(cmp."max_30d_avg_in_month"), 4) AS "sum_of_monthly_customer_maxes"
FROM    cust_monthly_peak AS cmp
JOIN    baseline_month    AS bm
      ON cmp."customer_id" = bm."customer_id"
WHERE   cmp."month" <> bm."first_month"            -- exclude baseline period
GROUP  BY cmp."month"
ORDER  BY cmp."month";
```
