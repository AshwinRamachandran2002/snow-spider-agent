```sql
--Description: 
-- Objective: see a customer’s running balance and its rolling-average trend in one shot,
--            but without requiring a full 30-day history (demo data is short).
-- Logical flow (each step is a CTE):
--   1. daily_net   → daily net cash (+deposit, –withdrawal/purchase).
--   2. running_bal → cumulative balance per customer.
--   3. rolling_30  → 30-day rolling average of that balance
--                    (SQLite will average however many rows exist).
--                    Negative averages are floored to zero so we never report < 0.
-- The final SELECT returns, for every customer-date pair, both the running balance
-- and its (non-negative) 30-day rolling average, letting us verify calculations
-- even when < 30 days of data are available.
WITH daily_net AS (
    SELECT  "customer_id",
            DATE("txn_date")                                            AS "dte",
            SUM(CASE WHEN "txn_type" = 'deposit'
                     THEN  "txn_amount"
                     ELSE -1 * "txn_amount" END)                       AS "net_amt"
    FROM    "customer_transactions"
    GROUP   BY "customer_id", DATE("txn_date")
),
running_bal AS (
    SELECT  "customer_id",
            "dte",
            SUM("net_amt") OVER (
                    PARTITION BY "customer_id"
                    ORDER BY     "dte"
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)  AS "running_balance"
    FROM    daily_net
),
rolling_30 AS (
    SELECT  "customer_id",
            "dte",
            "running_balance",
            /* 30-day window; SQLite will use whatever rows exist */
            AVG("running_balance") OVER (
                    PARTITION BY "customer_id"
                    ORDER BY     "dte"
                    ROWS BETWEEN 29 PRECEDING AND CURRENT ROW)         AS "raw_avg30"
    FROM    running_bal
)
SELECT  "customer_id",
        "dte",
        "running_balance",
        CASE WHEN "raw_avg30" < 0 THEN 0 ELSE "raw_avg30" END          AS "avg_30d_balance"
FROM    rolling_30
ORDER BY "customer_id", "dte"
LIMIT 20;
```
