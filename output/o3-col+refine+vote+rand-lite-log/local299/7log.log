--Description: 5) Calculate the running balance for every customer (using the net daily totals)
WITH daily_movements AS (
  SELECT "customer_id",
         date("txn_date")                         AS "dte",
         SUM(CASE WHEN "txn_type" = 'deposit'
                  THEN  "txn_amount"
                  ELSE -1 * "txn_amount" END)     AS "net_daily_amount"
  FROM   "customer_transactions"
  GROUP  BY "customer_id", date("txn_date"))
SELECT "customer_id",
       "dte",
       SUM("net_daily_amount") OVER (
           PARTITION BY "customer_id"
           ORDER BY     "dte"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
FROM   daily_movements
ORDER  BY "customer_id", "dte"
LIMIT 20;
