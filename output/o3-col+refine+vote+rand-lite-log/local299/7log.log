--Description: 8) For every month, capture each customer’s maximum non-negative
--              30-day average balance (using the query from step 7)
WITH daily_net AS (
    SELECT  "customer_id",
            DATE("txn_date")                                            AS "dte",
            SUM(CASE WHEN "txn_type" = 'deposit'
                     THEN  "txn_amount"
                     ELSE -1 * "txn_amount" END)                       AS "net_amt"
    FROM    "customer_transactions"
    GROUP   BY "customer_id", DATE("txn_date")
),
running_bal AS (
    SELECT  "customer_id",
            "dte",
            SUM("net_amt") OVER (
                    PARTITION BY "customer_id"
                    ORDER BY     "dte"
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)  AS "running_balance"
    FROM    daily_net
),
rolling_30 AS (
    SELECT  "customer_id",
            "dte",
            AVG("running_balance") OVER (
                    PARTITION BY "customer_id"
                    ORDER BY     "dte"
                    ROWS BETWEEN 29 PRECEDING AND CURRENT ROW)         AS "avg_30d"
    FROM    running_bal
),
non_neg AS (
    SELECT  "customer_id",
            "dte",
            CASE WHEN "avg_30d" < 0 THEN 0 ELSE "avg_30d" END          AS "non_neg_avg_30d_bal"
    FROM    rolling_30
)
SELECT  "customer_id",
        STRFTIME('%Y-%m', "dte")                                       AS "month",
        MAX("non_neg_avg_30d_bal")                                     AS "max_30d_avg_in_month"
FROM    non_neg
GROUP  BY "customer_id", STRFTIME('%Y-%m', "dte")
ORDER BY "customer_id", "month"
LIMIT 20;
