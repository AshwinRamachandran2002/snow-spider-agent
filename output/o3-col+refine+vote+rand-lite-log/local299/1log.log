```sql
--Description: Build everything in a single statement—
--  • daily_net   : net cash movement per customer-day (+deposit, –otherwise)  
--  • running_bal : cumulative running balance per customer  
--  • avg30       : 30-day rolling average of that balance (negatives forced to 0)  
--  • final rows  : add calendar year/month tags so the result can be aggregated later
WITH daily_net AS (
    SELECT
        customer_id,
        txn_date,
        SUM(
            CASE 
                WHEN txn_type = 'deposit' THEN txn_amount      -- inflow
                ELSE                -txn_amount                -- outflow
            END
        ) AS daily_net_amt
    FROM customer_transactions
    GROUP BY customer_id, txn_date
),
running_bal AS (
    SELECT
        customer_id,
        txn_date,
        SUM(daily_net_amt) OVER (
            PARTITION BY customer_id
            ORDER BY     txn_date
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS running_balance
    FROM daily_net
),
avg30 AS (
    SELECT
        rb.customer_id,
        rb.txn_date,
        -- average balance over the trailing 30-day window; floor at zero
        MAX(0, (
            SELECT AVG(running_balance)
            FROM   running_bal
            WHERE  customer_id = rb.customer_id
              AND  txn_date    BETWEEN date(rb.txn_date,'-29 day') AND rb.txn_date
        )) AS avg_bal_30d
    FROM running_bal rb
)
SELECT
    customer_id,
    strftime('%Y', txn_date) AS cal_year,
    strftime('%m', txn_date) AS cal_month,
    avg_bal_30d
FROM avg30
WHERE avg_bal_30d IS NOT NULL          -- in case first 29 days lacked data
LIMIT 20;
```
