```sql
--Description: Compute each customer’s maximum 30-day average balance within every calendar month
WITH
daily_net AS (
  SELECT customer_id,
         txn_date,
         SUM(CASE WHEN txn_type='deposit' THEN txn_amount
                  ELSE -txn_amount END) AS daily_net_amt
  FROM customer_transactions
  GROUP BY customer_id, txn_date
),
running_bal AS (
  SELECT customer_id,
         txn_date,
         SUM(daily_net_amt) OVER (
           PARTITION BY customer_id
           ORDER BY     txn_date
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
         ) AS running_balance
  FROM daily_net
),
avg30 AS (
  SELECT rb.customer_id,
         rb.txn_date,
         MAX(0, (        /* 30-day rolling average, negatives floored to 0 */
           SELECT AVG(running_balance)
           FROM   running_bal
           WHERE  customer_id = rb.customer_id
             AND  txn_date   BETWEEN date(rb.txn_date,'-29 day') AND rb.txn_date
         )) AS avg_bal_30d
  FROM running_bal rb
),
month_avgs AS (
  SELECT customer_id,
         strftime('%Y', txn_date) AS cal_year,
         strftime('%m', txn_date) AS cal_month,
         avg_bal_30d
  FROM   avg30
  WHERE  avg_bal_30d IS NOT NULL
)
SELECT customer_id,
       cal_year,
       cal_month,
       MAX(avg_bal_30d) AS max_avg_bal_in_month
FROM   month_avgs
GROUP  BY customer_id, cal_year, cal_month
LIMIT 20;
```

```sql
--Description: Identify the first calendar month that each customer appears in (baseline month)
SELECT
  customer_id,
  MIN(strftime('%Y-%m', txn_date)) AS first_month
FROM customer_transactions
GROUP BY customer_id
LIMIT 20;
```

```sql
--Description: Sum the per-customer monthly maxima after removing each customer’s baseline month
WITH
/* ------- monthly maximum per customer (query 7) ------- */
monthly_max AS (
  WITH daily_net AS (
        SELECT customer_id,
               txn_date,
               SUM(CASE WHEN txn_type='deposit' THEN txn_amount
                        ELSE -txn_amount END) AS daily_net_amt
        FROM customer_transactions
        GROUP BY customer_id, txn_date
  ),
  running_bal AS (
        SELECT customer_id,
               txn_date,
               SUM(daily_net_amt) OVER (
                   PARTITION BY customer_id
                   ORDER BY     txn_date
                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
               ) AS running_balance
        FROM daily_net
  ),
  avg30 AS (
        SELECT rb.customer_id,
               rb.txn_date,
               MAX(0,(
                     SELECT AVG(running_balance)
                     FROM   running_bal
                     WHERE  customer_id = rb.customer_id
                       AND  txn_date  BETWEEN date(rb.txn_date,'-29 day') AND rb.txn_date
               )) AS avg_bal_30d
        FROM running_bal rb
  ),
  month_avgs AS (
        SELECT customer_id,
               strftime('%Y', txn_date) AS cal_year,
               strftime('%m', txn_date) AS cal_month,
               avg_bal_30d
        FROM   avg30
        WHERE  avg_bal_30d IS NOT NULL
  )
  SELECT customer_id,
         cal_year,
         cal_month,
         MAX(avg_bal_30d) AS max_avg_bal_in_month
  FROM   month_avgs
  GROUP  BY customer_id, cal_year, cal_month
),
/* ------- first month per customer (query 8) ------- */
first_month AS (
  SELECT customer_id,
         MIN(strftime('%Y-%m', txn_date)) AS first_month
  FROM   customer_transactions
  GROUP  BY customer_id
)
/* ------- aggregate after baseline removal ------- */
SELECT
  mm.cal_year,
  mm.cal_month,
  SUM(mm.max_avg_bal_in_month) AS sum_of_max_30d_avgs
FROM   monthly_max AS mm
LEFT   JOIN first_month AS fm
       ON  mm.customer_id = fm.customer_id
       AND (mm.cal_year || '-' || mm.cal_month) = fm.first_month
WHERE  fm.first_month IS NULL          -- exclude baseline month rows
GROUP  BY mm.cal_year, mm.cal_month
ORDER  BY mm.cal_year, mm.cal_month
LIMIT 20;
```

