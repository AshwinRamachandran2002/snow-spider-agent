```sql
-- Description: Sum of each customer’s monthly maxima across all customers, minus their personal baseline month  
SELECT DISTINCT
       s."cal_year",
       s."cal_month",
       SUM(s."max_avg_bal_in_month") AS "sum_of_max_30d_avgs"
FROM (
        /* join monthly maxima with baseline list and remove baseline month */
        SELECT mm.*
        FROM   ( /* query 7 result */ ) AS mm
        LEFT  JOIN ( /* query 8 result */ ) AS base
               ON  mm."customer_id" = base."customer_id"
               AND (mm."cal_year" || '-' || mm."cal_month") = base."first_month"
        WHERE  base."first_month" IS NULL      -- keeps only non-baseline months
     ) AS s
GROUP BY s."cal_year",
         s."cal_month"
ORDER BY s."cal_year",
         s."cal_month"
LIMIT 20;
```

