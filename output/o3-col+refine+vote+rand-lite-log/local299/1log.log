```sql
-- Description: Daily net movement ( deposit = +, anything else = – ) for every customer  
SELECT DISTINCT
       ct."customer_id",
       ct."txn_date",
       SUM(CASE WHEN ct."txn_type" = 'deposit' 
                THEN ct."txn_amount" 
                ELSE -ct."txn_amount" 
           END) AS "daily_net_amt"
FROM   "customer_transactions" AS ct
GROUP  BY ct."customer_id",
          ct."txn_date"
LIMIT 20;
```

```sql
-- Description: Customer-level running balance (cumulative sum of the daily net)  
SELECT DISTINCT
       rb."customer_id",
       rb."txn_date",
       SUM(rb."daily_net_amt") OVER (
            PARTITION BY rb."customer_id"
            ORDER BY     rb."txn_date"
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
       ) AS "running_balance"
FROM (
        SELECT ct."customer_id",
               ct."txn_date",
               SUM(CASE WHEN ct."txn_type" = 'deposit' 
                        THEN ct."txn_amount" 
                        ELSE -ct."txn_amount" 
                   END) AS "daily_net_amt"
        FROM   "customer_transactions" AS ct
        GROUP  BY ct."customer_id",
                  ct."txn_date"
     ) AS rb
LIMIT 20;
```

```sql
-- Description: 30-day rolling average of running balance  
-- (only rows with at least 30 days of data will have non-NULL averages)  
SELECT DISTINCT
       b."customer_id",
       b."txn_date",
       CASE
            WHEN avg30 < 0 THEN 0
            ELSE avg30
       END AS "avg_bal_30d"
FROM (
        SELECT r1."customer_id",
               r1."txn_date",
               ( SELECT AVG(r2."running_balance")
                 FROM   (
                           SELECT DISTINCT
                                  rI."customer_id",
                                  rI."txn_date",
                                  SUM(rI."daily_net_amt") OVER (
                                      PARTITION BY rI."customer_id"
                                      ORDER BY     rI."txn_date"
                                      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
                                  ) AS "running_balance"
                           FROM   (
                                    SELECT ct."customer_id",
                                           ct."txn_date",
                                           SUM(CASE WHEN ct."txn_type" = 'deposit' 
                                                    THEN ct."txn_amount" 
                                                    ELSE -ct."txn_amount" 
                                               END) AS "daily_net_amt"
                                    FROM   "customer_transactions" AS ct
                                    GROUP  BY ct."customer_id",
                                              ct."txn_date"
                                  ) AS rI
                        ) AS r2
                 WHERE  r2."customer_id" = r1."customer_id"
                   AND  r2."txn_date" BETWEEN date(r1."txn_date",'-29 day') AND r1."txn_date"
               ) AS avg30
        FROM (
                SELECT DISTINCT
                       ct."customer_id",
                       ct."txn_date"
                FROM   "customer_transactions" AS ct
             ) AS r1
     ) AS b
LIMIT 20;
```

