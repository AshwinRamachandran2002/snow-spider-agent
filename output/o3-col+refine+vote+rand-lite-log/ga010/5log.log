--Description:  Show 20 sample (source, medium) pairs that belong to the Channel Group
--              ranking 4-th for December-2020 sessions.  
--              a) Build one row per GA4 session (ga_session_id).  
--              b) Classify each session into a Channel Group.  
--              c) Rank Channel Groups by session volume and keep the one whose rank = 4.  
--              d) Return distinct source/medium combos from that Channel.  
WITH events AS (                               -- pull session_id / source / medium from every Dec event
  SELECT
    (SELECT CAST(ep.value.int_value AS STRING)
       FROM UNNEST(event_params) ep
       WHERE ep.key = 'ga_session_id'
       LIMIT 1) AS session_id,
    (SELECT ep.value.string_value
       FROM UNNEST(event_params) ep
       WHERE ep.key = 'source'
       LIMIT 1) AS source,
    (SELECT ep.value.string_value
       FROM UNNEST(event_params) ep
       WHERE ep.key = 'medium'
       LIMIT 1) AS medium
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
),
session_level AS (                             -- deduplicate ⇒ one row per session
  SELECT
    session_id,
    ANY_VALUE(source) AS source,
    ANY_VALUE(medium) AS medium
  FROM events
  WHERE session_id IS NOT NULL
  GROUP BY session_id
),
classified AS (                                -- map sessions to Channel Group
  SELECT
    source,
    medium,
