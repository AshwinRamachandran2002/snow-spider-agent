```sql
--Description: Work out which Channel Group ranks 4-th for total sessions in December-2020.  
-- 1) events: pull ga_session_id, source, and medium from *every* December event row.  
-- 2) session_level: collapse to one record per unique session (ga_session_id).  
-- 3) channel_counts: map each session to a broad Channel Group and count them.  
-- 4) ranked: order those counts by size and select the 4-th row (rn = 4).  
WITH events AS (
  SELECT
    (SELECT CAST(ep.value.int_value AS STRING)
       FROM UNNEST(event_params) ep
       WHERE ep.key = 'ga_session_id'
       LIMIT 1) AS session_id,
    (SELECT ep.value.string_value
       FROM UNNEST(event_params) ep
       WHERE ep.key = 'source'
       LIMIT 1) AS source,
    (SELECT ep.value.string_value
       FROM UNNEST(event_params) ep
       WHERE ep.key = 'medium'
       LIMIT 1) AS medium
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
),
session_level AS (
  SELECT
    session_id,
    ANY_VALUE(source) AS source,
    ANY_VALUE(medium) AS medium
  FROM events
  WHERE session_id IS NOT NULL
  GROUP BY session_id
),
channel_counts AS (
  SELECT
    CASE
      WHEN LOWER(COALESCE(source,'')) = '(direct)' AND medium IN ('(not set)', '(none)', '') THEN 'Direct'
      WHEN medium = 'referral'                                                             THEN 'Referral'
      WHEN medium = 'organic'                                                              THEN 'Organic Search'
      WHEN medium IN ('cpc','ppc')                                                         THEN 'Paid Search'
      WHEN medium IN ('display','banner','cpm')                                            THEN 'Display'
      ELSE 'Other'
    END AS channel_group,
    COUNT(*) AS sessions
  FROM session_level
  GROUP BY channel_group
),
ranked AS (
  SELECT
    channel_group,
    sessions,
    ROW_NUMBER() OVER (ORDER BY sessions DESC) AS rn
  FROM channel_counts
)
SELECT channel_group, sessions
FROM ranked
WHERE rn = 4;
