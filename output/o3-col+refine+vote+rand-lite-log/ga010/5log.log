    MAX(CASE WHEN ep.key='medium' THEN ep.value.string_value END) AS medium
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(event_params) AS ep
  WHERE event_name = 'session_start'
  GROUP BY user_pseudo_id, event_timestamp
),
channel_sessions AS (
  SELECT
    CASE
      WHEN LOWER(source) = '(direct)' AND medium IN ('(not set)', '(none)')          THEN 'Direct'
      WHEN medium = 'referral'                                                      THEN 'Referral'
      WHEN medium = 'organic'                                                       THEN 'Organic Search'
      WHEN medium IN ('display','banner','expandable','interstitial','cpm')         THEN 'Display'
      ELSE 'Unassigned'
    END AS channel_group,
    COUNT(*) AS sessions
  FROM base
  GROUP BY channel_group
  ORDER BY sessions DESC
)
SELECT *
FROM channel_sessions
ORDER BY sessions DESC
OFFSET 3   -- skip the top 3
LIMIT 1;
