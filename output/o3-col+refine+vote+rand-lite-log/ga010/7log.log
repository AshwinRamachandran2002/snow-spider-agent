--Description / Thinking process:
-- Goal: identify the channel that ranks 4-th by session count for December-2020.
-- Approach:
--   • Use GA4 “session_start” rows → each row = one session.
--   • Stitch December tables via wildcard and _TABLE_SUFFIX filter.
--   • Derive a simple Channel grouping via CASE on traffic_source.source / medium.
--   • Aggregate to count sessions per channel.
--   • RANK() channels by session volume (descending).
--   • QUALIFY keeps only rank = 4 (the requested channel).

SELECT
  channel,
  COUNT(*) AS sessions
FROM (
  -- Map every session_start row to a channel
  SELECT
    CASE
      WHEN LOWER(traffic_source.source) = '(direct)'
           AND LOWER(traffic_source.medium) IN ('(not set)', '(none)')
        THEN 'Direct'
      WHEN LOWER(traffic_source.medium) = 'affiliate'
        THEN 'Affiliates'
      WHEN LOWER(traffic_source.medium) = 'referral'
        THEN 'Referral'
      WHEN LOWER(traffic_source.medium) IN ('display','banner','expandable',
                                            'interstitial','cpm')
        THEN 'Display'
      WHEN LOWER(traffic_source.medium) LIKE '%email%'
        OR LOWER(traffic_source.source) LIKE '%email%'
        THEN 'Email'
      WHEN LOWER(traffic_source.medium) = 'organic'
        OR LOWER(traffic_source.source) IN ('google','bing','yahoo','baidu',
                                            'duckduckgo','yandex','ecosia')
        THEN 'Organic Search'
      ELSE 'Other'
    END AS channel
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'   -- December only
    AND event_name = 'session_start'                      -- sessions only
)
GROUP BY channel
QUALIFY RANK() OVER (ORDER BY COUNT(*) DESC) = 4;          -- keep 4-th place
