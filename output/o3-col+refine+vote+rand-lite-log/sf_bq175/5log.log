--Description: Rank cytobands on chr1 for TCGA-KICH by frequency of heterozygous deletions (copy_number = 1)
WITH cnt AS (
  SELECT c."cytoband_name",
         COUNT(*) AS "het_del_count"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON g."chromosome" = c."chromosome"
   AND g."start_pos" < c."hg38_stop"
   AND g."end_pos"   > c."hg38_start"
  WHERE g."project_short_name" = 'TCGA-KICH'
    AND g."chromosome" = 'chr1'
    AND g."copy_number" = 1
  GROUP BY c."cytoband_name"
)
SELECT "cytoband_name",
       "het_del_count",
       RANK() OVER (ORDER BY "het_del_count" DESC) AS "het_del_rank"
FROM cnt
ORDER BY "het_del_rank"
LIMIT 20
