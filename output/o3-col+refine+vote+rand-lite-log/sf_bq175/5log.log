--Description: 5)  Classify each CNV on chr1 into common biological categories for TCGA-KICH
SELECT c."cytoband_name",
       CASE 
         WHEN g."copy_number" >= 4 THEN 'Amplification'
         WHEN g."copy_number"  = 3 THEN 'Gain'
         WHEN g."copy_number"  = 1 THEN 'Heterozygous Deletion'
         WHEN g."copy_number"  = 0 THEN 'Homozygous Deletion'
         ELSE                         'Normal Diploid'
       END AS "cnv_class"
