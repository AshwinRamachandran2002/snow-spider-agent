```sql
--Description: 1)  List all available TCGA projects in the gene-level CN table  
SELECT DISTINCT "project_short_name"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36
LIMIT 20;
```

```sql
--Description: 2)  Get a rough idea of the data volume for kidney cancer (TCGA-KIRC)  
SELECT COUNT(*) AS "total_records"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36
WHERE "project_short_name" = 'TCGA-KIRC'
LIMIT 20;
```

```sql
--Description: 3)  Preview TCGA-KIRC gene-level rows on chromosome 1  
SELECT "project_short_name",
       "chromosome",
       "start_pos",
       "end_pos",
       "copy_number"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36
WHERE "project_short_name" = 'TCGA-KIRC'
  AND "chromosome" = 'chr1'
LIMIT 20;
```

```sql
--Description: 4)  Map TCGA-KIRC chr1 CNVs to cytoband intervals (any overlap)  
SELECT g."project_short_name",
       g."chromosome",
       c."cytoband_name",
       g."start_pos",
       g."end_pos",
       g."copy_number"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
  ON g."chromosome" = c."chromosome"
 AND g."start_pos" < c."hg38_stop"
 AND g."end_pos"   > c."hg38_start"
WHERE g."project_short_name" = 'TCGA-KIRC'
  AND g."chromosome" = 'chr1'
LIMIT 20;
```

```sql
--Description: 5)  Classify each CNV on chr1 into common biological categories  
SELECT c."cytoband_name",
       CASE 
         WHEN g."copy_number" >= 4 THEN 'Amplification'
         WHEN g."copy_number"  = 3 THEN 'Gain'
         WHEN g."copy_number"  = 1 THEN 'Heterozygous Deletion'
         WHEN g."copy_number"  = 0 THEN 'Homozygous Deletion'
         ELSE                         'Normal Diploid'
       END AS "cnv_class"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
  ON g."chromosome" = c."chromosome"
 AND g."start_pos" < c."hg38_stop"
 AND g."end_pos"   > c."hg38_start"
WHERE g."project_short_name" = 'TCGA-KIRC'
  AND g."chromosome" = 'chr1'
LIMIT 20;
```

```sql
--Description: 6)  Count events per cytoband for the three focal CNV classes  
SELECT c."cytoband_name",
       CASE 
         WHEN g."copy_number" >= 4 THEN 'Amplification'
         WHEN g."copy_number"  = 3 THEN 'Gain'
         WHEN g."copy_number"  = 1 THEN 'Heterozygous Deletion'
       END                                AS "cnv_class",
       COUNT(*)                           AS "event_count"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
  ON g."chromosome" = c."chromosome"
 AND g."start_pos" < c."hg38_stop"
 AND g."end_pos"   > c."hg38_start"
WHERE g."project_short_name" = 'TCGA-KIRC'
  AND g."chromosome" = 'chr1'
  AND g."copy_number" IN (1,3,4,5,6,7,8,9,10)
GROUP BY c."cytoband_name", "cnv_class"
LIMIT 20;
```

```sql
--Description: 7)  Rank cytobands by Amplification frequency (top 20 shown)  
WITH cnt AS (
  SELECT c."cytoband_name",
         COUNT(*) AS "amp_count"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON g."chromosome" = c."chromosome"
   AND g."start_pos" < c."hg38_stop"
   AND g."end_pos"   > c."hg38_start"
  WHERE g."project_short_name" = 'TCGA-KIRC'
    AND g."chromosome" = 'chr1'
    AND g."copy_number" >= 4
  GROUP BY c."cytoband_name"
)
SELECT "cytoband_name",
       "amp_count",
       RANK() OVER (ORDER BY "amp_count" DESC) AS "amp_rank"
FROM cnt
ORDER BY "amp_rank"
LIMIT 20;
```

```sql
--Description: 8)  Rank cytobands by Gain frequency (top 20 shown)  
WITH cnt AS (
  SELECT c."cytoband_name",
         COUNT(*) AS "gain_count"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON g."chromosome" = c."chromosome"
   AND g."start_pos" < c."hg38_stop"
   AND g."end_pos"   > c."hg38_start"
  WHERE g."project_short_name" = 'TCGA-KIRC'
    AND g."chromosome" = 'chr1'
    AND g."copy_number" = 3
  GROUP BY c."cytoband_name"
)
SELECT "cytoband_name",
       "gain_count",
       RANK() OVER (ORDER BY "gain_count" DESC) AS "gain_rank"
FROM cnt
ORDER BY "gain_rank"
LIMIT 20;
```

```sql
--Description: 9)  Rank cytobands by Heterozygous Deletion frequency (top 20 shown)  
WITH cnt AS (
  SELECT c."cytoband_name",
         COUNT(*) AS "het_del_count"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON g."chromosome" = c."chromosome"
   AND g."start_pos" < c."hg38_stop"
   AND g."end_pos"   > c."hg38_start"
  WHERE g."project_short_name" = 'TCGA-KIRC'
    AND g."chromosome" = 'chr1'
    AND g."copy_number" = 1
  GROUP BY c."cytoband_name"
)
SELECT "cytoband_name",
       "het_del_count",
       RANK() OVER (ORDER BY "het_del_count" DESC) AS "het_del_rank"
FROM cnt
ORDER BY "het_del_rank"
LIMIT 20;
```

```sql
--Description: 10)  Cytobands on chr1 where Amplification, Gain, AND Heterozygous Deletion each rank in the top 11  
WITH amp AS (
  SELECT c."cytoband_name",
         RANK() OVER (ORDER BY COUNT(*) DESC) AS "amp_rank"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON g."chromosome" = c."chromosome"
   AND g."start_pos" < c."hg38_stop"
   AND g."end_pos"   > c."hg38_start"
  WHERE g."project_short_name" = 'TCGA-KIRC'
    AND g."chromosome" = 'chr1'
    AND g."copy_number" >= 4
  GROUP BY c."cytoband_name"
),
gain AS (
  SELECT c."cytoband_name",
         RANK() OVER (ORDER BY COUNT(*) DESC) AS "gain_rank"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON g."chromosome" = c."chromosome"
   AND g."start_pos" < c."hg38_stop"
   AND g."end_pos"   > c."hg38_start"
  WHERE g."project_short_name" = 'TCGA-KIRC'
    AND g."chromosome" = 'chr1'
    AND g."copy_number" = 3
  GROUP BY c."cytoband_name"
),
het_del AS (
  SELECT c."cytoband_name",
         RANK() OVER (ORDER BY COUNT(*) DESC) AS "het_del_rank"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON g."chromosome" = c."chromosome"
   AND g."start_pos" < c."hg38_stop"
   AND g."end_pos"   > c."hg38_start"
  WHERE g."project_short_name" = 'TCGA-KIRC'
    AND g."chromosome" = 'chr1'
    AND g."copy_number" = 1
  GROUP BY c."cytoband_name"
)
SELECT a."cytoband_name",
       a."amp_rank",
       g."gain_rank",
       h."het_del_rank"
FROM amp    a
JOIN gain   g ON a."cytoband_name" = g."cytoband_name"
JOIN het_del h ON a."cytoband_name" = h."cytoband_name"
WHERE a."amp_rank" <= 11
  AND g."gain_rank" <= 11
  AND h."het_del_rank" <= 11
ORDER BY a."amp_rank", g."gain_rank", h."het_del_rank"
LIMIT 20;
```
