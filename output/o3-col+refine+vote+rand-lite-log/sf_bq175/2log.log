```sql
-- Description: 7)  Rank cytobands by amplification frequency (top-20 preview)
WITH amp AS (
  SELECT 
    b."cytoband_name",
    COUNT(*) AS "amp_freq"
  FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"  a
  JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"                                   b
    ON a."chromosome"      = b."chromosome"
   AND a."start_pos"       <= b."hg38_stop"
   AND a."end_pos"         >= b."hg38_start"
  WHERE a."chromosome" = 'chr1'
    AND a."copy_number" >= 4
  GROUP BY b."cytoband_name"
)
SELECT 
  "cytoband_name",
  "amp_freq",
  RANK() OVER (ORDER BY "amp_freq" DESC) AS "amp_rank"
FROM amp
ORDER BY "amp_rank"
LIMIT 20;
```

