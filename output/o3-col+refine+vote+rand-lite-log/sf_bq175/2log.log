```sql
-- Description: 10)  Cytobands whose amplification, gain AND heterozygous-deletion ranks are each ≤11
WITH amp AS (
  SELECT 
    b."cytoband_name",
    RANK() OVER (ORDER BY COUNT(*) DESC) AS "amp_rank"
  FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" a
  JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" b
    ON a."chromosome"      = b."chromosome"
   AND a."start_pos"       <= b."hg38_stop"
   AND a."end_pos"         >= b."hg38_start"
  WHERE a."chromosome" = 'chr1'
    AND a."copy_number" >= 4
  GROUP BY b."cytoband_name"
),
gain AS (
  SELECT 
    b."cytoband_name",
    RANK() OVER (ORDER BY COUNT(*) DESC) AS "gain_rank"
  FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" a
  JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" b
    ON a."chromosome"      = b."chromosome"
   AND a."start_pos"       <= b."hg38_stop"
   AND a."end_pos"         >= b."hg38_start"
  WHERE a."chromosome" = 'chr1'
    AND a."copy_number" = 3
  GROUP BY b."cytoband_name"
),
hetdel AS (
  SELECT 
    b."cytoband_name",
    RANK() OVER (ORDER BY COUNT(*) DESC) AS "hetdel_rank"
  FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" a
  JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" b
    ON a."chromosome"      = b."chromosome"
   AND a."start_pos"       <= b."hg38_stop"
   AND a."end_pos"         >= b."hg38_start"
  WHERE a."chromosome" = 'chr1'
    AND a."copy_number" = 1
  GROUP BY b."cytoband_name"
)
SELECT 
  a."cytoband_name",
  a."amp_rank",
  g."gain_rank",
  h."hetdel_rank"
FROM amp   a
JOIN gain  g ON a."cytoband_name" = g."cytoband_name"
JOIN hetdel h ON a."cytoband_name" = h."cytoband_name"
WHERE a."amp_rank"  <= 11
  AND g."gain_rank" <= 11
  AND h."hetdel_rank" <= 11
ORDER BY a."amp_rank"
LIMIT 20;
```
