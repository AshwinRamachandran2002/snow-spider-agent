/*  Cytobands on chromosome-1 in TCGA-KIRC whose
    amplification, gain and heterozygous-deletion
    frequencies are all ranked within the top 11          */

WITH kirc_gene AS (   -- gene-level CNVs for kidney cancer (TCGA-KIRC)
    SELECT
