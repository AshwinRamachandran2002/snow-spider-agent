WITH events AS (           -- map KIRC gene-level CNV rows to cytobands on chr1
    SELECT
        cb."cytoband_name",
        CASE
            WHEN gl."max_copy_number" >= 4 THEN 'Amplification'
            WHEN gl."max_copy_number"  = 3 THEN 'Gain'
            WHEN gl."max_copy_number"  = 1 THEN 'Heterozygous Deletion'
        END                                              AS "category"
    FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36"   gl
    JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38"                                 cb
         ON  cb."chromosome" = gl."chromosome"
         AND GREATEST(gl."start_pos", cb."hg38_start")
             <= LEAST(gl."end_pos",   cb."hg38_stop")   -- interval overlap
    WHERE gl."project_short_name" = 'TCGA-KIRC'         -- kidney-cancer cohort
      AND gl."chromosome"        = 'chr1'               -- chromosome 1 only
      AND gl."max_copy_number"    IN (1,3,4,5,6,7,8,9)  -- keep relevant CNV rows
      AND cb."cytoband_name" IS NOT NULL
), ranked AS (          -- count & rank cytobands within each CNV category
    SELECT
        "cytoband_name",
        "category",
        COUNT(*)                                           AS "event_cnt",
        RANK()  OVER (PARTITION BY "category"
                      ORDER BY COUNT(*) DESC NULLS LAST)   AS "rnk"
    FROM events
    GROUP BY "cytoband_name", "category"
)
SELECT
    "cytoband_name"
FROM ranked
WHERE "rnk" <= 11                         -- top-11 per category
GROUP BY "cytoband_name"
HAVING COUNT(DISTINCT "category") = 3     -- appears in all three categories
ORDER BY "cytoband_name";
```
