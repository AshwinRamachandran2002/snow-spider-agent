--Description: ⑥  Rank cytobands by Amplification frequency (top 11 on chr1)  
WITH base AS (   
    SELECT 
        c."cytoband_name",
        COUNT(*) AS "amp_cnt"
    FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
    JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38"                                  c
