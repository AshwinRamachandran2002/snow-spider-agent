--Description: ⑨  Combine the three top-11 lists to see which cytobands are top-ranked in ALL categories  
WITH amp AS (  -- top-11 amplifications  
    SELECT "cytoband_name"
    FROM (  
        SELECT 
            c."cytoband_name",
            COUNT(*) AS cnt,
            RANK() OVER (ORDER BY COUNT(*) DESC) AS rnk
        FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
        JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" c
             ON c."chromosome" = s."chromosome"
            AND GREATEST(s."start_pos", c."hg38_start") <= LEAST(s."end_pos", c."hg38_stop")
        WHERE s."chromosome" = 'chr1'
          AND s."copy_number" >= 4
        GROUP BY c."cytoband_name"
    ) t   
    WHERE rnk <= 11
),  
gain AS (  -- top-11 gains  
    SELECT "cytoband_name"
    FROM (  
        SELECT 
            c."cytoband_name",
            COUNT(*) AS cnt,
            RANK() OVER (ORDER BY COUNT(*) DESC) AS rnk
        FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
        JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" c
             ON c."chromosome" = s."chromosome"
            AND GREATEST(s."start_pos", c."hg38_start") <= LEAST(s."end_pos", c."hg38_stop")
        WHERE s."chromosome" = 'chr1'
          AND s."copy_number" = 3
        GROUP BY c."cytoband_name"
    ) t  
    WHERE rnk <= 11
),  
het AS (  -- top-11 heterozygous deletions  
    SELECT "cytoband_name"
    FROM (  
        SELECT 
            c."cytoband_name",
            COUNT(*) AS cnt,
            RANK() OVER (ORDER BY COUNT(*) DESC) AS rnk
        FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
        JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" c
             ON c."chromosome" = s."chromosome"
            AND GREATEST(s."start_pos", c."hg38_start") <= LEAST(s."end_pos", c."hg38_stop")
        WHERE s."chromosome" = 'chr1'
          AND s."copy_number" = 1
        GROUP BY c."cytoband_name"
    ) t  
    WHERE rnk <= 11
)  
SELECT DISTINCT 
    a."cytoband_name"
FROM amp  a
JOIN gain g ON a."cytoband_name" = g."cytoband_name"
JOIN het  h ON a."cytoband_name" = h."cytoband_name"
ORDER BY a."cytoband_name"
LIMIT 20;
