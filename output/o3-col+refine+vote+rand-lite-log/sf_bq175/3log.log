--Description:  One-shot query (with inline comments = thinking process) that finds
--              chromosome-1 cytobands whose segment counts rank in the TOP-11 for
--              all three CNV classes — Amplification (>3 copies), Gain (=3 copies),
--              and HeterozygousDeletion (=1 copy) — in the allelic-segment table.
WITH per_band AS (                       /* STEP-1:  count segments per cytoband & CNV class */
    SELECT  c."cytoband_name",
            CASE
                 WHEN s."copy_number" > 3 THEN 'Amplification'
                 WHEN s."copy_number" = 3 THEN 'Gain'
                 WHEN s."copy_number" = 1 THEN 'HeterozygousDeletion'
            END                                   AS "cnv_class",
            COUNT(*)                              AS "class_count"
    FROM   TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"  s
    JOIN   TCGA_MITELMAN.PROD."CYTOBANDS_HG38"                                       c
           ON s."chromosome" = c."chromosome"
          AND s."start_pos" <= c."hg38_stop"
          AND s."end_pos"   >= c."hg38_start"
    WHERE  s."chromosome"  = 'chr1'              -- focus on chromosome-1
      AND  s."copy_number" IN (1,3,4,5,6)        -- only classes we care about
    GROUP BY c."cytoband_name", "cnv_class"
),
ranked AS (                            /* STEP-2: rank counts inside each CNV class, keep TOP-11 */
    SELECT  p.*,
            RANK() OVER (PARTITION BY p."cnv_class"
                         ORDER BY p."class_count" DESC) AS "class_rank"
    FROM    per_band p
    QUALIFY "class_rank" <= 11
),
common AS (                            /* STEP-3: cytobands that survive in *all* three classes */
    SELECT  "cytoband_name"
    FROM    ranked
    GROUP BY "cytoband_name"
    HAVING  COUNT(*) = 3               -- must have a row for Amp, Gain, Het-Del
)
SELECT  r."cytoband_name",
        MAX(CASE WHEN r."cnv_class" = 'Amplification'        THEN r."class_count" END) AS "amplification_segments",
        MAX(CASE WHEN r."cnv_class" = 'Gain'                 THEN r."class_count" END) AS "gain_segments",
        MAX(CASE WHEN r."cnv_class" = 'HeterozygousDeletion' THEN r."class_count" END) AS "het_del_segments"
FROM    ranked r
JOIN    common c
       ON r."cytoband_name" = c."cytoband_name"
GROUP BY r."cytoband_name";
