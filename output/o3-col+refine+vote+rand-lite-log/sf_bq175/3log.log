```

```sql
--Description: 2)  Look at the first 20 segments on chromosome 1 to see copy-number values and coordinates
SELECT  s."chromosome",
        s."start_pos",
        s."end_pos",
        s."copy_number"
FROM    TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
WHERE   s."chromosome" = 'chr1'
LIMIT 20;
```

```sql
--Description: 3)  Simple distribution of copy-number states on chromosome 1
SELECT  s."copy_number",
        COUNT(*) AS "segment_count"
FROM    TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
WHERE   s."chromosome" = 'chr1'
GROUP BY s."copy_number"
ORDER BY "segment_count" DESC
LIMIT 20;
```

```sql
--Description: 4)  List all cytobands located on chromosome 1 (hg38 coordinates)
SELECT  c."chromosome",
        c."cytoband_name",
        c."hg38_start",
        c."hg38_stop"
FROM    TCGA_MITELMAN.PROD."CYTOBANDS_HG38" c
WHERE   c."chromosome" = 'chr1'
ORDER BY c."hg38_start"
LIMIT 20;
```

```sql
--Description: 5)  Sample of segment-to-cytoband overlaps on chromosome 1
SELECT  s."chromosome",
        s."start_pos",
        s."end_pos",
        s."copy_number",
        c."cytoband_name"
FROM    TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
JOIN    TCGA_MITELMAN.PROD."CYTOBANDS_HG38" c
        ON s."chromosome"  = c."chromosome"
       AND s."start_pos"  <= c."hg38_stop"
       AND s."end_pos"    >= c."hg38_start"
WHERE   s."chromosome" = 'chr1'
LIMIT 20;
```

```sql
--Description: 6)  Classify each overlapping segment into Amplification, Gain, HeterozygousDeletion categories
SELECT  c."cytoband_name",
        CASE 
             WHEN s."copy_number" > 3 THEN 'Amplification'
             WHEN s."copy_number" = 3 THEN 'Gain'
             WHEN s."copy_number" = 1 THEN 'HeterozygousDeletion'
        END AS "cnv_class",
        COUNT(*) AS "class_count"
FROM    TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
JOIN    TCGA_MITELMAN.PROD."CYTOBANDS_HG38" c
        ON s."chromosome"  = c."chromosome"
       AND s."start_pos"  <= c."hg38_stop"
       AND s."end_pos"    >= c."hg38_start"
WHERE   s."chromosome" = 'chr1'
  AND   s."copy_number" IN (1,3,4,5,6)   -- keep values needed for classes
GROUP BY c."cytoband_name",
         "cnv_class"
LIMIT 20;
```

```sql
--Description: 7)  Rank cytobands by frequency *within* each CNV class (top 11 focus)
SELECT  c."cytoband_name",
        CASE 
             WHEN s."copy_number" > 3 THEN 'Amplification'
             WHEN s."copy_number" = 3 THEN 'Gain'
             WHEN s."copy_number" = 1 THEN 'HeterozygousDeletion'
        END AS "cnv_class",
        COUNT(*)                                    AS "class_count",
        RANK() OVER (PARTITION BY 
                     CASE 
                          WHEN s."copy_number" > 3 THEN 'Amplification'
                          WHEN s."copy_number" = 3 THEN 'Gain'
                          WHEN s."copy_number" = 1 THEN 'HeterozygousDeletion'
                     END 
                     ORDER BY COUNT(*) DESC)        AS "class_rank"
FROM    TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
JOIN    TCGA_MITELMAN.PROD."CYTOBANDS_HG38" c
        ON s."chromosome"  = c."chromosome"
       AND s."start_pos"  <= c."hg38_stop"
       AND s."end_pos"    >= c."hg38_start"
WHERE   s."chromosome" = 'chr1'
  AND   s."copy_number" IN (1,3,4,5,6)
GROUP BY c."cytoband_name",
         "cnv_class"
LIMIT 20;
```

```sql
--Description: 8)  Retrieve cytobands that rank within the top-11 for EACH class
WITH ranked AS (
    SELECT  c."cytoband_name",
            CASE 
                 WHEN s."copy_number" > 3 THEN 'Amplification'
                 WHEN s."copy_number" = 3 THEN 'Gain'
                 WHEN s."copy_number" = 1 THEN 'HeterozygousDeletion'
            END AS "cnv_class",
            COUNT(*)                           AS "class_count",
            RANK() OVER (PARTITION BY 
                         CASE 
                              WHEN s."copy_number" > 3 THEN 'Amplification'
                              WHEN s."copy_number" = 3 THEN 'Gain'
                              WHEN s."copy_number" = 1 THEN 'HeterozygousDeletion'
                         END 
                         ORDER BY COUNT(*) DESC) AS "class_rank"
    FROM    TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
    JOIN    TCGA_MITELMAN.PROD."CYTOBANDS_HG38" c
            ON s."chromosome"  = c."chromosome"
           AND s."start_pos"  <= c."hg38_stop"
           AND s."end_pos"    >= c."hg38_start"
    WHERE   s."chromosome" = 'chr1'
      AND   s."copy_number" IN (1,3,4,5,6)
    GROUP BY c."cytoband_name",
             "cnv_class"
)
SELECT  "cytoband_name",
        LISTAGG("cnv_class", ', ') AS "classes_in_top11"
FROM    ranked
WHERE   "class_rank" <= 11
GROUP BY "cytoband_name"
HAVING  COUNT(*) = 3          -- must appear in all 3 classes
LIMIT 20;
```

```sql
--Description: 9)  Show detailed ranking numbers for cytobands that satisfy the previous filter
WITH ranked AS (
    SELECT  c."cytoband_name",
            CASE 
                 WHEN s."copy_number" > 3 THEN 'Amplification'
                 WHEN s."copy_number" = 3 THEN 'Gain'
                 WHEN s."copy_number" = 1 THEN 'HeterozygousDeletion'
            END AS "cnv_class",
            COUNT(*)                           AS "class_count",
            RANK() OVER (PARTITION BY 
                         CASE 
                              WHEN s."copy_number" > 3 THEN 'Amplification'
                              WHEN s."copy_number" = 3 THEN 'Gain'
                              WHEN s."copy_number" = 1 THEN 'HeterozygousDeletion'
                         END 
                         ORDER BY COUNT(*) DESC) AS "class_rank"
    FROM    TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
    JOIN    TCGA_MITELMAN.PROD."CYTOBANDS_HG38" c
            ON s."chromosome"  = c."chromosome"
           AND s."start_pos"  <= c."hg38_stop"
           AND s."end_pos"    >= c."hg38_start"
    WHERE   s."chromosome" = 'chr1'
      AND   s."copy_number" IN (1,3,4,5,6)
    GROUP BY c."cytoband_name",
             "cnv_class"
)
SELECT  *
FROM    ranked
WHERE   "cytoband_name" IN (
        SELECT  "cytoband_name"
        FROM    ranked
        WHERE   "class_rank" <= 11
        GROUP BY "cytoband_name"
        HAVING  COUNT(*) = 3
)
ORDER BY "cytoband_name",
         "cnv_class"
LIMIT 20;
```

```sql
--Description: 10)  Condensed summary of cytobands fulfilling all three top-11 criteria with their max counts
WITH ranked AS (
    SELECT  c."cytoband_name",
            CASE 
                 WHEN s."copy_number" > 3 THEN 'Amplification'
                 WHEN s."copy_number" = 3 THEN 'Gain'
                 WHEN s."copy_number" = 1 THEN 'HeterozygousDeletion'
            END AS "cnv_class",
            COUNT(*)                           AS "class_count",
            RANK() OVER (PARTITION BY 
                         CASE 
                              WHEN s."copy_number" > 3 THEN 'Amplification'
                              WHEN s."copy_number" = 3 THEN 'Gain'
                              WHEN s."copy_number" = 1 THEN 'HeterozygousDeletion'
                         END 
                         ORDER BY COUNT(*) DESC) AS "class_rank"
    FROM    TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
    JOIN    TCGA_MITELMAN.PROD."CYTOBANDS_HG38" c
            ON s."chromosome"  = c."chromosome"
           AND s."start_pos"  <= c."hg38_stop"
           AND s."end_pos"    >= c."hg38_start"
    WHERE   s."chromosome" = 'chr1'
      AND   s."copy_number" IN (1,3,4,5,6)
    GROUP BY c."cytoband_name",
             "cnv_class"
    HAVING  RANK() OVER (PARTITION BY 
                         CASE 
                              WHEN s."copy_number" > 3 THEN 'Amplification'
                              WHEN s."copy_number" = 3 THEN 'Gain'
                              WHEN s."copy_number" = 1 THEN 'HeterozygousDeletion'
                         END 
                         ORDER BY COUNT(*) DESC) <= 11
)
SELECT  "cytoband_name",
        MAX(CASE WHEN "cnv_class" = 'Amplification'        THEN "class_count" END) AS "amplification_segments",
        MAX(CASE WHEN "cnv_class" = 'Gain'                 THEN "class_count" END) AS "gain_segments",
        MAX(CASE WHEN "cnv_class" = 'HeterozygousDeletion' THEN "class_count" END) AS "het_del_segments"
FROM    ranked
GROUP BY "cytoband_name"
LIMIT 20;
```
