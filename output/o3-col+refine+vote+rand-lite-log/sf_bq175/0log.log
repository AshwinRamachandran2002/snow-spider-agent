```sql
--Description: Examine the reference cytoband definitions for chromosome 1
SELECT 
  "chromosome",
  "cytoband_name",
  "hg38_start",
  "hg38_stop"
FROM TCGA_MITELMAN.PROD."CYTOBANDS_HG38"
WHERE "chromosome" = 'chr1'
ORDER BY "hg38_start"
LIMIT 20;
```

```sql
--Description: Join chr1 segments to chr1 cytobands to locate the primary cytoband overlapped by each segment
SELECT 
  s."start_pos",
  s."end_pos",
  c."cytoband_name",
  s."copy_number",
  CASE 
    WHEN s."copy_number" > 3 THEN 'Amplification'
    WHEN s."copy_number" = 3 THEN 'Gain'
    WHEN s."copy_number" = 1 THEN 'Heterozygous Deletion'
  END AS "cnv_class"
FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" AS s
JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38"                    AS c
  ON c."chromosome" = 'chr1'
 AND c."chromosome" = s."chromosome"
 AND LEAST(s."end_pos", c."hg38_stop") 
     > GREATEST(s."start_pos", c."hg38_start")          -- ensures an overlap
WHERE s."chromosome" = 'chr1'
  AND s."copy_number" IN (1,3,4,5,6)                    -- speed filter for key CNV categories
LIMIT 20;
```

```sql
--Description: Count, per cytoband, how many Amplifications, Gains, and Het Dels occur on chr1
SELECT
  c."cytoband_name",
  SUM( CASE WHEN s."copy_number" > 3 THEN 1 ELSE 0 END ) AS "amp_cnt",
  SUM( CASE WHEN s."copy_number" = 3 THEN 1 ELSE 0 END ) AS "gain_cnt",
  SUM( CASE WHEN s."copy_number" = 1 THEN 1 ELSE 0 END ) AS "hetdel_cnt"
FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" AS s
JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38"                    AS c
  ON c."chromosome" = 'chr1'
 AND c."chromosome" = s."chromosome"
 AND LEAST(s."end_pos", c."hg38_stop") 
     > GREATEST(s."start_pos", c."hg38_start")
WHERE s."chromosome" = 'chr1'
GROUP BY c."cytoband_name"
ORDER BY "amp_cnt" DESC
LIMIT 20;
```

```sql
--Description: Rank each cytoband for Amplification, Gain, and Het Del frequencies separately
WITH per_cytoband AS (
  SELECT
    c."cytoband_name",
    SUM( CASE WHEN s."copy_number" > 3 THEN 1 ELSE 0 END ) AS "amp_cnt",
    SUM( CASE WHEN s."copy_number" = 3 THEN 1 ELSE 0 END ) AS "gain_cnt",
    SUM( CASE WHEN s."copy_number" = 1 THEN 1 ELSE 0 END ) AS "hetdel_cnt"
  FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" AS s
  JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" AS c
    ON c."chromosome" = 'chr1'
   AND c."chromosome" = s."chromosome"
   AND LEAST(s."end_pos", c."hg38_stop") 
       > GREATEST(s."start_pos", c."hg38_start")
  WHERE s."chromosome" = 'chr1'
  GROUP BY c."cytoband_name"
)
SELECT
  "cytoband_name",
  "amp_cnt",
  "gain_cnt",
  "hetdel_cnt",
  RANK() OVER (ORDER BY "amp_cnt"  DESC) AS "amp_rank",
  RANK() OVER (ORDER BY "gain_cnt" DESC) AS "gain_rank",
  RANK() OVER (ORDER BY "hetdel_cnt" DESC) AS "hetdel_rank"
FROM per_cytoband
LIMIT 20;
```

```sql
--Description: Retrieve only those cytobands whose Amplification, Gain, and Het Del ranks are all ≤ 11 (top 11 of each category)
WITH per_cytoband AS (
  SELECT
    c."cytoband_name",
    SUM( CASE WHEN s."copy_number" > 3 THEN 1 ELSE 0 END ) AS "amp_cnt",
    SUM( CASE WHEN s."copy_number" = 3 THEN 1 ELSE 0 END ) AS "gain_cnt",
    SUM( CASE WHEN s."copy_number" = 1 THEN 1 ELSE 0 END ) AS "hetdel_cnt"
  FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" AS s
  JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" AS c
    ON c."chromosome" = 'chr1'
   AND c."chromosome" = s."chromosome"
   AND LEAST(s."end_pos", c."hg38_stop") 
       > GREATEST(s."start_pos", c."hg38_start")
  WHERE s."chromosome" = 'chr1'
  GROUP BY c."cytoband_name"
), ranked AS (
  SELECT
    "cytoband_name",
    "amp_cnt",
    "gain_cnt",
    "hetdel_cnt",
    RANK() OVER (ORDER BY "amp_cnt"  DESC)  AS "amp_rank",
    RANK() OVER (ORDER BY "gain_cnt" DESC)  AS "gain_rank",
    RANK() OVER (ORDER BY "hetdel_cnt" DESC) AS "hetdel_rank"
  FROM per_cytoband
)
SELECT 
  "cytoband_name",
  "amp_cnt",
  "gain_cnt",
  "hetdel_cnt",
  "amp_rank",
  "gain_rank",
  "hetdel_rank"
FROM ranked
WHERE "amp_rank"   <= 11
  AND "gain_rank"  <= 11
  AND "hetdel_rank" <= 11
ORDER BY "amp_rank", "gain_rank", "hetdel_rank"
LIMIT 20;
```

