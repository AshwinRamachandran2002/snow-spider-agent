Query:
--Description: Rank each cytoband for Amplification, Gain, and Het Del frequencies separately
WITH per_cytoband AS (
  SELECT
    c."cytoband_name",
    SUM( CASE WHEN s."copy_number" > 3 THEN 1 ELSE 0 END ) AS "amp_cnt",
    SUM( CASE WHEN s."copy_number" = 3 THEN 1 ELSE 0 END ) AS "gain_cnt",
    SUM( CASE WHEN s."copy_number" = 1 THEN 1 ELSE 0 END ) AS "hetdel_cnt"
  FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" AS s
  JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" AS c
    ON c."chromosome" = 'chr1'
   AND c."chromosome" = s."chromosome"
   AND LEAST(s."end_pos", c."hg38_stop") 
       > GREATEST(s."start_pos", c."hg38_start")
  WHERE s."chromosome" = 'chr1'
  GROUP BY c."cytoband_name"
)
SELECT
  "cytoband_name",
  "amp_cnt",
  "gain_cnt",
  "hetdel_cnt",
  RANK() OVER (ORDER BY "amp_cnt"  DESC) AS "amp_rank",
  RANK() OVER (ORDER BY "gain_cnt" DESC) AS "gain_rank",
  RANK() OVER (ORDER BY "hetdel_cnt" DESC) AS "hetdel_rank"
FROM per_cytoband
LIMIT 20;
