    WHEN "copy_number" = 0 THEN 'Homozygous Deletion'
    ELSE 'Normal / Diploid'
  END AS "cnv_class"
FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
WHERE "chromosome" = 'chr1'
LIMIT 20;
```

```sql
--Description: Aggregate chr1 segments by CNV class to understand their raw frequencies
SELECT 
  CASE 
    WHEN "copy_number" > 3 THEN 'Amplification'
    WHEN "copy_number" = 3 THEN 'Gain'
    WHEN "copy_number" = 1 THEN 'Heterozygous Deletion'
    WHEN "copy_number" = 0 THEN 'Homozygous Deletion'
    ELSE 'Normal / Diploid'
  END AS "cnv_class",
  COUNT(*) AS "segment_count"
FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
WHERE "chromosome" = 'chr1'
GROUP BY "cnv_class"
ORDER BY "segment_count" DESC
LIMIT 20;
