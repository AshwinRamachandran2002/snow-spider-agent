ORDER BY "max_cn" DESC
LIMIT 20;
```

```sql
--Description: Demonstrate how chr1 segments are overlapped with cytobands (basic spatial join)  
SELECT  c."cytoband_name",
        s."start_pos",
        s."end_pos",
        s."copy_number"
FROM    TCGA_MITELMAN.PROD.CYTOBANDS_HG38                       c
JOIN    TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
      ON c."chromosome" = 'chr1'
     AND s."chromosome" = 'chr1'
     AND s."start_pos" <= c."hg38_stop"
     AND s."end_pos"   >= c."hg38_start"
LIMIT 20;
```

```sql
--Description: Count chr1 amplifications (copy_number ≥ 5) per cytoband and rank by frequency  
SELECT  c."cytoband_name",
        COUNT(*) AS "amp_count"
FROM    TCGA_MITELMAN.PROD.CYTOBANDS_HG38                       c
JOIN    TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
      ON c."chromosome" = 'chr1'
     AND s."chromosome" = 'chr1'
     AND s."start_pos" <= c."hg38_stop"
     AND s."end_pos"   >= c."hg38_start"
WHERE   s."copy_number" >= 5
GROUP BY c."cytoband_name"
ORDER BY "amp_count" DESC
LIMIT 20;
```

```sql
--Description: Count chr1 gains (copy_number = 3) per cytoband and rank by frequency  
SELECT  c."cytoband_name",
        COUNT(*) AS "gain_count"
FROM    TCGA_MITELMAN.PROD.CYTOBANDS_HG38                       c
JOIN    TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
      ON c."chromosome" = 'chr1'
     AND s."chromosome" = 'chr1'
     AND s."start_pos" <= c."hg38_stop"
     AND s."end_pos"   >= c."hg38_start"
WHERE   s."copy_number" = 3
GROUP BY c."cytoband_name"
ORDER BY "gain_count" DESC
LIMIT 20;
```

```sql
--Description: Count chr1 heterozygous deletions (copy_number = 1) per cytoband and rank by frequency  
SELECT  c."cytoband_name",
        COUNT(*) AS "het_del_count"
FROM    TCGA_MITELMAN.PROD.CYTOBANDS_HG38                       c
JOIN    TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
      ON c."chromosome" = 'chr1'
     AND s."chromosome" = 'chr1'
     AND s."start_pos" <= c."hg38_stop"
     AND s."end_pos"   >= c."hg38_start"
WHERE   s."copy_number" = 1
GROUP BY c."cytoband_name"
ORDER BY "het_del_count" DESC
LIMIT 20;
```

```sql
--Description: Identify chr1 cytobands ranking in the top 11 for amplifications, gains, AND het-deletions simultaneously  
SELECT  "cytoband_name"
FROM   (
        SELECT  c."cytoband_name",
                RANK() OVER (ORDER BY SUM(CASE WHEN s."copy_number" >= 5 THEN 1 ELSE 0 END) DESC) AS amp_rank,
                RANK() OVER (ORDER BY SUM(CASE WHEN s."copy_number" = 3 THEN 1 ELSE 0 END) DESC)  AS gain_rank,
                RANK() OVER (ORDER BY SUM(CASE WHEN s."copy_number" = 1 THEN 1 ELSE 0 END) DESC)  AS het_del_rank
        FROM    TCGA_MITELMAN.PROD.CYTOBANDS_HG38                       c
        JOIN    TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
              ON c."chromosome" = 'chr1'
             AND s."chromosome" = 'chr1'
             AND s."start_pos" <= c."hg38_stop"
             AND s."end_pos"   >= c."hg38_start"
        GROUP BY c."cytoband_name"
       ) q
WHERE  amp_rank  <= 11
  AND  gain_rank <= 11
  AND  het_del_rank <= 11
LIMIT 20;
```
