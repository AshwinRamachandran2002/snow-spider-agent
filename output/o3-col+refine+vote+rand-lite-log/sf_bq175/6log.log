--Description: 9) Intersect the three top-11 lists to keep cytobands ranking in the top 11 for ALL classes
WITH amp AS (
  SELECT c."cytoband_name"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON c."chromosome" = 'chr1'
   AND s."chromosome" = c."chromosome"
   AND s."start_pos" <= c."hg38_stop"
   AND s."end_pos"   >= c."hg38_start"
  WHERE s."chromosome" = 'chr1'
    AND s."copy_number" > 3
  GROUP BY c."cytoband_name"
  QUALIFY RANK() OVER (ORDER BY COUNT(*) DESC) <= 11
),
gain AS (
  SELECT c."cytoband_name"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON c."chromosome" = 'chr1'
   AND s."chromosome" = c."chromosome"
   AND s."start_pos" <= c."hg38_stop"
   AND s."end_pos"   >= c."hg38_start"
  WHERE s."chromosome" = 'chr1'
    AND s."copy_number" = 3
  GROUP BY c."cytoband_name"
  QUALIFY RANK() OVER (ORDER BY COUNT(*) DESC) <= 11
),
hetdel AS (
  SELECT c."cytoband_name"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON c."chromosome" = 'chr1'
   AND s."chromosome" = c."chromosome"
   AND s."start_pos" <= c."hg38_stop"
   AND s."end_pos"   >= c."hg38_start"
  WHERE s."chromosome" = 'chr1'
    AND s."copy_number" = 1
  GROUP BY c."cytoband_name"
  QUALIFY RANK() OVER (ORDER BY COUNT(*) DESC) <= 11
)
SELECT DISTINCT "cytoband_name"
FROM amp 
INTERSECT 
SELECT DISTINCT "cytoband_name" FROM gain
INTERSECT 
SELECT DISTINCT "cytoband_name" FROM hetdel
LIMIT 20;
