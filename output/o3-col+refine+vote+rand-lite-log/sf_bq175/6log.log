```

```sql
--Description: 3) Test the genomic‐overlap join between chr1 segments and chr1 cytobands
SELECT 
  s."chromosome",
  s."start_pos", 
  s."end_pos",
  s."copy_number",
  c."cytoband_name"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                   c
  ON c."chromosome" = 'chr1'
 AND s."chromosome" = c."chromosome"
 AND s."start_pos"  <= c."hg38_stop"
 AND s."end_pos"    >= c."hg38_start"
WHERE s."chromosome" = 'chr1'
LIMIT 20;
```

```sql
--Description: 4) Classify chr1 overlaps into Amplification (CN>3), Gain (=3) and Heterozygous Deletion (=1)
SELECT
  c."cytoband_name",
  CASE 
     WHEN s."copy_number" > 3 THEN 'AMPLIFICATION'
     WHEN s."copy_number" = 3 THEN 'GAIN'
     WHEN s."copy_number" = 1 THEN 'HETEROZYGOUS_DELETION'
  END AS "cnv_class"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                  c
  ON c."chromosome" = 'chr1'
 AND s."chromosome" = c."chromosome"
 AND s."start_pos" <= c."hg38_stop"
 AND s."end_pos"   >= c."hg38_start"
WHERE s."chromosome" = 'chr1'
  AND s."copy_number" IN (1,3) OR s."copy_number" > 3
LIMIT 20;
```

```sql
--Description: 5) Count how many segments of each CNV class map to every chr1 cytoband
SELECT
  c."cytoband_name",
  CASE 
     WHEN s."copy_number" > 3 THEN 'AMPLIFICATION'
     WHEN s."copy_number" = 3 THEN 'GAIN'
     WHEN s."copy_number" = 1 THEN 'HETEROZYGOUS_DELETION'
  END AS "cnv_class",
  COUNT(*) AS "event_count"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                  c
  ON c."chromosome" = 'chr1'
 AND s."chromosome" = c."chromosome"
 AND s."start_pos" <= c."hg38_stop"
 AND s."end_pos"   >= c."hg38_start"
WHERE s."chromosome" = 'chr1'
  AND s."copy_number" IN (1,3) OR s."copy_number" > 3
GROUP BY c."cytoband_name", "cnv_class"
LIMIT 20;
```

```sql
--Description: 6) Rank cytoband frequencies for AMPLIFICATION events (top 11)
SELECT * 
FROM (
  SELECT
    c."cytoband_name",
    COUNT(*) AS "amp_count",
    RANK() OVER (ORDER BY COUNT(*) DESC) AS "amp_rank"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON c."chromosome" = 'chr1'
   AND s."chromosome" = c."chromosome"
   AND s."start_pos" <= c."hg38_stop"
   AND s."end_pos"   >= c."hg38_start"
  WHERE s."chromosome" = 'chr1'
    AND s."copy_number" > 3       -- amplification
  GROUP BY c."cytoband_name"
) 
WHERE "amp_rank" <= 11
LIMIT 20;
```

```sql
--Description: 7) Rank cytoband frequencies for GAIN events (top 11)
SELECT * 
FROM (
  SELECT
    c."cytoband_name",
    COUNT(*) AS "gain_count",
    RANK() OVER (ORDER BY COUNT(*) DESC) AS "gain_rank"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON c."chromosome" = 'chr1'
   AND s."chromosome" = c."chromosome"
   AND s."start_pos" <= c."hg38_stop"
   AND s."end_pos"   >= c."hg38_start"
  WHERE s."chromosome" = 'chr1'
    AND s."copy_number" = 3        -- gain
  GROUP BY c."cytoband_name"
) 
WHERE "gain_rank" <= 11
LIMIT 20;
```

```sql
--Description: 8) Rank cytoband frequencies for Heterozygous Deletions (top 11)
SELECT * 
FROM (
  SELECT
    c."cytoband_name",
    COUNT(*) AS "hetdel_count",
    RANK() OVER (ORDER BY COUNT(*) DESC) AS "hetdel_rank"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON c."chromosome" = 'chr1'
   AND s."chromosome" = c."chromosome"
   AND s."start_pos" <= c."hg38_stop"
   AND s."end_pos"   >= c."hg38_start"
  WHERE s."chromosome" = 'chr1'
    AND s."copy_number" = 1        -- heterozygous deletion
  GROUP BY c."cytoband_name"
) 
WHERE "hetdel_rank" <= 11
LIMIT 20;
```

```sql
--Description: 9) Intersect the three top-11 lists to keep cytobands ranking in the top 11 for ALL classes
WITH amp AS (
  SELECT c."cytoband_name"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON c."chromosome" = 'chr1'
   AND s."chromosome" = c."chromosome"
   AND s."start_pos" <= c."hg38_stop"
   AND s."end_pos"   >= c."hg38_start"
  WHERE s."chromosome" = 'chr1'
    AND s."copy_number" > 3
  GROUP BY c."cytoband_name"
  QUALIFY RANK() OVER (ORDER BY COUNT(*) DESC) <= 11
),
gain AS (
  SELECT c."cytoband_name"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON c."chromosome" = 'chr1'
   AND s."chromosome" = c."chromosome"
   AND s."start_pos" <= c."hg38_stop"
   AND s."end_pos"   >= c."hg38_start"
  WHERE s."chromosome" = 'chr1'
    AND s."copy_number" = 3
  GROUP BY c."cytoband_name"
  QUALIFY RANK() OVER (ORDER BY COUNT(*) DESC) <= 11
),
hetdel AS (
  SELECT c."cytoband_name"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON c."chromosome" = 'chr1'
   AND s."chromosome" = c."chromosome"
   AND s."start_pos" <= c."hg38_stop"
   AND s."end_pos"   >= c."hg38_start"
  WHERE s."chromosome" = 'chr1'
    AND s."copy_number" = 1
  GROUP BY c."cytoband_name"
  QUALIFY RANK() OVER (ORDER BY COUNT(*) DESC) <= 11
)
SELECT DISTINCT "cytoband_name"
FROM amp 
INTERSECT 
SELECT DISTINCT "cytoband_name" FROM gain
INTERSECT 
SELECT DISTINCT "cytoband_name" FROM hetdel
LIMIT 20;
```

```sql
--Description: 10) (Optional deeper dive) Show counts & ranks for the intersected cytobands across all three CNV classes
WITH summary AS (
  SELECT
    c."cytoband_name",
    CASE 
       WHEN s."copy_number" > 3 THEN 'AMPLIFICATION'
       WHEN s."copy_number" = 3 THEN 'GAIN'
       WHEN s."copy_number" = 1 THEN 'HETEROZYGOUS_DELETION'
    END AS "cnv_class"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON c."chromosome" = 'chr1'
   AND s."chromosome" = c."chromosome"
   AND s."start_pos" <= c."hg38_stop"
   AND s."end_pos"   >= c."hg38_start"
  WHERE s."chromosome" = 'chr1'
    AND s."copy_number" IN (1,3) OR s."copy_number" > 3
)
SELECT 
  "cytoband_name",
  "cnv_class",
  COUNT(*)          AS "event_count",
  RANK() OVER (PARTITION BY "cnv_class" ORDER BY COUNT(*) DESC) AS "class_rank"
FROM summary
GROUP BY "cytoband_name", "cnv_class"
HAVING "cytoband_name" IN (
  /* reuse query 9 to filter cytobands that rank top 11 in all classes */
  SELECT DISTINCT "cytoband_name"
  FROM (
    /* paste the final intersection subquery here or reference a temp table */
    SELECT DISTINCT "cytoband_name" FROM summary WHERE "cnv_class"='AMPLIFICATION' QUALIFY RANK() OVER (ORDER BY COUNT(*) DESC) <= 11
    INTERSECT
    SELECT DISTINCT "cytoband_name" FROM summary WHERE "cnv_class"='GAIN'           QUALIFY RANK() OVER (ORDER BY COUNT(*) DESC) <= 11
    INTERSECT
    SELECT DISTINCT "cytoband_name" FROM summary WHERE "cnv_class"='HETEROZYGOUS_DELETION' QUALIFY RANK() OVER (ORDER BY COUNT(*) DESC) <= 11
  )
)
LIMIT 20;
```
