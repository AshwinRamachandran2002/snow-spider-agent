--     cytoband and assigns a CNV class.
--   • For each class, count events by cytoband and keep the 11 most-frequent.
--   • INTERSECT those three top-11 lists to find cytobands ranking high in ALL
--     three alteration types (these reflect the most recurrent & severe loci).
--   • Finally, for the retained cytobands, report event counts and their rank
--     within each CNV class.

WITH summary AS (  ------------------------------------------------ step-1
    SELECT
        c."cytoband_name",
        CASE
            WHEN s."copy_number" > 3 THEN 'AMPLIFICATION'
            WHEN s."copy_number" = 3 THEN 'GAIN'
            WHEN s."copy_number" = 1 THEN 'HETEROZYGOUS_DELETION'
        END                                  AS "cnv_class"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
      ON c."chromosome" = 'chr1'             -- restrict cytobands to chr1
     AND s."chromosome" = c."chromosome"
     AND s."start_pos"  <= c."hg38_stop"     -- overlap test
     AND s."end_pos"    >= c."hg38_start"
    WHERE s."chromosome" = 'chr1'
      AND (s."copy_number" = 1 OR            -- keep only the three classes
           s."copy_number" = 3 OR
           s."copy_number" > 3)
),
amp_top AS (  ----------------------------------------------- step-2a
    SELECT "cytoband_name"
    FROM summary
    WHERE "cnv_class" = 'AMPLIFICATION'
    GROUP BY "cytoband_name"
    ORDER BY COUNT(*) DESC
