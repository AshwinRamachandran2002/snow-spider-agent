```sql
--Description:  Goal → list chromosome-1 cytobands that are simultaneously
--              TOP-11 (by event count) for:
--              1) Amplifications  (copy_number > 3)
--              2) Gains           (copy_number  = 3)
--              3) Het-del         (copy_number  = 1)
-- Thinking process (embedded as comments):
--   • Build “summary” CTE that maps every chr1 allelic segment to its
--     cytoband and assigns a CNV class.
--   • For each class, count events by cytoband and keep the 11 most-frequent.
--   • INTERSECT those three top-11 lists to find cytobands ranking high in ALL
--     three alteration types (these reflect the most recurrent & severe loci).
--   • Finally, for the retained cytobands, report event counts and their rank
--     within each CNV class.

WITH summary AS (  ------------------------------------------------ step-1
    SELECT
        c."cytoband_name",
        CASE
            WHEN s."copy_number" > 3 THEN 'AMPLIFICATION'
            WHEN s."copy_number" = 3 THEN 'GAIN'
            WHEN s."copy_number" = 1 THEN 'HETEROZYGOUS_DELETION'
        END                                  AS "cnv_class"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
      ON c."chromosome" = 'chr1'             -- restrict cytobands to chr1
     AND s."chromosome" = c."chromosome"
     AND s."start_pos"  <= c."hg38_stop"     -- overlap test
     AND s."end_pos"    >= c."hg38_start"
    WHERE s."chromosome" = 'chr1'
      AND (s."copy_number" = 1 OR            -- keep only the three classes
           s."copy_number" = 3 OR
           s."copy_number" > 3)
),
amp_top AS (  ----------------------------------------------- step-2a
    SELECT "cytoband_name"
    FROM summary
    WHERE "cnv_class" = 'AMPLIFICATION'
    GROUP BY "cytoband_name"
    ORDER BY COUNT(*) DESC
    LIMIT 11
),
gain_top AS ( ----------------------------------------------- step-2b
    SELECT "cytoband_name"
    FROM summary
    WHERE "cnv_class" = 'GAIN'
    GROUP BY "cytoband_name"
    ORDER BY COUNT(*) DESC
    LIMIT 11
),
hetdel_top AS ( --------------------------------------------- step-2c
    SELECT "cytoband_name"
    FROM summary
    WHERE "cnv_class" = 'HETEROZYGOUS_DELETION'
    GROUP BY "cytoband_name"
    ORDER BY COUNT(*) DESC
    LIMIT 11
),
best AS (  ---------------------------------------------------- step-3
    SELECT "cytoband_name" FROM amp_top
    INTERSECT
    SELECT "cytoband_name" FROM gain_top
    INTERSECT
    SELECT "cytoband_name" FROM hetdel_top
)
SELECT  ------------------------------------------------------- step-4 (final)
    s."cytoband_name",
    s."cnv_class",
    COUNT(*) AS "event_count",
    RANK() OVER (PARTITION BY s."cnv_class" ORDER BY COUNT(*) DESC) AS "class_rank"
FROM summary s
WHERE s."cytoband_name" IN (SELECT "cytoband_name" FROM best)
GROUP BY s."cytoband_name", s."cnv_class"
ORDER BY s."cytoband_name", s."cnv_class"
LIMIT 20;
```
