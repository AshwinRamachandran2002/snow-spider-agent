  ON b."chromosome"      = s."chromosome"
 AND LEAST(s."end_pos",   b."hg38_stop")  > GREATEST(s."start_pos", b."hg38_start")
WHERE s."chromosome" = 'chr1'
LIMIT 20;
```

```sql
--Description: 7) Count amplifications (copy_number ≥ 4) per cytoband on chr1, top 20
SELECT b."cytoband_name",
       COUNT(*) AS "amp_count"
FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"  s
JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38"                                       b
  ON b."chromosome"      = s."chromosome"
 AND LEAST(s."end_pos",   b."hg38_stop")  > GREATEST(s."start_pos", b."hg38_start")
WHERE s."chromosome" = 'chr1'
  AND s."copy_number" >= 4
