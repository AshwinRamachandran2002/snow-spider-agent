```sql
--Description: 5) Join chr1 allelic segments to cytobands to see overlapping band names
SELECT s."start_pos",
       s."end_pos",
       s."copy_number",
       b."cytoband_name"
FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"  s
JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38"                                       b
  ON b."chromosome"      = s."chromosome"
 AND LEAST(s."end_pos",   b."hg38_stop")  > GREATEST(s."start_pos", b."hg38_start") --overlap
WHERE s."chromosome" = 'chr1'
LIMIT 20;
```

```sql
