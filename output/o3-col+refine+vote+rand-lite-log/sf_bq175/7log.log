--Description: 10) Identify chr1 cytobands whose amplification, gain, and het-deletion frequencies all rank within the top 11
WITH
amp AS (
    SELECT b."cytoband_name",
           ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS "amp_rank"
    FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
    JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38"                                      b
      ON b."chromosome"      = s."chromosome"
     AND LEAST(s."end_pos",   b."hg38_stop")  > GREATEST(s."start_pos", b."hg38_start")
    WHERE s."chromosome" = 'chr1' AND s."copy_number" >= 4
    GROUP BY b."cytoband_name"
),
gain AS (
    SELECT b."cytoband_name",
           ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS "gain_rank"
    FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
    JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38"                                      b
      ON b."chromosome"      = s."chromosome"
     AND LEAST(s."end_pos",   b."hg38_stop")  > GREATEST(s."start_pos", b."hg38_start")
    WHERE s."chromosome" = 'chr1' AND s."copy_number" = 3
    GROUP BY b."cytoband_name"
),
het AS (
    SELECT b."cytoband_name",
           ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS "het_rank"
    FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
    JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38"                                      b
      ON b."chromosome"      = s."chromosome"
     AND LEAST(s."end_pos",   b."hg38_stop")  > GREATEST(s."start_pos", b."hg38_start")
    WHERE s."chromosome" = 'chr1' AND s."copy_number" = 1
    GROUP BY b."cytoband_name"
)
SELECT a."cytoband_name"
FROM amp a
JOIN gain g ON g."cytoband_name" = a."cytoband_name"
JOIN het  h ON h."cytoband_name" = a."cytoband_name"
WHERE a."amp_rank"  <= 11
  AND g."gain_rank" <= 11
  AND h."het_rank"  <= 11
LIMIT 20;
