WHERE year = 2022
  AND commodity_desc   = 'MUSHROOMS'
  AND group_desc       = 'HORTICULTURE'
  AND statisticcat_desc= 'PRODUCTION'
  AND agg_level_desc   = 'STATE'
LIMIT 20;
```

```sql
-- Description: Aggregate (sum) corn production per state in bushels (just in
-- case more than one record per state exists, e.g., different classes).
SELECT
  state_alpha,
  state_name,
  SUM(value) AS corn_bu
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND commodity_desc   = 'CORN'
  AND group_desc       = 'FIELD CROPS'
  AND statisticcat_desc= 'PRODUCTION'
  AND unit_desc        = 'BU'
  AND agg_level_desc   = 'STATE'
  AND value IS NOT NULL
GROUP BY state_alpha, state_name
LIMIT 20;
```

```sql
-- Description: Aggregate mushroom production per state (whatever unit is reported;
-- later we will alias it as mushrooms_unit).  Adjust the filter if specific unit wanted.
SELECT
  state_alpha,
  state_name,
  unit_desc                            AS mushrooms_unit,
  SUM(value)                           AS mushrooms_total
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND commodity_desc   = 'MUSHROOMS'
  AND group_desc       = 'HORTICULTURE'
  AND statisticcat_desc= 'PRODUCTION'
  AND agg_level_desc   = 'STATE'
  AND value IS NOT NULL
GROUP BY state_alpha, state_name, unit_desc
LIMIT 20;
```

```sql
-- Description: Combine the two aggregated result sets so each state’s 2022
-- corn (bushels) and mushroom totals appear on the same line.
WITH corn AS (
    SELECT
      state_alpha,
      state_name,
      SUM(value) AS corn_bu
    FROM `bigquery-public-data.usda_nass_agriculture.crops`
    WHERE year = 2022
      AND commodity_desc   = 'CORN'
      AND group_desc       = 'FIELD CROPS'
      AND statisticcat_desc= 'PRODUCTION'
      AND unit_desc        = 'BU'
      AND agg_level_desc   = 'STATE'
      AND value IS NOT NULL
    GROUP BY state_alpha, state_name
),
mushrooms AS (
    SELECT
      state_alpha,
      state_name,
      SUM(value) AS mushrooms_total,
      MAX(unit_desc) AS mushrooms_unit
    FROM `bigquery-public-data.usda_nass_agriculture.crops`
    WHERE year = 2022
      AND commodity_desc   = 'MUSHROOMS'
      AND group_desc       = 'HORTICULTURE'
      AND statisticcat_desc= 'PRODUCTION'
      AND agg_level_desc   = 'STATE'
      AND value IS NOT NULL
    GROUP BY state_alpha, state_name
)
SELECT
  COALESCE(c.state_alpha, m.state_alpha) AS state_alpha,
  COALESCE(c.state_name,  m.state_name ) AS state_name,
  c.corn_bu,
  m.mushrooms_total,
  m.mushrooms_unit
FROM corn c
FULL JOIN mushrooms m
ON c.state_alpha = m.state_alpha
ORDER BY state_alpha
LIMIT 20;
```

```sql
-- Description: Grand totals — optional sanity check to see overall U.S. corn
-- production (in bushels) and mushroom production (their reported unit) for 2022.
SELECT
  'US TOTAL'                     AS level,
  SUM(CASE WHEN commodity_desc = 'CORN'      THEN value END) AS total_corn_bu,
  SUM(CASE WHEN commodity_desc = 'MUSHROOMS' THEN value END) AS total_mushrooms
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND commodity_desc IN ('CORN','MUSHROOMS')
  AND statisticcat_desc = 'PRODUCTION'
  AND agg_level_desc    = 'STATE'
  AND value IS NOT NULL
LIMIT 20;
```
