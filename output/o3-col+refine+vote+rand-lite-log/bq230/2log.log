-- Description: Check how 2022 STATE-level corn data are stored, especially the
-- statistic category and unit.  This confirms that production is measured in bushels.
SELECT
  state_alpha,
  commodity_desc,
  statisticcat_desc,
  unit_desc,
  value
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND commodity_desc = 'CORN'
  AND group_desc     = 'FIELD CROPS'
  AND agg_level_desc = 'STATE'
LIMIT 20;
