-- Description: Verify that mushroom data exist for 2022 at STATE level and look
-- at the available statistic categories and units.
SELECT
  state_alpha,
  commodity_desc,
  statisticcat_desc,
  unit_desc,
  value
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND commodity_desc LIKE '%MUSHROOM%'
  AND group_desc     = 'HORTICULTURE'
  AND agg_level_desc = 'STATE'
