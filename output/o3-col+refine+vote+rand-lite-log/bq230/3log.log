    AND group_desc        = 'FIELD CROPS'
    AND commodity_desc    = 'CORN'
    AND statisticcat_desc = 'PRODUCTION'
    AND agg_level_desc    = 'STATE'
    AND unit_desc         = 'BU'          -- bushels for corn
    AND value IS NOT NULL
    AND domain_desc       = 'TOTAL'
  GROUP BY state
),
mush AS (
  SELECT
    state_alpha AS state,
    SUM(value)  AS mushroom_production_lb_2022
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND group_desc        = 'HORTICULTURE'
    AND LOWER(commodity_desc) LIKE '%mushroom%'
    AND statisticcat_desc = 'PRODUCTION'
    AND agg_level_desc    = 'STATE'
    AND unit_desc         = 'LB'          -- pounds for mushrooms
    AND value IS NOT NULL
    AND domain_desc       = 'TOTAL'
  GROUP BY state
)
SELECT
  COALESCE(c.state, m.state)         AS state,
  c.corn_production_bu_2022,
  m.mushroom_production_lb_2022
FROM corn AS c
FULL OUTER JOIN mush AS m
USING (state)
ORDER BY state;
