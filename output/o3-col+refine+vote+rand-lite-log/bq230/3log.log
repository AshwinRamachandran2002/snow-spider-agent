--Description: 
--9. Combine state-level 2022 corn (BU) and mushroom (LB) production totals.  
--   Uses two CTEs then FULL OUTER JOIN so any state with either crop appears.  
--   Shows first 50 rows for inspection.
WITH corn AS (
  SELECT state_alpha AS state, SUM(value) AS corn_bu_2022
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND group_desc        = 'FIELD CROPS'
    AND commodity_desc    = 'CORN'
    AND statisticcat_desc = 'PRODUCTION'
    AND agg_level_desc    = 'STATE'
    AND unit_desc         = 'BU'
    AND value IS NOT NULL
    AND domain_desc       = 'TOTAL'
  GROUP BY state
),
mush AS (
  SELECT state_alpha AS state, SUM(value) AS mushroom_lb_2022
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND group_desc        = 'HORTICULTURE'
    AND LOWER(commodity_desc) LIKE '%mushroom%'
    AND statisticcat_desc = 'PRODUCTION'
    AND agg_level_desc    = 'STATE'
    AND unit_desc         = 'LB'
    AND value IS NOT NULL
    AND domain_desc       = 'TOTAL'
  GROUP BY state
)
SELECT
  COALESCE(corn.state, mush.state) AS state,
  corn.corn_bu_2022,
  mush.mushroom_lb_2022
FROM corn
FULL OUTER JOIN mush USING (state)
ORDER BY state
LIMIT 50
