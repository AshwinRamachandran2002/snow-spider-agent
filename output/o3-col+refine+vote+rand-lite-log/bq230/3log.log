```sql
-- 9. Combine corn and mushroom bushel totals into one table per state
WITH corn AS (
  SELECT state_alpha AS state, SUM(value) AS corn_bu_2022
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND group_desc = 'FIELD CROPS'
    AND commodity_desc = 'CORN'
    AND statisticcat_desc = 'PRODUCTION'
    AND agg_level_desc = 'STATE'
    AND unit_desc = 'BU'
    AND value IS NOT NULL
    AND domain_desc = 'TOTAL'
  GROUP BY state
),
mush AS (
  SELECT state_alpha AS state, SUM(value) AS mushroom_bu_2022
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND group_desc = 'HORTICULTURE'
    AND LOWER(commodity_desc) LIKE '%mushroom%'
    AND statisticcat_desc = 'PRODUCTION'
    AND agg_level_desc = 'STATE'
    AND unit_desc = 'BU'
    AND value IS NOT NULL
    AND domain_desc = 'TOTAL'
  GROUP BY state
)
SELECT
  COALESCE(corn.state, mush.state)              AS state,
  corn.corn_bu_2022,
  mush.mushroom_bu_2022
FROM corn
FULL OUTER JOIN mush
USING (state)
ORDER BY state
LIMIT 50;
```

```sql
--10. Same combined result but only states where both crops have data
SELECT
  corn.state,
  corn.corn_bu_2022,
  mush.mushroom_bu_2022
FROM (
  SELECT state_alpha AS state, SUM(value) AS corn_bu_2022
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND group_desc = 'FIELD CROPS'
    AND commodity_desc = 'CORN'
    AND statisticcat_desc = 'PRODUCTION'
    AND agg_level_desc = 'STATE'
    AND unit_desc = 'BU'
    AND value IS NOT NULL
    AND domain_desc = 'TOTAL'
  GROUP BY state
) AS corn
JOIN (
  SELECT state_alpha AS state, SUM(value) AS mushroom_bu_2022
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND group_desc = 'HORTICULTURE'
    AND LOWER(commodity_desc) LIKE '%mushroom%'
    AND statisticcat_desc = 'PRODUCTION'
    AND agg_level_desc = 'STATE'
    AND unit_desc = 'BU'
    AND value IS NOT NULL
    AND domain_desc = 'TOTAL'
  GROUP BY state
) AS mush
USING (state)
ORDER BY state
LIMIT 50;
```

