Query:
--Description: 1) Peek at 2022 corn rows to confirm they sit in FIELD CROPS/CORN and are measured in bushels.
SELECT
  `state_alpha`,
  `group_desc`,
  `commodity_desc`,
  `statisticcat_desc`,
  `unit_desc`,
  `value`
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE `year` = 2022
  AND `commodity_desc` = 'CORN'
  AND `statisticcat_desc` = 'PRODUCTION'
  AND `agg_level_desc` = 'STATE'
LIMIT 20;
