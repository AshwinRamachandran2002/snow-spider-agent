--Description: 3) Explore 2022 mushroom records to see how they are reported and what units appear.
SELECT
  `state_alpha`,
  `group_desc`,
  `commodity_desc`,
  `class_desc`,
  `statisticcat_desc`,
  `unit_desc`,
  `value`
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE `year` = 2022
  AND LOWER(`commodity_desc`) LIKE '%mushroom%'
  AND `statisticcat_desc` = 'PRODUCTION'
  AND `agg_level_desc` = 'STATE'
LIMIT 20
