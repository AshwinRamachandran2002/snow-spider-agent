Query:
--Description: Peek at 2022 crop-records that mention “CORN” to confirm how they are stored.
SELECT DISTINCT
  commodity_desc,
  class_desc,
  group_desc,
  statisticcat_desc,
  unit_desc
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND LOWER(commodity_desc) LIKE '%corn%'
  AND statisticcat_desc = 'PRODUCTION'
  AND agg_level_desc = 'STATE'
LIMIT 20;
