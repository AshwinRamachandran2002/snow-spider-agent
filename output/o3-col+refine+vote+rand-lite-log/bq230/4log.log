  AND agg_level_desc = 'STATE'
  AND value IS NOT NULL
GROUP BY state_alpha, state_name
ORDER BY state_alpha
LIMIT 20;
```

```sql
--Description: List every state that has 2022 mushroom production (all horticulture forms, any BUSHEL unit).
SELECT
  state_alpha,
  state_name,
  SUM(value) AS mushroom_bu_2022
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND commodity_desc LIKE '%MUSHROOM%'
  AND group_desc = 'HORTICULTURE'
  AND statisticcat_desc = 'PRODUCTION'
  -- many mushroom items are measured in LB; still preview to see
  AND unit_desc IN ('BU','LB')
  AND agg_level_desc = 'STATE'
  AND value IS NOT NULL
GROUP BY state_alpha, state_name
ORDER BY state_alpha
LIMIT 20;
```

```sql
--Description: Verify if any 2022 mushroom record in BU exists; if none we’ll know to use other units.
SELECT DISTINCT
  unit_desc
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND commodity_desc LIKE '%MUSHROOM%'
  AND group_desc = 'HORTICULTURE'
  AND statisticcat_desc = 'PRODUCTION'
  AND agg_level_desc = 'STATE'
LIMIT 20;
```

```sql
--Description: Create a corn sub-query and a mushroom sub-query then full-join to have both numbers per state.
WITH corn AS (
  SELECT
    state_alpha,
    state_name,
    SUM(value) AS corn_bu_2022
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND commodity_desc = 'CORN'
    AND group_desc = 'FIELD CROPS'
    AND statisticcat_desc = 'PRODUCTION'
    AND unit_desc = 'BU'
    AND agg_level_desc = 'STATE'
    AND value IS NOT NULL
  GROUP BY state_alpha, state_name
),
mush AS (
  SELECT
    state_alpha,
    state_name,
    SUM(value) AS mushroom_total_2022
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND commodity_desc LIKE '%MUSHROOM%'
    AND group_desc = 'HORTICULTURE'
    AND statisticcat_desc = 'PRODUCTION'
    -- use the unit that actually appears (replace BU if necessary after check)
    AND unit_desc = 'LB'
    AND agg_level_desc = 'STATE'
    AND value IS NOT NULL
  GROUP BY state_alpha, state_name
)
SELECT
  COALESCE(corn.state_alpha, mush.state_alpha) AS state_alpha,
  COALESCE(corn.state_name, mush.state_name)   AS state_name,
  corn.corn_bu_2022,
  mush.mushroom_total_2022
FROM corn
FULL JOIN mush
USING(state_alpha, state_name)
ORDER BY state_alpha
LIMIT 20;
```

```sql
--Description: Same combined result but filtered to rows where both corn AND mushroom data exist for 2022.
WITH corn AS (
  SELECT
    state_alpha,
    SUM(value) AS corn_bu_2022
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND commodity_desc = 'CORN'
    AND group_desc = 'FIELD CROPS'
    AND statisticcat_desc = 'PRODUCTION'
    AND unit_desc = 'BU'
    AND agg_level_desc = 'STATE'
    AND value IS NOT NULL
  GROUP BY state_alpha
),
mush AS (
  SELECT
    state_alpha,
    SUM(value) AS mushroom_lb_2022
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND commodity_desc LIKE '%MUSHROOM%'
    AND group_desc = 'HORTICULTURE'
    AND statisticcat_desc = 'PRODUCTION'
    AND unit_desc = 'LB'
    AND agg_level_desc = 'STATE'
    AND value IS NOT NULL
  GROUP BY state_alpha
)
SELECT
  corn.state_alpha,
  corn.corn_bu_2022,
  mush.mushroom_lb_2022
FROM corn
JOIN mush USING(state_alpha)
ORDER BY corn.state_alpha
LIMIT 20;
```

```sql
--Description: Quickly inspect one state (e.g., Pennsylvania) to see detailed 2022 mushroom production rows.
SELECT
  state_name,
  commodity_desc,
  class_desc,
  prodn_practice_desc,
  util_practice_desc,
  value,
  unit_desc
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND state_alpha = 'PA'
  AND commodity_desc LIKE '%MUSHROOM%'
  AND group_desc = 'HORTICULTURE'
  AND statisticcat_desc = 'PRODUCTION'
  AND agg_level_desc = 'STATE'
LIMIT 20;
```

```sql
--Description: If BU units do not exist for mushrooms, convert LB→BU using 56-lb /bu (sample conversion for showcase).
-- (This is only illustrative; replace 56 with correct mushroom weight per bushel if known.)
WITH mush_lb AS (
  SELECT
    state_alpha,
    state_name,
    SUM(value) AS mushroom_lb
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND commodity_desc LIKE '%MUSHROOM%'
    AND group_desc = 'HORTICULTURE'
    AND statisticcat_desc = 'PRODUCTION'
    AND unit_desc = 'LB'
    AND agg_level_desc = 'STATE'
    AND value IS NOT NULL
  GROUP BY state_alpha, state_name
)
SELECT
  state_alpha,
  state_name,
  mushroom_lb / 56 AS mushroom_bu_est
FROM mush_lb
ORDER BY state_alpha
LIMIT 20;
```
