  ]) AS d
  JOIN `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_` || d
  USING ()
  , UNNEST(`event_params`) AS ep
  WHERE ep.key = 'engagement_time_msec' AND ep.value.int_value > 0
),
two_day AS (
  SELECT DISTINCT `user_pseudo_id`
  FROM UNNEST(['20210106','20210107']) AS d
  JOIN `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_` || d
  USING ()
  , UNNEST(`event_params`) AS ep
  WHERE ep.key = 'engagement_time_msec' AND ep.value.int_value > 0
)
SELECT COUNT(*) AS users_7d_positive_no_2d_positive
FROM seven_day
WHERE `user_pseudo_id` NOT IN (SELECT `user_pseudo_id` FROM two_day)
LIMIT 20;
