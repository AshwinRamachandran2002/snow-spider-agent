```sql
--Description / Thinking process:
-- Objective: count distinct pseudo-users who
--   (a) had a positive engagement_time_msec during the 7-day window
--       1-Jan-2021 00:00:00  ➜  7-Jan-2021 23:59:59, AND
--   (b) had NO positive engagement_time_msec during the final 2-day window
--       6-Jan-2021 00:00:00  ➜  7-Jan-2021 23:59:59.
--
-- Approach:
-- 1. Use the wildcard tables `events_*` (one table per day).
-- 2. Filter tables via pseudo-column _TABLE_SUFFIX to limit read range.
-- 3. UNNEST event_params; keep rows where key = 'engagement_time_msec'
--    and int_value > 0 (positive engagement).
-- 4. Build two CTEs:
--      • seven_day : users with positive engagement in 7-day window.
--      • two_day   : users with positive engagement in last 2 days.
-- 5. Return the count of users in seven_day that are NOT in two_day.
WITH
seven_day AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  CROSS JOIN UNNEST(event_params) AS ep
  WHERE _TABLE_SUFFIX BETWEEN '20210101' AND '20210107'
    AND ep.key = 'engagement_time_msec'
    AND ep.value.int_value > 0
),
two_day AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  CROSS JOIN UNNEST(event_params) AS ep
  WHERE _TABLE_SUFFIX BETWEEN '20210106' AND '20210107'
    AND ep.key = 'engagement_time_msec'
    AND ep.value.int_value > 0
)
SELECT COUNT(*) AS users_7d_positive_no_2d_positive
FROM seven_day
WHERE user_pseudo_id NOT IN (SELECT user_pseudo_id FROM two_day);
```
