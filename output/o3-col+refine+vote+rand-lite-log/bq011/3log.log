Query:
--Description: 10) Show the top 20 pseudo users by total engagement time in the 7-day window,
--      provided they are not active (engaged) in the 2-day window
WITH target_users AS (
  WITH seven_day AS (
    SELECT user_pseudo_id, SUM(ep.value.int_value) AS eng_time_7d
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
         UNNEST(event_params) AS ep
    WHERE _TABLE_SUFFIX BETWEEN '20210101' AND '20210107'
      AND ep.key = 'engagement_time_msec'
      AND ep.value.int_value > 0
    GROUP BY user_pseudo_id
  ),
  two_day AS (
    SELECT DISTINCT user_pseudo_id
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
         UNNEST(event_params) AS ep
    WHERE _TABLE_SUFFIX BETWEEN '20210106' AND '20210107'
      AND ep.key = 'engagement_time_msec'
      AND ep.value.int_value > 0
  )
  SELECT s.user_pseudo_id, s.eng_time_7d
  FROM seven_day AS s
  WHERE s.user_pseudo_id NOT IN (SELECT user_pseudo_id FROM two_day)
)
SELECT *
FROM target_users
ORDER BY eng_time_7d DESC
LIMIT 20;
