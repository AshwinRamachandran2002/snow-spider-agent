Query:
-- Description: 6) List the user_pseudo_id values that appear in the 7-day set
--              but NOT in the 2-day set (our target audience).
WITH
users_7day AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20210101' AND '20210107'
    AND EXISTS (
          SELECT 1 FROM UNNEST(event_params) ep
          WHERE ep.key = 'engagement_time_msec' AND ep.value.int_value > 0
        )
