Query:
--Description: 6) Join first-open and uninstall to measure number of days until uninstall.
SELECT  fo.user_pseudo_id,
        fo.first_open_date,
        un.uninstall_date,
        DATE_DIFF(un.uninstall_date, fo.first_open_date, DAY) AS days_to_uninstall
FROM  (SELECT user_pseudo_id,
              DATE(TIMESTAMP_MILLIS(CAST(SAFE_DIVIDE(user_first_touch_timestamp,1000) AS INT64))) AS first_open_date
       FROM  `firebase-public-project.analytics_153293282.events_201809*`
       WHERE event_name = 'first_open') AS fo
JOIN  (SELECT user_pseudo_id,
              DATE(TIMESTAMP_MILLIS(CAST(SAFE_DIVIDE(event_timestamp,1000) AS INT64))) AS uninstall_date
       FROM  `firebase-public-project.analytics_153293282.events_201809*`
       WHERE event_name = 'app_remove') AS un
ON  fo.user_pseudo_id = un.user_pseudo_id
LIMIT 20;
