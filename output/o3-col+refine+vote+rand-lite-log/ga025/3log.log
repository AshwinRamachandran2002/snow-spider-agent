```sql
--Description: 6) Join first-open and uninstall to measure number of days until uninstall.
SELECT  fo.user_pseudo_id,
        fo.first_open_date,
        un.uninstall_date,
        DATE_DIFF(un.uninstall_date, fo.first_open_date, DAY) AS days_to_uninstall
FROM  (SELECT user_pseudo_id,
              DATE(TIMESTAMP_MILLIS(CAST(SAFE_DIVIDE(user_first_touch_timestamp,1000) AS INT64))) AS first_open_date
       FROM  `firebase-public-project.analytics_153293282.events_201809*`
       WHERE event_name = 'first_open') AS fo
JOIN  (SELECT user_pseudo_id,
              DATE(TIMESTAMP_MILLIS(CAST(SAFE_DIVIDE(event_timestamp,1000) AS INT64))) AS uninstall_date
       FROM  `firebase-public-project.analytics_153293282.events_201809*`
       WHERE event_name = 'app_remove') AS un
ON  fo.user_pseudo_id = un.user_pseudo_id
LIMIT 20;
```

```sql
--Description: 7) Keep only users that uninstalled within 7 days of first-open.
SELECT *
FROM (
      SELECT  fo.user_pseudo_id,
              fo.first_open_date,
              un.uninstall_date,
              DATE_DIFF(un.uninstall_date, fo.first_open_date, DAY) AS days_to_uninstall
      FROM  (SELECT user_pseudo_id,
                    DATE(TIMESTAMP_MILLIS(CAST(SAFE_DIVIDE(user_first_touch_timestamp,1000) AS INT64))) AS first_open_date
             FROM  `firebase-public-project.analytics_153293282.events_201809*`
             WHERE event_name = 'first_open') AS fo
      JOIN  (SELECT user_pseudo_id,
                    DATE(TIMESTAMP_MILLIS(CAST(SAFE_DIVIDE(event_timestamp,1000) AS INT64))) AS uninstall_date
             FROM  `firebase-public-project.analytics_153293282.events_201809*`
             WHERE event_name = 'app_remove') AS un
      ON  fo.user_pseudo_id = un.user_pseudo_id )
WHERE days_to_uninstall BETWEEN 0 AND 7
LIMIT 20;
```

```sql
--Description: 8) Which of those early-uninstall users had at least one crash (“app_exception”)?
SELECT DISTINCT eu.user_pseudo_id
FROM (
      -- early uninstallers (same sub-query as #7 without LIMIT)
      SELECT  fo.user_pseudo_id
      FROM  (SELECT user_pseudo_id,
                    DATE(TIMESTAMP_MILLIS(CAST(SAFE_DIVIDE(user_first_touch_timestamp,1000) AS INT64))) AS first_open_date
             FROM  `firebase-public-project.analytics_153293282.events_201809*`
             WHERE event_name = 'first_open') AS fo
      JOIN  (SELECT user_pseudo_id,
                    DATE(TIMESTAMP_MILLIS(CAST(SAFE_DIVIDE(event_timestamp,1000) AS INT64))) AS uninstall_date
             FROM  `firebase-public-project.analytics_153293282.events_201809*`
             WHERE event_name = 'app_remove') AS un
      ON  fo.user_pseudo_id = un.user_pseudo_id
      WHERE DATE_DIFF(un.uninstall_date, fo.first_open_date, DAY) BETWEEN 0 AND 7
     ) AS eu
JOIN `firebase-public-project.analytics_153293282.events_201809*` AS ev
ON  eu.user_pseudo_id = ev.user_pseudo_id
WHERE ev.event_name = 'app_exception'
LIMIT 20;
```

```sql
--Description: 9) Count early-uninstall users and those who also crashed.
SELECT
  COUNT(DISTINCT early.user_pseudo_id)                          AS total_early_uninstall,
  COUNT(DISTINCT crash.user_pseudo_id)                          AS early_uninstall_with_crash
FROM (
      -- early uninstallers
      SELECT DISTINCT fo.user_pseudo_id
      FROM  (SELECT user_pseudo_id,
                    DATE(TIMESTAMP_MILLIS(CAST(SAFE_DIVIDE(user_first_touch_timestamp,1000) AS INT64))) AS first_open_date
             FROM  `firebase-public-project.analytics_153293282.events_201809*`
             WHERE event_name = 'first_open') AS fo
      JOIN  (SELECT user_pseudo_id,
                    DATE(TIMESTAMP_MILLIS(CAST(SAFE_DIVIDE(event_timestamp,1000) AS INT64))) AS uninstall_date
             FROM  `firebase-public-project.analytics_153293282.events_201809*`
             WHERE event_name = 'app_remove') AS un
      ON  fo.user_pseudo_id = un.user_pseudo_id
      WHERE DATE_DIFF(un.uninstall_date, fo.first_open_date, DAY) BETWEEN 0 AND 7
     ) AS early
LEFT JOIN (
      SELECT DISTINCT user_pseudo_id
      FROM `firebase-public-project.analytics_153293282.events_201809*`
      WHERE event_name = 'app_exception'
     ) AS crash
ON early.user_pseudo_id = crash.user_pseudo_id
LIMIT 20;
```

```sql
--Description: 10) Final percentage of September-2018 first-open users who uninstalled within 7 days AND experienced a crash.
SELECT
  SAFE_DIVIDE(early_uninstall_with_crash, total_early_uninstall) * 100 AS pct_early_uninstallers_that_crashed
FROM (
  -- re-use query #9 without LIMIT to get the two counts
  SELECT
    COUNT(DISTINCT early.user_pseudo_id)  AS total_early_uninstall,
    COUNT(DISTINCT crash.user_pseudo_id)  AS early_uninstall_with_crash
  FROM (
        SELECT DISTINCT fo.user_pseudo_id
        FROM  (SELECT user_pseudo_id,
                      DATE(TIMESTAMP_MILLIS(CAST(SAFE_DIVIDE(user_first_touch_timestamp,1000) AS INT64))) AS first_open_date
               FROM  `firebase-public-project.analytics_153293282.events_201809*`
               WHERE event_name = 'first_open') AS fo
        JOIN  (SELECT user_pseudo_id,
                      DATE(TIMESTAMP_MILLIS(CAST(SAFE_DIVIDE(event_timestamp,1000) AS INT64))) AS uninstall_date
               FROM  `firebase-public-project.analytics_153293282.events_201809*`
               WHERE event_name = 'app_remove') AS un
        ON  fo.user_pseudo_id = un.user_pseudo_id
        WHERE DATE_DIFF(un.uninstall_date, fo.first_open_date, DAY) BETWEEN 0 AND 7
       ) AS early
  LEFT JOIN (
        SELECT DISTINCT user_pseudo_id
        FROM `firebase-public-project.analytics_153293282.events_201809*`
        WHERE event_name = 'app_exception'
       ) AS crash
  ON early.user_pseudo_id = crash.user_pseudo_id
)
LIMIT 20;
```

