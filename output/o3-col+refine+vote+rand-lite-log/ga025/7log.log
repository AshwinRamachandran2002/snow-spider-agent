2025-05-05 04:27:14 - Thread-3152 (execute) - INFO - [Exploration]
Below are 10 exploratory ‑> analytical queries that walk from simple inspection of September-2018 “first_open” users to the final percentage of those that  
1) un-installed (event app_remove) within 7 days and  
2) experienced at least one crash (event app_exception) in that 7-day window.

Each query returns at most 20 rows so they can be run quickly while still showing the logic / intermediate values.

```sql
--1) Description:  Show the different kinds of events that exist on the first day of September 2018
SELECT DISTINCT event_name
FROM  `firebase-public-project.analytics_153293282.events_20180901`
LIMIT 20;
```

```sql
--2) Description:  Grab September-2018 first-open events (raw rows) so we can see the fields we will need later
SELECT  user_pseudo_id,
        event_timestamp,
        event_date,
        TIMESTAMP_MICROS(event_timestamp)  AS ts,
        DATE(TIMESTAMP_MICROS(event_timestamp)) AS event_date_conv
FROM  `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
  AND event_name = 'first_open'
LIMIT 20;
```

```sql
--3) Description:  Distinct users whose very first-open is in Sept-2018 (one row per user with that first-open date)
SELECT DISTINCT
       user_pseudo_id,
       DATE(TIMESTAMP_MICROS(event_timestamp)) AS first_open_date
FROM  `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
  AND event_name = 'first_open'
LIMIT 20;
```

```sql
--4) Description:  Look at uninstall (app_remove) events for the same month for a quick sanity check
SELECT  user_pseudo_id,
        DATE(TIMESTAMP_MICROS(event_timestamp)) AS uninstall_date
FROM  `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'   -- up to 7 days after Sept
  AND event_name = 'app_remove'
LIMIT 20;
```

```sql
--5) Description:  First join – users whose first_open is Sept-2018 AND who uninstalled within 7 days
SELECT  f.user_pseudo_id,
        f.first_open_date,
        u.uninstall_date,
        DATE_DIFF(u.uninstall_date, f.first_open_date, DAY) AS days_to_uninstall
FROM  (
        SELECT user_pseudo_id,
               DATE(TIMESTAMP_MICROS(event_timestamp)) AS first_open_date
        FROM  `firebase-public-project.analytics_153293282.events_*`
        WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
          AND event_name = 'first_open'
      ) AS f
JOIN  (
        SELECT user_pseudo_id,
               DATE(TIMESTAMP_MICROS(event_timestamp)) AS uninstall_date
        FROM  `firebase-public-project.analytics_153293282.events_*`
        WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
          AND event_name = 'app_remove'
      ) AS u
ON  f.user_pseudo_id = u.user_pseudo_id
WHERE DATE_DIFF(u.uninstall_date, f.first_open_date, DAY) BETWEEN 0 AND 7
LIMIT 20;
```

```sql
--6) Description:  How many distinct users uninstalled within 7 days?  (denominator)
SELECT COUNT(DISTINCT user_pseudo_id) AS uninstall_7d_users
FROM (
      -- exact same join logic as Query-5
      SELECT  f.user_pseudo_id
      FROM  (
              SELECT user_pseudo_id,
                     DATE(TIMESTAMP_MICROS(event_timestamp)) AS first_open_date
              FROM  `firebase-public-project.analytics_153293282.events_*`
              WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
                AND event_name = 'first_open'
           ) AS f
      JOIN (
              SELECT user_pseudo_id,
                     DATE(TIMESTAMP_MICROS(event_timestamp)) AS uninstall_date
              FROM  `firebase-public-project.analytics_153293282.events_*`
              WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
                AND event_name = 'app_remove'
           ) AS u
      ON  f.user_pseudo_id = u.user_pseudo_id
      WHERE DATE_DIFF(u.uninstall_date, f.first_open_date, DAY) BETWEEN 0 AND 7
)
LIMIT 20;      -- (only 1 row will come back)
```

```sql
--7) Description:  Pull crash (app_exception) events for Sept-2018 users to inspect
SELECT  user_pseudo_id,
        DATE(TIMESTAMP_MICROS(event_timestamp)) AS crash_date
FROM  `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
  AND event_name = 'app_exception'
LIMIT 20;
```

```sql
--8) Description:  Users who 1) uninstalled ≤7d and 2) had ≥1 crash in that same 7-day window
WITH first_open AS (
      SELECT user_pseudo_id,
             DATE(TIMESTAMP_MICROS(event_timestamp)) AS first_open_date
      FROM  `firebase-public-project.analytics_153293282.events_*`
      WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
        AND event_name = 'first_open'
),
uninstall AS (
      SELECT user_pseudo_id,
             DATE(TIMESTAMP_MICROS(event_timestamp)) AS uninstall_date
      FROM  `firebase-public-project.analytics_153293282.events_*`
      WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
        AND event_name = 'app_remove'
),
crash AS (
      SELECT user_pseudo_id,
             DATE(TIMESTAMP_MICROS(event_timestamp)) AS crash_date
      FROM  `firebase-public-project.analytics_153293282.events_*`
      WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
        AND event_name = 'app_exception'
)
SELECT DISTINCT  f.user_pseudo_id
FROM first_open  AS f
JOIN uninstall   AS u USING (user_pseudo_id)
JOIN crash       AS c USING (user_pseudo_id)
WHERE DATE_DIFF(u.uninstall_date, f.first_open_date, DAY) BETWEEN 0 AND 7
  AND DATE_DIFF(c.crash_date,  f.first_open_date, DAY) BETWEEN 0 AND 7   -- crash inside 7-day window
LIMIT 20;
```

```sql
--9) Description:  Count of users meeting BOTH conditions (numerator)
WITH first_open AS (
      SELECT user_pseudo_id,
             DATE(TIMESTAMP_MICROS(event_timestamp)) AS first_open_date
      FROM  `firebase-public-project.analytics_153293282.events_*`
      WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
        AND event_name = 'first_open'
),
uninstall AS (
      SELECT user_pseudo_id,
             DATE(TIMESTAMP_MICROS(event_timestamp)) AS uninstall_date
      FROM  `firebase-public-project.analytics_153293282.events_*`
      WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
        AND event_name = 'app_remove'
),
crash AS (
      SELECT user_pseudo_id,
             DATE(TIMESTAMP_MICROS(event_timestamp)) AS crash_date
      FROM  `firebase-public-project.analytics_153293282.events_*`
      WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
        AND event_name = 'app_exception'
)
SELECT COUNT(DISTINCT f.user_pseudo_id) AS uninstall_7d_with_crash_users
FROM first_open  AS f
JOIN uninstall   AS u USING (user_pseudo_id)
JOIN crash       AS c USING (user_pseudo_id)
WHERE DATE_DIFF(u.uninstall_date, f.first_open_date, DAY) BETWEEN 0 AND 7
  AND DATE_DIFF(c.crash_date,  f.first_open_date, DAY) BETWEEN 0 AND 7
LIMIT 20;     -- single row
```

```sql
--10) Description:  Final percentage = (users that uninstalled ≤7d AND crashed) / (users that uninstalled ≤7d)
WITH first_open AS (
      SELECT user_pseudo_id,
             DATE(TIMESTAMP_MICROS(event_timestamp)) AS first_open_date
      FROM  `firebase-public-project.analytics_153293282.events_*`
      WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
        AND event_name = 'first_open'
),
uninstall AS (
      SELECT user_pseudo_id,
             DATE(TIMESTAMP_MICROS(event_timestamp)) AS uninstall_date
      FROM  `firebase-public-project.analytics_153293282.events_*`
      WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
        AND event_name = 'app_remove'
),
crash AS (
      SELECT user_pseudo_id,
             DATE(TIMESTAMP_MICROS(event_timestamp)) AS crash_date
      FROM  `firebase-public-project.analytics_153293282.events_*`
      WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
        AND event_name = 'app_exception'
),
uninstall_7d AS (
      SELECT DISTINCT f.user_pseudo_id, f.first_open_date
      FROM first_open f
      JOIN uninstall u USING (user_pseudo_id)
      WHERE DATE_DIFF(u.uninstall_date, f.first_open_date, DAY) BETWEEN 0 AND 7
),
uninstall_7d_and_crash AS (
      SELECT DISTINCT u.user_pseudo_id
      FROM uninstall_7d u
      JOIN crash c USING (user_pseudo_id)
      WHERE DATE_DIFF(c.crash_date, u.first_open_date, DAY) BETWEEN 0 AND 7
)
SELECT
  (SELECT COUNT(*) FROM uninstall_7d_and_crash)  AS users_with_crash,
  (SELECT COUNT(*) FROM uninstall_7d)            AS uninstall_7d_users,
  SAFE_DIVIDE( (SELECT COUNT(*) FROM uninstall_7d_and_crash),
               (SELECT COUNT(*) FROM uninstall_7d) ) AS crash_percentage
LIMIT 20;   -- 1 summary row
```

Each successive query builds toward the requested metric while showing the relevant intermediate pieces of data.
