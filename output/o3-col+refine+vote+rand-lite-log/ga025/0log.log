```sql
--Description / Thinking process:
-- 1. Build a cohort of users whose FIRST-EVER `first_open` happened in September-2018.
-- 2. Find those users’ FIRST `app_remove` (uninstall) event that occurs
--    from Sep-2018 through early-Oct-2018 and keep them only if it happened
--    within 7 days (<= 7) after the first_open date.
-- 3. Collect all users who triggered at least one `app_exception`
--    (crash) during the same Sep-2018 and early-Oct-2018 window.
-- 4. Calculate:
--      • denominator = users that uninstalled within 7 days
--      • numerator   = of those, the users that also crashed
--      • percentage  = numerator / denominator * 100
WITH
sept_cohort AS (               -- Step-1
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_open_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE event_name = 'first_open'
  GROUP BY user_pseudo_id
),
early_uninstalls AS (          -- Step-2
  SELECT
    sc.user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d', un.event_date)) AS uninstall_date
  FROM sept_cohort sc
  JOIN (
        SELECT user_pseudo_id, event_date
        FROM `firebase-public-project.analytics_153293282.events_201809*`
        WHERE event_name = 'app_remove'
        UNION ALL
        SELECT user_pseudo_id, event_date
        FROM `firebase-public-project.analytics_153293282.events_2018100*`
        WHERE event_name = 'app_remove'
       ) un
  ON sc.user_pseudo_id = un.user_pseudo_id
  GROUP BY sc.user_pseudo_id, sc.first_open_date
  HAVING DATE_DIFF(uninstall_date, sc.first_open_date, DAY) BETWEEN 0 AND 7
),
crash_users AS (               -- Step-3
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE event_name = 'app_exception'
  UNION DISTINCT
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_2018100*`
  WHERE event_name = 'app_exception'
)
SELECT                         -- Step-4
  COUNT(DISTINCT eu.user_pseudo_id)                         AS total_uninstalls_le_7d,
  COUNT(DISTINCT cu.user_pseudo_id)                         AS crashed_and_uninstalled_le_7d,
  SAFE_DIVIDE(COUNT(DISTINCT cu.user_pseudo_id),
              COUNT(DISTINCT eu.user_pseudo_id)) * 100      AS pct_uninstalled_with_crash
FROM early_uninstalls eu
LEFT JOIN crash_users cu
ON eu.user_pseudo_id = cu.user_pseudo_id;
