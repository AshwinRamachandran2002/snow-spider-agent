-- 7. Find the first uninstall for those cohort users (Sept & early-Oct), keep only if ≤7 days
WITH sept_cohort AS (
  SELECT  fo.`user_pseudo_id`,
          MIN(PARSE_DATE('%Y%m%d', fo.`event_date`)) AS first_open_date
  FROM    `firebase-public-project.analytics_153293282.events_201809*` fo
  WHERE   fo.`event_name` = 'first_open'
  GROUP BY fo.`user_pseudo_id`
)
SELECT sc.`user_pseudo_id`,
       sc.first_open_date,
       MIN(PARSE_DATE('%Y%m%d', un.`event_date`)) AS uninstall_date,
       DATE_DIFF(MIN(PARSE_DATE('%Y%m%d', un.`event_date`)), sc.first_open_date, DAY) AS days_to_uninstall
FROM   sept_cohort                           sc
JOIN   (
        SELECT `user_pseudo_id`, `event_date`
        FROM   `firebase-public-project.analytics_153293282.events_201809*`
        WHERE  `event_name` = 'app_remove'
        UNION ALL
        SELECT `user_pseudo_id`, `event_date`
        FROM   `firebase-public-project.analytics_153293282.events_2018100*`
        WHERE  `event_name` = 'app_remove'
       )                                       un
ON     sc.`user_pseudo_id` = un.`user_pseudo_id`
GROUP BY sc.`user_pseudo_id`, sc.first_open_date
HAVING  DATE_DIFF(uninstall_date, first_open_date, DAY) BETWEEN 0 AND 7
LIMIT 20;
