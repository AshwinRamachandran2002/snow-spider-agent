```sql
-- 6. Create the Sept-2018 cohort: users whose very FIRST “first_open” is in Sept-2018
SELECT  fo.`user_pseudo_id`,
        MIN(PARSE_DATE('%Y%m%d', fo.`event_date`)) AS first_open_date
FROM    `firebase-public-project.analytics_153293282.events_201809*`   fo
WHERE   fo.`event_name` = 'first_open'
GROUP BY fo.`user_pseudo_id`
LIMIT 20;
```

```sql
-- 7. Find the first uninstall for those cohort users (Sept & early-Oct), keep only if ≤7 days
WITH sept_cohort AS (
  SELECT  fo.`user_pseudo_id`,
          MIN(PARSE_DATE('%Y%m%d', fo.`event_date`)) AS first_open_date
  FROM    `firebase-public-project.analytics_153293282.events_201809*` fo
  WHERE   fo.`event_name` = 'first_open'
  GROUP BY fo.`user_pseudo_id`
)
SELECT sc.`user_pseudo_id`,
       sc.first_open_date,
       MIN(PARSE_DATE('%Y%m%d', un.`event_date`)) AS uninstall_date,
       DATE_DIFF(MIN(PARSE_DATE('%Y%m%d', un.`event_date`)), sc.first_open_date, DAY) AS days_to_uninstall
FROM   sept_cohort                           sc
JOIN   (
        SELECT `user_pseudo_id`, `event_date`
        FROM   `firebase-public-project.analytics_153293282.events_201809*`
        WHERE  `event_name` = 'app_remove'
        UNION ALL
        SELECT `user_pseudo_id`, `event_date`
        FROM   `firebase-public-project.analytics_153293282.events_2018100*`
        WHERE  `event_name` = 'app_remove'
       )                                       un
ON     sc.`user_pseudo_id` = un.`user_pseudo_id`
GROUP BY sc.`user_pseudo_id`, sc.first_open_date
HAVING  DATE_DIFF(uninstall_date, first_open_date, DAY) BETWEEN 0 AND 7
LIMIT 20;
```

```sql
-- 8. Check which of those early-uninstalls ever logged a crash between open and uninstall
WITH sept_cohort AS (
  SELECT  fo.`user_pseudo_id`,
          MIN(PARSE_DATE('%Y%m%d', fo.`event_date`)) AS first_open_date
  FROM    `firebase-public-project.analytics_153293282.events_201809*` fo
  WHERE   fo.`event_name` = 'first_open'
  GROUP BY fo.`user_pseudo_id`
),
early_uninstalls AS (
  SELECT sc.`user_pseudo_id`,
         sc.first_open_date,
         MIN(PARSE_DATE('%Y%m%d', un.`event_date`)) AS uninstall_date
  FROM   sept_cohort sc
  JOIN   (
           SELECT `user_pseudo_id`, `event_date`
           FROM   `firebase-public-project.analytics_153293282.events_201809*`
           WHERE  `event_name` = 'app_remove'
           UNION ALL
           SELECT `user_pseudo_id`, `event_date`
           FROM   `firebase-public-project.analytics_153293282.events_2018100*`
           WHERE  `event_name` = 'app_remove'
         ) un
  ON   sc.`user_pseudo_id` = un.`user_pseudo_id`
  GROUP BY sc.`user_pseudo_id`, sc.first_open_date
  HAVING DATE_DIFF(uninstall_date, first_open_date, DAY) BETWEEN 0 AND 7
)
SELECT eu.`user_pseudo_id`
FROM   early_uninstalls eu
JOIN   (
          SELECT DISTINCT `user_pseudo_id`
          FROM   `firebase-public-project.analytics_153293282.events_201809*`
          WHERE  `event_name` = 'app_exception'
          UNION ALL
          SELECT DISTINCT `user_pseudo_id`
          FROM   `firebase-public-project.analytics_153293282.events_2018100*`
          WHERE  `event_name` = 'app_exception'
       ) crashes
ON     eu.`user_pseudo_id` = crashes.`user_pseudo_id`
LIMIT 20;
```

```sql
-- 9. Compute numerator & denominator: early-uninstalls vs those who also crashed
WITH sept_cohort AS (
  SELECT  fo.`user_pseudo_id`,
          MIN(PARSE_DATE('%Y%m%d', fo.`event_date`)) AS first_open_date
  FROM    `firebase-public-project.analytics_153293282.events_201809*` fo
  WHERE   fo.`event_name` = 'first_open'
  GROUP BY fo.`user_pseudo_id`
),
early_uninstalls AS (
  SELECT sc.`user_pseudo_id`,
         MIN(PARSE_DATE('%Y%m%d', un.`event_date`)) AS uninstall_date
  FROM   sept_cohort sc
  JOIN   (
           SELECT `user_pseudo_id`, `event_date`
           FROM   `firebase-public-project.analytics_153293282.events_201809*`
           WHERE  `event_name` = 'app_remove'
           UNION ALL
           SELECT `user_pseudo_id`, `event_date`
           FROM   `firebase-public-project.analytics_153293282.events_2018100*`
           WHERE  `event_name` = 'app_remove'
         ) un
  ON   sc.`user_pseudo_id` = un.`user_pseudo_id`
  GROUP BY sc.`user_pseudo_id`, sc.first_open_date
  HAVING DATE_DIFF(uninstall_date, sc.first_open_date, DAY) BETWEEN 0 AND 7
),
crash_users AS (
  SELECT DISTINCT `user_pseudo_id`
  FROM   `firebase-public-project.analytics_153293282.events_201809*`
  WHERE  `event_name` = 'app_exception'
  UNION DISTINCT
  SELECT DISTINCT `user_pseudo_id`
  FROM   `firebase-public-project.analytics_153293282.events_2018100*`
  WHERE  `event_name` = 'app_exception'
)
SELECT COUNT(DISTINCT eu.`user_pseudo_id`)                          AS total_uninstalls_≤7d,
       COUNT(DISTINCT cu.`user_pseudo_id`)                          AS crashed_and_uninstalled_≤7d
FROM   early_uninstalls eu
LEFT JOIN crash_users cu
ON     eu.`user_pseudo_id` = cu.`user_pseudo_id`;
```

```sql
-- 10. Final percentage of September-2018 new users who uninstalled in ≤7 days AND experienced a crash
WITH sept_cohort AS (
  SELECT  fo.`user_pseudo_id`,
          MIN(PARSE_DATE('%Y%m%d', fo.`event_date`)) AS first_open_date
  FROM    `firebase-public-project.analytics_153293282.events_201809*` fo
  WHERE   fo.`event_name` = 'first_open'
  GROUP BY fo.`user_pseudo_id`
),
early_uninstalls AS (
  SELECT sc.`user_pseudo_id`,
         MIN(PARSE_DATE('%Y%m%d', un.`event_date`)) AS uninstall_date
  FROM   sept_cohort sc
  JOIN   (
           SELECT `user_pseudo_id`, `event_date`
           FROM   `firebase-public-project.analytics_153293282.events_201809*`
           WHERE  `event_name` = 'app_remove'
           UNION ALL
           SELECT `user_pseudo_id`, `event_date`
           FROM   `firebase-public-project.analytics_153293282.events_2018100*`
           WHERE  `event_name` = 'app_remove'
         ) un
  ON   sc.`user_pseudo_id` = un.`user_pseudo_id`
  GROUP BY sc.`user_pseudo_id`, sc.first_open_date
  HAVING DATE_DIFF(uninstall_date, sc.first_open_date, DAY) BETWEEN 0 AND 7
),
crash_users AS (
  SELECT DISTINCT `user_pseudo_id`
  FROM   `firebase-public-project.analytics_153293282.events_201809*`
  WHERE  `event_name` = 'app_exception'
  UNION DISTINCT
  SELECT DISTINCT `user_pseudo_id`
  FROM   `firebase-public-project.analytics_153293282.events_2018100*`
  WHERE  `event_name` = 'app_exception'
)
SELECT
  COUNT(DISTINCT cu.`user_pseudo_id`) / COUNT(DISTINCT eu.`user_pseudo_id`) * 100 AS pct_uninstalled_with_crash
FROM   early_uninstalls eu
LEFT JOIN crash_users cu
       ON eu.`user_pseudo_id` = cu.`user_pseudo_id`;
```
