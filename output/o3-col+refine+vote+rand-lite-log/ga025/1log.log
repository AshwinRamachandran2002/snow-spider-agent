Query:
--Description: 7)  Keep only those uninstalls that happened within seven days of the first_open
SELECT *,
       DATE_DIFF(uninstall_date, first_open_date, DAY) AS days_to_uninstall
FROM (
      SELECT fo.user_pseudo_id,
             fo.first_open_date,
             MIN(DATE(TIMESTAMP_MICROS(er.event_timestamp))) AS uninstall_date
      FROM (
            SELECT `user_pseudo_id`,
                   MIN(DATE(TIMESTAMP_MICROS(event_timestamp))) AS first_open_date
            FROM `firebase-public-project.analytics_153293282.events_201809*`
            WHERE `event_name` = 'first_open'
            GROUP BY `user_pseudo_id`
           ) AS fo
      JOIN `firebase-public-project.analytics_153293282.events_201809*` AS er
        ON fo.user_pseudo_id = er.user_pseudo_id
      WHERE er.event_name = 'app_remove'
      GROUP BY fo.user_pseudo_id, fo.first_open_date
     )
WHERE DATE_DIFF(uninstall_date, first_open_date, DAY) <= 7
LIMIT 20;
