```sql
--Description: 7)  Keep only those uninstalls that happened within seven days of the first_open
SELECT *,
       DATE_DIFF(uninstall_date, first_open_date, DAY) AS days_to_uninstall
FROM (
      SELECT fo.user_pseudo_id,
             fo.first_open_date,
             MIN(DATE(TIMESTAMP_MICROS(er.event_timestamp))) AS uninstall_date
      FROM (
            SELECT `user_pseudo_id`,
                   MIN(DATE(TIMESTAMP_MICROS(event_timestamp))) AS first_open_date
            FROM `firebase-public-project.analytics_153293282.events_201809*`
            WHERE `event_name` = 'first_open'
            GROUP BY `user_pseudo_id`
           ) AS fo
      JOIN `firebase-public-project.analytics_153293282.events_201809*` AS er
        ON fo.user_pseudo_id = er.user_pseudo_id
      WHERE er.event_name = 'app_remove'
      GROUP BY fo.user_pseudo_id, fo.first_open_date
     )
WHERE DATE_DIFF(uninstall_date, first_open_date, DAY) <= 7
LIMIT 20;
```

```sql
--Description: 8)  Among those quick-uninstall users, show who experienced at least one crash
SELECT q.user_pseudo_id,
       q.first_open_date,
       q.uninstall_date
FROM (
      SELECT fo.user_pseudo_id,
             fo.first_open_date,
             MIN(DATE(TIMESTAMP_MICROS(er.event_timestamp))) AS uninstall_date
      FROM (
            SELECT `user_pseudo_id`,
                   MIN(DATE(TIMESTAMP_MICROS(event_timestamp))) AS first_open_date
            FROM `firebase-public-project.analytics_153293282.events_201809*`
            WHERE `event_name` = 'first_open'
            GROUP BY `user_pseudo_id`
           ) AS fo
      JOIN `firebase-public-project.analytics_153293282.events_201809*` AS er
        ON fo.user_pseudo_id = er.user_pseudo_id
      WHERE er.event_name = 'app_remove'
      GROUP BY fo.user_pseudo_id, fo.first_open_date
     ) AS q
JOIN `firebase-public-project.analytics_153293282.events_201809*` AS ce
  ON q.user_pseudo_id = ce.user_pseudo_id
WHERE DATE_DIFF(q.uninstall_date, q.first_open_date, DAY) <= 7
  AND ce.event_name = 'app_exception'
LIMIT 20;
```

```sql
--Description: 9)  Aggregate counts – total Sept-2018 users who uninstalled ≤7 days vs those that also crashed
WITH first_open AS (
  SELECT `user_pseudo_id`,
         MIN(DATE(TIMESTAMP_MICROS(event_timestamp))) AS first_open_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
),
uninstall AS (
  SELECT `user_pseudo_id`,
         MIN(DATE(TIMESTAMP_MICROS(event_timestamp))) AS uninstall_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'app_remove'
  GROUP BY `user_pseudo_id`
),
crash AS (
  SELECT DISTINCT `user_pseudo_id`
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'app_exception'
)
SELECT
  COUNT(DISTINCT quick.user_pseudo_id)                                       AS total_uninstall_within_7d,
  COUNT(DISTINCT CASE WHEN crash.user_pseudo_id IS NOT NULL 
                      THEN quick.user_pseudo_id END)                        AS uninstall_and_crash
FROM (
      SELECT fo.user_pseudo_id, fo.first_open_date, un.uninstall_date
      FROM first_open fo
      JOIN uninstall  un ON fo.user_pseudo_id = un.user_pseudo_id
      WHERE DATE_DIFF(un.uninstall_date, fo.first_open_date, DAY) <= 7
     ) AS quick
LEFT JOIN crash
       ON quick.user_pseudo_id = crash.user_pseudo_id
LIMIT 20;
```

```sql
--Description: 10)  FINAL answer – percentage of Sept-2018 new users who uninstalled ≤7 days **and** experienced a crash
WITH first_open AS (
  SELECT `user_pseudo_id`,
         MIN(DATE(TIMESTAMP_MICROS(event_timestamp))) AS first_open_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
),
uninstall AS (
  -- Include October tables so that late-September first opens can uninstall within 7 days in early October
  SELECT `user_pseudo_id`,
         MIN(DATE(TIMESTAMP_MICROS(event_timestamp))) AS uninstall_date
  FROM (
        SELECT * FROM `firebase-public-project.analytics_153293282.events_201809*`
        UNION ALL
        SELECT * FROM `firebase-public-project.analytics_153293282.events_201810*`
  )
  WHERE `event_name` = 'app_remove'
  GROUP BY `user_pseudo_id`
),
crash AS (
  SELECT DISTINCT `user_pseudo_id`
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'app_exception'
)
SELECT
  ROUND(100 * SAFE_DIVIDE(
            COUNT(DISTINCT CASE WHEN crash.user_pseudo_id IS NOT NULL 
                                THEN quick.user_pseudo_id END),
            COUNT(DISTINCT quick.user_pseudo_id)
        ), 2) AS pct_uninstall_with_crash
FROM (
      SELECT fo.user_pseudo_id, fo.first_open_date, un.uninstall_date
      FROM first_open fo
      JOIN uninstall  un ON fo.user_pseudo_id = un.user_pseudo_id
      WHERE DATE_DIFF(un.uninstall_date, fo.first_open_date, DAY) <= 7
     ) AS quick
LEFT JOIN crash
  ON quick.user_pseudo_id = crash.user_pseudo_id
LIMIT 20;
```

These ten progressively richer queries take you from simple inspection of September-2018 events through to the final calculation of the required percentage.
