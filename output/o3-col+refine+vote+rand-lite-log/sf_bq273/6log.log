```

```sql
--Description: 2) Inspect a handful of users that were sourced through Facebook.  
SELECT "id",
       "first_name",
       "last_name",
       "traffic_source",
       "created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
WHERE "traffic_source" ILIKE '%Facebook%'
LIMIT 20;
```

```sql
--Description: 3) Look at COMPLETE orders (status = 'Complete') that were created between August-2022 and November-2023 and belong to Facebook-sourced users.  
SELECT  o."order_id",
        o."user_id",
        o."status",
        o."created_at",
        TO_TIMESTAMP_NTZ(o."created_at"/1000000)   AS "created_ts"
FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"      o
JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"       u
       ON o."user_id" = u."id"
WHERE   u."traffic_source" ILIKE '%Facebook%'
  AND   o."status" = 'Complete'
  AND   TO_TIMESTAMP_NTZ(o."created_at"/1000000)::DATE BETWEEN '2022-08-01' AND '2023-11-30'
LIMIT 20;
```

```sql
--Description: 4) Pull the ORDER_ITEMS that belong to those same orders and are themselves marked as COMPLETE.  
SELECT  oi."order_id",
        oi."id"                  AS "order_item_id",
        oi."product_id",
        oi."inventory_item_id",
        oi."status",
        oi."sale_price"
FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
WHERE   oi."status" = 'Complete'
  AND   oi."order_id" IN (
          SELECT o."order_id"
          FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
          JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"  u
            ON   o."user_id" = u."id"
          WHERE  u."traffic_source" ILIKE '%Facebook%'
            AND  o."status" = 'Complete'
            AND  TO_TIMESTAMP_NTZ(o."created_at"/1000000)::DATE BETWEEN '2022-08-01' AND '2023-11-30'
       )
LIMIT 20;
```

```sql
--Description: 5) Join ORDER_ITEMS with INVENTORY_ITEMS to see sale price versus cost for a quick profit check.  
SELECT  oi."order_id",
        oi."order_id",
        oi."sale_price",
        ii."cost",
        (oi."sale_price" - ii."cost") AS "profit"
FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"     oi
JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" ii
       ON oi."inventory_item_id" = ii."id"
WHERE   oi."order_id" IN (
          SELECT o."order_id"
          FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
          JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"  u
            ON   o."user_id" = u."id"
          WHERE  u."traffic_source" ILIKE '%Facebook%'
            AND  o."status" = 'Complete'
            AND  TO_TIMESTAMP_NTZ(o."created_at"/1000000)::DATE BETWEEN '2022-08-01' AND '2023-11-30'
       )
LIMIT 20;
```

```sql
--Description: 6) Gather all Facebook-sourced COMPLETE order-items in the date window and compute profit for each (sale – cost).  
SELECT  oi."order_id",
        TO_TIMESTAMP_NTZ(o."delivered_at"/1000000) AS "delivered_ts",
        (oi."sale_price" - ii."cost")              AS "profit"
FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"          o
JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"     oi  ON o."order_id" = oi."order_id"
JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" ii  ON oi."inventory_item_id" = ii."id"
JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"           u   ON o."user_id" = u."id"
WHERE   u."traffic_source" ILIKE '%Facebook%'
  AND   o."status"  = 'Complete'
  AND   oi."status" = 'Complete'
  AND   TO_TIMESTAMP_NTZ(o."created_at"/1000000)::DATE BETWEEN '2022-08-01' AND '2023-11-30'
LIMIT 20;
```

```sql
--Description: 7) Aggregate to get total profit by delivery month for the qualified Facebook orders.  
SELECT  DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."delivered_at"/1000000)) AS "delivery_month",
        SUM(oi."sale_price" - ii."cost")                                AS "monthly_profit"
FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"          o
JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"     oi  ON o."order_id" = oi."order_id"
JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" ii  ON oi."inventory_item_id" = ii."id"
JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"           u   ON o."user_id" = u."id"
WHERE   u."traffic_source" ILIKE '%Facebook%'
  AND   o."status"  = 'Complete'
  AND   oi."status" = 'Complete'
  AND   TO_TIMESTAMP_NTZ(o."created_at"/1000000)::DATE BETWEEN '2022-08-01' AND '2023-11-30'
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 8) Compute month-over-month profit change and list the five months with the largest positive jump.  
WITH monthly AS (
    SELECT  DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."delivered_at"/1000000)) AS "delivery_month",
            SUM(oi."sale_price" - ii."cost")                                AS "monthly_profit"
    FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"          o
    JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"     oi  ON o."order_id" = oi."order_id"
    JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" ii  ON oi."inventory_item_id" = ii."id"
    JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"           u   ON o."user_id" = u."id"
    WHERE   u."traffic_source" ILIKE '%Facebook%'
      AND   o."status"  = 'Complete'
      AND   oi."status" = 'Complete'
      AND   TO_TIMESTAMP_NTZ(o."created_at"/1000000)::DATE BETWEEN '2022-08-01' AND '2023-11-30'
    GROUP BY 1
)
SELECT  m."delivery_month",
        m."monthly_profit",
        m."monthly_profit" - LAG(m."monthly_profit") OVER (ORDER BY m."delivery_month") AS "profit_mom_change"
FROM    monthly m
QUALIFY "profit_mom_change" IS NOT NULL
ORDER BY "profit_mom_change" DESC
LIMIT 5;
```

Each query progressively uncovers the information needed to identify the five months (Aug-2022 → Nov-2023) that experienced the greatest month-over-month profit growth from completed orders whose customers were acquired via Facebook.
