```

```sql
--Description: 2) Inspect a handful of USERS that came from Facebook  
SELECT *
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
WHERE "traffic_source" ILIKE '%Facebook%'
LIMIT 20;
```

```sql
--Description: 3) See all the different order STATUS values that can appear in ORDERS  
SELECT DISTINCT "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
LIMIT 20;
```

```sql
--Description: 4) Pull some “Complete” ORDERS created between Aug-2022 and Nov-2023 (micro-seconds epoch)  
SELECT *
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "status" = 'Complete'
  AND "created_at" BETWEEN 1659312000000000 AND 1701302399000000
LIMIT 20;
```

```sql
--Description: 5) Join ORDERS with USERS to make sure they are Facebook-sourced & in the required date window  
SELECT o."order_id",
       o."user_id",
       o."created_at",
       u."traffic_source"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"  o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"   u
  ON o."user_id" = u."id"
WHERE o."status" = 'Complete'
  AND u."traffic_source" = 'Facebook'
  AND o."created_at" BETWEEN 1659312000000000 AND 1701302399000000
LIMIT 20;
```

```sql
--Description: 6) Pick a sample of ORDER_ITEMS that belong to the qualified Facebook orders  
SELECT oi.*
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
WHERE oi."order_id" IN (
        SELECT DISTINCT o."order_id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
        JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"  u
          ON o."user_id" = u."id"
        WHERE o."status" = 'Complete'
          AND u."traffic_source" = 'Facebook'
          AND o."created_at" BETWEEN 1659312000000000 AND 1701302399000000
      )
LIMIT 20;
```

```sql
--Description: 7) Join ORDER_ITEMS to INVENTORY_ITEMS so we can see the COST that corresponds to each sale  
SELECT oi."order_id",
       oi."sale_price",
       ii."cost",
       (oi."sale_price" - ii."cost") AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
  ON oi."inventory_item_id" = ii."id"
WHERE oi."order_id" IN (
        SELECT DISTINCT o."order_id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
        JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"  u
          ON o."user_id" = u."id"
        WHERE o."status" = 'Complete'
          AND u."traffic_source" = 'Facebook'
          AND o."created_at" BETWEEN 1659312000000000 AND 1701302399000000
      )
LIMIT 20;
```

```sql
--Description: 8) Aggregate total PROFIT by the month an item was delivered (converted from micro-seconds)  
SELECT DATE_TRUNC('month',
                  TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000)) AS "delivery_month",
       SUM(oi."sale_price" - ii."cost")                     AS "monthly_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
  ON oi."inventory_item_id" = ii."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
  ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u
  ON o."user_id" = u."id"
WHERE o."status" = 'Complete'
  AND u."traffic_source" = 'Facebook'
  AND o."created_at" BETWEEN 1659312000000000 AND 1701302399000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 9) Add a window function to compare each month’s profit to the previous month (MoM change)  
SELECT "delivery_month",
       "monthly_profit",
       "monthly_profit"
       - LAG("monthly_profit") OVER (ORDER BY "delivery_month") AS "mom_change"
FROM (
      SELECT DATE_TRUNC('month',
                        TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000)) AS "delivery_month",
             SUM(oi."sale_price" - ii."cost")                     AS "monthly_profit"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
        ON oi."inventory_item_id" = ii."id"
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
        ON oi."order_id" = o."order_id"
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u
        ON o."user_id" = u."id"
      WHERE o."status" = 'Complete'
        AND u."traffic_source" = 'Facebook'
        AND o."created_at" BETWEEN 1659312000000000 AND 1701302399000000
      GROUP BY 1
     )
ORDER BY "delivery_month"
LIMIT 20;
```

```sql
--Description: 10) Return the five months (Aug-2022–Nov-2023) that posted the biggest MoM profit jumps  
WITH profits AS (
      SELECT DATE_TRUNC('month',
                        TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000)) AS "delivery_month",
             SUM(oi."sale_price" - ii."cost") AS "monthly_profit"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
        ON oi."inventory_item_id" = ii."id"
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
        ON oi."order_id" = o."order_id"
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u
        ON o."user_id" = u."id"
      WHERE o."status" = 'Complete'
        AND u."traffic_source" = 'Facebook'
        AND o."created_at" BETWEEN 1659312000000000 AND 1701302399000000
      GROUP BY 1
)
SELECT "delivery_month",
       "monthly_profit",
       "monthly_profit"
       - LAG("monthly_profit") OVER (ORDER BY "delivery_month") AS "mom_change"
FROM profits
ORDER BY "mom_change" DESC NULLS LAST
LIMIT 20;
```
