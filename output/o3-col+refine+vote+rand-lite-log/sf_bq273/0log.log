--Description: 7) Join ORDER_ITEMS to INVENTORY_ITEMS so we can see the COST that corresponds to each sale  
SELECT oi."order_id",
       oi."sale_price",
       ii."cost",
       (oi."sale_price" - ii."cost") AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
  ON oi."inventory_item_id" = ii."id"
WHERE oi."order_id" IN (
        SELECT DISTINCT o."order_id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
        JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"  u
          ON o."user_id" = u."id"
        WHERE o."status" = 'Complete'
          AND u."traffic_source" = 'Facebook'
          AND o."created_at" BETWEEN 1659312000000000 AND 1701302399000000
      )
LIMIT 20;
