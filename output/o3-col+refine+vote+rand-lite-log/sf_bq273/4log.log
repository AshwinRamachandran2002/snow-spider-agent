Query:
--Description: Join order-items to their parent orders to confirm both are “Complete / delivered” and to see gender & create dates.  
SELECT 
  oi."order_id",
  oi."user_id",
  oi."sale_price",
  oi."status"        AS "item_status",
  o."status"         AS "order_status",
