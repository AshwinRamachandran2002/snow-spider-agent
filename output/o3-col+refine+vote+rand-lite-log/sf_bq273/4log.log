```sql
--Description: Inspect users that arrived through Facebook to verify the “traffic_source” values.  
SELECT 
  u."id",
  u."traffic_source",
  u."created_at",
  u."country",
  u."state"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
WHERE u."traffic_source" ILIKE '%facebook%'
LIMIT 20;
```

```sql
--Description: Look at recent orders (raw micro-second timestamps) and their users to make sure date ranges line up with Aug-2022 – Nov-2023.  
SELECT 
  o."order_id",
  o."user_id",
  o."status",
  o."created_at",
  u."traffic_source"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
  ON o."user_id" = u."id"
WHERE o."created_at" BETWEEN 1659312000000000 /*2022-08-01*/ AND 1701302399000000 /*2023-11-30*/
  AND u."traffic_source" ILIKE '%facebook%'
LIMIT 20;
```

```sql
--Description: Preview “Complete” order-items that have already been delivered (non-NULL “delivered_at”).  
SELECT 
  oi."id"            AS "order_item_id",
  oi."order_id",
  oi."status",
  oi."created_at",
  oi."shipped_at",
  oi."delivered_at",
  oi."sale_price",
  oi."inventory_item_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
WHERE oi."status" = 'Complete'
  AND oi."delivered_at" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Join order-items to their parent orders to confirm both are “Complete / delivered” and to see gender & create dates.  
SELECT 
  oi."order_id",
  oi."user_id",
  oi."sale_price",
  oi."status"        AS "item_status",
  o."status"         AS "order_status",
  o."created_at",
  o."delivered_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
  ON oi."order_id" = o."order_id"
WHERE o."status" = 'Complete'
  AND oi."status" = 'Complete'
LIMIT 20;
```

```sql
--Description: Attach inventory costs to order-items so we can calculate profit (sale_price – cost).  
SELECT 
  oi."order_id",
  oi."inventory_item_id",
  oi."sale_price",
  ii."cost",
  (oi."sale_price" - ii."cost") AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
  ON oi."inventory_item_id" = ii."id"
WHERE oi."status" = 'Complete'
LIMIT 20;
```

```sql
--Description: Verify that the inventory record’s distribution center can be joined later if needed.  
SELECT DISTINCT
  ii."product_distribution_center_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
LIMIT 20;
```

```sql
--Description: First quick monthly profit aggregation (using micro-second division to get DATE) for Facebook traffic only, Aug-2022 – Nov-2023.  
SELECT 
  DATE_TRUNC('month', TO_TIMESTAMP_LTZ(o."delivered_at", 6)) AS "delivery_month",
  SUM(oi."sale_price" - ii."cost")                           AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
  ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u
  ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
  ON oi."inventory_item_id" = ii."id"
WHERE o."status" = 'Complete'
  AND oi."status" = 'Complete'
  AND u."traffic_source" ILIKE '%facebook%'
  AND o."created_at" BETWEEN 1659312000000000 AND 1701302399000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Compute month-over-month profit change to inspect increases (CTE style).  
WITH m AS (
  SELECT 
    DATE_TRUNC('month', TO_TIMESTAMP_LTZ(o."delivered_at", 6)) AS "month",
    SUM(oi."sale_price" - ii."cost")                           AS "profit"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
    ON oi."order_id" = o."order_id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u
    ON o."user_id" = u."id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
    ON oi."inventory_item_id" = ii."id"
  WHERE o."status" = 'Complete'
    AND oi."status" = 'Complete'
    AND u."traffic_source" ILIKE '%facebook%'
    AND o."created_at" BETWEEN 1659312000000000 AND 1701302399000000
  GROUP BY 1
)
SELECT 
  m."month",
  m."profit",
  (m."profit" - LAG(m."profit") OVER (ORDER BY m."month")) AS "profit_increase"
FROM m
ORDER BY m."month"
LIMIT 20;
```

```sql
--Description: Pull the five months with the largest positive MoM profit increases (final check before reporting).  
WITH m AS (
  SELECT 
    DATE_TRUNC('month', TO_TIMESTAMP_LTZ(o."delivered_at", 6)) AS "month",
    SUM(oi."sale_price" - ii."cost")                           AS "profit"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
    ON oi."order_id" = o."order_id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u
    ON o."user_id" = u."id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
    ON oi."inventory_item_id" = ii."id"
  WHERE o."status" = 'Complete'
    AND oi."status" = 'Complete'
    AND u."traffic_source" ILIKE '%facebook%'
    AND o."created_at" BETWEEN 1659312000000000 AND 1701302399000000
  GROUP BY 1
)
SELECT 
  m."month",
  m."profit",
  (m."profit" - LAG(m."profit") OVER (ORDER BY m."month")) AS "profit_increase"
FROM m
ORDER BY "profit_increase" DESC NULLS LAST
LIMIT 5;
```

```sql
--Description: Quick sanity-check of sample rows that contribute to the single largest monthly increase above.  
SELECT 
  oi."order_id",
  oi."sale_price",
  ii."cost",
  (oi."sale_price" - ii."cost")  AS "profit",
  TO_TIMESTAMP_LTZ(o."delivered_at", 6) AS "delivered_ts",
  u."traffic_source"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
  ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u
  ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
  ON oi."inventory_item_id" = ii."id"
WHERE o."status" = 'Complete'
  AND oi."status" = 'Complete'
  AND u."traffic_source" ILIKE '%facebook%'
  AND DATE_TRUNC('month', TO_TIMESTAMP_LTZ(o."delivered_at", 6)) = (
        /* replace with the month pulled at the top of the list, e.g. '2023-05-01' */
        '2023-05-01'::DATE
      )
LIMIT 20;
```
