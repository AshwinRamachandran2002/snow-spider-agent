```sql
--Description: Join ORDER_ITEMS to PRODUCTS to see how profit (sale_price-cost) can be calculated for completed items
SELECT oi."id",
       oi."order_id",
       oi."user_id",
       oi."sale_price",
       p."cost",
       (oi."sale_price" - p."cost") AS "profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
WHERE  oi."status" ILIKE '%Complete%'
LIMIT 20;
```

```sql
--Description: Sample Facebook-sourced, completed items created 2022-08-01 to 2023-11-30 with created & delivered timestamps
SELECT oi."id",
       oi."order_id",
       oi."user_id",
       oi."sale_price",
       p."cost",
       (oi."sale_price" - p."cost") AS "profit",
       TO_TIMESTAMP_NTZ(oi."created_at"   / 1000000) AS "created_ts",
       TO_TIMESTAMP_NTZ(oi."delivered_at" / 1000000) AS "delivered_ts"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u
       ON oi."user_id"    = u."id"
WHERE  u."traffic_source" ILIKE '%Facebook%'
  AND  oi."status"        ILIKE '%Complete%'
  AND  TO_TIMESTAMP_NTZ(oi."created_at"/1000000) BETWEEN '2022-08-01' AND '2023-11-30'
LIMIT 20;
```

```sql
--Description: Monthly profit (sales-cost) by delivery month for the required Facebook-sourced, completed items
SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000)) AS "delivery_month",
       SUM(oi."sale_price" - p."cost")                                   AS "profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u
       ON oi."user_id"    = u."id"
WHERE  u."traffic_source" ILIKE '%Facebook%'
  AND  oi."status"        ILIKE '%Complete%'
  AND  TO_TIMESTAMP_NTZ(oi."created_at"/1000000) BETWEEN '2022-08-01' AND '2023-11-30'
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Compute profit together with month-over-month change for each delivery month
SELECT "delivery_month",
       "profit",
       "profit" - LAG("profit") OVER (ORDER BY "delivery_month") AS "mom_increase"
FROM  (
        SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000)) AS "delivery_month",
               SUM(oi."sale_price" - p."cost")                                   AS "profit"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
        JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
               ON oi."product_id" = p."id"
        JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u
               ON oi."user_id"    = u."id"
        WHERE  u."traffic_source" ILIKE '%Facebook%'
          AND  oi."status"        ILIKE '%Complete%'
          AND  TO_TIMESTAMP_NTZ(oi."created_at"/1000000) BETWEEN '2022-08-01' AND '2023-11-30'
        GROUP BY 1
      ) t
ORDER BY "mom_increase" DESC NULLS LAST
LIMIT 20;
```

```sql
--Description: Top 5 delivery months that experienced the largest month-over-month profit increase
SELECT "delivery_month",
       "profit",
       "mom_increase"
FROM (
      SELECT "delivery_month",
             "profit",
             "profit" - LAG("profit") OVER (ORDER BY "delivery_month") AS "mom_increase"
      FROM (
            SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000)) AS "delivery_month",
                   SUM(oi."sale_price" - p."cost") AS "profit"
            FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
            JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
                   ON oi."product_id" = p."id"
            JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u
                   ON oi."user_id"    = u."id"
            WHERE  u."traffic_source" ILIKE '%Facebook%'
              AND  oi."status"        ILIKE '%Complete%'
              AND  TO_TIMESTAMP_NTZ(oi."created_at"/1000000) BETWEEN '2022-08-01' AND '2023-11-30'
            GROUP BY 1
          )
     )
WHERE "mom_increase" IS NOT NULL
ORDER BY "mom_increase" DESC
LIMIT 5;
```

