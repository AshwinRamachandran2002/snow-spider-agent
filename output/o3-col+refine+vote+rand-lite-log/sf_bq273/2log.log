```

```sql
--Description: List the different status values that ORDER_ITEMS can take
SELECT DISTINCT "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
LIMIT 20;
```

```sql
--Description: Inspect a few completed order-item rows (status = 'Complete')
SELECT "id", "order_id", "user_id", "product_id", "inventory_item_id",
       "sale_price", "created_at", "shipped_at", "delivered_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
WHERE "status" = 'Complete'
LIMIT 20;
```

```sql
--Description: Join ORDER_ITEMS to ORDERS to see how order and delivery dates relate (converted to timestamps)
SELECT oi."order_id",
       TO_TIMESTAMP_LTZ(o."created_at"/1000000)  AS "order_created_ts",
       TO_TIMESTAMP_LTZ(oi."delivered_at"/1000000) AS "delivered_ts",
       oi."sale_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
      ON oi."order_id" = o."order_id"
WHERE oi."status" = 'Complete'
LIMIT 20;
```

```sql
--Description: Bring users into the previous join to confirm an example Facebook-sourced completed order
SELECT oi."order_id", u."id" AS "user_id", u."traffic_source",
       TO_TIMESTAMP_LTZ(oi."delivered_at"/1000000) AS "delivered_ts",
       oi."sale_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"        u
      ON oi."user_id" = u."id"
WHERE oi."status" = 'Complete'
  AND u."traffic_source" = 'Facebook'
LIMIT 20;
```

```sql
--Description: Join ORDER_ITEMS to INVENTORY_ITEMS to obtain unit cost together with sale_price
SELECT oi."order_id", oi."inventory_item_id",
       ii."cost", oi."sale_price",
       (oi."sale_price" - ii."cost") AS "profit_sample"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
      ON oi."inventory_item_id" = ii."id"
WHERE oi."status" = 'Complete'
LIMIT 20;
```

```sql
--Description: Compute monthly profit (sales – cost) for Facebook-sourced completed orders created Aug 2022–Nov 2023
SELECT DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."delivered_at"/1000000)) AS "delivery_month",
       SUM(oi."sale_price" - ii."cost")                                AS "monthly_profit"
FROM  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u   ON oi."user_id" = u."id"
JOIN  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii  ON oi."inventory_item_id" = ii."id"
JOIN  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o   ON oi."order_id" = o."order_id"
WHERE oi."status" = 'Complete'
  AND u."traffic_source" = 'Facebook'
  AND TO_TIMESTAMP_LTZ(o."created_at"/1000000) >= '2022-08-01'
  AND TO_TIMESTAMP_LTZ(o."created_at"/1000000) <  '2023-12-01'
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: From the monthly profit result, calculate month-over-month profit increase
WITH monthly AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."delivered_at"/1000000)) AS "delivery_month",
           SUM(oi."sale_price" - ii."cost") AS "monthly_profit"
    FROM  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
    JOIN  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u  ON oi."user_id" = u."id"
    JOIN  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii ON oi."inventory_item_id" = ii."id"
    JOIN  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o  ON oi."order_id" = o."order_id"
    WHERE oi."status" = 'Complete'
      AND u."traffic_source" = 'Facebook'
      AND TO_TIMESTAMP_LTZ(o."created_at"/1000000) >= '2022-08-01'
      AND TO_TIMESTAMP_LTZ(o."created_at"/1000000) <  '2023-12-01'
    GROUP BY 1
)
SELECT m."delivery_month",
       m."monthly_profit",
       m."monthly_profit" - LAG(m."monthly_profit") OVER(ORDER BY m."delivery_month") AS "profit_increase"
FROM monthly m
ORDER BY "profit_increase" DESC NULLS LAST
LIMIT 20;
```

```sql
--Description: Return the 5 months with the largest positive month-over-month profit jumps
WITH monthly AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."delivered_at"/1000000)) AS "delivery_month",
           SUM(oi."sale_price" - ii."cost") AS "monthly_profit"
    FROM  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
    JOIN  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u  ON oi."user_id" = u."id"
    JOIN  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii ON oi."inventory_item_id" = ii."id"
    JOIN  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o  ON oi."order_id" = o."order_id"
    WHERE oi."status" = 'Complete'
      AND u."traffic_source" = 'Facebook'
      AND TO_TIMESTAMP_LTZ(o."created_at"/1000000) >= '2022-08-01'
      AND TO_TIMESTAMP_LTZ(o."created_at"/1000000) <  '2023-12-01'
    GROUP BY 1
),
diffs AS (
    SELECT m.*,
           m."monthly_profit" - LAG(m."monthly_profit") OVER(ORDER BY m."delivery_month") AS "profit_increase"
    FROM monthly m
)
SELECT "delivery_month", "monthly_profit", "profit_increase"
FROM diffs
ORDER BY "profit_increase" DESC NULLS LAST
LIMIT 5;
```
