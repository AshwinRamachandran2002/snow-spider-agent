```

```sql
--Description: Look at a sample of completed ORDER_ITEMS delivered between Aug-2022 and Nov-2023.  
SELECT "id",
       "order_id",
       "user_id",
       "product_id",
       "sale_price",
       "created_at",
       "delivered_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
WHERE "status" = 'Complete'
      AND "created_at" BETWEEN 1660000000000000   -- ≈ 2022-08-01
                          AND 1701302399000000   -- ≈ 2023-11-30
LIMIT 20;
```

```sql
--Description: Join ORDER_ITEMS with USERS to keep only Facebook-sourced, completed order lines (sample).  
SELECT oi."id",
       oi."order_id",
       oi."user_id",
       oi."product_id",
       oi."sale_price",
       u."traffic_source"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"        u
     ON oi."user_id" = u."id"
WHERE oi."status" = 'Complete'
      AND u."traffic_source" ILIKE '%facebook%'
      AND oi."created_at" BETWEEN 1660000000000000 AND 1701302399000000
LIMIT 20;
```

```sql
--Description: Attach product cost to those Facebook-sourced completed order lines.  
SELECT oi."id",
       oi."product_id",
       p."cost"                    AS "product_cost",
       oi."sale_price",
       (oi."sale_price" - p."cost") AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"        u
     ON oi."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
     ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
      AND u."traffic_source" ILIKE '%facebook%'
      AND oi."created_at" BETWEEN 1660000000000000 AND 1701302399000000
LIMIT 20;
```

```sql
--Description: Compute total profit per delivery month for Facebook-sourced completed orders.  
SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."delivered_at" / 1000000), 'YYYY-MM') AS "delivery_month",
       SUM(oi."sale_price" - p."cost")                                    AS "monthly_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"        u
     ON oi."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
     ON oi."product_id" = p."id"
WHERE oi."status"    = 'Complete'
      AND u."traffic_source" ILIKE '%facebook%'
      AND oi."created_at" BETWEEN 1660000000000000 AND 1701302399000000
      AND oi."delivered_at" IS NOT NULL
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Add a window function to see month-over-month profit change.  
SELECT "delivery_month",
       "monthly_profit",
       "monthly_profit" - LAG("monthly_profit") OVER (ORDER BY "delivery_month") AS "mom_change"
FROM (
      SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."delivered_at" / 1000000), 'YYYY-MM') AS "delivery_month",
             SUM(oi."sale_price" - p."cost")                                    AS "monthly_profit"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"        u
           ON oi."user_id" = u."id"
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
           ON oi."product_id" = p."id"
      WHERE oi."status"    = 'Complete'
            AND u."traffic_source" ILIKE '%facebook%'
            AND oi."created_at" BETWEEN 1660000000000000 AND 1701302399000000
            AND oi."delivered_at" IS NOT NULL
      GROUP BY 1
     )
ORDER BY "delivery_month"
LIMIT 20;
```

```sql
--Description: Retrieve the five months with the largest positive month-over-month profit increases.  
SELECT *
FROM (
      SELECT "delivery_month",
             "monthly_profit",
             "mom_change"
      FROM (
            SELECT "delivery_month",
                   "monthly_profit",
                   "monthly_profit" - LAG("monthly_profit") OVER (ORDER BY "delivery_month") AS "mom_change"
            FROM (
                  SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."delivered_at" / 1000000), 'YYYY-MM') AS "delivery_month",
                         SUM(oi."sale_price" - p."cost")                                    AS "monthly_profit"
                  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
                  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"        u
                       ON oi."user_id" = u."id"
                  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
                       ON oi."product_id" = p."id"
                  WHERE oi."status"    = 'Complete'
                        AND u."traffic_source" ILIKE '%facebook%'
                        AND oi."created_at" BETWEEN 1660000000000000 AND 1701302399000000
                        AND oi."delivered_at" IS NOT NULL
                  GROUP BY 1
                 )
           )
     )
ORDER BY "mom_change" DESC
LIMIT 5;
```

```sql
--Description: (Optional) Display the underlying orders contributing to the month with the largest MoM jump for validation.  
SELECT oi."order_id",
       oi."user_id",
       oi."product_id",
       oi."sale_price",
       p."cost",
       (oi."sale_price" - p."cost") AS "profit",
       TO_CHAR(TO_TIMESTAMP_NTZ(oi."delivered_at" / 1000000), 'YYYY-MM') AS "delivery_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"        u
     ON oi."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
     ON oi."product_id" = p."id"
WHERE oi."status"    = 'Complete'
      AND u."traffic_source" ILIKE '%facebook%'
      AND oi."created_at" BETWEEN 1660000000000000 AND 1701302399000000
      AND oi."delivered_at" IS NOT NULL
      AND TO_CHAR(TO_TIMESTAMP_NTZ(oi."delivered_at" / 1000000), 'YYYY-MM') = '2023-??'    -- replace with month from previous query
LIMIT 20;
```
