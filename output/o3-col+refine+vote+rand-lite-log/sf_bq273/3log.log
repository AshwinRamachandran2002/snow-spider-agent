  AND   o."status" = 'Complete'
LIMIT  20;
```

```sql
-- 3. Description:  Take some Facebook-sourced completed order-items (with their sale price)
SELECT  oi."id"               AS "order_item_id",
        oi."order_id",
        oi."sale_price",
        oi."delivered_at",
        oi."inventory_item_id"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
       ON oi."order_id" = o."order_id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"        u
       ON o."user_id" = u."id"
WHERE   u."traffic_source" ILIKE '%Facebook%'
  AND   oi."status" = 'Complete'
LIMIT  20;
```

```sql
-- 4. Description:  Add the item cost coming from INVENTORY_ITEMS to compute profit per row
SELECT  oi."id"               AS "order_item_id",
        oi."sale_price",
        ii."cost",
        (oi."sale_price" - ii."cost")  AS "profit"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
       ON oi."inventory_item_id" = ii."id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
       ON oi."order_id" = o."order_id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u
       ON o."user_id" = u."id"
WHERE   u."traffic_source" ILIKE '%Facebook%'
  AND   oi."status" = 'Complete'
LIMIT  20;
```

```sql
-- 5. Description:  Show profit together with the month when it was delivered
SELECT  DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."delivered_at" / 1000000))  AS "delivery_month",
        (oi."sale_price" - ii."cost")                                       AS "profit"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
       ON oi."inventory_item_id" = ii."id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
       ON oi."order_id" = o."order_id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u
       ON o."user_id" = u."id"
WHERE   u."traffic_source" ILIKE '%Facebook%'
  AND   oi."status" = 'Complete'
  AND   TO_TIMESTAMP_LTZ(o."created_at" / 1000000)
        BETWEEN '2022-08-01' AND '2023-11-30'
LIMIT  20;
```

```sql
-- 6. Description:  Aggregate total monthly profit (Facebook-sourced, created in the period)
SELECT  DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."delivered_at" / 1000000))  AS "delivery_month",
        SUM(oi."sale_price" - ii."cost")                                    AS "monthly_profit"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
       ON oi."inventory_item_id" = ii."id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
       ON oi."order_id" = o."order_id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u
       ON o."user_id" = u."id"
WHERE   u."traffic_source" ILIKE '%Facebook%'
  AND   oi."status" = 'Complete'
  AND   TO_TIMESTAMP_LTZ(o."created_at" / 1000000)
        BETWEEN '2022-08-01' AND '2023-11-30'
GROUP BY 1
ORDER BY 1
LIMIT  20;
```

```sql
-- 7. Description:  Compute each month’s MoM profit increase
WITH monthly AS (
    SELECT  DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."delivered_at" / 1000000))  AS "delivery_month",
            SUM(oi."sale_price" - ii."cost")                                    AS "monthly_profit"
    FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
    JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
           ON oi."inventory_item_id" = ii."id"
    JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
           ON oi."order_id" = o."order_id"
    JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u
           ON o."user_id" = u."id"
    WHERE   u."traffic_source" ILIKE '%Facebook%'
      AND   oi."status" = 'Complete'
      AND   TO_TIMESTAMP_LTZ(o."created_at" / 1000000)
            BETWEEN '2022-08-01' AND '2023-11-30'
    GROUP BY 1
)
SELECT  m."delivery_month",
        m."monthly_profit",
        (m."monthly_profit" - LAG(m."monthly_profit") OVER (ORDER BY m."delivery_month"))  AS "mom_increase"
FROM    monthly m
ORDER BY m."delivery_month"
LIMIT  20;
```

```sql
-- 8. Description:  List the TOP-5 months (Aug-2022 – Nov-2023) with the largest MoM profit jump
WITH monthly AS (
    SELECT  DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."delivered_at" / 1000000))  AS "delivery_month",
            SUM(oi."sale_price" - ii."cost")                                    AS "monthly_profit"
    FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
    JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
           ON oi."inventory_item_id" = ii."id"
    JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
           ON oi."order_id" = o."order_id"
    JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u
           ON o."user_id" = u."id"
    WHERE   u."traffic_source" ILIKE '%Facebook%'
      AND   oi."status" = 'Complete'
      AND   TO_TIMESTAMP_LTZ(o."created_at" / 1000000)
            BETWEEN '2022-08-01' AND '2023-11-30'
    GROUP BY 1
),
diffs AS (
    SELECT  m.*,
            (m."monthly_profit" - LAG(m."monthly_profit") OVER (ORDER BY m."delivery_month")) 
              AS "mom_increase"
    FROM    monthly m
)
SELECT  "delivery_month",
        "monthly_profit",
        "mom_increase"
FROM    diffs
ORDER BY "mom_increase" DESC NULLS LAST
LIMIT  5;
```

```sql
-- 9. Description:  (Optional) Inspect the raw rows for the single best month to cross-check numbers
SELECT  oi."order_id",
        oi."sale_price",
        ii."cost",
        (oi."sale_price" - ii."cost") AS "profit",
        TO_TIMESTAMP_LTZ(oi."delivered_at" / 1000000)  AS "delivered_ts"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
       ON oi."inventory_item_id" = ii."id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
       ON oi."order_id" = o."order_id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u
       ON o."user_id" = u."id"
WHERE   u."traffic_source" ILIKE '%Facebook%'
  AND   oi."status" = 'Complete'
  AND   TO_CHAR(
          DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."delivered_at" / 1000000)),
          'YYYY-MM'
        ) = (
          SELECT TO_CHAR("delivery_month", 'YYYY-MM')
          FROM (
               SELECT  "delivery_month",
                       ( "monthly_profit"
                         - LAG("monthly_profit") OVER (ORDER BY "delivery_month")
                       ) AS diff
               FROM   (
                      SELECT DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi2."delivered_at" / 1000000)) AS "delivery_month",
                             SUM(oi2."sale_price" - ii2."cost") AS "monthly_profit"
                      FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi2
                      JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii2
                             ON oi2."inventory_item_id" = ii2."id"
                      JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"         o2
                             ON oi2."order_id" = o2."order_id"
                      JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"          u2
                             ON o2."user_id" = u2."id"
                      WHERE  u2."traffic_source" ILIKE '%Facebook%'
                        AND  oi2."status" = 'Complete'
                        AND  TO_TIMESTAMP_LTZ(o2."created_at" / 1000000)
                             BETWEEN '2022-08-01' AND '2023-11-30'
                      GROUP BY 1
               ) x
          ) y
          ORDER BY diff DESC NULLS LAST
          LIMIT 1
        )
LIMIT 20;
```

```sql
-- 10. Description:  (Final) Provide the concise result set again for reporting
WITH monthly AS (
    SELECT  DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."delivered_at" / 1000000))  AS "delivery_month",
            SUM(oi."sale_price" - ii."cost")                                    AS "monthly_profit"
    FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
    JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
           ON oi."inventory_item_id" = ii."id"
    JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
           ON oi."order_id" = o."order_id"
    JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u
           ON o."user_id" = u."id"
    WHERE   u."traffic_source" ILIKE '%Facebook%'
      AND   oi."status" = 'Complete'
      AND   TO_TIMESTAMP_LTZ(o."created_at" / 1000000)
            BETWEEN '2022-08-01' AND '2023-11-30'
    GROUP BY 1
),
diffs AS (
    SELECT  m.*,
            (m."monthly_profit" - LAG(m."monthly_profit") OVER (ORDER BY m."delivery_month")) 
              AS "mom_increase"
    FROM    monthly m
)
SELECT  "delivery_month",
        "monthly_profit",
        "mom_increase"
FROM    diffs
ORDER BY "mom_increase" DESC NULLS LAST
LIMIT  5;
```
