Query:
-- 9. Description:  (Optional) Inspect the raw rows for the single best month to cross-check numbers
SELECT  oi."order_id",
        oi."sale_price",
        ii."cost",
        (oi."sale_price" - ii."cost") AS "profit",
        TO_TIMESTAMP_LTZ(oi."delivered_at" / 1000000)  AS "delivered_ts"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
       ON oi."inventory_item_id" = ii."id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
       ON oi."order_id" = o."order_id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u
       ON o."user_id" = u."id"
WHERE   u."traffic_source" ILIKE '%Facebook%'
  AND   oi."status" = 'Complete'
  AND   TO_CHAR(
          DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."delivered_at" / 1000000)),
          'YYYY-MM'
        ) = (
          SELECT TO_CHAR("delivery_month", 'YYYY-MM')
          FROM (
               SELECT  "delivery_month",
                       ( "monthly_profit"
                         - LAG("monthly_profit") OVER (ORDER BY "delivery_month")
                       ) AS diff
               FROM   (
                      SELECT DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi2."delivered_at" / 1000000)) AS "delivery_month",
                             SUM(oi2."sale_price" - ii2."cost") AS "monthly_profit"
                      FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi2
                      JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii2
                             ON oi2."inventory_item_id" = ii2."id"
                      JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"         o2
                             ON oi2."order_id" = o2."order_id"
                      JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"          u2
                             ON o2."user_id" = u2."id"
                      WHERE  u2."traffic_source" ILIKE '%Facebook%'
                        AND  oi2."status" = 'Complete'
                        AND  TO_TIMESTAMP_LTZ(o2."created_at" / 1000000)
                             BETWEEN '2022-08-01' AND '2023-11-30'
                      GROUP BY 1
               ) x
          ) y
          ORDER BY diff DESC NULLS LAST
          LIMIT 1
        )
LIMIT 20;
