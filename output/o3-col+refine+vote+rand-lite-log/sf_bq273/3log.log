```

```sql
-- 2. Description:  See a few orders whose buyers’ traffic_source is Facebook
SELECT  o."order_id",
        o."status",
        u."traffic_source",
        o."created_at"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"   o
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"    u
       ON o."user_id" = u."id"
