```sql
--Description: 1) Peek at the different values that appear in the "traffic_source" 
--              column of the USERS table (helps confirm that 'Facebook' exists).
SELECT DISTINCT 
       "traffic_source"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
LIMIT  20;
```

```sql
--Description: 2) Inspect 20 recent ORDERS (descending by "created_at") to see  
--              status values and the relationship between order-time columns.
SELECT  "order_id",
        "user_id",
        "status",
        "created_at",
        "shipped_at",
        "delivered_at",
        "returned_at",
        "num_of_item"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
ORDER BY "created_at" DESC
LIMIT   20;
```

```sql
--Description: 3) Review 20 ORDER_ITEMS to understand price, status and linkage
--              to products / inventory.
SELECT  "id",
        "order_id",
        "product_id",
        "inventory_item_id",
        "status",
        "sale_price",
        "created_at",
        "shipped_at",
        "delivered_at"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
ORDER BY "created_at" DESC
LIMIT   20;
```

```sql
--Description: 4) Show 20 Facebook users together with a few fields so we know
--              which "user_id" rows should drive the later joins.
SELECT  "id"          AS "user_id",
        "first_name",
        "last_name",
        "traffic_source",
        "created_at"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
WHERE   "traffic_source" ILIKE '%facebook%'
ORDER BY "created_at" DESC
LIMIT   20;
```

```sql
--Description: 5) Join Facebook USERS → ORDERS to confirm how many orders fall
--              inside the date window (Aug-2022 .. Nov-2023) and are Complete.
SELECT  o."order_id",
        o."user_id",
        o."status",
        o."created_at"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"        o
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"         u
       ON o."user_id" = u."id"
WHERE   u."traffic_source" ILIKE '%facebook%'
  AND   o."status" = 'Complete'
  AND   o."created_at" BETWEEN 1659312000000000 AND 1701388799000000
ORDER BY o."created_at" DESC
LIMIT   20;
```

```sql
--Description: 6) Bring ORDER_ITEMS in to calculate item-level profit  
--              (sale_price − product cost pulled from INVENTORY_ITEMS).
SELECT  oi."id"                        AS "order_item_id",
        oi."order_id",
        ii."cost",
        oi."sale_price",
        (oi."sale_price" - ii."cost") AS "profit_per_item"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"       oi
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"   ii
       ON oi."inventory_item_id" = ii."id"
LIMIT   20;
```

```sql
--Description: 7) Aggregate item-level profit to order-level profit for  
--              Facebook Complete orders in the required date window.
SELECT  oi."order_id",
        SUM(oi."sale_price" - ii."cost") AS "order_profit"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"       oi
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"   ii
       ON oi."inventory_item_id" = ii."id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"            o
       ON oi."order_id" = o."order_id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"             u
       ON o."user_id" = u."id"
WHERE   u."traffic_source" ILIKE '%facebook%'
  AND   o."status" = 'Complete'
  AND   o."created_at" BETWEEN 1659312000000000 AND 1701388799000000
GROUP BY oi."order_id"
LIMIT   20;
```

```sql
--Description: 8) Roll the order-level profit up to delivery month (YYYY-MM) so
--              we can later compare month-over-month changes.
SELECT  TO_CHAR(TO_TIMESTAMP_NTZ(o."delivered_at"/1000000), 'YYYY-MM') 
            AS "delivery_month",
        SUM(oi."sale_price" - ii."cost") AS "month_profit"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
       ON oi."inventory_item_id" = ii."id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
       ON oi."order_id" = o."order_id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u
       ON o."user_id" = u."id"
WHERE   u."traffic_source" ILIKE '%facebook%'
  AND   o."status" = 'Complete'
  AND   o."created_at" BETWEEN 1659312000000000 AND 1701388799000000
GROUP BY TO_CHAR(TO_TIMESTAMP_NTZ(o."delivered_at"/1000000), 'YYYY-MM')
ORDER BY "delivery_month"
LIMIT   20;
```

```sql
--Description: 9) Calculate month-over-month profit change and keep rows that 
--              belong to Aug-2022 … Nov-2023.  Display biggest jumps first.
WITH month_profit AS (
    SELECT TO_CHAR(TO_TIMESTAMP_NTZ(o."delivered_at"/1000000), 'YYYY-MM') AS "delivery_month",
           SUM(oi."sale_price" - ii."cost")                                AS "profit"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
          ON oi."inventory_item_id" = ii."id"
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
          ON oi."order_id" = o."order_id"
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u
          ON o."user_id" = u."id"
    WHERE  u."traffic_source" ILIKE '%facebook%'
      AND  o."status" = 'Complete'
      AND  o."created_at" BETWEEN 1659312000000000 AND 1701388799000000
    GROUP  BY 1
)
SELECT  "delivery_month",
        "profit",
        ( "profit" - LAG("profit") OVER (ORDER BY "delivery_month") ) AS "profit_change"
FROM    month_profit
QUALIFY "delivery_month" BETWEEN '2022-08' AND '2023-11'
ORDER BY "profit_change" DESC
LIMIT   20;
```

```sql
--Description: 10) Finally retrieve the TOP-5 months (Aug-2022 … Nov-2023) that
--               posted the largest positive profit increase versus the prior
--               month for Facebook Complete orders.
WITH month_profit AS (
    SELECT TO_CHAR(TO_TIMESTAMP_NTZ(o."delivered_at"/1000000), 'YYYY-MM') AS "delivery_month",
           SUM(oi."sale_price" - ii."cost")                                AS "profit"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
          ON oi."inventory_item_id" = ii."id"
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
          ON oi."order_id" = o."order_id"
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u
          ON o."user_id" = u."id"
    WHERE  u."traffic_source" ILIKE '%facebook%'
      AND  o."status" = 'Complete'
      AND  o."created_at" BETWEEN 1659312000000000 AND 1701388799000000
    GROUP  BY 1
)
SELECT  "delivery_month",
        "profit",
        ( "profit" - LAG("profit") OVER (ORDER BY "delivery_month") ) AS "profit_change"
FROM    month_profit
QUALIFY "delivery_month" BETWEEN '2022-08' AND '2023-11'
ORDER BY "profit_change" DESC
LIMIT   5;
```
