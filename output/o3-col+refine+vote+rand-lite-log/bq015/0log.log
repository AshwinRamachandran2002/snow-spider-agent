```sql
--Description: 5) Join the mention-counts with the Stack Overflow rows so that
--              for every referenced question we have: id, #mentions, Tags.
WITH hn AS (
  SELECT
    REGEXP_EXTRACT(LOWER(text),
                   r'stackoverflow\.com/questions/([0-9]+)') AS question_id,
    COUNT(*) AS mentions
  FROM `fh-bigquery.hackernews.comments`
  WHERE time >= 1388534400
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
  GROUP BY question_id
)
SELECT
  CAST(hn.question_id AS INT64) AS question_id,
  hn.mentions,
  pq.Tags
FROM hn
JOIN `fh-bigquery.stackoverflow.posts_questions` AS pq
  ON pq.Id = CAST(hn.question_id AS INT64)
LIMIT 20;
```

```sql
--Description: 6) Split the Stack Overflow Tags string (pipe ‘|’ delimited)
--              into individual tags for a sample of questions, keeping the
--              mention count with each tag.
WITH hn AS (
  SELECT
    REGEXP_EXTRACT(LOWER(text),
                   r'stackoverflow\.com/questions/([0-9]+)') AS question_id,
    COUNT(*) AS mentions
  FROM `fh-bigquery.hackernews.comments`
  WHERE time >= 1388534400
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
  GROUP BY question_id
)
SELECT
  tag,
  hn.question_id,
  hn.mentions
FROM hn
JOIN `fh-bigquery.stackoverflow.posts_questions` AS pq
  ON pq.Id = CAST(hn.question_id AS INT64)
CROSS JOIN UNNEST(SPLIT(pq.Tags, '|')) AS tag
LIMIT 20;
```

```sql
--Description: 7) Aggregate the total number of Hacker News mentions for each
--              individual Stack Overflow tag (top 20 shown).
WITH hn AS (
  SELECT
    REGEXP_EXTRACT(LOWER(text),
                   r'stackoverflow\.com/questions/([0-9]+)') AS question_id,
    COUNT(*) AS mentions
  FROM `fh-bigquery.hackernews.comments`
  WHERE time >= 1388534400
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
  GROUP BY question_id
), tag_expanded AS (
  SELECT
    tag,
    hn.mentions
  FROM hn
  JOIN `fh-bigquery.stackoverflow.posts_questions` AS pq
    ON pq.Id = CAST(hn.question_id AS INT64)
  CROSS JOIN UNNEST(SPLIT(pq.Tags, '|')) AS tag
)
SELECT
  tag,
  SUM(mentions) AS total_mentions
FROM tag_expanded
GROUP BY tag
ORDER BY total_mentions DESC
LIMIT 20;
```

