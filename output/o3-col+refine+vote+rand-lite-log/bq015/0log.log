```sql
--Description / Thinking process:
-- 1. We are restricted to public tables, so we use:
--      • Hacker News comments → `fh-bigquery.hackernews.commentsV2`
--      • Stack Overflow questions → `bigquery-public-data.stackoverflow.posts_questions`
-- 2. Filter HN comments dated on/after 2014-01-01 (Unix time ≥ 1388534400) that
--    contain a Stack Overflow question URL (“stackoverflow.com/questions/…”).
-- 3. Extract the numeric `<question_id>` appearing immediately after
--    “…/questions/”.  Count how many comments reference each question (CTE `hn`).
-- 4. Join those ids with the SO questions table to obtain each question’s `Tags`
--    string.  In the public SO dataset this string looks like
--    “<python><pandas><dataframe>”.  We turn it into an array of individual tags
--    via `REGEXP_EXTRACT_ALL`, which grabs the text between the angle brackets.
--    (If the delimiter were “|” instead, we could simply use SPLIT; the regex
--    approach works for both formats.)
-- 5. Unnest the tag array so every (tag, question) pair is a row; sum the comment
--    counts across all questions that carry the same tag.
-- 6. Return the 10 tags that are referenced most often in HN comments.
WITH hn AS (
  SELECT
    CAST(REGEXP_EXTRACT(LOWER(text),
         r'stackoverflow\.com/questions/([0-9]+)') AS INT64) AS question_id,
    COUNT(*) AS mentions
  FROM `fh-bigquery.hackernews.commentsV2`
  WHERE time >= 1388534400                                    -- ≥ 2014-01-01
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
  GROUP BY question_id
  HAVING question_id IS NOT NULL
), tag_expanded AS (
  SELECT
    tag,
    hn.mentions
  FROM hn
  JOIN `bigquery-public-data.stackoverflow.posts_questions` AS pq
    ON pq.Id = hn.question_id
  -- Convert "<tag1><tag2>…" → ["tag1","tag2",…] and expand
  CROSS JOIN UNNEST(REGEXP_EXTRACT_ALL(pq.Tags, r'[^<>]+')) AS tag
)
SELECT
  tag,
  SUM(mentions) AS total_mentions
FROM tag_expanded
GROUP BY tag
ORDER BY total_mentions DESC
LIMIT 10;
```
