```sql
--Description / Thinking process:
-- Goal: Identify the 10 most-referenced Stack Overflow tags in Hacker News comments
--       posted from 2014-01-01 onward, using only publicly-readable tables.
--
-- Accessible tables we will use
--   • Hacker News data:  fh-bigquery.hackernews.full_partitioned
--       – contains every HN item plus a DATE partition column `month`
--   • Stack Overflow questions: bigquery-public-data.stackoverflow.posts_questions
--       – supplies the `<tag1><tag2>…>` string in column `Tags`
--
-- Steps (all implemented in this single query):
--   1. In CTE `hn` select HN rows where
--        • month ≥ '2014-01-01'
--        • type = 'comment'
--        • lower(text) contains 'stackoverflow.com/questions/'
--      Extract the numeric question-id with REGEXP_EXTRACT and count how many
--      comments mention each question.
--   2. Join those ids to the SO questions table to obtain their `Tags`.
--   3. Convert the angle-bracket tag string to an array via
--        REGEXP_EXTRACT_ALL(Tags, r'[^<>]+')
--      and unnest so each (tag, question) pair is a row.
--   4. Aggregate the HN-mention counts across all questions that share a tag.
--   5. Return the 10 tags with the highest total mentions.
WITH hn AS (
  SELECT
    CAST(REGEXP_EXTRACT(LOWER(text),
          r'stackoverflow\.com/questions/([0-9]+)') AS INT64) AS question_id,
    COUNT(*) AS mentions
  FROM `fh-bigquery.hackernews.full_partitioned`
  WHERE month >= '2014-01-01'               -- comments from 2014-01-01 onward
    AND type = 'comment'
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
  GROUP BY question_id
  HAVING question_id IS NOT NULL
), tag_expanded AS (
  SELECT
    tag,
    hn.mentions
  FROM hn
  JOIN `bigquery-public-data.stackoverflow.posts_questions` AS pq
    ON pq.Id = hn.question_id
  CROSS JOIN UNNEST(REGEXP_EXTRACT_ALL(pq.Tags, r'[^<>]+')) AS tag
)
SELECT
  tag,
  SUM(mentions) AS total_mentions
FROM tag_expanded
GROUP BY tag
ORDER BY total_mentions DESC
LIMIT 10;
```
