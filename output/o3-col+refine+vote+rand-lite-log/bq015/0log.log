```sql
--Description / Thinking process:
-- Goal: Find the 10 most-referenced Stack Overflow tags in Hacker News comments
--       posted on or after 2014-01-01.
-- Steps embodied in this ONE query:
--   1. From the public table `commentsV2`, filter comments whose lower-cased text
--      contains “stackoverflow.com/questions/”.
--   2. Use REGEXP_EXTRACT to capture the numeric question-id that follows the
--      “/questions/” segment, cast it to INT64, and count how many times each
--      question is mentioned (cte `hn`).
--   3. Join those question-ids with the Stack Overflow table
--      `fh-bigquery.stackoverflow.posts_questions` to obtain the pipe-delimited
--      `Tags` string for each referenced question.
--   4. Split the `Tags` string on the ‘|’ delimiter, producing one row per tag,
--      and aggregate the mention counts across all questions (cte `tags`).
--   5. Return the top 10 tags ranked by total Hacker News mentions.
WITH hn AS (
  SELECT
    CAST(REGEXP_EXTRACT(LOWER(text),
         r'stackoverflow\.com/questions/([0-9]+)') AS INT64) AS question_id,
    COUNT(*) AS mentions
  FROM `fh-bigquery.hackernews.commentsV2`
  WHERE time >= 1388534400                           -- 2014-01-01
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
  GROUP BY question_id
  HAVING question_id IS NOT NULL                     -- discard parsing misses
), tags AS (
  SELECT
    tag,
    SUM(mentions) AS total_mentions
  FROM hn
  JOIN `fh-bigquery.stackoverflow.posts_questions` AS pq
    ON pq.Id = hn.question_id
  CROSS JOIN UNNEST(SPLIT(pq.Tags, '|')) AS tag
  GROUP BY tag
)
SELECT
  tag,
  total_mentions
FROM tags
ORDER BY total_mentions DESC
LIMIT 10;
```
