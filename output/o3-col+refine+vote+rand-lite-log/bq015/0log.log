```sql
--Description: 3) Count how many times every individual question was mentioned
--              in Hacker News comments.
SELECT
  REGEXP_EXTRACT(LOWER(text),
                 r'stackoverflow\.com/questions/([0-9]+)') AS question_id,
  COUNT(*) AS mentions
FROM `fh-bigquery.hackernews.comments`
WHERE time >= 1388534400
  AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
GROUP BY question_id
ORDER BY mentions DESC
LIMIT 20;
