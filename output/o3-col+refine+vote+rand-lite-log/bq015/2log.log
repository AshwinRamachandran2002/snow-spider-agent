--Description / thinking process:
-- Goal: “Top 10 Stack Overflow tags whose questions are most often linked from
--       Hacker News comments (2014-present)”.
--
-- Publicly-readable table chosen: `fh-bigquery.hackernews.full_partition_extra`
--   • Contains *all* HN items (stories, comments, etc.).
--   • `type='comment'` rows hold comment text.
--   • `type='story'` rows that point at Stack Overflow questions include a
--     `tags` ARRAY<STRING> column whose elements are “pipe-separated” tag
--     lists (e.g. "python|regex").
--
-- Steps in a single CTE chain:
--   1. comments_cte  : pull 2014-onward comments containing an SO question URL
--                      and REGEXP_EXTRACT the numeric question-ID (so_qid).
--   2. ref_counts    : count how many times each so_qid appears in comments.
--   3. stories_cte   : pull HN stories whose URL points to the same so_qid and
--                      collect their `tags` arrays.
--   4. tag_rows      : join (2) ↔ (3), UNNEST the array, SPLIT each element on
--                      “|” to yield individual tags, carrying along ref_cnt.
--   5. final SELECT  : aggregate ref_cnt per tag, sort, limit 10.
WITH comments_cte AS (
  SELECT
    REGEXP_EXTRACT(LOWER(text),
                   r'stackoverflow\.com\/questions\/([0-9]+)') AS so_qid
  FROM
    `fh-bigquery.hackernews.full_partition_extra`
  WHERE
    type = 'comment'
    AND time >= 1388534400                       -- 2014-01-01 UTC
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
    AND REGEXP_EXTRACT(LOWER(text),
                       r'stackoverflow\.com\/questions\/([0-9]+)') IS NOT NULL
),
ref_counts AS (
  SELECT
    so_qid,
    COUNT(*) AS ref_cnt
  FROM comments_cte
  GROUP BY so_qid
),
stories_cte AS (
  SELECT
    REGEXP_EXTRACT(LOWER(url),
                   r'stackoverflow\.com\/questions\/([0-9]+)') AS so_qid,
    tags                                         -- ARRAY<STRING>
  FROM
    `fh-bigquery.hackernews.full_partition_extra`
  WHERE
    type = 'story'
    AND LOWER(url) LIKE '%stackoverflow.com/questions/%'
    AND ARRAY_LENGTH(tags) > 0
),
tag_rows AS (
  SELECT
    rc.ref_cnt,
    SPLIT(tag_element, '|') AS split_tags
  FROM
    ref_counts rc
  JOIN
    stories_cte st
  USING (so_qid),
  UNNEST(st.tags) AS tag_element
)
SELECT
  UNNEST(split_tags)         AS tag,
  SUM(ref_cnt)               AS total_hn_mentions
FROM
  tag_rows
GROUP BY
  tag
ORDER BY
  total_hn_mentions DESC
LIMIT 10;
