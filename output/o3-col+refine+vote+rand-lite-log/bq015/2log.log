--Description: 3) Count how many times each distinct Stack Overflow question id
--is referenced in Hacker News comments (2014-present).
WITH so_refs AS (
  SELECT
    REGEXP_EXTRACT(LOWER(`text`),
                   r'stackoverflow\.com\/questions\/([0-9]+)') AS so_qid
  FROM
    `fh-bigquery.hackernews.comments`
  WHERE
    `time` >= 1388534400
    AND LOWER(`text`) LIKE '%stackoverflow.com/questions/%'
    AND REGEXP_EXTRACT(LOWER(`text`),
