```sql
--Description: One-shot query to identify the 10 Stack Overflow tags whose
--questions are most frequently linked from Hacker News comments since 2014.
--The publicly-readable table `fh-bigquery.hackernews.full_partition_extra`
--contains every HN item (comments, stories, etc.) plus a `tags` ARRAY<STRING>
--for stories.  Steps:
-- 1. comments_cte  – harvest Stack Overflow question-IDs (so_qid) from comment
--    texts dated 2014-01-01 or later.
-- 2. ref_counts    – count how many HN comments mention each so_qid.
-- 3. stories_cte   – pull story rows that link to the same so_qid and expose
--    their `tags` array.
-- 4. Join ref_counts↔stories, explode the array and the “|”-delimited strings
--    inside it to get individual tags, then accumulate the reference counts.
-- 5. Return the 10 tags with the highest total HN mentions.
WITH comments_cte AS (
  SELECT
    REGEXP_EXTRACT(LOWER(text),
      r'stackoverflow\.com\/questions\/([0-9]+)') AS so_qid
  FROM
    `fh-bigquery.hackernews.full_partition_extra`
  WHERE
    type = 'comment'
    AND time >= 1388534400                           -- 2014-01-01 UTC
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
    AND REGEXP_EXTRACT(LOWER(text),
      r'stackoverflow\.com\/questions\/([0-9]+)') IS NOT NULL
),
ref_counts AS (
  SELECT
    so_qid,
    COUNT(*) AS ref_cnt
  FROM comments_cte
  GROUP BY so_qid
),
stories_cte AS (
  SELECT
    REGEXP_EXTRACT(LOWER(url),
      r'stackoverflow\.com\/questions\/([0-9]+)') AS so_qid,
    tags                                           -- ARRAY<STRING>
  FROM
    `fh-bigquery.hackernews.full_partition_extra`
  WHERE
    type = 'story'
    AND LOWER(url) LIKE '%stackoverflow.com/questions/%'
    AND ARRAY_LENGTH(tags) > 0
)
SELECT
  LOWER(tag)              AS tag,
  SUM(ref_cnt)            AS total_hn_mentions
FROM
  ref_counts rc
JOIN
  stories_cte st
USING (so_qid)
CROSS JOIN UNNEST(st.tags)              AS tag_group     -- e.g. "python|regex"
CROSS JOIN UNNEST(SPLIT(tag_group,'|')) AS tag           -- individual tag
GROUP BY tag
ORDER BY total_hn_mentions DESC
LIMIT 10;
```
