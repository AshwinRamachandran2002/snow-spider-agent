```sql
--Description: 5) Take the list of question ids referenced in HN comments
--(after 2014) and JOIN to HN stories that link to those exact questions, so we
--can retrieve the corresponding tag strings.
WITH so_refs AS (
  SELECT
    REGEXP_EXTRACT(LOWER(`text`),
