```sql
--Description: 7) Build a list of (so_qid, ref_cnt) from comments and keep the
--top 10 000 most-referenced questions to keep the next join small.
WITH so_refs AS (
  SELECT
    REGEXP_EXTRACT(LOWER(`text`),
                   r'stackoverflow\.com\/questions\/([0-9]+)') AS so_qid
  FROM
    `fh-bigquery.hackernews.comments`
  WHERE
    `time` >= 1388534400
    AND LOWER(`text`) LIKE '%stackoverflow.com/questions/%'
    AND REGEXP_EXTRACT(LOWER(`text`),
                       r'stackoverflow\.com\/questions\/([0-9]+)') IS NOT NULL
),
ref_counts AS (
  SELECT
    so_qid,
    COUNT(*) AS ref_cnt
  FROM so_refs
  GROUP BY so_qid
  ORDER BY ref_cnt DESC
  LIMIT 10000
)
SELECT * FROM ref_counts LIMIT 20;
