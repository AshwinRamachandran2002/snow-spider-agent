```sql
--Description: 8) Join the reference counts with the story-side tag strings,
--split the tag strings on the “|” delimiter, and explode them so we get one
--row per (tag, ref_cnt) pair.
WITH
ref_counts AS (   -- from step 7
  SELECT
    so_qid,
    COUNT(*) AS ref_cnt
  FROM (
    SELECT
      REGEXP_EXTRACT(LOWER(`text`),
                     r'stackoverflow\.com\/questions\/([0-9]+)') AS so_qid
    FROM
      `fh-bigquery.hackernews.comments`
    WHERE
      `time` >= 1388534400
      AND LOWER(`text`) LIKE '%stackoverflow.com/questions/%'
      AND REGEXP_EXTRACT(LOWER(`text`),
                         r'stackoverflow\.com\/questions\/([0-9]+)') IS NOT NULL
  )
  GROUP BY so_qid
),
so_story_tags AS (   -- from step 4
  SELECT
    REGEXP_EXTRACT(LOWER(`url`),
                   r'stackoverflow\.com\/questions\/([0-9]+)') AS so_qid,
    `tags`
  FROM
    `fh-bigquery.hackernews.full_partition_extra`
  WHERE
    LOWER(`url`) LIKE '%stackoverflow.com/questions/%'
)
SELECT
  tag_part        AS tag,
  rc.ref_cnt
FROM
  ref_counts AS rc
JOIN
  so_story_tags AS st
USING (so_qid),
UNNEST(st.tags)        AS raw_tag_string,
UNNEST(SPLIT(raw_tag_string, '|')) AS tag_part
LIMIT 20;
```

```sql
--Description: 9) Aggregate the exploded rows to count how many combined Hacker
--News references each Stack Overflow tag has, then rank them.
WITH
ref_counts AS (
  SELECT
    REGEXP_EXTRACT(LOWER(`text`),
                   r'stackoverflow\.com\/questions\/([0-9]+)') AS so_qid,
    COUNT(*) AS ref_cnt
  FROM
    `fh-bigquery.hackernews.comments`
  WHERE
    `time` >= 1388534400
    AND LOWER(`text`) LIKE '%stackoverflow.com/questions/%'
    AND REGEXP_EXTRACT(LOWER(`text`),
                       r'stackoverflow\.com\/questions\/([0-9]+)') IS NOT NULL
  GROUP BY so_qid
),
so_story_tags AS (
  SELECT
    REGEXP_EXTRACT(LOWER(`url`),
                   r'stackoverflow\.com\/questions\/([0-9]+)') AS so_qid,
    `tags`
  FROM
    `fh-bigquery.hackernews.full_partition_extra`
  WHERE
    LOWER(`url`) LIKE '%stackoverflow.com/questions/%'
)
SELECT
  tag_clean AS tag,
  SUM(rc.ref_cnt) AS total_hn_mentions
FROM
  ref_counts      AS rc
JOIN
  so_story_tags   AS st
USING (so_qid),
UNNEST(st.tags)        AS raw_tag_string,
UNNEST(SPLIT(raw_tag_string, '|')) AS tag_clean
GROUP BY tag_clean
ORDER BY total_hn_mentions DESC
LIMIT 20;
```

