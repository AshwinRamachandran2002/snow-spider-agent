Below is a progressive sequence (​≤10​) of BigQuery queries that starts with inspecting Hacker News comments, goes on to isolate Stack Overflow question-URLs, extracts the question’s tag string, splits it on the “|” delimiter, and finally ranks the ten most-mentioned tags.  
(Every query is limited to 20 rows except the last, which returns the requested top-10 list.)

```sql
-- 1️⃣  Description: Peek at 20 comments from 2014-onward that might
--     contain Stack Overflow links (quick sanity-check).
SELECT
  id,
  time,
  text
FROM `fh-bigquery.hackernews.comments`
WHERE time >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
  AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
LIMIT 20;
```

```sql
-- 2️⃣  Description: Extract full Stack Overflow question-URLs
--     that appear inside each comment (one URL per row).
SELECT
  c.id      AS comment_id,
  url       AS so_question_url
FROM `fh-bigquery.hackernews.comments` AS c,
UNNEST(
  REGEXP_EXTRACT_ALL(
    LOWER(c.text),
    r'https?://stackoverflow\.com/questions/[0-9]+/[^\s"\'<>]+'
  )
) AS url
WHERE c.time >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
LIMIT 20;
```

```sql
-- 3️⃣  Description: From each extracted URL pull the numeric
--     Stack Overflow question-ID.
SELECT
  so_question_url,
  REGEXP_EXTRACT(so_question_url,
                 r'https?://stackoverflow\.com/questions/([0-9]+)')
      AS so_qid
FROM (
  -- sub-query is exactly query 2
  SELECT
    url AS so_question_url
  FROM `fh-bigquery.hackernews.comments`,
  UNNEST(REGEXP_EXTRACT_ALL(LOWER(text),
        r'https?://stackoverflow\.com/questions/[0-9]+/[^\s"\'<>]+')) AS url
  WHERE time >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
)
LIMIT 20;
```

```sql
-- 4️⃣  Description: Count how many times each individual question
--     (question-ID) is mentioned.
SELECT
  so_qid,
  COUNT(*) AS mentions
FROM (
  -- same extraction logic as query 3
  SELECT
    REGEXP_EXTRACT(url,
      r'https?://stackoverflow\.com/questions/([0-9]+)') AS so_qid
  FROM `fh-bigquery.hackernews.comments`,
  UNNEST(REGEXP_EXTRACT_ALL(LOWER(text),
        r'https?://stackoverflow\.com/questions/[0-9]+/[^\s"\'<>]+')) AS url
  WHERE time >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
)
GROUP BY so_qid
ORDER BY mentions DESC
LIMIT 20;
```

```sql
-- 5️⃣  Description: For a quick spot-check, display 20 raw URLs
--     together with any “tags=” query parameter that might exist.
SELECT
  so_question_url,
  REGEXP_EXTRACT(so_question_url, r'[?&]tags=([^&]+)') AS raw_tag_string
FROM (
  SELECT url AS so_question_url
  FROM `fh-bigquery.hackernews.comments`,
  UNNEST(REGEXP_EXTRACT_ALL(LOWER(text),
        r'https?://stackoverflow\.com/questions/[0-9]+/[^\s"\'<>]+')) AS url
  WHERE time >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
)
WHERE REGEXP_CONTAINS(so_question_url, r'[?&]tags=')
LIMIT 20;
```

```sql
-- 6️⃣  Description: List 20 distinct, raw “tag strings” (the value
--     that follows tags=… in the URL).
SELECT DISTINCT
  REGEXP_EXTRACT(url, r'[?&]tags=([^&]+)') AS raw_tag_string
FROM `fh-bigquery.hackernews.comments`,
UNNEST(REGEXP_EXTRACT_ALL(LOWER(text),
      r'https?://stackoverflow\.com/questions/[0-9]+/[^\s"\'<>]+')) AS url
WHERE time >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
  AND REGEXP_CONTAINS(url, r'[?&]tags=')
LIMIT 20;
```

```sql
-- 7️⃣  Description: Split each raw tag string on “|” so every tag
--     appears on its own row (sample 20 rows).
SELECT
  comment_id,
  individual_tag
FROM (
  SELECT
    c.id AS comment_id,
    REGEXP_EXTRACT(url, r'[?&]tags=([^&]+)') AS raw_tag_string
  FROM `fh-bigquery.hackernews.comments` AS c,
  UNNEST(REGEXP_EXTRACT_ALL(LOWER(c.text),
        r'https?://stackoverflow\.com/questions/[0-9]+/[^\s"\'<>]+')) AS url
  WHERE c.time >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
    AND REGEXP_CONTAINS(url, r'[?&]tags=')
), UNNEST(SPLIT(raw_tag_string, '|')) AS individual_tag
LIMIT 20;
```

```sql
-- 8️⃣  Description: Count the occurrences of each individual tag
--     (across all comments since 2014) and show top 20.
SELECT
  individual_tag AS tag,
  COUNT(*)       AS total_mentions
FROM (
  SELECT
    REGEXP_EXTRACT(url, r'[?&]tags=([^&]+)') AS raw_tag_string
  FROM `fh-bigquery.hackernews.comments`,
  UNNEST(REGEXP_EXTRACT_ALL(LOWER(text),
        r'https?://stackoverflow\.com/questions/[0-9]+/[^\s"\'<>]+')) AS url
  WHERE time >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
    AND REGEXP_CONTAINS(url, r'[?&]tags=')
), UNNEST(SPLIT(raw_tag_string, '|')) AS individual_tag
GROUP BY tag
ORDER BY total_mentions DESC
LIMIT 20;
```

```sql
-- 9️⃣  Description: Same as query 8 but restrict result set to
--     the TOP-10 tags –– this is the final answer query.
SELECT
  individual_tag AS tag,
  COUNT(*)       AS mentions
FROM (
  SELECT
    REGEXP_EXTRACT(url, r'[?&]tags=([^&]+)') AS raw_tag_string
  FROM `fh-bigquery.hackernews.comments`,
  UNNEST(REGEXP_EXTRACT_ALL(LOWER(text),
        r'https?://stackoverflow\.com/questions/[0-9]+/[^\s"\'<>]+')) AS url
  WHERE time >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
    AND REGEXP_CONTAINS(url, r'[?&]tags=')
), UNNEST(SPLIT(raw_tag_string, '|')) AS individual_tag
GROUP BY tag
ORDER BY mentions DESC
LIMIT 10;
```

These nine queries (1 → 9) move from basic inspection to the complete solution: “Identify and rank the top 10 tags from Stack Overflow questions that were referenced in Hacker News comments on or after 2014.”
