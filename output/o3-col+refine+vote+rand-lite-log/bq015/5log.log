```sql
--Description:  Full task in one publicly readable table (`fh-bigquery.hackernews.full_partition_extra`).
--              Because other comment tables are blocked, everything happens here.
--              
--   • comments_cte   – keep only comment rows (`type='comment'`) posted on/after 2014-01-01.  
--   • urls_cte       – for each comment, use REGEXP_EXTRACT_ALL to harvest every
--                      Stack Overflow question-URL that appears in the text.  
--   • flat_urls      – UNNEST those arrays so each URL has its own row.  
--   • tag_str_cte    – from each URL capture the value of the “tags=” parameter
--                      (e.g. “…?tags=python|pandas”).  Discard URLs without it.  
--   • exploded_tags  – split the tag string on “|” so every tag is a separate row.  
--   • final SELECT   – count how many times each tag is mentioned and return the
--                      top-10 most-referenced tags in Hacker News comments
--                      (time ≥ 2014-01-01).
WITH comments_cte AS (
  SELECT
    id,
    LOWER(COALESCE(text, '')) AS text
  FROM `fh-bigquery.hackernews.full_partition_extra`
  WHERE type = 'comment'
    AND time >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
),
urls_cte AS (
  SELECT
    id,
    REGEXP_EXTRACT_ALL(
      text,
      r'https?://stackoverflow\.com/questions/[0-9]+/[^\s"\'<>]+'
    ) AS url_arr
  FROM comments_cte
),
flat_urls AS (
  SELECT
    id,
    url
  FROM urls_cte, UNNEST(url_arr) AS url
),
tag_str_cte AS (
  SELECT
    id,
    REGEXP_EXTRACT(url, r'[?&]tags=([^&]+)') AS tag_str
  FROM flat_urls
  WHERE REGEXP_CONTAINS(url, r'[?&]tags=')
),
exploded_tags AS (
  SELECT
    SPLIT(tag_str, '|') AS tag_list
  FROM tag_str_cte
),
all_tags AS (
  SELECT tag
  FROM exploded_tags, UNNEST(tag_list) AS tag
)
SELECT
  tag,
  COUNT(*) AS mentions
FROM all_tags
GROUP BY tag
ORDER BY mentions DESC
LIMIT 10;
