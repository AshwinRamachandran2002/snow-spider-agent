```sql
--Description:  Single-query solution (thinking process embedded) that produces the
--              TOP-10 Stack Overflow tags whose questions were referenced in
--              Hacker News comments posted on/after 2014-01-01.  We rely on the
--              publicly readable `fh-bigquery.hackernews.full_partitioned`
--              table because the dedicated comment tables are not accessible.
--
--  • comments_cte   – keep rows where `type='comment'` and timestamp ≥ 2014-01-01.
--  • url_cte        – use REGEXP_EXTRACT_ALL to pull every Stack Overflow
--                     question-URL inside each comment’s text (array of URLs).
--  • flat_cte       – UNNEST the array so each URL gets its own row.
--  • tagstr_cte     – from each URL capture the value of the “tags=” query
--                     parameter, e.g. “…?tags=python|pandas”.  (Only URLs that
--                     contain such a parameter are kept.)
--  • explode_cte    – split the tag string on “|” so each individual tag is a row.
--  • final SELECT   – count occurrences and return the 10 most-mentioned tags.
WITH comments_cte AS (
  SELECT id, text
  FROM `fh-bigquery.hackernews.full_partitioned`
  WHERE type = 'comment'
    AND time >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
),
url_cte AS (
  SELECT
    id,
    REGEXP_EXTRACT_ALL(
      LOWER(COALESCE(text, '')),
      r'https?://stackoverflow\.com/questions/[0-9]+/[^\s"\'<>]+'
    ) AS so_urls
  FROM comments_cte
),
flat_cte AS (
  SELECT id, url
  FROM url_cte, UNNEST(so_urls) AS url
),
tagstr_cte AS (
  SELECT
    id,
    REGEXP_EXTRACT(url, r'[?&]tags=([^&]+)') AS tag_string
  FROM flat_cte
  WHERE REGEXP_CONTAINS(url, r'[?&]tags=')
),
explode_cte AS (
  SELECT
    id,
    tag
  FROM tagstr_cte, UNNEST(SPLIT(tag_string, '|')) AS tag
)
SELECT
  tag,
  COUNT(*) AS mentions
FROM explode_cte
GROUP BY tag
ORDER BY mentions DESC
LIMIT 10;
```
