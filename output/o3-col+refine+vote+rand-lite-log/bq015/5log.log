```sql
--Description:  Single-statement solution that completes the whole task with a
--              readable “thinking process” embedded in CTEs.  Because the
--              dedicated comments tables are not publicly accessible, everything
--              is done in the open table `fh-bigquery.hackernews.full_partitioned`.
--
--  • comments   : restrict to comment rows (`type='comment'`) posted ≥ 2014-01-01.  
--  • url_array  : pull every Stack Overflow question-URL from each comment’s
--                 text via REGEXP_EXTRACT_ALL (returns ARRAY<STRING>).  
--  • urls       : UNNEST the array so each URL is on its own row.  
--  • tag_strs   : from each URL, capture the value of the “tags=” query
--                 parameter (e.g. “…?tags=python|pandas”) with REGEXP_EXTRACT;
--                 keep only URLs that actually contain that parameter.  
--  • tags       : split the tag string on “|” so each individual tag is a row.  
--  • final      : count occurrences of each tag and return the 10 most-mentioned.
WITH comments AS (
  SELECT
    id,
    LOWER(COALESCE(text, '')) AS text
  FROM `fh-bigquery.hackernews.full_partitioned`
  WHERE type = 'comment'
    AND time >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
),
url_array AS (
  SELECT
    id,
    REGEXP_EXTRACT_ALL(
      text,
      r'https?://stackoverflow\.com/questions/[0-9]+/[^\s"\'<>]+'  -- SO Q-link
    ) AS urls
  FROM comments
),
urls AS (
  SELECT
    id,
    url
  FROM url_array, UNNEST(urls) AS url
),
tag_strs AS (
  SELECT
    id,
    REGEXP_EXTRACT(url, r'[?&]tags=([^&]+)') AS tag_string
  FROM urls
  WHERE REGEXP_CONTAINS(url, r'[?&]tags=')
),
tags AS (
  SELECT
    id,
    tag
  FROM tag_strs, UNNEST(SPLIT(tag_string, '|')) AS tag
)
SELECT
  tag,
  COUNT(*) AS mentions
FROM tags
GROUP BY tag
ORDER BY mentions DESC
LIMIT 10;
```
