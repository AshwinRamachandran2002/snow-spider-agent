```sql
--Description:
-- Goal: find the ten most-mentioned Stack Overflow tags that appear in Hacker News
--       comments posted on/after 2014-01-01.  We only have access to the public
--       2015 snapshot table `fh-bigquery.hackernews.full_201510`, so every step
--       occurs there.  The logic unfolds in CTEs (but it is still a single query):
--
--   comments   :  restrict rows to comments (type='comment') from 2014-01-01 onward.
--   urls       :  pull every Stack Overflow question-URL found in each comment’s text
--                 with REGEXP_EXTRACT_ALL (returns an array).
--   flat_urls  :  unnest the array so each URL sits on its own row.
--   tag_str    :  from each URL, capture the value of the “tags=” parameter
--                 (e.g. tags=python|pandas); keep only URLs that carry it.
--   exploded   :  split the tag string on the “|” delimiter so every tag is a row.
--   final      :  count and rank the tags, returning the top-10.
WITH comments AS (
  SELECT id, text
  FROM `fh-bigquery.hackernews.full_201510`
  WHERE type = 'comment'
    AND time >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
),
urls AS (
  SELECT
    id,
    REGEXP_EXTRACT_ALL(
      LOWER(COALESCE(text, '')),
      r'https?://stackoverflow\.com/questions/[0-9]+/[^\s"\'<>]+'
    ) AS url_list
  FROM comments
),
flat_urls AS (
  SELECT id, url
  FROM urls, UNNEST(url_list) AS url
),
tag_str AS (
  SELECT
    id,
    REGEXP_EXTRACT(url, r'[?&]tags=([^&]+)') AS tags_param
  FROM flat_urls
  WHERE REGEXP_CONTAINS(url, r'[?&]tags=')
),
exploded AS (
  SELECT
    id,
    tag
  FROM tag_str, UNNEST(SPLIT(tags_param, '|')) AS tag
)
SELECT
  tag,
  COUNT(*) AS mentions
FROM exploded
GROUP BY tag
ORDER BY mentions DESC
LIMIT 10;
```
