```sql
--Description: 1)  Show a few Hacker News comments (2014-present) that contain a
--               Stack Overflow question-URL.
SELECT
  id,
  time,
  text
FROM `fh-bigquery.hackernews.comments`
WHERE time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
  AND REGEXP_CONTAINS(LOWER(text), r'stackoverflow\.com/questions/[0-9]+')
LIMIT 20;
```

```sql
--Description: 2)  Extract the numeric Stack Overflow question-id that appears
--               inside each comment’s URL.
SELECT
  id              AS comment_id,
  REGEXP_EXTRACT(LOWER(text),
                 r'stackoverflow\.com/questions/([0-9]+)') AS question_id
FROM `fh-bigquery.hackernews.comments`
WHERE time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
  AND REGEXP_CONTAINS(LOWER(text), r'stackoverflow\.com/questions/[0-9]+')
LIMIT 20;
```

```sql
--Description: 3)  Count how many times every individual Stack Overflow question
--               is mentioned in the 2014-present comments.
WITH refs AS (
  SELECT REGEXP_EXTRACT(LOWER(text),
                         r'stackoverflow\.com/questions/([0-9]+)') AS q_id
  FROM `fh-bigquery.hackernews.comments`
  WHERE time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
    AND REGEXP_CONTAINS(LOWER(text), r'stackoverflow\.com/questions/[0-9]+')
)
SELECT
  CAST(q_id AS INT64)       AS question_id,
  COUNT(*)                  AS mention_count
FROM refs
WHERE q_id IS NOT NULL
GROUP BY question_id
ORDER BY mention_count DESC
LIMIT 20;
```

```sql
--Description: 4)  Inspect rows in the “extra” table whose url points at a
--               Stack Overflow question and see how the `tags` column looks.
SELECT
  url,
  tags
FROM `fh-bigquery.hackernews.full_partition_extra`
WHERE REGEXP_CONTAINS(url, r'stackoverflow\.com/questions/[0-9]+')
LIMIT 20;
```

```sql
--Description: 5)  Pull out the Stack Overflow question-id together with its
--               stored tag string (still without any counting).
SELECT
  CAST(REGEXP_EXTRACT(url,
         r'stackoverflow\.com/questions/([0-9]+)') AS INT64) AS question_id,
  tags
FROM `fh-bigquery.hackernews.full_partition_extra`
WHERE REGEXP_CONTAINS(url, r'stackoverflow\.com/questions/[0-9]+')
LIMIT 20;
```

```sql
--Description: 6)  Join the mention-counts to the question-tags so we can see
--               how many times each tagged question was referenced.
WITH question_mentions AS (
  SELECT CAST(q_id AS INT64) AS question_id, COUNT(*) AS mention_count
  FROM (
    SELECT REGEXP_EXTRACT(LOWER(text),
                           r'stackoverflow\.com/questions/([0-9]+)') AS q_id
    FROM `fh-bigquery.hackernews.comments`
    WHERE time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
      AND REGEXP_CONTAINS(LOWER(text), r'stackoverflow\.com/questions/[0-9]+')
  )
  WHERE q_id IS NOT NULL
  GROUP BY question_id
),
question_tags AS (
  SELECT CAST(REGEXP_EXTRACT(url,
         r'stackoverflow\.com/questions/([0-9]+)') AS INT64) AS question_id,
         tags
  FROM `fh-bigquery.hackernews.full_partition_extra`
  WHERE REGEXP_CONTAINS(url, r'stackoverflow\.com/questions/[0-9]+')
)
SELECT
  qt.question_id,
  qt.tags,
  qm.mention_count
FROM question_tags qt
JOIN question_mentions qm USING (question_id)
LIMIT 20;
```

```sql
--Description: 7)  FINAL – Top-10 Stack Overflow tags that appear in the most
--               referenced questions inside Hacker News comments (2014-now).
WITH comment_refs AS (
  SELECT CAST(REGEXP_EXTRACT(LOWER(text),
         r'stackoverflow\.com/questions/([0-9]+)') AS INT64) AS question_id
  FROM `fh-bigquery.hackernews.comments`
  WHERE time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
    AND REGEXP_CONTAINS(LOWER(text), r'stackoverflow\.com/questions/[0-9]+')
),
question_mentions AS (
  SELECT question_id, COUNT(*) AS mention_count
  FROM comment_refs
  WHERE question_id IS NOT NULL
  GROUP BY question_id
),
question_tags AS (
  SELECT CAST(REGEXP_EXTRACT(url,
         r'stackoverflow\.com/questions/([0-9]+)') AS INT64) AS question_id,
         tags
  FROM `fh-bigquery.hackernews.full_partition_extra`
  WHERE REGEXP_CONTAINS(url, r'stackoverflow\.com/questions/[0-9]+')
),
tag_counts AS (
  SELECT
    tag,
    SUM(mention_count) AS total_mentions
  FROM question_mentions qm
  JOIN question_tags   qt USING (question_id)
  -- `tags` is a pipe-delimited string; split then unnest:
  CROSS JOIN UNNEST(SPLIT(CAST(qt.tags AS STRING), '|')) AS tag
  GROUP BY tag
)
SELECT
  tag,
  total_mentions
FROM tag_counts
ORDER BY total_mentions DESC
LIMIT 10;
```
