--Description:
-- Tables previously attempted returned 403 errors.  A still-listed, potentially
-- accessible public table is `fh-bigquery.hackernews.storiesV2`, which contains
-- Hacker News story items (fields: id, time, url, text, etc.).  Some stories
-- reference Stack Overflow questions in either the `url` or the story `text`.
-- Plan:
--   • Work with rows whose Unix-seconds `time` ≥ 2014-01-01.
--   • Combine `url` and `text`, convert to lower case, and search for the
--     pattern “stackoverflow.com/questions/<digits>”.
--   • Use REGEXP_EXTRACT to pull out the numeric question-id.
--   • Return 20 sample rows to verify (`story_id`, extracted `question_id`).
SELECT
  id AS story_id,
  REGEXP_EXTRACT(
    LOWER(CONCAT(IFNULL(url, ''), ' ', IFNULL(text, ''))),
    r'stackoverflow\.com/questions/([0-9]+)'
  ) AS question_id
FROM `fh-bigquery.hackernews.storiesV2`
WHERE time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
  AND REGEXP_CONTAINS(
        LOWER(CONCAT(IFNULL(url, ''), ' ', IFNULL(text, ''))),
        r'stackoverflow\.com/questions/[0-9]+'
      )
LIMIT 20;
