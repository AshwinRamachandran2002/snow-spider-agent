```sql
-- Description: If you wish to see how the yearly distribution of those
-- top-10 tags’ mentions has evolved, you could break them down by year.
WITH hn_qids AS (
  SELECT
    CAST(REGEXP_EXTRACT(LOWER(text),
                        r'stackoverflow\.com/(?:questions|q)/([0-9]+)')
         AS INT64)        AS so_qid,
    EXTRACT(YEAR FROM time_ts) AS yr
  FROM
    `fh-bigquery.hackernews.comments`
  WHERE
    time_ts >= '2014-01-01'
    AND LOWER(text) LIKE '%stackoverflow.com/%'
    AND REGEXP_EXTRACT(LOWER(text),
                       r'stackoverflow\.com/(?:questions|q)/([0-9]+)') IS NOT NULL
),
cnt AS (
  SELECT so_qid, yr, COUNT(*) AS mentions
  FROM   hn_qids
  GROUP  BY so_qid, yr
),
tags AS (
  SELECT
    c.yr,
    c.mentions,
    SPLIT(q.tags, '|') AS tag_arr
  FROM
    cnt AS c
  JOIN
    `bigquery-public-data.stackoverflow.posts_questions` AS q
  ON
    q.id = c.so_qid
),
top10 AS (
  SELECT tag
  FROM (
    SELECT tag, SUM(mentions) AS tot
    FROM tags, UNNEST(tag_arr) AS tag
    GROUP BY tag
    ORDER BY tot DESC
    LIMIT 10 )
)
SELECT
  t.tag,
  t.yr,
  SUM(t.mentions) AS mentions_in_year
FROM
  tags AS t,
  UNNEST(tag_arr) AS tag
WHERE
  tag IN (SELECT tag FROM top10)
GROUP BY
  tag, yr
ORDER BY
  yr, mentions_in_year DESC
LIMIT 20;
```

