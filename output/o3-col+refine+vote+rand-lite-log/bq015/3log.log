```sql
-- Description: Join the Hacker News mention-counts with the Stack Overflow
-- questions to bring in the tag-string (pipe-delimited).
WITH hn_qids AS (
  SELECT
    REGEXP_EXTRACT(LOWER(text),
                   r'stackoverflow\.com/(?:questions|q)/([0-9]+)') AS so_qid
  FROM
    `fh-bigquery.hackernews.comments`
  WHERE
    time_ts >= '2014-01-01'
    AND LOWER(text) LIKE '%stackoverflow.com/%'
    AND REGEXP_EXTRACT(LOWER(text),
                       r'stackoverflow\.com/(?:questions|q)/([0-9]+)') IS NOT NULL
),
hn_counts AS (
  SELECT
    CAST(so_qid AS INT64) AS so_qid,
    COUNT(*)              AS mentions
  FROM hn_qids
  GROUP BY so_qid
)
SELECT
  h.so_qid,
  h.mentions,
  q.tags
FROM
  hn_counts  AS h
JOIN
  `bigquery-public-data.stackoverflow.posts_questions` AS q
ON
  q.id = h.so_qid
LIMIT 20;
```

```sql
-- Description: Split the pipe-delimited `tags` string into an array
-- and explode (UNNEST) it so each tag is on its own row, preserving
-- the mention-count weight.
WITH hn_counts AS (
  SELECT
    CAST(REGEXP_EXTRACT(LOWER(text),
                        r'stackoverflow\.com/(?:questions|q)/([0-9]+)')
         AS INT64) AS so_qid
  FROM
    `fh-bigquery.hackernews.comments`
  WHERE
    time_ts >= '2014-01-01'
    AND LOWER(text) LIKE '%stackoverflow.com/%'
    AND REGEXP_EXTRACT(LOWER(text),
                       r'stackoverflow\.com/(?:questions|q)/([0-9]+)') IS NOT NULL
),
agg AS (
  SELECT
    so_qid,
    COUNT(*) AS mentions
  FROM hn_counts
  GROUP BY so_qid
),
joined AS (
  SELECT
    a.mentions,
    SPLIT(q.tags, '|') AS tag_array
  FROM
    agg AS a
  JOIN
    `bigquery-public-data.stackoverflow.posts_questions` AS q
  ON
    q.id = a.so_qid
)
SELECT
  tag
FROM
  joined,
  UNNEST(tag_array) AS tag
LIMIT 20;
```

```sql
-- Description: Aggregate the weighted mentions by individual tag to
-- find total Hacker News references of questions containing each tag.
WITH hn_qids AS (
  SELECT
    CAST(REGEXP_EXTRACT(LOWER(text),
                        r'stackoverflow\.com/(?:questions|q)/([0-9]+)')
         AS INT64) AS so_qid
  FROM
    `fh-bigquery.hackernews.comments`
  WHERE
    time_ts >= '2014-01-01'
    AND LOWER(text) LIKE '%stackoverflow.com/%'
    AND REGEXP_EXTRACT(LOWER(text),
                       r'stackoverflow\.com/(?:questions|q)/([0-9]+)') IS NOT NULL
),
cnt AS (
  SELECT so_qid, COUNT(*) AS mentions
  FROM   hn_qids
  GROUP  BY so_qid
),
tags AS (
  SELECT
    c.mentions,
    SPLIT(q.tags, '|') AS tag_arr
  FROM
    cnt AS c
  JOIN
    `bigquery-public-data.stackoverflow.posts_questions` AS q
  ON
    q.id = c.so_qid
)
SELECT
  tag,
  SUM(mentions) AS total_mentions
FROM
  tags,
  UNNEST(tag_arr) AS tag
GROUP BY
  tag
ORDER BY
  total_mentions DESC
LIMIT 20;
```

