--Description:  Public-access path to the task’s answer in one shot.
--  • Source table: `fh-bigquery.hackernews.full_partitioned` (publicly readable).
--  • Select only Hacker News comments (type='comment') from 2014-01-01 onward.
--  • Detect Stack Overflow question links of either form:
--        …stackoverflow.com/questions/<id>…
--        …stackoverflow.com/q/<id>…
--    and extract the numeric <id> with REGEXP_EXTRACT.
--  • Count how many distinct HN comments reference each SO question.
--  • Join those question-IDs to the public Stack Overflow table
--        `bigquery-public-data.stackoverflow.posts_questions`
--    to obtain each question’s pipe-delimited tag string.
--  • Split the tag string, unnest to one row per tag, weight by the HN-mention
--    count for that question, aggregate totals per tag, and return the ten tags
--    whose questions were linked most often in HN comments (2014-present).
WITH hn_links AS (               -- Extract SO question-ids from HN comments
  SELECT
    CAST(
      REGEXP_EXTRACT(
        LOWER(text),
        r'stackoverflow\.com/(?:questions|q)/([0-9]+)'
      ) AS INT64
    ) AS so_qid
  FROM
    `fh-bigquery.hackernews.full_partitioned`
  WHERE
    type = 'comment'
    AND timestamp >= '2014-01-01'
    AND REGEXP_CONTAINS(
          LOWER(text),
          r'stackoverflow\.com/(?:questions|q)/[0-9]+'
        )
),
question_counts AS (             -- How many HN comments mention each question?
  SELECT
    so_qid,
    COUNT(*) AS hn_mentions
  FROM
    hn_links
  WHERE
    so_qid IS NOT NULL
  GROUP BY
    so_qid
),
tag_rows AS (                     -- Bring in tags and explode to individual rows
  SELECT
    qc.hn_mentions,
    SPLIT(pq.tags, '|') AS tag_list
  FROM
    question_counts AS qc
  JOIN
    `bigquery-public-data.stackoverflow.posts_questions` AS pq
  ON
    pq.id = qc.so_qid
)
SELECT
  tag            AS stackoverflow_tag,
  SUM(hn_mentions) AS total_hn_mentions
FROM
  tag_rows,
  UNNEST(tag_list) AS tag
GROUP BY
  stackoverflow_tag
ORDER BY
  total_hn_mentions DESC
LIMIT 10;
