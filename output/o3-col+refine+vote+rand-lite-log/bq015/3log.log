```sql
-- Description: Count how many times each Stack Overflow question was mentioned
-- in Hacker News comments (2014-present).
WITH qids AS (
  SELECT
    REGEXP_EXTRACT(LOWER(text),
                   r'stackoverflow\.com/(?:questions|q)/([0-9]+)') AS so_qid
  FROM
    `fh-bigquery.hackernews.comments`
  WHERE
    time_ts >= '2014-01-01'
)
SELECT
  so_qid,
  COUNT(*) AS hn_mentions
FROM
  qids
GROUP BY
  so_qid
ORDER BY
  hn_mentions DESC
LIMIT 20;
