```sql
--Description:  One-query solution (with inline reasoning) to find the ten Stack Overflow
--tags whose questions were referenced most often in Hacker News comments from
--2014-01-01 onward, using only public datasets.
--
--Step-by-step inside this query:
--  1. From `bigquery-public-data.hacker_news.comments`, pull comments posted
--     on/after 2014-01-01 that contain a Stack Overflow question URL.  Use a
--     regex to capture the numeric question-id (so_qid).
--  2. Count how many HN comments mention each individual SO question.
--  3. Join those question-ids to `bigquery-public-data.stackoverflow.posts_questions`
--     to retrieve each question’s pipe-delimited `tags` string.
--  4. SPLIT that string, UNNEST to one row per tag, weight each tag by the
--     mention count of its parent question, aggregate totals per tag, and
--     return the ten tags with the largest weighted totals.

WITH hn_links AS (              -- 1. Extract SO question-ids from HN comments
  SELECT
    CAST(                     -- convert captured id to INT64
      REGEXP_EXTRACT(
        LOWER(text),
        r'stackoverflow\.com/(?:questions|q)/([0-9]+)'
      ) AS INT64
    ) AS so_qid
  FROM
    `bigquery-public-data.hacker_news.comments`
  WHERE
    time_ts >= '2014-01-01'   -- filter for comments since 2014-01-01
    AND REGEXP_CONTAINS(      -- ensure the comment has a question URL
          LOWER(text),
          r'stackoverflow\.com/(?:questions|q)/[0-9]+'
        )
),
question_counts AS (           -- 2. Count HN mentions per SO question
  SELECT
    so_qid,
    COUNT(*) AS mentions
  FROM
    hn_links
  WHERE
    so_qid IS NOT NULL
  GROUP BY
    so_qid
),
tag_rows AS (                  -- 3. Bring in tags; 4. split to array
  SELECT
    qc.mentions,
    SPLIT(pq.tags, '|') AS tag_arr
  FROM
    question_counts AS qc
  JOIN
    `bigquery-public-data.stackoverflow.posts_questions` AS pq
  ON
    pq.id = qc.so_qid
)
SELECT                          -- 4. Aggregate per tag, rank, limit to top 10
  tag               AS stackoverflow_tag,
  SUM(mentions)     AS total_hn_mentions
FROM
  tag_rows,
  UNNEST(tag_arr) AS tag
GROUP BY
  stackoverflow_tag
ORDER BY
  total_hn_mentions DESC
LIMIT 10;
