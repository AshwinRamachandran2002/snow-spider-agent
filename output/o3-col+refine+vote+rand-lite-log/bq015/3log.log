```sql
--Description:  From the publicly readable `fh-bigquery.hackernews.full_partitioned`
--table, locate Hacker News comments (type='comment') posted on/after 2014-01-01
--that contain a Stack Overflow question link (`stackoverflow.com/questions/<id>`
--or `stackoverflow.com/q/<id>`).  Extract each linked question-id, count how
--many distinct HN comments reference it, join to the Stack Overflow
--`bigquery-public-data.stackoverflow.posts_questions` table to fetch the pipe-
--delimited tag string, explode that string into individual tags, weight each
--tag by the number of HN mentions of its parent question, aggregate, and return
--the ten tags with the highest total weighted mentions.
WITH hn_so_links AS (
  SELECT
    CAST(
      REGEXP_EXTRACT(
        LOWER(text),
        r'stackoverflow\.com/(?:questions|q)/([0-9]+)'
      ) AS INT64
    ) AS so_qid
  FROM
    `fh-bigquery.hackernews.full_partitioned`
  WHERE
    type = 'comment'
    AND timestamp >= '2014-01-01'
    AND REGEXP_CONTAINS(
          LOWER(text),
          r'stackoverflow\.com/(?:questions|q)/[0-9]+'
        )
),
question_mention_counts AS (
  SELECT
    so_qid,
    COUNT(*) AS hn_mentions
  FROM
    hn_so_links
  WHERE
    so_qid IS NOT NULL
  GROUP BY
    so_qid
),
question_tags AS (
  SELECT
    qmc.hn_mentions,
    SPLIT(pq.tags, '|') AS tag_array
  FROM
    question_mention_counts AS qmc
  JOIN
    `bigquery-public-data.stackoverflow.posts_questions` AS pq
  ON
    pq.id = qmc.so_qid
)
SELECT
  tag AS stackoverflow_tag,
  SUM(hn_mentions) AS total_hn_mentions
FROM
  question_tags,
  UNNEST(tag_array) AS tag
GROUP BY
  stackoverflow_tag
ORDER BY
  total_hn_mentions DESC
LIMIT 10;
