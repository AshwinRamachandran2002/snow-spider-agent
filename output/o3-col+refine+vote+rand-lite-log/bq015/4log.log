```sql
--Description: 5) Keep only those Stack Overflow rows that actually have
--              non-empty tag arrays so we know tags are available.
SELECT  question_id,
        `tags`
FROM   (
        SELECT REGEXP_EXTRACT(`url`,
                              r'stackoverflow\.com/questions/([0-9]+)') AS question_id,
               `tags`
        FROM   `fh-bigquery.hackernews.full_partition_extra`
        WHERE  `url` LIKE '%stackoverflow.com/questions/%'
       )
WHERE   question_id IS NOT NULL
  AND   ARRAY_LENGTH(`tags`) > 0
LIMIT 20;
```

```sql
--Description: 6) Join the comment-side mention counts (C) with the question-side
--              tag lists (T) to be sure every question_id lines up correctly.
SELECT  C.question_id,
        C.mention_count,
        ANY_VALUE(T.tags) AS tags
FROM   (
        -- comment-side counts
        SELECT  question_id,
                COUNT(*) AS mention_count
        FROM   (
                SELECT REGEXP_EXTRACT(LOWER(`text`),
                                      r'stackoverflow\.com/questions/([0-9]+)') AS question_id
                FROM   `fh-bigquery.hackernews.commentsV2`
                WHERE  `time` >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
                  AND  LOWER(`text`) LIKE '%stackoverflow.com/questions/%'
               )
        WHERE   question_id IS NOT NULL
        GROUP BY question_id
       )  AS C
LEFT JOIN (
        -- question-side tags
        SELECT  REGEXP_EXTRACT(`url`,
                               r'stackoverflow\.com/questions/([0-9]+)') AS question_id,
                `tags`
        FROM    `fh-bigquery.hackernews.full_partition_extra`
        WHERE   `url` LIKE '%stackoverflow.com/questions/%'
          AND   ARRAY_LENGTH(`tags`) > 0
       ) AS T
USING (question_id)
LIMIT 20;
```

```sql
--Description: 7) Explode (UNNEST) the tag array for each question so that every
--              tag appears on its own row next to the mention count.
SELECT  question_id,
        tag,
        mention_count
FROM   (
        SELECT  C.question_id,
                C.mention_count,
                T.tags
        FROM   (
                SELECT  question_id,
                        COUNT(*) AS mention_count
                FROM   (
                        SELECT REGEXP_EXTRACT(LOWER(`text`),
                                              r'stackoverflow\.com/questions/([0-9]+)') AS question_id
                        FROM   `fh-bigquery.hackernews.commentsV2`
                        WHERE  `time` >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
                          AND  LOWER(`text`) LIKE '%stackoverflow.com/questions/%'
                       )
                WHERE   question_id IS NOT NULL
                GROUP BY question_id
               ) AS C
        JOIN   (
                SELECT  REGEXP_EXTRACT(`url`,
                                       r'stackoverflow\.com/questions/([0-9]+)') AS question_id,
                        `tags`
                FROM    `fh-bigquery.hackernews.full_partition_extra`
                WHERE   `url` LIKE '%stackoverflow.com/questions/%'
                  AND   ARRAY_LENGTH(`tags`) > 0
               ) AS T
        USING (question_id)
       ), UNNEST(`tags`) AS tag
LIMIT 20;
```

```sql
--Description: 8) Split any compound tag strings that use “|” as an internal
--              delimiter, then roll-up the total mentions per atomic tag.
SELECT  single_tag   AS tag,
        SUM(mention_count) AS total_mentions
FROM   (
        SELECT  C.question_id,
                C.mention_count,
                T.tags
        FROM   (
                SELECT  question_id,
                        COUNT(*) AS mention_count
                FROM   (
                        SELECT REGEXP_EXTRACT(LOWER(`text`),
                                              r'stackoverflow\.com/questions/([0-9]+)') AS question_id
                        FROM   `fh-bigquery.hackernews.commentsV2`
                        WHERE  `time` >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
                          AND  LOWER(`text`) LIKE '%stackoverflow.com/questions/%'
                       )
                WHERE   question_id IS NOT NULL
                GROUP BY question_id
               ) AS C
        JOIN   (
                SELECT  REGEXP_EXTRACT(`url`,
                                       r'stackoverflow\.com/questions/([0-9]+)') AS question_id,
                        `tags`
                FROM    `fh-bigquery.hackernews.full_partition_extra`
                WHERE   `url` LIKE '%stackoverflow.com/questions/%'
                  AND   ARRAY_LENGTH(`tags`) > 0
               ) AS T
        USING (question_id)
       ), UNNEST(`tags`) AS tag,
       UNNEST(SPLIT(tag, '|')) AS single_tag
GROUP BY single_tag
ORDER BY total_mentions DESC
LIMIT 20;
```

