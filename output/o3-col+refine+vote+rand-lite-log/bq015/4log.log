```sql
--Description: One-shot query that finds the 10 most-referenced Stack Overflow
--             tags in Hacker News comments (posted ≥ 2014-01-01).  
--             Steps inside the CTE chain:  
--               1. comment_mentions  – pull every HN comment whose text contains
--                  a Stack Overflow question URL and extract the question-id.  
--               2. question_counts   – count how many times each question-id was
--                  mentioned.  
--               3. question_tags     – locate the corresponding Stack Overflow
--                  rows (in the same dataset) that store the array `tags`.  
--               4. tag_mentions      – explode the tag array, further split any
--                  tag strings that contain the “|” delimiter, and carry forward
--                  the mention count.  
--               5. Final SELECT      – aggregate by individual tag, rank by the
--                  total mentions, and return the top 10.
WITH comment_mentions AS (
  SELECT
    REGEXP_EXTRACT(LOWER(text),
                   r'stackoverflow\.com/questions/([0-9]+)') AS question_id
  FROM
    `fh-bigquery.hackernews.full_partition_extra`
  WHERE
    type = 'comment'
    AND time >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))
    AND text IS NOT NULL
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
),
question_counts AS (
  SELECT
    question_id,
    COUNT(*) AS mention_count
  FROM
    comment_mentions
  WHERE
    question_id IS NOT NULL
  GROUP BY
    question_id
),
question_tags AS (
  SELECT
    REGEXP_EXTRACT(url,
                   r'stackoverflow\.com/questions/([0-9]+)') AS question_id,
    tags
  FROM
    `fh-bigquery.hackernews.full_partition_extra`
  WHERE
    url LIKE '%stackoverflow.com/questions/%'
    AND ARRAY_LENGTH(tags) > 0
),
tag_mentions AS (
  SELECT
    single_tag AS tag,
    qc.mention_count
  FROM
    question_counts AS qc
  JOIN
    question_tags  AS qt
  USING (question_id)
  CROSS JOIN
    UNNEST(qt.tags)            AS tag_element
  CROSS JOIN
    UNNEST(SPLIT(tag_element, '|')) AS single_tag
  WHERE
    single_tag <> ''
)
SELECT
  tag,
  SUM(mention_count) AS total_mentions
FROM
  tag_mentions
GROUP BY
  tag
ORDER BY
  total_mentions DESC
LIMIT 10;
```
