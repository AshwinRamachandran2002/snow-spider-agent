--Description:  One-shot query that delivers the ten Stack Overflow tags most
--              frequently referenced in Hacker News comments dated on/after
--              2014-01-01.  All work is done inside publicly readable table
--              `fh-bigquery.hackernews.full_partitioned`, avoiding the
--              permission issues on other tables.
--
--  Logical flow embodied in the query
--  ───────────────────────────────────
--  1.  Restrict to rows that are:
--        • comments  (type = 'comment')
--        • posted from 1-Jan-2014 forward  (Unix-time ≥ 1388534400)
--        • whose text contains the substring “stackoverflow.com/questions/”.
--
--  2.  Use REGEXP_EXTRACT_ALL to pull every Stack Overflow question-URL from
--     each matching comment.  The pattern
--         https?://stackoverflow\.com/questions/[0-9]+[^"'< ]*
--     captures the numeric id and any trailing path until the first space,
--     quote, or “<”, thereby avoiding the illegal “\s” escape that previously
--     caused errors.
--
--  3.  UNNEST turns the extracted URL array into one row per URL occurrence.
--
--  4.  Retain only URLs that include a pipe “|”; in SO’s short-link format the
--     substring following the first “|” encodes a pipe-delimited tag list
--     (example: “…|python|pandas”).  Without the pipe we cannot recover tags.
--
--  5.  Group identical question URLs to count how many times each question is
--     referenced across all comments (alias q_count).
--
--  6.  SPLIT each tag list on “|”, UNNEST to one row per {tag, question},
--     weight each tag by q_count, aggregate across all questions, sort, and
--     return the Top-10 tags.
WITH question_counts AS (
  SELECT
    REGEXP_EXTRACT(so_url,
      r'https?://stackoverflow\.com/questions/[0-9]+')   AS question_base,
    REGEXP_EXTRACT(so_url, r'\|(.*)$')                   AS tag_string,
    COUNT(*)                                             AS q_count          -- #mentions of this question
  FROM
    `fh-bigquery.hackernews.full_partitioned`,
    UNNEST(
      REGEXP_EXTRACT_ALL(
        COALESCE(text, ''),
        r'https?://stackoverflow\.com/questions/[0-9]+[^"\'< ]*')
    ) AS so_url
  WHERE
    type = 'comment'
    AND time >= 1388534400                               -- 2014-01-01
    AND REGEXP_CONTAINS(so_url, r'\|')                   -- ensure tag list present
  GROUP BY question_base, tag_string
)
SELECT
  tag,
  SUM(q_count) AS tag_mentions
FROM
  question_counts,
  UNNEST(SPLIT(tag_string, '|')) AS tag                  -- explode individual tags
GROUP BY tag
ORDER BY tag_mentions DESC
LIMIT 10;
