--Description: Single-query solution that returns the ten Stack Overflow tags
--             most frequently referenced in Hacker News comments dated
--             2014-01-01 or later.
--
-- Thinking inside the query
-- ─────────────────────────
-- 1.  Use the public table  fh-bigquery.hackernews.full_partition_extra.
-- 2.  Keep only rows that are comments (type = 'comment'), have non-NULL text,
--     are on/after 2014-01-01, and contain an SO question-URL substring.
-- 3.  REGEXP_EXTRACT_ALL pulls every SO question-URL from each comment.  
--     Pattern:  https?://stackoverflow\.com/questions/<digits><tail>  
--     where <tail> continues until a space, quote, or “<”.
-- 4.  UNNEST turns that array into one row per URL occurrence.
-- 5.  Retain only URLs holding a “|”, because everything after the first “|”
--     is the pipe-delimited tag list (e.g. “…|python|pandas” ⇒ "python|pandas").
-- 6.  Collapse identical question URLs to count how many times each question
--     is mentioned across all comments (q_count).
-- 7.  Split each question’s tag list, explode to one row per {tag, question},
--     weight each tag by q_count, aggregate, sort, and limit to the Top 10.
WITH question_counts AS (
  SELECT
    REGEXP_EXTRACT(so_url,
      'https?://stackoverflow\\.com/questions/[0-9]+')  AS question_base,
    REGEXP_EXTRACT(so_url, '\\|(.*)$')                  AS tag_string,
    COUNT(*)                                            AS q_count
  FROM
    `fh-bigquery.hackernews.full_partition_extra`,
    UNNEST(
      REGEXP_EXTRACT_ALL(
        COALESCE(text, ''),
        'https?://stackoverflow\\.com/questions/[0-9]+[^"\'< ]*')
    ) AS so_url
  WHERE
    type = 'comment'
    AND timestamp >= '2014-01-01'
    AND REGEXP_CONTAINS(so_url, '\\|')                  -- only URLs that carry tags
  GROUP BY question_base, tag_string
)
SELECT
  tag,
  SUM(q_count) AS tag_mentions
FROM
  question_counts,
  UNNEST(SPLIT(tag_string, '|')) AS tag
GROUP BY tag
ORDER BY tag_mentions DESC
LIMIT 10;
