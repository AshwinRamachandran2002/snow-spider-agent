```sql
--Description: 4)  Count how many times every Stack Overflow question URL
--              is referenced in comments from 2014-01-01 onward.
SELECT
  so_url,
  COUNT(*) AS mentions
FROM (
  SELECT
    REGEXP_EXTRACT(`text`,
                    r'(https?://stackoverflow\.com/questions/[0-9]+[^"''<\s]*)')
      AS so_url
  FROM
    `fh-bigquery.hackernews.comments`
  WHERE
    `time_ts` >= '2014-01-01'
    AND LOWER(`text`) LIKE '%stackoverflow.com/questions/%'
)
GROUP BY so_url
ORDER BY mentions DESC
LIMIT 20;
```

```sql
--Description: 5)  Inspect only those Stack Overflow URLs that contain the “|”
--              character (these usually hold the tag list we need).
SELECT
  so_url
FROM (
