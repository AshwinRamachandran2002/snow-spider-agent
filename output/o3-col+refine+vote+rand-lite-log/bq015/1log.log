    REGEXP_EXTRACT(`text`,
                    r'(https?://stackoverflow\.com/questions/[0-9]+[^"''<\s]*)')
      AS so_url
  FROM
    `fh-bigquery.hackernews.comments`
  WHERE
    `time_ts` >= '2014-01-01'
    AND LOWER(`text`) LIKE '%stackoverflow.com/questions/%'
)
WHERE
  so_url IS NOT NULL
  AND REGEXP_CONTAINS(so_url, r'\|')
LIMIT 20;
```

```sql
--Description: 6)  For URLs with “|”, pull out everything after the first “|”.
--              That substring is the pipe-delimited tag list attached to the
--              Stack Overflow question.
SELECT
  so_url,
  REGEXP_EXTRACT(so_url, r'\|(.*)$') AS tag_string
FROM (
  SELECT DISTINCT
    REGEXP_EXTRACT(`text`,
                    r'(https?://stackoverflow\.com/questions/[0-9]+[^"''<\s]*)')
      AS so_url
  FROM
    `fh-bigquery.hackernews.comments`
  WHERE
    `time_ts` >= '2014-01-01'
    AND LOWER(`text`) LIKE '%stackoverflow.com/questions/%'
)
WHERE
  so_url IS NOT NULL
  AND REGEXP_CONTAINS(so_url, r'\|')
LIMIT 20;
```

```sql
--Description: 7)  Explode those tag strings into individual tags so we can
--              aggregate counts per tag.
SELECT
  tag
FROM (
  SELECT
    REGEXP_EXTRACT(so_url, r'\|(.*)$') AS tag_string
  FROM (
    SELECT DISTINCT
      REGEXP_EXTRACT(`text`,
                      r'(https?://stackoverflow\.com/questions/[0-9]+[^"''<\s]*)')
        AS so_url
    FROM
      `fh-bigquery.hackernews.comments`
    WHERE
      `time_ts` >= '2014-01-01'
      AND LOWER(`text`) LIKE '%stackoverflow.com/questions/%'
  )
  WHERE
    so_url IS NOT NULL
    AND REGEXP_CONTAINS(so_url, r'\|')
), UNNEST(SPLIT(tag_string, '|')) AS tag
LIMIT 20;
```

```sql
--Description: 8)  Count how many *comments* mention each Stack Overflow tag
--              (after splitting by “|”) and list the ten most-referenced tags.
SELECT
  tag,
  COUNT(*) AS tag_mentions
FROM (
  -- one row per comment per tag -------------------------------
  SELECT
    c.`id`                       AS comment_id,
    t.tag                        AS tag
  FROM
    `fh-bigquery.hackernews.comments` AS c,
    UNNEST([REGEXP_EXTRACT(c.`text`,
            r'(https?://stackoverflow\.com/questions/[0-9]+[^"''<\s]*)')]) AS so_url
  JOIN
    UNNEST(SPLIT(REGEXP_EXTRACT(so_url, r'\|(.*)$'), '|')) AS t(tag)
  WHERE
    c.`time_ts` >= '2014-01-01'
    AND so_url IS NOT NULL
    AND REGEXP_CONTAINS(so_url, r'\|')
)
GROUP BY tag
ORDER BY tag_mentions DESC
LIMIT 10;
```

