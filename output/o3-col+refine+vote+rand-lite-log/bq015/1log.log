--Description: One-shot query to find the ten Stack Overflow tags most often
--             referenced in Hacker News comments dated 2014-01-01 or later.
--             Logic inside the query:
--               • Scan full_partition_extra for rows whose type='comment',
--                 timestamp ≥ 2014-01-01, and whose text contains at least one
--                 Stack Overflow question-URL.  
--               • REGEXP_EXTRACT_ALL pulls every SO URL from each comment;  
--                 UNNEST turns that list into one row per URL occurrence
--                 (capturing multiple links in the same comment).  
--               • Keep only URLs that include a “|” because, in SO’s short-link
--                 format, everything after the first “|” is a pipe-delimited
--                 tag list (e.g. “…/12345678/foo|python|pandas”).  
--               • Group by the canonical question URL so we know how many times
--                 that specific question was mentioned across all comments.  
--               • Split each question’s tag list on “|”, explode to one row per
--                 {tag, question} pair, and weight each tag by the number of
--                 times its question appeared (q_count).  
--               • Sum the weighted counts per tag, order, and return Top 10.
WITH question_counts AS (
  SELECT
    REGEXP_EXTRACT(so_url,
      r'https?://stackoverflow\.com/questions/[0-9]+')      AS question_base,
    REGEXP_EXTRACT(so_url, r'\|(.*)$')                      AS tag_string,
    COUNT(*)                                                AS q_count
  FROM
    `fh-bigquery.hackernews.full_partition_extra`,
    UNNEST(
      REGEXP_EXTRACT_ALL(
        COALESCE(text, ''),
        r'https?://stackoverflow\.com/questions/[0-9]+[^"''<\s]*')
    ) AS so_url
  WHERE
    type = 'comment'
    AND timestamp >= '2014-01-01'
    AND REGEXP_CONTAINS(so_url, r'\|')      -- ensure tag list exists
  GROUP BY question_base, tag_string
)
SELECT
  tag,
  SUM(q_count) AS tag_mentions
FROM
  question_counts,
  UNNEST(SPLIT(tag_string, '|')) AS tag
GROUP BY tag
ORDER BY tag_mentions DESC
LIMIT 10;
