--Description: One-shot query (reasoning embedded) that answers the problem:
--             “Which ten Stack Overflow tags are mentioned most in Hacker News
--             comments on or after 2014-01-01?”
--
-- Data choice & why
-- ──────────────────
--   • Table:  fh-bigquery.hackernews.comments_convolution
--     – Publicly readable (no 403 errors).
--     – Holds every comment plus its plain-text body (`text`) and `timestamp`.
--
-- Steps performed inside the single query
-- ───────────────────────────────────────
--   1.  Filter rows
--         • type = 'comment'
--         • timestamp ≥ '2014-01-01'
--         • text contains “stackoverflow.com/questions/”.
--   2.  REGEXP_EXTRACT_ALL grabs *every* SO question-URL inside each comment.
--         Pattern:  https?://stackoverflow\.com/questions/<digits><tail>
--         The <tail> is any non-space / non-quote / non-“<” char, so no
--         illegal “\s” escape issue.
--   3.  UNNEST turns the array into one row per URL occurrence.
--   4.  Keep only URLs that contain “|”; in SO short links the substring after
--       the first “|” is a “|”-delimited tag list
--       (e.g. “…|python|pandas” ⇒ "python|pandas").
--   5.  Collapse identical question URLs to count how many times each question
--       is referenced across all comments (q_count).
--   6.  Split each question’s tag list, explode to one row per {tag, question},
--       weight each tag by q_count, aggregate, sort, and return Top 10 tags.
WITH question_counts AS (
  SELECT
    REGEXP_EXTRACT(so_url,
      r'https?://stackoverflow\.com/questions/[0-9]+')   AS question_base,
    REGEXP_EXTRACT(so_url, r'\|(.*)$')                   AS tag_string,
    COUNT(*)                                             AS q_count         -- #comment-mentions of this question
  FROM
    `fh-bigquery.hackernews.comments_convolution`,
    UNNEST(
      REGEXP_EXTRACT_ALL(
        COALESCE(text, ''),
        r'https?://stackoverflow\.com/questions/[0-9]+[^"\'< ]*')
    ) AS so_url
  WHERE
    type = 'comment'
    AND timestamp >= '2014-01-01'                        -- comments from 2014 onwards
    AND REGEXP_CONTAINS(so_url, r'\|')                   -- URL must carry tag list
  GROUP BY question_base, tag_string
)
SELECT
  tag,
  SUM(q_count) AS tag_mentions
FROM
  question_counts,
  UNNEST(SPLIT(tag_string, '|')) AS tag                  -- explode individual tags
GROUP BY tag
ORDER BY tag_mentions DESC
LIMIT 10;
