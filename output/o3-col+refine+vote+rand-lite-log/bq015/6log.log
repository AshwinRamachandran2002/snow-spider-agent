```sql
--Description:
--We need to discover which Stack Overflow tags show up most in questions that
--Hacker News commenters linked to (2014-present).  The plan is executed inside
--one query composed of common-table-expressions (CTEs):
--
-- 1. comment_links
--    • Scan the open table `commentsV2`, which holds HN comments.
--    • Keep comments created on/after 2014-01-01 whose text contains the
--      canonical substring “stackoverflow.com/questions/”.
--    • With REGEXP_EXTRACT grab the numeric Stack Overflow question-id
--      (so_qid).  DISTINCT makes each mentioned question appear once, no
--      matter how many comments reference it.
--
-- 2. question_tags
--    • Join those question-ids to HN stories in `full_partition_extra` whose
--      URL points at the same question (this table stores a `tags` array that
--      comes from the Stack Overflow API dump).
--    • UNNEST the `tags` array so each tag becomes its own row.
--
-- 3. Final SELECT
--    • Group by tag, counting how many *comments* mentioned questions carrying
--      that tag (total_mentions).
--    • Return the top-10 tags by that count.
WITH comment_links AS (
  SELECT DISTINCT
         REGEXP_EXTRACT(LOWER(text),
                        r'stackoverflow\.com\/questions\/([0-9]+)') AS so_qid
  FROM   `fh-bigquery.hackernews.commentsV2`
  WHERE  time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
    AND  LOWER(text) LIKE '%stackoverflow.com/questions/%'
    AND  REGEXP_EXTRACT(LOWER(text),
                        r'stackoverflow\.com\/questions\/([0-9]+)') IS NOT NULL
),
question_tags AS (
  SELECT
      cl.so_qid,
      tag
  FROM   comment_links AS cl
  JOIN   `fh-bigquery.hackernews.full_partition_extra` AS fp
         ON REGEXP_EXTRACT(LOWER(fp.url),
              r'stackoverflow\.com\/questions\/([0-9]+)') = cl.so_qid
  LEFT  JOIN UNNEST(fp.tags) AS tag
  WHERE  tag IS NOT NULL
)
SELECT
    tag,
    COUNT(*) AS total_mentions
FROM  question_tags
GROUP BY tag
ORDER BY total_mentions DESC
LIMIT 10;
```
