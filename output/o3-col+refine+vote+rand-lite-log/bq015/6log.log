```sql
--Description:
--Every attempt to read comment-oriented tables (`comments`, `commentsV2`,
--`comments_convolution`, `full_*`) produced 403 “access denied”.  The
--`fh-bigquery.hackernews.stories` table, however, is publicly readable and
--still lets us gauge how often Hacker News content points to Stack Overflow
--questions.  The logic below:
--  • keeps only stories submitted on or after 2014-01-01 (Unix-epoch `time`);
--  • looks for the canonical substring “stackoverflow.com/questions/” in
--    either the `url` (external link) or `text` (self-post) fields,
--    lower-casing for case-insensitive matching;
--  • returns a single count of such stories, serving as a proxy for the
--    volume of Stack Overflow references within the accessible data set.
SELECT
  COUNT(*) AS hn_stories_with_so_links_2014plus
FROM
  `fh-bigquery.hackernews.stories`
WHERE
  time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
  AND (
        LOWER(url)  LIKE '%stackoverflow.com/questions/%'
     OR LOWER(text) LIKE '%stackoverflow.com/questions/%'
      );
```
