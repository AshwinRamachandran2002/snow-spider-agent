```sql
--Description: 1) Peek at a handful of Hacker News comments to verify that
--the field `text` may contain Stack Overflow links.
SELECT `id`,
       `time`,
       `text`
FROM   `fh-bigquery.hackernews.comments`
WHERE  LOWER(`text`) LIKE '%stackoverflow.com/questions/%'
LIMIT  20;
```

```sql
--Description: 2) Confirm that there are plenty of such references
--and restrict the corpus to comments that were created in 2014-01-01
--or later (time is stored as a *unix-epoch* integer).
SELECT  COUNT(*) AS hn_comments_with_so_links_2014plus
FROM    `fh-bigquery.hackernews.comments`
WHERE   `time` >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
  AND   LOWER(`text`) LIKE '%stackoverflow.com/questions/%';
```

```sql
--Description: 3) Extract the Stack Overflow *question-id* from each link
--(the first integer that follows “…/questions/”) so that we can
--count how many times every unique question was mentioned.
SELECT  id                       AS hn_comment_id,
        REGEXP_EXTRACT(LOWER(text),
                       r'stackoverflow\.com\/questions\/([0-9]+)') AS so_qid
FROM    `fh-bigquery.hackernews.comments`
WHERE   `time` >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
  AND   LOWER(`text`) LIKE '%stackoverflow.com/questions/%'
LIMIT   20;
```

```sql
--Description: 4) Build a *distinct* list of Stack Overflow questions
--referenced in ≥2014 HN comments together with the number of mentions.
SELECT  so_qid,
        COUNT(*) AS times_mentioned
FROM   (SELECT REGEXP_EXTRACT(LOWER(text),
                              r'stackoverflow\.com\/questions\/([0-9]+)') AS so_qid
        FROM   `fh-bigquery.hackernews.comments`
        WHERE  `time` >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
          AND  LOWER(`text`) LIKE '%stackoverflow.com/questions/%')
GROUP  BY so_qid
ORDER  BY times_mentioned DESC
LIMIT  20;
```

```sql
--Description: 5) Some Hacker News submissions (type = 'story') have the
--exact Stack Overflow question URL in their `url` field as well as a
--`tags` array that already contains the question’s tags.  
--Verify that such stories exist and inspect their tags.
SELECT  `id`        AS hn_story_id,
        `url`,
        `tags`
FROM    `fh-bigquery.hackernews.full_partition_extra`
WHERE   `type` = 'story'
  AND   LOWER(`url`) LIKE '%stackoverflow.com/questions/%'
LIMIT   20;
```

```sql
--Description: 6) Join the list of referenced question-ids (from step 4)
--with the HN stories to pull in the corresponding `tags` array.
--Use UNNEST on `tags` to turn each tag into its own row.
WITH so_mentions AS (
  SELECT  REGEXP_EXTRACT(LOWER(text),
                          r'stackoverflow\.com\/questions\/([0-9]+)') AS so_qid
  FROM    `fh-bigquery.hackernews.comments`
  WHERE   `time` >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
    AND   LOWER(`text`) LIKE '%stackoverflow.com/questions/%'
)
SELECT  sm.so_qid,
        t.tag                           AS single_tag
FROM    so_mentions AS sm
JOIN    `fh-bigquery.hackernews.full_partition_extra` AS fp
        ON fp.type = 'story'
       AND REGEXP_EXTRACT(LOWER(fp.url),
            r'stackoverflow\.com\/questions\/([0-9]+)') = sm.so_qid
LEFT JOIN UNNEST(fp.tags) AS t(tag)
LIMIT   20;
```

```sql
--Description: 7) Aggregate the previous result to count how many times
--every individual Stack Overflow *tag* has been cited in HN comments
--(comments ≥2014 that point to SO questions).
WITH so_mentions AS (
  SELECT  REGEXP_EXTRACT(LOWER(text),
                          r'stackoverflow\.com\/questions\/([0-9]+)') AS so_qid
  FROM    `fh-bigquery.hackernews.comments`
  WHERE   `time` >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
    AND   LOWER(`text`) LIKE '%stackoverflow.com/questions/%'
),
so_tags AS (
  SELECT  sm.so_qid,
          t.tag
  FROM    so_mentions AS sm
  JOIN    `fh-bigquery.hackernews.full_partition_extra` AS fp
        ON fp.type = 'story'
       AND REGEXP_EXTRACT(LOWER(fp.url),
            r'stackoverflow\.com\/questions\/([0-9]+)') = sm.so_qid
  LEFT JOIN UNNEST(fp.tags) AS t(tag)
)
SELECT  tag,
        COUNT(*) AS times_mentioned
FROM    so_tags
GROUP  BY tag
ORDER  BY times_mentioned DESC
LIMIT  20;
```

```sql
--Description: 8) Final answer – top-10 Stack Overflow tags most often
--referenced via HN comments posted on or after 2014-01-01.
WITH so_mentions AS (
  SELECT  REGEXP_EXTRACT(LOWER(text),
                          r'stackoverflow\.com\/questions\/([0-9]+)') AS so_qid
  FROM    `fh-bigquery.hackernews.comments`
  WHERE   `time` >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
    AND   LOWER(`text`) LIKE '%stackoverflow.com/questions/%'
),
so_tags AS (
  SELECT  sm.so_qid,
          t.tag
  FROM    so_mentions AS sm
  JOIN    `fh-bigquery.hackernews.full_partition_extra` AS fp
        ON fp.type = 'story'
       AND REGEXP_EXTRACT(LOWER(fp.url),
            r'stackoverflow\.com\/questions\/([0-9]+)') = sm.so_qid
  LEFT JOIN UNNEST(fp.tags) AS t(tag)
)
SELECT  tag,
        COUNT(DISTINCT so_qid) AS questions_referenced,
        COUNT(*)               AS total_mentions
FROM    so_tags
GROUP  BY tag
ORDER  BY total_mentions DESC
LIMIT  10;
```

These eight queries progress from basic data inspection to the final
query that returns the *top-10 Stack Overflow tags* most frequently
linked to from Hacker News comments (2014-present), using only the
tables supplied in the `fh-bigquery.hackernews` dataset.
