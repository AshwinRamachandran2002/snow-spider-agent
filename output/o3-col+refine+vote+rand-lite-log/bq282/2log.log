     ON t.`start_station_id` = start_meta.`station_id`
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS end_meta
     ON CAST(t.`end_station_id` AS INT64) = end_meta.`station_id`
WHERE t.`start_station_id` <> CAST(t.`end_station_id` AS INT64)
  AND start_meta.`council_district` IS NOT NULL
  AND start_meta.`council_district` = end_meta.`council_district`
LIMIT 20;
