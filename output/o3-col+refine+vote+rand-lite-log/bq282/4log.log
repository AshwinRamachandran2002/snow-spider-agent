```sql
--Description / Thinking process:
-- Goal: find the council district with the MOST bike-share trips that
--       ① start and end at *different* stations,
--       ② both stations are currently *active*,
--       ③ both stations lie in the *same* council district.
--
-- Steps implemented below:
--   a) Join trips (t) to their START station (s1) on start_station_id.
--   b) Join trips to END station (s2) using SAFE_CAST on end_station_id
--      so non-numeric strings (e.g. 'Event') safely become NULL and drop
--      out of the join, eliminating “Bad int64 value” errors.
--   c) Keep only rows where s1.status and s2.status are 'active'.
--   d) Enforce same council_district and different station_id.
--   e) Aggregate by district, order by descending trip count,
--      and return the single district with the highest count.
SELECT
  s1.council_district AS top_district
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`    AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s1
  ON t.start_station_id = s1.station_id
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s2
  ON SAFE_CAST(t.end_station_id AS INT64) = s2.station_id
WHERE LOWER(s1.status) = 'active'
  AND LOWER(s2.status) = 'active'
  AND s1.council_district = s2.council_district   -- same district
  AND s1.station_id      <> s2.station_id         -- different stations
GROUP BY top_district
ORDER BY COUNT(*) DESC
LIMIT 1;
```
