FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips` AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s1
  ON t.`start_station_id` = s1.`station_id`
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s2
  ON CAST(t.`end_station_id` AS INT64) = s2.`station_id`
WHERE LOWER(s1.`status`) = 'active'
  AND LOWER(s2.`status`) = 'active'
LIMIT 20;
```

```sql
--Description: 7) Keep only trips that start & end in the *same* district,
--               but happen at *different* active stations
SELECT t.`trip_id`,
       s1.`station_id`  AS start_station,
       s2.`station_id`  AS end_station,
       s1.`council_district` AS the_district
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`  AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s1
  ON t.`start_station_id` = s1.`station_id`
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s2
  ON CAST(t.`end_station_id` AS INT64) = s2.`station_id`
WHERE LOWER(s1.`status`) = 'active'
  AND LOWER(s2.`status`) = 'active'
  AND s1.`council_district` = s2.`council_district`
  AND s1.`station_id`       <> s2.`station_id`
LIMIT 20;
```

```sql
--Description: 8) Count those qualifying trips by district and order by most trips
SELECT s1.`council_district` AS district,
       COUNT(*)              AS trip_cnt
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips` AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s1
  ON t.`start_station_id` = s1.`station_id`
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s2
  ON CAST(t.`end_station_id` AS INT64) = s2.`station_id`
WHERE LOWER(s1.`status`) = 'active'
  AND LOWER(s2.`status`) = 'active'
  AND s1.`council_district` = s2.`council_district`
  AND s1.`station_id`       <> s2.`station_id`
GROUP BY district
ORDER BY trip_cnt DESC
LIMIT 20;
```

```sql
--Description: 9) Same as (8) but returning only the district with the *highest* count
SELECT district
FROM (
  SELECT s1.`council_district` AS district,
         COUNT(*)              AS trip_cnt
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips` AS t
  JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s1
    ON t.`start_station_id` = s1.`station_id`
  JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s2
    ON CAST(t.`end_station_id` AS INT64) = s2.`station_id`
  WHERE LOWER(s1.`status`) = 'active'
    AND LOWER(s2.`status`) = 'active'
    AND s1.`council_district` = s2.`council_district`
    AND s1.`station_id`       <> s2.`station_id`
  GROUP BY district
  ORDER BY trip_cnt DESC
  LIMIT 1
)
LIMIT 20;
```

```sql
--Description: 10) Using a window function to get the same single answer (highest-trip district)
SELECT district
FROM (
  SELECT s1.`council_district` AS district,
         COUNT(*)              AS trip_cnt,
         RANK() OVER (ORDER BY COUNT(*) DESC) AS rnk
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips` AS t
  JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s1
    ON t.`start_station_id` = s1.`station_id`
  JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s2
    ON CAST(t.`end_station_id` AS INT64) = s2.`station_id`
  WHERE LOWER(s1.`status`) = 'active'
    AND LOWER(s2.`status`) = 'active'
    AND s1.`council_district` = s2.`council_district`
    AND s1.`station_id`       <> s2.`station_id`
  GROUP BY district
)
WHERE rnk = 1
LIMIT 20;
```

Running either of the last two queries will return a single row.  
That numeric value is the active Austin council-district with the most bike trips that both start and end inside it while involving *different* stations.
