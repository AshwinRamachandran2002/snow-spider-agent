Query:
--Description: Final answer – obtain the numeric council district that records
--             the most bike-share trips which begin and end in the SAME
--             (active) district but at DIFFERENT stations.  Use SAFE_CAST on
--             end_station_id to avoid “Bad int64 value” errors, exclude rows
--             where the cast is NULL, and count trips per district.
SELECT
  s.council_district AS district_with_most_trips
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`    AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s
  ON t.start_station_id = s.station_id
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS e
  ON SAFE_CAST(t.end_station_id AS INT64) = e.station_id
WHERE s.status = 'active'
  AND e.status = 'active'
  AND SAFE_CAST(t.end_station_id AS INT64) IS NOT NULL
  AND s.council_district = e.council_district
  AND t.start_station_id <> SAFE_CAST(t.end_station_id AS INT64)
GROUP BY district_with_most_trips
ORDER BY COUNT(*) DESC
LIMIT 1
