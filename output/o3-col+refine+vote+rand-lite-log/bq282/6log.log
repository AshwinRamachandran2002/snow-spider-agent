```sql
--Description / Thinking process:
-- Goal: return the numeric council district that (today) has the greatest number
--       of bike-share trips whose start and end stations are in the SAME
--       district but are DIFFERENT stations, considering only ACTIVE stations.
--
-- Steps inside the query:
--   1. CTE active_stations : keep only stations whose status = 'active'.
--   2. CTE paired_trips    : join each trip to its active start- and end-
--      stations (SAFE_CAST end_station_id because it is stored as STRING);
--      keep rows where both stations exist, belong to the same district, yet
--      have different station_ids.
--   3. Aggregate paired_trips by council district, order by trip count, fetch
--      the single district with the highest count.

WITH active_stations AS (
  SELECT station_id, council_district
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  WHERE status = 'active'
),
paired_trips AS (
  SELECT
    s.council_district AS district
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips` AS t
  JOIN active_stations AS s
    ON t.start_station_id = s.station_id
  JOIN active_stations AS e
    ON SAFE_CAST(t.end_station_id AS INT64) = e.station_id
  WHERE
        SAFE_CAST(t.end_station_id AS INT64) IS NOT NULL     -- drop bad IDs
    AND t.start_station_id <> SAFE_CAST(t.end_station_id AS INT64) -- different stations
    AND s.council_district = e.council_district                   -- same district
)
SELECT district
FROM paired_trips
GROUP BY district
ORDER BY COUNT(*) DESC
LIMIT 1;
```
