-- 6. Description:  Bring in both start- and end-stations (only active ones)  
--                 and keep trips where both belong to the *same* district but different stations.  
SELECT t.`trip_id`,
       s.`council_district` AS district,
       t.`start_station_id`,
       CAST(t.`end_station_id` AS INT64) AS end_station_id
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`    AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s
  ON t.`start_station_id` = s.`station_id`
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS e
  ON CAST(t.`end_station_id` AS INT64) = e.`station_id`
WHERE s.`status` = 'active'
  AND e.`status` = 'active'
  AND s.`council_district` = e.`council_district`
  AND t.`start_station_id` <> CAST(t.`end_station_id` AS INT64)
LIMIT 20;
