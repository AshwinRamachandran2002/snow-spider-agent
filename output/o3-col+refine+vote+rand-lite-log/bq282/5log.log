Query:
--Description: 3)  Attach the START station’s council district to a sample
--              of trips (casting the IDs so they match).
SELECT t.trip_id,
       t.start_station_id,
       s.council_district AS start_council_district
FROM   `bigquery-public-data.austin_bikeshare.bikeshare_trips` AS t
JOIN   `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s
       ON s.station_id = t.start_station_id
WHERE  s.council_district IS NOT NULL
LIMIT  20;
