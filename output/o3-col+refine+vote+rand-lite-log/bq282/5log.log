```sql
--Description: 5)  Show only trips in which the start- and end-stations are in the
--              SAME council district but are NOT the same station.
SELECT t.trip_id,
       s1.council_district            AS council_district,
       t.start_station_id,
       t.end_station_id
FROM   `bigquery-public-data.austin_bikeshare.bikeshare_trips`  AS t
JOIN   `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s1
       ON s1.station_id = t.start_station_id
JOIN   `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s2
       ON s2.station_id = CAST(t.end_station_id AS INT64)
WHERE  s1.council_district = s2.council_district         -- same district
  AND  t.start_station_id  <> CAST(t.end_station_id AS INT64)  -- different station
LIMIT  20;
```

```sql
--Description: 6)  Aggregate the number of such trips per council district.
SELECT s1.council_district                 AS council_district,
       COUNT(*)                            AS same_dist_diff_station_trips
FROM   `bigquery-public-data.austin_bikeshare.bikeshare_trips`  AS t
JOIN   `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s1
       ON s1.station_id = t.start_station_id
JOIN   `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s2
       ON s2.station_id = CAST(t.end_station_id AS INT64)
WHERE  s1.council_district = s2.council_district
  AND  t.start_station_id  <> CAST(t.end_station_id AS INT64)
GROUP  BY council_district
ORDER  BY same_dist_diff_station_trips DESC
LIMIT  20;
```

```sql
--Description: 7)  Same as #6 but omitting districts that have zero trips just in case.
SELECT council_district
FROM  (
        SELECT s1.council_district AS council_district,
               COUNT(*)            AS trips
        FROM   `bigquery-public-data.austin_bikeshare.bikeshare_trips`  AS t
        JOIN   `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s1
               ON s1.station_id = t.start_station_id
        JOIN   `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s2
               ON s2.station_id = CAST(t.end_station_id AS INT64)
        WHERE  s1.council_district = s2.council_district
          AND  t.start_station_id  <> CAST(t.end_station_id AS INT64)
        GROUP  BY council_district
      )
WHERE  trips > 0
ORDER  BY trips DESC
LIMIT  20;
```

```sql
--Description: 8)  FINAL – returns the numeric council district that has the
--              highest count of trips starting & ending in the same district
--              but at different stations (i.e., the requested answer).
SELECT council_district
FROM  (
        SELECT s1.council_district AS council_district,
               COUNT(*)            AS trips
        FROM   `bigquery-public-data.austin_bikeshare.bikeshare_trips`  AS t
        JOIN   `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s1
               ON s1.station_id = t.start_station_id
        JOIN   `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s2
               ON s2.station_id = CAST(t.end_station_id AS INT64)
        WHERE  s1.council_district = s2.council_district
          AND  t.start_station_id  <> CAST(t.end_station_id AS INT64)
          AND  s1.council_district IS NOT NULL
        GROUP  BY council_district
        ORDER  BY trips DESC
        LIMIT  1
      );
```
