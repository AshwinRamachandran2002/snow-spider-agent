```sql
--Description:
-- Task:  Return the numeric council-district in Austin that records the MOST
--        bike-share trips which (1) begin & end in the same council district
--        but (2) start and end at different stations.
--
-- Thinking process in one pass:
--   1.  Trips table = ride facts.  Each row has start_station_id (INT64) and
--       end_station_id (STRING).  Some end_station_id values are non-numeric
--       text, so SAFE_CAST is mandatory to avoid “Bad int64 value”.
--   2.  Stations table maps station_id → council_district.  Join it twice:
--         • s_start : start station  (t.start_station_id)
--         • s_end   : end   station  (SAFE_CAST(t.end_station_id))
--   3.  Filter rows where both joins succeed, the two stations share the same
--       council_district, and the station IDs differ (to exclude loops).
--   4.  Aggregate COUNT(*) per council_district, sort DESC, pick TOP 1.
--
SELECT
  council_district
FROM (
  SELECT
    s_start.council_district  AS council_district,
    COUNT(*)                  AS trip_cnt
  FROM   `bigquery-public-data.austin_bikeshare.bikeshare_trips`      AS t
  JOIN   `bigquery-public-data.austin_bikeshare.bikeshare_stations`   AS s_start
         ON s_start.station_id = t.start_station_id
  JOIN   `bigquery-public-data.austin_bikeshare.bikeshare_stations`   AS s_end
         ON s_end.station_id = SAFE_CAST(t.end_station_id AS INT64)
  WHERE  s_start.council_district = s_end.council_district                -- same district
    AND  t.start_station_id      <> SAFE_CAST(t.end_station_id AS INT64)  -- diff stations
  GROUP  BY s_start.council_district
)
ORDER BY trip_cnt DESC
LIMIT 1;
```
