Query:
--Description: 7) Same as original #6 but safeguards the CAST with SAFE_CAST
--             to avoid errors from non-numeric end_station_id values; then
--             removes districts with zero qualifying trips.
SELECT
  council_district
FROM (
  SELECT
    s1.council_district AS council_district,
    COUNT(*)            AS trips
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`      AS t
  JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations`   AS s1
       ON s1.station_id = t.start_station_id
  JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations`   AS s2
       ON s2.station_id = SAFE_CAST(t.end_station_id AS INT64)
  WHERE s1.council_district = s2.council_district                     -- same district
    AND t.start_station_id  <> SAFE_CAST(t.end_station_id AS INT64)   -- diff stations
  GROUP BY s1.council_district
)
WHERE trips > 0
ORDER BY trips DESC
LIMIT 20
Answer:
council_district
9
3
1
5
8
10
Query:
--Description: 8) FINAL – returns the single council district with the
--             highest number of trips that start & end in the same district
--             but at different stations, using SAFE_CAST to prevent errors.
SELECT
  council_district
FROM (
  SELECT
    s1.council_district AS council_district,
    COUNT(*)            AS trips
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`      AS t
  JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations`   AS s1
       ON s1.station_id = t.start_station_id
  JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations`   AS s2
       ON s2.station_id = SAFE_CAST(t.end_station_id AS INT64)
  WHERE s1.council_district = s2.council_district                     -- same district
    AND t.start_station_id  <> SAFE_CAST(t.end_station_id AS INT64)   -- diff stations
    AND s1.council_district IS NOT NULL
  GROUP BY s1.council_district
  ORDER BY trips DESC
  LIMIT 1
)
Answer:
council_district
9
