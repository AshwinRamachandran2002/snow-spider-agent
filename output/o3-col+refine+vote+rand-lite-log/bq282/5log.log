Query:
--Description: 4)  Attach the END station’s council district as well.
SELECT t.trip_id,
       t.start_station_id,
       t.end_station_id,
       s1.council_district AS start_council_district,
       s2.council_district AS end_council_district
FROM   `bigquery-public-data.austin_bikeshare.bikeshare_trips`  AS t
JOIN   `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s1
       ON s1.station_id = t.start_station_id
JOIN   `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s2
       ON s2.station_id = CAST(t.end_station_id AS INT64)
WHERE  s1.council_district IS NOT NULL
  AND  s2.council_district IS NOT NULL
LIMIT  20;
