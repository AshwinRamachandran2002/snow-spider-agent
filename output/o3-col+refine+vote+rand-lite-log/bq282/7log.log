Query:
-- Description: 4) Join trips to their start-station information (only active
--              stations) to inspect how many trips we keep after the join.
SELECT COUNT(*) AS trips_with_active_start_station
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips` AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s
  ON t.start_station_id = s.station_id
WHERE s.status = 'active'
LIMIT 20;
