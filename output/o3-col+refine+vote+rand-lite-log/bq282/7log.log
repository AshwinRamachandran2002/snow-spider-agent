```sql
-- Description: 1) Look at the different values in the `status` field of the bikeshare
--              stations table so we can later keep only the “active” ones.
SELECT DISTINCT `status`
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
LIMIT 20;
```

```sql
-- Description: 2) See a sample of stations that are currently active
--              together with their council district codes.
SELECT `station_id`,
       `name`,
       `council_district`,
       `status`
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE `status` = 'active'
LIMIT 20;
```

```sql
-- Description: 3) Inspect a handful of trip records, converting the end-station
--              id (stored as STRING) to INT64 so that it matches the data type
--              of station_id in the stations table.
SELECT `trip_id`,
       `start_station_id`,
       SAFE_CAST(`end_station_id` AS INT64) AS end_station_id_int,
       `duration_minutes`
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
LIMIT 20;
```

```sql
-- Description: 4) Join trips to their start-station information (only active
--              stations) to inspect how many trips we keep after the join.
SELECT COUNT(*) AS trips_with_active_start_station
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips` AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s
  ON t.start_station_id = s.station_id
WHERE s.status = 'active'
LIMIT 20;
```

```sql
-- Description: 5) Join trips to both start- and end-station tables (each of
--              them filtered to “active” stations only) and keep trips whose
--              start and end council districts are the same while the actual
--              station IDs differ.
SELECT t.trip_id,
       s1.council_district AS start_cd,
       s2.council_district AS end_cd,
       t.start_station_id,
       SAFE_CAST(t.end_station_id AS INT64) AS end_station_id_int
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips` AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s1
  ON t.start_station_id = s1.station_id AND s1.status = 'active'
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s2
  ON SAFE_CAST(t.end_station_id AS INT64) = s2.station_id AND s2.status = 'active'
WHERE s1.council_district = s2.council_district
  AND t.start_station_id <> SAFE_CAST(t.end_station_id AS INT64)
LIMIT 20;
```

```sql
-- Description: 6) Aggregate the previous query to count, by council district,
--              the number of trips that start and end in the same district but
--              at different stations (active only).
SELECT s1.council_district AS council_district,
       COUNT(*)             AS trip_cnt
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips` AS t
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s1
  ON t.start_station_id = s1.station_id AND s1.status = 'active'
JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s2
  ON SAFE_CAST(t.end_station_id AS INT64) = s2.station_id AND s2.status = 'active'
WHERE s1.council_district = s2.council_district
  AND t.start_station_id <> SAFE_CAST(t.end_station_id AS INT64)
GROUP BY council_district
ORDER BY trip_cnt DESC
LIMIT 20;
```

```sql
-- Description: 7) Fetch only the council district with the highest such trip
--              count (i.e., answer to the question).
SELECT council_district
FROM (
      SELECT s1.council_district AS council_district,
             COUNT(*)            AS trip_cnt,
             ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn
      FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips` AS t
      JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s1
        ON t.start_station_id = s1.station_id AND s1.status = 'active'
      JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s2
        ON SAFE_CAST(t.end_station_id AS INT64) = s2.station_id AND s2.status = 'active'
      WHERE s1.council_district = s2.council_district
        AND t.start_station_id <> SAFE_CAST(t.end_station_id AS INT64)
      GROUP BY s1.council_district
     )
WHERE rn = 1
LIMIT 20;
```

```sql
-- Description: 8) Return both the winning council district and the exact number
--              of qualifying trips, just for reference / validation.
SELECT council_district,
       trip_cnt
FROM (
      SELECT s1.council_district AS council_district,
             COUNT(*)            AS trip_cnt,
             ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn
      FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips` AS t
      JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s1
        ON t.start_station_id = s1.station_id AND s1.status = 'active'
      JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s2
        ON SAFE_CAST(t.end_station_id AS INT64) = s2.station_id AND s2.status = 'active'
      WHERE s1.council_district = s2.council_district
        AND t.start_station_id <> SAFE_CAST(t.end_station_id AS INT64)
      GROUP BY s1.council_district
     )
WHERE rn = 1
LIMIT 20;
```

Running query 7 (or 8) will give you the single numeric value corresponding to the council district that satisfies the stated conditions.
