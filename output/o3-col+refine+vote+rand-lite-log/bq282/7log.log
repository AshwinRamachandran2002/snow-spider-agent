Query:
-- Description: 7) Fetch only the council district with the highest such trip
--              count (i.e., answer to the question).
SELECT council_district
FROM (
      SELECT s1.council_district AS council_district,
             COUNT(*)            AS trip_cnt,
             ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn
      FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips` AS t
      JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s1
        ON t.start_station_id = s1.station_id AND s1.status = 'active'
      JOIN `bigquery-public-data.austin_bikeshare.bikeshare_stations` AS s2
        ON SAFE_CAST(t.end_station_id AS INT64) = s2.station_id AND s2.status = 'active'
      WHERE s1.council_district = s2.council_district
        AND t.start_station_id <> SAFE_CAST(t.end_station_id AS INT64)
      GROUP BY s1.council_district
     )
WHERE rn = 1
LIMIT 20;
