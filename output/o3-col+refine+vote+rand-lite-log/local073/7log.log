```sql
-- Description: (Putting it all together) Build the final, alphabetised ingredient list per order
SELECT o."row_id",
       o."order_id",
       o."customer_id",
       n."pizza_name"                                       AS "pizza",
       o."order_time",
       /* 1. Start with recipe toppings                       */
       /* 2. Remove exclusions                                */
       /* 3. Add extras                                       */
       /* 4. Handle duplicates (2x) & alphabetise             */
       GROUP_CONCAT(
         CASE
           WHEN cnt > 1 THEN '2x ' || topping_name
           ELSE topping_name
         END,
         ', '
       ) AS "final_ingredients"
FROM   (
         /* explode every relevant topping (recipe, extra, exclusion) into rows */
         SELECT o."order_id",
                o."customer_id",
                COALESCE(e."row_id", x."row_id", 0) AS "row_id",
                o."order_time",
                o."pizza_id",
                t_all."topping_id",
                t_all."topping_name",
                SUM(is_extra)      AS extra_flag,
                SUM(is_recipe)     AS recipe_flag,
                SUM(is_exclusion)  AS exclusion_flag
         FROM   "pizza_customer_orders" AS o
         /* recipe toppings */
         JOIN   "pizza_recipes" AS r
                ON r."pizza_id" = o."pizza_id"
         JOIN   "pizza_toppings" AS t_all
                ON ',' || r."toppings" || ',' LIKE '%,' || t_all."topping_id" || ',%'
         LEFT JOIN "pizza_get_extras" AS e
                ON e."order_id" = o."order_id"
         LEFT JOIN "pizza_get_exclusions" AS x
                ON x."order_id" = o."order_id"
         LEFT JOIN "pizza_toppings" AS te
                ON te."topping_id" = e."extras"
         LEFT JOIN "pizza_toppings" AS tx
                ON tx."topping_id" = x."exclusions"

         /* tag each row so we can count duplicates later */
         CROSS JOIN (
             SELECT 1 AS is_recipe, 0 AS is_extra, 0 AS is_exclusion
         )
         GROUP BY o."order_id", t_all."topping_id"
       ) AS exploded
JOIN   "pizza_names" AS n ON exploded."pizza_id" = n."pizza_id"
GROUP  BY exploded."row_id",
          exploded."order_id",
          exploded."customer_id",
          n."pizza_name",
          exploded."order_time"
ORDER  BY exploded."row_id"
LIMIT 20;
```
