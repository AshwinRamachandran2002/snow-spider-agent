```sql
-- Description (thinking process inside):
-- We need one output line per “logical pizza order” (= order_id + row_id).
-- For every such record:
--   • start with the recipe toppings (+1 each)
--   • subtract exclusions (-1 each)
--   • add extras ( +extras_count each)
--   • keep toppings whose net count > 0
--   • if a topping’s net count > 1, prefix with “2x ”
--   • alphabetise the labels, join with “, ”, then prepend the pizza name + “: ”
-- PLAN
-- 1. row_ids  : collect all (order_id,row_id) appearing in extras or exclusions;
--               orders without mods will later receive row_id = 0.
-- 2. orders   : duplicate every pizza_customer_orders row for each applicable row_id.
-- 3. recipe   : explode recipe toppings → +1 cnt.
--    extras   : explode extra toppings  → +extras_count cnt.
--    excl     : explode exclusions      → −1 cnt.
-- 4. net_toppings : SUM the counts, keep those with net_cnt>0.
-- 5. ingredients  : turn counts into labels, alphabetise, GROUP_CONCAT.
-- 6. Final SELECT : assemble requested columns and sort by row_id.

WITH row_ids AS (
    SELECT DISTINCT order_id, row_id FROM pizza_get_extras
    UNION
    SELECT DISTINCT order_id, row_id FROM pizza_get_exclusions
),
orders AS (
    SELECT pc.order_id,
           pc.customer_id,
           pc.pizza_id,
           pc.order_time,
           COALESCE(r.row_id, 0) AS row_id
    FROM   pizza_customer_orders pc
    LEFT   JOIN row_ids r USING (order_id)
),
recipe AS (
    SELECT o.row_id, o.order_id, o.customer_id, o.pizza_id, o.order_time,
           t.topping_id, t.topping_name,
           1 AS cnt
    FROM   orders o
    JOIN   pizza_recipes  pr ON pr.pizza_id = o.pizza_id
    JOIN   pizza_toppings t
           ON instr(','||pr.toppings||',', ','||t.topping_id||',')>0
),
extras AS (
    SELECT o.row_id, o.order_id, o.customer_id, o.pizza_id, o.order_time,
           t.topping_id, t.topping_name,
           ge.extras_count AS cnt
    FROM   orders o
    JOIN   pizza_get_extras ge
           ON ge.order_id = o.order_id AND ge.row_id = o.row_id
    JOIN   pizza_toppings t ON t.topping_id = ge.extras
),
excl AS (
    SELECT o.row_id, o.order_id, o.customer_id, o.pizza_id, o.order_time,
           t.topping_id, t.topping_name,
           -1 AS cnt
    FROM   orders o
    JOIN   pizza_get_exclusions gx
           ON gx.order_id = o.order_id AND gx.row_id = o.row_id
    JOIN   pizza_toppings t ON t.topping_id = gx.exclusions
),
net_toppings AS (
    SELECT row_id, order_id, customer_id, pizza_id, order_time,
           topping_id, topping_name,
           SUM(cnt) AS net_cnt
    FROM (
        SELECT * FROM recipe
        UNION ALL
        SELECT * FROM extras
        UNION ALL
        SELECT * FROM excl
    )
    GROUP BY row_id, order_id, customer_id, pizza_id, order_time, topping_id, topping_name
    HAVING net_cnt > 0
),
ingredients AS (
    SELECT row_id, order_id, customer_id, pizza_id, order_time,
           GROUP_CONCAT(label, ', ') AS ingredient_list
    FROM (
        SELECT row_id, order_id, customer_id, pizza_id, order_time,
               CASE WHEN net_cnt > 1
                    THEN printf('%dx %s', net_cnt, topping_name)
                    ELSE topping_name
               END AS label
        FROM   net_toppings
        ORDER  BY topping_name                -- alphabetical for CONCAT ordering
    )
    GROUP BY row_id, order_id, customer_id, pizza_id, order_time
)
SELECT  i.row_id,
        i.order_id,
        i.customer_id,
        pn.pizza_name,
        pn.pizza_name || ': ' || i.ingredient_list AS final_ingredients
FROM    ingredients  i
JOIN    pizza_names pn ON pn.pizza_id = i.pizza_id
ORDER BY i.row_id;
```
