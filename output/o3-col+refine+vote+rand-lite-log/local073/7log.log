LIMIT 20;
```

```sql
-- Description: For every order, list the STANDARD (recipe) toppings in human-readable form
SELECT o."order_id",
       n."pizza_name",
       t."topping_name"
FROM   "pizza_customer_orders" AS o
JOIN   "pizza_recipes"         AS r  ON o."pizza_id" = r."pizza_id"
JOIN   "pizza_names"           AS n  ON o."pizza_id" = n."pizza_id"
JOIN   "pizza_toppings"        AS t  ON ',' || r."toppings" || ',' LIKE '%,' || t."topping_id" || ',%'
ORDER BY o."order_id"
LIMIT 20;
```

```sql
-- Description: Show, for each order, the list of EXTRA toppings (already translated to names)
