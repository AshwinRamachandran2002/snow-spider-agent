FROM   "pizza_get_extras" AS e
JOIN   "pizza_toppings"   AS t  ON e."extras" = t."topping_id"
GROUP  BY e."order_id"
LIMIT 20;
```

```sql
-- Description: Show, for each order, the list of EXCLUDED toppings (already translated to names)
