```sql
--Description:  For every individual row in pizza_customer_orders, assemble the “final” list of toppings by:
--              1. Taking the pizza’s base recipe (json_each over the comma-separated list).
--              2. Removing any toppings that appear in pizza_get_exclusions for that order.
--              3. Adding the toppings that appear in pizza_get_extras, respecting extras_count.
--              4. Summing quantities so we know if a topping appears more than once.
--              5. Translating topping_id → topping_name and prefixing with ‘2x’ when qty > 1.
--              6. Alphabetically ordering the toppings and concatenating them.
--              7. Returning one row per order row_id with: row_id, order_id, customer_id,
--                 pizza_name (forced so Meatlovers=1, all others=2 already holds), and the
--                 “pizza_name: topping1, topping2 …” string.
WITH prep AS (         -- recipe (minus exclusions)  +  extras
    /* -------- default recipe, filter out exclusions -------- */
    SELECT  pc.rowid                              AS row_id,
            pc.order_id,
            pc.customer_id,
            pc.pizza_id,
            CAST(j.value AS INTEGER)              AS topping_id,
            1                                     AS qty
    FROM    pizza_customer_orders pc
    JOIN    pizza_recipes pr             ON pc.pizza_id = pr.pizza_id
    JOIN    json_each('['||pr.toppings||']') j
    LEFT    JOIN pizza_get_exclusions ex
                ON pc.order_id = ex.order_id
               AND CAST(j.value AS INTEGER) = ex.exclusions
    WHERE   ex.exclusions IS NULL
    UNION ALL
    /* ---------------------- extras ------------------------- */
    SELECT  pc.rowid,
            pc.order_id,
            pc.customer_id,
            pc.pizza_id,
            ge.extras                           AS topping_id,
            ge.extras_count                     AS qty
    FROM    pizza_customer_orders pc
    JOIN    pizza_get_extras ge ON pc.order_id = ge.order_id
),
agg AS (    -- collapse duplicates to get total qty per topping_id per row
    SELECT  row_id,
            order_id,
            customer_id,
            pizza_id,
            topping_id,
            SUM(qty) AS qty
    FROM    prep
    GROUP BY row_id, topping_id
),
named AS (  -- convert to topping names & add 2x prefix where needed
    SELECT  a.row_id,
            CASE WHEN a.qty > 1
                 THEN '2x'||pt.topping_name
                 ELSE pt.topping_name
            END AS topping_name
    FROM    agg            a
    JOIN    pizza_toppings pt ON a.topping_id = pt.topping_id
),
list AS (   -- alphabetically order toppings and concat for each row
    SELECT  row_id,
            GROUP_CONCAT(topping_name, ', ') AS toppings_sorted
    FROM   (SELECT row_id, topping_name
            FROM   named
            ORDER  BY row_id, topping_name)
    GROUP BY row_id
)
SELECT  pc.rowid                                   AS row_id,
        pc.order_id,
        pc.customer_id,
        pn.pizza_name,
        pn.pizza_name || ': ' || l.toppings_sorted AS final_set_of_ingredients
FROM    pizza_customer_orders pc
JOIN    pizza_names pn ON pc.pizza_id = pn.pizza_id   -- Meatlovers=1, others=2 already enforced
JOIN    list        l  ON pc.rowid    = l.row_id
ORDER BY pc.rowid;
```
