```sql
--10) (Complex) Produce the near-final ingredient list for every order, counting duplicates,
--    still keeping topping_id form for clarity before converting to names
SELECT DISTINCT
       o."order_id",
       o."customer_id",
       o."pizza_id",
       GROUP_CONCAT(
           CASE
               WHEN cnt > 1 THEN '2x_'||t."topping_name"
               ELSE t."topping_name"
           END,
           ', '
       ) AS "final_toppings"
FROM (
      /* explode recipe, subtract exclusions, add extras, and count occurrences */
      SELECT
          ord."order_id",
          ord."customer_id",
          CAST(value AS INTEGER) AS "topping_id",
          COUNT(*)               AS cnt
      FROM "pizza_customer_orders" ord
      JOIN "pizza_recipes" rec
        ON ord."pizza_id" = rec."pizza_id"
      CROSS JOIN json_each('['||rec."toppings"||']')
      LEFT JOIN "pizza_get_exclusions" ex
        ON ord."order_id" = ex."order_id"
           AND CAST(value AS INTEGER) = ex."exclusions"
      LEFT JOIN "pizza_get_extras"    ext
        ON ord."order_id" = ext."order_id"
      WHERE ex."exclusions" IS NULL  -- remove excluded toppings
      UNION ALL                       -- add extras
      SELECT
          ord."order_id",
          ord."customer_id",
          ext."extras"      AS "topping_id",
          ext."extras_count"
      FROM "pizza_customer_orders" ord
      JOIN "pizza_get_extras" ext
        ON ord."order_id" = ext."order_id"
) AS all_tops
JOIN "pizza_toppings" t
  ON all_tops."topping_id" = t."topping_id"
GROUP BY all_tops."order_id"
LIMIT 20;
```
