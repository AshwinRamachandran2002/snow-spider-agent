),
all_toppings AS (
    SELECT  row_id,
            topping_name,
            SUM(qty) AS cnt
    FROM   (
            SELECT * FROM recipe
            UNION ALL
            SELECT * FROM extras
           )
    GROUP BY row_id, topping_name
),
sorted AS (
    SELECT row_id, topping_name, cnt
    FROM   all_toppings
    ORDER  BY row_id, topping_name           -- ensures alphabetical order
),
ingredients AS (
    SELECT  row_id,
            GROUP_CONCAT(
                CASE WHEN cnt > 1
                     THEN cnt || 'x ' || topping_name
                     ELSE          topping_name
                END,
                ', '
            ) AS ingredient_list
    FROM    sorted
    GROUP BY row_id
)
SELECT
       o.row_id,
       o.order_id,
       o.customer_id,
       pn.pizza_name,
       pn.pizza_name || ': ' || ing.ingredient_list   AS final_ingredients
FROM   orders          AS o
JOIN   pizza_names     AS pn  ON o.pizza_id = pn.pizza_id
JOIN   ingredients     AS ing USING (row_id)
ORDER  BY o.row_id;
