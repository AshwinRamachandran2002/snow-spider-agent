```sql
--Description:  Build the requested output – one line per pizza order that shows
--              (row_id, order_id, customer_id, pizza_name, final ingredient string).
--              Logic:
--   1) “orders” CTE: give every row in pizza_customer_orders a sequential row_id and
--      normalise pizza_id so that only Meatlovers keeps id 1 (all others → 2).
--   2) “recipe”      : all standard toppings for the pizza, but DROP any that appear
--      in pizza_get_exclusions for the same order.
--   3) “extras”      : all toppings added via pizza_get_extras, counting each according
--      to extras_count.
--   4) “all_toppings”: union recipe ∪ extras, then SUM their quantities per
--      (row_id,topping) so we know if something occurs twice (or more).
--   5) “sorted”      : same rows but alphabetically ordered; this guarantees the
--      GROUP_CONCAT that follows returns toppings in A→Z order (older SQLite cannot
--      sort inside the aggregate itself).
--   6) “ingredients” : turn the counts into strings (“2x Bacon”, “Cheese”, …) and
--      concatenate them with “, ”.
--   Final SELECT     : attach pizza_name, prepend “<pizza_name>: ” to the ingredient
--      list, and return the required columns ordered by row_id.
WITH orders AS (
    SELECT
        ROW_NUMBER() OVER (ORDER BY order_id, pizza_id)        AS row_id,
        order_id,
        customer_id,
        CASE WHEN pizza_id = 1 THEN 1 ELSE 2 END              AS pizza_id
    FROM   pizza_customer_orders
),
recipe AS (
    SELECT  o.row_id,
            t.topping_id,
            t.topping_name,
            1 AS qty
    FROM    orders              AS o
    JOIN    pizza_recipes       AS pr  ON o.pizza_id = pr.pizza_id
    JOIN    pizza_toppings      AS t   ON ','||pr.toppings||',' LIKE '%,'||t.topping_id||',%'
    LEFT    JOIN pizza_get_exclusions ex
               ON ex.order_id = o.order_id
              AND ex.exclusions = t.topping_id
    WHERE   ex.order_id IS NULL                      -- remove excluded toppings
),
extras AS (
    SELECT  o.row_id,
            t.topping_id,
            t.topping_name,
            COALESCE(ge.extras_count,1) AS qty
    FROM    orders             AS o
    JOIN    pizza_get_extras   AS ge ON ge.order_id = o.order_id
    JOIN    pizza_toppings     AS t  ON t.topping_id = ge.extras
),
all_toppings AS (
    SELECT  row_id,
            topping_name,
            SUM(qty) AS cnt
    FROM   (
            SELECT * FROM recipe
            UNION ALL
            SELECT * FROM extras
           )
    GROUP BY row_id, topping_name
),
sorted AS (
    SELECT row_id, topping_name, cnt
    FROM   all_toppings
    ORDER  BY row_id, topping_name           -- ensures alphabetical order
),
ingredients AS (
    SELECT  row_id,
            GROUP_CONCAT(
                CASE WHEN cnt > 1
                     THEN cnt || 'x ' || topping_name
                     ELSE          topping_name
                END,
                ', '
            ) AS ingredient_list
    FROM    sorted
    GROUP BY row_id
)
SELECT
       o.row_id,
       o.order_id,
       o.customer_id,
       pn.pizza_name,
       pn.pizza_name || ': ' || ing.ingredient_list   AS final_ingredients
FROM   orders          AS o
JOIN   pizza_names     AS pn  ON o.pizza_id = pn.pizza_id
JOIN   ingredients     AS ing USING (row_id)
ORDER  BY o.row_id;
```
