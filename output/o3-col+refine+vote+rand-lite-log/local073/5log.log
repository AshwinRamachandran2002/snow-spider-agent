```sql
-- Description: Look at extra toppings already parsed per order (one row per extra)
SELECT DISTINCT 
       e.row_id, 
       e.order_id, 
       e.extras        AS extra_topping_id,
       e.extras_count, 
       t.topping_name  AS extra_topping_name
FROM   pizza_get_extras AS e
