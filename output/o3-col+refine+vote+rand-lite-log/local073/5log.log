```

```sql
-- Description: Combine recipe toppings with their names for Meatlovers (pizza_id = 1)
SELECT DISTINCT 
       r.pizza_id, 
       n.pizza_name, 
       t.topping_id, 
       t.topping_name
FROM   pizza_recipes AS r
JOIN   pizza_names   AS n  ON r.pizza_id = n.pizza_id
JOIN   pizza_toppings AS t 
       ON ',' || r.toppings || ',' LIKE '%,' || t.topping_id || ',%'
WHERE  r.pizza_id = 1
LIMIT 20;
```

```sql
-- Description: Preview one order (id = 1) with recipe, minus exclusions, plus extras
SELECT DISTINCT
       1                           AS preview_for_order,
       t.topping_name
FROM   pizza_customer_orders AS o
JOIN   pizza_recipes        AS r  ON o.pizza_id = r.pizza_id
JOIN   pizza_toppings       AS t  ON ',' || r.toppings || ',' LIKE '%,' || t.topping_id || ',%'
WHERE  o.order_id = 1
      AND t.topping_id NOT IN (SELECT exclusions FROM pizza_get_exclusions WHERE order_id = 1)
UNION ALL
SELECT DISTINCT
       1,
       t2.topping_name
FROM   pizza_get_extras   AS e
JOIN   pizza_toppings     AS t2 ON e.extras = t2.topping_id
WHERE  e.order_id = 1
LIMIT 20;
```

```sql
-- Description: Assemble a final ingredient list for all orders (concise preview)
SELECT DISTINCT
       o.order_id,
       n.pizza_name || ': ' ||  
       group_concat(CASE 
                        WHEN cnt = 2 THEN '2x ' || topping_name
                        ELSE topping_name
                    END, ', ' ORDER BY topping_name) AS final_ingredients
FROM (
        -- recipe toppings
        SELECT order_id, topping_id, topping_name, COUNT(*) AS cnt
        FROM (
                SELECT o.order_id,
                       t.topping_id,
                       t.topping_name
                FROM   pizza_customer_orders AS o
                JOIN   pizza_recipes        AS r 
                       ON o.pizza_id = r.pizza_id
                JOIN   pizza_toppings       AS t
                       ON ',' || r.toppings || ',' LIKE '%,' || t.topping_id || ',%'
                WHERE  NOT EXISTS (SELECT 1
                                   FROM   pizza_get_exclusions AS ex
                                   WHERE  ex.order_id = o.order_id
                                   AND    ex.exclusions = t.topping_id)
                UNION ALL
                -- extras
                SELECT e.order_id,
                       t2.topping_id,
                       t2.topping_name
                FROM   pizza_get_extras AS e
                JOIN   pizza_toppings   AS t2 ON e.extras = t2.topping_id
             )
        GROUP BY order_id, topping_id
     ) AS f
JOIN pizza_customer_orders AS o USING(order_id)
JOIN pizza_names           AS n ON o.pizza_id = n.pizza_id
GROUP BY o.order_id
LIMIT 20;
```
