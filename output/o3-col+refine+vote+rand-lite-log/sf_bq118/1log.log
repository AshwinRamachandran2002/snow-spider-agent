Query:
--Description:  Compare, by age group, the average number of deaths per ICD-10 code
--              for (a) “discharge” descriptions (excluding the three barred phrases)
--              and (b) “vehicle” descriptions among White decedents, then return
--              both means and their difference.
WITH discharge AS (      -- average deaths per DISCHARGE code
     SELECT
            x."AgeRecode12",
            AVG(x.cnt) AS avg_deaths_discharge
     FROM (
            SELECT
                   dr."AgeRecode12",
                   dr."Icd10Code",
                   COUNT(*) AS cnt
            FROM   DEATH.DEATH.DEATHRECORDS dr
            JOIN   DEATH.DEATH.ICD10CODE    icd
                   ON dr."Icd10Code" = icd."Code"
            WHERE  dr."RaceRecode3" = 1
              AND  icd."Description" ILIKE '%discharge%'
              AND  icd."Description" NOT ILIKE '%urethral discharge%'
              AND  icd."Description" NOT ILIKE '%discharge of firework%'
              AND  icd."Description" NOT ILIKE '%firearm discharge%'
            GROUP  BY dr."AgeRecode12", dr."Icd10Code"
     ) x
     GROUP BY x."AgeRecode12"
), vehicle AS (           -- average deaths per VEHICLE code
     SELECT
            y."AgeRecode12",
            AVG(y.cnt) AS avg_deaths_vehicle
     FROM (
            SELECT
                   dr."AgeRecode12",
                   dr."Icd10Code",
                   COUNT(*) AS cnt
            FROM   DEATH.DEATH.DEATHRECORDS dr
            JOIN   DEATH.DEATH.ICD10CODE    icd
                   ON dr."Icd10Code" = icd."Code"
            WHERE  dr."RaceRecode3" = 1
              AND  icd."Description" ILIKE '%vehicle%'
            GROUP  BY dr."AgeRecode12", dr."Icd10Code"
     ) y
     GROUP BY y."AgeRecode12"
)
SELECT
       ag12."Code"                                        AS "AgeGrpCode",
       ag12."Description"                                 AS "AgeGrpDesc",
       d.avg_deaths_discharge,
       v.avg_deaths_vehicle,
       (d.avg_deaths_discharge - v.avg_deaths_vehicle)    AS "AvgDifference"
FROM   discharge d
JOIN   vehicle   v
       ON d."AgeRecode12" = v."AgeRecode12"
JOIN   DEATH.DEATH.AGERECODE12 ag12
       ON ag12."Code" = d."AgeRecode12"
ORDER  BY ag12."Code"
LIMIT 20
Answer:
AgeGrpCode,AgeGrpDesc,AVG_DEATHS_DISCHARGE,AVG_DEATHS_VEHICLE,AvgDifference
