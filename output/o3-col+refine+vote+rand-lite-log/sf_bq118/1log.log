```sql
--Description:  We want the mean (average) number of deaths attributable to each distinct
--              ICD-10 code whose description contains the word “discharge” (excluding the
--              three barred phrases) within every age group for White decedents.
--              ---------------------------------------------------------------------------
--              1.  Inner query:
--                    •  Filters DEATHRECORDS to White individuals (RaceRecode3 = 1).
--                    •  Joins to ICD10CODE to keep only rows where the description meets
--                      the “discharge” criterion but not the excluded phrases.
--                    •  Groups by AgeRecode12 and Icd10Code, counting deaths (cnt) for
--                      each (age group, ICD-10) pair.
--              2.  Outer query:
--                    •  Joins the inner results (alias t) to AGERECODE12 to fetch the
--                      human-readable age-group description.
--                    •  Averages the per-code death counts (cnt) within each age group.
--              3.  Returns the age-group code, description, and the computed average.
SELECT
       t."AgeRecode12"                    AS "AgeGrpCode",
       ag12."Description"                 AS "AgeGrpDesc",
       AVG(t.cnt)                         AS "AvgDeathsPerDischargeCode"
FROM (
        SELECT
               dr."AgeRecode12",
               dr."Icd10Code",
               COUNT(*) AS cnt
        FROM   DEATH.DEATH.DEATHRECORDS dr
        JOIN   DEATH.DEATH.ICD10CODE    icd
               ON dr."Icd10Code" = icd."Code"
        WHERE  dr."RaceRecode3" = 1                          -- limit to White decedents
          AND  icd."Description" ILIKE '%discharge%'
          AND  icd."Description" NOT ILIKE '%urethral discharge%'
          AND  icd."Description" NOT ILIKE '%discharge of firework%'
          AND  icd."Description" NOT ILIKE '%firearm discharge%'
        GROUP BY dr."AgeRecode12", dr."Icd10Code"
     ) t
JOIN   DEATH.DEATH.AGERECODE12 ag12
       ON ag12."Code" = t."AgeRecode12"
GROUP BY 1, 2
ORDER BY 1
LIMIT 20;
