```sql
--Description:  Goal → For each age‐group (AgeRecode12) among White decedents,
--              a) compute the mean number of deaths per ICD-10 code whose
--                 description includes “discharge,” EXCEPT the three barred
--                 phrases; 
--              b) compute the mean number of deaths per ICD-10 code whose
--                 description includes “vehicle”;
--              c) return both means and their difference (discharge – vehicle).
--              -----------------------------------------------------------------
--              Step 1 (CTE “discharge”):  Count deaths for every distinct
--              (AgeRecode12, ICD10) pair that meets the discharge criteria, then
--              average those counts across the qualifying ICD-10 codes for that
--              age group.
--              Step 2 (CTE “vehicle”):     Same logic, but for “vehicle”.
--              Step 3:  Join the two CTEs and the age-group lookup table to
--              show the human-readable age-group description and compute the
--              requested difference.
WITH discharge AS (
        SELECT
               dr."AgeRecode12",
               AVG(code_cnt) AS avg_deaths_discharge
        FROM (
               SELECT
                      dr."AgeRecode12",
                      dr."Icd10Code",
                      COUNT(*) AS code_cnt
               FROM   DEATH.DEATH.DEATHRECORDS dr
               JOIN   DEATH.DEATH.ICD10CODE    icd
                      ON dr."Icd10Code" = icd."Code"
               WHERE  dr."RaceRecode3" = 1                       -- White
                 AND  icd."Description" ILIKE '%discharge%'
                 AND  icd."Description" NOT ILIKE '%urethral discharge%'
                 AND  icd."Description" NOT ILIKE '%discharge of firework%'
                 AND  icd."Description" NOT ILIKE '%firearm discharge%'
               GROUP BY dr."AgeRecode12", dr."Icd10Code"
        ) x
        GROUP BY "AgeRecode12"
),
vehicle AS (
        SELECT
               dr."AgeRecode12",
               AVG(code_cnt) AS avg_deaths_vehicle
        FROM (
               SELECT
                      dr."AgeRecode12",
                      dr."Icd10Code",
                      COUNT(*) AS code_cnt
               FROM   DEATH.DEATH.DEATHRECORDS dr
               JOIN   DEATH.DEATH.ICD10CODE    icd
                      ON dr."Icd10Code" = icd."Code"
               WHERE  dr."RaceRecode3" = 1
                 AND  icd."Description" ILIKE '%vehicle%'
               GROUP BY dr."AgeRecode12", dr."Icd10Code"
        ) y
        GROUP BY "AgeRecode12"
)
SELECT
       ag12."Code"                                    AS "AgeGrpCode",
       ag12."Description"                             AS "AgeGrpDesc",
       d.avg_deaths_discharge,
       v.avg_deaths_vehicle,
       (d.avg_deaths_discharge - v.avg_deaths_vehicle) AS "AvgDifference"
FROM   discharge d
JOIN   vehicle   v
       ON d."AgeRecode12" = v."AgeRecode12"
JOIN   DEATH.DEATH.AGERECODE12 ag12
       ON ag12."Code" = d."AgeRecode12"
ORDER BY ag12."Code"
LIMIT 20;
```
