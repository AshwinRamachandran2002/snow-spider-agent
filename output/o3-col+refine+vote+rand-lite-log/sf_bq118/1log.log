```sql
--Description: Join death records (White only) to the age-group lookup to read age-group text.  
SELECT 
       dr."AgeRecode12"               AS "AgeGrpCode",
       ag12."Description"             AS "AgeGrpDesc",
       COUNT(*)                       AS "DeathCount"
FROM   DEATH.DEATH.DEATHRECORDS       dr
JOIN   DEATH.DEATH.AGERECODE12        ag12
       ON dr."AgeRecode12" = ag12."Code"
WHERE  dr."RaceRecode3" = 1
GROUP  BY 1,2
ORDER  BY 1
LIMIT 20;
```

```sql
--Description: Aggregate deaths of Whites whose ICD-10 description qualifies as “discharge” (after exclusions) by age-group.  
SELECT 
       dr."AgeRecode12"                 AS "AgeGrpCode",
       ag12."Description"               AS "AgeGrpDesc",
       COUNT(*)                         AS "Deaths_Discharge"
FROM   DEATH.DEATH.DEATHRECORDS         dr
JOIN   DEATH.DEATH.ICD10CODE            icd
       ON dr."Icd10Code" = icd."Code"
JOIN   DEATH.DEATH.AGERECODE12          ag12
       ON dr."AgeRecode12" = ag12."Code"
WHERE  dr."RaceRecode3" = 1
  AND  icd."Description" ILIKE '%discharge%'
  AND  icd."Description" NOT ILIKE '%urethral discharge%'
  AND  icd."Description" NOT ILIKE '%discharge of firework%'
  AND  icd."Description" NOT ILIKE '%firearm discharge%'
GROUP  BY 1,2
ORDER  BY 1
LIMIT 20;
```

```sql
--Description: Aggregate deaths of Whites whose ICD-10 description contains “vehicle”, grouped by age-group.  
SELECT 
       dr."AgeRecode12"                 AS "AgeGrpCode",
       ag12."Description"               AS "AgeGrpDesc",
       COUNT(*)                         AS "Deaths_Vehicle"
FROM   DEATH.DEATH.DEATHRECORDS         dr
JOIN   DEATH.DEATH.ICD10CODE            icd
       ON dr."Icd10Code" = icd."Code"
JOIN   DEATH.DEATH.AGERECODE12          ag12
       ON dr."AgeRecode12" = ag12."Code"
WHERE  dr."RaceRecode3" = 1
  AND  icd."Description" ILIKE '%vehicle%'
GROUP  BY 1,2
ORDER  BY 1
LIMIT 20;
```

```sql
--Description: For each age-group, calculate the average (mean) deaths per qualifying ICD-10 “discharge” code.  
SELECT 
       dr."AgeRecode12"                                       AS "AgeGrpCode",
       ag12."Description"                                     AS "AgeGrpDesc",
       AVG(cnt)                                               AS "AvgDeathsPerDischargeCode"
FROM  (
        SELECT dr."AgeRecode12",
               dr."Icd10Code",
               COUNT(*) AS cnt
        FROM   DEATH.DEATH.DEATHRECORDS  dr
        JOIN   DEATH.DEATH.ICD10CODE     icd
               ON dr."Icd10Code" = icd."Code"
        WHERE  dr."RaceRecode3" = 1
          AND  icd."Description" ILIKE '%discharge%'
          AND  icd."Description" NOT ILIKE '%urethral discharge%'
          AND  icd."Description" NOT ILIKE '%discharge of firework%'
          AND  icd."Description" NOT ILIKE '%firearm discharge%'
        GROUP  BY dr."AgeRecode12", dr."Icd10Code"
      ) t
JOIN   DEATH.DEATH.AGERECODE12 ag12
       ON t."AgeRecode12" = ag12."Code"
GROUP  BY 1,2
ORDER  BY 1
LIMIT 20;
```

```sql
--Description: For each age-group, calculate the average deaths per ICD-10 “vehicle” code and compare with the discharge averages in one query.  
WITH discharge AS (
        SELECT dr."AgeRecode12",
               AVG(cnt) AS avg_deaths_discharge
        FROM (
              SELECT dr."AgeRecode12", dr."Icd10Code", COUNT(*) AS cnt
              FROM   DEATH.DEATH.DEATHRECORDS dr
              JOIN   DEATH.DEATH.ICD10CODE    icd
                     ON dr."Icd10Code" = icd."Code"
              WHERE  dr."RaceRecode3" = 1
                AND  icd."Description" ILIKE '%discharge%'
                AND  icd."Description" NOT ILIKE '%urethral discharge%'
                AND  icd."Description" NOT ILIKE '%discharge of firework%'
                AND  icd."Description" NOT ILIKE '%firearm discharge%'
              GROUP  BY dr."AgeRecode12", dr."Icd10Code"
        ) x
        GROUP BY "AgeRecode12"
), vehicle AS (
        SELECT dr."AgeRecode12",
               AVG(cnt) AS avg_deaths_vehicle
        FROM (
              SELECT dr."AgeRecode12", dr."Icd10Code", COUNT(*) AS cnt
              FROM   DEATH.DEATH.DEATHRECORDS dr
              JOIN   DEATH.DEATH.ICD10CODE    icd
                     ON dr."Icd10Code" = icd."Code"
              WHERE  dr."RaceRecode3" = 1
                AND  icd."Description" ILIKE '%vehicle%'
              GROUP  BY dr."AgeRecode12", dr."Icd10Code"
        ) y
        GROUP BY "AgeRecode12"
)
SELECT 
       ag12."Code"                                AS "AgeGrpCode",
       ag12."Description"                         AS "AgeGrpDesc",
       d.avg_deaths_discharge,
       v.avg_deaths_vehicle,
       (d.avg_deaths_discharge - v.avg_deaths_vehicle) AS "AvgDifference"
FROM   discharge d
JOIN   vehicle   v        ON d."AgeRecode12" = v."AgeRecode12"
JOIN   DEATH.DEATH.AGERECODE12 ag12
       ON d."AgeRecode12" = ag12."Code"
ORDER  BY ag12."Code"
LIMIT 20;
```
