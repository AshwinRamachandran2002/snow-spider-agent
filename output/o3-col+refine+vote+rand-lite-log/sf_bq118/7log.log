       d.death_cnt                        AS "deaths_discharge",
       v.death_cnt                        AS "deaths_vehicle",
       (d.death_cnt - v.death_cnt)        AS "difference"
FROM   discharge d
FULL JOIN vehicle v
  ON   d."AgeRecode27" = v."AgeRecode27"
ORDER BY 1
LIMIT 20;
