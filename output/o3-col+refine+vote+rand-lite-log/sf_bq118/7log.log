```sql
--Description: 1) Look at a few ICD-10 codes whose text contains the word “discharge” so we can see which exact descriptions exist.
SELECT c."Code",
       c."Description"
FROM   DEATH.DEATH.ICD10CODE c
WHERE  c."Description" ILIKE '%discharge%'
LIMIT 20;
```

```sql
--Description: 2) Check that the three descriptions to be excluded really appear and note their exact wording.
SELECT c."Code",
       c."Description"
FROM   DEATH.DEATH.ICD10CODE c
WHERE  c."Description" ILIKE '%urethral%discharge%'
    OR c."Description" ILIKE '%firework%discharge%'
    OR c."Description" ILIKE '%firearm%discharge%'
LIMIT 20;
```

```sql
--Description: 3) Preview ICD-10 codes whose text contains the word “vehicle”.
SELECT c."Code",
       c."Description"
FROM   DEATH.DEATH.ICD10CODE c
WHERE  c."Description" ILIKE '%vehicle%'
LIMIT 20;
```

```sql
--Description: 4) Pull a small sample of White decedents (RaceRecode3 = 1) together with their underlying ICD-10 code and 27-group age recode to make sure joins line up.
SELECT d."Id",
       d."Icd10Code",
       d."AgeRecode27",
       d."RaceRecode3"
FROM   DEATH.DEATH.DEATHRECORDS d
WHERE  d."RaceRecode3" = 1
LIMIT 20;
```

```sql
--Description: 5) Join death records (White only) to the ICD-10 table for “discharge” descriptions, already excluding the three unwanted phrases, and list a few rows.
SELECT d."Id",
       d."Icd10Code",
       c."Description",
       d."AgeRecode27"
FROM   DEATH.DEATH.DEATHRECORDS    d
JOIN   DEATH.DEATH.ICD10CODE       c
  ON   d."Icd10Code" = c."Code"
WHERE  d."RaceRecode3" = 1
  AND  c."Description" ILIKE '%discharge%'
  AND  c."Description" NOT ILIKE '%urethral%discharge%'
  AND  c."Description" NOT ILIKE '%firework%discharge%'
  AND  c."Description" NOT ILIKE '%firearm%discharge%'
LIMIT 20;
```

```sql
--Description: 6) Join death records (White only) to “vehicle” ICD-10 descriptions and show a few rows with age group.
SELECT d."Id",
       d."Icd10Code",
       c."Description",
       d."AgeRecode27"
FROM   DEATH.DEATH.DEATHRECORDS d
JOIN   DEATH.DEATH.ICD10CODE    c
  ON   d."Icd10Code" = c."Code"
WHERE  d."RaceRecode3" = 1
  AND  c."Description" ILIKE '%vehicle%'
LIMIT 20;
```

```sql
--Description: 7) For Whites, count deaths per 27-group age recode for the filtered “discharge” set.
SELECT d."AgeRecode27",
       COUNT(*) AS "death_count_discharge"
FROM   DEATH.DEATH.DEATHRECORDS d
JOIN   DEATH.DEATH.ICD10CODE    c
  ON   d."Icd10Code" = c."Code"
WHERE  d."RaceRecode3" = 1
  AND  c."Description" ILIKE '%discharge%'
  AND  c."Description" NOT ILIKE '%urethral%discharge%'
  AND  c."Description" NOT ILIKE '%firework%discharge%'
  AND  c."Description" NOT ILIKE '%firearm%discharge%'
GROUP BY d."AgeRecode27"
ORDER BY d."AgeRecode27"
LIMIT 20;
```

```sql
--Description: 8) For Whites, count deaths per 27-group age recode for the “vehicle” set, so we can later compare averages.
SELECT d."AgeRecode27",
       COUNT(*) AS "death_count_vehicle"
FROM   DEATH.DEATH.DEATHRECORDS d
JOIN   DEATH.DEATH.ICD10CODE    c
  ON   d."Icd10Code" = c."Code"
WHERE  d."RaceRecode3" = 1
  AND  c."Description" ILIKE '%vehicle%'
GROUP BY d."AgeRecode27"
ORDER BY d."AgeRecode27"
LIMIT 20;
```

```sql
--Description: 9) Compute the average number of deaths across all age groups for each category (“discharge” vs “vehicle”) in one query.  (Result gives two rows.)
SELECT 'discharge' AS "set_name",
       AVG(death_cnt) AS "avg_deaths"
FROM (
    SELECT d."AgeRecode27",
           COUNT(*) AS death_cnt
    FROM   DEATH.DEATH.DEATHRECORDS d
    JOIN   DEATH.DEATH.ICD10CODE    c
      ON   d."Icd10Code" = c."Code"
    WHERE  d."RaceRecode3" = 1
      AND  c."Description" ILIKE '%discharge%'
      AND  c."Description" NOT ILIKE '%urethral%discharge%'
      AND  c."Description" NOT ILIKE '%firework%discharge%'
      AND  c."Description" NOT ILIKE '%firearm%discharge%'
    GROUP BY d."AgeRecode27"
) q
UNION ALL
SELECT 'vehicle' AS "set_name",
       AVG(death_cnt) AS "avg_deaths"
FROM (
    SELECT d."AgeRecode27",
           COUNT(*) AS death_cnt
    FROM   DEATH.DEATH.DEATHRECORDS d
    JOIN   DEATH.DEATH.ICD10CODE    c
      ON   d."Icd10Code" = c."Code"
    WHERE  d."RaceRecode3" = 1
      AND  c."Description" ILIKE '%vehicle%'
    GROUP BY d."AgeRecode27"
) q
LIMIT 20;
```

```sql
--Description: 10) Finally, create a result that shows for each age group the difference (“discharge” minus “vehicle”) in death counts, plus an overall average difference.
WITH discharge AS (
    SELECT d."AgeRecode27",
           COUNT(*) AS death_cnt
    FROM   DEATH.DEATH.DEATHRECORDS d
    JOIN   DEATH.DEATH.ICD10CODE    c
      ON   d."Icd10Code" = c."Code"
    WHERE  d."RaceRecode3" = 1
      AND  c."Description" ILIKE '%discharge%'
      AND  c."Description" NOT ILIKE '%urethral%discharge%'
      AND  c."Description" NOT ILIKE '%firework%discharge%'
      AND  c."Description" NOT ILIKE '%firearm%discharge%'
    GROUP BY d."AgeRecode27"
),
vehicle AS (
    SELECT d."AgeRecode27",
           COUNT(*) AS death_cnt
    FROM   DEATH.DEATH.DEATHRECORDS d
    JOIN   DEATH.DEATH.ICD10CODE    c
      ON   d."Icd10Code" = c."Code"
    WHERE  d."RaceRecode3" = 1
      AND  c."Description" ILIKE '%vehicle%'
    GROUP BY d."AgeRecode27"
)
SELECT COALESCE(d."AgeRecode27", v."AgeRecode27") AS "AgeRecode27",
       d.death_cnt                        AS "deaths_discharge",
       v.death_cnt                        AS "deaths_vehicle",
       (d.death_cnt - v.death_cnt)        AS "difference"
FROM   discharge d
FULL JOIN vehicle v
  ON   d."AgeRecode27" = v."AgeRecode27"
ORDER BY 1
LIMIT 20;
```
