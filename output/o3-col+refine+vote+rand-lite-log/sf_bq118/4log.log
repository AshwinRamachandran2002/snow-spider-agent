```sql
--Description: Find ICD-10 codes whose descriptions contain the word “discharge”
SELECT DISTINCT c."Code",
       c."Description"
FROM   DEATH.DEATH.ICD10CODE c
WHERE  c."Description" ILIKE '%discharge%'
LIMIT 20;
```

```sql
--Description: Same search, but explicitly exclude “Urethral discharge”,
--             “Discharge of firework”, and “Legal intervention involving firearm discharge”
SELECT DISTINCT c."Code",
       c."Description"
FROM   DEATH.DEATH.ICD10CODE c
WHERE  c."Description" ILIKE '%discharge%'
  AND  c."Description" NOT ILIKE '%urethral%discharge%'
  AND  c."Description" NOT ILIKE '%discharge%firework%'
  AND  c."Description" NOT ILIKE '%firearm%discharge%'
LIMIT 20;
```

```sql
--Description: Find ICD-10 codes whose descriptions contain the word “vehicle”
SELECT DISTINCT c."Code",
       c."Description"
FROM   DEATH.DEATH.ICD10CODE c
WHERE  c."Description" ILIKE '%vehicle%'
LIMIT 20;
```

```sql
--Description: Verify the numeric code that represents “White” in RACERECODE3
SELECT r."Code",
       r."Description"
FROM   DEATH.DEATH.RACERECODE3 r
LIMIT 20;
```

```sql
--Description: Count deaths (WHITE individuals only) whose underlying-cause
--             ICD-10 description contains “discharge” (with exclusions) – by ICD-10 code
SELECT c."Code"              AS "Icd10Code",
       COUNT(*)              AS "death_count"
FROM   DEATH.DEATH.DEATHRECORDS d
JOIN   DEATH.DEATH.ICD10CODE  c
       ON d."Icd10Code" = c."Code"
WHERE  d."RaceRecode3" = 1                      -- White
  AND  c."Description" ILIKE '%discharge%'
  AND  c."Description" NOT ILIKE '%urethral%discharge%'
  AND  c."Description" NOT ILIKE '%discharge%firework%'
  AND  c."Description" NOT ILIKE '%firearm%discharge%'
GROUP  BY c."Code"
ORDER  BY "death_count" DESC
LIMIT 20;
```

```sql
--Description: Count deaths (WHITE individuals only) whose underlying-cause
--             ICD-10 description contains “vehicle” – by ICD-10 code
SELECT c."Code"              AS "Icd10Code",
       COUNT(*)              AS "death_count"
FROM   DEATH.DEATH.DEATHRECORDS d
JOIN   DEATH.DEATH.ICD10CODE  c
       ON d."Icd10Code" = c."Code"
WHERE  d."RaceRecode3" = 1                      -- White
  AND  c."Description" ILIKE '%vehicle%'
GROUP  BY c."Code"
ORDER  BY "death_count" DESC
LIMIT 20;
```

```sql
--Description: Aggregate WHITE-only deaths with qualifying “discharge” codes
--             by the 27-group age recode
SELECT a."Description"        AS "Age_Group",
       COUNT(*)               AS "death_count"
FROM   DEATH.DEATH.DEATHRECORDS d
JOIN   DEATH.DEATH.ICD10CODE  c  ON d."Icd10Code" = c."Code"
JOIN   DEATH.DEATH.AGERECODE27 a ON d."AgeRecode27" = a."Code"
WHERE  d."RaceRecode3" = 1
  AND  c."Description" ILIKE '%discharge%'
  AND  c."Description" NOT ILIKE '%urethral%discharge%'
  AND  c."Description" NOT ILIKE '%discharge%firework%'
  AND  c."Description" NOT ILIKE '%firearm%discharge%'
GROUP  BY a."Description"
ORDER  BY a."Description"
LIMIT 20;
```

```sql
--Description: Aggregate WHITE-only deaths with qualifying “vehicle” codes
--             by the 27-group age recode
SELECT a."Description"        AS "Age_Group",
       COUNT(*)               AS "death_count"
FROM   DEATH.DEATH.DEATHRECORDS d
JOIN   DEATH.DEATH.ICD10CODE  c  ON d."Icd10Code" = c."Code"
JOIN   DEATH.DEATH.AGERECODE27 a ON d."AgeRecode27" = a."Code"
WHERE  d."RaceRecode3" = 1
  AND  c."Description" ILIKE '%vehicle%'
GROUP  BY a."Description"
ORDER  BY a."Description"
LIMIT 20;
```

```sql
--Description: For each age group, compute the average WHITE-only deaths
--             per qualifying “discharge” ICD-10 code
WITH discharge_counts AS (
    SELECT a."Description"     AS "Age_Group",
           c."Code"            AS "Icd10Code",
           COUNT(*)            AS "death_count"
    FROM   DEATH.DEATH.DEATHRECORDS d
    JOIN   DEATH.DEATH.ICD10CODE  c ON d."Icd10Code" = c."Code"
    JOIN   DEATH.DEATH.AGERECODE27 a ON d."AgeRecode27" = a."Code"
    WHERE  d."RaceRecode3" = 1
      AND  c."Description" ILIKE '%discharge%'
      AND  c."Description" NOT ILIKE '%urethral%discharge%'
      AND  c."Description" NOT ILIKE '%discharge%firework%'
      AND  c."Description" NOT ILIKE '%firearm%discharge%'
    GROUP  BY a."Description", c."Code"
)
SELECT "Age_Group",
       AVG("death_count") AS "avg_deaths_per_code_discharge"
FROM   discharge_counts
GROUP  BY "Age_Group"
ORDER  BY "Age_Group"
LIMIT 20;
```

```sql
--Description: For each age group, compute the average WHITE-only deaths
--             per qualifying “vehicle” ICD-10 code
WITH vehicle_counts AS (
    SELECT a."Description"     AS "Age_Group",
           c."Code"            AS "Icd10Code",
           COUNT(*)            AS "death_count"
    FROM   DEATH.DEATH.DEATHRECORDS d
    JOIN   DEATH.DEATH.ICD10CODE  c ON d."Icd10Code" = c."Code"
    JOIN   DEATH.DEATH.AGERECODE27 a ON d."AgeRecode27" = a."Code"
    WHERE  d."RaceRecode3" = 1
      AND  c."Description" ILIKE '%vehicle%'
    GROUP  BY a."Description", c."Code"
)
SELECT "Age_Group",
       AVG("death_count") AS "avg_deaths_per_code_vehicle"
FROM   vehicle_counts
GROUP  BY "Age_Group"
ORDER  BY "Age_Group"
LIMIT 20;
```
