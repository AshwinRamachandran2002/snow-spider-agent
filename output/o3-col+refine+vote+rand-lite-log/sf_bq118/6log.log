Query:
--8.  Compute the average number of deaths per AgeRecode27 group for “discharge” causes (after exclusions)
WITH discharge_cte AS (
    SELECT dr."AgeRecode27",
           COUNT(*) AS death_cnt
    FROM   DEATH.DEATH.DEATHRECORDS  dr
    JOIN   DEATH.DEATH.ICD10CODE     icd ON dr."Icd10Code" = icd."Code"
    WHERE  dr."RaceRecode3" = 1
      AND  LOWER(icd."Description") ILIKE '%discharge%'
      AND  LOWER(icd."Description") NOT ILIKE '%urethral discharge%'
      AND  LOWER(icd."Description") NOT ILIKE '%discharge of firework%'
      AND  LOWER(icd."Description") NOT ILIKE '%firearm discharge%'
    GROUP BY dr."AgeRecode27"
)
SELECT AVG(death_cnt) AS "Avg_Deaths_Discharge"
FROM   discharge_cte
LIMIT 20;
Answer:
Avg_Deaths_Discharge
234.320000
Query:
--9.  Compute the average number of deaths per AgeRecode27 group for “vehicle” causes
WITH vehicle_cte AS (
    SELECT dr."AgeRecode27",
           COUNT(*) AS death_cnt
    FROM   DEATH.DEATH.DEATHRECORDS  dr
    JOIN   DEATH.DEATH.ICD10CODE     icd ON dr."Icd10Code" = icd."Code"
    WHERE  dr."RaceRecode3" = 1
      AND  LOWER(icd."Description") ILIKE '%vehicle%'
    GROUP BY dr."AgeRecode27"
)
SELECT AVG(death_cnt) AS "Avg_Deaths_Vehicle"
FROM   vehicle_cte
LIMIT 20;
Answer:
Avg_Deaths_Vehicle
765.111111
Query:
--10.  Put everything together: show average deaths for both causes and the difference (“discharge” minus “vehicle”)
WITH discharge_cte AS (
    SELECT dr."AgeRecode27",
           COUNT(*) AS death_cnt
    FROM   DEATH.DEATH.DEATHRECORDS  dr
    JOIN   DEATH.DEATH.ICD10CODE     icd ON dr."Icd10Code" = icd."Code"
    WHERE  dr."RaceRecode3" = 1
      AND  LOWER(icd."Description") ILIKE '%discharge%'
      AND  LOWER(icd."Description") NOT ILIKE '%urethral discharge%'
      AND  LOWER(icd."Description") NOT ILIKE '%discharge of firework%'
      AND  LOWER(icd."Description") NOT ILIKE '%firearm discharge%'
    GROUP BY dr."AgeRecode27"
),
vehicle_cte AS (
    SELECT dr."AgeRecode27",
           COUNT(*) AS death_cnt
    FROM   DEATH.DEATH.DEATHRECORDS  dr
    JOIN   DEATH.DEATH.ICD10CODE     icd ON dr."Icd10Code" = icd."Code"
    WHERE  dr."RaceRecode3" = 1
      AND  LOWER(icd."Description") ILIKE '%vehicle%'
    GROUP BY dr."AgeRecode27"
),
avg_discharge AS (SELECT AVG(death_cnt) AS avg_dis FROM discharge_cte),
avg_vehicle   AS (SELECT AVG(death_cnt) AS avg_veh FROM vehicle_cte)
SELECT ad.avg_dis          AS "Avg_Deaths_Discharge",
       av.avg_veh          AS "Avg_Deaths_Vehicle",
       ad.avg_dis - av.avg_veh AS "Difference_Discharge_vs_Vehicle"
FROM   avg_discharge ad
CROSS JOIN avg_vehicle av
LIMIT 20;
