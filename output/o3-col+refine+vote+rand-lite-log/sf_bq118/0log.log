```sql
--Description: 1)  Look at ICD-10 codes whose descriptions contain the word “discharge”.
SELECT 
    "Code",
    "Description"
FROM DEATH.DEATH.ICD10CODE
WHERE "Description" ILIKE '%discharge%'
ORDER BY "Description"
LIMIT 20;
```

```sql
--Description: 2)  Narrow the list to ICD-10 codes that contain “discharge” but EXCLUDE the three unwanted phrases.
SELECT 
    "Code",
    "Description"
FROM DEATH.DEATH.ICD10CODE
WHERE "Description" ILIKE '%discharge%'
  AND "Description" NOT ILIKE '%urethral discharge%'
  AND "Description" NOT ILIKE '%discharge of firework%'
  AND "Description" NOT ILIKE '%legal intervention involving firearm discharge%'
ORDER BY "Description"
LIMIT 20;
```

```sql
--Description: 3)  Preview ICD-10 codes whose descriptions contain the word “vehicle”.
SELECT 
    "Code",
    "Description"
FROM DEATH.DEATH.ICD10CODE
WHERE "Description" ILIKE '%vehicle%'
ORDER BY "Description"
LIMIT 20;
```

```sql
--Description: 4)  Display the 27–group age-recode look-up table to see the available age-group codes. 
SELECT 
    "Code"              AS "AgeRecode27",
    "Description"       AS "AgeRecode27_Desc"
FROM DEATH.DEATH.AGERECODE27
ORDER BY "Code"
LIMIT 20;
```

```sql
--Description: 5)  Confirm how “White” is coded in the 3-category race recode table. 
SELECT 
    "Code"              AS "RaceRecode3",
    "Description"
FROM DEATH.DEATH.RACERECODE3
LIMIT 20;
```

```sql
--Description: 6)  Pull a white-only death-record sample (with ICD-10 code and age-recode) to verify columns needed for the analysis. 
SELECT
    dr."Id",
    dr."Icd10Code",
    dr."AgeRecode27",
    dr."RaceRecode3"
FROM DEATH.DEATH.DEATHRECORDS dr
WHERE dr."RaceRecode3" = 1      -- White
LIMIT 20;
```

```sql
--Description: 7)  Count deaths of white individuals whose ICD-10 descriptions match the qualified “discharge” list, grouped by age-recode.
SELECT
    dr."AgeRecode27",
    COUNT(*) AS "death_cnt_discharge"
FROM DEATH.DEATH.DEATHRECORDS        dr
JOIN DEATH.DEATH.ICD10CODE           ic  ON dr."Icd10Code" = ic."Code"
WHERE dr."RaceRecode3" = 1
  AND ic."Description" ILIKE '%discharge%'
  AND ic."Description" NOT ILIKE '%urethral discharge%'
  AND ic."Description" NOT ILIKE '%discharge of firework%'
  AND ic."Description" NOT ILIKE '%legal intervention involving firearm discharge%'
GROUP BY dr."AgeRecode27"
ORDER BY dr."AgeRecode27"
LIMIT 20;
```

```sql
--Description: 8)  Count deaths of white individuals whose ICD-10 descriptions contain “vehicle”, grouped by age-recode.
SELECT
    dr."AgeRecode27",
    COUNT(*) AS "death_cnt_vehicle"
FROM DEATH.DEATH.DEATHRECORDS        dr
JOIN DEATH.DEATH.ICD10CODE           ic  ON dr."Icd10Code" = ic."Code"
WHERE dr."RaceRecode3" = 1
  AND ic."Description" ILIKE '%vehicle%'
GROUP BY dr."AgeRecode27"
ORDER BY dr."AgeRecode27"
LIMIT 20;
```

```sql
--Description: 9)  Compute the average (mean) number of white-deaths per age group for the “discharge” and “vehicle” categories. 
SELECT
    AVG(dis."death_cnt_discharge") AS "avg_deaths_discharge",
    AVG(veh."death_cnt_vehicle")   AS "avg_deaths_vehicle"
FROM
    (SELECT dr."AgeRecode27", COUNT(*) AS "death_cnt_discharge"
     FROM DEATH.DEATH.DEATHRECORDS dr
     JOIN DEATH.DEATH.ICD10CODE    ic ON dr."Icd10Code" = ic."Code"
     WHERE dr."RaceRecode3" = 1
       AND ic."Description" ILIKE '%discharge%'
       AND ic."Description" NOT ILIKE '%urethral discharge%'
       AND ic."Description" NOT ILIKE '%discharge of firework%'
       AND ic."Description" NOT ILIKE '%legal intervention involving firearm discharge%'
     GROUP BY dr."AgeRecode27") dis
FULL JOIN
    (SELECT dr."AgeRecode27", COUNT(*) AS "death_cnt_vehicle"
     FROM DEATH.DEATH.DEATHRECORDS dr
     JOIN DEATH.DEATH.ICD10CODE    ic ON dr."Icd10Code" = ic."Code"
     WHERE dr."RaceRecode3" = 1
       AND ic."Description" ILIKE '%vehicle%'
     GROUP BY dr."AgeRecode27") veh
ON dis."AgeRecode27" = veh."AgeRecode27"
LIMIT 20;
```

```sql
--Description: 10)  Show, by age group, how much higher the “discharge” deaths are than “vehicle” deaths for white individuals.
SELECT
    COALESCE(dis."AgeRecode27", veh."AgeRecode27")               AS "AgeRecode27",
    COALESCE(dis."death_cnt_discharge", 0)                       AS "deaths_discharge",
    COALESCE(veh."death_cnt_vehicle",   0)                       AS "deaths_vehicle",
    COALESCE(dis."death_cnt_discharge", 0) 
      - COALESCE(veh."death_cnt_vehicle", 0)                     AS "difference_discharge_minus_vehicle"
FROM
    (SELECT dr."AgeRecode27", COUNT(*) AS "death_cnt_discharge"
     FROM DEATH.DEATH.DEATHRECORDS dr
     JOIN DEATH.DEATH.ICD10CODE    ic ON dr."Icd10Code" = ic."Code"
     WHERE dr."RaceRecode3" = 1
       AND ic."Description" ILIKE '%discharge%'
       AND ic."Description" NOT ILIKE '%urethral discharge%'
       AND ic."Description" NOT ILIKE '%discharge of firework%'
       AND ic."Description" NOT ILIKE '%legal intervention involving firearm discharge%'
     GROUP BY dr."AgeRecode27") dis
FULL JOIN
    (SELECT dr."AgeRecode27", COUNT(*) AS "death_cnt_vehicle"
     FROM DEATH.DEATH.DEATHRECORDS dr
     JOIN DEATH.DEATH.ICD10CODE    ic ON dr."Icd10Code" = ic."Code"
     WHERE dr."RaceRecode3" = 1
       AND ic."Description" ILIKE '%vehicle%'
     GROUP BY dr."AgeRecode27") veh
ON dis."AgeRecode27" = veh."AgeRecode27"
ORDER BY "AgeRecode27"
LIMIT 20;
```
