    GROUP BY dr."AgeRecode27", dr."Icd10Code"
) sub
JOIN DEATH.DEATH.AGERECODE27 ag
      ON sub."AgeRecode27" = ag."Code"
GROUP BY ag."Description"
LIMIT 20;
