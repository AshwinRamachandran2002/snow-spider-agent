```sql
--Description: 3) Count WHITE decedents (RaceRecode3 = 1) for every single
--   “discharge” ICD-10 code.  Gives an idea of the volume by code.
SELECT
    dr."Icd10Code",
    COUNT(*) AS "death_cnt"
FROM DEATH.DEATH.DEATHRECORDS dr
JOIN DEATH.DEATH.ICD10CODE ic
      ON dr."Icd10Code" = ic."Code"
WHERE ic."Description" ILIKE '%discharge%'
  AND ic."Description" NOT ILIKE '%Urethral discharge%'
  AND ic."Description" NOT ILIKE '%Discharge of firework%'
  AND ic."Description" NOT ILIKE '%Legal intervention involving firearm discharge%'
  AND dr."RaceRecode3" = 1        -- White
GROUP BY dr."Icd10Code"
ORDER BY "death_cnt" DESC
LIMIT 20;
```

```sql
--Description: 4) Number of WHITE deaths linked to “discharge” codes,
--   grouped by 27-group age recode so we can see which age groups dominate.
SELECT
    dr."AgeRecode27",
    ag."Description"  AS "Age_Group",
    COUNT(*)          AS "death_cnt"
FROM DEATH.DEATH.DEATHRECORDS dr
JOIN DEATH.DEATH.ICD10CODE ic         ON dr."Icd10Code" = ic."Code"
JOIN DEATH.DEATH.AGERECODE27 ag       ON dr."AgeRecode27" = ag."Code"
WHERE ic."Description" ILIKE '%discharge%'
  AND ic."Description" NOT ILIKE '%Urethral discharge%'
  AND ic."Description" NOT ILIKE '%Discharge of firework%'
  AND ic."Description" NOT ILIKE '%Legal intervention involving firearm discharge%'
  AND dr."RaceRecode3" = 1
GROUP BY dr."AgeRecode27", ag."Description"
ORDER BY "death_cnt" DESC
LIMIT 20;
```

```sql
--Description: 5) Number of WHITE deaths linked to “vehicle” codes,
