--Description: 10) (Optional diagnostic) Display any age groups that appear in
--   vehicle set but not in discharge set to ensure completeness.
WITH discharge_age AS (
    SELECT DISTINCT ag."Description" AS Age_Group
    FROM DEATH.DEATH.ICD10CODE ic
    JOIN DEATH.DEATH.DEATHRECORDS dr ON dr."Icd10Code" = ic."Code"
    JOIN DEATH.DEATH.AGERECODE27 ag  ON dr."AgeRecode27" = ag."Code"
    WHERE ic."Description" ILIKE '%discharge%'
      AND ic."Description" NOT ILIKE '%Urethral discharge%'
      AND ic."Description" NOT ILIKE '%Discharge of firework%'
      AND ic."Description" NOT ILIKE '%Legal intervention involving firearm discharge%'
      AND dr."RaceRecode3" = 1
),
vehicle_age AS (
    SELECT DISTINCT ag."Description" AS Age_Group
    FROM DEATH.DEATH.ICD10CODE ic
    JOIN DEATH.DEATH.DEATHRECORDS dr ON dr."Icd10Code" = ic."Code"
    JOIN DEATH.DEATH.AGERECODE27 ag  ON dr."AgeRecode27" = ag."Code"
    WHERE ic."Description" ILIKE '%vehicle%'
      AND dr."RaceRecode3" = 1
)
SELECT va.Age_Group
FROM vehicle_age va
LEFT JOIN discharge_age da ON va.Age_Group = da.Age_Group
WHERE da.Age_Group IS NULL
LIMIT 20;
