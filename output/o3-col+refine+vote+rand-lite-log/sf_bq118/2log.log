--Description:  For White decedents, determine the average deaths-per-ICD-10-code
--              for firearm-related “discharge” codes (excluding three specific
--              phrases) versus all “vehicle” codes, then show—by 27-group age
--              recode—how much higher the discharge average is than the vehicle
--              average.  Steps:
--                 1) discharge_ct – counts per ICD10 & age group.
--                 2) vehicle_ct   – counts per ICD10 & age group.
--                 3) avg_* CTEs   – average deaths per code per age group.
--                 4) Final JOIN   – attach age-group text & compute difference.
WITH discharge_ct AS (
    SELECT
        dr."AgeRecode27",
        dr."Icd10Code",
        COUNT(*) AS death_cnt
    FROM DEATH.DEATH.DEATHRECORDS dr
    JOIN DEATH.DEATH.ICD10CODE ic
          ON dr."Icd10Code" = ic."Code"
    WHERE ic."Description" ILIKE '%discharge%'
      AND ic."Description" NOT ILIKE '%Urethral discharge%'
      AND ic."Description" NOT ILIKE '%Discharge of firework%'
      AND ic."Description" NOT ILIKE '%Legal intervention involving firearm discharge%'
      AND dr."RaceRecode3" = 1     -- White
    GROUP BY dr."AgeRecode27", dr."Icd10Code"
),
vehicle_ct AS (
    SELECT
        dr."AgeRecode27",
        dr."Icd10Code",
        COUNT(*) AS death_cnt
    FROM DEATH.DEATH.DEATHRECORDS dr
    JOIN DEATH.DEATH.ICD10CODE ic
          ON dr."Icd10Code" = ic."Code"
    WHERE ic."Description" ILIKE '%vehicle%'
      AND dr."RaceRecode3" = 1
    GROUP BY dr."AgeRecode27", dr."Icd10Code"
),
avg_discharge AS (
    SELECT
        "AgeRecode27",
        AVG(death_cnt) AS avg_discharge
    FROM discharge_ct
    GROUP BY "AgeRecode27"
),
avg_vehicle AS (
    SELECT
        "AgeRecode27",
        AVG(death_cnt) AS avg_vehicle
    FROM vehicle_ct
    GROUP BY "AgeRecode27"
)
SELECT
    ag."Description"                        AS "Age_Group",
    ad.avg_discharge                        AS "avg_deaths_per_discharge_code",
    av.avg_vehicle                          AS "avg_deaths_per_vehicle_code",
    (ad.avg_discharge - COALESCE(av.avg_vehicle, 0)) 
                                            AS "difference_discharge_minus_vehicle"
FROM DEATH.DEATH.AGERECODE27 ag
LEFT JOIN avg_discharge ad ON ag."Code" = ad."AgeRecode27"
LEFT JOIN avg_vehicle   av ON ag."Code" = av."AgeRecode27"
WHERE ad.avg_discharge IS NOT NULL
ORDER BY "difference_discharge_minus_vehicle" DESC
LIMIT 20;
