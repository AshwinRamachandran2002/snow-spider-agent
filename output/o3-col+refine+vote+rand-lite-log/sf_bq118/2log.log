Query:
--Description: 7) Compute, for each age group, the average deaths-per-code for
--              “vehicle” ICD-10 codes (White decedents only) – fixed alias case.
SELECT
    ag."Description"                  AS "Age_Group",
    AVG(sub.death_cnt)                AS "avg_deaths_per_vehicle_code"
FROM (
    SELECT
        dr."AgeRecode27",
        dr."Icd10Code",
        COUNT(*) AS death_cnt
    FROM DEATH.DEATH.DEATHRECORDS dr
    JOIN DEATH.DEATH.ICD10CODE ic
          ON dr."Icd10Code" = ic."Code"
    WHERE ic."Description" ILIKE '%vehicle%'
      AND dr."RaceRecode3" = 1
    GROUP BY dr."AgeRecode27", dr."Icd10Code"
) sub
JOIN DEATH.DEATH.AGERECODE27 ag
      ON sub."AgeRecode27" = ag."Code"
GROUP BY ag."Description"
LIMIT 20
