```sql
--Description: 6) Compute, for each age group, deaths-per-code average for all
--   qualifying “discharge” ICD-10 codes (WHITE only).
SELECT
    ag."Description"                    AS "Age_Group",
    AVG(sub."death_cnt")                AS "avg_deaths_per_discharge_code"
FROM (
    SELECT
        dr."AgeRecode27",
        dr."Icd10Code",
        COUNT(*) AS death_cnt
    FROM DEATH.DEATH.DEATHRECORDS dr
    JOIN DEATH.DEATH.ICD10CODE ic
          ON dr."Icd10Code" = ic."Code"
    WHERE ic."Description" ILIKE '%discharge%'
      AND ic."Description" NOT ILIKE '%Urethral discharge%'
      AND ic."Description" NOT ILIKE '%Discharge of firework%'
      AND ic."Description" NOT ILIKE '%Legal intervention involving firearm discharge%'
      AND dr."RaceRecode3" = 1
    GROUP BY dr."AgeRecode27", dr."Icd10Code"
) sub
JOIN DEATH.DEATH.AGERECODE27 ag
      ON sub."AgeRecode27" = ag."Code"
GROUP BY ag."Description"
LIMIT 20;
```

```sql
--Description: 7) Compute, for each age group, deaths-per-code average for
--   “vehicle” ICD-10 codes (WHITE only).
SELECT
    ag."Description"                    AS "Age_Group",
    AVG(sub."death_cnt")                AS "avg_deaths_per_vehicle_code"
FROM (
    SELECT
        dr."AgeRecode27",
        dr."Icd10Code",
        COUNT(*) AS death_cnt
    FROM DEATH.DEATH.DEATHRECORDS dr
    JOIN DEATH.DEATH.ICD10CODE ic
          ON dr."Icd10Code" = ic."Code"
    WHERE ic."Description" ILIKE '%vehicle%'
      AND dr."RaceRecode3" = 1
    GROUP BY dr."AgeRecode27", dr."Icd10Code"
) sub
JOIN DEATH.DEATH.AGERECODE27 ag
      ON sub."AgeRecode27" = ag."Code"
GROUP BY ag."Description"
LIMIT 20;
```

```sql
--Description: 8) Bring the two averaged result sets together so they can be
--   directly compared by age group.
WITH discharge AS (
    SELECT
        ag."Description"  AS Age_Group,
        AVG(sub."death_cnt") AS avg_discharge
    FROM (
        SELECT dr."AgeRecode27", dr."Icd10Code", COUNT(*) AS death_cnt
        FROM DEATH.DEATH.DEATHRECORDS dr
        JOIN DEATH.DEATH.ICD10CODE ic
              ON dr."Icd10Code" = ic."Code"
        WHERE ic."Description" ILIKE '%discharge%'
          AND ic."Description" NOT ILIKE '%Urethral discharge%'
          AND ic."Description" NOT ILIKE '%Discharge of firework%'
          AND ic."Description" NOT ILIKE '%Legal intervention involving firearm discharge%'
          AND dr."RaceRecode3" = 1
        GROUP BY dr."AgeRecode27", dr."Icd10Code"
    ) sub
    JOIN DEATH.DEATH.AGERECODE27 ag
          ON sub."AgeRecode27" = ag."Code"
    GROUP BY ag."Description"
),
vehicle AS (
    SELECT
        ag."Description"  AS Age_Group,
        AVG(sub."death_cnt") AS avg_vehicle
    FROM (
        SELECT dr."AgeRecode27", dr."Icd10Code", COUNT(*) AS death_cnt
        FROM DEATH.DEATH.DEATHRECORDS dr
        JOIN DEATH.DEATH.ICD10CODE ic
              ON dr."Icd10Code" = ic."Code"
        WHERE ic."Description" ILIKE '%vehicle%'
          AND dr."RaceRecode3" = 1
        GROUP BY dr."AgeRecode27", dr."Icd10Code"
    ) sub
    JOIN DEATH.DEATH.AGERECODE27 ag
          ON sub."AgeRecode27" = ag."Code"
    GROUP BY ag."Description"
)
SELECT
    d.Age_Group,
    d.avg_discharge,
    v.avg_vehicle
FROM discharge d
LEFT JOIN vehicle v
       ON d.Age_Group = v.Age_Group
LIMIT 20;
```

```sql
--Description: 9) Final step – compute how much higher (difference) the average
--   deaths-per-code for “discharge” is relative to “vehicle” for each age group.
WITH discharge AS (
    SELECT
        ag."Description" AS Age_Group,
        AVG(sub."death_cnt") AS avg_discharge
    FROM (
        SELECT dr."AgeRecode27", dr."Icd10Code", COUNT(*) AS death_cnt
        FROM DEATH.DEATH.DEATHRECORDS dr
        JOIN DEATH.DEATH.ICD10CODE ic
              ON dr."Icd10Code" = ic."Code"
        WHERE ic."Description" ILIKE '%discharge%'
          AND ic."Description" NOT ILIKE '%Urethral discharge%'
          AND ic."Description" NOT ILIKE '%Discharge of firework%'
          AND ic."Description" NOT ILIKE '%Legal intervention involving firearm discharge%'
          AND dr."RaceRecode3" = 1
        GROUP BY dr."AgeRecode27", dr."Icd10Code"
    ) sub
    JOIN DEATH.DEATH.AGERECODE27 ag
          ON sub."AgeRecode27" = ag."Code"
    GROUP BY ag."Description"
),
vehicle AS (
    SELECT
        ag."Description" AS Age_Group,
        AVG(sub."death_cnt") AS avg_vehicle
    FROM (
        SELECT dr."AgeRecode27", dr."Icd10Code", COUNT(*) AS death_cnt
        FROM DEATH.DEATH.DEATHRECORDS dr
        JOIN DEATH.DEATH.ICD10CODE ic
              ON dr."Icd10Code" = ic."Code"
        WHERE ic."Description" ILIKE '%vehicle%'
          AND dr."RaceRecode3" = 1
        GROUP BY dr."AgeRecode27", dr."Icd10Code"
    ) sub
    JOIN DEATH.DEATH.AGERECODE27 ag
          ON sub."AgeRecode27" = ag."Code"
    GROUP BY ag."Description"
)
SELECT
    COALESCE(d.Age_Group, v.Age_Group)                       AS "Age_Group",
    d.avg_discharge                                          AS "avg_discharge_per_code",
    v.avg_vehicle                                            AS "avg_vehicle_per_code",
    (d.avg_discharge - v.avg_vehicle)                        AS "difference_discharge_minus_vehicle"
FROM discharge d
FULL JOIN vehicle v
       ON d.Age_Group = v.Age_Group
ORDER BY "difference_discharge_minus_vehicle" DESC
LIMIT 20;
```

