```sql
--Description: 1) Look up ICD-10 codes whose text contains the word “discharge” (case-insensitive) while explicitly excluding the three unwanted phrases.
SELECT DISTINCT 
       ic."Code"        AS "Icd10Code",
       ic."Description"
FROM   DEATH.DEATH."ICD10CODE" ic
WHERE  ic."Description" ILIKE '%discharge%' 
  AND  ic."Description" NOT ILIKE '%urethral discharge%'
  AND  ic."Description" NOT ILIKE '%discharge of firework%'
  AND  ic."Description" NOT ILIKE '%legal intervention involving firearm discharge%'
LIMIT 20;
```

```sql
--Description: 2) Look up ICD-10 codes whose text contains the word “vehicle”.
SELECT DISTINCT 
       ic."Code"        AS "Icd10Code",
       ic."Description"
FROM   DEATH.DEATH."ICD10CODE" ic
WHERE  ic."Description" ILIKE '%vehicle%'
LIMIT 20;
```

```sql
--Description: 3) Preview white decedents (“RaceRecode3” = 1) whose underlying cause description contains “discharge” (after exclusions); show a few columns from the death-records table together with the code description.
SELECT 
       dr."Id"                       AS "DeathRecordId",
       dr."AgeRecode12",
       dr."AgeRecode27",
       dr."AgeRecode52",
       dr."Icd10Code",
       ic."Description"
FROM   DEATH.DEATH."DEATHRECORDS"         dr
JOIN   DEATH.DEATH."ICD10CODE"            ic  ON ic."Code" = dr."Icd10Code"
WHERE  dr."RaceRecode3" = 1                      -- White
  AND  ic."Description" ILIKE '%discharge%' 
  AND  ic."Description" NOT ILIKE '%urethral discharge%'
  AND  ic."Description" NOT ILIKE '%discharge of firework%'
  AND  ic."Description" NOT ILIKE '%legal intervention involving firearm discharge%'
LIMIT 20;
```

```sql
--Description: 4) Preview white decedents whose underlying cause description contains “vehicle”.
SELECT 
       dr."Id"                       AS "DeathRecordId",
       dr."AgeRecode12",
       dr."AgeRecode27",
       dr."AgeRecode52",
       dr."Icd10Code",
       ic."Description"
FROM   DEATH.DEATH."DEATHRECORDS"         dr
JOIN   DEATH.DEATH."ICD10CODE"            ic  ON ic."Code" = dr."Icd10Code"
WHERE  dr."RaceRecode3" = 1                      -- White
  AND  ic."Description" ILIKE '%vehicle%'
LIMIT 20;
```

```sql
--Description: 5) Display the list of age-group labels (12-group scheme) so that we know the readable text for each code.
SELECT 
       ar12."Code"        AS "AgeRecode12",
       ar12."Description" AS "AgeGroup"
FROM   DEATH.DEATH."AGERECODE12" ar12
ORDER  BY ar12."Code"
LIMIT 20;
```

```sql
--Description: 6) Count deaths for white people, by AgeRecode12, where the cause description contains “discharge” (after exclusions).
SELECT 
       dr."AgeRecode12",
       COUNT(*) AS "Deaths_Discharge"
FROM   DEATH.DEATH."DEATHRECORDS" dr
JOIN   DEATH.DEATH."ICD10CODE"    ic ON ic."Code" = dr."Icd10Code"
WHERE  dr."RaceRecode3" = 1
  AND  ic."Description" ILIKE '%discharge%' 
  AND  ic."Description" NOT ILIKE '%urethral discharge%'
  AND  ic."Description" NOT ILIKE '%discharge of firework%'
  AND  ic."Description" NOT ILIKE '%legal intervention involving firearm discharge%'
GROUP BY dr."AgeRecode12"
ORDER BY dr."AgeRecode12"
LIMIT 20;
```

```sql
--Description: 7) Count deaths for white people, by AgeRecode12, where the cause description contains “vehicle”.
SELECT 
       dr."AgeRecode12",
       COUNT(*) AS "Deaths_Vehicle"
FROM   DEATH.DEATH."DEATHRECORDS" dr
JOIN   DEATH.DEATH."ICD10CODE"    ic ON ic."Code" = dr."Icd10Code"
WHERE  dr."RaceRecode3" = 1
  AND  ic."Description" ILIKE '%vehicle%'
GROUP BY dr."AgeRecode12"
ORDER BY dr."AgeRecode12"
LIMIT 20;
```

```sql
--Description: 8) For every ICD-10 code that falls in the “discharge” category (after exclusions), compute how many white deaths it has in each AgeRecode12 group.
SELECT 
       dr."Icd10Code",
       dr."AgeRecode12",
       COUNT(*) AS "Deaths"
FROM   DEATH.DEATH."DEATHRECORDS" dr
JOIN   DEATH.DEATH."ICD10CODE"    ic ON ic."Code" = dr."Icd10Code"
WHERE  dr."RaceRecode3" = 1
  AND  ic."Description" ILIKE '%discharge%' 
  AND  ic."Description" NOT ILIKE '%urethral discharge%'
  AND  ic."Description" NOT ILIKE '%discharge of firework%'
  AND  ic."Description" NOT ILIKE '%legal intervention involving firearm discharge%'
GROUP BY dr."Icd10Code", dr."AgeRecode12"
ORDER BY dr."AgeRecode12", dr."Icd10Code"
LIMIT 20;
```

```sql
--Description: 9) For every ICD-10 code that falls in the “vehicle” category, compute how many white deaths it has in each AgeRecode12 group.
SELECT 
       dr."Icd10Code",
       dr."AgeRecode12",
       COUNT(*) AS "Deaths"
FROM   DEATH.DEATH."DEATHRECORDS" dr
JOIN   DEATH.DEATH."ICD10CODE"    ic ON ic."Code" = dr."Icd10Code"
WHERE  dr."RaceRecode3" = 1
  AND  ic."Description" ILIKE '%vehicle%'
GROUP BY dr."Icd10Code", dr."AgeRecode12"
ORDER BY dr."AgeRecode12", dr."Icd10Code"
LIMIT 20;
```

```sql
--Description: 10) Bring together the two sets: for each AgeRecode12 group, calculate
--               1) the average deaths per “discharge” ICD-10 code,
--               2) the average deaths per “vehicle”   ICD-10 code,
--               3) their difference (discharge – vehicle).
WITH discharge_counts AS (
    SELECT dr."Icd10Code", dr."AgeRecode12", COUNT(*) AS deaths
    FROM   DEATH.DEATH."DEATHRECORDS" dr
    JOIN   DEATH.DEATH."ICD10CODE"    ic ON ic."Code" = dr."Icd10Code"
    WHERE  dr."RaceRecode3" = 1
      AND  ic."Description" ILIKE '%discharge%' 
      AND  ic."Description" NOT ILIKE '%urethral discharge%'
      AND  ic."Description" NOT ILIKE '%discharge of firework%'
      AND  ic."Description" NOT ILIKE '%legal intervention involving firearm discharge%'
    GROUP BY dr."Icd10Code", dr."AgeRecode12"
), vehicle_counts AS (
    SELECT dr."Icd10Code", dr."AgeRecode12", COUNT(*) AS deaths
    FROM   DEATH.DEATH."DEATHRECORDS" dr
    JOIN   DEATH.DEATH."ICD10CODE"    ic ON ic."Code" = dr."Icd10Code"
    WHERE  dr."RaceRecode3" = 1
      AND  ic."Description" ILIKE '%vehicle%'
    GROUP BY dr."Icd10Code", dr."AgeRecode12"
)
SELECT 
       ar12."Description"                    AS "Age_Group",
       AVG(dc.deaths)                        AS "Avg_Discharge_Deaths",
       AVG(vc.deaths)                        AS "Avg_Vehicle_Deaths",
       AVG(dc.deaths) - AVG(vc.deaths)       AS "Avg_Difference"
FROM   DEATH.DEATH."AGERECODE12" ar12
LEFT   JOIN discharge_counts dc ON dc."AgeRecode12" = ar12."Code"
LEFT   JOIN vehicle_counts   vc ON vc."AgeRecode12" = ar12."Code"
GROUP  BY ar12."Description"
ORDER  BY ar12."Code"
LIMIT 20;
```
