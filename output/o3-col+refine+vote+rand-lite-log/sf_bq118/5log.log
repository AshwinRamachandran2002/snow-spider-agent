```sql
--Description / Thinking process:
--  • Objective: For each 12-group age bracket, among WHITE decedents, compare two
--    averages – average deaths per ICD-10 code whose description contains
--    “discharge” (excluding three specific phrases) and average deaths per ICD-10
--    code whose description contains “vehicle”.  Then compute the difference.
--  • Approach:
--      1. Build two CTEs (discharge_counts, vehicle_counts) that count deaths
--         per (ICD-10 code, age group).
--      2. Join those counts to the AGERECODE12 lookup so every age group appears.
--      3. In the final SELECT, take AVG(deaths) across codes per age group for
--         each category, then subtract to get the requested comparison.
--      4. Keep the numeric age code in SELECT / GROUP BY so it can be referenced
--         in ORDER BY without error.
WITH discharge_counts AS (
    SELECT
        dr."Icd10Code",
        dr."AgeRecode12",
        COUNT(*) AS deaths
    FROM DEATH.DEATH."DEATHRECORDS" dr
    JOIN DEATH.DEATH."ICD10CODE" ic
          ON ic."Code" = dr."Icd10Code"
    WHERE dr."RaceRecode3" = 1                                    -- White
      AND ic."Description" ILIKE '%discharge%'
      AND ic."Description" NOT ILIKE '%urethral discharge%'
      AND ic."Description" NOT ILIKE '%discharge of firework%'
      AND ic."Description" NOT ILIKE '%legal intervention involving firearm discharge%'
    GROUP BY dr."Icd10Code", dr."AgeRecode12"
),
vehicle_counts AS (
    SELECT
        dr."Icd10Code",
        dr."AgeRecode12",
        COUNT(*) AS deaths
    FROM DEATH.DEATH."DEATHRECORDS" dr
    JOIN DEATH.DEATH."ICD10CODE" ic
          ON ic."Code" = dr."Icd10Code"
    WHERE dr."RaceRecode3" = 1                                    -- White
      AND ic."Description" ILIKE '%vehicle%'
    GROUP BY dr."Icd10Code", dr."AgeRecode12"
)
SELECT
    ar12."Code"                         AS "AgeRecode12",
    ar12."Description"                  AS "Age_Group",
    AVG(dc.deaths)                      AS "Avg_Discharge_Deaths",
    AVG(vc.deaths)                      AS "Avg_Vehicle_Deaths",
    AVG(dc.deaths) - AVG(vc.deaths)     AS "Avg_Difference"
FROM DEATH.DEATH."AGERECODE12" ar12
LEFT JOIN discharge_counts dc
       ON dc."AgeRecode12" = ar12."Code"
LEFT JOIN vehicle_counts vc
       ON vc."AgeRecode12" = ar12."Code"
GROUP BY ar12."Code", ar12."Description"
ORDER BY ar12."Code"
LIMIT 20;
```
