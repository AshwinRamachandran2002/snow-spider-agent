       dr."AgeRecode12",
       dr."AgeRecode27",
       dr."AgeRecode52",
       dr."Icd10Code",
       ic."Description"
FROM   DEATH.DEATH."DEATHRECORDS"         dr
JOIN   DEATH.DEATH."ICD10CODE"            ic  ON ic."Code" = dr."Icd10Code"
