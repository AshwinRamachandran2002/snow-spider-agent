-- 5. Find the minimum of those pre-event counts
SELECT MIN("pre_event_cnt") AS "min_cnt"
FROM   (SELECT   f."session",
                 COUNT(*) AS "pre_event_cnt"
        FROM     "activity_log" AS a
        JOIN     (SELECT "session",
                         MIN("stamp") AS "first_cv_stamp"
                  FROM   "activity_log"
                  WHERE  "path" LIKE '%/detail%'
                     OR  "path" LIKE '%/complete%'
                  GROUP BY "session") AS f
              ON a."session" = f."session"
        WHERE    a."search_type" <> ''
          AND    a."stamp"       < f."first_cv_stamp"
        GROUP BY f."session");
