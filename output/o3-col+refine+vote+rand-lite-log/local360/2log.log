Query:
-- ⑥  Count of events (non-empty search_type) that happened *before* the first click / conversion
WITH first_click AS (
  SELECT
    "session",
    MIN("stamp") AS "first_click_time"
  FROM "activity_log"
  WHERE "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
  GROUP BY "session"
),
pre_events AS (
  SELECT
    a."session",
    COUNT(*) AS "pre_cnt"
  FROM "activity_log" AS a
  LEFT JOIN first_click AS f
    ON a."session" = f."session"
  WHERE a."search_type" <> ''
    AND (f."first_click_time" IS NULL OR a."stamp" < f."first_click_time")
  GROUP BY a."session"
)
SELECT *
FROM pre_events
LIMIT 20;
