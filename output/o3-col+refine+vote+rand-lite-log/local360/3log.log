Query:
--Description: ⑩  (Final answer)  Deliver every session that has the *minimum* count of non-empty-search_type events before its first “/detail” or “/complete”, together with that first path & search_type
WITH first_click AS (
    SELECT  "session",
            MIN("stamp") AS "first_click_stamp"
    FROM    "activity_log"
    WHERE   "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
    GROUP   BY "session"
),
pre_event_counts AS (
    SELECT  a."session",
            COUNT(*) AS "pre_cnt"
    FROM    "activity_log" AS a
    JOIN    first_click   AS f
           ON a."session" = f."session"
    WHERE   a."stamp" < f."first_click_stamp"
      AND   COALESCE(a."search_type",'') <> ''
    GROUP   BY a."session"
),
min_cnt AS (
    SELECT MIN("pre_cnt") AS "min_pre_cnt"
    FROM   pre_event_counts
),
first_click_row AS (
    SELECT  c."session",
            c."path",
            c."search_type",
            c."stamp"
    FROM    "activity_log" AS c
    JOIN    first_click    AS f
           ON c."session" = f."session"
          AND c."stamp"   = f."first_click_stamp"
)
SELECT  p."session",
        f."path",
        f."search_type"
FROM    pre_event_counts AS p
JOIN    min_cnt          AS m  ON p."pre_cnt" = m."min_pre_cnt"
JOIN    first_click_row  AS f  ON p."session" = f."session"
LIMIT 20;
