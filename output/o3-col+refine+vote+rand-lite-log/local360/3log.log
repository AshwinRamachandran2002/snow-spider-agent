```sql
--Description: ①  Get a feel for the distinct paths that appear in activity_log
SELECT DISTINCT "path"
FROM "activity_log"
LIMIT 20;
```

```sql
--Description: ②  Look at rows that have a non-empty search_type
SELECT *
FROM "activity_log"
WHERE COALESCE("search_type",'') <> ''
LIMIT 20;
```

```sql
--Description: ③  Inspect rows whose path looks like a “detail” or “complete” page
SELECT *
FROM "activity_log"
WHERE "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
LIMIT 20;
```

```sql
--Description: ④  For every session, locate the first time-stamp of a “detail / complete” page-view
SELECT "session",
       MIN("stamp") AS "first_click_stamp"
FROM   "activity_log"
WHERE  "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
GROUP  BY "session"
LIMIT 20;
```

```sql
--Description: ⑤  Count, per session, how many non-empty-search_type events occurred *before* that first click / conversion
SELECT  a."session",
        COUNT(*) AS "pre_click_events"
FROM    "activity_log"  AS a
JOIN   (SELECT "session",
               MIN("stamp") AS "first_click_stamp"
        FROM   "activity_log"
        WHERE  "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
        GROUP  BY "session") AS b
      ON a."session" = b."session"
WHERE   a."stamp" < b."first_click_stamp"
  AND   COALESCE(a."search_type",'') <> ''
GROUP  BY a."session"
LIMIT 20;
```

```sql
--Description: ⑥  Find the minimum of those pre-click / pre-conversion counts
SELECT MIN("pre_click_events") AS "min_pre_click"
FROM  (
        SELECT  a."session",
                COUNT(*) AS "pre_click_events"
        FROM    "activity_log"  AS a
        JOIN   (SELECT "session",
                       MIN("stamp") AS "first_click_stamp"
                FROM   "activity_log"
                WHERE  "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
                GROUP  BY "session") AS b
              ON a."session" = b."session"
        WHERE   a."stamp" < b."first_click_stamp"
          AND   COALESCE(a."search_type",'') <> ''
        GROUP  BY a."session"
      ) AS t;
```

```sql
--Description: ⑦  Keep only the sessions that share this minimum count
SELECT  t."session",
        t."pre_click_events"
FROM   (
        SELECT  a."session",
                COUNT(*) AS "pre_click_events"
        FROM    "activity_log"  AS a
        JOIN   (SELECT "session",
                       MIN("stamp") AS "first_click_stamp"
                FROM   "activity_log"
                WHERE  "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
                GROUP  BY "session") AS b
              ON a."session" = b."session"
        WHERE   a."stamp" < b."first_click_stamp"
          AND   COALESCE(a."search_type",'') <> ''
        GROUP  BY a."session"
       )  AS t
WHERE  t."pre_click_events" =
      (SELECT MIN("pre_click_events")
       FROM   (
               SELECT  a."session",
                       COUNT(*) AS "pre_click_events"
               FROM    "activity_log"  AS a
               JOIN   (SELECT "session",
                              MIN("stamp") AS "first_click_stamp"
                       FROM   "activity_log"
                       WHERE  "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
                       GROUP  BY "session") AS b
                     ON a."session" = b."session"
               WHERE   a."stamp" < b."first_click_stamp"
                 AND   COALESCE(a."search_type",'') <> ''
               GROUP  BY a."session"
             )
      )
LIMIT 20;
```

```sql
--Description: ⑧  For the above sessions, take the first “detail / complete” row so we can fetch its path & search_type
SELECT  c."session",
        c."path",
        c."search_type"
FROM   "activity_log" AS c
JOIN  (
        SELECT  a."session",
                MIN(a."stamp") AS "first_click_stamp"
        FROM    "activity_log" AS a
        WHERE   a."path" LIKE '%/detail%' OR a."path" LIKE '%/complete%'
        GROUP   BY a."session"
      ) AS d
   ON c."session" = d."session"
  AND c."stamp"   = d."first_click_stamp"
LIMIT 20;
```

```sql
--Description: ⑨  Bring the two pieces (sessions with the minimum pre-click count + their first detail/complete row) together
SELECT  s."session",
        c."path",
        c."search_type"
FROM  (
        SELECT  a."session",
                COUNT(*) AS "pre_click_events"
        FROM    "activity_log"  AS a
        JOIN   (SELECT "session",
                       MIN("stamp") AS "first_click_stamp"
                FROM   "activity_log"
                WHERE  "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
                GROUP  BY "session") AS b
              ON a."session" = b."session"
        WHERE   a."stamp" < b."first_click_stamp"
          AND   COALESCE(a."search_type",'') <> ''
        GROUP  BY a."session"
       )  AS s
JOIN  (
        SELECT  x."session",
                x."path",
                x."search_type",
                x."stamp"
        FROM   "activity_log" AS x
        JOIN  (SELECT "session",
                      MIN("stamp") AS "first_click_stamp"
               FROM   "activity_log"
               WHERE  "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
               GROUP  BY "session") AS y
             ON x."session" = y."session"
            AND x."stamp"   = y."first_click_stamp"
      ) AS c
  ON s."session" = c."session"
WHERE s."pre_click_events" = (
        SELECT MIN("pre_click_events")
        FROM  (
                SELECT  a."session",
                        COUNT(*) AS "pre_click_events"
                FROM    "activity_log"  AS a
                JOIN   (SELECT "session",
                               MIN("stamp") AS "first_click_stamp"
                        FROM   "activity_log"
                        WHERE  "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
                        GROUP  BY "session") AS b
                      ON a."session" = b."session"
                WHERE   a."stamp" < b."first_click_stamp"
                  AND   COALESCE(a."search_type",'') <> ''
                GROUP  BY a."session"
              )
      )
LIMIT 20;
```

```sql
--Description: ⑩  (Final answer)  Deliver every session that has the *minimum* count of non-empty-search_type events before its first “/detail” or “/complete”, together with that first path & search_type
WITH first_click AS (
    SELECT  "session",
            MIN("stamp") AS "first_click_stamp"
    FROM    "activity_log"
    WHERE   "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
    GROUP   BY "session"
),
pre_event_counts AS (
    SELECT  a."session",
            COUNT(*) AS "pre_cnt"
    FROM    "activity_log" AS a
    JOIN    first_click   AS f
           ON a."session" = f."session"
    WHERE   a."stamp" < f."first_click_stamp"
      AND   COALESCE(a."search_type",'') <> ''
    GROUP   BY a."session"
),
min_cnt AS (
    SELECT MIN("pre_cnt") AS "min_pre_cnt"
    FROM   pre_event_counts
),
first_click_row AS (
    SELECT  c."session",
            c."path",
            c."search_type",
            c."stamp"
    FROM    "activity_log" AS c
    JOIN    first_click    AS f
           ON c."session" = f."session"
          AND c."stamp"   = f."first_click_stamp"
)
SELECT  p."session",
        f."path",
        f."search_type"
FROM    pre_event_counts AS p
JOIN    min_cnt          AS m  ON p."pre_cnt" = m."min_pre_cnt"
JOIN    first_click_row  AS f  ON p."session" = f."session"
LIMIT 20;
```
