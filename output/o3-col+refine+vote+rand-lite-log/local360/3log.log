Query:
--Description: ⑤  Count, per session, how many non-empty-search_type events occurred *before* that first click / conversion
SELECT  a."session",
        COUNT(*) AS "pre_click_events"
FROM    "activity_log"  AS a
JOIN   (SELECT "session",
               MIN("stamp") AS "first_click_stamp"
        FROM   "activity_log"
        WHERE  "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
        GROUP  BY "session") AS b
      ON a."session" = b."session"
WHERE   a."stamp" < b."first_click_stamp"
  AND   COALESCE(a."search_type",'') <> ''
GROUP  BY a."session"
LIMIT 20;
