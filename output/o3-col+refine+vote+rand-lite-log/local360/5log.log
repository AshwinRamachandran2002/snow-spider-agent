SELECT MIN("pre_event_cnt") AS "min_cnt"
FROM  ( SELECT a."session",
               COUNT(*) AS "pre_event_cnt"
        FROM   "activity_log"            AS a
        JOIN   ( SELECT "session",
                        MIN("stamp") AS "first_stamp"
                 FROM   "activity_log"
                 WHERE  "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
                 GROUP  BY "session")    AS b
               ON a."session" = b."session"
        WHERE  a."stamp" < b."first_stamp"
          AND  a."search_type" <> ''
        GROUP  BY a."session");
