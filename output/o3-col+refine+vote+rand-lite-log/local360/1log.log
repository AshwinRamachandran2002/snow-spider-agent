Query:
-- Description: 5)  Count, for every session, the number of events that happened BEFORE the first
--                  '/detail' or '/complete', counting only rows whose search_type is NOT blank.
SELECT   pre."session",
         COUNT(*) AS "pre_event_cnt"
FROM     "activity_log" AS pre
JOIN (
        SELECT  al."session",
                MIN(al."stamp") AS "first_cv_time"
        FROM    "activity_log" AS al
        WHERE   al."path" LIKE '%/detail%' 
                OR al."path" LIKE '%/complete%'
        GROUP BY al."session"
     ) AS cv
       ON  pre."session" = cv."session"
WHERE    pre."search_type" <> ''
  AND    pre."stamp" < cv."first_cv_time"
GROUP BY pre."session"
LIMIT 20;
