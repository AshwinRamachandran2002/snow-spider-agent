```sql
-- Description: 1)  Check what kinds of paths exist in the activity log.
SELECT DISTINCT "path"
FROM "activity_log"
LIMIT 20;
```

```sql
-- Description: 2)  Check what kinds of search_type values actually appear (blank ones are '').
SELECT DISTINCT "search_type"
FROM "activity_log"
LIMIT 20;
```

```sql
-- Description: 3)  Show the sessions that contain either a '/detail' click or a '/complete' conversion.
SELECT DISTINCT "session"
FROM "activity_log"
WHERE "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
LIMIT 20;
```

```sql
-- Description: 4)  For those sessions, get the first time (earliest stamp) a '/detail' or '/complete' appeared.
SELECT  al."session",
        MIN(al."stamp") AS "first_cv_time"
FROM    "activity_log" AS al
WHERE   al."path" LIKE '%/detail%' 
        OR al."path" LIKE '%/complete%'
GROUP BY al."session"
LIMIT 20;
```

```sql
-- Description: 5)  Count, for every session, the number of events that happened BEFORE the first
--                  '/detail' or '/complete', counting only rows whose search_type is NOT blank.
SELECT   pre."session",
         COUNT(*) AS "pre_event_cnt"
FROM     "activity_log" AS pre
JOIN (
        SELECT  al."session",
                MIN(al."stamp") AS "first_cv_time"
        FROM    "activity_log" AS al
        WHERE   al."path" LIKE '%/detail%' 
                OR al."path" LIKE '%/complete%'
        GROUP BY al."session"
     ) AS cv
       ON  pre."session" = cv."session"
WHERE    pre."search_type" <> ''
  AND    pre."stamp" < cv."first_cv_time"
GROUP BY pre."session"
LIMIT 20;
```

```sql
-- Description: 6)  Find the minimum of those pre-event counts.
SELECT MIN("pre_event_cnt") AS "min_cnt"
FROM (
       SELECT   pre."session",
                COUNT(*) AS "pre_event_cnt"
       FROM     "activity_log" AS pre
       JOIN (
              SELECT  al."session",
                      MIN(al."stamp") AS "first_cv_time"
              FROM    "activity_log" AS al
              WHERE   al."path" LIKE '%/detail%' 
                      OR al."path" LIKE '%/complete%'
              GROUP BY al."session"
            ) AS cv
              ON  pre."session" = cv."session"
       WHERE    pre."search_type" <> ''
         AND    pre."stamp" < cv."first_cv_time"
       GROUP BY pre."session"
     );
```

```sql
-- Description: 7)  List all sessions whose pre-event count equals that minimum.
SELECT   t."session"
FROM (
       SELECT   pre."session",
                COUNT(*) AS "pre_event_cnt"
       FROM     "activity_log" AS pre
