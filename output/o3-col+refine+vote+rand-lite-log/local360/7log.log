```sql
-- Description: 3) Quickly see whether any “detail / complete” paths exist
SELECT DISTINCT "path"
FROM "activity_log"
WHERE "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
LIMIT 20;
```

```sql
-- Description: 4) Inspect a full time-series of one random session that actually contains “detail / complete”
SELECT *
FROM "activity_log"
WHERE "session" = (
      SELECT "session"
      FROM "activity_log"
      WHERE "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
      LIMIT 1)
ORDER BY "stamp"
LIMIT 20;
```

```sql
-- Description: 5) For every session, pick the first time a “detail / complete” happens
WITH first_conv AS (
  SELECT
    "session",
    MIN("stamp") AS "conv_stamp"
  FROM "activity_log"
  WHERE "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
  GROUP BY "session"
)
SELECT *
FROM first_conv
LIMIT 20;
```

```sql
-- Description: 6) Count, per session, how many events with a non-blank search_type occurred BEFORE that first conversion/click
WITH first_conv AS (
  SELECT
    "session",
    MIN("stamp") AS "conv_stamp"
  FROM "activity_log"
  WHERE "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
  GROUP BY "session"
)
SELECT
  a."session",
  COUNT(*) AS "pre_events_with_search"
FROM "activity_log" AS a
JOIN first_conv  AS f
  ON a."session" = f."session"
WHERE a."stamp" < f."conv_stamp"
  AND a."search_type" <> ''
GROUP BY a."session"
LIMIT 20;
```

```sql
-- Description: 7) Find the minimum of those counts
WITH first_conv AS (
  SELECT
    "session",
    MIN("stamp") AS "conv_stamp"
  FROM "activity_log"
  WHERE "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
  GROUP BY "session"
),
pre_cnt AS (
  SELECT
    a."session",
    COUNT(*) AS "pre_event_cnt"
  FROM "activity_log" AS a
  JOIN first_conv AS f
    ON a."session" = f."session"
  WHERE a."stamp" < f."conv_stamp"
    AND a."search_type" <> ''
  GROUP BY a."session"
)
SELECT MIN("pre_event_cnt") AS "min_pre_event_cnt"
FROM pre_cnt;
```

```sql
-- Description: 8) FINAL – sessions that have that minimum count, together with the path & search_type of their first “detail / complete”
WITH first_conv AS (
  SELECT
    "session",
    "path",
    "search_type",
    MIN("stamp") AS "conv_stamp"
  FROM "activity_log"
  WHERE "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
  GROUP BY "session"
),
pre_cnt AS (
  SELECT
    a."session",
    COUNT(*) AS "pre_event_cnt"
  FROM "activity_log" AS a
  JOIN first_conv AS f
    ON a."session" = f."session"
  WHERE a."stamp" < f."conv_stamp"
    AND a."search_type" <> ''
  GROUP BY a."session"
),
min_val AS (
  SELECT MIN("pre_event_cnt") AS "min_cnt" FROM pre_cnt
)
SELECT
  p."session",
  f."path",
  f."search_type"
FROM pre_cnt  AS p
JOIN min_val AS m ON p."pre_event_cnt" = m."min_cnt"
JOIN first_conv AS f ON p."session" = f."session";
```
