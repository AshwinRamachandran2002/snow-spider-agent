Query:
-- 8. Sessions that hit the minimum pre-event count
WITH pre_cnt AS (
    SELECT l."session",
           COUNT(*) AS "cnt"
    FROM   "activity_log" AS l
    JOIN  (SELECT "session",
                  MIN("stamp") AS "first_time"
           FROM   "activity_log"
           WHERE  "path" LIKE '%/detail%' OR "path" LIKE '%/complete%'
           GROUP BY "session") AS f
           ON l."session" = f."session"
    WHERE  l."search_type" <> '' 
      AND  l."search_type" IS NOT NULL
      AND  l."stamp" < f."first_time"
    GROUP BY l."session"
), min_cnt AS (
    SELECT MIN("cnt") AS "m" FROM pre_cnt
)
SELECT p."session"
FROM   pre_cnt  AS p,
       min_cnt  AS m
WHERE  p."cnt" = m."m"
LIMIT 20;
