Query:
--Description: Find the smallest start_position and largest end_position for any BRCA1 variant
SELECT
  MIN(start_position) AS region_start,
  MAX(end_position) AS region_end
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS t
CROSS JOIN UNNEST(t.alternate_bases) AS alt
CROSS JOIN UNNEST(alt.vep) AS vep
WHERE vep.SYMBOL = 'BRCA1';
