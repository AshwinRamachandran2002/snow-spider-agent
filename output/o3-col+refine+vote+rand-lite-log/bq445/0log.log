Query:
--Description: Final answer – smallest Protein_position for any missense variant in the BRCA1 region
WITH brca1_region AS (                -- derive BRCA1 boundaries
  SELECT
    MIN(start_position) AS region_start,
    MAX(end_position)   AS region_end
