Query:
--Description: List distinct Protein_position strings for BRCA1-region missense variants
WITH region AS (                       -- find BRCA1 genomic span
  SELECT
    MIN(start_position) AS region_start,
    MAX(end_position)   AS region_end
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` t
  CROSS JOIN UNNEST(t.alternate_bases) alt
  CROSS JOIN UNNEST(alt.vep) vep
  WHERE vep.SYMBOL = 'BRCA1'
)
SELECT DISTINCT                       -- pull unique Protein_position values
  vep.Protein_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` t
CROSS JOIN UNNEST(t.alternate_bases) alt
CROSS JOIN UNNEST(alt.vep) vep
CROSS JOIN region                     -- CROSS JOIN (single-row) instead of JOIN … ON
WHERE t.start_position BETWEEN region.region_start AND region.region_end
  AND LOWER(vep.Consequence) LIKE '%missense_variant%'
  AND vep.Protein_position IS NOT NULL
LIMIT 20
