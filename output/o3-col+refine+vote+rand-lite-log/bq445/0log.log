```sql
--Description: Preview missense-variant rows that lie inside the BRCA1 region
WITH region AS (
  SELECT
    MIN(start_position) AS region_start,
    MAX(end_position) AS region_end
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS t
  CROSS JOIN UNNEST(t.alternate_bases) AS alt
  CROSS JOIN UNNEST(alt.vep) AS vep
  WHERE vep.SYMBOL = 'BRCA1'
)
SELECT
  t.start_position,
  t.end_position,
  vep.Consequence,
  vep.Protein_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS t
CROSS JOIN UNNEST(t.alternate_bases) AS alt
CROSS JOIN UNNEST(alt.vep) AS vep
JOIN region
WHERE t.start_position BETWEEN region.region_start AND region.region_end
  AND LOWER(vep.Consequence) LIKE '%missense_variant%'
LIMIT 20;
```

```sql
--Description: List distinct Protein_position strings for those missense variants
WITH region AS (
  SELECT
    MIN(start_position) AS region_start,
    MAX(end_position) AS region_end
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS t
  CROSS JOIN UNNEST(t.alternate_bases) AS alt
  CROSS JOIN UNNEST(alt.vep) AS vep
  WHERE vep.SYMBOL = 'BRCA1'
)
SELECT DISTINCT
  vep.Protein_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS t
CROSS JOIN UNNEST(t.alternate_bases) AS alt
CROSS JOIN UNNEST(alt.vep) AS vep
JOIN region
WHERE t.start_position BETWEEN region.region_start AND region.region_end
  AND LOWER(vep.Consequence) LIKE '%missense_variant%'
  AND vep.Protein_position IS NOT NULL
LIMIT 20;
```

```sql
--Description: Final answer – the smallest Protein_position for any missense variant in the BRCA1 region
WITH brca1_region AS (
  SELECT
    MIN(start_position) AS region_start,
    MAX(end_position) AS region_end
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS t,
       UNNEST(t.alternate_bases) AS alt,
       UNNEST(alt.vep) AS vep
  WHERE vep.SYMBOL = 'BRCA1'
),
missense AS (
  SELECT DISTINCT
    vep.Protein_position AS protein_pos
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS t,
       UNNEST(t.alternate_bases) AS alt,
       UNNEST(alt.vep) AS vep,
       brca1_region r
  WHERE t.start_position BETWEEN r.region_start AND r.region_end
    AND LOWER(vep.Consequence) LIKE '%missense_variant%'
    AND vep.Protein_position IS NOT NULL
)
SELECT
  protein_pos
FROM missense
ORDER BY CAST(SPLIT(protein_pos, '/')[SAFE_ORDINAL(1)] AS INT64)
LIMIT 1;
```
