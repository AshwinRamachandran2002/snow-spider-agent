```sql
--Description: 8) Final query – first (smallest) Protein_position for BRCA1 missense variants
WITH brca1_bounds AS (
  SELECT
    MIN(start_position) AS min_start,
    MAX(end_position)   AS max_end
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
  UNNEST(alternate_bases) AS alt,
  UNNEST(alt.vep)         AS vep
  WHERE vep.SYMBOL = 'BRCA1'
),
missense AS (
  SELECT DISTINCT
    CAST(SPLIT(vep.Protein_position, '/')[OFFSET(0)] AS INT64) AS protein_pos
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` g
  JOIN UNNEST(g.alternate_bases) AS alt
  JOIN UNNEST(alt.vep)           AS vep
  JOIN brca1_bounds              AS b
  ON g.start_position BETWEEN b.min_start AND b.max_end
  WHERE vep.Consequence LIKE '%missense_variant%'
    AND vep.Protein_position IS NOT NULL
)
SELECT protein_pos AS Protein_position
FROM missense
ORDER BY protein_pos
LIMIT 1;
```
