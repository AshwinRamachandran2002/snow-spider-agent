  CROSS JOIN UNNEST(alt.vep)           AS vep
  WHERE vep.Consequence LIKE '%missense_variant%'
    AND vep.Protein_position IS NOT NULL
)
-- 3) Smallest (earliest) protein position
SELECT Protein_position
FROM missense
ORDER BY Protein_position
LIMIT 1;
