```sql
--Description: Preview a handful of variants whose VEP annotation already contains the SYMBOL `BRCA1`
SELECT
  start_position,
  end_position,
  vep.SYMBOL,
  vep.Consequence,
  vep.Protein_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS g,
UNNEST(g.alternate_bases) AS alt,
UNNEST(alt.vep)          AS vep
WHERE vep.SYMBOL = 'BRCA1'
LIMIT 20;
```

```sql
--Description: Determine the genomic boundaries (smallest start & largest end) for all variants annotated with `BRCA1`
SELECT
  MIN(start_position) AS min_start,
  MAX(end_position) AS max_end
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS g,
UNNEST(g.alternate_bases) AS alt,
UNNEST(alt.vep)          AS vep
WHERE vep.SYMBOL = 'BRCA1';
```

```sql
--Description: Within that BRCA1 region, list distinct Protein_position values observed for any *missense_variant*  
WITH region AS (
  SELECT
    MIN(start_position) AS min_start,
    MAX(end_position)   AS max_end
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS g,
  UNNEST(g.alternate_bases) AS alt,
  UNNEST(alt.vep)          AS vep
  WHERE vep.SYMBOL = 'BRCA1'
)
SELECT DISTINCT
  vep.Protein_position
FROM region,
     `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS g,
     UNNEST(g.alternate_bases) AS alt,
     UNNEST(alt.vep)          AS vep
WHERE g.start_position BETWEEN region.min_start AND region.max_end
  AND LOWER(vep.Consequence) LIKE '%missense_variant%'
ORDER BY SAFE_CAST(SPLIT(vep.Protein_position, '/')[SAFE_OFFSET(0)] AS INT64)
LIMIT 20;
```

```sql
