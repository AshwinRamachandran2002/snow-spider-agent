```sql
--Description: 2) Show a few variants whose VEP annotation contains the gene symbol “BRCA1”.
SELECT
  start_position,
  end_position,
  alt.alt,
  vep.Consequence,
  vep.Protein_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
UNNEST(alternate_bases) AS alt,
UNNEST(alt.vep)      AS vep
WHERE vep.SYMBOL = 'BRCA1'
LIMIT 20;
```

```sql
--Description: 3) Find the smallest start_position and the largest end_position of any
--               variant annotated with SYMBOL = 'BRCA1' in chr17 genomes.
SELECT
  MIN(start_position) AS min_start_BRCA1,
  MAX(end_position)   AS max_end_BRCA1
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
UNNEST(alternate_bases) AS alt,
UNNEST(alt.vep)      AS vep
WHERE vep.SYMBOL = 'BRCA1';
```

```sql
--Description: 4) List all missense VEP entries that fall inside the BRCA1 region
--               (using the min / max found above), together with their protein positions.
WITH gene_region AS (
  SELECT
    MIN(start_position) AS min_start,
    MAX(end_position)   AS max_end
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
  UNNEST(alternate_bases) AS alt,
  UNNEST(alt.vep)      AS vep
  WHERE vep.SYMBOL = 'BRCA1'
)
SELECT
  g.start_position,
  g.end_position,
  vep.Protein_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS g
JOIN gene_region r
  ON g.start_position BETWEEN r.min_start AND r.max_end
CROSS JOIN UNNEST(g.alternate_bases) AS alt
CROSS JOIN UNNEST(alt.vep)           AS vep
WHERE vep.Consequence LIKE '%missense_variant%'
LIMIT 20;
```

