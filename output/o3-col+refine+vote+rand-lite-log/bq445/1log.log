Query:
--Description: 3) Find the smallest start_position and the largest end_position of any
--               variant annotated with SYMBOL = 'BRCA1' in chr17 genomes.
SELECT
  MIN(start_position) AS min_start_BRCA1,
  MAX(end_position)   AS max_end_BRCA1
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
UNNEST(alternate_bases) AS alt,
UNNEST(alt.vep)      AS vep
WHERE vep.SYMBOL = 'BRCA1';
