```sql
-- 2) Find a few variants whose VEP annotation symbol is 'BRCA1'
SELECT
  start_position,
  end_position,
  v.SYMBOL,
  v.Consequence
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(alternate_bases) AS ab,
     UNNEST(ab.vep) AS v
WHERE v.SYMBOL = 'BRCA1'
LIMIT 20;
```

```sql
-- 3) Get the smallest start_position and largest end_position
--    of any variant annotated with SYMBOL = 'BRCA1'
SELECT
  MIN(start_position) AS brca1_region_start,
  MAX(end_position)   AS brca1_region_end
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(alternate_bases) AS ab,
     UNNEST(ab.vep) AS v
WHERE v.SYMBOL = 'BRCA1';
```

```sql
-- 4) List a few variants that fall inside the BRCA1 region
--    (using the boundaries found in step 3 – replace ### with real numbers)
SELECT
  start_position,
  end_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
WHERE start_position BETWEEN ###brca1_region_start### AND ###brca1_region_end###
LIMIT 20;
```

```sql
-- 5) Look at VEP annotations for variants inside the region
--    to confirm we can reach Protein_position
SELECT
  start_position,
  v.Consequence,
  v.Protein_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(alternate_bases) AS ab,
     UNNEST(ab.vep) AS v
WHERE start_position BETWEEN ###brca1_region_start### AND ###brca1_region_end###
LIMIT 20;
```

```sql
-- 6) Collect distinct Protein_position values for missense variants
--    inside the BRCA1 region, ordered ascending
SELECT DISTINCT
  SAFE_CAST(v.Protein_position AS INT64) AS protein_pos
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(alternate_bases) AS ab,
     UNNEST(ab.vep) AS v
WHERE start_position BETWEEN ###brca1_region_start### AND ###brca1_region_end###
  AND LOWER(v.Consequence) LIKE '%missense_variant%'
ORDER BY protein_pos
LIMIT 20;
```

```sql
-- 7) Final answer: the very first Protein_position value
SELECT
  SAFE_CAST(v.Protein_position AS INT64) AS first_missense_protein_pos
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(alternate_bases) AS ab,
     UNNEST(ab.vep) AS v
WHERE start_position BETWEEN ###brca1_region_start### AND ###brca1_region_end###
  AND LOWER(v.Consequence) LIKE '%missense_variant%'
ORDER BY SAFE_CAST(v.Protein_position AS INT64)
LIMIT 1;
```

