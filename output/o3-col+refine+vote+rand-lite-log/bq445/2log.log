```sql
--Description:  
-- We already determined that any variant annotated with SYMBOL = 'BRCA1' lies between
--   start_position = 41 191 318 and 41 282 493 on chr17.  
-- The goal is to find the smallest (earliest) amino-acid position affected by a
--   missense_variant inside that BRCA1 interval.  
-- Steps implemented below:  
-- 1.  Restrict rows to variants whose start_position falls inside the BRCA1 span.  
-- 2.  UNNEST `alternate_bases`, then UNNEST each element’s `vep` annotations.  
-- 3.  Keep only VEP records whose Consequence contains “missense_variant”.  
-- 4.  The field `Protein_position` is a string like “123/1863” or “123-124/1863”.  
--     Take the first token before “/”, cast it to INT64 with SAFE_CAST.  
-- 5.  Sort ascending and fetch the first non-NULL value (LIMIT 1).  
SELECT
  SAFE_CAST( SPLIT(v.Protein_position, '/')[OFFSET(0)] AS INT64 ) AS first_missense_protein_pos
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(alternate_bases) AS ab,
     UNNEST(ab.vep)          AS v
WHERE start_position BETWEEN 41191318 AND 41282493          -- BRCA1 genomic region
  AND LOWER(v.Consequence) LIKE '%missense_variant%'        -- keep missense only
  AND v.Protein_position IS NOT NULL
ORDER BY first_missense_protein_pos
LIMIT 1;
```
