Query:
--Description: Inspect VEP annotations for variants within the BRCA1 region
--             to confirm the presence and format of the Protein_position field.
SELECT
  start_position,
  v.Consequence,
  v.Protein_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(alternate_bases) AS ab,
     UNNEST(ab.vep)          AS v
WHERE start_position BETWEEN 41191318 AND 41282493     -- BRCA1 genomic span
