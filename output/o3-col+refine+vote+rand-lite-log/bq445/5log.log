-- 2. Inspect a handful of VEP annotations to confirm field names
SELECT start_position, end_position,
       alt.alt            AS alt_allele,
       vep.SYMBOL         AS gene_symbol,
       vep.Consequence    AS consequence,
       vep.Protein_position AS protein_pos
FROM   `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
       UNNEST(alternate_bases) AS alt,
       UNNEST(alt.vep)   AS vep
WHERE  vep.SYMBOL = 'BRCA1'
LIMIT 20;
