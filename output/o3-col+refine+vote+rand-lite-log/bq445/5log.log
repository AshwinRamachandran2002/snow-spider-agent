-- 4. Find the genomic span of all variants that carry a BRCA1 VEP symbol
SELECT MIN(start_position) AS brca1_min_start,
       MAX(end_position)   AS brca1_max_end
FROM   `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
