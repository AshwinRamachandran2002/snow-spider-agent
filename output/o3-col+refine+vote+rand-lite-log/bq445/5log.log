```sql
-- 5. List a few variants that fall inside the BRCA1 span (using result of step-4)
WITH span AS (
  SELECT MIN(start_position) AS min_pos,
         MAX(end_position)   AS max_pos
  FROM   `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
         UNNEST(alternate_bases) AS alt,
         UNNEST(alt.vep)   AS vep
  WHERE  vep.SYMBOL = 'BRCA1'
)
SELECT start_position, end_position, alternate_bases
FROM   `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`, span
WHERE  start_position BETWEEN span.min_pos AND span.max_pos
LIMIT 20;
```

```sql
-- 6. Extract Protein_position values for missense variants inside the BRCA1 region
WITH span AS (
  SELECT MIN(start_position) AS min_pos,
         MAX(end_position)   AS max_pos
  FROM   `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
         UNNEST(alternate_bases) AS alt,
         UNNEST(alt.vep)   AS vep
  WHERE  vep.SYMBOL = 'BRCA1'
)
SELECT DISTINCT vep.Protein_position AS protein_pos
FROM   `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`, span,
       UNNEST(alternate_bases) AS alt,
       UNNEST(alt.vep)   AS vep
WHERE  start_position BETWEEN span.min_pos AND span.max_pos
  AND  LOWER(vep.Consequence) LIKE '%missense_variant%'
  AND  vep.Protein_position IS NOT NULL
LIMIT 20;
```

```sql
-- 7. Final answer: first (smallest) Protein_position for missense variants in BRCA1 region
WITH span AS (
  SELECT MIN(start_position) AS min_pos,
         MAX(end_position)   AS max_pos
  FROM   `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
         UNNEST(alternate_bases) AS alt,
         UNNEST(alt.vep)   AS vep
  WHERE  vep.SYMBOL = 'BRCA1'
)
SELECT vep.Protein_position
FROM   `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`, span,
       UNNEST(alternate_bases) AS alt,
       UNNEST(alt.vep)   AS vep
WHERE  start_position BETWEEN span.min_pos AND span.max_pos
  AND  LOWER(vep.Consequence) LIKE '%missense_variant%'
  AND  vep.Protein_position IS NOT NULL
ORDER BY CAST(SPLIT(vep.Protein_position,'/')[SAFE_OFFSET(0)] AS INT64) ASC
LIMIT 1;
```
