         AND week_date >= date('2020-06-15','-28 days') THEN 'before'
    WHEN week_date >= '2020-06-15'
         AND week_date <  date('2020-06-15','+28 days') THEN 'after'
  END                                                    AS period,
  SUM(sales)                                             AS total_sales_2020
FROM cleaned_weekly_sales
WHERE calendar_year = 2020
  AND week_date BETWEEN date('2020-06-15','-28 days')
                    AND date('2020-06-15','+27 days')
