         AND week_date >= date('2018-06-15','-28 days') THEN 'before'
    WHEN week_date >= '2018-06-15'
         AND week_date <  date('2018-06-15','+28 days') THEN 'after'
  END                                                   AS period,
  SUM(sales)                                            AS total_sales_2018
FROM cleaned_weekly_sales
