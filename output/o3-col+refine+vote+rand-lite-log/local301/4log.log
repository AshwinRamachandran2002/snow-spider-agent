```sql
--Description: Final report – combine all three years and calculate % change after vs. before mid-June
WITH yearly AS (
  SELECT * FROM (
    WITH cte AS (
      SELECT "week_date", SUM("sales") AS total_sales
      FROM "cleaned_weekly_sales"
      WHERE "calendar_year" = 2018
      GROUP BY "week_date"
    )
    SELECT '2018' AS year,
           (SELECT SUM(total_sales) FROM cte
             WHERE "week_date" <= '2018-06-15'
             ORDER BY "week_date" DESC LIMIT 4) AS sales_before,
           (SELECT SUM(total_sales) FROM cte
             WHERE "week_date" >  '2018-06-15'
             ORDER BY "week_date" ASC  LIMIT 4) AS sales_after
  )
  UNION ALL
  SELECT * FROM (
    WITH cte AS (
      SELECT "week_date", SUM("sales") AS total_sales
      FROM "cleaned_weekly_sales"
      WHERE "calendar_year" = 2019
      GROUP BY "week_date"
    )
    SELECT '2019' AS year,
           (SELECT SUM(total_sales) FROM cte
             WHERE "week_date" <= '2019-06-15'
             ORDER BY "week_date" DESC LIMIT 4) AS sales_before,
           (SELECT SUM(total_sales) FROM cte
             WHERE "week_date" >  '2019-06-15'
             ORDER BY "week_date" ASC  LIMIT 4) AS sales_after
  )
  UNION ALL
  SELECT * FROM (
    WITH cte AS (
      SELECT "week_date", SUM("sales") AS total_sales
      FROM "cleaned_weekly_sales"
      WHERE "calendar_year" = 2020
      GROUP BY "week_date"
    )
    SELECT '2020' AS year,
           (SELECT SUM(total_sales) FROM cte
             WHERE "week_date" <= '2020-06-15'
             ORDER BY "week_date" DESC LIMIT 4) AS sales_before,
           (SELECT SUM(total_sales) FROM cte
             WHERE "week_date" >  '2020-06-15'
             ORDER BY "week_date" ASC  LIMIT 4) AS sales_after
  )
)
SELECT year,
       sales_before,
       sales_after,
       ROUND((sales_after - sales_before) * 100.0 / sales_before, 2) AS pct_change
FROM yearly
LIMIT 20;
```
