[Self-refine]
2025-05-05 04:56:43 - Thread-4109 (execute) - INFO - [Try to run SQL in self-refine]
```sql
WITH weekly_totals AS (
    /* total sales for every calendar week */
    SELECT
        "week_date",
        "calendar_year"          AS year,
        SUM("sales")             AS week_sales
    FROM "cleaned_weekly_sales"
    GROUP BY "week_date", "calendar_year"
),
tagged_weeks AS (
    /* keep ten-week window (May-Jul) and tag weeks as BEFORE / AFTER 15-Jun
       plus give each tag a row_number so we can keep only the closest 4 weeks */
    SELECT
        year,
        "week_date",
        week_sales,
        CASE
            WHEN "week_date" <= DATE(year || '-06-15') THEN 'before'
            ELSE 'after'
        END                                            AS period,
        /* descending order for BEFORE, ascending for AFTER */
        CASE
            WHEN "week_date" <= DATE(year || '-06-15')
            THEN ROW_NUMBER() OVER (
                     PARTITION BY year, 'before'
                     ORDER BY "week_date" DESC)
            ELSE ROW_NUMBER() OVER (
                     PARTITION BY year, 'after'
                     ORDER BY "week_date")
        END                                            AS rn
    FROM weekly_totals
    WHERE "week_date"
          BETWEEN DATE(year || '-05-01')   -- start of window
              AND DATE(year || '-07-31')   -- end of window
),
closest_four AS (
    /* keep only the 4 weeks either side of 15-Jun */
    SELECT *
    FROM tagged_weeks
    WHERE rn <= 4
),
summarised AS (
    SELECT
        year,
        SUM(CASE WHEN period = 'before' THEN week_sales END) AS sales_before,
        SUM(CASE WHEN period = 'after'  THEN week_sales END) AS sales_after
    FROM closest_four
    GROUP BY year
)
SELECT
    year,
    sales_before,
    sales_after,
    ROUND(
        (sales_after - sales_before) * 100.0 / sales_before,
        4
    ) AS pct_change
FROM summarised
ORDER BY year;
```
