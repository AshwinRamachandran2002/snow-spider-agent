```sql
--Description: Look at a few June records to confirm the ISO-8601 date format (June 2020 shown as an example)  
SELECT *  
FROM "cleaned_weekly_sales"  
WHERE "week_date" BETWEEN '2020-06-01' AND '2020-06-30'  
LIMIT 20;  
```

```sql
--Description: Confirm that weeks are stored once per (year, week_number) pair – sample 10 rows  
SELECT DISTINCT "calendar_year", "week_number", "week_date", "sales"  
FROM "cleaned_weekly_sales"  
ORDER BY "calendar_year", "week_number"  
LIMIT 20;  
```

```sql
--Description:   Sum sales for each week during the four weeks *before* 15-Jun-2020  
SELECT "week_date", SUM("sales") AS "sales_before_jun15_2020"  
FROM "cleaned_weekly_sales"  
WHERE "week_date" BETWEEN DATE('2020-06-15','-28 days')  
                    AND  DATE('2020-06-15','-1 day')  
GROUP BY "week_date"  
ORDER BY "week_date"  
LIMIT 20;  
```

```sql
--Description:   Sum sales for each week during the four weeks *after* (and incl.) 15-Jun-2020  
SELECT "week_date", SUM("sales") AS "sales_after_jun15_2020"  
FROM "cleaned_weekly_sales"  
WHERE "week_date" BETWEEN DATE('2020-06-15')  
                    AND  DATE('2020-06-15','+27 days')  
GROUP BY "week_date"  
ORDER BY "week_date"  
LIMIT 20;  
```

```sql
--Description:   Aggregate total sales for the 4-week “before” and “after” windows for each year 2018-2020  
SELECT  c."calendar_year",  
        SUM( CASE  
                 WHEN c."week_date" BETWEEN DATE(c."calendar_year"||'-06-15','-28 days')  
                                      AND     DATE(c."calendar_year"||'-06-15','-1 day')  
                 THEN c."sales"  END ) AS "sales_before",  
  
        SUM( CASE  
                 WHEN c."week_date" BETWEEN DATE(c."calendar_year"||'-06-15')  
                                      AND     DATE(c."calendar_year"||'-06-15','+27 days')  
                 THEN c."sales"  END ) AS "sales_after"  
FROM   "cleaned_weekly_sales"  AS c  
WHERE  c."calendar_year" IN (2018,2019,2020)  
GROUP  BY c."calendar_year"  
LIMIT 20;  
```

```sql
--Description:   Calculate the percentage change: (after − before) ÷ before × 100 for each required year  
SELECT   y."calendar_year",  
         ROUND( 100.0 * (y."sales_after" - y."sales_before") / y."sales_before", 2 )  
               AS "pct_change_after_vs_before"  
FROM (  
        SELECT  c."calendar_year",  
                SUM( CASE  
                         WHEN c."week_date" BETWEEN DATE(c."calendar_year"||'-06-15','-28 days')  
                                              AND     DATE(c."calendar_year"||'-06-15','-1 day')  
                         THEN c."sales"  END ) AS "sales_before",  
  
                SUM( CASE  
                         WHEN c."week_date" BETWEEN DATE(c."calendar_year"||'-06-15')  
                                              AND     DATE(c."calendar_year"||'-06-15','+27 days')  
                         THEN c."sales"  END ) AS "sales_after"  
        FROM   "cleaned_weekly_sales"  AS c  
        WHERE  c."calendar_year" IN (2018,2019,2020)  
        GROUP  BY c."calendar_year"  
     )  AS y  
LIMIT 20;  
```

```sql
--Description:  Break the above into two columns per year so you can eyeball the raw totals as well  
SELECT   y."calendar_year",  
         y."sales_before",  
         y."sales_after",  
         ROUND( 100.0 * (y."sales_after" - y."sales_before") / y."sales_before", 2 )  
               AS "pct_change_after_vs_before"  
FROM (  
        SELECT  c."calendar_year",  
                SUM( CASE  
                         WHEN c."week_date" BETWEEN DATE(c."calendar_year"||'-06-15','-28 days')  
                                              AND     DATE(c."calendar_year"||'-06-15','-1 day')  
                         THEN c."sales"  END ) AS "sales_before",  
  
                SUM( CASE  
                         WHEN c."week_date" BETWEEN DATE(c."calendar_year"||'-06-15')  
                                              AND     DATE(c."calendar_year"||'-06-15','+27 days')  
                         THEN c."sales"  END ) AS "sales_after"  
        FROM   "cleaned_weekly_sales"  AS c  
        WHERE  c."calendar_year" IN (2018,2019,2020)  
        GROUP  BY c."calendar_year"  
     )  AS y  
LIMIT 20;  
```

```sql
--Description:  If you want to inspect just one year’s 8-week window side-by-side (2019 example)  
SELECT "week_date", "sales",  
       CASE WHEN "week_date" <  '2019-06-15' THEN 'Before' ELSE 'After' END AS "window"  
FROM   "cleaned_weekly_sales"  
WHERE  "week_date" BETWEEN DATE('2019-06-15','-28 days')  
                       AND  DATE('2019-06-15','+27 days')  
ORDER  BY "week_date"  
LIMIT 20;  
```

```sql
--Description:  Final compact result – percentage change for each year 2018-2020  
SELECT  ROUND( 100.0 * (SUM(CASE WHEN "week_date" BETWEEN DATE("calendar_year"||'-06-15')  
                                  AND     DATE("calendar_year"||'-06-15','+27 days')  
                             THEN "sales" END)  
                      - SUM(CASE WHEN "week_date" BETWEEN DATE("calendar_year"||'-06-15','-28 days')  
                                  AND     DATE("calendar_year"||'-06-15','-1 day')  
                             THEN "sales" END) )  
             / SUM(CASE WHEN "week_date" BETWEEN DATE("calendar_year"||'-06-15','-28 days')  
                                  AND     DATE("calendar_year"||'-06-15','-1 day')  
                        THEN "sales" END), 2)  
        AS "pct_change",  
        "calendar_year"  
FROM "cleaned_weekly_sales"  
WHERE "calendar_year" IN (2018,2019,2020)  
GROUP BY "calendar_year"  
LIMIT 20;  
```
