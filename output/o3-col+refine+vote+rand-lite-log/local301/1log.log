--Description: 1.  Display every distinct week_date we have in June 2020 so we can
--              see the exact Monday-based week labels that appear in the data.
SELECT DISTINCT "week_date"
FROM "cleaned_weekly_sales"
WHERE "week_date" BETWEEN '2020-06-01' AND '2020-06-30'
ORDER BY "week_date"
LIMIT 20;
```

```sql
--Description: 2.  List all week_numbers and the associated dates that sit
--              roughly four weeks either side of 15 June for 2018-2020.
SELECT DISTINCT "calendar_year",
       "week_number",
       "week_date"
FROM "cleaned_weekly_sales"
WHERE ("week_date" BETWEEN '2018-05-18' AND '2018-07-12')
   OR ("week_date" BETWEEN '2019-05-18' AND '2019-07-12')
   OR ("week_date" BETWEEN '2020-05-18' AND '2020-07-12')
ORDER BY "calendar_year", "week_number"
LIMIT 20;
```

```sql
--Description: 3.  Total weekly sales for the mid-May → mid-July window in 2020.
SELECT "week_date",
       SUM("sales") AS "total_sales"
FROM "cleaned_weekly_sales"
WHERE "week_date" BETWEEN '2020-05-18' AND '2020-07-12'
GROUP BY "week_date"
ORDER BY "week_date"
LIMIT 20;
```

```sql
--Description: 4.  Aggregate the four weeks BEFORE (18 May–14 Jun) and AFTER
--              (15 Jun–12 Jul) 15 June 2020.
SELECT '2020' AS "calendar_year",
       SUM(CASE
             WHEN "week_date" BETWEEN '2020-05-18' AND '2020-06-14'
             THEN "sales" END) AS "pre_sales",
       SUM(CASE
             WHEN "week_date" BETWEEN '2020-06-15' AND '2020-07-12'
             THEN "sales" END) AS "post_sales"
FROM   "cleaned_weekly_sales"
WHERE  "week_date" BETWEEN '2020-05-18' AND '2020-07-12'
LIMIT 20;
```

```sql
--Description: 5.  Same aggregation window for the year 2019.
