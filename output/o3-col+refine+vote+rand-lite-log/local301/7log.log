LIMIT 20;
```

```sql
--Description: 9. Aggregate four weeks BEFORE vs four weeks AFTER 15-Jun for each year, returning raw totals.
WITH midweek AS (
    SELECT "calendar_year",
           "week_number" AS "mid_week"
    FROM   "cleaned_weekly_sales"
    WHERE  "week_date" = CAST("calendar_year" AS TEXT) || '-06-15'
),
windowed AS (
    SELECT c."calendar_year",
           SUM(CASE WHEN c."week_number" BETWEEN m."mid_week" - 4 AND m."mid_week" - 1
                    THEN c."sales" ELSE 0 END) AS "pre_sales",
           SUM(CASE WHEN c."week_number" BETWEEN m."mid_week" + 1 AND m."mid_week" + 4
                    THEN c."sales" ELSE 0 END) AS "post_sales"
    FROM   "cleaned_weekly_sales" AS c
    JOIN   midweek                AS m
           ON c."calendar_year" = m."calendar_year"
    WHERE  c."calendar_year" IN (2018, 2019, 2020)
    GROUP  BY c."calendar_year"
)
SELECT *
FROM   windowed
LIMIT 20;
```

```sql
--Description: 10. Final answer – percentage change in sales (post-four-weeks vs pre-four-weeks) for 2018-2020.
WITH midweek AS (
    SELECT "calendar_year",
           "week_number" AS "mid_week"
    FROM   "cleaned_weekly_sales"
    WHERE  "week_date" = CAST("calendar_year" AS TEXT) || '-06-15'
),
windowed AS (
    SELECT c."calendar_year",
           SUM(CASE WHEN c."week_number" BETWEEN m."mid_week" - 4 AND m."mid_week" - 1
                    THEN c."sales" END) AS "pre_sales",
           SUM(CASE WHEN c."week_number" BETWEEN m."mid_week" + 1 AND m."mid_week" + 4
                    THEN c."sales" END) AS "post_sales"
    FROM   "cleaned_weekly_sales" AS c
    JOIN   midweek                AS m
           ON c."calendar_year" = m."calendar_year"
    WHERE  c."calendar_year" IN (2018, 2019, 2020)
    GROUP  BY c."calendar_year"
)
SELECT "calendar_year",
       "pre_sales",
       "post_sales",
       ROUND(100.0 * ("post_sales" - "pre_sales") / "pre_sales", 2) AS "pct_change"
FROM   windowed
ORDER  BY "calendar_year";
```
