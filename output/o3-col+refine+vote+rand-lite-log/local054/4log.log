```sql
--Description: Show 20 sample albums together with their artists to confirm the join path.
SELECT al."AlbumId", al."Title", ar."Name" AS "ArtistName"
FROM "albums" AS al
JOIN "artists" AS ar ON al."ArtistId" = ar."ArtistId"
LIMIT 20;
```

```sql
--Description: Look at some invoice items and the customers who purchased them.
SELECT ii."InvoiceLineId", ii."TrackId", ii."UnitPrice", ii."Quantity",
       inv."InvoiceId", cu."FirstName"
FROM "invoice_items" AS ii
JOIN "invoices"  AS inv ON ii."InvoiceId" = inv."InvoiceId"
JOIN "customers" AS cu  ON inv."CustomerId" = cu."CustomerId"
LIMIT 20;
```

```sql
--Description: Calculate total sales revenue for every artist (top 20 shown).
SELECT ar."ArtistId", ar."Name",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "TotalSales"
FROM "artists" AS ar
JOIN "albums"  AS al ON al."ArtistId" = ar."ArtistId"
JOIN "tracks"  AS tr ON tr."AlbumId"  = al."AlbumId"
JOIN "invoice_items" AS ii ON ii."TrackId" = tr."TrackId"
GROUP BY ar."ArtistId"
ORDER BY "TotalSales" DESC
LIMIT 20;
```

```sql
--Description: Retrieve the single best-selling artist (highest overall revenue).
SELECT ar."ArtistId", ar."Name",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "TotalSales"
FROM "artists" AS ar
JOIN "albums"  AS al ON al."ArtistId" = ar."ArtistId"
JOIN "tracks"  AS tr ON tr."AlbumId"  = al."AlbumId"
JOIN "invoice_items" AS ii ON ii."TrackId" = tr."TrackId"
GROUP BY ar."ArtistId"
ORDER BY "TotalSales" DESC
LIMIT 1;
```

```sql
--Description: Aggregate what every customer has spent on that best-selling artist.
SELECT cu."CustomerId", cu."FirstName",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "AmountSpent"
FROM "customers" AS cu
JOIN "invoices" AS inv ON inv."CustomerId" = cu."CustomerId"
JOIN "invoice_items" AS ii ON ii."InvoiceId" = inv."InvoiceId"
JOIN "tracks"  AS tr  ON tr."TrackId"  = ii."TrackId"
JOIN "albums"  AS al  ON al."AlbumId"  = tr."AlbumId"
WHERE al."ArtistId" = (
      SELECT ar."ArtistId"
      FROM "artists" AS ar
      JOIN "albums"  AS al2 ON al2."ArtistId" = ar."ArtistId"
      JOIN "tracks"  AS tr2 ON tr2."AlbumId"  = al2."AlbumId"
      JOIN "invoice_items" AS ii2 ON ii2."TrackId" = tr2."TrackId"
      GROUP BY ar."ArtistId"
      ORDER BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC
      LIMIT 1)
GROUP BY cu."CustomerId"
LIMIT 20;
```

```sql
--Description: Find customers whose spending on that artist is under $1.
SELECT cu."CustomerId", cu."FirstName",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "AmountSpent"
FROM "customers" AS cu
JOIN "invoices" AS inv ON inv."CustomerId" = cu."CustomerId"
JOIN "invoice_items" AS ii ON ii."InvoiceId" = inv."InvoiceId"
JOIN "tracks"  AS tr  ON tr."TrackId"  = ii."TrackId"
JOIN "albums"  AS al  ON al."AlbumId"  = tr."AlbumId"
WHERE al."ArtistId" = (
      SELECT ar."ArtistId"
      FROM "artists" AS ar
      JOIN "albums"  AS al2 ON al2."ArtistId" = ar."ArtistId"
      JOIN "tracks"  AS tr2 ON tr2."AlbumId"  = al2."AlbumId"
      JOIN "invoice_items" AS ii2 ON ii2."TrackId" = tr2."TrackId"
      GROUP BY ar."ArtistId"
      ORDER BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC
      LIMIT 1)
GROUP BY cu."CustomerId"
HAVING "AmountSpent" < 1
LIMIT 20;
```

```sql
--Description: Final answer – first names of customers who spent less than $1 on the best-selling artist, together with the amounts they spent.
SELECT cu."FirstName",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "AmountSpent"
FROM "customers" AS cu
JOIN "invoices" AS inv ON inv."CustomerId" = cu."CustomerId"
JOIN "invoice_items" AS ii ON ii."InvoiceId" = inv."InvoiceId"
JOIN "tracks"  AS tr  ON tr."TrackId"  = ii."TrackId"
JOIN "albums"  AS al  ON al."AlbumId"  = tr."AlbumId"
WHERE al."ArtistId" = (
      SELECT ar."ArtistId"
      FROM "artists" AS ar
      JOIN "albums"  AS al2 ON al2."ArtistId" = ar."ArtistId"
      JOIN "tracks"  AS tr2 ON tr2."AlbumId"  = al2."AlbumId"
      JOIN "invoice_items" AS ii2 ON ii2."TrackId" = tr2."TrackId"
      GROUP BY ar."ArtistId"
      ORDER BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC
      LIMIT 1)
GROUP BY cu."CustomerId"
HAVING "AmountSpent" < 1
ORDER BY "AmountSpent" DESC
LIMIT 20;
```
