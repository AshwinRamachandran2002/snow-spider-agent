Query:
--Description: Aggregate what every customer has spent on that best-selling artist.
SELECT cu."CustomerId", cu."FirstName",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "AmountSpent"
FROM "customers" AS cu
JOIN "invoices" AS inv ON inv."CustomerId" = cu."CustomerId"
JOIN "invoice_items" AS ii ON ii."InvoiceId" = inv."InvoiceId"
JOIN "tracks"  AS tr  ON tr."TrackId"  = ii."TrackId"
JOIN "albums"  AS al  ON al."AlbumId"  = tr."AlbumId"
WHERE al."ArtistId" = (
      SELECT ar."ArtistId"
      FROM "artists" AS ar
      JOIN "albums"  AS al2 ON al2."ArtistId" = ar."ArtistId"
      JOIN "tracks"  AS tr2 ON tr2."AlbumId"  = al2."AlbumId"
      JOIN "invoice_items" AS ii2 ON ii2."TrackId" = tr2."TrackId"
      GROUP BY ar."ArtistId"
      ORDER BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC
      LIMIT 1)
GROUP BY cu."CustomerId"
LIMIT 20;
