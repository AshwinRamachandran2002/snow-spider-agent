Query:
--Description: Calculate total sales revenue for every artist (top 20 shown).
SELECT ar."ArtistId", ar."Name",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "TotalSales"
FROM "artists" AS ar
JOIN "albums"  AS al ON al."ArtistId" = ar."ArtistId"
JOIN "tracks"  AS tr ON tr."AlbumId"  = al."AlbumId"
JOIN "invoice_items" AS ii ON ii."TrackId" = tr."TrackId"
GROUP BY ar."ArtistId"
ORDER BY "TotalSales" DESC
LIMIT 20;
