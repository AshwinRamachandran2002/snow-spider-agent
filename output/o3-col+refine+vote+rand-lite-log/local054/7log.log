```sql
--Description: Peek at which artist each album belongs to.
SELECT a."AlbumId",
       a."Title",
       ar."Name"  AS "Artist_Name"
FROM   "albums"            AS a
JOIN   "artists"           AS ar ON a."ArtistId" = ar."ArtistId"
LIMIT 20;
```

```sql
--Description: See which track belongs to which album and artist.
SELECT t."TrackId",
       t."Name"     AS "Track_Name",
       al."Title"   AS "Album_Title",
       ar."Name"    AS "Artist_Name"
FROM   "tracks"  AS t
JOIN   "albums"  AS al ON t."AlbumId"  = al."AlbumId"
JOIN   "artists" AS ar ON al."ArtistId" = ar."ArtistId"
LIMIT 20;
```

```sql
--Description: Inspect invoice lines to understand quantity and unit price paid for each track purchase.
SELECT ii."InvoiceLineId",
       ii."InvoiceId",
       ii."TrackId",
       ii."UnitPrice",
       ii."Quantity"
FROM   "invoice_items" AS ii
LIMIT 20;
```

```sql
--Description: Combine invoice items with track → album → artist to see revenue generated per track by artist.
SELECT ii."InvoiceLineId",
       ar."Name"                         AS "Artist_Name",
       (ii."UnitPrice" * ii."Quantity")  AS "Revenue"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS al ON t."AlbumId"  = al."AlbumId"
JOIN   "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
LIMIT 20;
```

```sql
--Description: Calculate total revenue per artist; the first row (after ordering) will be the best-selling artist.
SELECT ar."ArtistId",
       ar."Name"                  AS "Artist_Name",
       SUM(ii."UnitPrice" * ii."Quantity") AS "Total_Revenue"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS al ON t."AlbumId"  = al."AlbumId"
JOIN   "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "Total_Revenue" DESC
LIMIT 20;
```

```sql
--Description: Identify the single best-selling artist (top 1 by revenue).
SELECT ar."ArtistId",
       ar."Name"                  AS "Best_Selling_Artist",
       SUM(ii."UnitPrice" * ii."Quantity") AS "Total_Revenue"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS al ON t."AlbumId"  = al."AlbumId"
JOIN   "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "Total_Revenue" DESC
LIMIT 1;
```

```sql
--Description: Show, per customer, how much they spent on tracks by the best-selling artist (replace X with the ArtistId found above).
SELECT c."CustomerId",
       c."FirstName",
       SUM(ii."UnitPrice" * ii."Quantity") AS "Spent_On_Best_Selling_Artist"
FROM   "customers"      AS c
JOIN   "invoices"       AS i  ON c."CustomerId" = i."CustomerId"
JOIN   "invoice_items"  AS ii ON i."InvoiceId"   = ii."InvoiceId"
JOIN   "tracks"         AS t  ON ii."TrackId"    = t."TrackId"
JOIN   "albums"         AS al ON t."AlbumId"     = al."AlbumId"
WHERE  al."ArtistId" = X      -- ← replace X with ArtistId from previous query
GROUP  BY c."CustomerId", c."FirstName"
LIMIT 20;
```

```sql
--Description: Retrieve only those customers whose spending on the best-selling artist is < \$1.
SELECT c."FirstName",
       SUM(ii."UnitPrice" * ii."Quantity") AS "Amount_Spent"
FROM   "customers"      AS c
JOIN   "invoices"       AS i  ON c."CustomerId" = i."CustomerId"
JOIN   "invoice_items"  AS ii ON i."InvoiceId"   = ii."InvoiceId"
JOIN   "tracks"         AS t  ON ii."TrackId"    = t."TrackId"
JOIN   "albums"         AS al ON t."AlbumId"     = al."AlbumId"
WHERE  al."ArtistId" = X      -- ← replace X with ArtistId from query 6
GROUP  BY c."CustomerId", c."FirstName"
HAVING "Amount_Spent" < 1
LIMIT 20;
```

```sql
