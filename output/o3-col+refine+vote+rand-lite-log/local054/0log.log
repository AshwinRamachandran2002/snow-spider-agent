```sql
-- 1. Inspect some invoices to understand how sales amounts are recorded
SELECT DISTINCT "InvoiceId", "CustomerId", "Total"
FROM "invoices"
LIMIT 20;
```

```sql
-- 2. Check the linkage between an invoice and its individual line items
SELECT DISTINCT "InvoiceLineId", "InvoiceId", "TrackId", "UnitPrice", "Quantity"
FROM "invoice_items"
LIMIT 20;
```

```sql
-- 3. Verify how each track maps to its album (and therefore to an artist)
SELECT DISTINCT "TrackId", "Name", "AlbumId"
FROM "tracks"
LIMIT 20;
```

```sql
-- 4. Confirm how an album maps to an artist
SELECT DISTINCT "AlbumId", "Title", "ArtistId"
FROM "albums"
LIMIT 20;
```

```sql
-- 5. Identify the total sales (UnitPrice * Quantity) for every artist
SELECT a."ArtistId",
       ar."Name"      AS "Artist_Name",
       SUM(ii."UnitPrice" * ii."Quantity") AS "Artist_Sales"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS a  ON t."AlbumId"  = a."AlbumId"
JOIN   "artists"       AS ar ON a."ArtistId" = ar."ArtistId"
GROUP  BY a."ArtistId"
ORDER  BY "Artist_Sales" DESC
LIMIT 20;
```

```sql
-- 6. Capture the single best-selling artist (highest total sales)
SELECT a."ArtistId",
       ar."Name"      AS "Best_Selling_Artist",
       SUM(ii."UnitPrice" * ii."Quantity") AS "Total_Sales"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS a  ON t."AlbumId"  = a."AlbumId"
JOIN   "artists"       AS ar ON a."ArtistId" = ar."ArtistId"
GROUP  BY a."ArtistId"
ORDER  BY "Total_Sales" DESC
LIMIT 1;
```

```sql
-- 7. Compute how much every customer spent on tracks belonging ONLY to that best-selling artist
-- (Replace :best_artist_id with the value obtained from query 6)
SELECT  inv."CustomerId",
        SUM(ii."UnitPrice" * ii."Quantity") AS "Amount_Spent_On_Best_Artist"
FROM    "invoice_items" AS ii
JOIN    "invoices"      AS inv ON ii."InvoiceId" = inv."InvoiceId"
JOIN    "tracks"        AS t   ON ii."TrackId"   = t."TrackId"
JOIN    "albums"        AS al  ON t."AlbumId"    = al."AlbumId"
WHERE   al."ArtistId" = :best_artist_id
GROUP   BY inv."CustomerId"
LIMIT 20;
```

```sql
-- 8. Return first names of customers who spent < $1 on music by the best-selling artist
-- along with the exact amounts they spent
-- (Again, substitute :best_artist_id with the ID from query 6)
SELECT  c."FirstName",
        SUM(ii."UnitPrice" * ii."Quantity") AS "Amount_Spent"
FROM    "customers"     AS c
JOIN    "invoices"      AS inv ON c."CustomerId" = inv."CustomerId"
JOIN    "invoice_items" AS ii  ON inv."InvoiceId" = ii."InvoiceId"
JOIN    "tracks"        AS t   ON ii."TrackId"    = t."TrackId"
JOIN    "albums"        AS al  ON t."AlbumId"     = al."AlbumId"
WHERE   al."ArtistId" = :best_artist_id
GROUP   BY c."CustomerId"
HAVING  SUM(ii."UnitPrice" * ii."Quantity") < 1
LIMIT 20;
```
