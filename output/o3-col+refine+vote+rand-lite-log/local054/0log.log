```sql
--Description:
-- We know from earlier analysis that the top-selling artist is Iron Maiden (ArtistId = 90).
-- Goal: list customers whose total purchases of Iron Maiden tracks are under $1.
-- Method:
--   1. Join customers → invoices → invoice_items → tracks → albums.
--   2. Filter albums to ArtistId = 90.
--   3. Sum UnitPrice × Quantity per customer.
--   4. Keep only totals < 1 and show the customer’s first name and that amount.
SELECT  c."FirstName",
        SUM(ii."UnitPrice" * ii."Quantity") AS "Amount_Spent"
FROM    "customers"     AS c
JOIN    "invoices"      AS inv ON c."CustomerId" = inv."CustomerId"
JOIN    "invoice_items" AS ii  ON inv."InvoiceId" = ii."InvoiceId"
JOIN    "tracks"        AS t   ON ii."TrackId"    = t."TrackId"
JOIN    "albums"        AS al  ON t."AlbumId"     = al."AlbumId"
WHERE   al."ArtistId" = 90
GROUP   BY c."CustomerId"
HAVING  SUM(ii."UnitPrice" * ii."Quantity") < 1;
```
