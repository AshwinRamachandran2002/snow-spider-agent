       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "amount_spent"
FROM   "customers"     AS c
JOIN   "invoices"      AS inv ON inv."CustomerId" = c."CustomerId"
JOIN   "invoice_items" AS ii  ON ii."InvoiceId"   = inv."InvoiceId"
JOIN   "tracks"        AS t   ON t."TrackId"      = ii."TrackId"
JOIN   "albums"        AS al  ON al."AlbumId"     = t."AlbumId"
WHERE  al."ArtistId"   = (     -- best-selling artist
          SELECT ar2."ArtistId"
          FROM   "artists" AS ar2
          JOIN   "albums"  AS al2 ON al2."ArtistId" = ar2."ArtistId"
          JOIN   "tracks"  AS t2  ON t2."AlbumId"   = al2."AlbumId"
          JOIN   "invoice_items" AS ii2 ON ii2."TrackId" = t2."TrackId"
          GROUP  BY ar2."ArtistId"
          ORDER  BY SUM(ii2."UnitPrice"*ii2."Quantity") DESC
          LIMIT 1 )
GROUP  BY c."CustomerId"
HAVING "amount_spent" < 1
ORDER  BY "amount_spent" DESC
LIMIT  20;
