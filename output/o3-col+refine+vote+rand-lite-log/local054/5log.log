```sql
-- 1. Preview some artists.
SELECT DISTINCT "ArtistId",
                "Name"
FROM   "artists"
LIMIT  20;
```

```sql
-- 2. Compute the sales-revenue generated by every artist.
SELECT ar."ArtistId",
       ar."Name",
       SUM(ii."UnitPrice" * ii."Quantity") AS "revenue"
FROM   "artists"        AS ar
JOIN   "albums"         AS al ON al."ArtistId" = ar."ArtistId"
JOIN   "tracks"         AS t  ON t."AlbumId"   = al."AlbumId"
JOIN   "invoice_items"  AS ii ON ii."TrackId"  = t."TrackId"
GROUP  BY ar."ArtistId"
ORDER  BY "revenue" DESC
LIMIT  20;
```

```sql
-- 3. Identify the single best-selling artist.
SELECT ar."ArtistId",
       ar."Name",
       SUM(ii."UnitPrice" * ii."Quantity") AS "revenue"
FROM   "artists"        AS ar
JOIN   "albums"         AS al ON al."ArtistId" = ar."ArtistId"
JOIN   "tracks"         AS t  ON t."AlbumId"   = al."AlbumId"
JOIN   "invoice_items"  AS ii ON ii."TrackId"  = t."TrackId"
GROUP  BY ar."ArtistId"
ORDER  BY "revenue" DESC
LIMIT  1;
```

```sql
-- 4. Take a look at 20 tracks that belong to the best-selling artist.
SELECT DISTINCT t."TrackId",
                t."Name"
FROM   "tracks"   AS t
JOIN   "albums"   AS al ON al."AlbumId"   = t."AlbumId"
WHERE  al."ArtistId" = (          -- ArtistId found in query #3
          SELECT ar2."ArtistId"
          FROM   "artists" AS ar2
          JOIN   "albums"  AS al2 ON al2."ArtistId" = ar2."ArtistId"
          JOIN   "tracks"  AS t2  ON t2."AlbumId"   = al2."AlbumId"
          JOIN   "invoice_items" AS ii2 ON ii2."TrackId" = t2."TrackId"
          GROUP  BY ar2."ArtistId"
          ORDER  BY SUM(ii2."UnitPrice"*ii2."Quantity") DESC
          LIMIT 1 )
LIMIT  20;
```

```sql
-- 5. Preview some customers.
SELECT DISTINCT "CustomerId",
                "FirstName",
                "LastName"
FROM   "customers"
LIMIT  20;
```

```sql
-- 6. Inspect a few invoice items that involve the best-selling artist.
SELECT DISTINCT ii."InvoiceId",
                ii."TrackId",
                ii."UnitPrice",
                ii."Quantity"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON t."TrackId"  = ii."TrackId"
JOIN   "albums"        AS al ON al."AlbumId" = t."AlbumId"
WHERE  al."ArtistId"   = (     -- same sub-query used in #4
          SELECT ar2."ArtistId"
          FROM   "artists" AS ar2
          JOIN   "albums"  AS al2 ON al2."ArtistId" = ar2."ArtistId"
          JOIN   "tracks"  AS t2  ON t2."AlbumId"   = al2."AlbumId"
          JOIN   "invoice_items" AS ii2 ON ii2."TrackId" = t2."TrackId"
          GROUP  BY ar2."ArtistId"
          ORDER  BY SUM(ii2."UnitPrice"*ii2."Quantity") DESC
          LIMIT 1 )
LIMIT  20;
```

```sql
-- 7. Work out how much each customer spent on that artist.
SELECT c."CustomerId",
       c."FirstName",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "amount_spent"
FROM   "customers"     AS c
JOIN   "invoices"      AS inv ON inv."CustomerId" = c."CustomerId"
JOIN   "invoice_items" AS ii  ON ii."InvoiceId"   = inv."InvoiceId"
JOIN   "tracks"        AS t   ON t."TrackId"      = ii."TrackId"
JOIN   "albums"        AS al  ON al."AlbumId"     = t."AlbumId"
WHERE  al."ArtistId"   = (     -- best-selling artist again
          SELECT ar2."ArtistId"
          FROM   "artists" AS ar2
          JOIN   "albums"  AS al2 ON al2."ArtistId" = ar2."ArtistId"
          JOIN   "tracks"  AS t2  ON t2."AlbumId"   = al2."AlbumId"
          JOIN   "invoice_items" AS ii2 ON ii2."TrackId" = t2."TrackId"
          GROUP  BY ar2."ArtistId"
          ORDER  BY SUM(ii2."UnitPrice"*ii2."Quantity") DESC
          LIMIT 1 )
GROUP  BY c."CustomerId"
LIMIT  20;
```

```sql
-- 8. Keep just the customers whose total is below one dollar.
SELECT c."CustomerId",
       c."FirstName",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "amount_spent"
FROM   "customers"     AS c
JOIN   "invoices"      AS inv ON inv."CustomerId" = c."CustomerId"
JOIN   "invoice_items" AS ii  ON ii."InvoiceId"   = inv."InvoiceId"
JOIN   "tracks"        AS t   ON t."TrackId"      = ii."TrackId"
JOIN   "albums"        AS al  ON al."AlbumId"     = t."AlbumId"
WHERE  al."ArtistId"   = (     -- best-selling artist
          SELECT ar2."ArtistId"
          FROM   "artists" AS ar2
          JOIN   "albums"  AS al2 ON al2."ArtistId" = ar2."ArtistId"
          JOIN   "tracks"  AS t2  ON t2."AlbumId"   = al2."AlbumId"
          JOIN   "invoice_items" AS ii2 ON ii2."TrackId" = t2."TrackId"
          GROUP  BY ar2."ArtistId"
          ORDER  BY SUM(ii2."UnitPrice"*ii2."Quantity") DESC
          LIMIT 1 )
GROUP  BY c."CustomerId"
HAVING "amount_spent" < 1
LIMIT  20;
```

```sql
-- 9. FINAL ANSWER  – first names of customers who spent < $1 on the top artist
--                    together with the exact amounts they spent.
SELECT c."FirstName",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "amount_spent"
FROM   "customers"     AS c
JOIN   "invoices"      AS inv ON inv."CustomerId" = c."CustomerId"
JOIN   "invoice_items" AS ii  ON ii."InvoiceId"   = inv."InvoiceId"
JOIN   "tracks"        AS t   ON t."TrackId"      = ii."TrackId"
JOIN   "albums"        AS al  ON al."AlbumId"     = t."AlbumId"
WHERE  al."ArtistId"   = (     -- best-selling artist
          SELECT ar2."ArtistId"
          FROM   "artists" AS ar2
          JOIN   "albums"  AS al2 ON al2."ArtistId" = ar2."ArtistId"
          JOIN   "tracks"  AS t2  ON t2."AlbumId"   = al2."AlbumId"
          JOIN   "invoice_items" AS ii2 ON ii2."TrackId" = t2."TrackId"
          GROUP  BY ar2."ArtistId"
          ORDER  BY SUM(ii2."UnitPrice"*ii2."Quantity") DESC
          LIMIT 1 )
GROUP  BY c."CustomerId"
HAVING "amount_spent" < 1
ORDER  BY "amount_spent" DESC
LIMIT  20;
```
