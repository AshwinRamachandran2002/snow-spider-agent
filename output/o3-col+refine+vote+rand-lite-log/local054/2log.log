```sql
-- 1️⃣ Description: Peek at some artists to recall their ids and names.
SELECT DISTINCT "ArtistId", "Name"
FROM "artists"
LIMIT 20;
```

```sql
-- 2️⃣ Description: Check how albums link to artists and gather a few rows.
SELECT DISTINCT "AlbumId", "Title", "ArtistId"
FROM "albums"
LIMIT 20;
```

```sql
-- 3️⃣ Description: Examine a handful of tracks together with their album and artist.
SELECT DISTINCT tr."TrackId",
       tr."Name"        AS "TrackName",
       al."Title"       AS "AlbumTitle",
       ar."Name"        AS "ArtistName"
FROM   "tracks"      AS tr
JOIN   "albums"      AS al ON tr."AlbumId" = al."AlbumId"
JOIN   "artists"     AS ar ON al."ArtistId" = ar."ArtistId"
LIMIT 20;
```

```sql
-- 4️⃣ Description: See how sales (invoice_items) look for a few random invoice lines.
SELECT DISTINCT "InvoiceLineId",
       "InvoiceId",
       "TrackId",
       "UnitPrice",
       "Quantity"
FROM   "invoice_items"
LIMIT 20;
```

```sql
-- 5️⃣ Description: Compute total revenue per artist; list top 20 sellers (most to least).
SELECT ar."ArtistId",
       ar."Name"                       AS "ArtistName",
       SUM(ii."UnitPrice" * ii."Quantity") AS "Revenue"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS tr ON ii."TrackId" = tr."TrackId"
JOIN   "albums"        AS al ON tr."AlbumId" = al."AlbumId"
JOIN   "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "Revenue" DESC
LIMIT 20;
```

```sql
-- 6️⃣ Description: Isolate the single best-selling artist (highest revenue).
-- (LIMIT 1 keeps only the top artist.)
SELECT ar."ArtistId",
       ar."Name"                       AS "BestSellingArtist",
       SUM(ii."UnitPrice" * ii."Quantity") AS "TotalRevenue"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS tr ON ii."TrackId" = tr."TrackId"
JOIN   "albums"        AS al ON tr."AlbumId" = al."AlbumId"
JOIN   "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "TotalRevenue" DESC
LIMIT 1;
```

```sql
-- 7️⃣ Description: For that best-selling artist, show how much each customer has spent.
-- (Replace X with the ArtistId returned by query 6 if you wish to hard-code it.)
SELECT cu."CustomerId",
       cu."FirstName",
       SUM(ii."UnitPrice" * ii."Quantity") AS "AmountSpent"
FROM   "customers"     AS cu
JOIN   "invoices"      AS inv ON cu."CustomerId" = inv."CustomerId"
JOIN   "invoice_items" AS ii  ON inv."InvoiceId" = ii."InvoiceId"
JOIN   "tracks"        AS tr  ON ii."TrackId" = tr."TrackId"
JOIN   "albums"        AS al  ON tr."AlbumId" = al."AlbumId"
WHERE  al."ArtistId" = (
        SELECT ar."ArtistId"
        FROM   "invoice_items" AS ii2
        JOIN   "tracks"        AS tr2 ON ii2."TrackId" = tr2."TrackId"
        JOIN   "albums"        AS al2 ON tr2."AlbumId" = al2."AlbumId"
        JOIN   "artists"       AS ar  ON al2."ArtistId" = ar."ArtistId"
        GROUP  BY ar."ArtistId"
        ORDER  BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC
        LIMIT 1
      )
GROUP  BY cu."CustomerId", cu."FirstName"
ORDER  BY "AmountSpent" DESC
LIMIT 20;
```

```sql
-- 8️⃣ Description: Final answer –
-- return first names of customers who spent < $1 on that best-selling artist,
-- together with the precise amounts they spent.
SELECT cu."FirstName",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "AmountSpent"
FROM   "customers"     AS cu
JOIN   "invoices"      AS inv ON cu."CustomerId" = inv."CustomerId"
JOIN   "invoice_items" AS ii  ON inv."InvoiceId" = ii."InvoiceId"
JOIN   "tracks"        AS tr  ON ii."TrackId" = tr."TrackId"
JOIN   "albums"        AS al  ON tr."AlbumId" = al."AlbumId"
WHERE  al."ArtistId" = (
        SELECT ar."ArtistId"
        FROM   "invoice_items" AS ii2
        JOIN   "tracks"        AS tr2 ON ii2."TrackId" = tr2."TrackId"
        JOIN   "albums"        AS al2 ON tr2."AlbumId" = al2."AlbumId"
        JOIN   "artists"       AS ar  ON al2."ArtistId" = ar."ArtistId"
        GROUP  BY ar."ArtistId"
        ORDER  BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC
        LIMIT 1
      )
GROUP  BY cu."FirstName"
HAVING SUM(ii."UnitPrice" * ii."Quantity") < 1
ORDER  BY "AmountSpent" ASC;
```
