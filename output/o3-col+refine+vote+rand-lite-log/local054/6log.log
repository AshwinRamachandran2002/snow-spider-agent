Query:
--Description: Identify the best-selling artist (highest total revenue)
SELECT a."ArtistId",
       ar."Name" AS "BestSellingArtist",
       SUM(ii."UnitPrice" * ii."Quantity") AS "TotalRevenue"
FROM "invoice_items" AS ii
JOIN "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN "albums"        AS a  ON t."AlbumId"  = a."AlbumId"
JOIN "artists"       AS ar ON a."ArtistId" = ar."ArtistId"
GROUP BY a."ArtistId"
ORDER BY "TotalRevenue" DESC
LIMIT 1;
