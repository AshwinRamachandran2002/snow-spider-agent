Query:
--Description: Display a sample of tracks that belong to the best-selling artist
SELECT DISTINCT t."TrackId", t."Name"
FROM "tracks" AS t
JOIN "albums" AS a ON t."AlbumId" = a."AlbumId"
WHERE a."ArtistId" = (
  SELECT a2."ArtistId"
  FROM "invoice_items" AS ii2
  JOIN "tracks"        AS t2 ON ii2."TrackId" = t2."TrackId"
  JOIN "albums"        AS a2 ON t2."AlbumId" = a2."AlbumId"
  GROUP BY a2."ArtistId"
  ORDER BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC
  LIMIT 1
)
LIMIT 20;
