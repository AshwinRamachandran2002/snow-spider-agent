Query:
--Description: Calculate total revenue generated by every artist
SELECT a."ArtistId",
       ar."Name" AS "ArtistName",
       SUM(ii."UnitPrice" * ii."Quantity") AS "ArtistRevenue"
FROM "invoice_items" AS ii
JOIN "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN "albums"        AS a  ON t."AlbumId"  = a."AlbumId"
JOIN "artists"       AS ar ON a."ArtistId" = ar."ArtistId"
GROUP BY a."ArtistId"
ORDER BY "ArtistRevenue" DESC
LIMIT 20;
