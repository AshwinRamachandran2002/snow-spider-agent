Query:
--Description: Compute what each customer has spent on the best-selling artist
SELECT i."CustomerId",
       SUM(ii."UnitPrice" * ii."Quantity") AS "SpendOnBestArtist"
FROM "invoice_items" AS ii
JOIN "tracks"  AS t ON ii."TrackId" = t."TrackId"
JOIN "albums"  AS a ON t."AlbumId"  = a."AlbumId"
JOIN "invoices" AS i ON ii."InvoiceId" = i."InvoiceId"
WHERE a."ArtistId" = (
  SELECT a2."ArtistId"
  FROM "invoice_items" AS ii2
  JOIN "tracks"        AS t2 ON ii2."TrackId" = t2."TrackId"
  JOIN "albums"        AS a2 ON t2."AlbumId" = a2."AlbumId"
  GROUP BY a2."ArtistId"
  ORDER BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC
  LIMIT 1
)
GROUP BY i."CustomerId"
LIMIT 20;
