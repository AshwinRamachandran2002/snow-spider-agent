```sql
--Description: List a few artists to understand their IDs and names
SELECT DISTINCT "ArtistId", "Name"
FROM "artists"
LIMIT 20;
```

```sql
--Description: View tracks together with their corresponding artist names
SELECT DISTINCT t."TrackId",
       t."Name"              AS "TrackName",
       a."ArtistId",
       ar."Name"             AS "ArtistName"
FROM "tracks"  AS t
JOIN "albums"  AS a  ON t."AlbumId" = a."AlbumId"
JOIN "artists" AS ar ON a."ArtistId" = ar."ArtistId"
LIMIT 20;
```

```sql
--Description: Calculate total revenue generated by every artist
SELECT a."ArtistId",
       ar."Name" AS "ArtistName",
       SUM(ii."UnitPrice" * ii."Quantity") AS "ArtistRevenue"
FROM "invoice_items" AS ii
JOIN "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN "albums"        AS a  ON t."AlbumId"  = a."AlbumId"
JOIN "artists"       AS ar ON a."ArtistId" = ar."ArtistId"
GROUP BY a."ArtistId"
ORDER BY "ArtistRevenue" DESC
LIMIT 20;
```

```sql
--Description: Identify the best-selling artist (highest total revenue)
SELECT a."ArtistId",
       ar."Name" AS "BestSellingArtist",
       SUM(ii."UnitPrice" * ii."Quantity") AS "TotalRevenue"
FROM "invoice_items" AS ii
JOIN "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN "albums"        AS a  ON t."AlbumId"  = a."AlbumId"
JOIN "artists"       AS ar ON a."ArtistId" = ar."ArtistId"
GROUP BY a."ArtistId"
ORDER BY "TotalRevenue" DESC
LIMIT 1;
```

```sql
--Description: Display a sample of tracks that belong to the best-selling artist
SELECT DISTINCT t."TrackId", t."Name"
FROM "tracks" AS t
JOIN "albums" AS a ON t."AlbumId" = a."AlbumId"
WHERE a."ArtistId" = (
  SELECT a2."ArtistId"
  FROM "invoice_items" AS ii2
  JOIN "tracks"        AS t2 ON ii2."TrackId" = t2."TrackId"
  JOIN "albums"        AS a2 ON t2."AlbumId" = a2."AlbumId"
  GROUP BY a2."ArtistId"
  ORDER BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC
  LIMIT 1
)
LIMIT 20;
```

```sql
--Description: Compute what each customer has spent on the best-selling artist
SELECT i."CustomerId",
       SUM(ii."UnitPrice" * ii."Quantity") AS "SpendOnBestArtist"
FROM "invoice_items" AS ii
JOIN "tracks"  AS t ON ii."TrackId" = t."TrackId"
JOIN "albums"  AS a ON t."AlbumId"  = a."AlbumId"
JOIN "invoices" AS i ON ii."InvoiceId" = i."InvoiceId"
WHERE a."ArtistId" = (
  SELECT a2."ArtistId"
  FROM "invoice_items" AS ii2
  JOIN "tracks"        AS t2 ON ii2."TrackId" = t2."TrackId"
  JOIN "albums"        AS a2 ON t2."AlbumId" = a2."AlbumId"
  GROUP BY a2."ArtistId"
  ORDER BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC
  LIMIT 1
)
GROUP BY i."CustomerId"
LIMIT 20;
```

```sql
--Description: List customers who spent less than $1 on the best-selling artist
SELECT c."CustomerId",
       c."FirstName",
       s."SpendOnBestArtist"
FROM (
  SELECT i."CustomerId",
         SUM(ii."UnitPrice" * ii."Quantity") AS "SpendOnBestArtist"
  FROM "invoice_items" AS ii
  JOIN "tracks"  AS t ON ii."TrackId" = t."TrackId"
  JOIN "albums"  AS a ON t."AlbumId"  = a."AlbumId"
  JOIN "invoices" AS i ON ii."InvoiceId" = i."InvoiceId"
  WHERE a."ArtistId" = (
    SELECT a2."ArtistId"
    FROM "invoice_items" AS ii2
    JOIN "tracks"        AS t2 ON ii2."TrackId" = t2."TrackId"
    JOIN "albums"        AS a2 ON t2."AlbumId" = a2."AlbumId"
    GROUP BY a2."ArtistId"
    ORDER BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC
    LIMIT 1
  )
  GROUP BY i."CustomerId"
) AS s
JOIN "customers" AS c ON s."CustomerId" = c."CustomerId"
WHERE s."SpendOnBestArtist" < 1
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – first names of customers who spent < $1 on the best-selling artist, plus the amounts
SELECT DISTINCT c."FirstName",
       ROUND(s."SpendOnBestArtist", 2) AS "AmountSpent"
FROM (
  SELECT i."CustomerId",
         SUM(ii."UnitPrice" * ii."Quantity") AS "SpendOnBestArtist"
  FROM "invoice_items" AS ii
  JOIN "tracks"  AS t ON ii."TrackId" = t."TrackId"
  JOIN "albums"  AS a ON t."AlbumId"  = a."AlbumId"
  JOIN "invoices" AS i ON ii."InvoiceId" = i."InvoiceId"
  WHERE a."ArtistId" = (
    SELECT a2."ArtistId"
    FROM "invoice_items" AS ii2
    JOIN "tracks"        AS t2 ON ii2."TrackId" = t2."TrackId"
    JOIN "albums"        AS a2 ON t2."AlbumId" = a2."AlbumId"
    GROUP BY a2."ArtistId"
    ORDER BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC
    LIMIT 1
  )
  GROUP BY i."CustomerId"
) AS s
JOIN "customers" AS c ON s."CustomerId" = c."CustomerId"
WHERE s."SpendOnBestArtist" < 1
LIMIT 20;
```
