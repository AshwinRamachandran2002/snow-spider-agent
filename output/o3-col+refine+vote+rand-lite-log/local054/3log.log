```

```sql
-- Description: Preview albums together with their artist names.
SELECT DISTINCT al."AlbumId",
       al."Title",
       ar."Name" AS "ArtistName"
FROM   "albums"      AS al
JOIN   "artists"     AS ar ON al."ArtistId" = ar."ArtistId"
LIMIT 20;
```

```sql
-- Description: Preview tracks and the artists who recorded them.
SELECT DISTINCT t."TrackId",
       t."Name"       AS "TrackName",
       ar."Name"      AS "ArtistName"
FROM   "tracks"       AS t
JOIN   "albums"       AS al ON t."AlbumId" = al."AlbumId"
JOIN   "artists"      AS ar ON al."ArtistId" = ar."ArtistId"
LIMIT 20;
```

```sql
-- Description: Inspect some invoice-item rows (each line on a bill).
SELECT DISTINCT "InvoiceLineId",
       "InvoiceId",
       "TrackId",
       "UnitPrice",
       "Quantity"
FROM   "invoice_items"
LIMIT 20;
```

```sql
-- Description: Total sales by artist (highest-grossing artists at the top).
SELECT ar."ArtistId",
       ar."Name"                                           AS "ArtistName",
       SUM(ii."UnitPrice" * ii."Quantity")                 AS "TotalSales"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS al ON t."AlbumId" = al."AlbumId"
JOIN   "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "TotalSales" DESC
LIMIT 20;
```

```sql
-- Description: Identify the single best-selling artist (highest overall revenue).
SELECT ar."ArtistId",
       ar."Name"                                           AS "BestSellingArtist",
       SUM(ii."UnitPrice" * ii."Quantity")                 AS "TotalSales"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS al ON t."AlbumId" = al."AlbumId"
JOIN   "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "TotalSales" DESC
LIMIT 1;
```

```sql
-- Description: First names of customers who spent < $1 on the best-selling artist,
--              together with what they actually spent.
SELECT c."FirstName",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "SpentOnBestArtist"
FROM   "customers"     AS c
JOIN   "invoices"      AS i  ON c."CustomerId" = i."CustomerId"
JOIN   "invoice_items" AS ii ON i."InvoiceId"   = ii."InvoiceId"
JOIN   "tracks"        AS t  ON ii."TrackId"    = t."TrackId"
JOIN   "albums"        AS al ON t."AlbumId"     = al."AlbumId"
WHERE  al."ArtistId" = (
         -- sub-query returns the ArtistId of the best-selling artist
         SELECT  ar2."ArtistId"
         FROM    "invoice_items" AS ii2
         JOIN    "tracks"        AS t2  ON ii2."TrackId" = t2."TrackId"
         JOIN    "albums"        AS al2 ON t2."AlbumId"  = al2."AlbumId"
         JOIN    "artists"       AS ar2 ON al2."ArtistId"= ar2."ArtistId"
         GROUP   BY ar2."ArtistId"
         ORDER   BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC
         LIMIT   1
       )
GROUP BY c."FirstName"
HAVING SUM(ii."UnitPrice" * ii."Quantity") < 1
LIMIT 20;
```
