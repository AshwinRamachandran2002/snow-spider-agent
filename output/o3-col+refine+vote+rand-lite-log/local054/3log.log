Query:
-- Description: Identify the single best-selling artist (highest overall revenue).
SELECT ar."ArtistId",
       ar."Name"                                           AS "BestSellingArtist",
       SUM(ii."UnitPrice" * ii."Quantity")                 AS "TotalSales"
FROM   "invoice_items" AS ii
JOIN   "tracks"        AS t  ON ii."TrackId" = t."TrackId"
JOIN   "albums"        AS al ON t."AlbumId" = al."AlbumId"
JOIN   "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "TotalSales" DESC
LIMIT 1;
