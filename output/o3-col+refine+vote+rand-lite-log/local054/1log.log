```sql
-- 1. Peek at all artists that have any albums in the store
SELECT DISTINCT "ArtistId", "Name"
FROM "artists"
LIMIT 20;
```

```sql
-- 2. Look at a few albums together with their artist so the relation is clear
SELECT DISTINCT al."AlbumId", al."Title", ar."Name" AS "Artist"
FROM "albums" AS al
JOIN "artists" AS ar ON ar."ArtistId" = al."ArtistId"
LIMIT 20;
```

```sql
-- 3. Inspect how much revenue each individual track generated
SELECT DISTINCT t."TrackId",
       t."Name",
       (ii."UnitPrice" * ii."Quantity") AS "Track_Revenue"
FROM "tracks"  AS t
JOIN "invoice_items" AS ii ON ii."TrackId" = t."TrackId"
LIMIT 20;
```

```sql
-- 4. Aggregate track revenue up to the album level
SELECT DISTINCT al."AlbumId",
       al."Title",
       SUM(ii."UnitPrice" * ii."Quantity") AS "Album_Revenue"
FROM "albums"  AS al
JOIN "tracks"  AS t  ON t."AlbumId"  = al."AlbumId"
JOIN "invoice_items" AS ii ON ii."TrackId" = t."TrackId"
GROUP BY al."AlbumId"
ORDER BY "Album_Revenue" DESC
LIMIT 20;
```

```sql
-- 5. Aggregate album revenue up to the artist level – this shows the best-selling artist on top
SELECT DISTINCT ar."ArtistId",
       ar."Name"                    AS "Artist",
       SUM(ii."UnitPrice" * ii."Quantity") AS "Artist_Revenue"
FROM "artists" AS ar
JOIN "albums"  AS al ON al."ArtistId" = ar."ArtistId"
JOIN "tracks"  AS t  ON t."AlbumId"   = al."AlbumId"
JOIN "invoice_items" AS ii ON ii."TrackId" = t."TrackId"
GROUP BY ar."ArtistId"
ORDER BY "Artist_Revenue" DESC
LIMIT 20;
```

```sql
-- 6. How much money has every customer spent on tracks from THAT top artist?
--    (The sub-query in WHERE finds the single best-selling ArtistId.)
SELECT DISTINCT cu."CustomerId",
       cu."FirstName",
       SUM(ii."UnitPrice" * ii."Quantity") AS "AmountSpentOnTopArtist"
FROM "customers" AS cu
JOIN "invoices"  AS inv ON inv."CustomerId" = cu."CustomerId"
JOIN "invoice_items" AS ii  ON ii."InvoiceId" = inv."InvoiceId"
JOIN "tracks"  AS t   ON t."TrackId"  = ii."TrackId"
JOIN "albums"  AS al  ON al."AlbumId" = t."AlbumId"
WHERE al."ArtistId" = (
        SELECT ar2."ArtistId"
        FROM "artists" AS ar2
        JOIN "albums"  AS al2 ON al2."ArtistId" = ar2."ArtistId"
        JOIN "tracks"  AS t2  ON t2."AlbumId"   = al2."AlbumId"
        JOIN "invoice_items" AS ii2 ON ii2."TrackId" = t2."TrackId"
        GROUP BY ar2."ArtistId"
        ORDER BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC
        LIMIT 1
)
GROUP BY cu."CustomerId"
ORDER BY "AmountSpentOnTopArtist"
LIMIT 20;
```

```sql
-- 7. FINAL ANSWER – first names of customers who spent < $1 on that best-selling artist,
--    together with the exact amount they spent
SELECT DISTINCT cu."FirstName",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "Amount_Spent"
FROM "customers" AS cu
JOIN "invoices"  AS inv ON inv."CustomerId" = cu."CustomerId"
JOIN "invoice_items" AS ii  ON ii."InvoiceId" = inv."InvoiceId"
JOIN "tracks"  AS t   ON t."TrackId"  = ii."TrackId"
JOIN "albums"  AS al  ON al."AlbumId" = t."AlbumId"
WHERE al."ArtistId" = (
        SELECT ar2."ArtistId"
        FROM "artists" AS ar2
        JOIN "albums"  AS al2 ON al2."ArtistId" = ar2."ArtistId"
        JOIN "tracks"  AS t2  ON t2."AlbumId"   = al2."AlbumId"
        JOIN "invoice_items" AS ii2 ON ii2."TrackId" = t2."TrackId"
        GROUP BY ar2."ArtistId"
        ORDER BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC
        LIMIT 1
)
GROUP BY cu."CustomerId"
HAVING SUM(ii."UnitPrice" * ii."Quantity") < 1
ORDER BY "Amount_Spent"
LIMIT 20;
```
