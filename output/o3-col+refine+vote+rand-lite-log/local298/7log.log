       SUM("adjusted_balance") AS "total_balance"
FROM  (SELECT "customer_id",
              "month_start",
              CASE WHEN "balance_as_of_start" < 0
                   THEN 0 
                   ELSE "balance_as_of_start" END AS "adjusted_balance"
       FROM  (SELECT "customer_id",
                     "month_start",
                     SUM("net_monthly") OVER (PARTITION BY "customer_id"
                                              ORDER BY "month_start") AS "balance_as_of_start"
