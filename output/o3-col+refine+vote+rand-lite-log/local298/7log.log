              LAG("total_balance") OVER (ORDER BY "month_start") AS "previous_total_balance"
       FROM  (SELECT "month_start",
                     SUM("adjusted_balance") AS "total_balance"
              FROM  (SELECT "customer_id",
                            "month_start",
                            CASE WHEN "balance_as_of_start" < 0
                                 THEN 0 
