Query:
--Description: Turn monthly nets into a running balance per customer, measured on the 1st of each month.  
SELECT "customer_id",
       "month_start",
       SUM("net_monthly") OVER (PARTITION BY "customer_id"
                                ORDER BY "month_start") AS "balance_as_of_start"
FROM  (SELECT "customer_id",
              substr("txn_date",1,7) || '-01' AS "month_start",
              SUM(CASE WHEN "txn_type"='deposit'
                       THEN  "txn_amount"
                       ELSE -1*"txn_amount" END) AS "net_monthly"
       FROM   "customer_transactions"
       GROUP  BY "customer_id", "month_start")
LIMIT 20;
