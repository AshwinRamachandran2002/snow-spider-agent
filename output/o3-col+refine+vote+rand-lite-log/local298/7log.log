```sql
--Description: Inspect the different transaction types that exist in our ledger.  
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
--Description: Quickly view the overall date boundaries present in the customer ledger.  
SELECT DISTINCT 
       MIN("txn_date") OVER () AS "min_date",
       MAX("txn_date") OVER () AS "max_date"
FROM   "customer_transactions"
LIMIT 20;
```

```sql
--Description: List every calendar month that has at least one transaction, expressed as the 1st-of-month snapshot date.  
SELECT DISTINCT substr("txn_date",1,7) || '-01' AS "month_start"
FROM   "customer_transactions"
ORDER BY "month_start"
LIMIT 20;
```

```sql
--Description: Derive each customer’s net movement (deposit – withdrawal) within every month.  
SELECT "customer_id",
       substr("txn_date",1,7) || '-01' AS "month_start",
       SUM(CASE WHEN "txn_type"='deposit' 
                THEN  "txn_amount"
                ELSE -1*"txn_amount" END) AS "net_monthly"
FROM   "customer_transactions"
GROUP  BY "customer_id", "month_start"
LIMIT 20;
```

```sql
--Description: Turn monthly nets into a running balance per customer, measured on the 1st of each month.  
SELECT "customer_id",
       "month_start",
       SUM("net_monthly") OVER (PARTITION BY "customer_id"
                                ORDER BY "month_start") AS "balance_as_of_start"
FROM  (SELECT "customer_id",
              substr("txn_date",1,7) || '-01' AS "month_start",
              SUM(CASE WHEN "txn_type"='deposit'
                       THEN  "txn_amount"
                       ELSE -1*"txn_amount" END) AS "net_monthly"
       FROM   "customer_transactions"
       GROUP  BY "customer_id", "month_start")
LIMIT 20;
```

```sql
--Description: Replace any negative running balances with zero (no overdrafts counted).  
SELECT "customer_id",
       "month_start",
       CASE WHEN "balance_as_of_start" < 0 
            THEN 0 
            ELSE "balance_as_of_start" END AS "adjusted_balance"
FROM  (SELECT "customer_id",
              "month_start",
              SUM("net_monthly") OVER (PARTITION BY "customer_id"
                                       ORDER BY "month_start") AS "balance_as_of_start"
       FROM  (SELECT "customer_id",
                     substr("txn_date",1,7) || '-01' AS "month_start",
                     SUM(CASE WHEN "txn_type"='deposit'
                              THEN  "txn_amount"
                              ELSE -1*"txn_amount" END) AS "net_monthly"
              FROM   "customer_transactions"
              GROUP  BY "customer_id", "month_start"))
LIMIT 20;
```

```sql
--Description: Aggregate the adjusted balances across the whole customer base for every month.  
SELECT "month_start",
       SUM("adjusted_balance") AS "total_balance"
FROM  (SELECT "customer_id",
              "month_start",
              CASE WHEN "balance_as_of_start" < 0
                   THEN 0 
                   ELSE "balance_as_of_start" END AS "adjusted_balance"
       FROM  (SELECT "customer_id",
                     "month_start",
                     SUM("net_monthly") OVER (PARTITION BY "customer_id"
                                              ORDER BY "month_start") AS "balance_as_of_start"
              FROM  (SELECT "customer_id",
                            substr("txn_date",1,7) || '-01' AS "month_start",
                            SUM(CASE WHEN "txn_type"='deposit'
                                     THEN  "txn_amount"
                                     ELSE -1*"txn_amount" END) AS "net_monthly"
                     FROM   "customer_transactions"
                     GROUP  BY "customer_id", "month_start")))
GROUP BY "month_start"
ORDER BY "month_start"
LIMIT 20;
```

```sql
--Description: Use a window LAG to pull the prior month’s total balance so we can observe month-to-month movement.  
SELECT "month_start",
       LAG("total_balance") OVER (ORDER BY "month_start") AS "previous_total_balance"
FROM  (SELECT "month_start",
              SUM("adjusted_balance") AS "total_balance"
       FROM  (SELECT "customer_id",
                     "month_start",
                     CASE WHEN "balance_as_of_start" < 0
                          THEN 0 
                          ELSE "balance_as_of_start" END AS "adjusted_balance"
              FROM  (SELECT "customer_id",
                            "month_start",
                            SUM("net_monthly") OVER (PARTITION BY "customer_id"
                                                     ORDER BY "month_start") AS "balance_as_of_start"
                     FROM  (SELECT "customer_id",
                                   substr("txn_date",1,7) || '-01' AS "month_start",
                                   SUM(CASE WHEN "txn_type"='deposit'
                                            THEN  "txn_amount"
                                            ELSE -1*"txn_amount" END) AS "net_monthly"
                            FROM   "customer_transactions"
                            GROUP  BY "customer_id", "month_start")))
       GROUP BY "month_start")
ORDER BY "month_start"
LIMIT 20;
```

```sql
--Description: Exclude the first calendar month (which lacks a prior comparison) and present the required report.  
SELECT "month_start"       AS "reporting_month",
       "previous_total_balance" AS "total_balance_previous_month"
FROM  (SELECT "month_start",
              LAG("total_balance") OVER (ORDER BY "month_start") AS "previous_total_balance"
       FROM  (SELECT "month_start",
                     SUM("adjusted_balance") AS "total_balance"
              FROM  (SELECT "customer_id",
                            "month_start",
                            CASE WHEN "balance_as_of_start" < 0
                                 THEN 0 
                                 ELSE "balance_as_of_start" END AS "adjusted_balance"
                     FROM  (SELECT "customer_id",
                                   "month_start",
                                   SUM("net_monthly") OVER (PARTITION BY "customer_id"
                                                            ORDER BY "month_start") AS "balance_as_of_start"
                            FROM  (SELECT "customer_id",
                                          substr("txn_date",1,7) || '-01' AS "month_start",
                                          SUM(CASE WHEN "txn_type"='deposit'
                                                   THEN  "txn_amount"
                                                   ELSE -1*"txn_amount" END) AS "net_monthly"
                                   FROM   "customer_transactions"
                                   GROUP  BY "customer_id", "month_start")))
              GROUP BY "month_start"))
WHERE "previous_total_balance" IS NOT NULL
ORDER BY "reporting_month"
LIMIT 20;
```

```sql
--Description: (Optional sanity check) View the first few rows of our final answer sorted chronologically.  
SELECT * 
FROM  (SELECT "month_start"       AS "reporting_month",
              "previous_total_balance" AS "total_balance_previous_month"
       FROM  (SELECT "month_start",
                     LAG("total_balance") OVER (ORDER BY "month_start") AS "previous_total_balance"
              FROM  (SELECT "month_start",
                            SUM("adjusted_balance") AS "total_balance"
                     FROM  (SELECT "customer_id",
                                   "month_start",
                                   CASE WHEN "balance_as_of_start" < 0
                                        THEN 0 
                                        ELSE "balance_as_of_start" END AS "adjusted_balance"
                            FROM  (SELECT "customer_id",
                                          "month_start",
                                          SUM("net_monthly") OVER (PARTITION BY "customer_id"
                                                                   ORDER BY "month_start") AS "balance_as_of_start"
                                   FROM  (SELECT "customer_id",
                                                 substr("txn_date",1,7) || '-01' AS "month_start",
                                                 SUM(CASE WHEN "txn_type"='deposit'
                                                          THEN  "txn_amount"
                                                          ELSE -1*"txn_amount" END) AS "net_monthly"
                                          FROM   "customer_transactions"
                                          GROUP  BY "customer_id", "month_start")))
                     GROUP BY "month_start"))
       WHERE "previous_total_balance" IS NOT NULL
       ORDER BY "reporting_month")
LIMIT 20;
```
