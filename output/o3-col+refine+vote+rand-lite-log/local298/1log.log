Query:
-- 9. For every month *except* the first one in the data set, calculate
--    the total (all-user) adjusted balance carried forward from the
--    previous month’s close.  Negative balances are floored to zero.
SELECT   cm."current_month",
         (
             SELECT SUM(
                        CASE
                            WHEN bal."balance" < 0 THEN 0
                            ELSE bal."balance"
                        END
                      )
             FROM (
                    SELECT "customer_id",
                           SUM("txn_amount") AS "balance"
                    FROM   "customer_transactions"
                    WHERE  "txn_date" < cm."current_month" || '-01'
                    GROUP  BY "customer_id"
                  ) AS bal
         ) AS "total_prev_balance"
FROM   (
         SELECT DISTINCT SUBSTR("txn_date", 1, 7) AS "current_month"
         FROM   "customer_transactions"
       ) AS cm
WHERE  cm."current_month" >
       (SELECT MIN(SUBSTR("txn_date", 1, 7)) FROM "customer_transactions")   -- drop first month
ORDER  BY cm."current_month"
LIMIT 20;
Answer:
current_month,total_prev_balance
