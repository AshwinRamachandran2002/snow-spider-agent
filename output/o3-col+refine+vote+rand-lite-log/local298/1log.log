```sql
-- 1. Inspect a few distinct transaction dates to confirm their format (YYYY-MM-DD).
SELECT DISTINCT "txn_date"
FROM "customer_transactions"
ORDER BY "txn_date"
LIMIT 20;
```

```sql
-- 2. List the distinct year-month combinations that exist in the data set.
SELECT DISTINCT SUBSTR("txn_date", 1, 7) AS "month"
FROM "customer_transactions"
ORDER BY "month"
LIMIT 20;
```

```sql
-- 3. Check which transaction types are present (e.g., deposit, withdrawal).
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 4. View a sample of raw transactions (customer, date, type, amount).
SELECT "customer_id",
       "txn_date",
       "txn_type",
       "txn_amount"
FROM   "customer_transactions"
ORDER  BY "txn_date"
LIMIT 20;
```

```sql
-- 5. Compute each customer’s net amount for every month (deposit – withdrawal).
SELECT "customer_id",
       SUBSTR("txn_date", 1, 7)              AS "month",
       SUM("txn_amount")                     AS "monthly_net"
FROM   "customer_transactions"
GROUP  BY "customer_id", "month"
ORDER  BY "customer_id", "month"
LIMIT 20;
```

```sql
-- 6. Derive the previous-month string for every observed month.
SELECT DISTINCT
       SUBSTR("txn_date", 1, 7)                             AS "month",
       CASE
         WHEN SUBSTR("txn_date", 6, 2) = '01'
              THEN CAST(CAST(SUBSTR("txn_date", 1, 4) AS INTEGER) - 1 AS TEXT) || '-12'
         ELSE SUBSTR("txn_date", 1, 4) || '-' ||
              printf('%02d', CAST(SUBSTR("txn_date", 6, 2) AS INTEGER) - 1)
       END                                                  AS "prev_month"
FROM   "customer_transactions"
ORDER  BY "month"
LIMIT 20;
```

```sql
-- 7. For one example month (‘2020-03’ here), show every customer’s balance
--    as of the 1st of that month (i.e., all transactions before 2020-03-01).
SELECT  "customer_id",
        SUM("txn_amount") AS "balance_to_2020-03-01"
FROM    "customer_transactions"
WHERE   "txn_date" < '2020-03-01'
GROUP   BY "customer_id"
LIMIT 20;
```

```sql
-- 8. Turn any negative customer balances into zero for that same example cut-off.
SELECT  "customer_id",
        CASE
            WHEN SUM("txn_amount") < 0 THEN 0
            ELSE SUM("txn_amount")
        END AS "adj_balance_to_2020-03-01"
FROM    "customer_transactions"
WHERE   "txn_date" < '2020-03-01'
GROUP   BY "customer_id"
LIMIT 20;
```

```sql
-- 9. For every month *except* the first one in the data set, calculate
--    the total (all-user) adjusted balance carried forward from the
--    previous month’s close.  Negative balances are floored to zero.
SELECT   cm."current_month",
         (
             SELECT SUM(
                        CASE
                            WHEN bal."balance" < 0 THEN 0
                            ELSE bal."balance"
                        END
                      )
             FROM (
                    SELECT "customer_id",
                           SUM("txn_amount") AS "balance"
                    FROM   "customer_transactions"
                    WHERE  "txn_date" < cm."current_month" || '-01'
                    GROUP  BY "customer_id"
                  ) AS bal
         ) AS "total_prev_balance"
FROM   (
         SELECT DISTINCT SUBSTR("txn_date", 1, 7) AS "current_month"
         FROM   "customer_transactions"
       ) AS cm
WHERE  cm."current_month" >
       (SELECT MIN(SUBSTR("txn_date", 1, 7)) FROM "customer_transactions")   -- drop first month
ORDER  BY cm."current_month"
LIMIT 20;
```

```sql
-- 10. Same logic as #9 but without the LIMIT so it returns the full, ordered answer.
SELECT   cm."current_month",
         (
             SELECT SUM(
                        CASE
                            WHEN bal."balance" < 0 THEN 0
                            ELSE bal."balance"
                        END
                      )
             FROM (
                    SELECT "customer_id",
                           SUM("txn_amount") AS "balance"
                    FROM   "customer_transactions"
                    WHERE  "txn_date" < cm."current_month" || '-01'
                    GROUP  BY "customer_id"
                  ) AS bal
         ) AS "total_prev_balance"
FROM   (
         SELECT DISTINCT SUBSTR("txn_date", 1, 7) AS "current_month"
         FROM   "customer_transactions"
       ) AS cm
WHERE  cm."current_month" >
       (SELECT MIN(SUBSTR("txn_date", 1, 7)) FROM "customer_transactions")
ORDER  BY cm."current_month";
```
