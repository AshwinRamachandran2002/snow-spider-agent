--Description: 8) Previous-month balance with negatives floored to zero; 
--              the first month is dropped (serves only as baseline)
SELECT
    month,
    CASE 
        WHEN prev_balance < 0 THEN 0 
        ELSE prev_balance 
    END AS previous_month_total_balance
FROM (
    SELECT
        month,
        LAG(cumulative_balance) OVER (ORDER BY month) AS prev_balance
    FROM (
        SELECT 
            month,
            SUM(net_total) OVER (ORDER BY month) AS cumulative_balance
        FROM (
            SELECT 
                strftime('%Y-%m', "txn_date") AS month,
                SUM(
                    CASE WHEN "txn_type" = 'deposit'  THEN  "txn_amount"
                         WHEN "txn_type" = 'withdraw' THEN - "txn_amount"
                         ELSE 0 END
                ) AS net_total
            FROM "customer_transactions"
            GROUP BY month
        )
    )
)
WHERE prev_balance IS NOT NULL          -- exclude the first month
ORDER BY month;
