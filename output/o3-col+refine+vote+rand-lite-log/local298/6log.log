```sql
--Description: 1) Inspect all available transaction types in the customer ledger
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
--Description: 2) Check the overall date span of the customer transaction data
SELECT 
    MIN("txn_date") AS min_date,
    MAX("txn_date") AS max_date
FROM "customer_transactions";
```

```sql
--Description: 3) Look at the first 20 rows of the raw customer transaction table
SELECT *
FROM "customer_transactions"
ORDER BY "txn_date"
LIMIT 20;
```

```sql
--Description: 4) Net monthly movement (deposit-withdrawal) for every customer
SELECT 
    "customer_id",
    strftime('%Y-%m', "txn_date") AS month,
    SUM(
        CASE WHEN "txn_type" = 'deposit'  THEN  "txn_amount"
             WHEN "txn_type" = 'withdraw' THEN - "txn_amount"
             ELSE 0 END
    ) AS net_movement
FROM "customer_transactions"
GROUP BY "customer_id", month
ORDER BY month, "customer_id"
LIMIT 20;
```

```sql
--Description: 5) Consolidated net movement for the whole customer base by month
SELECT 
    strftime('%Y-%m', "txn_date") AS month,
    SUM(
        CASE WHEN "txn_type" = 'deposit'  THEN  "txn_amount"
             WHEN "txn_type" = 'withdraw' THEN - "txn_amount"
             ELSE 0 END
    ) AS net_total
FROM "customer_transactions"
GROUP BY month
ORDER BY month
LIMIT 20;
```

```sql
--Description: 6) Running (cumulative) balance at the end of every month
SELECT 
    month,
    SUM(net_total) OVER (
        ORDER BY month
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS cumulative_balance
FROM (
    SELECT 
        strftime('%Y-%m', "txn_date") AS month,
        SUM(
            CASE WHEN "txn_type" = 'deposit'  THEN  "txn_amount"
                 WHEN "txn_type" = 'withdraw' THEN - "txn_amount"
                 ELSE 0 END
        ) AS net_total
    FROM "customer_transactions"
    GROUP BY month
)
ORDER BY month
LIMIT 20;
```

```sql
--Description: 7) Previous-month closing balance for every month
SELECT
    month,
    LAG(cumulative_balance) OVER (ORDER BY month) AS prev_balance
FROM (
    SELECT 
        month,
        SUM(net_total) OVER (ORDER BY month) AS cumulative_balance
    FROM (
        SELECT 
            strftime('%Y-%m', "txn_date") AS month,
            SUM(
                CASE WHEN "txn_type" = 'deposit'  THEN  "txn_amount"
                     WHEN "txn_type" = 'withdraw' THEN - "txn_amount"
                     ELSE 0 END
            ) AS net_total
        FROM "customer_transactions"
        GROUP BY month
    )
)
ORDER BY month
LIMIT 20;
```

```sql
--Description: 8) Previous-month balance with negatives floored to zero; 
--              the first month is dropped (serves only as baseline)
SELECT
    month,
    CASE 
        WHEN prev_balance < 0 THEN 0 
        ELSE prev_balance 
    END AS previous_month_total_balance
FROM (
    SELECT
        month,
        LAG(cumulative_balance) OVER (ORDER BY month) AS prev_balance
    FROM (
        SELECT 
            month,
            SUM(net_total) OVER (ORDER BY month) AS cumulative_balance
        FROM (
            SELECT 
                strftime('%Y-%m', "txn_date") AS month,
                SUM(
                    CASE WHEN "txn_type" = 'deposit'  THEN  "txn_amount"
                         WHEN "txn_type" = 'withdraw' THEN - "txn_amount"
                         ELSE 0 END
                ) AS net_total
            FROM "customer_transactions"
            GROUP BY month
        )
    )
)
WHERE prev_balance IS NOT NULL          -- exclude the first month
ORDER BY month;
```

These eight queries progress from simple inspection to the final requirement:  
a month-by-month list of total balances from the previous month (with negatives replaced by zero), sorted in ascending order and excluding the first baseline month.
