Query:
--Description: 6) Running (cumulative) balance at the end of every month
SELECT 
    month,
    SUM(net_total) OVER (
        ORDER BY month
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS cumulative_balance
FROM (
    SELECT 
        strftime('%Y-%m', "txn_date") AS month,
        SUM(
            CASE WHEN "txn_type" = 'deposit'  THEN  "txn_amount"
                 WHEN "txn_type" = 'withdraw' THEN - "txn_amount"
                 ELSE 0 END
        ) AS net_total
    FROM "customer_transactions"
    GROUP BY month
)
ORDER BY month
LIMIT 20;
