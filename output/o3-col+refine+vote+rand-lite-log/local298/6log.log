Query:
--Description: 4) Net monthly movement (deposit-withdrawal) for every customer
SELECT 
    "customer_id",
    strftime('%Y-%m', "txn_date") AS month,
    SUM(
        CASE WHEN "txn_type" = 'deposit'  THEN  "txn_amount"
             WHEN "txn_type" = 'withdraw' THEN - "txn_amount"
             ELSE 0 END
    ) AS net_movement
FROM "customer_transactions"
GROUP BY "customer_id", month
ORDER BY month, "customer_id"
LIMIT 20;
