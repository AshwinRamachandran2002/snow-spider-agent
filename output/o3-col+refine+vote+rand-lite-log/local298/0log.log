```sql
--Description: Calculate net movement (deposit – withdrawal) per customer per month.
SELECT substr("txn_date",1,7)            AS "month",
       "customer_id",
       SUM(CASE
              WHEN "txn_type"='deposit'   THEN  "txn_amount"
              ELSE                              -1*"txn_amount"
           END)                          AS "net_amount"
FROM   "customer_transactions"
GROUP  BY "customer_id",
          substr("txn_date",1,7)
ORDER  BY "month","customer_id"
LIMIT 20;
```

```sql
--Description: Aggregate to get total month-end balance across ALL users (as of last day of that month).
WITH cte AS (
      SELECT substr("txn_date",1,7)      AS "month",
             "customer_id",
             SUM(CASE
                    WHEN "txn_type"='deposit' THEN  "txn_amount"
                    ELSE                            -1*"txn_amount"
                 END) AS "net_amount"
      FROM   "customer_transactions"
      GROUP  BY "customer_id",
                substr("txn_date",1,7")
)
SELECT "month",
       SUM("net_amount") AS "total_balance"
FROM   cte
GROUP  BY "month"
ORDER  BY "month"
LIMIT 20;
```

```sql
--Description: Show running cumulative balance per customer up to (and including) the last day of each month.
WITH txns AS (
      SELECT "customer_id",
             date("txn_date")                     AS "txn_dt",
             "txn_amount" * CASE WHEN "txn_type"='deposit' THEN 1 ELSE -1 END AS "signed_amt"
      FROM   "customer_transactions"
), months AS (
      SELECT DISTINCT date(substr("txn_date",1,7)||'-01') AS "month_start"
      FROM   "customer_transactions"
)
SELECT m."month_start",
       t."customer_id",
       (SELECT SUM("signed_amt")
        FROM   txns x
        WHERE  x."customer_id" = t."customer_id"
        AND    x."txn_dt" < date(m."month_start",'start of month','+1 month')) AS "balance_to_date"
FROM   months m
CROSS  JOIN (SELECT DISTINCT "customer_id" FROM "customer_transactions") t
ORDER  BY m."month_start", t."customer_id"
LIMIT 20;
```

```sql
--Description: Compute total balance across ALL users as at the FIRST of each month (i.e., closing balance of the previous month).
WITH balances AS (
      SELECT date(substr("txn_date",1,7)||'-01') AS "month_start",
             SUM(CASE WHEN "txn_type"='deposit' THEN "txn_amount"
                      ELSE -1*"txn_amount" END)  AS "net_movement"
      FROM   "customer_transactions"
      GROUP  BY "month_start"
), running AS (
      SELECT b1."month_start",
             (SELECT SUM(b2."net_movement")
              FROM   balances b2
              WHERE  b2."month_start" <= b1."month_start") AS "cumulative_balance"
      FROM   balances b1
)
SELECT "month_start"                               AS "as_of_first",
       "cumulative_balance"                        AS "prev_month_total"
FROM   running
ORDER  BY "month_start"
LIMIT 20;
```

```sql
--Description: Replace any negative balances with zero.
WITH balances AS (
      SELECT date(substr("txn_date",1,7)||'-01') AS "month_start",
             SUM(CASE WHEN "txn_type"='deposit' THEN "txn_amount"
                      ELSE -1*"txn_amount" END)  AS "net_movement"
      FROM   "customer_transactions"
      GROUP  BY "month_start"
), running AS (
      SELECT b1."month_start",
             (SELECT SUM(b2."net_movement")
              FROM   balances b2
              WHERE  b2."month_start" <= b1."month_start") AS "cumulative_balance"
      FROM   balances b1
), cleaned AS (
      SELECT "month_start",
             CASE WHEN "cumulative_balance" < 0 THEN 0 ELSE "cumulative_balance" END AS "prev_month_total"
      FROM   running
)
SELECT *
FROM   cleaned
ORDER  BY "month_start"
LIMIT 20;
```

```sql
--Description: Exclude the very first month (used only as baseline) and present the final answer, sorted ascending.
WITH balances AS (
      SELECT date(substr("txn_date",1,7)||'-01') AS "month_start",
             SUM(CASE WHEN "txn_type"='deposit' THEN "txn_amount"
                      ELSE -1*"txn_amount" END)  AS "net_movement"
      FROM   "customer_transactions"
      GROUP  BY "month_start"
), running AS (
      SELECT b1."month_start",
             (SELECT SUM(b2."net_movement")
              FROM   balances b2
              WHERE  b2."month_start" < b1."month_start") AS "prev_total"      -- strictly previous month
      FROM   balances b1
), cleaned AS (
      SELECT "month_start",
             CASE WHEN "prev_total" < 0 THEN 0 ELSE "prev_total" END AS "prev_month_total"
      FROM   running
)
SELECT *
FROM   cleaned
WHERE  "prev_month_total" IS NOT NULL          -- drops the very first month
ORDER  BY "month_start"
LIMIT 20;
