Query:
--Description: Calculate net movement (deposit – withdrawal) per customer per month.
SELECT substr("txn_date",1,7)            AS "month",
       "customer_id",
       SUM(CASE
              WHEN "txn_type"='deposit'   THEN  "txn_amount"
              ELSE                              -1*"txn_amount"
           END)                          AS "net_amount"
FROM   "customer_transactions"
GROUP  BY "customer_id",
          substr("txn_date",1,7)
ORDER  BY "month","customer_id"
LIMIT 20;
