Query:
--Description: Show running cumulative balance per customer up to (and including) the last day of each month.
WITH txns AS (
    SELECT 
        "customer_id",
        DATE("txn_date")                                                AS txn_dt,
        CASE 
            WHEN "txn_type" = 'deposit' THEN  1 * "txn_amount"
            ELSE                           -1 * "txn_amount"
        END                                                             AS signed_amt
    FROM "customer_transactions"
), months AS (
    SELECT DISTINCT
        DATE(SUBSTR("txn_date", 1, 7) || '-01')                         AS month_start
    FROM "customer_transactions"
)
SELECT 
    m.month_start,
    t.customer_id,
    COALESCE((
        SELECT SUM(x.signed_amt)
        FROM   txns x
        WHERE  x.customer_id = t.customer_id
          AND  x.txn_dt < DATE(m.month_start, 'start of month', '+1 month')
    ), 0)                                                               AS balance_to_date
FROM   months m
CROSS  JOIN (SELECT DISTINCT "customer_id" FROM "customer_transactions") t
ORDER  BY m.month_start, t.customer_id
LIMIT 20
