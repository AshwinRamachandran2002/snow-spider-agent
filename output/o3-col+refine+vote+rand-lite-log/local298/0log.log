```sql
--Description: 
-- Goal: for every calendar month, report the TOTAL balance that existed at the
--        start of that month (i.e., the closing balance of the previous month),
--        converting any negative balances to zero. The first month is dropped
--        because it only serves as the baseline.
--
-- Steps
-- 1. month_net  :  Collapse all transactions into a single signed “net_movement”
--                  per calendar month.  Deposits are positive, withdrawals and
--                  purchases are negative.
-- 2. prev_bal   :  Build a running cumulative sum of those net movements BUT
--                  stop one row before the current month (window frame
--                  “UNBOUNDED PRECEDING AND 1 PRECEDING”).  That running total
--                  is the balance that already existed when the current month
--                  began.  It is NULL for the very first month.
-- 3. Final SELECT:
--      • Convert NULL (first month) to exclusion via WHERE clause.
--      • Replace negative balances with zero.
--      • Output in chronological order.
WITH month_net AS (
    SELECT
        -- convert each txn_date to the first day of its month for easy ordering
        DATE(SUBSTR("txn_date", 1, 7) || '-01') AS month_start,
        SUM(CASE
                WHEN "txn_type" = 'deposit' THEN  "txn_amount"
                ELSE                              -1 * "txn_amount"
            END)                                AS net_movement
    FROM "customer_transactions"
    GROUP BY month_start
),
prev_bal AS (
    SELECT
        month_start,
        -- running total up to the PRIOR row (previous month)
        SUM(net_movement) OVER (
            ORDER BY month_start
            ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
        ) AS prev_total
    FROM month_net
)
SELECT
    month_start                  AS month,
    CASE
        WHEN prev_total < 0 THEN 0          -- replace negatives with zero
        ELSE prev_total
    END                       AS total_balance_prev_month
FROM   prev_bal
WHERE  prev_total IS NOT NULL                -- drop the first baseline month
ORDER  BY month_start;
```
