Query:
--Description: Compute total balance across ALL users as at the FIRST of each month (i.e., closing balance of the previous month).
WITH balances AS (
    SELECT 
        DATE(SUBSTR("txn_date", 1, 7) || '-01')                         AS month_start,
        SUM(CASE 
                WHEN "txn_type" = 'deposit' THEN  "txn_amount"
                ELSE                           -1 * "txn_amount"
            END)                                                        AS net_movement
    FROM "customer_transactions"
    GROUP BY month_start
), running AS (
    SELECT
        month_start,
        SUM(net_movement) OVER (
            ORDER BY month_start
            ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
        )                                                               AS cumulative_balance
    FROM balances
)
SELECT 
    month_start                                                         AS as_of_first,
    cumulative_balance                                                  AS prev_month_total
FROM   running
ORDER  BY month_start
LIMIT 20
