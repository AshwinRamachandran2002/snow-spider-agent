Query:
--Description: Shift the cumulative balance forward one month so that it
--represents the balance *as at the 1st day* of the next month
WITH monthly_net AS (
  SELECT "customer_id",
         substr("txn_date",1,7) AS "month",
         SUM(CASE WHEN "txn_type"='deposit'
                  THEN  "txn_amount"
                  ELSE - "txn_amount" END) AS "net_txn"
  FROM   "customer_transactions"
  GROUP  BY "customer_id","month"
),
running_bal AS (
  SELECT "customer_id",
         "month",
         SUM("net_txn") OVER (PARTITION BY "customer_id"
                              ORDER BY "month") AS "balance"
  FROM   monthly_net
)
SELECT "customer_id",
       LEAD("month")  OVER (PARTITION BY "customer_id" ORDER BY "month") AS "next_month",
       "balance"      AS  "prev_month_balance"
FROM   running_bal
LIMIT 20;
