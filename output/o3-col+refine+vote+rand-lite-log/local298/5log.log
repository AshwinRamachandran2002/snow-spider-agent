```sql
--Description: One-shot query (with inline commentary) that returns, for every
--calendar month, the total of all users’ balances as they stood on the 1st of
--that month (i.e. the cumulative balance at the end of the previous month);
--negative balances are floored to 0 and the very first month is excluded.

WITH
/* 1. Net movement per customer-month: deposits add, other types subtract. */
monthly_net AS (
    SELECT
        customer_id,
        substr(txn_date, 1, 7)                          AS month,   -- YYYY-MM
        SUM(CASE WHEN txn_type = 'deposit'
                 THEN  txn_amount
                 ELSE -txn_amount END)                  AS net_txn
    FROM customer_transactions
    GROUP BY customer_id, month
),

/* 2. Running (cumulative) balance for each customer over months. */
running_bal AS (
    SELECT
        customer_id,
        month,
        SUM(net_txn) OVER (PARTITION BY customer_id
                           ORDER BY month)              AS balance
    FROM monthly_net
),

/* 3. Shift the balance forward so it represents the amount held on the 1st
      of the NEXT month; convert negatives to zero. */
shifted AS (
    SELECT
        LEAD(month) OVER (PARTITION BY customer_id
                          ORDER BY month)               AS month,   -- target month
        CASE WHEN balance < 0 THEN 0 ELSE balance END   AS clean_balance
    FROM running_bal
),

/* 4. Sum those previous-month balances across all customers.
      Rows where month IS NULL correspond to the first month and are discarded. */
month_totals AS (
    SELECT
        month,
        SUM(clean_balance)                              AS total_prev_balance
    FROM shifted
    WHERE month IS NOT NULL
    GROUP BY month
)

/* 5. Final answer ordered chronologically. */
SELECT
    month,
    total_prev_balance
FROM month_totals
ORDER BY month;
```
