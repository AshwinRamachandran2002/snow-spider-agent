```sql
--Description: For each customer-month, work out the *net* movement  
--(deposits are positive, everything else is treated as a withdrawal)
SELECT "customer_id",
       substr("txn_date",1,7) AS "month",
       SUM(CASE WHEN "txn_type"='deposit'
                THEN  "txn_amount"
                ELSE - "txn_amount" END) AS "net_txn"
FROM   "customer_transactions"
GROUP  BY "customer_id","month"
LIMIT 20;
```

```sql
--Description: Turn the monthly movements into a running (“cumulative”) balance
WITH monthly_net AS (
  SELECT "customer_id",
         substr("txn_date",1,7) AS "month",
         SUM(CASE WHEN "txn_type"='deposit'
                  THEN  "txn_amount"
                  ELSE - "txn_amount" END) AS "net_txn"
  FROM   "customer_transactions"
  GROUP  BY "customer_id","month"
)
SELECT "customer_id",
       "month",
       SUM("net_txn") OVER (PARTITION BY "customer_id"
                            ORDER BY "month") AS "cumulative_balance"
FROM   monthly_net
LIMIT 20;
```

```sql
--Description: Shift the cumulative balance forward one month so that it
--represents the balance *as at the 1st day* of the next month
WITH monthly_net AS (
  SELECT "customer_id",
         substr("txn_date",1,7) AS "month",
         SUM(CASE WHEN "txn_type"='deposit'
                  THEN  "txn_amount"
                  ELSE - "txn_amount" END) AS "net_txn"
  FROM   "customer_transactions"
  GROUP  BY "customer_id","month"
),
running_bal AS (
  SELECT "customer_id",
         "month",
         SUM("net_txn") OVER (PARTITION BY "customer_id"
                              ORDER BY "month") AS "balance"
  FROM   monthly_net
)
SELECT "customer_id",
       LEAD("month")  OVER (PARTITION BY "customer_id" ORDER BY "month") AS "next_month",
       "balance"      AS  "prev_month_balance"
FROM   running_bal
LIMIT 20;
```

```sql
--Description: Replace any negative balances with 0 and keep only the records
--that actually have a “next month” (this removes the very first month)
WITH monthly_net AS (
  SELECT "customer_id",
         substr("txn_date",1,7) AS "month",
         SUM(CASE WHEN "txn_type"='deposit'
                  THEN  "txn_amount"
                  ELSE - "txn_amount" END) AS "net_txn"
  FROM   "customer_transactions"
  GROUP  BY "customer_id","month"
),
running_bal AS (
  SELECT "customer_id",
         "month",
         SUM("net_txn") OVER (PARTITION BY "customer_id"
                              ORDER BY "month") AS "balance"
  FROM   monthly_net
),
shifted AS (
  SELECT LEAD("month") OVER (PARTITION BY "customer_id" ORDER BY "month") AS "month",
         CASE WHEN "balance" < 0 THEN 0 ELSE "balance" END                AS "clean_balance"
  FROM   running_bal
)
SELECT DISTINCT "month","clean_balance"
FROM   shifted
WHERE  "month" IS NOT NULL
LIMIT 20;
```

