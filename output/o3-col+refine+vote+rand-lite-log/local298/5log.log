Query:
--Description: For each customer-month, work out the *net* movement  
--(deposits are positive, everything else is treated as a withdrawal)
SELECT "customer_id",
       substr("txn_date",1,7) AS "month",
       SUM(CASE WHEN "txn_type"='deposit'
                THEN  "txn_amount"
                ELSE - "txn_amount" END) AS "net_txn"
FROM   "customer_transactions"
GROUP  BY "customer_id","month"
LIMIT 20;
