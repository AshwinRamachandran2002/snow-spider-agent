```sql
--Description: 2)  Look at some raw values in the “Licenses” column to understand its JSON / ARRAY structure.
SELECT 
  "System",
  "Name",
  "Version",
  "Licenses"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
WHERE "Licenses" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 3)  Flatten the “Licenses” array to list individual license strings for a few package versions.
SELECT 
  pv."System",
  pv."Name",
  pv."Version",
  lic.value::STRING AS "License"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
     LATERAL FLATTEN(INPUT => pv."Licenses") lic
LIMIT 20;
```

```sql
--Description: 4)  Count how many times each license appears across ALL systems (top-20 only).
SELECT
  lic.value::STRING AS "License",
  COUNT(*) AS "License_Count"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
     LATERAL FLATTEN(INPUT => pv."Licenses") lic
GROUP BY lic.value::STRING
ORDER BY "License_Count" DESC
LIMIT 20;
```

```sql
--Description: 5)  Same as above but restricted to the NPM ecosystem only.
SELECT
  lic.value::STRING AS "License",
  COUNT(*) AS "License_Count"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
     LATERAL FLATTEN(INPUT => pv."Licenses") lic
WHERE pv."System" = 'NPM'
GROUP BY lic.value::STRING
ORDER BY "License_Count" DESC
LIMIT 20;
```

```sql
--Description: 6)  License frequency for the MAVEN ecosystem.
SELECT
  lic.value::STRING AS "License",
  COUNT(*) AS "License_Count"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
     LATERAL FLATTEN(INPUT => pv."Licenses") lic
WHERE pv."System" = 'MAVEN'
GROUP BY lic.value::STRING
ORDER BY "License_Count" DESC
LIMIT 20;
```

```sql
--Description: 7)  License frequency for the GO ecosystem.
SELECT
  lic.value::STRING AS "License",
  COUNT(*) AS "License_Count"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
     LATERAL FLATTEN(INPUT => pv."Licenses") lic
WHERE pv."System" = 'GO'
GROUP BY lic.value::STRING
ORDER BY "License_Count" DESC
LIMIT 20;
```

```sql
--Description: 8)  Derive, for EVERY system, the most-used license and show the top 20 systems-license pairs.
SELECT
  "System",
  "License",
  "License_Count"
FROM (
  SELECT
    pv."System",
    lic.value::STRING AS "License",
    COUNT(*) AS "License_Count",
    ROW_NUMBER() OVER (PARTITION BY pv."System" ORDER BY COUNT(*) DESC) AS rn
  FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
       LATERAL FLATTEN(INPUT => pv."Licenses") lic
  GROUP BY pv."System", lic.value::STRING
)
WHERE rn = 1
ORDER BY "License_Count" DESC
LIMIT 20;
```

```sql
--Description: 9)  Same as #8 but retain the top-3 licenses per system to understand close contenders.
SELECT
  "System",
  "License",
  "License_Count",
  rn
FROM (
  SELECT
    pv."System",
    lic.value::STRING AS "License",
    COUNT(*) AS "License_Count",
    ROW_NUMBER() OVER (PARTITION BY pv."System" ORDER BY COUNT(*) DESC) AS rn
  FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
       LATERAL FLATTEN(INPUT => pv."Licenses") lic
  GROUP BY pv."System", lic.value::STRING
)
WHERE rn <= 3
ORDER BY "System", rn
LIMIT 20;
```

```sql
--Description: 10)  Produce a pivot-style view that shows the highest-frequency license per system in one row.
SELECT
  "System",
  MAX_BY("License", "License_Count") AS "Most_Frequent_License",
  MAX("License_Count") AS "Frequency"
FROM (
  SELECT
    pv."System",
    lic.value::STRING AS "License",
    COUNT(*) AS "License_Count"
  FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
       LATERAL FLATTEN(INPUT => pv."Licenses") lic
  GROUP BY pv."System", lic.value::STRING
)
GROUP BY "System"
ORDER BY "Frequency" DESC
LIMIT 20;
```
