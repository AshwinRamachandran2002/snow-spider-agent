```sql
--Description: Take a peek at a few PACKAGEVERSIONS rows for the NPM system (to see how "Licenses" looks)  
SELECT "System",
       "Name",
       "Version",
       "Licenses"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
WHERE "System" = 'NPM'
LIMIT 20;
```

```sql
--Description: Flatten the JSON array in "Licenses" for a handful of random rows  
SELECT pv."System",
       pv."Name",
       pv."Version",
       f.value::STRING AS "License"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS AS pv,
     LATERAL FLATTEN(input => pv."Licenses") f
LIMIT 20;
```

```sql
--Description: See how many package versions in each system actually specify a license  
SELECT "System",
       COUNT(*)                                   AS "TotalPackageVersions",
       COUNT_IF("Licenses" IS NOT NULL AND ARRAY_SIZE("Licenses") > 0) AS "HasLicense"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
GROUP BY "System"
ORDER BY "TotalPackageVersions" DESC
LIMIT 20;
```

```sql
--Description: Count the occurrence of every license string in the NPM ecosystem  
SELECT f.value::STRING                 AS "License",
       COUNT(*)                        AS "Occurrences"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS AS pv,
     LATERAL FLATTEN(input => pv."Licenses") f
WHERE pv."System" = 'NPM'
GROUP BY f.value::STRING
ORDER BY "Occurrences" DESC
LIMIT 20;
```

```sql
--Description: Same idea, but for MAVEN (replace with other systems as needed)  
SELECT f.value::STRING                 AS "License",
       COUNT(*)                        AS "Occurrences"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS AS pv,
     LATERAL FLATTEN(input => pv."Licenses") f
WHERE pv."System" = 'MAVEN'
GROUP BY f.value::STRING
ORDER BY "Occurrences" DESC
LIMIT 20;
```

```sql
--Description: Global view – license counts for every system, keeping the top-20 (system,license) pairs overall  
SELECT pv."System",
       f.value::STRING                 AS "License",
       COUNT(*)                        AS "Occurrences"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS AS pv,
     LATERAL FLATTEN(input => pv."Licenses") f
GROUP BY pv."System", f.value::STRING
ORDER BY "Occurrences" DESC
LIMIT 20;
```

```sql
--Description: Rank licenses within each system by frequency (top 20 rows of the ranking table)  
SELECT "System",
       "License",
       "Occurrences",
       ROW_NUMBER() OVER (PARTITION BY "System" ORDER BY "Occurrences" DESC) AS "RankInSystem"
FROM (
    SELECT pv."System",
           f.value::STRING AS "License",
           COUNT(*)        AS "Occurrences"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS AS pv,
         LATERAL FLATTEN(input => pv."Licenses") f
    GROUP BY pv."System", f.value::STRING
) t
ORDER BY "System", "RankInSystem"
LIMIT 20;
```

```sql
--Description: Pull out only the single most common license in each system (may return ≤20 systems)  
SELECT "System",
       "License",
       "Occurrences"
FROM (
    SELECT "System",
           "License",
           "Occurrences",
           ROW_NUMBER() OVER (PARTITION BY "System" ORDER BY "Occurrences" DESC) AS rn
    FROM (
        SELECT pv."System",
               f.value::STRING AS "License",
               COUNT(*)        AS "Occurrences"
        FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS AS pv,
             LATERAL FLATTEN(input => pv."Licenses") f
        GROUP BY pv."System", f.value::STRING
    )
)
WHERE rn = 1
ORDER BY "System"
LIMIT 20;
```

```sql
--Description: Final query showing the most frequently used license per system, but including the percentage it represents among licensed packages  
SELECT topLic."System",
       topLic."License",
       topLic."Occurrences",
       ROUND(topLic."Occurrences" / sysTot."LicensedCnt"::DECIMAL, 4) AS "ShareOfLicensedPackages"
FROM (
    -- per-system totals of versions that actually have at least one license string
    SELECT "System",
           COUNT(*) AS "LicensedCnt"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
    WHERE "Licenses" IS NOT NULL AND ARRAY_SIZE("Licenses") > 0
    GROUP BY "System"
) AS sysTot
JOIN (
    -- most common license in each system
    SELECT "System",
           "License",
           "Occurrences"
    FROM (
        SELECT "System",
               "License",
               "Occurrences",
               ROW_NUMBER() OVER (PARTITION BY "System" ORDER BY "Occurrences" DESC) AS rn
        FROM (
            SELECT pv."System",
                   f.value::STRING AS "License",
                   COUNT(*)        AS "Occurrences"
            FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS AS pv,
                 LATERAL FLATTEN(input => pv."Licenses") f
            GROUP BY pv."System", f.value::STRING
        )
    )
    WHERE rn = 1
) AS topLic
  ON topLic."System" = sysTot."System"
ORDER BY topLic."System"
LIMIT 20;
```
