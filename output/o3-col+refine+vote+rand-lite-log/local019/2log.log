```sql
--Description: Find all belts whose name includes the string “NXT”.
SELECT DISTINCT "id", "name"
FROM "Belts"
WHERE "name" LIKE '%NXT%'
LIMIT 20;
```

```sql
--Description: Show every match in which an “NXT” belt was on the line.
SELECT DISTINCT "id", "card_id", "winner_id", "loser_id",
                "duration", "title_change", "title_id"
FROM "Matches"
WHERE "title_id" IN (SELECT "id" FROM "Belts" WHERE "name" LIKE '%NXT%')
LIMIT 20;
```

```sql
--Description: Keep only those “NXT-title” matches that did NOT have a title change and that have a recorded duration.
SELECT "id", "duration"
FROM "Matches"
WHERE "title_id" IN (SELECT "id" FROM "Belts" WHERE "name" LIKE '%NXT%')
  AND "title_change" = 0
  AND "duration" <> ''
LIMIT 20;
```

```sql
--Description: Order the above matches by the length of the bout (in seconds) to find the shortest one.
SELECT "id", "duration"
FROM "Matches"
WHERE "title_id" IN (SELECT "id" FROM "Belts" WHERE "name" LIKE '%NXT%')
  AND "title_change" = 0
  AND "duration" <> ''
ORDER BY CAST(SUBSTR("duration",1,INSTR("duration",':')-1) AS INT)*60
       + CAST(SUBSTR("duration",INSTR("duration",':')+1) AS INT)
ASC
LIMIT 5;
```

```sql
--Description: For the single shortest match returned above, show the winner and loser names.
SELECT  m."id",
        w1."name" AS "winner",
        w2."name" AS "loser",
        m."duration"
FROM   "Matches"   AS m
JOIN   "Wrestlers" AS w1 ON w1."id" = CAST(m."winner_id" AS INT)
JOIN   "Wrestlers" AS w2 ON w2."id" = CAST(m."loser_id"  AS INT)
WHERE  m."id" = (  SELECT "id"
                   FROM "Matches"
                   WHERE "title_id" IN (SELECT "id"
                                        FROM "Belts"
                                        WHERE "name" LIKE '%NXT%')
                     AND "title_change" = 0
                     AND "duration" <> ''
                   ORDER BY CAST(SUBSTR("duration",1,INSTR("duration",':')-1) AS INT)*60
                          + CAST(SUBSTR("duration",INSTR("duration",':')+1) AS INT)
                   ASC
                   LIMIT 1);
```

```sql
--Description (FINAL ANSWER): Directly return the two wrestlers involved in the shortest non-changing “NXT” title match.
SELECT  w1."name" AS "Wrestler_1",
        w2."name" AS "Wrestler_2"
FROM   "Matches"   AS m
JOIN   "Wrestlers" AS w1 ON w1."id" = CAST(m."winner_id" AS INT)
JOIN   "Wrestlers" AS w2 ON w2."id" = CAST(m."loser_id"  AS INT)
WHERE  m."title_id" IN (SELECT "id" FROM "Belts" WHERE "name" LIKE '%NXT%')
  AND  m."title_change" = 0
  AND  m."duration" <> ''
ORDER BY CAST(SUBSTR(m."duration",1,INSTR(m."duration",':')-1) AS INT)*60
       + CAST(SUBSTR(m."duration",INSTR(m."duration",':')+1) AS INT)
ASC
LIMIT 1;
```
