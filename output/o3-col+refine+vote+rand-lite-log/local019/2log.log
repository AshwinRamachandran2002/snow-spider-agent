Query:
--Description: Keep only those “NXT-title” matches that did NOT have a title change and that have a recorded duration.
SELECT "id", "duration"
FROM "Matches"
WHERE "title_id" IN (SELECT "id" FROM "Belts" WHERE "name" LIKE '%NXT%')
  AND "title_change" = 0
  AND "duration" <> ''
LIMIT 20;
