```sql
-- 1. Description: Find every belt that belongs to the NXT lineage  
SELECT id, name
FROM Belts
WHERE name LIKE '%NXT%'
LIMIT 20;
```

```sql
-- 2. Description: List all Matches in which an NXT title was at stake
--    (ignoring bouts where the title actually changed hands)
SELECT id AS match_id,
       winner_id,
       loser_id,
       duration,
       title_id
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND title_change = 0
LIMIT 20;
```

```sql
-- 3. Description: Show every distinct, non-empty duration for those matches
SELECT DISTINCT duration
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND title_change = 0
  AND duration <> ''
ORDER BY duration
LIMIT 20;
```

```sql
-- 4. Description: Compute the five shortest of those durations, converting
--    the mm:ss text to total seconds for accurate ordering
SELECT duration,
       (SUBSTR(duration, 1, 2)*60 + SUBSTR(duration, 4, 2)) AS secs
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND title_change = 0
  AND duration <> ''
ORDER BY secs
LIMIT 5;
```

```sql
-- 5. Description: Grab the single shortest NXT-title match (no title change)
--    and keep the IDs of the two wrestlers involved
SELECT id           AS match_id,
       winner_id,
       loser_id,
       duration
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND title_change = 0
  AND duration <> ''
ORDER BY (SUBSTR(duration, 1, 2)*60 + SUBSTR(duration, 4, 2))
LIMIT 1;
```

```sql
-- 6. Description: Return the names of the two wrestlers from that shortest match
SELECT w1.name AS winner_name,
       w2.name AS loser_name
FROM   Matches   AS m
JOIN   Wrestlers AS w1 ON w1.id = m.winner_id
JOIN   Wrestlers AS w2 ON w2.id = m.loser_id
WHERE  m.id = (
        SELECT id
        FROM Matches
        WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
          AND title_change = 0
          AND duration <> ''
        ORDER BY (SUBSTR(duration, 1, 2)*60 + SUBSTR(duration, 4, 2))
        LIMIT 1
      );
```
