-- 3. Description: Show every distinct, non-empty duration for those matches
SELECT DISTINCT duration
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND title_change = 0
  AND duration <> ''
ORDER BY duration
LIMIT 20;
