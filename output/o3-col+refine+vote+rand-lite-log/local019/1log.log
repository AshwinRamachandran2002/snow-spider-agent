2025-05-05 04:29:47 - Thread-3234 (execute) - INFO - [Exploration]
Below is a step-by-step set of SQL statements that drill down from the belts that contain “NXT” to the wrestlers who took part in the shortest NXT title match in which the title did NOT change.  
(Each query is limited to 20 rows where applicable.)

```sql
-- 1.  List every belt whose name contains the string “NXT”.
SELECT id, name
FROM Belts
WHERE name LIKE '%NXT%'
LIMIT 20;
```

```sql
-- 2.  Show the first 20 matches in which any “NXT” belt was on the line.
SELECT id, title_id, winner_id, loser_id, duration, title_change
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
LIMIT 20;
```

```sql
-- 3.  Same set, but only matches whose duration field is filled in,
--     ordered (lexicographically) by duration.
SELECT id, duration
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND duration <> ''
ORDER BY duration
LIMIT 20;
```

```sql
-- 4.  Convert the “mm:ss” duration into seconds so we can sort numerically.
SELECT id,
       duration,
       (CAST(SUBSTR(duration,1,INSTR(duration,':')-1) AS INTEGER) * 60 +
        CAST(SUBSTR(duration,INSTR(duration,':')+1) AS INTEGER)) AS secs
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND duration LIKE '%:%'
ORDER BY secs
LIMIT 20;
```

```sql
-- 5.  Do the same, but keep only matches with NO title change.
SELECT id,
       duration,
       (CAST(SUBSTR(duration,1,INSTR(duration,':')-1) AS INTEGER) * 60 +
        CAST(SUBSTR(duration,INSTR(duration,':')+1) AS INTEGER)) AS secs
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND duration LIKE '%:%'
  AND title_change = 0
ORDER BY secs
LIMIT 20;
```

```sql
-- 6.  Find the numeric value of the shortest such NXT-title match.
SELECT MIN(
       CAST(SUBSTR(duration,1,INSTR(duration,':')-1) AS INTEGER) * 60 +
       CAST(SUBSTR(duration,INSTR(duration,':')+1) AS INTEGER)
       ) AS shortest_secs
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND duration LIKE '%:%'
  AND title_change = 0;
```

```sql
-- 7.  Identify the match (or matches) that has that shortest duration.
SELECT id, winner_id, loser_id, duration
FROM (
    SELECT id,
           winner_id,
           loser_id,
           duration,
           (CAST(SUBSTR(duration,1,INSTR(duration,':')-1) AS INTEGER) * 60 +
            CAST(SUBSTR(duration,INSTR(duration,':')+1) AS INTEGER)) AS secs
    FROM Matches
    WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
      AND duration LIKE '%:%'
      AND title_change = 0
) AS t
WHERE secs = (
    SELECT MIN(
           CAST(SUBSTR(duration,1,INSTR(duration,':')-1) AS INTEGER) * 60 +
           CAST(SUBSTR(duration,INSTR(duration,':')+1) AS INTEGER)
           )
    FROM Matches
    WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
      AND duration LIKE '%:%'
      AND title_change = 0
);
```

```sql
-- 8.  Join to the Wrestlers table to get the actual names of the two wrestlers.
SELECT w1.name  AS winner_name,
       w2.name  AS loser_name
FROM Matches  AS m
JOIN Wrestlers AS w1 ON w1.id = CAST(m.winner_id AS INTEGER)
JOIN Wrestlers AS w2 ON w2.id = CAST(m.loser_id  AS INTEGER)
WHERE m.id IN (
    SELECT id
    FROM (
        SELECT id,
               (CAST(SUBSTR(duration,1,INSTR(duration,':')-1) AS INTEGER) * 60 +
                CAST(SUBSTR(duration,INSTR(duration,':')+1) AS INTEGER)) AS secs
        FROM Matches
        WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
          AND duration LIKE '%:%'
          AND title_change = 0
    )
    WHERE secs = (
        SELECT MIN(
               CAST(SUBSTR(duration,1,INSTR(duration,':')-1) AS INTEGER) * 60 +
               CAST(SUBSTR(duration,INSTR(duration,':')+1) AS INTEGER)
               )
        FROM Matches
        WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
          AND duration LIKE '%:%'
          AND title_change = 0
    )
)
LIMIT 20;
```

```sql
-- 9.  (Optional) Add the belt’s name for context.
SELECT b.name          AS belt_name,
       w1.name         AS winner_name,
       w2.name         AS loser_name,
       m.duration
FROM Matches  AS m
JOIN Belts    AS b  ON b.id = m.title_id
JOIN Wrestlers AS w1 ON w1.id = CAST(m.winner_id AS INTEGER)
JOIN Wrestlers AS w2 ON w2.id = CAST(m.loser_id  AS INTEGER)
WHERE m.id IN (
    SELECT id
    FROM (
        SELECT id,
               (CAST(SUBSTR(duration,1,INSTR(duration,':')-1) AS INTEGER) * 60 +
                CAST(SUBSTR(duration,INSTR(duration,':')+1) AS INTEGER)) AS secs
        FROM Matches
        WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
          AND duration LIKE '%:%'
          AND title_change = 0
    )
    WHERE secs = (
        SELECT MIN(
               CAST(SUBSTR(duration,1,INSTR(duration,':')-1) AS INTEGER) * 60 +
               CAST(SUBSTR(duration,INSTR(duration,':')+1) AS INTEGER)
               )
        FROM Matches
        WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
          AND duration LIKE '%:%'
          AND title_change = 0
    )
)
LIMIT 20;
```

