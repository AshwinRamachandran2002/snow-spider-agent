Query:
-- 6.  Find the numeric value of the shortest such NXT-title match.
SELECT MIN(
       CAST(SUBSTR(duration,1,INSTR(duration,':')-1) AS INTEGER) * 60 +
       CAST(SUBSTR(duration,INSTR(duration,':')+1) AS INTEGER)
       ) AS shortest_secs
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND duration LIKE '%:%'
  AND title_change = 0;
Answer:
shortest_secs
43
Query:
-- 7.  Identify the match (or matches) that has that shortest duration.
SELECT id, winner_id, loser_id, duration
FROM (
    SELECT id,
           winner_id,
           loser_id,
           duration,
           (CAST(SUBSTR(duration,1,INSTR(duration,':')-1) AS INTEGER) * 60 +
            CAST(SUBSTR(duration,INSTR(duration,':')+1) AS INTEGER)) AS secs
    FROM Matches
    WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
      AND duration LIKE '%:%'
      AND title_change = 0
) AS t
WHERE secs = (
    SELECT MIN(
           CAST(SUBSTR(duration,1,INSTR(duration,':')-1) AS INTEGER) * 60 +
           CAST(SUBSTR(duration,INSTR(duration,':')+1) AS INTEGER)
           )
    FROM Matches
    WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
      AND duration LIKE '%:%'
      AND title_change = 0
);
