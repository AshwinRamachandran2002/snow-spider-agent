```sql
--Description: 1) See all belts to locate any whose name mentions NXT
SELECT DISTINCT id, name 
FROM Belts
LIMIT 20;
```

```sql
--Description: 2) Narrow to belts whose name contains the string 'NXT'
SELECT id, name 
FROM Belts 
WHERE name LIKE '%NXT%';
```

```sql
--Description: 3) Look at matches that were for one of those NXT belts (title_change flag = 0 means the belt didn't change hands)
SELECT id, card_id, winner_id, loser_id, duration, title_id 
FROM Matches 
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND title_change = 0
LIMIT 20;
```

```sql
--Description: 4) Check the same result-set but only where a duration value is stored
SELECT id, duration 
FROM Matches 
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND title_change = 0
  AND duration <> '';
```

```sql
--Description: 5) Find the shortest duration among the above matches
SELECT MIN(duration) AS shortest_time
FROM Matches 
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND title_change = 0
  AND duration <> '';
```

```sql
--Description: 6) Retrieve the match (or matches, in case of ties) that has that shortest duration
SELECT id, winner_id, loser_id, duration 
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND title_change = 0
  AND duration = (
        SELECT MIN(duration)
        FROM Matches
        WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
          AND title_change = 0
          AND duration <> '')
;
```

```sql
--Description: 7) Join the winner & loser IDs from that match to the Wrestlers table to get their names
SELECT w1.name AS wrestler_1, 
       w2.name AS wrestler_2
FROM Matches  m
JOIN Wrestlers w1 ON w1.id = m.winner_id
JOIN Wrestlers w2 ON w2.id = m.loser_id
WHERE m.id = (
        SELECT id
        FROM Matches
        WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
          AND title_change = 0
          AND duration = (SELECT MIN(duration)
                          FROM Matches
                          WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
                            AND title_change = 0
                            AND duration <> '')
        LIMIT 1)
;
```
