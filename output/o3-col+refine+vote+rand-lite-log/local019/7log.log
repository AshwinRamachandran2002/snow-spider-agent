Query:
--Description: 6) Retrieve the match (or matches, in case of ties) that has that shortest duration
SELECT id, winner_id, loser_id, duration 
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND title_change = 0
  AND duration = (
        SELECT MIN(duration)
        FROM Matches
        WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
          AND title_change = 0
          AND duration <> '')
;
