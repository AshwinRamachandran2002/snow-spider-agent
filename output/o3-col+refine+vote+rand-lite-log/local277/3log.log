```sql
--Description / thinking process:
-- 1. Need seasonality rows (time-steps 7–30) for products 4160 & 7790.
-- 2. A window-function alias (ROW_NUMBER) can’t be filtered in the same SELECT,
--    so wrap it in a sub-query.
-- 3. Outer query keeps only rows where t_step BETWEEN 7 AND 30, then orders them.
SELECT  s."product_id",
        s."mth",
        s."qty",
        s."t_step"
FROM   (
          SELECT "product_id",
                 "mth",
                 "qty",
                 ROW_NUMBER() OVER (PARTITION BY "product_id"
                                    ORDER BY "mth") AS "t_step"
          FROM   "monthly_sales"
          WHERE  "product_id" IN (4160, 7790)
       ) AS s
WHERE  s."t_step" BETWEEN 7 AND 30
ORDER  BY s."product_id",
          s."t_step"
LIMIT  40;
```
