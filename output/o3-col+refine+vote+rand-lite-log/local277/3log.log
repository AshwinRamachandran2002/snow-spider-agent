```sql
--Description: Number the monthly rows (1 = Jan-2016) so later queries can pick 
--             time steps 7–30 or 25–36, without needing an extra table.
SELECT "product_id",
       "mth",
       "qty",
       ROW_NUMBER() OVER (PARTITION BY "product_id"
                          ORDER BY "mth")      AS "t_step"
FROM   "monthly_sales"
WHERE  "product_id" IN (4160, 7790)
ORDER  BY "product_id",
          "mth"
LIMIT  40;
```

```sql
--Description: Retrieve the seasonality-window rows (time steps 7-30) that will be
--             needed for the seasonal adjustment component of the forecast.
SELECT "product_id",
       "mth",
       "qty",
       ROW_NUMBER() OVER (PARTITION BY "product_id"
                          ORDER BY "mth") AS "t_step"
FROM   "monthly_sales"
WHERE  "product_id" IN (4160, 7790)
HAVING "t_step" BETWEEN 7 AND 30
ORDER  BY "product_id",
          "t_step"
LIMIT  40;
```

```sql
--Description: Compute the average seasonal uplift (time steps 7-30) for each product.
SELECT "product_id",
       AVG("qty") AS "avg_seasonal_qty"
FROM  (
        SELECT "product_id",
               "qty",
               ROW_NUMBER() OVER (PARTITION BY "product_id"
                                  ORDER BY "mth") AS "t_step"
        FROM   "monthly_sales"
        WHERE  "product_id" IN (4160, 7790)
      )
WHERE  "t_step" BETWEEN 7 AND 30
GROUP BY "product_id";
```

```sql
--Description: Prepare the regression-training set—first 24 time steps (Jan-2016 to Dec-2017)
--             that will feed the weighted regression model.
SELECT "product_id",
       "qty",
       ROW_NUMBER() OVER (PARTITION BY "product_id"
                          ORDER BY "mth") AS "t_step"
FROM   "monthly_sales"
WHERE  "product_id" IN (4160, 7790)
HAVING "t_step" <= 24
ORDER  BY "product_id",
          "t_step";
```

```sql
--Description: Collect the 2018 target window (time steps 25-36) for comparison
--             with the regression-based forecast once it is produced.
SELECT "product_id",
       "mth",
       "qty",
       ROW_NUMBER() OVER (PARTITION BY "product_id"
                          ORDER BY "mth") AS "t_step"
FROM   "monthly_sales"
WHERE  "product_id" IN (4160, 7790)
HAVING "t_step" BETWEEN 25 AND 36
ORDER  BY "product_id",
          "t_step";
```

```sql
--Description: Quickly aggregate the actual 2018 totals so that, after running
--             the weighted regression and seasonality logic outside SQL,
--             the result can be compared to (or replaced by) the model output.
SELECT "product_id",
       SUM("qty") AS "actual_2018_total_qty"
FROM  (
        SELECT "product_id",
               "qty",
               ROW_NUMBER() OVER (PARTITION BY "product_id"
                                  ORDER BY "mth") AS "t_step"
        FROM   "monthly_sales"
        WHERE  "product_id" IN (4160, 7790)
      )
WHERE  "t_step" BETWEEN 25 AND 36
GROUP BY "product_id";
```

