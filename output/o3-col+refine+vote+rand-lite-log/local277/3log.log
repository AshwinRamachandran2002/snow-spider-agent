--Description: Compute the average seasonal uplift (time steps 7-30) for each product 4160 & 7790.
SELECT  s."product_id",
        AVG(s."qty") AS "avg_seasonal_qty"
FROM   (
          SELECT "product_id",
                 "qty",
                 ROW_NUMBER() OVER (PARTITION BY "product_id"
                                    ORDER BY "mth") AS "t_step"
          FROM   "monthly_sales"
          WHERE  "product_id" IN (4160, 7790)
       ) AS s
WHERE  s."t_step" BETWEEN 7 AND 30
GROUP BY s."product_id"
