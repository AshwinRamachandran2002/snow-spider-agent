```sql
-- Description: Inspect the first few month records for product 7790 (ordered chronologically).  
SELECT product_id, mth, qty 
FROM monthly_sales 
WHERE product_id = 7790 
ORDER BY mth ASC 
LIMIT 20;
```

```sql
-- Description: See how many monthly‐sales rows we actually have for each of the two products.  
SELECT product_id, COUNT(*) AS row_cnt 
FROM monthly_sales 
WHERE product_id IN (4160, 7790) 
GROUP BY product_id 
LIMIT 20;
```

```sql
-- Description: Pull the raw 36-month time-series (Jan-2016 .. Dec-2018) for both products side-by-side.  
SELECT mth,
       SUM(CASE WHEN product_id = 4160 THEN qty END) AS qty_4160,
       SUM(CASE WHEN product_id = 7790 THEN qty END) AS qty_7790
FROM monthly_sales
WHERE product_id IN (4160, 7790)
  AND mth BETWEEN '2016-01-01' AND '2018-12-01'
GROUP BY mth
ORDER BY mth ASC
LIMIT 20;
```

```sql
-- Description: Compute the 24-month (t=7 .. 30) seasonality factors by normalising each month to the product’s mean.  
SELECT product_id,
       mth,
       qty,
       CAST(qty AS REAL) / (SELECT AVG(qty) FROM monthly_sales ms2
                            WHERE ms2.product_id = ms1.product_id
                              AND ms2.mth BETWEEN '2016-01-01' AND '2018-12-01') AS seasonality_factor
FROM monthly_sales AS ms1
WHERE product_id IN (4160, 7790)
  AND mth BETWEEN '2016-07-01' AND '2018-06-01'
ORDER BY product_id, mth
LIMIT 20;
```

```sql
-- Description: Prepare weighted regression inputs (month_index & weighted_qty) for product 4160.  
SELECT ROW_NUMBER() OVER(ORDER BY mth) AS month_idx,
       mth,
       qty,
       -- Example simple weight: inverse of month_idx (more recent ⇒ higher weight)
       1.0 / ROW_NUMBER() OVER(ORDER BY mth) AS weight
FROM monthly_sales
WHERE product_id = 4160
  AND mth BETWEEN '2016-01-01' AND '2018-12-01'
LIMIT 20;
```

```sql
-- Description: Same weighted-regression preparation for product 7790.  
SELECT ROW_NUMBER() OVER(ORDER BY mth) AS month_idx,
       mth,
       qty,
       1.0 / ROW_NUMBER() OVER(ORDER BY mth) AS weight
FROM monthly_sales
WHERE product_id = 7790
  AND mth BETWEEN '2016-01-01' AND '2018-12-01'
LIMIT 20;
```

```sql
-- Description: Merge both series with month index for further regression modelling / forecasting.  
WITH base AS (
    SELECT mth,
           SUM(CASE WHEN product_id = 4160 THEN qty END) AS qty_4160,
           SUM(CASE WHEN product_id = 7790 THEN qty END) AS qty_7790
    FROM monthly_sales
    WHERE product_id IN (4160, 7790)
      AND mth BETWEEN '2016-01-01' AND '2018-12-01'
    GROUP BY mth
)
SELECT ROW_NUMBER() OVER(ORDER BY mth) AS month_idx,
       mth,
       qty_4160,
       qty_7790
FROM base
ORDER BY mth
LIMIT 20;
```

```sql
-- Description: (Final verification) Aggregate total forecast horizon (12-months of 2018) to get annual quantity baseline.  
SELECT product_id,
       SUM(qty) AS year_2018_qty
FROM monthly_sales
WHERE product_id IN (4160, 7790)
  AND mth BETWEEN '2018-01-01' AND '2018-12-01'
GROUP BY product_id
LIMIT 20;
```
