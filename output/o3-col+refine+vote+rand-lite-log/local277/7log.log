Query:
-- Description: Merge both series with month index for further regression modelling / forecasting.  
WITH base AS (
    SELECT mth,
           SUM(CASE WHEN product_id = 4160 THEN qty END) AS qty_4160,
           SUM(CASE WHEN product_id = 7790 THEN qty END) AS qty_7790
    FROM monthly_sales
    WHERE product_id IN (4160, 7790)
      AND mth BETWEEN '2016-01-01' AND '2018-12-01'
    GROUP BY mth
)
SELECT ROW_NUMBER() OVER(ORDER BY mth) AS month_idx,
       mth,
       qty_4160,
       qty_7790
FROM base
ORDER BY mth
LIMIT 20;
