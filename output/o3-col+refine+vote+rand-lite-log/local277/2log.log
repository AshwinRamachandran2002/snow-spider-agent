```sql
--Description: Inspect the first 36 monthly‐sales rows for product 4160 (starting Jan-2016)
WITH ranked AS (
    SELECT m.product_id,
           m.mth,
           m.qty,
           ROW_NUMBER() OVER (ORDER BY m.mth) AS rn
    FROM monthly_sales AS m
    WHERE m.product_id = 4160
      AND m.mth >= '2016-01-01'
)
SELECT DISTINCT product_id, mth, qty
FROM ranked
WHERE rn <= 36
ORDER BY mth
LIMIT 20;
```

```sql
--Description: Inspect the first 36 monthly‐sales rows for product 7790 (starting Jan-2016)
