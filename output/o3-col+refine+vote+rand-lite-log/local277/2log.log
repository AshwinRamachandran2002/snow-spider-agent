```sql
--Description: Count how many monthly rows we actually have (Jan-2016 through Dec-2018) for each product
SELECT DISTINCT product_id,
       COUNT(*) AS months_available
FROM monthly_sales
WHERE product_id IN (4160, 7790)
  AND mth BETWEEN '2016-01-01' AND '2018-12-01'
GROUP BY product_id
LIMIT 20;
```

```sql
--Description: Get basic aggregates (sum & average) for the first 36 months of both products
WITH ranked AS (
    SELECT m.*,
           ROW_NUMBER() OVER (PARTITION BY m.product_id ORDER BY m.mth) AS rn
    FROM monthly_sales AS m
    WHERE m.product_id IN (4160, 7790)
      AND m.mth >= '2016-01-01'
)
SELECT DISTINCT product_id,
       SUM(qty)  AS qty_sum_36m,
       AVG(qty)  AS qty_avg_36m
FROM ranked
WHERE rn <= 36
GROUP BY product_id
LIMIT 20;
```

```sql
--Description: Extract months 7-30 (seasonality window) for product 4160
WITH ranked AS (
    SELECT m.mth,
           m.qty,
           ROW_NUMBER() OVER (ORDER BY m.mth) AS rn
    FROM monthly_sales AS m
    WHERE m.product_id = 4160
      AND m.mth >= '2016-01-01'
)
SELECT DISTINCT rn AS time_idx, mth, qty
FROM ranked
WHERE rn BETWEEN 7 AND 30
ORDER BY rn
LIMIT 20;
```

