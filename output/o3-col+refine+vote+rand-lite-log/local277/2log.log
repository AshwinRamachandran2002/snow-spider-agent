--Description: Combine both products’ regression components (sums needed for slope/intercept) for the first 36 months
WITH ranked AS (
    SELECT m.product_id,
           ROW_NUMBER() OVER (PARTITION BY m.product_id ORDER BY m.mth) AS idx,
           m.qty
    FROM monthly_sales AS m
    WHERE m.product_id IN (4160, 7790)
      AND m.mth >= '2016-01-01'
      LIMIT 72
)
SELECT DISTINCT product_id,
       SUM(idx)          AS sum_idx,
       SUM(qty)          AS sum_qty,
       SUM(idx*qty)      AS sum_idx_qty,
       SUM(idx*idx)      AS sum_idx_sq,
       COUNT(*)          AS n_points
FROM ranked
GROUP BY product_id
LIMIT 20;
