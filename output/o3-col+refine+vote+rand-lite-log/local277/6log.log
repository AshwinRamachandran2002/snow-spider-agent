--Description: Compute the average monthly quantity over the seasonality-adjusted window 
--             (time steps 7–30 → 2016-07-01..2018-06-01) for each product
SELECT  "product_id",
        AVG("qty") AS "avg_month_qty_adj_window"
FROM    "monthly_sales"
WHERE   "product_id" IN (4160,7790)
  AND   "mth" BETWEEN '2016-07-01' AND '2018-06-01'
GROUP BY "product_id"
