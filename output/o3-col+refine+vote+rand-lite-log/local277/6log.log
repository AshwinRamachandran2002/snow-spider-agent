Query:
--Description: Derive the 2018 forecasted annual sales by multiplying the adjusted average 
--             monthly quantity (from the prior window) by 12
SELECT  "product_id",
        ROUND(AVG("qty") * 12, 2)  AS "forecasted_annual_sales_2018"
FROM    "monthly_sales"
WHERE   "product_id" IN (4160,7790)
  AND   "mth" BETWEEN '2016-07-01' AND '2018-06-01'
GROUP BY "product_id"
