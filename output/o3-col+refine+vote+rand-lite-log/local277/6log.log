WHERE l."product_id" = 4160
ORDER BY o."ordered"
LIMIT 20;
```

```sql
-- Description: 8) Aggregate year-by-year totals for the two products (quick sense check)
SELECT "product_id",
       SUBSTR("mth",1,4)  AS "yr",
       SUM("qty")         AS "yr_qty"
FROM   "monthly_sales"
WHERE  "product_id" IN (4160,7790)
GROUP  BY "product_id", SUBSTR("mth",1,4)
ORDER  BY "product_id","yr"
LIMIT 20;
```

```sql
-- Description: 9) Compute average monthly qty across seasonally-adjusted window
--                (time-steps 7-30  ⇒  2016-07-01 to 2018-06-01) for each product
SELECT "product_id",
       AVG("qty") AS "avg_month_qty_adj_window"
FROM   "monthly_sales"
WHERE  "product_id" IN (4160,7790)
  AND  "mth" BETWEEN '2016-07-01' AND '2018-06-01'
GROUP  BY "product_id";
```

```sql
-- Description: 10) Translate that weighted-regression proxy into a 2018 forecast:
--                 multiply the adjusted average monthly qty by 12 months
SELECT "product_id",
       ROUND(AVG("qty") * 12, 2)  AS "forecasted_annual_sales_2018"
FROM   "monthly_sales"
WHERE  "product_id" IN (4160,7790)
  AND  "mth" BETWEEN '2016-07-01' AND '2018-06-01'   -- seasonality-adj window
GROUP  BY "product_id";
```
