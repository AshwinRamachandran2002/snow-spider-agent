```

```sql
--Description: Retrieve the 2016-01-01 through 2018-12-01 monthly quantities for both products
SELECT product_id,
       mth,
       qty
FROM monthly_sales
WHERE product_id IN (4160, 7790)
  AND mth BETWEEN '2016-01-01' AND '2018-12-01'
ORDER BY product_id,
         mth
LIMIT 20;
```

```sql
--Description: Aggregate the raw monthly sales into yearly totals for each product (2016-2018)
SELECT product_id,
       SUBSTR(mth, 1, 4) AS year,
       SUM(qty)          AS year_qty
FROM monthly_sales
WHERE product_id IN (4160, 7790)
  AND mth BETWEEN '2016-01-01' AND '2018-12-31'
GROUP BY product_id,
         year
ORDER BY product_id,
         year
LIMIT 20;
```

```sql
--Description: Calculate the average monthly sales for the first 36 months (2016-01 to 2018-12)
SELECT product_id,
       AVG(qty) AS avg_36m_qty
FROM monthly_sales
WHERE product_id IN (4160, 7790)
  AND mth BETWEEN '2016-01-01' AND '2018-12-01'
GROUP BY product_id
LIMIT 20;
```

```sql
--Description: Show the time-steps (row number order) to help identify seasonality (months 7-30 highlighted)
WITH seq AS (
  SELECT product_id,
         mth,
         qty,
         ROW_NUMBER() OVER (PARTITION BY product_id ORDER BY mth) AS rn
  FROM monthly_sales
  WHERE product_id IN (4160, 7790)
    AND mth BETWEEN '2016-01-01' AND '2018-12-01'
)
SELECT product_id,
       mth,
       qty,
       rn
FROM seq
WHERE rn BETWEEN 7 AND 30
ORDER BY product_id,
         rn
LIMIT 20;
```

```sql
--Description: Create a simple weighted quantity (weight = row number) preview to illustrate weighted regression input
WITH seq AS (
  SELECT product_id,
         mth,
         qty,
         ROW_NUMBER() OVER (PARTITION BY product_id ORDER BY mth) AS rn
  FROM monthly_sales
  WHERE product_id IN (4160, 7790)
    AND mth BETWEEN '2016-01-01' AND '2018-12-01'
)
SELECT product_id,
       mth,
       qty,
       rn,
       qty * rn AS weighted_qty
FROM seq
ORDER BY product_id,
         rn
LIMIT 20;
```
