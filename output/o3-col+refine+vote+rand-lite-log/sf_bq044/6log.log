```sql
--Description: 10) Bring everything together: join CDKN2A-mutated BLCA
--               cases (mutation table) with their clinical data and
--               expression for the four downstream genes (limit 20 rows).
--               Note: assumes the clinical table’s "submitter_id" and the
--               mutation table’s "case_barcode" match exactly; adjust join
--               key if needed in your warehouse.
SELECT
  m."case_barcode"                               AS "patient_id",
  m."Variant_Classification",
  m."Variant_Type",
  c."demo__gender",
  c."demo__vital_status",
  c."demo__days_to_death",
  e."gene_name",
  e."tpm_unstranded",
  e."fpkm_unstranded"
FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"  m
JOIN TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"                      c
     ON m."case_barcode" = c."submitter_id"
JOIN TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39"                   e
     ON e."sample_barcode" LIKE m."case_barcode" || '%'
WHERE m."project_short_name" = 'TCGA-BLCA'
  AND m."Hugo_Symbol" ILIKE '%CDKN2A%'
  AND e."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
LIMIT 20;
```
