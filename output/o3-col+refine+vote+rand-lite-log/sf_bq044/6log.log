Some few-shot examples may be useful:
Query:
--Description: 1) Explore all masked-somatic mutation rows (GDC Release 39) where the
--              gene symbol fuzzy-matches ‘CDKN2A’ (any tumor type, 20 examples)
SELECT
  "project_short_name",
  "Hugo_Symbol",
  "Chromosome",
  "Start_Position",
  "End_Position",
  "Variant_Classification",
  "Variant_Type"
FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"
WHERE "Hugo_Symbol" ILIKE '%CDKN2A%'
LIMIT 20;
Answer:
project_short_name,Hugo_Symbol,Chromosome,Start_Position,End_Position,Variant_Classification,Variant_Type
TCGA-LUAD,CDKN2A,chr9,21971060,21971061,Frame_Shift_Ins,INS
Query:
--Description: 3) Show distinct mutation types (SNP / DEL / INS …) that occur in
--              any project for CDKN2A mutations in the GDC Release-39
--              masked-somatic mutation table (simpler than BLCA-only so rows exist)
SELECT DISTINCT
  "Variant_Type"
FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"
WHERE "Hugo_Symbol" = 'CDKN2A'
LIMIT 20
Answer:
Variant_Type
INS
Query:
--Description: 4) Inspect detailed allele information for the first 20 CDKN2A
--              mutations found across all TCGA projects (no BLCA filter)
SELECT
  "project_short_name",
  "case_barcode",
  "Chromosome",
  "Start_Position",
  "End_Position",
  "Reference_Allele",
  "Tumor_Seq_Allele1",
  "Tumor_Seq_Allele2",
  "Variant_Classification",
  "Variant_Type"
FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"
WHERE "Hugo_Symbol" = 'CDKN2A'
LIMIT 20
Answer:
project_short_name,case_barcode,Chromosome,Start_Position,End_Position,Reference_Allele,Tumor_Seq_Allele1,Tumor_Seq_Allele2,Variant_Classification,Variant_Type
TCGA-LUAD,TCGA-55-1594,chr9,21971060,21971061,-,-,C,Frame_Shift_Ins,INS
Query:
--Description: 5) Pull clinical data (GDC Release-39) for patients who actually
--              possess at least one CDKN2A mutation — this links the mutation
--              table’s case_barcode to the clinical submitter_id
SELECT
  c."submitter_id"          AS "patient_id",
  c."primary_site",
  c."disease_type",
  c."demo__gender",
  c."demo__vital_status",
  c."demo__days_to_death"
FROM TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"                      c
WHERE c."submitter_id" IN (
      SELECT DISTINCT "case_barcode"
      FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"
      WHERE "Hugo_Symbol" = 'CDKN2A')
LIMIT 20
Answer:
patient_id,primary_site,disease_type,demo__gender,demo__vital_status,demo__days_to_death
TCGA-55-1594,Bronchus and lung,Adenomas and Adenocarcinomas,male,Alive,
