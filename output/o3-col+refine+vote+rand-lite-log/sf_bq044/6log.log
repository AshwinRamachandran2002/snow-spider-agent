--Description:  Identify whether any RNA-seq expression samples exist for
--              every case that carries a CDKN2A mutation in the Release-39
--              masked-somatic table.  It does this by looking for rows in
--              the RNA-seq table whose sample_barcode begins with each
--              mutated case_barcode (uses a correlated sub-query).  If this
--              returns zero rows, the absence of expression data explains
--              the failed join in the earlier combined query.
SELECT DISTINCT
  "sample_barcode"
FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39"
WHERE "sample_barcode" LIKE ANY (
      SELECT "case_barcode" || '%'
      FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"
      WHERE "Hugo_Symbol" = 'CDKN2A'
