       MAX(CASE WHEN r."gene_name" = 'CDKN1A' THEN r."tpm_unstranded" END) AS "TPM_CDKN1A",
       MAX(CASE WHEN r."gene_name" = 'CCNE1'  THEN r."tpm_unstranded" END) AS "TPM_CCNE1"
FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39" m
LEFT JOIN TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"                c
       ON m."case_barcode" = c."submitter_id"
LEFT JOIN TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35"             r
