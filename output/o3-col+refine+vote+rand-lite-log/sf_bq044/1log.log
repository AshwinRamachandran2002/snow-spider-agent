```sql
--Description:  Retrieve RNA-seq Release-35 expression values (TPM) for the four
--              downstream genes (MDM2, TP53, CDKN1A, CCNE1) in LUAD, including
--              sample_barcode so we can link back to patients later.
SELECT
       "sample_barcode",
       "project_short_name",
       "gene_name",
       "tpm_unstranded"
FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35"
WHERE "project_short_name" = 'TCGA-LUAD'
  AND "gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
LIMIT 20;
```

```sql
--Description:  Aggregate CDKN2A mutation data (from Release-39), clinical
--              attributes, and RNA-seq TPM values (from Release-35) for LUAD
--              patients.  Each patient appears once with TPM values for the
--              four downstream genes in separate columns.
SELECT m."case_barcode",
       m."Variant_Classification",
       m."Variant_Type",
       c."demo__gender",
       c."demo__vital_status",
       c."demo__days_to_death",
       MAX(CASE WHEN r."gene_name" = 'MDM2'   THEN r."tpm_unstranded" END) AS "TPM_MDM2",
       MAX(CASE WHEN r."gene_name" = 'TP53'   THEN r."tpm_unstranded" END) AS "TPM_TP53",
       MAX(CASE WHEN r."gene_name" = 'CDKN1A' THEN r."tpm_unstranded" END) AS "TPM_CDKN1A",
       MAX(CASE WHEN r."gene_name" = 'CCNE1'  THEN r."tpm_unstranded" END) AS "TPM_CCNE1"
FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39" m
LEFT JOIN TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"                c
       ON m."case_barcode" = c."submitter_id"
LEFT JOIN TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35"             r
       ON r."sample_barcode" ILIKE m."case_barcode" || '%'
WHERE m."project_short_name" = 'TCGA-LUAD'
  AND m."Hugo_Symbol" ILIKE '%CDKN2A%'
  AND r."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
GROUP BY m."case_barcode",
         m."Variant_Classification",
         m."Variant_Type",
         c."demo__gender",
         c."demo__vital_status",
         c."demo__days_to_death"
LIMIT 20;
```

