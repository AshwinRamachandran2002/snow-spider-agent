```sql
/*  Description
    ===========
    • Find BLCA (bladder-cancer) patients who carry a CDKN2A mutation
      (masked somatic-mutation table – GDC Release-39).

    • Summarise the distinct mutation “types” (Variant_Type) and
      “classifications” (Variant_Classification) observed per patient.

    • Add clinical information (gender, vital-status, days-to-death)
      from the matching Release-39 clinical table.

    • Retrieve RNA-seq TPM expression values (Release-35) for the four
      downstream genes MDM2, TP53, CDKN1A, and CCNE1, pivoting them into
      individual columns.

    • One row per patient.
*/
WITH cdkn2a_mut AS (          -- 1) BLCA patients mutated in CDKN2A
    SELECT
        "case_barcode",
        LISTAGG(DISTINCT "Variant_Type", ', ')
            WITHIN GROUP (ORDER BY "Variant_Type")           AS "variant_types",
        LISTAGG(DISTINCT "Variant_Classification", ', ')
            WITHIN GROUP (ORDER BY "Variant_Classification") AS "variant_classifications"
    FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"
    WHERE "project_short_name" = 'TCGA-BLCA'
      AND  "Hugo_Symbol"       = 'CDKN2A'
    GROUP BY "case_barcode"
),

clinical AS (                 -- 2) Release-39 clinical attributes
    SELECT
        "submitter_id"        AS "case_barcode",
        "demo__gender",
        "demo__vital_status",
        "demo__days_to_death"
    FROM TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"
),

rna AS (                       -- 3) TPM expression for four downstream genes
    SELECT
        SUBSTR("sample_barcode", 1, 12) AS "case_barcode",
        "gene_name",
        "tpm_unstranded"
    FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35"
    WHERE "project_short_name" = 'TCGA-BLCA'
      AND "gene_name" IN ('MDM2', 'TP53', 'CDKN1A', 'CCNE1')
)

-- 4) Assemble final report
SELECT
    m."case_barcode",
    m."variant_types",
    m."variant_classifications",
    c."demo__gender"        AS "gender",
    c."demo__vital_status"  AS "vital_status",
    c."demo__days_to_death" AS "days_to_death",
    MAX(CASE WHEN r."gene_name" = 'MDM2'   THEN r."tpm_unstranded" END) AS "MDM2_TPM",
    MAX(CASE WHEN r."gene_name" = 'TP53'   THEN r."tpm_unstranded" END) AS "TP53_TPM",
    MAX(CASE WHEN r."gene_name" = 'CDKN1A' THEN r."tpm_unstranded" END) AS "CDKN1A_TPM",
    MAX(CASE WHEN r."gene_name" = 'CCNE1'  THEN r."tpm_unstranded" END) AS "CCNE1_TPM"
FROM cdkn2a_mut m
LEFT JOIN clinical c ON m."case_barcode" = c."case_barcode"
LEFT JOIN rna      r ON m."case_barcode" = r."case_barcode"
GROUP BY
    m."case_barcode",
    m."variant_types",
    m."variant_classifications",
    c."demo__gender",
    c."demo__vital_status",
    c."demo__days_to_death"
ORDER BY m."case_barcode";
```
