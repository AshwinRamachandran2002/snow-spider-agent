Query:
--Description: Produce side-by-side comparison of Amsterdam vs. Rotterdam road lengths  
WITH ams AS (  
    SELECT "CLASS", "SUBCLASS", SUM("LENGTH_M"::FLOAT) AS "AMS_LEN_M"  
    FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"  
    WHERE "QUADKEY" ILIKE '12020210%'  
    GROUP BY "CLASS", "SUBCLASS"  
),  
rot AS (  
    SELECT "CLASS", "SUBCLASS", SUM("LENGTH_M"::FLOAT) AS "RTM_LEN_M"  
    FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"  
    WHERE "QUADKEY" ILIKE '12020211%'  
    GROUP BY "CLASS", "SUBCLASS"  
)  
SELECT COALESCE(ams."CLASS", rot."CLASS")             AS "CLASS",  
       COALESCE(ams."SUBCLASS", rot."SUBCLASS")       AS "SUBCLASS",  
       ams."AMS_LEN_M",  
       rot."RTM_LEN_M"  
FROM ams  
FULL OUTER JOIN rot  
      ON ams."CLASS" = rot."CLASS" AND ams."SUBCLASS" = rot."SUBCLASS"  
ORDER BY "CLASS", "SUBCLASS"  
LIMIT 20;
