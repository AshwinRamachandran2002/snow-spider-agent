Query:
--Description: Basic count of road records for each segment to understand data volume  
SELECT  
       CASE WHEN "QUADKEY" ILIKE '12020210%' THEN 'Amsterdam_segment'  
            WHEN "QUADKEY" ILIKE '12020211%' THEN 'Rotterdam_segment'  
       END                                             AS "AREA_SEGMENT",  
       COUNT(*)                                        AS "ROAD_RECORDS_CNT"  
