```sql
--Description: Aggregate Amsterdam-segment total road length (meters) by class & subclass  
SELECT  
       "CLASS",  
       "SUBCLASS",  
       SUM("LENGTH_M"::FLOAT) AS "AMSTERDAM_TOTAL_LEN_M"  
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"  
WHERE "QUADKEY" ILIKE '12020210%'  
GROUP BY "CLASS", "SUBCLASS"  
ORDER BY "AMSTERDAM_TOTAL_LEN_M" DESC  
LIMIT 20;
```

```sql
--Description: Aggregate Rotterdam-segment total road length (meters) by class & subclass  
SELECT  
       "CLASS",  
       "SUBCLASS",  
       SUM("LENGTH_M"::FLOAT) AS "ROTTERDAM_TOTAL_LEN_M"  
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"  
WHERE "QUADKEY" ILIKE '12020211%'  
GROUP BY "CLASS", "SUBCLASS"  
ORDER BY "ROTTERDAM_TOTAL_LEN_M" DESC  
LIMIT 20;
```

```sql
--Description: Produce side-by-side comparison of Amsterdam vs. Rotterdam road lengths  
WITH ams AS (  
    SELECT "CLASS", "SUBCLASS", SUM("LENGTH_M"::FLOAT) AS "AMS_LEN_M"  
    FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"  
    WHERE "QUADKEY" ILIKE '12020210%'  
    GROUP BY "CLASS", "SUBCLASS"  
),  
rot AS (  
    SELECT "CLASS", "SUBCLASS", SUM("LENGTH_M"::FLOAT) AS "RTM_LEN_M"  
    FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"  
    WHERE "QUADKEY" ILIKE '12020211%'  
    GROUP BY "CLASS", "SUBCLASS"  
)  
SELECT COALESCE(ams."CLASS", rot."CLASS")             AS "CLASS",  
       COALESCE(ams."SUBCLASS", rot."SUBCLASS")       AS "SUBCLASS",  
       ams."AMS_LEN_M",  
       rot."RTM_LEN_M"  
FROM ams  
FULL OUTER JOIN rot  
      ON ams."CLASS" = rot."CLASS" AND ams."SUBCLASS" = rot."SUBCLASS"  
ORDER BY "CLASS", "SUBCLASS"  
LIMIT 20;
```

```sql
--Description: Check for any non-numeric LENGTH_M values that might cause casting errors (Amsterdam segment)  
SELECT DISTINCT "LENGTH_M"  
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"  
WHERE "QUADKEY" ILIKE '12020210%'  
  AND TRY_TO_NUMBER("LENGTH_M") IS NULL  
LIMIT 20;
```

```sql
--Description: Basic count of road records for each segment to understand data volume  
SELECT  
       CASE WHEN "QUADKEY" ILIKE '12020210%' THEN 'Amsterdam_segment'  
            WHEN "QUADKEY" ILIKE '12020211%' THEN 'Rotterdam_segment'  
       END                                             AS "AREA_SEGMENT",  
       COUNT(*)                                        AS "ROAD_RECORDS_CNT"  
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"  
WHERE "QUADKEY" ILIKE '12020210%'  
   OR "QUADKEY" ILIKE '12020211%'  
GROUP BY "AREA_SEGMENT"  
LIMIT 20;
```

```sql
--Description: Explore any remaining road records whose quadkeys only partially match the two segments (sanity-check)  
SELECT DISTINCT "QUADKEY"  
FROM "NETHERLANDS_OPEN_MAP_DATA"."NETHERLANDS"."V_ROAD"  
WHERE "QUADKEY" LIKE '1202021%'  
  AND "QUADKEY" NOT ILIKE '12020210%'  
  AND "QUADKEY" NOT ILIKE '12020211%'  
LIMIT 20;
```
