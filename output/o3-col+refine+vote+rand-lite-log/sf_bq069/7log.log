-- Description: Preview up to 20 non-NLST CT instances to become familiar with key attributes  
SELECT 
  "PatientID",
  "StudyInstanceUID",
  "SeriesInstanceUID",
  "SeriesNumber",
  "InstanceNumber",
  "Modality",
  "TransferSyntaxUID",
  "ImageType",
  "ImageOrientationPatient",
  "ImagePositionPatient",
  "PixelSpacing"
FROM "IDC"."IDC_V17"."DICOM_ALL"
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
LIMIT 20;
