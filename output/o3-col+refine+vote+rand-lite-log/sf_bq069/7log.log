Query:
-- Description: Inspect individual ImageType components to spot localizer-related strings  
SELECT DISTINCT 
  f.value::STRING AS "ImageType_Component"
FROM "IDC"."IDC_V17"."DICOM_ALL" t,
     LATERAL FLATTEN(input => t."ImageType") f
WHERE t."Modality" = 'CT'
  AND t."collection_name" <> 'NLST'
LIMIT 20;
