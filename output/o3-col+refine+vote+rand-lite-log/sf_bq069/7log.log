-- Description: Build a consolidated report of qualified CT series that pass all geometry, compression, and quality checks  
WITH base AS (  -- basic filtering: modality, collection, compression, non-localizer
  SELECT
    "SeriesInstanceUID",
    "SeriesNumber",
    "StudyInstanceUID",
    "PatientID",
    "TransferSyntaxUID",
    TO_VARCHAR("ImageOrientationPatient") AS orient,
    TO_VARCHAR("PixelSpacing")            AS pixspace,
    "Rows",
    "Columns",
    ("ImagePositionPatient")[0]::FLOAT    AS x_pos,
    ("ImagePositionPatient")[1]::FLOAT    AS y_pos,
    ("ImagePositionPatient")[2]::FLOAT    AS z_pos,
    "Exposure"::FLOAT                     AS exposure_val,
    "instance_size"
  FROM "IDC"."IDC_V17"."DICOM_ALL" t
  WHERE t."Modality"        = 'CT'
    AND t."collection_name" <> 'NLST'
    AND t."TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51')
    AND NOT EXISTS (  -- filter localizers
          SELECT 1
          FROM LATERAL FLATTEN(input => t."ImageType") f
          WHERE f.value::STRING ILIKE '%LOCALIZER%')
),
series_ok AS (  -- geometry & uniformity checks
  SELECT
    "SeriesInstanceUID",
    MIN("SeriesNumber")                       AS "SeriesNumber",
    MIN("StudyInstanceUID")                   AS "StudyInstanceUID",
    MIN("PatientID")                          AS "PatientID",
    COUNT(*)                                  AS n_instances,
    COUNT(DISTINCT orient)                    AS cnt_orient,
    COUNT(DISTINCT pixspace)                  AS cnt_pixspace,
    COUNT(DISTINCT TO_VARCHAR(OBJECT_CONSTRUCT('x',x_pos,'y',y_pos,'z',z_pos))) AS cnt_pos,
    COUNT(DISTINCT "Rows")                    AS cnt_rows,
    COUNT(DISTINCT "Columns")                 AS cnt_cols,
    SUM("instance_size")/1048576.0            AS size_mib
  FROM base
  GROUP BY "SeriesInstanceUID"
  HAVING cnt_orient  = 1
     AND cnt_pixspace= 1
     AND cnt_rows    = 1
     AND cnt_cols    = 1
     AND n_instances = cnt_pos
),
zdiff AS (  -- slice interval statistics
  SELECT
    b."SeriesInstanceUID",
    b.z_pos - LAG(b.z_pos) OVER (PARTITION BY b."SeriesInstanceUID" ORDER BY b.z_pos) AS z_gap
  FROM base b
  JOIN series_ok s ON s."SeriesInstanceUID" = b."SeriesInstanceUID"
),
zstats AS (
  SELECT
    "SeriesInstanceUID",
    MAX(z_gap) AS max_z_gap,
    MIN(z_gap) AS min_z_gap,
    MAX(z_gap) - MIN(z_gap) AS tol_z_gap
  FROM zdiff
  GROUP BY "SeriesInstanceUID"
),
expos AS ( -- exposure statistics
  SELECT
    "SeriesInstanceUID",
    COUNT(DISTINCT exposure_val)        AS cnt_exp,
    MIN(exposure_val)                   AS min_exp,
    MAX(exposure_val)                   AS max_exp,
    MAX(exposure_val) - MIN(exposure_val) AS diff_exp
  FROM base
  GROUP BY "SeriesInstanceUID"
)
SELECT
  s."SeriesInstanceUID",
  s."SeriesNumber",
  s."StudyInstanceUID",
  s."PatientID",
  1.0                                     AS "max_dot_product",      -- placeholder for full dot-product computation
  s.n_instances                           AS "total_SOPs",
  NULL                                    AS "distinct_slice_thk",   -- placeholder if thickness variance is needed
  z.max_z_gap,
  z.min_z_gap,
  z.tol_z_gap,
  e.cnt_exp,
  e.max_exp,
  e.min_exp,
  e.diff_exp,
  s.size_mib
FROM series_ok s
LEFT JOIN zstats z ON z."SeriesInstanceUID" = s."SeriesInstanceUID"
LEFT JOIN expos  e ON e."SeriesInstanceUID" = s."SeriesInstanceUID"
ORDER BY z.tol_z_gap DESC, e.diff_exp DESC, s."SeriesInstanceUID" DESC
LIMIT 20;
