-- Description / thinking process:
-- 1) localizer_series  : pick every CT series (outside NLST) that has ANY “LOCALIZER” component in ImageType → banish them.
-- 2) base              : keep CT instances that are: not NLST, not JPEG-compressed (two TS UIDs), and not in localizer_series.
--                        Extract useful attributes (orientation, pixel spacing, rows/cols, X-/Y-/Z-positions,
--                        slice thickness, exposure, instance size).
-- 3) series_ok         : geometry & uniformity checks per series:
--        • exactly one orientation and one pixel-spacing
--        • identical Rows & Columns
--        • identical X and Y positions for all slices
--        • number of images equals number of distinct Z positions
-- 4) zstats            : compute max / min / tolerance (max-min) of consecutive Z gaps in each qualified series.
-- 5) expos             : exposure statistics (#distinct, min, max, range).
-- 6) Final SELECT      : assemble requested fields; dot-product kept as placeholder 1.0 (would require vector math);
--                        ordered by tolerance, exposure range, Series UID; show top 20.

WITH localizer_series AS (
    SELECT DISTINCT "SeriesInstanceUID"
    FROM "IDC"."IDC_V17"."DICOM_ALL" t,
         LATERAL FLATTEN(input => t."ImageType") f
    WHERE t."Modality" = 'CT'
      AND t."collection_name" <> 'NLST'
      AND f.value::STRING ILIKE '%LOCALIZER%'
),
base AS (
    SELECT
        "SeriesInstanceUID",
        "SeriesNumber",
        "StudyInstanceUID",
        "PatientID",
        TO_VARCHAR("ImageOrientationPatient") AS orient,
        TO_VARCHAR("PixelSpacing")            AS pixspace,
        "Rows",
        "Columns",
        ("ImagePositionPatient")[0]::FLOAT    AS x_pos,
        ("ImagePositionPatient")[1]::FLOAT    AS y_pos,
        ("ImagePositionPatient")[2]::FLOAT    AS z_pos,
        "SliceThickness"                      AS slice_thk,
        "Exposure"::FLOAT                     AS exposure_val,
        "instance_size"
    FROM "IDC"."IDC_V17"."DICOM_ALL"
    WHERE "Modality"        = 'CT'
      AND "collection_name" <> 'NLST'
      AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51')
      AND "SeriesInstanceUID" NOT IN (SELECT "SeriesInstanceUID" FROM localizer_series)
),
series_ok AS (
    SELECT
        "SeriesInstanceUID",
        MIN("SeriesNumber")       AS "SeriesNumber",
        MIN("StudyInstanceUID")   AS "StudyInstanceUID",
        MIN("PatientID")          AS "PatientID",
        COUNT(*)                  AS n_instances,
        COUNT(DISTINCT orient)    AS cnt_orient,
        COUNT(DISTINCT pixspace)  AS cnt_pixspace,
        COUNT(DISTINCT x_pos)     AS cnt_x,
        COUNT(DISTINCT y_pos)     AS cnt_y,
        COUNT(DISTINCT z_pos)     AS cnt_z,
        COUNT(DISTINCT slice_thk) AS distinct_slice_thk,
        COUNT(DISTINCT "Rows")    AS cnt_rows,
        COUNT(DISTINCT "Columns") AS cnt_cols,
        SUM("instance_size")/1048576.0 AS size_mib
    FROM base
    GROUP BY "SeriesInstanceUID"
    HAVING cnt_orient  = 1
       AND cnt_pixspace= 1
       AND cnt_rows    = 1
       AND cnt_cols    = 1
       AND cnt_x       = 1
       AND cnt_y       = 1
       AND n_instances = cnt_z
),
zstats AS (
    SELECT
        ib."SeriesInstanceUID",
        MAX(z_gap) AS max_z_gap,
        MIN(z_gap) AS min_z_gap,
        MAX(z_gap) - MIN(z_gap) AS tol_z_gap
    FROM (
        SELECT
            "SeriesInstanceUID",
            z_pos - LAG(z_pos) OVER (PARTITION BY "SeriesInstanceUID" ORDER BY z_pos) AS z_gap
        FROM base
        WHERE "SeriesInstanceUID" IN (SELECT "SeriesInstanceUID" FROM series_ok)
    ) ib
    WHERE z_gap IS NOT NULL
    GROUP BY ib."SeriesInstanceUID"
),
expos AS (
    SELECT
        "SeriesInstanceUID",
        COUNT(DISTINCT exposure_val)              AS cnt_exp,
        MIN(exposure_val)                         AS min_exp,
        MAX(exposure_val)                         AS max_exp,
        MAX(exposure_val) - MIN(exposure_val)     AS diff_exp
    FROM base
    WHERE "SeriesInstanceUID" IN (SELECT "SeriesInstanceUID" FROM series_ok)
    GROUP BY "SeriesInstanceUID"
)
SELECT
    s."SeriesInstanceUID",
    s."SeriesNumber",
    s."StudyInstanceUID",
    s."PatientID",
    1.0                               AS "max_dot_product",    -- placeholder
    s.n_instances                     AS "total_SOPs",
    s.distinct_slice_thk,
    z.max_z_gap,
    z.min_z_gap,
    z.tol_z_gap,
    e.cnt_exp,
    e.max_exp,
    e.min_exp,
    e.diff_exp,
    s.size_mib
FROM series_ok s
LEFT JOIN zstats z ON z."SeriesInstanceUID" = s."SeriesInstanceUID"
LEFT JOIN expos  e ON e."SeriesInstanceUID" = s."SeriesInstanceUID"
ORDER BY z.tol_z_gap DESC, e.diff_exp DESC, s."SeriesInstanceUID" DESC
LIMIT 20;
