-- Description: List series having exactly one orientation and one pixel-spacing value  
SELECT 
  "SeriesInstanceUID",
  COUNT(DISTINCT TO_VARCHAR("ImageOrientationPatient")) AS "cnt_orientation",
  COUNT(DISTINCT TO_VARCHAR("PixelSpacing"))           AS "cnt_pixelspacing"
FROM "IDC"."IDC_V17"."DICOM_ALL"
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
GROUP BY "SeriesInstanceUID"
HAVING COUNT(DISTINCT TO_VARCHAR("ImageOrientationPatient")) = 1
   AND COUNT(DISTINCT TO_VARCHAR("PixelSpacing"))     = 1
LIMIT 20;
