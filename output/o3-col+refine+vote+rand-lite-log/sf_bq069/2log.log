```sql
--Description: 1)  List distinct TransferSyntaxUID values for CT images that are **not** in the NLST collection.  
SELECT DISTINCT "TransferSyntaxUID"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
LIMIT 20;
```

```sql
--Description: 2)  Sample CT instances (excluding NLST, JPEG–compressed, Localizer) to check key columns.  
SELECT *
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
  AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70','1.2.840.10008.1.2.4.51')
  AND "ImageType" NOT ILIKE '%LOCALIZER%'
LIMIT 20;
```

```sql
--Description: 3)  Find series that have more than one distinct ImageOrientationPatient value (geometry-quality check).  
SELECT "SeriesInstanceUID",
       COUNT(DISTINCT TO_VARCHAR("ImageOrientationPatient")) AS "orientations_count",
       COUNT(*)                                           AS "instances"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
GROUP BY "SeriesInstanceUID"
HAVING COUNT(DISTINCT TO_VARCHAR("ImageOrientationPatient")) > 1
LIMIT 20;
```

```sql
--Description: 4)  Calculate the absolute dot product (k-component) between orientation vectors’ cross-product and [0,0,1]  
--               for a quick look at geometric alignment.  
SELECT 
  "SOPInstanceUID",
  ("ImageOrientationPatient")[0]::FLOAT AS i0,
  ("ImageOrientationPatient")[1]::FLOAT AS i1,
  ("ImageOrientationPatient")[2]::FLOAT AS i2,
  ("ImageOrientationPatient")[3]::FLOAT AS i3,
  ("ImageOrientationPatient")[4]::FLOAT AS i4,
  ("ImageOrientationPatient")[5]::FLOAT AS i5,
  ABS( (("ImageOrientationPatient")[0]::FLOAT)* (("ImageOrientationPatient")[4]::FLOAT)
     - (("ImageOrientationPatient")[1]::FLOAT)* (("ImageOrientationPatient")[3]::FLOAT)) 
     AS dot_with_k
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
  AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70','1.2.840.10008.1.2.4.51')
  AND "ImageType" NOT ILIKE '%LOCALIZER%'
LIMIT 20;
```

```sql
--Description: 5)  Detect series whose instances do **not** have uniform Rows / Columns (should be 1 distinct value each).  
SELECT "SeriesInstanceUID",
       COUNT(DISTINCT "Rows")    AS distinct_rows,
       COUNT(DISTINCT "Columns") AS distinct_cols,
       COUNT(*)                  AS instances
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
GROUP BY "SeriesInstanceUID"
HAVING (COUNT(DISTINCT "Rows") > 1 OR COUNT(DISTINCT "Columns") > 1)
LIMIT 20;
```

```sql
--Description: 6)  Compare number of SOP instances vs. number of distinct ImagePositionPatient values per series.  
SELECT "SeriesInstanceUID",
       COUNT(*)                                           AS instances,
       COUNT(DISTINCT TO_VARCHAR("ImagePositionPatient")) AS distinct_positions
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
GROUP BY "SeriesInstanceUID"
HAVING instances <> distinct_positions
LIMIT 20;
```

```sql
--Description: 7)  Show Z-position differences inside one sample series (first non-NLST CT series found).  
WITH one_series AS (
  SELECT "SeriesInstanceUID"
  FROM IDC.IDC_V17.DICOM_ALL
  WHERE "Modality" = 'CT'
    AND "collection_name" <> 'NLST'
  LIMIT 1
)
SELECT 
  d."SeriesInstanceUID",
  d."SOPInstanceUID",
  ("ImagePositionPatient")[2]::FLOAT                                              AS z_pos,
  LAG(("ImagePositionPatient")[2]::FLOAT) OVER (PARTITION BY d."SeriesInstanceUID" 
                                                ORDER BY ("ImagePositionPatient")[2]::FLOAT) AS prev_z,
  ("ImagePositionPatient")[2]::FLOAT
    - LAG(("ImagePositionPatient")[2]::FLOAT) OVER (PARTITION BY d."SeriesInstanceUID" 
                                                   ORDER BY ("ImagePositionPatient")[2]::FLOAT) AS z_diff
FROM IDC.IDC_V17.DICOM_ALL d
JOIN one_series s ON s."SeriesInstanceUID" = d."SeriesInstanceUID"
ORDER BY z_pos
LIMIT 20;
```

```sql
--Description: 8)  Series having more than one distinct Exposure value (range, max & min).  
SELECT "SeriesInstanceUID",
       COUNT(DISTINCT "Exposure")                  AS distinct_exposure_vals,
       MAX(TRY_TO_NUMBER("Exposure"))              AS max_exposure,
       MIN(TRY_TO_NUMBER("Exposure"))              AS min_exposure
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
GROUP BY "SeriesInstanceUID"
HAVING COUNT(DISTINCT "Exposure") > 1
LIMIT 20;
```

```sql
--Description: 9)  Total series size (MiB) for CT series outside NLST (quick volume check).  
SELECT "SeriesInstanceUID",
       SUM("instance_size")/1048576.0 AS size_mib,
       COUNT(*)                       AS instances
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 10)  Aggregated report combining all requested metrics for qualified CT series  
--                (geometry, compression, localizer, dot-product check, etc.).  
WITH base AS (  -- basic filtering
  SELECT *
  FROM IDC.IDC_V17.DICOM_ALL
  WHERE "Modality"='CT'
    AND "collection_name" <> 'NLST'
    AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70','1.2.840.10008.1.2.4.51')
    AND "ImageType" NOT ILIKE '%LOCALIZER%'
),
series_geom AS (  -- geometric and uniformity checks
  SELECT
    "SeriesInstanceUID",
    "SeriesNumber",
    "StudyInstanceUID",
    "PatientID",
    MAX(ABS((("ImageOrientationPatient")[0]::FLOAT)* (("ImageOrientationPatient")[4]::FLOAT)
             - (("ImageOrientationPatient")[1]::FLOAT)* (("ImageOrientationPatient")[3]::FLOAT)))   AS dot_k_max,
    COUNT(*)                                           AS sop_instances,
    COUNT(DISTINCT TO_VARCHAR("SliceThickness"))       AS slice_thick_vals,
    COUNT(DISTINCT TO_VARCHAR("ImageOrientationPatient")) AS orient_vals,
    COUNT(DISTINCT TO_VARCHAR("PixelSpacing"))         AS px_space_vals,
    COUNT(DISTINCT "Rows")                             AS rows_vals,
    COUNT(DISTINCT "Columns")                          AS cols_vals
  FROM base
  GROUP BY "SeriesInstanceUID","SeriesNumber","StudyInstanceUID","PatientID"
  HAVING orient_vals = 1      -- all instances share same orientation
     AND px_space_vals = 1    -- identical pixel spacing
     AND rows_vals     = 1    -- identical rows
     AND cols_vals     = 1    -- identical columns
),
slice_diff AS (  -- collect Z positions
  SELECT
    b."SeriesInstanceUID",
    ("ImagePositionPatient")[2]::FLOAT AS z_pos
  FROM base b
  JOIN series_geom g USING ("SeriesInstanceUID")
),
diffs AS (   -- max / min Z-interval & tolerance
  SELECT
    "SeriesInstanceUID",
    MAX(z_diff) AS diff_max,
    MIN(z_diff) AS diff_min,
    MAX(z_diff)-MIN(z_diff) AS diff_tol
  FROM (
    SELECT 
      "SeriesInstanceUID",
      z_pos,
      z_pos - LAG(z_pos) OVER (PARTITION BY "SeriesInstanceUID" ORDER BY z_pos) AS z_diff
    FROM slice_diff
  ) t
  GROUP BY "SeriesInstanceUID"
),
exposure AS (  -- exposure stats
  SELECT
    "SeriesInstanceUID",
    COUNT(DISTINCT "Exposure")          AS exposure_distinct,
    MAX(TRY_TO_NUMBER("Exposure"))      AS exposure_max,
    MIN(TRY_TO_NUMBER("Exposure"))      AS exposure_min,
    MAX(TRY_TO_NUMBER("Exposure")) - MIN(TRY_TO_NUMBER("Exposure")) AS exposure_range
  FROM base
  GROUP BY "SeriesInstanceUID"
),
size_series AS ( -- total series size
  SELECT "SeriesInstanceUID", SUM("instance_size")/1048576.0 AS size_mib
  FROM base
  GROUP BY "SeriesInstanceUID"
)
SELECT
  g."SeriesInstanceUID",
  g."SeriesNumber",
  g."StudyInstanceUID",
  g."PatientID",
  g.dot_k_max,
  g.sop_instances,
  g.slice_thick_vals,
  d.diff_max,
  d.diff_min,
  d.diff_tol,
  e.exposure_distinct,
  e.exposure_max,
  e.exposure_min,
  e.exposure_range,
  s.size_mib
FROM series_geom g
LEFT JOIN diffs      d USING ("SeriesInstanceUID")
LEFT JOIN exposure   e USING ("SeriesInstanceUID")
LEFT JOIN size_series s USING ("SeriesInstanceUID")
ORDER BY d.diff_tol        DESC NULLS LAST,
         e.exposure_range  DESC NULLS LAST,
         g."SeriesInstanceUID" DESC
LIMIT 20;
```

