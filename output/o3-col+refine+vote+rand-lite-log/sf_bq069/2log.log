Query:
--Description: 4)  Calculate the absolute dot product (k-component) between orientation vectors’ cross-product and [0,0,1]  
--               for a quick look at geometric alignment.  
SELECT 
  "SOPInstanceUID",
  ("ImageOrientationPatient")[0]::FLOAT AS i0,
  ("ImageOrientationPatient")[1]::FLOAT AS i1,
  ("ImageOrientationPatient")[2]::FLOAT AS i2,
  ("ImageOrientationPatient")[3]::FLOAT AS i3,
  ("ImageOrientationPatient")[4]::FLOAT AS i4,
  ("ImageOrientationPatient")[5]::FLOAT AS i5,
  ABS( (("ImageOrientationPatient")[0]::FLOAT)* (("ImageOrientationPatient")[4]::FLOAT)
     - (("ImageOrientationPatient")[1]::FLOAT)* (("ImageOrientationPatient")[3]::FLOAT)) 
     AS dot_with_k
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
  AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70','1.2.840.10008.1.2.4.51')
  AND "ImageType" NOT ILIKE '%LOCALIZER%'
LIMIT 20;
