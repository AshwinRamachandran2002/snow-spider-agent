Query:
--Description: 3)  Find series that have more than one distinct ImageOrientationPatient value (geometry-quality check).  
SELECT "SeriesInstanceUID",
       COUNT(DISTINCT TO_VARCHAR("ImageOrientationPatient")) AS "orientations_count",
       COUNT(*)                                           AS "instances"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
GROUP BY "SeriesInstanceUID"
HAVING COUNT(DISTINCT TO_VARCHAR("ImageOrientationPatient")) > 1
LIMIT 20;
