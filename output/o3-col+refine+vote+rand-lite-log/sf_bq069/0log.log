```sql
--Description: 01) List the distinct imaging modalities present in the DICOM_ALL table (sample 20).
SELECT DISTINCT 
       "Modality"
FROM   IDC.IDC_V17.DICOM_ALL
LIMIT 20;
```

```sql
--Description: 02) Show the 20 most-common transfer syntaxes used for CT images that are NOT from the NLST collection.
SELECT DISTINCT 
       "TransferSyntaxUID"
FROM   IDC.IDC_V17.DICOM_ALL
WHERE  "Modality" = 'CT'
  AND  "collection_name" <> 'NLST'
LIMIT 20;
```

```sql
--Description: 03) Check whether any non-NLST CT series contain the string LOCALIZER in their ImageType.
SELECT DISTINCT 
       "SeriesInstanceUID",
       "ImageType"
FROM   IDC.IDC_V17.DICOM_ALL
WHERE  "Modality" = 'CT'
  AND  "collection_name" <> 'NLST'
  AND  "ImageType" ILIKE '%LOCALIZER%'
LIMIT 20;
```

```sql
--Description: 04) Grab 20 example rows of non-NLST CT instances that are *not* JPEG-compressed (skip the two unwanted syntaxes).
SELECT  
       "PatientID",
       "StudyInstanceUID",
       "SeriesInstanceUID",
       "SOPInstanceUID",
       "TransferSyntaxUID",
       "ImageType",
       "InstanceNumber",
       "Rows",
       "Columns"
FROM   IDC.IDC_V17.DICOM_ALL
WHERE  "Modality" = 'CT'
  AND  "collection_name" <> 'NLST'
  AND  "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51')
LIMIT 20;
```

```sql
--Description: 05) Count how many instances each non-NLST CT series has (after removing JPEG-compressed and localizer images).
SELECT  "SeriesInstanceUID",
        COUNT(*)               AS "num_instances"
FROM    IDC.IDC_V17.DICOM_ALL
WHERE   "Modality" = 'CT'
  AND   "collection_name" <> 'NLST'
  AND   "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51')
  AND   "ImageType" NOT ILIKE '%LOCALIZER%'
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 06) For each qualified series, see if all instances share exactly one unique ImageOrientationPatient value.
SELECT  "SeriesInstanceUID",
        COUNT(DISTINCT "ImageOrientationPatient"::STRING) AS "orientation_variants"
FROM    IDC.IDC_V17.DICOM_ALL
WHERE   "Modality" = 'CT'
  AND   "collection_name" <> 'NLST'
  AND   "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51')
  AND   "ImageType" NOT ILIKE '%LOCALIZER%'
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 07) Verify that every instance in a series has the same pixel spacing (after casting VARIANT to STRING).
SELECT  "SeriesInstanceUID",
        COUNT(DISTINCT "PixelSpacing"::STRING) AS "pixel_spacing_variants"
FROM    IDC.IDC_V17.DICOM_ALL
WHERE   "Modality" = 'CT'
  AND   "collection_name" <> 'NLST'
  AND   "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51')
  AND   "ImageType" NOT ILIKE '%LOCALIZER%'
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 08) Compare number of distinct ImagePositionPatient values with number of SOP instances per series.
SELECT  "SeriesInstanceUID",
        COUNT(*)                                           AS "total_instances",
        COUNT(DISTINCT "ImagePositionPatient"::STRING)     AS "unique_positions"
FROM    IDC.IDC_V17.DICOM_ALL
WHERE   "Modality" = 'CT'
  AND   "collection_name" <> 'NLST'
  AND   "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51')
  AND   "ImageType" NOT ILIKE '%LOCALIZER%'
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 09) Ensure every instance in a series shares identical Rows & Columns (pixel matrix size).
SELECT  "SeriesInstanceUID",
        COUNT(DISTINCT "Rows")    AS "row_variants",
        COUNT(DISTINCT "Columns") AS "col_variants"
FROM    IDC.IDC_V17.DICOM_ALL
WHERE   "Modality" = 'CT'
  AND   "collection_name" <> 'NLST'
  AND   "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51')
  AND   "ImageType" NOT ILIKE '%LOCALIZER%'
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 10) Examine exposure statistics (min, max, count distinct) for each qualified CT series.
SELECT  "SeriesInstanceUID",
        COUNT(DISTINCT "Exposure")              AS "distinct_exposures",
        MIN(TRY_TO_NUMBER("Exposure"))          AS "min_exposure",
        MAX(TRY_TO_NUMBER("Exposure"))          AS "max_exposure"
FROM    IDC.IDC_V17.DICOM_ALL
WHERE   "Modality" = 'CT'
  AND   "collection_name" <> 'NLST'
  AND   "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51')
  AND   "ImageType" NOT ILIKE '%LOCALIZER%'
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```

