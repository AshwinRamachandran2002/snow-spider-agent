```sql
--Description: 8) Compute the absolute dot product (|cz|) between cross-product of orientation vectors and [0,0,1] for a sample of series
WITH orient AS (
  SELECT
    "SeriesInstanceUID",
    "ImageOrientationPatient"[0]::FLOAT AS o0,
    "ImageOrientationPatient"[1]::FLOAT AS o1,
    "ImageOrientationPatient"[2]::FLOAT AS o2,
    "ImageOrientationPatient"[3]::FLOAT AS o3,
    "ImageOrientationPatient"[4]::FLOAT AS o4,
    "ImageOrientationPatient"[5]::FLOAT AS o5,
    ROW_NUMBER() OVER (PARTITION BY "SeriesInstanceUID") AS rn
  FROM "IDC"."IDC_V17"."DICOM_ALL"
  WHERE "Modality" = 'CT'
    AND "collection_name" <> 'NLST'
)
SELECT
  "SeriesInstanceUID",
  ABS( (o0 * o4) - (o1 * o3) ) AS "abs_dot_cz"
FROM orient
WHERE rn = 1           -- only need one instance per series (orientation already identical)
LIMIT 20;
```

```sql
--Description: 9) Examine min & max slice-to-slice z-spacing within each series
WITH pos AS (
  SELECT
    "SeriesInstanceUID",
    "ImagePositionPatient"[2]::FLOAT                     AS z,
    ROW_NUMBER() OVER (PARTITION BY "SeriesInstanceUID"
                       ORDER BY "ImagePositionPatient"[2]::FLOAT) AS rn
  FROM "IDC"."IDC_V17"."DICOM_ALL"
  WHERE "Modality" = 'CT'
    AND "collection_name" <> 'NLST'
)
, diffs AS (
  SELECT
    "SeriesInstanceUID",
    ABS(z - LAG(z) OVER (PARTITION BY "SeriesInstanceUID" ORDER BY rn)) AS dz
  FROM pos
)
SELECT
  "SeriesInstanceUID",
  MIN(dz) AS "min_dz",
  MAX(dz) AS "max_dz"
FROM diffs
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 10) Full report (sample 20) for qualified CT series – geometry check, exposure stats & series size
WITH base AS (   -- preliminary filters
  SELECT *
  FROM "IDC"."IDC_V17"."DICOM_ALL"
  WHERE "Modality" = 'CT'
    AND "collection_name" <> 'NLST'
    AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70','1.2.840.10008.1.2.4.51')
    AND CAST("ImageType" AS STRING) NOT ILIKE '%LOCAL%'
)
, geo_ok AS (     -- geometry consistency rules
  SELECT
    "SeriesInstanceUID",
    "SeriesNumber",
    "StudyInstanceUID",
    "PatientID",
    COUNT(*)                                          AS num_instances,
    COUNT(DISTINCT TO_VARIANT("ImageOrientationPatient"))       AS orient_ct,
    COUNT(DISTINCT TO_VARIANT("PixelSpacing"))                  AS pix_ct,
    COUNT(DISTINCT TO_VARIANT("ImagePositionPatient"))          AS pos_ct,
    COUNT(DISTINCT CONCAT(
            "ImagePositionPatient"[0]::STRING, ',',
            "ImagePositionPatient"[1]::STRING))                AS xy_ct,
    COUNT(DISTINCT "Rows") AS row_ct,
    COUNT(DISTINCT "Columns") AS col_ct
  FROM base
  GROUP BY 1,2,3,4
  HAVING orient_ct = 1
     AND pix_ct    = 1
     AND pos_ct    = num_instances
     AND xy_ct     = 1
     AND row_ct    = 1
     AND col_ct    = 1
)
, orient AS (      -- one orientation row per series to compute dot product
  SELECT
    g."SeriesInstanceUID",
    g."SeriesNumber",
    g."StudyInstanceUID",
    g."PatientID",
    b."ImageOrientationPatient"[0]::FLOAT AS o0,
    b."ImageOrientationPatient"[1]::FLOAT AS o1,
    b."ImageOrientationPatient"[2]::FLOAT AS o2,
    b."ImageOrientationPatient"[3]::FLOAT AS o3,
    b."ImageOrientationPatient"[4]::FLOAT AS o4,
    b."ImageOrientationPatient"[5]::FLOAT AS o5
  FROM geo_ok g
  JOIN base b
    ON g."SeriesInstanceUID" = b."SeriesInstanceUID"
  QUALIFY ROW_NUMBER() OVER (PARTITION BY g."SeriesInstanceUID") = 1
)
, dot_chk AS (     -- dot product condition (|cz| within 0.99 – 1.01)
  SELECT *,
    ABS( (o0 * o4) - (o1 * o3) ) AS abs_dot
  FROM orient
  WHERE ABS( ABS( (o0 * o4) - (o1 * o3) ) - 1 ) <= 0.01
)
, z_vals AS (      -- z-coordinate list
  SELECT
    b."SeriesInstanceUID",
    b."ImagePositionPatient"[2]::FLOAT AS z,
    ROW_NUMBER() OVER (PARTITION BY b."SeriesInstanceUID"
                       ORDER BY b."ImagePositionPatient"[2]::FLOAT) AS rn
  FROM base b
  JOIN dot_chk d
    ON b."SeriesInstanceUID" = d."SeriesInstanceUID"
)
, z_diff AS (
  SELECT
    "SeriesInstanceUID",
    ABS(z - LAG(z) OVER (PARTITION BY "SeriesInstanceUID" ORDER BY rn)) AS dz
  FROM z_vals
)
, z_aggr AS (
  SELECT
    "SeriesInstanceUID",
    MAX(dz) AS max_dz,
    MIN(dz) AS min_dz,
    MAX(dz) - MIN(dz) AS tol_dz
  FROM z_diff
  GROUP BY "SeriesInstanceUID"
)
, exp_aggr AS (    -- exposure statistics
  SELECT
    b."SeriesInstanceUID",
    COUNT(DISTINCT b."Exposure")                                       AS exp_cnt,
    MAX(NULLIF(b."Exposure",'')::FLOAT)                                AS exp_max,
    MIN(NULLIF(b."Exposure",'')::FLOAT)                                AS exp_min,
    MAX(NULLIF(b."Exposure",'')::FLOAT) - MIN(NULLIF(b."Exposure",'')::FLOAT) AS exp_range
  FROM base b
  JOIN dot_chk d
    ON b."SeriesInstanceUID" = d."SeriesInstanceUID"
  GROUP BY b."SeriesInstanceUID"
)
, size_aggr AS (   -- total series size in MiB
  SELECT
    "SeriesInstanceUID",
    SUM("instance_size") / (1024.0*1024.0) AS series_mib
  FROM base
  GROUP BY "SeriesInstanceUID"
)
SELECT
  d."SeriesInstanceUID"                                    AS "series_uid",
  d."SeriesNumber"                                         AS "series_no",
  d."StudyInstanceUID"                                     AS "study_uid",
  d."PatientID"                                            AS "patient_id",
  d.abs_dot                                                AS "max_abs_dot",
  g.num_instances                                          AS "num_sop",
  COUNT(DISTINCT b."SliceThickness")                       AS "distinct_thk",
  z.max_dz                                                 AS "max_dz",
  z.min_dz                                                 AS "min_dz",
  z.tol_dz                                                 AS "tol_dz",
  e.exp_cnt                                                AS "distinct_exp",
  e.exp_max                                                AS "exp_max",
  e.exp_min                                                AS "exp_min",
  e.exp_range                                              AS "exp_range",
  s.series_mib                                             AS "series_mib"
FROM dot_chk d
JOIN geo_ok      g ON d."SeriesInstanceUID" = g."SeriesInstanceUID"
JOIN z_aggr      z ON d."SeriesInstanceUID" = z."SeriesInstanceUID"
JOIN exp_aggr    e ON d."SeriesInstanceUID" = e."SeriesInstanceUID"
JOIN size_aggr   s ON d."SeriesInstanceUID" = s."SeriesInstanceUID"
JOIN base        b ON d."SeriesInstanceUID" = b."SeriesInstanceUID"
GROUP BY
  d."SeriesInstanceUID", d."SeriesNumber", d."StudyInstanceUID",
  d."PatientID", d.abs_dot, g.num_instances,
  z.max_dz, z.min_dz, z.tol_dz,
  e.exp_cnt, e.exp_max, e.exp_min, e.exp_range,
  s.series_mib
ORDER BY
  z.tol_dz DESC,
  e.exp_range DESC,
  d."SeriesInstanceUID" DESC
LIMIT 20;
```
