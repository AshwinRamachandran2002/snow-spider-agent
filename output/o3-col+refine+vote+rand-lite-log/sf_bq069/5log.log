Query:
--Description: 9) Examine minimum and maximum slice-to-slice z-spacing for each
--             non-NLST CT series (sample 20).  The ROW_NUMBER() window function
--             already contains an ORDER BY on the z-coordinate, so it is valid.
WITH pos AS (
    SELECT
        "SeriesInstanceUID",
        "ImagePositionPatient"[2]::FLOAT AS z,
        ROW_NUMBER() OVER (
            PARTITION BY "SeriesInstanceUID"
            ORDER BY "ImagePositionPatient"[2]::FLOAT
        ) AS rn
    FROM "IDC"."IDC_V17"."DICOM_ALL"
    WHERE "Modality" = 'CT'
      AND "collection_name" <> 'NLST'
),
diffs AS (
    SELECT
        "SeriesInstanceUID",
        ABS(z - LAG(z) OVER (
            PARTITION BY "SeriesInstanceUID"
            ORDER BY rn
        )) AS dz
    FROM pos
)
SELECT
    "SeriesInstanceUID",
    MIN(dz) AS "min_dz",
    MAX(dz) AS "max_dz"
FROM diffs
GROUP BY "SeriesInstanceUID"
LIMIT 20
