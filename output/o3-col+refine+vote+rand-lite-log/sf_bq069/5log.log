```sql
--Description: Pick one (first) instance per non-NLST CT series, then
--             calculate the absolute value of the z-component (|cz|)
--             of the cross-product of the two orientation vectors.
--             That component equals (o0*o4 – o1*o3).  A window function
--             with ROW_NUMBER() needs an ORDER BY, so we order by
--             SOPInstanceUID inside the partition to obtain a stable
--             “first row” for every SeriesInstanceUID.  Finally, show
--             20 sample series to verify the computation.
WITH one_per_series AS (
    SELECT
        "SeriesInstanceUID",
        "ImageOrientationPatient"[0]::FLOAT AS o0,
        "ImageOrientationPatient"[1]::FLOAT AS o1,
        "ImageOrientationPatient"[2]::FLOAT AS o2,
        "ImageOrientationPatient"[3]::FLOAT AS o3,
        "ImageOrientationPatient"[4]::FLOAT AS o4,
        "ImageOrientationPatient"[5]::FLOAT AS o5,
        ROW_NUMBER() OVER (PARTITION BY "SeriesInstanceUID"
                           ORDER BY "SOPInstanceUID") AS rn
    FROM "IDC"."IDC_V17"."DICOM_ALL"
