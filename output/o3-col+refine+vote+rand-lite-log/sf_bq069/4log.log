```sql
--Description:  Extract the third component (z-coordinate) of ImagePositionPatient for every CT
--              instance that is NOT in the NLST collection; convert it safely with TRY_TO_FLOAT
--              to avoid casting errors; then, per SeriesInstanceUID, compute slice-to-slice
--              spacing (Δz) via LAG, and finally return the overall z-extent plus the minimum
--              and maximum Δz for each series (sampled with LIMIT 20).
WITH z AS (
    SELECT
        d."SeriesInstanceUID",
        TRY_TO_FLOAT(f.value::STRING) AS z_coord           -- safe numeric cast of z
    FROM IDC.IDC_V17.DICOM_ALL d,
         LATERAL FLATTEN(input => d."ImagePositionPatient") f
    WHERE d."Modality"        = 'CT'
      AND d."collection_name" <> 'NLST'
      AND f.index             = 2                         -- index 2 = third element (z)
      AND TRY_TO_FLOAT(f.value::STRING) IS NOT NULL
), diffs AS (
    SELECT
        "SeriesInstanceUID",
        z_coord,
        ABS(z_coord - LAG(z_coord) OVER (
            PARTITION BY "SeriesInstanceUID"
            ORDER BY z_coord
        )) AS delta_z
    FROM z
)
SELECT
    "SeriesInstanceUID",
    MAX(z_coord) - MIN(z_coord) AS "total_z_extent",
    MIN(delta_z)                AS "min_delta_z",
    MAX(delta_z)                AS "max_delta_z"
FROM diffs
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```
