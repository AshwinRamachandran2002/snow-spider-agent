  AND t."collection_name" <> 'NLST'
LIMIT 20;
```

```sql
--Description: 5) Verify that every instance inside a series has one unique orientation & pixel spacing.
SELECT
  "SeriesInstanceUID",
  COUNT(DISTINCT TO_VARIANT("ImageOrientationPatient")::STRING) AS "distinct_orientations",
  COUNT(DISTINCT TO_VARIANT("PixelSpacing")::STRING)           AS "distinct_pixel_spacing"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
GROUP BY "SeriesInstanceUID"
HAVING COUNT(DISTINCT TO_VARIANT("ImageOrientationPatient")::STRING) > 1
   OR COUNT(DISTINCT TO_VARIANT("PixelSpacing")::STRING) > 1
LIMIT 20;
```

```sql
--Description: 6) Compare number of instances with number of distinct z-positions per series.
SELECT
  "SeriesInstanceUID",
  COUNT(*)                                   AS "num_instances",
  COUNT(DISTINCT TO_VARIANT("ImagePositionPatient")::STRING) AS "distinct_positions"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
GROUP BY "SeriesInstanceUID"
HAVING COUNT(*) <> COUNT(DISTINCT TO_VARIANT("ImagePositionPatient")::STRING)
LIMIT 20;
```

```sql
--Description: 7) Check that first two coordinates of Image Position (Patient) are constant inside a series.
SELECT
  "SeriesInstanceUID",
  COUNT(DISTINCT SPLIT_PART(TO_VARIANT("ImagePositionPatient")::STRING, ',', 1)) AS "distinct_x",
  COUNT(DISTINCT SPLIT_PART(TO_VARIANT("ImagePositionPatient")::STRING, ',', 2)) AS "distinct_y"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
GROUP BY "SeriesInstanceUID"
HAVING (COUNT(DISTINCT SPLIT_PART(TO_VARIANT("ImagePositionPatient")::STRING, ',', 1)) > 1)
    OR (COUNT(DISTINCT SPLIT_PART(TO_VARIANT("ImagePositionPatient")::STRING, ',', 2)) > 1)
LIMIT 20;
```

```sql
--Description: 8) Compute slice-interval (z-spacing) statistics per CT series (min & max Δz).
WITH z AS (
  SELECT
    "SeriesInstanceUID",
    CAST(SPLIT_PART(TO_VARIANT("ImagePositionPatient")::STRING, ',', 3) AS FLOAT) AS z_coord
  FROM IDC.IDC_V17.DICOM_ALL
  WHERE "Modality" = 'CT'
    AND "collection_name" <> 'NLST'
)
SELECT
  "SeriesInstanceUID",
  MAX(z_coord) - MIN(z_coord)                                 AS "total_z_extent",
  MIN(diff)                                                   AS "min_delta_z",
  MAX(diff)                                                   AS "max_delta_z"
FROM (
  SELECT
    "SeriesInstanceUID",
    z_coord,
    ABS(z_coord - LAG(z_coord) OVER (PARTITION BY "SeriesInstanceUID" ORDER BY z_coord)) AS diff
  FROM z
)
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 9) Exposure statistics per CT series.
SELECT
  "SeriesInstanceUID",
  COUNT(DISTINCT "Exposure")                                  AS "num_distinct_exposures",
  MAX(CAST("Exposure" AS FLOAT))                              AS "max_exposure",
  MIN(CAST("Exposure" AS FLOAT))                              AS "min_exposure",
  MAX(CAST("Exposure" AS FLOAT)) - MIN(CAST("Exposure" AS FLOAT)) AS "exposure_range"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
  AND "Exposure" IS NOT NULL
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 10) Approximate size (MiB) of each qualified CT series.
SELECT
  "SeriesInstanceUID",
  SUM("instance_size")/1048576.0 AS "series_size_MiB"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
GROUP BY "SeriesInstanceUID"
ORDER BY "series_size_MiB" DESC
LIMIT 20;
```
