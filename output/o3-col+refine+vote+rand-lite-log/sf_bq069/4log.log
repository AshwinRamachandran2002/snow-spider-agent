--Description: 9) Exposure statistics per CT series (exclude NLST).  
--              • TRY_TO_NUMBER safely converts Exposure text to numeric; NULLs are discarded.  
--              • Per SeriesInstanceUID, compute #distinct exposures, max, min, and range.
WITH exp AS (
    SELECT
        "SeriesInstanceUID",
        TRY_TO_NUMBER("Exposure") AS exposure_val
    FROM IDC.IDC_V17.DICOM_ALL
    WHERE "Modality"        = 'CT'
      AND "collection_name" <> 'NLST'
      AND TRY_TO_NUMBER("Exposure") IS NOT NULL
)
SELECT
    "SeriesInstanceUID",
    COUNT(DISTINCT exposure_val)            AS "num_distinct_exposures",
    MAX(exposure_val)                       AS "max_exposure",
    MIN(exposure_val)                       AS "min_exposure",
    MAX(exposure_val) - MIN(exposure_val)   AS "exposure_range"
FROM exp
GROUP BY "SeriesInstanceUID"
LIMIT 20
