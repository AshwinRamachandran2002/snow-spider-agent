    min_exposure                                    AS "min_exposure",
    exposure_range                                  AS "exposure_range",
    ROUND(size_mib ,4)                              AS "series_size_mib"
FROM qualified
ORDER BY "slice_interval_tolerance" DESC NULLS LAST,
