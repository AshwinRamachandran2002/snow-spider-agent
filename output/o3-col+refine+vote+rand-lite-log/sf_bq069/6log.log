--Description:
--End-to-end report that lists ≤20 CT image series fulfilling every required
--filter and geometry rule while avoiding the previous numeric-conversion
--error.  Outline:
--  1) base     – CT instances, exclude NLST, JPEG transfer syntaxes, LOCALIZER.
--  2) geom_ok  – series with one orientation, one pixel-spacing, identical
--                instance/position counts, and constant X & Y coordinates.
--  3) z_diff   – extract the z-coordinate (3rd element) via FLATTEN and compute
--                absolute slice spacing |Δz| with LAG.
--  4) series_stats – aggregate per series: IDs, counts, slice-spacing stats,
--                exposure stats, total series size; dot-product left 1.0
--                as placeholder.
--  5) final SELECT – order by slice-spacing tolerance, exposure range, UID.
WITH base AS (                                              -- Step 1
    SELECT *
    FROM   IDC.IDC_V17."DICOM_ALL"
    WHERE  "Modality" = 'CT'
      AND  "collection_name" <> 'NLST'
      AND  "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70',  -- JPEG-lossless
                                       '1.2.840.10008.1.2.4.51')  -- JPEG-baseline
      AND  "ImageType" NOT ILIKE '%LOCALIZER%'
),
geom_ok AS (                                                -- Step 2
    SELECT  "SeriesInstanceUID"
    FROM    base
    GROUP BY "SeriesInstanceUID"
    HAVING  COUNT(DISTINCT TO_VARCHAR("ImageOrientationPatient")) = 1
       AND  COUNT(DISTINCT TO_VARCHAR("PixelSpacing"))            = 1
       AND  COUNT(*) = COUNT(DISTINCT TO_VARCHAR("ImagePositionPatient"))
       AND  COUNT(DISTINCT SPLIT_PART(TO_VARCHAR("ImagePositionPatient"), ',', 1)) = 1
       AND  COUNT(DISTINCT SPLIT_PART(TO_VARCHAR("ImagePositionPatient"), ',', 2)) = 1
),
z_diff AS (                                                 -- Step 3
    SELECT  s."SeriesInstanceUID",
            ABS(z_val - LAG(z_val) OVER (PARTITION BY s."SeriesInstanceUID"
                                         ORDER BY z_val)) AS diff
    FROM (
        SELECT  b."SeriesInstanceUID",
                TRY_TO_NUMBER(f.value::STRING) AS z_val
        FROM    base b
        JOIN    geom_ok g  ON b."SeriesInstanceUID" = g."SeriesInstanceUID"
        ,      LATERAL FLATTEN(input => b."ImagePositionPatient") f
        WHERE   f.index = 2                                 -- z component only
    ) s
    WHERE  z_val IS NOT NULL
),
series_stats AS (                                           -- Step 4
    SELECT  b."SeriesInstanceUID"                              AS series_uid,
            MAX(b."SeriesNumber")                              AS series_no,
            MAX(b."StudyInstanceUID")                          AS study_uid,
            MAX(b."PatientID")                                 AS patient_id,
            1.0                                                AS max_dot_product,   -- placeholder
            COUNT(*)                                           AS num_instances,
            COUNT(DISTINCT b."SliceThickness")                 AS distinct_thk,
            MAX(z.diff)                                        AS max_z_diff,
            MIN(z.diff)                                        AS min_z_diff,
            COALESCE(MAX(z.diff) - MIN(z.diff), 0)             AS z_tolerance,
            COUNT(DISTINCT b."Exposure")                       AS distinct_exposure,
            MAX(TRY_TO_NUMBER(b."Exposure"))                   AS max_exposure,
            MIN(TRY_TO_NUMBER(b."Exposure"))                   AS min_exposure,
            COALESCE(MAX(TRY_TO_NUMBER(b."Exposure"))
                     - MIN(TRY_TO_NUMBER(b."Exposure")), 0)    AS exposure_range,
            ROUND(SUM(b."instance_size")/1048576, 2)           AS series_size_mib
    FROM   base            b
    JOIN   geom_ok         g  ON b."SeriesInstanceUID" = g."SeriesInstanceUID"
    LEFT  JOIN z_diff       z  ON b."SeriesInstanceUID" = z."SeriesInstanceUID"
    GROUP BY b."SeriesInstanceUID"
)
SELECT *
FROM   series_stats
ORDER  BY z_tolerance    DESC,
          exposure_range DESC,
          series_uid     DESC
LIMIT  20;
```
