--Description:
--Objective:  find the first five CT image series that satisfy the principal inclusion rules
--(non-NLST, non-JPEG, non-localizer, single orientation & single pixel-spacing) and
--summarise key geometry counts for each.  This condensed query demonstrates—in a single
--step—the logic that will later be expanded for the full report.
--
--Logic inside the CTEs
--  • filtered  : instances that already exclude NLST, JPEG transfer syntaxes, LOCALIZER.
--  • series_ok : series whose instances all share one orientation & one pixel-spacing.
--  • final     : show quick stats per series (counts of instances, positions, orientations).
WITH filtered AS (
    SELECT  *
    FROM    IDC.IDC_V17."DICOM_ALL"
    WHERE   "Modality" = 'CT'
      AND   "collection_name" <> 'NLST'
      AND   "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70',
                                        '1.2.840.10008.1.2.4.51')
      AND   "ImageType" NOT ILIKE '%LOCALIZER%'
),
series_ok AS (
    SELECT  "SeriesInstanceUID"
    FROM    filtered
    GROUP BY "SeriesInstanceUID"
    HAVING  COUNT(DISTINCT TO_VARCHAR("ImageOrientationPatient")) = 1
       AND  COUNT(DISTINCT TO_VARCHAR("PixelSpacing"))            = 1
    LIMIT 5
)
SELECT  f."SeriesInstanceUID"                                     AS series_uid,
        COUNT(*)                                                  AS num_instances,
        COUNT(DISTINCT TO_VARCHAR(f."ImagePositionPatient"))      AS distinct_positions,
        COUNT(DISTINCT TO_VARCHAR(f."ImageOrientationPatient"))   AS distinct_orient,
        COUNT(DISTINCT TO_VARCHAR(f."PixelSpacing"))              AS distinct_pixsp
FROM    filtered f
JOIN    series_ok s
       ON f."SeriesInstanceUID" = s."SeriesInstanceUID"
GROUP BY f."SeriesInstanceUID"
ORDER BY series_uid;
