Query:
--Description: 3)  Sample of CT instances (non-NLST) that still use one of the two JPEG transfer syntaxes we must exclude.
SELECT 
       "SeriesInstanceUID",
       "StudyInstanceUID",
       "TransferSyntaxUID",
       "SOPInstanceUID"
FROM   IDC.IDC_V17."DICOM_ALL"
WHERE  "Modality" = 'CT'
  AND  "collection_name" <> 'NLST'
  AND  "TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.70',   -- JPEG-lossless
                               '1.2.840.10008.1.2.4.51')   -- JPEG-baseline
LIMIT  20;
