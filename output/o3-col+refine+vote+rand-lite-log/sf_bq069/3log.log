        z."max_z_gap",
        z."min_z_gap",
        z."tolerance",
        e."distinct_exposures",
        e."max_exposure",
        e."min_exposure",
        e."exposure_range",
        ROUND(SUM(s."instance_size") / 1048576, 2) AS "series_size_mib"
    FROM ct_filtered s
    JOIN z_stats        z ON z."SeriesInstanceUID" = s."SeriesInstanceUID"
    JOIN exposure_stats e ON e."SeriesInstanceUID" = s."SeriesInstanceUID"
    JOIN dot_stats      d ON d."SeriesInstanceUID" = s."SeriesInstanceUID"
    GROUP BY
        s."SeriesInstanceUID",
        d."max_dot_ref_z",
        z."max_z_gap", z."min_z_gap", z."tolerance",
        e."distinct_exposures", e."max_exposure", e."min_exposure", e."exposure_range"
)
SELECT *
