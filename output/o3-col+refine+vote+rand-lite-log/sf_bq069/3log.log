--Description:  One-step query that builds the requested CT-series report.
--              THINKING PROCESS (inline):
--              ①  Filter DICOM_ALL → keep CT, remove NLST, JPEG-compressed, and LOCALIZER images.
--              ②  For each SeriesInstanceUID:
--                 • Derive ordered z-coordinates (3rd ImagePositionPatient element) → compute slice-to-slice gaps with LAG;
--                   then gather max/min/tolerance of those gaps.
--                 • Collect exposure stats: distinct count, max, min, and range.
--                 • Compute the maximum |dot product| between orientation cross-product and reference z-axis.
--              ③  Assemble series-level metrics: study, patient, SOP count, slice-thickness diversity,
--                 gap stats, exposure stats, total size (MiB).
--              ④  Sort as required: tolerance DESC, exposure_range DESC, SeriesInstanceUID DESC.

WITH ct_filtered AS (   /* ①  core filter */
    SELECT *
    FROM IDC.IDC_V17.DICOM_ALL a
    WHERE a."Modality" = 'CT'
      AND a."collection_name" <> 'NLST'
      AND a."TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51')
      AND NOT EXISTS (
            SELECT 1
            FROM LATERAL FLATTEN(input => a."ImageType") f
            WHERE f.value::STRING ILIKE '%LOCALIZER%'
      )
),
z_vals AS (             /* ②-a  unique z-coords per series */
    SELECT DISTINCT
        "SeriesInstanceUID",
        PARSE_JSON("ImagePositionPatient")[2]::FLOAT AS z
    FROM ct_filtered
    WHERE "ImagePositionPatient" IS NOT NULL
),
z_gaps AS (             /* ②-a  consecutive gaps */
    SELECT
        "SeriesInstanceUID",
        z - LAG(z) OVER (PARTITION BY "SeriesInstanceUID" ORDER BY z) AS z_gap
    FROM z_vals
),
z_stats AS (            /* ②-a  gap statistics */
    SELECT
        "SeriesInstanceUID",
        MAX(z_gap) AS "max_z_gap",
        MIN(z_gap) AS "min_z_gap",
        MAX(z_gap) - MIN(z_gap) AS "tolerance"
    FROM z_gaps
    WHERE z_gap IS NOT NULL
    GROUP BY "SeriesInstanceUID"
),
exposure_stats AS (     /* ②-b  exposure statistics */
    SELECT
        "SeriesInstanceUID",
        COUNT(DISTINCT "Exposure")                                AS "distinct_exposures",
        MAX(TRY_TO_NUMBER("Exposure"))                            AS "max_exposure",
        MIN(TRY_TO_NUMBER("Exposure"))                            AS "min_exposure",
        MAX(TRY_TO_NUMBER("Exposure")) - MIN(TRY_TO_NUMBER("Exposure")) AS "exposure_range"
    FROM ct_filtered
    GROUP BY "SeriesInstanceUID"
),
dot_stats AS (          /* ②-c  orientation dot-product */
    SELECT
        "SeriesInstanceUID",
        MAX(ABS(
            (PARSE_JSON("ImageOrientationPatient")[0]::FLOAT * PARSE_JSON("ImageOrientationPatient")[4]::FLOAT)
          - (PARSE_JSON("ImageOrientationPatient")[1]::FLOAT * PARSE_JSON("ImageOrientationPatient")[3]::FLOAT)
        )) AS "max_dot_ref_z"
    FROM ct_filtered
    GROUP BY "SeriesInstanceUID"
),
final AS (              /* ③  combine everything */
    SELECT
        s."SeriesInstanceUID",
        MIN(s."SeriesNumber")                 AS "SeriesNumber",
        MIN(s."StudyInstanceUID")             AS "StudyInstanceUID",
        MIN(s."PatientID")                    AS "PatientID",
        d."max_dot_ref_z",
        COUNT(*)                              AS "num_sop_instances",
        COUNT(DISTINCT s."SliceThickness")    AS "distinct_slice_thickness",
        z."max_z_gap",
        z."min_z_gap",
        z."tolerance",
        e."distinct_exposures",
        e."max_exposure",
        e."min_exposure",
        e."exposure_range",
        ROUND(SUM(s."instance_size")/1048576, 2) AS "series_size_mib"
    FROM ct_filtered s
    JOIN z_stats        z ON z."SeriesInstanceUID" = s."SeriesInstanceUID"
    JOIN exposure_stats e ON e."SeriesInstanceUID" = s."SeriesInstanceUID"
    JOIN dot_stats      d ON d."SeriesInstanceUID" = s."SeriesInstanceUID"
    GROUP BY
        s."SeriesInstanceUID",
        d."max_dot_ref_z",
        z."max_z_gap", z."min_z_gap", z."tolerance",
        e."distinct_exposures", e."max_exposure", e."min_exposure", e."exposure_range"
)
SELECT *
FROM final            /* ④  ordering */
ORDER BY "tolerance" DESC,
         "exposure_range" DESC,
         "SeriesInstanceUID" DESC
LIMIT 20;
