```sql
-- 1. Description:  Inspect how many instances each imaging modality has in the “dicom_all” table.
SELECT 
    "Modality",
    COUNT(*)   AS "instance_cnt"
FROM IDC.IDC_V17.DICOM_ALL
GROUP BY "Modality"
LIMIT 20;
```

```sql
