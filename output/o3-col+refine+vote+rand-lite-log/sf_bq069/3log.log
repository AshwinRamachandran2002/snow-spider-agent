-- 2. Description:  List distinct collection names that contain CT images (helps us confirm which collections will remain once NLST is excluded).
SELECT DISTINCT 
    "collection_name"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
LIMIT 20;
