Query:
-- 3. Description:  Show the transfer-syntax UIDs that appear in CT images outside the NLST collection (to verify which syntaxes must be filtered out).
SELECT DISTINCT 
    "TransferSyntaxUID"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
LIMIT 20;
