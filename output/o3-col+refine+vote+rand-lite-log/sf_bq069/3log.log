SELECT DISTINCT 
    "collection_name"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
LIMIT 20;
```

```sql
-- 3. Description:  Show the transfer-syntax UIDs that appear in CT images outside the NLST collection (to verify which syntaxes must be filtered out).
SELECT DISTINCT 
    "TransferSyntaxUID"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
LIMIT 20;
```

```sql
-- 4. Description:  Retrieve a handful of CT instances whose ImageType array contains the word “LOCALIZER” (to understand how localizers are encoded).
SELECT 
    "SeriesInstanceUID",
    "SOPInstanceUID",
    "ImageType"
FROM IDC.IDC_V17.DICOM_ALL,
     LATERAL FLATTEN(input => "ImageType") f
WHERE "Modality" = 'CT'
  AND f.value::STRING ILIKE '%LOCALIZER%'
LIMIT 20;
```

```sql
-- 5. Description:  Sample pixel-spacing values stored for non-NLST CT images, expressed as a VARCHAR for easier comparison later.
SELECT DISTINCT 
    "PixelSpacing"::STRING AS "pixel_spacing_str"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
LIMIT 20;
```

```sql
-- 6. Description:  Sample image-orientation (patient) vectors for non-NLST CT images;  
--                 returned as VARCHAR so we can visually confirm uniqueness within a series.
SELECT DISTINCT 
    "SeriesInstanceUID",
    "ImageOrientationPatient"::STRING AS "orientation_vec"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
LIMIT 20;
```

```sql
-- 7. Description:  For a small set of CT series, count how many distinct orientation vectors  
--                 and pixel-spacing values each contains (geometry consistency check #1 & #2).
SELECT 
    "SeriesInstanceUID",
    COUNT(DISTINCT "ImageOrientationPatient"::STRING) AS "distinct_orientations",
    COUNT(DISTINCT "PixelSpacing"::STRING)            AS "distinct_pixspacing"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
-- 8. Description:  Compare the number of SOP instances to the number of distinct z-coordinate positions  
--                 (geometry consistency check #3) for a few CT series.
SELECT 
    "SeriesInstanceUID",
    COUNT(*)                                                AS "num_sops",
    COUNT(DISTINCT "ImagePositionPatient"::STRING)          AS "distinct_positions"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
-- 9. Description:  Compute the maximum absolute dot-product (|a1*b2 – a2*b1|) between the cross-product  
--                 of orientation vectors and reference vector [0,0,1] for each of 20 CT series.
SELECT
    "SeriesInstanceUID",
    MAX(ABS(
        (PARSE_JSON("ImageOrientationPatient")[0]::FLOAT * PARSE_JSON("ImageOrientationPatient")[4]::FLOAT) -
        (PARSE_JSON("ImageOrientationPatient")[1]::FLOAT * PARSE_JSON("ImageOrientationPatient")[3]::FLOAT)
    )) AS "max_dot_ref_z"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_name" <> 'NLST'
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
--10. Description:  Aggregate everything needed for the final report (sampled to 20 series) – 
--                 slice-interval stats, exposure stats, geometry checks, and total series size.
WITH ct_clean AS (
    SELECT *
    FROM IDC.IDC_V17.DICOM_ALL
    WHERE "Modality" = 'CT'
      AND "collection_name" <> 'NLST'
      AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70','1.2.840.10008.1.2.4.51')
      AND NOT EXISTS (SELECT 1
                      FROM LATERAL FLATTEN(input => "ImageType") f
                      WHERE f.value::STRING ILIKE '%LOCALIZER%')
), position_diff AS (
    SELECT
        "SeriesInstanceUID",
        LISTAGG(PARSE_JSON("ImagePositionPatient")[2]::FLOAT, ',') 
            WITHIN GROUP (ORDER BY PARSE_JSON("ImagePositionPatient")[2]::FLOAT) AS "z_list"
    FROM ct_clean
    GROUP BY "SeriesInstanceUID"
), z_stats AS (
    SELECT
        "SeriesInstanceUID",
        MAX(z_gap) AS "max_z_gap",
        MIN(z_gap) AS "min_z_gap",
        MAX(z_gap) - MIN(z_gap) AS "tolerance"
    FROM (
        SELECT 
            p."SeriesInstanceUID",
            z_values[idx+1] - z_values[idx] AS z_gap
        FROM position_diff p,
             LATERAL SPLIT_TO_ARRAY(p."z_list", ',') z_values,
             LATERAL GENERATOR(ROWCOUNT => ARRAY_SIZE(z_values)-1) g(idx)
    )
    GROUP BY "SeriesInstanceUID"
), exposure_stats AS (
    SELECT
        "SeriesInstanceUID",
        COUNT(DISTINCT "Exposure")                           AS "distinct_exposures",
        MAX(TRY_TO_NUMBER("Exposure"))                       AS "max_exposure",
        MIN(TRY_TO_NUMBER("Exposure"))                       AS "min_exposure",
        MAX(TRY_TO_NUMBER("Exposure"))-MIN(TRY_TO_NUMBER("Exposure")) AS "exposure_range"
    FROM ct_clean
    GROUP BY "SeriesInstanceUID"
), dot_product AS (
    SELECT
        "SeriesInstanceUID",
        MAX(ABS(
            (PARSE_JSON("ImageOrientationPatient")[0]::FLOAT * PARSE_JSON("ImageOrientationPatient")[4]::FLOAT) -
            (PARSE_JSON("ImageOrientationPatient")[1]::FLOAT * PARSE_JSON("ImageOrientationPatient")[3]::FLOAT)
        )) AS "max_dot_ref_z"
    FROM ct_clean
    GROUP BY "SeriesInstanceUID"
), final AS (
    SELECT
        s."SeriesInstanceUID",
        MIN(s."SeriesNumber")                                   AS "SeriesNumber",
        MIN(s."StudyInstanceUID")                               AS "StudyInstanceUID",
        MIN(s."PatientID")                                      AS "PatientID",
        d."max_dot_ref_z",
        COUNT(*)                                                AS "num_sop_instances",
        COUNT(DISTINCT s."SliceThickness")                      AS "distinct_slice_thickness",
        z."max_z_gap",
        z."min_z_gap",
        z."tolerance",
        e."distinct_exposures",
        e."max_exposure",
        e."min_exposure",
        e."exposure_range",
        ROUND(SUM(s."instance_size")/1048576,2)                 AS "series_size_mib"
    FROM ct_clean s
    JOIN z_stats       z ON z."SeriesInstanceUID" = s."SeriesInstanceUID"
    JOIN exposure_stats e ON e."SeriesInstanceUID" = s."SeriesInstanceUID"
    JOIN dot_product    d ON d."SeriesInstanceUID" = s."SeriesInstanceUID"
    GROUP BY 
        s."SeriesInstanceUID", d."max_dot_ref_z",
        z."max_z_gap", z."min_z_gap", z."tolerance",
        e."distinct_exposures", e."max_exposure", e."min_exposure", e."exposure_range"
)
SELECT *
FROM final
ORDER BY "tolerance" DESC,
         "exposure_range" DESC,
         "SeriesInstanceUID" DESC
LIMIT 20;
```
