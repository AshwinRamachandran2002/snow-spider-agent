--Description:  Single-statement solution that (a) filters CT images per rules, (b) derives
--              slice-gap and exposure statistics, (c) checks orientation alignment,
--              (d) aggregates series-level metrics, and (e) returns the 20 series with the
--              largest slice-gap tolerance, then exposure-range, then Series UID.
WITH ct_filtered AS (          /* 1. keep only qualifying CT instances */
    SELECT *
    FROM IDC.IDC_V17.DICOM_ALL
    WHERE "Modality" = 'CT'
      AND "collection_name" <> 'NLST'
      AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51')
      AND TO_VARCHAR("ImageType") NOT ILIKE '%LOCALIZER%'        -- remove localizers
),
z_vals AS (                     /* 2-a. unique z (slice) positions per series */
    SELECT DISTINCT
        "SeriesInstanceUID",
        PARSE_JSON("ImagePositionPatient")[2]::FLOAT AS z
    FROM ct_filtered
    WHERE "ImagePositionPatient" IS NOT NULL
),
z_gaps AS (                     /* 2-b. consecutive slice gaps */
    SELECT
        "SeriesInstanceUID",
        z - LAG(z) OVER (PARTITION BY "SeriesInstanceUID" ORDER BY z) AS z_gap
    FROM z_vals
),
z_stats AS (                    /* 2-c. gap statistics: max, min, tolerance */
    SELECT
        "SeriesInstanceUID",
        MAX(z_gap) AS "max_z_gap",
        MIN(z_gap) AS "min_z_gap",
        MAX(z_gap) - MIN(z_gap) AS "tolerance"
    FROM z_gaps
    WHERE z_gap IS NOT NULL
    GROUP BY "SeriesInstanceUID"
),
exposure_stats AS (             /* 3. exposure metrics */
    SELECT
        "SeriesInstanceUID",
        COUNT(DISTINCT "Exposure")                                AS "distinct_exposures",
        MAX(TRY_TO_NUMBER("Exposure"))                            AS "max_exposure",
        MIN(TRY_TO_NUMBER("Exposure"))                            AS "min_exposure",
        MAX(TRY_TO_NUMBER("Exposure")) - MIN(TRY_TO_NUMBER("Exposure")) AS "exposure_range"
    FROM ct_filtered
    GROUP BY "SeriesInstanceUID"
),
dot_stats AS (                  /* 4. orientation alignment metric */
    SELECT
        "SeriesInstanceUID",
        MAX(ABS(
              (PARSE_JSON("ImageOrientationPatient")[0]::FLOAT * PARSE_JSON("ImageOrientationPatient")[4]::FLOAT)
            - (PARSE_JSON("ImageOrientationPatient")[1]::FLOAT * PARSE_JSON("ImageOrientationPatient")[3]::FLOAT)
        )) AS "max_dot_ref_z"
    FROM ct_filtered
    GROUP BY "SeriesInstanceUID"
),
final AS (                      /* 5. assemble series-level report */
    SELECT
        s."SeriesInstanceUID",
        MIN(s."SeriesNumber")               AS "SeriesNumber",
        MIN(s."StudyInstanceUID")           AS "StudyInstanceUID",
        MIN(s."PatientID")                  AS "PatientID",
        d."max_dot_ref_z",
