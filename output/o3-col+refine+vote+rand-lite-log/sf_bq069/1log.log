LIMIT 20;
```

```sql
--Description: 3)  Inspect various “ImageType” values in CT data to discover possible localizer strings
SELECT DISTINCT
       "ImageType"
FROM   "IDC"."IDC_V17"."DICOM_ALL"
WHERE  "Modality" = 'CT'
LIMIT 20;
```

```sql
--Description: 4)  Examine pixel geometry (rows, columns, pixel spacing) per-series for CT data (non-NLST, non-JPEG)
SELECT 
       "SeriesInstanceUID",
       "Rows",
       "Columns",
       "PixelSpacing"
FROM   "IDC"."IDC_V17"."DICOM_ALL"
WHERE  "Modality" = 'CT'
  AND  "collection_name" <> 'NLST'
  AND  "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51')
LIMIT 20;
```

```sql
--Description: 5)  Preview image-orientation vectors (flattened) for one example CT series
SELECT 
       d."SeriesInstanceUID",
       f.value::STRING AS "orientation_component"
FROM   "IDC"."IDC_V17"."DICOM_ALL"  d,
       LATERAL FLATTEN(input => d."ImageOrientationPatient") f
WHERE  d."SeriesInstanceUID" = (
         SELECT "SeriesInstanceUID"
         FROM   "IDC"."IDC_V17"."DICOM_ALL"
         WHERE  "Modality" = 'CT'
           AND  "collection_name" <> 'NLST'
         LIMIT 1
       )
LIMIT 20;
```

```sql
--Description: 6)  Count SOP instances per series to compare with image-position counts later
SELECT 
       "SeriesInstanceUID",
       COUNT(*)                         AS "instance_cnt"
FROM   "IDC"."IDC_V17"."DICOM_ALL"
WHERE  "Modality" = 'CT'
  AND  "collection_name" <> 'NLST'
GROUP  BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 7)  Check how many distinct slice-thickness values occur within each CT series
SELECT 
       "SeriesInstanceUID",
       COUNT(DISTINCT "SliceThickness") AS "distinct_slice_thickness"
FROM   "IDC"."IDC_V17"."DICOM_ALL"
WHERE  "Modality" = 'CT'
  AND  "collection_name" <> 'NLST'
GROUP  BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 8)  Investigate exposure variability within CT series
SELECT 
       "SeriesInstanceUID",
       COUNT(DISTINCT "Exposure")                    AS "n_distinct_exposure",
       MIN("Exposure")                              AS "min_exposure",
       MAX("Exposure")                              AS "max_exposure"
FROM   "IDC"."IDC_V17"."DICOM_ALL"
WHERE  "Modality" = 'CT'
  AND  "collection_name" <> 'NLST'
GROUP  BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 9)  Derive total series size (MiB) using SUM(instance_size) / 2^20
SELECT 
       "SeriesInstanceUID",
       ROUND(SUM("instance_size") / 1048576, 2) AS "series_size_MiB"
FROM   "IDC"."IDC_V17"."DICOM_ALL"
WHERE  "Modality" = 'CT'
  AND  "collection_name" <> 'NLST'
GROUP  BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 10)  Prototype combined aggregation applying key filters; produces geometry & exposure summaries
SELECT 
       "SeriesInstanceUID",
       MAX("SeriesNumber")                                  AS "SeriesNumber",
       MAX("StudyInstanceUID")                              AS "StudyInstanceUID",
       MAX("PatientID")                                     AS "PatientID",
       COUNT(DISTINCT "SliceThickness")                     AS "n_distinct_slice_thickness",
       MIN("Exposure")                                      AS "min_exposure",
       MAX("Exposure")                                      AS "max_exposure",
       MAX("Exposure") - MIN("Exposure")                    AS "exposure_range",
       ROUND(SUM("instance_size") / 1048576, 2)             AS "series_size_MiB",
       COUNT(*)                                             AS "n_instances"
FROM   "IDC"."IDC_V17"."DICOM_ALL"
WHERE  "Modality" = 'CT'
  AND  "collection_name" <> 'NLST'
  AND  "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51')
  AND  "ImageType" NOT ILIKE '%LOCALIZER%'
GROUP  BY "SeriesInstanceUID"
LIMIT 20;
```
