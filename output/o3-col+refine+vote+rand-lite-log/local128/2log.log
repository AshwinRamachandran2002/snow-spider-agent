```sql
-- 2.  Get the tournament IDs for the three venues we’re interested in.
SELECT DISTINCT "TourneyID", "TourneyLocation"
FROM "Tournaments"
WHERE "TourneyLocation" IN ('Thunderbird Lanes', 'Totem Lanes', 'Bolero Lanes')
LIMIT 20;
```

```sql
-- 3.  See which matches belong to those three tournaments.
SELECT DISTINCT tm."MatchID",
                tm."TourneyID",
                t."TourneyLocation"
FROM "Tourney_Matches" AS tm
JOIN "Tournaments"     AS t  ON t."TourneyID" = tm."TourneyID"
WHERE t."TourneyLocation" IN ('Thunderbird Lanes', 'Totem Lanes', 'Bolero Lanes')
LIMIT 20;
```

```sql
-- 4.  Look at bowler‐game records (win = 1, handicap ≤ 190) for those matches.
SELECT DISTINCT bs."BowlerID",
                bs."MatchID",
                bs."GameNumber",
                bs."HandiCapScore",
                bs."WonGame"
FROM "Bowler_Scores"  AS bs
WHERE bs."WonGame" = 1
  AND bs."HandiCapScore" <= 190
  AND bs."MatchID" IN (SELECT tm."MatchID"
                       FROM "Tourney_Matches" AS tm
                       JOIN "Tournaments"     AS t
                         ON t."TourneyID" = tm."TourneyID"
                       WHERE t."TourneyLocation" IN ('Thunderbird Lanes', 'Totem Lanes', 'Bolero Lanes'))
LIMIT 20;
```

```sql
-- 5.  Which bowlers have at least one such win at *every* one of the three venues?
SELECT bs."BowlerID"
FROM   "Bowler_Scores" AS bs
JOIN   "Tourney_Matches" AS tm ON tm."MatchID" = bs."MatchID"
JOIN   "Tournaments"      AS t  ON t."TourneyID" = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes', 'Totem Lanes', 'Bolero Lanes')
GROUP BY bs."BowlerID"
HAVING COUNT(DISTINCT t."TourneyLocation") = 3
LIMIT 20;
```

```sql
-- 6.  Final answer – list each qualifying bowler’s wins (≤190 handicap) at the three venues.
SELECT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyDate",
       t."TourneyLocation"
FROM   "Bowlers"        AS b
JOIN   "Bowler_Scores"  AS bs ON bs."BowlerID" = b."BowlerID"
JOIN   "Tourney_Matches" AS tm ON tm."MatchID" = bs."MatchID"
JOIN   "Tournaments"     AS t  ON t."TourneyID" = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes', 'Totem Lanes', 'Bolero Lanes')
  AND  b."BowlerID" IN (     -- only bowlers who qualified in all three venues
       SELECT bs2."BowlerID"
       FROM   "Bowler_Scores" AS bs2
       JOIN   "Tourney_Matches" AS tm2 ON tm2."MatchID" = bs2."MatchID"
       JOIN   "Tournaments"     AS t2  ON t2."TourneyID" = tm2."TourneyID"
       WHERE  bs2."WonGame" = 1
         AND  bs2."HandiCapScore" <= 190
         AND  t2."TourneyLocation" IN ('Thunderbird Lanes', 'Totem Lanes', 'Bolero Lanes')
       GROUP BY bs2."BowlerID"
       HAVING COUNT(DISTINCT t2."TourneyLocation") = 3
)
ORDER BY b."BowlerLastName",
         b."BowlerFirstName",
         t."TourneyDate",
         bs."GameNumber"
LIMIT 20;
```
