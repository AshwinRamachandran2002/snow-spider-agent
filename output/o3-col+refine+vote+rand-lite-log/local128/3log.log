```sql
-- 1.  Look at all tournament locations that appear in the data
SELECT DISTINCT "TourneyLocation"
FROM "Tournaments"
LIMIT 20;
```

```sql
-- 2.  See every game where the bowler actually WON the game
SELECT DISTINCT "MatchID", "GameNumber", "BowlerID", "HandiCapScore"
FROM "Bowler_Scores"
WHERE "WonGame" = 1
LIMIT 20;
```

```sql
-- 3.  Bring in the tournament site for those winning games
SELECT DISTINCT bs."MatchID",
                bs."GameNumber",
                bs."BowlerID",
                bs."HandiCapScore",
                t."TourneyLocation"
FROM   "Bowler_Scores"      AS bs
JOIN   "Tourney_Matches"    AS tm ON tm."MatchID" = bs."MatchID"
JOIN   "Tournaments"        AS t  ON t."TourneyID" = tm."TourneyID"
WHERE  bs."WonGame" = 1
LIMIT 20;
```

```sql
-- 4.  Restrict to the three venues of interest and to games whose handicap score is ≤ 190
SELECT DISTINCT bs."MatchID",
                bs."GameNumber",
                bs."BowlerID",
                bs."HandiCapScore",
                t."TourneyLocation"
FROM   "Bowler_Scores"      AS bs
JOIN   "Tourney_Matches"    AS tm ON tm."MatchID" = bs."MatchID"
JOIN   "Tournaments"        AS t  ON t."TourneyID" = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes',
                               'Totem Lanes',
                               'Bolero Lanes')
LIMIT 20;
```

```sql
-- 5.  Count how many of the three venues each bowler has qualified at
SELECT bs."BowlerID",
       COUNT(DISTINCT t."TourneyLocation") AS venues_won_at
FROM   "Bowler_Scores" AS bs
JOIN   "Tourney_Matches" AS tm ON tm."MatchID" = bs."MatchID"
JOIN   "Tournaments"     AS t  ON t."TourneyID" = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes',
                               'Totem Lanes',
                               'Bolero Lanes')
GROUP  BY bs."BowlerID"
HAVING venues_won_at = 3
LIMIT 20;
```

```sql
-- 6.  Get the IDs of bowlers who satisfy the “won at all 3 locations” requirement
SELECT DISTINCT bs."BowlerID"
FROM   "Bowler_Scores" AS bs
JOIN   "Tourney_Matches" AS tm ON tm."MatchID" = bs."MatchID"
JOIN   "Tournaments"     AS t  ON t."TourneyID" = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes',
                               'Totem Lanes',
                               'Bolero Lanes')
GROUP  BY bs."BowlerID"
HAVING COUNT(DISTINCT t."TourneyLocation") = 3
LIMIT 20;
```

```sql
-- 7.  FINAL ANSWER: list each qualifying game record for those bowlers
SELECT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyDate",
       t."TourneyLocation"
FROM   "Bowler_Scores"  AS bs
JOIN   "Bowlers"        AS b  ON b."BowlerID" = bs."BowlerID"
JOIN   "Tourney_Matches" AS tm ON tm."MatchID" = bs."MatchID"
JOIN   "Tournaments"     AS t  ON t."TourneyID" = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes',
                               'Totem Lanes',
                               'Bolero Lanes')
  -- keep only bowlers who accomplished this at ALL three venues
  AND  bs."BowlerID" IN (
        SELECT bs2."BowlerID"
        FROM   "Bowler_Scores" AS bs2
        JOIN   "Tourney_Matches" AS tm2 ON tm2."MatchID" = bs2."MatchID"
        JOIN   "Tournaments"     AS t2  ON t2."TourneyID" = tm2."TourneyID"
        WHERE  bs2."WonGame" = 1
          AND  bs2."HandiCapScore" <= 190
          AND  t2."TourneyLocation" IN ('Thunderbird Lanes',
                                        'Totem Lanes',
                                        'Bolero Lanes')
        GROUP  BY bs2."BowlerID"
        HAVING COUNT(DISTINCT t2."TourneyLocation") = 3
       )
ORDER BY b."BowlerLastName",
         b."BowlerFirstName",
         t."TourneyDate",
         bs."MatchID",
         bs."GameNumber"
LIMIT 20;
```

These seven progressively more complex queries culminate in Query 7, which returns exactly the game-level rows in which a bowler won with a handicap score ≤ 190 at each of the three specified venues (Thunderbird Lanes, Totem Lanes, and Bolero Lanes).
