-- 4.  Restrict to the three venues of interest and to games whose handicap score is ≤ 190
SELECT DISTINCT bs."MatchID",
                bs."GameNumber",
                bs."BowlerID",
                bs."HandiCapScore",
                t."TourneyLocation"
FROM   "Bowler_Scores"      AS bs
JOIN   "Tourney_Matches"    AS tm ON tm."MatchID" = bs."MatchID"
JOIN   "Tournaments"        AS t  ON t."TourneyID" = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes',
                               'Totem Lanes',
                               'Bolero Lanes')
LIMIT 20;
