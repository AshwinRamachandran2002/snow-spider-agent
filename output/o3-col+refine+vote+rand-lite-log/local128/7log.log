```sql
-- 1. Preview raw game results: scores, winners, etc.
SELECT DISTINCT *
FROM "Bowler_Scores"
LIMIT 20;
```

```sql
-- 2. Look at the available tournaments (their dates & locations).
SELECT DISTINCT *
FROM "Tournaments"
LIMIT 20;
```

```sql
-- 3. See how matches are linked to tournaments (Match → Tourney).
SELECT DISTINCT *
FROM "Tourney_Matches"
LIMIT 20;
```

```sql
-- 4. Join a single game result to its tournament to verify columns line-up.
SELECT DISTINCT bs."MatchID",
       bs."GameNumber",
       bs."BowlerID",
       bs."HandiCapScore",
       bs."WonGame",
       t."TourneyDate",
       t."TourneyLocation"
FROM   "Bowler_Scores" AS bs
JOIN   "Tourney_Matches"  tm ON tm."MatchID" = bs."MatchID"
JOIN   "Tournaments"      t  ON t."TourneyID" = tm."TourneyID"
LIMIT 20;
```

```sql
-- 5. Pull only winning games whose handicap score is ≤ 190,
--    together with the tournament site.
SELECT DISTINCT bs."BowlerID",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyLocation"
FROM   "Bowler_Scores" AS bs
JOIN   "Tourney_Matches"  tm ON tm."MatchID" = bs."MatchID"
JOIN   "Tournaments"      t  ON t."TourneyID" = tm."TourneyID"
WHERE  bs."WonGame"      = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes',
                               'Totem Lanes',
                               'Bolero Lanes')
LIMIT 20;
```

```sql
-- 6. List, per bowler, the distinct venues at which the
--    bowler has such a qualifying win.
SELECT DISTINCT bs."BowlerID",
       t."TourneyLocation"
FROM   "Bowler_Scores" AS bs
JOIN   "Tourney_Matches"  tm ON tm."MatchID" = bs."MatchID"
JOIN   "Tournaments"      t  ON t."TourneyID" = tm."TourneyID"
WHERE  bs."WonGame"      = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes',
                               'Totem Lanes',
                               'Bolero Lanes')
LIMIT 20;
```

```sql
-- 7. Find bowlers who have qualifying wins at *all three* venues.
SELECT   bs."BowlerID"
FROM     "Bowler_Scores" AS bs
JOIN     "Tourney_Matches"  tm ON tm."MatchID" = bs."MatchID"
JOIN     "Tournaments"      t  ON t."TourneyID" = tm."TourneyID"
WHERE    bs."WonGame"      = 1
  AND    bs."HandiCapScore" <= 190
  AND    t."TourneyLocation" IN ('Thunderbird Lanes',
                                 'Totem Lanes',
                                 'Bolero Lanes')
GROUP BY bs."BowlerID"
HAVING   COUNT(DISTINCT t."TourneyLocation") = 3
LIMIT 20;
```

```sql
-- 8. Show the human-readable names of the bowlers who satisfied the above.
SELECT DISTINCT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName"
FROM   "Bowlers" AS b
WHERE  b."BowlerID" IN (
        SELECT   bs."BowlerID"
        FROM     "Bowler_Scores" AS bs
        JOIN     "Tourney_Matches"  tm ON tm."MatchID" = bs."MatchID"
        JOIN     "Tournaments"      t  ON t."TourneyID" = tm."TourneyID"
        WHERE    bs."WonGame"      = 1
          AND    bs."HandiCapScore" <= 190
          AND    t."TourneyLocation" IN ('Thunderbird Lanes',
                                         'Totem Lanes',
                                         'Bolero Lanes')
        GROUP BY bs."BowlerID"
        HAVING   COUNT(DISTINCT t."TourneyLocation") = 3
)
LIMIT 20;
```

```sql
-- 9. Produce the final requested list: every qualifying game
--    (only those ≤190, won, and at the three sites) but *only*
--    for bowlers who have done it at all three venues.
SELECT  b."BowlerID",
        b."BowlerFirstName",
        b."BowlerLastName",
        bs."MatchID",
        bs."GameNumber",
        bs."HandiCapScore",
        t."TourneyDate",
        t."TourneyLocation"
FROM    "Bowler_Scores"  AS bs
JOIN    "Bowlers"        AS b  ON b."BowlerID" = bs."BowlerID"
JOIN    "Tourney_Matches" AS tm ON tm."MatchID" = bs."MatchID"
JOIN    "Tournaments"     AS t  ON t."TourneyID" = tm."TourneyID"
WHERE   bs."WonGame"      = 1
  AND   bs."HandiCapScore" <= 190
  AND   t."TourneyLocation" IN ('Thunderbird Lanes',
                                'Totem Lanes',
                                'Bolero Lanes')
  AND   bs."BowlerID" IN (
        SELECT   bs2."BowlerID"
        FROM     "Bowler_Scores" AS bs2
        JOIN     "Tourney_Matches"  tm2 ON tm2."MatchID" = bs2."MatchID"
        JOIN     "Tournaments"      t2  ON t2."TourneyID" = tm2."TourneyID"
        WHERE    bs2."WonGame"      = 1
          AND    bs2."HandiCapScore" <= 190
          AND    t2."TourneyLocation" IN ('Thunderbird Lanes',
                                          'Totem Lanes',
                                          'Bolero Lanes')
        GROUP BY bs2."BowlerID"
        HAVING   COUNT(DISTINCT t2."TourneyLocation") = 3
)
LIMIT 20;
```

```sql
--10. (Optional) Order the final report by bowler & tournament date.
SELECT  b."BowlerID",
        b."BowlerFirstName",
        b."BowlerLastName",
        bs."MatchID",
        bs."GameNumber",
        bs."HandiCapScore",
        t."TourneyDate",
        t."TourneyLocation"
FROM    "Bowler_Scores"  AS bs
JOIN    "Bowlers"        AS b  ON b."BowlerID" = bs."BowlerID"
JOIN    "Tourney_Matches" AS tm ON tm."MatchID" = bs."MatchID"
JOIN    "Tournaments"     AS t  ON t."TourneyID" = tm."TourneyID"
WHERE   bs."WonGame"      = 1
  AND   bs."HandiCapScore" <= 190
  AND   t."TourneyLocation" IN ('Thunderbird Lanes',
                                'Totem Lanes',
                                'Bolero Lanes')
  AND   bs."BowlerID" IN (
        SELECT   bs2."BowlerID"
        FROM     "Bowler_Scores" AS bs2
        JOIN     "Tourney_Matches"  tm2 ON tm2."MatchID" = bs2."MatchID"
        JOIN     "Tournaments"      t2  ON t2."TourneyID" = tm2."TourneyID"
        WHERE    bs2."WonGame"      = 1
          AND    bs2."HandiCapScore" <= 190
          AND    t2."TourneyLocation" IN ('Thunderbird Lanes',
                                          'Totem Lanes',
                                          'Bolero Lanes')
        GROUP BY bs2."BowlerID"
        HAVING   COUNT(DISTINCT t2."TourneyLocation") = 3
)
ORDER BY b."BowlerLastName",
         b."BowlerFirstName",
         t."TourneyDate",
         bs."GameNumber"
LIMIT 20;
```
