```sql
-- 1. Description: Inspect all known tournaments (date & location).
SELECT * 
FROM "Tournaments"
LIMIT 20;
```

```sql
-- 2. Description: List every distinct bowling-center (venue) name we have on file.
SELECT DISTINCT "TourneyLocation"
FROM "Tournaments"
LIMIT 20;
```

```sql
-- 3. Description: See some individual game rows that were won with a handicap score ≤ 190.
SELECT *
FROM "Bowler_Scores"
WHERE "WonGame" = 1
  AND "HandiCapScore" <= 190
LIMIT 20;
```

```sql
-- 4. Description: Marry a won-game record to its tournament so we can see where it was bowled.
SELECT bs."BowlerID",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyDate",
       t."TourneyLocation"
FROM   "Bowler_Scores"  AS bs
JOIN   "Tourney_Matches" AS tm ON tm."MatchID"   = bs."MatchID"
JOIN   "Tournaments"     AS t  ON t."TourneyID"  = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
LIMIT 20;
```

```sql
-- 5. Description: For each bowler, show the distinct venues where they’ve had such wins.
SELECT DISTINCT bs."BowlerID",
       t."TourneyLocation"
FROM   "Bowler_Scores"  AS bs
JOIN   "Tourney_Matches" AS tm ON tm."MatchID"  = bs."MatchID"
JOIN   "Tournaments"     AS t  ON t."TourneyID" = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
LIMIT 20;
```

```sql
-- 6. Description: Count how many of the target three venues each bowler has covered.
SELECT bs."BowlerID",
       COUNT(DISTINCT t."TourneyLocation") AS "venues_with_wins"
FROM   "Bowler_Scores"  AS bs
JOIN   "Tourney_Matches" AS tm ON tm."MatchID"  = bs."MatchID"
JOIN   "Tournaments"     AS t  ON t."TourneyID" = tm."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes',
                               'Totem Lanes',
                               'Bolero Lanes')
GROUP BY bs."BowlerID"
LIMIT 20;
```

```sql
-- 7. Description (FINAL ANSWER): List every individual game (≤ 190 handicap) 
-- for bowlers who have achieved such wins at ALL THREE venues:
-- Thunderbird Lanes, Totem Lanes, and Bolero Lanes.
WITH WinningGames AS (
    SELECT bs."BowlerID",
           bs."MatchID",
           bs."GameNumber",
           bs."HandiCapScore",
           t."TourneyDate",
           t."TourneyLocation"
    FROM   "Bowler_Scores"  AS bs
    JOIN   "Tourney_Matches" AS tm ON tm."MatchID"  = bs."MatchID"
    JOIN   "Tournaments"     AS t  ON t."TourneyID" = tm."TourneyID"
    WHERE  bs."WonGame" = 1
      AND  bs."HandiCapScore" <= 190
      AND  t."TourneyLocation" IN ('Thunderbird Lanes',
                                   'Totem Lanes',
                                   'Bolero Lanes')
),
QualifiedBowlers AS (
    SELECT "BowlerID"
    FROM   WinningGames
    GROUP BY "BowlerID"
    HAVING COUNT(DISTINCT "TourneyLocation") = 3   -- must have a win at all 3 sites
)
SELECT b."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName",
       wg."MatchID",
       wg."GameNumber",
       wg."HandiCapScore",
       wg."TourneyDate",
       wg."TourneyLocation"
FROM   WinningGames  AS wg
JOIN   QualifiedBowlers AS qb ON qb."BowlerID" = wg."BowlerID"
JOIN   "Bowlers"     AS b  ON b."BowlerID" = wg."BowlerID"
ORDER BY b."BowlerLastName",
         b."BowlerFirstName",
         wg."TourneyDate",
         wg."MatchID",
         wg."GameNumber"
LIMIT 20;
```
