Query:
--Description: 5) Identify the bowlers who have at least one such win
--               at EACH of the three venues (all-three check)
SELECT sub."BowlerID"
FROM (
     SELECT bs."BowlerID",
            t."TourneyLocation"
     FROM   "Bowler_Scores"  AS bs
     JOIN   "Tourney_Matches" AS tm ON tm."MatchID" = bs."MatchID"
     JOIN   "Tournaments"     AS t  ON t."TourneyID" = tm."TourneyID"
     WHERE  bs."WonGame" = 1
       AND  bs."HandiCapScore" <= 190
       AND  t."TourneyLocation" IN ('Thunderbird Lanes',
                                    'Totem Lanes',
                                    'Bolero Lanes')
     GROUP BY bs."BowlerID",
              t."TourneyLocation"
) AS sub
GROUP BY sub."BowlerID"
HAVING COUNT(DISTINCT sub."TourneyLocation") = 3
LIMIT 20;
