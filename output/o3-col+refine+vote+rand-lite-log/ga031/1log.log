Query:
--Description: Show the different page_title values that contain the word “checkout” to discover the Confirmation page name.
SELECT DISTINCT
  ep.value.string_value AS page_title
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` AS t
JOIN UNNEST(t.event_params) AS ep
WHERE t.event_name = 'page_view'
  AND ep.key = 'page_title'
  AND LOWER(ep.value.string_value) LIKE '%checkout%'
LIMIT 20;
