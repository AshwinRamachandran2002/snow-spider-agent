--Description: Count sessions that saw BOTH the Home page and the Checkout Confirmation page.
WITH pages AS (
  SELECT
    t.user_pseudo_id AS uid,
    (SELECT ep2.value.int_value
     FROM UNNEST(t.event_params) ep2
     WHERE ep2.key = 'ga_session_id') AS session_id,
    MAX(CASE WHEN ep1.key = 'page_location'
              AND ep1.value.string_value = 'https://googlemerchandisestore.com/' THEN 1 END) AS saw_home,
    MAX(CASE WHEN ep1.key = 'page_title'
              AND LOWER(ep1.value.string_value) LIKE '%checkout%confirmation%' THEN 1 END) AS saw_checkout
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` AS t
  JOIN UNNEST(t.event_params) AS ep1
  WHERE t.event_name = 'page_view'
  GROUP BY uid, session_id
)
SELECT
  COUNTIF(saw_home = 1 AND saw_checkout = 1) AS sessions_home_and_checkout
FROM pages
LIMIT 20;
