Query:
--Description: Grab the sessions (user_pseudo_id + ga_session_id) that landed on the Home page.
SELECT DISTINCT
  t.user_pseudo_id,
  (SELECT ep2.value.int_value
   FROM UNNEST(t.event_params) ep2
   WHERE ep2.key = 'ga_session_id') AS ga_session_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` AS t
JOIN UNNEST(t.event_params) AS ep1
WHERE t.event_name = 'page_view'
  AND ep1.key = 'page_location'
  AND ep1.value.string_value = 'https://googlemerchandisestore.com/'
LIMIT 20;
