```sql
--Description: Compute the session-level conversion rate for 02-Jan-2021, where a
--“conversion” is defined as a single session (user_pseudo_id + ga_session_id)
--whose page_view titles include BOTH
--    • a Home page hit (title contains “google online store” OR equals “home”)
--    • a Checkout Confirmation hit (title contains “checkout confirmation”)
--Steps inside this single statement:
-- 1. pages CTE – for every 20210102 page_view row, extract user_pseudo_id,
--    ga_session_id (pulled from event_params), and the lower-cased page_title.
-- 2. flags CTE – aggregate by session and use MAX(IF()) to set has_home / has_checkout.
-- 3. stats CTE – count total Home sessions (denominator) and sessions that
--    have both flags (numerator).
-- 4. Final SELECT – return the two counts and the percentage conversion rate.
WITH pages AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
     FROM UNNEST(event_params) ep
     WHERE ep.key = 'ga_session_id')                 AS ga_session_id,
    LOWER(pt.value.string_value)                     AS title
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS pt
  WHERE event_name = 'page_view'
    AND event_date = '20210102'
    AND pt.key = 'page_title'
),
flags AS (
  SELECT
    user_pseudo_id,
    ga_session_id,
    MAX(IF(title LIKE '%google online store%' OR title = 'home', 1, 0)) AS has_home,
    MAX(IF(title LIKE '%checkout confirmation%',        1, 0)) AS has_checkout
  FROM pages
  GROUP BY user_pseudo_id, ga_session_id
),
stats AS (
  SELECT
    COUNTIF(has_home = 1)                              AS home_sessions,
    COUNTIF(has_home = 1 AND has_checkout = 1)         AS converted_sessions
  FROM flags
)
SELECT
  home_sessions,
  converted_sessions,
  SAFE_MULTIPLY(SAFE_DIVIDE(converted_sessions, home_sessions), 100)
    AS conversion_rate_pct
FROM stats;
```
