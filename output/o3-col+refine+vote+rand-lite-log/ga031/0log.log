--Description: 8) Count all 02-Jan-2021 user-sessions that contained at least one Home page
--              view (title contains “google online store” OR equals “home”).
SELECT
  COUNT(DISTINCT CONCAT(user_pseudo_id, '-',
         (SELECT ep.value.int_value
          FROM UNNEST(event_params) ep
          WHERE ep.key = 'ga_session_id'))) AS home_sessions
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
WHERE event_name = 'page_view'
  AND event_date = '20210102'
  AND EXISTS (
        SELECT 1
        FROM UNNEST(event_params) ep
        WHERE ep.key = 'page_title'
          AND (LOWER(ep.value.string_value) LIKE '%google online store%'
               OR LOWER(ep.value.string_value) = 'home')
      )
