--Description: one-shot query (thinking process embedded).
--Objective: For 2-Jan-2021 GA4 data, compute session-level conversion rate where a
--session (user_pseudo_id + ga_session_id) viewed BOTH a “Home” page
--  ‑ title contains 'google online store' OR equals 'home'
--AND a “Checkout Confirmation” page (title contains 'checkout confirmation'),
--divided by all sessions that viewed the Home page.
--Implementation plan inside one SQL:
-- 1) page_titles CTE – extract, for every 20210102 page_view row, the user,
--    session id (ga_session_id) and lowercase page_title.
-- 2) session_flags CTE – aggregate titles per session and set two Boolean flags:
--       has_home, has_checkout.
-- 3) stat CTE         – count total Home sessions (denominator) and
--                       sessions with both flags (numerator).
-- 4) final SELECT      – expose the two counts and % conversion.
WITH page_titles AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
     FROM UNNEST(event_params) ep
     WHERE ep.key = 'ga_session_id')            AS ga_session_id,
    LOWER(pt.value.string_value)                AS title
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS pt
  WHERE event_name = 'page_view'
    AND event_date = '20210102'
    AND pt.key = 'page_title'
),
session_flags AS (
  SELECT
    user_pseudo_id,
    ga_session_id,
    BOOL_OR(title LIKE '%google online store%' OR title = 'home')            AS has_home,
    BOOL_OR(title LIKE '%checkout confirmation%')                            AS has_checkout
  FROM page_titles
  GROUP BY user_pseudo_id, ga_session_id
),
stat AS (
  SELECT
    COUNTIF(has_home)                                              AS home_sessions,
    COUNTIF(has_home AND has_checkout)                             AS converted_sessions
  FROM session_flags
)
SELECT
  home_sessions,
  converted_sessions,
  SAFE_MULTIPLY(SAFE_DIVIDE(converted_sessions, home_sessions),100)
    AS conversion_rate_pct
FROM stat;
