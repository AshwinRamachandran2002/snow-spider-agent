Query:
--Description: 10) Final query – calculate the Home-to-Checkout Confirmation session
--              conversion rate for 02-Jan-2021.
WITH
numerator AS (
  SELECT
    COUNT(DISTINCT CONCAT(user_pseudo_id, '-',
           (SELECT ep.value.int_value
            FROM UNNEST(event_params) ep
            WHERE ep.key = 'ga_session_id'))) AS converted_sessions
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
    AND event_date = '20210102'
    AND EXISTS (
          SELECT 1
          FROM UNNEST(event_params) ep
          WHERE ep.key = 'page_title'
            AND (LOWER(ep.value.string_value) LIKE '%google online store%'
                 OR LOWER(ep.value.string_value) = 'home')
        )
    AND EXISTS (
          SELECT 1
          FROM UNNEST(event_params) ep
          WHERE ep.key = 'page_title'
            AND LOWER(ep.value.string_value) LIKE '%checkout confirmation%'
        )
),
denominator AS (
  SELECT
    COUNT(DISTINCT CONCAT(user_pseudo_id, '-',
           (SELECT ep.value.int_value
            FROM UNNEST(event_params) ep
            WHERE ep.key = 'ga_session_id'))) AS home_sessions
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
    AND event_date = '20210102'
    AND EXISTS (
          SELECT 1
          FROM UNNEST(event_params) ep
          WHERE ep.key = 'page_title'
            AND (LOWER(ep.value.string_value) LIKE '%google online store%'
                 OR LOWER(ep.value.string_value) = 'home')
        )
)
SELECT
  denominator.home_sessions,
  numerator.converted_sessions,
  SAFE_MULTIPLY(
      SAFE_DIVIDE(numerator.converted_sessions, denominator.home_sessions), 100
  ) AS session_conversion_rate_pct
FROM numerator, denominator
