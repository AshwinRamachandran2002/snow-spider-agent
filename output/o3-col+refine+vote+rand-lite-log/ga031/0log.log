        )
), (
  --denominator
  SELECT COUNT(DISTINCT CONCAT(user_pseudo_id, '-', 
         (SELECT ep.value.int_value FROM UNNEST(event_params) ep WHERE ep.key='ga_session_id'))) AS home_sessions
