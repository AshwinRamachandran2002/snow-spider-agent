/* ---------- ACS 5-year unemployment counts ---------- */
acs_2015 AS (
  SELECT
    SUBSTR(geo_id, 10, 5)  AS county_fips,          -- 5-digit county FIPS
    unemployed_pop         AS unemployed_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  WHERE unemployed_pop IS NOT NULL
),
acs_2018 AS (
  SELECT
    SUBSTR(geo_id, 10, 5)  AS county_fips,
    unemployed_pop         AS unemployed_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE unemployed_pop IS NOT NULL
),
unemp_increase AS (                          -- unemployment rose
  SELECT a18.county_fips
  FROM acs_2015 a15
  JOIN acs_2018 a18 USING (county_fips)
  WHERE a18.unemployed_2018 > a15.unemployed_2015
),

/* ---------- CMS dual-eligible enrollee counts ---------- */
dual_2015 AS (
  SELECT
    CONCAT(
      LPAD(CAST(state_fips_code  AS STRING), 2, '0'),
      LPAD(CAST(county_fips_code AS STRING), 3, '0')
    )                         AS county_fips,
    SUM(Public_Total)         AS dual_2015
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2015-12-01'
  GROUP BY county_fips
),
dual_2018 AS (
  SELECT
    CONCAT(
      LPAD(CAST(state_fips_code  AS STRING), 2, '0'),
      LPAD(CAST(county_fips_code AS STRING), 3, '0')
    )                         AS county_fips,
    SUM(Public_Total)         AS dual_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2018-12-01'
  GROUP BY county_fips
),
dual_decrease AS (                            -- enrollee count declined
  SELECT d18.county_fips
  FROM dual_2015 d15
  JOIN dual_2018 d18 USING (county_fips)
  WHERE d18.dual_2018 < d15.dual_2015
)

