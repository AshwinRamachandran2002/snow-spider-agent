```sql
--Description:
-- Return the number of U.S. counties that satisfy BOTH of the study conditions:
--   1) Their American Community Survey (ACS) 5-year unemployment_rate rose
--      between the 2015 and 2018 releases.
--   2) Their CMS dual-eligible enrollee count fell between the snapshots
--      taken on 2015-12-01 and 2018-12-01.
--
-- Strategy
-- ───────────────────────────────────────────────────────────────
-- • From each ACS table, pull `name` and `unemployment_rate`.
--   – Strip trailing geography words (County, Parish, Borough …) from `name`
--     and lowercase it to build a joinable “county_key”.
-- • Keep counties where 2018 unemployment_rate > 2015 unemployment_rate.
-- • From the CMS table, aggregate enrollee counts for the two target dates
--   and keep counties where 2018 < 2015.
-- • Intersect the two county sets and count the result.
WITH
acs15 AS (
  SELECT
    LOWER(REGEXP_EXTRACT(name,
          r'^(.*?) (County|Parish|Borough|Census Area|Municipality)')) AS county_key,
    unemployment_rate AS unemp_rate_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  WHERE name IS NOT NULL
),
acs18 AS (
  SELECT
    LOWER(REGEXP_EXTRACT(name,
          r'^(.*?) (County|Parish|Borough|Census Area|Municipality)')) AS county_key,
    unemployment_rate AS unemp_rate_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE name IS NOT NULL
),
unemp_up AS (
  SELECT a.county_key
  FROM   acs15 a
  JOIN   acs18 b USING (county_key)
  WHERE  b.unemp_rate_2018 > a.unemp_rate_2015
),
dual AS (
  SELECT
    LOWER(County_Name) AS county_key,
    MAX(IF(Date = '2015-12-01', Public_Total, NULL)) AS enrol_2015,
    MAX(IF(Date = '2018-12-01', Public_Total, NULL)) AS enrol_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date IN ('2015-12-01','2018-12-01')
  GROUP BY county_key
),
enrol_down AS (
  SELECT county_key
  FROM   dual
  WHERE  enrol_2015 IS NOT NULL
     AND enrol_2018 IS NOT NULL
     AND enrol_2018 < enrol_2015
)
SELECT COUNT(*) AS county_count
FROM   unemp_up
JOIN   enrol_down USING (county_key);
