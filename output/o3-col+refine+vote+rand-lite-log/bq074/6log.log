```sql
--Description:
-- 1.  Each ACS county table contains a `name` field like
--     “Autauga County, Alabama”.  We convert that to a plain county
--     label (e.g., “autauga”) with REGEXP_EXTRACT and LOWER.
-- 2.  We keep counties whose unemployment_rate rose from 2015 → 2018.
-- 3.  From CMS dual-eligible data we take the snapshots on
--     2015-12-01 and 2018-12-01, keeping counties where enrollee
--     counts fell.
-- 4.  The final answer is the number of counties that satisfy both
--     conditions (intersection of the two sets).

WITH
acs15 AS (
  SELECT
    LOWER(REGEXP_EXTRACT(name, r'^(.*?) (County|Parish|Borough|Census Area|Municipality)')) AS county_key,
    unemployment_rate AS unemp_rate_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  WHERE name LIKE '% County,%'      -- retain normal county rows
),
acs18 AS (
  SELECT
    LOWER(REGEXP_EXTRACT(name, r'^(.*?) (County|Parish|Borough|Census Area|Municipality)')) AS county_key,
    unemployment_rate AS unemp_rate_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE name LIKE '% County,%'
),
unemp_up AS (
  SELECT a.county_key
  FROM acs15 a
  JOIN acs18 b USING (county_key)
  WHERE b.unemp_rate_2018 > a.unemp_rate_2015
),
dual AS (
  SELECT
    LOWER(County_Name) AS county_key,
    MAX(IF(Date = '2015-12-01', Public_Total, NULL)) AS enroll_2015,
    MAX(IF(Date = '2018-12-01', Public_Total, NULL)) AS enroll_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date IN ('2015-12-01','2018-12-01')
  GROUP BY county_key
),
enroll_down AS (
  SELECT county_key
  FROM dual
  WHERE enroll_2015 IS NOT NULL
    AND enroll_2018 IS NOT NULL
    AND enroll_2018 < enroll_2015
)
SELECT COUNT(*) AS county_count
FROM unemp_up
JOIN enroll_down USING (county_key);
```
