```sql
--Description:
-- Identify counties whose unemployment rate rose from the 2015 ACS 5-year
-- release to the 2018 ACS 5-year release.  Because the tables have no
-- `county_name` column, we:
--   • derive a 5-digit county FIPS code from `geo_id` (characters 8-12),
--   • join the 2015 and 2018 snapshots on that FIPS,
--   • keep only those counties where the 2018 unemployment_rate exceeds
--     the 2015 unemployment_rate.
WITH
acs15 AS (
  SELECT
    SUBSTR(geo_id, 8, 5) AS county_fips,
    unemployment_rate     AS unemp_rate_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
),
acs18 AS (
  SELECT
    SUBSTR(geo_id, 8, 5) AS county_fips,
    unemployment_rate     AS unemp_rate_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
)
SELECT
  a.county_fips,
  a.unemp_rate_2015,
  b.unemp_rate_2018
FROM acs15 a
JOIN acs18 b USING (county_fips)
WHERE b.unemp_rate_2018 > a.unemp_rate_2015
LIMIT 20;
