```sql
--Description:
-- Count U.S. counties that (1) saw their ACS 5-year unemployment rate rise from 2015→2018
-- and (2) saw their CMS dual-eligible enrollee count fall between 2015-12-01 and 2018-12-01.
-- “county_name” is parsed from the ACS `name` field (e.g., “Autauga County, Alabama”)
-- and matched—case-insensitively—to the County_Name in the CMS file.
WITH
-- Pull unemployment rate for 2015
acs15 AS (
  SELECT
    LOWER(REGEXP_EXTRACT(name, r'^(.*) County')) AS county_name,
    unemployment_rate AS unemp_rate_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
),
-- Pull unemployment rate for 2018
acs18 AS (
  SELECT
    LOWER(REGEXP_EXTRACT(name, r'^(.*) County')) AS county_name,
    unemployment_rate AS unemp_rate_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
),
-- Join the two ACS snapshots to find counties with rising unemployment
unemp_up AS (
  SELECT
    a.county_name
  FROM acs15 a
  JOIN acs18 b USING (county_name)
  WHERE b.unemp_rate_2018 > a.unemp_rate_2015
),
-- Build dual-eligible enrollee counts for the two dates
dual_counts AS (
  SELECT
    LOWER(County_Name) AS county_name,
    MAX(CASE WHEN Date = '2015-12-01' THEN Public_Total END) AS enrollees_2015,
    MAX(CASE WHEN Date = '2018-12-01' THEN Public_Total END) AS enrollees_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date IN ('2015-12-01','2018-12-01')
  GROUP BY county_name
),
-- Keep counties whose enrollee count fell
enroll_down AS (
  SELECT county_name
  FROM dual_counts
  WHERE enrollees_2018 < enrollees_2015
)
-- Final count: intersection of rising-unemployment and falling-enrollee counties
SELECT COUNT(*) AS county_count
FROM unemp_up
JOIN enroll_down USING (county_name);
```
