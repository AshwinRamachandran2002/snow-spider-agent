--Description:
-- Fix step 5 by using columns that actually exist in both ACS tables.
-- • Neither table has `county_name`; instead, we extract the 5-digit county
--   FIPS code from `geo_id` (characters 8-12).
-- • They also don’t share a simple `unemployment_rate` column, so we build
--   the rate on-the-fly:
--       unemployed_civilian_16_over / labor_force_civilian_16_over
--   (SAFE_DIVIDE avoids division-by-zero).
-- • We then join 2015 and 2018 snapshots on county FIPS and keep counties
--   where the 2018 rate is higher than the 2015 rate.  A sample of 20 results
--   is returned for verification.
WITH acs_2015 AS (
  SELECT
    SUBSTR(geo_id, 8, 5) AS county_fips,
    SAFE_DIVIDE(unemployed_civilian_16_over,
                labor_force_civilian_16_over) AS unemp_rate_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  WHERE labor_force_civilian_16_over > 0
),
acs_2018 AS (
  SELECT
    SUBSTR(geo_id, 8, 5) AS county_fips,
    SAFE_DIVIDE(unemployed_civilian_16_over,
                labor_force_civilian_16_over) AS unemp_rate_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE labor_force_civilian_16_over > 0
)
SELECT
  a.county_fips,
  a.unemp_rate_2015,
  b.unemp_rate_2018
FROM acs_2015 a
JOIN acs_2018 b USING (county_fips)
WHERE b.unemp_rate_2018 > a.unemp_rate_2015
LIMIT 20;
```
