```sql
-- 8) Derive counties whose dual-eligible enrollee counts DECREASED between the two dates
SELECT 
  a.County_Name
FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`  AS a
JOIN `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`  AS b
  ON LOWER(a.County_Name) = LOWER(b.County_Name)
WHERE a.Date = '2015-12-01'
  AND b.Date = '2018-12-01'
  AND b.Public_Total < a.Public_Total
LIMIT 20;
```

```sql
-- 9) Combine both filters: unemployment ↑ 2015→2018  AND dual-eligible enrollment ↓ 2015-12-01→2018-12-01
SELECT COUNT(*) AS county_count
FROM (
  SELECT DISTINCT LOWER(c.County_Name) AS county_name
  FROM (
        -- counties with unemployment increase
        SELECT LOWER(a.county_name) AS county_name
        FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr` AS a
        JOIN `bigquery-public-data.census_bureau_acs.county_2018_5yr` AS b
          ON LOWER(a.county_name) = LOWER(b.county_name)
        WHERE b.unemployment_rate > a.unemployment_rate
       ) unemp_up
  JOIN (
        -- counties with dual-eligible enrollee decrease
        SELECT LOWER(a.County_Name) AS county_name
        FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program` AS a
        JOIN `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program` AS b
          ON LOWER(a.County_Name) = LOWER(b.County_Name)
        WHERE a.Date = '2015-12-01'
          AND b.Date = '2018-12-01'
          AND b.Public_Total < a.Public_Total
       ) enroll_down
    ON unemp_up.county_name = enroll_down.county_name
) ;
```

