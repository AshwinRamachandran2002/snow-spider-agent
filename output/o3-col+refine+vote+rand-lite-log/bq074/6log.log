  FROM acs_2015 a15
  JOIN acs_2018 a18 USING (county_fips)
  WHERE a18.unemployed_2018 > a15.unemployed_2015
),

/* ---------- CMS dual-eligible enrollee counts ---------- */
dual_2015 AS (
