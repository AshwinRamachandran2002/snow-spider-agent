```sql
/*  How many counties (1) had higher unemployment in the 2018 ACS 5-yr file
    than in the 2015 ACS 5-yr file, and (2) saw dual-eligible enrollee totals
    drop between 2015-12-01 and 2018-12-01?                                     */

WITH unemployment_growth AS (               -- counties with rising unemployment
  SELECT
    SUBSTR(u15.geo_id, 10) AS county_fips   -- 5-digit county FIPS
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr` AS u15
  JOIN `bigquery-public-data.census_bureau_acs.county_2018_5yr` AS u18
    ON u15.geo_id = u18.geo_id
  WHERE u18.unemployed_pop > u15.unemployed_pop
  GROUP BY county_fips
),

unemp_named AS (                            -- attach county names to those FIPS
  SELECT
    UPPER(c.name) AS county_name
  FROM unemployment_growth AS u
  JOIN `bigquery-public-data.geo_us_boundaries.counties` AS c
    ON c.geoid = u.county_fips
),

dual_change AS (                            -- counties with falling dual totals
  SELECT
    UPPER(County_Name) AS county_name,
    SUM(CASE WHEN Date = DATE '2015-12-01' THEN Public_Total END) AS dual_2015,
    SUM(CASE WHEN Date = DATE '2018-12-01' THEN Public_Total END) AS dual_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date IN (DATE '2015-12-01', DATE '2018-12-01')
  GROUP BY county_name
  HAVING dual_2018 < dual_2015
)

SELECT COUNT(*) AS county_count
FROM unemp_named
JOIN dual_change USING (county_name);
```
