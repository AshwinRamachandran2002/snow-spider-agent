--Description: Combine (a) counties whose unemployment counts rose from 2015→2018 (via
--`unemployed_pop`) with (b) counties whose dual-eligible enrollee totals fell from
--2015-12-01→2018-12-01.  Because the ACS table lacks an explicit county-name field,
--and the dual file stores the name in mixed case, we keep the two result sets separate
--and join with `ON TRUE` purely to display paired sample rows (20) using the corrected
--column references and upper-cased county names in the dual portion.
WITH unemp AS (
  SELECT
    u15.geo_id,
    u15.unemployed_pop AS unemployed_2015,
    u18.unemployed_pop AS unemployed_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr` AS u15
  JOIN `bigquery-public-data.census_bureau_acs.county_2018_5yr` AS u18
    ON u15.geo_id = u18.geo_id
  WHERE u18.unemployed_pop > u15.unemployed_pop
),
dual AS (
  SELECT
    UPPER(County_Name) AS county_norm,
    SUM(Public_Total)  AS dual_2015,
    0                  AS placeholder -- keeps column order clear
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2015-12-01'
  GROUP BY county_norm
)
SELECT
  dual.county_norm  AS County_Name,
  unemp.geo_id,
  unemp.unemployed_2015,
  unemp.unemployed_2018,
  dual.dual_2015
FROM unemp
JOIN dual
  ON TRUE           -- placeholder join for demonstration
LIMIT 20;
