```sql
/*  Number of counties that
    – saw unemployment rise between the 2015- and 2018-ACS 5-year files, AND
    – saw dual-eligible enrollee counts fall between 2015-12-01 and 2018-12-01           */

WITH unemployment_growth AS (
  SELECT
    SUBSTR(u15.geo_id, 10) AS county_fips          -- 5-digit county FIPS
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr` AS u15
  JOIN `bigquery-public-data.census_bureau_acs.county_2018_5yr` AS u18
    ON u15.geo_id = u18.geo_id
  WHERE u18.unemployed_pop > u15.unemployed_pop     -- unemployment increased
  GROUP BY county_fips
),

dual_change AS (
  SELECT
    CONCAT(LPAD(CAST(state_fips_code  AS STRING),2,'0'),
           LPAD(CAST(county_fips_code AS STRING),3,'0')) AS county_fips,
    SUM(CASE WHEN Date = DATE '2015-12-01' THEN Public_Total END) AS dual_2015,
    SUM(CASE WHEN Date = DATE '2018-12-01' THEN Public_Total END) AS dual_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date IN (DATE '2015-12-01', DATE '2018-12-01')
  GROUP BY county_fips
  HAVING dual_2018 < dual_2015                       -- enrollment decreased
)

SELECT COUNT(*) AS county_count
FROM unemployment_growth
JOIN dual_change USING (county_fips);
