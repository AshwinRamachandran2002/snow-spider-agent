```sql
-- 7. Description: Counties whose dual-eligible counts dropped from 2015-12-01 to 2018-12-01
WITH d15 AS (
  SELECT County_Name, SUM(Public_Total) AS dual_2015
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2015-12-01'
  GROUP BY County_Name ),
d18 AS (
  SELECT County_Name, SUM(Public_Total) AS dual_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2018-12-01'
  GROUP BY County_Name )
SELECT d15.County_Name,
       d15.dual_2015,
       d18.dual_2018
FROM d15
JOIN d18
USING (County_Name)
WHERE d18.dual_2018 < d15.dual_2015
LIMIT 20;
```

```sql
-- 8. Description: List counties meeting BOTH criteria (↑ unemployment & ↓ dual-eligible counts)
WITH unemp AS (
  SELECT u15.geo_id,
         SPLIT(u15.name,' County')[OFFSET(0)] AS county_name_clean,
         u15.B23025_005E AS unemployed_2015,
         u18.B23025_005E AS unemployed_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr` AS u15
  JOIN `bigquery-public-data.census_bureau_acs.county_2018_5yr` AS u18
  ON  u15.geo_id = u18.geo_id
  WHERE u18.B23025_005E > u15.B23025_005E ),
dual AS (
  SELECT d15.County_Name,
         d15.dual_2015,
         d18.dual_2018
  FROM (
      SELECT County_Name, SUM(Public_Total) AS dual_2015
      FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
      WHERE Date = '2015-12-01'
      GROUP BY County_Name ) AS d15
  JOIN (
      SELECT County_Name, SUM(Public_Total) AS dual_2018
      FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
      WHERE Date = '2018-12-01'
      GROUP BY County_Name ) AS d18
  USING (County_Name)
  WHERE d18.dual_2018 < d15.dual_2015 )
SELECT unemp.county_name_clean,
       dual.dual_2015,
       dual.dual_2018,
       unemp.unemployed_2015,
       unemp.unemployed_2018
FROM unemp
JOIN dual
ON LOWER(unemp.county_name_clean) = LOWER(dual.County_Name)
LIMIT 20;
```

```sql
-- 9. Description: Final count of counties with ↑ unemployment (2015→2018) AND ↓ dual-eligible enrollment (Dec-2015→Dec-2018)
WITH unemp AS (
  SELECT u15.geo_id,
         SPLIT(u15.name,' County')[OFFSET(0)] AS county_name_clean
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr` AS u15
  JOIN `bigquery-public-data.census_bureau_acs.county_2018_5yr`   AS u18
  ON  u15.geo_id = u18.geo_id
  WHERE u18.B23025_005E > u15.B23025_005E ),
dual AS (
  SELECT d15.County_Name
  FROM (
      SELECT County_Name, SUM(Public_Total) AS dual_2015
      FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
      WHERE Date = '2015-12-01'
      GROUP BY County_Name ) AS d15
  JOIN (
      SELECT County_Name, SUM(Public_Total) AS dual_2018
      FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
      WHERE Date = '2018-12-01'
      GROUP BY County_Name ) AS d18
  USING (County_Name)
  WHERE d18.dual_2018 < d15.dual_2015 )
SELECT COUNT(*) AS counties_meeting_both_criteria
FROM unemp
JOIN dual
ON LOWER(unemp.county_name_clean) = LOWER(dual.County_Name);
