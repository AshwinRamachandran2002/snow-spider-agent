--Description: Display distinct county names from the dual-eligible table that experienced
--a decline in enrollee counts (2015-12-01→2018-12-01) alongside a sample of increased
--unemployment GEOIDs.  This uses corrected column names and upper-casing for the dual side.
WITH dual_decline AS (
  SELECT
    UPPER(County_Name) AS county_norm
  FROM (
      SELECT UPPER(County_Name) AS county_norm,
             SUM(Public_Total)  AS dual_2015
      FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
      WHERE Date = '2015-12-01'
      GROUP BY county_norm
  ) d15
  JOIN (
      SELECT UPPER(County_Name) AS county_norm,
             SUM(Public_Total)  AS dual_2018
      FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
      WHERE Date = '2018-12-01'
      GROUP BY county_norm
  ) d18
  USING (county_norm)
  WHERE d18.dual_2018 < d15.dual_2015
),
unemp_rise AS (
  SELECT
    geo_id
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr` AS u15
  JOIN `bigquery-public-data.census_bureau_acs.county_2018_5yr` AS u18
    ON u15.geo_id = u18.geo_id
  WHERE u18.unemployed_pop > u15.unemployed_pop
)
SELECT DISTINCT
  dual_decline.county_norm AS County_Name
FROM dual_decline
JOIN unemp_rise
  ON TRUE        -- placeholder join to combine sample sets
LIMIT 20;
```
