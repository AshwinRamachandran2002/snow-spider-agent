```sql
--Description / thinking process:
--Goal: count counties where (a) the number of unemployed persons rose from 2015→2018 (ACS 5-year)
--AND (b) dual-eligible enrollment fell from 1 Dec 2015→1 Dec 2018 (CMS table).
--Steps
--1) “Unemployment increase” – the ACS county tables are WIDE, so use the `unemployed` column
--   (absolute count).  Join 2015 vs 2018 on `geo_id`, flag when 2018 > 2015.
--2) “Duals decrease” – pull the two snapshots (2015-12-01 & 2018-12-01), join on county/state,
--   flag when 2018 < 2015.  Build a `geo_id` by concatenating state & county FIPS for alignment
--   with the ACS files.
--3) Join the two flag tables on `geo_id` and count records satisfying both conditions.

WITH unemployment_flag AS (
  SELECT
    a.geo_id,
    CASE WHEN b.unemployed > a.unemployed THEN 1 ELSE 0 END AS unemployment_increased
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr` AS a
  JOIN `bigquery-public-data.census_bureau_acs.county_2018_5yr` AS b
    ON a.geo_id = b.geo_id
),
duals_flag AS (
  SELECT
    CONCAT(state_fips, county_fips) AS geo_id,
    CASE WHEN b.public_total < a.public_total THEN 1 ELSE 0 END AS duals_decreased
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program` AS a
  JOIN `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program` AS b
    ON a.county_name = b.county_name
   AND a.state_code  = b.state_code
  WHERE a.date = '2015-12-01'
    AND b.date = '2018-12-01'
)
SELECT
  COUNT(*) AS num_counties
FROM unemployment_flag AS u
JOIN duals_flag        AS d
USING (geo_id)
WHERE u.unemployment_increased = 1
  AND d.duals_decreased       = 1;
