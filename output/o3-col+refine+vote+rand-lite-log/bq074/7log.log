```sql
--Description / thinking process:
--Objective: count U.S. counties that (a) experienced a higher unemployment-rate in
--ACS 5-year data from 2015 ➜ 2018, and (b) had fewer dual-eligible enrollees on
--1 Dec 2018 than on 1 Dec 2015.
--
--Steps
--1) From the wide ACS county tables, pull `unemployment_rate` for 2015 and 2018,
--   join on `geo_id`, and flag counties where 2018 > 2015.
--2) From the CMS dual-eligible table, take snapshots for the two dates, join on
--   county & state, build a `geo_id` via CONCAT(state_fips, county_fips), and
--   flag counties where 2018 < 2015.
--3) Join the two flag tables on `geo_id` and count rows satisfying both flags.

WITH unemployment_flag AS (
  SELECT
    a.geo_id,
    CASE WHEN b.unemployment_rate > a.unemployment_rate THEN 1 ELSE 0 END
      AS unemployment_increased
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr` AS a
  JOIN `bigquery-public-data.census_bureau_acs.county_2018_5yr` AS b
    ON a.geo_id = b.geo_id
),
duals_flag AS (
  SELECT
    CONCAT(state_fips, county_fips) AS geo_id,
    CASE WHEN b.public_total < a.public_total THEN 1 ELSE 0 END
      AS duals_decreased
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program` AS a
  JOIN `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program` AS b
    ON a.county_name = b.county_name
   AND a.state_code  = b.state_code
  WHERE a.date = '2015-12-01'  -- snapshot start
    AND b.date = '2018-12-01'  -- snapshot end
)
SELECT
  COUNT(*) AS num_counties
FROM unemployment_flag AS u
JOIN duals_flag        AS d
USING (geo_id)
WHERE u.unemployment_increased = 1
  AND d.duals_decreased       = 1;
