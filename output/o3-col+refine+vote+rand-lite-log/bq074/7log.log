```sql
--Description / thinking process:
--Goal: find how many counties (a) had MORE unemployed persons in 2018 than in 2015
--      (ACS 5-year tables) and (b) FEWER dual-eligible enrollees on 1-Dec-2018 than
--      on 1-Dec-2015 (CMS dual-eligible table).
--
--Why “employment_unemployed”?  A quick *SELECT \** preview of county_2018_5yr showed
--wide columns such as total_pop, households, median_age, and employment-related
--fields.  The raw count of unemployed persons is stored in `employment_unemployed`,
--so we compare that between the two ACS years.
--
--Steps
--1) Build an unemployment-increase flag with 2015 vs 2018 `employment_unemployed`.
--2) Build a dual-eligible-decrease flag with CMS data (dates 2015-12-01 vs 2018-12-01).
--3) Join flags on county FIPS (`geo_id`) and count rows satisfying BOTH conditions.

WITH unemployment_flag AS (
  SELECT
    a.geo_id,
    CASE WHEN b.employment_unemployed > a.employment_unemployed
         THEN 1 ELSE 0 END AS unemployment_increased
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr` AS a
  JOIN `bigquery-public-data.census_bureau_acs.county_2018_5yr` AS b
    ON a.geo_id = b.geo_id
),
duals_flag AS (
  SELECT
    CONCAT(state_fips, county_fips) AS geo_id,
    CASE WHEN b.public_total < a.public_total
         THEN 1 ELSE 0 END AS duals_decreased
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program` AS a
  JOIN `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program` AS b
    ON a.county_name = b.county_name
   AND a.state_code  = b.state_code
  WHERE a.date = '2015-12-01'          -- start snapshot
    AND b.date = '2018-12-01'          -- end   snapshot
)
SELECT
  COUNT(*) AS num_counties
FROM unemployment_flag AS u
JOIN duals_flag        AS d
USING (geo_id)
WHERE u.unemployment_increased = 1
  AND d.duals_decreased       = 1;
```
