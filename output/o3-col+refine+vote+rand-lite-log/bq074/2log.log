```sql
--Description:  In the census_bureau_acs dataset the county-level 5-year tables are named 
--`county_<year>_5yr`.  Variable DP03_0005PE holds the unemployment rate (percent).  
--The query:  (1) pull that variable for 2015 and 2018; (2) keep counties where the rate rose;  
--(3) pull dual-eligible enrollee totals for 1-Dec-2015 & 1-Dec-2018; (4) keep counties where the 
--enrollee count fell; (5) intersect the two sets and count the distinct counties that satisfy both.
WITH unemp15 AS (
  SELECT
    CONCAT(state_fips, county_fips)            AS geo_id,
    REGEXP_EXTRACT(name, r'^(.*) County')      AS county_name,
    CAST(estimate AS FLOAT64)                  AS rate_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  WHERE variable = 'DP03_0005PE'
),
unemp18 AS (
  SELECT
    CONCAT(state_fips, county_fips)            AS geo_id,
    REGEXP_EXTRACT(name, r'^(.*) County')      AS county_name,
    CAST(estimate AS FLOAT64)                  AS rate_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE variable = 'DP03_0005PE'
),
unemp_rising AS (
  SELECT u15.geo_id, u15.county_name
  FROM unemp15 u15
  JOIN unemp18 u18 USING (geo_id)
  WHERE u18.rate_2018 > u15.rate_2015
),
dual15 AS (
  SELECT
    County_Name                                   AS county_name,
    SUM(Public_Total)                             AS duals_2015
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2015-12-01'
  GROUP BY County_Name
),
dual18 AS (
  SELECT
    County_Name                                   AS county_name,
    SUM(Public_Total)                             AS duals_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2018-12-01'
  GROUP BY County_Name
),
dual_falling AS (
  SELECT d15.county_name
  FROM dual15 d15
  JOIN dual18 d18 USING (county_name)
  WHERE d18.duals_2018 < d15.duals_2015
)
SELECT COUNT(DISTINCT u.county_name) AS county_count
FROM unemp_rising u
JOIN dual_falling d USING (county_name);
