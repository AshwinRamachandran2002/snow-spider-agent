FROM `bigquery-public-data.census_bureau_acs.acs_2015_5yr`
WHERE county IS NOT NULL
  AND tract  IS NULL
  AND block_group IS NULL
  AND variable = 'DP03_0005PE'
LIMIT 20;
```

```sql
-- 5) Same clean-up for 2018 unemployment
SELECT
  state_fips,
  county_fips,
  REGEXP_EXTRACT(name, r'^(.*) County') AS county_name,
  estimate AS unemployment_rate_2018
FROM `bigquery-public-data.census_bureau_acs.acs_2018_5yr`
WHERE county IS NOT NULL
  AND tract  IS NULL
  AND block_group IS NULL
  AND variable = 'DP03_0005PE'
