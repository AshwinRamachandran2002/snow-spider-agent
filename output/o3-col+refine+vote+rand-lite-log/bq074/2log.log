```sql
-- 7) Snapshot of dual-eligible enrollment on 1-Dec-2018
SELECT County_Name, Public_Total AS duals_2018
FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
WHERE Date = '2018-12-01'
LIMIT 20;
```

```sql
-- 8) Join the 2015 & 2018 unemployment tables to identify counties where unemployment increased
WITH u15 AS (
  SELECT state_fips, county_fips, county_name, estimate AS unemp15
  FROM `bigquery-public-data.census_bureau_acs.acs_2015_5yr`
  WHERE county IS NOT NULL AND tract IS NULL AND block_group IS NULL AND variable = 'DP03_0005PE'
),
u18 AS (
  SELECT state_fips, county_fips, county_name, estimate AS unemp18
  FROM `bigquery-public-data.census_bureau_acs.acs_2018_5yr`
  WHERE county IS NOT NULL AND tract IS NULL AND block_group IS NULL AND variable = 'DP03_0005PE'
)
SELECT
  u15.state_fips,
  u15.county_fips,
  u15.county_name,
  unemp15,
  unemp18,
  (unemp18 - unemp15) AS unemp_change
FROM u15
JOIN u18 USING(state_fips, county_fips)
WHERE unemp18 > unemp15
LIMIT 20;
```

```sql
-- 9) Combine unemployment-increase counties with dual-eligible change to see which counties meet BOTH conditions
WITH u15 AS (
  SELECT state_fips, county_fips, REGEXP_EXTRACT(name, r'^(.*) County') AS county_name, estimate AS unemp15
  FROM `bigquery-public-data.census_bureau_acs.acs_2015_5yr`
  WHERE county IS NOT NULL AND tract IS NULL AND block_group IS NULL AND variable = 'DP03_0005PE'
),
u18 AS (
  SELECT state_fips, county_fips, REGEXP_EXTRACT(name, r'^(.*) County') AS county_name, estimate AS unemp18
  FROM `bigquery-public-data.census_bureau_acs.acs_2018_5yr`
  WHERE county IS NOT NULL AND tract IS NULL AND block_group IS NULL AND variable = 'DP03_0005PE'
),
unemp_rising AS (
  SELECT u15.state_fips, u15.county_fips, u15.county_name
  FROM u15 JOIN u18 USING(state_fips, county_fips)
  WHERE u18.unemp18 > u15.unemp15
),
dual15 AS (
  SELECT County_Name AS county_name, Public_Total AS duals15
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2015-12-01'
),
dual18 AS (
  SELECT County_Name AS county_name, Public_Total AS duals18
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2018-12-01'
),
dual_falling AS (
  SELECT d15.county_name
  FROM dual15 d15
  JOIN dual18 d18 USING(county_name)
  WHERE d18.duals18 < d15.duals15
)
SELECT DISTINCT u.county_name
FROM unemp_rising u
JOIN dual_falling d USING(county_name)
LIMIT 20;
```

```sql
-- 10) FINAL answer – total number of counties where unemployment (ACS 5-yr) rose from 2015→2018
