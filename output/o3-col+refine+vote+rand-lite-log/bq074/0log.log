Successfully corrected. SQL:
--Description:  
--Find counties whose total dual-eligible enrollment (Public_Total) was LOWER
--on 1 Dec 2018 than on 1 Dec 2015.  
--
--Why this layout?
--1.  The column `FIPS` (5-digit county code) is a stable key present in every
--    row, so we join on it instead of County_Name (whose capitalization differs
--    by snapshot).  
--2.  Each snapshot can contain multiple program-level rows per county; we only
--    need one total value per county/date, so we aggregate with MIN() which,
--    because every row for a county/date repeats the same Public_Total, simply
--    picks that value.  
--3.  After building the two snapshot tables (d15, d18), we join them and keep
--    counties where dual18 < dual15.  Showing the first 20 results verifies
--    that at least some counties experienced a decline.
WITH d15 AS (
  SELECT
    FIPS,
    MIN(County_Name)  AS county_name,
    MIN(Public_Total) AS dual15
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2015-12-01'
  GROUP BY FIPS
),
d18 AS (
  SELECT
    FIPS,
    MIN(Public_Total) AS dual18
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2018-12-01'
  GROUP BY FIPS
)
SELECT
  d15.county_name,
  d15.dual15,
  d18.dual18
FROM d15
JOIN d18 USING (FIPS)
WHERE d18.dual18 < d15.dual15
ORDER BY county_name
LIMIT 20;
