```sql
--Description: ⑩  FINAL – Count counties that BOTH
--              (a) recorded a higher unemployment rate in 2018 vs 2015, and
--              (b) had fewer dual-eligible enrollees in 2018 vs 2015.
--              Unemployment rate (%) = unemployed ÷ civilian-labor-force × 100.
WITH u15 AS (
  SELECT
    state_name,
    county_name,
    SAFE_DIVIDE(employment_status_unemployed,
                employment_status_civilian_labor_force) * 100 AS ur15
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  WHERE employment_status_unemployed IS NOT NULL
    AND employment_status_civilian_labor_force > 0
),
u18 AS (
  SELECT
    state_name,
    county_name,
    SAFE_DIVIDE(employment_status_unemployed,
                employment_status_civilian_labor_force) * 100 AS ur18
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE employment_status_unemployed IS NOT NULL
    AND employment_status_civilian_labor_force > 0
),
counties_unemp_up AS (
  SELECT u18.state_name, u18.county_name
  FROM u15
  JOIN u18
    ON u15.state_name  = u18.state_name
   AND u15.county_name = u18.county_name
  WHERE u18.ur18 > u15.ur15
),
d15 AS (
  SELECT County_Name AS county_name,
         MIN(Public_Total) AS dual15   -- should be only one per county/date
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2015-12-01'
  GROUP BY County_Name
),
d18 AS (
  SELECT County_Name AS county_name,
         MIN(Public_Total) AS dual18
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2018-12-01'
  GROUP BY County_Name
),
counties_dual_down AS (
  SELECT d18.county_name
  FROM d15
  JOIN d18 USING (county_name)
  WHERE d18.dual18 < d15.dual15
)
SELECT COUNT(DISTINCT c.county_name) AS counties_meeting_both_conditions
FROM counties_unemp_up AS c
JOIN counties_dual_down AS d
  ON LOWER(c.county_name) = LOWER(d.county_name);
```
