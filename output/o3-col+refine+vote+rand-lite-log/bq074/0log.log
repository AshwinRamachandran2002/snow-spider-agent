```sql
--Description:  
--We are still unsure of the exact column names that store unemployment and
--labor-force counts in the 2018 ACS table.  To reveal them, this query
--(1) converts a single row to a JSON string, and (2) uses REGEXP_EXTRACT_ALL
--to pull every JSON key that contains the text “unemploy” or “labor”.
--The result is a distinct, alphabetically-sorted list of candidate column
--names.  Once you see the precise field names (e.g., something like
--“employment_status_unemployed” and “employment_status_civilian_labor_force”),
--use them in the rate-calculation queries.
WITH one_row AS (
  SELECT TO_JSON_STRING(t) AS row_json
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr` AS t
  LIMIT 1
)
SELECT DISTINCT key
FROM one_row
, UNNEST(
    REGEXP_EXTRACT_ALL(row_json, r'"([^"]*(?:unemploy|labor)[^"]*)":')
  ) AS key
ORDER BY key
LIMIT 100;
