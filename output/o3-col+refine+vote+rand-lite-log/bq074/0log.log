```sql
--Description:  
--FINAL ⑩  – Count counties that simultaneously
--  (a) had a HIGHER unemployment rate in 2018 than in 2015, and
--  (b) had FEWER dual-eligible enrollees on 1 Dec 2018 than on 1 Dec 2015.  
--
--Key points fixed:
--• Use the stable numeric key `FIPS` that exists in the dual-eligible table.  
--• Extract the same 5-digit FIPS from the ACS `geo_id` (characters 10-14).  
--• Compute unemployment rates because no pre-made column exists.  
--• Aggregate the dual-eligible table to one row per county/date with MIN()
--  (all rows for a county/date hold the same Public_Total).  
--• Join on FIPS, not on text county names, to avoid case/format mismatches.  
--• Return the count of distinct counties meeting both conditions.
WITH u15 AS (   -- 2015 unemployment rate
  SELECT
    CAST(SUBSTR(geo_id, 10) AS INT64) AS FIPS,
    SAFE_DIVIDE(
      employment_status_unemployed,
      employment_status_civilian_labor_force
    ) * 100 AS ur15
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  WHERE employment_status_unemployed IS NOT NULL
    AND employment_status_civilian_labor_force > 0
),
u18 AS (   -- 2018 unemployment rate
  SELECT
    CAST(SUBSTR(geo_id, 10) AS INT64) AS FIPS,
    SAFE_DIVIDE(
      employment_status_unemployed,
      employment_status_civilian_labor_force
    ) * 100 AS ur18
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE employment_status_unemployed IS NOT NULL
    AND employment_status_civilian_labor_force > 0
),
counties_unemp_up AS (   -- unemployment rose
  SELECT FIPS
  FROM u15 JOIN u18 USING (FIPS)
  WHERE ur18 > ur15
),
d15 AS (   -- dual-eligible totals, Dec-2015
  SELECT
    FIPS,
    MIN(Public_Total) AS dual15
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2015-12-01'
