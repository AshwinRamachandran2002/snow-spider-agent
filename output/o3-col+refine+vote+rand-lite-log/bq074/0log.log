```sql
--Description: ⑤  Re-write the “unemployment-rate increased” query by
--              CALCULATING the rate in each year instead of referencing a
--              missing ready-made field.  The rate (%) =
--              (employment_status_in_labor_force_unemployed_estimate ÷
--               employment_status_in_labor_force_total_estimate) × 100.
--              We extract the 5-digit county FIPS from `geo_id`.  Counties are
--              kept only when both components are non-null and the 2018 rate
--              exceeds the 2015 rate.
WITH u15 AS (
  SELECT
    CAST(SUBSTR(geo_id, 10) AS INT64)                           AS county_fips_code,
    SAFE_DIVIDE(
      employment_status_in_labor_force_unemployed_estimate,
      employment_status_in_labor_force_total_estimate
    ) * 100                                                     AS ur15
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  WHERE employment_status_in_labor_force_unemployed_estimate IS NOT NULL
    AND employment_status_in_labor_force_total_estimate > 0
),
u18 AS (
  SELECT
    CAST(SUBSTR(geo_id, 10) AS INT64)                           AS county_fips_code,
    SAFE_DIVIDE(
      employment_status_in_labor_force_unemployed_estimate,
      employment_status_in_labor_force_total_estimate
    ) * 100                                                     AS ur18
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
