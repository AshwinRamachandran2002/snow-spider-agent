--Description:  
--Count U.S. counties that satisfy BOTH criteria:  
--  A) Unemployment-rate rose from 2015 (ACS 5-yr) to 2018 (ACS 5-yr).  
--     • The tables store the needed components as  
--          – unemployed_pop            (numerator)  
--          – civilian_labor_force      (denominator)  
--       so Rate = unemployed_pop / civilian_labor_force × 100.  
--     • County key = 5-digit FIPS embedded in geo_id → SUBSTR(geo_id,10).  
--  B) Dual-eligible enrollee total (Public_Total) fell between  
--     1 Dec 2015 and 1 Dec 2018 in CMS dual-eligible table.  
--     • That table already has numeric FIPS; aggregate each snapshot to one  
--       total per county with MIN(Public_Total).  
--The query builds four CTEs (u15, u18, d15, d18), derives two sets  
--(unemp_up, dual_down), intersects them on FIPS, and returns the count.
WITH u15 AS (
  SELECT
    CAST(SUBSTR(geo_id, 10) AS INT64)                         AS FIPS,
    SAFE_DIVIDE(unemployed_pop, civilian_labor_force) * 100   AS ur15
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  WHERE unemployed_pop IS NOT NULL
    AND civilian_labor_force > 0
),
u18 AS (
