```sql
--Description: ⑨  Identify counties whose dual-eligible counts DECREASED
--             between 2015-12-01 and 2018-12-01 (dual_2018 < dual_2015).
WITH d15 AS (
  SELECT county_fips_code, Public_Total AS dual15
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2015-12-01'
),
d18 AS (
