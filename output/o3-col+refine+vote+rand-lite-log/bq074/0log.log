```sql
WITH
-- 1.  Pull unemployment rates for 2015 and 2018 and keep the 5-digit county FIPS
unemployment AS (
  SELECT
    RIGHT(geo_id, 5)                             AS fips,
    unemployment_rate                            AS ur,
    2015                                         AS yr
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  UNION ALL
  SELECT
    RIGHT(geo_id, 5)                             AS fips,
    unemployment_rate                            AS ur,
    2018                                         AS yr
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
),

-- 2.  Keep counties whose unemployment rate ROSE from 2015→2018
unemployment_increase AS (
  SELECT
    fips,
    MAX(CASE WHEN yr = 2015 THEN ur END) AS ur_2015,
    MAX(CASE WHEN yr = 2018 THEN ur END) AS ur_2018
  FROM unemployment
  GROUP BY fips
  HAVING ur_2018 > ur_2015
),

-- 3.  Pull dual-eligible enrollee counts for 1 Dec 2015 & 1 Dec 2018
dual AS (
  SELECT
    LPAD(CAST(FIPS AS STRING), 5, '0') AS fips,
    Public_Total,
    Date
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date IN ('2015-12-01', '2018-12-01')
),

-- 4.  Keep counties whose dual-eligible counts FELL from 2015→2018
dual_decrease AS (
  SELECT
    fips,
    MAX(CASE WHEN Date = '2015-12-01' THEN Public_Total END) AS dual_2015,
    MAX(CASE WHEN Date = '2018-12-01' THEN Public_Total END) AS dual_2018
  FROM dual
  GROUP BY fips
  HAVING dual_2018 < dual_2015
)

-- 5.  Count counties meeting BOTH conditions
SELECT
  COUNT(*) AS county_count
FROM unemployment_increase
JOIN dual_decrease USING (fips);
```
