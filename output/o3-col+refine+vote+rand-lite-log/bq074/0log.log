```sql
--Description:
--The 2015 ACS county-level table does not have a pre-computed field called
--`employment_status_unemployment_rate`.  Instead, it contains:
--  • employment_status_in_labor_force_civilian_unemployed_estimate  (numerator)
--  • employment_status_in_labor_force_civilian_labor_force_estimate (denominator)
--The unemployment rate (%) = (unemployed ÷ labor-force) × 100.
--`geo_id` holds “0500000US” + 5-digit county FIPS.  We extract that FIPS so
--it can be joined to other tables later.  SAFE_DIVIDE prevents division-by-zero
--errors.  This query therefore produces the 2015 unemployment rate for each
--county and shows the first 20 rows.
SELECT
  CAST(SUBSTR(geo_id, 10) AS INT64)                                         AS county_fips_code,
  state_name,
  county_name,
  SAFE_DIVIDE(
    employment_status_in_labor_force_civilian_unemployed_estimate,
    employment_status_in_labor_force_civilian_labor_force_estimate
  ) * 100                                                                    AS unemp_rate_2015
FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
WHERE employment_status_in_labor_force_civilian_unemployed_estimate IS NOT NULL
  AND employment_status_in_labor_force_civilian_labor_force_estimate > 0
LIMIT 20;
```
