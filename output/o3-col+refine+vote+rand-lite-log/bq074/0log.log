```sql
--Description: ⑩  FINAL ANSWER – count counties that BOTH
--             (a) had higher unemployment in 2018 than 2015, AND
--             (b) had fewer dual-eligible enrollees in 2018 than 2015.
WITH u15 AS (
  SELECT county_fips_code, employment_status_unemployment_rate AS ur15
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
),
u18 AS (
  SELECT county_fips_code, employment_status_unemployment_rate AS ur18
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
),
counties_unemp_up AS (
  SELECT u18.county_fips_code
  FROM u15 JOIN u18 USING (county_fips_code)
  WHERE u18.ur18 > u15.ur15
),
d15 AS (
  SELECT county_fips_code, Public_Total AS dual15
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2015-12-01'
),
d18 AS (
  SELECT county_fips_code, Public_Total AS dual18
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2018-12-01'
),
counties_dual_down AS (
  SELECT d18.county_fips_code
  FROM d15 JOIN d18 USING (county_fips_code)
  WHERE d18.dual18 < d15.dual15
)
SELECT COUNT(DISTINCT c.county_fips_code) AS counties_meeting_both_conditions
FROM counties_unemp_up AS c
JOIN counties_dual_down AS d
ON c.county_fips_code = d.county_fips_code
LIMIT 20;
```

