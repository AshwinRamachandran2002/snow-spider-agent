```sql
--Description:  
--The 2015 ACS county table does not include a ready-made “employment_status_unemployment_rate”
--field, so we calculate the unemployment rate ourselves.  The two component
--columns actually present in the file are:
--    • employment_status_unemployed_pop_estimate          (numerator)
--    • employment_status_civilian_labor_force_estimate    (denominator)
--Unemployment rate (%) = (unemployed ÷ labor-force) × 100.  
--`geo_id` begins with “0500000US”; the last five characters are the county
--FIPS code, which we extract for later joins.  SAFE_DIVIDE protects against
--division-by-zero.  The query returns a preview of 20 counties with the
--computed 2015 unemployment rate.
SELECT
  CAST(SUBSTR(geo_id, 10) AS INT64)                               AS county_fips_code,
  state_name,
  county_name,
  SAFE_DIVIDE(
    employment_status_unemployed_pop_estimate,
    employment_status_civilian_labor_force_estimate
  ) * 100                                                         AS unemp_rate_2015
FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
WHERE employment_status_unemployed_pop_estimate IS NOT NULL
  AND employment_status_civilian_labor_force_estimate > 0
LIMIT 20;
