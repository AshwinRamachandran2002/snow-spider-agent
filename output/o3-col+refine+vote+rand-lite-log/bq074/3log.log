```sql
--Description:
-- Goal: Count counties that (a) saw unemployment rise from 2015→2018 (ACS 5-yr)
--       and (b) saw dual-eligible enrollee counts fall from 2015-12-01→2018-12-01.
-- Logic:
--   1. unemployment_2015 / unemployment_2018  – pull county unemployment rates
--      from ACS tables and parse the 5-digit FIPS (state + county) out of geo_id.
--   2. unemp_increase – retain counties where 2018 rate > 2015 rate.
--   3. dual_snapshots – pull enrollee totals on the two required dates from the
--      CMS dual-eligible table (columns are `state_fips_code` & `county_fips_code`).
--   4. dual_decrease  – keep counties where 2018 < 2015.
--   5. Final join & count the counties meeting both conditions.
WITH unemployment_2015 AS (
  SELECT
    SUBSTR(geo_id, 10, 5)                      AS fips5,
    employment_status_unemployment_rate        AS unemp_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
),
unemployment_2018 AS (
  SELECT
    SUBSTR(geo_id, 10, 5)                      AS fips5,
    employment_status_unemployment_rate        AS unemp_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
),
unemp_increase AS (
  SELECT u15.fips5
  FROM unemployment_2015 u15
  JOIN unemployment_2018 u18 USING (fips5)
  WHERE u18.unemp_2018 > u15.unemp_2015        -- unemployment rose
),
dual_snapshots AS (
  SELECT
    CONCAT(state_fips_code, county_fips_code)  AS fips5,
    MAX(CASE WHEN Date = '2015-12-01' THEN Public_Total END) AS enroll_2015,
    MAX(CASE WHEN Date = '2018-12-01' THEN Public_Total END) AS enroll_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date IN ('2015-12-01', '2018-12-01')
  GROUP BY fips5
),
dual_decrease AS (
  SELECT fips5
  FROM dual_snapshots
  WHERE enroll_2018 < enroll_2015               -- enrollee count fell
)
SELECT COUNT(*) AS counties_meeting_both_conditions
FROM unemp_increase
JOIN dual_decrease USING (fips5);
```
