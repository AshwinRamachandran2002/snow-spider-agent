--Description:
-- 9.  Staging view of counties where (a) unemployment ↑ and (b) dual-eligible ↓.
--     Geography keys:
--       • ACS unemployment: derive 5-digit FIPS (chars 10-14 of geo_id).
--       • Dual table: no FIPS available, so use County_Name as the join key.
--     NOTE: ACS county tables include a `county_name` field (viewable via
--     SELECT * LIMIT 1).  That field is extracted here for the join.
WITH u15 AS (
  SELECT
    REGEXP_EXTRACT(geo_id, r'US\d{2}(\d{3})')            AS county_fips,   -- 3-digit
    county_name                                          AS County_Name,
    SAFE_DIVIDE(unemployed_pop,
                unemployed_pop + employed_pop) * 100     AS unemp_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
),
u18 AS (
  SELECT
    REGEXP_EXTRACT(geo_id, r'US\d{2}(\d{3})')            AS county_fips,
    county_name                                          AS County_Name,
    SAFE_DIVIDE(unemployed_pop,
                unemployed_pop + employed_pop) * 100     AS unemp_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
),
unemp AS (
  SELECT County_Name, unemp_2015, unemp_2018
  FROM u15 JOIN u18 USING (County_Name)
),
dual AS (
  SELECT
    County_Name,
    MAX(CASE WHEN Date = '2015-12-01' THEN Public_Total END) AS enroll_2015,
    MAX(CASE WHEN Date = '2018-12-01' THEN Public_Total END) AS enroll_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date IN ('2015-12-01','2018-12-01')
  GROUP BY County_Name
)
SELECT
  u.County_Name,
  u.unemp_2015,
  u.unemp_2018,
  d.enroll_2015,
  d.enroll_2018
FROM unemp AS u
JOIN dual  AS d USING (County_Name)
WHERE u.unemp_2018 > u.unemp_2015      -- unemployment increased
  AND d.enroll_2018 < d.enroll_2015    -- dual-eligible decreased
LIMIT 20;
