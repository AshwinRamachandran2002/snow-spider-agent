  geo_id,
  SUBSTR(geo_id, 10, 2) AS state_fips,
  SUBSTR(geo_id, 12, 3) AS county_fips,
  SAFE_DIVIDE(
      CAST(employment_status_unemployed AS FLOAT64),
      CAST(employment_status_in_labor_force AS FLOAT64)
  ) * 100 AS unemployment_rate_pct_2015
FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
LIMIT 20;
