```sql
--Description:
-- 9. Staging result: counties where (a) unemployment ↑ and (b) dual-eligible ↓.
WITH u15 AS (
  SELECT
    SUBSTR(geo_id, 10, 5) AS fips5,
    SAFE_DIVIDE(unemployed_pop,
                unemployed_pop + employed_pop) * 100 AS unemp_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
),
u18 AS (
  SELECT
    SUBSTR(geo_id, 10, 5) AS fips5,
    SAFE_DIVIDE(unemployed_pop,
                unemployed_pop + employed_pop) * 100 AS unemp_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
),
unemp AS (
  SELECT fips5, unemp_2015, unemp_2018
  FROM u15 JOIN u18 USING (fips5)
),
dual AS (
  SELECT
    CONCAT(state_fips_code, county_fips_code)                AS fips5,
    MAX(CASE WHEN Date = '2015-12-01' THEN Public_Total END) AS enroll_2015,
    MAX(CASE WHEN Date = '2018-12-01' THEN Public_Total END) AS enroll_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date IN ('2015-12-01','2018-12-01')
  GROUP BY fips5
)
SELECT
  u.fips5,
  u.unemp_2015,
  u.unemp_2018,
  d.enroll_2015,
  d.enroll_2018
FROM unemp AS u
JOIN dual  AS d USING (fips5)
WHERE u.unemp_2018 > u.unemp_2015      -- unemployment increased
  AND d.enroll_2018 < d.enroll_2015    -- dual-eligible decreased
LIMIT 20;
```

```sql
--Description:
-- 10. FINAL ANSWER: count of counties where unemployment ↑ (2015→2018) AND
--     dual-eligible enrollment ↓ (Dec-2015 → Dec-2018).
WITH u15 AS (
  SELECT
    SUBSTR(geo_id, 10, 5) AS fips5,
    SAFE_DIVIDE(unemployed_pop,
                unemployed_pop + employed_pop) * 100 AS unemp_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
),
u18 AS (
  SELECT
    SUBSTR(geo_id, 10, 5) AS fips5,
    SAFE_DIVIDE(unemployed_pop,
                unemployed_pop + employed_pop) * 100 AS unemp_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
),
unemp_inc AS (
  SELECT fips5
  FROM u15 JOIN u18 USING (fips5)
  WHERE unemp_2018 > unemp_2015                    -- unemployment ↑
),
dual AS (
  SELECT
    CONCAT(state_fips_code, county_fips_code)                AS fips5,
    MAX(CASE WHEN Date = '2015-12-01' THEN Public_Total END) AS enroll_2015,
    MAX(CASE WHEN Date = '2018-12-01' THEN Public_Total END) AS enroll_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date IN ('2015-12-01','2018-12-01')
  GROUP BY fips5
),
dual_dec AS (
  SELECT fips5
  FROM dual
  WHERE enroll_2018 < enroll_2015                  -- dual-eligible ↓
)
SELECT COUNT(*) AS counties_meeting_both_conditions
FROM unemp_inc
JOIN dual_dec USING (fips5);
```
