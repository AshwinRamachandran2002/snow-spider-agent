```sql
-- 9.  Build a staging table that flags counties whose unemployment rose and dual-eligible counts fell
WITH unemp AS (
  SELECT
    CONCAT(state_fips, county_fips) AS geo_id,
    unemp_2015,
    unemp_2018
  FROM (
    SELECT CONCAT(state_fips, county_fips) AS geo_id,
           unemployment_rate AS unemp_2015
    FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  ) AS a
  JOIN (
    SELECT CONCAT(state_fips, county_fips) AS geo_id,
           unemployment_rate AS unemp_2018
    FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  ) AS b
  USING (geo_id)
),
dual AS (
  SELECT
    SAFE_CONCAT(state_fips, county_fips) AS geo_id,
    MAX(CASE WHEN Date = '2015-12-01' THEN Public_Total END) AS enroll_2015,
    MAX(CASE WHEN Date = '2018-12-01' THEN Public_Total END) AS enroll_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  GROUP BY geo_id
)
SELECT
  u.geo_id,
  u.unemp_2015,
  u.unemp_2018,
  d.enroll_2015,
  d.enroll_2018
FROM unemp AS u
JOIN dual  AS d
USING (geo_id)
WHERE u.unemp_2018 > u.unemp_2015        -- unemployment increased
  AND d.enroll_2018 < d.enroll_2015      -- enrollee counts decreased
LIMIT 20;
```

```sql
-- 10.  FINAL ANSWER ‑- count of counties meeting both criteria
WITH unemp AS (
  SELECT
    CONCAT(state_fips, county_fips) AS geo_id,
    unemployment_rate AS unemp_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
),
unemp18 AS (
  SELECT
    CONCAT(state_fips, county_fips) AS geo_id,
    unemployment_rate AS unemp_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
),
unemp_change AS (
  SELECT
    u.geo_id,
    u.unemp_2015,
    u18.unemp_2018
  FROM unemp  AS u
  JOIN unemp18 AS u18
  USING (geo_id)
  WHERE u18.unemp_2018 > u.unemp_2015            -- unemployment ↑
),
dual AS (
  SELECT
    SAFE_CONCAT(state_fips, county_fips)                AS geo_id,
    MAX(CASE WHEN Date = '2015-12-01' THEN Public_Total END) AS enroll_2015,
    MAX(CASE WHEN Date = '2018-12-01' THEN Public_Total END) AS enroll_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  GROUP BY geo_id
),
dual_change AS (
  SELECT *
  FROM dual
  WHERE enroll_2018 < enroll_2015                      -- dual-eligible ↓
)
SELECT COUNT(*) AS counties_meeting_both_conditions
FROM unemp_change
JOIN dual_change
USING (geo_id);
```
