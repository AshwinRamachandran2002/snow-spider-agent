--    AND lower dual-eligible enrollment (2018 < 2015)
SELECT
  COUNT(*) AS counties_with_higher_unemployment_and_lower_dual_eligibles
FROM unemp_2015 u15
JOIN unemp_2018 u18 USING (fips)
JOIN dec_2015 d15 USING (fips)
JOIN dec_2018 d18 USING (fips)
WHERE
  u18.unemployed_2018 > u15.unemployed_2015           -- Unemployment increased
  AND d18.total_2018     < d15.total_2015;            -- Dual-eligible enrollment decreased
