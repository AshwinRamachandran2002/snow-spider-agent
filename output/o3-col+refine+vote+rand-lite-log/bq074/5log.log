-- 1. County-level unemployment (number of unemployed) from the 2015 ACS 5-year file
unemp_2015 AS (
  SELECT
    SUBSTR(geo_id, -5)            AS fips,
    SAFE_CAST(B23025_005E AS INT64) AS unemployed_2015   -- Unemployed civilian labor force
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
),

-- 2. County-level unemployment from the 2018 ACS 5-year file
unemp_2018 AS (
  SELECT
    SUBSTR(geo_id, -5)            AS fips,
    SAFE_CAST(B23025_005E AS INT64) AS unemployed_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
),

-- 3. Dual-eligible enrollment totals on Dec-01-2015
dec_2015 AS (
  SELECT
    FIPS  AS fips,
    Public_Total AS total_2015
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2015-12-01'
),

-- 4. Dual-eligible enrollment totals on Dec-01-2018
dec_2018 AS (
  SELECT
    FIPS  AS fips,
    Public_Total AS total_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2018-12-01'
)

