```sql
-- 5. Description: Join the 2015 and 2018 snapshots to compute the enrollee change (sample of 20 rows)
WITH dec_2015 AS (
  SELECT County_Name, Public_Total AS total_2015
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2015-12-01'
),
dec_2018 AS (
  SELECT County_Name, Public_Total AS total_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2018-12-01'
)
SELECT
  d15.County_Name,
  d15.total_2015,
  d18.total_2018,
  d18.total_2018 - d15.total_2015 AS diff_2018_minus_2015
FROM dec_2015 AS d15
JOIN dec_2018 AS d18
USING (County_Name)
LIMIT 20;
```

```sql
-- 6. Description: Identify counties whose dual-eligible enrollee count fell from Dec 2015 to Dec 2018 (sample of 20)
WITH dec_2015 AS (
  SELECT County_Name, Public_Total AS total_2015
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2015-12-01'
),
dec_2018 AS (
  SELECT County_Name, Public_Total AS total_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2018-12-01'
)
SELECT
  d15.County_Name,
  d15.total_2015,
  d18.total_2018
FROM dec_2015 AS d15
JOIN dec_2018 AS d18
USING (County_Name)
WHERE d18.total_2018 < d15.total_2015
LIMIT 20;
```

```sql
-- 7. Description: Count the number of counties with a decrease in dual-eligible enrollee counts between Dec 1 2015 and Dec 1 2018
WITH dec_2015 AS (
  SELECT County_Name, Public_Total AS total_2015
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2015-12-01'
),
dec_2018 AS (
  SELECT County_Name, Public_Total AS total_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = '2018-12-01'
)
SELECT COUNT(*) AS counties_with_decrease
FROM dec_2015 AS d15
JOIN dec_2018 AS d18
USING (County_Name)
WHERE d18.total_2018 < d15.total_2015;
