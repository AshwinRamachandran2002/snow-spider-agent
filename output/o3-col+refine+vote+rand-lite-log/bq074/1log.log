```sql
--Description:  One-step answer: count counties where
--              (1) Unemployment (ACS 5-year, column `employment_status_unemployed`) is higher in the
--                  2018 release than in the 2015 release, and
--              (2) Dual-eligible enrollee totals (CMS table) are lower on 2018-12-01 than on 2015-12-01.
--              Approach
--              •  In each wide ACS table, `geo_id` is the county FIPS and `employment_status_unemployed`
--                 holds the estimate of unemployed persons.  Join the 2015 and 2018 files on `geo_id`
--                 and keep rows where unemployed_2018 > unemployed_2015.
--              •  Strip the trailing “ County/Parish/Borough/Census Area” from the ACS `name`
--                 so it matches the county spelling used in the CMS file.
--              •  In the CMS dual-eligible table, sum `Public_Total` by county for the snapshots
--                 on 2015-12-01 and 2018-12-01 and keep counties where dual_2018 < dual_2015.
--              •  Inner-join the two filtered county lists on a case-insensitive county name
--                 and return the resulting count.  That count is the requested result.

WITH acs_2015 AS (                         -- unemployment counts, 2015 ACS 5-yr
  SELECT
    geo_id,
    REGEXP_REPLACE(SPLIT(name, ',')[OFFSET(0)],
                   r' (County|Parish|Borough|Census Area)$', '') AS county_name,
    employment_status_unemployed                                AS unemp_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  WHERE employment_status_unemployed IS NOT NULL
),
acs_2018 AS (                         -- unemployment counts, 2018 ACS 5-yr
  SELECT
    geo_id,
    employment_status_unemployed AS unemp_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE employment_status_unemployed IS NOT NULL
),
unemp_up AS (                          -- counties where unemployment increased
  SELECT a15.county_name
  FROM acs_2015 a15
  JOIN acs_2018 a18 USING (geo_id)
  WHERE a18.unemp_2018 > a15.unemp_2015
),
dual_2015 AS (                         -- dual-eligible totals, 2015-12-01
  SELECT
    County_Name,
    SUM(Public_Total) AS dual_2015
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = DATE '2015-12-01'
  GROUP BY County_Name
),
dual_2018 AS (                         -- dual-eligible totals, 2018-12-01
  SELECT
    County_Name,
    SUM(Public_Total) AS dual_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = DATE '2018-12-01'
  GROUP BY County_Name
),
dual_down AS (                         -- counties where dual-eligible enrollment decreased
  SELECT d15.County_Name
  FROM dual_2015 d15
  JOIN dual_2018 d18 USING (County_Name)
  WHERE d18.dual_2018 < d15.dual_2015
)
SELECT COUNT(*) AS counties_with_unemp_up_and_dual_down
FROM unemp_up u
JOIN dual_down d
  ON LOWER(u.county_name) = LOWER(d.County_Name);
```
