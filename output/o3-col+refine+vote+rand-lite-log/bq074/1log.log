  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  WHERE LOWER(`variable`) LIKE '%unemploy%'          -- pick unemployment variable(s)
  GROUP BY geo_id
),
u18 AS (
  SELECT `geo_id`,
         AVG(`estimate`)  AS unemploy_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE LOWER(`variable`) LIKE '%unemploy%'
  GROUP BY geo_id
)
SELECT u18.geo_id,
       u15.county_name,
       unemploy_2015,
       unemploy_2018
FROM u15
JOIN u18 USING (geo_id)
WHERE unemploy_2018 > unemploy_2015
LIMIT 20;
