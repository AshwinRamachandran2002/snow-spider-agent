```sql
--Description:  One-shot query to return the number of counties that satisfy two conditions:  
--              (1) Unemployment rose from the 2015 ACS 5-year file to the 2018 file.  
--                  •  Wide ACS tables store every metric in its own column; DP03_0007E is “Civilian Unemployed”.  
--                  •  We grab DP03_0007E for 2015 and 2018, keyed by `geo_id` (county FIPS) and strip the text
--                    before “ County” in `NAME` to match the CMS spelling.  
--              (2) Dual-eligible enrollee totals fell between the two CMS snapshots (1-Dec-2015 → 1-Dec-2018).  
--                  •  CMS file already has county-level counts in `Public_Total`; we aggregate to one row per county.  
--              Finally we inner-join the two filtered county lists on a case-insensitive county name and count them.  

WITH acs2015 AS (      -- unemployment counts, 2015 5-yr ACS
  SELECT
    geo_id,
    REGEXP_EXTRACT(NAME, r'^(.*?) County') AS county_name,
    DP03_0007E                             AS unemp_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  WHERE DP03_0007E IS NOT NULL
),
acs2018 AS (      -- unemployment counts, 2018 5-yr ACS
  SELECT
    geo_id,
    DP03_0007E AS unemp_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE DP03_0007E IS NOT NULL
),
unemp_up AS (     -- keep counties where unemployment increased
  SELECT a15.county_name
  FROM acs2015 a15
  JOIN acs2018 a18 USING (geo_id)
  WHERE a18.unemp_2018 > a15.unemp_2015
),
dual15 AS (       -- dual-eligible totals on 1-Dec-2015
  SELECT
    County_Name,
    SUM(Public_Total) AS dual_2015
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = DATE '2015-12-01'
  GROUP BY County_Name
),
dual18 AS (       -- dual-eligible totals on 1-Dec-2018
  SELECT
    County_Name,
    SUM(Public_Total) AS dual_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = DATE '2018-12-01'
  GROUP BY County_Name
),
dual_down AS (    -- keep counties where dual-eligible enrollment decreased
  SELECT d15.County_Name
  FROM dual15 d15
  JOIN dual18 d18 USING (County_Name)
  WHERE d18.dual_2018 < d15.dual_2015
)
SELECT COUNT(*) AS counties_with_unemp_up_and_dual_down
FROM unemp_up u
JOIN dual_down d
  ON LOWER(u.county_name) = LOWER(d.County_Name);
```
