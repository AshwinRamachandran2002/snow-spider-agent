```sql
--Description:  Our goal is to count U.S. counties that satisfy BOTH of the following:  
--   (1) Unemployment rose from the 2015-vintage to the 2018-vintage ACS 5-year file.  
--       •  In the “wide” ACS tables every measure is its own column; the employment-status table B23025’s  
--          field `B23025_005E` is the estimate of people unemployed.  
--   (2) Dual-eligible enrollment fell between 1-Dec-2015 and 1-Dec-2018 in CMS data.  
--   We therefore:  
--       •  Pull `B23025_005E` for 2015 and 2018, keeping `geo_id` (contains the 5-digit county FIPS) and  
--          parse out the county name that appears before the literal string “ County”.  
--       •  Keep counties where unemployment increased.  
--       •  Aggregate CMS enrollee totals by county for the two reference dates and keep counties where the  
--          2018 figure is lower than in 2015.  
--       •  Join the two result sets on a lower-cased county name match (this works because the CMS table’s  
--          `County_Name` stores only the county name).  
--       •  Return the final count of distinct counties that meet both conditions.  
  
WITH acs15 AS (                                  -- 2015 unemployment
  SELECT
    geo_id,
    REGEXP_EXTRACT(name, r'^(.*) County') AS county_name,
    B23025_005E                             AS unemployed_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  WHERE B23025_005E IS NOT NULL
),
acs18 AS (                                  -- 2018 unemployment
  SELECT
    geo_id,
    REGEXP_EXTRACT(name, r'^(.*) County') AS county_name,
    B23025_005E                             AS unemployed_2018
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE B23025_005E IS NOT NULL
),
unemp_up AS (                                -- unemployment increase flag
  SELECT a18.county_name
  FROM acs18 a18
  JOIN acs15 a15 USING (geo_id)
  WHERE a18.unemployed_2018 > a15.unemployed_2015
),
dual15 AS (                                  -- dual eligibles ‑ Dec-2015
  SELECT
    County_Name,
    SUM(Public_Total) AS dual_2015
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = DATE '2015-12-01'
  GROUP BY County_Name
),
dual18 AS (                                  -- dual eligibles ‑ Dec-2018
  SELECT
    County_Name,
    SUM(Public_Total) AS dual_2018
  FROM `bigquery-public-data.sdoh_cms_dual_eligible_enrollment.dual_eligible_enrollment_by_county_and_program`
  WHERE Date = DATE '2018-12-01'
  GROUP BY County_Name
),
dual_down AS (                               -- enrollee decrease flag
  SELECT d15.County_Name
  FROM dual15 d15
  JOIN dual18 d18 USING (County_Name)
  WHERE d18.dual_2018 < d15.dual_2015
)
SELECT COUNT(*) AS counties_with_unemp_up_and_dual_down
FROM unemp_up u
JOIN dual_down d
  ON LOWER(u.county_name) = LOWER(d.County_Name);
```
