--Description: 
-- End-to-end query that (a) selects all Mitelman breast-cancer cases (Morph 3111 / Topo 0401),
-- (b) converts their CytoConverter copy-number calls into chromosome-level frequencies,
-- (c) lines those frequencies up with a (mock) TCGA breast-cancer table, and
-- (d) reports Pearson correlations (plus two-tailed p-values) for every aberration
--     type that appears on at least five chromosomes.  Replace the UNION-ALL block
--     in tcga_freq with real TCGA numbers to obtain meaningful statistics.

WITH bc_cases AS (                 -- 1. cohort definition
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111'             -- breast carcinoma morphology
    AND Topo  = '0401'             -- breast primary site
),
tot AS (                           -- 2. cohort size
  SELECT COUNT(*) AS n_cases FROM bc_cases
),
mit_freq AS (                      -- 3. Mitelman chromosome-level % frequencies
  SELECT
    cc.Chr  AS chromosome,
    cc.Type AS aberration_type,
    100.0 *
      COUNT(DISTINCT CONCAT(cc.RefNo,'-',cc.CaseNo))
      / MAX(tot.n_cases)           AS mit_pct
  FROM `mitelman-db.prod.CytoConverted` cc
  JOIN bc_cases USING (RefNo, CaseNo)
  CROSS JOIN tot                   -- allows MAX(tot.n_cases) inside GROUP BY
  GROUP BY chromosome, aberration_type
),
tcga_freq AS (                     -- 4. stub TCGA table  ←-- replace with real data
  SELECT 'chr1','Gain',18.0 UNION ALL
  SELECT 'chr1','Loss', 7.5 UNION ALL
  SELECT 'chr2','Gain',15.2 UNION ALL
  SELECT 'chr2','Loss', 6.1 UNION ALL
  SELECT 'chr3','Gain',12.7 UNION ALL
  SELECT 'chr3','Loss', 9.9 UNION ALL
  SELECT 'chr4','Gain',14.0 UNION ALL
  SELECT 'chr4','Loss',10.2 UNION ALL
  SELECT 'chr5','Gain',11.3 UNION ALL
  SELECT 'chr5','Loss', 8.7
  --   column order: chromosome, aberration_type, tcga_pct
),
paired AS (                        -- 5. chromosomes present in both datasets
  SELECT
    m.aberration_type,
    m.mit_pct,
    t.tcga_pct
  FROM mit_freq m
  JOIN tcga_freq t
    ON  m.chromosome      = t.column1         -- tcga_freq first column
    AND m.aberration_type = t.column2         -- tcga_freq second column
)
SELECT                               -- 6. correlation & p-value
  aberration_type,
  CORR(mit_pct, tcga_pct) AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(
       CORR(mit_pct, tcga_pct), COUNT(*)
  )                           AS p_value,
  COUNT(*)                    AS n_chromosomes
FROM paired
GROUP BY aberration_type
HAVING n_chromosomes >= 5
ORDER BY aberration_type
LIMIT 20;
