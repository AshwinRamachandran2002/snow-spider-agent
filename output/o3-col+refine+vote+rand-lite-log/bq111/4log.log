```sql
--Description: 
-- Compute, for breast-cancer cases (Morph = 3111, Topo = 0401), the chromosome-wise Pearson
-- correlation between Mitelman copy-number frequencies and (mock) TCGA frequencies, returning
-- one row per aberration type together with a two-tailed p-value; only aberration types with
-- ≥ 5 shared chromosomes are kept.  
-- Steps
--   1) bc_cases   : distinct RefNo-CaseNo pairs defining the cohort.  
--   2) tot        : cohort size.  
--   3) mit_freq   : % of cohort that shows each aberration on each chromosome  
--                   (uses CROSS JOIN tot so division is allowed inside GROUP BY).  
--   4) tcga_freq  : stub table holding TCGA breast-cancer frequencies; replace with real data.  
--   5) paired     : rows where both datasets have a value → used for statistics.  
--   6) Final SELECT calculates CORR and p-value with ISB-CGC UDF, and filters for ≥ 5 pairs.
WITH bc_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111'
    AND Topo  = '0401'
),
tot AS (
  SELECT COUNT(*) AS n_cases FROM bc_cases
),
mit_freq AS (
  SELECT
    cc.Chr  AS chromosome,
    cc.Type AS aberration_type,
    100.0 *
      COUNT(DISTINCT CONCAT(cc.RefNo,'-',cc.CaseNo)) /
      MAX(tot.n_cases)                     AS mitelman_pct
  FROM `mitelman-db.prod.CytoConverted` cc
  JOIN bc_cases USING (RefNo, CaseNo)
  CROSS JOIN tot
  GROUP BY chromosome, aberration_type
),
tcga_freq AS (
  -- REPLACE the numbers below with real TCGA breast-cancer frequencies
  SELECT * FROM UNNEST([
    STRUCT('chr1','Gain',18.0),
    STRUCT('chr1','Loss', 7.5),
    STRUCT('chr2','Gain',15.2),
    STRUCT('chr2','Loss', 6.1),
    STRUCT('chr3','Gain',12.7),
    STRUCT('chr3','Loss', 9.9),
    STRUCT('chr4','Gain',14.0),
    STRUCT('chr4','Loss',10.2),
    STRUCT('chr5','Gain',11.3),
    STRUCT('chr5','Loss', 8.7)
  ]) AS tf(chromosome, aberration_type, tcga_pct)
),
paired AS (
  SELECT
    m.aberration_type,
    m.mitelman_pct,
    t.tcga_pct
  FROM mit_freq m
  JOIN tcga_freq t
    USING (chromosome, aberration_type)
)
SELECT
  aberration_type,
  CORR(mitelman_pct, tcga_pct) AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(
      CORR(mitelman_pct, tcga_pct),
      COUNT(*)
  )                            AS p_value,
  COUNT(*)                     AS n_chromosomes
FROM paired
GROUP BY aberration_type
HAVING n_chromosomes >= 5
ORDER BY aberration_type
LIMIT 20;
```
