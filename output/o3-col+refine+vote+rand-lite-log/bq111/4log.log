2025-05-05 03:56:49 - Thread-2477 (execute) - INFO - [Exploration]
Below are 10 incrementally-more-complex example queries that walk through  

1. locating breast-cancer cases in Mitelman (Morph = ‘3111’, Topo = ‘0401’),  
2. extracting their CytoConverter copy-number calls,  
3. turning those calls into chromosome-level frequencies, and  
4. (after inserting a small mock TCGA frequency table) computing chromosome-wise Pearson correlations and p-values.  

Every query only touches the tables listed in mitelman-db.prod and returns ≤ 20 rows.

```sql
--Description: 1)  Preview Mitelman cases that are breast carcinoma
SELECT `RefNo`,
       `CaseNo`,
       `Morph`,
       `Topo`,
       `Sex`,
       `Age`
FROM `mitelman-db.prod.Cytogen`
WHERE `Morph` = '3111'         -- breast cancer
  AND `Topo`  = '0401'         -- breast primary site
LIMIT 20;
```

```sql
--Description: 2)  Grab CytoConverted rows (gain/loss etc.) for those cases
WITH bc_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
)
SELECT cc.RefNo,
       cc.CaseNo,
       cc.Chr,
       cc.Type,
       cc.Start,
       cc.End
FROM `mitelman-db.prod.CytoConverted` AS cc
JOIN bc_cases USING (RefNo, CaseNo)
LIMIT 20;
```

```sql
--Description: 3)  Count number of copy-number segments per chromosome & aberration type
WITH bc_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
)
SELECT cc.Chr          AS chromosome,
       cc.Type         AS aberration_type,
       COUNT(*)        AS n_segments
FROM `mitelman-db.prod.CytoConverted` AS cc
JOIN bc_cases USING (RefNo, CaseNo)
GROUP BY chromosome, aberration_type
ORDER BY chromosome, aberration_type
LIMIT 20;
```

```sql
--Description: 4)  Convert those counts to case-level frequencies ( % of cases that show each event )
WITH bc_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
tot AS ( SELECT COUNT(*) AS n_cases FROM bc_cases ),
freq AS (
  SELECT cc.Chr                     AS chromosome,
         cc.Type                    AS aberration_type,
         COUNT(DISTINCT CONCAT(cc.RefNo,'-',cc.CaseNo)) AS cases_with_event
  FROM `mitelman-db.prod.CytoConverted` AS cc
  JOIN bc_cases USING (RefNo, CaseNo)
  GROUP BY chromosome, aberration_type
)
SELECT f.chromosome,
       f.aberration_type,
       ROUND(100 * f.cases_with_event / t.n_cases, 2) AS mitelman_freq_pct
FROM freq AS f, tot AS t
ORDER BY chromosome, aberration_type
LIMIT 20;
```

```sql
--Description: 5)  A tiny mock TCGA frequency table (replace with real TCGA output)
WITH tcga_freq AS (
  SELECT * FROM UNNEST([
    STRUCT('chr1' AS chromosome,'Gain' AS aberration_type, 18.0 AS tcga_freq_pct),
    STRUCT('chr1','Loss',  7.5),
    STRUCT('chr2','Gain', 15.2),
    STRUCT('chr2','Loss',  6.1),
    STRUCT('chr3','Gain', 12.7),
    STRUCT('chr3','Loss',  9.9)
  ])
)
SELECT * FROM tcga_freq
LIMIT 20;
```

```sql
--Description: 6)  Join Mitelman & TCGA frequencies so we can compare them side-by-side
WITH bc_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
tot AS ( SELECT COUNT(*) AS n_cases FROM bc_cases ),
mit_freq AS (
  SELECT cc.Chr  AS chromosome,
         cc.Type AS aberration_type,
         100.0 * COUNT(DISTINCT CONCAT(cc.RefNo,'-',cc.CaseNo)) / t.n_cases AS mitelman_freq_pct
  FROM `mitelman-db.prod.CytoConverted` AS cc,
       tot AS t
  JOIN bc_cases USING (RefNo, CaseNo)
  GROUP BY chromosome, aberration_type
),
tcga_freq AS (
  SELECT * FROM UNNEST([
    STRUCT('chr1','Gain',18.0),
    STRUCT('chr1','Loss', 7.5),
    STRUCT('chr2','Gain',15.2),
    STRUCT('chr2','Loss', 6.1),
    STRUCT('chr3','Gain',12.7),
    STRUCT('chr3','Loss', 9.9)
  ])  -- substitute your real TCGA numbers here
)
SELECT m.chromosome,
       m.aberration_type,
       ROUND(m.mitelman_freq_pct,2) AS mitelman_pct,
       ROUND(t.tcga_freq_pct,2)     AS tcga_pct
FROM mit_freq AS m
JOIN tcga_freq AS t
  USING (chromosome, aberration_type)
LIMIT 20;
```

```sql
--Description: 7)  Compute Pearson correlations (one per aberration type)
WITH bc_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
tot AS ( SELECT COUNT(*) AS n_cases FROM bc_cases ),
mit_freq AS (
  SELECT cc.Chr  AS chromosome,
         cc.Type AS aberration_type,
         100.0 * COUNT(DISTINCT CONCAT(cc.RefNo,'-',cc.CaseNo)) / t.n_cases AS mitelman_freq_pct
  FROM `mitelman-db.prod.CytoConverted` AS cc,
       tot AS t
  JOIN bc_cases USING (RefNo, CaseNo)
  GROUP BY chromosome, aberration_type
),
tcga_freq AS (
  SELECT * FROM UNNEST([
    STRUCT('chr1','Gain',18.0),
    STRUCT('chr1','Loss', 7.5),
    STRUCT('chr2','Gain',15.2),
    STRUCT('chr2','Loss', 6.1),
    STRUCT('chr3','Gain',12.7),
    STRUCT('chr3','Loss', 9.9)
  ])
),
joined AS (
  SELECT m.aberration_type,
         m.mitelman_freq_pct,
         t.tcga_freq_pct
  FROM mit_freq  AS m
  JOIN tcga_freq AS t
    USING (chromosome, aberration_type)
)
SELECT aberration_type,
       CORR(mitelman_freq_pct, tcga_freq_pct) AS pearson_r,
       COUNT(*)                               AS n_pairs
FROM joined
GROUP BY aberration_type
HAVING n_pairs >= 5     -- show only types with ≥5 matching chromosomes
LIMIT 20;
```

```sql
--Description: 8)  Add two-tailed p-value using the ISB-CGC UDF `corr_pvalue_current`
WITH bc_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
tot AS ( SELECT COUNT(*) AS n_cases FROM bc_cases ),
mit_freq AS (
  SELECT cc.Chr,
         cc.Type,
         100.0 * COUNT(DISTINCT CONCAT(cc.RefNo,'-',cc.CaseNo)) / t.n_cases AS mitelman_freq_pct
  FROM `mitelman-db.prod.CytoConverted` AS cc,
       tot AS t
  JOIN bc_cases USING (RefNo, CaseNo)
  GROUP BY cc.Chr, cc.Type
),
tcga_freq AS (
  SELECT * FROM UNNEST([
    STRUCT('chr1','Gain',18.0),
    STRUCT('chr1','Loss', 7.5),
    STRUCT('chr2','Gain',15.2),
    STRUCT('chr2','Loss', 6.1),
    STRUCT('chr3','Gain',12.7),
    STRUCT('chr3','Loss', 9.9),
    STRUCT('chr4','Gain',14.0),
    STRUCT('chr4','Loss',10.2),
    STRUCT('chr5','Gain',11.3),
    STRUCT('chr5','Loss', 8.7)
  ])
),
paired AS (
  SELECT m.Type              AS aberration_type,
         m.mitelman_freq_pct AS mit_freq,
         t.tcga_freq_pct     AS tcga_freq
  FROM mit_freq AS m
  JOIN tcga_freq AS t
    ON m.Chr  = t.chromosome
   AND m.Type = t.aberration_type
)
SELECT aberration_type,
       CORR(mit_freq, tcga_freq)                                               AS pearson_r,
       `isb-cgc-bq.functions.corr_pvalue_current`(CORR(mit_freq, tcga_freq),
                                                  COUNT(*))                   AS p_value,
       COUNT(*)                                                                AS n_pairs
FROM paired
GROUP BY aberration_type
HAVING n_pairs >= 5
LIMIT 20;
```

```sql
--Description: 9)  Inspect the paired Mitelman/TCGA values feeding the correlation
WITH bc_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
tot AS ( SELECT COUNT(*) AS n_cases FROM bc_cases ),
mit_freq AS (
  SELECT cc.Chr,
         cc.Type,
         100.0 * COUNT(DISTINCT CONCAT(cc.RefNo,'-',cc.CaseNo)) / t.n_cases AS mit_freq
  FROM `mitelman-db.prod.CytoConverted` AS cc, tot AS t
  JOIN bc_cases USING (RefNo, CaseNo)
  GROUP BY cc.Chr, cc.Type
),
tcga_freq AS (
  SELECT * FROM UNNEST([
    STRUCT('chr1','Gain',18.0),
    STRUCT('chr1','Loss', 7.5),
    STRUCT('chr2','Gain',15.2),
    STRUCT('chr2','Loss', 6.1),
    STRUCT('chr3','Gain',12.7),
    STRUCT('chr3','Loss', 9.9),
    STRUCT('chr4','Gain',14.0),
    STRUCT('chr4','Loss',10.2),
    STRUCT('chr5','Gain',11.3),
    STRUCT('chr5','Loss', 8.7)
  ])
)
SELECT m.Chr               AS chromosome,
       m.Type              AS aberration_type,
       ROUND(m.mit_freq,2) AS mitelman_pct,
       ROUND(t.tcga_freq_pct,2) AS tcga_pct
FROM mit_freq  AS m
JOIN tcga_freq AS t
  ON m.Chr  = t.chromosome
 AND m.Type = t.aberration_type
ORDER BY aberration_type, chromosome
LIMIT 20;
```

```sql
--Description: 10)  Count how many chromosomes have data for each aberration type (quality check)
WITH bc_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
mit_chrom AS (
  SELECT DISTINCT Chr AS chromosome, Type AS aberration_type
  FROM `mitelman-db.prod.CytoConverted` cc
  JOIN bc_cases USING (RefNo, CaseNo)
),
tcga_freq AS (
  SELECT * FROM UNNEST([
    STRUCT('chr1','Gain',18.0),
    STRUCT('chr1','Loss', 7.5),
    STRUCT('chr2','Gain',15.2),
    STRUCT('chr2','Loss', 6.1),
    STRUCT('chr3','Gain',12.7),
    STRUCT('chr3','Loss', 9.9),
    STRUCT('chr4','Gain',14.0),
    STRUCT('chr4','Loss',10.2),
    STRUCT('chr5','Gain',11.3),
    STRUCT('chr5','Loss', 8.7)
  ])
)
SELECT m.aberration_type,
       COUNT(*) AS chromosomes_with_both_sources
FROM mit_chrom AS m
JOIN tcga_freq AS t
  ON m.chromosome = t.chromosome
 AND m.aberration_type = t.aberration_type
GROUP BY m.aberration_type
HAVING chromosomes_with_both_sources >= 5
LIMIT 20;
```

These queries demonstrate every step needed to arrive at chromosome-level Pearson correlations (with corresponding p-values) between Mitelman copy-number data and TCGA data, while ensuring each aberration type is evaluated only when at least five chromosomes are shared between the two resources.
