  SELECT 'chr4','Loss',10.2 UNION ALL
  SELECT 'chr5','Gain',11.3 UNION ALL
  SELECT 'chr5','Loss', 8.7
  -- columns: chromosome, aberration_type, tcga_pct
),
joined AS (                              -- chromosomes with data in both sets
  SELECT
    m.aberration_type,
    m.mitelman_pct,
    t.tcga_pct
  FROM mit_freq  AS m
  JOIN tcga_freq AS t
