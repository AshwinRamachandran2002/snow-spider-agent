--     two frequency vectors and a two-tailed p-value (ISB-CGC UDF);
--   • keeps only aberration types represented on at least five chromosomes.
WITH bc_cases AS (                       -- cohort: Mitelman breast cancer
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
tot AS (                                 -- cohort size
  SELECT COUNT(*) AS n_cases FROM bc_cases
),
mit_freq AS (                            -- Mitelman chromosome-level % frequencies
  SELECT
    cc.Chr  AS chromosome,
    cc.Type AS aberration_type,
    100.0 *
      COUNT(DISTINCT CONCAT(cc.RefNo,'-',cc.CaseNo))
      / MAX(tot.n_cases)                 AS mitelman_pct
  FROM `mitelman-db.prod.CytoConverted` cc
  JOIN bc_cases USING (RefNo, CaseNo)
  CROSS JOIN tot                         -- enables MAX in aggregation
  GROUP BY chromosome, aberration_type
),
tcga_freq AS (                           -- stub TCGA table (replace with real data)
