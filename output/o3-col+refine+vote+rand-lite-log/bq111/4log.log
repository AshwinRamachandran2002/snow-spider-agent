[{'MolClin': 'C', 'RefNo': 3967, 'InvNo': 1, 'OrderNo': 1, 'Prefix': None, 'Gene': 'BCR::ABL1', 'Suffix': None}, {'MolClin': 'C', 'RefNo': 3976, 'InvNo': 1, 'OrderNo': 1, 'Prefix': None, 'Gene': 'BCR::ABL1', 'Suffix': None}, {'MolClin': 'C', 'RefNo': 3976, 'InvNo': 2, 'OrderNo': 1, 'Prefix': None, 'Gene': 'BCR::ABL1', 'Suffix': None}, {'MolClin': 'C', 'RefNo': 4541, 'InvNo': 1, 'OrderNo': 1, 'Prefix': None, 'Gene': 'PML::RARA', 'Suffix': None}, {'MolClin': 'C', 'RefNo': 4624, 'InvNo': 1, 'OrderNo': 1, 'Prefix': None, 'Gene': 'BCR::ABL1', 'Suffix': None}]

