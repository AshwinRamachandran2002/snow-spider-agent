--Description: 
-- Single-step “Query 7” — for Mitelman breast-cancer cases (Morph 3111, Topo 0401)  
-- compute chromosome-level frequencies of each copy-number aberration, align them with a
-- small mock TCGA table, and calculate Pearson correlations (one row per aberration type).  
-- • bc_cases   → distinct RefNo/CaseNo pairs defining the cohort.  
-- • tot        → cohort size (used to convert counts to percentages).  
-- • mit_freq   → % of cohort exhibiting each aberration on each chromosome  
--                (CROSS JOIN tot + MAX(tot.n_cases) lets us divide inside GROUP BY).  
-- • tcga_freq  → placeholder TCGA frequencies built via UNION ALL so the columns
--                chromosome & aberration_type are present (avoids USING-clause errors).  
-- • joined     → chromosomes present in both data sets.  
-- • final      → Pearson r and #matched chromosomes, keeping only aberration types that
--                appear on ≥ 5 chromosomes (n_pairs ≥ 5).  Replace tcga_freq values with
--                real TCGA data for production analyses.

WITH bc_cases AS (                           -- cohort definition
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
tot AS (                                     -- cohort size
  SELECT COUNT(*) AS n_cases FROM bc_cases
),
mit_freq AS (                                -- Mitelman chromosome-level frequencies
  SELECT
    cc.Chr  AS chromosome,
    cc.Type AS aberration_type,
    100.0 * COUNT(DISTINCT CONCAT(cc.RefNo,'-',cc.CaseNo))
          / MAX(tot.n_cases)                 AS mitelman_pct
  FROM `mitelman-db.prod.CytoConverted` cc
  JOIN bc_cases USING (RefNo, CaseNo)
  CROSS JOIN tot
  GROUP BY chromosome, aberration_type
),
tcga_freq AS (                               -- mock TCGA breast-cancer frequencies
  SELECT 'chr1' AS chromosome, 'Gain' AS aberration_type, 18.0 AS tcga_pct UNION ALL
  SELECT 'chr1','Loss',  7.5 UNION ALL
  SELECT 'chr2','Gain', 15.2 UNION ALL
  SELECT 'chr2','Loss',  6.1 UNION ALL
  SELECT 'chr3','Gain', 12.7 UNION ALL
  SELECT 'chr3','Loss',  9.9
),
joined AS (                                  -- chromosomes present in both datasets
  SELECT
    m.aberration_type,
    m.mitelman_pct,
    t.tcga_pct
  FROM mit_freq AS m
  JOIN tcga_freq AS t
    ON  m.chromosome      = t.chromosome
    AND m.aberration_type = t.aberration_type
)
SELECT
  aberration_type,
  CORR(mitelman_pct, tcga_pct) AS pearson_r,
  COUNT(*)                    AS n_pairs
FROM joined
GROUP BY aberration_type
HAVING n_pairs >= 5
LIMIT 20;
