```sql
/*---------------------------------------------------------------------------
  Pearson correlation (and p-value) between Mitelman and TCGA copy-number
  frequencies for breast carcinoma (Morph = 3111, Topo = 0401)
  – results are returned per chromosome and aberration type
  – only aberration types having ≥ 5 matching cytobands are reported
---------------------------------------------------------------------------*/
WITH
/*---------------------------------------------------------------------------
-- 1)  Breast-carcinoma (3111 / 0401) cases in Mitelman
---------------------------------------------------------------------------*/
mit_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111'          -- breast carcinoma
    AND  Topo  = '0401'          -- primary site: breast
),
mit_tot AS ( SELECT COUNT(*) AS n_cases FROM mit_cases ),

/*---------------------------------------------------------------------------
-- 2)  Mitelman copy-number events  →  map to hg38 cytobands
---------------------------------------------------------------------------*/
mit_events AS (
  SELECT
    cb.chromosome,
    cb.cytoband_name,
