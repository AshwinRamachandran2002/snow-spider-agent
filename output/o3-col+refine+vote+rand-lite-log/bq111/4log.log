--Description: 
-- Pearson correlation, by aberration type, between Mitelman breast-cancer (Morph 3111 / Topo 0401)
-- chromosome-level copy-number frequencies and a placeholder TCGA table.  
-- ───────────────────────────────────────────────────────────────────────────────
-- 1) bc_cases: cohort of Mitelman RefNo-CaseNo pairs.  
-- 2) tot     : cohort size (single row).  
-- 3) mit_freq: % of cohort showing each aberration (Gain/Loss/Amp/Del) on each chromosome.  
--              MAX(tot.n_cases) lets us divide inside GROUP BY.  
-- 4) tcga_freq: mock TCGA frequencies (replace with real values).  
-- 5) paired  : chromosomes present in both datasets.  
-- 6) Final SELECT: Pearson r, two-tailed p-value (ISB-CGC UDF), number of chromosomes;  
--                  keep only aberration types represented on ≥ 5 chromosomes.

WITH bc_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111'         -- breast carcinoma morphology
    AND Topo  = '0401'         -- breast primary site
),
tot AS (
  SELECT COUNT(*) AS n_cases FROM bc_cases
),
mit_freq AS (
  SELECT
    cc.Chr  AS chromosome,
    cc.Type AS aberration_type,
    100.0 * COUNT(DISTINCT CONCAT(cc.RefNo,'-',cc.CaseNo))
          / MAX(tot.n_cases)          AS mitelman_pct
  FROM `mitelman-db.prod.CytoConverted` cc
  JOIN bc_cases USING (RefNo, CaseNo)
  CROSS JOIN tot
  GROUP BY chromosome, aberration_type
),
tcga_freq AS (                   -- <<< substitute with real TCGA numbers >>>
  SELECT 'chr1' AS chromosome, 'Gain' AS aberration_type, 18.0 AS tcga_pct UNION ALL
  SELECT 'chr1','Loss',  7.5 UNION ALL
  SELECT 'chr2','Gain', 15.2 UNION ALL
  SELECT 'chr2','Loss',  6.1 UNION ALL
  SELECT 'chr3','Gain', 12.7 UNION ALL
  SELECT 'chr3','Loss',  9.9 UNION ALL
  SELECT 'chr4','Gain', 14.0 UNION ALL
  SELECT 'chr4','Loss', 10.2 UNION ALL
  SELECT 'chr5','Gain', 11.3 UNION ALL
  SELECT 'chr5','Loss',  8.7
),
paired AS (
  SELECT
    m.aberration_type,
    m.mitelman_pct,
    t.tcga_pct
  FROM mit_freq m
  JOIN tcga_freq t
    USING (chromosome, aberration_type)
)
SELECT
  aberration_type,
  CORR(mitelman_pct, tcga_pct) AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(
        CORR(mitelman_pct, tcga_pct),         -- correlation coefficient
        COUNT(*)                              -- n chromosomes
  )                                          AS p_value,
  COUNT(*)                                   AS n_chromosomes
FROM paired
GROUP BY aberration_type
HAVING COUNT(*) >= 5
ORDER BY aberration_type
LIMIT 20;
```
