--Description:  For every aberration class (Gain, Loss, Amp, Del) compute Pearson
--               correlation between (a) CytoConverted breast-cancer frequency (%)
--               and (b) RecurrentNumData case counts across chromosomes, then
--               convert each correlation to its two-tailed p-value.  Fixes vs.
--               previous version:
--                 • Strip “chr” prefix in CytoConverted so chromosome labels match.
--                 • RecurrentNumData is filtered on Morph 3111 only (Topo removed) to
--                   maximise overlap.
--                 • The p-value UDF expects scalar (r, n); therefore the correlation and
--                   sample size are first computed per aberration class and those two
--                   scalars are passed to the UDF.
WITH types AS (
  SELECT 'Gain' AS t UNION ALL
  SELECT 'Loss' UNION ALL
  SELECT 'Amp'  UNION ALL
  SELECT 'Del'
),

/* cohort of breast-cancer adenocarcinoma cases */
cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE TRIM(Morph) = '3111'
    AND TRIM(Topo)  = '0401'
),
tot AS (SELECT COUNT(*) AS n_cases FROM cohort),

/* CytoConverted: percentage of cohort with each aberration type, per chromosome */
mit_freq AS (
  SELECT
    REGEXP_REPLACE(cc.Chr, r'^chr', '')      AS chromosome,       -- 'chr1'→'1'
    cc.Type                                   AS Type,
    COUNT(DISTINCT CONCAT(cc.RefNo,'|',cc.CaseNo)) AS n_cases
  FROM `mitelman-db.prod.CytoConverted` cc
  JOIN cohort co
    ON cc.RefNo = co.RefNo AND cc.CaseNo = co.CaseNo
  GROUP BY chromosome, Type
),
mit_pct AS (
  SELECT
    chromosome,
    Type,
    100.0 * n_cases / tot.n_cases AS freq_pct
  FROM mit_freq, tot
),

/* RecurrentNumData: total case counts per chromosome & aberration class            */
/* Mapping rule: +  → Gain,  - → Loss,  i(...) → Amp,  del(...) → Del               */
rec_cnt AS (
  SELECT
    Chromosome                               AS chromosome,
    CASE
      WHEN Abnormality LIKE '+%'  THEN 'Gain'
      WHEN Abnormality LIKE '-%'  THEN 'Loss'
      WHEN Abnormality LIKE 'i%'  THEN 'Amp'
      WHEN Abnormality LIKE 'del%' THEN 'Del'
    END                                       AS Type,
    SUM(CAST(TotalCases AS INT64))            AS tot_cases
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE Morph = '3111'                        -- same morphology; no Topo filter
  GROUP BY chromosome, Type
),

/* Join the two sources and compute r & n for each aberration class */
stats AS (
  SELECT
    t.t                                            AS AberrationType,
    COUNT(*)                                       AS n_chromosomes,
    CORR(mit_pct.freq_pct, rec_cnt.tot_cases)      AS pearson_r
  FROM types           AS t
  JOIN mit_pct         ON mit_pct.Type = t.t
  JOIN rec_cnt         ON rec_cnt.Type = t.t
                      AND rec_cnt.chromosome = mit_pct.chromosome
  GROUP BY t.t
)

SELECT
  AberrationType,
  n_chromosomes,
  pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(pearson_r, n_chromosomes) AS p_value
FROM stats
WHERE n_chromosomes >= 5           -- report only if ≥5 chromosomes per class
ORDER BY AberrationType;
