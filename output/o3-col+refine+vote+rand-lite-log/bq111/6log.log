```sql
-- 5. Description:  Derive *case-level* binary matrix (1 = aberration present at least once)
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  TRIM(Morph) = '3111'
    AND  TRIM(Topo)  = '0401'
),
calls AS (
  SELECT DISTINCT RefNo,
                  CaseNo,
                  Chr,
                  Type
  FROM   `mitelman-db.prod.CytoConverted`
)
SELECT Chr,
       Type,
       COUNT(*) AS cases_with_event
FROM   cohort
JOIN   calls USING (RefNo, CaseNo)
GROUP  BY Chr, Type
ORDER  BY Chr, Type
LIMIT  20;
```

```sql
-- 6. Description:  Compute frequency (%) of each aberration-type per chromosome
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  TRIM(Morph) = '3111'
    AND  TRIM(Topo)  = '0401'
),
total_cases AS (SELECT COUNT(*) AS n FROM cohort),
event_cases AS (
  SELECT Chr,
         Type,
         COUNT(DISTINCT CONCAT(RefNo,'|',CaseNo)) AS n_cases
  FROM   `mitelman-db.prod.CytoConverted` cc
  JOIN   cohort                              co
    ON   cc.RefNo  = co.RefNo
   AND   cc.CaseNo = co.CaseNo
  GROUP  BY Chr, Type
)
SELECT Chr,
       Type,
       n_cases,
       ROUND(100 * n_cases / (SELECT n FROM total_cases),2) AS freq_pct
FROM   event_cases
ORDER  BY Chr, Type
LIMIT  20;
```

```sql
-- 7. Description:  Bring in Mitelman pre-aggregated counts (RecurrentNumData) for the same morph/topo
SELECT Chromosome     AS ChrLabel,
       Abnormality,
       TotalCases,
       ChrOrder
FROM   `mitelman-db.prod.RecurrentNumData`
WHERE  Morph = '3111'
  AND  TRIM(Topo) = '0401'
LIMIT  20;
```

```sql
-- 8. Description:  Summarise RecurrentNumData into gains vs losses (+ / ‑) per chromosome
WITH rn AS (
  SELECT Chromosome,
         CASE
           WHEN Abnormality LIKE '+%'  THEN 'Gain'
           WHEN Abnormality LIKE '-%'  THEN 'Loss'
           ELSE NULL
         END AS Type,
         CAST(TotalCases AS INT64) AS n_cases
  FROM   `mitelman-db.prod.RecurrentNumData`
  WHERE  Morph = '3111'
    AND  TRIM(Topo) = '0401'
)
SELECT Chromosome,
       Type,
       SUM(n_cases) AS total_cases
FROM   rn
WHERE  Type IS NOT NULL
GROUP  BY Chromosome, Type
ORDER  BY Chromosome, Type
LIMIT  20;
```

```sql
-- 9. Description:  Example of computing Pearson correlation (Gain) between
--                 CytoConverted frequencies and RecurrentNumData counts
WITH mit AS (
  /* frequency from CytoConverted (query 6) restricted to 'Gain' */
  SELECT Chr AS chromosome,
         ROUND(100 * n_cases / total.n,3) AS freq_pct
  FROM (
      SELECT Chr, COUNT(DISTINCT CONCAT(RefNo,'|',CaseNo)) AS n_cases
      FROM   `mitelman-db.prod.CytoConverted` cc
      JOIN   (SELECT DISTINCT RefNo, CaseNo
              FROM `mitelman-db.prod.Cytogen`
              WHERE TRIM(Morph) = '3111'
                AND TRIM(Topo)  = '0401') cohort
        ON cc.RefNo = cohort.RefNo AND cc.CaseNo = cohort.CaseNo
      WHERE  cc.Type = 'Gain'
      GROUP  BY Chr
  ) mit
  CROSS JOIN (SELECT COUNT(*) AS n
              FROM (SELECT DISTINCT RefNo, CaseNo
                    FROM `mitelman-db.prod.Cytogen`
                    WHERE TRIM(Morph) = '3111'
                      AND TRIM(Topo)  = '0401')) total
),
rec AS (
  /* counts from RecurrentNumData aggregated to 'Gain' */
  SELECT Chromosome AS chromosome,
         SUM(CAST(TotalCases AS INT64)) AS tot_cases
  FROM   `mitelman-db.prod.RecurrentNumData`
  WHERE  Morph = '3111'
    AND  TRIM(Topo) = '0401'
    AND  Abnormality LIKE '+%'
  GROUP  BY Chromosome
)
SELECT
  COUNT(*)                                    AS n_points,
  CORR(mit.freq_pct, rec.tot_cases)           AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`  -- UDF for p-value
        (ARRAY_AGG(mit.freq_pct ORDER BY mit.chromosome),
         ARRAY_AGG(rec.tot_cases ORDER BY rec.chromosome)) AS p_value
FROM mit
JOIN rec USING (chromosome)
HAVING n_points >= 5;
```

```sql
--10. Description:  Produce final table of correlations (Gain, Loss, Amp, Del);
--                  only rows with ≥5 matching chromosomes are kept (LIMIT 20 shown)
WITH types AS (SELECT 'Gain' AS t UNION ALL SELECT 'Loss' UNION ALL SELECT 'Amp' UNION ALL SELECT 'Del'),
cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  TRIM(Morph) = '3111'
    AND  TRIM(Topo)  = '0401'
),
total_cases AS (SELECT COUNT(*) AS n FROM cohort),
mit_freq AS (
  SELECT Chr AS chromosome,
         Type,
         COUNT(DISTINCT CONCAT(RefNo,'|',CaseNo)) AS n_cases
  FROM   `mitelman-db.prod.CytoConverted` cc
  JOIN   cohort co
    ON   cc.RefNo = co.RefNo AND cc.CaseNo = co.CaseNo
  GROUP  BY Chr, Type
),
mit_pct AS (
  SELECT chromosome,
         Type,
         ROUND(100 * n_cases / (SELECT n FROM total_cases),3) AS freq_pct
  FROM   mit_freq
),
rec_cnt AS (
  SELECT Chromosome AS chromosome,
         CASE
           WHEN Abnormality LIKE '+%' THEN 'Gain'
           WHEN Abnormality LIKE '-%' THEN 'Loss'
           WHEN Abnormality LIKE 'i%'  THEN 'Amp'    -- simplistic mapping example
           WHEN Abnormality LIKE 'del%' THEN 'Del'
         END AS Type,
         SUM(CAST(TotalCases AS INT64)) AS tot_cases
  FROM   `mitelman-db.prod.RecurrentNumData`
  WHERE  Morph = '3111'
    AND  TRIM(Topo) = '0401'
  GROUP  BY chromosome, Type
)
SELECT
  t.t         AS AberrationType,
  COUNT(*)    AS n_chromosomes,
  CORR(mit_pct.freq_pct, rec_cnt.tot_cases)            AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`
     (ARRAY_AGG(mit_pct.freq_pct ORDER BY mit_pct.chromosome),
      ARRAY_AGG(rec_cnt.tot_cases ORDER BY rec_cnt.chromosome)) AS p_value
FROM   types t
JOIN   mit_pct  ON mit_pct.Type  = t.t
JOIN   rec_cnt  ON rec_cnt.Type  = t.t AND rec_cnt.chromosome = mit_pct.chromosome
GROUP  BY t.t
HAVING n_chromosomes >= 5
LIMIT 20;
```

The 10 queries above progressively explore:

1. Cohort size  
2. Example cohort rows  
3. Raw copy-number events  
4. Segment counts  
5. Binary case/event matrix  
6. Event frequencies (%) per chromosome  
7. Mitelman’s pre-aggregated recurrent table  
8. Aggregated gains/losses in that table  
9. Sample Pearson correlation (gains) with p-value  
10. Final correlation summary for all four event types, retaining only results with ≥5 matching chromosomes.
