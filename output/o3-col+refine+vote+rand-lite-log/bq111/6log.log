Query:
--Description:  Corrected version of the earlier fragment (removed stray “*/” and
--               wrapped comment lines with “--”).  This query computes, for each
--               aberration class (Gain, Loss, Amp, Del), the Pearson correlation
--               across chromosomes between CytoConverted frequency (%) and
--               RecurrentNumData case counts in breast-cancer adenocarcinoma
--               (Morph = 3111, Topo = 0401).  A two-tailed p-value is derived from
--               each correlation using the ISB-CGC UDF.

WITH types AS (
  SELECT 'Gain' AS t UNION ALL
  SELECT 'Loss' UNION ALL
  SELECT 'Amp'  UNION ALL
  SELECT 'Del'
),

/* cohort of breast-cancer adenocarcinoma cases */
cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE TRIM(Morph) = '3111'
    AND TRIM(Topo)  = '0401'
),
tot AS (SELECT COUNT(*) AS n_cases FROM cohort),

/* CytoConverted: % of cohort with each event per chromosome */
mit_counts AS (
  SELECT
    REGEXP_REPLACE(cc.Chr, r'^chr', '')            AS chromosome,
    cc.Type                                         AS Type,
    COUNT(DISTINCT CONCAT(cc.RefNo,'|',cc.CaseNo))  AS case_cnt
  FROM `mitelman-db.prod.CytoConverted` cc
  JOIN cohort co
    ON cc.RefNo = co.RefNo AND cc.CaseNo = co.CaseNo
  GROUP BY chromosome, Type
),
mit_pct AS (
  SELECT
    chromosome,
    Type,
    100.0 * case_cnt / tot.n_cases AS freq_pct
  FROM mit_counts, tot
),

/* RecurrentNumData: aggregate case counts — no Topo filter to maximise overlap */
rec_cnt AS (
  SELECT
    Chromosome AS chromosome,
    CASE
      WHEN Abnormality LIKE '+%'   THEN 'Gain'
      WHEN Abnormality LIKE '-%'   THEN 'Loss'
      WHEN Abnormality LIKE 'i%'   THEN 'Amp'
      WHEN Abnormality LIKE 'del%' THEN 'Del'
    END                             AS Type,
    SUM(CAST(TotalCases AS INT64))  AS tot_cases
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE Morph = '3111'
  GROUP BY chromosome, Type
  HAVING Type IS NOT NULL
),

/* Join datasets and compute Pearson r per class */
stats AS (
  SELECT
    t.t                                AS AberrationType,
    COUNT(*)                           AS n_chromosomes,
    CORR(mit_pct.freq_pct,
         rec_cnt.tot_cases)            AS pearson_r
  FROM types     t
  JOIN mit_pct   ON mit_pct.Type = t.t
  JOIN rec_cnt   ON rec_cnt.Type = t.t
                AND rec_cnt.chromosome = mit_pct.chromosome
  GROUP BY t.t
)

SELECT
  AberrationType,
  n_chromosomes,
  pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(pearson_r, n_chromosomes) AS p_value
FROM stats
WHERE n_chromosomes >= 5
ORDER BY AberrationType
