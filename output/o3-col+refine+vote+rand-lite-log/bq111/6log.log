```sql
-- Description / thinking process:
-- Goal: For breast-cancer Mitelman cases (Morph = 3111, Topo = 0401) find, per chromosome
--       and copy-number event type (Gain, Loss, Amp, Del), how many DISTINCT cases show
--       the event and what percentage this represents of the whole cohort.
-- Steps
--   1) Build “cohort” of unique (RefNo, CaseNo) satisfying morph/topo.
--   2) Count the cohort size (total_cases).
--   3) Join CytoConverted with cohort; for every Chr & Type count DISTINCT cases.
--   4) Calculate frequency (%) = cases_with_event ÷ total_cases × 100.
-- Notes
--   • Use fully-qualified aliases (cc.RefNo, cc.CaseNo) to avoid “ambiguous column” errors.
--   • CONCAT(RefNo,'|',CaseNo) ensures uniqueness when counting DISTINCT cases.
--   • ROUND to two decimals for readability.

WITH cohort AS (                                   -- Step-1
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  TRIM(Morph) = '3111'
    AND  TRIM(Topo)  = '0401'
),
total AS (                                         -- Step-2
  SELECT COUNT(*) AS total_cases FROM cohort
),
per_chr_type AS (                                  -- Step-3
  SELECT cc.Chr,
         cc.Type,
         COUNT(DISTINCT CONCAT(cc.RefNo,'|',cc.CaseNo)) AS cases_with_event
  FROM   `mitelman-db.prod.CytoConverted` AS cc
  JOIN   cohort                           AS co
    ON   cc.RefNo  = co.RefNo
   AND   cc.CaseNo = co.CaseNo
  GROUP  BY cc.Chr, cc.Type
)
SELECT
  Chr,
  Type,
  cases_with_event,
  ROUND(100.0 * cases_with_event / total_cases, 2) AS freq_pct   -- Step-4
FROM   per_chr_type, total
ORDER  BY Chr, Type;
```
