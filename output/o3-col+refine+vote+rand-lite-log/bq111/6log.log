--Description / thinking process:
-- Goal:  Calculate the Pearson correlation (and two-tailed p-value) for “Gain” events,
--        comparing the percentage of breast-cancer cases (Morph 3111 / Topo 0401) that
--        show a gain in CytoConverted with the corresponding case-counts in
--        RecurrentNumData, across chromosomes.
-- Strategy
--   1. Build the set of distinct breast-cancer cases (cohort) and its size (total_n).
--   2. For each chromosome, compute mit.freq_pct = 100 × (# cases with gain)/total_n.
--   3. For each chromosome, compute rec.tot_cases = summed gain counts in RecurrentNumData.
--   4. Join the two tables on chromosome and calculate Pearson r and N.
--   5. Feed r and N (scalars) to isb-cgc-bq.functions.corr_pvalue_current(r, N).

WITH cohort AS (                           -- 1) distinct breast-cancer cases
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE TRIM(Morph) = '3111'
    AND TRIM(Topo)  = '0401'
),
total_sz AS (                              -- cohort size
  SELECT COUNT(*) AS total_n FROM cohort
),

mit AS (                                   -- 2) % of cohort with GAIN per chromosome
  SELECT
    cc.Chr AS chromosome,
    100.0 * COUNT(DISTINCT CONCAT(cc.RefNo,'|',cc.CaseNo))
          / (SELECT total_n FROM total_sz) AS freq_pct
  FROM `mitelman-db.prod.CytoConverted` AS cc
  JOIN cohort                            AS co
    ON cc.RefNo  = co.RefNo
   AND cc.CaseNo = co.CaseNo
  WHERE cc.Type = 'Gain'
  GROUP BY cc.Chr
),

rec AS (                                   -- 3) RecurrentNumData GAIN counts
  SELECT
    Chromosome AS chromosome,
    SUM(CAST(TotalCases AS INT64)) AS tot_cases
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE Morph = '3111'
    AND TRIM(Topo) = '0401'
    AND Abnormality LIKE '+%'              -- select gains
  GROUP BY Chromosome
),

stats AS (                                 -- 4) Pearson r and sample size N
  SELECT
    COUNT(*)                          AS n_points,
    CORR(mit.freq_pct, rec.tot_cases) AS pearson_r
  FROM mit
  JOIN rec USING (chromosome)
)

-- 5) final output with p-value
SELECT
  n_points,
  pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(pearson_r, n_points) AS p_value
FROM stats
WHERE n_points >= 5;
