-- 5. Description:  Derive *case-level* binary matrix (1 = aberration present at least once)
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  TRIM(Morph) = '3111'
    AND  TRIM(Topo)  = '0401'
),
calls AS (
  SELECT DISTINCT RefNo,
                  CaseNo,
                  Chr,
                  Type
  FROM   `mitelman-db.prod.CytoConverted`
)
SELECT Chr,
       Type,
       COUNT(*) AS cases_with_event
FROM   cohort
JOIN   calls USING (RefNo, CaseNo)
GROUP  BY Chr, Type
ORDER  BY Chr, Type
LIMIT  20;
