```sql
--Description / thinking process:
-- Compute, for each aberration class (Gain, Loss, Amp, Del), the Pearson correlation
-- between (a) CytoConverted breast-cancer frequency (%) and (b) RecurrentNumData
-- breast-cancer case counts across chromosomes.  We then convert the correlation
-- to a two-tailed p-value with the BigQuery UDF
--      isb-cgc-bq.functions.corr_pvalue_current(r FLOAT64, n INT64)
-- which requires scalar inputs (r, n).  Thus we first aggregate by aberration
-- type to obtain one Pearson r and sample size (n_chromosomes) per class, then
-- feed those two scalars into the UDF.
WITH
/* 1) cohort of unique breast-cancer cases (Morph 3111, Topo 0401) */
cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE TRIM(Morph) = '3111'
    AND TRIM(Topo)  = '0401'
),
tot AS (SELECT COUNT(*) AS n_cases FROM cohort),

/* 2) CytoConverted: % of cohort with each aberration type per chromosome */
mit_freq AS (
  SELECT
    cc.Chr  AS chromosome,
    cc.Type AS Type,
    COUNT(DISTINCT CONCAT(cc.RefNo,'|',cc.CaseNo)) AS n_cases
  FROM `mitelman-db.prod.CytoConverted` AS cc
  JOIN cohort                            AS co
    ON cc.RefNo  = co.RefNo
   AND cc.CaseNo = co.CaseNo
  GROUP BY cc.Chr, cc.Type
),
mit_pct AS (
  SELECT
    chromosome,
    Type,
    100.0 * n_cases / tot.n_cases AS freq_pct
  FROM mit_freq, tot
),

/* 3) RecurrentNumData: map raw abnormalities to classes and sum case counts */
rec_cnt AS (
  SELECT
    Chromosome AS chromosome,
    CASE
      WHEN Abnormality LIKE '+%'  THEN 'Gain'
      WHEN Abnormality LIKE '-%'  THEN 'Loss'
      WHEN Abnormality LIKE 'i%'  THEN 'Amp'
      WHEN Abnormality LIKE 'del%' THEN 'Del'
    END                              AS Type,
    CAST(TotalCases AS INT64)        AS n_cases
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE Morph = '3111'
    AND TRIM(Topo) = '0401'
),
rec_sum AS (
  SELECT
    chromosome,
    Type,
    SUM(n_cases) AS tot_cases
  FROM rec_cnt
  WHERE Type IS NOT NULL
  GROUP BY chromosome, Type
),

/* 4) Join the two datasets on chromosome & aberration type */
joined AS (
  SELECT
    m.Type,
    m.chromosome,
    m.freq_pct,
    r.tot_cases
  FROM mit_pct AS m
  JOIN rec_sum AS r
    ON m.Type = r.Type
   AND m.chromosome = r.chromosome
),

/* 5) For each type, compute Pearson r and number of chromosomes */
stats AS (
  SELECT
    Type                   AS AberrationType,
    COUNT(*)               AS n_chromosomes,
    CORR(freq_pct, tot_cases) AS pearson_r
  FROM joined
  GROUP BY Type
)

/* 6) Add p-values (only keep types with ≥5 chromosomes) */
SELECT
  AberrationType,
  n_chromosomes,
  pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(pearson_r, n_chromosomes) AS p_value
FROM stats
WHERE n_chromosomes >= 5
ORDER BY AberrationType;
