```sql
--Description: 7) Retrieve Mitelman RecurrentNumData rows for breast cancer (morph 3111 / topo 0401);
--              shows per-chromosome raw abnormality strings and case counts.
SELECT
  Chromosome     AS ChrLabel,
  Abnormality,
  TotalCases,
  ChrOrder
FROM `mitelman-db.prod.RecurrentNumData`
WHERE Morph = '3111'
  AND TRIM(Topo) = '0401'
LIMIT 20;
```

```sql
--Description: 8) Summarise those RecurrentNumData rows into simple Gain (+) vs Loss (-) tallies
--              per chromosome.  Ambiguity-free because only this table is used.
WITH rn AS (
  SELECT
    Chromosome,
    CASE
      WHEN Abnormality LIKE '+%' THEN 'Gain'
      WHEN Abnormality LIKE '-%' THEN 'Loss'
      ELSE NULL
    END                    AS Type,
    CAST(TotalCases AS INT64) AS n_cases
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE Morph = '3111'
    AND TRIM(Topo) = '0401'
)
SELECT
  Chromosome,
  Type,
  SUM(n_cases) AS total_cases
FROM rn
WHERE Type IS NOT NULL
GROUP BY Chromosome, Type
ORDER BY Chromosome, Type
LIMIT 20;
```

```sql
--Description: 9) Example: compute Pearson correlation (for “Gain”) between
--              (a) CytoConverted breast-cancer frequencies and
--              (b) RecurrentNumData breast-cancer case counts, using fully-qualified
--              column names to avoid ambiguity.
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE TRIM(Morph) = '3111'
    AND TRIM(Topo)  = '0401'
),
total AS ( SELECT COUNT(*) AS n_cases FROM cohort ),

mit AS (   -- CytoConverted frequencies restricted to 'Gain'
  SELECT
    cc.Chr AS chromosome,
    ROUND(100.0 * COUNT(DISTINCT CONCAT(cc.RefNo,'|',cc.CaseNo)) / total.n_cases, 3) AS freq_pct
  FROM `mitelman-db.prod.CytoConverted` AS cc
  JOIN cohort                            AS co
    ON cc.RefNo  = co.RefNo
   AND cc.CaseNo = co.CaseNo
  CROSS JOIN total
  WHERE cc.Type = 'Gain'
  GROUP BY cc.Chr, total.n_cases
),

rec AS (   -- RecurrentNumData counts aggregated to 'Gain'
  SELECT
    Chromosome AS chromosome,
    SUM(CAST(TotalCases AS INT64)) AS tot_cases
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE Morph = '3111'
    AND TRIM(Topo) = '0401'
    AND Abnormality LIKE '+%'
  GROUP BY Chromosome
)

SELECT
  COUNT(*)                                   AS n_points,
  CORR(mit.freq_pct, rec.tot_cases)          AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current` -- UDF that yields two-tailed p-value
      (ARRAY_AGG(mit.freq_pct ORDER BY mit.chromosome),
       ARRAY_AGG(rec.tot_cases ORDER BY rec.chromosome)) AS p_value
FROM mit
JOIN rec USING (chromosome)
HAVING n_points >= 5;
```

```sql
--Description: 10) Final table: for each aberration type (Gain, Loss, Amp, Del) compute
--               Pearson correlation between CytoConverted frequency (%) and
--               RecurrentNumData case counts across chromosomes; keep only types with
--               ≥5 matching chromosomes.  All RefNo/CaseNo references are fully qualified.
WITH types AS (SELECT 'Gain' AS t UNION ALL SELECT 'Loss' UNION ALL SELECT 'Amp' UNION ALL SELECT 'Del'),

cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE TRIM(Morph) = '3111'
    AND TRIM(Topo)  = '0401'
),

tot AS (SELECT COUNT(*) AS n_cases FROM cohort),

mit_freq AS (   -- raw counts from CytoConverted
  SELECT
    cc.Chr  AS chromosome,
    cc.Type AS Type,
    COUNT(DISTINCT CONCAT(cc.RefNo,'|',cc.CaseNo)) AS n_cases
  FROM `mitelman-db.prod.CytoConverted` AS cc
  JOIN cohort                            AS co
    ON cc.RefNo  = co.RefNo
   AND cc.CaseNo = co.CaseNo
  GROUP BY cc.Chr, cc.Type
),

mit_pct AS (    -- convert to percentage of cohort
  SELECT
    chromosome,
    Type,
    ROUND(100.0 * n_cases / tot.n_cases, 3) AS freq_pct
  FROM mit_freq, tot
),

rec_cnt AS (    -- aggregate RecurrentNumData into canonical event classes
  SELECT
    Chromosome AS chromosome,
    CASE
      WHEN Abnormality LIKE '+%'                THEN 'Gain'
      WHEN Abnormality LIKE '-%'                THEN 'Loss'
      WHEN Abnormality LIKE 'i%'                THEN 'Amp'
      WHEN Abnormality LIKE 'del%'              THEN 'Del'
    END AS Type,
    SUM(CAST(TotalCases AS INT64)) AS tot_cases
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE Morph = '3111'
    AND TRIM(Topo) = '0401'
  GROUP BY chromosome, Type
)

SELECT
  t.t                       AS AberrationType,
  COUNT(*)                  AS n_chromosomes,
  CORR(mit_pct.freq_pct,
       rec_cnt.tot_cases)   AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`
    (ARRAY_AGG(mit_pct.freq_pct ORDER BY mit_pct.chromosome),
     ARRAY_AGG(rec_cnt.tot_cases ORDER BY rec_cnt.chromosome)) AS p_value
FROM types AS t
JOIN mit_pct ON mit_pct.Type = t.t
JOIN rec_cnt ON rec_cnt.Type = t.t
            AND rec_cnt.chromosome = mit_pct.chromosome
GROUP BY t.t
HAVING n_chromosomes >= 5
LIMIT 20;
