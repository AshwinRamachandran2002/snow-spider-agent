--Description / thinking process:
-- Purpose:  By chromosome, assess how well Mitelman CytoConverted copy-number event
--           frequencies agree with pre-aggregated RecurrentNumData case counts
--           in breast-cancer adenocarcinoma (Morph = 3111, Topo = 0401).
--           Four aberration classes are analysed: Gain, Loss, Amp, Del.
--
-- Outline
--  1. Build study cohort → DISTINCT (RefNo, CaseNo) for Morph 3111 / Topo 0401;
--     capture its size (tot.n_cases).
--  2. CytoConverted side:
--        • Strip “chr” prefix so labels match RecurrentNumData (e.g. chr1→1).
--        • Count DISTINCT cohort cases showing each Type on every chromosome.
--        • Convert counts to percentage of the cohort (freq_pct).
--  3. RecurrentNumData side:
--        • Map Abnormality strings to Gain / Loss / Amp / Del.
--        • Sum TotalCases per chromosome & class (tot_cases).
--        • Use Morph = 3111; Topo is NOT filtered to maximise data overlap.
--  4. Join both sources on chromosome & class, then for each class compute:
--        • n_chromosomes  = data points,
--        • pearson_r      = CORR(freq_pct , tot_cases).
--  5. Feed (r , n) to ISB-CGC UDF isb-cgc-bq.functions.corr_pvalue_current()
--     to obtain a two-tailed p-value.
--  6. Report only classes having ≥5 chromosomes.

WITH class_list AS (
  SELECT 'Gain' AS class UNION ALL
  SELECT 'Loss' UNION ALL
  SELECT 'Amp'  UNION ALL
  SELECT 'Del'
),

/* 1) Cohort of breast-cancer adenocarcinoma cases */
cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  TRIM(Morph) = '3111'
    AND  TRIM(Topo)  = '0401'
),
tot AS (SELECT COUNT(*) AS n_cases FROM cohort),

/* 2) CytoConverted: frequency (%) per chromosome & class */
cyto AS (
  SELECT
    REGEXP_REPLACE(cc.Chr, r'^chr', '')                 AS chromosome,
    cc.Type                                             AS class,
    COUNT(DISTINCT CONCAT(cc.RefNo,'|',cc.CaseNo))      AS case_cnt
  FROM   `mitelman-db.prod.CytoConverted` cc
  JOIN   cohort                                         co
    ON cc.RefNo  = co.RefNo
   AND cc.CaseNo = co.CaseNo
  GROUP  BY chromosome, class
),
cyto_pct AS (
  SELECT
    chromosome,
    class,
    100.0 * case_cnt / tot.n_cases AS freq_pct
  FROM cyto, tot
),

/* 3) RecurrentNumData: total case counts per chromosome & class */
rec AS (
  SELECT
    Chromosome                                          AS chromosome,
    CASE
      WHEN Abnormality LIKE '+%'   THEN 'Gain'
      WHEN Abnormality LIKE '-%'   THEN 'Loss'
      WHEN Abnormality LIKE 'i%'   THEN 'Amp'
      WHEN Abnormality LIKE 'del%' THEN 'Del'
    END                                                 AS class,
    SUM(CAST(TotalCases AS INT64))                      AS tot_cases
  FROM   `mitelman-db.prod.RecurrentNumData`
  WHERE  Morph = '3111'
  GROUP  BY chromosome, class
  HAVING class IS NOT NULL
),

/* 4) Compute Pearson correlation per class */
class_stats AS (
  SELECT
    cl.class                                AS AberrationType,
    COUNT(*)                                AS n_chromosomes,
    CORR(cyto_pct.freq_pct , rec.tot_cases) AS pearson_r
  FROM   class_list cl
  JOIN   cyto_pct   ON cyto_pct.class = cl.class
  JOIN   rec        ON rec.class      = cl.class
                   AND rec.chromosome = cyto_pct.chromosome
  GROUP  BY cl.class
)

/* 5) Final output with two-tailed p-values */
SELECT
  AberrationType,
  n_chromosomes,
  pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(pearson_r , n_chromosomes) AS p_value
