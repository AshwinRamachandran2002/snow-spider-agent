--Description:  Compute Pearson correlation (and two-tailed p-value) for “Gain” events
--               across chromosomes, comparing:
--                 (a) the percentage of breast-cancer adenocarcinoma cases
--                     (Morph = 3111, Topo = 0401) that show a gain in CytoConverted, and
--                 (b) the total number of Morph-3111 gain cases recorded in
--                     RecurrentNumData (Topo not filtered because most rows lack it).
--               Steps
--                 1. Build cohort of distinct (RefNo, CaseNo) with Morph 3111 & Topo 0401.
--                 2. Get cohort size (total_n).
--                 3. mit  : %-frequency of gains per chromosome (strip “chr” prefix).
--                 4. rec  : summed gain counts per chromosome from RecurrentNumData
--                            for Morph 3111 (Topo ignored to maximise overlap).
--                 5. Join on chromosome, compute Pearson r & sample size.
--                 6. Feed r and n into isb-cgc-bq.functions.corr_pvalue_current(r,n).

WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  TRIM(Morph) = '3111'
    AND  TRIM(Topo)  = '0401'          -- breast-cancer adenocarcinoma
),
total_sz AS (SELECT COUNT(*) AS total_n FROM cohort),

mit AS (                                -- % of cohort with a GAIN, by chromosome
  SELECT
    REGEXP_REPLACE(cc.Chr, r'^chr', '') AS chromosome,   -- e.g. 'chr1' → '1'
    100.0 * COUNT(DISTINCT CONCAT(cc.RefNo,'|',cc.CaseNo))
          / (SELECT total_n FROM total_sz)              AS freq_pct
  FROM   `mitelman-db.prod.CytoConverted` AS cc
  JOIN   cohort                           AS co
    ON   cc.RefNo  = co.RefNo
   AND   cc.CaseNo = co.CaseNo
  WHERE  cc.Type = 'Gain'
  GROUP  BY chromosome
),

rec AS (                                -- gain case-counts from RecurrentNumData
  SELECT
    Chromosome AS chromosome,
    SUM(CAST(TotalCases AS INT64)) AS tot_cases
  FROM   `mitelman-db.prod.RecurrentNumData`
  WHERE  Morph = '3111'                 -- same morphology; Topo not required
    AND  Abnormality LIKE '+%'          -- keep only gains
  GROUP  BY Chromosome
),

stats AS (                              -- Pearson r and number of chromosomes
  SELECT
    COUNT(*)                          AS n_points,
    CORR(mit.freq_pct, rec.tot_cases) AS pearson_r
  FROM   mit
  JOIN   rec USING (chromosome)
)

SELECT
  n_points,
  pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(pearson_r, n_points) AS p_value
FROM stats
WHERE n_points >= 5;
