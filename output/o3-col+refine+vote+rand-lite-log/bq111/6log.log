--Description / thinking process:
-- Compute, for each aberration category (Gain, Loss, Amp, Del), the Pearson
-- correlation between:
--   a)  The percentage of breast-cancer adenocarcinoma cases
--       (Morph = 3111, Topo = 0401) that show that aberration in the
--       CytoConverted table, and
--   b)  The corresponding total case-counts recorded in RecurrentNumData
--       for Morph = 3111 (Topo not filtered to maximise overlap).
--
-- Steps
-- 1.  Build “cohort” of distinct (RefNo, CaseNo) and obtain its size.
-- 2.  From CytoConverted, count DISTINCT cases with each aberration type
--     per chromosome, convert to % of cohort (strip ‘chr’ prefix so labels
--     match RecurrentNumData).
-- 3.  From RecurrentNumData, map abnormality strings to the four classes
--     and sum TotalCases per chromosome & class.
-- 4.  Join the two sources; for each class compute Pearson r and the number
--     of chromosomes (n_chromosomes).
-- 5.  Feed r and n into the ISB-CGC UDF
--        isb-cgc-bq.functions.corr_pvalue_current(r, n)
--     to obtain a two-tailed p-value.  Report only classes with ≥5 chromosomes.

WITH aberr_classes AS (                    -- four classes to analyse
  SELECT 'Gain' AS class UNION ALL
  SELECT 'Loss' UNION ALL
  SELECT 'Amp'  UNION ALL
  SELECT 'Del'
),

cohort AS (                                -- distinct breast-cancer cases
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  TRIM(Morph) = '3111'
    AND  TRIM(Topo)  = '0401'
),
tot AS (SELECT COUNT(*) AS n_cases FROM cohort),

-- 2) CytoConverted: percentage of cohort with each event per chromosome
mit_counts AS (
  SELECT
    REGEXP_REPLACE(cc.Chr, r'^chr', '') AS chromosome,    -- ‘chr1’ → ‘1’
    cc.Type                             AS Type,
    COUNT(DISTINCT CONCAT(cc.RefNo,'|',cc.CaseNo)) AS case_cnt
  FROM   `mitelman-db.prod.CytoConverted` cc
  JOIN   cohort                          co
    ON   cc.RefNo  = co.RefNo
   AND   cc.CaseNo = co.CaseNo
  GROUP  BY chromosome, Type
),
mit_pct AS (
  SELECT
    chromosome,
    Type,
    100.0 * case_cnt / tot.n_cases AS freq_pct
  FROM mit_counts, tot
),

-- 3) RecurrentNumData: aggregate into the same four classes
rec_mapped AS (
  SELECT
    Chromosome AS chromosome,
    CASE
      WHEN Abnormality LIKE '+%'   THEN 'Gain'
      WHEN Abnormality LIKE '-%'   THEN 'Loss'
      WHEN Abnormality LIKE 'i%'   THEN 'Amp'
      WHEN Abnormality LIKE 'del%' THEN 'Del'
    END                           AS Type,
    CAST(TotalCases AS INT64)      AS cases
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE Morph = '3111'
),
rec_tot AS (
  SELECT
    chromosome,
    Type,
    SUM(cases) AS tot_cases
  FROM rec_mapped
  WHERE Type IS NOT NULL
  GROUP BY chromosome, Type
),

-- 4) Join & compute Pearson r for each class
stats AS (
  SELECT
    ac.class                              AS AberrationType,
    COUNT(*)                              AS n_chromosomes,
    CORR(mit_pct.freq_pct,
         rec_tot.tot_cases)               AS pearson_r
  FROM aberr_classes ac
  JOIN mit_pct  ON mit_pct.Type = ac.class
  JOIN rec_tot  ON rec_tot.Type = ac.class
               AND rec_tot.chromosome = mit_pct.chromosome
  GROUP BY ac.class
)

-- 5) Final output with p-values
SELECT
  AberrationType,
  n_chromosomes,
  pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(pearson_r, n_chromosomes) AS p_value
FROM stats
WHERE n_chromosomes >= 5          -- keep only classes with ≥5 data points
ORDER BY AberrationType;
