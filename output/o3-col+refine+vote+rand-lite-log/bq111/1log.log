```sql
/*----------------------------------------------------------------------------
  Pearson correlation between Mitelman (breast-cancer) & TCGA-BRCA
  copy-number-aberration (CNA) frequencies, per chromosome & aberration class.

  Mitelman cohort : Morph = 3111  AND  Topo = 0401
  TCGA cohort     : study = 'TCGA-BRCA'
  Aberration classes analysed : Amplification, Gain, Deletion, Loss
  Only chromosome / aberration pairs with ≥ 5 shared cytobands are reported.
----------------------------------------------------------------------------*/
WITH
/*────────────────────────────────────────────────────────────────────────────
  1)  Mitelman breast-cancer cases
────────────────────────────────────────────────────────────────────────────*/
mit_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111'
    AND Topo  = '0401'
),
/*────────────────────────────────────────────────────────────────────────────
  2)  Mitelman CNA events mapped to hg38 cytobands
────────────────────────────────────────────────────────────────────────────*/
mit_raw AS (
  SELECT
    CONCAT(cc.RefNo,'_',cc.CaseNo,'_',cc.InvNo,'_',cc.Clone) AS sample_id,
    cb.chromosome,
    cb.cytoband_name,
    cc.Type                                                  AS mit_type
  FROM `mitelman-db.prod.CytoConverted`  cc
  JOIN mit_cases                         USING (RefNo, CaseNo)
  JOIN `mitelman-db.prod.CytoBands_hg38` cb
    ON  cc.Chr  = cb.chromosome
   AND cc.`Start` < cb.hg38_stop
   AND cc.`End`   > cb.hg38_start
),
/*  Expand Mitelman rows so “Gain” produces Gain & Amplification
    and “Loss” produces Loss & Deletion.                                    */
mit_expanded AS (
  SELECT sample_id, chromosome, cytoband_name, 'Gain'          AS aberr_class
  FROM mit_raw WHERE mit_type = 'Gain'
  UNION ALL
  SELECT sample_id, chromosome, cytoband_name, 'Amplification' AS aberr_class
  FROM mit_raw WHERE mit_type = 'Gain'
  UNION ALL
  SELECT sample_id, chromosome, cytoband_name, 'Loss'          AS aberr_class
  FROM mit_raw WHERE mit_type = 'Loss'
  UNION ALL
  SELECT sample_id, chromosome, cytoband_name, 'Deletion'      AS aberr_class
  FROM mit_raw WHERE mit_type = 'Loss'
),
mit_tot AS ( SELECT COUNT(DISTINCT sample_id) AS n_tot FROM mit_raw ),
mit_freq AS (                   /* Mitelman cytoband-level frequency (0-1) */
  SELECT
    chromosome,
    cytoband_name,
    aberr_class,
    COUNT(DISTINCT sample_id) / mit_tot.n_tot AS mit_freq
  FROM mit_expanded, mit_tot
  GROUP BY chromosome, cytoband_name, aberr_class, mit_tot.n_tot
),
/*────────────────────────────────────────────────────────────────────────────
  3)  TCGA-BRCA copy-number segments mapped to cytobands
────────────────────────────────────────────────────────────────────────────*/
brca_seg AS (
  SELECT
    aliquot_barcode                                AS sample_id,
    CONCAT('chr', chromosome)                      AS chromosome,
    `start`                                        AS seg_start,   -- quoted
    `end`                                          AS seg_end,     -- quoted
    segment_mean
  FROM `isb-cgc.TCGA_hg38_data_v0.Copy_Number_Segment_Masked`
  WHERE study = 'TCGA-BRCA'
),
cyto AS (
  SELECT chromosome, cytoband_name, hg38_start, hg38_stop
  FROM `mitelman-db.prod.CytoBands_hg38`
),
sample_band AS (                 /* per sample / cytoband statistics */
  SELECT
    b.sample_id,
    c.chromosome,
    c.cytoband_name,
    MAX(segment_mean) AS max_mean,
    MIN(segment_mean) AS min_mean
  FROM brca_seg b
  JOIN cyto c
    ON b.chromosome = c.chromosome
   AND b.seg_start  < c.hg38_stop
   AND b.seg_end    > c.hg38_start
  GROUP BY b.sample_id, c.chromosome, c.cytoband_name
),
tcga_class AS (                  /* classify CNA status */
  SELECT
    sample_id,
    chromosome,
    cytoband_name,
    CASE
      WHEN max_mean >  0.8 THEN 'Amplification'
      WHEN max_mean >  0.3 THEN 'Gain'
      WHEN min_mean < -0.8 THEN 'Deletion'
      WHEN min_mean < -0.3 THEN 'Loss'
      ELSE 'Normal'
    END AS aberr_class
  FROM sample_band
),
tcga_tot AS ( SELECT COUNT(DISTINCT sample_id) AS n_tot FROM brca_seg ),
tcga_freq AS (                 /* TCGA cytoband-level frequency (0-1) */
  SELECT
    chromosome,
    cytoband_name,
    aberr_class,
    COUNT(DISTINCT sample_id) / tcga_tot.n_tot AS tcga_freq
  FROM tcga_class, tcga_tot
  WHERE aberr_class <> 'Normal'
  GROUP BY chromosome, cytoband_name, aberr_class, tcga_tot.n_tot
),
/*────────────────────────────────────────────────────────────────────────────
  4)  Merge Mitelman & TCGA frequencies
────────────────────────────────────────────────────────────────────────────*/
merged AS (
  SELECT
    m.chromosome,
    m.cytoband_name,
    m.aberr_class,
    m.mit_freq,
    t.tcga_freq
  FROM mit_freq m
  JOIN tcga_freq t
    ON  t.chromosome     = m.chromosome
   AND  t.cytoband_name  = m.cytoband_name
   AND  t.aberr_class    = m.aberr_class
),
/*────────────────────────────────────────────────────────────────────────────
  5)  Pearson correlation per chromosome × aberration class
────────────────────────────────────────────────────────────────────────────*/
per_chr AS (
  SELECT
    chromosome,
    aberr_class,
    CORR(mit_freq, tcga_freq) AS r_value,
    COUNT(*)                  AS n_pts
  FROM merged
  GROUP BY chromosome, aberr_class
  HAVING n_pts >= 5                  -- need ≥ 5 cytobands
)
SELECT
  chromosome                                                 AS Chr,
  aberr_class                                                AS Aberration,
  r_value                                                    AS Pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(r_value,n_pts)  AS p_value,
  n_pts                                                      AS N_cytobands
FROM per_chr
ORDER BY Chr, Aberration;
```
