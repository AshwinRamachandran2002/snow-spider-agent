[{'Refno': 1, 'Name': 'LUND UNPUBLISHED', 'NameOrder': 1}, {'Refno': 1, 'Name': 'LUND UNPUBLISHED', 'NameOrder': 1}, {'Refno': 10, 'Name': 'Hayata I', 'NameOrder': 1}, {'Refno': 11, 'Name': 'Hayata I', 'NameOrder': 1}, {'Refno': 12, 'Name': 'Muldal S', 'NameOrder': 1}]

