Query:
--Description: 6) Compute per-chromosome frequencies (proportion of cohort
--   cases) that have a GAIN event; shows top 20 chromosomes (if present).
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
gain_events AS (
  SELECT DISTINCT
    CONCAT(RefNo,'_',CaseNo,'_',InvNo,'_',Clone) AS sample_id,
    Chr
  FROM `mitelman-db.prod.CytoConverted`
  WHERE Type = 'Gain'
)
SELECT
  ge.Chr,
  COUNT(DISTINCT ge.sample_id) AS gain_cases,
  COUNT(DISTINCT c.RefNo || '_' || c.CaseNo) AS total_cases,
  SAFE_DIVIDE(COUNT(DISTINCT ge.sample_id),
              COUNT(DISTINCT c.RefNo || '_' || c.CaseNo)) AS gain_freq
FROM
  cohort c
LEFT JOIN
  gain_events ge
ON
  ge.sample_id LIKE CONCAT(c.RefNo,'_',c.CaseNo,'%')
GROUP BY ge.Chr
ORDER BY ge.Chr
LIMIT 20;
