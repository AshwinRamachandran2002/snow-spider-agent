Query:
--Description: 5) Count, for our breast-cancer cohort, how many unique
--   investigations (RefNo-CaseNo-InvNo-Clone) show each CNA type on each
--   chromosome.  This gives the raw Mitelman frequencies (20 rows sample).
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
)
SELECT
  cc.Chr,
  cc.Type,
  COUNT(DISTINCT CONCAT(cc.RefNo,'_',cc.CaseNo,'_',cc.InvNo,'_',cc.Clone)) AS n_cases
FROM
  `mitelman-db.prod.CytoConverted` cc
JOIN
  cohort USING (RefNo, CaseNo)
GROUP BY
  cc.Chr, cc.Type
ORDER BY
  cc.Chr, cc.Type
LIMIT 20;
