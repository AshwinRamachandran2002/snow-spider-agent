--Description: 9) Show a sample of KaryClone rows for our breast-cancer
--   cohort; useful to confirm whole-karyotype descriptions of CNA calls.
SELECT
  kc.RefNo,
  kc.CaseNo,
  kc.CloneNo,
  kc.ChromoMin,
  kc.ChromoMax,
  kc.CloneShort,
  kc.Sole
FROM
  `mitelman-db.prod.KaryClone` kc
JOIN
  (SELECT DISTINCT RefNo, CaseNo
   FROM `mitelman-db.prod.Cytogen`
   WHERE Morph = '3111' AND Topo = '0401'
