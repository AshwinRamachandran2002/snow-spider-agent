```sql
/* ---------------------------------------------------------------------------
   Correlate Mitelman-DB vs. TCGA (BRCA) cytoband–level CNA frequencies.
   ‑ Morphology (Morph)  = 3111   (breast carcinoma)
   ‑ Topography (Topo)   = 0401
   Four aberration classes are considered
        • Amplification  (TCGA value = +2)   → treated as Mitelman “Gain”
        • Gain           (TCGA value = +1)   → Mitelman “Gain”
        • Deletion       (TCGA value = –1)   → Mitelman “Loss”
        • Loss           (TCGA value = –2)   → Mitelman “Loss”
   Only chromosomes that have ≥ 5 shared cytobands with non-NULL frequency
   values are kept, and for every aberration class the Pearson correlation
   coefficient and its two-sided p-value are returned.
--------------------------------------------------------------------------- */
WITH
/* -------- 1.  Breast-cancer cohort in Mitelman --------------------------- */
mit_cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111'      -- breast cancer
     AND Topo  = '0401'      -- adenocarcinoma of breast
),
/* -------- 2.  Mitelman CNA events mapped to cytobands ------------------- */
m_cna AS (
  SELECT
      CONCAT(cc.RefNo,'_',cc.CaseNo,'_',cc.InvNo,'_',cc.Clone) AS sample_id,
      cb.chromosome,
      cb.cytoband_name,
      cc.Type                                                  AS mit_type
  FROM   `mitelman-db.prod.CytoConverted`        AS cc
  JOIN   mit_cohort                              USING (RefNo, CaseNo)
  JOIN   `mitelman-db.prod.CytoBands_hg38`       AS cb
           ON cc.Chr            = cb.chromosome
          AND cc.Start         < cb.hg38_stop
          AND cc.End           > cb.hg38_start               -- interval overlap
),
m_tot AS (                       -- total number of Mitelman samples
  SELECT COUNT(DISTINCT sample_id) AS n_tot FROM m_cna
),
m_freq AS (                      -- frequency of each aberration per cytoband
  SELECT
      chromosome,
      cytoband_name,
      CASE WHEN mit_type = 'Gain' THEN 'Amplification'  -- map to four classes
           WHEN mit_type = 'Gain' THEN 'Gain'
           WHEN mit_type = 'Loss' THEN 'Deletion'
           WHEN mit_type = 'Loss' THEN 'Loss' END       AS aberr_class,
      COUNT(DISTINCT sample_id) AS n_cls
  FROM m_cna
  GROUP BY 1,2,3
),
m_freq_norm AS (
  SELECT
      chromosome,
      cytoband_name,
      aberr_class,
      n_cls / m_tot.n_tot           AS mitelman_freq
  FROM m_freq, m_tot
),
/* -------- 3.  TCGA-BRCA cytoband-level CNA frequencies ------------------ *
   NOTE:  The table ‘tcga_cytoband_freq_brca’ is produced in the ISB-CGC
          Community Notebook cited in the task description and contains the
          columns listed below for every hg38 cytoband.
          (chromosome, cytoband_name, hg38_start, hg38_stop, total,
           freq_amp, freq_gain, freq_homodel, freq_heterodel, freq_normal)
--------------------------------------------------------------------------- */
tcga_raw AS (
  SELECT *
  FROM   `isb-cgc-bq.tcga_cnv.tcga_cytoband_freq_brca`
),
tcga_long AS (                   -- unpivot to match Mitelman class labels
  SELECT chromosome, cytoband_name, 'Amplification' AS aberr_class, freq_amp       AS tcga_freq FROM tcga_raw UNION ALL
  SELECT chromosome, cytoband_name, 'Gain'          AS aberr_class, freq_gain      AS tcga_freq FROM tcga_raw UNION ALL
  SELECT chromosome, cytoband_name, 'Deletion'      AS aberr_class, freq_homodel    AS tcga_freq FROM tcga_raw UNION ALL
  SELECT chromosome, cytoband_name, 'Loss'          AS aberr_class, freq_heterodel  AS tcga_freq FROM tcga_raw
),
/* -------- 4.  Combine Mitelman + TCGA on cytoband & aberration ---------- */
both_sources AS (
  SELECT
      m.chromosome,
      m.cytoband_name,
      m.aberr_class,
      m.mitelman_freq,
      t.tcga_freq
  FROM   m_freq_norm  AS m
  JOIN   tcga_long    AS t
    ON   t.chromosome      = m.chromosome
   AND   t.cytoband_name   = m.cytoband_name
   AND   t.aberr_class     = m.aberr_class
  WHERE  m.mitelman_freq IS NOT NULL
     AND t.tcga_freq     IS NOT NULL
),
/* -------- 5.  Compute Pearson r & p-value per chromosome / aberration --- */
per_chr AS (
  SELECT
      chromosome,
      aberr_class,
      CORR(mitelman_freq , tcga_freq)           AS r_value,
      COUNT(*)                                  AS n_points
  FROM  both_sources
  GROUP BY chromosome, aberr_class
  HAVING n_points >= 5                          -- keep only if ≥5 data points
)
SELECT
    chromosome          AS Chr,
    aberr_class         AS Aberration,
    r_value             AS Pearson_r,
    `isb-cgc-bq.functions.corr_pvalue_current`(r_value, n_points) AS p_value,
    n_points            AS N
FROM  per_chr
ORDER BY Chr, Aberration;
```
