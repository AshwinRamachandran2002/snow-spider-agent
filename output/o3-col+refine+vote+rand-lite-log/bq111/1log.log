```sql
--Description: 1) Inspect Cytogen cases having the morphology (Morph) = '3111'
--   and topography (Topo) = '0401'; this produces up to 20 representative
--   rows so we can see which RefNo / CaseNo pairs will be used later.
SELECT
  `RefNo`,
  `CaseNo`,
  `Morph`,
  `Topo`,
  `Sex`,
  `Age`,
  `Country`
FROM
  `mitelman-db.prod.Cytogen`
WHERE
  `Morph` = '3111'
  AND `Topo` = '0401'
LIMIT 20;
```

```sql
--Description: 2) List the distinct reference / case combinations that match
--   morph-3111 & topo-0401 so we can join these IDs with CytoConverted later.
SELECT DISTINCT
  `RefNo`,
  `CaseNo`
FROM
  `mitelman-db.prod.Cytogen`
WHERE
  `Morph` = '3111'
  AND `Topo` = '0401'
LIMIT 20;
```

```sql
--Description: 3) Display CytoConverted copy-number rows (Gain/Loss/etc.)
--   for the first 20 matching breast-cancer (3111/0401) cases identified.
SELECT
  cc.`RefNo`,
  cc.`CaseNo`,
  cc.`Chr`,
  cc.`Type`,
  cc.`Start`,
  cc.`End`
FROM
  `mitelman-db.prod.CytoConverted`  AS cc
JOIN
  (SELECT DISTINCT `RefNo`, `CaseNo`
   FROM `mitelman-db.prod.Cytogen`
   WHERE `Morph` = '3111' AND `Topo` = '0401'
   LIMIT 1000) AS bx
USING (`RefNo`, `CaseNo`)
LIMIT 20;
```

```sql
--Description: 4) What distinct CNA (copy-number aberration) categories are
--   recorded in CytoConverted?  (e.g. Gain, Loss, Amplification, Deletion).
SELECT DISTINCT
  `Type`
FROM
  `mitelman-db.prod.CytoConverted`
ORDER BY `Type`
LIMIT 20;
```

```sql
--Description: 5) Count, for our breast-cancer cohort, how many unique
--   investigations (RefNo-CaseNo-InvNo-Clone) show each CNA type on each
--   chromosome.  This gives the raw Mitelman frequencies (20 rows sample).
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
)
SELECT
  cc.Chr,
  cc.Type,
  COUNT(DISTINCT CONCAT(cc.RefNo,'_',cc.CaseNo,'_',cc.InvNo,'_',cc.Clone)) AS n_cases
FROM
  `mitelman-db.prod.CytoConverted` cc
JOIN
  cohort USING (RefNo, CaseNo)
GROUP BY
  cc.Chr, cc.Type
ORDER BY
  cc.Chr, cc.Type
LIMIT 20;
```

```sql
--Description: 6) Compute per-chromosome frequencies (proportion of cohort
--   cases) that have a GAIN event; shows top 20 chromosomes (if present).
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
gain_events AS (
  SELECT DISTINCT
    CONCAT(RefNo,'_',CaseNo,'_',InvNo,'_',Clone) AS sample_id,
    Chr
  FROM `mitelman-db.prod.CytoConverted`
  WHERE Type = 'Gain'
)
SELECT
  ge.Chr,
  COUNT(DISTINCT ge.sample_id) AS gain_cases,
  COUNT(DISTINCT c.RefNo || '_' || c.CaseNo) AS total_cases,
  SAFE_DIVIDE(COUNT(DISTINCT ge.sample_id),
              COUNT(DISTINCT c.RefNo || '_' || c.CaseNo)) AS gain_freq
FROM
  cohort c
LEFT JOIN
  gain_events ge
ON
  ge.sample_id LIKE CONCAT(c.RefNo,'_',c.CaseNo,'%')
GROUP BY ge.Chr
ORDER BY ge.Chr
LIMIT 20;
```

```sql
--Description: 7) Analogous to query-6, now calculate LOSS (or Deletion)
--   frequency per chromosome for the same cohort (20-row sample view).
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
loss_events AS (
  SELECT DISTINCT
    CONCAT(RefNo,'_',CaseNo,'_',InvNo,'_',Clone) AS sample_id,
    Chr
  FROM `mitelman-db.prod.CytoConverted`
  WHERE Type IN ('Loss','Deletion')
)
SELECT
  le.Chr,
  COUNT(DISTINCT le.sample_id)  AS loss_cases,
  COUNT(DISTINCT c.RefNo || '_' || c.CaseNo) AS total_cases,
  SAFE_DIVIDE(COUNT(DISTINCT le.sample_id),
              COUNT(DISTINCT c.RefNo || '_' || c.CaseNo)) AS loss_freq
FROM
  cohort c
LEFT JOIN
  loss_events le
ON
  le.sample_id LIKE CONCAT(c.RefNo,'_',c.CaseNo,'%')
GROUP BY le.Chr
ORDER BY le.Chr
LIMIT 20;
```

```sql
--Description: 8) Pull the cytoband coordinates (hg38) so that Mitelman
--   CNA intervals can later be mapped to cytobands if desired.
SELECT
  `chromosome`,
  `cytoband_name`,
  `hg38_start`,
  `hg38_stop`
FROM
  `mitelman-db.prod.CytoBands_hg38`
WHERE
  chromosome IN ('chr1','chr2','chr3','chr4','chr5')
LIMIT 20;
```

```sql
--Description: 9) Show a sample of KaryClone rows for our breast-cancer
--   cohort; useful to confirm whole-karyotype descriptions of CNA calls.
SELECT
  kc.RefNo,
  kc.CaseNo,
  kc.CloneNo,
  kc.ChromoMin,
  kc.ChromoMax,
  kc.CloneShort,
  kc.Sole
FROM
  `mitelman-db.prod.KaryClone` kc
JOIN
  (SELECT DISTINCT RefNo, CaseNo
   FROM `mitelman-db.prod.Cytogen`
   WHERE Morph = '3111' AND Topo = '0401'
   LIMIT 1000) bx
USING (RefNo, CaseNo)
LIMIT 20;
```

```sql
--Description: 10) Retrieve a sample of RecurrentNumData rows for chromosome-specific
--   numeric aberration summaries (not cohort-filtered) for later comparison.
SELECT
  `Chromosome`,
  `Abnormality`,
  `Morph`,
  `Topo`,
  `TotalCases`
FROM
  `mitelman-db.prod.RecurrentNumData`
WHERE
  Chromosome IN ('1','2','17')
LIMIT 20;
```

These ten progressively more complex queries let you explore (1) which Mitelman cases match the desired breast-cancer criteria, (2) what copy-number aberrations those cases carry, and (3) how often each chromosome is gained or lost within that cohort.  They provide all of the components needed to later compute per-chromosome Pearson correlations against an external TCGA copy-number dataset.
