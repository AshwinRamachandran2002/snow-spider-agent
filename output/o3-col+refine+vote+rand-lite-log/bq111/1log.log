Query:
--Description: 7) Analogous to query-6, now calculate LOSS (or Deletion)
--   frequency per chromosome for the same cohort (20-row sample view).
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
loss_events AS (
  SELECT DISTINCT
    CONCAT(RefNo,'_',CaseNo,'_',InvNo,'_',Clone) AS sample_id,
    Chr
  FROM `mitelman-db.prod.CytoConverted`
  WHERE Type IN ('Loss','Deletion')
)
SELECT
  le.Chr,
  COUNT(DISTINCT le.sample_id)  AS loss_cases,
  COUNT(DISTINCT c.RefNo || '_' || c.CaseNo) AS total_cases,
  SAFE_DIVIDE(COUNT(DISTINCT le.sample_id),
              COUNT(DISTINCT c.RefNo || '_' || c.CaseNo)) AS loss_freq
FROM
  cohort c
LEFT JOIN
  loss_events le
ON
  le.sample_id LIKE CONCAT(c.RefNo,'_',c.CaseNo,'%')
GROUP BY le.Chr
ORDER BY le.Chr
LIMIT 20;
