```sql
-- Description: 3) Bring the dimension and fact tables together for fiscal-year 2020 and display one sample row per product/segment pair.
SELECT DISTINCT f."product_code",
                d."segment"
FROM   "hardware_fact_sales_monthly" AS f
JOIN   "hardware_dim_product"       AS d
           ON f."product_code" = d."product_code"
WHERE  f."fiscal_year" = 2020
LIMIT 20;
```

```sql
-- Description: 4) Count the number of unique products sold in 2020 for every segment (first half of what we ultimately need).
SELECT   d."segment",
         COUNT(DISTINCT f."product_code") AS "unique_products_2020"
FROM     "hardware_fact_sales_monthly" AS f
JOIN     "hardware_dim_product"        AS d
           ON f."product_code" = d."product_code"
WHERE    f."fiscal_year" = 2020
GROUP BY d."segment"
LIMIT 20;
```

```sql
-- Description: 5) Do the same unique-product count for fiscal-year 2021.
SELECT   d."segment",
         COUNT(DISTINCT f."product_code") AS "unique_products_2021"
FROM     "hardware_fact_sales_monthly" AS f
JOIN     "hardware_dim_product"        AS d
           ON f."product_code" = d."product_code"
WHERE    f."fiscal_year" = 2021
GROUP BY d."segment"
LIMIT 20;
```

```sql
-- Description: 6) Put the 2020 and 2021 counts side-by-side in one result set.
WITH yr20 AS (
        SELECT d."segment",
               COUNT(DISTINCT f."product_code") AS "unique_products_2020"
        FROM   "hardware_fact_sales_monthly" AS f
        JOIN   "hardware_dim_product"        AS d
               ON f."product_code" = d."product_code"
        WHERE  f."fiscal_year" = 2020
        GROUP BY d."segment"
     ),
     yr21 AS (
        SELECT d."segment",
               COUNT(DISTINCT f."product_code") AS "unique_products_2021"
        FROM   "hardware_fact_sales_monthly" AS f
        JOIN   "hardware_dim_product"        AS d
               ON f."product_code" = d."product_code"
        WHERE  f."fiscal_year" = 2021
        GROUP BY d."segment"
     )
SELECT  y20."segment",
        y20."unique_products_2020",
        y21."unique_products_2021"
FROM    yr20 AS y20
LEFT JOIN yr21 AS y21
       ON y20."segment" = y21."segment"
LIMIT 20;
```

```sql
-- Description: 7) Add a calculated percentage-increase column.
WITH yr20 AS (
        SELECT d."segment",
               COUNT(DISTINCT f."product_code") AS "unique_products_2020"
        FROM   "hardware_fact_sales_monthly" AS f
        JOIN   "hardware_dim_product"        AS d
               ON f."product_code" = d."product_code"
        WHERE  f."fiscal_year" = 2020
        GROUP BY d."segment"
     ),
     yr21 AS (
        SELECT d."segment",
               COUNT(DISTINCT f."product_code") AS "unique_products_2021"
        FROM   "hardware_fact_sales_monthly" AS f
        JOIN   "hardware_dim_product"        AS d
               ON f."product_code" = d."product_code"
        WHERE  f."fiscal_year" = 2021
        GROUP BY d."segment"
     )
SELECT  y20."segment",
        y20."unique_products_2020",
        y21."unique_products_2021",
        ROUND(
              100.0 * (IFNULL(y21."unique_products_2021",0) - y20."unique_products_2020")
              / NULLIF(y20."unique_products_2020",0)
        ,2) AS "pct_increase"
FROM    yr20 AS y20
LEFT JOIN yr21 AS y21
       ON y20."segment" = y21."segment"
LIMIT 20;
```

```sql
-- Description: 8) Produce the final requested answer: list of segments with their 2020 unique-product counts, ordered by the highest percentage increase from 2020 to 2021.
WITH yr20 AS (
        SELECT d."segment",
               COUNT(DISTINCT f."product_code") AS "unique_products_2020"
        FROM   "hardware_fact_sales_monthly" AS f
        JOIN   "hardware_dim_product"        AS d
               ON f."product_code" = d."product_code"
        WHERE  f."fiscal_year" = 2020
        GROUP BY d."segment"
     ),
     yr21 AS (
        SELECT d."segment",
               COUNT(DISTINCT f."product_code") AS "unique_products_2021"
        FROM   "hardware_fact_sales_monthly" AS f
        JOIN   "hardware_dim_product"        AS d
               ON f."product_code" = d."product_code"
        WHERE  f."fiscal_year" = 2021
        GROUP BY d."segment"
     )
SELECT  y20."segment",
        y20."unique_products_2020",
        ROUND(
              100.0 * (IFNULL(y21."unique_products_2021",0) - y20."unique_products_2020")
              / NULLIF(y20."unique_products_2020",0)
        ,2) AS "pct_increase_2020_to_2021"
FROM    yr20 AS y20
LEFT JOIN yr21 AS y21
       ON y20."segment" = y21."segment"
ORDER BY "pct_increase_2020_to_2021" DESC
LIMIT 20;
```

```sql
-- Description: 9) (Optional validation) Show segments that had no products in 2021 to verify percentage calculation logic.
SELECT  d."segment"
FROM    "hardware_dim_product"        AS d
LEFT JOIN "hardware_fact_sales_monthly" AS f
       ON d."product_code" = f."product_code"
       AND f."fiscal_year" = 2021
WHERE   f."product_code" IS NULL
GROUP BY d."segment"
LIMIT 20;
```

```sql
-- Description: 10) (Optional deeper dive) Display the individual product codes for the segment with the biggest percentage jump, for both years.
WITH top_seg AS (
       WITH yr20 AS (
           SELECT d."segment",
                  COUNT(DISTINCT f."product_code") AS "cnt20"
           FROM   "hardware_fact_sales_monthly" AS f
           JOIN   "hardware_dim_product"        AS d
                  ON f."product_code" = d."product_code"
           WHERE  f."fiscal_year" = 2020
           GROUP BY d."segment"
       ),
       yr21 AS (
           SELECT d."segment",
                  COUNT(DISTINCT f."product_code") AS "cnt21"
           FROM   "hardware_fact_sales_monthly" AS f
           JOIN   "hardware_dim_product"        AS d
                  ON f."product_code" = d."product_code"
           WHERE  f."fiscal_year" = 2021
           GROUP BY d."segment"
       )
       SELECT y20."segment"
       FROM   yr20 AS y20
       JOIN   yr21 AS y21
              ON y20."segment" = y21."segment"
       ORDER BY (y21."cnt21" - y20."cnt20") * 1.0 / NULLIF(y20."cnt20",0) DESC
       LIMIT 1
)
SELECT DISTINCT f."product_code",
       d."segment",
       f."fiscal_year"
FROM   "hardware_fact_sales_monthly" AS f
JOIN   "hardware_dim_product"        AS d
       ON f."product_code" = d."product_code"
JOIN   top_seg                       AS ts
       ON d."segment" = ts."segment"
WHERE  f."fiscal_year" IN (2020,2021)
ORDER BY f."fiscal_year",
         f."product_code"
LIMIT 20;
```
