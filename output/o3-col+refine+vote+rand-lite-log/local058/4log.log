Query:
--Description: Re-write SQL #8 without FULL OUTER JOIN.  
--             Calculates unique-product counts for 2020 & 2021, then shows the
--             percentage increase for every segment that appears in either year.
WITH yearly_counts AS (                           -- long format
    SELECT dp.segment            AS segment,
           fm.fiscal_year        AS yr,
           COUNT(DISTINCT fm.product_code) AS cnt
    FROM hardware_fact_sales_monthly fm
    JOIN hardware_dim_product   dp
      ON dp.product_code = fm.product_code
    WHERE fm.fiscal_year IN (2020, 2021)
    GROUP BY dp.segment, fm.fiscal_year
),
pivot AS (                                        -- wide format
    SELECT segment,
           MAX(CASE WHEN yr = 2020 THEN cnt END) AS cnt20,
           MAX(CASE WHEN yr = 2021 THEN cnt END) AS cnt21
    FROM yearly_counts
    GROUP BY segment
)
SELECT segment                           AS segment,
       cnt20                             AS unique_products_2020,
       cnt21                             AS unique_products_2021,
       ROUND(
           100.0 * (cnt21 - cnt20) / NULLIF(cnt20, 0),
           2
       )                                 AS pct_increase
FROM pivot
ORDER BY pct_increase DESC
LIMIT 20
Answer:
segment,unique_products_2020,unique_products_2021,pct_increase
