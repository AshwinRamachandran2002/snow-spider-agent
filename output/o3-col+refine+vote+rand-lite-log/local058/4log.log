```sql
-- 6) Description: Count the number of unique products sold in 2021 for every segment
SELECT dp.segment,
       COUNT(DISTINCT fm.product_code) AS unique_products_2021
FROM hardware_fact_sales_monthly AS fm
JOIN hardware_dim_product        AS dp
     ON dp.product_code = fm.product_code
WHERE fm.fiscal_year = 2021
GROUP BY dp.segment
ORDER BY unique_products_2021 DESC
LIMIT 20;
```

```sql
-- 7) Description: Combine the 2020 and 2021 unique-product counts side-by-side for each segment
WITH yr20 AS (
    SELECT dp.segment,
           COUNT(DISTINCT fm.product_code) AS cnt20
    FROM hardware_fact_sales_monthly fm
    JOIN hardware_dim_product dp
      ON dp.product_code = fm.product_code
    WHERE fm.fiscal_year = 2020
    GROUP BY dp.segment
),
yr21 AS (
    SELECT dp.segment,
           COUNT(DISTINCT fm.product_code) AS cnt21
    FROM hardware_fact_sales_monthly fm
    JOIN hardware_dim_product dp
      ON dp.product_code = fm.product_code
    WHERE fm.fiscal_year = 2021
    GROUP BY dp.segment
)
SELECT COALESCE(yr20.segment, yr21.segment) AS segment,
       yr20.cnt20,
       yr21.cnt21
FROM yr20
FULL OUTER JOIN yr21
     ON yr20.segment = yr21.segment
LIMIT 20;
```

```sql
-- 8) Description: Calculate the percentage increase in unique products from 2020 to 2021 for each segment
WITH yr20 AS (
    SELECT dp.segment,
           COUNT(DISTINCT fm.product_code) AS cnt20
    FROM hardware_fact_sales_monthly fm
    JOIN hardware_dim_product dp
      ON dp.product_code = fm.product_code
    WHERE fm.fiscal_year = 2020
    GROUP BY dp.segment
),
yr21 AS (
    SELECT dp.segment,
           COUNT(DISTINCT fm.product_code) AS cnt21
    FROM hardware_fact_sales_monthly fm
    JOIN hardware_dim_product dp
      ON dp.product_code = fm.product_code
    WHERE fm.fiscal_year = 2021
    GROUP BY dp.segment
)
SELECT COALESCE(yr21.segment, yr20.segment)                       AS segment,
       yr20.cnt20                                                AS unique_products_2020,
       yr21.cnt21                                                AS unique_products_2021,
       ROUND(
           100.0 * (yr21.cnt21 - yr20.cnt20) / NULLIF(yr20.cnt20,0),
           2
       )                                                         AS pct_increase
FROM yr20
FULL OUTER JOIN yr21
     ON yr20.segment = yr21.segment
ORDER BY pct_increase DESC
LIMIT 20;
```

```sql
-- 9) Description: Final query – list only the 2020 unique-product counts by segment,
--                 ordered by the highest % increase from 2020 to 2021
WITH yr20 AS (
    SELECT dp.segment,
           COUNT(DISTINCT fm.product_code) AS cnt20
    FROM hardware_fact_sales_monthly fm
    JOIN hardware_dim_product dp
      ON dp.product_code = fm.product_code
    WHERE fm.fiscal_year = 2020
    GROUP BY dp.segment
),
yr21 AS (
    SELECT dp.segment,
           COUNT(DISTINCT fm.product_code) AS cnt21
    FROM hardware_fact_sales_monthly fm
    JOIN hardware_dim_product dp
      ON dp.product_code = fm.product_code
    WHERE fm.fiscal_year = 2021
    GROUP BY dp.segment
),
pct AS (
    SELECT COALESCE(yr21.segment, yr20.segment) AS segment,
           yr20.cnt20                           AS unique_products_2020,
           yr21.cnt21                           AS unique_products_2021,
           100.0 * (yr21.cnt21 - yr20.cnt20) / NULLIF(yr20.cnt20,0) AS pct_increase
    FROM yr20
    FULL OUTER JOIN yr21
         ON yr20.segment = yr21.segment
)
SELECT segment,
       unique_products_2020
FROM pct
ORDER BY pct_increase DESC NULLS LAST,
         segment
LIMIT 20;
```

These nine progressively more complex queries examine the fiscal years present, explore product codes, count unique products by hardware segment for both 2020 and 2021, and finally return the 2020 unique-product counts ordered by the segments that experienced the largest percentage growth in unique fact-sales products from 2020 to 2021.
