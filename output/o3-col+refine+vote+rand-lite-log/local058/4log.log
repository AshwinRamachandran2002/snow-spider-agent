```sql
--Description:  Produce each hardware product segment together with its unique-product
--              count for fiscal year 2020, ordering the segments by the highest
--              percentage increase in unique products from 2020 to 2021.
--              Steps:
--              1. yearly_counts  – count distinct products per (segment, year) for 2020 and 2021.
--              2. pivot          – turn those long rows into wide columns cnt20 / cnt21.
--              3. Final SELECT   – keep segments that existed in 2020, show the 2020 count,
--                                   and sort by percentage increase ((cnt21-cnt20)/cnt20).
WITH yearly_counts AS (
    SELECT dp.segment                         AS segment,
           fm.fiscal_year                     AS yr,
           COUNT(DISTINCT fm.product_code)    AS cnt
    FROM hardware_fact_sales_monthly AS fm
    JOIN hardware_dim_product        AS dp
      ON dp.product_code = fm.product_code
    WHERE fm.fiscal_year IN (2020, 2021)      -- only the two years of interest
    GROUP BY dp.segment, fm.fiscal_year
),
pivot AS (
    SELECT segment,
           MAX(CASE WHEN yr = 2020 THEN cnt END) AS cnt20,
           MAX(CASE WHEN yr = 2021 THEN cnt END) AS cnt21
    FROM yearly_counts
    GROUP BY segment
)
SELECT
    segment,
    cnt20 AS unique_products_2020
FROM pivot
WHERE cnt20 IS NOT NULL                       -- ensure the segment had sales in 2020
ORDER BY (cnt21 - cnt20) * 1.0 / NULLIF(cnt20,0) DESC;
```
