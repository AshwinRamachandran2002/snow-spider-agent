Query:
-- 5) Description: Count the number of unique products sold in 2020 for every segment
SELECT dp.segment,
       COUNT(DISTINCT fm.product_code) AS unique_products_2020
FROM hardware_fact_sales_monthly AS fm
JOIN hardware_dim_product        AS dp
     ON dp.product_code = fm.product_code
WHERE fm.fiscal_year = 2020
GROUP BY dp.segment
ORDER BY unique_products_2020 DESC
LIMIT 20;
