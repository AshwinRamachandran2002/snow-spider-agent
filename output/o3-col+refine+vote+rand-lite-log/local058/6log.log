```sql
-- Description: count the number of unique products sold per segment in fiscal-year 2020
SELECT   p.segment,
         COUNT(DISTINCT s.product_code) AS unique_products_2020
FROM     hardware_fact_sales_monthly AS s
JOIN     hardware_dim_product        AS p
       ON s.product_code = p.product_code
WHERE    s.fiscal_year = 2020
GROUP BY p.segment
LIMIT 20;
```

```sql
-- Description: do the exact same thing for fiscal-year 2021
SELECT   p.segment,
         COUNT(DISTINCT s.product_code) AS unique_products_2021
FROM     hardware_fact_sales_monthly AS s
JOIN     hardware_dim_product        AS p
       ON s.product_code = p.product_code
WHERE    s.fiscal_year = 2021
GROUP BY p.segment
LIMIT 20;
```

```sql
-- Description: put the 2020 and 2021 counts side-by-side for each segment
WITH yearly_counts AS (
    SELECT p.segment,
           s.fiscal_year,
           COUNT(DISTINCT s.product_code) AS uniq_prod
    FROM   hardware_fact_sales_monthly AS s
    JOIN   hardware_dim_product        AS p
      ON   s.product_code = p.product_code
    WHERE  s.fiscal_year IN (2020, 2021)
    GROUP  BY p.segment, s.fiscal_year
)
SELECT segment,
       SUM(CASE WHEN fiscal_year = 2020 THEN uniq_prod END) AS cnt_2020,
       SUM(CASE WHEN fiscal_year = 2021 THEN uniq_prod END) AS cnt_2021
FROM   yearly_counts
GROUP  BY segment
LIMIT 20;
```

```sql
-- Description: calculate the percentage increase from 2020 to 2021 for every segment
WITH yearly_counts AS (
    SELECT p.segment,
           s.fiscal_year,
           COUNT(DISTINCT s.product_code) AS uniq_prod
    FROM   hardware_fact_sales_monthly AS s
    JOIN   hardware_dim_product        AS p
      ON   s.product_code = p.product_code
    WHERE  s.fiscal_year IN (2020, 2021)
    GROUP  BY p.segment, s.fiscal_year
), pivot AS (
    SELECT segment,
           SUM(CASE WHEN fiscal_year = 2020 THEN uniq_prod END) AS cnt_2020,
           SUM(CASE WHEN fiscal_year = 2021 THEN uniq_prod END) AS cnt_2021
    FROM   yearly_counts
    GROUP  BY segment
)
SELECT segment,
       cnt_2020,
       cnt_2021,
       ROUND(
           (cnt_2021 - cnt_2020) * 100.0 / NULLIF(cnt_2020,0)
       ,2) AS pct_increase
FROM   pivot
LIMIT 20;
```

```sql
-- Description: FINAL ANSWER – list each hardware product segment together with its
--              unique product count in 2020, ordered by the highest % increase
--              (from 2020 to 2021).  Only the columns requested are returned.
WITH yearly_counts AS (
    SELECT p.segment,
           s.fiscal_year,
           COUNT(DISTINCT s.product_code) AS uniq_prod
    FROM   hardware_fact_sales_monthly AS s
    JOIN   hardware_dim_product        AS p
      ON   s.product_code = p.product_code
    WHERE  s.fiscal_year IN (2020, 2021)
    GROUP  BY p.segment, s.fiscal_year
), pivot AS (
    SELECT segment,
           SUM(CASE WHEN fiscal_year = 2020 THEN uniq_prod END) AS cnt_2020,
           SUM(CASE WHEN fiscal_year = 2021 THEN uniq_prod END) AS cnt_2021
    FROM   yearly_counts
    GROUP  BY segment
), ranked AS (
    SELECT segment,
           cnt_2020 AS unique_products_2020,
           ROUND((cnt_2021 - cnt_2020) * 100.0 / NULLIF(cnt_2020,0), 2) AS pct_increase
    FROM   pivot
)
SELECT segment,
       unique_products_2020
FROM   ranked
ORDER  BY pct_increase DESC
LIMIT 20;
```
