```

```sql
--Description: Count the number of UNIQUE products sold per segment in fiscal year 2020
SELECT hdp."segment",
       COUNT(DISTINCT hfsm."product_code") AS "unique_products_2020"
FROM   "hardware_fact_sales_monthly" AS hfsm
JOIN   "hardware_dim_product"        AS hdp
       ON hfsm."product_code" = hdp."product_code"
WHERE  hfsm."fiscal_year" = 2020
GROUP  BY hdp."segment"
LIMIT 20;
```

```sql
--Description: Count the number of UNIQUE products sold per segment in fiscal year 2021
SELECT hdp."segment",
       COUNT(DISTINCT hfsm."product_code") AS "unique_products_2021"
FROM   "hardware_fact_sales_monthly" AS hfsm
JOIN   "hardware_dim_product"        AS hdp
       ON hfsm."product_code" = hdp."product_code"
WHERE  hfsm."fiscal_year" = 2021
GROUP  BY hdp."segment"
LIMIT 20;
```

```sql
--Description: Create a side-by-side view of 2020 vs 2021 unique product counts per segment
SELECT hdp."segment",
       SUM(CASE WHEN hfsm."fiscal_year" = 2020 THEN 1 ELSE 0 END) AS "flag_2020",
       SUM(CASE WHEN hfsm."fiscal_year" = 2021 THEN 1 ELSE 0 END) AS "flag_2021"
FROM   "hardware_fact_sales_monthly" AS hfsm
JOIN   "hardware_dim_product"        AS hdp
       ON hfsm."product_code" = hdp."product_code"
GROUP  BY hdp."segment"
LIMIT 20;
```

```sql
--Description: Aggregate distinct product counts for each segment across 2020 and 2021
WITH yearly_counts AS (
    SELECT hdp."segment",
           hfsm."fiscal_year",
           COUNT(DISTINCT hfsm."product_code") AS "unique_products"
    FROM   "hardware_fact_sales_monthly" AS hfsm
    JOIN   "hardware_dim_product"        AS hdp
           ON hfsm."product_code" = hdp."product_code"
    WHERE  hfsm."fiscal_year" IN (2020, 2021)
    GROUP  BY hdp."segment", hfsm."fiscal_year"
)
SELECT *
FROM   yearly_counts
LIMIT 20;
```

```sql
--Description: Pivot the yearly_counts CTE so each segment has 2020 and 2021 counts in one row
WITH yearly_counts AS (
    SELECT hdp."segment",
           hfsm."fiscal_year",
           COUNT(DISTINCT hfsm."product_code") AS "unique_products"
    FROM   "hardware_fact_sales_monthly" AS hfsm
    JOIN   "hardware_dim_product"        AS hdp
           ON hfsm."product_code" = hdp."product_code"
    WHERE  hfsm."fiscal_year" IN (2020, 2021)
    GROUP  BY hdp."segment", hfsm."fiscal_year"
)
SELECT  yc20."segment",
        yc20."unique_products" AS "unique_products_2020",
        yc21."unique_products" AS "unique_products_2021"
FROM    yearly_counts AS yc20
LEFT JOIN yearly_counts AS yc21
       ON yc20."segment"      = yc21."segment"
      AND yc21."fiscal_year"  = 2021
WHERE   yc20."fiscal_year"    = 2020
LIMIT 20;
```

```sql
--Description: Final result – list segments, 2020 unique product counts, and the % increase to 2021, ordered by highest increase
WITH yearly_counts AS (
    SELECT hdp."segment",
           hfsm."fiscal_year",
           COUNT(DISTINCT hfsm."product_code") AS "unique_products"
    FROM   "hardware_fact_sales_monthly" AS hfsm
    JOIN   "hardware_dim_product"        AS hdp
           ON hfsm."product_code" = hdp."product_code"
    WHERE  hfsm."fiscal_year" IN (2020, 2021)
    GROUP  BY hdp."segment", hfsm."fiscal_year"
),
pivoted AS (
    SELECT  yc20."segment",
            yc20."unique_products" AS "unique_products_2020",
            COALESCE(yc21."unique_products", 0) AS "unique_products_2021"
    FROM    yearly_counts AS yc20
    LEFT JOIN yearly_counts AS yc21
           ON yc20."segment"      = yc21."segment"
          AND yc21."fiscal_year"  = 2021
    WHERE   yc20."fiscal_year"    = 2020
)
SELECT "segment",
       "unique_products_2020",
       "unique_products_2021",
       ROUND(
           100.0 * ("unique_products_2021" - "unique_products_2020") /
           NULLIF("unique_products_2020", 0), 2
       ) AS "pct_increase"
FROM   pivoted
ORDER  BY "pct_increase" DESC
LIMIT 20;
```
