```sql
--Description: Count the number of unique products sold per segment in fiscal-year 2020
SELECT  dp.segment,
        COUNT(DISTINCT s.product_code) AS unique_products_2020
FROM    hardware_fact_sales_monthly  AS s
JOIN    hardware_dim_product         AS dp
       ON s.product_code = dp.product_code
WHERE   s.fiscal_year = 2020
GROUP BY dp.segment
ORDER BY unique_products_2020 DESC
LIMIT 20;
```

```sql
--Description: Count the number of unique products sold per segment in fiscal-year 2021
SELECT  dp.segment,
        COUNT(DISTINCT s.product_code) AS unique_products_2021
FROM    hardware_fact_sales_monthly  AS s
JOIN    hardware_dim_product         AS dp
       ON s.product_code = dp.product_code
WHERE   s.fiscal_year = 2021
GROUP BY dp.segment
ORDER BY unique_products_2021 DESC
LIMIT 20;
```

```sql
--Description: Bring the 2020 and 2021 counts together side-by-side for every segment
SELECT  seg.segment,
        COALESCE(c20.unique_products_2020 ,0) AS unique_products_2020,
        COALESCE(c21.unique_products_2021 ,0) AS unique_products_2021
FROM   (SELECT DISTINCT segment FROM hardware_dim_product) AS seg
LEFT  JOIN (
        SELECT  dp.segment,
                COUNT(DISTINCT s.product_code) AS unique_products_2020
        FROM    hardware_fact_sales_monthly AS s
        JOIN    hardware_dim_product        AS dp
              ON s.product_code = dp.product_code
        WHERE   s.fiscal_year = 2020
        GROUP BY dp.segment
) AS c20  ON seg.segment = c20.segment
LEFT  JOIN (
        SELECT  dp.segment,
                COUNT(DISTINCT s.product_code) AS unique_products_2021
        FROM    hardware_fact_sales_monthly AS s
        JOIN    hardware_dim_product        AS dp
              ON s.product_code = dp.product_code
        WHERE   s.fiscal_year = 2021
        GROUP BY dp.segment
) AS c21  ON seg.segment = c21.segment
LIMIT 20;
```

```sql
--Description: Add the % increase from 2020 → 2021 for every segment
SELECT  seg.segment,
        COALESCE(c20.unique_products_2020 ,0) AS unique_products_2020,
        COALESCE(c21.unique_products_2021 ,0) AS unique_products_2021,
        CASE
            WHEN COALESCE(c20.unique_products_2020,0) = 0 THEN NULL
            ELSE ROUND(
                 (COALESCE(c21.unique_products_2021,0) - COALESCE(c20.unique_products_2020,0))
                 * 100.0 / COALESCE(c20.unique_products_2020,0), 2)
        END AS pct_increase
FROM   (SELECT DISTINCT segment FROM hardware_dim_product) AS seg
LEFT  JOIN (
        SELECT  dp.segment,
                COUNT(DISTINCT s.product_code) AS unique_products_2020
        FROM    hardware_fact_sales_monthly AS s
        JOIN    hardware_dim_product        AS dp
              ON s.product_code = dp.product_code
        WHERE   s.fiscal_year = 2020
        GROUP BY dp.segment
) AS c20  ON seg.segment = c20.segment
LEFT  JOIN (
        SELECT  dp.segment,
                COUNT(DISTINCT s.product_code) AS unique_products_2021
        FROM    hardware_fact_sales_monthly AS s
        JOIN    hardware_dim_product        AS dp
              ON s.product_code = dp.product_code
        WHERE   s.fiscal_year = 2021
        GROUP BY dp.segment
) AS c21  ON seg.segment = c21.segment
ORDER BY pct_increase DESC
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – list segments with their 2020 unique-product counts,
--             ordered by the highest % increase in unique products from 2020 to 2021
SELECT  seg.segment,
        COALESCE(c20.unique_products_2020 ,0)  AS unique_products_2020
FROM   (SELECT DISTINCT segment FROM hardware_dim_product) AS seg
LEFT  JOIN (
        SELECT  dp.segment,
                COUNT(DISTINCT s.product_code) AS unique_products_2020
        FROM    hardware_fact_sales_monthly AS s
        JOIN    hardware_dim_product        AS dp
              ON s.product_code = dp.product_code
        WHERE   s.fiscal_year = 2020
        GROUP BY dp.segment
) AS c20  ON seg.segment = c20.segment
LEFT  JOIN (
        SELECT  dp.segment,
                COUNT(DISTINCT s.product_code) AS unique_products_2021
        FROM    hardware_fact_sales_monthly AS s
        JOIN    hardware_dim_product        AS dp
              ON s.product_code = dp.product_code
        WHERE   s.fiscal_year = 2021
        GROUP BY dp.segment
) AS c21  ON seg.segment = c21.segment
ORDER BY
        CASE
            WHEN COALESCE(c20.unique_products_2020,0) = 0 THEN -1.0
            ELSE (COALESCE(c21.unique_products_2021,0) - COALESCE(c20.unique_products_2020,0))
                 * 1.0 / COALESCE(c20.unique_products_2020,0)
        END DESC
LIMIT 20;
```
