-- 3. Description: Aggregate the postal-code table to state level.
-- The “gap” is:  (estimated total buildings) - (current installs)
-- with estimated total buildings = count_qualified / pct_qualified / pct_covered.
SELECT
  `state_name`,
  SUM(`count_qualified`)                                  AS total_buildings_suitable,
  AVG(`percent_covered`)                                  AS avg_pct_covered,
  AVG(`percent_qualified`)                                AS avg_pct_suitable_of_covered,
  SUM(`number_of_panels_total`)                           AS total_panel_capacity,
  SUM(`kw_total`)                                         AS total_kw_capacity,
  SUM(`yearly_sunlight_kwh_total`)                        AS total_kwh_generation,
  SUM(`carbon_offset_metric_tons`)                        AS total_co2_offset_tons,
  SUM(`existing_installs_count`)                          AS current_installed_buildings,
  -- gap in potential installations
  SUM(`count_qualified` / NULLIF(`percent_qualified`,0) * 100
      / NULLIF(`percent_covered`,0) )                    
    - SUM(`existing_installs_count`)                      AS potential_install_gap
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
GROUP BY `state_name`
LIMIT 20;
