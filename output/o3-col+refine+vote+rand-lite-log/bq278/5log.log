```sql
--Description / Thinking process:
-- We want a single, state-level table that lets us compare postal-code
-- metrics with census-tract metrics side-by-side.  For every state we
-- therefore:
--   1.  Aggregate the postal-code table -> CTE “postal”.
--   2.  Aggregate the census-tract table -> CTE “census”.
--      • For each granularity we compute:
--          • total_buildings_suitable  (Σ count_qualified)
--          • avg_pct_covered           (AVG percent_covered)
--          • avg_pct_suitable          (AVG percent_qualified)
--          • total_panel_capacity      (Σ number_of_panels_total)
--          • total_kw_capacity         (Σ kw_total)
--          • total_kwh_generation      (Σ yearly_sunlight_kwh_total)
--          • total_co2_offset_tons     (Σ carbon_offset_metric_tons)
--          • current_installed         (Σ existing_installs_count)
--          • install_gap               (estimated total buildings – installs)
--            where  estimated total buildings =
--                   count_qualified ÷ (pct_qualified/100) ÷ (pct_covered/100)
--                   which is algebraically count_qualified*10000
--                   ÷ pct_qualified ÷ pct_covered
--   3.  FULL OUTER JOIN those summaries so every state appears even if it
--       exists in only one source (rare).
--   4.  Return both sets of metrics for direct comparison.  No LIMIT is
--       applied so the consumer can see every state; add one if desired.
WITH postal AS (
  SELECT
    state_name,
    SUM(count_qualified)                                  AS p_total_buildings_suitable,
    AVG(percent_covered)                                  AS p_avg_pct_covered,
    AVG(percent_qualified)                                AS p_avg_pct_suitable,
    SUM(number_of_panels_total)                           AS p_total_panel_capacity,
    SUM(kw_total)                                         AS p_total_kw_capacity,
    SUM(yearly_sunlight_kwh_total)                        AS p_total_kwh_generation,
    SUM(carbon_offset_metric_tons)                        AS p_total_co2_offset_tons,
    SUM(existing_installs_count)                          AS p_current_installed,
    -- Installation gap
    SUM(count_qualified * 10000 /
        NULLIF(percent_qualified,0) /
        NULLIF(percent_covered ,0))
      - SUM(existing_installs_count)                      AS p_install_gap
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
  GROUP BY state_name
),
census AS (
  SELECT
    state_name,
    SUM(count_qualified)                                  AS c_total_buildings_suitable,
    AVG(percent_covered)                                  AS c_avg_pct_covered,
    AVG(percent_qualified)                                AS c_avg_pct_suitable,
    SUM(number_of_panels_total)                           AS c_total_panel_capacity,
    SUM(kw_total)                                         AS c_total_kw_capacity,
    SUM(yearly_sunlight_kwh_total)                        AS c_total_kwh_generation,
    SUM(carbon_offset_metric_tons)                        AS c_total_co2_offset_tons,
    SUM(existing_installs_count)                          AS c_current_installed,
    SUM(count_qualified * 10000 /
        NULLIF(percent_qualified,0) /
        NULLIF(percent_covered ,0))
      - SUM(existing_installs_count)                      AS c_install_gap
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
  GROUP BY state_name
)
SELECT
  COALESCE(p.state_name, c.state_name)                    AS state_name,
  -- Postal-code metrics
  p_total_buildings_suitable,
  p_avg_pct_covered,
  p_avg_pct_suitable,
  p_total_panel_capacity,
  p_total_kw_capacity,
  p_total_kwh_generation,
  p_total_co2_offset_tons,
  p_current_installed,
  p_install_gap,
  -- Census-tract metrics
  c_total_buildings_suitable,
  c_avg_pct_covered,
  c_avg_pct_suitable,
  c_total_panel_capacity,
  c_total_kw_capacity,
  c_total_kwh_generation,
  c_total_co2_offset_tons,
  c_current_installed,
  c_install_gap
FROM postal AS p
FULL OUTER JOIN census AS c
ON p.state_name = c.state_name
ORDER BY state_name;
```
