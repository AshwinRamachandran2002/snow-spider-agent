Query:
--Description: Inspect the JSON bucket column in the postal-code table and
--             extract, for a sample of rows, the lower-bound kW of each
--             installation-size bucket together with the associated building
--             count.  JSON_EXTRACT_ARRAY returns an ARRAY<JSON>; we UNNEST it
--             and pull out the 0-th and 1-st elements of each tuple.
SELECT
  region_name,
  CAST(JSON_EXTRACT_SCALAR(bucket_json, '$[0]') AS INT64) AS bucket_kw_lower,
  CAST(JSON_EXTRACT_SCALAR(bucket_json, '$[1]') AS INT64) AS building_count
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`,
     UNNEST(JSON_EXTRACT_ARRAY(install_size_kw_buckets)) AS bucket_json
LIMIT 20
