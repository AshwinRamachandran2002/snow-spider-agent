```sql
-- Description: Retrieve all SubjectIDs that belong to the English (“ENG”) category
SELECT DISTINCT "SubjectID", "SubjectCode", "SubjectName"
FROM "Subjects"
WHERE "CategoryID" = 'ENG'
LIMIT 20;
```

```sql
-- Description: Find every class that teaches an English subject
SELECT DISTINCT "ClassID", "SubjectID"
FROM "Classes"
WHERE "SubjectID" IN (
    SELECT "SubjectID"
    FROM "Subjects"
    WHERE "CategoryID" = 'ENG'
)
LIMIT 20;
```

```sql
-- Description: List the students who completed (ClassStatus = 2) any of those English classes together with their grades
SELECT DISTINCT ss."StudentID", ss."ClassID", ss."Grade"
FROM "Student_Schedules" AS ss
WHERE ss."ClassStatus" = 2
  AND ss."ClassID" IN (
      SELECT "ClassID"
      FROM "Classes"
      WHERE "SubjectID" IN (
          SELECT "SubjectID"
          FROM "Subjects"
          WHERE "CategoryID" = 'ENG'
      )
  )
LIMIT 20;
```

```sql
-- Description: Join the previous result with Students to obtain the last names and the grades
SELECT DISTINCT st."StudLastName", ss."Grade"
FROM "Student_Schedules" AS ss
JOIN "Students"          AS st ON st."StudentID" = ss."StudentID"
WHERE ss."ClassStatus" = 2
  AND ss."ClassID" IN (
      SELECT "ClassID"
      FROM "Classes"
      WHERE "SubjectID" IN (
          SELECT "SubjectID"
          FROM "Subjects"
          WHERE "CategoryID" = 'ENG'
      )
  )
LIMIT 20;
```

```sql
