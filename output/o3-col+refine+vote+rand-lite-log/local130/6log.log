```sql
-- Description / Thinking Process:
-- Goal: List last names of students who completed English courses (ClassStatus=2)
--       and assign each a quintile label based on their grade.
-- Steps:
--   1. Identify English SubjectIDs (CategoryID = 'ENG') from Subjects.
--   2. Find ClassIDs in Classes that teach those SubjectIDs.
--   3. From Student_Schedules, keep records with those ClassIDs and ClassStatus = 2.
--   4. Use PERCENT_RANK() over descending grades to compute each student’s relative rank.
--   5. Convert percent rank to quintile labels:
--        ≤0.20  → First
--        ≤0.40  → Second
--        ≤0.60  → Third
--        ≤0.80  → Fourth
--        >0.80  → Fifth
--   6. Join to Students to get last names.
--   7. Order by quintile priority (First to Fifth) and then alphabetically.
SELECT
    st."StudLastName",
    CASE
        WHEN q.pr <= 0.20 THEN 'First'
        WHEN q.pr <= 0.40 THEN 'Second'
        WHEN q.pr <= 0.60 THEN 'Third'
        WHEN q.pr <= 0.80 THEN 'Fourth'
        ELSE 'Fifth'
    END AS "Quintile"
FROM (
    SELECT
        ss."StudentID",
        ss."Grade",
        PERCENT_RANK() OVER (ORDER BY ss."Grade" DESC) AS pr
    FROM "Student_Schedules" AS ss
    WHERE ss."ClassStatus" = 2
      AND ss."ClassID" IN (
          SELECT c."ClassID"
          FROM "Classes" AS c
          WHERE c."SubjectID" IN (
              SELECT s."SubjectID"
              FROM "Subjects" AS s
              WHERE s."CategoryID" = 'ENG'
          )
      )
) AS q
JOIN "Students" AS st
  ON st."StudentID" = q."StudentID"
ORDER BY
    CASE
        WHEN q.pr <= 0.20 THEN 1
        WHEN q.pr <= 0.40 THEN 2
        WHEN q.pr <= 0.60 THEN 3
        WHEN q.pr <= 0.80 THEN 4
        ELSE 5
    END,
    st."StudLastName";
```
