      FROM "Classes"
      WHERE "SubjectID" IN (
          SELECT "SubjectID"
          FROM "Subjects"
          WHERE "CategoryID" = 'ENG'
      )
  )
LIMIT 20;
```

```sql
-- Description: Show each student's percentile (PERCENT_RANK) to facilitate mapping to quintiles
SELECT st."StudLastName",
       ss."Grade",
       PERCENT_RANK() OVER (ORDER BY ss."Grade" DESC) AS "Percent_Rank"
FROM "Student_Schedules" AS ss
JOIN "Students"          AS st ON st."StudentID" = ss."StudentID"
WHERE ss."ClassStatus" = 2
  AND ss."ClassID" IN (
      SELECT "ClassID"
      FROM "Classes"
      WHERE "SubjectID" IN (
          SELECT "SubjectID"
          FROM "Subjects"
          WHERE "CategoryID" = 'ENG'
      )
  )
LIMIT 20;
```

```sql
-- Description: Assign the “First”–“Fifth” quintile labels based on the percent rank
SELECT st."StudLastName",
       ss."Grade",
       CASE
            WHEN pr <= 0.20 THEN 'First'
            WHEN pr <= 0.40 THEN 'Second'
            WHEN pr <= 0.60 THEN 'Third'
            WHEN pr <= 0.80 THEN 'Fourth'
            ELSE 'Fifth'
       END AS "Quintile"
FROM (
    SELECT ss."StudentID",
           ss."Grade",
           PERCENT_RANK() OVER (ORDER BY ss."Grade" DESC) AS pr
    FROM "Student_Schedules" AS ss
    WHERE ss."ClassStatus" = 2
      AND ss."ClassID" IN (
          SELECT "ClassID"
          FROM "Classes"
          WHERE "SubjectID" IN (
              SELECT "SubjectID"
              FROM "Subjects"
              WHERE "CategoryID" = 'ENG'
          )
      )
) AS q
JOIN "Students" AS st ON st."StudentID" = q."StudentID"
LIMIT 20;
```

```sql
-- Description: Produce the final ordered report (highest quintile first) for all students
SELECT st."StudLastName",
       q."Quintile"
FROM (
    SELECT ss."StudentID",
           CASE
                WHEN pr <= 0.20 THEN 'First'
                WHEN pr <= 0.40 THEN 'Second'
                WHEN pr <= 0.60 THEN 'Third'
                WHEN pr <= 0.80 THEN 'Fourth'
                ELSE 'Fifth'
           END AS "Quintile"
    FROM (
        SELECT ss."StudentID",
               PERCENT_RANK() OVER (ORDER BY ss."Grade" DESC) AS pr
        FROM "Student_Schedules" AS ss
        WHERE ss."ClassStatus" = 2
          AND ss."ClassID" IN (
              SELECT "ClassID"
              FROM "Classes"
              WHERE "SubjectID" IN (
                  SELECT "SubjectID"
                  FROM "Subjects"
                  WHERE "CategoryID" = 'ENG'
              )
          )
    ) AS ranked
) AS q
JOIN "Students" AS st ON st."StudentID" = q."StudentID"
ORDER BY
     CASE q."Quintile"
          WHEN 'First'  THEN 1
          WHEN 'Second' THEN 2
          WHEN 'Third'  THEN 3
          WHEN 'Fourth' THEN 4
          ELSE 5
     END,
     st."StudLastName"
LIMIT 20;
```
