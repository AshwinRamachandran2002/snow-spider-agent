```sql
-- 1) Review the available subject areas to confirm the English category code
SELECT DISTINCT "CategoryID", "CategoryDescription"
FROM "Categories"
LIMIT 20;
```

```sql
-- 2) List a few English subjects to verify their SubjectID values
SELECT DISTINCT "SubjectID", "SubjectCode", "SubjectName"
FROM "Subjects"
WHERE "CategoryID" = 'ENG'
LIMIT 20;
```

```sql
-- 3) Find some class sections that teach those English subjects
SELECT DISTINCT "ClassID", "SubjectID"
FROM "Classes"
WHERE "SubjectID" IN (SELECT "SubjectID" FROM "Subjects" WHERE "CategoryID" = 'ENG')
LIMIT 20;
```

```sql
-- 4) Show student-schedule rows where the English classes above have been COMPLETED (ClassStatus = 2)
SELECT DISTINCT "StudentID", "ClassID", "Grade"
FROM "Student_Schedules"
WHERE "ClassStatus" = 2
  AND "ClassID" IN (SELECT "ClassID"
                    FROM "Classes"
                    WHERE "SubjectID" IN (SELECT "SubjectID"
                                          FROM "Subjects"
                                          WHERE "CategoryID" = 'ENG'))
LIMIT 20;
```

```sql
-- 5) Join to students to inspect last names and their grades in completed English courses
SELECT DISTINCT st."StudLastName", ss."Grade"
FROM "Student_Schedules" AS ss
JOIN "Students"        AS st ON st."StudentID" = ss."StudentID"
WHERE ss."ClassStatus" = 2
  AND ss."ClassID" IN (SELECT "ClassID"
                       FROM "Classes"
                       WHERE "SubjectID" IN (SELECT "SubjectID"
                                             FROM "Subjects"
                                             WHERE "CategoryID" = 'ENG'))
LIMIT 20;
```

```sql
-- 6) Count how many distinct students have completed at least one English course
SELECT COUNT(DISTINCT ss."StudentID") AS "Total_English_Completers"
FROM "Student_Schedules" AS ss
WHERE ss."ClassStatus" = 2
  AND ss."ClassID" IN (SELECT "ClassID"
                       FROM "Classes"
                       WHERE "SubjectID" IN (SELECT "SubjectID"
                                             FROM "Subjects"
                                             WHERE "CategoryID" = 'ENG'));
```

```sql
-- 7) List each completer with his/her highest English grade (if multiple completions exist)
SELECT ec."StudentID",
       MAX(ec."Grade") AS "Best_Grade"
FROM "Student_Schedules" AS ec
WHERE ec."ClassStatus" = 2
  AND ec."ClassID" IN (SELECT "ClassID"
                       FROM "Classes"
                       WHERE "SubjectID" IN (SELECT "SubjectID"
                                             FROM "Subjects"
                                             WHERE "CategoryID" = 'ENG'))
GROUP BY ec."StudentID"
ORDER BY "Best_Grade" DESC
LIMIT 20;
```

```sql
-- 8) Generate a rank (1 = best grade) and place each student into a quintile (1–5)
WITH EnglishGrades AS (
  SELECT ec."StudentID",
         MAX(ec."Grade") AS "Best_Grade"          -- use best English grade per student
  FROM "Student_Schedules" AS ec
  WHERE ec."ClassStatus" = 2
    AND ec."ClassID" IN (SELECT "ClassID"
                         FROM "Classes"
                         WHERE "SubjectID" IN (SELECT "SubjectID"
                                               FROM "Subjects"
                                               WHERE "CategoryID" = 'ENG'))
  GROUP BY ec."StudentID"
),
Ranked AS (
  SELECT eg.*,
         RANK()  OVER (ORDER BY eg."Best_Grade" DESC) AS "pos",
         COUNT(*) OVER ()                              AS "total_cnt",
         NTILE(5) OVER (ORDER BY eg."Best_Grade" DESC) AS "q_num"
  FROM EnglishGrades AS eg
)
SELECT r."StudentID", r."Best_Grade", r."pos", r."total_cnt", r."q_num"
FROM Ranked AS r
ORDER BY r."q_num", r."Best_Grade" DESC
LIMIT 20;
```

```sql
-- 9) Convert the numeric quintile to the requested labels and attach student last names
WITH EnglishGrades AS (
  SELECT ec."StudentID",
         MAX(ec."Grade") AS "Best_Grade"
  FROM "Student_Schedules" AS ec
  WHERE ec."ClassStatus" = 2
    AND ec."ClassID" IN (SELECT "ClassID"
                         FROM "Classes"
                         WHERE "SubjectID" IN (SELECT "SubjectID"
                                               FROM "Subjects"
                                               WHERE "CategoryID" = 'ENG'))
  GROUP BY ec."StudentID"
),
Ranked AS (
  SELECT eg."StudentID",
         NTILE(5) OVER (ORDER BY eg."Best_Grade" DESC) AS "q_num"
  FROM EnglishGrades AS eg
),
Labelled AS (
  SELECT r."StudentID",
         CASE r."q_num"
              WHEN 1 THEN 'First'
              WHEN 2 THEN 'Second'
              WHEN 3 THEN 'Third'
              WHEN 4 THEN 'Fourth'
              ELSE 'Fifth'
         END AS "Quintile"
  FROM Ranked AS r
)
SELECT s."StudLastName" AS "LastName", l."Quintile"
FROM Labelled  AS l
JOIN "Students" AS s ON s."StudentID" = l."StudentID"
ORDER BY CASE l."Quintile"
             WHEN 'First'  THEN 1
             WHEN 'Second' THEN 2
             WHEN 'Third'  THEN 3
             WHEN 'Fourth' THEN 4
             ELSE 5
         END,
         s."StudLastName"
LIMIT 20;
```

```sql
-- 10) Final answer: return every qualifying student, fully sorted, without the LIMIT
WITH EnglishGrades AS (
  SELECT ec."StudentID",
         MAX(ec."Grade") AS "Best_Grade"
  FROM "Student_Schedules" AS ec
  WHERE ec."ClassStatus" = 2
    AND ec."ClassID" IN (SELECT "ClassID"
                         FROM "Classes"
                         WHERE "SubjectID" IN (SELECT "SubjectID"
                                               FROM "Subjects"
                                               WHERE "CategoryID" = 'ENG'))
  GROUP BY ec."StudentID"
),
Ranked AS (
  SELECT eg."StudentID",
         NTILE(5) OVER (ORDER BY eg."Best_Grade" DESC) AS "q_num"
  FROM EnglishGrades AS eg
),
Labelled AS (
  SELECT r."StudentID",
         CASE r."q_num"
              WHEN 1 THEN 'First'
              WHEN 2 THEN 'Second'
              WHEN 3 THEN 'Third'
              WHEN 4 THEN 'Fourth'
              ELSE 'Fifth'
         END AS "Quintile"
  FROM Ranked AS r
)
SELECT s."StudLastName" AS "LastName", l."Quintile"
FROM Labelled AS l
JOIN "Students" AS s ON s."StudentID" = l."StudentID"
ORDER BY CASE l."Quintile"
             WHEN 'First'  THEN 1
             WHEN 'Second' THEN 2
             WHEN 'Third'  THEN 3
             WHEN 'Fourth' THEN 4
             ELSE 5
         END,
         s."StudLastName";
```
