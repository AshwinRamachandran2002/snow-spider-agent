```sql
--Description: List students’ last names with their quintile labels based on English-course grades,
--             sorted from highest to lowest performing quintile.
SELECT  outer_q."StudLastName",
        outer_q."Quintile"
FROM   (
        SELECT  inner_q."StudLastName",
                CASE
                     WHEN ( (inner_q."rnk" - 1) * 1.0 / inner_q."cnt" ) < 0.20 THEN 'First'
                     WHEN ( (inner_q."rnk" - 1) * 1.0 / inner_q."cnt" ) < 0.40 THEN 'Second'
                     WHEN ( (inner_q."rnk" - 1) * 1.0 / inner_q."cnt" ) < 0.60 THEN 'Third'
                     WHEN ( (inner_q."rnk" - 1) * 1.0 / inner_q."cnt" ) < 0.80 THEN 'Fourth'
                     ELSE 'Fifth'
                END AS "Quintile"
        FROM   (
                SELECT  s."StudLastName",
                        ss."Grade",
                        RANK() OVER (ORDER BY ss."Grade" DESC)       AS "rnk",
                        COUNT(*) OVER ()                             AS "cnt"
                FROM    "Student_Schedules"  AS ss
                JOIN    "Classes"            AS c   ON c."ClassID"   = ss."ClassID"
                JOIN    "Subjects"           AS sub ON sub."SubjectID" = c."SubjectID"
                JOIN    "Students"           AS s   ON s."StudentID" = ss."StudentID"
                WHERE   ss."ClassStatus" = 2
                  AND   sub."CategoryID"  = 'ENG'
               ) AS inner_q
      ) AS outer_q
ORDER BY CASE outer_q."Quintile"
            WHEN 'First'  THEN 1
            WHEN 'Second' THEN 2
            WHEN 'Third'  THEN 3
            WHEN 'Fourth' THEN 4
            ELSE 5
         END,
         outer_q."StudLastName"
LIMIT 20;
```
