--Description: count how many individual completed English-course records we have (needed for quintiles)
SELECT COUNT(*) AS "TotalEnglishCompleted"
FROM "Student_Schedules" AS ss
JOIN "Classes"  AS c ON ss."ClassID"  = c."ClassID"
JOIN "Subjects" AS s ON c."SubjectID" = s."SubjectID"
WHERE ss."ClassStatus" = 2
  AND s."CategoryID"   = 'ENG';
