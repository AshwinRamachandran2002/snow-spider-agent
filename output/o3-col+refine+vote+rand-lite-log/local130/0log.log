LIMIT 20;
```

```sql
--Description: look at some completed classes in the students’ schedules (ClassStatus = 2)
SELECT DISTINCT "StudentID", "ClassID", "Grade"
FROM "Student_Schedules"
WHERE "ClassStatus" = 2
LIMIT 20;
```

```sql
--Description: pick out completed English-category classes with the grades we’ll analyze
SELECT DISTINCT ss."StudentID", ss."ClassID", ss."Grade"
FROM "Student_Schedules" AS ss
JOIN "Classes"   AS c ON ss."ClassID"  = c."ClassID"
JOIN "Subjects"  AS s ON c."SubjectID" = s."SubjectID"
WHERE ss."ClassStatus" = 2
  AND s."CategoryID"   = 'ENG'
LIMIT 20;
```

```sql
--Description: add student last names to the previous result set
SELECT DISTINCT st."StudLastName", ss."Grade"
FROM "Student_Schedules" AS ss
JOIN "Classes"  AS c  ON ss."ClassID"  = c."ClassID"
JOIN "Subjects" AS s  ON c."SubjectID" = s."SubjectID"
JOIN "Students" AS st ON ss."StudentID" = st."StudentID"
WHERE ss."ClassStatus" = 2
  AND s."CategoryID"   = 'ENG'
LIMIT 20;
```

```sql
--Description: count how many individual completed English-course records we have (needed for quintiles)
SELECT COUNT(*) AS "TotalEnglishCompleted"
FROM "Student_Schedules" AS ss
JOIN "Classes"  AS c ON ss."ClassID"  = c."ClassID"
JOIN "Subjects" AS s ON c."SubjectID" = s."SubjectID"
WHERE ss."ClassStatus" = 2
  AND s."CategoryID"   = 'ENG';
```

```sql
--Description: FINAL ANSWER – last names of students with completed English courses, 
--              labelled by quintile (First = top 20 %, … Fifth = bottom 20 %), 
--              ordered from highest-performing quintile to lowest
WITH english_completed AS (
    SELECT st."StudLastName" AS "LastName",
           ss."Grade"
    FROM "Student_Schedules" AS ss
    JOIN "Classes"  AS c  ON ss."ClassID"  = c."ClassID"
    JOIN "Subjects" AS s  ON c."SubjectID" = s."SubjectID"
    JOIN "Students" AS st ON ss."StudentID" = st."StudentID"
    WHERE ss."ClassStatus" = 2
      AND s."CategoryID"   = 'ENG'
),
ranked AS (
    SELECT ec."LastName",
           ec."Grade",
           (SELECT COUNT(*) FROM english_completed ec2
             WHERE ec2."Grade" >= ec."Grade") AS "Position",
           (SELECT COUNT(*) FROM english_completed)             AS "Total"
    FROM english_completed ec
),
labeled AS (
    SELECT "LastName",
           CASE
               WHEN 1.0 * "Position" / "Total" <= 0.20 THEN 'First'
               WHEN 1.0 * "Position" / "Total" <= 0.40 THEN 'Second'
               WHEN 1.0 * "Position" / "Total" <= 0.60 THEN 'Third'
               WHEN 1.0 * "Position" / "Total" <= 0.80 THEN 'Fourth'
               ELSE 'Fifth'
           END AS "Quintile"
    FROM ranked
)
SELECT DISTINCT "LastName", "Quintile"
FROM labeled
ORDER BY
    CASE "Quintile"
        WHEN 'First'  THEN 1
        WHEN 'Second' THEN 2
        WHEN 'Third'  THEN 3
        WHEN 'Fourth' THEN 4
        WHEN 'Fifth'  THEN 5
    END
LIMIT 20;
```
