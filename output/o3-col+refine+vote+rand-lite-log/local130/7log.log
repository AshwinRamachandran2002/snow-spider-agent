```sql
-- 1. Find the “English” category so we know its CategoryID.  
SELECT DISTINCT "CategoryID",
                "CategoryDescription"
FROM   "Categories"
WHERE  "CategoryDescription" LIKE '%English%'
LIMIT  20;
```

```sql
-- 2. List all subjects that belong to the English category.  
SELECT DISTINCT sub."SubjectID",
                sub."SubjectCode",
                sub."SubjectName"
FROM   "Subjects"          AS sub
JOIN   "Categories"        AS cat  ON sub."CategoryID" = cat."CategoryID"
WHERE  cat."CategoryDescription" LIKE '%English%'
LIMIT  20;
```

```sql
-- 3. Show the classes that teach those English subjects.  
SELECT DISTINCT c."ClassID",
                c."SubjectID",
                c."ClassRoomID"
FROM   "Classes"           AS c
JOIN   "Subjects"          AS sub  ON c."SubjectID" = sub."SubjectID"
JOIN   "Categories"        AS cat  ON sub."CategoryID" = cat."CategoryID"
WHERE  cat."CategoryDescription" LIKE '%English%'
LIMIT  20;
```

```sql
-- 4. Pull every (Student, Class) pair that *completed* an English class
--    together with the earned grade.  
SELECT DISTINCT ss."StudentID",
                ss."ClassID",
                ss."Grade"
FROM   "Student_Schedules" AS ss
JOIN   "Classes"           AS c    ON ss."ClassID"  = c."ClassID"
JOIN   "Subjects"          AS sub  ON c."SubjectID" = sub."SubjectID"
JOIN   "Categories"        AS cat  ON sub."CategoryID" = cat."CategoryID"
WHERE  cat."CategoryDescription" LIKE '%English%'
  AND  ss."ClassStatus" = 2
LIMIT  20;
```

```sql
-- 5. Attach student last‐names to those English-class grades.  
SELECT DISTINCT st."StudLastName",
                ss."Grade"
FROM   "Student_Schedules" AS ss
JOIN   "Classes"           AS c    ON ss."ClassID"  = c."ClassID"
JOIN   "Subjects"          AS sub  ON c."SubjectID" = sub."SubjectID"
JOIN   "Categories"        AS cat  ON sub."CategoryID" = cat."CategoryID"
JOIN   "Students"          AS st   ON ss."StudentID" = st."StudentID"
WHERE  cat."CategoryDescription" LIKE '%English%'
  AND  ss."ClassStatus" = 2
LIMIT  20;
```

```sql
-- 6. How many completed English-class *records* are there?
--    (Needed for quintile calculation.)  
SELECT COUNT(*) AS "TotalCompletedEnglishGrades"
FROM   "Student_Schedules" AS ss
JOIN   "Classes"           AS c    ON ss."ClassID"  = c."ClassID"
JOIN   "Subjects"          AS sub  ON c."SubjectID" = sub."SubjectID"
JOIN   "Categories"        AS cat  ON sub."CategoryID" = cat."CategoryID"
WHERE  cat."CategoryDescription" LIKE '%English%'
  AND  ss."ClassStatus" = 2
LIMIT  20;
```

```sql
-- 7. FINAL ANSWER – last-names of students who completed English courses
--    with their performance quintile, ranked top (First) → bottom (Fifth).  
WITH english_grades AS (         -- every completed English course & grade
     SELECT st."StudLastName"      AS "LastName",
            ss."Grade"             AS "Grade"
     FROM   "Student_Schedules" ss
     JOIN   "Classes"           c  ON ss."ClassID"  = c."ClassID"
     JOIN   "Subjects"          sub ON c."SubjectID" = sub."SubjectID"
     JOIN   "Categories"        cat ON sub."CategoryID" = cat."CategoryID"
     JOIN   "Students"          st  ON ss."StudentID" = st."StudentID"
     WHERE  cat."CategoryDescription" LIKE '%English%'
       AND  ss."ClassStatus" = 2
), ranked AS (                   -- rank by grade (higher-better)
     SELECT eg."LastName",
            eg."Grade",
            RANK() OVER (ORDER BY eg."Grade" DESC)          AS "rnk",
            COUNT(*) OVER ()                                AS "tot"
     FROM   english_grades AS eg
)
SELECT  "LastName",
        CASE
            WHEN 1.0 * "rnk" / "tot" <= 0.20 THEN 'First'
            WHEN 1.0 * "rnk" / "tot" <= 0.40 THEN 'Second'
            WHEN 1.0 * "rnk" / "tot" <= 0.60 THEN 'Third'
            WHEN 1.0 * "rnk" / "tot" <= 0.80 THEN 'Fourth'
            ELSE                               'Fifth'
        END                                               AS "Quintile"
FROM    ranked
ORDER BY "Quintile"                                        -- First → Fifth
LIMIT   20;
```
