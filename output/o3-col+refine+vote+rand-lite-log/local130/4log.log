```sql
-- Description: 1) Look up the “Categories” rows whose description suggests English-related courses.
SELECT DISTINCT *
FROM "Categories"
WHERE "CategoryDescription" LIKE '%English%'
LIMIT 20;
```

```sql
-- Description: 2) Retrieve SubjectID and names for subjects that belong to the English category (assume CategoryID = 'ENG').
SELECT DISTINCT "SubjectID", "SubjectCode", "SubjectName"
FROM "Subjects"
WHERE "CategoryID" = 'ENG'
LIMIT 20;
```

```sql
-- Description: 3) Show classes that teach any of the English SubjectIDs discovered above.
SELECT DISTINCT "ClassID", "SubjectID", "ClassRoomID"
FROM "Classes"
WHERE "SubjectID" IN (SELECT "SubjectID" FROM "Subjects" WHERE "CategoryID" = 'ENG')
LIMIT 20;
```

```sql
-- Description: 4) Pull the schedules where students have COMPLETED (ClassStatus = 2) those English classes.
SELECT DISTINCT "StudentID", "ClassID", "Grade"
FROM "Student_Schedules"
WHERE "ClassStatus" = 2
  AND "ClassID" IN (
        SELECT "ClassID"
        FROM "Classes"
        WHERE "SubjectID" IN (SELECT "SubjectID"
                              FROM "Subjects"
                              WHERE "CategoryID" = 'ENG')
      )
LIMIT 20;
```

```sql
-- Description: 5) Join to get each completing student’s last name together with the grade earned.
SELECT DISTINCT s."StudLastName", ss."Grade"
FROM "Student_Schedules" AS ss
JOIN "Students" AS s
  ON s."StudentID" = ss."StudentID"
WHERE ss."ClassStatus" = 2
  AND ss."ClassID" IN (
        SELECT "ClassID"
        FROM "Classes"
        WHERE "SubjectID" IN (SELECT "SubjectID"
                              FROM "Subjects"
                              WHERE "CategoryID" = 'ENG')
      )
LIMIT 20;
```

```sql
-- Description: 6) Count the total number of students who completed an English course (needed for quintile cut-offs).
SELECT COUNT(DISTINCT ss."StudentID") AS "Total_English_Completers"
FROM "Student_Schedules" AS ss
WHERE ss."ClassStatus" = 2
  AND ss."ClassID" IN (
        SELECT "ClassID"
        FROM "Classes"
        WHERE "SubjectID" IN (SELECT "SubjectID"
                              FROM "Subjects"
                              WHERE "CategoryID" = 'ENG')
      );
```

```sql
-- Description: 7) Show each student’s grade along with a rank based on how many other students scored higher or equal.
SELECT s."StudLastName",
       ss."Grade",
       (SELECT COUNT(DISTINCT ss2."StudentID")
        FROM "Student_Schedules" AS ss2
        WHERE ss2."ClassStatus" = 2
          AND ss2."ClassID" IN (
                SELECT "ClassID"
                FROM "Classes"
                WHERE "SubjectID" IN (SELECT "SubjectID"
                                      FROM "Subjects"
                                      WHERE "CategoryID" = 'ENG')
              )
          AND ss2."Grade" >= ss."Grade") AS "Rank"
FROM "Student_Schedules" AS ss
JOIN "Students" AS s
  ON s."StudentID" = ss."StudentID"
WHERE ss."ClassStatus" = 2
  AND ss."ClassID" IN (
        SELECT "ClassID"
        FROM "Classes"
        WHERE "SubjectID" IN (SELECT "SubjectID"
                              FROM "Subjects"
                              WHERE "CategoryID" = 'ENG')
      )
LIMIT 20;
```

```sql
-- Description: 8) Produce quintile labels for each student using rank ÷ total completers, then map to First–Fifth.
WITH english_completers AS (
  SELECT s."StudLastName",
         ss."Grade",
         (SELECT COUNT(DISTINCT ss2."StudentID")
          FROM "Student_Schedules" AS ss2
          WHERE ss2."ClassStatus" = 2
            AND ss2."ClassID" IN (
                  SELECT "ClassID"
                  FROM "Classes"
                  WHERE "SubjectID" IN (SELECT "SubjectID"
                                        FROM "Subjects"
                                        WHERE "CategoryID" = 'ENG')
                )
            AND ss2."Grade" >= ss."Grade") AS "Rank"
  FROM "Student_Schedules" AS ss
  JOIN "Students" AS s
    ON s."StudentID" = ss."StudentID"
  WHERE ss."ClassStatus" = 2
    AND ss."ClassID" IN (
          SELECT "ClassID"
          FROM "Classes"
          WHERE "SubjectID" IN (SELECT "SubjectID"
                                FROM "Subjects"
                                WHERE "CategoryID" = 'ENG')
        )
),
tot AS (
  SELECT COUNT(*) AS n FROM english_completers
)
SELECT ec."StudLastName",
       ec."Grade",
       CASE
         WHEN 1.0 * ec."Rank" / tot.n <= 0.20 THEN 'First'
         WHEN 1.0 * ec."Rank" / tot.n <= 0.40 THEN 'Second'
         WHEN 1.0 * ec."Rank" / tot.n <= 0.60 THEN 'Third'
         WHEN 1.0 * ec."Rank" / tot.n <= 0.80 THEN 'Fourth'
         ELSE 'Fifth'
       END AS "Quintile"
FROM english_completers AS ec, tot
ORDER BY
  CASE
    WHEN 1.0 * ec."Rank" / tot.n <= 0.20 THEN 1  -- First (highest)
    WHEN 1.0 * ec."Rank" / tot.n <= 0.40 THEN 2  -- Second
    WHEN 1.0 * ec."Rank" / tot.n <= 0.60 THEN 3  -- Third
    WHEN 1.0 * ec."Rank" / tot.n <= 0.80 THEN 4  -- Fourth
    ELSE 5                                        -- Fifth (lowest)
  END,
  ec."Rank"
LIMIT 20;
```

```sql
-- Description: 9) Same as above but displaying only last name and quintile, sorted from First to Fifth.
WITH english_completers AS (
  SELECT s."StudLastName",
         ss."Grade",
         (SELECT COUNT(DISTINCT ss2."StudentID")
          FROM "Student_Schedules" AS ss2
          WHERE ss2."ClassStatus" = 2
            AND ss2."ClassID" IN (
                  SELECT "ClassID"
                  FROM "Classes"
                  WHERE "SubjectID" IN (SELECT "SubjectID"
                                        FROM "Subjects"
                                        WHERE "CategoryID" = 'ENG')
                )
            AND ss2."Grade" >= ss."Grade") AS "Rank"
  FROM "Student_Schedules" AS ss
  JOIN "Students" AS s
    ON s."StudentID" = ss."StudentID"
  WHERE ss."ClassStatus" = 2
    AND ss."ClassID" IN (
          SELECT "ClassID"
          FROM "Classes"
          WHERE "SubjectID" IN (SELECT "SubjectID"
                                FROM "Subjects"
                                WHERE "CategoryID" = 'ENG')
        )
), tot AS (
  SELECT COUNT(*) AS n FROM english_completers
)
SELECT ec."StudLastName",
       CASE
         WHEN 1.0 * ec."Rank" / tot.n <= 0.20 THEN 'First'
         WHEN 1.0 * ec."Rank" / tot.n <= 0.40 THEN 'Second'
         WHEN 1.0 * ec."Rank" / tot.n <= 0.60 THEN 'Third'
         WHEN 1.0 * ec."Rank" / tot.n <= 0.80 THEN 'Fourth'
         ELSE 'Fifth'
       END AS "Quintile"
FROM english_completers AS ec, tot
ORDER BY
  CASE
    WHEN 1.0 * ec."Rank" / tot.n <= 0.20 THEN 1
    WHEN 1.0 * ec."Rank" / tot.n <= 0.40 THEN 2
    WHEN 1.0 * ec."Rank" / tot.n <= 0.60 THEN 3
    WHEN 1.0 * ec."Rank" / tot.n <= 0.80 THEN 4
    ELSE 5
  END
LIMIT 20;
```

```sql
-- Description: 10) (Optional) Verify distribution counts per quintile.
WITH english_completers AS (
  SELECT s."StudLastName",
         ss."Grade",
         (SELECT COUNT(DISTINCT ss2."StudentID")
          FROM "Student_Schedules" AS ss2
          WHERE ss2."ClassStatus" = 2
            AND ss2."ClassID" IN (
                  SELECT "ClassID"
                  FROM "Classes"
                  WHERE "SubjectID" IN (SELECT "SubjectID"
                                        FROM "Subjects"
                                        WHERE "CategoryID" = 'ENG')
                )
            AND ss2."Grade" >= ss."Grade") AS "Rank"
  FROM "Student_Schedules" AS ss
  JOIN "Students" AS s
    ON s."StudentID" = ss."StudentID"
  WHERE ss."ClassStatus" = 2
    AND ss."ClassID" IN (
          SELECT "ClassID"
          FROM "Classes"
          WHERE "SubjectID" IN (SELECT "SubjectID"
                                FROM "Subjects"
                                WHERE "CategoryID" = 'ENG')
        )
), tot AS (
  SELECT COUNT(*) AS n FROM english_completers
)
SELECT CASE
         WHEN 1.0 * "Rank" / tot.n <= 0.20 THEN 'First'
         WHEN 1.0 * "Rank" / tot.n <= 0.40 THEN 'Second'
         WHEN 1.0 * "Rank" / tot.n <= 0.60 THEN 'Third'
         WHEN 1.0 * "Rank" / tot.n <= 0.80 THEN 'Fourth'
         ELSE 'Fifth'
       END AS "Quintile",
       COUNT(*) AS "Students_in_Quintile"
FROM english_completers, tot
GROUP BY "Quintile"
ORDER BY "Quintile"
LIMIT 20;
```
