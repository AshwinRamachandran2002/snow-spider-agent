--Description:  Final answer – list every student’s last name and quintile, ordered First→Fifth
WITH BestEnglishGrade AS (
    SELECT
        st."StudLastName"                        AS LastName,
        MAX(ss."Grade")                          AS Grade
    FROM "Student_Schedules" ss
    JOIN "Classes"   c  ON c."ClassID"   = ss."ClassID"
    JOIN "Subjects"  su ON su."SubjectID" = c."SubjectID"
    JOIN "Students"  st ON st."StudentID" = ss."StudentID"
    WHERE ss."ClassStatus" = 2
      AND su."CategoryID"  = 'ENG'
    GROUP BY ss."StudentID"
),
Ranked AS (
    SELECT
        LastName,
        CUME_DIST() OVER (ORDER BY Grade DESC) AS cd
    FROM BestEnglishGrade
)
SELECT
    LastName,
    CASE
        WHEN cd <= 0.20 THEN 'First'
        WHEN cd <= 0.40 THEN 'Second'
        WHEN cd <= 0.60 THEN 'Third'
        WHEN cd <= 0.80 THEN 'Fourth'
        ELSE 'Fifth'
    END AS Quintile
FROM Ranked
ORDER BY
    CASE
        WHEN cd <= 0.20 THEN 1
        WHEN cd <= 0.40 THEN 2
        WHEN cd <= 0.60 THEN 3
        WHEN cd <= 0.80 THEN 4
        ELSE 5
    END,
