```sql
-- Description: Rank students by descending grade and compute cumulative distribution
SELECT DISTINCT
       s."StudLastName",
       ss."Grade",
       CUME_DIST() OVER (ORDER BY ss."Grade" DESC)          AS "cum_frac"
FROM   "Students"          AS s
JOIN   "Student_Schedules" AS ss
       ON s."StudentID" = ss."StudentID"
WHERE  ss."ClassStatus" = 2
  AND  ss."ClassID" IN (
       SELECT "ClassID"
       FROM   "Classes"
       WHERE  "SubjectID" IN (
              SELECT "SubjectID"
              FROM   "Subjects"
              WHERE  "CategoryID" = 'ENG')
)
LIMIT 20;
```

```sql
-- Description: Convert cumulative fractions into quintile labels
SELECT *
FROM (
    SELECT
        s."StudLastName"                           AS "LastName",
        ss."Grade",
        CASE
            WHEN cd <= 0.20 THEN 'First'
            WHEN cd <= 0.40 THEN 'Second'
            WHEN cd <= 0.60 THEN 'Third'
            WHEN cd <= 0.80 THEN 'Fourth'
            ELSE 'Fifth'
        END                                         AS "Quintile"
    FROM (
        SELECT
            s."StudLastName",
            ss."Grade",
            CUME_DIST() OVER (ORDER BY ss."Grade" DESC) AS cd
        FROM "Students"          AS s
        JOIN "Student_Schedules" AS ss
          ON s."StudentID" = ss."StudentID"
        WHERE ss."ClassStatus" = 2
          AND ss."ClassID" IN (
              SELECT "ClassID"
              FROM "Classes"
              WHERE "SubjectID" IN (
                  SELECT "SubjectID"
                  FROM "Subjects"
                  WHERE "CategoryID" = 'ENG'
              )
          )
    )
)
ORDER BY
    CASE "Quintile"
        WHEN 'First'  THEN 1
        WHEN 'Second' THEN 2
        WHEN 'Third'  THEN 3
        WHEN 'Fourth' THEN 4
        WHEN 'Fifth'  THEN 5
    END,
    "LastName"
LIMIT 20;
```

