```sql
-- Description / thinking process embedded:
-- Goal: list each student’s last name and the quintile (First .. Fifth) of their
--       performance among *all students who completed an English course*.
-- Steps:
--   A. Identify completed English courses:
--        Student_Schedules.ClassStatus = 2  (Completed)
--        AND related Subjects.CategoryID  = 'ENG'
--   B. A student can finish several English courses; use the highest Grade
--      so every student is represented by one value.
--   C. Rank the grades top-to-bottom with CUME_DIST(); this gives each student
--      the proportion of students scoring ≥ their grade.
--   D. Translate that cumulative fraction into quintile labels.
--   E. Sort by quintile order First→Fifth, then alphabetically.

WITH BestEnglishGrade AS (            -- A & B
    SELECT
        stud."StudLastName"                 AS LastName,
        MAX(sched."Grade")                  AS Grade          -- highest English grade
    FROM "Student_Schedules" sched
    JOIN "Classes"   cls  ON cls."ClassID"   = sched."ClassID"
    JOIN "Subjects"  sub  ON sub."SubjectID" = cls."SubjectID"
    JOIN "Students"  stud ON stud."StudentID"= sched."StudentID"
    WHERE sched."ClassStatus" = 2                             -- Completed
      AND sub."CategoryID"  = 'ENG'                           -- English courses
    GROUP BY sched."StudentID"
),
Ranked AS (                           -- C
    SELECT
        LastName,
        CUME_DIST() OVER (ORDER BY Grade DESC) AS cd          -- cumulative fraction
    FROM BestEnglishGrade
)
SELECT                                -- D & E
    LastName,
    CASE
        WHEN cd <= 0.20 THEN 'First'
        WHEN cd <= 0.40 THEN 'Second'
        WHEN cd <= 0.60 THEN 'Third'
        WHEN cd <= 0.80 THEN 'Fourth'
        ELSE 'Fifth'
    END AS Quintile
FROM Ranked
ORDER BY
    CASE                                 -- sort by quintile hierarchy
        WHEN cd <= 0.20 THEN 1
        WHEN cd <= 0.40 THEN 2
        WHEN cd <= 0.60 THEN 3
        WHEN cd <= 0.80 THEN 4
        ELSE 5
    END,
    LastName;
```
