```sql
-- 1) Identify the CategoryID used for English courses
SELECT DISTINCT "CategoryID", "CategoryDescription"
FROM "Categories"
WHERE "CategoryDescription" LIKE '%English%'
LIMIT 20;
```

```sql
-- 2) List all subjects that belong to the English category
SELECT DISTINCT "SubjectID", "SubjectCode", "SubjectName"
FROM "Subjects"
WHERE "CategoryID" = 'ENG'
LIMIT 20;
```

```sql
-- 3) Show every class (ClassID) that is an English class
SELECT DISTINCT "ClassID", "SubjectID"
FROM "Classes"
WHERE "SubjectID" IN (SELECT "SubjectID"
                      FROM "Subjects"
                      WHERE "CategoryID" = 'ENG')
LIMIT 20;
```

```sql
-- 4) Display completed (ClassStatus = 2) English classes with student grades
SELECT DISTINCT "StudentID", "ClassID", "Grade"
FROM "Student_Schedules"
WHERE "ClassStatus" = 2
  AND "ClassID" IN (SELECT DISTINCT "ClassID"
                    FROM "Classes"
                    WHERE "SubjectID" IN (SELECT "SubjectID"
                                          FROM "Subjects"
                                          WHERE "CategoryID" = 'ENG'))
LIMIT 20;
```

```sql
-- 5) Link those completed English course records to the students’ last names
SELECT DISTINCT ss."StudentID",
       st."StudLastName",
       ss."Grade"
FROM "Student_Schedules" AS ss
JOIN "Students"         AS st ON st."StudentID" = ss."StudentID"
WHERE ss."ClassStatus" = 2
  AND ss."ClassID" IN (SELECT "ClassID"
                       FROM "Classes"
                       WHERE "SubjectID" IN (SELECT "SubjectID"
                                             FROM "Subjects"
                                             WHERE "CategoryID" = 'ENG'))
LIMIT 20;
```

```sql
-- 6) Count how many distinct students completed at least one English class
SELECT COUNT(DISTINCT ss."StudentID") AS "Total_English_Students"
FROM "Student_Schedules" AS ss
WHERE ss."ClassStatus" = 2
  AND ss."ClassID" IN (SELECT "ClassID"
                       FROM "Classes"
                       WHERE "SubjectID" IN (SELECT "SubjectID"
                                             FROM "Subjects"
                                             WHERE "CategoryID" = 'ENG'));
```

```sql
-- 7) Rank each student within the English-completers group by DESC grade
--    (ties get the same rank); also compute the share rank / total
SELECT DISTINCT st."StudLastName",
       ss."Grade",
       RANK() OVER (ORDER BY ss."Grade" DESC)                                        AS "RankByGrade",
       (RANK() OVER (ORDER BY ss."Grade" DESC) * 1.0) /
       (SELECT COUNT(DISTINCT "StudentID")
        FROM "Student_Schedules"
        WHERE "ClassStatus" = 2
          AND "ClassID" IN (SELECT "ClassID"
                            FROM "Classes"
                            WHERE "SubjectID" IN (SELECT "SubjectID"
                                                  FROM "Subjects"
                                                  WHERE "CategoryID" = 'ENG')))      AS "RankShare"
FROM "Student_Schedules" AS ss
JOIN "Students"         AS st ON st."StudentID" = ss."StudentID"
WHERE ss."ClassStatus" = 2
  AND ss."ClassID" IN (SELECT "ClassID"
                       FROM "Classes"
                       WHERE "SubjectID" IN (SELECT "SubjectID"
                                             FROM "Subjects"
                                             WHERE "CategoryID" = 'ENG'))
LIMIT 20;
```

```sql
-- 8) FINAL: assign quintile labels using NTILE(5) and order from First to Fifth
SELECT "StudLastName" AS "StudentLastName",
       CASE nt WHEN 1 THEN 'First'
               WHEN 2 THEN 'Second'
               WHEN 3 THEN 'Third'
               WHEN 4 THEN 'Fourth'
               ELSE 'Fifth' END               AS "Quintile"
FROM (
    SELECT st."StudLastName",
           ss."Grade",
           NTILE(5) OVER (ORDER BY ss."Grade" DESC) AS nt
    FROM "Student_Schedules" AS ss
    JOIN "Students"         AS st ON st."StudentID" = ss."StudentID"
    WHERE ss."ClassStatus" = 2
      AND ss."ClassID" IN (SELECT "ClassID"
                           FROM "Classes"
                           WHERE "SubjectID" IN (SELECT "SubjectID"
                                                 FROM "Subjects"
                                                 WHERE "CategoryID" = 'ENG'))
) AS q
ORDER BY nt ASC;
```
