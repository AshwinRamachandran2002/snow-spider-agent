Query:
-- 8)  Count *on-track* overtakes (position improvement) for each of laps 1-5
SELECT  lp1."lap",
        COUNT(*) AS "overtakes_on_track"
FROM   "lap_positions" AS lp1
JOIN   "lap_positions" AS lp0
       ON lp1."race_id"  = lp0."race_id"
      AND lp1."driver_id"= lp0."driver_id"
      AND lp1."lap"      = lp0."lap" + 1
WHERE  lp1."lap" BETWEEN 1 AND 5          -- only laps 1-5
  AND  lp1."position" < lp0."position"    -- position improved
GROUP BY lp1."lap"
ORDER BY lp1."lap";
