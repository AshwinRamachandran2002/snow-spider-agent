Query:
-- 9)  Split the lap-1 gains into “start-related” (grid vs lap1) 
--     to get the total number of such overtakes
SELECT COUNT(*) AS "start_related_overtakes"
FROM (
      SELECT 1
      FROM "lap_positions" AS p0
      JOIN "lap_positions" AS p1
         ON p0."race_id" = p1."race_id"
        AND p0."driver_id" = p1."driver_id"
      WHERE p0."lap" = 0
        AND p1."lap" = 1
        AND p1."position" < p0."position"   -- position improved immediately
     );
Answer:
start_related_overtakes
6338
Query:
--10)  List every instance where a driver that made a lap≤5 pit-stop 
--     lost a place immediately (lap of stop → next lap), an indicator of pit-stop overtakes
SELECT  ps."race_id",
        ps."driver_id",
        ps."lap" AS "pit_lap",
        lp_next."position" - lp_before."position" AS "places_lost"
FROM "pit_stops" AS ps
JOIN "lap_positions" AS lp_before
      ON lp_before."race_id" = ps."race_id"
     AND lp_before."driver_id" = ps."driver_id"
     AND lp_before."lap" = ps."lap"               -- position *on* the pit-lap
JOIN "lap_positions" AS lp_next
      ON lp_next."race_id" = ps."race_id"
     AND lp_next."driver_id" = ps."driver_id"
     AND lp_next."lap" = ps."lap" + 1             -- position next lap
WHERE ps."lap" <= 5
  AND lp_next."position" > lp_before."position"   -- driver lost positions ⇒ others gained
LIMIT 20;
