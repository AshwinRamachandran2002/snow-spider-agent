```sql
-- 1)  See the kinds of “laps” that are recorded
SELECT DISTINCT "lap_type"
FROM "lap_positions"
LIMIT 20;
```

```sql
-- 2)  Show every driver’s position for the formation grid (lap 0) 
--     and the first five race laps for a quick visual check
SELECT *
FROM "lap_positions"
WHERE "lap" BETWEEN 0 AND 5
ORDER BY "race_id", "driver_id", "lap"
LIMIT 20;
```

```sql
-- 3)  Inspect retirements that happened in the first five laps
SELECT *
FROM "retirements"
WHERE "lap" <= 5
LIMIT 20;
```

```sql
-- 4)  How many retirements occurred in those first five laps?
SELECT COUNT(*) AS "retirements_first_5_laps"
FROM "retirements"
WHERE "lap" <= 5;
```

```sql
-- 5)  Look at all pit-stops made during the first five laps
SELECT *
FROM "pit_stops"
WHERE "lap" <= 5
ORDER BY "race_id", "lap"
LIMIT 20;
```

```sql
-- 6)  How many pit-stops were made in laps 1-5?
SELECT COUNT(*) AS "pit_stops_first_5_laps"
FROM "pit_stops"
WHERE "lap" <= 5;
```

```sql
-- 7)  Compare grid position (lap 0) with position after lap 1 to gauge start-related changes
SELECT  p0."race_id",
        p0."driver_id",
        p0."position"  AS "grid_position",
        p1."position"  AS "lap1_position",
        (p0."position" - p1."position") AS "places_gained_on_start"
FROM "lap_positions" AS p0
JOIN "lap_positions" AS p1
      ON p0."race_id" = p1."race_id"
     AND p0."driver_id" = p1."driver_id"
WHERE p0."lap" = 0
  AND p1."lap" = 1
LIMIT 20;
```

```sql
-- 8)  Count *on-track* overtakes (position improvement) for each of laps 1-5
SELECT  lp1."lap",
        COUNT(*) AS "overtakes_on_track"
FROM   "lap_positions" AS lp1
JOIN   "lap_positions" AS lp0
       ON lp1."race_id"  = lp0."race_id"
      AND lp1."driver_id"= lp0."driver_id"
      AND lp1."lap"      = lp0."lap" + 1
WHERE  lp1."lap" BETWEEN 1 AND 5          -- only laps 1-5
  AND  lp1."position" < lp0."position"    -- position improved
GROUP BY lp1."lap"
ORDER BY lp1."lap";
```

```sql
-- 9)  Split the lap-1 gains into “start-related” (grid vs lap1) 
--     to get the total number of such overtakes
SELECT COUNT(*) AS "start_related_overtakes"
FROM (
      SELECT 1
      FROM "lap_positions" AS p0
      JOIN "lap_positions" AS p1
         ON p0."race_id" = p1."race_id"
        AND p0."driver_id" = p1."driver_id"
      WHERE p0."lap" = 0
        AND p1."lap" = 1
        AND p1."position" < p0."position"   -- position improved immediately
     );
```

```sql
--10)  List every instance where a driver that made a lap≤5 pit-stop 
--     lost a place immediately (lap of stop → next lap), an indicator of pit-stop overtakes
SELECT  ps."race_id",
        ps."driver_id",
        ps."lap" AS "pit_lap",
        lp_next."position" - lp_before."position" AS "places_lost"
FROM "pit_stops" AS ps
JOIN "lap_positions" AS lp_before
      ON lp_before."race_id" = ps."race_id"
     AND lp_before."driver_id" = ps."driver_id"
     AND lp_before."lap" = ps."lap"               -- position *on* the pit-lap
JOIN "lap_positions" AS lp_next
      ON lp_next."race_id" = ps."race_id"
     AND lp_next."driver_id" = ps."driver_id"
     AND lp_next."lap" = ps."lap" + 1             -- position next lap
WHERE ps."lap" <= 5
  AND lp_next."position" > lp_before."position"   -- driver lost positions ⇒ others gained
LIMIT 20;
```

These nine exploratory queries give you all the raw counts needed to categorise first-five-lap overtakes into:  
• retirements (queries 3-4)  
• pit-stops (queries 5-6 & 10)  
• start-related (queries 7 & 9)  
• standard on-track passes (query 8 minus pit-stop- and retirement-related gains).
