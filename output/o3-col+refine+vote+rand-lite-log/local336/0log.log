```sql
--Description: Look at the different kinds of “lap_type” values recorded,
--             so we know how the data distinguishes grid, race, etc.
SELECT DISTINCT "lap_type"
FROM "lap_positions"
LIMIT 20;
```

```sql
--Description: Inspect every driver’s position changes in the first-five laps
--             of one sample race (here race_id = 1) – this lets us see
--             which cars gained or lost places lap-by-lap.
SELECT  "race_id",
        "driver_id",
        "lap",
        "position",
        "lap_type"
FROM    "lap_positions"
WHERE   "race_id" = 1
  AND   "lap"    <= 5
ORDER BY "lap", "position"
LIMIT 20;
```

```sql
--Description: Find retirements that happened in the first five laps
--             (retirements create “free” overtakes for every car behind).
SELECT  "race_id",
        "driver_id",
        "lap",
        "retirement_type"
FROM    "retirements"
WHERE   "lap" <= 5
  AND   "race_id" = 1
LIMIT 20;
```

```sql
--Description: List all pit-stops performed in the opening five laps
--             – these usually trigger position changes in the next sector.
SELECT  "race_id",
        "driver_id",
        "stop",
        "lap",
        "time",
        "duration"
FROM    "pit_stops"
WHERE   "race_id" = 1
  AND   "lap" <= 5
LIMIT 20;
```

```sql
--Description: Detect start-related overtakes: drivers whose position on
--             lap-1 is better (smaller number) than on the starting grid
--             (lap-0) for race_id = 1.
SELECT  lp0."driver_id",
        lp0."position" AS "grid_pos",
        lp1."position" AS "lap1_pos"
FROM    "lap_positions" AS lp0
JOIN    "lap_positions" AS lp1
          ON lp0."race_id"  = lp1."race_id"
         AND lp0."driver_id" = lp1."driver_id"
WHERE   lp0."race_id" = 1
  AND   lp0."lap"  = 0      -- grid
  AND   lp1."lap"  = 1      -- first racing lap
  AND   lp1."position" < lp0."position"   -- improved
LIMIT 20;
```

```sql
--Description: Quick view of every car that made a pit-stop in laps 1-5
--             (distinct list, one row per driver).
SELECT DISTINCT "driver_id"
FROM   "pit_stops"
WHERE  "race_id" = 1
  AND  "lap" <= 5
LIMIT 20;
```

```sql
--Description: Overtakes caused by retirements – just list the drivers who
--             retired in the opening five laps (each one hands a place to
--             every car behind).
SELECT DISTINCT "driver_id"
FROM   "retirements"
WHERE  "race_id" = 1
  AND  "lap" <= 5
LIMIT 20;
```

```sql
--Description: Standard on-track passes: positions gained between any two
--             consecutive laps inside laps 1-5, ignoring the grid (lap-0).
SELECT  lp_curr."driver_id",
        lp_prev."lap"       AS "prev_lap",
        lp_prev."position"  AS "prev_pos",
        lp_curr."position"  AS "curr_pos"
FROM    "lap_positions" AS lp_prev
JOIN    "lap_positions" AS lp_curr
          ON lp_prev."race_id"  = lp_curr."race_id"
         AND lp_prev."driver_id" = lp_curr."driver_id"
         AND lp_curr."lap"       = lp_prev."lap" + 1
WHERE   lp_curr."race_id" = 1
  AND   lp_curr."lap" BETWEEN 1 AND 5
  AND   lp_curr."position" < lp_prev."position"
LIMIT 20;
```

```sql
--Description: Pull everything together – a quick count of overtakes in each
--             category during the first five laps of race_id = 1.
SELECT
  (SELECT COUNT(*)               -- every retirement counts as one “event”
     FROM "retirements"
     WHERE "race_id" = 1 AND "lap" <= 5)                             AS "retirement_overtakes",
  (SELECT COUNT(*)               -- every pit-stop counts as one “event”
     FROM "pit_stops"
     WHERE "race_id" = 1 AND "lap" <= 5)                             AS "pit_stop_overtakes",
  (SELECT COUNT(*)               -- start-moves (lap-0  →  lap-1)
     FROM "lap_positions" lp0
     JOIN "lap_positions" lp1
       ON lp0."race_id"  = lp1."race_id"
      AND lp0."driver_id" = lp1."driver_id"
    WHERE lp0."race_id" = 1
      AND lp0."lap" = 0
      AND lp1."lap" = 1
      AND lp1."position" < lp0."position")                          AS "start_related_overtakes",
  (SELECT COUNT(*)               -- pure on-track passes laps 1-5
     FROM "lap_positions" lp_prev
     JOIN "lap_positions" lp_curr
       ON lp_prev."race_id"  = lp_curr."race_id"
      AND lp_prev."driver_id" = lp_curr."driver_id"
      AND lp_curr."lap"       = lp_prev."lap" + 1
    WHERE lp_prev."race_id" = 1
      AND lp_prev."lap" BETWEEN 1 AND 4
      AND lp_curr."lap" BETWEEN 2 AND 5
      AND lp_curr."position" < lp_prev."position")                  AS "standard_overtakes";
```
