Query:
--Description: Find retirements that happened in the first five laps
--             (retirements create “free” overtakes for every car behind).
SELECT  "race_id",
        "driver_id",
        "lap",
        "retirement_type"
FROM    "retirements"
WHERE   "lap" <= 5
  AND   "race_id" = 1
LIMIT 20;
Answer:
race_id,driver_id,lap,retirement_type
1,5,1,Retirement (Driver Error)
Query:
--Description: Detect start-related overtakes: drivers whose position on
--             lap-1 is better (smaller number) than on the starting grid
--             (lap-0) for race_id = 1.
SELECT  lp0."driver_id",
        lp0."position" AS "grid_pos",
        lp1."position" AS "lap1_pos"
FROM    "lap_positions" AS lp0
JOIN    "lap_positions" AS lp1
          ON lp0."race_id"   = lp1."race_id"
         AND lp0."driver_id" = lp1."driver_id"
WHERE   lp0."race_id" = 1
  AND   lp0."lap"  = 0          -- grid
  AND   lp1."lap"  = 1          -- first racing lap
  AND   lp1."position" < lp0."position"   -- improved
LIMIT 20
Answer:
driver_id,grid_pos,lap1_pos
1,18,13
