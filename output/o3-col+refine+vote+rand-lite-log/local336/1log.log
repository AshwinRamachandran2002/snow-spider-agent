           CASE
                WHEN EXISTS (SELECT 1
                             FROM   ret_laps r
                             WHERE  r."race_id" = g."race_id"
                               AND  r."lap"      = g."lap")        THEN 'retirement'
                WHEN EXISTS (SELECT 1
                             FROM   pit_laps p
                             WHERE  p."race_id" = g."race_id"
                               AND  p."lap"      = g."lap")        THEN 'pit_stop'
                WHEN g.base_cat = 'start'                          THEN 'start'
                ELSE 'on_track'
           END AS category
    FROM   gains g
)
SELECT category,
       COUNT(*) AS overtakes
FROM   classified
GROUP  BY category
ORDER  BY category;
