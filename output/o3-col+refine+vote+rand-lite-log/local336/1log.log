Query:
-- 8) How many drivers gained places between the grid and the end of lap-1 (start related overtakes)?
SELECT COUNT(*) AS "start_overtakes"
FROM   (
        SELECT lp."race_id",
               lp."driver_id"
        FROM   "lap_positions" AS lp
        JOIN   "lap_positions" AS st          -- grid (lap 0)
               ON st."race_id"  = lp."race_id"
              AND st."driver_id" = lp."driver_id"
              AND st."lap_type"  LIKE 'Starting%'
        WHERE  lp."lap_type" = 'Race'
          AND  lp."lap"      = 1
          AND  lp."position" < st."position"  -- position improved
       );
Answer:
start_overtakes
5111
Query:
-- 9) Total number of position-gains (any kind of overtake) in laps 1-5
WITH race_pos AS (
     SELECT "race_id",
            "driver_id",
            "lap",
            "position",
            LAG("position") OVER (PARTITION BY "race_id","driver_id" ORDER BY "lap") AS prev_pos
     FROM   "lap_positions"
     WHERE  "lap_type"='Race'
       AND  "lap" BETWEEN 1 AND 5
)
SELECT COUNT(*) AS "all_position_gains_laps_1_to_5"
FROM   race_pos
WHERE  prev_pos IS NOT NULL
  AND  "position" < prev_pos;   -- driver moved forward
Answer:
all_position_gains_laps_1_to_5
4749
Query:
-- 10) Classify every forward-move in laps 1-5 as
--     'retirement', 'pit_stop', 'start', or 'on_track',
--     and count how many overtakes belong to each category
WITH grid AS (
     SELECT "race_id","driver_id","position" AS grid_pos
     FROM   "lap_positions"
     WHERE  "lap_type" LIKE 'Starting%'
),
race_laps AS (
     SELECT "race_id","driver_id","lap","position"
     FROM   "lap_positions"
     WHERE  "lap_type"='Race' AND "lap" BETWEEN 1 AND 5
),
pos_changes AS (
     SELECT rl.*,
            LAG("position") OVER (PARTITION BY "race_id","driver_id" ORDER BY "lap") AS prev_pos,
            g.grid_pos
     FROM   race_laps rl
     JOIN   grid     g USING ("race_id","driver_id")
),
gains AS (
     -- records where the driver actually gained places
     SELECT "race_id","driver_id","lap",
            CASE
                 WHEN "lap" = 1 AND "position" < grid_pos           THEN 'start'
                 ELSE 'provisional'
            END AS base_cat
     FROM   pos_changes
     WHERE  (("lap" = 1  AND "position" < grid_pos)  -- start gain
          OR ("lap" > 1  AND "position" < prev_pos)) -- later gain
),
pit AS (
     SELECT DISTINCT "race_id","lap"
     FROM   "pit_stops"
     WHERE  "lap" <= 5
),
ret AS (
     SELECT DISTINCT "race_id","lap"
     FROM   "retirements"
     WHERE  "lap" <= 5
),
classified AS (
     SELECT g.*,
            CASE
               WHEN EXISTS (SELECT 1 FROM ret r WHERE r."race_id"=g."race_id" AND r."lap"=g."lap")
                    THEN 'retirement'
               WHEN EXISTS (SELECT 1 FROM pit p WHERE p."race_id"=g."race_id" AND p."lap"=g."lap")
                    THEN 'pit_stop'
               WHEN g.base_cat='start' THEN 'start'
               ELSE 'on_track'
            END AS final_category
     FROM   gains g
)
SELECT final_category AS category,
       COUNT(*)      AS overtakes
FROM   classified
GROUP  BY final_category
ORDER  BY category;
Answer:
category,overtakes
on_track,2945
pit_stop,1367
retirement,3568
start,1980
