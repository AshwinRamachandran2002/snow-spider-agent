Query:
--Description: Build a cleaned list of (actor PID, appearance year) pairs,
--trimming the leading spaces that exist in "M_Cast"."PID".  
--Shows 20 rows so we can verify the fix.
WITH actor_years AS (
  SELECT DISTINCT TRIM(mc."PID")            AS "PID",
         CAST(m."year" AS INTEGER)          AS "yr"
  FROM   "M_Cast"  AS mc
  JOIN   "Movie"   AS m  ON m."MID" = mc."MID"
)
SELECT *
FROM   actor_years
ORDER BY "PID", "yr"
LIMIT 20
