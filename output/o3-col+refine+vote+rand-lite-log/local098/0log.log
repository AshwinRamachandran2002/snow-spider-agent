```sql
--Description: Preview a few people (actors) available in the database.
SELECT DISTINCT "PID", TRIM("Name") AS "actor_name", "Gender"
FROM "Person"
LIMIT 20;
```

```sql
--Description: List distinct (actor, movie, year) combinations to see how the
--raw information we will use looks like.
SELECT DISTINCT mc."PID",
       TRIM(p."Name")            AS "actor_name",
       mc."MID",
       m."title",
       CAST(m."year" AS INTEGER) AS "year"
FROM   "M_Cast"  AS mc
JOIN   "Movie"   AS m ON m."MID" = mc."MID"
JOIN   "Person"  AS p ON p."PID" = mc."PID"
ORDER  BY mc."PID", m."year"
LIMIT 20;
```

```sql
--Description: For every actor gather the set of distinct calendar years in
--which (s)he had at least one appearance.
WITH actor_years AS (
  SELECT DISTINCT mc."PID",
         CAST(m."year" AS INTEGER) AS "yr"
  FROM   "M_Cast" AS mc
  JOIN   "Movie"  AS m ON m."MID" = mc."MID"
)
SELECT *
FROM   actor_years
ORDER  BY "PID", "yr"
LIMIT 20;
```

```sql
--Description: Compute, for every actor, the distance (in years) to the
--previous movie year using the window-function LAG.
WITH actor_years AS (
  SELECT DISTINCT mc."PID",
         CAST(m."year" AS INTEGER) AS "yr"
  FROM   "M_Cast" AS mc
  JOIN   "Movie"  AS m ON m."MID" = mc."MID"
),
year_gaps AS (
  SELECT "PID",
         "yr",
         LAG("yr") OVER (PARTITION BY "PID" ORDER BY "yr") AS "prev_yr",
         CASE
           WHEN LAG("yr") OVER (PARTITION BY "PID" ORDER BY "yr") IS NULL
                THEN NULL
           ELSE "yr" - LAG("yr") OVER (PARTITION BY "PID" ORDER BY "yr")
         END                                             AS "gap"
  FROM   actor_years
)
SELECT *
FROM   year_gaps
ORDER  BY "PID", "yr"
LIMIT 20;
```

```sql
--Description: Identify “bad” actors – those who experienced a gap strictly
--longer than 3 years (i.e. a first gap of at least 4 years).
WITH actor_years AS (
  SELECT DISTINCT mc."PID",
         CAST(m."year" AS INTEGER) AS "yr"
  FROM   "M_Cast" AS mc
  JOIN   "Movie"  AS m ON m."MID" = mc."MID"
),
year_gaps AS (
  SELECT "PID",
         "yr",
         LAG("yr") OVER (PARTITION BY "PID" ORDER BY "yr") AS "prev_yr"
  FROM   actor_years
)
SELECT DISTINCT "PID"
FROM   year_gaps
WHERE  "prev_yr" IS NOT NULL
   AND ("yr" - "prev_yr") > 3
LIMIT 20;
```

```sql
--Description: Collect “good” actors – those who never had a gap over
--three years – by excluding every bad actor found above.
WITH actor_years AS (
  SELECT DISTINCT mc."PID",
         CAST(m."year" AS INTEGER) AS "yr"
  FROM   "M_Cast" AS mc
  JOIN   "Movie"  AS m ON m."MID" = mc."MID"
),
year_gaps AS (
  SELECT "PID",
         "yr",
         LAG("yr") OVER (PARTITION BY "PID" ORDER BY "yr") AS "prev_yr"
  FROM   actor_years
),
bad_actors AS (
  SELECT DISTINCT "PID"
  FROM   year_gaps
  WHERE  "prev_yr" IS NOT NULL
     AND ("yr" - "prev_yr") > 3
)
SELECT DISTINCT "PID"
FROM   actor_years
WHERE  "PID" NOT IN (SELECT "PID" FROM bad_actors)
LIMIT 20;
```

```sql
--Description: Finally, count how many actors satisfy the requested
--condition (no gap longer than 3 years anywhere in their career).
WITH actor_years AS (
  SELECT DISTINCT mc."PID",
         CAST(m."year" AS INTEGER) AS "yr"
  FROM   "M_Cast" AS mc
  JOIN   "Movie"  AS m ON m."MID" = mc."MID"
),
year_gaps AS (
  SELECT "PID",
         "yr",
         LAG("yr") OVER (PARTITION BY "PID" ORDER BY "yr") AS "prev_yr"
  FROM   actor_years
),
bad_actors AS (
  SELECT DISTINCT "PID"
  FROM   year_gaps
  WHERE  "prev_yr" IS NOT NULL
     AND ("yr" - "prev_yr") > 3
),
good_actors AS (
  SELECT DISTINCT "PID"
  FROM   actor_years
  WHERE  "PID" NOT IN (SELECT "PID" FROM bad_actors)
)
SELECT COUNT(*) AS "actors_without_4_year_gaps"
FROM   good_actors;
```

The last query returns the required single number: the count of actors whose entire span of movie appearances contains no four-year window without at least one film credit.
