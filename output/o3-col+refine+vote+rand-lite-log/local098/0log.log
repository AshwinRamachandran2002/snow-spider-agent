Query:
--Description: List “good” actors—those who never experienced any gap longer
--than 3 years—by excluding the bad actors identified above. Show 20 PIDs.
WITH actor_years AS (
  SELECT DISTINCT TRIM(mc."PID")            AS "PID",
         CAST(m."year" AS INTEGER)          AS "yr"
  FROM   "M_Cast"  AS mc
  JOIN   "Movie"   AS m  ON m."MID" = mc."MID"
),
year_gaps AS (
  SELECT "PID",
         "yr",
         LAG("yr") OVER (PARTITION BY "PID" ORDER BY "yr") AS "prev_yr"
  FROM   actor_years
),
bad_actors AS (
  SELECT DISTINCT "PID"
  FROM   year_gaps
  WHERE  "prev_yr" IS NOT NULL
     AND ("yr" - "prev_yr") > 3
)
SELECT DISTINCT "PID"
FROM   actor_years
WHERE  "PID" NOT IN (SELECT "PID" FROM bad_actors)
LIMIT 20
