Query:
--Description: Find “bad” actors who have any gap strictly greater than 3 years
--between consecutive appearances (i.e., at least a 4-year gap). Show 20 PIDs.
WITH actor_years AS (
  SELECT DISTINCT TRIM(mc."PID")            AS "PID",
         CAST(m."year" AS INTEGER)          AS "yr"
  FROM   "M_Cast"  AS mc
  JOIN   "Movie"   AS m  ON m."MID" = mc."MID"
),
year_gaps AS (
  SELECT "PID",
         "yr",
         LAG("yr") OVER (PARTITION BY "PID" ORDER BY "yr") AS "prev_yr"
  FROM   actor_years
)
SELECT DISTINCT "PID"
FROM   year_gaps
WHERE  "prev_yr" IS NOT NULL
   AND ("yr" - "prev_yr") > 3
LIMIT 20
