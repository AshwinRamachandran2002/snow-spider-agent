Query:
--Description: Using the cleaned actor-years list, compute the gap (yrs since
--previous credit) for every actor with LAG; display 20 rows.
WITH actor_years AS (
  SELECT DISTINCT TRIM(mc."PID")            AS "PID",
         CAST(m."year" AS INTEGER)          AS "yr"
  FROM   "M_Cast"  AS mc
  JOIN   "Movie"   AS m  ON m."MID" = mc."MID"
),
year_gaps AS (
  SELECT "PID",
         "yr",
         LAG("yr") OVER (PARTITION BY "PID" ORDER BY "yr")            AS "prev_yr",
         CASE
           WHEN LAG("yr") OVER (PARTITION BY "PID" ORDER BY "yr") IS NULL
                THEN NULL
           ELSE "yr" - LAG("yr") OVER (PARTITION BY "PID" ORDER BY "yr")
         END                                                          AS "gap"
  FROM   actor_years
)
SELECT *
FROM   year_gaps
ORDER BY "PID", "yr"
LIMIT 20
