Query:
--Description: 5) Build every actor’s ordered list of years and the gap to their next credit (PIDs trimmed)
WITH all_years AS (
     SELECT TRIM(mc."PID") AS PID,
            CAST(m."year" AS INTEGER) AS y
     FROM   "M_Cast" AS mc
     JOIN   "Movie"  AS m ON mc."MID" = m."MID"
     GROUP  BY PID, y
),
gaps AS (
     SELECT PID,
            y,
            LEAD(y) OVER (PARTITION BY PID ORDER BY y) AS next_y
     FROM   all_years
)
SELECT PID,
       y,
       next_y,
       (next_y - y) AS gap
FROM   gaps
WHERE  next_y IS NOT NULL
LIMIT 20
