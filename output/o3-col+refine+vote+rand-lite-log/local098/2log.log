Query:
--Description: 4) For that same actor, display each credited year, the next one, and the gap between them
WITH actor_years AS (
     SELECT CAST(m."year" AS INTEGER) AS y
     FROM   "M_Cast" AS mc
     JOIN   "Movie"  AS m ON mc."MID" = m."MID"
     WHERE  TRIM(mc."PID") = 'nm0000288'
     GROUP  BY y
)
SELECT y,
       LEAD(y) OVER (ORDER BY y)          AS next_y,
       (LEAD(y) OVER (ORDER BY y) - y)    AS gap
FROM   actor_years
ORDER  BY y
LIMIT 20
Answer:
