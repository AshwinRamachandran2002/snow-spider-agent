```sql
--Description:
-- Goal: count how many actors never experience a gap of 4 consecutive empty years
--       (i.e., no interval ≥ 5 between successive credited-movie years).
-- Steps (all in one CTE chain):
--   1. all_years – collect every distinct (actor, year) pair; TRIM is used
--      because PIDs in M_Cast contain leading spaces but Person.PID does not.
--   2. gaps      – within each actor’s timeline, compute the difference to the
--      next credited year via the LEAD window function.
--   3. bad_actors – actors having at least one gap where (next_year-year) > 4
--      (meaning ≥ 5, which leaves 4 full empty years in between).
--   4. good_actors – all actors minus those in bad_actors.
-- The final SELECT returns the desired count.
WITH all_years AS (
    SELECT TRIM(mc."PID")                         AS PID,
           CAST(m."year" AS INTEGER)              AS y
    FROM   "M_Cast"  AS mc
    JOIN   "Movie"   AS m ON mc."MID" = m."MID"
    GROUP  BY PID, y
),
gaps AS (
    SELECT PID,
           y,
           LEAD(y) OVER (PARTITION BY PID ORDER BY y) AS next_y
    FROM   all_years
),
bad_actors AS (
    SELECT DISTINCT PID
    FROM   gaps
    WHERE  (next_y - y) > 4          -- gap allows 4 empty years → disqualify
),
good_actors AS (
    SELECT DISTINCT PID
    FROM   all_years
    WHERE  PID NOT IN (SELECT PID FROM bad_actors)
)
SELECT COUNT(*) AS actors_without_4year_gap
FROM   good_actors;
```
