Query:
--Description: 9) FINAL ANSWER – count of actors who never have a four-year span without a movie credit
WITH all_years AS (
     SELECT TRIM(mc."PID") AS PID,
            CAST(m."year" AS INTEGER) AS y
     FROM   "M_Cast" AS mc
     JOIN   "Movie"  AS m ON mc."MID" = m."MID"
     GROUP  BY PID, y
),
gaps AS (
     SELECT PID,
            y,
            LEAD(y) OVER (PARTITION BY PID ORDER BY y) AS next_y
     FROM   all_years
),
bad_actors AS (
     SELECT DISTINCT PID
     FROM   gaps
     WHERE  (next_y - y) > 4          -- gap ≥ 5 years ⇒ 4 empty years
),
good_actors AS (
     SELECT DISTINCT PID
     FROM   all_years
     WHERE  PID NOT IN (SELECT PID FROM bad_actors)
)
SELECT COUNT(*) AS actors_without_long_gap
FROM   good_actors
