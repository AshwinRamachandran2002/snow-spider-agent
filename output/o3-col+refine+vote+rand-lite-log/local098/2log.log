```sql
--Description: 1) Take a quick look at the different years stored in the movies table
SELECT DISTINCT CAST("year" AS INTEGER) AS movie_year
FROM "Movie"
ORDER BY movie_year
LIMIT 20;
```

```sql
--Description: 2) See how an actor (cast) connects to a movie and its year
SELECT mc."PID",
       p."Name",
       m."title",
       CAST(m."year" AS INTEGER) AS movie_year
FROM   "M_Cast" AS mc
JOIN   "Movie"  AS m ON mc."MID" = m."MID"
JOIN   "Person" AS p ON mc."PID" = p."PID"
LIMIT 20;
```

```sql
--Description: 3) Pick one concrete actor and show all their distinct movie-years  
SELECT CAST(m."year" AS INTEGER) AS movie_year
FROM   "M_Cast" AS mc
JOIN   "Movie"  AS m ON mc."MID" = m."MID"
WHERE  mc."PID" = 'nm0000288'          -- Christian Bale in sample
GROUP  BY movie_year
ORDER  BY movie_year
LIMIT 20;
```

```sql
--Description: 4) For that same actor, show the “next year” and the year-gap between consecutive credits
WITH actor_years AS (
     SELECT CAST(m."year" AS INTEGER) AS y
     FROM   "M_Cast" AS mc
     JOIN   "Movie"  AS m ON mc."MID" = m."MID"
     WHERE  mc."PID" = 'nm0000288'
     GROUP  BY y
)
SELECT y,
       LEAD(y) OVER (ORDER BY y)          AS next_y,
       (LEAD(y) OVER (ORDER BY y) - y)    AS gap
FROM   actor_years
ORDER  BY y
LIMIT 20;
```

```sql
--Description: 5) Build every actor’s ordered list of years together with the gap to their next credit
WITH all_years AS (
     SELECT mc."PID",
            CAST(m."year" AS INTEGER) AS y
     FROM   "M_Cast" AS mc
     JOIN   "Movie"  AS m ON mc."MID" = m."MID"
     GROUP  BY mc."PID", y
),
gaps AS (
     SELECT "PID",
            y,
            LEAD(y) OVER (PARTITION BY "PID" ORDER BY y) AS next_y
     FROM   all_years
)
SELECT "PID",
       y,
       next_y,
       (next_y - y) AS gap
FROM   gaps
WHERE  next_y IS NOT NULL
LIMIT 20;
```

```sql
--Description: 6) List actors who HAVE a gap strictly larger than 4 years (i.e., 4-year span with no movie)
WITH all_years AS (
     SELECT mc."PID",
            CAST(m."year" AS INTEGER) AS y
     FROM   "M_Cast" AS mc
     JOIN   "Movie"  AS m ON mc."MID" = m."MID"
     GROUP  BY mc."PID", y
),
gaps AS (
     SELECT "PID",
            y,
            LEAD(y) OVER (PARTITION BY "PID" ORDER BY y) AS next_y
     FROM   all_years
)
SELECT DISTINCT "PID"
FROM   gaps
WHERE  (next_y - y) > 4
LIMIT 20;
```

```sql
--Description: 7) Count how many distinct actors exist in the database (baseline)
SELECT COUNT(DISTINCT "PID") AS total_actors
FROM   "M_Cast";
```

```sql
--Description: 8) Count how many actors have at least one BAD gap (>4 years)
WITH all_years AS (
     SELECT mc."PID",
            CAST(m."year" AS INTEGER) AS y
     FROM   "M_Cast" AS mc
     JOIN   "Movie"  AS m ON mc."MID" = m."MID"
     GROUP  BY mc."PID", y
),
gaps AS (
     SELECT "PID",
            y,
            LEAD(y) OVER (PARTITION BY "PID" ORDER BY y) AS next_y
     FROM   all_years
),
bad_actors AS (
     SELECT DISTINCT "PID"
     FROM   gaps
     WHERE  (next_y - y) > 4
)
SELECT COUNT(*) AS actors_with_bad_gap
FROM   bad_actors;
```

```sql
--Description: 9) FINAL ANSWER – actors who NEVER have a gap longer than 3 consecutive years  
WITH all_years AS (
     SELECT mc."PID",
            CAST(m."year" AS INTEGER) AS y
     FROM   "M_Cast" AS mc
     JOIN   "Movie"  AS m ON mc."MID" = m."MID"
     GROUP  BY mc."PID", y
),
gaps AS (
     SELECT "PID",
            y,
            LEAD(y) OVER (PARTITION BY "PID" ORDER BY y) AS next_y
     FROM   all_years
),
bad_actors AS (
     SELECT DISTINCT "PID"
     FROM   gaps
     WHERE  (next_y - y) > 4              -- gap of 4 empty years (difference >4) disqualifies
),
good_actors AS (
     SELECT DISTINCT "PID"
     FROM   "M_Cast"
     WHERE  "PID" NOT IN (SELECT "PID" FROM bad_actors)
)
SELECT COUNT(*) AS actors_without_long_gap
FROM   good_actors;
```

These nine queries progress from simple inspection to the final computation, culminating in the count of actors who never experience more than three consecutive movie-less years within their active careers.
