Query:
--Description: 8) Count how many actors have at least one gap exceeding four years
WITH all_years AS (
     SELECT TRIM(mc."PID") AS PID,
            CAST(m."year" AS INTEGER) AS y
     FROM   "M_Cast" AS mc
     JOIN   "Movie"  AS m ON mc."MID" = m."MID"
     GROUP  BY PID, y
),
gaps AS (
     SELECT PID,
            y,
            LEAD(y) OVER (PARTITION BY PID ORDER BY y) AS next_y
     FROM   all_years
),
bad_actors AS (
     SELECT DISTINCT PID
     FROM   gaps
     WHERE  (next_y - y) > 4
)
SELECT COUNT(*) AS actors_with_bad_gap
FROM   bad_actors
