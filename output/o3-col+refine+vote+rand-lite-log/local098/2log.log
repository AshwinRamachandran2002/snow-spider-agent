--Description: 6) List actors who have any gap strictly larger than four years between credits
WITH all_years AS (
     SELECT TRIM(mc."PID") AS PID,
            CAST(m."year" AS INTEGER) AS y
     FROM   "M_Cast" AS mc
     JOIN   "Movie"  AS m ON mc."MID" = m."MID"
     GROUP  BY PID, y
),
gaps AS (
     SELECT PID,
            y,
            LEAD(y) OVER (PARTITION BY PID ORDER BY y) AS next_y
     FROM   all_years
)
SELECT DISTINCT PID
FROM   gaps
WHERE  (next_y - y) > 4
LIMIT 20
