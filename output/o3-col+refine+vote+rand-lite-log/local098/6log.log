```sql
-- 1. Preview some cast records (actor–movie links)
SELECT DISTINCT "PID", "MID"
FROM "M_Cast"
LIMIT 20;
```

```sql
-- 2. Look at movies together with their release year
SELECT "MID", "title", "year"
FROM "Movie"
LIMIT 20;
```

```sql
-- 3. Join cast with movies to see for a few actors the years they appeared
SELECT mc."PID",
       m."title",
       m."year"
FROM   "M_Cast" AS mc
JOIN   "Movie"  AS m  ON m."MID" = mc."MID"
LIMIT 20;
```

```sql
-- 4. For each actor, list the DISTINCT years of activity (sample)
SELECT mc."PID",
       CAST(m."year" AS INTEGER) AS act_year
FROM   "M_Cast" AS mc
JOIN   "Movie"  AS m  ON m."MID" = mc."MID"
GROUP BY mc."PID", act_year
ORDER BY mc."PID", act_year
LIMIT 20;
```

```sql
-- 5. Compute the gap (current year – previous year) for every actor-year
WITH actor_years AS (
    SELECT mc."PID",
           CAST(m."year" AS INTEGER) AS act_year
    FROM   "M_Cast" AS mc
    JOIN   "Movie"  AS m  ON m."MID" = mc."MID"
    GROUP BY mc."PID", act_year
)
SELECT PID,
       act_year,
       LAG(act_year) OVER (PARTITION BY PID ORDER BY act_year) AS prev_year,
       act_year - LAG(act_year) OVER (PARTITION BY PID ORDER BY act_year) AS gap
FROM   actor_years
ORDER BY PID, act_year
LIMIT 20;
```

```sql
-- 6. Identify actors who HAVE at least one gap > 3 years (i.e., 4-year span with no film)
WITH actor_years AS (
    SELECT mc."PID",
           CAST(m."year" AS INTEGER) AS act_year
    FROM   "M_Cast" AS mc
    JOIN   "Movie"  AS m  ON m."MID" = mc."MID"
    GROUP BY mc."PID", act_year
),
gaps AS (
    SELECT PID,
           act_year,
           LAG(act_year) OVER (PARTITION BY PID ORDER BY act_year) AS prev_year
    FROM   actor_years
)
SELECT DISTINCT PID
FROM   gaps
WHERE  prev_year IS NOT NULL
  AND  act_year - prev_year > 3
LIMIT 20;
```

```sql
-- 7. FINAL ANSWER: count actors who NEVER have a ≥4-year gap in their active career
WITH actor_years AS (
    SELECT mc."PID",
           CAST(m."year" AS INTEGER) AS act_year
    FROM   "M_Cast" AS mc
    JOIN   "Movie"  AS m  ON m."MID" = mc."MID"
    GROUP BY mc."PID", act_year
),
gaps AS (
    SELECT PID,
           act_year,
           LAG(act_year) OVER (PARTITION BY PID ORDER BY act_year) AS prev_year
    FROM   actor_years
),
bad_actors AS (
    SELECT DISTINCT PID
    FROM   gaps
    WHERE  prev_year IS NOT NULL
      AND  act_year - prev_year > 3          -- gap ≥ 4 years
)
SELECT COUNT(DISTINCT PID) AS num_actors_no_long_gap
FROM   actor_years
WHERE  PID NOT IN (SELECT PID FROM bad_actors);
```
