WHERE   p.`evaluation_sequence_number` = 741468457290487   -- sample AZ 2018 eval
LIMIT   20;
```

```sql
-- 7. Compute **one state’s** forest- & timber-land acres (Arizona 2018)  
--    showing how the adjusted expansion acres are built.
WITH az_eval AS (
  SELECT  741468457290487 AS eval_seq     -- Arizona 2018 latest EXPCURR from query 3
), base AS (
  SELECT  p.`state_code`,
          c.`condition_status_code`,
          c.`reserved_status_code`,
          c.`site_productivity_class_code`,
          c.`proportion_basis`,
          c.`condition_proportion_unadjusted`,
          p.`expansion_factor`,
          p.`adjustment_factor_for_the_macroplot`,
          p.`adjustment_factor_for_the_subplot`
  FROM    `bigquery-public-data.usfs_fia.population` AS p
  JOIN    az_eval                                       ON p.`evaluation_sequence_number` = az_eval.eval_seq
  JOIN    `bigquery-public-data.usfs_fia.condition`  AS c ON c.`plot_sequence_number` = p.`plot_sequence_number`
)
SELECT  SUM(
          CASE 
            WHEN proportion_basis='MACR' 
                 AND adjustment_factor_for_the_macroplot>0 
            THEN expansion_factor*adjustment_factor_for_the_macroplot
            WHEN proportion_basis='SUBP'
                 AND adjustment_factor_for_the_subplot>0 
            THEN expansion_factor*adjustment_factor_for_the_subplot
            ELSE expansion_factor
          END * condition_proportion_unadjusted
        ) AS total_acres_all_conditions
FROM    base;
```

```sql
-- 8. Timberland acres per state for latest EXPCURR evaluations
WITH latest AS (
  -- Query 3 replicated
  SELECT  state_code, evaluation_sequence_number
  FROM  (
     SELECT ev.`state_code`,
            ev.`evaluation_sequence_number`,
            ev.`evaluation_identifier`,
            ROW_NUMBER() OVER (PARTITION BY ev.`state_code`
                               ORDER BY ev.`evaluation_identifier` DESC) AS rn
     FROM   `bigquery-public-data.usfs_fia.population_evaluation` ev
     JOIN   `bigquery-public-data.usfs_fia.population_evaluation_type` et
       ON   et.`evaluation_sequence_number` = ev.`evaluation_sequence_number`
     WHERE  et.`evaluation_type` = 'EXPCURR'
  )
  WHERE rn = 1
), timber AS (
  SELECT  l.state_code,
          SUM(
            CASE 
              WHEN c.`proportion_basis`='MACR' AND p.`adjustment_factor_for_the_macroplot`>0
                   THEN p.`expansion_factor` * p.`adjustment_factor_for_the_macroplot`
              WHEN c.`proportion_basis`='SUBP' AND p.`adjustment_factor_for_the_subplot`>0
                   THEN p.`expansion_factor` * p.`adjustment_factor_for_the_subplot`
              ELSE p.`expansion_factor`
            END * c.`condition_proportion_unadjusted`
          ) AS timber_acres
  FROM    latest l
  JOIN    `bigquery-public-data.usfs_fia.population`  p  ON p.`evaluation_sequence_number` = l.`evaluation_sequence_number`
  JOIN    `bigquery-public-data.usfs_fia.condition`   c  ON c.`plot_sequence_number`      = p.`plot_sequence_number`
  WHERE   c.`condition_status_code` = 1              -- forest land
      AND c.`reserved_status_code`  = 0
      AND c.`site_productivity_class_code` BETWEEN 1 AND 6   -- timberland
  GROUP BY l.state_code
)
SELECT *
FROM   timber
ORDER BY timber_acres DESC
LIMIT  5;
```

```sql
-- 9. Forestland acres per state for latest EXPCURR evaluations
WITH latest AS (
  SELECT  state_code, evaluation_sequence_number
  FROM  (
     SELECT ev.`state_code`,
            ev.`evaluation_sequence_number`,
            ev.`evaluation_identifier`,
            ROW_NUMBER() OVER (PARTITION BY ev.`state_code`
                               ORDER BY ev.`evaluation_identifier` DESC) AS rn
     FROM   `bigquery-public-data.usfs_fia.population_evaluation` ev
     JOIN   `bigquery-public-data.usfs_fia.population_evaluation_type` et
       ON   et.`evaluation_sequence_number` = ev.`evaluation_sequence_number`
     WHERE  et.`evaluation_type` = 'EXPCURR'
  )
  WHERE rn = 1
), forest AS (
  SELECT  l.state_code,
          SUM(
            CASE 
              WHEN c.`proportion_basis`='MACR' AND p.`adjustment_factor_for_the_macroplot`>0
                   THEN p.`expansion_factor` * p.`adjustment_factor_for_the_macroplot`
              WHEN c.`proportion_basis`='SUBP' AND p.`adjustment_factor_for_the_subplot`>0
                   THEN p.`expansion_factor` * p.`adjustment_factor_for_the_subplot`
              ELSE p.`expansion_factor`
            END * c.`condition_proportion_unadjusted`
          ) AS forest_acres
  FROM    latest l
  JOIN    `bigquery-public-data.usfs_fia.population`  p  ON p.`evaluation_sequence_number` = l.`evaluation_sequence_number`
  JOIN    `bigquery-public-data.usfs_fia.condition`   c  ON c.`plot_sequence_number`      = p.`plot_sequence_number`
  WHERE   c.`condition_status_code` = 1        -- forest land (no other timberland filters)
  GROUP BY l.state_code
)
SELECT *
FROM   forest
ORDER BY forest_acres DESC
LIMIT  5;
```

```sql
-- 10. Combine timberland & forestland winners: state code, evaluation_group, state name & acres
WITH latest AS (
  SELECT  ev.`state_code`,
          ev.`evaluation_sequence_number`,
          peg.`evaluation_group`,
          peg.`evaluation_group_description`
  FROM (
     SELECT ev.`state_code`,
            ev.`evaluation_sequence_number`,
            ROW_NUMBER() OVER (PARTITION BY ev.`state_code`
                               ORDER BY ev.`evaluation_identifier` DESC) AS rn
     FROM   `bigquery-public-data.usfs_fia.population_evaluation` ev
     JOIN   `bigquery-public-data.usfs_fia.population_evaluation_type` et
       ON   et.`evaluation_sequence_number` = ev.`evaluation_sequence_number`
     WHERE  et.`evaluation_type` = 'EXPCURR'
  ) ev
  JOIN `bigquery-public-data.usfs_fia.population_evaluation_group` peg
    ON peg.`evaluation_group_sequence_number` = ev.`evaluation_group_sequence_number`
  WHERE ev.rn = 1
), acres AS (
  SELECT  l.state_code,
          l.evaluation_group,
          MAX(CASE WHEN tag='timber' THEN acres END)  AS timber_acres,
          MAX(CASE WHEN tag='forest' THEN acres END)  AS forest_acres
  FROM (
     -- timberland calc
     SELECT  l.state_code, l.evaluation_group, 'timber' AS tag,
             SUM(
               CASE 
                 WHEN c.`proportion_basis`='MACR' AND p.`adjustment_factor_for_the_macroplot`>0
                      THEN p.`expansion_factor` * p.`adjustment_factor_for_the_macroplot`
                 WHEN c.`proportion_basis`='SUBP' AND p.`adjustment_factor_for_the_subplot`>0
                      THEN p.`expansion_factor` * p.`adjustment_factor_for_the_subplot`
                 ELSE p.`expansion_factor`
               END * c.`condition_proportion_unadjusted`
             ) AS acres
     FROM    latest l
     JOIN    `bigquery-public-data.usfs_fia.population`  p  ON p.`evaluation_sequence_number` = l.`evaluation_sequence_number`
     JOIN    `bigquery-public-data.usfs_fia.condition`   c  ON c.`plot_sequence_number`      = p.`plot_sequence_number`
     WHERE   c.`condition_status_code` = 1 
         AND c.`reserved_status_code`  = 0
         AND c.`site_productivity_class_code` BETWEEN 1 AND 6
     GROUP BY l.state_code, l.evaluation_group
     UNION ALL
     -- forestland calc
     SELECT  l.state_code, l.evaluation_group, 'forest' AS tag,
             SUM(
               CASE 
                 WHEN c.`proportion_basis`='MACR' AND p.`adjustment_factor_for_the_macroplot`>0
                      THEN p.`expansion_factor` * p.`adjustment_factor_for_the_macroplot`
                 WHEN c.`proportion_basis`='SUBP' AND p.`adjustment_factor_for_the_subplot`>0
                      THEN p.`expansion_factor` * p.`adjustment_factor_for_the_subplot`
                 ELSE p.`expansion_factor`
               END * c.`condition_proportion_unadjusted`
             ) AS acres
     FROM    latest l
     JOIN    `bigquery-public-data.usfs_fia.population`  p  ON p.`evaluation_sequence_number` = l.`evaluation_sequence_number`
     JOIN    `bigquery-public-data.usfs_fia.condition`   c  ON c.`plot_sequence_number`      = p.`plot_sequence_number`
     WHERE   c.`condition_status_code` = 1
     GROUP BY l.state_code, l.evaluation_group
  ) 
  GROUP BY l.state_code, l.evaluation_group
)
-- pick the max for each category
SELECT  'Timberland' AS category,
        (SELECT AS STRUCT state_code, evaluation_group, timber_acres
         FROM   acres
         ORDER  BY timber_acres DESC
         LIMIT  1)  AS top_state
UNION ALL
SELECT  'Forestland',
        (SELECT AS STRUCT state_code, evaluation_group, forest_acres
         FROM   acres
         ORDER  BY forest_acres DESC
         LIMIT  1);
```
