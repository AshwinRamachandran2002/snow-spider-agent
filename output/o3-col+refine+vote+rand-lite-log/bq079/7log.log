```sql
-- 6. One joined sample of population (which already glues stratum / evaluation / unit)
--    with condition to see how the key fields relate and what data look like.
SELECT  p.`state_code`,
        p.`evaluation_sequence_number`,
        c.`proportion_basis`,
        c.`condition_proportion_unadjusted`,
        p.`expansion_factor`,
