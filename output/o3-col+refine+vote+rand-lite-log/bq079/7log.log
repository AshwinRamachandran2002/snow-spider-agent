Query:
-- 2. All evaluation–type records that are “EXPCURR” (Current estimates)  
--    together with their associated evaluation (to get state & report-year span)
SELECT  et.`evaluation_sequence_number`,
        ev.`evaluation_identifier`,
        ev.`state_code`,
        ev.`report_year_name`
FROM    `bigquery-public-data.usfs_fia.population_evaluation_type` AS et
JOIN    `bigquery-public-data.usfs_fia.population_evaluation`      AS ev
ON      ev.`evaluation_sequence_number` = et.`evaluation_sequence_number`
WHERE   et.`evaluation_type` = 'EXPCURR'
ORDER BY ev.`state_code`, ev.`evaluation_identifier`;
Answer:
evaluation_sequence_number,evaluation_identifier,state_code,report_year_name
254841395010854,10001,1,2000
254841397010854,10101,1,2000;2001
254841399010854,10201,1,2000;2001;2002
254841401010854,10301,1,2000;2001;2002;2003
Query:
-- 3. Latest EXPCURR evaluation-sequence per state  
--    (latest = greatest evaluation_identifier for that state)
WITH expcurr AS (
  SELECT ev.`state_code`,
         ev.`evaluation_sequence_number`,
         ev.`evaluation_identifier`,
         ROW_NUMBER() OVER (PARTITION BY ev.`state_code`
                            ORDER BY ev.`evaluation_identifier` DESC) AS rn
  FROM   `bigquery-public-data.usfs_fia.population_evaluation`      ev
  JOIN   `bigquery-public-data.usfs_fia.population_evaluation_type` et
  ON     et.`evaluation_sequence_number` = ev.`evaluation_sequence_number`
  WHERE  et.`evaluation_type` = 'EXPCURR'
)
SELECT *
FROM   expcurr
WHERE  rn = 1
ORDER  BY `state_code`;
