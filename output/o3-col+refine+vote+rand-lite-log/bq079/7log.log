```sql
--Description:
-- Goal:  Show the one state that (in its most-recent EXPCURR evaluation) has the
--        greatest total TIMBER-land acres and the one state that has the greatest
--        total FOREST-land acres.
-- Method outline
--   1. latest_eval  – for every state pick the newest evaluation whose type =
--      'EXPCURR'.  Keep its evaluation_sequence_number and the associated
--      evaluation_group_sequence_number.
--   2. latest_state – attach the numeric evaluation_group so we can report it.
--   3. timber / forest – join those latest evaluations to POPULATION (gives
--      expansion & adjustment factors) and CONDITION (gives filters).  Convert
--      each condition to acres:
--          expansion_factor *
--          CASE MACR/SUBP -> apply macroplot or subplot adjustment if >0
--          × condition_proportion_unadjusted
--      Apply filters:
--          • timber: condition_status=1, reserved_status=0, SPC 1-6
--          • forest: condition_status=1
--   4. combined – one row per state with both timber_acres and forest_acres.
--   5. Return two records – the max-acre state for each category.
WITH latest_eval AS (      -- newest EXPCURR evaluation per state
  SELECT ev.state_code,
         ev.location_name                       AS state_name,
         ev.evaluation_sequence_number,
         ev.evaluation_group_sequence_number,
         ROW_NUMBER() OVER (PARTITION BY ev.state_code
                            ORDER BY ev.evaluation_identifier DESC) AS rn
  FROM `bigquery-public-data.usfs_fia.population_evaluation`        ev
  JOIN `bigquery-public-data.usfs_fia.population_evaluation_type`   et
    ON  et.evaluation_sequence_number = ev.evaluation_sequence_number
  WHERE et.evaluation_type = 'EXPCURR'
),
latest_state AS (          -- keep only the latest evaluation per state
  SELECT le.state_code,
         le.state_name,
         le.evaluation_sequence_number,
         peg.evaluation_group
  FROM   latest_eval le
  JOIN   `bigquery-public-data.usfs_fia.population_evaluation_group` peg
    ON   peg.evaluation_group_sequence_number = le.evaluation_group_sequence_number
  WHERE  le.rn = 1
),
timber AS (                 -- timber-land acres
  SELECT ls.state_code,
         ls.state_name,
         ls.evaluation_group,
         SUM(
           CASE
             WHEN c.proportion_basis = 'MACR'
                  AND p.adjustment_factor_for_the_macroplot > 0
             THEN p.expansion_factor * p.adjustment_factor_for_the_macroplot
             WHEN c.proportion_basis = 'SUBP'
                  AND p.adjustment_factor_for_the_subplot  > 0
             THEN p.expansion_factor * p.adjustment_factor_for_the_subplot
             ELSE p.expansion_factor
           END * c.condition_proportion_unadjusted
         ) AS timber_acres
  FROM   latest_state ls
  JOIN   `bigquery-public-data.usfs_fia.population` p
         ON p.evaluation_sequence_number = ls.evaluation_sequence_number
  JOIN   `bigquery-public-data.usfs_fia.condition`  c
         ON c.plot_sequence_number        = p.plot_sequence_number
  WHERE  c.condition_status_code = 1
    AND  c.reserved_status_code  = 0
    AND  c.site_productivity_class_code BETWEEN 1 AND 6
  GROUP BY ls.state_code, ls.state_name, ls.evaluation_group
),
forest AS (                 -- forest-land acres
  SELECT ls.state_code,
         ls.state_name,
         ls.evaluation_group,
         SUM(
           CASE
             WHEN c.proportion_basis = 'MACR'
                  AND p.adjustment_factor_for_the_macroplot > 0
             THEN p.expansion_factor * p.adjustment_factor_for_the_macroplot
             WHEN c.proportion_basis = 'SUBP'
                  AND p.adjustment_factor_for_the_subplot  > 0
             THEN p.expansion_factor * p.adjustment_factor_for_the_subplot
             ELSE p.expansion_factor
           END * c.condition_proportion_unadjusted
         ) AS forest_acres
  FROM   latest_state ls
  JOIN   `bigquery-public-data.usfs_fia.population` p
         ON p.evaluation_sequence_number = ls.evaluation_sequence_number
  JOIN   `bigquery-public-data.usfs_fia.condition`  c
         ON c.plot_sequence_number        = p.plot_sequence_number
  WHERE  c.condition_status_code = 1
  GROUP BY ls.state_code, ls.state_name, ls.evaluation_group
),
combined AS (               -- merge timber & forest
  SELECT t.state_code,
         t.state_name,
         t.evaluation_group,
         t.timber_acres,
         f.forest_acres
  FROM   timber t
  JOIN   forest f
    USING(state_code, state_name, evaluation_group)
)
-- deliver two winning rows: biggest timber & biggest forest
SELECT 'Timberland' AS category,
       state_code,
       evaluation_group,
       state_name,
       timber_acres AS acres
FROM   combined
ORDER  BY timber_acres DESC
LIMIT  1
UNION ALL
SELECT 'Forestland',
       state_code,
       evaluation_group,
       state_name,
       forest_acres
FROM   combined
ORDER  BY forest_acres DESC
LIMIT  1;
