```sql
--Description: 
-- We need two winners: the state with the most timber-land acres and the state with the most
-- forest-land acres, but only from each state’s most-recent EXPCURR (current-estimate) evaluation.
-- Steps inside the query:
--   (1) latest_eval  – pick the newest EXPCURR evaluation per state.
--   (2) eval_group   – attach its evaluation_group so we can report it.
--   (3) calc_acres   – duplicate every latest evaluation row, tagging one copy “timber” and the 
--       other “forest”, then join to POPULATION + CONDITION to turn every condition into acres:
--         • use expansion_factor × macroplot_adjustment when MACR & adj>0,
--         • use expansion_factor × subplot_adjustment when SUBP & adj>0,
--         • otherwise just expansion_factor,
--         then multiply by condition_proportion_unadjusted.
--       Apply timber-land filters (condition_status=1, reserved_status=0, SPC 1-6) or 
--       forest-land filter (condition_status=1) depending on the tag.
--   (4) pivot        – one row per state with both timber_acres and forest_acres.
--   (5) final SELECT – top row by timber_acres and by forest_acres, labelled by category.
WITH latest_eval AS (            -- newest EXPCURR evaluation for every state
  SELECT ev.state_code,
         ev.location_name                       AS state_name,
         ev.evaluation_sequence_number,
         ev.evaluation_group_sequence_number,
         ROW_NUMBER() OVER (PARTITION BY ev.state_code
                            ORDER BY ev.evaluation_identifier DESC) AS rn
  FROM `bigquery-public-data.usfs_fia.population_evaluation`      ev
  JOIN `bigquery-public-data.usfs_fia.population_evaluation_type` et
    ON  et.evaluation_sequence_number = ev.evaluation_sequence_number
  WHERE et.evaluation_type = 'EXPCURR'
),
eval_group AS (                 -- keep only the latest + get evaluation_group id
  SELECT ls.state_code,
         ls.state_name,
         peg.evaluation_group,
         ls.evaluation_sequence_number
  FROM   latest_eval ls
  JOIN   `bigquery-public-data.usfs_fia.population_evaluation_group` peg
    ON   peg.evaluation_group_sequence_number = ls.evaluation_group_sequence_number
  WHERE  ls.rn = 1
),
calc_acres AS (                 -- compute acres for timber / forest
  SELECT eg.state_code,
         eg.state_name,
         eg.evaluation_group,
         tag,
         SUM(
           CASE
             WHEN c.proportion_basis = 'MACR'
                  AND p.adjustment_factor_for_the_macroplot > 0
             THEN p.expansion_factor * p.adjustment_factor_for_the_macroplot
             WHEN c.proportion_basis = 'SUBP'
                  AND p.adjustment_factor_for_the_subplot  > 0
             THEN p.expansion_factor * p.adjustment_factor_for_the_subplot
             ELSE p.expansion_factor
           END
           * c.condition_proportion_unadjusted
         ) AS acres
  FROM (
        SELECT *, 'timber' AS tag FROM eval_group
        UNION ALL
        SELECT *, 'forest' AS tag FROM eval_group
       ) AS eg
  JOIN `bigquery-public-data.usfs_fia.population` p
       ON p.evaluation_sequence_number = eg.evaluation_sequence_number
  JOIN `bigquery-public-data.usfs_fia.condition`  c
       ON c.plot_sequence_number      = p.plot_sequence_number
  WHERE (tag = 'timber'
         AND c.condition_status_code = 1
         AND c.reserved_status_code  = 0
         AND c.site_productivity_class_code BETWEEN 1 AND 6)
     OR (tag = 'forest'
         AND c.condition_status_code = 1)
  GROUP BY eg.state_code, eg.state_name, eg.evaluation_group, tag
),
pivot AS (                      -- one row per state with both acre totals
  SELECT state_code,
         state_name,
         evaluation_group,
         MAX(IF(tag='timber', acres, NULL))  AS timber_acres,
         MAX(IF(tag='forest', acres, NULL))  AS forest_acres
  FROM   calc_acres
  GROUP BY state_code, state_name, evaluation_group
)
-- winners
SELECT 'Timberland' AS category,
       STRUCT(state_code, evaluation_group, state_name, timber_acres) AS top_state
FROM   pivot
ORDER  BY timber_acres DESC
LIMIT  1
UNION ALL
SELECT 'Forestland',
       STRUCT(state_code, evaluation_group, state_name, forest_acres)
FROM   pivot
ORDER  BY forest_acres DESC
LIMIT  1;
