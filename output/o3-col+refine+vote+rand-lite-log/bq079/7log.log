--Description:
-- One query that
--   1) Finds each state’s most-recent evaluation of type EXPCURR.
--   2) Calculates, from that evaluation, total acres of
--        a. TIMBERLAND (condition_status=1 AND reserved_status=0 AND site_productivity 1-6)
--        b. FORESTLAND (condition_status=1)
--      using expansion_factor × adjustment_factor (MACR vs SUBP) × condition_proportion.
--   3) Returns two rows:  the state with the greatest TIMBERLAND acres
--      and the state with the greatest FORESTLAND acres, including
--      category, state_code, evaluation_group, state_name, and acres.

WITH latest_eval AS (                         -- newest EXPCURR evaluation per state
  SELECT ev.state_code,
         ev.location_name                       AS state_name,
         ev.evaluation_sequence_number,
         ev.evaluation_group_sequence_number,
         ROW_NUMBER() OVER (PARTITION BY ev.state_code
                            ORDER BY ev.evaluation_identifier DESC) AS rn
  FROM `bigquery-public-data.usfs_fia.population_evaluation`      ev
  JOIN `bigquery-public-data.usfs_fia.population_evaluation_type` et
    ON  et.evaluation_sequence_number = ev.evaluation_sequence_number
  WHERE et.evaluation_type = 'EXPCURR'
),
latest_state AS (                             -- keep only that latest row per state
  SELECT le.state_code,
         le.state_name,
         le.evaluation_sequence_number,
         peg.evaluation_group
  FROM   latest_eval le
  JOIN   `bigquery-public-data.usfs_fia.population_evaluation_group` peg
    ON   peg.evaluation_group_sequence_number = le.evaluation_group_sequence_number
  WHERE  le.rn = 1
),
base_acres AS (                               -- helper to convert each condition to acres
  SELECT ls.state_code,
         ls.state_name,
         ls.evaluation_group,
         c.condition_status_code,
         c.reserved_status_code,
         c.site_productivity_class_code,
         c.condition_proportion_unadjusted,
         c.proportion_basis,
         p.expansion_factor,
         p.adjustment_factor_for_the_macroplot,
         p.adjustment_factor_for_the_subplot
  FROM   latest_state ls
  JOIN   `bigquery-public-data.usfs_fia.population` p
         ON p.evaluation_sequence_number = ls.evaluation_sequence_number
  JOIN   `bigquery-public-data.usfs_fia.condition`  c
         ON c.plot_sequence_number        = p.plot_sequence_number
),
calc AS (                                     -- compute adjusted acres for each condition
  SELECT *,
         CASE
           WHEN proportion_basis = 'MACR'
                AND adjustment_factor_for_the_macroplot > 0
           THEN expansion_factor * adjustment_factor_for_the_macroplot
           WHEN proportion_basis = 'SUBP'
                AND adjustment_factor_for_the_subplot  > 0
           THEN expansion_factor * adjustment_factor_for_the_subplot
           ELSE expansion_factor
         END * condition_proportion_unadjusted           AS adj_acres
  FROM base_acres
),
agg AS (                                      -- aggregate timber & forest totals per state
  SELECT state_code,
         state_name,
         evaluation_group,
         SUM(CASE
               WHEN condition_status_code = 1
                AND reserved_status_code  = 0
                AND site_productivity_class_code BETWEEN 1 AND 6
               THEN adj_acres END) AS timber_acres,
         SUM(CASE
               WHEN condition_status_code = 1
               THEN adj_acres END)            AS forest_acres
  FROM   calc
  GROUP  BY state_code, state_name, evaluation_group
),
top_timber AS (                               -- winning timberland state
  SELECT 'Timberland' AS category,
         state_code,
         evaluation_group,
         state_name,
         timber_acres AS acres,
         ROW_NUMBER() OVER (ORDER BY timber_acres DESC) AS rnk
  FROM   agg
),
top_forest AS (                               -- winning forestland state
  SELECT 'Forestland' AS category,
         state_code,
         evaluation_group,
         state_name,
         forest_acres AS acres,
         ROW_NUMBER() OVER (ORDER BY forest_acres DESC) AS rnk
  FROM   agg
)
SELECT category, state_code, evaluation_group, state_name, acres
FROM   top_timber
WHERE  rnk = 1
UNION ALL
SELECT category, state_code, evaluation_group, state_name, acres
FROM   top_forest
WHERE  rnk = 1;
