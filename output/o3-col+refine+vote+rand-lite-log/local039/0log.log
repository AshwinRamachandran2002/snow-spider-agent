```sql
-- Description: 1) Inspect city names that start with 'A' or contain a hyphen (‘-’)  
SELECT DISTINCT "city"
FROM "city"
WHERE "city" LIKE 'A%' OR "city" LIKE '%-%'
LIMIT 20;
```

```sql
-- Description: 2) Check sample addresses that belong to the selected cities  
SELECT DISTINCT a."address", c."city"
FROM "address" AS a
JOIN "city"   AS c ON a."city_id" = c."city_id"
WHERE c."city" LIKE 'A%' OR c."city" LIKE '%-%'
LIMIT 20;
```

```sql
-- Description: 3) List customers who live in those cities  
SELECT DISTINCT cu."customer_id", cu."first_name", cu."last_name", c."city"
FROM "customer" AS cu
JOIN "address"  AS a ON cu."address_id" = a."address_id"
JOIN "city"     AS c ON a."city_id"    = c."city_id"
WHERE c."city" LIKE 'A%' OR c."city" LIKE '%-%'
LIMIT 20;
```

```sql
-- Description: 4) Count how many rentals come from customers in those cities  
SELECT COUNT(*) AS "rental_count"
FROM "rental"  AS r
JOIN "customer" AS cu ON r."customer_id" = cu."customer_id"
JOIN "address"  AS a  ON cu."address_id" = a."address_id"
JOIN "city"     AS c  ON a."city_id"     = c."city_id"
WHERE c."city" LIKE 'A%' OR c."city" LIKE '%-%'
LIMIT 20;
```

```sql
-- Description: 5) Map each rental to its film title (sample)  
SELECT DISTINCT r."rental_id", f."title"
FROM "rental"   AS r
JOIN "inventory" AS i ON r."inventory_id" = i."inventory_id"
JOIN "film"      AS f ON i."film_id"      = f."film_id"
LIMIT 20;
```

```sql
-- Description: 6) See the category of each film (sample)  
SELECT DISTINCT f."title", ca."name" AS "category_name"
FROM "film"          AS f
JOIN "film_category" AS fc ON f."film_id"   = fc."film_id"
JOIN "category"      AS ca ON fc."category_id" = ca."category_id"
LIMIT 20;
```

```sql
-- Description: 7) Compute rental hours for individual rentals (return_date not NULL)  
SELECT r."rental_id",
       (julianday(r."return_date") - julianday(r."rental_date")) * 24 AS "rental_hours"
FROM "rental" AS r
WHERE r."return_date" IS NOT NULL
LIMIT 20;
```

```sql
-- Description: 8) Sum total rental hours per film category only for the target cities  
SELECT ca."name" AS "category_name",
       SUM((julianday(r."return_date") - julianday(r."rental_date")) * 24) AS "total_hours"
FROM "rental"       AS r
JOIN "customer"     AS cu ON r."customer_id"  = cu."customer_id"
JOIN "address"      AS a  ON cu."address_id"  = a."address_id"
JOIN "city"         AS c  ON a."city_id"      = c."city_id"
JOIN "inventory"    AS i  ON r."inventory_id" = i."inventory_id"
JOIN "film_category"AS fc ON i."film_id"      = fc."film_id"
JOIN "category"     AS ca ON fc."category_id" = ca."category_id"
WHERE (c."city" LIKE 'A%' OR c."city" LIKE '%-%')
  AND r."return_date" IS NOT NULL
GROUP BY ca."name"
ORDER BY "total_hours" DESC
LIMIT 20;
```

```sql
-- Description: 9) FINAL – film category with the highest total rental hours in the selected cities  
SELECT "category_name"
FROM (
    SELECT ca."name" AS "category_name",
           SUM((julianday(r."return_date") - julianday(r."rental_date")) * 24) AS "total_hours"
    FROM "rental"        AS r
    JOIN "customer"      AS cu ON r."customer_id"  = cu."customer_id"
    JOIN "address"       AS a  ON cu."address_id"  = a."address_id"
    JOIN "city"          AS c  ON a."city_id"      = c."city_id"
    JOIN "inventory"     AS i  ON r."inventory_id" = i."inventory_id"
    JOIN "film_category" AS fc ON i."film_id"      = fc."film_id"
    JOIN "category"      AS ca ON fc."category_id" = ca."category_id"
    WHERE (c."city" LIKE 'A%' OR c."city" LIKE '%-%')
      AND r."return_date" IS NOT NULL
    GROUP BY ca."name"
    ORDER BY "total_hours" DESC
    LIMIT 1
) 
LIMIT 20;
```
