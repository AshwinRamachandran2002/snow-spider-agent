Query:
--Description: 8)  Compute rental hours (difference between return_date and rental_date) for each rental in scope.  
SELECT DISTINCT
       r.rental_id,
       ROUND( (julianday(r.return_date) - julianday(r.rental_date)) * 24 , 2) AS rental_hours
FROM   rental AS r
WHERE  r.customer_id IN (
           SELECT cu.customer_id
           FROM   customer AS cu
           WHERE  cu.address_id IN (
                    SELECT a.address_id
                    FROM   address AS a
                    WHERE  a.city_id IN (
                             SELECT c.city_id
                             FROM   city AS c
                             WHERE  c.city LIKE 'A%' OR c.city LIKE '%-%'
                          )
                 )
       )
LIMIT 20;
