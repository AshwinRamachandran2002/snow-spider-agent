--Description: 5)  Link each rental to the underlying film via the inventory table.  
SELECT DISTINCT
       r.rental_id,
       i.film_id,
       r.rental_date,
       r.return_date
FROM   rental    AS r
JOIN   inventory AS i  ON i.inventory_id = r.inventory_id
WHERE  r.customer_id IN (
           SELECT cu.customer_id
           FROM   customer AS cu
           WHERE  cu.address_id IN (
                    SELECT a.address_id
                    FROM   address AS a
                    WHERE  a.city_id IN (
                             SELECT c.city_id
                             FROM   city AS c
                             WHERE  c.city LIKE 'A%' OR c.city LIKE '%-%'
                          )
                 )
       )
LIMIT 20;
