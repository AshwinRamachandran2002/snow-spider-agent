```sql
--Description: 1)  City names that either start with “A” or contain a hyphen (-).  
SELECT DISTINCT
       c.city_id,
       c.city
FROM   city AS c
WHERE  c.city LIKE 'A%'               -- starts with A
   OR  c.city LIKE '%-%'              -- contains a hyphen
LIMIT 20;
```

```sql
--Description: 2)  Addresses located in those cities.  
SELECT DISTINCT
       a.address_id,
       a.city_id,
       a.address
FROM   address AS a
WHERE  a.city_id IN (                 -- cities found in step-1
           SELECT c.city_id
           FROM   city AS c
           WHERE  c.city LIKE 'A%' OR c.city LIKE '%-%'
       )
LIMIT 20;
```

```sql
--Description: 3)  Customers whose address matches the qualifying addresses.  
SELECT DISTINCT
       cu.customer_id,
       cu.first_name,
       cu.last_name,
       cu.address_id
FROM   customer AS cu
WHERE  cu.address_id IN (             -- addresses from step-2
           SELECT a.address_id
           FROM   address AS a
           WHERE  a.city_id IN (
                    SELECT c.city_id
                    FROM   city AS c
                    WHERE  c.city LIKE 'A%' OR c.city LIKE '%-%'
                 )
       )
LIMIT 20;
```

```sql
--Description: 4)  Rental transactions made by those customers.  
SELECT DISTINCT
       r.rental_id,
       r.customer_id,
       r.rental_date,
       r.return_date,
       r.inventory_id
FROM   rental AS r
WHERE  r.customer_id IN (             -- customers from step-3
           SELECT cu.customer_id
           FROM   customer AS cu
           WHERE  cu.address_id IN (
                    SELECT a.address_id
                    FROM   address AS a
                    WHERE  a.city_id IN (
                             SELECT c.city_id
                             FROM   city AS c
                             WHERE  c.city LIKE 'A%' OR c.city LIKE '%-%'
                          )
                 )
       )
LIMIT 20;
```

```sql
--Description: 5)  Link each rental to the underlying film via the inventory table.  
SELECT DISTINCT
       r.rental_id,
       i.film_id,
       r.rental_date,
       r.return_date
FROM   rental    AS r
JOIN   inventory AS i  ON i.inventory_id = r.inventory_id
WHERE  r.customer_id IN (
           SELECT cu.customer_id
           FROM   customer AS cu
           WHERE  cu.address_id IN (
                    SELECT a.address_id
                    FROM   address AS a
                    WHERE  a.city_id IN (
                             SELECT c.city_id
                             FROM   city AS c
                             WHERE  c.city LIKE 'A%' OR c.city LIKE '%-%'
                          )
                 )
       )
LIMIT 20;
```

```sql
--Description: 6)  Map films to their categories.  
SELECT DISTINCT
       f.film_id,
       fc.category_id
FROM   film          AS f
JOIN   film_category AS fc ON fc.film_id = f.film_id
LIMIT 20;
```

```sql
--Description: 7)  Show category names (reference).  
SELECT DISTINCT
       ct.category_id,
       ct.name
FROM   category AS ct
LIMIT 20;
```

```sql
--Description: 8)  Compute rental hours (difference between return_date and rental_date) for each rental in scope.  
SELECT DISTINCT
       r.rental_id,
       ROUND( (julianday(r.return_date) - julianday(r.rental_date)) * 24 , 2) AS rental_hours
FROM   rental AS r
WHERE  r.customer_id IN (
           SELECT cu.customer_id
           FROM   customer AS cu
           WHERE  cu.address_id IN (
                    SELECT a.address_id
                    FROM   address AS a
                    WHERE  a.city_id IN (
                             SELECT c.city_id
                             FROM   city AS c
                             WHERE  c.city LIKE 'A%' OR c.city LIKE '%-%'
                          )
                 )
       )
LIMIT 20;
```

```sql
--Description: 9)  Aggregate total rental hours per film category for the selected cities.  
SELECT
       ct.name                             AS category_name,
       SUM( ROUND((julianday(r.return_date) - julianday(r.rental_date)) * 24 , 2) ) AS total_rental_hours
FROM           rental        AS r
JOIN           inventory     AS i  ON i.inventory_id = r.inventory_id
JOIN           film_category AS fc ON fc.film_id     = i.film_id
JOIN           category      AS ct ON ct.category_id = fc.category_id
WHERE          r.customer_id IN (
                   SELECT cu.customer_id
                   FROM   customer AS cu
                   WHERE  cu.address_id IN (
                            SELECT a.address_id
                            FROM   address AS a
                            WHERE  a.city_id IN (
                                     SELECT c.city_id
                                     FROM   city AS c
                                     WHERE  c.city LIKE 'A%' OR c.city LIKE '%-%'
                                  )
                         )
               )
GROUP BY       ct.name
ORDER BY       total_rental_hours DESC
LIMIT 20;
```

```sql
--Description: 10)  Final answer – the single film category with the highest total rental hours in the specified cities.  
SELECT
       ct.name AS top_category,
       SUM( ROUND((julianday(r.return_date) - julianday(r.rental_date)) * 24 , 2) ) AS total_rental_hours
FROM           rental        AS r
JOIN           inventory     AS i  ON i.inventory_id = r.inventory_id
JOIN           film_category AS fc ON fc.film_id     = i.film_id
JOIN           category      AS ct ON ct.category_id = fc.category_id
WHERE          r.customer_id IN (
                   SELECT cu.customer_id
                   FROM   customer AS cu
                   WHERE  cu.address_id IN (
                            SELECT a.address_id
                            FROM   address AS a
                            WHERE  a.city_id IN (
                                     SELECT c.city_id
                                     FROM   city AS c
                                     WHERE  c.city LIKE 'A%' OR c.city LIKE '%-%'
                                  )
                         )
               )
GROUP BY       ct.name
ORDER BY       total_rental_hours DESC
LIMIT 1;
```
