Query:
--Description: 9)  Aggregate total rental hours per film category for the selected cities.  
SELECT
       ct.name                             AS category_name,
       SUM( ROUND((julianday(r.return_date) - julianday(r.rental_date)) * 24 , 2) ) AS total_rental_hours
FROM           rental        AS r
JOIN           inventory     AS i  ON i.inventory_id = r.inventory_id
JOIN           film_category AS fc ON fc.film_id     = i.film_id
JOIN           category      AS ct ON ct.category_id = fc.category_id
WHERE          r.customer_id IN (
                   SELECT cu.customer_id
                   FROM   customer AS cu
                   WHERE  cu.address_id IN (
                            SELECT a.address_id
                            FROM   address AS a
                            WHERE  a.city_id IN (
                                     SELECT c.city_id
                                     FROM   city AS c
                                     WHERE  c.city LIKE 'A%' OR c.city LIKE '%-%'
                                  )
                         )
               )
GROUP BY       ct.name
ORDER BY       total_rental_hours DESC
LIMIT 20;
