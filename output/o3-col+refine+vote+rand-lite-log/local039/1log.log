       r.rental_id,
       r.customer_id,
       r.rental_date,
       r.return_date,
       r.inventory_id
FROM   rental AS r
WHERE  r.customer_id IN (             -- customers from step-3
           SELECT cu.customer_id
           FROM   customer AS cu
           WHERE  cu.address_id IN (
                    SELECT a.address_id
                    FROM   address AS a
                    WHERE  a.city_id IN (
                             SELECT c.city_id
                             FROM   city AS c
                             WHERE  c.city LIKE 'A%' OR c.city LIKE '%-%'
