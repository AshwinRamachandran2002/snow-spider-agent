--Description: 1)  City names that either start with “A” or contain a hyphen (-).  
SELECT DISTINCT
       c.city_id,
       c.city
FROM   city AS c
WHERE  c.city LIKE 'A%'               -- starts with A
   OR  c.city LIKE '%-%'              -- contains a hyphen
LIMIT 20;
