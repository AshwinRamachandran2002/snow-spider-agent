```sql
-- 1) Cities whose name starts with "A" or contains a hyphen
SELECT DISTINCT c.city
FROM city AS c
WHERE c.city LIKE 'A%'            -- starts with A
   OR c.city LIKE '%-%'           -- contains a hyphen
LIMIT 20;
```

```sql
-- 2) Customers living in the above cities
SELECT DISTINCT cu.customer_id,
       cu.first_name,
       cu.last_name,
       ct.city
FROM customer  AS cu
JOIN address   AS a  ON cu.address_id = a.address_id
JOIN city      AS ct ON a.city_id     = ct.city_id
WHERE ct.city LIKE 'A%' OR ct.city LIKE '%-%'
LIMIT 20;
```

```sql
-- 3) Rentals (with rental-hours) made by those customers
SELECT DISTINCT r.rental_id,
       cu.customer_id,
       ct.city,
       (julianday(r.return_date) - julianday(r.rental_date))*24 AS rental_hours
FROM rental    AS r
JOIN customer  AS cu ON r.customer_id = cu.customer_id
JOIN address   AS a  ON cu.address_id = a.address_id
JOIN city      AS ct ON a.city_id     = ct.city_id
WHERE (ct.city LIKE 'A%' OR ct.city LIKE '%-%')
  AND r.return_date IS NOT NULL
LIMIT 20;
```

```sql
-- 4) Rentals tied to films & their categories (sample rows)
SELECT DISTINCT r.rental_id,
       f.film_id,
       fc.category_id,
       cat.name  AS category_name,
       (julianday(r.return_date) - julianday(r.rental_date))*24 AS rental_hours
FROM rental        AS r
JOIN inventory     AS i   ON r.inventory_id = i.inventory_id
JOIN film          AS f   ON i.film_id      = f.film_id
JOIN film_category AS fc  ON f.film_id      = fc.film_id
JOIN category      AS cat ON fc.category_id = cat.category_id
JOIN customer      AS cu  ON r.customer_id  = cu.customer_id
JOIN address       AS a   ON cu.address_id  = a.address_id
JOIN city          AS ct  ON a.city_id      = ct.city_id
WHERE (ct.city LIKE 'A%' OR ct.city LIKE '%-%')
  AND r.return_date IS NOT NULL
LIMIT 20;
```

```sql
-- 5) Total rental-hours per category in the target cities
SELECT cat.name AS category_name,
       SUM((julianday(r.return_date) - julianday(r.rental_date))*24) AS total_rental_hours
FROM rental        AS r
JOIN inventory     AS i   ON r.inventory_id = i.inventory_id
JOIN film          AS f   ON i.film_id      = f.film_id
JOIN film_category AS fc  ON f.film_id      = fc.film_id
JOIN category      AS cat ON fc.category_id = cat.category_id
JOIN customer      AS cu  ON r.customer_id  = cu.customer_id
JOIN address       AS a   ON cu.address_id  = a.address_id
JOIN city          AS ct  ON a.city_id      = ct.city_id
WHERE (ct.city LIKE 'A%' OR ct.city LIKE '%-%')
  AND r.return_date IS NOT NULL
GROUP BY cat.name
ORDER BY total_rental_hours DESC
LIMIT 20;
```

```sql
-- 6) Identify the single category with the highest total rental-hours
SELECT sub.name AS category_with_highest_total_rental_hours
FROM (
    SELECT cat.name,
           SUM((julianday(r.return_date) - julianday(r.rental_date))*24) AS total_rental_hours
    FROM rental        AS r
    JOIN inventory     AS i   ON r.inventory_id = i.inventory_id
    JOIN film          AS f   ON i.film_id      = f.film_id
    JOIN film_category AS fc  ON f.film_id      = fc.film_id
    JOIN category      AS cat ON fc.category_id = cat.category_id
    JOIN customer      AS cu  ON r.customer_id  = cu.customer_id
    JOIN address       AS a   ON cu.address_id  = a.address_id
    JOIN city          AS ct  ON a.city_id      = ct.city_id
    WHERE (ct.city LIKE 'A%' OR ct.city LIKE '%-%')
      AND r.return_date IS NOT NULL
    GROUP BY cat.name
    ORDER BY total_rental_hours DESC
    LIMIT 1
) AS sub
LIMIT 20;
```

```sql
-- 7) (Optional) Top 5 categories overall for comparison
SELECT cat.name AS category_name,
       SUM((julianday(r.return_date) - julianday(r.rental_date))*24) AS total_rental_hours
FROM rental        AS r
JOIN inventory     AS i   ON r.inventory_id = i.inventory_id
JOIN film          AS f   ON i.film_id      = f.film_id
JOIN film_category AS fc  ON f.film_id      = fc.film_id
JOIN category      AS cat ON fc.category_id = cat.category_id
WHERE r.return_date IS NOT NULL
GROUP BY cat.name
ORDER BY total_rental_hours DESC
LIMIT 20;
```

```sql
-- 8) (Optional) Films belonging to the highest-hours category found in step 6
SELECT DISTINCT f.film_id,
       f.title
FROM film_category AS fc
JOIN film         AS f   ON fc.film_id      = f.film_id
JOIN category     AS cat ON fc.category_id  = cat.category_id
WHERE cat.name = (
      SELECT sub.name
      FROM (
          SELECT cat.name,
                 SUM((julianday(r.return_date) - julianday(r.rental_date))*24) AS hrs
          FROM rental r
          JOIN inventory i     ON r.inventory_id = i.inventory_id
          JOIN film f2         ON i.film_id      = f2.film_id
          JOIN film_category fc2 ON f2.film_id   = fc2.film_id
          JOIN category cat    ON fc2.category_id = cat.category_id
          JOIN customer cu     ON r.customer_id  = cu.customer_id
          JOIN address a       ON cu.address_id  = a.address_id
          JOIN city ct         ON a.city_id      = ct.city_id
          WHERE (ct.city LIKE 'A%' OR ct.city LIKE '%-%')
            AND r.return_date IS NOT NULL
          GROUP BY cat.name
          ORDER BY hrs DESC
          LIMIT 1
      ) AS sub
)
LIMIT 20;
```

These queries progress from simple inspection of city names to the final aggregation that returns the film category with the highest total rental hours specifically for rentals originating from cities whose names start with “A” or contain a hyphen.
