```sql
-- Description: 1) Identify all cities whose name starts with 'A' or contains a hyphen ‘-’.
SELECT DISTINCT 
       "city_id",
       "city"
FROM   "city"
WHERE  "city" LIKE 'A%' 
   OR  "city" LIKE '%-%'
LIMIT 20;
```

```sql
-- Description: 2) Show sample addresses that belong to those selected cities.
SELECT DISTINCT 
       a."address_id",
       a."address",
       c."city"
FROM   "address" AS a
JOIN   "city"     AS c ON a."city_id" = c."city_id"
WHERE  c."city" LIKE 'A%' 
   OR  c."city" LIKE '%-%'
LIMIT 20;
```

```sql
-- Description: 3) List customers who live in the filtered cities.
SELECT DISTINCT 
       cu."customer_id",
       cu."first_name" || ' ' || cu."last_name" AS "customer_name",
       c."city"
FROM   "customer" AS cu
JOIN   "address"  AS a ON cu."address_id" = a."address_id"
JOIN   "city"     AS c ON a."city_id"      = c."city_id"
WHERE  c."city" LIKE 'A%' 
   OR  c."city" LIKE '%-%'
LIMIT 20;
```

```sql
-- Description: 4) Display rentals made by those customers and their rental durations (hours).
SELECT DISTINCT 
       r."rental_id",
       r."customer_id",
       (julianday(r."return_date") - julianday(r."rental_date")) * 24 AS "rental_hours"
FROM   "rental"   AS r
JOIN   "customer" AS cu ON r."customer_id" = cu."customer_id"
JOIN   "address"  AS a  ON cu."address_id" = a."address_id"
JOIN   "city"     AS c  ON a."city_id"     = c."city_id"
WHERE  (c."city" LIKE 'A%' OR c."city" LIKE '%-%')
  AND  r."return_date" IS NOT NULL
LIMIT 20;
```

```sql
-- Description: 5) Show films together with their category names.
SELECT DISTINCT 
       f."film_id",
       f."title",
       cat."name" AS "category_name"
FROM   "film"          AS f
JOIN   "film_category" AS fc  ON f."film_id"    = fc."film_id"
JOIN   "category"      AS cat ON fc."category_id" = cat."category_id"
LIMIT 20;
```

```sql
-- Description: 6) Connect rentals (filtered by city) to their films’ categories and calculate rental hours per category.
SELECT DISTINCT 
       cat."name"                  AS "category_name",
       SUM( (julianday(r."return_date") - julianday(r."rental_date")) * 24 ) AS "total_rental_hours"
FROM            "rental"  AS r
JOIN            "inventory"      AS i   ON r."inventory_id" = i."inventory_id"
JOIN            "film"           AS f   ON i."film_id"      = f."film_id"
JOIN            "film_category"  AS fc  ON f."film_id"      = fc."film_id"
JOIN            "category"       AS cat ON fc."category_id" = cat."category_id"
JOIN            "customer"       AS cu  ON r."customer_id"  = cu."customer_id"
JOIN            "address"        AS a   ON cu."address_id"  = a."address_id"
JOIN            "city"           AS c   ON a."city_id"      = c."city_id"
WHERE  (c."city" LIKE 'A%' OR c."city" LIKE '%-%')
  AND  r."return_date" IS NOT NULL
GROUP BY cat."name"
LIMIT 20;
```

```sql
-- Description: 7) Final answer – the film category having the highest total rental hours in the required cities.
SELECT DISTINCT 
       cat."name" AS "top_category"
FROM            "rental"  AS r
JOIN            "inventory"      AS i   ON r."inventory_id" = i."inventory_id"
JOIN            "film"           AS f   ON i."film_id"      = f."film_id"
JOIN            "film_category"  AS fc  ON f."film_id"      = fc."film_id"
JOIN            "category"       AS cat ON fc."category_id" = cat."category_id"
JOIN            "customer"       AS cu  ON r."customer_id"  = cu."customer_id"
JOIN            "address"        AS a   ON cu."address_id"  = a."address_id"
JOIN            "city"           AS c   ON a."city_id"      = c."city_id"
WHERE  (c."city" LIKE 'A%' OR c."city" LIKE '%-%')
  AND  r."return_date" IS NOT NULL
GROUP BY cat."name"
ORDER BY SUM( (julianday(r."return_date") - julianday(r."rental_date")) * 24 ) DESC
LIMIT 1;
```
