-- Description: 3) List customers who live in the filtered cities.
SELECT DISTINCT 
       cu."customer_id",
       cu."first_name" || ' ' || cu."last_name" AS "customer_name",
       c."city"
FROM   "customer" AS cu
JOIN   "address"  AS a ON cu."address_id" = a."address_id"
JOIN   "city"     AS c ON a."city_id"      = c."city_id"
