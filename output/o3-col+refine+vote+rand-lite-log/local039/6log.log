-- Description: 1) Identify all cities whose name starts with 'A' or contains a hyphen ‘-’.
SELECT DISTINCT 
       "city_id",
       "city"
FROM   "city"
WHERE  "city" LIKE 'A%' 
   OR  "city" LIKE '%-%'
LIMIT 20;
