```sql
-- Description: 1) Inspect all cities whose name either starts with “A” or contains a hyphen.
SELECT DISTINCT city_id, city
FROM city
WHERE city LIKE 'A%' 
   OR city LIKE '%-%'
LIMIT 20;
```

```sql
-- Description: 2) Look at addresses that belong to the above cities.  
SELECT DISTINCT a.address_id, a.address, c.city
FROM address AS a
JOIN city     AS c ON a.city_id = c.city_id
WHERE c.city LIKE 'A%' 
   OR c.city LIKE '%-%'
LIMIT 20;
```

```sql
-- Description: 3) List customers who live at those addresses.  
SELECT DISTINCT cu.customer_id, cu.first_name, cu.last_name
FROM customer AS cu
JOIN address  AS a ON cu.address_id = a.address_id
JOIN city     AS c ON a.city_id     = c.city_id
WHERE c.city LIKE 'A%' 
   OR c.city LIKE '%-%'
LIMIT 20;
```

```sql
-- Description: 4) Display rentals made by these customers (ignore open rentals with NULL return_date).  
SELECT DISTINCT r.rental_id, r.customer_id, r.rental_date, r.return_date
FROM rental   AS r
JOIN customer AS cu ON r.customer_id = cu.customer_id
JOIN address  AS a  ON cu.address_id = a.address_id
JOIN city     AS c  ON a.city_id     = c.city_id
WHERE (c.city LIKE 'A%' OR c.city LIKE '%-%')
  AND r.return_date IS NOT NULL
LIMIT 20;
```

```sql
-- Description: 5) Compute rental hours for each of those rentals. 
SELECT DISTINCT r.rental_id,
       (julianday(r.return_date) - julianday(r.rental_date))*24 AS rental_hours
FROM rental   AS r
JOIN customer AS cu ON r.customer_id = cu.customer_id
JOIN address  AS a  ON cu.address_id = a.address_id
JOIN city     AS c  ON a.city_id     = c.city_id
WHERE (c.city LIKE 'A%' OR c.city LIKE '%-%')
  AND r.return_date IS NOT NULL
LIMIT 20;
```

```sql
-- Description: 6) Connect each rental to its film(s) through inventory.  
SELECT DISTINCT r.rental_id, i.film_id
FROM rental    AS r
JOIN inventory AS i  ON r.inventory_id = i.inventory_id
JOIN customer  AS cu ON r.customer_id  = cu.customer_id
JOIN address   AS a  ON cu.address_id  = a.address_id
JOIN city      AS c  ON a.city_id      = c.city_id
WHERE (c.city LIKE 'A%' OR c.city LIKE '%-%')
  AND r.return_date IS NOT NULL
LIMIT 20;
```

```sql
-- Description: 7) Add the category for every film involved.  
SELECT DISTINCT r.rental_id, fc.category_id
FROM rental        AS r
JOIN inventory     AS i  ON r.inventory_id  = i.inventory_id
JOIN film_category AS fc ON i.film_id       = fc.film_id
JOIN customer      AS cu ON r.customer_id   = cu.customer_id
JOIN address       AS a  ON cu.address_id   = a.address_id
JOIN city          AS c  ON a.city_id       = c.city_id
WHERE (c.city LIKE 'A%' OR c.city LIKE '%-%')
  AND r.return_date IS NOT NULL
LIMIT 20;
```

```sql
-- Description: 8) Sum up total rental hours per film category for those cities.  
SELECT DISTINCT fc.category_id,
       SUM( (julianday(r.return_date) - julianday(r.rental_date))*24 ) AS total_hours
FROM rental        AS r
JOIN inventory     AS i  ON r.inventory_id  = i.inventory_id
JOIN film_category AS fc ON i.film_id       = fc.film_id
JOIN customer      AS cu ON r.customer_id   = cu.customer_id
JOIN address       AS a  ON cu.address_id   = a.address_id
JOIN city          AS c  ON a.city_id       = c.city_id
WHERE (c.city LIKE 'A%' OR c.city LIKE '%-%')
  AND r.return_date IS NOT NULL
GROUP BY fc.category_id
LIMIT 20;
```

```sql
-- Description: 9) Order categories by their total rental hours (highest first).  
SELECT DISTINCT fc.category_id,
       SUM( (julianday(r.return_date) - julianday(r.rental_date))*24 ) AS total_hours
FROM rental        AS r
JOIN inventory     AS i  ON r.inventory_id  = i.inventory_id
JOIN film_category AS fc ON i.film_id       = fc.film_id
JOIN customer      AS cu ON r.customer_id   = cu.customer_id
JOIN address       AS a  ON cu.address_id   = a.address_id
JOIN city          AS c  ON a.city_id       = c.city_id
WHERE (c.city LIKE 'A%' OR c.city LIKE '%-%')
  AND r.return_date IS NOT NULL
GROUP BY fc.category_id
ORDER BY total_hours DESC
LIMIT 20;
```

```sql
-- Description: 10) Final answer – return the category name that has the greatest total rental hours in those cities.
SELECT DISTINCT ca.name AS category_name
FROM category       AS ca
JOIN (
        SELECT fc.category_id,
               SUM( (julianday(r.return_date) - julianday(r.rental_date))*24 ) AS total_hours
        FROM rental        AS r
        JOIN inventory     AS i  ON r.inventory_id  = i.inventory_id
        JOIN film_category AS fc ON i.film_id       = fc.film_id
        JOIN customer      AS cu ON r.customer_id   = cu.customer_id
        JOIN address       AS a  ON cu.address_id   = a.address_id
        JOIN city          AS c  ON a.city_id       = c.city_id
        WHERE (c.city LIKE 'A%' OR c.city LIKE '%-%')
          AND r.return_date IS NOT NULL
        GROUP BY fc.category_id
        ORDER BY total_hours DESC
        LIMIT 1
     ) AS top_cat
ON ca.category_id = top_cat.category_id
LIMIT 20;
```
