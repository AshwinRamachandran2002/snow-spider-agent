```sql
--Description: 1) Identify all city names that start with “A” or contain a hyphen.  
SELECT DISTINCT "city"
FROM "city"
WHERE "city" LIKE 'A%' OR "city" LIKE '%-%'
LIMIT 20;
```

```sql
--Description: 2) List customers located in those qualified cities.  
SELECT DISTINCT cu."customer_id",
                ci."city"
FROM   "customer"  AS cu
JOIN   "address"   AS ad ON cu."address_id" = ad."address_id"
JOIN   "city"      AS ci ON ad."city_id"   = ci."city_id"
WHERE  ci."city" LIKE 'A%' OR ci."city" LIKE '%-%'
LIMIT 20;
```

```sql
--Description: 3) Show sample rentals made by customers from the selected cities.  
SELECT DISTINCT r."rental_id",
                r."customer_id",
                r."rental_date",
                r."return_date"
FROM   "rental"   AS r
JOIN   "customer" AS cu ON r."customer_id" = cu."customer_id"
JOIN   "address"  AS ad ON cu."address_id" = ad."address_id"
JOIN   "city"     AS ci ON ad."city_id"    = ci."city_id"
WHERE  ci."city" LIKE 'A%' OR ci."city" LIKE '%-%'
LIMIT 20;
```

```sql
--Description: 4) Connect rentals to inventory and films for those cities.  
SELECT DISTINCT r."rental_id",
                i."inventory_id",
                i."film_id"
FROM   "rental"   AS r
JOIN   "inventory" AS i ON r."inventory_id" = i."inventory_id"
JOIN   "customer"  AS cu ON r."customer_id" = cu."customer_id"
JOIN   "address"   AS ad ON cu."address_id" = ad."address_id"
JOIN   "city"      AS ci ON ad."city_id"    = ci."city_id"
WHERE  ci."city" LIKE 'A%' OR ci."city" LIKE '%-%'
LIMIT 20;
```

```sql
--Description: 5) Display film–category pairs (all stores).  
SELECT DISTINCT i."film_id",
                cat."name" AS "category"
FROM   "inventory"      AS i
JOIN   "film_category"  AS fc  ON i."film_id"     = fc."film_id"
JOIN   "category"       AS cat ON fc."category_id" = cat."category_id"
LIMIT 20;
```

```sql
--Description: 6) Count how many rentals each category has in the qualified cities.  
SELECT cat."name"                    AS "category",
       COUNT(*)                      AS "rental_count"
FROM   "rental"         AS r
JOIN   "inventory"      AS i   ON r."inventory_id" = i."inventory_id"
JOIN   "film_category"  AS fc  ON i."film_id"      = fc."film_id"
JOIN   "category"       AS cat ON fc."category_id" = cat."category_id"
JOIN   "customer"       AS cu  ON r."customer_id"  = cu."customer_id"
JOIN   "address"        AS ad  ON cu."address_id"  = ad."address_id"
JOIN   "city"           AS ci  ON ad."city_id"     = ci."city_id"
WHERE  ci."city" LIKE 'A%' OR ci."city" LIKE '%-%'
GROUP BY cat."name"
ORDER BY "rental_count" DESC
LIMIT 20;
```

```sql
--Description: 7) Compute total rental hours per category in the target cities.  
SELECT cat."name"                                                        AS "category",
       SUM( (julianday(r."return_date") - julianday(r."rental_date"))*24 ) AS "total_hours"
FROM   "rental"         AS r
JOIN   "inventory"      AS i   ON r."inventory_id" = i."inventory_id"
JOIN   "film_category"  AS fc  ON i."film_id"      = fc."film_id"
JOIN   "category"       AS cat ON fc."category_id" = cat."category_id"
JOIN   "customer"       AS cu  ON r."customer_id"  = cu."customer_id"
JOIN   "address"        AS ad  ON cu."address_id"  = ad."address_id"
JOIN   "city"           AS ci  ON ad."city_id"     = ci."city_id"
WHERE  (ci."city" LIKE 'A%' OR ci."city" LIKE '%-%')
  AND  r."return_date" IS NOT NULL
GROUP BY cat."name"
ORDER BY "total_hours" DESC
LIMIT 20;
```

```sql
--Description: 8) FINAL – retrieve the single film category with the highest total rental hours in those cities.  
SELECT cat."name" AS "top_category"
FROM   "rental"         AS r
JOIN   "inventory"      AS i   ON r."inventory_id" = i."inventory_id"
JOIN   "film_category"  AS fc  ON i."film_id"      = fc."film_id"
JOIN   "category"       AS cat ON fc."category_id" = cat."category_id"
JOIN   "customer"       AS cu  ON r."customer_id"  = cu."customer_id"
JOIN   "address"        AS ad  ON cu."address_id"  = ad."address_id"
JOIN   "city"           AS ci  ON ad."city_id"     = ci."city_id"
WHERE  (ci."city" LIKE 'A%' OR ci."city" LIKE '%-%')
  AND  r."return_date" IS NOT NULL
GROUP BY cat."name"
ORDER BY SUM( (julianday(r."return_date") - julianday(r."rental_date"))*24 ) DESC
LIMIT 1;
```
