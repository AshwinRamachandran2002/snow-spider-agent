```sql
--Description: 1) List unique cities whose name starts with 'A' or contains a hyphen.  
SELECT DISTINCT "city"
FROM "city"
WHERE "city" LIKE 'A%' OR "city" LIKE '%-%'
LIMIT 20;
```

```sql
--Description: 2) See addresses located in those selected cities.  
SELECT DISTINCT a."address_id", c."city"
FROM "address" AS a
JOIN "city"     AS c ON a."city_id" = c."city_id"
WHERE c."city" LIKE 'A%' OR c."city" LIKE '%-%'
LIMIT 20;
```

```sql
--Description: 3) Find customers that live at those addresses (i.e., in the target cities).  
SELECT DISTINCT cu."customer_id",
                cu."first_name",
                cu."last_name"
FROM "customer" AS cu
JOIN "address"  AS a ON cu."address_id" = a."address_id"
JOIN "city"     AS c ON a."city_id"    = c."city_id"
WHERE c."city" LIKE 'A%' OR c."city" LIKE '%-%'
LIMIT 20;
```

```sql
--Description: 4) Retrieve rentals (with a return recorded) made by those customers.  
SELECT DISTINCT r."rental_id",
                r."rental_date",
                r."return_date"
FROM "rental"   AS r
JOIN "customer" AS cu ON r."customer_id" = cu."customer_id"
JOIN "address"  AS a  ON cu."address_id" = a."address_id"
JOIN "city"     AS c  ON a."city_id"     = c."city_id"
WHERE (c."city" LIKE 'A%' OR c."city" LIKE '%-%')
  AND r."return_date" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 5) Compute rental-hours for any rental (hours = (return_date-rental_date) * 24).  
SELECT DISTINCT r."rental_id",
       ROUND((julianday(r."return_date") - julianday(r."rental_date")) * 24, 2) AS "rental_hours"
FROM "rental" AS r
WHERE r."return_date" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 6) Show films together with their inventory items (bridge to rentals).  
SELECT DISTINCT f."film_id",
                f."title"
FROM "film"      AS f
JOIN "inventory" AS i ON f."film_id" = i."film_id"
LIMIT 20;
```

```sql
--Description: 7) Map each rental (any city) to the film rented.  
SELECT DISTINCT r."rental_id",
                f."film_id",
                f."title"
FROM "rental"    AS r
JOIN "inventory" AS i ON r."inventory_id" = i."inventory_id"
JOIN "film"      AS f ON i."film_id"      = f."film_id"
LIMIT 20;
```

```sql
--Description: 8) Connect films to their categories.  
SELECT DISTINCT f."title",
                cat."name" AS "category_name"
FROM "film"          AS f
JOIN "film_category" AS fc  ON f."film_id"      = fc."film_id"
JOIN "category"      AS cat ON fc."category_id" = cat."category_id"
LIMIT 20;
```

```sql
--Description: 9) Aggregate total rental hours per category for the target cities.  
SELECT cat."name" AS "category_name",
       ROUND(SUM((julianday(r."return_date") - julianday(r."rental_date")) * 24), 2) AS "total_rental_hours"
FROM "rental"        AS r
JOIN "inventory"     AS i   ON r."inventory_id" = i."inventory_id"
JOIN "film_category" AS fc  ON i."film_id"      = fc."film_id"
JOIN "category"      AS cat ON fc."category_id" = cat."category_id"
JOIN "customer"      AS cu  ON r."customer_id"  = cu."customer_id"
JOIN "address"       AS a   ON cu."address_id"  = a."address_id"
JOIN "city"          AS c   ON a."city_id"      = c."city_id"
WHERE r."return_date" IS NOT NULL
  AND (c."city" LIKE 'A%' OR c."city" LIKE '%-%')
GROUP BY cat."name"
ORDER BY "total_rental_hours" DESC
LIMIT 20;
```

```sql
--Description: 10) Final answer – the film category with the highest total rental hours in the specified cities.  
SELECT cat."name" AS "highest_rental_category"
FROM "rental"        AS r
JOIN "inventory"     AS i   ON r."inventory_id" = i."inventory_id"
JOIN "film_category" AS fc  ON i."film_id"      = fc."film_id"
JOIN "category"      AS cat ON fc."category_id" = cat."category_id"
JOIN "customer"      AS cu  ON r."customer_id"  = cu."customer_id"
JOIN "address"       AS a   ON cu."address_id"  = a."address_id"
JOIN "city"          AS c   ON a."city_id"      = c."city_id"
WHERE r."return_date" IS NOT NULL
  AND (c."city" LIKE 'A%' OR c."city" LIKE '%-%')
GROUP BY cat."name"
ORDER BY SUM((julianday(r."return_date") - julianday(r."rental_date")) * 24) DESC
LIMIT 1;
```
