```sql
--Description: 1) Peek at the cities whose names either start with 'A' or contain a hy-phen (‘-’).
SELECT DISTINCT "city_id",
       "city"
FROM "city"
WHERE "city" LIKE 'A%' 
   OR "city" LIKE '%-%'
LIMIT 20;
```

```sql
--Description: 2) Show a few addresses that are located in those qualifying cities.
SELECT DISTINCT a."address_id",
       a."address",
       c."city"
FROM   "address" AS a
JOIN   "city"    AS c ON a."city_id" = c."city_id"
WHERE  c."city" LIKE 'A%' 
   OR  c."city" LIKE '%-%'
LIMIT 20;
```

```sql
--Description: 3) List some customers who live at those addresses.
SELECT DISTINCT cu."customer_id",
       cu."first_name",
       cu."last_name",
       c."city"
FROM   "customer" AS cu
JOIN   "address"  AS a ON cu."address_id" = a."address_id"
JOIN   "city"     AS c ON a."city_id"    = c."city_id"
WHERE  c."city" LIKE 'A%' 
   OR  c."city" LIKE '%-%'
LIMIT 20;
```

```sql
--Description: 4) Inspect a handful of rentals made by these customers, adding the rental hours.
SELECT DISTINCT r."rental_id",
       r."customer_id",
       ROUND((JULIANDAY(r."return_date") - JULIANDAY(r."rental_date"))*24,2) AS "rental_hours"
FROM   "rental"  AS r
JOIN   "customer" AS cu ON r."customer_id" = cu."customer_id"
JOIN   "address"  AS a  ON cu."address_id" = a."address_id"
JOIN   "city"     AS c  ON a."city_id"     = c."city_id"
WHERE  (c."city" LIKE 'A%' OR c."city" LIKE '%-%')
LIMIT 20;
```

```sql
--Description: 5) Tie those rentals to the specific films that were rented.
SELECT DISTINCT r."rental_id",
       i."film_id",
       f."title"
FROM   "rental"  AS r
JOIN   "inventory" AS i ON r."inventory_id" = i."inventory_id"
JOIN   "film"      AS f ON i."film_id"      = f."film_id"
JOIN   "customer"  AS cu ON r."customer_id" = cu."customer_id"
JOIN   "address"   AS a  ON cu."address_id" = a."address_id"
JOIN   "city"      AS c  ON a."city_id"     = c."city_id"
WHERE  (c."city" LIKE 'A%' OR c."city" LIKE '%-%')
LIMIT 20;
```

```sql
--Description: 6) Associate each of those films with its category (many-to-many through film_category).
SELECT DISTINCT f."film_id",
       cat."category_id",
       cat."name"  AS "category_name"
FROM   "film"          AS f
JOIN   "film_category" AS fc  ON f."film_id"     = fc."film_id"
JOIN   "category"      AS cat ON fc."category_id"= cat."category_id"
LIMIT 20;
```

```sql
--Description: 7) Compute total rental hours per film category limited to the target cities, showing the top 20 categories.
SELECT cat."name" AS "category_name",
       SUM((JULIANDAY(r."return_date") - JULIANDAY(r."rental_date"))*24) AS "total_rental_hours"
FROM   "city"      AS c
JOIN   "address"   AS a  ON c."city_id"     = a."city_id"
JOIN   "customer"  AS cu ON a."address_id"  = cu."address_id"
JOIN   "rental"    AS r  ON cu."customer_id"= r."customer_id"
JOIN   "inventory" AS i  ON r."inventory_id"= i."inventory_id"
JOIN   "film_category" AS fc  ON i."film_id"= fc."film_id"
JOIN   "category"  AS cat ON fc."category_id" = cat."category_id"
WHERE  (c."city" LIKE 'A%' OR c."city" LIKE '%-%')
GROUP  BY cat."category_id"
ORDER  BY "total_rental_hours" DESC
LIMIT 20;
```

```sql
--Description: 8) FINAL ANSWER – pick the single film category with the highest total rental hours in those cities.
SELECT cat."name" AS "highest_rental_hours_category"
FROM   "city"      AS c
JOIN   "address"   AS a  ON c."city_id"     = a."city_id"
JOIN   "customer"  AS cu ON a."address_id"  = cu."address_id"
JOIN   "rental"    AS r  ON cu."customer_id"= r."customer_id"
JOIN   "inventory" AS i  ON r."inventory_id"= i."inventory_id"
JOIN   "film_category" AS fc  ON i."film_id"= fc."film_id"
JOIN   "category"  AS cat ON fc."category_id" = cat."category_id"
WHERE  (c."city" LIKE 'A%' OR c."city" LIKE '%-%')
GROUP  BY cat."category_id"
ORDER  BY SUM((JULIANDAY(r."return_date") - JULIANDAY(r."rental_date"))*24) DESC
LIMIT 1;
```
