--Description: 1) Peek at the cities whose names either start with 'A' or contain a hy-phen (‘-’).
SELECT DISTINCT "city_id",
       "city"
FROM "city"
WHERE "city" LIKE 'A%' 
   OR "city" LIKE '%-%'
