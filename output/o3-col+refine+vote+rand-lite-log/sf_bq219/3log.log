    GROUP BY 1, s."category_name", t.tot_liters
), qual AS (
    SELECT  "category_name"
    FROM    pct
    GROUP BY 1
    HAVING  COUNT(*) >= 24
       AND  AVG(pct_month) >= 1
), tbl AS (
    SELECT  p.mon,
            p."category_name",
            p.pct_month
    FROM    pct p
    JOIN    qual q USING ("category_name")
), pairs AS (
    SELECT  a."category_name"                        AS cat1,
            b."category_name"                        AS cat2,
            CORR(a.pct_month, b.pct_month)           AS corr_coef
    FROM    tbl a
    JOIN    tbl b
          ON a.mon = b.mon
         AND a."category_name" < b."category_name"   -- remove dups / self-pairs
    GROUP BY 1, 2
)
SELECT  cat1,
        cat2,
        corr_coef
FROM    pairs
ORDER BY corr_coef ASC
LIMIT 20;
```

