```sql
--Description: Calculate pair-wise Pearson correlations of monthly percentage shares between qualifying categories
WITH mon_tot AS (
    SELECT DATE_TRUNC('month',"date") mon,
           SUM("volume_sold_liters")  tot_liters
    FROM   "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE  "date" >= '2022-01-01'
    GROUP BY 1
), pct AS (
    SELECT  DATE_TRUNC('month',s."date") mon,
            s."category_name",
            SUM(s."volume_sold_liters")/t.tot_liters*100 AS pct_month
    FROM    "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES" s
    JOIN    mon_tot t ON DATE_TRUNC('month',s."date") = t.mon
    WHERE   s."date" >= '2022-01-01'
    GROUP BY 1,2,t.tot_liters
), qual AS (
    SELECT "category_name"
    FROM   pct
    GROUP BY 1
    HAVING COUNT(*) >= 24
       AND AVG(pct_month) >= 1
), tbl AS (
    SELECT  p.mon,
            p."category_name",
            p.pct_month
    FROM    pct p
    JOIN    qual q USING ("category_name")
), pairs AS (
    SELECT  a."category_name"  AS cat1,
            b."category_name"  AS cat2,
            CORR(a.pct_month, b.pct_month) AS corr_coef
    FROM    tbl a
    JOIN    tbl b
           ON a.mon = b.mon
          AND a."category_name" < b."category_name"   -- avoid duplicates / self-join
    GROUP BY 1,2
)
SELECT  cat1,
        cat2,
        corr_coef
FROM    pairs
ORDER BY corr_coef ASC
LIMIT 20;
```

