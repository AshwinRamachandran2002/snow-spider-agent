```sql
--Description: Compute each category’s monthly percentage share of total liters
WITH mon_tot AS (
    SELECT  DATE_TRUNC('month',"date") AS mon,
            SUM("volume_sold_liters")  AS tot_liters
    FROM    "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE   "date" >= '2022-01-01'
    GROUP BY 1
)
SELECT  TO_CHAR(s.mon,'YYYY-MM')           AS "month",
        s."category_name",
        SUM(s."volume_sold_liters")/t.tot_liters * 100  AS "pct_of_month"
FROM    "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES" s
JOIN    mon_tot t
        ON DATE_TRUNC('month',s."date") = t.mon
WHERE   s."date" >= '2022-01-01'
GROUP BY 1,2,t.tot_liters
ORDER BY 1,3 DESC
LIMIT 20;
