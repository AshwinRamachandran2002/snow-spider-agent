```sql
--Description: 1)  From Jan-2022 through the last fully-completed month, compute each category’s
--              monthly % share of total liters (“pct”), then summarise how many months it
--              appears and its average monthly %.  Result gives a quick look at the size /
--              longevity of every category.
WITH mon_tot AS (                         -- monthly total liters
    SELECT  DATE_TRUNC('month', "date")          AS mon,
            SUM("volume_sold_liters")            AS tot_liters
    FROM    "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE   "date" >= '2022-01-01'
      AND   "date" <  DATE_TRUNC('month', CURRENT_DATE())   -- drop current partial month
    GROUP BY 1
), pct AS (                                  -- % share per category / month
    SELECT  DATE_TRUNC('month', s."date")     AS mon,
            s."category_name",
            SUM(s."volume_sold_liters") / t.tot_liters * 100  AS pct_month
    FROM    "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES" s
    JOIN    mon_tot t
           ON DATE_TRUNC('month', s."date") = t.mon
    WHERE   s."date" >= '2022-01-01'
      AND   s."date" <  DATE_TRUNC('month', CURRENT_DATE())
    GROUP BY 1, s."category_name", t.tot_liters
)
SELECT  "category_name",
        COUNT(*)      AS months_present,
        AVG(pct_month)AS avg_monthly_pct
FROM    pct
GROUP BY 1
ORDER BY avg_monthly_pct DESC
LIMIT 20;
```

