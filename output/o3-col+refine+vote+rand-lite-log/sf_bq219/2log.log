```sql
--Description: 5) Compute each category’s average share of monthly liters (≥24 months only)  
--   *intermediate sample of 20 rows*
WITH month_totals AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           SUM("volume_sold_liters")   AS "tot_liters"
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date" >= '2022-01-01'
    GROUP BY DATE_TRUNC('month', "date")
), cat_month AS (
    SELECT DATE_TRUNC('month', s."date") AS "month",
           s."category_name",
           SUM(s."volume_sold_liters")   AS "cat_liters"
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
    WHERE s."date" >= '2022-01-01'
    GROUP BY DATE_TRUNC('month', s."date"), s."category_name"
)
SELECT 
    c."category_name",
    COUNT(*)                              AS "months_present",
    AVG(c."cat_liters"/m."tot_liters")    AS "avg_monthly_share"
FROM cat_month c
JOIN month_totals m
  ON c."month" = m."month"
GROUP BY c."category_name"
HAVING COUNT(*) >= 24
ORDER BY "avg_monthly_share" DESC
LIMIT 20;
```

