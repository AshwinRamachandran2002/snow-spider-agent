```sql
--Description: 10) Display monthly percentage shares for those two least-correlated categories side-by-side
WITH month_totals AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           SUM("volume_sold_liters")   AS "tot_liters"
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date" >= '2022-01-01'
    GROUP BY DATE_TRUNC('month', "date")
), cat_month AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           "category_name",
           SUM("volume_sold_liters")   AS "cat_liters"
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date" >= '2022-01-01'
    GROUP BY DATE_TRUNC('month', "date"), "category_name"
), shares AS (
    SELECT
        c."month",
        c."category_name",
        c."cat_liters"/m."tot_liters"   AS "share_pct"
    FROM cat_month c
    JOIN month_totals m
      ON c."month" = m."month"
), least_corr AS (
    SELECT 
        "cat_a" AS "category_1", 
        "cat_b" AS "category_2"
    FROM (
        /* Use query 9 (corr_tbl) again but just pick the minimum row */
        WITH month_totals AS (
            SELECT DATE_TRUNC('month', "date") AS "month",
                   SUM("volume_sold_liters")   AS "tot_liters"
            FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
            WHERE "date" >= '2022-01-01'
            GROUP BY DATE_TRUNC('month', "date")
        ), cat_month AS (
            SELECT DATE_TRUNC('month', "date") AS "month",
                   "category_name",
                   SUM("volume_sold_liters")   AS "cat_liters"
            FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
            WHERE "date" >= '2022-01-01'
            GROUP BY DATE_TRUNC('month', "date"), "category_name"
        ), shares AS (
            SELECT
                c."month",
                c."category_name",
                c."cat_liters"/m."tot_liters"   AS "share_pct"
            FROM cat_month c
            JOIN month_totals m
              ON c."month" = m."month"
        ), qualifying AS (
            SELECT 
                "category_name"
            FROM shares
            GROUP BY "category_name"
            HAVING COUNT(*) >= 24
               AND AVG("share_pct") >= 0.01
        ), x AS (
            SELECT s.*
            FROM shares s
            JOIN qualifying q
              ON s."category_name" = q."category_name"
        ), corr_tbl AS (
            SELECT 
                a."category_name"                         AS "cat_a",
                b."category_name"                         AS "cat_b",
                CORR(a."share_pct", b."share_pct")        AS "pearson_r"
            FROM x a
            JOIN x b
              ON a."month" = b."month"
             AND a."category_name" < b."category_name"
            GROUP BY a."category_name", b."category_name"
        )
        SELECT *
        FROM corr_tbl
        ORDER BY "pearson_r" ASC
        LIMIT 1
    )
)
SELECT 
    s1."month",
    s1."share_pct" AS "category_1_pct",
    s2."share_pct" AS "category_2_pct"
FROM shares s1
JOIN shares s2
  ON s1."month" = s2."month"
JOIN least_corr l
  ON s1."category_name" = l."category_1"
 AND s2."category_name" = l."category_2"
ORDER BY s1."month"
LIMIT 20;
```
