```sql
--Description: 
-- Thinking process:
-- • Build monthly data from 2022-01-01 through the last fully-completed month.
-- • Convert each category’s liters into percentage of that month’s total.
-- • Keep only categories that (a) appear in ≥ 24 months and (b) average ≥ 1 % share.
-- • Form every unordered pair of these qualifying categories and compute the
--   Pearson correlation of their monthly percentage series.
-- • Return the pair with the minimum correlation (i.e., the two categories that
--   move least alike in their monthly share of Iowa liquor sales).

WITH cat_month AS (          -- liters per category per month
    SELECT DATE_TRUNC('month', "date")            AS "month",
           "category_name",
           SUM("volume_sold_liters")              AS "cat_liters"
    FROM   "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE  "date" >= '2022-01-01'
       AND "date" <  DATE_TRUNC('month', CURRENT_DATE)   -- drop partial current month
    GROUP  BY "month", "category_name"
),  
tot_month AS (               -- total liters each month
    SELECT "month",
           SUM("cat_liters") AS "total_liters"
    FROM   cat_month
    GROUP  BY "month"
),
pct AS (                     -- category share (%) each month
    SELECT c."month",
           c."category_name",
           100 * c."cat_liters" / t."total_liters"  AS "pct_total"
    FROM   cat_month c
    JOIN   tot_month t USING ("month")
),
qual AS (                    -- categories that meet 24-month & ≥1 % average criteria
    SELECT "category_name"
    FROM   pct
    GROUP  BY "category_name"
    HAVING COUNT(*)      >= 24
       AND AVG("pct_total") >= 1
),
series AS (                  -- restricted to qualifying categories
    SELECT p."month",
           p."category_name",
           p."pct_total"
    FROM   pct  p
    JOIN   qual q USING ("category_name")
),
pairs AS (                   -- correlation for every unordered pair
    SELECT a."category_name"                        AS "cat1",
           b."category_name"                        AS "cat2",
           CORR(a."pct_total", b."pct_total")       AS "pearson_corr"
    FROM   series a
    JOIN   series b
           ON  a."month" = b."month"
           AND a."category_name" < b."category_name"
    GROUP  BY a."category_name", b."category_name"
)
SELECT "cat1", "cat2", "pearson_corr"
FROM   pairs
ORDER  BY "pearson_corr"        -- lowest (most negative) first
LIMIT  1;
```
