       "category_name",
       SUM("volume_sold_liters")   AS "cat_month_liters"
FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
WHERE "date" >= '2022-01-01'
GROUP BY "month", "category_name"
ORDER BY "month", "category_name"
LIMIT 20;
```

```sql
--Description: 6) Month-level percentage share of each category (first 20 rows)
WITH cat AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           "category_name",
           SUM("volume_sold_liters")   AS "cat_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month", "category_name"
),
tot AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           SUM("volume_sold_liters")   AS "total_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month"
)
SELECT cat."month",
       cat."category_name",
       100 * cat."cat_liters" / tot."total_liters" AS "pct_total"
FROM   cat
JOIN   tot USING ("month")
ORDER BY cat."month", cat."category_name"
LIMIT 20;
```

```sql
--Description: 7) For each category, count months (2022-present) where its share ≥ 1 %
WITH cat AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           "category_name",
           SUM("volume_sold_liters") AS "cat_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month", "category_name"
),
tot AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           SUM("volume_sold_liters")   AS "total_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month"
),
pct AS (
    SELECT cat."category_name",
           cat."month",
           100 * cat."cat_liters" / tot."total_liters" AS "pct_total"
    FROM cat JOIN tot USING ("month")
)
SELECT "category_name",
       COUNT(*) AS "months_ge_1pct"
FROM pct
WHERE "pct_total" >= 1
GROUP BY "category_name"
ORDER BY "months_ge_1pct" DESC
LIMIT 20;
```

```sql
--Description: 8) Categories averaging ≥ 1 % share AND present in ≥ 24 months (2022-present)
WITH cat AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           "category_name",
           SUM("volume_sold_liters") AS "cat_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month", "category_name"
),
tot AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           SUM("volume_sold_liters")   AS "total_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month"
),
pct AS (
    SELECT cat."category_name",
           cat."month",
           100 * cat."cat_liters" / tot."total_liters" AS "pct_total"
    FROM cat JOIN tot USING ("month")
)
SELECT "category_name",
       AVG("pct_total") AS "avg_pct",
       COUNT(*)         AS "months_observed"
FROM pct
GROUP BY "category_name"
HAVING COUNT(*) >= 24
   AND AVG("pct_total") >= 1
ORDER BY "avg_pct"
LIMIT 20;
```

```sql
--Description: 9) Month-level comparison table of two user-chosen categories (replace names)
WITH pct AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           "category_name",
           SUM("volume_sold_liters") AS "cat_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month", "category_name"
),
tot AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           SUM("volume_sold_liters")   AS "total_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month"
),
p AS (
    SELECT pct."month",
           pct."category_name",
           100 * pct."cat_liters" / tot."total_liters" AS "pct_total"
    FROM pct JOIN tot USING ("month")
    WHERE pct."category_name" IN ('VODKA', 'RUM')
)
SELECT *
FROM   p
ORDER BY "month", "category_name"
LIMIT 20;
```

```sql
--Description: 10) Illustrative Pearson correlation of monthly % shares between VODKA and RUM
WITH pct AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           "category_name",
           SUM("volume_sold_liters") AS "cat_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month", "category_name"
),
tot AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           SUM("volume_sold_liters")   AS "total_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month"
),
p AS (
    SELECT pct."month",
           pct."category_name",
           100 * pct."cat_liters" / tot."total_liters" AS "pct_total"
    FROM pct JOIN tot USING ("month")
    WHERE pct."category_name" IN ('VODKA', 'RUM')
),
pivoted AS (
    SELECT "month",
           MAX(CASE WHEN "category_name" = 'VODKA' THEN "pct_total" END) AS "vodka_pct",
           MAX(CASE WHEN "category_name" = 'RUM'   THEN "pct_total" END) AS "rum_pct"
    FROM p
    GROUP BY "month"
)
SELECT CORR("vodka_pct", "rum_pct") AS "pearson_corr_vodka_rum"
FROM pivoted
LIMIT 20;
```
