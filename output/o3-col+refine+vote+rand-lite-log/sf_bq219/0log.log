Query:
--Description: 
-- Thinking process:
-- • The previous query failed because the exact values “VODKA” and “RUM” do not exist in
--   "category_name"; instead they appear as parts of longer strings (e.g., “AMERICAN VODKAS”, “WHITE RUM”).
-- • Fix by re-classifying any category that CONTAINS “VODKA” as “VODKA” and any that CONTAINS “RUM” as “RUM”.
-- • Build monthly %-share series for those two broad groups from 2022-01-01 through the
--   last fully completed month, pivot to one column per group, and compute their Pearson correlation.

WITH cat AS (                     -- liters per broad (VODKA/RUM) category per month
    SELECT DATE_TRUNC('month', "date")                    AS "month",
           CASE
               WHEN "category_name" ILIKE '%VODKA%' THEN 'VODKA'
               WHEN "category_name" ILIKE '%RUM%'   THEN 'RUM'
           END                                           AS "broad_cat",
           SUM("volume_sold_liters")                     AS "cat_liters"
    FROM   "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE  "date" >= '2022-01-01'
       AND "date" <  DATE_TRUNC('month', CURRENT_DATE)   -- exclude current partial month
       AND ( "category_name" ILIKE '%VODKA%' OR "category_name" ILIKE '%RUM%' )
    GROUP  BY "month", "broad_cat"
),
tot AS (                      -- total liters each month (same date span)
    SELECT DATE_TRUNC('month', "date")                    AS "month",
           SUM("volume_sold_liters")                      AS "total_liters"
    FROM   "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE  "date" >= '2022-01-01'
       AND "date" <  DATE_TRUNC('month', CURRENT_DATE)
    GROUP  BY "month"
),
pct AS (                      -- % share per broad category per month
    SELECT c."month",
           c."broad_cat",
           100 * c."cat_liters" / t."total_liters"        AS "pct_total"
    FROM   cat c
    JOIN   tot t USING ("month")
),
pivoted AS (                  -- one column for VODKA, one for RUM
    SELECT "month",
           MAX(CASE WHEN "broad_cat" = 'VODKA' THEN "pct_total" END) AS "vodka_pct",
           MAX(CASE WHEN "broad_cat" = 'RUM'   THEN "pct_total" END) AS "rum_pct"
    FROM   pct
    GROUP  BY "month"
)
SELECT CORR("vodka_pct", "rum_pct")                       AS "pearson_corr_vodka_vs_rum"
FROM   pivoted
