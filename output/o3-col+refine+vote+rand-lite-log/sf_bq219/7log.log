Query:
--Description: 9) Compute every pair-wise Pearson correlation between the qualified categories’ monthly %-of-total liters (≥ 24 months since 2022-01-01 and ≥ 1 % average share) and list the 20 lowest correlation values.
WITH monthly_totals AS (                         -- total liters per month
    SELECT DATE_TRUNC('month', "date") AS "month",
           SUM("volume_sold_liters")   AS "total_liters"
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date" >= '2022-01-01'
    GROUP BY 1
), month_pct AS (                               -- % share per month per category
    SELECT DATE_TRUNC('month', s."date")        AS "month",
           s."category_name",
           SUM(s."volume_sold_liters") / t."total_liters" * 100 AS "pct_of_total"
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
    JOIN monthly_totals t  ON DATE_TRUNC('month', s."date") = t."month"
    WHERE s."date" >= '2022-01-01'
    GROUP BY 1,2, t."total_liters"
), qualified AS (                               -- categories meeting thresholds
    SELECT "category_name"
    FROM month_pct
    GROUP BY 1
    HAVING COUNT(DISTINCT "month") >= 24
       AND AVG("pct_of_total")    >= 1
), pairs AS (                                   -- compute correlations
    SELECT a."category_name"                        AS "cat1",
           b."category_name"                        AS "cat2",
           CORR(a."pct_of_total", b."pct_of_total") AS "pearson_corr"
    FROM month_pct a
    JOIN month_pct b
      ON a."month" = b."month"
     AND a."category_name" < b."category_name"
    WHERE a."category_name" IN (SELECT "category_name" FROM qualified)
      AND b."category_name" IN (SELECT "category_name" FROM qualified)
    GROUP BY 1,2
)
SELECT "cat1",
       "cat2",
       "pearson_corr"
FROM pairs
ORDER BY "pearson_corr" ASC
LIMIT 20
