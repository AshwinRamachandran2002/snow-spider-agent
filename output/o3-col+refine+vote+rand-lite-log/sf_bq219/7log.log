```sql
--Description: 5) Calculate liters sold per category per month (post-2022).
SELECT 
  DATE_TRUNC('month',"date") AS "month",
  "category_name",
  SUM("volume_sold_liters") AS "category_liters"
FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
WHERE "date" >= '2022-01-01'
GROUP BY 1,2
ORDER BY 1,3 DESC
LIMIT 20;
```

```sql
--Description: 6) Derive monthly percent share of each category (≥ 2022) relative to that month’s total liters.
WITH monthly_totals AS (
  SELECT DATE_TRUNC('month',"date") AS "month",
         SUM("volume_sold_liters") AS "total_liters"
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
  WHERE "date" >= '2022-01-01'
  GROUP BY 1
)
SELECT 
  m."month",
  s."category_name",
  SUM(s."volume_sold_liters") / m."total_liters" * 100 AS "pct_of_total"
FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
JOIN monthly_totals m
  ON DATE_TRUNC('month',s."date") = m."month"
WHERE s."date" >= '2022-01-01'
GROUP BY m."month", s."category_name", m."total_liters"
ORDER BY m."month", "pct_of_total" DESC
LIMIT 20;
```

```sql
--Description: 7) Find categories that appear in at least 24 distinct months (≥ 2022) AND whose average monthly share ≥ 1 %.
WITH month_pct AS (
  WITH monthly_totals AS (
    SELECT DATE_TRUNC('month',"date") AS "month",
           SUM("volume_sold_liters") AS "total_liters"
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date" >= '2022-01-01'
    GROUP BY 1
  )
  SELECT 
    DATE_TRUNC('month',s."date") AS "month",
    s."category_name",
    SUM(s."volume_sold_liters") / m."total_liters" * 100 AS "pct_of_total"
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
  JOIN monthly_totals m
    ON DATE_TRUNC('month',s."date") = m."month"
  WHERE s."date" >= '2022-01-01'
  GROUP BY 1,2, m."total_liters"
)
SELECT 
  "category_name",
  COUNT(DISTINCT "month")        AS "month_count",
  AVG("pct_of_total")            AS "avg_monthly_pct"
FROM month_pct
GROUP BY 1
HAVING COUNT(DISTINCT "month") >= 24
   AND AVG("pct_of_total") >= 1
ORDER BY "avg_monthly_pct" DESC
LIMIT 20;
```

```sql
--Description: 8) Pivot the qualified categories into columns of monthly percentages to prepare for pair-wise correlation.
WITH month_pct AS (
  WITH monthly_totals AS (
    SELECT DATE_TRUNC('month',"date") AS "month",
           SUM("volume_sold_liters") AS "total_liters"
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date" >= '2022-01-01'
    GROUP BY 1
  )
  SELECT 
    DATE_TRUNC('month',s."date") AS "month",
    s."category_name",
    SUM(s."volume_sold_liters") / m."total_liters" * 100 AS "pct_of_total"
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
  JOIN monthly_totals m
    ON DATE_TRUNC('month',s."date") = m."month"
  WHERE s."date" >= '2022-01-01'
  GROUP BY 1,2, m."total_liters"
),
qualified AS (
  SELECT "category_name"
  FROM month_pct
  GROUP BY 1
  HAVING COUNT(DISTINCT "month") >= 24
     AND AVG("pct_of_total") >= 1
)
SELECT *
FROM month_pct
WHERE "category_name" IN (SELECT "category_name" FROM qualified)
PIVOT(
  AVG("pct_of_total") FOR "category_name" IN (SELECT "category_name" FROM qualified ORDER BY "category_name" LIMIT 20)
)
ORDER BY "month"
LIMIT 20;
```

```sql
--Description: 9) Compute every pairwise Pearson correlation between qualified categories’ monthly percentages, and list the 20 lowest correlations (closer to ‑1).
WITH month_pct AS (
  WITH monthly_totals AS (
    SELECT DATE_TRUNC('month',"date") AS "month",
           SUM("volume_sold_liters") AS "total_liters"
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date" >= '2022-01-01'
    GROUP BY 1
  )
  SELECT 
    DATE_TRUNC('month',s."date") AS "month",
    s."category_name",
    SUM(s."volume_sold_liters") / m."total_liters" * 100 AS "pct_of_total"
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
  JOIN monthly_totals m
    ON DATE_TRUNC('month',s."date") = m."month"
  WHERE s."date" >= '2022-01-01'
  GROUP BY 1,2, m."total_liters"
),
qualified AS (
  SELECT "category_name"
  FROM month_pct
  GROUP BY 1
  HAVING COUNT(DISTINCT "month") >= 24
     AND AVG("pct_of_total") >= 1
),
matrix AS (
  SELECT 
    "month",
    "category_name",
    "pct_of_total"
  FROM month_pct
  WHERE "category_name" IN (SELECT "category_name" FROM qualified)
),
pairs AS (
  SELECT 
    a."category_name"  AS "cat1",
    b."category_name"  AS "cat2",
    CORR(a."pct_of_total", b."pct_of_total") AS "pearson_corr"
  FROM matrix a
  JOIN matrix b
    ON a."month" = b."month"
   AND a."category_name" < b."category_name"
  GROUP BY 1,2
)
SELECT 
  "cat1",
  "cat2",
  "pearson_corr"
FROM pairs
ORDER BY "pearson_corr" ASC
LIMIT 20;
```

