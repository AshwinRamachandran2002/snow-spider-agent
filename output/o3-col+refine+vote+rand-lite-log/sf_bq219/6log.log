```

```sql
--Description: 4. Display monthly volume sold for five example categories to understand their scales
SELECT DATE_TRUNC('month',"date") AS "month",
       SUM(CASE WHEN "category_name" ILIKE '%VODKA%'            THEN "volume_sold_liters" END) AS "vodka_liters",
       SUM(CASE WHEN "category_name" ILIKE '%WHISKEY%'          THEN "volume_sold_liters" END) AS "whiskey_liters",
       SUM(CASE WHEN "category_name" ILIKE '%TEQUILA%'          THEN "volume_sold_liters" END) AS "tequila_liters",
       SUM(CASE WHEN "category_name" ILIKE '%RUM%'              THEN "volume_sold_liters" END) AS "rum_liters",
       SUM(CASE WHEN "category_name" ILIKE '%CORDIALS%'         THEN "volume_sold_liters" END) AS "cordials_liters"
FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
WHERE "date" >= '2022-01-01'
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 5. Count how many months each category has recorded sales (helps locate 24-month-plus series)
SELECT "category_name",
       COUNT(DISTINCT DATE_TRUNC('month',"date")) AS "active_months"
FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
WHERE "date" >= '2022-01-01'
GROUP BY 1
ORDER BY "active_months" DESC
LIMIT 20;
```

```sql
--Description: 6. Calculate every category’s monthly share of total litres sold (percent of grand total)
SELECT DATE_TRUNC('month',"date") AS "month",
       "category_name",
       SUM("volume_sold_liters") AS "cat_liters",
       SUM("volume_sold_liters") / SUM(SUM("volume_sold_liters")) OVER (PARTITION BY DATE_TRUNC('month',"date")) AS "pct_of_month"
FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
WHERE "date" >= '2022-01-01'
GROUP BY 1,2
ORDER BY 1,3 DESC
LIMIT 20;
```

```sql
--Description: 7. Derive average monthly percentage for each category and keep those averaging ≥1%
SELECT "category_name",
       AVG("pct_of_month") AS "avg_monthly_pct"
FROM (
     SELECT DATE_TRUNC('month',"date") AS "month",
            "category_name",
            SUM("volume_sold_liters") / SUM(SUM("volume_sold_liters")) OVER (PARTITION BY DATE_TRUNC('month',"date")) AS "pct_of_month"
     FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
     WHERE "date" >= '2022-01-01'
     GROUP BY 1,2
) sub
GROUP BY 1
HAVING AVG("pct_of_month") >= 0.01
ORDER BY "avg_monthly_pct"
LIMIT 20;
```

```sql
--Description: 8. Build a month-by-category pivot (only categories with ≥1% average share & ≥24 months)
WITH qualifying AS (
     SELECT "category_name"
     FROM (
          SELECT "category_name",
                 AVG("pct_of_month")               AS "avg_monthly_pct",
                 COUNT(DISTINCT "month")           AS "months"
          FROM (
               SELECT DATE_TRUNC('month',"date") AS "month",
                      "category_name",
                      SUM("volume_sold_liters") / SUM(SUM("volume_sold_liters")) OVER (PARTITION BY DATE_TRUNC('month',"date")) AS "pct_of_month"
               FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
               WHERE "date" >= '2022-01-01'
               GROUP BY 1,2
          ) q1
          GROUP BY 1
     ) q2
     WHERE q2."avg_monthly_pct" >= 0.01
       AND q2."months"          >= 24
)
SELECT DATE_TRUNC('month',"date")                                             AS "month",
       LISTAGG(DISTINCT "category_name", ', ') WITHIN GROUP (ORDER BY 1)      AS "categories_present"
FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
WHERE "date" >= '2022-01-01'
  AND "category_name" IN (SELECT "category_name" FROM qualifying)
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 9. Example: obtain correlation between two chosen qualifying categories’ monthly shares
WITH monthly_pct AS (
     SELECT DATE_TRUNC('month',"date") AS "month",
            SUM(CASE WHEN "category_name" = 'STRAIGHT BOURBON WHISKIES'        THEN "volume_sold_liters" END) /
            SUM("volume_sold_liters") OVER (PARTITION BY DATE_TRUNC('month',"date")) AS "bourbon_pct",
            SUM(CASE WHEN "category_name" = 'IMPORTED VODKA'                   THEN "volume_sold_liters" END) /
            SUM("volume_sold_liters") OVER (PARTITION BY DATE_TRUNC('month',"date")) AS "vodka_pct"
     FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
     WHERE "date" >= '2022-01-01'
     GROUP BY 1
)
SELECT CORR("bourbon_pct","vodka_pct") AS "pearson_corr"
FROM monthly_pct
LIMIT 20;
```

```sql
--Description: 10. Search across all pairs of qualifying categories for the 20 lowest correlations
WITH qualifying AS (
     SELECT "category_name"
     FROM (
          SELECT "category_name",
                 AVG("pct_of_month") AS "avg_pct",
                 COUNT(DISTINCT "month") AS "mnths"
          FROM (
               SELECT DATE_TRUNC('month',"date") AS "month",
                      "category_name",
                      SUM("volume_sold_liters") /
                      SUM(SUM("volume_sold_liters")) OVER (PARTITION BY DATE_TRUNC('month',"date")) AS "pct_of_month"
               FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
               WHERE "date" >= '2022-01-01'
               GROUP BY 1,2
          ) x
          GROUP BY 1
     ) y
     WHERE "avg_pct" >= 0.01 AND "mnths" >= 24
),
monthly AS (
     SELECT DATE_TRUNC('month',"date") AS "month",
            "category_name",
            SUM("volume_sold_liters") /
            SUM(SUM("volume_sold_liters")) OVER (PARTITION BY DATE_TRUNC('month',"date")) AS "pct_of_month"
     FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
     WHERE "date" >= '2022-01-01'
       AND "category_name" IN (SELECT "category_name" FROM qualifying)
     GROUP BY 1,2
),
pivoted AS (
     SELECT "month",
            OBJECT_AGG("category_name", "pct_of_month") AS "pct_map"
     FROM monthly
     GROUP BY 1
),
pairs AS (
     SELECT q1."category_name" AS "cat1",
            q2."category_name" AS "cat2"
     FROM qualifying q1
     JOIN qualifying q2
       ON q1."category_name" < q2."category_name"
)
SELECT p."cat1",
       p."cat2",
       CORR(m1."pct_of_month", m2."pct_of_month") AS "pearson_corr"
FROM pairs p
JOIN monthly m1 ON m1."category_name" = p."cat1"
JOIN monthly m2 ON m2."category_name" = p."cat2"
               AND m1."month"        = m2."month"
GROUP BY 1,2
ORDER BY "pearson_corr" ASC
LIMIT 20;
```
