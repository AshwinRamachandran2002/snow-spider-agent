```sql
--Description: Identify the two liquor categories (each averaging ≥1 % of monthly litres for ≥24 months since 2022-01-01) that exhibit the lowest Pearson correlation
--             between their monthly percentage shares of total sales.  Steps inside one query:
--   1) qualifying – find categories meeting the 1 %-average & 24-month criteria.
--   2) monthly  – compute every qualifying category’s share of litres each month.
--   3) pairs   – create every unique unordered pair of qualifying categories.
--   4) correlations – calculate CORR() for each pair’s monthly share series.
--   5) final SELECT – return the single pair with the smallest correlation.
WITH qualifying AS (
    SELECT "category_name"
    FROM (
        SELECT
            "category_name",
            AVG("pct_of_month")                      AS "avg_pct",
            COUNT(DISTINCT "month")                  AS "months"
        FROM (
            SELECT
                DATE_TRUNC('month', "date")          AS "month",
                "category_name",
                SUM("volume_sold_liters")
                  / SUM(SUM("volume_sold_liters")) OVER (PARTITION BY DATE_TRUNC('month', "date"))
                                                    AS "pct_of_month"
            FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
            WHERE "date" >= '2022-01-01'
            GROUP BY 1, 2
        ) sub
        GROUP BY 1
    )
    WHERE "avg_pct" >= 0.01
      AND "months"  >= 24
),
monthly AS (
    SELECT
        DATE_TRUNC('month', "date")                  AS "month",
        "category_name",
        SUM("volume_sold_liters")
          / SUM(SUM("volume_sold_liters")) OVER (PARTITION BY DATE_TRUNC('month', "date"))
                                                  AS "pct_of_month"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
      AND "category_name" IN (SELECT "category_name" FROM qualifying)
    GROUP BY 1, 2
),
pairs AS (
    SELECT
        q1."category_name" AS "cat1",
        q2."category_name" AS "cat2"
    FROM qualifying q1
    JOIN qualifying q2
      ON q1."category_name" < q2."category_name"
),
correlations AS (
    SELECT
        p."cat1",
        p."cat2",
        CORR(m1."pct_of_month", m2."pct_of_month")  AS "pearson_corr"
    FROM pairs      p
    JOIN monthly    m1 ON m1."category_name" = p."cat1"
    JOIN monthly    m2 ON m2."category_name" = p."cat2"
                       AND m1."month"        = m2."month"
    GROUP BY p."cat1", p."cat2"
)
SELECT
    "cat1" AS "category_name_1",
    "cat2" AS "category_name_2",
    "pearson_corr"
FROM correlations
ORDER BY "pearson_corr" ASC
LIMIT 1;
