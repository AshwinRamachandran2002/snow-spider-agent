--Description: 5) Average monthly share and number of months available for every category; we’ll need this to apply the “≥1% & ≥24 months” rule
WITH per_m AS (
  -- shares for every month-category
  WITH state_m AS (
    SELECT DATE_TRUNC('month',"date") AS mth,
           SUM("volume_sold_liters") AS state_vol
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date">='2022-01-01'
    GROUP BY 1
  )
  SELECT 
    DATE_TRUNC('month',"date") AS mth,
    "category_name",
    SUM("volume_sold_liters")/state_m.state_vol AS pct_state
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
  JOIN state_m ON DATE_TRUNC('month',s."date") = state_m.mth
  WHERE s."date">='2022-01-01'
  GROUP BY 1,2,state_m.state_vol
)
SELECT
  "category_name",
  COUNT(*)            AS months_in_sample,
  AVG(pct_state)      AS avg_monthly_pct
FROM per_m
GROUP BY 1
ORDER BY avg_monthly_pct DESC
LIMIT 20;
