```sql
--Description: 1) Quick look at recent records (from 2022-01-01 on) to remind ourselves of the columns we’ll work with
SELECT 
  "date",
  "category_name",
  "volume_sold_liters",
  "sale_dollars",
  "bottles_sold",
  "vendor_name"
FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
WHERE "date" >= '2022-01-01'
LIMIT 20;
```

```sql
--Description: 2) Month-level total volume (liters) for the whole state beginning 2022-01-01
SELECT 
  DATE_TRUNC('month', "date") AS "month",
  SUM("volume_sold_liters") AS "state_vol_liters"
FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
WHERE "date" >= '2022-01-01'
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 3) Month-level total volume (liters) for every liquor category in the same period
SELECT
  DATE_TRUNC('month', "date") AS "month",
  "category_name",
  SUM("volume_sold_liters") AS "cat_vol_liters"
FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
WHERE "date" >= '2022-01-01'
GROUP BY 1,2
ORDER BY 1,3 DESC
LIMIT 20;
```

```sql
--Description: 4) Monthly share (%) of each category relative to the state total (limit 20 rows just to sample)
WITH state_m AS (
  SELECT DATE_TRUNC('month',"date") AS mth,
         SUM("volume_sold_liters") AS state_vol
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
  WHERE "date">='2022-01-01'
  GROUP BY 1
)
SELECT 
  c.mth,
  c."category_name",
  (c.cat_vol/state_m.state_vol) AS pct_of_state
FROM (
  SELECT DATE_TRUNC('month',"date") AS mth,
         "category_name",
         SUM("volume_sold_liters") AS cat_vol
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
  WHERE "date">='2022-01-01'
  GROUP BY 1,2
) c
JOIN state_m ON c.mth = state_m.mth
ORDER BY c.mth, pct_of_state DESC
LIMIT 20;
```

```sql
--Description: 5) Average monthly share and number of months available for every category; we’ll need this to apply the “≥1% & ≥24 months” rule
WITH per_m AS (
  -- shares for every month-category
  WITH state_m AS (
    SELECT DATE_TRUNC('month',"date") AS mth,
           SUM("volume_sold_liters") AS state_vol
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date">='2022-01-01'
    GROUP BY 1
  )
  SELECT 
    DATE_TRUNC('month',"date") AS mth,
    "category_name",
    SUM("volume_sold_liters")/state_m.state_vol AS pct_state
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
  JOIN state_m ON DATE_TRUNC('month',s."date") = state_m.mth
  WHERE s."date">='2022-01-01'
  GROUP BY 1,2,state_m.state_vol
)
SELECT
  "category_name",
  COUNT(*)            AS months_in_sample,
  AVG(pct_state)      AS avg_monthly_pct
FROM per_m
GROUP BY 1
ORDER BY avg_monthly_pct DESC
LIMIT 20;
```

```sql
--Description: 6) List only the categories satisfying “≥1 % average share” and “≥24 months”; this is the pool we’ll later test correlations on
WITH per_m AS (
  WITH state_m AS (
    SELECT DATE_TRUNC('month',"date") AS mth,
           SUM("volume_sold_liters") AS state_vol
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date">='2022-01-01'
    GROUP BY 1
  )
  SELECT 
    DATE_TRUNC('month',"date") AS mth,
    "category_name",
    SUM("volume_sold_liters")/state_m.state_vol AS pct_state
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
  JOIN state_m ON DATE_TRUNC('month',s."date") = state_m.mth
  WHERE s."date">='2022-01-01'
  GROUP BY 1,2,state_m.state_vol
)
SELECT
  "category_name",
  COUNT(*)       AS months_in_sample,
  ROUND(AVG(pct_state),4) AS avg_monthly_pct
FROM per_m
GROUP BY 1
HAVING COUNT(*) >= 24
   AND AVG(pct_state) >= 0.01
ORDER BY avg_monthly_pct ASC
LIMIT 20;
```

```sql
--Description: 7) Show the month-by-month percentages for the short-listed categories (again limited to 20 rows for browsing)
WITH shortlist AS (
  -- pull the categories from previous step
  WITH per_m AS (
    WITH state_m AS (
      SELECT DATE_TRUNC('month',"date") AS mth,
             SUM("volume_sold_liters") AS state_vol
      FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
      WHERE "date">='2022-01-01'
      GROUP BY 1
    )
    SELECT 
      DATE_TRUNC('month',"date") AS mth,
      "category_name",
      SUM("volume_sold_liters")/state_m.state_vol AS pct_state
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
    JOIN state_m ON DATE_TRUNC('month',s."date") = state_m.mth
    WHERE s."date">='2022-01-01'
    GROUP BY 1,2,state_m.state_vol
  )
  SELECT 
    "category_name"
  FROM per_m
  GROUP BY 1
  HAVING COUNT(*) >= 24
     AND AVG(pct_state) >= 0.01
)
, per_m AS (
  WITH state_m AS (
    SELECT DATE_TRUNC('month',"date") AS mth,
           SUM("volume_sold_liters") AS state_vol
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date">='2022-01-01'
    GROUP BY 1
  )
  SELECT 
    DATE_TRUNC('month',"date") AS mth,
    "category_name",
    SUM("volume_sold_liters")/state_m.state_vol AS pct_state
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
  JOIN state_m ON DATE_TRUNC('month',s."date") = state_m.mth
  WHERE s."date">='2022-01-01'
  GROUP BY 1,2,state_m.state_vol
)
SELECT 
  p.mth,
  p."category_name",
  ROUND(p.pct_state,4) AS pct_of_state
FROM per_m p
JOIN shortlist l USING ("category_name")
ORDER BY p.mth, p."category_name"
LIMIT 20;
