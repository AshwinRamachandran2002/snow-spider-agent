```sql
--Description: Single query that (1) builds monthly state totals, (2) converts every category’s
--             liters to a monthly %-of-state, (3) short-lists categories with ≥24 months of data
--             since 2022-01-01 AND an average share ≥1 %, (4) computes the Pearson correlation
--             between every pair of those categories, and (5) returns the single pair whose
--             correlation is the lowest (weakest relationship).
WITH state_m AS (  /* step-1: total liters per month statewide */
    SELECT DATE_TRUNC('month', "date") AS mth,
           SUM("volume_sold_liters")   AS state_vol
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date" >= '2022-01-01'
    GROUP BY 1
), per_m AS (      /* step-2: each category’s share of that month’s volume */
    SELECT DATE_TRUNC('month', s."date") AS mth,
           s."category_name",
           SUM(s."volume_sold_liters") / st.state_vol AS pct_state
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
    JOIN state_m st
         ON DATE_TRUNC('month', s."date") = st.mth
    WHERE s."date" >= '2022-01-01'
    GROUP BY 1, 2, st.state_vol
), shortlist AS (  /* step-3: keep categories meeting both business rules */
    SELECT "category_name"
    FROM per_m
    GROUP BY 1
    HAVING COUNT(*) >= 24
       AND AVG(pct_state) >= 0.01
), corr_pairs AS ( /* step-4: correlation for every qualifying pair */
    SELECT
        c1."category_name" AS category_1,
        c2."category_name" AS category_2,
        CORR(c1.pct_state, c2.pct_state) AS pearson_corr
    FROM per_m c1
    JOIN per_m c2
      ON c1.mth = c2.mth
    JOIN shortlist s1 ON c1."category_name" = s1."category_name"
    JOIN shortlist s2 ON c2."category_name" = s2."category_name"
    WHERE c1."category_name" < c2."category_name"   -- avoid duplicates/self-pairing
    GROUP BY 1, 2
)
SELECT category_1,
       category_2,
       pearson_corr
FROM corr_pairs                      /* step-5: lowest correlation = weakest similarity */
ORDER BY pearson_corr ASC
LIMIT 1;
```
