```sql
--Description: 8) Compute Pearson correlation between two example categories (replace names as needed) across the months
WITH per_m AS (
  WITH state_m AS (
    SELECT DATE_TRUNC('month',"date") AS mth,
           SUM("volume_sold_liters") AS state_vol
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date">='2022-01-01'
    GROUP BY 1
  )
  SELECT 
    DATE_TRUNC('month',"date") AS mth,
    "category_name",
    SUM("volume_sold_liters")/state_m.state_vol AS pct_state
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
  JOIN state_m ON DATE_TRUNC('month',s."date") = state_m.mth
  WHERE s."date">='2022-01-01'
  GROUP BY 1,2,state_m.state_vol
)
SELECT
  CORR(c1.pct_state, c2.pct_state) AS pearson_corr,
  c1."category_name" AS cat_1,
  c2."category_name" AS cat_2
FROM per_m c1
JOIN per_m c2
  ON c1.mth = c2.mth
WHERE c1."category_name" = 'VODKA'              -- example
  AND c2."category_name" = 'BRANDY'             -- example
LIMIT 20;
```

```sql
--Description: 9) Build a correlation matrix for every pair of short-listed categories (limited output)
WITH shortlist AS (
  /* exact same CTE as in query 7 to get the qualifying category names */
  WITH per_m AS (
    WITH state_m AS (
      SELECT DATE_TRUNC('month',"date") AS mth,
             SUM("volume_sold_liters") AS state_vol
      FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
      WHERE "date">='2022-01-01'
      GROUP BY 1
    )
    SELECT 
      DATE_TRUNC('month',"date") AS mth,
      "category_name",
      SUM("volume_sold_liters")/state_m.state_vol AS pct_state
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
    JOIN state_m ON DATE_TRUNC('month',s."date") = state_m.mth
    WHERE s."date">='2022-01-01'
    GROUP BY 1,2,state_m.state_vol
  )
  SELECT "category_name"
  FROM per_m
  GROUP BY 1
  HAVING COUNT(*) >= 24
     AND AVG(pct_state) >= 0.01
)
, per_m AS (
  WITH state_m AS (
    SELECT DATE_TRUNC('month',"date") AS mth,
           SUM("volume_sold_liters") AS state_vol
    FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
    WHERE "date">='2022-01-01'
    GROUP BY 1
  )
  SELECT 
    DATE_TRUNC('month',"date") AS mth,
    "category_name",
    SUM("volume_sold_liters")/state_m.state_vol AS pct_state
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES s
  JOIN state_m ON DATE_TRUNC('month',s."date") = state_m.mth
  WHERE s."date">='2022-01-01'
  GROUP BY 1,2,state_m.state_vol
)
SELECT 
  c1."category_name" AS cat_1,
  c2."category_name" AS cat_2,
  CORR(c1.pct_state, c2.pct_state) AS pearson_corr
FROM per_m c1
JOIN per_m c2
  ON c1.mth = c2.mth
JOIN shortlist s1 ON c1."category_name" = s1."category_name"
JOIN shortlist s2 ON c2."category_name" = s2."category_name"
WHERE c1."category_name" < c2."category_name"
ORDER BY pearson_corr ASC
LIMIT 20;
