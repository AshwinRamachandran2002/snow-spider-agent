```sql
--Description: 6.  Build monthly percentage contribution for each category (litres / grand total)  
--(first 20 rows only for a quick look)
WITH month_tot AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         SUM("volume_sold_liters") AS "tot_litres"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
  GROUP BY "month"
),
cat_month AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         "category_name",
         SUM("volume_sold_liters") AS "cat_litres"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
  GROUP BY "month", "category_name"
)
SELECT 
  c."month",
  c."category_name",
  100.0 * c."cat_litres" / m."tot_litres" AS "pct_of_month"
FROM cat_month c
JOIN month_tot m USING ("month")
ORDER BY c."month", c."category_name"
LIMIT 20;
```

```sql
--Description: 7.  Identify categories that appear in at least 24 different months since 2022-01
WITH cat_months AS (
  SELECT "category_name",
         COUNT(DISTINCT DATE_TRUNC('month', "date")) AS "months_present"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
  GROUP BY "category_name"
)
SELECT *
FROM cat_months
WHERE "months_present" >= 24
ORDER BY "months_present" DESC
LIMIT 20;
```

```sql
--Description: 8.  From those ≥24-month categories, keep only ones whose average monthly share ≥1 %
WITH month_tot AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         SUM("volume_sold_liters") AS "tot_litres"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
  GROUP BY "month"
),
cat_month AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         "category_name",
         SUM("volume_sold_liters") AS "cat_litres"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
  GROUP BY "month", "category_name"
),
pct AS (
  SELECT c."category_name",
         100.0 * c."cat_litres" / m."tot_litres" AS "pct_of_month"
  FROM cat_month c
  JOIN month_tot m USING ("month")
),
stats AS (
  SELECT "category_name",
         COUNT(*) AS "months",
         AVG("pct_of_month") AS "avg_pct"
  FROM pct
  GROUP BY "category_name"
)
SELECT *
FROM stats
WHERE "months" >= 24
  AND "avg_pct" >= 1
ORDER BY "avg_pct" DESC
LIMIT 20;
```

```sql
--Description: 9.  Example: calculate the Pearson correlation between two specific categories’ monthly %
--(replace the category names with actual ones you want to test)
WITH month_tot AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         SUM("volume_sold_liters") AS "tot_litres"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
  GROUP BY "month"
),
cat_month AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         "category_name",
         SUM("volume_sold_liters") AS "cat_litres"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
  GROUP BY "month", "category_name"
),
pct AS (
  SELECT c."month",
         c."category_name",
         100.0 * c."cat_litres" / m."tot_litres" AS "pct_of_month"
  FROM cat_month c
  JOIN month_tot m USING ("month")
),
wide AS (
  SELECT p1."month",
         MAX(CASE WHEN p1."category_name" = 'Category A' THEN p1."pct_of_month" END) AS "pct_A",
         MAX(CASE WHEN p1."category_name" = 'Category B' THEN p1."pct_of_month" END) AS "pct_B"
  FROM pct p1
  GROUP BY p1."month"
  HAVING COUNT(DISTINCT p1."category_name") = 2
)
SELECT CORR("pct_A", "pct_B") AS "pearson_corr"
FROM wide
LIMIT 20;
```

```sql
--Description: 10.  (Exploratory)--Find the 20 lowest correlations among every pair of qualifying categories
WITH month_tot AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         SUM("volume_sold_liters") AS "tot_litres"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
  GROUP BY "month"
),
cat_month AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         "category_name",
         SUM("volume_sold_liters") AS "cat_litres"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
  GROUP BY "month", "category_name"
),
pct AS (
  SELECT c."month",
         c."category_name",
         100.0 * c."cat_litres" / m."tot_litres" AS "pct_of_month"
  FROM cat_month c
  JOIN month_tot m USING ("month")
),
qual AS (
  SELECT "category_name"
  FROM pct
  GROUP BY "category_name"
  HAVING COUNT(*) >= 24
     AND AVG("pct_of_month") >= 1
),
matrix AS (
  SELECT 
      p1."month",
      p1."category_name"  AS "cat1",
      p2."category_name"  AS "cat2",
      p1."pct_of_month"   AS "pct1",
      p2."pct_of_month"   AS "pct2"
  FROM pct p1
  JOIN pct p2
    ON p1."month" = p2."month"
   AND p1."category_name" < p2."category_name"
  WHERE p1."category_name" IN (SELECT "category_name" FROM qual)
    AND p2."category_name" IN (SELECT "category_name" FROM qual)
),
pair_corr AS (
  SELECT
     "cat1",
     "cat2",
     CORR("pct1", "pct2") AS "pearson_corr"
  FROM matrix
  GROUP BY "cat1", "cat2"
)
SELECT *
FROM pair_corr
ORDER BY "pearson_corr" ASC
LIMIT 20;
```

