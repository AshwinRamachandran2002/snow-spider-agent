--Description: 9.  Example: calculate the Pearson correlation between two specific categories’ monthly %
--(replace the category names with actual ones you want to test)
WITH month_tot AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         SUM("volume_sold_liters") AS "tot_litres"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
  GROUP BY "month"
),
cat_month AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         "category_name",
         SUM("volume_sold_liters") AS "cat_litres"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
  GROUP BY "month", "category_name"
),
pct AS (
  SELECT c."month",
         c."category_name",
         100.0 * c."cat_litres" / m."tot_litres" AS "pct_of_month"
  FROM cat_month c
  JOIN month_tot m USING ("month")
),
wide AS (
  SELECT p1."month",
         MAX(CASE WHEN p1."category_name" = 'Category A' THEN p1."pct_of_month" END) AS "pct_A",
         MAX(CASE WHEN p1."category_name" = 'Category B' THEN p1."pct_of_month" END) AS "pct_B"
  FROM pct p1
  GROUP BY p1."month"
  HAVING COUNT(DISTINCT p1."category_name") = 2
)
SELECT CORR("pct_A", "pct_B") AS "pearson_corr"
FROM wide
LIMIT 20;
