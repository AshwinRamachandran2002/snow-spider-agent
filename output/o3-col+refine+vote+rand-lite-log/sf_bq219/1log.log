--Description: 6.  Build monthly percentage contribution for each category (litres / grand total)  
--(first 20 rows only for a quick look)
WITH month_tot AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         SUM("volume_sold_liters") AS "tot_litres"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
  GROUP BY "month"
),
cat_month AS (
  SELECT DATE_TRUNC('month', "date") AS "month",
         "category_name",
         SUM("volume_sold_liters") AS "cat_litres"
  FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
  WHERE "date" >= '2022-01-01'
  GROUP BY "month", "category_name"
)
SELECT 
  c."month",
  c."category_name",
  100.0 * c."cat_litres" / m."tot_litres" AS "pct_of_month"
FROM cat_month c
JOIN month_tot m USING ("month")
ORDER BY c."month", c."category_name"
LIMIT 20;
