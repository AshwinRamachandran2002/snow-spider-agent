ORDER BY "month"
LIMIT 20;
```

```sql
--Description: Identify categories that have sales in at least 24 distinct months since Jan-2022 (first 20).  
SELECT "category_name",
       COUNT(DISTINCT DATE_TRUNC('month', "date")) AS "months_with_sales"
FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
WHERE "date" >= '2022-01-01'
GROUP BY "category_name"
HAVING COUNT(DISTINCT DATE_TRUNC('month', "date")) >= 24
ORDER BY "months_with_sales" DESC
LIMIT 20;
```

```sql
--Description: Compute the average monthly share of total volume for each category (show 20).  
WITH month_tot AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           SUM("volume_sold_liters")   AS "total_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month"
), month_cat AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           "category_name",
           SUM("volume_sold_liters")   AS "cat_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month", "category_name"
)
SELECT mc."category_name",
       AVG(mc."cat_liters" / NULLIF(mt."total_liters",0)) AS "avg_monthly_share"
FROM month_cat mc
JOIN month_tot mt ON mc."month" = mt."month"
GROUP BY mc."category_name"
ORDER BY "avg_monthly_share" DESC
LIMIT 20;
```

```sql
--Description: Keep only categories whose average monthly share is at least 1% and appear in ≥24 months (first 20).  
WITH month_tot AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           SUM("volume_sold_liters")   AS "total_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month"
), month_cat AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           "category_name",
           SUM("volume_sold_liters")   AS "cat_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month", "category_name"
), cat_stats AS (
    SELECT mc."category_name",
           COUNT(*)                                    AS "months_with_sales",
           AVG(mc."cat_liters" / NULLIF(mt."total_liters",0)) AS "avg_share"
    FROM month_cat mc
    JOIN month_tot mt ON mc."month" = mt."month"
    GROUP BY mc."category_name"
)
SELECT *
FROM cat_stats
WHERE "avg_share" >= 0.01
  AND "months_with_sales" >= 24
ORDER BY "avg_share" DESC
LIMIT 20;
```

```sql
--Description: Create a monthly percentage table for qualifying categories (show 20 sample rows).  
WITH month_tot AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           SUM("volume_sold_liters")   AS "total_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month"
), month_cat AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           "category_name",
           SUM("volume_sold_liters")   AS "cat_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month", "category_name"
), cat_stats AS (
    SELECT mc."category_name",
           AVG(mc."cat_liters" / NULLIF(mt."total_liters",0)) AS "avg_share",
           COUNT(*)                                           AS "months_with_sales"
    FROM month_cat mc
    JOIN month_tot mt ON mc."month" = mt."month"
    GROUP BY mc."category_name"
    HAVING AVG(mc."cat_liters" / NULLIF(mt."total_liters",0)) >= 0.01
       AND COUNT(*) >= 24
)
SELECT mc."month",
       mc."category_name",
       mc."cat_liters" / NULLIF(mt."total_liters",0) AS "pct_of_total"
FROM month_cat mc
JOIN month_tot mt  ON mc."month" = mt."month"
JOIN cat_stats cs ON mc."category_name" = cs."category_name"
ORDER BY mc."month", mc."category_name"
LIMIT 20;
```

```sql
--Description: Find the two qualifying categories whose monthly percentage time-series have the lowest Pearson correlation (show 20 correlations).  
WITH month_tot AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           SUM("volume_sold_liters")   AS "total_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month"
), month_cat AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           "category_name",
           SUM("volume_sold_liters")   AS "cat_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month", "category_name"
), cat_stats AS (
    SELECT mc."category_name",
           AVG(mc."cat_liters" / NULLIF(mt."total_liters",0)) AS "avg_share",
           COUNT(*)                                           AS "months_with_sales"
    FROM month_cat mc
    JOIN month_tot mt ON mc."month" = mt."month"
    GROUP BY mc."category_name"
    HAVING AVG(mc."cat_liters" / NULLIF(mt."total_liters",0)) >= 0.01
       AND COUNT(*) >= 24
), pct_tbl AS (
    SELECT mc."month",
           mc."category_name",
           mc."cat_liters" / NULLIF(mt."total_liters",0) AS "pct_of_total"
    FROM month_cat mc
    JOIN month_tot mt  ON mc."month" = mt."month"
    WHERE mc."category_name" IN (SELECT "category_name" FROM cat_stats)
)
SELECT c1."category_name" AS "category_1",
       c2."category_name" AS "category_2",
       CORR(p1."pct_of_total", p2."pct_of_total") AS "pearson_corr"
FROM pct_tbl p1
JOIN pct_tbl p2
     ON p1."month" = p2."month" 
    AND p1."category_name" < p2."category_name"
JOIN cat_stats c1 ON p1."category_name" = c1."category_name"
JOIN cat_stats c2 ON p2."category_name" = c2."category_name"
GROUP BY c1."category_name", c2."category_name"
ORDER BY "pearson_corr" ASC
LIMIT 20;
```

```sql
--Description: Return the single pair with the absolute lowest correlation (the final answer).  
WITH month_tot AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           SUM("volume_sold_liters")   AS "total_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month"
), month_cat AS (
    SELECT DATE_TRUNC('month', "date") AS "month",
           "category_name",
           SUM("volume_sold_liters")   AS "cat_liters"
    FROM "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE "date" >= '2022-01-01'
    GROUP BY "month", "category_name"
), cat_stats AS (
    SELECT mc."category_name",
           AVG(mc."cat_liters" / NULLIF(mt."total_liters",0)) AS "avg_share",
           COUNT(*)                                           AS "months_with_sales"
    FROM month_cat mc
    JOIN month_tot mt ON mc."month" = mt."month"
    GROUP BY mc."category_name"
    HAVING AVG(mc."cat_liters" / NULLIF(mt."total_liters",0)) >= 0.01
       AND COUNT(*) >= 24
), pct_tbl AS (
    SELECT mc."month",
           mc."category_name",
           mc."cat_liters" / NULLIF(mt."total_liters",0) AS "pct_of_total"
    FROM month_cat mc
    JOIN month_tot mt  ON mc."month" = mt."month"
    WHERE mc."category_name" IN (SELECT "category_name" FROM cat_stats)
), corr_tbl AS (
    SELECT c1."category_name" AS "category_1",
           c2."category_name" AS "category_2",
           CORR(p1."pct_of_total", p2."pct_of_total") AS "pearson_corr"
    FROM pct_tbl p1
    JOIN pct_tbl p2
         ON p1."month" = p2."month" 
        AND p1."category_name" < p2."category_name"
    GROUP BY c1."category_name", c2."category_name"
)
SELECT "category_1", "category_2", "pearson_corr"
FROM corr_tbl
ORDER BY "pearson_corr" ASC
LIMIT 20;
```
