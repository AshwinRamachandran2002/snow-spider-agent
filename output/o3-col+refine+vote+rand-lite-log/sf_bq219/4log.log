```sql
--Description / Thinking process:
--Objective: Among liquor categories that (a) appear in at least 24 distinct months from 2022-01-01 onward and
--(b) contribute an average ≥1 % of total monthly volume, find the two categories whose month-to-month
--percentage shares have the lowest Pearson correlation.
--
--CTE outline:
--1. month_tot  : total liters per calendar month.
--2. month_cat  : liters per (month, category).
--3. cat_stats  : filter categories meeting the 24-month & ≥1 % criteria.
--4. pct_tbl    : percentage share of each kept category for each month.
--5. corr_tbl   : pairwise Pearson correlations of those percentage series.
--Final SELECT returns the single pair with the minimum correlation.

WITH month_tot AS (            -- 1) total liters each month
    SELECT DATE_TRUNC('month', "date") AS "month",
           SUM("volume_sold_liters")    AS "total_liters"
    FROM   "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE  "date" >= '2022-01-01'
    GROUP  BY "month"
), month_cat AS (              -- 2) liters by category & month
    SELECT DATE_TRUNC('month', "date") AS "month",
           "category_name",
           SUM("volume_sold_liters")    AS "cat_liters"
    FROM   "IOWA_LIQUOR_SALES"."IOWA_LIQUOR_SALES"."SALES"
    WHERE  "date" >= '2022-01-01'
    GROUP  BY "month", "category_name"
), cat_stats AS (              -- 3) qualifying categories
    SELECT mc."category_name",
           COUNT(*)                                           AS "months_with_sales",
           AVG(mc."cat_liters" / NULLIF(mt."total_liters",0)) AS "avg_share"
    FROM   month_cat mc
    JOIN   month_tot  mt USING ("month")
    GROUP  BY mc."category_name"
    HAVING COUNT(*) >= 24
       AND AVG(mc."cat_liters" / NULLIF(mt."total_liters",0)) >= 0.01
), pct_tbl AS (                -- 4) monthly share for each kept category
    SELECT mc."month",
           mc."category_name",
           mc."cat_liters" / NULLIF(mt."total_liters",0) AS "pct_of_total"
    FROM   month_cat mc
    JOIN   month_tot mt USING ("month")
    WHERE  mc."category_name" IN (SELECT "category_name" FROM cat_stats)
), corr_tbl AS (               -- 5) pairwise correlations
    SELECT p1."category_name"                         AS "category_1",
           p2."category_name"                         AS "category_2",
           CORR(p1."pct_of_total", p2."pct_of_total") AS "pearson_corr"
    FROM   pct_tbl p1
    JOIN   pct_tbl p2
           ON p1."month" = p2."month"
          AND p1."category_name" < p2."category_name"
    GROUP  BY p1."category_name", p2."category_name"
)
SELECT "category_1",
       "category_2",
       "pearson_corr"
FROM   corr_tbl
ORDER  BY "pearson_corr" ASC
LIMIT  1;
```
