```sql
--Description: Retrieve distinct customer IDs from the "payment" table to see which customers have made purchases.
SELECT DISTINCT "customer_id"
FROM "payment"
LIMIT 20;
```

```sql
--Description: Show distinct combinations of customer_id, amount, and payment_date to understand the raw payment data.
SELECT DISTINCT "customer_id",
                "amount",
                "payment_date"
FROM "payment"
LIMIT 20;
```

```sql
--Description: Display each customer’s total lifetime sales (LTV) by summing their payments.
SELECT DISTINCT "customer_id",
       SUM("amount") OVER (PARTITION BY "customer_id") AS "total_ltv"
FROM "payment"
LIMIT 20;
```

```sql
--Description: Identify customers who have never made a payment (zero-LTV customers).
SELECT DISTINCT c."customer_id"
FROM "customer" AS c
LEFT JOIN "payment" AS p
  ON c."customer_id" = p."customer_id"
WHERE p."payment_id" IS NULL
LIMIT 20;
```

```sql
--Description: Fetch each customer’s very first payment date (initial purchase timestamp).
SELECT DISTINCT "customer_id",
       MIN("payment_date") OVER (PARTITION BY "customer_id") AS "first_payment_date"
FROM "payment"
LIMIT 20;
```

```sql
--Description: Show payments that occurred within 7×24 hours of a customer’s first purchase to inspect early-period sales.
SELECT DISTINCT p."customer_id",
       p."payment_date",
       MIN(p2."payment_date") AS "first_payment_date"
FROM "payment" AS p
JOIN "payment" AS p2
  ON p."customer_id" = p2."customer_id"
GROUP BY p."customer_id", p."payment_date"
HAVING JULIANDAY(p."payment_date") - JULIANDAY(MIN(p2."payment_date")) <= 7
LIMIT 20;
```

```sql
--Description: For each customer, calculate the percentage of LTV generated in the first 7 days.
SELECT DISTINCT cltv."customer_id",
       ROUND(early7."early_7_amt" * 100.0 / cltv."total_ltv", 2) AS "pct_7d"
FROM
    (SELECT "customer_id", SUM("amount") AS "total_ltv"
     FROM "payment"
     GROUP BY "customer_id") AS cltv
JOIN
    (SELECT p."customer_id", SUM(p."amount") AS "early_7_amt"
     FROM "payment" AS p
     JOIN (SELECT "customer_id", MIN("payment_date") AS "first_date"
           FROM "payment"
           GROUP BY "customer_id") AS t
       ON p."customer_id" = t."customer_id"
     WHERE (JULIANDAY(p."payment_date") - JULIANDAY(t."first_date")) <= 7
     GROUP BY p."customer_id") AS early7
  ON cltv."customer_id" = early7."customer_id"
LIMIT 20;
```

```sql
--Description: For each customer, calculate the percentage of LTV generated in the first 30 days.
SELECT DISTINCT cltv."customer_id",
       ROUND(early30."early_30_amt" * 100.0 / cltv."total_ltv", 2) AS "pct_30d"
FROM
    (SELECT "customer_id", SUM("amount") AS "total_ltv"
     FROM "payment"
     GROUP BY "customer_id") AS cltv
JOIN
    (SELECT p."customer_id", SUM(p."amount") AS "early_30_amt"
     FROM "payment" AS p
     JOIN (SELECT "customer_id", MIN("payment_date") AS "first_date"
           FROM "payment"
           GROUP BY "customer_id") AS t
       ON p."customer_id" = t."customer_id"
     WHERE (JULIANDAY(p."payment_date") - JULIANDAY(t."first_date")) <= 30
     GROUP BY p."customer_id") AS early30
  ON cltv."customer_id" = early30."customer_id"
LIMIT 20;
```

```sql
--Description: Compute the overall average percentages of LTV that occur in the first 7 and 30 days across all paying customers.
SELECT DISTINCT
       ROUND(AVG(p7."pct_7d"), 2)  AS "avg_pct_7d",
       ROUND(AVG(p30."pct_30d"), 2) AS "avg_pct_30d"
FROM
  (SELECT cltv."customer_id",
          early7."early_7_amt" * 100.0 / cltv."total_ltv" AS "pct_7d"
   FROM (SELECT "customer_id", SUM("amount") AS "total_ltv"
         FROM "payment"
         GROUP BY "customer_id") AS cltv
   JOIN (SELECT p."customer_id", SUM(p."amount") AS "early_7_amt"
         FROM "payment" AS p
         JOIN (SELECT "customer_id", MIN("payment_date") AS "first_date"
               FROM "payment"
               GROUP BY "customer_id") AS t
           ON p."customer_id" = t."customer_id"
         WHERE (JULIANDAY(p."payment_date") - JULIANDAY(t."first_date")) <= 7
         GROUP BY p."customer_id") AS early7
     ON cltv."customer_id" = early7."customer_id") AS p7
JOIN
  (SELECT cltv."customer_id",
          early30."early_30_amt" * 100.0 / cltv."total_ltv" AS "pct_30d"
   FROM (SELECT "customer_id", SUM("amount") AS "total_ltv"
         FROM "payment"
         GROUP BY "customer_id") AS cltv
   JOIN (SELECT p."customer_id", SUM(p."amount") AS "early_30_amt"
         FROM "payment" AS p
         JOIN (SELECT "customer_id", MIN("payment_date") AS "first_date"
               FROM "payment"
               GROUP BY "customer_id") AS t
           ON p."customer_id" = t."customer_id"
         WHERE (JULIANDAY(p."payment_date") - JULIANDAY(t."first_date")) <= 30
         GROUP BY p."customer_id") AS early30
     ON cltv."customer_id" = early30."customer_id") AS p30
ON p7."customer_id" = p30."customer_id"
LIMIT 20;
```

```sql
--Description: Determine the average total lifetime sales (LTV) for all customers who have made at least one payment.
SELECT DISTINCT
       ROUND(AVG("total_ltv"), 2) AS "avg_total_ltv"
FROM (
    SELECT "customer_id", SUM("amount") AS "total_ltv"
    FROM "payment"
    GROUP BY "customer_id"
) AS t
LIMIT 20;
```
