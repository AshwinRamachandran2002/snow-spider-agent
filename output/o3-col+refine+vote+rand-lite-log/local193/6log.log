Query:
--Description: List payments that occurred within 7 × 24 hours of each customer’s first purchase.
--             Uses a derived table holding the first purchase time to simplify the filter.
SELECT  p."customer_id",
        p."payment_date"
FROM    "payment" AS p
JOIN   (SELECT "customer_id",
               MIN("payment_date") AS "first_date"
        FROM   "payment"
        GROUP  BY "customer_id") AS f
      ON p."customer_id" = f."customer_id"
WHERE   JULIANDAY(p."payment_date") - JULIANDAY(f."first_date") <= 7
LIMIT   20
