```sql
-- 1. Description: Look at a few payment records: who paid, how much and when.
SELECT DISTINCT 
       "payment_id",
       "customer_id",
       "amount",
       "payment_date"
FROM   "payment"
LIMIT 20;
```

```sql
-- 2. Description: Show each customer’s very first purchase timestamp (their “start-date”).
SELECT DISTINCT
       p."customer_id",
       MIN(p."payment_date") AS "first_payment_date"
FROM   "payment" AS p
GROUP  BY p."customer_id"
LIMIT 20;
```

```sql
-- 3. Description: Compute every customer’s total lifetime sales (LTV).
SELECT DISTINCT
       p."customer_id",
       SUM(p."amount") AS "total_ltv"
FROM   "payment" AS p
GROUP  BY p."customer_id"
LIMIT 20;
```

```sql
-- 4. Description: For every customer, get (a) first purchase date, (b) total LTV
--                 and (c) sales in the first 7 days (exact 7*24*60*60 seconds).
WITH first_purchase AS (
    SELECT "customer_id",
           MIN("payment_date") AS "start_date"
    FROM   "payment"
    GROUP  BY "customer_id"
)
SELECT DISTINCT
       p."customer_id",
       fp."start_date",
       SUM(p."amount")                    AS "total_ltv",
       SUM(
           CASE
               WHEN (strftime('%s', p."payment_date") - strftime('%s', fp."start_date")) 
                        < 7*24*60*60 THEN p."amount"
               ELSE 0
           END)                           AS "ltv_7d"
FROM   "payment" AS p
JOIN   first_purchase AS fp USING ("customer_id")
GROUP  BY p."customer_id"
LIMIT 20;
```

```sql
-- 5. Description: Extend previous step to add the first-30-day LTV for each customer.
WITH first_purchase AS (
    SELECT "customer_id",
           MIN("payment_date") AS "start_date"
    FROM   "payment"
    GROUP  BY "customer_id"
)
SELECT DISTINCT
       p."customer_id",
       fp."start_date",
       SUM(p."amount")                                                        AS "total_ltv",
       SUM(CASE 
               WHEN (strftime('%s', p."payment_date") - strftime('%s', fp."start_date")) 
                        < 7*24*60*60 THEN p."amount" ELSE 0 END)              AS "ltv_7d",
       SUM(CASE 
               WHEN (strftime('%s', p."payment_date") - strftime('%s', fp."start_date")) 
                        < 30*24*60*60 THEN p."amount" ELSE 0 END)             AS "ltv_30d"
FROM   "payment" AS p
JOIN   first_purchase AS fp USING ("customer_id")
GROUP  BY p."customer_id"
LIMIT 20;
```

```sql
-- 6. Description: Calculate each customer’s % of LTV earned in days 0-7 and 0-30,
--                 excluding anyone whose total LTV = 0.
WITH ltv AS (
    WITH first_purchase AS (
        SELECT "customer_id",
               MIN("payment_date") AS "start_date"
        FROM   "payment"
        GROUP  BY "customer_id"
    )
    SELECT p."customer_id",
           SUM(p."amount")                                               AS "total_ltv",
           SUM(CASE 
                   WHEN (strftime('%s', p."payment_date") - strftime('%s', fp."start_date"))
                            < 7*24*60*60  THEN p."amount" ELSE 0 END)    AS "ltv_7d",
           SUM(CASE 
                   WHEN (strftime('%s', p."payment_date") - strftime('%s', fp."start_date"))
                            < 30*24*60*60 THEN p."amount" ELSE 0 END)    AS "ltv_30d"
    FROM   "payment" AS p
    JOIN   first_purchase AS fp USING ("customer_id")
    GROUP  BY p."customer_id"
)
SELECT DISTINCT
       "customer_id",
       "total_ltv",
       100.0 * "ltv_7d"  / "total_ltv" AS "pct_ltv_7d",
       100.0 * "ltv_30d" / "total_ltv" AS "pct_ltv_30d"
FROM   ltv
WHERE  "total_ltv" > 0
LIMIT 20;
```

```sql
-- 7. Description: Final answer – the overall averages requested:
--    • average % of lifetime sales captured in first 7 days
--    • average % of lifetime sales captured in first 30 days
--    • average total lifetime sales (LTV)
WITH ltv AS (
    WITH first_purchase AS (
        SELECT "customer_id",
               MIN("payment_date") AS "start_date"
        FROM   "payment"
        GROUP  BY "customer_id"
    )
    SELECT p."customer_id",
           SUM(p."amount")                                               AS "total_ltv",
           SUM(CASE 
                   WHEN (strftime('%s', p."payment_date") - strftime('%s', fp."start_date"))
                            < 7*24*60*60  THEN p."amount" ELSE 0 END)    AS "ltv_7d",
           SUM(CASE 
                   WHEN (strftime('%s', p."payment_date") - strftime('%s', fp."start_date"))
                            < 30*24*60*60 THEN p."amount" ELSE 0 END)    AS "ltv_30d"
    FROM   "payment" AS p
    JOIN   first_purchase AS fp USING ("customer_id")
    GROUP  BY p."customer_id"
    HAVING SUM(p."amount") > 0     -- drop zero-LTV customers
)
SELECT
       AVG(100.0 * "ltv_7d"  / "total_ltv") AS "avg_pct_ltv_7d",
       AVG(100.0 * "ltv_30d" / "total_ltv") AS "avg_pct_ltv_30d",
       AVG("total_ltv")                      AS "avg_total_ltv"
FROM   ltv;
```

These seven queries progress from simple inspection to the complete calculation of:

• average percentage of lifetime sales in the first 7 days  
• average percentage of lifetime sales in the first 30 days  
• average total lifetime sales (LTV)  

while excluding customers whose lifetime sales are zero and using precise 7- and 30-day (seconds-based) windows.
