```sql
-- 1. Inspect some raw payment facts
SELECT DISTINCT "payment_id",
                "customer_id",
                "amount",
                "payment_date"
FROM   "payment"
LIMIT 20;
```

```sql
-- 2. First-payment timestamp for every customer
SELECT DISTINCT p."customer_id",
                MIN(p."payment_date") AS "first_payment_date"
FROM   "payment" AS p
GROUP  BY p."customer_id"
LIMIT 20;
```

```sql
-- 3. Total lifetime value (LTV) per customer
SELECT DISTINCT p."customer_id",
                SUM(p."amount") AS "total_ltv"
FROM   "payment" AS p
GROUP  BY p."customer_id"
LIMIT 20;
```

```sql
-- 4. Customers whose lifetime sales are > 0
SELECT DISTINCT p."customer_id",
                SUM(p."amount") AS "total_ltv"
FROM   "payment" AS p
GROUP  BY p."customer_id"
HAVING SUM(p."amount") > 0
LIMIT 20;
```

```sql
-- 5. Amount captured in the first 7×24h window after a customer's 1st payment
SELECT DISTINCT p."customer_id",
                SUM(p."amount") AS "ltv_7d"
FROM   "payment" AS p
JOIN  (SELECT "customer_id",
              MIN("payment_date") AS "first_payment_date"
       FROM   "payment"
       GROUP  BY "customer_id") AS fp
       ON p."customer_id" = fp."customer_id"
WHERE  p."payment_date" <= DATETIME(fp."first_payment_date", '+7 days')
GROUP  BY p."customer_id"
LIMIT 20;
```

```sql
-- 6. Amount captured in the first 30×24h window after a customer's 1st payment
SELECT DISTINCT p."customer_id",
                SUM(p."amount") AS "ltv_30d"
FROM   "payment" AS p
JOIN  (SELECT "customer_id",
              MIN("payment_date") AS "first_payment_date"
       FROM   "payment"
       GROUP  BY "customer_id") AS fp
       ON p."customer_id" = fp."customer_id"
WHERE  p."payment_date" <= DATETIME(fp."first_payment_date", '+30 days')
GROUP  BY p."customer_id"
LIMIT 20;
```

```sql
-- 7. 7-day, 30-day and total LTV side-by-side for every customer
SELECT DISTINCT p."customer_id",
       SUM(CASE WHEN p."payment_date" <= DATETIME(fp."first_payment_date", '+7 days')
                THEN p."amount" ELSE 0 END)         AS "ltv_7d",
       SUM(CASE WHEN p."payment_date" <= DATETIME(fp."first_payment_date", '+30 days')
                THEN p."amount" ELSE 0 END)         AS "ltv_30d",
       SUM(p."amount")                              AS "total_ltv"
FROM   "payment" AS p
JOIN  (SELECT "customer_id",
              MIN("payment_date") AS "first_payment_date"
       FROM   "payment"
       GROUP  BY "customer_id") AS fp
       ON p."customer_id" = fp."customer_id"
GROUP  BY p."customer_id"
LIMIT 20;
```

```sql
-- 8. Per-customer percentages of LTV earned inside 7 & 30 days
SELECT DISTINCT cs."customer_id",
       ROUND(1.0 * cs."ltv_7d"  / cs."total_ltv", 4) AS "pct_7d",
       ROUND(1.0 * cs."ltv_30d" / cs."total_ltv", 4) AS "pct_30d",
       cs."total_ltv"
FROM  (SELECT p."customer_id",
              SUM(CASE WHEN p."payment_date" <= DATETIME(fp."first_payment_date", '+7 days')
                       THEN p."amount" ELSE 0 END) AS "ltv_7d",
              SUM(CASE WHEN p."payment_date" <= DATETIME(fp."first_payment_date", '+30 days')
                       THEN p."amount" ELSE 0 END) AS "ltv_30d",
              SUM(p."amount")                       AS "total_ltv"
       FROM   "payment" AS p
       JOIN  (SELECT "customer_id",
                     MIN("payment_date") AS "first_payment_date"
              FROM   "payment"
              GROUP  BY "customer_id") AS fp
              ON p."customer_id" = fp."customer_id"
       GROUP  BY p."customer_id") AS cs
WHERE  cs."total_ltv" > 0
LIMIT 20;
```

```sql
-- 9. FINAL ANSWER: Average % of LTV in first 7 & 30 days, plus average total LTV
SELECT DISTINCT
       ROUND(AVG(1.0 * stats."ltv_7d"  / stats."total_ltv"), 4) AS "avg_pct_7d",
       ROUND(AVG(1.0 * stats."ltv_30d" / stats."total_ltv"), 4) AS "avg_pct_30d",
       ROUND(AVG(stats."total_ltv"), 2)                        AS "avg_total_ltv"
FROM  (SELECT p."customer_id",
              SUM(CASE WHEN p."payment_date" <= DATETIME(fp."first_payment_date", '+7 days')
                       THEN p."amount" ELSE 0 END) AS "ltv_7d",
              SUM(CASE WHEN p."payment_date" <= DATETIME(fp."first_payment_date", '+30 days')
                       THEN p."amount" ELSE 0 END) AS "ltv_30d",
              SUM(p."amount")                       AS "total_ltv"
       FROM   "payment" AS p
       JOIN  (SELECT "customer_id",
                     MIN("payment_date") AS "first_payment_date"
              FROM   "payment"
              GROUP  BY "customer_id") AS fp
              ON p."customer_id" = fp."customer_id"
       GROUP  BY p."customer_id"
       HAVING SUM(p."amount") > 0) AS stats;
```

```sql
-- 10. Customers with the highest share of revenue in their first 7 days
SELECT DISTINCT *
FROM  (SELECT p."customer_id",
              SUM(CASE WHEN p."payment_date" <= DATETIME(fp."first_payment_date", '+7 days')
                       THEN p."amount" ELSE 0 END) * 1.0
              / SUM(p."amount") AS "pct_7d"
       FROM   "payment" AS p
       JOIN  (SELECT "customer_id",
                     MIN("payment_date") AS "first_payment_date"
              FROM   "payment"
              GROUP  BY "customer_id") AS fp
              ON p."customer_id" = fp."customer_id"
       GROUP  BY p."customer_id") AS t
ORDER BY t."pct_7d" DESC
LIMIT 20;
```
