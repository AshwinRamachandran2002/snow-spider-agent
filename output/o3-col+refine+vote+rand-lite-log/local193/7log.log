-- 9. FINAL ANSWER: Average % of LTV in first 7 & 30 days, plus average total LTV
SELECT DISTINCT
       ROUND(AVG(1.0 * stats."ltv_7d"  / stats."total_ltv"), 4) AS "avg_pct_7d",
       ROUND(AVG(1.0 * stats."ltv_30d" / stats."total_ltv"), 4) AS "avg_pct_30d",
       ROUND(AVG(stats."total_ltv"), 2)                        AS "avg_total_ltv"
FROM  (SELECT p."customer_id",
              SUM(CASE WHEN p."payment_date" <= DATETIME(fp."first_payment_date", '+7 days')
                       THEN p."amount" ELSE 0 END) AS "ltv_7d",
              SUM(CASE WHEN p."payment_date" <= DATETIME(fp."first_payment_date", '+30 days')
                       THEN p."amount" ELSE 0 END) AS "ltv_30d",
              SUM(p."amount")                       AS "total_ltv"
       FROM   "payment" AS p
       JOIN  (SELECT "customer_id",
                     MIN("payment_date") AS "first_payment_date"
              FROM   "payment"
              GROUP  BY "customer_id") AS fp
              ON p."customer_id" = fp."customer_id"
       GROUP  BY p."customer_id"
       HAVING SUM(p."amount") > 0) AS stats;
