Query:
--Description: See how much each of the first 20 customers spent in the first 7-days
WITH first_dt AS (
  SELECT customer_id, MIN(payment_date) AS first_purchase
  FROM payment
  GROUP BY customer_id
)
SELECT DISTINCT p.customer_id,
       SUM(p.amount) AS spend_first_7d
FROM payment AS p
JOIN first_dt AS f USING (customer_id)
WHERE (strftime('%s', p.payment_date) - strftime('%s', f.first_purchase)) < 604800   -- 7*24*60*60
GROUP BY p.customer_id
ORDER BY p.customer_id
LIMIT 20;
