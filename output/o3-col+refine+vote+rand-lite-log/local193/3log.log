```sql
-- 1) What customers do we actually have payments for?
--    (Shows up to 20 different customer_id values that appear in the payment table)
SELECT DISTINCT "customer_id"
FROM "payment"
LIMIT 20;
```

```sql
-- 2) Get an idea of the time-span of payments: earliest and latest payment_date.
--    (Shows two rows: MIN and MAX payment_date in the whole table)
SELECT MIN("payment_date")  AS "earliest_payment",
       MAX("payment_date")  AS "latest_payment"
FROM   "payment";
```

```sql
-- 3) Peek at a single customer’s full payment history (here: customer_id = 1, first 20 rows).
SELECT *
FROM   "payment"
WHERE  "customer_id" = 1
ORDER  BY "payment_date"
LIMIT 20;
```

```sql
-- 4) Compute total lifetime sales (LTV) for every customer (first 20 rows).
SELECT DISTINCT p."customer_id",
       SUM(p."amount")  OVER (PARTITION BY p."customer_id") AS "total_ltv"
FROM   "payment" AS p
LIMIT 20;
```

```sql
-- 5) Find each customer’s first-ever purchase time (their “cohort start”).
SELECT DISTINCT p."customer_id",
       MIN(p."payment_date") OVER (PARTITION BY p."customer_id") AS "first_purchase"
FROM   "payment" AS p
LIMIT 20;
```

```sql
-- 6) For every payment, label whether it lies within 7 days of that customer’s first purchase.
--    (Shows a flag column for the first 20 qualifying rows)
SELECT DISTINCT p."payment_id",
       p."customer_id",
       p."payment_date",
       CASE
         WHEN p."payment_date" <= DATETIME(MIN(p2."payment_date")
                                           OVER (PARTITION BY p."customer_id"),
                                           '+7 days')
         THEN 1 ELSE 0
       END AS "in_first_7d"
FROM   "payment" AS p
JOIN   "payment" AS p2
  ON   p2."customer_id" = p."customer_id"
LIMIT 20;
```

```sql
-- 7) …and do the same kind of flag but for 30 days (first 20 rows).
SELECT DISTINCT p."payment_id",
       p."customer_id",
       p."payment_date",
       CASE
         WHEN p."payment_date" <= DATETIME(MIN(p2."payment_date")
                                           OVER (PARTITION BY p."customer_id"),
                                           '+30 days')
         THEN 1 ELSE 0
       END AS "in_first_30d"
FROM   "payment" AS p
JOIN   "payment" AS p2
  ON   p2."customer_id" = p."customer_id"
LIMIT 20;
```

```sql
-- 8) Aggregate per customer:
--      • total LTV
--      • sales in first 7 days
--      • sales in first 30 days
--    (first 20 customers)
WITH first_purchase AS (
    SELECT "customer_id",
           MIN("payment_date") AS "first_purchase"
    FROM   "payment"
    GROUP  BY "customer_id"
),
windowed AS (
    SELECT p."customer_id",
           p."amount",
           p."payment_date",
           fp."first_purchase",
           CASE WHEN p."payment_date" <= DATETIME(fp."first_purchase", '+7 days')  THEN p."amount" ELSE 0 END AS "amt_7d",
           CASE WHEN p."payment_date" <= DATETIME(fp."first_purchase", '+30 days') THEN p."amount" ELSE 0 END AS "amt_30d"
    FROM   "payment" AS p
    JOIN   first_purchase AS fp USING ("customer_id")
)
SELECT DISTINCT "customer_id",
       SUM("amount")  AS "total_ltv",
       SUM("amt_7d")  AS "ltv_7d",
       SUM("amt_30d") AS "ltv_30d"
FROM   windowed
GROUP  BY "customer_id"
LIMIT 20;
```

```sql
-- 9) Transform the previous per-customer aggregates into percentage terms (exclude zero LTV).
--    (first 20 customers)
WITH per_cust AS (
    SELECT p."customer_id",
           SUM(p."amount")                                                   AS "total_ltv",
           SUM(CASE WHEN p."payment_date" <= DATETIME(fp."first_purchase", '+7 days')
                    THEN p."amount" ELSE 0 END)                              AS "ltv_7d",
           SUM(CASE WHEN p."payment_date" <= DATETIME(fp."first_purchase", '+30 days')
                    THEN p."amount" ELSE 0 END)                              AS "ltv_30d"
    FROM   "payment" AS p
    JOIN  (SELECT "customer_id", MIN("payment_date") AS "first_purchase"
           FROM   "payment"
           GROUP  BY "customer_id") AS fp USING ("customer_id")
    GROUP  BY p."customer_id"
    HAVING SUM(p."amount") > 0                -- remove zero-spenders
)
SELECT DISTINCT "customer_id",
       ROUND(("ltv_7d"  * 100.0) / "total_ltv", 2) AS "pct_7d",
       ROUND(("ltv_30d" * 100.0) / "total_ltv", 2) AS "pct_30d",
       "total_ltv"
FROM   per_cust
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: overall averages across all paying customers
--     • avg % of LTV in first 7 days
--     • avg % of LTV in first 30 days
--     • avg total LTV
WITH per_cust AS (
    SELECT p."customer_id",
           SUM(p."amount")                                                   AS "total_ltv",
           SUM(CASE WHEN p."payment_date" <= DATETIME(fp."first_purchase", '+7 days')
                    THEN p."amount" ELSE 0 END)                              AS "ltv_7d",
           SUM(CASE WHEN p."payment_date" <= DATETIME(fp."first_purchase", '+30 days')
                    THEN p."amount" ELSE 0 END)                              AS "ltv_30d"
    FROM   "payment" AS p
    JOIN  (SELECT "customer_id", MIN("payment_date") AS "first_purchase"
           FROM   "payment"
           GROUP  BY "customer_id") AS fp USING ("customer_id")
    GROUP  BY p."customer_id"
    HAVING SUM(p."amount") > 0
)
SELECT ROUND(AVG( ("ltv_7d"  * 100.0) / "total_ltv" ), 2)  AS "avg_pct_7d",
       ROUND(AVG( ("ltv_30d" * 100.0) / "total_ltv" ), 2)  AS "avg_pct_30d",
       ROUND(AVG( "total_ltv" ), 2)                       AS "avg_total_ltv"
FROM   per_cust;
```
