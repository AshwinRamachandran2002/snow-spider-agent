```sql
--Description: Inspect distinct customer IDs that have at least one payment  
SELECT DISTINCT "customer_id"
FROM "payment"
LIMIT 20;
```

```sql
--Description: Look at some raw payment records (amount & timestamp)  
SELECT "payment_id",
       "customer_id",
       "amount",
       "payment_date"
FROM "payment"
LIMIT 20;
```

```sql
--Description: Compute every customer’s total lifetime sales (LTV)  
SELECT  "customer_id",
        SUM("amount") AS "lifetime_sales"
FROM    "payment"
GROUP BY "customer_id"
LIMIT 20;
```

```sql
--Description: Find the very first purchase time (initial payment) for each customer  
SELECT  "customer_id",
        MIN("payment_date") AS "first_payment_date"
FROM    "payment"
GROUP BY "customer_id"
LIMIT 20;
```

```sql
--Description: Show first purchase date together with total LTV for each customer  
SELECT  lt."customer_id",
        lt."lifetime_sales",
        fp."first_payment_date"
FROM   (SELECT  "customer_id",
               SUM("amount") AS "lifetime_sales"
        FROM    "payment"
        GROUP BY "customer_id")  AS lt
JOIN   (SELECT  "customer_id",
               MIN("payment_date") AS "first_payment_date"
        FROM    "payment"
        GROUP BY "customer_id")  AS fp
ON     lt."customer_id" = fp."customer_id"
LIMIT 20;
```

```sql
--Description: Calculate sales that occur within 7 days of the first payment for each customer  
SELECT  p."customer_id",
        SUM(p."amount") AS "sales_7d"
FROM    "payment"  AS p
JOIN   (SELECT  "customer_id",
               MIN("payment_date") AS "first_payment_date"
        FROM    "payment"
        GROUP BY "customer_id") AS f
      ON  p."customer_id" = f."customer_id"
     AND p."payment_date" <= DATETIME(f."first_payment_date", '+7 days')
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
--Description: Calculate sales that occur within 30 days of the first payment for each customer  
SELECT  p."customer_id",
        SUM(p."amount") AS "sales_30d"
FROM    "payment"  AS p
JOIN   (SELECT  "customer_id",
               MIN("payment_date") AS "first_payment_date"
        FROM    "payment"
        GROUP BY "customer_id") AS f
      ON  p."customer_id" = f."customer_id"
     AND p."payment_date" <= DATETIME(f."first_payment_date", '+30 days')
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
--Description: For every customer (with positive LTV) compute percentages of sales in the first 7 & 30 days  
SELECT  lt."customer_id",
        lt."lifetime_sales",
        COALESCE(s7."sales_7d", 0)   / lt."lifetime_sales" AS "pct_7d",
        COALESCE(s30."sales_30d", 0) / lt."lifetime_sales" AS "pct_30d"
FROM  (SELECT "customer_id", SUM("amount") AS "lifetime_sales"
       FROM   "payment"
       GROUP  BY "customer_id"
       HAVING SUM("amount") > 0)                                      AS lt
LEFT JOIN
      (SELECT  p."customer_id",
               SUM(p."amount") AS "sales_7d"
       FROM    "payment"  AS p
       JOIN   (SELECT "customer_id",
                      MIN("payment_date") AS "first_payment_date"
               FROM   "payment"
               GROUP  BY "customer_id") AS f
             ON  p."customer_id" = f."customer_id"
            AND p."payment_date" <= DATETIME(f."first_payment_date", '+7 days')
       GROUP BY p."customer_id")                                      AS s7
       ON lt."customer_id" = s7."customer_id"
LEFT JOIN
      (SELECT  p."customer_id",
               SUM(p."amount") AS "sales_30d"
       FROM    "payment"  AS p
       JOIN   (SELECT "customer_id",
                      MIN("payment_date") AS "first_payment_date"
               FROM   "payment"
               GROUP  BY "customer_id") AS f
             ON  p."customer_id" = f."customer_id"
            AND p."payment_date" <= DATETIME(f."first_payment_date", '+30 days')
       GROUP BY p."customer_id")                                      AS s30
       ON lt."customer_id" = s30."customer_id"
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – average % of lifetime sales in first 7 days, in first 30 days, and average total LTV  
SELECT  AVG("pct_7d")  AS "avg_pct_7d",
        AVG("pct_30d") AS "avg_pct_30d",
        AVG("lifetime_sales") AS "avg_lifetime_sales"
FROM  (
        SELECT  lt."customer_id",
                lt."lifetime_sales",
                COALESCE(s7."sales_7d", 0)   / lt."lifetime_sales" AS "pct_7d",
                COALESCE(s30."sales_30d", 0) / lt."lifetime_sales" AS "pct_30d"
        FROM  (SELECT "customer_id", SUM("amount") AS "lifetime_sales"
               FROM   "payment"
               GROUP  BY "customer_id"
               HAVING SUM("amount") > 0)                             AS lt
        LEFT JOIN
              (SELECT  p."customer_id",
                       SUM(p."amount") AS "sales_7d"
               FROM    "payment"  AS p
               JOIN   (SELECT "customer_id",
                              MIN("payment_date") AS "first_payment_date"
                       FROM   "payment"
                       GROUP  BY "customer_id") AS f
                     ON  p."customer_id" = f."customer_id"
                    AND p."payment_date" <= DATETIME(f."first_payment_date", '+7 days')
               GROUP BY p."customer_id")                             AS s7
               ON lt."customer_id" = s7."customer_id"
        LEFT JOIN
              (SELECT  p."customer_id",
                       SUM(p."amount") AS "sales_30d"
               FROM    "payment"  AS p
               JOIN   (SELECT "customer_id",
                              MIN("payment_date") AS "first_payment_date"
                       FROM   "payment"
                       GROUP  BY "customer_id") AS f
                     ON  p."customer_id" = f."customer_id"
                    AND p."payment_date" <= DATETIME(f."first_payment_date", '+30 days')
               GROUP BY p."customer_id")                             AS s30
               ON lt."customer_id" = s30."customer_id"
      )  AS customer_metrics;
```

