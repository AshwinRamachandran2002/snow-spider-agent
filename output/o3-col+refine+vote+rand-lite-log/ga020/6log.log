```sql
-- 3. Description:  Build the Quick-Play “cohort” – first day each user triggered
--                  a given Quick-Play event between 1–15 Aug 2018.  
SELECT
  event_name,                       -- Quick-Play event type
  user_pseudo_id,
  MIN(TIMESTAMP_MICROS(event_timestamp)) AS first_eng_ts
FROM
  `firebase-public-project.analytics_153293282.events_201808*`
WHERE
      event_name IN (
        'level_start_quickplay',
        'level_complete_quickplay',
        'level_fail_quickplay'
      )
  AND event_date BETWEEN '20180801' AND '20180815'
GROUP BY
  event_name, user_pseudo_id
LIMIT 20;
```

```sql
-- 4. Description:  Inspect 20 cohort rows to make sure we really have one record
--                  (first engagement) per user per Quick-Play type.  
WITH cohort AS (                                        -- same logic as query #3
  SELECT
    event_name,
    user_pseudo_id,
    MIN(TIMESTAMP_MICROS(event_timestamp)) AS first_eng_ts
  FROM
    `firebase-public-project.analytics_153293282.events_201808*`
  WHERE
        event_name IN (
          'level_start_quickplay',
          'level_complete_quickplay',
          'level_fail_quickplay'
        )
    AND event_date BETWEEN '20180801' AND '20180815'
  GROUP BY
    event_name, user_pseudo_id)
SELECT * FROM cohort
LIMIT 20;
```

```sql
-- 5. Description:  Pull all session_start events for those cohort users
--                  that took place 8-14 days after their first engagement.  
WITH cohort AS (
  SELECT
    event_name,
    user_pseudo_id,
    MIN(TIMESTAMP_MICROS(event_timestamp)) AS first_eng_ts
  FROM
    `firebase-public-project.analytics_153293282.events_201808*`
  WHERE
        event_name IN (
          'level_start_quickplay',
          'level_complete_quickplay',
          'level_fail_quickplay'
        )
    AND event_date BETWEEN '20180801' AND '20180815'
  GROUP BY
    event_name, user_pseudo_id)
SELECT
  c.event_name,
  ss.user_pseudo_id,
  TIMESTAMP_MICROS(ss.event_timestamp)  AS sess_ts,
  DATE_DIFF(DATE(TIMESTAMP_MICROS(ss.event_timestamp)),
            DATE(c.first_eng_ts), DAY) AS days_after
FROM
  cohort            AS c
JOIN
  `firebase-public-project.analytics_153293282.events_201808*`  AS ss
ON  ss.user_pseudo_id = c.user_pseudo_id
WHERE
      ss.event_name   = 'session_start'
  AND DATE_DIFF(DATE(TIMESTAMP_MICROS(ss.event_timestamp)),
                DATE(c.first_eng_ts), DAY) BETWEEN 8 AND 14
LIMIT 20;
```

```sql
-- 6. Description:  Count how many unique cohort users returned (≥1 session_start)
--                  in the 2nd week, by Quick-Play event type.  
WITH cohort AS (
  SELECT
    event_name,
    user_pseudo_id,
    MIN(TIMESTAMP_MICROS(event_timestamp)) AS first_eng_ts
  FROM
    `firebase-public-project.analytics_153293282.events_201808*`
  WHERE
        event_name IN (
          'level_start_quickplay',
          'level_complete_quickplay',
          'level_fail_quickplay'
        )
    AND event_date BETWEEN '20180801' AND '20180815'
  GROUP BY
    event_name, user_pseudo_id),
ret AS (
  SELECT DISTINCT
    c.event_name,
    c.user_pseudo_id
  FROM
    cohort AS c
  JOIN
    `firebase-public-project.analytics_153293282.events_201808*`  AS ss
  ON  ss.user_pseudo_id = c.user_pseudo_id
  WHERE
        ss.event_name = 'session_start'
    AND DATE_DIFF(DATE(TIMESTAMP_MICROS(ss.event_timestamp)),
                  DATE(c.first_eng_ts), DAY) BETWEEN 8 AND 14)
SELECT
  event_name,
  COUNT(DISTINCT user_pseudo_id) AS retained_users
FROM ret
GROUP BY event_name
LIMIT 20;
```

```sql
-- 7. Description:  Put cohort size beside retained_users so we can calculate
--                  the week-2 retention rate.  
WITH cohort AS (
  SELECT
    event_name,
    user_pseudo_id,
    MIN(TIMESTAMP_MICROS(event_timestamp)) AS first_eng_ts
  FROM
    `firebase-public-project.analytics_153293282.events_201808*`
  WHERE
        event_name IN (
          'level_start_quickplay',
          'level_complete_quickplay',
          'level_fail_quickplay'
        )
    AND event_date BETWEEN '20180801' AND '20180815'
  GROUP BY
    event_name, user_pseudo_id),
ret AS (
  SELECT DISTINCT
    c.event_name,
    c.user_pseudo_id
  FROM
    cohort AS c
  JOIN
    `firebase-public-project.analytics_153293282.events_201808*` AS ss
  ON  ss.user_pseudo_id = c.user_pseudo_id
  WHERE
        ss.event_name = 'session_start'
    AND DATE_DIFF(DATE(TIMESTAMP_MICROS(ss.event_timestamp)),
                  DATE(c.first_eng_ts), DAY) BETWEEN 8 AND 14)
SELECT
  coh.event_name,
  COUNT(DISTINCT coh.user_pseudo_id)           AS cohort_size,
  COUNT(DISTINCT ret.user_pseudo_id)           AS retained_users
FROM cohort AS coh
LEFT JOIN ret
  ON  coh.event_name = ret.event_name
  AND coh.user_pseudo_id = ret.user_pseudo_id
GROUP BY coh.event_name
LIMIT 20;
```

```sql
-- 8. Description:  Calculate the week-2 retention rate (%) for each Quick-Play
--                  event type and sort ascending (lowest first).  
WITH cohort AS (
  SELECT
    event_name,
    user_pseudo_id,
    MIN(TIMESTAMP_MICROS(event_timestamp)) AS first_eng_ts
  FROM
    `firebase-public-project.analytics_153293282.events_201808*`
  WHERE
        event_name IN (
          'level_start_quickplay',
          'level_complete_quickplay',
          'level_fail_quickplay'
        )
    AND event_date BETWEEN '20180801' AND '20180815'
  GROUP BY
    event_name, user_pseudo_id),
ret AS (
  SELECT DISTINCT
    c.event_name,
    c.user_pseudo_id
  FROM
    cohort AS c
  JOIN
    `firebase-public-project.analytics_153293282.events_201808*` AS ss
  ON  ss.user_pseudo_id = c.user_pseudo_id
  WHERE
        ss.event_name = 'session_start'
    AND DATE_DIFF(DATE(TIMESTAMP_MICROS(ss.event_timestamp)),
                  DATE(c.first_eng_ts), DAY) BETWEEN 8 AND 14)
SELECT
  coh.event_name,
  COUNT(DISTINCT coh.user_pseudo_id)                       AS cohort_size,
  COUNT(DISTINCT ret.user_pseudo_id)                       AS retained_users,
  SAFE_DIVIDE(COUNT(DISTINCT ret.user_pseudo_id),
              COUNT(DISTINCT coh.user_pseudo_id)) AS week2_retention_rate
FROM cohort AS coh
LEFT JOIN ret
  ON  coh.event_name = ret.event_name
  AND coh.user_pseudo_id = ret.user_pseudo_id
GROUP BY coh.event_name
ORDER BY week2_retention_rate ASC
LIMIT 20;
```

```sql
-- 9. Description:  Final answer – which Quick-Play event type had the lowest
--                  week-2 retention rate (between 1-15 Aug 2018 cohorts)?  
WITH cohort AS (
  SELECT
    event_name,
    user_pseudo_id,
    MIN(TIMESTAMP_MICROS(event_timestamp)) AS first_eng_ts
  FROM
    `firebase-public-project.analytics_153293282.events_201808*`
  WHERE
        event_name IN (
          'level_start_quickplay',
          'level_complete_quickplay',
          'level_fail_quickplay'
        )
    AND event_date BETWEEN '20180801' AND '20180815'
  GROUP BY
    event_name, user_pseudo_id),
ret AS (
  SELECT DISTINCT
    c.event_name,
    c.user_pseudo_id
  FROM
    cohort AS c
  JOIN
    `firebase-public-project.analytics_153293282.events_201808*` AS ss
  ON  ss.user_pseudo_id = c.user_pseudo_id
  WHERE
        ss.event_name = 'session_start'
    AND DATE_DIFF(DATE(TIMESTAMP_MICROS(ss.event_timestamp)),
                  DATE(c.first_eng_ts), DAY) BETWEEN 8 AND 14)
SELECT
  coh.event_name                                                AS quickplay_event_type,
  COUNT(DISTINCT coh.user_pseudo_id)                            AS cohort_size,
  COUNT(DISTINCT ret.user_pseudo_id)                            AS retained_users,
  SAFE_DIVIDE(COUNT(DISTINCT ret.user_pseudo_id),
              COUNT(DISTINCT coh.user_pseudo_id))               AS week2_retention_rate
FROM cohort AS coh
LEFT JOIN ret
  ON  coh.event_name = ret.event_name
  AND coh.user_pseudo_id = ret.user_pseudo_id
GROUP BY coh.event_name
ORDER BY week2_retention_rate ASC
LIMIT 1;
```
