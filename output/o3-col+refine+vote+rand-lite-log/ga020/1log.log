Query:
--Description: 6) For every user in the quickplay cohorts, flag if they had a session_start 8-14 days later
WITH cohort AS (
  SELECT  `event_name`                                   AS quickplay_event,
          `user_pseudo_id`,
          MIN( PARSE_DATE('%Y%m%d', `event_date`) )      AS cohort_start_date
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
    AND   LOWER(`event_name`) LIKE '%quickplay%'
  GROUP BY quickplay_event, `user_pseudo_id`
),
sessions AS (
  SELECT  `user_pseudo_id`,
          PARSE_DATE('%Y%m%d', `event_date`) AS session_date
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX BETWEEN '20180801' AND '20180831'
    AND   `event_name` = 'session_start'
)
SELECT  c.quickplay_event,
        c.`user_pseudo_id`,
        ANY_VALUE( DATE_DIFF(s.session_date, c.cohort_start_date, DAY) BETWEEN 8 AND 14 ) AS retained_week2
FROM cohort AS c
LEFT JOIN sessions AS s
  ON  c.`user_pseudo_id` = s.`user_pseudo_id`
GROUP BY c.quickplay_event, c.`user_pseudo_id`
LIMIT 20;
