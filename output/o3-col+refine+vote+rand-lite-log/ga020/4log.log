```sql
-- 7) Week-2 (days 8-14) session_start flags per user / quickplay event  
WITH cohort AS (
  SELECT user_pseudo_id ,
         event_name AS quickplay_event ,
         PARSE_DATE('%Y%m%d', MIN(event_date)) AS cohort_date
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
    AND event_name LIKE '%quickplay%'
  GROUP BY user_pseudo_id , quickplay_event
),
session_starts AS (
  SELECT user_pseudo_id ,
         PARSE_DATE('%Y%m%d', event_date) AS sess_date
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180829'
    AND event_name = 'session_start'
)
SELECT c.quickplay_event ,
       c.user_pseudo_id ,
       MIN(CASE
             WHEN s.sess_date BETWEEN DATE_ADD(c.cohort_date, INTERVAL 8  DAY)
                                 AND DATE_ADD(c.cohort_date, INTERVAL 14 DAY)
             THEN 1 END) AS is_retained_wk2
FROM cohort c
LEFT JOIN session_starts s
       ON c.user_pseudo_id = s.user_pseudo_id
GROUP BY c.quickplay_event , c.user_pseudo_id
LIMIT 20;
```

```sql
-- 8) Aggregate retained-vs-total users for every quickplay event type  
WITH cohort AS (
  SELECT user_pseudo_id ,
         event_name AS quickplay_event ,
         PARSE_DATE('%Y%m%d', MIN(event_date)) AS cohort_date
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
    AND event_name LIKE '%quickplay%'
  GROUP BY user_pseudo_id , quickplay_event
),
session_starts AS (
  SELECT user_pseudo_id ,
         PARSE_DATE('%Y%m%d', event_date) AS sess_date
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180829'
    AND event_name = 'session_start'
)
SELECT
  c.quickplay_event ,
  COUNT(DISTINCT c.user_pseudo_id)                                                AS cohort_users ,
  COUNT(DISTINCT CASE
                   WHEN s.sess_date BETWEEN DATE_ADD(c.cohort_date, INTERVAL 8  DAY)
                                       AND DATE_ADD(c.cohort_date, INTERVAL 14 DAY)
                   THEN c.user_pseudo_id END)                                     AS retained_users
FROM cohort c
LEFT JOIN session_starts s
       ON c.user_pseudo_id = s.user_pseudo_id
GROUP BY c.quickplay_event
LIMIT 20;
```

```sql
-- 9) Calculate week-2 retention rate per quickplay event type  
WITH cohort AS (
  SELECT user_pseudo_id ,
         event_name AS quickplay_event ,
         PARSE_DATE('%Y%m%d', MIN(event_date)) AS cohort_date
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
    AND event_name LIKE '%quickplay%'
  GROUP BY user_pseudo_id , quickplay_event
),
session_starts AS (
  SELECT user_pseudo_id ,
         PARSE_DATE('%Y%m%d', event_date) AS sess_date
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180829'
    AND event_name = 'session_start'
)
SELECT
  c.quickplay_event ,
  COUNT(DISTINCT c.user_pseudo_id)                                                          AS cohort_users ,
  COUNT(DISTINCT CASE
                   WHEN s.sess_date BETWEEN DATE_ADD(c.cohort_date, INTERVAL 8 DAY)
                                       AND DATE_ADD(c.cohort_date, INTERVAL 14 DAY)
                   THEN c.user_pseudo_id END)                                              AS retained_users ,
  SAFE_DIVIDE(
       COUNT(DISTINCT CASE
                        WHEN s.sess_date BETWEEN DATE_ADD(c.cohort_date, INTERVAL 8 DAY)
                                            AND DATE_ADD(c.cohort_date, INTERVAL 14 DAY)
                        THEN c.user_pseudo_id END),
       COUNT(DISTINCT c.user_pseudo_id))                                                   AS retention_rate
FROM cohort c
LEFT JOIN session_starts s
       ON c.user_pseudo_id = s.user_pseudo_id
GROUP BY c.quickplay_event
LIMIT 20;
```

```sql
-- 10) FINAL – which quickplay event has the LOWEST week-2 retention?  
WITH cohort AS (
  SELECT user_pseudo_id ,
         event_name AS quickplay_event ,
         PARSE_DATE('%Y%m%d', MIN(event_date)) AS cohort_date
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180815'
    AND event_name LIKE '%quickplay%'
  GROUP BY user_pseudo_id , quickplay_event
),
session_starts AS (
  SELECT user_pseudo_id ,
         PARSE_DATE('%Y%m%d', event_date) AS sess_date
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180829'
    AND event_name = 'session_start'
)
SELECT
  c.quickplay_event ,
  COUNT(DISTINCT c.user_pseudo_id)                                                    AS cohort_users ,
  COUNT(DISTINCT CASE
                   WHEN s.sess_date BETWEEN DATE_ADD(c.cohort_date, INTERVAL 8 DAY)
                                       AND DATE_ADD(c.cohort_date, INTERVAL 14 DAY)
                   THEN c.user_pseudo_id END)                                         AS retained_users ,
  SAFE_DIVIDE(
       COUNT(DISTINCT CASE
                        WHEN s.sess_date BETWEEN DATE_ADD(c.cohort_date, INTERVAL 8 DAY)
                                            AND DATE_ADD(c.cohort_date, INTERVAL 14 DAY)
                        THEN c.user_pseudo_id END),
       COUNT(DISTINCT c.user_pseudo_id))                                              AS retention_rate
FROM cohort c
LEFT JOIN session_starts s
       ON c.user_pseudo_id = s.user_pseudo_id
GROUP BY c.quickplay_event
ORDER BY retention_rate ASC      -- << lowest on top
LIMIT 20;
```

The first row returned by query 10 is the quickplay event type with the lowest week-2 retention rate for users who first engaged between 1-Aug and 15-Aug 2018, measured by the presence of `session_start` events.
