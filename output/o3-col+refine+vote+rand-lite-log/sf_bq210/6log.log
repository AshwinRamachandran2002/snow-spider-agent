```sql
--Description: 1) Inspect a few U.S. B2 publications that were granted between 2008-01-01 and 2018-12-31
SELECT
  "publication_number",
  "grant_date",
  "kind_code",
  "country_code",
  "claims_localized"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'US'
  AND "kind_code" = 'B2'
  AND "grant_date" BETWEEN 20080101 AND 20181231
LIMIT 20;
```

```sql
--Description: 2) Look at the raw JSON structure of the “claims_localized” field for one sample record
SELECT
  "publication_number",
  "claims_localized"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "publication_number" = 'US-7650331-B2'   -- ← replace with any id returned above
LIMIT 20;
```

```sql
--Description: 3) Flatten the array in “claims_localized” to expose language and text elements
SELECT
  p."publication_number",
  f.value:"language"::STRING  AS "lang",
  f.value:"text"::STRING      AS "claim_text"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."claims_localized") f
WHERE p."country_code" = 'US'
  AND p."kind_code" = 'B2'
  AND p."grant_date" BETWEEN 20080101 AND 20181231
LIMIT 20;
```

```sql
--Description: 4) Preview claims that (probably) do NOT contain the word “claim” (case-insensitive)
SELECT
  p."publication_number",
  f.value:"language"::STRING  AS "lang",
  LEFT(f.value:"text"::STRING, 200) AS "claim_snippet"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."claims_localized") f
WHERE p."country_code" = 'US'
  AND p."kind_code" = 'B2'
  AND p."grant_date" BETWEEN 20080101 AND 20181231
  AND f.value:"text"::STRING ILIKE '%'
  AND f.value:"text"::STRING NOT ILIKE '%claim%'
LIMIT 20;
```

```sql
--Description: 5) For every publication, decide whether ANY of its claim texts lacks the word “claim”
SELECT DISTINCT
  p."publication_number"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."claims_localized") f
WHERE p."country_code" = 'US'
  AND p."kind_code" = 'B2'
  AND p."grant_date" BETWEEN 20080101 AND 20181231
GROUP BY p."publication_number"
HAVING BOOLAND_AGG( f.value:"text"::STRING NOT ILIKE '%claim%' )
LIMIT 20;
```

```sql
--Description: 6) Count how many U.S. B2 patents (2008-2018) have at least one claim text without “claim”
SELECT
  COUNT(*) AS "num_us_b2_patents_2008_2018_with_a_claim_without_word_claim"
FROM (
  SELECT
    p."publication_number"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."claims_localized") f
  WHERE p."country_code" = 'US'
    AND p."kind_code" = 'B2'
    AND p."grant_date" BETWEEN 20080101 AND 20181231
  GROUP BY p."publication_number"
  HAVING BOOLAND_AGG( f.value:"text"::STRING NOT ILIKE '%claim%' )
) AS sub
LIMIT 20;
```

```sql
--Description: 7) (Optional) See top 20 examples of such publications with grant date and title
SELECT
  p."publication_number",
  p."grant_date",
  t.value:"text"::STRING AS "title_en"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."title_localized") t
WHERE p."publication_number" IN (
  SELECT
    sub."publication_number"
  FROM PATENTS.PATENTS.PUBLICATIONS sub,
       LATERAL FLATTEN(input => sub."claims_localized") f
  WHERE sub."country_code" = 'US'
    AND sub."kind_code" = 'B2'
    AND sub."grant_date" BETWEEN 20080101 AND 20181231
  GROUP BY sub."publication_number"
  HAVING BOOLAND_AGG( f.value:"text"::STRING NOT ILIKE '%claim%' )
)
  AND t.value:"language"::STRING = 'en'
LIMIT 20;
```

```sql
--Description: 8) Verify that EVERY claim of these patents lacks the word “claim”
SELECT
  p."publication_number",
  COUNT(*)                           AS "total_claims",
  SUM( IFF(f.value:"text"::STRING ILIKE '%claim%', 1, 0) ) AS "claims_with_word_claim"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."claims_localized") f
WHERE p."publication_number" IN (
  SELECT
    sub."publication_number"
  FROM PATENTS.PATENTS.PUBLICATIONS sub,
       LATERAL FLATTEN(input => sub."claims_localized") ff
  WHERE sub."country_code" = 'US'
    AND sub."kind_code" = 'B2'
    AND sub."grant_date" BETWEEN 20080101 AND 20181231
  GROUP BY sub."publication_number"
  HAVING BOOLAND_AGG( ff.value:"text"::STRING NOT ILIKE '%claim%' )
)
GROUP BY p."publication_number"
LIMIT 20;
```

