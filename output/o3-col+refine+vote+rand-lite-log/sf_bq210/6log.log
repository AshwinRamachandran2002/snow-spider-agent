--Description: 8) Verify that each selected patent indeed has zero claims containing “claim”
SELECT
  p."publication_number",
  COUNT(*)                                              AS "total_claims",
  SUM( IFF(f.value:"text"::STRING ILIKE '%claim%', 1, 0) ) AS "claims_with_word_claim"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."claims_localized") f
WHERE p."publication_number" IN (
  SELECT
    sub."publication_number"
  FROM PATENTS.PATENTS.PUBLICATIONS sub,
       LATERAL FLATTEN(input => sub."claims_localized") ff
  WHERE sub."country_code" = 'US'
    AND sub."kind_code"   = 'B2'
    AND sub."grant_date"  BETWEEN 20080101 AND 20181231
  GROUP BY sub."publication_number"
  HAVING BOOLAND_AGG( ff.value:"text"::STRING NOT ILIKE '%claim%' )
)
