  "grant_date",
  "kind_code",
  "country_code",
  "claims_localized"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'US'
  AND "kind_code" = 'B2'
  AND "grant_date" BETWEEN 20080101 AND 20181231
LIMIT 20;
