-- Thinking process:
-- • We need U S patents (country_code = 'US') with kind code 'B2' (granted) whose
--   publication dates are between 2008-01-01 and 2018-12-31 inclusive.
-- • The claims are stored in JSON array column "claims_localized"; we flatten it.
-- • Keep only English claims  -> language = 'en'.
-- • For each claim text, check if it contains the substring 'claim' (case-insensitive).
-- • Aggregate per patent:
--     · If ANY English claim contains 'claim' → flag = 1
--     · Else (no English claim contains 'claim') → flag = 0
-- • Finally count patents where the flag = 0.
WITH flattened AS (
    SELECT  p."publication_number",
            CASE
                WHEN f.value:"text"::STRING ILIKE '%claim%' THEN 1
                ELSE 0
            END AS has_claim_word
    FROM    PATENTS.PATENTS.PUBLICATIONS  p,
            LATERAL FLATTEN( INPUT => p."claims_localized" ) f
    WHERE   p."country_code"     = 'US'         -- US patents only
      AND   p."kind_code"        = 'B2'         -- Grant kind
      AND   p."publication_date" BETWEEN 20080101 AND 20181231
      AND   LOWER( f.value:"language"::STRING ) = 'en'  -- English claims
)
SELECT COUNT(*) AS "patents_without_word_claim"
FROM  (
        SELECT "publication_number",
               MAX(has_claim_word) AS max_flag
        FROM   flattened
        GROUP  BY "publication_number"
      ) AS per_patent
WHERE  max_flag = 0;   -- keep patents whose English claims never use the word 'claim'
