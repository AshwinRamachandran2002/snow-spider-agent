--Description: 6) Count U​S B2 patents (2008-2018) having ≥1 English claim that omits the word ‘claim’
SELECT COUNT( DISTINCT p."publication_number") AS "patent_count"
FROM   PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN( INPUT => p."claims_localized" ) f
WHERE  p."country_code"     = 'US'
  AND  p."kind_code"        = 'B2'
  AND  p."publication_date" BETWEEN 20080101 AND 20181231
  AND  LOWER(f.value:"language"::STRING) = 'en'
  AND  f.value:"text"::STRING NOT ILIKE '%claim%';
