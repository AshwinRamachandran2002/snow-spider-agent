Query:
--Description: 7) Count U​S B2 patents (2008-2018) whose English claims never include the word ‘claim’
WITH cte AS (
  SELECT p."publication_number",
         MAX( CASE WHEN f.value:"text"::STRING ILIKE '%claim%' THEN 1 ELSE 0 END ) AS "has_claim_word"
  FROM   PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN( INPUT => p."claims_localized" ) f
  WHERE  p."country_code"     = 'US'
    AND  p."kind_code"        = 'B2'
    AND  p."publication_date" BETWEEN 20080101 AND 20181231
    AND  LOWER(f.value:"language"::STRING) = 'en'
  GROUP BY p."publication_number"
)
SELECT COUNT(*) AS "patent_all_exclude_claim"
FROM   cte
WHERE  "has_claim_word" = 0;
Answer:
patent_all_exclude_claim
24
