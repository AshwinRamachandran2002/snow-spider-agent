Query:
--Description / Thinking process:
-- • Objective: show, for each year 2008-2018, how many distinct US-B2 patents have at least ONE English claim that omits the word “claim”.
-- • Approach:
--     1. Flatten "claims_localized" so every English claim becomes one row.
--     2. Filter to records whose claim text does NOT contain 'claim' (case-insensitive).
--     3. Count distinct publication numbers per year (derived from the first four digits of publication_date).
-- • Casting publication_date (NUMBER, yyyymmdd) to VARCHAR ensures SUBSTR works correctly.

SELECT SUBSTR( TO_VARCHAR( p."publication_date" ), 1, 4 ) AS "year",
       COUNT( DISTINCT p."publication_number" )            AS "patent_count"
FROM   PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN( INPUT => p."claims_localized" ) f
WHERE  p."country_code"     = 'US'         -- US patents
  AND  p."kind_code"        = 'B2'         -- granted
  AND  p."publication_date" BETWEEN 20080101 AND 20181231
  AND  LOWER( f.value:"language"::STRING ) = 'en'   -- English claims
  AND  f.value:"text"::STRING NOT ILIKE '%claim%'   -- claim text lacks 'claim'
GROUP BY SUBSTR( TO_VARCHAR( p."publication_date" ), 1, 4 )
ORDER BY "year"
LIMIT 20
Answer:
year,patent_count
2008,2
2009,5
2010,9
2011,4
2012,1
2013,3
