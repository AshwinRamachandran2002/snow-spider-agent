Query:
--Description: 6) Compute variance of FPKM-UQ for every protein-coding gene in Solid Tissue Normal samples  
SELECT "gene_name",
       VAR_SAMP("fpkm_uq_unstranded") AS "var_fpkm_uq"
FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R40"
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "sample_type_name" ILIKE '%Solid%Tissue%Normal%'
  AND "gene_type" = 'protein_coding'
GROUP BY "gene_name"
HAVING COUNT(*) > 1                  -- need at least 2 values to form variance
ORDER BY "var_fpkm_uq" DESC
LIMIT 20;
