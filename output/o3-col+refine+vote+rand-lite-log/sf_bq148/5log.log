--Description: 9) Final report – variance, mean and sample count for the five highest-variance protein-coding genes in TCGA-BRCA Solid Tissue Normal samples
SELECT
    "gene_name",
    VAR_SAMP("fpkm_uq_unstranded") AS "variance",
    AVG("fpkm_uq_unstranded")      AS "mean_fpkm_uq",
    COUNT(*)                       AS "n_normal_samples"
FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R40"
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "sample_type_name"  ILIKE '%Solid%Tissue%Normal%'
  AND "gene_type"         = 'protein_coding'
  AND "gene_name" IN ('MT-CO1', 'MT-CO3', 'MT-ND4', 'SAA1', 'MT-ND3')
GROUP BY "gene_name"
ORDER BY "variance" DESC
LIMIT 20
