Query:
--Description: Retrieve all expression records for the five most variable protein-coding genes (verification)
WITH top5 AS (
  SELECT
    r."gene_name"
  FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R40" r
  JOIN (
        SELECT DISTINCT "sample_barcode"
        FROM TCGA.TCGA_VERSIONED."PER_SAMPLE_FILE_METADATA_HG38_GDC_R36"
        WHERE "project_short_name" = 'TCGA-BRCA'
          AND "sample_type_name" ILIKE '%Solid%Tissue%Normal%'
       ) m
    ON r."sample_barcode" = m."sample_barcode"
  WHERE r."project_short_name" = 'TCGA-BRCA'
    AND r."sample_type_name" ILIKE '%Solid%Tissue%Normal%'
    AND r."gene_type" = 'protein_coding'
  GROUP BY r."gene_name"
  ORDER BY VAR_SAMP(r."fpkm_uq_unstranded") DESC
  LIMIT 5
)
SELECT
  r."gene_name",
  r."sample_barcode",
  r."fpkm_uq_unstranded"
FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R40" r
WHERE r."project_short_name" = 'TCGA-BRCA'
  AND r."gene_name" IN (SELECT "gene_name" FROM top5)
  AND r."sample_type_name" ILIKE '%Solid%Tissue%Normal%'
LIMIT 20;
