FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R40"  
WHERE "project_short_name" = 'TCGA-BRCA'  
  AND "sample_type_name" ILIKE '%Solid%Tissue%Normal%'  
LIMIT 20;
```

```sql
-- Description: Quick look at protein-coding gene expression values in Solid Tissue Normal  
SELECT "gene_name", "fpkm_uq_unstranded"  
FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R40"  
WHERE "project_short_name" = 'TCGA-BRCA'  
  AND "sample_type_name" ILIKE '%Solid%Tissue%Normal%'  
  AND "gene_type" = 'protein_coding'  
LIMIT 20;
```

```sql
-- Description: Compute the variance of expression for each protein-coding gene  
SELECT "gene_name",  
       VAR_SAMP("fpkm_uq_unstranded") AS "expr_var"  
FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R40"  
WHERE "project_short_name" = 'TCGA-BRCA'  
  AND "sample_type_name" ILIKE '%Solid%Tissue%Normal%'  
  AND "gene_type" = 'protein_coding'  
GROUP BY "gene_name"  
LIMIT 20;
```

```sql
-- Description: Rank genes by highest variance (top 20 preview)  
SELECT "gene_name",  
       VAR_SAMP("fpkm_uq_unstranded") AS "expr_var"  
FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R40"  
WHERE "project_short_name" = 'TCGA-BRCA'  
  AND "sample_type_name" ILIKE '%Solid%Tissue%Normal%'  
  AND "gene_type" = 'protein_coding'  
GROUP BY "gene_name"  
ORDER BY "expr_var" DESC  
LIMIT 20;
```

```sql
-- Description: Retrieve the top five protein-coding genes with the highest variance  
SELECT "gene_name",  
       VAR_SAMP("fpkm_uq_unstranded") AS "expr_var"  
FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R40"  
WHERE "project_short_name" = 'TCGA-BRCA'  
  AND "sample_type_name" ILIKE '%Solid%Tissue%Normal%'  
  AND "gene_type" = 'protein_coding'  
GROUP BY "gene_name"  
ORDER BY "expr_var" DESC  
LIMIT 5;
```


