```sql
-- 2) Inspect the keys that live inside event_params for page_view events
SELECT ep.key, ep.value.string_value
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210109`,
UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
LIMIT 20;
```

```sql
-- 3) Pull the page_location string for a handful of January page-views
SELECT event_timestamp, 
       ep.value.string_value AS page_location, 
       user_pseudo_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210109`,
UNNEST(event_params) AS ep
WHERE event_name = 'page_view' 
  AND ep.key = 'page_location'
LIMIT 20;
```

```sql
-- 4) Which pages were visited most often on 9-Jan-2021?
SELECT ep.value.string_value AS page_location,
       COUNT(*)               AS pageviews
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210109`,
UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
GROUP BY page_location
ORDER BY pageviews DESC
LIMIT 20;
```

```sql
-- 5) Aggregate all January 2021 tables to find the 20 most-visited pages
SELECT ep.value.string_value AS page_location,
       COUNT(*)               AS pageviews
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
GROUP BY page_location
ORDER BY pageviews DESC
LIMIT 20;
```

```sql
-- 6) Isolate the single most-visited page in January 2021
WITH ranked_pages AS (
  SELECT ep.value.string_value AS page_location,
         COUNT(*)               AS pageviews,
         ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
  UNNEST(event_params) AS ep
  WHERE event_name = 'page_view'
    AND ep.key = 'page_location'
  GROUP BY page_location
)
SELECT page_location, pageviews
FROM ranked_pages
WHERE rn = 1
LIMIT 20;
```

```sql
-- 7) Show 20 distinct users who viewed that top page (for spot-checking)
WITH top_page AS (
  SELECT ep.value.string_value AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
  UNNEST(event_params) AS ep
  WHERE event_name = 'page_view'
    AND ep.key = 'page_location'
  GROUP BY page_location
  ORDER BY COUNT(*) DESC
  LIMIT 1              -- the most-visited page
)
SELECT DISTINCT user_pseudo_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
UNNEST(event_params) AS ep
JOIN top_page tp
  ON ep.value.string_value = tp.page_location
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
LIMIT 20;
```

```sql
-- 8) FINAL ANSWER – how many DISTINCT users viewed the most-visited January page?
WITH top_page AS (
  SELECT ep.value.string_value AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
  UNNEST(event_params) AS ep
  WHERE event_name = 'page_view'
    AND ep.key = 'page_location'
  GROUP BY page_location
  ORDER BY COUNT(*) DESC
  LIMIT 1              -- most-frequently visited page in Jan-2021
)
SELECT COUNT(DISTINCT user_pseudo_id) AS distinct_users_who_viewed_top_page
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
UNNEST(event_params) AS ep
JOIN top_page tp
  ON ep.value.string_value = tp.page_location
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
LIMIT 20;
```
