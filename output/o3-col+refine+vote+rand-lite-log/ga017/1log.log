-- 8) FINAL ANSWER – how many DISTINCT users viewed the most-visited January page?
WITH top_page AS (
  SELECT ep.value.string_value AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
  UNNEST(event_params) AS ep
  WHERE event_name = 'page_view'
    AND ep.key = 'page_location'
  GROUP BY page_location
  ORDER BY COUNT(*) DESC
  LIMIT 1              -- most-frequently visited page in Jan-2021
)
SELECT COUNT(DISTINCT user_pseudo_id) AS distinct_users_who_viewed_top_page
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
UNNEST(event_params) AS ep
JOIN top_page tp
  ON ep.value.string_value = tp.page_location
WHERE event_name = 'page_view'
  AND ep.key = 'page_location'
LIMIT 20;
