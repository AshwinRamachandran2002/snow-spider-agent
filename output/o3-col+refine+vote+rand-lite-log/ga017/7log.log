```sql
--Description: 
-- Step-by-step in one statement:
-- 1) CTE pv  : collect every January-2021 `page_view` event, unnesting `event_params`
--              to capture the URL (`page_location`) and visitor id (`user_pseudo_id`).
-- 2) CTE top : find the single URL with the greatest number of page-view events.
-- 3) Final   : count DISTINCT users whose `page_location` equals that top page.
WITH pv AS (
  SELECT
    ep.value.string_value AS page_location,
    t.user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*` AS t
  CROSS JOIN UNNEST(t.event_params) AS ep
  WHERE t.event_name = 'page_view'
    AND ep.key = 'page_location'
), 
top AS (
  SELECT page_location
  FROM pv
  GROUP BY page_location
  ORDER BY COUNT(*) DESC
  LIMIT 1
)
SELECT
  COUNT(DISTINCT pv.user_pseudo_id) AS distinct_users_on_most_viewed_page
FROM pv
JOIN top USING (page_location);
```
