--Description: 9)  Same answer as #8 but guarding against ties (DENSE_RANK = 1).
--  – ranked_pages CTE ranks each URL by total page-view count.
--  – Final step filters to rnk = 1 and counts DISTINCT users for those URLs.
WITH ranked_pages AS (
  SELECT
    ep.value.string_value                       AS page_location,
    COUNT(*)                                    AS views,
    DENSE_RANK() OVER (ORDER BY COUNT(*) DESC)  AS rnk
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*` AS t
  CROSS JOIN UNNEST(t.event_params) AS ep
  WHERE t.event_name = 'page_view'
    AND ep.key  = 'page_location'
  GROUP BY page_location
)
SELECT
  rp.page_location,
  COUNT(DISTINCT t.user_pseudo_id) AS distinct_users
FROM ranked_pages AS rp
JOIN `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*` AS t
ON TRUE
CROSS JOIN UNNEST(t.event_params) AS ep
WHERE rp.rnk = 1
  AND t.event_name = 'page_view'
  AND ep.key  = 'page_location'
  AND ep.value.string_value = rp.page_location
GROUP BY rp.page_location
