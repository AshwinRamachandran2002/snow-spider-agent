WHERE t.event_name = 'page_view'
  AND ep.key = 'page_location'
GROUP BY page_location
ORDER BY COUNT(*) DESC
LIMIT 20;
```

```sql
--Description: 8) Distinct users on the single most-visited page (sub-query for top page)
WITH top_page AS (
  SELECT ep.value.string_value AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*` AS t
  CROSS JOIN UNNEST(t.event_params) AS ep
  WHERE t.event_name = 'page_view'
    AND ep.key = 'page_location'
  GROUP BY page_location
  ORDER BY COUNT(*) DESC
  LIMIT 1
)
SELECT
  tp.page_location,
  COUNT(DISTINCT t.user_pseudo_id) AS distinct_users
FROM top_page AS tp
JOIN `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*` AS t
  ON TRUE
CROSS JOIN UNNEST(t.event_params) AS ep
WHERE t.event_name = 'page_view'
  AND ep.key = 'page_location'
  AND ep.value.string_value = tp.page_location
GROUP BY tp.page_location
LIMIT 20;
```

```sql
--Description: 9) Same answer as #8 but using DENSE_RANK instead of LIMIT 1 to guard ties
WITH ranked_pages AS (
  SELECT
    ep.value.string_value AS page_location,
    COUNT(*)              AS views,
    DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS rnk
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*` AS t
  CROSS JOIN UNNEST(t.event_params) AS ep
  WHERE t.event_name = 'page_view'
    AND ep.key = 'page_location'
  GROUP BY page_location
)
SELECT
  page_location,
  COUNT(DISTINCT user_pseudo_id) AS distinct_users
FROM ranked_pages AS rp
JOIN `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*` AS t
  ON TRUE
CROSS JOIN UNNEST(t.event_params) AS ep
WHERE rp.rnk = 1
  AND t.event_name = 'page_view'
  AND ep.key = 'page_location'
  AND ep.value.string_value = rp.page_location
GROUP BY page_location
LIMIT 20;
```

