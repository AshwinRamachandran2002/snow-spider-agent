2025-05-05 02:42:49 - Thread-1267 (execute) - INFO - [Exploration]
Below are exploratory SQL snippets (≤ 10) that progressively inspect the relevant tables and build toward the requested “best seller per month” logic.  
Every column name is wrapped in double quotes and every fully-qualified table name follows the pattern  
THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.<TABLE>.  
Each query is limited to 20 rows for quick inspection.

```sql
--Description: 1) Glimpse a few products to understand brand / category / distribution data
SELECT 
  "id",
  "name",
  "brand",
  "category",
  "retail_price",
  "distribution_center_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
WHERE "brand" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 2) See which order item statuses exist
SELECT DISTINCT "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
LIMIT 20;
```

```sql
--Description: 3) Peek at ORDER_ITEMS that are already ‘Complete’ and join to PRODUCTS to verify brand / price
SELECT 
  oi."id"            AS "order_item_id",
  oi."order_id",
  p."name"           AS "product_name",
  p."brand",
  p."category",
  oi."sale_price",
  oi."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
     ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
  AND p."brand" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 4) Convert micro-second timestamps to calendar month for quick sanity check (last 20 months)
SELECT 
  DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)) AS "order_month",
  COUNT(*)                                                      AS "items_sold"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
WHERE oi."status" = 'Complete'
GROUP BY 1
ORDER BY 1 DESC
LIMIT 20;
```

```sql
--Description: 5) Aggregate monthly sales volume & revenue per product (sample 2023 months)
SELECT
  DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))                 AS "order_month",
  p."id"                                                                     AS "product_id",
  p."name"                                                                   AS "product_name",
  p."brand",
  p."category",
  COUNT(*)                                                                   AS "total_sales",
  ROUND(SUM(oi."sale_price"), 2)                                             AS "total_revenue"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    p
     ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
  AND p."brand" IS NOT NULL
  AND DATE_TRUNC('year', TO_TIMESTAMP(oi."created_at"/1000000)) = '2023-01-01'::DATE
GROUP BY 1,2,3,4,5
ORDER BY "order_month", "total_sales" DESC, "total_revenue" DESC
LIMIT 20;
```

```sql
--Description: 6) Rank products within each month on sales volume (revenue tiebreaker) – preview of ranking columns
SELECT
  monthly.*,
  ROW_NUMBER() OVER (PARTITION BY "order_month"
                     ORDER BY "total_sales" DESC, "total_revenue" DESC)      AS "sales_rank"
FROM (
  SELECT
    DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
    p."name"                                                   AS "product_name",
    p."brand",
    p."category",
    COUNT(*)                                                   AS "total_sales",
    ROUND(SUM(oi."sale_price"),2)                              AS "total_revenue"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    p
       ON oi."product_id" = p."id"
  WHERE oi."status" = 'Complete'
    AND p."brand" IS NOT NULL
  GROUP BY 1,2,3,4
) monthly
ORDER BY "order_month" DESC, "sales_rank"
LIMIT 20;
```

```sql
--Description: 7) Extract the single best-seller per month up to (but not including) July-2024
SELECT *
FROM (
  SELECT
    DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
    p."name"                                                   AS "product_name",
    p."brand",
    p."category",
    COUNT(*)                                                   AS "total_sales",
    ROUND(SUM(oi."sale_price"),2)                              AS "total_revenue",
    'Complete'                                                 AS "order_status",
    ROW_NUMBER() OVER (PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))
                       ORDER BY COUNT(*) DESC, SUM(oi."sale_price") DESC)    AS "sales_rank"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    p
       ON oi."product_id" = p."id"
  WHERE oi."status" = 'Complete'
    AND p."brand" IS NOT NULL
    AND TO_TIMESTAMP(oi."created_at"/1000000) < '2024-07-01'::DATE
  GROUP BY 1,2,3,4
) ranked
WHERE "sales_rank" = 1
ORDER BY "order_month" DESC
LIMIT 20;
```

```sql
--Description: 8) Check for duplicate top sellers (ties resolved) in one recent month (e.g., 2024-06)
SELECT 
  *
FROM (
  SELECT
    DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
    p."name",
    p."brand",
    COUNT(*)                           AS "total_sales",
    SUM(oi."sale_price")              AS "total_revenue",
    ROW_NUMBER() OVER (PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))
                       ORDER BY COUNT(*) DESC, SUM(oi."sale_price") DESC) AS "rnk"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    p
       ON oi."product_id" = p."id"
  WHERE oi."status" = 'Complete'
    AND p."brand" IS NOT NULL
    AND DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) = '2024-06-01'::DATE
  GROUP BY 1,2,3
) x
WHERE "rnk" = 1
LIMIT 20;
```

```sql
--Description: 9) Display the same ranking but include 2nd & 3rd place for comparison (one arbitrary month)
SELECT *
FROM (
  SELECT
    DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
    p."name",
    p."brand",
    p."category",
    COUNT(*)                           AS "total_sales",
    ROUND(SUM(oi."sale_price"),2)      AS "total_revenue",
    ROW_NUMBER() OVER (PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))
                       ORDER BY COUNT(*) DESC, SUM(oi."sale_price") DESC) AS "rank_in_month"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    p
       ON oi."product_id" = p."id"
  WHERE oi."status" = 'Complete'
    AND p."brand" IS NOT NULL
    AND DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) = '2023-12-01'::DATE
  GROUP BY 1,2,3,4
) ranked
WHERE "rank_in_month" <= 3
ORDER BY "rank_in_month"
LIMIT 20;
```

```sql
--Description: 10) Full report (no LIMIT) – ready to swap into production once validated
SELECT
  TO_CHAR("order_month", 'YYYY-MM')                                    AS "month",
  "product_name",
  "brand",
  "category",
  "total_sales",
  ROUND("total_revenue", 2)                                            AS "total_revenue",
  "order_status"
FROM (
  SELECT
    DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
    p."name"                                                   AS "product_name",
    p."brand",
    p."category",
    COUNT(*)                                                   AS "total_sales",
    SUM(oi."sale_price")                                       AS "total_revenue",
    'Complete'                                                 AS "order_status",
    ROW_NUMBER() OVER (PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))
                       ORDER BY COUNT(*) DESC, SUM(oi."sale_price") DESC) AS "rnk"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    p
       ON oi."product_id" = p."id"
  WHERE oi."status" = 'Complete'
    AND p."brand" IS NOT NULL
    AND TO_TIMESTAMP(oi."created_at"/1000000) < '2024-07-01'::DATE
  GROUP BY 1,2,3,4
) best
WHERE "rnk" = 1
ORDER BY "order_month";
```
