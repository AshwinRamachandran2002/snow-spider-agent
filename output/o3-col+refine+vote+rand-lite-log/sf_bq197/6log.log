FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"  
LIMIT 20;
```

```sql
--Description: 3) Check the item-level statuses that appear in ORDER_ITEMS  
SELECT DISTINCT "status"  
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  
LIMIT 20;
```

```sql
--Description: 4) Look at 20 sample ORDER_ITEMS that belong to orders whose status is ‘Complete’  
SELECT oi."id", oi."order_id", oi."product_id", oi."sale_price", oi."created_at", o."status"  
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi  
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
  ON oi."order_id" = o."order_id"  
WHERE o."status" = 'Complete'  
LIMIT 20;
```

```sql
--Description: 5) Glimpse at product information (name / brand / category) that we will later join on  
SELECT "id" AS "product_id",
       "name",
       "brand",
       "category"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"
WHERE "brand" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 6) Combine the three core tables for a quick sanity-check of joined data  
SELECT oi."order_id",
       p."name"     AS "product_name",
       p."brand",
       p."category",
       oi."sale_price",
       oi."created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
  ON oi."order_id" = o."order_id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
  ON oi."product_id" = p."id"
WHERE o."status" = 'Complete'
  AND p."brand"  IS NOT NULL
LIMIT 20;
```

```sql
--Description: 7) Convert micro-seconds to month and show one month’s worth of “Complete” sales (Jan-2024 as example)  
SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "sales_month",
       p."name",
       p."brand",
       SUM(1)                     AS "units_sold",
       ROUND(SUM(oi."sale_price")) AS "revenue"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
  ON oi."order_id" = o."order_id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
  ON oi."product_id" = p."id"
WHERE o."status"   = 'Complete'
  AND p."brand"    IS NOT NULL
  AND DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) = '2024-01-01'::DATE
GROUP BY 1,2,3
ORDER BY "units_sold" DESC, "revenue" DESC
LIMIT 20;
```

```sql
--Description: 8) Aggregate monthly sales (units & revenue) for every product up to 2024-06  
SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "sales_month",
       oi."product_id",
       SUM(1)                     AS "units_sold",
       ROUND(SUM(oi."sale_price")) AS "revenue"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
  ON oi."order_id" = o."order_id"
WHERE o."status" = 'Complete'
  AND DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) < '2024-07-01'::DATE
GROUP BY 1,2
LIMIT 20;
```

```sql
--Description: 9) Rank products inside each month by volume, tiebreaker revenue (show 20 rows of ranking)  
SELECT a.*,
       ROW_NUMBER() OVER (PARTITION BY a."sales_month"
                          ORDER BY a."units_sold" DESC,
                                   a."revenue"   DESC) AS "rank_in_month"
FROM (
      SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "sales_month",
             oi."product_id",
             SUM(1)                     AS "units_sold",
             ROUND(SUM(oi."sale_price")) AS "revenue"
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
        ON oi."order_id" = o."order_id"
      WHERE o."status" = 'Complete'
        AND DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) < '2024-07-01'::DATE
      GROUP BY 1,2
     ) a
ORDER BY a."sales_month" DESC, "rank_in_month"
LIMIT 20;
```

```sql
--Description: 10) Final report – one winning product per month (before Jul-2024) with name, brand, category & metrics  
SELECT r."sales_month",
       p."name"      AS "product_name",
       p."brand",
       p."category",
       r."units_sold" AS "total_sales",
       r."revenue"    AS "rounded_total_revenue",
       'Complete'     AS "order_status"
FROM (
      SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "sales_month",
             oi."product_id",
             SUM(1)                     AS "units_sold",
             ROUND(SUM(oi."sale_price")) AS "revenue",
             ROW_NUMBER() OVER (PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000))
                                ORDER BY SUM(1) DESC,
                                         ROUND(SUM(oi."sale_price")) DESC) AS rn
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
        ON oi."order_id" = o."order_id"
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
        ON oi."product_id" = p."id"
      WHERE o."status" = 'Complete'
        AND p."brand"  IS NOT NULL
        AND DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) < '2024-07-01'::DATE
      GROUP BY 1,2
     ) r
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
  ON r."product_id" = p."id"
WHERE r.rn = 1
ORDER BY r."sales_month";
```
