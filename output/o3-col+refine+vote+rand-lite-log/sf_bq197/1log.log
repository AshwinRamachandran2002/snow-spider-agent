Query:
--Description:  Rank products inside every month by volume (revenue breaks ties)  
WITH monthly_stats AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))  AS "year_month",
         p."name",
         p."brand",
         p."category",
         COUNT(*)                              AS "monthly_sales",
         ROUND(SUM(oi."sale_price"), 2)        AS "monthly_revenue"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
  JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p  ON p."id" = oi."product_id"
  WHERE  oi."status" = 'Complete'
  AND    p."brand" IS NOT NULL
  GROUP  BY "year_month", p."name", p."brand", p."category"
)
SELECT *,
       RANK() OVER (PARTITION BY "year_month"
                    ORDER BY "monthly_sales" DESC, "monthly_revenue" DESC) AS "rnk"
FROM   monthly_stats
ORDER  BY "year_month" DESC, "rnk"
LIMIT 20;
Answer:
year_month,name,brand,category,monthly_sales,monthly_revenue,rnk
