```sql
--Description:  Verify that products indeed carry brand information and that some rows are NULL / non-NULL  
SELECT DISTINCT "brand"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
LIMIT 20;
```

```sql
--Description:  Sample a few item rows that belong to completed orders and show basic product attributes  
SELECT oi."order_id",
       oi."product_id",
       p."name",
       p."brand",
       p."category",
       oi."sale_price",
       oi."status",
       oi."created_at"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o  ON o."order_id" = oi."order_id"
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p  ON p."id"       = oi."product_id"
WHERE  oi."status" = 'Complete'
AND    p."brand"  IS NOT NULL
LIMIT 20;
```

```sql
--Description:  Count how many times each product appears in item-level data set (irrespective of time)  
SELECT oi."product_id",
       COUNT(*) AS "total_sales"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
WHERE  oi."status" = 'Complete'
GROUP  BY oi."product_id"
ORDER  BY "total_sales" DESC
LIMIT 20;
```

```sql
--Description:  Produce monthly sales volume per product (using order item creation time)  
SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))  AS "year_month",
       oi."product_id",
       COUNT(*) AS "monthly_sales"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
WHERE  oi."status" = 'Complete'
GROUP  BY "year_month", oi."product_id"
ORDER  BY "year_month" DESC, "monthly_sales" DESC
LIMIT 20;
```

```sql
--Description:  Extend the previous step by adding total revenue collected for each product-month combo  
SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))  AS "year_month",
       oi."product_id",
       COUNT(*)                                   AS "monthly_sales",
       ROUND(SUM(oi."sale_price"), 2)             AS "monthly_revenue"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
WHERE  oi."status" = 'Complete'
GROUP  BY "year_month", oi."product_id"
ORDER  BY "year_month" DESC, "monthly_sales" DESC, "monthly_revenue" DESC
LIMIT 20;
```

```sql
--Description:  Attach product details so the record contains human-readable name / brand / category  
SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))  AS "year_month",
       p."name",
       p."brand",
       p."category",
       COUNT(*)                                   AS "monthly_sales",
       ROUND(SUM(oi."sale_price"), 2)             AS "monthly_revenue"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p  ON p."id" = oi."product_id"
WHERE  oi."status" = 'Complete'
AND    p."brand" IS NOT NULL
GROUP  BY "year_month", p."name", p."brand", p."category"
ORDER  BY "year_month" DESC, "monthly_sales" DESC, "monthly_revenue" DESC
LIMIT 20;
```

```sql
--Description:  Rank products inside every month by volume (revenue breaks ties)  
WITH monthly_stats AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))  AS "year_month",
         p."name",
         p."brand",
         p."category",
         COUNT(*)                              AS "monthly_sales",
         ROUND(SUM(oi."sale_price"), 2)        AS "monthly_revenue"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
  JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p  ON p."id" = oi."product_id"
  WHERE  oi."status" = 'Complete'
  AND    p."brand" IS NOT NULL
  GROUP  BY "year_month", p."name", p."brand", p."category"
)
SELECT *,
       RANK() OVER (PARTITION BY "year_month"
                    ORDER BY "monthly_sales" DESC, "monthly_revenue" DESC) AS "rnk"
FROM   monthly_stats
ORDER  BY "year_month" DESC, "rnk"
LIMIT 20;
```

```sql
--Description:  Retrieve the single best-selling product for every month before July-2024 (volume → revenue tiebreaker)  
WITH monthly_stats AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))  AS "year_month",
         p."name",
         p."brand",
         p."category",
         COUNT(*)                              AS "total_sales",
         ROUND(SUM(oi."sale_price"), 2)        AS "total_revenue"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
  JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p  ON p."id" = oi."product_id"
  WHERE  oi."status" = 'Complete'
  AND    p."brand" IS NOT NULL
  AND    TO_TIMESTAMP(oi."created_at" / 1000000) < '2024-07-01'
  GROUP  BY "year_month", p."name", p."brand", p."category"
)
SELECT "year_month"        AS "month",
       "name"              AS "product_name",
       "brand",
       "category",
       "total_sales",
       "total_revenue",
       'Complete'          AS "order_status"
FROM   (
  SELECT *,
         RANK() OVER (PARTITION BY "year_month"
                      ORDER BY "total_sales" DESC, "total_revenue" DESC) AS rnk
  FROM   monthly_stats
) t
WHERE  rnk = 1
ORDER  BY "month" DESC
LIMIT 20;
```

