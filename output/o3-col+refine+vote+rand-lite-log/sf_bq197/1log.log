Query:
--Description:  Extend the previous step by adding total revenue collected for each product-month combo  
SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))  AS "year_month",
       oi."product_id",
       COUNT(*)                                   AS "monthly_sales",
       ROUND(SUM(oi."sale_price"), 2)             AS "monthly_revenue"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
WHERE  oi."status" = 'Complete'
GROUP  BY "year_month", oi."product_id"
ORDER  BY "year_month" DESC, "monthly_sales" DESC, "monthly_revenue" DESC
LIMIT 20;
