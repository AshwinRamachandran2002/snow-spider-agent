  AND object_end_date <= 1839
LIMIT 20;
```

```sql
-- 5. Remove “unknown” artists
SELECT object_id, title, artist_display_name, object_end_date
FROM `bigquery-public-data.the_met.objects`
WHERE department = 'Photographs'
  AND LOWER(object_name) LIKE '%photograph%'
  AND object_end_date <= 1839
  AND LOWER(IFNULL(artist_display_name,'')) NOT LIKE '%unknown%'
LIMIT 20;
```

```sql
-- 6. Preview images table to understand URLs
SELECT object_id, original_image_url
FROM `bigquery-public-data.the_met.images`
LIMIT 20;
