```sql
-- 1. Inspect the different release years present in Movie
SELECT DISTINCT year
FROM Movie
ORDER BY year
LIMIT 20;
```

```sql
-- 2. Check the earliest and latest years to understand the span
SELECT MIN(CAST(year AS INTEGER))  AS earliest_year,
       MAX(CAST(year AS INTEGER))  AS latest_year
FROM Movie;
```

```sql
-- 3. Count how many movies were released each individual year
SELECT   year,
         COUNT(*) AS movies_in_year
FROM     Movie
GROUP BY year
ORDER BY movies_in_year DESC, year
LIMIT 20;
```

```sql
-- 4. For every distinct start year, count the movies released
--    in the 10-year window [start_year, start_year+9]
SELECT  DISTINCT m1.year                                                              AS start_year,
        ( SELECT COUNT(*)
          FROM   Movie AS m2
          WHERE  CAST(m2.year AS INTEGER)
                 BETWEEN CAST(m1.year AS INTEGER)
                     AND CAST(m1.year AS INTEGER)+9
        )                                                                              AS movies_in_10yr_span
FROM    Movie AS m1
ORDER BY movies_in_10yr_span DESC, start_year
LIMIT 20;
```

```sql
-- 5. Return only the single ten-year period with the largest number of films
SELECT  m1.year                                                                        AS start_year,
        ( SELECT COUNT(*)
          FROM   Movie AS m2
          WHERE  CAST(m2.year AS INTEGER)
                 BETWEEN CAST(m1.year AS INTEGER)
                     AND CAST(m1.year AS INTEGER)+9
        )                                                                              AS total_movies
FROM   (SELECT DISTINCT year FROM Movie) AS m1
ORDER  BY total_movies DESC, start_year
LIMIT 1;
```
