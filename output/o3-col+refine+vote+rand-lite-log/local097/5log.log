```sql
-- Description: Inspect some distinct release years available in the data
SELECT DISTINCT CAST("year" AS INTEGER) AS "year"
FROM "Movie"
ORDER BY "year"
LIMIT 20;
```

```sql
-- Description: Count how many films were released in each single year
SELECT CAST("year" AS INTEGER)   AS "year",
       COUNT(*)                  AS "films_per_year"
FROM   "Movie"
GROUP BY CAST("year" AS INTEGER)
ORDER BY "films_per_year" DESC, "year"
LIMIT 20;
```

```sql
-- Description: For every distinct start-year, count the films in the ten-year period [year … year+9]
SELECT Y."start_year",
       (SELECT COUNT(*)
        FROM   "Movie" M2
        WHERE  CAST(M2."year" AS INTEGER) BETWEEN Y."start_year" AND Y."start_year" + 9)
       AS "films_in_10yrs"
FROM  (SELECT DISTINCT CAST("year" AS INTEGER) AS "start_year"
       FROM   "Movie")  AS Y
ORDER BY "films_in_10yrs" DESC, "start_year";
```

```sql
-- Description: Return only the start-year whose ten-year window contains the most films
SELECT Y."start_year",
       (SELECT COUNT(*)
        FROM   "Movie" M2
        WHERE  CAST(M2."year" AS INTEGER) BETWEEN Y."start_year" AND Y."start_year" + 9) AS "total_count"
FROM  (SELECT DISTINCT CAST("year" AS INTEGER) AS "start_year"
       FROM   "Movie")  AS Y
ORDER BY "total_count" DESC, "start_year"
LIMIT 1;
```
