```sql
-- Description: Check what distinct release years are stored in Movie (first 20).
SELECT DISTINCT "year"
FROM "Movie"
ORDER BY "year"
LIMIT 20;
```

```sql
-- Description: See how many movies were released in each single year (top 20 by count).
SELECT "year",
       COUNT(*) AS movies_in_that_year
FROM   "Movie"
GROUP  BY "year"
ORDER  BY movies_in_that_year DESC
LIMIT 20;
```

```sql
-- Description: List all distinct start-years that will anchor our 10-year windows (first 20).
SELECT DISTINCT CAST("year" AS INTEGER) AS start_year
FROM   "Movie"
ORDER  BY start_year
LIMIT 20;
```

```sql
-- Description: For one example start-year (say 2000) count movies in [2000 .. 2009].
SELECT COUNT(*) AS movies_2000_2009
FROM   "Movie"
WHERE  CAST("year" AS INTEGER) BETWEEN 2000 AND 2009;
```

```sql
-- Description: General computation – for every start-year present, count movies in its 10-year window.
SELECT  s.start_year,
        (SELECT COUNT(*)
         FROM   "Movie" m2
         WHERE  CAST(m2."year" AS INTEGER)
                BETWEEN s.start_year AND s.start_year + 9) AS ten_year_total
FROM   (SELECT DISTINCT CAST("year" AS INTEGER) AS start_year FROM "Movie") AS s
ORDER BY s.start_year
LIMIT 20;
```

```sql
-- Description: Order the above result by the 10-year totals to see where the counts are highest.
SELECT  s.start_year,
        (SELECT COUNT(*)
         FROM   "Movie" m2
         WHERE  CAST(m2."year" AS INTEGER)
                BETWEEN s.start_year AND s.start_year + 9) AS ten_year_total
FROM   (SELECT DISTINCT CAST("year" AS INTEGER) AS start_year FROM "Movie") AS s
ORDER BY ten_year_total DESC, start_year
LIMIT 20;
```

```sql
-- Description: Find the exact 10-year period with the maximum number of films.
SELECT  s.start_year,
        (SELECT COUNT(*)
         FROM   "Movie" m2
         WHERE  CAST(m2."year" AS INTEGER)
                BETWEEN s.start_year AND s.start_year + 9) AS ten_year_total
FROM   (SELECT DISTINCT CAST("year" AS INTEGER) AS start_year FROM "Movie") AS s
ORDER BY ten_year_total DESC, start_year
LIMIT 1;
```

```sql
-- Description: Show how many movies are in that winning window broken down by year (sanity check).
WITH best AS (
    SELECT  s.start_year
    FROM   (SELECT DISTINCT CAST("year" AS INTEGER) AS start_year FROM "Movie") AS s
    ORDER BY (SELECT COUNT(*) FROM "Movie" m2
              WHERE CAST(m2."year" AS INTEGER)
                    BETWEEN s.start_year AND s.start_year + 9) DESC,
             start_year
    LIMIT 1
)
SELECT  m."year",
        COUNT(*) AS movies_in_year
FROM    "Movie" m, best
WHERE   CAST(m."year" AS INTEGER)
        BETWEEN best.start_year AND best.start_year + 9
GROUP BY m."year"
ORDER BY m."year";
```

```sql
-- Description: Give just the requested final output (start year and total count).
SELECT  s.start_year,
        (SELECT COUNT(*)
         FROM   "Movie" m2
         WHERE  CAST(m2."year" AS INTEGER)
                BETWEEN s.start_year AND s.start_year + 9) AS total_movies
FROM   (SELECT DISTINCT CAST("year" AS INTEGER) AS start_year FROM "Movie") AS s
ORDER BY total_movies DESC, start_year
LIMIT 1;
```

```sql
-- Description: If multiple start years tie, list them all (extra check, optional).
SELECT  s.start_year,
        (SELECT COUNT(*)
         FROM   "Movie" m2
         WHERE  CAST(m2."year" AS INTEGER)
                BETWEEN s.start_year AND s.start_year + 9) AS total_movies
FROM   (SELECT DISTINCT CAST("year" AS INTEGER) AS start_year FROM "Movie") AS s
GROUP  BY s.start_year
HAVING total_movies = (
        SELECT MAX(cnt)
        FROM (
              SELECT  (SELECT COUNT(*)
                       FROM "Movie" m2
                       WHERE CAST(m2."year" AS INTEGER)
                             BETWEEN CAST(m1."year" AS INTEGER)
                                     AND CAST(m1."year" AS INTEGER) + 9) AS cnt
              FROM "Movie" m1
             )
)
ORDER BY start_year;
```
