```sql
--Description / Thinking process:
-- Goal: identify which consecutive 10-year span (inclusive) starting from any movie release
-- year contains the greatest number of films, then output only that start year and the count.
-- 1) year_window_counts  – for each distinct start_year in Movie, count how many movies
--    have release years between start_year and start_year+9.
-- 2) best_window – pick the row with the highest total (earlier start_year breaks ties).
-- 3) Return this best start year and its total film count.
WITH year_window_counts AS (
    SELECT
        CAST(m1."year" AS INTEGER) AS start_year,
        (
            SELECT COUNT(*)
            FROM   "Movie" AS m2
            WHERE  CAST(m2."year" AS INTEGER)
                   BETWEEN CAST(m1."year" AS INTEGER)
                       AND CAST(m1."year" AS INTEGER) + 9
        ) AS total_movies
    FROM "Movie" AS m1
    GROUP BY start_year
),
best_window AS (
    SELECT start_year, total_movies
    FROM   year_window_counts
    ORDER  BY total_movies DESC,
             start_year ASC
    LIMIT 1
)
SELECT start_year AS best_start_year,
       total_movies
FROM   best_window;
```
