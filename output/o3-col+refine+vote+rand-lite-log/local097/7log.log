```sql
--Description: Count how many movies were released in each individual year (first 20 rows).
SELECT "year",
       COUNT(*) AS movie_count
FROM   "Movie"
GROUP  BY "year"
ORDER  BY CAST("year" AS INTEGER)
LIMIT 20;
```

```sql
--Description: For every unique start year, count how many movies fall in the ten-year
--span that begins with that year (inclusive) and ends nine years later.
--Return the first 20 start-years with the largest counts.
SELECT CAST(m1."year" AS INTEGER) AS start_year,
       ( SELECT COUNT(*)
         FROM   "Movie" AS m2
         WHERE  CAST(m2."year" AS INTEGER)
                BETWEEN CAST(m1."year" AS INTEGER)
                    AND CAST(m1."year" AS INTEGER) + 9
       ) AS ten_year_count
FROM   "Movie" AS m1
GROUP  BY start_year
ORDER  BY ten_year_count DESC,
          start_year ASC
LIMIT 20;
```

```sql
--Description: Identify the single start year whose consecutive ten-year window
--contains the greatest number of films (ties resolved by earliest year).
SELECT start_year,
       ten_year_count
FROM (
        SELECT CAST(m1."year" AS INTEGER) AS start_year,
               ( SELECT COUNT(*)
                 FROM   "Movie" AS m2
                 WHERE  CAST(m2."year" AS INTEGER)
                        BETWEEN CAST(m1."year" AS INTEGER)
                            AND CAST(m1."year" AS INTEGER) + 9
               ) AS ten_year_count
        FROM   "Movie" AS m1
        GROUP  BY start_year
     )
ORDER BY ten_year_count DESC,
         start_year ASC
LIMIT 1;
```

```sql
--Description: (Optional) List up to 20 movies that fall inside the winning
--ten-year window obtained above, just for verification.
--Replace :winning_start_year with the actual year obtained from the previous query.
SELECT "title",
       "year"
FROM   "Movie"
WHERE  CAST("year" AS INTEGER)
       BETWEEN :winning_start_year
           AND :winning_start_year + 9
ORDER BY "year", "title"
LIMIT 20;
```

```sql
--Description: Final concise answer showing only the best start year
--and the corresponding total film count.
SELECT start_year AS best_start_year,
       ten_year_count AS total_movies
FROM (
        SELECT CAST(m1."year" AS INTEGER) AS start_year,
               ( SELECT COUNT(*)
                 FROM   "Movie" AS m2
                 WHERE  CAST(m2."year" AS INTEGER)
                        BETWEEN CAST(m1."year" AS INTEGER)
                            AND CAST(m1."year" AS INTEGER) + 9
               ) AS ten_year_count
        FROM   "Movie" AS m1
        GROUP  BY start_year
     )
ORDER BY ten_year_count DESC,
         start_year ASC
LIMIT 1;
```
