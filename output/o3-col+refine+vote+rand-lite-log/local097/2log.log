```sql
--Description: See how many movies appear for each individual year.  
SELECT "year",
       COUNT(*) AS movies_that_year
FROM   "Movie"
GROUP  BY "year"
ORDER  BY CAST("year" AS INTEGER)
LIMIT 20;
```

```sql
--Description: For every distinct start year, count the movies released in the ten-year window that begins in that year.  
SELECT  m1."year"                       AS start_year,
        (SELECT COUNT(*) 
         FROM   "Movie" AS m2
         WHERE  CAST(m2."year" AS INTEGER) >= CAST(m1."year" AS INTEGER)
           AND  CAST(m2."year" AS INTEGER) <  CAST(m1."year" AS INTEGER) + 10)
        AS movies_in_10yr_span
FROM   (SELECT DISTINCT "year" FROM "Movie") AS m1
ORDER  BY start_year
LIMIT 20;
```

```sql
--Description: Same as above but now order by count descending to see the busiest ten-year periods first.  
SELECT  m1."year"                       AS start_year,
        (SELECT COUNT(*) 
         FROM   "Movie" AS m2
         WHERE  CAST(m2."year" AS INTEGER) >= CAST(m1."year" AS INTEGER)
           AND  CAST(m2."year" AS INTEGER) <  CAST(m1."year" AS INTEGER) + 10)
        AS movies_in_10yr_span
FROM   (SELECT DISTINCT "year" FROM "Movie") AS m1
ORDER  BY movies_in_10yr_span DESC, start_year
LIMIT 20;
```

```sql
--Description: Return only the single ten-year period with the largest number of films (ties broken by earliest start year).  
SELECT  m1."year"                       AS start_year,
        (SELECT COUNT(*) 
         FROM   "Movie" AS m2
         WHERE  CAST(m2."year" AS INTEGER) >= CAST(m1."year" AS INTEGER)
           AND  CAST(m2."year" AS INTEGER) <  CAST(m1."year" AS INTEGER) + 10)
        AS movies_in_10yr_span
FROM   (SELECT DISTINCT "year" FROM "Movie") AS m1
ORDER  BY movies_in_10yr_span DESC, start_year
LIMIT 1;
```
