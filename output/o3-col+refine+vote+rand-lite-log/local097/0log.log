```sql
-- Description: View some distinct release years available in the data (sanity-check).
SELECT DISTINCT year
FROM Movie
LIMIT 20;
```

```sql
-- Description: Count how many movies were released in every individual year.
SELECT year,
       COUNT(*) AS movie_count
FROM Movie
GROUP BY year
ORDER BY movie_count DESC, year
LIMIT 20;
```

```sql
-- Description: List all unique numeric start-years we can use for building 10-year windows.
SELECT DISTINCT CAST(year AS INTEGER) AS start_year
FROM Movie
WHERE CAST(year AS INTEGER) > 0
ORDER BY start_year
LIMIT 20;
```

```sql
-- Description: For every candidate start-year, calculate how many films fall into
-- the 10-year period that begins with it (start_year … start_year+9).
SELECT s.start_year,
       (SELECT COUNT(*)
        FROM Movie m
        WHERE CAST(m.year AS INTEGER) BETWEEN s.start_year AND s.start_year + 9
              AND CAST(m.year AS INTEGER) > 0) AS total_movies
FROM (SELECT DISTINCT CAST(year AS INTEGER) AS start_year
      FROM Movie
      WHERE CAST(year AS INTEGER) > 0) AS s
ORDER BY total_movies DESC, start_year
LIMIT 20;
```

```sql
-- Description: Final answer – return the single 10-year period that contains
-- the most movies, showing its start year and the total count.
SELECT s.start_year,
       (SELECT COUNT(*)
        FROM Movie m
        WHERE CAST(m.year AS INTEGER) BETWEEN s.start_year AND s.start_year + 9
              AND CAST(m.year AS INTEGER) > 0) AS total_movies
FROM (SELECT DISTINCT CAST(year AS INTEGER) AS start_year
      FROM Movie
      WHERE CAST(year AS INTEGER) > 0) AS s
ORDER BY total_movies DESC, start_year
LIMIT 1;
```
