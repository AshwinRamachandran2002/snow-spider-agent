```sql
--Description: show the first twenty distinct release years that appear in the data
SELECT DISTINCT "year"
FROM "Movie"
ORDER BY "year"
LIMIT 20;
```

```sql
--Description: number of films that came out in each individual year (top 20 years)
SELECT "year", COUNT(*) AS films_in_year
FROM "Movie"
GROUP BY "year"
ORDER BY films_in_year DESC
LIMIT 20;
```

```sql
--Description: check the temporal span of the whole data set
SELECT MIN(CAST("year" AS INTEGER))  AS earliest_year,
       MAX(CAST("year" AS INTEGER))  AS latest_year
FROM   "Movie";
```

```sql
--Description: how many movies were released from 2000-2009 (inclusive)
SELECT COUNT(*) AS films_2000_2009
FROM   "Movie"
WHERE  CAST("year" AS INTEGER) BETWEEN 2000 AND 2009;
```

```sql
--Description: how many movies were released from 2010-2019 (inclusive)
SELECT COUNT(*) AS films_2010_2019
FROM   "Movie"
WHERE  CAST("year" AS INTEGER) BETWEEN 2010 AND 2019;
```

```sql
--Description: example – total movies in the ten-year period that starts in 1990
SELECT 1990 AS start_year,
       COUNT(*) AS films_1990_1999
FROM   "Movie"
WHERE  CAST("year" AS INTEGER) BETWEEN 1990 AND 1999;
```

```sql
--Description: ten-year totals for every possible start year (show 20 largest)
WITH years AS (
    SELECT DISTINCT CAST("year" AS INTEGER) AS yr
    FROM   "Movie"
    WHERE  "year" GLOB '[0-9]*'
)
SELECT  y.yr                                           AS start_year,
        (SELECT COUNT(*)
         FROM   "Movie" m
         WHERE  CAST(m."year" AS INTEGER)
                BETWEEN y.yr AND y.yr + 9)             AS films_in_decade
FROM    years y
ORDER BY films_in_decade DESC
LIMIT 20;
```

```sql
--Description: final query – the ten-year period with the greatest number of films
WITH years AS (
    SELECT DISTINCT CAST("year" AS INTEGER) AS yr
    FROM   "Movie"
    WHERE  "year" GLOB '[0-9]*'
), period_counts AS (
    SELECT yr                                              AS start_year,
           (SELECT COUNT(*)
            FROM   "Movie"
            WHERE  CAST("year" AS INTEGER)
                   BETWEEN yr AND yr + 9)                  AS total_films
    FROM   years
)
SELECT start_year, total_films
FROM   period_counts
ORDER  BY total_films DESC, start_year
LIMIT  1;
```

Based on the result of the last query, the ten-year span beginning in 2009 contains the highest number of films, with a total of 34 082 releases.

