```sql
--Description: View a few example records to recall the columns we will work with.
SELECT * FROM Movie LIMIT 20;
```

```sql
--Description: List all distinct release years that exist in the data set (as text).
SELECT DISTINCT "year"
FROM Movie
ORDER BY "year"
LIMIT 20;
```

```sql
--Description: Count how many films were released in each individual year.
SELECT "year",
       COUNT(*) AS films_in_year
FROM Movie
GROUP BY "year"
ORDER BY films_in_year DESC, "year"
LIMIT 20;
```

```sql
--Description: Inspect the earliest and latest years so we know the span we must cover.
SELECT MIN(CAST("year" AS INT))  AS earliest_year,
       MAX(CAST("year" AS INT))  AS latest_year
FROM Movie;
```

```sql
--Description: For every start-year, count the number of films released in the ten-year window that begins with that year.
SELECT m1."year"                       AS start_year,
       COUNT(*)                        AS films_in_10yr_window
FROM   Movie AS m1
JOIN   Movie AS m2
       ON CAST(m2."year" AS INT) 
          BETWEEN CAST(m1."year" AS INT) 
              AND CAST(m1."year" AS INT)+9
GROUP  BY start_year
ORDER  BY start_year
LIMIT 20;
```

```sql
--Description: Order the previous result by the window size so we can see which periods are biggest.
SELECT m1."year"                       AS start_year,
       COUNT(*)                        AS films_in_10yr_window
FROM   Movie AS m1
JOIN   Movie AS m2
       ON CAST(m2."year" AS INT) 
          BETWEEN CAST(m1."year" AS INT) 
              AND CAST(m1."year" AS INT)+9
GROUP  BY start_year
ORDER  BY films_in_10yr_window DESC, start_year
LIMIT 20;
```

```sql
--Description: Final answer – return only the single ten-year period (its start year) that contains the most films and the count of those films.
SELECT m1."year"                       AS start_year,
       COUNT(*)                        AS films_in_10yr_window
FROM   Movie AS m1
JOIN   Movie AS m2
       ON CAST(m2."year" AS INT) 
          BETWEEN CAST(m1."year" AS INT) 
              AND CAST(m1."year" AS INT)+9
GROUP  BY start_year
ORDER  BY films_in_10yr_window DESC, start_year
LIMIT 1;
```
