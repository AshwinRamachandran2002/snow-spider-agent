```sql
-- Description: Convert milliseconds to minutes (decimal) for a small sample of tracks
SELECT "TrackId",
       "Name",
       ROUND("Milliseconds" / 60000.0, 2) AS minutes
FROM "Track"
LIMIT 20;
```

```sql
-- Description: Classify tracks as Short (<3 min), Medium (3–5 min), or Long (>5 min)
SELECT "TrackId",
       "Name",
       ROUND("Milliseconds" / 60000.0, 2) AS minutes,
       CASE
         WHEN "Milliseconds" < 180000 THEN 'Short'
         WHEN "Milliseconds" <= 300000 THEN 'Medium'
         ELSE 'Long'
       END AS length_category
FROM "Track"
LIMIT 20;
```

```sql
-- Description: Join Track with InvoiceLine to see how much revenue an individual track has generated
SELECT il."InvoiceLineId",
       il."InvoiceId",
       il."TrackId",
       (il."UnitPrice" * il."Quantity") AS line_revenue
FROM "InvoiceLine" AS il
JOIN "Track"        AS t ON t."TrackId" = il."TrackId"
LIMIT 20;
```

```sql
-- Description: Final answer – for each category, show min & max track length (in minutes) and total revenue
SELECT
  length_category,
  ROUND(MIN(t."Milliseconds") / 60000.0, 2) AS min_minutes,
  ROUND(MAX(t."Milliseconds") / 60000.0, 2) AS max_minutes,
  ROUND(SUM(il."UnitPrice" * il."Quantity"), 2) AS total_revenue
FROM "Track" AS t
LEFT JOIN "InvoiceLine" AS il ON il."TrackId" = t."TrackId"
CROSS JOIN (
  SELECT 'Short'  AS length_category, 180000 AS upper_ms, 0      AS lower_ms UNION ALL
  SELECT 'Medium', 300000,               180000 UNION ALL
  SELECT 'Long',   999999999,            300000
) AS cat
WHERE t."Milliseconds" > cat.lower_ms
  AND t."Milliseconds" <= cat.upper_ms
GROUP BY length_category;
```
