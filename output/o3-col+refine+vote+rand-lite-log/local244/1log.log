```sql
--Description: Check some distinct raw durations (in milliseconds) available in the Track table.
SELECT DISTINCT "Milliseconds"
FROM "Track"
LIMIT 20;
```

```sql
--Description: View the first 20 tracks with their duration already converted to minutes (rounded to 2 decimals).
SELECT "TrackId",
       "Name",
       ROUND("Milliseconds" / 60000.0, 2) AS "Minutes"
FROM "Track"
LIMIT 20;
```

```sql
--Description: Classify each of the first 20 tracks as short (<3 min), medium (3-5 min) or long (>5 min).
SELECT "TrackId",
       "Name",
       CASE
           WHEN "Milliseconds" < 180000 THEN 'short'
           WHEN "Milliseconds" <= 300000 THEN 'medium'
           ELSE 'long'
       END AS "LengthCategory"
FROM "Track"
LIMIT 20;
```

```sql
--Description: Count how many tracks fall in each length category in the whole catalogue.
SELECT
       CASE
           WHEN "Milliseconds" < 180000 THEN 'short'
           WHEN "Milliseconds" <= 300000 THEN 'medium'
           ELSE 'long'
       END AS "LengthCategory",
       COUNT(*) AS "TrackCount"
FROM "Track"
GROUP BY 1;
```

```sql
--Description: Preview some invoice-line rows with their related tracks and durations.
SELECT il."InvoiceLineId",
       il."TrackId",
       il."UnitPrice",
       il."Quantity",
       t."Milliseconds"
FROM "InvoiceLine" AS il
JOIN "Track"      AS t ON il."TrackId" = t."TrackId"
LIMIT 20;
```

```sql
--Description: Compute the revenue of the first 20 invoice lines (UnitPrice × Quantity).
SELECT il."InvoiceLineId",
       il."TrackId",
       (il."UnitPrice" * il."Quantity") AS "LineRevenue"
FROM "InvoiceLine" AS il
LIMIT 20;
```

```sql
--Description: Aggregate the total revenue generated by each length category.
SELECT
       CASE
           WHEN t."Milliseconds" < 180000 THEN 'short'
           WHEN t."Milliseconds" <= 300000 THEN 'medium'
           ELSE 'long'
       END AS "LengthCategory",
       SUM(il."UnitPrice" * il."Quantity") AS "TotalRevenue"
FROM "InvoiceLine" AS il
JOIN "Track"      AS t ON il."TrackId" = t."TrackId"
GROUP BY 1;
```

```sql
--Description: Final answer – for each category show min & max duration (in minutes) and total revenue.
SELECT
       CASE
           WHEN t."Milliseconds" < 180000 THEN 'short'
           WHEN t."Milliseconds" <= 300000 THEN 'medium'
           ELSE 'long'
       END                                                          AS "LengthCategory",
       ROUND(MIN(t."Milliseconds") / 60000.0, 2)                    AS "MinMinutes",
       ROUND(MAX(t."Milliseconds") / 60000.0, 2)                    AS "MaxMinutes",
       ROUND(SUM(il."UnitPrice" * il."Quantity"), 2)                AS "TotalRevenue"
FROM "Track" AS t
JOIN "InvoiceLine" AS il ON t."TrackId" = il."TrackId"
GROUP BY 1
ORDER BY
   CASE
       WHEN "LengthCategory" = 'short'  THEN 1
       WHEN "LengthCategory" = 'medium' THEN 2
       ELSE 3
   END;
```
