```sql
--Description: Preview some track durations in raw milliseconds.
SELECT DISTINCT "TrackId",
       "Name",
       "Milliseconds"
FROM   "Track"
LIMIT 20;
```

```sql
--Description: Convert milliseconds to minutes (rounded) for a quick check.
SELECT DISTINCT "TrackId",
       "Name",
       ROUND("Milliseconds" / 60000.0, 2) AS "Minutes"
FROM   "Track"
LIMIT 20;
```

```sql
--Description: Overall minimum and maximum track length in minutes.
SELECT MIN("Milliseconds") / 60000.0 AS "MinMinutes",
       MAX("Milliseconds") / 60000.0 AS "MaxMinutes"
FROM   "Track";
```

```sql
--Description: Classify the first 20 tracks as Short, Medium, or Long.
SELECT DISTINCT "TrackId",
       "Name",
       CASE
           WHEN "Milliseconds" < 180000 THEN 'Short'
           WHEN "Milliseconds" < 300000 THEN 'Medium'
           ELSE 'Long'
       END AS "LengthCategory"
FROM   "Track"
LIMIT 20;
```

```sql
--Description: Look at invoice–track relations and sales quantities.
SELECT DISTINCT "InvoiceLineId",
       "TrackId",
       "UnitPrice",
       "Quantity"
FROM   "InvoiceLine"
LIMIT 20;
```

```sql
--Description: Total revenue generated by each track (sample of 20).
SELECT DISTINCT "TrackId",
       SUM("UnitPrice" * "Quantity") AS "TrackRevenue"
FROM   "InvoiceLine"
GROUP  BY "TrackId"
LIMIT 20;
```

```sql
--Description: Join tracks with their individual revenues and length class.
SELECT DISTINCT t."TrackId",
       t."Name",
       ROUND(t."Milliseconds" / 60000.0, 2) AS "Minutes",
       CASE
           WHEN t."Milliseconds" < 180000 THEN 'Short'
           WHEN t."Milliseconds" < 300000 THEN 'Medium'
           ELSE 'Long'
       END AS "LengthCategory",
       r."TrackRevenue"
FROM   "Track" AS t
LEFT JOIN (
        SELECT "TrackId",
               SUM("UnitPrice" * "Quantity") AS "TrackRevenue"
        FROM   "InvoiceLine"
        GROUP  BY "TrackId"
) AS r
ON     t."TrackId" = r."TrackId"
LIMIT 20;
```

```sql
--Description: Minimum and maximum duration (minutes) for each length category.
SELECT DISTINCT
       CASE
           WHEN "Milliseconds" < 180000 THEN 'Short'
           WHEN "Milliseconds" < 300000 THEN 'Medium'
           ELSE 'Long'
       END AS "LengthCategory",
       MIN("Milliseconds") / 60000.0 AS "MinMinutes",
       MAX("Milliseconds") / 60000.0 AS "MaxMinutes"
FROM   "Track"
GROUP  BY "LengthCategory";
```

```sql
--Description: FINAL – min-max time (minutes) and total revenue by category.
SELECT cat."LengthCategory",
       ROUND(MIN(cat."Minutes"), 2)       AS "MinMinutes",
       ROUND(MAX(cat."Minutes"), 2)       AS "MaxMinutes",
       ROUND(SUM(cat."TrackRevenue"), 2)  AS "TotalRevenue"
FROM  (
        SELECT t."TrackId",
               ROUND(t."Milliseconds" / 60000.0, 2) AS "Minutes",
               CASE
                   WHEN t."Milliseconds" < 180000 THEN 'Short'
                   WHEN t."Milliseconds" < 300000 THEN 'Medium'
                   ELSE 'Long'
               END AS "LengthCategory",
               IFNULL(r."TrackRevenue", 0) AS "TrackRevenue"
        FROM   "Track" AS t
        LEFT JOIN (
                SELECT "TrackId",
                       SUM("UnitPrice" * "Quantity") AS "TrackRevenue"
                FROM   "InvoiceLine"
                GROUP  BY "TrackId"
        ) AS r
        ON     t."TrackId" = r."TrackId"
) AS cat
GROUP BY cat."LengthCategory";
```
