Query:
--Description: Join tracks with their individual revenues and length class.
SELECT DISTINCT t."TrackId",
       t."Name",
       ROUND(t."Milliseconds" / 60000.0, 2) AS "Minutes",
       CASE
           WHEN t."Milliseconds" < 180000 THEN 'Short'
           WHEN t."Milliseconds" < 300000 THEN 'Medium'
           ELSE 'Long'
       END AS "LengthCategory",
       r."TrackRevenue"
FROM   "Track" AS t
LEFT JOIN (
        SELECT "TrackId",
               SUM("UnitPrice" * "Quantity") AS "TrackRevenue"
        FROM   "InvoiceLine"
        GROUP  BY "TrackId"
) AS r
ON     t."TrackId" = r."TrackId"
LIMIT 20;
