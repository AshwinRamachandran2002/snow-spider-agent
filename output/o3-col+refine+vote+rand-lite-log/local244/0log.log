Query:
--Description: FINAL – min-max time (minutes) and total revenue by category.
SELECT cat."LengthCategory",
       ROUND(MIN(cat."Minutes"), 2)       AS "MinMinutes",
       ROUND(MAX(cat."Minutes"), 2)       AS "MaxMinutes",
       ROUND(SUM(cat."TrackRevenue"), 2)  AS "TotalRevenue"
FROM  (
        SELECT t."TrackId",
               ROUND(t."Milliseconds" / 60000.0, 2) AS "Minutes",
               CASE
                   WHEN t."Milliseconds" < 180000 THEN 'Short'
                   WHEN t."Milliseconds" < 300000 THEN 'Medium'
                   ELSE 'Long'
               END AS "LengthCategory",
               IFNULL(r."TrackRevenue", 0) AS "TrackRevenue"
        FROM   "Track" AS t
        LEFT JOIN (
                SELECT "TrackId",
                       SUM("UnitPrice" * "Quantity") AS "TrackRevenue"
                FROM   "InvoiceLine"
                GROUP  BY "TrackId"
        ) AS r
        ON     t."TrackId" = r."TrackId"
) AS cat
GROUP BY cat."LengthCategory";
