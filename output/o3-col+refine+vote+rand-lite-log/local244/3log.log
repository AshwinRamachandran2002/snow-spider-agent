```sql
-- Description: 1) Inspect distinct track durations (in milliseconds) to understand their range.
SELECT DISTINCT "Milliseconds"
FROM "Track"
LIMIT 20;
```

```sql
-- Description: 2) View a few tracks with their names, milliseconds and the same value converted to minutes.
SELECT "TrackId",
       "Name",
       "Milliseconds",
       ROUND("Milliseconds" / 60000.0, 2) AS "Minutes"
FROM "Track"
LIMIT 20;
```

```sql
-- Description: 3) Check a sample of invoice-line records (price & quantity).
SELECT DISTINCT "InvoiceLineId",
       "TrackId",
       "UnitPrice",
       "Quantity"
FROM "InvoiceLine"
LIMIT 20;
```

```sql
-- Description: 4) Join tracks with their invoice lines to see how revenue is formed for a few rows.
SELECT il."InvoiceLineId",
       t."TrackId",
       ROUND(t."Milliseconds" / 60000.0, 2) AS "Minutes",
       il."UnitPrice",
       il."Quantity",
       il."UnitPrice" * il."Quantity" AS "LineRevenue"
FROM "InvoiceLine" AS il
JOIN "Track"       AS t ON t."TrackId" = il."TrackId"
LIMIT 20;
```

```sql
-- Description: 5) Classify every track as Short (<3 min), Medium (3–5 min) or Long (>5 min).
SELECT "TrackId",
       ROUND("Milliseconds" / 60000.0, 2) AS "Minutes",
       CASE
           WHEN "Milliseconds" < 180000            THEN 'Short'
           WHEN "Milliseconds" <= 300000           THEN 'Medium'
           ELSE                                          'Long'
       END AS "LengthCategory"
FROM "Track"
LIMIT 20;
```

```sql
-- Description: 6) Count how many distinct tracks fall in each length category.
SELECT CASE
           WHEN "Milliseconds" < 180000            THEN 'Short'
           WHEN "Milliseconds" <= 300000           THEN 'Medium'
           ELSE                                          'Long'
       END AS "LengthCategory",
       COUNT(*) AS "NumTracks"
FROM "Track"
GROUP BY 1;
```

```sql
-- Description: 7) Aggregate revenue by length category (joining Track ↔ InvoiceLine).
SELECT CASE
           WHEN t."Milliseconds" < 180000          THEN 'Short'
           WHEN t."Milliseconds" <= 300000         THEN 'Medium'
           ELSE                                         'Long'
       END AS "LengthCategory",
       SUM(il."UnitPrice" * il."Quantity") AS "TotalRevenue"
FROM "InvoiceLine" AS il
JOIN "Track"       AS t ON t."TrackId" = il."TrackId"
GROUP BY 1;
```

```sql
-- Description: 8) Final answer – for every category show the minimum & maximum track time (in minutes) and total revenue.
SELECT
    cat."LengthCategory",
    ROUND(MIN(cat."Minutes"), 2) AS "MinMinutes",
    ROUND(MAX(cat."Minutes"), 2) AS "MaxMinutes",
    ROUND(SUM(cat."LineRevenue"), 2) AS "TotalRevenue"
FROM (
    SELECT
        CASE
            WHEN t."Milliseconds" < 180000          THEN 'Short'
            WHEN t."Milliseconds" <= 300000         THEN 'Medium'
            ELSE                                         'Long'
        END                           AS "LengthCategory",
        t."Milliseconds" / 60000.0    AS "Minutes",
        il."UnitPrice" * il."Quantity" AS "LineRevenue"
    FROM "Track"        AS t
    LEFT JOIN "InvoiceLine" AS il ON il."TrackId" = t."TrackId"
) AS cat
GROUP BY cat."LengthCategory";
```
