Query:
-- Description: 6) Count how many distinct tracks fall in each length category.
SELECT CASE
           WHEN "Milliseconds" < 180000            THEN 'Short'
           WHEN "Milliseconds" <= 300000           THEN 'Medium'
           ELSE                                          'Long'
       END AS "LengthCategory",
       COUNT(*) AS "NumTracks"
FROM "Track"
GROUP BY 1;
