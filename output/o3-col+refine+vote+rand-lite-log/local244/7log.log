```sql
--Description: To create the requested summary we:
-- 1) Classify every Track into Short (<180 000 ms), Medium (180 000–300 000 ms) or Long (>300 000 ms).
-- 2) LEFT JOIN Track with InvoiceLine so tracks that never sold still appear (revenue defaults to 0).
-- 3) For each category compute:
--      • MinMinutes and MaxMinutes   → MIN / MAX(Milliseconds) ÷ 60 000, rounded to 2 d.p.
--      • TotalRevenue                → Σ(quantity × unitprice), rounded to 2 d.p.
-- 4) Repeat the CASE expression in GROUP BY because SQLite cannot group by an alias.
SELECT
  CASE
      WHEN t.Milliseconds < 180000  THEN 'Short'
      WHEN t.Milliseconds <= 300000 THEN 'Medium'
      ELSE 'Long'
  END                                                   AS LengthCategory,
  ROUND(MIN(t.Milliseconds) / 60000.0, 2)               AS MinMinutes,
  ROUND(MAX(t.Milliseconds) / 60000.0, 2)               AS MaxMinutes,
  ROUND(SUM(COALESCE(il.Quantity * il.UnitPrice, 0)), 2) AS TotalRevenue
FROM Track AS t
LEFT JOIN InvoiceLine AS il
       ON il.TrackId = t.TrackId
GROUP BY
  CASE
      WHEN t.Milliseconds < 180000  THEN 'Short'
      WHEN t.Milliseconds <= 300000 THEN 'Medium'
      ELSE 'Long'
  END;
```
