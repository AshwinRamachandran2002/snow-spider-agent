```sql
--Description: 1) Inspect a handful of tracks to see the raw "Milliseconds" values.
SELECT *
FROM Track
LIMIT 20;
```

```sql
--Description: 2) Quickly check the overall minimum and maximum duration in milliseconds.
SELECT MIN(Milliseconds) AS min_ms,
       MAX(Milliseconds) AS max_ms
FROM Track;
```

```sql
--Description: 3) Convert the first 20 tracks’ durations from milliseconds to minutes (rounded to 2 d.p.).
SELECT TrackId,
       Name,
       ROUND(Milliseconds / 60000.0, 2) AS Minutes
FROM Track
LIMIT 20;
```

```sql
--Description: 4) Classify each track as Short (<3 min), Medium (3–5 min) or Long (>5 min) and preview 20 rows.
SELECT TrackId,
       Name,
       ROUND(Milliseconds / 60000.0, 2) AS Minutes,
       CASE
           WHEN Milliseconds < 180000  THEN 'Short'
           WHEN Milliseconds <= 300000 THEN 'Medium'
           ELSE 'Long'
       END AS LengthCategory
FROM Track
LIMIT 20;
```

```sql
--Description: 5) Count how many tracks fall into each length category.
SELECT CASE
           WHEN Milliseconds < 180000  THEN 'Short'
           WHEN Milliseconds <= 300000 THEN 'Medium'
           ELSE 'Long'
       END AS LengthCategory,
       COUNT(*) AS TrackCount
FROM Track
GROUP BY LengthCategory;
```

```sql
--Description: 6) Preview how revenue is linked to tracks by joining InvoiceLine (20 rows).
SELECT il.InvoiceLineId,
       il.TrackId,
       il.Quantity,
       il.UnitPrice,
       il.Quantity * il.UnitPrice AS LineRevenue
FROM InvoiceLine AS il
LIMIT 20;
```

```sql
--Description: 7) Sum total revenue generated by each track (top 20 by revenue).
SELECT il.TrackId,
       SUM(il.Quantity * il.UnitPrice) AS TrackRevenue
FROM InvoiceLine AS il
GROUP BY il.TrackId
ORDER BY TrackRevenue DESC
LIMIT 20;
```

```sql
--Description: 8) Aggregate total revenue per length category.
SELECT cat.LengthCategory,
       SUM(il.Quantity * il.UnitPrice) AS TotalRevenue
FROM (
     SELECT TrackId,
            CASE
                WHEN Milliseconds < 180000  THEN 'Short'
                WHEN Milliseconds <= 300000 THEN 'Medium'
                ELSE 'Long'
            END AS LengthCategory
     FROM Track
) AS cat
JOIN InvoiceLine AS il
  ON il.TrackId = cat.TrackId
GROUP BY cat.LengthCategory;
```

```sql
--Description: 9) Final answer – for each category show min & max time (minutes, 2 d.p.) and total revenue.
SELECT cat.LengthCategory,
       ROUND(MIN(t.Milliseconds) / 60000.0, 2) AS MinMinutes,
       ROUND(MAX(t.Milliseconds) / 60000.0, 2) AS MaxMinutes,
       ROUND(SUM(il.Quantity * il.UnitPrice), 2) AS TotalRevenue
FROM Track AS t
LEFT JOIN InvoiceLine AS il
       ON il.TrackId = t.TrackId
CROSS APPLY (
    SELECT CASE
               WHEN t.Milliseconds < 180000  THEN 'Short'
               WHEN t.Milliseconds <= 300000 THEN 'Medium'
               ELSE 'Long'
           END AS LengthCategory
) AS cat
GROUP BY cat.LengthCategory;
```
