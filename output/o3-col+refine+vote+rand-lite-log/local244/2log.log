```sql
--Description: Fetch a sample of distinct track durations (in milliseconds) to understand the spread of values.  
SELECT DISTINCT "Milliseconds"
FROM "Track"
LIMIT 20;
```

```sql
--Description: Display the same sample but converted to minutes for easier human interpretation.  
SELECT DISTINCT ROUND("Milliseconds" / 60000.0, 2) AS "Minutes"
FROM "Track"
LIMIT 20;
```

```sql
--Description: Verify the overall minimum and maximum length (in minutes) of any track in the library.  
SELECT  
    ROUND(MIN("Milliseconds") / 60000.0, 2) AS "Min_Minutes",
    ROUND(MAX("Milliseconds") / 60000.0, 2) AS "Max_Minutes"
FROM "Track";
```

```sql
--Description: Classify every track as Short (<3 min), Medium (3-6 min) or Long (>6 min).  
SELECT DISTINCT  
    "TrackId",
    CASE  
        WHEN "Milliseconds" < 180000 THEN 'Short'
        WHEN "Milliseconds" <= 360000 THEN 'Medium'
        ELSE 'Long'
    END AS "Duration_Category"
FROM "Track"
LIMIT 20;
```

```sql
--Description: Calculate total revenue generated by each individual track (price × quantity).  
SELECT DISTINCT  
    il."TrackId",
    SUM(il."UnitPrice" * il."Quantity") AS "Track_Revenue"
FROM "InvoiceLine" AS il
GROUP BY il."TrackId"
LIMIT 20;
```

```sql
--Description: Aggregate revenue for every duration category (Short / Medium / Long).  
SELECT  
    cat."Duration_Category",
    SUM(rev."Track_Revenue") AS "Total_Revenue"
FROM (
        SELECT  
            t."TrackId",
            CASE  
                WHEN t."Milliseconds" < 180000 THEN 'Short'
                WHEN t."Milliseconds" <= 360000 THEN 'Medium'
                ELSE 'Long'
            END AS "Duration_Category"
        FROM "Track" AS t
     ) AS cat
JOIN (
        SELECT  
            il."TrackId",
            SUM(il."UnitPrice" * il."Quantity") AS "Track_Revenue"
        FROM "InvoiceLine" AS il
        GROUP BY il."TrackId"
     ) AS rev
ON cat."TrackId" = rev."TrackId"
GROUP BY cat."Duration_Category";
```

```sql
--Description: FINAL ANSWER – For each category, return minimum & maximum length (minutes) and the total revenue.  
SELECT  
    CASE  
        WHEN t."Milliseconds" < 180000 THEN 'Short'
        WHEN t."Milliseconds" <= 360000 THEN 'Medium'
        ELSE 'Long'
    END                              AS "Duration_Category",
    ROUND(MIN(t."Milliseconds")/60000.0, 2) AS "Min_Minutes",
    ROUND(MAX(t."Milliseconds")/60000.0, 2) AS "Max_Minutes",
    ROUND(SUM(il."UnitPrice" * il."Quantity"), 2) AS "Total_Revenue"
FROM "Track"        AS t
JOIN "InvoiceLine"  AS il  ON t."TrackId" = il."TrackId"
GROUP BY "Duration_Category";
```

