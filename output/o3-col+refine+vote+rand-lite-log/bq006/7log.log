FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE descript = 'PUBLIC INTOXICATION'
LIMIT 20;
```

```sql
--Description: 3) Count PUBLIC INTOXICATION incidents per day in 2016 and show the busiest 20 days.
SELECT
  date,
  COUNT(*) AS daily_cnt
FROM `bigquery-public-data.austin_incidents.incidents_2016`
WHERE descript = 'PUBLIC INTOXICATION'
GROUP BY date
ORDER BY daily_cnt DESC
LIMIT 20;
```

```sql
--Description: 4) Produce the full 2016 daily series (including zero-incident dates) with counts.
WITH all_days AS (
  SELECT
    GENERATE_DATE_ARRAY('2016-01-01','2016-12-31') AS dlist)
SELECT
  day AS date,
  COALESCE(t.cnt,0) AS daily_cnt
FROM
  UNNEST((SELECT dlist FROM all_days)) AS day
LEFT JOIN (
  SELECT date, COUNT(*) AS cnt
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE descript = 'PUBLIC INTOXICATION'
  GROUP BY date) AS t
ON day = t.date
ORDER BY day
LIMIT 20;
```

```sql
--Description: 5) Compute mean & standard deviation of the 2016 daily counts.
WITH daily AS (
  SELECT
    date,
    COUNT(*) AS daily_cnt
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE descript = 'PUBLIC INTOXICATION'
  GROUP BY date)
SELECT
  AVG(daily_cnt)  AS avg_cnt,
  STDDEV_POP(daily_cnt) AS std_cnt
FROM daily;
```

```sql
--Description: 6) Attach the mean & std to every day, calculate the Z-score for each day.
WITH daily AS (
  SELECT
    date,
    COUNT(*) AS daily_cnt
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE descript = 'PUBLIC INTOXICATION'
  GROUP BY date),
stats AS (
  SELECT
    AVG(daily_cnt)  AS avg_cnt,
    STDDEV_POP(daily_cnt) AS std_cnt
  FROM daily)
SELECT
  d.date,
  d.daily_cnt,
  (d.daily_cnt - s.avg_cnt)/s.std_cnt AS z_score
FROM daily AS d
CROSS JOIN stats AS s
ORDER BY z_score DESC
LIMIT 20;
```

```sql
--Description: 7) Rank the days by Z-score and pick the 2nd highest.
WITH daily AS (
  SELECT
    date,
    COUNT(*) AS daily_cnt
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE descript = 'PUBLIC INTOXICATION'
  GROUP BY date),
stats AS (
  SELECT
    AVG(daily_cnt)  AS avg_cnt,
    STDDEV_POP(daily_cnt) AS std_cnt
  FROM daily),
scored AS (
  SELECT
    d.date,
    (d.daily_cnt - s.avg_cnt)/s.std_cnt AS z_score
  FROM daily AS d
  CROSS JOIN stats AS s)
SELECT date
FROM (
  SELECT
    date,
    z_score,
    ROW_NUMBER() OVER (ORDER BY z_score DESC) AS rn
  FROM scored)
WHERE rn = 2;
```

```sql
--Description: 8) Return the answer formatted as requested ('2016-xx-xx').
WITH daily AS (
  SELECT
    date,
    COUNT(*) AS daily_cnt
  FROM `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE descript = 'PUBLIC INTOXICATION'
  GROUP BY date),
stats AS (
  SELECT
    AVG(daily_cnt)  AS avg_cnt,
    STDDEV_POP(daily_cnt) AS std_cnt
  FROM daily),
scored AS (
  SELECT
    d.date,
    (d.daily_cnt - s.avg_cnt)/s.std_cnt AS z_score
  FROM daily AS d
  CROSS JOIN stats AS s),
ranked AS (
  SELECT
    date,
    z_score,
    ROW_NUMBER() OVER (ORDER BY z_score DESC) AS rn
  FROM scored)
SELECT
  FORMAT_DATE('%Y-%m-%d', date) AS second_highest_zscore_date
FROM ranked
WHERE rn = 2;
```

