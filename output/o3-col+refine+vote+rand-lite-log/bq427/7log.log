Query:
--Description: 9) Combine attempts and made shots per game & shot_type
WITH attempts AS (
    SELECT shot_type, game_id, COUNT(*) AS att
    FROM   `bigquery-public-data.ncaa_basketball.mbb_pbp_sr`
    WHERE  shot_type     IS NOT NULL
      AND  event_coord_x IS NOT NULL
      AND  event_coord_y IS NOT NULL
      AND ((team_basket = 'left'  AND event_coord_x <  564) OR
           (team_basket = 'right' AND event_coord_x >= 564))
    GROUP BY shot_type, game_id
),
made AS (
    SELECT shot_type, game_id, COUNT(*) AS md
    FROM   `bigquery-public-data.ncaa_basketball.mbb_pbp_sr`
    WHERE  shot_type     IS NOT NULL
      AND  shot_made     = TRUE
      AND  event_coord_x IS NOT NULL
      AND  event_coord_y IS NOT NULL
      AND ((team_basket = 'left'  AND event_coord_x <  564) OR
           (team_basket = 'right' AND event_coord_x >= 564))
    GROUP BY shot_type, game_id
)
SELECT  a.shot_type,
        a.game_id,
        a.att                   AS attempts,
        IFNULL(m.md,0)          AS made,
        SAFE_DIVIDE(m.md,a.att) AS pct_made
FROM    attempts a
LEFT JOIN made m
  ON  m.shot_type = a.shot_type
  AND m.game_id   = a.game_id
LIMIT 20
