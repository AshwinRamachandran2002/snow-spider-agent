Table full name: bigquery-public-data.ncaa_basketball.mbb_historical_tournament_games
Column name: season Type: INT64 Description: Year the game was played in. Note that this is different from the "season" values in other tables here, which use academic year.
Column name: round Type: INT64 Description: Tournament round, indicated by the number of teams playing in that round
Column name: days_from_epoch Type: INT64 Description: Days from epoch, as defined in the Kaggle competition (https://www.kaggle.com/c/mens-machine-learning-competition-2018/data)
Column name: game_date Type: DATE Description: Date the game was played
Column name: day Type: STRING Description: Day of the week the game was played
Column name: win_seed Type: STRING Description: Seed of the winning team
Column name: win_region Type: STRING Description: Region of the winning team, as defined in the Kaggle competition (https://www.kaggle.com/c/mens-machine-learning-competition-2018/data)
Column name: win_market Type: STRING Description: School name (using Sportradar names) of the winning team
Column name: win_name Type: STRING Description: Team name of the winning team
Column name: win_alias Type: STRING Description: Team alias of the winning team
Column name: win_team_id Type: STRING Description: Sportradar team ID of the winning team
Column name: win_school_ncaa Type: STRING Description: School name of the winning team (see http://stats.ncaa.org/game_upload/team_codes)
Column name: win_code_ncaa Type: INT64 Description: School code of the winning team (see http://stats.ncaa.org/game_upload/team_codes)
Column name: win_kaggle_team_id Type: INT64 Description: Kaggle team ID of the winning team
Column name: win_pts Type: INT64 Description: Points scored by the winning team
Column name: lose_seed Type: STRING Description: Seed of the losing team
Column name: lose_region Type: STRING Description: Region of the losing team, as defined in the Kaggle competition (https://www.kaggle.com/c/mens-machine-learning-competition-2018/data)
Column name: lose_market Type: STRING Description: School name (using Sportradar names) of the losing team
Column name: lose_name Type: STRING Description: Team name of the losing team
Column name: lose_alias Type: STRING Description: Team alias of the losing team
Column name: lose_team_id Type: STRING Description: Sportradar team ID of the losing team
Column name: lose_school_ncaa Type: STRING Description: School name of the losing team (see http://stats.ncaa.org/game_upload/team_codes)
Column name: lose_code_ncaa Type: INT64 Description: School code of the losing team (see http://stats.ncaa.org/game_upload/team_codes)
Column name: lose_kaggle_team_id Type: INT64 Description: Kaggle team ID of the losing team
Column name: lose_pts Type: INT64 Description: Points scored by the losing team
Column name: num_ot Type: INT64 Description: Number of overtime periods played in the game
Column name: academic_year Type: INT64 Description: The academic year the game was played in
