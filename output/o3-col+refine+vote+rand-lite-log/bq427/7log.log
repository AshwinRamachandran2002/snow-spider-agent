        `team_market`,
        -- Re-orient X
        CASE WHEN event_coord_x < 564
                  THEN event_coord_x
             ELSE 1128 - event_coord_x
        END AS adj_x,
        -- Re-orient Y
        CASE WHEN event_coord_x < 564
                  THEN 600 - event_coord_y
             ELSE event_coord_y
        END AS adj_y,
        `shot_made`
FROM    `bigquery-public-data.ncaa_basketball.mbb_pbp_sr`
WHERE   `event_type`     = 'shot'
  AND   `scheduled_date` < '2018-03-15'
  AND   `shot_type`      IS NOT NULL
  AND   `event_coord_x`  IS NOT NULL
  AND   `event_coord_y`  IS NOT NULL
  AND ( (`team_basket` = 'left'  AND event_coord_x <  564) OR
        (`team_basket` = 'right' AND event_coord_x >= 564) )
LIMIT 20;
```

