           (team_basket = 'right' AND event_coord_x >= 564))
    GROUP BY shot_type, game_id
)
SELECT  a.shot_type,
        a.game_id,
        a.att                   AS attempts,
        IFNULL(m.md,0)          AS made,
        SAFE_DIVIDE(m.md,a.att) AS pct_made
FROM    attempts a
LEFT JOIN made m
  ON  m.shot_type = a.shot_type
  AND m.game_id   = a.game_id
LIMIT 20
