Table full name: bigquery-public-data.ncaa_basketball.mbb_pbp_sr
Column name: game_id Type: STRING Description: Unique identifier for the game
Column name: load_timestamp Type: TIMESTAMP Description: Time at which the data was loaded into the table
Column name: season Type: INT64 Description: Season the game was played in
Column name: status Type: STRING
Column name: scheduled_date Type: TIMESTAMP Description: Date the game was played
Column name: venue_id Type: STRING Description: Unique identifier for the venue where the game was played
Column name: venue_name Type: STRING Description: Name of the venue where the game was played
Column name: venue_city Type: STRING Description: City where the game was played
Column name: venue_state Type: STRING Description: State where the game was played
Column name: venue_address Type: STRING Description: Address of the venue where the game was played
Column name: venue_zip Type: STRING Description: Zip code of the venue where the game was played
Column name: venue_country Type: STRING Description: Country where the game was played
Column name: venue_capacity Type: INT64 Description: Current capacity of the venue where the game was played
Column name: attendance Type: INT64 Description: Attendance of the game
Column name: neutral_site Type: BOOL Description: Boolean value indicating whether the game was played at a neutral site
Column name: conference_game Type: BOOL Description: Boolean value indicating whether the two teams were in the same conference at the time the game was played
Column name: tournament Type: STRING Description: Indicator of what type of tournament (conference or NCAA) a game was played in, if any
Column name: tournament_type Type: STRING Description: Indicator of which conference tournament a game was played in, if any
Column name: round Type: STRING Description: Indicator of which tournament round a game was played in, if any
Column name: game_no Type: STRING Description: Indicator of which tournament game number a game was, if any
Column name: away_market Type: STRING Description: Visiting team school name
Column name: away_name Type: STRING Description: Visiting team name
Column name: away_id Type: STRING Description: Visiting team school ID from SportRadar (unique)
To enable screen reader support, press Ctrl+Alt+Z To learn about keyboard shortcuts, press Ctrl+slash
Column name: away_alias Type: STRING Description: Visiting team school alias (unique)
Column name: away_conf_name Type: STRING Description: Visiting team current conference name (not unique)
Column name: away_conf_alias Type: STRING Description: Visiting team current conference alias (not unique)
Column name: away_division_name Type: STRING Description: Visiting team division name (not unique)
Column name: away_division_alias Type: STRING Description: Visiting team division alias (not unique)
Column name: away_league_name Type: STRING Description: Visiting team school league name (not unique)
Column name: home_market Type: STRING Description: Home team school name
Column name: home_name Type: STRING Description: Home team name
Column name: home_id Type: STRING Description: Home team school ID from SportRadar (unique)
Column name: home_alias Type: STRING Description: Home team school alias (unique)
Column name: home_conf_name Type: STRING Description: Home team current conference name (not unique)
Column name: home_conf_alias Type: STRING Description: Home team current conference alias (not unique)
Column name: home_division_name Type: STRING Description: Home team current division name (not unique)
Column name: home_division_alias Type: STRING Description: Home team current division alias (not unique)
Column name: home_league_name Type: STRING Description: Home team school league name (not unique)
Column name: period Type: INT64 Description: This field indicates which period the event occured in. "1" is the first 20-minute half, "2" is the second 20-minute half, "3" is the first OT, "4" is the second OT, etc.
Column name: game_clock Type: STRING Description: Time left in the period in minutes
Column name: elapsed_time_sec Type: INT64 Description: Total time elapsed in the game in seconds
Column name: possession_arrow Type: STRING Description: The unique identifier of the team that will receive the ball the next time a jump ball is called, see https://en.wikipedia.org/wiki/Jump_ball for more information
Column name: team_name Type: STRING Description: Indicator of the school name to which the event was attributed
Column name: team_market Type: STRING Description: Indicator of the team name to which the event was attributed
Column name: team_id Type: STRING Description: Indicator of the team school ID from SportRadar (unique) to which the event was attributed
Column name: team_alias Type: STRING Description: Indicator of the team school alias (unique) to which the event was attributed
Column name: team_conf_name Type: STRING Description: Indicator of the team current conference name (not unique) to which the event was attributed
Column name: team_conf_alias Type: STRING Description: Indicator of the team current conference alias (not unique) to which the event was attributed
Column name: team_division_name Type: STRING Description: Indicator of the team current division name (not unique) to which the event was attributed
Column name: team_division_alias Type: STRING Description: Indicator of the team current division alias (not unique) to which the event was attributed
Column name: team_league_name Type: STRING Description: Indicator of the team school league name (not unique) to which the event was attributed
Column name: team_basket Type: STRING Description: The basket (left or right) that the team to which the event is attributed is attacking
Column name: possession_team_id Type: STRING Description: The id of the team that possessed the ball at the end of the play.
Column name: player_id Type: STRING Description: Unique identifier for the player to whom the event is attributed
Column name: player_full_name Type: STRING Description: Name for the player to whom the event is attributed
Column name: jersey_num Type: INT64 Description: Jersey number for the player to whom the event is attributed
Column name: event_id Type: STRING Description: Unique identifier for the event ("play")
Column name: timestamp Type: TIMESTAMP Description: The time when the event details were last updated
Column name: event_description Type: STRING Description: A description of the event
Column name: event_coord_x Type: FLOAT64 Description: The location of the play in number of inches from the "left" baseline, max 1128
Column name: event_coord_y Type: FLOAT64 Description: The location of the play in inches from the "top" sideline, max 600
Column name: event_type Type: STRING Description: Category of event
Column name: type Type: STRING Description: Event subtype giving additional information about the event
Column name: shot_made Type: BOOL Description: Boolean value indicating whether the event was a shot made
Column name: shot_type Type: STRING Description: There are 5 categories of shot types: jump shot, layup, hook shot, dunk, tip shot
Column name: shot_subtype Type: STRING Description: Additional information about shot type (e.g. fadeaway, floating, pullup, step back, turnaround, alley-oop, driving, finger roll, putback, reverse)
Column name: three_point_shot Type: BOOL Description: Boolean value indicating whether the event was a three-point shot attempt
Column name: points_scored Type: FLOAT64 Description: Number of points scored on the play
Column name: turnover_type Type: STRING Description: Type of turnover
Column name: rebound_type Type: STRING Description: Indicator of whether a rebound was offensive or defensive
Column name: timeout_duration Type: FLOAT64 Description: Duration of timeout
