```

```sql
-- Description: 8)  Aggregate: number of MADE shots per game per shot_type
SELECT  `shot_type`,
        COUNT(*)               AS made_in_game,
        `game_id`
FROM    `bigquery-public-data.ncaa_basketball.mbb_pbp_sr`
WHERE   `event_type`     = 'shot'
  AND   `shot_made`      = TRUE
  AND   `scheduled_date` < '2018-03-15'
  AND   `shot_type`      IS NOT NULL
  AND   `event_coord_x`  IS NOT NULL
  AND   `event_coord_y`  IS NOT NULL
  AND ( (`team_basket` = 'left'  AND event_coord_x <  564) OR
        (`team_basket` = 'right' AND event_coord_x >= 564) )
GROUP BY `shot_type`, `game_id`
LIMIT 20;
```

```sql
-- Description: 9)  Combine the two previous steps: per shot_type and game,
--                  attempts, made, and shooting percentage
WITH attempts AS (
    SELECT  `shot_type`, `game_id`, COUNT(*) AS att
    FROM    `bigquery-public-data.ncaa_basketball.mbb_pbp_sr`
    WHERE   `event_type`     = 'shot'
      AND   `scheduled_date` < '2018-03-15'
      AND   `shot_type`      IS NOT NULL
      AND   `event_coord_x`  IS NOT NULL
      AND   `event_coord_y`  IS NOT NULL
      AND ( (`team_basket` = 'left'  AND event_coord_x <  564) OR
            (`team_basket` = 'right' AND event_coord_x >= 564) )
    GROUP BY `shot_type`, `game_id`
),
made AS (
    SELECT  `shot_type`, `game_id`, COUNT(*) AS md
    FROM    `bigquery-public-data.ncaa_basketball.mbb_pbp_sr`
    WHERE   `event_type`     = 'shot'
      AND   `shot_made`      = TRUE
      AND   `scheduled_date` < '2018-03-15'
      AND   `shot_type`      IS NOT NULL
      AND   `event_coord_x`  IS NOT NULL
      AND   `event_coord_y`  IS NOT NULL
      AND ( (`team_basket` = 'left'  AND event_coord_x <  564) OR
            (`team_basket` = 'right' AND event_coord_x >= 564) )
    GROUP BY `shot_type`, `game_id`
)
SELECT  a.shot_type,
        a.game_id,
        a.att                     AS attempts,
        IFNULL(m.md,0)            AS made,
        SAFE_DIVIDE(m.md,a.att)   AS pct_made
FROM    attempts a
LEFT JOIN made m
  ON    m.shot_type = a.shot_type
  AND   m.game_id   = a.game_id
LIMIT 20;
```

```sql
-- Description: 10)  FINAL ANSWER ‑-  for every `shot_type`:
--                   * Average (re-oriented) X and Y coordinates
--                   * Average number of shot attempts per game
--                   * Average number of made shots per game
WITH cleaned AS (
    SELECT  `shot_type`,
            `game_id`,
            -- Re-orient coordinates so all shots are toward the left basket
            CASE WHEN event_coord_x < 564
                     THEN event_coord_x
                 ELSE 1128 - event_coord_x
            END AS adj_x,
            CASE WHEN event_coord_x < 564
                     THEN 600 - event_coord_y
                 ELSE event_coord_y
            END AS adj_y,
            `shot_made`
    FROM    `bigquery-public-data.ncaa_basketball.mbb_pbp_sr`
    WHERE   `event_type`     = 'shot'
      AND   `scheduled_date` < '2018-03-15'
      AND   `shot_type`      IS NOT NULL
      AND   `event_coord_x`  IS NOT NULL
      AND   `event_coord_y`  IS NOT NULL
      AND ( (`team_basket` = 'left'  AND event_coord_x <  564) OR
            (`team_basket` = 'right' AND event_coord_x >= 564) )
),
per_game AS (
    SELECT  shot_type,
            game_id,
            COUNT(*)                             AS attempts,
            SUM(CASE WHEN shot_made THEN 1 ELSE 0 END) AS made,
            AVG(adj_x)  AS avg_x_in_game,
            AVG(adj_y)  AS avg_y_in_game
    FROM    cleaned
    GROUP BY shot_type, game_id
)
SELECT  shot_type,
        AVG(avg_x_in_game)  AS avg_adj_x,
        AVG(avg_y_in_game)  AS avg_adj_y,
        AVG(attempts)       AS avg_attempts,
        AVG(made)           AS avg_made
FROM    per_game
GROUP BY shot_type
ORDER BY shot_type
LIMIT 20;
```
