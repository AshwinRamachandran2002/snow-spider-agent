Query:
-- Description: Join 2011 vs. 2018 to compute population change (% and absolute) and median-income change for every Kings-County tract.
WITH base AS (
  SELECT
      a.geo_id,
      a.total_pop  AS pop_2011,
      b.total_pop  AS pop_2018,
      a.median_income AS inc_2011,
      b.median_income AS inc_2018
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` AS a
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS b
    USING (geo_id)
  WHERE LEFT(a.geo_id,5) = '36047'
        AND a.total_pop  > 1000
        AND b.total_pop  > 1000
)
SELECT *,
       SAFE_DIVIDE(pop_2018-pop_2011,pop_2011) AS pct_pop_change,
       (inc_2018-inc_2011)                     AS abs_inc_change
FROM base
LIMIT 20;
