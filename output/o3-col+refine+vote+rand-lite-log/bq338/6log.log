-- Description: (Optional) Display both rankings side-by-side for the intersecting tracts.
WITH joined AS (
  SELECT
    a.geo_id,
    SAFE_DIVIDE(b.total_pop-a.total_pop,a.total_pop) AS pct_pop_change,
    (b.median_income-a.median_income) AS abs_inc_change
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` AS a
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS b
    USING (geo_id)
  WHERE LEFT(a.geo_id,5)='36047' AND a.total_pop>1000 AND b.total_pop>1000
),
ranks AS (
  SELECT
    geo_id,
    RANK() OVER (ORDER BY pct_pop_change DESC) AS pop_rank,
    RANK() OVER (ORDER BY abs_inc_change DESC) AS income_rank
  FROM joined
)
SELECT *
FROM ranks
WHERE pop_rank<=20 AND income_rank<=20
ORDER BY pop_rank, income_rank;
