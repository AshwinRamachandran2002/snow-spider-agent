```sql
-- Description: Peek at 2011 ACS 5-year census-tract records for Kings County (FIPS 36047 = “36047………”).
SELECT *
FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr`
WHERE LEFT(`geo_id`, 5) = '36047'
LIMIT 20;
```

```sql
-- Description: Peek at 2018 ACS 5-year census-tract records for Kings County.
SELECT *
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE LEFT(`geo_id`, 5) = '36047'
LIMIT 20;
```

```sql
-- Description: Join 2011 vs. 2018 to compute population change (% and absolute) and median-income change for every Kings-County tract.
WITH base AS (
  SELECT
      a.geo_id,
      a.total_pop  AS pop_2011,
      b.total_pop  AS pop_2018,
      a.median_income AS inc_2011,
      b.median_income AS inc_2018
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` AS a
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS b
    USING (geo_id)
  WHERE LEFT(a.geo_id,5) = '36047'
        AND a.total_pop  > 1000
        AND b.total_pop  > 1000
)
SELECT *,
       SAFE_DIVIDE(pop_2018-pop_2011,pop_2011) AS pct_pop_change,
       (inc_2018-inc_2011)                     AS abs_inc_change
FROM base
LIMIT 20;
```

```sql
-- Description: Top-20 Kings-County tracts by largest % increase in population (still meeting the 1 000-resident rule).
WITH metrics AS (
  SELECT
    geo_id,
    SAFE_DIVIDE(pop_2018-pop_2011,pop_2011) AS pct_pop_change
  FROM (
    SELECT
      a.geo_id,
      a.total_pop  AS pop_2011,
      b.total_pop  AS pop_2018
    FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` AS a
    JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS b
      USING (geo_id)
    WHERE LEFT(a.geo_id,5)='36047'
          AND a.total_pop>1000 AND b.total_pop>1000
  )
)
SELECT geo_id, pct_pop_change
FROM metrics
ORDER BY pct_pop_change DESC
LIMIT 20;
```

```sql
-- Description: Top-20 Kings-County tracts by largest absolute increase in median household income.
WITH metrics AS (
  SELECT
    a.geo_id,
    (b.median_income - a.median_income) AS abs_inc_change
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` AS a
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS b
    USING (geo_id)
  WHERE LEFT(a.geo_id,5)='36047'
        AND a.total_pop>1000 AND b.total_pop>1000
)
SELECT geo_id, abs_inc_change
FROM metrics
ORDER BY abs_inc_change DESC
LIMIT 20;
```

```sql
-- Description: Identify tracts that appear in BOTH top-20 lists above.
WITH joined AS (
  -- compute pop-%-change & income-abs-change together
  SELECT
    a.geo_id,
    SAFE_DIVIDE(b.total_pop-a.total_pop,a.total_pop) AS pct_pop_change,
    (b.median_income-a.median_income)                AS abs_inc_change
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` AS a
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS b
    USING (geo_id)
  WHERE LEFT(a.geo_id,5)='36047'
        AND a.total_pop>1000 AND b.total_pop>1000
), 
top20_pop  AS (
  SELECT geo_id FROM joined
  ORDER BY pct_pop_change DESC
  LIMIT 20
), 
top20_inc  AS (
  SELECT geo_id FROM joined
  ORDER BY abs_inc_change DESC
  LIMIT 20
)
SELECT j.geo_id,
       j.pct_pop_change,
       j.abs_inc_change
FROM joined AS j
JOIN top20_pop AS p  USING (geo_id)
JOIN top20_inc AS i  USING (geo_id)
ORDER BY j.pct_pop_change DESC, j.abs_inc_change DESC
LIMIT 20;
```

```sql
-- Description: Show the final answer (all qualifying tracts) without the LIMIT, 
-- sorted by pct-population change then income change.
WITH joined AS (
  SELECT
    a.geo_id,
    a.total_pop AS pop_2011,
    b.total_pop AS pop_2018,
    a.median_income AS inc_2011,
    b.median_income AS inc_2018,
    SAFE_DIVIDE(b.total_pop-a.total_pop,a.total_pop) AS pct_pop_change,
    (b.median_income-a.median_income)                AS abs_inc_change
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` AS a
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS b
    USING (geo_id)
  WHERE LEFT(a.geo_id,5)='36047'
        AND a.total_pop>1000 AND b.total_pop>1000
), 
top20_pop  AS (
  SELECT geo_id FROM joined
  ORDER BY pct_pop_change DESC
  LIMIT 20
), 
top20_inc  AS (
  SELECT geo_id FROM joined
  ORDER BY abs_inc_change DESC
  LIMIT 20
)
SELECT 
  j.geo_id,
  j.pop_2011,
  j.pop_2018,
  j.pct_pop_change,
  j.inc_2011,
  j.inc_2018,
  j.abs_inc_change
FROM joined AS j
JOIN top20_pop AS p USING (geo_id)
JOIN top20_inc AS i USING (geo_id)
ORDER BY pct_pop_change DESC, abs_inc_change DESC;
```

```sql
-- Description: If you need only the GEOIDs of the intersecting tracts (compact result).
WITH pop_rank AS (
  SELECT geo_id, 
         ROW_NUMBER() OVER (ORDER BY SAFE_DIVIDE(b.total_pop - a.total_pop, a.total_pop) DESC) AS rk_pop
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` AS a
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS b
    USING (geo_id)
  WHERE LEFT(a.geo_id,5)='36047' AND a.total_pop>1000 AND b.total_pop>1000
),
inc_rank AS (
  SELECT geo_id, 
         ROW_NUMBER() OVER (ORDER BY (b.median_income - a.median_income) DESC) AS rk_inc
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` AS a
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS b
    USING (geo_id)
  WHERE LEFT(a.geo_id,5)='36047' AND a.total_pop>1000 AND b.total_pop>1000
)
SELECT p.geo_id
FROM pop_rank AS p
JOIN inc_rank AS i USING (geo_id)
WHERE p.rk_pop<=20 AND i.rk_inc<=20
ORDER BY p.rk_pop, i.rk_inc;
```

```sql
-- Description: Quick verification – count how many tracts satisfy all three criteria.
WITH pop_rank AS (
  SELECT geo_id, 
         ROW_NUMBER() OVER (ORDER BY SAFE_DIVIDE(b.total_pop - a.total_pop, a.total_pop) DESC) AS rk_pop
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` AS a
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS b
    USING (geo_id)
  WHERE LEFT(a.geo_id,5)='36047' AND a.total_pop>1000 AND b.total_pop>1000
),
inc_rank AS (
  SELECT geo_id, 
         ROW_NUMBER() OVER (ORDER BY (b.median_income - a.median_income) DESC) AS rk_inc
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` AS a
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS b
    USING (geo_id)
  WHERE LEFT(a.geo_id,5)='36047' AND a.total_pop>1000 AND b.total_pop>1000
)
SELECT COUNT(*) AS n_matching_tracts
FROM pop_rank AS p
JOIN inc_rank AS i USING (geo_id)
WHERE p.rk_pop<=20 AND i.rk_inc<=20;
```

```sql
-- Description: (Optional) Display both rankings side-by-side for the intersecting tracts.
WITH joined AS (
  SELECT
    a.geo_id,
    SAFE_DIVIDE(b.total_pop-a.total_pop,a.total_pop) AS pct_pop_change,
    (b.median_income-a.median_income) AS abs_inc_change
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` AS a
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS b
    USING (geo_id)
  WHERE LEFT(a.geo_id,5)='36047' AND a.total_pop>1000 AND b.total_pop>1000
),
ranks AS (
  SELECT
    geo_id,
    RANK() OVER (ORDER BY pct_pop_change DESC) AS pop_rank,
    RANK() OVER (ORDER BY abs_inc_change DESC) AS income_rank
  FROM joined
)
SELECT *
FROM ranks
WHERE pop_rank<=20 AND income_rank<=20
ORDER BY pop_rank, income_rank;
```

These queries progress from simple exploration to the final intersection of the required top-20 lists, yielding the census-tract GEOIDs (and any additional detail you might need) that satisfy every condition.
