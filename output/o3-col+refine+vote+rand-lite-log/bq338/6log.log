Query:
-- Description: Identify tracts that appear in BOTH top-20 lists above.
WITH joined AS (
  -- compute pop-%-change & income-abs-change together
  SELECT
    a.geo_id,
    SAFE_DIVIDE(b.total_pop-a.total_pop,a.total_pop) AS pct_pop_change,
    (b.median_income-a.median_income)                AS abs_inc_change
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` AS a
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS b
    USING (geo_id)
  WHERE LEFT(a.geo_id,5)='36047'
        AND a.total_pop>1000 AND b.total_pop>1000
), 
top20_pop  AS (
  SELECT geo_id FROM joined
  ORDER BY pct_pop_change DESC
  LIMIT 20
), 
top20_inc  AS (
  SELECT geo_id FROM joined
  ORDER BY abs_inc_change DESC
  LIMIT 20
)
SELECT j.geo_id,
       j.pct_pop_change,
       j.abs_inc_change
FROM joined AS j
JOIN top20_pop AS p  USING (geo_id)
JOIN top20_inc AS i  USING (geo_id)
ORDER BY j.pct_pop_change DESC, j.abs_inc_change DESC
LIMIT 20;
