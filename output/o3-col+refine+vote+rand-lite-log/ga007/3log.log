```sql
--Description / Thinking process:
-- Goal: calculate what percentage of all 2-Jan-2021 `page_view` events qualify as
--       Product-Detail-Page (PDP) views, per the refined rules.
-- Steps
--   1. Filter table `events_20210102` to `page_view` events only and pull `page_location`.
--   2. Convert the URL to lowercase for case-insensitive checks.
--   3. Derive the last path segment via ARRAY_REVERSE(SPLIT()) to avoid negative indexing.
--   4. Mark a row as PDP when:
--        a) The last segment contains “+”  (detail indicator), AND
--        b) The full URL contains any allowed category keyword
--           (accessories, apparel, … wearables) with “+” replacing spaces.
--   5. Compute:
--        • pdp_views          – count of PDP-qualified page views
--        • total_page_views   – all page_view events
--        • pdp_percentage     – pdp_views / total_page_views * 100
WITH page_views AS (
  SELECT
    LOWER(ep.value.string_value)                                           AS url,
    ARRAY_REVERSE(SPLIT(LOWER(ep.value.string_value), '/'))[OFFSET(0)]     AS last_segment
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
  UNNEST(event_params) AS ep
  WHERE event_name = 'page_view'
    AND ep.key      = 'page_location'
)
SELECT
  COUNTIF(
    REGEXP_CONTAINS(last_segment, r'\+') AND
    REGEXP_CONTAINS(url,
      r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
  )                                                     AS pdp_views,
  COUNT(*)                                              AS total_page_views,
  SAFE_DIVIDE(
      COUNTIF(
        REGEXP_CONTAINS(last_segment, r'\+') AND
        REGEXP_CONTAINS(url,
          r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
      ),
      COUNT(*)
  ) * 100                                               AS pdp_percentage
FROM page_views;
```
