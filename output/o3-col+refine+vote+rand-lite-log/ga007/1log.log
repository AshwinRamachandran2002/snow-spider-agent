Query:
--Description: 
-- 8) Final calculation – percentage of page-views that are PDPs on 2-Jan-2021.
WITH page_views AS (
  SELECT ep.value.string_value AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` AS e,
       UNNEST(e.event_params) AS ep
  WHERE e.event_name = 'page_view'
    AND ep.key = 'page_location'
),
segments AS (
  SELECT
    url,
    SPLIT(REGEXP_EXTRACT(url, r'^https?://[^/]+/(.*)$'), '/') AS parts
  FROM page_views
),
flagged AS (
  SELECT
    ARRAY_LENGTH(parts)                                                        AS len,
    REGEXP_CONTAINS(parts[ORDINAL(ARRAY_LENGTH(parts))], r'\+')                AS has_plus,
    (
      REGEXP_CONTAINS(LOWER(parts[SAFE_ORDINAL(4)]),
                      r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
      OR
      REGEXP_CONTAINS(LOWER(parts[SAFE_ORDINAL(5)]),
                      r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
    )                                                                         AS has_category
  FROM segments
),
stats AS (
  SELECT
    COUNT(*)                                                             AS total_page_views,
    SUM(CASE WHEN len >= 5 AND has_plus AND has_category THEN 1 END)     AS pdp_views
  FROM flagged
)
SELECT
  pdp_views,
  total_page_views,
  ROUND(100 * pdp_views / total_page_views, 2) AS pdp_percentage
FROM stats
