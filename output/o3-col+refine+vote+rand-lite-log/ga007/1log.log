```sql
--Description: 
-- Compute the share of Product-Detail-Page (PDP) views among all 2-Jan-2021 page_view events.  
-- Logic applied row-by-row:  
--   • Extract `page_location` from event_params.  
--   • Split it into path segments (after the domain).  
--   • PDP rules = URL has ≥5 segments, the LAST segment contains “+”, and either the 4th or 5th
--     segment holds one of the allowed category keywords (case-insensitive, “+” substitutes blanks).  
-- Finally return the counts and percentage of PDP page views.
WITH page_views AS (
  SELECT ep.value.string_value AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` AS e,
       UNNEST(e.event_params) AS ep
  WHERE e.event_name = 'page_view'
    AND ep.key = 'page_location'
),
segments AS (
  SELECT
    url,
    SPLIT(REGEXP_EXTRACT(url, r'^https?://[^/]+/(.*)$'), '/') AS parts
  FROM page_views
),
stats AS (
  SELECT
    COUNT(*) AS total_views,
    SUM(
      CASE
        WHEN ARRAY_LENGTH(parts) >= 5
         AND REGEXP_CONTAINS(parts[ORDINAL(ARRAY_LENGTH(parts))], r'\+')
         AND (
              REGEXP_CONTAINS(LOWER(parts[SAFE_ORDINAL(4)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
           OR REGEXP_CONTAINS(LOWER(parts[SAFE_ORDINAL(5)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
         )
        THEN 1 ELSE 0
      END
    ) AS pdp_views
  FROM segments
)
SELECT
  pdp_views,
  total_views,
  ROUND(100 * pdp_views / total_views, 2) AS pdp_percentage
FROM stats;
```
