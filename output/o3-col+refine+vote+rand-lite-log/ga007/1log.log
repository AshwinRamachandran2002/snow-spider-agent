```sql
-- 6) Show the 4th & 5th path segments plus the last segment
WITH pw AS (
  SELECT ep.value.string_value AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
  UNNEST(t.event_params) ep
  WHERE t.event_name = 'page_view'
    AND ep.key = 'page_location'
)
SELECT
  url,
  SPLIT(REGEXP_EXTRACT(url, r'^https?://[^/]+/(.*)$'), '/') AS parts,
  parts[SAFE_ORDINAL(4)] AS seg4,
  parts[SAFE_ORDINAL(5)] AS seg5,
  parts[ORDINAL(ARRAY_LENGTH(parts))] AS last_seg
FROM pw
LIMIT 20;
```

```sql
-- 7) Count page_view rows classified as PDPs according to refined rules
WITH page_views AS (
  SELECT ep.value.string_value AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
  UNNEST(t.event_params) ep
  WHERE t.event_name = 'page_view'
    AND ep.key = 'page_location'
),
segments AS (
  SELECT
    url,
    SPLIT(REGEXP_EXTRACT(url, r'^https?://[^/]+/(.*)$'), '/') AS parts
  FROM page_views
)
SELECT
  COUNT(*) AS pdp_views
FROM segments
WHERE ARRAY_LENGTH(parts) >= 5
  AND REGEXP_CONTAINS(parts[ORDINAL(ARRAY_LENGTH(parts))], r'\+')                  -- plus sign in last segment
  AND (
       REGEXP_CONTAINS(LOWER(parts[SAFE_ORDINAL(4)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
    OR REGEXP_CONTAINS(LOWER(parts[SAFE_ORDINAL(5)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
      )
LIMIT 20;
```

```sql
-- 8) Final answer – percentage of page views on 2021-01-02 that are PDPs
WITH page_views AS (
  SELECT ep.value.string_value AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` t,
  UNNEST(t.event_params) ep
  WHERE t.event_name = 'page_view'
    AND ep.key = 'page_location'
),
segments AS (
  SELECT
    url,
    SPLIT(REGEXP_EXTRACT(url, r'^https?://[^/]+/(.*)$'), '/') AS parts
  FROM page_views
),
flags AS (
  SELECT
    url,
    ARRAY_LENGTH(parts)                        AS len,
    REGEXP_CONTAINS(parts[ORDINAL(len)], r'\+')                     AS has_plus,
    (
      REGEXP_CONTAINS(LOWER(parts[SAFE_ORDINAL(4)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
      OR
      REGEXP_CONTAINS(LOWER(parts[SAFE_ORDINAL(5)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
    )                                           AS has_category
  FROM segments
),
tally AS (
  SELECT
    COUNT(*)                                               AS total_page_views,
    SUM(CASE WHEN has_plus AND has_category AND len >= 5
             THEN 1 ELSE 0 END)                           AS pdp_views
  FROM flags
)
SELECT
  pdp_views,
  total_page_views,
  ROUND(100 * pdp_views / total_page_views, 2) AS pdp_percentage
FROM tally
LIMIT 20;
```
