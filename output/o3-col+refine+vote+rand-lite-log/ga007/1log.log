Query:
--Description: 
-- 6) Inspect sample URLs by exposing the 4th, 5th, and last path-segments of page-view URLs.  
--    Two-step approach avoids self-reference errors: first build `parts`, then unpack it.
WITH pw AS (   -- collect URLs
  SELECT ep.value.string_value AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` AS t,
       UNNEST(t.event_params) AS ep
  WHERE t.event_name = 'page_view'
    AND ep.key = 'page_location'
),
split AS (      -- split URL after the domain into path segments
  SELECT
    url,
    SPLIT(REGEXP_EXTRACT(url, r'^https?://[^/]+/(.*)$'), '/') AS parts
  FROM pw
)
SELECT
  url,
  parts,                                       -- full array of segments
  parts[SAFE_ORDINAL(4)]                       AS seg4,
  parts[SAFE_ORDINAL(5)]                       AS seg5,
  parts[ORDINAL(ARRAY_LENGTH(parts))]          AS last_seg
FROM split
LIMIT 20
