```sql
--Description: Identify the pizza_id values for the two menu items we need prices for
SELECT DISTINCT "pizza_id",
                "pizza_name"
FROM   "pizza_names"
WHERE  "pizza_name" IN ('Meatlovers', 'Vegetarian')
LIMIT 20;
```

```sql
--Description: Show all orders that were for either the Meat Lovers or Vegetarian pizzas
SELECT DISTINCT "order_id",
                "customer_id",
                "pizza_id",
                "extras"
FROM   "pizza_clean_customer_orders"
WHERE  "pizza_id" IN (1, 2)
LIMIT 20;
```

```sql
--Description: Check the cancellation status of the above orders
SELECT DISTINCT pco."order_id",
                pr."cancellation"
FROM   "pizza_clean_customer_orders" AS pco
JOIN   "pizza_clean_runner_orders"   AS pr
       ON pco."order_id" = pr."order_id"
WHERE  pco."pizza_id" IN (1, 2)
LIMIT 20;
```

```sql
--Description: Retrieve only the non-cancelled Meat Lovers or Vegetarian orders
SELECT DISTINCT pco."order_id",
                pco."pizza_id"
FROM   "pizza_clean_customer_orders" AS pco
JOIN   "pizza_clean_runner_orders"   AS pr
       ON pco."order_id" = pr."order_id"
WHERE  pr."cancellation" IS NULL
  AND  pco."pizza_id" IN (1, 2)
LIMIT 20;
```

```sql
--Description: Inspect how many extra toppings each of those orders has
SELECT DISTINCT "order_id",
                "extras_count"
FROM   "pizza_get_extras"
WHERE  "order_id" IN (SELECT "order_id"
                      FROM   "pizza_clean_customer_orders"
                      WHERE  "pizza_id" IN (1, 2))
LIMIT 20;
```

```sql
--Description: Aggregate extras per order so each order has just one total_extras value
SELECT   "order_id",
         SUM("extras_count") AS "total_extras"
FROM     "pizza_get_extras"
GROUP BY "order_id"
LIMIT 20;
```

```sql
--Description: Calculate revenue per qualifying order (base price + $1 per extra topping)
SELECT pco."order_id",
       CASE WHEN pco."pizza_id" = 1 THEN 12         -- Meat Lovers price
            WHEN pco."pizza_id" = 2 THEN 10 END     -- Vegetarian price
            AS "base_price",
       COALESCE(te."total_extras", 0)               AS "extras",
       CASE WHEN pco."pizza_id" = 1 THEN 12
            WHEN pco."pizza_id" = 2 THEN 10 END
            + COALESCE(te."total_extras", 0)        AS "order_revenue"
FROM   "pizza_clean_customer_orders"                AS pco
JOIN   "pizza_clean_runner_orders"                  AS pr
       ON pco."order_id" = pr."order_id"
LEFT JOIN (SELECT "order_id",
                  SUM("extras_count") AS "total_extras"
           FROM   "pizza_get_extras"
           GROUP BY "order_id")                     AS te
       ON pco."order_id" = te."order_id"
WHERE  pr."cancellation" IS NULL
  AND  pco."pizza_id" IN (1, 2)
LIMIT 20;
```

```sql
--Description: Total money earned from all non-cancelled Meat Lovers and Vegetarian orders
SELECT SUM(
         CASE WHEN pco."pizza_id" = 1 THEN 12
              WHEN pco."pizza_id" = 2 THEN 10 END
         + COALESCE(te."total_extras", 0)
       ) AS "total_income"
FROM   "pizza_clean_customer_orders" AS pco
JOIN   "pizza_clean_runner_orders"   AS pr
       ON pco."order_id" = pr."order_id"
LEFT JOIN (SELECT "order_id",
                  SUM("extras_count") AS "total_extras"
           FROM   "pizza_get_extras"
           GROUP BY "order_id")       AS te
       ON pco."order_id" = te."order_id"
WHERE  pr."cancellation" IS NULL
  AND  pco."pizza_id" IN (1, 2);
```
