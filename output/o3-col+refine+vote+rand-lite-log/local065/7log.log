Query:
--Description: Calculate revenue per qualifying order (base price + $1 per extra topping)
SELECT pco."order_id",
       CASE WHEN pco."pizza_id" = 1 THEN 12         -- Meat Lovers price
            WHEN pco."pizza_id" = 2 THEN 10 END     -- Vegetarian price
            AS "base_price",
       COALESCE(te."total_extras", 0)               AS "extras",
       CASE WHEN pco."pizza_id" = 1 THEN 12
            WHEN pco."pizza_id" = 2 THEN 10 END
            + COALESCE(te."total_extras", 0)        AS "order_revenue"
FROM   "pizza_clean_customer_orders"                AS pco
JOIN   "pizza_clean_runner_orders"                  AS pr
       ON pco."order_id" = pr."order_id"
LEFT JOIN (SELECT "order_id",
                  SUM("extras_count") AS "total_extras"
           FROM   "pizza_get_extras"
           GROUP BY "order_id")                     AS te
       ON pco."order_id" = te."order_id"
WHERE  pr."cancellation" IS NULL
  AND  pco."pizza_id" IN (1, 2)
LIMIT 20;
