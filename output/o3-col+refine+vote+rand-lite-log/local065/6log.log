Query:
-- 7. Build a list of active (non-cancelled) orders together with their pizza name and extras
SELECT o.order_id,
       pn.pizza_name,
       COALESCE(e.total_extras,0) AS total_extras
FROM  pizza_clean_customer_orders  AS o
JOIN  pizza_clean_runner_orders    AS r  USING (order_id)
JOIN  pizza_names                  AS pn USING (pizza_id)
LEFT JOIN (
        SELECT order_id,
               SUM(extras_count) AS total_extras
        FROM   pizza_get_extras
        GROUP  BY order_id
) AS e USING (order_id)
WHERE r.cancellation IS NULL
LIMIT 20;
