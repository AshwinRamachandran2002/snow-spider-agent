```sql
-- 1. Inspect all cleaned customer orders
SELECT *
FROM pizza_clean_customer_orders
LIMIT 20;
```

```sql
-- 2. Inspect all cleaned runner orders (to see the cancellation flag)
SELECT *
FROM pizza_clean_runner_orders
LIMIT 20;
```

```sql
-- 3. Only keep orders that were NOT cancelled
SELECT o.*
FROM pizza_clean_customer_orders  AS o
JOIN pizza_clean_runner_orders    AS r  USING (order_id)
WHERE r.cancellation IS NULL
LIMIT 20;
```

```sql
-- 4. Map pizza_id to the pizza name so we know which orders are Meat Lovers or Vegetarian
SELECT DISTINCT pn.pizza_id,
       pn.pizza_name
FROM pizza_names AS pn;
```

```sql
-- 5. Show all extra-topping rows and their counted amount
SELECT *
FROM pizza_get_extras
LIMIT 20;
```

```sql
-- 6. Sum the number of paid extras per order
SELECT order_id,
       SUM(extras_count) AS total_extras
FROM pizza_get_extras
GROUP BY order_id
LIMIT 20;
```

```sql
-- 7. Build a list of active (non-cancelled) orders together with their pizza name and extras
SELECT o.order_id,
       pn.pizza_name,
       COALESCE(e.total_extras,0) AS total_extras
FROM  pizza_clean_customer_orders  AS o
JOIN  pizza_clean_runner_orders    AS r  USING (order_id)
JOIN  pizza_names                  AS pn USING (pizza_id)
LEFT JOIN (
        SELECT order_id,
               SUM(extras_count) AS total_extras
        FROM   pizza_get_extras
        GROUP  BY order_id
) AS e USING (order_id)
WHERE r.cancellation IS NULL
LIMIT 20;
```

```sql
-- 8. Compute the revenue for every kept order
SELECT o.order_id,
       CASE
            WHEN pn.pizza_name = 'Meatlovers' THEN 12
            WHEN pn.pizza_name = 'Vegetarian' THEN 10
       END                                                   AS base_price,
       COALESCE(e.total_extras,0)                            AS extras_cnt,
       CASE
            WHEN pn.pizza_name = 'Meatlovers' THEN 12
            WHEN pn.pizza_name = 'Vegetarian' THEN 10
       END + COALESCE(e.total_extras,0)                      AS order_revenue
FROM  pizza_clean_customer_orders  AS o
JOIN  pizza_clean_runner_orders    AS r  USING (order_id)
JOIN  pizza_names                  AS pn USING (pizza_id)
LEFT JOIN (
        SELECT order_id,
               SUM(extras_count) AS total_extras
        FROM   pizza_get_extras
        GROUP  BY order_id
) AS e USING (order_id)
WHERE r.cancellation IS NULL
LIMIT 20;
```

```sql
-- 9. Finally, sum up every order’s revenue → TOTAL money earned by Pizza Runner
SELECT SUM(
        CASE
            WHEN pn.pizza_name = 'Meatlovers' THEN 12
            WHEN pn.pizza_name = 'Vegetarian' THEN 10
        END + COALESCE(e.total_extras,0)           -- $1 for each extra topping
) AS total_revenue
FROM  pizza_clean_customer_orders  AS o
JOIN  pizza_clean_runner_orders    AS r  USING (order_id)
JOIN  pizza_names                  AS pn USING (pizza_id)
LEFT JOIN (
        SELECT order_id,
               SUM(extras_count) AS total_extras
        FROM   pizza_get_extras
        GROUP  BY order_id
) AS e USING (order_id)
WHERE r.cancellation IS NULL;
```

```sql
-- 10. (Optional) Round-trip check: count how many orders contributed to the revenue
SELECT COUNT(*) AS active_paid_orders
FROM  pizza_clean_customer_orders  AS o
JOIN  pizza_clean_runner_orders    AS r  USING (order_id)
WHERE r.cancellation IS NULL;
```
