```sql
-- 1. Inspect all customer pizza orders (cleaned version)
SELECT DISTINCT * 
FROM pizza_clean_customer_orders
LIMIT 20;
```

```sql
-- 2. Inspect the pizza catalogue (id ↔ name)
SELECT DISTINCT *
FROM pizza_names
LIMIT 20;
```

```sql
-- 3. Inspect runner-side data to see which deliveries were cancelled  
SELECT DISTINCT *
FROM pizza_clean_runner_orders
LIMIT 20;
```

```sql
-- 4. Look at the extras table to understand how extras are stored
SELECT DISTINCT *
FROM pizza_get_extras
LIMIT 20;
```

```sql
-- 5. Total extras per order (only those having extras)
SELECT DISTINCT order_id,
       SUM(extras_count) AS total_extras
FROM pizza_get_extras
GROUP BY order_id
LIMIT 20;
```

```sql
-- 6. Orders that were actually delivered (cancellation IS NULL)
SELECT DISTINCT r.order_id
FROM pizza_clean_runner_orders AS r
WHERE r.cancellation IS NULL
LIMIT 20;
```

```sql
-- 7. Delivered orders with their pizza names
SELECT DISTINCT o.order_id,
       n.pizza_name
FROM pizza_clean_customer_orders AS o
JOIN pizza_names                AS n ON o.pizza_id = n.pizza_id
JOIN pizza_clean_runner_orders  AS r ON o.order_id = r.order_id
WHERE r.cancellation IS NULL
LIMIT 20;
```

```sql
-- 8. Delivered orders with their base price
SELECT DISTINCT o.order_id,
       CASE n.pizza_name
            WHEN 'Meatlovers' THEN 12
            WHEN 'Vegetarian' THEN 10
       END AS base_price
FROM pizza_clean_customer_orders AS o
JOIN pizza_names               AS n ON o.pizza_id = n.pizza_id
JOIN pizza_clean_runner_orders AS r ON o.order_id = r.order_id
WHERE r.cancellation IS NULL
LIMIT 20;
```

```sql
-- 9. Delivered orders combined with any extras they had
SELECT DISTINCT b.order_id,
       b.base_price,
       COALESCE(e.total_extras, 0) AS extra_dollars
FROM (          -- base prices for delivered orders
      SELECT o.order_id,
             CASE n.pizza_name
                  WHEN 'Meatlovers' THEN 12
                  WHEN 'Vegetarian' THEN 10
             END AS base_price
      FROM pizza_clean_customer_orders AS o
      JOIN pizza_names               AS n ON o.pizza_id = n.pizza_id
      JOIN pizza_clean_runner_orders AS r ON o.order_id = r.order_id
      WHERE r.cancellation IS NULL
     ) AS b
LEFT JOIN (     -- extras aggregated per order
      SELECT order_id,
             SUM(extras_count) AS total_extras
      FROM pizza_get_extras
      GROUP BY order_id
     ) AS e
ON b.order_id = e.order_id
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: Total revenue = base pizza price + $1 per extra topping
SELECT SUM(b.base_price + COALESCE(e.total_extras, 0)) AS total_income
FROM (          -- base prices for delivered orders
      SELECT o.order_id,
             CASE n.pizza_name
                  WHEN 'Meatlovers' THEN 12
                  WHEN 'Vegetarian' THEN 10
             END AS base_price
      FROM pizza_clean_customer_orders AS o
      JOIN pizza_names               AS n ON o.pizza_id = n.pizza_id
      JOIN pizza_clean_runner_orders AS r ON o.order_id = r.order_id
      WHERE r.cancellation IS NULL
     ) AS b
LEFT JOIN (     -- extras aggregated per order
      SELECT order_id,
             SUM(extras_count) AS total_extras
      FROM pizza_get_extras
      GROUP BY order_id
     ) AS e
ON b.order_id = e.order_id;
-- The single value returned by this query is the total money Pizza Runner has earned.
```
