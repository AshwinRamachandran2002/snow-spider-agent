Query:
-- 9. Delivered orders combined with any extras they had
SELECT DISTINCT b.order_id,
       b.base_price,
       COALESCE(e.total_extras, 0) AS extra_dollars
FROM (          -- base prices for delivered orders
      SELECT o.order_id,
             CASE n.pizza_name
                  WHEN 'Meatlovers' THEN 12
                  WHEN 'Vegetarian' THEN 10
             END AS base_price
      FROM pizza_clean_customer_orders AS o
      JOIN pizza_names               AS n ON o.pizza_id = n.pizza_id
      JOIN pizza_clean_runner_orders AS r ON o.order_id = r.order_id
      WHERE r.cancellation IS NULL
     ) AS b
LEFT JOIN (     -- extras aggregated per order
      SELECT order_id,
             SUM(extras_count) AS total_extras
      FROM pizza_get_extras
      GROUP BY order_id
     ) AS e
ON b.order_id = e.order_id
LIMIT 20;
