```sql
-- 6. Work out the revenue per individual order (base price + $1 per extra)
SELECT cco."order_id",
       pn."pizza_name",
       CASE 
           WHEN pn."pizza_name" = 'Meatlovers'  THEN 12
           WHEN pn."pizza_name" = 'Vegetarian'  THEN 10
       END                                   AS "base_price",
       COALESCE(ge."total_extras", 0)        AS "extra_toppings",
       CASE 
           WHEN pn."pizza_name" = 'Meatlovers'  THEN 12
           WHEN pn."pizza_name" = 'Vegetarian'  THEN 10
       END
       + COALESCE(ge."total_extras", 0)      AS "order_revenue"
FROM   "pizza_clean_customer_orders" AS cco
JOIN   "pizza_names"                AS pn  ON pn."pizza_id" = cco."pizza_id"
JOIN   "pizza_clean_runner_orders"  AS cro ON cro."order_id" = cco."order_id"
LEFT JOIN (
        SELECT "order_id",
               SUM("extras_count") AS "total_extras"
        FROM   "pizza_get_extras"
        GROUP BY "order_id"
) AS ge  ON ge."order_id" = cco."order_id"
WHERE  cro."cancellation" IS NULL
LIMIT 20;
```

```sql
-- 7. FINAL ANSWER:  total money earned by Pizza Runner from all non-cancelled orders
