        SELECT "order_id",
               SUM("extras_count") AS "total_extras"
        FROM   "pizza_get_extras"
        GROUP BY "order_id"
) AS ge  ON ge."order_id" = cco."order_id"
WHERE  cro."cancellation" IS NULL;
```
