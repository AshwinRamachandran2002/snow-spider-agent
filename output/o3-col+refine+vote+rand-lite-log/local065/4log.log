```sql
-- Description: Inspect every order together with its delivery status 
SELECT DISTINCT
       cco.order_id,
       cco.customer_id,
       cr.cancellation
FROM pizza_customer_orders  AS cco
JOIN pizza_clean_runner_orders AS cr
  ON cco.order_id = cr.order_id
LIMIT 20;
```

```sql
-- Description:  Show only the orders that were successfully delivered (no cancellation)          
SELECT DISTINCT
       cco.order_id,
       cr.runner_id,
       cr.distance,
       cr.duration
FROM   pizza_customer_orders       AS cco
JOIN   pizza_clean_runner_orders   AS cr
  ON   cco.order_id = cr.order_id
WHERE  cr.cancellation IS NULL
LIMIT 20;
```

```sql
-- Description:  Bring in the pizza names for those successful orders               
SELECT DISTINCT
       cco.order_id,
       pn.pizza_name
FROM   pizza_customer_orders     AS cco
JOIN   pizza_clean_runner_orders AS cr
       ON cco.order_id = cr.order_id
JOIN   pizza_names               AS pn
       ON cco.pizza_id = pn.pizza_id
WHERE  cr.cancellation IS NULL
LIMIT 20;
```

```sql
-- Description:  Check how many extra-topping rows exist for every order           
SELECT DISTINCT
       order_id,
       SUM(extras_count) AS total_extras
FROM   pizza_get_extras
GROUP BY order_id
LIMIT 20;
```

```sql
-- Description:  Combine delivered orders with their pizza, add up extra toppings   
SELECT DISTINCT
       d.order_id,
       pn.pizza_name,
       COALESCE(e.total_extras,0) AS extras_cnt
FROM  (SELECT cco.order_id, cco.pizza_id
       FROM   pizza_customer_orders     AS cco
       JOIN   pizza_clean_runner_orders AS cr
              ON cco.order_id = cr.order_id
       WHERE  cr.cancellation IS NULL)  AS d
JOIN   pizza_names   AS pn  ON d.pizza_id = pn.pizza_id
LEFT JOIN
     (SELECT order_id,
             SUM(extras_count) AS total_extras
      FROM   pizza_get_extras
      GROUP  BY order_id)      AS e
  ON  d.order_id = e.order_id
LIMIT 20;
```

```sql
-- Description:  Final computation – attach price, add $1 per extra, sum all orders
SELECT
       SUM(base_price + COALESCE(extras_cnt,0)) AS total_income
FROM
     (SELECT 
             d.order_id,
             CASE 
                 WHEN pn.pizza_name = 'Meatlovers' THEN 12
                 WHEN pn.pizza_name = 'Vegetarian' THEN 10
             END AS base_price,
             COALESCE(e.total_extras,0) AS extras_cnt
      FROM   pizza_customer_orders     AS cco
      JOIN   pizza_clean_runner_orders AS cr
               ON cco.order_id = cr.order_id
      JOIN   pizza_names               AS pn
               ON cco.pizza_id = pn.pizza_id
      LEFT JOIN
           (SELECT order_id,
                   SUM(extras_count) AS total_extras
            FROM   pizza_get_extras
            GROUP  BY order_id)       AS e
          ON  cco.order_id = e.order_id
      WHERE  cr.cancellation IS NULL)  AS priced_orders;
```

