```sql
-- Description / Thinking process:
-- 1. Identify “delivered” orders – i.e., orders whose entry in pizza_clean_runner_orders
--    has cancellation IS NULL.
-- 2. For every delivered order, add up the base price of each pizza it contains:
--      • $12 for ‘Meatlovers’,  $10 for ‘Vegetarian’.
-- 3. Gather the number of extra toppings per order from pizza_get_extras
--    (each extra costs $1).
-- 4. For each order:  total_order_cost = pizza_total + extra_total.
-- 5. Sum total_order_cost across all delivered orders to obtain Pizza Runner’s revenue.
SELECT
    SUM(pizza_total + COALESCE(extra_total, 0)) AS total_income
FROM (
        -- Step-2: base price summed per delivered order
        SELECT
            o.order_id,
            SUM(
                CASE
                    WHEN pn.pizza_name = 'Meatlovers'  THEN 12
                    WHEN pn.pizza_name = 'Vegetarian' THEN 10
                    ELSE 0
                END
            ) AS pizza_total
        FROM   pizza_customer_orders     AS o
        JOIN   pizza_clean_runner_orders AS r
               ON  o.order_id = r.order_id
        JOIN   pizza_names               AS pn
               ON  o.pizza_id = pn.pizza_id
        WHERE  r.cancellation IS NULL
        GROUP  BY o.order_id
     ) AS per_order
LEFT JOIN (
        -- Step-3: extra toppings summed per order
        SELECT order_id,
               SUM(extras_count) AS extra_total
        FROM   pizza_get_extras
        GROUP  BY order_id
     ) AS e
USING (order_id);
```
