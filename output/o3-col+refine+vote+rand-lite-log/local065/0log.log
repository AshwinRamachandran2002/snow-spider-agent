FROM pizza_clean_runner_orders
LIMIT 20;
```

```sql
-- 3. Get every order that was successfully delivered (cancellation IS NULL)
SELECT DISTINCT order_id
FROM pizza_clean_runner_orders
WHERE cancellation IS NULL
LIMIT 20;
```

```sql
-- 4. See the customer–side orders for only those delivered order_ids
SELECT DISTINCT c.order_id,
       c.customer_id,
       c.pizza_id,
       c.extras
FROM pizza_clean_customer_orders AS c
JOIN pizza_clean_runner_orders  r
  ON c.order_id = r.order_id
WHERE r.cancellation IS NULL
LIMIT 20;
```

```sql
-- 5. Inspect the pre-parsed extras table to understand extras_count per order
SELECT DISTINCT order_id,
       extras,
       extras_count
FROM pizza_get_extras
LIMIT 20;
```

```sql
-- 6. Check how many extras each delivered order actually has
SELECT DISTINCT e.order_id,
       SUM(e.extras_count) AS total_extras
FROM pizza_get_extras       e
JOIN pizza_clean_runner_orders r
  ON e.order_id = r.order_id
WHERE r.cancellation IS NULL
GROUP BY e.order_id
LIMIT 20;
```

```sql
-- 7. Combine delivered orders with their extras, giving 0 when no extras
SELECT DISTINCT c.order_id,
       c.pizza_id,
       COALESCE(SUM(e.extras_count), 0) AS extras_cnt
FROM pizza_clean_customer_orders c
JOIN pizza_clean_runner_orders  r
  ON c.order_id = r.order_id
LEFT JOIN pizza_get_extras      e
  ON c.order_id = e.order_id
WHERE r.cancellation IS NULL
GROUP BY c.order_id, c.pizza_id
LIMIT 20;
```

```sql
-- 8. Put a price on every delivered order
SELECT o.order_id,
       CASE
           WHEN o.pizza_id = 1 THEN 12          -- Meat Lovers
           WHEN o.pizza_id = 2 THEN 10          -- Vegetarian
       END                          AS base_price,
       o.extras_cnt * 1             AS extras_price,
       CASE
           WHEN o.pizza_id = 1 THEN 12
           WHEN o.pizza_id = 2 THEN 10
       END + (o.extras_cnt * 1)     AS order_total
FROM (
    SELECT c.order_id,
           c.pizza_id,
           COALESCE(SUM(e.extras_count), 0) AS extras_cnt
    FROM pizza_clean_customer_orders c
    JOIN pizza_clean_runner_orders  r
      ON c.order_id = r.order_id
    LEFT JOIN pizza_get_extras      e
      ON c.order_id = e.order_id
    WHERE r.cancellation IS NULL
    GROUP BY c.order_id, c.pizza_id
) o
LIMIT 20;
```

```sql
-- 9. Finally, calculate the total revenue Pizza Runner has earned
SELECT ROUND(SUM(order_total), 2) AS total_revenue
FROM (
    SELECT
           CASE WHEN o.pizza_id = 1 THEN 12
                WHEN o.pizza_id = 2 THEN 10
           END + (o.extras_cnt * 1) AS order_total
    FROM (
        SELECT c.order_id,
               c.pizza_id,
               COALESCE(SUM(e.extras_count), 0) AS extras_cnt
        FROM pizza_clean_customer_orders c
        JOIN pizza_clean_runner_orders  r
          ON c.order_id = r.order_id
        LEFT JOIN pizza_get_extras      e
          ON c.order_id = e.order_id
        WHERE r.cancellation IS NULL
        GROUP BY c.order_id, c.pizza_id
    ) o
);
```

```sql
-- 10. Break-down: revenue coming from base pizzas vs. extra toppings
SELECT
       SUM(CASE WHEN p_id = 1 THEN base ELSE 0 END) AS meatlovers_base,
       SUM(CASE WHEN p_id = 2 THEN base ELSE 0 END) AS vegetarian_base,
       SUM(extras_amt)                               AS extras_revenue,
       SUM(base + extras_amt)                        AS total_revenue
FROM (
    SELECT o.pizza_id       AS p_id,
           CASE WHEN o.pizza_id = 1 THEN 12
                WHEN o.pizza_id = 2 THEN 10
           END                             AS base,
           o.extras_cnt * 1                AS extras_amt
    FROM (
        SELECT c.order_id,
               c.pizza_id,
               COALESCE(SUM(e.extras_count), 0) AS extras_cnt
        FROM pizza_clean_customer_orders c
        JOIN pizza_clean_runner_orders  r
          ON c.order_id = r.order_id
        LEFT JOIN pizza_get_extras      e
          ON c.order_id = e.order_id
        WHERE r.cancellation IS NULL
        GROUP BY c.order_id, c.pizza_id
    ) o
);
```

Running query 9 gives the grand total Pizza Runner has earned (base pizza prices plus $1 per extra topping) from all non-cancelled orders.
