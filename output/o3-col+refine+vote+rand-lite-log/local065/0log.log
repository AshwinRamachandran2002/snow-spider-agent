Query:
-- 8. Put a price on every delivered order
SELECT o.order_id,
       CASE
           WHEN o.pizza_id = 1 THEN 12          -- Meat Lovers
           WHEN o.pizza_id = 2 THEN 10          -- Vegetarian
       END                          AS base_price,
       o.extras_cnt * 1             AS extras_price,
       CASE
           WHEN o.pizza_id = 1 THEN 12
           WHEN o.pizza_id = 2 THEN 10
       END + (o.extras_cnt * 1)     AS order_total
FROM (
    SELECT c.order_id,
           c.pizza_id,
           COALESCE(SUM(e.extras_count), 0) AS extras_cnt
    FROM pizza_clean_customer_orders c
    JOIN pizza_clean_runner_orders  r
      ON c.order_id = r.order_id
    LEFT JOIN pizza_get_extras      e
      ON c.order_id = e.order_id
    WHERE r.cancellation IS NULL
    GROUP BY c.order_id, c.pizza_id
) o
LIMIT 20;
