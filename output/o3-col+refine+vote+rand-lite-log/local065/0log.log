-- 7. Combine delivered orders with their extras, giving 0 when no extras
SELECT DISTINCT c.order_id,
       c.pizza_id,
       COALESCE(SUM(e.extras_count), 0) AS extras_cnt
FROM pizza_clean_customer_orders c
JOIN pizza_clean_runner_orders  r
  ON c.order_id = r.order_id
LEFT JOIN pizza_get_extras      e
  ON c.order_id = e.order_id
WHERE r.cancellation IS NULL
GROUP BY c.order_id, c.pizza_id
LIMIT 20;
