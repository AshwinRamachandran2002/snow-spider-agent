```sql
--Description: 1) Peek at some 2018 taxi-trip records.  
SELECT *
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_start_timestamp BETWEEN '2018-01-01' AND '2018-12-31'
LIMIT 20;
```

```sql
--Description: 2) List a few distinct taxi companies that were active in 2018.  
SELECT DISTINCT company
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_start_timestamp BETWEEN '2018-01-01' AND '2018-12-31'
ORDER BY company
LIMIT 20;
```

```sql
--Description: 3) Show the 2018 trip counts for the 20 busiest companies.  
SELECT company,
       COUNT(*) AS trips_2018
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_start_timestamp BETWEEN '2018-01-01' AND '2018-12-31'
GROUP BY company
ORDER BY trips_2018 DESC
LIMIT 20;
```

```sql
--Description: 4) Overall month-to-month trip totals in 2018 (all companies together).  
SELECT FORMAT_TIMESTAMP('%Y-%m', trip_start_timestamp) AS month,
       COUNT(*) AS total_trips
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_start_timestamp BETWEEN '2018-01-01' AND '2018-12-31'
GROUP BY month
ORDER BY month
LIMIT 20;
```

```sql
--Description: 5) Monthly trip counts in 2018 for a sample of companies beginning with “C”.  
SELECT company,
       FORMAT_TIMESTAMP('%Y-%m', trip_start_timestamp) AS month,
       COUNT(*) AS trips
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_start_timestamp BETWEEN '2018-01-01' AND '2018-12-31'
  AND company LIKE 'C%'
GROUP BY company, month
ORDER BY company, month
LIMIT 20;
```

```sql
--Description: 6) Compute the month-to-month change for one example company (“Yellow Cab”).  
WITH m AS (
  SELECT FORMAT_TIMESTAMP('%Y-%m', trip_start_timestamp) AS month,
         COUNT(*) AS trips
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_start_timestamp BETWEEN '2018-01-01' AND '2018-12-31'
    AND company = 'Yellow Cab'
  GROUP BY month
)
SELECT month,
       trips,
       trips - LAG(trips) OVER (ORDER BY month) AS diff_from_prev_month
FROM m
ORDER BY month
LIMIT 20;
```

```sql
--Description: 7) For every company/month pair, get the month-to-month difference.  
WITH by_mon AS (
  SELECT company,
         FORMAT_TIMESTAMP('%Y-%m', trip_start_timestamp) AS month,
         COUNT(*) AS trips
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_start_timestamp BETWEEN '2018-01-01' AND '2018-12-31'
  GROUP BY company, month
)
SELECT company,
       month,
       trips,
       trips - LAG(trips) OVER (PARTITION BY company ORDER BY month) AS diff
FROM by_mon
ORDER BY company, month
LIMIT 20;
```

```sql
--Description: 8) Keep only positive increases and order the biggest 20 rises seen in 2018.  
WITH by_mon AS (
  SELECT company,
         FORMAT_TIMESTAMP('%Y-%m', trip_start_timestamp) AS month,
         COUNT(*) AS trips
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_start_timestamp BETWEEN '2018-01-01' AND '2018-12-31'
  GROUP BY company, month
), deltas AS (
  SELECT company,
         month,
         trips - LAG(trips) OVER (PARTITION BY company ORDER BY month) AS diff
  FROM by_mon
)
SELECT company, month, diff
FROM deltas
WHERE diff > 0
ORDER BY diff DESC
LIMIT 20;
```

```sql
--Description: 9) For each company, find its single largest positive month-to-month increase in 2018.  
WITH by_mon AS (
  SELECT company,
         FORMAT_TIMESTAMP('%Y-%m', trip_start_timestamp) AS month,
         COUNT(*) AS trips
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_start_timestamp BETWEEN '2018-01-01' AND '2018-12-31'
  GROUP BY company, month
), deltas AS (
  SELECT company,
         trips - LAG(trips) OVER (PARTITION BY company ORDER BY month) AS diff
  FROM by_mon
)
SELECT company,
       MAX(diff) AS max_positive_diff
FROM deltas
GROUP BY company
HAVING max_positive_diff IS NOT NULL
ORDER BY max_positive_diff DESC
LIMIT 20;
```

```sql
--Description: 10) FINAL – the three companies that recorded the largest month-to-month jump in trips during 2018.  
WITH by_mon AS (
  SELECT company,
         FORMAT_TIMESTAMP('%Y-%m', trip_start_timestamp) AS month,
         COUNT(*) AS trips
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_start_timestamp BETWEEN '2018-01-01' AND '2018-12-31'
  GROUP BY company, month
), deltas AS (
  SELECT company,
         trips - LAG(trips) OVER (PARTITION BY company ORDER BY month) AS diff
  FROM by_mon
), max_jump AS (
  SELECT company,
         MAX(diff) AS max_positive_diff
  FROM deltas
  GROUP BY company
)
SELECT company,
       max_positive_diff AS largest_monthly_increase_2018
FROM max_jump
ORDER BY largest_monthly_increase_2018 DESC
LIMIT 3;
```
