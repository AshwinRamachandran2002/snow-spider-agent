Query:
--Description: 10) FINAL – the three companies that recorded the largest month-to-month jump in trips during 2018.  
WITH by_mon AS (
  SELECT company,
         FORMAT_TIMESTAMP('%Y-%m', trip_start_timestamp) AS month,
         COUNT(*) AS trips
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_start_timestamp BETWEEN '2018-01-01' AND '2018-12-31'
  GROUP BY company, month
), deltas AS (
  SELECT company,
         trips - LAG(trips) OVER (PARTITION BY company ORDER BY month) AS diff
  FROM by_mon
), max_jump AS (
  SELECT company,
         MAX(diff) AS max_positive_diff
  FROM deltas
  GROUP BY company
)
SELECT company,
       max_positive_diff AS largest_monthly_increase_2018
FROM max_jump
ORDER BY largest_monthly_increase_2018 DESC
LIMIT 3;
Answer:
company,largest_monthly_increase_2018
Flash Cab,55724
Taxi Affiliation Services,45265
Chicago Carriage Cab Corp,42515
