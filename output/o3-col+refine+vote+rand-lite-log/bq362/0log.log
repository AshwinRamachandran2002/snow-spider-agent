Query:
--Description: 9) For each company, find its single largest positive month-to-month increase in 2018.  
WITH by_mon AS (
  SELECT company,
         FORMAT_TIMESTAMP('%Y-%m', trip_start_timestamp) AS month,
         COUNT(*) AS trips
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_start_timestamp BETWEEN '2018-01-01' AND '2018-12-31'
  GROUP BY company, month
), deltas AS (
  SELECT company,
         trips - LAG(trips) OVER (PARTITION BY company ORDER BY month) AS diff
  FROM by_mon
)
SELECT company,
       MAX(diff) AS max_positive_diff
FROM deltas
GROUP BY company
HAVING max_positive_diff IS NOT NULL
ORDER BY max_positive_diff DESC
LIMIT 20;
