Query:
--Description: 8) Keep only positive increases and order the biggest 20 rises seen in 2018.  
WITH by_mon AS (
  SELECT company,
         FORMAT_TIMESTAMP('%Y-%m', trip_start_timestamp) AS month,
         COUNT(*) AS trips
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_start_timestamp BETWEEN '2018-01-01' AND '2018-12-31'
  GROUP BY company, month
), deltas AS (
  SELECT company,
         month,
         trips - LAG(trips) OVER (PARTITION BY company ORDER BY month) AS diff
  FROM by_mon
)
SELECT company, month, diff
FROM deltas
WHERE diff > 0
ORDER BY diff DESC
LIMIT 20;
