```

```sql
-- 2. Peek at a few 2018 trips to see the columns we need
SELECT `unique_key`, `trip_start_timestamp`, `company`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE EXTRACT(YEAR FROM `trip_start_timestamp`) = 2018
LIMIT 20;
```

```sql
-- 3. Show a sample of distinct company names that appear in the data
SELECT DISTINCT `company`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `company` IS NOT NULL
ORDER BY `company`
LIMIT 20;
```

```sql
-- 4. Count 2018 trips per company (overall) to understand size
SELECT `company`, COUNT(*) AS trip_count
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE EXTRACT(YEAR FROM `trip_start_timestamp`) = 2018
GROUP BY `company`
ORDER BY trip_count DESC
LIMIT 20;
```

```sql
-- 5. Monthly 2018 trip counts per company (first 20 rows)
SELECT 
  `company`,
  EXTRACT(MONTH FROM `trip_start_timestamp`) AS month,
  COUNT(*) AS trip_count
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE EXTRACT(YEAR FROM `trip_start_timestamp`) = 2018
GROUP BY `company`, month
ORDER BY `company`, month
LIMIT 20;
```

```sql
-- 6. Compute month-over-month difference for each company (top 20 by biggest jump)
SELECT 
  company,
  month,
  trip_count,
  LAG(trip_count) OVER (PARTITION BY company ORDER BY month) AS prev_month_trips,
  trip_count - LAG(trip_count) OVER (PARTITION BY company ORDER BY month) AS diff
FROM (
  SELECT 
    `company`,
    EXTRACT(MONTH FROM `trip_start_timestamp`) AS month,
    COUNT(*) AS trip_count
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE EXTRACT(YEAR FROM `trip_start_timestamp`) = 2018
  GROUP BY `company`, month
)
ORDER BY diff DESC
LIMIT 20;
```

```sql
-- 7. Same as (6) but keep only positive jumps (top 20)
SELECT company, month, diff
FROM (
  SELECT 
    company,
    month,
    trip_count,
    LAG(trip_count) OVER (PARTITION BY company ORDER BY month) AS prev_month_trips,
    trip_count - LAG(trip_count) OVER (PARTITION BY company ORDER BY month) AS diff
  FROM (
    SELECT 
      `company`,
      EXTRACT(MONTH FROM `trip_start_timestamp`) AS month,
      COUNT(*) AS trip_count
    FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
    WHERE EXTRACT(YEAR FROM `trip_start_timestamp`) = 2018
    GROUP BY `company`, month
  )
)
WHERE diff > 0
ORDER BY diff DESC
LIMIT 20;
```

```sql
-- 8. For every company, keep its single largest monthly increase in 2018
SELECT 
  company,
  MAX(diff) AS max_monthly_increase
FROM (
  SELECT 
    company,
    month,
    trip_count - LAG(trip_count) OVER (PARTITION BY company ORDER BY month) AS diff
  FROM (
    SELECT 
      `company`,
      EXTRACT(MONTH FROM `trip_start_timestamp`) AS month,
      COUNT(*) AS trip_count
    FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
    WHERE EXTRACT(YEAR FROM `trip_start_timestamp`) = 2018
    GROUP BY `company`, month
  )
)
GROUP BY company
ORDER BY max_monthly_increase DESC
LIMIT 20;
```

```sql
-- 9. FINAL ANSWER: the three companies with the largest single-month jump in 2018
SELECT 
  company,
  max_monthly_increase
FROM (
  SELECT 
    company,
    MAX(diff) AS max_monthly_increase
  FROM (
    SELECT 
      company,
      month,
      trip_count - LAG(trip_count) OVER (PARTITION BY company ORDER BY month) AS diff
    FROM (
      SELECT 
        `company`,
        EXTRACT(MONTH FROM `trip_start_timestamp`) AS month,
        COUNT(*) AS trip_count
      FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
      WHERE EXTRACT(YEAR FROM `trip_start_timestamp`) = 2018
      GROUP BY `company`, month
    )
  )
  GROUP BY company
)
ORDER BY max_monthly_increase DESC
LIMIT 3;
```
