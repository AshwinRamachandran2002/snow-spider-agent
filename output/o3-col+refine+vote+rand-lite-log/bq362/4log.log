```sql
-- 1. List all years present in the trips table to be sure 2018 exists
SELECT DISTINCT EXTRACT(YEAR FROM `trip_start_timestamp`) AS year
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
ORDER BY year
