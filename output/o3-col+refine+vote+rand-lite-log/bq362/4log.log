Query:
-- 6. Compute month-over-month difference for each company (top 20 by biggest jump)
SELECT 
  company,
  month,
  trip_count,
  LAG(trip_count) OVER (PARTITION BY company ORDER BY month) AS prev_month_trips,
  trip_count - LAG(trip_count) OVER (PARTITION BY company ORDER BY month) AS diff
FROM (
  SELECT 
    `company`,
    EXTRACT(MONTH FROM `trip_start_timestamp`) AS month,
    COUNT(*) AS trip_count
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE EXTRACT(YEAR FROM `trip_start_timestamp`) = 2018
  GROUP BY `company`, month
)
ORDER BY diff DESC
LIMIT 20;
