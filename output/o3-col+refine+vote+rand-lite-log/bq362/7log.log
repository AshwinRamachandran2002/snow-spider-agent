```sql
--Description: Get a quick look at the taxi-trip columns and data.
SELECT *
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT 20;
```

```sql
--Description: See which years are present in the data.
SELECT DISTINCT EXTRACT(YEAR FROM trip_start_timestamp) AS trip_year
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
ORDER BY trip_year
LIMIT 20;
```

```sql
--Description: List some distinct company names.
SELECT DISTINCT company
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE company IS NOT NULL
LIMIT 20;
```

```sql
--Description: Count January-2018 trips by company (top 20 counts).
SELECT company,
       COUNT(*) AS jan_trips
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE EXTRACT(YEAR  FROM trip_start_timestamp)=2018
  AND EXTRACT(MONTH FROM trip_start_timestamp)=1
GROUP BY company
ORDER BY jan_trips DESC
LIMIT 20;
```

```sql
--Description: Monthly trip counts for every company in 2018.
SELECT company,
       EXTRACT(MONTH FROM trip_start_timestamp) AS month,
       COUNT(*) AS trip_cnt
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE EXTRACT(YEAR FROM trip_start_timestamp)=2018
GROUP BY company, month
ORDER BY company, month
LIMIT 20;
```

```sql
--Description: Add the difference from the previous month for each company.
SELECT company,
       month,
       trip_cnt,
       trip_cnt - LAG(trip_cnt) OVER (PARTITION BY company ORDER BY month) AS diff_from_prev_month
FROM (
  SELECT company,
         EXTRACT(MONTH FROM trip_start_timestamp) AS month,
         COUNT(*) AS trip_cnt
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE EXTRACT(YEAR FROM trip_start_timestamp)=2018
  GROUP BY company, month
)
ORDER BY diff_from_prev_month DESC
LIMIT 20;
```

```sql
--Description: Show only increases (>0) and rank the largest month-to-month jumps.
SELECT company,
       month,
       diff_from_prev_month
FROM (
  SELECT company,
         month,
         trip_cnt - LAG(trip_cnt) OVER (PARTITION BY company ORDER BY month) AS diff_from_prev_month
  FROM (
    SELECT company,
           EXTRACT(MONTH FROM trip_start_timestamp) AS month,
           COUNT(*) AS trip_cnt
    FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
    WHERE EXTRACT(YEAR FROM trip_start_timestamp)=2018
    GROUP BY company, month
  )
)
WHERE diff_from_prev_month > 0
ORDER BY diff_from_prev_month DESC
LIMIT 20;
```

```sql
--Description: For each company, find its single biggest month-to-month increase in 2018.
SELECT company,
       MAX(diff_from_prev_month) AS max_increase
FROM (
  SELECT company,
         trip_cnt - LAG(trip_cnt) OVER (PARTITION BY company ORDER BY month) AS diff_from_prev_month
  FROM (
    SELECT company,
           EXTRACT(MONTH FROM trip_start_timestamp) AS month,
           COUNT(*) AS trip_cnt
    FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
    WHERE EXTRACT(YEAR FROM trip_start_timestamp)=2018
    GROUP BY company, month
  )
)
WHERE diff_from_prev_month IS NOT NULL
GROUP BY company
ORDER BY max_increase DESC
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – the three companies with the largest increase in trip
--             numbers between any two consecutive months in 2018.
SELECT company,
       max_increase
FROM (
  SELECT company,
         MAX(diff_from_prev_month) AS max_increase
  FROM (
    SELECT company,
           trip_cnt - LAG(trip_cnt) OVER (PARTITION BY company ORDER BY month) AS diff_from_prev_month
    FROM (
      SELECT company,
             EXTRACT(MONTH FROM trip_start_timestamp) AS month,
             COUNT(*) AS trip_cnt
      FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
      WHERE EXTRACT(YEAR FROM trip_start_timestamp)=2018
      GROUP BY company, month
    )
  )
  WHERE diff_from_prev_month IS NOT NULL
  GROUP BY company
)
ORDER BY max_increase DESC
LIMIT 3;
```

The final query returns the three taxi companies that experienced the biggest jump in trip counts between any two consecutive months during 2018.
