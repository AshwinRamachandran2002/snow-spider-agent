```sql
-- 1) Inspect the list of U.S. state abbreviations that appear in any congressional term
SELECT DISTINCT state
FROM legislators_terms
LIMIT 20;
```

```sql
-- 2) Check the gender codes recorded for legislators
SELECT DISTINCT gender
FROM legislators
LIMIT 20;
```

```sql
-- 3) Look at a sample of term start / end dates to understand the date format
SELECT id_bioguide,
       term_number,
       term_start,
       term_end,
       state,
       party
FROM legislators_terms
ORDER BY term_start
LIMIT 20;
```

```sql
-- 4) Determine each legislator’s first-ever term start date and the state in which it occurred
SELECT lt.id_bioguide,
       MIN(lt.term_start) AS first_start,
       MIN(lt.state)      AS first_state
FROM legislators_terms AS lt
GROUP BY lt.id_bioguide
LIMIT 20;
```

```sql
-- 5) Combine the first-term information with gender so we know the cohort size at “time 0”
WITH first_term AS (
  SELECT lt.id_bioguide,
         MIN(lt.term_start) AS first_start,
         MIN(lt.state)      AS state
  FROM legislators_terms AS lt
  GROUP BY lt.id_bioguide
)
SELECT ft.id_bioguide,
       ft.state,
       substr(ft.first_start,1,4) AS start_year,
       l.gender
FROM first_term  AS ft
JOIN legislators AS l USING (id_bioguide)
LIMIT 20;
```

```sql
-- 6) Example: count how many of those cohort members are still serving
-- on 31 Dec of the 2-year mark after they first entered Congress
WITH offsets(o) AS (VALUES (2)),
first_term AS (
  SELECT lt.id_bioguide,
         MIN(lt.term_start) AS first_start,
         MIN(lt.state)      AS state
  FROM legislators_terms AS lt
  GROUP BY lt.id_bioguide
),
cohort AS (
  SELECT ft.*,
         CAST(substr(ft.first_start,1,4) AS INTEGER) AS start_year
  FROM first_term AS ft
),
genders AS (
  SELECT id_bioguide, gender
  FROM legislators
  WHERE gender IN ('M','F')
)
SELECT c.state,
       g.gender,
       COUNT(*) AS retained_after_2_years
FROM cohort  AS c
JOIN genders AS g       USING(id_bioguide)
JOIN legislators_terms AS lt
     ON lt.id_bioguide = c.id_bioguide
    AND lt.term_start <= printf('%04d-12-31', c.start_year + 2)
    AND lt.term_end   >= printf('%04d-12-31', c.start_year + 2)
GROUP BY c.state, g.gender
ORDER BY retained_after_2_years DESC
LIMIT 20;
```

```sql
-- 7) Produce retention counts for EVERY required offset (0,2,4,6,8,10)
WITH offsets(o) AS (VALUES (0),(2),(4),(6),(8),(10)),
first_term AS (
  SELECT lt.id_bioguide,
         MIN(lt.term_start) AS first_start,
         MIN(lt.state)      AS state
  FROM legislators_terms AS lt
  GROUP BY lt.id_bioguide
),
cohort AS (
  SELECT ft.*,
         CAST(substr(ft.first_start,1,4) AS INTEGER) AS start_year
  FROM first_term AS ft
),
genders AS (
  SELECT id_bioguide, gender
  FROM legislators
  WHERE gender IN ('M','F')
)
SELECT c.state,
       g.gender,
       o.o          AS offset_years,
       COUNT(*)     AS retained_cnt
FROM cohort AS c
JOIN genders AS g       USING(id_bioguide)
CROSS JOIN offsets AS o
JOIN legislators_terms AS lt
     ON lt.id_bioguide = c.id_bioguide
    AND lt.term_start <= printf('%04d-12-31', c.start_year + o.o)
    AND lt.term_end   >= printf('%04d-12-31', c.start_year + o.o)
GROUP BY c.state, g.gender, o.o
ORDER BY c.state, g.gender, o.o
LIMIT 20;
```

```sql
-- 8) For each state & gender, keep the MINIMUM retained_cnt across the six checkpoints
WITH offsets(o) AS (VALUES (0),(2),(4),(6),(8),(10)),
first_term AS (
  SELECT lt.id_bioguide,
         MIN(lt.term_start) AS first_start,
         MIN(lt.state)      AS state
  FROM legislators_terms AS lt
  GROUP BY lt.id_bioguide
),
cohort AS (
  SELECT ft.*,
         CAST(substr(ft.first_start,1,4) AS INTEGER) AS start_year
  FROM first_term AS ft
),
genders AS (
  SELECT id_bioguide, gender
  FROM legislators
  WHERE gender IN ('M','F')
),
retention AS (
  SELECT c.state,
         g.gender,
         o.o AS offset_years,
         COUNT(*) AS retained_cnt
  FROM cohort AS c
  JOIN genders AS g       USING(id_bioguide)
  CROSS JOIN offsets AS o
  JOIN legislators_terms AS lt
       ON lt.id_bioguide = c.id_bioguide
      AND lt.term_start <= printf('%04d-12-31', c.start_year + o.o)
      AND lt.term_end   >= printf('%04d-12-31', c.start_year + o.o)
  GROUP BY c.state, g.gender, o.o
)
SELECT state,
       gender,
       MIN(retained_cnt) AS min_retained_any_year
FROM retention
GROUP BY state, gender
LIMIT 20;
```

```sql
-- 9) States where BOTH male and female legislators never go to zero at any checkpoint
WITH offsets(o) AS (VALUES (0),(2),(4),(6),(8),(10)),
first_term AS (
  SELECT lt.id_bioguide,
         MIN(lt.term_start) AS first_start,
         MIN(lt.state)      AS state
  FROM legislators_terms AS lt
  GROUP BY lt.id_bioguide
),
cohort AS (
  SELECT ft.*,
         CAST(substr(ft.first_start,1,4) AS INTEGER) AS start_year
  FROM first_term AS ft
),
genders AS (
  SELECT id_bioguide, gender
  FROM legislators
  WHERE gender IN ('M','F')
),
retention AS (
  SELECT c.state,
         g.gender,
         o.o AS offset_years,
         COUNT(*) AS retained_cnt
  FROM cohort AS c
  JOIN genders AS g       USING(id_bioguide)
  CROSS JOIN offsets AS o
  JOIN legislators_terms AS lt
       ON lt.id_bioguide = c.id_bioguide
      AND lt.term_start <= printf('%04d-12-31', c.start_year + o.o)
      AND lt.term_end   >= printf('%04d-12-31', c.start_year + o.o)
  GROUP BY c.state, g.gender, o.o
),
min_by_gender AS (
  SELECT state,
         gender,
         MIN(retained_cnt) AS min_ret
  FROM retention
  GROUP BY state, gender
)
SELECT DISTINCT g1.state
FROM min_by_gender AS g1
JOIN min_by_gender AS g2
  ON g1.state = g2.state
 WHERE g1.gender = 'M'
   AND g2.gender = 'F'
   AND g1.min_ret > 0
   AND g2.min_ret > 0
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER – all state abbreviations meeting the requirement
WITH offsets(o) AS (VALUES (0),(2),(4),(6),(8),(10)),
first_term AS (
  SELECT lt.id_bioguide,
         MIN(lt.term_start) AS first_start,
         MIN(lt.state)      AS state
  FROM legislators_terms AS lt
  GROUP BY lt.id_bioguide
),
cohort AS (
  SELECT ft.*,
         CAST(substr(ft.first_start,1,4) AS INTEGER) AS start_year
  FROM first_term AS ft
),
genders AS (
  SELECT id_bioguide, gender
  FROM legislators
  WHERE gender IN ('M','F')
),
retention AS (
  SELECT c.state,
         g.gender,
         o.o AS offset_years,
         COUNT(*) AS retained_cnt
  FROM cohort AS c
  JOIN genders AS g       USING(id_bioguide)
  CROSS JOIN offsets AS o
  JOIN legislators_terms AS lt
       ON lt.id_bioguide = c.id_bioguide
      AND lt.term_start <= printf('%04d-12-31', c.start_year + o.o)
      AND lt.term_end   >= printf('%04d-12-31', c.start_year + o.o)
  GROUP BY c.state, g.gender, o.o
),
min_by_gender AS (
  SELECT state,
         gender,
         MIN(retained_cnt) AS min_ret
  FROM retention
  GROUP BY state, gender
),
states_passing AS (
  SELECT g1.state
  FROM min_by_gender AS g1
  JOIN min_by_gender AS g2
    ON g1.state = g2.state
   AND g1.gender = 'M'
   AND g2.gender = 'F'
  WHERE g1.min_ret > 0
    AND g2.min_ret > 0
)
SELECT DISTINCT state
FROM states_passing
ORDER BY state
LIMIT 20;
```
