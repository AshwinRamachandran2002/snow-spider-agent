-- 4) Determine each legislator’s first-ever term start date and the state in which it occurred
SELECT lt.id_bioguide,
       MIN(lt.term_start) AS first_start,
       MIN(lt.state)      AS first_state
FROM legislators_terms AS lt
GROUP BY lt.id_bioguide
LIMIT 20;
