Query:
-- 5) Combine the first-term information with gender so we know the cohort size at “time 0”
WITH first_term AS (
  SELECT lt.id_bioguide,
         MIN(lt.term_start) AS first_start,
         MIN(lt.state)      AS state
  FROM legislators_terms AS lt
  GROUP BY lt.id_bioguide
)
SELECT ft.id_bioguide,
       ft.state,
       substr(ft.first_start,1,4) AS start_year,
       l.gender
FROM first_term  AS ft
JOIN legislators AS l USING (id_bioguide)
LIMIT 20;
