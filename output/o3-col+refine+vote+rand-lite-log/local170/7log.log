Query:
-- 9) States where BOTH male and female legislators never go to zero at any checkpoint
WITH offsets(o) AS (VALUES (0),(2),(4),(6),(8),(10)),
first_term AS (
  SELECT lt.id_bioguide,
         MIN(lt.term_start) AS first_start,
         MIN(lt.state)      AS state
  FROM legislators_terms AS lt
  GROUP BY lt.id_bioguide
),
cohort AS (
  SELECT ft.*,
         CAST(substr(ft.first_start,1,4) AS INTEGER) AS start_year
  FROM first_term AS ft
),
genders AS (
  SELECT id_bioguide, gender
  FROM legislators
  WHERE gender IN ('M','F')
),
retention AS (
  SELECT c.state,
         g.gender,
         o.o AS offset_years,
         COUNT(*) AS retained_cnt
  FROM cohort AS c
  JOIN genders AS g       USING(id_bioguide)
  CROSS JOIN offsets AS o
  JOIN legislators_terms AS lt
       ON lt.id_bioguide = c.id_bioguide
      AND lt.term_start <= printf('%04d-12-31', c.start_year + o.o)
      AND lt.term_end   >= printf('%04d-12-31', c.start_year + o.o)
  GROUP BY c.state, g.gender, o.o
),
min_by_gender AS (
  SELECT state,
         gender,
         MIN(retained_cnt) AS min_ret
  FROM retention
  GROUP BY state, gender
)
SELECT DISTINCT g1.state
FROM min_by_gender AS g1
JOIN min_by_gender AS g2
  ON g1.state = g2.state
 WHERE g1.gender = 'M'
   AND g2.gender = 'F'
   AND g1.min_ret > 0
   AND g2.min_ret > 0
LIMIT 20;
