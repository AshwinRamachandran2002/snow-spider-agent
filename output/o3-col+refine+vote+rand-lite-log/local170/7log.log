Query:
-- 6) Example: count how many of those cohort members are still serving
-- on 31 Dec of the 2-year mark after they first entered Congress
WITH offsets(o) AS (VALUES (2)),
first_term AS (
  SELECT lt.id_bioguide,
         MIN(lt.term_start) AS first_start,
         MIN(lt.state)      AS state
  FROM legislators_terms AS lt
  GROUP BY lt.id_bioguide
),
cohort AS (
  SELECT ft.*,
         CAST(substr(ft.first_start,1,4) AS INTEGER) AS start_year
  FROM first_term AS ft
),
genders AS (
  SELECT id_bioguide, gender
  FROM legislators
  WHERE gender IN ('M','F')
)
SELECT c.state,
       g.gender,
       COUNT(*) AS retained_after_2_years
FROM cohort  AS c
JOIN genders AS g       USING(id_bioguide)
JOIN legislators_terms AS lt
     ON lt.id_bioguide = c.id_bioguide
    AND lt.term_start <= printf('%04d-12-31', c.start_year + 2)
    AND lt.term_end   >= printf('%04d-12-31', c.start_year + 2)
GROUP BY c.state, g.gender
ORDER BY retained_after_2_years DESC
LIMIT 20;
