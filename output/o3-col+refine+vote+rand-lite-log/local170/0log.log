LIMIT  20;
```

```sql
-- 8. For every legislator, test whether they are still in office
--    on Dec-31 at 0,2,4,6,8,10 years after their first start.  
WITH first_term AS (
    SELECT  l."id_bioguide",
            l."gender",
            MIN(lt."term_start") AS "first_start"
    FROM    "legislators"       AS l
    JOIN    "legislators_terms" AS lt
           ON l."id_bioguide" = lt."id_bioguide"
    GROUP   BY l."id_bioguide"
),
targets AS (
    SELECT  ft.*,
            CAST(strftime('%Y', ft."first_start") AS INTEGER) AS y0,
            CAST(strftime('%Y', ft."first_start") AS INTEGER)+2 AS y2,
            CAST(strftime('%Y', ft."first_start") AS INTEGER)+4 AS y4,
            CAST(strftime('%Y', ft."first_start") AS INTEGER)+6 AS y6,
            CAST(strftime('%Y', ft."first_start") AS INTEGER)+8 AS y8,
            CAST(strftime('%Y', ft."first_start") AS INTEGER)+10 AS y10
    FROM    first_term AS ft
),
retention AS (
    SELECT  t."id_bioguide",
            t."gender",
            lt."state",
            MAX(CASE WHEN date(t.y0  || '-12-31') BETWEEN lt."term_start" AND lt."term_end" THEN 1 ELSE 0 END) AS r0,
            MAX(CASE WHEN date(t.y2  || '-12-31') BETWEEN lt."term_start" AND lt."term_end" THEN 1 ELSE 0 END) AS r2,
            MAX(CASE WHEN date(t.y4  || '-12-31') BETWEEN lt."term_start" AND lt."term_end" THEN 1 ELSE 0 END) AS r4,
            MAX(CASE WHEN date(t.y6  || '-12-31') BETWEEN lt."term_start" AND lt."term_end" THEN 1 ELSE 0 END) AS r6,
            MAX(CASE WHEN date(t.y8  || '-12-31') BETWEEN lt."term_start" AND lt."term_end" THEN 1 ELSE 0 END) AS r8,
            MAX(CASE WHEN date(t.y10 || '-12-31') BETWEEN lt."term_start" AND lt."term_end" THEN 1 ELSE 0 END) AS r10
    FROM    targets            AS t
    JOIN    "legislators_terms" AS lt
           ON lt."id_bioguide" = t."id_bioguide"
    GROUP   BY t."id_bioguide"
)
SELECT *
FROM   retention
LIMIT  20;
```

```sql
-- 9. Count, by state & gender, how many legislators stay for all 6 checkpoints.  
WITH first_term AS (
    SELECT  l."id_bioguide",
            l."gender",
            MIN(lt."term_start") AS "first_start"
    FROM    "legislators"       AS l
    JOIN    "legislators_terms" AS lt
           ON l."id_bioguide" = lt."id_bioguide"
    GROUP   BY l."id_bioguide"
),
targets AS (
    SELECT  ft.*,
            CAST(strftime('%Y', ft."first_start") AS INTEGER) AS y0,
            CAST(strftime('%Y', ft."first_start") AS INTEGER)+2 AS y2,
            CAST(strftime('%Y', ft."first_start") AS INTEGER)+4 AS y4,
            CAST(strftime('%Y', ft."first_start") AS INTEGER)+6 AS y6,
            CAST(strftime('%Y', ft."first_start") AS INTEGER)+8 AS y8,
            CAST(strftime('%Y', ft."first_start") AS INTEGER)+10 AS y10
    FROM    first_term AS ft
),
retention AS (
    SELECT  t."id_bioguide",
            t."gender",
            lt."state",
            MAX(CASE WHEN date(t.y0  || '-12-31') BETWEEN lt."term_start" AND lt."term_end" THEN 1 ELSE 0 END) AS r0,
            MAX(CASE WHEN date(t.y2  || '-12-31') BETWEEN lt."term_start" AND lt."term_end" THEN 1 ELSE 0 END) AS r2,
            MAX(CASE WHEN date(t.y4  || '-12-31') BETWEEN lt."term_start" AND lt."term_end" THEN 1 ELSE 0 END) AS r4,
            MAX(CASE WHEN date(t.y6  || '-12-31') BETWEEN lt."term_start" AND lt."term_end" THEN 1 ELSE 0 END) AS r6,
            MAX(CASE WHEN date(t.y8  || '-12-31') BETWEEN lt."term_start" AND lt."term_end" THEN 1 ELSE 0 END) AS r8,
            MAX(CASE WHEN date(t.y10 || '-12-31') BETWEEN lt."term_start" AND lt."term_end" THEN 1 ELSE 0 END) AS r10
    FROM    targets            AS t
    JOIN    "legislators_terms" AS lt
           ON lt."id_bioguide" = t."id_bioguide"
    GROUP   BY t."id_bioguide", lt."state"
),
fully_retained AS (
    SELECT  "state",
            "gender",
            COUNT(*) AS keepers
    FROM    retention
    WHERE   r0  = 1
      AND   r2  = 1
      AND   r4  = 1
      AND   r6  = 1
      AND   r8  = 1
      AND   r10 = 1
    GROUP   BY "state", "gender"
)
SELECT  fr1."state"
FROM    fully_retained AS fr1
JOIN    fully_retained AS fr2
       ON fr1."state"  = fr2."state"
      AND fr1."gender" = 'M'
      AND fr2."gender" = 'F'
GROUP BY fr1."state";
```

These nine queries progressively explore the relevant columns, build the retention tests, and finally produce the list of state abbreviations that satisfy the requirement that both male and female cohorts have non-zero retention at every 0-, 2-, 4-, 6-, 8- and 10-year checkpoint after the first term start date.
