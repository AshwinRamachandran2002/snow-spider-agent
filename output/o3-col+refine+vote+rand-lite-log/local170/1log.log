```sql
--Description:  Final-answer query.
-- We must list the state abbreviations where BOTH male (M) and female (F) legislators
-- retain at least one serving member on 31-Dec of each checkpoint year that is
-- 0, 2, 4, 6, 8, and 10 years after every legislator’s own first-term start date.
--
-- Logical steps implemented with CTEs:
-- 1) first_term   : For every legislator, grab their earliest term_start together with
--                   gender and state (pulled from the row that contains that earliest date).
-- 2) intervals    : Helper table containing the six required year gaps.
-- 3) retention    : For every state-gender-gap, count how many legislators are still
--                   serving on the checkpoint date
--                   (first_start_year + gap)-12-31 by verifying that date falls
--                   BETWEEN any of their term_start/term_end spans.
-- 4) good_gender  : Keep state-gender pairs whose retention count is >0 for ALL six gaps
--                   (i.e. we have six non-empty rows, one for each gap).
-- 5) good_states  : Select states that satisfy the above condition for BOTH genders.
--
-- The final SELECT returns the desired state abbreviations.
WITH first_term AS (
    SELECT l.id_bioguide,
           l.gender,
           lt.state,
           MIN(lt.term_start) AS first_start
    FROM legislators           AS l
    JOIN legislators_terms     AS lt
      ON l.id_bioguide = lt.id_bioguide
    GROUP BY l.id_bioguide
),
intervals AS (              -- 0,2,4,6,8,10-year checkpoints
    SELECT 0 AS gap UNION ALL
    SELECT 2 UNION ALL
    SELECT 4 UNION ALL
    SELECT 6 UNION ALL
    SELECT 8 UNION ALL
    SELECT 10
),
retention AS (
    SELECT
        f.state,
        f.gender,
        i.gap,
        COUNT(*) AS still_serving
    FROM first_term f
    CROSS JOIN intervals i
    JOIN legislators_terms t
      ON t.id_bioguide = f.id_bioguide
     AND printf('%d-12-31',
                CAST(substr(f.first_start, 1, 4) AS INTEGER) + i.gap)
         BETWEEN t.term_start AND t.term_end
    GROUP BY f.state, f.gender, i.gap
),
good_gender AS (
    SELECT state,
           gender
    FROM retention
    GROUP BY state, gender
    HAVING COUNT(DISTINCT gap) = 6         -- non-zero retention at all 6 checkpoints
),
good_states AS (
    SELECT state
    FROM good_gender
    GROUP BY state
    HAVING COUNT(DISTINCT gender) = 2      -- both genders qualify
)
SELECT DISTINCT state
FROM good_states
ORDER BY state;
```
