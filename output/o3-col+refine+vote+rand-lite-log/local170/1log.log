-- 6.  Build an "intervals" helper table for 0,2,4,6,8,10 year checkpoints
SELECT interval
FROM (
  SELECT 0  AS interval UNION ALL
  SELECT 2  UNION ALL
  SELECT 4  UNION ALL
  SELECT 6  UNION ALL
  SELECT 8  UNION ALL
  SELECT 10
)
LIMIT 20;
