Query:
--Description: Re-run of “#9” – final answer query.  Lists the state abbreviations
--             where BOTH male and female cohorts maintain at least one legislator
--             on duty at every checkpoint (0,2,4,6,8,10 years after first term).
WITH first_term AS (
    SELECT l.id_bioguide,
           l.gender,
           lt.state,
           MIN(lt.term_start) AS first_start
    FROM legislators           AS l
    JOIN legislators_terms     AS lt
      ON l.id_bioguide = lt.id_bioguide
    GROUP BY l.id_bioguide
),
intervals AS (
    SELECT 0 AS gap UNION ALL
    SELECT 2 UNION ALL
    SELECT 4 UNION ALL
    SELECT 6 UNION ALL
    SELECT 8 UNION ALL
    SELECT 10
),
retention AS (
    SELECT
        f.state,
        f.gender,
        i.gap,
        COUNT(*) AS still_serving
    FROM first_term f
    CROSS JOIN intervals i
    JOIN legislators_terms t
      ON t.id_bioguide = f.id_bioguide
     AND printf('%d-12-31',
                CAST(substr(f.first_start,1,4) AS INTEGER) + i.gap)
         BETWEEN t.term_start AND t.term_end
    GROUP BY f.state, f.gender, i.gap
),
good_gender AS (               -- state-gender pairs with ALL 6 gaps present
    SELECT state,
           gender
    FROM retention
    GROUP BY state, gender
    HAVING COUNT(DISTINCT gap) = 6
),
good_states AS (               -- states that satisfy for BOTH genders
    SELECT state
    FROM good_gender
    GROUP BY state
    HAVING COUNT(DISTINCT gender) = 2
)
SELECT DISTINCT state
FROM good_states
ORDER BY state
