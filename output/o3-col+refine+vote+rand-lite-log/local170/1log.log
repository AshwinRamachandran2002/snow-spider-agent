```sql
-- 7.  For one legislator, show if they were serving on 0–10-year checkpoints
WITH
first_term AS (
  SELECT id_bioguide,
         MIN(term_start) AS first_start
  FROM legislators_terms
  GROUP BY id_bioguide
),
intervals AS (
  SELECT 0 AS gap UNION ALL SELECT 2 UNION ALL SELECT 4 UNION ALL
  SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
)
SELECT ft.id_bioguide,
       i.gap,
       printf('%d-12-31', CAST(substr(ft.first_start,1,4) AS INTEGER) + i.gap) AS date_check,
       EXISTS (
         SELECT 1
         FROM legislators_terms t
         WHERE t.id_bioguide = ft.id_bioguide
           AND date_check BETWEEN t.term_start AND t.term_end
       ) AS retained
FROM first_term ft
JOIN intervals i
WHERE ft.id_bioguide = 'B000944'      -- sample bioguide ID
LIMIT 20;
```

```sql
-- 8.  Compute retention at each interval for every state & gender
WITH
first_term AS (
  SELECT l.id_bioguide,
         l.gender,
         lt.state,
         MIN(lt.term_start) AS first_start
  FROM legislators l
  JOIN legislators_terms lt
    ON l.id_bioguide = lt.id_bioguide
  GROUP BY l.id_bioguide
),
intervals AS (
  SELECT 0 AS gap UNION ALL SELECT 2 UNION ALL SELECT 4
  UNION ALL SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
),
cohort AS (   -- the original cohort size per state & gender
  SELECT state,
         gender,
         COUNT(*) AS cohort_size
  FROM first_term
  GROUP BY state, gender
),
retention AS (
  SELECT f.state,
         f.gender,
         i.gap,
         COUNT(*) AS still_serving
  FROM first_term f
  JOIN intervals i
  JOIN legislators_terms t
    ON t.id_bioguide = f.id_bioguide
   AND printf('%d-12-31',
              CAST(substr(f.first_start,1,4) AS INTEGER) + i.gap)
       BETWEEN t.term_start AND t.term_end
  GROUP BY f.state, f.gender, i.gap
)
SELECT r.state,
       r.gender,
       r.gap,
       r.still_serving
FROM retention r
ORDER BY r.state, r.gender, r.gap
LIMIT 40;
```

```sql
-- 9.  FINAL ANSWER:  states where BOTH male and female retention > 0 
--     at 0,2,4,6,8,10 years
WITH
first_term AS (
  SELECT l.id_bioguide,
         l.gender,
         lt.state,
         MIN(lt.term_start) AS first_start
  FROM legislators l
  JOIN legislators_terms lt
    ON l.id_bioguide = lt.id_bioguide
  GROUP BY l.id_bioguide
),
intervals AS (
  SELECT 0 AS gap UNION ALL SELECT 2 UNION ALL SELECT 4
  UNION ALL SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
),
retention AS (
  SELECT f.state,
         f.gender,
         i.gap,
         COUNT(*) AS still_serving
  FROM first_term f
  JOIN intervals i
  JOIN legislators_terms t
    ON t.id_bioguide = f.id_bioguide
   AND printf('%d-12-31',
              CAST(substr(f.first_start,1,4) AS INTEGER) + i.gap)
       BETWEEN t.term_start AND t.term_end
  GROUP BY f.state, f.gender, i.gap
),
good_gender AS (   -- gender/state combos that have non-zero retention at ALL six gaps
  SELECT state,
         gender
  FROM retention
  GROUP BY state, gender
  HAVING COUNT(CASE WHEN still_serving > 0 THEN 1 END) = 6   -- all 6 gaps retained
),
good_states AS (   -- states that have BOTH genders meeting the above condition
  SELECT state
  FROM good_gender
  GROUP BY state
  HAVING COUNT(DISTINCT gender) = 2
)
SELECT DISTINCT state
FROM good_states
ORDER BY state;
```
