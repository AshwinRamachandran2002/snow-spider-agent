    FROM base b
    CROSS JOIN offsets o
)
SELECT state,
       gender,
       off       AS years_after_start,
       ROUND(AVG(retained),3) AS retention_rate       -- ratio > 0  ⇒  some people still serving
FROM retention
GROUP BY state, gender, off
LIMIT 20;
