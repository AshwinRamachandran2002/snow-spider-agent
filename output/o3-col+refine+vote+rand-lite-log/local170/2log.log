Query:
-- 5.  For one example legislator, check if they were still serving 
--     on December-31, exactly 0, 2, 4, 6, 8, 10 years after first_start
WITH one_legislator AS (
    SELECT 'B000944' AS id_bioguide   -- << example bioguide id
),
first_term AS (
    SELECT lt.id_bioguide,
           MIN(date(lt.term_start)) AS first_start
    FROM legislators_terms lt
    WHERE lt.id_bioguide IN (SELECT id_bioguide FROM one_legislator)
),
offsets AS (
    SELECT 0 AS off UNION ALL SELECT 2 UNION ALL SELECT 4 UNION 
    SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
)
SELECT o.off,
       CASE 
           WHEN EXISTS (
               SELECT 1
               FROM legislators_terms lt
               JOIN first_term ft ON ft.id_bioguide = lt.id_bioguide
               WHERE lt.id_bioguide = ft.id_bioguide
                 AND date(lt.term_start) <= date(ft.first_start, printf('+%d years', o.off))
                 AND date(lt.term_end)   >= date(ft.first_start, printf('+%d years', o.off))
           )
           THEN 1 ELSE 0
       END AS retained
FROM offsets o
ORDER BY o.off;
