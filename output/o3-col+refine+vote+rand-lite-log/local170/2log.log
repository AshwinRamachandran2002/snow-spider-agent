```sql
-- 1.  Get the distinct gender codes that appear in the legislators table
SELECT DISTINCT gender
FROM legislators
LIMIT 20;
```

```sql
-- 2.  Glimpse at a few legislators together with one of their terms 
--     (join legislators → legislators_terms) to confirm columns we need
SELECT l.id_bioguide,
       l.full_name,
       l.gender,
       lt.state,
       lt.term_start,
       lt.term_end
FROM legislators            AS l
JOIN legislators_terms      AS lt
  ON l.id_bioguide = lt.id_bioguide
LIMIT 20;
```

```sql
-- 3.  Determine the FIRST term-start date for every legislator
SELECT lt.id_bioguide,
       MIN(date(lt.term_start)) AS first_start
FROM legislators_terms AS lt
GROUP BY lt.id_bioguide
LIMIT 20;
```

```sql
-- 4.  Combine first-start with gender & state so each legislator has cohort info
SELECT f.id_bioguide,
       l.gender,
       MIN(lt.state) AS state,     -- every legislator’s first term occurs in a single state
       f.first_start
FROM (
        SELECT id_bioguide,
               MIN(date(term_start)) AS first_start
        FROM legislators_terms
        GROUP BY id_bioguide
     )               AS f
JOIN legislators     AS l   ON l.id_bioguide = f.id_bioguide
JOIN legislators_terms AS lt ON lt.id_bioguide = f.id_bioguide
GROUP BY f.id_bioguide
LIMIT 20;
```

```sql
-- 5.  For one example legislator, check if they were still serving 
--     on December-31, exactly 0, 2, 4, 6, 8, 10 years after first_start
WITH one_legislator AS (
    SELECT 'B000944' AS id_bioguide   -- << example bioguide id
),
first_term AS (
    SELECT lt.id_bioguide,
           MIN(date(lt.term_start)) AS first_start
    FROM legislators_terms lt
    WHERE lt.id_bioguide IN (SELECT id_bioguide FROM one_legislator)
),
offsets AS (
    SELECT 0 AS off UNION ALL SELECT 2 UNION ALL SELECT 4 UNION 
    SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
)
SELECT o.off,
       CASE 
           WHEN EXISTS (
               SELECT 1
               FROM legislators_terms lt
               JOIN first_term ft ON ft.id_bioguide = lt.id_bioguide
               WHERE lt.id_bioguide = ft.id_bioguide
                 AND date(lt.term_start) <= date(ft.first_start, printf('+%d years', o.off))
                 AND date(lt.term_end)   >= date(ft.first_start, printf('+%d years', o.off))
           )
           THEN 1 ELSE 0
       END AS retained
FROM offsets o
ORDER BY o.off;
```

```sql
-- 6.  Build a “retention flag” for EVERY legislator at the six required offsets
WITH first_term AS (
    SELECT lt.id_bioguide,
           MIN(date(lt.term_start)) AS first_start
    FROM legislators_terms lt
    GROUP BY lt.id_bioguide
),
offsets AS (
    SELECT 0 AS off UNION ALL SELECT 2 UNION ALL SELECT 4 UNION 
    SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
)
SELECT ft.id_bioguide,
       o.off                                       AS years_after_start,
       CASE
           WHEN EXISTS (
               SELECT 1
               FROM legislators_terms lt
               WHERE lt.id_bioguide = ft.id_bioguide
                 AND date(lt.term_start) <= date(ft.first_start, printf('+%d years', o.off))
                 AND date(lt.term_end)   >= date(ft.first_start, printf('+%d years', o.off))
           )
           THEN 1 ELSE 0
       END                                          AS retained
FROM first_term ft
CROSS JOIN offsets o
LIMIT 20;
```

```sql
-- 7.  Attach gender & state, then compute RETENTION RATE by state, gender, and offset
WITH first_term AS (
    SELECT lt.id_bioguide,
           MIN(date(lt.term_start)) AS first_start
    FROM legislators_terms lt
    GROUP BY lt.id_bioguide
),
base AS (
    SELECT ft.id_bioguide,
           l.gender,
           lt.state,
           ft.first_start
    FROM first_term       AS ft
    JOIN legislators      AS l  ON l.id_bioguide = ft.id_bioguide
    JOIN legislators_terms AS lt ON lt.id_bioguide = ft.id_bioguide
    GROUP BY ft.id_bioguide      -- lt.state is the state of first term
),
offsets AS (
    SELECT 0 AS off UNION ALL SELECT 2 UNION ALL SELECT 4 UNION 
    SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
),
retention AS (
    SELECT b.state,
           b.gender,
           o.off,
           CASE
               WHEN EXISTS (
                    SELECT 1
                    FROM legislators_terms lt
                    WHERE lt.id_bioguide = b.id_bioguide
                      AND date(lt.term_start) <= date(b.first_start, printf('+%d years', o.off))
                      AND date(lt.term_end)   >= date(b.first_start, printf('+%d years', o.off))
               )
               THEN 1 ELSE 0
           END AS retained
    FROM base b
    CROSS JOIN offsets o
)
SELECT state,
       gender,
       off       AS years_after_start,
       ROUND(AVG(retained),3) AS retention_rate       -- ratio > 0  ⇒  some people still serving
FROM retention
GROUP BY state, gender, off
LIMIT 20;
```

```sql
-- 8.  States where MALE retention rate is > 0 for ALL 6 offsets
WITH first_term AS (
    SELECT lt.id_bioguide,
           MIN(date(lt.term_start)) AS first_start
    FROM legislators_terms lt
    GROUP BY lt.id_bioguide
),
base AS (
    SELECT ft.id_bioguide,
           l.gender,
           lt.state,
           ft.first_start
    FROM first_term        AS ft
    JOIN legislators       AS l  ON l.id_bioguide = ft.id_bioguide
    JOIN legislators_terms AS lt ON lt.id_bioguide = ft.id_bioguide
    GROUP BY ft.id_bioguide
),
offsets AS (
    SELECT 0 AS off UNION ALL SELECT 2 UNION ALL SELECT 4 UNION 
    SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
),
retention AS (
    SELECT b.state,
           o.off,
           CASE
               WHEN EXISTS (
                    SELECT 1
                    FROM legislators_terms lt
                    WHERE lt.id_bioguide = b.id_bioguide
                      AND date(lt.term_start) <= date(b.first_start, printf('+%d years', o.off))
                      AND date(lt.term_end)   >= date(b.first_start, printf('+%d years', o.off))
               )
               THEN 1 ELSE 0
           END AS retained
    FROM base b
    CROSS JOIN offsets o
    WHERE b.gender = 'M'
),
agg AS (
    SELECT state,
           off,
           SUM(retained) AS survivors
    FROM retention
    GROUP BY state, off
)
SELECT DISTINCT state
FROM agg a
WHERE NOT EXISTS (
        SELECT 1
        FROM agg x
        WHERE x.state = a.state
          AND x.survivors = 0                -- if any offset has zero survivors, drop that state
     )
LIMIT 20;
```

```sql
-- 9.  States where FEMALE retention rate is > 0 for ALL 6 offsets
WITH first_term AS (
    SELECT lt.id_bioguide,
           MIN(date(lt.term_start)) AS first_start
    FROM legislators_terms lt
    GROUP BY lt.id_bioguide
),
base AS (
    SELECT ft.id_bioguide,
           l.gender,
           lt.state,
           ft.first_start
    FROM first_term        AS ft
    JOIN legislators       AS l  ON l.id_bioguide = ft.id_bioguide
    JOIN legislators_terms AS lt ON lt.id_bioguide = ft.id_bioguide
    GROUP BY ft.id_bioguide
),
offsets AS (
    SELECT 0 AS off UNION ALL SELECT 2 UNION ALL SELECT 4 UNION 
    SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
),
retention AS (
    SELECT b.state,
           o.off,
           CASE
               WHEN EXISTS (
                    SELECT 1
                    FROM legislators_terms lt
                    WHERE lt.id_bioguide = b.id_bioguide
                      AND date(lt.term_start) <= date(b.first_start, printf('+%d years', o.off))
                      AND date(lt.term_end)   >= date(b.first_start, printf('+%d years', o.off))
               )
               THEN 1 ELSE 0
           END AS retained
    FROM base b
    CROSS JOIN offsets o
    WHERE b.gender = 'F'
),
agg AS (
    SELECT state,
           off,
           SUM(retained) AS survivors
    FROM retention
    GROUP BY state, off
)
SELECT DISTINCT state
FROM agg a
WHERE NOT EXISTS (
        SELECT 1
        FROM agg x
        WHERE x.state = a.state
          AND x.survivors = 0
     )
LIMIT 20;
```

```sql
-- 10.  FINAL ANSWER:  state abbreviations where BOTH male & female cohorts
--     keep a >0 retention rate at 0,2,4,6,8,10 years after first term start
WITH first_term AS (
    SELECT lt.id_bioguide,
           MIN(date(lt.term_start)) AS first_start
    FROM legislators_terms lt
    GROUP BY lt.id_bioguide
),
base AS (
    SELECT ft.id_bioguide,
           l.gender,
           lt.state,
           ft.first_start
    FROM first_term        AS ft
    JOIN legislators       AS l  ON l.id_bioguide = ft.id_bioguide
    JOIN legislators_terms AS lt ON lt.id_bioguide = ft.id_bioguide
    GROUP BY ft.id_bioguide
),
offsets AS (
    SELECT 0 AS off UNION ALL SELECT 2 UNION ALL SELECT 4 UNION 
    SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
),
retention AS (
    SELECT b.state,
           b.gender,
           o.off,
           CASE
               WHEN EXISTS (
                    SELECT 1
                    FROM legislators_terms lt
                    WHERE lt.id_bioguide = b.id_bioguide
                      AND date(lt.term_start) <= date(b.first_start, printf('+%d years', o.off))
                      AND date(lt.term_end)   >= date(b.first_start, printf('+%d years', o.off))
               )
               THEN 1 ELSE 0
           END AS retained
    FROM base b
    CROSS JOIN offsets o
),
agg AS (
    SELECT state,
           gender,
           off,
           SUM(retained) AS survivors
    FROM retention
    GROUP BY state, gender, off
),
zero_flags AS (               -- find where any gender-state combo hits 0 survivors
    SELECT state,
           gender
    FROM agg
    WHERE survivors = 0
    GROUP BY state, gender
),
good_states AS (              -- states that pass the rule for EVERY gender
    SELECT a.state
    FROM agg a
    LEFT JOIN zero_flags z
           ON a.state  = z.state
          AND a.gender = z.gender
    WHERE z.state IS NULL                -- no zero retention rows
    GROUP BY a.state
    HAVING COUNT(DISTINCT a.gender) = 2  -- require both M & F present/passing
)
SELECT DISTINCT state
FROM good_states
ORDER BY state;
```
