-- 10.  FINAL ANSWER:  state abbreviations where BOTH male & female cohorts
--     keep a >0 retention rate at 0,2,4,6,8,10 years after first term start
WITH first_term AS (
    SELECT lt.id_bioguide,
           MIN(date(lt.term_start)) AS first_start
    FROM legislators_terms lt
    GROUP BY lt.id_bioguide
),
base AS (
    SELECT ft.id_bioguide,
           l.gender,
           lt.state,
           ft.first_start
    FROM first_term        AS ft
    JOIN legislators       AS l  ON l.id_bioguide = ft.id_bioguide
    JOIN legislators_terms AS lt ON lt.id_bioguide = ft.id_bioguide
    GROUP BY ft.id_bioguide
),
offsets AS (
    SELECT 0 AS off UNION ALL SELECT 2 UNION ALL SELECT 4 UNION 
    SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
),
retention AS (
    SELECT b.state,
           b.gender,
           o.off,
           CASE
               WHEN EXISTS (
                    SELECT 1
                    FROM legislators_terms lt
                    WHERE lt.id_bioguide = b.id_bioguide
                      AND date(lt.term_start) <= date(b.first_start, printf('+%d years', o.off))
                      AND date(lt.term_end)   >= date(b.first_start, printf('+%d years', o.off))
               )
               THEN 1 ELSE 0
           END AS retained
    FROM base b
    CROSS JOIN offsets o
),
agg AS (
    SELECT state,
           gender,
           off,
           SUM(retained) AS survivors
    FROM retention
    GROUP BY state, gender, off
),
zero_flags AS (               -- find where any gender-state combo hits 0 survivors
    SELECT state,
           gender
    FROM agg
    WHERE survivors = 0
    GROUP BY state, gender
),
good_states AS (              -- states that pass the rule for EVERY gender
    SELECT a.state
    FROM agg a
    LEFT JOIN zero_flags z
           ON a.state  = z.state
          AND a.gender = z.gender
    WHERE z.state IS NULL                -- no zero retention rows
    GROUP BY a.state
    HAVING COUNT(DISTINCT a.gender) = 2  -- require both M & F present/passing
)
SELECT DISTINCT state
FROM good_states
ORDER BY state;
