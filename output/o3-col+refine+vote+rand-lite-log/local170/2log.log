),
base AS (
    SELECT ft.id_bioguide,
           l.gender,
           lt.state,
           ft.first_start
    FROM first_term        AS ft
    JOIN legislators       AS l  ON l.id_bioguide = ft.id_bioguide
    JOIN legislators_terms AS lt ON lt.id_bioguide = ft.id_bioguide
    GROUP BY ft.id_bioguide
),
offsets AS (
    SELECT 0 AS off UNION ALL SELECT 2 UNION ALL SELECT 4 UNION 
    SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
),
retention AS (
    SELECT b.state,
           o.off,
