               WHEN EXISTS (
                    SELECT 1
                    FROM legislators_terms lt
                    WHERE lt.id_bioguide = b.id_bioguide
                      AND date(lt.term_start) <= date(b.first_start, printf('+%d years', o.off))
                      AND date(lt.term_end)   >= date(b.first_start, printf('+%d years', o.off))
