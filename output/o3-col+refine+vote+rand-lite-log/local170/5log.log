Query:
-- 5) Combine first-term info with gender & state to see the cohort we’ll follow
SELECT l.gender,
       lt.state,
       COUNT(*) AS starters
FROM legislators       AS l
JOIN legislators_terms AS lt
  ON l.id_bioguide = lt.id_bioguide
JOIN (                -- only first term rows
      SELECT id_bioguide, MIN(term_start) first_start
      FROM legislators_terms GROUP BY id_bioguide
     ) AS ft
  ON ft.id_bioguide = lt.id_bioguide
 AND lt.term_start   = ft.first_start
GROUP BY l.gender, lt.state
LIMIT 20;
