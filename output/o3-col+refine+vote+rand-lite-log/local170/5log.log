```sql
-- 1) Peek at legislators – basic identifiers & gender distribution
SELECT DISTINCT id_bioguide, full_name, gender
FROM legislators
LIMIT 20;
```

```sql
-- 2) Look at a few raw term-records to understand date ranges and states
SELECT DISTINCT id_bioguide, term_number, term_start, term_end, state
FROM legislators_terms
LIMIT 20;
```

```sql
-- 3) Examine every term for one sample legislator (Sherrod Brown)  
SELECT term_number, term_start, term_end, state
FROM legislators_terms
WHERE id_bioguide = 'B000944'
ORDER BY term_number
LIMIT 20;
```

```sql
-- 4) Find each legislator’s first term-start date (career “Day-0”)
SELECT id_bioguide,
       MIN(term_start) AS first_start_date
FROM legislators_terms
GROUP BY id_bioguide
LIMIT 20;
```

```sql
-- 5) Combine first-term info with gender & state to see the cohort we’ll follow
SELECT l.gender,
       lt.state,
       COUNT(*) AS starters
FROM legislators       AS l
JOIN legislators_terms AS lt
  ON l.id_bioguide = lt.id_bioguide
JOIN (                -- only first term rows
      SELECT id_bioguide, MIN(term_start) first_start
      FROM legislators_terms GROUP BY id_bioguide
     ) AS ft
  ON ft.id_bioguide = lt.id_bioguide
 AND lt.term_start   = ft.first_start
GROUP BY l.gender, lt.state
LIMIT 20;
```

```sql
-- 6) For one example state (OH) calculate how many of its DAY-0 starters
--    are still in office 0,2,4,6,8,10 yrs later (male & female separately)
WITH first_terms AS (
  SELECT l.id_bioguide, l.gender, lt.state,
         MIN(lt.term_start) AS first_start
  FROM legislators l
  JOIN legislators_terms lt ON l.id_bioguide = lt.id_bioguide
  GROUP BY l.id_bioguide
),
offsets AS (SELECT 0 AS off UNION ALL SELECT 2 UNION ALL SELECT 4 UNION ALL SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10)
SELECT ft.state,
       ft.gender,
       o.off AS years_after_start,
       COUNT(*) AS still_serving
FROM first_terms ft
JOIN offsets o
JOIN legislators_terms t
  ON t.id_bioguide = ft.id_bioguide
 AND date(strftime('%Y', ft.first_start, '+'||o.off||' years')||'-12-31')
     BETWEEN t.term_start AND t.term_end
WHERE ft.state = 'OH'
GROUP BY ft.state, ft.gender, o.off
ORDER BY ft.gender, o.off
LIMIT 20;
```

```sql
-- 7) Build the same retention counts for ALL states & both genders
WITH first_terms AS (
  SELECT l.id_bioguide, l.gender, lt.state,
         MIN(lt.term_start) AS first_start
  FROM legislators l
  JOIN legislators_terms lt ON l.id_bioguide = lt.id_bioguide
  GROUP BY l.id_bioguide
),
offsets AS (SELECT 0 AS off UNION ALL SELECT 2 UNION ALL SELECT 4 UNION ALL SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10)
SELECT ft.state,
       ft.gender,
       o.off,
       COUNT(*) AS still_serving
FROM first_terms ft
JOIN offsets o
JOIN legislators_terms t
  ON t.id_bioguide = ft.id_bioguide
 AND date(strftime('%Y', ft.first_start, '+'||o.off||' years')||'-12-31')
     BETWEEN t.term_start AND t.term_end
GROUP BY ft.state, ft.gender, o.off
ORDER BY ft.state, ft.gender, o.off
LIMIT 20;
```

```sql
-- 8) Filter the previous result to rows where at least one legislator survives 
--    (retention rate > 0) – this is implicit in the COUNT(*) > 0
WITH first_terms AS (
  SELECT l.id_bioguide, l.gender, lt.state,
         MIN(lt.term_start) AS first_start
  FROM legislators l
  JOIN legislators_terms lt ON l.id_bioguide = lt.id_bioguide
  GROUP BY l.id_bioguide
),
offsets AS (SELECT 0 AS off UNION ALL SELECT 2 UNION ALL SELECT 4 UNION ALL SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10),
retention AS (
  SELECT ft.state,
         ft.gender,
         o.off,
         COUNT(*) AS survivors
  FROM first_terms ft
  JOIN offsets o
  JOIN legislators_terms t
    ON t.id_bioguide = ft.id_bioguide
   AND date(strftime('%Y', ft.first_start, '+'||o.off||' years')||'-12-31')
       BETWEEN t.term_start AND t.term_end
  GROUP BY ft.state, ft.gender, o.off
)
SELECT * FROM retention
WHERE survivors > 0
LIMIT 20;
```

```sql
-- 9) States where BOTH genders have survivors at EACH of the six offsets
WITH first_terms AS (
  SELECT l.id_bioguide, l.gender, lt.state,
         MIN(lt.term_start) AS first_start
  FROM legislators l
  JOIN legislators_terms lt ON l.id_bioguide = lt.id_bioguide
  GROUP BY l.id_bioguide
),
offsets AS (SELECT 0 AS off UNION ALL SELECT 2 UNION ALL SELECT 4 UNION ALL SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10),
retention AS (
  SELECT ft.state,
         ft.gender,
         o.off,
         COUNT(*) AS survivors
  FROM first_terms ft
  JOIN offsets o
  JOIN legislators_terms t
    ON t.id_bioguide = ft.id_bioguide
   AND date(strftime('%Y', ft.first_start, '+'||o.off||' years')||'-12-31')
       BETWEEN t.term_start AND t.term_end
  GROUP BY ft.state, ft.gender, o.off
  HAVING COUNT(*) > 0          -- keep only positive-retention rows
),
check_points AS (
  SELECT state,
         COUNT(DISTINCT gender)  AS genders_covered,
         COUNT(DISTINCT off)     AS offsets_covered
  FROM retention
  GROUP BY state
)
SELECT state
FROM check_points
WHERE genders_covered = 2   -- male AND female present
  AND offsets_covered = 6   -- all six checkpoints present
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER – list every state that meets the full requirement
WITH first_terms AS (
  SELECT l.id_bioguide, l.gender, lt.state,
         MIN(lt.term_start) AS first_start
  FROM legislators l
  JOIN legislators_terms lt ON l.id_bioguide = lt.id_bioguide
  GROUP BY l.id_bioguide
),
offsets AS (SELECT 0 AS off UNION ALL SELECT 2 UNION ALL SELECT 4 UNION ALL SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10),
retention AS (
  SELECT ft.state,
         ft.gender,
         o.off
  FROM first_terms ft
  JOIN offsets o
  JOIN legislators_terms t
    ON t.id_bioguide = ft.id_bioguide
   AND date(strftime('%Y', ft.first_start, '+'||o.off||' years')||'-12-31')
       BETWEEN t.term_start AND t.term_end
  GROUP BY ft.state, ft.gender, o.off
),
qualifying_states AS (
  SELECT state
  FROM retention
  GROUP BY state, off
  HAVING COUNT(DISTINCT gender) = 2      -- both genders present per offset
),
final_check AS (
  SELECT state, COUNT(DISTINCT off) AS ok_offsets
  FROM qualifying_states
  GROUP BY state
)
SELECT DISTINCT state
FROM final_check
WHERE ok_offsets = 6                     -- all six offsets satisfied
ORDER BY state;
```
