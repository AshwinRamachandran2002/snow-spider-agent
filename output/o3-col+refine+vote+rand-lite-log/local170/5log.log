```sql
--Description: We need states where BOTH genders keep at least one legislator
-- active on 31-Dec at 0,2,4,6,8,10 years after each person’s first term start.
-- 1. first_terms  : every legislator’s gender, state, earliest term_start.
-- 2. offsets      : six benchmark year gaps (0-10).
-- 3. retention    : keep a record when the legislator is in office on
--                   31-Dec of the (first_start + offset) year.
-- 4. per_offset   : for each state+offset require COUNT(DISTINCT gender)=2.
-- 5. final        : keep states that pass requirement for all six offsets.
WITH first_terms AS (
    SELECT l.id_bioguide,
           l.gender,
           lt.state,
           MIN(lt.term_start) AS first_start
    FROM legislators            AS l
    JOIN legislators_terms      AS lt
      ON l.id_bioguide = lt.id_bioguide
    GROUP BY l.id_bioguide
),
offsets AS (
    SELECT 0 AS yrs UNION ALL SELECT 2 UNION ALL SELECT 4
    UNION ALL SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
),
retention AS (
    SELECT ft.state,
           ft.gender,
           o.yrs AS yr_offset
    FROM first_terms       AS ft
    JOIN offsets           AS o
    JOIN legislators_terms AS t
      ON t.id_bioguide = ft.id_bioguide
     AND DATE(strftime('%Y', ft.first_start, '+'||o.yrs||' years') || '-12-31')
         BETWEEN t.term_start AND t.term_end
    GROUP BY ft.state, ft.gender, o.yrs
),
per_offset AS (
    SELECT state,
           yr_offset
    FROM   retention
    GROUP BY state, yr_offset
    HAVING COUNT(DISTINCT gender) = 2   -- both genders present
),
final AS (
    SELECT state
    FROM   per_offset
    GROUP BY state
    HAVING COUNT(DISTINCT yr_offset) = 6 -- all six offsets satisfied
)
SELECT DISTINCT state
FROM final
ORDER BY state;
