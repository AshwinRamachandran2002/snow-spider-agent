```sql
--Description:  We need the states where BOTH male and female legislators have a
--non-zero “retention” rate at 0, 2, 4, 6, 8 and 10 years after the first day they
--entered Congress.  “Retention” here means that a member of the original cohort is
--still serving on 31-Dec of the checkpoint year.
--
--THINKING PROCESS
--1) first_state   – For every legislator (M or F) fetch their first term_start and
--   the state from that very first term.  This anchors the cohort.
--2) intervals     – A VALUES list holding the six required checkpoints.
--3) retention     – For each (state, gender, interval) count how many of those
--   original legislators still hold office on 31-Dec of the (first_year + interval).
--   We use an EXISTS sub-query to test whether that date falls inside ANY of their
--   terms.
--4) valid         – A state-gender pair is “valid” if its retained_cnt is never 0
--   across all six intervals (so MIN(retained_cnt) > 0).
--5) Final SELECT  – Return states that appear in valid for BOTH genders.
WITH first_state AS (
    SELECT l.id_bioguide,
           l.gender,
           t.state,
           MIN(t.term_start) AS first_start
    FROM legislators_terms t
    JOIN legislators       l ON l.id_bioguide = t.id_bioguide
    WHERE l.gender IN ('M','F')
    GROUP BY l.id_bioguide, l.gender
),
intervals(i) AS (VALUES (0),(2),(4),(6),(8),(10)),
retention AS (
    SELECT fs.state,
           fs.gender,
           iv.i AS interval_years,
           SUM(
               CASE
                   WHEN EXISTS (
                       SELECT 1
                       FROM legislators_terms tt
                       WHERE tt.id_bioguide = fs.id_bioguide
                         AND DATE(
                               printf('%04d-12-31',
                                      CAST(substr(fs.first_start,1,4) AS INT) + iv.i)
                             )
                             BETWEEN tt.term_start AND tt.term_end
                   ) THEN 1 ELSE 0
               END
           ) AS retained_cnt
    FROM first_state fs
    CROSS JOIN intervals iv
    GROUP BY fs.state, fs.gender, iv.i
),
valid AS (
    SELECT state, gender
    FROM retention
    GROUP BY state, gender
    HAVING MIN(retained_cnt) > 0   -- never zero at any checkpoint
)
SELECT DISTINCT v1.state           -- states where BOTH genders pass the rule
FROM valid v1
JOIN valid v2 ON v1.state = v2.state
WHERE v1.gender = 'M'
  AND v2.gender = 'F'
ORDER BY v1.state;
```
