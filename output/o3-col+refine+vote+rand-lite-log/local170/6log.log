```sql
-- Description: 2) See the distribution of states that appear in the legislators_terms table.
SELECT DISTINCT state
FROM legislators_terms
LIMIT 20;
```

```sql
-- Description: 3) Sample‐join legislators with their terms to view gender, state, term start & end dates.
SELECT l.gender,
       t.state,
       t.term_start,
       t.term_end,
       l.id_bioguide
FROM legislators      AS l
JOIN legislators_terms AS t
  ON l.id_bioguide = t.id_bioguide
LIMIT 20;
```

```sql
-- Description: 4) Count how many unique male and female legislators each state has ever had (raw head-count).
SELECT t.state,
       l.gender,
       COUNT(DISTINCT l.id_bioguide) AS legislators_cnt
FROM legislators_terms AS t
JOIN legislators       AS l
  ON l.id_bioguide = t.id_bioguide
WHERE l.gender IN ('M','F')
GROUP BY t.state, l.gender
LIMIT 20;
```

```sql
-- Description: 5) For every legislator, retrieve the date of their very first term (earliest term_start).
SELECT l.id_bioguide,
       l.gender,
       MIN(t.term_start) AS first_term_start
FROM legislators_terms AS t
JOIN legislators       AS l
  ON l.id_bioguide = t.id_bioguide
GROUP BY l.id_bioguide, l.gender
LIMIT 20;
```

```sql
-- Description: 6) Show a quick sample of complete term histories for one random legislator (Sherrod Brown).
SELECT t.id_bioguide,
       t.state,
       t.term_number,
       t.term_start,
       t.term_end
FROM legislators_terms AS t
WHERE t.id_bioguide = 'B000944'
ORDER BY t.term_start
LIMIT 20;
```

```sql
-- Description: 7) For each legislator, give the first term_start and the last term_end to understand overall career span.
SELECT l.id_bioguide,
       l.gender,
       MIN(t.term_start) AS first_term_start,
       MAX(t.term_end)   AS last_term_end
FROM legislators_terms AS t
JOIN legislators       AS l
  ON l.id_bioguide = t.id_bioguide
GROUP BY l.id_bioguide, l.gender
LIMIT 20;
```

```sql
-- Description: 8) Pick two particular states (OH and MD) to examine term timelines for male vs female legislators.
SELECT l.gender,
       t.state,
       t.term_start,
       t.term_end,
       l.id_bioguide
FROM legislators_terms AS t
JOIN legislators       AS l
  ON l.id_bioguide = t.id_bioguide
WHERE t.state IN ('OH','MD')
  AND l.gender IN ('M','F')
ORDER BY t.state, l.gender, t.term_start
LIMIT 20;
```

```sql
-- Description: 9) For a quick “retention” proxy, count how many legislators by gender-state are still serving on 2010-12-31.
SELECT t.state,
       l.gender,
       COUNT(DISTINCT l.id_bioguide) AS serving_2010
FROM legislators_terms AS t
JOIN legislators       AS l
  ON l.id_bioguide = t.id_bioguide
WHERE l.gender IN ('M','F')
  AND DATE('2010-12-31') BETWEEN t.term_start AND t.term_end
GROUP BY t.state, l.gender
LIMIT 20;
```

```sql
-- Description: 10) Check which legislators (with gender flag) were still in office exactly 10 years after their first term start.
SELECT lt.id_bioguide,
       l.gender,
       lt.first_term_start,
       DATE(lt.first_term_start, '+10 years')            AS t_plus_10,
       SUM(CASE
             WHEN DATE(lt.first_term_start, '+10 years') BETWEEN t.term_start AND t.term_end
             THEN 1 ELSE 0 END)                         AS retained_10yrs
FROM (
      SELECT l.id_bioguide,
             l.gender,
             MIN(t.term_start) AS first_term_start
      FROM legislators_terms t
      JOIN legislators l
        ON l.id_bioguide = t.id_bioguide
      GROUP BY l.id_bioguide, l.gender
     ) AS lt
JOIN legislators_terms t
  ON t.id_bioguide = lt.id_bioguide
GROUP BY lt.id_bioguide, l.gender, lt.first_term_start
LIMIT 20;
```
