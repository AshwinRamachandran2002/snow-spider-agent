Query:
-- 8) Aggregate those flags by state & gender to see how many remain at each checkpoint
WITH per_leg AS (
    /* the big per-legislator query above, without its LIMIT */
    SELECT l."id_bioguide",
           l."gender",
           t0."state",
           1                                                            AS r0,
           CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                             WHERE tt."id_bioguide" = l."id_bioguide"
                             AND   date(first_start,'+2 years')
                                   BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS r2,
           CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                             WHERE tt."id_bioguide" = l."id_bioguide"
                             AND   date(first_start,'+4 years')
                                   BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS r4,
           CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                             WHERE tt."id_bioguide" = l."id_bioguide"
                             AND   date(first_start,'+6 years')
                                   BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS r6,
           CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                             WHERE tt."id_bioguide" = l."id_bioguide"
                             AND   date(first_start,'+8 years')
                                   BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS r8,
           CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                             WHERE tt."id_bioguide" = l."id_bioguide"
                             AND   date(first_start,'+10 years')
                                   BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS r10
    FROM  ( SELECT "id_bioguide",
                   MIN("term_start") AS first_start
            FROM   "legislators_terms"
            GROUP  BY "id_bioguide") AS ft
    JOIN   "legislators"       AS l  ON l."id_bioguide" = ft."id_bioguide"
    JOIN   "legislators_terms" AS t0 ON t0."id_bioguide" = ft."id_bioguide"
                                      AND t0."term_start" = ft."first_start"
)
SELECT  pl."state",
        pl."gender",
        SUM(pl.r0)  AS n0,
        SUM(pl.r2)  AS n2,
        SUM(pl.r4)  AS n4,
        SUM(pl.r6)  AS n6,
        SUM(pl.r8)  AS n8,
        SUM(pl.r10) AS n10
FROM    per_leg AS pl
GROUP BY pl."state",
         pl."gender"
LIMIT 20
