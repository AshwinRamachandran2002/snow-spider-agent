Query:
-- 4) Join the first-term table back to one of its rows to learn the state
SELECT ft."id_bioguide",
       t."state",
       ft."first_term_start"
FROM  ( SELECT "id_bioguide",
               MIN("term_start") AS "first_term_start"
        FROM   "legislators_terms"
        GROUP  BY "id_bioguide") AS ft
JOIN   "legislators_terms" AS t
       ON  t."id_bioguide" = ft."id_bioguide"
       AND t."term_start"  = ft."first_term_start"
LIMIT 20
