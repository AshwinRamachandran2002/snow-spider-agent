```sql
-- 1) Inspect the gender codes we have to work with
SELECT DISTINCT "gender"
FROM "legislators"
LIMIT 20;


-- 2) Take a look at a few legislators together with their gender
SELECT "id_bioguide",
       "full_name",
       "gender"
FROM   "legislators"
LIMIT 20;


-- 3) Compute each legislator’s first-ever term-start date
SELECT "id_bioguide",
       MIN("term_start") AS "first_term_start"
FROM   "legislators_terms"
GROUP  BY "id_bioguide"
LIMIT 20;


-- 4) Join the first-term table back to one of its rows to learn the state
SELECT ft."id_bioguide",
       t."state",
       ft."first_term_start"
FROM  ( SELECT "id_bioguide",
               MIN("term_start") AS "first_term_start"
        FROM   "legislators_terms"
        GROUP  BY "id_bioguide") AS ft
JOIN   "legislators_terms" AS t
       ON  t."id_bioguide" = ft."id_bioguide"
       AND t."term_start"  = ft."first_term_start"
LIMIT 20;


-- 5) Test retention two-years out for a handful of legislators
SELECT l."id_bioguide",
       l."gender",
       ft."first_term_start",
       CASE
           WHEN EXISTS ( SELECT 1
                         FROM   "legislators_terms" AS t2
                         WHERE  t2."id_bioguide" = l."id_bioguide"
                         AND    date(ft."first_term_start", '+2 years')
                                BETWEEN t2."term_start" AND t2."term_end" )
           THEN 1 ELSE 0
       END AS "retained_2yr"
FROM  ( SELECT "id_bioguide",
               MIN("term_start") AS "first_term_start"
        FROM   "legislators_terms"
        GROUP  BY "id_bioguide" ) AS ft
JOIN   "legislators" AS l
       ON l."id_bioguide" = ft."id_bioguide"
LIMIT 20;


-- 6) Similarly check retention ten-years out
SELECT l."id_bioguide",
       l."gender",
       ft."first_term_start",
       CASE
           WHEN EXISTS ( SELECT 1
                         FROM   "legislators_terms" AS t2
                         WHERE  t2."id_bioguide" = l."id_bioguide"
                         AND    date(ft."first_term_start", '+10 years')
                                BETWEEN t2."term_start" AND t2."term_end" )
           THEN 1 ELSE 0
       END AS "retained_10yr"
FROM  ( SELECT "id_bioguide",
               MIN("term_start") AS "first_term_start"
        FROM   "legislators_terms"
        GROUP  BY "id_bioguide" ) AS ft
JOIN   "legislators" AS l
       ON l."id_bioguide" = ft."id_bioguide"
LIMIT 20;


-- 7) Build one row per legislator with retention flags for all six checkpoints
WITH first_term AS (
    SELECT "id_bioguide",
           MIN("term_start") AS "first_start"
    FROM   "legislators_terms"
    GROUP  BY "id_bioguide"
)
SELECT l."id_bioguide",
       l."gender",
       t0."state",
       1 AS "r0",
       CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                         WHERE tt."id_bioguide" = l."id_bioguide"
                         AND   date(first_start,'+2 years')
                               BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS "r2",
       CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                         WHERE tt."id_bioguide" = l."id_bioguide"
                         AND   date(first_start,'+4 years')
                               BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS "r4",
       CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                         WHERE tt."id_bioguide" = l."id_bioguide"
                         AND   date(first_start,'+6 years')
                               BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS "r6",
       CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                         WHERE tt."id_bioguide" = l."id_bioguide"
                         AND   date(first_start,'+8 years')
                               BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS "r8",
       CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                         WHERE tt."id_bioguide" = l."id_bioguide"
                         AND   date(first_start,'+10 years')
                               BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS "r10"
FROM   first_term AS ft
JOIN   "legislators"       AS l   ON l."id_bioguide" = ft."id_bioguide"
JOIN   "legislators_terms" AS t0  ON t0."id_bioguide" = ft."id_bioguide"
                                   AND t0."term_start" = ft."first_start"
LIMIT 20;


-- 8) Aggregate those flags by state & gender to see how many remain at each checkpoint
WITH per_leg AS (
    /* the big per-legislator query above, without its LIMIT */
    SELECT l."id_bioguide",
           l."gender",
           t0."state",
           1                                                            AS r0,
           CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                             WHERE tt."id_bioguide" = l."id_bioguide"
                             AND   date(first_start,'+2 years')
                                   BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS r2,
           CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                             WHERE tt."id_bioguide" = l."id_bioguide"
                             AND   date(first_start,'+4 years')
                                   BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS r4,
           CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                             WHERE tt."id_bioguide" = l."id_bioguide"
                             AND   date(first_start,'+6 years')
                                   BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS r6,
           CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                             WHERE tt."id_bioguide" = l."id_bioguide"
                             AND   date(first_start,'+8 years')
                                   BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS r8,
           CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                             WHERE tt."id_bioguide" = l."id_bioguide"
                             AND   date(first_start,'+10 years')
                                   BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS r10
    FROM  ( SELECT "id_bioguide",
                   MIN("term_start") AS first_start
            FROM   "legislators_terms"
            GROUP  BY "id_bioguide") AS ft
    JOIN   "legislators"       AS l  ON l."id_bioguide" = ft."id_bioguide"
    JOIN   "legislators_terms" AS t0 ON t0."id_bioguide" = ft."id_bioguide"
                                      AND t0."term_start" = ft."first_start"
)
SELECT  pl."state",
        pl."gender",
        SUM(pl.r0)  AS n0,
        SUM(pl.r2)  AS n2,
        SUM(pl.r4)  AS n4,
        SUM(pl.r6)  AS n6,
        SUM(pl.r8)  AS n8,
        SUM(pl.r10) AS n10
FROM    per_leg AS pl
GROUP BY pl."state",
         pl."gender"
LIMIT 20;


-- 9) Flag state/gender pairs that keep at least one legislator at all checkpoints
WITH per_leg AS (/* same CTE as above */),
     by_state_gender AS (
         SELECT  pl."state",
                 pl."gender",
                 MIN(pl.r2 * pl.r4 * pl.r6 * pl.r8 * pl.r10) AS all_kept
         FROM    per_leg AS pl
         GROUP   BY pl."state", pl."gender"
     )
SELECT *                 -- inspect which state/gender combos survive
FROM   by_state_gender
WHERE  all_kept = 1
LIMIT 20;


-- 10) FINAL: states where BOTH male and female cohorts have non-zero
--          retention at every checkpoint during the first decade
WITH per_leg AS (/* same CTE as above */),
     by_state_gender AS (
         SELECT  pl."state",
                 pl."gender",
                 MIN(pl.r2 * pl.r4 * pl.r6 * pl.r8 * pl.r10) AS all_kept
         FROM    per_leg AS pl
         GROUP   BY pl."state", pl."gender"
     )
SELECT DISTINCT "state"
FROM   by_state_gender
GROUP  BY "state"
HAVING MIN(all_kept) = 1            -- both genders kept someone for all checkpoints
   AND COUNT(DISTINCT "gender") = 2 -- we have both M and F cohorts
LIMIT 20;
