Query:
--Description: Final query that lists state abbreviations where BOTH male and female cohorts
--             maintain at least one active legislator at every checkpoint
--             (0, 2, 4, 6, 8, 10 years after each member’s first-term start).
WITH first_start AS (                    -- earliest term start per legislator
    SELECT "id_bioguide",
           MIN("term_start") AS first_start
    FROM   "legislators_terms"
    GROUP  BY "id_bioguide"
),
per_leg AS (                             -- retention flags per legislator
    SELECT  l."id_bioguide",
            l."gender",
            t0."state",
            1 AS r0,
            CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                              WHERE tt."id_bioguide" = l."id_bioguide"
                                AND date(fs.first_start,'+2 years')
                                    BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS r2,
            CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                              WHERE tt."id_bioguide" = l."id_bioguide"
                                AND date(fs.first_start,'+4 years')
                                    BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS r4,
            CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                              WHERE tt."id_bioguide" = l."id_bioguide"
                                AND date(fs.first_start,'+6 years')
                                    BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS r6,
            CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                              WHERE tt."id_bioguide" = l."id_bioguide"
                                AND date(fs.first_start,'+8 years')
                                    BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS r8,
            CASE WHEN EXISTS (SELECT 1 FROM "legislators_terms" tt
                              WHERE tt."id_bioguide" = l."id_bioguide"
                                AND date(fs.first_start,'+10 years')
                                    BETWEEN tt."term_start" AND tt."term_end") THEN 1 ELSE 0 END AS r10
    FROM  first_start fs
    JOIN  "legislators"        l  ON l."id_bioguide" = fs."id_bioguide"
    JOIN  "legislators_terms" t0 ON t0."id_bioguide" = fs."id_bioguide"
                                   AND t0."term_start" = fs.first_start
),
by_state_gender AS (                     -- flag if a state-gender cohort survives all checkpoints
    SELECT  "state",
            "gender",
            CASE WHEN SUM(r2)  > 0
                  AND SUM(r4)  > 0
                  AND SUM(r6)  > 0
                  AND SUM(r8)  > 0
                  AND SUM(r10) > 0
                 THEN 1 ELSE 0 END AS all_kept
    FROM    per_leg
    GROUP   BY "state","gender"
)
SELECT DISTINCT "state"
FROM   by_state_gender
WHERE  all_kept = 1
GROUP  BY "state"
HAVING COUNT(DISTINCT "gender") = 2   -- both male and female cohorts qualify
ORDER  BY "state"
LIMIT 20
