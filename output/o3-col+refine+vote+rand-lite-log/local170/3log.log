Query:
-- 5) Test retention two-years out for a handful of legislators
SELECT l."id_bioguide",
       l."gender",
       ft."first_term_start",
       CASE
           WHEN EXISTS ( SELECT 1
                         FROM   "legislators_terms" AS t2
                         WHERE  t2."id_bioguide" = l."id_bioguide"
                         AND    date(ft."first_term_start", '+2 years')
                                BETWEEN t2."term_start" AND t2."term_end" )
           THEN 1 ELSE 0
       END AS "retained_2yr"
FROM  ( SELECT "id_bioguide",
               MIN("term_start") AS "first_term_start"
        FROM   "legislators_terms"
        GROUP  BY "id_bioguide" ) AS ft
JOIN   "legislators" AS l
       ON l."id_bioguide" = ft."id_bioguide"
LIMIT 20
