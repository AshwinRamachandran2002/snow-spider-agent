FROM legislators l
JOIN legislators_terms t
  ON l.id_bioguide = t.id_bioguide
LIMIT 20;
```

```sql
--Description: 3) For every legislator, find the date of their very first term (cohort entry) together with state & gender
SELECT l.id_bioguide,
       MIN(t.term_start)          AS first_start_date,
       l.gender,
       t.state
FROM legislators_terms t
JOIN legislators         l USING (id_bioguide)
GROUP BY l.id_bioguide, l.gender, t.state
LIMIT 20;
```

```sql
--Description: 4) Produce the 6 offset-years (0,2,4,6,8,10) we need for retention checks
SELECT *
FROM (SELECT 0 AS offset_years UNION ALL SELECT 2 UNION ALL SELECT 4 UNION ALL SELECT 6 UNION ALL SELECT 8 UNION ALL
      SELECT 10)
LIMIT 20;
```

```sql
--Description: 5) Combine each legislator’s cohort start with every offset to create a “check_date” to test retention
WITH first_start AS (
    SELECT l.id_bioguide,
           MIN(t.term_start) AS first_start_date,
           l.gender,
           t.state
    FROM legislators_terms t
    JOIN legislators l USING (id_bioguide)
    GROUP BY l.id_bioguide, l.gender, t.state
),
offsets(offset_years) AS (
    SELECT 0 UNION ALL SELECT 2 UNION ALL SELECT 4 UNION ALL SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
)
SELECT fs.id_bioguide,
       fs.state,
       fs.gender,
       o.offset_years,
       DATE(fs.first_start_date, printf('+%d years', o.offset_years)) AS check_date
FROM first_start fs
CROSS JOIN offsets o
LIMIT 20;
```

```sql
--Description: 6) Determine whether each legislator is actually serving on their respective check_date (retained = 1)
WITH first_start AS (
    SELECT l.id_bioguide,
           MIN(t.term_start) AS first_start_date,
           l.gender,
           t.state
    FROM legislators_terms t
    JOIN legislators l USING (id_bioguide)
    GROUP BY l.id_bioguide, l.gender, t.state
),
offsets(offset_years) AS (
    SELECT 0 UNION ALL SELECT 2 UNION ALL SELECT 4 UNION ALL SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
),
cohort AS (
    SELECT fs.id_bioguide,
           fs.state,
           fs.gender,
           o.offset_years,
           DATE(fs.first_start_date, printf('+%d years', o.offset_years)) AS check_date
    FROM first_start fs
    CROSS JOIN offsets o
)
SELECT c.id_bioguide,
       c.state,
       c.gender,
       c.offset_years,
       CASE
           WHEN c.check_date BETWEEN t.term_start AND t.term_end THEN 1
           ELSE 0
       END AS retained
FROM cohort c
LEFT JOIN legislators_terms t
       ON t.id_bioguide = c.id_bioguide
      AND c.check_date BETWEEN t.term_start AND t.term_end
LIMIT 20;
```

```sql
--Description: 7) Aggregate counts of retained legislators per state, gender, and offset point
WITH first_start AS (
    SELECT l.id_bioguide,
           MIN(t.term_start) AS first_start_date,
           l.gender,
           t.state
    FROM legislators_terms t
    JOIN legislators l USING (id_bioguide)
    GROUP BY l.id_bioguide, l.gender, t.state
),
offsets(offset_years) AS (
    SELECT 0 UNION ALL SELECT 2 UNION ALL SELECT 4 UNION ALL SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
),
cohort AS (
    SELECT fs.id_bioguide,
           fs.state,
           fs.gender,
           o.offset_years,
           DATE(fs.first_start_date, printf('+%d years', o.offset_years)) AS check_date
    FROM first_start fs
    CROSS JOIN offsets o
),
retention AS (
    SELECT c.state,
           c.gender,
           c.offset_years,
           COUNT(*) AS retained_count
    FROM cohort c
    JOIN legislators_terms t
      ON t.id_bioguide = c.id_bioguide
     AND c.check_date BETWEEN t.term_start AND t.term_end
    GROUP BY c.state, c.gender, c.offset_years
)
SELECT *
FROM retention
LIMIT 20;
```

```sql
--Description: 8) Final answer – states where BOTH male and female cohorts keep a non-zero retention count at all six checkpoints within the first decade
WITH first_start AS (
    SELECT l.id_bioguide,
           MIN(t.term_start) AS first_start_date,
           l.gender,
           t.state
    FROM legislators_terms t
    JOIN legislators l USING (id_bioguide)
    GROUP BY l.id_bioguide, l.gender, t.state
),
offsets(offset_years) AS (
    SELECT 0 UNION ALL SELECT 2 UNION ALL SELECT 4 UNION ALL SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10
),
cohort AS (
    SELECT fs.id_bioguide,
           fs.state,
           fs.gender,
           o.offset_years,
           DATE(fs.first_start_date, printf('+%d years', o.offset_years)) AS check_date
    FROM first_start fs
    CROSS JOIN offsets o
),
retention AS (
    SELECT c.state,
           c.gender,
           c.offset_years,
           COUNT(*) AS retained_count
    FROM cohort c
    JOIN legislators_terms t
      ON t.id_bioguide = c.id_bioguide
     AND c.check_date BETWEEN t.term_start AND t.term_end
    GROUP BY c.state, c.gender, c.offset_years
),
valid_states AS (
    SELECT state, gender
    FROM retention
    WHERE retained_count > 0
    GROUP BY state, gender
    HAVING COUNT(DISTINCT offset_years) = 6            -- all 6 checkpoints covered
),
both_genders AS (
    SELECT state
    FROM valid_states
    GROUP BY state
    HAVING COUNT(DISTINCT gender) = 2                   -- male & female both satisfied
)
SELECT DISTINCT state
FROM both_genders
ORDER BY state
LIMIT 20;
```
