Query:
--Description: Final query – 3 customers with the highest average payment per order,  
--             adding their lifespan in weeks (minimum 1.0).  
SELECT c."customer_unique_id",
       COUNT(DISTINCT o."order_id") AS "num_orders",
       AVG(p."total_payment")       AS "avg_payment_per_order",
       CASE
            WHEN ((julianday(MAX(o."order_purchase_timestamp")) -
                   julianday(MIN(o."order_purchase_timestamp"))) / 7.0) < 1
            THEN 1.0
            ELSE ((julianday(MAX(o."order_purchase_timestamp")) -
                   julianday(MIN(o."order_purchase_timestamp"))) / 7.0)
       END                          AS "customer_lifespan_weeks"
FROM   (SELECT "order_id",
               SUM("payment_value") AS "total_payment"
        FROM   "order_payments"
        GROUP  BY "order_id") AS p
JOIN   "orders"    AS o ON o."order_id" = p."order_id"
JOIN   "customers" AS c ON c."customer_id" = o."customer_id"
GROUP  BY c."customer_unique_id"
ORDER  BY "avg_payment_per_order" DESC
LIMIT 3;
Answer:
