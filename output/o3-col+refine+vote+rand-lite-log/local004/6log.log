```sql
--Description: Preview distinct customer IDs and their purchase timestamps from the "orders" table
SELECT DISTINCT "customer_id", "order_purchase_timestamp"
FROM "orders"
LIMIT 20;
```

```sql
--Description: Preview distinct order IDs and their individual payment values from the "order_payments" table
SELECT DISTINCT "order_id", "payment_value"
FROM "order_payments"
LIMIT 20;
```

```sql
--Description: Show the total (summed) payment per order by joining "orders" and "order_payments"
SELECT o."order_id",
       SUM(p."payment_value") AS "total_payment"
FROM "orders" AS o
JOIN "order_payments" AS p
  ON o."order_id" = p."order_id"
GROUP BY o."order_id"
LIMIT 20;
```

```sql
--Description: For every customer, calculate number of orders and their average payment per order
SELECT o."customer_id",
       COUNT(DISTINCT o."order_id")                AS "num_orders",
       AVG(pay."total_payment")                    AS "avg_payment_per_order"
FROM "orders" AS o
JOIN (
       SELECT "order_id",
              SUM("payment_value") AS "total_payment"
       FROM "order_payments"
       GROUP BY "order_id"
     ) AS pay
  ON o."order_id" = pay."order_id"
GROUP BY o."customer_id"
LIMIT 20;
```

```sql
--Description: Determine the lifespan in days for customers (difference between last and first purchase dates)
SELECT "customer_id",
       MIN(DATE("order_purchase_timestamp")) AS "first_purchase",
       MAX(DATE("order_purchase_timestamp")) AS "last_purchase",
       JULIANDAY(MAX(DATE("order_purchase_timestamp"))) -
       JULIANDAY(MIN(DATE("order_purchase_timestamp"))) AS "lifespan_days"
FROM "orders"
GROUP BY "customer_id"
LIMIT 20;
```

```sql
--Description: Combine order statistics with lifespan in weeks (minimum of 1.0 week)
SELECT stats."customer_id",
       stats."num_orders",
       stats."avg_payment_per_order",
       CASE
            WHEN lifespan."lifespan_days" / 7.0 < 1 THEN 1.0
            ELSE lifespan."lifespan_days" / 7.0
       END AS "lifespan_weeks"
FROM (
       SELECT o."customer_id",
              COUNT(DISTINCT o."order_id") AS "num_orders",
              AVG(pay."total_payment")     AS "avg_payment_per_order"
       FROM "orders" AS o
       JOIN (
              SELECT "order_id",
                     SUM("payment_value") AS "total_payment"
              FROM "order_payments"
              GROUP BY "order_id"
            ) AS pay
         ON o."order_id" = pay."order_id"
       GROUP BY o."customer_id"
     ) AS stats
JOIN (
       SELECT "customer_id",
              JULIANDAY(MAX(DATE("order_purchase_timestamp"))) -
              JULIANDAY(MIN(DATE("order_purchase_timestamp"))) AS "lifespan_days"
       FROM "orders"
       GROUP BY "customer_id"
     ) AS lifespan
  ON stats."customer_id" = lifespan."customer_id"
LIMIT 20;
```

```sql
--Description: Final answer – top 3 customers with highest average payment per order, showing number of orders, average payment, and lifespan in weeks
SELECT stats."customer_id",
       stats."num_orders",
       ROUND(stats."avg_payment_per_order", 2)                               AS "avg_payment_per_order",
       ROUND(
           CASE
               WHEN lifespan."lifespan_days" / 7.0 < 1 THEN 1.0
               ELSE lifespan."lifespan_days" / 7.0
           END, 2)                                                           AS "lifespan_weeks"
FROM (
       SELECT o."customer_id",
              COUNT(DISTINCT o."order_id") AS "num_orders",
              AVG(pay."total_payment")     AS "avg_payment_per_order"
       FROM "orders" AS o
       JOIN (
              SELECT "order_id",
                     SUM("payment_value") AS "total_payment"
              FROM "order_payments"
              GROUP BY "order_id"
            ) AS pay
         ON o."order_id" = pay."order_id"
       GROUP BY o."customer_id"
     ) AS stats
JOIN (
       SELECT "customer_id",
              JULIANDAY(MAX(DATE("order_purchase_timestamp"))) -
              JULIANDAY(MIN(DATE("order_purchase_timestamp"))) AS "lifespan_days"
       FROM "orders"
       GROUP BY "customer_id"
     ) AS lifespan
  ON stats."customer_id" = lifespan."customer_id"
ORDER BY stats."avg_payment_per_order" DESC
LIMIT 3;
```
