```sql
--Description: 1) Get a feeling for when each customer bought – first 20 purchase-timestamps.
SELECT DISTINCT "customer_id",
       "order_purchase_timestamp"
FROM   "orders"
LIMIT  20;
```

```sql
--Description: 2) Look at the amounts paid per order – first 20 records.
SELECT DISTINCT "order_id",
       "payment_value"
FROM   "order_payments"
LIMIT  20;
```

```sql
--Description: 3) How much was really paid per order (sum over all payment rows of that order).
SELECT DISTINCT op."order_id",
       SUM(op."payment_value") AS "order_total_payment"
FROM   "order_payments" AS op
GROUP  BY op."order_id"
LIMIT  20;
```

```sql
--Description: 4) Join orders ↔ order_totals to see payment together with the customer who bought.
SELECT DISTINCT o."customer_id",
       ot."order_id",
       ot."order_total_payment"
FROM   "orders"          AS o
JOIN  (SELECT "order_id",
              SUM("payment_value") AS "order_total_payment"
       FROM   "order_payments"
       GROUP  BY "order_id") AS ot
       ON ot."order_id" = o."order_id"
LIMIT  20;
```

```sql
--Description: 5) For every customer: number of orders and average payment per order.
SELECT DISTINCT cust_pay."customer_id",
       COUNT(*)                           AS "n_orders",
       AVG(cust_pay."order_total_payment") AS "avg_payment_per_order"
FROM  (SELECT o."customer_id",
              ot."order_total_payment"
       FROM   "orders" AS o
       JOIN  (SELECT "order_id",
                     SUM("payment_value") AS "order_total_payment"
              FROM   "order_payments"
              GROUP  BY "order_id") AS ot
              ON ot."order_id" = o."order_id") AS cust_pay
GROUP  BY cust_pay."customer_id"
ORDER  BY "avg_payment_per_order" DESC
LIMIT  20;
```

```sql
--Description: 6) Work out the time range (days) between the first and last purchase for each customer.
SELECT DISTINCT o."customer_id",
       (JULIANDAY(MAX(o."order_purchase_timestamp")) -
        JULIANDAY(MIN(o."order_purchase_timestamp"))) AS "lifespan_days"
FROM   "orders" AS o
GROUP  BY o."customer_id"
LIMIT  20;
```

```sql
--Description: 7) Convert that lifespan to weeks, but force anything < 7 days to 1.0 week.
SELECT DISTINCT lf."customer_id",
       CASE
           WHEN lf."lifespan_days" < 7 THEN 1.0
           ELSE lf."lifespan_days" / 7.0
       END AS "lifespan_weeks"
FROM  (SELECT o."customer_id",
              (JULIANDAY(MAX(o."order_purchase_timestamp")) -
               JULIANDAY(MIN(o."order_purchase_timestamp"))) AS "lifespan_days"
       FROM   "orders" AS o
       GROUP  BY o."customer_id") AS lf
LIMIT  20;
```

```sql
--Description: 8) Bring everything together: number of orders, average payment, lifespan-weeks.
SELECT DISTINCT cp."customer_id",
       cp."n_orders",
       cp."avg_payment_per_order",
       lw."lifespan_weeks"
FROM  (SELECT o."customer_id",
              COUNT(*)                       AS "n_orders",
              AVG(ot."order_total_payment")  AS "avg_payment_per_order"
       FROM   "orders" AS o
       JOIN  (SELECT "order_id",
                     SUM("payment_value") AS "order_total_payment"
              FROM   "order_payments"
              GROUP  BY "order_id") AS ot
              ON ot."order_id" = o."order_id"
       GROUP  BY o."customer_id") AS cp
JOIN  (SELECT lf."customer_id",
              CASE
                  WHEN lf."lifespan_days" < 7 THEN 1.0
                  ELSE lf."lifespan_days" / 7.0
              END AS "lifespan_weeks"
       FROM  (SELECT o."customer_id",
                     (JULIANDAY(MAX(o."order_purchase_timestamp")) -
                      JULIANDAY(MIN(o."order_purchase_timestamp"))) AS "lifespan_days"
              FROM   "orders" AS o
              GROUP  BY o."customer_id") AS lf) AS lw
       ON lw."customer_id" = cp."customer_id"
ORDER BY cp."avg_payment_per_order" DESC
LIMIT  20;
```

```sql
--Description: 9) Finally, restrict to the TOP-3 customers by average payment per order.
SELECT DISTINCT *
FROM  (
        SELECT cp."customer_id",
               cp."n_orders",
               cp."avg_payment_per_order",
               lw."lifespan_weeks",
               ROW_NUMBER() OVER (ORDER BY cp."avg_payment_per_order" DESC) AS rn
        FROM  (SELECT o."customer_id",
                       COUNT(*)                      AS "n_orders",
                       AVG(ot."order_total_payment") AS "avg_payment_per_order"
               FROM   "orders" AS o
               JOIN  (SELECT "order_id",
                             SUM("payment_value") AS "order_total_payment"
                      FROM   "order_payments"
                      GROUP  BY "order_id") AS ot
                      ON ot."order_id" = o."order_id"
               GROUP  BY o."customer_id") AS cp
        JOIN  (SELECT lf."customer_id",
                      CASE
                          WHEN lf."lifespan_days" < 7 THEN 1.0
                          ELSE lf."lifespan_days" / 7.0
                      END AS "lifespan_weeks"
               FROM  (SELECT o."customer_id",
                             (JULIANDAY(MAX(o."order_purchase_timestamp")) -
                              JULIANDAY(MIN(o."order_purchase_timestamp"))) AS "lifespan_days"
                      FROM   "orders" AS o
                      GROUP  BY o."customer_id") AS lf) AS lw
        ON   lw."customer_id" = cp."customer_id"
       )
WHERE  rn <= 3
LIMIT  20;
```

```sql
--Description: 10) Same as 9 but neater: only the three rows we really need.
SELECT DISTINCT top3."customer_id",
       top3."n_orders",
       top3."avg_payment_per_order",
       top3."lifespan_weeks"
FROM  (
        SELECT cp."customer_id",
               cp."n_orders",
               cp."avg_payment_per_order",
               lw."lifespan_weeks",
               ROW_NUMBER() OVER (ORDER BY cp."avg_payment_per_order" DESC) AS rn
        FROM  (SELECT o."customer_id",
                       COUNT(*)                      AS "n_orders",
                       AVG(ot."order_total_payment") AS "avg_payment_per_order"
               FROM   "orders" AS o
               JOIN  (SELECT "order_id",
                             SUM("payment_value") AS "order_total_payment"
                      FROM   "order_payments"
                      GROUP  BY "order_id") AS ot
                      ON ot."order_id" = o."order_id"
               GROUP  BY o."customer_id") AS cp
        JOIN  (SELECT lf."customer_id",
                      CASE
                          WHEN lf."lifespan_days" < 7 THEN 1.0
                          ELSE lf."lifespan_days" / 7.0
                      END AS "lifespan_weeks"
               FROM  (SELECT o."customer_id",
                             (JULIANDAY(MAX(o."order_purchase_timestamp")) -
                              JULIANDAY(MIN(o."order_purchase_timestamp"))) AS "lifespan_days"
                      FROM   "orders" AS o
                      GROUP  BY o."customer_id") AS lf) AS lw
        ON   lw."customer_id" = cp."customer_id"
       ) AS top3
WHERE  top3.rn <= 3
LIMIT  20;
```
