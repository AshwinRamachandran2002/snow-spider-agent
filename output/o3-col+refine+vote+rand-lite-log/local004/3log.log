Query:
--Description: 9) Finally, restrict to the TOP-3 customers by average payment per order.
SELECT DISTINCT *
FROM  (
        SELECT cp."customer_id",
               cp."n_orders",
               cp."avg_payment_per_order",
               lw."lifespan_weeks",
               ROW_NUMBER() OVER (ORDER BY cp."avg_payment_per_order" DESC) AS rn
        FROM  (SELECT o."customer_id",
                       COUNT(*)                      AS "n_orders",
                       AVG(ot."order_total_payment") AS "avg_payment_per_order"
               FROM   "orders" AS o
               JOIN  (SELECT "order_id",
                             SUM("payment_value") AS "order_total_payment"
                      FROM   "order_payments"
                      GROUP  BY "order_id") AS ot
                      ON ot."order_id" = o."order_id"
               GROUP  BY o."customer_id") AS cp
        JOIN  (SELECT lf."customer_id",
                      CASE
                          WHEN lf."lifespan_days" < 7 THEN 1.0
                          ELSE lf."lifespan_days" / 7.0
                      END AS "lifespan_weeks"
               FROM  (SELECT o."customer_id",
                             (JULIANDAY(MAX(o."order_purchase_timestamp")) -
                              JULIANDAY(MIN(o."order_purchase_timestamp"))) AS "lifespan_days"
                      FROM   "orders" AS o
                      GROUP  BY o."customer_id") AS lf) AS lw
        ON   lw."customer_id" = cp."customer_id"
       )
WHERE  rn <= 3
LIMIT  20;
