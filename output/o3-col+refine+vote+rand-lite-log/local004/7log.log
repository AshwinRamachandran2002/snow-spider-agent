```sql
--Description: Inspect a sample of distinct customers that have placed at least one order
SELECT DISTINCT "customer_id"
FROM "orders"
LIMIT 20;
```

```sql
--Description: Inspect how much was paid on individual orders (one row per payment record)
SELECT DISTINCT "order_id",
       "payment_value"
FROM "order_payments"
LIMIT 20;
```

```sql
--Description: Look at orders together with the customer who placed them and the purchase date
SELECT DISTINCT "order_id",
       "customer_id",
       "order_purchase_timestamp"
FROM "orders"
LIMIT 20;
```

```sql
--Description: Combine orders with their total payment value to see how much each order was worth
SELECT o."order_id",
       o."customer_id",
       op."payment_value"
FROM "orders"  AS o
JOIN "order_payments" AS op
  ON o."order_id" = op."order_id"
LIMIT 20;
```

```sql
--Description: Aggregate by customer to get number of orders and the average payment per order
SELECT o."customer_id",
       COUNT(DISTINCT o."order_id")              AS "num_orders",
       AVG(op."payment_value")                   AS "avg_payment_per_order"
FROM "orders"  AS o
JOIN "order_payments" AS op
  ON o."order_id" = op."order_id"
GROUP BY o."customer_id"
ORDER BY "avg_payment_per_order" DESC
LIMIT 10;
```

```sql
--Description: For one customer, inspect earliest and latest purchase dates to understand lifespan
SELECT o."customer_id",
       MIN(o."order_purchase_timestamp") AS "first_purchase",
       MAX(o."order_purchase_timestamp") AS "last_purchase"
FROM "orders" AS o
GROUP BY o."customer_id"
HAVING o."customer_id" = (
        SELECT o2."customer_id"
        FROM "orders" AS o2
        JOIN "order_payments" AS op2
          ON o2."order_id" = op2."order_id"
        GROUP BY o2."customer_id"
        ORDER BY AVG(op2."payment_value") DESC
        LIMIT 1
)
LIMIT 20;
```

```sql
--Description: Compute lifespan in days for every customer (difference between last and first purchase)
SELECT o."customer_id",
       JULIANDAY(MAX(o."order_purchase_timestamp")) -
       JULIANDAY(MIN(o."order_purchase_timestamp")) AS "lifespan_days"
FROM "orders" AS o
GROUP BY o."customer_id"
LIMIT 20;
```

```sql
--Description: Convert lifespan from days to weeks and floor it to at least 1.0 week
SELECT o."customer_id",
       CASE
         WHEN (JULIANDAY(MAX(o."order_purchase_timestamp")) -
               JULIANDAY(MIN(o."order_purchase_timestamp"))) / 7.0 < 1.0
         THEN 1.0
         ELSE (JULIANDAY(MAX(o."order_purchase_timestamp")) -
               JULIANDAY(MIN(o."order_purchase_timestamp"))) / 7.0
       END AS "lifespan_weeks"
FROM "orders" AS o
GROUP BY o."customer_id"
LIMIT 20;
```

```sql
--Description: Bring everything together – orders count, average payment, and lifespan (in weeks) for each customer
SELECT o."customer_id",
       COUNT(DISTINCT o."order_id")                           AS "num_orders",
       AVG(op."payment_value")                                AS "avg_payment_per_order",
       CASE
         WHEN (JULIANDAY(MAX(o."order_purchase_timestamp")) -
               JULIANDAY(MIN(o."order_purchase_timestamp"))) / 7.0 < 1.0
         THEN 1.0
         ELSE (JULIANDAY(MAX(o."order_purchase_timestamp")) -
               JULIANDAY(MIN(o."order_purchase_timestamp"))) / 7.0
       END                                                   AS "lifespan_weeks"
FROM "orders"         AS o
JOIN "order_payments" AS op
  ON o."order_id" = op."order_id"
GROUP BY o."customer_id"
LIMIT 20;
```

```sql
--Description: Retrieve the top-3 customers with the highest average payment per order, along with number of orders and lifespan weeks
SELECT o."customer_id",
       COUNT(DISTINCT o."order_id")                           AS "num_orders",
       AVG(op."payment_value")                                AS "avg_payment_per_order",
       CASE
         WHEN (JULIANDAY(MAX(o."order_purchase_timestamp")) -
               JULIANDAY(MIN(o."order_purchase_timestamp"))) / 7.0 < 1.0
         THEN 1.0
         ELSE (JULIANDAY(MAX(o."order_purchase_timestamp")) -
               JULIANDAY(MIN(o."order_purchase_timestamp"))) / 7.0
       END                                                   AS "lifespan_weeks"
FROM "orders"         AS o
JOIN "order_payments" AS op
  ON o."order_id" = op."order_id"
GROUP BY o."customer_id"
ORDER BY "avg_payment_per_order" DESC
LIMIT 3;
```
