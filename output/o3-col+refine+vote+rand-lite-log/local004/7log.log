Query:
--Description: For one customer, inspect earliest and latest purchase dates to understand lifespan
SELECT o."customer_id",
       MIN(o."order_purchase_timestamp") AS "first_purchase",
       MAX(o."order_purchase_timestamp") AS "last_purchase"
FROM "orders" AS o
GROUP BY o."customer_id"
HAVING o."customer_id" = (
        SELECT o2."customer_id"
        FROM "orders" AS o2
        JOIN "order_payments" AS op2
          ON o2."order_id" = op2."order_id"
        GROUP BY o2."customer_id"
        ORDER BY AVG(op2."payment_value") DESC
        LIMIT 1
)
LIMIT 20;
Answer:
customer_id,first_purchase,last_purchase
