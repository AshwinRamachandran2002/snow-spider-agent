```sql
--Description: Explore some orders with their purchase timestamps and customers  
SELECT DISTINCT "order_id",
                "customer_id",
                "order_purchase_timestamp"
FROM "orders"
LIMIT 20;
```

```sql
--Description: Inspect total payment received per order  
SELECT DISTINCT "order_id",
                SUM("payment_value") AS total_payment
FROM "order_payments"
GROUP BY "order_id"
LIMIT 20;
```

```sql
--Description: See how an order’s payment aggregates when joined to its customer  
SELECT DISTINCT o."customer_id",
                SUM(p."payment_value") AS total_payment
FROM   "orders"         AS o
JOIN   "order_payments" AS p USING ("order_id")
GROUP  BY o."customer_id"
LIMIT 20;
```

```sql
--Description: Count how many orders each customer has placed  
SELECT DISTINCT "customer_id",
                COUNT(*) AS num_orders
FROM   "orders"
GROUP  BY "customer_id"
LIMIT 20;
```

```sql
--Description: Compute the average payment per order for every customer  
SELECT DISTINCT t."customer_id",
                AVG(t.pay_per_order) AS avg_payment
FROM  (SELECT o."order_id",
              o."customer_id",
              SUM(p."payment_value") AS pay_per_order
       FROM   "orders"         AS o
       JOIN   "order_payments" AS p USING ("order_id")
       GROUP  BY o."order_id") AS t
GROUP BY t."customer_id"
ORDER BY avg_payment DESC
LIMIT 20;
```

```sql
--Description: Work out the customer lifespan (in weeks) using the rule given  
SELECT DISTINCT "customer_id",
       CASE
         WHEN (julianday(MAX("order_purchase_timestamp"))
               - julianday(MIN("order_purchase_timestamp"))) < 7
              THEN 1.0
         ELSE (julianday(MAX("order_purchase_timestamp"))
               - julianday(MIN("order_purchase_timestamp"))) / 7
       END AS lifespan_weeks
FROM   "orders"
GROUP  BY "customer_id"
LIMIT 20;
```

```sql
--Description: Combine number-of-orders, average payment, and lifespan for each customer  
SELECT DISTINCT m."customer_id",
                m.num_orders,
                m.avg_payment,
                l.lifespan_weeks
FROM  (SELECT t."customer_id",
              COUNT(*)                AS num_orders,
              AVG(t.pay_per_order)    AS avg_payment
       FROM  (SELECT o."order_id",
                     o."customer_id",
                     SUM(p."payment_value") AS pay_per_order
              FROM   "orders"         AS o
              JOIN   "order_payments" AS p USING ("order_id")
              GROUP  BY o."order_id") AS t
       GROUP BY t."customer_id")      AS m
JOIN  (SELECT DISTINCT "customer_id",
              CASE
                WHEN (julianday(MAX("order_purchase_timestamp"))
                      - julianday(MIN("order_purchase_timestamp"))) < 7
                     THEN 1.0
                ELSE (julianday(MAX("order_purchase_timestamp"))
                      - julianday(MIN("order_purchase_timestamp"))) / 7
              END AS lifespan_weeks
       FROM   "orders"
       GROUP  BY "customer_id")       AS l
USING ("customer_id")
ORDER BY m.avg_payment DESC
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – top-3 customers with the highest average payment per order,  
--showing their order count, average payment and lifespan (weeks)  
SELECT DISTINCT m."customer_id",
                m.num_orders                                 AS number_of_orders,
                ROUND(m.avg_payment, 2)                      AS average_payment_per_order,
                ROUND(l.lifespan_weeks, 2)                   AS customer_lifespan_weeks
FROM  (SELECT t."customer_id",
              COUNT(*)             AS num_orders,
              AVG(t.pay_per_order) AS avg_payment
       FROM  (SELECT o."order_id",
                     o."customer_id",
                     SUM(p."payment_value") AS pay_per_order
              FROM   "orders"         AS o
              JOIN   "order_payments" AS p USING ("order_id")
              GROUP  BY o."order_id") AS t
       GROUP BY t."customer_id")      AS m
JOIN  (SELECT "customer_id",
              CASE
                WHEN (julianday(MAX("order_purchase_timestamp"))
                      - julianday(MIN("order_purchase_timestamp"))) < 7
                     THEN 1.0
                ELSE (julianday(MAX("order_purchase_timestamp"))
                      - julianday(MIN("order_purchase_timestamp"))) / 7
              END AS lifespan_weeks
       FROM   "orders"
       GROUP  BY "customer_id")       AS l
USING ("customer_id")
ORDER BY m.avg_payment DESC
LIMIT 3;
```
