Query:
--Description: Count, for each utility patent granted in 2010, the number of distinct citing
--             application numbers that appear in its citation list within 10 years of its
--             filing date.  Uses FLATTEN with outer => TRUE (to keep patents that have no
--             citations) and avoids any JOIN syntax that Snowflake disallows with LATERAL.
SELECT
    p."publication_number",
    COUNT(
        DISTINCT CASE
                     WHEN f.value:"publication_date"::NUMBER BETWEEN p."filing_date"
                                                                  AND p."filing_date" + 100000
                          AND f.value:"application_number" IS NOT NULL
                          AND f.value:"application_number"::STRING <> ''
                     THEN f.value:"application_number"::STRING
                 END
    ) AS "citations_within_10y"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation", outer => TRUE) f
WHERE p."grant_date" BETWEEN 20100101 AND 20101231
  AND p."application_kind" = 'A'
GROUP BY p."publication_number"
LIMIT 20
