Query:
--Description: Distribution of citation counts (0-5) for utility patents granted in 2010
SELECT
    citation_count,
    COUNT(*) AS "num_patents"
FROM (
    SELECT
        p."publication_number",
        COUNT(*) AS citation_count
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation", outer => TRUE) f
    WHERE p."grant_date" BETWEEN 20100101 AND 20101231
      AND p."application_kind" = 'A'
    GROUP BY p."publication_number"
) t
WHERE citation_count <= 5
GROUP BY citation_count
ORDER BY citation_count
