HAVING COUNT(
           DISTINCT CASE
                        WHEN f.value:"application_number" IS NOT NULL
                             AND f.value:"application_number"::STRING <> ''
                        THEN f.value:"application_number"::STRING
                    END
       ) = 1
LIMIT 20;
```

```sql
--Description: Final count of utility patents granted in 2010 that have exactly one forward
--             citation within 10 years of filing.
SELECT COUNT(*) AS "num_patents"
FROM (
    SELECT
        p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation", outer => TRUE) f
    WHERE p."grant_date" BETWEEN 20100101 AND 20101231
      AND p."application_kind" = 'A'
      AND f.value:"publication_date"::NUMBER BETWEEN p."filing_date"
                                                AND p."filing_date" + 100000
    GROUP BY p."publication_number"
    HAVING COUNT(
               DISTINCT CASE
                            WHEN f.value:"application_number" IS NOT NULL
                                 AND f.value:"application_number"::STRING <> ''
                            THEN f.value:"application_number"::STRING
                        END
           ) = 1
) t;
```

```sql
--Description: Retrieve titles for a sample of patents that meet the “exactly one citation
--             within 10 years” criterion, using a correlated IN-subquery that relies on
--             FLATTEN with outer => TRUE and no JOIN syntax.
SELECT
    p."publication_number",
    p."title_localized"
FROM PATENTS.PATENTS.PUBLICATIONS p
WHERE p."publication_number" IN (
      SELECT
          p2."publication_number"
      FROM PATENTS.PATENTS.PUBLICATIONS p2,
           LATERAL FLATTEN(input => p2."citation", outer => TRUE) f
      WHERE p2."grant_date" BETWEEN 20100101 AND 20101231
        AND p2."application_kind" = 'A'
        AND f.value:"publication_date"::NUMBER BETWEEN p2."filing_date"
                                                  AND p2."filing_date" + 100000
      GROUP BY p2."publication_number"
      HAVING COUNT(
                 DISTINCT CASE
                              WHEN f.value:"application_number" IS NOT NULL
                                   AND f.value:"application_number"::STRING <> ''
                              THEN f.value:"application_number"::STRING
                          END
             ) = 1
)
LIMIT 20;
```

```sql
--Description: Distribution of forward-citation counts (0-5) within the 10-year window for
--             2010-granted utility patents, again using FLATTEN with outer => TRUE.
SELECT
    citation_count,
    COUNT(*) AS "num_patents"
FROM (
    SELECT
        p."publication_number",
        COUNT(
            DISTINCT CASE
                         WHEN f.value:"publication_number" IS NOT NULL
                              AND f.value:"application_number"::STRING <> ''
                              AND f.value:"publication_date"::NUMBER BETWEEN p."filing_date"
                                                                         AND p."filing_date" + 100000
                         THEN f.value:"application_number"::STRING
                     END
        ) AS citation_count
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation", outer => TRUE) f
    WHERE p."grant_date" BETWEEN 20100101 AND 20101231
      AND p."application_kind" = 'A'
    GROUP BY p."publication_number"
) t
WHERE citation_count <= 5
GROUP BY citation_count
ORDER BY citation_count
LIMIT 20;
```
