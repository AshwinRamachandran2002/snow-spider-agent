--               • Keep only citing rows whose filing_date is after the base filing
--                 date but no more than 10 years later (≈ +100000 in YYYYMMDD form).
--               • GROUP BY each base patent and retain only those with exactly one
--                 DISTINCT citing application number.
--               • Finally COUNT(*) to get the answer.
SELECT
    COUNT(*) AS "num_utility_patents_granted_2010_with_exactly_one_forward_citation_within_10_years"
FROM (
    SELECT
        base."publication_number",
        COUNT(DISTINCT cr."application_number") AS "fwd_cite_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS  base
    LEFT JOIN (
            SELECT
                citing."application_number",
                citing."filing_date",
                f.value:"publication_number"::STRING AS "cited_pub"
            FROM PATENTS.PATENTS.PUBLICATIONS  citing
            CROSS JOIN LATERAL FLATTEN(input => citing."citation") f
    ) cr
           ON cr."cited_pub" = base."publication_number"
    WHERE base."grant_date" BETWEEN 20100101 AND 20101231
      AND base."application_kind" = 'A'                    -- utility patents
      AND cr."filing_date"  >  base."filing_date"          -- after base filing
      AND cr."filing_date" <= base."filing_date" + 100000  -- within 10-year window
    GROUP BY base."publication_number"
    HAVING COUNT(DISTINCT cr."application_number") = 1
) q;
