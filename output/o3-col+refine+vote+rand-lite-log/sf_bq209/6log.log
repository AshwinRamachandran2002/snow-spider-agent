  p."application_number"                            AS "citing_app",
  f.value:"publication_number"::STRING              AS "cited_pub"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."citation" IS NOT NULL
  AND p."citation" <> '[]'
  AND f.value:"publication_number" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Build a small sample of citing-to-cited pairs together with both filing dates  
SELECT
  base."publication_number"        AS "cited_pub",
  base."filing_date"               AS "cited_filing",
  citing."publication_number"      AS "citing_pub",
  citing."filing_date"             AS "citing_filing"
FROM PATENTS.PATENTS.PUBLICATIONS base
JOIN PATENTS.PATENTS.PUBLICATIONS citing,
     LATERAL FLATTEN(input => citing."citation") f
       ON f.value:"publication_number"::STRING = base."publication_number"
LIMIT 20;
```

```sql
--Description: For 2010-granted utility patents, count distinct forward-citing application numbers within 10 years  
SELECT
  base."publication_number",
  COUNT(DISTINCT citing."application_number") AS "fwd_cite_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS base
LEFT JOIN PATENTS.PATENTS.PUBLICATIONS citing,
     LATERAL FLATTEN(input => citing."citation") f
       ON f.value:"publication_number"::STRING = base."publication_number"
WHERE base."grant_date" BETWEEN 20100101 AND 20101231
  AND base."application_kind" = 'A'
  AND citing."filing_date" >  base."filing_date"          -- after base filing
  AND citing."filing_date" <= base."filing_date" + 100000 -- within 10-year window
GROUP BY base."publication_number"
LIMIT 20;
```

```sql
--Description: Identify the 2010-granted utility patents that have exactly one such forward citation  
SELECT
  base_stats."publication_number"
FROM (
  SELECT
    base."publication_number",
    COUNT(DISTINCT citing."application_number") AS "fwd_cite_cnt"
  FROM PATENTS.PATENTS.PUBLICATIONS base
  LEFT JOIN PATENTS.PATENTS.PUBLICATIONS citing,
       LATERAL FLATTEN(input => citing."citation") f
         ON f.value:"publication_number"::STRING = base."publication_number"
  WHERE base."grant_date" BETWEEN 20100101 AND 20101231
    AND base."application_kind" = 'A'
    AND citing."filing_date" >  base."filing_date"
    AND citing."filing_date" <= base."filing_date" + 100000
  GROUP BY base."publication_number"
) base_stats
WHERE base_stats."fwd_cite_cnt" = 1
LIMIT 20;
```

```sql
--Description: Final aggregation – how many such patents are there in total?  
SELECT
  COUNT(*) AS "num_utility_patents_granted_2010_with_exactly_one_forward_citation_within_10_years"
FROM (
  SELECT
    base."publication_number",
    COUNT(DISTINCT citing."application_number") AS "fwd_cite_cnt"
  FROM PATENTS.PATENTS.PUBLICATIONS base
  LEFT JOIN PATENTS.PATENTS.PUBLICATIONS citing,
       LATERAL FLATTEN(input => citing."citation") f
         ON f.value:"publication_number"::STRING = base."publication_number"
  WHERE base."grant_date" BETWEEN 20100101 AND 20101231
    AND base."application_kind" = 'A'
    AND citing."filing_date" >  base."filing_date"
    AND citing."filing_date" <= base."filing_date" + 100000
  GROUP BY base."publication_number"
  HAVING COUNT(DISTINCT citing."application_number") = 1
) q;
```

```sql
