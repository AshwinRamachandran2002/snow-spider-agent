--             LIMIT 20 keeps the preview short.
SELECT
    base."publication_number"    AS "cited_pub",
    base."filing_date"           AS "cited_filing",
    citing."publication_number"  AS "citing_pub",
    citing."filing_date"         AS "citing_filing"
FROM PATENTS.PATENTS.PUBLICATIONS  citing
     CROSS JOIN LATERAL FLATTEN(input => citing."citation") f
     JOIN PATENTS.PATENTS.PUBLICATIONS  base
       ON base."publication_number" = f.value:"publication_number"::STRING
LIMIT 20;
