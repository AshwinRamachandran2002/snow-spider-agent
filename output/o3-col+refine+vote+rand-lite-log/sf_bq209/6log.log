SELECT
    base."publication_number"   AS "cited_pub",
    cr2."citing_pub"            AS "the_single_citing_pub"
FROM PATENTS.PATENTS.PUBLICATIONS  base
JOIN (
        SELECT
            citing."publication_number"                    AS "citing_pub",
            citing."application_number",
            citing."filing_date",
            f.value:"publication_number"::STRING           AS "cited_pub"
        FROM PATENTS.PATENTS.PUBLICATIONS  citing
        CROSS JOIN LATERAL FLATTEN(input => citing."citation") f
) cr2
      ON cr2."cited_pub" = base."publication_number"
WHERE base."grant_date" BETWEEN 20100101 AND 20101231
  AND base."application_kind" = 'A'
  AND cr2."filing_date"  >  base."filing_date"
  AND cr2."filing_date" <= base."filing_date" + 100000
GROUP BY base."publication_number", cr2."citing_pub"
HAVING COUNT(DISTINCT cr2."application_number") = 1
LIMIT 20
