```sql
--Description: 5) For granted 2010 patents, explode their citation lists to find who they CITE
SELECT p."publication_number"           AS "cited_publication",
       p."filing_date"                  AS "cited_filing_date",
       p."grant_date",
       f.VALUE:"publication_number"::STRING AS "backward_citation"
FROM "PATENTS"."PATENTS"."PUBLICATIONS" p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20101231
  AND p."kind_code" ILIKE 'B%'
LIMIT 20;
```

```sql
--Description: 6) Identify all occurrences where a later patent (citing) references an earlier one (cited)
SELECT citing."publication_number"  AS "citing_pub",
       citing."filing_date"         AS "citing_file",
       cited."publication_number"   AS "cited_pub",
       cited."filing_date"          AS "cited_file"
FROM "PATENTS"."PATENTS"."PUBLICATIONS" cited
JOIN LATERAL FLATTEN(input => cited."citation") f
     ON 1=1
JOIN "PATENTS"."PATENTS"."PUBLICATIONS" citing
     ON citing."publication_number" = f.VALUE:"publication_number"::STRING
LIMIT 20;
```

```sql
--Description: 7) Restrict that same join so that the citing application was filed ≤10 years after the cited patent’s filing
SELECT cited."publication_number"                           AS "cited_pub",
       COUNT(DISTINCT citing."application_number")          AS "n_forward_citations"
FROM "PATENTS"."PATENTS"."PUBLICATIONS" cited
JOIN LATERAL FLATTEN(input => cited."citation") f
     ON 1=1
JOIN "PATENTS"."PATENTS"."PUBLICATIONS" citing
     ON citing."publication_number" = f.VALUE:"publication_number"::STRING
WHERE DATEDIFF('day', TO_DATE(cited."filing_date"::STRING,'YYYYMMDD'),
                     TO_DATE(citing."filing_date"::STRING,'YYYYMMDD')) <= 3650
GROUP BY cited."publication_number"
LIMIT 20;
```

```sql
--Description: 8) Find 2010 utility patents that have exactly one such forward citation
SELECT cited."publication_number"
FROM (
      SELECT cited."publication_number",
             COUNT(DISTINCT citing."application_number") AS "fw_cites"
      FROM "PATENTS"."PATENTS"."PUBLICATIONS" cited
      JOIN LATERAL FLATTEN(input => cited."citation") f
           ON 1=1
      JOIN "PATENTS"."PATENTS"."PUBLICATIONS" citing
           ON citing."publication_number" = f.VALUE:"publication_number"::STRING
      WHERE cited."grant_date" BETWEEN 20100101 AND 20101231
        AND cited."kind_code" ILIKE 'B%'          -- utility/granted
        AND DATEDIFF('day', TO_DATE(cited."filing_date"::STRING,'YYYYMMDD'),
                           TO_DATE(citing."filing_date"::STRING,'YYYYMMDD')) <= 3650
      GROUP BY cited."publication_number"
     ) q
WHERE q."fw_cites" = 1
LIMIT 20;
```

```sql
--Description: 9) Finally, count how many patents satisfy the above criteria
SELECT COUNT(*) AS "n_utility_patents_granted_2010_with_one_forward_citation_in_10yrs"
FROM (
      SELECT cited."publication_number",
             COUNT(DISTINCT citing."application_number") AS "fw_cites"
      FROM "PATENTS"."PATENTS"."PUBLICATIONS" cited
      JOIN LATERAL FLATTEN(input => cited."citation") f
           ON 1=1
      JOIN "PATENTS"."PATENTS"."PUBLICATIONS" citing
           ON citing."publication_number" = f.VALUE:"publication_number"::STRING
      WHERE cited."grant_date" BETWEEN 20100101 AND 20101231
        AND cited."kind_code" ILIKE 'B%'          -- utility/granted
        AND DATEDIFF('day', TO_DATE(cited."filing_date"::STRING,'YYYYMMDD'),
                           TO_DATE(citing."filing_date"::STRING,'YYYYMMDD')) <= 3650
      GROUP BY cited."publication_number"
     ) q
WHERE q."fw_cites" = 1;
```

