```sql
--Description: 
-- Count U.S.-style utility patents (kind_code beginning with “B”) that were granted in 2010
-- and received exactly ONE distinct forward citation within 10 years of their own filing date.
-- “Forward citation” means a *different* patent whose citation list contains the focal patent’s
-- publication_number and whose filing_date falls no later than 3 650 days (≈10 yrs) after
-- the focal patent’s filing_date.  Steps:
--   1. Treat every patent record as a potential “citing” patent; flatten its "citation" array.
--   2. Self-join PUBLICATIONS so that each flattened element (f.VALUE:"publication_number")
--      is matched to the full record of the “cited” patent.
--   3. Restrict the cited patent to those granted in 2010 with kind_code LIKE 'B%' (utility).
--   4. Keep only citing patents filed within 10 years *after* (or on) the cited patent’s filing date.
--   5. Group by cited patent and keep those with COUNT(DISTINCT citing.application_number)=1.
--   6. Return the total number of such patents.

WITH one_fw_cite AS (
    SELECT
        cited."publication_number",
        COUNT(DISTINCT citing."application_number") AS fw_cnt
    FROM   "PATENTS"."PATENTS"."PUBLICATIONS"  citing,
           LATERAL FLATTEN(input => citing."citation") f,
           "PATENTS"."PATENTS"."PUBLICATIONS"  cited
    WHERE  cited."publication_number" = f.VALUE:"publication_number"::STRING
      AND  cited."grant_date" BETWEEN 20100101 AND 20101231
      AND  cited."kind_code" ILIKE 'B%'                         -- utility patent (granted)
      -- forward-citation window: citing filed within 10 years after cited filing
      AND  TO_DATE(citing."filing_date"::STRING,'YYYYMMDD')
           BETWEEN TO_DATE(cited."filing_date"::STRING,'YYYYMMDD')
               AND DATEADD('day', 3650, TO_DATE(cited."filing_date"::STRING,'YYYYMMDD'))
    GROUP BY cited."publication_number"
    HAVING fw_cnt = 1
)
SELECT COUNT(*) AS "num_utility_patents_granted_2010_with_one_forward_cite_in_10yrs"
FROM   one_fw_cite;
```
