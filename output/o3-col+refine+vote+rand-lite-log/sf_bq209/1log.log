Query:
--Description: 5) For granted 2010 patents, explode their citation lists to find who they CITE
SELECT p."publication_number"           AS "cited_publication",
       p."filing_date"                  AS "cited_filing_date",
       p."grant_date",
       f.VALUE:"publication_number"::STRING AS "backward_citation"
FROM "PATENTS"."PATENTS"."PUBLICATIONS" p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20101231
  AND p."kind_code" ILIKE 'B%'
LIMIT 20;
