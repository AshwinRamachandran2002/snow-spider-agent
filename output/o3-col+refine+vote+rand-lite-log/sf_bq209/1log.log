```sql
--Description: 
-- Compute the number of U.S-style utility patents (kind_code LIKE 'B%') that were granted
-- in calendar-year 2010 and have exactly ONE distinct forward citation whose application
-- (filing) date falls within 10 years (3 650 days) after the focal patent’s own filing date.
-- Steps in a single query:
--  1) CTE cited_2010   – focal patents: granted in 2010, utility kind, filing_date > 0
--  2) CTE citing_flat  – every citation emitted by every other patent; we keep only citing
--                        patents with filing_date > 0 and expose their filing_date plus the
--                        publication_number they cite.
--  3) Join the two CTEs on publication_number equality, then require the citing filing date
--     to be within 10 years after the cited filing date.
--  4) Group by each cited patent; keep those with COUNT(DISTINCT citing.application_number)=1.
--  5) Finally, COUNT the number of such patents.

WITH cited_2010 AS (
    SELECT *
    FROM   "PATENTS"."PATENTS"."PUBLICATIONS"
    WHERE  "grant_date" BETWEEN 20100101 AND 20101231
      AND  "kind_code" ILIKE 'B%'     -- utility, granted
      AND  "filing_date" > 0          -- avoid invalid / missing dates
),
citing_flat AS (
    SELECT 
           citing."application_number"              AS citing_app,
           citing."filing_date"                     AS citing_file,
           f.VALUE:"publication_number"::STRING     AS cited_pub
    FROM   "PATENTS"."PATENTS"."PUBLICATIONS" citing,
           LATERAL FLATTEN(input => citing."citation") f
    WHERE  citing."filing_date" > 0
)
SELECT COUNT(*) AS "num_utility_patents_granted_2010_with_one_forward_cite_in_10yrs"
FROM (
      SELECT c2010."publication_number"
      FROM   cited_2010            c2010
      JOIN   citing_flat           cf
             ON cf.cited_pub = c2010."publication_number"
      WHERE  TO_DATE(cf.citing_file::STRING,'YYYYMMDD')
             BETWEEN TO_DATE(c2010."filing_date"::STRING,'YYYYMMDD')
                 AND DATEADD('day', 3650, TO_DATE(c2010."filing_date"::STRING,'YYYYMMDD'))
      GROUP BY c2010."publication_number"
      HAVING COUNT(DISTINCT cf.citing_app) = 1
     ) q;
```
