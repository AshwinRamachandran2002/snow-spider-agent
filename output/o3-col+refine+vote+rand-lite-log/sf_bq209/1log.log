```sql
--Description: 
-- Produce 20 sample forward-citation counts quickly.
-- Strategy:
--  1.  CTE citing_flat: flatten every patent’s "citation" array once, giving rows
--        (citing_app, citing_file, cited_pub).  Skip citing patents that lack a valid
--        filing_date (i.e., filing_date = 0) so subsequent date arithmetic is safe.
--  2.  Join that CTE to PUBLICATIONS (alias cited) on cited publication_number to pull
--        the full record of each cited patent.  Keep only cited patents whose filing_date > 0.
--  3.  Retain only pairs where the citing patent was filed within 3 650 days (≈10 years)
--        after—or on—the cited patent’s filing date (DATEDIFF between 0 and 3 650).
--  4.  Group by cited publication_number and count DISTINCT citing applications.
--  5.  Show 20 rows for inspection.

WITH citing_flat AS (
    SELECT
        citing."application_number"              AS citing_app,
        citing."filing_date"                     AS citing_file,
        f.VALUE:"publication_number"::STRING     AS cited_pub
    FROM   "PATENTS"."PATENTS"."PUBLICATIONS"  citing,
           LATERAL FLATTEN(input => citing."citation") f
    WHERE  citing."filing_date" > 0                 -- ignore invalid dates
)
SELECT
       cited."publication_number"                  AS "cited_pub",
       COUNT(DISTINCT cf.citing_app)               AS "n_forward_citations"
FROM   "PATENTS"."PATENTS"."PUBLICATIONS"  cited
JOIN   citing_flat  cf
       ON cf.cited_pub = cited."publication_number"
WHERE  cited."filing_date" > 0
  AND  DATEDIFF(
         'day',
         TO_DATE(cited."filing_date"::STRING,'YYYYMMDD'),
         TO_DATE(cf.citing_file::STRING,'YYYYMMDD')
       ) BETWEEN 0 AND 3650
GROUP BY cited."publication_number"
LIMIT 20;
```
