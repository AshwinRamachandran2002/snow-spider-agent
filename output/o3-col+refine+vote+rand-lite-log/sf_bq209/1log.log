```sql
--Description: 7)  Restrict to citations where the citing patent was filed within 10 years (≤ 3 650 days)
--                after the cited patent’s filing date.  Exclude any records whose filing_date = 0
--                to avoid date-parsing errors, and use comma-style joins (citing → FLATTEN → cited)
--                rather than “JOIN … ON 1 = 1”, which Snowflake disallows for LATERAL TFs.
SELECT
       cited."publication_number"                        AS "cited_pub",
       COUNT(DISTINCT citing."application_number")       AS "n_forward_citations"
FROM   "PATENTS"."PATENTS"."PUBLICATIONS"  citing,
       LATERAL FLATTEN(input => citing."citation") f,
       "PATENTS"."PATENTS"."PUBLICATIONS"  cited
WHERE  cited."publication_number" = f.VALUE:"publication_number"::STRING
  AND  cited."filing_date"  > 0
  AND  citing."filing_date" > 0
  AND  DATEDIFF('day',
                TO_DATE(cited."filing_date"::STRING,'YYYYMMDD'),
                TO_DATE(citing."filing_date"::STRING,'YYYYMMDD')) BETWEEN 0 AND 3650
GROUP BY cited."publication_number"
LIMIT 20;
```

