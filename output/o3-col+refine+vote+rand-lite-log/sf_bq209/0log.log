Query:
--Description: Build a link-table of “citing_app  →  cited_pub” together with the citing application’s filing date  
WITH citation_links AS (
    SELECT  citing."application_number"     AS "citing_app",
            citing."filing_date"            AS "citing_filing_date",
            c.value:"publication_number"::STRING AS "cited_publication"
    FROM PATENTS.PATENTS.PUBLICATIONS  citing,
         LATERAL FLATTEN (INPUT => citing."citation")        c
    WHERE citing."citation" IS NOT NULL
      AND citing."citation" <> '[]'
)
SELECT *
FROM citation_links
