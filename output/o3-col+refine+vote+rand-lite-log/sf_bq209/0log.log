WHERE "application_kind" = 'A'
  AND "grant_date" BETWEEN 20100101 AND 20101231
LIMIT 20;
```

```sql
--Description: Take a look at the raw “citation” array for publications that actually contain citations  
SELECT "publication_number",
       "citation"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "citation" IS NOT NULL
  AND "citation" <> '[]'
LIMIT 20;
```

```sql
--Description: Flatten the citation array to inspect the structure of each cited-item object  
SELECT  p."publication_number"                               AS "citing_publication",
        c.value:"publication_number"::STRING                 AS "cited_publication",
        c.value:"application_number"::STRING                 AS "cited_application"
FROM PATENTS.PATENTS.PUBLICATIONS  p,
     LATERAL FLATTEN (INPUT => p."citation")                 c
WHERE p."citation" IS NOT NULL
  AND p."citation" <> '[]'
LIMIT 20;
```

```sql
--Description: Same flattening as above but bring a few more keys to learn available fields  
SELECT  p."publication_number"                               AS "citing_publication",
        c.value:"publication_number"::STRING                 AS "cited_publication",
        c.value:"kind_code"::STRING                          AS "cited_kind",
        c.value:"publication_date"::NUMBER                   AS "cited_pub_date"
FROM PATENTS.PATENTS.PUBLICATIONS  p,
     LATERAL FLATTEN (INPUT => p."citation")                 c
WHERE p."citation" IS NOT NULL
  AND p."citation" <> '[]'
LIMIT 20;
```

```sql
--Description: Build a link-table of “citing_app  →  cited_pub” together with the citing application’s filing date  
WITH citation_links AS (
    SELECT  citing."application_number"     AS "citing_app",
            citing."filing_date"            AS "citing_filing_date",
            c.value:"publication_number"::STRING AS "cited_publication"
    FROM PATENTS.PATENTS.PUBLICATIONS  citing,
         LATERAL FLATTEN (INPUT => citing."citation")        c
    WHERE citing."citation" IS NOT NULL
      AND citing."citation" <> '[]'
)
SELECT *
FROM citation_links
LIMIT 20;
```

```sql
--Description: For each utility patent granted in 2010, count DISTINCT forward-citing applications that filed within 10 years from the patent’s own filing date  
WITH citation_links AS (
    SELECT  citing."application_number"          AS "citing_app",
            citing."filing_date"                 AS "citing_filing_date",
            c.value:"publication_number"::STRING AS "cited_publication"
    FROM PATENTS.PATENTS.PUBLICATIONS  citing,
         LATERAL FLATTEN (INPUT => citing."citation")        c
    WHERE citing."citation" IS NOT NULL
      AND citing."citation" <> '[]'
),
targets AS (
    SELECT  "publication_number",
            "application_number",
            "filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "application_kind" = 'A'
      AND "grant_date" BETWEEN 20100101 AND 20101231
)
SELECT  t."publication_number"                      AS "target_pub",
        COUNT(DISTINCT cl."citing_app")             AS "distinct_forward_citations"
FROM           targets         t
LEFT JOIN      citation_links   cl
       ON  cl."cited_publication" = t."publication_number"
       AND cl."citing_filing_date" BETWEEN t."filing_date"
                                       AND t."filing_date" + 100000   -- ~10-year window
GROUP BY t."publication_number"
LIMIT 20;
```

```sql
--Description: Retrieve ONLY those 2010-granted utility patents that have EXACTLY ONE forward citation in the 10-year window  
WITH citation_links AS (
    SELECT  citing."application_number"          AS "citing_app",
            citing."filing_date"                 AS "citing_filing_date",
            c.value:"publication_number"::STRING AS "cited_publication"
    FROM PATENTS.PATENTS.PUBLICATIONS  citing,
         LATERAL FLATTEN (INPUT => citing."citation")        c
    WHERE citing."citation" IS NOT NULL
      AND citing."citation" <> '[]'
),
targets AS (
    SELECT  "publication_number",
            "application_number",
            "filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "application_kind" = 'A'
      AND "grant_date" BETWEEN 20100101 AND 20101231
)
SELECT  t."publication_number"                      AS "target_pub_with_one_citation"
FROM           targets         t
LEFT JOIN      citation_links   cl
       ON  cl."cited_publication" = t."publication_number"
       AND cl."citing_filing_date" BETWEEN t."filing_date"
                                       AND t."filing_date" + 100000         -- 10-year window
GROUP BY t."publication_number"
HAVING COUNT(DISTINCT cl."citing_app") = 1
LIMIT 20;
```

```sql
--Description: Count how many patents satisfy the “exactly one forward citation” condition  
WITH citation_links AS (
    SELECT  citing."application_number"          AS "citing_app",
            citing."filing_date"                 AS "citing_filing_date",
            c.value:"publication_number"::STRING AS "cited_publication"
    FROM PATENTS.PATENTS.PUBLICATIONS  citing,
         LATERAL FLATTEN (INPUT => citing."citation")        c
    WHERE citing."citation" IS NOT NULL
      AND citing."citation" <> '[]'
),
targets AS (
    SELECT  "publication_number",
            "application_number",
            "filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "application_kind" = 'A'
      AND "grant_date" BETWEEN 20100101 AND 20101231
)
SELECT  COUNT(*) AS "num_with_exactly_one_forward_citation"
FROM (
    SELECT  t."publication_number"
    FROM           targets         t
    LEFT JOIN      citation_links   cl
           ON  cl."cited_publication" = t."publication_number"
           AND cl."citing_filing_date" BETWEEN t."filing_date"
                                           AND t."filing_date" + 100000   -- 10-year window
    GROUP BY t."publication_number"
    HAVING COUNT(DISTINCT cl."citing_app") = 1
) q
LIMIT 20;
```

```sql
--Description: Show both the target patent and its lone forward-citing application for manual verification  
WITH citation_links AS (
    SELECT  citing."application_number"          AS "citing_app",
            citing."publication_number"          AS "citing_publication",
            citing."filing_date"                 AS "citing_filing_date",
            c.value:"publication_number"::STRING AS "cited_publication"
    FROM PATENTS.PATENTS.PUBLICATIONS  citing,
         LATERAL FLATTEN (INPUT => citing."citation")        c
    WHERE citing."citation" IS NOT NULL
      AND citing."citation" <> '[]'
),
targets AS (
    SELECT  "publication_number",
            "application_number",
            "filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "application_kind" = 'A'
      AND "grant_date" BETWEEN 20100101 AND 20101231
)
SELECT  t."publication_number"      AS "target_pub",
        cl."citing_publication"     AS "lone_citing_publication",
        cl."citing_app"             AS "lone_citing_application"
FROM           targets         t
JOIN           citation_links   cl
      ON  cl."cited_publication" = t."publication_number"
WHERE cl."citing_filing_date" BETWEEN t."filing_date" 
                                AND t."filing_date" + 100000
GROUP BY t."publication_number",
         cl."citing_publication",
         cl."citing_app"
HAVING COUNT(*) = 1
LIMIT 20;
```
