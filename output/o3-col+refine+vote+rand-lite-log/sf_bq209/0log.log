Query:
--Description: Flatten the citation array to inspect the structure of each cited-item object  
SELECT  p."publication_number"                               AS "citing_publication",
        c.value:"publication_number"::STRING                 AS "cited_publication",
        c.value:"application_number"::STRING                 AS "cited_application"
FROM PATENTS.PATENTS.PUBLICATIONS  p,
     LATERAL FLATTEN (INPUT => p."citation")                 c
WHERE p."citation" IS NOT NULL
  AND p."citation" <> '[]'
LIMIT 20;
