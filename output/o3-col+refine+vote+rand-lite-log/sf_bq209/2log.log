Query:
--Description: 7. Join citation network back to the publications table so that we also know the filing date of the *cited* patent.
SELECT cited."application_number"                     AS "cited_app_no",
       cited."filing_date"                            AS "cited_filing_date",
       network."citing_app_no",
       network."citing_filing_date"
FROM (
    SELECT f.value::VARIANT:"publication_number"::STRING AS "cited_pub",
           p."application_number"                        AS "citing_app_no",
           p."filing_date"                               AS "citing_filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") f
) network
JOIN PATENTS.PATENTS.PUBLICATIONS cited
      ON cited."publication_number" = network."cited_pub"
LIMIT 20;
