```sql
--Description: 1. Inspect the distinct values that appear in the "application_kind" column so we know the code used for utility patents.
SELECT DISTINCT "application_kind"
FROM PATENTS.PATENTS.PUBLICATIONS
LIMIT 20;
```

```sql
--Description: 2. Sample rows of patents that were granted in calendar-year 2010 together with grant-, filing- and application-kind information.
SELECT "publication_number",
       "application_number",
       "application_kind",
       "filing_date",
       "grant_date"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "grant_date" BETWEEN 20100101 AND 20101231
LIMIT 20;
```

```sql
--Description: 3. Show utility patents (application_kind = 'U') that were granted in 2010.
SELECT "publication_number",
       "application_number",
       "filing_date",
       "grant_date"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "application_kind" = 'U'
  AND "grant_date" BETWEEN 20100101 AND 20101231
LIMIT 20;
```

```sql
--Description: 4. Look at the raw "citation" JSON for a randomly chosen patent granted in 2010 to understand its structure.
SELECT "publication_number",
       "citation"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "grant_date" BETWEEN 20100101 AND 20101231
  AND "citation" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 5. Flatten the "citation" array to list all cited publication numbers for the same sample of patents.
SELECT p."publication_number"  AS "citing_pub",
       f.value::VARIANT:"publication_number"::STRING AS "cited_pub"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20101231
  AND p."citation" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 6. Build a simple citation network: each row is (cited_pub, citing_application_number, citing_filing_date).
SELECT f.value::VARIANT:"publication_number"::STRING            AS "cited_pub",
       p."application_number"                                   AS "citing_app_no",
       p."filing_date"                                          AS "citing_filing_date"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."application_number" IS NOT NULL
  AND f.value::VARIANT:"publication_number" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 7. Join citation network back to the publications table so that we also know the filing date of the *cited* patent.
SELECT cited."application_number"                     AS "cited_app_no",
       cited."filing_date"                            AS "cited_filing_date",
       network."citing_app_no",
       network."citing_filing_date"
FROM (
    SELECT f.value::VARIANT:"publication_number"::STRING AS "cited_pub",
           p."application_number"                        AS "citing_app_no",
           p."filing_date"                               AS "citing_filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") f
) network
JOIN PATENTS.PATENTS.PUBLICATIONS cited
      ON cited."publication_number" = network."cited_pub"
LIMIT 20;
```

```sql
--Description: 8. For patents granted in 2010 (utility kind), count distinct forward-citing applications that fall within 10-year window from the cited patent’s filing date.
SELECT cited."publication_number",
       COUNT(DISTINCT network."citing_app_no") AS "forward_cite_count"
FROM (
    SELECT f.value::VARIANT:"publication_number"::STRING AS "cited_pub",
           p."application_number"                        AS "citing_app_no",
           p."filing_date"                               AS "citing_filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") f
) network
JOIN PATENTS.PATENTS.PUBLICATIONS cited
      ON cited."publication_number" = network."cited_pub"
WHERE cited."application_kind" = 'U'
  AND cited."grant_date" BETWEEN 20100101 AND 20101231
  AND network."citing_filing_date" BETWEEN cited."filing_date" 
                                       AND cited."filing_date" + 100000  -- ≈ 10 years in YYYYMMDD
GROUP BY cited."publication_number"
LIMIT 20;
```

```sql
--Description: 9. Retrieve those 2010-granted utility patents which have exactly one forward citation in the 10-year window.
SELECT *
FROM (
    SELECT cited."publication_number",
           COUNT(DISTINCT network."citing_app_no") AS "forward_cite_count"
    FROM (
        SELECT f.value::VARIANT:"publication_number"::STRING AS "cited_pub",
               p."application_number"                        AS "citing_app_no",
               p."filing_date"                               AS "citing_filing_date"
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(input => p."citation") f
    ) network
    JOIN PATENTS.PATENTS.PUBLICATIONS cited
          ON cited."publication_number" = network."cited_pub"
    WHERE cited."application_kind" = 'U'
      AND cited."grant_date" BETWEEN 20100101 AND 20101231
      AND network."citing_filing_date" BETWEEN cited."filing_date" 
                                           AND cited."filing_date" + 100000  -- 10-year window
    GROUP BY cited."publication_number"
) q
WHERE q."forward_cite_count" = 1
LIMIT 20;
```

```sql
--Description: 10. Aggregate the final count of such patents (utility, granted 2010, exactly one forward citation within 10 years).
SELECT COUNT(*) AS "num_utility_patents_granted_2010_with_one_forward_citation"
FROM (
    SELECT cited."publication_number",
           COUNT(DISTINCT network."citing_app_no") AS "forward_cite_count"
    FROM (
        SELECT f.value::VARIANT:"publication_number"::STRING AS "cited_pub",
               p."application_number"                        AS "citing_app_no",
               p."filing_date"                               AS "citing_filing_date"
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(input => p."citation") f
    ) network
    JOIN PATENTS.PATENTS.PUBLICATIONS cited
          ON cited."publication_number" = network."cited_pub"
    WHERE cited."application_kind" = 'U'
      AND cited."grant_date" BETWEEN 20100101 AND 20101231
      AND network."citing_filing_date" BETWEEN cited."filing_date" 
                                           AND cited."filing_date" + 100000  -- 10-year window
    GROUP BY cited."publication_number"
    HAVING COUNT(DISTINCT network."citing_app_no") = 1
) final;
```
