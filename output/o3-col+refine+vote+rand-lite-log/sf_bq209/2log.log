Query:
--Description: 8. For patents granted in 2010 (utility kind), count distinct forward-citing applications that fall within 10-year window from the cited patent’s filing date.
SELECT cited."publication_number",
       COUNT(DISTINCT network."citing_app_no") AS "forward_cite_count"
FROM (
    SELECT f.value::VARIANT:"publication_number"::STRING AS "cited_pub",
           p."application_number"                        AS "citing_app_no",
           p."filing_date"                               AS "citing_filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") f
) network
JOIN PATENTS.PATENTS.PUBLICATIONS cited
      ON cited."publication_number" = network."cited_pub"
WHERE cited."application_kind" = 'U'
  AND cited."grant_date" BETWEEN 20100101 AND 20101231
  AND network."citing_filing_date" BETWEEN cited."filing_date" 
                                       AND cited."filing_date" + 100000  -- ≈ 10 years in YYYYMMDD
GROUP BY cited."publication_number"
LIMIT 20;
Answer:
publication_number,forward_cite_count
CN-201620562-U,1
CN-201400470-Y,1
CN-201427255-Y,1
Query:
--Description: 9. Retrieve those 2010-granted utility patents which have exactly one forward citation in the 10-year window.
SELECT *
FROM (
    SELECT cited."publication_number",
           COUNT(DISTINCT network."citing_app_no") AS "forward_cite_count"
    FROM (
        SELECT f.value::VARIANT:"publication_number"::STRING AS "cited_pub",
               p."application_number"                        AS "citing_app_no",
               p."filing_date"                               AS "citing_filing_date"
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(input => p."citation") f
    ) network
    JOIN PATENTS.PATENTS.PUBLICATIONS cited
          ON cited."publication_number" = network."cited_pub"
    WHERE cited."application_kind" = 'U'
      AND cited."grant_date" BETWEEN 20100101 AND 20101231
      AND network."citing_filing_date" BETWEEN cited."filing_date" 
                                           AND cited."filing_date" + 100000  -- 10-year window
    GROUP BY cited."publication_number"
) q
WHERE q."forward_cite_count" = 1
LIMIT 20;
Answer:
publication_number,forward_cite_count
CN-201620562-U,1
CN-201427255-Y,1
CN-201400470-Y,1
Query:
--Description: 10. Aggregate the final count of such patents (utility, granted 2010, exactly one forward citation within 10 years).
SELECT COUNT(*) AS "num_utility_patents_granted_2010_with_one_forward_citation"
FROM (
    SELECT cited."publication_number",
           COUNT(DISTINCT network."citing_app_no") AS "forward_cite_count"
    FROM (
        SELECT f.value::VARIANT:"publication_number"::STRING AS "cited_pub",
               p."application_number"                        AS "citing_app_no",
               p."filing_date"                               AS "citing_filing_date"
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(input => p."citation") f
    ) network
    JOIN PATENTS.PATENTS.PUBLICATIONS cited
          ON cited."publication_number" = network."cited_pub"
    WHERE cited."application_kind" = 'U'
      AND cited."grant_date" BETWEEN 20100101 AND 20101231
      AND network."citing_filing_date" BETWEEN cited."filing_date" 
                                           AND cited."filing_date" + 100000  -- 10-year window
    GROUP BY cited."publication_number"
    HAVING COUNT(DISTINCT network."citing_app_no") = 1
) final;
