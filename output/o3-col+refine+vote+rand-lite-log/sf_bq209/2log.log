    JOIN PATENTS.PATENTS.PUBLICATIONS cited
          ON cited."publication_number" = network."cited_pub"
    WHERE cited."application_kind" = 'U'
      AND cited."grant_date" BETWEEN 20100101 AND 20101231
      AND network."citing_filing_date" BETWEEN cited."filing_date" 
                                           AND cited."filing_date" + 100000  -- 10-year window
    GROUP BY cited."publication_number"
    HAVING COUNT(DISTINCT network."citing_app_no") = 1
) final;
