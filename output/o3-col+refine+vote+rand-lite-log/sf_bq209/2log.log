Query:
--Description: 6. Build a simple citation network: each row is (cited_pub, citing_application_number, citing_filing_date).
SELECT f.value::VARIANT:"publication_number"::STRING            AS "cited_pub",
       p."application_number"                                   AS "citing_app_no",
       p."filing_date"                                          AS "citing_filing_date"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."application_number" IS NOT NULL
  AND f.value::VARIANT:"publication_number" IS NOT NULL
LIMIT 20;
