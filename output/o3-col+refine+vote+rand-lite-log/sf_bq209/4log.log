       f.value:"publication_number"::STRING AS "cited_pub_number",
       f.value:"application_number"::STRING AS "cited_app_number"
FROM   PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."citation") f
LIMIT  20;
