Query:
--Description: 9) Forward-citation count restricted to a 10-year window post-filing – corrected join syntax
WITH cites AS (
     SELECT  p2."application_number"                       AS "citing_app",
             p2."filing_date"                              AS "citing_filing_date",
             f.value:"publication_number"::STRING          AS "cited_pub_number"
     FROM    PATENTS.PATENTS.PUBLICATIONS                  p2
     CROSS JOIN LATERAL FLATTEN(input => p2."citation")    f
)
SELECT  p1."publication_number",
        COUNT(DISTINCT cites."citing_app") AS "num_forward_citations"
FROM    PATENTS.PATENTS.PUBLICATIONS      p1
LEFT JOIN cites
       ON cites."cited_pub_number" = p1."publication_number"
      AND DATEDIFF(
            year,
            TO_DATE(TO_CHAR(p1."filing_date"),  'YYYYMMDD'),
            TO_DATE(TO_CHAR(cites."citing_filing_date"), 'YYYYMMDD')
          ) <= 10
WHERE   p1."grant_date"       BETWEEN 20100101 AND 20101231
  AND   p1."application_kind" = 'U'
GROUP BY p1."publication_number"
HAVING  COUNT(DISTINCT cites."citing_app") = 1
LIMIT   20
