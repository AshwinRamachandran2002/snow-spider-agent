```sql
--Description: 7) For 2010-granted utility patents, count ALL distinct forward-citations (no 10-year limit) – corrected join syntax
SELECT  p1."publication_number",
        COUNT(DISTINCT c."citing_app") AS "forward_cite_total"
FROM    PATENTS.PATENTS.PUBLICATIONS            p1
LEFT JOIN (
           /* build citing→cited mapping */
           SELECT  p2."application_number"                       AS "citing_app",
                   f.value:"publication_number"::STRING          AS "cited_pub_number"
           FROM    PATENTS.PATENTS.PUBLICATIONS                  p2
           CROSS JOIN LATERAL FLATTEN(input => p2."citation")    f
          )                                                     c
       ON  c."cited_pub_number" = p1."publication_number"
WHERE   p1."grant_date"       BETWEEN 20100101 AND 20101231
  AND   p1."application_kind" = 'U'
GROUP BY p1."publication_number"
LIMIT   20;
```

```sql
--Description: 8) Quick check that filing-date values exist (unchanged query)
SELECT "publication_number",
       "filing_date"
