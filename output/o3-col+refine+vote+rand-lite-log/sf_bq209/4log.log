```sql
--Description / thinking process:
-- Goal: find a sample of forward-citation links (cited → citing).
-- Steps:
-- 1. Take PUBLICATIONS as p2 = possible citing docs.
-- 2. Flatten p2."citation" JSON (CROSS JOIN LATERAL FLATTEN) so each cited
--    publication referenced by p2 becomes one row (alias f).
-- 3. Join that flattened cited publication number back to PUBLICATIONS (p1)
--    to ensure the cited document exists in the same dataset.
-- 4. Return both publication numbers; LIMIT 20 just to inspect structure.

SELECT  p1."publication_number" AS "cited_pub",
        p2."publication_number" AS "citing_pub"
FROM    PATENTS.PATENTS.PUBLICATIONS            p2
CROSS JOIN LATERAL FLATTEN(input => p2."citation") f
JOIN    PATENTS.PATENTS.PUBLICATIONS            p1
      ON f.value:"publication_number"::STRING = p1."publication_number"
LIMIT   20;
```
