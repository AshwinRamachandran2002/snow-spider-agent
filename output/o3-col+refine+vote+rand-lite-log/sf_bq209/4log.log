```

```sql
--Description: 2) Inspect the distinct values held in the “application_kind” field
SELECT DISTINCT "application_kind"
FROM   PATENTS.PATENTS.PUBLICATIONS
LIMIT  20;
```

```sql
--Description: 3) Sample patents whose grant date falls in calendar-year 2010
SELECT "publication_number",
       "application_number",
       "application_kind",
       "filing_date",
       "grant_date"
FROM   PATENTS.PATENTS.PUBLICATIONS
WHERE  "grant_date" BETWEEN 20100101 AND 20101231
LIMIT  20;
```

```sql
--Description: 4) Same as above, but keep only utility patents (“U” kind)
SELECT "publication_number",
       "application_number",
       "filing_date",
       "grant_date"
FROM   PATENTS.PATENTS.PUBLICATIONS
WHERE  "grant_date" BETWEEN 20100101 AND 20101231
  AND  "application_kind" = 'U'
LIMIT  20;
```

```sql
--Description: 5) Flatten the “citation” array to see the structure of one citation element
SELECT t."publication_number"               AS "this_pub",
       f.value:"publication_number"::STRING AS "cited_pub_number",
       f.value:"application_number"::STRING AS "cited_app_number"
FROM   PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."citation") f
LIMIT  20;
```

```sql
--Description: 6) Show one example of a cited–citing pair (p1 is cited by p2)
SELECT p1."publication_number" AS "cited_pub",
       p2."publication_number" AS "citing_pub"
FROM   PATENTS.PATENTS.PUBLICATIONS  p1
JOIN   PATENTS.PATENTS.PUBLICATIONS  p2,
       LATERAL FLATTEN(input => p2."citation") f
       ON  f.value:"publication_number"::STRING = p1."publication_number"
LIMIT  20;
```

```sql
--Description: 7) For 2010-granted utility patents, count *all* distinct forward citations
SELECT p1."publication_number",
       COUNT(DISTINCT p2."application_number") AS "forward_cite_total"
FROM   PATENTS.PATENTS.PUBLICATIONS p1
LEFT JOIN PATENTS.PATENTS.PUBLICATIONS p2,
     LATERAL FLATTEN(input => p2."citation") f
       ON f.value:"publication_number"::STRING = p1."publication_number"
WHERE  p1."grant_date" BETWEEN 20100101 AND 20101231
  AND  p1."application_kind" = 'U'
GROUP BY p1."publication_number"
LIMIT  20;
```

```sql
--Description: 8) Verify filing-date values are present (needed for 10-year window)
SELECT "publication_number",
       "filing_date"
FROM   PATENTS.PATENTS.PUBLICATIONS
WHERE  "filing_date" IS NOT NULL
LIMIT  20;
```

```sql
--Description: 9) Forward-citation count restricted to 10-year window after original filing
SELECT p1."publication_number",
       COUNT(DISTINCT p2."application_number") AS "num_forward_citations"
FROM   PATENTS.PATENTS.PUBLICATIONS p1
LEFT JOIN PATENTS.PATENTS.PUBLICATIONS p2,
     LATERAL FLATTEN(input => p2."citation") c
       ON  c.value:"publication_number"::STRING = p1."publication_number"
       AND DATEDIFF('year',
                    TO_DATE(TO_CHAR(p1."filing_date"), 'YYYYMMDD'),
                    TO_DATE(TO_CHAR(p2."filing_date"), 'YYYYMMDD')) <= 10
WHERE  p1."grant_date" BETWEEN 20100101 AND 20101231
  AND  p1."application_kind" = 'U'
GROUP BY p1."publication_number"
HAVING COUNT(DISTINCT p2."application_number") = 1
LIMIT  20;
```

```sql
--Description: 10) Final answer – total number of 2010-granted utility patents
--               that have exactly one forward citation within 10 years
SELECT COUNT(*) AS "num_utility_patents_2010_with_one_forward_citation_within_10y"
FROM (
      SELECT p1."publication_number"
      FROM   PATENTS.PATENTS.PUBLICATIONS p1
      LEFT JOIN PATENTS.PATENTS.PUBLICATIONS p2,
           LATERAL FLATTEN(input => p2."citation") c
             ON  c.value:"publication_number"::STRING = p1."publication_number"
             AND DATEDIFF('year',
                          TO_DATE(TO_CHAR(p1."filing_date"), 'YYYYMMDD'),
                          TO_DATE(TO_CHAR(p2."filing_date"), 'YYYYMMDD')) <= 10
      WHERE  p1."grant_date" BETWEEN 20100101 AND 20101231
        AND  p1."application_kind" = 'U'
      GROUP BY p1."publication_number"
      HAVING COUNT(DISTINCT p2."application_number") = 1
     );
```
