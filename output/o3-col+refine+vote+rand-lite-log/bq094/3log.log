```sql
--Description: Look at a handful of rows in the 2016 committee-to-candidate contribution file  
--(verifies the columns we will later aggregate for “committees that supported candidates”)
SELECT *
FROM `bigquery-public-data.fec.committee_contributions_2016`
LIMIT 20;
```

```sql
--Description: Check distinct committees that made *any* contribution to a candidate in 2016
SELECT DISTINCT cmte_id
FROM `bigquery-public-data.fec.committee_contributions_2016`
LIMIT 20;
```

```sql
--Description: Inspect the 2016 individual-contribution file to confirm the column that 
--holds dollar amounts we will filter between $0 and $200
SELECT *
FROM `bigquery-public-data.fec.individuals_2016`
LIMIT 20;
```

```sql
--Description: For each committee, add up ONLY the “small-dollar” individual contributions 
--( >0 and <200 ) to be sure the numbers look reasonable
SELECT
  cmte_id,
  COUNTIF(transaction_amt > 0 AND transaction_amt < 200) AS num_small_tx,
  SUM(CASE WHEN transaction_amt > 0 AND transaction_amt < 200 THEN transaction_amt END) AS small_dollar_total
FROM `bigquery-public-data.fec.individuals_2016`
GROUP BY cmte_id
HAVING small_dollar_total > 0
LIMIT 20;
```

```sql
--Description: Pull one example committee to see the candidate names it supported
SELECT
  cmte_id,
  name                      AS candidate_name,
  transaction_amt           AS amt_to_candidate
FROM `bigquery-public-data.fec.committee_contributions_2016`
WHERE cmte_id = 'C00027342'   -- sample picked from earlier output
LIMIT 20;
```

```sql
--Description: For every committee, list the UNIQUE candidate names it supported in 2016
SELECT
  cmte_id,
  ARRAY_AGG(DISTINCT name ORDER BY name) AS candidate_names
FROM `bigquery-public-data.fec.committee_contributions_2016`
GROUP BY cmte_id
LIMIT 20;
```

```sql
--Description: Combine the two sources:  
--(1) committees that gave to at least one candidate, and  
--(2) committees whose 2016 individual small-dollar receipts are >0 and <200 in total.  
--Provide committee id, number of unique candidates, alphabetized candidate list,
--and the summed small-dollar total.
SELECT
  cand.cmte_id                             AS committee_id,
  ARRAY_LENGTH(cand.candidate_names)       AS num_unique_candidates_supported,
  ARRAY_TO_STRING(cand.candidate_names, ', ') AS candidates_supported_alpha,
  ind.small_dollar_total                   AS total_small_dollar_received
FROM (
  -- sub-query: committees & the candidates they supported
  SELECT
    cmte_id,
    ARRAY_AGG(DISTINCT name ORDER BY name) AS candidate_names
  FROM `bigquery-public-data.fec.committee_contributions_2016`
  GROUP BY cmte_id
) AS cand
JOIN (
  -- sub-query: committees that received >0 & <200 individual $ and sum>0
  SELECT
    cmte_id,
    SUM(transaction_amt) AS small_dollar_total
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE transaction_amt > 0
    AND transaction_amt < 200
  GROUP BY cmte_id
  HAVING small_dollar_total > 0
) AS ind
ON cand.cmte_id = ind.cmte_id
ORDER BY total_small_dollar_received DESC
LIMIT 20;
```

```sql
--Description: Same as previous query but WITHOUT the LIMIT clause – gives the full required answer.  
--Run this after verifying the above sample results.
SELECT
  cand.cmte_id                               AS committee_id,
  ARRAY_LENGTH(cand.candidate_names)         AS num_unique_candidates_supported,
  ARRAY_TO_STRING(cand.candidate_names, ', ') AS candidates_supported_alpha,
  ind.small_dollar_total                     AS total_small_dollar_received
FROM (
  SELECT
    cmte_id,
    ARRAY_AGG(DISTINCT name ORDER BY name) AS candidate_names
  FROM `bigquery-public-data.fec.committee_contributions_2016`
  GROUP BY cmte_id
) AS cand
JOIN (
  SELECT
    cmte_id,
    SUM(transaction_amt) AS small_dollar_total
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE transaction_amt > 0
    AND transaction_amt < 200
  GROUP BY cmte_id
  HAVING small_dollar_total > 0
) AS ind
ON cand.cmte_id = ind.cmte_id
ORDER BY total_small_dollar_received DESC;
```

```sql
--Description: If desired, check the committees whose *total* individual contributions (all sizes)
--were under $200 to confirm our filter is strictly using small-dollar receipts only.
SELECT
  i.cmte_id,
  SUM(i.transaction_amt) AS all_dollars,
  SUM(CASE WHEN i.transaction_amt > 0 AND i.transaction_amt < 200 THEN i.transaction_amt END) AS small_dollars_only
FROM `bigquery-public-data.fec.individuals_2016` AS i
GROUP BY i.cmte_id
HAVING small_dollars_only > 0
LIMIT 20;
```

```sql
--Description: Double-check any committee in the final list to make sure it really supported 
--the number of candidates we are reporting (example shown for ID ‘C00027342’)
SELECT DISTINCT cmte_id, cand_id, name
FROM `bigquery-public-data.fec.committee_contributions_2016`
WHERE cmte_id = 'C00027342'
ORDER BY name;
```
