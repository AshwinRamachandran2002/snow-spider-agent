--Description: To find how many committees show up in BOTH tables, we
-- 1) pull each table’s distinct cmte_id (as STRING everywhere to keep types aligned),
-- 2) join on those ids (inner-join ≈ INTERSECT), and
-- 3) count the resulting distinct ids.  
-- This avoids the INT64 vs. STRING mismatch that broke the original INTERSECT.
SELECT COUNT(DISTINCT i.cmte_id) AS committees_with_both_sources
FROM  (SELECT DISTINCT CAST(cmte_id AS STRING) AS cmte_id
       FROM `bigquery-public-data.fec.individuals_2016`)  AS i
JOIN  (SELECT DISTINCT cmte_id
       FROM `bigquery-public-data.fec.committee_contributions_2016`) AS c
ON    i.cmte_id = c.cmte_id;
