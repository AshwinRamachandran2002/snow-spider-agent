          AND   transaction_amt < 200
        GROUP BY cmte_id
       )
WHERE  small_dollar_sum >= 200;
```

```sql
-- 9. Inspect how often a committee appears in both source tables before joins  
SELECT  COUNT(*) AS committees_with_both_sources
