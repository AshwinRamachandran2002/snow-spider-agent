```sql
-- 1. Preview individual–to–committee contributions that will later be treated 
--    as the “small-dollar” pool (< $200 and > $0)   
SELECT *
FROM   `bigquery-public-data.fec.individuals_2016`
LIMIT  20;
```

```sql
-- 2. Look only at the truly “small-dollar” contributions (> $0 & < $200)  
SELECT *
FROM   `bigquery-public-data.fec.individuals_2016`
WHERE  transaction_amt > 0 
  AND  transaction_amt < 200
LIMIT  20;
```

```sql
-- 3. Aggregate those small-dollar gifts by committee (cmte_id) and calculate
--    their total value and number of such gifts per committee  
SELECT  cmte_id,
        COUNT(*)                       AS small_dollar_cnt,
        SUM(transaction_amt)           AS small_dollar_sum
FROM    `bigquery-public-data.fec.individuals_2016`
WHERE   transaction_amt > 0
  AND   transaction_amt < 200
GROUP BY cmte_id
HAVING  small_dollar_sum > 0      -- keep only committees that actually got money
ORDER BY small_dollar_sum DESC
LIMIT  20;
```

```sql
-- 4. Preview committee-to-candidate giving in 2016.  Each positive row means  
--    the committee “supported” the candidate shown in the name column.  
SELECT *
FROM   `bigquery-public-data.fec.committee_contributions_2016`
LIMIT  20;
```

```sql
-- 5. For every donor committee, collect the set of candidates it helped and how
--    many distinct candidates that is.  Only positive dollar grants are kept.  
SELECT  cmte_id,
        COUNT(DISTINCT cand_id)                                    AS supported_candidate_cnt,
        STRING_AGG(DISTINCT name ORDER BY name)                   AS supported_candidates
FROM    `bigquery-public-data.fec.committee_contributions_2016`
WHERE   transaction_amt > 0
GROUP BY cmte_id
ORDER BY supported_candidate_cnt DESC
LIMIT  20;
```

```sql
-- 6. Join the two aggregates: committees (a) that backed ≥1 candidate and  
--    (b) whose total small-dollar individual gifts are in (0, 200).          
SELECT  s.cmte_id,
        c.supported_candidate_cnt,
        c.supported_candidates,
        s.small_dollar_sum
FROM   (
        -- small-dollar aggregate (query-3 reused)
        SELECT  cmte_id,
                SUM(transaction_amt) AS small_dollar_sum
        FROM    `bigquery-public-data.fec.individuals_2016`
        WHERE   transaction_amt > 0
          AND   transaction_amt < 200
        GROUP BY cmte_id
        HAVING  small_dollar_sum > 0
       )  AS s
JOIN   (
        -- candidate-support aggregate (query-5 reused)
        SELECT  cmte_id,
                COUNT(DISTINCT cand_id)               AS supported_candidate_cnt,
                STRING_AGG(DISTINCT name ORDER BY name) AS supported_candidates
        FROM    `bigquery-public-data.fec.committee_contributions_2016`
        WHERE   transaction_amt > 0
        GROUP BY cmte_id
       ) AS c
ON     s.cmte_id = c.cmte_id
WHERE  s.small_dollar_sum < 200
LIMIT  20;
```

```sql
-- 7. FINAL query – same logic as #6 but also tries to pick up the committee’s  
--    formal name when available in the “other committee tx” file; if not 
--    found, the cmte_id itself is used as a fallback label.                   
SELECT  COALESCE(o.name, s.cmte_id)                     AS committee_name,
        c.supported_candidate_cnt                       AS num_candidates_supported,
        c.supported_candidates                          AS candidates_supported_alpha,
        s.small_dollar_sum                              AS total_small_dollar
FROM   (
        -- small-dollar aggregate
        SELECT  cmte_id,
                SUM(transaction_amt) AS small_dollar_sum
        FROM    `bigquery-public-data.fec.individuals_2016`
        WHERE   transaction_amt > 0
          AND   transaction_amt < 200
        GROUP BY cmte_id
        HAVING  small_dollar_sum > 0
       ) AS s
JOIN   (
        -- candidate-support aggregate
        SELECT  cmte_id,
                COUNT(DISTINCT cand_id)                 AS supported_candidate_cnt,
                STRING_AGG(DISTINCT name ORDER BY name) AS supported_candidates
        FROM    `bigquery-public-data.fec.committee_contributions_2016`
        WHERE   transaction_amt > 0
        GROUP BY cmte_id
       ) AS c
ON     s.cmte_id = c.cmte_id
LEFT JOIN (
        -- attempt to map cmte_id → human-readable name via another 2016 table
        SELECT DISTINCT cmte_id, name
        FROM   `bigquery-public-data.fec.other_committee_tx_2016`
       ) AS o
ON     s.cmte_id = o.cmte_id
WHERE  s.small_dollar_sum < 200
LIMIT  20;
```

```sql
-- 8. If you want to double-check that no committee slipped through with  
--    small-dollar totals ≥ $200, run this sanity check.  
