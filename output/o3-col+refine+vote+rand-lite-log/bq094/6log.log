```sql
--Description: Lists committees whose accumulated small-dollar individual
--             contributions fall between $0 and $50 (exclusive of $0) and
--             shows the exact total.  It also attempts to attach a readable
--             committee name from the 2016 “other_committee_tx” table.
--             All joins keep the STRING data type for cmte_id, so no
--             INT64-vs-STRING mismatch arises.
SELECT
    COALESCE(o.name, s.cmte_id) AS committee_name,
    s.small_dollar_sum
FROM (
    -- Aggregate small-dollar individual gifts per committee
    SELECT
        cmte_id,
        SUM(transaction_amt) AS small_dollar_sum
    FROM `bigquery-public-data.fec.individuals_2016`
    WHERE transaction_amt > 0
      AND transaction_amt < 200
    GROUP BY cmte_id
    HAVING small_dollar_sum > 0
       AND small_dollar_sum < 50          -- “barely made the cut”
) AS s
LEFT JOIN (
    -- Map committee IDs to human-readable names
    SELECT DISTINCT cmte_id, name
    FROM `bigquery-public-data.fec.other_committee_tx_2016`
) AS o
ON s.cmte_id = o.cmte_id
LIMIT 20;
```
