Query:
-- 7. FINAL query – same logic as #6 but also tries to pick up the committee’s  
--    formal name when available in the “other committee tx” file; if not 
--    found, the cmte_id itself is used as a fallback label.                   
SELECT  COALESCE(o.name, s.cmte_id)                     AS committee_name,
        c.supported_candidate_cnt                       AS num_candidates_supported,
        c.supported_candidates                          AS candidates_supported_alpha,
        s.small_dollar_sum                              AS total_small_dollar
FROM   (
        -- small-dollar aggregate
        SELECT  cmte_id,
                SUM(transaction_amt) AS small_dollar_sum
        FROM    `bigquery-public-data.fec.individuals_2016`
        WHERE   transaction_amt > 0
          AND   transaction_amt < 200
        GROUP BY cmte_id
        HAVING  small_dollar_sum > 0
       ) AS s
JOIN   (
        -- candidate-support aggregate
        SELECT  cmte_id,
                COUNT(DISTINCT cand_id)                 AS supported_candidate_cnt,
                STRING_AGG(DISTINCT name ORDER BY name) AS supported_candidates
        FROM    `bigquery-public-data.fec.committee_contributions_2016`
        WHERE   transaction_amt > 0
        GROUP BY cmte_id
       ) AS c
ON     s.cmte_id = c.cmte_id
LEFT JOIN (
        -- attempt to map cmte_id → human-readable name via another 2016 table
        SELECT DISTINCT cmte_id, name
        FROM   `bigquery-public-data.fec.other_committee_tx_2016`
       ) AS o
ON     s.cmte_id = o.cmte_id
WHERE  s.small_dollar_sum < 200
LIMIT  20;
