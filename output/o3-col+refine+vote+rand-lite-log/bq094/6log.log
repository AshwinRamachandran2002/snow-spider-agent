-- 3. Aggregate those small-dollar gifts by committee (cmte_id) and calculate
--    their total value and number of such gifts per committee  
SELECT  cmte_id,
        COUNT(*)                       AS small_dollar_cnt,
        SUM(transaction_amt)           AS small_dollar_sum
FROM    `bigquery-public-data.fec.individuals_2016`
WHERE   transaction_amt > 0
  AND   transaction_amt < 200
GROUP BY cmte_id
HAVING  small_dollar_sum > 0      -- keep only committees that actually got money
ORDER BY small_dollar_sum DESC
LIMIT  20;
