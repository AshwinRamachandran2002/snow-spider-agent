Query:
-- 5. For every donor committee, collect the set of candidates it helped and how
--    many distinct candidates that is.  Only positive dollar grants are kept.  
SELECT  cmte_id,
        COUNT(DISTINCT cand_id)                                    AS supported_candidate_cnt,
        STRING_AGG(DISTINCT name ORDER BY name)                   AS supported_candidates
FROM    `bigquery-public-data.fec.committee_contributions_2016`
WHERE   transaction_amt > 0
GROUP BY cmte_id
ORDER BY supported_candidate_cnt DESC
LIMIT  20;
