```sql
--Description: 1) Look at a few individual-contribution records for 2016
SELECT *
FROM `bigquery-public-data.fec.individuals_2016`
LIMIT 20;
```

```sql
--Description: 2) What do “small-dollar” (0 < amt < 200) donations look like?
SELECT DISTINCT `cmte_id`, `transaction_amt`
FROM `bigquery-public-data.fec.individuals_2016`
WHERE `transaction_amt` > 0
  AND `transaction_amt` < 200
LIMIT 20;
```

```sql
--Description: 3) Aggregate those small-dollar donations by committee
SELECT `cmte_id`,
       COUNT(*)                       AS small_donation_cnt,
       SUM(`transaction_amt`)         AS small_donation_total
FROM `bigquery-public-data.fec.individuals_2016`
WHERE `transaction_amt` > 0
  AND `transaction_amt` < 200
GROUP BY `cmte_id`
HAVING small_donation_total > 0      -- exclude committees with no qualifying dollars
LIMIT 20;
```

```sql
--Description: 4) Inspect 2016 committee-to-candidate contribution records
SELECT *
FROM `bigquery-public-data.fec.committee_contributions_2016`
LIMIT 20;
```

```sql
--Description: 5) Identify each committee that backed at least one candidate and count the candidates
SELECT `cmte_id`,
       COUNT(DISTINCT `cand_id`) AS unique_candidate_cnt
FROM `bigquery-public-data.fec.committee_contributions_2016`
GROUP BY `cmte_id`
LIMIT 20;
```

```sql
--Description: 6) Combine the two prior result sets: committees that BOTH (a) gave to candidates
-- and (b) received any small-dollar individual money (0–200)
SELECT cc.`cmte_id`
FROM   `bigquery-public-data.fec.committee_contributions_2016`  AS cc
JOIN   (
         SELECT `cmte_id`
         FROM `bigquery-public-data.fec.individuals_2016`
         WHERE `transaction_amt` > 0 AND `transaction_amt` < 200
         GROUP BY `cmte_id`
       ) AS sm USING (`cmte_id`)
GROUP BY cc.`cmte_id`
LIMIT 20;
```

```sql
--Description: 7) Pull the candidate names a qualifying committee supported (distinct & alphabetized)
SELECT cc.`cmte_id`,
       STRING_AGG(DISTINCT cc.`name`, ', ' ORDER BY cc.`name`) AS supported_candidate_names
FROM   `bigquery-public-data.fec.committee_contributions_2016` AS cc
WHERE  cc.`cmte_id` IN (
        -- list of committees from step 6 (simplified here for illustration)  
        SELECT `cmte_id`
        FROM `bigquery-public-data.fec.committee_contributions_2016`
        GROUP BY `cmte_id`
        HAVING COUNT(DISTINCT `cand_id`) > 0
      )
GROUP BY cc.`cmte_id`
LIMIT 20;
```

```sql
--Description: 8) List every committee whose TOTAL of all qualifying small-dollar gifts
-- is > 0 and ≤ 200  (inclusive of the upper bound)
SELECT `cmte_id`,
       SUM(`transaction_amt`) AS total_small_dollars
FROM   `bigquery-public-data.fec.individuals_2016`
WHERE  `transaction_amt` > 0 AND `transaction_amt` <= 200
GROUP  BY `cmte_id`
HAVING total_small_dollars <= 200      -- upper-limit filter
LIMIT 20;
```

```sql
--Description: 9) FINAL – committees that satisfy ALL conditions, with required output columns
SELECT  csmall.`cmte_id`                                          AS committee_id_or_name,
        COUNT(DISTINCT cc.`cand_id`)                              AS unique_candidates_supported,
        STRING_AGG(DISTINCT cc.`name`, ', ' ORDER BY cc.`name`)   AS candidates_supported_alpha,
        csmall.total_small_dollars                                AS total_small_dollar_amt
FROM  (
        -- small-dollar committee list (sum between 0 and 200, inclusive)
        SELECT `cmte_id`,
               SUM(`transaction_amt`) AS total_small_dollars
        FROM   `bigquery-public-data.fec.individuals_2016`
        WHERE  `transaction_amt` > 0 AND `transaction_amt` <= 200
        GROUP  BY `cmte_id`
        HAVING total_small_dollars > 0 AND total_small_dollars <= 200
      )                        AS csmall
JOIN  `bigquery-public-data.fec.committee_contributions_2016` AS cc
      ON cc.`cmte_id` = csmall.`cmte_id`
GROUP BY committee_id_or_name, total_small_dollar_amt
LIMIT 20;
```

Each successive query deepens the analysis—starting with sampling data, then filtering for “small-dollar” gifts, identifying candidate-supporting committees, and finally producing the requested summary list.
