Query:
--Description: 9) FINAL – committees that satisfy ALL conditions, with required output columns
SELECT  csmall.`cmte_id`                                          AS committee_id_or_name,
        COUNT(DISTINCT cc.`cand_id`)                              AS unique_candidates_supported,
        STRING_AGG(DISTINCT cc.`name`, ', ' ORDER BY cc.`name`)   AS candidates_supported_alpha,
        csmall.total_small_dollars                                AS total_small_dollar_amt
FROM  (
        -- small-dollar committee list (sum between 0 and 200, inclusive)
        SELECT `cmte_id`,
               SUM(`transaction_amt`) AS total_small_dollars
        FROM   `bigquery-public-data.fec.individuals_2016`
        WHERE  `transaction_amt` > 0 AND `transaction_amt` <= 200
        GROUP  BY `cmte_id`
        HAVING total_small_dollars > 0 AND total_small_dollars <= 200
      )                        AS csmall
JOIN  `bigquery-public-data.fec.committee_contributions_2016` AS cc
      ON cc.`cmte_id` = csmall.`cmte_id`
GROUP BY committee_id_or_name, total_small_dollar_amt
LIMIT 20;
Answer:
committee_id_or_name,unique_candidates_supported,candidates_supported_alpha,total_small_dollar_amt
