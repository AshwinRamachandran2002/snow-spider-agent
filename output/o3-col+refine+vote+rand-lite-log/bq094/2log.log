--Description: 2)  Aggregate those small-dollar gifts by committee to see which
--               committees receive BETWEEN $0 and $200 in TOTAL (but >$0).
SELECT
  `cmte_id`,
  COUNT(*)                       AS num_small_txns,
  SUM(`transaction_amt`)         AS total_small_amt
FROM `bigquery-public-data.fec.individuals_2016`
WHERE `transaction_amt` > 0
  AND `transaction_amt` < 200
GROUP BY `cmte_id`
HAVING total_small_amt > 0        -- more than $0 overall
   AND total_small_amt < 200      -- but under $200 in total
LIMIT 20;
