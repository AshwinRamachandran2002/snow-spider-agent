--Description: 8)  Join (a) committees that supported ≥1 candidate with
--               (b) committees whose total small-dollar receipts are >$0 & <$200.
--               Fixes: exclude NULL `cand_id`; use STRING_AGG(DISTINCT name …)
--               (no ANY_VALUE inside STRING_AGG).
WITH small_tot AS (                       -- (b) committees w/ small-dollar $
  SELECT
    `cmte_id`,
    SUM(`transaction_amt`) AS small_sum
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE `transaction_amt` > 0
