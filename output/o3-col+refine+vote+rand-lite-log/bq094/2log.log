--Description: 1)  Peek at small-dollar individual contributions ( >0 and <200 ) that were
--               given to 2016 committees.  This tells us how the data look in
--               `individuals_2016`.
SELECT
  `cmte_id`,
  `name`,
  `transaction_amt`
FROM `bigquery-public-data.fec.individuals_2016`
WHERE `transaction_amt` > 0          -- positive only
  AND `transaction_amt` < 200        -- small-dollar
LIMIT 20;
