```sql
--Description: 1)  Peek at small-dollar individual contributions ( >0 and <200 ) that were
--               given to 2016 committees.  This tells us how the data look in
--               `individuals_2016`.
SELECT
  `cmte_id`,
  `name`,
  `transaction_amt`
FROM `bigquery-public-data.fec.individuals_2016`
WHERE `transaction_amt` > 0          -- positive only
  AND `transaction_amt` < 200        -- small-dollar
LIMIT 20;
```

```sql
--Description: 2)  Aggregate those small-dollar gifts by committee to see which
--               committees receive BETWEEN $0 and $200 in TOTAL (but >$0).
SELECT
  `cmte_id`,
  COUNT(*)                       AS num_small_txns,
  SUM(`transaction_amt`)         AS total_small_amt
FROM `bigquery-public-data.fec.individuals_2016`
WHERE `transaction_amt` > 0
  AND `transaction_amt` < 200
GROUP BY `cmte_id`
HAVING total_small_amt > 0        -- more than $0 overall
   AND total_small_amt < 200      -- but under $200 in total
LIMIT 20;
```

```sql
--Description: 3)  Look at committee-to-candidate support transactions in the
--               2016 committee-contribution file.
SELECT
  `cmte_id`,
  `cand_id`,
  `name`              AS cand_cmte_or_name,
  `transaction_amt`
FROM `bigquery-public-data.fec.committee_contributions_2016`
WHERE `transaction_amt` > 0        -- support (not refunds)
LIMIT 20;
```

```sql
--Description: 4)  For each committee, list every DISTINCT candidate it helped
--               (using the id that appears in the 2016 contributions file).
SELECT
  `cmte_id`,
  ARRAY_AGG(DISTINCT `cand_id`) AS supported_candidate_ids
FROM `bigquery-public-data.fec.committee_contributions_2016`
GROUP BY `cmte_id`
LIMIT 20;
```

```sql
--Description: 5)  Get a quick mapping from candidate-id to one example of the
--               candidate’s name / committee description that appears in the
--               file.  This will let us turn candidate IDs into readable names.
SELECT
  `cand_id`,
  ANY_VALUE(`name`) AS candidate_name_sample
FROM `bigquery-public-data.fec.committee_contributions_2016`
GROUP BY `cand_id`
LIMIT 20;
```

```sql
--Description: 6)  Count how many UNIQUE candidates each committee helped
--               during 2016.
SELECT
  `cmte_id`,
  COUNT(DISTINCT `cand_id`) AS num_candidates_supported
FROM `bigquery-public-data.fec.committee_contributions_2016`
GROUP BY `cmte_id`
LIMIT 20;
```

```sql
--Description: 7)  Sum up each committee’s TOTAL of small-dollar individual
--               receipts ( >0 & <200 ) so we can join to the support list later.
WITH small_cte AS (
  SELECT
    `cmte_id`,
    SUM(`transaction_amt`) AS small_total
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE `transaction_amt` > 0
    AND `transaction_amt` < 200
  GROUP BY `cmte_id`
)
SELECT *
FROM small_cte
WHERE small_total > 0
  AND small_total < 200
LIMIT 20;
```

```sql
--Description: 8)  Combine the two data sets: committees that BOTH (a) supported
--               at least one candidate AND (b) received >$0 & <$200 total in
--               small-dollar gifts.  Return committee id, #candidates, the
--               alphabetised list of candidate names, and the small-dollar sum.
WITH small_tot AS (                     -- (b) committees w/ small-dollar $
  SELECT
    `cmte_id`,
    SUM(`transaction_amt`) AS small_sum
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE `transaction_amt` > 0
    AND `transaction_amt` < 200
  GROUP BY `cmte_id`
  HAVING small_sum > 0
     AND small_sum < 200
),
cand_list AS (                           -- (a) who each committee supported
  SELECT
    `cmte_id`,
    COUNT(DISTINCT `cand_id`)                                AS num_cand,
    STRING_AGG(DISTINCT ANY_VALUE(`name`) ORDER BY `name`)   AS cand_names
  FROM `bigquery-public-data.fec.committee_contributions_2016`
  GROUP BY `cmte_id`
)
SELECT
  cl.`cmte_id`,
  cl.num_cand,
  cl.cand_names,
  st.small_sum
FROM cand_list AS cl
JOIN small_tot AS st
  ON cl.`cmte_id` = st.`cmte_id`
LIMIT 20;
```

```sql
--Description: 9)  (Optional exploration)  Fetch one example of a human-readable
--               committee name, when available, from the auxiliary 2016
--               individual-contributions-with-committee-name table, to pair
--               with our committee IDs found above.
SELECT
  `cmte_nm` AS committee_name_sample
FROM `bigquery-public-data.fec.indiv16_cm16`
WHERE `cmte_nm` IS NOT NULL
LIMIT 20;
```

```sql
--Description: 10) Final query skeleton (add ORDER BY / LIMIT as needed) that
--               returns exactly what the task asks for: committee name (if you
--               decide to pull it in), #unique candidates, alphabetised list of
--               candidates, and the $0-$200 small-dollar total.
WITH small_tot AS (
  SELECT
    `cmte_id`,
    SUM(`transaction_amt`) AS small_sum
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE `transaction_amt` > 0
    AND `transaction_amt` < 200
  GROUP BY `cmte_id`
  HAVING small_sum > 0 AND small_sum < 200
),
cand_list AS (
  SELECT
    `cmte_id`,
    COUNT(DISTINCT `cand_id`)                                AS num_cand,
    STRING_AGG(DISTINCT ANY_VALUE(`name`) ORDER BY `name`)   AS cand_names
  FROM `bigquery-public-data.fec.committee_contributions_2016`
  GROUP BY `cmte_id`
),
cmte_name AS (                -- (if desired) pick a readable committee name
  SELECT
    `cmte_id`,
    ANY_VALUE(`name`) AS committee_name
  FROM `bigquery-public-data.fec.committee_contributions_2016`
  GROUP BY `cmte_id`
)
SELECT
  COALESCE(cn.committee_name, st.`cmte_id`) AS committee,
  cl.num_cand,
  cl.cand_names,
  st.small_sum
FROM small_tot st
JOIN cand_list cl ON st.`cmte_id` = cl.`cmte_id`
LEFT JOIN cmte_name cn ON st.`cmte_id` = cn.`cmte_id`
ORDER BY committee
LIMIT 20;
```
