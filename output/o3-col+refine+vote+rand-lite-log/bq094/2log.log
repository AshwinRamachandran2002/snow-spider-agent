--Description: 10)  Final answer template.  Uses corrected cand_list (no NULL
--               `cand_id`, proper STRING_AGG) and joins to optional committee
--               names.  Produces committee, #candidates, candidate list (A-Z),
--               and total small-dollar contributions.
WITH small_tot AS (
  SELECT
    `cmte_id`,
    SUM(`transaction_amt`) AS small_sum
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE `transaction_amt` > 0
    AND `transaction_amt` < 200
  GROUP BY `cmte_id`
  HAVING small_sum > 0 AND small_sum < 200
),
cand_list AS (
  SELECT
    `cmte_id`,
    COUNT(DISTINCT `cand_id`)                    AS num_cand,
    STRING_AGG(DISTINCT `name` ORDER BY `name`)  AS cand_names
  FROM `bigquery-public-data.fec.committee_contributions_2016`
  WHERE `cand_id` IS NOT NULL
  GROUP BY `cmte_id`
),
cmte_name AS (                                  -- readable committee name
  SELECT
    `cmte_id`,
    ANY_VALUE(`name`) AS committee_name
  FROM `bigquery-public-data.fec.committee_contributions_2016`
  GROUP BY `cmte_id`
)
SELECT
  COALESCE(cn.committee_name, st.`cmte_id`) AS committee,
  cl.num_cand,
  cl.cand_names,
  st.small_sum
FROM small_tot st
JOIN cand_list cl ON st.`cmte_id` = cl.`cmte_id`
LEFT JOIN cmte_name cn ON st.`cmte_id` = cn.`cmte_id`
ORDER BY committee
LIMIT 20
