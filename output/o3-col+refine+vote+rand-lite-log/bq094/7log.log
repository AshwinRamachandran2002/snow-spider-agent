```sql
-- 2️⃣  Description:  Inspect individual-to-committee contributions (notice NaNs / NULLs)
SELECT *
FROM   `bigquery-public-data.fec.individuals_2016`
LIMIT  20;
```

```sql
-- 3️⃣  Description:  All distinct committees that gave money to at least one candidate
SELECT DISTINCT cmte_id
FROM   `bigquery-public-data.fec.committee_contributions_2016`
LIMIT  20;
```

```sql
-- 4️⃣  Description:  Map each committee to every (distinct) candidate it supported
SELECT DISTINCT cmte_id,
       cand_id,
       name                 AS candidate_name
FROM   `bigquery-public-data.fec.committee_contributions_2016`
LIMIT  20;
```

```sql
-- 5️⃣  Description:  Number of unique candidates + their names (alphabetical) per committee
SELECT cmte_id,
       COUNT(DISTINCT cand_id)                                            AS num_candidates,
       STRING_AGG(DISTINCT candidate_name, ', ' ORDER BY candidate_name)  AS candidate_names
FROM  (
        SELECT cmte_id,
               cand_id,
               name AS candidate_name
        FROM   `bigquery-public-data.fec.committee_contributions_2016`
      )
GROUP  BY cmte_id
LIMIT  20;
```

```sql
-- 6️⃣  Description:  “Small-dollar” individual donations (>0 & <200) in 2016
SELECT cmte_id,
       transaction_amt
FROM   `bigquery-public-data.fec.individuals_2016`
WHERE  transaction_amt > 0
  AND  transaction_amt < 200
LIMIT  20;
```

```sql
-- 7️⃣  Description:  Total small-dollar contributions per committee
SELECT cmte_id,
       SUM(transaction_amt) AS small_dollar_total
FROM   `bigquery-public-data.fec.individuals_2016`
WHERE  transaction_amt > 0
  AND  transaction_amt < 200
GROUP  BY cmte_id
LIMIT  20;
```

```sql
-- 8️⃣  Description:  Join candidate-support info with small-dollar totals
SELECT c.cmte_id,
       s.small_dollar_total,
       c.num_candidates,
       c.candidate_names
FROM  (
        SELECT cmte_id,
               COUNT(DISTINCT cand_id)                                            AS num_candidates,
               STRING_AGG(DISTINCT name, ', ' ORDER BY name)                      AS candidate_names
        FROM   `bigquery-public-data.fec.committee_contributions_2016`
        GROUP  BY cmte_id
      ) AS c
JOIN  (
        SELECT cmte_id,
               SUM(transaction_amt) AS small_dollar_total
        FROM   `bigquery-public-data.fec.individuals_2016`
        WHERE  transaction_amt > 0
          AND  transaction_amt < 200
        GROUP  BY cmte_id
      ) AS s
ON    c.cmte_id = s.cmte_id
LIMIT 20;
```

```sql
-- 9️⃣  Description:  Filter to committees whose summed small-dollar donations >0
--      (they already satisfy 0 < amt <200 per-transaction) and supported ≥1 candidate
SELECT *
FROM (
      SELECT c.cmte_id,
             c.num_candidates,
             c.candidate_names,
             s.small_dollar_total
      FROM  (
              SELECT cmte_id,
                     COUNT(DISTINCT cand_id)                       AS num_candidates,
                     STRING_AGG(DISTINCT name, ', ' ORDER BY name) AS candidate_names
              FROM   `bigquery-public-data.fec.committee_contributions_2016`
              GROUP  BY cmte_id
            ) AS c
      JOIN  (
              SELECT cmte_id,
                     SUM(transaction_amt) AS small_dollar_total
              FROM   `bigquery-public-data.fec.individuals_2016`
              WHERE  transaction_amt > 0
                AND  transaction_amt < 200
              GROUP  BY cmte_id
            ) AS s
      ON    c.cmte_id = s.cmte_id
) 
WHERE small_dollar_total > 0
LIMIT 20;
```

```sql
-- 🔟  Description:  Final answer ‑- every 2016 committee that (a) backed ≥1 candidate
--      and (b) received >0 in small-dollar individual contributions (each 0–200 USD).
--      Outputs: committee ID, # candidates, alphabetical candidate names, total small $
SELECT c.cmte_id                                           AS committee_id,
       c.num_candidates,
       c.candidate_names,
       s.small_dollar_total
FROM  (
        SELECT cmte_id,
               COUNT(DISTINCT cand_id)                       AS num_candidates,
               STRING_AGG(DISTINCT name, ', ' ORDER BY name) AS candidate_names
        FROM   `bigquery-public-data.fec.committee_contributions_2016`
        GROUP  BY cmte_id
      ) AS c
JOIN  (
        SELECT cmte_id,
               SUM(transaction_amt) AS small_dollar_total
        FROM   `bigquery-public-data.fec.individuals_2016`
        WHERE  transaction_amt > 0
          AND  transaction_amt < 200
        GROUP  BY cmte_id
      ) AS s
ON    c.cmte_id = s.cmte_id
WHERE s.small_dollar_total > 0
ORDER BY s.small_dollar_total DESC, c.cmte_id
LIMIT 20;
```
