-- 9️⃣  Description:  Filter to committees whose summed small-dollar donations >0
--      (they already satisfy 0 < amt <200 per-transaction) and supported ≥1 candidate
SELECT *
FROM (
      SELECT c.cmte_id,
             c.num_candidates,
             c.candidate_names,
             s.small_dollar_total
      FROM  (
              SELECT cmte_id,
                     COUNT(DISTINCT cand_id)                       AS num_candidates,
                     STRING_AGG(DISTINCT name, ', ' ORDER BY name) AS candidate_names
              FROM   `bigquery-public-data.fec.committee_contributions_2016`
              GROUP  BY cmte_id
            ) AS c
      JOIN  (
              SELECT cmte_id,
                     SUM(transaction_amt) AS small_dollar_total
              FROM   `bigquery-public-data.fec.individuals_2016`
              WHERE  transaction_amt > 0
                AND  transaction_amt < 200
              GROUP  BY cmte_id
            ) AS s
      ON    c.cmte_id = s.cmte_id
) 
WHERE small_dollar_total > 0
LIMIT 20;
