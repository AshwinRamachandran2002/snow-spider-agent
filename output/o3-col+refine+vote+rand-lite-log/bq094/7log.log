Query:
-- 🔟  Description:  Final answer ‑- every 2016 committee that (a) backed ≥1 candidate
--      and (b) received >0 in small-dollar individual contributions (each 0–200 USD).
--      Outputs: committee ID, # candidates, alphabetical candidate names, total small $
SELECT c.cmte_id                                           AS committee_id,
       c.num_candidates,
       c.candidate_names,
       s.small_dollar_total
FROM  (
        SELECT cmte_id,
               COUNT(DISTINCT cand_id)                       AS num_candidates,
               STRING_AGG(DISTINCT name, ', ' ORDER BY name) AS candidate_names
        FROM   `bigquery-public-data.fec.committee_contributions_2016`
        GROUP  BY cmte_id
      ) AS c
JOIN  (
        SELECT cmte_id,
               SUM(transaction_amt) AS small_dollar_total
        FROM   `bigquery-public-data.fec.individuals_2016`
        WHERE  transaction_amt > 0
          AND  transaction_amt < 200
        GROUP  BY cmte_id
      ) AS s
ON    c.cmte_id = s.cmte_id
WHERE s.small_dollar_total > 0
ORDER BY s.small_dollar_total DESC, c.cmte_id
LIMIT 20;
