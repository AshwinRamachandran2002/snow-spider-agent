--Description: Pull every 2020 purchase made by the January-2020 cohort (including January for reference).
WITH cohort AS (
  SELECT "user_id"
  FROM (
    SELECT "user_id",
           MIN("created_at") AS "first_purchase_at"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    GROUP BY "user_id"
  )
  WHERE "first_purchase_at" BETWEEN 1577836800000000 AND 1583020799000000      -- 2020-01
)
