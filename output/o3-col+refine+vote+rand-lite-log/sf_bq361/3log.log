    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    GROUP BY "user_id"
  )
  WHERE "first_purchase_at" BETWEEN 1577836800000000 AND 1583020799000000
)
SELECT COUNT(DISTINCT o."user_id") AS "multiple_jan_orders"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN cohort c
  ON o."user_id" = c."user_id"
WHERE o."created_at" BETWEEN 1577836800000000 AND 1580515200000000        -- January-2020
GROUP BY 1
LIMIT 20;
