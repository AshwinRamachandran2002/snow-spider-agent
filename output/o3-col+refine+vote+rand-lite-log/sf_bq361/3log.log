Query:
--Description: For the cohort, get the month (YYYY-MM) of each 2020 order to prepare a retention grid.
WITH cohort AS (
  SELECT "user_id"
  FROM (
    SELECT "user_id",
           MIN("created_at") AS "first_purchase_at"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    GROUP BY "user_id"
  )
  WHERE "first_purchase_at" BETWEEN 1577836800000000 AND 1583020799000000
)
SELECT o."user_id",
       TO_CHAR(DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at"/1000000)), 'YYYY-MM') AS "order_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN cohort c
  ON o."user_id" = c."user_id"
WHERE o."created_at" BETWEEN 1577836800000000 AND 1609459199000000
LIMIT 20;
