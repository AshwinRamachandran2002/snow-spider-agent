Query:
--Description: Quickly view the cohort, their very first order id, and its time-stamp for cross-checking.
WITH first_order AS (
  SELECT "user_id",
         MIN("created_at") AS "first_purchase_at"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
  GROUP BY "user_id"
), cohort AS (
  SELECT "user_id",
         "first_purchase_at"
  FROM first_order
  WHERE "first_purchase_at" BETWEEN 1577836800000000 AND 1583020799000000
)
SELECT o."user_id",
       o."order_id",
       o."created_at"  AS "first_order_created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN cohort c
  ON o."user_id" = c."user_id"
WHERE o."created_at" = c."first_purchase_at"
LIMIT 20;
