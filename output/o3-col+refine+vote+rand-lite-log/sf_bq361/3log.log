```sql
--Description: Pull every 2020 purchase made by the January-2020 cohort (including January for reference).
WITH cohort AS (
  SELECT "user_id"
  FROM (
    SELECT "user_id",
           MIN("created_at") AS "first_purchase_at"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    GROUP BY "user_id"
  )
  WHERE "first_purchase_at" BETWEEN 1577836800000000 AND 1583020799000000      -- 2020-01
)
SELECT o."user_id",
       o."order_id",
       o."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN cohort c
  ON o."user_id" = c."user_id"
WHERE o."created_at" BETWEEN 1577836800000000 AND 1609459199000000            -- full year 2020
LIMIT 20;
```

```sql
--Description: For the cohort, get the month (YYYY-MM) of each 2020 order to prepare a retention grid.
WITH cohort AS (
  SELECT "user_id"
  FROM (
    SELECT "user_id",
           MIN("created_at") AS "first_purchase_at"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    GROUP BY "user_id"
  )
  WHERE "first_purchase_at" BETWEEN 1577836800000000 AND 1583020799000000
)
SELECT o."user_id",
       TO_CHAR(DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at"/1000000)), 'YYYY-MM') AS "order_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN cohort c
  ON o."user_id" = c."user_id"
WHERE o."created_at" BETWEEN 1577836800000000 AND 1609459199000000
LIMIT 20;
```

```sql
--Description: Distinct users from the cohort who returned each month after January-2020.
WITH cohort AS (
  SELECT "user_id"
  FROM (
    SELECT "user_id",
           MIN("created_at") AS "first_purchase_at"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    GROUP BY "user_id"
  )
  WHERE "first_purchase_at" BETWEEN 1577836800000000 AND 1583020799000000
)
SELECT TO_CHAR(DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at"/1000000)), 'YYYY-MM') AS "order_month",
       COUNT(DISTINCT o."user_id")                                   AS "returning_users"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN cohort c
  ON o."user_id" = c."user_id"
WHERE o."created_at" > 1580515200000000                                 -- after January-2020
  AND o."created_at" <= 1609459199000000                                 -- within 2020
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Bring together cohort size and returning users to compute monthly retention proportions.
WITH first_order AS (
  SELECT "user_id",
         MIN("created_at") AS "first_purchase_at"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
  GROUP BY "user_id"
), cohort AS (
  SELECT "user_id"
  FROM first_order
  WHERE "first_purchase_at" BETWEEN 1577836800000000 AND 1583020799000000
), returns AS (
  SELECT TO_CHAR(DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at"/1000000)), 'YYYY-MM') AS "order_month",
         COUNT(DISTINCT o."user_id") AS "returning_users"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
  JOIN cohort c
    ON o."user_id" = c."user_id"
  WHERE o."created_at" > 1580515200000000
    AND o."created_at" <= 1609459199000000
  GROUP BY 1
)
SELECT r."order_month",
       r."returning_users",
       (SELECT COUNT(*) FROM cohort)                         AS "cohort_size",
       r."returning_users" / (SELECT COUNT(*) FROM cohort)   AS "retention_rate"
FROM returns r
ORDER BY r."order_month"
LIMIT 20;
```

```sql
--Description: Quickly view the cohort, their very first order id, and its time-stamp for cross-checking.
WITH first_order AS (
  SELECT "user_id",
         MIN("created_at") AS "first_purchase_at"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
  GROUP BY "user_id"
), cohort AS (
  SELECT "user_id",
         "first_purchase_at"
  FROM first_order
  WHERE "first_purchase_at" BETWEEN 1577836800000000 AND 1583020799000000
)
SELECT o."user_id",
       o."order_id",
       o."created_at"  AS "first_order_created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN cohort c
  ON o."user_id" = c."user_id"
WHERE o."created_at" = c."first_purchase_at"
LIMIT 20;
```

