       o."order_id",
       o."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN cohort c
  ON o."user_id" = c."user_id"
WHERE o."created_at" BETWEEN 1577836800000000 AND 1609459199000000            -- full year 2020
LIMIT 20;
