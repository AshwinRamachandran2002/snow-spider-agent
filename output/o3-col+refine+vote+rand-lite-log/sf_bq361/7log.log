```sql
-- Description: 1) Look at a handful of raw ORDER records to understand the time-stamp values that
-- will be used to identify a customer’s first purchase month.
SELECT "order_id",
       "user_id",
       "status",
       "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
ORDER BY "created_at"
LIMIT 20;
```

```sql
-- Description: 2) Check what a January-2020 “created_at” looks like after converting from
-- micro-seconds since epoch to a calendar DATE (division by 1 000 000).
SELECT "order_id",
       "user_id",
       TO_TIMESTAMP("created_at"/1000000)::DATE  AS "order_date"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE TO_TIMESTAMP("created_at"/1000000)::DATE BETWEEN '2020-01-01' AND '2020-01-31'
ORDER BY "order_date"
LIMIT 20;
```

```sql
-- Description: 3) Fetch every shopper whose very FIRST order fell in January-2020
-- (earliest order_date in that month).  This forms the cohort.
WITH first_order AS (
  SELECT "user_id",
         MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_purchase_date"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
)
SELECT  fo."user_id",
        fo."first_purchase_date"
FROM    first_order  fo
WHERE   fo."first_purchase_date" BETWEEN '2020-01-01' AND '2020-01-31'
LIMIT 20;
```

```sql
-- Description: 4) Count how many users are in that January-2020 cohort.
WITH first_order AS (
  SELECT "user_id",
         MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_purchase_date"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
)
SELECT COUNT(*) AS "jan_2020_cohort_size"
FROM   first_order
WHERE  "first_purchase_date" BETWEEN '2020-01-01' AND '2020-01-31';
```

```sql
-- Description: 5) Grab every subsequent 2020 order for those same users (Feb-Dec),
-- showing the order month so we can build a retention grid.
WITH cohort_users AS (
  SELECT "user_id"
  FROM (
        SELECT "user_id",
               MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_date"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
        GROUP BY "user_id"
       )
  WHERE "first_date" BETWEEN '2020-01-01' AND '2020-01-31'
)
SELECT o."user_id",
       DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) AS "order_month"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"  o
JOIN   cohort_users                                cu  ON o."user_id" = cu."user_id"
WHERE  DATE_TRUNC('year', TO_TIMESTAMP(o."created_at"/1000000)) = '2020-01-01'  -- any 2020 date
      AND DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) > '2020-01-01' -- after January
ORDER BY "order_month"
LIMIT 20;
```

```sql
-- Description: 6) For each month Feb-Dec 2020, count unique cohort users who placed ≥1 order.
WITH cohort AS (
  SELECT "user_id",
         MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_dt"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
  HAVING "first_dt" BETWEEN '2020-01-01' AND '2020-01-31'
), activity AS (
  SELECT  o."user_id",
          DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) AS "order_mth"
  FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  JOIN    cohort c ON o."user_id" = c."user_id"
  WHERE   DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) > '2020-01-01'
    AND   DATE_TRUNC('year',  TO_TIMESTAMP(o."created_at"/1000000)) = '2020-01-01'
)
SELECT  "order_mth",
        COUNT(DISTINCT "user_id") AS "returning_users"
FROM    activity
GROUP BY "order_mth"
ORDER BY "order_mth"
LIMIT 20;
```

```sql
-- Description: 7) Put the February-December returning counts next to the total cohort
-- size so we can calculate the monthly proportion manually.
WITH cohort AS (
  SELECT "user_id",
         MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_dt"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
  HAVING "first_dt" BETWEEN '2020-01-01' AND '2020-01-31'
), cohort_size AS (
  SELECT COUNT(*) AS "cohort_cnt" FROM cohort
), month_returns AS (
  SELECT  DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) AS "mth",
          COUNT(DISTINCT o."user_id") AS "return_cnt"
  FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"  o
  JOIN    cohort c ON o."user_id" = c."user_id"
  WHERE   DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) > '2020-01-01'
    AND   DATE_TRUNC('year',  TO_TIMESTAMP(o."created_at"/1000000)) = '2020-01-01'
  GROUP BY "mth"
)
SELECT  mr."mth"           AS "month_2020",
        mr."return_cnt",
        cs."cohort_cnt",
        mr."return_cnt" / cs."cohort_cnt"::FLOAT AS "return_proportion"
FROM    month_returns  mr
CROSS JOIN cohort_size cs
ORDER BY "month_2020"
LIMIT 20;
```

```sql
-- Description: 8) Double-check whether any of those Jan-2020 cohort users generated
-- refunds / returns later (status='Returned') which might matter for retention definitions.
SELECT DISTINCT "user_id",
       "status",
       TO_TIMESTAMP("created_at"/1000000)::DATE AS "order_date"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "user_id" IN (
      SELECT "user_id"
      FROM (
            SELECT "user_id",
                   MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_dt"
            FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
            GROUP BY "user_id"
            HAVING "first_dt" BETWEEN '2020-01-01' AND '2020-01-31'
      )
)
  AND "status" ILIKE '%return%'
LIMIT 20;
```

```sql
-- Description: 9) Inspect ORDER_ITEMS as another source of activity;
-- we might want to count based on item-level data instead of order-level.
SELECT oi."order_id",
       oi."user_id",
       oi."status",
       TO_TIMESTAMP(oi."created_at"/1000000)::DATE AS "item_date"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
WHERE oi."user_id" IN (
        SELECT "user_id"
        FROM (
              SELECT "user_id",
                     MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_dt"
              FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
              GROUP BY "user_id"
              HAVING "first_dt" BETWEEN '2020-01-01' AND '2020-01-31'
        )
)
  AND TO_TIMESTAMP(oi."created_at"/1000000)::DATE BETWEEN '2020-02-01' AND '2020-12-31'
ORDER BY oi."created_at"
LIMIT 20;
```

```sql
-- Description: 10) Final single query returning the retention proportions for
-- February through December 2020 for the January-2020 first-purchase cohort.
WITH cohort AS (
  SELECT "user_id",
         MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_date"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
  HAVING "first_date" BETWEEN '2020-01-01' AND '2020-01-31'
), cohort_size AS (
  SELECT COUNT(*) AS "total_users" FROM cohort
)
SELECT  DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000))  AS "month_2020",
        COUNT(DISTINCT o."user_id")                                AS "returning_users",
        cs."total_users",
        COUNT(DISTINCT o."user_id") / cs."total_users"::FLOAT      AS "return_rate"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN    cohort c ON o."user_id" = c."user_id"
CROSS JOIN cohort_size cs
WHERE   DATE_TRUNC('year',  TO_TIMESTAMP(o."created_at"/1000000)) = '2020-01-01'
  AND   DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) > '2020-01-01'
GROUP BY "month_2020", cs."total_users"
ORDER BY "month_2020"
LIMIT 20;
```
