Query:
-- Description: 7) Put the February-December returning counts next to the total cohort
-- size so we can calculate the monthly proportion manually.
WITH cohort AS (
  SELECT "user_id",
         MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_dt"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
  HAVING "first_dt" BETWEEN '2020-01-01' AND '2020-01-31'
), cohort_size AS (
  SELECT COUNT(*) AS "cohort_cnt" FROM cohort
), month_returns AS (
  SELECT  DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) AS "mth",
          COUNT(DISTINCT o."user_id") AS "return_cnt"
  FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"  o
  JOIN    cohort c ON o."user_id" = c."user_id"
  WHERE   DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) > '2020-01-01'
    AND   DATE_TRUNC('year',  TO_TIMESTAMP(o."created_at"/1000000)) = '2020-01-01'
  GROUP BY "mth"
)
SELECT  mr."mth"           AS "month_2020",
        mr."return_cnt",
        cs."cohort_cnt",
        mr."return_cnt" / cs."cohort_cnt"::FLOAT AS "return_proportion"
FROM    month_returns  mr
CROSS JOIN cohort_size cs
ORDER BY "month_2020"
LIMIT 20;
