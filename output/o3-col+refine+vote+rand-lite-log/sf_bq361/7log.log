Query:
-- Description: 10) Final single query returning the retention proportions for
-- February through December 2020 for the January-2020 first-purchase cohort.
WITH cohort AS (
  SELECT "user_id",
         MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_date"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
  HAVING "first_date" BETWEEN '2020-01-01' AND '2020-01-31'
), cohort_size AS (
  SELECT COUNT(*) AS "total_users" FROM cohort
)
SELECT  DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000))  AS "month_2020",
        COUNT(DISTINCT o."user_id")                                AS "returning_users",
        cs."total_users",
        COUNT(DISTINCT o."user_id") / cs."total_users"::FLOAT      AS "return_rate"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN    cohort c ON o."user_id" = c."user_id"
CROSS JOIN cohort_size cs
WHERE   DATE_TRUNC('year',  TO_TIMESTAMP(o."created_at"/1000000)) = '2020-01-01'
  AND   DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) > '2020-01-01'
GROUP BY "month_2020", cs."total_users"
ORDER BY "month_2020"
LIMIT 20;
