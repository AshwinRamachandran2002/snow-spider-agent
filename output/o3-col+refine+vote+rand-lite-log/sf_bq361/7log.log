-- Description: 9) Inspect ORDER_ITEMS as another source of activity;
-- we might want to count based on item-level data instead of order-level.
SELECT oi."order_id",
       oi."user_id",
       oi."status",
       TO_TIMESTAMP(oi."created_at"/1000000)::DATE AS "item_date"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
WHERE oi."user_id" IN (
        SELECT "user_id"
        FROM (
              SELECT "user_id",
                     MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_dt"
              FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
              GROUP BY "user_id"
              HAVING "first_dt" BETWEEN '2020-01-01' AND '2020-01-31'
        )
)
  AND TO_TIMESTAMP(oi."created_at"/1000000)::DATE BETWEEN '2020-02-01' AND '2020-12-31'
ORDER BY oi."created_at"
LIMIT 20;
