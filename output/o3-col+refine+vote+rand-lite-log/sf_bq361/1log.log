--Description: Inspect order statuses for cohort’s 2020 purchases to ensure we count only completed / shipped orders if desired  
WITH jan20 AS (
  SELECT "user_id"
  FROM   (
          SELECT "user_id",
                 MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_order_dt"
          FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
          GROUP  BY "user_id"
         )
  WHERE  "first_order_dt" BETWEEN '2020-01-01' AND '2020-01-31'
)
