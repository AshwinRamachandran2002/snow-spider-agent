  SELECT "user_id",
         MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_order_dt"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP  BY "user_id"
)
SELECT *
FROM   firsts
WHERE  "first_order_dt" BETWEEN '2020-01-01' AND '2020-01-31'
LIMIT  20;
```

```sql
--Description: Count distinct users in that January-2020 cohort  
WITH firsts AS (
  SELECT "user_id",
         MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_order_dt"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP  BY "user_id"
)
SELECT COUNT(DISTINCT "user_id") AS "jan20_cohort_size"
FROM   firsts
WHERE  "first_order_dt" BETWEEN '2020-01-01' AND '2020-01-31';
```

```sql
--Description: Fetch every 2020 order placed by those January-2020 cohort users  
WITH jan20 AS (
  SELECT "user_id"
  FROM   (
          SELECT "user_id",
                 MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_order_dt"
          FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
          GROUP  BY "user_id"
         )
  WHERE  "first_order_dt" BETWEEN '2020-01-01' AND '2020-01-31'
)
SELECT o."order_id",
       o."user_id",
       TO_TIMESTAMP(o."created_at"/1000000)::DATE AS "order_date",
       o."status"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   jan20 j
  ON   o."user_id" = j."user_id"
WHERE  TO_TIMESTAMP(o."created_at"/1000000)::DATE BETWEEN '2020-02-01' AND '2020-12-31'
ORDER  BY o."user_id", "order_date"
LIMIT  20;
```

```sql
--Description: Monthly count of returning users from the cohort (Feb-Dec 2020)  
WITH jan20 AS (
  SELECT "user_id"
  FROM   (
          SELECT "user_id",
                 MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_order_dt"
          FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
          GROUP  BY "user_id"
         )
  WHERE  "first_order_dt" BETWEEN '2020-01-01' AND '2020-01-31'
), rtn AS (
  SELECT DISTINCT j."user_id",
         TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000)::DATE, 'YYYY-MM') AS "yyyymm"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  JOIN   jan20 j
    ON   o."user_id" = j."user_id"
  WHERE  TO_TIMESTAMP(o."created_at"/1000000)::DATE BETWEEN '2020-02-01' AND '2020-12-31'
)
SELECT "yyyymm",
       COUNT(DISTINCT "user_id") AS "returning_users"
FROM   rtn
GROUP  BY "yyyymm"
ORDER  BY "yyyymm"
LIMIT  20;
```

```sql
--Description: How many Jan-2020 users placed at least one more order in 2020?  
WITH jan20 AS (
  SELECT "user_id"
  FROM   (
          SELECT "user_id",
                 MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_order_dt"
          FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
          GROUP  BY "user_id"
         )
  WHERE  "first_order_dt" BETWEEN '2020-01-01' AND '2020-01-31'
), more_orders AS (
  SELECT DISTINCT j."user_id"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  JOIN   jan20 j
    ON   o."user_id" = j."user_id"
  WHERE  TO_TIMESTAMP(o."created_at"/1000000)::DATE BETWEEN '2020-02-01' AND '2020-12-31'
)
SELECT COUNT(*) AS "users_with_extra_orders_2020"
FROM   more_orders;
```

```sql
--Description: Combine cohort size and monthly returning counts to compute proportions  
WITH jan20 AS (
  SELECT "user_id"
  FROM   (
          SELECT "user_id",
                 MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_order_dt"
          FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
          GROUP  BY "user_id"
         )
  WHERE  "first_order_dt" BETWEEN '2020-01-01' AND '2020-01-31'
), base AS (
  SELECT COUNT(DISTINCT "user_id") AS "cohort_size"
  FROM   jan20
), rtn AS (
  SELECT DISTINCT j."user_id",
         TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000)::DATE, 'YYYY-MM') AS "yyyymm"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  JOIN   jan20 j
    ON   o."user_id" = j."user_id"
  WHERE  TO_TIMESTAMP(o."created_at"/1000000)::DATE BETWEEN '2020-02-01' AND '2020-12-31'
)
SELECT r."yyyymm",
       COUNT(DISTINCT r."user_id") AS "returning_users",
       (COUNT(DISTINCT r."user_id") / b."cohort_size")::FLOAT AS "proportion"
FROM   rtn r
CROSS  JOIN base b
GROUP  BY r."yyyymm", b."cohort_size"
ORDER  BY r."yyyymm"
LIMIT  20;
```

```sql
--Description: Peek at USERS table to see when those cohort users joined the site  
WITH jan20 AS (
  SELECT "user_id"
  FROM   (
          SELECT "user_id",
                 MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_order_dt"
          FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
          GROUP  BY "user_id"
         )
  WHERE  "first_order_dt" BETWEEN '2020-01-01' AND '2020-01-31'
)
SELECT u."id",
       u."first_name",
       u."last_name",
       TO_TIMESTAMP(u."created_at"/1000000)::DATE AS "user_created_dt"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
JOIN   jan20 j
  ON   u."id" = j."user_id"
LIMIT  20;
```

