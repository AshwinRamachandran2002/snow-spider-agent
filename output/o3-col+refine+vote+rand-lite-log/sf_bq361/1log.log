--Description: Peek at USERS table to see when those cohort users joined the site  
WITH jan20 AS (
  SELECT "user_id"
  FROM   (
          SELECT "user_id",
                 MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_order_dt"
          FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
          GROUP  BY "user_id"
         )
  WHERE  "first_order_dt" BETWEEN '2020-01-01' AND '2020-01-31'
)
SELECT u."id",
       u."first_name",
       u."last_name",
       TO_TIMESTAMP(u."created_at"/1000000)::DATE AS "user_created_dt"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
JOIN   jan20 j
  ON   u."id" = j."user_id"
