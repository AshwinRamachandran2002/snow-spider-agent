FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE  TO_TIMESTAMP("created_at"/1000000)::DATE BETWEEN '2020-01-01' AND '2020-12-31'
GROUP  BY "user_id"
ORDER  BY "first_order_dt"
LIMIT  20;
```

```sql
