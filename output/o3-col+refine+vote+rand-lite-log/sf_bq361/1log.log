Query:
--Description: Fetch every 2020 order placed by those January-2020 cohort users  
WITH jan20 AS (
  SELECT "user_id"
  FROM   (
          SELECT "user_id",
                 MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_order_dt"
          FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
          GROUP  BY "user_id"
         )
  WHERE  "first_order_dt" BETWEEN '2020-01-01' AND '2020-01-31'
)
SELECT o."order_id",
       o."user_id",
       TO_TIMESTAMP(o."created_at"/1000000)::DATE AS "order_date",
       o."status"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   jan20 j
  ON   o."user_id" = j."user_id"
WHERE  TO_TIMESTAMP(o."created_at"/1000000)::DATE BETWEEN '2020-02-01' AND '2020-12-31'
ORDER  BY o."user_id", "order_date"
LIMIT  20;
