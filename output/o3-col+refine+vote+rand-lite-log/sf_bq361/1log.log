Query:
--Description: Combine cohort size and monthly returning counts to compute proportions  
WITH jan20 AS (
  SELECT "user_id"
  FROM   (
          SELECT "user_id",
                 MIN(TO_TIMESTAMP("created_at"/1000000)::DATE) AS "first_order_dt"
          FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
          GROUP  BY "user_id"
         )
  WHERE  "first_order_dt" BETWEEN '2020-01-01' AND '2020-01-31'
), base AS (
  SELECT COUNT(DISTINCT "user_id") AS "cohort_size"
  FROM   jan20
), rtn AS (
  SELECT DISTINCT j."user_id",
         TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000)::DATE, 'YYYY-MM') AS "yyyymm"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  JOIN   jan20 j
    ON   o."user_id" = j."user_id"
  WHERE  TO_TIMESTAMP(o."created_at"/1000000)::DATE BETWEEN '2020-02-01' AND '2020-12-31'
)
SELECT r."yyyymm",
       COUNT(DISTINCT r."user_id") AS "returning_users",
       (COUNT(DISTINCT r."user_id") / b."cohort_size")::FLOAT AS "proportion"
FROM   rtn r
CROSS  JOIN base b
GROUP  BY r."yyyymm", b."cohort_size"
ORDER  BY r."yyyymm"
LIMIT  20;
