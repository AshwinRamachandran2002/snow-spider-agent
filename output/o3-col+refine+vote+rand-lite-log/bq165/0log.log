Below is a step-by-step exploration – from inspecting the cohort to calculating per-cytoband copy-number event frequencies.  
Each query is annotated and limited to 20 rows.

```sql
--Description: 1) Inspect Cytogen records that belong to the requested cohort
--              (breast cancer: Morph='3111'; adenocarcinoma: Topo='0401').
SELECT *
FROM `mitelman-db.prod.Cytogen`
WHERE Morph = '3111' OR Topo = '0401'
LIMIT 20;
```

```sql
--Description: 2) How many unique (RefNo,CaseNo) samples are in the cohort?
SELECT COUNT(DISTINCT CONCAT(RefNo,'_',CaseNo)) AS total_cases
FROM `mitelman-db.prod.Cytogen`
WHERE Morph = '3111' OR Topo = '0401'
LIMIT 20;
```

```sql
--Description: 3) What copy-number “Type” values exist in CytoConverted?
SELECT DISTINCT Type
FROM `mitelman-db.prod.CytoConverted`
LIMIT 20;
```

```sql
--Description: 4) Preview CytoConverted rows and genomic coordinates.
SELECT RefNo, CaseNo, Chr, Start, End, Type
FROM `mitelman-db.prod.CytoConverted`
LIMIT 20;
```

```sql
--Description: 5) Join the cohort to CytoConverted to see the event types
--              actually present for our breast-/adeno-carcinoma samples.
SELECT cv.RefNo, cv.CaseNo, cv.Chr, cv.Start, cv.End, cv.Type
FROM `mitelman-db.prod.CytoConverted` AS cv
JOIN (
      SELECT DISTINCT RefNo, CaseNo
      FROM `mitelman-db.prod.Cytogen`
      WHERE Morph='3111' OR Topo='0401'
     ) AS coh
ON  cv.RefNo = coh.RefNo
AND cv.CaseNo = coh.CaseNo
LIMIT 20;
```

```sql
--Description: 6) Map one cohort event to its cytogenetic band
--              (overlap between event segment and band coordinates).
SELECT cv.RefNo,
       cv.CaseNo,
       cv.Chr,
       b.cytoband_name,
       cv.Start, cv.End,
       b.hg38_start, b.hg38_stop,
       cv.Type
FROM `mitelman-db.prod.CytoConverted`  AS cv
JOIN (
      SELECT DISTINCT RefNo, CaseNo
      FROM `mitelman-db.prod.Cytogen`
      WHERE Morph='3111' OR Topo='0401'
     ) AS coh
  ON cv.RefNo = coh.RefNo AND cv.CaseNo = coh.CaseNo
JOIN `mitelman-db.prod.CytoBands_hg38` AS b
  ON cv.Chr = b.chromosome
 AND cv.Start <= b.hg38_stop
 AND cv.End   >= b.hg38_start
LIMIT 20;
```

```sql
--Description: 7) Count every event-type found in the cohort to
--              verify which “Type” values need to be bucketed.
SELECT cv.Type,
       COUNT(1) AS events_in_cohort
FROM `mitelman-db.prod.CytoConverted`  AS cv
JOIN (
      SELECT DISTINCT RefNo, CaseNo
      FROM `mitelman-db.prod.Cytogen`
      WHERE Morph='3111' OR Topo='0401'
     ) AS coh
  ON cv.RefNo = coh.RefNo AND cv.CaseNo = coh.CaseNo
GROUP BY cv.Type
LIMIT 20;
```

```sql
--Description: 8) Build a temporary table that links every cohort event
--              to every cytoband it overlaps.
WITH cohort_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph='3111' OR Topo='0401'
),
events AS (
  SELECT cv.RefNo, cv.CaseNo, cv.Chr, cv.Start, cv.End, cv.Type
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN cohort_cases AS cc
    ON cv.RefNo = cc.RefNo AND cv.CaseNo = cc.CaseNo
)
SELECT e.*, b.cytoband_name, b.hg38_start, b.hg38_stop
FROM events AS e
JOIN `mitelman-db.prod.CytoBands_hg38` AS b
  ON e.Chr = b.chromosome
 AND e.Start <= b.hg38_stop
 AND e.End   >= b.hg38_start
LIMIT 20;
```

```sql
--Description: 9) Aggregate counts of amplifications, single-copy gains,
--              single-copy losses and homozygous deletions per band
--              (within the cohort).  Bucketing is based on the “Type”
--              values discovered above – adjust if other labels appear.
WITH cohort_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph='3111' OR Topo='0401'
),
events AS (
  SELECT cv.RefNo, cv.CaseNo, cv.Chr, cv.Start, cv.End, cv.Type
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN cohort_cases AS cc
    ON cv.RefNo = cc.RefNo AND cv.CaseNo = cc.CaseNo
),
band_map AS (
  SELECT
    b.chromosome           AS Chr,
    b.cytoband_name        AS Band,
    b.hg38_start, b.hg38_stop,
    e.Type
  FROM events AS e
  JOIN `mitelman-db.prod.CytoBands_hg38` AS b
    ON e.Chr = b.chromosome
   AND e.Start <= b.hg38_stop
   AND e.End   >= b.hg38_start
),
tot AS (
  SELECT COUNT(*) AS n_cases FROM cohort_cases
)
SELECT
  Chr,
  Band,
  hg38_start,
  hg38_stop,
  SUM(CASE WHEN Type = 'Amp'                     THEN 1 ELSE 0 END) AS Amplifications,
  SUM(CASE WHEN Type = 'Gain'                    THEN 1 ELSE 0 END) AS Gains,
  SUM(CASE WHEN Type = 'Loss'                    THEN 1 ELSE 0 END) AS Losses,
  SUM(CASE WHEN LOWER(Type) LIKE '%homdel%'      THEN 1 ELSE 0 END) AS Homozygous_Deletions
FROM band_map
GROUP BY Chr, Band, hg38_start, hg38_stop, (SELECT n_cases FROM tot)
ORDER BY Chr, hg38_start, hg38_stop
LIMIT 20;
```

```sql
--Description: 10) Add frequencies (two-decimal %), order by
--                chromosome ordinal + start coordinate.
WITH cohort_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph='3111' OR Topo='0401'
),
n_cases AS (
  SELECT COUNT(*) AS total FROM cohort_cases
),
events AS (
  SELECT cv.RefNo, cv.CaseNo, cv.Chr, cv.Start, cv.End, cv.Type
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN cohort_cases AS cc
    ON cv.RefNo = cc.RefNo AND cv.CaseNo = cc.CaseNo
),
band_map AS (
  SELECT b.cytoband_name,
         b.chromosome,
         b.hg38_start,
         b.hg38_stop,
         e.Type
  FROM events AS e
  JOIN `mitelman-db.prod.CytoBands_hg38` AS b
    ON e.Chr = b.chromosome
   AND e.Start <= b.hg38_stop
   AND e.End   >= b.hg38_start
),
final AS (
  SELECT
    b.cytoband_name         AS Band,
    b.chromosome            AS Chr,
    b.hg38_start,
    b.hg38_stop,
    SUM(CASE WHEN Type='Amp'                     THEN 1 ELSE 0 END) AS amps,
    SUM(CASE WHEN Type='Gain'                    THEN 1 ELSE 0 END) AS gains,
    SUM(CASE WHEN Type='Loss'                    THEN 1 ELSE 0 END) AS losses,
    SUM(CASE WHEN LOWER(Type) LIKE '%homdel%'    THEN 1 ELSE 0 END) AS homdels
  FROM band_map AS b
  GROUP BY Band, Chr, hg38_start, hg38_stop
)
SELECT
  Chr,
  Band,
  hg38_start,
  hg38_stop,
  amps,
  ROUND(amps   *100.0 / n.total , 2) AS amps_pct,
  gains,
  ROUND(gains  *100.0 / n.total , 2) AS gains_pct,
  losses,
  ROUND(losses *100.0 / n.total , 2) AS losses_pct,
  homdels,
  ROUND(homdels*100.0 / n.total , 2) AS homdels_pct
FROM final, n_cases AS n
ORDER BY
  SAFE_CAST(REGEXP_REPLACE(Chr, r'chr', '') AS INT64),
  hg38_start,
  hg38_stop
LIMIT 20;
```

These ten queries progressively reveal the data and culminate in per-cytoband counts and frequencies of amplifications, single-copy gains, single-copy losses, and homozygous deletions in breast-cancer (3111) and adenocarcinoma (0401) samples, ordered by chromosome and genomic position.
