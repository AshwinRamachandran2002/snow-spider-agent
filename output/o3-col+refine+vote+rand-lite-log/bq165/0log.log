--Description: 10) Add frequencies (two-decimal %) and order by chromosome ordinal.
WITH cohort_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' OR Topo = '0401'
),
n_cases AS (
  SELECT COUNT(*) AS total FROM cohort_cases
),
events AS (
  SELECT
    cv.RefNo,
    cv.CaseNo,
    cv.Chr,
    cv.`Start` AS Start_bp,
    cv.`End`   AS End_bp,
    cv.Type
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN cohort_cases AS cc
    ON cv.RefNo  = cc.RefNo
   AND cv.CaseNo = cc.CaseNo
),
band_map AS (
  SELECT
    b.cytoband_name,
    b.chromosome,
    b.hg38_start,
    b.hg38_stop,
    e.Type
  FROM events AS e
  JOIN `mitelman-db.prod.CytoBands_hg38` AS b
    ON e.Chr       = b.chromosome
   AND e.Start_bp <= b.hg38_stop
   AND e.End_bp   >= b.hg38_start
),
final AS (
  SELECT
    b.cytoband_name AS Band,
    b.chromosome    AS Chr,
    b.hg38_start,
    b.hg38_stop,
    SUM(CASE WHEN Type = 'Amp'  THEN 1 ELSE 0 END)                    AS amps,
    SUM(CASE WHEN Type = 'Gain' THEN 1 ELSE 0 END)                    AS gains,
    SUM(CASE WHEN Type = 'Loss' THEN 1 ELSE 0 END)                    AS losses,
    SUM(CASE WHEN LOWER(Type) LIKE '%homdel%' THEN 1 ELSE 0 END)      AS homdels
  FROM band_map AS b
  GROUP BY Band, Chr, hg38_start, hg38_stop
)
SELECT
  Chr,
  Band,
  hg38_start,
  hg38_stop,
  amps,
  ROUND(amps   * 100.0 / n.total, 2) AS amps_pct,
  gains,
  ROUND(gains  * 100.0 / n.total, 2) AS gains_pct,
  losses,
  ROUND(losses * 100.0 / n.total, 2) AS losses_pct,
  homdels,
  ROUND(homdels * 100.0 / n.total, 2) AS homdels_pct
FROM final, n_cases AS n
ORDER BY
  SAFE_CAST(REGEXP_REPLACE(Chr, r'chr', '') AS INT64),
  hg38_start,
  hg38_stop
LIMIT 20
