--Description: 6) Map one cohort event to its cytogenetic band
--              (overlap between event segment and band coordinates).
SELECT
  cv.RefNo,
  cv.CaseNo,
  cv.Chr,
  b.cytoband_name,
  cv.`Start` AS Start_bp,
  cv.`End`   AS End_bp,
  b.hg38_start,
  b.hg38_stop,
  cv.Type
FROM `mitelman-db.prod.CytoConverted` AS cv
JOIN (
      SELECT DISTINCT RefNo, CaseNo
      FROM `mitelman-db.prod.Cytogen`
      WHERE Morph = '3111' OR Topo = '0401'
     ) AS coh
  ON cv.RefNo  = coh.RefNo
 AND cv.CaseNo = coh.CaseNo
JOIN `mitelman-db.prod.CytoBands_hg38` AS b
  ON cv.Chr = b.chromosome
 AND cv.`Start` <= b.hg38_stop
 AND cv.`End`   >= b.hg38_start
LIMIT 20
