--Description: 9) Aggregate counts of amplifications, single-copy gains,
--              single-copy losses and homozygous deletions per band.
WITH cohort_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' OR Topo = '0401'
),
events AS (
  SELECT
    cv.RefNo,
    cv.CaseNo,
    cv.Chr,
    cv.`Start` AS Start_bp,
    cv.`End`   AS End_bp,
    cv.Type
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN cohort_cases AS cc
    ON cv.RefNo  = cc.RefNo
   AND cv.CaseNo = cc.CaseNo
),
band_map AS (
  SELECT
    b.chromosome    AS Chr,
    b.cytoband_name AS Band,
    b.hg38_start,
    b.hg38_stop,
    e.Type
  FROM events AS e
  JOIN `mitelman-db.prod.CytoBands_hg38` AS b
    ON e.Chr       = b.chromosome
   AND e.Start_bp <= b.hg38_stop
   AND e.End_bp   >= b.hg38_start
)
SELECT
  Chr,
  Band,
  hg38_start,
  hg38_stop,
  SUM(CASE WHEN Type = 'Amp'  THEN 1 ELSE 0 END)                       AS Amplifications,
  SUM(CASE WHEN Type = 'Gain' THEN 1 ELSE 0 END)                       AS Gains,
  SUM(CASE WHEN Type = 'Loss' THEN 1 ELSE 0 END)                       AS Losses,
  SUM(CASE WHEN LOWER(Type) LIKE '%homdel%' THEN 1 ELSE 0 END)         AS Homozygous_Deletions
FROM band_map
GROUP BY Chr, Band, hg38_start, hg38_stop
ORDER BY Chr, hg38_start, hg38_stop
LIMIT 20
