SELECT `chromosome`,`cytoband_name`,`hg38_start`,`hg38_stop`
FROM   `mitelman-db.prod.CytoBands_hg38`
LIMIT 20;
```

```sql
--Description: 8) Show how a CytoConverter interval is assigned to one or
--              more cytobands (interval overlap demo)
SELECT cc.RefNo, cc.CaseNo, cc.Chr, cc.Start, cc.End,
       b.cytoband_name, b.hg38_start, b.hg38_stop
FROM   `mitelman-db.prod.CytoConverted`    cc
JOIN   `mitelman-db.prod.CytoBands_hg38`   b
ON     cc.Chr   = b.chromosome
AND    cc.Start < b.hg38_stop
AND    cc.End   > b.hg38_start
WHERE  cc.RefNo = 9843                     -- example RefNo from sample rows
LIMIT 20;
```

```sql
--Description: 9) Aggregate, for the cohort, the number of events per cytoband
--              and per CNV class (Gain, Loss, etc.)
SELECT b.cytoband_name,
       cc.Type,
       COUNT(DISTINCT CONCAT(cc.RefNo,'|',cc.CaseNo,'|',cc.InvNo,'|',cc.Clone)) AS n_events
FROM   `mitelman-db.prod.CytoConverted`  cc
JOIN   `mitelman-db.prod.Cytogen`        cg
ON     cc.RefNo  = cg.RefNo
AND    cc.CaseNo = cg.CaseNo
JOIN   `mitelman-db.prod.CytoBands_hg38` b
ON     cc.Chr   = b.chromosome
AND    cc.Start < b.hg38_stop
AND    cc.End   > b.hg38_start
WHERE  cg.Morph = '3111' OR cg.Topo = '0401'
GROUP  BY b.cytoband_name, cc.Type
LIMIT 20;
```

```sql
--Description: 10) Compute frequency (%) of each CNV class per cytoband,
--               ordered by chromosome ordinal and band position
WITH cohort AS (
  SELECT DISTINCT CONCAT(`RefNo`,'|',`CaseNo`,'|',`InvNo`,'|',`Clone`) AS sample_id
  FROM `mitelman-db.prod.CytoConverted` cc
  JOIN `mitelman-db.prod.Cytogen`       cg
  ON   cc.RefNo = cg.RefNo
  AND  cc.CaseNo = cg.CaseNo
  WHERE cg.Morph = '3111' OR cg.Topo = '0401'
),
band_events AS (
  SELECT b.cytoband_name,
         b.chromosome,
         b.hg38_start,
         b.hg38_stop,
         cc.Type,
         COUNT(DISTINCT CONCAT(cc.RefNo,'|',cc.CaseNo,'|',cc.InvNo,'|',cc.Clone)) AS n_samples
  FROM   `mitelman-db.prod.CytoConverted`  cc
  JOIN   `mitelman-db.prod.Cytogen`        cg
  ON     cc.RefNo = cg.RefNo
  AND    cc.CaseNo = cg.CaseNo
  JOIN   `mitelman-db.prod.CytoBands_hg38` b
  ON     cc.Chr   = b.chromosome
  AND    cc.Start < b.hg38_stop
  AND    cc.End   > b.hg38_start
  WHERE  cg.Morph = '3111' OR cg.Topo = '0401'
  GROUP  BY b.cytoband_name, b.chromosome, b.hg38_start, b.hg38_stop, cc.Type
)
SELECT chromosome                 AS chr,
       cytoband_name              AS band,
       hg38_start,
       hg38_stop,
       Type                       AS cnv_class,
       n_samples                  AS n_cases,
       ROUND(100.0 * n_samples / (SELECT COUNT(*) FROM cohort), 2) AS frequency_pct
FROM   band_events
ORDER  BY CAST(REGEXP_REPLACE(chromosome,'chr','') AS INT64),
          hg38_start,
          hg38_stop,
          cnv_class
LIMIT 20;
```
