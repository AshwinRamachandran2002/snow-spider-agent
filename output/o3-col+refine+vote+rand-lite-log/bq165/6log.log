```sql
--Description / Thinking process:
-- We want a single query that returns, for every cytogenetic band, the count and
-- percentage of samples that harbor each CNV class (Gain or Loss) in our cohort
-- of (a) breast-cancer cases (Morph = 3111) and (b) adenocarcinoma cases
-- (Topo = 0401). 
-- 
-- 1. cohort CTE  – gathers all distinct sample IDs (RefNo|CaseNo|InvNo|Clone)
--    present in CytoConverted which pass the Morph / Topo filter.  The count of
--    these rows is the denominator for frequency calculations.
-- 2. band_events CTE – overlaps CytoConverted intervals with CytoBands_hg38 to
--    assign every segment to one or more cytobands, then counts how many cohort
--    samples show a Gain or Loss in each band.
-- 3. Final SELECT – reports:
--        chr, band, genomic coordinates, cnv_class, n_cases, frequency_pct
--    and orders the output by chromosome ordinal (numeric chromosomes first,
--    then X/Y because SAFE_CAST gives NULL for them), then by band start/stop,
--    then by CNV class.
WITH cohort AS (
  SELECT DISTINCT
         CONCAT(cc.RefNo,'|',cc.CaseNo,'|',cc.InvNo,'|',cc.Clone) AS sample_id
  FROM `mitelman-db.prod.CytoConverted` AS cc
  JOIN `mitelman-db.prod.Cytogen`       AS cg
    ON cc.RefNo  = cg.RefNo
   AND cc.CaseNo = cg.CaseNo
  WHERE cg.Morph = '3111'          -- breast cancer
     OR cg.Topo  = '0401'          -- adenocarcinoma
),
band_events AS (
  SELECT
    b.cytoband_name,
    b.chromosome,
    b.hg38_start,
    b.hg38_stop,
    cc.Type,
    COUNT(DISTINCT CONCAT(cc.RefNo,'|',cc.CaseNo,'|',cc.InvNo,'|',cc.Clone)) AS n_samples
  FROM `mitelman-db.prod.CytoConverted`  AS cc
  JOIN `mitelman-db.prod.Cytogen`        AS cg
    ON cc.RefNo  = cg.RefNo
   AND cc.CaseNo = cg.CaseNo
  JOIN `mitelman-db.prod.CytoBands_hg38` AS b
    ON cc.Chr   = b.chromosome
   AND cc.Start < b.hg38_stop
   AND cc.End   > b.hg38_start
  WHERE cg.Morph = '3111' OR cg.Topo = '0401'
  GROUP BY b.cytoband_name, b.chromosome, b.hg38_start, b.hg38_stop, cc.Type
)
SELECT
  be.chromosome      AS chr,
  be.cytoband_name   AS band,
  be.hg38_start,
  be.hg38_stop,
  be.Type            AS cnv_class,
  be.n_samples       AS n_cases,
  ROUND(100.0 * be.n_samples / (SELECT COUNT(*) FROM cohort), 2) AS frequency_pct
FROM band_events AS be
ORDER BY
  SAFE_CAST(REGEXP_REPLACE(be.chromosome, r'^chr', '') AS INT64),  -- numeric chr first
  be.hg38_start,
  be.hg38_stop,
  cnv_class
LIMIT 20;
```
