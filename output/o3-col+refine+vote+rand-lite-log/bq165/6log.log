```sql
--Description: 4) Preview adenocarcinoma cases (topography = '0401') that we will include
SELECT `RefNo`,`CaseNo`,`Morph`,`Topo`,`Age`,`Sex`
FROM   `mitelman-db.prod.Cytogen`
WHERE  `Topo` = '0401'
LIMIT 20;
```

```sql
--Description: 5) Count how many distinct investigations (RefNo-CaseNo-InvNo-Clone)
--              exist in the combined cohort (breast cancer + adenocarcinoma)
SELECT COUNT(DISTINCT CONCAT(`RefNo`,'|',`CaseNo`,'|',`InvNo`,'|',`Clone`)) AS total_samples
FROM `mitelman-db.prod.CytoConverted` cc
JOIN `mitelman-db.prod.Cytogen` cg
ON  cc.RefNo  = cg.RefNo
AND cc.CaseNo = cg.CaseNo
WHERE cg.Morph = '3111' OR cg.Topo = '0401'
LIMIT 20;
```

```sql
--Description: 6) Show a few CytoConverter segments that belong to the cohort of interest
SELECT cc.RefNo, cc.CaseNo, cc.InvNo, cc.Clone,
       cc.Chr, cc.Start, cc.End, cc.Type
FROM   `mitelman-db.prod.CytoConverted` cc
JOIN   `mitelman-db.prod.Cytogen`     cg
ON     cc.RefNo  = cg.RefNo
AND    cc.CaseNo = cg.CaseNo
WHERE  cg.Morph = '3111' OR cg.Topo = '0401'
LIMIT 20;
```

```sql
--Description: 7) Inspect the cytogenetic bands (hg38) – we need them for
