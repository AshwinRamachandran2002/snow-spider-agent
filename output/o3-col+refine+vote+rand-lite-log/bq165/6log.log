--Description: 6) Show a few CytoConverter segments that belong to the cohort of interest
SELECT
  cc.RefNo,
  cc.CaseNo,
  cc.InvNo,
  cc.Clone,
  cc.Chr,
  cc.Start,
  cc.End,
