```sql
--Description: 10) Compute frequency (%) of each CNV class per cytoband for the cohort
WITH cohort AS (
  SELECT DISTINCT
         CONCAT(cc.RefNo, '|', cc.CaseNo, '|', cc.InvNo, '|', cc.Clone) AS sample_id
  FROM `mitelman-db.prod.CytoConverted` AS cc
  JOIN `mitelman-db.prod.Cytogen`       AS cg
    ON cc.RefNo  = cg.RefNo
   AND cc.CaseNo = cg.CaseNo
  WHERE cg.Morph = '3111'
     OR cg.Topo  = '0401'
),
band_events AS (
  SELECT
    b.cytoband_name,
    b.chromosome,
    b.hg38_start,
    b.hg38_stop,
    cc.Type,
    COUNT(DISTINCT CONCAT(cc.RefNo, '|', cc.CaseNo, '|', cc.InvNo, '|', cc.Clone)) AS n_samples
  FROM `mitelman-db.prod.CytoConverted`  AS cc
  JOIN `mitelman-db.prod.Cytogen`        AS cg
    ON cc.RefNo  = cg.RefNo
   AND cc.CaseNo = cg.CaseNo
  JOIN `mitelman-db.prod.CytoBands_hg38` AS b
    ON cc.Chr   = b.chromosome
   AND cc.Start < b.hg38_stop
   AND cc.End   > b.hg38_start
  WHERE cg.Morph = '3111'
     OR cg.Topo  = '0401'
  GROUP BY b.cytoband_name, b.chromosome, b.hg38_start, b.hg38_stop, cc.Type
)
SELECT
  band_events.chromosome          AS chr,
  band_events.cytoband_name       AS band,
  band_events.hg38_start,
  band_events.hg38_stop,
  band_events.Type                AS cnv_class,
  band_events.n_samples           AS n_cases,
  ROUND(100.0 * band_events.n_samples / (SELECT COUNT(*) FROM cohort), 2) AS frequency_pct
FROM band_events
ORDER BY
  SAFE_CAST(REGEXP_REPLACE(band_events.chromosome, r'chr', '') AS INT64),
  band_events.hg38_start,
  band_events.hg38_stop,
  band_events.cnv_class
LIMIT 20;
```
