WITH sample_cpc AS (
    SELECT DISTINCT pc.value:"code"::STRING AS "cpc_code"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") pc
    WHERE pc.value:"first"::BOOLEAN = TRUE
