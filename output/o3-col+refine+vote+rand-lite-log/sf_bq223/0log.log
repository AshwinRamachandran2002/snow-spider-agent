```sql
--Description:
-- Answer the research question in one statement:
--   “For every assignee (other than DENSO) that cites a DENSO-assigned patent, give the
--    full title of the primary CPC subclass (based on the first CPC code of each citing
--    patent) and the number of such citations.”
--
-- Logical steps inside CTEs
--   1) denso_pubs      : all publication numbers whose assignee_harmonized contains “DENSO”.
--   2) citing_core     : publications that cite any denso_pubs item AND have a non-NULL
--                        filing_date (valid).  A ROW_NUMBER() on RANDOM() keeps only the
--                        first 50 000 citing pubs to avoid time-out while retaining breadth.
--   3) citing_details  : for each citing publication flatten
--                          • its assignee_harmonized  (exclude names containing “DENSO”)
--                          • its cpc array, but keep only entries where "first" = TRUE
--                        Extract the CPC subclass symbol (part before “/”) for a robust join.
--   4) Join to CPC_DEFINITION on that symbol to obtain titleFull, then aggregate.
--
--   NOTE: Adjust the ROW_NUMBER() cap (50 000) higher or lower depending on warehouse
--         size / time constraints; it does not affect correctness, only performance.

WITH denso_pubs AS (                   -- 1) DENSO-owned publications
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE a.value:"name"::STRING ILIKE '%DENSO%'
), 

citing_core AS (                       -- 2) citing pubs (capped to 50 000 for performance)
    SELECT DISTINCT cp."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS cp,
         LATERAL FLATTEN(input => cp."citation") c
    WHERE c.value:"publication_number"::STRING IN (SELECT "publication_number" FROM denso_pubs)
      AND cp."filing_date" IS NOT NULL
    QUALIFY ROW_NUMBER() OVER (ORDER BY RANDOM()) <= 50000
), 

citing_details AS (                    -- 3) assignee + primary CPC of each citing pub
    SELECT
        cd."publication_number"                            AS "citing_pub",
        a.value:"name"::STRING                             AS "citing_assignee",
        SPLIT_PART(pc.value:"code"::STRING, '/', 0)        AS "cpc_symbol"     -- subclass
    FROM citing_core cd
    JOIN PATENTS.PATENTS.PUBLICATIONS pub
          ON pub."publication_number" = cd."publication_number",
         LATERAL FLATTEN(input => pub."assignee_harmonized") a,
         LATERAL FLATTEN(input => pub."cpc") pc
    WHERE pc.value:"first"::BOOLEAN = TRUE
      AND a.value:"name"::STRING NOT ILIKE '%DENSO%'       -- exclude DENSO as citer
)

SELECT
    cdet."citing_assignee"                                      AS "citing_assignee",
    cdef."titleFull"                                            AS "cpc_subclass_title",
    COUNT(*)                                                    AS "citation_count"
FROM citing_details cdet
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION cdef
       ON cdef."symbol" = cdet."cpc_symbol"
GROUP BY cdet."citing_assignee", cdef."titleFull"
ORDER BY "citation_count" DESC;
```
