Query:
--Description: 
-- 3) Aggregate citation counts by citing assignee and CPC subclass title (exclude DENSO as citer).
WITH denso_pubs AS (
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."assignee_harmonized") ah
    WHERE ah.value:"name"::STRING ILIKE '%DENSO%'
), 
citing_set AS (                                         -- citing pubs with valid date (≤50 000 random)
    SELECT DISTINCT cp."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS cp,
         LATERAL FLATTEN(input => cp."citation") c
    WHERE c.value:"publication_number"::STRING IN (SELECT "publication_number" FROM denso_pubs)
      AND cp."filing_date" IS NOT NULL
    QUALIFY ROW_NUMBER() OVER (ORDER BY RANDOM()) <= 50000
), 
citing_details AS (
    SELECT 
        cs."publication_number"                         AS "citing_pub",
        a.value:"name"::STRING                          AS "citing_assignee",
        SPLIT_PART(pc.value:"code"::STRING,'/',0)       AS "cpc_symbol"
    FROM citing_set cs
    JOIN PATENTS.PATENTS.PUBLICATIONS pub
          ON pub."publication_number" = cs."publication_number",
         LATERAL FLATTEN(input => pub."assignee_harmonized") a,
         LATERAL FLATTEN(input => pub."cpc") pc
    WHERE pc.value:"first"::BOOLEAN = TRUE
      AND a.value:"name"::STRING NOT ILIKE '%DENSO%'    -- exclude DENSO as citer
)
SELECT  
    cd."citing_assignee",
    def."titleFull"                                     AS "cpc_title",
    COUNT(*)                                            AS "citation_count"
FROM citing_details cd
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION def
       ON def."symbol" = cd."cpc_symbol"
GROUP BY cd."citing_assignee", def."titleFull"
ORDER BY "citation_count" DESC
LIMIT 20
