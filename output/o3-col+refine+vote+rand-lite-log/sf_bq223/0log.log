```sql
--Description: Aggregate count of citations by citing assignee and CPC subclass title, excluding DENSO as citing assignee.
WITH denso_pubs AS (
    SELECT DISTINCT t."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."assignee_harmonized") f
    WHERE f.value:"name"::STRING ILIKE '%DENSO%'
),
citing_details AS (
    SELECT 
        cp."publication_number"                          AS "citing_pub",
        a.value:"name"::STRING                           AS "citing_assignee",
        pc.value:"code"::STRING                          AS "cpc_code"
    FROM  PATENTS.PATENTS.PUBLICATIONS cp,
          LATERAL FLATTEN(input => cp."citation") c,
          LATERAL FLATTEN(input => cp."assignee_harmonized") a,
          LATERAL FLATTEN(input => cp."cpc") pc
    JOIN  denso_pubs dp
          ON c.value:"publication_number"::STRING = dp."publication_number"
    WHERE pc.value:"first"::BOOLEAN = TRUE
      AND a.value:"name"::STRING NOT ILIKE '%DENSO%'
      AND cp."filing_date" IS NOT NULL
)
SELECT  
    cd_det."citing_assignee",
    cd_def."titleFull"                                   AS "cpc_title",
    COUNT(*)                                             AS "citation_count"
FROM citing_details cd_det
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION cd_def
       ON cd_def."symbol" = cd_det."cpc_code"
GROUP BY cd_det."citing_assignee",
         cd_def."titleFull"
ORDER BY "citation_count" DESC
LIMIT 20;
