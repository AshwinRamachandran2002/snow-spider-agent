```sql
--Description: Link primary CPC codes of citing patents to their full titles in CPC_DEFINITION.
WITH denso_pubs AS (
    SELECT DISTINCT t."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."assignee_harmonized") f
    WHERE f.value:"name"::STRING ILIKE '%DENSO%'
),
citing_with_first_cpc AS (
    SELECT 
        cp."publication_number"                          AS "citing_pub",
        pc.value:"code"::STRING                          AS "cpc_code"
    FROM  PATENTS.PATENTS.PUBLICATIONS cp,
          LATERAL FLATTEN(input => cp."citation") c,
          LATERAL FLATTEN(input => cp."cpc") pc
    JOIN  denso_pubs dp
          ON c.value:"publication_number"::STRING = dp."publication_number"
    WHERE pc.value:"first"::BOOLEAN = TRUE
)
SELECT  
    cw."citing_pub",
    cw."cpc_code",
    cd."titleFull"
FROM   citing_with_first_cpc cw
LEFT  JOIN PATENTS.PATENTS.CPC_DEFINITION cd
       ON cd."symbol" = cw."cpc_code"
LIMIT 20;
