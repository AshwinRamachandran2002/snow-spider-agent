--Description: Examine primary (first=true) CPC codes for citing patents that reference DENSO to identify CPC subclasses.
WITH denso_pubs AS (
    SELECT DISTINCT t."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
