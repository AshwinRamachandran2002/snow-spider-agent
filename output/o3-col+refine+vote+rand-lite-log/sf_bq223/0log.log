Query:
--Description: Retrieve publication numbers and filing dates for patents assigned to DENSO CORP with valid filing_date.
SELECT 
    t."publication_number",
    t."filing_date",
    f.value:"name"::STRING AS "assignee_name"
FROM  PATENTS.PATENTS.PUBLICATIONS t,
      LATERAL FLATTEN(input => t."assignee_harmonized") f
