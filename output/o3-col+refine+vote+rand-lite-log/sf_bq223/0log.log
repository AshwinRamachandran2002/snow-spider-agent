--Description: 
-- 1) Sample primary CPC codes (first=true) for patents that cite a DENSO-assigned publication.
WITH denso_pubs AS (                              -- gather DENSO-owned publication numbers
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."assignee_harmonized") ah
    WHERE ah.value:"name"::STRING ILIKE '%DENSO%'
), 
citing_core AS (                                  -- citing pubs with valid filing date (≤10 000 random for speed)
    SELECT DISTINCT cp."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS cp,
         LATERAL FLATTEN(input => cp."citation") c
    WHERE c.value:"publication_number"::STRING IN (SELECT "publication_number" FROM denso_pubs)
      AND cp."filing_date" IS NOT NULL
    QUALIFY ROW_NUMBER() OVER (ORDER BY RANDOM()) <= 10000
)
SELECT  
    cc."publication_number"                            AS "citing_pub",
    pc.value:"code"::STRING                            AS "cpc_code",
    pc.value:"first"::BOOLEAN                          AS "is_first"
FROM citing_core cc
JOIN PATENTS.PATENTS.PUBLICATIONS pub
     ON pub."publication_number" = cc."publication_number",
     LATERAL FLATTEN(input => pub."cpc") pc
WHERE pc.value:"first"::BOOLEAN = TRUE
LIMIT 20;
```

```sql
--Description: 
-- 2) Link those primary CPC codes to their full titles in CPC_DEFINITION for a random sample of citing pubs.
WITH denso_pubs AS (
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."assignee_harmonized") ah
    WHERE ah.value:"name"::STRING ILIKE '%DENSO%'
), 
citing_core AS (
    SELECT DISTINCT cp."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS cp,
         LATERAL FLATTEN(input => cp."citation") c
    WHERE c.value:"publication_number"::STRING IN (SELECT "publication_number" FROM denso_pubs)
      AND cp."filing_date" IS NOT NULL
    QUALIFY ROW_NUMBER() OVER (ORDER BY RANDOM()) <= 10000
), 
citing_with_first_cpc AS (
    SELECT 
        cc."publication_number"                            AS "citing_pub",
        pc.value:"code"::STRING                            AS "cpc_code"
    FROM citing_core cc
    JOIN PATENTS.PATENTS.PUBLICATIONS pub
         ON pub."publication_number" = cc."publication_number",
         LATERAL FLATTEN(input => pub."cpc") pc
    WHERE pc.value:"first"::BOOLEAN = TRUE
)
