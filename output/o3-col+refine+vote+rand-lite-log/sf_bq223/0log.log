```sql
--Description: 
/*  Thinking process
    ---------------------------------------------------------
    Objective      : Identify (sampled) assignees that cite any patent assigned to “DENSO CORP”, 
                     together with the title of the primary CPC subclass and a citation count. 
                     Exclude cases where the citer itself is DENSO.

    Key steps
    1. denso_pubs   : Collect all publication numbers with an assignee_harmonized name that contains “DENSO”.
    2. citing_cte   : Pull DISTINCT citing publications that reference one of those DENSO pubs
                      (look inside the flattened citation array).  Require a non-NULL filing_date.
                      To keep the workload small enough to avoid time-out we randomly sample 20 000 rows.
    3. details_cte  : For those citing pubs, extract the (first=true) CPC code and assignee(s),
                      still excluding “DENSO” assignees.
    4. Join to CPC_DEFINITION on the subclass symbol to obtain the full title,
       then group and count.  Output is capped (LIMIT 20) for a quick view.

    ---------------------------------------------------------
*/

WITH denso_pubs AS (                       -- 1) All DENSO-assigned publication numbers
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS  p,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE a.value:"name"::STRING ILIKE '%DENSO%'
), 

citing_cte AS (                           -- 2) Citing publications (sampled to stay fast)
    SELECT DISTINCT cp."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS cp, 
         LATERAL FLATTEN(input => cp."citation") c
    WHERE c.value:"publication_number"::STRING IN (SELECT "publication_number" FROM denso_pubs)
      AND cp."filing_date" IS NOT NULL
    SAMPLE (20000)                        -- random sample to reduce volume / run-time
),

details_cte AS (                          -- 3) Extract citing assignee + primary CPC
    SELECT  
        cp."publication_number"                               AS "citing_pub",
        a.value:"name"::STRING                                AS "citing_assignee",
        SPLIT_PART(pc.value:"code"::STRING,'/',0)             AS "cpc_subclass"   -- keep symbol up to “/”
    FROM citing_cte cp
    JOIN PATENTS.PATENTS.PUBLICATIONS pub
          ON pub."publication_number" = cp."publication_number",
         LATERAL FLATTEN(input => pub."assignee_harmonized") a,
         LATERAL FLATTEN(input => pub."cpc") pc
    WHERE pc.value:"first"::BOOLEAN = TRUE
      AND a.value:"name"::STRING NOT ILIKE '%DENSO%'          -- exclude DENSO as citer
)

SELECT  
    d."citing_assignee",
    cd."titleFull"                                            AS "cpc_title",
    COUNT(*)                                                  AS "citation_count"
FROM details_cte d
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION cd
       ON cd."symbol" = d."cpc_subclass"
GROUP BY d."citing_assignee", cd."titleFull"
ORDER BY "citation_count" DESC
LIMIT 20;
