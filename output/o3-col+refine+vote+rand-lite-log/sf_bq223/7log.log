--Description: 
-- Complete workflow in one SQL statement to address the task:
--   • Identify all patents whose assignee list contains “DENSO” (denso_pubs).
--   • Find every publication that cites at least one of those patents (citing_raw).
--   • Exclude publications that are themselves assigned to DENSO (non_denso_citers).
--   • For each remaining citing publication extract:
--         – citing_assignee  (assignee_harmonized element at array index 0)
--         – first_cpc        (CPC element at array index 0).
--   • Map the CPC symbol to its full subclass title via CPC_DEFINITION.
--   • Count citing publications by (citing_assignee, CPC subclass title).
WITH denso_pubs AS (                               -- DENSO-assigned publications
    SELECT DISTINCT pub."publication_number"
    FROM PATENTS.PATENTS."PUBLICATIONS" pub,
         LATERAL FLATTEN(INPUT => pub."assignee_harmonized") a
    WHERE a.value:"name"::STRING ILIKE '%DENSO%'
      AND pub."filing_date" > 0
),
citing_raw AS (                                    -- publications citing a DENSO patent
    SELECT DISTINCT cit."publication_number"
    FROM PATENTS.PATENTS."PUBLICATIONS" cit,
         LATERAL FLATTEN(INPUT => cit."citation") ct
         JOIN denso_pubs dp
           ON ct.value:"publication_number"::STRING = dp."publication_number"
    WHERE cit."filing_date" > 0
),
non_denso_citers AS (                              -- remove DENSO-assigned citers
    SELECT cr."publication_number"
    FROM citing_raw cr
    LEFT JOIN denso_pubs dp2
           ON cr."publication_number" = dp2."publication_number"
    WHERE dp2."publication_number" IS NULL
),
citing_info AS (                                   -- first assignee & first CPC
    SELECT 
        p."publication_number",
        MAX(CASE WHEN ass."INDEX" = 0 THEN ass.value:"name"::STRING END) AS citing_assignee,
        MAX(CASE WHEN cpc."INDEX" = 0 THEN cpc.value:"code"::STRING END) AS first_cpc
    FROM PATENTS.PATENTS."PUBLICATIONS" p,
         LATERAL FLATTEN(INPUT => p."assignee_harmonized") ass,
         LATERAL FLATTEN(INPUT => p."cpc") cpc
    WHERE p."publication_number" IN (SELECT "publication_number" FROM non_denso_citers)
    GROUP BY p."publication_number"
    HAVING citing_assignee IS NOT NULL AND first_cpc IS NOT NULL
)
SELECT 
    ci.citing_assignee                               AS "citing_assignee",
    def."titleFull"                                  AS "primary_cpc_subclass_title",
    COUNT(*)                                         AS "citation_count"
FROM citing_info ci
LEFT JOIN PATENTS.PATENTS."CPC_DEFINITION" def
       ON def."symbol" = ci.first_cpc
GROUP BY ci.citing_assignee, def."titleFull"
ORDER BY citation_count DESC
LIMIT 20;
