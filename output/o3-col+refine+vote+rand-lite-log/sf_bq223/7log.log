--Description: FINAL – Count citations by (citing assignee, CPC subclass title) excluding DENSO as citing assignee
WITH denso_pubs AS (
    SELECT DISTINCT 
           t."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."assignee_harmonized") f
    WHERE f.value:"name"::STRING ILIKE '%DENSO%'
      AND t."filing_date" > 0
),
citing AS (
    /* Citing publications that reference a DENSO patent and are not assigned to DENSO */
    SELECT DISTINCT
           cit."publication_number" AS "citing_pub"
    FROM PATENTS.PATENTS.PUBLICATIONS cit,
         LATERAL FLATTEN(input => cit."citation") c,
         denso_pubs d
    WHERE c.value:"publication_number"::STRING = d."publication_number"
      AND NOT EXISTS (
            SELECT 1
            FROM LATERAL FLATTEN(input => cit."assignee_harmonized") a
            WHERE a.value:"name"::STRING ILIKE '%DENSO%'
          )
      AND cit."filing_date" > 0
),
citing_info AS (
    /* Attach citing assignee name (first in list) and first CPC code */
    SELECT 
        c."citing_pub",
        MIN(ass.value:"name"::STRING)  AS "citing_assignee",
        MIN(cpc.value:"code"::STRING)  AS "first_cpc"
    FROM citing c
    JOIN PATENTS.PATENTS.PUBLICATIONS p
      ON p."publication_number" = c."citing_pub"
    ,   LATERAL FLATTEN(input => p."assignee_harmonized") ass
    ,   LATERAL FLATTEN(input => p."cpc") cpc
    GROUP BY c."citing_pub"
)
SELECT 
    ci."citing_assignee",
    def."titleFull"       AS "cpc_title",
    COUNT(*)              AS "citation_count"
FROM citing_info ci
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION def
       ON def."symbol" = ci."first_cpc"
GROUP BY ci."citing_assignee", def."titleFull"
ORDER BY "citation_count" DESC
LIMIT 20;
