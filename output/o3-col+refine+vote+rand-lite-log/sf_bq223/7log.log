--Description: 
-- One-shot SQL that:
--   1) builds the set of publications assigned to any “DENSO …” entity (denso_pubs);
--   2) finds every publication whose citation list includes at least one of those DENSO publications (citing_raw);
--   3) removes from that list any publication that is itself assigned to DENSO (citing_final);
--   4) for each remaining citing publication extracts
--        • citing_assignee  → assignee_harmonized element with INDEX = 0,
--        • first_cpc        → CPC element with INDEX = 0;
--   5) joins that CPC symbol to CPC_DEFINITION to obtain the full subclass title;
--   6) returns the count of citing publications for each (citing_assignee, CPC subclass title) pair.
--   The result therefore shows which non-DENSO assignees cite DENSO patents and
--   the primary CPC subclasses of those citing patents.
--   LIMIT 20 is added for a manageable preview.
WITH denso_pubs AS (                           -- DENSO-assigned publications
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE a.value:"name"::STRING ILIKE '%DENSO%'
      AND p."filing_date" > 0
),
citing_raw AS (                                -- publications that cite a DENSO publication
    SELECT DISTINCT cp."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS cp,
         LATERAL FLATTEN(input => cp."citation") c
         JOIN denso_pubs d
           ON c.value:"publication_number"::STRING = d."publication_number"
    WHERE cp."filing_date" > 0
),
