```sql
--Description: 
-- Objective:  Count citations to DENSO-assigned patents, grouped by (citing-assignee, title of the first CPC subclass on the citing patent),
--             while EXCLUDING any citations where the citing patent is itself assigned to DENSO.
-- Steps inside this single query (expressed as CTEs):
--   1. denso_pubs        : every publication whose assignee_harmonized list contains “DENSO”  (valid filing_date > 0).
--   2. citing_raw        : all publications that cite at least one denso_pubs item (via citation array), regardless of their own assignees.
--   3. denso_assignees   : helper list of publications whose own assignee list contains “DENSO”.
--   4. citing_final      : citing_raw MINUS anything in denso_assignees  → publications that cite DENSO patents but are NOT DENSO-assigned.
--   5. citing_info       : for each citing_final publication, extract
--                         • citing_assignee  = first element in assignee_harmonized array (lexicographically MIN = ordinal 0 trick),
--                         • first_cpc       = CPC code whose ordinal = 0 (again via MAX(CASE …) trick inside GROUP BY).
--   6. Join first_cpc to CPC_DEFINITION to get its full title, then GROUP BY assignee & title and count rows.
-- Note: LIMIT 20 to keep the result readable; remove for the complete list.

WITH denso_pubs AS (
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS."PUBLICATIONS" p,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE a.value:"name"::STRING ILIKE '%DENSO%'
      AND p."filing_date" > 0
),
citing_raw AS (
    SELECT DISTINCT cit."publication_number"
    FROM PATENTS.PATENTS."PUBLICATIONS" cit,
         LATERAL FLATTEN(input => cit."citation") c
         JOIN denso_pubs d
           ON c.value:"publication_number"::STRING = d."publication_number"
    WHERE cit."filing_date" > 0
),
denso_assignees AS (
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS."PUBLICATIONS" p,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE a.value:"name"::STRING ILIKE '%DENSO%'
),
citing_final AS (
    SELECT cr."publication_number"
    FROM citing_raw cr
    LEFT JOIN denso_assignees da
           ON cr."publication_number" = da."publication_number"
    WHERE da."publication_number" IS NULL        -- exclude DENSO-assigned citers
),
citing_info AS (
    SELECT 
        p."publication_number",
        MIN(ass.value:"name"::STRING)                                                   AS citing_assignee,
        MAX(CASE WHEN cpc.ordinal = 0 THEN cpc.value:"code"::STRING END)                AS first_cpc
    FROM PATENTS.PATENTS."PUBLICATIONS" p,
         LATERAL FLATTEN(input => p."assignee_harmonized") ass,
         LATERAL FLATTEN(input => p."cpc") cpc
    WHERE p."publication_number" IN (SELECT "publication_number" FROM citing_final)
    GROUP BY p."publication_number"
    HAVING first_cpc IS NOT NULL                                                       -- ensure at least one CPC
)
SELECT 
    ci.citing_assignee                          AS "citing_assignee",
    def."titleFull"                             AS "primary_cpc_subclass_title",
    COUNT(*)                                    AS "citation_count"
FROM citing_info ci
LEFT JOIN PATENTS.PATENTS."CPC_DEFINITION" def
       ON def."symbol" = ci.first_cpc
GROUP BY ci.citing_assignee, def."titleFull"
ORDER BY citation_count DESC
LIMIT 20;
```
