```sql
--Description: 
-- ONE-SHOT query (built with CTEs) that fulfils the task:
--   • Find every publication whose assignee list contains the string “DENSO” (→ denso_pubs).
--   • Identify all publications whose citation array references ≥1 of those DENSO publications (→ citing_raw).
--   • Remove any of the above that are themselves assigned to DENSO (→ citing_final).
--   • For each remaining citing publication extract:
--        – citing_assignee  = first assignee name (array index = 0) from assignee_harmonized
--        – first_cpc        = CPC code at array index = 0 (the “primary” CPC)
--   • Join that CPC symbol to CPC_DEFINITION to obtain its full subclass title.
--   • Finally, group by citing_assignee + CPC subclass title and count how many citing
--     publications fall into each bucket (i.e., count of citations).
--   • LIMIT 20 for a concise preview; remove or raise the limit for the complete list.
WITH denso_pubs AS (                    -- DENSO-assigned publications
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS."PUBLICATIONS" p,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE a.value:"name"::STRING ILIKE '%DENSO%'
      AND p."filing_date" > 0
),
citing_raw AS (                         -- Pubs that cite any DENSO pub
    SELECT DISTINCT cit."publication_number"
    FROM PATENTS.PATENTS."PUBLICATIONS" cit,
         LATERAL FLATTEN(input => cit."citation") c
         INNER JOIN denso_pubs d
           ON c.value:"publication_number"::STRING = d."publication_number"
    WHERE cit."filing_date" > 0
),
denso_assignees AS (                    -- Pubs whose OWN assignee list contains DENSO
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS."PUBLICATIONS" p,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE a.value:"name"::STRING ILIKE '%DENSO%'
),
citing_final AS (                       -- Non-DENSO publications citing DENSO patents
    SELECT cr."publication_number"
    FROM citing_raw cr
    LEFT JOIN denso_assignees da
           ON cr."publication_number" = da."publication_number"
    WHERE da."publication_number" IS NULL
),
citing_info AS (                        -- Extract first assignee + first CPC
    SELECT 
        p."publication_number",
        MIN(ass.value:"name"::STRING)                        AS citing_assignee,
        MIN(cpc.value:"code"::STRING)                        AS first_cpc
    FROM PATENTS.PATENTS."PUBLICATIONS" p,
         LATERAL FLATTEN(input => p."assignee_harmonized") ass,
         LATERAL FLATTEN(input => p."cpc") cpc
    WHERE p."publication_number" IN (SELECT "publication_number" FROM citing_final)
      AND cpc."index" = 0                                    -- keep only CPC at position 0
    GROUP BY p."publication_number"
    HAVING first_cpc IS NOT NULL
)
SELECT 
    ci.citing_assignee                                 AS "citing_assignee",
    def."titleFull"                                    AS "primary_cpc_subclass_title",
    COUNT(*)                                           AS "citation_count"
FROM citing_info ci
LEFT JOIN PATENTS.PATENTS."CPC_DEFINITION" def
       ON def."symbol" = ci.first_cpc
GROUP BY ci.citing_assignee, def."titleFull"
ORDER BY citation_count DESC
LIMIT 20;
