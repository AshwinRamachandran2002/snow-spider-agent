```sql
--Description: 
-- Deliver a fast, single-statement answer to:  
--   “Which non-DENSO assignees cite DENSO patents, and what are the primary CPC
--    subclass titles of those citing patents?”  
--
-- Design / thinking for performance and clarity:  
--   1. denso_pubs   – collect DENSO-assigned publications but restrict to those
--                     with publication_date ≥ 2010-01-01 (20100000) to shrink the set.  
--   2. citing_raw   – any publication whose citation array references one of those
--                     denso_pubs.  
--   3. citing_final – drop publications that are themselves DENSO-assigned and
--                     cap the list at 1 000 rows to keep execution snappy.  
--   4. citing_info  – for each remaining citing publication extract  
--          • citing_assignee  (array element index = 0 in assignee_harmonized)  
--          • first_cpc        (array element index = 0 in cpc)  
--   5. Join first_cpc to CPC_DEFINITION to obtain the full subclass title.  
--   6. Aggregate by (citing_assignee, subclass title) and count the citing
--      publications.  Show the 20 largest combinations.  
WITH denso_pubs AS (                     -- step 1: DENSO patents, 2010+
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS."PUBLICATIONS" p,
         LATERAL FLATTEN(input => p."assignee_harmonized") ah
    WHERE ah.value:"name"::STRING ILIKE '%DENSO%'
      AND p."publication_date" >= 20100000
      AND p."filing_date" > 0
),
citing_raw AS (                          -- step 2: citations pointing to those patents
    SELECT DISTINCT cp."publication_number"
    FROM PATENTS.PATENTS."PUBLICATIONS" cp,
         LATERAL FLATTEN(input => cp."citation") ct
         JOIN denso_pubs dp
           ON ct.value:"publication_number"::STRING = dp."publication_number"
    WHERE cp."filing_date" > 0
),
citing_final AS (                        -- step 3: non-DENSO citers, limited to 1k
    SELECT cr."publication_number"
    FROM citing_raw cr
    LEFT JOIN (
        SELECT DISTINCT p."publication_number"
        FROM PATENTS.PATENTS."PUBLICATIONS" p,
             LATERAL FLATTEN(input => p."assignee_harmonized") ah
        WHERE ah.value:"name"::STRING ILIKE '%DENSO%'
    ) denso_self
      ON cr."publication_number" = denso_self."publication_number"
    WHERE denso_self."publication_number" IS NULL
    LIMIT 1000
),
citing_info AS (                         -- step 4: pull first assignee + first CPC
    SELECT 
        p."publication_number",
        MAX(CASE WHEN ass."INDEX" = 0 THEN ass.value:"name"::STRING END) AS citing_assignee,
        MAX(CASE WHEN cpc."INDEX" = 0 THEN cpc.value:"code"::STRING END) AS first_cpc
    FROM PATENTS.PATENTS."PUBLICATIONS" p,
         LATERAL FLATTEN(input => p."assignee_harmonized") ass,
         LATERAL FLATTEN(input => p."cpc") cpc
    WHERE p."publication_number" IN (SELECT "publication_number" FROM citing_final)
    GROUP BY p."publication_number"
    HAVING first_cpc IS NOT NULL AND citing_assignee IS NOT NULL
)
SELECT 
    ci.citing_assignee                               AS "citing_assignee",
    def."titleFull"                                  AS "primary_cpc_subclass_title",
    COUNT(*)                                         AS "citation_count"
FROM citing_info ci
LEFT JOIN PATENTS.PATENTS."CPC_DEFINITION" def
       ON def."symbol" = ci.first_cpc
GROUP BY ci.citing_assignee, def."titleFull"
ORDER BY citation_count DESC
LIMIT 20;
