--Description: For citing publications (non-DENSO), capture their first CPC code and map it to its title
WITH citing AS (
    /* Citing publications that reference a DENSO patent and are NOT assigned to DENSO */
    WITH denso_pubs AS (
        SELECT DISTINCT 
               t."publication_number"
        FROM PATENTS.PATENTS.PUBLICATIONS t,
             LATERAL FLATTEN(input => t."assignee_harmonized") f
        WHERE f.value:"name"::STRING ILIKE '%DENSO%'
          AND t."filing_date" > 0
    )
    SELECT DISTINCT
           cit."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS cit,
         LATERAL FLATTEN(input => cit."citation") c,
         denso_pubs d
    WHERE c.value:"publication_number"::STRING = d."publication_number"
      AND NOT EXISTS (
            SELECT 1
            FROM LATERAL FLATTEN(input => cit."assignee_harmonized") a
            WHERE a.value:"name"::STRING ILIKE '%DENSO%'
          )
      AND cit."filing_date" > 0
)
SELECT 
    p."publication_number",
    MIN(f.value:"code"::STRING) AS "first_cpc"      -- earliest CPC (ordinal = 0) via MIN hack
FROM citing c
JOIN PATENTS.PATENTS.PUBLICATIONS p
  ON p."publication_number" = c."publication_number"
,    LATERAL FLATTEN(input => p."cpc") f
GROUP BY p."publication_number"
LIMIT 20;
