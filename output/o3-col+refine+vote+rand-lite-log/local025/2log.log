```sql
--Description: 1)  Batsman-runs per match / innings / over (sample 20 rows)
SELECT "match_id",
       "innings_no",
       "over_id",
       SUM("runs_scored") AS "bat_runs"
FROM   "batsman_scored"
GROUP  BY "match_id","innings_no","over_id"
LIMIT  20;
```

```sql
--Description: 2)  Extra-runs per match / innings / over (sample 20 rows)
SELECT "match_id",
       "innings_no",
       "over_id",
       SUM("extra_runs") AS "extra_runs"
FROM   "extra_runs"
GROUP  BY "match_id","innings_no","over_id"
LIMIT  20;
```

```sql
--Description: 3)  Combine bat + extra runs to get total runs per over (sample 20 rows)
SELECT bs."match_id",
       bs."innings_no",
       bs."over_id",
       bs."bat_runs" + COALESCE(er."extra_runs",0) AS "total_runs"
FROM  (SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"
       FROM   "batsman_scored"
       GROUP  BY "match_id","innings_no","over_id")  AS bs
LEFT  JOIN
      (SELECT "match_id","innings_no","over_id",SUM("extra_runs")  AS "extra_runs"
       FROM   "extra_runs"
       GROUP  BY "match_id","innings_no","over_id")  AS er
ON    bs."match_id"  = er."match_id"
AND   bs."innings_no"= er."innings_no"
AND   bs."over_id"   = er."over_id"
LIMIT 20;
```

```sql
--Description: 4)  Highest-scoring over of each match (first 20 matches shown)
WITH over_runs AS (
     SELECT bs."match_id",
            bs."innings_no",
            bs."over_id",
            bs."bat_runs" + COALESCE(er."extra_runs",0) AS "total_runs"
     FROM  (SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"
            FROM   "batsman_scored"
            GROUP  BY "match_id","innings_no","over_id")  AS bs
     LEFT  JOIN
           (SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "extra_runs"
            FROM   "extra_runs"
            GROUP  BY "match_id","innings_no","over_id")  AS er
     ON   bs."match_id"  = er."match_id"
     AND  bs."innings_no"= er."innings_no"
     AND  bs."over_id"   = er."over_id"
)
SELECT o1."match_id",
       o1."innings_no",
       o1."over_id",
       o1."total_runs"
FROM   over_runs o1
WHERE  o1."total_runs" = (SELECT MAX(o2."total_runs")
                          FROM   over_runs o2
                          WHERE  o2."match_id" = o1."match_id")
LIMIT  20;
```

```sql
--Description: 5)  Bowler who delivered each over (distinct rows, sample 20)
SELECT DISTINCT "match_id",
       "innings_no",
       "over_id",
       "bowler"
FROM   "ball_by_ball"
LIMIT  20;
```

```sql
--Description: 6)  Highest-scoring over per match together with the bowler (first 20 matches)
WITH over_runs AS (
     SELECT bs."match_id",
            bs."innings_no",
            bs."over_id",
            bs."bat_runs" + COALESCE(er."extra_runs",0) AS "total_runs"
     FROM  (SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"
            FROM   "batsman_scored"
            GROUP  BY "match_id","innings_no","over_id")  AS bs
     LEFT  JOIN
           (SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "extra_runs"
            FROM   "extra_runs"
            GROUP  BY "match_id","innings_no","over_id")  AS er
     ON   bs."match_id"  = er."match_id"
     AND  bs."innings_no"= er."innings_no"
     AND  bs."over_id"   = er."over_id"
),
max_over AS (
     SELECT o1.*
     FROM   over_runs o1
     WHERE  o1."total_runs" = (SELECT MAX(o2."total_runs")
                               FROM   over_runs o2
                               WHERE  o2."match_id" = o1."match_id")
)
SELECT mo."match_id",
       mo."innings_no",
       mo."over_id",
       mo."total_runs",
       MIN(bb."bowler") AS "bowler_id"
FROM   max_over mo
JOIN   "ball_by_ball" bb
  ON   bb."match_id"  = mo."match_id"
 AND   bb."innings_no"= mo."innings_no"
 AND   bb."over_id"   = mo."over_id"
GROUP  BY mo."match_id"
LIMIT  20;
```

```sql
--Description: 7)  Average runs of the highest-scoring over across all matches
WITH over_runs AS (
     SELECT bs."match_id",
            bs."innings_no",
            bs."over_id",
            bs."bat_runs" + COALESCE(er."extra_runs",0) AS "total_runs"
     FROM  (SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"
            FROM   "batsman_scored"
            GROUP  BY "match_id","innings_no","over_id")  AS bs
     LEFT  JOIN
           (SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "extra_runs"
            FROM   "extra_runs"
            GROUP  BY "match_id","innings_no","over_id")  AS er
     ON   bs."match_id"  = er."match_id"
     AND  bs."innings_no"= er."innings_no"
     AND  bs."over_id"   = er."over_id"
),
max_over AS (
     SELECT o1.*
     FROM   over_runs o1
     WHERE  o1."total_runs" = (SELECT MAX(o2."total_runs")
                               FROM   over_runs o2
                               WHERE  o2."match_id" = o1."match_id")
)
SELECT AVG("total_runs") AS "avg_best_over_runs"
FROM   max_over;
```

```sql
--Description: 8)  Bowler name with highest-scoring over (sample 20 matches)
WITH over_runs AS (
     SELECT bs."match_id",
            bs."innings_no",
            bs."over_id",
            bs."bat_runs" + COALESCE(er."extra_runs",0) AS "total_runs"
     FROM  (SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"
            FROM   "batsman_scored"
            GROUP  BY "match_id","innings_no","over_id")  AS bs
     LEFT  JOIN
           (SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "extra_runs"
            FROM   "extra_runs"
            GROUP  BY "match_id","innings_no","over_id")  AS er
     ON   bs."match_id"  = er."match_id"
     AND  bs."innings_no"= er."innings_no"
     AND  bs."over_id"   = er."over_id"
),
max_over AS (
     SELECT o1.*
     FROM   over_runs o1
     WHERE  o1."total_runs" = (SELECT MAX(o2."total_runs")
                               FROM   over_runs o2
                               WHERE  o2."match_id" = o1."match_id")
),
bowled AS (
     SELECT mo."match_id",
            mo."total_runs",
            MIN(bb."bowler") AS "bowler_id"
     FROM   max_over mo
     JOIN   "ball_by_ball" bb
       ON   bb."match_id"  = mo."match_id"
      AND   bb."innings_no"= mo."innings_no"
      AND   bb."over_id"   = mo."over_id"
     GROUP  BY mo."match_id"
)
SELECT b."match_id",
       p."player_name",
       b."total_runs"
FROM   bowled b
JOIN   "player" p
  ON   p."player_id" = b."bowler_id"
LIMIT  20;
```
