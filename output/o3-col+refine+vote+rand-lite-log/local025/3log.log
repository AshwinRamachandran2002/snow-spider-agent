```sql
--Description: Combine batsman runs and extra runs per ball for one sample match (335987)  
SELECT DISTINCT
       bb."match_id",
       bb."over_id",
       bb."ball_id",
       COALESCE(bs."runs_scored",0)      AS "bat_runs",
       COALESCE(er."extra_runs",0)       AS "extra_runs",
       COALESCE(bs."runs_scored",0)
       + COALESCE(er."extra_runs",0)     AS "total_ball_runs"
FROM   "ball_by_ball"  AS bb
LEFT JOIN "batsman_scored" AS bs
       ON bb."match_id" = bs."match_id"
      AND bb."over_id"  = bs."over_id"
      AND bb."ball_id"  = bs."ball_id"
      AND bb."innings_no" = bs."innings_no"
LEFT JOIN "extra_runs" AS er
       ON bb."match_id" = er."match_id"
      AND bb."over_id"  = er."over_id"
      AND bb."ball_id"  = er."ball_id"
      AND bb."innings_no" = er."innings_no"
WHERE  bb."match_id" = 335987
LIMIT  20;
```

```sql
--Description: Compute total runs in every over (across both innings) for all matches
SELECT DISTINCT
       bb."match_id",
       bb."innings_no",
       bb."over_id",
       SUM( COALESCE(bs."runs_scored",0) 
          + COALESCE(er."extra_runs",0) ) AS "runs_in_over"
FROM   "ball_by_ball"  AS bb
LEFT JOIN "batsman_scored" AS bs
       ON bb."match_id" = bs."match_id"
      AND bb."over_id"  = bs."over_id"
      AND bb."ball_id"  = bs."ball_id"
      AND bb."innings_no" = bs."innings_no"
LEFT JOIN "extra_runs" AS er
       ON bb."match_id" = er."match_id"
      AND bb."over_id"  = er."over_id"
      AND bb."ball_id"  = er."ball_id"
      AND bb."innings_no" = er."innings_no"
GROUP  BY bb."match_id", bb."innings_no", bb."over_id"
LIMIT  20;
```

```sql
--Description: For every match & innings, pick the single over with the highest run total
SELECT DISTINCT
       t1."match_id",
       t1."innings_no",
       t1."over_id",
       t1."runs_in_over"
FROM  (
        SELECT
               bb."match_id",
               bb."innings_no",
               bb."over_id",
               SUM( COALESCE(bs."runs_scored",0) 
                  + COALESCE(er."extra_runs",0) ) AS "runs_in_over",
               RANK() OVER (PARTITION BY bb."match_id", bb."innings_no" 
                            ORDER BY SUM( COALESCE(bs."runs_scored",0) 
                                        + COALESCE(er."extra_runs",0) ) DESC) AS "rnk"
        FROM   "ball_by_ball"  AS bb
        LEFT JOIN "batsman_scored" AS bs
               ON bb."match_id" = bs."match_id"
              AND bb."over_id"  = bs."over_id"
              AND bb."ball_id"  = bs."ball_id"
              AND bb."innings_no" = bs."innings_no"
        LEFT JOIN "extra_runs" AS er
               ON bb."match_id" = er."match_id"
              AND bb."over_id"  = er."over_id"
              AND bb."ball_id"  = er."ball_id"
              AND bb."innings_no" = er."innings_no"
        GROUP  BY bb."match_id", bb."innings_no", bb."over_id"
      ) AS t1
WHERE  t1."rnk" = 1
LIMIT  20;
```

```sql
--Description: Attach the bowler (first ball of that over) to every highest-scoring over
SELECT DISTINCT
       mo."match_id",
       mo."innings_no",
       mo."over_id",
       mo."runs_in_over",
       MIN(bb."bowler") AS "bowler_id"
FROM   (
        -- same derived table as previous step
        SELECT
               bb."match_id",
               bb."innings_no",
               bb."over_id",
               SUM( COALESCE(bs."runs_scored",0) 
                  + COALESCE(er."extra_runs",0) ) AS "runs_in_over",
               RANK() OVER (PARTITION BY bb."match_id", bb."innings_no"
                            ORDER BY SUM( COALESCE(bs."runs_scored",0) 
                                        + COALESCE(er."extra_runs",0) ) DESC) AS "rnk"
        FROM   "ball_by_ball"  AS bb
        LEFT JOIN "batsman_scored" AS bs
               ON bb."match_id" = bs."match_id"
              AND bb."over_id"  = bs."over_id"
              AND bb."ball_id"  = bs."ball_id"
              AND bb."innings_no" = bs."innings_no"
        LEFT JOIN "extra_runs" AS er
               ON bb."match_id" = er."match_id"
              AND bb."over_id"  = er."over_id"
              AND bb."ball_id"  = er."ball_id"
              AND bb."innings_no" = er."innings_no"
        GROUP  BY bb."match_id", bb."innings_no", bb."over_id"
      ) AS mo
JOIN   "ball_by_ball" AS bb
       ON  mo."match_id"   = bb."match_id"
       AND mo."innings_no" = bb."innings_no"
       AND mo."over_id"    = bb."over_id"
WHERE  mo."rnk" = 1
GROUP  BY mo."match_id", mo."innings_no", mo."over_id", mo."runs_in_over"
LIMIT  20;
```

```sql
--Description: Bring the bowler’s name from player table for readability
SELECT DISTINCT
       ho."match_id",
       ho."innings_no",
       ho."over_id",
       ho."runs_in_over",
       p."player_name" AS "bowler_name"
FROM (
       -- highest over with bowler_id query
       SELECT
              mo."match_id",
              mo."innings_no",
              mo."over_id",
              mo."runs_in_over",
              MIN(bb."bowler") AS "bowler_id"
       FROM   (
                SELECT
                       bb."match_id",
                       bb."innings_no",
                       bb."over_id",
                       SUM( COALESCE(bs."runs_scored",0) 
                          + COALESCE(er."extra_runs",0) ) AS "runs_in_over",
                       RANK() OVER (PARTITION BY bb."match_id", bb."innings_no"
                                    ORDER BY SUM( COALESCE(bs."runs_scored",0) 
                                                + COALESCE(er."extra_runs",0) ) DESC) AS "rnk"
                FROM   "ball_by_ball"  AS bb
                LEFT JOIN "batsman_scored" AS bs
                       ON bb."match_id" = bs."match_id"
                      AND bb."over_id"  = bs."over_id"
                      AND bb."ball_id"  = bs."ball_id"
                      AND bb."innings_no" = bs."innings_no"
                LEFT JOIN "extra_runs" AS er
                       ON bb."match_id" = er."match_id"
                      AND bb."over_id"  = er."over_id"
                      AND bb."ball_id"  = er."ball_id"
                      AND bb."innings_no" = er."innings_no"
                GROUP  BY bb."match_id", bb."innings_no", bb."over_id"
             ) AS mo
       JOIN   "ball_by_ball" AS bb
              ON  mo."match_id"   = bb."match_id"
              AND mo."innings_no" = bb."innings_no"
              AND mo."over_id"    = bb."over_id"
       WHERE  mo."rnk" = 1
       GROUP  BY mo."match_id", mo."innings_no", mo."over_id", mo."runs_in_over"
     ) AS ho
LEFT JOIN "player" AS p
       ON ho."bowler_id" = p."player_id"
LIMIT 20;
```

```sql
--Description: FINAL – Calculate the average of those highest-scoring overs across all matches
SELECT DISTINCT
       AVG(ho."runs_in_over") AS "avg_highest_over_runs"
FROM (
       -- highest over per match+innings with runs_in_over
       SELECT
              mo."match_id",
              mo."innings_no",
              mo."over_id",
              mo."runs_in_over"
       FROM (
              SELECT
                     bb."match_id",
                     bb."innings_no",
                     bb."over_id",
                     SUM( COALESCE(bs."runs_scored",0) 
                        + COALESCE(er."extra_runs",0) ) AS "runs_in_over",
                     RANK() OVER (PARTITION BY bb."match_id", bb."innings_no"
                                  ORDER BY SUM( COALESCE(bs."runs_scored",0) 
                                              + COALESCE(er."extra_runs",0) ) DESC) AS "rnk"
              FROM   "ball_by_ball"  AS bb
              LEFT JOIN "batsman_scored" AS bs
                     ON bb."match_id" = bs."match_id"
                    AND bb."over_id"  = bs."over_id"
                    AND bb."ball_id"  = bs."ball_id"
                    AND bb."innings_no" = bs."innings_no"
              LEFT JOIN "extra_runs" AS er
                     ON bb."match_id" = er."match_id"
                    AND bb."over_id"  = er."over_id"
                    AND bb."ball_id"  = er."ball_id"
                    AND bb."innings_no" = er."innings_no"
              GROUP  BY bb."match_id", bb."innings_no", bb."over_id"
           ) AS mo
       WHERE mo."rnk" = 1
     ) AS ho;
```
