Query:
--Description: Attach the bowler (first ball of that over) to every highest-scoring over
SELECT DISTINCT
       mo."match_id",
       mo."innings_no",
       mo."over_id",
       mo."runs_in_over",
       MIN(bb."bowler") AS "bowler_id"
FROM   (
        -- same derived table as previous step
        SELECT
               bb."match_id",
               bb."innings_no",
               bb."over_id",
               SUM( COALESCE(bs."runs_scored",0) 
                  + COALESCE(er."extra_runs",0) ) AS "runs_in_over",
               RANK() OVER (PARTITION BY bb."match_id", bb."innings_no"
                            ORDER BY SUM( COALESCE(bs."runs_scored",0) 
                                        + COALESCE(er."extra_runs",0) ) DESC) AS "rnk"
        FROM   "ball_by_ball"  AS bb
        LEFT JOIN "batsman_scored" AS bs
               ON bb."match_id" = bs."match_id"
              AND bb."over_id"  = bs."over_id"
              AND bb."ball_id"  = bs."ball_id"
              AND bb."innings_no" = bs."innings_no"
        LEFT JOIN "extra_runs" AS er
               ON bb."match_id" = er."match_id"
              AND bb."over_id"  = er."over_id"
              AND bb."ball_id"  = er."ball_id"
              AND bb."innings_no" = er."innings_no"
        GROUP  BY bb."match_id", bb."innings_no", bb."over_id"
      ) AS mo
JOIN   "ball_by_ball" AS bb
       ON  mo."match_id"   = bb."match_id"
       AND mo."innings_no" = bb."innings_no"
       AND mo."over_id"    = bb."over_id"
WHERE  mo."rnk" = 1
GROUP  BY mo."match_id", mo."innings_no", mo."over_id", mo."runs_in_over"
LIMIT  20;
