```sql
--Description: Show batsman-only runs per over (both innings) for sample match 335987
SELECT "match_id",
       "innings_no",
       "over_id",
       SUM("runs_scored") AS "bat_runs"
FROM   "batsman_scored"
WHERE  "match_id" = 335987
GROUP  BY "match_id","innings_no","over_id"
LIMIT 20;
```

```sql
--Description: Show extra runs per over (both innings) for the same sample match 335987
SELECT "match_id",
       "innings_no",
       "over_id",
       SUM("extra_runs") AS "ext_runs"
FROM   "extra_runs"
WHERE  "match_id" = 335987
GROUP  BY "match_id","innings_no","over_id"
LIMIT 20;
```

```sql
--Description: Combine batsman and extra runs to get TOTAL runs per over for match 335987
WITH bats AS (
    SELECT "match_id","innings_no","over_id", SUM("runs_scored") AS "runs"
    FROM   "batsman_scored"
    WHERE  "match_id" = 335987
    GROUP  BY "match_id","innings_no","over_id"
), ex AS (
    SELECT "match_id","innings_no","over_id", SUM("extra_runs") AS "runs"
    FROM   "extra_runs"
    WHERE  "match_id" = 335987
    GROUP  BY "match_id","innings_no","over_id"
), combined AS (
    SELECT * FROM bats
    UNION ALL
    SELECT * FROM ex
)
SELECT "match_id",
       "innings_no",
       "over_id",
       SUM("runs") AS "total_runs"
FROM   combined
GROUP  BY "match_id","innings_no","over_id"
ORDER  BY "total_runs" DESC
LIMIT 20;
```

```sql
--Description: Calculate TOTAL runs per over for every match & innings in the whole dataset
WITH combined AS (
    SELECT "match_id","innings_no","over_id", SUM("runs_scored") AS "runs"
    FROM   "batsman_scored"
    GROUP  BY "match_id","innings_no","over_id"
    UNION ALL
    SELECT "match_id","innings_no","over_id", SUM("extra_runs") AS "runs"
    FROM   "extra_runs"
    GROUP  BY "match_id","innings_no","over_id"
)
SELECT "match_id",
       "innings_no",
       "over_id",
       SUM("runs") AS "total_runs"
FROM   combined
GROUP  BY "match_id","innings_no","over_id"
LIMIT 20;
```

```sql
--Description: Pick, for each match, the (one or more) over(s) that produced the HIGHEST total runs
WITH combined AS (
    SELECT "match_id","innings_no","over_id", SUM("runs_scored") AS "runs"
    FROM   "batsman_scored"
    GROUP  BY "match_id","innings_no","over_id"
    UNION ALL
    SELECT "match_id","innings_no","over_id", SUM("extra_runs") AS "runs"
    FROM   "extra_runs"
    GROUP  BY "match_id","innings_no","over_id"
), over_tot AS (
    SELECT "match_id","innings_no","over_id", SUM("runs") AS "total_runs"
    FROM   combined
    GROUP  BY "match_id","innings_no","over_id"
), max_run AS (
    SELECT "match_id", MAX("total_runs") AS "max_runs"
    FROM   over_tot
    GROUP  BY "match_id"
)
SELECT ot.*
FROM   over_tot ot
JOIN   max_run mr
       ON  ot."match_id"   = mr."match_id"
       AND ot."total_runs" = mr."max_runs"
LIMIT 20;
```

```sql
--Description: Attach the bowler who delivered each highest-scoring over (may return multiple rows if tied)
WITH combined AS (
    SELECT "match_id","innings_no","over_id", SUM("runs_scored") AS "runs"
    FROM   "batsman_scored"
    GROUP  BY "match_id","innings_no","over_id"
    UNION ALL
    SELECT "match_id","innings_no","over_id", SUM("extra_runs") AS "runs"
    FROM   "extra_runs"
    GROUP  BY "match_id","innings_no","over_id"
), over_tot AS (
    SELECT "match_id","innings_no","over_id", SUM("runs") AS "total_runs"
    FROM   combined
    GROUP  BY "match_id","innings_no","over_id"
), max_run AS (
    SELECT "match_id", MAX("total_runs") AS "max_runs"
    FROM   over_tot
    GROUP  BY "match_id"
), top_over AS (
    SELECT ot.*
    FROM   over_tot ot
    JOIN   max_run mr
           ON  ot."match_id"   = mr."match_id"
           AND ot."total_runs" = mr."max_runs"
)
SELECT DISTINCT tover."match_id",
                tover."innings_no",
                tover."over_id",
                tover."total_runs",
                bb."bowler"
FROM   top_over     AS tover
JOIN   "ball_by_ball" AS bb
       ON  bb."match_id"  = tover."match_id"
       AND bb."innings_no"= tover."innings_no"
       AND bb."over_id"   = tover."over_id"
LIMIT 20;
```

```sql
--Description: Compute the AVERAGE of these highest-scoring over totals across all matches
WITH combined AS (
    SELECT "match_id","innings_no","over_id", SUM("runs_scored") AS "runs"
    FROM   "batsman_scored"
    GROUP  BY "match_id","innings_no","over_id"
    UNION ALL
    SELECT "match_id","innings_no","over_id", SUM("extra_runs") AS "runs"
    FROM   "extra_runs"
    GROUP  BY "match_id","innings_no","over_id"
), over_tot AS (
    SELECT "match_id","innings_no","over_id", SUM("runs") AS "total_runs"
    FROM   combined
    GROUP  BY "match_id","innings_no","over_id"
), max_run AS (
    SELECT "match_id", MAX("total_runs") AS "max_runs"
    FROM   over_tot
    GROUP  BY "match_id"
)
SELECT AVG("max_runs") AS "average_highest_over_runs"
FROM   max_run;
```

```sql
--Description: Simple “histogram” – bucket the highest over totals per match in ranges of 5 runs
WITH combined AS (
    SELECT "match_id","innings_no","over_id", SUM("runs_scored") AS "runs"
    FROM   "batsman_scored"
    GROUP  BY "match_id","innings_no","over_id"
    UNION ALL
    SELECT "match_id","innings_no","over_id", SUM("extra_runs") AS "runs"
    FROM   "extra_runs"
    GROUP  BY "match_id","innings_no","over_id"
), over_tot AS (
    SELECT "match_id","innings_no","over_id", SUM("runs") AS "total_runs"
    FROM   combined
    GROUP  BY "match_id","innings_no","over_id"
), max_run AS (
    SELECT "match_id", MAX("total_runs") AS "max_runs"
    FROM   over_tot
    GROUP  BY "match_id"
)
SELECT (("max_runs"/5)*5) AS "bucket_start",
       COUNT(*)           AS "matches"
FROM   max_run
GROUP  BY "bucket_start"
ORDER  BY "bucket_start"
LIMIT 20;
```
