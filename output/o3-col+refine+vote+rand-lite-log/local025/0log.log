      FROM   "over_totals" AS o
      JOIN (
            SELECT "match_id",
                   MAX("total_runs") AS "max_runs"
            FROM   "over_totals"
            GROUP  BY "match_id"
      ) AS m
      ON  o."match_id"   = m."match_id"
      AND o."total_runs" = m."max_runs"
)
SELECT DISTINCT mo."match_id",
                mo."over_id",
                mo."total_runs",
                bb."bowler"
FROM   "max_over"     AS mo
JOIN   "ball_by_ball" AS bb
  ON   mo."match_id"  = bb."match_id"
 AND  mo."innings_no" = bb."innings_no"
 AND  mo."over_id"    = bb."over_id"
LIMIT 20;
