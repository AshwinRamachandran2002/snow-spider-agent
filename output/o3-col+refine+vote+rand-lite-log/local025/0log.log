```sql
-- 1) Inspect a few matches to understand match identifiers and dates
SELECT DISTINCT "match_id",
                "team_1",
                "team_2",
                "match_date"
FROM   "match"
LIMIT 20;
```

```sql
-- 2) Look at some deliveries in the batsman_scored table
SELECT DISTINCT "match_id",
                "innings_no",
                "over_id",
                "ball_id",
                "runs_scored"
FROM   "batsman_scored"
LIMIT 20;
```

```sql
-- 3) Look at some deliveries in the extra_runs table
SELECT DISTINCT "match_id",
                "innings_no",
                "over_id",
                "ball_id",
                "extra_type",
                "extra_runs"
FROM   "extra_runs"
LIMIT 20;
```

```sql
-- 4) Aggregate batsman-runs per (match, innings, over)
SELECT DISTINCT "match_id",
                "innings_no",
                "over_id",
                SUM("runs_scored") AS "batsman_runs"
FROM   "batsman_scored"
GROUP  BY "match_id", "innings_no", "over_id"
LIMIT 20;
```

```sql
-- 5) Aggregate extra-runs per (match, innings, over)
SELECT DISTINCT "match_id",
                "innings_no",
                "over_id",
                SUM("extra_runs") AS "extra_runs"
FROM   "extra_runs"
GROUP  BY "match_id", "innings_no", "over_id"
LIMIT 20;
```

```sql
-- 6) Combine batsman and extra runs to get total runs per over
WITH "br" AS (
      SELECT "match_id", "innings_no", "over_id",
             SUM("runs_scored") AS "runs"
      FROM   "batsman_scored"
      GROUP  BY "match_id", "innings_no", "over_id"
), "er" AS (
      SELECT "match_id", "innings_no", "over_id",
             SUM("extra_runs") AS "runs"
      FROM   "extra_runs"
      GROUP  BY "match_id", "innings_no", "over_id"
), "unioned" AS (
      SELECT * FROM "br"
      UNION ALL
      SELECT * FROM "er"
)
SELECT DISTINCT "match_id",
                "innings_no",
                "over_id",
                SUM("runs") AS "total_runs"
FROM   "unioned"
GROUP  BY "match_id", "innings_no", "over_id"
LIMIT 20;
```

```sql
-- 7) Attach the bowler for every (match, innings, over)
SELECT DISTINCT ob."match_id",
                ob."innings_no",
                ob."over_id",
                ob."total_runs",
                bb."bowler"
FROM (
      /* over-by-over totals constructed the same way as step-6 */
      WITH "br" AS (
            SELECT "match_id", "innings_no", "over_id",
                   SUM("runs_scored") AS "runs"
            FROM   "batsman_scored"
            GROUP  BY "match_id", "innings_no", "over_id"
      ), "er" AS (
            SELECT "match_id", "innings_no", "over_id",
                   SUM("extra_runs") AS "runs"
            FROM   "extra_runs"
            GROUP  BY "match_id", "innings_no", "over_id"
      ), "u" AS (
            SELECT * FROM "br"
            UNION ALL
            SELECT * FROM "er"
      )
      SELECT "match_id", "innings_no", "over_id",
             SUM("runs") AS "total_runs"
      FROM   "u"
      GROUP  BY "match_id", "innings_no", "over_id"
) AS ob
JOIN  "ball_by_ball" AS bb
  ON  ob."match_id"   = bb."match_id"
 AND ob."innings_no"  = bb."innings_no"
 AND ob."over_id"     = bb."over_id"
LIMIT 20;
```

```sql
-- 8) Pick the highest-scoring over of every match (ties keep all such overs)
WITH "over_totals" AS (
      /* same construction as step-6 */
      WITH "br" AS (
            SELECT "match_id", "innings_no", "over_id",
                   SUM("runs_scored") AS "runs"
            FROM   "batsman_scored"
            GROUP  BY "match_id", "innings_no", "over_id"
      ), "er" AS (
            SELECT "match_id", "innings_no", "over_id",
                   SUM("extra_runs") AS "runs"
            FROM   "extra_runs"
            GROUP  BY "match_id", "innings_no", "over_id"
      ), "u" AS (
            SELECT * FROM "br"
            UNION ALL
            SELECT * FROM "er"
      )
      SELECT "match_id", "innings_no", "over_id",
             SUM("runs") AS "total_runs"
      FROM   "u"
      GROUP  BY "match_id", "innings_no", "over_id"
), "max_per_match" AS (
      SELECT "match_id",
             MAX("total_runs") AS "max_runs"
      FROM   "over_totals"
      GROUP  BY "match_id"
)
SELECT DISTINCT o."match_id",
                o."innings_no",
                o."over_id",
                o."total_runs"
FROM   "over_totals" AS o
JOIN   "max_per_match" AS m
  ON   o."match_id"   = m."match_id"
 AND   o."total_runs" = m."max_runs"
LIMIT 20;
```

```sql
-- 9) Highest-scoring over of each match WITH the bowler
WITH "over_totals" AS (
      WITH "br" AS (
            SELECT "match_id", "innings_no", "over_id",
                   SUM("runs_scored") AS "runs"
            FROM   "batsman_scored"
            GROUP  BY "match_id", "innings_no", "over_id"
      ), "er" AS (
            SELECT "match_id", "innings_no", "over_id",
                   SUM("extra_runs") AS "runs"
            FROM   "extra_runs"
            GROUP  BY "match_id", "innings_no", "over_id"
      ), "u" AS (
            SELECT * FROM "br"
            UNION ALL
            SELECT * FROM "er"
      )
      SELECT "match_id", "innings_no", "over_id",
             SUM("runs") AS "total_runs"
      FROM   "u"
      GROUP  BY "match_id", "innings_no", "over_id"
), "max_over" AS (
      SELECT o."match_id",
             o."innings_no",
             o."over_id",
             o."total_runs"
      FROM   "over_totals" AS o
      JOIN (
            SELECT "match_id",
                   MAX("total_runs") AS "max_runs"
            FROM   "over_totals"
            GROUP  BY "match_id"
      ) AS m
      ON  o."match_id"   = m."match_id"
      AND o."total_runs" = m."max_runs"
)
SELECT DISTINCT mo."match_id",
                mo."over_id",
                mo."total_runs",
                bb."bowler"
FROM   "max_over"     AS mo
JOIN   "ball_by_ball" AS bb
  ON   mo."match_id"  = bb."match_id"
 AND  mo."innings_no" = bb."innings_no"
 AND  mo."over_id"    = bb."over_id"
LIMIT 20;
```

```sql
-- 10) Compute the average of these highest-over totals across ALL matches
WITH "over_totals" AS (
      WITH "br" AS (
            SELECT "match_id", "innings_no", "over_id",
                   SUM("runs_scored") AS "runs"
            FROM   "batsman_scored"
            GROUP  BY "match_id", "innings_no", "over_id"
      ), "er" AS (
            SELECT "match_id", "innings_no", "over_id",
                   SUM("extra_runs") AS "runs"
            FROM   "extra_runs"
            GROUP  BY "match_id", "innings_no", "over_id"
      ), "u" AS (
            SELECT * FROM "br"
            UNION ALL
            SELECT * FROM "er"
      )
      SELECT "match_id", "innings_no", "over_id",
             SUM("runs") AS "total_runs"
      FROM   "u"
      GROUP  BY "match_id", "innings_no", "over_id"
), "max_over" AS (
      SELECT o."match_id",
             MAX(o."total_runs") AS "max_runs"
      FROM   "over_totals" AS o
      GROUP  BY o."match_id"
)
SELECT AVG("max_runs") AS "average_highest_over_runs"
FROM   "max_over"
LIMIT 20;
```
