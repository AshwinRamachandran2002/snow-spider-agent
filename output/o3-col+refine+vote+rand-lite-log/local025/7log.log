```sql
--Description: Retrieve bowler (take first ball’s bowler) for every over / innings in a sample match
SELECT  bb."match_id",
        bb."innings_no",
        bb."over_id",
        MIN(bb."ball_id") AS "first_ball",
        (SELECT  "bowler"
         FROM    "ball_by_ball" AS bb2
         WHERE   bb2."match_id"   = bb."match_id"
           AND   bb2."innings_no" = bb."innings_no"
           AND   bb2."over_id"    = bb."over_id"
         ORDER BY bb2."ball_id"
         LIMIT 1) AS "bowler"
FROM   "ball_by_ball" AS bb
WHERE  bb."match_id" = 335987
GROUP  BY bb."match_id",bb."innings_no",bb."over_id"
LIMIT 20;
```

```sql
--Description: For every match & innings, find the over with the highest combined runs and attach its bowler
SELECT  t."match_id",
        t."innings_no",
        t."over_id",
        t."total_runs",
        b."bowler"
FROM   (
        SELECT  c."match_id",
                c."innings_no",
                c."over_id",
                c."total_runs",
                RANK() OVER (PARTITION BY c."match_id",c."innings_no"
                             ORDER BY c."total_runs" DESC, c."over_id") AS rk
        FROM   (
                /* combine batsman + extras for ALL matches */
                SELECT  COALESCE(bs."match_id",er."match_id")        AS "match_id",
                        COALESCE(bs."innings_no",er."innings_no")    AS "innings_no",
                        COALESCE(bs."over_id",er."over_id")          AS "over_id",
                        COALESCE(bs."bat_runs",0) + COALESCE(er."extra_runs",0) AS "total_runs"
                FROM  (SELECT "match_id","innings_no","over_id",
                              SUM("runs_scored") AS "bat_runs"
                       FROM   "batsman_scored"
                       GROUP  BY "match_id","innings_no","over_id")  AS bs
                FULL OUTER JOIN
                      (SELECT "match_id","innings_no","over_id",
                              SUM("extra_runs")  AS "extra_runs"
                       FROM   "extra_runs"
                       GROUP  BY "match_id","innings_no","over_id")  AS er
                ON    bs."match_id"   = er."match_id"
               AND    bs."innings_no" = er."innings_no"
               AND    bs."over_id"    = er."over_id"
        ) AS c
) AS t
JOIN  (
        /* fetch bowler of first ball for every over */
        SELECT  "match_id","innings_no","over_id",
                (SELECT "bowler"
                 FROM   "ball_by_ball" AS x
                 WHERE  x."match_id"   = bb."match_id"
                   AND  x."innings_no" = bb."innings_no"
                   AND  x."over_id"    = bb."over_id"
                 ORDER BY x."ball_id"
                 LIMIT 1) AS "bowler"
        FROM   "ball_by_ball" AS bb
        GROUP  BY "match_id","innings_no","over_id"
) AS b
ON  t."match_id"   = b."match_id"
AND t."innings_no" = b."innings_no"
AND t."over_id"    = b."over_id"
WHERE  t.rk = 1                      -- highest scoring over in that innings
LIMIT 20;
```

```sql
--Description: Compute the average of the highest-scoring over totals across all matches
SELECT  AVG("total_runs") AS "avg_highest_over_runs"
FROM   (
        SELECT DISTINCT "match_id","innings_no",     -- take one top over per innings
               FIRST_VALUE("total_runs") OVER w AS "total_runs"
        FROM   (
                /* reuse result set that already has rk (query 8) */
                SELECT  c."match_id",
                        c."innings_no",
                        c."total_runs",
                        RANK() OVER (PARTITION BY c."match_id",c."innings_no"
                                     ORDER BY c."total_runs" DESC, c."over_id") AS rk
                FROM (
                     /* combined runs subquery identical to query 8 */
                     SELECT  COALESCE(bs."match_id",er."match_id")        AS "match_id",
                             COALESCE(bs."innings_no",er."innings_no")    AS "innings_no",
                             COALESCE(bs."over_id",er."over_id")          AS "over_id",
                             COALESCE(bs."bat_runs",0)+COALESCE(er."extra_runs",0) AS "total_runs"
                     FROM  (SELECT "match_id","innings_no","over_id",
                                   SUM("runs_scored") AS "bat_runs"
                            FROM   "batsman_scored"
                            GROUP  BY "match_id","innings_no","over_id") AS bs
                     FULL OUTER JOIN
                           (SELECT "match_id","innings_no","over_id",
                                   SUM("extra_runs")  AS "extra_runs"
                            FROM   "extra_runs"
                            GROUP  BY "match_id","innings_no","over_id") AS er
                     ON   bs."match_id"   = er."match_id"
                    AND   bs."innings_no" = er."innings_no"
                    AND   bs."over_id"    = er."over_id"
                ) AS c
        ) AS z
        WINDOW w AS (PARTITION BY "match_id","innings_no" ORDER BY "rk")
        WHERE  z.rk = 1
) AS q;
```

```sql
--Description: Show the bowler associated with each of those highest-scoring overs (complete answer set)
SELECT  t."match_id",
        t."innings_no",
        t."over_id",
        t."total_runs",
        p."player_name"          AS "bowler_name",
        tm."name"                AS "bowler_team"
FROM   (
        /* highest-scoring overs with bowler (same as query 8 but without LIMIT) */
        SELECT  t."match_id",
                t."innings_no",
                t."over_id",
                t."total_runs",
                b."bowler"
        FROM   (
                SELECT  c."match_id",
                        c."innings_no",
                        c."over_id",
                        c."total_runs",
                        RANK() OVER (PARTITION BY c."match_id",c."innings_no"
                                     ORDER BY c."total_runs" DESC, c."over_id") AS rk
                FROM   (
                        SELECT  COALESCE(bs."match_id",er."match_id")        AS "match_id",
                                COALESCE(bs."innings_no",er."innings_no")    AS "innings_no",
                                COALESCE(bs."over_id",er."over_id")          AS "over_id",
                                COALESCE(bs."bat_runs",0) + COALESCE(er."extra_runs",0) AS "total_runs"
                        FROM  (SELECT "match_id","innings_no","over_id",
                                      SUM("runs_scored") AS "bat_runs"
                               FROM   "batsman_scored"
                               GROUP  BY "match_id","innings_no","over_id") AS bs
                        FULL OUTER JOIN
                              (SELECT "match_id","innings_no","over_id",
                                      SUM("extra_runs")  AS "extra_runs"
                               FROM   "extra_runs"
                               GROUP  BY "match_id","innings_no","over_id") AS er
                        ON   bs."match_id"   = er."match_id"
                       AND   bs."innings_no" = er."innings_no"
                       AND   bs."over_id"    = er."over_id"
                ) AS c
        ) AS t
        JOIN (
                SELECT  "match_id","innings_no","over_id",
                        (SELECT "bowler"
                         FROM   "ball_by_ball" AS x
                         WHERE  x."match_id"   = bb."match_id"
                           AND  x."innings_no" = bb."innings_no"
                           AND  x."over_id"    = bb."over_id"
                         ORDER BY x."ball_id"
                         LIMIT 1) AS "bowler"
                FROM   "ball_by_ball" AS bb
                GROUP  BY "match_id","innings_no","over_id"
        ) AS b
        ON  t."match_id"   = b."match_id"
        AND t."innings_no" = b."innings_no"
        AND t."over_id"    = b."over_id"
        WHERE  t.rk = 1
) AS t
LEFT JOIN "player" AS p
       ON p."player_id" = t."bowler"
LEFT JOIN "team"   AS tm
       ON tm."team_id" = (SELECT DISTINCT "team_bowling"
                          FROM "ball_by_ball" bb
                          WHERE bb."match_id"   = t."match_id"
                            AND bb."innings_no" = t."innings_no"
                            AND bb."over_id"    = t."over_id"
                          LIMIT 1)
LIMIT 20;
