```sql
--Description: Combine batsman runs + extra runs to get total runs in each over / innings (sample match)
SELECT  b."match_id",
        b."innings_no",
        b."over_id",
        b."bat_runs" + COALESCE(e."extra_runs",0) AS "total_runs"
FROM   (SELECT "match_id","innings_no","over_id",
               SUM("runs_scored") AS "bat_runs"
        FROM   "batsman_scored"
        WHERE  "match_id" = 335987
        GROUP  BY "match_id","innings_no","over_id") AS b
LEFT   JOIN (SELECT "match_id","innings_no","over_id",
                    SUM("extra_runs") AS "extra_runs"
             FROM   "extra_runs"
             WHERE  "match_id" = 335987
             GROUP  BY "match_id","innings_no","over_id") AS e
ON     b."match_id"  = e."match_id"
AND    b."innings_no"= e."innings_no"
AND    b."over_id"   = e."over_id"
ORDER  BY "total_runs" DESC
LIMIT 20;
