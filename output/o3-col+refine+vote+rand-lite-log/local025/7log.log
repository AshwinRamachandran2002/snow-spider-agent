```sql
--Description:
-- Goal: For each match look across every innings, find the single over that
--       produced the most runs (batsman + extras), fetch the bowler who bowled
--       the first ball of that over, and calculate the average of these
--       highest-over totals across all matches.
-- Strategy (inside CTEs):
--   1. over_runs        – total runs in every (match, innings, over) by UNION-ing
--                         batsman_scored and extra_runs and summing.
--   2. best_over_match  – RANK() to keep just the top-scoring over *per match*
--                         (ties → lower innings_no then lower over_id).
--   3. over_bowler      – bowler of the first ball of each over from ball_by_ball.
--   4. avg_totals       – the overall average of those match-level best totals.
--   5. Final SELECT     – list each match’s best over with its bowler and also
--                         show the computed average (same value repeated for
--                         convenience; could be selected separately if desired).
WITH over_runs AS (             /* total runs per (match,innings,over) */
    SELECT match_id,
           innings_no,
           over_id,
           SUM(runs) AS total_runs
    FROM (
        SELECT match_id,
               innings_no,
               over_id,
               SUM(runs_scored) AS runs
        FROM batsman_scored
        GROUP BY match_id, innings_no, over_id
        UNION ALL
        SELECT match_id,
               innings_no,
               over_id,
               SUM(extra_runs) AS runs
        FROM extra_runs
        GROUP BY match_id, innings_no, over_id
    )
    GROUP BY match_id, innings_no, over_id
),
best_over_match AS (            /* one best over per match */
    SELECT  match_id,
            innings_no,
            over_id,
            total_runs,
            RANK() OVER (PARTITION BY match_id
                         ORDER BY total_runs DESC,
                                  innings_no,
                                  over_id) AS rk
    FROM    over_runs
),
over_bowler AS (                /* bowler of first ball in each over */
    SELECT  bb.match_id,
            bb.innings_no,
            bb.over_id,
            (SELECT bowler
             FROM   ball_by_ball x
             WHERE  x.match_id   = bb.match_id
               AND  x.innings_no = bb.innings_no
               AND  x.over_id    = bb.over_id
             ORDER BY x.ball_id
             LIMIT 1) AS bowler
    FROM ball_by_ball bb
    GROUP BY bb.match_id, bb.innings_no, bb.over_id
),
avg_totals AS (                 /* average of best-over totals across matches */
    SELECT AVG(total_runs) AS avg_best_over_runs
    FROM   best_over_match
    WHERE  rk = 1
)
SELECT  bm.match_id,
        bm.innings_no,
        bm.over_id,
        bm.total_runs,
        ob.bowler,
        at.avg_best_over_runs       /* same value on every row; scalar result */
FROM    best_over_match bm
JOIN    over_bowler   ob ON  bm.match_id   = ob.match_id
                         AND bm.innings_no = ob.innings_no
                         AND bm.over_id    = ob.over_id
CROSS JOIN avg_totals  at
WHERE   bm.rk = 1
LIMIT 20;
