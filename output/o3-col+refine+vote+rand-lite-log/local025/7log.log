Query:
--Description: 
-- Compute the average of the highest-scoring over totals across ALL matches
-- (take one best over per match & innings, i.e. per innings) without using
-- FULL OUTER JOIN – instead UNION batsman & extras and re-aggregate.
WITH over_runs AS (                /* total runs for every (match,innings,over) */
      SELECT match_id,
             innings_no,
             over_id,
             SUM(runs) AS total_runs
      FROM (
            SELECT match_id,
                   innings_no,
                   over_id,
                   SUM(runs_scored) AS runs
            FROM   batsman_scored
            GROUP  BY match_id, innings_no, over_id
            UNION ALL
            SELECT match_id,
                   innings_no,
                   over_id,
                   SUM(extra_runs) AS runs
            FROM   extra_runs
            GROUP  BY match_id, innings_no, over_id
      )
      GROUP BY match_id, innings_no, over_id
),
best_over_innings AS (             /* best over in every match & innings */
      SELECT  match_id,
              innings_no,
              over_id,
              total_runs,
              RANK() OVER (PARTITION BY match_id, innings_no
                           ORDER BY total_runs DESC, over_id) AS rk
      FROM    over_runs
)
SELECT AVG(total_runs) AS avg_highest_over_runs
FROM   best_over_innings
WHERE  rk = 1
