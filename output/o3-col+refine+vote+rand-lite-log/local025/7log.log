Query:
--Description: 
-- List every highest-scoring over (per match & innings) together with the bowler
-- who delivered its first ball; avoid FULL OUTER JOIN by using UNION-based
-- aggregation in over_runs.  Limit 20 rows for inspection.
WITH over_runs AS (                /* total runs for every (match,innings,over) */
      SELECT match_id,
             innings_no,
             over_id,
             SUM(runs) AS total_runs
      FROM (
            SELECT match_id,
                   innings_no,
                   over_id,
                   SUM(runs_scored) AS runs
            FROM   batsman_scored
            GROUP  BY match_id, innings_no, over_id
            UNION ALL
            SELECT match_id,
                   innings_no,
                   over_id,
                   SUM(extra_runs) AS runs
            FROM   extra_runs
            GROUP  BY match_id, innings_no, over_id
      )
      GROUP BY match_id, innings_no, over_id
),
best_over AS (                     /* best over per match & innings */
      SELECT  match_id,
              innings_no,
              over_id,
              total_runs,
              RANK() OVER (PARTITION BY match_id, innings_no
                           ORDER BY total_runs DESC, over_id) AS rk
      FROM    over_runs
),
over_bowler AS (                   /* bowler of first ball in each over */
      SELECT  bb.match_id,
              bb.innings_no,
              bb.over_id,
              (SELECT bowler
               FROM   ball_by_ball x
               WHERE  x.match_id   = bb.match_id
                 AND  x.innings_no = bb.innings_no
                 AND  x.over_id    = bb.over_id
               ORDER BY x.ball_id
               LIMIT 1) AS bowler
      FROM ball_by_ball bb
      GROUP BY bb.match_id, bb.innings_no, bb.over_id
)
SELECT  bo.match_id,
        bo.innings_no,
        bo.over_id,
        bo.total_runs,
        p.player_name AS bowler_name,
        tm.name       AS bowler_team
FROM    best_over bo
JOIN    over_bowler ob ON  bo.match_id   = ob.match_id
                      AND bo.innings_no = ob.innings_no
                      AND bo.over_id    = ob.over_id
LEFT JOIN player p ON p.player_id = ob.bowler
LEFT JOIN team   tm ON tm.team_id = (
                    SELECT DISTINCT team_bowling
                    FROM   ball_by_ball bb
                    WHERE  bb.match_id   = bo.match_id
                      AND  bb.innings_no = bo.innings_no
                      AND  bb.over_id    = bo.over_id
                    LIMIT 1)
WHERE   bo.rk = 1
LIMIT 20
