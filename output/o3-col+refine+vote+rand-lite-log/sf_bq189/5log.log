```sql
--Description: Count distinct order IDs per category for each month (sample 20 rows)
SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
       pr."category",
       COUNT(DISTINCT oi."order_id")                              AS "unique_orders"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     pr
  ON pr."id" = oi."product_id"
WHERE oi."status" = 'Complete'
GROUP BY 1, 2
ORDER BY 1 DESC, 2
LIMIT 20;
```

```sql
--Description: Compute month-over-month percentage growth in unique orders for every category (sample)
WITH monthly AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
         pr."category",
         COUNT(DISTINCT oi."order_id")                              AS "unique_orders"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     pr
    ON pr."id" = oi."product_id"
  WHERE oi."status" = 'Complete'
  GROUP BY 1, 2
)
SELECT "order_month",
       "category",
       "unique_orders",
       LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "order_month") AS "prev_month_orders",
       (("unique_orders" - LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "order_month"))
        / NULLIF(LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "order_month"),0)) * 100
        AS "pct_growth"
FROM monthly
ORDER BY "category", "order_month"
LIMIT 20;
```

```sql
--Description: Average monthly order growth rate for each category
WITH monthly AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
         pr."category",
         COUNT(DISTINCT oi."order_id") AS "unique_orders"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     pr
    ON pr."id" = oi."product_id"
  WHERE oi."status" = 'Complete'
  GROUP BY 1, 2
),
growth AS (
  SELECT "category",
         (("unique_orders" - LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "order_month"))
          / NULLIF(LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "order_month"),0)) * 100
          AS "pct_growth"
  FROM monthly
)
SELECT "category",
       AVG("pct_growth") AS "avg_monthly_order_growth_pct"
FROM growth
GROUP BY "category"
ORDER BY "avg_monthly_order_growth_pct" DESC
LIMIT 20;
```

```sql
--Description: Identify the single category with the highest average monthly order growth
WITH monthly AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
         pr."category",
         COUNT(DISTINCT oi."order_id") AS "unique_orders"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     pr
    ON pr."id" = oi."product_id"
  WHERE oi."status" = 'Complete'
  GROUP BY 1, 2
),
growth AS (
  SELECT "category",
         (("unique_orders" - LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "order_month"))
          / NULLIF(LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "order_month"),0)) * 100
          AS "pct_growth"
  FROM monthly
)
SELECT "category",
       AVG("pct_growth") AS "avg_monthly_order_growth_pct"
FROM growth
GROUP BY "category"
ORDER BY "avg_monthly_order_growth_pct" DESC
LIMIT 1;
```

```sql
--Description: Monthly revenue (sum of “sale_price”) for the top-growth category (replace 'Accessories' if output differs)
WITH top_cat AS (
  /* hard-code the top category name after inspecting previous query result */
  SELECT 'Accessories' AS "category"
),
revenue AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
         pr."category",
         SUM(oi."sale_price") AS "revenue"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     pr
    ON pr."id" = oi."product_id"
  JOIN top_cat tc
    ON pr."category" = tc."category"
  WHERE oi."status" = 'Complete'
  GROUP BY 1, 2
)
SELECT *
FROM revenue
ORDER BY "order_month"
LIMIT 20;
```

```sql
--Description: Compute month-over-month revenue growth & average for that top category
WITH top_cat AS (SELECT 'Accessories' AS "category"),
revenue AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
         SUM(oi."sale_price") AS "revenue"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     pr
    ON pr."id" = oi."product_id"
  JOIN top_cat tc
    ON pr."category" = tc."category"
  WHERE oi."status" = 'Complete'
  GROUP BY 1
),
growth AS (
  SELECT "order_month",
         "revenue",
         LAG("revenue") OVER (ORDER BY "order_month") AS "prev_rev",
         (("revenue" - LAG("revenue") OVER (ORDER BY "order_month"))
          / NULLIF(LAG("revenue") OVER (ORDER BY "order_month"),0)) * 100 AS "pct_growth"
  FROM revenue
)
SELECT "order_month", "revenue", "pct_growth"
FROM growth
ORDER BY "order_month"
LIMIT 20;
```

