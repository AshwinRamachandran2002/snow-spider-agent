```sql
--Description: 
-- THINKING PROCESS (embedded as comments):
-- 1) “monthly_orders”  – distinct order-count per category & calendar month (only ‘Complete’ order_items).
-- 2) “lagged_orders”   – attach previous-month count, compute % growth, then “category_growth” = avg of those growths.
-- 3) Pick the single category with the highest average order-growth   →  CTE “top_cat”.
-- 4) For that winning category build “monthly_revenue”, “lagged_revenue”, take the avg of month-over-month
--    revenue growths in “revenue_growth”.
-- 5) Final SELECT returns the category, its average monthly order-growth, and its average monthly revenue-growth.

WITH monthly_orders AS (          -- Step-1
    SELECT
        p."category",
        DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))::DATE  AS "order_month",
        COUNT(DISTINCT oi."order_id")                                    AS "order_cnt"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
          ON p."id" = oi."product_id"
    WHERE oi."status" = 'Complete'
    GROUP BY p."category",
             DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))::DATE
),
lagged_orders AS (                -- Step-2
    SELECT
        "category",
        "order_month",
        "order_cnt"                                                     AS "curr_cnt",
        LAG("order_cnt") OVER (PARTITION BY "category"
                               ORDER BY "order_month")                  AS "prev_cnt"
    FROM monthly_orders
),
category_growth AS (
    SELECT
        "category",
        ROUND(AVG( ( "curr_cnt" - "prev_cnt") / NULLIF("prev_cnt",0)::FLOAT ),4)  AS "avg_order_growth"
    FROM lagged_orders
    WHERE "prev_cnt" IS NOT NULL AND "prev_cnt" <> 0
    GROUP BY "category"
),
top_cat AS (                      -- Step-3
    SELECT *
    FROM   category_growth
    ORDER  BY "avg_order_growth" DESC
    LIMIT  1
),
monthly_revenue AS (              -- Step-4
    SELECT
        p."category",
