Query:
--Description: Identify the single product category that has the highest average month-over-month % growth in
--             distinct-order counts (based only on completed order_items).  
--             Strategy: build monthly order counts → add LAG → derive % growth → average per category →
--             pick the category with the largest average.

WITH monthly_orders AS (   /* monthly distinct-order counts */
    SELECT
        p."category",
        DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))::DATE  AS "order_month",
        COUNT(DISTINCT oi."order_id")                                      AS "order_cnt"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
          ON p."id" = oi."product_id"
    WHERE oi."status" = 'Complete'
    GROUP BY p."category",
             DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))::DATE
),
lagged_orders AS (          /* attach previous-month counts */
    SELECT
        "category",
        "order_month",
        "order_cnt"                                                        AS "curr_cnt",
        LAG("order_cnt") OVER (PARTITION BY "category"
                               ORDER BY "order_month")                     AS "prev_cnt"
    FROM monthly_orders
),
category_growth AS (       /* average % growth per category */
    SELECT
        "category",
        ROUND(
            AVG( ( "curr_cnt" - "prev_cnt") / NULLIF("prev_cnt",0)::FLOAT )
        ,4) AS "avg_monthly_order_growth"
    FROM lagged_orders
    WHERE "prev_cnt" IS NOT NULL AND "prev_cnt" <> 0
    GROUP BY "category"
)
SELECT *
FROM category_growth
ORDER BY "avg_monthly_order_growth" DESC
LIMIT 1
Answer:
category,avg_monthly_order_growth
Clothing Sets,0.3256
Query:
--Description: For the category identified above (selected on-the-fly via the same logic),
--             calculate month-over-month % revenue growth and the average of those growths.
--             Output each month’s revenue & % growth plus the overall average.

WITH category_growth AS (  /* replicate the first query to obtain the winning category */
    WITH monthly_orders AS (
        SELECT
            p."category",
            DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))::DATE  AS "order_month",
            COUNT(DISTINCT oi."order_id")                                      AS "order_cnt"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
        JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
              ON p."id" = oi."product_id"
        WHERE oi."status" = 'Complete'
        GROUP BY p."category",
                 DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))::DATE
    ), lagged AS (
        SELECT
            "category",
            "order_cnt",
            LAG("order_cnt") OVER (PARTITION BY "category" ORDER BY "order_month") AS "prev_cnt"
        FROM monthly_orders
    )
    SELECT
        "category",
        AVG( ( "order_cnt" - "prev_cnt") / NULLIF("prev_cnt",0)::FLOAT ) AS "avg_growth"
    FROM lagged
    WHERE "prev_cnt" IS NOT NULL AND "prev_cnt" <> 0
    GROUP BY "category"
    ORDER BY "avg_growth" DESC
    LIMIT 1
), monthly_revenue AS (      /* revenue per month for the winning category */
    SELECT
        p."category",
        DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))::DATE AS "rev_month",
        SUM(oi."sale_price")                                              AS "revenue"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
          ON p."id" = oi."product_id"
    JOIN category_growth cg
          ON cg."category" = p."category"
    WHERE oi."status" = 'Complete'
    GROUP BY p."category",
             DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))::DATE
),
lagged_revenue AS (          /* attach previous-month revenue & % growth */
    SELECT
        "category",
        "rev_month",
        "revenue"                                                  AS "curr_rev",
        LAG("revenue") OVER (ORDER BY "rev_month")                 AS "prev_rev"
    FROM monthly_revenue
),
revenue_pct AS (
    SELECT
        "category",
        "rev_month",
        "curr_rev",
        ROUND( ( "curr_rev" - "prev_rev") / NULLIF("prev_rev",0)::FLOAT ,4) AS "pct_revenue_growth"
    FROM lagged_revenue
    WHERE "prev_rev" IS NOT NULL AND "prev_rev" <> 0
)
SELECT
    "category",
    "rev_month",
    "curr_rev"              AS "monthly_revenue",
    "pct_revenue_growth",
    ROUND(AVG("pct_revenue_growth") OVER (),4) AS "avg_monthly_revenue_growth_for_category"
FROM revenue_pct
ORDER BY "rev_month"
Answer:
category,rev_month,monthly_revenue,pct_revenue_growth,avg_monthly_revenue_growth_for_category
