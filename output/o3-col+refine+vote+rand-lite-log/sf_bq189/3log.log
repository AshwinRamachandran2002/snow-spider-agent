```sql
--Description: Count distinct order IDs for every (category, month) combination
SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))::DATE AS "month",
       p."category",
       COUNT(DISTINCT oi."order_id")                                      AS "monthly_order_cnt"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
     ON p."id" = oi."product_id"
WHERE oi."status" = 'Complete'
GROUP BY 1, 2
ORDER BY 2, 1
LIMIT 20;
```

```sql
--Description: For each category, calculate the month-over-month % growth in unique order count
SELECT "category",
       "month",
       "monthly_order_cnt",
       LAG("monthly_order_cnt") OVER (PARTITION BY "category" ORDER BY "month") AS "prev_month_cnt",
       ROUND(
         CASE
             WHEN LAG("monthly_order_cnt") OVER (PARTITION BY "category" ORDER BY "month") IS NULL THEN NULL
             ELSE (("monthly_order_cnt" - LAG("monthly_order_cnt") OVER (PARTITION BY "category" ORDER BY "month"))
                   / NULLIF(LAG("monthly_order_cnt") OVER (PARTITION BY "category" ORDER BY "month"),0)::FLOAT)
         END
       ,4) AS "pct_growth"
FROM (
      SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))::DATE AS "month",
             p."category",
             COUNT(DISTINCT oi."order_id")                                      AS "monthly_order_cnt"
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
           ON p."id" = oi."product_id"
      WHERE oi."status" = 'Complete'
      GROUP BY 1, 2
     ) t
ORDER BY "category", "month"
LIMIT 20;
```

```sql
--Description: Compute the average of monthly order-count growth rates for every category
SELECT "category",
       ROUND(AVG("pct_growth"),4) AS "avg_monthly_order_growth"
FROM (
      /* same pct_growth derived earlier */
      SELECT "category",
             "month",
             CASE WHEN "prev_cnt" = 0 OR "prev_cnt" IS NULL THEN NULL
                  ELSE (("curr_cnt" - "prev_cnt") / "prev_cnt"::FLOAT)
             END AS "pct_growth"
      FROM (
            SELECT p."category",
                   DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))::DATE AS "month",
                   COUNT(DISTINCT oi."order_id") AS "curr_cnt",
                   LAG(COUNT(DISTINCT oi."order_id"))
                      OVER (PARTITION BY p."category" ORDER BY DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)))
                      AS "prev_cnt"
            FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
            JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
                 ON p."id" = oi."product_id"
            WHERE oi."status" = 'Complete'
            GROUP BY 1, 2
           ) s
     ) final
GROUP BY "category"
ORDER BY "avg_monthly_order_growth" DESC
LIMIT 20;
```

```sql
--Description: Identify the single product category with the highest average monthly order growth
SELECT "category"
FROM (
      /* reuse previous aggregation */
      SELECT "category",
             ROUND(AVG("pct_growth"),4) AS "avg_monthly_order_growth"
      FROM (
            SELECT "category", "month",
                   CASE WHEN "prev_cnt" = 0 OR "prev_cnt" IS NULL THEN NULL
                        ELSE (("curr_cnt" - "prev_cnt") / "prev_cnt"::FLOAT)
                   END AS "pct_growth"
            FROM (
                  SELECT p."category",
                         DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))::DATE AS "month",
                         COUNT(DISTINCT oi."order_id") AS "curr_cnt",
                         LAG(COUNT(DISTINCT oi."order_id"))
                            OVER (PARTITION BY p."category" ORDER BY DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)))
                            AS "prev_cnt"
                  FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
                  JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
                       ON p."id" = oi."product_id"
                  WHERE oi."status" = 'Complete'
                  GROUP BY 1, 2
                 ) x
           ) y
      GROUP BY "category"
     ) z
ORDER BY "avg_monthly_order_growth" DESC
LIMIT 1;
```

```sql
--Description: For that top-growing category (replace %%TOP_CATEGORY%% with the name found above), 
--calculate the monthly % revenue growth and its average over the full period
SELECT "month",
       "monthly_revenue",
       LAG("monthly_revenue") OVER (ORDER BY "month")     AS "prev_month_revenue",
       ROUND(
         CASE
             WHEN LAG("monthly_revenue") OVER (ORDER BY "month") IS NULL
                  OR LAG("monthly_revenue") OVER (ORDER BY "month") = 0 THEN NULL
             ELSE (("monthly_revenue" - LAG("monthly_revenue") OVER (ORDER BY "month"))
                   / LAG("monthly_revenue") OVER (ORDER BY "month")::FLOAT)
         END
       ,4)                                               AS "pct_revenue_growth"
FROM (
      SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))::DATE AS "month",
             SUM(oi."sale_price")                                              AS "monthly_revenue"
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
           ON p."id" = oi."product_id"
      WHERE oi."status" = 'Complete'
        AND p."category" = '%%TOP_CATEGORY%%'
      GROUP BY 1
     ) rev
ORDER BY "month"
LIMIT 20;
```

