```

```sql
--Description: 4) Join ORDER_ITEMS → PRODUCTS to expose the product category that each completed line belongs to
SELECT 
  oi."order_id",
  p."category"               AS "product_category",
  oi."sale_price",
  to_timestamp(oi."created_at" / 1000000) AS "order_ts"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS   oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS      p
  ON p."id" = oi."product_id"
WHERE oi."status" = 'Complete'
LIMIT 20;
```

```sql
--Description: 5) Count DISTINCT orders per month & category (only completed lines)
SELECT
  DATE_TRUNC('month', to_timestamp(oi."created_at" / 1000000)) AS "order_month",
  p."category"                                                 AS "product_category",
  COUNT(DISTINCT oi."order_id")                                AS "distinct_orders"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS   oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS      p
  ON p."id" = oi."product_id"
WHERE oi."status" = 'Complete'
GROUP BY "order_month", "product_category"
ORDER BY "order_month", "product_category"
LIMIT 20;
```

```sql
--Description: 6) Month-over-month % growth in DISTINCT orders for every category
WITH monthly AS (
  SELECT
    DATE_TRUNC('month', to_timestamp(oi."created_at" / 1000000)) AS "order_month",
    p."category"                                                 AS "product_category",
    COUNT(DISTINCT oi."order_id")                                AS "distinct_orders"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS   oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS      p
    ON p."id" = oi."product_id"
  WHERE oi."status" = 'Complete'
  GROUP BY "order_month", "product_category"
)
SELECT
  "product_category",
  "order_month",
  "distinct_orders",
  LAG("distinct_orders")  OVER (PARTITION BY "product_category" ORDER BY "order_month") AS "prev_orders",
  CASE
    WHEN LAG("distinct_orders") OVER (PARTITION BY "product_category" ORDER BY "order_month") = 0 THEN NULL
    ELSE ( ("distinct_orders" - LAG("distinct_orders") OVER (PARTITION BY "product_category" ORDER BY "order_month")) 
          / LAG("distinct_orders") OVER (PARTITION BY "product_category" ORDER BY "order_month") ) * 100
  END                                                          AS "pct_growth"
FROM monthly
ORDER BY "product_category", "order_month"
LIMIT 20;
```

```sql
--Description: 7) Average monthly % growth in DISTINCT orders for each product category
WITH monthly AS (
  SELECT
    DATE_TRUNC('month', to_timestamp(oi."created_at" / 1000000)) AS "order_month",
    p."category"                                                 AS "product_category",
    COUNT(DISTINCT oi."order_id")                                AS "distinct_orders"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS   oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS      p
    ON p."id" = oi."product_id"
  WHERE oi."status" = 'Complete'
  GROUP BY "order_month", "product_category"
), growth AS (
  SELECT
    "product_category",
    ("distinct_orders" - LAG("distinct_orders") OVER (PARTITION BY "product_category" ORDER BY "order_month"))
      / NULLIF(LAG("distinct_orders") OVER (PARTITION BY "product_category" ORDER BY "order_month"),0) * 100 
      AS "pct_growth"
  FROM monthly
)
SELECT
  "product_category",
  AVG("pct_growth") AS "avg_monthly_order_growth_pct"
FROM growth
GROUP BY "product_category"
ORDER BY "avg_monthly_order_growth_pct" DESC
LIMIT 20;
```

```sql
--Description: 8) Identify the single category with the highest average monthly order-growth rate
WITH monthly AS (
  SELECT
    DATE_TRUNC('month', to_timestamp(oi."created_at" / 1000000)) AS "order_month",
    p."category"                                                 AS "product_category",
    COUNT(DISTINCT oi."order_id")                                AS "distinct_orders"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS   oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS      p
    ON p."id" = oi."product_id"
  WHERE oi."status" = 'Complete'
  GROUP BY "order_month", "product_category"
), growth AS (
  SELECT
    "product_category",
    ("distinct_orders" - LAG("distinct_orders") OVER (PARTITION BY "product_category" ORDER BY "order_month"))
      / NULLIF(LAG("distinct_orders") OVER (PARTITION BY "product_category" ORDER BY "order_month"),0) * 100 
      AS "pct_growth"
  FROM monthly
)
SELECT
  "product_category",
  AVG("pct_growth") AS "avg_monthly_order_growth_pct"
FROM growth
GROUP BY "product_category"
ORDER BY "avg_monthly_order_growth_pct" DESC
LIMIT 1;
```

```sql
--Description: 9) Monthly revenue (sum of sale_price) for the category identified above ─ replace <TOP_CATEGORY> once you know it
SELECT
  DATE_TRUNC('month', to_timestamp(oi."created_at" / 1000000)) AS "order_month",
  SUM(oi."sale_price")                                         AS "monthly_revenue"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS   oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS      p
  ON p."id" = oi."product_id"
WHERE oi."status" = 'Complete'
  AND p."category" = '<TOP_CATEGORY>'
GROUP BY "order_month"
ORDER BY "order_month"
LIMIT 20;
```

```sql
--Description: 10) Month-over-month % growth in revenue and its average for that top category
WITH rev AS (
  SELECT
    DATE_TRUNC('month', to_timestamp(oi."created_at" / 1000000)) AS "order_month",
    SUM(oi."sale_price")                                         AS "monthly_revenue"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS   oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS      p
    ON p."id" = oi."product_id"
  WHERE oi."status" = 'Complete'
    AND p."category" = '<TOP_CATEGORY>'
  GROUP BY "order_month"
)
SELECT
  "order_month",
  "monthly_revenue",
  LAG("monthly_revenue") OVER (ORDER BY "order_month") AS "prev_revenue",
  CASE
    WHEN LAG("monthly_revenue") OVER (ORDER BY "order_month") = 0 THEN NULL
    ELSE ( ("monthly_revenue" - LAG("monthly_revenue") OVER (ORDER BY "order_month"))
          / LAG("monthly_revenue") OVER (ORDER BY "order_month") ) * 100
  END                                                   AS "pct_revenue_growth"
FROM rev
ORDER BY "order_month"
LIMIT 20;
```
