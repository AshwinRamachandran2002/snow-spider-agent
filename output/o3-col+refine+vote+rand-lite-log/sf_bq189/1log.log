Query:
--Description: 5)  Average of those monthly order-growth percentages for each category
SELECT
       "category",
       ROUND( AVG("order_growth_pct"), 2 ) AS "avg_order_growth_pct"
FROM  (
        /* refer to query 4 */
        SELECT
               "month",
               "category",
               "orders",
               ROUND( ( "orders"
                       /NULLIF( LAG("orders") OVER (PARTITION BY "category" ORDER BY "month"), 0 ) - 1 )*100 , 2) 
                      AS "order_growth_pct"
        FROM   (
                SELECT 
                       DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "month",
                       p."category",
                       COUNT(DISTINCT oi."order_id")                              AS "orders"
                FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
                JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
                       ON p."id" = oi."product_id"
                WHERE  oi."status" = 'Complete'
                GROUP  BY 1,2
               ) inner_sub
       ) growth
GROUP BY "category"
ORDER BY "avg_order_growth_pct" DESC
LIMIT 20;
