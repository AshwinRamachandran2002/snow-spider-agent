```sql
--Description: 1)  Look at all possible order item statuses so we know which value means a finished sale
SELECT DISTINCT "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
LIMIT 20;
```

```sql
--Description: 2)  Sample rows of finished (“Complete”) order-items together with their product category & sale price
SELECT 
       oi."order_id",
       oi."user_id",
       oi."sale_price",
       p."category",
       oi."created_at"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
       ON p."id" = oi."product_id"
WHERE  oi."status" = 'Complete'
LIMIT 20;
```

```sql
--Description: 3)  Monthly count of DISTINCT finished orders per product category
SELECT 
       DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))  AS "month",
       p."category",
       COUNT(DISTINCT oi."order_id")                               AS "orders"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
       ON p."id" = oi."product_id"
WHERE  oi."status" = 'Complete'
GROUP  BY 1,2
ORDER  BY 2,1
LIMIT 20;
```

```sql
--Description: 4)  Month-to-month % growth in unique-order count for every category
SELECT
       "month",
       "category",
       "orders",
       ROUND( ( "orders"
               /NULLIF( LAG("orders") OVER (PARTITION BY "category" ORDER BY "month"), 0 ) - 1 )*100 , 2) 
              AS "order_growth_pct"
FROM   (
        SELECT 
               DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "month",
               p."category",
               COUNT(DISTINCT oi."order_id")                              AS "orders"
        FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
        JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
               ON p."id" = oi."product_id"
        WHERE  oi."status" = 'Complete'
        GROUP  BY 1,2
       ) sub
ORDER BY "category","month"
LIMIT 20;
```

```sql
--Description: 5)  Average of those monthly order-growth percentages for each category
SELECT
       "category",
       ROUND( AVG("order_growth_pct"), 2 ) AS "avg_order_growth_pct"
FROM  (
        /* refer to query 4 */
        SELECT
               "month",
               "category",
               "orders",
               ROUND( ( "orders"
                       /NULLIF( LAG("orders") OVER (PARTITION BY "category" ORDER BY "month"), 0 ) - 1 )*100 , 2) 
                      AS "order_growth_pct"
        FROM   (
                SELECT 
                       DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "month",
                       p."category",
                       COUNT(DISTINCT oi."order_id")                              AS "orders"
                FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
                JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
                       ON p."id" = oi."product_id"
                WHERE  oi."status" = 'Complete'
                GROUP  BY 1,2
               ) inner_sub
       ) growth
GROUP BY "category"
ORDER BY "avg_order_growth_pct" DESC
LIMIT 20;
```

```sql
--Description: 6)  Identify the single category with the highest average monthly order-growth percentage
SELECT
       "category"
FROM   (
        /* same aggregation as query 5 */
        SELECT
               "category",
               AVG("order_growth_pct") AS "avg_order_growth_pct"
        FROM  (
                SELECT
                       "month",
                       "category",
                       "orders",
                       ( "orders"
                         /NULLIF( LAG("orders") OVER (PARTITION BY "category" ORDER BY "month"), 0 ) - 1 )*100 
                         AS "order_growth_pct"
                FROM   (
                        SELECT 
                               DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "month",
                               p."category",
                               COUNT(DISTINCT oi."order_id")                              AS "orders"
                        FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
                        JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
                               ON p."id" = oi."product_id"
                        WHERE  oi."status" = 'Complete'
                        GROUP  BY 1,2
                       ) base
               ) growth_all
        GROUP BY "category"
       ) ranked
ORDER BY "avg_order_growth_pct" DESC
LIMIT 1;
```

```sql
--Description: 7)  Monthly revenue (sum of sale prices) for the best-performing category found in query 6
WITH top_cat AS (
     /* pull the top category dynamically */
     SELECT
            "category"
     FROM  (
            SELECT
                   "category",
                   AVG("order_growth_pct") AS "avg_order_growth_pct"
            FROM  (
                    SELECT
                           "month",
                           "category",
                           "orders",
                           ( "orders"
                             /NULLIF( LAG("orders") OVER (PARTITION BY "category" ORDER BY "month"), 0 ) - 1 )*100 
                             AS "order_growth_pct"
                    FROM   (
                            SELECT 
                                   DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "month",
                                   p."category",
                                   COUNT(DISTINCT oi."order_id")                              AS "orders"
                            FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
                            JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
                                   ON p."id" = oi."product_id"
                            WHERE  oi."status" = 'Complete'
                            GROUP  BY 1,2
                           ) lvl1
                   ) lvl2
            GROUP BY "category"
           )
     ORDER BY "avg_order_growth_pct" DESC
     LIMIT 1
)
SELECT 
       DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))  AS "month",
       SUM(oi."sale_price")                                        AS "revenue"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
       ON p."id" = oi."product_id"
JOIN   top_cat tc
       ON p."category" = tc."category"
WHERE  oi."status" = 'Complete'
GROUP  BY 1
ORDER  BY 1
LIMIT 20;
```

```sql
--Description: 8)  Month-to-month revenue-growth percentages for that same top category
WITH monthly_rev AS (
     /* query 7 without LIMIT for full period */
     SELECT 
            DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))  AS "month",
            SUM(oi."sale_price")                                        AS "revenue"
     FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
     JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
            ON p."id" = oi."product_id"
     JOIN   (
            SELECT
                   "category"
            FROM  (
                   SELECT
                          "category",
                          AVG("order_growth_pct") AS "avg_order_growth_pct"
                   FROM  (
                           SELECT
                                  "month",
                                  "category",
                                  "orders",
                                  ( "orders"
                                    /NULLIF( LAG("orders") OVER (PARTITION BY "category" ORDER BY "month"), 0 ) - 1 )*100 
                                    AS "order_growth_pct"
                           FROM   (
                                   SELECT 
                                          DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "month",
                                          p."category",
                                          COUNT(DISTINCT oi."order_id")                              AS "orders"
                                   FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
                                   JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
                                          ON p."id" = oi."product_id"
                                   WHERE  oi."status" = 'Complete'
                                   GROUP  BY 1,2
                                  ) tmp1
                          ) tmp2
                   GROUP BY "category"
                  ) ranked
            ORDER BY "avg_order_growth_pct" DESC
            LIMIT 1
           ) tc
            ON p."category" = tc."category"
     WHERE  oi."status" = 'Complete'
     GROUP  BY 1
)
SELECT
       "month",
       "revenue",
       ROUND( ( "revenue"
               /NULLIF( LAG("revenue") OVER (ORDER BY "month"), 0 ) - 1 )*100 , 2) 
              AS "revenue_growth_pct"
FROM   monthly_rev
ORDER  BY "month"
LIMIT 20;
```

```sql
--Description: 9)  Average monthly revenue-growth percentage for the top-performing category
WITH monthly_rev AS (
     /* same CTE as in query 8 */
     SELECT 
            DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))  AS "month",
            SUM(oi."sale_price")                                        AS "revenue"
     FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
     JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
            ON p."id" = oi."product_id"
     JOIN   (
            SELECT
                   "category"
            FROM  (
                   SELECT
                          "category",
                          AVG("order_growth_pct") AS "avg_order_growth_pct"
                   FROM  (
                           SELECT
                                  "month",
                                  "category",
                                  "orders",
                                  ( "orders"
                                    /NULLIF( LAG("orders") OVER (PARTITION BY "category" ORDER BY "month"), 0 ) - 1 )*100 
                                    AS "order_growth_pct"
                           FROM   (
                                   SELECT 
                                          DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "month",
                                          p."category",
                                          COUNT(DISTINCT oi."order_id")                              AS "orders"
                                   FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
                                   JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
                                          ON p."id" = oi."product_id"
                                   WHERE  oi."status" = 'Complete'
                                   GROUP  BY 1,2
                                  ) a
                          ) b
                   GROUP BY "category"
                  ) ranked
            ORDER BY "avg_order_growth_pct" DESC
            LIMIT 1
           ) tc
            ON p."category" = tc."category"
     WHERE  oi."status" = 'Complete'
     GROUP  BY 1
),
rev_growth AS (
     SELECT
            "month",
            "revenue",
            ( "revenue"
              /NULLIF( LAG("revenue") OVER (ORDER BY "month"), 0 ) - 1 )*100 AS "revenue_growth_pct"
     FROM   monthly_rev
)
SELECT
       ROUND( AVG("revenue_growth_pct"), 2 ) AS "avg_monthly_revenue_growth_pct"
FROM   rev_growth
LIMIT 20;
