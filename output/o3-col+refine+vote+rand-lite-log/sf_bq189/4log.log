```sql
--Description: 6)  Compute the month-over-month percentage change in distinct orders for every category  
WITH monthly_orders AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
         p."category",
         COUNT(DISTINCT oi."order_id") AS "monthly_orders"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS    p
    ON oi."product_id" = p."id"
  WHERE oi."status" = 'Complete'
  GROUP BY "order_month", p."category"
)
SELECT category,
       order_month,
       monthly_orders,
       LAG(monthly_orders) OVER (PARTITION BY category ORDER BY order_month) AS "prev_month_orders",
       CASE
         WHEN LAG(monthly_orders) OVER (PARTITION BY category ORDER BY order_month) = 0 THEN NULL
         ELSE ROUND(
           (monthly_orders - LAG(monthly_orders) OVER (PARTITION BY category ORDER BY order_month))
           / NULLIF(LAG(monthly_orders) OVER (PARTITION BY category ORDER BY order_month),0)
           * 100 ,2)
       END AS "pct_change_orders"
FROM monthly_orders
ORDER BY category, order_month
LIMIT 20;
```

```sql
--Description: 7)  Average the monthly order-growth percentages for each category  
WITH monthly_orders AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
         p."category",
         COUNT(DISTINCT oi."order_id") AS "monthly_orders"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS    p
    ON oi."product_id" = p."id"
  WHERE oi."status" = 'Complete'
  GROUP BY "order_month", p."category"
),
growth AS (
  SELECT category,
         (monthly_orders - LAG(monthly_orders) OVER (PARTITION BY category ORDER BY order_month))
         / NULLIF(LAG(monthly_orders) OVER (PARTITION BY category ORDER BY order_month),0) * 100
         AS pct_change_orders
  FROM monthly_orders
)
SELECT category,
       ROUND(AVG(pct_change_orders),2) AS "avg_monthly_order_growth_pct"
FROM growth
GROUP BY category
ORDER BY "avg_monthly_order_growth_pct" DESC
LIMIT 20;
```

```sql
--Description: 8)  Identify the single category that has the highest average monthly order-growth rate  
WITH monthly_orders AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
         p."category",
         COUNT(DISTINCT oi."order_id") AS "monthly_orders"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS    p
    ON oi."product_id" = p."id"
  WHERE oi."status" = 'Complete'
  GROUP BY "order_month", p."category"
),
growth AS (
  SELECT category,
         (monthly_orders - LAG(monthly_orders) OVER (PARTITION BY category ORDER BY order_month))
         / NULLIF(LAG(monthly_orders) OVER (PARTITION BY category ORDER BY order_month),0) * 100
         AS pct_change_orders
  FROM monthly_orders
)
SELECT category
FROM (
  SELECT category,
         ROUND(AVG(pct_change_orders),2) AS "avg_monthly_order_growth_pct"
  FROM growth
  GROUP BY category
  ORDER BY "avg_monthly_order_growth_pct" DESC
  LIMIT 1
) as top_cat;
