    WHERE oi."status" = 'Complete'
    GROUP BY
        DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)),
        p."category"
),
growth AS (
    SELECT
        category,
        ((monthly_orders
          - LAG(monthly_orders) OVER (PARTITION BY category ORDER BY order_month))
         / NULLIF(LAG(monthly_orders) OVER (PARTITION BY category ORDER BY order_month),0)
        ) * 100                                                    AS pct_change_orders
    FROM monthly_orders
),
best_category AS (
    SELECT category
    FROM (
        SELECT
            category,
            AVG(pct_change_orders) AS avg_growth
        FROM growth
        WHERE pct_change_orders IS NOT NULL
        GROUP BY category
        ORDER BY avg_growth DESC
        LIMIT 1
    )
),
monthly_revenue AS (
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)) AS order_month,
        SUM(oi."sale_price")                                        AS revenue
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS    p
          ON oi."product_id" = p."id"
    JOIN best_category bc
          ON p."category" = bc.category
    WHERE oi."status" = 'Complete'
    GROUP BY DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))
),
rev_growth AS (
    SELECT
        order_month,
        ((revenue
          - LAG(revenue) OVER (ORDER BY order_month))
         / NULLIF(LAG(revenue) OVER (ORDER BY order_month), 0)
        ) * 100                                                    AS pct_change_rev
    FROM monthly_revenue
)
SELECT
    ROUND(AVG(pct_change_rev), 2) AS avg_monthly_revenue_growth_pct
FROM rev_growth
WHERE pct_change_rev IS NOT NULL
