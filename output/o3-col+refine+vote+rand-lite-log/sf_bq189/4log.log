```sql
--Description: “All-in-one” solution
--  • monthly_orders  – distinct completed-order counts per product category per month
--  • order_growth    – month-over-month % change in those counts (skip first month / 0-divisions)
--  • best_category   – category with the highest average monthly order-growth rate
--  • monthly_revenue – total revenue per month for every category (completed orders only)
--  • revenue_growth  – month-over-month % change in revenue for the best category
--  • Final SELECT    – returns that category together with:
--        1) its average monthly order-growth %  (rounded to 2-dp)
--        2) its average monthly revenue-growth % (rounded to 2-dp)

WITH monthly_orders AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)) AS order_month,
           p."category"                                                AS category,
           COUNT(DISTINCT oi."order_id")                               AS monthly_orders
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
           ON oi."product_id" = p."id"
    WHERE  oi."status" = 'Complete'
    GROUP  BY order_month, category
),
order_growth AS (
    SELECT category,
           ((monthly_orders - LAG(monthly_orders) OVER (PARTITION BY category ORDER BY order_month))
            / NULLIF(LAG(monthly_orders) OVER (PARTITION BY category ORDER BY order_month), 0))*100
            AS pct_change_orders
    FROM   monthly_orders
),
best_category AS (
    SELECT category,
           AVG(pct_change_orders) AS avg_order_growth
    FROM   order_growth
    WHERE  pct_change_orders IS NOT NULL
    GROUP  BY category
    ORDER  BY avg_order_growth DESC
    LIMIT 1
),
monthly_revenue AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)) AS order_month,
           p."category"                                                AS category,
           SUM(oi."sale_price")                                        AS revenue
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
           ON oi."product_id" = p."id"
    WHERE  oi."status" = 'Complete'
    GROUP  BY order_month, category
),
revenue_growth AS (
    SELECT mr.category,
           ((revenue - LAG(revenue) OVER (PARTITION BY mr.category ORDER BY mr.order_month))
            / NULLIF(LAG(revenue) OVER (PARTITION BY mr.category ORDER BY mr.order_month),0))*100
            AS pct_change_revenue
    FROM   monthly_revenue mr
    JOIN   best_category   bc ON mr.category = bc.category
)
SELECT bc.category                                              AS best_category,
       ROUND(bc.avg_order_growth, 2)                            AS avg_monthly_order_growth_pct,
       ROUND(AVG(rg.pct_change_revenue), 2)                     AS avg_monthly_revenue_growth_pct
FROM   best_category bc
JOIN   revenue_growth rg ON bc.category = rg.category
WHERE  rg.pct_change_revenue IS NOT NULL;
```
