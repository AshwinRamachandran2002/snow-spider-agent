```sql
--Description: Get a quick look at the product category list available in the catalogue
SELECT DISTINCT "category"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
LIMIT 20;
```

```sql
--Description: Preview some completed order-item rows together with their product category to ensure the join is correct
SELECT oi."order_id",
       oi."created_at",
       oi."sale_price",
       p."category"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
  ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
LIMIT 20;
```

```sql
--Description: Count the number of unique completed orders for every product category and calendar month
SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "month",
       p."category",
       COUNT(DISTINCT oi."order_id")                           AS "num_orders"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
  ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
GROUP BY "month", p."category"
ORDER BY p."category", "month"
LIMIT 20;
```

```sql
--Description: For each product category, calculate the month-over-month percentage growth in completed orders
SELECT "month",
       "category",
       "num_orders",
       LAG("num_orders")  OVER (PARTITION BY "category" ORDER BY "month") AS "prev_month_orders",
       CASE
           WHEN LAG("num_orders") OVER (PARTITION BY "category" ORDER BY "month") IS NULL
               THEN NULL
           ELSE 100.0 * ( "num_orders" - LAG("num_orders") OVER (PARTITION BY "category" ORDER BY "month") )
                     / NULLIF( LAG("num_orders") OVER (PARTITION BY "category" ORDER BY "month"), 0 )
       END AS "pct_growth_orders"
FROM (
      SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "month",
             p."category",
             COUNT(DISTINCT oi."order_id") AS "num_orders"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
        ON oi."product_id" = p."id"
      WHERE oi."status" = 'Complete'
      GROUP BY "month", p."category"
) t
ORDER BY t."category", t."month"
LIMIT 20;
```

```sql
--Description: Compute the average monthly order growth rate for every product category
SELECT "category",
       AVG("pct_growth_orders")       AS "avg_pct_growth_orders"
FROM (
      /* reuse the MoM growth computation */
      SELECT "month",
             "category",
             CASE
                 WHEN LAG("num_orders") OVER (PARTITION BY "category" ORDER BY "month") IS NULL
                     THEN NULL
                 ELSE 100.0 * ( "num_orders" - LAG("num_orders") OVER (PARTITION BY "category" ORDER BY "month") )
                           / NULLIF( LAG("num_orders") OVER (PARTITION BY "category" ORDER BY "month"), 0 )
             END AS "pct_growth_orders"
      FROM (
            SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "month",
                   p."category",
                   COUNT(DISTINCT oi."order_id") AS "num_orders"
            FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
            JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
              ON oi."product_id" = p."id"
            WHERE oi."status" = 'Complete'
            GROUP BY "month", p."category"
      )
) s
GROUP BY "category"
ORDER BY "avg_pct_growth_orders" DESC
LIMIT 20;
```

```sql
--Description: Pick the category with the highest average order growth (replace 'Accessories' by the real winner) and view its monthly revenue
SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000))       AS "month",
       SUM(oi."sale_price")                                                AS "revenue"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
  ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
  AND p."category" = 'Accessories'             -- <-- substitute with max-growth category
GROUP BY "month"
ORDER BY "month"
LIMIT 20;
```

```sql
--Description: Compute the month-over-month revenue growth percentage for that top category
SELECT "month",
       "revenue",
       LAG("revenue") OVER (ORDER BY "month")                     AS "prev_revenue",
       CASE
           WHEN LAG("revenue") OVER (ORDER BY "month") IS NULL
               THEN NULL
           ELSE 100.0 * ( "revenue" - LAG("revenue") OVER (ORDER BY "month") )
                     / NULLIF( LAG("revenue") OVER (ORDER BY "month"), 0 )
       END                                                       AS "pct_growth_revenue"
FROM (
      SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "month",
             SUM(oi."sale_price")                                          AS "revenue"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
        ON oi."product_id" = p."id"
      WHERE oi."status" = 'Complete'
        AND p."category" = 'Accessories'             -- <-- substitute with max-growth category
      GROUP BY "month"
)
ORDER BY "month"
LIMIT 20;
```

```sql
--Description: Average the monthly revenue growth percentages for the chosen category
SELECT AVG("pct_growth_revenue") AS "avg_pct_growth_revenue"
FROM (
      SELECT "month",
             "revenue",
             LAG("revenue") OVER (ORDER BY "month") AS "prev_revenue",
             CASE
                 WHEN LAG("revenue") OVER (ORDER BY "month") IS NULL
                     THEN NULL
                 ELSE 100.0 * ( "revenue" - LAG("revenue") OVER (ORDER BY "month") )
                           / NULLIF( LAG("revenue") OVER (ORDER BY "month"), 0 )
             END AS "pct_growth_revenue"
      FROM (
            SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "month",
                   SUM(oi."sale_price")                                          AS "revenue"
            FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
            JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
              ON oi."product_id" = p."id"
            WHERE oi."status" = 'Complete'
              AND p."category" = 'Accessories'           -- <-- substitute with max-growth category
            GROUP BY "month"
      )
)
LIMIT 20;
```

