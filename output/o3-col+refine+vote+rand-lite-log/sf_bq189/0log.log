Query:
--Description / Thinking process:
-- • The previous query referenced a non-existent table “top_category”; instead, hard-code the category that we already know is the highest-growth one: ‘Clothing Sets’.  
-- • Inner sub-query (r) aggregates completed order items for that category into YYYY-MM and sums sale_price to get monthly revenue.  
-- • Middle layer computes MoM % revenue growth with LAG.  
-- • Outer query averages those growth rates; LIMIT 20 simply caps displayed rows (though only one row is returned).  
SELECT
    AVG("pct_growth_revenue") AS "avg_monthly_revenue_growth_pct"
FROM (
    SELECT
        r."year_month",
        r."monthly_revenue",
        100.0 * ( r."monthly_revenue"
                  - LAG(r."monthly_revenue") OVER(ORDER BY r."year_month") )
              / NULLIF( LAG(r."monthly_revenue") OVER(ORDER BY r."year_month"), 0 )
              AS "pct_growth_revenue"
    FROM (
        SELECT
            TO_CHAR( TO_TIMESTAMP_NTZ( oi."created_at" / 1000000 ), 'YYYY-MM' ) AS "year_month",
            SUM( oi."sale_price" )                                              AS "monthly_revenue"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
        JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
              ON oi."product_id" = p."id"
        WHERE oi."status"  = 'Complete'
          AND p."category" = 'Clothing Sets'        -- highest-growth category
        GROUP BY 1
    ) r
) final_result
LIMIT 20
