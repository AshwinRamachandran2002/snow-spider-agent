```sql
--Description / Thinking process:
-- 1) “Clothing Sets” is the product category with the highest average monthly order-count growth.
-- 2) In CTE month_rev, aggregate completed order items for that category into YYYY-MM buckets and sum sale_price to get monthly revenue.
-- 3) In CTE rev_growth, compute month-over-month percentage revenue change using LAG.
-- 4) The final SELECT returns the average of these monthly revenue growth percentages (ignoring NULLs from the first month).
WITH month_rev AS (
    SELECT
        TO_CHAR( TO_TIMESTAMP_NTZ( oi."created_at" / 1000000 ), 'YYYY-MM' ) AS "year_month",
        SUM( oi."sale_price" )                                              AS "monthly_revenue"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
          ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
      AND p."category" = 'Clothing Sets'
    GROUP BY 1
), rev_growth AS (
    SELECT
        "year_month",
        "monthly_revenue",
        100.0 * ( "monthly_revenue" - LAG("monthly_revenue") OVER(ORDER BY "year_month") )
              / NULLIF( LAG("monthly_revenue") OVER(ORDER BY "year_month"), 0 ) AS "pct_growth_revenue"
    FROM month_rev
)
SELECT
    AVG("pct_growth_revenue") AS "avg_monthly_revenue_growth_pct"
FROM rev_growth;
```
