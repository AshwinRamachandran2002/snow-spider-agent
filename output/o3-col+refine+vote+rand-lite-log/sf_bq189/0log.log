```sql
--Description: Inspect a sample of “Complete” order item records to understand key columns such as order_id, product_id, sale_price and created_at timestamps.  
SELECT 
  "order_id",
  "product_id",
  "sale_price",
  "status",
  "created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
WHERE "status" = 'Complete'
LIMIT 20;
```

```sql
--Description: View a list of distinct product categories that exist in the catalog.  
SELECT DISTINCT 
  "category"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"
LIMIT 20;
```

```sql
--Description: Join complete order-items with products to verify category assignment and inspect a few joined rows.  
SELECT 
  oi."order_id",
  p."category",
  p."name"      AS "product_name",
  oi."sale_price",
  oi."created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      p
      ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
LIMIT 20;
```

```sql
--Description: Derive year-month (YYYY-MM) buckets for each complete order item and count DISTINCT orders per category per month.  
SELECT  
  p."category",
  TO_CHAR( TO_TIMESTAMP_NTZ( oi."created_at" / 1000000 ), 'YYYY-MM') AS "year_month",
  COUNT(DISTINCT oi."order_id")                                       AS "unique_orders"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      p
      ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
GROUP BY p."category",
         TO_CHAR( TO_TIMESTAMP_NTZ( oi."created_at" / 1000000 ), 'YYYY-MM')
ORDER BY p."category",
         "year_month"
LIMIT 20;
```

```sql
--Description: Compute month-over-month percentage change in DISTINCT order count inside every category.  
SELECT
  t."category",
  t."year_month",
  t."unique_orders",
  100.0 * ( t."unique_orders" - LAG(t."unique_orders") OVER(PARTITION BY t."category" ORDER BY t."year_month") )
        / NULLIF( LAG(t."unique_orders") OVER(PARTITION BY t."category" ORDER BY t."year_month"), 0 ) 
        AS "pct_growth_orders"
FROM (
    SELECT  
      p."category",
      TO_CHAR( TO_TIMESTAMP_NTZ( oi."created_at" / 1000000 ), 'YYYY-MM') AS "year_month",
      COUNT(DISTINCT oi."order_id")                                       AS "unique_orders"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      p
          ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
    GROUP BY p."category",
             TO_CHAR( TO_TIMESTAMP_NTZ( oi."created_at" / 1000000 ), 'YYYY-MM')
) t
ORDER BY t."category", t."year_month"
LIMIT 20;
```

```sql
--Description: Average the month-over-month order growth percentages per category (ignoring the first month which has NULL growth).  
SELECT
  "category",
  AVG("pct_growth_orders") AS "avg_monthly_order_growth_pct"
FROM (
  SELECT
    t."category",
    100.0 * ( t."unique_orders" - LAG(t."unique_orders") OVER(PARTITION BY t."category" ORDER BY t."year_month") )
          / NULLIF( LAG(t."unique_orders") OVER(PARTITION BY t."category" ORDER BY t."year_month"), 0 ) 
          AS "pct_growth_orders"
  FROM (
      SELECT  
        p."category",
        TO_CHAR( TO_TIMESTAMP_NTZ( oi."created_at" / 1000000 ), 'YYYY-MM') AS "year_month",
        COUNT(DISTINCT oi."order_id")                                       AS "unique_orders"
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      p
            ON oi."product_id" = p."id"
      WHERE oi."status" = 'Complete'
      GROUP BY p."category",
               TO_CHAR( TO_TIMESTAMP_NTZ( oi."created_at" / 1000000 ), 'YYYY-MM')
  ) t
) s
GROUP BY "category"
ORDER BY "avg_monthly_order_growth_pct" DESC
LIMIT 20;
```

```sql
--Description: Retrieve the single category that has the maximum average monthly order growth (top 1).  
SELECT *
FROM (
  SELECT
    "category",
    AVG("pct_growth_orders") AS "avg_monthly_order_growth_pct"
  FROM (
    SELECT
      t."category",
      100.0 * ( t."unique_orders" - LAG(t."unique_orders") OVER(PARTITION BY t."category" ORDER BY t."year_month") )
            / NULLIF( LAG(t."unique_orders") OVER(PARTITION BY t."category" ORDER BY t."year_month"), 0 ) 
            AS "pct_growth_orders"
    FROM (
        SELECT  
          p."category",
          TO_CHAR( TO_TIMESTAMP_NTZ( oi."created_at" / 1000000 ), 'YYYY-MM') AS "year_month",
          COUNT(DISTINCT oi."order_id")                                       AS "unique_orders"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
        JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      p
              ON oi."product_id" = p."id"
        WHERE oi."status" = 'Complete'
        GROUP BY p."category",
                 TO_CHAR( TO_TIMESTAMP_NTZ( oi."created_at" / 1000000 ), 'YYYY-MM')
    ) t
  ) s
  GROUP BY "category"
  ORDER BY "avg_monthly_order_growth_pct" DESC
  LIMIT 1
) top_category;
```

```sql
--Description: For the highest-growth category (replace <TOP_CATEGORY> with actual value or sub-query), calculate total monthly revenue.  
SELECT  
  TO_CHAR( TO_TIMESTAMP_NTZ( oi."created_at" / 1000000 ), 'YYYY-MM') AS "year_month",
  SUM( oi."sale_price" )                                             AS "monthly_revenue"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      p
      ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
  AND p."category" = ( SELECT "category" FROM top_category )   -- or hard-code the category name
GROUP BY TO_CHAR( TO_TIMESTAMP_NTZ( oi."created_at" / 1000000 ), 'YYYY-MM')
ORDER BY "year_month"
LIMIT 20;
```

```sql
--Description: Compute month-over-month revenue growth percentages for that category and average them to obtain its average monthly revenue growth rate.  
SELECT
  AVG("pct_growth_revenue") AS "avg_monthly_revenue_growth_pct"
FROM (
  SELECT
    r."year_month",
    r."monthly_revenue",
    100.0 * ( r."monthly_revenue" - LAG(r."monthly_revenue") OVER(ORDER BY r."year_month") )
          / NULLIF( LAG(r."monthly_revenue") OVER(ORDER BY r."year_month"), 0 )
          AS "pct_growth_revenue"
  FROM (
      SELECT  
        TO_CHAR( TO_TIMESTAMP_NTZ( oi."created_at" / 1000000 ), 'YYYY-MM') AS "year_month",
        SUM( oi."sale_price" )                                             AS "monthly_revenue"
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      p
            ON oi."product_id" = p."id"
      WHERE oi."status" = 'Complete'
        AND p."category" = ( SELECT "category" FROM top_category )   -- or hard-code
      GROUP BY TO_CHAR( TO_TIMESTAMP_NTZ( oi."created_at" / 1000000 ), 'YYYY-MM')
  ) r
) final_result
LIMIT 20;
```
