--Description: Average the monthly order-growth rates for every category (first 20 rows).
WITH monthly AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "order_month",
           p."category"                                                   AS "product_category",
           COUNT(DISTINCT oi."order_id")                                  AS "unique_orders"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
         ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
    GROUP BY 1, 2
), growth AS (
    SELECT m."product_category",
           (("unique_orders" - LAG("unique_orders") OVER (PARTITION BY m."product_category" ORDER BY m."order_month"))
            / NULLIF(LAG("unique_orders") OVER (PARTITION BY m."product_category" ORDER BY m."order_month"),0))*100
            AS "pct_growth_orders"
    FROM monthly m
)
SELECT "product_category",
       AVG("pct_growth_orders") AS "avg_mthly_order_growth_pct"
FROM growth
GROUP BY "product_category"
ORDER BY "avg_mthly_order_growth_pct" DESC
LIMIT 20;
