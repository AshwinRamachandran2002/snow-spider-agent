```sql
--Description: Count DISTINCT order_ids per month & category (COMPLETE only) – first 20 rows. 
SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "order_month",
       p."category"                                                   AS "product_category",
       COUNT(DISTINCT oi."order_id")                                  AS "unique_orders"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
     ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
GROUP BY 1, 2
ORDER BY 1 DESC, 3 DESC
LIMIT 20;
```

```sql
--Description: Compute month-over-month % growth in unique orders for each category (first 20 rows).
WITH monthly AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "order_month",
           p."category"                                                   AS "product_category",
           COUNT(DISTINCT oi."order_id")                                  AS "unique_orders"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
         ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
    GROUP BY 1, 2
), growth AS (
    SELECT m.*,
           LAG("unique_orders") OVER (PARTITION BY "product_category" ORDER BY "order_month") AS "prev_orders",
           CASE 
               WHEN LAG("unique_orders") OVER (PARTITION BY "product_category" ORDER BY "order_month") IS NULL THEN NULL
               ELSE (("unique_orders" - "prev_orders") / "prev_orders") * 100
           END AS "pct_growth_orders"
    FROM monthly m
)
SELECT *
FROM growth
ORDER BY "product_category", "order_month"
LIMIT 20;
```

```sql
--Description: Average the monthly order-growth rates for every category (first 20 rows).
WITH monthly AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "order_month",
           p."category"                                                   AS "product_category",
           COUNT(DISTINCT oi."order_id")                                  AS "unique_orders"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
         ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
    GROUP BY 1, 2
), growth AS (
    SELECT m."product_category",
           (("unique_orders" - LAG("unique_orders") OVER (PARTITION BY m."product_category" ORDER BY m."order_month"))
            / NULLIF(LAG("unique_orders") OVER (PARTITION BY m."product_category" ORDER BY m."order_month"),0))*100
            AS "pct_growth_orders"
    FROM monthly m
)
SELECT "product_category",
       AVG("pct_growth_orders") AS "avg_mthly_order_growth_pct"
FROM growth
GROUP BY "product_category"
ORDER BY "avg_mthly_order_growth_pct" DESC
LIMIT 20;
```

```sql
--Description: For the top-growing category (replace 'Accessories' once identified), compute monthly revenue & its % growth.
WITH complete_sales AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "order_month",
           p."category"                                                   AS "product_category",
           SUM(oi."sale_price")                                           AS "revenue"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
         ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
      AND p."category" = 'Accessories'      -- ← swap with actual highest-growth category
    GROUP BY 1, 2
), growth AS (
    SELECT *,
           LAG("revenue") OVER (ORDER BY "order_month") AS "prev_rev",
           CASE 
               WHEN LAG("revenue") OVER (ORDER BY "order_month") IS NULL THEN NULL
               ELSE (("revenue" - "prev_rev") / "prev_rev") * 100
           END AS "pct_growth_revenue"
    FROM complete_sales
)
SELECT *
FROM growth
ORDER BY "order_month"
LIMIT 20;
```

```sql
--Description: Average monthly revenue-growth % for the category with the highest order growth (replace 'Accessories' when known).
WITH complete_sales AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "order_month",
           p."category"                                                   AS "product_category",
           SUM(oi."sale_price")                                           AS "revenue"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
         ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
      AND p."category" = 'Accessories'   -- ← swap with the identified category
    GROUP BY 1, 2
), growth AS (
    SELECT (("revenue" - LAG("revenue") OVER (ORDER BY "order_month"))
            / NULLIF(LAG("revenue") OVER (ORDER BY "order_month"),0))*100
            AS "pct_growth_revenue"
    FROM complete_sales
)
SELECT AVG("pct_growth_revenue") AS "avg_mthly_revenue_growth_pct"
FROM growth
LIMIT 20;
```
