Query:
--Description: For the top-growing category (replace 'Accessories' once identified), compute monthly revenue & its % growth.
WITH complete_sales AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1000000)) AS "order_month",
           p."category"                                                   AS "product_category",
           SUM(oi."sale_price")                                           AS "revenue"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
         ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
      AND p."category" = 'Accessories'      -- ← swap with actual highest-growth category
    GROUP BY 1, 2
), growth AS (
    SELECT *,
           LAG("revenue") OVER (ORDER BY "order_month") AS "prev_rev",
           CASE 
               WHEN LAG("revenue") OVER (ORDER BY "order_month") IS NULL THEN NULL
               ELSE (("revenue" - "prev_rev") / "prev_rev") * 100
           END AS "pct_growth_revenue"
    FROM complete_sales
)
SELECT *
FROM growth
ORDER BY "order_month"
LIMIT 20;
