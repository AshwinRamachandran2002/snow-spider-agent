--Description: Show the numerical difference between the two average balances obtained above
WITH
high_month AS (
    SELECT AVG(bal) AS high_avg
    FROM (
        SELECT "customer_id",
               substr("txn_date",1,7) AS "yyyymm",
               SUM(CASE
                       WHEN "txn_type"='deposit'    THEN  "txn_amount"
                       WHEN "txn_type"='withdrawal' THEN -"txn_amount"
                       ELSE 0
                   END) AS bal
        FROM "customer_transactions"
        WHERE substr("txn_date",1,4)='2020'
        GROUP BY "customer_id","yyyymm"
    )
    WHERE "yyyymm" = (
        SELECT "yyyymm" FROM (
            SELECT "yyyymm", COUNT(*) AS pos_cnt
            FROM (
                SELECT "customer_id",
                       substr("txn_date",1,7) AS "yyyymm",
                       SUM(CASE
                               WHEN "txn_type"='deposit'    THEN  "txn_amount"
                               WHEN "txn_type"='withdrawal' THEN -"txn_amount"
                               ELSE 0
                           END) AS bal
                FROM "customer_transactions"
                WHERE substr("txn_date",1,4)='2020'
                GROUP BY "customer_id","yyyymm"
            )
            WHERE bal>0
            GROUP BY "yyyymm"
            ORDER BY pos_cnt DESC, "yyyymm"
            LIMIT 1
        )
    )
),
low_month AS (
    SELECT AVG(bal) AS low_avg
    FROM (
        SELECT "customer_id",
               substr("txn_date",1,7) AS "yyyymm",
               SUM(CASE
                       WHEN "txn_type"='deposit'    THEN  "txn_amount"
                       WHEN "txn_type"='withdrawal' THEN -"txn_amount"
                       ELSE 0
                   END) AS bal
        FROM "customer_transactions"
        WHERE substr("txn_date",1,4)='2020'
        GROUP BY "customer_id","yyyymm"
    )
    WHERE "yyyymm" = (
        SELECT "yyyymm" FROM (
            SELECT "yyyymm", COUNT(*) AS pos_cnt
            FROM (
                SELECT "customer_id",
                       substr("txn_date",1,7) AS "yyyymm",
                       SUM(CASE
                               WHEN "txn_type"='deposit'    THEN  "txn_amount"
                               WHEN "txn_type"='withdrawal' THEN -"txn_amount"
                               ELSE 0
                           END) AS bal
                FROM "customer_transactions"
                WHERE substr("txn_date",1,4)='2020'
                GROUP BY "customer_id","yyyymm"
            )
            WHERE bal>0
            GROUP BY "yyyymm"
            ORDER BY pos_cnt ASC, "yyyymm"
            LIMIT 1
        )
    )
)
SELECT
       high_month.high_avg  AS "highest_month_avg",
       low_month.low_avg    AS "lowest_month_avg",
       high_month.high_avg - low_month.low_avg AS "avg_difference"
FROM   high_month, low_month;
