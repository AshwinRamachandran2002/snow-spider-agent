```sql
--Description: Produce each customer’s net movement (deposits-minus-withdrawals) per month in 2020
SELECT
       "customer_id",
       substr("txn_date",1,7)      AS "yyyymm",
       SUM(CASE
               WHEN "txn_type"='deposit'    THEN  "txn_amount"
               WHEN "txn_type"='withdrawal' THEN -"txn_amount"
               ELSE 0
           END)                   AS "month_end_balance"
FROM   "customer_transactions"
WHERE  substr("txn_date",1,4)='2020'
GROUP  BY "customer_id", substr("txn_date",1,7)
LIMIT 20;
```

```sql
--Description: Count how many customers finished each 2020 month with a positive balance
SELECT
       "yyyymm",
       COUNT(*) AS "positive_customer_cnt"
FROM (
        SELECT
               "customer_id",
               substr("txn_date",1,7) AS "yyyymm",
               SUM(CASE
                       WHEN "txn_type"='deposit'    THEN  "txn_amount"
                       WHEN "txn_type"='withdrawal' THEN -"txn_amount"
                       ELSE 0
                   END) AS "month_end_balance"
        FROM   "customer_transactions"
        WHERE  substr("txn_date",1,4)='2020'
        GROUP  BY "customer_id", substr("txn_date",1,7)
     )
WHERE  "month_end_balance" > 0
GROUP  BY "yyyymm"
ORDER  BY "yyyymm"
LIMIT 20;
```

```sql
--Description: Identify the 2020 month that has the maximum number of customers with a positive balance
SELECT "yyyymm", "positive_customer_cnt"
FROM (
       SELECT
              "yyyymm",
              COUNT(*) AS "positive_customer_cnt"
       FROM (
              SELECT
                     "customer_id",
                     substr("txn_date",1,7) AS "yyyymm",
                     SUM(CASE
                             WHEN "txn_type"='deposit'    THEN  "txn_amount"
                             WHEN "txn_type"='withdrawal' THEN -"txn_amount"
                             ELSE 0
                         END) AS "month_end_balance"
              FROM   "customer_transactions"
              WHERE  substr("txn_date",1,4)='2020'
              GROUP  BY "customer_id", substr("txn_date",1,7)
            )
       WHERE "month_end_balance" > 0
       GROUP  BY "yyyymm"
     )
ORDER BY "positive_customer_cnt" DESC, "yyyymm"
LIMIT 1;
```

