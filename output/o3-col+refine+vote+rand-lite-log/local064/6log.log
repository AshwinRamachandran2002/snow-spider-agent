```sql
--Description: 
-- We need, in a single statement, to
-- 1. calculate each customer's month-end balance for every month of 2020
-- 2. work out how many customers finished each month with a positive balance
-- 3. locate the month with the MOST such customers and the month with the LEAST
-- 4. compute the average month-end balance across ALL customers for each of those two months
-- 5. output the two months, their averages, and the difference between the averages
WITH month_bal AS (          -- step-1
    SELECT
        substr(txn_date,1,7)                             AS yyyymm,
        customer_id,
        SUM(CASE
                WHEN txn_type = 'deposit'     THEN  txn_amount
                WHEN txn_type = 'withdrawal'  THEN -txn_amount
                ELSE 0
            END)                                        AS bal
    FROM   customer_transactions
    WHERE  substr(txn_date,1,4) = '2020'
    GROUP  BY customer_id, substr(txn_date,1,7)
),
pos_cnt AS (                -- step-2
    SELECT yyyymm,
           COUNT(*) AS cnt
    FROM   month_bal
    WHERE  bal > 0
    GROUP  BY yyyymm
),
high_mth AS (               -- step-3a
    SELECT yyyymm
    FROM   pos_cnt
    ORDER  BY cnt DESC, yyyymm
    LIMIT  1
),
low_mth AS (                -- step-3b
    SELECT yyyymm
    FROM   pos_cnt
    ORDER  BY cnt ASC,  yyyymm
    LIMIT  1
),
avg_high AS (               -- step-4a
    SELECT AVG(bal) AS avg_bal
    FROM   month_bal
    WHERE  yyyymm = (SELECT yyyymm FROM high_mth)
),
avg_low AS (                -- step-4b
    SELECT AVG(bal) AS avg_bal
    FROM   month_bal
    WHERE  yyyymm = (SELECT yyyymm FROM low_mth)
)
SELECT
    (SELECT yyyymm  FROM high_mth)                 AS highest_month,
    (SELECT avg_bal FROM avg_high)                 AS highest_month_avg_balance,
    (SELECT yyyymm  FROM low_mth)                  AS lowest_month,
    (SELECT avg_bal FROM avg_low)                  AS lowest_month_avg_balance,
    (SELECT avg_bal FROM avg_high) -
    (SELECT avg_bal FROM avg_low)                  AS avg_balance_difference;
```
