```sql
--3) Description: For every customer & every month in 2020, work out the month-end balance  
--                (deposits are +, withdrawals are –)
SELECT
       "customer_id",
       substr("txn_date",1,7)          AS "month_yyyy_mm",
       SUM(CASE
               WHEN "txn_type"='deposit'     THEN  "txn_amount"
               WHEN "txn_type"='withdrawal'  THEN - "txn_amount"
               ELSE 0
           END)                       AS "month_end_balance"
FROM   "customer_transactions"
WHERE  "txn_date" BETWEEN '2020-01-01' AND '2020-12-31'
GROUP  BY "customer_id",
          substr("txn_date",1,7")
LIMIT 20;
```

```sql
--4) Description: Count, for each 2020 month, how many customers finished with a positive balance
WITH monthly_balances AS (
     SELECT
            "customer_id",
            substr("txn_date",1,7)   AS "month_yyyy_mm",
            SUM(CASE
                    WHEN "txn_type"='deposit'     THEN  "txn_amount"
                    WHEN "txn_type"='withdrawal'  THEN - "txn_amount"
                    ELSE 0
                END)                AS "month_end_balance"
     FROM   "customer_transactions"
     WHERE  "txn_date" BETWEEN '2020-01-01' AND '2020-12-31'
     GROUP  BY "customer_id",
               substr("txn_date",1,7")
)
SELECT  "month_yyyy_mm",
        COUNT(*)    AS "customers_w_positive_balance"
FROM    monthly_balances
WHERE   "month_end_balance" > 0
GROUP   BY "month_yyyy_mm"
ORDER   BY "customers_w_positive_balance" DESC
LIMIT 20;
```

```sql
--5) Description: Identify the month having the highest and the one having the lowest
WITH monthly_positive AS (
     SELECT  "month_yyyy_mm",
             COUNT(*) AS pos_cnt
     FROM   (
         SELECT
                "customer_id",
                substr("txn_date",1,7) AS "month_yyyy_mm",
                SUM(CASE
                        WHEN "txn_type"='deposit'     THEN  "txn_amount"
                        WHEN "txn_type"='withdrawal'  THEN - "txn_amount"
                        ELSE 0
                    END) AS bal
         FROM "customer_transactions"
         WHERE "txn_date" BETWEEN '2020-01-01' AND '2020-12-31'
         GROUP BY "customer_id", substr("txn_date",1,7")
         HAVING bal > 0
     )
     GROUP BY "month_yyyy_mm"
)
SELECT *
FROM   monthly_positive
WHERE  pos_cnt = (SELECT MAX(pos_cnt) FROM monthly_positive)
   OR  pos_cnt = (SELECT MIN(pos_cnt) FROM monthly_positive)
LIMIT 20;
```

```sql
--6) Description: Average month-end balance for ONLY those two extreme months
WITH monthly_balances AS (
     SELECT
            "customer_id",
            substr("txn_date",1,7) AS "month_yyyy_mm",
            SUM(CASE
                    WHEN "txn_type"='deposit'     THEN  "txn_amount"
                    WHEN "txn_type"='withdrawal'  THEN - "txn_amount"
                    ELSE 0
                END) AS "month_end_balance"
     FROM   "customer_transactions"
     WHERE  "txn_date" BETWEEN '2020-01-01' AND '2020-12-31'
     GROUP  BY "customer_id", substr("txn_date",1,7")
),
extreme_months AS (
     SELECT  "month_yyyy_mm"
     FROM   (
        SELECT "month_yyyy_mm",
               COUNT(*) AS pos_cnt
        FROM   monthly_balances
        WHERE  "month_end_balance" > 0
        GROUP  BY "month_yyyy_mm"
     )
     WHERE  pos_cnt = (SELECT MAX(pos_cnt) FROM (
                          SELECT COUNT(*) AS pos_cnt
                          FROM monthly_balances
                          WHERE "month_end_balance" > 0
                          GROUP BY "month_yyyy_mm"))
        OR  pos_cnt = (SELECT MIN(pos_cnt) FROM (
                          SELECT COUNT(*) AS pos_cnt
                          FROM monthly_balances
                          WHERE "month_end_balance" > 0
                          GROUP BY "month_yyyy_mm"))
)
SELECT  e."month_yyyy_mm",
        AVG(m."month_end_balance") AS avg_month_end_balance
FROM    extreme_months  e
JOIN    monthly_balances m
       ON e."month_yyyy_mm" = m."month_yyyy_mm"
GROUP   BY e."month_yyyy_mm"
LIMIT 20;
```

```sql
--7) Description: Show the final requested value – the difference between the two averages
WITH monthly_balances AS (
     SELECT
            "customer_id",
            substr("txn_date",1,7) AS "month_yyyy_mm",
            SUM(CASE
                    WHEN "txn_type"='deposit'     THEN  "txn_amount"
                    WHEN "txn_type"='withdrawal'  THEN - "txn_amount"
                    ELSE 0
                END) AS "month_end_balance"
     FROM   "customer_transactions"
     WHERE  "txn_date" BETWEEN '2020-01-01' AND '2020-12-31'
     GROUP  BY "customer_id", substr("txn_date",1,7")
),
positive_counts AS (
     SELECT  "month_yyyy_mm",
             COUNT(*) AS pos_cnt
     FROM    monthly_balances
     WHERE   "month_end_balance" > 0
     GROUP   BY "month_yyyy_mm"
),
hi_lo AS (
     SELECT "month_yyyy_mm"
     FROM   positive_counts
     WHERE  pos_cnt = (SELECT MAX(pos_cnt) FROM positive_counts)
        OR  pos_cnt = (SELECT MIN(pos_cnt) FROM positive_counts)
),
avg_balance AS (
     SELECT  "month_yyyy_mm",
             AVG("month_end_balance") AS avg_bal
     FROM    monthly_balances
     WHERE   "month_yyyy_mm" IN (SELECT "month_yyyy_mm" FROM hi_lo)
     GROUP   BY "month_yyyy_mm"
)
SELECT  MAX(avg_bal) - MIN(avg_bal)  AS difference_between_averages
FROM    avg_balance
LIMIT 20;
```

The last query returns one row containing the required difference between the average month-end balances of:
• the 2020 month with the most customers having a positive ending balance, and  
• the 2020 month with the fewest such customers.
