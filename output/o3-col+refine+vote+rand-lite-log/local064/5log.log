```sql
--Description: Single-step solution (with inline thinking) to
--  1) build each customer’s month-end balance for every 2020 month,
--  2) find the month with the MOST customers finishing positive
--     and the month with the LEAST customers finishing positive,
--  3) calculate each of those months’ average month-end balance across ALL customers,
--  4) return both months, their averages, and the difference between the averages.
WITH monthly_balances AS (        -- step-1: net balance per customer per month
     SELECT
            customer_id,
            substr(txn_date,1,7)                AS month_yyyy_mm,
            SUM(CASE
                    WHEN txn_type='deposit'    THEN  txn_amount
                    WHEN txn_type='withdrawal' THEN -txn_amount
                    ELSE 0
                END)                           AS month_end_balance
     FROM   customer_transactions
     WHERE  txn_date BETWEEN '2020-01-01' AND '2020-12-31'
     GROUP  BY customer_id, substr(txn_date,1,7)
),
positive_counts AS (              -- step-2: count of customers >0 by month
     SELECT month_yyyy_mm,
            COUNT(*) AS pos_cnt
     FROM   monthly_balances
     WHERE  month_end_balance > 0
     GROUP  BY month_yyyy_mm
),
hi_month AS (                     -- step-3a: month with MOST positive customers
     SELECT month_yyyy_mm AS month_hi
     FROM   positive_counts
     ORDER  BY pos_cnt DESC, month_yyyy_mm        -- tie-break with earliest month
     LIMIT 1
),
lo_month AS (                     -- step-3b: month with LEAST positive customers
     SELECT month_yyyy_mm AS month_lo
     FROM   positive_counts
     ORDER  BY pos_cnt ASC, month_yyyy_mm
     LIMIT 1
),
avg_balances AS (                 -- step-4: average balance for every month
     SELECT month_yyyy_mm,
            AVG(month_end_balance) AS avg_bal
     FROM   monthly_balances
     GROUP  BY month_yyyy_mm
)
SELECT
       (SELECT month_hi FROM hi_month)                               AS month_with_most_positive,
       (SELECT avg_bal  FROM avg_balances
         WHERE month_yyyy_mm = (SELECT month_hi FROM hi_month))      AS avg_balance_most,
       (SELECT month_lo FROM lo_month)                               AS month_with_least_positive,
       (SELECT avg_bal  FROM avg_balances
         WHERE month_yyyy_mm = (SELECT month_lo FROM lo_month))      AS avg_balance_least,
       ( (SELECT avg_bal FROM avg_balances
            WHERE month_yyyy_mm = (SELECT month_hi FROM hi_month))
         -
         (SELECT avg_bal FROM avg_balances
            WHERE month_yyyy_mm = (SELECT month_lo FROM lo_month)) ) AS difference_between_averages;
```
