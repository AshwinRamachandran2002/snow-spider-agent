```sql
-- 4. Month-end balance for every customer & month in 2020 (sample 20 rows)
SELECT  "customer_id",
        substr("txn_date",1,7)                             AS "month_yr",
        SUM(CASE WHEN "txn_type"='deposit'
                 THEN  "txn_amount"
                 ELSE - "txn_amount" END)                 AS "month_end_balance"
FROM    "customer_transactions"
WHERE   "txn_date" LIKE '2020-%'
GROUP BY "customer_id", "month_yr"
LIMIT 20;
```

```sql
-- 5. Count of customers with a positive month-end balance for each month of 2020
SELECT  "month_yr",
        COUNT(*) AS "positive_custs"
FROM   (
        SELECT  "customer_id",
                substr("txn_date",1,7) AS "month_yr",
                SUM(CASE WHEN "txn_type"='deposit'
                         THEN  "txn_amount"
                         ELSE - "txn_amount" END) AS "balance"
        FROM    "customer_transactions"
        WHERE   "txn_date" LIKE '2020-%'
        GROUP BY "customer_id", "month_yr"
        HAVING  "balance" > 0
       )
GROUP BY "month_yr"
ORDER BY "positive_custs" DESC
LIMIT 20;
```

```sql
