```sql
-- 8. Average month-end balance and positive-customer count for every month of 2020
SELECT  "month_yr",
        SUM(CASE WHEN "balance" > 0 THEN 1 ELSE 0 END)            AS "positive_custs",
        AVG("balance")                                            AS "avg_month_end_balance"
FROM   (
        SELECT  "customer_id",
                substr("txn_date",1,7) AS "month_yr",
                SUM(CASE WHEN "txn_type"='deposit'
                         THEN  "txn_amount"
                         ELSE - "txn_amount" END) AS "balance"
        FROM    "customer_transactions"
        WHERE   "txn_date" LIKE '2020-%'
        GROUP BY "customer_id", "month_yr"
       )
GROUP BY "month_yr"
ORDER BY "positive_custs" DESC
LIMIT 20;
```

```sql
-- 9. Combine everything: highest-positive and lowest-positive months,
--    their average balances, and the difference between those averages
WITH month_stats AS (
      SELECT  "month_yr",
              SUM(CASE WHEN "balance" > 0 THEN 1 ELSE 0 END)  AS positive_custs,
              AVG("balance")                                  AS avg_balance
      FROM   (
              SELECT  "customer_id",
                      substr("txn_date",1,7) AS "month_yr",
                      SUM(CASE WHEN "txn_type"='deposit'
                               THEN  "txn_amount"
                               ELSE - "txn_amount" END) AS "balance"
              FROM    "customer_transactions"
              WHERE   "txn_date" LIKE '2020-%'
              GROUP BY "customer_id", "month_yr"
             )
      GROUP BY "month_yr"
),
max_min AS (
      SELECT *
      FROM   month_stats
      WHERE  positive_custs = (SELECT MAX(positive_custs) FROM month_stats)
         OR  positive_custs = (SELECT MIN(positive_custs) FROM month_stats)
)
SELECT  MAX(CASE WHEN positive_custs = (SELECT MAX(positive_custs) FROM month_stats)
                 THEN avg_balance END)   AS highest_month_avg_balance,
        MAX(CASE WHEN positive_custs = (SELECT MIN(positive_custs) FROM month_stats)
                 THEN avg_balance END)   AS lowest_month_avg_balance,
        MAX(CASE WHEN positive_custs = (SELECT MAX(positive_custs) FROM month_stats)
                 THEN avg_balance END) -
        MAX(CASE WHEN positive_custs = (SELECT MIN(positive_custs) FROM month_stats)
                 THEN avg_balance END)   AS difference_between_averages
FROM    max_min;
```

```sql
-- 10. Quick check: list the two specific months, their positive-customer counts
--     and average balances side-by-side (helps verify the final numbers)
WITH month_stats AS (
      SELECT  "month_yr",
              SUM(CASE WHEN "balance" > 0 THEN 1 ELSE 0 END)  AS positive_custs,
              AVG("balance")                                  AS avg_balance
      FROM   (
              SELECT  "customer_id",
                      substr("txn_date",1,7) AS "month_yr",
                      SUM(CASE WHEN "txn_type"='deposit'
                               THEN  "txn_amount"
                               ELSE - "txn_amount" END) AS "balance"
              FROM    "customer_transactions"
              WHERE   "txn_date" LIKE '2020-%'
              GROUP BY "customer_id", "month_yr"
             )
      GROUP BY "month_yr"
)
SELECT *
FROM   month_stats
WHERE  positive_custs = (SELECT MAX(positive_custs) FROM month_stats)
   OR  positive_custs = (SELECT MIN(positive_custs) FROM month_stats)
LIMIT 20;
```
