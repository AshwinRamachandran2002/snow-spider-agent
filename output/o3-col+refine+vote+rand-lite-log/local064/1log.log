```sql
--Description: End-to-end solution in ONE statement.
-- 1) month_balances  : signed deposits (+) and withdrawals (–) summed per customer & month.
-- 2) pos_cnt         : positive-balance customer counts per month.
-- 3) hi_lo_months    : finds the month with the highest positive count (hi_month) and
--                      the month with the lowest positive count (lo_month).
-- 4) avg_by_month    : average month-end balance for every month.
-- 5) final_select    : returns, in a single row, the two target months,
--                      their positive-customer counts, their average balances,
--                      and the difference between the two averages.
WITH month_balances AS (
     SELECT
            customer_id,
            substr(txn_date,1,7) AS month,
            SUM(CASE
                    WHEN txn_type = 'deposit'    THEN  txn_amount
                    WHEN txn_type = 'withdrawal' THEN -txn_amount
                    ELSE 0
                END)            AS month_end_balance
     FROM   customer_transactions
     WHERE  substr(txn_date,1,4) = '2020'
     GROUP  BY customer_id,
              substr(txn_date,1,7)
),
pos_cnt AS (
     SELECT month,
            COUNT(*) AS positive_cust_cnt
     FROM   month_balances
     WHERE  month_end_balance > 0
     GROUP  BY month
),
hi_lo_months AS (
     SELECT 
            (SELECT month FROM pos_cnt ORDER BY positive_cust_cnt DESC, month LIMIT 1) AS hi_month,
            (SELECT positive_cust_cnt FROM pos_cnt ORDER BY positive_cust_cnt DESC, month LIMIT 1) AS hi_cnt,
            (SELECT month FROM pos_cnt ORDER BY positive_cust_cnt ASC,  month LIMIT 1) AS lo_month,
            (SELECT positive_cust_cnt FROM pos_cnt ORDER BY positive_cust_cnt ASC,  month LIMIT 1) AS lo_cnt
),
avg_by_month AS (
     SELECT month,
            AVG(month_end_balance) AS avg_bal
     FROM   month_balances
     GROUP  BY month
)
SELECT 
       h.hi_month,
       h.hi_cnt                AS hi_positive_customers,
       a1.avg_bal              AS hi_avg_balance,
       h.lo_month,
       h.lo_cnt                AS lo_positive_customers,
       a2.avg_bal              AS lo_avg_balance,
       a1.avg_bal - a2.avg_bal AS avg_balance_difference
FROM   hi_lo_months AS h
JOIN   avg_by_month AS a1 ON a1.month = h.hi_month
JOIN   avg_by_month AS a2 ON a2.month = h.lo_month;
```
