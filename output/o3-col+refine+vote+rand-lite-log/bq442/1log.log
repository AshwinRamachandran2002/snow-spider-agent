```sql
--Description: 2) Show the 20 orders with the highest closing prices (StrikePrice)
SELECT `OrderID`, `StrikePrice`
FROM   `bigquery-public-data.cymbal_investments.trade_capture_report`
ORDER  BY `StrikePrice` DESC
LIMIT  20;
```

```sql
--Description: 3) Peek at TargetCompID and a derived 4-character code that will become an algorithm flag
SELECT DISTINCT `TargetCompID`,
       SUBSTR(`TargetCompID`, 1, 4) AS tgt_prefix
FROM   `bigquery-public-data.cymbal_investments.trade_capture_report`
LIMIT  20;
```

```sql
--Description: 4) Map the first four characters of TargetCompID to a readable algorithm name
SELECT `OrderID`,
       CASE SUBSTR(`TargetCompID`,1,4)
            WHEN 'MOMO' THEN 'Momentum'
            WHEN 'LUCK' THEN 'Feeling Lucky'
            WHEN 'PRED' THEN 'Prediction'
       END AS algorithm,
       `StrikePrice`
FROM   `bigquery-public-data.cymbal_investments.trade_capture_report`
ORDER  BY `StrikePrice` DESC
LIMIT  20;
```

```sql
--Description: 5) Unnest the Sides array to see raw directions attached to each order
SELECT t.`OrderID`,
       s.`Side`
FROM   `bigquery-public-data.cymbal_investments.trade_capture_report` AS t
CROSS  JOIN UNNEST(t.`Sides`) AS s
LIMIT  20;
```

```sql
--Description: 6) Distinct list of trade directions that exist in the dataset
SELECT DISTINCT s.`Side` AS tradeDirection
FROM   `bigquery-public-data.cymbal_investments.trade_capture_report` AS t
CROSS  JOIN UNNEST(t.`Sides`) AS s
LIMIT  20;
```

```sql
--Description: 7) Add a numeric multiplier derived from the trade direction
SELECT t.`OrderID`,
       s.`Side`                                AS tradeDirection,
       CASE s.`Side`
            WHEN 'SHORT' THEN -1
            WHEN 'LONG'  THEN  1
       END                                      AS tradeMultiplier,
       t.`StrikePrice`
FROM   `bigquery-public-data.cymbal_investments.trade_capture_report` AS t
CROSS  JOIN UNNEST(t.`Sides`) AS s
ORDER  BY t.`StrikePrice` DESC
LIMIT  20;
```

```sql
--Description: 8) Gather all fields needed for the final answer; still show top 20 by closing price
SELECT t.`OrderID`                              AS tradeID,
       t.`MaturityDate`                         AS tradeTimestamp,
       CASE SUBSTR(t.`TargetCompID`,1,4)
            WHEN 'MOMO' THEN 'Momentum'
            WHEN 'LUCK' THEN 'Feeling Lucky'
            WHEN 'PRED' THEN 'Prediction'
       END                                      AS algorithm,
       t.`Symbol`                               AS symbol,
       t.`LastPx`                               AS openPrice,
       t.`StrikePrice`                          AS closePrice,
       s.`Side`                                 AS tradeDirection,
       CASE s.`Side` WHEN 'SHORT' THEN -1 WHEN 'LONG' THEN 1 END AS tradeMultiplier
FROM   `bigquery-public-data.cymbal_investments.trade_capture_report` AS t
CROSS  JOIN UNNEST(t.`Sides`) AS s
ORDER  BY closePrice DESC
LIMIT  20;
```

```sql
--Description: 9) Use ROW_NUMBER to isolate the 6 highest-priced trades (qualified, but keep LIMIT 20)
SELECT *
FROM  (
       SELECT t.`OrderID`                              AS tradeID,
              t.`MaturityDate`                         AS tradeTimestamp,
              CASE SUBSTR(t.`TargetCompID`,1,4)
                   WHEN 'MOMO' THEN 'Momentum'
                   WHEN 'LUCK' THEN 'Feeling Lucky'
                   WHEN 'PRED' THEN 'Prediction'
              END                                      AS algorithm,
              t.`Symbol`                               AS symbol,
              t.`LastPx`                               AS openPrice,
              t.`StrikePrice`                          AS closePrice,
              s.`Side`                                 AS tradeDirection,
              CASE s.`Side` WHEN 'SHORT' THEN -1 WHEN 'LONG' THEN 1 END AS tradeMultiplier,
              ROW_NUMBER() OVER (ORDER BY t.`StrikePrice` DESC) AS rn
       FROM   `bigquery-public-data.cymbal_investments.trade_capture_report` AS t
       CROSS  JOIN UNNEST(t.`Sides`) AS s
)
WHERE  rn <= 6
LIMIT  20;
```

```sql
--Description: 10) FINAL ANSWER – the top 6 trade reports with the highest closing prices, formatted per specification
SELECT t.`OrderID`                              AS tradeID,
       t.`MaturityDate`                         AS tradeTimestamp,
       CASE SUBSTR(t.`TargetCompID`,1,4)
            WHEN 'MOMO' THEN 'Momentum'
            WHEN 'LUCK' THEN 'Feeling Lucky'
            WHEN 'PRED' THEN 'Prediction'
       END                                      AS algorithm,
       t.`Symbol`                               AS symbol,
       t.`LastPx`                               AS openPrice,
       t.`StrikePrice`                          AS closePrice,
       s.`Side`                                 AS tradeDirection,
       CASE s.`Side` WHEN 'SHORT' THEN -1 WHEN 'LONG' THEN 1 END AS tradeMultiplier
FROM   `bigquery-public-data.cymbal_investments.trade_capture_report` AS t
CROSS  JOIN UNNEST(t.`Sides`) AS s
QUALIFY ROW_NUMBER() OVER (ORDER BY t.`StrikePrice` DESC) <= 6
LIMIT  20;
```
