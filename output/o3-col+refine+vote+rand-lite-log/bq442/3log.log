FROM `bigquery-public-data`.`cymbal_investments`.`trade_capture_report`,
UNNEST(`Sides`) AS s
LIMIT 20;
```

```sql
--Description: Pair each trade with its direction by unnesting the Sides column
SELECT 
  `TradeReportID`,
  `StrikePrice`,
  s.Side AS tradeDirection
FROM `bigquery-public-data`.`cymbal_investments`.`trade_capture_report`,
UNNEST(`Sides`) AS s
LIMIT 20;
```

```sql
--Description: Build the core field list (incl. algorithm mapping & multiplier) without filtering
SELECT 
  `OrderID`                                   AS tradeID,
  `MaturityDate`                              AS tradeTimestamp,
  CASE
    WHEN SUBSTR(`TargetCompID`, 1, 4) = 'MOMO' THEN 'Momentum'
    WHEN SUBSTR(`TargetCompID`, 1, 4) = 'LUCK' THEN 'Feeling Lucky'
    WHEN SUBSTR(`TargetCompID`, 1, 4) = 'PRED' THEN 'Prediction'
    ELSE 'Unknown'
  END                                          AS algorithm,
  `Symbol`                                     AS symbol,
  `LastPx`                                     AS openPrice,
  `StrikePrice`                                AS closePrice,
  s.Side                                       AS tradeDirection,
  CASE 
    WHEN s.Side = 'SHORT' THEN -1 
    WHEN s.Side = 'LONG'  THEN  1 
  END                                          AS tradeMultiplier
FROM `bigquery-public-data`.`cymbal_investments`.`trade_capture_report` AS t
CROSS JOIN UNNEST(t.`Sides`) AS s
LIMIT 20;
```

```sql
--Description: Order by closing price to see which trades have the highest closePrice values
SELECT 
  `TradeReportID`,
  `StrikePrice` AS closePrice
FROM `bigquery-public-data`.`cymbal_investments`.`trade_capture_report`
ORDER BY closePrice DESC
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – return the six trade reports with the highest closing prices and all requested fields
SELECT 
  t.`OrderID`                                  AS tradeID,
  t.`MaturityDate`                             AS tradeTimestamp,
  CASE
    WHEN SUBSTR(t.`TargetCompID`, 1, 4) = 'MOMO' THEN 'Momentum'
    WHEN SUBSTR(t.`TargetCompID`, 1, 4) = 'LUCK' THEN 'Feeling Lucky'
    WHEN SUBSTR(t.`TargetCompID`, 1, 4) = 'PRED' THEN 'Prediction'
    ELSE 'Unknown'
  END                                          AS algorithm,
  t.`Symbol`                                   AS symbol,
  t.`LastPx`                                   AS openPrice,
  t.`StrikePrice`                              AS closePrice,
  s.Side                                       AS tradeDirection,
  CASE 
    WHEN s.Side = 'SHORT' THEN -1 
    WHEN s.Side = 'LONG'  THEN  1 
  END                                          AS tradeMultiplier
FROM `bigquery-public-data`.`cymbal_investments`.`trade_capture_report` AS t
CROSS JOIN UNNEST(t.`Sides`) AS s
ORDER BY closePrice DESC
LIMIT 6;
```
