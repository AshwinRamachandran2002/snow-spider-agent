```

```sql
--Description: 2) Look at the distinct trading symbols that appear in the dataset.
SELECT DISTINCT `Symbol`
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
LIMIT 20;
```

```sql
--Description: 3) Inspect the distinct first-four-character “algorithm codes” inside `TargetCompID`.
SELECT DISTINCT SUBSTR(`TargetCompID`,1,4) AS algorithm_code
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
LIMIT 20;
```

```sql
--Description: 4) Unnest the `Sides` array to view the raw side/direction values that exist.
SELECT
  s.Side,
  s.OrderID
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
     UNNEST(`Sides`) AS s
LIMIT 20;
```

```sql
--Description: 5) Show the relationship between an order’s identifier, strike (close) price, and last (open) price.
SELECT
  `OrderID`,
  `LastPx`   AS openPrice,
  `StrikePrice` AS closePrice
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
LIMIT 20;
```

```sql
--Description: 6) Combine table columns with the unnested side to compute a numeric trade-multiplier (+1/-1).
SELECT
  t.`OrderID`,
  s.Side                                                       AS tradeDirection,
  CASE WHEN UPPER(s.Side) = 'SHORT' THEN -1 ELSE 1 END        AS tradeMultiplier,
  t.`StrikePrice`
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t
JOIN UNNEST(t.`Sides`) AS s
LIMIT 20;
```

```sql
--Description: 7) Create the derived “algorithm” field from `TargetCompID`.
SELECT
  `TargetCompID`,
  CASE
    WHEN SUBSTR(`TargetCompID`,1,4) = 'MOMO' THEN 'Momentum'
    WHEN SUBSTR(`TargetCompID`,1,4) = 'LUCK' THEN 'Feeling Lucky'
    WHEN SUBSTR(`TargetCompID`,1,4) = 'PRED' THEN 'Prediction'
    ELSE 'Unknown'
  END AS algorithm
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
LIMIT 20;
```

```sql
--Description: 8) Put all derived columns together in one view (tradeID, timestamp, prices, direction, algorithm).
SELECT
  t.`OrderID`                         AS tradeID,
  t.`MaturityDate`                    AS tradeTimestamp,
  CASE
    WHEN SUBSTR(t.`TargetCompID`,1,4) = 'MOMO' THEN 'Momentum'
    WHEN SUBSTR(t.`TargetCompID`,1,4) = 'LUCK' THEN 'Feeling Lucky'
    WHEN SUBSTR(t.`TargetCompID`,1,4) = 'PRED' THEN 'Prediction'
    ELSE 'Unknown'
  END                                  AS algorithm,
  t.`Symbol`                          AS symbol,
  t.`LastPx`                          AS openPrice,
  t.`StrikePrice`                     AS closePrice,
  s.Side                              AS tradeDirection,
  CASE WHEN UPPER(s.Side) = 'SHORT' THEN -1 ELSE 1 END  AS tradeMultiplier
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t
JOIN UNNEST(t.`Sides`) AS s
LIMIT 20;
```

```sql
--Description: 9) FINAL ANSWER – list the six trade reports with the highest closing (strike) prices, along with all requested fields.
SELECT
  t.`OrderID`                         AS tradeID,
  t.`MaturityDate`                    AS tradeTimestamp,
  CASE
    WHEN SUBSTR(t.`TargetCompID`,1,4) = 'MOMO' THEN 'Momentum'
    WHEN SUBSTR(t.`TargetCompID`,1,4) = 'LUCK' THEN 'Feeling Lucky'
    WHEN SUBSTR(t.`TargetCompID`,1,4) = 'PRED' THEN 'Prediction'
    ELSE 'Unknown'
  END                                  AS algorithm,
  t.`Symbol`                          AS symbol,
  t.`LastPx`                          AS openPrice,
  t.`StrikePrice`                     AS closePrice,
  s.Side                              AS tradeDirection,
  CASE WHEN UPPER(s.Side) = 'SHORT' THEN -1 ELSE 1 END  AS tradeMultiplier
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t
JOIN UNNEST(t.`Sides`) AS s
ORDER BY closePrice DESC
LIMIT 6;
```
