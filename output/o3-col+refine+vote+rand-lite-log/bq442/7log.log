Query:
--Description: 8) Put all derived columns together in one view (tradeID, timestamp, prices, direction, algorithm).
SELECT
  t.`OrderID`                         AS tradeID,
  t.`MaturityDate`                    AS tradeTimestamp,
  CASE
    WHEN SUBSTR(t.`TargetCompID`,1,4) = 'MOMO' THEN 'Momentum'
    WHEN SUBSTR(t.`TargetCompID`,1,4) = 'LUCK' THEN 'Feeling Lucky'
    WHEN SUBSTR(t.`TargetCompID`,1,4) = 'PRED' THEN 'Prediction'
    ELSE 'Unknown'
  END                                  AS algorithm,
  t.`Symbol`                          AS symbol,
  t.`LastPx`                          AS openPrice,
  t.`StrikePrice`                     AS closePrice,
  s.Side                              AS tradeDirection,
  CASE WHEN UPPER(s.Side) = 'SHORT' THEN -1 ELSE 1 END  AS tradeMultiplier
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t
JOIN UNNEST(t.`Sides`) AS s
LIMIT 20;
Answer:
tradeID,tradeTimestamp,algorithm,symbol,openPrice,closePrice,tradeDirection,tradeMultiplier
