```sql
--Description: Fetch basic identifiers: order (trade) ID and its maturity timestamp.
SELECT
  `OrderID`      AS tradeID,
  `MaturityDate` AS tradeTimestamp
FROM
  `bigquery-public-data.cymbal_investments.trade_capture_report`
LIMIT 20;
```

```sql
--Description: Unnest the Sides array to expose the trade direction for each order.
SELECT
  tr.`OrderID` AS tradeID,
  s.Side       AS tradeDirection
FROM
  `bigquery-public-data.cymbal_investments.trade_capture_report` AS tr,
  UNNEST(tr.Sides) AS s
LIMIT 20;
```

```sql
--Description: Derive a numeric multiplier (+1 / ‑1) from the trade direction.
SELECT
  tr.`OrderID`                         AS tradeID,
  s.Side                               AS tradeDirection,
  CASE
    WHEN s.Side = 'SHORT' THEN -1
    WHEN s.Side = 'LONG'  THEN  1
  END                                  AS tradeMultiplier
FROM
  `bigquery-public-data.cymbal_investments.trade_capture_report` AS tr,
  UNNEST(tr.Sides) AS s
LIMIT 20;
```

```sql
--Description: Map TargetCompID prefixes to their corresponding trading algorithms.
SELECT
  `TargetCompID`,
  CASE SUBSTR(`TargetCompID`, 1, 4)
    WHEN 'MOMO' THEN 'Momentum'
    WHEN 'LUCK' THEN 'Feeling Lucky'
    WHEN 'PRED' THEN 'Prediction'
    ELSE 'Unknown'
  END AS algorithm
FROM
  `bigquery-public-data.cymbal_investments.trade_capture_report`
LIMIT 20;
```

```sql
--Description: Assemble all derived fields for inspection on a small sample.
SELECT
  tr.OrderID                                           AS tradeID,
