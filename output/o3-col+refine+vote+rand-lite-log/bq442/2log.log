```sql
--Description: Map the first four characters of TargetCompID into human-readable algorithm names  
SELECT  
  TargetCompID,  
  SUBSTR(TargetCompID,1,4) AS algo_code,  
  CASE
    WHEN SUBSTR(TargetCompID,1,4) = 'MOMO' THEN 'Momentum'
    WHEN SUBSTR(TargetCompID,1,4) = 'LUCK' THEN 'Feeling Lucky'
    WHEN SUBSTR(TargetCompID,1,4) = 'PRED' THEN 'Prediction'
    ELSE 'Unknown'
  END AS algorithm  
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`  
LIMIT 20;
```

```sql
--Description: Inspect the nested Sides array to confirm how trade direction is stored  
SELECT  
  OrderID,  
  s.Side AS tradeDirection,  
  s.OrderID AS sideOrderID  
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,  
     UNNEST(Sides) AS s  
LIMIT 20;
```

```sql
--Description: Derive tradeMultiplier (1 for LONG, −1 for SHORT) from the trade direction  
SELECT  
  s.Side AS tradeDirection,  
  CASE WHEN s.Side = 'SHORT' THEN -1 WHEN s.Side = 'LONG' THEN 1 END AS tradeMultiplier  
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,  
     UNNEST(Sides) AS s  
LIMIT 20;
```

```sql
--Description: Gather all fields needed for the final answer and preview a few rows  
SELECT  
  OrderID                         AS tradeID,  
  MaturityDate                    AS tradeTimestamp,  
  CASE
    WHEN SUBSTR(TargetCompID,1,4)='MOMO' THEN 'Momentum'
    WHEN SUBSTR(TargetCompID,1,4)='LUCK' THEN 'Feeling Lucky'
    WHEN SUBSTR(TargetCompID,1,4)='PRED' THEN 'Prediction'
    ELSE 'Unknown'
  END                             AS algorithm,  
  Symbol                          AS symbol,  
  LastPx                          AS openPrice,  
  StrikePrice                     AS closePrice,  
  s.Side                          AS tradeDirection,  
  CASE WHEN s.Side='SHORT' THEN -1 WHEN s.Side='LONG' THEN 1 END  
                                    AS tradeMultiplier  
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,  
     UNNEST(Sides) AS s  
LIMIT 20;
```

```sql
--Description: Order trades by closing price (StrikePrice) to see the highest-priced trades  
SELECT  
  OrderID       AS tradeID,  
  StrikePrice   AS closePrice  
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`  
ORDER BY closePrice DESC  
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – top 6 trade reports with the highest closing prices (StrikePrice)  
SELECT  
  OrderID                         AS tradeID,              -- unique trade identifier  
  MaturityDate                    AS tradeTimestamp,       -- trade maturity timestamp  
  CASE                                                     
    WHEN SUBSTR(TargetCompID,1,4)='MOMO' THEN 'Momentum'   
    WHEN SUBSTR(TargetCompID,1,4)='LUCK' THEN 'Feeling Lucky'  
    WHEN SUBSTR(TargetCompID,1,4)='PRED' THEN 'Prediction' 
    ELSE 'Unknown'                                         
  END                             AS algorithm,  
  Symbol                          AS symbol,               -- financial instrument  
  LastPx                          AS openPrice,            -- opening price  
  StrikePrice                     AS closePrice,           -- closing price  
  s.Side                          AS tradeDirection,       -- LONG / SHORT  
  CASE WHEN s.Side='SHORT' THEN -1 WHEN s.Side='LONG' THEN 1 END  
                                    AS tradeMultiplier  
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,  
     UNNEST(Sides) AS s  
ORDER BY closePrice DESC  
LIMIT 6;
```
