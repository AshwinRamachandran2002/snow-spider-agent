```sql
--Description: 
-- Goal: return the six trades with the highest closing prices (“closePrice” = StrikePrice).  
-- Steps / thinking process:  
--   1. Use StrikePrice for sorting because it represents the closing price.  
--   2. Derive “algorithm” from the first four characters of TargetCompID.  
--   3. UNNEST the Sides array to expose the trade direction (LONG / SHORT).  
--   4. Create tradeMultiplier: 1 for LONG, –1 for SHORT.  
--   5. Select the required fields, order by closePrice descending, limit to 6 rows.  
SELECT
  t.OrderID  AS tradeID,
  t.MaturityDate AS tradeTimestamp,
  CASE
    WHEN SUBSTR(t.TargetCompID, 1, 4) = 'MOMO' THEN 'Momentum'
    WHEN SUBSTR(t.TargetCompID, 1, 4) = 'LUCK' THEN 'Feeling Lucky'
    WHEN SUBSTR(t.TargetCompID, 1, 4) = 'PRED' THEN 'Prediction'
    ELSE 'Unknown'
  END AS algorithm,
  t.Symbol        AS symbol,
  t.LastPx        AS openPrice,
  t.StrikePrice   AS closePrice,
  s.Side          AS tradeDirection,
  CASE WHEN s.Side = 'SHORT' THEN -1 ELSE 1 END AS tradeMultiplier
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t
CROSS JOIN UNNEST(t.Sides) AS s
ORDER BY closePrice DESC
LIMIT 6;
```
