Query:
--Description: Derive tradeMultiplier (1 for LONG, −1 for SHORT) from the trade direction
SELECT
  s.Side AS tradeDirection,
  CASE WHEN s.Side = 'SHORT' THEN -1 WHEN s.Side = 'LONG' THEN 1 END AS tradeMultiplier
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t
CROSS JOIN UNNEST(t.Sides) AS s
LIMIT 20
