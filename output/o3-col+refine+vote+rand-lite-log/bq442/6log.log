Query:
--Description: Derive a numeric multiplier (-1 or 1) from the trade direction (SHORT or LONG)
SELECT DISTINCT
  s.Side                                           AS tradeDirection,
  CASE WHEN s.Side = 'SHORT' THEN -1
       WHEN s.Side = 'LONG'  THEN  1
  END                                              AS tradeMultiplier
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
UNNEST(`Sides`) AS s
LIMIT 20;
