```sql
--Description: Preview the different trading symbols available in the trade-capture report
SELECT DISTINCT
  `Symbol`
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
LIMIT 20;
```

```sql
--Description: Inspect the variety of closing prices (StrikePrice) in descending order
SELECT DISTINCT
  `StrikePrice`   AS closePrice
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
ORDER BY closePrice DESC
LIMIT 20;
```

```sql
--Description: Show the 20 trades with the highest closing prices together with their IDs and symbols
SELECT
  `TradeReportID` AS tradeID,
  `Symbol`,
  `StrikePrice`   AS closePrice
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
ORDER BY closePrice DESC
LIMIT 20;
```

```sql
--Description: Map each TargetCompID prefix to its corresponding execution algorithm
SELECT DISTINCT
  `TargetCompID`,
  CASE
    WHEN LEFT(`TargetCompID`,4) = 'MOMO' THEN 'Momentum'
    WHEN LEFT(`TargetCompID`,4) = 'LUCK' THEN 'Feeling Lucky'
    WHEN LEFT(`TargetCompID`,4) = 'PRED' THEN 'Prediction'
    ELSE 'Other'
  END AS algorithm
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
LIMIT 20;
```

```sql
--Description: Unnest the Sides array to view the trade direction (Side) and related OrderID
SELECT DISTINCT
  s.Side          AS tradeDirection,
  s.OrderID
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
UNNEST(`Sides`) AS s
LIMIT 20;
```

```sql
--Description: Derive a numeric multiplier (-1 or 1) from the trade direction (SHORT or LONG)
SELECT DISTINCT
  s.Side                                           AS tradeDirection,
  CASE WHEN s.Side = 'SHORT' THEN -1
       WHEN s.Side = 'LONG'  THEN  1
  END                                              AS tradeMultiplier
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
UNNEST(`Sides`) AS s
LIMIT 20;
```

```sql
--Description: Combine algorithm, direction, multiplier, and price fields for a quick multi-column preview
SELECT
  t.TradeReportID                                  AS tradeID,
  t.MaturityDate                                   AS tradeTimestamp,
  CASE
    WHEN LEFT(t.TargetCompID,4) = 'MOMO' THEN 'Momentum'
    WHEN LEFT(t.TargetCompID,4) = 'LUCK' THEN 'Feeling Lucky'
    WHEN LEFT(t.TargetCompID,4) = 'PRED' THEN 'Prediction'
    ELSE 'Other'
  END                                              AS algorithm,
  t.Symbol,
  t.LastPx                                         AS openPrice,
  t.StrikePrice                                    AS closePrice,
  s.Side                                           AS tradeDirection,
  CASE WHEN s.Side = 'SHORT' THEN -1
       WHEN s.Side = 'LONG'  THEN  1
  END                                              AS tradeMultiplier
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`  AS t,
UNNEST(t.Sides) AS s
LIMIT 20;
```

