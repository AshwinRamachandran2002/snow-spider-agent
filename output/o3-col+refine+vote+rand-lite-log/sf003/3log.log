Query:
--Description: Assemble everything for one sample year (2018) using
--B01003_001E_5YR to validate joins (ZIP → State) and growth calculation.
WITH pop AS (
    SELECT 
           "GEO_ID",
           YEAR("DATE") AS "YR",
           "VALUE"      AS "POP"
    FROM   GLOBAL_GOVERNMENT.CYBERSYN.AMERICAN_COMMUNITY_SURVEY_TIMESERIES
    WHERE  "VARIABLE" = 'B01003_001E_5YR'
      AND  "DATE" IN ('2017-12-31','2018-12-31')
      AND  "GEO_ID" LIKE 'zip/%'
), growth AS (
    SELECT 
           p18."GEO_ID",
           (p18."POP" - p17."POP") / p17."POP" * 100.0 AS "GROWTH_%"
    FROM   pop p17
    JOIN   pop p18
      ON   p17."GEO_ID" = p18."GEO_ID"
    WHERE  p17."YR" = 2017
      AND  p18."YR" = 2018
      AND  p18."POP" >= 25000
), ranked AS (
    SELECT 
           g."GEO_ID",
           g."GROWTH_%",
           ROW_NUMBER() OVER (ORDER BY g."GROWTH_%" DESC) AS "RN"
    FROM   growth g
)
SELECT 
       r."GEO_ID",
       gi2."ISO_3166_2_CODE" AS "STATE",
       r."GROWTH_%"
FROM   ranked r
JOIN   GLOBAL_GOVERNMENT.CYBERSYN.GEOGRAPHY_RELATIONSHIPS gr
      ON gr."RELATED_GEO_ID" = r."GEO_ID"
     AND gr."RELATIONSHIP_TYPE" = 'Contains'
     AND gr."LEVEL"            = 'State'
JOIN   GLOBAL_GOVERNMENT.CYBERSYN.GEOGRAPHY_INDEX gi2
      ON gi2."GEO_ID" = gr."GEO_ID"
WHERE  r."RN" = 2
LIMIT 20
