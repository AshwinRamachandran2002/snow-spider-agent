```sql
-- Description: Assemble everything for ONE sample year (2018) to make sure
-- the join logic (ZIP → State, growth calc, ≥25 000 filter) works.
WITH pop AS (
    SELECT 
           "GEO_ID",
           YEAR("DATE") AS "YR",
           "VALUE"      AS "POP"
    FROM   GLOBAL_GOVERNMENT.CYBERSYN.AMERICAN_COMMUNITY_SURVEY_TIMESERIES
    WHERE  "VARIABLE" = '<POP_VAR>'
      AND  "DATE" IN ('2017-12-31','2018-12-31')
), growth AS (
    SELECT 
           p18."GEO_ID",
           (p18."POP" - p17."POP") / p17."POP" * 100.0 AS "GROWTH_%"
    FROM   pop p17
    JOIN   pop p18
      ON   p17."GEO_ID" = p18."GEO_ID"
    WHERE  p17."YR" = 2017
      AND  p18."YR" = 2018
      AND  p18."POP" >= 25000
), ranked AS (
    SELECT 
           g."GEO_ID",
           g."GROWTH_%",
           ROW_NUMBER() OVER (ORDER BY g."GROWTH_%" DESC) AS "RN"
    FROM   growth g
)
SELECT 
       r."GEO_ID",
       gi2."ISO_3166_2_CODE" AS "STATE",
       r."GROWTH_%"
FROM   ranked r
JOIN   GLOBAL_GOVERNMENT.CYBERSYN.GEOGRAPHY_RELATIONSHIPS gr
      ON gr."RELATED_GEO_ID" = r."GEO_ID"
     AND gr."RELATIONSHIP_TYPE" = 'Contains'
     AND gr."LEVEL"            = 'State'
JOIN   GLOBAL_GOVERNMENT.CYBERSYN.GEOGRAPHY_INDEX gi2
      ON gi2."GEO_ID" = gr."GEO_ID"
WHERE  r."RN" = 2   -- second-highest
LIMIT 20;
```

```sql
-- Description: Produce the requested final answer for EVERY year 2015-2020
-- (second-highest growth ZIP with ≥25 000 population).  Adjust the date
-- pairs if needed after inspecting earlier queries.
WITH yrs AS (
    SELECT 2015 AS "YR" UNION ALL SELECT 2016 UNION ALL
    SELECT 2017 UNION ALL SELECT 2018 UNION ALL
    SELECT 2019 UNION ALL SELECT 2020
), pop AS (
    SELECT 
           "GEO_ID",
           YEAR("DATE") AS "YR",
           "VALUE"      AS "POP"
    FROM   GLOBAL_GOVERNMENT.CYBERSYN.AMERICAN_COMMUNITY_SURVEY_TIMESERIES
    WHERE  "VARIABLE" = '<POP_VAR>'
      AND  YEAR("DATE") BETWEEN 2014 AND 2020
), growth AS (
    SELECT 
           y."YR",
           p_curr."GEO_ID",
           (p_curr."POP" - p_prev."POP") / p_prev."POP" * 100.0 AS "GROWTH_%"
    FROM   yrs y
    JOIN   pop p_curr 
      ON   p_curr."YR" = y."YR"
    JOIN   pop p_prev 
      ON   p_prev."GEO_ID" = p_curr."GEO_ID"
     AND   p_prev."YR"     = y."YR" - 1
    WHERE  p_curr."POP" >= 25000
), ranked AS (
    SELECT 
           g."YR",
           g."GEO_ID",
           g."GROWTH_%",
           ROW_NUMBER() OVER (PARTITION BY g."YR" 
                              ORDER BY g."GROWTH_%" DESC) AS "RN"
    FROM   growth g
)
SELECT 
       r."YR"          AS "YEAR",
       SUBSTR(r."GEO_ID", 5) AS "ZIP_CODE",
       gi_state."ISO_3166_2_CODE" AS "STATE",
       ROUND(r."GROWTH_%", 2)     AS "ANNUAL_GROWTH_%"
FROM   ranked r
JOIN   GLOBAL_GOVERNMENT.CYBERSYN.GEOGRAPHY_RELATIONSHIPS gr
      ON gr."RELATED_GEO_ID" = r."GEO_ID"
     AND gr."RELATIONSHIP_TYPE" = 'Contains'
     AND gr."LEVEL"            = 'State'
JOIN   GLOBAL_GOVERNMENT.CYBERSYN.GEOGRAPHY_INDEX gi_state
      ON gi_state."GEO_ID" = gr."GEO_ID"
WHERE  r."RN" = 2
ORDER  BY r."YR"
LIMIT 20;
```
