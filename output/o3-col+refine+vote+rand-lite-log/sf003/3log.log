Query:
--Description: Compute 2015 population growth (%) for every ZIP that met the
--≥25 000 threshold in 2015, using 2014 as the base year.
WITH pop AS (
    SELECT 
           "GEO_ID",
           YEAR("DATE") AS "YR",
           "VALUE"      AS "POP"
    FROM   GLOBAL_GOVERNMENT.CYBERSYN.AMERICAN_COMMUNITY_SURVEY_TIMESERIES
    WHERE  "VARIABLE" = 'B01003_001E_5YR'
      AND  "DATE" IN ('2014-12-31','2015-12-31')
      AND  "GEO_ID" LIKE 'zip/%'
)
SELECT 
       p15."GEO_ID",
       (p15."POP" - p14."POP") / p14."POP" * 100.0 AS "GROWTH_%"
FROM   pop p14
JOIN   pop p15
  ON   p14."GEO_ID" = p15."GEO_ID"
WHERE  p14."YR" = 2014
  AND  p15."YR" = 2015
  AND  p15."POP" >= 25000
ORDER  BY "GROWTH_%" DESC
LIMIT 20
