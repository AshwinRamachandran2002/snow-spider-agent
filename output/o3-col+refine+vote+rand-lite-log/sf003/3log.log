[{'TABLE_NAME': 'bank_for_international_settlements_timeseries', 'TABLE_NAME_PROPER': 'BIS International Financial Statistics Timeseries', 'TABLE_TYPE': 'timeseries', 'LISTING_URL': '[\n  "https://app.snowflake.com/marketplace/listing/GZTSZAS2KF7",\n  "https://app.snowflake.com/marketplace/listing/GZTSZ290BUX66"\n]', 'LISTING_NAME': '[\n  "Finance & Economics",\n  "Financials & Economics: Enterprise "\n]', 'DATA_SOURCE': '[\n  "Bank for International Settlements (BIS)"\n]', 'DESCRIPTION': 'Country-level statistics on real estate market trends, monetary policy rates, banking activities, credit availability to the non-financial sector, liquidity conditions, and inflation, provided by the central bank for central banks, Bank for International Settlements (BIS).\n\nThe Bank for International Settlements (BIS) is an international financial organization that provides data series on Property Prices (real estate market trends), Central Bank Policy Rates (global monetary policy), Locational and Consolidated Banking Statistics (international banking activities and risks), Credit to the Non-Financial Sector (credit availability), Global Liquidity Indicators, and Consumer Prices (inflationary activity).\n\nEach row represents a distinct timeseries, date, and value by primary and counterparty geographic entities (if available). Each variable is detailed in the bank_for_international_settlements_attributes table.', 'ENTITIES': '[\n  "geo_id"\n]', 'SELECT_RELATED_TABLES': '[\n  "bank_for_international_settlements_attributes",\n  "geography_index"\n]', 'DATA_SOURCE_URL': '[\n  "https://www.bis.org/statistics/index.htm?m=205"\n]', 'LICENSE_URL': '[\n  "https://www.bis.org/terms_statistics.htm"\n]', 'CREATED_DATE': '2023-11-22', 'LAST_UPDATED_TIMESTAMP': '2024-08-29 09:01:51.769000+00:00', 'DOCUMENTATION_URL': 'https://docs.cybersyn.com/public-domain-sources/bank-for-international-settlements', 'SHORT_DESCRIPTION': 'Country-level real estate market trends, monetary policy rates, banking activities, credit availability to the non-financial sector, liquidity conditions, and inflation, provided by the central bank for central banks, Bank for International Settlements (BIS).'}, {'TABLE_NAME': 'bureau_of_labor_statistics_employment_timeseries', 'TABLE_NAME_PROPER': 'BLS Employment Statistics Timeseries', 'TABLE_TYPE': 'timeseries', 'LISTING_URL': '[\n  "https://app.snowflake.com/marketplace/listing/GZTSZAS2KF7",\n  "https://app.snowflake.com/marketplace/listing/GZTSZ290BUX66"\n]', 'LISTING_NAME': '[\n  "Finance & Economics",\n  "Financials & Economics: Enterprise "\n]', 'DATA_SOURCE': '[\n  "Bureau of Labor Statistics (BLS)"\n]', 'DESCRIPTION': "Employment, job openings, labor turnover, and wages tracked across US regions in the LAUS, JOLTS, and SAE reports from the BLS.\n\nThe US Bureau of Labor Statistics (BLS) produces granular employment reports: Local Area Unemployment Statistics (LAUS) provides monthly and annual employment, unemployment, and labor force data for states and localities; Job Openings and Labor Turnover Survey (JOLTS) covers labor demand and turnover rates, including data on job openings, hires, and separations; and State and Metro Employment (SAE) delivers employment and wage data across various industries at state and metropolitan levels.\n\nEach row represents a distinct timeseries collected by the BLS reports (LAUS, JOLTS, and SAE), date, and value by geographic entity JOINABLE to Cybersyn's geography entity tables. Each variable is detailed in the bureau_of_labor_statistics_employment_attributes table.", 'ENTITIES': '[\n  "geo_id"\n]', 'SELECT_RELATED_TABLES': '[\n  "bureau_of_labor_statistics_employment_attributes",\n  "geography_index"\n]', 'DATA_SOURCE_URL': '[\n  "https://www.bls.gov/"\n]', 'LICENSE_URL': '[\n  "https://www.bls.gov/bls/linksite.htm"\n]', 'CREATED_DATE': '2023-06-13', 'LAST_UPDATED_TIMESTAMP': '2024-08-28 15:28:48.567000+00:00', 'DOCUMENTATION_URL': 'https://docs.cybersyn.com/public-domain-sources/us-bureau-of-labor-statistics', 'SHORT_DESCRIPTION': 'Employment, job openings, labor turnover, and wages tracked across US regions in the LAUS, JOLTS, and SAE reports from the BLS.'}, {'TABLE_NAME': 'company_event_transcript_attributes', 'TABLE_NAME_PROPER': 'Company Event Transcript Attributes', 'TABLE_TYPE': 'attributes', 'LISTING_URL': '[\n  "https://app.snowflake.com/marketplace/listing/GZTSZ290BUX66"\n]', 'LISTING_NAME': '[\n  "Financials & Economics: Enterprise "\n]', 'DATA_SOURCE': '[\n  "Cybersyn"\n]', 'DESCRIPTION': 'Transcripts of hosted company events (e.g. Update / Briefing, Earnings Call, Annual General Meeting) in JSON format.\n\nThe Cybersyn Company Event Transcript Attribute table include JSON-formatted transcripts of hosted company events across 9000+ public companies. The amount of history per company varies and more history is being added on a daily basis.\n\nCompany events may include Earnings Calls, Update / Briefings, M&A Announcements, Annual General Meetings, Investor / Analyst Days, and more. ', 'ENTITIES': '[\n  "company_id",\n  "cik",\n  "primary_ticker"\n]', 'SELECT_RELATED_TABLES': '[\n  "company_index",\n  "sec_cik_index",\n  "sec_corporate_report_index",\n  "sec_corporate_report_attributes"\n]', 'DATA_SOURCE_URL': None, 'LICENSE_URL': None, 'CREATED_DATE': '2024-06-24', 'LAST_UPDATED_TIMESTAMP': '2024-08-31 00:11:15.396000+00:00', 'DOCUMENTATION_URL': 'https://docs.cybersyn.com/public-domain-sources/earnings-transcripts', 'SHORT_DESCRIPTION': 'Transcripts of hosted company events (e.g. Update / Briefing, Earnings Call, Annual General Meeting) in JSON format.'}, {'TABLE_NAME': 'cybersyn_data_catalog', 'TABLE_NAME_PROPER': 'Cybersyn Data Catalog', 'TABLE_TYPE': 'other', 'LISTING_URL': '[\n  "https://app.snowflake.com/marketplace/listing/GZTSZ290BUX3R",\n  "https://app.snowflake.com/marketplace/listing/GZTSZAS2KGK",\n  "https://app.snowflake.com/marketplace/listing/GZTSZAS2KFB",\n  "https://app.snowflake.com/marketplace/listing/GZTSZAS2KF7",\n  "https://app.snowflake.com/marketplace/listing/GZTSZAS2KH9",\n  "https://app.snowflake.com/marketplace/listing/GZTSZAS2KI6",\n  "https://app.snowflake.com/marketplace/listing/GZTSZAS2KJ3",\n  "https://app.snowflake.com/marketplace/listing/GZTSZAS2KIA",\n  "https://app.snowflake.com/marketplace/listing/GZTSZAS2KII",\n  "https://app.snowflake.com/marketplace/listing/GZTSZAS2KIM",\n  "https://app.snowflake.com/marketplace/listing/GZTSZAS2KIE",\n  "https://app.snowflake.com/marketplace/listing/GZTSZ290BUX3V",\n  "https://app.snowflake.com/marketplace/listing/GZTSZ290BUX19",\n  "https://app.snowflake.com/marketplace/listing/GZTSZ290BUX1X",\n  "https://app.snowflake.com/marketplace/listing/GZTSZ290BUX66"\n]', 'LISTING_NAME': '[\n  "Consumer Spending Essentials",\n  "Global Government",\n  "Canadian Government",\n  "Finance & Economics",\n  "SEC Filings",\n  "US Real Estate",\n  "GitHub Events",\n  "US Addresses & POI",\n  "Tech & Innovation",\n  "Weather & Environment",\n  "US Crime",\n  "US Healthcare & Insurance",\n  "US Patents",\n  "LLM Training",\n  "Financials & Economics: Enterprise "\n]', 'DATA_SOURCE': '[\n  "Cybersyn"\n]', 'DESCRIPTION': 'A catalog of all Cybersyn tables. Metadata about the tables includes descriptions, data sources, related tables, and more.', 'ENTITIES': None, 'SELECT_RELATED_TABLES': None, 'DATA_SOURCE_URL': None, 'LICENSE_URL': None, 'CREATED_DATE': '2023-11-01', 'LAST_UPDATED_TIMESTAMP': '2024-08-30 22:09:41.613000+00:00', 'DOCUMENTATION_URL': None, 'SHORT_DESCRIPTION': None}, {'TABLE_NAME': 'cybersyn_financial_economic_indicators_timeseries_history', 'TABLE_NAME_PROPER': 'Cybersyn Financial & Economic Indicators Timeseries Point in Time History', 'TABLE_TYPE': 'point-in-time history', 'LISTING_URL': '[\n  "https://app.snowflake.com/marketplace/listing/GZTSZ290BUX66"\n]', 'LISTING_NAME': '[\n  "Financials & Economics: Enterprise "\n]', 'DATA_SOURCE': '[\n  "Bureau of Economic Analysis (BEA)",\n  "Bureau of Labor Statistics (BLS)",\n  "Census Bureau (CB)",\n  "Consumer Financial Protection Bureau (CFPB)",\n  "Department of Labor (DOL)",\n  "Federal Reserve (FED)",\n  "Freddie Mac",\n  "New York Fed"\n]', 'DESCRIPTION': 'Tracks history of the cybersyn_financial_economic_indicators_timeseries table with start and end timestamps to indicate row validity periods. \n\nCurrent rows have a NULL end timestamp. Updated and deleted rows are time-stamped, including deletion time, in Eastern Time with UTC offset.', 'ENTITIES': None, 'SELECT_RELATED_TABLES': '[\n  "cybersyn_financial_economic_indicators_timeseries"\n]', 'DATA_SOURCE_URL': '[\n  "https://www.bea.gov/data/gdp",\n  "https://www.bls.gov/",\n  "https://www.census.gov/data/datasets.html",\n  "https://www.consumerfinance.gov/",\n  "https://oui.doleta.gov/unemploy/claims.asp",\n  "https://www.federalreserve.gov/data.htm",\n  "https://www.freddiemac.com/pmms/pmms_archives",\n  "https://www.freddiemac.com/research/indices/house-price-index",\n  "https://www.newyorkfed.org/microeconomics/databank.html"\n]', 'LICENSE_URL': '[\n  "https://www.bea.gov/about/policies-and-information",\n  "https://www.bls.gov/bls/linksite.htm",\n  "https://www.census.gov/data/developers/about/terms-of-service.html",\n  "https://www.consumerfinance.gov/privacy/",\n  "https://www.dol.gov/general/aboutdol/copyright",\n  "https://www.federalreserve.gov/disclaimer.htm",\n  "https://www.freddiemac.com/pmms/syndication/how_to",\n  "https://www.newyorkfed.org/privacy/termsofuse"\n]', 'CREATED_DATE': '2024-03-12', 'LAST_UPDATED_TIMESTAMP': '2024-08-30 21:16:59.968000+00:00', 'DOCUMENTATION_URL': 'https://docs.cybersyn.com/public-domain-sources/financial-and-economic-indicators', 'SHORT_DESCRIPTION': None}]
