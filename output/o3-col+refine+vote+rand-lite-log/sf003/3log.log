```sql
-- Description: List distinct calendar years captured in the ACS 5-Year
-- population estimates so we can target 2014-2020 (needed to compute annual
-- growth from 2014→2015, … 2019→2020).
SELECT DISTINCT 
       YEAR("DATE") AS "YEAR"
FROM   GLOBAL_GOVERNMENT.CYBERSYN.AMERICAN_COMMUNITY_SURVEY_TIMESERIES
WHERE  "VARIABLE" = '<POP_VAR>'
ORDER  BY "YEAR"
LIMIT 20;
```

```sql
-- Description: For 2015, pull every ZIP (5-Year estimate) whose population
-- is at least 25 000.  We’ll later compare with 2014 to get the 2015 growth
-- rate.
SELECT 
       "GEO_ID",
       "VALUE"      AS "POP_2015"
FROM   GLOBAL_GOVERNMENT.CYBERSYN.AMERICAN_COMMUNITY_SURVEY_TIMESERIES
WHERE  "VARIABLE" = '<POP_VAR>'
  AND  "DATE"     = '2015-12-31'
  AND  "VALUE"    >= 25000
ORDER  BY "VALUE" DESC
LIMIT 20;
```

```sql
-- Description: Compute 2015 population growth (%) for every ZIP that meets
-- the ≥25 000 threshold in 2015.  Uses 2014 as the base year.
WITH pop AS (
    SELECT 
           "GEO_ID",
           YEAR("DATE") AS "YR",
           "VALUE"      AS "POP"
    FROM   GLOBAL_GOVERNMENT.CYBERSYN.AMERICAN_COMMUNITY_SURVEY_TIMESERIES
    WHERE  "VARIABLE" = '<POP_VAR>'
      AND  "DATE" IN ('2014-12-31','2015-12-31')
)
SELECT 
       p15."GEO_ID",
       (p15."POP" - p14."POP") / p14."POP" * 100.0 AS "GROWTH_%"
FROM   pop p14
JOIN   pop p15
  ON   p14."GEO_ID" = p15."GEO_ID"
 WHERE  p14."YR" = 2014
   AND  p15."YR" = 2015
   AND  p15."POP" >= 25000
ORDER  BY "GROWTH_%" DESC
LIMIT 20;
```

```sql
-- Description: Pick the ZIP with the *second-highest* 2015 growth rate.
WITH growth AS (
    /* same CTE as previous query */
    SELECT 
           p15."GEO_ID",
           (p15."POP" - p14."POP") / p14."POP" * 100.0 AS "GROWTH_%"
    FROM (
          SELECT "GEO_ID","VALUE" AS "POP"
          FROM   GLOBAL_GOVERNMENT.CYBERSYN.AMERICAN_COMMUNITY_SURVEY_TIMESERIES
          WHERE  "VARIABLE" = '<POP_VAR>'
            AND  "DATE" = '2014-12-31'
         ) p14
    JOIN (
          SELECT "GEO_ID","VALUE" AS "POP"
          FROM   GLOBAL_GOVERNMENT.CYBERSYN.AMERICAN_COMMUNITY_SURVEY_TIMESERIES
          WHERE  "VARIABLE" = '<POP_VAR>'
            AND  "DATE" = '2015-12-31'
         ) p15
      ON p14."GEO_ID" = p15."GEO_ID"
    WHERE p15."POP" >= 25000
)
SELECT *
FROM   (
        SELECT 
               "GEO_ID",
               "GROWTH_%",
               ROW_NUMBER() OVER (ORDER BY "GROWTH_%" DESC) AS "RN"
        FROM   growth
      ) ranked
WHERE  "RN" = 2;
```

```sql
