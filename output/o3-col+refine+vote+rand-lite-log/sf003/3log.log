Query:
--Description: Pick the ZIP with the second-highest 2015 growth rate (≥25 000
--population) based on B01003_001E_5YR.
WITH growth AS (
    SELECT 
           p15."GEO_ID",
           (p15."POP" - p14."POP") / p14."POP" * 100.0 AS "GROWTH_%"
    FROM (SELECT "GEO_ID","VALUE" AS "POP"
          FROM   GLOBAL_GOVERNMENT.CYBERSYN.AMERICAN_COMMUNITY_SURVEY_TIMESERIES
          WHERE  "VARIABLE" = 'B01003_001E_5YR'
            AND  "DATE" = '2014-12-31'
            AND  "GEO_ID" LIKE 'zip/%') p14
    JOIN (SELECT "GEO_ID","VALUE" AS "POP"
          FROM   GLOBAL_GOVERNMENT.CYBERSYN.AMERICAN_COMMUNITY_SURVEY_TIMESERIES
          WHERE  "VARIABLE" = 'B01003_001E_5YR'
            AND  "DATE" = '2015-12-31'
            AND  "GEO_ID" LIKE 'zip/%') p15
      ON p14."GEO_ID" = p15."GEO_ID"
    WHERE p15."POP" >= 25000
)
SELECT *
FROM   (SELECT 
               "GEO_ID",
               "GROWTH_%",
               ROW_NUMBER() OVER (ORDER BY "GROWTH_%" DESC) AS "RN"
        FROM   growth) ranked
WHERE  "RN" = 2
