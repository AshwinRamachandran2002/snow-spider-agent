  ("retail_price" - "cost")     AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
LIMIT 20;
```

```sql
--Description: Look at inventory items whose "sold_at" micro-seconds fall inside calendar year-2020 ( 1 Jan 2020 → 31 Dec 2020 ) to be sure 2020 sales exist.
SELECT 
  "id"               AS "inventory_item_id",
  "product_id",
  "sold_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
WHERE "sold_at" BETWEEN 1577836800000000     -- 2020-01-01 00:00:00
                    AND 1609459199000000     -- 2020-12-31 23:59:59
LIMIT 20;
```

```sql
--Description: Quickly check which (converted) years appear in "sold_at" to confirm that 2020 is among them.
SELECT DISTINCT 
  YEAR( TO_TIMESTAMP_NTZ( "sold_at" / 1000000 ) )   AS "year"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
ORDER BY "year"
LIMIT 20;
```

```sql
--Description: Join the 2020 sold inventory to product details so we can see profit for each actual item sold.
SELECT 
  ii."id"                              AS "inventory_item_id",
  ii."product_id",
  p."name"                             AS "product_name",
  p."retail_price",
  p."cost",
  ( p."retail_price" - p."cost" )      AS "profit",
  TO_TIMESTAMP_NTZ( ii."sold_at" / 1000000 ) AS "sold_timestamp"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"      ii
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"             p
  ON ii."product_id" = p."id"
WHERE ii."sold_at" BETWEEN 1577836800000000 AND 1609459199000000
LIMIT 20;
```

```sql
--Description: Aggregate profit per product for each calendar month of 2020 (helps to see profit distribution inside months).
SELECT 
  DATE_TRUNC( 'month', TO_TIMESTAMP_NTZ( ii."sold_at" / 1000000 ) )   AS "month",
  p."id"                                                              AS "product_id",
  p."name"                                                            AS "product_name",
  MIN( p."retail_price" - p."cost" )                                  AS "min_profit_this_product"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p
  ON ii."product_id" = p."id"
WHERE ii."sold_at" BETWEEN 1577836800000000 AND 1609459199000000
GROUP BY 1,2,3
ORDER BY 1,4
LIMIT 20;
```

```sql
--Description: For every 2020 month, find the absolute minimum profit value made by any product.
SELECT 
  DATE_TRUNC( 'month', TO_TIMESTAMP_NTZ( ii."sold_at" / 1000000 ) )           AS "month",
  MIN( p."retail_price" - p."cost" )                                          AS "lowest_profit_in_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
  ON ii."product_id" = p."id"
WHERE ii."sold_at" BETWEEN 1577836800000000 AND 1609459199000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Retrieve product-level rows that achieve the minimum monthly profit (ties are kept) so that we get the product names.
WITH monthly_min AS (
  SELECT 
    DATE_TRUNC( 'month', TO_TIMESTAMP_NTZ( ii."sold_at" / 1000000 ) ) AS "month",
    MIN( p."retail_price" - p."cost" )                                AS "min_profit"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
    ON ii."product_id" = p."id"
  WHERE ii."sold_at" BETWEEN 1577836800000000 AND 1609459199000000
  GROUP BY 1
)
SELECT 
  DATE_TRUNC( 'month', TO_TIMESTAMP_NTZ( ii."sold_at" / 1000000 ) )   AS "month",
  p."name"                                                           AS "product_name",
  ( p."retail_price" - p."cost" )                                    AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
  ON ii."product_id" = p."id"
JOIN monthly_min m
  ON DATE_TRUNC( 'month', TO_TIMESTAMP_NTZ( ii."sold_at" / 1000000 ) ) = m."month"
 AND ( p."retail_price" - p."cost" ) = m."min_profit"
WHERE ii."sold_at" BETWEEN 1577836800000000 AND 1609459199000000
LIMIT 20;
```

```sql
--Description: Show the distinct months along with their lowest-profit product names in chronological order (deduplicated).
WITH monthly_min AS (
  SELECT 
    DATE_TRUNC( 'month', TO_TIMESTAMP_NTZ( ii."sold_at" / 1000000 ) ) AS "month",
    MIN( p."retail_price" - p."cost" )                                AS "min_profit"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
    ON ii."product_id" = p."id"
  WHERE ii."sold_at" BETWEEN 1577836800000000 AND 1609459199000000
  GROUP BY 1
)
SELECT DISTINCT
  DATE_TRUNC( 'month', TO_TIMESTAMP_NTZ( ii."sold_at" / 1000000 ) )  AS "month",
  p."name"                                                          AS "product_name"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
  ON ii."product_id" = p."id"
JOIN monthly_min m
  ON DATE_TRUNC( 'month', TO_TIMESTAMP_NTZ( ii."sold_at" / 1000000 ) ) = m."month"
 AND ( p."retail_price" - p."cost" ) = m."min_profit"
WHERE ii."sold_at" BETWEEN 1577836800000000 AND 1609459199000000
ORDER BY "month"
LIMIT 20;
```

```sql
--Description: (Optional deeper dive) Include the distribution center to see where those lowest-profit products were shipped from during 2020.
WITH monthly_min AS (
  SELECT 
    DATE_TRUNC( 'month', TO_TIMESTAMP_NTZ( ii."sold_at" / 1000000 ) ) AS "month",
    MIN( p."retail_price" - p."cost" )                                AS "min_profit"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"   ii
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"          p
    ON ii."product_id" = p."id"
  WHERE ii."sold_at" BETWEEN 1577836800000000 AND 1609459199000000
  GROUP BY 1
)
SELECT 
  DATE_TRUNC( 'month', TO_TIMESTAMP_NTZ( ii."sold_at" / 1000000 ) )    AS "month",
  p."name"                                                             AS "product_name",
  ( p."retail_price" - p."cost" )                                      AS "profit",
  dc."name"                                                            AS "distribution_center"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"        ii
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"               p
  ON ii."product_id" = p."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."DISTRIBUTION_CENTERS"   dc
  ON p."distribution_center_id" = dc."id"
JOIN monthly_min m
  ON DATE_TRUNC( 'month', TO_TIMESTAMP_NTZ( ii."sold_at" / 1000000 ) ) = m."month"
 AND ( p."retail_price" - p."cost" ) = m."min_profit"
WHERE ii."sold_at" BETWEEN 1577836800000000 AND 1609459199000000
ORDER BY "month"
LIMIT 20;
```

```sql
--Description: Check that every month of 2020 indeed produced at least one lowest-profit product (expecting exactly 12 rows).
WITH monthly_min AS (
  SELECT 
    DATE_TRUNC( 'month', TO_TIMESTAMP_NTZ( ii."sold_at" / 1000000 ) ) AS "month",
    MIN( p."retail_price" - p."cost" )                                AS "min_profit"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
    ON ii."product_id" = p."id"
  WHERE ii."sold_at" BETWEEN 1577836800000000 AND 1609459199000000
  GROUP BY 1
)
SELECT COUNT( DISTINCT "month" ) AS "months_with_low_profit_product"
FROM monthly_min
LIMIT 20;
```
