--Description: Show the distinct months along with their lowest-profit product names in chronological order (deduplicated).
WITH monthly_min AS (
  SELECT 
    DATE_TRUNC( 'month', TO_TIMESTAMP_NTZ( ii."sold_at" / 1000000 ) ) AS "month",
    MIN( p."retail_price" - p."cost" )                                AS "min_profit"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
    ON ii."product_id" = p."id"
  WHERE ii."sold_at" BETWEEN 1577836800000000 AND 1609459199000000
  GROUP BY 1
)
SELECT DISTINCT
  DATE_TRUNC( 'month', TO_TIMESTAMP_NTZ( ii."sold_at" / 1000000 ) )  AS "month",
  p."name"                                                          AS "product_name"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
  ON ii."product_id" = p."id"
JOIN monthly_min m
  ON DATE_TRUNC( 'month', TO_TIMESTAMP_NTZ( ii."sold_at" / 1000000 ) ) = m."month"
 AND ( p."retail_price" - p."cost" ) = m."min_profit"
WHERE ii."sold_at" BETWEEN 1577836800000000 AND 1609459199000000
ORDER BY "month"
LIMIT 20;
