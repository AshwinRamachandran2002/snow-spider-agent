  AND ii."sold_at" >= 1577836800000000
  AND ii."sold_at" < 1609459200000000
LIMIT 20;
```

```sql
--Description: Find the 20 products with the lowest profit margin (retail-cost) among all 2020 sales.  
SELECT DISTINCT p."id"              AS "product_id",
       p."name"            AS "product_name",
       p."retail_price",
       p."cost",
       (p."retail_price" - p."cost") AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  AS ii
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         AS p
  ON ii."product_id" = p."id"
WHERE ii."sold_at" IS NOT NULL
  AND ii."sold_at" >= 1577836800000000
  AND ii."sold_at" < 1609459200000000
ORDER BY "profit" ASC
LIMIT 20;
```

```sql
--Description: Break down 2020 sales into month buckets (YYYY-MM) and list one record per sale to inspect month boundaries.  
SELECT TO_CHAR(TO_TIMESTAMP_LTZ("sold_at"/1000000), 'YYYY-MM') AS "yyyymm",
       "product_id",
       "product_name",
       "sold_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
WHERE "sold_at" IS NOT NULL
  AND "sold_at" >= 1577836800000000
  AND "sold_at" < 1609459200000000
LIMIT 20;
```

```sql
--Description: Compute the minimum profit observed per month over all 2020 sales.  
SELECT TO_CHAR(TO_TIMESTAMP_LTZ(ii."sold_at"/1000000), 'YYYY-MM') AS "yyyymm",
       MIN(p."retail_price" - p."cost")                           AS "min_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" AS ii
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        AS p
  ON ii."product_id" = p."id"
WHERE ii."sold_at" IS NOT NULL
  AND ii."sold_at" >= 1577836800000000
  AND ii."sold_at" < 1609459200000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Retrieve the products that match the minimum profit of each 2020 month (ties possible).  
SELECT m."yyyymm",
       p."name"                       AS "product_name",
       (p."retail_price" - p."cost")  AS "profit"
FROM (
      SELECT TO_CHAR(TO_TIMESTAMP_LTZ(ii."sold_at"/1000000),'YYYY-MM') AS "yyyymm",
             MIN(p."retail_price" - p."cost") AS "min_profit"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" AS ii
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        AS p
        ON ii."product_id" = p."id"
      WHERE ii."sold_at" IS NOT NULL
        AND ii."sold_at" >= 1577836800000000
        AND ii."sold_at" < 1609459200000000
      GROUP BY 1
     ) AS m
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" AS ii
  ON TO_CHAR(TO_TIMESTAMP_LTZ(ii."sold_at"/1000000),'YYYY-MM') = m."yyyymm"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        AS p
  ON ii."product_id" = p."id"
WHERE (p."retail_price" - p."cost") = m."min_profit"
GROUP BY 1,2,3
ORDER BY m."yyyymm"
LIMIT 20;
```

```sql
--Description: Verify how many unique products appear as lowest-profit winners for each 2020 month.  
SELECT "yyyymm",
       COUNT(DISTINCT "product_name") AS "num_low_profit_products"
FROM (
      SELECT TO_CHAR(TO_TIMESTAMP_LTZ(ii."sold_at"/1000000),'YYYY-MM') AS "yyyymm",
             p."name"                       AS "product_name",
             (p."retail_price" - p."cost")  AS "profit"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" AS ii
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        AS p
        ON ii."product_id" = p."id"
      WHERE ii."sold_at" IS NOT NULL
        AND ii."sold_at" >= 1577836800000000
        AND ii."sold_at" < 1609459200000000
     )
QUALIFY "profit" = MIN("profit") OVER (PARTITION BY "yyyymm")
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Display the distribution (histogram) of profit margins for all products sold in 2020.  
SELECT ROUND(p."retail_price" - p."cost", 0) AS "profit_bucket",
       COUNT(*)                              AS "cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" AS ii
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        AS p
  ON ii."product_id" = p."id"
WHERE ii."sold_at" IS NOT NULL
  AND ii."sold_at" >= 1577836800000000
  AND ii."sold_at" < 1609459200000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Final check – list chronologically (YYYY-MM) the product names with the overall lowest profit for each month in 2020, ready for reporting.  
SELECT DISTINCT
       TO_CHAR(TO_TIMESTAMP_LTZ(ii."sold_at"/1000000),'YYYY-MM') AS "yyyymm",
       p."name"                                                  AS "product_name",
       (p."retail_price" - p."cost")                             AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" AS ii
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        AS p
  ON ii."product_id" = p."id"
WHERE ii."sold_at" IS NOT NULL
  AND ii."sold_at" >= 1577836800000000
  AND ii."sold_at" < 1609459200000000
QUALIFY (p."retail_price" - p."cost")
        = MIN(p."retail_price" - p."cost")
          OVER (PARTITION BY TO_CHAR(TO_TIMESTAMP_LTZ(ii."sold_at"/1000000),'YYYY-MM'))
ORDER BY "yyyymm"
LIMIT 20;
```
