--Description: 
-- Display a simple histogram (bucketed to whole-number increments) of profit margins
-- for every product sold during calendar year 2020.  Profit = retail_price – cost.
SELECT
       ROUND(p."retail_price" - p."cost", 0) AS "profit_bucket",
       COUNT(*)                              AS "cnt"
FROM  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" AS ii
JOIN  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        AS p
      ON ii."product_id" = p."id"
WHERE ii."sold_at" IS NOT NULL
  AND ii."sold_at" >= 1577836800000000        -- 2020-01-01
  AND ii."sold_at" <  1609459200000000        -- 2021-01-01
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 
-- Final report – list, in chronological order, the product(s) that achieved the
-- lowest profit margin in each month of 2020.  QUALIFY keeps only rows whose
-- profit equals the monthly minimum computed via a window function.
WITH sales_2020 AS (
    SELECT
        TO_CHAR(TO_TIMESTAMP_LTZ(ii."sold_at" / 1000000), 'YYYY-MM') AS "yyyymm",
        p."name"                                                     AS "product_name",
        (p."retail_price" - p."cost")                                AS "profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" AS ii
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        AS p
      ON ii."product_id" = p."id"
    WHERE ii."sold_at" IS NOT NULL
      AND ii."sold_at" >= 1577836800000000        -- 2020-01-01
      AND ii."sold_at" <  1609459200000000        -- 2021-01-01
)
SELECT DISTINCT
       "yyyymm",
       "product_name",
       "profit"
FROM sales_2020
QUALIFY "profit" = MIN("profit") OVER (PARTITION BY "yyyymm")
ORDER BY "yyyymm"
LIMIT 20;
