Query:
--Description: Join the 2020 inventory sales with product table to see cost, retail price and compute profit (retail-cost).  
SELECT ii."product_id",
       p."name"            AS "product_name",
       p."retail_price",
       p."cost",
       (p."retail_price" - p."cost") AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  AS ii
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         AS p
  ON ii."product_id" = p."id"
WHERE ii."sold_at" IS NOT NULL
  AND ii."sold_at" >= 1577836800000000
  AND ii."sold_at" < 1609459200000000
LIMIT 20;
