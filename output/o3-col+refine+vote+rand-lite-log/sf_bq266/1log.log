```sql
--Description: 
-- 1) Filter INVENTORY_ITEMS for rows whose "sold_at" timestamp falls within calendar year 2020.  
-- 2) Join to PRODUCTS so we can calculate each item’s profit = retail_price – cost.  
-- 3) Convert the micro-second epoch "sold_at" value to calendar month string "YYYY-MM".  
-- 4) Using a window function, find the minimum profit within each month (MIN(...) OVER PARTITION BY month).  
-- 5) Keep only those rows whose profit equals that month’s minimum → the lowest-profit product(s) of the month.  
-- 6) Return the month, product name and profit, ordered chronologically; DISTINCT removes duplicates caused by multiple sales of the same product.  
WITH sales_2020 AS (
    SELECT
        TO_CHAR(TO_TIMESTAMP_LTZ(ii."sold_at" / 1000000), 'YYYY-MM') AS "yyyymm",
        p."name"                                                     AS "product_name",
        (p."retail_price" - p."cost")                                AS "profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  AS ii
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         AS p
      ON ii."product_id" = p."id"
    WHERE ii."sold_at" IS NOT NULL
      AND ii."sold_at" >= 1577836800000000        -- 2020-01-01 00:00:00 UTC
