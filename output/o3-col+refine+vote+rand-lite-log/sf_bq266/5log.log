```sql
--Description: Peek at some 2020 inventory movements that were actually sold
SELECT 
  "id",
  "product_id",
  "sold_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
WHERE "sold_at" IS NOT NULL
  AND "sold_at" >= 1577836800000000     -- >= 2020-01-01 UTC in µs
  AND "sold_at" <  1609459200000000     --  < 2021-01-01 UTC in µs
LIMIT 20;
```

```sql
--Description: Bring in product information (name, retail_price, cost) for those same sample rows
SELECT
  i."product_id",
  p."name",
  p."retail_price",
  p."cost",
  (p."retail_price" - p."cost") AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
  ON i."product_id" = p."id"
WHERE i."sold_at" IS NOT NULL
  AND i."sold_at" >= 1577836800000000
  AND i."sold_at" <  1609459200000000
LIMIT 20;
```

```sql
--Description: Check how many distinct products were sold each month in 2020
SELECT
  TO_CHAR(TO_TIMESTAMP_NTZ("sold_at"/1000000), 'YYYY-MM') AS "month_yyyy_mm",
  COUNT(DISTINCT "product_id")                           AS "distinct_products_sold"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
WHERE "sold_at" IS NOT NULL
  AND "sold_at" BETWEEN 1577836800000000 AND 1609459199999999
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Compute the lowest per-unit profit per month during 2020
SELECT
  TO_CHAR(TO_TIMESTAMP_NTZ(i."sold_at"/1000000), 'YYYY-MM')  AS "month_yyyy_mm",
  MIN(p."retail_price" - p."cost")                           AS "lowest_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
  ON i."product_id" = p."id"
WHERE i."sold_at" BETWEEN 1577836800000000 AND 1609459199999999
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Retrieve the product(s) that achieved that lowest profit for each month
SELECT
  TO_CHAR(TO_TIMESTAMP_NTZ(i."sold_at"/1000000), 'YYYY-MM')  AS "month_yyyy_mm",
  p."name",
  (p."retail_price" - p."cost")                              AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
  ON i."product_id" = p."id"
JOIN (
      -- subquery returns min profit per month
      SELECT
        TO_CHAR(TO_TIMESTAMP_NTZ(ii."sold_at"/1000000), 'YYYY-MM') AS "mon",
        MIN(pp."retail_price" - pp."cost")                         AS "min_profit"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        pp
        ON ii."product_id" = pp."id"
      WHERE ii."sold_at" BETWEEN 1577836800000000 AND 1609459199999999
      GROUP BY 1
     ) m
  ON TO_CHAR(TO_TIMESTAMP_NTZ(i."sold_at"/1000000), 'YYYY-MM') = m."mon"
 AND (p."retail_price" - p."cost") = m."min_profit"
WHERE i."sold_at" BETWEEN 1577836800000000 AND 1609459199999999
GROUP BY 1, p."name", (p."retail_price" - p."cost")
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Confirm there are no ties (more than one product) in any month’s lowest-profit result
SELECT
  "month_yyyy_mm",
  COUNT(*) AS "products_with_lowest_profit"
FROM (
  SELECT
    TO_CHAR(TO_TIMESTAMP_NTZ(i."sold_at"/1000000), 'YYYY-MM') AS "month_yyyy_mm",
    p."name",
    ROW_NUMBER() OVER (
      PARTITION BY TO_CHAR(TO_TIMESTAMP_NTZ(i."sold_at"/1000000), 'YYYY-MM')
      ORDER BY (p."retail_price" - p."cost") ASC
    ) AS "rn"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
    ON i."product_id" = p."id"
  WHERE i."sold_at" BETWEEN 1577836800000000 AND 1609459199999999
)
WHERE "rn" = 1
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Pull the final chronological list of product names (single winner per month)
SELECT DISTINCT
  TO_CHAR(TO_TIMESTAMP_NTZ(i."sold_at"/1000000), 'YYYY-MM')  AS "month_yyyy_mm",
  p."name"                                                   AS "lowest_profit_product"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
  ON i."product_id" = p."id"
WHERE i."sold_at" BETWEEN 1577836800000000 AND 1609459199999999
QUALIFY (p."retail_price" - p."cost") = MIN(p."retail_price" - p."cost")
         OVER (PARTITION BY TO_CHAR(TO_TIMESTAMP_NTZ(i."sold_at"/1000000), 'YYYY-MM'))
ORDER BY "month_yyyy_mm"
LIMIT 20;
```

```sql
--Description: Check the raw lowest-profit dollar values alongside product and month for validation
SELECT DISTINCT
  TO_CHAR(TO_TIMESTAMP_NTZ(i."sold_at"/1000000), 'YYYY-MM')           AS "month_yyyy_mm",
  p."name",
  (p."retail_price" - p."cost")                                       AS "profit_dollars"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
  ON i."product_id" = p."id"
WHERE i."sold_at" BETWEEN 1577836800000000 AND 1609459199999999
QUALIFY (p."retail_price" - p."cost") = MIN(p."retail_price" - p."cost")
         OVER (PARTITION BY TO_CHAR(TO_TIMESTAMP_NTZ(i."sold_at"/1000000), 'YYYY-MM'))
ORDER BY "month_yyyy_mm"
LIMIT 20;
```

```sql
--Description: Investigate any month that may be missing from 2020 in case no inventory sold
SELECT
  '2020-' || LPAD(seq, 2, '0')                           AS "month_yyyy_mm",
  COALESCE(s."distinct_items_sold", 0)                   AS "items_sold"
FROM LATERAL (
       SELECT SEQ4() + 1 AS seq
       FROM TABLE(GENERATOR(ROWCOUNT => 12))
     ) cal
LEFT JOIN (
  SELECT
    TO_CHAR(TO_TIMESTAMP_NTZ("sold_at"/1000000), 'YYYY-MM') AS "m",
    COUNT(*)                                                AS "distinct_items_sold"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
  WHERE "sold_at" IS NOT NULL
    AND "sold_at" BETWEEN 1577836800000000 AND 1609459199999999
  GROUP BY 1
) s
  ON s."m" = '2020-' || LPAD(cal.seq, 2, '0')
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Final answer query (chronological list requested)
SELECT DISTINCT
  TO_CHAR(TO_TIMESTAMP_NTZ(i."sold_at"/1000000), 'YYYY-MM') AS "month_yyyy_mm",
  p."name"                                                  AS "lowest_profit_product"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
  ON i."product_id" = p."id"
WHERE i."sold_at" BETWEEN 1577836800000000 AND 1609459199999999
QUALIFY (p."retail_price" - p."cost") = MIN(p."retail_price" - p."cost")
         OVER (PARTITION BY TO_CHAR(TO_TIMESTAMP_NTZ(i."sold_at"/1000000), 'YYYY-MM'))
ORDER BY "month_yyyy_mm";
```
