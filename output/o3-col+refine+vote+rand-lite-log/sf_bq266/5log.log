)
SELECT                                           -- ③ + ④ final list
    cal."month_yyyy_mm",
    COALESCE(sales."items_sold", 0) AS "items_sold"
FROM cal
LEFT JOIN sales
       ON cal."month_yyyy_mm" = sales."month_yyyy_mm"
ORDER BY cal."month_yyyy_mm";
