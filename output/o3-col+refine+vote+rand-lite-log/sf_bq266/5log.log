WITH cal AS (                                   -- ① calendar
    SELECT '2020-' || LPAD(SEQ4() + 1, 2, '0') AS "month_yyyy_mm"
    FROM TABLE(GENERATOR(ROWCOUNT => 12))
),
sales AS (                                     -- ② monthly sales counts
    SELECT
        TO_CHAR(TO_TIMESTAMP_NTZ("sold_at"/1000000), 'YYYY-MM') AS "month_yyyy_mm",
