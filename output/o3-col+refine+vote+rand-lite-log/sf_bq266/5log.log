Query:
--Description: Compute the lowest per-unit profit per month during 2020
SELECT
  TO_CHAR(TO_TIMESTAMP_NTZ(i."sold_at"/1000000), 'YYYY-MM')  AS "month_yyyy_mm",
  MIN(p."retail_price" - p."cost")                           AS "lowest_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
  ON i."product_id" = p."id"
WHERE i."sold_at" BETWEEN 1577836800000000 AND 1609459199999999
GROUP BY 1
ORDER BY 1
LIMIT 20;
