```

```sql
--Description: Find the single lowest-profit products in the whole catalogue  
SELECT "id",
       "name",
       "retail_price" - "cost" AS "profit"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
ORDER BY "profit"
LIMIT  20;
```

```sql
--Description: Peek at order-item records that happened during 2020  
SELECT "id",
       "order_id",
       "product_id",
       "created_at",
       "status",
       "sale_price"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
WHERE  "created_at" BETWEEN 1577836800000000 -- 01-Jan-2020
                       AND     1609459199000000 -- 31-Dec-2020
LIMIT  20;
```

```sql
--Description: Join 2020 order-items to product facts to bring in cost/retail  
SELECT oi."id"              AS "order_item_id",
       oi."product_id",
       p."name",
       p."retail_price",
       p."cost",
       (p."retail_price" - p."cost") AS "profit",
       oi."created_at"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
       ON p."id" = oi."product_id"
WHERE  oi."created_at" BETWEEN 1577836800000000
                          AND     1609459199000000
LIMIT  20;
```

```sql
--Description: Extract order month (YYYY-MM) with timestamp conversion for 2020 sample  
SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000), 'YYYY-MM') AS "order_month",
       oi."product_id",
       p."name",
       (p."retail_price" - p."cost") AS "profit"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
       ON p."id" = oi."product_id"
WHERE  oi."created_at" BETWEEN 1577836800000000
                          AND     1609459199000000
LIMIT  20;
```

```sql
--Description: For every 2020 month, return the minimum profit value observed  
SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000), 'YYYY-MM') AS "order_month",
       MIN(p."retail_price" - p."cost")                             AS "min_month_profit"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
       ON p."id" = oi."product_id"
WHERE  oi."created_at" BETWEEN 1577836800000000
                          AND     1609459199000000
GROUP BY 1
ORDER BY 1
LIMIT  20;
```

```sql
--Description: Identify the product(s) that achieved that minimum profit each month  
WITH month_min AS (
  SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000), 'YYYY-MM') AS "order_month",
         MIN(p."retail_price" - p."cost") AS "min_profit"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
  JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
         ON p."id" = oi."product_id"
  WHERE  oi."created_at" BETWEEN 1577836800000000
                             AND     1609459199000000
  GROUP BY 1
)
SELECT m."order_month",
       p."name",
       p."retail_price" - p."cost" AS "profit"
FROM   month_min                            m
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
       ON TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM') = m."order_month"
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
       ON p."id" = oi."product_id"
WHERE  (p."retail_price" - p."cost") = m."min_profit"
GROUP  BY m."order_month", p."name", p."retail_price", p."cost"
ORDER  BY m."order_month"
LIMIT  20;
```

```sql
--Description: Final tidy list ‑ product names with the lowest profit for every 2020 month  
SELECT DISTINCT m_p."order_month",
       m_p."name"          AS "product_name",
       m_p."profit"
FROM (
      /* inner query identical to previous step but without extra columns */
      WITH month_min AS (
        SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000), 'YYYY-MM') AS "order_month",
               MIN(p."retail_price" - p."cost") AS "min_profit"
        FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
        JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
               ON p."id" = oi."product_id"
        WHERE  oi."created_at" BETWEEN 1577836800000000
                                   AND     1609459199000000
        GROUP BY 1
      )
      SELECT mm."order_month",
             p."name",
             (p."retail_price" - p."cost") AS "profit"
      FROM   month_min                    mm
      JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
             ON TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM') = mm."order_month"
      JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
             ON p."id" = oi."product_id"
      WHERE  (p."retail_price" - p."cost") = mm."min_profit"
) m_p
ORDER BY m_p."order_month"
LIMIT  20;
```

```sql
--Description: Same final query but grouped for readability, ready for reporting  
WITH month_min AS (
  SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000), 'YYYY-MM') AS "order_month",
         MIN(p."retail_price" - p."cost") AS "min_profit"
  FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
  JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
         ON p."id" = oi."product_id"
  WHERE  oi."created_at" BETWEEN 1577836800000000
                             AND     1609459199000000
  GROUP BY 1
)
SELECT mm."order_month",
       LISTAGG(DISTINCT p."name", ', ') WITHIN GROUP (ORDER BY p."name") AS "product_with_lowest_profit",
       mm."min_profit"
FROM   month_min                    mm
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
       ON TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM') = mm."order_month"
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
       ON p."id" = oi."product_id"
WHERE  (p."retail_price" - p."cost") = mm."min_profit"
GROUP  BY mm."order_month", mm."min_profit"
ORDER  BY mm."order_month"
LIMIT  20;
```
