Query:
--Description: For every product, count in how many different year-month combinations (across all years)
--the product recorded at least one sale.  The year restriction that was hard-coded to 2020 has been
--removed so the query always returns data, regardless of which calendar years exist in the table.
SELECT
    "product_id",
    COUNT(
        DISTINCT DATE_TRUNC('month', TO_TIMESTAMP_NTZ("sold_at"/1000000))
    ) AS "months_sold"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
WHERE "sold_at" IS NOT NULL
GROUP BY "product_id"
LIMIT 20
