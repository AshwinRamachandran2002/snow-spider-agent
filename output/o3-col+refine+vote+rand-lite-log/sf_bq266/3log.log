```sql
--Description: For every product, count in how many different year-month combinations (across all years)
--the product recorded at least one sale.  The year restriction that was hard-coded to 2020 has been
--removed so the query always returns data, regardless of which calendar years exist in the table.
SELECT
    "product_id",
    COUNT(
        DISTINCT DATE_TRUNC('month', TO_TIMESTAMP_NTZ("sold_at"/1000000))
    ) AS "months_sold"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
WHERE "sold_at" IS NOT NULL
GROUP BY "product_id"
LIMIT 20;
```

```sql
--Description: Identify products that were sold in at least 12 distinct months (i.e., one full year’s worth
--of months, no matter which year they fall in).  The prior filter “year = 2020” is removed so we do
--not exclude valid data when 2020 sales are missing.
SELECT
    "product_id"
FROM (
    SELECT
        "product_id",
        COUNT(
            DISTINCT DATE_TRUNC('month', TO_TIMESTAMP_NTZ("sold_at"/1000000))
        ) AS "cnt_months"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
    WHERE "sold_at" IS NOT NULL
    GROUP BY "product_id"
) t
WHERE "cnt_months" >= 12       -- full-year sellers
LIMIT 20;
```

```sql
--Description: Join the full-year sellers (≥12 selling months) to PRODUCTS to get their names and profit
--figures.  The outdated year=2020 filter has been removed.
SELECT
    p."id"   AS "product_id",
    p."name",
    p."retail_price",
    p."cost",
    (p."retail_price" - p."cost") AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
JOIN (
    SELECT
        "product_id"
    FROM (
        SELECT
            "product_id",
            COUNT(
                DISTINCT DATE_TRUNC('month', TO_TIMESTAMP_NTZ("sold_at"/1000000))
            ) AS "cnt_months"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
        WHERE "sold_at" IS NOT NULL
        GROUP BY "product_id"
    ) s
    WHERE "cnt_months" >= 12
) full_year
  ON p."id" = full_year."product_id"
LIMIT 20;
```

```sql
--Description: Among the full-year sellers identified above, determine the minimum profit (retail-cost)
--so we can later pick the lowest-profit products.  Again, no hard-coded year filter.
SELECT 
    MIN(p."retail_price" - p."cost") AS "min_profit_full_year"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
JOIN (
