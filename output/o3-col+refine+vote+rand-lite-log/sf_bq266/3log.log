```sql
--Description: For every calendar month in 2020,
--1) locate the products that recorded at least one sale (INVENTORY_ITEMS),
--2) calculate each product’s profit (retail_price – cost) from PRODUCTS,
--3) find the minimum profit for that month,
--4) return the names of the product(s) whose profit equals that monthly minimum.
--Months in which no sales occurred are naturally excluded.
WITH sales_2020 AS (
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP_NTZ(i."sold_at"/1000000))  AS "month_2020",
        i."product_id"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
    WHERE i."sold_at" IS NOT NULL
      AND EXTRACT(year FROM TO_TIMESTAMP_NTZ(i."sold_at"/1000000)) = 2020
),
product_profit AS (
    SELECT
        p."id"                         AS "product_id",
        p."name",
        (p."retail_price" - p."cost")  AS "profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
),
combined AS (
    SELECT
        s."month_2020",
        pp."name",
        pp."profit"
    FROM sales_2020 s
    JOIN product_profit pp
      ON pp."product_id" = s."product_id"
),
min_profit_per_month AS (
    SELECT
        "month_2020",
        MIN("profit") AS "min_profit"
    FROM combined
    GROUP BY "month_2020"
)
SELECT
    c."month_2020",
    c."name"
FROM combined c
JOIN min_profit_per_month m
  ON c."month_2020" = m."month_2020"
 AND c."profit"     = m."min_profit"
ORDER BY c."month_2020";
```
