/* -------------------------------------------------------------
   Lowest-profit product(s) that logged at least one sale in
   every 2020 month that has ANY sales data.  Months with zero
   sales for all products are ignored by definition.
   ------------------------------------------------------------- */
WITH sales_2020 AS (                 -- every sale made during 2020
    SELECT
        "product_id",
        DATE_TRUNC('month', TO_TIMESTAMP_NTZ("sold_at" / 1000000)) AS "sale_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
    WHERE "sold_at" IS NOT NULL
      AND YEAR(TO_TIMESTAMP_NTZ("sold_at" / 1000000)) = 2020
),

months_2020 AS (                     -- distinct months that actually contain sales
    SELECT DISTINCT "sale_month"
    FROM sales_2020
),

month_count AS (                     -- how many such months exist
    SELECT COUNT(*) AS "total_months"
    FROM months_2020
),

product_month_counts AS (            -- for each product, how many of those months it sold
    SELECT
        "product_id",
        COUNT(DISTINCT "sale_month") AS "cnt_months_2020"
    FROM sales_2020
    GROUP BY "product_id"
),

full_coverage_products AS (          -- products that sold in *every* available month
    SELECT pm."product_id"
    FROM product_month_counts pm
    JOIN month_count mc
      ON pm."cnt_months_2020" = mc."total_months"
),

profit_tbl AS (                      -- profit for the full-coverage products
    SELECT
        p."id"                                  AS "product_id",
        p."name",
        (p."retail_price" - p."cost")           AS "profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
    JOIN full_coverage_products fcp
      ON p."id" = fcp."product_id"
),

min_profit AS (                      -- minimum profit among those products
    SELECT MIN("profit") AS "min_profit"
    FROM profit_tbl
)

