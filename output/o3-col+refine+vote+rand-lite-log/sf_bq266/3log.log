Query:
--Description: Identify the lowest-profit product(s) among those that sell in ≥12 distinct
--months (i.e., full-year sellers), then list every year-month in which those product(s)
--registered a sale.  This re-writes the earlier query to (a) avoid exact floating-point
--comparisons until after the minimum profit is calculated, (b) rely on DISTINCT rather
--than GROUP BY when only two columns are selected, and (c) drop the hard LIMIT that
--previously suppressed output when no rows met the equality filter.
WITH full_year AS (
    SELECT
        "product_id",
        COUNT(DISTINCT DATE_TRUNC('month', TO_TIMESTAMP_NTZ("sold_at"/1000000))) AS "cnt_months"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
    WHERE "sold_at" IS NOT NULL
    GROUP BY "product_id"
    HAVING "cnt_months" >= 12               -- sold in at least 12 months overall
),
profit_tbl AS (
    SELECT
        p."id"                       AS "product_id",
        p."name",
        (p."retail_price" - p."cost") AS "profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
    JOIN full_year fy ON fy."product_id" = p."id"
),
min_profit AS (
    SELECT MIN("profit") AS "min_profit" FROM profit_tbl
)
SELECT DISTINCT
       DATE_TRUNC('month', TO_TIMESTAMP_NTZ(i."sold_at"/1000000)) AS "sale_month",
       pt."name"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
JOIN profit_tbl  pt    ON pt."product_id" = i."product_id"
JOIN min_profit  mp    ON pt."profit"     = mp."min_profit"
WHERE i."sold_at" IS NOT NULL
ORDER BY "sale_month"
