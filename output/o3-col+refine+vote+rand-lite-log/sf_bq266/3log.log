Query:
--Description: Among the full-year sellers identified above, determine the minimum profit (retail-cost)
--so we can later pick the lowest-profit products.  Again, no hard-coded year filter.
SELECT 
    MIN(p."retail_price" - p."cost") AS "min_profit_full_year"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
JOIN (
    SELECT "product_id"
    FROM (
        SELECT
            "product_id",
            COUNT(
                DISTINCT DATE_TRUNC('month', TO_TIMESTAMP_NTZ("sold_at"/1000000))
            ) AS "cnt_months"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
        WHERE "sold_at" IS NOT NULL
        GROUP BY "product_id"
    ) s
    WHERE "cnt_months" >= 12
) fy ON p."id" = fy."product_id"
