/*  -----------------------------------------------------------
    Lowest-profit product(s) that recorded at least one sale in
    every month of calendar-year 2020, listed month-by-month.
    ----------------------------------------------------------- */
WITH sales_2020 AS (      -- all 2020 sales, month-granular
    SELECT
        "product_id",
        DATE_TRUNC('month', TO_TIMESTAMP_NTZ("sold_at"/1000000)) AS "sale_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
    WHERE "sold_at" IS NOT NULL
      AND YEAR(TO_TIMESTAMP_NTZ("sold_at"/1000000)) = 2020
),
full_year_2020 AS (       -- products that sold in every month (12 distinct)
    SELECT
        "product_id"
    FROM sales_2020
    GROUP BY "product_id"
    HAVING COUNT(DISTINCT "sale_month") = 12
),
profit_tbl AS (           -- profit for those full-year products
    SELECT
        p."id"                                    AS "product_id",
        p."name",
        (p."retail_price" - p."cost")             AS "profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
    JOIN full_year_2020 fy
