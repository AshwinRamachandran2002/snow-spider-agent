--Description: Identify products that were sold in at least 12 distinct months (i.e., one full year’s worth
--of months, no matter which year they fall in).  The prior filter “year = 2020” is removed so we do
--not exclude valid data when 2020 sales are missing.
SELECT
    "product_id"
FROM (
    SELECT
        "product_id",
        COUNT(
            DISTINCT DATE_TRUNC('month', TO_TIMESTAMP_NTZ("sold_at"/1000000))
        ) AS "cnt_months"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
    WHERE "sold_at" IS NOT NULL
    GROUP BY "product_id"
) t
WHERE "cnt_months" >= 12       -- full-year sellers
LIMIT 20
