Query:
-- Description: Identify the product(s) that achieved the monthly MIN profit in 2020
WITH monthly_min AS (
    SELECT 
        TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY-MM') AS "year_month",
        MIN(p."retail_price" - p."cost")  AS "min_profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
          ON p."id" = oi."product_id"
    WHERE TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY') = '2020'
    GROUP BY 1
)
SELECT 
    mm."year_month",
    p."name"                 AS "product_name",
    p."retail_price" - p."cost"  AS "profit_per_unit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
      ON p."id" = oi."product_id"
JOIN monthly_min mm
      ON mm."year_month" = TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY-MM')
     AND mm."min_profit" = (p."retail_price" - p."cost")
WHERE TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY') = '2020'
GROUP BY 1,2,3
ORDER BY mm."year_month"
LIMIT 20;
