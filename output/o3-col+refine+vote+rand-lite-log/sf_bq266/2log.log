```sql
-- Description: Quick glance at a handful of products so we know the columns we will need later
SELECT 
    "id",
    "name",
    "cost",
    "retail_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
LIMIT 20;
```

```sql
-- Description: Peek at a few ORDER_ITEMS records to understand the time-stamp scale and linkage to PRODUCT_ID
SELECT 
    "id",
    "product_id",
    "order_id",
    "created_at",
    "sale_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
LIMIT 20;
```

```sql
-- Description: Convert MICRO-seconds in ORDER_ITEMS."created_at" to a readable timestamp and limit to 2020 for a quick sanity check
SELECT 
    "id",
    "product_id",
    TO_TIMESTAMP_LTZ("created_at"/1000000)   AS "event_ts"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
WHERE TO_CHAR(TO_TIMESTAMP_LTZ("created_at"/1000000),'YYYY') = '2020'
LIMIT 20;
```

```sql
-- Description: Distinct list of months (yyyy-mm) in 2020 that actually have sales records, to verify coverage
SELECT DISTINCT
    TO_CHAR(TO_TIMESTAMP_LTZ("created_at"/1000000),'YYYY-MM') AS "year_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
WHERE TO_CHAR(TO_TIMESTAMP_LTZ("created_at"/1000000),'YYYY') = '2020'
ORDER BY "year_month"
LIMIT 20;
```

```sql
-- Description: Join ORDER_ITEMS with PRODUCTS for 2020 sales and calculate product-level profit (retail minus cost) for each sold row
SELECT 
    oi."id"                             AS "order_item_id",
    p."id"                              AS "product_id",
    p."name"                            AS "product_name",
    p."retail_price",
    p."cost",
    (p."retail_price" - p."cost")       AS "profit_per_unit",
    TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY-MM') AS "year_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
      ON p."id" = oi."product_id"
WHERE TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY') = '2020'
LIMIT 20;
```

```sql
-- Description: For every month in 2020, compute the lowest profit (retail ‑ cost) observed
SELECT 
    TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY-MM') AS "year_month",
    MIN(p."retail_price" - p."cost")  AS "min_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
      ON p."id" = oi."product_id"
WHERE TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY') = '2020'
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
-- Description: Identify the product(s) that achieved the monthly MIN profit in 2020
WITH monthly_min AS (
    SELECT 
        TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY-MM') AS "year_month",
        MIN(p."retail_price" - p."cost")  AS "min_profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
          ON p."id" = oi."product_id"
    WHERE TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY') = '2020'
    GROUP BY 1
)
SELECT 
    mm."year_month",
    p."name"                 AS "product_name",
    p."retail_price" - p."cost"  AS "profit_per_unit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
      ON p."id" = oi."product_id"
JOIN monthly_min mm
      ON mm."year_month" = TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY-MM')
     AND mm."min_profit" = (p."retail_price" - p."cost")
WHERE TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY') = '2020'
GROUP BY 1,2,3
ORDER BY mm."year_month"
LIMIT 20;
```

```sql
-- Description: Final sanity check – count how many products share the lowest profit each month (to know if ties exist)
WITH monthly_min AS (
    SELECT 
        TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY-MM') AS "year_month",
        MIN(p."retail_price" - p."cost") AS "min_profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
          ON p."id" = oi."product_id"
    WHERE TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY') = '2020'
    GROUP BY 1
)
SELECT 
    mm."year_month",
    COUNT(DISTINCT p."name")           AS "num_products_with_min_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
      ON p."id" = oi."product_id"
JOIN monthly_min mm
      ON mm."year_month" = TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY-MM')
     AND mm."min_profit" = (p."retail_price" - p."cost")
WHERE TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY') = '2020'
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
-- Description: (Optional deeper dive) List every 2020 sale record for the single lowest-profit product(s) of January 2020
WITH jan_min AS (
    SELECT 
        MIN(p."retail_price" - p."cost") AS "min_profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
          ON p."id" = oi."product_id"
    WHERE TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY-MM') = '2020-01'
)
SELECT 
    oi."id"               AS "order_item_id",
    p."name"              AS "product_name",
    (p."retail_price" - p."cost") AS "profit_per_unit",
    TO_TIMESTAMP_LTZ(oi."created_at"/1000000) AS "event_ts"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
      ON p."id" = oi."product_id"
JOIN jan_min jm
      ON jm."min_profit" = (p."retail_price" - p."cost")
WHERE TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000),'YYYY-MM') = '2020-01'
LIMIT 20;
```

