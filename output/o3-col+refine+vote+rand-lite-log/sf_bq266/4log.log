LIMIT 20;
```

```sql
--Description: 6) For every 2020 month, rank products by (retail – cost) ascending  
SELECT
    TO_CHAR(DATE_TRUNC('month', TO_TIMESTAMP_NTZ("I"."sold_at"/1000000)), 'YYYY-MM')          AS "month_2020",
    "P"."name"                                                                               AS "product_name",
    ("P"."retail_price" - "P"."cost")                                                        AS "profit",
    ROW_NUMBER() OVER (
        PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP_NTZ("I"."sold_at"/1000000))
        ORDER BY ("P"."retail_price" - "P"."cost")  ASC
    )                                                                                        AS "rn"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS"   AS "I"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"          AS "P"
       ON "I"."product_id" = "P"."id"
WHERE  "I"."sold_at" BETWEEN 1577836800000000 AND 1609459199000000
LIMIT 20;
```

```sql
--Description: 7) FINAL ANSWER – one row per month: product that had 2020 sales & lowest profit  
SELECT
    "month_2020",
    "product_name",
    "profit"
FROM (
    SELECT
        TO_CHAR(DATE_TRUNC('month', TO_TIMESTAMP_NTZ("I"."sold_at"/1000000)), 'YYYY-MM')   AS "month_2020",
        "P"."name"                                                                        AS "product_name",
        ("P"."retail_price" - "P"."cost")                                                 AS "profit",
        ROW_NUMBER() OVER (
            PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP_NTZ("I"."sold_at"/1000000))
            ORDER BY ("P"."retail_price" - "P"."cost") ASC
        )                                                                                 AS "rn"
    FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS"  AS "I"
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"         AS "P"
           ON "I"."product_id" = "P"."id"
    WHERE  "I"."sold_at" BETWEEN 1577836800000000 AND 1609459199000000
) t
WHERE "rn" = 1
ORDER BY "month_2020"
LIMIT 20;
```

Each successive query adds insight—from a quick peek at 2020 sales, to isolating months, to spotting the lowest-profit items per month, and finally returning the chronologically ordered list of 2020 months with the single lowest-profit product for each.
