Query:
--Description: 1) Peek at 2020 sales records with product data and a quick profit calculation  
SELECT
    "I"."id"                                         AS "inventory_item_id",
    "I"."product_id",
    TO_TIMESTAMP_NTZ("I"."sold_at"/1000000)          AS "sold_date",
    "P"."name"                                       AS "product_name",
    "P"."retail_price",
    "P"."cost",
    ("P"."retail_price" - "P"."cost")                AS "profit"
FROM  "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS"  AS "I"
JOIN  "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"         AS "P"
      ON "I"."product_id" = "P"."id"
WHERE "I"."sold_at" BETWEEN 1577836800000000 AND 1609459199000000   -- the year 2020
LIMIT 20;
