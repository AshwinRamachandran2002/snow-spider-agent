```sql
--Description: Inspect distinct purchase year-month values to confirm date format.  
SELECT DISTINCT substr("order_purchase_timestamp", 1, 7) AS "purchase_year_month"
FROM "olist_orders"
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Inspect distinct delivered year-month values (based on customer delivery date).  
SELECT DISTINCT substr("order_delivered_customer_date", 1, 7) AS "delivered_year_month"
FROM "olist_orders"
WHERE "order_status" = 'delivered'
ORDER BY 1
LIMIT 20;
```

```sql
--Description: List the distinct years in which delivered orders occurred (using delivered date).  
SELECT DISTINCT substr("order_delivered_customer_date", 1, 4) AS "year"
FROM "olist_orders"
WHERE "order_status" = 'delivered'
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Get delivered-order counts by year-month (all years).  
SELECT substr("order_delivered_customer_date", 1, 7) AS "year_month",
       COUNT(DISTINCT "order_id")                  AS "delivered_orders"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
GROUP  BY substr("order_delivered_customer_date", 1, 7)
ORDER  BY 1
LIMIT 20;
```

```sql
--Description: Show counts for 2016 only, grouped by month.  
SELECT substr("order_delivered_customer_date", 6, 2) AS "month",
       COUNT(DISTINCT "order_id")                    AS "orders_2016"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
  AND  substr("order_delivered_customer_date", 1, 4) = '2016'
GROUP  BY substr("order_delivered_customer_date", 6, 2)
ORDER  BY 1
LIMIT 20;
```

```sql
--Description: Show counts for 2017 only, grouped by month.  
SELECT substr("order_delivered_customer_date", 6, 2) AS "month",
       COUNT(DISTINCT "order_id")                    AS "orders_2017"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
  AND  substr("order_delivered_customer_date", 1, 4) = '2017'
GROUP  BY substr("order_delivered_customer_date", 6, 2)
ORDER  BY 1
LIMIT 20;
```

```sql
--Description: Show counts for 2018 only, grouped by month.  
SELECT substr("order_delivered_customer_date", 6, 2) AS "month",
       COUNT(DISTINCT "order_id")                    AS "orders_2018"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
  AND  substr("order_delivered_customer_date", 1, 4) = '2018'
GROUP  BY substr("order_delivered_customer_date", 6, 2)
ORDER  BY 1
LIMIT 20;
```

```sql
--Description: Final pivot-style report – delivered orders per month with a column for each year 2016-2018.  
SELECT substr("order_delivered_customer_date", 6, 2)                                  AS "month",
       SUM(CASE WHEN substr("order_delivered_customer_date", 1, 4) = '2016' THEN 1 ELSE 0 END) AS "2016",
       SUM(CASE WHEN substr("order_delivered_customer_date", 1, 4) = '2017' THEN 1 ELSE 0 END) AS "2017",
       SUM(CASE WHEN substr("order_delivered_customer_date", 1, 4) = '2018' THEN 1 ELSE 0 END) AS "2018"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
  AND  substr("order_delivered_customer_date", 1, 4) IN ('2016','2017','2018')
GROUP  BY substr("order_delivered_customer_date", 6, 2)
ORDER  BY "month"
LIMIT 20;
```

```sql
--Description: (Optional) Verify total delivered-order count across the three years.  
SELECT COUNT(DISTINCT "order_id") AS "total_delivered_2016_to_2018"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
  AND  substr("order_delivered_customer_date", 1, 4) IN ('2016','2017','2018')
LIMIT 20;
```
