Query:
-- Description: 3) Extract the year part of the delivered date for delivered orders and list the different years present.
SELECT DISTINCT substr("order_delivered_customer_date",1,4) AS year_delivered
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
      AND "order_delivered_customer_date" IS NOT NULL
LIMIT 20;
Answer:
year_delivered
2017
2018
2016
Query:
-- Description: 4) Count how many delivered orders there are in each year (quick sanity check).
SELECT substr("order_delivered_customer_date",1,4) AS year_delivered,
       COUNT(*) AS delivered_orders
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
      AND "order_delivered_customer_date" IS NOT NULL
GROUP BY year_delivered
ORDER BY year_delivered
LIMIT 20;
Answer:
year_delivered,delivered_orders
2016,267
2017,40930
2018,55273
