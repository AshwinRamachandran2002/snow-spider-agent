```sql
-- Description: 4) Count how many delivered orders there are in each year (quick sanity check).
SELECT substr("order_delivered_customer_date",1,4) AS year_delivered,
       COUNT(*) AS delivered_orders
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
      AND "order_delivered_customer_date" IS NOT NULL
GROUP BY year_delivered
ORDER BY year_delivered
LIMIT 20;
```

```sql
-- Description: 5) Get counts of delivered orders for every year-month combination (YYYY-MM).
SELECT substr("order_delivered_customer_date",1,7) AS year_month,
       COUNT(*) AS delivered_orders
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
      AND "order_delivered_customer_date" IS NOT NULL
GROUP BY year_month
ORDER BY year_month
LIMIT 20;
```

```sql
-- Description: 6) Same as above but only for 2016–2018, still by year-month.
