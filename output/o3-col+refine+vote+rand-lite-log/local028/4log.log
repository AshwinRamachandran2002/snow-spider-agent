```sql
-- Description: ④  Count how many delivered orders we have per year-month (partial view)
SELECT substr("order_delivered_customer_date", 1, 4) AS "year",
       substr("order_delivered_customer_date", 6, 2) AS "month",
       COUNT(*) AS "delivered_orders"
FROM "olist_orders"
WHERE "order_status" = 'delivered'
  AND substr("order_delivered_customer_date", 1, 4) IN ('2016', '2017', '2018')
GROUP BY "year", "month"
ORDER BY "year", "month"
LIMIT 20;
```

```sql
