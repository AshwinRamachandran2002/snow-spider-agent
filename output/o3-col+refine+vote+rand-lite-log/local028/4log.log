       COUNT(*) AS "delivered_orders_2017"
FROM "olist_orders"
WHERE "order_status" = 'delivered'
  AND substr("order_delivered_customer_date", 1, 4) = '2017'
GROUP BY "month_2017"
ORDER BY "month_2017"
LIMIT 20;
