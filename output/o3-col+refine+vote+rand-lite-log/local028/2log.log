```sql
-- 1. Explore all possible order statuses that exist in the sales data
--    (to confirm that the status value we are interested in is "delivered").
SELECT DISTINCT "order_status"
FROM "olist_orders"
LIMIT 20;
```

```sql
-- 2. Inspect the different years that appear in the order purchase timestamp
--    so we know which years need to be included in our report.
SELECT DISTINCT substr("order_purchase_timestamp", 1, 4) AS "year"
FROM "olist_orders"
ORDER BY "year"
LIMIT 20;
```

```sql
-- 3. Inspect the month component that appears in the purchase timestamp
--    to double-check that it ranges from '01' … '12'.
SELECT DISTINCT substr("order_purchase_timestamp", 6, 2) AS "month"
FROM "olist_orders"
ORDER BY "month"
LIMIT 20;
```

```sql
-- 4. Count how many orders reached the “delivered” status in each year.
SELECT substr("order_purchase_timestamp", 1, 4)      AS "year",
       COUNT(*)                                      AS "delivered_orders"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
GROUP  BY substr("order_purchase_timestamp", 1, 4)
ORDER  BY "year"
LIMIT 20;
```

```sql
-- 5. Count the number of delivered orders per year-month (YYYY-MM) so we
--    can see the granularity that will feed our final pivot table.
SELECT substr("order_purchase_timestamp", 1, 7)       AS "year_month",
       COUNT(*)                                       AS "delivered_orders"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
GROUP  BY substr("order_purchase_timestamp", 1, 7)
ORDER  BY "year_month"
LIMIT 20;
```

```sql
-- 6. Preview which years appear when we look at the *delivered date* field
--    (as an extra sanity check – it’s very similar to purchase year).
SELECT DISTINCT substr("order_delivered_customer_date", 1, 4) AS "year_delivered"
FROM   "olist_orders"
ORDER  BY "year_delivered"
LIMIT 20;
```

```sql
-- 7. Compare counts by *delivered year* to be sure they align with the
--    purchase-based counts we saw earlier.
SELECT substr("order_delivered_customer_date", 1, 4)  AS "year_delivered",
       COUNT(*)                                       AS "delivered_orders"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
GROUP  BY substr("order_delivered_customer_date", 1, 4)
ORDER  BY "year_delivered"
LIMIT 20;
```

```sql
-- 8. Count delivered orders per delivered year-month as another angle
--    before we pivot (optional deeper exploration).
SELECT substr("order_delivered_customer_date", 1, 7)  AS "year_month_delivered",
       COUNT(*)                                       AS "delivered_orders"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
GROUP  BY substr("order_delivered_customer_date", 1, 7)
ORDER  BY "year_month_delivered"
LIMIT 20;
```

```sql
-- 9. (Optional) List the first 20 delivered orders with dates for spot-checking.
SELECT "order_id",
       "order_status",
       "order_purchase_timestamp",
       "order_delivered_customer_date"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
ORDER  BY "order_purchase_timestamp"
LIMIT 20;
```

```sql
-- 10. FINAL REPORT – number of delivered orders for each month (rows)
--     with separate columns for 2016, 2017, and 2018.
SELECT substr("order_purchase_timestamp", 6, 2)                                   AS "month",
       SUM(CASE WHEN substr("order_purchase_timestamp", 1, 4) = '2016' THEN 1 END) AS "2016",
       SUM(CASE WHEN substr("order_purchase_timestamp", 1, 4) = '2017' THEN 1 END) AS "2017",
       SUM(CASE WHEN substr("order_purchase_timestamp", 1, 4) = '2018' THEN 1 END) AS "2018"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
GROUP  BY substr("order_purchase_timestamp", 6, 2)
ORDER  BY "month"
LIMIT 20;
```
