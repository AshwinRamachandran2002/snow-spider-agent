-- 10. FINAL REPORT – number of delivered orders for each month (rows)
--     with separate columns for 2016, 2017, and 2018.
SELECT substr("order_purchase_timestamp", 6, 2)                                   AS "month",
       SUM(CASE WHEN substr("order_purchase_timestamp", 1, 4) = '2016' THEN 1 END) AS "2016",
       SUM(CASE WHEN substr("order_purchase_timestamp", 1, 4) = '2017' THEN 1 END) AS "2017",
       SUM(CASE WHEN substr("order_purchase_timestamp", 1, 4) = '2018' THEN 1 END) AS "2018"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
GROUP  BY substr("order_purchase_timestamp", 6, 2)
ORDER  BY "month"
LIMIT 20;
