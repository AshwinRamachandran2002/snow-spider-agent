```sql
--Description: List English-language (id = 1) films in the “Children” category, rated G or PG, 
--with a running time ≤ 120 min, released between 2000-2010.
SELECT DISTINCT f.film_id,
       f.title,
       f.release_year,
       f.length,
       f.rating
FROM film             AS f
JOIN film_category     AS fc ON f.film_id = fc.film_id
JOIN category          AS c  ON fc.category_id = c.category_id
WHERE c.name = 'Children'
  AND f.language_id = 1               -- English
  AND f.rating IN ('G','PG')
  AND f.length <= 120
  AND CAST(f.release_year AS INTEGER) BETWEEN 2000 AND 2010
LIMIT 20;
```

```sql
--Description: Show the distinct actor_ids who performed in the qualifying films above.
SELECT DISTINCT fa.actor_id
FROM film_actor AS fa
JOIN (
        SELECT f.film_id
        FROM film AS f
        JOIN film_category AS fc ON f.film_id = fc.film_id
        JOIN category      AS c  ON fc.category_id = c.category_id
        WHERE c.name = 'Children'
          AND f.language_id = 1
          AND f.rating IN ('G','PG')
          AND f.length <= 120
          AND CAST(f.release_year AS INTEGER) BETWEEN 2000 AND 2010
     ) AS eligible_films
  ON fa.film_id = eligible_films.film_id
LIMIT 20;
```

```sql
--Description: Count how many times each actor appears in the qualifying films.
SELECT fa.actor_id,
       COUNT(*) AS appearances
FROM film_actor AS fa
JOIN (
        SELECT f.film_id
        FROM film AS f
        JOIN film_category AS fc ON f.film_id = fc.film_id
        JOIN category      AS c  ON fc.category_id = c.category_id
        WHERE c.name = 'Children'
          AND f.language_id = 1
          AND f.rating IN ('G','PG')
          AND f.length <= 120
          AND CAST(f.release_year AS INTEGER) BETWEEN 2000 AND 2010
     ) AS eligible_films
  ON fa.film_id = eligible_films.film_id
GROUP BY fa.actor_id
ORDER BY appearances DESC
LIMIT 20;
```

```sql
--Description: Return the full name of the actor with the most such appearances (top 1).
SELECT a.actor_id,
       a.first_name || ' ' || a.last_name AS full_name,
       COUNT(*) AS appearances
FROM actor       AS a
JOIN film_actor  AS fa ON a.actor_id = fa.actor_id
JOIN (
        SELECT f.film_id
        FROM film AS f
        JOIN film_category AS fc ON f.film_id = fc.film_id
        JOIN category      AS c  ON fc.category_id = c.category_id
        WHERE c.name = 'Children'
          AND f.language_id = 1
          AND f.rating IN ('G','PG')
          AND f.length <= 120
          AND CAST(f.release_year AS INTEGER) BETWEEN 2000 AND 2010
     ) AS eligible_films
  ON fa.film_id = eligible_films.film_id
GROUP BY a.actor_id
ORDER BY appearances DESC
LIMIT 1;
```

```sql
