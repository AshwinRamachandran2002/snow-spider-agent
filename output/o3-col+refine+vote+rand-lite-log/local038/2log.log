```sql
--1. Find the language_id that corresponds to English. 
SELECT DISTINCT language_id, name 
FROM language 
WHERE name = 'English' 
LIMIT 20;
```

```sql
--2. Find the category_id for the Children category.
SELECT DISTINCT category_id, name 
FROM category 
WHERE name = 'Children' 
LIMIT 20;
```

```sql
--3. List films released between 2000-2010, rated G or PG, ≤120 minutes, and in English.
SELECT DISTINCT film_id, title 
FROM film
WHERE release_year BETWEEN '2000' AND '2010'
  AND rating IN ('G','PG')
  AND length <= 120
  AND language_id = (SELECT language_id FROM language WHERE name = 'English')
LIMIT 20;
```

```sql
--4. List all films that belong to the Children category.
SELECT DISTINCT fc.film_id
FROM film_category AS fc
WHERE fc.category_id = (SELECT category_id FROM category WHERE name = 'Children')
LIMIT 20;
```

```sql
--5. Films that satisfy BOTH sets of conditions (Children category + English, G/PG, ≤120 min, 2000-2010).
SELECT DISTINCT f.film_id, f.title
FROM film AS f
JOIN film_category AS fc
  ON f.film_id = fc.film_id
WHERE f.release_year BETWEEN '2000' AND '2010'
  AND f.rating IN ('G','PG')
  AND f.length <= 120
  AND f.language_id = (SELECT language_id FROM language WHERE name = 'English')
  AND fc.category_id = (SELECT category_id FROM category WHERE name = 'Children')
LIMIT 20;
```

```sql
--6. Retrieve actors who starred in the qualifying films.
SELECT DISTINCT fa.actor_id, fa.film_id
FROM film_actor AS fa
WHERE fa.film_id IN (
      SELECT f.film_id
      FROM film AS f
      JOIN film_category AS fc
        ON f.film_id = fc.film_id
      WHERE f.release_year BETWEEN '2000' AND '2010'
        AND f.rating IN ('G','PG')
        AND f.length <= 120
        AND f.language_id = (SELECT language_id FROM language WHERE name = 'English')
        AND fc.category_id = (SELECT category_id FROM category WHERE name = 'Children')
)
LIMIT 20;
```

```sql
--7. Count how many qualifying films each actor appeared in.
SELECT a.actor_id,
       a.first_name || ' ' || a.last_name AS full_name,
       COUNT(*) AS film_count
FROM actor AS a
JOIN film_actor AS fa
  ON a.actor_id = fa.actor_id
WHERE fa.film_id IN (
      SELECT f.film_id
      FROM film AS f
      JOIN film_category AS fc
        ON f.film_id = fc.film_id
      WHERE f.release_year BETWEEN '2000' AND '2010'
        AND f.rating IN ('G','PG')
        AND f.length <= 120
        AND f.language_id = (SELECT language_id FROM language WHERE name = 'English')
        AND fc.category_id = (SELECT category_id FROM category WHERE name = 'Children')
)
GROUP BY a.actor_id, full_name
ORDER BY film_count DESC
LIMIT 20;
```

```sql
--8. FINAL ANSWER: actor who starred most frequently in the specified films.
SELECT a.first_name || ' ' || a.last_name AS full_name
FROM actor AS a
JOIN film_actor AS fa
  ON a.actor_id = fa.actor_id
WHERE fa.film_id IN (
      SELECT f.film_id
      FROM film AS f
      JOIN film_category AS fc
        ON f.film_id = fc.film_id
      WHERE f.release_year BETWEEN '2000' AND '2010'
        AND f.rating IN ('G','PG')
        AND f.length <= 120
        AND f.language_id = (SELECT language_id FROM language WHERE name = 'English')
        AND fc.category_id = (SELECT category_id FROM category WHERE name = 'Children')
)
GROUP BY a.actor_id, full_name
ORDER BY COUNT(*) DESC
LIMIT 1;
```
