```sql
--Description: 1) Preview available film categories and their IDs (top 20 rows)  
SELECT DISTINCT category_id, name 
FROM category 
LIMIT 20;
```

```sql
--Description: 2) Capture the category_id that corresponds to ‘Children’  
SELECT DISTINCT category_id 
FROM category 
WHERE name = 'Children' 
LIMIT 20;
```

```sql
--Description: 3) Preview languages to find the language_id for English  
SELECT DISTINCT language_id, name 
FROM language 
LIMIT 20;
```

```sql
--Description: 4) List films released between 2000-2010 whose original language is English, rated G or PG, and 120 minutes or less  
SELECT DISTINCT film_id, title, release_year, rating, length 
FROM film 
WHERE language_id = 1                 -- English  
  AND release_year BETWEEN '2000' AND '2010' 
  AND rating IN ('G','PG') 
  AND length <= 120 
LIMIT 20;
```

```sql
--Description: 5) Narrow those films further to only the Children category  
SELECT DISTINCT f.film_id, f.title 
FROM film AS f
JOIN film_category AS fc  ON f.film_id = fc.film_id
WHERE fc.category_id = 3              -- (replace 3 with the ID returned in Query 2)
  AND f.language_id = 1
  AND f.release_year BETWEEN '2000' AND '2010'
  AND f.rating IN ('G','PG')
  AND f.length <= 120
LIMIT 20;
```

```sql
--Description: 6) Retrieve every actor who appeared in the qualifying Children-English films  
SELECT DISTINCT fa.actor_id, fa.film_id 
FROM film_actor AS fa
JOIN film AS f               ON f.film_id = fa.film_id
JOIN film_category AS fc     ON f.film_id = fc.film_id
WHERE fc.category_id = 3     -- Children  
  AND f.language_id = 1
  AND f.release_year BETWEEN '2000' AND '2010'
  AND f.rating IN ('G','PG')
  AND f.length <= 120
LIMIT 20;
```

```sql
--Description: 7) Count how many qualifying Children-English films each actor appeared in  
SELECT fa.actor_id, COUNT(*) AS appearances
FROM film_actor AS fa
JOIN film AS f               ON f.film_id = fa.film_id
JOIN film_category AS fc     ON f.film_id = fc.film_id
WHERE fc.category_id = 3
  AND f.language_id = 1
  AND f.release_year BETWEEN '2000' AND '2010'
  AND f.rating IN ('G','PG')
  AND f.length <= 120
GROUP BY fa.actor_id
ORDER BY appearances DESC
LIMIT 20;
```

```sql
--Description: 8) Return the full name of the actor with the highest appearance count in the target films  
SELECT a.first_name || ' ' || a.last_name AS full_name
FROM actor AS a
JOIN (
        SELECT fa.actor_id, COUNT(*) AS appearances
        FROM film_actor AS fa
        JOIN film AS f           ON f.film_id = fa.film_id
        JOIN film_category AS fc ON f.film_id = fc.film_id
        WHERE fc.category_id = 3          -- Children
          AND f.language_id = 1           -- English
          AND f.release_year BETWEEN '2000' AND '2010'
          AND f.rating IN ('G','PG')
          AND f.length <= 120
        GROUP BY fa.actor_id
        ORDER BY appearances DESC
        LIMIT 1
     ) AS top_actor
ON a.actor_id = top_actor.actor_id;
```
