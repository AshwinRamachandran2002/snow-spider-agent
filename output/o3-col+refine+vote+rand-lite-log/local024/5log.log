2025-05-05 04:30:42 - Thread-3286 (execute) - INFO - [Exploration]
```sql
--Description: 1) List all distinct countries represented in the database (player table).
SELECT DISTINCT country_name
FROM player
LIMIT 20;
```

```sql
--Description: 2) How many distinct players appear in the ball-by-ball data (i.e., as striker)?
SELECT COUNT(DISTINCT striker) AS distinct_strikers
FROM ball_by_ball;
```

```sql
--Description: 3) Show 20 sample rows after joining ball_by_ball with batsman_scored
--   to verify the link that lets us obtain runs scored by a striker on each ball.
SELECT bb.match_id,
       bb.over_id,
       bb.ball_id,
       bb.striker,
       bs.runs_scored,
       bs.innings_no
FROM ball_by_ball AS bb
JOIN batsman_scored AS bs
  ON bb.match_id  = bs.match_id
 AND bb.over_id   = bs.over_id
 AND bb.ball_id   = bs.ball_id
 AND bb.innings_no= bs.innings_no
LIMIT 20;
```

```sql
--Description: 4) Total runs made by each player across all matches.
SELECT bb.striker          AS player_id,
       SUM(bs.runs_scored) AS total_runs
FROM ball_by_ball AS bb
JOIN batsman_scored AS bs
  ON bb.match_id  = bs.match_id
 AND bb.over_id   = bs.over_id
 AND bb.ball_id   = bs.ball_id
 AND bb.innings_no= bs.innings_no
GROUP BY bb.striker
LIMIT 20;
```

```sql
--Description: 5) Number of distinct matches played by each player (from player_match).
SELECT player_id,
       COUNT(DISTINCT match_id) AS matches_played
FROM player_match
GROUP BY player_id
LIMIT 20;
```

```sql
--Description: 6) Combine queries (4) & (5) to get every player’s average runs per match.
SELECT r.player_id,
       ROUND(1.0 * r.total_runs / m.matches_played, 2) AS avg_runs_per_match
FROM (
        SELECT bb.striker AS player_id,
               SUM(bs.runs_scored) AS total_runs
        FROM ball_by_ball AS bb
        JOIN batsman_scored AS bs
          ON bb.match_id  = bs.match_id
         AND bb.over_id   = bs.over_id
         AND bb.ball_id   = bs.ball_id
         AND bb.innings_no= bs.innings_no
        GROUP BY bb.striker
     ) AS r
JOIN (
        SELECT player_id,
               COUNT(DISTINCT match_id) AS matches_played
        FROM player_match
        GROUP BY player_id
     ) AS m
  ON r.player_id = m.player_id
LIMIT 20;
```

```sql
--Description: 7) Attach each player’s country to their batting average (preview).
SELECT p.player_name,
       p.country_name,
       av.avg_runs_per_match
FROM player          AS p
JOIN (
        SELECT r.player_id,
               1.0 * r.total_runs / m.matches_played AS avg_runs_per_match
        FROM (
                SELECT bb.striker AS player_id,
                       SUM(bs.runs_scored) AS total_runs
                FROM ball_by_ball AS bb
                JOIN batsman_scored AS bs
                  ON bb.match_id  = bs.match_id
                 AND bb.over_id   = bs.over_id
                 AND bb.ball_id   = bs.ball_id
                 AND bb.innings_no= bs.innings_no
                GROUP BY bb.striker
             ) AS r
        JOIN (
                SELECT player_id,
                       COUNT(DISTINCT match_id) AS matches_played
                FROM player_match
                GROUP BY player_id
             ) AS m
          ON r.player_id = m.player_id
     ) AS av
  ON p.player_id = av.player_id
LIMIT 20;
```

```sql
--Description: 8) For each country, compute the average of its players’ batting averages.
SELECT p.country_name,
       ROUND(AVG(av.avg_runs_per_match), 2) AS country_batting_avg
FROM player AS p
JOIN (
        SELECT r.player_id,
               1.0 * r.total_runs / m.matches_played AS avg_runs_per_match
        FROM (
                SELECT bb.striker AS player_id,
                       SUM(bs.runs_scored) AS total_runs
                FROM ball_by_ball AS bb
                JOIN batsman_scored AS bs
                  ON bb.match_id  = bs.match_id
                 AND bb.over_id   = bs.over_id
                 AND bb.ball_id   = bs.ball_id
                 AND bb.innings_no= bs.innings_no
                GROUP BY bb.striker
             ) AS r
        JOIN (
                SELECT player_id,
                       COUNT(DISTINCT match_id) AS matches_played
                FROM player_match
                GROUP BY player_id
             ) AS m
          ON r.player_id = m.player_id
     ) AS av
  ON p.player_id = av.player_id
GROUP BY p.country_name
LIMIT 20;
```

```sql
--Description: 9) Order the countries by their batting averages and show the top 5.
SELECT p.country_name,
       ROUND(AVG(av.avg_runs_per_match), 2) AS country_batting_avg
FROM player AS p
JOIN (
        SELECT r.player_id,
               1.0 * r.total_runs / m.matches_played AS avg_runs_per_match
        FROM (
                SELECT bb.striker AS player_id,
                       SUM(bs.runs_scored) AS total_runs
                FROM ball_by_ball AS bb
                JOIN batsman_scored AS bs
                  ON bb.match_id  = bs.match_id
                 AND bb.over_id   = bs.over_id
                 AND bb.ball_id   = bs.ball_id
                 AND bb.innings_no= bs.innings_no
                GROUP BY bb.striker
             ) AS r
        JOIN (
                SELECT player_id,
                       COUNT(DISTINCT match_id) AS matches_played
                FROM player_match
                GROUP BY player_id
             ) AS m
          ON r.player_id = m.player_id
     ) AS av
  ON p.player_id = av.player_id
GROUP BY p.country_name
ORDER BY country_batting_avg DESC
LIMIT 5;
```

```sql
--Description: 10) Same as (9) but include the batting average figure in final output as requested.
SELECT p.country_name                                        AS country,
       ROUND(AVG(av.avg_runs_per_match), 2) AS country_batting_average
FROM player AS p
JOIN (
        SELECT r.player_id,
               1.0 * r.total_runs / m.matches_played AS avg_runs_per_match
        FROM (
                SELECT bb.striker AS player_id,
                       SUM(bs.runs_scored) AS total_runs
                FROM ball_by_ball AS bb
                JOIN batsman_scored AS bs
                  ON bb.match_id  = bs.match_id
                 AND bb.over_id   = bs.over_id
                 AND bb.ball_id   = bs.ball_id
                 AND bb.innings_no= bs.innings_no
                GROUP BY bb.striker
             ) AS r
        JOIN (
                SELECT player_id,
                       COUNT(DISTINCT match_id) AS matches_played
                FROM player_match
                GROUP BY player_id
             ) AS m
          ON r.player_id = m.player_id
     ) AS av
  ON p.player_id = av.player_id
GROUP BY p.country_name
ORDER BY country_batting_average DESC
LIMIT 5;
```
