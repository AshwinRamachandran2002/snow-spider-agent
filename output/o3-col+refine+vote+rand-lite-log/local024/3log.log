```sql
-- Description: List some distinct countries present in the player table
SELECT DISTINCT country_name
FROM player
LIMIT 20;
```

```sql
-- Description: Look at a few rows of the player-match mapping to confirm which players appeared in which matches
SELECT DISTINCT match_id, player_id, role, team_id
FROM player_match
LIMIT 20;
```

```sql
-- Description: Inspect a handful of deliveries with the runs scored by the striker
SELECT DISTINCT match_id, over_id, ball_id, striker, runs_scored, innings_no
FROM batsman_scored
LIMIT 20;
```

```sql
-- Description: Aggregate runs per player per match (one row per player–match)
SELECT bb.match_id,
       bb.striker      AS player_id,
       SUM(bs.runs_scored) AS runs_in_match
FROM ball_by_ball AS bb
JOIN batsman_scored AS bs
     ON bb.match_id = bs.match_id
    AND bb.over_id  = bs.over_id
    AND bb.ball_id  = bs.ball_id
    AND bb.innings_no = bs.innings_no
GROUP BY bb.match_id, bb.striker
LIMIT 20;
```

```sql
-- Description: Compute every player’s average runs per match across ALL matches
WITH runs_per_player_match AS (
    SELECT bb.striker AS player_id,
           SUM(bs.runs_scored) AS runs_in_match
    FROM ball_by_ball AS bb
    JOIN batsman_scored AS bs
         ON bb.match_id = bs.match_id
        AND bb.over_id  = bs.over_id
        AND bb.ball_id  = bs.ball_id
        AND bb.innings_no = bs.innings_no
    GROUP BY bb.match_id, bb.striker
)
SELECT player_id,
       AVG(runs_in_match) AS avg_runs_per_match
FROM runs_per_player_match
GROUP BY player_id
LIMIT 20;
```

```sql
-- Description: Attach country to each player’s batting average
WITH player_avg AS (
    SELECT rp.player_id,
           AVG(rp.runs_in_match) AS avg_runs_per_match
    FROM (
        SELECT bb.striker AS player_id,
               SUM(bs.runs_scored) AS runs_in_match
        FROM ball_by_ball AS bb
        JOIN batsman_scored AS bs
             ON bb.match_id = bs.match_id
            AND bb.over_id  = bs.over_id
            AND bb.ball_id  = bs.ball_id
            AND bb.innings_no = bs.innings_no
        GROUP BY bb.match_id, bb.striker
    ) AS rp
    GROUP BY rp.player_id
)
SELECT p.player_name,
       p.country_name,
       pa.avg_runs_per_match
FROM player_avg AS pa
JOIN player     AS p USING (player_id)
LIMIT 20;
```

```sql
-- Description: For each country, compute the average of its players’ individual batting averages
WITH player_avg AS (
    SELECT rp.player_id,
           AVG(rp.runs_in_match) AS avg_runs_per_match
    FROM (
        SELECT bb.striker AS player_id,
               SUM(bs.runs_scored) AS runs_in_match
        FROM ball_by_ball AS bb
        JOIN batsman_scored AS bs
             ON bb.match_id = bs.match_id
            AND bb.over_id  = bs.over_id
            AND bb.ball_id  = bs.ball_id
            AND bb.innings_no = bs.innings_no
        GROUP BY bb.match_id, bb.striker
    ) AS rp
    GROUP BY rp.player_id
)
SELECT p.country_name,
       AVG(pa.avg_runs_per_match) AS country_batting_average
FROM player_avg AS pa
JOIN player AS p USING (player_id)
GROUP BY p.country_name
LIMIT 20;
```

```sql
-- Description: Final answer – top-5 countries ranked by their average of players’ batting averages
WITH player_avg AS (
    SELECT rp.player_id,
           AVG(rp.runs_in_match) AS avg_runs_per_match
    FROM (
        SELECT bb.striker AS player_id,
               SUM(bs.runs_scored) AS runs_in_match
        FROM ball_by_ball AS bb
        JOIN batsman_scored AS bs
             ON bb.match_id = bs.match_id
            AND bb.over_id  = bs.over_id
            AND bb.ball_id  = bs.ball_id
            AND bb.innings_no = bs.innings_no
        GROUP BY bb.match_id, bb.striker
    ) AS rp
    GROUP BY rp.player_id
)
SELECT p.country_name,
       ROUND(AVG(pa.avg_runs_per_match), 2) AS country_batting_average
FROM player_avg AS pa
JOIN player AS p USING (player_id)
GROUP BY p.country_name
ORDER BY country_batting_average DESC
LIMIT 5;
```
