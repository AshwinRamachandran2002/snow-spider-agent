       bb.striker AS player_id,
       SUM(bs.runs_scored) AS runs_in_match
FROM ball_by_ball AS bb
JOIN batsman_scored AS bs
  ON bb.match_id   = bs.match_id
 AND bb.over_id    = bs.over_id
 AND bb.ball_id    = bs.ball_id
 AND bb.innings_no = bs.innings_no
GROUP BY bb.match_id,
         bb.striker
LIMIT 20;
```

```sql
--Description: Determine every player’s average runs per match across all the matches they played
WITH runs_per_player_match AS (
    SELECT bb.striker AS player_id,
           SUM(bs.runs_scored) AS runs_in_match
    FROM ball_by_ball AS bb
    JOIN batsman_scored AS bs
      ON bb.match_id   = bs.match_id
     AND bb.over_id    = bs.over_id
     AND bb.ball_id    = bs.ball_id
     AND bb.innings_no = bs.innings_no
    GROUP BY bb.match_id,
             bb.striker
)
SELECT player_id,
       AVG(runs_in_match) AS avg_runs_per_match
FROM runs_per_player_match
GROUP BY player_id
LIMIT 20;
```

```sql
--Description: Attach each player’s country and show that player’s average runs per match
WITH player_avg AS (
    SELECT rpm.player_id,
           AVG(rpm.runs_in_match) AS avg_runs_per_match
    FROM (
        SELECT bb.striker AS player_id,
               SUM(bs.runs_scored) AS runs_in_match
        FROM ball_by_ball AS bb
        JOIN batsman_scored AS bs
          ON bb.match_id   = bs.match_id
         AND bb.over_id    = bs.over_id
         AND bb.ball_id    = bs.ball_id
         AND bb.innings_no = bs.innings_no
        GROUP BY bb.match_id,
                 bb.striker
    ) AS rpm
    GROUP BY rpm.player_id
)
SELECT p.player_name,
       p.country_name,
       pa.avg_runs_per_match
FROM player_avg AS pa
JOIN player AS p
  ON pa.player_id = p.player_id
LIMIT 20;
```

