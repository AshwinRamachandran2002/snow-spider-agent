```sql
-- Description: List some players along with their countries to understand player–country mapping.
SELECT DISTINCT "player_id", "player_name", "country_name"
FROM "player"
LIMIT 20;
```

```sql
-- Description: Look at a few deliveries to know which columns identify the striker (batsman).
SELECT DISTINCT "match_id", "over_id", "ball_id", "striker", "non_striker", "bowler"
FROM "ball_by_ball"
LIMIT 20;
```

```sql
-- Description: Inspect how runs are recorded for a delivery in batsman_scored.
SELECT DISTINCT "match_id", "over_id", "ball_id", "runs_scored", "innings_no"
FROM "batsman_scored"
LIMIT 20;
```

```sql
-- Description: Join ball_by_ball with batsman_scored to see runs credited to a striker for a delivery.
SELECT DISTINCT b."match_id",
       b."striker"        AS "player_id",
       bs."runs_scored"
FROM   "ball_by_ball" AS b
JOIN   "batsman_scored" AS bs
  ON   b."match_id"  = bs."match_id"
 AND   b."over_id"   = bs."over_id"
 AND   b."ball_id"   = bs."ball_id"
 AND   b."innings_no"= bs."innings_no"
LIMIT 20;
```

```sql
-- Description: Compute total runs scored by each player in each match (first 20 rows shown).
SELECT DISTINCT player_match_runs."player_id",
       player_match_runs."match_id",
       player_match_runs."runs_in_match"
FROM (
    SELECT b."striker" AS "player_id",
           b."match_id",
           SUM(bs."runs_scored") AS "runs_in_match"
    FROM   "ball_by_ball" AS b
    JOIN   "batsman_scored" AS bs
      ON   b."match_id"   = bs."match_id"
     AND   b."over_id"    = bs."over_id"
     AND   b."ball_id"    = bs."ball_id"
     AND   b."innings_no" = bs."innings_no"
    GROUP BY b."striker", b."match_id"
) AS player_match_runs
LIMIT 20;
```

```sql
-- Description: Find how many matches each player batted in (first 20 rows).
SELECT DISTINCT "player_id",
       COUNT(*) AS "matches_played"
FROM (
    SELECT b."striker" AS "player_id",
           b."match_id"
    FROM   "ball_by_ball" AS b
    GROUP BY b."striker", b."match_id"
) AS t
GROUP BY "player_id"
LIMIT 20;
```

```sql
-- Description: Calculate every player's average runs per match (first 20 rows).
SELECT DISTINCT pm."player_id",
       ROUND(1.0 * pm."total_runs" / mp."matches_played", 2) AS "avg_runs_per_match"
FROM (
    SELECT b."striker" AS "player_id",
           SUM(bs."runs_scored") AS "total_runs"
    FROM   "ball_by_ball" AS b
    JOIN   "batsman_scored" AS bs
      ON   b."match_id"   = bs."match_id"
     AND   b."over_id"    = bs."over_id"
     AND   b."ball_id"    = bs."ball_id"
     AND   b."innings_no" = bs."innings_no"
    GROUP BY b."striker"
) AS pm
JOIN (
    SELECT b."striker" AS "player_id",
           COUNT(DISTINCT b."match_id") AS "matches_played"
    FROM   "ball_by_ball" AS b
    GROUP BY b."striker"
) AS mp
  ON pm."player_id" = mp."player_id"
LIMIT 20;
```

```sql
-- Description: Attach country information to every player’s batting average (first 20 rows).
SELECT DISTINCT p."country_name",
       pa."player_id",
       pa."avg_runs_per_match"
FROM (
    SELECT pm."player_id",
           ROUND(1.0 * pm."total_runs" / mp."matches_played", 2) AS "avg_runs_per_match"
    FROM (
        SELECT b."striker" AS "player_id",
               SUM(bs."runs_scored") AS "total_runs"
        FROM   "ball_by_ball" AS b
        JOIN   "batsman_scored" AS bs
          ON   b."match_id"   = bs."match_id"
         AND   b."over_id"    = bs."over_id"
         AND   b."ball_id"    = bs."ball_id"
         AND   b."innings_no" = bs."innings_no"
        GROUP BY b."striker"
    ) AS pm
    JOIN (
        SELECT b."striker" AS "player_id",
               COUNT(DISTINCT b."match_id") AS "matches_played"
        FROM   "ball_by_ball" AS b
        GROUP BY b."striker"
    ) AS mp
      ON pm."player_id" = mp."player_id"
) AS pa
JOIN "player" AS p
  ON pa."player_id" = p."player_id"
LIMIT 20;
```

```sql
-- Description: Compute each country’s average of the players’ batting averages and list the top 5.
SELECT DISTINCT p_avg."country_name",
       ROUND(AVG(p_avg."avg_runs_per_match"), 2) AS "country_batting_average"
FROM (
    SELECT pl."country_name",
           ROUND(1.0 * pr."total_runs" / pr."matches_played", 2) AS "avg_runs_per_match"
    FROM (
        SELECT b."striker" AS "player_id",
               SUM(bs."runs_scored")                       AS "total_runs",
               COUNT(DISTINCT b."match_id")                AS "matches_played"
        FROM   "ball_by_ball" AS b
        JOIN   "batsman_scored" AS bs
          ON   b."match_id"   = bs."match_id"
         AND   b."over_id"    = bs."over_id"
         AND   b."ball_id"    = bs."ball_id"
         AND   b."innings_no" = bs."innings_no"
        GROUP BY b."striker"
    ) AS pr
    JOIN "player" AS pl
      ON pr."player_id" = pl."player_id"
) AS p_avg
GROUP BY p_avg."country_name"
ORDER BY "country_batting_average" DESC
LIMIT 5;
```
