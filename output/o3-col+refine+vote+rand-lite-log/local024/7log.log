```sql
--Description: 1) List a few players along with their country to see how player–country mapping looks.
SELECT DISTINCT "player_id", "player_name", "country_name"
FROM "player"
LIMIT 20;
```

```sql
--Description: 2) Glimpse at the matches table to understand match_id values we’ll later aggregate on.
SELECT DISTINCT "match_id", "team_1", "team_2", "season_id"
FROM "match"
LIMIT 20;
```

```sql
--Description: 3) Look at a sample of the ball-by-ball records (who faced each ball, who bowled, etc.).
SELECT DISTINCT "match_id", "over_id", "ball_id", "innings_no",
       "striker", "non_striker", "bowler"
FROM "ball_by_ball"
LIMIT 20;
```

```sql
--Description: 4) Inspect the batsman_scored table to see how many runs were credited for each delivery.
SELECT DISTINCT "match_id", "over_id", "ball_id", "innings_no", "runs_scored"
FROM "batsman_scored"
LIMIT 20;
```

```sql
--Description: 5) Join ball_by_ball with batsman_scored for one match to confirm we can attribute runs to a striker.
SELECT b."match_id", b."striker", bs."runs_scored"
FROM "ball_by_ball" AS b
JOIN "batsman_scored" AS bs
  ON bs."match_id" = b."match_id"
 AND bs."over_id"  = b."over_id"
 AND bs."ball_id"  = b."ball_id"
 AND bs."innings_no" = b."innings_no"
WHERE b."match_id" = 335987
LIMIT 20;
```

```sql
--Description: 6) Calculate total runs each player scored in one match (sample 335987) to validate aggregation logic.
SELECT b."striker"   AS player_id,
       SUM(bs."runs_scored") AS runs_in_match
FROM "ball_by_ball" AS b
JOIN "batsman_scored" AS bs
  ON bs."match_id" = b."match_id"
 AND bs."over_id"  = b."over_id"
 AND bs."ball_id"  = b."ball_id"
 AND bs."innings_no" = b."innings_no"
WHERE b."match_id" = 335987
GROUP BY b."striker"
LIMIT 20;
```

```sql
--Description: 7) Compute every player’s total runs and number of matches to see the basis for their average runs/match.
SELECT b."striker" AS player_id,
       COUNT(DISTINCT b."match_id") AS matches_played,
       SUM(bs."runs_scored")        AS total_runs
FROM "ball_by_ball" AS b
JOIN "batsman_scored" AS bs
  ON bs."match_id" = b."match_id"
 AND bs."over_id"  = b."over_id"
 AND bs."ball_id"  = b."ball_id"
 AND bs."innings_no" = b."innings_no"
GROUP BY b."striker"
LIMIT 20;
```

```sql
--Description: 8) Derive each player’s average runs per match (full data) and attach country information.
SELECT p."country_name",
       pm.player_id,
       CAST(pm.total_runs AS FLOAT) / pm.matches_played AS avg_runs_per_match
FROM (
     SELECT b."striker" AS player_id,
            COUNT(DISTINCT b."match_id") AS matches_played,
            SUM(bs."runs_scored")        AS total_runs
     FROM "ball_by_ball" AS b
     JOIN "batsman_scored" AS bs
       ON bs."match_id" = b."match_id"
      AND bs."over_id"  = b."over_id"
      AND bs."ball_id"  = b."ball_id"
      AND bs."innings_no" = b."innings_no"
     GROUP BY b."striker"
) AS pm
JOIN "player" AS p
  ON p."player_id" = pm.player_id
LIMIT 20;
```

```sql
--Description: 9) Calculate each country’s average of their players’ averages (i.e., mean of player batting averages).
SELECT country_name,
       AVG(avg_runs_per_match) AS country_batting_avg
FROM (
     SELECT p."country_name",
            CAST(pm.total_runs AS FLOAT) / pm.matches_played AS avg_runs_per_match
     FROM (
          SELECT b."striker" AS player_id,
                 COUNT(DISTINCT b."match_id") AS matches_played,
                 SUM(bs."runs_scored")        AS total_runs
          FROM "ball_by_ball" AS b
          JOIN "batsman_scored" AS bs
            ON bs."match_id" = b."match_id"
           AND bs."over_id"  = b."over_id"
           AND bs."ball_id"  = b."ball_id"
           AND bs."innings_no" = b."innings_no"
          GROUP BY b."striker"
     ) AS pm
     JOIN "player" AS p
       ON p."player_id" = pm.player_id
) AS country_avgs
GROUP BY country_name
LIMIT 20;
```

```sql
--Description: 10) Finally, list the top-5 countries with the highest mean of player batting averages across all seasons.
SELECT country_name,
       AVG(avg_runs_per_match) AS country_batting_avg
FROM (
     SELECT p."country_name",
            CAST(pm.total_runs AS FLOAT) / pm.matches_played AS avg_runs_per_match
     FROM (
          SELECT b."striker" AS player_id,
                 COUNT(DISTINCT b."match_id") AS matches_played,
                 SUM(bs."runs_scored")        AS total_runs
          FROM "ball_by_ball" AS b
          JOIN "batsman_scored" AS bs
            ON bs."match_id" = b."match_id"
           AND bs."over_id"  = b."over_id"
           AND bs."ball_id"  = b."ball_id"
           AND bs."innings_no" = b."innings_no"
          GROUP BY b."striker"
     ) AS pm
     JOIN "player" AS p
       ON p."player_id" = pm.player_id
) AS country_avgs
GROUP BY country_name
ORDER BY country_batting_avg DESC
LIMIT 5;
```
