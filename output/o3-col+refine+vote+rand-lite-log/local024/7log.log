--Description: 6) Calculate total runs each player scored in one match (sample 335987) to validate aggregation logic.
SELECT b."striker"   AS player_id,
       SUM(bs."runs_scored") AS runs_in_match
FROM "ball_by_ball" AS b
JOIN "batsman_scored" AS bs
  ON bs."match_id" = b."match_id"
 AND bs."over_id"  = b."over_id"
 AND bs."ball_id"  = b."ball_id"
 AND bs."innings_no" = b."innings_no"
WHERE b."match_id" = 335987
GROUP BY b."striker"
LIMIT 20;
