Query:
--Description: 9) Calculate each country’s average of their players’ averages (i.e., mean of player batting averages).
SELECT country_name,
       AVG(avg_runs_per_match) AS country_batting_avg
FROM (
     SELECT p."country_name",
            CAST(pm.total_runs AS FLOAT) / pm.matches_played AS avg_runs_per_match
     FROM (
          SELECT b."striker" AS player_id,
                 COUNT(DISTINCT b."match_id") AS matches_played,
                 SUM(bs."runs_scored")        AS total_runs
          FROM "ball_by_ball" AS b
          JOIN "batsman_scored" AS bs
            ON bs."match_id" = b."match_id"
           AND bs."over_id"  = b."over_id"
           AND bs."ball_id"  = b."ball_id"
           AND bs."innings_no" = b."innings_no"
          GROUP BY b."striker"
     ) AS pm
     JOIN "player" AS p
       ON p."player_id" = pm.player_id
) AS country_avgs
GROUP BY country_name
LIMIT 20;
