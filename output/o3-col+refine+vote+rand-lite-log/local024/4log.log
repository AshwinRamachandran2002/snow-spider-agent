```sql
-- 1) Peek into the players table – see some player names and their countries
SELECT DISTINCT "player_id",
                "player_name",
                "country_name"
FROM   "player"
LIMIT 20;
```

```sql
-- 2) How many players does each country have?
SELECT DISTINCT "country_name",
                COUNT(*)      AS "num_players"
FROM   "player"
GROUP  BY "country_name"
ORDER  BY "num_players" DESC
LIMIT 20;
```

```sql
-- 3) Take a look at the basic ball-by-ball information (striker, bowler …)
SELECT DISTINCT "match_id",
                "over_id",
                "ball_id",
                "striker",
                "non_striker",
                "bowler"
FROM   "ball_by_ball"
LIMIT 20;
```

```sql
-- 4) Join ball_by_ball with batsman_scored to see who scored how many runs 
SELECT DISTINCT b."match_id",
                b."striker"        AS "player_id",
                s."runs_scored"
FROM   "ball_by_ball"   AS b
JOIN   "batsman_scored" AS s
  ON   b."match_id" = s."match_id"
 AND   b."over_id"  = s."over_id"
 AND   b."ball_id"  = s."ball_id"
LIMIT 20;
```

```sql
-- 5) Aggregate: total runs a player scores in every match (one row per player-match)
SELECT DISTINCT b."striker"               AS "player_id",
                b."match_id",
                SUM(s."runs_scored")      AS "runs_in_match"
FROM   "ball_by_ball"   AS b
JOIN   "batsman_scored" AS s
  ON   b."match_id" = s."match_id"
 AND   b."over_id"  = s."over_id"
 AND   b."ball_id"  = s."ball_id"
GROUP  BY b."striker",
          b."match_id"
LIMIT 20;
```

```sql
-- 6) Count how many matches each player appeared in
SELECT DISTINCT "player_id",
                COUNT(DISTINCT "match_id") AS "matches_played"
FROM   "player_match"
GROUP  BY "player_id"
LIMIT 20;
```

```sql
-- 7) Compute every player’s average runs per match
WITH player_runs AS (
  SELECT   b."striker"           AS "player_id",
           SUM(s."runs_scored")  AS "total_runs"
  FROM     "ball_by_ball"   AS b
  JOIN     "batsman_scored" AS s
    ON     b."match_id" = s."match_id"
   AND     b."over_id"  = s."over_id"
   AND     b."ball_id"  = s."ball_id"
  GROUP BY b."striker"
),
player_matches AS (
  SELECT   "player_id",
           COUNT(DISTINCT "match_id") AS "matches_played"
  FROM     "player_match"
  GROUP BY "player_id"
)
SELECT DISTINCT pr."player_id",
                ROUND(1.0 * pr."total_runs" / pm."matches_played", 2) AS "avg_runs_per_match"
FROM   player_runs    AS pr
JOIN   player_matches AS pm
  ON   pr."player_id" = pm."player_id"
LIMIT 20;
```

```sql
-- 8) Attach country to each player average
WITH player_averages AS (
  -- the CTE from the previous query
  WITH player_runs AS (
    SELECT   b."striker"           AS "player_id",
             SUM(s."runs_scored")  AS "total_runs"
    FROM     "ball_by_ball"   AS b
    JOIN     "batsman_scored" AS s
      ON     b."match_id" = s."match_id"
     AND     b."over_id"  = s."over_id"
     AND     b."ball_id"  = s."ball_id"
    GROUP BY b."striker"
  ),
  player_matches AS (
    SELECT   "player_id",
             COUNT(DISTINCT "match_id") AS "matches_played"
    FROM     "player_match"
    GROUP BY "player_id"
  )
  SELECT pr."player_id",
         1.0 * pr."total_runs" / pm."matches_played" AS "avg_runs_per_match"
  FROM   player_runs    AS pr
  JOIN   player_matches AS pm
    ON   pr."player_id" = pm."player_id"
)
SELECT DISTINCT pa."player_id",
                p."country_name",
                ROUND(pa."avg_runs_per_match",2) AS "avg_runs_per_match"
FROM   player_averages AS pa
JOIN   "player"        AS p
  ON   pa."player_id" = p."player_id"
LIMIT 20;
```

```sql
-- 9) Country-level batting average: mean of player averages within each country
WITH player_averages AS (
  WITH player_runs AS (
    SELECT   b."striker"          AS "player_id",
             SUM(s."runs_scored") AS "total_runs"
    FROM     "ball_by_ball"   AS b
    JOIN     "batsman_scored" AS s
      ON     b."match_id" = s."match_id"
     AND     b."over_id"  = s."over_id"
     AND     b."ball_id"  = s."ball_id"
    GROUP BY b."striker"
  ),
  player_matches AS (
    SELECT   "player_id",
             COUNT(DISTINCT "match_id") AS "matches_played"
    FROM     "player_match"
    GROUP BY "player_id"
  )
  SELECT pr."player_id",
         1.0 * pr."total_runs" / pm."matches_played" AS "avg_runs_per_match"
  FROM   player_runs    AS pr
  JOIN   player_matches AS pm
    ON   pr."player_id" = pm."player_id"
)
SELECT DISTINCT p."country_name",
                ROUND(AVG(pa."avg_runs_per_match"),2) AS "country_batting_avg"
FROM   player_averages AS pa
JOIN   "player"        AS p
  ON   pa."player_id" = p."player_id"
GROUP  BY p."country_name"
ORDER  BY "country_batting_avg" DESC
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: Top-5 countries with the highest average of players’ average runs per match
WITH player_averages AS (
  WITH player_runs AS (
    SELECT   b."striker"          AS "player_id",
             SUM(s."runs_scored") AS "total_runs"
    FROM     "ball_by_ball"   AS b
    JOIN     "batsman_scored" AS s
      ON     b."match_id" = s."match_id"
     AND     b."over_id"  = s."over_id"
     AND     b."ball_id"  = s."ball_id"
    GROUP BY b."striker"
  ),
  player_matches AS (
    SELECT   "player_id",
             COUNT(DISTINCT "match_id") AS "matches_played"
    FROM     "player_match"
    GROUP BY "player_id"
)
  SELECT pr."player_id",
         1.0 * pr."total_runs" / pm."matches_played" AS "avg_runs_per_match"
  FROM   player_runs    AS pr
  JOIN   player_matches AS pm
    ON   pr."player_id" = pm."player_id"
)
SELECT DISTINCT p."country_name",
                ROUND(AVG(pa."avg_runs_per_match"),2) AS "country_batting_avg"
FROM   player_averages AS pa
JOIN   "player"        AS p
  ON   pa."player_id" = p."player_id"
GROUP  BY p."country_name"
ORDER  BY "country_batting_avg" DESC
LIMIT 5;
```
