```sql
-- 1. Preview a few players along with their countries
SELECT player_id,
       player_name,
       country_name
FROM   player
LIMIT 20;
```

```sql
-- 2. Inspect some deliveries to see the striker (batsman facing the ball)
SELECT DISTINCT match_id,
       over_id,
       ball_id,
       striker,
       team_batting
FROM   ball_by_ball
LIMIT 20;
```

```sql
-- 3. Look at the runs recorded for those deliveries
SELECT DISTINCT match_id,
       over_id,
       ball_id,
       runs_scored,
       innings_no
FROM   batsman_scored
LIMIT 20;
```

```sql
-- 4. Compute total runs scored by each player (preview first 20 rows)
SELECT b.striker            AS player_id,
       SUM(s.runs_scored)   AS total_runs
FROM   ball_by_ball   AS b
JOIN   batsman_scored AS s
  ON   b.match_id   = s.match_id
 AND  b.over_id    = s.over_id
 AND  b.ball_id    = s.ball_id
 AND  b.innings_no = s.innings_no
GROUP  BY b.striker
LIMIT 20;
```

```sql
-- 5. Count how many matches each player appeared in
SELECT player_id,
       COUNT(DISTINCT match_id) AS matches_played
FROM   player_match
GROUP  BY player_id
LIMIT 20;
```

```sql
-- 6. Join the two previous results to get each player's average runs per match
WITH run_total AS (
    SELECT b.striker AS player_id,
           SUM(s.runs_scored) AS total_runs
    FROM   ball_by_ball   AS b
    JOIN   batsman_scored AS s
      ON   b.match_id   = s.match_id
     AND  b.over_id    = s.over_id
     AND  b.ball_id    = s.ball_id
     AND  b.innings_no = s.innings_no
    GROUP BY b.striker
),
match_cnt AS (
    SELECT player_id,
           COUNT(DISTINCT match_id) AS matches_played
    FROM   player_match
    GROUP  BY player_id
)
SELECT r.player_id,
       r.total_runs,
       m.matches_played,
       1.0 * r.total_runs / m.matches_played AS avg_runs_per_match
FROM   run_total  AS r
JOIN   match_cnt  AS m
  ON   r.player_id = m.player_id
LIMIT 20;
```

```sql
-- 7. Attach country information to each player's batting average
WITH run_total AS (
    SELECT b.striker AS player_id,
           SUM(s.runs_scored) AS total_runs
    FROM   ball_by_ball   AS b
    JOIN   batsman_scored AS s
      ON   b.match_id   = s.match_id
     AND  b.over_id    = s.over_id
     AND  b.ball_id    = s.ball_id
     AND  b.innings_no = s.innings_no
    GROUP BY b.striker
),
match_cnt AS (
    SELECT player_id,
           COUNT(DISTINCT match_id) AS matches_played
    FROM   player_match
    GROUP  BY player_id
),
player_avg AS (
    SELECT r.player_id,
           1.0 * r.total_runs / m.matches_played AS avg_runs_per_match
    FROM   run_total AS r
    JOIN   match_cnt AS m
      ON   r.player_id = m.player_id
)
SELECT pa.player_id,
       p.player_name,
       p.country_name,
       pa.avg_runs_per_match
FROM   player_avg AS pa
JOIN   player     AS p
  ON   pa.player_id = p.player_id
LIMIT 20;
```

```sql
-- 8. Compute the country-wise average of those player averages
WITH run_total AS (
    SELECT b.striker AS player_id,
           SUM(s.runs_scored) AS total_runs
    FROM   ball_by_ball   AS b
    JOIN   batsman_scored AS s
      ON   b.match_id   = s.match_id
     AND  b.over_id    = s.over_id
     AND  b.ball_id    = s.ball_id
     AND  b.innings_no = s.innings_no
    GROUP BY b.striker
),
match_cnt AS (
    SELECT player_id,
           COUNT(DISTINCT match_id) AS matches_played
    FROM   player_match
    GROUP  BY player_id
),
player_avg AS (
    SELECT r.player_id,
           1.0 * r.total_runs / m.matches_played AS avg_runs_per_match
    FROM   run_total AS r
    JOIN   match_cnt AS m
      ON   r.player_id = m.player_id
)
SELECT p.country_name,
       AVG(pa.avg_runs_per_match) AS country_batting_avg
FROM   player_avg AS pa
JOIN   player     AS p
  ON   pa.player_id = p.player_id
GROUP  BY p.country_name
LIMIT 20;
```

```sql
-- 9. Final answer: Top 5 countries with the highest average of player batting averages
WITH run_total AS (
    SELECT b.striker AS player_id,
           SUM(s.runs_scored) AS total_runs
    FROM   ball_by_ball   AS b
    JOIN   batsman_scored AS s
      ON   b.match_id   = s.match_id
     AND  b.over_id    = s.over_id
     AND  b.ball_id    = s.ball_id
     AND  b.innings_no = s.innings_no
    GROUP BY b.striker
),
match_cnt AS (
    SELECT player_id,
           COUNT(DISTINCT match_id) AS matches_played
    FROM   player_match
    GROUP  BY player_id
),
player_avg AS (
    SELECT r.player_id,
           1.0 * r.total_runs / m.matches_played AS avg_runs_per_match
    FROM   run_total AS r
    JOIN   match_cnt AS m
      ON   r.player_id = m.player_id
)
SELECT p.country_name,
       AVG(pa.avg_runs_per_match) AS country_batting_avg
FROM   player_avg AS pa
JOIN   player     AS p
  ON   pa.player_id = p.player_id
GROUP  BY p.country_name
ORDER  BY country_batting_avg DESC
LIMIT 5;
```
