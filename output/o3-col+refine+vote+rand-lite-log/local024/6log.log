Query:
-- Description: Final answer ‑ top 5 countries whose players have the highest mean of individual batting averages
WITH player_average AS (
  SELECT pmr."player_id",
         AVG(pmr."runs_in_match") AS "avg_runs_per_match"
  FROM (
        SELECT bbb."striker"         AS "player_id",
               bbb."match_id",
               SUM(bs."runs_scored") AS "runs_in_match"
        FROM   "ball_by_ball"  AS bbb
        JOIN   "batsman_scored" AS bs
               ON bbb."match_id" = bs."match_id"
              AND bbb."over_id"  = bs."over_id"
              AND bbb."ball_id"  = bs."ball_id"
        GROUP  BY bbb."striker", bbb."match_id"
       ) pmr
  GROUP  BY pmr."player_id"
)
SELECT p."country_name",
       ROUND(AVG(pa."avg_runs_per_match"), 2) AS "country_batting_average"
FROM   player_average AS pa
JOIN   "player"      AS p
  ON   pa."player_id" = p."player_id"
GROUP  BY p."country_name"
ORDER  BY "country_batting_average" DESC
LIMIT 5;
