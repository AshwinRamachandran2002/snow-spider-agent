```sql
-- Description: Look at some distinct countries available in the roster of players
SELECT DISTINCT "country_name"
FROM "player"
LIMIT 20;
```

```sql
-- Description: Inspect a handful of rows from the scoring table (runs recorded per ball)
SELECT *
FROM "batsman_scored"
LIMIT 20;
```

```sql
-- Description: Inspect a handful of rows from ball-by-ball table to see striker (the scoring player)
SELECT "match_id", "over_id", "ball_id", "striker"
FROM "ball_by_ball"
LIMIT 20;
```

```sql
-- Description: Join ball_by_ball with batsman_scored to view runs credited to a batter on each delivery
SELECT bbb."match_id",
       bbb."striker"        AS "player_id",
       bs."runs_scored"
FROM   "ball_by_ball"  AS bbb
JOIN   "batsman_scored" AS bs
  ON   bbb."match_id" = bs."match_id"
 AND   bbb."over_id"  = bs."over_id"
 AND   bbb."ball_id"  = bs."ball_id"
LIMIT 20;
```

```sql
-- Description: Aggregate to get total runs each player scored in every match
SELECT bbb."match_id",
       bbb."striker"                    AS "player_id",
       SUM(bs."runs_scored")            AS "runs_in_match"
FROM   "ball_by_ball"  AS bbb
JOIN   "batsman_scored" AS bs
  ON   bbb."match_id" = bs."match_id"
 AND   bbb."over_id"  = bs."over_id"
 AND   bbb."ball_id"  = bs."ball_id"
GROUP  BY bbb."match_id", bbb."striker"
LIMIT 20;
```

```sql
-- Description: For every player compute his/her average runs per match across all matches
WITH player_match_runs AS (
  SELECT bbb."striker"           AS "player_id",
         bbb."match_id",
         SUM(bs."runs_scored")   AS "runs_in_match"
  FROM   "ball_by_ball"  AS bbb
  JOIN   "batsman_scored" AS bs
         ON bbb."match_id" = bs."match_id"
        AND bbb."over_id"  = bs."over_id"
        AND bbb."ball_id"  = bs."ball_id"
  GROUP  BY bbb."striker", bbb."match_id"
)
SELECT "player_id",
       AVG("runs_in_match")      AS "avg_runs_per_match"
FROM   player_match_runs
GROUP  BY "player_id"
LIMIT 20;
```

```sql
-- Description: Attach country to each player’s batting average
WITH player_average AS (
  SELECT pmr."player_id",
         AVG(pmr."runs_in_match") AS "avg_runs_per_match"
  FROM (
        SELECT bbb."striker"         AS "player_id",
               bbb."match_id",
               SUM(bs."runs_scored") AS "runs_in_match"
        FROM   "ball_by_ball"  AS bbb
        JOIN   "batsman_scored" AS bs
               ON bbb."match_id" = bs."match_id"
              AND bbb."over_id"  = bs."over_id"
              AND bbb."ball_id"  = bs."ball_id"
        GROUP  BY bbb."striker", bbb."match_id"
       ) pmr
  GROUP  BY pmr."player_id"
)
SELECT pa."player_id",
       p."country_name",
       pa."avg_runs_per_match"
FROM   player_average AS pa
JOIN   "player"      AS p
  ON   pa."player_id" = p."player_id"
LIMIT 20;
```

```sql
-- Description: Compute the country-level average of players’ personal batting averages
WITH player_average AS (
  SELECT pmr."player_id",
         AVG(pmr."runs_in_match") AS "avg_runs_per_match"
  FROM (
        SELECT bbb."striker"         AS "player_id",
               bbb."match_id",
               SUM(bs."runs_scored") AS "runs_in_match"
        FROM   "ball_by_ball"  AS bbb
        JOIN   "batsman_scored" AS bs
               ON bbb."match_id" = bs."match_id"
              AND bbb."over_id"  = bs."over_id"
              AND bbb."ball_id"  = bs."ball_id"
        GROUP  BY bbb."striker", bbb."match_id"
       ) pmr
  GROUP  BY pmr."player_id"
)
SELECT p."country_name",
       AVG(pa."avg_runs_per_match") AS "country_batting_average"
FROM   player_average AS pa
JOIN   "player"      AS p
  ON   pa."player_id" = p."player_id"
GROUP  BY p."country_name"
LIMIT 20;
```

```sql
-- Description: Final answer ‑ top 5 countries whose players have the highest mean of individual batting averages
WITH player_average AS (
  SELECT pmr."player_id",
         AVG(pmr."runs_in_match") AS "avg_runs_per_match"
  FROM (
        SELECT bbb."striker"         AS "player_id",
               bbb."match_id",
               SUM(bs."runs_scored") AS "runs_in_match"
        FROM   "ball_by_ball"  AS bbb
        JOIN   "batsman_scored" AS bs
               ON bbb."match_id" = bs."match_id"
              AND bbb."over_id"  = bs."over_id"
              AND bbb."ball_id"  = bs."ball_id"
        GROUP  BY bbb."striker", bbb."match_id"
       ) pmr
  GROUP  BY pmr."player_id"
)
SELECT p."country_name",
       ROUND(AVG(pa."avg_runs_per_match"), 2) AS "country_batting_average"
FROM   player_average AS pa
JOIN   "player"      AS p
  ON   pa."player_id" = p."player_id"
GROUP  BY p."country_name"
ORDER  BY "country_batting_average" DESC
LIMIT 5;
```
