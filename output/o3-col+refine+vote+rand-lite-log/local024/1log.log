Query:
--Description: Derive every player's average runs per match (their personal batting average across all matches)
SELECT p."player_id",
       p."player_name",
       AVG(t."runs_in_match") AS "avg_runs_per_match"
FROM (
        SELECT b."striker" AS "player_id",
               b."match_id",
               SUM(bs."runs_scored") AS "runs_in_match"
        FROM "ball_by_ball" AS b
        JOIN "batsman_scored" AS bs
             ON b."match_id" = bs."match_id"
            AND b."over_id"  = bs."over_id"
            AND b."ball_id"  = bs."ball_id"
            AND b."innings_no" = bs."innings_no"
        GROUP BY b."striker", b."match_id"
     ) AS t
JOIN "player" AS p
     ON p."player_id" = t."player_id"
GROUP BY p."player_id"
LIMIT 20;
