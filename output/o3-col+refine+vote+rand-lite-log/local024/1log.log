```sql
--Description: Inspect the list of different countries present in the player table
SELECT DISTINCT "country_name"
FROM "player"
LIMIT 20;
```

```sql
--Description: Join one delivery from ball_by_ball with batsman_scored and player to see whose runs are being recorded
SELECT b."match_id",
       b."over_id",
       b."ball_id",
       b."striker",
       p."player_name",
       bs."runs_scored"
FROM "ball_by_ball" AS b
JOIN "batsman_scored" AS bs
     ON b."match_id" = bs."match_id"
    AND b."over_id"  = bs."over_id"
    AND b."ball_id"  = bs."ball_id"
    AND b."innings_no" = bs."innings_no"
JOIN "player" AS p 
     ON p."player_id" = b."striker"
LIMIT 20;
```

```sql
--Description: Compute total runs a batter scores in each match
SELECT p."player_name",
       b."match_id",
       SUM(bs."runs_scored") AS "runs_in_match"
FROM "ball_by_ball" AS b
JOIN "batsman_scored" AS bs
     ON b."match_id" = bs."match_id"
    AND b."over_id"  = bs."over_id"
    AND b."ball_id"  = bs."ball_id"
    AND b."innings_no" = bs."innings_no"
JOIN "player" AS p 
     ON p."player_id" = b."striker"
GROUP BY p."player_id", b."match_id"
LIMIT 20;
```

```sql
--Description: Derive every player's average runs per match (their personal batting average across all matches)
SELECT p."player_id",
       p."player_name",
       AVG(t."runs_in_match") AS "avg_runs_per_match"
FROM (
        SELECT b."striker" AS "player_id",
               b."match_id",
               SUM(bs."runs_scored") AS "runs_in_match"
        FROM "ball_by_ball" AS b
        JOIN "batsman_scored" AS bs
             ON b."match_id" = bs."match_id"
            AND b."over_id"  = bs."over_id"
            AND b."ball_id"  = bs."ball_id"
            AND b."innings_no" = bs."innings_no"
        GROUP BY b."striker", b."match_id"
     ) AS t
JOIN "player" AS p
     ON p."player_id" = t."player_id"
GROUP BY p."player_id"
LIMIT 20;
```

```sql
--Description: Attach each player's country to their calculated batting average
SELECT p."country_name",
       pm."player_id",
       pm."avg_runs_per_match"
FROM (
        SELECT "player_id",
               AVG("runs_in_match") AS "avg_runs_per_match"
        FROM (
                SELECT b."striker" AS "player_id",
                       b."match_id",
                       SUM(bs."runs_scored") AS "runs_in_match"
                FROM "ball_by_ball" AS b
                JOIN "batsman_scored" AS bs
                     ON b."match_id" = bs."match_id"
                    AND b."over_id"  = bs."over_id"
                    AND b."ball_id"  = bs."ball_id"
                    AND b."innings_no" = bs."innings_no"
                GROUP BY b."striker", b."match_id"
             )
        GROUP BY "player_id"
     ) AS pm
JOIN "player" AS p
     ON p."player_id" = pm."player_id"
LIMIT 20;
```

```sql
--Description: Calculate, for every country, the average of its players' batting averages
SELECT p."country_name",
       AVG(pm."avg_runs_per_match") AS "country_batting_avg"
FROM (
        SELECT "player_id",
               AVG("runs_in_match") AS "avg_runs_per_match"
        FROM (
                SELECT b."striker" AS "player_id",
                       b."match_id",
                       SUM(bs."runs_scored") AS "runs_in_match"
                FROM "ball_by_ball" AS b
                JOIN "batsman_scored" AS bs
                     ON b."match_id" = bs."match_id"
                    AND b."over_id"  = bs."over_id"
                    AND b."ball_id"  = bs."ball_id"
                    AND b."innings_no" = bs."innings_no"
                GROUP BY b."striker", b."match_id"
             )
        GROUP BY "player_id"
     ) AS pm
JOIN "player" AS p
     ON p."player_id" = pm."player_id"
GROUP BY p."country_name"
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – Top-5 countries with the highest mean of their players’ average runs per match
SELECT p."country_name",
       ROUND(AVG(pm."avg_runs_per_match"), 2) AS "country_batting_avg"
FROM (
        SELECT "player_id",
               AVG("runs_in_match") AS "avg_runs_per_match"
        FROM (
                SELECT b."striker" AS "player_id",
                       b."match_id",
                       SUM(bs."runs_scored") AS "runs_in_match"
                FROM "ball_by_ball" AS b
                JOIN "batsman_scored" AS bs
                     ON b."match_id" = bs."match_id"
                    AND b."over_id"  = bs."over_id"
                    AND b."ball_id"  = bs."ball_id"
                    AND b."innings_no" = bs."innings_no"
                GROUP BY b."striker", b."match_id"
             )
        GROUP BY "player_id"
     ) AS pm
JOIN "player" AS p
     ON p."player_id" = pm."player_id"
GROUP BY p."country_name"
ORDER BY "country_batting_avg" DESC
LIMIT 5;
```
