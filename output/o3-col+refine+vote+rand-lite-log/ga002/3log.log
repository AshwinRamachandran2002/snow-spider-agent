--Description / Thinking process:
-- Goal: For each of the three months (2020-11, 2020-12, 2021-01) find the single MOST-purchased
-- “other” product (excluding the Google Red Speckled Tee itself) among shoppers who bought the Tee,
-- and show its total quantity.
--
-- 1. tee_buyers: pull every user_pseudo_id that purchased the Tee in the window 2020-11-01--2021-01-31.
-- 2. other_items: scan the same tables, keep rows whose user is in tee_buyers, exclude the Tee, then
--    aggregate quantity by month + product name.
-- 3. ranked: use ROW_NUMBER so we can pick the #1 product for each month.
-- 4. Final SELECT: return month, top_other_product, quantity_sold.
-- This is a single SQL statement with two CTEs plus final SELECT.

WITH tee_buyers AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS itm
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
    AND LOWER(itm.item_name) LIKE '%google%red%speckled%tee%'
),
other_items AS (
  SELECT
    CONCAT(SUBSTR(_TABLE_SUFFIX, 1, 4), '-', SUBSTR(_TABLE_SUFFIX, 5, 2)) AS month,
    itm.item_name                       AS other_item,
    SUM(itm.quantity)                   AS total_quantity
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS itm
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM tee_buyers)
    AND LOWER(itm.item_name) NOT LIKE '%google%red%speckled%tee%'
  GROUP BY month, other_item
),
ranked AS (
  SELECT
    month,
    other_item,
    total_quantity,
    ROW_NUMBER() OVER (PARTITION BY month ORDER BY total_quantity DESC) AS rn
  FROM other_items
)
SELECT
  month,
  other_item AS top_other_product,
  total_quantity AS quantity_sold
FROM ranked
WHERE rn = 1
ORDER BY month;
