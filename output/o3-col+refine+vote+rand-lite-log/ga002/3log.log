Query:
-- Description: Top “other” items and their quantities bought by those November customers
SELECT
  i.item_name  AS other_item,
  SUM(i.quantity) AS total_quantity
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`,
     UNNEST(items) AS i
WHERE user_pseudo_id IN (
        SELECT DISTINCT user_pseudo_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`,
             UNNEST(items) AS j
        WHERE LOWER(j.item_name) LIKE '%google%red%speckled%tee%'
          AND event_name = 'purchase')
  AND LOWER(i.item_name) NOT LIKE '%google%red%speckled%tee%'
GROUP BY other_item
ORDER BY total_quantity DESC
LIMIT 20;
