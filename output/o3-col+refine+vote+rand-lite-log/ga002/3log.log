```

```sql
-- Description: One combined view – other items & quantities for each month (Nov-Dec-Jan)
SELECT '2020-11' AS month, i.item_name AS other_item, SUM(i.quantity) AS total_quantity
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`, UNNEST(items) AS i
WHERE user_pseudo_id IN (
        SELECT DISTINCT user_pseudo_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`, UNNEST(items) AS j
        WHERE LOWER(j.item_name) LIKE '%google%red%speckled%tee%' AND event_name = 'purchase')
  AND LOWER(i.item_name) NOT LIKE '%google%red%speckled%tee%'
GROUP BY month, other_item
UNION ALL
SELECT '2020-12', i.item_name, SUM(i.quantity)
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`, UNNEST(items) AS i
WHERE user_pseudo_id IN (
        SELECT DISTINCT user_pseudo_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`, UNNEST(items) AS j
        WHERE LOWER(j.item_name) LIKE '%google%red%speckled%tee%' AND event_name = 'purchase')
  AND LOWER(i.item_name) NOT LIKE '%google%red%speckled%tee%'
GROUP BY month, other_item
UNION ALL
SELECT '2021-01', i.item_name, SUM(i.quantity)
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`, UNNEST(items) AS i
WHERE user_pseudo_id IN (
        SELECT DISTINCT user_pseudo_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`, UNNEST(items) AS j
        WHERE LOWER(j.item_name) LIKE '%google%red%speckled%tee%' AND event_name = 'purchase')
  AND LOWER(i.item_name) NOT LIKE '%google%red%speckled%tee%'
GROUP BY month, other_item
LIMIT 20;
```

```sql
-- Description: For each month, pick the single MOST-purchased other product
WITH monthly AS (
  SELECT
    FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', event_date)) AS month,
    i.item_name                          AS other_item,
    SUM(i.quantity)                      AS total_quantity
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS i
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND user_pseudo_id IN (
        SELECT DISTINCT user_pseudo_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`, UNNEST(items) AS j
        WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
          AND LOWER(j.item_name) LIKE '%google%red%speckled%tee%'
          AND event_name = 'purchase')
    AND LOWER(i.item_name) NOT LIKE '%google%red%speckled%tee%'
  GROUP BY month, other_item)
SELECT *
FROM (SELECT month, other_item, total_quantity,
             ROW_NUMBER() OVER (PARTITION BY month ORDER BY total_quantity DESC) AS rn
      FROM monthly)
WHERE rn = 1
ORDER BY month
LIMIT 20;
```

```sql
-- Description: Compare top “other” item with Tee quantity sold each month
WITH tee AS (
  SELECT FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', event_date)) AS month,
         SUM(i.quantity) AS tee_qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`, UNNEST(items) AS i
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND LOWER(i.item_name) LIKE '%google%red%speckled%tee%'
    AND event_name = 'purchase'
  GROUP BY month),
other AS (
  SELECT FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', event_date)) AS month,
         i.item_name AS other_item,
         SUM(i.quantity) AS other_qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`, UNNEST(items) AS i
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND user_pseudo_id IN (
        SELECT DISTINCT user_pseudo_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`, UNNEST(items) AS j
        WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
          AND LOWER(j.item_name) LIKE '%google%red%speckled%tee%'
          AND event_name = 'purchase')
    AND LOWER(i.item_name) NOT LIKE '%google%red%speckled%tee%'
  GROUP BY month, other_item),
ranked AS (
  SELECT month, other_item, other_qty,
         ROW_NUMBER() OVER (PARTITION BY month ORDER BY other_qty DESC) AS rn
  FROM other)
SELECT
  r.month,
  r.other_item        AS top_other_product,
  r.other_qty         AS quantity_sold,
  t.tee_qty           AS red_speckled_tee_qty
FROM ranked r
JOIN tee t USING (month)
WHERE r.rn = 1
ORDER BY r.month
LIMIT 20;
```

Run these in order to validate the data and finally obtain, for each month (Nov 2020, Dec 2020, Jan 2021), the single most-purchased “other” product and its quantity among all customers who bought the Google Red Speckled Tee.
