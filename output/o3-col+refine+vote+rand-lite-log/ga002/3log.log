Query:
--Description: Compare, for each month, the quantity of the top “other” product
--vs. the quantity of Google Red Speckled Tees sold to the same buyer set.
WITH tee AS (                             -- monthly Tee quantity
  SELECT
    CONCAT(SUBSTR(event_date,1,4), '-', SUBSTR(event_date,5,2)) AS month,
    SUM(it.quantity) AS tee_qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS it
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
    AND LOWER(it.item_name) LIKE '%google%red%speckled%tee%'
  GROUP BY month
),
tee_buyers AS (                            -- all buyers of the Tee
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS it
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
    AND LOWER(it.item_name) LIKE '%google%red%speckled%tee%'
),
other AS (                                 -- monthly quantities of OTHER items
  SELECT
    CONCAT(SUBSTR(event_date,1,4), '-', SUBSTR(event_date,5,2)) AS month,
    it.item_name AS other_item,
    SUM(it.quantity) AS other_qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS it
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM tee_buyers)
    AND LOWER(it.item_name) NOT LIKE '%google%red%speckled%tee%'
  GROUP BY month, other_item
),
ranked AS (                                -- pick top OTHER item each month
  SELECT month, other_item, other_qty,
         ROW_NUMBER() OVER (PARTITION BY month ORDER BY other_qty DESC) AS rn
  FROM other
)
SELECT
  r.month,
  r.other_item        AS top_other_product,
  r.other_qty         AS quantity_sold,
  t.tee_qty           AS red_speckled_tee_qty
FROM ranked r
JOIN tee t USING (month)
WHERE r.rn = 1
ORDER BY r.month
