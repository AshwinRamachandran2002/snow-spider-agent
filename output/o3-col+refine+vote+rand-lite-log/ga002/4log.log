```sql
--Description: 8) Bring everything together – top-selling “other” items for tee-buyers, month by month
WITH tee_buyers AS (
  SELECT DISTINCT _TABLE_SUFFIX AS dt,
         FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS yr_mo,
         `user_pseudo_id`
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(`items`) AS i
  WHERE _TABLE_SUFFIX IN ('20201101','20201102','20201103','20201104','20201105','20201106','20201107','20201108','20201109','20201110','20201111','20201112','20201113','20201114','20201115','20201116','20201117','20201118','20201119','20201120','20201121','20201122','20201123','20201124','20201125','20201126','20201127','20201128','20201129','20201130',
                          '20201201','20201202','20201203','20201204','20201205','20201206','20201207','20201208','20201209','20201210','20201211','20201212','20201213','20201214','20201215','20201216','20201217','20201218','20201219','20201220','20201221','20201222','20201223','20201224','20201225','20201226','20201227','20201228','20201229','20201230','20201231',
                          '20210101','20210102','20210103','20210104','20210105','20210106','20210107','20210108','20210109','20210110','20210111','20210112','20210113','20210114','20210115','20210116','20210117','20210118','20210119','20210120','20210121','20210122','20210123','20210124','20210125','20210126','20210127','20210128','20210129','20210130','20210131')
    AND `event_name` = 'purchase'
    AND LOWER(i.item_name) LIKE '%google%red%speckled%tee%'
),
purchases AS (
  SELECT FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', e._TABLE_SUFFIX)) AS yr_mo,
         i.item_name,
         SUM(i.quantity) AS qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
  JOIN tee_buyers b
    ON e.`user_pseudo_id` = b.`user_pseudo_id`
   AND FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', e._TABLE_SUFFIX)) = b.yr_mo      --keep same month
  CROSS JOIN UNNEST(e.`items`) AS i
  WHERE e.`event_name` = 'purchase'
    AND LOWER(i.item_name) NOT LIKE '%google%red%speckled%tee%'
  GROUP BY yr_mo, i.item_name
)
SELECT yr_mo,
       item_name,
       qty
FROM purchases
ORDER BY yr_mo, qty DESC
LIMIT 20;
```

```sql
--Description: 9) (If you only want the single most-purchased “other” item for each month)
SELECT ARRAY_AGG(STRUCT(item_name, qty) ORDER BY qty DESC)[OFFSET(0)].*,
       yr_mo
FROM (
  SELECT FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', e._TABLE_SUFFIX)) AS yr_mo,
         i.item_name,
         SUM(i.quantity) AS qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
  JOIN (
      -- tee buyers across all 3 months
      SELECT DISTINCT `user_pseudo_id`,
             FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS yr_mo
      FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
           UNNEST(`items`) AS t
      WHERE `event_name` = 'purchase'
        AND LOWER(t.item_name) LIKE '%google%red%speckled%tee%'
        AND _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
  ) AS b
    ON e.`user_pseudo_id` = b.`user_pseudo_id`
   AND FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', e._TABLE_SUFFIX)) = b.yr_mo
  CROSS JOIN UNNEST(e.`items`) AS i
  WHERE e.`event_name` = 'purchase'
    AND LOWER(i.item_name) NOT LIKE '%google%red%speckled%tee%'
    AND _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
  GROUP BY yr_mo, i.item_name
) s
GROUP BY yr_mo
ORDER BY yr_mo
LIMIT 20;
```

```sql
--Description: 10) (Alternative – show top 3 “other” items for each month)  
WITH ranked AS (
  SELECT FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', e._TABLE_SUFFIX)) AS yr_mo,
         i.item_name,
         SUM(i.quantity) AS qty,
         RANK() OVER (PARTITION BY FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', e._TABLE_SUFFIX))
                      ORDER BY SUM(i.quantity) DESC) AS rnk
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
  JOIN (
      SELECT DISTINCT `user_pseudo_id`,
             FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS yr_mo
      FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
           UNNEST(`items`) AS t
      WHERE `event_name` = 'purchase'
        AND LOWER(t.item_name) LIKE '%google%red%speckled%tee%'
        AND _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
  ) tee
    ON e.`user_pseudo_id` = tee.`user_pseudo_id`
   AND FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', e._TABLE_SUFFIX)) = tee.yr_mo
  CROSS JOIN UNNEST(e.`items`) AS i
  WHERE e.`event_name` = 'purchase'
    AND LOWER(i.item_name) NOT LIKE '%google%red%speckled%tee%'
    AND _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
  GROUP BY yr_mo, i.item_name
)
SELECT yr_mo, item_name, qty
FROM ranked
WHERE rnk <= 3
ORDER BY yr_mo, rnk
LIMIT 20;
```

These ten queries progress from basic exploration to successively complex aggregations, ending with answers that list the most-purchased “other” products (and their quantities) bought by customers who acquired the Google Red Speckled Tee in November 2020, December 2020, and January 2021.
