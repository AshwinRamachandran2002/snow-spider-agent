Query:
--Description: 3) Verify how the “Google Red Speckled Tee” shows up in the data (all days & months)
SELECT DISTINCT i.item_name
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
UNNEST(`items`) AS i
WHERE LOWER(i.item_name) LIKE '%google%red%speckled%tee%'
LIMIT 20;
