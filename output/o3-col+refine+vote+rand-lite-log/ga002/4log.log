```sql
--Description / Thinking Process:
-- ① Identify every user-pseudo-id who purchased “Google Red Speckled Tee”
--    during Nov-2020, Dec-2020, Jan-2021 and record the purchase month (yr_mo).
-- ② For the SAME users in the SAME month, pull all their other purchase-items,
--    sum quantities, and then rank items by quantity within each month.
-- ③ Return the top-3 “other” items per month (change rnk filter if fewer/more).
WITH tee_buyers AS (           -- step ①
  SELECT DISTINCT
         user_pseudo_id,
         FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS yr_mo
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS itm
  WHERE event_name = 'purchase'
    AND LOWER(itm.item_name) LIKE '%google%red%speckled%tee%'
    AND _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
),
aggregated AS (                -- step ②
  SELECT
    FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', e._TABLE_SUFFIX)) AS yr_mo,
    i.item_name,
    SUM(i.quantity) AS qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
  JOIN tee_buyers tb
    ON e.user_pseudo_id = tb.user_pseudo_id
   AND FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', e._TABLE_SUFFIX)) = tb.yr_mo
  CROSS JOIN UNNEST(e.items) AS i
  WHERE e.event_name = 'purchase'
    AND LOWER(i.item_name) NOT LIKE '%google%red%speckled%tee%'
    AND e._TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
  GROUP BY yr_mo, i.item_name
),
ranked AS (                    -- step ③
  SELECT
    yr_mo,
    item_name,
    qty,
    RANK() OVER (PARTITION BY yr_mo ORDER BY qty DESC) AS rnk
  FROM aggregated
)
SELECT
  yr_mo,
  item_name,
  qty
FROM ranked
WHERE rnk <= 3
ORDER BY yr_mo, rnk;
```
