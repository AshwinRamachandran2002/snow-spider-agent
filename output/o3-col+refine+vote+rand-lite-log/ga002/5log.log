```sql
--Description: 10) FINAL ANSWER – union the three month-level aggregations and keep only the single most-purchased “other product” for each month  
WITH month_data AS (
  -- November 2020
  SELECT '2020-11' AS month, i.item_name, SUM(i.quantity) AS total_qty
  FROM (
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201101` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201105` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201109` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201113` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201117` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201121` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201125` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201129`
       ) e
  JOIN (
        SELECT DISTINCT user_pseudo_id
        FROM (
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201101` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201105` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201109` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201113` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201117` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201121` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201125` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201129`
             ), UNNEST(items) it
        WHERE event_name='purchase' AND LOWER(it.item_name) LIKE '%google red speckled tee%'
       ) tee
  ON tee.user_pseudo_id=e.user_pseudo_id, UNNEST(e.items) i
  WHERE e.event_name='purchase' AND LOWER(i.item_name) NOT LIKE '%google red speckled tee%'
  GROUP BY month, i.item_name

  UNION ALL
  -- December 2020
  SELECT '2020-12' AS month, i.item_name, SUM(i.quantity) AS total_qty
  FROM (
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201205` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201209` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201213` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201217` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201221` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201225` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201229`
       ) e
  JOIN (
        SELECT DISTINCT user_pseudo_id
        FROM (
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201205` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201209` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201213` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201217` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201221` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201225` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201229`
             ), UNNEST(items) it
        WHERE event_name='purchase' AND LOWER(it.item_name) LIKE '%google red speckled tee%'
       ) tee
  ON tee.user_pseudo_id=e.user_pseudo_id, UNNEST(e.items) i
  WHERE e.event_name='purchase' AND LOWER(i.item_name) NOT LIKE '%google red speckled tee%'
  GROUP BY month, i.item_name

  UNION ALL
  -- January 2021
  SELECT '2021-01' AS month, i.item_name, SUM(i.quantity) AS total_qty
  FROM (
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210101` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210105` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210109` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210113` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210117` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210121` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210125` UNION ALL
        SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210129`
       ) e
  JOIN (
        SELECT DISTINCT user_pseudo_id
        FROM (
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210101` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210105` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210109` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210113` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210117` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210121` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210125` UNION ALL
              SELECT * FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210129`
             ), UNNEST(items) it
        WHERE event_name='purchase' AND LOWER(it.item_name) LIKE '%google red speckled tee%'
       ) tee
  ON tee.user_pseudo_id=e.user_pseudo_id, UNNEST(e.items) i
  WHERE e.event_name='purchase' AND LOWER(i.item_name) NOT LIKE '%google red speckled tee%'
  GROUP BY month, i.item_name
)

SELECT  month ,
        item_name AS most_purchased_other_product ,
        total_qty
FROM (
      SELECT  month , item_name , total_qty ,
              ROW_NUMBER() OVER(PARTITION BY month ORDER BY total_qty DESC) AS rn
      FROM   month_data
     )
WHERE rn = 1
ORDER BY month;
```
