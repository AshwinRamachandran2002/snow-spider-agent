```sql
--Description: 6) For those November-2020 Tee buyers, list the other products they purchased in November 2020  
SELECT  i.item_name ,
        SUM(i.quantity) AS qty
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201105`  AS e
       JOIN (
             SELECT DISTINCT user_pseudo_id
             FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201105`,
                    UNNEST(items) AS it
             WHERE  event_name = 'purchase'
               AND  LOWER(it.item_name) LIKE '%google red speckled tee%'
            ) AS tee
       ON tee.user_pseudo_id = e.user_pseudo_id,
       UNNEST(e.items) AS i
WHERE  e.event_name = 'purchase'
  AND  LOWER(i.item_name) NOT LIKE '%google red speckled tee%'
GROUP BY i.item_name
LIMIT 20;
```

```sql
--Description: 7) Aggregate November-2020 “other products” quantities purchased by Tee customers (all November tables unioned)  
SELECT  '2020-11' AS month ,
        i.item_name ,
        SUM(i.quantity) AS total_quantity
FROM  (
