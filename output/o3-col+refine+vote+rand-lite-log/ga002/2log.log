Query:
--Description:
-- Cross-check query: show the TOP-5 “other” products (≠ Google Red Speckled Tee)
-- purchased by tee-buyers in each month (Nov-2020, Dec-2020, Jan-2021).
-- Fixes applied:
--   • Every SELECT in the UNION ALL returns the same three columns
--     (month, product, total_qty) so GROUP BY works.
--   • Uses CROSS JOIN UNNEST instead of the comma syntax for clarity.
--   • GROUP BY product is kept identical across all UNION parts.
--   • Final ranking uses ROW_NUMBER and we keep rank ≤ 5.
WITH month_product_totals AS (
  /* ---------- November-2020 ---------- */
  SELECT '2020-11' AS month,
         i.item_name AS product,
         SUM(i.quantity) AS total_qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*` e
  JOIN (
        /* tee buyers in Nov-2020 */
        SELECT DISTINCT user_pseudo_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`,
             UNNEST(items) AS it
        WHERE event_name = 'purchase'
          AND LOWER(it.item_name) = 'google red speckled tee'
       ) tb
    ON tb.user_pseudo_id = e.user_pseudo_id
  CROSS JOIN UNNEST(e.items) AS i
  WHERE e.event_name = 'purchase'
    AND LOWER(i.item_name) <> 'google red speckled tee'
  GROUP BY product

  UNION ALL
  /* ---------- December-2020 ---------- */
  SELECT '2020-12' AS month,
         i.item_name AS product,
         SUM(i.quantity) AS total_qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` e
  JOIN (
        SELECT DISTINCT user_pseudo_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
             UNNEST(items) AS it
        WHERE event_name = 'purchase'
          AND LOWER(it.item_name) = 'google red speckled tee'
       ) tb
    ON tb.user_pseudo_id = e.user_pseudo_id
  CROSS JOIN UNNEST(e.items) AS i
  WHERE e.event_name = 'purchase'
    AND LOWER(i.item_name) <> 'google red speckled tee'
  GROUP BY product

  UNION ALL
  /* ---------- January-2021 ---------- */
  SELECT '2021-01' AS month,
         i.item_name AS product,
         SUM(i.quantity) AS total_qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*` e
  JOIN (
        SELECT DISTINCT user_pseudo_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
             UNNEST(items) AS it
        WHERE event_name = 'purchase'
          AND LOWER(it.item_name) = 'google red speckled tee'
       ) tb
    ON tb.user_pseudo_id = e.user_pseudo_id
  CROSS JOIN UNNEST(e.items) AS i
  WHERE e.event_name = 'purchase'
    AND LOWER(i.item_name) <> 'google red speckled tee'
  GROUP BY product
),
ranked AS (
  SELECT month,
         product,
         total_qty,
         ROW_NUMBER() OVER (PARTITION BY month ORDER BY total_qty DESC) AS rank_in_month
  FROM month_product_totals
)
SELECT month,
       product,
       total_qty,
       rank_in_month
FROM ranked
WHERE rank_in_month <= 5
ORDER BY month, rank_in_month
LIMIT 20
