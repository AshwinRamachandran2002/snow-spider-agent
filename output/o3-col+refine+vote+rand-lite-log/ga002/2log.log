```sql
--Description:
-- We have to output, for each month (Nov-2020, Dec-2020, Jan-2021),
-- the single most-purchased product *other* than “Google Red Speckled Tee”
-- among the shoppers who bought that tee in the same month.
-- Strategy:
--   1. tee_buyers CTE  – list (month, user_pseudo_id) for every tee purchaser.
--   2. month_product_totals CTE – for each month, aggregate the quantities of
--      every *other* product bought by those users.
--   3. ranked CTE – rank products by quantity within each month.
--   4. Final SELECT – keep only rank = 1 (the top product) per month.
WITH tee_buyers AS (
  -- November-2020 tee buyers
  SELECT DISTINCT '2020-11' AS month, user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`,
       UNNEST(items) AS it
  WHERE event_name = 'purchase'
    AND LOWER(it.item_name) = 'google red speckled tee'
  UNION ALL
  -- December-2020 tee buyers
  SELECT DISTINCT '2020-12', user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(items) AS it
  WHERE event_name = 'purchase'
    AND LOWER(it.item_name) = 'google red speckled tee'
  UNION ALL
  -- January-2021 tee buyers
  SELECT DISTINCT '2021-01', user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
       UNNEST(items) AS it
  WHERE event_name = 'purchase'
    AND LOWER(it.item_name) = 'google red speckled tee'
),
month_product_totals AS (
  -- Aggregate other products for November-2020 tee buyers
  SELECT '2020-11' AS month,
         i.item_name AS product,
         SUM(i.quantity) AS total_qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*` e
  JOIN tee_buyers tb
    ON tb.user_pseudo_id = e.user_pseudo_id AND tb.month = '2020-11'
  CROSS JOIN UNNEST(e.items) AS i
  WHERE e.event_name = 'purchase'
    AND LOWER(i.item_name) <> 'google red speckled tee'
  GROUP BY product
  UNION ALL
  -- December-2020
  SELECT '2020-12',
         i.item_name,
         SUM(i.quantity)
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` e
  JOIN tee_buyers tb
    ON tb.user_pseudo_id = e.user_pseudo_id AND tb.month = '2020-12'
  CROSS JOIN UNNEST(e.items) AS i
  WHERE e.event_name = 'purchase'
    AND LOWER(i.item_name) <> 'google red speckled tee'
  GROUP BY i.item_name
  UNION ALL
  -- January-2021
  SELECT '2021-01',
         i.item_name,
         SUM(i.quantity)
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*` e
  JOIN tee_buyers tb
    ON tb.user_pseudo_id = e.user_pseudo_id AND tb.month = '2021-01'
  CROSS JOIN UNNEST(e.items) AS i
  WHERE e.event_name = 'purchase'
    AND LOWER(i.item_name) <> 'google red speckled tee'
  GROUP BY i.item_name
),
ranked AS (
  SELECT month,
         product,
         total_qty,
         ROW_NUMBER() OVER (PARTITION BY month ORDER BY total_qty DESC) AS rn
  FROM month_product_totals
)
SELECT month,
       product   AS most_purchased_other_product,
       total_qty AS quantity_bought_by_tee_customers
FROM ranked
WHERE rn = 1
ORDER BY month;
