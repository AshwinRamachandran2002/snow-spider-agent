```sql
-- 7) Build one common table that gives, for every month, the quantities of each
--    non-tee product purchased by tee buyers.
WITH month_data AS (
  SELECT '2020-11' AS month, item.item_name AS product, item.quantity AS qty
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*` e,
         UNNEST(items) AS item
  WHERE  e.event_name = 'purchase'
    AND  e.user_pseudo_id IN (
          SELECT DISTINCT user_pseudo_id
          FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`,
                 UNNEST(items) AS it
          WHERE  event_name = 'purchase'
            AND  LOWER(it.item_name) = 'google red speckled tee')
    AND  LOWER(item.item_name) <> 'google red speckled tee'

  UNION ALL
  SELECT '2020-12', item.item_name, item.quantity
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` e,
         UNNEST(items) AS item
  WHERE  e.event_name = 'purchase'
    AND  e.user_pseudo_id IN (
          SELECT DISTINCT user_pseudo_id
          FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
                 UNNEST(items) AS it
          WHERE  event_name = 'purchase'
            AND  LOWER(it.item_name) = 'google red speckled tee')
    AND  LOWER(item.item_name) <> 'google red speckled tee'

  UNION ALL
  SELECT '2021-01', item.item_name, item.quantity
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*` e,
         UNNEST(items) AS item
  WHERE  e.event_name = 'purchase'
    AND  e.user_pseudo_id IN (
          SELECT DISTINCT user_pseudo_id
          FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
                 UNNEST(items) AS it
          WHERE  event_name = 'purchase'
            AND  LOWER(it.item_name) = 'google red speckled tee')
    AND  LOWER(item.item_name) <> 'google red speckled tee'
)
SELECT month, product, SUM(qty) AS total_qty
FROM   month_data
GROUP  BY month, product
ORDER  BY month, total_qty DESC
LIMIT  20;
```

```sql
-- 8) Rank the products for every month (1 = most purchased among tee buyers).
WITH month_product_totals AS (
  /* reuse the aggregation built in query 7 */
  SELECT month, product, SUM(qty) AS total_qty
  FROM (
    -- sub-query identical to the month_data CTE in query 7
    SELECT '2020-11' AS month, item.item_name AS product, item.quantity AS qty
    FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*` e,
           UNNEST(items) AS item
    WHERE  e.event_name = 'purchase'
      AND  e.user_pseudo_id IN (
            SELECT DISTINCT user_pseudo_id
            FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`,
                   UNNEST(items) AS it
            WHERE  event_name = 'purchase'
              AND  LOWER(it.item_name) = 'google red speckled tee')
      AND  LOWER(item.item_name) <> 'google red speckled tee'
    UNION ALL
    SELECT '2020-12', item.item_name, item.quantity
    FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` e,
           UNNEST(items) AS item
    WHERE  e.event_name = 'purchase'
      AND  e.user_pseudo_id IN (
            SELECT DISTINCT user_pseudo_id
            FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
                   UNNEST(items) AS it
            WHERE  event_name = 'purchase'
              AND  LOWER(it.item_name) = 'google red speckled tee')
      AND  LOWER(item.item_name) <> 'google red speckled tee'
    UNION ALL
    SELECT '2021-01', item.item_name, item.quantity
    FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*` e,
           UNNEST(items) AS item
    WHERE  e.event_name = 'purchase'
      AND  e.user_pseudo_id IN (
            SELECT DISTINCT user_pseudo_id
            FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
                   UNNEST(items) AS it
            WHERE  event_name = 'purchase'
              AND  LOWER(it.item_name) = 'google red speckled tee')
      AND  LOWER(item.item_name) <> 'google red speckled tee'
  )
  GROUP BY month, product
)
SELECT  month,
        product,
        total_qty,
        ROW_NUMBER() OVER (PARTITION BY month ORDER BY total_qty DESC) AS rank_in_month
FROM    month_product_totals
ORDER BY month, rank_in_month
LIMIT   20;
```

```sql
-- 9) Pick only the #1 ranked product per month – this answers
--    “the most purchased other products and their quantities”.
WITH month_product_totals AS (
  /* same aggregation as previous query (omitted here for brevity) */
  SELECT '2020-11' AS month, item.item_name AS product, SUM(item.quantity) AS total_qty
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*` e,
         UNNEST(items) AS item
  WHERE  e.event_name = 'purchase'
    AND  e.user_pseudo_id IN (
          SELECT DISTINCT user_pseudo_id
          FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`,
                 UNNEST(items) AS it
          WHERE  event_name = 'purchase'
            AND  LOWER(it.item_name) = 'google red speckled tee')
    AND  LOWER(item.item_name) <> 'google red speckled tee'
  GROUP BY product

  UNION ALL
  SELECT '2020-12', item.item_name, SUM(item.quantity)
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` e,
         UNNEST(items) AS item
  WHERE  e.event_name = 'purchase'
    AND  e.user_pseudo_id IN (
          SELECT DISTINCT user_pseudo_id
          FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
                 UNNEST(items) AS it
          WHERE  event_name = 'purchase'
            AND  LOWER(it.item_name) = 'google red speckled tee')
    AND  LOWER(item.item_name) <> 'google red speckled tee'
  GROUP BY product

  UNION ALL
  SELECT '2021-01', item.item_name, SUM(item.quantity)
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*` e,
         UNNEST(items) AS item
  WHERE  e.event_name = 'purchase'
    AND  e.user_pseudo_id IN (
          SELECT DISTINCT user_pseudo_id
          FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202101*`,
                 UNNEST(items) AS it
          WHERE  event_name = 'purchase'
            AND  LOWER(it.item_name) = 'google red speckled tee')
    AND  LOWER(item.item_name) <> 'google red speckled tee'
  GROUP BY product
),
ranked AS (
  SELECT month,
         product,
         total_qty,
         ROW_NUMBER() OVER (PARTITION BY month ORDER BY total_qty DESC) AS rn
  FROM   month_product_totals
)
SELECT month,
       product              AS most_purchased_other_product,
       total_qty            AS quantity_bought_by_tee_customers
FROM   ranked
WHERE  rn = 1
ORDER  BY month
LIMIT  20;
