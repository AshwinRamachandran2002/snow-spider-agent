              AND  LOWER(it.item_name) = 'google red speckled tee')
      AND  LOWER(item.item_name) <> 'google red speckled tee'
  )
  GROUP BY month, product
)
SELECT  month,
        product,
        total_qty,
        ROW_NUMBER() OVER (PARTITION BY month ORDER BY total_qty DESC) AS rank_in_month
FROM    month_product_totals
ORDER BY month, rank_in_month
LIMIT   20;
