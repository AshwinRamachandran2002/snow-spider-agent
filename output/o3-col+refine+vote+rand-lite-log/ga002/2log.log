Query:
-- 4) For those November customers, show the other products they purchased
--    in the same month (tee excluded) together with aggregated quantities.
WITH tee_buyers AS (
  SELECT DISTINCT user_pseudo_id
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`,
         UNNEST(items) AS it
  WHERE  event_name = 'purchase'
    AND  LOWER(it.item_name) = 'google red speckled tee'
)
SELECT  item.item_name          AS product,
        SUM(item.quantity)      AS total_qty
FROM    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*` e,
        UNNEST(items) AS item
WHERE   e.event_name      = 'purchase'
  AND   e.user_pseudo_id IN (SELECT user_pseudo_id FROM tee_buyers)
  AND   LOWER(item.item_name) <> 'google red speckled tee'
GROUP BY product
ORDER BY total_qty DESC
LIMIT   20;
