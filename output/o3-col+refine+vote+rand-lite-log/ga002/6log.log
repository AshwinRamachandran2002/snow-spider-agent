```sql
--Description: 8) Quantities of all other products bought by those Tee customers, grouped by calendar month.
WITH tee_buyers AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
  UNNEST(items) AS itm
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
    AND LOWER(itm.item_name) = 'google red speckled tee'
)
SELECT
  SUBSTR(event_date,1,6)     AS year_month,
  other.item_name,
  SUM(other.quantity)        AS qty
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS t
JOIN tee_buyers USING (user_pseudo_id)
CROSS JOIN UNNEST(t.items)   AS other
WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
  AND t.event_name = 'purchase'
  AND LOWER(other.item_name) <> 'google red speckled tee'
GROUP BY year_month, other.item_name
ORDER BY year_month, qty DESC
LIMIT 20;
```

```sql
--Description: 9) Rank the “other” products per month by total quantity to locate the top sellers (Top-5 each month).
WITH tee_buyers AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
  UNNEST(items) AS itm
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
    AND LOWER(itm.item_name) = 'google red speckled tee'
),
other_prod AS (
  SELECT
    SUBSTR(event_date,1,6) AS year_month,
    itm.item_name,
    SUM(itm.quantity)      AS total_qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
  JOIN tee_buyers USING (user_pseudo_id)
  CROSS JOIN UNNEST(e.items) AS itm
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND e.event_name = 'purchase'
    AND LOWER(itm.item_name) <> 'google red speckled tee'
  GROUP BY year_month, itm.item_name
)
SELECT
  year_month,
  item_name,
  total_qty
FROM (
  SELECT
    year_month,
    item_name,
    total_qty,
    ROW_NUMBER() OVER (PARTITION BY year_month ORDER BY total_qty DESC) AS rn
  FROM other_prod
)
WHERE rn <= 5
ORDER BY year_month, total_qty DESC
LIMIT 20;
```

```sql
--Description: 10) FINAL – most-purchased other product (single winner) and its quantity for each month (Nov-2020, Dec-2020, Jan-2021) among customers who bought the Google Red Speckled Tee.
WITH tee_buyers AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
  UNNEST(items) AS itm
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
    AND LOWER(itm.item_name) = 'google red speckled tee'
),
other_prod AS (
  SELECT
    SUBSTR(event_date,1,6) AS year_month,
    itm.item_name,
    SUM(itm.quantity)      AS total_qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
  JOIN tee_buyers USING (user_pseudo_id)
  CROSS JOIN UNNEST(e.items) AS itm
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND e.event_name = 'purchase'
    AND LOWER(itm.item_name) <> 'google red speckled tee'
  GROUP BY year_month, itm.item_name
)
SELECT
  year_month,
  item_name,
  total_qty
FROM (
  SELECT
    year_month,
    item_name,
    total_qty,
    ROW_NUMBER() OVER (PARTITION BY year_month ORDER BY total_qty DESC) AS rn
  FROM other_prod
)
WHERE rn = 1
ORDER BY year_month;
```
