--Description: 10)  Produce a full ranking (top-N per month, here N = 5) of OTHER
--products purchased by Google Red Speckled Tee buyers in each month.  All columns
--used in SELECT after aggregation are grouped; therefore the query is free of
--the earlier grouping error.  LIMIT keeps the sample short for inspection.
DECLARE n INT64 DEFAULT 5;

WITH base AS (
  SELECT
    FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS month,
    user_pseudo_id,
    item.item_name,
    item.quantity
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS item
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
),
tee_buyers AS (
  SELECT DISTINCT month, user_pseudo_id
  FROM base
  WHERE LOWER(item_name) = 'google red speckled tee'
),
other_prod AS (
  SELECT
    b.month,
    b.item_name,
    SUM(b.quantity) AS total_qty
  FROM base AS b
  JOIN tee_buyers AS t
    ON b.month = t.month
   AND b.user_pseudo_id = t.user_pseudo_id
  WHERE LOWER(b.item_name) <> 'google red speckled tee'
  GROUP BY b.month, b.item_name
),
ranked AS (
  SELECT
    month,
    item_name,
    total_qty,
    ROW_NUMBER() OVER (PARTITION BY month ORDER BY total_qty DESC, item_name) AS rk
  FROM other_prod
)
SELECT
  month,
  item_name,
  total_qty,
  rk
FROM ranked
WHERE rk <= n
ORDER BY month, rk
LIMIT 20;
