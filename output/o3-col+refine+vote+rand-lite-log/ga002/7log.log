--Description / Thinking process:
--We must fix the last query that still filters on “rk <= n” even though no
--DECLARE n exists.  Simplest remedy: replace that variable with a literal
--(top-5) to keep the logic consistent and execution error-free.
--
--Goal remains: rank OTHER products bought by Google Red Speckled Tee purchasers
--during Nov-20, Dec-20, Jan-21, and return the five highest-quantity items per
--month (15 rows max).
WITH base AS (
  SELECT
    FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS month,
    user_pseudo_id,
    item.item_name,
    item.quantity
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS item
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
),
tee_buyers AS (
  SELECT DISTINCT month, user_pseudo_id
  FROM base
  WHERE LOWER(item_name) = 'google red speckled tee'
),
other_prod AS (
  SELECT
    b.month,
    b.item_name,
    SUM(b.quantity) AS total_qty
  FROM base AS b
  JOIN tee_buyers AS t
    ON b.month = t.month
   AND b.user_pseudo_id = t.user_pseudo_id
  WHERE LOWER(b.item_name) <> 'google red speckled tee'
  GROUP BY b.month, b.item_name
),
ranked AS (
  SELECT
    month,
    item_name,
    total_qty,
    ROW_NUMBER() OVER (PARTITION BY month
                       ORDER BY total_qty DESC, item_name) AS rk
  FROM other_prod
)
SELECT
  month,
  item_name,
  total_qty,
  rk
FROM ranked
WHERE rk <= 5          -- hard-coded top-5 to remove undefined variable “n”
ORDER BY month, rk
