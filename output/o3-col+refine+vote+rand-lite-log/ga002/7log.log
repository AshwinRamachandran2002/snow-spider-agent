--Description: 5) Aggregate November 2020 – total quantity of each *other*
--product purchased by Tee buyers, ordered by quantity descending (top 20).
WITH tee_buyers AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS item
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND event_name = 'purchase'
    AND LOWER(item.item_name) = 'google red speckled tee'
)
SELECT
  item.item_name,
  SUM(item.quantity) AS total_qty
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
     UNNEST(items) AS item
WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
  AND event_name = 'purchase'
  AND LOWER(item.item_name) <> 'google red speckled tee'
  AND user_pseudo_id IN (SELECT user_pseudo_id FROM tee_buyers)
GROUP BY item.item_name
ORDER BY total_qty DESC
LIMIT 20;
