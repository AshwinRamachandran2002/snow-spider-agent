--Description / Thinking process:
--Task: “Show the single most-purchased OTHER product (name + total quantity)
--      for each month (Nov-2020, Dec-2020, Jan-2021) among customers who bought
--      the Google Red Speckled Tee during that same month.”
--
--Logic blueprint
--1. base       : explode every purchase line-item across the three-month window
--                and stamp it with a YYYY-MM month label.
--2. tee_buyers : list, per month, the users who purchased the Tee.
--3. other_prod : for those users, still within the same month, sum quantities
--                of all line-items ≠ the Tee.
--4. ranked     : within each month rank products by total_quantity DESC,
--                then pick rank = 1 → “most purchased other product”.
--
--Only one final SELECT returns exactly one row per month (3 rows total).
WITH base AS (
  SELECT
    FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS month,
    user_pseudo_id,
    item.item_name,
    item.quantity
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS item
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
),
tee_buyers AS (
  SELECT DISTINCT month, user_pseudo_id
  FROM base
  WHERE LOWER(item_name) = 'google red speckled tee'
),
other_prod AS (
  SELECT
    b.month,
    b.item_name,
    SUM(b.quantity) AS total_qty
  FROM base AS b
  JOIN tee_buyers AS t
    ON b.month = t.month
   AND b.user_pseudo_id = t.user_pseudo_id
  WHERE LOWER(b.item_name) <> 'google red speckled tee'
  GROUP BY b.month, b.item_name
),
ranked AS (
  SELECT
    month,
    item_name,
    total_qty,
    ROW_NUMBER() OVER (PARTITION BY month ORDER BY total_qty DESC, item_name) AS rk
  FROM other_prod
)
SELECT
  month,
  item_name AS most_purchased_other_product,
  total_qty
FROM ranked
WHERE rk = 1
ORDER BY month;
