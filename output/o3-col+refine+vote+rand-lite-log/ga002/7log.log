Query:
--Description: 4) What *other* products did those users purchase in the same
--month?  Skip the Tee itself, show product, quantity and user (sample 20 rows).
WITH tee_buyers AS (
  SELECT DISTINCT user_pseudo_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS item
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND event_name = 'purchase'
    AND LOWER(item.item_name) = 'google red speckled tee'
)
SELECT
  e.user_pseudo_id,
  item.item_name,
  item.quantity
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e,
     UNNEST(e.items) AS item
WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
  AND e.event_name = 'purchase'
  AND e.user_pseudo_id IN (SELECT user_pseudo_id FROM tee_buyers)
  AND LOWER(item.item_name) <> 'google red speckled tee'
LIMIT 20;
