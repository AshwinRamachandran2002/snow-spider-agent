```sql
--Description: 8) Combine the three months in one shot, label each month, and
--get quantity per product & month (20 rows to inspect).
WITH base AS (
  SELECT
    FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS month,
    user_pseudo_id,
    item.item_name,
    item.quantity,
    ANY_VALUE(event_name) AS ev     -- keep a simple column for filter
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS item
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
)
, tee_buyers AS (
  SELECT DISTINCT month, user_pseudo_id
  FROM base
  WHERE LOWER(item_name) = 'google red speckled tee'
)
SELECT
  b.month,
  b.item_name,
  SUM(b.quantity) AS total_qty
FROM base AS b
JOIN tee_buyers AS t
  ON b.month = t.month AND b.user_pseudo_id = t.user_pseudo_id
WHERE LOWER(b.item_name) <> 'google red speckled tee'
GROUP BY b.month, b.item_name
ORDER BY b.month, total_qty DESC
LIMIT 20;
```

```sql
--Description: 9) For each month, return the single most-purchased “other”
--product (ties broken alphabetically) together with the total quantity.
WITH base AS (
  SELECT
    FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS month,
    user_pseudo_id,
    item.item_name,
    item.quantity
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS item
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
),
tee_buyers AS (
  SELECT DISTINCT month, user_pseudo_id
  FROM base
  WHERE LOWER(item_name) = 'google red speckled tee'
),
other_prod AS (
  SELECT
    b.month,
    b.item_name,
    SUM(b.quantity) AS total_qty
  FROM base AS b
  JOIN tee_buyers AS t
    ON b.month = t.month
   AND b.user_pseudo_id = t.user_pseudo_id
  WHERE LOWER(b.item_name) <> 'google red speckled tee'
  GROUP BY b.month, b.item_name
)
SELECT
  month,
  item_name,
  total_qty
FROM (
  SELECT
    month,
    item_name,
    total_qty,
    ROW_NUMBER() OVER (PARTITION BY month ORDER BY total_qty DESC, item_name) AS rn
  FROM other_prod
)
WHERE rn = 1
ORDER BY month
LIMIT 20;
```

```sql
--Description: 10) Same as #9 but keep the full ranking (top-N) per month; use
--a parameter (here N = 5) and show 20 rows sample.
DECLARE n INT64 DEFAULT 5;
WITH base AS (
  SELECT
    FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS month,
    user_pseudo_id,
    item.item_name,
    item.quantity
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS item
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
),
tee_buyers AS (
  SELECT DISTINCT month, user_pseudo_id
  FROM base
  WHERE LOWER(item_name) = 'google red speckled tee'
),
other_prod AS (
  SELECT
    b.month,
    b.item_name,
    SUM(b.quantity) AS total_qty
  FROM base AS b
  JOIN tee_buyers AS t
    ON b.month = t.month
   AND b.user_pseudo_id = t.user_pseudo_id
  WHERE LOWER(b.item_name) <> 'google red speckled tee'
  GROUP BY b.month, b.item_name
),
ranked AS (
  SELECT
    month,
    item_name,
    total_qty,
    ROW_NUMBER() OVER (PARTITION BY month ORDER BY total_qty DESC, item_name) AS rk
  FROM other_prod
)
SELECT
  month,
  item_name,
  total_qty,
  rk
FROM ranked
WHERE rk <= n
ORDER BY month, rk
LIMIT 20;
```
