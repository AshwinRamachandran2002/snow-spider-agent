Query:
--Description: 9)  Return, for each month (2020-11, 2020-12, 2021-01), the single
--most-purchased OTHER product (ties broken alphabetically) among customers who
--bought the Google Red Speckled Tee in that same month.  The query mirrors the
--logic already explained and contains no un-aggregated columns that could raise
--a grouping error.
WITH base AS (
  SELECT
    FORMAT_DATE('%Y-%m', PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS month,
    user_pseudo_id,
    item.item_name,
    item.quantity
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(items) AS item
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20210131'
    AND event_name = 'purchase'
),
tee_buyers AS (
  SELECT DISTINCT month, user_pseudo_id
  FROM base
  WHERE LOWER(item_name) = 'google red speckled tee'
),
other_prod AS (
  SELECT
    b.month,
    b.item_name,
    SUM(b.quantity) AS total_qty
  FROM base AS b
  JOIN tee_buyers AS t
    ON b.month = t.month
   AND b.user_pseudo_id = t.user_pseudo_id
  WHERE LOWER(b.item_name) <> 'google red speckled tee'
  GROUP BY b.month, b.item_name
),
ranked AS (
  SELECT
    month,
    item_name,
    total_qty,
    ROW_NUMBER() OVER (PARTITION BY month ORDER BY total_qty DESC, item_name) AS rn
  FROM other_prod
)
SELECT
  month,
  item_name AS most_purchased_other_product,
  total_qty
FROM ranked
WHERE rn = 1
ORDER BY month
Answer:
month,most_purchased_other_product,total_qty
2020-11,Google Decal,17
2020-12,Google Navy Speckled Tee,10
2021-01,Google PNW Campus Sticker,12
