```sql
--Description: 1. Quick look at a few raw rows from the HUD PIT homelessness table
SELECT *
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
LIMIT 20;
```

```sql
--Description: 2. See all distinct count years available in the table
SELECT DISTINCT `Count_Year`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
ORDER BY `Count_Year`
LIMIT 20;
```

```sql
--Description: 3. List distinct CoC numbers with the state abbreviation (first two characters)
SELECT DISTINCT
  `CoC_Number`,
  LEFT(`CoC_Number`, 2) AS `state`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
LIMIT 20;
```

```sql
--Description: 4. Total unsheltered homeless per state for the years 2015 and 2018
SELECT
  LEFT(`CoC_Number`, 2) AS `state`,
  `Count_Year`,
  SUM(`Unsheltered_Homeless`) AS `unsheltered_total`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `Count_Year` IN (2015, 2018)
GROUP BY `state`, `Count_Year`
ORDER BY `state`, `Count_Year`
LIMIT 20;
```

```sql
--Description: 5. Pivot the totals so that 2015 and 2018 sit on the same row for each state
WITH year_totals AS (
  SELECT
    LEFT(`CoC_Number`, 2) AS `state`,
    `Count_Year`,
    SUM(`Unsheltered_Homeless`) AS `unsheltered_total`
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` IN (2015, 2018)
  GROUP BY `state`, `Count_Year`
)
SELECT
  state,
  MAX(CASE WHEN Count_Year = 2015 THEN unsheltered_total END) AS u2015,
  MAX(CASE WHEN Count_Year = 2018 THEN unsheltered_total END) AS u2018
FROM year_totals
GROUP BY state
LIMIT 20;
```

```sql
--Description: 6. Compute the percentage change from 2015 to 2018 for each state
WITH year_totals AS (
  SELECT
    LEFT(`CoC_Number`, 2) AS `state`,
    `Count_Year`,
    SUM(`Unsheltered_Homeless`) AS `unsheltered_total`
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` IN (2015, 2018)
  GROUP BY `state`, `Count_Year`
),
pivoted AS (
  SELECT
    state,
    MAX(CASE WHEN Count_Year = 2015 THEN unsheltered_total END) AS u2015,
    MAX(CASE WHEN Count_Year = 2018 THEN unsheltered_total END) AS u2018
  FROM year_totals
  GROUP BY state
)
SELECT
  state,
  u2015,
  u2018,
  SAFE_DIVIDE(u2018 - u2015, u2015) * 100 AS pct_change
FROM pivoted
WHERE u2015 IS NOT NULL AND u2018 IS NOT NULL
LIMIT 20;
```

```sql
--Description: 7. Determine the national average of the state percentage changes from 2015 to 2018
WITH year_totals AS (
  SELECT
    LEFT(`CoC_Number`, 2) AS `state`,
    `Count_Year`,
    SUM(`Unsheltered_Homeless`) AS `unsheltered_total`
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` IN (2015, 2018)
  GROUP BY `state`, `Count_Year`
),
pivoted AS (
  SELECT
    state,
    MAX(CASE WHEN Count_Year = 2015 THEN unsheltered_total END) AS u2015,
    MAX(CASE WHEN Count_Year = 2018 THEN unsheltered_total END) AS u2018
  FROM year_totals
  GROUP BY state
),
state_pct AS (
  SELECT
    state,
    SAFE_DIVIDE(u2018 - u2015, u2015) * 100 AS pct_change
  FROM pivoted
  WHERE u2015 IS NOT NULL AND u2018 IS NOT NULL
)
SELECT
  AVG(pct_change) AS national_avg_pct_change
FROM state_pct
LIMIT 20;
```

```sql
--Description: 8. Final answer – five states whose percentage change is closest to the national average
WITH year_totals AS (
  SELECT
    LEFT(`CoC_Number`, 2) AS `state`,
    `Count_Year`,
    SUM(`Unsheltered_Homeless`) AS `unsheltered_total`
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` IN (2015, 2018)
  GROUP BY `state`, `Count_Year`
),
pivoted AS (
  SELECT
    state,
    MAX(CASE WHEN Count_Year = 2015 THEN unsheltered_total END) AS u2015,
    MAX(CASE WHEN Count_Year = 2018 THEN unsheltered_total END) AS u2018
  FROM year_totals
  GROUP BY state
),
state_pct AS (
  SELECT
    state,
    SAFE_DIVIDE(u2018 - u2015, u2015) * 100 AS pct_change
  FROM pivoted
  WHERE u2015 IS NOT NULL AND u2018 IS NOT NULL
),
national_avg AS (
  SELECT AVG(pct_change) AS nat_avg FROM state_pct
)
SELECT
  s.state
FROM
  state_pct AS s,
  national_avg AS n
ORDER BY ABS(s.pct_change - n.nat_avg) ASC
LIMIT 5;
```
