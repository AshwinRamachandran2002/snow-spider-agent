```sql
-- 1) See what years are available in the HUD PIT file
SELECT DISTINCT `Count_Year`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
ORDER BY `Count_Year`
LIMIT 20;
```

```sql
-- 2) Check a few CoC numbers and confirm that the first two characters are the state / territory abbreviation
SELECT `CoC_Number`,
       SUBSTR(`CoC_Number`, 0, 2) AS state_abbr
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
LIMIT 20;
```

```sql
-- 3) Total unsheltered homeless persons per state for 2015 (top 20 largest)
SELECT SUBSTR(`CoC_Number`, 0, 2) AS state_abbr,
       SUM(`Unsheltered_Homeless`) AS total_2015
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `Count_Year` = 2015
GROUP BY state_abbr
ORDER BY total_2015 DESC
LIMIT 20;
```

```sql
-- 4) Total unsheltered homeless persons per state for 2018 (top 20 largest)
SELECT SUBSTR(`CoC_Number`, 0, 2) AS state_abbr,
       SUM(`Unsheltered_Homeless`) AS total_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `Count_Year` = 2018
GROUP BY state_abbr
ORDER BY total_2018 DESC
LIMIT 20;
```

```sql
-- 5) Percentage change from 2015 → 2018 for each state
SELECT a.state_abbr,
       a.total_2015,
       b.total_2018,
       SAFE_DIVIDE(b.total_2018 - a.total_2015, a.total_2015) * 100 AS pct_change
FROM (
    SELECT SUBSTR(`CoC_Number`, 0, 2) AS state_abbr,
           SUM(`Unsheltered_Homeless`) AS total_2015
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2015
    GROUP BY state_abbr
) a
JOIN (
    SELECT SUBSTR(`CoC_Number`, 0, 2) AS state_abbr,
           SUM(`Unsheltered_Homeless`) AS total_2018
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2018
    GROUP BY state_abbr
) b
ON a.state_abbr = b.state_abbr
ORDER BY pct_change
LIMIT 20;
```

```sql
-- 6) National average of those state-level percentage changes
SELECT AVG(pct_change) AS national_avg_pct_change
FROM (
    SELECT SAFE_DIVIDE(b.total_2018 - a.total_2015, a.total_2015) * 100 AS pct_change
    FROM (
        SELECT SUBSTR(`CoC_Number`, 0, 2) AS state_abbr,
               SUM(`Unsheltered_Homeless`) AS total_2015
        FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
        WHERE `Count_Year` = 2015
        GROUP BY state_abbr
    ) a
    JOIN (
        SELECT SUBSTR(`CoC_Number`, 0, 2) AS state_abbr,
               SUM(`Unsheltered_Homeless`) AS total_2018
        FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
        WHERE `Count_Year` = 2018
        GROUP BY state_abbr
    ) b
    ON a.state_abbr = b.state_abbr
)
LIMIT 20;
```

```sql
-- 7) Distance of each state's pct-change from the national average (smallest 20 distances)
WITH per_state AS (
    SELECT a.state_abbr,
           SAFE_DIVIDE(b.total_2018 - a.total_2015, a.total_2015) * 100 AS pct_change
    FROM (
        SELECT SUBSTR(`CoC_Number`, 0, 2) AS state_abbr,
               SUM(`Unsheltered_Homeless`) AS total_2015
        FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
        WHERE `Count_Year` = 2015
        GROUP BY state_abbr
    ) a
    JOIN (
        SELECT SUBSTR(`CoC_Number`, 0, 2) AS state_abbr,
               SUM(`Unsheltered_Homeless`) AS total_2018
        FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
        WHERE `Count_Year` = 2018
        GROUP BY state_abbr
    ) b
    ON a.state_abbr = b.state_abbr
),
avg_val AS (
    SELECT AVG(pct_change) AS national_avg FROM per_state
)
SELECT p.state_abbr,
       p.pct_change,
       a.national_avg,
       ABS(p.pct_change - a.national_avg) AS diff_from_avg
FROM per_state p
CROSS JOIN avg_val a
ORDER BY diff_from_avg
LIMIT 20;
```

```sql
-- 8) FINAL ANSWER: Five states whose percentage change is closest to the national average
WITH per_state AS (
    SELECT a.state_abbr,
           SAFE_DIVIDE(b.total_2018 - a.total_2015, a.total_2015) * 100 AS pct_change
    FROM (
        SELECT SUBSTR(`CoC_Number`, 0, 2) AS state_abbr,
               SUM(`Unsheltered_Homeless`) AS total_2015
        FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
        WHERE `Count_Year` = 2015
        GROUP BY state_abbr
    ) a
    JOIN (
        SELECT SUBSTR(`CoC_Number`, 0, 2) AS state_abbr,
               SUM(`Unsheltered_Homeless`) AS total_2018
        FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
        WHERE `Count_Year` = 2018
        GROUP BY state_abbr
    ) b
    ON a.state_abbr = b.state_abbr
),
avg_val AS (
    SELECT AVG(pct_change) AS national_avg FROM per_state
)
SELECT p.state_abbr
FROM per_state p
CROSS JOIN avg_val a
ORDER BY ABS(p.pct_change - a.national_avg)
LIMIT 5;
```
