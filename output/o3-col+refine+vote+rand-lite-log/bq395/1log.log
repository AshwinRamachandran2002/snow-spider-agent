    GROUP BY state_abbr
) a
JOIN (
    SELECT SUBSTR(`CoC_Number`, 0, 2) AS state_abbr,
           SUM(`Unsheltered_Homeless`) AS total_2018
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2018
    GROUP BY state_abbr
) b
ON a.state_abbr = b.state_abbr
ORDER BY pct_change
LIMIT 20;
