Query:
-- Description: Compute the 2015-to-2018 percentage change for each state (only those with data in both years).
WITH yearly AS (
  SELECT
    SUBSTR(CoC_Number, 1, 2) AS state_abbrev,
    Count_Year,
    SUM(Unsheltered_Homeless) AS total_unsheltered
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE Count_Year IN (2015, 2018)
  GROUP BY state_abbrev, Count_Year
)
SELECT
  y2015.state_abbrev,
  y2015.total_unsheltered AS unsheltered_2015,
  y2018.total_unsheltered AS unsheltered_2018,
  SAFE_DIVIDE(y2018.total_unsheltered - y2015.total_unsheltered, y2015.total_unsheltered) * 100 AS pct_change
FROM yearly y2015
JOIN yearly y2018
  ON y2015.state_abbrev = y2018.state_abbrev
  AND y2015.Count_Year = 2015
  AND y2018.Count_Year = 2018
ORDER BY state_abbrev
LIMIT 20;
