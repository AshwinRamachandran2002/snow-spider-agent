LIMIT 20;
```

```sql
-- Description: Sum the unsheltered counts by state for the two target years (2015 & 2018).
SELECT
  SUBSTR(CoC_Number, 1, 2) AS state_abbrev,
  Count_Year,
  SUM(Unsheltered_Homeless) AS total_unsheltered
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE Count_Year IN (2015, 2018)
GROUP BY state_abbrev, Count_Year
ORDER BY state_abbrev, Count_Year
LIMIT 20;
```

```sql
-- Description: Compute the 2015-to-2018 percentage change for each state (only those with data in both years).
WITH yearly AS (
  SELECT
    SUBSTR(CoC_Number, 1, 2) AS state_abbrev,
    Count_Year,
    SUM(Unsheltered_Homeless) AS total_unsheltered
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE Count_Year IN (2015, 2018)
  GROUP BY state_abbrev, Count_Year
)
SELECT
  y2015.state_abbrev,
  y2015.total_unsheltered AS unsheltered_2015,
  y2018.total_unsheltered AS unsheltered_2018,
  SAFE_DIVIDE(y2018.total_unsheltered - y2015.total_unsheltered, y2015.total_unsheltered) * 100 AS pct_change
FROM yearly y2015
JOIN yearly y2018
  ON y2015.state_abbrev = y2018.state_abbrev
  AND y2015.Count_Year = 2015
  AND y2018.Count_Year = 2018
ORDER BY state_abbrev
LIMIT 20;
```

```sql
-- Description: Calculate the national average of the state-level percentage changes.
WITH yearly AS (
  SELECT
    SUBSTR(CoC_Number, 1, 2) AS state_abbrev,
    Count_Year,
    SUM(Unsheltered_Homeless) AS total_unsheltered
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE Count_Year IN (2015, 2018)
  GROUP BY state_abbrev, Count_Year
),
state_pct AS (
  SELECT
    y2015.state_abbrev,
    SAFE_DIVIDE(y2018.total_unsheltered - y2015.total_unsheltered, y2015.total_unsheltered) * 100 AS pct_change
  FROM yearly y2015
  JOIN yearly y2018
    ON y2015.state_abbrev = y2018.state_abbrev
    AND y2015.Count_Year = 2015
    AND y2018.Count_Year = 2018
)
SELECT
  AVG(pct_change) AS national_avg_pct_change
FROM state_pct;
```

```sql
-- Description: Show each state’s percentage change alongside its difference from the national average.
WITH yearly AS (
  SELECT
    SUBSTR(CoC_Number, 1, 2) AS state_abbrev,
    Count_Year,
    SUM(Unsheltered_Homeless) AS total_unsheltered
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE Count_Year IN (2015, 2018)
  GROUP BY state_abbrev, Count_Year
),
state_pct AS (
  SELECT
    y2015.state_abbrev,
    SAFE_DIVIDE(y2018.total_unsheltered - y2015.total_unsheltered, y2015.total_unsheltered) * 100 AS pct_change
  FROM yearly y2015
  JOIN yearly y2018
    ON y2015.state_abbrev = y2018.state_abbrev
    AND y2015.Count_Year = 2015
    AND y2018.Count_Year = 2018
),
national AS (
  SELECT AVG(pct_change) AS national_avg_pct_change FROM state_pct
)
SELECT
  sp.state_abbrev,
  sp.pct_change,
  n.national_avg_pct_change,
  ABS(sp.pct_change - n.national_avg_pct_change) AS diff_from_avg
FROM state_pct sp
CROSS JOIN national n
ORDER BY diff_from_avg
LIMIT 20;
```

```sql
-- Description: Select the five states whose percentage changes are closest to the national average.
WITH yearly AS (
  SELECT
    SUBSTR(CoC_Number, 1, 2) AS state_abbrev,
    Count_Year,
    SUM(Unsheltered_Homeless) AS total_unsheltered
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE Count_Year IN (2015, 2018)
  GROUP BY state_abbrev, Count_Year
),
state_pct AS (
  SELECT
    y2015.state_abbrev,
    SAFE_DIVIDE(y2018.total_unsheltered - y2015.total_unsheltered, y2015.total_unsheltered) * 100 AS pct_change
  FROM yearly y2015
  JOIN yearly y2018
    ON y2015.state_abbrev = y2018.state_abbrev
    AND y2015.Count_Year = 2015
    AND y2018.Count_Year = 2018
),
national AS (
  SELECT AVG(pct_change) AS national_avg_pct_change FROM state_pct
)
SELECT
  sp.state_abbrev
FROM state_pct sp
CROSS JOIN national n
ORDER BY ABS(sp.pct_change - n.national_avg_pct_change)
LIMIT 5;
```

