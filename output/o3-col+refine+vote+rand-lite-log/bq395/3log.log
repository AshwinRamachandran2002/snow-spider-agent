```sql
-- 1. Peek at a few CoC numbers to understand the state-code pattern (first two letters)
SELECT DISTINCT `CoC_Number`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
LIMIT 20;
```

```sql
-- 2. Show one row with the derived two-letter state abbreviation plus the columns we need
SELECT SUBSTR(`CoC_Number`,1,2) AS state_abbrev,
       `CoC_Number`,
       `Unsheltered_Homeless`,
       `Count_Year`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
LIMIT 20;
```

```sql
-- 3. List distinct years available, to confirm 2015 and 2018 are present
SELECT DISTINCT `Count_Year`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
ORDER BY `Count_Year`
LIMIT 20;
```

```sql
-- 4. Aggregate total unsheltered counts per state for the two target years
SELECT SUBSTR(`CoC_Number`,1,2) AS state_abbrev,
       SUM(CASE WHEN `Count_Year` = 2015 THEN `Unsheltered_Homeless` END) AS unsheltered_2015,
       SUM(CASE WHEN `Count_Year` = 2018 THEN `Unsheltered_Homeless` END) AS unsheltered_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `Count_Year` IN (2015,2018)
GROUP BY state_abbrev
LIMIT 20;
```

```sql
-- 5. Compute each state’s percentage change from 2015→2018, keeping only states with non-zero 2015 totals
SELECT state_abbrev,
       SAFE_DIVIDE(unsheltered_2018 - unsheltered_2015, unsheltered_2015) AS pct_change
FROM (
  SELECT SUBSTR(`CoC_Number`,1,2) AS state_abbrev,
         SUM(CASE WHEN `Count_Year` = 2015 THEN `Unsheltered_Homeless` END) AS unsheltered_2015,
         SUM(CASE WHEN `Count_Year` = 2018 THEN `Unsheltered_Homeless` END) AS unsheltered_2018
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` IN (2015,2018)
  GROUP BY state_abbrev
)
WHERE unsheltered_2015 > 0
LIMIT 20;
```

```sql
-- 6. Find the national average of those state percentage changes
SELECT AVG(pct_change) AS national_avg_pct_change
FROM (
  SELECT state_abbrev,
         SAFE_DIVIDE(unsheltered_2018 - unsheltered_2015, unsheltered_2015) AS pct_change
  FROM (
    SELECT SUBSTR(`CoC_Number`,1,2) AS state_abbrev,
           SUM(CASE WHEN `Count_Year` = 2015 THEN `Unsheltered_Homeless` END) AS unsheltered_2015,
           SUM(CASE WHEN `Count_Year` = 2018 THEN `Unsheltered_Homeless` END) AS unsheltered_2018
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` IN (2015,2018)
    GROUP BY state_abbrev
  )
  WHERE unsheltered_2015 > 0
)
LIMIT 20;
```

```sql
-- 7. For each state, compute its absolute distance from that national average
WITH state_changes AS (
  SELECT state_abbrev,
         SAFE_DIVIDE(unsheltered_2018 - unsheltered_2015, unsheltered_2015) AS pct_change
  FROM (
    SELECT SUBSTR(`CoC_Number`,1,2) AS state_abbrev,
           SUM(CASE WHEN `Count_Year` = 2015 THEN `Unsheltered_Homeless` END) AS unsheltered_2015,
           SUM(CASE WHEN `Count_Year` = 2018 THEN `Unsheltered_Homeless` END) AS unsheltered_2018
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` IN (2015,2018)
    GROUP BY state_abbrev
  )
  WHERE unsheltered_2015 > 0
),
avg_val AS (
  SELECT AVG(pct_change) AS national_avg
  FROM state_changes
)
SELECT sc.state_abbrev,
       sc.pct_change,
       ABS(sc.pct_change - av.national_avg) AS distance_from_avg
FROM state_changes AS sc
CROSS JOIN avg_val AS av
ORDER BY distance_from_avg
LIMIT 20;
```

```sql
-- 8. Retrieve only the five states whose percentage change is closest to the national average
WITH state_changes AS (
  SELECT state_abbrev,
         SAFE_DIVIDE(unsheltered_2018 - unsheltered_2015, unsheltered_2015) AS pct_change
  FROM (
    SELECT SUBSTR(`CoC_Number`,1,2) AS state_abbrev,
           SUM(CASE WHEN `Count_Year` = 2015 THEN `Unsheltered_Homeless` END) AS unsheltered_2015,
           SUM(CASE WHEN `Count_Year` = 2018 THEN `Unsheltered_Homeless` END) AS unsheltered_2018
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` IN (2015,2018)
    GROUP BY state_abbrev
  )
  WHERE unsheltered_2015 > 0
),
avg_val AS (
  SELECT AVG(pct_change) AS national_avg
  FROM state_changes
)
SELECT sc.state_abbrev
FROM state_changes AS sc
CROSS JOIN avg_val AS av
ORDER BY ABS(sc.pct_change - av.national_avg)
LIMIT 5;
```

```sql
-- 9. (Optional) Verify the final list together with their percentage changes and the national average
WITH state_changes AS (
  SELECT state_abbrev,
         SAFE_DIVIDE(unsheltered_2018 - unsheltered_2015, unsheltered_2015) AS pct_change
  FROM (
    SELECT SUBSTR(`CoC_Number`,1,2) AS state_abbrev,
           SUM(CASE WHEN `Count_Year` = 2015 THEN `Unsheltered_Homeless` END) AS unsheltered_2015,
           SUM(CASE WHEN `Count_Year` = 2018 THEN `Unsheltered_Homeless` END) AS unsheltered_2018
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` IN (2015,2018)
    GROUP BY state_abbrev
  )
  WHERE unsheltered_2015 > 0
),
avg_val AS (
  SELECT AVG(pct_change) AS national_avg
  FROM state_changes
),
closest AS (
  SELECT sc.*,
         ABS(sc.pct_change - av.national_avg) AS distance_from_avg
  FROM state_changes AS sc
  CROSS JOIN avg_val AS av
  ORDER BY distance_from_avg
  LIMIT 5
)
SELECT closest.*, av.national_avg
FROM closest
CROSS JOIN avg_val AS av
LIMIT 20;
```

