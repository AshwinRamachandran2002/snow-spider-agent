Query:
-- 7. For each state, compute its absolute distance from that national average
WITH state_changes AS (
  SELECT state_abbrev,
         SAFE_DIVIDE(unsheltered_2018 - unsheltered_2015, unsheltered_2015) AS pct_change
  FROM (
    SELECT SUBSTR(`CoC_Number`,1,2) AS state_abbrev,
           SUM(CASE WHEN `Count_Year` = 2015 THEN `Unsheltered_Homeless` END) AS unsheltered_2015,
           SUM(CASE WHEN `Count_Year` = 2018 THEN `Unsheltered_Homeless` END) AS unsheltered_2018
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` IN (2015,2018)
    GROUP BY state_abbrev
  )
  WHERE unsheltered_2015 > 0
),
avg_val AS (
  SELECT AVG(pct_change) AS national_avg
  FROM state_changes
)
SELECT sc.state_abbrev,
       sc.pct_change,
       ABS(sc.pct_change - av.national_avg) AS distance_from_avg
FROM state_changes AS sc
CROSS JOIN avg_val AS av
ORDER BY distance_from_avg
LIMIT 20;
