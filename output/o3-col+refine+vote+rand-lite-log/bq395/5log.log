```

```sql
-- 5. Description: Total unsheltered homeless by state for 2015
SELECT 
  SUBSTR(`CoC_Number`, 1, 2) AS state_abbrev,
  SUM(`Unsheltered_Homeless`) AS unsheltered_2015
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `Count_Year` = 2015
GROUP BY state_abbrev
ORDER BY unsheltered_2015 DESC
LIMIT 20;
```

```sql
-- 6. Description: Total unsheltered homeless by state for 2018
SELECT 
  SUBSTR(`CoC_Number`, 1, 2) AS state_abbrev,
  SUM(`Unsheltered_Homeless`) AS unsheltered_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `Count_Year` = 2018
GROUP BY state_abbrev
ORDER BY unsheltered_2018 DESC
LIMIT 20;
```

```sql
-- 7. Description: Join 2015 & 2018 totals and compute percentage change per state
WITH
  y2015 AS (
    SELECT SUBSTR(`CoC_Number`, 1, 2) AS st, SUM(`Unsheltered_Homeless`) AS u2015
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2015
    GROUP BY st),
  y2018 AS (
    SELECT SUBSTR(`CoC_Number`, 1, 2) AS st, SUM(`Unsheltered_Homeless`) AS u2018
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2018
    GROUP BY st)
SELECT 
  y2015.st AS state_abbrev,
  u2015,
  u2018,
  SAFE_DIVIDE(u2018 - u2015, u2015) * 100 AS pct_change_2015_2018
FROM y2015
JOIN y2018 USING (st)
WHERE u2015 > 0
ORDER BY pct_change_2015_2018 DESC
LIMIT 20;
```

```sql
-- 8. Description: Compute national average of the state percentage changes
WITH
  y2015 AS (
    SELECT SUBSTR(`CoC_Number`, 1, 2) AS st, SUM(`Unsheltered_Homeless`) AS u2015
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2015
    GROUP BY st),
  y2018 AS (
    SELECT SUBSTR(`CoC_Number`, 1, 2) AS st, SUM(`Unsheltered_Homeless`) AS u2018
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2018
    GROUP BY st),
  pct AS (
    SELECT 
      y2015.st,
      SAFE_DIVIDE(u2018 - u2015, u2015) * 100 AS pct_change
    FROM y2015 JOIN y2018 USING (st)
    WHERE u2015 > 0)
SELECT 
  AVG(pct_change) AS national_avg_pct_change
FROM pct
LIMIT 20;
```

```sql
-- 9. Description: Identify the five states whose percentage change is closest to the national average
WITH
  y2015 AS (
    SELECT SUBSTR(`CoC_Number`, 1, 2) AS st, SUM(`Unsheltered_Homeless`) AS u2015
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2015
    GROUP BY st),
  y2018 AS (
    SELECT SUBSTR(`CoC_Number`, 1, 2) AS st, SUM(`Unsheltered_Homeless`) AS u2018
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2018
    GROUP BY st),
  pct AS (
    SELECT 
      y2015.st AS state_abbrev,
      SAFE_DIVIDE(u2018 - u2015, u2015) * 100 AS pct_change
    FROM y2015 JOIN y2018 USING (st)
    WHERE u2015 > 0),
  nat AS (
    SELECT AVG(pct_change) AS nat_avg FROM pct)
SELECT 
  p.state_abbrev
FROM pct AS p
CROSS JOIN nat
ORDER BY ABS(p.pct_change - nat.nat_avg) ASC
LIMIT 5;
```
