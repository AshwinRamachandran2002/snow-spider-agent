```

```sql
-- 4. Aggregate: total unsheltered homeless counts per state for 2015
SELECT
  SPLIT(`CoC_Number`, '-')[SAFE_OFFSET(0)] AS state,
  SUM(`Unsheltered_Homeless`) AS unsheltered_2015
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `Count_Year` = 2015
GROUP BY state
ORDER BY unsheltered_2015 DESC
LIMIT 20;
```

```sql
-- 5. Aggregate: total unsheltered homeless counts per state for 2018
SELECT
  SPLIT(`CoC_Number`, '-')[SAFE_OFFSET(0)] AS state,
  SUM(`Unsheltered_Homeless`) AS unsheltered_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `Count_Year` = 2018
GROUP BY state
ORDER BY unsheltered_2018 DESC
LIMIT 20;
```

```sql
-- 6. Compute: percentage change (2015 ➜ 2018) for every state
WITH yr15 AS (
  SELECT SPLIT(`CoC_Number`, '-')[SAFE_OFFSET(0)] AS state,
         SUM(`Unsheltered_Homeless`) AS u15
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2015
  GROUP BY state
),
yr18 AS (
  SELECT SPLIT(`CoC_Number`, '-')[SAFE_OFFSET(0)] AS state,
         SUM(`Unsheltered_Homeless`) AS u18
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2018
  GROUP BY state
)
SELECT
  y15.state,
  y15.u15,
  y18.u18,
  100.0 * (y18.u18 - y15.u15) / y15.u15 AS pct_change
FROM yr15 y15
JOIN yr18 y18
ON y15.state = y18.state
ORDER BY pct_change DESC
LIMIT 20;
```

```sql
-- 7. Calculate: national average of state‐level percentage changes
WITH pct AS (
  /* reuse logic from step 6 */
  WITH yr15 AS (
    SELECT SPLIT(`CoC_Number`, '-')[SAFE_OFFSET(0)] AS state,
           SUM(`Unsheltered_Homeless`) AS u15
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2015
    GROUP BY state
  ),
  yr18 AS (
    SELECT SPLIT(`CoC_Number`, '-')[SAFE_OFFSET(0)] AS state,
           SUM(`Unsheltered_Homeless`) AS u18
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2018
    GROUP BY state
  )
  SELECT
    y15.state,
    100.0 * (y18.u18 - y15.u15) / y15.u15 AS pct_change
  FROM yr15 y15
  JOIN yr18 y18
  ON y15.state = y18.state
)
SELECT AVG(pct_change) AS national_avg_pct_change
FROM pct
LIMIT 20;
```

```sql
-- 8. Compare: absolute deviation of each state’s % change from the national average
WITH pct AS (
  WITH yr15 AS (
    SELECT SPLIT(`CoC_Number`, '-')[SAFE_OFFSET(0)] AS state,
           SUM(`Unsheltered_Homeless`) AS u15
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2015
    GROUP BY state
  ),
  yr18 AS (
    SELECT SPLIT(`CoC_Number`, '-')[SAFE_OFFSET(0)] AS state,
           SUM(`Unsheltered_Homeless`) AS u18
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2018
    GROUP BY state
  )
  SELECT
    y15.state,
    100.0 * (y18.u18 - y15.u15) / y15.u15 AS pct_change
  FROM yr15 y15
  JOIN yr18 y18
  ON y15.state = y18.state
),
national AS (
  SELECT AVG(pct_change) AS nat_avg FROM pct
)
SELECT
  p.state,
  p.pct_change,
  n.nat_avg,
  ABS(p.pct_change - n.nat_avg) AS abs_diff
FROM pct p
CROSS JOIN national n
ORDER BY abs_diff ASC
LIMIT 20;
```

```sql
-- 9. Final answer: five states whose % change is closest to the national average
WITH pct AS (
  WITH yr15 AS (
    SELECT SPLIT(`CoC_Number`, '-')[SAFE_OFFSET(0)] AS state,
           SUM(`Unsheltered_Homeless`) AS u15
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2015
    GROUP BY state
  ),
  yr18 AS (
    SELECT SPLIT(`CoC_Number`, '-')[SAFE_OFFSET(0)] AS state,
           SUM(`Unsheltered_Homeless`) AS u18
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2018
    GROUP BY state
  )
  SELECT
    y15.state,
    100.0 * (y18.u18 - y15.u15) / y15.u15 AS pct_change
  FROM yr15 y15
  JOIN yr18 y18
  ON y15.state = y18.state
),
national AS (
  SELECT AVG(pct_change) AS nat_avg FROM pct
)
SELECT
  p.state                          -- state abbreviation
FROM pct p
CROSS JOIN national n
ORDER BY ABS(p.pct_change - n.nat_avg) ASC      -- closest to national average
LIMIT 5;                                         -- five closest states
```
