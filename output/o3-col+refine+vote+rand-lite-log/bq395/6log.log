Query:
-- 6. Compute: percentage change (2015 ➜ 2018) for every state
WITH yr15 AS (
  SELECT SPLIT(`CoC_Number`, '-')[SAFE_OFFSET(0)] AS state,
         SUM(`Unsheltered_Homeless`) AS u15
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2015
  GROUP BY state
),
yr18 AS (
  SELECT SPLIT(`CoC_Number`, '-')[SAFE_OFFSET(0)] AS state,
         SUM(`Unsheltered_Homeless`) AS u18
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2018
  GROUP BY state
)
SELECT
  y15.state,
  y15.u15,
  y18.u18,
  100.0 * (y18.u18 - y15.u15) / y15.u15 AS pct_change
FROM yr15 y15
JOIN yr18 y18
ON y15.state = y18.state
ORDER BY pct_change DESC
LIMIT 20;
Answer:
