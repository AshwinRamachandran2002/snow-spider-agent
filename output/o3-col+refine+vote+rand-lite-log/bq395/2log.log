FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
LIMIT 20;
```

```sql
-- 2. See which PIT count years are available
SELECT DISTINCT `Count_Year`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
ORDER BY `Count_Year`
LIMIT 20;
```

```sql
-- 3. Extract the two–letter state/territory code from CoC_Number
SELECT DISTINCT SUBSTR(`CoC_Number`, 1, 2) AS state_code
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
ORDER BY state_code
LIMIT 20;
```

```sql
-- 4. State-level totals of Unsheltered Homeless in 2015
SELECT 
  SUBSTR(`CoC_Number`, 1, 2) AS state_code,
  SUM(`Unsheltered_Homeless`) AS total_2015
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `Count_Year` = 2015
GROUP BY state_code
ORDER BY total_2015 DESC
LIMIT 20;
```

```sql
-- 5. State-level totals of Unsheltered Homeless in 2018
SELECT 
  SUBSTR(`CoC_Number`, 1, 2) AS state_code,
  SUM(`Unsheltered_Homeless`) AS total_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `Count_Year` = 2018
GROUP BY state_code
ORDER BY total_2018 DESC
LIMIT 20;
```

```sql
-- 6. Combine 2015 and 2018 state totals side-by-side
WITH yr15 AS (
  SELECT SUBSTR(`CoC_Number`, 1, 2) AS state_code,
         SUM(`Unsheltered_Homeless`) AS total_2015
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2015
  GROUP BY state_code
), yr18 AS (
  SELECT SUBSTR(`CoC_Number`, 1, 2) AS state_code,
         SUM(`Unsheltered_Homeless`) AS total_2018
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2018
  GROUP BY state_code
)
SELECT 
  COALESCE(yr15.state_code, yr18.state_code) AS state_code,
  total_2015,
  total_2018
FROM yr15
FULL JOIN yr18 USING (state_code)
ORDER BY state_code
LIMIT 20;
```

```sql
-- 7. Percentage change (2015 → 2018) for each state
WITH yr15 AS (
  SELECT SUBSTR(`CoC_Number`, 1, 2) AS state_code,
         SUM(`Unsheltered_Homeless`) AS total_2015
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2015
  GROUP BY state_code
), yr18 AS (
  SELECT SUBSTR(`CoC_Number`, 1, 2) AS state_code,
         SUM(`Unsheltered_Homeless`) AS total_2018
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2018
  GROUP BY state_code
)
SELECT 
  COALESCE(yr15.state_code, yr18.state_code) AS state_code,
  total_2015,
  total_2018,
  SAFE_DIVIDE(total_2018 - total_2015, total_2015) * 100 AS pct_change
FROM yr15
FULL JOIN yr18 USING (state_code)
ORDER BY pct_change DESC
LIMIT 20;
```

```sql
-- 8. National average of the state percentage changes
WITH yr15 AS (
  SELECT SUBSTR(`CoC_Number`, 1, 2) AS state_code,
         SUM(`Unsheltered_Homeless`) AS total_2015
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2015
  GROUP BY state_code
), yr18 AS (
  SELECT SUBSTR(`CoC_Number`, 1, 2) AS state_code,
         SUM(`Unsheltered_Homeless`) AS total_2018
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2018
  GROUP BY state_code
), pct AS (
  SELECT 
    COALESCE(yr15.state_code, yr18.state_code) AS state_code,
    SAFE_DIVIDE(total_2018 - total_2015, total_2015) * 100 AS pct_change
  FROM yr15
  FULL JOIN yr18 USING (state_code)
)
SELECT AVG(pct_change) AS national_avg_pct_change
FROM pct
LIMIT 20;
```

```sql
-- 9. Distance of each state’s % change from the national average
WITH yr15 AS (
  SELECT SUBSTR(`CoC_Number`, 1, 2) AS state_code,
         SUM(`Unsheltered_Homeless`) AS total_2015
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2015
  GROUP BY state_code
), yr18 AS (
  SELECT SUBSTR(`CoC_Number`, 1, 2) AS state_code,
         SUM(`Unsheltered_Homeless`) AS total_2018
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2018
  GROUP BY state_code
), pct AS (
  SELECT 
    COALESCE(yr15.state_code, yr18.state_code) AS state_code,
    SAFE_DIVIDE(total_2018 - total_2015, total_2015) * 100 AS pct_change
  FROM yr15
  FULL JOIN yr18 USING (state_code)
), national AS (
  SELECT AVG(pct_change) AS nat_avg FROM pct
)
SELECT 
  pct.state_code,
  pct.pct_change,
  national.nat_avg,
  ABS(pct.pct_change - national.nat_avg) AS diff_from_avg
FROM pct, national
ORDER BY diff_from_avg ASC
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: Five states whose % change is closest to the national average
WITH yr15 AS (
  SELECT SUBSTR(`CoC_Number`, 1, 2) AS state_code,
         SUM(`Unsheltered_Homeless`) AS total_2015
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2015
  GROUP BY state_code
), yr18 AS (
  SELECT SUBSTR(`CoC_Number`, 1, 2) AS state_code,
         SUM(`Unsheltered_Homeless`) AS total_2018
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2018
  GROUP BY state_code
), pct AS (
  SELECT 
    COALESCE(yr15.state_code, yr18.state_code) AS state_code,
    SAFE_DIVIDE(total_2018 - total_2015, total_2015) * 100 AS pct_change
  FROM yr15
  FULL JOIN yr18 USING (state_code)
), national AS (
  SELECT AVG(pct_change) AS nat_avg FROM pct
)
SELECT 
  pct.state_code
FROM pct, national
ORDER BY ABS(pct.pct_change - national.nat_avg) ASC
LIMIT 5;
```
