```sql
-- 1. Preview a few rows of the homelessness Point-in-Time (PIT) file
SELECT *
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
LIMIT 20;
```

```sql
-- 2. See what PIT count years are present
SELECT DISTINCT `Count_Year`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
ORDER BY `Count_Year`
LIMIT 20;
```

```sql
-- 3. List the distinct Continuum-of-Care (CoC) codes and the
--    two-letter state / territory abbreviation embedded in them
SELECT DISTINCT
       `CoC_Number`,
       SUBSTR(`CoC_Number`, 1, 2) AS state
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
LIMIT 20;
```

```sql
-- 4. Total unsheltered homeless persons in 2015 by state
SELECT
  SUBSTR(`CoC_Number`, 1, 2) AS state,
  SUM(`Unsheltered_Homeless`) AS unsheltered_2015
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `Count_Year` = 2015
GROUP BY state
LIMIT 20;
```

```sql
-- 5. Total unsheltered homeless persons in 2018 by state
SELECT
  SUBSTR(`CoC_Number`, 1, 2) AS state,
  SUM(`Unsheltered_Homeless`) AS unsheltered_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `Count_Year` = 2018
GROUP BY state
LIMIT 20;
```

```sql
-- 6. Percentage change from 2015 to 2018 for every state
SELECT
  s2015.state,
  s2015.unsheltered_2015,
  s2018.unsheltered_2018,
  100.0 * (s2018.unsheltered_2018 - s2015.unsheltered_2015)
/ NULLIF(s2015.unsheltered_2015,0) AS pct_change_15_18
FROM (
  SELECT SUBSTR(`CoC_Number`,1,2) AS state,
         SUM(`Unsheltered_Homeless`) AS unsheltered_2015
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2015
  GROUP BY state
) AS s2015
JOIN (
  SELECT SUBSTR(`CoC_Number`,1,2) AS state,
         SUM(`Unsheltered_Homeless`) AS unsheltered_2018
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2018
  GROUP BY state
) AS s2018
USING (state)
LIMIT 20;
```

```sql
-- 7. Compute the national (state-level) average of those percentage changes
WITH pct AS (
  SELECT
    s2015.state,
    100.0 * (s2018.unsheltered_2018 - s2015.unsheltered_2015)
/ NULLIF(s2015.unsheltered_2015,0) AS pct_change_15_18
  FROM (
    SELECT SUBSTR(`CoC_Number`,1,2) AS state,
           SUM(`Unsheltered_Homeless`) AS unsheltered_2015
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2015
    GROUP BY state
  ) AS s2015
  JOIN (
    SELECT SUBSTR(`CoC_Number`,1,2) AS state,
           SUM(`Unsheltered_Homeless`) AS unsheltered_2018
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2018
    GROUP BY state
  ) AS s2018
  USING (state)
)
SELECT AVG(pct_change_15_18) AS national_avg_pct_change
FROM pct;
```

```sql
-- 8. Five states whose percentage change is closest to that national average
WITH pct AS (
  SELECT
    s2015.state,
    100.0 * (s2018.unsheltered_2018 - s2015.unsheltered_2015)
/ NULLIF(s2015.unsheltered_2015,0) AS pct_change_15_18
  FROM (
    SELECT SUBSTR(`CoC_Number`,1,2) AS state,
           SUM(`Unsheltered_Homeless`) AS unsheltered_2015
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2015
    GROUP BY state
  ) AS s2015
  JOIN (
    SELECT SUBSTR(`CoC_Number`,1,2) AS state,
           SUM(`Unsheltered_Homeless`) AS unsheltered_2018
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2018
    GROUP BY state
  ) AS s2018
  USING (state)
),
avg_val AS (
  SELECT AVG(pct_change_15_18) AS national_avg_pct_change FROM pct
)
SELECT
  p.state
FROM pct AS p
CROSS JOIN avg_val
ORDER BY ABS(p.pct_change_15_18 - avg_val.national_avg_pct_change) ASC
LIMIT 5;
```

```sql
-- 9. Just return the five state abbreviations (clean final output)
