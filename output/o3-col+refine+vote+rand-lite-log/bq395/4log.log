    s2015.state,
    100.0 * (s2018.unsheltered_2018 - s2015.unsheltered_2015)
/ NULLIF(s2015.unsheltered_2015,0) AS pct_change_15_18
  FROM (
    SELECT SUBSTR(`CoC_Number`,1,2) AS state,
           SUM(`Unsheltered_Homeless`) AS unsheltered_2015
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2015
    GROUP BY state
  ) AS s2015
  JOIN (
    SELECT SUBSTR(`CoC_Number`,1,2) AS state,
           SUM(`Unsheltered_Homeless`) AS unsheltered_2018
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2018
    GROUP BY state
  ) AS s2018
  USING (state)
),
avg_val AS (
  SELECT AVG(pct_change_15_18) AS national_avg_pct_change FROM pct
)
SELECT p.state
FROM pct AS p
CROSS JOIN avg_val
ORDER BY ABS(p.pct_change_15_18 - avg_val.national_avg_pct_change)
LIMIT 5;
```

```sql
-- 10. (Optional) Inspect the final percentage change values for those five states
WITH pct AS (
  SELECT
    s2015.state,
    100.0 * (s2018.unsheltered_2018 - s2015.unsheltered_2015)
/ NULLIF(s2015.unsheltered_2015,0) AS pct_change_15_18
  FROM (
    SELECT SUBSTR(`CoC_Number`,1,2) AS state,
           SUM(`Unsheltered_Homeless`) AS unsheltered_2015
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2015
    GROUP BY state
  ) AS s2015
  JOIN (
    SELECT SUBSTR(`CoC_Number`,1,2) AS state,
           SUM(`Unsheltered_Homeless`) AS unsheltered_2018
    FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
    WHERE `Count_Year` = 2018
    GROUP BY state
  ) AS s2018
  USING (state)
),
avg_val AS (
  SELECT AVG(pct_change_15_18) AS national_avg_pct_change FROM pct
),
closest_states AS (
  SELECT p.state
  FROM pct AS p
  CROSS JOIN avg_val
  ORDER BY ABS(p.pct_change_15_18 - avg_val.national_avg_pct_change)
  LIMIT 5
)
SELECT cs.state, p.pct_change_15_18
FROM closest_states AS cs
JOIN pct AS p
USING (state)
ORDER BY cs.state
LIMIT 20;
```
