-- 6. Percentage change from 2015 to 2018 for every state
SELECT
  s2015.state,
  s2015.unsheltered_2015,
  s2018.unsheltered_2018,
  100.0 * (s2018.unsheltered_2018 - s2015.unsheltered_2015)
/ NULLIF(s2015.unsheltered_2015,0) AS pct_change_15_18
FROM (
  SELECT SUBSTR(`CoC_Number`,1,2) AS state,
         SUM(`Unsheltered_Homeless`) AS unsheltered_2015
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2015
  GROUP BY state
) AS s2015
JOIN (
  SELECT SUBSTR(`CoC_Number`,1,2) AS state,
         SUM(`Unsheltered_Homeless`) AS unsheltered_2018
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `Count_Year` = 2018
  GROUP BY state
) AS s2018
USING (state)
LIMIT 20;
