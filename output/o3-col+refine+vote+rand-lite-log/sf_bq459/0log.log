WITH
-- ------------------------------------------------------------
-- 1. Build a vector for every Nature article
-- ------------------------------------------------------------
article_vectors AS (
    SELECT
        n."id",
        n."date",
        n."title",
        /*  Sum the frequency-weighted word vectors for each body,
            then normalise to unit length                                    */
        VECTOR_NORMALIZE
        (
            SUM
            (
                VECTOR_SCALE
                (
                    TO_VECTOR(gv."vector"),                      -- 300-D GloVe vector
                    POWER(wf."frequency", -0.4)                 -- weight = freq^-0.4
                )
            )
        )                    AS article_vec
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE               AS n
         ,LATERAL FLATTEN
                (
                    SPLIT
                    (
                        LOWER( REGEXP_REPLACE(n."body", '[^A-Za-z0-9]+', ' ') ),
                        ' '
                    )
                )                                             AS tok                  -- one token per row
         JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES AS wf  ON wf."word"  = tok.VALUE
         JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS    AS gv  ON gv."word"  = tok.VALUE
    /* crude stop-word removal: ignore ultra-common words                       */
    WHERE wf."frequency" < 5000
    GROUP BY n."id", n."date", n."title"
),

-- ------------------------------------------------------------
-- 2. Build the query vector (“Epigenetics and cerebral organoids: …”)
-- ------------------------------------------------------------
query_vector AS (
    SELECT
        VECTOR_NORMALIZE
        (
            SUM
            (
                VECTOR_SCALE
                (
                    TO_VECTOR(gv."vector"),
                    POWER(wf."frequency", -0.4)
                )
            )
        ) AS qvec
    FROM ( /* spell-out the eight query tokens, already lower-cased             */
           VALUES ('epigenetics'),
                  ('cerebral'),
                  ('organoids'),
                  ('promising'),
                  ('directions'),
                  ('autism'),
                  ('spectrum'),
                  ('disorders')
         )                                       AS qt(token)
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES AS wf ON wf."word" = qt.token
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS    AS gv ON gv."word" = qt.token
)

-- ------------------------------------------------------------
-- 3. Cosine similarity and top-10 results
-- ------------------------------------------------------------
SELECT
    av."id",
    av."date",
    av."title",
    /* both vectors are unit-normalised, so dot product = cosine similarity     */
    VECTOR_DOT_PRODUCT(av.article_vec, q.qvec)  AS similarity
FROM article_vectors  AS av
CROSS JOIN query_vector AS q
ORDER BY similarity DESC NULLS LAST
LIMIT 10;
```
