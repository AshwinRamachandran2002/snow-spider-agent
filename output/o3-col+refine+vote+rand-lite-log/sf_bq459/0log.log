WITH
/* ------------------------------------------------------------
   1.  Weighted & summed query vector
   ------------------------------------------------------------ */
query_tokens(token) AS (
    SELECT column1
    FROM VALUES
        ('epigenetics'), ('cerebral'), ('organoids'), ('promising'),
        ('directions'), ('autism'), ('spectrum'), ('disorders')
),
query_vec AS (           -- summed, frequency-weighted vector
    SELECT
        fv.index::INT                      AS idx,
        SUM( fv.value::FLOAT
             * POWER(wf."frequency", -0.4) )  AS val
    FROM query_tokens      qt
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES   wf
         ON wf."word" = qt.token
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS      gv
         ON gv."word" = qt.token,
         LATERAL FLATTEN(input => gv."vector")              fv
    GROUP BY fv.index
),
query_norm AS (          -- Euclidean length of query vector
    SELECT SQRT(SUM(val*val)) AS norm FROM query_vec
),

/* ------------------------------------------------------------
   2.  Weighted vectors for every Nature article
   ------------------------------------------------------------ */
article_vec_entries AS (     -- one row per (article, dimension)
    SELECT
        n."id",
        fv.index::INT                                            AS idx,
        SUM( fv.value::FLOAT
             * POWER(wf."frequency", -0.4) )                     AS val
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE                  n,
         LATERAL SPLIT_TO_TABLE(
                    LOWER(REGEXP_REPLACE(n."body",
                                          '[^A-Za-z0-9 ]', ' ')),
                    ' ')                                         tok
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES        wf
         ON wf."word" = tok.value
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS           gv
         ON gv."word" = tok.value,
         LATERAL FLATTEN(input => gv."vector")                   fv
    WHERE wf."frequency" < 5000          -- crude stop-word filter
    GROUP BY n."id", fv.index
),
article_norms AS (           -- length of each article vector
    SELECT "id",
           SQRT(SUM(val*val)) AS norm
    FROM article_vec_entries
    GROUP BY "id"
),
article_dot AS (             -- dot-product with query vector
    SELECT a."id",
           SUM(a.val * q.val) AS dot
    FROM article_vec_entries  a
    JOIN query_vec            q  ON q.idx = a.idx
    GROUP BY a."id"
),

/* ------------------------------------------------------------
   3.  Cosine similarity
   ------------------------------------------------------------ */
similarities AS (
    SELECT
        n."id",
        n."date",
        n."title",
        ad.dot
        / NULLIF( an.norm * qn.norm , 0 )   AS similarity
    FROM article_dot      ad
    JOIN article_norms    an  ON an."id" = ad."id"
    CROSS JOIN query_norm qn
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.NATURE n  ON n."id" = ad."id"
)

SELECT
    "id",
    "date",
    "title",
    similarity
FROM similarities
ORDER BY similarity DESC NULLS LAST
LIMIT 10;
```
