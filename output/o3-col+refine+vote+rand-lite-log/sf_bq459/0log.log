```sql
-- Description: Examine articles whose body mentions “epigenet” (captures “epigenetic”, “epigenetics”, etc.) – helpful for autism-linked epigenetic work.
SELECT "id", "date", "title"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE "body" ILIKE '%epigenet%'
LIMIT 20;
```

```sql
-- Description: Fetch a few full “body” texts containing both “autism” and “organoid” for deeper review.
SELECT "id", "date", "title", "body"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE "body" ILIKE '%autism%' AND "body" ILIKE '%organoid%'
LIMIT 20;
```

```sql
-- Description: List distinct years of publication to gauge the temporal range of the Nature data.
SELECT DISTINCT YEAR("date") AS "year"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
ORDER BY "year"
LIMIT 20;
```

```sql
-- Description: See how many times the query terms appear in WORD_FREQUENCIES to estimate rarity (weights in later vector calculations).
SELECT "word", "frequency"
