WITH
/*---------------------------------------------------------------
  1)  Lookup tables : corpus frequency  &  GloVe vectors
----------------------------------------------------------------*/
freq AS (          -- word  →  frequency
    SELECT  LOWER("word") AS word ,
            "frequency"   AS freq
    FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES"
),
vec  AS (          -- word  →  vector (VARIANT)
    SELECT  LOWER("word") AS word ,
            "vector"      AS vec
    FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"
),

/*---------------------------------------------------------------
  2)  Build weighted / normalised vector for the query phrase
----------------------------------------------------------------*/
query_tokens AS (
    SELECT  LOWER(tok.value::string) AS token
    FROM    TABLE(
              FLATTEN(
                  INPUT => SPLIT(
                              REGEXP_REPLACE(
                                  LOWER('Epigenetics and cerebral organoids: promising directions in autism spectrum disorders'),
                                  '[^a-z0-9]+',
                                  ' '
                              ),
                              ' '
                          )
              )
            ) tok
    WHERE token <> ''
),
query_dim_vals AS (
    SELECT  v.seq                                               AS dim ,
            SUM(  (v.value::float) /
                  POW( COALESCE(f.freq,1) , 0.4)               ) AS wval
    FROM        query_tokens  qt
    JOIN        vec           gv  ON gv.word = qt.token      -- need a vector
    LEFT JOIN   freq          f   ON f.word  = qt.token      -- freq (default 1)
    ,   LATERAL FLATTEN( INPUT => gv.vec )                    v
    GROUP BY    v.seq
),
query_norm AS (
    SELECT  SQRT( SUM( POWER(wval,2) ) )  AS q_norm
    FROM    query_dim_vals
),

/*---------------------------------------------------------------
  3)  Restrict to candidate articles that mention at least one
      relevant keyword, drastically reducing work.
----------------------------------------------------------------*/
candidate AS (
    SELECT  "id", "date", "title", "body"
    FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
    WHERE   "body" ILIKE '%epigenetic%'
        OR  "body" ILIKE '%organoid%'
        OR  "body" ILIKE '%autism%'
),

/*---------------------------------------------------------------
  4)  Tokenise the body of each candidate article
----------------------------------------------------------------*/
article_tokens AS (
    SELECT  c.id,
            c.date,
            c.title,
            LOWER(tok.value::string)          AS token
    FROM    candidate             c,
            LATERAL FLATTEN(
                INPUT => SPLIT(
                            REGEXP_REPLACE( LOWER(c.body), '[^a-z0-9]+', ' ' ),
                            ' '
                        )
            ) tok
    WHERE   tok.value::string <> ''
),

/*---------------------------------------------------------------
  5)  Count how many times each token appears per article
      (saves vector-flatten work later)
----------------------------------------------------------------*/
article_token_counts AS (
    SELECT  id,
            date,
            title,
            token,
            COUNT(*) AS tok_count
    FROM    article_tokens
    GROUP BY id, date, title, token
),

/*---------------------------------------------------------------
  6)  Build weighted summed vector (one row per article × dim)
----------------------------------------------------------------*/
article_dims AS (
    SELECT  atc.id,
            atc.date,
            atc.title,
            vv.seq                                            AS dim ,
            SUM( atc.tok_count
                 * (vv.value::float)
                 / POW( COALESCE(f.freq,1) , 0.4) )           AS wval
    FROM        article_token_counts   atc
    JOIN        vec                  gv   ON gv.word = atc.token
    LEFT JOIN   freq                 f    ON f.word  = atc.token
    ,   LATERAL FLATTEN( INPUT => gv.vec )                    vv
    GROUP BY    atc.id, atc.date, atc.title, vv.seq
),

/*---------------------------------------------------------------
  7)  Dot-product with query vector & article norm
----------------------------------------------------------------*/
article_scores AS (
    SELECT  ad.id,
            ad.date,
            ad.title,
            SUM( ad.wval * COALESCE(q.wval,0) )                    AS dot,
            SUM( POWER(ad.wval,2) )                                AS art_sq_sum
    FROM        article_dims      ad
    LEFT JOIN   query_dim_vals    q   ON q.dim = ad.dim
    GROUP BY    ad.id, ad.date, ad.title
),

/*---------------------------------------------------------------
  8)  Cosine similarity
----------------------------------------------------------------*/
similarities AS (
    SELECT  id,
            date,
            title,
            dot / ( SQRT(art_sq_sum) * (SELECT q_norm FROM query_norm) )   AS similarity
    FROM    article_scores
    WHERE   art_sq_sum > 0
        AND dot IS NOT NULL
)

/*---------------------------------------------------------------
  9)  Return top-10 most similar articles
----------------------------------------------------------------*/
SELECT  id,
        date,
        title,
        similarity
FROM    similarities
ORDER BY similarity DESC NULLS LAST
LIMIT 10;
