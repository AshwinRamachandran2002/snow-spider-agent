```sql
WITH
---------------------------------------------------------------------
-- 1)  Auxiliary lookup tables
---------------------------------------------------------------------
freq AS (   -- word → corpus frequency
    SELECT  LOWER("word")  AS word ,
            "frequency"    AS freq
    FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES"
),
vec  AS (   -- word → GloVe vector (array/variant)
    SELECT  LOWER("word")  AS word ,
            "vector"       AS vec
    FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"
),

---------------------------------------------------------------------
-- 2)  Build the weighted / normalised query-phrase vector
---------------------------------------------------------------------
query_tokens AS (
    SELECT  LOWER(REGEXP_REPLACE(tok.value::string,'[^a-z0-9]+','')) AS token
    FROM    TABLE(
                FLATTEN(
                    INPUT => REGEXP_SPLIT_TO_ARRAY(
                                LOWER('Epigenetics and cerebral organoids: promising directions in autism spectrum disorders'),
                                '\\W+'
                            )
                )
            ) tok
    WHERE   token <> ''
),
query_dim_vals AS (
    SELECT  v.seq                                   AS dim ,
            SUM( (v.value::float) /                      /* GloVe component  */
                 POW(f.freq , 0.4) )                AS wval     /* frequency weight  */
    FROM        query_tokens      qt
    JOIN        vec               gv   ON gv.word = qt.token
    JOIN        freq              f    ON f.word  = qt.token
    ,   LATERAL FLATTEN( INPUT => gv.vec )          v
    GROUP BY    v.seq
),
query_norm AS (
    SELECT  SQRT( SUM( POWER(wval,2) ) ) AS q_norm
    FROM    query_dim_vals
),

---------------------------------------------------------------------
-- 3)  Build weighted vectors for every article (token → vector → dims)
---------------------------------------------------------------------
article_dims AS (
    SELECT  n."id"              AS art_id ,
            n."date"            AS art_date ,
            n."title"           AS art_title ,
            vv.seq              AS dim ,
            SUM( (vv.value::float) / POW(f.freq,0.4) )  AS wval
    FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"   n
    ,   LATERAL FLATTEN(
            INPUT => REGEXP_SPLIT_TO_ARRAY( LOWER(n."body"), '\\W+')
        ) tok
    JOIN        vec     gv  ON gv.word = LOWER(REGEXP_REPLACE(tok.value::string,'[^a-z0-9]+',''))
    JOIN        freq    f   ON f.word  = gv.word
    ,   LATERAL FLATTEN( INPUT => gv.vec )                 vv
    GROUP BY    n."id", n."date", n."title", vv.seq
),

---------------------------------------------------------------------
-- 4)  Compute dot-product with query vector and each article’s norm
---------------------------------------------------------------------
article_scores AS (
    SELECT  a.art_id     AS id,
            a.art_date   AS date,
            a.art_title  AS title,
            SUM( a.wval * q.wval )                           AS dot,
            SUM( POWER(a.wval,2) )                           AS art_sq_sum
    FROM        article_dims      a
    LEFT JOIN   query_dim_vals    q   ON q.dim = a.dim
    GROUP BY    a.art_id, a.art_date, a.art_title
),
---------------------------------------------------------------------
-- 5)  Final cosine similarity and ranking
---------------------------------------------------------------------
similarities AS (
    SELECT  id,
            date,
            title,
            dot / ( SQRT(art_sq_sum) * (SELECT q_norm FROM query_norm) )  AS similarity
    FROM    article_scores
    WHERE   art_sq_sum > 0
            AND dot IS NOT NULL
)

---------------------------------------------------------------------
-- 6)  Return the 10 most similar articles
---------------------------------------------------------------------
SELECT  id,
        date,
        title,
        similarity
FROM    similarities
ORDER BY similarity DESC NULLS LAST
LIMIT 10;
```
