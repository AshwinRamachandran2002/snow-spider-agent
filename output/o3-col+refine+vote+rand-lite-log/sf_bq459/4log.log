LIMIT 20;
```

```sql
--Description: Show a sample of distinct author strings that contain “Smith”  
SELECT DISTINCT "authors"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE "authors" ILIKE '%smith%'
LIMIT 20;
```

```sql
--Description: Pull the 300-dimension GloVe embedding vector for the word “epigenetics”  
SELECT "word", "vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS
WHERE "word" = 'epigenetics'
LIMIT 20;
```

```sql
--Description: Join GloVe vectors with their corpus frequencies for several key query words  
SELECT gv."word",
       gv."vector",
       wf."frequency"
FROM WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
       ON gv."word" = wf."word"
WHERE gv."word" IN ('epigenetics','cerebral','organoids','autism')
LIMIT 20;
```

```sql
--Description: Count how many NATURE articles were published each calendar year  
SELECT TO_CHAR("date", 'YYYY') AS "year", COUNT(*) AS "article_count"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
GROUP BY TO_CHAR("date", 'YYYY')
ORDER BY "year" DESC
LIMIT 20;
```
