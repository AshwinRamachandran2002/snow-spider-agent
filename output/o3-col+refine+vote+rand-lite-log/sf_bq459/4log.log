```sql
WITH
/* ------------------------------------------------------------------ */
/*  A very small hard-coded stop-word list that will be removed        */
/* ------------------------------------------------------------------ */
stopwords(word) AS (
    SELECT column1 FROM VALUES
      ('the'),('and'),('of'),('to'),('in'),('a'),('is'),('it'),('for'),('on'),
      ('that'),('with'),('as'),('are'),('this'),('be'),('or'),('by'),('an'),
      ('from'),('at'),('was'),('which'),('but'),('have'),('has'),('had'),
      ('were'),('been'),('their'),('its'),('not'),('than'),('they'),('we'),
      ('our'),('can'),('may'),('will'),('would'),('should'),('could'),('into'),
      ('these'),('those'),('such'),('during'),('between'),('per'),('using'),
      ('use')
),

/* ------------------------------------------------------------------ */
/*  Build the weighted, unit-length vector for the query phrase       */
/* ------------------------------------------------------------------ */
query_tokens AS (
    SELECT LOWER(TRIM(tok.value))         AS token
    FROM LATERAL SPLIT_TO_TABLE(
           REGEXP_REPLACE(
               'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
               '[^A-Za-z]+',' '),           /* non letters -> space          */
           ' '                               /* split on space                */
         ) tok
    LEFT JOIN stopwords s
           ON LOWER(TRIM(tok.value)) = s.word
    WHERE tok.value IS NOT NULL
      AND tok.value <> ''
      AND s.word IS NULL
),
query_word_vecs AS (
    SELECT gv.vector,
           COALESCE(wf.frequency,1) AS freq
    FROM query_tokens qt
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS  gv ON gv.word = qt.token
    LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf ON wf.word = qt.token
),
query_dim_vals AS (
    SELECT f.index                                                  AS dim ,
           (f.value::FLOAT) / POWER(qw.freq , 0.4)                  AS w_val
    FROM   query_word_vecs  qw ,
           LATERAL FLATTEN(input => qw.vector) f
),
query_sum AS (
    SELECT dim ,
           SUM(w_val)                                               AS sum_val
    FROM   query_dim_vals
    GROUP  BY dim
),
query_norm AS (
    SELECT SQRT(SUM(sum_val*sum_val))                               AS norm
    FROM   query_sum
),
query_unit AS (
    SELECT dim ,
           sum_val / qn.norm                                        AS unit_val
    FROM   query_sum
    CROSS JOIN query_norm qn
),

/* ------------------------------------------------------------------ */
/*  Build a weighted, unit-length vector for every Nature article     */
/* ------------------------------------------------------------------ */
article_tokens AS (
    SELECT n.id ,
           n.date ,
           n.title ,
           LOWER(TRIM(tok.value))                                   AS token
    FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n ,
           LATERAL SPLIT_TO_TABLE(
               REGEXP_REPLACE(n.body,'[^A-Za-z]+',' '),' ') tok
    LEFT  JOIN stopwords s
           ON LOWER(TRIM(tok.value)) = s.word
    WHERE  tok.value IS NOT NULL
      AND  tok.value <> ''
      AND  s.word IS NULL
),
article_word_vecs AS (
    SELECT at.id ,
           at.date ,
           at.title ,
           gv.vector ,
           COALESCE(wf.frequency,1)                                 AS freq
    FROM   article_tokens at
    JOIN   WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS  gv ON gv.word = at.token
    LEFT  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf ON wf.word = at.token
),
article_dim_vals AS (
    SELECT awv.id ,
           awv.date ,
           awv.title ,
           f.index                                                  AS dim ,
           (f.value::FLOAT) / POWER(awv.freq , 0.4)                 AS w_val
    FROM   article_word_vecs awv ,
           LATERAL FLATTEN(input => awv.vector) f
),
article_sum AS (
    SELECT id ,
           date ,
           title ,
           dim ,
           SUM(w_val)                                               AS sum_val
    FROM   article_dim_vals
    GROUP  BY id , date , title , dim
),
article_norm AS (
    SELECT id ,
           date ,
           title ,
           SQRT(SUM(sum_val*sum_val))                               AS norm
    FROM   article_sum
    GROUP  BY id , date , title
    HAVING SQRT(SUM(sum_val*sum_val)) > 0
),
article_unit AS (
    SELECT asu.id ,
           asu.date ,
           asu.title ,
           asu.dim ,
           asu.sum_val / an.norm                                    AS unit_val
    FROM   article_sum asu
    JOIN   article_norm an  ON an.id = asu.id
),

/* ------------------------------------------------------------------ */
/*  Cosine similarity between query vector and each article vector    */
/* ------------------------------------------------------------------ */
similarities AS (
    SELECT au.id ,
           au.date ,
           au.title ,
           SUM(au.unit_val * qu.unit_val)                           AS cosine_similarity
    FROM   article_unit au
    JOIN   query_unit   qu  ON qu.dim = au.dim
    GROUP  BY au.id , au.date , au.title
)

/* ------------------------------------------------------------------ */
/*  Return the 10 most similar articles                              */
/* ------------------------------------------------------------------ */
SELECT id ,
       date ,
       title ,
       cosine_similarity
FROM   similarities
ORDER  BY cosine_similarity DESC NULLS LAST
LIMIT 10;
```
