```

```sql
--Description: Look for articles mentioning “autism” somewhere in the body text  
SELECT "id", "date", "title"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE "body" ILIKE '%autism%'
LIMIT 20;
```

```sql
--Description: Search bodies that jointly mention “cerebral” and “organoid” (in that order, allowing anything in-between)  
SELECT "id", "date", "title"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE "body" ILIKE '%cerebral%organoid%'
LIMIT 20;
```

```sql
--Description: Retrieve the stored corpus frequency of the word “epigenetics”  
SELECT "word", "frequency"
FROM WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES
