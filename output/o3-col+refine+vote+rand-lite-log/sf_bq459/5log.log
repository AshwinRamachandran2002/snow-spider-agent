```sql
WITH -----------------------------------------------------------
-- 1)  basic stop-word list
---------------------------------------------------------------
stop_words AS (
    SELECT COLUMN1 AS word
    FROM VALUES
        ('a'),('an'),('and'),('are'),('as'),('at'),
        ('be'),('by'),('for'),('from'),('in'),('is'),('it'),
        ('of'),('on'),('or'),('that'),('the'),('their'),
        ('these'),('those'),('this'),('to'),('with'),('we')
),
----------------------------------------------------------------
-- 2)  tokenise every Nature article and keep only words that
--     have both a GloVe vector and a frequency value
----------------------------------------------------------------
article_tokens AS (
    SELECT  n.id,
            n.date,
            n.title,
            tok.value::string          AS token
    FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
            LATERAL FLATTEN(
                    INPUT =>
                        SPLIT(
                            REGEXP_REPLACE(LOWER(n.body),'[^a-z]+',' '),
                            ' ')
                  ) tok
    WHERE   tok.value IS NOT NULL
      AND   tok.value <> ''
      AND   tok.value NOT IN (SELECT word FROM stop_words)
),
----------------------------------------------------------------
-- 3)  add word vectors, frequencies and compute the
--     frequency-based weight = 1 / frequency^0.4
----------------------------------------------------------------
article_word_vecs AS (
    SELECT  a.id,
            a.date,
            a.title,
            gv.vector           AS vec,
            POWER(wf.frequency , -0.4) AS weight
    FROM    article_tokens             a
    JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"    gv
           ON gv.word = a.token
    JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
           ON wf.word = a.token
),
----------------------------------------------------------------
-- 4)  flatten every vector to (index , value) pairs, apply the
--     weight and sum all weighted values per coordinate
----------------------------------------------------------------
article_coords AS (
    SELECT  aw.id,
            aw.date,
            aw.title,
            vecitem.index                       AS idx,
            SUM( vecitem.value::float * aw.weight ) AS coord
    FROM    article_word_vecs aw,
            LATERAL FLATTEN( INPUT => aw.vec ) vecitem
    GROUP BY aw.id, aw.date, aw.title, vecitem.index
),
----------------------------------------------------------------
-- 5)  compute vector norms and the final unit-length coordinates
----------------------------------------------------------------
article_norm AS (
    SELECT  id,
            SQRT(SUM(coord*coord)) AS norm
    FROM    article_coords
    GROUP BY id
    HAVING  norm > 0
),
article_unit AS (
    SELECT  c.id,
            c.idx,
            c.coord / n.norm       AS coord
    FROM    article_coords c
    JOIN    article_norm   n USING(id)
),
----------------------------------------------------------------
-- 6)  build the QUERY vector in exactly the same way
----------------------------------------------------------------
query_tokens AS (
    SELECT  tok.value::string AS token
    FROM    LATERAL FLATTEN(
                INPUT =>
                    SPLIT(
                        REGEXP_REPLACE(
                            LOWER('Epigenetics and cerebral organoids: promising directions in autism spectrum disorders'),
                            '[^a-z]+',' '),
                        ' ')
            ) tok
    WHERE   tok.value IS NOT NULL
      AND   tok.value <> ''
      AND   tok.value NOT IN (SELECT word FROM stop_words)
),
query_word_vecs AS (
    SELECT  gv.vector                         AS vec,
            POWER(wf.frequency , -0.4)        AS weight
    FROM    query_tokens qt
    JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"    gv
           ON gv.word = qt.token
    JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
           ON wf.word = qt.token
),
query_coords AS (
    SELECT  vecitem.index                                 AS idx,
            SUM( vecitem.value::float * qw.weight )       AS coord
    FROM    query_word_vecs qw,
            LATERAL FLATTEN( INPUT => qw.vec ) vecitem
    GROUP BY vecitem.index
),
query_norm AS (
    SELECT  SQRT( SUM(coord*coord) ) AS norm
    FROM    query_coords
),
query_unit AS (
    SELECT  idx,
            coord / (SELECT norm FROM query_norm) AS coord
    FROM    query_coords
),
----------------------------------------------------------------
-- 7)  cosine similarity = dot product (vectors are unit length)
----------------------------------------------------------------
similarity AS (
    SELECT  au.id,
            SUM( au.coord * qu.coord ) AS score
    FROM    article_unit au
    JOIN    query_unit   qu USING(idx)
    GROUP BY au.id
)
----------------------------------------------------------------
-- 8)  pick top-10 most similar articles
----------------------------------------------------------------
SELECT  n.id,
        n.date,
        n.title,
        s.score   AS cosine_similarity
FROM    similarity                                     s
JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n
       ON n.id = s.id
ORDER BY s.score DESC NULLS LAST
LIMIT 10;
```
