            SQRT( SUM(coord*coord) ) AS norm
    FROM    article_coords
    GROUP BY "id"
    HAVING  norm > 0
),
article_unit AS (
    SELECT  ac."id",
            ac.idx,
            ac.coord / an.norm AS coord
    FROM    article_coords ac
    JOIN    article_norm   an
           ON ac."id" = an."id"
),
