WITH -----------------------------------------------------------
-- 1)  stop-word list
---------------------------------------------------------------
stop_words AS (
    SELECT COLUMN1 AS word
    FROM VALUES
        ('a'),('an'),('and'),('are'),('as'),('at'),
        ('be'),('by'),('for'),('from'),('in'),('is'),('it'),
        ('of'),('on'),('or'),('that'),('the'),('their'),
        ('these'),('those'),('this'),('to'),('with'),('we')
),
----------------------------------------------------------------
-- 2)  tokenize each article body (lower-case, strip non-letters);
--     keep tokens that are not stop-words and that have both
--     a GloVe vector and a frequency entry
----------------------------------------------------------------
article_tokens AS (
    SELECT  n."id",
            tok.value::string AS token
    FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
            LATERAL FLATTEN(
                    INPUT => SPLIT(
                                REGEXP_REPLACE( LOWER(n."body"), '[^a-z]+', ' '),
                                ' ')
                  ) tok
    WHERE   tok.value IS NOT NULL
        AND tok.value <> ''
        AND tok.value NOT IN (SELECT word FROM stop_words)
),
----------------------------------------------------------------
-- 3)  attach vectors and frequencies, compute weight = f^-0.4
----------------------------------------------------------------
article_word_vecs AS (
    SELECT  at."id",
            gv."vector"                       AS vec,
            POWER(wf."frequency", -0.4)       AS weight
    FROM    article_tokens                             at
    JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"    gv
           ON gv."word" = at.token
    JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
           ON wf."word" = at.token
),
----------------------------------------------------------------
-- 4)  explode vectors, weight them and sum per coordinate
----------------------------------------------------------------
article_coords AS (
    SELECT  aw."id",
            vec_item.index                   AS idx,
            SUM( vec_item.value::float * aw.weight ) AS coord
    FROM    article_word_vecs aw,
            LATERAL FLATTEN( INPUT => aw.vec ) vec_item
    GROUP BY aw."id", vec_item.index
),
----------------------------------------------------------------
-- 5)  normalise article vectors to unit length
----------------------------------------------------------------
article_norm AS (
