```sql
-- 4) Inspect only the “value” parameter (the score) inside event_params
SELECT  ep.value.int_value AS score
FROM    `firebase-public-project.analytics_153293282.events_20180915`,
        UNNEST(`event_params`) AS ep
WHERE   `event_name` = 'level_complete_quickplay'
  AND   ep.key        = 'value'
LIMIT 20;
```

```sql
-- 5) Check that every completion really contains both “board” and “value”
SELECT  COUNT(*) AS total_rows,
        SUM(IF(board IS NOT NULL AND score IS NOT NULL,1,0)) AS rows_with_both
FROM (
      SELECT  event_timestamp,
              MAX(CASE WHEN ep.key = 'board'  THEN ep.value.string_value END) AS board,
              MAX(CASE WHEN ep.key = 'value'  THEN ep.value.int_value    END) AS score
      FROM    `firebase-public-project.analytics_153293282.events_20180915`,
              UNNEST(event_params) AS ep
      WHERE   event_name = 'level_complete_quickplay'
      GROUP BY event_timestamp
)
LIMIT 20;
```

```sql
-- 6) Quick list of every board / score pair seen (first 20 rows)
SELECT  MAX(CASE WHEN ep.key='board' THEN ep.value.string_value END) AS board,
        MAX(CASE WHEN ep.key='value' THEN ep.value.int_value    END) AS score
FROM    `firebase-public-project.analytics_153293282.events_20180915`,
        UNNEST(event_params) AS ep
WHERE   event_name = 'level_complete_quickplay'
GROUP BY event_timestamp
LIMIT 20;
```

```sql
-- 7) Distribution of scores for each board (first 20 rows)
SELECT  board,
        score,
        COUNT(*) AS times_scored
FROM (
      SELECT  MAX(CASE WHEN ep.key='board' THEN ep.value.string_value END) AS board,
              MAX(CASE WHEN ep.key='value' THEN ep.value.int_value    END) AS score
      FROM    `firebase-public-project.analytics_153293282.events_20180915`,
              UNNEST(event_params) AS ep
      WHERE   event_name = 'level_complete_quickplay'
      GROUP BY event_timestamp
)
GROUP BY board, score
ORDER BY board, score
LIMIT 20;
```

```sql
-- 8) FINAL ANSWER – average score per board type on 15-Sep-2018
SELECT  board,
        AVG(score) AS avg_score
FROM (
      SELECT  MAX(CASE WHEN ep.key='board' THEN ep.value.string_value END) AS board,
              MAX(CASE WHEN ep.key='value' THEN ep.value.int_value    END) AS score
      FROM    `firebase-public-project.analytics_153293282.events_20180915`,
              UNNEST(event_params) AS ep
      WHERE   event_name = 'level_complete_quickplay'
      GROUP BY event_timestamp
)
GROUP BY board
ORDER BY avg_score DESC;
```
