2025-05-05 04:21:16 - Thread-2969 (execute) - INFO - [Exploration]
Below are ten exploratory-to-final BigQuery SQL statements that progressively inspect the September-15-2018 event table and finally return the average quick-play score per board type.

```sql
--Description: 1) Peek at the raw rows on 15-Sep-2018 to understand the data.
SELECT *
FROM `firebase-public-project.analytics_153293282.events_20180915`
LIMIT 20;
```

```sql
--Description: 2) List the different event names that occurred that day.
SELECT DISTINCT event_name
FROM `firebase-public-project.analytics_153293282.events_20180915`
ORDER BY event_name
LIMIT 20;
```

```sql
--Description: 3) Focus on events whose name contains “quickplay”.
SELECT DISTINCT event_name
FROM `firebase-public-project.analytics_153293282.events_20180915`
WHERE LOWER(event_name) LIKE '%quickplay%'
ORDER BY event_name
LIMIT 20;
```

```sql
--Description: 4) Sample the event_params structure for one quick-play completion event.
SELECT event_params
FROM `firebase-public-project.analytics_153293282.events_20180915`
WHERE event_name = 'level_complete_quickplay'
LIMIT 20;
```

```sql
--Description: 5) Unnest event_params for quick-play completions to inspect available keys.
SELECT DISTINCT ep.key
FROM `firebase-public-project.analytics_153293282.events_20180915`,
UNNEST(event_params) AS ep
WHERE event_name = 'level_complete_quickplay'
ORDER BY ep.key
LIMIT 20;
```

```sql
--Description: 6) Grab “board” and “value” parameters side-by-side for a quick sanity check.
SELECT
  user_pseudo_id,
  ep_board.value.string_value  AS board_type,
  ep_value.value.int_value     AS score
FROM `firebase-public-project.analytics_153293282.events_20180915`,
UNNEST(event_params) AS ep_board
JOIN UNNEST(event_params) AS ep_value
WHERE event_name = 'level_complete_quickplay'
  AND ep_board.key = 'board'
  AND ep_value.key = 'value'
LIMIT 20;
```

```sql
--Description: 7) Make sure scores are not null and look reasonable.
SELECT DISTINCT score
FROM (
  SELECT ep_value.value.int_value AS score
  FROM `firebase-public-project.analytics_153293282.events_20180915`,
  UNNEST(event_params) AS ep_value
  WHERE event_name = 'level_complete_quickplay'
    AND ep_value.key = 'value'
)
ORDER BY score
LIMIT 20;
```

```sql
--Description: 8) Count completions per board to verify sample sizes.
SELECT
  board_type,
  COUNT(*) AS completions
FROM (
  SELECT
    ep_board.value.string_value AS board_type
  FROM `firebase-public-project.analytics_153293282.events_20180915`,
  UNNEST(event_params) AS ep_board
  WHERE event_name = 'level_complete_quickplay'
    AND ep_board.key = 'board'
)
GROUP BY board_type
ORDER BY completions DESC
LIMIT 20;
```

```sql
--Description: 9) Join board & score, then compute the average score per board.
SELECT
  board_type,
  AVG(score) AS avg_score
FROM (
  SELECT
    ep_board.value.string_value AS board_type,
    ep_value.value.int_value    AS score
  FROM `firebase-public-project.analytics_153293282.events_20180915`,
  UNNEST(event_params) AS ep_board
  JOIN UNNEST(event_params) AS ep_value
  WHERE event_name = 'level_complete_quickplay'
    AND ep_board.key = 'board'
    AND ep_value.key = 'value'
    AND ep_value.value.int_value IS NOT NULL
)
GROUP BY board_type
ORDER BY avg_score DESC;
```

```sql
--Description: 10) Same as #9 but rounded and including completion counts
--               (final answer query).
SELECT
  board_type,
  COUNT(*)                          AS completions,
  ROUND(AVG(score), 2)              AS average_score
FROM (
  SELECT
    ep_board.value.string_value AS board_type,
    ep_value.value.int_value    AS score
  FROM `firebase-public-project.analytics_153293282.events_20180915`,
  UNNEST(event_params) AS ep_board
  JOIN UNNEST(event_params) AS ep_value
  WHERE event_name = 'level_complete_quickplay'
    AND ep_board.key = 'board'
    AND ep_value.key = 'value'
    AND ep_value.value.int_value IS NOT NULL
)
GROUP BY board_type
ORDER BY average_score DESC;
```
