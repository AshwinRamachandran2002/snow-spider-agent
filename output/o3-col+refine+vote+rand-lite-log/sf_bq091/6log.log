```sql
--Description: Count the number of distinct A61-classified patent applications
--             filed each year by every assignee (top 20 rows by volume).
SELECT
    a.value:"name"::STRING                    AS "assignee_name",
    SUBSTRING(TO_CHAR(t."filing_date"), 1, 4) AS "filing_year",
    COUNT(DISTINCT t."application_number")    AS "apps_in_year"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc")                 c,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%'              -- keep only A61 CPC codes
GROUP BY a.value:"name"::STRING,
         SUBSTRING(TO_CHAR(t."filing_date"), 1, 4)
ORDER BY "apps_in_year" DESC
LIMIT 20;
```

```sql
--Description: Determine the peak-filing year for the assignee that holds the
--             largest number of A61-classified applications.
WITH a61_apps AS (
    SELECT
        a.value:"name"::STRING            AS assignee_name,
        t."application_number",
        SUBSTRING(TO_CHAR(t."filing_date"), 1, 4) AS filing_year
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc")                 c,
         LATERAL FLATTEN(input => t."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%'
),
top_assignee AS (                                    -- pick the single top assignee
    SELECT assignee_name
    FROM a61_apps
    GROUP BY assignee_name
    ORDER BY COUNT(DISTINCT application_number) DESC
    LIMIT 1
)
SELECT
    aa.filing_year,
    COUNT(DISTINCT aa.application_number) AS apps_in_year
FROM a61_apps aa
JOIN top_assignee ta
  ON aa.assignee_name = ta.assignee_name
GROUP BY aa.filing_year
ORDER BY apps_in_year DESC, aa.filing_year
LIMIT 20;
```

```sql
--Description: List distinct application & publication numbers for the top
--             assignee in A61 during its peak-filing year
WITH a61_apps AS (
    SELECT
        a.value:"name"::STRING            AS assignee_name,
        t."application_number",
        t."publication_number",
        SUBSTRING(TO_CHAR(t."filing_date"), 1, 4) AS filing_year
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc")                 c,
         LATERAL FLATTEN(input => t."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%'
),
top_assignee AS (
    SELECT assignee_name
    FROM a61_apps
    GROUP BY assignee_name
    ORDER BY COUNT(DISTINCT application_number) DESC
    LIMIT 1
),
peak_year AS (            -- find the year with the most filings for the top assignee
    SELECT filing_year
    FROM a61_apps
    WHERE assignee_name = (SELECT assignee_name FROM top_assignee)
    GROUP BY filing_year
    ORDER BY COUNT(DISTINCT application_number) DESC
    LIMIT 1
)
SELECT DISTINCT
    application_number,
    publication_number,
    filing_year
FROM a61_apps
WHERE assignee_name = (SELECT assignee_name FROM top_assignee)
  AND filing_year   = (SELECT filing_year   FROM peak_year)
LIMIT 20;
```

