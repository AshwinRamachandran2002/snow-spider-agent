```sql
--Description:  Find the single year in which the assignee that owns the MOST
--              A61-classified patent applications filed the largest number of
--              those applications.
--              Logic:
--              1.  In sub-query a61_apps we flatten CPC and assignee arrays so
--                  each row links one CPC code with one assignee for one
--                  publication; we keep only CPC codes beginning with ‘A61’.
--              2.  We select the assignee having the greatest number of DISTINCT
--                  applications overall (top_assignee).
--              3.  For that assignee we count DISTINCT applications per
--                  filing year and order by that count; the first row
--                  represents the peak year.
WITH a61_apps AS (
    SELECT
        a.value:"name"::STRING                    AS assignee_name,
        t."application_number"                   AS app_num,
        SUBSTRING(TO_CHAR(t."filing_date"), 1, 4) AS filing_year
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc")                 c,
         LATERAL FLATTEN(input => t."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%'              -- keep only A61 CPC codes
),
top_assignee AS (
    SELECT assignee_name
    FROM a61_apps
    GROUP BY assignee_name
    ORDER BY COUNT(DISTINCT app_num) DESC
    LIMIT 1
)
SELECT
    filing_year,
    COUNT(DISTINCT app_num) AS apps_in_year
FROM a61_apps
WHERE assignee_name = (SELECT assignee_name FROM top_assignee)
GROUP BY filing_year
ORDER BY apps_in_year DESC, filing_year
LIMIT 20;
```
