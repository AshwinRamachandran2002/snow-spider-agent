```sql
--Description:  We need the single year in which the assignee that files the MOST A61-class
--              patent applications filed the HIGHEST number of them.
--              1)  First, “PROCTER & GAMBLE” was already identified as that top assignee.
--              2)  A fuzzy ILIKE '%PROCTER%GAMBLE%' is used to catch spelling/format variants.
--              3)  Each publication record can hold multiple CPC codes and multiple assignees,
--                 so we FLATTEN both arrays.
--              4)  We keep rows whose CPC code begins with ‘A61’.
--              5)  The numeric filing_date (YYYYMMDD) is cast to text and the first 4 chars
--                 give the filing year.
--              6)  We count DISTINCT application_number per year and order descending; the
--                 first row is the desired peak-filing year.
SELECT
    SUBSTRING(TO_CHAR(t."filing_date"), 1, 4)      AS "filing_year",
    COUNT(DISTINCT t."application_number")         AS "a61_applications"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc")              c,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%'               -- restrict to A61 CPC group
  AND a.value:"name"::STRING ILIKE '%PROCTER%GAMBLE%'   -- focus on top assignee
GROUP BY SUBSTRING(TO_CHAR(t."filing_date"), 1, 4)
ORDER BY "a61_applications" DESC
LIMIT 20;
