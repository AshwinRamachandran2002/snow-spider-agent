LIMIT 20;
```

```sql
--Description: 2) Look at CPC codes that start with “A61” together with filing date and an assignee (un-nest both CPC and assignee arrays)
SELECT 
    t."publication_number",
    c.value:"code"::STRING                    AS "cpc_code",
    a.value:"name"::STRING                    AS "assignee_name",
    t."filing_date"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc")      c,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%'
LIMIT 20;
```

```sql
--Description: 3) Pull distinct assignees that have at least one publication with CPC “A61…”
SELECT DISTINCT 
    a.value:"name"::STRING AS "assignee_name"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc")      c,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%'
LIMIT 20;
```

```sql
--Description: 4) Count how many publications (proxy for applications) each assignee has in CPC “A61…”
SELECT 
    a.value:"name"::STRING AS "assignee_name",
    COUNT(*)               AS "a61_pub_count"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc")      c,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%'
GROUP BY a.value:"name"::STRING
ORDER BY "a61_pub_count" DESC
LIMIT 20;
```

```sql
--Description: 5) Retrieve ONLY the assignee that has the most A61-category publications (top-1)
SELECT 
    a.value:"name"::STRING AS "top_assignee",
    COUNT(*)               AS "a61_pub_count"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc")      c,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%'
GROUP BY a.value:"name"::STRING
ORDER BY "a61_pub_count" DESC
LIMIT 1;
```

```sql
--Description: 6) For that single top assignee (returned by previous query) show its publications, year extracted from filing_date, to double-check data
WITH top_assignee AS (
    SELECT 
        a.value:"name"::STRING AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc")      c,
         LATERAL FLATTEN(input => t."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%'
    GROUP BY a.value:"name"::STRING
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT 
    p."publication_number",
    a.value:"name"::STRING                              AS "assignee_name",
    FLOOR(p."filing_date"/10000)                        AS "filing_year"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc")                 c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a,
     top_assignee ta
WHERE c.value:"code"::STRING ILIKE 'A61%'
  AND a.value:"name"::STRING = ta."assignee_name"
LIMIT 20;
```

```sql
--Description: 7) Aggregate, for the top assignee, the count of A61 publications per filing year
WITH top_assignee AS (
    SELECT 
        a.value:"name"::STRING AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc")      c,
         LATERAL FLATTEN(input => t."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%'
    GROUP BY a.value:"name"::STRING
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT 
    FLOOR(p."filing_date"/10000) AS "filing_year",
    COUNT(*)                    AS "a61_pub_count"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc")                 c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a,
     top_assignee ta
WHERE c.value:"code"::STRING ILIKE 'A61%'
  AND a.value:"name"::STRING = ta."assignee_name"
GROUP BY FLOOR(p."filing_date"/10000)
ORDER BY "a61_pub_count" DESC
LIMIT 20;
```

```sql
--Description: 8) Same as previous but keeping only the single year with the highest count
WITH top_assignee AS (
    SELECT 
        a.value:"name"::STRING AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc")      c,
         LATERAL FLATTEN(input => t."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%'
    GROUP BY a.value:"name"::STRING
    ORDER BY COUNT(*) DESC
    LIMIT 1
),
year_counts AS (
    SELECT 
        FLOOR(p."filing_date"/10000) AS "filing_year",
        COUNT(*)                    AS "a61_pub_count"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")                 c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a,
         top_assignee ta
    WHERE c.value:"code"::STRING ILIKE 'A61%'
      AND a.value:"name"::STRING = ta."assignee_name"
    GROUP BY FLOOR(p."filing_date"/10000)
)
SELECT *
FROM year_counts
ORDER BY "a61_pub_count" DESC
LIMIT 1;
```

```sql
--Description: 9) (Optional) Display the assignee, the max-filing-year, and the corresponding count together in one shot
WITH ranked AS (
    SELECT 
        a.value:"name"::STRING                      AS "assignee_name",
        FLOOR(p."filing_date"/10000)               AS "filing_year",
        COUNT(*)                                   AS "a61_pub_count",
        RANK() OVER (PARTITION BY a.value:"name"::STRING
                     ORDER BY COUNT(*) DESC)       AS "year_rank"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")        c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%'
    GROUP BY a.value:"name"::STRING,
             FLOOR(p."filing_date"/10000)
),
assignee_totals AS (
    SELECT 
        "assignee_name",
        SUM("a61_pub_count") AS "total_a61"
    FROM ranked
    GROUP BY "assignee_name"
    ORDER BY "total_a61" DESC
    LIMIT 1
)
SELECT 
    at."assignee_name",
    r."filing_year",
    r."a61_pub_count"
FROM assignee_totals at
JOIN ranked r
  ON r."assignee_name" = at."assignee_name"
WHERE r."year_rank" = 1
ORDER BY r."a61_pub_count" DESC
LIMIT 1;
```
