  f.value:"code"::STRING AS "cpc_code"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE f.value:"code"::STRING ILIKE 'A61%'
LIMIT 20;
```

```sql
--Description: Count how many A61-category applications each assignee has
SELECT 
  a.value:"name"::STRING AS "assignee_name",
  COUNT(*) AS "num_applications"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE f.value:"code"::STRING ILIKE 'A61%'
GROUP BY a.value:"name"::STRING
ORDER BY "num_applications" DESC
LIMIT 20;
```

```sql
--Description: Check the filing-year distribution for the assignee that (visually from the previous query) has the most A61 applications
SELECT 
  TO_CHAR(p."filing_date") AS "filing_date_raw",
  FLOOR(p."filing_date"/10000) AS "filing_year",
  COUNT(*) AS "applications_in_year"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE f.value:"code"::STRING ILIKE 'A61%'
  AND a.value:"name"::STRING = '<TOP_ASSIGNEE_NAME_FROM_PREVIOUS_QUERY>'   -- replace after seeing results
GROUP BY FLOOR(p."filing_date"/10000), TO_CHAR(p."filing_date")
ORDER BY "applications_in_year" DESC
LIMIT 20;
```

```sql
