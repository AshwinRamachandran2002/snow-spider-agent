Query:
--Description: Determine the filing year with the highest number of A61-category applications
--             for the assignee that has the overall largest volume of such applications.
--             • “cte”   – explode CPC codes to keep rows whose symbol starts with “A61”;
--                          explode assignee_harmonized with OUTER=>TRUE so rows without a
--                          harmonised entry are retained; calculate filing_year.
--             • “top_assignee” – pick the assignee with the greatest total A61 count.
--             • Final SELECT   – aggregate that assignee’s applications by filing_year and
--                                order by the yearly totals (peak year first).
WITH cte AS (
    SELECT
        p."filing_date",
        FLOOR(p."filing_date" / 10000)           AS "filing_year",
        COALESCE(ah.value:"name"::STRING,        -- prefer harmonised name
                 p."assignee"::STRING)           AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")                         c,   -- explode CPC
         LATERAL FLATTEN(input => p."assignee_harmonized",
                         outer => TRUE)                            ah   -- explode assignees (keep nulls)
    WHERE c.value:"code"::STRING ILIKE 'A61%'   -- restrict to A61 class
      AND p."filing_date" > 0                   -- need a valid date
),
top_assignee AS (                                -- overall largest A61 filer
    SELECT "assignee_name"
    FROM cte
    GROUP BY "assignee_name"
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT
    cte."filing_year",
    COUNT(*) AS "num_applications"
FROM cte
JOIN top_assignee ta
  ON cte."assignee_name" = ta."assignee_name"
GROUP BY cte."filing_year"
ORDER BY "num_applications" DESC
LIMIT 20
