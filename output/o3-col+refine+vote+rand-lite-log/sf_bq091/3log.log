```sql
--Description: Count how many A61-category publications each assignee has.  
--             • “cpc” is flattened to keep rows whose CPC symbol starts with “A61”.  
--             • “assignee_harmonized” is flattened with OUTER=>TRUE so rows lacking a
--               harmonized entry are still kept; the original “assignee” text is a fallback.  
--             • The COALESCE result is grouped and sorted to show the assignees with the
--               largest number of A61 filings.
SELECT
    COALESCE(
        ah.value:"name"::STRING,   -- harmonized assignee name (if present)
        p."assignee"::STRING       -- fallback: raw assignee field
    )                 AS "assignee_mixed",
    COUNT(*)          AS "num_applications"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc")                         c,   -- explode CPC codes
     LATERAL FLATTEN(input => p."assignee_harmonized",
                     outer => TRUE)                            ah   -- explode assignees, keep rows without one
WHERE c.value:"code"::STRING ILIKE 'A61%'                           -- restrict to A61 class
GROUP BY COALESCE(ah.value:"name"::STRING, p."assignee"::STRING)
ORDER BY "num_applications" DESC
LIMIT 20;
```
