```sql
--Description: List A61-category publications for the assignee with the most A61 filings,
--             restricted to the single year in which that same assignee filed the most.
WITH a61_pub AS (   -- all A61 applications with filing date + assignee
    SELECT
        p."publication_number",
        p."filing_date",
        p."kind_code",
        a.value:"name"::STRING AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")              f,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE f.value:"code"::STRING ILIKE 'A61%'
      AND p."filing_date" > 0
), top_assignee AS (          -- who files the most A61 apps?
    SELECT "assignee_name"
    FROM a61_pub
    GROUP BY "assignee_name"
    ORDER BY COUNT(*) DESC
    LIMIT 1
), peak_year AS (             -- in which year did that assignee file the most?
    SELECT FLOOR("filing_date"/10000) AS "filing_year"
    FROM a61_pub ap
    JOIN top_assignee ta
      ON ap."assignee_name" = ta."assignee_name"
    GROUP BY FLOOR("filing_date"/10000)
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT
    ap."publication_number",
    ap."filing_date",
    ap."kind_code"
FROM a61_pub ap
JOIN top_assignee ta ON ap."assignee_name" = ta."assignee_name"
JOIN peak_year    py ON FLOOR(ap."filing_date"/10000) = py."filing_year"
LIMIT 20;
```

```sql
--Description: Verify duplicates for that assignee in its peak year (distinct vs total rows).
WITH a61_pub AS (
    SELECT
        p."publication_number",
        p."filing_date",
        a.value:"name"::STRING AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")              f,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE f.value:"code"::STRING ILIKE 'A61%'
      AND p."filing_date" > 0
), top_assignee AS (
    SELECT "assignee_name"
    FROM a61_pub
    GROUP BY "assignee_name"
    ORDER BY COUNT(*) DESC
    LIMIT 1
), peak_year AS (
    SELECT FLOOR("filing_date"/10000) AS "filing_year"
    FROM a61_pub ap
    JOIN top_assignee ta ON ap."assignee_name" = ta."assignee_name"
    GROUP BY FLOOR("filing_date"/10000)
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT
    COUNT(DISTINCT ap."publication_number") AS "distinct_pubs",
    COUNT(*)                                AS "raw_rows"
FROM a61_pub ap
JOIN top_assignee ta ON ap."assignee_name" = ta."assignee_name"
JOIN peak_year    py ON FLOOR(ap."filing_date"/10000) = py."filing_year";
```

```sql
--Description: Show the family-level breakdown of A61 filings for the top assignee (all years).
WITH a61_pub AS (
    SELECT
        p."family_id",
        a.value:"name"::STRING AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")              f,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE f.value:"code"::STRING ILIKE 'A61%'
)
, top_assignee AS (
    SELECT "assignee_name"
    FROM a61_pub
    GROUP BY "assignee_name"
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT
    p."family_id",
    COUNT(DISTINCT p."publication_number") AS "pubs_in_family"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc")              f,
     LATERAL FLATTEN(input => p."assignee_harmonized") a,
     top_assignee ta
WHERE f.value:"code"::STRING ILIKE 'A61%'
  AND a.value:"name"::STRING = ta."assignee_name"
GROUP BY p."family_id"
ORDER BY "pubs_in_family" DESC
LIMIT 20;
```

```sql
--Description: Count A61 applications per (harmonized OR original) assignee to see
--             how many filings each entity has, using the original name when the
--             harmonized list is empty.
SELECT
    COALESCE(a.value:"name"::STRING, p."assignee"::STRING) AS "assignee_mixed",
    COUNT(*)                                              AS "num_applications"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f
     LEFT JOIN LATERAL FLATTEN(input => p."assignee_harmonized") a ON TRUE
WHERE f.value:"code"::STRING ILIKE 'A61%'
GROUP BY COALESCE(a.value:"name"::STRING, p."assignee"::STRING)
ORDER BY "num_applications" DESC
LIMIT 20;
```

```sql
--Description: Single-step query that returns, for the assignee with the most A61 applications,
--             the filing year with the highest number of those applications.
WITH cte AS (
    SELECT
        p."filing_date",
        FLOOR(p."filing_date"/10000)      AS "filing_year",
        a.value:"name"::STRING            AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")              f,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE f.value:"code"::STRING ILIKE 'A61%'
      AND p."filing_date" > 0
),
top_assignee AS (
    SELECT "assignee_name"
    FROM cte
    GROUP BY "assignee_name"
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT
    cte."filing_year",
    COUNT(*) AS "num_applications"
FROM cte
JOIN top_assignee ta
  ON cte."assignee_name" = ta."assignee_name"
GROUP BY cte."filing_year"
ORDER BY "num_applications" DESC
LIMIT 20;
```
