Query:
--Description: Verify duplicates for that assignee in its peak year (distinct vs total rows).
WITH a61_pub AS (
    SELECT
        p."publication_number",
        p."filing_date",
        a.value:"name"::STRING AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")              f,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE f.value:"code"::STRING ILIKE 'A61%'
      AND p."filing_date" > 0
), top_assignee AS (
    SELECT "assignee_name"
    FROM a61_pub
    GROUP BY "assignee_name"
    ORDER BY COUNT(*) DESC
    LIMIT 1
), peak_year AS (
    SELECT FLOOR("filing_date"/10000) AS "filing_year"
    FROM a61_pub ap
    JOIN top_assignee ta ON ap."assignee_name" = ta."assignee_name"
    GROUP BY FLOOR("filing_date"/10000)
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT
    COUNT(DISTINCT ap."publication_number") AS "distinct_pubs",
    COUNT(*)                                AS "raw_rows"
FROM a61_pub ap
JOIN top_assignee ta ON ap."assignee_name" = ta."assignee_name"
JOIN peak_year    py ON FLOOR(ap."filing_date"/10000) = py."filing_year"
