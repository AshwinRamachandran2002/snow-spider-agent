SELECT 
  p."publication_number",
  p."filing_date",
  f.value:"code"::STRING AS "cpc_code"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f
WHERE f.value:"code"::STRING ILIKE 'A61%'
LIMIT 20;
```

```sql
--Description: Show a distinct sample of publication numbers, their assignee names and A61 CPC codes
SELECT DISTINCT
