```sql
--Description: Find the year in which the assignee with the single largest number of A61-category
--             applications filed the most of those applications.
--             1) “a61_pub” – keep only publications whose flattened CPC code begins with “A61”
--                and capture their filing_date and assignee name.
--             2) “top_assignee” – identify the assignee with the highest overall A61 application count.
--             3) Final SELECT – for that assignee, aggregate by filing year (YYYY = filing_date/10000),
--                count applications, and list years in descending order of filings (peak year first).
WITH a61_pub AS (
    SELECT
        p."filing_date",
        a.value:"name"::STRING AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")              f,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE f.value:"code"::STRING ILIKE 'A61%'      -- keep only CPC symbols starting with A61
      AND p."filing_date" > 0                      -- require a valid date
),
top_assignee AS (
    SELECT "assignee_name"
    FROM a61_pub
    GROUP BY "assignee_name"
    ORDER BY COUNT(*) DESC
    LIMIT 1                                         -- the assignee with most A61 applications
)
SELECT
    FLOOR(ap."filing_date" / 10000) AS "filing_year",
    COUNT(*)                          AS "applications_in_year"
FROM a61_pub   ap
JOIN top_assignee ta
  ON ap."assignee_name" = ta."assignee_name"
GROUP BY FLOOR(ap."filing_date" / 10000)
ORDER BY "applications_in_year" DESC
LIMIT 20;
