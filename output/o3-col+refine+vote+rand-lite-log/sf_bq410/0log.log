Query:
-- 9. Description: State-level aggregation (2017 tracts) of the total adjusted non-labor-force
--    population and its average population-adjusted proportion.
SELECT 
  sf."postal_code",
  SUM( GREATEST(COALESCE(t17."unemployed_pop",0) 
                + COALESCE(t17."not_in_labor_force",0) 
                - COALESCE(t17."group_quarters",0),0) )          AS "state_adj_nlf",
  AVG( CASE WHEN t17."total_pop" > 0 THEN 
              GREATEST(COALESCE(t17."unemployed_pop",0) 
                       + COALESCE(t17."not_in_labor_force",0) 
                       - COALESCE(t17."group_quarters",0),0) 
              / t17."total_pop" 
           END )                                                 AS "avg_adj_prop"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."CENSUSTRACT_2017_5YR" t17
JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"                   sf
  ON LPAD(sf."fips",2,'0') = SUBSTR(t17."geo_id",1,2)
GROUP BY sf."postal_code"
ORDER BY "state_adj_nlf"
LIMIT 20;
