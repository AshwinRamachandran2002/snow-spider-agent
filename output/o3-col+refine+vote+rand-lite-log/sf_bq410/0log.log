-- 8. Description: Sample calculation of tract-level adjusted non-labor-force population and
--    its proportion of total population (clamped at zero).
SELECT 
  "geo_id",
  GREATEST(
      COALESCE("unemployed_pop",0) 
      + COALESCE("not_in_labor_force",0) 
      - COALESCE("group_quarters",0)
  ,0)                                      AS "adj_non_labor_force",
  CASE WHEN "total_pop" > 0 
       THEN GREATEST(
                COALESCE("unemployed_pop",0)
                + COALESCE("not_in_labor_force",0)
                - COALESCE("group_quarters",0)
            ,0) / "total_pop"
       ELSE NULL END                       AS "adj_nlf_prop"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."CENSUSTRACT_2017_5YR"
LIMIT 20;
