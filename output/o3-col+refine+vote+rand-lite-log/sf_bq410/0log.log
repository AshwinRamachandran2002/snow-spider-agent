-- 1. Description: Peek at 2017 tract–level labor-force fields that will be used to build the
--    “adjusted non-labor-force” metric.
SELECT 
  "geo_id",
  "total_pop",
  "median_income",
  "unemployed_pop",
  "not_in_labor_force",
  "group_quarters"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."CENSUSTRACT_2017_5YR"
LIMIT 20;
```

```sql
-- 2. Description: Quick sense-check of how many 2017 tracts are missing the “group_quarters”
--    component (aggregates still capped with LIMIT just for exploration).
SELECT 
  COUNT(*)                                AS "tract_cnt",
  SUM(CASE WHEN "group_quarters" IS NULL THEN 1 ELSE 0 END) AS "null_group_quarters"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."CENSUSTRACT_2017_5YR"
LIMIT 20;
```

```sql
-- 3. Description: Preview 2015 tract median household incomes (to be the “start” of the change).
SELECT 
  "geo_id",
  "median_income"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."CENSUSTRACT_2015_5YR"
LIMIT 20;
```

```sql
-- 4. Description: Preview 2018 tract median household incomes (to be the “end” of the change).
SELECT 
  "geo_id",
  "median_income"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."CENSUSTRACT_2018_5YR"
LIMIT 20;
```

```sql
-- 5. Description: Example of computing income change per tract (2018 – 2015) and filtering
--    tracts with a non-null difference.
SELECT 
  t18."geo_id",
  t18."median_income" - t15."median_income"          AS "income_change"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."CENSUSTRACT_2018_5YR"  t18
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."CENSUSTRACT_2015_5YR"  t15
  ON t18."geo_id" = t15."geo_id"
WHERE t18."median_income" IS NOT NULL 
  AND t15."median_income" IS NOT NULL
LIMIT 20;
```

```sql
-- 6. Description: Glimpse at the state-code reference table that supplies the 2-letter
--    postal abbreviations and numeric FIPS codes.
SELECT 
  "fips",
  "postal_code",
  "state"
FROM CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"
LIMIT 20;
```

```sql
-- 7. Description: Show how a 2017 tract joins to its state abbreviation using the first
--    two digits of the tract GEOID.
SELECT 
  t17."geo_id",
  SUBSTR(t17."geo_id",1,2)                               AS "state_fips_txt",
  sf."postal_code"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."CENSUSTRACT_2017_5YR"  t17
JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"                     sf
  ON LPAD(sf."fips",2,'0') = SUBSTR(t17."geo_id",1,2)
LIMIT 20;
```

```sql
-- 8. Description: Sample calculation of tract-level adjusted non-labor-force population and
--    its proportion of total population (clamped at zero).
SELECT 
  "geo_id",
  GREATEST(
      COALESCE("unemployed_pop",0) 
      + COALESCE("not_in_labor_force",0) 
      - COALESCE("group_quarters",0)
  ,0)                                      AS "adj_non_labor_force",
  CASE WHEN "total_pop" > 0 
       THEN GREATEST(
                COALESCE("unemployed_pop",0)
                + COALESCE("not_in_labor_force",0)
                - COALESCE("group_quarters",0)
            ,0) / "total_pop"
       ELSE NULL END                       AS "adj_nlf_prop"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."CENSUSTRACT_2017_5YR"
LIMIT 20;
```

```sql
-- 9. Description: State-level aggregation (2017 tracts) of the total adjusted non-labor-force
--    population and its average population-adjusted proportion.
SELECT 
  sf."postal_code",
  SUM( GREATEST(COALESCE(t17."unemployed_pop",0) 
                + COALESCE(t17."not_in_labor_force",0) 
                - COALESCE(t17."group_quarters",0),0) )          AS "state_adj_nlf",
  AVG( CASE WHEN t17."total_pop" > 0 THEN 
              GREATEST(COALESCE(t17."unemployed_pop",0) 
                       + COALESCE(t17."not_in_labor_force",0) 
                       - COALESCE(t17."group_quarters",0),0) 
              / t17."total_pop" 
           END )                                                 AS "avg_adj_prop"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."CENSUSTRACT_2017_5YR" t17
JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"                   sf
  ON LPAD(sf."fips",2,'0') = SUBSTR(t17."geo_id",1,2)
GROUP BY sf."postal_code"
ORDER BY "state_adj_nlf"
LIMIT 20;
```

```sql
-- 10. Description: Final query – top 3 states with the smallest adjusted non-labor-force
--     population, including total income change (2018-2015), total adj. non-labor-force,
--     and average tract-level proportion.
WITH tract_income_change AS (
  SELECT 
    t18."geo_id",
    t18."median_income" - t15."median_income"       AS "income_change"
  FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."CENSUSTRACT_2018_5YR"  t18
  JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."CENSUSTRACT_2015_5YR"  t15
    ON t18."geo_id" = t15."geo_id"
  WHERE t18."median_income" IS NOT NULL 
    AND t15."median_income" IS NOT NULL
), tract_2017 AS (
  SELECT 
    "geo_id",
    "total_pop",
    GREATEST(COALESCE("unemployed_pop",0) 
             + COALESCE("not_in_labor_force",0) 
             - COALESCE("group_quarters",0),0)      AS "adj_nlf"
  FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."CENSUSTRACT_2017_5YR"
)
SELECT 
  sf."postal_code"                                            AS "state",
  SUM(ic."income_change")                                     AS "total_income_change_15_18",
  SUM(t17."adj_nlf")                                          AS "total_adj_non_labor_force",
  AVG( CASE WHEN t17."total_pop" > 0 THEN t17."adj_nlf" / t17."total_pop" END ) 
                                                              AS "avg_adj_prop"
FROM tract_2017                                               t17
JOIN tract_income_change                                      ic   ON ic."geo_id" = t17."geo_id"
JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"               sf   
     ON LPAD(sf."fips",2,'0') = SUBSTR(t17."geo_id",1,2)
GROUP BY sf."postal_code"
ORDER BY "total_adj_non_labor_force"
LIMIT 3;
```
