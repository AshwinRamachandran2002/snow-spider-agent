```

```sql
--Description: Compute per-tract median-income change (2018-2015) and adjusted non-labor force (sample)
SELECT 
  t17."geo_id",
  (t18."median_income" - t15."median_income") AS "income_change",
  (COALESCE(t17."unemployed_pop",0) + COALESCE(t17."not_in_labor_force",0) - COALESCE(t17."group_quarters",0)) AS "raw_adj_nlf",
  t17."total_pop"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.CENSUSTRACT_2017_5YR t17
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.CENSUSTRACT_2015_5YR t15
  ON t17."geo_id" = t15."geo_id"
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.CENSUSTRACT_2018_5YR t18
  ON t17."geo_id" = t18."geo_id"
LIMIT 20;
```

```sql
--Description: Aggregate to state level – preliminary totals (no clamping yet)
SELECT 
  s."postal_code"                                   AS "state_abbr",
  SUM(t18."median_income" - t15."median_income")    AS "tot_income_change",
  SUM(COALESCE(t17."unemployed_pop",0) + COALESCE(t17."not_in_labor_force",0) - COALESCE(t17."group_quarters",0)) AS "tot_adj_nlf"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.CENSUSTRACT_2017_5YR t17
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.CENSUSTRACT_2015_5YR t15
  ON t17."geo_id" = t15."geo_id"
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.CENSUSTRACT_2018_5YR t18
  ON t17."geo_id" = t18."geo_id"
JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC.STATE_FIPS s
  ON TO_NUMBER(SUBSTR(t17."geo_id",1,2)) = s."fips"
GROUP BY s."postal_code"
LIMIT 20;
```

```sql
--Description: Verify clamping logic produces no negatives (sample few tracts)
SELECT 
  "geo_id",
  CASE
    WHEN (COALESCE("unemployed_pop",0) + COALESCE("not_in_labor_force",0) - COALESCE("group_quarters",0)) < 0 
    THEN 0
    ELSE (COALESCE("unemployed_pop",0) + COALESCE("not_in_labor_force",0) - COALESCE("group_quarters",0))
  END AS "adj_nlf_clamped"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.CENSUSTRACT_2017_5YR
LIMIT 20;
```

```sql
--Description: Compute average tract-level proportion of adjusted non-labor force per state (sample)
SELECT 
  s."postal_code" AS "state_abbr",
  AVG(
    CASE 
      WHEN (COALESCE(t17."unemployed_pop",0) + COALESCE(t17."not_in_labor_force",0) - COALESCE(t17."group_quarters",0)) < 0
      THEN 0 
      ELSE (COALESCE(t17."unemployed_pop",0) + COALESCE(t17."not_in_labor_force",0) - COALESCE(t17."group_quarters",0))
    END
    /
    NULLIF(t17."total_pop",0)
  ) AS "avg_adj_nlf_prop"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.CENSUSTRACT_2017_5YR t17
JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC.STATE_FIPS s
  ON TO_NUMBER(SUBSTR(t17."geo_id",1,2)) = s."fips"
GROUP BY s."postal_code"
LIMIT 20;
```

```sql
--Description: Final ranked result – top 3 states with smallest adjusted non-labor force totals (complete logic)
SELECT 
  s."postal_code"                                                    AS "state_abbr",
  SUM(t18."median_income" - t15."median_income")                     AS "total_median_income_change_2015_2018",
  SUM(
      CASE 
        WHEN (COALESCE(t17."unemployed_pop",0) + COALESCE(t17."not_in_labor_force",0) - COALESCE(t17."group_quarters",0)) < 0
        THEN 0
        ELSE (COALESCE(t17."unemployed_pop",0) + COALESCE(t17."not_in_labor_force",0) - COALESCE(t17."group_quarters",0))
      END
  )                                                                  AS "total_adj_non_labor_force_pop",
  AVG(
      (CASE 
        WHEN (COALESCE(t17."unemployed_pop",0) + COALESCE(t17."not_in_labor_force",0) - COALESCE(t17."group_quarters",0)) < 0
        THEN 0
        ELSE (COALESCE(t17."unemployed_pop",0) + COALESCE(t17."not_in_labor_force",0) - COALESCE(t17."group_quarters",0))
      END)
      / NULLIF(t17."total_pop",0)
  )                                                                  AS "avg_adjusted_nlf_proportion"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.CENSUSTRACT_2017_5YR t17
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.CENSUSTRACT_2015_5YR t15
  ON t17."geo_id" = t15."geo_id"
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.CENSUSTRACT_2018_5YR t18
  ON t17."geo_id" = t18."geo_id"
JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC.STATE_FIPS s
  ON TO_NUMBER(SUBSTR(t17."geo_id",1,2)) = s."fips"
WHERE (t18."median_income" IS NOT NULL AND t15."median_income" IS NOT NULL)
GROUP BY s."postal_code"
ORDER BY "total_adj_non_labor_force_pop" ASC
LIMIT 3;
```
