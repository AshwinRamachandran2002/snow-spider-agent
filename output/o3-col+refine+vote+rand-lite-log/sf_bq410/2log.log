```sql
--Description: Check how many 2017 tracts will match 2015 data (basic join test)
SELECT COUNT(*) AS "matched_tracts"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.CENSUSTRACT_2017_5YR t17
