```sql
--Description: Peek at some raw match results to understand scores, teams and league identifiers.
SELECT "id",
       "league_id",
       "season",
       "home_team_api_id",
       "away_team_api_id",
       "home_team_goal",
       "away_team_goal"
FROM   "Match"
LIMIT 20;
```

```sql
--Description: Look‐up table of leagues – their ids and names.
SELECT "id",
       "name"
FROM   "League"
LIMIT 20;
```

```sql
--Description: Look‐up table of teams – their api ids and long names.
SELECT "team_api_id",
       "team_long_name"
FROM   "Team"
LIMIT 20;
```

```sql
--Description: Count home-side wins for every (league, team) pair.
SELECT "league_id",
       "home_team_api_id" AS "team_api_id",
       COUNT(*)           AS "wins_home"
FROM   "Match"
WHERE  "home_team_goal" > "away_team_goal"
GROUP BY "league_id",
         "home_team_api_id"
LIMIT 20;
```

```sql
--Description: Count away-side wins for every (league, team) pair.
SELECT "league_id",
       "away_team_api_id" AS "team_api_id",
       COUNT(*)           AS "wins_away"
FROM   "Match"
WHERE  "away_team_goal" > "home_team_goal"
GROUP BY "league_id",
         "away_team_api_id"
LIMIT 20;
```

```sql
--Description: Combine home + away counts to get total wins per team in each league.
SELECT "league_id",
       "team_api_id",
       SUM("wins") AS "total_wins"
FROM  (
        SELECT "league_id",
               "home_team_api_id" AS "team_api_id",
               COUNT(*)           AS "wins"
        FROM   "Match"
        WHERE  "home_team_goal" > "away_team_goal"
        GROUP BY "league_id","home_team_api_id"

        UNION ALL

        SELECT "league_id",
               "away_team_api_id",
               COUNT(*)           AS "wins"
        FROM   "Match"
        WHERE  "away_team_goal" > "home_team_goal"
        GROUP BY "league_id","away_team_api_id"
      ) AS w
GROUP BY "league_id","team_api_id"
LIMIT 20;
```

```sql
--Description: List every team that ever appeared in each league (home or away).
SELECT DISTINCT "league_id",
                "home_team_api_id" AS "team_api_id"
FROM   "Match"

UNION

SELECT DISTINCT "league_id",
                "away_team_api_id"
FROM   "Match"
LIMIT 20;
```

```sql
--Description: Produce win counts that also include the teams with zero wins by left-joining.
SELECT lt."league_id",
       lt."team_api_id",
       COALESCE(tw."total_wins",0) AS "wins"
FROM   (                           -- all league-team pairs
        SELECT "league_id","team_api_id"
        FROM  (
               SELECT DISTINCT "league_id",
                               "home_team_api_id" AS "team_api_id"
               FROM   "Match"
               UNION
               SELECT DISTINCT "league_id",
                               "away_team_api_id"
               FROM   "Match"
              )
       )                AS lt
LEFT JOIN               -- attach the previously calculated win totals
       (
        SELECT "league_id",
               "team_api_id",
               SUM("wins") AS "total_wins"
        FROM  (
               SELECT "league_id",
                      "home_team_api_id" AS "team_api_id",
                      COUNT(*)           AS "wins"
               FROM   "Match"
               WHERE  "home_team_goal" > "away_team_goal"
               GROUP BY "league_id","home_team_api_id"

               UNION ALL

               SELECT "league_id",
                      "away_team_api_id",
                      COUNT(*)           AS "wins"
               FROM   "Match"
               WHERE  "away_team_goal" > "home_team_goal"
               GROUP BY "league_id","away_team_api_id"
              )
        GROUP BY "league_id","team_api_id"
       )                AS tw
ON     lt."league_id"  = tw."league_id"
AND    lt."team_api_id"= tw."team_api_id"
LIMIT 20;
```

```sql
--Description: For each league, find the minimum number of wins achieved by any team.
SELECT "league_id",
       MIN("wins") AS "min_wins"
FROM  (
       SELECT lt."league_id",
              lt."team_api_id",
              COALESCE(tw."total_wins",0) AS "wins"
       FROM   (                          -- all league-team pairs
                SELECT "league_id","team_api_id"
                FROM  (
                       SELECT DISTINCT "league_id",
                                       "home_team_api_id" AS "team_api_id"
                       FROM   "Match"
                       UNION
                       SELECT DISTINCT "league_id",
                                       "away_team_api_id"
                       FROM   "Match"
                      )
              ) AS lt
       LEFT JOIN (                       -- attach win counts
                  SELECT "league_id",
                         "team_api_id",
                         SUM("wins") AS "total_wins"
                  FROM  (
                         SELECT "league_id",
                                "home_team_api_id" AS "team_api_id",
                                COUNT(*)           AS "wins"
                         FROM   "Match"
                         WHERE  "home_team_goal" > "away_team_goal"
                         GROUP BY "league_id","home_team_api_id"

                         UNION ALL

                         SELECT "league_id",
                                "away_team_api_id",
                                COUNT(*)           AS "wins"
                         FROM   "Match"
                         WHERE  "away_team_goal" > "home_team_goal"
                         GROUP BY "league_id","away_team_api_id"
                        )
                  GROUP BY "league_id","team_api_id"
                 ) AS tw
       ON     lt."league_id"  = tw."league_id"
       AND    lt."team_api_id"= tw."team_api_id"
      )
GROUP BY "league_id"
LIMIT 20;
```

```sql
--Description: Final answer – one team (tie-broken by smallest team_api_id) with the fewest wins in every league, along with win count.
SELECT l."name"          AS "league_name",
       t."team_long_name"AS "team_name",
       wt."wins"
FROM   (
        SELECT wt1.*
        FROM   (
                -- wins (including zero) for every league-team pair
                SELECT lt."league_id",
                       lt."team_api_id",
                       COALESCE(tw."total_wins",0) AS "wins"
                FROM   (
                        SELECT "league_id","team_api_id"
                        FROM  (
                               SELECT DISTINCT "league_id",
                                               "home_team_api_id" AS "team_api_id"
                               FROM   "Match"
                               UNION
                               SELECT DISTINCT "league_id",
                                               "away_team_api_id"
                               FROM   "Match"
                              )
                       ) AS lt
                LEFT JOIN (
                           SELECT "league_id",
                                  "team_api_id",
                                  SUM("wins") AS "total_wins"
                           FROM  (
                                  SELECT "league_id",
                                         "home_team_api_id" AS "team_api_id",
                                         COUNT(*)           AS "wins"
                                  FROM   "Match"
                                  WHERE  "home_team_goal" > "away_team_goal"
                                  GROUP BY "league_id","home_team_api_id"

                                  UNION ALL

                                  SELECT "league_id",
                                         "away_team_api_id",
                                         COUNT(*)           AS "wins"
                                  FROM   "Match"
                                  WHERE  "away_team_goal" > "home_team_goal"
                                  GROUP BY "league_id","away_team_api_id"
                                 )
                           GROUP BY "league_id","team_api_id"
                          ) AS tw
                ON     lt."league_id"  = tw."league_id"
                AND    lt."team_api_id"= tw."team_api_id"
               ) AS wt1
        INNER JOIN (                       -- minimum wins per league
                    SELECT "league_id",
                           MIN("wins") AS "min_wins"
                    FROM   (
                            SELECT lt."league_id",
                                   lt."team_api_id",
                                   COALESCE(tw."total_wins",0) AS "wins"
                            FROM  (
                                   SELECT "league_id","team_api_id"
                                   FROM  (
                                          SELECT DISTINCT "league_id",
                                                          "home_team_api_id" AS "team_api_id"
                                          FROM   "Match"
                                          UNION
                                          SELECT DISTINCT "league_id",
                                                          "away_team_api_id"
                                          FROM   "Match"
                                         )
                                  ) AS lt
                            LEFT JOIN (
                                       SELECT "league_id",
                                              "team_api_id",
                                              SUM("wins") AS "total_wins"
                                       FROM  (
                                              SELECT "league_id",
                                                     "home_team_api_id" AS "team_api_id",
                                                     COUNT(*)           AS "wins"
                                              FROM   "Match"
                                              WHERE  "home_team_goal" > "away_team_goal"
                                              GROUP BY "league_id","home_team_api_id"

                                              UNION ALL

                                              SELECT "league_id",
                                                     "away_team_api_id",
                                                     COUNT(*)           AS "wins"
                                              FROM   "Match"
                                              WHERE  "away_team_goal" > "home_team_goal"
                                              GROUP BY "league_id","away_team_api_id"
                                             )
                                       GROUP BY "league_id","team_api_id"
                                      ) AS tw
                            ON     lt."league_id"  = tw."league_id"
                            AND    lt."team_api_id"= tw."team_api_id"
                           )
                    GROUP BY "league_id"
                   ) AS mw
        ON  wt1."league_id" = mw."league_id"
        AND wt1."wins"      = mw."min_wins"
        GROUP BY wt1."league_id"          -- tie-break: lowest team_api_id retained
        HAVING MIN(wt1."team_api_id")
       ) AS wt
JOIN   "League" AS l
       ON l."id"         = wt."league_id"
JOIN   "Team"   AS t
       ON t."team_api_id"= wt."team_api_id"
LIMIT 20;
```
