2025-05-05 04:47:01 - Thread-3919 (execute) - INFO - [Exploration]
Below are 10 successive, DIFFERENT `SELECT` statements (each limited to 20 rows) that move step-by-step from basic inspection toward the requested result – “for every league, return the single team that has the fewest total wins (including 0) across all seasons; if several teams tie, return only one team for that league.”

```sql
-- 1️⃣  Description:
--     Take a first look at the leagues that exist in the file.
SELECT DISTINCT "id", "name"
FROM "League"
LIMIT 20;
```

```sql
-- 2️⃣  Description:
--     Glimpse at a handful of teams to remember their long / short names
--     and the all-important `team_api_id`.
SELECT DISTINCT "team_api_id", "team_long_name", "team_short_name"
FROM "Team"
LIMIT 20;
```

```sql
-- 3️⃣  Description:
--     Look at some matches: league, teams involved, and the final score.
SELECT DISTINCT "id", "league_id",
       "home_team_api_id", "away_team_api_id",
       "home_team_goal",   "away_team_goal"
FROM "Match"
LIMIT 20;
```

```sql
-- 4️⃣  Description:
--     Count HOME-side wins per (league, team) just to understand the pattern.
SELECT DISTINCT "league_id", "home_team_api_id"  AS "team_api_id",
       SUM(CASE WHEN home_team_goal > away_team_goal THEN 1 ELSE 0 END) 
       AS "home_wins"
FROM "Match"
GROUP BY "league_id", "home_team_api_id"
LIMIT 20;
```

```sql
-- 5️⃣  Description:
--     Count AWAY-side wins per (league, team) in the same manner.
SELECT DISTINCT "league_id", "away_team_api_id"  AS "team_api_id",
       SUM(CASE WHEN away_team_goal > home_team_goal THEN 1 ELSE 0 END) 
       AS "away_wins"
FROM "Match"
GROUP BY "league_id", "away_team_api_id"
LIMIT 20;
```

```sql
-- 6️⃣  Description:
--     Merge home + away tallies to obtain TOTAL wins for each team in each league.
WITH wins AS (
    SELECT league_id, home_team_api_id AS team_api_id,
           SUM(CASE WHEN home_team_goal > away_team_goal THEN 1 ELSE 0 END) AS w
    FROM Match
    GROUP BY league_id, home_team_api_id
    UNION ALL
    SELECT league_id, away_team_api_id,
           SUM(CASE WHEN away_team_goal > home_team_goal THEN 1 ELSE 0 END)
    FROM Match
    GROUP BY league_id, away_team_api_id
)
SELECT DISTINCT league_id, team_api_id,
       SUM(w) AS total_wins
FROM wins
GROUP BY league_id, team_api_id
LIMIT 20;
```

```sql
-- 7️⃣  Description:
--     Prepare the universe of every (league, team) that ever *played*,
--     then LEFT JOIN the previous wins table so that never-winners show 0.
WITH teams_in_league AS (
    SELECT DISTINCT league_id, home_team_api_id AS team_api_id FROM Match
    UNION
    SELECT DISTINCT league_id, away_team_api_id FROM Match
),
wins AS (
    SELECT league_id, home_team_api_id AS team_api_id,
           SUM(CASE WHEN home_team_goal > away_team_goal THEN 1 ELSE 0 END) AS w
    FROM Match
    GROUP BY league_id, home_team_api_id
    UNION ALL
    SELECT league_id, away_team_api_id,
           SUM(CASE WHEN away_team_goal > home_team_goal THEN 1 ELSE 0 END)
    FROM Match
    GROUP BY league_id, away_team_api_id
),
tot AS (
    SELECT league_id, team_api_id, SUM(w) AS total_wins
    FROM wins
    GROUP BY league_id, team_api_id
)
SELECT DISTINCT l.id        AS league_id,
       t.team_api_id,
       COALESCE(tot.total_wins, 0) AS total_wins
FROM teams_in_league t
LEFT JOIN tot     ON tot.league_id = t.league_id
                 AND tot.team_api_id = t.team_api_id
JOIN League l     ON l.id = t.league_id
LIMIT 20;
```

```sql
-- 8️⃣  Description:
--     For each league, discover the MIN-win figure (0, 1, …).
WITH teams_in_league AS (
    SELECT DISTINCT league_id, home_team_api_id AS team_api_id FROM Match
    UNION
    SELECT DISTINCT league_id, away_team_api_id FROM Match
),
wins AS (
    SELECT league_id, home_team_api_id AS team_api_id,
           SUM(CASE WHEN home_team_goal > away_team_goal THEN 1 ELSE 0 END) AS w
    FROM Match
    GROUP BY league_id, home_team_api_id
    UNION ALL
    SELECT league_id, away_team_api_id,
           SUM(CASE WHEN away_team_goal > home_team_goal THEN 1 ELSE 0 END)
    FROM Match
    GROUP BY league_id, away_team_api_id
),
tot AS (
    SELECT league_id, team_api_id, SUM(w) AS total_wins
    FROM wins
    GROUP BY league_id, team_api_id
),
all_tot AS (
    SELECT t.league_id, t.team_api_id, COALESCE(tot.total_wins, 0) AS total_wins
    FROM teams_in_league t LEFT JOIN tot
      ON tot.league_id = t.league_id AND tot.team_api_id = t.team_api_id
)
SELECT DISTINCT league_id,
       MIN(total_wins) AS fewest_wins
FROM all_tot
GROUP BY league_id
LIMIT 20;
```

```sql
-- 9️⃣  Description:
--     FINAL ANSWER (window-function version) –
--     pick exactly ONE team (row_number = 1) having the minimum wins per league.
WITH teams_in_league AS (
    SELECT DISTINCT league_id, home_team_api_id AS team_api_id FROM Match
    UNION
    SELECT DISTINCT league_id, away_team_api_id FROM Match
),
wins AS (
    SELECT league_id, home_team_api_id AS team_api_id,
           SUM(CASE WHEN home_team_goal > away_team_goal THEN 1 ELSE 0 END) AS w
    FROM Match
    GROUP BY league_id, home_team_api_id
    UNION ALL
    SELECT league_id, away_team_api_id,
           SUM(CASE WHEN away_team_goal > home_team_goal THEN 1 ELSE 0 END)
    FROM Match
    GROUP BY league_id, away_team_api_id
),
tot AS (
    SELECT league_id, team_api_id, SUM(w) AS total_wins
    FROM wins
    GROUP BY league_id, team_api_id
),
all_tot AS (
    SELECT t.league_id, t.team_api_id, COALESCE(tot.total_wins, 0) AS total_wins
    FROM teams_in_league t LEFT JOIN tot
      ON tot.league_id = t.league_id AND tot.team_api_id = t.team_api_id
),
ranked AS (
    SELECT l.name            AS league_name,
           tm.team_long_name AS team_name,
           all_tot.total_wins,
           ROW_NUMBER() OVER (PARTITION BY all_tot.league_id
                              ORDER BY all_tot.total_wins,
                                       tm.team_long_name) AS rn
    FROM all_tot
    JOIN League l ON l.id = all_tot.league_id
    JOIN Team   tm ON tm.team_api_id = all_tot.team_api_id
)
SELECT DISTINCT league_name, team_name, total_wins
FROM ranked
WHERE rn = 1
ORDER BY league_name
LIMIT 20;
```

```sql
-- 🔟  Description:
--     Same final answer but WITHOUT window functions, using a correlated
--     sub-query to keep just one team (ties resolved by smallest team name).
WITH teams_in_league AS (
    SELECT DISTINCT league_id, home_team_api_id AS team_api_id FROM Match
    UNION
    SELECT DISTINCT league_id, away_team_api_id FROM Match
),
wins AS (
    SELECT league_id, home_team_api_id AS team_api_id,
           SUM(CASE WHEN home_team_goal > away_team_goal THEN 1 ELSE 0 END) AS w
    FROM Match
    GROUP BY league_id, home_team_api_id
    UNION ALL
    SELECT league_id, away_team_api_id,
           SUM(CASE WHEN away_team_goal > home_team_goal THEN 1 ELSE 0 END)
    FROM Match
    GROUP BY league_id, away_team_api_id
),
tot AS (
    SELECT league_id, team_api_id, SUM(w) AS total_wins
    FROM wins
    GROUP BY league_id, team_api_id
),
all_tot AS (
    SELECT t.league_id, t.team_api_id, COALESCE(tot.total_wins, 0) AS total_wins
    FROM teams_in_league t LEFT JOIN tot
      ON tot.league_id = t.league_id AND tot.team_api_id = t.team_api_id
)
SELECT DISTINCT l.name  AS league_name,
       tm.team_long_name,
       all_tot.total_wins
FROM all_tot
JOIN Team   tm ON tm.team_api_id = all_tot.team_api_id
JOIN League l  ON l.id          = all_tot.league_id
WHERE NOT EXISTS (
    SELECT 1
    FROM all_tot AS x
    JOIN Team t2 ON t2.team_api_id = x.team_api_id
    WHERE x.league_id = all_tot.league_id
      AND (x.total_wins  <  all_tot.total_wins
           OR (x.total_wins = all_tot.total_wins
               AND t2.team_long_name < tm.team_long_name))
)
ORDER BY league_name
LIMIT 20;
```
