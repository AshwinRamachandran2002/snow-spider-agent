-- 9️⃣  Description:
--     FINAL ANSWER (window-function version) –
--     pick exactly ONE team (row_number = 1) having the minimum wins per league.
WITH teams_in_league AS (
    SELECT DISTINCT league_id, home_team_api_id AS team_api_id FROM Match
    UNION
    SELECT DISTINCT league_id, away_team_api_id FROM Match
),
wins AS (
    SELECT league_id, home_team_api_id AS team_api_id,
           SUM(CASE WHEN home_team_goal > away_team_goal THEN 1 ELSE 0 END) AS w
    FROM Match
    GROUP BY league_id, home_team_api_id
    UNION ALL
    SELECT league_id, away_team_api_id,
           SUM(CASE WHEN away_team_goal > home_team_goal THEN 1 ELSE 0 END)
    FROM Match
    GROUP BY league_id, away_team_api_id
),
tot AS (
    SELECT league_id, team_api_id, SUM(w) AS total_wins
    FROM wins
    GROUP BY league_id, team_api_id
),
all_tot AS (
    SELECT t.league_id, t.team_api_id, COALESCE(tot.total_wins, 0) AS total_wins
    FROM teams_in_league t LEFT JOIN tot
      ON tot.league_id = t.league_id AND tot.team_api_id = t.team_api_id
),
ranked AS (
    SELECT l.name            AS league_name,
           tm.team_long_name AS team_name,
           all_tot.total_wins,
           ROW_NUMBER() OVER (PARTITION BY all_tot.league_id
                              ORDER BY all_tot.total_wins,
                                       tm.team_long_name) AS rn
    FROM all_tot
    JOIN League l ON l.id = all_tot.league_id
    JOIN Team   tm ON tm.team_api_id = all_tot.team_api_id
)
SELECT DISTINCT league_name, team_name, total_wins
FROM ranked
WHERE rn = 1
ORDER BY league_name
LIMIT 20;
