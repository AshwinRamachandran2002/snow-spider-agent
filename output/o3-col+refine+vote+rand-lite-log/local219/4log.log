```sql
-- Description: 4) Count home-side victories for every team in every league.
SELECT "league_id",
       "home_team_api_id" AS "team_api_id",
       COUNT(*)           AS "home_wins"
FROM "Match"
WHERE "home_team_goal" > "away_team_goal"
GROUP BY "league_id", "team_api_id"
LIMIT 20;
```

```sql
-- Description: 5) Count away-side victories for every team in every league.
SELECT "league_id",
       "away_team_api_id" AS "team_api_id",
       COUNT(*)            AS "away_wins"
FROM "Match"
WHERE "away_team_goal" > "home_team_goal"
GROUP BY "league_id", "team_api_id"
LIMIT 20;
```

```sql
-- Description: 6) Build a table that contains every (league, team) pair which ever
--               appeared in a match, then attach the total number of wins each
--               of those teams has in that league (0 if none).
WITH team_league AS (
      SELECT "league_id", "home_team_api_id" AS "team_api_id" FROM "Match"
      UNION
      SELECT "league_id", "away_team_api_id"                FROM "Match"
),
wins AS (
      SELECT "league_id", "home_team_api_id" AS "team_api_id", COUNT(*) AS "w"
      FROM "Match"
      WHERE "home_team_goal" > "away_team_goal"
      GROUP BY "league_id", "team_api_id"
      UNION ALL
      SELECT "league_id", "away_team_api_id", COUNT(*)       AS "w"
      FROM "Match"
      WHERE "away_team_goal" > "home_team_goal"
      GROUP BY "league_id", "away_team_api_id"
)
SELECT tl."league_id",
       tl."team_api_id",
       COALESCE(SUM(w."w"),0) AS "total_wins"
FROM team_league AS tl
LEFT JOIN wins AS w
       ON tl."league_id" = w."league_id"
      AND tl."team_api_id" = w."team_api_id"
GROUP BY tl."league_id", tl."team_api_id"
LIMIT 20;
```

```sql
-- Description: 7-FINAL) For every league, return exactly one team that has the
--               fewest total victories across all seasons (teams with 0 wins are
--               included).  If several teams tie, only one (arbitrarily the first
--               after GROUP BY) is kept for that league.
WITH team_league AS (
      SELECT "league_id", "home_team_api_id" AS "team_api_id" FROM "Match"
      UNION
      SELECT "league_id", "away_team_api_id"                FROM "Match"
),
wins AS (
      SELECT "league_id", "home_team_api_id" AS "team_api_id", COUNT(*) AS "w"
      FROM "Match"
      WHERE "home_team_goal" > "away_team_goal"
      GROUP BY "league_id", "team_api_id"
      UNION ALL
      SELECT "league_id", "away_team_api_id", COUNT(*)       AS "w"
      FROM "Match"
      WHERE "away_team_goal" > "home_team_goal"
      GROUP BY "league_id", "away_team_api_id"
),
total_wins AS (
      SELECT tl."league_id",
             tl."team_api_id",
             COALESCE(SUM(w."w"),0) AS "total_wins"
      FROM team_league AS tl
      LEFT JOIN wins AS w
             ON tl."league_id" = w."league_id"
            AND tl."team_api_id" = w."team_api_id"
      GROUP BY tl."league_id", tl."team_api_id"
),
min_wins AS (
      SELECT "league_id", MIN("total_wins") AS "min_w"
      FROM total_wins
      GROUP BY "league_id"
)
SELECT l."name"            AS "league_name",
       t."team_long_name"  AS "team_with_fewest_wins",
       tw."total_wins"     AS "wins"
FROM total_wins AS tw
JOIN min_wins  AS mw ON tw."league_id" = mw."league_id"
                   AND tw."total_wins" = mw."min_w"
JOIN "League"   AS l  ON tw."league_id"  = l."id"
JOIN "Team"     AS t  ON tw."team_api_id" = t."team_api_id"
GROUP BY tw."league_id"          -- keeps exactly one team per league
ORDER BY l."name"
LIMIT 20;
```
