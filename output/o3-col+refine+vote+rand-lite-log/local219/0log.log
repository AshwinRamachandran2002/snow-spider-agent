Below is a sequence of exploratory SQL statements that gradually build the logic needed, ending with a final query that – for every league ‑ returns one single team with the fewest total match-wins (home- or away-wins), while keeping sides that never won a game and solving ties by selecting the smallest team_api_id per league.

```sql
-- 1) Preview the list of leagues
SELECT DISTINCT "id", "name"
FROM "League"
LIMIT 20;
```

```sql
-- 2) Preview some teams
SELECT "team_api_id", "team_long_name"
FROM "Team"
LIMIT 20;
```

```sql
-- 3) Inspect match results (scores & participating teams)
SELECT "id",
       "league_id",
       "season",
       "home_team_api_id",
       "away_team_api_id",
       "home_team_goal",
       "away_team_goal"
FROM "Match"
LIMIT 20;
```

```sql
-- 4) For every match pick its winner (NULL = draw)
SELECT "id",
       CASE
           WHEN "home_team_goal" > "away_team_goal" THEN "home_team_api_id"
           WHEN "away_team_goal" > "home_team_goal" THEN "away_team_api_id"
       END AS "winner_team_api_id"
FROM "Match"
WHERE "home_team_goal" IS NOT NULL            -- ensure score is present
  AND "away_team_goal" IS NOT NULL
LIMIT 20;
```

```sql
-- 5) Count wins per team inside each league (ignoring draws)
SELECT "league_id",
       "winner_team_api_id"      AS "team_api_id",
       COUNT(*)                  AS "wins"
FROM (
        SELECT "league_id",
               CASE
                   WHEN "home_team_goal" > "away_team_goal" THEN "home_team_api_id"
                   WHEN "away_team_goal" > "home_team_goal" THEN "away_team_api_id"
               END AS "winner_team_api_id"
        FROM "Match"
) AS m
WHERE "winner_team_api_id" IS NOT NULL
GROUP BY "league_id", "winner_team_api_id"
LIMIT 20;
```

```sql
-- 6) All teams that ever appeared in a league (home OR away)
SELECT DISTINCT "league_id", "team_api_id"
FROM (
        SELECT "league_id", "home_team_api_id" AS "team_api_id"
        FROM "Match"
        UNION
        SELECT "league_id", "away_team_api_id"
        FROM "Match"
) AS t
LIMIT 20;
```

```sql
-- 7) Merge the previous two steps so teams with 0 wins keep a row
SELECT t."league_id",
       t."team_api_id",
       COALESCE(w."wins", 0) AS "wins"
FROM (
        SELECT DISTINCT "league_id", "team_api_id"
        FROM (
                SELECT "league_id", "home_team_api_id" AS "team_api_id" FROM "Match"
                UNION
                SELECT "league_id", "away_team_api_id"               FROM "Match"
        )
) AS t
LEFT JOIN (
        SELECT "league_id",
               "winner_team_api_id" AS "team_api_id",
               COUNT(*)            AS "wins"
        FROM (
                SELECT "league_id",
                       CASE
                           WHEN "home_team_goal" > "away_team_goal" THEN "home_team_api_id"
                           WHEN "away_team_goal" > "home_team_goal" THEN "away_team_api_id"
                       END AS "winner_team_api_id"
                FROM "Match"
        )
        WHERE "winner_team_api_id" IS NOT NULL
        GROUP BY "league_id", "winner_team_api_id"
) AS w
  ON t."league_id" = w."league_id"
 AND t."team_api_id" = w."team_api_id"
LIMIT 20;
```

```sql
-- 8) FINAL ANSWER:
--    For every league return *one* team having the fewest wins
WITH team_wins AS (
     -- wins (including 0) for every team that played in the league
     SELECT t."league_id",
            t."team_api_id",
            COALESCE(w."wins", 0) AS "wins"
     FROM (
           SELECT DISTINCT "league_id", "team_api_id"
           FROM (
                  SELECT "league_id", "home_team_api_id" AS "team_api_id" FROM "Match"
                  UNION
                  SELECT "league_id", "away_team_api_id"               FROM "Match"
           )
     ) AS t
     LEFT JOIN (
           SELECT "league_id",
                  "winner_team_api_id" AS "team_api_id",
                  COUNT(*)            AS "wins"
           FROM (
                 SELECT "league_id",
                        CASE
                            WHEN "home_team_goal" > "away_team_goal" THEN "home_team_api_id"
                            WHEN "away_team_goal" > "home_team_goal" THEN "away_team_api_id"
                        END AS "winner_team_api_id"
                 FROM "Match"
           )
           WHERE "winner_team_api_id" IS NOT NULL
           GROUP BY "league_id", "winner_team_api_id"
     ) AS w
       ON t."league_id"  = w."league_id"
      AND t."team_api_id" = w."team_api_id"
), league_min AS (
     -- minimal win-count in every league
     SELECT "league_id", MIN("wins") AS "min_wins"
     FROM   team_wins
     GROUP BY "league_id"
), tied_teams AS (
     -- teams that have the minimal win-count
     SELECT tw."league_id", tw."team_api_id", tw."wins"
     FROM   team_wins  AS tw
     JOIN   league_min AS lm
       ON   tw."league_id" = lm."league_id"
      AND   tw."wins"      = lm."min_wins"
), one_team_per_league AS (
     -- resolve ties by picking the smallest team_api_id
     SELECT "league_id",
            MIN("team_api_id") AS "team_api_id"
     FROM   tied_teams
     GROUP BY "league_id"
)
SELECT lg."name"          AS "league_name",
       tm."team_long_name" AS "team_with_fewest_wins",
       ttw."wins"          AS "total_wins"
FROM   one_team_per_league AS otp
JOIN   tied_teams          AS ttw
       ON  otp."league_id"  = ttw."league_id"
      AND otp."team_api_id" = ttw."team_api_id"
JOIN   "League"            AS lg  ON lg."id"         = otp."league_id"
JOIN   "Team"              AS tm  ON tm."team_api_id"= otp."team_api_id"
ORDER BY lg."name"
LIMIT 20;
```

The final query (`#8`) produces, for each league in the database, exactly one side with the fewest number of wins across all recorded seasons, respecting teams that never won a match and breaking ties deterministically by the smallest `team_api_id`.
