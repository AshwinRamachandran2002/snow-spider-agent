--Description: Present human-readable league & team names along with their win totals (final answer view).
WITH team_wins AS (
     SELECT "league_id",
            "team_api_id",
            COUNT(*) AS "total_wins"
     FROM (
            SELECT "league_id",
                   "home_team_api_id" AS "team_api_id"
            FROM   "Match"
            WHERE  "home_team_goal" > "away_team_goal"
            UNION ALL
            SELECT "league_id",
                   "away_team_api_id" AS "team_api_id"
            FROM   "Match"
            WHERE  "away_team_goal" > "home_team_goal"
          )
     GROUP BY "league_id", "team_api_id"
),
min_wins AS (
     SELECT "league_id",
            MIN("total_wins") AS "min_wins"
     FROM   team_wins
     GROUP BY "league_id"
),
fewest AS (
     SELECT tw.*
     FROM   team_wins tw
     JOIN   min_wins mw
            ON  tw."league_id"  = mw."league_id"
            AND tw."total_wins" = mw."min_wins"
)
SELECT l."name"            AS "league_name",
       t."team_long_name"  AS "team_name",
       f."total_wins"
FROM   fewest f
JOIN   "League" l ON l."id"         = f."league_id"
JOIN   "Team"   t ON t."team_api_id" = f."team_api_id"
WHERE  f."team_api_id" = (
       SELECT MIN(f2."team_api_id")
       FROM   fewest f2
       WHERE  f2."league_id" = f."league_id"
)
LIMIT 20;
