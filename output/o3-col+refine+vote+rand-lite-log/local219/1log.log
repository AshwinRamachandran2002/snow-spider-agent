```sql
--Description: View a snapshot of all leagues and their internal ids.
SELECT DISTINCT "id", "name"
FROM "League"
LIMIT 20;
```

```sql
--Description: Take a quick look at teams and their API identifiers.
SELECT DISTINCT "team_api_id", "team_long_name"
FROM "Team"
LIMIT 20;
```

```sql
--Description: Inspect a handful of matches to see the goal columns that determine a win.
SELECT "id",
       "league_id",
       "home_team_api_id",
       "away_team_api_id",
       "home_team_goal",
       "away_team_goal"
FROM "Match"
WHERE "home_team_goal" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Count HOME-side wins per team within each league.
SELECT "league_id",
       "home_team_api_id" AS "team_api_id",
       COUNT(*)           AS "home_wins"
FROM "Match"
WHERE "home_team_goal" > "away_team_goal"
GROUP BY "league_id", "home_team_api_id"
LIMIT 20;
```

```sql
--Description: Count AWAY-side wins per team within each league.
SELECT "league_id",
       "away_team_api_id" AS "team_api_id",
       COUNT(*)           AS "away_wins"
FROM "Match"
WHERE "away_team_goal" > "home_team_goal"
GROUP BY "league_id", "away_team_api_id"
LIMIT 20;
```

```sql
--Description: Combine home-wins and away-wins to get TOTAL wins for every team in every league.
SELECT "league_id",
       "team_api_id",
       COUNT(*) AS "total_wins"
FROM (
        SELECT "league_id",
               "home_team_api_id" AS "team_api_id"
        FROM   "Match"
        WHERE  "home_team_goal" > "away_team_goal"
        UNION ALL
        SELECT "league_id",
               "away_team_api_id" AS "team_api_id"
        FROM   "Match"
        WHERE  "away_team_goal" > "home_team_goal"
     ) AS wins
GROUP BY "league_id", "team_api_id"
LIMIT 20;
```

```sql
--Description: For each league, find the minimum number of wins achieved by ANY team.
SELECT "league_id",
       MIN("total_wins") AS "min_wins"
FROM (
        SELECT "league_id",
               "team_api_id",
               COUNT(*) AS "total_wins"
        FROM (
                SELECT "league_id",
                       "home_team_api_id" AS "team_api_id"
                FROM   "Match"
                WHERE  "home_team_goal" > "away_team_goal"
                UNION ALL
                SELECT "league_id",
                       "away_team_api_id" AS "team_api_id"
                FROM   "Match"
                WHERE  "away_team_goal" > "home_team_goal"
             )
        GROUP BY "league_id", "team_api_id"
     )
GROUP BY "league_id"
LIMIT 20;
```

```sql
--Description: Pick ONE team per league that owns the fewest wins (tie-breaker = smallest team_api_id).
WITH team_wins AS (
     SELECT "league_id",
            "team_api_id",
            COUNT(*) AS "total_wins"
     FROM (
            SELECT "league_id",
                   "home_team_api_id" AS "team_api_id"
            FROM   "Match"
            WHERE  "home_team_goal" > "away_team_goal"
            UNION ALL
            SELECT "league_id",
                   "away_team_api_id" AS "team_api_id"
            FROM   "Match"
            WHERE  "away_team_goal" > "home_team_goal"
          )
     GROUP BY "league_id", "team_api_id"
),
min_wins AS (
     SELECT "league_id",
            MIN("total_wins") AS "min_wins"
     FROM   team_wins
     GROUP BY "league_id"
)
SELECT tw."league_id",
       tw."team_api_id",
       tw."total_wins"
FROM   team_wins tw
JOIN   min_wins mw
       ON  tw."league_id" = mw."league_id"
       AND tw."total_wins" = mw."min_wins"
GROUP BY tw."league_id"                          -- one row per league
HAVING tw."team_api_id" = MIN(tw."team_api_id")  -- tie-break rule
LIMIT 20;
```

```sql
--Description: Present human-readable league & team names along with their win totals (final answer view).
WITH team_wins AS (
     SELECT "league_id",
            "team_api_id",
            COUNT(*) AS "total_wins"
     FROM (
            SELECT "league_id",
                   "home_team_api_id" AS "team_api_id"
            FROM   "Match"
            WHERE  "home_team_goal" > "away_team_goal"
            UNION ALL
            SELECT "league_id",
                   "away_team_api_id" AS "team_api_id"
            FROM   "Match"
            WHERE  "away_team_goal" > "home_team_goal"
          )
     GROUP BY "league_id", "team_api_id"
),
min_wins AS (
     SELECT "league_id",
            MIN("total_wins") AS "min_wins"
     FROM   team_wins
     GROUP BY "league_id"
),
fewest AS (
     SELECT tw.*
     FROM   team_wins tw
     JOIN   min_wins mw
            ON  tw."league_id"  = mw."league_id"
            AND tw."total_wins" = mw."min_wins"
)
SELECT l."name"            AS "league_name",
       t."team_long_name"  AS "team_name",
       f."total_wins"
FROM   fewest f
JOIN   "League" l ON l."id"         = f."league_id"
JOIN   "Team"   t ON t."team_api_id" = f."team_api_id"
WHERE  f."team_api_id" = (
       SELECT MIN(f2."team_api_id")
       FROM   fewest f2
       WHERE  f2."league_id" = f."league_id"
)
LIMIT 20;
```

```sql
--Description: Verify teams that appear in a league’s matches but have ZERO wins (sanity check).
SELECT m."league_id",
       t."team_long_name",
       COALESCE(w."total_wins", 0) AS "wins"
FROM (
        SELECT "league_id",
               "home_team_api_id" AS "team_api_id"
        FROM   "Match"
        UNION
        SELECT "league_id",
               "away_team_api_id" AS "team_api_id"
        FROM   "Match"
     ) AS m
JOIN "Team" t
     ON t."team_api_id" = m."team_api_id"
LEFT JOIN (
        SELECT "league_id",
               "team_api_id",
               COUNT(*) AS "total_wins"
        FROM (
               SELECT "league_id",
                      "home_team_api_id" AS "team_api_id"
               FROM   "Match"
               WHERE  "home_team_goal" > "away_team_goal"
               UNION ALL
               SELECT "league_id",
                      "away_team_api_id" AS "team_api_id"
               FROM   "Match"
               WHERE  "away_team_goal" > "home_team_goal"
             )
        GROUP BY "league_id", "team_api_id"
     ) AS w
     ON  w."league_id"   = m."league_id"
     AND w."team_api_id" = m."team_api_id"
WHERE w."total_wins" IS NULL
LIMIT 20;
```
