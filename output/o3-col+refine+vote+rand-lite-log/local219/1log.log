Query:
--Description: Pick ONE team per league that owns the fewest wins (tie-breaker = smallest team_api_id).
WITH team_wins AS (
     SELECT "league_id",
            "team_api_id",
            COUNT(*) AS "total_wins"
     FROM (
            SELECT "league_id",
                   "home_team_api_id" AS "team_api_id"
            FROM   "Match"
            WHERE  "home_team_goal" > "away_team_goal"
            UNION ALL
            SELECT "league_id",
                   "away_team_api_id" AS "team_api_id"
            FROM   "Match"
            WHERE  "away_team_goal" > "home_team_goal"
          )
     GROUP BY "league_id", "team_api_id"
),
min_wins AS (
     SELECT "league_id",
            MIN("total_wins") AS "min_wins"
     FROM   team_wins
     GROUP BY "league_id"
)
SELECT tw."league_id",
       tw."team_api_id",
       tw."total_wins"
FROM   team_wins tw
JOIN   min_wins mw
       ON  tw."league_id" = mw."league_id"
       AND tw."total_wins" = mw."min_wins"
GROUP BY tw."league_id"                          -- one row per league
HAVING tw."team_api_id" = MIN(tw."team_api_id")  -- tie-break rule
LIMIT 20;
