           away_team_api_id
    FROM   Match
    WHERE  away_team_goal > home_team_goal
),
win_totals AS (
    SELECT league_id,
           team_api_id,
           COUNT(*) AS wins
    FROM   wins_raw
    GROUP BY league_id, team_api_id
),
league_min AS (
