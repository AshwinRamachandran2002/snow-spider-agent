```sql
--Description (thinking process):
-- Goal: For every league, return exactly ONE team that has the fewest total match-wins (home + away)
--       across all seasons.  If several teams tie, choose the one with the smallest team_api_id so
--       the result is deterministic.
--
-- Steps inside the CTEs:
-- 1) wins_raw      – Each individual win, represented by (league_id, winning team_api_id).
-- 2) win_totals    – Count wins per (league, team).
-- 3) league_min    – Minimum win total observed inside each league.
-- 4) pick_one      – For leagues where several teams share that minimum, keep only the team whose
--                    team_api_id is the smallest (tie-break rule).
-- The final SELECT joins to League and Team to print readable names plus the win count.

WITH wins_raw AS (
    -- every home win
    SELECT league_id,
           home_team_api_id AS team_api_id
    FROM   Match
    WHERE  home_team_goal > away_team_goal
    UNION ALL
    -- every away win
    SELECT league_id,
           away_team_api_id
    FROM   Match
    WHERE  away_team_goal > home_team_goal
),
win_totals AS (
    SELECT league_id,
           team_api_id,
           COUNT(*) AS wins
    FROM   wins_raw
    GROUP BY league_id, team_api_id
),
league_min AS (
    SELECT league_id,
           MIN(wins) AS min_wins
    FROM   win_totals
    GROUP BY league_id
),
pick_one AS (
    SELECT wt.league_id,
           MIN(wt.team_api_id) AS team_api_id      -- tie-break via smallest id
    FROM   win_totals wt
    JOIN   league_min lm
           ON  lm.league_id = wt.league_id
           AND lm.min_wins  = wt.wins
    GROUP BY wt.league_id
)
SELECT lg.name           AS league_name,
       tm.team_long_name AS team_name,
       wt.wins           AS total_wins
FROM   pick_one p
JOIN   win_totals wt ON wt.league_id   = p.league_id
                     AND wt.team_api_id = p.team_api_id
JOIN   League lg     ON lg.id           = p.league_id
JOIN   Team   tm     ON tm.team_api_id  = p.team_api_id
ORDER BY lg.name;
```
