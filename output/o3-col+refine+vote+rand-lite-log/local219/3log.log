-- 9. Description:  Same as #8, but attach human-readable league & team names for the final answer
WITH per_team AS (
     SELECT a."league_id",
            a."team_api_id",
            COALESCE(w."wins",0) AS "total_wins"
     FROM (
          SELECT "league_id","home_team_api_id" AS "team_api_id" FROM "Match"
          UNION
          SELECT "league_id","away_team_api_id" FROM "Match"
     ) a
     LEFT JOIN (
          SELECT "league_id","team_api_id",COUNT(*) AS "wins"
          FROM (
               SELECT "league_id","home_team_api_id" AS "team_api_id"
               FROM "Match" WHERE "home_team_goal" > "away_team_goal"
               UNION ALL
               SELECT "league_id","away_team_api_id"
               FROM "Match" WHERE "away_team_goal" > "home_team_goal"
          )
          GROUP BY "league_id","team_api_id"
     ) w
     ON a."league_id"=w."league_id" AND a."team_api_id"=w."team_api_id"
),
min_per_league AS (
     SELECT "league_id", MIN("total_wins") AS "min_wins"
     FROM   per_team
     GROUP  BY "league_id"
),
one_loser AS (
     SELECT p."league_id",
            p."team_api_id",
            p."total_wins"
