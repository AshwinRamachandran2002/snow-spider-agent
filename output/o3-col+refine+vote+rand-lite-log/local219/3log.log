```sql
-- 1. Description:  List all available leagues (id & name) to understand the universe we will work on
SELECT DISTINCT "id", "name"
FROM "League"
LIMIT 20;
```

```sql
-- 2. Description:  Peek at a few matches (one per league if possible) with goals & team ids  
SELECT DISTINCT "id",
       "league_id",
       "home_team_api_id",
       "away_team_api_id",
       "home_team_goal",
       "away_team_goal"
FROM "Match"
ORDER BY "league_id", "id"
LIMIT 20;
```

```sql
-- 3. Description:  Count wins that occurred **only** when the HOME side scored more  
SELECT "league_id",
       "home_team_api_id"   AS "team_api_id",
       COUNT(*)             AS "home_wins"
FROM   "Match"
WHERE  "home_team_goal" > "away_team_goal"
GROUP  BY "league_id", "home_team_api_id"
LIMIT 20;
```

```sql
-- 4. Description:  Count wins that occurred **only** when the AWAY side scored more  
SELECT "league_id",
       "away_team_api_id"   AS "team_api_id",
       COUNT(*)             AS "away_wins"
FROM   "Match"
WHERE  "away_team_goal" > "home_team_goal"
GROUP  BY "league_id", "away_team_api_id"
LIMIT 20;
```

```sql
-- 5. Description:  UNION the two previous result sets to have every win recorded once  
SELECT "league_id",
       "team_api_id",
       1 AS "win_flag"
FROM (
      SELECT "league_id", "home_team_api_id" AS "team_api_id"
      FROM   "Match"
      WHERE  "home_team_goal" > "away_team_goal"
      UNION ALL
      SELECT "league_id", "away_team_api_id" AS "team_api_id"
      FROM   "Match"
      WHERE  "away_team_goal" > "home_team_goal"
) 
LIMIT 20;
```

```sql
-- 6. Description:  Aggregate total wins per team in each league, including teams with zero wins
--                  The LEFT JOIN pulls in every team that ever appeared in a match
WITH all_appearances AS (
     SELECT "league_id", "home_team_api_id" AS "team_api_id" FROM "Match"
     UNION
     SELECT "league_id", "away_team_api_id" FROM "Match"
),
wins AS (
     SELECT "league_id",
            "team_api_id",
            COUNT(*) AS "wins"
     FROM   (
            SELECT "league_id", "home_team_api_id" AS "team_api_id"
            FROM   "Match"
            WHERE  "home_team_goal" > "away_team_goal"
            UNION ALL
            SELECT "league_id", "away_team_api_id"
            FROM   "Match"
            WHERE  "away_team_goal" > "home_team_goal"
     )
     GROUP BY "league_id","team_api_id"
)
SELECT a."league_id",
       a."team_api_id",
       COALESCE(w."wins",0) AS "total_wins"
FROM   all_appearances AS a
LEFT JOIN wins            AS w
       ON a."league_id"   = w."league_id"
      AND a."team_api_id" = w."team_api_id"
GROUP BY a."league_id", a."team_api_id"
LIMIT 20;
```

```sql
-- 7. Description:  For every league, discover the smallest win total any team reached
WITH per_team AS (
     /* identical block as previous query but without LIMIT */
     SELECT a."league_id",
            a."team_api_id",
            COALESCE(w."wins",0) AS "total_wins"
     FROM (
          SELECT "league_id","home_team_api_id" AS "team_api_id" FROM "Match"
          UNION
          SELECT "league_id","away_team_api_id" FROM "Match"
     ) a
     LEFT JOIN (
          SELECT "league_id","team_api_id",COUNT(*) AS "wins"
          FROM (
               SELECT "league_id","home_team_api_id" AS "team_api_id"
               FROM "Match" WHERE "home_team_goal" > "away_team_goal"
               UNION ALL
               SELECT "league_id","away_team_api_id"
               FROM "Match" WHERE "away_team_goal" > "home_team_goal"
          )
          GROUP BY "league_id","team_api_id"
     ) w
     ON a."league_id"=w."league_id" AND a."team_api_id"=w."team_api_id"
)
SELECT "league_id",
       MIN("total_wins") AS "min_wins"
FROM   per_team
GROUP  BY "league_id"
LIMIT 20;
```

```sql
-- 8. Description:  Pick ONE (tie-broken by smallest team_api_id) team that owns that minimum per league
WITH per_team AS (
     SELECT a."league_id",
            a."team_api_id",
            COALESCE(w."wins",0) AS "total_wins"
     FROM (
          SELECT "league_id","home_team_api_id" AS "team_api_id" FROM "Match"
          UNION
          SELECT "league_id","away_team_api_id" FROM "Match"
     ) a
     LEFT JOIN (
          SELECT "league_id","team_api_id",COUNT(*) AS "wins"
          FROM (
               SELECT "league_id","home_team_api_id" AS "team_api_id"
               FROM "Match" WHERE "home_team_goal" > "away_team_goal"
               UNION ALL
               SELECT "league_id","away_team_api_id"
               FROM "Match" WHERE "away_team_goal" > "home_team_goal"
          )
          GROUP BY "league_id","team_api_id"
     ) w
     ON a."league_id"=w."league_id" AND a."team_api_id"=w."team_api_id"
),
min_per_league AS (
     SELECT "league_id", MIN("total_wins") AS "min_wins"
     FROM   per_team
     GROUP  BY "league_id"
)
SELECT p."league_id",
       p."team_api_id",
       p."total_wins"
FROM   per_team        AS p
JOIN   min_per_league  AS m
       ON p."league_id" = m."league_id"
      AND p."total_wins"= m."min_wins"
GROUP  BY p."league_id"           -- keeps one row per league (ties auto-resolved by GROUP BY rule)
ORDER BY p."league_id"
LIMIT 20;
```

```sql
-- 9. Description:  Same as #8, but attach human-readable league & team names for the final answer
WITH per_team AS (
     SELECT a."league_id",
            a."team_api_id",
            COALESCE(w."wins",0) AS "total_wins"
     FROM (
          SELECT "league_id","home_team_api_id" AS "team_api_id" FROM "Match"
          UNION
          SELECT "league_id","away_team_api_id" FROM "Match"
     ) a
     LEFT JOIN (
          SELECT "league_id","team_api_id",COUNT(*) AS "wins"
          FROM (
               SELECT "league_id","home_team_api_id" AS "team_api_id"
               FROM "Match" WHERE "home_team_goal" > "away_team_goal"
               UNION ALL
               SELECT "league_id","away_team_api_id"
               FROM "Match" WHERE "away_team_goal" > "home_team_goal"
          )
          GROUP BY "league_id","team_api_id"
     ) w
     ON a."league_id"=w."league_id" AND a."team_api_id"=w."team_api_id"
),
min_per_league AS (
     SELECT "league_id", MIN("total_wins") AS "min_wins"
     FROM   per_team
     GROUP  BY "league_id"
),
one_loser AS (
     SELECT p."league_id",
            p."team_api_id",
            p."total_wins"
     FROM   per_team AS p
     JOIN   min_per_league AS m
       ON   p."league_id" = m."league_id"
      AND   p."total_wins"= m."min_wins"
     GROUP  BY p."league_id"          -- tie-breaker: lowest team_api_id kept
)
SELECT l."name"            AS "league_name",
       t."team_long_name"  AS "team_with_fewest_wins",
       o."total_wins"
FROM   one_loser o
JOIN   "League" l ON l."id"          = o."league_id"
JOIN   "Team"   t ON t."team_api_id" = o."team_api_id"
ORDER  BY l."id"
LIMIT 20;
```
