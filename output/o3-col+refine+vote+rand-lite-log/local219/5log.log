-- 8. Pick ONE team (ties broken by the smallest team_api_id) that has that
--    minimum number of wins in each league.
SELECT  t."league_id",
        MIN(t."team_api_id") AS "team_api_id",  -- tie-break
        t."wins"
FROM   (
         -- same derived table as in query 6
         SELECT  l."league_id",
                 l."team_api_id",
                 COALESCE(w."wins", 0) AS "wins"
         FROM  (
                 SELECT DISTINCT m."league_id", m."home_team_api_id" AS "team_api_id"
                 FROM   "Match" AS m
                 UNION
                 SELECT DISTINCT m."league_id", m."away_team_api_id"
                 FROM   "Match" AS m
               ) AS l
         LEFT JOIN (
                   SELECT  w."league_id",
                           w."winner_team_api_id" AS "team_api_id",
                           COUNT(*)               AS "wins"
                   FROM   (
                           SELECT  m."league_id",
                                   CASE
                                       WHEN m."home_team_goal" > m."away_team_goal" THEN m."home_team_api_id"
                                       WHEN m."home_team_goal" < m."away_team_goal" THEN m."away_team_api_id"
                                   END AS "winner_team_api_id"
                           FROM   "Match" AS m
                           WHERE  m."home_team_goal" <> m."away_team_goal"
                          ) AS w
                   GROUP BY w."league_id", w."winner_team_api_id"
                 ) AS w
         ON   l."league_id" = w."league_id" AND l."team_api_id" = w."team_api_id"
       ) AS t
JOIN  (
        -- min wins per league from query 7
        SELECT  t2."league_id",
                MIN(t2."wins") AS "min_wins"
        FROM   (
                 SELECT  l."league_id",
                         l."team_api_id",
                         COALESCE(w."wins", 0) AS "wins"
                 FROM  (
                         SELECT DISTINCT m."league_id", m."home_team_api_id" AS "team_api_id"
                         FROM   "Match" AS m
                         UNION
                         SELECT DISTINCT m."league_id", m."away_team_api_id"
                         FROM   "Match" AS m
                       ) AS l
                 LEFT JOIN (
                           SELECT  w."league_id",
                                   w."winner_team_api_id" AS "team_api_id",
                                   COUNT(*)               AS "wins"
                           FROM   (
                                   SELECT  m."league_id",
                                           CASE
                                               WHEN m."home_team_goal" > m."away_team_goal" THEN m."home_team_api_id"
                                               WHEN m."home_team_goal" < m."away_team_goal" THEN m."away_team_api_id"
                                           END AS "winner_team_api_id"
                                   FROM   "Match" AS m
                                   WHERE  m."home_team_goal" <> m."away_team_goal"
                                  ) AS w
                           GROUP BY w."league_id", w."winner_team_api_id"
                         ) AS w
                 ON   l."league_id" = w."league_id" AND l."team_api_id" = w."team_api_id"
               ) AS t2
        GROUP BY t2."league_id"
      ) AS m
ON  t."league_id" = m."league_id" AND t."wins" = m."min_wins"
GROUP BY t."league_id"
LIMIT 20;
