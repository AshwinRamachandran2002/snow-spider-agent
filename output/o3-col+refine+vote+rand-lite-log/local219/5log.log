```sql
-- 1. List the (id, name) of the leagues that exist in the data set.
SELECT DISTINCT "id", "name"
FROM "League"
LIMIT 20;
```

```sql
-- 2. Inspect a few matches together with their league, the two teams that played
--    and the goals they scored.
SELECT  m."id",
        m."league_id",
        m."home_team_api_id",
        m."away_team_api_id",
        m."home_team_goal",
        m."away_team_goal"
FROM    "Match" AS m
LIMIT 20;
```

```sql
-- 3. Work out who won every match (1 ‑ home win, 2 ‑ away win, 0 ‑ draw).
SELECT  m."id",
        CASE
            WHEN m."home_team_goal" > m."away_team_goal" THEN 1
            WHEN m."home_team_goal" < m."away_team_goal" THEN 2
            ELSE 0
        END                                           AS "winner_flag"
FROM    "Match" AS m
LIMIT 20;
```

```sql
-- 4. Build a list of every WIN that occurred in the data set, giving the
--    winning team_api_id and the league in which it happened.
SELECT  m."league_id",
        CASE
            WHEN m."home_team_goal" > m."away_team_goal" THEN m."home_team_api_id"
            WHEN m."home_team_goal" < m."away_team_goal" THEN m."away_team_api_id"
        END                                           AS "winner_team_api_id"
FROM    "Match" AS m
WHERE   m."home_team_goal" <> m."away_team_goal"      -- ignore draws
LIMIT 20;
```

```sql
-- 5. Count total wins for every (league_id, team_api_id) pair across ALL seasons.
SELECT  w."league_id",
        w."winner_team_api_id"       AS "team_api_id",
        COUNT(*)                     AS "wins"
FROM   ( SELECT  m."league_id",
                 CASE
                     WHEN m."home_team_goal" > m."away_team_goal" THEN m."home_team_api_id"
                     WHEN m."home_team_goal" < m."away_team_goal" THEN m."away_team_api_id"
                 END AS "winner_team_api_id"
         FROM   "Match" AS m
         WHERE  m."home_team_goal" <> m."away_team_goal"
       ) AS w
GROUP  BY w."league_id", w."winner_team_api_id"
LIMIT 20;
```

```sql
-- 6. List every team that ever appeared in a match of a league, whether or not
--    it won, then LEFT JOIN the win-counts from step 5 so that teams with
--    zero wins get NULL (to be coalesced to 0).
SELECT  l."league_id",
        l."team_api_id",
        COALESCE(w."wins", 0) AS "wins"
FROM  (
        SELECT DISTINCT m."league_id", m."home_team_api_id" AS "team_api_id"
        FROM   "Match" AS m
        UNION
        SELECT DISTINCT m."league_id", m."away_team_api_id"
        FROM   "Match" AS m
      ) AS l
LEFT JOIN (
        SELECT  w."league_id",
                w."winner_team_api_id" AS "team_api_id",
                COUNT(*)               AS "wins"
        FROM   (
                SELECT  m."league_id",
                        CASE
                            WHEN m."home_team_goal" > m."away_team_goal" THEN m."home_team_api_id"
                            WHEN m."home_team_goal" < m."away_team_goal" THEN m."away_team_api_id"
                        END AS "winner_team_api_id"
                FROM   "Match" AS m
                WHERE  m."home_team_goal" <> m."away_team_goal"
               ) AS w
        GROUP BY w."league_id", w."winner_team_api_id"
      ) AS w
ON   l."league_id" = w."league_id" AND l."team_api_id" = w."team_api_id"
LIMIT 20;
```

```sql
-- 7. For every league find the minimum number of wins achieved by any team.
SELECT  t."league_id",
        MIN(t."wins") AS "min_wins_in_league"
FROM    (
          -- the derived table from query 6 (abbreviated here for brevity)
          SELECT  l."league_id",
                  l."team_api_id",
                  COALESCE(w."wins", 0) AS "wins"
          FROM  (
                  SELECT DISTINCT m."league_id", m."home_team_api_id" AS "team_api_id"
                  FROM   "Match" AS m
                  UNION
                  SELECT DISTINCT m."league_id", m."away_team_api_id"
                  FROM   "Match" AS m
                ) AS l
          LEFT JOIN (
                    SELECT  w."league_id",
                            w."winner_team_api_id" AS "team_api_id",
                            COUNT(*)               AS "wins"
                    FROM   (
                            SELECT  m."league_id",
                                    CASE
                                        WHEN m."home_team_goal" > m."away_team_goal" THEN m."home_team_api_id"
                                        WHEN m."home_team_goal" < m."away_team_goal" THEN m."away_team_api_id"
                                    END AS "winner_team_api_id"
                            FROM   "Match" AS m
                            WHERE  m."home_team_goal" <> m."away_team_goal"
                           ) AS w
                    GROUP BY w."league_id", w."winner_team_api_id"
                  ) AS w
          ON   l."league_id" = w."league_id" AND l."team_api_id" = w."team_api_id"
        ) AS t
GROUP BY t."league_id"
LIMIT 20;
```

```sql
-- 8. Pick ONE team (ties broken by the smallest team_api_id) that has that
--    minimum number of wins in each league.
SELECT  t."league_id",
        MIN(t."team_api_id") AS "team_api_id",  -- tie-break
        t."wins"
FROM   (
         -- same derived table as in query 6
         SELECT  l."league_id",
                 l."team_api_id",
                 COALESCE(w."wins", 0) AS "wins"
         FROM  (
                 SELECT DISTINCT m."league_id", m."home_team_api_id" AS "team_api_id"
                 FROM   "Match" AS m
                 UNION
                 SELECT DISTINCT m."league_id", m."away_team_api_id"
                 FROM   "Match" AS m
               ) AS l
         LEFT JOIN (
                   SELECT  w."league_id",
                           w."winner_team_api_id" AS "team_api_id",
                           COUNT(*)               AS "wins"
                   FROM   (
                           SELECT  m."league_id",
                                   CASE
                                       WHEN m."home_team_goal" > m."away_team_goal" THEN m."home_team_api_id"
                                       WHEN m."home_team_goal" < m."away_team_goal" THEN m."away_team_api_id"
                                   END AS "winner_team_api_id"
                           FROM   "Match" AS m
                           WHERE  m."home_team_goal" <> m."away_team_goal"
                          ) AS w
                   GROUP BY w."league_id", w."winner_team_api_id"
                 ) AS w
         ON   l."league_id" = w."league_id" AND l."team_api_id" = w."team_api_id"
       ) AS t
JOIN  (
        -- min wins per league from query 7
        SELECT  t2."league_id",
                MIN(t2."wins") AS "min_wins"
        FROM   (
                 SELECT  l."league_id",
                         l."team_api_id",
                         COALESCE(w."wins", 0) AS "wins"
                 FROM  (
                         SELECT DISTINCT m."league_id", m."home_team_api_id" AS "team_api_id"
                         FROM   "Match" AS m
                         UNION
                         SELECT DISTINCT m."league_id", m."away_team_api_id"
                         FROM   "Match" AS m
                       ) AS l
                 LEFT JOIN (
                           SELECT  w."league_id",
                                   w."winner_team_api_id" AS "team_api_id",
                                   COUNT(*)               AS "wins"
                           FROM   (
                                   SELECT  m."league_id",
                                           CASE
                                               WHEN m."home_team_goal" > m."away_team_goal" THEN m."home_team_api_id"
                                               WHEN m."home_team_goal" < m."away_team_goal" THEN m."away_team_api_id"
                                           END AS "winner_team_api_id"
                                   FROM   "Match" AS m
                                   WHERE  m."home_team_goal" <> m."away_team_goal"
                                  ) AS w
                           GROUP BY w."league_id", w."winner_team_api_id"
                         ) AS w
                 ON   l."league_id" = w."league_id" AND l."team_api_id" = w."team_api_id"
               ) AS t2
        GROUP BY t2."league_id"
      ) AS m
ON  t."league_id" = m."league_id" AND t."wins" = m."min_wins"
GROUP BY t."league_id"
LIMIT 20;
```

```sql
-- 9. Add human-readable names for the leagues and teams.
SELECT  lg."name"                       AS "league_name",
        tm."team_long_name"             AS "team_name",
        r."wins"                        AS "total_wins"
FROM  (
        -- result set from query 8
        SELECT  t."league_id",
                MIN(t."team_api_id") AS "team_api_id",
                t."wins"
        FROM   (
                 SELECT  l."league_id",
                         l."team_api_id",
                         COALESCE(w."wins", 0) AS "wins"
                 FROM  (
                         SELECT DISTINCT m."league_id", m."home_team_api_id" AS "team_api_id"
                         FROM   "Match" AS m
                         UNION
                         SELECT DISTINCT m."league_id", m."away_team_api_id"
                         FROM   "Match" AS m
                       ) AS l
                 LEFT JOIN (
                           SELECT  w."league_id",
                                   w."winner_team_api_id" AS "team_api_id",
                                   COUNT(*)               AS "wins"
                           FROM   (
                                   SELECT  m."league_id",
                                           CASE
                                               WHEN m."home_team_goal" > m."away_team_goal" THEN m."home_team_api_id"
                                               WHEN m."home_team_goal" < m."away_team_goal" THEN m."away_team_api_id"
                                           END AS "winner_team_api_id"
                                   FROM   "Match" AS m
                                   WHERE  m."home_team_goal" <> m."away_team_goal"
                                  ) AS w
                           GROUP BY w."league_id", w."winner_team_api_id"
                         ) AS w
                 ON   l."league_id" = w."league_id" AND l."team_api_id" = w."team_api_id"
               ) AS t
        JOIN  (
                 SELECT  t2."league_id",
                         MIN(t2."wins") AS "min_wins"
                 FROM   (
                          SELECT  l."league_id",
                                  l."team_api_id",
                                  COALESCE(w."wins", 0) AS "wins"
                          FROM  (
                                  SELECT DISTINCT m."league_id", m."home_team_api_id" AS "team_api_id"
                                  FROM   "Match" AS m
                                  UNION
                                  SELECT DISTINCT m."league_id", m."away_team_api_id"
                                  FROM   "Match" AS m
                                ) AS l
                          LEFT JOIN (
                                    SELECT  w."league_id",
                                            w."winner_team_api_id" AS "team_api_id",
                                            COUNT(*)               AS "wins"
                                    FROM   (
                                            SELECT  m."league_id",
                                                    CASE
                                                        WHEN m."home_team_goal" > m."away_team_goal" THEN m."home_team_api_id"
                                                        WHEN m."home_team_goal" < m."away_team_goal" THEN m."away_team_api_id"
                                                    END AS "winner_team_api_id"
                                            FROM   "Match" AS m
                                            WHERE  m."home_team_goal" <> m."away_team_goal"
                                           ) AS w
                                    GROUP BY w."league_id", w."winner_team_api_id"
                                  ) AS w
                          ON   l."league_id" = w."league_id" AND l."team_api_id" = w."team_api_id"
                        ) AS t2
                 GROUP BY t2."league_id"
              ) AS m
        ON  t."league_id" = m."league_id" AND t."wins" = m."min_wins"
        GROUP BY t."league_id"
      ) AS r
JOIN "League" AS lg   ON lg."id"  = r."league_id"
JOIN "Team"   AS tm   ON tm."team_api_id" = r."team_api_id"
LIMIT 20;
