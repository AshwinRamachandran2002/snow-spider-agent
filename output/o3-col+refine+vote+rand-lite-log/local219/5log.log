Query:
-- 7. For every league find the minimum number of wins achieved by any team.
SELECT  t."league_id",
        MIN(t."wins") AS "min_wins_in_league"
FROM    (
          -- the derived table from query 6 (abbreviated here for brevity)
          SELECT  l."league_id",
                  l."team_api_id",
                  COALESCE(w."wins", 0) AS "wins"
          FROM  (
                  SELECT DISTINCT m."league_id", m."home_team_api_id" AS "team_api_id"
                  FROM   "Match" AS m
                  UNION
                  SELECT DISTINCT m."league_id", m."away_team_api_id"
                  FROM   "Match" AS m
                ) AS l
          LEFT JOIN (
                    SELECT  w."league_id",
                            w."winner_team_api_id" AS "team_api_id",
                            COUNT(*)               AS "wins"
                    FROM   (
                            SELECT  m."league_id",
                                    CASE
                                        WHEN m."home_team_goal" > m."away_team_goal" THEN m."home_team_api_id"
                                        WHEN m."home_team_goal" < m."away_team_goal" THEN m."away_team_api_id"
                                    END AS "winner_team_api_id"
                            FROM   "Match" AS m
                            WHERE  m."home_team_goal" <> m."away_team_goal"
                           ) AS w
                    GROUP BY w."league_id", w."winner_team_api_id"
                  ) AS w
          ON   l."league_id" = w."league_id" AND l."team_api_id" = w."team_api_id"
        ) AS t
GROUP BY t."league_id"
LIMIT 20;
