                         SELECT DISTINCT m."league_id", m."away_team_api_id"
                         FROM   "Match" AS m
                       ) AS l
                 LEFT JOIN (
                           SELECT  w."league_id",
                                   w."winner_team_api_id" AS "team_api_id",
                                   COUNT(*)               AS "wins"
                           FROM   (
                                   SELECT  m."league_id",
                                           CASE
                                               WHEN m."home_team_goal" > m."away_team_goal" THEN m."home_team_api_id"
                                               WHEN m."home_team_goal" < m."away_team_goal" THEN m."away_team_api_id"
                                           END AS "winner_team_api_id"
                                   FROM   "Match" AS m
                                   WHERE  m."home_team_goal" <> m."away_team_goal"
                                  ) AS w
                           GROUP BY w."league_id", w."winner_team_api_id"
                         ) AS w
                 ON   l."league_id" = w."league_id" AND l."team_api_id" = w."team_api_id"
               ) AS t
        JOIN  (
                 SELECT  t2."league_id",
                         MIN(t2."wins") AS "min_wins"
                 FROM   (
                          SELECT  l."league_id",
                                  l."team_api_id",
                                  COALESCE(w."wins", 0) AS "wins"
                          FROM  (
                                  SELECT DISTINCT m."league_id", m."home_team_api_id" AS "team_api_id"
                                  FROM   "Match" AS m
                                  UNION
                                  SELECT DISTINCT m."league_id", m."away_team_api_id"
                                  FROM   "Match" AS m
                                ) AS l
                          LEFT JOIN (
                                    SELECT  w."league_id",
                                            w."winner_team_api_id" AS "team_api_id",
                                            COUNT(*)               AS "wins"
                                    FROM   (
                                            SELECT  m."league_id",
                                                    CASE
                                                        WHEN m."home_team_goal" > m."away_team_goal" THEN m."home_team_api_id"
                                                        WHEN m."home_team_goal" < m."away_team_goal" THEN m."away_team_api_id"
                                                    END AS "winner_team_api_id"
                                            FROM   "Match" AS m
                                            WHERE  m."home_team_goal" <> m."away_team_goal"
                                           ) AS w
                                    GROUP BY w."league_id", w."winner_team_api_id"
                                  ) AS w
                          ON   l."league_id" = w."league_id" AND l."team_api_id" = w."team_api_id"
                        ) AS t2
                 GROUP BY t2."league_id"
              ) AS m
        ON  t."league_id" = m."league_id" AND t."wins" = m."min_wins"
        GROUP BY t."league_id"
      ) AS r
JOIN "League" AS lg   ON lg."id"  = r."league_id"
JOIN "Team"   AS tm   ON tm."team_api_id" = r."team_api_id";
