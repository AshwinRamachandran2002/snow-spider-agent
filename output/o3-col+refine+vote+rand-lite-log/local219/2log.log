-- Description: 9)  ONE representative team per league with the fewest wins
--                 (ties resolved alphabetically); join league name too.
SELECT r.league_id,
       l.name                    AS league_name,
       MIN(r.team_long_name)     AS team_with_fewest_wins,
       r.min_wins
FROM (
       SELECT s.league_id,
              s.team_long_name,
              s.wins,
              m_min.min_wins
       FROM  (
               SELECT m.league_id,
                      t.team_long_name,
                      SUM(CASE WHEN m.home_team_api_id = t.team_api_id 
                                   AND m.home_team_goal  > m.away_team_goal THEN 1
                               WHEN m.away_team_api_id = t.team_api_id 
                                   AND m.away_team_goal  > m.home_team_goal THEN 1
                               ELSE 0 END)              AS wins
               FROM   Team  AS t
               LEFT  JOIN Match AS m
                      ON (t.team_api_id = m.home_team_api_id 
                       OR t.team_api_id = m.away_team_api_id)
               WHERE  m.league_id IS NOT NULL
               GROUP  BY m.league_id,
                         t.team_long_name
             ) AS s
       JOIN (
              SELECT league_id,
                     MIN(wins) AS min_wins
              FROM  (
                      SELECT m.league_id,
                             t.team_long_name,
                             SUM(CASE WHEN m.home_team_api_id = t.team_api_id 
                                          AND m.home_team_goal  > m.away_team_goal THEN 1
                                      WHEN m.away_team_api_id = t.team_api_id 
                                          AND m.away_team_goal  > m.home_team_goal THEN 1
                                      ELSE 0 END)        AS wins
                      FROM   Team  AS t
                      LEFT  JOIN Match AS m
                             ON (t.team_api_id = m.home_team_api_id 
                              OR t.team_api_id = m.away_team_api_id)
                      WHERE  m.league_id IS NOT NULL
                      GROUP  BY m.league_id,
                                t.team_long_name
                    )
              GROUP BY league_id
            ) AS m_min
         ON s.league_id = m_min.league_id
        AND s.wins      = m_min.min_wins
     ) AS r
JOIN  League AS l
  ON r.league_id = l.id
GROUP BY r.league_id
LIMIT 20;
