2025-05-05 03:16:58 - Thread-1830 (execute) - INFO - [Exploration]
Below are 10 exploratory → analytical queries that gradually lead to the final answer
(traffic-accident rate per 100,000 population and the five states with the highest
rates in 2015 and 2016).

```sql
-- 1.  Peek at the possible “driver distraction” labels recorded in 2015
SELECT DISTINCT `driver_distracted_by_name`
FROM   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
LIMIT  20;
```

```sql
-- 2.  Do the same for 2016 to be sure the wording of the labels is identical
SELECT DISTINCT `driver_distracted_by_name`
FROM   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
LIMIT  20;
```

```sql
-- 3.  Count DRIVER rows (not crashes yet) that are really “distracted” in 2015
SELECT state_number,
       COUNT(*) AS driver_rows_kept
FROM   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
WHERE  LOWER(driver_distracted_by_name) NOT IN
       ('not distracted','unknown if distracted','not reported')
GROUP  BY state_number
ORDER  BY driver_rows_kept DESC
LIMIT  20;
```

```sql
-- 4.  Count DISTINCT crashes (consecutive_number) that involve
--     ≥1 distracted driver in 2015  ─ this is the base “accident” count
SELECT state_number,
       COUNT(DISTINCT consecutive_number) AS accidents_2015
FROM   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
WHERE  LOWER(driver_distracted_by_name) NOT IN
       ('not distracted','unknown if distracted','not reported')
GROUP  BY state_number
ORDER  BY accidents_2015 DESC
LIMIT  20;
```

```sql
-- 5.  Inspect ZIP-code prefixes (first two digits) found in the
--     2010 Census population table – we will need them for a ZIP→state mapping
SELECT DISTINCT SUBSTR(zipcode,1,2) AS zip2
FROM   `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
ORDER  BY zip2
LIMIT  20;
```

```sql
-- 6.  Build a light-weight ZIP-prefix→state-number lookup on-the-fly,
--     then aggregate 2010 population to the STATE level.
--     (Only two-digit prefixes are used here for brevity; real work could refine them.)
WITH zip_prefix_map AS (
  SELECT * FROM UNNEST([
    STRUCT(1  AS state_number, 35 AS p_lo, 36 AS p_hi), -- AL
    STRUCT(2  AS state_number, 99 AS p_lo, 99 AS p_hi), -- AK
    STRUCT(4  AS state_number, 85 AS p_lo, 86 AS p_hi), -- AZ
    STRUCT(5  AS state_number, 71 AS p_lo, 72 AS p_hi), -- AR
    STRUCT(6  AS state_number, 90 AS p_lo, 96 AS p_hi), -- CA
    STRUCT(8  AS state_number, 80 AS p_lo, 81 AS p_hi), -- CO
    STRUCT(9  AS state_number, 06 AS p_lo, 06 AS p_hi), -- CT
    STRUCT(10 AS state_number, 19 AS p_lo, 19 AS p_hi), -- DE
    STRUCT(11 AS state_number, 20 AS p_lo, 20 AS p_hi), -- DC
    STRUCT(12 AS state_number, 32 AS p_lo, 34 AS p_hi), -- FL
    STRUCT(13 AS state_number, 30 AS p_lo, 31 AS p_hi), -- GA
    STRUCT(15 AS state_number, 96 AS p_lo, 96 AS p_hi), -- HI
    STRUCT(16 AS state_number, 83 AS p_lo, 83 AS p_hi), -- ID
    STRUCT(17 AS state_number, 60 AS p_lo, 62 AS p_hi), -- IL
    STRUCT(18 AS state_number, 46 AS p_lo, 47 AS p_hi), -- IN
    STRUCT(19 AS state_number, 50 AS p_lo, 52 AS p_hi), -- IA
    STRUCT(20 AS state_number, 66 AS p_lo, 67 AS p_hi), -- KS
    STRUCT(21 AS state_number, 40 AS p_lo, 42 AS p_hi), -- KY
    STRUCT(22 AS state_number, 70 AS p_lo, 71 AS p_hi), -- LA
    STRUCT(23 AS state_number, 04 AS p_lo, 04 AS p_hi), -- ME
    STRUCT(24 AS state_number, 21 AS p_lo, 21 AS p_hi), -- MD
    STRUCT(25 AS state_number, 01 AS p_lo, 02 AS p_hi), -- MA
    STRUCT(26 AS state_number, 48 AS p_lo, 49 AS p_hi), -- MI
    STRUCT(27 AS state_number, 55 AS p_lo, 56 AS p_hi), -- MN
    STRUCT(28 AS state_number, 38 AS p_lo, 39 AS p_hi), -- MS
    STRUCT(29 AS state_number, 63 AS p_lo, 65 AS p_hi), -- MO
    STRUCT(30 AS state_number, 59 AS p_lo, 59 AS p_hi), -- MT
    STRUCT(31 AS state_number, 68 AS p_lo, 69 AS p_hi), -- NE
    STRUCT(32 AS state_number, 89 AS p_lo, 89 AS p_hi), -- NV
    STRUCT(33 AS state_number, 03 AS p_lo, 03 AS p_hi), -- NH
    STRUCT(34 AS state_number, 07 AS p_lo, 08 AS p_hi), -- NJ
    STRUCT(35 AS state_number, 87 AS p_lo, 88 AS p_hi), -- NM
    STRUCT(36 AS state_number, 10 AS p_lo, 14 AS p_hi), -- NY
    STRUCT(37 AS state_number, 27 AS p_lo, 28 AS p_hi), -- NC
    STRUCT(38 AS state_number, 58 AS p_lo, 58 AS p_hi), -- ND
    STRUCT(39 AS state_number, 43 AS p_lo, 45 AS p_hi), -- OH
    STRUCT(40 AS state_number, 73 AS p_lo, 74 AS p_hi), -- OK
    STRUCT(41 AS state_number, 97 AS p_lo, 97 AS p_hi), -- OR
    STRUCT(42 AS state_number, 15 AS p_lo, 19 AS p_hi), -- PA
    STRUCT(44 AS state_number, 02 AS p_lo, 02 AS p_hi), -- RI
    STRUCT(45 AS state_number, 29 AS p_lo, 29 AS p_hi), -- SC
    STRUCT(46 AS state_number, 57 AS p_lo, 57 AS p_hi), -- SD
    STRUCT(47 AS state_number, 37 AS p_lo, 38 AS p_hi), -- TN
    STRUCT(48 AS state_number, 75 AS p_lo, 79 AS p_hi), -- TX (main block)
    STRUCT(49 AS state_number, 84 AS p_lo, 84 AS p_hi), -- UT
    STRUCT(50 AS state_number, 05 AS p_lo, 05 AS p_hi), -- VT
    STRUCT(51 AS state_number, 22 AS p_lo, 24 AS p_hi), -- VA
    STRUCT(53 AS state_number, 98 AS p_lo, 98 AS p_hi), -- WA
    STRUCT(54 AS state_number, 24 AS p_lo, 25 AS p_hi), -- WV
    STRUCT(55 AS state_number, 53 AS p_lo, 54 AS p_hi), -- WI
    STRUCT(56 AS state_number, 82 AS p_lo, 82 AS p_hi)  -- WY
  ]) AS tmp
)
SELECT m.state_number,
       SUM(p.population) AS pop_2010
FROM   `bigquery-public-data.census_bureau_usa.population_by_zip_2010` p
JOIN   zip_prefix_map m
ON     CAST(SUBSTR(p.zipcode,1,2) AS INT64) BETWEEN m.p_lo AND m.p_hi
GROUP  BY m.state_number
ORDER  BY pop_2010 DESC
LIMIT  20;
```

```sql
-- 7.  “Accident” counts by state for 2015
SELECT state_number,
       COUNT(DISTINCT consecutive_number) AS accidents_2015
FROM   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
WHERE  LOWER(driver_distracted_by_name) NOT IN
       ('not distracted','unknown if distracted','not reported')
GROUP  BY state_number
ORDER  BY accidents_2015 DESC
LIMIT  20;
```

```sql
-- 8.  “Accident” counts by state for 2016 (join to drimpair_2016 just to
--     retrieve the state names that are missing in distract_2016)
SELECT d.state_number,
       di.state_name,
       COUNT(DISTINCT d.consecutive_number) AS accidents_2016
FROM   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`  AS d
LEFT   JOIN `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016` AS di
       USING (state_number)
WHERE  LOWER(d.driver_distracted_by_name) NOT IN
       ('not distracted','unknown if distracted','not reported')
GROUP  BY state_number, state_name
ORDER  BY accidents_2016 DESC
LIMIT  20;
```

```sql
-- 9.  Combine 2015 distracted-crash counts with 2010 population,
--     calculate accidents per 100,000 people and show TOP-5 states (2015)
WITH pop AS (
  -- the population-by-state CTE built in Query-6
  SELECT state_number, pop_2010
  FROM (
      /*  << copy/paste the body of Query-6 here >>  */
  )
),
acc AS (
  SELECT state_number,
         COUNT(DISTINCT consecutive_number) AS accidents_2015
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE  LOWER(driver_distracted_by_name) NOT IN
         ('not distracted','unknown if distracted','not reported')
  GROUP  BY state_number
)
SELECT a.state_number,
       ROUND( a.accidents_2015 * 100000.0 / p.pop_2010 , 2 )  AS accidents_per_100k_2015
FROM   acc a
JOIN   pop p USING(state_number)
ORDER  BY accidents_per_100k_2015 DESC
LIMIT  5;
```

```sql
-- 10.  Repeat for 2016 and output the states with the highest rates
WITH pop AS (
  /*  same population CTE as in Query-6  */
  SELECT state_number, pop_2010
  FROM (
      /*  << copy/paste the body of Query-6 here >>  */
  )
),
acc AS (
  SELECT state_number,
         COUNT(DISTINCT consecutive_number) AS accidents_2016
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
  WHERE  LOWER(driver_distracted_by_name) NOT IN
         ('not distracted','unknown if distracted','not reported')
  GROUP  BY state_number
)
SELECT a.state_number,
       ROUND( a.accidents_2016 * 100000.0 / p.pop_2010 , 2 )  AS accidents_per_100k_2016
FROM   acc a
JOIN   pop p USING(state_number)
ORDER  BY accidents_per_100k_2016 DESC
LIMIT  5;
```

The ten queries move from inspection of relevant fields, through construction of a
ZIP-prefix-based state-population table, to the final state-level traffic-accident
rates (per 100 k population) and the identification of the five highest-rate states
for both 2015 and 2016.
