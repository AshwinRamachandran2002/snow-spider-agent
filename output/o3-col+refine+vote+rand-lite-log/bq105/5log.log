```sql
/*  Driver-distraction traffic-accident rates (per 100 000 pop.)
    for 2015 and 2016, with TOP-5 flags for each year            */

WITH
/* ------------------------------------------------------------ */
/* 1.  2-digit ZIP-prefix ➜ state_number map                     */
/* ------------------------------------------------------------ */
zip_prefix_map AS (
  SELECT * FROM UNNEST([
    STRUCT( 1, 35, 36),  STRUCT( 2, 99, 99),  STRUCT( 4, 85, 86),
    STRUCT( 5, 71, 72),  STRUCT( 6, 90, 96),  STRUCT( 8, 80, 81),
    STRUCT( 9,  6,  6),  STRUCT(10, 19, 19),  STRUCT(11, 20, 20),
    STRUCT(12, 32, 34),  STRUCT(13, 30, 31),  STRUCT(15, 96, 96),
    STRUCT(16, 83, 83),  STRUCT(17, 60, 62),  STRUCT(18, 46, 47),
    STRUCT(19, 50, 52),  STRUCT(20, 66, 67),  STRUCT(21, 40, 42),
    STRUCT(22, 70, 71),  STRUCT(23,  4,  4),  STRUCT(24, 21, 21),
    STRUCT(25,  1,  2),  STRUCT(26, 48, 49),  STRUCT(27, 55, 56),
    STRUCT(28, 38, 39),  STRUCT(29, 63, 65),  STRUCT(30, 59, 59),
    STRUCT(31, 68, 69),  STRUCT(32, 89, 89),  STRUCT(33,  3,  3),
    STRUCT(34,  7,  8),  STRUCT(35, 87, 88),  STRUCT(36, 10, 14),
    STRUCT(37, 27, 28),  STRUCT(38, 58, 58),  STRUCT(39, 43, 45),
    STRUCT(40, 73, 74),  STRUCT(41, 97, 97),  STRUCT(42, 15, 19),
    STRUCT(44,  2,  2),  STRUCT(45, 29, 29),  STRUCT(46, 57, 57),
    STRUCT(47, 37, 38),  STRUCT(48, 75, 79),  STRUCT(49, 84, 84),
    STRUCT(50,  5,  5),  STRUCT(51, 22, 24),  STRUCT(53, 98, 98),
    STRUCT(54, 24, 25),  STRUCT(55, 53, 54),  STRUCT(56, 82, 82)
  ]) AS t(state_number, p_lo, p_hi)
),

/* ------------------------------------------------------------ */
/* 2.  2010 Census population by state                          */
/* ------------------------------------------------------------ */
state_pop AS (
  SELECT
    z.state_number,
    SUM(p.population) AS population_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010` p
  JOIN zip_prefix_map z
    ON CAST(SUBSTR(p.zipcode,1,2) AS INT64) BETWEEN z.p_lo AND z.p_hi
  GROUP BY z.state_number
),

/* ------------------------------------------------------------ */
/* 3.  State-number ➜ state-name (rename to state_nm)            */
/* ------------------------------------------------------------ */
state_names AS (
  SELECT DISTINCT
         state_number,
         state_name AS state_nm
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
),

/* ------------------------------------------------------------ */
/* 4.  Count crashes with ≥1 distracted driver (2015 & 2016)    */
/* ------------------------------------------------------------ */
accident_counts AS (
  SELECT
    state_number,
    CAST(_TABLE_SUFFIX AS INT64) AS year,
    COUNT(DISTINCT consecutive_number) AS accidents
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_201*`
  WHERE _TABLE_SUFFIX IN ('2015','2016')
    AND LOWER(driver_distracted_by_name) NOT IN
        ('not distracted','unknown if distracted','not reported')
  GROUP BY state_number, year
)

/* ------------------------------------------------------------ */
/* 5.  Final output with rates and TOP-5 indicator               */
/* ------------------------------------------------------------ */
SELECT
  a.year,
  COALESCE(n.state_nm, CONCAT('State ', CAST(a.state_number AS STRING)))
        AS state_name,
  a.state_number,
  a.accidents,
  ROUND(a.accidents / sp.population_2010 * 100000, 4) AS accidents_per_100k,
  RANK() OVER (PARTITION BY a.year
               ORDER BY a.accidents / sp.population_2010 DESC) AS rank_in_year,
  RANK() OVER (PARTITION BY a.year
               ORDER BY a.accidents / sp.population_2010 DESC) <= 5
        AS top_5_in_year
FROM accident_counts a
JOIN state_pop  sp ON sp.state_number = a.state_number
LEFT JOIN state_names n ON n.state_number = a.state_number
ORDER BY a.year, rank_in_year, a.state_number;
```
