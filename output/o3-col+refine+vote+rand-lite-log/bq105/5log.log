    STRUCT(49 , 84 , 84),  STRUCT(50 , 05 , 05),  STRUCT(51 , 22 , 24),
    STRUCT(53 , 98 , 98),  STRUCT(54 , 24 , 25),  STRUCT(55 , 53 , 54),
    STRUCT(56 , 82 , 82)
  ])
),
pop AS (
  SELECT m.state_number,
         SUM(p.population) AS pop_2010
  FROM   `bigquery-public-data.census_bureau_usa.population_by_zip_2010` p
  JOIN   zip_prefix_map m
         ON CAST(SUBSTR(p.zipcode,1,2) AS INT64) BETWEEN m.lo AND m.hi
  GROUP  BY m.state_number
),
acc AS (
  SELECT state_number,
         COUNT(DISTINCT consecutive_number) AS crashes_2015
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE  LOWER(driver_distracted_by_name) NOT IN
         ('not distracted','unknown if distracted','not reported')
  GROUP  BY state_number
),
state_lookup AS (
  SELECT DISTINCT state_number, state_name
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
)
SELECT
  sl.state_name,
  ROUND(acc.crashes_2015 * 100000.0 / pop.pop_2010, 2) AS accidents_per_100k_2015
FROM   acc
JOIN   pop            USING (state_number)
LEFT   JOIN state_lookup sl USING (state_number)
ORDER  BY accidents_per_100k_2015 DESC
LIMIT  5;
```
