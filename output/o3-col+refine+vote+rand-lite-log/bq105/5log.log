--Description:
-- The previous error arose because we joined with USING(state_number).  In BigQuery,
-- any column listed in USING is coalesced and can no longer be prefixed by an
-- alias.  Therefore the correct reference is just `state_name`, not `di.state_name`.
-- This query:
--   • joins the 2016 distraction table to the 2016 driver-impairment table
--     solely to fetch `state_name`;
--   • excludes the three “non-distracted” categories;
--   • counts DISTINCT crashes (consecutive_number) per state;
--   • returns the 20 states with the most such crashes in 2016.
SELECT
  d.state_number,
  state_name,                                   -- unqualified after USING()
  COUNT(DISTINCT d.consecutive_number) AS accidents_2016
FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`  AS d
LEFT JOIN `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016` AS di
       USING (state_number)
WHERE LOWER(d.driver_distracted_by_name) NOT IN
      ('not distracted','unknown if distracted','not reported')
GROUP BY d.state_number, state_name
ORDER BY accidents_2016 DESC
LIMIT 20;
