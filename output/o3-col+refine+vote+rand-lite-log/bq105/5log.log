    STRUCT(33 , 03 , 03),  STRUCT(34 , 07 , 08),  STRUCT(35 , 87 , 88),
    STRUCT(36 , 10 , 14),  STRUCT(37 , 27 , 28),  STRUCT(38 , 58 , 58),
    STRUCT(39 , 43 , 45),  STRUCT(40 , 73 , 74),  STRUCT(41 , 97 , 97),
