--Description (thinking process embedded):
-- 1.  The 2016 distracted-driver table (`distract_2016`) has state_number but no
--     state_name column.  We still want a human-readable name, so we must fetch
--     it elsewhere.
-- 2.  The 2015 impairment table (`drimpair_2015`) does include both state_number
--     and state_name for every state, so we can mine that once to create a tiny
--     lookup table (CTE `state_lookup`).
-- 3.  We then join the lookup to the 2016 distraction rows on state_number.
-- 4.  We exclude the three non-distracted categories: “Not Distracted”,
--     “Unknown if Distracted”, and “Not Reported”.
-- 5.  A “traffic accident” is defined as a distinct crash ID
--     (`consecutive_number`) that had at least one distracted driver, so we
--     COUNT DISTINCT consecutive_number per state.
-- 6.  Finally we order by that count and show the twenty states with the most
--     distracted-driver crashes in 2016.
WITH state_lookup AS (
  SELECT DISTINCT state_number, state_name
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
)
SELECT
  d.state_number,
  l.state_name,
  COUNT(DISTINCT d.consecutive_number) AS distracted_crashes_2016
FROM   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016` AS d
LEFT JOIN state_lookup AS l USING (state_number)
WHERE  LOWER(d.driver_distracted_by_name) NOT IN
      ('not distracted','unknown if distracted','not reported')
GROUP BY d.state_number, l.state_name
ORDER BY distracted_crashes_2016 DESC
LIMIT 20;
