JOIN state_map AS m USING (state_number)
WHERE LOWER(d.driver_distracted_by_name) NOT IN
      ('not distracted', 'unknown if distracted', 'not reported')
GROUP BY m.state_name
ORDER BY accident_cnt_2015 DESC
LIMIT 20;
