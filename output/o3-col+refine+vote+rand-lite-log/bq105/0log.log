--Description: drimpair_2016 has the numeric field `state_number` but no `state_name`.
--We therefore ① collect all distinct state_number values that appear in 2016 (CTE sixteen),
--② fetch a (state_number, state_name) lookup from drimpair_2015 (CTE lookup),
--③ join them so each 2016 state_number is paired with its state_name,
--and ④ return the resulting mapping, ordered by state_number, limited to 20 rows.
WITH sixteen AS (
  SELECT DISTINCT state_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`
),
lookup AS (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
)
SELECT
  s.state_number,
  l.state_name
FROM sixteen AS s
LEFT JOIN lookup AS l USING (state_number)
ORDER BY s.state_number
