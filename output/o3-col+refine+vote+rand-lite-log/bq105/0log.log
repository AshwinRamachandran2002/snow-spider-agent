2025-05-05 03:22:24 - Thread-1825 (execute) - INFO - [Try to run SQL in self-refine]
```sql
/*  Driver–distraction traffic-accident rates (per 100,000 residents)
    for 2015 and 2016 – five states with the highest rate each year          */

WITH
/* 1 ────────── build a “state code ⇢ state name” look-up from 2015 table   */
state_lookup AS (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
),

/* 2 ────────── all distraction-related crashes (exclude the three “null” labels) */
all_distraction_cases AS (
  -- 2015 --------------------------------------------------------------
  SELECT
      2015                                          AS year,
      state_number,
      state_name,
      consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE driver_distracted_by_name NOT IN
        ('Not Distracted','Unknown if Distracted','Not Reported')

  UNION ALL

  -- 2016 --------------------------------------------------------------
  SELECT
      2016                                          AS year,
      d16.state_number,
      sl.state_name,                                -- add state name via look-up
      d16.consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016` AS d16
  LEFT JOIN state_lookup AS sl USING(state_number)
  WHERE d16.driver_distracted_by_name NOT IN
        ('Not Distracted','Unknown if Distracted','Not Reported')
),

/* 3 ────────── 2010 Census population by state                             */
state_population_2010 AS (
  SELECT
      state                     AS state_name,
      SUM(population)           AS population_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_state_2010`
  GROUP BY state_name
),

/* 4 ────────── compute accidents-per-100k for every state / year           */
state_year_rates AS (
  SELECT
      ac.year,
      ac.state_name,
      COUNT(DISTINCT ac.consecutive_number)                  AS accidents,
      sp.population_2010,
      COUNT(DISTINCT ac.consecutive_number) * 100000.0
        / sp.population_2010                                 AS accidents_per_100k
  FROM all_distraction_cases AS ac
  JOIN state_population_2010 AS sp
        ON sp.state_name = ac.state_name
  GROUP BY ac.year, ac.state_name, sp.population_2010
),

/* 5 ────────── rank states within each year and keep top-5                 */
ranked AS (
  SELECT
      *,
      ROW_NUMBER() OVER (PARTITION BY year
                         ORDER BY accidents_per_100k DESC)   AS rn
  FROM state_year_rates
)

SELECT
    year,
    state_name,
    accidents,
    population_2010 AS population,
    ROUND(accidents_per_100k,4)  AS accidents_per_100k
FROM ranked
WHERE rn <= 5
ORDER BY year, accidents_per_100k DESC;
```
