```sql
-- 10. Final answer – top-5 states, per year, highest driver-distraction crash rate
WITH
-- === population 2010 by state (same logic) ===
z AS (
  SELECT CAST(SUBSTR(LPAD(zipcode,5,'0'),1,3) AS INT64) AS zip3, population
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
),
zip_state AS (
  SELECT
    CASE
      WHEN zip3 BETWEEN 350 AND 369 THEN 'Alabama'
      WHEN zip3 BETWEEN 995 AND 999 THEN 'Alaska'
      WHEN zip3 BETWEEN 850 AND 865 THEN 'Arizona'
      WHEN zip3 BETWEEN 716 AND 729 THEN 'Arkansas'
      WHEN zip3 BETWEEN 900 AND 961 THEN 'California'
      WHEN zip3 BETWEEN 800 AND 816 THEN 'Colorado'
      WHEN zip3 BETWEEN 060 AND 069 THEN 'Connecticut'
      WHEN zip3 BETWEEN 197 AND 199 THEN 'Delaware'
      WHEN zip3 BETWEEN 200 AND 205 THEN 'District of Columbia'
      WHEN zip3 BETWEEN 320 AND 349 THEN 'Florida'
      WHEN zip3 BETWEEN 300 AND 319 THEN 'Georgia'
      WHEN zip3 BETWEEN 967 AND 969 THEN 'Hawaii'
      WHEN zip3 BETWEEN 832 AND 838 THEN 'Idaho'
      WHEN zip3 BETWEEN 600 AND 629 THEN 'Illinois'
      WHEN zip3 BETWEEN 460 AND 479 THEN 'Indiana'
      WHEN zip3 BETWEEN 500 AND 528 THEN 'Iowa'
      WHEN zip3 BETWEEN 660 AND 679 THEN 'Kansas'
      WHEN zip3 BETWEEN 400 AND 427 THEN 'Kentucky'
      WHEN zip3 BETWEEN 700 AND 714 THEN 'Louisiana'
      WHEN zip3 BETWEEN 039 AND 049 THEN 'Maine'
      WHEN zip3 BETWEEN 206 AND 219 THEN 'Maryland'
      WHEN zip3 BETWEEN 010 AND 027 THEN 'Massachusetts'
      WHEN zip3 BETWEEN 480 AND 499 THEN 'Michigan'
      WHEN zip3 BETWEEN 550 AND 567 THEN 'Minnesota'
      WHEN zip3 BETWEEN 386 AND 397 THEN 'Mississippi'
      WHEN zip3 BETWEEN 630 AND 658 THEN 'Missouri'
      WHEN zip3 BETWEEN 590 AND 599 THEN 'Montana'
      WHEN zip3 BETWEEN 680 AND 693 THEN 'Nebraska'
      WHEN zip3 BETWEEN 889 AND 898 THEN 'Nevada'
      WHEN zip3 BETWEEN 030 AND 038 THEN 'New Hampshire'
      WHEN zip3 BETWEEN 070 AND 089 THEN 'New Jersey'
      WHEN zip3 BETWEEN 870 AND 884 THEN 'New Mexico'
      WHEN zip3 BETWEEN 100 AND 149 THEN 'New York'
      WHEN zip3 BETWEEN 270 AND 289 THEN 'North Carolina'
      WHEN zip3 BETWEEN 580 AND 588 THEN 'North Dakota'
      WHEN zip3 BETWEEN 430 AND 459 THEN 'Ohio'
      WHEN zip3 BETWEEN 730 AND 749 THEN 'Oklahoma'
      WHEN zip3 BETWEEN 970 AND 979 THEN 'Oregon'
      WHEN zip3 BETWEEN 150 AND 196 THEN 'Pennsylvania'
      WHEN zip3 BETWEEN 028 AND 029 THEN 'Rhode Island'
      WHEN zip3 BETWEEN 290 AND 299 THEN 'South Carolina'
      WHEN zip3 BETWEEN 570 AND 577 THEN 'South Dakota'
      WHEN zip3 BETWEEN 370 AND 385 THEN 'Tennessee'
      WHEN zip3 BETWEEN 750 AND 799 THEN 'Texas'
      WHEN zip3 = 885 THEN 'Texas'
      WHEN zip3 BETWEEN 840 AND 847 THEN 'Utah'
      WHEN zip3 BETWEEN 050 AND 059 THEN 'Vermont'
      WHEN zip3 BETWEEN 201 AND 246 THEN 'Virginia'
      WHEN zip3 BETWEEN 980 AND 994 THEN 'Washington'
      WHEN zip3 BETWEEN 247 AND 268 THEN 'West Virginia'
      WHEN zip3 BETWEEN 530 AND 549 THEN 'Wisconsin'
      WHEN zip3 BETWEEN 820 AND 831 THEN 'Wyoming'
      ELSE NULL
    END AS state_name,
    population
  FROM z
),
state_pop AS (
  SELECT state_name, SUM(population) AS population_2010
  FROM zip_state
  WHERE state_name IS NOT NULL
  GROUP BY state_name
),
-- === 2015 accidents ===
acc_2015 AS (
  SELECT
    state_name,
    COUNT(DISTINCT consecutive_number) AS accident_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(driver_distracted_by_name) NOT IN
        ('not distracted','unknown if distracted','not reported')
  GROUP BY state_name
),
rate_2015 AS (
  SELECT
    '2015' AS yr,
    a.state_name,
    ROUND(a.accident_cnt * 100000.0 / p.population_2010, 2) AS accidents_per_100k
  FROM acc_2015 AS a
  JOIN state_pop AS p USING (state_name)
),
-- === 2016 accidents ===
state_map AS (                      -- map # to name
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`
),
acc_2016 AS (
  SELECT
    m.state_name,
    COUNT(DISTINCT d.consecutive_number) AS accident_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016` AS d
  JOIN state_map AS m USING (state_number)
  WHERE LOWER(d.driver_distracted_by_name) NOT IN
        ('not distracted','unknown if distracted','not reported')
  GROUP BY m.state_name
),
rate_2016 AS (
  SELECT
    '2016' AS yr,
    a.state_name,
    ROUND(a.accident_cnt * 100000.0 / p.population_2010, 2) AS accidents_per_100k
  FROM acc_2016 AS a
  JOIN state_pop AS p USING (state_name)
),
unioned AS (
  SELECT * FROM rate_2015
  UNION ALL
  SELECT * FROM rate_2016
)
SELECT *
FROM (
  SELECT
    yr,
    state_name,
    accidents_per_100k,
    ROW_NUMBER() OVER (PARTITION BY yr ORDER BY accidents_per_100k DESC) AS rn
  FROM unioned
)
WHERE rn <= 5
ORDER BY yr, accidents_per_100k DESC;
```

The final query returns, for each of the two years (2015 and 2016), the five U.S. states with the highest rate of driver-distraction-related fatal crashes per 100,000 residents, using 2010 Census ZIP-level population summed to states.
