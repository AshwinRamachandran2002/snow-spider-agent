```sql
-- 5. 2016 ‒ count crashes with TRUE distraction, by state
WITH state_map AS (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`
)
SELECT
  m.state_name,
  COUNT(DISTINCT d.consecutive_number) AS accident_cnt_2016
FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016` AS d
JOIN state_map AS m
USING (state_number)
WHERE LOWER(d.driver_distracted_by_name) NOT IN
      ('not distracted','unknown if distracted','not reported')
GROUP BY m.state_name
ORDER BY accident_cnt_2016 DESC
LIMIT 20;
```

```sql
-- 6. Inspect the population-by-ZIP file and derive the first-three-digit “ZIP3”
SELECT
  zipcode,
  LPAD(zipcode,5,'0')                                AS zip_padded,
  CAST(SUBSTR(LPAD(zipcode,5,'0'),1,3) AS INT64)     AS zip3,
  population
FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
LIMIT 20;
```

```sql
-- 7. 2010 Census population summed to state level
WITH z AS (
  SELECT
    CAST(SUBSTR(LPAD(zipcode,5,'0'),1,3) AS INT64) AS zip3,
    population
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
),
zip_state AS (
  SELECT
    CASE
      WHEN zip3 BETWEEN 350 AND 369 THEN 'Alabama'
      WHEN zip3 BETWEEN 995 AND 999 THEN 'Alaska'
      WHEN zip3 BETWEEN 850 AND 865 THEN 'Arizona'
      WHEN zip3 BETWEEN 716 AND 729 THEN 'Arkansas'
      WHEN zip3 BETWEEN 900 AND 961 THEN 'California'
      WHEN zip3 BETWEEN 800 AND 816 THEN 'Colorado'
      WHEN zip3 BETWEEN 600 AND 629 THEN 'Illinois'      -- …(continue CASE for all 50 states & DC)…
      ELSE NULL
    END AS state_name,
    population
  FROM z
)
SELECT
  state_name,
  SUM(population) AS population_2010
FROM zip_state
WHERE state_name IS NOT NULL
GROUP BY state_name
ORDER BY population_2010 DESC
LIMIT 20;
```

```sql
-- 8. Merge the 2015 accident counts with population to get rate/100K
WITH accident_2015 AS (
  SELECT
    state_name,
    COUNT(DISTINCT consecutive_number) AS accident_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(driver_distracted_by_name) NOT IN
        ('not distracted','unknown if distracted','not reported')
  GROUP BY state_name
),
pop AS (                                  -- the CTE from query #7
  SELECT *
  FROM (                                   -- duplicated here for brevity
    WITH z AS (
      SELECT CAST(SUBSTR(LPAD(zipcode,5,'0'),1,3) AS INT64) AS zip3, population
      FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
    ), zip_state AS (
      SELECT
        CASE
          WHEN zip3 BETWEEN 350 AND 369 THEN 'Alabama'
          WHEN zip3 BETWEEN 995 AND 999 THEN 'Alaska'
          WHEN zip3 BETWEEN 850 AND 865 THEN 'Arizona'
          WHEN zip3 BETWEEN 716 AND 729 THEN 'Arkansas'
          WHEN zip3 BETWEEN 900 AND 961 THEN 'California'
          WHEN zip3 BETWEEN 800 AND 816 THEN 'Colorado'
          WHEN zip3 BETWEEN 600 AND 629 THEN 'Illinois'
          -- … full CASE list …
          ELSE NULL
        END AS state_name,
        population
      FROM z
    )
    SELECT state_name, SUM(population) AS population_2010
    FROM zip_state
    WHERE state_name IS NOT NULL
    GROUP BY state_name
  )
)
SELECT
  a.state_name,
  accident_cnt,
  population_2010,
  ROUND(accident_cnt * 100000.0 / population_2010, 2) AS accidents_per_100k_2015
FROM accident_2015 AS a
JOIN pop               USING (state_name)
ORDER BY accidents_per_100k_2015 DESC
LIMIT 20;
```

