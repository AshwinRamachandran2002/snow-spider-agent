/*  Driver–distraction traffic-accident rates (per 100 000 residents)
    for 2015 and 2016 – five states with the highest rate each year     */

WITH
/* ────────── 1.  State-number (FIPS) → state-name look-up ────────── */
state_lookup AS (
  SELECT
    CAST(statefp AS INT64)            AS state_number,   -- numeric FIPS
    name                              AS state_name,
    statefp                           AS statefp         -- keep as string for joins
  FROM `bigquery-public-data.geo_us_boundaries.states`
),

/* ────────── 2.  All distraction-related crashes (filter out three “null” labels) ────────── */
all_distraction_cases AS (
  -- 2015 ------------------------------------------------------------------
  SELECT
    2015                                   AS year,
    d15.state_number,
    sl.state_name,
    d15.consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015` AS d15
  JOIN state_lookup AS sl USING (state_number)
  WHERE d15.driver_distracted_by_name NOT IN
        ('Not Distracted', 'Unknown if Distracted', 'Not Reported')

  UNION ALL

  -- 2016 ------------------------------------------------------------------
  SELECT
    2016                                   AS year,
    d16.state_number,
    sl.state_name,
    d16.consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016` AS d16
  JOIN state_lookup AS sl USING (state_number)
  WHERE d16.driver_distracted_by_name NOT IN
        ('Not Distracted', 'Unknown if Distracted', 'Not Reported')
),

/* ────────── 3.  2010 Census population by state  ──────────
       (ZIP-level counts  → join to ZIP boundaries → aggregate to state)   */
state_population_2010 AS (
  SELECT
    sl.state_name,
    SUM(p.population) AS population_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`        AS p
  JOIN `bigquery-public-data.geo_us_boundaries.zip_codes`                     AS z
    ON LPAD(p.zipcode, 5, '0') = z.zip_code
  JOIN state_lookup AS sl
    ON z.statefp = sl.statefp
  GROUP BY sl.state_name
),

/* ────────── 4.  Accident rate per 100 000 residents ────────── */
state_year_rates AS (
  SELECT
    ac.year,
    ac.state_name,
    COUNT(DISTINCT ac.consecutive_number)                        AS accidents,
    sp.population_2010,
    COUNT(DISTINCT ac.consecutive_number) * 100000.0
      / sp.population_2010                                       AS accidents_per_100k
  FROM all_distraction_cases AS ac
  JOIN state_population_2010  AS sp
    ON sp.state_name = ac.state_name
  GROUP BY ac.year, ac.state_name, sp.population_2010
),

/* ────────── 5.  Rank states within each year and keep the top-5 ────────── */
ranked AS (
  SELECT
    *,
    ROW_NUMBER() OVER (PARTITION BY year
                       ORDER BY accidents_per_100k DESC) AS rn
  FROM state_year_rates
)

SELECT
  year,
  state_name,
  accidents,
  population_2010 AS population,
  ROUND(accidents_per_100k, 4) AS accidents_per_100k
