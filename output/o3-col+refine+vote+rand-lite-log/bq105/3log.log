```

```sql
-- 5. 2010 Census population by state (approximation):
--    derive the state FIPS code from the first 2 digits of the
--    5-digit ZCTA code and aggregate the population.
WITH zcta AS (
  SELECT
    LPAD(zipcode,5,'0') AS zcta5,
    population
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
)
SELECT
  CAST(SUBSTR(zcta5,1,2) AS INT64)  AS state_number,
  SUM(population)                   AS pop_2010
FROM zcta
GROUP BY state_number
ORDER BY pop_2010 DESC
LIMIT 20;
```

```sql
-- 6. Join 2015 crashes to population to obtain
--    distracted-crash rate per 100,000 residents in 2015
WITH distracted AS (
  SELECT
    state_number,
    COUNT(DISTINCT consecutive_number) AS crashes
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(driver_distracted_by_name) NOT IN
        ('not distracted','unknown if distracted','not reported')
  GROUP BY state_number
),
pop AS (
  SELECT
    CAST(SUBSTR(LPAD(zipcode,5,'0'),1,2) AS INT64) AS state_number,
    SUM(population) AS pop_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  GROUP BY state_number
)
SELECT
  d.state_number,
  d.crashes,
  p.pop_2010,
  100000 * d.crashes / p.pop_2010 AS crashes_per_100k_2015
FROM distracted d
JOIN pop p USING (state_number)
ORDER BY crashes_per_100k_2015 DESC
LIMIT 20;
```

