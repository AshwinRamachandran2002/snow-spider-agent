Query:
--Description:  (#10) Side-by-side summary of the five highest-rate states in
--               each year (2015 & 2016) based on distracted-crash rates.
WITH rates15 AS (
  SELECT
    d.state_number,
    100000 * d.crashes / p.pop_2010 AS rate_2015
  FROM (
    SELECT
      state_number,
      COUNT(DISTINCT consecutive_number) AS crashes
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
    WHERE LOWER(driver_distracted_by_name) NOT IN
          ('not distracted', 'unknown if distracted', 'not reported')
    GROUP BY state_number
  ) d
  JOIN (
    SELECT
      CAST(SUBSTR(LPAD(zipcode, 5, '0'), 1, 2) AS INT64) AS state_number,
      SUM(population) AS pop_2010
    FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
    GROUP BY state_number
  ) p USING (state_number)
),
rates16 AS (
  SELECT
    d.state_number,
    100000 * d.crashes / p.pop_2010 AS rate_2016
  FROM (
    SELECT
      state_number,
      COUNT(DISTINCT consecutive_number) AS crashes
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
    WHERE LOWER(driver_distracted_by_name) NOT IN
          ('not distracted', 'unknown if distracted', 'not reported')
    GROUP BY state_number
  ) d
  JOIN (
    SELECT
      CAST(SUBSTR(LPAD(zipcode, 5, '0'), 1, 2) AS INT64) AS state_number,
      SUM(population) AS pop_2010
    FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
    GROUP BY state_number
  ) p USING (state_number)
)
SELECT
  *
FROM (
  SELECT
    state_number,
    rate_2015
  FROM rates15
  ORDER BY rate_2015 DESC
  LIMIT 5
) AS a
FULL JOIN (
  SELECT
    state_number,
    rate_2016
  FROM rates16
  ORDER BY rate_2016 DESC
  LIMIT 5
) AS b
USING (state_number)
LIMIT 20
