--Description:  (#4) 2016 – count unique crashes per state that involved a
--               distracted driver.  `state_name` is not in `distract_2016`,
--               so we select / group only by `state_number`.
SELECT
  state_number,
  COUNT(DISTINCT consecutive_number) AS distracted_crashes_2016
FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
WHERE LOWER(driver_distracted_by_name) NOT IN
      ('not distracted', 'unknown if distracted', 'not reported')
GROUP BY state_number
ORDER BY distracted_crashes_2016 DESC
LIMIT 20
