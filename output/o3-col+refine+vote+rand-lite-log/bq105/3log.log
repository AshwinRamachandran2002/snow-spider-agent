--Description:  (#5) Build 2010 Census population by state by aggregating ZCTA
--               populations.  The first two digits of the 5-digit ZCTA equal the
--               numeric state FIPS code (`state_number`).
WITH zcta AS (
  SELECT
    LPAD(zipcode, 5, '0') AS zcta5,
    population
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
)
SELECT
  CAST(SUBSTR(zcta5, 1, 2) AS INT64) AS state_number,
  SUM(population) AS pop_2010
FROM zcta
GROUP BY state_number
ORDER BY pop_2010 DESC
LIMIT 20
