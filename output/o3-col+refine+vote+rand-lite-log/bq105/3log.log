```sql
--Description:  End-to-end solution in one statement.
--              Goal:  for 2015 and 2016, compute traffic-accident rates that involved
--              distracted drivers (per 100,000 inhabitants, using 2010 Census
--              population) and list the five states with the highest
--              rates in each year.
--
-- Steps (all wrapped in CTEs):
--   1. pop        – Build 2010 population by state.  ZCTA (ZIP Code Tabulation Area)
--                   codes are five digits; the first two digits are the numeric
--                   state FIPS code ─ we cast those to INT64 for `state_number`.
--   2. crashes15  – Count DISTINCT crashes (`consecutive_number`) in 2015 that have
--                   at least one driver whose distraction status is NOT
--                   ‘Not Distracted’, ‘Unknown if Distracted’, or ‘Not Reported’.
--   3. crashes16  – Same logic for 2016.
--   4. rates      – Convert crash counts to rates per 100 000 population and union
--                   the two years into one set.
--   5. ranked     – Rank states within each year by that rate.
--   6. final SELECT – Return only the top-5 states for each year, ordered nicely.
--
WITH pop AS (
  SELECT
    CAST(SUBSTR(LPAD(zipcode, 5, '0'), 1, 2) AS INT64) AS state_number,
    SUM(population) AS pop_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  GROUP BY state_number
),
crashes15 AS (
  SELECT
    state_number,
    COUNT(DISTINCT consecutive_number) AS crashes
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(driver_distracted_by_name) NOT IN
        ('not distracted', 'unknown if distracted', 'not reported')
  GROUP BY state_number
),
crashes16 AS (
  SELECT
    state_number,
    COUNT(DISTINCT consecutive_number) AS crashes
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
  WHERE LOWER(driver_distracted_by_name) NOT IN
        ('not distracted', 'unknown if distracted', 'not reported')
  GROUP BY state_number
),
rates AS (
  -- 2015 rates
  SELECT
    2015 AS year,
    c15.state_number,
    100000 * c15.crashes / p.pop_2010 AS crashes_per_100k
  FROM crashes15 c15
  JOIN pop p USING (state_number)
  UNION ALL
  -- 2016 rates
  SELECT
    2016 AS year,
    c16.state_number,
    100000 * c16.crashes / p.pop_2010 AS crashes_per_100k
  FROM crashes16 c16
  JOIN pop p USING (state_number)
),
ranked AS (
  SELECT
    year,
    state_number,
    crashes_per_100k,
    DENSE_RANK() OVER (PARTITION BY year ORDER BY crashes_per_100k DESC) AS rnk
  FROM rates
)
SELECT
  year,
  state_number,
  ROUND(crashes_per_100k, 2) AS crashes_per_100k
FROM ranked
WHERE rnk <= 5                  -- top 5 per year
ORDER BY year, rnk;
```
