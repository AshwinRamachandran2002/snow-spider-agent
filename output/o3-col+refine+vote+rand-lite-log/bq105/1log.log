```sql
-- Description: ❹  Count the number of DISTINCT crashes in 2015 that involved
-- a distracted driver (after exclusions) for every state.
SELECT state_name,
       COUNT(DISTINCT consecutive_number) AS crashes_2015
FROM   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
WHERE  LOWER(driver_distracted_by_name) NOT IN ('not distracted',
                                                'unknown if distracted',
                                                'not reported')
GROUP  BY state_name
ORDER  BY crashes_2015 DESC
LIMIT  20;
```

```sql
-- Description: ❺  Count the number of DISTINCT crashes in 2016 that involved
-- a distracted driver (after exclusions) for every state.
WITH map AS (
      SELECT DISTINCT state_number, state_name
      FROM   `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`)
SELECT m.state_name,
       COUNT(DISTINCT d.consecutive_number) AS crashes_2016
FROM   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016` AS d
JOIN   map AS m
USING  (state_number)
WHERE  LOWER(d.driver_distracted_by_name) NOT IN ('not distracted',
                                                  'unknown if distracted',
                                                  'not reported')
GROUP  BY m.state_name
ORDER  BY crashes_2016 DESC
LIMIT  20;
```

```sql
-- Description: ❻  Aggregate the 2010 Census ZIP data to obtain total
-- population for every state (assuming the table has a “state” column).
SELECT state,
       SUM(population) AS population_2010
FROM   `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
GROUP  BY state
ORDER  BY population_2010 DESC
LIMIT  20;
```

```sql
-- Description: ❼  Combine the 2015 crash counts with 2010 population to get
-- distraction–related crashes per 100,000 residents for each state (2015).
WITH crashes AS (
      SELECT state_name,
             COUNT(DISTINCT consecutive_number) AS crashes_2015
      FROM   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
      WHERE  LOWER(driver_distracted_by_name) NOT IN ('not distracted',
                                                      'unknown if distracted',
                                                      'not reported')
      GROUP  BY state_name )
SELECT c.state_name,
       c.crashes_2015,
       p.population_2010,
       ROUND(1e5 * c.crashes_2015 / p.population_2010, 2) AS crashes_per_100k
FROM   crashes AS c
JOIN   (
        SELECT state, SUM(population) AS population_2010
        FROM   `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
        GROUP  BY state ) AS p
ON     c.state_name = p.state
ORDER  BY crashes_per_100k DESC
LIMIT  20;
```

```sql
-- Description: ❽  Do the same calculation for 2016 crashes.
WITH crashes AS (
      WITH map AS (
            SELECT DISTINCT state_number, state_name
            FROM   `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`)
      SELECT m.state_name,
             COUNT(DISTINCT d.consecutive_number) AS crashes_2016
      FROM   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016` AS d
      JOIN   map AS m
      USING  (state_number)
      WHERE  LOWER(d.driver_distracted_by_name) NOT IN ('not distracted',
                                                        'unknown if distracted',
                                                        'not reported')
      GROUP  BY m.state_name )
SELECT c.state_name,
       c.crashes_2016,
       p.population_2010,
       ROUND(1e5 * c.crashes_2016 / p.population_2010, 2) AS crashes_per_100k
FROM   crashes AS c
JOIN   (
        SELECT state, SUM(population) AS population_2010
        FROM   `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
        GROUP  BY state ) AS p
ON     c.state_name = p.state
ORDER  BY crashes_per_100k DESC
LIMIT  20;
```

