```sql
-- Description: ❸  Do the same inspection for the 2016 distraction table.
SELECT d16.state_number,
       m16.state_name,                 -- add name via a quick mapping
       d16.consecutive_number,
       d16.driver_distracted_by_name
FROM   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016` AS d16
