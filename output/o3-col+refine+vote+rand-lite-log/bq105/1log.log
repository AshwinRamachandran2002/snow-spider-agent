2025-05-05 03:22:19 - Thread-1826 (execute) - INFO - [Try to run SQL in self-refine]
```sql
/*  ------------------------------------------------------------
    Driver–distraction crash rates (per 100,000 residents)
    for 2015 and 2016 together with the five states that
    had the highest rates in each of the two years.
    ------------------------------------------------------------ */
WITH  /* ────────────────────────────────────────────────────────
         1) 2010 Census population rolled-up to state level
    ─────────────────────────────────────────────────────────── */
state_population AS (
  SELECT
    b.state_name,
    SUM(p.population) AS population_2010
  FROM   `bigquery-public-data.census_bureau_usa.population_by_zip_2010` p
  JOIN   `bigquery-public-data.geo_us_boundaries.zip_codes`            b
           ON LPAD(p.zipcode,5,'0') = b.zip_code           -- ensure leading-zeros match
  GROUP BY b.state_name
),

/* ─────────────────────────────────────────────────────────────
   2) 2015 crashes with at least one distracted driver
   ─────────────────────────────────────────────────────────── */
accidents_2015 AS (
  SELECT
    state_name,
    COUNT(DISTINCT consecutive_number) AS crashes
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE driver_distracted_by_name NOT IN
        ('Not Distracted','Unknown if Distracted','Not Reported')
        AND driver_distracted_by_name IS NOT NULL
  GROUP BY state_name
),

/* ─────────────────────────────────────────────────────────────
   3) 2016 crashes with at least one distracted driver
      (need state names – take them from drimpair_2016)
   ─────────────────────────────────────────────────────────── */
accidents_2016 AS (
  SELECT
    m.state_name,
    COUNT(DISTINCT d.consecutive_number) AS crashes
  FROM   `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016` d
  JOIN  ( SELECT DISTINCT state_number, state_name
          FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`) m
        USING (state_number)
  WHERE  d.driver_distracted_by_name NOT IN
         ('Not Distracted','Unknown if Distracted','Not Reported')
         AND d.driver_distracted_by_name IS NOT NULL
  GROUP BY m.state_name
),

/* ─────────────────────────────────────────────────────────────
   4) Combine, calculate rates per-100 000 residents
   ─────────────────────────────────────────────────────────── */
all_rates AS (
  SELECT
    2015                AS year,
    p.state_name,
    a.crashes,
    p.population_2010,
    a.crashes * 100000.0 / p.population_2010 AS crashes_per_100k
  FROM accidents_2015 a
  JOIN state_population p USING (state_name)

  UNION ALL

  SELECT
    2016,
    p.state_name,
    a.crashes,
    p.population_2010,
    a.crashes * 100000.0 / p.population_2010
  FROM accidents_2016 a
  JOIN state_population p USING (state_name)
),

/* ─────────────────────────────────────────────────────────────
   5) Rank states by rate within each year
   ─────────────────────────────────────────────────────────── */
ranked AS (
  SELECT
    year,
    state_name,
    crashes_per_100k,
    ROW_NUMBER() OVER (PARTITION BY year
                       ORDER BY crashes_per_100k DESC) AS state_rank
  FROM all_rates
)

/* ─────────────────────────────────────────────────────────────
   6) Final output
   ─────────────────────────────────────────────────────────── */
SELECT
  year,
  state_name,
  ROUND(crashes_per_100k, 4) AS crashes_per_100k,
  state_rank
FROM ranked
WHERE state_rank <= 5            -- five highest-rate states each year
ORDER BY year, state_rank;
```
