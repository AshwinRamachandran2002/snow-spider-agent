/*  ------------------------------------------------------------
   Driver-distraction crash rates (per 100 000 residents)
   for 2015 and 2016, plus the five states with the highest
   rate in each year.
   ------------------------------------------------------------ */
WITH
/* ─────────────────────────────────────────────────────────────
   1) 2010 Census population rolled up to state level
   ─────────────────────────────────────────────────────────── */
state_population AS (
  SELECT
    z.state_name,
    SUM(p.population) AS population_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010` p
  JOIN `bigquery-public-data.geo_us_boundaries.zip_codes` z
        ON LPAD(p.zipcode,5,'0') = z.zip_code          -- keep leading zeros
  GROUP BY z.state_name
),

/* ─────────────────────────────────────────────────────────────
   2) Map state_number ↔ state_name from impairment tables
   ─────────────────────────────────────────────────────────── */
state_ref AS (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`
  UNION DISTINCT
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
),

/* ─────────────────────────────────────────────────────────────
   3) 2015 crashes that involve ≥1 distracted driver
   ─────────────────────────────────────────────────────────── */
accidents_2015 AS (
  SELECT
    state_number,
    COUNT(DISTINCT consecutive_number) AS crashes
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE driver_distracted_by_name NOT IN
        ('Not Distracted','Unknown if Distracted','Not Reported')
        AND driver_distracted_by_name IS NOT NULL
  GROUP BY state_number
),

/* ─────────────────────────────────────────────────────────────
   4) 2016 crashes that involve ≥1 distracted driver
   ─────────────────────────────────────────────────────────── */
accidents_2016 AS (
  SELECT
    state_number,
    COUNT(DISTINCT consecutive_number) AS crashes
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
  WHERE driver_distracted_by_name NOT IN
        ('Not Distracted','Unknown if Distracted','Not Reported')
        AND driver_distracted_by_name IS NOT NULL
  GROUP BY state_number
),

/* ─────────────────────────────────────────────────────────────
   5) Combine and compute rates per 100 000 residents
   ─────────────────────────────────────────────────────────── */
all_rates AS (
  SELECT
    2015 AS year,
    pop.state_name,
    a.crashes,
    pop.population_2010,
    a.crashes * 100000.0 / pop.population_2010 AS crashes_per_100k
  FROM accidents_2015           a
  JOIN state_ref                r   USING (state_number)
  JOIN state_population         pop ON  pop.state_name = r.state_name

  UNION ALL

  SELECT
    2016,
    pop.state_name,
    a.crashes,
    pop.population_2010,
    a.crashes * 100000.0 / pop.population_2010
  FROM accidents_2016           a
  JOIN state_ref                r   USING (state_number)
  JOIN state_population         pop ON  pop.state_name = r.state_name
),

/* ─────────────────────────────────────────────────────────────
   6) Rank states within each year
   ─────────────────────────────────────────────────────────── */
ranked AS (
  SELECT
    year,
    state_name,
    crashes_per_100k,
    ROW_NUMBER() OVER (PARTITION BY year
                       ORDER BY crashes_per_100k DESC) AS state_rank
  FROM all_rates
)

/* ─────────────────────────────────────────────────────────────
   7) Final result – top-5 states each year
   ─────────────────────────────────────────────────────────── */
SELECT
  year,
  state_name,
  ROUND(crashes_per_100k, 4) AS crashes_per_100k,
  state_rank
FROM ranked
WHERE state_rank <= 5
ORDER BY year, state_rank;
