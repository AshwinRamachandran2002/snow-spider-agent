--Description:  Quickly return, for each (gene_id, study_id) pair, the variant that has
--              the very smallest p-value—without using ROW_NUMBER (which timed out).  
--              Step-1 (min_pvals): GROUP BY to find the minimum p-value for every pair.  
--              Step-2: join those minima back to the main table to keep only the
--              variant rows that equal that minimum.  Finally LIMIT 20 for a sample.
WITH min_pvals AS (                         -- Step-1: one row per gene-study
    SELECT
        "gene_id",
        "study_id",
        MIN("pval") AS "min_pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
    GROUP BY "gene_id", "study_id"
)
SELECT                                      -- Step-2: retrieve matching variants
    d."gene_id",
    d."study_id",
    d."tag_chrom",
    d."tag_pos",
    d."tag_ref",
    d."tag_alt",
    d."pval"
FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE" d
JOIN min_pvals m
  ON d."gene_id"  = m."gene_id"
 AND d."study_id" = m."study_id"
 AND d."pval"     = m."min_pval"
LIMIT 20;
