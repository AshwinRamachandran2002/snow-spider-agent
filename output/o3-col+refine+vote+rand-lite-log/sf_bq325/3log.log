```sql
--Description:  Task-aligned solution that avoids full-table window functions:  
--              • “min_pvals”   – for each (gene_id, study_id) pair, keep ONLY the
--                smallest p-value observed.  
--              • “top_pairs”   – rank those pairwise minima globally and keep the
--                ten smallest (these define the strongest gene–study signals).  
--              • final SELECT  – join back to DISEASE_VARIANT_GENE to retrieve the
--                exact variant row(s) achieving each minimum and add HGNC symbols
--                from GENES.  The output therefore satisfies:  
--                  ① one variant per gene-study (lowest p),  
--                  ② top 10 such gene–variant pairs overall.
WITH min_pvals AS (                 -- step-1: min p-value for every gene–study
    SELECT
        "gene_id",
        "study_id",
        MIN("pval") AS "min_pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
    GROUP BY "gene_id", "study_id"
),
top_pairs AS (                      -- step-2: the 10 strongest gene–study signals
    SELECT
        "gene_id",
        "study_id",
        "min_pval"
    FROM min_pvals
    ORDER BY "min_pval" ASC
    LIMIT 10
)
SELECT                               -- step-3: pull variant rows & gene symbols
    g."gene_name",
    d."gene_id",
    d."study_id",
    d."tag_chrom" || ':' || d."tag_pos"::STRING || ':' ||
        d."tag_ref" || ':' || d."tag_alt"       AS "variant_id",
    d."pval"
FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE" d
JOIN top_pairs t
  ON d."gene_id"  = t."gene_id"
 AND d."study_id" = t."study_id"
 AND d."pval"     = t."min_pval"
LEFT JOIN OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."GENES" g
  ON d."gene_id" = g."gene_id"
ORDER BY d."pval" ASC;
```
