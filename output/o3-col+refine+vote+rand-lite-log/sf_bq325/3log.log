Query:
--Description:  Rank every gene–study minimum globally by p-value and preview the
--              20 strongest associations.
WITH min_pvals AS (
    SELECT
        "gene_id",
        "study_id",
        MIN("pval") AS "min_pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
    GROUP BY "gene_id", "study_id"
),
best_variants AS (
    SELECT
        d."gene_id",
        d."study_id",
        d."tag_chrom",
        d."tag_pos",
        d."tag_ref",
        d."tag_alt",
        d."pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE" d
    JOIN min_pvals m
      ON d."gene_id"  = m."gene_id"
     AND d."study_id" = m."study_id"
     AND d."pval"     = m."min_pval"
)
SELECT
    g."gene_name",
    b."gene_id",
    b."study_id",
    b."tag_chrom" || ':' || b."tag_pos"::STRING || ':' ||
        b."tag_ref" || ':' || b."tag_alt"         AS "variant_id",
    b."pval"
FROM best_variants b
JOIN OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."GENES" g
  ON b."gene_id" = g."gene_id"
ORDER BY b."pval" ASC
LIMIT 20
