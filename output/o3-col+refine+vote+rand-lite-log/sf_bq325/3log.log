```sql
--Description:  We need the 10 genes with the strongest overall evidence of association.
--              Strategy (all done inside this single query):
--              1.   min_pvals CTE – for each gene-study pair, calculate the minimum p-value.
--              2.   best_variants CTE – pick the variant rows that actually reach those minima.
--                   (join back on gene_id, study_id, and pval = min_pval).
--              3.   ranked CTE – order every best variant by its p-value and assign a global rank.
--              4.   Final SELECT – keep the first 10 rows (smallest p-values), join to GENES
--                   so we can show the HGNC symbol, and build a human-readable variant_id.
WITH min_pvals AS (                              -- step 1
    SELECT
        "gene_id",
        "study_id",
        MIN("pval") AS "min_pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
    GROUP BY "gene_id", "study_id"
),
best_variants AS (                               -- step 2
    SELECT
        d."gene_id",
        d."study_id",
        d."tag_chrom",
        d."tag_pos",
        d."tag_ref",
        d."tag_alt",
        d."pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE" d
    JOIN min_pvals m
      ON d."gene_id"  = m."gene_id"
     AND d."study_id" = m."study_id"
     AND d."pval"     = m."min_pval"
),
ranked AS (                                      -- step 3
    SELECT
        b.*,
        ROW_NUMBER() OVER (ORDER BY b."pval" ASC) AS "global_rank"
    FROM best_variants b
)
SELECT                                           -- step 4
    g."gene_name",
    r."gene_id",
    r."study_id",
    r."tag_chrom" || ':' || r."tag_pos"::STRING || ':' ||
        r."tag_ref" || ':' || r."tag_alt"          AS "variant_id",
    r."pval"
FROM ranked r
JOIN OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."GENES" g
  ON r."gene_id" = g."gene_id"
WHERE r."global_rank" <= 10
ORDER BY r."pval" ASC;
```
