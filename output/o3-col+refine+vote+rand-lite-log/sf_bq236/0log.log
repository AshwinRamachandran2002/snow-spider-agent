```sql
--Description: 7)  Aggregate that hail-events union at the county level
--              to see which counties have the largest hail counts.
WITH hail_10yr AS (
  SELECT LPAD("cz_fips_code",5,'0') AS "county_fips"
  FROM  NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2022" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2020" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2019" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2018" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2017" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2016" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2015" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2014" WHERE "event_type" ILIKE '%hail%'
)
SELECT 
       "county_fips",
       COUNT(*) AS "hail_event_count"
FROM   hail_10yr
GROUP  BY "county_fips"
ORDER  BY "hail_event_count" DESC
LIMIT 20;
```

```sql
--Description: 8)  Bring the county names into the previous aggregation so that
--              we can later check if the spatial join to ZIP codes makes sense.
WITH hail_by_cnty AS (
  -- (same CTE body as previous query)
  SELECT LPAD("cz_fips_code",5,'0') AS "county_fips"
  FROM  NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2022" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2020" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2019" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2018" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2017" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2016" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2015" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2014" WHERE "event_type" ILIKE '%hail%'
)
SELECT 
       c."county_name",
       c."county_fips_code",
       COUNT(*) AS "hail_event_count"
FROM   hail_by_cnty h
JOIN   NOAA_DATA_PLUS.GEO_US_BOUNDARIES."COUNTIES" c
       ON h."county_fips" = c."county_fips_code"
GROUP  BY c."county_name", c."county_fips_code"
ORDER  BY "hail_event_count" DESC
LIMIT 20;
```

```sql
--Description: 9)  Spatially join the hail-rich counties to the ZIP-code polygons
--              so we can count hail events by ZIP code (sample of 20 rows).
WITH hail_cnty AS (
  /* same CTE body as query 7 */
  SELECT LPAD("cz_fips_code",5,'0') AS "county_fips"
  FROM  NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2022" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2020" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2019" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2018" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2017" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2016" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2015" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2014" WHERE "event_type" ILIKE '%hail%'
)
SELECT 
       z."zip_code",
       COUNT(*) AS "hail_events_in_zip"
FROM   hail_cnty h
JOIN   NOAA_DATA_PLUS.GEO_US_BOUNDARIES."COUNTIES" c
       ON h."county_fips" = c."county_fips_code"
JOIN   NOAA_DATA_PLUS.GEO_US_BOUNDARIES."ZIP_CODES" z
       ON ST_WITHIN(
            TO_GEOGRAPHY(z."zip_code_geom"),
            TO_GEOGRAPHY(c."county_geom")
          )
GROUP  BY z."zip_code"
ORDER  BY "hail_events_in_zip" DESC
LIMIT 20;
```

```sql
--Description: 10)  Final query – return the top-5 ZIP codes in the United States
--               that experienced the greatest number of hail events in the
--               2014-2024 period (still LIMIT 20 for inspection).
WITH hail_all AS (
  /* identical CTE body as query 9 but selecting county_fips and event counts */
  SELECT LPAD("cz_fips_code",5,'0') AS "county_fips"
  FROM  NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2022" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2020" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2019" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2018" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2017" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2016" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2015" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("cz_fips_code",5,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2014" WHERE "event_type" ILIKE '%hail%'
)
SELECT 
       z."zip_code",
       COUNT(*) AS "hail_events_last_10yrs"
FROM   hail_all h
JOIN   NOAA_DATA_PLUS.GEO_US_BOUNDARIES."COUNTIES" c
       ON h."county_fips" = c."county_fips_code"
JOIN   NOAA_DATA_PLUS.GEO_US_BOUNDARIES."ZIP_CODES" z
       ON ST_WITHIN(
            TO_GEOGRAPHY(z."zip_code_geom"),
            TO_GEOGRAPHY(c."county_geom")
          )
GROUP  BY z."zip_code"
ORDER  BY "hail_events_last_10yrs" DESC
LIMIT 20;
```
