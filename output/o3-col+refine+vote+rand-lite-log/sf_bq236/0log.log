--Description: 7)  Aggregate the 10-year hail record by county to see which
--              counties experienced the most hail events.
WITH hail_10yr AS (
  SELECT LPAD("state_fips_code",2,'0') || LPAD("cz_fips_code",3,'0') AS "county_fips"
  FROM  NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("state_fips_code",2,'0') || LPAD("cz_fips_code",3,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("state_fips_code",2,'0') || LPAD("cz_fips_code",3,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2022" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("state_fips_code",2,'0') || LPAD("cz_fips_code",3,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("state_fips_code",2,'0') || LPAD("cz_fips_code",3,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2020" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("state_fips_code",2,'0') || LPAD("cz_fips_code",3,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2019" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("state_fips_code",2,'0') || LPAD("cz_fips_code",3,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2018" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("state_fips_code",2,'0') || LPAD("cz_fips_code",3,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2017" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("state_fips_code",2,'0') || LPAD("cz_fips_code",3,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2016" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("state_fips_code",2,'0') || LPAD("cz_fips_code",3,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2015" WHERE "event_type" ILIKE '%hail%'
  UNION ALL
  SELECT LPAD("state_fips_code",2,'0') || LPAD("cz_fips_code",3,'0') FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2014" WHERE "event_type" ILIKE '%hail%'
)
SELECT 
       "county_fips",
       COUNT(*) AS "hail_event_count"
FROM   hail_10yr
GROUP  BY "county_fips"
ORDER  BY "hail_event_count" DESC
LIMIT 20
