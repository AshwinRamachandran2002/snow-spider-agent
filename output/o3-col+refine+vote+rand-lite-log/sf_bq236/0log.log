```sql
--Description: 3)  Inspect a handful of recent hail rows to understand the county-level
--              columns that are available for later joins.
SELECT 
       "cz_fips_code",
       "cz_name",
       "event_begin_time"
FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2022"
WHERE  "event_type" ILIKE '%hail%'
LIMIT  20;
```

```sql
--Description: 4)  Join one Storm-Data year (2022) with the counties lookup table
--              to be sure that padding the FIPS-code to five digits
--              produces successful matches.
SELECT 
       s."cz_fips_code"                               AS "storm_fips",
       LPAD(s."cz_fips_code", 5, '0')                 AS "padded_fips",
       c."county_name",
       c."state_fips_code"
FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2022" s
JOIN   NOAA_DATA_PLUS.GEO_US_BOUNDARIES."COUNTIES"    c
       ON LPAD(s."cz_fips_code", 5, '0') = c."county_fips_code"
WHERE  s."event_type" ILIKE '%hail%'
LIMIT  20;
```

```sql
--Description: 5)  Examine how county geometries relate to ZIP-code geometries.
--              We convert the WKB binary columns to GEOGRAPHY and look for
--              a single county that fully contains a sample of ZIP geometries.
SELECT 
       z."zip_code",
       c."county_name",
       ST_WITHIN(
           TO_GEOGRAPHY(z."zip_code_geom"),
           TO_GEOGRAPHY(c."county_geom")
       ) AS "zip_within_cnty"
FROM   NOAA_DATA_PLUS.GEO_US_BOUNDARIES."ZIP_CODES"   z
JOIN   NOAA_DATA_PLUS.GEO_US_BOUNDARIES."COUNTIES"    c
       ON ST_WITHIN(
            TO_GEOGRAPHY(z."zip_code_geom"),
            TO_GEOGRAPHY(c."county_geom")
          )
LIMIT  20;
```

