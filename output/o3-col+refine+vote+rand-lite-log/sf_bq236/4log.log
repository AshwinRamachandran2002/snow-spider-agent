--Description: 3) Rank counties by number of hail events that occurred in 2024.  
SELECT LPAD("cz_fips_code",5,'0')             AS "county_fips_code",
       COUNT(*)                               AS "hail_events_2024"
FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024"
WHERE "event_type" ILIKE '%hail%'
GROUP BY LPAD("cz_fips_code",5,'0')
ORDER BY "hail_events_2024" DESC
LIMIT 20;
