```sql
--Description: 6) List ZIP codes that lie completely inside Green Lake County, WI (FIPS 55047) by converting their WKB geometries to GEOGRAPHY and using ST_WITHIN.  
SELECT
       z."zip_code",
       z."state_code"
FROM   NOAA_DATA_PLUS.GEO_US_BOUNDARIES."ZIP_CODES"  z
JOIN   NOAA_DATA_PLUS.GEO_US_BOUNDARIES."COUNTIES"   c
       ON ST_WITHIN(
              TO_GEOGRAPHY(z."zip_code_geom"),
              TO_GEOGRAPHY(c."county_geom")
          )
WHERE  c."county_fips_code" = '55047'
LIMIT 20;
```

```sql
--Description: 7) Count 2024 hail events by ZIP code; map hail events → county FIPS → ZIP via spatial join (ST_WITHIN on GEOGRAPHY-cast geometries).  
