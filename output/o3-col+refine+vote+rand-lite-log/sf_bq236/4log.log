--Description: 4) Aggregate hail events for the most recent ten-year window (2015-2024) and rank counties.  
SELECT LPAD("cz_fips_code",5,'0')             AS "county_fips_code",
       COUNT(*)                               AS "hail_events_10yr"
FROM (
      SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2015"
      UNION ALL
      SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2016"
      UNION ALL
      SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2017"
      UNION ALL
      SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2018"
      UNION ALL
      SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2019"
      UNION ALL
      SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2020"
      UNION ALL
      SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021"
      UNION ALL
      SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2022"
      UNION ALL
      SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"
      UNION ALL
      SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024"
) t
WHERE "event_type" ILIKE '%hail%'
GROUP BY LPAD("cz_fips_code",5,'0')
ORDER BY "hail_events_10yr" DESC
LIMIT 20;
