--Description / thinking process:
-- Spatial predicates proved too restrictive, so use a name-based join instead:
-- 1) Map 2024 hail events to their county FIPS.
-- 2) Join those counties to ZIP codes by matching the county name text
--    (ZIP_CODES."county" usually stores the same name found in COUNTIES."county_name").
-- 3) Count hail events per ZIP to see which ZIPs are most frequently affected.
SELECT
       z."zip_code",
       COUNT(*) AS "hail_events_2024"
FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024"  s
JOIN   NOAA_DATA_PLUS.GEO_US_BOUNDARIES."COUNTIES"               c
           ON c."county_fips_code" = LPAD(s."cz_fips_code", 5, '0')
JOIN   NOAA_DATA_PLUS.GEO_US_BOUNDARIES."ZIP_CODES"              z
           ON z."county" ILIKE c."county_name"
WHERE  s."event_type" ILIKE '%hail%'
GROUP  BY z."zip_code"
ORDER  BY "hail_events_2024" DESC
LIMIT 20;
```
