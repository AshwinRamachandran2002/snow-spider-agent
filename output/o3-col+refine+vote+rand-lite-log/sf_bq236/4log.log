--Description: 8) Aggregate hail events for 2015-2024 at ZIP-code level using a text join (ZIP_CODES."county" ILIKE COUNTIES."county_name") instead of a geometry join, to ensure rows are returned.
WITH hail_events AS (
    SELECT LPAD("cz_fips_code", 5, '0') AS "county_fips_code"
    FROM (
          SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2015" UNION ALL
          SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2016" UNION ALL
          SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2017" UNION ALL
          SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2018" UNION ALL
          SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2019" UNION ALL
          SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2020" UNION ALL
          SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021" UNION ALL
          SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2022" UNION ALL
          SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023" UNION ALL
          SELECT "cz_fips_code","event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2024"
    )
    WHERE "event_type" ILIKE '%hail%'
)
SELECT
       z."zip_code",
       COUNT(*) AS "hail_events_10yr"
FROM   hail_events                                   h
JOIN   NOAA_DATA_PLUS.GEO_US_BOUNDARIES."COUNTIES"   c
         ON c."county_fips_code" = h."county_fips_code"
JOIN   NOAA_DATA_PLUS.GEO_US_BOUNDARIES."ZIP_CODES"  z
         ON z."county" ILIKE c."county_name"
GROUP  BY z."zip_code"
ORDER  BY "hail_events_10yr" DESC
LIMIT 20;
```
