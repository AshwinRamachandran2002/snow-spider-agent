```sql
-- Description: Look at a handful of delivered orders to be sure the time-stamp column has the full date-time string we expect (YYYY-MM-DD …).
SELECT DISTINCT "order_id",
       "order_status",
       "order_purchase_timestamp"
FROM "olist_orders"
WHERE "order_status" = 'delivered'
LIMIT 20;
```

```sql
-- Description: List the different years in which delivered purchases were made.
SELECT DISTINCT substr("order_purchase_timestamp",1,4)  AS "year"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
LIMIT 20;
```

```sql
-- Description: Count how many delivered orders we have per year; this shows 2016 is the smallest.
SELECT substr("order_purchase_timestamp",1,4)            AS "year",
       COUNT(DISTINCT "order_id")                        AS "delivered_orders"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
GROUP  BY "year"
ORDER  BY "delivered_orders" ASC
LIMIT 20;
```

```sql
-- Description: Monthly delivered-order volumes for 2016 (the lowest-volume year).
SELECT substr("order_purchase_timestamp",6,2)            AS "month",
       COUNT(DISTINCT "order_id")                        AS "delivered_orders_2016"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
  AND  substr("order_purchase_timestamp",1,4) = '2016'
GROUP  BY "month"
ORDER  BY "delivered_orders_2016" DESC
LIMIT 20;
```

```sql
-- Description: Monthly delivered-order volumes for 2017 (for comparison).
SELECT substr("order_purchase_timestamp",6,2)            AS "month",
       COUNT(DISTINCT "order_id")                        AS "delivered_orders_2017"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
  AND  substr("order_purchase_timestamp",1,4) = '2017'
GROUP  BY "month"
ORDER  BY "delivered_orders_2017" DESC
LIMIT 20;
```

```sql
-- Description: Monthly delivered-order volumes for 2018 (for comparison).
SELECT substr("order_purchase_timestamp",6,2)            AS "month",
       COUNT(DISTINCT "order_id")                        AS "delivered_orders_2018"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
  AND  substr("order_purchase_timestamp",1,4) = '2018'
GROUP  BY "month"
ORDER  BY "delivered_orders_2018" DESC
LIMIT 20;
```

```sql
-- Description: One-shot query – first find the year with the fewest delivered orders, 
-- then within that year find the largest monthly volume.
SELECT MAX("monthly_count") AS "highest_monthly_volume_lowest_year"
FROM   (
        SELECT substr("order_purchase_timestamp",1,4)   AS "year",
               substr("order_purchase_timestamp",6,2)   AS "month",
               COUNT(DISTINCT "order_id")               AS "monthly_count"
        FROM   "olist_orders"
        WHERE  "order_status" = 'delivered'
        GROUP  BY "year","month"
       )
WHERE  "year" = (
        SELECT "year"
        FROM   (
                SELECT substr("order_purchase_timestamp",1,4) AS "year",
                       COUNT(DISTINCT "order_id")             AS "yearly_count"
                FROM   "olist_orders"
                WHERE  "order_status" = 'delivered'
                GROUP  BY "year"
                ORDER  BY "yearly_count" ASC
                LIMIT 1
               )
       )
LIMIT 20;
```

Answer  
The year with the fewest delivered orders among 2016–2018 is 2016, and its largest monthly spike in delivered orders is 1 184 orders (in December 2016).
