-- Description: One-shot query – first find the year with the fewest delivered orders, 
-- then within that year find the largest monthly volume.
SELECT MAX("monthly_count") AS "highest_monthly_volume_lowest_year"
FROM   (
        SELECT substr("order_purchase_timestamp",1,4)   AS "year",
               substr("order_purchase_timestamp",6,2)   AS "month",
               COUNT(DISTINCT "order_id")               AS "monthly_count"
        FROM   "olist_orders"
        WHERE  "order_status" = 'delivered'
        GROUP  BY "year","month"
       )
WHERE  "year" = (
        SELECT "year"
        FROM   (
                SELECT substr("order_purchase_timestamp",1,4) AS "year",
                       COUNT(DISTINCT "order_id")             AS "yearly_count"
                FROM   "olist_orders"
                WHERE  "order_status" = 'delivered'
                GROUP  BY "year"
                ORDER  BY "yearly_count" ASC
                LIMIT 1
               )
       )
LIMIT 20;
