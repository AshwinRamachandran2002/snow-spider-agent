```sql
--3 Description: Count delivered orders per year (restricted to 2016-2018)
SELECT SUBSTR("order_purchase_timestamp",1,4)  AS "year",
       COUNT(*) AS "delivered_orders"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
  AND  SUBSTR("order_purchase_timestamp",1,4) IN ('2016','2017','2018')
GROUP  BY "year"
ORDER  BY "year"
LIMIT 20;
```

```sql
--4 Description: Find the year with the lowest delivered-order volume (2016-2018)
SELECT SUBSTR("order_purchase_timestamp",1,4)  AS "year",
       COUNT(*) AS "delivered_orders"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
  AND  SUBSTR("order_purchase_timestamp",1,4) IN ('2016','2017','2018')
GROUP  BY "year"
ORDER  BY "delivered_orders" ASC
LIMIT 1;
```

```sql
--5 Description: Show delivered-order counts per month for all three years
SELECT SUBSTR("order_purchase_timestamp",1,4)  AS "year",
       SUBSTR("order_purchase_timestamp",6,2)  AS "month",
       COUNT(*) AS "delivered_orders"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
  AND  SUBSTR("order_purchase_timestamp",1,4) IN ('2016','2017','2018')
GROUP  BY "year","month"
ORDER  BY "year","month"
LIMIT 20;
```

```sql
--6 Description: Focus on 2016 (the year with the lowest annual count) and list each month’s delivered-order volume
SELECT SUBSTR("order_purchase_timestamp",6,2)  AS "month",
       COUNT(*) AS "delivered_orders"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
  AND  SUBSTR("order_purchase_timestamp",1,4) = '2016'
GROUP  BY "month"
ORDER  BY "month"
LIMIT 20;
```

```sql
--7 Description: Retrieve 2016 monthly data ordered by volume descending
SELECT SUBSTR("order_purchase_timestamp",6,2)  AS "month",
       COUNT(*) AS "delivered_orders"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
  AND  SUBSTR("order_purchase_timestamp",1,4) = '2016'
GROUP  BY "month"
ORDER  BY "delivered_orders" DESC
LIMIT 20;
```

```sql
--8 Description: Get the single highest-volume month of 2016
SELECT SUBSTR("order_purchase_timestamp",6,2)  AS "month",
       COUNT(*) AS "delivered_orders"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
  AND  SUBSTR("order_purchase_timestamp",1,4) = '2016'
GROUP  BY "month"
ORDER  BY "delivered_orders" DESC
LIMIT 1;
