Query:
--Description: Highest monthly delivered-order volume in the year (2016-2018) that had the fewest delivered orders.
WITH yearly AS (   -- delivered orders per year
        SELECT strftime('%Y', "order_purchase_timestamp") AS yr,
               COUNT(*)                                   AS yr_cnt
        FROM   "olist_orders"
        WHERE  "order_status" = 'delivered'
          AND  strftime('%Y', "order_purchase_timestamp") IN ('2016','2017','2018')
        GROUP  BY yr
     ),
min_year AS (      -- pick the lowest-volume year
        SELECT yr
        FROM   yearly
        ORDER  BY yr_cnt
        LIMIT  1
     ),
monthly AS (       -- monthly counts within that year
        SELECT strftime('%m', "order_purchase_timestamp") AS mn,
               COUNT(*)                                   AS mn_cnt
        FROM   "olist_orders"
        WHERE  "order_status" = 'delivered'
          AND  strftime('%Y', "order_purchase_timestamp") = (SELECT yr FROM min_year)
        GROUP  BY mn
     )
SELECT MAX(mn_cnt) AS "highest_monthly_volume"
FROM   monthly
