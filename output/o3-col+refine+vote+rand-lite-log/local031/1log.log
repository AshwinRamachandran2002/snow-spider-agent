-- 5. Identify the year with the LOWEST delivered-order volume
SELECT "year",
       "delivered_orders"
FROM (
        SELECT strftime('%Y', "order_purchase_timestamp") AS "year",
               COUNT(*)                                   AS "delivered_orders"
        FROM   "olist_orders"
        WHERE  "order_status" = 'delivered'
          AND  strftime('%Y', "order_purchase_timestamp") IN ('2016','2017','2018')
        GROUP  BY "year"
     )
ORDER  BY "delivered_orders" ASC   -- smallest first
LIMIT 1;
