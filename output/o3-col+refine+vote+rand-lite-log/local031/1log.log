```sql
--Description: Identify the year (among 2016-2018) with the fewest delivered
--orders, then return the highest monthly delivered-order count within that
--same year—all in one statement.
WITH per_year AS (                         -- annual delivered-order totals
        SELECT strftime('%Y', "order_purchase_timestamp") AS yr,
               COUNT(*)                                   AS cnt
        FROM   "olist_orders"
        WHERE  "order_status" = 'delivered'
          AND  strftime('%Y', "order_purchase_timestamp") IN ('2016','2017','2018')
        GROUP  BY yr
     ),
lowest_year AS (                          -- the year with the lowest total
        SELECT yr
        FROM   per_year
        ORDER  BY cnt
        LIMIT  1
     ),
monthly AS (                              -- monthly counts inside that year
        SELECT strftime('%m', o."order_purchase_timestamp") AS mon,
               COUNT(*)                                     AS monthly_cnt
        FROM   "olist_orders" o
        JOIN   lowest_year ly ON strftime('%Y', o."order_purchase_timestamp") = ly.yr
        WHERE  o."order_status" = 'delivered'
        GROUP  BY mon
     )
SELECT MAX(monthly_cnt) AS highest_monthly_delivered_orders
FROM   monthly;
```
