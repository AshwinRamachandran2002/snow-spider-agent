```sql
-- 1. Discover all possible order statuses
SELECT DISTINCT "order_status"
FROM "olist_orders"
LIMIT 20;
```

```sql
-- 2. Look at a few delivered orders with their purchase timestamps
SELECT "order_id",
       "order_purchase_timestamp"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
LIMIT 20;
```

```sql
-- 3. List distinct years that have delivered orders (we expect 2016-2018)
SELECT DISTINCT strftime('%Y', "order_purchase_timestamp") AS "year"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
ORDER  BY "year"
LIMIT 20;
```

```sql
-- 4. Count delivered orders per year (2016, 2017, 2018)
SELECT strftime('%Y', "order_purchase_timestamp") AS "year",
       COUNT(*)                                       AS "delivered_orders"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
GROUP  BY "year"
ORDER  BY "year";
```

```sql
-- 5. Identify the year with the LOWEST delivered-order volume
SELECT "year",
       "delivered_orders"
FROM (
        SELECT strftime('%Y', "order_purchase_timestamp") AS "year",
               COUNT(*)                                   AS "delivered_orders"
        FROM   "olist_orders"
        WHERE  "order_status" = 'delivered'
          AND  strftime('%Y', "order_purchase_timestamp") IN ('2016','2017','2018')
        GROUP  BY "year"
     )
ORDER  BY "delivered_orders" ASC   -- smallest first
LIMIT 1;
```

```sql
-- 6. Monthly delivered-order counts for that lowest-volume year (replace X with the year returned in query 5)
SELECT strftime('%m', "order_purchase_timestamp") AS "month",
       COUNT(*)                                    AS "delivered_orders"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
  AND  strftime('%Y', "order_purchase_timestamp") = 'X'   -- ← plug in year from query 5
GROUP  BY "month"
ORDER  BY "month";
```

```sql
-- 7. Highest monthly delivered-order volume in that lowest-volume year
SELECT MAX("delivered_orders") AS "highest_monthly_volume"
FROM (
        SELECT strftime('%m', "order_purchase_timestamp") AS "month",
               COUNT(*)                                    AS "delivered_orders"
        FROM   "olist_orders"
        WHERE  "order_status" = 'delivered'
          AND  strftime('%Y', "order_purchase_timestamp") = 'X'   -- same year as above
        GROUP  BY "month"
     );
```
