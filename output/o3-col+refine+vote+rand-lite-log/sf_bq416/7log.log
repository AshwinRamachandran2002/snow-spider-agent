--Description: Some ERC-20 “Transfer” events contain uint256 values far
--             beyond Snowflake’s 38-digit NUMBER precision.  Casting such
--             strings directly raises an overflow error.  This query:
--               1)  Reads the value as TEXT from ARGS[2].
--               2)  Uses TRY_TO_NUMBER to convert it; overflowed values
--                   become NULL instead of erroring out.
--               3)  Scales the successfully-parsed amounts by 1 000 000
--                   (to imitate 6-decimal stable-coin units).
--               4)  Orders by the largest representable transfers,
--                   pushing NULLs (overflow cases) to the bottom.
SELECT
    "BLOCK_NUMBER",
    (PARSE_JSON("ARGS"))[0]::STRING                              AS "from_hex",
    (PARSE_JSON("ARGS"))[1]::STRING                              AS "to_hex",
    TRY_TO_NUMBER((PARSE_JSON("ARGS"))[2]::STRING) / 1000000     AS "amount_scaled"
FROM  GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS"
WHERE LOWER("EVENT_HASH") = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
ORDER BY "amount_scaled" DESC NULLS LAST
LIMIT 20;
```
