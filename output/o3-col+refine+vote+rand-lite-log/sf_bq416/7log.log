Query:
--Description: 8) Find transfers with scaled value ≥ 10 000 000 units
--              (roughly ≥ 10 M USDT-style tokens).  Uses TRY_TO_NUMBER to
--              keep rows within Snowflake precision and filters on the
--              scaled value.
SELECT DISTINCT
        "BLOCK_NUMBER",
        (PARSE_JSON("ARGS"))[0]::STRING                          AS "from_hex",
        (PARSE_JSON("ARGS"))[1]::STRING                          AS "to_hex",
        TRY_TO_NUMBER((PARSE_JSON("ARGS"))[2]::STRING) / 1000000 AS "amount_scaled"
FROM    GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS"
WHERE   LOWER("EVENT_HASH") = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND   TRY_TO_NUMBER((PARSE_JSON("ARGS"))[2]::STRING) / 1000000 >= 10000000
ORDER BY "amount_scaled" DESC
LIMIT   20
