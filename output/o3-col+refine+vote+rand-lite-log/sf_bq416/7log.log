--Description: 10) Cross-check raw LOGS rows for the three largest transfers
--               identified above by matching on transaction hash & log index.
SELECT  l."block_number",
        l."transaction_hash",
        l."log_index",
        l."topics",
        l."data"
FROM    GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS" l
JOIN   ( SELECT  "TRANSACTION_HASH",
                 "LOG_INDEX"
         FROM    GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS"
         WHERE   LOWER("EVENT_HASH") = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
         ORDER BY TRY_TO_NUMBER((PARSE_JSON("ARGS"))[2]::STRING) DESC NULLS LAST
         LIMIT   3
       ) AS top3
  ON l."transaction_hash" = top3."TRANSACTION_HASH"
 AND l."log_index"        = top3."LOG_INDEX"
LIMIT 20;
```
