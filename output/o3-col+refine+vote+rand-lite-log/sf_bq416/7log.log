```sql
--Description:  The prior query returned no rows because the “topics” column
--              stores an ARRAY; doing a plain ILIKE on the entire array
--              string can miss matches.  This version
--                • takes the three transaction hashes with the largest
--                  representable Transfer amounts,
--                • looks up their raw LOGS entries,
--                • FLATTENs the "topics" array, and
--                • keeps only those rows whose first topic equals the
--                  standard ERC-20 Transfer hash.
SELECT
    l."block_number",
    l."transaction_hash",
    l."log_index",
    l."address",
    l."topics"
FROM  GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS" l,
      LATERAL FLATTEN( INPUT => l."topics", OUTER => TRUE ) f
WHERE LOWER(l."transaction_hash") IN (
        SELECT  LOWER("TRANSACTION_HASH")
        FROM    GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS"
        WHERE   LOWER("EVENT_HASH") = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
        ORDER BY TRY_TO_NUMBER( (PARSE_JSON("ARGS"))[2]::STRING ) DESC NULLS LAST
        LIMIT 3
      )
  AND LOWER(f.value::STRING) = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
LIMIT 20;
