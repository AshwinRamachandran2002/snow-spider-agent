--Description: The earlier joins returned no rows, so remove any dependence
--             on transaction_hash or log_index.  Instead, pull every raw
--             LOGS record that (a) belongs to one of the three blocks that
--             host the largest representable ERC-20 “Transfer” events and
--             (b) itself contains the Transfer topic-0 hash.  This guarantees
--             data for cross-checking because it relies only on block_number
--             (which is always present) and the known topic hash.
SELECT  l."block_number",
        l."transaction_hash",
        l."log_index",
        l."address",
        l."topics",
        l."data"
FROM    GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS" l
WHERE   l."block_number" IN (
          SELECT  "BLOCK_NUMBER"
          FROM    GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS"
          WHERE   LOWER("EVENT_HASH") = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
          ORDER BY TRY_TO_NUMBER((PARSE_JSON("ARGS"))[2]::STRING) DESC NULLS LAST
          LIMIT 3
        )
  AND   l."topics" ILIKE '%ddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef%'
ORDER BY l."block_number" DESC,
         l."log_index"
LIMIT 20;
