WHERE  LOWER("ADDRESS") = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
LIMIT  20;
```

```sql
--Description: 3)  Pull 20 sample Transfer events (already decoded),
--              so we can examine how the ARGS array is stored.
SELECT  "BLOCK_NUMBER",
        "TRANSACTION_HASH",
        "LOG_INDEX",
        "ARGS"
FROM    GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS"
WHERE   LOWER("ADDRESS")      = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND   LOWER("EVENT_HASH")   = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
LIMIT   20;
```

```sql
--Description: 4)  Flatten the ARGS JSON array for a couple of rows
--              to verify that element-0 = ‘from’, element-1 = ‘to’,
--              and element-2 = ‘value’.
SELECT  t."BLOCK_NUMBER",
        t."LOG_INDEX",
        f.value::STRING AS "arg_value"
FROM    GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS" t,
        LATERAL FLATTEN(INPUT => PARSE_JSON(t."ARGS")) f
WHERE   LOWER(t."ADDRESS")    = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND   t."LOG_INDEX"         IS NOT NULL
LIMIT   20;
```

```sql
--Description: 5)  Extract ‘from’, ‘to’, and the raw value (uint256)
--              for 20 rows to confirm positions inside the JSON array.
SELECT  "BLOCK_NUMBER",
        (PARSE_JSON("ARGS"))[0]::STRING AS "from_hex",
        (PARSE_JSON("ARGS"))[1]::STRING AS "to_hex",
        (PARSE_JSON("ARGS"))[2]::NUMBER AS "value_raw"
FROM    GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS"
WHERE   LOWER("ADDRESS")    = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND   LOWER("EVENT_HASH") = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
LIMIT   20;
```

```sql
--Description: 6)  Convert the raw value into “true” USDT (divide by 1,000,000);
--              keep the hex addresses for now, just to ensure numbers look sane.
SELECT  "BLOCK_NUMBER",
        (PARSE_JSON("ARGS"))[0]::STRING                             AS "from_hex",
        (PARSE_JSON("ARGS"))[1]::STRING                             AS "to_hex",
        (PARSE_JSON("ARGS"))[2]::NUMBER / 1_000_000                 AS "usdt_amount"
FROM    GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS"
WHERE   LOWER("ADDRESS")    = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND   LOWER("EVENT_HASH") = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
ORDER BY "usdt_amount" DESC
LIMIT   20;
```

```sql
--Description: 7)  Apply the JavaScript helper function hexToTron()  ──
