FROM    GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS"
WHERE   LOWER("EVENT_HASH") = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND   TRY_TO_NUMBER((PARSE_JSON("ARGS"))[2]::STRING) / 1000000 >= 10000000
