```sql
--Description: Fetch the three arguments (“from”, “to”, “value”) already
--             decoded; keep them as VARIANT for now.
SELECT  "BLOCK_NUMBER",
        "ARGS"                                         AS "RAW_ARGS",
        PARSE_JSON("ARGS")[0]::STRING  AS "FROM_HEX",
        PARSE_JSON("ARGS")[1]::STRING  AS "TO_HEX",
        PARSE_JSON("ARGS")[2]::NUMBER  AS "RAW_VALUE"
FROM    "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE   "ADDRESS"     = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND   "EVENT_HASH"  = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
LIMIT   20;
```

```sql
--Description: Convert raw amounts (6-decimals) to real USDT amounts by
--             dividing by 1,000,000; order by biggest transfers.
SELECT  "BLOCK_NUMBER",
        PARSE_JSON("ARGS")[0]::STRING                  AS "FROM_HEX",
        PARSE_JSON("ARGS")[1]::STRING                  AS "TO_HEX",
        (PARSE_JSON("ARGS")[2]::NUMBER / 1e6)          AS "USDT_AMOUNT"
FROM    "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE   "ADDRESS"     = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND   "EVENT_HASH"  = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
ORDER BY "USDT_AMOUNT" DESC
LIMIT   20;
```

```sql
--Description: Prepare the data for TRON-formatted addresses by invoking
--             a (previously-registered) JavaScript UDF named HEX_TO_TRON
--             that turns an 0x… address into a Base58 TronLink address.
--             Show the largest 20 transfers.
SELECT  "BLOCK_NUMBER",
        HEX_TO_TRON(PARSE_JSON("ARGS")[0]::STRING)   AS "FROM_TRON",
        HEX_TO_TRON(PARSE_JSON("ARGS")[1]::STRING)   AS "TO_TRON",
        (PARSE_JSON("ARGS")[2]::NUMBER / 1e6)        AS "USDT_AMOUNT"
FROM    "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE   "ADDRESS"     = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND   "EVENT_HASH"  = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
ORDER BY "USDT_AMOUNT" DESC
LIMIT   20;
```

```sql
--Description: Same as prior query but restrict to DISTINCT transfers to
--             avoid duplicates that may come from chain re-orgs (`REMOVED`).
SELECT DISTINCT
        "BLOCK_NUMBER",
        HEX_TO_TRON(PARSE_JSON("ARGS")[0]::STRING)   AS "FROM_TRON",
        HEX_TO_TRON(PARSE_JSON("ARGS")[1]::STRING)   AS "TO_TRON",
        (PARSE_JSON("ARGS")[2]::NUMBER / 1e6)        AS "USDT_AMOUNT"
FROM    "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE   "ADDRESS"     = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND   "EVENT_HASH"  = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND   "REMOVED" = FALSE
ORDER BY "USDT_AMOUNT" DESC
LIMIT   20;
```

