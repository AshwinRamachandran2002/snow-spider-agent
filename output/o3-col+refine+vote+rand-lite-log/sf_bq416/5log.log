--Description: Safely list the top-20 largest ERC-20 Transfer events whose value fits into Snowflake’s numeric type: 
--1) TRY_TO_NUMBER converts the raw uint256 string; if it overflows, the result is NULL. 
--2) Keep only rows where the cast succeeded. 
--3) Divide by 1,000,000 to express a 6-decimal token amount, then sort descending.
SELECT
    BLOCK_NUMBER,
    PARSE_JSON(ARGS)[0]::STRING AS FROM_HEX,
    PARSE_JSON(ARGS)[1]::STRING AS TO_HEX,
    RAW_NUM / 1000000           AS TOKEN_AMOUNT
FROM (
    SELECT
