Query:
--Description: Show the three largest ERC-20 Transfer events that Snowflake can represent numerically; TRY_TO_NUMBER avoids overflow, then values are scaled to 6-decimal format.
SELECT
    BLOCK_NUMBER,
    PARSE_JSON(ARGS)[0]::STRING AS FROM_HEX,
    PARSE_JSON(ARGS)[1]::STRING AS TO_HEX,
    RAW_NUM / 1000000           AS TOKEN_AMOUNT
FROM (
    SELECT
        BLOCK_NUMBER,
        ARGS,
        TRY_TO_NUMBER(PARSE_JSON(ARGS)[2]::STRING) AS RAW_NUM
    FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
    WHERE EVENT_HASH = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
) sub
WHERE RAW_NUM IS NOT NULL
ORDER BY RAW_NUM DESC
LIMIT 3
