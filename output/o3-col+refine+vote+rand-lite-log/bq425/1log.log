```sql
--Description: Retrieve the latest (string-based) approval date per trade name for the exact company.
SELECT trade_name,
       MAX(approval_date) AS latest_approval_date
FROM `bigquery-public-data.ebi_chembl.products_23`
WHERE applicant_full_name = 'SanofiAventis'
GROUP BY trade_name
LIMIT 20;
```

```sql
--Description: Convert approval_date to DATE safely, then find the most recent date per trade name.
SELECT trade_name,
       FORMAT_DATE('%Y-%m-%d', MAX(SAFE.PARSE_DATE('%Y-%m-%d', approval_date))) AS latest_approval_date
FROM `bigquery-public-data.ebi_chembl.products_23`
