-- Distinct molecules whose applicant_full_name is exactly “SanofiAventis”
-- (case-insensitive comparison), keeping only the latest approval date
-- for each molecule across every ChEMBL “products” table.
WITH combined AS (
  -- products_30 stores approval_date as DATETIME
  SELECT
    trade_name,
    CAST(approval_date AS STRING)        AS approval_date_str,
    applicant_full_name
  FROM `bigquery-public-data.ebi_chembl.products_30`

  UNION ALL
  -- All other products tables store approval_date as STRING
  SELECT trade_name, approval_date AS approval_date_str, applicant_full_name
  FROM `bigquery-public-data.ebi_chembl.products`

  UNION ALL
  SELECT trade_name, approval_date AS approval_date_str, applicant_full_name
  FROM `bigquery-public-data.ebi_chembl.products_23`

  UNION ALL
  SELECT trade_name, approval_date AS approval_date_str, applicant_full_name
  FROM `bigquery-public-data.ebi_chembl.products_24`

  UNION ALL
  SELECT trade_name, approval_date AS approval_date_str, applicant_full_name
  FROM `bigquery-public-data.ebi_chembl.products_25`

  UNION ALL
  SELECT trade_name, approval_date AS approval_date_str, applicant_full_name
  FROM `bigquery-public-data.ebi_chembl.products_26`

  UNION ALL
  SELECT trade_name, approval_date AS approval_date_str, applicant_full_name
  FROM `bigquery-public-data.ebi_chembl.products_27`

  UNION ALL
  SELECT trade_name, approval_date AS approval_date_str, applicant_full_name
  FROM `bigquery-public-data.ebi_chembl.products_28`

  UNION ALL
  SELECT trade_name, approval_date AS approval_date_str, applicant_full_name
  FROM `bigquery-public-data.ebi_chembl.products_29`

  UNION ALL
  SELECT trade_name, approval_date AS approval_date_str, applicant_full_name
  FROM `bigquery-public-data.ebi_chembl.products_33`
)

SELECT
  trade_name,
  FORMAT_DATE(
    '%Y-%m-%d',
    MAX(
      SAFE.PARSE_DATE('%Y-%m-%d', SUBSTR(approval_date_str, 1, 10))
    )
  ) AS latest_approval_date
FROM combined
