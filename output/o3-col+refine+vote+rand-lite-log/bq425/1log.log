GROUP BY trade_name
LIMIT 20;
```

```sql
--Description: Show final list of distinct molecules (trade names) and their most recent approval date for “SanofiAventis”, ordered by date descending.
SELECT trade_name,
       MAX(approval_date) AS latest_approval_date
FROM `bigquery-public-data.ebi_chembl.products_23`
WHERE applicant_full_name = 'SanofiAventis'
GROUP BY trade_name
ORDER BY latest_approval_date DESC
LIMIT 20;
```

```sql
