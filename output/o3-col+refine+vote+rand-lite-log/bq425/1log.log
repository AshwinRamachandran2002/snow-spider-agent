```sql
-- List every distinct trade name whose applicant_full_name effectively equals
-- “SanofiAventis” (ignoring case, spaces, hyphens, and other non-letter
-- characters).  Keep only the most-recent approval date per trade name.
WITH sanofi_products AS (
  SELECT
    trade_name,
    CAST(approval_date AS STRING) AS approval_date_str
  FROM `bigquery-public-data.ebi_chembl.products*`
  -- Normalise applicant_full_name by removing everything except letters,
  -- then require an exact match to “sanofiaventis”.
  WHERE REGEXP_REPLACE(LOWER(applicant_full_name), r'[^a-z]', '') = 'sanofiaventis'
)

SELECT
  trade_name,
  FORMAT_DATE(
    '%Y-%m-%d',
    MAX(
      SAFE.PARSE_DATE('%Y-%m-%d', SUBSTR(approval_date_str, 1, 10))
    )
  ) AS latest_approval_date
FROM sanofi_products
GROUP BY trade_name
ORDER BY latest_approval_date DESC;
```
