Query:
--Description:
--5. Inspect all rows for any Sanofi-Aventis variant (contains both “sanofi” and “aventis”),
--   sorted by trade_name and approval_date.
SELECT
  trade_name,
  approval_date
FROM `bigquery-public-data.ebi_chembl.products_23`
WHERE LOWER(applicant_full_name) LIKE '%sanofi%'
  AND LOWER(applicant_full_name) LIKE '%aventis%'
ORDER BY trade_name, approval_date
LIMIT 20
