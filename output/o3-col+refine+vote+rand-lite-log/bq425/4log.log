Query:
--Description:
--6. Retrieve the latest approval date per molecule for every Sanofi-Aventis variant.
SELECT
  trade_name,
  MAX(approval_date) AS latest_approval_date
FROM `bigquery-public-data.ebi_chembl.products_23`
WHERE LOWER(applicant_full_name) LIKE '%sanofi%'
  AND LOWER(applicant_full_name) LIKE '%aventis%'
GROUP BY trade_name
LIMIT 20
Answer:
