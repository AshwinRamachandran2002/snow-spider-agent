Query:
--Description:
--7. Same as query 6 but with ARRAY_AGG to explicitly grab the most-recent date.
SELECT
  trade_name,
  (ARRAY_AGG(approval_date ORDER BY approval_date DESC LIMIT 1))[OFFSET(0)]
    AS latest_approval_date
FROM `bigquery-public-data.ebi_chembl.products_23`
WHERE LOWER(applicant_full_name) LIKE '%sanofi%'
  AND LOWER(applicant_full_name) LIKE '%aventis%'
GROUP BY trade_name
LIMIT 20
