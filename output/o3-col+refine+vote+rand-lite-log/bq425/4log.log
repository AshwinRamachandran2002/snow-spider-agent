```sql
-- 1. Quick look at ChEMBL Release 23 products table
SELECT *
FROM `bigquery-public-data.ebi_chembl.products_23`
LIMIT 20;
```

```sql
-- 2. Which applicant / company names do we have? (first 20 distinct)
SELECT DISTINCT applicant_full_name
FROM `bigquery-public-data.ebi_chembl.products_23`
LIMIT 20;
```

```sql
-- 3. Any company names that contain “sanofi” (case–insensitive)?
SELECT DISTINCT applicant_full_name
FROM `bigquery-public-data.ebi_chembl.products_23`
WHERE LOWER(applicant_full_name) LIKE '%sanofi%'
LIMIT 20;
```

```sql
-- 4. Distinct trade names that exactly belong to the company “SanofiAventis”
SELECT DISTINCT trade_name
FROM `bigquery-public-data.ebi_chembl.products_23`
WHERE applicant_full_name = 'SanofiAventis'
LIMIT 20;
```

```sql
-- 5. All rows for “SanofiAventis” to inspect dates (sorted)
SELECT trade_name,
       approval_date
FROM   `bigquery-public-data.ebi_chembl.products_23`
WHERE  applicant_full_name = 'SanofiAventis'
ORDER BY trade_name, approval_date
LIMIT 20;
```

```sql
-- 6. Latest approval date per molecule, keeping only that latest row
SELECT trade_name,
       MAX(approval_date) AS latest_approval_date
FROM   `bigquery-public-data.ebi_chembl.products_23`
WHERE  applicant_full_name = 'SanofiAventis'
GROUP BY trade_name
LIMIT 20;
```

```sql
-- 7. Same as above but using ARRAY_AGG to explicitly pull the most-recent date
SELECT trade_name,
       (ARRAY_AGG(approval_date ORDER BY approval_date DESC LIMIT 1))[OFFSET(0)]
         AS latest_approval_date
FROM   `bigquery-public-data.ebi_chembl.products_23`
WHERE  applicant_full_name = 'SanofiAventis'
GROUP BY trade_name
LIMIT 20;
```

```sql
-- 8. Show the final answer ordered by newest first
SELECT trade_name,
       MAX(approval_date) AS latest_approval_date
FROM   `bigquery-public-data.ebi_chembl.products_23`
WHERE  applicant_full_name = 'SanofiAventis'
GROUP BY trade_name
ORDER BY latest_approval_date DESC
LIMIT 20;
```

```sql
-- 9. (If needed) Return *all* distinct molecules with their latest date, no LIMIT
SELECT trade_name,
       MAX(approval_date) AS latest_approval_date
FROM   `bigquery-public-data.ebi_chembl.products_23`
WHERE  applicant_full_name = 'SanofiAventis'
GROUP BY trade_name;
```

