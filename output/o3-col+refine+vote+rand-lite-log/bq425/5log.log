Query:
--Description: 5) Get the distinct trade names that are associated with any applicant name
--              containing both “sanofi” and “aventis” (case-insensitive, any order / characters)
SELECT DISTINCT trade_name
FROM `bigquery-public-data.ebi_chembl.products_23`
WHERE REGEXP_CONTAINS(LOWER(applicant_full_name), r'sanofi.*aventis|aventis.*sanofi')
ORDER BY trade_name
LIMIT 20
