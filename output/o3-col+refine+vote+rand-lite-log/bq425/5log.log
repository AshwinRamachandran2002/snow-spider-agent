Query:
--Description: 6) For each of those trade names, show the earliest and latest recorded
--              approval dates where the applicant name includes both “sanofi” and “aventis”
SELECT
  trade_name,
  MIN(approval_date) AS first_approval,
  MAX(approval_date) AS last_approval
FROM `bigquery-public-data.ebi_chembl.products_23`
WHERE REGEXP_CONTAINS(LOWER(applicant_full_name), r'sanofi.*aventis|aventis.*sanofi')
GROUP BY trade_name
ORDER BY trade_name
LIMIT 20
