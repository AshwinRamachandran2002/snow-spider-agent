Query:
--Description: 7) FINAL ANSWER – distinct molecules (trade names) linked to any applicant that
--              contains both “sanofi” and “aventis”, keeping only the most recent approval date
SELECT
  trade_name,
  MAX(approval_date) AS latest_approval_date
FROM `bigquery-public-data.ebi_chembl.products_23`
WHERE REGEXP_CONTAINS(LOWER(applicant_full_name), r'sanofi.*aventis|aventis.*sanofi')
GROUP BY trade_name
ORDER BY trade_name
