--Description: Align `approval_date` to a DATE across two snapshots that store it differently
--              (DATETIME in products_30, STRING in products_23).  After normalising, UNION
--              the rows, then select the latest approval date for every molecule whose
--              applicant name contains both “sanofi” and “aventis”.
WITH unioned AS (
  -- products_30: DATETIME → DATE
  SELECT
    trade_name,
    DATE(approval_date) AS approval_dt
  FROM `bigquery-public-data.ebi_chembl.products_30`
  WHERE LOWER(applicant_full_name) LIKE '%sanofi%'
    AND LOWER(applicant_full_name) LIKE '%aventis%'

  UNION ALL

  -- products_23: STRING → DATE
  SELECT
    trade_name,
    PARSE_DATE('%F', SUBSTR(approval_date, 1, 10)) AS approval_dt
  FROM `bigquery-public-data.ebi_chembl.products_23`
  WHERE LOWER(applicant_full_name) LIKE '%sanofi%'
    AND LOWER(applicant_full_name) LIKE '%aventis%'
)

SELECT
  trade_name,
  MAX(approval_dt) AS latest_approval_date
FROM unioned
GROUP BY trade_name
ORDER BY latest_approval_date DESC
LIMIT 20;
```
