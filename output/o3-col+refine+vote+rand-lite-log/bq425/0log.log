Query:
--Description: 9) Final answer — return each distinct molecule (trade_name) that is associated
--              with any applicant name containing both “sanofi” and “aventis”, together with
--              the molecule’s most recent FDA approval date across two snapshots
--              (products_30 = DATETIME dates, products_23 = STRING dates).  Dates are first
--              normalised to DATE, then aggregated.
WITH unioned AS (
  -- products_30: cast DATETIME → DATE
  SELECT
    trade_name,
    DATE(approval_date) AS approval_dt
  FROM `bigquery-public-data.ebi_chembl.products_30`
  WHERE LOWER(applicant_full_name) LIKE '%sanofi%'
    AND LOWER(applicant_full_name) LIKE '%aventis%'

  UNION ALL

  -- products_23: parse STRING → DATE (use YYYY-MM-DD portion)
  SELECT
    trade_name,
    PARSE_DATE('%F', SUBSTR(approval_date, 1, 10)) AS approval_dt
  FROM `bigquery-public-data.ebi_chembl.products_23`
  WHERE LOWER(applicant_full_name) LIKE '%sanofi%'
    AND LOWER(applicant_full_name) LIKE '%aventis%'
)

SELECT
  trade_name,
  MAX(approval_dt) AS latest_approval_date
FROM unioned
GROUP BY trade_name
ORDER BY latest_approval_date DESC
LIMIT 20
