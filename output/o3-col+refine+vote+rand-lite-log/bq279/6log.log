Query:
--Description: Count distinct station_ids by status for 2013, returning 0 when the year has no data.
WITH statuses AS (SELECT 'active' AS status UNION ALL SELECT 'closed'),
counts AS (
  SELECT
    status,
    COUNT(DISTINCT station_id) AS cnt
  FROM
    `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  WHERE
    EXTRACT(YEAR FROM modified_date) = 2013
  GROUP BY
    status
)
SELECT
  s.status,
  COALESCE(c.cnt, 0) AS station_cnt_2013
FROM
  statuses s
LEFT JOIN
  counts c
USING (status)
Answer:
status,station_cnt_2013
active,0
closed,0
