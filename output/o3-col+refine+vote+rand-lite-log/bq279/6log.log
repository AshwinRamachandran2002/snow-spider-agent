```sql
--Description: The original goal is to show how many distinct bike-share stations were
--“active” and “closed” in 2013 and 2014.  The table actually contains no rows for those
--years, so a direct filter returns nothing.  
--To display meaningful output (returning zero counts when data are missing), this query:
--  1) Pre-aggregates the table by year & status to get distinct-station counts.
--  2) Creates a tiny in-memory list with the two target years (2013, 2014).
--  3) LEFT JOINs the year list to the pre-aggregated counts so each requested year
--     always appears, filling missing values with 0.
WITH year_counts AS (
  SELECT
    EXTRACT(YEAR FROM modified_date) AS yr,
    status,
    COUNT(DISTINCT station_id) AS cnt
  FROM
    `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  GROUP BY
    yr, status
),
years AS (
  -- list of target years
  SELECT y AS yr FROM UNNEST([2013, 2014]) AS y
)
SELECT
  y.yr AS year,
  COALESCE(a.cnt, 0) AS active_station_cnt,
  COALESCE(c.cnt, 0) AS closed_station_cnt
FROM
  years y
LEFT JOIN year_counts a
  ON a.yr = y.yr AND a.status = 'active'
LEFT JOIN year_counts c
  ON c.yr = y.yr AND c.status = 'closed'
ORDER BY
  year;
```
