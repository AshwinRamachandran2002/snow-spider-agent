  AND LOWER(status) = 'active'
LIMIT 20;
```

```sql
--Description: For year 2014, count distinct stations that are closed.
SELECT
  '2014'                 AS yr,
  COUNT(DISTINCT station_id) AS closed_stations
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE EXTRACT(YEAR FROM modified_date) = 2014
  AND LOWER(status) = 'closed'
LIMIT 20;
```

```sql
--Description: Put 2013 & 2014 results side-by-side in one table (pivot-style).
SELECT
  yr,
  SUM(CASE WHEN status = 'active' THEN cnt END) AS active_stations,
  SUM(CASE WHEN status = 'closed' THEN cnt END) AS closed_stations
FROM (
  SELECT
    EXTRACT(YEAR FROM modified_date) AS yr,
    LOWER(status)                    AS status,
    COUNT(DISTINCT station_id)       AS cnt
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  WHERE EXTRACT(YEAR FROM modified_date) IN (2013, 2014)
    AND LOWER(status) IN ('active', 'closed')
  GROUP BY yr, status
)
GROUP BY yr
ORDER BY yr
LIMIT 20;
```

```sql
--Description: Same as previous but formatted exactly as requested: number of distinct active and closed bike-share stations for each year 2013 & 2014.
