```sql
--Description (thinking process):
-- • We need the count of DISTINCT bike-share stations (station_id) that were
--   recorded as “active” or “closed” in calendar years 2013 and 2014.
-- • The table’s `modified_date` timestamp tells us when each row’s status was
--   registered, so EXTRACT(YEAR FROM modified_date) gives the calendar year.
-- • Using conditional DISTINCT counts lets us tally “active” vs “closed”
--   stations in one pass:
--     COUNT(DISTINCT IF(status='active', station_id, NULL)) … etc.
-- • Finally, we retain only the two target years in a HAVING clause.
SELECT
  EXTRACT(YEAR FROM modified_date) AS year,
  COUNT(DISTINCT IF(LOWER(status) = 'active', station_id, NULL)) AS active_station_cnt,
  COUNT(DISTINCT IF(LOWER(status) = 'closed', station_id, NULL)) AS closed_station_cnt
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
GROUP BY year
HAVING year IN (2013, 2014)
ORDER BY year;
```
