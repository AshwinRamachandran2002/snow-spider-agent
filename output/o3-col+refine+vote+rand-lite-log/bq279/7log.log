```sql
--Description (thinking process):
-- • Need: distinct-station counts marked “active” and “closed” during years 2013 & 2014.
-- • Step 1  – Summarise the stations table by calendar year (from modified_date)
--             using conditional DISTINCT counts for both statuses.
-- • Step 2  – Build a tiny inline table containing just the years 2013 and 2014.
-- • Step 3  – LEFT JOIN summary onto that inline year list; if a year has no
--             matching rows, the counts come back NULL, so COALESCE them to 0.
SELECT
  y.year,
  COALESCE(s.active_cnt, 0) AS active_station_cnt,
  COALESCE(s.closed_cnt, 0) AS closed_station_cnt
FROM (SELECT 2013 AS year UNION ALL SELECT 2014) AS y
LEFT JOIN (
  SELECT
    EXTRACT(YEAR FROM modified_date) AS year,
    COUNT(DISTINCT IF(LOWER(status) = 'active',  station_id, NULL)) AS active_cnt,
    COUNT(DISTINCT IF(LOWER(status) = 'closed', station_id, NULL)) AS closed_cnt
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  GROUP BY year
) AS s
ON y.year = s.year
ORDER BY y.year;
```
