  COUNT(DISTINCT CASE WHEN LOWER(status) = 'closed' THEN station_id END) AS closed_station_count
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE EXTRACT(YEAR FROM modified_date) IN (2013, 2014)
GROUP BY year
ORDER BY year
LIMIT 20;
