Query:
--Description: Same purpose—return the counts of distinct bike-share stations
--marked “active” or “closed” for calendar-years 2013 and 2014, even if the
--dataset contains no rows for those years.  A small inline table supplies the
--target years; we LEFT JOIN the real summary so missing years show up with 0.
SELECT
  y.year,
  COALESCE(s.active_cnt, 0) AS active_station_count,
  COALESCE(s.closed_cnt, 0) AS closed_station_count
FROM (SELECT 2013 AS year UNION ALL SELECT 2014) AS y
LEFT JOIN (
  SELECT
    EXTRACT(YEAR FROM modified_date)                                            AS year,
    COUNT(DISTINCT IF(LOWER(status) = 'active',  station_id, NULL)) AS active_cnt,
    COUNT(DISTINCT IF(LOWER(status) = 'closed', station_id, NULL)) AS closed_cnt
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  GROUP BY year
) AS s
ON y.year = s.year
ORDER BY y.year
Answer:
year,active_station_count,closed_station_count
2013,0,0
2014,0,0
