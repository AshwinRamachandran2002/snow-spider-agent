```sql
--Description: Count the number of distinct stations per status for the year 2013.  
SELECT
  EXTRACT(YEAR FROM modified_date) AS year,
  status,
  COUNT(DISTINCT station_id) AS station_cnt
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE EXTRACT(YEAR FROM modified_date) = 2013
GROUP BY year, status
ORDER BY status
LIMIT 20;
```

```sql
--Description: Count the number of distinct stations per status for the year 2014.  
SELECT
  EXTRACT(YEAR FROM modified_date) AS year,
  status,
  COUNT(DISTINCT station_id) AS station_cnt
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE EXTRACT(YEAR FROM modified_date) = 2014
GROUP BY year, status
ORDER BY status
LIMIT 20;
```

```sql
--Description: Combine the 2013 and 2014 counts in one result set.  
SELECT
  EXTRACT(YEAR FROM modified_date) AS year,
  status,
  COUNT(DISTINCT station_id) AS station_cnt
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE EXTRACT(YEAR FROM modified_date) IN (2013, 2014)
GROUP BY year, status
ORDER BY year, status
LIMIT 20;
```

```sql
--Description: Final answer – return one row per year with separate columns for ACTIVE and CLOSED distinct-station counts.  
SELECT
  year,
  COALESCE(active_cnt, 0)  AS active_stations,
  COALESCE(closed_cnt, 0)  AS closed_stations
FROM (
  SELECT
    EXTRACT(YEAR FROM modified_date) AS year,
    SUM(CASE WHEN LOWER(status) = 'active' THEN 1 ELSE 0 END) AS active_cnt,
    SUM(CASE WHEN LOWER(status) = 'closed' THEN 1 ELSE 0 END) AS closed_cnt
  FROM (
    SELECT DISTINCT station_id, status, modified_date
    FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
    WHERE EXTRACT(YEAR FROM modified_date) IN (2013, 2014)
  )
  GROUP BY year
)
ORDER BY year
LIMIT 20;
```
