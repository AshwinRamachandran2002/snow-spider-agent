Query:
--Description: Count the number of distinct stations per status for the year 2021 (first year with data).
SELECT
  2021                                              AS year,
  LOWER(status)                                     AS status,
  COUNT(DISTINCT station_id)                        AS station_cnt
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE EXTRACT(YEAR FROM modified_date) = 2021
GROUP BY status
ORDER BY status
LIMIT 20
