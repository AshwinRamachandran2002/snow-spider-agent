Query:
--Description: Final answer – return one row per year with separate columns for ACTIVE and CLOSED distinct-station counts (2021 & 2022).
SELECT
  year,
  COALESCE(active_cnt, 0)  AS active_stations,
  COALESCE(closed_cnt, 0)  AS closed_stations
FROM (
  SELECT
    EXTRACT(YEAR FROM modified_date)                                              AS year,
    COUNT(DISTINCT IF(LOWER(status) = 'active', station_id, NULL))                AS active_cnt,
    COUNT(DISTINCT IF(LOWER(status) = 'closed', station_id, NULL))                AS closed_cnt
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  WHERE EXTRACT(YEAR FROM modified_date) IN (2021, 2022)
  GROUP BY year
)
ORDER BY year
LIMIT 20
Answer:
year,active_stations,closed_stations
2021,71,22
2022,6,2
