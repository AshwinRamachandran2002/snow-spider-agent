Query:
--Description: Final summary for the years that actually exist (2021-2022):
--number of distinct stations by status (“active”, “closed”).
SELECT
  EXTRACT(YEAR FROM `modified_date`) AS yr,
  `status`,
  COUNT(DISTINCT `station_id`) AS num_stations
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE `status` IN ('active', 'closed')
  AND EXTRACT(YEAR FROM `modified_date`) IN (2021, 2022)
GROUP BY yr, `status`
ORDER BY yr, `status`
