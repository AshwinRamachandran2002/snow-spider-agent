Query:
--Description: 8) FINAL ANSWER – combined counts of distinct Active vs Closed stations for 2021 & 2022.
SELECT
  EXTRACT(YEAR FROM `modified_date`) AS year,
  LOWER(`status`)                   AS station_status,
  COUNT(DISTINCT `station_id`)      AS num_distinct_stations
FROM
  `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE
  EXTRACT(YEAR FROM `modified_date`) IN (2021, 2022)
  AND LOWER(`status`) IN ('active', 'closed')
GROUP BY
  year, station_status
ORDER BY
  year, station_status
Answer:
year,station_status,num_distinct_stations
2021,active,71
2021,closed,22
2022,active,6
2022,closed,2
