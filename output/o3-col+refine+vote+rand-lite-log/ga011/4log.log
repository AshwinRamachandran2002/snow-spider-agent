```sql
--8---------------------------------------------------------------
--Description:  Return the single page-path that has the *second* highest
--              number of page views on shop.googlemerchandisestore.com
--              during December 2020.
WITH december AS (
  SELECT
    REGEXP_REPLACE(
      REGEXP_REPLACE(
        REGEXP_REPLACE(ep.value.string_value,
                       r'^https?://shop\.googlemerchandisestore\.com', ''),
        r'/{2,}', '/'),
      r'[\?#].*', '')                           AS clean_path
  FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` AS t
  JOIN  UNNEST(t.event_params) AS ep
  WHERE t.event_name = 'page_view'
    AND ep.key       = 'page_location'
    AND ep.value.string_value LIKE 'https://shop.googlemerchandisestore.com%'
),
ranked AS (
  SELECT
    clean_path,
    COUNT(*) AS total_page_views,
    RANK() OVER (ORDER BY COUNT(*) DESC) AS rnk
  FROM   december
  GROUP  BY clean_path
)
SELECT clean_path AS second_most_viewed_page,
       total_page_views
FROM   ranked
WHERE  rnk = 2
LIMIT  1;
```

