--2---------------------------------------------------------------
--Description:  Peek into the key / value pairs that belong to a single
--              `page_view` event (we only look at the first 20 rows).
SELECT  ep.key ,
        ep.value.string_value AS string_v ,
        ep.value.int_value    AS int_v
FROM    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201` AS t
JOIN    UNNEST(t.event_params) AS ep
WHERE   t.event_name = 'page_view'
LIMIT   20;
