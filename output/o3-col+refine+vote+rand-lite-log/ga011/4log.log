```sql
--7---------------------------------------------------------------
--Description:  Aggregate total page views per cleaned path
--              for the whole month (top 10 pages).
WITH december AS (
  SELECT
    REGEXP_REPLACE(
      REGEXP_REPLACE(
        REGEXP_REPLACE(ep.value.string_value,
                       r'^https?://shop\.googlemerchandisestore\.com', ''),
        r'/{2,}', '/'),
      r'[\?#].*', '')                           AS clean_path
  FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` AS t
  JOIN  UNNEST(t.event_params) AS ep
  WHERE t.event_name = 'page_view'
    AND ep.key       = 'page_location'
    AND ep.value.string_value LIKE 'https://shop.googlemerchandisestore.com%'
)
SELECT   clean_path,
         COUNT(*) AS total_page_views
FROM     december
GROUP BY clean_path
ORDER BY total_page_views DESC
LIMIT    10;
