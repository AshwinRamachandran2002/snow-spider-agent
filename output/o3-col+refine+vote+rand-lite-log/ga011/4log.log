Query:
--4---------------------------------------------------------------
--Description:  Show how we “clean” the URL to keep only a tidy
--              page-path (remove protocol, domain, duplicate slashes, query-string).
SELECT
  ep.value.string_value                                         AS raw_url,
  -- remove protocol & domain
  REGEXP_REPLACE(ep.value.string_value,
                 r'^https?://shop\.googlemerchandisestore\.com', '')          AS no_domain,
  -- squeeze multiple slashes, drop query / fragment
  REGEXP_REPLACE( REGEXP_REPLACE(
                    REGEXP_REPLACE(ep.value.string_value,
                                   r'^https?://shop\.googlemerchandisestore\.com', ''),
                    r'/{2,}', '/'),
                  r'[\?#].*', '')                                             AS clean_path
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201` AS t
JOIN   UNNEST(t.event_params) AS ep
WHERE  t.event_name = 'page_view'
  AND  ep.key       = 'page_location'
  AND  ep.value.string_value LIKE 'https://shop.googlemerchandisestore.com%'
LIMIT  20;
