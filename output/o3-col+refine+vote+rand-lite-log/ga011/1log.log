Query:
--Description: 4) Count December page-views by domain to verify the main host names that appear  
SELECT REGEXP_EXTRACT(pl, r'^https?://([^/]+)') AS domain,
       COUNT(*)                                   AS pv
FROM (
  SELECT ep.value.string_value AS pl
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(`event_params`) AS ep
  WHERE `event_name` = 'page_view'
    AND ep.key      = 'page_location'
)
GROUP BY domain
ORDER BY pv DESC
LIMIT 20;
Answer:
domain,pv
shop.googlemerchandisestore.com,449206
googlemerchandisestore.com,19066
www.googlemerchandisestore.com,9246
www.googlemerchandisestore.com.,2
Query:
--Description: 5) Show the raw paths (portion after the host) for the target domain & their view counts  
SELECT REGEXP_EXTRACT(pl, r'^https?://[^/]+(.*)$') AS raw_path,
       COUNT(*)                                    AS pageviews
FROM (
  SELECT ep.value.string_value AS pl
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(`event_params`) AS ep
  WHERE `event_name` = 'page_view'
    AND ep.key      = 'page_location'
)
WHERE REGEXP_CONTAINS(pl, r'^https?://shop\.googlemerchandisestore\.com')
GROUP BY raw_path
ORDER BY pageviews DESC
LIMIT 20;
