```sql
--Description: 4) Count December page-views by domain to verify the main host names that appear  
SELECT REGEXP_EXTRACT(pl, r'^https?://([^/]+)') AS domain,
       COUNT(*)                                   AS pv
FROM (
  SELECT ep.value.string_value AS pl
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(`event_params`) AS ep
  WHERE `event_name` = 'page_view'
    AND ep.key      = 'page_location'
)
GROUP BY domain
ORDER BY pv DESC
LIMIT 20;
```

```sql
--Description: 5) Show the raw paths (portion after the host) for the target domain & their view counts  
SELECT REGEXP_EXTRACT(pl, r'^https?://[^/]+(.*)$') AS raw_path,
       COUNT(*)                                    AS pageviews
FROM (
  SELECT ep.value.string_value AS pl
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(`event_params`) AS ep
  WHERE `event_name` = 'page_view'
    AND ep.key      = 'page_location'
)
WHERE REGEXP_CONTAINS(pl, r'^https?://shop\.googlemerchandisestore\.com')
GROUP BY raw_path
ORDER BY pageviews DESC
LIMIT 20;
```

```sql
--Description: 6) Collapse duplicate slashes in the paths and aggregate total page-views  
SELECT REGEXP_REPLACE(raw_path, r'//+', '/') AS clean_path,
       SUM(pageviews)                         AS total_pageviews
FROM (
  SELECT REGEXP_EXTRACT(pl, r'^https?://[^/]+(.*)$') AS raw_path,
         1                                           AS pageviews
  FROM (
    SELECT ep.value.string_value AS pl
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
         UNNEST(`event_params`) AS ep
    WHERE `event_name` = 'page_view'
      AND ep.key      = 'page_location'
  )
  WHERE REGEXP_CONTAINS(pl, r'^https?://shop\.googlemerchandisestore\.com')
)
GROUP BY clean_path
ORDER BY total_pageviews DESC
LIMIT 20;
```

```sql
--Description: 7) Rank cleaned paths by total December page-views for the selected host  
SELECT clean_path,
       total_pageviews,
       RANK() OVER (ORDER BY total_pageviews DESC) AS rnk
FROM (
  SELECT REGEXP_REPLACE(raw_path, r'//+', '/') AS clean_path,
         COUNT(*)                              AS total_pageviews
  FROM (
    SELECT REGEXP_EXTRACT(ep.value.string_value, r'^https?://[^/]+(.*)$') AS raw_path
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
         UNNEST(`event_params`) AS ep
    WHERE `event_name` = 'page_view'
      AND ep.key      = 'page_location'
      AND REGEXP_CONTAINS(ep.value.string_value, r'^https?://shop\.googlemerchandisestore\.com')
  )
  GROUP BY clean_path
)
ORDER BY rnk
LIMIT 20;
```

