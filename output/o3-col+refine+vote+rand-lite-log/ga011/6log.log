```sql
--Description: Goal → find the page with the 2-nd highest number of page-views on
--             shop.googlemerchandisestore.com during December-2020.
--             Thinking steps (all done inside this single query):
--             1. Scan every GA4 daily table whose name starts with events_202012 (Dec-2020).
--             2. Keep only rows where event_name = 'page_view'.
--             3. UNNEST event_params and keep the element whose key = 'page_location'
--                (this gives us the full URL visited).
--             4. Filter URLs that belong to the required host.
--             5. Transform them:
--                  • REGEXP_EXTRACT → drop protocol & domain, leaving just the path.
--                  • REGEXP_REPLACE → collapse any double-slashes in that path.
--             6. Count hits per cleaned path.
--             7. Rank by view count (DENSE_RANK); pick rank = 2 → the 2-nd most viewed page.
--             8. Return that page path.
SELECT
  clean_path AS second_most_viewed_page
FROM (
  SELECT
    clean_path,
    views,
    DENSE_RANK() OVER (ORDER BY views DESC) AS rnk
  FROM (
    SELECT
      -- strip domain, then collapse duplicate slashes
      REGEXP_REPLACE(
        REGEXP_EXTRACT(ep.value.string_value,
                       r'^https?://shop\.googlemerchandisestore\.com/?(.*)$'),
        r'/+', '/') AS clean_path,
      COUNT(*) AS views
    FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
          , UNNEST(event_params) AS ep
    WHERE _TABLE_SUFFIX BETWEEN '01' AND '31'         -- Dec-2020 tables
      AND event_name = 'page_view'                    -- only page views
      AND ep.key = 'page_location'                    -- URL parameter
      AND ep.value.string_value LIKE
          'https://shop.googlemerchandisestore.com/%' -- desired host
    GROUP BY clean_path
  )
)
WHERE rnk = 2;
```
