--Description: 7) Produce a ranked list of cleaned page-paths by total December-2020 views
SELECT
  clean_path,
  views,
  DENSE_RANK() OVER (ORDER BY views DESC) AS rnk
FROM (
  SELECT
    REGEXP_REPLACE(
      REGEXP_EXTRACT(
        ep.value.string_value,
        r'^https?://shop\.googlemerchandisestore\.com/?(.*)$'
      ),
      r'/+', '/'
    )       AS clean_path,
    COUNT(*) AS views
  FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
        UNNEST(event_params) AS ep
  WHERE _TABLE_SUFFIX BETWEEN '01' AND '31'
    AND event_name = 'page_view'
    AND ep.key = 'page_location'
    AND ep.value.string_value LIKE 'https://shop.googlemerchandisestore.com/%'
  GROUP BY clean_path
)
ORDER BY views DESC
LIMIT 20
