```sql
--Description: 4) Count raw page_view hits per full URL on shop.googlemerchandisestore.com in December
SELECT
  JSON_EXTRACT_SCALAR(ep.value,'$.string_value') AS full_url,
  COUNT(*) AS raw_views
FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
      UNNEST(event_params) AS ep
WHERE _TABLE_SUFFIX BETWEEN '01' AND '31'
  AND event_name = 'page_view'
  AND ep.key = 'page_location'
  AND JSON_EXTRACT_SCALAR(ep.value,'$.string_value')
      LIKE 'https://shop.googlemerchandisestore.com/%'
GROUP BY full_url
ORDER BY raw_views DESC
LIMIT 20;
