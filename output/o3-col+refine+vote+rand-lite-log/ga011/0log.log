Query:
-- 6️⃣  Apply clean-up (collapse multiple “/” and substitute “/” for blank)
SELECT DISTINCT
  IF(path_clean = '', '/', path_clean) AS cleaned_path
FROM (
  SELECT
    REGEXP_REPLACE(
      REGEXP_EXTRACT(page_location,r'https?://shop\.googlemerchandisestore\.com([^?#]*)'),
      r'/+','/')  AS path_clean
  FROM (
    SELECT (SELECT value.string_value
            FROM   UNNEST(event_params)
            WHERE  key = 'page_location') AS page_location
    FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
    WHERE  event_name = 'page_view'
  )
)
LIMIT 20;
