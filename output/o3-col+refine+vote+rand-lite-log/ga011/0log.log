-- 7️⃣  Count page views per cleaned path for ONE day (1-Dec-2020) to check logic
SELECT
  IF(path_clean = '', '/', path_clean) AS page_path,
  COUNT(*)                             AS page_views
FROM (
  SELECT
    REGEXP_REPLACE(
      REGEXP_EXTRACT(
        (SELECT value.string_value FROM UNNEST(event_params) WHERE key='page_location'),
        r'https?://shop\.googlemerchandisestore\.com([^?#]*)'),
      r'/+','/') AS path_clean
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
  WHERE event_name = 'page_view'
)
GROUP BY page_path
ORDER BY page_views DESC
LIMIT 20;
