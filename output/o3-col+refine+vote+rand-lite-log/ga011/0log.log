        r'https?://shop\.googlemerchandisestore\.com([^?#]*)'),
      r'/+','/') AS path_clean
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
  WHERE event_name = 'page_view'
)
GROUP BY page_path
ORDER BY page_views DESC
LIMIT 20;
```

```sql
-- 8️⃣  Bring in ALL December 2020 tables with wildcard
SELECT
  IF(path_clean = '', '/', path_clean) AS page_path,
  COUNT(*)                             AS page_views
FROM (
  SELECT
    REGEXP_REPLACE(
      REGEXP_EXTRACT(
        (SELECT value.string_value FROM UNNEST(event_params) WHERE key='page_location'),
        r'https?://shop\.googlemerchandisestore\.com([^?#]*)'),
      r'/+','/') AS path_clean
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE _TABLE_SUFFIX BETWEEN '01' AND '31'
    AND event_name = 'page_view'
)
GROUP BY page_path
ORDER BY page_views DESC
LIMIT 20;
```

```sql
-- 9️⃣  Show the five most-viewed pages for the month (sanity check)
WITH december_pages AS (
  SELECT
    IF(path_clean = '', '/', path_clean) AS page_path
  FROM (
    SELECT
      REGEXP_REPLACE(
        REGEXP_EXTRACT(
          (SELECT value.string_value FROM UNNEST(event_params) WHERE key='page_location'),
          r'https?://shop\.googlemerchandisestore\.com([^?#]*)'),
        r'/+','/') AS path_clean
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
    WHERE _TABLE_SUFFIX BETWEEN '01' AND '31'
      AND event_name = 'page_view'
  )
)
SELECT page_path, COUNT(*) AS page_views
FROM   december_pages
GROUP  BY page_path
ORDER  BY page_views DESC
LIMIT 5;
```

```sql
-- 🔟  Final answer – the page with the 2nd-highest total page views in Dec-2020
WITH december_pages AS (
  SELECT
    IF(path_clean = '', '/', path_clean) AS page_path
  FROM (
    SELECT
      REGEXP_REPLACE(
        REGEXP_EXTRACT(
          (SELECT value.string_value FROM UNNEST(event_params) WHERE key='page_location'),
          r'https?://shop\.googlemerchandisestore\.com([^?#]*)'),
        r'/+','/') AS path_clean
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
    WHERE _TABLE_SUFFIX BETWEEN '01' AND '31'
      AND event_name = 'page_view'
  )
),
ranked AS (
  SELECT
    page_path,
    COUNT(*) AS page_views,
    DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS rnk
  FROM   december_pages
  GROUP  BY page_path
)
SELECT page_path
FROM   ranked
WHERE  rnk = 2
LIMIT 20;
```

