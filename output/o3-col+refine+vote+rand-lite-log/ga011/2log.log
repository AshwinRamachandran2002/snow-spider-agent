```sql
--4. Description: For the same day, extract the path part of the URL, replace
--   double-slashes with single ones, and remove a trailing slash.
SELECT
  REGEXP_REPLACE(               -- remove possible trailing “/”
    REGEXP_REPLACE(             -- collapse multiple “//” into one
      REGEXP_EXTRACT(page_location,
        r'https?://shop\.googlemerchandisestore\.com(/.*)'),
      r'/{2,}', '/'),
    r'/$', '')                 AS clean_path
FROM (
  SELECT JSON_VALUE(param.value, '$.string_value') AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`,
       UNNEST(event_params) AS param
  WHERE event_name = 'page_view'
    AND param.key = 'page_location'
    AND STARTS_WITH(JSON_VALUE(param.value, '$.string_value'),
                    'https://shop.googlemerchandisestore.com')
)
LIMIT 20;
