Query:
--Description: Count page views per cleaned path on 1-Dec-2020.
SELECT
  clean_path,
  COUNT(*) AS page_views
FROM (
  SELECT
    REGEXP_REPLACE(
      REGEXP_REPLACE(
        REGEXP_EXTRACT(
          p.value.string_value,
          r'https?://shop\.googlemerchandisestore\.com(/.*)'
        ),
        r'/{2,}', '/'),
      r'/$', ''
    ) AS clean_path
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
  CROSS JOIN UNNEST(event_params) AS p
  WHERE event_name = 'page_view'
    AND p.key = 'page_location'
    AND STARTS_WITH(p.value.string_value,
                    'https://shop.googlemerchandisestore.com')
)
GROUP BY clean_path
ORDER BY page_views DESC
LIMIT 20
