Query:
--Description: Extract cleaned URL paths for 1-Dec-2020.  
--             1) Pull `page_location` via `param.value.string_value`.  
--             2) Keep only rows whose URL starts with the target domain.  
--             3) Collapse double “//”, drop trailing “/”, and return 20 examples.
SELECT
  REGEXP_REPLACE(                       -- remove trailing “/”
    REGEXP_REPLACE(                     -- collapse multiple “//”
      REGEXP_EXTRACT(page_location,
                     r'https?://shop\.googlemerchandisestore\.com(/.*)'),
      r'/{2,}', '/'),
    r'/$', ''
  ) AS clean_path
FROM (
  SELECT param.value.string_value AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
  CROSS JOIN UNNEST(event_params) AS param
  WHERE event_name = 'page_view'
    AND param.key = 'page_location'
    AND STARTS_WITH(param.value.string_value,
                    'https://shop.googlemerchandisestore.com')
)
LIMIT 20
