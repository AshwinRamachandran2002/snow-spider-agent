Query:
--Description: Daily count of page views by raw path for host shop.googlemerchandisestore.com (1-Dec-2020)
-- Uses REGEXP_EXTRACT instead of the unavailable NET.PATH to isolate the URL path.
SELECT
  REGEXP_EXTRACT(ep.value.string_value, r'^[^:]+://[^/]+(/[^?#]*)') AS raw_path,
  COUNT(*)                                                          AS pv
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`,
     UNNEST(event_params) AS ep
WHERE event_name = 'page_view'
  AND ep.key  = 'page_location'
  AND NET.HOST(ep.value.string_value) = 'shop.googlemerchandisestore.com'
GROUP BY raw_path
ORDER BY pv DESC
LIMIT 20
