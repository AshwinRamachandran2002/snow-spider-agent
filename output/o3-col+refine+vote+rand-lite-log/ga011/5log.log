Query:
--Description: Rank paths by total December page views (cleaned paths)
WITH pageviews AS (
  SELECT
    REGEXP_REPLACE(
      REGEXP_REPLACE(
        REGEXP_EXTRACT(ep.value.string_value, r'^[^:]+://[^/]+(/[^?#]*)'),
        r'//+', '/'
      ),
      r'/$', ''
    ) AS clean_path,
    COUNT(*) AS pv
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` t,
       UNNEST(t.event_params) AS ep
  WHERE t.event_name = 'page_view'
    AND ep.key  = 'page_location'
    AND NET.HOST(ep.value.string_value) = 'shop.googlemerchandisestore.com'
  GROUP BY clean_path
)
SELECT
  clean_path,
  pv,
  RANK() OVER (ORDER BY pv DESC) AS rnk
FROM pageviews
ORDER BY rnk
LIMIT 20
