```sql
--Description: (thinking process in comments)
-- Goal: return the page (clean path) with the 2-nd highest total page-views in December-2020
-- Steps
-- 1) Scan every December 2020 table with wildcard events_202012*.
-- 2) UNNEST event_params and keep only the records whose key = 'page_location'.
-- 3) Restrict to the host “shop.googlemerchandisestore.com”.
-- 4) Extract the URL path (everything after the host, stopping before ? or #).
-- 5) Clean the path:
--      • Collapse multiple “/” → single “/”.
--      • Remove any trailing “/”.
-- 6) Aggregate to get total page-views by clean path.
-- 7) Rank by page-views and pick the one with rank = 2 (second most viewed).
WITH dec_paths AS (
  SELECT
    REGEXP_REPLACE(                              -- collapse duplicate slashes
      REGEXP_REPLACE(                            -- remove trailing slash
        REGEXP_EXTRACT(ep.value.string_value,
                       r'^[^:]+://[^/]+(/[^?#]*)'),   -- raw path
        r'/$', ''
      ),
      r'//+', '/'
    ) AS clean_path
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` AS t,
       UNNEST(t.event_params) AS ep
  WHERE t.event_name = 'page_view'
    AND ep.key = 'page_location'
    AND NET.HOST(ep.value.string_value) = 'shop.googlemerchandisestore.com'
),
path_counts AS (
  SELECT
    clean_path,
    COUNT(*) AS pv
  FROM dec_paths
  GROUP BY clean_path
),
ranked AS (
  SELECT
    clean_path,
    pv,
    ROW_NUMBER() OVER (ORDER BY pv DESC) AS rn
  FROM path_counts
)
SELECT clean_path AS second_highest_page, pv AS page_views
FROM ranked
WHERE rn = 2;
```
