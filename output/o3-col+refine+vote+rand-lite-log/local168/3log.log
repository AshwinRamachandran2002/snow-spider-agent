-- 9) Display again the names of the TOP-3 skills for reference
WITH top3 AS (
  SELECT s.skill_id,
         s.skills,
         COUNT(*) AS frequency
  FROM   job_postings_fact AS j
  JOIN   skills_job_dim    AS sj ON j.job_id = sj.job_id
  JOIN   skills_dim        AS s  ON sj.skill_id = s.skill_id
  WHERE  j.job_title_short   = 'Data Analyst'
    AND  j.job_work_from_home = 1
    AND  j.salary_year_avg   IS NOT NULL
  GROUP  BY s.skill_id, s.skills
