```sql
-- 5) Frequency of every skill found inside those qualifying postings
SELECT s.skills,
       COUNT(*) AS frequency
FROM   job_postings_fact  AS j
JOIN   skills_job_dim     AS sj ON j.job_id = sj.job_id
JOIN   skills_dim         AS s  ON sj.skill_id = s.skill_id
WHERE  j.job_title_short   = 'Data Analyst'
  AND  j.job_work_from_home = 1
  AND  j.salary_year_avg   IS NOT NULL
GROUP  BY s.skills
ORDER  BY frequency DESC
LIMIT 10;
```

```sql
-- 6) Identify the TOP-3 most frequently requested skills
SELECT s.skill_id,
       s.skills,
       COUNT(*) AS frequency
FROM   job_postings_fact  AS j
JOIN   skills_job_dim     AS sj ON j.job_id = sj.job_id
JOIN   skills_dim         AS s  ON sj.skill_id = s.skill_id
WHERE  j.job_title_short   = 'Data Analyst'
  AND  j.job_work_from_home = 1
  AND  j.salary_year_avg   IS NOT NULL
GROUP  BY s.skill_id, s.skills
ORDER  BY frequency DESC
LIMIT 3;
```

```sql
-- 7) Show a few job ids that require **any** of the TOP-3 skills
WITH top3 AS (
  SELECT s.skill_id
  FROM   job_postings_fact AS j
  JOIN   skills_job_dim    AS sj ON j.job_id = sj.job_id
  JOIN   skills_dim        AS s  ON sj.skill_id = s.skill_id
  WHERE  j.job_title_short   = 'Data Analyst'
    AND  j.job_work_from_home = 1
    AND  j.salary_year_avg   IS NOT NULL
  GROUP  BY s.skill_id
  ORDER  BY COUNT(*) DESC
  LIMIT 3
)
SELECT DISTINCT j.job_id
FROM   job_postings_fact AS j
JOIN   skills_job_dim    AS sj ON j.job_id = sj.job_id
WHERE  j.job_title_short   = 'Data Analyst'
  AND  j.job_work_from_home = 1
  AND  j.salary_year_avg   IS NOT NULL
  AND  sj.skill_id IN (SELECT skill_id FROM top3)
LIMIT 20;
```

```sql
-- 8) Compute the overall average annual salary for postings that
--    (a) are “Data Analyst”, (b) are remote, (c) have salary_year_avg,
--    AND (d) require at least one of the TOP-3 most frequent skills
WITH qualifying_jobs AS (
  SELECT job_id,
         salary_year_avg
  FROM   job_postings_fact
  WHERE  job_title_short   = 'Data Analyst'
    AND  job_work_from_home = 1
    AND  salary_year_avg   IS NOT NULL
),
top3 AS (
  SELECT s.skill_id
  FROM   job_postings_fact AS j
  JOIN   skills_job_dim    AS sj ON j.job_id = sj.job_id
  JOIN   skills_dim        AS s  ON sj.skill_id = s.skill_id
  WHERE  j.job_title_short   = 'Data Analyst'
    AND  j.job_work_from_home = 1
    AND  j.salary_year_avg   IS NOT NULL
  GROUP  BY s.skill_id
  ORDER  BY COUNT(*) DESC
  LIMIT 3
),
jobs_with_top3 AS (
  SELECT DISTINCT q.job_id,
                  q.salary_year_avg
  FROM   qualifying_jobs AS q
  JOIN   skills_job_dim  AS sj ON q.job_id = sj.job_id
  WHERE  sj.skill_id IN (SELECT skill_id FROM top3)
)
SELECT AVG(salary_year_avg) AS overall_avg_salary_year
FROM   jobs_with_top3;
```

