WHERE "job_title_short" LIKE '%Data Analyst%'
  AND "job_work_from_home" = 1
  AND "salary_year_avg" IS NOT NULL
LIMIT 20;
```

```sql
-- 4) Join those jobs to their attached skills (sample view).
SELECT DISTINCT sjd."job_id",
       sd."skills"
FROM   "job_postings_fact" AS jpf
JOIN   "skills_job_dim"  AS sjd ON jpf."job_id" = sjd."job_id"
JOIN   "skills_dim"      AS sd  ON sjd."skill_id" = sd."skill_id"
WHERE  jpf."job_title_short" LIKE '%Data Analyst%'
  AND  jpf."job_work_from_home" = 1
  AND  jpf."salary_year_avg" IS NOT NULL
LIMIT 20;
```

```sql
-- 5) Count how often each skill appears in the filtered postings (top 10 preview).
SELECT sd."skills",
       COUNT(*) AS "skill_count"
FROM   "job_postings_fact" AS jpf
JOIN   "skills_job_dim"  AS sjd ON jpf."job_id" = sjd."job_id"
JOIN   "skills_dim"      AS sd  ON sjd."skill_id" = sd."skill_id"
WHERE  jpf."job_title_short" LIKE '%Data Analyst%'
  AND  jpf."job_work_from_home" = 1
  AND  jpf."salary_year_avg" IS NOT NULL
GROUP BY sd."skills"
ORDER BY "skill_count" DESC
LIMIT 10;
```

```sql
-- 6) Retrieve ONLY the three most frequent skills for those postings.
SELECT sd."skills"
FROM   "job_postings_fact" AS jpf
JOIN   "skills_job_dim"  AS sjd ON jpf."job_id" = sjd."job_id"
JOIN   "skills_dim"      AS sd  ON sjd."skill_id" = sd."skill_id"
WHERE  jpf."job_title_short" LIKE '%Data Analyst%'
  AND  jpf."job_work_from_home" = 1
  AND  jpf."salary_year_avg" IS NOT NULL
GROUP BY sd."skills"
ORDER BY COUNT(*) DESC
LIMIT 3;
```

```sql
-- 7) See a sample of job_id values that contain at least one of those top-3 skills.
SELECT DISTINCT jpf."job_id"
FROM   "job_postings_fact" AS jpf
JOIN   "skills_job_dim"  AS sjd ON jpf."job_id" = sjd."job_id"
WHERE  jpf."job_title_short" LIKE '%Data Analyst%'
  AND  jpf."job_work_from_home" = 1
  AND  jpf."salary_year_avg" IS NOT NULL
  AND  sjd."skill_id" IN (
        /* top-3 skill_id list */
        SELECT sd."skill_id"
        FROM   "skills_dim" AS sd
        JOIN   "skills_job_dim"  AS sjd2 ON sd."skill_id" = sjd2."skill_id"
        JOIN   "job_postings_fact" AS jpf2 ON sjd2."job_id" = jpf2."job_id"
        WHERE  jpf2."job_title_short" LIKE '%Data Analyst%'
          AND  jpf2."job_work_from_home" = 1
          AND  jpf2."salary_year_avg" IS NOT NULL
        GROUP BY sd."skill_id"
        ORDER BY COUNT(*) DESC
        LIMIT 3)
LIMIT 20;
```

```sql
-- 8) FINAL ANSWER: overall average salary of remote Data-Analyst postings
--    that list at least one of the three most in-demand skills.
WITH top_skills AS (
    SELECT sd."skill_id"
    FROM   "skills_dim" AS sd
    JOIN   "skills_job_dim"  AS sjd ON sd."skill_id" = sjd."skill_id"
    JOIN   "job_postings_fact" AS jpf ON sjd."job_id" = jpf."job_id"
    WHERE  jpf."job_title_short" LIKE '%Data Analyst%'
      AND  jpf."job_work_from_home" = 1
      AND  jpf."salary_year_avg" IS NOT NULL
    GROUP BY sd."skill_id"
    ORDER BY COUNT(*) DESC
    LIMIT 3
),
relevant_jobs AS (
    SELECT DISTINCT jpf."job_id"
    FROM   "job_postings_fact" AS jpf
    JOIN   "skills_job_dim" AS sjd ON jpf."job_id" = sjd."job_id"
    WHERE  jpf."job_title_short" LIKE '%Data Analyst%'
      AND  jpf."job_work_from_home" = 1
      AND  jpf."salary_year_avg" IS NOT NULL
      AND  sjd."skill_id" IN (SELECT "skill_id" FROM top_skills)
)
SELECT AVG(jpf."salary_year_avg") AS "overall_avg_salary_top3skills"
FROM   "job_postings_fact" AS jpf
WHERE  jpf."job_id" IN (SELECT "job_id" FROM relevant_jobs);
```
