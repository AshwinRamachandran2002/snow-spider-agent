        JOIN   "job_postings_fact" AS jpf2 ON sjd2."job_id" = jpf2."job_id"
        WHERE  jpf2."job_title_short" LIKE '%Data Analyst%'
          AND  jpf2."job_work_from_home" = 1
          AND  jpf2."salary_year_avg" IS NOT NULL
