Query:
-- 6) Isolate the TOP-3 most frequent skills (CTE for re-use)
WITH top3 AS (
    SELECT  sd."skills"
    FROM    "skills_job_dim" AS sj
    JOIN    "skills_dim"     AS sd ON sj."skill_id" = sd."skill_id"
    JOIN    "job_postings_fact" AS jp ON sj."job_id" = jp."job_id"
    WHERE   jp."job_title_short" = 'Data Analyst'
      AND   jp."job_work_from_home" = 1
      AND   jp."salary_year_avg" IS NOT NULL
    GROUP BY sd."skills"
    ORDER BY COUNT(*) DESC
    LIMIT 3
)
SELECT * FROM top3;
