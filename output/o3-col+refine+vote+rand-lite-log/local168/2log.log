Query:
-- 9) Final answer: overall average salary for remote Data-Analyst jobs
--    that list at least one of the TOP-3 most frequent skills
WITH top3 AS (
    SELECT  sd."skills"
    FROM    "skills_job_dim" AS sj
    JOIN    "skills_dim"     AS sd ON sj."skill_id" = sd."skill_id"
    JOIN    "job_postings_fact" AS jp ON sj."job_id" = jp."job_id"
    WHERE   jp."job_title_short" = 'Data Analyst'
      AND   jp."job_work_from_home" = 1
      AND   jp."salary_year_avg" IS NOT NULL
    GROUP BY sd."skills"
    ORDER BY COUNT(*) DESC
    LIMIT 3
),
qualified_jobs AS (
    SELECT DISTINCT sj."job_id"
    FROM   "skills_job_dim"  AS sj
    JOIN   "skills_dim"      AS sd ON sj."skill_id" = sd."skill_id"
    JOIN   top3              ON sd."skills" = top3."skills"
)
SELECT AVG(jp."salary_year_avg") AS overall_avg_salary
FROM   "job_postings_fact" AS jp
JOIN   qualified_jobs qj ON jp."job_id" = qj."job_id";
