```sql
-- 1) Inspect remote “Data Analyst” postings that have an annual salary
SELECT  "job_id",
        "job_title_short",
        "job_work_from_home",
        "salary_year_avg"
FROM    "job_postings_fact"
WHERE   "job_title_short" = 'Data Analyst'
  AND   "job_work_from_home" = 1        -- remote
  AND   "salary_year_avg" IS NOT NULL
LIMIT 20;
```

```sql
-- 2) Fetch all DISTINCT job_ids that satisfy those three filters
SELECT DISTINCT "job_id"
FROM   "job_postings_fact"
WHERE  "job_title_short" = 'Data Analyst'
  AND  "job_work_from_home" = 1
  AND  "salary_year_avg" IS NOT NULL
LIMIT 20;
```

```sql
-- 3) Link the qualified job_ids to their skills (skill_id level)
SELECT  sj."job_id",
        sj."skill_id"
FROM    "skills_job_dim"  AS sj
JOIN    "job_postings_fact" AS jp
          ON sj."job_id" = jp."job_id"
WHERE   jp."job_title_short" = 'Data Analyst'
  AND   jp."job_work_from_home" = 1
  AND   jp."salary_year_avg" IS NOT NULL
LIMIT 20;
```

```sql
-- 4) Attach human-readable skill names
SELECT  sj."job_id",
        sd."skills"
FROM    "skills_job_dim"  AS sj
JOIN    "skills_dim"      AS sd ON sj."skill_id" = sd."skill_id"
JOIN    "job_postings_fact" AS jp ON sj."job_id" = jp."job_id"
WHERE   jp."job_title_short" = 'Data Analyst'
  AND   jp."job_work_from_home" = 1
  AND   jp."salary_year_avg" IS NOT NULL
LIMIT 20;
```

```sql
-- 5) Count how often each skill appears; order by frequency
SELECT  sd."skills",
        COUNT(*) AS freq
FROM    "skills_job_dim"  AS sj
JOIN    "skills_dim"      AS sd ON sj."skill_id" = sd."skill_id"
JOIN    "job_postings_fact" AS jp ON sj."job_id" = jp."job_id"
WHERE   jp."job_title_short" = 'Data Analyst'
  AND   jp."job_work_from_home" = 1
  AND   jp."salary_year_avg" IS NOT NULL
GROUP BY sd."skills"
ORDER BY freq DESC
LIMIT 10;
```

```sql
-- 6) Isolate the TOP-3 most frequent skills (CTE for re-use)
WITH top3 AS (
    SELECT  sd."skills"
    FROM    "skills_job_dim" AS sj
    JOIN    "skills_dim"     AS sd ON sj."skill_id" = sd."skill_id"
    JOIN    "job_postings_fact" AS jp ON sj."job_id" = jp."job_id"
    WHERE   jp."job_title_short" = 'Data Analyst'
      AND   jp."job_work_from_home" = 1
      AND   jp."salary_year_avg" IS NOT NULL
    GROUP BY sd."skills"
    ORDER BY COUNT(*) DESC
    LIMIT 3
)
SELECT * FROM top3;
```

```sql
-- 7) Get DISTINCT job_ids that require at least one of those TOP-3 skills
WITH top3 AS (
    SELECT  sd."skills"
    FROM    "skills_job_dim" AS sj
    JOIN    "skills_dim"     AS sd ON sj."skill_id" = sd."skill_id"
    JOIN    "job_postings_fact" AS jp ON sj."job_id" = jp."job_id"
    WHERE   jp."job_title_short" = 'Data Analyst'
      AND   jp."job_work_from_home" = 1
      AND   jp."salary_year_avg" IS NOT NULL
    GROUP BY sd."skills"
    ORDER BY COUNT(*) DESC
    LIMIT 3
)
SELECT DISTINCT sj."job_id"
FROM   "skills_job_dim"  AS sj
JOIN   "skills_dim"      AS sd ON sj."skill_id" = sd."skill_id"
JOIN   top3              ON sd."skills" = top3."skills"
LIMIT 20;
```

```sql
-- 8) Combine those job_ids back to facts and view their salaries
WITH top3 AS (
    SELECT  sd."skills"
    FROM    "skills_job_dim" AS sj
    JOIN    "skills_dim"     AS sd ON sj."skill_id" = sd."skill_id"
    JOIN    "job_postings_fact" AS jp ON sj."job_id" = jp."job_id"
    WHERE   jp."job_title_short" = 'Data Analyst'
      AND   jp."job_work_from_home" = 1
      AND   jp."salary_year_avg" IS NOT NULL
    GROUP BY sd."skills"
    ORDER BY COUNT(*) DESC
    LIMIT 3
),
qualified_jobs AS (
    SELECT DISTINCT sj."job_id"
    FROM   "skills_job_dim"  AS sj
    JOIN   "skills_dim"      AS sd ON sj."skill_id" = sd."skill_id"
    JOIN   top3              ON sd."skills" = top3."skills"
)
SELECT jp."job_id",
       jp."salary_year_avg"
FROM   "job_postings_fact" AS jp
JOIN   qualified_jobs       qj ON jp."job_id" = qj."job_id"
LIMIT 20;
```

```sql
-- 9) Final answer: overall average salary for remote Data-Analyst jobs
--    that list at least one of the TOP-3 most frequent skills
WITH top3 AS (
    SELECT  sd."skills"
    FROM    "skills_job_dim" AS sj
    JOIN    "skills_dim"     AS sd ON sj."skill_id" = sd."skill_id"
    JOIN    "job_postings_fact" AS jp ON sj."job_id" = jp."job_id"
    WHERE   jp."job_title_short" = 'Data Analyst'
      AND   jp."job_work_from_home" = 1
      AND   jp."salary_year_avg" IS NOT NULL
    GROUP BY sd."skills"
    ORDER BY COUNT(*) DESC
    LIMIT 3
),
qualified_jobs AS (
    SELECT DISTINCT sj."job_id"
    FROM   "skills_job_dim"  AS sj
    JOIN   "skills_dim"      AS sd ON sj."skill_id" = sd."skill_id"
    JOIN   top3              ON sd."skills" = top3."skills"
)
SELECT AVG(jp."salary_year_avg") AS overall_avg_salary
FROM   "job_postings_fact" AS jp
JOIN   qualified_jobs qj ON jp."job_id" = qj."job_id";
```

Each successive query builds on the previous ones—from discovering the relevant postings, determining the three most in-demand skills, gathering the qualifying job IDs, and finally producing a single number: the overall average annual salary for remote Data Analyst roles requiring any of those top three skills.
