```sql
-- Description (thinking process):
-- 1) Filter “Data Analyst” postings that are remote (job_work_from_home = 1) and have a non-NULL annual salary.
-- 2) Within that filtered set, count how often each skill_id occurs and keep the TOP-3 most-frequent skills
--    (sub-subquery: GROUP BY skill_id ORDER BY COUNT(*) DESC LIMIT 3).
-- 3) From the original filtered postings, retain only those jobs that list at least one of those TOP-3 skills
--    (EXISTS with IN-list produced in step 2).
-- 4) Take the average salary_year_avg of the resulting jobs.
SELECT AVG(jpf."salary_year_avg") AS overall_avg_salary_top3_skills
FROM   "job_postings_fact" AS jpf
WHERE  jpf."job_title_short"    = 'Data Analyst'
  AND  jpf."job_work_from_home" = 1
  AND  jpf."salary_year_avg"    IS NOT NULL
  AND  EXISTS (
        SELECT 1
        FROM   "skills_job_dim" AS sjd
        WHERE  sjd."job_id" = jpf."job_id"
          AND  sjd."skill_id" IN (
                 SELECT skill_counts."skill_id"
                 FROM   (
                          SELECT sjd2."skill_id",
                                 COUNT(*) AS freq
                          FROM   "skills_job_dim"   AS sjd2
                          JOIN   "job_postings_fact" AS jpf2
                                 ON jpf2."job_id" = sjd2."job_id"
                          WHERE  jpf2."job_title_short"    = 'Data Analyst'
                            AND  jpf2."job_work_from_home" = 1
                            AND  jpf2."salary_year_avg"    IS NOT NULL
                          GROUP BY sjd2."skill_id"
                          ORDER BY freq DESC
                          LIMIT 3
                        ) AS skill_counts
              )
      );
```
