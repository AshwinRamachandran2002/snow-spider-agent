Query:
-- Description: Count how often each skill occurs for those remote Data-Analyst jobs
SELECT   sd."skill_id",
         sd."skills",
         COUNT(*) AS "skill_frequency"
FROM     "skills_job_dim" AS sjd
JOIN     "skills_dim"     AS sd  ON sd."skill_id" = sjd."skill_id"
JOIN     "job_postings_fact" AS jpf
         ON jpf."job_id" = sjd."job_id"
WHERE    jpf."job_title_short"   = 'Data Analyst'
  AND    jpf."job_work_from_home" = 1
  AND    jpf."salary_year_avg"   IS NOT NULL
GROUP BY sd."skill_id", sd."skills"
ORDER BY COUNT(*) DESC
LIMIT    3;
