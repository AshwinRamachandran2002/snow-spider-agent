-- Description: Count how many remote “Data Analyst” jobs (with non-NULL annual salary) list at least one of the TOP-3 most-frequent skills for that same subset.
SELECT COUNT(DISTINCT jpf."job_id") AS n_jobs_with_top3_skills
FROM   "job_postings_fact" AS jpf
WHERE  jpf."job_title_short"    = 'Data Analyst'
  AND  jpf."job_work_from_home" = 1
  AND  jpf."salary_year_avg"    IS NOT NULL
  AND  EXISTS (
        SELECT 1
        FROM   "skills_job_dim" AS sjd
        WHERE  sjd."job_id" = jpf."job_id"
          AND  sjd."skill_id" IN (
                 SELECT sjd_inner."skill_id"
