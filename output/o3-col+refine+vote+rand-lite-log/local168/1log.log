                 SELECT sd_inner."skill_id"
                 FROM   "skills_job_dim" AS sjd_inner
                 JOIN   "skills_dim"     AS sd_inner
                        ON sd_inner."skill_id" = sjd_inner."skill_id"
                 JOIN   "job_postings_fact" AS jpf_inner
                        ON jpf_inner."job_id" = sjd_inner."job_id"
                 WHERE  jpf_inner."job_title_short"   = 'Data Analyst'
                   AND  jpf_inner."job_work_from_home" = 1
                   AND  jpf_inner."salary_year_avg"   IS NOT NULL
                 GROUP BY sd_inner."skill_id"
                 ORDER BY COUNT(*) DESC
