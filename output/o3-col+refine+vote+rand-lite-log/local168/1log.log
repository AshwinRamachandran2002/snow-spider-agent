Query:
-- Description: Compute the overall average salary_year_avg for remote “Data Analyst” jobs that require any of the TOP-3 most-frequent skills identified within that subset.
SELECT AVG(jpf."salary_year_avg") AS overall_avg_salary_top3_skills
