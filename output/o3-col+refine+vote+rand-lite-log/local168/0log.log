       "job_work_from_home"
FROM   "job_postings_fact"
WHERE  "job_title_short" = 'Data Analyst'
  AND  "job_work_from_home" = 1
  AND  "salary_year_avg" IS NOT NULL
LIMIT 20;
```

```sql
-- Description: Pull the skills tied to those filtered postings
--   (join to the bridge table only).
SELECT sj."job_id",
       sj."skill_id"
FROM   "skills_job_dim"  AS sj
WHERE  sj."job_id" IN (
         SELECT "job_id"
         FROM   "job_postings_fact"
         WHERE  "job_title_short"   = 'Data Analyst'
           AND  "job_work_from_home" = 1
           AND  "salary_year_avg"   IS NOT NULL
       )
LIMIT 20;
```

```sql
-- Description: Join in the skills_dim table to see the names of the skills.
SELECT sj."job_id",
       sd."skill_id",
       sd."skills"        AS "skill_name"
FROM   "skills_job_dim"  AS sj
JOIN   "skills_dim"      AS sd
           ON sj."skill_id" = sd."skill_id"
WHERE  sj."job_id" IN (
         SELECT "job_id"
         FROM   "job_postings_fact"
         WHERE  "job_title_short"   = 'Data Analyst'
           AND  "job_work_from_home" = 1
           AND  "salary_year_avg"   IS NOT NULL
       )
LIMIT 20;
```

```sql
-- Description: Count how many times each skill occurs in those filtered postings.
SELECT sd."skill_id",
       sd."skills"      AS "skill_name",
       COUNT(*)         AS "skill_frequency"
FROM   "skills_job_dim" AS sj
JOIN   "skills_dim"     AS sd
          ON sj."skill_id" = sd."skill_id"
WHERE  sj."job_id" IN (
         SELECT "job_id"
         FROM   "job_postings_fact"
         WHERE  "job_title_short"   = 'Data Analyst'
           AND  "job_work_from_home" = 1
           AND  "salary_year_avg"   IS NOT NULL
       )
GROUP BY sd."skill_id", sd."skills"
ORDER BY "skill_frequency" DESC
LIMIT 20;
```

```sql
-- Description: Identify the TOP 3 most-frequent skills among the remote,
--   salaried Data-Analyst postings.
SELECT sd."skill_id",
       sd."skills"      AS "skill_name",
       COUNT(*)         AS "skill_frequency"
FROM   "skills_job_dim" AS sj
JOIN   "skills_dim"     AS sd
          ON sj."skill_id" = sd."skill_id"
WHERE  sj."job_id" IN (
         SELECT "job_id"
         FROM   "job_postings_fact"
         WHERE  "job_title_short"   = 'Data Analyst'
           AND  "job_work_from_home" = 1
           AND  "salary_year_avg"   IS NOT NULL
       )
GROUP BY sd."skill_id", sd."skills"
ORDER BY "skill_frequency" DESC
LIMIT 3;
```

```sql
-- Description: Compute the overall average yearly salary for postings that
--   contain ANY of those Top-3 skills (still restricted to remote, salaried
--   Data-Analyst jobs).
WITH filtered_jobs AS (
    SELECT "job_id",
           "salary_year_avg"
    FROM   "job_postings_fact"
    WHERE  "job_title_short"   = 'Data Analyst'
      AND  "job_work_from_home" = 1
      AND  "salary_year_avg"   IS NOT NULL
),
top3_skills AS (
    SELECT sd."skill_id"
    FROM   "skills_job_dim" AS sj
    JOIN   "skills_dim"     AS sd
             ON sj."skill_id" = sd."skill_id"
    WHERE  sj."job_id" IN (SELECT "job_id" FROM filtered_jobs)
    GROUP BY sd."skill_id"
    ORDER BY COUNT(*) DESC
    LIMIT 3
),
jobs_with_top3 AS (
    SELECT DISTINCT sj."job_id"
    FROM   "skills_job_dim" AS sj
    WHERE  sj."skill_id" IN (SELECT "skill_id" FROM top3_skills)
)
SELECT ROUND(AVG(fj."salary_year_avg"), 2) AS "overall_avg_salary_top3"
FROM   filtered_jobs AS fj
JOIN   jobs_with_top3 AS jt3
       ON fj."job_id" = jt3."job_id";
```

