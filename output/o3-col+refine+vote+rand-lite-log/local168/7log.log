Query:
-- 5) Frequency of every skill that appears in those filtered postings
SELECT
       sd."skills",
       COUNT(*) AS "frequency"
FROM   "job_postings_fact" AS jpf
JOIN   "skills_job_dim"    AS sjd ON jpf."job_id" = sjd."job_id"
JOIN   "skills_dim"        AS sd  ON sjd."skill_id" = sd."skill_id"
WHERE  jpf."job_title_short"    LIKE '%Data Analyst%'
  AND  jpf."job_work_from_home" = 1
  AND  jpf."salary_year_avg"    IS NOT NULL
GROUP BY sd."skills"
ORDER BY "frequency" DESC
LIMIT 10;
Answer:
skills,frequency
python,3
sharepoint,1
qlik,1
Query:
-- 6) Identify the TOP-3 most frequently requested skills (skill-id + name + count)
SELECT
       sjd."skill_id",
       sd."skills",
       COUNT(*) AS "frequency"
FROM   "job_postings_fact" AS jpf
JOIN   "skills_job_dim"    AS sjd ON jpf."job_id" = sjd."job_id"
JOIN   "skills_dim"        AS sd  ON sjd."skill_id" = sd."skill_id"
WHERE  jpf."job_title_short"    LIKE '%Data Analyst%'
  AND  jpf."job_work_from_home" = 1
  AND  jpf."salary_year_avg"    IS NOT NULL
GROUP BY sjd."skill_id"
ORDER BY "frequency" DESC
LIMIT 3;
Answer:
skill_id,skills,frequency
1,python,3
195,sharepoint,1
187,qlik,1
Query:
--Description: Simplified & corrected “FINAL ANSWER” query.
--             Computes the overall average annual salary for remote “Data Analyst” postings
--             that specify a salary and list at least one of the three most-frequent skills
--             (python = 1, sharepoint = 195, qlik = 187).
SELECT
       AVG(jpf."salary_year_avg") AS overall_avg_salary_top3skills
FROM   "job_postings_fact" AS jpf
WHERE  jpf."job_title_short"    LIKE '%Data Analyst%'
  AND  jpf."job_work_from_home" = 1
  AND  jpf."salary_year_avg"    IS NOT NULL
  AND  EXISTS (
        SELECT 1
        FROM   "skills_job_dim" AS sjd
        WHERE  sjd."job_id"   = jpf."job_id"
          AND  sjd."skill_id" IN (1, 195, 187)   -- python, sharepoint, qlik
      )
Answer:
overall_avg_salary_top3skills
