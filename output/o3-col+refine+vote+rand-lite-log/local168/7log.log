```sql
--Description: We already determined that the three most frequently required skills for remote,
--             salaried “Data Analyst” roles are python (skill_id 1), sharepoint (195) and qlik (187).
--             The query below therefore:
--             1. Filters job_postings_fact to “Data Analyst” (any seniority), remote (job_work_from_home = 1),
--                and with a non-null annual salary.
--             2. Keeps only those jobs that list at least one of the three top skills via EXISTS on skills_job_dim.
--             3. Calculates the overall average of salary_year_avg for that subset.
SELECT
       AVG(jpf."salary_year_avg") AS overall_avg_salary_top3skills
FROM   "job_postings_fact" AS jpf
WHERE  jpf."job_title_short"    LIKE '%Data Analyst%'
  AND  jpf."job_work_from_home" = 1
  AND  jpf."salary_year_avg"    IS NOT NULL
  AND  EXISTS (
        SELECT 1
        FROM   "skills_job_dim" AS sjd
        WHERE  sjd."job_id"   = jpf."job_id"
          AND  sjd."skill_id" IN (1, 195, 187)    -- python, sharepoint, qlik
      );
