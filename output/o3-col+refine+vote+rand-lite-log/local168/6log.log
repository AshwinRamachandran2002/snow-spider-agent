```

```sql
-- 2. Find those that are remote (job_work_from_home = 1) 
--    and contain a non-NULL annual salary figure
SELECT DISTINCT
       "job_id",
       "job_title_short",
       "job_location",
       "salary_year_avg"
FROM   "job_postings_fact"
WHERE  "job_title_short"       = 'Data Analyst'
  AND  "job_work_from_home"    = 1
  AND  "salary_year_avg"       IS NOT NULL
LIMIT 20;
```

```sql
-- 3. Count how many remote, salaried “Data Analyst” postings exist
SELECT COUNT(*) AS "cnt_remote_da_salary"
FROM   "job_postings_fact"
WHERE  "job_title_short" = 'Data Analyst'
  AND  "job_work_from_home" = 1
  AND  "salary_year_avg" IS NOT NULL;
```

```sql
-- 4. Bring in skills linked to those job_ids
SELECT DISTINCT 
       sjd."job_id",
       sjd."skill_id"
FROM   "skills_job_dim"  AS sjd
JOIN   "job_postings_fact" AS jpf
       ON sjd."job_id" = jpf."job_id"
WHERE  jpf."job_title_short"   = 'Data Analyst'
  AND  jpf."job_work_from_home" = 1
  AND  jpf."salary_year_avg"    IS NOT NULL
LIMIT 20;
```

```sql
-- 5. Translate skill_id to actual skill names
SELECT DISTINCT
       sjd."job_id",
       sd."skill_id",
       sd."skills"
FROM   "skills_job_dim"  AS sjd
JOIN   "skills_dim"      AS sd  ON sjd."skill_id" = sd."skill_id"
JOIN   "job_postings_fact" AS jpf
       ON sjd."job_id" = jpf."job_id"
WHERE  jpf."job_title_short"   = 'Data Analyst'
  AND  jpf."job_work_from_home" = 1
  AND  jpf."salary_year_avg"    IS NOT NULL
LIMIT 20;
```

```sql
-- 6. Frequency of each skill among the filtered postings
SELECT 
       sd."skill_id",
       sd."skills",
       COUNT(*) AS "skill_freq"
FROM   "skills_job_dim"  AS sjd
JOIN   "skills_dim"      AS sd  ON sjd."skill_id" = sd."skill_id"
JOIN   "job_postings_fact" AS jpf
       ON sjd."job_id" = jpf."job_id"
WHERE  jpf."job_title_short"   = 'Data Analyst'
  AND  jpf."job_work_from_home" = 1
  AND  jpf."salary_year_avg"    IS NOT NULL
GROUP  BY sd."skill_id", sd."skills"
ORDER  BY "skill_freq" DESC
LIMIT 20;
```

```sql
-- 7. Isolate the TOP-3 most requested skills (cte_top_skills)
WITH cte_top_skills AS (
    SELECT 
           sd."skill_id"
    FROM   "skills_job_dim"  AS sjd
    JOIN   "skills_dim"      AS sd  ON sjd."skill_id" = sd."skill_id"
    JOIN   "job_postings_fact" AS jpf
           ON sjd."job_id" = jpf."job_id"
    WHERE  jpf."job_title_short"   = 'Data Analyst'
      AND  jpf."job_work_from_home" = 1
      AND  jpf."salary_year_avg"    IS NOT NULL
    GROUP  BY sd."skill_id"
    ORDER  BY COUNT(*) DESC
    LIMIT 3
)
SELECT * FROM cte_top_skills;
```

```sql
-- 8. All job_ids that require ANY of those top-3 skills
WITH cte_top_skills AS (
    SELECT 
           sd."skill_id"
    FROM   "skills_job_dim"  AS sjd
    JOIN   "skills_dim"      AS sd  ON sjd."skill_id" = sd."skill_id"
    JOIN   "job_postings_fact" AS jpf
           ON sjd."job_id" = jpf."job_id"
    WHERE  jpf."job_title_short"   = 'Data Analyst'
      AND  jpf."job_work_from_home" = 1
      AND  jpf."salary_year_avg"    IS NOT NULL
    GROUP  BY sd."skill_id"
    ORDER  BY COUNT(*) DESC
    LIMIT 3
)
SELECT DISTINCT 
       sjd."job_id"
FROM   "skills_job_dim" AS sjd
JOIN   cte_top_skills   AS tts ON sjd."skill_id" = tts."skill_id"
LIMIT 20;
```

```sql
-- 9. Final: overall average salary for remote “Data Analyst” postings
--    that list at least one of the TOP-3 skills
WITH cte_da_remote AS (
    SELECT "job_id", "salary_year_avg"
    FROM   "job_postings_fact"
    WHERE  "job_title_short"   = 'Data Analyst'
      AND  "job_work_from_home" = 1
      AND  "salary_year_avg"    IS NOT NULL
),
cte_top_skills AS (
    SELECT 
           sd."skill_id"
    FROM   "skills_job_dim"  AS sjd
    JOIN   "skills_dim"      AS sd  ON sjd."skill_id" = sd."skill_id"
    JOIN   cte_da_remote     AS cdr ON sjd."job_id" = cdr."job_id"
    GROUP  BY sd."skill_id"
    ORDER  BY COUNT(*) DESC
    LIMIT 3
),
cte_jobs_with_top AS (
    SELECT DISTINCT sjd."job_id"
    FROM   "skills_job_dim" AS sjd
    JOIN   cte_top_skills   AS tts  ON sjd."skill_id" = tts."skill_id"
)
SELECT AVG(cdr."salary_year_avg") AS "avg_salary_top3skills"
FROM   cte_da_remote  AS cdr
JOIN   cte_jobs_with_top AS jwt
       ON cdr."job_id" = jwt."job_id";
```

