```sql
--Description: Display a sample of the customer_id to customer_unique_id relationship
SELECT DISTINCT "customer_id", "customer_unique_id"
FROM "olist_customers"
LIMIT 20;
```

```sql
--Description: Check a sample of delivered orders together with their customer_unique_id, city and state
SELECT o."order_id",
       c."customer_unique_id",
       c."customer_city",
       c."customer_state"
FROM   "olist_orders" AS o
JOIN   "olist_customers" AS c
       ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
LIMIT 20;
```

```sql
--Description: Count the number of delivered orders per customer_unique_id (top 20)
SELECT c."customer_unique_id",
       COUNT(*) AS delivered_orders
FROM   "olist_orders"  AS o
JOIN   "olist_customers" AS c
       ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
ORDER  BY delivered_orders DESC
LIMIT 20;
```

```sql
--Description: Show payment_value per delivered order (sample 20 rows)
SELECT p."order_id",
       p."payment_value"
FROM   "olist_order_payments" AS p
JOIN   "olist_orders"         AS o
       ON p."order_id" = o."order_id"
WHERE  o."order_status" = 'delivered'
LIMIT 20;
```

```sql
--Description: Calculate average payment_value per customer_unique_id for delivered orders (top 20)
SELECT c."customer_unique_id",
       AVG(p."payment_value") AS avg_payment_value
FROM   "olist_orders"         AS o
JOIN   "olist_order_payments" AS p
       ON o."order_id" = p."order_id"
JOIN   "olist_customers"      AS c
       ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
ORDER  BY avg_payment_value DESC
LIMIT 20;
```

```sql
--Description: Combine delivered order counts and average payment values per customer_unique_id (top 20)
SELECT c."customer_unique_id",
       COUNT(*)              AS delivered_orders,
       AVG(p."payment_value") AS avg_payment_value
FROM   "olist_orders"         AS o
JOIN   "olist_order_payments" AS p
       ON o."order_id" = p."order_id"
JOIN   "olist_customers"      AS c
       ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
ORDER  BY delivered_orders DESC
LIMIT 20;
```

```sql
--Description: Add city and state to the above aggregation (top 20)
SELECT c."customer_unique_id",
       MIN(c."customer_city")  AS customer_city,   -- MIN used just to pick one city when multiple exist
       MIN(c."customer_state") AS customer_state,  -- MIN used just to pick one state when multiple exist
       COUNT(*)                AS delivered_orders,
       AVG(p."payment_value")  AS avg_payment_value
FROM   "olist_orders"         AS o
JOIN   "olist_order_payments" AS p
       ON o."order_id" = p."order_id"
JOIN   "olist_customers"      AS c
       ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
ORDER  BY delivered_orders DESC
LIMIT 20;
```

```sql
--Description: Final answer – top three customers (by customer_unique_id) with the highest number of delivered
--             orders, showing their average payment value, city and state
SELECT c."customer_unique_id",
       MIN(c."customer_city")  AS customer_city,
       MIN(c."customer_state") AS customer_state,
       COUNT(*)                AS delivered_orders,
       AVG(p."payment_value")  AS avg_payment_value
FROM   "olist_orders"         AS o
JOIN   "olist_order_payments" AS p
       ON o."order_id" = p."order_id"
JOIN   "olist_customers"      AS c
       ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
ORDER  BY delivered_orders DESC
LIMIT 3;
```
