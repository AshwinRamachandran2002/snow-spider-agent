Query:
--Description: 8) Add city and state (many customer_id rows may share the same customer_unique_id; 
--              choose the first city/state we see with MIN())
SELECT c.customer_unique_id,
       COUNT(*)                              AS delivered_orders,
       AVG(t.total_payment)                  AS avg_payment_value,
       MIN(c.customer_city)  AS customer_city,
       MIN(c.customer_state) AS customer_state
FROM olist_orders           AS o
JOIN olist_customers        AS c ON c.customer_id = o.customer_id
JOIN (
      SELECT p.order_id,
             SUM(p.payment_value) AS total_payment
      FROM olist_order_payments AS p
      GROUP BY p.order_id
) AS t ON t.order_id = o.order_id
WHERE o.order_status = 'delivered'
GROUP BY c.customer_unique_id
ORDER BY delivered_orders DESC
LIMIT 20;
