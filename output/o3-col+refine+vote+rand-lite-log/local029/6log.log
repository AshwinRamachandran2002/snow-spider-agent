```

```sql
--Description: 5) Calculate total payment per order (only for delivered orders) – preview
SELECT p.order_id,
       SUM(p.payment_value) AS total_payment
FROM olist_order_payments AS p
JOIN olist_orders           AS o ON o.order_id = p.order_id
WHERE o.order_status = 'delivered'
GROUP BY p.order_id
LIMIT 20;
```

```sql
--Description: 6) Count how many delivered orders each customer_unique_id has – preview
SELECT c.customer_unique_id,
       COUNT(*) AS delivered_orders
FROM olist_orders    AS o
JOIN olist_customers AS c ON c.customer_id = o.customer_id
WHERE o.order_status = 'delivered'
GROUP BY c.customer_unique_id
ORDER BY delivered_orders DESC
LIMIT 20;
```

```sql
--Description: 7) Bring in the average total payment per delivered order for each customer_unique_id
SELECT c.customer_unique_id,
       COUNT(*)                              AS delivered_orders,
       AVG(t.total_payment)                  AS avg_payment_value
FROM olist_orders           AS o
JOIN olist_customers        AS c ON c.customer_id = o.customer_id
JOIN (
      SELECT p.order_id,
             SUM(p.payment_value) AS total_payment
      FROM olist_order_payments AS p
      GROUP BY p.order_id
) AS t ON t.order_id = o.order_id
WHERE o.order_status = 'delivered'
GROUP BY c.customer_unique_id
ORDER BY delivered_orders DESC
LIMIT 20;
```

```sql
--Description: 8) Add city and state (many customer_id rows may share the same customer_unique_id; 
--              choose the first city/state we see with MIN())
SELECT c.customer_unique_id,
       COUNT(*)                              AS delivered_orders,
       AVG(t.total_payment)                  AS avg_payment_value,
       MIN(c.customer_city)  AS customer_city,
       MIN(c.customer_state) AS customer_state
FROM olist_orders           AS o
JOIN olist_customers        AS c ON c.customer_id = o.customer_id
JOIN (
      SELECT p.order_id,
             SUM(p.payment_value) AS total_payment
      FROM olist_order_payments AS p
      GROUP BY p.order_id
) AS t ON t.order_id = o.order_id
WHERE o.order_status = 'delivered'
GROUP BY c.customer_unique_id
ORDER BY delivered_orders DESC
LIMIT 20;
```

```sql
--Description: 9) FINAL ANSWER – top 3 customer_unique_id with the highest number of delivered orders,
--              their average payment value, city and state
SELECT c.customer_unique_id,
       COUNT(*)                              AS delivered_orders,
       ROUND(AVG(t.total_payment), 2)        AS avg_payment_value,
       MIN(c.customer_city)  AS customer_city,
       MIN(c.customer_state) AS customer_state
FROM olist_orders           AS o
JOIN olist_customers        AS c ON c.customer_id = o.customer_id
JOIN (
      SELECT p.order_id,
             SUM(p.payment_value) AS total_payment
      FROM olist_order_payments AS p
      GROUP BY p.order_id
) AS t ON t.order_id = o.order_id
WHERE o.order_status = 'delivered'
GROUP BY c.customer_unique_id
ORDER BY delivered_orders DESC
LIMIT 3;
```

