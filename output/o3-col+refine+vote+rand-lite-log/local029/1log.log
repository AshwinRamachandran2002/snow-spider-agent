```sql
-- 1) Check the different order statuses that exist
SELECT DISTINCT "order_status"
FROM "olist_orders"
LIMIT 20;
```

```sql
-- 2) See how an order links a customer_id with a customer_unique_id
SELECT o."order_id",
       o."customer_id",
       c."customer_unique_id"
FROM   "olist_orders"  AS o
JOIN   "olist_customers" AS c
       ON o."customer_id" = c."customer_id"
LIMIT 20;
```

```sql
-- 3) Look at the total amount each order actually charged
SELECT "order_id",
       SUM("payment_value") AS "total_payment"
FROM   "olist_order_payments"
GROUP  BY "order_id"
LIMIT 20;
```

```sql
-- 4) Sample of delivered orders together with their payment and customer_unique_id
SELECT o."order_id",
       c."customer_unique_id",
       op."payment_value"
FROM   "olist_orders"        AS o
JOIN   "olist_order_payments" AS op  ON o."order_id"  = op."order_id"
JOIN   "olist_customers"      AS c   ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
LIMIT 20;
```

```sql
-- 5) Number of delivered orders per customer_unique_id
SELECT c."customer_unique_id",
       COUNT(DISTINCT o."order_id") AS "delivered_orders"
FROM   "olist_orders"   AS o
JOIN   "olist_customers" AS c  ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
ORDER  BY "delivered_orders" DESC
LIMIT 20;
```

```sql
-- 6) Add the average payment value to the previous aggregation
SELECT c."customer_unique_id",
       COUNT(DISTINCT o."order_id")          AS "delivered_orders",
       AVG(op."payment_value")               AS "avg_payment"
FROM   "olist_orders"         AS o
JOIN   "olist_order_payments" AS op ON o."order_id"  = op."order_id"
JOIN   "olist_customers"      AS c  ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
ORDER  BY "delivered_orders" DESC
LIMIT 20;
```

```sql
-- 7) For every customer_unique_id pick one (e.g., MIN) city & state
SELECT c."customer_unique_id",
       MIN(c."customer_city")  AS "city",
       MIN(c."customer_state") AS "state"
FROM   "olist_customers" AS c
GROUP  BY c."customer_unique_id"
LIMIT 20;
```

```sql
-- 8) Combine the delivered-order counts, average payment, city and state,
--    then keep only the global Top-3 customers
SELECT agg."customer_unique_id",
       ROUND(agg."avg_payment", 2) AS "avg_payment",
       loc."city",
       loc."state"
FROM  (
        SELECT c."customer_unique_id",
               COUNT(DISTINCT o."order_id") AS "delivered_orders",
               AVG(op."payment_value")      AS "avg_payment"
        FROM   "olist_orders"         AS o
        JOIN   "olist_order_payments" AS op ON o."order_id"  = op."order_id"
        JOIN   "olist_customers"      AS c  ON o."customer_id" = c."customer_id"
        WHERE  o."order_status" = 'delivered'
        GROUP  BY c."customer_unique_id"
      ) AS agg
JOIN (
        SELECT c."customer_unique_id",
               MIN(c."customer_city")  AS "city",
               MIN(c."customer_state") AS "state"
        FROM   "olist_customers" AS c
        GROUP  BY c."customer_unique_id"
     ) AS loc
     ON agg."customer_unique_id" = loc."customer_unique_id"
ORDER BY agg."delivered_orders" DESC,
         agg."avg_payment"      DESC          -- tie-breaker
LIMIT 3;
```

```sql
-- 9) If you also want to see how many delivered orders they made
SELECT agg."customer_unique_id",
       agg."delivered_orders",
       ROUND(agg."avg_payment", 2) AS "avg_payment",
       loc."city",
       loc."state"
FROM  (
        SELECT c."customer_unique_id",
               COUNT(DISTINCT o."order_id") AS "delivered_orders",
               AVG(op."payment_value")      AS "avg_payment"
        FROM   "olist_orders"         AS o
        JOIN   "olist_order_payments" AS op ON o."order_id"  = op."order_id"
        JOIN   "olist_customers"      AS c  ON o."customer_id" = c."customer_id"
        WHERE  o."order_status" = 'delivered'
        GROUP  BY c."customer_unique_id"
      ) AS agg
JOIN (
        SELECT c."customer_unique_id",
               MIN(c."customer_city")  AS "city",
               MIN(c."customer_state") AS "state"
        FROM   "olist_customers" AS c
        GROUP  BY c."customer_unique_id"
     ) AS loc
     ON agg."customer_unique_id" = loc."customer_unique_id"
ORDER BY agg."delivered_orders" DESC,
         agg."avg_payment"      DESC
LIMIT 3;
```

```sql
-- 10) Same as #8 but ordered only by average payment among the Top-3,
--     useful if you want to re-rank just those three customers
SELECT *
FROM   (
        /* #8 above */
        SELECT agg."customer_unique_id",
               ROUND(agg."avg_payment", 2) AS "avg_payment",
               loc."city",
               loc."state"
        FROM  (
                SELECT c."customer_unique_id",
                       COUNT(DISTINCT o."order_id") AS "delivered_orders",
                       AVG(op."payment_value")      AS "avg_payment"
                FROM   "olist_orders"         AS o
                JOIN   "olist_order_payments" AS op ON o."order_id"  = op."order_id"
                JOIN   "olist_customers"      AS c  ON o."customer_id" = c."customer_id"
                WHERE  o."order_status" = 'delivered'
                GROUP  BY c."customer_unique_id"
              ) AS agg
        JOIN (
                SELECT c."customer_unique_id",
                       MIN(c."customer_city")  AS "city",
                       MIN(c."customer_state") AS "state"
                FROM   "olist_customers" AS c
                GROUP  BY c."customer_unique_id"
             ) AS loc
             ON agg."customer_unique_id" = loc."customer_unique_id"
        ORDER BY agg."delivered_orders" DESC
        LIMIT 3
      )
ORDER BY "avg_payment" DESC;
```

