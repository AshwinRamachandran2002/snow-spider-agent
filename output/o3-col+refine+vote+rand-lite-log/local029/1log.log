Query:
-- 8) Combine the delivered-order counts, average payment, city and state,
--    then keep only the global Top-3 customers
SELECT agg."customer_unique_id",
       ROUND(agg."avg_payment", 2) AS "avg_payment",
       loc."city",
       loc."state"
FROM  (
        SELECT c."customer_unique_id",
               COUNT(DISTINCT o."order_id") AS "delivered_orders",
               AVG(op."payment_value")      AS "avg_payment"
        FROM   "olist_orders"         AS o
        JOIN   "olist_order_payments" AS op ON o."order_id"  = op."order_id"
        JOIN   "olist_customers"      AS c  ON o."customer_id" = c."customer_id"
        WHERE  o."order_status" = 'delivered'
        GROUP  BY c."customer_unique_id"
      ) AS agg
JOIN (
        SELECT c."customer_unique_id",
               MIN(c."customer_city")  AS "city",
               MIN(c."customer_state") AS "state"
        FROM   "olist_customers" AS c
        GROUP  BY c."customer_unique_id"
     ) AS loc
     ON agg."customer_unique_id" = loc."customer_unique_id"
ORDER BY agg."delivered_orders" DESC,
         agg."avg_payment"      DESC          -- tie-breaker
LIMIT 3;
Answer:
customer_unique_id,avg_payment,city,state
