Query:
--Description: 7) Join payments with orders + customers to get average payment per customer_unique_id
SELECT  c."customer_unique_id",
        AVG(p.order_total_payment) AS avg_payment_value
FROM    "olist_orders"    AS o
JOIN    "olist_customers" AS c
           ON o."customer_id" = c."customer_id"
JOIN   (SELECT  "order_id",
               SUM("payment_value") AS order_total_payment
        FROM    "olist_order_payments"
        GROUP BY "order_id") AS p
           ON o."order_id" = p."order_id"
WHERE   o."order_status" = 'delivered'
GROUP BY c."customer_unique_id"
LIMIT 20;
