```sql
--Description: 1) Inspect the different order statuses that exist in the database
SELECT DISTINCT "order_status"
FROM "olist_orders"
LIMIT 20;
```

```sql
--Description: 2) Look at a few “delivered” orders (order-id and customer-id)
SELECT "order_id",
       "customer_id"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
LIMIT 20;
```

```sql
--Description: 3) How many delivered orders does each customer_id have?
SELECT   "customer_id",
         COUNT(*) AS num_delivered_orders
FROM     "olist_orders"
WHERE    "order_status" = 'delivered'
GROUP BY "customer_id"
ORDER BY num_delivered_orders DESC
LIMIT 20;
```

```sql
--Description: 4) Map those customer_id values to the canonical customer_unique_id
SELECT  o."customer_id",
        c."customer_unique_id",
        COUNT(*) AS num_delivered_orders
FROM    "olist_orders"   AS o
JOIN    "olist_customers" AS c
           ON o."customer_id" = c."customer_id"
WHERE   o."order_status" = 'delivered'
GROUP BY c."customer_unique_id", o."customer_id"
ORDER BY num_delivered_orders DESC
LIMIT 20;
```

```sql
--Description: 5) Aggregate by customer_unique_id (across possible multiple customer_id)
SELECT  c."customer_unique_id",
        COUNT(*) AS num_delivered_orders
FROM    "olist_orders"    AS o
JOIN    "olist_customers" AS c
           ON o."customer_id" = c."customer_id"
WHERE   o."order_status" = 'delivered'
GROUP BY c."customer_unique_id"
ORDER BY num_delivered_orders DESC
LIMIT 20;
```

```sql
--Description: 6) Sum payment_value per order (to avoid multiple payment rows per order)
SELECT  "order_id",
        SUM("payment_value") AS order_total_payment
FROM    "olist_order_payments"
GROUP BY "order_id"
LIMIT 20;
```

```sql
--Description: 7) Join payments with orders + customers to get average payment per customer_unique_id
SELECT  c."customer_unique_id",
        AVG(p.order_total_payment) AS avg_payment_value
FROM    "olist_orders"    AS o
JOIN    "olist_customers" AS c
           ON o."customer_id" = c."customer_id"
JOIN   (SELECT  "order_id",
               SUM("payment_value") AS order_total_payment
        FROM    "olist_order_payments"
        GROUP BY "order_id") AS p
           ON o."order_id" = p."order_id"
WHERE   o."order_status" = 'delivered'
GROUP BY c."customer_unique_id"
LIMIT 20;
```

```sql
--Description: 8) FINAL ANSWER – top 3 customer_unique_id with the most delivered orders,
--               along with their average payment value, city, and state
SELECT  c."customer_unique_id",
        COUNT(*)                         AS num_delivered_orders,
        AVG(pay.order_total_payment)     AS avg_payment_value,
        MIN(c."customer_city")           AS customer_city,
        MIN(c."customer_state")          AS customer_state
FROM    "olist_orders"    AS o
JOIN    "olist_customers" AS c
           ON o."customer_id" = c."customer_id"
JOIN   (SELECT  "order_id",
               SUM("payment_value") AS order_total_payment
        FROM    "olist_order_payments"
        GROUP BY "order_id") AS pay
           ON o."order_id" = pay."order_id"
WHERE   o."order_status" = 'delivered'
GROUP BY c."customer_unique_id"
ORDER BY num_delivered_orders DESC
LIMIT 3;
```

The last query returns, for each of the three customers with the highest number of delivered orders:

• customer_unique_id  
• number of delivered orders they placed  
• their average payment value (across those delivered orders)  
• their city  
• their state
