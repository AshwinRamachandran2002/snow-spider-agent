Query:
--Description: Compute the NUMERATOR—crashes with >1 person that also had >1
--severely-injured individual (injury_severity = 4).
SELECT
  COUNT(*) AS accidents_gt1_severe
FROM (
  -- keep only accidents with >1 person
  SELECT
    state_number,
    consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY state_number, consecutive_number
  HAVING COUNT(DISTINCT person_number) > 1
) AS multi
JOIN (
  -- accidents with >1 severely injured
  SELECT
    state_number,
    consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY state_number, consecutive_number
  HAVING COUNTIF(injury_severity = 4) > 1
) AS severe
USING (state_number, consecutive_number)
