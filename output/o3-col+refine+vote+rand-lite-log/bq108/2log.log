```sql
--Description: Preview a few accidents (identified by state_number + consecutive_number)
--that meet BOTH criteria: more than one person AND more than one severely injured
--person, for crashes occurring January–August 2015.  The query groups by the crash
--identifier and applies HAVING filters to ensure both conditions are satisfied.
SELECT
  state_number,
  consecutive_number,
  COUNT(DISTINCT person_number)                           AS persons_in_crash,
  COUNTIF(injury_severity = 4)                            AS severe_injured_cnt
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
WHERE month_of_crash BETWEEN 1 AND 8
GROUP BY state_number, consecutive_number
HAVING persons_in_crash > 1
   AND severe_injured_cnt > 1
LIMIT 20;
```

```sql
--Description: Break down, by month (Jan–Aug 2015), the percentage of crashes that
--involved >1 person and also had >1 severely injured person.  We first build two CTEs—
--multi_person (denominator set) and multi_severe (candidate numerator set)—then
--LEFT JOIN them so each crash in the denominator is represented once.  Row counts
--per month yield the numerator and denominator; the percentage is rounded to 2 decimals.
WITH multi_person AS (
  SELECT
    month_of_crash,
    state_number,
    consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY month_of_crash, state_number, consecutive_number
  HAVING COUNT(DISTINCT person_number) > 1        -- >1 person
),
multi_severe AS (
  SELECT
    month_of_crash,
    state_number,
    consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY month_of_crash, state_number, consecutive_number
  HAVING COUNTIF(injury_severity = 4) > 1         -- >1 severe injury
)
SELECT
  mp.month_of_crash,
  COUNT(*)                                                AS accidents_with_multiple_persons,
  SUM(CASE WHEN ms.state_number IS NOT NULL THEN 1 END)   AS accidents_with_multiple_severe,
  ROUND(
    100 * SUM(CASE WHEN ms.state_number IS NOT NULL THEN 1 END) / COUNT(*)
  , 2)                                                    AS pct
FROM multi_person AS mp
LEFT JOIN multi_severe AS ms
USING (month_of_crash, state_number, consecutive_number)
GROUP BY mp.month_of_crash
ORDER BY mp.month_of_crash;
```
