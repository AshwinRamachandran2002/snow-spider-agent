```sql
--Description:  Determine the percentage of 2015 crashes (Jan – Aug) that
--meet BOTH criteria:
--  1) More than one distinct person involved  ➜  denominator set.
--  2) More than one person with severe injuries (injury_severity = 4)  ➜  numerator set.
--
--Crash ID = (state_number, consecutive_number).  
--COUNT(DISTINCT STRUCT(col1, col2)) is required in BigQuery for multi-column distinct counts.

WITH multi_person_acc AS (          -- crashes with >1 person
  SELECT
    state_number,
    consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY state_number, consecutive_number
  HAVING COUNT(DISTINCT person_number) > 1
),
multi_severe_acc AS (               -- crashes with >1 severely injured
  SELECT
    state_number,
    consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY state_number, consecutive_number
  HAVING COUNTIF(injury_severity = 4) > 1
)
SELECT
  COUNT(DISTINCT STRUCT(ms.state_number, ms.consecutive_number)) AS numerator_accidents,
  COUNT(DISTINCT STRUCT(mp.state_number, mp.consecutive_number)) AS denominator_accidents,
  ROUND(
    100 * COUNT(DISTINCT STRUCT(ms.state_number, ms.consecutive_number))
        / COUNT(DISTINCT STRUCT(mp.state_number, mp.consecutive_number))
  , 2) AS pct_with_multiple_severe_injuries
FROM multi_person_acc mp
LEFT JOIN multi_severe_acc ms
USING (state_number, consecutive_number);
