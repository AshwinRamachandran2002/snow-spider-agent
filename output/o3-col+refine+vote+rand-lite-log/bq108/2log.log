--Description: FINAL ANSWER—percentage of multi-person crashes (Jan–Aug 2015)
--that had more than one severely injured person.
WITH multi_person_acc AS (
  SELECT
    state_number,
    consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY state_number, consecutive_number
  HAVING COUNT(DISTINCT person_number) > 1
),
multi_severe_acc AS (
  SELECT
    state_number,
    consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY state_number, consecutive_number
  HAVING COUNTIF(injury_severity = 4) > 1
)
SELECT
  COUNT(DISTINCT ms.state_number, ms.consecutive_number) AS numerator_accidents,
  COUNT(DISTINCT mp.state_number, mp.consecutive_number) AS denominator_accidents,
  ROUND(
    100 * COUNT(DISTINCT ms.state_number, ms.consecutive_number)
        / COUNT(DISTINCT mp.state_number, mp.consecutive_number), 2
  ) AS pct_with_multiple_severe_injuries
FROM multi_person_acc mp
LEFT JOIN multi_severe_acc ms
USING (state_number, consecutive_number);
