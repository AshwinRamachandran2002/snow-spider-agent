```

```sql
-- 3. Pick the accidents that involved MORE THAN ONE distinct person (our denominator set)
SELECT
  ST_CASE
FROM (
  SELECT
    ST_CASE,
    COUNT(DISTINCT person_number) AS persons_in_crash
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY ST_CASE
)
WHERE persons_in_crash > 1
LIMIT 20;
