Query:
--Description: Pick the accidents (identified by state_number + consecutive_number)
--that involved MORE THAN ONE distinct person between January and August 2015.
SELECT
  state_number,
  consecutive_number
FROM (
  SELECT
    state_number,
    consecutive_number,
    COUNT(DISTINCT person_number) AS persons_in_crash
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY state_number, consecutive_number
)
WHERE persons_in_crash > 1
LIMIT 20
