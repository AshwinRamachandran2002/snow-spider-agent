  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY st_case
  HAVING COUNTIF(injury_severity = 4) > 1
)
SELECT
  COUNT(DISTINCT ms.st_case) AS numerator_crashes,
  COUNT(DISTINCT mp.st_case) AS denominator_crashes,
  ROUND(100 * COUNT(DISTINCT ms.st_case) / COUNT(DISTINCT mp.st_case), 2)
    AS pct_with_multiple_severe_injuries
FROM multi_person mp
LEFT JOIN multi_severe ms
ON mp.st_case = ms.st_case;
