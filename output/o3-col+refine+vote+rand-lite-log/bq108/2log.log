```sql
--Description:  Final step—calculate the percentage of 2015 crashes (January–August)
--that satisfied BOTH of these conditions:
--   1) The crash involved more than one distinct person             → denominator set.
--   2) The crash had more than one person with a severe injury (4)  → numerator set.
--
--Crash ID = (state_number, consecutive_number).  We first build each set,
--join them to obtain the intersection, then count rows in each set and
--compute the percentage—no DISTINCT-on-multiple-columns required.

WITH multi_person_acc AS (        -- crashes with >1 person
  SELECT
    state_number,
    consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY state_number, consecutive_number
  HAVING COUNT(DISTINCT person_number) > 1
),
multi_severe_acc AS (             -- crashes with >1 severely injured person
  SELECT
    state_number,
    consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY state_number, consecutive_number
  HAVING COUNTIF(injury_severity = 4) > 1
),
both_criteria AS (                -- crashes meeting both conditions
  SELECT
    mp.state_number,
    mp.consecutive_number
  FROM multi_person_acc mp
  INNER JOIN multi_severe_acc ms
  USING (state_number, consecutive_number)
)

SELECT
  (SELECT COUNT(*) FROM both_criteria)    AS numerator_accidents,
  (SELECT COUNT(*) FROM multi_person_acc) AS denominator_accidents,
  ROUND(
    100 * (SELECT COUNT(*) FROM both_criteria)
        / (SELECT COUNT(*) FROM multi_person_acc)
  , 2) AS pct_with_multiple_severe_injuries;
```
