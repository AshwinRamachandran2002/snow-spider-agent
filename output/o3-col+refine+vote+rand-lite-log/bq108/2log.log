  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY ST_CASE
)
WHERE severe_injured_cnt > 1
LIMIT 20;
```

```sql
-- 6. Compute DENOMINATOR: total accidents Jan-Aug with >1 person
SELECT
  COUNT(DISTINCT ST_CASE) AS accidents_gt1_person
FROM (
  SELECT
    ST_CASE
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY ST_CASE
  HAVING COUNT(DISTINCT person_number) > 1
);
```

```sql
-- 7. Compute NUMERATOR: those same accidents that also have >1 severely-injured person
SELECT
  COUNT(DISTINCT p.ST_CASE) AS accidents_gt1_severe
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015` AS p
JOIN (
  -- keep only accidents with >1 person
  SELECT ST_CASE
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY ST_CASE
  HAVING COUNT(DISTINCT person_number) > 1
) AS multi
ON p.ST_CASE = multi.ST_CASE
WHERE p.month_of_crash BETWEEN 1 AND 8
GROUP BY p.ST_CASE
HAVING COUNTIF(injury_severity = 4) > 1
LIMIT 20;
```

```sql
-- 8. FINAL ANSWER: percentage of multi-person accidents (Jan-Aug 2015) that had >1 severe injuries
WITH multi_person_acc AS (
  SELECT
    ST_CASE
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY ST_CASE
  HAVING COUNT(DISTINCT person_number) > 1
),
multi_severe_acc AS (
  SELECT
    ST_CASE
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY ST_CASE
  HAVING COUNTIF(injury_severity = 4) > 1
)
SELECT
  COUNT(DISTINCT ms.ST_CASE) AS numerator_accidents,
  COUNT(DISTINCT mp.ST_CASE) AS denominator_accidents,
  ROUND(100 * COUNT(DISTINCT ms.ST_CASE) / COUNT(DISTINCT mp.ST_CASE), 2) AS pct_with_multiple_severe_injuries
FROM multi_person_acc mp
LEFT JOIN multi_severe_acc ms
ON mp.ST_CASE = ms.ST_CASE;
```

```sql
