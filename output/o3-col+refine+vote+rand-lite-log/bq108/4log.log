--Description:  Return just the percentage value of interest (multi-person crashes whose severe injury count >1)
WITH joined AS (
  SELECT
    p.state_number,
    p.consecutive_number,
    p.persons_in_crash,
    s.severe_injury_cnt
  FROM (
    SELECT state_number, consecutive_number, COUNT(DISTINCT person_number) AS persons_in_crash
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
    WHERE month_of_crash BETWEEN 1 AND 8
    GROUP BY state_number, consecutive_number
  ) AS p
  JOIN (
    SELECT state_number, consecutive_number, COUNTIF(injury_severity = 4) AS severe_injury_cnt
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
    WHERE month_of_crash BETWEEN 1 AND 8
    GROUP BY state_number, consecutive_number
  ) AS s
  USING (state_number, consecutive_number)
  WHERE p.persons_in_crash > 1
)
SELECT
  ROUND(COUNTIF(severe_injury_cnt > 1) / COUNT(*) * 100.0, 2) AS percentage_multi_severe
FROM joined
LIMIT 20
