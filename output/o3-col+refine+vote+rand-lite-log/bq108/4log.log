```sql
--Description:
-- Objective:  For the 2015 dataset, calculate the percentage of crashes that
--   1) happened between January (1) and August (8) inclusive,
--   2) involved more than one distinct person, and
--   3) had more than one person whose injury_severity = 4 (fatal injury on KABCO scale).
--
-- Approach in one SQL:
--   • Use a CTE to aggregate person_2015 records by crash id (st_case).
--   • For each crash, compute:
--         ▸ person_cnt  – distinct persons in the crash
--         ▸ severe_cnt  – persons with injury_severity = 4
--   • Filter to multi-person crashes (person_cnt > 1).
--   • In the final SELECT, derive:
--         ▸ numerator   – count of crashes with severe_cnt > 1
--         ▸ denominator – total multi-person crashes
--         ▸ percentage  – 100 * numerator / denominator
--   • Round to two decimal places for clarity.
WITH crash_agg AS (
  SELECT
    st_case,
    COUNT(DISTINCT person_number)            AS person_cnt,
    COUNTIF(injury_severity = 4)             AS severe_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY st_case
)
SELECT
  ROUND(
    100.0 * SUM(CASE WHEN severe_cnt > 1 THEN 1 ELSE 0 END)
          / COUNT(*)
  , 2) AS pct_multi_person_crashes_with_multiple_severe_injuries
FROM crash_agg
WHERE person_cnt > 1;
```
