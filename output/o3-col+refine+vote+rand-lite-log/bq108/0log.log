```sql
-- Description: 6) Pull both counts side-by-side to prepare for a percentage.
SELECT
  -- total crashes Jan-Aug 2015 with >1 person
  (SELECT COUNT(*)
   FROM (
     SELECT `st_case`
     FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
     WHERE `month_of_crash` BETWEEN 1 AND 8
     GROUP BY `st_case`
     HAVING COUNT(DISTINCT `person_number`) > 1
   )
  ) AS n_accidents_multi_person,
  -- of those, crashes with >1 severity-4 person
  (SELECT COUNT(*)
   FROM (
     SELECT `st_case`
     FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
     WHERE `month_of_crash` BETWEEN 1 AND 8
       AND `injury_severity` = 4
     GROUP BY `st_case`
     HAVING COUNT(*) > 1
   )
  ) AS n_accidents_multi_severe;
