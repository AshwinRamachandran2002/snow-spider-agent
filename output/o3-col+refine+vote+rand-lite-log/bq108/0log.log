```sql
--Description: We answer the question in a single pass over person_2015.
-- 1. Filter to crashes that happened January–August 2015 (month_of_crash 1-8).
-- 2. Group by ST_CASE (unique crash id).
-- 3. For each crash, count DISTINCT person_number (person_cnt) and
--    count persons whose injury_severity = 4 (severe_cnt).
-- 4. Keep only crashes with more than one person (person_cnt > 1).
-- 5. Compute the percentage: numerator = crashes where severe_cnt > 1,
--    denominator = all crashes that satisfied step 4.
SELECT
  ROUND(
    SAFE_DIVIDE(
      COUNTIF(severe_cnt > 1),   -- crashes with >1 severely-injured person
      COUNT(*)                   -- all crashes with >1 person
    ) * 100,
    2
  ) AS pct_crashes_with_multiple_severe_injuries
FROM (
  SELECT
    ST_CASE,
    COUNT(DISTINCT person_number) AS person_cnt,
    SUM(CASE WHEN injury_severity = 4 THEN 1 ELSE 0 END) AS severe_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY ST_CASE
)
WHERE person_cnt > 1;
```
