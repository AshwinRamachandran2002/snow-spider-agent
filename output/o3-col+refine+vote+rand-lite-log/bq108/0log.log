```sql
-- Description: 7) One-shot computation of the desired percentage.
--   • Restrict to Jan-Aug 2015.
--   • Keep only crashes that had >1 person.
--   • Within those, mark which had >1 severity-4 injury.
SELECT
  SAFE_DIVIDE(
    COUNTIF(severe_injuries > 1),   -- numerator
    COUNT(*)                        -- denominator
  ) * 100 AS pct_with_multiple_severe_injuries
FROM (
  SELECT
    `st_case`,
    COUNT(DISTINCT `person_number`)                           AS persons_involved,
    SUM(CASE WHEN `injury_severity` = 4 THEN 1 ELSE 0 END)   AS severe_injuries
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE `month_of_crash` BETWEEN 1 AND 8
  GROUP BY `st_case`
)
WHERE persons_involved > 1;
