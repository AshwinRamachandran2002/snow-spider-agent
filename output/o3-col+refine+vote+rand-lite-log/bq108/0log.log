Query:
--Description: 9) Distribution of severity-4 counts in multi-person months (Jan-Aug 2015).
SELECT
  severe_cnt AS num_severe_injuries,
  COUNT(*)   AS months
FROM (
  SELECT
    month_of_crash,
    COUNT(DISTINCT person_number)                         AS person_cnt,
    SUM(CASE WHEN injury_severity = 4 THEN 1 ELSE 0 END) AS severe_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY month_of_crash
)
WHERE person_cnt > 1
GROUP BY severe_cnt
ORDER BY severe_cnt
LIMIT 20
