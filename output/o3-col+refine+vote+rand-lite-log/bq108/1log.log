--Description:  Calculate the percentage of 2015 crashes that happened in Jan-Aug
--              where: (a) the crash involved more than one distinct person and
--              (b) more than one person suffered a “severe” injury (injury_severity = 4).
--Thinking process in-line:
--   1. PERSON file holds one row per person, so we first filter to the desired months.
--   2. Group by st_case (the crash identifier) to count:
--        • persons_in_crash  = DISTINCT persons in that crash
--        • severe_injured    = # of persons whose injury_severity = 4
--   3. In the outer SELECT, use conditional counts:
--        • Denominator = crashes with persons_in_crash > 1      (multi-person crashes)
--        • Numerator   = those crashes that also have severe_injured > 1
--   4. SAFE_DIVIDE protects against divide-by-zero; multiply by 100 for %.
WITH crash_stats AS (
  SELECT
    st_case,
    COUNT(DISTINCT person_number) AS persons_in_crash,
    SUM(CASE WHEN injury_severity = 4 THEN 1 ELSE 0 END) AS severe_injured
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY st_case
)
SELECT
  SAFE_DIVIDE(
    COUNTIF(severe_injured > 1 AND persons_in_crash > 1),
    COUNTIF(persons_in_crash > 1)
  ) * 100 AS pct_multi_person_crashes_with_multi_severe
FROM crash_stats;
