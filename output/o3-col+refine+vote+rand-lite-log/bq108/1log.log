--Description:  Compute the percentage of Jan–Aug 2015 crashes that
--              (a) involved more than one distinct person and simultaneously
--              (b) had more than one person with severe injury (injury_severity = 4).
--              In this dataset a crash is uniquely identified by the composite key
--              (state_number, consecutive_number); there is no single st_case field.
--              Steps:
--                1.  Filter PERSON_2015 to months 1–8.
--                2.  Aggregate by the composite crash key to get:
--                     • persons_in_crash   – distinct persons per crash
--                     • severe_injured     – count of persons with severity 4
--                3.  In the outer query, calculate:
--                     Numerator   = crashes with >1 person AND >1 severe injury
--                     Denominator = crashes with >1 person
--                4.  SAFE_DIVIDE guards against divide-by-zero; multiply by 100 for %.
WITH crash_stats AS (
  SELECT
    state_number,
    consecutive_number,
    COUNT(DISTINCT person_number) AS persons_in_crash,
    SUM(CASE WHEN injury_severity = 4 THEN 1 ELSE 0 END) AS severe_injured
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY
    state_number,
    consecutive_number
)
SELECT
  SAFE_DIVIDE(
    COUNTIF(persons_in_crash > 1 AND severe_injured > 1),
    COUNTIF(persons_in_crash > 1)
  ) * 100 AS pct_multi_person_crashes_with_multi_severe
FROM crash_stats;
