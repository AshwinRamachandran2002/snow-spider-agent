```sql
--Description: 8) FINAL – Compute the percentage of Jan-to-Aug 2015 crashes that
--              (a) involve >1 distinct person  AND
--              (b) have >1 severely injured person (injury_severity = 4)
WITH crash_stats AS (
  SELECT
    `ST_CASE`,
    COUNT(DISTINCT person_number)                                       AS persons_in_crash,
    SUM(CASE WHEN injury_severity = 4 THEN 1 ELSE 0 END)                AS severe_injured
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8     -- January through August
  GROUP BY `ST_CASE`
)
SELECT
  COUNTIF(severe_injured > 1 AND persons_in_crash > 1) * 100.0
  / COUNTIF(persons_in_crash > 1)                                AS pct_multi_person_crashes_with_multi_severe
FROM crash_stats;
