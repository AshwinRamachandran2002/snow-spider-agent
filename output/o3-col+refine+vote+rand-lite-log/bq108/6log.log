--Description:  Combine the two sub-queries to compute the percentage of
--January–August multi-person crashes that also had more than one severe injury.
WITH all_multi_person AS (
  SELECT state_number, consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY state_number, consecutive_number
  HAVING COUNT(DISTINCT person_number) > 1
),
multi_person_multi_severe AS (
  SELECT state_number, consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY state_number, consecutive_number
  HAVING
    COUNT(DISTINCT person_number) > 1
    AND COUNTIF(injury_severity = 4) > 1
)
SELECT
  (SELECT COUNT(*) FROM multi_person_multi_severe) AS crashes_with_multi_severe,
  (SELECT COUNT(*) FROM all_multi_person)          AS all_multi_person_crashes,
  SAFE_DIVIDE(
    (SELECT COUNT(*) FROM multi_person_multi_severe),
    (SELECT COUNT(*) FROM all_multi_person)
  ) * 100 AS pct_with_multi_severe_injuries
LIMIT 20
