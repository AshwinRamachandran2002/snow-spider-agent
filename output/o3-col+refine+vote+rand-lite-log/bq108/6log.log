```sql
--Description:  In the `person_2015` table the crash identifier is named
--`st_case` (lower-case).  The query below solves the task in one pass:
--  1.  Filter to crashes that occurred January–August 2015.
--  2.  Aggregate by `st_case` to count distinct persons and the number with
--      severe injuries (injury_severity = 4) in each crash.
--  3.  Keep only crashes that involved more than one distinct person.
--  4.  From those crashes, compute the share (percentage) where more than one
--      person suffered a severe injury.
WITH crash_stats AS (
  SELECT
    st_case,
    COUNT(DISTINCT person_number)                       AS person_cnt,
    COUNTIF(injury_severity = 4)                        AS severe_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8                   -- Jan–Aug
  GROUP BY st_case
  HAVING person_cnt > 1                                 -- crashes with >1 person
)
SELECT
  ROUND(
        100 * SUM(CASE WHEN severe_cnt > 1 THEN 1 ELSE 0 END)
      / COUNT(*)
  , 2) AS pct_accidents_with_multiple_severe_injuries
FROM crash_stats;
```
