```sql
--Description:
-- The earlier failure happened because the column was referenced with back-quotes
-- and in upper-case (`ST_CASE`); BigQuery treats quoted identifiers as
-- case-sensitive, whereas the actual column is lower-case `st_case`.  
-- The following single query fixes the column name and performs the entire
-- analysis in one shot:
--   1.  Restrict the 2015 PERSON table to crashes that occurred in months
--       1‒8 (January–August).
--   2.  Aggregate by `st_case` (one row per crash) to obtain:
--          • `persons`  – number of distinct people in the crash
--          • `severe`   – number of people with injury_severity = 4
--   3.  From those aggregated rows, count
--          • all crashes that involved >1 person
--          • the subset of those that also had >1 severe injury
--   4.  Compute the percentage of multi-person crashes that satisfy the
--       second condition.
WITH per_crash AS (
  SELECT
    st_case,
    COUNT(DISTINCT person_number)        AS persons,
    COUNTIF(injury_severity = 4)         AS severe
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY st_case
)
SELECT
  SAFE_DIVIDE(
    SUM(CASE WHEN persons > 1 AND severe > 1 THEN 1 ELSE 0 END),
    SUM(CASE WHEN persons > 1              THEN 1 ELSE 0 END)
  ) * 100 AS pct_multi_person_with_multi_severe
FROM per_crash;
```
