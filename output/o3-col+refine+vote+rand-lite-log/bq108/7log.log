```sql
-- Percentage of Jan–Aug 2015 crashes (with >1 person) that had >1 person fatally injured
WITH persons AS (
  SELECT
    ST_CASE,               -- crash identifier
    person_number,
    injury_severity
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8        -- Jan–Aug 2015
),

crash_level AS (
  SELECT
    ST_CASE,
    COUNT(DISTINCT person_number)                      AS persons_in_crash,
    COUNTIF(injury_severity = 4)                       AS severe_injuries
  FROM persons
  GROUP BY ST_CASE
),

multi_person_crashes AS (
  SELECT *
  FROM crash_level
  WHERE persons_in_crash > 1                           -- crashes with >1 person
)

SELECT
  ROUND(
    100 * SAFE_DIVIDE(
      COUNTIF(severe_injuries > 1),                   -- numerator: >1 severe injury
      COUNT(*)                                        -- denominator: all multi-person crashes
    ),
    4
  ) AS pct_multi_severe_in_multi_person_crashes
;
```
