```sql
--Description: We need the 2015 share of crashes (Jan–Aug) that:  
--  1) involved more than one person, and  
--  2) had more than one person with injury_severity = 4.  
-- Approach (all done in one statement):  
--  • Aggregate the person-level table by crash ID (st_case).  
--  • For each crash, count distinct persons and how many of them have severe injuries.  
--  • Keep only crashes where persons_in_crash > 1.  
--  • In the outer SELECT, compute the percentage of those multi-person crashes that also have >1 severe injury.  
--  • SAFE_DIVIDE prevents division-by-zero if, for some reason, no multi-person crashes meet the criteria.
SELECT
  100 * SAFE_DIVIDE(
        SUM(CASE WHEN severe_injuries > 1 THEN 1 ELSE 0 END),  -- numerator
        COUNT(*)                                               -- denominator: all multi-person crashes
      ) AS pct_multi_person_crashes_with_multiple_severe_injuries
FROM (
  SELECT
    st_case,
    COUNT(DISTINCT person_number) AS persons_in_crash,
    COUNTIF(injury_severity = 4)  AS severe_injuries
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8     -- January through August
  GROUP BY st_case
  HAVING persons_in_crash > 1              -- only crashes with >1 person
);
```
