```

```sql
-- Description: Show 20 accidents (ST_CASEs) that occurred Jan-Aug and list their people
SELECT 
  `ST_CASE`,
  `person_number`,
  `month_of_crash`,
  `injury_severity`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
WHERE `month_of_crash` BETWEEN 1 AND 8
ORDER BY `ST_CASE`, `person_number`
LIMIT 20;
```

```sql
-- Description: Count how many distinct persons were in each accident Jan-Aug 2015
SELECT
  `ST_CASE`,
  COUNT(DISTINCT `person_number`) AS persons_in_accident
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
WHERE `month_of_crash` BETWEEN 1 AND 8
GROUP BY `ST_CASE`
ORDER BY persons_in_accident DESC
LIMIT 20;
```

```sql
-- Description: Accidents (Jan-Aug) that involved more than one person
SELECT
  `ST_CASE`,
  COUNT(DISTINCT `person_number`) AS persons_in_accident
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
WHERE `month_of_crash` BETWEEN 1 AND 8
GROUP BY `ST_CASE`
HAVING persons_in_accident > 1
ORDER BY `ST_CASE`
LIMIT 20;
```

```sql
-- Description: For those multi-person accidents, also count how many persons had injury_severity=4
SELECT
  `ST_CASE`,
  COUNT(DISTINCT `person_number`)                              AS persons_in_accident,
  COUNTIF(`injury_severity` = 4)                               AS severe_injuries
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
WHERE `month_of_crash` BETWEEN 1 AND 8
GROUP BY `ST_CASE`
HAVING persons_in_accident > 1
ORDER BY severe_injuries DESC, persons_in_accident DESC
LIMIT 20;
```

```sql
-- Description: List accidents with >1 person AND >1 severe injuries (Jan-Aug)
SELECT
  `ST_CASE`,
  COUNT(DISTINCT `person_number`) AS persons_in_accident,
  COUNTIF(`injury_severity` = 4)  AS severe_injuries
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
WHERE `month_of_crash` BETWEEN 1 AND 8
GROUP BY `ST_CASE`
HAVING persons_in_accident > 1
   AND severe_injuries > 1
ORDER BY `ST_CASE`
LIMIT 20;
```

```sql
-- Description: Aggregate counts we need: 
--   1) total accidents with >1 person (Jan-Aug)
--   2) of those, how many had >1 severe injuries
SELECT
  COUNTIF(persons_in_accident > 1)                               AS total_multi_person_accidents,
  COUNTIF(persons_in_accident > 1 AND severe_injuries > 1)       AS multi_person_with_multi_severe
FROM (
  SELECT
    `ST_CASE`,
    COUNT(DISTINCT `person_number`) AS persons_in_accident,
    COUNTIF(`injury_severity` = 4)  AS severe_injuries
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE `month_of_crash` BETWEEN 1 AND 8
  GROUP BY `ST_CASE`
);
```

```sql
-- Description: Final answer – percentage of Jan-Aug 2015 accidents with >1 person
--              that also had >1 person with injury_severity = 4
SELECT
  100.0 * SUM(CASE WHEN severe_injuries > 1 THEN 1 ELSE 0 END)
        / SUM(1) AS pct_multi_severe_in_multi_person_accidents
FROM (
  SELECT
    `ST_CASE`,
    COUNT(DISTINCT `person_number`) AS persons_in_accident,
    COUNTIF(`injury_severity` = 4)  AS severe_injuries
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE `month_of_crash` BETWEEN 1 AND 8
  GROUP BY `ST_CASE`
  HAVING persons_in_accident > 1           -- keep only accidents with more than one person
);
```
