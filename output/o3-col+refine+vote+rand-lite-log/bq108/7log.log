Query:
--Description: Aggregate counts we need:
--   1) total months (Jan–Aug) that recorded >1 person
--   2) of those, how many also had >1 severe injury
SELECT
  COUNTIF(persons_in_month > 1)                          AS total_multi_person_months,
  COUNTIF(persons_in_month > 1 AND severe_injuries > 1)  AS multi_person_months_with_multi_severe
FROM (
  SELECT
    month_of_crash,
    COUNT(DISTINCT person_number) AS persons_in_month,
    COUNTIF(injury_severity = 4)  AS severe_injuries
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY month_of_crash
)
Answer:
total_multi_person_months,multi_person_months_with_multi_severe
8,8
Query:
--Description: Final percentage of Jan–Aug 2015 months with >1 recorded person
--             that also had >1 person with injury_severity = 4
SELECT
  100 * SAFE_DIVIDE(
        SUM(CASE WHEN severe_injuries > 1 THEN 1 ELSE 0 END),
        COUNT(*)
      ) AS pct_multi_severe_in_multi_person_months
FROM (
  SELECT
    month_of_crash,
    COUNT(DISTINCT person_number) AS persons_in_month,
    COUNTIF(injury_severity = 4)  AS severe_injuries
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
  GROUP BY month_of_crash
  HAVING persons_in_month > 1
)
Answer:
pct_multi_severe_in_multi_person_months
100.0
