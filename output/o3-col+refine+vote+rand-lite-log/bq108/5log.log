```sql
--Description: For those crashes, count how many people in each crash have injury_severity = 4
WITH qualifying_accidents AS (
  SELECT ST_CASE
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
    AND (number_of_forms_submitted_for_persons_not_in_motor_vehicles +
         number_of_forms_submitted_for_persons_in_motor_vehicles) > 1
)
SELECT
  p.ST_CASE,
  COUNTIF(p.injury_severity = 4) AS fatal_injuries
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015` AS p
JOIN qualifying_accidents USING (ST_CASE)
GROUP BY p.ST_CASE
LIMIT 20;
```

```sql
--Description: Count qualifying crashes that have more than one person with injury_severity = 4 (numerator)
WITH qualifying_accidents AS (
  SELECT ST_CASE
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
    AND (number_of_forms_submitted_for_persons_not_in_motor_vehicles +
         number_of_forms_submitted_for_persons_in_motor_vehicles) > 1
), severe_counts AS (
  SELECT
    p.ST_CASE,
    COUNTIF(p.injury_severity = 4) AS fatal_injuries
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015` AS p
  JOIN qualifying_accidents USING (ST_CASE)
  GROUP BY p.ST_CASE
)
SELECT
  COUNT(*) AS accidents_with_multiple_fatals
FROM severe_counts
WHERE fatal_injuries > 1
LIMIT 20;
```

```sql
--Description: Calculate the required percentage of multi-fatal crashes among all qualifying crashes
WITH qualifying_accidents AS (
  SELECT ST_CASE
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
    AND (number_of_forms_submitted_for_persons_not_in_motor_vehicles +
         number_of_forms_submitted_for_persons_in_motor_vehicles) > 1
), severe_counts AS (
  SELECT
    p.ST_CASE,
    COUNTIF(p.injury_severity = 4) AS fatal_injuries
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015` AS p
  JOIN qualifying_accidents USING (ST_CASE)
  GROUP BY p.ST_CASE
), totals AS (
  SELECT
    (SELECT COUNT(*) FROM qualifying_accidents)                         AS total_accidents,
    (SELECT COUNT(*) FROM severe_counts WHERE fatal_injuries > 1)       AS multi_fatal_accidents
)
SELECT
  multi_fatal_accidents,
  total_accidents,
  SAFE_DIVIDE(multi_fatal_accidents, total_accidents) * 100 AS pct_multi_fatal
FROM totals
LIMIT 20;
```

