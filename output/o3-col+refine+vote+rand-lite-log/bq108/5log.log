Query:
--Description: Monthly percentage of multi-fatal crashes within the January–August window
WITH qualifying_accidents AS (
  SELECT consecutive_number, month_of_crash
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015`
  WHERE month_of_crash BETWEEN 1 AND 8
    AND (number_of_forms_submitted_for_persons_not_in_motor_vehicles +
         number_of_forms_submitted_for_persons_in_motor_vehicles) > 1
), severe_counts AS (
  SELECT
    p.consecutive_number,
    qa.month_of_crash,
    COUNTIF(p.injury_severity = 4) AS fatal_injuries
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015` AS p
  JOIN qualifying_accidents qa
    ON p.consecutive_number = qa.consecutive_number
  GROUP BY p.consecutive_number, qa.month_of_crash
), summary AS (
  SELECT
    month_of_crash,
    COUNT(*)                                    AS total_crashes,
    COUNTIF(fatal_injuries > 1)                 AS multi_fatal_crashes
  FROM severe_counts
  GROUP BY month_of_crash
)
SELECT
  month_of_crash,
  multi_fatal_crashes,
  total_crashes,
  SAFE_DIVIDE(multi_fatal_crashes, total_crashes) * 100 AS pct_multi_fatal
FROM summary
ORDER BY month_of_crash
LIMIT 20
