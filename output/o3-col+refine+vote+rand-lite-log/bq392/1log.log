Query:
--Description: Build a proper date string (YYYY-MM-DD) for October-2009 records of station 723758
SELECT
  FORMAT('%s-%s-%s', year, LPAD(mo,2,'0'), LPAD(da,2,'0')) AS full_date,
  temp
FROM `bigquery-public-data.noaa_gsod.gsod2009`
WHERE stn = '723758'
  AND mo  = '10'
  AND temp < 9999.9
ORDER BY temp DESC
LIMIT 20;
