--Description: 6) Compute per-variant statistics: total AC across all alt alleles at each locus  
SELECT
  CONCAT(start_position, '_', end_position)          AS variant_id,
  SUM(alt.AC)                                        AS total_AC_per_variant,
  ARRAY_AGG(DISTINCT vep_entry.SYMBOL IGNORE NULLS)  AS genes_per_variant
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
     UNNEST(alternate_bases) AS alt
LEFT JOIN UNNEST(alt.vep) AS vep_entry
ON TRUE
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
GROUP BY variant_id
LIMIT 20;
