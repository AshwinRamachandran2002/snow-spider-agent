```sql
--Description / Thinking process:
-- We need summary statistics for variants in chr1:55,039,447-55,064,852
--   • Pull all rows whose start_position is in that interval (inclusive).
--   • Unnest alternate_bases so each alt allele is visible and its AC accessible.
--   • Unnest VEP annotations (left-join) so we can collect gene symbols.
--   • Feed all rows into a CTE called region_variants holding:
--         variant_id  = "start_end" string (uniquely marks a locus)
--         ac          = allele count for that alt allele
--         gene_symbol = VEP SYMBOL (can be NULL)
--   • Final SELECT aggregates:
--         num_variants           = distinct loci count
--         total_allele_count     = Σ AC across all alt alleles
--         total_number_of_alleles= # rows (each alt allele)
--         gene_symbols           = distinct non-null symbols (IGNORE NULLS)
--         mutation_density       = region length (25 406 bp) ÷ num_variants
-- NOTE: region length = 55 064 852 − 55 039 447 + 1 = 25 406
WITH region_variants AS (
  SELECT
    CONCAT(start_position, '_', end_position) AS variant_id,
    alt.AC                                    AS ac,
    vep_entry.SYMBOL                          AS gene_symbol
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
       UNNEST(alternate_bases) AS alt
  LEFT JOIN UNNEST(alt.vep) AS vep_entry
  ON TRUE
  WHERE reference_name = 'chr1'
    AND start_position BETWEEN 55039447 AND 55064852
)
SELECT
  COUNT(DISTINCT variant_id)                                       AS num_variants,
  SUM(ac)                                                          AS total_allele_count,
  COUNT(ac)                                                        AS total_number_of_alleles,
  ARRAY_AGG(DISTINCT gene_symbol IGNORE NULLS ORDER BY gene_symbol) AS gene_symbols,
  (55064852 - 55039447 + 1) * 1.0 / COUNT(DISTINCT variant_id)     AS mutation_density
FROM region_variants;
```
