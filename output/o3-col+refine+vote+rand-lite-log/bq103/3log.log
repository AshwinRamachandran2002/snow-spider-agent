  AND  start_position BETWEEN 55039447 AND 55064852
LIMIT  20;
```

```sql
-- 2) Inspect the first few alternate–allele structs after unnesting `alternate_bases`
SELECT start_position,
       alt.alt       AS alt_allele,
       alt.AC        AS AC,
       alt.AF        AS AF,
       alt.n_alt_alleles
FROM   `bigquery-public-data.gnomAD.v3_genomes__chr1`,
       UNNEST(alternate_bases) AS alt
WHERE  reference_name = 'chr1'
  AND  start_position BETWEEN 55039447 AND 55064852
LIMIT  20;
```

```sql
-- 3) Count how many variant rows (sites) lie inside the interval
SELECT COUNT(*) AS n_variant_rows
FROM   `bigquery-public-data.gnomAD.v3_genomes__chr1`
WHERE  reference_name = 'chr1'
  AND  start_position BETWEEN 55039447 AND 55064852;
```

```sql
-- 4) Count distinct (position,alt-allele) pairs = “true” variants in the region
SELECT COUNT(DISTINCT CONCAT(CAST(start_position AS STRING),':',alt.alt)) AS n_variants
FROM   `bigquery-public-data.gnomAD.v3_genomes__chr1`,
       UNNEST(alternate_bases) AS alt
WHERE  reference_name = 'chr1'
  AND  start_position BETWEEN 55039447 AND 55064852;
```

```sql
-- 5) Sum all alternate allele counts (AC) observed in the region
SELECT SUM(alt.AC) AS total_AC
FROM   `bigquery-public-data.gnomAD.v3_genomes__chr1`,
       UNNEST(alternate_bases) AS alt
WHERE  reference_name = 'chr1'
  AND  start_position BETWEEN 55039447 AND 55064852;
```

```sql
-- 6) If the table contains a top-level allele number (AN), total it here
SELECT SUM(AN) AS total_AN
FROM   `bigquery-public-data.gnomAD.v3_genomes__chr1`
WHERE  reference_name = 'chr1'
  AND  start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- 7) Extract distinct gene symbols coming from the nested VEP annotation
SELECT DISTINCT vep.SYMBOL AS gene_symbol
FROM   `bigquery-public-data.gnomAD.v3_genomes__chr1`,
       UNNEST(alternate_bases)        AS alt,
       UNNEST(alt.vep)                AS vep
WHERE  reference_name = 'chr1'
  AND  start_position BETWEEN 55039447 AND 55064852
  AND  vep.SYMBOL IS NOT NULL
LIMIT 20;
```

```sql
-- 8) Aggregate per gene: how many variants and total AC each gene harbours in the window
SELECT vep.SYMBOL                        AS gene_symbol,
       COUNT(DISTINCT CONCAT(CAST(start_position AS STRING),':',alt.alt)) AS n_variants,
       SUM(alt.AC)                       AS total_AC
FROM   `bigquery-public-data.gnomAD.v3_genomes__chr1`,
       UNNEST(alternate_bases) AS alt,
       UNNEST(alt.vep)         AS vep
WHERE  reference_name = 'chr1'
  AND  start_position BETWEEN 55039447 AND 55064852
  AND  vep.SYMBOL IS NOT NULL
GROUP  BY gene_symbol
ORDER  BY n_variants DESC
LIMIT  20;
```

```sql
-- 9) Single-shot summary: number of variants, summed AC, summed AN (if present),
--    distinct gene symbols, and mutation density (region length / #variants)
WITH region AS (
  SELECT reference_name,
         start_position,
         alt.alt        AS alt_allele,
         alt.AC         AS AC,
         alt.AF         AS AF,
         vep.SYMBOL     AS gene
  FROM   `bigquery-public-data.gnomAD.v3_genomes__chr1`,
         UNNEST(alternate_bases) AS alt
  LEFT JOIN UNNEST(alt.vep)       AS vep
  WHERE  reference_name = 'chr1'
    AND  start_position BETWEEN 55039447 AND 55064852
)
SELECT
  COUNT(DISTINCT CONCAT(CAST(start_position AS STRING),':',alt_allele))        AS num_variants,
  SUM(AC)                                                                      AS total_allele_count,
  ARRAY_AGG(DISTINCT gene IGNORE NULLS)                                        AS distinct_gene_symbols,
  -- length of region (end – start +1) divided by number of variants
  (55064852 - 55039447 + 1) * 1.0 / COUNT(DISTINCT CONCAT(CAST(start_position AS STRING),':',alt_allele))
                                                                                AS bp_per_variant
FROM region;
```

```sql
-- 10) (Optional) Verify the calculated density by displaying both length and variant count side-by-side
WITH variant_ct AS (
  SELECT COUNT(DISTINCT CONCAT(CAST(start_position AS STRING),':',alt.alt)) AS n_variants
  FROM   `bigquery-public-data.gnomAD.v3_genomes__chr1`,
         UNNEST(alternate_bases) AS alt
  WHERE  reference_name = 'chr1'
    AND  start_position BETWEEN 55039447 AND 55064852
)
SELECT 55064852 - 55039447 + 1          AS region_length_bp,
       n_variants,
       (55064852 - 55039447 + 1) / n_variants AS bp_per_variant
FROM   variant_ct
LIMIT  20;
```

These ten progressively richer queries let you:  
1) view raw data, 2–6) build up essential counts, 7–8) pull gene names, and 9–10) deliver the requested final statistics, all using only the gnomAD v3 genomes table.
