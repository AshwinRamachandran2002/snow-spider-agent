```sql
--1. Quick look at any BRCA1 annotations in gnomAD v2.1.1 genomes (chromosome 17)
SELECT
  reference_name,
  start_position,
  reference_bases,
  alt_struct.alt AS alt,
  vep_struct.SYMBOL,
  vep_struct.Consequence
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(alternate_bases) AS alt_struct,
     UNNEST(vep)            AS vep_struct
WHERE vep_struct.SYMBOL = 'BRCA1'
LIMIT 20;
```

```sql
--2. Inspect BRCA1 records whose VEP consequence is (or includes) “missense_variant”
SELECT
  start_position,
  reference_bases,
  alt_struct.alt,
  vep_struct.Consequence
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(alternate_bases) AS alt_struct,
     UNNEST(vep)            AS vep_struct
WHERE vep_struct.SYMBOL = 'BRCA1'
  AND vep_struct.Consequence LIKE '%missense_variant%'
LIMIT 20;
```

```sql
--3. Same as (2) but add the ref/alt requirement:  ref = 'C'  &  alt = 'T'
SELECT
  start_position,
  reference_bases,
  alt_struct.alt,
  vep_struct.Consequence
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(alternate_bases) AS alt_struct,
     UNNEST(vep)            AS vep_struct
WHERE vep_struct.SYMBOL      = 'BRCA1'
  AND vep_struct.Consequence LIKE '%missense_variant%'
  AND reference_bases        = 'C'
  AND alt_struct.alt         = 'T'
LIMIT 20;
```

```sql
