```sql
-- Description: 1) List all championship years in the 1950-1959 interval                           (simple inspection)
SELECT DISTINCT year
FROM races
WHERE year BETWEEN 1950 AND 1959
ORDER BY year
LIMIT 20;
```

```sql
-- Description: 2) Show a few race-result rows from the 1950s (driver, constructor, round, etc.)
SELECT r.year,
       r.round,
       res.driver_id,
       res.constructor_id,
       res.position_text
FROM results AS res
JOIN races   AS r USING (race_id)
WHERE r.year BETWEEN 1950 AND 1959
LIMIT 20;
```

```sql
-- Description: 3) For every driver & year in the 1950s, obtain the first and last round           they entered
SELECT r.year,
       res.driver_id,
       MIN(r.round) AS first_round,
       MAX(r.round) AS last_round
FROM results AS res
JOIN races   AS r   USING (race_id)
WHERE r.year BETWEEN 1950 AND 1959
GROUP BY r.year,
         res.driver_id
LIMIT 20;
```

```sql
-- Description: 4) Pick the constructor used in each driver’s *first* race of every 1950s season
SELECT fr.year,
       fr.driver_id,
       res.constructor_id AS first_constructor_id
FROM (
        SELECT r.year,
               res.driver_id,
               MIN(r.round) AS first_round
        FROM results AS res
        JOIN races   AS r   USING (race_id)
        WHERE r.year BETWEEN 1950 AND 1959
        GROUP BY r.year,
                 res.driver_id
     ) AS fr
JOIN races   AS r2  ON (r2.year = fr.year  AND r2.round = fr.first_round)
JOIN results AS res ON (res.race_id = r2.race_id AND res.driver_id = fr.driver_id)
LIMIT 20;
```

```sql
-- Description: 5) Pick the constructor used in each driver’s *last* race of every 1950s season
SELECT lr.year,
       lr.driver_id,
       res.constructor_id AS last_constructor_id
FROM (
        SELECT r.year,
               res.driver_id,
               MAX(r.round) AS last_round
        FROM results AS res
        JOIN races   AS r   USING (race_id)
        WHERE r.year BETWEEN 1950 AND 1959
        GROUP BY r.year,
                 res.driver_id
     ) AS lr
JOIN races   AS r2  ON (r2.year = lr.year  AND r2.round = lr.last_round)
JOIN results AS res ON (res.race_id = r2.race_id AND res.driver_id = lr.driver_id)
LIMIT 20;
```

```sql
-- Description: 6) Build a list of driver-seasons where (a) at least 2 different race rounds        were entered, and (b) the same constructor appeared in the first & last race
WITH driver_rounds AS (
     SELECT r.year,
            res.driver_id,
            MIN(r.round) AS first_round,
            MAX(r.round) AS last_round
     FROM results AS res
     JOIN races   AS r   USING (race_id)
     WHERE r.year BETWEEN 1950 AND 1959
     GROUP BY r.year,
              res.driver_id
     HAVING COUNT(DISTINCT r.round) >= 2              -- at least two different rounds
),
first_constructor AS (
     SELECT dr.year,
            dr.driver_id,
            res.constructor_id AS constructor_first
     FROM driver_rounds AS dr
     JOIN races          AS r   ON (r.year  = dr.year
                                 AND r.round = dr.first_round)
     JOIN results        AS res ON (res.race_id  = r.race_id
                                 AND res.driver_id = dr.driver_id)
),
last_constructor AS (
     SELECT dr.year,
            dr.driver_id,
            res.constructor_id AS constructor_last
     FROM driver_rounds AS dr
     JOIN races          AS r   ON (r.year  = dr.year
                                 AND r.round = dr.last_round)
     JOIN results        AS res ON (res.race_id  = r.race_id
                                 AND res.driver_id = dr.driver_id)
),
same_team AS (
     SELECT f.year,
            f.driver_id
     FROM first_constructor AS f
     JOIN last_constructor  AS l
           ON l.year = f.year
          AND l.driver_id = f.driver_id
     WHERE f.constructor_first = l.constructor_last    -- same constructor
)
SELECT *
FROM same_team
LIMIT 20;
```

```sql
-- Description: 7) Attach driver names to the filtered driver-seasons (verification step)
SELECT st.year,
       d.driver_id,
       d.forename || ' ' || d.surname AS driver_name
FROM same_team AS st
JOIN drivers   AS d  USING (driver_id)
ORDER BY st.year,
         driver_name
LIMIT 20;
```

```sql
-- Description: 8) Obtain the *distinct* list of drivers who satisfy every condition (final answer)
WITH driver_rounds AS (
     SELECT r.year,
            res.driver_id,
            MIN(r.round) AS first_round,
            MAX(r.round) AS last_round
     FROM results AS res
     JOIN races   AS r   USING (race_id)
     WHERE r.year BETWEEN 1950 AND 1959
     GROUP BY r.year,
              res.driver_id
     HAVING COUNT(DISTINCT r.round) >= 2
),
first_constructor AS (
     SELECT dr.year,
            dr.driver_id,
            res.constructor_id AS constructor_first
     FROM driver_rounds AS dr
     JOIN races          AS r   ON (r.year  = dr.year
                                 AND r.round = dr.first_round)
     JOIN results        AS res ON (res.race_id  = r.race_id
                                 AND res.driver_id = dr.driver_id)
),
last_constructor AS (
     SELECT dr.year,
            dr.driver_id,
            res.constructor_id AS constructor_last
     FROM driver_rounds AS dr
     JOIN races          AS r   ON (r.year  = dr.year
                                 AND r.round = dr.last_round)
     JOIN results        AS res ON (res.race_id  = r.race_id
                                 AND res.driver_id = dr.driver_id)
),
same_team AS (
     SELECT f.year,
            f.driver_id
     FROM first_constructor AS f
     JOIN last_constructor  AS l
           ON l.year = f.year
          AND l.driver_id = f.driver_id
     WHERE f.constructor_first = l.constructor_last
)
SELECT DISTINCT d.forename || ' ' || d.surname AS driver_name
FROM same_team AS st
JOIN drivers    AS d  USING (driver_id)
ORDER BY driver_name
LIMIT 20;
```

