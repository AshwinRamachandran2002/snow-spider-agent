-- Description / Thinking process:
-- Goal: find every driver who, in ANY season during the 1950-1959 decade,
--       1) competed in at least two different race rounds,
--       2) drove for the SAME constructor in both their first and last race
--          of that season.
-- Approach:
-- • driver_rounds:   for each (year, driver) gather first and last round; keep if ≥2 rounds.
-- • first_constructor / last_constructor: fetch constructor used in those rounds.
-- • same_team:       retain driver-seasons where constructor_first = constructor_last.
-- • Final SELECT:    list season, driver_id and driver’s full name (verification sample, 20 rows).
WITH driver_rounds AS (
    SELECT r.year,
           res.driver_id,
           MIN(r.round) AS first_round,
           MAX(r.round) AS last_round
    FROM results AS res
    JOIN races  AS r  USING (race_id)
    WHERE r.year BETWEEN 1950 AND 1959
    GROUP BY r.year, res.driver_id
    HAVING COUNT(DISTINCT r.round) >= 2            -- at least two rounds
),
first_constructor AS (
    SELECT dr.year,
           dr.driver_id,
           res.constructor_id AS constructor_first
    FROM driver_rounds dr
    JOIN races   r   ON r.year = dr.year  AND r.round = dr.first_round
    JOIN results res ON res.race_id = r.race_id  AND res.driver_id = dr.driver_id
),
last_constructor AS (
    SELECT dr.year,
           dr.driver_id,
           res.constructor_id AS constructor_last
    FROM driver_rounds dr
    JOIN races   r   ON r.year = dr.year  AND r.round = dr.last_round
    JOIN results res ON res.race_id = r.race_id  AND res.driver_id = dr.driver_id
),
same_team AS (
    SELECT f.year,
           f.driver_id
    FROM first_constructor f
    JOIN last_constructor  l
      ON l.year = f.year
     AND l.driver_id = f.driver_id
    WHERE f.constructor_first = l.constructor_last  -- same constructor
)
SELECT st.year,
       st.driver_id,
       d.forename || ' ' || d.surname AS driver_name
FROM same_team st
JOIN drivers  d ON d.driver_id = st.driver_id
ORDER BY st.year, driver_name
LIMIT 20;
