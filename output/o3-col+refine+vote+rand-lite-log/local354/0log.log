Query:
-- Description: 8) List the distinct drivers who meet the requirements (first & last race with
-- the same constructor, and at least two rounds in any 1950-59 season).
WITH driver_rounds AS (
    SELECT r.year,
           res.driver_id,
           MIN(r.round) AS first_round,
           MAX(r.round) AS last_round
    FROM results AS res
    JOIN races  AS r  USING (race_id)
    WHERE r.year BETWEEN 1950 AND 1959
    GROUP BY r.year, res.driver_id
    HAVING COUNT(DISTINCT r.round) >= 2
),
first_constructor AS (
    SELECT dr.year,
           dr.driver_id,
           res.constructor_id AS constructor_first
    FROM driver_rounds dr
    JOIN races   r   ON r.year = dr.year AND r.round = dr.first_round
    JOIN results res ON res.race_id = r.race_id AND res.driver_id = dr.driver_id
),
last_constructor AS (
    SELECT dr.year,
           dr.driver_id,
           res.constructor_id AS constructor_last
    FROM driver_rounds dr
    JOIN races   r   ON r.year = dr.year AND r.round = dr.last_round
    JOIN results res ON res.race_id = r.race_id AND res.driver_id = dr.driver_id
),
same_team AS (
    SELECT f.year,
           f.driver_id
    FROM first_constructor f
    JOIN last_constructor  l
         ON l.year = f.year
        AND l.driver_id = f.driver_id
    WHERE f.constructor_first = l.constructor_last
)
SELECT DISTINCT d.forename || ' ' || d.surname AS driver_name
FROM same_team st
JOIN drivers  d ON d.driver_id = st.driver_id
ORDER BY driver_name
LIMIT 20
