    JOIN races   r   ON r.year = dr.year AND r.round = dr.last_round
    JOIN results res ON res.race_id = r.race_id AND res.driver_id = dr.driver_id
)
SELECT COUNT(*) AS matching_driver_seasons
FROM first_constructor f
JOIN last_constructor l
      ON l.year = f.year
     AND l.driver_id = f.driver_id
WHERE f.constructor_first = l.constructor_last
LIMIT 20
