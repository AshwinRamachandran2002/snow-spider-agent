Query:
--Description: Produce driver-season pairs (year, driver_id) for 1950-59 in which
--             (a) the driver started ≥2 different rounds that year and
--             (b) the constructor in the first round equals the constructor in
--             the last round of that season.
WITH race_cnt AS (                                   -- rounds per driver-season
    SELECT r.year,
           res.driver_id,
           COUNT(DISTINCT r.round) AS race_cnt
    FROM   results res
    JOIN   races   r ON r.race_id = res.race_id
    WHERE  r.year BETWEEN 1950 AND 1959
    GROUP  BY r.year, res.driver_id
),
first_ctor AS (                                      -- constructor in first round
    SELECT r.year,
           res.driver_id,
           res.constructor_id
    FROM   results res
    JOIN   races   r ON r.race_id = res.race_id
    JOIN  ( SELECT r.year,
                   res.driver_id,
                   MIN(r.round) AS fr
            FROM   results res
            JOIN   races   r ON r.race_id = res.race_id
            WHERE  r.year BETWEEN 1950 AND 1959
            GROUP  BY r.year, res.driver_id
          ) f
      ON  f.year = r.year AND f.driver_id = res.driver_id AND f.fr = r.round
),
last_ctor AS (                                       -- constructor in last round
    SELECT r.year,
           res.driver_id,
           res.constructor_id
    FROM   results res
    JOIN   races   r ON r.race_id = res.race_id
    JOIN  ( SELECT r.year,
                   res.driver_id,
                   MAX(r.round) AS lr
            FROM   results res
            JOIN   races   r ON r.race_id = res.race_id
            WHERE  r.year BETWEEN 1950 AND 1959
            GROUP  BY r.year, res.driver_id
          ) l
      ON  l.year = r.year AND l.driver_id = res.driver_id AND l.lr = r.round
),
same_ctor AS (                                       -- keep seasons with same constructor
    SELECT f.year,
           f.driver_id
    FROM   first_ctor f
    JOIN   last_ctor  l
           ON  l.year      = f.year
          AND l.driver_id  = f.driver_id
          AND l.constructor_id = f.constructor_id
)
SELECT sc.year,
       sc.driver_id
FROM   same_ctor sc
JOIN   race_cnt rc ON rc.year = sc.year AND rc.driver_id = sc.driver_id
WHERE  rc.race_cnt >= 2
ORDER  BY sc.year, sc.driver_id
LIMIT 20
