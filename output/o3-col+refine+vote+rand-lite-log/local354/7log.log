-- 4. Grab the constructor used in a driver’s FIRST race
SELECT r."year",
       res."driver_id",
       res."constructor_id" AS "first_constructor_id"
FROM   "results" AS res
JOIN   "races"   AS r   ON r."race_id" = res."race_id"
JOIN  (
        SELECT   r."year",
                 res."driver_id",
                 MIN(r."round") AS "first_round"
        FROM     "results" AS res
        JOIN     "races"   AS r ON r."race_id" = res."race_id"
        WHERE    r."year" BETWEEN 1950 AND 1959
        GROUP BY r."year", res."driver_id"
      ) AS f
      ON  f."year"       = r."year"
      AND f."driver_id"  = res."driver_id"
      AND f."first_round"= r."round"
