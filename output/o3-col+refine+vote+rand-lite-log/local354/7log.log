```sql
-- 2. Look at a few race-by-race results from the first year (1950)
SELECT r."year",
       r."round",
       res."race_id",
       res."driver_id",
       res."constructor_id"
FROM   "results"        AS res
JOIN   "races"          AS r   ON r."race_id" = res."race_id"
WHERE  r."year" = 1950
LIMIT 20;
```

```sql
-- 3. For every driver-season of the 1950s, work out how many
--    different rounds they started
SELECT r."year",
       res."driver_id",
       COUNT(DISTINCT r."round") AS "race_count"
FROM   "results" AS res
JOIN   "races"   AS r ON r."race_id" = res."race_id"
WHERE  r."year" BETWEEN 1950 AND 1959
GROUP  BY r."year", res."driver_id"
HAVING "race_count" >= 2
LIMIT 20;
```

```sql
-- 4. Grab the constructor used in a driver’s FIRST race
SELECT r."year",
       res."driver_id",
       res."constructor_id" AS "first_constructor_id"
FROM   "results" AS res
JOIN   "races"   AS r   ON r."race_id" = res."race_id"
JOIN  (
        SELECT   r."year",
                 res."driver_id",
                 MIN(r."round") AS "first_round"
        FROM     "results" AS res
        JOIN     "races"   AS r ON r."race_id" = res."race_id"
        WHERE    r."year" BETWEEN 1950 AND 1959
        GROUP BY r."year", res."driver_id"
      ) AS f
      ON  f."year"       = r."year"
      AND f."driver_id"  = res."driver_id"
      AND f."first_round"= r."round"
LIMIT 20;
```

```sql
-- 5. Grab the constructor used in a driver’s LAST race
SELECT r."year",
       res."driver_id",
       res."constructor_id" AS "last_constructor_id"
FROM   "results" AS res
JOIN   "races"   AS r   ON r."race_id" = res."race_id"
JOIN  (
        SELECT   r."year",
                 res."driver_id",
                 MAX(r."round") AS "last_round"
        FROM     "results" AS res
        JOIN     "races"   AS r ON r."race_id" = res."race_id"
        WHERE    r."year" BETWEEN 1950 AND 1959
        GROUP BY r."year", res."driver_id"
      ) AS l
      ON  l."year"      = r."year"
      AND l."driver_id" = res."driver_id"
      AND l."last_round"= r."round"
LIMIT 20;
```

```sql
-- 6. Combine first- and last-race constructors; keep only cases
--    where they are the SAME
SELECT  f."year",
        f."driver_id",
        f."first_constructor_id"   AS "constructor_id"
FROM    (
          /* first-race constructor */
          SELECT r."year",
                 res."driver_id",
                 res."constructor_id"
          FROM   "results" AS res
          JOIN   "races"   AS r ON r."race_id" = res."race_id"
          JOIN  (
                  SELECT r."year",
                         res."driver_id",
                         MIN(r."round") AS "first_round"
                  FROM   "results" AS res
                  JOIN   "races"   AS r ON r."race_id" = res."race_id"
                  WHERE  r."year" BETWEEN 1950 AND 1959
                  GROUP BY r."year", res."driver_id"
                ) AS x
                ON  x."year"       = r."year"
                AND x."driver_id"  = res."driver_id"
                AND x."first_round"= r."round"
        ) AS f
JOIN    (
          /* last-race constructor */
          SELECT r."year",
                 res."driver_id",
                 res."constructor_id"
          FROM   "results" AS res
          JOIN   "races"   AS r ON r."race_id" = res."race_id"
          JOIN  (
                  SELECT r."year",
                         res."driver_id",
                         MAX(r."round") AS "last_round"
                  FROM   "results" AS res
                  JOIN   "races"   AS r ON r."race_id" = res."race_id"
                  WHERE  r."year" BETWEEN 1950 AND 1959
                  GROUP BY r."year", res."driver_id"
                ) AS y
                ON  y."year"      = r."year"
                AND y."driver_id" = res."driver_id"
                AND y."last_round"= r."round"
        ) AS l
        ON  f."year"      = l."year"
        AND f."driver_id" = l."driver_id"
        AND f."constructor_id" = l."constructor_id"
LIMIT 20;
```

```sql
-- 7. Add the race-count filter (>=2 rounds) to get the final set
SELECT  c."year",
        c."driver_id"
FROM   (
        /* same-constructor first & last races */
        SELECT  f."year",
                f."driver_id",
                f."constructor_id"
        FROM    (...) AS f   -- first-race CTE (see query 6)
        JOIN    (...) AS l   -- last-race CTE  (see query 6)
               ON  f."year"      = l."year"
               AND f."driver_id" = l."driver_id"
               AND f."constructor_id" = l."constructor_id"
       ) AS c
JOIN   (
        /* driver-season with at least two rounds */
        SELECT  r."year",
                res."driver_id",
                COUNT(DISTINCT r."round") AS "race_cnt"
        FROM    "results" AS res
        JOIN    "races"   AS r ON r."race_id" = res."race_id"
        WHERE   r."year" BETWEEN 1950 AND 1959
        GROUP BY r."year", res."driver_id"
        HAVING  "race_cnt" >= 2
       ) AS cnt
       ON  cnt."year"      = c."year"
       AND cnt."driver_id" = c."driver_id"
LIMIT 20;
```

```sql
-- 8. Final answer – list the 1950s drivers (full names) who
--    started & ended the season with the same constructor and
--    contested at least two different rounds
SELECT DISTINCT d."full_name"    AS "Driver",
                final."year"     AS "Season"
FROM  (
        /* driver-season summary satisfying all conditions */
        SELECT  s."year",
                s."driver_id"
        FROM   (
                /* step 7 condensed into one CTE for clarity */
                SELECT  r."year",
                        res."driver_id",
                        MIN(r."round")                    AS "min_round",
                        MAX(r."round")                    AS "max_round",
                        COUNT(DISTINCT r."round")         AS "race_cnt",
                        MIN(res."constructor_id") FILTER (WHERE r."round" = MIN(r."round")) AS "first_ctor",
                        MIN(res."constructor_id") FILTER (WHERE r."round" = MAX(r."round")) AS "last_ctor"
                FROM    "results" AS res
                JOIN    "races"   AS r ON r."race_id" = res."race_id"
                WHERE   r."year" BETWEEN 1950 AND 1959
                GROUP BY r."year", res."driver_id"
               ) AS s
        WHERE   s."race_cnt" >= 2
          AND   s."first_ctor" = s."last_ctor"
      ) AS final
JOIN   "drivers_ext" AS d ON d."driver_id" = final."driver_id"
ORDER BY final."year", d."full_name"
LIMIT 20;
```
