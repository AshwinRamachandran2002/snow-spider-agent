```sql
--Description:
-- Identify every driver-season in the 1950s where:
--   • the driver started at least two different rounds that year, and
--   • the constructor in the driver’s first race of the season equals the constructor
--     in the driver’s last race of the same season.
-- Output the driver’s full name (forename + surname) and the season (year).

WITH season_rounds AS (                            -- rounds, first & last for each driver-season
    SELECT r.year,
           res.driver_id,
           COUNT(DISTINCT r.round)                      AS rounds,
           MIN(r.round)                                AS first_round,
           MAX(r.round)                                AS last_round
    FROM   results res
    JOIN   races   r ON r.race_id = res.race_id
    WHERE  r.year BETWEEN 1950 AND 1959
    GROUP  BY r.year, res.driver_id
),
first_last_ctor AS (                            -- constructor in first & last round
    SELECT sr.year,
           sr.driver_id,
           sr.rounds,
           MAX(CASE WHEN r.round = sr.first_round THEN res.constructor_id END) AS first_ctor,
           MAX(CASE WHEN r.round = sr.last_round  THEN res.constructor_id END) AS last_ctor
    FROM   season_rounds sr
    JOIN   results       res ON res.driver_id = sr.driver_id
    JOIN   races         r   ON r.race_id = res.race_id AND r.year = sr.year
    GROUP  BY sr.year, sr.driver_id, sr.rounds
)
SELECT d.forename || ' ' || d.surname  AS Driver,
       fl.year                         AS Season
FROM   first_last_ctor fl
JOIN   drivers        d  ON d.driver_id = fl.driver_id
WHERE  fl.rounds >= 2                  -- participated in ≥ 2 rounds
  AND  fl.first_ctor = fl.last_ctor    -- same constructor first & last race
ORDER  BY fl.year, Driver;
```
