```sql
--Description: 1)  What seasons are available in the 1950-1959 time-span?
SELECT DISTINCT year
FROM races
WHERE year BETWEEN 1950 AND 1959
ORDER BY year
LIMIT 20;
```

```sql
--Description: 2)  All results from races that took place during the 1950s.
SELECT r.result_id,
       r.driver_id,
       r.constructor_id,
       ra.year,
       ra.round
FROM results AS r
JOIN races  AS ra ON ra.race_id = r.race_id
WHERE ra.year BETWEEN 1950 AND 1959
LIMIT 20;
```

```sql
--Description: 3)  Which drivers appear in those 1950s results?
SELECT DISTINCT r.driver_id, d.forename || ' ' || d.surname AS driver_name
FROM results  AS r
JOIN races    AS ra ON ra.race_id  = r.race_id
JOIN drivers  AS d  ON d.driver_id = r.driver_id
WHERE ra.year BETWEEN 1950 AND 1959
LIMIT 20;
```

```sql
--Description: 4)  Take one example driver (id = 647) to see every 1950-season race he entered.
SELECT ra.year,
       ra.round,
       r.driver_id,
       r.constructor_id
FROM results AS r
JOIN races   AS ra ON ra.race_id = r.race_id
WHERE ra.year = 1950
  AND r.driver_id = 647
ORDER BY ra.round
LIMIT 20;
```

```sql
--Description: 5)  For every driver-season in the 1950s get the first and last round they raced.
SELECT r.driver_id,
       ra.year,
       MIN(ra.round) AS first_round,
       MAX(ra.round) AS last_round,
       COUNT(DISTINCT ra.round) AS rounds_entered
FROM results AS r
JOIN races   AS ra ON ra.race_id = r.race_id
WHERE ra.year BETWEEN 1950 AND 1959
GROUP BY r.driver_id, ra.year
HAVING rounds_entered >= 2
LIMIT 20;
```

```sql
--Description: 6)  Add the constructor used in the first round of each driver-season.
WITH firsts AS (
    SELECT r.driver_id,
           ra.year,
           ra.round,
           r.constructor_id
    FROM results AS r
    JOIN races AS ra ON ra.race_id = r.race_id
    WHERE ra.year BETWEEN 1950 AND 1959
), first_rounds AS (
    SELECT driver_id, year,
           MIN(round) AS first_round
    FROM firsts
    GROUP BY driver_id, year
)
SELECT f.driver_id, f.year, f.constructor_id AS first_constructor
FROM firsts AS f
JOIN first_rounds AS fr
  ON f.driver_id = fr.driver_id
 AND f.year      = fr.year
 AND f.round     = fr.first_round
LIMIT 20;
```

```sql
--Description: 7)  Likewise, grab the constructor used in the last round of each driver-season.
WITH lasts AS (
    SELECT r.driver_id,
           ra.year,
           ra.round,
           r.constructor_id
    FROM results AS r
    JOIN races AS ra ON ra.race_id = r.race_id
    WHERE ra.year BETWEEN 1950 AND 1959
), last_rounds AS (
    SELECT driver_id, year,
           MAX(round) AS last_round
    FROM lasts
    GROUP BY driver_id, year
)
SELECT l.driver_id, l.year, l.constructor_id AS last_constructor
FROM lasts AS l
JOIN last_rounds AS lr
  ON l.driver_id = lr.driver_id
 AND l.year      = lr.year
 AND l.round     = lr.last_round
LIMIT 20;
```

```sql
--Description: 8)  Combine the pieces: driver-seasons where the first and last constructor match and at least two rounds were entered.
WITH base AS (
    SELECT r.driver_id,
           ra.year,
           ra.round,
           r.constructor_id
    FROM results AS r
    JOIN races   AS ra ON ra.race_id = r.race_id
    WHERE ra.year BETWEEN 1950 AND 1959
),
first_last AS (
    SELECT b.driver_id,
           b.year,
           MIN(b.round) AS first_round,
           MAX(b.round) AS last_round,
           COUNT(DISTINCT b.round) AS rounds_entered
    FROM base AS b
    GROUP BY b.driver_id, b.year
    HAVING rounds_entered >= 2
),
first_const AS (
    SELECT bl.driver_id,
           bl.year,
           b.constructor_id AS first_constructor
    FROM first_last AS bl
    JOIN base      AS b
      ON b.driver_id = bl.driver_id
     AND b.year      = bl.year
     AND b.round     = bl.first_round
),
last_const AS (
    SELECT bl.driver_id,
           bl.year,
           b.constructor_id AS last_constructor
    FROM first_last AS bl
    JOIN base      AS b
      ON b.driver_id = bl.driver_id
     AND b.year      = bl.year
     AND b.round     = bl.last_round
)
SELECT fc.driver_id,
       fc.year,
       fc.first_constructor
FROM first_const AS fc
JOIN last_const  AS lc
  ON fc.driver_id = lc.driver_id
 AND fc.year      = lc.year
WHERE fc.first_constructor = lc.last_constructor
LIMIT 20;
```

```sql
--Description: 9)  Show the human-readable driver names that satisfy the requirement (final answer list).
WITH base AS (
    SELECT r.driver_id,
           ra.year,
           ra.round,
           r.constructor_id
    FROM results AS r
    JOIN races   AS ra ON ra.race_id = r.race_id
    WHERE ra.year BETWEEN 1950 AND 1959
),
first_last AS (
    SELECT b.driver_id,
           b.year,
           MIN(b.round) AS first_round,
           MAX(b.round) AS last_round,
           COUNT(DISTINCT b.round) AS rounds_entered
    FROM base AS b
    GROUP BY b.driver_id, b.year
    HAVING rounds_entered >= 2
),
first_const AS (
    SELECT bl.driver_id,
           bl.year,
           b.constructor_id AS first_constructor
    FROM first_last AS bl
    JOIN base      AS b
      ON b.driver_id = bl.driver_id
     AND b.year      = bl.year
     AND b.round     = bl.first_round
),
last_const AS (
    SELECT bl.driver_id,
           bl.year,
           b.constructor_id AS last_constructor
    FROM first_last AS bl
    JOIN base      AS b
      ON b.driver_id = bl.driver_id
     AND b.year      = bl.year
     AND b.round     = bl.last_round
),
qualified AS (
    SELECT fc.driver_id
    FROM first_const AS fc
    JOIN last_const  AS lc
      ON fc.driver_id = lc.driver_id
     AND fc.year      = lc.year
    WHERE fc.first_constructor = lc.last_constructor
)
SELECT DISTINCT q.driver_id,
       d.forename || ' ' || d.surname AS driver_name
FROM qualified AS q
JOIN drivers   AS d ON d.driver_id = q.driver_id
ORDER BY driver_name
LIMIT 20;
```

```sql
--Description: 10)  For completeness, list the driver, season and constructor for each qualifying season.
WITH base AS (
    SELECT r.driver_id,
           ra.year,
           ra.round,
           r.constructor_id
    FROM results AS r
    JOIN races   AS ra ON ra.race_id = r.race_id
    WHERE ra.year BETWEEN 1950 AND 1959
),
first_last AS (
    SELECT b.driver_id,
           b.year,
           MIN(b.round) AS first_round,
           MAX(b.round) AS last_round,
           COUNT(DISTINCT b.round) AS rounds_entered
    FROM base AS b
    GROUP BY b.driver_id, b.year
    HAVING rounds_entered >= 2
),
first_const AS (
    SELECT bl.driver_id,
           bl.year,
           b.constructor_id AS first_constructor
    FROM first_last AS bl
    JOIN base      AS b
      ON b.driver_id = bl.driver_id
     AND b.year      = bl.year
     AND b.round     = bl.first_round
),
last_const AS (
    SELECT bl.driver_id,
           bl.year,
           b.constructor_id AS last_constructor
    FROM first_last AS bl
    JOIN base      AS b
      ON b.driver_id = bl.driver_id
     AND b.year      = bl.year
     AND b.round     = bl.last_round
),
qualified AS (
    SELECT fc.driver_id,
           fc.year,
           fc.first_constructor
    FROM first_const AS fc
    JOIN last_const  AS lc
      ON fc.driver_id       = lc.driver_id
     AND fc.year            = lc.year
    WHERE fc.first_constructor = lc.last_constructor
)
SELECT q.driver_id,
       d.forename || ' ' || d.surname AS driver_name,
       q.year,
       c.name AS constructor_name
FROM qualified    AS q
JOIN drivers      AS d ON d.driver_id      = q.driver_id
JOIN constructors AS c ON c.constructor_id = q.first_constructor
ORDER BY q.year, driver_name
LIMIT 20;
```
