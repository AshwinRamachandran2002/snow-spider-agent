--Description: 5)  For every driver-season in the 1950s get the first and last round they raced.
SELECT r.driver_id,
       ra.year,
       MIN(ra.round) AS first_round,
       MAX(ra.round) AS last_round,
       COUNT(DISTINCT ra.round) AS rounds_entered
FROM results AS r
JOIN races   AS ra ON ra.race_id = r.race_id
WHERE ra.year BETWEEN 1950 AND 1959
GROUP BY r.driver_id, ra.year
HAVING rounds_entered >= 2
LIMIT 20;
