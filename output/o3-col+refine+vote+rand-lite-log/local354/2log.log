--Description: 6)  Add the constructor used in the first round of each driver-season.
WITH firsts AS (
    SELECT r.driver_id,
           ra.year,
           ra.round,
           r.constructor_id
    FROM results AS r
    JOIN races AS ra ON ra.race_id = r.race_id
    WHERE ra.year BETWEEN 1950 AND 1959
), first_rounds AS (
    SELECT driver_id, year,
           MIN(round) AS first_round
    FROM firsts
    GROUP BY driver_id, year
)
SELECT f.driver_id, f.year, f.constructor_id AS first_constructor
FROM firsts AS f
JOIN first_rounds AS fr
  ON f.driver_id = fr.driver_id
 AND f.year      = fr.year
 AND f.round     = fr.first_round
LIMIT 20;
