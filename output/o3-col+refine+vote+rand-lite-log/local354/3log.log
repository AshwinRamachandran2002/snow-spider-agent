```sql
-- Description: 1) 1950-1959 race calendar overview (year, round, race-id, name)
SELECT "year", "round", "race_id", "name"
FROM "races"
WHERE "year" BETWEEN 1950 AND 1959
ORDER BY "year", "round"
LIMIT 20;
```

```sql
-- Description: 2) Raw 1950s race results – who (driver_id) raced when (year, round) and for whom (constructor_id)
SELECT r."race_id",
       ra."year",
       ra."round",
       r."driver_id",
       r."constructor_id"
FROM   "results" AS r
JOIN   "races"   AS ra ON r."race_id" = ra."race_id"
WHERE  ra."year" BETWEEN 1950 AND 1959
LIMIT 20;
```

```sql
-- Description: 3) How many distinct race rounds each driver entered per season in the 1950s
SELECT ra."year",
       r."driver_id",
       COUNT(DISTINCT ra."round") AS "rounds_entered"
FROM   "results" r
JOIN   "races"   ra ON ra."race_id" = r."race_id"
WHERE  ra."year" BETWEEN 1950 AND 1959
GROUP  BY ra."year", r."driver_id"
HAVING "rounds_entered" >= 2
LIMIT 20;
```

```sql
-- Description: 4) For every driver-season with ≥2 rounds, identify the FIRST race they started that year
SELECT t."year",
       t."driver_id",
       MIN(t."round") AS "first_round"
FROM (
      SELECT ra."year",
             ra."round",
             r."driver_id"
      FROM   "results" r
      JOIN   "races" ra ON ra."race_id" = r."race_id"
      WHERE  ra."year" BETWEEN 1950 AND 1959
     ) AS t
GROUP BY t."year", t."driver_id"
LIMIT 20;
```

```sql
-- Description: 5) Constructor used in the FIRST race of each qualifying driver-season
SELECT f."year",
       f."driver_id",
       r."constructor_id" AS "constructor_first"
FROM   (
        /* first round per driver-season (query 4) */
        SELECT ra."year",
               r."driver_id",
               MIN(ra."round") AS "first_round"
        FROM   "results" r
        JOIN   "races"   ra ON ra."race_id" = r."race_id"
        WHERE  ra."year" BETWEEN 1950 AND 1959
        GROUP  BY ra."year", r."driver_id"
       ) AS f
JOIN  "races"   ra ON ra."year"  = f."year"  AND ra."round" = f."first_round"
JOIN  "results" r  ON r."race_id" = ra."race_id" AND r."driver_id" = f."driver_id"
LIMIT 20;
```

```sql
-- Description: 6) Constructor used in the LAST race of each driver-season (≥2 rounds)
SELECT l."year",
       l."driver_id",
       r."constructor_id" AS "constructor_last"
FROM   (
        SELECT ra."year",
               r."driver_id",
               MAX(ra."round") AS "last_round"
        FROM   "results" r
        JOIN   "races"   ra ON ra."race_id" = r."race_id"
        WHERE  ra."year" BETWEEN 1950 AND 1959
        GROUP  BY ra."year", r."driver_id"
       ) AS l
JOIN  "races"   ra ON ra."year"  = l."year"  AND ra."round" = l."last_round"
JOIN  "results" r  ON r."race_id" = ra."race_id" AND r."driver_id" = l."driver_id"
LIMIT 20;
```

```sql
-- Description: 7) Combine FIRST & LAST constructor per driver-season and retain those where they match
WITH firsts AS (
     SELECT ra."year",
            r."driver_id",
            r."constructor_id" AS "constructor_first"
     FROM   "results" r
     JOIN   "races"   ra ON ra."race_id" = r."race_id"
     WHERE  ra."year" BETWEEN 1950 AND 1959
     GROUP  BY ra."year", r."driver_id"
     HAVING ra."round" = MIN(ra."round")
),
lasts AS (
     SELECT ra."year",
            r."driver_id",
            r."constructor_id" AS "constructor_last"
     FROM   "results" r
     JOIN   "races"   ra ON ra."race_id" = r."race_id"
     WHERE  ra."year" BETWEEN 1950 AND 1959
     GROUP  BY ra."year", r."driver_id"
     HAVING ra."round" = MAX(ra."round")
)
SELECT f."year",
       f."driver_id",
       f."constructor_first"
FROM   firsts f
JOIN   lasts  l ON l."year" = f."year" AND l."driver_id" = f."driver_id"
WHERE  f."constructor_first" = l."constructor_last"
LIMIT 20;
```

```sql
-- Description: 8) Add a count of rounds to ensure each driver-season contains at least two distinct races
WITH rounds AS (
     SELECT ra."year",
            r."driver_id",
            COUNT(DISTINCT ra."round") AS "rounds_entered"
     FROM   "results" r
     JOIN   "races"   ra ON ra."race_id" = r."race_id"
     WHERE  ra."year" BETWEEN 1950 AND 1959
     GROUP  BY ra."year", r."driver_id"
),
matched AS (
     /* result of query 7 */
     SELECT f."year",
            f."driver_id"
     FROM (
          SELECT ra."year",
                 r."driver_id",
                 r."constructor_id" AS "constructor_first"
          FROM   "results" r
          JOIN   "races"   ra ON ra."race_id" = r."race_id"
          WHERE  ra."year" BETWEEN 1950 AND 1959
          GROUP  BY ra."year", r."driver_id"
          HAVING ra."round" = MIN(ra."round")
     ) f
     JOIN (
          SELECT ra."year",
                 r."driver_id",
                 r."constructor_id" AS "constructor_last"
          FROM   "results" r
          JOIN   "races"   ra ON ra."race_id" = r."race_id"
          WHERE  ra."year" BETWEEN 1950 AND 1959
          GROUP  BY ra."year", r."driver_id"
          HAVING ra."round" = MAX(ra."round")
     ) l ON l."year" = f."year" AND l."driver_id" = f."driver_id"
     WHERE f."constructor_first" = l."constructor_last"
)
SELECT m."year",
       m."driver_id",
       r."rounds_entered"
FROM   matched m
JOIN   rounds  r ON r."year" = m."year" AND r."driver_id" = m."driver_id"
WHERE  r."rounds_entered" >= 2
LIMIT 20;
```

```sql
-- Description: 9) Map driver_id to full driver names for the qualifying records
WITH qualified AS (
     /* query 8’s filtered driver-seasons */
     SELECT m."year",
            m."driver_id"
     FROM   (
        /* same CTE structure as query 8 to get matched driver-seasons */
        WITH firsts AS (
             SELECT ra."year",
                    r."driver_id",
                    r."constructor_id" AS "constructor_first",
                    MIN(ra."round") AS min_round
             FROM   "results" r
             JOIN   "races"   ra ON ra."race_id" = r."race_id"
             WHERE  ra."year" BETWEEN 1950 AND 1959
             GROUP  BY ra."year", r."driver_id"
        ),
        lasts AS (
             SELECT ra."year",
                    r."driver_id",
                    r."constructor_id" AS "constructor_last",
                    MAX(ra."round") AS max_round
             FROM   "results" r
             JOIN   "races"   ra ON ra."race_id" = r."race_id"
             WHERE  ra."year" BETWEEN 1950 AND 1959
             GROUP  BY ra."year", r."driver_id"
        ),
        rounds AS (
             SELECT ra."year",
                    r."driver_id",
                    COUNT(DISTINCT ra."round") AS rounds_entered
             FROM   "results" r
             JOIN   "races"   ra ON ra."race_id" = r."race_id"
             WHERE  ra."year" BETWEEN 1950 AND 1959
             GROUP  BY ra."year", r."driver_id"
        )
        SELECT f."year",
               f."driver_id"
        FROM   firsts f
        JOIN   lasts  l ON l."year" = f."year" AND l."driver_id" = f."driver_id"
        JOIN   rounds  r ON r."year" = f."year" AND r."driver_id" = f."driver_id"
        WHERE  f."constructor_first" = l."constructor_last"
          AND  r."rounds_entered"   >= 2
     ) AS m
)
SELECT q."year",
       d."forename" || ' ' || d."surname" AS "driver_name"
FROM   qualified q
JOIN   "drivers" d ON d."driver_id" = q."driver_id"
ORDER  BY q."year", "driver_name"
LIMIT 20;
```

```sql
-- Description: 10) FINAL answer – list DISTINCT drivers (full names) satisfying all conditions anywhere in the 1950s
WITH first_last_same AS (
     SELECT ra."year",
            r."driver_id",
            MIN(ra."round") AS first_round,
            MAX(ra."round") AS last_round,
            MIN(CASE WHEN ra."round" = (SELECT MIN(ra2."round")
                                        FROM "races" ra2
                                        WHERE ra2."year" = ra."year") THEN r."constructor_id" END) AS constructor_first,
            MIN(CASE WHEN ra."round" = (SELECT MAX(ra3."round")
                                        FROM "races" ra3
                                        WHERE ra3."year" = ra."year") THEN r."constructor_id" END) AS constructor_last,
            COUNT(DISTINCT ra."round") AS rounds_entered
     FROM   "results" r
     JOIN   "races"   ra ON ra."race_id" = r."race_id"
     WHERE  ra."year" BETWEEN 1950 AND 1959
     GROUP  BY ra."year", r."driver_id"
     HAVING constructor_first = constructor_last
        AND rounds_entered   >= 2
)
SELECT DISTINCT d."forename" || ' ' || d."surname" AS "driver_name"
FROM   first_last_same f
JOIN   "drivers" d ON d."driver_id" = f."driver_id"
ORDER  BY "driver_name";
```
