-- Description: 10) FINAL answer – list DISTINCT drivers (full names) satisfying all conditions anywhere in the 1950s
WITH first_last_same AS (
     SELECT ra."year",
            r."driver_id",
            MIN(ra."round") AS first_round,
            MAX(ra."round") AS last_round,
            MIN(CASE WHEN ra."round" = (SELECT MIN(ra2."round")
                                        FROM "races" ra2
                                        WHERE ra2."year" = ra."year") THEN r."constructor_id" END) AS constructor_first,
            MIN(CASE WHEN ra."round" = (SELECT MAX(ra3."round")
                                        FROM "races" ra3
                                        WHERE ra3."year" = ra."year") THEN r."constructor_id" END) AS constructor_last,
            COUNT(DISTINCT ra."round") AS rounds_entered
     FROM   "results" r
     JOIN   "races"   ra ON ra."race_id" = r."race_id"
     WHERE  ra."year" BETWEEN 1950 AND 1959
     GROUP  BY ra."year", r."driver_id"
     HAVING constructor_first = constructor_last
        AND rounds_entered   >= 2
)
SELECT DISTINCT d."forename" || ' ' || d."surname" AS "driver_name"
FROM   first_last_same f
JOIN   "drivers" d ON d."driver_id" = f."driver_id"
ORDER  BY "driver_name";
