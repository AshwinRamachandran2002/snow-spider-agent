Query:
-- Description: 7) Combine FIRST & LAST constructor per driver-season and retain those where they match
WITH firsts AS (
     SELECT ra."year",
            r."driver_id",
            r."constructor_id" AS "constructor_first"
     FROM   "results" r
     JOIN   "races"   ra ON ra."race_id" = r."race_id"
     WHERE  ra."year" BETWEEN 1950 AND 1959
     GROUP  BY ra."year", r."driver_id"
     HAVING ra."round" = MIN(ra."round")
),
lasts AS (
     SELECT ra."year",
            r."driver_id",
            r."constructor_id" AS "constructor_last"
     FROM   "results" r
     JOIN   "races"   ra ON ra."race_id" = r."race_id"
     WHERE  ra."year" BETWEEN 1950 AND 1959
     GROUP  BY ra."year", r."driver_id"
     HAVING ra."round" = MAX(ra."round")
)
SELECT f."year",
       f."driver_id",
       f."constructor_first"
FROM   firsts f
JOIN   lasts  l ON l."year" = f."year" AND l."driver_id" = f."driver_id"
WHERE  f."constructor_first" = l."constructor_last"
LIMIT 20;
