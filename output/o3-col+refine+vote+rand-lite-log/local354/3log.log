Query:
-- Description: 8) Add a count of rounds to ensure each driver-season contains at least two distinct races
WITH rounds AS (
     SELECT ra."year",
            r."driver_id",
            COUNT(DISTINCT ra."round") AS "rounds_entered"
     FROM   "results" r
     JOIN   "races"   ra ON ra."race_id" = r."race_id"
     WHERE  ra."year" BETWEEN 1950 AND 1959
     GROUP  BY ra."year", r."driver_id"
),
matched AS (
     /* result of query 7 */
     SELECT f."year",
            f."driver_id"
     FROM (
          SELECT ra."year",
                 r."driver_id",
                 r."constructor_id" AS "constructor_first"
          FROM   "results" r
          JOIN   "races"   ra ON ra."race_id" = r."race_id"
          WHERE  ra."year" BETWEEN 1950 AND 1959
          GROUP  BY ra."year", r."driver_id"
          HAVING ra."round" = MIN(ra."round")
     ) f
     JOIN (
          SELECT ra."year",
                 r."driver_id",
                 r."constructor_id" AS "constructor_last"
          FROM   "results" r
          JOIN   "races"   ra ON ra."race_id" = r."race_id"
          WHERE  ra."year" BETWEEN 1950 AND 1959
          GROUP  BY ra."year", r."driver_id"
          HAVING ra."round" = MAX(ra."round")
     ) l ON l."year" = f."year" AND l."driver_id" = f."driver_id"
     WHERE f."constructor_first" = l."constructor_last"
)
SELECT m."year",
       m."driver_id",
       r."rounds_entered"
FROM   matched m
JOIN   rounds  r ON r."year" = m."year" AND r."driver_id" = m."driver_id"
WHERE  r."rounds_entered" >= 2
LIMIT 20;
