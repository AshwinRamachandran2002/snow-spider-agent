-- Description: 6) Constructor used in the LAST race of each driver-season (≥2 rounds)
SELECT l."year",
       l."driver_id",
       r."constructor_id" AS "constructor_last"
FROM   (
        SELECT ra."year",
               r."driver_id",
               MAX(ra."round") AS "last_round"
        FROM   "results" r
        JOIN   "races"   ra ON ra."race_id" = r."race_id"
        WHERE  ra."year" BETWEEN 1950 AND 1959
        GROUP  BY ra."year", r."driver_id"
       ) AS l
JOIN  "races"   ra ON ra."year"  = l."year"  AND ra."round" = l."last_round"
JOIN  "results" r  ON r."race_id" = ra."race_id" AND r."driver_id" = l."driver_id"
LIMIT 20;
