Query:
--Description: Identify the constructor a driver used in the first race of each
--             eligible season.  
WITH first_races AS (
  SELECT res."driver_id",
         r."year",
         MIN(r."round") AS "first_round"
  FROM   "results" AS res
  JOIN   "races"   AS r ON r."race_id" = res."race_id"
  WHERE  r."year" BETWEEN 1950 AND 1959
  GROUP  BY res."driver_id", r."year"
)
SELECT fr."driver_id",
       fr."year",
       res."constructor_id" AS "first_constructor_id"
FROM   first_races AS fr
JOIN   "results"  AS res ON res."driver_id" = fr."driver_id"
JOIN   "races"    AS r   ON r."race_id" = res."race_id"
WHERE  r."year"  = fr."year"
  AND  r."round" = fr."first_round"
LIMIT 20;
