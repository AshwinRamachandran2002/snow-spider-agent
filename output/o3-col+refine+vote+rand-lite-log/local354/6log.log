```sql
--Description: List all seasons that fall inside the 1950-1959 decade.  
SELECT DISTINCT "year"
FROM "races"
WHERE "year" BETWEEN 1950 AND 1959
ORDER BY "year"
LIMIT 20;
```

```sql
--Description: Look at some race entries from the 1950s, showing year, round,
--             driver and constructor involved.  
SELECT DISTINCT r."year",
                r."round",
                res."driver_id",
                res."constructor_id"
FROM   "results"      AS res
JOIN   "races"        AS r   ON r."race_id" = res."race_id"
WHERE  r."year" BETWEEN 1950 AND 1959
LIMIT 20;
```

```sql
--Description: Quick reference list of driver IDs with their names.  
SELECT DISTINCT "driver_id",
                "forename",
                "surname"
FROM   "drivers"
LIMIT 20;
```

```sql
--Description: For every driver-season in the 1950s, count how many different
--             rounds the driver actually started; keep only those with ≥2.  
SELECT   res."driver_id",
         r."year",
         COUNT(DISTINCT r."round") AS "race_count"
FROM     "results" AS res
JOIN     "races"   AS r ON r."race_id" = res."race_id"
WHERE    r."year" BETWEEN 1950 AND 1959
GROUP BY res."driver_id", r."year"
HAVING   "race_count" >= 2
LIMIT 20;
```

```sql
--Description: For those driver-seasons (with ≥2 races) find the first and last
--             rounds in which each driver appeared.  
WITH eligible AS (
  SELECT res."driver_id", r."year"
  FROM   "results" AS res
  JOIN   "races"   AS r ON r."race_id" = res."race_id"
  WHERE  r."year" BETWEEN 1950 AND 1959
  GROUP  BY res."driver_id", r."year"
  HAVING COUNT(DISTINCT r."round") >= 2
)
SELECT   e."driver_id",
         e."year",
         MIN(r."round") AS "first_round",
         MAX(r."round") AS "last_round"
FROM     eligible  AS e
JOIN     "results" AS res ON res."driver_id" = e."driver_id"
JOIN     "races"   AS r   ON r."race_id" = res."race_id"
           AND r."year" = e."year"
GROUP BY e."driver_id", e."year"
LIMIT 20;
```

```sql
--Description: Identify the constructor a driver used in the first race of each
--             eligible season.  
WITH first_races AS (
  SELECT res."driver_id",
         r."year",
         MIN(r."round") AS "first_round"
  FROM   "results" AS res
  JOIN   "races"   AS r ON r."race_id" = res."race_id"
  WHERE  r."year" BETWEEN 1950 AND 1959
  GROUP  BY res."driver_id", r."year"
)
SELECT fr."driver_id",
       fr."year",
       res."constructor_id" AS "first_constructor_id"
FROM   first_races AS fr
JOIN   "results"  AS res ON res."driver_id" = fr."driver_id"
JOIN   "races"    AS r   ON r."race_id" = res."race_id"
WHERE  r."year"  = fr."year"
  AND  r."round" = fr."first_round"
LIMIT 20;
```

```sql
--Description: Identify the constructor a driver used in the last race of each
--             eligible season.  
WITH last_races AS (
  SELECT res."driver_id",
         r."year",
         MAX(r."round") AS "last_round"
  FROM   "results" AS res
  JOIN   "races"   AS r ON r."race_id" = res."race_id"
  WHERE  r."year" BETWEEN 1950 AND 1959
  GROUP  BY res."driver_id", r."year"
)
SELECT lr."driver_id",
       lr."year",
       res."constructor_id" AS "last_constructor_id"
FROM   last_races AS lr
JOIN   "results"  AS res ON res."driver_id" = lr."driver_id"
JOIN   "races"    AS r   ON r."race_id" = res."race_id"
WHERE  r."year"  = lr."year"
  AND  r."round" = lr."last_round"
LIMIT 20;
```

```sql
--Description: Combine first- and last-constructor info and keep those seasons
--             where they are identical (still need ≥2 rounds).  
WITH races_1950s AS (
  SELECT res."driver_id",
         r."year",
         r."round",
         res."constructor_id"
  FROM   "results" AS res
  JOIN   "races"   AS r ON r."race_id" = res."race_id"
  WHERE  r."year" BETWEEN 1950 AND 1959
),
counts AS (                       -- driver-seasons with ≥2 rounds
  SELECT "driver_id", "year"
  FROM   races_1950s
  GROUP  BY "driver_id", "year"
  HAVING COUNT(DISTINCT "round") >= 2
),
first_last AS (
  SELECT c."driver_id",
         c."year",
         (SELECT "constructor_id"
          FROM   races_1950s rf
          WHERE  rf."driver_id" = c."driver_id"
            AND  rf."year"      = c."year"
          ORDER  BY rf."round" ASC
          LIMIT 1) AS "first_constructor",
         (SELECT "constructor_id"
          FROM   races_1950s rl
          WHERE  rl."driver_id" = c."driver_id"
            AND  rl."year"      = c."year"
          ORDER  BY rl."round" DESC
          LIMIT 1) AS "last_constructor"
  FROM   counts c
)
SELECT *
FROM   first_last
WHERE  "first_constructor" = "last_constructor"
LIMIT 20;
```

```sql
--Description: Extract the unique driver IDs who meet the condition in at least
--             one 1950s season.  
WITH races_1950s AS (
  SELECT res."driver_id",
         r."year",
         r."round",
         res."constructor_id"
  FROM   "results" AS res
  JOIN   "races"   AS r ON r."race_id" = res."race_id"
  WHERE  r."year" BETWEEN 1950 AND 1959
),
counts AS (
  SELECT "driver_id", "year"
  FROM   races_1950s
  GROUP  BY "driver_id", "year"
  HAVING COUNT(DISTINCT "round") >= 2
),
first_last AS (
  SELECT c."driver_id",
         c."year",
         (SELECT "constructor_id"
          FROM   races_1950s rf
          WHERE  rf."driver_id" = c."driver_id"
            AND  rf."year"      = c."year"
          ORDER  BY rf."round" ASC
          LIMIT 1) AS "first_constructor",
         (SELECT "constructor_id"
          FROM   races_1950s rl
          WHERE  rl."driver_id" = c."driver_id"
            AND  rl."year"      = c."year"
          ORDER  BY rl."round" DESC
          LIMIT 1) AS "last_constructor"
  FROM   counts c
)
SELECT DISTINCT "driver_id"
FROM   first_last
WHERE  "first_constructor" = "last_constructor"
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – list the full names of drivers who, in at least
--             one 1950-1959 season, started ≥2 rounds *and* used the same
--             constructor in their first and last appearance of that season.  
WITH races_1950s AS (
  SELECT res."driver_id",
         r."year",
         r."round",
         res."constructor_id"
  FROM   "results" AS res
  JOIN   "races"   AS r ON r."race_id" = res."race_id"
  WHERE  r."year" BETWEEN 1950 AND 1959
),
counts AS (
  SELECT "driver_id", "year"
  FROM   races_1950s
  GROUP  BY "driver_id", "year"
  HAVING COUNT(DISTINCT "round") >= 2
),
first_last AS (
  SELECT c."driver_id",
         c."year",
         (SELECT "constructor_id"
          FROM   races_1950s rf
          WHERE  rf."driver_id" = c."driver_id"
            AND  rf."year"      = c."year"
          ORDER  BY rf."round" ASC
          LIMIT 1) AS "first_constructor",
         (SELECT "constructor_id"
          FROM   races_1950s rl
          WHERE  rl."driver_id" = c."driver_id"
            AND  rl."year"      = c."year"
          ORDER  BY rl."round" DESC
          LIMIT 1) AS "last_constructor"
  FROM   counts c
)
SELECT DISTINCT d."forename" || ' ' || d."surname" AS "driver_name"
FROM   "drivers"  AS d
JOIN   first_last AS fl ON fl."driver_id" = d."driver_id"
WHERE  fl."first_constructor" = fl."last_constructor"
LIMIT 20;
```
