Query:
--Description: For those driver-seasons (with ≥2 races) find the first and last
--             rounds in which each driver appeared.  
WITH eligible AS (
  SELECT res."driver_id", r."year"
  FROM   "results" AS res
  JOIN   "races"   AS r ON r."race_id" = res."race_id"
  WHERE  r."year" BETWEEN 1950 AND 1959
  GROUP  BY res."driver_id", r."year"
  HAVING COUNT(DISTINCT r."round") >= 2
)
SELECT   e."driver_id",
         e."year",
         MIN(r."round") AS "first_round",
         MAX(r."round") AS "last_round"
FROM     eligible  AS e
JOIN     "results" AS res ON res."driver_id" = e."driver_id"
JOIN     "races"   AS r   ON r."race_id" = res."race_id"
           AND r."year" = e."year"
GROUP BY e."driver_id", e."year"
LIMIT 20;
