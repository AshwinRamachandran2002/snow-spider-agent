```sql
-- Description: List all race rounds that took place in the 1950-1959 decade
SELECT DISTINCT "year", "round", "race_id", "name"
FROM "races"
WHERE "year" BETWEEN 1950 AND 1959
ORDER BY "year", "round"
LIMIT 20;
```

```sql
-- Description: Preview a few result rows from the 1950 season (join with race metadata)
SELECT r."year", r."round", res."driver_id", res."constructor_id", res."position"
FROM "results"  AS res
JOIN "races"    AS r  ON r."race_id" = res."race_id"
WHERE r."year" = 1950
ORDER BY r."round", res."driver_id"
LIMIT 20;
```

```sql
-- Description: Count how many different rounds each driver entered per season (1950s only)
SELECT r."year",
       res."driver_id",
       COUNT(DISTINCT r."round") AS "rounds_entered"
FROM   "results" AS res
JOIN   "races"   AS r ON r."race_id" = res."race_id"
WHERE  r."year" BETWEEN 1950 AND 1959
GROUP  BY r."year", res."driver_id"
HAVING COUNT(DISTINCT r."round") >= 2
LIMIT 20;
```

```sql
-- Description: For every driver-season (1950s, ≥2 rounds) pick the first race they started
SELECT a."year",
       a."driver_id",
       res."constructor_id" AS "first_constructor_id"
FROM (
      SELECT r."year",
             res."driver_id",
             MIN(r."round") AS "first_round"
      FROM   "results" AS res
      JOIN   "races"   AS r ON r."race_id" = res."race_id"
      WHERE  r."year" BETWEEN 1950 AND 1959
      GROUP  BY r."year", res."driver_id"
      HAVING COUNT(DISTINCT r."round") >= 2
     ) AS a
JOIN "results" AS res  ON res."driver_id" = a."driver_id"
JOIN "races"   AS r    ON r."race_id"   = res."race_id"
                       AND r."year"     = a."year"
                       AND r."round"    = a."first_round"
LIMIT 20;
```

```sql
-- Description: For every driver-season (1950s, ≥2 rounds) pick the last race they started
SELECT b."year",
       b."driver_id",
       res."constructor_id" AS "last_constructor_id"
FROM (
      SELECT r."year",
             res."driver_id",
             MAX(r."round") AS "last_round"
      FROM   "results" AS res
      JOIN   "races"   AS r ON r."race_id" = res."race_id"
      WHERE  r."year" BETWEEN 1950 AND 1959
      GROUP  BY r."year", res."driver_id"
      HAVING COUNT(DISTINCT r."round") >= 2
     ) AS b
JOIN "results" AS res  ON res."driver_id" = b."driver_id"
JOIN "races"   AS r    ON r."race_id"   = res."race_id"
                       AND r."year"     = b."year"
                       AND r."round"    = b."last_round"
LIMIT 20;
```

```sql
-- Description: Combine first & last constructor per driver-season and keep those that match
WITH first_last AS (
     SELECT fl."year",
            fl."driver_id",
            fl."first_constructor_id",
            ll."last_constructor_id"
     FROM (                                 -- first constructor
           SELECT a."year", a."driver_id", res."constructor_id" AS "first_constructor_id"
           FROM (
                 SELECT r."year", res."driver_id", MIN(r."round") AS "first_round"
                 FROM "results" AS res
                 JOIN "races"  AS r ON r."race_id" = res."race_id"
                 WHERE r."year" BETWEEN 1950 AND 1959
                 GROUP BY r."year", res."driver_id"
                 HAVING COUNT(DISTINCT r."round") >= 2
                ) a
           JOIN "results" AS res ON res."driver_id" = a."driver_id"
           JOIN "races"   AS r   ON r."race_id" = res."race_id"
                                AND r."year"   = a."year"
                                AND r."round"  = a."first_round"
          ) fl
     JOIN (                                 -- last constructor
           SELECT b."year", b."driver_id", res."constructor_id" AS "last_constructor_id"
           FROM (
                 SELECT r."year", res."driver_id", MAX(r."round") AS "last_round"
                 FROM "results" AS res
                 JOIN "races"  AS r ON r."race_id" = res."race_id"
                 WHERE r."year" BETWEEN 1950 AND 1959
                 GROUP BY r."year", res."driver_id"
                 HAVING COUNT(DISTINCT r."round") >= 2
                ) b
           JOIN "results" AS res ON res."driver_id" = b."driver_id"
           JOIN "races"   AS r   ON r."race_id" = res."race_id"
                                AND r."year"   = b."year"
                                AND r."round"  = b."last_round"
          ) ll
       ON fl."year" = ll."year" AND fl."driver_id" = ll."driver_id"
     WHERE fl."first_constructor_id" = ll."last_constructor_id"
)
SELECT * FROM first_last
LIMIT 20;
```

```sql
-- Description: Translate the driver_ids that satisfied the rule into human-readable names
SELECT DISTINCT fl."year",
       d."forename" || ' ' || d."surname" AS "driver_name"
FROM (
      -- the CTE created in the previous query, repeated here
      WITH first_last AS (
           SELECT fl."year",
                  fl."driver_id",
                  fl."first_constructor_id",
                  ll."last_constructor_id"
           FROM (
                 SELECT a."year", a."driver_id", res."constructor_id" AS "first_constructor_id"
                 FROM (
                       SELECT r."year", res."driver_id", MIN(r."round") AS "first_round"
                       FROM "results" AS res
                       JOIN "races"  AS r ON r."race_id" = res."race_id"
                       WHERE r."year" BETWEEN 1950 AND 1959
                       GROUP BY r."year", res."driver_id"
                       HAVING COUNT(DISTINCT r."round") >= 2
                      ) a
                 JOIN "results" AS res ON res."driver_id" = a."driver_id"
                 JOIN "races"   AS r   ON r."race_id" = res."race_id"
                                      AND r."year"   = a."year"
                                      AND r."round"  = a."first_round"
                ) fl
           JOIN (
                 SELECT b."year", b."driver_id", res."constructor_id" AS "last_constructor_id"
                 FROM (
                       SELECT r."year", res."driver_id", MAX(r."round") AS "last_round"
                       FROM "results" AS res
                       JOIN "races"  AS r ON r."race_id" = res."race_id"
                       WHERE r."year" BETWEEN 1950 AND 1959
                       GROUP BY r."year", res."driver_id"
                       HAVING COUNT(DISTINCT r."round") >= 2
                      ) b
                 JOIN "results" AS res ON res."driver_id" = b."driver_id"
                 JOIN "races"   AS r   ON r."race_id" = res."race_id"
                                      AND r."year"   = b."year"
                                      AND r."round"  = b."last_round"
                ) ll
            ON fl."year" = ll."year" AND fl."driver_id" = ll."driver_id"
           WHERE fl."first_constructor_id" = ll."last_constructor_id"
      )
      SELECT * FROM first_last
     ) AS fl
JOIN "drivers" AS d ON d."driver_id" = fl."driver_id"
LIMIT 20;
```

```sql
-- Description: Show each qualifying driver, the season, and the shared constructor name
SELECT DISTINCT fl."year",
       d."forename" || ' ' || d."surname"             AS "driver_name",
       c."name"                                       AS "constructor_name"
FROM (
      -- same first_last CTE as above
      WITH first_last AS (
           SELECT fl."year",
                  fl."driver_id",
                  fl."first_constructor_id",
                  ll."last_constructor_id"
           FROM (
                 SELECT a."year", a."driver_id", res."constructor_id" AS "first_constructor_id"
                 FROM (
                       SELECT r."year", res."driver_id", MIN(r."round") AS "first_round"
                       FROM "results" AS res
                       JOIN "races"  AS r ON r."race_id" = res."race_id"
                       WHERE r."year" BETWEEN 1950 AND 1959
                       GROUP BY r."year", res."driver_id"
                       HAVING COUNT(DISTINCT r."round") >= 2
                      ) a
                 JOIN "results" AS res ON res."driver_id" = a."driver_id"
                 JOIN "races"   AS r   ON r."race_id" = res."race_id"
                                      AND r."year"   = a."year"
                                      AND r."round"  = a."first_round"
                ) fl
           JOIN (
                 SELECT b."year", b."driver_id", res."constructor_id" AS "last_constructor_id"
                 FROM (
                       SELECT r."year", res."driver_id", MAX(r."round") AS "last_round"
                       FROM "results" AS res
                       JOIN "races"  AS r ON r."race_id" = res."race_id"
                       WHERE r."year" BETWEEN 1950 AND 1959
                       GROUP BY r."year", res."driver_id"
                       HAVING COUNT(DISTINCT r."round") >= 2
                      ) b
                 JOIN "results" AS res ON res."driver_id" = b."driver_id"
                 JOIN "races"   AS r   ON r."race_id" = res."race_id"
                                      AND r."year"   = b."year"
                                      AND r."round"  = b."last_round"
                ) ll
            ON fl."year" = ll."year" AND fl."driver_id" = ll."driver_id"
           WHERE fl."first_constructor_id" = ll."last_constructor_id"
      )
      SELECT * FROM first_last
     ) AS fl
JOIN "drivers"     AS d ON d."driver_id"      = fl."driver_id"
JOIN "constructors" AS c ON c."constructor_id" = fl."first_constructor_id"
ORDER BY fl."year", d."surname"
LIMIT 20;
```

```sql
-- Description: Final concise answer – all drivers (unique names) meeting the condition
SELECT DISTINCT d."forename" || ' ' || d."surname" AS "driver_name"
FROM (
      WITH first_last AS (
           SELECT fl."year",
                  fl."driver_id",
                  fl."first_constructor_id",
                  ll."last_constructor_id"
           FROM (
                 SELECT a."year", a."driver_id", res."constructor_id" AS "first_constructor_id"
                 FROM (
                       SELECT r."year", res."driver_id", MIN(r."round") AS "first_round"
                       FROM "results" AS res
                       JOIN "races"  AS r ON r."race_id" = res."race_id"
                       WHERE r."year" BETWEEN 1950 AND 1959
                       GROUP BY r."year", res."driver_id"
                       HAVING COUNT(DISTINCT r."round") >= 2
                      ) a
                 JOIN "results" AS res ON res."driver_id" = a."driver_id"
                 JOIN "races"   AS r   ON r."race_id" = res."race_id"
                                      AND r."year"   = a."year"
                                      AND r."round"  = a."first_round"
                ) fl
           JOIN (
                 SELECT b."year", b."driver_id", res."constructor_id" AS "last_constructor_id"
                 FROM (
                       SELECT r."year", res."driver_id", MAX(r."round") AS "last_round"
                       FROM "results" AS res
                       JOIN "races"  AS r ON r."race_id" = res."race_id"
                       WHERE r."year" BETWEEN 1950 AND 1959
                       GROUP BY r."year", res."driver_id"
                       HAVING COUNT(DISTINCT r."round") >= 2
                      ) b
                 JOIN "results" AS res ON res."driver_id" = b."driver_id"
                 JOIN "races"   AS r   ON r."race_id" = res."race_id"
                                      AND r."year"   = b."year"
                                      AND r."round"  = b."last_round"
                ) ll
            ON fl."year" = ll."year" AND fl."driver_id" = ll."driver_id"
           WHERE fl."first_constructor_id" = ll."last_constructor_id"
      )
      SELECT * FROM first_last
     ) AS fl
JOIN "drivers" AS d ON d."driver_id" = fl."driver_id"
ORDER BY "driver_name"
LIMIT 20;
