-- 9. FINAL ANSWER: list the drivers (with their name) who meet all the criteria
WITH driver_year_rounds AS (
  SELECT r."driver_id", ra."year", ra."round", r."constructor_id"
  FROM "results" r
  JOIN "races"  ra ON ra."race_id" = r."race_id"
  WHERE ra."year" BETWEEN 1950 AND 1959
),
first_last AS (
  SELECT dyr."driver_id", dyr."year",
         MIN(dyr."round") AS "first_round",
         MAX(dyr."round") AS "last_round",
         COUNT(DISTINCT dyr."round") AS "rounds_entered"
  FROM driver_year_rounds  dyr
  GROUP BY dyr."driver_id", dyr."year"
  HAVING "rounds_entered" >= 2
),
first_const AS (
  SELECT fl."driver_id", fl."year", dyr."constructor_id" AS "first_constructor"
  FROM first_last fl
  JOIN driver_year_rounds dyr
    ON dyr."driver_id" = fl."driver_id"
   AND dyr."year"      = fl."year"
   AND dyr."round"     = fl."first_round"
),
last_const AS (
  SELECT fl."driver_id", fl."year", dyr."constructor_id" AS "last_constructor"
  FROM first_last fl
  JOIN driver_year_rounds dyr
    ON dyr."driver_id" = fl."driver_id"
   AND dyr."year"      = fl."year"
   AND dyr."round"     = fl."last_round"
),
qualified AS (
  SELECT fc."driver_id", fc."year"
  FROM first_const fc
  JOIN last_const  lc
    ON lc."driver_id" = fc."driver_id" AND lc."year" = fc."year"
  WHERE fc."first_constructor" = lc."last_constructor"
)
SELECT DISTINCT
       d."forename" || ' ' || d."surname" AS "driver_name",
       q."year"                          AS "season"
FROM qualified q
JOIN "drivers" d ON d."driver_id" = q."driver_id"
ORDER BY "driver_name", "season"
