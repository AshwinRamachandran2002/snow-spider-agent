```sql
-- 1. Inspect races that happened in the 1950s (seasons 1950-1959)
SELECT "race_id", "year", "round", "name"
FROM "races"
WHERE "year" BETWEEN 1950 AND 1959
ORDER BY "year", "round"
LIMIT 20;
```

```sql
-- 2. Look at some results from the very first season (1950)
SELECT r."result_id", ra."year", ra."round",
       r."driver_id", r."constructor_id", r."position"
FROM "results" AS r
JOIN "races"  AS ra ON ra."race_id" = r."race_id"
WHERE ra."year" = 1950
LIMIT 20;
```

```sql
-- 3. List all distinct drivers who raced at least once in the 1950s
SELECT DISTINCT r."driver_id"
FROM "results"  AS r
JOIN "races"    AS ra ON ra."race_id" = r."race_id"
WHERE ra."year" BETWEEN 1950 AND 1959
LIMIT 20;
```

```sql
-- 4. Attach driver names to the previous list
SELECT DISTINCT d."driver_id",
       d."forename" || ' ' || d."surname" AS "driver_name"
FROM "drivers" AS d
JOIN (
       SELECT DISTINCT r."driver_id"
       FROM "results" AS r
       JOIN "races"  AS ra ON ra."race_id" = r."race_id"
       WHERE ra."year" BETWEEN 1950 AND 1959
     ) AS x ON x."driver_id" = d."driver_id"
LIMIT 20;
```

```sql
-- 5. For every driver-season in the 1950s, count how many race rounds they entered
SELECT ra."year", r."driver_id",
       COUNT(DISTINCT ra."round") AS "rounds_entered"
FROM "results" AS r
JOIN "races"  AS ra ON ra."race_id" = r."race_id"
WHERE ra."year" BETWEEN 1950 AND 1959
GROUP BY ra."year", r."driver_id"
HAVING "rounds_entered" >= 2
LIMIT 20;
```

```sql
-- 6. Find the first and last round (within a season) each of those driver-season pairs took part in
WITH driver_year_rounds AS (
  SELECT r."driver_id", ra."year", ra."round", r."constructor_id"
  FROM "results" r
  JOIN "races"  ra ON ra."race_id" = r."race_id"
  WHERE ra."year" BETWEEN 1950 AND 1959
)
SELECT "driver_id", "year",
       MIN("round") AS "first_round",
       MAX("round") AS "last_round",
       COUNT(DISTINCT "round") AS "rounds_entered"
FROM driver_year_rounds
GROUP BY "driver_id", "year"
HAVING "rounds_entered" >= 2
LIMIT 20;
```

```sql
-- 7. Attach the constructor used in the driver’s first and last race of that season
WITH driver_year_rounds AS (
  SELECT r."driver_id", ra."year", ra."round", r."constructor_id"
  FROM "results" r
  JOIN "races"  ra ON ra."race_id" = r."race_id"
  WHERE ra."year" BETWEEN 1950 AND 1959
),
first_last AS (
  SELECT dyr."driver_id", dyr."year",
         MIN(dyr."round") AS "first_round",
         MAX(dyr."round") AS "last_round",
         COUNT(DISTINCT dyr."round") AS "rounds_entered"
  FROM driver_year_rounds  dyr
  GROUP BY dyr."driver_id", dyr."year"
  HAVING "rounds_entered" >= 2
)
SELECT fl."driver_id", fl."year",
       fc."constructor_id" AS "first_constructor",
       lc."constructor_id" AS "last_constructor"
FROM  first_last  fl
JOIN driver_year_rounds AS fc
     ON fc."driver_id" = fl."driver_id"
    AND fc."year"      = fl."year"
    AND fc."round"     = fl."first_round"
JOIN driver_year_rounds AS lc
     ON lc."driver_id" = fl."driver_id"
    AND lc."year"      = fl."year"
    AND lc."round"     = fl."last_round"
LIMIT 20;
```

```sql
-- 8. From the previous result, keep only the driver-seasons where the constructor is the same in the first and last race
WITH driver_year_rounds AS (
  SELECT r."driver_id", ra."year", ra."round", r."constructor_id"
  FROM "results" r
  JOIN "races"  ra ON ra."race_id" = r."race_id"
  WHERE ra."year" BETWEEN 1950 AND 1959
),
first_last AS (
  SELECT dyr."driver_id", dyr."year",
         MIN(dyr."round") AS "first_round",
         MAX(dyr."round") AS "last_round",
         COUNT(DISTINCT dyr."round") AS "rounds_entered"
  FROM driver_year_rounds  dyr
  GROUP BY dyr."driver_id", dyr."year"
  HAVING "rounds_entered" >= 2
),
first_const AS (
  SELECT fl."driver_id", fl."year", dyr."constructor_id" AS "first_constructor"
  FROM first_last fl
  JOIN driver_year_rounds dyr
    ON dyr."driver_id" = fl."driver_id"
   AND dyr."year"      = fl."year"
   AND dyr."round"     = fl."first_round"
),
last_const AS (
  SELECT fl."driver_id", fl."year", dyr."constructor_id" AS "last_constructor"
  FROM first_last fl
  JOIN driver_year_rounds dyr
    ON dyr."driver_id" = fl."driver_id"
   AND dyr."year"      = fl."year"
   AND dyr."round"     = fl."last_round"
),
qualified AS (
  SELECT fc."driver_id", fc."year"
  FROM first_const fc
  JOIN last_const  lc
    ON lc."driver_id" = fc."driver_id" AND lc."year" = fc."year"
  WHERE fc."first_constructor" = lc."last_constructor"
)
SELECT q.*
FROM qualified q
LIMIT 20;
```

```sql
-- 9. FINAL ANSWER: list the drivers (with their name) who meet all the criteria
WITH driver_year_rounds AS (
  SELECT r."driver_id", ra."year", ra."round", r."constructor_id"
  FROM "results" r
  JOIN "races"  ra ON ra."race_id" = r."race_id"
  WHERE ra."year" BETWEEN 1950 AND 1959
),
first_last AS (
  SELECT dyr."driver_id", dyr."year",
         MIN(dyr."round") AS "first_round",
         MAX(dyr."round") AS "last_round",
         COUNT(DISTINCT dyr."round") AS "rounds_entered"
  FROM driver_year_rounds  dyr
  GROUP BY dyr."driver_id", dyr."year"
  HAVING "rounds_entered" >= 2
),
first_const AS (
  SELECT fl."driver_id", fl."year", dyr."constructor_id" AS "first_constructor"
  FROM first_last fl
  JOIN driver_year_rounds dyr
    ON dyr."driver_id" = fl."driver_id"
   AND dyr."year"      = fl."year"
   AND dyr."round"     = fl."first_round"
),
last_const AS (
  SELECT fl."driver_id", fl."year", dyr."constructor_id" AS "last_constructor"
  FROM first_last fl
  JOIN driver_year_rounds dyr
    ON dyr."driver_id" = fl."driver_id"
   AND dyr."year"      = fl."year"
   AND dyr."round"     = fl."last_round"
),
qualified AS (
  SELECT fc."driver_id", fc."year"
  FROM first_const fc
  JOIN last_const  lc
    ON lc."driver_id" = fc."driver_id" AND lc."year" = fc."year"
  WHERE fc."first_constructor" = lc."last_constructor"
)
SELECT DISTINCT
       d."forename" || ' ' || d."surname" AS "driver_name",
       q."year"                          AS "season"
FROM qualified q
JOIN "drivers" d ON d."driver_id" = q."driver_id"
ORDER BY "driver_name", "season"
LIMIT 20;
```
