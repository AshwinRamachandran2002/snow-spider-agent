Query:
--Description: ⑧  Add the full driver names to the filtered list obtained above.
WITH driver_season AS (
     SELECT r."driver_id",
            ra."year",
            MIN(ra."round")            AS "first_round",
            MAX(ra."round")            AS "last_round",
            COUNT(DISTINCT ra."round") AS "race_count"
     FROM   "results" r
     JOIN   "races"   ra ON ra."race_id" = r."race_id"
     WHERE  ra."year" BETWEEN 1950 AND 1959
     GROUP  BY r."driver_id", ra."year"
),
first_last AS (
     SELECT ds.*,
            (SELECT r2."constructor_id"
             FROM   "results" r2
             JOIN   "races"  ra2 ON ra2."race_id" = r2."race_id"
             WHERE  r2."driver_id" = ds."driver_id"
               AND  ra2."year"     = ds."year"
               AND  ra2."round"    = ds."first_round"
             LIMIT 1)              AS "first_constructor",
            (SELECT r3."constructor_id"
             FROM   "results" r3
             JOIN   "races"  ra3 ON ra3."race_id" = r3."race_id"
             WHERE  r3."driver_id" = ds."driver_id"
               AND  ra3."year"     = ds."year"
               AND  ra3."round"    = ds."last_round"
             LIMIT 1)              AS "last_constructor"
     FROM driver_season ds
),
final_list AS (
     SELECT fl."driver_id",
            fl."year"
     FROM   first_last fl
     WHERE  fl."first_constructor" = fl."last_constructor"
       AND  fl."race_count" >= 2
)
SELECT DISTINCT d."forename" || ' ' || d."surname" AS "driver_name",
                f."year"
FROM   final_list f
JOIN   "drivers" d ON d."driver_id" = f."driver_id"
ORDER  BY f."year", "driver_name"
LIMIT 20;
