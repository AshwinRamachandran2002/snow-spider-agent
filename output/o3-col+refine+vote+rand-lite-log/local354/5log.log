```sql
--Description: ①  Look at Grand Prix events held in the 1950-1959 time-span to confirm the seasons and see the round numbers.
SELECT "race_id",
       "year",
       "round",
       "name"
FROM   "races"
WHERE  "year" BETWEEN 1950 AND 1959
LIMIT 20;
```

```sql
--Description: ②  Examine some race-results from the very first season (1950) – we need the driver- and constructor-IDs that appear.
SELECT r."result_id",
       r."race_id",
       ra."year",
       ra."round",
       r."driver_id",
       r."constructor_id"
FROM   "results" r
JOIN   "races"   ra ON ra."race_id" = r."race_id"
WHERE  ra."year" = 1950
LIMIT 20;
```

```sql
--Description: ③  Pull the distinct driver IDs that took part in at least one race in the 1950s.
SELECT DISTINCT r."driver_id"
FROM   "results" r
JOIN   "races"   ra ON ra."race_id" = r."race_id"
WHERE  ra."year" BETWEEN 1950 AND 1959
LIMIT 20;
```

```sql
--Description: ④  Attach names to a few of those drivers to make the IDs human-readable.
SELECT DISTINCT d."driver_id",
       d."forename" || ' ' || d."surname" AS "driver_name"
FROM   "drivers" d
WHERE  d."driver_id" IN (
       SELECT r."driver_id"
       FROM   "results" r
       JOIN   "races" ra ON ra."race_id" = r."race_id"
       WHERE  ra."year" BETWEEN 1950 AND 1959)
LIMIT 20;
```

```sql
--Description: ⑤  Count how many different rounds each driver entered per season in the 1950s.
SELECT r."driver_id",
       ra."year",
       COUNT(DISTINCT ra."round") AS "race_count"
FROM   "results" r
JOIN   "races"  ra ON ra."race_id" = r."race_id"
WHERE  ra."year" BETWEEN 1950 AND 1959
GROUP  BY r."driver_id", ra."year"
LIMIT 20;
```

```sql
--Description: ⑥  For a sample of driver-seasons, compare the constructor in the first and last race they ran that year.
SELECT ds."driver_id",
       ds."year",
       (SELECT r2."constructor_id"
        FROM   "results" r2
        JOIN   "races"  ra2 ON ra2."race_id" = r2."race_id"
        WHERE  r2."driver_id" = ds."driver_id"
          AND  ra2."year"     = ds."year"
        ORDER  BY ra2."round"
        LIMIT 1)                       AS "first_constructor",
       (SELECT r3."constructor_id"
        FROM   "results" r3
        JOIN   "races"  ra3 ON ra3."race_id" = r3."race_id"
        WHERE  r3."driver_id" = ds."driver_id"
          AND  ra3."year"     = ds."year"
        ORDER  BY ra3."round" DESC
        LIMIT 1)                       AS "last_constructor"
FROM  (
       SELECT r."driver_id", ra."year"
       FROM   "results" r
       JOIN   "races"   ra ON ra."race_id" = r."race_id"
       WHERE  ra."year" BETWEEN 1950 AND 1959
       GROUP  BY r."driver_id", ra."year"
      ) ds
LIMIT 20;
```

```sql
--Description: ⑦  Find every driver-season in the 1950s whose first and last constructor IDs are identical and who raced twice or more that year.
WITH driver_season AS (
     SELECT r."driver_id",
            ra."year",
            MIN(ra."round")                  AS "first_round",
            MAX(ra."round")                  AS "last_round",
            COUNT(DISTINCT ra."round")       AS "race_count"
     FROM   "results" r
     JOIN   "races"   ra ON ra."race_id" = r."race_id"
     WHERE  ra."year" BETWEEN 1950 AND 1959
     GROUP  BY r."driver_id", ra."year"
),
first_last AS (
     SELECT ds.*,
            (SELECT r2."constructor_id"
             FROM   "results" r2
             JOIN   "races"  ra2 ON ra2."race_id" = r2."race_id"
             WHERE  r2."driver_id" = ds."driver_id"
               AND  ra2."year"     = ds."year"
               AND  ra2."round"    = ds."first_round"
             LIMIT 1)              AS "first_constructor",
            (SELECT r3."constructor_id"
             FROM   "results" r3
             JOIN   "races"  ra3 ON ra3."race_id" = r3."race_id"
             WHERE  r3."driver_id" = ds."driver_id"
               AND  ra3."year"     = ds."year"
               AND  ra3."round"    = ds."last_round"
             LIMIT 1)              AS "last_constructor"
     FROM driver_season ds
)
SELECT fl."driver_id",
       fl."year"
FROM   first_last fl
WHERE  fl."first_constructor" = fl."last_constructor"
  AND  fl."race_count" >= 2
LIMIT 20;
```

```sql
--Description: ⑧  Add the full driver names to the filtered list obtained above.
WITH driver_season AS (
     SELECT r."driver_id",
            ra."year",
            MIN(ra."round")            AS "first_round",
            MAX(ra."round")            AS "last_round",
            COUNT(DISTINCT ra."round") AS "race_count"
     FROM   "results" r
     JOIN   "races"   ra ON ra."race_id" = r."race_id"
     WHERE  ra."year" BETWEEN 1950 AND 1959
     GROUP  BY r."driver_id", ra."year"
),
first_last AS (
     SELECT ds.*,
            (SELECT r2."constructor_id"
             FROM   "results" r2
             JOIN   "races"  ra2 ON ra2."race_id" = r2."race_id"
             WHERE  r2."driver_id" = ds."driver_id"
               AND  ra2."year"     = ds."year"
               AND  ra2."round"    = ds."first_round"
             LIMIT 1)              AS "first_constructor",
            (SELECT r3."constructor_id"
             FROM   "results" r3
             JOIN   "races"  ra3 ON ra3."race_id" = r3."race_id"
             WHERE  r3."driver_id" = ds."driver_id"
               AND  ra3."year"     = ds."year"
               AND  ra3."round"    = ds."last_round"
             LIMIT 1)              AS "last_constructor"
     FROM driver_season ds
),
final_list AS (
     SELECT fl."driver_id",
            fl."year"
     FROM   first_last fl
     WHERE  fl."first_constructor" = fl."last_constructor"
       AND  fl."race_count" >= 2
)
SELECT DISTINCT d."forename" || ' ' || d."surname" AS "driver_name",
                f."year"
FROM   final_list f
JOIN   "drivers" d ON d."driver_id" = f."driver_id"
ORDER  BY f."year", "driver_name"
LIMIT 20;
```

```sql
--Description: ⑨  Bring in the constructor’s name as well, to show which team each qualifying season was with.
WITH driver_season AS (
     SELECT r."driver_id",
            ra."year",
            MIN(ra."round")            AS "first_round",
            MAX(ra."round")            AS "last_round",
            COUNT(DISTINCT ra."round") AS "race_count"
     FROM   "results" r
     JOIN   "races"   ra ON ra."race_id" = r."race_id"
     WHERE  ra."year" BETWEEN 1950 AND 1959
     GROUP  BY r."driver_id", ra."year"
),
first_last AS (
     SELECT ds.*,
            (SELECT r2."constructor_id"
             FROM   "results" r2
             JOIN   "races"  ra2 ON ra2."race_id" = r2."race_id"
             WHERE  r2."driver_id" = ds."driver_id"
               AND  ra2."year"     = ds."year"
               AND  ra2."round"    = ds."first_round"
             LIMIT 1)              AS "first_constructor",
            (SELECT r3."constructor_id"
             FROM   "results" r3
             JOIN   "races"  ra3 ON ra3."race_id" = r3."race_id"
             WHERE  r3."driver_id" = ds."driver_id"
               AND  ra3."year"     = ds."year"
               AND  ra3."round"    = ds."last_round"
             LIMIT 1)              AS "last_constructor"
     FROM driver_season ds
),
final_list AS (
     SELECT fl."driver_id",
            fl."year",
            fl."first_constructor" AS "constructor_id"
     FROM   first_last fl
     WHERE  fl."first_constructor" = fl."last_constructor"
       AND  fl."race_count" >= 2
)
SELECT DISTINCT d."forename" || ' ' || d."surname" AS "driver_name",
                c."name"                            AS "constructor_name",
                f."year"
FROM   final_list      f
JOIN   "drivers"       d ON d."driver_id"      = f."driver_id"
JOIN   "constructors"  c ON c."constructor_id" = f."constructor_id"
ORDER  BY f."year", "driver_name"
LIMIT 20;
```

```sql
--Description: ⑩  Final answer – every driver in the 1950s who finished the season with the same constructor they started it with, having raced in at least two rounds.
WITH driver_season AS (
     SELECT r."driver_id",
            ra."year",
            MIN(ra."round")            AS "first_round",
            MAX(ra."round")            AS "last_round",
            COUNT(DISTINCT ra."round") AS "race_count"
     FROM   "results" r
     JOIN   "races"   ra ON ra."race_id" = r."race_id"
     WHERE  ra."year" BETWEEN 1950 AND 1959
     GROUP  BY r."driver_id", ra."year"
),
first_constructors AS (
     SELECT ds."driver_id",
            ds."year",
            res."constructor_id"        AS "constructor_id_first"
     FROM   driver_season ds
     JOIN   "races"      r      ON r."year"  = ds."year" AND r."round" = ds."first_round"
     JOIN   "results"    res    ON res."race_id" = r."race_id" AND res."driver_id" = ds."driver_id"
),
last_constructors AS (
     SELECT ds."driver_id",
            ds."year",
            res."constructor_id"        AS "constructor_id_last"
     FROM   driver_season ds
     JOIN   "races"      r      ON r."year"  = ds."year" AND r."round" = ds."last_round"
     JOIN   "results"    res    ON res."race_id" = r."race_id" AND res."driver_id" = ds."driver_id"
),
same_constructor_season AS (
     SELECT ds."driver_id",
            ds."year"
     FROM   driver_season     ds
     JOIN   first_constructors fc ON fc."driver_id" = ds."driver_id" AND fc."year" = ds."year"
     JOIN   last_constructors  lc ON lc."driver_id" = ds."driver_id" AND lc."year" = ds."year"
     WHERE  fc."constructor_id_first" = lc."constructor_id_last"
       AND  ds."race_count" >= 2
)
SELECT DISTINCT d."forename" || ' ' || d."surname" AS "driver_name",
                same."year"
FROM   same_constructor_season same
JOIN   "drivers" d ON d."driver_id" = same."driver_id"
ORDER  BY d."surname", same."year"
LIMIT 20;
```
