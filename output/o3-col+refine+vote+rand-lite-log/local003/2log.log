```sql
-- 2) Inspect a few delivered orders together with purchase timestamp and the customer they belong to
SELECT "order_id",
       "customer_id",
       "order_purchase_timestamp"
FROM   "orders"
WHERE  "order_status" = 'delivered'
ORDER  BY "order_purchase_timestamp" DESC
LIMIT 20;
```

```sql
-- 3) Look at the monetary value registered for each order (already summed in order_payments)
SELECT "order_id",
       SUM("payment_value") AS "order_total_value"
FROM   "order_payments"
GROUP  BY "order_id"
LIMIT 20;
```

```sql
-- 4) Join delivered orders with their payment totals (one-row-per-order view)
SELECT o."order_id",
       o."customer_id",
       o."order_purchase_timestamp",
       p."order_total_value"
FROM   (SELECT "order_id",
               "customer_id",
               "order_purchase_timestamp"
        FROM   "orders"
        WHERE  "order_status" = 'delivered')  AS o
JOIN   (SELECT "order_id",
               SUM("payment_value") AS "order_total_value"
        FROM   "order_payments"
        GROUP  BY "order_id")                 AS p
       ON p."order_id" = o."order_id"
LIMIT 20;
```

```sql
-- 5) Aggregate per customer: frequency (#orders) & monetary (total spend)
SELECT o."customer_id",
       COUNT(*)                           AS "freq_orders",
       SUM(p."order_total_value")         AS "monetary_total"
FROM   (SELECT "order_id",
               "customer_id"
        FROM   "orders"
        WHERE  "order_status" = 'delivered')  AS o
JOIN   (SELECT "order_id",
               SUM("payment_value") AS "order_total_value"
        FROM   "order_payments"
        GROUP  BY "order_id")                 AS p
       ON p."order_id" = o."order_id"
GROUP  BY o."customer_id"
LIMIT 20;
```

```sql
-- 6) Determine recency for each customer (days since last delivered purchase)
--    Here we simply keep the date; how many days ago can be computed later
SELECT o."customer_id",
       MAX(o."order_purchase_timestamp") AS "last_purchase_ts"
FROM   "orders" AS o
WHERE  o."order_status" = 'delivered'
GROUP  BY o."customer_id"
LIMIT 20;
```

```sql
-- 7) Pull the three raw R, F, M measures together for every customer
SELECT r."customer_id",
       r."last_purchase_ts",
       f."freq_orders",
       f."monetary_total"
FROM   (SELECT "customer_id",
               MAX("order_purchase_timestamp") AS "last_purchase_ts"
        FROM   "orders"
        WHERE  "order_status" = 'delivered'
        GROUP  BY "customer_id")               AS r
JOIN   (SELECT o."customer_id",
               COUNT(*)                   AS "freq_orders",
               SUM(p."order_total_value") AS "monetary_total"
        FROM   (SELECT "order_id",
                       "customer_id"
                FROM   "orders"
                WHERE  "order_status" = 'delivered')  AS o
        JOIN   (SELECT "order_id",
                       SUM("payment_value") AS "order_total_value"
                FROM   "order_payments"
                GROUP  BY "order_id")                 AS p
               ON p."order_id" = o."order_id"
        GROUP  BY o."customer_id")                   AS f
       ON f."customer_id" = r."customer_id"
LIMIT 20;
```

```sql
-- 8) Classify each customer into a simple RFM segment
--    Criteria example (comment only):
--      Recency ≤ 90 days  → ‘R_Recent’ else ‘R_Old’
--      Frequency ≥ 3      → ‘F_High’  else ‘F_Low’
--      Monetary ≥ 500 BRL → ‘M_High’  else ‘M_Low’
--    The CASE below illustrates those cut-offs
SELECT tmp."customer_id",
       CASE WHEN julianday('now') - julianday(tmp."last_purchase_ts") <= 90 THEN 'R_Recent'
            ELSE 'R_Old'
       END                                                    AS "R_Score",
       CASE WHEN tmp."freq_orders"    >= 3  THEN 'F_High'  ELSE 'F_Low'  END AS "F_Score",
       CASE WHEN tmp."monetary_total" >= 500 THEN 'M_High'  ELSE 'M_Low'  END AS "M_Score",
       ROUND(tmp."monetary_total" * 1.0 / tmp."freq_orders",2)            AS "avg_sales_per_order"
FROM   ( /* raw RFM from query 7 without LIMIT      */
        SELECT r."customer_id",
               r."last_purchase_ts",
               f."freq_orders",
               f."monetary_total"
        FROM   (SELECT "customer_id",
                       MAX("order_purchase_timestamp") AS "last_purchase_ts"
                FROM   "orders"
                WHERE  "order_status" = 'delivered'
                GROUP  BY "customer_id")               AS r
        JOIN   (SELECT o."customer_id",
                       COUNT(*)                   AS "freq_orders",
                       SUM(p."order_total_value") AS "monetary_total"
                FROM   (SELECT "order_id",
                               "customer_id"
                        FROM   "orders"
                        WHERE  "order_status" = 'delivered')  AS o
                JOIN   (SELECT "order_id",
                               SUM("payment_value") AS "order_total_value"
                        FROM   "order_payments"
                        GROUP  BY "order_id")                 AS p
                       ON p."order_id" = o."order_id"
                GROUP  BY o."customer_id")                   AS f
               ON f."customer_id" = r."customer_id"
       )  AS tmp
LIMIT 20;
```

```sql
-- 9) Build the final RFM segment label and compute the average sales per order inside each segment
SELECT (R_Score || '-' || F_Score || '-' || M_Score)       AS "RFM_segment",
       ROUND(AVG("avg_sales_per_order"),2)                 AS "segment_avg_sales",
       COUNT(*)                                            AS "customers_in_segment"
FROM   (
        /* same sub-query as in #8 but without LIMIT, now alias as base */
        SELECT tmp.*,
               CASE WHEN julianday('now') - julianday(tmp."last_purchase_ts") <= 90 THEN 'R_Recent'
                    ELSE 'R_Old'
               END AS "R_Score",
               CASE WHEN tmp."freq_orders"    >= 3  THEN 'F_High'  ELSE 'F_Low'  END AS "F_Score",
               CASE WHEN tmp."monetary_total" >= 500 THEN 'M_High'  ELSE 'M_Low'  END AS "M_Score",
               ROUND(tmp."monetary_total" * 1.0 / tmp."freq_orders",2) AS "avg_sales_per_order"
        FROM   (
                SELECT r."customer_id",
                       r."last_purchase_ts",
                       f."freq_orders",
                       f."monetary_total"
                FROM   (SELECT "customer_id",
                               MAX("order_purchase_timestamp") AS "last_purchase_ts"
                        FROM   "orders"
                        WHERE  "order_status" = 'delivered'
                        GROUP  BY "customer_id")               AS r
                JOIN   (SELECT o."customer_id",
                               COUNT(*)                   AS "freq_orders",
                               SUM(p."order_total_value") AS "monetary_total"
                        FROM   (SELECT "order_id",
                                       "customer_id"
                                FROM   "orders"
                                WHERE  "order_status" = 'delivered')  AS o
                        JOIN   (SELECT "order_id",
                                       SUM("payment_value") AS "order_total_value"
                                FROM   "order_payments"
                                GROUP  BY "order_id")                 AS p
                               ON p."order_id" = o."order_id"
                        GROUP  BY o."customer_id")                   AS f
                       ON f."customer_id" = r."customer_id"
               ) AS tmp
       )
GROUP  BY "RFM_segment"
ORDER  BY "segment_avg_sales" DESC
LIMIT 20;
```

```sql
-- 10) Snapshot of individual high-value customers within the top RFM segment
SELECT "customer_id",
       "avg_sales_per_order",
       "freq_orders",
       "monetary_total",
       "last_purchase_ts"
FROM   (
        /* reuse detailed table from previous sub-query */
        SELECT tmp.*,
               ROUND(tmp."monetary_total" * 1.0 / tmp."freq_orders",2) AS "avg_sales_per_order",
               CASE WHEN julianday('now') - julianday(tmp."last_purchase_ts") <= 90 THEN 'R_Recent'
                    ELSE 'R_Old'
               END AS "R_Score",
               CASE WHEN tmp."freq_orders"    >= 3  THEN 'F_High'  ELSE 'F_Low'  END AS "F_Score",
               CASE WHEN tmp."monetary_total" >= 500 THEN 'M_High'  ELSE 'M_Low'  END AS "M_Score"
        FROM   (
                SELECT r."customer_id",
                       r."last_purchase_ts",
                       f."freq_orders",
                       f."monetary_total"
                FROM   (SELECT "customer_id",
                               MAX("order_purchase_timestamp") AS "last_purchase_ts"
                        FROM   "orders"
                        WHERE  "order_status" = 'delivered'
                        GROUP  BY "customer_id")               AS r
                JOIN   (SELECT o."customer_id",
                               COUNT(*)                   AS "freq_orders",
                               SUM(p."order_total_value") AS "monetary_total"
                        FROM   (SELECT "order_id",
                                       "customer_id"
                                FROM   "orders"
                                WHERE  "order_status" = 'delivered')  AS o
                        JOIN   (SELECT "order_id",
                                       SUM("payment_value") AS "order_total_value"
                                FROM   "order_payments"
                                GROUP  BY "order_id")                 AS p
                               ON p."order_id" = o."order_id"
                        GROUP  BY o."customer_id")                   AS f
                       ON f."customer_id" = r."customer_id"
               ) AS tmp
       )
WHERE  ("R_Score" = 'R_Recent' AND "F_Score" = 'F_High' AND "M_Score" = 'M_High')
ORDER  BY "avg_sales_per_order" DESC
LIMIT 20;
```

