Query:
-- 8) Classify each customer into a simple RFM segment
--    Criteria example (comment only):
--      Recency ≤ 90 days  → ‘R_Recent’ else ‘R_Old’
--      Frequency ≥ 3      → ‘F_High’  else ‘F_Low’
--      Monetary ≥ 500 BRL → ‘M_High’  else ‘M_Low’
--    The CASE below illustrates those cut-offs
SELECT tmp."customer_id",
       CASE WHEN julianday('now') - julianday(tmp."last_purchase_ts") <= 90 THEN 'R_Recent'
            ELSE 'R_Old'
       END                                                    AS "R_Score",
       CASE WHEN tmp."freq_orders"    >= 3  THEN 'F_High'  ELSE 'F_Low'  END AS "F_Score",
       CASE WHEN tmp."monetary_total" >= 500 THEN 'M_High'  ELSE 'M_Low'  END AS "M_Score",
       ROUND(tmp."monetary_total" * 1.0 / tmp."freq_orders",2)            AS "avg_sales_per_order"
FROM   ( /* raw RFM from query 7 without LIMIT      */
        SELECT r."customer_id",
               r."last_purchase_ts",
               f."freq_orders",
               f."monetary_total"
        FROM   (SELECT "customer_id",
                       MAX("order_purchase_timestamp") AS "last_purchase_ts"
                FROM   "orders"
                WHERE  "order_status" = 'delivered'
                GROUP  BY "customer_id")               AS r
        JOIN   (SELECT o."customer_id",
                       COUNT(*)                   AS "freq_orders",
                       SUM(p."order_total_value") AS "monetary_total"
                FROM   (SELECT "order_id",
                               "customer_id"
                        FROM   "orders"
                        WHERE  "order_status" = 'delivered')  AS o
                JOIN   (SELECT "order_id",
                               SUM("payment_value") AS "order_total_value"
                        FROM   "order_payments"
                        GROUP  BY "order_id")                 AS p
                       ON p."order_id" = o."order_id"
                GROUP  BY o."customer_id")                   AS f
               ON f."customer_id" = r."customer_id"
       )  AS tmp
LIMIT 20;
