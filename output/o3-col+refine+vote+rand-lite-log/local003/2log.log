       ROUND(AVG(monetary_total * 1.0 / freq_orders), 2)            AS avg_sales_per_order,
       COUNT(*)                                                     AS customers_in_segment
FROM   (
        /*-------------------------------------------------------------------
          1.  Recency  : last delivered purchase date per customer
        -------------------------------------------------------------------*/
        SELECT  r.customer_id,
                r.last_purchase_ts,
        /*-------------------------------------------------------------------
          2.  Frequency & Monetary : # of delivered orders and total spend
        -------------------------------------------------------------------*/
                f.freq_orders,
                f.monetary_total,
        /*-------------------------------------------------------------------
          3.  Map each raw metric to its categorical score
        -------------------------------------------------------------------*/
                CASE WHEN julianday('now') - julianday(r.last_purchase_ts) <= 90
                     THEN 'R_Recent' ELSE 'R_Old'  END               AS R_Score,
                CASE WHEN f.freq_orders >= 3
                     THEN 'F_High'  ELSE 'F_Low'  END               AS F_Score,
                CASE WHEN f.monetary_total >= 500
                     THEN 'M_High'  ELSE 'M_Low'  END               AS M_Score
        FROM   ( SELECT customer_id,
                        MAX(order_purchase_timestamp) AS last_purchase_ts
                 FROM   orders
                 WHERE  order_status = 'delivered'
