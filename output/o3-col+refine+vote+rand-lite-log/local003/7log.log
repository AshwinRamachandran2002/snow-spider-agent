```sql
-- 1) Description: Check all possible order statuses to be sure we filter only 'delivered'
SELECT DISTINCT "order_status"
FROM "orders"
LIMIT 20;
```

```sql
-- 2) Description: Inspect the overall time-span of delivered purchases
SELECT MIN("order_purchase_timestamp")  AS "first_delivered",
       MAX("order_purchase_timestamp")  AS "last_delivered"
FROM   "orders"
WHERE  "order_status" = 'delivered';
```

```sql
-- 3) Description: Look at the total paid value per order (summing every payment line)
SELECT "o"."order_id",
       ROUND(SUM("op"."payment_value"),2) AS "order_total_paid"
FROM   "orders" AS "o"
JOIN   "order_payments" AS "op" USING ("order_id")
WHERE  "o"."order_status" = 'delivered'
GROUP  BY "o"."order_id"
LIMIT 20;
```

```sql
-- 4) Description: Connect orders with the customer_unique_id we must use for RFM
SELECT "o"."order_id",
       "c"."customer_unique_id"
FROM   "orders"  AS "o"
JOIN   "customers" AS "c"
       ON "o"."customer_id" = "c"."customer_id"
WHERE  "o"."order_status" = 'delivered'
LIMIT 20;
```

```sql
-- 5) Description: For each delivered order calculate the money value and purchase date
SELECT  "o"."order_id",
        "c"."customer_unique_id",
        MAX("o"."order_purchase_timestamp")            AS "purchase_ts",
        ROUND(SUM("op"."payment_value"),2)             AS "order_value"
FROM    "orders" AS "o"
JOIN    "customers"      AS "c"  ON "o"."customer_id" = "c"."customer_id"
JOIN    "order_payments" AS "op" USING ("order_id")
WHERE   "o"."order_status" = 'delivered'
GROUP   BY "o"."order_id", "c"."customer_unique_id"
LIMIT 20;
```

```sql
-- 6) Description: Build the basic R, F, M measures for every customer_unique_id
--     Recency = days since last delivered purchase against NOW (today at query run time)
--     Frequency = number of delivered orders
--     Monetary  = total spend on delivered orders
SELECT  "customer_unique_id",
        ROUND(JULIANDAY('now') - JULIANDAY(MAX("purchase_ts")),1)     AS "recency_days",
        COUNT(*)                                                     AS "frequency_orders",
        ROUND(SUM("order_value"),2)                                  AS "monetary_value"
FROM   (
        /* sub-query from step-5 */
        SELECT  "o"."order_id",
                "c"."customer_unique_id",
                "o"."order_purchase_timestamp"  AS "purchase_ts",
                SUM("op"."payment_value")       AS "order_value"
        FROM    "orders" AS "o"
        JOIN    "customers"      AS "c"  ON "o"."customer_id" = "c"."customer_id"
        JOIN    "order_payments" AS "op" USING ("order_id")
        WHERE   "o"."order_status" = 'delivered'
        GROUP   BY "o"."order_id","c"."customer_unique_id"
) AS t
GROUP BY "customer_unique_id"
LIMIT 20;
```

```sql
-- 7) Description: Classify each customer into RFM quartiles
--     Lower recency_days  → better (quartile 1 best)
--     Higher frequency    → better (quartile 1 best)
--     Higher monetary     → better (quartile 1 best)
WITH rfm AS (
    SELECT  *,
            NTILE(4) OVER (ORDER BY "recency_days" ASC)              AS "r_score",
            NTILE(4) OVER (ORDER BY "frequency_orders" DESC)         AS "f_score",
            NTILE(4) OVER (ORDER BY "monetary_value"  DESC)          AS "m_score"
    FROM   (
              /* same aggregation sub-query as step-6 */
              SELECT  "customer_unique_id",
                      ROUND(JULIANDAY('now') - JULIANDAY(MAX("purchase_ts")),1) AS "recency_days",
                      COUNT(*)                                                 AS "frequency_orders",
                      ROUND(SUM("order_value"),2)                              AS "monetary_value"
              FROM   (
                        SELECT  "o"."order_id",
                                "c"."customer_unique_id",
                                "o"."order_purchase_timestamp"  AS "purchase_ts",
                                SUM("op"."payment_value")       AS "order_value"
                        FROM    "orders" AS "o"
                        JOIN    "customers"      AS "c"  ON "o"."customer_id" = "c"."customer_id"
                        JOIN    "order_payments" AS "op" USING ("order_id")
                        WHERE   "o"."order_status" = 'delivered'
                        GROUP   BY "o"."order_id","c"."customer_unique_id"
              ) AS d
              GROUP BY "customer_unique_id"
    )
)
SELECT *
FROM   rfm
LIMIT 20;
```

```sql
-- 8) Description: Turn the individual R, F, M scores into a readable segment label
WITH rfm AS ( /* same CTE as step-7 */ SELECT * FROM /*…*/ )
SELECT  "customer_unique_id",
        "r_score"||"f_score"||"m_score"               AS "rfm_segment",
        "recency_days","frequency_orders","monetary_value"
FROM    rfm
LIMIT 20;
```

```sql
-- 9) Description: For each RFM segment compute average sales per order
WITH per_order AS (
        /* step-5 sub-query */
        SELECT  "o"."order_id",
                "c"."customer_unique_id",
                SUM("op"."payment_value")       AS "order_value"
        FROM    "orders" AS "o"
        JOIN    "customers"      AS "c"  ON "o"."customer_id" = "c"."customer_id"
        JOIN    "order_payments" AS "op" USING ("order_id")
        WHERE   "o"."order_status" = 'delivered'
        GROUP   BY "o"."order_id","c"."customer_unique_id"
), rfm AS (
        SELECT  "customer_unique_id",
                NTILE(4) OVER (ORDER BY ROUND(JULIANDAY('now')-JULIANDAY(MAX("purchase_ts")),1) ASC)  AS "r",
                NTILE(4) OVER (ORDER BY COUNT(*)                        DESC)                          AS "f",
                NTILE(4) OVER (ORDER BY SUM("order_value")              DESC)                          AS "m"
        FROM    (
                 SELECT  "c"."customer_unique_id",
                         "o"."order_purchase_timestamp" AS "purchase_ts",
                         SUM("op"."payment_value")      AS "order_value"
                 FROM    "orders" AS "o"
                 JOIN    "customers"      AS "c"  ON "o"."customer_id" = "c"."customer_id"
                 JOIN    "order_payments" AS "op" USING ("order_id")
                 WHERE   "o"."order_status" = 'delivered'
                 GROUP   BY "o"."order_id","c"."customer_unique_id"
        ) AS x
        GROUP  BY "customer_unique_id"
), orders_plus_segment AS (
        SELECT  p."order_id",
                p."order_value",
                r."r"||r."f"||r."m"  AS "rfm_segment"
        FROM    per_order  AS p
        JOIN    rfm        AS r USING ("customer_unique_id")
)
SELECT  "rfm_segment",
        ROUND(SUM("order_value") * 1.0 / COUNT("order_id"), 2) AS "avg_sales_per_order",
        COUNT(DISTINCT "order_id")                             AS "num_orders",
        COUNT(DISTINCT SUBSTR("order_id",1,0)||"rfm_segment")  AS "num_customers"
FROM    orders_plus_segment
GROUP  BY "rfm_segment"
ORDER BY "avg_sales_per_order" DESC
LIMIT 20;
```

```sql
-- 10) Description: Compare the highest and lowest spending RFM segments side-by-side
WITH summary AS (
       /* query from step-9 without LIMIT */
       SELECT  "rfm_segment",
               ROUND(SUM("order_value") * 1.0 / COUNT("order_id"), 2) AS "avg_sales_per_order"
       FROM   (
               /* identical orders_plus_segment CTE from step-9 */
               SELECT  p."order_id",
                       p."order_value",
                       r."r"||r."f"||r."m"  AS "rfm_segment"
               FROM    (
                        SELECT  "o"."order_id",
                                "c"."customer_unique_id",
                                SUM("op"."payment_value") AS "order_value"
                        FROM    "orders" AS "o"
                        JOIN    "customers"      AS "c"  ON "o"."customer_id" = "c"."customer_id"
                        JOIN    "order_payments" AS "op" USING ("order_id")
                        WHERE   "o"."order_status" = 'delivered'
                        GROUP   BY "o"."order_id","c"."customer_unique_id"
               ) AS p
               JOIN  (
                        /* compute r, f, m quartiles */
                        SELECT  "customer_unique_id",
                                NTILE(4) OVER (ORDER BY ROUND(JULIANDAY('now')-JULIANDAY(MAX("purchase_ts")),1) ASC)  AS "r",
                                NTILE(4) OVER (ORDER BY COUNT(*)                        DESC)                             AS "f",
                                NTILE(4) OVER (ORDER BY SUM("order_value")              DESC)                             AS "m"
                        FROM (
                                SELECT  "c"."customer_unique_id",
                                        "o"."order_purchase_timestamp" AS "purchase_ts",
                                        SUM("op"."payment_value")      AS "order_value"
                                FROM    "orders" AS "o"
                                JOIN    "customers"      AS "c"  ON "o"."customer_id" = "c"."customer_id"
                                JOIN    "order_payments" AS "op" USING ("order_id")
                                WHERE   "o"."order_status" = 'delivered'
                                GROUP   BY "o"."order_id","c"."customer_unique_id"
                        ) AS y
                        GROUP BY "customer_unique_id"
               ) AS r USING ("customer_unique_id")
       )
       GROUP  BY "rfm_segment"
)
SELECT  *
FROM    summary
WHERE   "avg_sales_per_order" = (SELECT MAX("avg_sales_per_order") FROM summary)
   OR   "avg_sales_per_order" = (SELECT MIN("avg_sales_per_order") FROM summary);
```
