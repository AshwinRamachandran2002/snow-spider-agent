Query:
--Description:  #9  – Compute the average sales‐per‐order for every 3-digit RFM segment.
WITH order_values AS (          -- value & customer for every *delivered* order
    SELECT  o."order_id",
            c."customer_unique_id",
            SUM(op."payment_value")               AS order_value,
            o."order_purchase_timestamp"          AS purchase_ts
    FROM    "orders"          AS o
    JOIN    "customers"       AS c   ON o."customer_id" = c."customer_id"
    JOIN    "order_payments"  AS op  USING ("order_id")
    WHERE   o."order_status" = 'delivered'
    GROUP   BY o."order_id", c."customer_unique_id"
),
customer_agg AS (               -- raw Recency / Frequency / Monetary
    SELECT  customer_unique_id,
            (julianday('now') - julianday(MAX(purchase_ts))) AS recency_days,
            COUNT(*)                                        AS frequency_orders,
            SUM(order_value)                                AS monetary_value
    FROM    order_values
    GROUP   BY customer_unique_id
),
scored AS (                     -- quartile scores (1 = best)
    SELECT  *,
            NTILE(4) OVER (ORDER BY recency_days ASC)       AS r,
            NTILE(4) OVER (ORDER BY frequency_orders DESC)  AS f,
            NTILE(4) OVER (ORDER BY monetary_value DESC)    AS m
    FROM    customer_agg
),
orders_plus_seg AS (           -- join each order to its customer’s segment
    SELECT  ov.order_id,
            ov.order_value,
            ov.customer_unique_id,
            (r || f || m) AS rfm_segment
    FROM    order_values ov
    JOIN    scored       USING (customer_unique_id)
)
SELECT  rfm_segment,
        ROUND(SUM(order_value) * 1.0 / COUNT(order_id), 2) AS avg_sales_per_order,
        COUNT(DISTINCT customer_unique_id)                AS num_customers,
        COUNT(order_id)                                   AS num_orders
FROM    orders_plus_seg
GROUP   BY rfm_segment
ORDER   BY avg_sales_per_order DESC
LIMIT 20
