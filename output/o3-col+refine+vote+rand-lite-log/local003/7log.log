```sql
--Description:  One-shot query to (1) isolate every *delivered* order and its monetary value,
--(2) build customer-level R, F, M metrics, (3) score each customer into quartiles
--     (1 = best for all three dimensions), (4) attach the 3-digit RFM code to every
--     order, and finally (5) compute “average sales per order” for every segment.
--
--Key points of the thinking:
-- • Recency = days between the customer’s last purchase and the dataset’s
--             most-recent delivered purchase (makes the metric stable instead of
--             using the moving ‘now’). Smaller is fresher → better.
-- • Frequency = number of delivered orders. More orders → better.
-- • Monetary  = total spend across delivered orders. Higher spend → better.
-- • NTILE(4) converts each raw metric into quartile scores (1..4).
-- • Segment label is the text concatenation r||f||m, e.g. ‘111’ = top customers.
WITH max_date AS (  -- latest delivered purchase in the dataset
    SELECT MAX("order_purchase_timestamp") AS max_ts
    FROM   "orders"
    WHERE  "order_status" = 'delivered'
),
order_values AS (   -- value of every delivered order
    SELECT  o."order_id",
            c."customer_unique_id",
            o."order_purchase_timestamp"                 AS purchase_ts,
            SUM(op."payment_value")                      AS order_value
    FROM    "orders"          AS o
    JOIN    "customers"       AS c   ON o."customer_id" = c."customer_id"
    JOIN    "order_payments"  AS op  USING ("order_id")
    WHERE   o."order_status" = 'delivered'
    GROUP   BY o."order_id", c."customer_unique_id"
),
customer_agg AS (   -- Recency / Frequency / Monetary per customer
    SELECT  customer_unique_id,
            julianday( (SELECT max_ts FROM max_date) ) - julianday( MAX(purchase_ts) )  AS recency_days,
            COUNT(*)                                                                   AS frequency_orders,
            SUM(order_value)                                                           AS monetary_value
    FROM    order_values
    GROUP   BY customer_unique_id
),
scored AS (         -- quartile scores 1-4 for each dimension
    SELECT  *,
            NTILE(4) OVER (ORDER BY recency_days ASC)        AS r,
            NTILE(4) OVER (ORDER BY frequency_orders DESC)   AS f,
            NTILE(4) OVER (ORDER BY monetary_value DESC)     AS m
    FROM    customer_agg
),
orders_with_segment AS (  -- bring the segment code back to order level
    SELECT  ov.order_id,
            ov.order_value,
            ov.customer_unique_id,
            (r || f || m)         AS rfm_segment
    FROM    order_values  ov
    JOIN    scored        USING (customer_unique_id)
)
SELECT  rfm_segment,
        ROUND( SUM(order_value) * 1.0 / COUNT(order_id), 2 ) AS avg_sales_per_order,
        COUNT(DISTINCT customer_unique_id)                  AS num_customers,
        COUNT(order_id)                                     AS num_orders
FROM    orders_with_segment
GROUP   BY rfm_segment
ORDER   BY avg_sales_per_order DESC;
```
