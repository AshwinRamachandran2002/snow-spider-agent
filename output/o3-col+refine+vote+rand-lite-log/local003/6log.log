```sql
--Description: 
--We need to compare average sales per order across RFM segments (for customers with at least one *delivered* order).
--Step-1  Build raw R, F, M for every customer_unique_id
--        • Recency (days) = “dataset’s most-recent delivered order date” – “customer’s latest delivered order date”.
--        • Frequency      = count of delivered orders.
--        • Monetary       = Σ(price + freight) across those orders.
--Step-2  Assign buckets    
--        • R_bucket:  ≤30 days→Recent, 31-90→Warm, >90→Cold.   
--        • F_bucket:  1→LowFreq, 2-4→MediumFreq, ≥5→HighFreq.  
--        • M_bucket:  NTILE(3) over Monetary (1=LowVal,2=MidVal,3=HighVal).  
--Step-3  For each customer calculate average_sales_per_order = Monetary / Frequency.  
--Step-4  Aggregate by R_bucket||'-'||F_bucket||'-'||M_bucket to see how spending differs between segments.

WITH rfm AS (  --Step-1: raw metrics
    SELECT
        c."customer_unique_id",
        ROUND(
            julianday( (SELECT MAX("order_purchase_timestamp")
                        FROM "orders"
                        WHERE "order_status"='delivered') )
          - julianday( MAX(o."order_purchase_timestamp") ), 1
        )                                   AS recency_days,
        COUNT(DISTINCT o."order_id")        AS frequency,
        SUM(oi."price" + oi."freight_value") AS monetary
    FROM "orders"      o
    JOIN "order_items" oi ON oi."order_id" = o."order_id"
    JOIN "customers"   c  ON c."customer_id" = o."customer_id"
    WHERE o."order_status" = 'delivered'
    GROUP BY c."customer_unique_id"
),
bucketed AS (  --Step-2: add bucket labels
    SELECT
        r.*,
        NTILE(3) OVER (ORDER BY monetary)                      AS m_tile,
        CASE
            WHEN recency_days <= 30  THEN 'Recent'
            WHEN recency_days <= 90  THEN 'Warm'
            ELSE 'Cold'
        END                                                    AS R_bucket,
        CASE
            WHEN frequency >= 5 THEN 'HighFreq'
            WHEN frequency >= 2 THEN 'MediumFreq'
            ELSE 'LowFreq'
        END                                                    AS F_bucket
    FROM rfm r
),
cust_avg AS (  --Step-3: customer-level average sale per order
    SELECT
        "customer_unique_id",
        R_bucket,
        F_bucket,
        CASE m_tile WHEN 3 THEN 'HighVal'
                    WHEN 2 THEN 'MidVal'
                    ELSE 'LowVal' END                          AS M_bucket,
        ROUND(monetary * 1.0 / frequency, 2)                   AS avg_sales_per_order
    FROM bucketed
)
--Step-4: compare segments
SELECT
    R_bucket || '-' || F_bucket || '-' || M_bucket             AS RFM_segment,
    COUNT(*)                                                   AS customers_in_segment,
    ROUND(AVG(avg_sales_per_order), 2)                         AS avg_of_avg_sales,
    ROUND(MIN(avg_sales_per_order), 2)                         AS min_avg_sales,
    ROUND(MAX(avg_sales_per_order), 2)                         AS max_avg_sales
FROM cust_avg
GROUP BY RFM_segment
ORDER BY customers_in_segment DESC;
```
