```sql
--1. Description: Check all possible values that appear in the order_status column
SELECT DISTINCT "order_status"
FROM "orders"
LIMIT 20;
```

```sql
--2. Description: Look at the most recent 20 delivered orders to understand the date format we are working with
SELECT "order_id",
       "order_purchase_timestamp"
FROM   "orders"
WHERE  "order_status" = 'delivered'
ORDER  BY "order_purchase_timestamp" DESC
LIMIT 20;
```

```sql
--3. Description: Inspect the oldest and newest purchase timestamps among delivered orders (recency reference)
SELECT MIN("order_purchase_timestamp")  AS "earliest_delivered",
       MAX("order_purchase_timestamp")  AS "latest_delivered"
FROM   "orders"
WHERE  "order_status" = 'delivered';
```

```sql
--4. Description: Verify how many delivered orders each customer had (frequency component)
SELECT c."customer_unique_id",
       COUNT(*) AS "delivered_orders"
FROM   "orders" o
JOIN   "customers" c
       ON c."customer_id" = o."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
ORDER  BY "delivered_orders" DESC
LIMIT 20;
```

```sql
--5. Description: Compute total sales (price + freight) for every order (monetary component, per-order)
SELECT oi."order_id",
       SUM(oi."price" + oi."freight_value") AS "order_value"
FROM   "order_items" oi
GROUP  BY oi."order_id"
ORDER  BY "order_value" DESC
LIMIT 20;
```

```sql
--6. Description: Link sales back to the customer to see spend per purchase
SELECT c."customer_unique_id",
       oi."order_id",
       SUM(oi."price" + oi."freight_value") AS "order_value"
FROM   "order_items"  oi
JOIN   "orders"      o  ON o."order_id" = oi."order_id"
JOIN   "customers"   c  ON c."customer_id" = o."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id",
         oi."order_id"
ORDER  BY "order_value" DESC
LIMIT 20;
```

```sql
--7. Description: Aggregate monetary value for each customer (total spend)
SELECT c."customer_unique_id",
       SUM(oi."price" + oi."freight_value") AS "total_spend"
FROM   "order_items"  oi
JOIN   "orders"      o  ON o."order_id" = oi."order_id"
JOIN   "customers"   c  ON c."customer_id" = o."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
ORDER  BY "total_spend" DESC
LIMIT 20;
```

```sql
--8. Description: For recency, pull the last delivered purchase date per customer
SELECT c."customer_unique_id",
       MAX(o."order_purchase_timestamp") AS "last_purchase_ts"
FROM   "orders" o
JOIN   "customers" c ON c."customer_id" = o."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
ORDER  BY "last_purchase_ts" DESC
LIMIT 20;
```

```sql
--9. Description: Compute full R, F, M metrics in one shot for every customer
SELECT c."customer_unique_id",
       /* Recency in days from most recent delivered order in dataset */
       ROUND(julianday((SELECT MAX("order_purchase_timestamp")
                        FROM "orders"
                        WHERE "order_status"='delivered')) -
             julianday(MAX(o."order_purchase_timestamp")), 1)   AS "recency_days",
       COUNT(DISTINCT o."order_id")                              AS "frequency",
       SUM(oi."price" + oi."freight_value")                      AS "monetary"
FROM   "orders"       o
JOIN   "order_items"  oi ON oi."order_id" = o."order_id"
JOIN   "customers"    c  ON c."customer_id" = o."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
LIMIT 20;
```

```sql
--10. Description: Average sales per order (M/F) and rough RFM segmentation buckets
/* Example buckets:
      Recency:   <=30 days 'Recent', 31–90 'Warm', 91+ 'Cold'
      Frequency: >=5 'HighFreq', 2-4 'MediumFreq', 1 'LowFreq'
      Monetary : top 33% 'HighVal', middle 33% 'MidVal', bottom 33% 'LowVal'
   The CASE statements below implement those example cuts so we can examine differences. */
SELECT *,
       /* average sales per order */
       ROUND("monetary" * 1.0 / "frequency", 2)                         AS "avg_sales_per_order",
       /* Segment labels */
       CASE 
            WHEN "recency_days" <= 30  THEN 'Recent'
            WHEN "recency_days" <= 90  THEN 'Warm'
            ELSE 'Cold'
       END                                                              AS "R_bucket",
       CASE
            WHEN "frequency" >= 5 THEN 'HighFreq'
            WHEN "frequency" >= 2 THEN 'MediumFreq'
            ELSE 'LowFreq'
       END                                                              AS "F_bucket",
       CASE 
            WHEN "monetary" >= (SELECT percentile_approx(m,0.67) FROM
                                  (SELECT SUM(oi2."price"+oi2."freight_value") AS m
                                     FROM "orders" o2
                                     JOIN "order_items" oi2 ON oi2."order_id"=o2."order_id"
                                     WHERE o2."order_status"='delivered'
                                     GROUP BY o2."customer_id"))      THEN 'HighVal'
            WHEN "monetary" >= (SELECT percentile_approx(m,0.33) FROM
                                  (SELECT SUM(oi2."price"+oi2."freight_value") AS m
                                     FROM "orders" o2
                                     JOIN "order_items" oi2 ON oi2."order_id"=o2."order_id"
                                     WHERE o2."order_status"='delivered'
                                     GROUP BY o2."customer_id"))      THEN 'MidVal'
            ELSE 'LowVal'
       END                                                              AS "M_bucket"
FROM (
      /* Subquery: get RFM for every customer */
      SELECT c."customer_unique_id",
             ROUND(julianday((SELECT MAX("order_purchase_timestamp")
                              FROM "orders"
                              WHERE "order_status"='delivered')) -
                   julianday(MAX(o."order_purchase_timestamp")), 1)    AS "recency_days",
             COUNT(DISTINCT o."order_id")                               AS "frequency",
             SUM(oi."price" + oi."freight_value")                       AS "monetary"
      FROM   "orders"       o
      JOIN   "order_items"  oi ON oi."order_id" = o."order_id"
      JOIN   "customers"    c  ON c."customer_id" = o."customer_id"
      WHERE  o."order_status" = 'delivered'
      GROUP  BY c."customer_unique_id"
) rfm
LIMIT 20;
```

These 10 queries progressively explore the data needed to build RFM segments, calculate each customer’s average sales per order (Monetary ÷ Frequency), and attach illustrative R/F/M buckets so differences across segments can be inspected.
