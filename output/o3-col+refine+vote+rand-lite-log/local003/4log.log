```

```sql
-- 4) Description:  See the payment_value recorded for a handful of delivered orders.
SELECT DISTINCT op."order_id",
       op."payment_value"
FROM "order_payments" AS op
JOIN "orders"        AS o
      ON op."order_id" = o."order_id"
WHERE o."order_status" = 'delivered'
LIMIT 20;
```

```sql
-- 5) Description:  Combine delivered orders with their payments to compute
--    total spend and number of orders per customer_unique_id (first 20 rows).
SELECT cu."customer_unique_id",
       COUNT(DISTINCT o."order_id")               AS "n_orders",
       SUM(op."payment_value")                    AS "total_spend",
       AVG(op."payment_value")                    AS "avg_order_value"
FROM   "orders"         AS o
JOIN   "customers"      AS cu ON cu."customer_id" = o."customer_id"
JOIN   "order_payments" AS op ON op."order_id"    = o."order_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY cu."customer_unique_id"
LIMIT 20;
```

```sql
-- 6) Description:  Add a Recency measure (days since last purchase) for each
--    customer_unique_id.  The anchor is the latest delivered purchase date
--    in the whole data set.
WITH ref AS (
    SELECT MAX(julianday("order_purchase_timestamp")) AS max_day
    FROM   "orders"
    WHERE  "order_status" = 'delivered'
)
SELECT cu."customer_unique_id",
       ROUND(ref.max_day - MAX(julianday(o."order_purchase_timestamp")), 1) AS "recency_days"
FROM   "orders"    AS o
JOIN   ref
JOIN   "customers" AS cu ON cu."customer_id" = o."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY cu."customer_unique_id"
LIMIT 20;
```

```sql
-- 7) Description:  Merge frequency, monetary, and recency together for inspection.
WITH ref AS (
    SELECT MAX(julianday("order_purchase_timestamp")) AS max_day
    FROM   "orders"
    WHERE  "order_status" = 'delivered'
),
base AS (
    SELECT cu."customer_unique_id",
           COUNT(DISTINCT o."order_id")        AS freq_orders,
           SUM(op."payment_value")             AS monetary_total,
           ROUND(ref.max_day - MAX(julianday(o."order_purchase_timestamp")),1) AS recency_days
    FROM   "orders"         AS o
    JOIN   ref
    JOIN   "customers"      AS cu ON cu."customer_id" = o."customer_id"
    JOIN   "order_payments" AS op ON op."order_id"    = o."order_id"
    WHERE  o."order_status" = 'delivered'
    GROUP  BY cu."customer_unique_id"
)
SELECT *
FROM   base
LIMIT 20;
```

```sql
-- 8) Description:  Create simple R, F, M scores (1=best, 3=worst) using
--    fixed thresholds just for exploration.  (Thresholds can be refined later.)
WITH ref AS (
    SELECT MAX(julianday("order_purchase_timestamp")) AS max_day
    FROM   "orders"
    WHERE  "order_status" = 'delivered'
),
base AS (
    SELECT cu."customer_unique_id",
           COUNT(DISTINCT o."order_id")        AS freq_orders,
           SUM(op."payment_value")             AS monetary_total,
           ROUND(ref.max_day - MAX(julianday(o."order_purchase_timestamp")),1) AS recency_days
    FROM   "orders"         AS o
    JOIN   ref
    JOIN   "customers"      AS cu ON cu."customer_id" = o."customer_id"
    JOIN   "order_payments" AS op ON op."order_id"    = o."order_id"
    WHERE  o."order_status" = 'delivered'
    GROUP  BY cu."customer_unique_id"
),
scored AS (
    SELECT *,
           CASE
               WHEN recency_days <= 30  THEN 1
               WHEN recency_days <= 90  THEN 2
               ELSE 3
           END AS R_score,
           CASE
               WHEN freq_orders >= 5   THEN 1
               WHEN freq_orders >= 2   THEN 2
               ELSE 3
           END AS F_score,
           CASE
               WHEN monetary_total >= 500 THEN 1
               WHEN monetary_total >= 150 THEN 2
               ELSE 3
           END AS M_score
    FROM   base
)
SELECT *
FROM   scored
LIMIT 20;
```

```sql
-- 9) Description:  Turn the three scores into a compact RFM segment code.
WITH ref AS (
    SELECT MAX(julianday("order_purchase_timestamp")) AS max_day
    FROM   "orders"
    WHERE  "order_status" = 'delivered'
),
base AS (
    SELECT cu."customer_unique_id",
           COUNT(DISTINCT o."order_id")        AS freq_orders,
           SUM(op."payment_value")             AS monetary_total,
           ROUND(ref.max_day - MAX(julianday(o."order_purchase_timestamp")),1) AS recency_days
    FROM   "orders"         AS o
    JOIN   ref
    JOIN   "customers"      AS cu ON cu."customer_id" = o."customer_id"
    JOIN   "order_payments" AS op ON op."order_id"    = o."order_id"
    WHERE  o."order_status" = 'delivered'
    GROUP  BY cu."customer_unique_id"
),
scored AS (
    SELECT *,
           CASE
               WHEN recency_days <= 30  THEN 1
               WHEN recency_days <= 90  THEN 2
               ELSE 3
           END AS R_score,
           CASE
               WHEN freq_orders >= 5   THEN 1
               WHEN freq_orders >= 2   THEN 2
               ELSE 3
           END AS F_score,
           CASE
               WHEN monetary_total >= 500 THEN 1
               WHEN monetary_total >= 150 THEN 2
               ELSE 3
           END AS M_score
    FROM   base
)
SELECT customer_unique_id,
       printf('%d%d%d', R_score, F_score, M_score) AS "RFM_segment_code",
       ROUND(monetary_total*1.0 / freq_orders, 2)  AS "avg_sales_per_order"
FROM   scored
LIMIT 20;
```

```sql
-- 10) Description:  Compare the average sales per order across segments
--     (showing the 20 largest segments by customer count).
WITH ref AS (
    SELECT MAX(julianday("order_purchase_timestamp")) AS max_day
    FROM   "orders"
    WHERE  "order_status" = 'delivered'
),
base AS (
    SELECT cu."customer_unique_id",
           COUNT(DISTINCT o."order_id")        AS freq_orders,
           SUM(op."payment_value")             AS monetary_total,
           ROUND(ref.max_day - MAX(julianday(o."order_purchase_timestamp")),1) AS recency_days
    FROM   "orders"         AS o
    JOIN   ref
    JOIN   "customers"      AS cu ON cu."customer_id" = o."customer_id"
    JOIN   "order_payments" AS op ON op."order_id"    = o."order_id"
    WHERE  o."order_status" = 'delivered'
    GROUP  BY cu."customer_unique_id"
),
scored AS (
    SELECT *,
           CASE
               WHEN recency_days <= 30  THEN 1
               WHEN recency_days <= 90  THEN 2
               ELSE 3
           END AS R_score,
           CASE
               WHEN freq_orders >= 5   THEN 1
               WHEN freq_orders >= 2   THEN 2
               ELSE 3
           END AS F_score,
           CASE
               WHEN monetary_total >= 500 THEN 1
               WHEN monetary_total >= 150 THEN 2
               ELSE 3
           END AS M_score
    FROM   base
),
segmented AS (
    SELECT printf('%d%d%d', R_score, F_score, M_score) AS RFM_segment_code,
           ROUND(SUM(monetary_total) * 1.0 / SUM(freq_orders), 2) AS avg_sales_per_order,
           COUNT(*)                                            AS customers_in_segment
    FROM   scored
    GROUP  BY RFM_segment_code
)
SELECT *
FROM   segmented
ORDER  BY customers_in_segment DESC
LIMIT 20;
```
