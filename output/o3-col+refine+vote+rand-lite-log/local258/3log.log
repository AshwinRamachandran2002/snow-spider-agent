```sql
--1. Description: Inspect all possible dismissal kinds to know which ones are bowler-credited and which need to be ignored (e.g. run-out).
SELECT DISTINCT "kind_out"
FROM "wicket_taken"
LIMIT 20;
```

```sql
--2. Description: For a sample of wickets, join with ball_by_ball to see which bowler delivered the wicket-ball.
SELECT wt."match_id",
       wt."over_id",
       wt."ball_id",
       wt."player_out",
       bb."bowler"
FROM   "wicket_taken" AS wt
JOIN   "ball_by_ball" AS bb
  ON   wt."match_id" = bb."match_id"
 AND   wt."over_id"  = bb."over_id"
 AND   wt."ball_id"  = bb."ball_id"
LIMIT 20;
```

```sql
--3. Description: List some distinct bowlers (player_id) who appear in the ball_by_ball table.
SELECT DISTINCT bb."bowler"
FROM   "ball_by_ball" AS bb
LIMIT 20;
```

```sql
--4. Description: Map bowler IDs to their names using the player table (sample 20 rows).
SELECT DISTINCT p."player_id",
       p."player_name"
FROM   "player" AS p
JOIN   "ball_by_ball" AS bb
  ON   p."player_id" = bb."bowler"
LIMIT 20;
```

```sql
--5. Description: Look at runs that came off the bat (batsman_scored) for a sample of deliveries.
SELECT *
FROM   "batsman_scored"
LIMIT 20;
```

```sql
--6. Description: Inspect extra runs to identify their types and values (e.g. wides, no-balls, leg-byes) so they can be excluded from economy calculations.
SELECT DISTINCT "extra_type"
FROM   "extra_runs"
LIMIT 20;
```

```sql
--7. Description: Combine ball_by_ball and batsman_scored to see runs conceded off the bat on each delivery (sample 20 rows).
SELECT bb."match_id",
       bb."over_id",
       bb."ball_id",
       bb."bowler",
       bs."runs_scored"
FROM   "ball_by_ball"   AS bb
JOIN   "batsman_scored" AS bs
  ON   bb."match_id" = bs."match_id"
 AND   bb."over_id"  = bs."over_id"
 AND   bb."ball_id"  = bs."ball_id"
LIMIT 20;
```

```sql
--8. Description: Show deliveries that produced only extras (no runs off the bat) to understand what must be ignored for economy.
SELECT bb."match_id",
       bb."over_id",
       bb."ball_id",
       bb."bowler",
       er."extra_type",
       er."extra_runs"
FROM   "ball_by_ball" AS bb
JOIN   "extra_runs"  AS er
  ON   bb."match_id" = er."match_id"
 AND   bb."over_id"  = er."over_id"
 AND   bb."ball_id"  = er."ball_id"
LIMIT 20;
```

```sql
--9. Description: Count how many legitimate balls (ignoring wides & no-balls) each bowler delivered in a single match (sample 20 rows).
SELECT bb."match_id",
       bb."bowler",
       COUNT(*) AS "legitimate_balls"
FROM   "ball_by_ball" AS bb
LEFT JOIN "extra_runs" AS er
  ON   bb."match_id" = er."match_id"
 AND  bb."over_id"   = er."over_id"
 AND  bb."ball_id"   = er."ball_id"
 AND  er."extra_type" IN ('wides', 'noballs')
WHERE er."extra_type" IS NULL   -- keep only legal balls
GROUP BY bb."match_id", bb."bowler"
LIMIT 20;
```

```sql
--10. Description: Find each bowler’s best wicket haul in a match to later format as “wickets-runs” (sample 20 rows).
SELECT bb."bowler",
       wt."match_id",
       COUNT(*) AS "wickets_in_match"
FROM   "wicket_taken" AS wt
JOIN   "ball_by_ball" AS bb
  ON   wt."match_id" = bb."match_id"
 AND   wt."over_id"  = bb."over_id"
 AND   wt."ball_id"  = bb."ball_id"
WHERE  wt."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')  -- dismissals not credited to bowler
GROUP BY bb."bowler", wt."match_id"
ORDER BY "wickets_in_match" DESC
LIMIT 20;
```
