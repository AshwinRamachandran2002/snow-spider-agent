```sql
-- Description: 1) Inspect every dismissal mode recorded in wicket_taken 
SELECT DISTINCT "kind_out"
FROM "wicket_taken"
LIMIT 20;
```

```sql
-- Description: 2) List some wicket events together with the bowler who delivered the ball
--               (join wicket_taken with ball_by_ball on match_id / over_id / ball_id / innings_no)
SELECT DISTINCT wt."match_id",
                wt."over_id",
                wt."ball_id",
                wt."innings_no",
                wt."player_out",
                wt."kind_out",
                bb."bowler"
FROM   "wicket_taken" AS wt
JOIN   "ball_by_ball" AS bb
       ON  wt."match_id"  = bb."match_id"
       AND wt."over_id"   = bb."over_id"
       AND wt."ball_id"   = bb."ball_id"
       AND wt."innings_no"= bb."innings_no"
LIMIT 20;
```

```sql
-- Description: 3) Get a quick look at how runs off the bat are stored in batsman_scored
SELECT DISTINCT "match_id",
                "over_id",
                "ball_id",
                "runs_scored",
                "innings_no"
FROM   "batsman_scored"
LIMIT 20;
```

```sql
-- Description: 4) See the different kinds of extras (which we will later ignore for economy calcs)
SELECT DISTINCT "extra_type"
FROM   "extra_runs"
LIMIT 20;
```

```sql
-- Description: 5) Show a few deliveries with both batsman runs and extras
SELECT DISTINCT bb."match_id",
                bb."over_id",
                bb."ball_id",
                bs."runs_scored"          AS bat_runs,
                er."extra_type",
                er."extra_runs"
FROM   "ball_by_ball"   AS bb
LEFT JOIN "batsman_scored" AS bs
       ON  bb."match_id" = bs."match_id"
       AND bb."over_id"  = bs."over_id"
       AND bb."ball_id"  = bs."ball_id"
       AND bb."innings_no" = bs."innings_no"
LEFT JOIN "extra_runs"     AS er
       ON  bb."match_id" = er."match_id"
       AND bb."over_id"  = er."over_id"
       AND bb."ball_id"  = er."ball_id"
       AND bb."innings_no" = er."innings_no"
LIMIT 20;
```

```sql
-- Description: 6) Preview the list of unique bowlers who appear in ball_by_ball
SELECT DISTINCT "bowler"
FROM   "ball_by_ball"
LIMIT 20;
```

```sql
-- Description: 7) Quick check of player_id to player_name mapping for a handful of bowlers
SELECT DISTINCT p."player_id",
                p."player_name",
                p."bowling_skill"
FROM   "player" AS p
WHERE  p."player_id" IN (SELECT DISTINCT "bowler" FROM "ball_by_ball" LIMIT 20)
LIMIT 20;
```

```sql
-- Description: 8) Count wickets attributed to bowlers, excluding run-outs or dismissals without a bowler
--               (pure count to confirm logic; will refine for economy/strike later)
SELECT   bb."bowler",
         COUNT(*) AS wickets
FROM     "wicket_taken" AS wt
JOIN     "ball_by_ball" AS bb
       ON wt."match_id"   = bb."match_id"
      AND wt."over_id"    = bb."over_id"
      AND wt."ball_id"    = bb."ball_id"
      AND wt."innings_no" = bb."innings_no"
WHERE    wt."kind_out" NOT LIKE '%run out%'
GROUP BY bb."bowler"
LIMIT 20;
```

```sql
-- Description: 9) Compute total runs conceded (bat runs only, ignoring extras) per bowler
SELECT   bb."bowler",
         SUM(COALESCE(bs."runs_scored",0)) AS runs_conceded
FROM     "ball_by_ball" AS bb
LEFT JOIN "batsman_scored" AS bs
       ON  bb."match_id"   = bs."match_id"
      AND bb."over_id"    = bs."over_id"
      AND bb."ball_id"    = bs."ball_id"
      AND bb."innings_no" = bs."innings_no"
GROUP BY bb."bowler"
LIMIT 20;
```

```sql
-- Description: 10) Bring everything together for one bowler to preview best-bowling logic
SELECT   bb."bowler",
         bb."match_id",
         COUNT(DISTINCT wt."ball_id")           AS wickets_in_match,
         SUM(COALESCE(bs."runs_scored",0))      AS runs_conceded_in_match
FROM     "ball_by_ball" AS bb
LEFT JOIN "batsman_scored" AS bs
       ON  bb."match_id"   = bs."match_id"
      AND bb."over_id"    = bs."over_id"
      AND bb."ball_id"    = bs."ball_id"
      AND bb."innings_no" = bs."innings_no"
LEFT JOIN "wicket_taken"  AS wt
       ON  bb."match_id"   = wt."match_id"
      AND bb."over_id"    = wt."over_id"
      AND bb."ball_id"    = wt."ball_id"
      AND bb."innings_no" = wt."innings_no"
      AND wt."kind_out" NOT LIKE '%run out%'
WHERE    bb."bowler" = (SELECT "bowler" FROM "ball_by_ball" LIMIT 1)
GROUP BY bb."bowler", bb."match_id"
ORDER BY wickets_in_match DESC
LIMIT 20;
```
