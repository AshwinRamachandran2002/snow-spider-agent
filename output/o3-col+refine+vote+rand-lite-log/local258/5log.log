```sql
-- 4. Description: Join a single delivery with the runs scored off the bat
SELECT DISTINCT b."match_id",
       b."over_id",
       b."ball_id",
       b."bowler",
       r."runs_scored"
FROM   "ball_by_ball" AS b
JOIN   "batsman_scored" AS r
  ON   b."match_id" = r."match_id"
 AND   b."over_id"   = r."over_id"
 AND   b."ball_id"   = r."ball_id"
LIMIT 20;
```

```sql
-- 5. Description: Aggregate total runs conceded (bat only – no extras) by each bowler
SELECT DISTINCT b."bowler",
       SUM(r."runs_scored") AS "total_bat_runs"
FROM   "ball_by_ball"  AS b
JOIN   "batsman_scored" AS r
  ON   b."match_id" = r."match_id"
 AND   b."over_id"  = r."over_id"
 AND   b."ball_id"  = r."ball_id"
GROUP  BY b."bowler"
LIMIT 20;
```

```sql
-- 6. Description: Count the number of legal balls delivered by every bowler
SELECT DISTINCT "bowler",
       COUNT(*) AS "balls_bowled"
FROM   "ball_by_ball"
GROUP  BY "bowler"
LIMIT 20;
```

```sql
-- 7. Description: Count wickets for each bowler, ignoring run-outs and dismissals without a bowler credit
SELECT DISTINCT b."bowler",
       COUNT(*) AS "wickets"
FROM   "wicket_taken" AS w
JOIN   "ball_by_ball" AS b
  ON   w."match_id" = b."match_id"
 AND   w."over_id"  = b."over_id"
 AND   w."ball_id"  = b."ball_id"
WHERE  w."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
GROUP  BY b."bowler"
LIMIT 20;
```

```sql
-- 8. Description: Compute economy rate and strike rate for bowlers (runs / overs, balls / wicket)
SELECT DISTINCT s."bowler",
       s."total_runs",
       b."balls_bowled",
       w."wickets",
       ROUND( CAST(s."total_runs" AS REAL) / (b."balls_bowled" / 6.0), 2) AS "economy",
       ROUND( CAST(b."balls_bowled" AS REAL) / w."wickets", 2)           AS "strike_rate"
FROM  (
        SELECT b."bowler", SUM(r."runs_scored") AS "total_runs"
        FROM   "ball_by_ball"  AS b
        JOIN   "batsman_scored" AS r
          ON   b."match_id" = r."match_id"
         AND   b."over_id"  = r."over_id"
         AND   b."ball_id"  = r."ball_id"
        GROUP  BY b."bowler"
      ) AS s
JOIN (
        SELECT "bowler", COUNT(*) AS "balls_bowled"
        FROM   "ball_by_ball"
        GROUP  BY "bowler"
     ) AS b  ON b."bowler" = s."bowler"
JOIN (
        SELECT b."bowler", COUNT(*) AS "wickets"
        FROM   "wicket_taken" AS w
        JOIN   "ball_by_ball" AS b
          ON   w."match_id" = b."match_id"
         AND   w."over_id"  = b."over_id"
         AND   w."ball_id"  = b."ball_id"
        WHERE  w."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
        GROUP  BY b."bowler"
     ) AS w  ON w."bowler" = s."bowler"
LIMIT 20;
```

```sql
-- 9. Description: Determine each bowler's best figures in a single match (wickets-runs)
SELECT DISTINCT perf."bowler",
       perf."match_id",
       perf."wickets_in_match",
       perf."runs_in_match"
FROM (
        SELECT   b."bowler",
                 b."match_id",
                 COUNT(*)                        AS "wickets_in_match",
                 SUM(r."runs_scored")            AS "runs_in_match"
        FROM     "wicket_taken" AS w
        JOIN     "ball_by_ball" AS b
          ON     w."match_id" = b."match_id"
         AND     w."over_id"  = b."over_id"
         AND     w."ball_id"  = b."ball_id"
        JOIN     "batsman_scored" AS r
          ON     b."match_id" = r."match_id"
         AND     b."over_id"  = r."over_id"
         AND     b."ball_id"  = r."ball_id"
        WHERE    w."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
        GROUP BY b."bowler", b."match_id"
     ) AS perf
LIMIT 20;
```

```sql
-- 10. Description: Compile the final bowling summary – wickets, economy, strike rate, best bowling
SELECT DISTINCT e."bowler"                          AS "player_id",
       e."wickets"                                  AS "total_wkts",
       e."economy",
       e."strike_rate",
       best."wickets_in_match"
          || '-' || best."runs_in_match"            AS "best_figures"
FROM (
        SELECT s."bowler",
               s."total_runs",
               b."balls_bowled",
               w."wickets",
               ROUND( CAST(s."total_runs" AS REAL)/(b."balls_bowled"/6.0), 2) AS "economy",
               ROUND( CAST(b."balls_bowled" AS REAL)/w."wickets", 2)          AS "strike_rate"
        FROM  (
                SELECT b."bowler", SUM(r."runs_scored") AS "total_runs"
                FROM   "ball_by_ball"  AS b
                JOIN   "batsman_scored" AS r
                  ON   b."match_id" = r."match_id"
                 AND   b."over_id"  = r."over_id"
                 AND   b."ball_id"  = r."ball_id"
                GROUP  BY b."bowler"
              ) AS s
        JOIN (
                SELECT "bowler", COUNT(*) AS "balls_bowled"
                FROM   "ball_by_ball"
                GROUP  BY "bowler"
             ) AS b  ON b."bowler" = s."bowler"
        JOIN (
                SELECT b."bowler", COUNT(*) AS "wickets"
                FROM   "wicket_taken" AS w
                JOIN   "ball_by_ball" AS b
                  ON   w."match_id" = b."match_id"
                 AND   w."over_id"  = b."over_id"
                 AND   w."ball_id"  = b."ball_id"
                WHERE  w."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
                GROUP  BY b."bowler"
             ) AS w  ON w."bowler" = s."bowler"
      ) AS e
LEFT JOIN (
        SELECT p1."bowler",
               p1."wickets_in_match",
               p1."runs_in_match"
        FROM   (
                 SELECT   b."bowler",
                          b."match_id",
                          COUNT(*)             AS "wickets_in_match",
                          SUM(r."runs_scored") AS "runs_in_match",
                          RANK() OVER (PARTITION BY b."bowler"
                                       ORDER BY COUNT(*) DESC,
                                                SUM(r."runs_scored") ASC) AS rk
                 FROM     "wicket_taken" AS w
                 JOIN     "ball_by_ball" AS b
                   ON     w."match_id" = b."match_id"
                  AND     w."over_id"  = b."over_id"
                  AND     w."ball_id"  = b."ball_id"
                 JOIN     "batsman_scored" AS r
                   ON     b."match_id" = r."match_id"
                  AND     b."over_id"  = r."over_id"
                  AND     b."ball_id"  = r."ball_id"
                 WHERE    w."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
                 GROUP  BY b."bowler", b."match_id"
              ) AS p1
        WHERE p1.rk = 1          -- keep only best match per bowler
     ) AS best ON best."bowler" = e."bowler"
LIMIT 20;
```
