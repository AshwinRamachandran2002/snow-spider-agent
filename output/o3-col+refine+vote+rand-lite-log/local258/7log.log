```sql
--Description: Sample of wickets with the responsible bowler by matching the exact ball in ball_by_ball  
SELECT wt."match_id",
       wt."over_id",
       wt."ball_id",
       wt."player_out",
       wt."kind_out",
       bb."bowler"
FROM   "wicket_taken" AS wt
JOIN   "ball_by_ball" AS bb
       ON wt."match_id" = bb."match_id"
      AND wt."over_id"  = bb."over_id"
      AND wt."ball_id"  = bb."ball_id"
LIMIT 20;
```

```sql
--Description: List of unique player-ids that appear as a bowler in ball_by_ball  
SELECT DISTINCT "bowler"
FROM   "ball_by_ball"
LIMIT 20;
```

```sql
--Description: See, per delivery, the bowler and the runs scored off the bat (ignoring extras)  
SELECT bb."match_id",
       bb."over_id",
       bb."ball_id",
       bb."bowler",
       bs."runs_scored"
FROM   "ball_by_ball"  AS bb
JOIN   "batsman_scored" AS bs
       ON bb."match_id" = bs."match_id"
      AND bb."over_id"  = bs."over_id"
      AND bb."ball_id"  = bs."ball_id"
LIMIT 20;
```

```sql
--Description: Check the different types of extras that exist in extra_runs  
SELECT DISTINCT "extra_type"
FROM   "extra_runs"
LIMIT 20;
```

```sql
--Description: Quick look at runs off the bat (batsman_scored) for validation  
SELECT *
FROM   "batsman_scored"
LIMIT 20;
```

```sql
--Description: Combine a delivery with any extra recorded to see how extras are stored  
SELECT bb."match_id",
       bb."over_id",
       bb."ball_id",
       er."extra_type",
       er."extra_runs"
FROM   "ball_by_ball" AS bb
LEFT JOIN "extra_runs" AS er
       ON bb."match_id" = er."match_id"
      AND bb."over_id"  = er."over_id"
      AND bb."ball_id"  = er."ball_id"
LIMIT 20;
```

```sql
--Description: Map bowler IDs to names for a sample of bowlers  
SELECT p."player_id",
       p."player_name"
FROM   "player" AS p
WHERE  p."player_id" IN (SELECT DISTINCT "bowler"
                         FROM   "ball_by_ball"
                         LIMIT 20)
LIMIT 20;
```

```sql
--Description: Simple aggregation – total wickets credited to each bowler (excluding run-outs, etc.)  
SELECT bb."bowler",
       COUNT(*) AS "total_wkts"
FROM   "wicket_taken" AS wt
JOIN   "ball_by_ball" AS bb
       ON wt."match_id" = bb."match_id"
      AND wt."over_id"  = bb."over_id"
      AND wt."ball_id"  = bb."ball_id"
WHERE  wt."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')   -- adjust if needed
GROUP BY bb."bowler"
ORDER BY "total_wkts" DESC
LIMIT 20;
```

```sql
--Description: Wickets per bowler in a single match (for finding best bowling figures)  
SELECT bb."bowler",
       wt."match_id",
       COUNT(*) AS "wkts_in_match"
FROM   "wicket_taken" AS wt
JOIN   "ball_by_ball" AS bb
       ON wt."match_id" = bb."match_id"
      AND wt."over_id"  = bb."over_id"
      AND wt."ball_id"  = bb."ball_id"
WHERE  wt."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
GROUP BY bb."bowler", wt."match_id"
ORDER BY "wkts_in_match" DESC
LIMIT 20;
```
