Query:
-- 5. Description: Count how many motor thefts happened in every year-month between 2010-2016.
SELECT EXTRACT(YEAR  FROM `date`)  AS yr,
       EXTRACT(MONTH FROM `date`)  AS mo,
       COUNT(*)                    AS motor_thefts
FROM `bigquery-public-data.chicago_crime.crime`
WHERE primary_type = 'MOTOR VEHICLE THEFT'
  AND EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
GROUP BY yr, mo
ORDER BY yr, mo
LIMIT 20;
