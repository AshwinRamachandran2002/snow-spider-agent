```sql
-- 1. Description: Take a quick look at 20 random crime records to understand the columns we will use.
SELECT *
FROM `bigquery-public-data.chicago_crime.crime`
LIMIT 20;
```

```sql
-- 2. Description: List distinct crime years that exist in the table (should include 2010-2016).
SELECT DISTINCT EXTRACT(YEAR FROM `date`) AS yr
FROM `bigquery-public-data.chicago_crime.crime`
ORDER BY yr
LIMIT 20;
```

```sql
-- 3. Description: See how many different primary crime types start with the word “MOTOR”.
SELECT DISTINCT primary_type
FROM `bigquery-public-data.chicago_crime.crime`
WHERE LOWER(primary_type) LIKE 'motor%'
LIMIT 20;
```

```sql
-- 4. Description: Preview 20 “Motor Vehicle Theft” rows to be sure we are grabbing the right incidents.
SELECT unique_key,
       `date`,
       block,
       primary_type,
       description
FROM `bigquery-public-data.chicago_crime.crime`
WHERE primary_type = 'MOTOR VEHICLE THEFT'
LIMIT 20;
```

```sql
-- 5. Description: Count how many motor thefts happened in every year-month between 2010-2016.
SELECT EXTRACT(YEAR  FROM `date`)  AS yr,
       EXTRACT(MONTH FROM `date`)  AS mo,
       COUNT(*)                    AS motor_thefts
FROM `bigquery-public-data.chicago_crime.crime`
WHERE primary_type = 'MOTOR VEHICLE THEFT'
  AND EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
GROUP BY yr, mo
ORDER BY yr, mo
LIMIT 20;
```

```sql
-- 6. Description: Order the above by the largest monthly counts so we can eyeball the peaks.
SELECT EXTRACT(YEAR  FROM `date`)  AS yr,
       EXTRACT(MONTH FROM `date`)  AS mo,
       COUNT(*)                    AS motor_thefts
FROM `bigquery-public-data.chicago_crime.crime`
WHERE primary_type = 'MOTOR VEHICLE THEFT'
  AND EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
GROUP BY yr, mo
ORDER BY motor_thefts DESC
LIMIT 20;
```

```sql
-- 7. Description: Calculate, for each year 2010-2016, the highest number of motor thefts that occurred in any single month.
SELECT yr AS year,
       MAX(motor_thefts) AS max_motor_thefts_in_one_month
FROM (
    SELECT EXTRACT(YEAR  FROM `date`) AS yr,
           EXTRACT(MONTH FROM `date`) AS mo,
           COUNT(*)                   AS motor_thefts
    FROM `bigquery-public-data.chicago_crime.crime`
    WHERE primary_type = 'MOTOR VEHICLE THEFT'
      AND EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
    GROUP BY yr, mo
)
GROUP BY yr
ORDER BY year
LIMIT 20;
```

```sql
-- 8. Description: (Optional cross-check) Show the actual month that produced the yearly maximum, just to verify.
SELECT *
FROM (
    SELECT yr,
           mo,
           motor_thefts,
           ROW_NUMBER() OVER (PARTITION BY yr ORDER BY motor_thefts DESC) AS rn
    FROM (
        SELECT EXTRACT(YEAR  FROM `date`) AS yr,
               EXTRACT(MONTH FROM `date`) AS mo,
               COUNT(*)                   AS motor_thefts
        FROM `bigquery-public-data.chicago_crime.crime`
        WHERE primary_type = 'MOTOR VEHICLE THEFT'
          AND EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
        GROUP BY yr, mo
    )
)
WHERE rn = 1
ORDER BY yr
LIMIT 20;
```
