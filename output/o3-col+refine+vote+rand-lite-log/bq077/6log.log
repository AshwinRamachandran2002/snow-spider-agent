Query:
-- 8. Description: (Optional cross-check) Show the actual month that produced the yearly maximum, just to verify.
SELECT *
FROM (
    SELECT yr,
           mo,
           motor_thefts,
           ROW_NUMBER() OVER (PARTITION BY yr ORDER BY motor_thefts DESC) AS rn
    FROM (
        SELECT EXTRACT(YEAR  FROM `date`) AS yr,
               EXTRACT(MONTH FROM `date`) AS mo,
               COUNT(*)                   AS motor_thefts
        FROM `bigquery-public-data.chicago_crime.crime`
        WHERE primary_type = 'MOTOR VEHICLE THEFT'
          AND EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
        GROUP BY yr, mo
    )
)
WHERE rn = 1
ORDER BY yr
LIMIT 20;
