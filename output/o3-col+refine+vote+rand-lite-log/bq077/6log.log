Query:
-- 7. Description: Calculate, for each year 2010-2016, the highest number of motor thefts that occurred in any single month.
SELECT yr AS year,
       MAX(motor_thefts) AS max_motor_thefts_in_one_month
FROM (
    SELECT EXTRACT(YEAR  FROM `date`) AS yr,
           EXTRACT(MONTH FROM `date`) AS mo,
           COUNT(*)                   AS motor_thefts
    FROM `bigquery-public-data.chicago_crime.crime`
    WHERE primary_type = 'MOTOR VEHICLE THEFT'
      AND EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
    GROUP BY yr, mo
)
GROUP BY yr
ORDER BY year
LIMIT 20;
Answer:
