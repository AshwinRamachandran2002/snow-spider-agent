Query:
--Description: FINAL ANSWER — highest number of motor-vehicle-theft incidents in any single month for each year 2010-2016.
SELECT EXTRACT(YEAR FROM `date`) AS year,
       MAX(cnt)                  AS highest_monthly_motor_thefts
FROM (
  SELECT `date`,
         COUNT(*) OVER (PARTITION BY EXTRACT(YEAR  FROM `date`),
                                     EXTRACT(MONTH FROM `date`)) AS cnt
  FROM   `bigquery-public-data.chicago_crime.crime`
  WHERE  LOWER(`primary_type`) = 'motor vehicle theft'
    AND  EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
)
GROUP BY year
ORDER BY year
LIMIT 20;
Answer:
year,highest_monthly_motor_thefts
