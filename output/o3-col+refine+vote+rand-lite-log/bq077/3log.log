```sql
--Description: Show 20 sample rows that correspond to motor-vehicle-theft crimes.
SELECT `unique_key`,
       `date`,
       `primary_type`,
       `description`,
       `district`
FROM `bigquery-public-data.chicago_crime.crime`
WHERE LOWER(`primary_type`) = 'motor vehicle theft'
LIMIT 20;
```

```sql
--Description: For 2010 only, count motor thefts by calendar month.
SELECT EXTRACT(MONTH  FROM `date`) AS month,
       COUNT(*)                       AS thefts_2010
FROM   `bigquery-public-data.chicago_crime.crime`
WHERE  LOWER(`primary_type`) = 'motor vehicle theft'
  AND  EXTRACT(YEAR FROM `date`) = 2010
GROUP  BY month
ORDER  BY month
LIMIT 20;
```

```sql
--Description: Count motor-vehicle-theft incidents for every year-month between 2010-2016.
SELECT EXTRACT(YEAR  FROM `date`) AS yr,
       EXTRACT(MONTH FROM `date`) AS mo,
       COUNT(*)                   AS thefts
FROM   `bigquery-public-data.chicago_crime.crime`
WHERE  LOWER(`primary_type`) = 'motor vehicle theft'
  AND  EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
GROUP  BY yr, mo
ORDER  BY yr, mo
LIMIT 20;
```

```sql
--Description: Same as above but return a formatted YYYY-MM string for readability.
SELECT FORMAT_TIMESTAMP('%Y-%m', `date`) AS year_month,
       COUNT(*)                         AS thefts
FROM   `bigquery-public-data.chicago_crime.crime`
WHERE  LOWER(`primary_type`) = 'motor vehicle theft'
  AND  EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
GROUP  BY year_month
ORDER  BY year_month
LIMIT 20;
```

```sql
--Description: Use a window function to attach, to every year-month row, the maximum thefts that year.
WITH ym AS (
  SELECT EXTRACT(YEAR  FROM `date`) AS yr,
         EXTRACT(MONTH FROM `date`) AS mo,
         COUNT(*)                   AS thefts
  FROM   `bigquery-public-data.chicago_crime.crime`
  WHERE  LOWER(`primary_type`) = 'motor vehicle theft'
    AND  EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
  GROUP  BY yr, mo
)
SELECT yr,
       mo,
       thefts,
       MAX(thefts) OVER (PARTITION BY yr) AS yearly_max
FROM   ym
ORDER  BY yr, mo
LIMIT 20;
```

```sql
--Description: Extract only the rows that achieve the yearly maximum using a QUALIFY clause.
WITH ym AS (
  SELECT EXTRACT(YEAR  FROM `date`) AS yr,
         EXTRACT(MONTH FROM `date`) AS mo,
         COUNT(*)                   AS thefts
  FROM   `bigquery-public-data.chicago_crime.crime`
  WHERE  LOWER(`primary_type`) = 'motor vehicle theft'
    AND  EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
  GROUP  BY yr, mo
)
SELECT yr,
       mo,
       thefts
FROM   ym
QUALIFY thefts = MAX(thefts) OVER (PARTITION BY yr)
ORDER  BY yr, mo
LIMIT 20;
```

```sql
--Description: A simpler aggregation: join the year-month counts with their yearly maximums.
WITH year_month AS (
  SELECT EXTRACT(YEAR  FROM `date`) AS yr,
         EXTRACT(MONTH FROM `date`) AS mo,
         COUNT(*)                   AS thefts
  FROM   `bigquery-public-data.chicago_crime.crime`
  WHERE  LOWER(`primary_type`) = 'motor vehicle theft'
    AND  EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
  GROUP  BY yr, mo
),
year_max AS (
  SELECT yr, MAX(thefts) AS max_thefts
  FROM   year_month
  GROUP  BY yr
)
SELECT y.yr,
       y.mo,
       y.thefts AS monthly_thefts,
       m.max_thefts
FROM   year_month AS y
JOIN   year_max   AS m USING (yr)
WHERE  y.thefts = m.max_thefts
ORDER  BY y.yr, y.mo
LIMIT 20;
```

```sql
--Description: FINAL ANSWER — highest number of motor-vehicle-theft incidents in any single month for each year 2010-2016.
SELECT EXTRACT(YEAR FROM `date`) AS year,
       MAX(cnt)                  AS highest_monthly_motor_thefts
FROM (
  SELECT `date`,
         COUNT(*) OVER (PARTITION BY EXTRACT(YEAR  FROM `date`),
                                     EXTRACT(MONTH FROM `date`)) AS cnt
  FROM   `bigquery-public-data.chicago_crime.crime`
  WHERE  LOWER(`primary_type`) = 'motor vehicle theft'
    AND  EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
)
GROUP BY year
ORDER BY year
LIMIT 20;
```

