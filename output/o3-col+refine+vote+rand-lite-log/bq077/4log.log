```

```sql
-- 2. Description: Preview a few rows that are classified as motor-vehicle thefts.
SELECT `case_number`, `date`, `primary_type`, `description`, `location_description`
FROM `bigquery-public-data.chicago_crime.crime`
WHERE LOWER(`primary_type`) = 'motor vehicle theft'
ORDER BY `date` DESC
LIMIT 20;
```

```sql
-- 3. Description: Count monthly motor-vehicle theft incidents city-wide.
SELECT
  EXTRACT(YEAR  FROM `date`)  AS yr,
  EXTRACT(MONTH FROM `date`)  AS mo,
  COUNT(*)                     AS monthly_motor_thefts
FROM `bigquery-public-data.chicago_crime.crime`
WHERE LOWER(`primary_type`) = 'motor vehicle theft'
GROUP BY yr, mo
ORDER BY yr, mo
LIMIT 20;
```

```sql
-- 4. Description: Focus only on the years 2010-2016 and order by the largest monthly totals.
SELECT
  EXTRACT(YEAR  FROM `date`) AS yr,
  EXTRACT(MONTH FROM `date`) AS mo,
  COUNT(*)                   AS monthly_motor_thefts
FROM `bigquery-public-data.chicago_crime.crime`
WHERE LOWER(`primary_type`) = 'motor vehicle theft'
  AND EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
GROUP BY yr, mo
ORDER BY monthly_motor_thefts DESC
LIMIT 20;
```

```sql
-- 5. Description: For each year 2010-2016 find the highest month-level count
--                 (but still list the month to see which one it is).
WITH monthly AS (
  SELECT
    EXTRACT(YEAR  FROM `date`) AS yr,
    EXTRACT(MONTH FROM `date`) AS mo,
    COUNT(*)                   AS monthly_cnt
  FROM `bigquery-public-data.chicago_crime.crime`
  WHERE LOWER(`primary_type`) = 'motor vehicle theft'
    AND EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
  GROUP BY yr, mo
)
SELECT *
FROM monthly
QUALIFY monthly_cnt = MAX(monthly_cnt) OVER (PARTITION BY yr)
ORDER BY yr
LIMIT 20;
```

```sql
-- 6. Description (FINAL ANSWER):  Highest number of motor-vehicle thefts in a single
--                                month for every year 2010-2016.
WITH monthly AS (
  SELECT
    EXTRACT(YEAR  FROM `date`) AS yr,
    COUNT(*)                   AS monthly_cnt
  FROM `bigquery-public-data.chicago_crime.crime`
  WHERE LOWER(`primary_type`) = 'motor vehicle theft'
    AND EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
  GROUP BY yr, EXTRACT(MONTH FROM `date`)
)
SELECT
  yr  AS year,
  MAX(monthly_cnt)  AS highest_monthly_motor_thefts
FROM monthly
GROUP BY yr
ORDER BY yr
LIMIT 20;
```
