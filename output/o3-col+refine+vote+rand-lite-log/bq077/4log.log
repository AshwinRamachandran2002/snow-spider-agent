-- 6. Description (FINAL ANSWER):  Highest number of motor-vehicle thefts in a single
--                                month for every year 2010-2016.
WITH monthly AS (
  SELECT
    EXTRACT(YEAR  FROM `date`) AS yr,
    COUNT(*)                   AS monthly_cnt
  FROM `bigquery-public-data.chicago_crime.crime`
  WHERE LOWER(`primary_type`) = 'motor vehicle theft'
    AND EXTRACT(YEAR FROM `date`) BETWEEN 2010 AND 2016
  GROUP BY yr, EXTRACT(MONTH FROM `date`)
)
SELECT
  yr  AS year,
  MAX(monthly_cnt)  AS highest_monthly_motor_thefts
