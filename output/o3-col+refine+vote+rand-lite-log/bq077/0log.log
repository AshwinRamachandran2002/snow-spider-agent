```sql
--Description: 1) Peek at some 2010 crime records that are motor-vehicle thefts
SELECT
  unique_key,
  date,
  primary_type,
  description,
  location_description
FROM `bigquery-public-data.chicago_crime.crime`
WHERE primary_type = 'MOTOR VEHICLE THEFT'
  AND EXTRACT(YEAR FROM date) = 2010
LIMIT 20;
```

```sql
--Description: 2) See all distinct values of PRIMARY_TYPE that contain the word “motor”
SELECT DISTINCT primary_type
FROM `bigquery-public-data.chicago_crime.crime`
WHERE LOWER(primary_type) LIKE '%motor%'
LIMIT 20;
```

```sql
--Description: 3) Quick yearly counts (2010-2016) of motor-vehicle thefts
SELECT
  EXTRACT(YEAR FROM date) AS yr,
  COUNT(*) AS thefts
FROM `bigquery-public-data.chicago_crime.crime`
WHERE primary_type = 'MOTOR VEHICLE THEFT'
  AND EXTRACT(YEAR FROM date) BETWEEN 2010 AND 2016
GROUP BY yr
ORDER BY yr
LIMIT 20;
```

```sql
--Description: 4) Monthly counts for 2010 to see the shape of the data
SELECT
  EXTRACT(MONTH FROM date) AS mo,
  COUNT(*) AS thefts_in_month
FROM `bigquery-public-data.chicago_crime.crime`
WHERE primary_type = 'MOTOR VEHICLE THEFT'
  AND EXTRACT(YEAR FROM date) = 2010
GROUP BY mo
ORDER BY mo
LIMIT 20;
```

```sql
--Description: 5) Monthly counts for every year from 2010-2016
SELECT
  EXTRACT(YEAR  FROM date) AS yr,
  EXTRACT(MONTH FROM date) AS mo,
  COUNT(*) AS thefts_in_month
FROM `bigquery-public-data.chicago_crime.crime`
WHERE primary_type = 'MOTOR VEHICLE THEFT'
  AND EXTRACT(YEAR FROM date) BETWEEN 2010 AND 2016
GROUP BY yr, mo
ORDER BY yr, mo
LIMIT 20;
```

```sql
--Description: 6) Which month had the most motor thefts in 2013?
SELECT
  EXTRACT(MONTH FROM date) AS mo,
  COUNT(*) AS thefts_in_month
FROM `bigquery-public-data.chicago_crime.crime`
WHERE primary_type = 'MOTOR VEHICLE THEFT'
  AND EXTRACT(YEAR FROM date) = 2013
GROUP BY mo
ORDER BY thefts_in_month DESC
LIMIT 20;
```

```sql
--Description: 7) Using a window to tag each (year, month) row with that year’s maximum
SELECT
  yr,
  mo,
  thefts_in_month,
  MAX(thefts_in_month) OVER (PARTITION BY yr) AS max_in_year
FROM (
  SELECT
    EXTRACT(YEAR  FROM date) AS yr,
    EXTRACT(MONTH FROM date) AS mo,
    COUNT(*) AS thefts_in_month
  FROM `bigquery-public-data.chicago_crime.crime`
  WHERE primary_type = 'MOTOR VEHICLE THEFT'
    AND EXTRACT(YEAR FROM date) BETWEEN 2010 AND 2016
  GROUP BY yr, mo
) t
ORDER BY yr, mo
LIMIT 20;
```

```sql
--Description: 8) FINAL ANSWER – for each year 2010-2016, the highest number of motor-vehicle thefts observed in a single month
SELECT
  yr AS year,
  MAX(thefts_in_month) AS highest_monthly_motor_thefts
FROM (
  SELECT
    EXTRACT(YEAR  FROM date)  AS yr,
    EXTRACT(MONTH FROM date)  AS mo,
    COUNT(*)                  AS thefts_in_month
  FROM `bigquery-public-data.chicago_crime.crime`
  WHERE primary_type = 'MOTOR VEHICLE THEFT'
    AND EXTRACT(YEAR FROM date) BETWEEN 2010 AND 2016
  GROUP BY yr, mo
) m
GROUP BY yr
ORDER BY yr;
```
