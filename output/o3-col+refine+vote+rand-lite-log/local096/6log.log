Query:
--Description: 6) List movies whose casts are exclusively female (no male / unknown actors), again matching PIDs after removing spaces.
SELECT m."MID",
       m."title"
FROM (
        SELECT m."MID",
               SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END)                         AS "female_cnt",
               SUM(CASE WHEN p."Gender" <> 'Female' OR p."Gender" IS NULL THEN 1 ELSE 0 END)  AS "non_female_cnt"
        FROM   "Movie"  AS m
        JOIN   "M_Cast" AS mc
               ON m."MID" = mc."MID"
        LEFT  JOIN "Person" AS p
               ON REPLACE(mc."PID", ' ', '') = REPLACE(p."PID", ' ', '')
        GROUP  BY m."MID"
     ) AS x
JOIN "Movie" AS m
     ON m."MID" = x."MID"
WHERE x."female_cnt" > 0
  AND x."non_female_cnt" = 0
LIMIT 20
