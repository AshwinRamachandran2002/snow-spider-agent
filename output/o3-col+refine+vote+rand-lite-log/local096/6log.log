--Description: 8) For each year, count how many movies have exclusively female casts, with cleaned PID matching.
WITH per_movie AS (
    SELECT m."MID",
           CAST(SUBSTR(m."year", -4) AS INTEGER)                                   AS "yr",
           SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END)                  AS "female_cnt",
           SUM(CASE WHEN p."Gender" <> 'Female' OR p."Gender" IS NULL THEN 1 ELSE 0 END) AS "non_female_cnt"
    FROM   "Movie"  AS m
    JOIN   "M_Cast" AS mc
           ON m."MID" = mc."MID"
    LEFT  JOIN "Person" AS p
           ON REPLACE(mc."PID", ' ', '') = REPLACE(p."PID", ' ', '')
    GROUP  BY m."MID"
)
SELECT "yr",
       COUNT(*) AS "exclusive_female_movies"
FROM   per_movie
WHERE  "female_cnt" > 0
  AND  "non_female_cnt" = 0
GROUP  BY "yr"
LIMIT 20
