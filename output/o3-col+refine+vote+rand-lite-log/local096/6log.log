```

```sql
--Description: 4) Check one concrete movie’s entire cast (first movie in table) and the genders.
SELECT m."title",
       mc."PID",
       p."Name",
       p."Gender"
FROM   "Movie"   AS m
JOIN   "M_Cast"  AS mc ON m."MID" = mc."MID"
JOIN   "Person"  AS p  ON mc."PID" = p."PID"
WHERE  m."MID" = (SELECT "MID" FROM "Movie" LIMIT 1)
LIMIT 20;
```

```sql
--Description: 5) For each movie, count how many female vs. non-female (male or None) actors it has.
SELECT m."MID",
       m."title",
       SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END)        AS "female_cnt",
       SUM(CASE WHEN p."Gender" <> 'Female' THEN 1 ELSE 0 END)       AS "non_female_cnt"
FROM   "Movie"   AS m
JOIN   "M_Cast"  AS mc ON m."MID" = mc."MID"
JOIN   "Person"  AS p  ON mc."PID" = p."PID"
GROUP  BY m."MID"
LIMIT 20;
```

```sql
--Description: 6) List movies whose cast is exclusively female (non-female_cnt = 0 and at least one female).
SELECT m."MID",
       m."title"
FROM (
        SELECT m."MID",
               SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END)      AS "female_cnt",
               SUM(CASE WHEN p."Gender" <> 'Female' THEN 1 ELSE 0 END)     AS "non_female_cnt"
        FROM   "Movie"   AS m
        JOIN   "M_Cast"  AS mc ON m."MID" = mc."MID"
        JOIN   "Person"  AS p  ON mc."PID" = p."PID"
        GROUP  BY m."MID"
     ) AS x
JOIN "Movie" AS m ON m."MID" = x."MID"
WHERE x."female_cnt" > 0
  AND x."non_female_cnt" = 0
LIMIT 20;
```

```sql
--Description: 7) Count the total number of movies released in each year.
SELECT CAST(SUBSTR("year", -4) AS INTEGER) AS "year",
       COUNT(*)                                   AS "total_movies"
FROM   "Movie"
GROUP  BY "year"
LIMIT 20;
```

```sql
--Description: 8) Count, for each year, how many movies have exclusively female casts.
WITH per_movie AS (
    SELECT m."MID",
           CAST(SUBSTR(m."year", -4) AS INTEGER)                  AS "yr",
           SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END) AS "female_cnt",
           SUM(CASE WHEN p."Gender" <> 'Female' THEN 1 ELSE 0 END) AS "non_female_cnt"
    FROM   "Movie"   AS m
    JOIN   "M_Cast"  AS mc ON m."MID" = mc."MID"
    JOIN   "Person"  AS p  ON mc."PID" = p."PID"
    GROUP  BY m."MID"
)
SELECT "yr",
       COUNT(*)                                        AS "exclusive_female_movies"
FROM   per_movie
WHERE  "female_cnt" > 0
  AND  "non_female_cnt" = 0
GROUP  BY "yr"
LIMIT 20;
```

```sql
--Description: 9) Final answer – for each year, show total movies and the percentage that are exclusively female.
WITH per_movie AS (
    SELECT m."MID",
           CAST(SUBSTR(m."year", -4) AS INTEGER)                  AS "yr",
           SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END)  AS "female_cnt",
           SUM(CASE WHEN p."Gender" <> 'Female' THEN 1 ELSE 0 END) AS "non_female_cnt"
    FROM   "Movie"   AS m
    JOIN   "M_Cast"  AS mc ON m."MID" = mc."MID"
    JOIN   "Person"  AS p  ON mc."PID" = p."PID"
    GROUP  BY m."MID"
), per_year AS (
    SELECT "yr",
           COUNT(*)                                                   AS "total_movies",
           SUM(CASE WHEN "female_cnt" > 0 AND "non_female_cnt" = 0
                    THEN 1 ELSE 0 END)                                AS "exclusive_female_movies"
    FROM   per_movie
    GROUP  BY "yr"
)
SELECT "yr"                                                    AS "year",
       "total_movies",
       ROUND(100.0 * "exclusive_female_movies" / "total_movies", 2) AS "pct_exclusive_female"
FROM   per_year
ORDER  BY "year"
LIMIT 20;
```
