Query:
--Description: 7) Count TOTAL number of movies released each year (extract last 4 chars from Movie.year)
SELECT CAST(SUBSTR("year", -4) AS INTEGER) AS rel_year,
       COUNT(*) AS total_movies
FROM   "Movie"
GROUP  BY rel_year
LIMIT 20
