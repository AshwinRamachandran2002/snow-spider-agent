Query:
--Description: 8) Count the number of exclusively-female-cast movies in each year; TRIM the PID for accurate joins
WITH only_female AS (
     SELECT mc."MID"
     FROM   "M_Cast" AS mc
     JOIN   "Person" AS p ON TRIM(mc."PID") = p."PID"
     GROUP  BY mc."MID"
     HAVING MAX(CASE WHEN p."Gender" = 'Female' THEN 0 ELSE 1 END) = 0
)
SELECT CAST(SUBSTR(m."year", -4) AS INTEGER) AS rel_year,
       COUNT(*) AS female_only_movies
FROM   "Movie" AS m
JOIN   only_female AS f ON m."MID" = f."MID"
GROUP  BY rel_year
LIMIT 20
Answer:
rel_year,female_only_movies
1939,1
1999,1
2000,1
2018,1
Query:
--Description: 9) Final report: for each year show total movies and the percentage that are exclusively female-cast, with TRIM applied on PID wherever we join through M_Cast
WITH only_female AS (
     SELECT mc."MID"
     FROM   "M_Cast" AS mc
     JOIN   "Person" AS p ON TRIM(mc."PID") = p."PID"
     GROUP  BY mc."MID"
     HAVING MAX(CASE WHEN p."Gender" = 'Female' THEN 0 ELSE 1 END) = 0
),
total_per_year AS (
     SELECT CAST(SUBSTR("year", -4) AS INTEGER) AS rel_year,
            COUNT(*) AS total_movies
     FROM   "Movie"
     GROUP  BY rel_year
),
female_per_year AS (
     SELECT CAST(SUBSTR(m."year", -4) AS INTEGER) AS rel_year,
            COUNT(*) AS female_only_movies
     FROM   "Movie" AS m
     JOIN   only_female AS f ON m."MID" = f."MID"
     GROUP  BY rel_year
)
SELECT t.rel_year,
       t.total_movies,
       ROUND(100.0 * COALESCE(f.female_only_movies, 0) / t.total_movies, 2) AS female_only_pct
FROM   total_per_year AS t
LEFT  JOIN female_per_year AS f USING (rel_year)
ORDER BY t.rel_year
LIMIT 20
