```sql
--Description:  To link the tables correctly we must trim the leading blank that appears in many M_Cast.PID values.  
--1. cast_gender CTE:  for every movie, flag whether its cast contains at least one non-female performer (Gender <> 'Female').  
--2. stats CTE:  join cast_gender to Movie, extract the numeric year with SUBSTR(...,-4), count total movies and how many are “female-only”.  
--3. Final SELECT:  compute the percentage of female-only movies per year, rounded to two decimals.
WITH cast_gender AS (
        SELECT mc."MID",
               MAX(CASE WHEN p."Gender" <> 'Female' THEN 1 ELSE 0 END) AS has_non_female
        FROM   "M_Cast"  AS mc
        JOIN   "Person"  AS p  ON TRIM(mc."PID") = p."PID"
        GROUP  BY mc."MID"
),
stats AS (
        SELECT CAST(SUBSTR(m."year", -4) AS INTEGER)              AS year,
               COUNT(*)                                           AS total_movies,
               SUM(CASE WHEN cg.has_non_female = 0 THEN 1 ELSE 0 END) AS female_only_movies
        FROM   "Movie"      AS m
        LEFT JOIN cast_gender AS cg ON m."MID" = cg."MID"
        GROUP  BY year
)
SELECT year,
       total_movies,
       ROUND(100.0 * female_only_movies / total_movies, 2) AS female_only_pct
FROM   stats
ORDER BY year;
```
