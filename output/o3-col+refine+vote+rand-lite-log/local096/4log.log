Query:
--Description: 6) List movies whose casts are EXCLUSIVELY female (i.e., no non-female actors); TRIM used in the join
SELECT m."title",
       mc_fem."MID"
FROM   (
        SELECT mc."MID"
        FROM   "M_Cast" AS mc
        JOIN   "Person" AS p ON TRIM(mc."PID") = p."PID"
        GROUP  BY mc."MID"
        HAVING MAX(CASE WHEN p."Gender" = 'Female' THEN 0 ELSE 1 END) = 0
       ) AS mc_fem
JOIN   "Movie" AS m ON m."MID" = mc_fem."MID"
LIMIT 20
