```sql
-- Description: 1) Inspect the different formats stored in Movie.year
SELECT DISTINCT "year"
FROM "Movie"
LIMIT 20;
```

```sql
-- Description: 2) Look at some links between movies and actors in the cast table
SELECT DISTINCT "MID", "PID"
FROM "M_Cast"
LIMIT 20;
```

```sql
-- Description: 3) Check a few people and their recorded gender values
SELECT DISTINCT "PID", "Name", "Gender"
FROM "Person"
LIMIT 20;
```

```sql
-- Description: 4) Join Movie-Cast-Person to see each actor’s gender in a movie
SELECT m."title",
       mc."MID",
       p."Name",
       p."Gender"
FROM   "Movie"      AS m
JOIN   "M_Cast"     AS mc ON m."MID" = mc."MID"
JOIN   "Person"     AS p  ON mc."PID" = p."PID"
LIMIT 20;
```

```sql
-- Description: 5) For every movie, count how many non-female actors it has
SELECT mc."MID",
       SUM(CASE WHEN p."Gender" = 'Female' THEN 0 ELSE 1 END) AS non_female_cnt
FROM   "M_Cast" AS mc
JOIN   "Person" AS p ON mc."PID" = p."PID"
GROUP  BY mc."MID"
LIMIT 20;
```

```sql
-- Description: 6) List movies whose casts are exclusively female (non_female_cnt = 0)
SELECT m."title",
       mc_cnt."MID"
FROM   (
        SELECT mc."MID"
        FROM   "M_Cast" AS mc
        JOIN   "Person" AS p ON mc."PID" = p."PID"
        GROUP  BY mc."MID"
        HAVING MAX(CASE WHEN p."Gender" = 'Female' THEN 0 ELSE 1 END) = 0
       ) AS mc_cnt
JOIN   "Movie" AS m ON m."MID" = mc_cnt."MID"
LIMIT 20;
```

```sql
-- Description: 7) Count total number of movies released each year
SELECT CAST(substr(m."year", -4) AS INTEGER) AS rel_year,
       COUNT(*) AS total_movies
FROM   "Movie" AS m
GROUP  BY rel_year
LIMIT 20;
```

```sql
-- Description: 8) Count number of exclusively-female-cast movies in each year
WITH only_female AS (
     SELECT mc."MID"
     FROM   "M_Cast" AS mc
     JOIN   "Person" AS p ON mc."PID" = p."PID"
     GROUP  BY mc."MID"
     HAVING MAX(CASE WHEN p."Gender" = 'Female' THEN 0 ELSE 1 END) = 0
)
SELECT CAST(substr(m."year", -4) AS INTEGER) AS rel_year,
       COUNT(*) AS female_only_movies
FROM   "Movie" AS m
JOIN   only_female AS f ON m."MID" = f."MID"
GROUP  BY rel_year
LIMIT 20;
```

```sql
-- Description: 9) Final: for every year, show total movies and percentage that are exclusively female-cast
WITH
-- movies that are female-only
only_female AS (
     SELECT mc."MID"
     FROM   "M_Cast" AS mc
     JOIN   "Person" AS p ON mc."PID" = p."PID"
     GROUP  BY mc."MID"
     HAVING MAX(CASE WHEN p."Gender" = 'Female' THEN 0 ELSE 1 END) = 0
),
-- total movies per extracted year
total_per_year AS (
     SELECT CAST(substr("year", -4) AS INTEGER) AS rel_year,
            COUNT(*) AS total_movies
     FROM   "Movie"
     GROUP  BY rel_year
),
-- female-only movies per year
female_per_year AS (
     SELECT CAST(substr(m."year", -4) AS INTEGER) AS rel_year,
            COUNT(*) AS female_only_movies
     FROM   "Movie" AS m
     JOIN   only_female AS f ON m."MID" = f."MID"
     GROUP  BY rel_year
)
SELECT t.rel_year,
       t.total_movies,
       ROUND(100.0 * COALESCE(f.female_only_movies, 0) / t.total_movies, 2) AS female_only_pct
FROM   total_per_year AS t
LEFT JOIN female_per_year AS f USING (rel_year)
ORDER BY t.rel_year
LIMIT 20;
```
