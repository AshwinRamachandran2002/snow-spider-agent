```sql
-- 1) Quick look at the different values stored in Movie.year
SELECT DISTINCT "year"
FROM "Movie"
LIMIT 20;
```

```sql
-- 2) Check which gender values exist in the Person table
SELECT DISTINCT "Gender"
FROM "Person"
LIMIT 20;
```

```sql
-- 3) See how genders are distributed for a few movies
SELECT mc."MID",
       p."Gender",
       COUNT(*) AS gender_cnt
FROM "M_Cast" AS mc
JOIN "Person" AS p
  ON mc."PID" = p."PID"
GROUP BY mc."MID", p."Gender"
LIMIT 20;
```

```sql
-- 4) For every movie, count female vs. non-female (male or unknown) actors
SELECT mc."MID",
       SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END)        AS female_cnt,
       SUM(CASE WHEN p."Gender" != 'Female' OR p."Gender" IS NULL
                THEN 1 ELSE 0 END)                                   AS non_female_cnt
FROM "M_Cast" AS mc
JOIN "Person" AS p
  ON mc."PID" = p."PID"
GROUP BY mc."MID"
LIMIT 20;
```

```sql
-- 5) Mark every movie as 1 = “exclusively-female cast”, 0 = otherwise
SELECT m."MID",
       m."title",
       CASE WHEN t.non_female_cnt = 0
                 AND t.female_cnt  > 0
            THEN 1 ELSE 0 END                                        AS exclusively_female
FROM "Movie" AS m
LEFT JOIN (
        SELECT mc."MID",
               SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END)        AS female_cnt,
               SUM(CASE WHEN p."Gender" != 'Female' OR p."Gender" IS NULL
                        THEN 1 ELSE 0 END)                                   AS non_female_cnt
        FROM "M_Cast" AS mc
        JOIN "Person" AS p
          ON mc."PID" = p."PID"
        GROUP BY mc."MID"
) AS t
  ON m."MID" = t."MID"
LIMIT 20;
```

```sql
-- 6) Total number of movies released each year
SELECT CAST(substr(m."year", length(m."year")-3, 4) AS INTEGER)      AS yr,
       COUNT(*)                                                      AS total_movies
FROM   "Movie" AS m
GROUP  BY yr
LIMIT 20;
```

```sql
-- 7) Number of “exclusively-female cast” movies per year
SELECT CAST(substr(m."year", length(m."year")-3, 4) AS INTEGER)      AS yr,
       SUM(CASE WHEN ef.exclusively_female = 1 THEN 1 ELSE 0 END)    AS exclusive_movies
FROM   "Movie" AS m
JOIN  (
        SELECT mc."MID",
               CASE WHEN SUM(CASE WHEN p."Gender" != 'Female'
                                    OR p."Gender" IS NULL THEN 1 ELSE 0 END) = 0
                      AND SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END) > 0
                    THEN 1 ELSE 0 END                                AS exclusively_female
        FROM   "M_Cast"  AS mc
        JOIN   "Person"  AS p
          ON   mc."PID" = p."PID"
        GROUP BY mc."MID"
) AS ef
  ON m."MID" = ef."MID"
GROUP BY yr
LIMIT 20;
```

```sql
-- 8) FINAL ANSWER – year, total movies, % with exclusively female actors
SELECT yr                                   AS year,
       total_movies,
       ROUND(100.0 * exclusive_movies / total_movies, 2) AS exclusive_female_percentage
FROM (
        SELECT CAST(substr(m."year", length(m."year")-3, 4) AS INTEGER) AS yr,
               COUNT(*)                                                AS total_movies,
               SUM(CASE WHEN ef.exclusively_female = 1 THEN 1 ELSE 0 END)
                                                                      AS exclusive_movies
        FROM   "Movie" AS m
        LEFT JOIN (
                    SELECT mc."MID",
                           CASE WHEN SUM(CASE WHEN p."Gender" != 'Female'
                                                OR p."Gender" IS NULL THEN 1 ELSE 0 END) = 0
                                  AND SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END) > 0
                                THEN 1 ELSE 0 END                     AS exclusively_female
                    FROM   "M_Cast"  AS mc
                    JOIN   "Person"  AS p
                      ON   mc."PID" = p."PID"
                    GROUP BY mc."MID"
                  ) AS ef
           ON m."MID" = ef."MID"
        GROUP BY yr
) AS x
ORDER BY year
LIMIT 20;
```
