Query:
--Description: #5 – Label every movie (1/0) as having an exclusively-female cast; the inner subquery
--              produces female & non-female counts with the TRIM()-corrected join.
SELECT m."MID",
       m."title",
       CASE WHEN t.non_female_cnt = 0 AND t.female_cnt > 0 THEN 1 ELSE 0 END   AS exclusively_female
FROM   "Movie" AS m
LEFT JOIN (
        SELECT mc."MID",
               SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END)                                              AS female_cnt,
               SUM(CASE WHEN p."Gender" != 'Female' OR p."Gender" = '' OR p."Gender" IS NULL THEN 1 ELSE 0 END)    AS non_female_cnt
        FROM   "M_Cast" AS mc
        JOIN   "Person" AS p
               ON TRIM(mc."PID") = TRIM(p."PID")
        GROUP  BY mc."MID"
) AS t
       ON m."MID" = t."MID"
LIMIT 20
