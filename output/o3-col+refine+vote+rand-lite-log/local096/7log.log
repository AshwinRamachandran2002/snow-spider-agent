Query:
--Description: #8 – Final answer: year, total movies, and percentage that are exclusively-female;
--              relies on the corrected TRIM() join inside the nested subquery.
SELECT yr                                                             AS year,
       total_movies,
       ROUND(100.0 * exclusive_movies / total_movies, 2)              AS exclusive_female_percentage
FROM (
        SELECT CAST(substr(m."year", length(m."year") - 3, 4) AS INTEGER)                  AS yr,
               COUNT(*)                                                                          AS total_movies,
               SUM(CASE WHEN ef.exclusively_female = 1 THEN 1 ELSE 0 END)                       AS exclusive_movies
        FROM   "Movie" AS m
        LEFT JOIN (
                    SELECT mc."MID",
                           CASE WHEN SUM(CASE WHEN p."Gender" != 'Female' OR p."Gender" = '' OR p."Gender" IS NULL THEN 1 ELSE 0 END) = 0
                                 AND SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END) > 0
                                THEN 1 ELSE 0 END                                               AS exclusively_female
                    FROM   "M_Cast"  AS mc
                    JOIN   "Person"  AS p
                           ON TRIM(mc."PID") = TRIM(p."PID")
                    GROUP BY mc."MID"
                  ) AS ef
               ON m."MID" = ef."MID"
        GROUP BY yr
) AS x
ORDER BY year
LIMIT 20
