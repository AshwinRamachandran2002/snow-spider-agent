Query:
--Description: #7 – Count how many exclusively-female movies appear in each year; the derived table
--              “ef” marks movies as exclusive using TRIM()-corrected joins.
SELECT CAST(substr(m."year", length(m."year") - 3, 4) AS INTEGER)              AS yr,
       SUM(CASE WHEN ef.exclusively_female = 1 THEN 1 ELSE 0 END)              AS exclusive_movies
FROM   "Movie" AS m
JOIN  (
        SELECT mc."MID",
               CASE WHEN SUM(CASE WHEN p."Gender" != 'Female' OR p."Gender" = '' OR p."Gender" IS NULL THEN 1 ELSE 0 END) = 0
                     AND SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END) > 0
                    THEN 1 ELSE 0 END                                          AS exclusively_female
        FROM   "M_Cast"  AS mc
        JOIN   "Person"  AS p
               ON TRIM(mc."PID") = TRIM(p."PID")
        GROUP  BY mc."MID"
) AS ef
       ON m."MID" = ef."MID"
GROUP BY yr
LIMIT 20
