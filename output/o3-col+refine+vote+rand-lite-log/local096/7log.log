--Description: #4 – For each movie, count its female actors and its non-female actors (male, blank, or NULL);
--              uses TRIM() on PID fields so the join between M_Cast and Person works.
SELECT mc."MID",
       SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END)                                              AS female_cnt,
       SUM(CASE WHEN p."Gender" != 'Female' OR p."Gender" = '' OR p."Gender" IS NULL THEN 1 ELSE 0 END)    AS non_female_cnt
FROM   "M_Cast"  AS mc
JOIN   "Person"  AS p
       ON TRIM(mc."PID") = TRIM(p."PID")
GROUP  BY mc."MID"
LIMIT 20
