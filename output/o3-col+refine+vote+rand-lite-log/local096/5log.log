Query:
-- Description: For the year 2018, compare total movies vs. movies with exclusively female casts,
--              using TRIM in all joins to ensure correct PID matching.
WITH year_movies AS (
    SELECT "MID"
    FROM "Movie"
    WHERE CAST(substr("year", -4) AS INTEGER) = 2018
),
female_only AS (
    SELECT t."MID"
    FROM (
        SELECT mc."MID",
               SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END) AS "female_cnt",
               SUM(CASE WHEN p."Gender" = 'Male'   THEN 1 ELSE 0 END) AS "male_cnt",
               SUM(CASE WHEN p."Gender" IS NULL OR p."Gender" = 'None' THEN 1 ELSE 0 END) AS "unknown_cnt"
        FROM "M_Cast" AS mc
        JOIN "Person" AS p
          ON TRIM(mc."PID") = p."PID"
        GROUP BY mc."MID"
    ) AS t
    WHERE t."male_cnt" = 0
      AND t."unknown_cnt" = 0
)
SELECT (SELECT COUNT(*) FROM year_movies) AS "total_movies_2018",
       (SELECT COUNT(*) FROM female_only) AS "female_only_2018"
