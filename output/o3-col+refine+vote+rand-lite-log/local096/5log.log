```sql
-- Description: Inspect a sample of cast assignments to understand what movie IDs (MID) and person IDs (PID) look like.
SELECT *
FROM "M_Cast"
LIMIT 20;
```

```sql
-- Description: Inspect a sample of people (actors / actresses) together with their gender codes.
SELECT "PID", "Name", "Gender"
FROM "Person"
LIMIT 20;
```

```sql
-- Description: Join cast with person to see, for some movies, which gender each cast member has.
SELECT mc."MID",
       p."PID",
       TRIM(p."Name")                 AS "Person_Name",
       p."Gender"
FROM "M_Cast" AS mc
JOIN "Person" AS p
  ON mc."PID" = p."PID"
LIMIT 20;
```

```sql
-- Description: For a small sample of movies, count how many male / female / unknown ('None') cast members each movie has.
SELECT mc."MID",
       SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END) AS "female_cnt",
       SUM(CASE WHEN p."Gender" = 'Male'   THEN 1 ELSE 0 END) AS "male_cnt",
       SUM(CASE WHEN p."Gender" IS NULL OR p."Gender" = 'None' THEN 1 ELSE 0 END) AS "unknown_cnt"
FROM "M_Cast" AS mc
JOIN "Person" AS p
  ON mc."PID" = p."PID"
GROUP BY mc."MID"
LIMIT 20;
```

```sql
-- Description: Identify movies that (within this limited sample) have ONLY female actors and no male/unknown; useful to see structure of the final target data.
SELECT t."MID"
FROM (
    SELECT mc."MID",
           SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END) AS "female_cnt",
           SUM(CASE WHEN p."Gender" = 'Male'   THEN 1 ELSE 0 END) AS "male_cnt",
           SUM(CASE WHEN p."Gender" IS NULL OR p."Gender" = 'None' THEN 1 ELSE 0 END) AS "unknown_cnt"
    FROM "M_Cast" AS mc
    JOIN "Person" AS p
      ON mc."PID" = p."PID"
    GROUP BY mc."MID"
) AS t
WHERE t."male_cnt" = 0
  AND t."unknown_cnt" = 0
LIMIT 20;
```

```sql
-- Description: For a given year (e.g. 2018), see how many total movies there are versus how many have exclusively female casts. (Change the year to explore others.)
WITH year_movies AS (
    SELECT "MID"
    FROM "Movie"
    WHERE CAST(substr("year", -4) AS INTEGER) = 2018
),
female_only AS (
    SELECT t."MID"
    FROM (
        SELECT mc."MID",
               SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END) AS "female_cnt",
               SUM(CASE WHEN p."Gender" = 'Male'   THEN 1 ELSE 0 END) AS "male_cnt",
               SUM(CASE WHEN p."Gender" IS NULL OR p."Gender" = 'None' THEN 1 ELSE 0 END) AS "unknown_cnt"
        FROM "M_Cast" AS mc
        JOIN "Person" AS p
          ON mc."PID" = p."PID"
        GROUP BY mc."MID"
    ) AS t
    WHERE t."male_cnt" = 0
      AND t."unknown_cnt" = 0
)
SELECT (SELECT COUNT(*) FROM year_movies)          AS "total_movies_2018",
       (SELECT COUNT(*) FROM female_only)          AS "female_only_2018";
```
