Query:
-- Description: List movies that have ONLY female actors (no male / unknown), 
--              with the join corrected via TRIM on M_Cast.PID.
SELECT t."MID"
FROM (
    SELECT mc."MID",
           SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END) AS "female_cnt",
           SUM(CASE WHEN p."Gender" = 'Male'   THEN 1 ELSE 0 END) AS "male_cnt",
           SUM(CASE WHEN p."Gender" IS NULL OR p."Gender" = 'None' THEN 1 ELSE 0 END) AS "unknown_cnt"
    FROM "M_Cast" AS mc
    JOIN "Person" AS p
      ON TRIM(mc."PID") = p."PID"
    GROUP BY mc."MID"
) AS t
WHERE t."male_cnt" = 0
  AND t."unknown_cnt" = 0
LIMIT 20
