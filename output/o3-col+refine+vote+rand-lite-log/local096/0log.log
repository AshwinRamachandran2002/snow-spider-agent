Query:
--Description: Retrieve every movie whose entire cast is exclusively marked ‘Female’.  
--TRIM is applied to align Person-IDs between M_Cast and Person.
SELECT mc."MID"
FROM   "M_Cast" AS mc
JOIN   "Person" AS p ON TRIM(mc."PID") = TRIM(p."PID")
GROUP  BY mc."MID"
HAVING SUM(CASE WHEN p."Gender" <> 'Female' THEN 1 ELSE 0 END) = 0
LIMIT 20
