Query:
--Description: Count the total number of movies released in each year (last four characters of Movie.year).
SELECT CAST(SUBSTR("year", -4) AS INTEGER) AS "Year",
       COUNT(*) AS "Total_Movies"
FROM   "Movie"
GROUP  BY "Year"
ORDER  BY "Year"
LIMIT 20
