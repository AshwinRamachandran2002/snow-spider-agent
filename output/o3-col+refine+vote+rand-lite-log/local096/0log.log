```sql
-- 1. Inspect different year values recorded in Movie.year
SELECT DISTINCT SUBSTR("year", -4) AS "Year"
FROM "Movie"
LIMIT 20;
```

```sql
-- 2. Look at the distinct genders recorded in Person table
SELECT DISTINCT "Gender"
FROM "Person"
LIMIT 20;
```

```sql
-- 3. Preview how cast members are linked to their genders (first 20 rows)
SELECT mc."MID",
       mc."PID",
       p."Name",
       p."Gender"
FROM "M_Cast" AS mc
JOIN "Person" AS p
  ON mc."PID" = p."PID"
LIMIT 20;
```

```sql
-- 4. For one sample title, list all cast genders to verify logic
SELECT mo."title",
       p."Gender"
FROM "Movie"  AS mo
JOIN "M_Cast" AS mc ON mo."MID" = mc."MID"
JOIN "Person" AS p  ON mc."PID" = p."PID"
WHERE mo."title" = 'Mowgli'
LIMIT 20;
```

```sql
-- 5. Find every movie whose entire cast is marked strictly 'Female'
SELECT mc."MID"
FROM "M_Cast" AS mc
JOIN "Person" AS p ON mc."PID" = p."PID"
GROUP BY mc."MID"
HAVING SUM(CASE WHEN p."Gender" <> 'Female' THEN 1 ELSE 0 END) = 0
LIMIT 20;
```

```sql
-- 6. Count total number of movies released in each year
SELECT CAST(SUBSTR("year", -4) AS INTEGER) AS "Year",
       COUNT(*) AS "Total_Movies"
FROM "Movie"
GROUP BY "Year"
ORDER BY "Year"
LIMIT 20;
```

```sql
-- 7. Count movies with exclusively female actors in each year
WITH female_only AS (
    SELECT mc."MID"
    FROM "M_Cast" AS mc
    JOIN "Person" AS p ON mc."PID" = p."PID"
    GROUP BY mc."MID"
    HAVING SUM(CASE WHEN p."Gender" <> 'Female' THEN 1 ELSE 0 END) = 0
)
SELECT CAST(SUBSTR(mo."year", -4) AS INTEGER) AS "Year",
       COUNT(*) AS "Female_Only_Movies"
FROM   "Movie" AS mo
JOIN   female_only AS fo ON mo."MID" = fo."MID"
GROUP  BY "Year"
ORDER  BY "Year"
LIMIT 20;
```

```sql
-- 8. FINAL ANSWER: For every year, show total movies and percentage with exclusively female actors
WITH female_only AS (
    SELECT mc."MID"
    FROM "M_Cast" AS mc
    JOIN "Person" AS p ON mc."PID" = p."PID"
    GROUP BY mc."MID"
    HAVING SUM(CASE WHEN p."Gender" <> 'Female' THEN 1 ELSE 0 END) = 0
),
movies_per_year AS (
    SELECT CAST(SUBSTR("year", -4) AS INTEGER) AS yr,
           COUNT(*) AS total_movies
    FROM "Movie"
    GROUP BY yr
),
female_movies_per_year AS (
    SELECT CAST(SUBSTR(mo."year", -4) AS INTEGER) AS yr,
           COUNT(*) AS female_only_movies
    FROM "Movie" AS mo
    JOIN female_only AS fo ON mo."MID" = fo."MID"
    GROUP BY yr
)
SELECT mp.yr  AS "Year",
       mp.total_movies AS "Total_Movies",
       ROUND( (COALESCE(fmp.female_only_movies, 0) * 100.0) / mp.total_movies , 2)
       AS "Percent_Female_Only"
FROM   movies_per_year        AS mp
LEFT   JOIN female_movies_per_year AS fmp ON mp.yr = fmp.yr
ORDER  BY mp.yr;
```

Each query gradually builds understanding—from basic column values to the final computation of the requested percentage of movies featuring exclusively female actors for every year.
