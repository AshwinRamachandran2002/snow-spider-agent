Query:
--Description: For the movie titled 'Mowgli', list up to 20 cast members’ genders.  
--Person-IDs in M_Cast contain leading spaces, so use TRIM on both sides of the join.
SELECT mo."title",
       p."Gender"
FROM   "Movie"  AS mo
JOIN   "M_Cast" AS mc ON mo."MID" = mc."MID"
JOIN   "Person" AS p  ON TRIM(mc."PID") = TRIM(p."PID")
WHERE  mo."title" = 'Mowgli'
LIMIT 20
