Query:
--Description: Count, for each year, the number of movies whose casts are exclusively female, 
--using TRIM to match Person-IDs correctly.
WITH female_only AS (
    SELECT mc."MID"
    FROM   "M_Cast" AS mc
    JOIN   "Person" AS p ON TRIM(mc."PID") = TRIM(p."PID")
    GROUP  BY mc."MID"
    HAVING SUM(CASE WHEN p."Gender" <> 'Female' THEN 1 ELSE 0 END) = 0
)
SELECT CAST(SUBSTR(mo."year", -4) AS INTEGER) AS "Year",
       COUNT(*) AS "Female_Only_Movies"
FROM   "Movie" AS mo
JOIN   female_only AS fo ON mo."MID" = fo."MID"
GROUP  BY "Year"
ORDER  BY "Year"
LIMIT 20
Answer:
Year,Female_Only_Movies
