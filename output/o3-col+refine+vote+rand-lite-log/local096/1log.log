LIMIT 20;
```

```sql
--Description: 7) For a small sample, count male vs female actors per movie
SELECT mc."MID",
       SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END) AS female_cnt,
       SUM(CASE WHEN p."Gender" <> 'Female' THEN 1 ELSE 0 END) AS non_female_cnt
FROM "M_Cast" AS mc
JOIN "Person" AS p ON mc."PID" = p."PID"
GROUP BY mc."MID"
LIMIT 20;
```

```sql
--Description: 8) For 20 movies, show whether they have exclusively female actors
SELECT m."MID",
       m."title",
       CASE
         WHEN SUM(CASE WHEN p."Gender" <> 'Female' THEN 1 ELSE 0 END) = 0 THEN 'Yes'
         ELSE 'No'
       END AS exclusively_female
FROM "Movie"  AS m
JOIN "M_Cast" AS mc ON m."MID" = mc."MID"
JOIN "Person" AS p  ON mc."PID" = p."PID"
GROUP BY m."MID"
LIMIT 20;
```

