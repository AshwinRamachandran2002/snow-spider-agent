```sql
--Description: We need, for every year, the share of movies whose casts are exclusively female  
--(i.e., they contain no actors whose gender is 'Male' or NULL/'None').  
--Problem encountered: in table "M_Cast" the PID values are padded with leading spaces  
--(e.g. ' nm0000288'), while in "Person" they are not (e.g. 'nm0000288').  
--Solution: TRIM the PID when joining "M_Cast" to "Person".  
--Step-by-step in one query:  
-- 1) all_female_cte: pick the MIDs whose cast, after trimming PID, has *only* 'Female' genders.  
-- 2) movie_totals_cte: count total movies per year (last 4 chars of Movie.year).  
-- 3) female_totals_cte: count movies from step-1 per year.  
-- 4) Final SELECT: join the per-year totals and compute the percentage.  
--The query shows up to 20 years.
WITH all_female_cte AS (
    SELECT mc."MID"
    FROM   "M_Cast"  AS mc
    JOIN   "Person"  AS p ON p."PID" = TRIM(mc."PID")
    GROUP BY mc."MID"
    HAVING SUM(CASE WHEN p."Gender" = 'Female' THEN 0 ELSE 1 END) = 0     -- no non-female
), movie_totals_cte AS (
    SELECT substr(m."year", -4, 4) AS "year",
           COUNT(*)                 AS total_movies
    FROM   "Movie" AS m
    GROUP BY "year"
), female_totals_cte AS (
    SELECT substr(m."year", -4, 4) AS "year",
           COUNT(*)                 AS female_movies
    FROM   "Movie" AS m
    WHERE  m."MID" IN (SELECT "MID" FROM all_female_cte)
    GROUP BY "year"
)
SELECT mt."year",
       mt.total_movies,
       ROUND(100.0 * COALESCE(ft.female_movies, 0) / mt.total_movies, 2) AS pct_all_female
FROM   movie_totals_cte  AS mt
LEFT JOIN female_totals_cte AS ft ON mt."year" = ft."year"
ORDER BY mt."year"
LIMIT 20;
