Query:
--Description: For every movie, count how many female vs. non-female cast members it has (uses TRIM on M_Cast.PID).
SELECT c."MID",
       SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END)  AS female_cnt,
       SUM(CASE WHEN p."Gender" <> 'Female' THEN 1 ELSE 0 END) AS non_female_cnt
FROM   "M_Cast" AS c
JOIN   "Person"  AS p ON p."PID" = TRIM(c."PID")
GROUP BY c."MID"
LIMIT 20
