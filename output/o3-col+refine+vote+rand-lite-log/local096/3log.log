Query:
--Description: Final query – for each year, show total movies and the percentage that have exclusively female actors (all joins use TRIM).
WITH all_female_cte AS (
    SELECT mc."MID"
    FROM   "M_Cast" AS mc
    JOIN   "Person" AS p ON p."PID" = TRIM(mc."PID")
    GROUP BY mc."MID"
    HAVING SUM(CASE WHEN p."Gender" = 'Female' THEN 0 ELSE 1 END) = 0              -- only female actors
), movie_totals_cte AS (
    SELECT substr(m."year", -4, 4) AS "year",
           COUNT(*)                 AS total_movies
    FROM   "Movie" AS m
    GROUP BY "year"
), female_totals_cte AS (
    SELECT substr(m."year", -4, 4) AS "year",
           COUNT(*)                 AS female_movies
    FROM   "Movie" AS m
    WHERE  m."MID" IN (SELECT "MID" FROM all_female_cte)
    GROUP BY "year"
)
SELECT mt."year",
       mt.total_movies,
       ROUND(100.0 * COALESCE(ft.female_movies, 0) / mt.total_movies, 2) AS pct_all_female
FROM   movie_totals_cte  AS mt
LEFT  JOIN female_totals_cte AS ft ON mt."year" = ft."year"
ORDER BY mt."year"
LIMIT 20
