Query:
--Description: Count movies with all-female casts for each year (uses TRIM when joining M_Cast → Person).
SELECT substr(m."year", -4, 4) AS "year",
       COUNT(*)                AS all_female_movies
FROM   "Movie" AS m
WHERE  m."MID" IN (
         SELECT c."MID"
         FROM   "M_Cast" AS c
         JOIN   "Person"  AS p ON p."PID" = TRIM(c."PID")
         GROUP BY c."MID"
         HAVING SUM(CASE WHEN p."Gender" = 'Female' THEN 0 ELSE 1 END) = 0
       )
GROUP BY "year"
LIMIT 20
