```sql
--Description: Get a list of the different years present in the Movie table (last-4 characters of Movie.year).
SELECT DISTINCT substr("Movie"."year", -4, 4) AS "year"
FROM "Movie"
LIMIT 20;
```

```sql
--Description: See how movies, cast members and their genders join together (sample 20 rows).
SELECT m."MID",
       m."title",
       c."PID",
       p."Name",
       p."Gender"
FROM   "Movie" AS m
JOIN   "M_Cast" AS c ON m."MID" = c."MID"
JOIN   "Person"  AS p ON c."PID" = p."PID"
LIMIT 20;
```

```sql
--Description: Find the distinct gender values recorded in the Person table.
SELECT DISTINCT "Gender"
FROM   "Person"
LIMIT 20;
```

```sql
--Description: For every movie, count how many female vs. non-female cast members it has (sample 20).
SELECT c."MID",
       SUM(CASE WHEN p."Gender" = 'Female' THEN 1 ELSE 0 END)     AS "female_cnt",
       SUM(CASE WHEN p."Gender" <> 'Female' THEN 1 ELSE 0 END)    AS "non_female_cnt"
FROM   "M_Cast" AS c
JOIN   "Person"  AS p ON c."PID" = p."PID"
GROUP BY c."MID"
LIMIT 20;
```

```sql
--Description: List movies that have at least one non-female cast member (sample 20).
SELECT DISTINCT c."MID"
FROM   "M_Cast" AS c
JOIN   "Person"  AS p ON c."PID" = p."PID"
WHERE  p."Gender" <> 'Female'
LIMIT 20;
```

```sql
--Description: List movies whose entire cast is female (no male/unknown actors) (sample 20).
SELECT c."MID"
FROM   "M_Cast" AS c
JOIN   "Person"  AS p ON c."PID" = p."PID"
GROUP BY c."MID"
HAVING SUM(CASE WHEN p."Gender" = 'Female' THEN 0 ELSE 1 END) = 0
LIMIT 20;
```

```sql
--Description: Count total number of movies produced each year.
SELECT substr("year", -4, 4) AS "year",
       COUNT(*)             AS "total_movies"
FROM   "Movie"
GROUP BY "year"
LIMIT 20;
```

```sql
--Description: Count movies with all-female casts for each year.
SELECT substr(m."year", -4, 4) AS "year",
       COUNT(*)                AS "all_female_movies"
FROM   "Movie" AS m
WHERE  m."MID" IN (
         SELECT c."MID"
         FROM   "M_Cast" AS c
         JOIN   "Person"  AS p ON c."PID" = p."PID"
         GROUP BY c."MID"
         HAVING SUM(CASE WHEN p."Gender" = 'Female' THEN 0 ELSE 1 END) = 0
       )
GROUP BY "year"
LIMIT 20;
```

```sql
--Description: Final query – for each year, show total movies and the percentage that have exclusively female actors.
SELECT t."year",
       t."total_movies",
       ROUND(100.0 * COALESCE(af."all_female_movies", 0) / t."total_movies", 2) AS "pct_all_female"
FROM (
        SELECT substr("year", -4, 4) AS "year",
               COUNT(*)               AS "total_movies"
        FROM   "Movie"
        GROUP BY "year"
     ) AS t
LEFT JOIN (
        SELECT substr(m."year", -4, 4) AS "year",
               COUNT(*)                AS "all_female_movies"
        FROM   "Movie" AS m
        WHERE  m."MID" IN (
                 SELECT c."MID"
                 FROM   "M_Cast" AS c
                 JOIN   "Person"  AS p ON c."PID" = p."PID"
                 GROUP BY c."MID"
                 HAVING SUM(CASE WHEN p."Gender" = 'Female' THEN 0 ELSE 1 END) = 0
               )
        GROUP BY "year"
     ) AS af
ON  t."year" = af."year"
LIMIT 20;
```
