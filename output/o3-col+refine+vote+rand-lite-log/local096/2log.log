```sql
-- Description: 1)  Look at all distinct movie years that exist in the database.
SELECT DISTINCT CAST(SUBSTR("year", -4) AS INTEGER) AS "year"
FROM "Movie"
ORDER BY "year"
LIMIT 20;
```

```sql
-- Description: 2)  Preview how movies are linked to their cast members (one row per movie–actor pair).
SELECT "M_Cast"."MID", "Movie"."title", "M_Cast"."PID"
FROM "M_Cast"
JOIN "Movie" ON "Movie"."MID" = "M_Cast"."MID"
LIMIT 20;
```

```sql
-- Description: 3)  Join cast members to the Person table to see their gender information.
SELECT "M_Cast"."MID", "Person"."PID", TRIM("Person"."Name") AS "actor_name", "Person"."Gender"
FROM "M_Cast"
JOIN "Person" ON "Person"."PID" = "M_Cast"."PID"
LIMIT 20;
```

```sql
-- Description: 4)  Check what distinct gender labels are present in the Person table.
SELECT DISTINCT "Gender"
FROM "Person"
LIMIT 20;
```

```sql
-- Description: 5)  Find sample movies whose entire cast (all listed actors) are marked as 'Female'.
SELECT "M_Cast"."MID"
FROM "M_Cast"
JOIN "Person" ON "Person"."PID" = "M_Cast"."PID"
GROUP BY "M_Cast"."MID"
HAVING SUM(CASE WHEN "Person"."Gender" <> 'Female' THEN 1 ELSE 0 END) = 0
LIMIT 20;
```

```sql
-- Description: 6)  Count how many movies fall into each release year.
SELECT CAST(SUBSTR("year", -4) AS INTEGER) AS "year",
       COUNT(*) AS "total_movies"
FROM "Movie"
GROUP BY CAST(SUBSTR("year", -4) AS INTEGER)
LIMIT 20;
```

```sql
-- Description: 7)  Count, per year, movies whose casts are exclusively female.
SELECT CAST(SUBSTR("Movie"."year", -4) AS INTEGER) AS "year",
       COUNT(DISTINCT "Movie"."MID") AS "female_only_movies"
FROM "Movie"
JOIN "M_Cast"  ON "M_Cast"."MID" = "Movie"."MID"
JOIN "Person"  ON "Person"."PID" = "M_Cast"."PID"
GROUP BY "Movie"."MID", CAST(SUBSTR("Movie"."year", -4) AS INTEGER)
HAVING SUM(CASE WHEN "Person"."Gender" <> 'Female' THEN 1 ELSE 0 END) = 0
LIMIT 20;
```

```sql
-- Description: 8)  Aggregate the above result to get one row per year with the count of exclusively-female-cast movies.
WITH female_only AS (
    SELECT CAST(SUBSTR("Movie"."year", -4) AS INTEGER) AS "yr",
           "Movie"."MID"
    FROM "Movie"
    JOIN "M_Cast"  ON "M_Cast"."MID" = "Movie"."MID"
    JOIN "Person"  ON "Person"."PID" = "M_Cast"."PID"
    GROUP BY "Movie"."MID"
    HAVING SUM(CASE WHEN "Person"."Gender" <> 'Female' THEN 1 ELSE 0 END) = 0
)
SELECT "yr" AS "year",
       COUNT(*) AS "female_only_movies"
FROM female_only
GROUP BY "yr"
LIMIT 20;
```

```sql
-- Description: 9)  Join total-movie counts with female-only counts to compute the percentage per year.
WITH total AS (
    SELECT CAST(SUBSTR("year", -4) AS INTEGER) AS "yr",
           COUNT(*) AS "total_movies"
    FROM "Movie"
    GROUP BY CAST(SUBSTR("year", -4) AS INTEGER)
),
female_only AS (
    SELECT CAST(SUBSTR("Movie"."year", -4) AS INTEGER) AS "yr",
           "Movie"."MID"
    FROM "Movie"
    JOIN "M_Cast"  ON "M_Cast"."MID" = "Movie"."MID"
    JOIN "Person"  ON "Person"."PID" = "M_Cast"."PID"
    GROUP BY "Movie"."MID"
    HAVING SUM(CASE WHEN "Person"."Gender" <> 'Female' THEN 1 ELSE 0 END) = 0
),
female_per_year AS (
    SELECT "yr", COUNT(*) AS "female_only_movies"
    FROM female_only
    GROUP BY "yr"
)
SELECT t."yr" AS "year",
       t."total_movies",
       ROUND(100.0 * COALESCE(f."female_only_movies", 0) / t."total_movies", 2) AS "female_only_pct"
FROM total AS t
LEFT JOIN female_per_year AS f ON f."yr" = t."yr"
ORDER BY t."yr"
LIMIT 20;
```

