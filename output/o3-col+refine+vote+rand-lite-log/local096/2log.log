Query:
--Description: 8)  Aggregate the above result to get one row per year with the count of exclusively-female-cast movies.
WITH female_only AS (
    SELECT CAST(SUBSTR(m."year", -4) AS INTEGER) AS yr,
           m."MID"
    FROM "Movie"  AS m
    JOIN "M_Cast" AS mc ON mc."MID" = m."MID"
    JOIN "Person" AS p  ON p."PID" = TRIM(mc."PID")
    GROUP BY m."MID"
    HAVING SUM(CASE WHEN p."Gender" <> 'Female' THEN 1 ELSE 0 END) = 0
)
SELECT yr AS "year",
       COUNT(*) AS "female_only_movies"
FROM female_only
GROUP BY yr
LIMIT 20
