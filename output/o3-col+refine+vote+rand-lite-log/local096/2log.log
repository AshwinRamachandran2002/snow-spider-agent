Query:
--Description: 7)  Count, per year, movies whose casts are exclusively female.
SELECT CAST(SUBSTR(m."year", -4) AS INTEGER) AS "year",
       COUNT(DISTINCT m."MID") AS "female_only_movies"
FROM "Movie"      AS m
JOIN "M_Cast"     AS mc ON mc."MID" = m."MID"
JOIN "Person"     AS p  ON p."PID" = TRIM(mc."PID")
GROUP BY m."MID", CAST(SUBSTR(m."year", -4) AS INTEGER)
HAVING SUM(CASE WHEN p."Gender" <> 'Female' THEN 1 ELSE 0 END) = 0
LIMIT 20
