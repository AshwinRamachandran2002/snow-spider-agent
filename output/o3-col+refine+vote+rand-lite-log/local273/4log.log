```sql
--Description: 1) Identify the product IDs that actually appear in any customer order.
SELECT DISTINCT "product_id"
FROM "orderlines"
LIMIT 20;
```

```sql
--Description: 2) Attach the human-readable product names to those product IDs.
SELECT DISTINCT p."id"      AS "product_id",
                p."name"    AS "product_name"
FROM   "products" AS p
JOIN   "orderlines" AS o
       ON p."id" = o."product_id"
LIMIT 20;
```

```sql
--Description: 3) Look at what is physically in stock for those products (how much & where).
SELECT DISTINCT i."product_id",
                i."location_id",
                i."qty"          AS "inv_qty"
FROM   "inventory" AS i
WHERE  i."product_id" IN (SELECT DISTINCT "product_id" FROM "orderlines")
LIMIT 20;
```

```sql
--Description: 4) Tie every inventory batch to the purchase record that created it
--              so we can obtain the purchase (arrival) date needed for FIFO.
SELECT DISTINCT i."id"                AS "inventory_id",
                i."product_id",
                pr."purchased"        AS "purchase_date",
                i."qty"
FROM   "inventory"  AS i
JOIN   "purchases"  AS pr
       ON pr."id" = i."purchase_id"
LIMIT 20;
```

```sql
--Description: 5) Inspect the exact lines the warehouse pickers have been asked to pick.
SELECT DISTINCT pl."picklist_id",
                pl."line_no",
                pl."product_id",
                pl."location_id",
                pl."qty"  AS "pick_qty"
FROM   "picking_line" AS pl
LIMIT 20;
```

```sql
--Description: 6) Combine the pick lines with their corresponding inventory batches
--              (same location) to see how much of each batch has been picked.
SELECT DISTINCT pl."product_id",
                pl."location_id",
                pi."purchase_id",
                pl."qty"            AS "picked_qty",
                inv."qty"           AS "inv_available"
FROM   "picking_line" AS pl
JOIN   "inventory"    AS inv
       ON inv."location_id" = pl."location_id"
JOIN   "purchases"    AS pi
       ON pi."id" = inv."purchase_id"
LIMIT 20;
```

```sql
--Description: 7) Work out the total quantity picked for every product
--              (summed across all pick lines).
SELECT pl."product_id",
       SUM(pl."qty") AS "total_picked"
FROM   "picking_line" AS pl
GROUP  BY pl."product_id"
LIMIT 20;
```

```sql
--Description: 8) Work out the total quantity ordered for every product,
--              needed as the denominator in a pick-percentage.
SELECT ol."product_id",
       SUM(ol."qty") AS "total_ordered"
FROM   "orderlines" AS ol
GROUP  BY ol."product_id"
LIMIT 20;
```

```sql
--Description: 9) Final result – average pick-percentage per product name,
--              i.e. how much of the ordered quantity could actually be picked.
--              Uses FIFO by ordering inventory batches by purchase_date,
--              then smallest available qty; the overlapping quantity is used
--              in the CTE fifo_pick.  The outer query shows the % per product.
WITH fifo_inv AS (
    SELECT inv."product_id",
           inv."location_id",
           pr."purchased"      AS "purchase_date",
           inv."qty",
           ROW_NUMBER() OVER (
               PARTITION BY inv."product_id"
               ORDER BY pr."purchased", inv."qty"
           ) AS rn
    FROM   "inventory" AS inv
    JOIN   "purchases" AS pr
           ON pr."id" = inv."purchase_id"
),
fifo_pick AS (
    SELECT p."product_id",
           MIN(fi."qty", p."qty") AS picked_here
    FROM   "picking_line" AS p
    JOIN   fifo_inv       AS fi
           ON fi."product_id" = p."product_id"
           AND fi.rn = 1         -- earliest & smallest batch per FIFO
    GROUP  BY p."product_id"
)
SELECT prd."name"                   AS "product_name",
       ROUND(100.0 * fp."picked_here" / ord."total_ordered", 2) 
                                    AS "avg_pick_pct"
FROM   fifo_pick      AS fp
JOIN   (SELECT "product_id", SUM("qty") AS total_ordered
        FROM   "orderlines"
        GROUP  BY "product_id") AS ord
       ON ord."product_id" = fp."product_id"
JOIN   "products"     AS prd
       ON prd."id" = fp."product_id"
ORDER  BY prd."name"
LIMIT 20;
```
