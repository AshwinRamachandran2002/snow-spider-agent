```sql
--Description:  Calculate, per product, the “pick-percentage” that can be fulfilled
--              from current inventory when we respect a FIFO rule:
--              1.  Sum the quantity ordered for each product   (orders_sum).
--              2.  List every inventory batch for those products, add its purchase
--                 date, and compute a running (cumulative) total ordered by
--                 purchase_date then smallest batch_qty (inv_fifo).
--              3.  For each batch, figure out how much of it is actually needed
--                 (picked_from_batch): 
--                     • if the cumulative total *before* this batch already meets
--                       the demand, 0 is taken;
--                     • if the cumulative total *after* this batch is still less
--                       than demand, the whole batch is taken;
--                     • otherwise only the remaining demand is taken.
--              4.  Sum the picked_from_batch quantities per product and divide by
--                 the total ordered to obtain the pick-percentage.
--              The final list is grouped and ordered by product name.
WITH orders_sum AS (               -- total qty ordered per product
        SELECT product_id,
               SUM(qty) AS total_ordered
        FROM   orderlines
        GROUP  BY product_id
),
inv_fifo AS (                       -- inventory batches with FIFO ordering & running sum
        SELECT inv.product_id,
               inv.id            AS inventory_id,
               inv.qty           AS batch_qty,
               pu.purchased      AS purchase_date,
               SUM(inv.qty) OVER (
                     PARTITION BY inv.product_id
                     ORDER BY pu.purchased, inv.qty, inv.id
                     ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
               )                  AS cume_qty
        FROM   inventory  AS inv
        JOIN   purchases  AS pu
               ON pu.id = inv.purchase_id
        WHERE  inv.product_id IN (SELECT product_id FROM orders_sum)
),
calc AS (                           -- how much of each batch is actually picked
        SELECT f.product_id,
               CASE
                   WHEN os.total_ordered - (f.cume_qty - f.batch_qty) <= 0
                        THEN 0                                         -- demand already met
                   WHEN os.total_ordered >= f.cume_qty
                        THEN f.batch_qty                               -- take whole batch
                   ELSE os.total_ordered - (f.cume_qty - f.batch_qty)  -- take remainder
               END AS picked_from_batch
        FROM   inv_fifo   AS f
        JOIN   orders_sum AS os
               ON os.product_id = f.product_id
)
SELECT pr.name                                     AS product_name,
       ROUND(100.0 * SUM(c.picked_from_batch)
                     / os.total_ordered, 2)        AS avg_pick_percentage
FROM   calc        AS c
JOIN   orders_sum  AS os  ON os.product_id = c.product_id
JOIN   products    AS pr  ON pr.id        = c.product_id
GROUP  BY c.product_id
ORDER  BY pr.name;
```
