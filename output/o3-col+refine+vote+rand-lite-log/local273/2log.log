```sql
-- 1) Overview of the earliest (FIFO) purchase date per product
SELECT DISTINCT
       "product_id",
       MIN("purchased") AS "first_purchase_date"
FROM   "purchases"
GROUP  BY "product_id"
LIMIT  20;
```

```sql
-- 2) Inventory rows joined to their purchase to see on-hand qty and purchase date
SELECT DISTINCT
       i."product_id",
       p."purchased",
       i."qty"
FROM   "inventory"  AS i
JOIN   "purchases"  AS p
       ON i."purchase_id" = p."id"
ORDER  BY p."purchased"
LIMIT  20;
```

```sql
-- 3) Total quantity already picked per product (from picking_line)
SELECT DISTINCT
       "product_id",
       SUM("qty") AS "picked_qty"
FROM   "picking_line"
GROUP  BY "product_id"
LIMIT  20;
```

```sql
-- 4) Total quantity ordered per product (from orderlines)
SELECT DISTINCT
       "product_id",
       SUM("qty") AS "ordered_qty"
FROM   "orderlines"
GROUP  BY "product_id"
LIMIT  20;
```

```sql
-- 5) Mapping of product IDs to names (to be used when grouping final figures)
SELECT DISTINCT
       pr."id"   AS "product_id",
       pr."name" AS "product_name"
FROM   "products" AS pr
LIMIT  20;
```

```sql
-- 6) A sample of individual pick lines with their product names
SELECT DISTINCT
       pl."product_id",
       pd."name"        AS "product_name",
       pl."qty",
       pl."location_id",
       pl."picklist_id"
FROM   "picking_line" AS pl
JOIN   "products"     AS pd
       ON pl."product_id" = pd."id"
LIMIT  20;
```

```sql
-- 7) Current inventory positions (location, product, quantity)
SELECT DISTINCT
       "location_id",
       "product_id",
       "qty"
FROM   "inventory"
LIMIT  20;
```

```sql
-- 8) Details of warehouse locations (aisle & position)
SELECT DISTINCT
       l."id"        AS "location_id",
       l."warehouse",
       l."aisle",
       l."position"
FROM   "locations" AS l
LIMIT  20;
```

```sql
-- 9) Recent picking lists with creation time and responsible picker
SELECT DISTINCT
       "id"          AS "picklist_id",
       "created",
       "picker_emp_id"
FROM   "picking_list"
ORDER  BY "created" DESC
LIMIT  20;
```

```sql
-- 10) Activity log lines that track the pick progress (D = depart, A = arrive, P = pick)
SELECT DISTINCT
       "picklist_id",
       "log_time",
       "activity",
       "location_id",
       "pickline_no"
FROM   "picking_log"
ORDER  BY "log_time"
LIMIT  20;
```
