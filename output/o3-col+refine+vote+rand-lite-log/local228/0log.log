Query:
--Description: Final combined view – match Top-3 batsmen and Top-3 bowlers position-wise for each season
SELECT DISTINCT
       b.season_id,
       b.player_id   AS batsman_id,
       p1.player_name AS batsman_name,
       b.total_runs,
       w.player_id   AS bowler_id,
       p2.player_name AS bowler_name,
       w.total_wkts
FROM (
        -- Top-3 batsmen per season (as derived earlier)
        SELECT
               m.season_id,
               b.striker       AS player_id,
               SUM(bs.runs_scored) AS total_runs,
               DENSE_RANK() OVER (
                     PARTITION BY m.season_id
                     ORDER BY SUM(bs.runs_scored) DESC, b.striker
               ) AS rnk
        FROM            batsman_scored  AS bs
        JOIN            ball_by_ball    AS b  USING (match_id, over_id, ball_id, innings_no)
        JOIN            match           AS m  USING (match_id)
        GROUP BY        m.season_id, b.striker
)  AS b
JOIN (
        -- Top-3 bowlers per season (as derived earlier)
        SELECT
               m.season_id,
               bb.bowler      AS player_id,
               COUNT(*)       AS total_wkts,
               DENSE_RANK() OVER (
                     PARTITION BY m.season_id
                     ORDER BY COUNT(*) DESC, bb.bowler
               ) AS rnk
        FROM            wicket_taken    AS w
        JOIN            ball_by_ball    AS bb USING (match_id, over_id, ball_id, innings_no)
        JOIN            match           AS m  USING (match_id)
        WHERE           w.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
        GROUP BY        m.season_id, bb.bowler
)  AS w
  ON b.season_id = w.season_id
 AND b.rnk       = w.rnk        -- position-wise pairing
JOIN player AS p1 ON p1.player_id = b.player_id
JOIN player AS p2 ON p2.player_id = w.player_id
WHERE b.rnk <= 3                 -- keep only rank 1-3
ORDER BY b.season_id, b.rnk
LIMIT 20;
