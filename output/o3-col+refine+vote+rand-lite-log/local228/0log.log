Query:
--Description: Compute total wickets taken by each bowler in each season
--             while excluding ‘run out’, ‘hit wicket’, and ‘retired hurt’ (top-20 rows preview)
SELECT DISTINCT
       m.season_id,
       bb.bowler               AS player_id,
       COUNT(*)                AS total_wkts
FROM            wicket_taken    AS w
JOIN            ball_by_ball    AS bb USING (match_id, over_id, ball_id, innings_no)
JOIN            match           AS m  USING (match_id)
WHERE           w.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
GROUP BY        m.season_id, bb.bowler
ORDER BY        m.season_id, total_wkts DESC, bb.bowler
LIMIT 20;
