```sql
--Description: 1)  Get the list of distinct IPL seasons available in the data.  
SELECT DISTINCT season_id
FROM match
ORDER BY season_id
LIMIT 20;
```

```sql
--Description: 2)  Take a quick look at the first few matches of the very first season
--            (season_id = 1) to see the teams that played and the match‐winner.  
SELECT match_id,
       team_1,
       team_2,
       match_date,
       match_winner
FROM match
WHERE season_id = 1
ORDER BY match_date
LIMIT 20;
```

```sql
--Description: 3)  Sample a few players to understand player_id ↔︎ player_name mapping.  
SELECT player_id,
       player_name,
       batting_hand,
       bowling_skill,
       country_name
FROM player
ORDER BY player_id
LIMIT 20;
```

```sql
--Description: 4)  Inspect the dismissal kinds recorded in wicket_taken so we know
--            which ones have to be excluded later (‘run out’, ‘hit wicket’, ‘retired hurt’).  
SELECT DISTINCT kind_out
FROM wicket_taken
ORDER BY kind_out
LIMIT 20;
```

```sql
--Description: 5)  Join wicket_taken with ball_by_ball to see who the wicket-taker was
--            for each dismissal (sample 20 rows).  
SELECT w.match_id,
       w.over_id,
       w.ball_id,
       w.player_out,
       w.kind_out,
       b.bowler AS wicket_taker
FROM wicket_taken AS w
JOIN ball_by_ball AS b
  ON w.match_id = b.match_id
 AND w.over_id  = b.over_id
 AND w.ball_id  = b.ball_id
LIMIT 20;
```

```sql
--Description: 6)  Compute total runs scored by every batsman in every season
--            (aggregated) – show the first 20 rows.  
SELECT m.season_id,
       bb.striker        AS player_id,
       SUM(bs.runs_scored) AS total_runs
FROM batsman_scored AS bs
JOIN ball_by_ball  AS bb ON bs.match_id = bb.match_id
                        AND bs.over_id  = bb.over_id
                        AND bs.ball_id  = bb.ball_id
JOIN match         AS m  ON m.match_id  = bs.match_id
GROUP BY m.season_id, bb.striker
ORDER BY m.season_id, total_runs DESC
LIMIT 20;
```

```sql
--Description: 7)  Compute total wickets taken by every bowler in every season,
--            excluding the unwanted dismissal kinds.  Show first 20 rows.  
SELECT m.season_id,
       b.bowler        AS player_id,
       COUNT(*)        AS total_wkts
FROM wicket_taken AS w
JOIN ball_by_ball AS b ON w.match_id = b.match_id
                       AND w.over_id = b.over_id
                       AND w.ball_id = b.ball_id
JOIN match        AS m ON m.match_id = w.match_id
WHERE w.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
GROUP BY m.season_id, b.bowler
ORDER BY m.season_id, total_wkts DESC
LIMIT 20;
```

```sql
--Description: 8)  Pick the top-3 run-scorers of season 1 (ties broken by lower player_id).  
SELECT season_id,
       player_id,
       total_runs
FROM (
    SELECT m.season_id,
           bb.striker AS player_id,
           SUM(bs.runs_scored) AS total_runs,
           RANK() OVER (PARTITION BY m.season_id
                        ORDER BY SUM(bs.runs_scored) DESC, bb.striker) AS rnk
    FROM batsman_scored AS bs
    JOIN ball_by_ball AS bb ON bs.match_id = bb.match_id
                           AND bs.over_id  = bb.over_id
                           AND bs.ball_id  = bb.ball_id
    JOIN match        AS m  ON m.match_id  = bs.match_id
    GROUP BY m.season_id, bb.striker
) 
WHERE season_id = 1
  AND rnk <= 3
ORDER BY rnk
LIMIT 20;
```

```sql
--Description: 9)  Pick the top-3 wicket-takers of season 1 (ties broken by lower player_id).  
SELECT season_id,
       player_id,
       total_wkts
FROM (
    SELECT m.season_id,
           b.bowler AS player_id,
           COUNT(*) AS total_wkts,
           RANK() OVER (PARTITION BY m.season_id
                        ORDER BY COUNT(*) DESC, b.bowler) AS rnk
    FROM wicket_taken AS w
    JOIN ball_by_ball AS b ON w.match_id = b.match_id
                           AND w.over_id = b.over_id
                           AND w.ball_id = b.ball_id
    JOIN match        AS m ON m.match_id = w.match_id
    WHERE w.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
    GROUP BY m.season_id, b.bowler
) 
WHERE season_id = 1
  AND rnk <= 3
ORDER BY rnk
LIMIT 20;
```

```sql
--Description: 10)  Final combined query: for each season place the top-3
--              batsmen and bowlers side-by-side in matched positions.  
SELECT b.season_id,
       b.player_id   AS batsman_id,
       b.total_runs,
       p1.player_name AS batsman_name,
       bw.player_id  AS bowler_id,
       bw.total_wkts,
       p2.player_name AS bowler_name
FROM (
    -- top-3 batsmen per season
    SELECT season_id,
           player_id,
           total_runs,
           rnk
    FROM (
        SELECT m.season_id,
               bb.striker AS player_id,
               SUM(bs.runs_scored) AS total_runs,
               RANK() OVER (PARTITION BY m.season_id
                            ORDER BY SUM(bs.runs_scored) DESC, bb.striker) AS rnk
        FROM batsman_scored AS bs
        JOIN ball_by_ball AS bb ON bs.match_id = bb.match_id
                               AND bs.over_id  = bb.over_id
                               AND bs.ball_id  = bb.ball_id
        JOIN match        AS m  ON m.match_id  = bs.match_id
        GROUP BY m.season_id, bb.striker
    )
    WHERE rnk <= 3
) AS b
JOIN (
    -- top-3 bowlers per season
    SELECT season_id,
           player_id,
           total_wkts,
           rnk
    FROM (
        SELECT m.season_id,
               b.bowler AS player_id,
               COUNT(*) AS total_wkts,
               RANK() OVER (PARTITION BY m.season_id
                            ORDER BY COUNT(*) DESC, b.bowler) AS rnk
        FROM wicket_taken AS w
        JOIN ball_by_ball AS b ON w.match_id = b.match_id
                               AND w.over_id = b.over_id
                               AND w.ball_id = b.ball_id
        JOIN match        AS m ON m.match_id = w.match_id
        WHERE w.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
        GROUP BY m.season_id, b.bowler
    )
    WHERE rnk <= 3
) AS bw
  ON b.season_id = bw.season_id
 AND b.rnk       = bw.rnk          -- align 1-1, 2-2, 3-3
JOIN player AS p1 ON p1.player_id = b.player_id
JOIN player AS p2 ON p2.player_id = bw.player_id
ORDER BY b.season_id, b.rnk
LIMIT 20;
```
