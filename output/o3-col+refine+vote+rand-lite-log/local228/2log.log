--Description: 10)  Final combined query: for each season place the top-3
--              batsmen and bowlers side-by-side in matched positions.  
SELECT b.season_id,
       b.player_id   AS batsman_id,
       b.total_runs,
       p1.player_name AS batsman_name,
       bw.player_id  AS bowler_id,
       bw.total_wkts,
       p2.player_name AS bowler_name
FROM (
    -- top-3 batsmen per season
    SELECT season_id,
           player_id,
           total_runs,
           rnk
    FROM (
        SELECT m.season_id,
               bb.striker AS player_id,
               SUM(bs.runs_scored) AS total_runs,
               RANK() OVER (PARTITION BY m.season_id
                            ORDER BY SUM(bs.runs_scored) DESC, bb.striker) AS rnk
        FROM batsman_scored AS bs
        JOIN ball_by_ball AS bb ON bs.match_id = bb.match_id
                               AND bs.over_id  = bb.over_id
                               AND bs.ball_id  = bb.ball_id
        JOIN match        AS m  ON m.match_id  = bs.match_id
        GROUP BY m.season_id, bb.striker
    )
    WHERE rnk <= 3
) AS b
JOIN (
    -- top-3 bowlers per season
    SELECT season_id,
           player_id,
           total_wkts,
           rnk
    FROM (
        SELECT m.season_id,
               b.bowler AS player_id,
               COUNT(*) AS total_wkts,
               RANK() OVER (PARTITION BY m.season_id
                            ORDER BY COUNT(*) DESC, b.bowler) AS rnk
        FROM wicket_taken AS w
        JOIN ball_by_ball AS b ON w.match_id = b.match_id
                               AND w.over_id = b.over_id
                               AND w.ball_id = b.ball_id
        JOIN match        AS m ON m.match_id = w.match_id
        WHERE w.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
        GROUP BY m.season_id, b.bowler
    )
    WHERE rnk <= 3
) AS bw
  ON b.season_id = bw.season_id
 AND b.rnk       = bw.rnk          -- align 1-1, 2-2, 3-3
JOIN player AS p1 ON p1.player_id = b.player_id
JOIN player AS p2 ON p2.player_id = bw.player_id
ORDER BY b.season_id, b.rnk
LIMIT 20;
