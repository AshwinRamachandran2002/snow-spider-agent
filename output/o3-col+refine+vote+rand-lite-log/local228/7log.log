```sql
-- Description: 1) List all available IPL seasons in the dataset
SELECT DISTINCT "season_id"
FROM "match"
ORDER BY "season_id"
LIMIT 20;
```

```sql
-- Description: 2) Check total runs scored by every batsman in Season 1
SELECT bb."striker"            AS "player_id",
       SUM(bs."runs_scored")   AS "total_runs"
FROM   "match"        AS m
JOIN   "ball_by_ball" AS bb
              ON m."match_id" = bb."match_id"
JOIN   "batsman_scored" AS bs
              ON bs."match_id" = bb."match_id"
             AND bs."over_id"  = bb."over_id"
             AND bs."ball_id"  = bb."ball_id"
WHERE  m."season_id" = 1
GROUP  BY bb."striker"
ORDER  BY "total_runs" DESC, "player_id" ASC
LIMIT 20;
```

```sql
-- Description: 3) Display the top-10 run-scorers in Season 1 (for a quick look)
SELECT bb."striker"            AS "player_id",
       SUM(bs."runs_scored")   AS "total_runs"
FROM   "match"        AS m
JOIN   "ball_by_ball" AS bb
              ON m."match_id" = bb."match_id"
JOIN   "batsman_scored" AS bs
              ON bs."match_id" = bb."match_id"
             AND bs."over_id"  = bb."over_id"
             AND bs."ball_id"  = bb."ball_id"
WHERE  m."season_id" = 1
GROUP  BY bb."striker"
ORDER  BY "total_runs" DESC, "player_id" ASC
LIMIT 10;
```

```sql
-- Description: 4) Aggregate runs for every batsman across all seasons
SELECT bb."striker"            AS "player_id",
       m."season_id",
       SUM(bs."runs_scored")   AS "total_runs"
FROM   "match"        AS m
JOIN   "ball_by_ball" AS bb
              ON m."match_id" = bb."match_id"
JOIN   "batsman_scored" AS bs
              ON bs."match_id" = bb."match_id"
             AND bs."over_id"  = bb."over_id"
             AND bs."ball_id"  = bb."ball_id"
GROUP  BY m."season_id", bb."striker"
ORDER  BY m."season_id", "total_runs" DESC, "player_id" ASC
LIMIT 20;
```

```sql
-- Description: 5) Inspect dismissal kinds to know which ones to exclude
SELECT DISTINCT "kind_out"
FROM   "wicket_taken"
LIMIT 20;
```

```sql
-- Description: 6) View wickets (with bowler) in Season 1, excluding the three unwanted dismissal kinds
SELECT wt."player_out", 
       bb."bowler"        AS "bowler_id",
       wt."kind_out",
       m."season_id"
FROM   "wicket_taken" AS wt
JOIN   "ball_by_ball" AS bb
           ON wt."match_id" = bb."match_id"
          AND wt."over_id"  = bb."over_id"
          AND wt."ball_id"  = bb."ball_id"
JOIN   "match" AS m
           ON m."match_id" = wt."match_id"
WHERE  m."season_id" = 1
  AND  wt."kind_out" NOT IN ('run out','hit wicket','retired hurt')
LIMIT 20;
```

```sql
-- Description: 7) Count wickets per bowler for Season 1 (filtered dismissal kinds)
SELECT bb."bowler"            AS "player_id",
       COUNT(*)               AS "total_wkts"
FROM   "wicket_taken" AS wt
JOIN   "ball_by_ball" AS bb
           ON wt."match_id" = bb."match_id"
          AND wt."over_id"  = bb."over_id"
          AND wt."ball_id"  = bb."ball_id"
JOIN   "match" AS m
           ON m."match_id" = wt."match_id"
WHERE  m."season_id" = 1
  AND  wt."kind_out" NOT IN ('run out','hit wicket','retired hurt')
GROUP  BY bb."bowler"
ORDER  BY "total_wkts" DESC, "player_id" ASC
LIMIT 20;
```

```sql
-- Description: 8) Aggregate wickets per bowler across all seasons with the dismissal filter
SELECT bb."bowler"            AS "player_id",
       m."season_id",
       COUNT(*)               AS "total_wkts"
FROM   "wicket_taken" AS wt
JOIN   "ball_by_ball" AS bb
           ON wt."match_id" = bb."match_id"
          AND wt."over_id"  = bb."over_id"
          AND wt."ball_id"  = bb."ball_id"
JOIN   "match" AS m
           ON m."match_id" = wt."match_id"
WHERE  wt."kind_out" NOT IN ('run out','hit wicket','retired hurt')
GROUP  BY m."season_id", bb."bowler"
ORDER  BY m."season_id", "total_wkts" DESC, "player_id" ASC
LIMIT 20;
```

