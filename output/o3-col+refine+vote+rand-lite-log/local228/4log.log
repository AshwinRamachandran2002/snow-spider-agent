```sql
-- 1) List all seasons that appear in the data
SELECT DISTINCT "season_id"
FROM "match"
ORDER BY "season_id"
LIMIT 20;
```

```sql
-- 2) See how many runs each striker has scored (all seasons together)
SELECT bb."striker"   AS "player_id",
       SUM(bs."runs_scored") AS "total_runs"
FROM   "ball_by_ball" AS bb
JOIN   "batsman_scored" AS bs
       USING ("match_id", "over_id", "ball_id", "innings_no")
GROUP  BY bb."striker"
ORDER  BY "total_runs" DESC, "player_id"
LIMIT 20;
```

```sql
-- 3) Add the season to the previous aggregation
SELECT m."season_id",
       bb."striker"            AS "player_id",
       SUM(bs."runs_scored")   AS "total_runs"
FROM   "match"          AS m
JOIN   "ball_by_ball"   AS bb  ON m."match_id" = bb."match_id"
JOIN   "batsman_scored" AS bs  USING ("match_id", "over_id", "ball_id", "innings_no")
GROUP  BY m."season_id", bb."striker"
ORDER  BY m."season_id", "total_runs" DESC
LIMIT 20;
```

```sql
-- 4) Get the TOP-3 batsmen per season (ties → smaller player_id)
WITH season_bat AS (
  SELECT m."season_id",
         bb."striker"          AS "player_id",
         SUM(bs."runs_scored") AS "total_runs",
         ROW_NUMBER() OVER (PARTITION BY m."season_id"
                            ORDER BY SUM(bs."runs_scored") DESC,
                                     bb."striker") AS rn
  FROM   "match"          AS m
  JOIN   "ball_by_ball"   AS bb  ON m."match_id" = bb."match_id"
  JOIN   "batsman_scored" AS bs  USING ("match_id", "over_id", "ball_id", "innings_no")
  GROUP  BY m."season_id", bb."striker"
)
SELECT *
FROM   season_bat
WHERE  rn <= 3
ORDER  BY "season_id", rn
LIMIT 20;
```

```sql
-- 5) Inspect kinds of dismissals to know which ones to exclude
SELECT DISTINCT "kind_out"
FROM   "wicket_taken"
ORDER  BY "kind_out"
LIMIT 20;
```

```sql
-- 6) Count wickets per bowler & season, excluding unwanted kinds
WITH season_wkt AS (
  SELECT m."season_id",
         bb."bowler"           AS "player_id",
         COUNT(*)              AS "wickets"
  FROM   "wicket_taken" AS wt
  JOIN   "ball_by_ball" AS bb
         ON  wt."match_id"  = bb."match_id"
         AND wt."over_id"   = bb."over_id"
         AND wt."ball_id"   = bb."ball_id"
         AND wt."innings_no"= bb."innings_no"
  JOIN   "match" AS m        ON m."match_id" = wt."match_id"
  WHERE  wt."kind_out" NOT IN ('run out', 'hit wicket', 'retired hurt')
  GROUP  BY m."season_id", bb."bowler"
)
SELECT *
FROM   season_wkt
ORDER  BY "season_id", "wickets" DESC
LIMIT 20;
```

```sql
-- 7) Keep the TOP-3 bowlers per season (ties → smaller player_id)
WITH season_wkt AS (
  SELECT m."season_id",
         bb."bowler"           AS "player_id",
         COUNT(*)              AS "wickets"
  FROM   "wicket_taken" AS wt
  JOIN   "ball_by_ball" AS bb
         ON  wt."match_id"  = bb."match_id"
         AND wt."over_id"   = bb."over_id"
         AND wt."ball_id"   = bb."ball_id"
         AND wt."innings_no"= bb."innings_no"
  JOIN   "match" AS m        ON m."match_id" = wt."match_id"
  WHERE  wt."kind_out" NOT IN ('run out', 'hit wicket', 'retired hurt')
  GROUP  BY m."season_id", bb."bowler"
),
ranked_wkt AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY "season_id"
                            ORDER BY "wickets" DESC, "player_id") AS rn
  FROM   season_wkt
)
SELECT *
FROM   ranked_wkt
WHERE  rn <= 3
ORDER  BY "season_id", rn
LIMIT 20;
```

```sql
-- 8) Bring player names for the ranked batsmen
WITH top_batsmen AS (
  SELECT m."season_id",
         bb."striker"          AS "player_id",
         SUM(bs."runs_scored") AS "total_runs",
         ROW_NUMBER() OVER (PARTITION BY m."season_id"
                            ORDER BY SUM(bs."runs_scored") DESC,
                                     bb."striker") AS rn
  FROM   "match"          AS m
  JOIN   "ball_by_ball"   AS bb  ON m."match_id" = bb."match_id"
  JOIN   "batsman_scored" AS bs  USING ("match_id", "over_id", "ball_id", "innings_no")
  GROUP  BY m."season_id", bb."striker"
),
pick_bat AS (
  SELECT tb."season_id",
         tb."rn",
         p."player_name",
         tb."player_id",
         tb."total_runs"
  FROM   top_batsmen AS tb
  JOIN   "player"    AS p  ON p."player_id" = tb."player_id"
  WHERE  tb."rn" <= 3
)
SELECT *
FROM   pick_bat
ORDER  BY "season_id", "rn"
LIMIT 20;
```

```sql
-- 9) Bring player names for the ranked bowlers
WITH season_wkt AS (
  SELECT m."season_id",
         bb."bowler"           AS "player_id",
         COUNT(*)              AS "wickets"
  FROM   "wicket_taken" AS wt
  JOIN   "ball_by_ball" AS bb
         ON  wt."match_id"  = bb."match_id"
         AND wt."over_id"   = bb."over_id"
         AND wt."ball_id"   = bb."ball_id"
         AND wt."innings_no"= bb."innings_no"
  JOIN   "match" AS m        ON m."match_id" = wt."match_id"
  WHERE  wt."kind_out" NOT IN ('run out', 'hit wicket', 'retired hurt')
  GROUP  BY m."season_id", bb."bowler"
),
ranked_wkt AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY "season_id"
                            ORDER BY "wickets" DESC, "player_id") AS rn
  FROM   season_wkt
),
pick_bowl AS (
  SELECT rw."season_id",
         rw."rn",
         p."player_name",
         rw."player_id",
         rw."wickets"
  FROM   ranked_wkt AS rw
  JOIN   "player"   AS p  ON p."player_id" = rw."player_id"
  WHERE  rw."rn" <= 3
)
SELECT *
FROM   pick_bowl
ORDER  BY "season_id", "rn"
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: combine batsmen & bowlers rank-wise for each season
WITH  -- batsmen aggregation & ranking
bats AS (
  SELECT m."season_id",
         bb."striker"          AS "player_id",
         SUM(bs."runs_scored") AS "runs",
         ROW_NUMBER() OVER (PARTITION BY m."season_id"
                            ORDER BY SUM(bs."runs_scored") DESC,
                                     bb."striker") AS rn
  FROM   "match"          AS m
  JOIN   "ball_by_ball"   AS bb  ON m."match_id" = bb."match_id"
  JOIN   "batsman_scored" AS bs  USING ("match_id", "over_id", "ball_id", "innings_no")
  GROUP  BY m."season_id", bb."striker"
),
top_bats AS (
  SELECT b."season_id",
         b."rn",
         p."player_name"   AS "batsman_name",
         b."player_id"     AS "batsman_id",
         b."runs"
  FROM   bats AS b
  JOIN   "player" AS p ON p."player_id" = b."player_id"
  WHERE  b."rn" <= 3
),
-- bowlers aggregation & ranking
wkts AS (
  SELECT m."season_id",
         bb."bowler" AS "player_id",
         COUNT(*)    AS "wickets",
         ROW_NUMBER() OVER (PARTITION BY m."season_id"
                            ORDER BY COUNT(*) DESC,
                                     bb."bowler") AS rn
  FROM   "wicket_taken" AS wt
  JOIN   "ball_by_ball" AS bb
         ON  wt."match_id"  = bb."match_id"
         AND wt."over_id"   = bb."over_id"
         AND wt."ball_id"   = bb."ball_id"
         AND wt."innings_no"= bb."innings_no"
  JOIN   "match" AS m ON m."match_id" = wt."match_id"
  WHERE  wt."kind_out" NOT IN ('run out', 'hit wicket', 'retired hurt')
  GROUP  BY m."season_id", bb."bowler"
),
top_bowl AS (
  SELECT w."season_id",
         w."rn",
         p."player_name"  AS "bowler_name",
         w."player_id"    AS "bowler_id",
         w."wickets"
  FROM   wkts  AS w
  JOIN   "player" AS p ON p."player_id" = w."player_id"
  WHERE  w."rn" <= 3
)
SELECT tb."season_id",
       tb."batsman_id", tb."batsman_name", tb."runs"    AS "total_runs",
       tw."bowler_id",  tw."bowler_name",  tw."wickets" AS "total_wkts"
FROM   top_bats AS tb
JOIN   top_bowl AS tw
       ON  tb."season_id" = tw."season_id"
       AND tb."rn"        = tw."rn"
ORDER  BY tb."season_id", tb."rn";
```
