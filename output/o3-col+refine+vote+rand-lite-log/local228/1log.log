```

```sql
-- 2. A quick look at deliveries for one random match
SELECT *
FROM "ball_by_ball"
WHERE "match_id" = 335987
LIMIT 20;
```

```sql
-- 3. How to bring runs into the ball-level feed (inner-join on the three keys)
SELECT bbb."match_id",
       bbb."over_id",
       bbb."ball_id",
       bbb."striker",
       bs."runs_scored"
FROM   "ball_by_ball" AS bbb
JOIN   "batsman_scored" AS bs
  ON   bbb."match_id" = bs."match_id"
 AND   bbb."over_id"  = bs."over_id"
 AND   bbb."ball_id"  = bs."ball_id"
LIMIT 20;
```

```sql
-- 4. Season-wise total runs for every batsman
SELECT m."season_id",
       bbb."striker"          AS "player_id",
       SUM(bs."runs_scored")  AS "total_runs"
FROM   "ball_by_ball"  AS bbb
JOIN   "batsman_scored" AS bs
  ON   bbb."match_id" = bs."match_id"
 AND   bbb."over_id"  = bs."over_id"
 AND   bbb."ball_id"  = bs."ball_id"
JOIN   "match" AS m
  ON   m."match_id" = bbb."match_id"
GROUP  BY m."season_id", bbb."striker"
ORDER  BY m."season_id", "total_runs" DESC, bbb."striker"
LIMIT 20;
```

```sql
-- 5. Wickets table with dismissal kinds (sample)
SELECT *
FROM   "wicket_taken"
LIMIT 20;
```

```sql
-- 6. Season-wise wickets per bowler, excluding ‘run out’, ‘hit wicket’, ‘retired hurt’
SELECT m."season_id",
       bbb."bowler"            AS "player_id",
       COUNT(*)                AS "wickets"
FROM   "ball_by_ball" AS bbb
JOIN   "wicket_taken" AS wt
  ON   bbb."match_id" = wt."match_id"
 AND   bbb."over_id"  = wt."over_id"
 AND   bbb."ball_id"  = wt."ball_id"
JOIN   "match" AS m
  ON   m."match_id" = bbb."match_id"
WHERE  wt."kind_out" NOT IN ('run out','hit wicket','retired hurt')
GROUP  BY m."season_id", bbb."bowler"
ORDER  BY m."season_id", "wickets" DESC, bbb."bowler"
LIMIT 20;
```

```sql
-- 7. Top-3 batsmen per season (tie-break by smaller player_id)
SELECT *
FROM (
        SELECT m."season_id",
               bbb."striker"        AS "player_id",
               SUM(bs."runs_scored") AS "total_runs",
               DENSE_RANK() OVER (PARTITION BY m."season_id"
                                  ORDER BY SUM(bs."runs_scored") DESC,
                                           bbb."striker") AS rk
        FROM   "ball_by_ball"  AS bbb
        JOIN   "batsman_scored" AS bs
          ON   bbb."match_id" = bs."match_id"
         AND  bbb."over_id"  = bs."over_id"
         AND  bbb."ball_id"  = bs."ball_id"
        JOIN   "match" AS m
          ON   m."match_id" = bbb."match_id"
        GROUP  BY m."season_id", bbb."striker"
) 
WHERE rk <= 3
ORDER BY "season_id", rk
LIMIT 20;
```

```sql
-- 8. Top-3 bowlers per season (tie-break by smaller player_id)
SELECT *
FROM (
        SELECT m."season_id",
               bbb."bowler"  AS "player_id",
               COUNT(*)      AS "wickets",
               DENSE_RANK() OVER (PARTITION BY m."season_id"
                                  ORDER BY COUNT(*) DESC,
                                           bbb."bowler") AS rk
        FROM   "ball_by_ball" AS bbb
        JOIN   "wicket_taken" AS wt
          ON   bbb."match_id" = wt."match_id"
         AND  bbb."over_id"  = wt."over_id"
         AND  bbb."ball_id"  = wt."ball_id"
        JOIN   "match" AS m
          ON   m."match_id" = bbb."match_id"
        WHERE  wt."kind_out" NOT IN ('run out','hit wicket','retired hurt')
        GROUP  BY m."season_id", bbb."bowler"
) 
WHERE rk <= 3
ORDER BY "season_id", rk
LIMIT 20;
```

```sql
-- 9. Bringing the two ranked lists together (batsman‐1 with bowler‐1, etc.)
WITH bats AS (
        SELECT m."season_id",
               bbb."striker" AS "player_id",
               SUM(bs."runs_scored") AS "total_runs",
               DENSE_RANK() OVER (PARTITION BY m."season_id"
                                  ORDER BY SUM(bs."runs_scored") DESC,
                                           bbb."striker") AS rk
        FROM   "ball_by_ball"  AS bbb
        JOIN   "batsman_scored" AS bs
          ON   bbb."match_id" = bs."match_id"
         AND  bbb."over_id"  = bs."over_id"
         AND  bbb."ball_id"  = bs."ball_id"
        JOIN   "match" AS m
          ON   m."match_id" = bbb."match_id"
        GROUP  BY m."season_id", bbb."striker"
), bowl AS (
        SELECT m."season_id",
               bbb."bowler" AS "player_id",
               COUNT(*)     AS "wickets",
               DENSE_RANK() OVER (PARTITION BY m."season_id"
                                  ORDER BY COUNT(*) DESC,
                                           bbb."bowler") AS rk
        FROM   "ball_by_ball" AS bbb
        JOIN   "wicket_taken" AS wt
          ON   bbb."match_id" = wt."match_id"
         AND  bbb."over_id"  = wt."over_id"
         AND  bbb."ball_id"  = wt."ball_id"
        JOIN   "match" AS m
          ON   m."match_id" = bbb."match_id"
        WHERE  wt."kind_out" NOT IN ('run out','hit wicket','retired hurt')
        GROUP  BY m."season_id", bbb."bowler"
)
SELECT bats."season_id",
       bats."player_id" AS "batsman_id",
       bats."total_runs",
       bowl."player_id" AS "bowler_id",
       bowl."wickets"
FROM   bats
JOIN   bowl
  ON   bowl."season_id" = bats."season_id"
 AND   bowl."rk"        = bats."rk"         -- position 1-1, 2-2, 3-3
WHERE  bats."rk" <= 3
ORDER  BY bats."season_id", bats."rk"
LIMIT 20;
```

```sql
-- 10. Same as #9, but adding player names for a complete final answer
WITH bats AS (
        SELECT m."season_id",
               bbb."striker" AS "player_id",
               SUM(bs."runs_scored") AS "total_runs",
               DENSE_RANK() OVER (PARTITION BY m."season_id"
                                  ORDER BY SUM(bs."runs_scored") DESC,
                                           bbb."striker") AS rk
        FROM   "ball_by_ball"  AS bbb
        JOIN   "batsman_scored" AS bs
          ON   bbb."match_id" = bs."match_id"
         AND  bbb."over_id"  = bs."over_id"
         AND  bbb."ball_id"  = bs."ball_id"
        JOIN   "match" AS m
          ON   m."match_id" = bbb."match_id"
        GROUP  BY m."season_id", bbb."striker"
), bowl AS (
        SELECT m."season_id",
               bbb."bowler" AS "player_id",
               COUNT(*)     AS "wickets",
               DENSE_RANK() OVER (PARTITION BY m."season_id"
                                  ORDER BY COUNT(*) DESC,
                                           bbb."bowler") AS rk
        FROM   "ball_by_ball" AS bbb
        JOIN   "wicket_taken" AS wt
          ON   bbb."match_id" = wt."match_id"
         AND  bbb."over_id"  = wt."over_id"
         AND  bbb."ball_id"  = wt."ball_id"
        JOIN   "match" AS m
          ON   m."match_id" = bbb."match_id"
        WHERE  wt."kind_out" NOT IN ('run out','hit wicket','retired hurt')
        GROUP  BY m."season_id", bbb."bowler"
)
SELECT bats."season_id",
       bats."player_id"       AS "batsman_id",
       p1."player_name"       AS "batsman_name",
       bats."total_runs",
       bowl."player_id"       AS "bowler_id",
       p2."player_name"       AS "bowler_name",
       bowl."wickets"
FROM   bats
JOIN   bowl
  ON   bowl."season_id" = bats."season_id"
 AND   bowl."rk"        = bats."rk"
JOIN   "player" AS p1
  ON   p1."player_id" = bats."player_id"
JOIN   "player" AS p2
  ON   p2."player_id" = bowl."player_id"
WHERE  bats."rk" <= 3
ORDER  BY bats."season_id", bats."rk"
LIMIT 20;
```
