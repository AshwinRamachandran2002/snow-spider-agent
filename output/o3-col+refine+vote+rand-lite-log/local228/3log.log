```sql
-- 1. Description: List the available IPL seasons in the data set.
SELECT DISTINCT "season_id"
FROM "match"
ORDER BY "season_id"
LIMIT 20;
```

```sql
-- 2. Description: Inspect one season (e.g., 1 = 2008) – aggregate total runs per batsman.
SELECT bb."match_id",
       m."season_id",
       bb."striker"  AS "player_id",
       SUM(bs."runs_scored") AS "total_runs"
FROM   "ball_by_ball" AS bb
JOIN   "batsman_scored" AS bs
       ON bb."match_id" = bs."match_id"
      AND bb."over_id"  = bs."over_id"
      AND bb."ball_id"  = bs."ball_id"
JOIN   "match" AS m
       ON m."match_id" = bb."match_id"
WHERE  m."season_id" = 1
GROUP  BY m."season_id", bb."striker"
ORDER  BY "total_runs" DESC, "player_id"
LIMIT 20;
```

```sql
-- 3. Description: Aggregate total runs for every batsman in every season.
SELECT   m."season_id",
         bb."striker" AS "player_id",
         SUM(bs."runs_scored") AS "total_runs"
FROM     "ball_by_ball"  AS bb
JOIN     "batsman_scored" AS bs
         ON bb."match_id" = bs."match_id"
        AND bb."over_id"  = bs."over_id"
        AND bb."ball_id"  = bs."ball_id"
JOIN     "match"         AS m
         ON m."match_id" = bb."match_id"
GROUP BY m."season_id", bb."striker"
ORDER BY m."season_id", "total_runs" DESC, "player_id"
LIMIT 20;
```

```sql
-- 4. Description: Check the dismissal kinds to understand which ones must be excluded for wicket counts.
SELECT DISTINCT "kind_out"
FROM   "wicket_taken"
ORDER  BY "kind_out"
LIMIT 20;
```

```sql
-- 5. Description: Aggregate wickets for every bowler in every season, excluding ‘run out’, ‘hit wicket’, and ‘retired hurt’.
SELECT   m."season_id",
         bb."bowler" AS "player_id",
         COUNT(*)    AS "wickets"
FROM     "ball_by_ball" AS bb
JOIN     "wicket_taken" AS wt
         ON bb."match_id" = wt."match_id"
        AND bb."over_id"  = wt."over_id"
        AND bb."ball_id"  = wt."ball_id"
JOIN     "match"        AS m
         ON m."match_id" = bb."match_id"
WHERE    wt."kind_out" NOT IN ('run out', 'hit wicket', 'retired hurt')
GROUP BY m."season_id", bb."bowler"
ORDER BY m."season_id", "wickets" DESC, "player_id"
LIMIT 20;
```

```sql
-- 6. Description: Rank batsmen per season (top-3) using window functions.
SELECT *
FROM (
    SELECT m."season_id",
           bb."striker" AS "player_id",
           SUM(bs."runs_scored") AS "total_runs",
           ROW_NUMBER() OVER (PARTITION BY m."season_id"
                              ORDER BY SUM(bs."runs_scored") DESC,
                                       bb."striker") AS "rank_pos"
    FROM   "ball_by_ball" AS bb
    JOIN   "batsman_scored" AS bs
           ON bb."match_id" = bs."match_id"
          AND bb."over_id"  = bs."over_id"
          AND bb."ball_id"  = bs."ball_id"
    JOIN   "match" AS m
           ON m."match_id" = bb."match_id"
    GROUP  BY m."season_id", bb."striker"
) AS ranked_batsmen
WHERE "rank_pos" <= 3
ORDER BY "season_id", "rank_pos"
LIMIT 20;
```

```sql
-- 7. Description: Rank bowlers per season (top-3) with wicket exclusion rule.
SELECT *
FROM (
    SELECT m."season_id",
           bb."bowler" AS "player_id",
           COUNT(*)    AS "wickets",
           ROW_NUMBER() OVER (PARTITION BY m."season_id"
                              ORDER BY COUNT(*) DESC,
                                       bb."bowler") AS "rank_pos"
    FROM   "ball_by_ball" AS bb
    JOIN   "wicket_taken" AS wt
           ON bb."match_id" = wt."match_id"
          AND bb."over_id"  = wt."over_id"
          AND bb."ball_id"  = wt."ball_id"
    JOIN   "match" AS m
           ON m."match_id" = bb."match_id"
    WHERE  wt."kind_out" NOT IN ('run out', 'hit wicket', 'retired hurt')
    GROUP  BY m."season_id", bb."bowler"
) AS ranked_bowlers
WHERE "rank_pos" <= 3
ORDER BY "season_id", "rank_pos"
LIMIT 20;
```

```sql
-- 8. Description: Combine the ranked batsmen and bowlers row-wise (same rank positions) for one season to preview the intended final output.
WITH top_batsmen AS (
    SELECT m."season_id",
           bb."striker" AS "player_id",
           SUM(bs."runs_scored") AS "total_runs",
           ROW_NUMBER() OVER (PARTITION BY m."season_id"
                              ORDER BY SUM(bs."runs_scored") DESC,
                                       bb."striker") AS "rank_pos"
    FROM   "ball_by_ball" AS bb
    JOIN   "batsman_scored" AS bs
           ON bb."match_id" = bs."match_id"
          AND bb."over_id"  = bs."over_id"
          AND bb."ball_id"  = bs."ball_id"
    JOIN   "match" AS m
           ON m."match_id" = bb."match_id"
    GROUP  BY m."season_id", bb."striker"
),
top_bowlers AS (
    SELECT m."season_id",
           bb."bowler" AS "player_id",
           COUNT(*)    AS "wickets",
           ROW_NUMBER() OVER (PARTITION BY m."season_id"
                              ORDER BY COUNT(*) DESC,
                                       bb."bowler") AS "rank_pos"
    FROM   "ball_by_ball" AS bb
    JOIN   "wicket_taken" AS wt
           ON bb."match_id" = wt."match_id"
          AND bb."over_id"  = wt."over_id"
          AND bb."ball_id"  = wt."ball_id"
    JOIN   "match" AS m
           ON m."match_id" = bb."match_id"
    WHERE  wt."kind_out" NOT IN ('run out', 'hit wicket', 'retired hurt')
    GROUP  BY m."season_id", bb."bowler"
)
SELECT  b."season_id",
        b."rank_pos",
        b."player_id" AS "batsman_id",
        b."total_runs",
        w."player_id" AS "bowler_id",
        w."wickets"
FROM    top_batsmen AS b
JOIN    top_bowlers AS w
       ON b."season_id" = w."season_id"
      AND b."rank_pos"  = w."rank_pos"
WHERE   b."season_id" = 1
ORDER   BY b."season_id", b."rank_pos"
LIMIT 20;
```

```sql
-- 9. Description: Produce the requested final report for all seasons.
WITH top_batsmen AS (
    SELECT m."season_id",
           bb."striker" AS "player_id",
           SUM(bs."runs_scored") AS "total_runs",
           ROW_NUMBER() OVER (PARTITION BY m."season_id"
                              ORDER BY SUM(bs."runs_scored") DESC,
                                       bb."striker") AS "rank_pos"
    FROM   "ball_by_ball" AS bb
    JOIN   "batsman_scored" AS bs
           ON bb."match_id" = bs."match_id"
          AND bb."over_id"  = bs."over_id"
          AND bb."ball_id"  = bs."ball_id"
    JOIN   "match" AS m
           ON m."match_id" = bb."match_id"
    GROUP  BY m."season_id", bb."striker"
),
top_bowlers AS (
    SELECT m."season_id",
           bb."bowler" AS "player_id",
           COUNT(*)    AS "wickets",
           ROW_NUMBER() OVER (PARTITION BY m."season_id"
                              ORDER BY COUNT(*) DESC,
                                       bb."bowler") AS "rank_pos"
    FROM   "ball_by_ball" AS bb
    JOIN   "wicket_taken" AS wt
           ON bb."match_id" = wt."match_id"
          AND bb."over_id"  = wt."over_id"
          AND bb."ball_id"  = wt."ball_id"
    JOIN   "match" AS m
           ON m."match_id" = bb."match_id"
    WHERE  wt."kind_out" NOT IN ('run out', 'hit wicket', 'retired hurt')
    GROUP  BY m."season_id", bb."bowler"
),
combined AS (
    SELECT  b."season_id",
            b."rank_pos",
            b."player_id" AS "batsman_id",
            b."total_runs",
            w."player_id" AS "bowler_id",
            w."wickets"
    FROM    top_batsmen AS b
    JOIN    top_bowlers AS w
           ON b."season_id" = w."season_id"
          AND b."rank_pos"  = w."rank_pos"
)
SELECT "season_id",
       "rank_pos",
       "batsman_id",
       "total_runs",
       "bowler_id",
       "wickets"
FROM   combined
ORDER  BY "season_id", "rank_pos"
LIMIT 20;
```

```sql
-- 10. Description: Add player names for readability (enrich the previous final report).
WITH top_batsmen AS (
    SELECT m."season_id",
           bb."striker" AS "player_id",
           SUM(bs."runs_scored") AS "total_runs",
           ROW_NUMBER() OVER (PARTITION BY m."season_id"
                              ORDER BY SUM(bs."runs_scored") DESC,
                                       bb."striker") AS "rank_pos"
    FROM   "ball_by_ball" AS bb
    JOIN   "batsman_scored" AS bs
           ON bb."match_id" = bs."match_id"
          AND bb."over_id"  = bs."over_id"
          AND bb."ball_id"  = bs."ball_id"
    JOIN   "match" AS m
           ON m."match_id" = bb."match_id"
    GROUP  BY m."season_id", bb."striker"
),
top_bowlers AS (
    SELECT m."season_id",
           bb."bowler" AS "player_id",
           COUNT(*)    AS "wickets",
           ROW_NUMBER() OVER (PARTITION BY m."season_id"
                              ORDER BY COUNT(*) DESC,
                                       bb."bowler") AS "rank_pos"
    FROM   "ball_by_ball" AS bb
    JOIN   "wicket_taken" AS wt
           ON bb."match_id" = wt."match_id"
          AND bb."over_id"  = wt."over_id"
          AND bb."ball_id"  = wt."ball_id"
    JOIN   "match" AS m
           ON m."match_id" = bb."match_id"
    WHERE  wt."kind_out" NOT IN ('run out', 'hit wicket', 'retired hurt')
    GROUP  BY m."season_id", bb."bowler"
),
combined AS (
    SELECT  b."season_id",
            b."rank_pos",
            b."player_id" AS "batsman_id",
            b."total_runs",
            w."player_id" AS "bowler_id",
            w."wickets"
    FROM    top_batsmen AS b
    JOIN    top_bowlers AS w
           ON b."season_id" = w."season_id"
          AND b."rank_pos"  = w."rank_pos"
)
SELECT c."season_id",
       c."rank_pos",
       pb."player_name" AS "batsman_name",
       c."total_runs",
       pw."player_name" AS "bowler_name",
       c."wickets"
FROM   combined AS c
JOIN   "player" AS pb ON pb."player_id" = c."batsman_id"
JOIN   "player" AS pw ON pw."player_id" = c."bowler_id"
ORDER  BY c."season_id", c."rank_pos"
LIMIT 20;
```
