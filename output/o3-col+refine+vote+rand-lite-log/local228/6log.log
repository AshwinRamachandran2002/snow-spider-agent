Query:
--Description: Produce the Top-3 batsmen per season (with names) after having ranked them in a CTE.
WITH run_ranked AS (
    SELECT season_id,
           player_id,
           total_runs,
           ROW_NUMBER() OVER (
               PARTITION BY season_id
               ORDER BY total_runs DESC, player_id
           ) AS rnk
    FROM (
        SELECT m.season_id,
               bb.striker AS player_id,
               SUM(bs.runs_scored) AS total_runs
        FROM batsman_scored AS bs
        JOIN ball_by_ball AS bb
          ON bs.match_id = bb.match_id
         AND bs.over_id  = bb.over_id
         AND bs.ball_id  = bb.ball_id
        JOIN match AS m
          ON m.match_id = bs.match_id
        GROUP BY m.season_id, bb.striker
    )
)
SELECT rr.season_id,
       rr.rnk        AS position,
       p.player_name AS batsman_name,
       rr.total_runs
FROM run_ranked AS rr
JOIN player AS p
  ON p.player_id = rr.player_id
WHERE rr.rnk <= 3
ORDER BY rr.season_id, rr.rnk
LIMIT 20
