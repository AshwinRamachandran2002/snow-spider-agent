```sql
--Description: Preview wickets data and confirm that dismissals ‘run out’, ‘hit wicket’, and ‘retired hurt’ are excluded.
SELECT wt.match_id,
       m.season_id,
       wt.player_out,
       wt.kind_out
FROM wicket_taken AS wt
JOIN match AS m
  ON m.match_id = wt.match_id
WHERE wt.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
LIMIT 20;
```

```sql
--Description: Aggregate the number of valid wickets taken by each bowler in every season.
SELECT m.season_id,
       bb.bowler AS player_id,
       COUNT(*)  AS wkts
FROM wicket_taken AS wt
JOIN ball_by_ball AS bb
  ON wt.match_id = bb.match_id
 AND wt.over_id  = bb.over_id
 AND wt.ball_id  = bb.ball_id
JOIN match AS m
  ON m.match_id = wt.match_id
WHERE wt.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
GROUP BY m.season_id, bb.bowler
ORDER BY wkts DESC
LIMIT 20;
```

```sql
--Description: Rank bowlers within each season by the number of valid wickets and keep only the Top-3; the filtering is done outside the window-function SELECT to avoid alias-misuse errors.
WITH wkt_totals AS (
    SELECT m.season_id,
           bb.bowler AS player_id,
           COUNT(*)  AS total_wkts
    FROM wicket_taken AS wt
    JOIN ball_by_ball AS bb
      ON wt.match_id = bb.match_id
     AND wt.over_id  = bb.over_id
     AND wt.ball_id  = bb.ball_id
    JOIN match AS m
      ON m.match_id = wt.match_id
    WHERE wt.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
    GROUP BY m.season_id, bb.bowler
),
ranked AS (
    SELECT season_id,
           player_id,
           total_wkts,
           ROW_NUMBER() OVER (
               PARTITION BY season_id
               ORDER BY total_wkts DESC, player_id
           ) AS wkt_rank
    FROM wkt_totals
)
SELECT season_id,
       player_id,
       total_wkts,
       wkt_rank
FROM ranked
WHERE wkt_rank <= 3
ORDER BY season_id, wkt_rank
LIMIT 20;
```

