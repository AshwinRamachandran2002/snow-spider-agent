--Description:  For every season, (1) compute each batsman’s total runs and rank them;  
--(2) compute each bowler’s valid-wicket tally (excluding run-out, hit-wicket, retired-hurt) and rank them;  
--(3) join the two ranked lists on season & position so that batsman-1 pairs with bowler-1, batsman-2 with bowler-2, etc.;  
--(4) return the six paired players per season (top-3 of each side) ordered by season and position.  
WITH run_totals AS (                     -- total runs per (season, striker)
    SELECT m.season_id,
           bb.striker            AS player_id,
           SUM(bs.runs_scored)   AS total_runs
    FROM batsman_scored  bs
    JOIN ball_by_ball    bb ON bs.match_id = bb.match_id
                           AND bs.over_id  = bb.over_id
                           AND bs.ball_id  = bb.ball_id
    JOIN match           m  ON m.match_id  = bs.match_id
    GROUP BY m.season_id, bb.striker
), 
run_ranked AS (                         -- rank batsmen per season
    SELECT season_id,
           player_id,
           total_runs,
           ROW_NUMBER() OVER (
               PARTITION BY season_id
               ORDER BY total_runs DESC, player_id
           ) AS pos
    FROM run_totals
), 
wkt_totals AS (                         -- total valid wickets per (season, bowler)
    SELECT m.season_id,
           bb.bowler            AS player_id,
           COUNT(*)             AS total_wkts
    FROM wicket_taken     wt
    JOIN ball_by_ball     bb ON wt.match_id = bb.match_id
                            AND wt.over_id  = bb.over_id
                            AND wt.ball_id  = bb.ball_id
    JOIN match            m  ON m.match_id  = wt.match_id
    WHERE wt.kind_out NOT IN ('run out','hit wicket','retired hurt')
    GROUP BY m.season_id, bb.bowler
), 
wkt_ranked AS (                         -- rank bowlers per season
    SELECT season_id,
           player_id,
           total_wkts,
           ROW_NUMBER() OVER (
               PARTITION BY season_id
               ORDER BY total_wkts DESC, player_id
           ) AS pos
    FROM wkt_totals
), 
paired AS (                             -- join batsman & bowler at same position
    SELECT r.season_id,
           r.pos                     AS position,
           pb.player_name            AS batsman_name,
           r.total_runs,
           bw.player_name            AS bowler_name,
           w.total_wkts
    FROM run_ranked r
    JOIN wkt_ranked w   ON r.season_id = w.season_id
                       AND r.pos       = w.pos
    JOIN player pb      ON pb.player_id = r.player_id
    JOIN player bw      ON bw.player_id = w.player_id
    WHERE r.pos <= 3                    -- keep only top-3 pairs
)
SELECT season_id,
       position,
       batsman_name,
       total_runs,
       bowler_name,
       total_wkts
FROM paired
ORDER BY season_id, position;
