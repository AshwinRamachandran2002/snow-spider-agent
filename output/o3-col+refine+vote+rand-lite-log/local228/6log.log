```sql
--1. Description: Check the available IPL seasons in the data (column season_id in match table).  
SELECT DISTINCT season_id
FROM match
ORDER BY season_id
LIMIT 20;
```

```sql
--2. Description: Preview how runs are recorded—combine batsman_scored with match to see runs, player, season.  
SELECT bs.match_id, m.season_id, bs.innings_no, bs.runs_scored, bb.striker AS player_id
FROM batsman_scored AS bs
JOIN ball_by_ball AS bb
  ON bs.match_id = bb.match_id
 AND bs.over_id  = bb.over_id
 AND bs.ball_id  = bb.ball_id
JOIN match AS m
  ON m.match_id = bs.match_id
LIMIT 20;
```

```sql
--3. Description: Aggregate total runs per player per season.  
SELECT m.season_id,
       bb.striker           AS player_id,
       SUM(bs.runs_scored)  AS total_runs
FROM batsman_scored AS bs
JOIN ball_by_ball AS bb
  ON bs.match_id = bb.match_id
 AND bs.over_id  = bb.over_id
 AND bs.ball_id  = bb.ball_id
JOIN match AS m
  ON m.match_id = bs.match_id
GROUP BY m.season_id, bb.striker
ORDER BY total_runs DESC
LIMIT 20;
```

```sql
--4. Description: Rank batsmen within each season by total runs (top‐3 shown).  
WITH run_totals AS (
  SELECT m.season_id,
         bb.striker AS player_id,
         SUM(bs.runs_scored) AS total_runs
  FROM batsman_scored AS bs
  JOIN ball_by_ball AS bb
    ON bs.match_id = bb.match_id
   AND bs.over_id  = bb.over_id
   AND bs.ball_id  = bb.ball_id
  JOIN match AS m
    ON m.match_id = bs.match_id
  GROUP BY m.season_id, bb.striker
)
SELECT season_id,
       player_id,
       total_runs,
       ROW_NUMBER() OVER (
         PARTITION BY season_id
         ORDER BY total_runs DESC, player_id
       ) AS run_rank
FROM run_totals
WHERE run_rank <= 3
ORDER BY season_id, run_rank
LIMIT 20;
```

```sql
--5. Description: Preview how wickets are recorded and filtered (excluding run out, hit wicket, retired hurt).  
SELECT wt.match_id,
       m.season_id,
       wt.player_out,
       wt.kind_out
FROM wicket_taken AS wt
JOIN match AS m
  ON m.match_id = wt.match_id
WHERE wt.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
LIMIT 20;
```

```sql
--6. Description: Aggregate number of (valid) wickets taken by each bowler each season.  
SELECT m.season_id,
       bb.bowler            AS player_id,
       COUNT(*)             AS wkts
FROM wicket_taken AS wt
JOIN ball_by_ball AS bb
  ON wt.match_id = bb.match_id
 AND wt.over_id  = bb.over_id
 AND wt.ball_id  = bb.ball_id
JOIN match AS m
  ON m.match_id = wt.match_id
WHERE wt.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
GROUP BY m.season_id, bb.bowler
ORDER BY wkts DESC
LIMIT 20;
```

```sql
--7. Description: Rank bowlers within each season by wickets (top‐3 shown).  
WITH wkt_totals AS (
  SELECT m.season_id,
         bb.bowler AS player_id,
         COUNT(*)  AS total_wkts
  FROM wicket_taken AS wt
  JOIN ball_by_ball AS bb
    ON wt.match_id = bb.match_id
   AND wt.over_id  = bb.over_id
   AND wt.ball_id  = bb.ball_id
  JOIN match AS m
    ON m.match_id = wt.match_id
  WHERE wt.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
  GROUP BY m.season_id, bb.bowler
)
SELECT season_id,
       player_id,
       total_wkts,
       ROW_NUMBER() OVER (
         PARTITION BY season_id
         ORDER BY total_wkts DESC, player_id
       ) AS wkt_rank
FROM wkt_totals
WHERE wkt_rank <= 3
ORDER BY season_id, wkt_rank
LIMIT 20;
```

```sql
--8. Description: Prepare top‐3 batsmen per season with player names.  
WITH run_ranked AS (
  SELECT season_id,
         player_id,
         total_runs,
         ROW_NUMBER() OVER (
           PARTITION BY season_id
           ORDER BY total_runs DESC, player_id
         ) AS rnk
  FROM (
    SELECT m.season_id,
           bb.striker AS player_id,
           SUM(bs.runs_scored) AS total_runs
    FROM batsman_scored AS bs
    JOIN ball_by_ball AS bb
      ON bs.match_id = bb.match_id
     AND bs.over_id  = bb.over_id
     AND bs.ball_id  = bb.ball_id
    JOIN match AS m
      ON m.match_id = bs.match_id
    GROUP BY m.season_id, bb.striker
  )
)
SELECT rr.season_id,
       rr.rnk        AS position,
       p.player_name AS batsman_name,
       rr.total_runs
FROM run_ranked AS rr
JOIN player AS p
  ON p.player_id = rr.player_id
WHERE rr.rnk <= 3
ORDER BY rr.season_id, rr.rnk
LIMIT 20;
```

```sql
--9. Description: Prepare top‐3 bowlers per season with player names.  
WITH wkt_ranked AS (
  SELECT season_id,
         player_id,
         total_wkts,
         ROW_NUMBER() OVER (
           PARTITION BY season_id
           ORDER BY total_wkts DESC, player_id
         ) AS rnk
  FROM (
    SELECT m.season_id,
           bb.bowler AS player_id,
           COUNT(*)  AS total_wkts
    FROM wicket_taken AS wt
    JOIN ball_by_ball AS bb
      ON wt.match_id = bb.match_id
     AND wt.over_id  = bb.over_id
     AND wt.ball_id  = bb.ball_id
    JOIN match AS m
      ON m.match_id = wt.match_id
    WHERE wt.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
    GROUP BY m.season_id, bb.bowler
  )
)
SELECT wr.season_id,
       wr.rnk        AS position,
       p.player_name AS bowler_name,
       wr.total_wkts
FROM wkt_ranked AS wr
JOIN player AS p
  ON p.player_id = wr.player_id
WHERE wr.rnk <= 3
ORDER BY wr.season_id, wr.rnk
LIMIT 20;
```

```sql
--10. Description: Final answer—match batsmen & bowlers by season and rank, output six players (batsman1 with bowler1, etc.).  
WITH
run_ranked AS (
  SELECT season_id,
         player_id,
         total_runs,
         ROW_NUMBER() OVER (
           PARTITION BY season_id
           ORDER BY total_runs DESC, player_id
         ) AS rnk
  FROM (
    SELECT m.season_id,
           bb.striker AS player_id,
           SUM(bs.runs_scored) AS total_runs
    FROM batsman_scored AS bs
    JOIN ball_by_ball AS bb
      ON bs.match_id = bb.match_id
     AND bs.over_id  = bb.over_id
     AND bs.ball_id  = bb.ball_id
    JOIN match AS m
      ON m.match_id = bs.match_id
    GROUP BY m.season_id, bb.striker
  )
  WHERE total_runs > 0
),
wkt_ranked AS (
  SELECT season_id,
         player_id,
         total_wkts,
         ROW_NUMBER() OVER (
           PARTITION BY season_id
           ORDER BY total_wkts DESC, player_id
         ) AS rnk
  FROM (
    SELECT m.season_id,
           bb.bowler AS player_id,
           COUNT(*)  AS total_wkts
    FROM wicket_taken AS wt
    JOIN ball_by_ball AS bb
      ON wt.match_id = bb.match_id
     AND wt.over_id  = bb.over_id
     AND wt.ball_id  = bb.ball_id
    JOIN match AS m
      ON m.match_id = wt.match_id
    WHERE wt.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
    GROUP BY m.season_id, bb.bowler
  )
),
final AS (
  SELECT r.season_id,
         r.rnk AS position,
         rb.player_name AS batsman_name,
         r.total_runs,
         wb.player_name AS bowler_name,
         w.total_wkts
  FROM run_ranked AS r
  JOIN wkt_ranked AS w
    ON r.season_id = w.season_id
   AND r.rnk       = w.rnk   --match by position (1,2,3)
  JOIN player AS rb
    ON rb.player_id = r.player_id
  JOIN player AS wb
    ON wb.player_id = w.player_id
  WHERE r.rnk <= 3
)
SELECT season_id,
       position,
       batsman_name,
       total_runs,
       bowler_name,
       total_wkts
FROM final
ORDER BY season_id, position
LIMIT 20;
```
