```sql
--Description: 1)  List every season that appears in the IPL data set
SELECT DISTINCT season_id
FROM match
ORDER BY season_id
LIMIT 20;
```

```sql
--Description: 2)  Show a few matches together with the two teams that played and the season
SELECT m.match_id,
       m.season_id,
       t1.name  AS team_1_name,
       t2.name  AS team_2_name,
       m.match_date
FROM match AS m
JOIN team AS t1 ON t1.team_id = m.team_1
JOIN team AS t2 ON t2.team_id = m.team_2
ORDER BY m.season_id, m.match_date
LIMIT 20;
```

```sql
--Description: 3)  Peek at runs recorded ball-by-ball (one innings sample)
SELECT bs.match_id,
       bs.over_id,
       bs.ball_id,
       bs.runs_scored,
       bs.innings_no
FROM batsman_scored AS bs
ORDER BY bs.match_id, bs.over_id, bs.ball_id
LIMIT 20;
```

```sql
--Description: 4)  Aggregate runs per (season, player) to see who scores most
SELECT  m.season_id,
        p.player_id,
        p.player_name,
        SUM(bs.runs_scored) AS total_runs
FROM batsman_scored AS bs
JOIN match          AS m ON m.match_id  = bs.match_id
JOIN player         AS p ON p.player_id = (SELECT striker
                                           FROM ball_by_ball b
                                           WHERE b.match_id = bs.match_id
                                             AND b.over_id  = bs.over_id
                                             AND b.ball_id  = bs.ball_id
                                           LIMIT 1)
GROUP BY m.season_id, p.player_id
ORDER BY m.season_id, total_runs DESC, p.player_id
LIMIT 20;
```

```sql
--Description: 5)  Check every dismissal type that appears in the wicket table
SELECT DISTINCT kind_out
FROM wicket_taken
ORDER BY kind_out
LIMIT 20;
```

```sql
--Description: 6)  Join each dismissal to the bowler who delivered that ball (sample)
SELECT wt.match_id,
       wt.over_id,
       wt.ball_id,
       b.bowler                AS bowler_id,
       p.player_name           AS bowler_name,
       wt.player_out,
       wt.kind_out
FROM wicket_taken  AS wt
JOIN ball_by_ball  AS b ON b.match_id = wt.match_id
                       AND b.over_id  = wt.over_id
                       AND b.ball_id  = wt.ball_id
JOIN player        AS p ON p.player_id = b.bowler
WHERE wt.kind_out NOT IN ('run out','hit wicket','retired hurt')
LIMIT 20;
```

```sql
--Description: 7)  Compute wickets per bowler per season (excluding run-out, hit-wicket, retired-hurt)
SELECT  m.season_id,
        b.bowler                                   AS bowler_id,
        p.player_name,
        COUNT(*)                                   AS total_wkts
FROM wicket_taken  AS wt
JOIN ball_by_ball  AS b ON b.match_id = wt.match_id
                       AND b.over_id  = wt.over_id
                       AND b.ball_id  = wt.ball_id
JOIN match         AS m ON m.match_id = wt.match_id
JOIN player        AS p ON p.player_id = b.bowler
WHERE wt.kind_out NOT IN ('run out','hit wicket','retired hurt')
GROUP BY m.season_id, b.bowler
ORDER BY m.season_id, total_wkts DESC, b.bowler
LIMIT 20;
```

```sql
--Description: 8)  Pick the top-3 run-scorers of the 2008 season to verify ordering rules
WITH season_runs AS (
    SELECT  m.season_id,
            p.player_id,
            p.player_name,
            SUM(bs.runs_scored) AS total_runs
    FROM batsman_scored AS bs
    JOIN match          AS m ON m.match_id  = bs.match_id
    JOIN ball_by_ball   AS bb ON bb.match_id = bs.match_id
                             AND bb.over_id  = bs.over_id
                             AND bb.ball_id  = bs.ball_id
    JOIN player         AS p ON p.player_id  = bb.striker
    WHERE m.season_id = 1      -- 2008 season
    GROUP BY m.season_id, p.player_id
)
SELECT *
FROM (
    SELECT sr.*,
           ROW_NUMBER() OVER (ORDER BY sr.total_runs DESC, sr.player_id) AS rk
    FROM season_runs sr
) WHERE rk <= 3;
```

```sql
--Description: 9)  Pick the top-3 wicket-takers of the 2008 season to verify ordering rules
WITH season_wkts AS (
    SELECT  m.season_id,
            b.bowler                AS bowler_id,
            p.player_name,
            COUNT(*) AS total_wkts
    FROM wicket_taken  AS wt
    JOIN ball_by_ball  AS b ON b.match_id = wt.match_id
                           AND b.over_id  = wt.over_id
                           AND b.ball_id  = wt.ball_id
    JOIN match         AS m ON m.match_id = wt.match_id
    JOIN player        AS p ON p.player_id = b.bowler
    WHERE m.season_id = 1    -- 2008 season
      AND wt.kind_out NOT IN ('run out','hit wicket','retired hurt')
    GROUP BY m.season_id, b.bowler
)
SELECT *
FROM (
    SELECT sw.*,
           ROW_NUMBER() OVER (ORDER BY sw.total_wkts DESC, sw.bowler_id) AS rk
    FROM season_wkts sw
) WHERE rk <= 3;
```

```sql
--Description: 10)  Produce the required six-row output (top-3 batters matched with top-3 bowlers) for every season
WITH batter_rank AS (
    SELECT  m.season_id,
            p.player_id,
            p.player_name,
            SUM(bs.runs_scored) AS total_runs,
            ROW_NUMBER() OVER (PARTITION BY m.season_id
                               ORDER BY SUM(bs.runs_scored) DESC,
                                        p.player_id) AS rk
    FROM batsman_scored AS bs
    JOIN match          AS m  ON m.match_id = bs.match_id
    JOIN ball_by_ball   AS bb ON bb.match_id = bs.match_id
                             AND bb.over_id  = bs.over_id
                             AND bb.ball_id  = bs.ball_id
    JOIN player         AS p  ON p.player_id = bb.striker
    GROUP BY m.season_id, p.player_id
),
bowler_rank AS (
    SELECT  m.season_id,
            b.bowler               AS player_id,
            p.player_name,
            COUNT(*) AS total_wkts,
            ROW_NUMBER() OVER (PARTITION BY m.season_id
                               ORDER BY COUNT(*) DESC,
                                        b.bowler) AS rk
    FROM wicket_taken  AS wt
    JOIN ball_by_ball  AS b  ON b.match_id = wt.match_id
                            AND b.over_id  = wt.over_id
                            AND b.ball_id  = wt.ball_id
    JOIN match         AS m  ON m.match_id = wt.match_id
    JOIN player        AS p  ON p.player_id = b.bowler
    WHERE wt.kind_out NOT IN ('run out','hit wicket','retired hurt')
    GROUP BY m.season_id, b.bowler
)
SELECT br.season_id,
       br.rk                         AS position,
       br.player_id                  AS batsman_id,
       br.player_name                AS batsman_name,
       br.total_runs,
       bw.player_id                  AS bowler_id,
       bw.player_name                AS bowler_name,
       bw.total_wkts
FROM batter_rank AS br
JOIN bowler_rank AS bw
  ON bw.season_id = br.season_id
 AND bw.rk        = br.rk
WHERE br.rk <= 3
ORDER BY br.season_id, br.rk
LIMIT 20;
```
