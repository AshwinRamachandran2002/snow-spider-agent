--             The query returns up to 20 qualifying cases; for each case, the tissue categories are concatenated with “; ” so they appear in a single column.
SELECT
    "case_barcode",
    ARRAY_TO_STRING(
        ARRAY_AGG(DISTINCT "sample_type_name"),
        '; '
    ) AS "tissue_types_present"
FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R35"
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "gene_type"          = 'protein_coding'
GROUP BY "case_barcode"
HAVING COUNT(DISTINCT "sample_type_name") > 1
   AND BOOLOR_AGG("sample_type_name" ILIKE '%Solid%Tissue%Normal%')
ORDER BY "case_barcode"
LIMIT 20;
```
