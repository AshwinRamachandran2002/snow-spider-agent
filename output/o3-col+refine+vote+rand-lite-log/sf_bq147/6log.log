--Description: Retrieve the TCGA-BRCA case‐ID(s) that have **exactly** two distinct tissue/sample types (no Solid-Tissue-Normal requirement this time) in the hg38 R35 RNA-Seq table while still restricting to protein-coding genes.  Useful to double-check borderline multi-tissue cases quickly.
SELECT
    "case_barcode",
    ARRAY_TO_STRING(
        ARRAY_AGG(DISTINCT "sample_type_name"),
        '; '
    ) AS "tissue_types_present"
FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R35"
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "gene_type"          = 'protein_coding'
GROUP BY "case_barcode"
HAVING COUNT(DISTINCT "sample_type_name") = 2
ORDER BY "case_barcode"
LIMIT 20;
