--Description: 4) Quickly list cases that include the tissue type “Solid Tissue Normal” (protein-coding only).
SELECT DISTINCT "case_barcode"
FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R35"
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "gene_type" = 'protein_coding'
  AND "sample_type_name" ILIKE '%Solid%Tissue%Normal%'
LIMIT 20;
