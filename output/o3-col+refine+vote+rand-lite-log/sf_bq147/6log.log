--Description: 3) Count how many different tissue types each BRCA case has (protein-coding only).  
--   This helps spot cases with >1 tissue type.
SELECT "case_barcode",
       COUNT(DISTINCT "sample_type_name") AS "distinct_tissue_types"
FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R35"
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "gene_type" = 'protein_coding'
GROUP BY "case_barcode"
ORDER BY "distinct_tissue_types" DESC
LIMIT 20;
