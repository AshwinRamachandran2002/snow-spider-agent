--Description: Preview (limit 20 rows) TCGA-BRCA cases whose hg38 R35 RNA-Seq data are restricted to protein-coding genes and contain BOTH “Primary Tumor” and “Solid Tissue Normal” samples—hence they originate from at least two distinct tissue/sample types.  
--             MAX(CASE …) = 1 is used in the HAVING clause (since BOOL_OR is unavailable) to confirm the presence of each required tissue type.  
--             For every qualifying case, the distinct tissue categories are concatenated with “; ” (semicolon + space) so they appear in a single column.
SELECT
    "case_barcode",
    ARRAY_TO_STRING(
        ARRAY_AGG(DISTINCT "sample_type_name"),
        '; '
    ) AS "tissue_types_present"
FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R35"
