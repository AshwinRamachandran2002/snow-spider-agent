GROUP BY "case_barcode"
HAVING MAX(CASE WHEN "sample_type_name" = 'Primary Tumor'       THEN 1 ELSE 0 END) = 1
   AND MAX(CASE WHEN "sample_type_name" = 'Solid Tissue Normal' THEN 1 ELSE 0 END) = 1
ORDER BY "case_barcode"
LIMIT 20;
