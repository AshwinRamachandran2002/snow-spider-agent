```sql
--Description: List all sample barcodes (tumour & normal) from the masked-somatic-mutation table
--             that belong to TCGA-BRCA cases already confirmed to have ≥2 tissue types including
--             “Solid Tissue Normal” in RNA-Seq (hg38 R35, protein-coding).  This verifies that the
--             same cases also have mutation data available.  Steps:
--               1.  Sub-query (t) selects case_barcodes meeting the RNA-Seq criteria.
--               2.  Join t to MASKED_SOMATIC_MUTATION_HG38_GDC_R36 (BRCA only) to pull the
--                   tumour & normal sample barcodes for each qualifying case.
SELECT
    m."case_barcode",
    m."sample_barcode_tumor"  AS "tumor_sample",
    m."sample_barcode_normal" AS "normal_sample"
FROM "TCGA"."TCGA_VERSIONED"."MASKED_SOMATIC_MUTATION_HG38_GDC_R36" m
JOIN (
    SELECT "case_barcode"
    FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R35"
    WHERE "project_short_name" = 'TCGA-BRCA'
      AND "gene_type"          = 'protein_coding'
    GROUP BY "case_barcode"
    HAVING COUNT(DISTINCT "sample_type_name") > 1
       AND BOOLOR_AGG("sample_type_name" ILIKE '%Solid%Tissue%Normal%')
) t
  ON m."case_barcode" = t."case_barcode"
WHERE m."project_short_name" = 'TCGA-BRCA'
ORDER BY m."case_barcode", m."sample_barcode_tumor"
LIMIT 20;
```
