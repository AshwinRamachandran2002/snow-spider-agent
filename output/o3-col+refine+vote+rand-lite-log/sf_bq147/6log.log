--Description: 1) Inspect the available sample_type_name values for TCGA-BRCA, restricted to protein-coding genes, to understand which tissue types exist.
SELECT DISTINCT "sample_type_name"
FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R35"
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "gene_type" = 'protein_coding'
LIMIT 20;
