--Description: LIMIT-20 preview of TCGA-BRCA cases whose hg38 R35 RNA-Seq data are restricted to protein-coding genes, come from at least two distinct tissue/sample types, and include at least one “Solid Tissue Normal” specimen.  
--             The distinct tissue categories for each qualifying case are concatenated with ‘; ’ (semicolon + space) so they appear in a single column.
SELECT
    "case_barcode",
    ARRAY_TO_STRING(                      -- concatenate distinct tissue names
        ARRAY_AGG(DISTINCT "sample_type_name"),
        '; '
    ) AS "tissue_types_present"
FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R35"
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "gene_type"          = 'protein_coding'
GROUP BY "case_barcode"
HAVING COUNT(DISTINCT "sample_type_name") > 1                 -- ≥ 2 tissue categories
   AND MAX(CASE WHEN "sample_type_name" = 'Solid Tissue Normal' THEN 1 ELSE 0 END) = 1  -- contains STN
ORDER BY "case_barcode"
LIMIT 20;
```
