Query:
--Description: 5) Identify BRCA cases that have at least two different tissue types **and** include “Solid Tissue Normal”.  
--   The HAVING clause guarantees both conditions.
SELECT "case_barcode"
FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R35"
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "gene_type" = 'protein_coding'
GROUP BY "case_barcode"
HAVING COUNT(DISTINCT "sample_type_name") > 1
   AND BOOLOR_AGG("sample_type_name" ILIKE '%Solid%Tissue%Normal%')
LIMIT 20;
Answer:
case_barcode
TCGA-BH-A203
Query:
--Description: 6) For the subset found above, display the full set of tissue types observed per case.
SELECT DISTINCT r."case_barcode",
       r."sample_type_name"
FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R35"  r
JOIN (
    SELECT "case_barcode"
    FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R35"
    WHERE "project_short_name" = 'TCGA-BRCA'
      AND "gene_type" = 'protein_coding'
    GROUP BY "case_barcode"
    HAVING COUNT(DISTINCT "sample_type_name") > 1
       AND BOOLOR_AGG("sample_type_name" ILIKE '%Solid%Tissue%Normal%')
) t
  ON r."case_barcode" = t."case_barcode"
WHERE r."project_short_name" = 'TCGA-BRCA'
  AND r."gene_type" = 'protein_coding'
ORDER BY r."case_barcode", r."sample_type_name"
LIMIT 20;
Answer:
case_barcode,sample_type_name
TCGA-BH-A203,Primary Tumor
TCGA-BH-A203,Solid Tissue Normal
Query:
--Description: 8) Retrieve distinct sample barcodes for each qualifying BRCA case (≥2 tissue types, incl. “Solid Tissue Normal”) so we can see multiple aliquots; ORDER BY the plain column name to avoid alias-scoping issues.
SELECT DISTINCT r."case_barcode",
       r."sample_barcode"
FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R35" r
JOIN (
    SELECT "case_barcode"
    FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R35"
    WHERE "project_short_name" = 'TCGA-BRCA'
      AND "gene_type" = 'protein_coding'
    GROUP BY "case_barcode"
    HAVING COUNT(DISTINCT "sample_type_name") > 1
       AND BOOLOR_AGG("sample_type_name" ILIKE '%Solid%Tissue%Normal%')
) t
  ON r."case_barcode" = t."case_barcode"
WHERE r."project_short_name" = 'TCGA-BRCA'
  AND r."gene_type" = 'protein_coding'
ORDER BY "case_barcode"
LIMIT 20
Answer:
case_barcode,sample_barcode
TCGA-BH-A203,TCGA-BH-A203-11A
TCGA-BH-A203,TCGA-BH-A203-01A
