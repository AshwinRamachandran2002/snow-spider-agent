--Description: Count how many TCGA-BRCA cases in the hg38 R35 RNA-Seq table have protein-coding data for BOTH “Primary Tumor” and “Solid Tissue Normal” tissue categories (i.e., each case has at least these two distinct tissue/sample types).
SELECT
    COUNT(*) AS "num_BRCACases_PrimaryTumor_AND_STN"
FROM (
