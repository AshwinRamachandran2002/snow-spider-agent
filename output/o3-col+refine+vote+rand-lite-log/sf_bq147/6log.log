--Description: 2) Preview a few BRCA cases with their tissue type labels (still protein-coding only) to confirm structure of the data.
SELECT DISTINCT "case_barcode",
       "sample_type_name"
FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R35"
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "gene_type" = 'protein_coding'
