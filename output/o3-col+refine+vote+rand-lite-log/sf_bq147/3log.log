Query:
--Description: For the cases found in the previous query, list all tissue types they possess
WITH multi_tissue AS (
  SELECT
    "case_barcode"
  FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R35
  WHERE "project_short_name" = 'TCGA-BRCA'
    AND "gene_type" = 'protein_coding'
  GROUP BY "case_barcode"
  HAVING 
    COUNT(DISTINCT "sample_type_name") > 1
    AND SUM( CASE WHEN "sample_type_name" ILIKE '%Solid%Tissue%Normal%' THEN 1 ELSE 0 END ) > 0
)
SELECT DISTINCT
  r35."case_barcode",
  r35."sample_type_name"
FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R35 r35
JOIN multi_tissue mt
  ON r35."case_barcode" = mt."case_barcode"
WHERE r35."project_short_name" = 'TCGA-BRCA'
  AND r35."gene_type" = 'protein_coding'
LIMIT 20;
Answer:
case_barcode,sample_type_name
