```

```sql
--Description: Count how many distinct sample types each BRCA case possesses
SELECT
  "case_barcode",
  COUNT(DISTINCT "sample_type_name") AS "distinct_sample_types"
FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R35
WHERE "project_short_name" = 'TCGA-BRCA'
GROUP BY "case_barcode"
LIMIT 20;
```

```sql
--Description: Identify BRCA cases that have more than one tissue type, including a Solid Tissue Normal sample
SELECT
  "case_barcode"
FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R35
WHERE "project_short_name" = 'TCGA-BRCA'
GROUP BY "case_barcode"
HAVING 
  COUNT(DISTINCT "sample_type_name") > 1
  AND SUM( CASE WHEN "sample_type_name" ILIKE '%Solid%Tissue%Normal%' THEN 1 ELSE 0 END ) > 0
LIMIT 20;
```

```sql
--Description: Same as above but keeping only rows where gene_type is ‘protein_coding’
SELECT
  "case_barcode"
FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R35
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "gene_type" = 'protein_coding'
GROUP BY "case_barcode"
HAVING 
  COUNT(DISTINCT "sample_type_name") > 1
  AND SUM( CASE WHEN "sample_type_name" ILIKE '%Solid%Tissue%Normal%' THEN 1 ELSE 0 END ) > 0
LIMIT 20;
```

```sql
--Description: For the cases found in the previous query, list all tissue types they possess
WITH multi_tissue AS (
  SELECT
    "case_barcode"
  FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R35
  WHERE "project_short_name" = 'TCGA-BRCA'
    AND "gene_type" = 'protein_coding'
  GROUP BY "case_barcode"
  HAVING 
    COUNT(DISTINCT "sample_type_name") > 1
    AND SUM( CASE WHEN "sample_type_name" ILIKE '%Solid%Tissue%Normal%' THEN 1 ELSE 0 END ) > 0
)
SELECT DISTINCT
  r35."case_barcode",
  r35."sample_type_name"
FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R35 r35
JOIN multi_tissue mt
  ON r35."case_barcode" = mt."case_barcode"
WHERE r35."project_short_name" = 'TCGA-BRCA'
  AND r35."gene_type" = 'protein_coding'
LIMIT 20;
```

```sql
--Description: Show how many ‘protein_coding’ rows each of those multi-tissue BRCA cases has
WITH target_cases AS (
  SELECT
    "case_barcode"
  FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R35
  WHERE "project_short_name" = 'TCGA-BRCA'
    AND "gene_type" = 'protein_coding'
  GROUP BY "case_barcode"
  HAVING 
    COUNT(DISTINCT "sample_type_name") > 1
    AND SUM( CASE WHEN "sample_type_name" ILIKE '%Solid%Tissue%Normal%' THEN 1 ELSE 0 END ) > 0
)
SELECT
  r35."case_barcode",
  COUNT(*) AS "protein_coding_rows"
FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R35 r35
JOIN target_cases t
  ON r35."case_barcode" = t."case_barcode"
WHERE r35."gene_type" = 'protein_coding'
GROUP BY r35."case_barcode"
LIMIT 20;
```

```sql
