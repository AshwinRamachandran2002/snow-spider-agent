TCGA-BH-A203,Primary Tumor
Query:
--Description: Show how many ‘protein_coding’ rows each of those multi-tissue BRCA cases has
WITH target_cases AS (
  SELECT
    "case_barcode"
  FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R35
  WHERE "project_short_name" = 'TCGA-BRCA'
    AND "gene_type" = 'protein_coding'
  GROUP BY "case_barcode"
  HAVING 
    COUNT(DISTINCT "sample_type_name") > 1
    AND SUM( CASE WHEN "sample_type_name" ILIKE '%Solid%Tissue%Normal%' THEN 1 ELSE 0 END ) > 0
)
SELECT
  r35."case_barcode",
  COUNT(*) AS "protein_coding_rows"
FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R35 r35
JOIN target_cases t
  ON r35."case_barcode" = t."case_barcode"
WHERE r35."gene_type" = 'protein_coding'
GROUP BY r35."case_barcode"
LIMIT 20;
Answer:
case_barcode,protein_coding_rows
TCGA-BH-A203,39924
Query:
--Description: Final extraction – list case barcodes and sample barcodes for protein-coding BRCA entries that have both Solid Tissue Normal and at least one other tissue type
WITH candidate_cases AS (
  SELECT
    "case_barcode"
  FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R35
  WHERE "project_short_name" = 'TCGA-BRCA'
    AND "gene_type" = 'protein_coding'
  GROUP BY "case_barcode"
  HAVING 
    COUNT(DISTINCT "sample_type_name") > 1
    AND SUM( CASE WHEN "sample_type_name" ILIKE '%Solid%Tissue%Normal%' THEN 1 ELSE 0 END ) > 0
)
SELECT DISTINCT
  r35."case_barcode",
  r35."sample_type_name"
FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R35 r35
JOIN candidate_cases c
  ON r35."case_barcode" = c."case_barcode"
WHERE r35."gene_type" = 'protein_coding'
  AND r35."project_short_name" = 'TCGA-BRCA'
LIMIT 20;
