```sql
--Description: Show the first few BRCA cases that have at least one “Solid Tissue Normal” sample
SELECT DISTINCT
  "case_barcode"
FROM TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R35
WHERE "project_short_name" = 'TCGA-BRCA'
