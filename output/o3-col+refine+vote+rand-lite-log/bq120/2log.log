Query:
--Description: Corrected “final answer” query – returns the 10 counties with the
--             largest SNAP-participating household totals on 2017-01-01 and the
--             ratio of ACS 2017 5-year households earning <$20 k to those SNAP
--             households.  We no longer rely on a non-existent `name` column in
--             the ACS table; instead, we keep the `county_name` parsed from the
--             SNAP GeoDesc field.

WITH snap AS (
  SELECT
    SUBSTR(GeoDesc, 1, 5)                           AS county_fips,
    ANY_VALUE(REGEXP_EXTRACT(GeoDesc, r'EBT (.+)$')) AS county_name,
    SUM(SNAP_All_Participation_Households)          AS snap_households_2017
  FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
  WHERE Date = '2017-01-01'
  GROUP BY county_fips
),
acs AS (
  SELECT
    geo_id                                          AS county_fips,
    (IFNULL(income_less_10000, 0) +
     IFNULL(income_10000_14999, 0) +
     IFNULL(income_15000_19999, 0))                 AS households_under_20k
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
),
joined AS (
  SELECT
    s.county_fips,
    s.county_name,
    s.snap_households_2017,
    a.households_under_20k,
    SAFE_DIVIDE(a.households_under_20k, s.snap_households_2017) AS ratio_under20k_to_snap
  FROM snap AS s
  JOIN acs  AS a USING (county_fips)
  WHERE s.snap_households_2017 > 0
)
SELECT
  county_name,
  county_fips,
  snap_households_2017,
  households_under_20k,
  ROUND(ratio_under20k_to_snap, 3) AS under20k_to_snap_ratio
FROM joined
ORDER BY snap_households_2017 DESC
LIMIT 10
Answer:
county_name,county_fips,snap_households_2017,households_under_20k,under20k_to_snap_ratio
