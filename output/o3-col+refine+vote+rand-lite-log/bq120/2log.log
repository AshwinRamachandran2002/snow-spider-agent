```sql
--Description / Thinking process:
-- • Objective: identify the 10 U.S. counties with the largest number of households
--   enrolled in SNAP on 2017-01-01, then compute the ratio of ACS 2017 5-year
--   households that earn < $20 000 to those SNAP households.
--
-- • SNAP source table (sdoh_snap_enrollment.snap_enrollment) is program-level; the
--   county FIPS code is the first 5 characters of GeoDesc.  We aggregate those rows
--   to county-level totals for the target date.
--   ▸ Extract county_fips (SUBSTR) and a readable county_name (everything after “EBT ”).
--
-- • ACS 2017 5-year county table provides household counts for several income bands.
--   We add the three relevant columns (<$10k, $10–14.9k, $15–19.9k) to obtain
--   households_under_20k for each county.
--
-- • Join the two datasets on county_fips, discard any county where the summed SNAP
--   households equals zero, compute the ratio, rank by SNAP households, and limit to 10.

WITH snap AS (
  SELECT
    SUBSTR(GeoDesc, 1, 5)                                         AS county_fips,
    ANY_VALUE(REGEXP_EXTRACT(GeoDesc, r'EBT (.+)$'))              AS county_name,
    SUM(SNAP_All_Participation_Households)                        AS snap_households_2017
  FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
  WHERE Date = '2017-01-01'
  GROUP BY county_fips
),
acs AS (
  SELECT
    geo_id                                                        AS county_fips,
    (IFNULL(income_less_10000, 0) +
     IFNULL(income_10000_14999, 0) +
     IFNULL(income_15000_19999, 0))                               AS households_under_20k
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
)
SELECT
  s.county_fips,
  s.county_name,
  s.snap_households_2017,
  a.households_under_20k,
  ROUND(SAFE_DIVIDE(a.households_under_20k, s.snap_households_2017), 3) AS under20k_to_snap_ratio
FROM snap AS s
JOIN acs  AS a USING (county_fips)
WHERE s.snap_households_2017 > 0
ORDER BY s.snap_households_2017 DESC
LIMIT 10;
```
