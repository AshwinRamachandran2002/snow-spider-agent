```sql
--1. Peek at the 2017 5-year ACS county table to see the income and household related columns
SELECT 
  geo_id,
  households,
  income_less_10000,
  income_10000_14999,
  income_15000_19999
FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
LIMIT 20;
```

```sql
--2. Look at SNAP enrollment rows that fall on 2017-01-01
SELECT 
  GeoDesc,
  SNAP_All_Participation_Households,
  Date
FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
WHERE Date = '2017-01-01'
LIMIT 20;
```

```sql
--3. Pull distinct GeoDesc prefixes (first 5 digits = state-county FIPS)   
SELECT DISTINCT 
  SUBSTR(GeoDesc,1,5) AS county_fips
FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
WHERE Date = '2017-01-01'
LIMIT 20;
```

```sql
--4. Aggregate total SNAP-participating households by county FIPS for 2017-01-01
SELECT
  SUBSTR(GeoDesc,1,5)            AS county_fips,
  SUM(SNAP_All_Participation_Households) AS snap_households_2017
FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
WHERE Date = '2017-01-01'
GROUP BY county_fips
LIMIT 20;
```

```sql
--5. Assemble 2017 ACS income figures (<$20K) by county
SELECT
  geo_id AS county_fips,
  (IFNULL(income_less_10000,0) +
   IFNULL(income_10000_14999,0) +
   IFNULL(income_15000_19999,0)) AS acs_households_under_20k
FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
LIMIT 20;
```

```sql
--6. Join SNAP totals to ACS income counts (exclude SNAP total = 0)
SELECT
  s.county_fips,
  s.snap_households_2017,
  a.acs_households_under_20k
FROM (
  SELECT
    SUBSTR(GeoDesc,1,5)  AS county_fips,
    SUM(SNAP_All_Participation_Households) AS snap_households_2017
  FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
  WHERE Date = '2017-01-01'
  GROUP BY county_fips
) AS s
JOIN (
  SELECT
    geo_id AS county_fips,
    (IFNULL(income_less_10000,0) +
     IFNULL(income_10000_14999,0) +
     IFNULL(income_15000_19999,0)) AS acs_households_under_20k
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
) AS a
USING (county_fips)
WHERE s.snap_households_2017 > 0
LIMIT 20;
```

```sql
--7. Compute the ratio of <20K-income households to SNAP participating households
SELECT
  county_fips,
  snap_households_2017,
  acs_households_under_20k,
  SAFE_DIVIDE(acs_households_under_20k, snap_households_2017) AS under20k_to_snap_ratio
FROM (
  -- result of query 6
  SELECT
    s.county_fips,
    s.snap_households_2017,
    a.acs_households_under_20k
  FROM (
    SELECT
      SUBSTR(GeoDesc,1,5)  AS county_fips,
      SUM(SNAP_All_Participation_Households) AS snap_households_2017
    FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
    WHERE Date = '2017-01-01'
    GROUP BY county_fips
  ) AS s
  JOIN (
    SELECT
      geo_id AS county_fips,
      (IFNULL(income_less_10000,0) +
       IFNULL(income_10000_14999,0) +
       IFNULL(income_15000_19999,0)) AS acs_households_under_20k
    FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
  ) AS a
  USING (county_fips)
  WHERE s.snap_households_2017 > 0
)
LIMIT 20;
```

```sql
--8. Order counties by total SNAP households (descending) and pick the top 10
SELECT
  county_fips,
  snap_households_2017,
  acs_households_under_20k,
  SAFE_DIVIDE(acs_households_under_20k, snap_households_2017) AS under20k_to_snap_ratio
FROM (
  -- same sub-query block as in query 7
  SELECT
    s.county_fips,
    s.snap_households_2017,
    a.acs_households_under_20k
  FROM (
    SELECT
      SUBSTR(GeoDesc,1,5)  AS county_fips,
      SUM(SNAP_All_Participation_Households) AS snap_households_2017
    FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
    WHERE Date = '2017-01-01'
    GROUP BY county_fips
  ) AS s
  JOIN (
    SELECT
      geo_id AS county_fips,
      (IFNULL(income_less_10000,0) +
       IFNULL(income_10000_14999,0) +
       IFNULL(income_15000_19999,0)) AS acs_households_under_20k
    FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
  ) AS a
  USING (county_fips)
  WHERE s.snap_households_2017 > 0
)
ORDER BY snap_households_2017 DESC
LIMIT 10;
```

```sql
--9. Enrich the top 10 list with county names (the ACS table has a "name" column)
SELECT
  top10.county_fips,
  acs.name AS county_name,
  top10.snap_households_2017,
  top10.acs_households_under_20k,
  top10.under20k_to_snap_ratio
FROM (
  -- query 8 without the LIMIT so we can join, then keep top 10
  SELECT
    county_fips,
    snap_households_2017,
    acs_households_under_20k,
    SAFE_DIVIDE(acs_households_under_20k, snap_households_2017) AS under20k_to_snap_ratio
  FROM (
    SELECT
      s.county_fips,
      s.snap_households_2017,
      a.acs_households_under_20k
    FROM (
      SELECT
        SUBSTR(GeoDesc,1,5)  AS county_fips,
        SUM(SNAP_All_Participation_Households) AS snap_households_2017
      FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
      WHERE Date = '2017-01-01'
      GROUP BY county_fips
    ) AS s
    JOIN (
      SELECT
        geo_id AS county_fips,
        (IFNULL(income_less_10000,0) +
         IFNULL(income_10000_14999,0) +
         IFNULL(income_15000_19999,0)) AS acs_households_under_20k
      FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
    ) AS a
    USING (county_fips)
    WHERE s.snap_households_2017 > 0
  )
  ORDER BY snap_households_2017 DESC
  LIMIT 10
) AS top10
JOIN `bigquery-public-data.census_bureau_acs.county_2017_5yr` AS acs
ON acs.geo_id = top10.county_fips
ORDER BY top10.snap_households_2017 DESC;
```

```sql
--10. Final succinct answer: top 10 counties with highest SNAP households (2017),
--    plus ratio of <$20K income households to SNAP households
SELECT
  acs.name                             AS county_name,
  top10.county_fips,
  top10.snap_households_2017,
  top10.acs_households_under_20k,
  ROUND(top10.under20k_to_snap_ratio,3) AS under20k_to_snap_ratio
FROM (
  SELECT
    county_fips,
    snap_households_2017,
    acs_households_under_20k,
    SAFE_DIVIDE(acs_households_under_20k, snap_households_2017) AS under20k_to_snap_ratio
  FROM (
    SELECT
      s.county_fips,
      s.snap_households_2017,
      a.acs_households_under_20k
    FROM (
      SELECT
        SUBSTR(GeoDesc,1,5)  AS county_fips,
        SUM(SNAP_All_Participation_Households) AS snap_households_2017
      FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
      WHERE Date = '2017-01-01'
      GROUP BY county_fips
    ) AS s
    JOIN (
      SELECT
        geo_id AS county_fips,
        (IFNULL(income_less_10000,0) +
         IFNULL(income_10000_14999,0) +
         IFNULL(income_15000_19999,0)) AS acs_households_under_20k
      FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
    ) AS a
    USING (county_fips)
    WHERE s.snap_households_2017 > 0
  )
  ORDER BY snap_households_2017 DESC
  LIMIT 10
) AS top10
JOIN `bigquery-public-data.census_bureau_acs.county_2017_5yr` AS acs
ON acs.geo_id = top10.county_fips
ORDER BY top10.snap_households_2017 DESC;
```
