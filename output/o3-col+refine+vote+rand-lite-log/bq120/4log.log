Query:
--Description: Retrieve the top 10 counties with the highest SNAP totals and the requested ratio
SELECT
  county_fips,
  snap_households,
  households_under_20k,
  ROUND(under20k_to_snap_ratio, 4) AS under20k_to_snap_ratio
FROM (
  SELECT
    a.county_fips,
    s.snap_households,
    a.households_under_20k,
    a.households_under_20k / s.snap_households AS under20k_to_snap_ratio
  FROM (
    SELECT
      geo_id AS county_fips,
      (income_less_10000 + income_10000_14999 + income_15000_19999) AS households_under_20k
    FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
  ) AS a
  JOIN (
    SELECT 
      SUBSTR(GeoDesc, 1, 5) AS county_fips,
      SUM(SNAP_All_Participation_Households) AS snap_households
    FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
    WHERE Date = '2017-01-01'
    GROUP BY county_fips
    HAVING SUM(SNAP_All_Participation_Households) > 0
  ) AS s
  USING (county_fips)
)
ORDER BY snap_households DESC
LIMIT 10;
