```sql
--Description / Thinking process:
--Objective: Produce the 10 U.S. counties with the highest total number of SNAP-participating
--households on 1-Jan-2017, along with
--  • county FIPS code
--  • a readable county name
--  • SNAP-participating households (snap_households)
--  • ACS-estimated households earning < $20 000 (households_under_20k)
--  • ratio = households_under_20k ÷ snap_households
--
--Approach inside ONE query (no external CTEs required by caller):
-- 1.  From the SNAP table (sdoh_snap_enrollment.snap_enrollment):
--     – Restrict to Date = '2017-01-01'.
--     – county_fips = first 5 characters of GeoDesc.
--     – Aggregate SNAP_All_Participation_Households by county_fips.
--     – Retain ANY_VALUE(GeoDesc) for name extraction.
-- 2.  From the 2017 5-year ACS county table (census_bureau_acs.county_2017_5yr):
--     – Compute households_under_20k as the sum of income brackets below $20 000.
-- 3.  JOIN the two derived sub-tables on county_fips.
-- 4.  Extract a readable county name from ANY_VALUE(GeoDesc) using REGEXP_EXTRACT.
-- 5.  Compute the ratio, order by snap_households descending, limit 10.

SELECT
  s.county_fips,
  REGEXP_EXTRACT(s.any_desc, r' ([A-Za-z''\- ]+)$')           AS county_name,
  s.snap_households,
  a.households_under_20k,
  ROUND(a.households_under_20k / s.snap_households, 4)        AS under20k_to_snap_ratio
FROM (
  -- Step-1: SNAP totals for 1-Jan-2017
  SELECT
    SUBSTR(GeoDesc, 1, 5)                                   AS county_fips,
    SUM(SNAP_All_Participation_Households)                  AS snap_households,
    ANY_VALUE(GeoDesc)                                      AS any_desc
  FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
  WHERE Date = '2017-01-01'
  GROUP BY county_fips
  HAVING snap_households > 0
) AS s
JOIN (
  -- Step-2: ACS households under $20 k
  SELECT
    geo_id                                                  AS county_fips,
    (income_less_10000 + income_10000_14999 + income_15000_19999)
                                                            AS households_under_20k
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
) AS a
USING (county_fips)
ORDER BY s.snap_households DESC
LIMIT 10;
```
