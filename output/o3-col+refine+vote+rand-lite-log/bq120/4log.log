--Description / Thinking process:
--Return one result-set that answers the task:
--  • Identify the 10 counties with the highest number of SNAP-participating
--    households on 2017-01-01 (SNAP table).
--  • For each county, bring in the 2017 5-year ACS count of households
--    whose income is below $20 000 and compute the ratio.
--  • Build a readable county name by stripping the leading “FIPS  STATE  PROGRAM ”
--    segments from GeoDesc (e.g. “0603710 CA EBT LOS ANGELES” → “LOS ANGELES”).
--
--Inside this single query we:
-- 1) Aggregate SNAP data (subquery s): first 5 chars of GeoDesc = county FIPS,
--    sum SNAP households, keep ANY_VALUE(GeoDesc) for name extraction.
-- 2) Aggregate ACS data (subquery a): sum the three income brackets < $20 k.
-- 3) Join on county_fips, calculate ratio, order by SNAP households, limit 10.

SELECT
  s.county_fips,
  REGEXP_REPLACE(s.any_desc, r'^\d+\s+[A-Z]{2}\s+\S+\s+', '') AS county_name,
  s.snap_households,
  a.households_under_20k,
  ROUND(a.households_under_20k / s.snap_households, 4)        AS under20k_to_snap_ratio
FROM (
    -- (1) SNAP totals per county on 1-Jan-2017
    SELECT
      SUBSTR(GeoDesc, 1, 5)                       AS county_fips,
      SUM(SNAP_All_Participation_Households)      AS snap_households,
      ANY_VALUE(GeoDesc)                          AS any_desc
    FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
    WHERE Date = '2017-01-01'
    GROUP BY county_fips
    HAVING snap_households > 0
) AS s
JOIN (
    -- (2) ACS households earning < $20 000
    SELECT
      geo_id                                      AS county_fips,
      (income_less_10000 +
       income_10000_14999 +
       income_15000_19999)                        AS households_under_20k
    FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
) AS a
USING (county_fips)
ORDER BY s.snap_households DESC
LIMIT 10;
