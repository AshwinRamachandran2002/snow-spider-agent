```sql
--Description: Look at SNAP enrollment records on 2017-01-01 to verify the GeoDesc pattern and values.
SELECT
  GeoDesc,
  SNAP_All_Participation_Households,
  Date
FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
WHERE Date = '2017-01-01'
LIMIT 20;
```

```sql
--Description: Aggregate total SNAP-participating households by county
--           (first 5 characters of GeoDesc are the 5-digit county FIPS).
SELECT
  SUBSTR(GeoDesc,1,5) AS county_fips,
  SUM(SNAP_All_Participation_Households) AS snap_households_20170101
FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
WHERE Date = '2017-01-01'
GROUP BY county_fips
ORDER BY snap_households_20170101 DESC
LIMIT 20;
```

```sql
--Description: Join the aggregated SNAP numbers with ACS data and compute
--             the count of households earning under $20 000 (sample rows).
WITH snap AS (
  SELECT
    SUBSTR(GeoDesc,1,5) AS county_fips,
    SUM(SNAP_All_Participation_Households) AS snap_households
  FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
  WHERE Date = '2017-01-01'
  GROUP BY county_fips
)
SELECT
  c.geo_id,
  snap.snap_households,
  c.income_less_10000 + c.income_10000_14999 + c.income_15000_19999 AS households_under_20k
FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr` AS c
JOIN snap
  ON c.geo_id = snap.county_fips
LIMIT 20;
```

```sql
--Description: Final result – top 10 counties with the highest SNAP-participating
--             household totals (2017-01-01) and the ratio of households earning
--             under $20 000 to total SNAP households, excluding zero-SNAP counties.
WITH snap AS (
  SELECT
    SUBSTR(GeoDesc,1,5) AS county_fips,
    SUM(SNAP_All_Participation_Households) AS snap_households
  FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
  WHERE Date = '2017-01-01'
  GROUP BY county_fips
),
acs AS (
  SELECT
    geo_id,
    income_less_10000,
    income_10000_14999,
    income_15000_19999
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
)
SELECT
  snap.county_fips                     AS geo_id,
  snap.snap_households                 AS total_snap_households,
  (acs.income_less_10000
   + acs.income_10000_14999
   + acs.income_15000_19999)           AS households_under_20k,
  SAFE_DIVIDE(
    (acs.income_less_10000
     + acs.income_10000_14999
     + acs.income_15000_19999),
    snap.snap_households
  )                                    AS under_20k_to_snap_ratio
FROM snap
JOIN acs
  ON snap.county_fips = acs.geo_id
WHERE snap.snap_households > 0
ORDER BY snap.snap_households DESC
LIMIT 10;
```
