Query:
--Description: Join the aggregated SNAP numbers with ACS data and compute
--             the count of households earning under $20 000 (sample rows).
WITH snap AS (
  SELECT
    SUBSTR(GeoDesc,1,5) AS county_fips,
    SUM(SNAP_All_Participation_Households) AS snap_households
  FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
  WHERE Date = '2017-01-01'
  GROUP BY county_fips
)
SELECT
  c.geo_id,
  snap.snap_households,
  c.income_less_10000 + c.income_10000_14999 + c.income_15000_19999 AS households_under_20k
FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr` AS c
JOIN snap
  ON c.geo_id = snap.county_fips
LIMIT 20;
