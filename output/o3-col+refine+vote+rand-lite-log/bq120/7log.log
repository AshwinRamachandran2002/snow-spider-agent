```

```sql
--Description: Compute “households earning < $20 000” for every county
SELECT
  `geo_id`                                                     AS county_fips,
  (`income_less_10000` + `income_10000_14999` + `income_15000_19999`)
     AS households_under_20000
FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
LIMIT 20;
```

```sql
--Description: Join SNAP totals with ACS income data to examine ratios (top 20 counties)
WITH snap AS (
  SELECT
    SUBSTR(`GeoDesc`,1,5) AS county_fips,
    SUM(`SNAP_All_Participation_Households`) AS total_snap_households
  FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
  WHERE `Date` = '2017-01-01'
  GROUP BY county_fips
  HAVING total_snap_households>0
)
SELECT
  s.county_fips,
  c.households,
  c.income_less_10000,
  c.income_10000_14999,
  c.income_15000_19999,
  (c.income_less_10000 + c.income_10000_14999 + c.income_15000_19999) AS households_under_20000,
  s.total_snap_households,
  SAFE_DIVIDE((c.income_less_10000 + c.income_10000_14999 + c.income_15000_19999),
              s.total_snap_households)                               AS ratio_under20k_to_snap
FROM snap AS s
JOIN `bigquery-public-data.census_bureau_acs.county_2017_5yr` AS c
ON  s.county_fips = c.geo_id
ORDER BY s.total_snap_households DESC
LIMIT 20;
```

```sql
--Description: FINAL answer – top-10 counties by SNAP households (1-Jan-2017)
WITH snap AS (
  SELECT
    SUBSTR(`GeoDesc`,1,5) AS county_fips,
    SUM(`SNAP_All_Participation_Households`) AS total_snap_households
  FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
  WHERE `Date` = '2017-01-01'
  GROUP BY county_fips
  HAVING total_snap_households>0
),
acs AS (
  SELECT
    `geo_id` AS county_fips,
    (`income_less_10000` + `income_10000_14999` + `income_15000_19999`)
      AS households_under_20000
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
)
SELECT
  s.county_fips,
  s.total_snap_households,
  a.households_under_20000,
  ROUND(
        SAFE_DIVIDE(a.households_under_20000, s.total_snap_households), 3
       )                                                          AS ratio_under20k_to_snap
FROM snap AS s
JOIN acs  AS a
ON  s.county_fips = a.county_fips
ORDER BY s.total_snap_households DESC
LIMIT 10;
```
