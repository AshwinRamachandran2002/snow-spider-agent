```sql
--Description:  One-step solution (thinking process embedded as comments)  
--              1) snap17 CTE  – Pull January-1-2017 SNAP enrollment, parse first five
--                 characters of GeoDesc as county FIPS, sum to get total SNAP-participating
--                 households per county.  
--              2) acs17 CTE   – From the 2017 5-year ACS county table, add the three
--                 low-income buckets (<$10k, $10k-14,999, $15k-19,999) to obtain
--                 “households under $20k” for each county.  
--              3) Final SELECT – Join the two CTEs on county FIPS, exclude counties with
--                 zero SNAP households, compute the ratio of “<20k households” to total
--                 SNAP households, then return the ten counties with the largest SNAP
--                 household counts.
WITH snap17 AS (  -- 1) SNAP households on 2017-01-01, aggregated to county
  SELECT
    SUBSTR(`GeoDesc`, 1, 5) AS county_fips,
    SUM(`SNAP_All_Participation_Households`) AS snap_households
  FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
  WHERE `Date` = '2017-01-01'
  GROUP BY county_fips
),
acs17 AS (  -- 2) Households earning under $20k from ACS
  SELECT
    `geo_id`,
    (IFNULL(`income_less_10000`,      0) +
     IFNULL(`income_10000_14999`,     0) +
     IFNULL(`income_15000_19999`,     0)) AS hh_under_20k
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
)
SELECT  -- 3) Combine, compute ratio, show top 10 by SNAP participation
  s.county_fips                             AS county_geo_id,
  s.snap_households                         AS total_snap_households,
  a.hh_under_20k                            AS households_under_20k_income,
  SAFE_DIVIDE(a.hh_under_20k, s.snap_households) AS under20k_to_snap_ratio
FROM snap17 AS s
JOIN acs17  AS a
  ON a.geo_id = s.county_fips
WHERE s.snap_households > 0
ORDER BY s.snap_households DESC
LIMIT 10;
```
