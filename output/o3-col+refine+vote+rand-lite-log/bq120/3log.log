```sql
-- 6. Focus on the income buckets we care about for one county  
--    (less than $10k, $10k–14,999, $15k–19,999) plus total households
SELECT geo_id,
       households,
       income_less_10000,
       income_10000_14999,
       income_15000_19999
FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
WHERE geo_id IN ('01001','06037')   -- example FIPS: Autauga AL, Los Angeles CA
LIMIT 20;
```

```sql
-- 7. Derive “households under $20k” for every county in the ACS table
SELECT geo_id,
       (IFNULL(income_less_10000,0) +
        IFNULL(income_10000_14999,0) +
        IFNULL(income_15000_19999,0)) AS hh_under_20k
FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
LIMIT 20;
```

```sql
-- 8. Join January-2017 SNAP totals to the ACS under-$20k measure  
--    (keep only counties that have >0 SNAP households) – quick 20-row preview
WITH snap17 AS (
  SELECT SUBSTR(GeoDesc,1,5) AS county_fips,
         SUM(SNAP_All_Participation_Households) AS snap_households
  FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
  WHERE Date = '2017-01-01'
  GROUP BY county_fips
)
SELECT s.county_fips,
       s.snap_households,
       a.households,
       (IFNULL(a.income_less_10000,0) +
        IFNULL(a.income_10000_14999,0) +
        IFNULL(a.income_15000_19999,0)) AS hh_under_20k
FROM snap17 AS s
JOIN `bigquery-public-data.census_bureau_acs.county_2017_5yr` AS a
  ON a.geo_id = s.county_fips
WHERE s.snap_households > 0
LIMIT 20;
```

```sql
-- 9. Compute the ratio “households earning < $20k” ÷ “SNAP households”  
--    for every county, then list the top-10 counties by SNAP households
WITH snap17 AS (
  SELECT SUBSTR(GeoDesc,1,5) AS county_fips,
         SUM(SNAP_All_Participation_Households) AS snap_households
  FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
  WHERE Date = '2017-01-01'
  GROUP BY county_fips
),
acs17 AS (
  SELECT geo_id,
         (IFNULL(income_less_10000,0) +
          IFNULL(income_10000_14999,0) +
          IFNULL(income_15000_19999,0)) AS hh_under_20k
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
)
SELECT s.county_fips                     AS county_geo_id,
       s.snap_households                 AS total_snap_households,
       a.hh_under_20k                    AS households_under_20k_income,
       SAFE_DIVIDE(a.hh_under_20k , s.snap_households) AS under20k_to_snap_ratio
FROM snap17 AS s
JOIN acs17 AS a
  ON a.geo_id = s.county_fips
WHERE s.snap_households > 0
ORDER BY s.snap_households DESC
LIMIT 10;
```

