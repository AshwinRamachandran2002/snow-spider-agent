```sql
--Description:
-- Goal: “Identify the top-10 counties with the greatest number of SNAP-participating
--        households (Jan-1-2017) and compute the ratio of households earning
--        < $20 000 to those SNAP households, omitting any county with zero SNAP.”
--
-- Thinking process
-- 1)  SNAP data are stored as one record per “GeoDesc” (which begins with the
--     five-digit county FIPS).  We therefore SUBSTR(GeoDesc,1,5) to obtain a
--     county code and SUM the ‘SNAP_All_Participation_Households’ for the 2017-01-01
--     snapshot, filtering out totals that equal 0.
-- 2)  2017 5-year ACS county file supplies total households plus three income
--     brackets that together represent households earning < $20 000:
--            • income_less_10000
--            • income_10000_14999
--            • income_15000_19999
--     COALESCE replaces NULL with 0 so summation is safe.
-- 3)  Join the two sub-results on the county FIPS, calculate
--        households_under_20k / snap_households   as the desired ratio.
-- 4)  Order by SNAP size descending and LIMIT 10.
WITH snap_2017 AS (
  SELECT
    SUBSTR(GeoDesc, 1, 5)                         AS county_fips,
    SUM(SNAP_All_Participation_Households)        AS snap_households
  FROM `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
  WHERE Date = '2017-01-01'
  GROUP BY county_fips
  HAVING snap_households > 0
)
SELECT
  c.geo_id                                        AS county_fips,
  s.snap_households,
  COALESCE(c.income_less_10000,   0) +
  COALESCE(c.income_10000_14999,  0) +
  COALESCE(c.income_15000_19999,  0)              AS households_under_20k,
  ROUND(
    (COALESCE(c.income_less_10000,   0) +
     COALESCE(c.income_10000_14999,  0) +
     COALESCE(c.income_15000_19999,  0)) /
    s.snap_households, 4)                         AS under20k_to_snap_ratio
FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr` AS c
JOIN snap_2017 AS s
  ON c.geo_id = s.county_fips
ORDER BY s.snap_households DESC
LIMIT 10;
```
