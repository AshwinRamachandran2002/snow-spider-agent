```sql
--Description: Take a quick look at January 1 2017 SNAP-enrollment records to confirm the
--             structure of GeoDesc and the participation-household field.  
SELECT GeoDesc,
       SNAP_All_Participation_Households
FROM   `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
WHERE  Date = '2017-01-01'
LIMIT  20;
```

```sql
--Description: Extract the first five characters of GeoDesc (county FIPS), aggregate the
--             January 1 2017 SNAP-participating households by county.  
SELECT SUBSTR(GeoDesc, 1, 5)                      AS county_fips,
       SUM(SNAP_All_Participation_Households)     AS snap_households_20170101
FROM   `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
WHERE  Date = '2017-01-01'
GROUP  BY county_fips
HAVING snap_households_20170101 > 0
LIMIT  20;
```

```sql
--Description: Compute the number of households earning < $20 000 in each county
--             (≤ $10 000  +  $10 000-14 999  +  $15 000-19 999).  
SELECT geo_id                                        AS county_fips,
       households,
       SAFE_COALESCE(income_less_10000, 0)
     + SAFE_COALESCE(income_10000_14999, 0)
     + SAFE_COALESCE(income_15000_19999, 0)          AS households_under_20k
FROM   `bigquery-public-data.census_bureau_acs.county_2017_5yr`
LIMIT  20;
```

```sql
--Description: Join the January 1 2017 SNAP data with ACS income data, keep counties
--             with at least one SNAP household, and calculate the ratio of
--             under-$20 000 households to SNAP households.  
SELECT c.geo_id                                                            AS county_fips,
       s.snap_households_20170101                                          AS snap_households,
       (SAFE_COALESCE(c.income_less_10000,   0)
      + SAFE_COALESCE(c.income_10000_14999, 0)
      + SAFE_COALESCE(c.income_15000_19999, 0))                            AS households_under_20k,
       ROUND( (SAFE_COALESCE(c.income_less_10000,   0)
             + SAFE_COALESCE(c.income_10000_14999, 0)
             + SAFE_COALESCE(c.income_15000_19999, 0))
             / s.snap_households_20170101 , 4)                             AS under20k_to_snap_ratio
FROM   `bigquery-public-data.census_bureau_acs.county_2017_5yr` AS c
JOIN  (
        SELECT SUBSTR(GeoDesc, 1, 5) AS county_fips,
               SUM(SNAP_All_Participation_Households) AS snap_households_20170101
        FROM   `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
        WHERE  Date = '2017-01-01'
        GROUP  BY county_fips
        HAVING snap_households_20170101 > 0
      ) AS s
ON     c.geo_id = s.county_fips
LIMIT  20;
```

```sql
--Description: Produce the final answer – the 10 counties with the highest number of
--             SNAP-participating households (Jan 1 2017 snapshot), together with the
--             ratio of households earning < $20 000 to total SNAP households.  
SELECT c.geo_id                                                            AS county_fips,
       s.snap_households_20170101                                          AS snap_households,
       (SAFE_COALESCE(c.income_less_10000,   0)
      + SAFE_COALESCE(c.income_10000_14999, 0)
      + SAFE_COALESCE(c.income_15000_19999, 0))                            AS households_under_20k,
       ROUND( (SAFE_COALESCE(c.income_less_10000,   0)
             + SAFE_COALESCE(c.income_10000_14999, 0)
             + SAFE_COALESCE(c.income_15000_19999, 0))
             / s.snap_households_20170101 , 4)                             AS under20k_to_snap_ratio
FROM   `bigquery-public-data.census_bureau_acs.county_2017_5yr` AS c
JOIN  (
        SELECT SUBSTR(GeoDesc, 1, 5) AS county_fips,
               SUM(SNAP_All_Participation_Households) AS snap_households_20170101
        FROM   `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
        WHERE  Date = '2017-01-01'
        GROUP  BY county_fips
        HAVING snap_households_20170101 > 0
      ) AS s
ON     c.geo_id = s.county_fips
ORDER  BY s.snap_households_20170101 DESC
LIMIT  10;
```
