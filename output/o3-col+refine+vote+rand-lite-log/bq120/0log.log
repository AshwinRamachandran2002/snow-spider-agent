```sql
-- 4. Pull SNAP household counts for the single date we need
SELECT GeoDesc,
       SNAP_All_Participation_Households
FROM   `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
WHERE  Date = '2017-01-01'
LIMIT 20;
```

```sql
-- 5. Aggregate SNAP households to the county-FIPS level (first 5 chars of GeoDesc)
SELECT SUBSTR(GeoDesc,1,5)                          AS county_fips,
       SUM(SNAP_All_Participation_Households)       AS snap_households
FROM   `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
WHERE  Date = '2017-01-01'
GROUP  BY county_fips
ORDER  BY snap_households DESC
LIMIT 20;
```

```sql
-- 6. Compute households earning under $20 000 in each county (ACS)
SELECT geo_id,
       income_less_10000
     + income_10000_14999
     + income_15000_19999                       AS households_under_20k,
       households                               AS total_households
FROM   `bigquery-public-data.census_bureau_acs.county_2017_5yr`
LIMIT 20;
```

```sql
-- 7. Join ACS with the SNAP aggregation to get counts & ratios (no filtering yet)
SELECT c.geo_id,
       s.snap_households,
       (c.income_less_10000
      +  c.income_10000_14999
      +  c.income_15000_19999)                  AS households_under_20k,
       (c.income_less_10000
      +  c.income_10000_14999
      +  c.income_15000_19999)
/ s.snap_households                             AS ratio_under20k_to_snap
FROM  `bigquery-public-data.census_bureau_acs.county_2017_5yr` AS c
JOIN (
        SELECT SUBSTR(GeoDesc,1,5) AS county_fips,
               SUM(SNAP_All_Participation_Households) AS snap_households
        FROM   `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
        WHERE  Date = '2017-01-01'
        GROUP  BY county_fips
     ) AS s
ON   c.geo_id = s.county_fips
LIMIT 20;
```

```sql
-- 8. Same as #7, but remove counties with zero SNAP & keep the 10 largest SNAP totals
SELECT c.geo_id                         AS county_fips,
       s.snap_households,
       (c.income_less_10000
      +  c.income_10000_14999
      +  c.income_15000_19999)          AS households_under_20k,
       SAFE_DIVIDE(
          (c.income_less_10000
         + c.income_10000_14999
         + c.income_15000_19999),
          s.snap_households             ) AS ratio_under20k_to_snap
FROM  `bigquery-public-data.census_bureau_acs.county_2017_5yr` AS c
JOIN (
        SELECT SUBSTR(GeoDesc,1,5) AS county_fips,
               SUM(SNAP_All_Participation_Households) AS snap_households
        FROM   `bigquery-public-data.sdoh_snap_enrollment.snap_enrollment`
        WHERE  Date = '2017-01-01'
        GROUP  BY county_fips
        HAVING SUM(SNAP_All_Participation_Households) > 0
     ) AS s
ON   c.geo_id = s.county_fips
ORDER BY s.snap_households DESC
LIMIT 10;
```

