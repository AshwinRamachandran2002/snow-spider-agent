-- 4) Drill down into the hierarchy of one chosen top–level package (example: 521)
WITH RECURSIVE pack_tree(package_id, item_id, qty, lvl) AS (
      SELECT pr.packaging_id,
             pr.contains_id,
             pr.qty,
             1
      FROM   packaging_relations AS pr
      WHERE  pr.packaging_id = 521           -- << replace with a top-level id to explore
      UNION ALL
      SELECT pt.package_id,
             pr.contains_id,
             pt.qty * pr.qty,                -- cascade quantity multiplication
             pt.lvl + 1
      FROM   pack_tree         AS pt
      JOIN   packaging_relations AS pr
             ON pr.packaging_id = pt.item_id
)
SELECT *
FROM   pack_tree
LIMIT 20;
