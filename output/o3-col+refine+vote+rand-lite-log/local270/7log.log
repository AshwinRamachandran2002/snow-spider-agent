Query:
--Description:  Build and display the full hierarchy (all nested levels) for every
--              top-level container that holds some item whose accumulated quantity
--              exceeds 500.  The CTE sequence:
--              • top_pkg   – packages that never appear as contains_id (true roots)
--              • hier      – walk every root’s tree, multiplying quantities
--              • agg       – keep (top_id , item_id) pairs whose total > 500
--              • toplevel  – the root-ids that met that >500 criterion
--              • tree      – walk the hierarchy again but only for those roots,
--                             giving qty per path and depth level (lvl)
WITH RECURSIVE
top_pkg AS (                         -- real top-level containers
    SELECT id, name
    FROM   packaging
    WHERE  id NOT IN (SELECT contains_id FROM packaging_relations)
),
hier AS (                            -- walk complete tree for every top-level
    SELECT pr.packaging_id AS top_id,
           pr.contains_id  AS item_id,
           pr.qty          AS qty
    FROM   packaging_relations pr
    WHERE  pr.packaging_id IN (SELECT id FROM top_pkg)
    UNION ALL
    SELECT h.top_id,
           pr.contains_id,
           h.qty * pr.qty
    FROM   hier h
    JOIN   packaging_relations pr
           ON pr.packaging_id = h.item_id
),
agg AS (                             -- totals per (top_id , leaf item)
    SELECT top_id,
           item_id,
           SUM(qty) AS total_qty
    FROM   hier
    GROUP BY top_id, item_id
    HAVING total_qty > 500
),
toplevel AS (                        -- the root ids that satisfied >500 rule
    SELECT DISTINCT top_id
    FROM   agg
),
tree AS (                            -- walk the hierarchy again but only for them
    SELECT tp.top_id,
           pr.contains_id AS item_id,
           pr.qty         AS qty_per_container,
           1              AS lvl
    FROM   toplevel tp
    JOIN   packaging_relations pr
           ON pr.packaging_id = tp.top_id
    UNION ALL
    SELECT t.top_id,
           pr.contains_id,
           t.qty_per_container * pr.qty,
           t.lvl + 1
    FROM   tree t
    JOIN   packaging_relations pr
           ON pr.packaging_id = t.item_id
)
SELECT t.top_id                              AS container_id,
       pc.name                               AS container_name,
       pi.name                               AS item_name,
       t.qty_per_container                   AS qty_per_container,
       t.lvl                                 AS level
FROM   tree t
JOIN   packaging pc ON pc.id = t.top_id
JOIN   packaging pi ON pi.id = t.item_id
ORDER BY t.top_id, t.lvl, pi.name
LIMIT 20
