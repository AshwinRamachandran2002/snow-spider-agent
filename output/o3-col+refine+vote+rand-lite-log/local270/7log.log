Query:
-- 7) Show the names of both the container and the corresponding “item” whose total > 500
WITH RECURSIVE
top_pkg AS (
      SELECT p.id, p.name
      FROM   packaging AS p
      LEFT  JOIN packaging_relations pr
             ON p.id = pr.contains_id
      WHERE  pr.packaging_id IS NULL
),
hier AS (
      SELECT pr.packaging_id AS top_id,
             pr.contains_id AS item_id,
             pr.qty         AS qty
      FROM   packaging_relations AS pr
      WHERE  pr.packaging_id IN (SELECT id FROM top_pkg)
      UNION ALL
      SELECT h.top_id,
             pr.contains_id,
             h.qty * pr.qty
      FROM   hier AS h
      JOIN   packaging_relations pr
             ON pr.packaging_id = h.item_id
),
agg AS (
      SELECT top_id,
             item_id,
             SUM(qty) AS total_qty
      FROM   hier
      GROUP BY top_id, item_id
      HAVING total_qty > 500
)
SELECT tp.name      AS top_container,
       p2.name      AS contained_item,
       a.total_qty
FROM   agg          AS a
JOIN   top_pkg      AS tp ON tp.id = a.top_id
JOIN   packaging    AS p2 ON p2.id = a.item_id
LIMIT 20;
