LIMIT 20;
```

```sql
-- 3) Find “top-level” packages (those that are never listed as a component of another one)
SELECT DISTINCT p.id,
       p.name
FROM   packaging            AS p
LEFT JOIN packaging_relations AS pr
       ON p.id = pr.contains_id
WHERE  pr.packaging_id IS NULL      -- not contained in anything else
LIMIT 20;
```

```sql
-- 4) Drill down into the hierarchy of one chosen top–level package (example: 521)
WITH RECURSIVE pack_tree(package_id, item_id, qty, lvl) AS (
      SELECT pr.packaging_id,
             pr.contains_id,
             pr.qty,
             1
      FROM   packaging_relations AS pr
      WHERE  pr.packaging_id = 521           -- << replace with a top-level id to explore
      UNION ALL
      SELECT pt.package_id,
             pr.contains_id,
             pt.qty * pr.qty,                -- cascade quantity multiplication
             pt.lvl + 1
      FROM   pack_tree         AS pt
      JOIN   packaging_relations AS pr
             ON pr.packaging_id = pt.item_id
)
SELECT *
FROM   pack_tree
LIMIT 20;
```

```sql
-- 5) Build the full hierarchy for ALL top-level packages
WITH RECURSIVE
top_pkg AS (                      -- list of every top-level container
      SELECT p.id
      FROM   packaging AS p
      LEFT  JOIN packaging_relations pr
             ON p.id = pr.contains_id
      WHERE  pr.packaging_id IS NULL
),
hier AS (                         -- walk the hierarchy and accumulate quantities
      SELECT pr.packaging_id AS top_id,
             pr.contains_id AS item_id,
             pr.qty         AS qty
      FROM   packaging_relations AS pr
      WHERE  pr.packaging_id IN (SELECT id FROM top_pkg)
      UNION ALL
      SELECT h.top_id,
             pr.contains_id,
             h.qty * pr.qty
      FROM   hier AS h
      JOIN   packaging_relations pr
             ON pr.packaging_id = h.item_id
)
SELECT top_id,
       item_id,
       SUM(qty) AS total_qty
FROM   hier
GROUP BY top_id, item_id
LIMIT 20;
```

```sql
-- 6) Keep only those (top-level, item) pairs whose accumulated quantity exceeds 500
WITH RECURSIVE
top_pkg AS (
      SELECT p.id
      FROM   packaging AS p
      LEFT  JOIN packaging_relations pr
             ON p.id = pr.contains_id
      WHERE  pr.packaging_id IS NULL
),
hier AS (
      SELECT pr.packaging_id AS top_id,
             pr.contains_id AS item_id,
             pr.qty         AS qty
      FROM   packaging_relations AS pr
      WHERE  pr.packaging_id IN (SELECT id FROM top_pkg)
      UNION ALL
      SELECT h.top_id,
             pr.contains_id,
             h.qty * pr.qty
      FROM   hier AS h
      JOIN   packaging_relations pr
             ON pr.packaging_id = h.item_id
),
agg AS (
      SELECT top_id,
             item_id,
             SUM(qty) AS total_qty
      FROM   hier
      GROUP BY top_id, item_id
      HAVING total_qty > 500
)
SELECT *
FROM   agg
LIMIT 20;
```

```sql
-- 7) Show the names of both the container and the corresponding “item” whose total > 500
WITH RECURSIVE
top_pkg AS (
      SELECT p.id, p.name
      FROM   packaging AS p
      LEFT  JOIN packaging_relations pr
             ON p.id = pr.contains_id
      WHERE  pr.packaging_id IS NULL
),
hier AS (
      SELECT pr.packaging_id AS top_id,
             pr.contains_id AS item_id,
             pr.qty         AS qty
      FROM   packaging_relations AS pr
      WHERE  pr.packaging_id IN (SELECT id FROM top_pkg)
      UNION ALL
      SELECT h.top_id,
             pr.contains_id,
             h.qty * pr.qty
      FROM   hier AS h
      JOIN   packaging_relations pr
             ON pr.packaging_id = h.item_id
),
agg AS (
      SELECT top_id,
             item_id,
             SUM(qty) AS total_qty
      FROM   hier
      GROUP BY top_id, item_id
      HAVING total_qty > 500
)
SELECT tp.name      AS top_container,
       p2.name      AS contained_item,
       a.total_qty
FROM   agg          AS a
JOIN   top_pkg      AS tp ON tp.id = a.top_id
JOIN   packaging    AS p2 ON p2.id = a.item_id
LIMIT 20;
```

```sql
-- 8) (Optional) Verify the results are indeed top-level by making sure none appear as a component
SELECT DISTINCT a.top_id
FROM   packaging_relations AS pr
JOIN   (
      SELECT DISTINCT top_id
      FROM   (
            /* copy of CTE `agg` from query 7 */
            WITH RECURSIVE
            top_pkg AS (
                  SELECT p.id
                  FROM   packaging AS p
                  LEFT  JOIN packaging_relations pr
                         ON p.id = pr.contains_id
                  WHERE  pr.packaging_id IS NULL
            ),
            hier AS (
                  SELECT pr.packaging_id AS top_id,
                         pr.contains_id AS item_id,
                         pr.qty AS qty
                  FROM   packaging_relations AS pr
                  WHERE  pr.packaging_id IN (SELECT id FROM top_pkg)
                  UNION ALL
                  SELECT h.top_id,
                         pr.contains_id,
                         h.qty * pr.qty
                  FROM   hier AS h
                  JOIN   packaging_relations pr
                         ON pr.packaging_id = h.item_id
            ),
            agg AS (
                  SELECT top_id,
                         item_id,
                         SUM(qty) AS total_qty
                  FROM   hier
                  GROUP BY top_id, item_id
                  HAVING total_qty > 500
            )
            SELECT top_id FROM agg
      )
) AS a
LEFT JOIN packaging_relations pr2
       ON a.top_id = pr2.contains_id     -- if NULL then really top-level
WHERE  pr2.packaging_id IS NOT NULL
LIMIT 20;
```

```sql
-- 9) Show the complete tree (all levels) for every container discovered in query 7
WITH RECURSIVE
toplevel AS (
      /* IDs we found to have some item >500 */
      SELECT DISTINCT a.top_id
      FROM   (
            -- copy of CTE `agg` from query 7
            WITH RECURSIVE
            top_pkg AS (
                  SELECT p.id
                  FROM   packaging AS p
                  LEFT  JOIN packaging_relations pr
                         ON p.id = pr.contains_id
                  WHERE  pr.packaging_id IS NULL
            ),
            hier AS (
                  SELECT pr.packaging_id AS top_id,
                         pr.contains_id AS item_id,
                         pr.qty AS qty
                  FROM   packaging_relations AS pr
                  WHERE  pr.packaging_id IN (SELECT id FROM top_pkg)
                  UNION ALL
                  SELECT h.top_id,
                         pr.contains_id,
                         h.qty * pr.qty
                  FROM   hier AS h
                  JOIN   packaging_relations pr
                         ON pr.packaging_id = h.item_id
            ),
            agg AS (
                  SELECT top_id,
                         item_id,
                         SUM(qty) AS total_qty
                  FROM   hier
                  GROUP BY top_id, item_id
                  HAVING total_qty > 500
            )
            SELECT top_id FROM agg
      ) AS a
),
tree AS (
      SELECT tp.top_id,
             pr.contains_id AS item_id,
             pr.qty   AS qty,
             1         AS lvl
      FROM   toplevel tp
      JOIN   packaging_relations pr
             ON pr.packaging_id = tp.top_id
      UNION ALL
      SELECT t.top_id,
             pr.contains_id,
             t.qty * pr.qty,
             t.lvl + 1
      FROM   tree t
      JOIN   packaging_relations pr
             ON pr.packaging_id = t.item_id
)
SELECT t.top_id,
       pc.name  AS container_name,
       pi.name  AS item_name,
       t.qty    AS qty_per_container,
       t.lvl
FROM   tree AS t
JOIN   packaging pc ON pc.id = t.top_id
JOIN   packaging pi ON pi.id = t.item_id
ORDER BY t.top_id, t.lvl, pi.name
LIMIT 20;
```

