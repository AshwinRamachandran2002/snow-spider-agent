Query:
-- 5) Build the full hierarchy for ALL top-level packages
WITH RECURSIVE
top_pkg AS (                      -- list of every top-level container
      SELECT p.id
      FROM   packaging AS p
      LEFT  JOIN packaging_relations pr
             ON p.id = pr.contains_id
      WHERE  pr.packaging_id IS NULL
),
hier AS (                         -- walk the hierarchy and accumulate quantities
      SELECT pr.packaging_id AS top_id,
             pr.contains_id AS item_id,
             pr.qty         AS qty
      FROM   packaging_relations AS pr
      WHERE  pr.packaging_id IN (SELECT id FROM top_pkg)
      UNION ALL
      SELECT h.top_id,
             pr.contains_id,
             h.qty * pr.qty
      FROM   hier AS h
      JOIN   packaging_relations pr
             ON pr.packaging_id = h.item_id
)
SELECT top_id,
       item_id,
       SUM(qty) AS total_qty
FROM   hier
GROUP BY top_id, item_id
LIMIT 20;
