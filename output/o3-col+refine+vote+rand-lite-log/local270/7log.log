```sql
--Description:  Identify every “top-level” packaging container (a package id that is
--              never listed as ‑contains_id- in packaging_relations) and walk its
--              entire sub-package hierarchy multiplying quantities along each step.
--              Aggregate the multiplied quantities per (top_container , item) pair
--              and keep those whose accumulated total exceeds 500.  Finally return
--              the human-readable names of both the container and the item.
WITH RECURSIVE
-- 1) Top-level packages (not contained in anything else)
top_pkg AS (
    SELECT id, name
    FROM   packaging
    WHERE  id NOT IN (SELECT contains_id FROM packaging_relations)
),
-- 2) Recursive walk that multiplies quantities down the hierarchy
hier AS (
    -- direct children of every top-level package
    SELECT pr.packaging_id AS top_id,
           pr.contains_id  AS item_id,
           pr.qty          AS qty
    FROM   packaging_relations pr
    WHERE  pr.packaging_id IN (SELECT id FROM top_pkg)
    UNION ALL
    -- recurse: item becomes new container, multiply quantities
    SELECT h.top_id,
           pr.contains_id,
           h.qty * pr.qty
    FROM   hier h
    JOIN   packaging_relations pr
           ON pr.packaging_id = h.item_id
),
-- 3) Aggregate total quantity of each item per top-level package
agg AS (
    SELECT top_id,
           item_id,
           SUM(qty) AS total_qty
    FROM   hier
    GROUP BY top_id, item_id
    HAVING total_qty > 500
)
-- 4) Present the answer with names
SELECT tp.name AS top_container,
       pi.name AS contained_item,
       a.total_qty
FROM   agg       a
JOIN   top_pkg   tp ON tp.id = a.top_id
JOIN   packaging pi ON pi.id = a.item_id
ORDER BY tp.name, pi.name;
```
