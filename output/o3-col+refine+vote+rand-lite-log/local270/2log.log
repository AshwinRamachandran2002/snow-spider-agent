Pallet Mix SG,Bottle 500cl,600
Pallet of L,Bottle 500cl,864
Pallet of M,Bottle 330cl,720
Query:
--Description: 
-- 9. Recursive version (no depth limit) that returns ONLY pairs whose accumulated
--    quantity exceeds 500, still capped with LIMIT 20 for inspection.
WITH
top_pkg AS (                                        -- true top-level containers
    SELECT id, name
    FROM   packaging
    WHERE  id IN (SELECT packaging_id FROM packaging_relations)
      AND  id NOT IN (SELECT contains_id  FROM packaging_relations)
),
rec (top_pkg_id, top_pkg_name, item_id, total_qty) AS (
    /* seed: direct children of every top-level container */
    SELECT tp.id, tp.name,
           pr.contains_id,
           pr.qty
    FROM   top_pkg tp
    JOIN   packaging_relations pr
             ON pr.packaging_id = tp.id
    UNION ALL
    /* recurse: follow contents of any child that is itself a package */
    SELECT r.top_pkg_id, r.top_pkg_name,
           pr2.contains_id,
           r.total_qty * pr2.qty
    FROM   rec  r
    JOIN   packaging_relations pr2
             ON pr2.packaging_id = r.item_id
)
SELECT   r.top_pkg_name  AS container,
         COALESCE(p.name, prod.name, CAST(r.item_id AS TEXT)) AS item,
         SUM(r.total_qty) AS accumulated_qty
FROM     rec r
LEFT JOIN packaging p   ON p.id   = r.item_id
LEFT JOIN products  prod ON prod.id = r.item_id
GROUP BY container, item
HAVING   SUM(r.total_qty) > 500
LIMIT 20
Answer:
container,item,accumulated_qty
