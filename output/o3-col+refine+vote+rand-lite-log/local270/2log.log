--Description: 
-- For each TRUE top-level container (a package that appears as packaging_id but never as contains_id),
-- list the items that lie exactly two levels below it in the hierarchy:
--     top-level → inner package → nested item.
-- The result shows the container name, the nested item (name or id),
-- and how many units of that item are in ONE top-level container
-- (computed as qty_top-to-inner * qty_inner-to-nested).
SELECT  tp.top_pkg_name,                           -- name of the top-level container
        pr2.contains_id            AS nested_item_id,
        COALESCE(p2.name,
                 CAST(pr2.contains_id AS TEXT)) 
                                   AS nested_item_name,
        pr1.qty * pr2.qty          AS total_units_reaching_nested
FROM   (                                             -- identify top-level containers
        SELECT p.id, p.name AS top_pkg_name
        FROM   packaging AS p
        WHERE  p.id IN (SELECT packaging_id FROM packaging_relations)
          AND  p.id NOT IN (SELECT contains_id  FROM packaging_relations)
       ) AS tp
JOIN   packaging_relations AS pr1
       ON pr1.packaging_id = tp.id                   -- hop 1: top-level → inner package
JOIN   packaging_relations AS pr2
       ON pr2.packaging_id = pr1.contains_id         -- hop 2: inner package → nested item
LEFT   JOIN packaging AS p2
       ON p2.id = pr2.contains_id
LIMIT 20;
