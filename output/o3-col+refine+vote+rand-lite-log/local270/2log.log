Query:
--Description: 
-- 8. Two-level aggregation only.
--    1) top_pkg  : all true top-level containers (never themselves contained).
--    2) lvl1     : first hop (top-level → inner package).  qty_lvl1 is the amount of
--                  the inner package inside ONE top-level container.
--    3) lvl2     : optional second hop (inner package → nested item).  If an inner
--                  package holds something, multiply the two quantities; otherwise
--                  stay with the single-hop result (pr2 will be NULL, so COALESCE
--                  takes the inner package itself and the multiplier becomes 1).
--    The final SELECT sums the quantities for every (container,item) pair and
--    filters on totals > 500.
WITH top_pkg AS (
    SELECT id, name
    FROM   packaging
    WHERE  id IN (SELECT packaging_id FROM packaging_relations)
      AND  id NOT IN (SELECT contains_id  FROM packaging_relations)
),
lvl1 AS (                                            -- first hop
    SELECT tp.id  AS top_pkg_id,
           tp.name AS top_pkg_name,
           pr.contains_id        AS mid_id,          -- inner package (or item)
           pr.qty                AS qty_lvl1
    FROM   top_pkg AS tp
    JOIN   packaging_relations pr
             ON pr.packaging_id = tp.id
),
lvl2 AS (                                            -- second hop (if any)
    SELECT l1.top_pkg_id,
           l1.top_pkg_name,
           COALESCE(pr2.contains_id, l1.mid_id) AS item_id,
           COALESCE(p.name, CAST(COALESCE(pr2.contains_id, l1.mid_id) AS TEXT))
                                           AS item_name,
           l1.qty_lvl1 * COALESCE(pr2.qty, 1)  AS total_qty
    FROM   lvl1 AS l1
    LEFT   JOIN packaging_relations pr2
             ON pr2.packaging_id = l1.mid_id
    LEFT   JOIN packaging p
             ON p.id = COALESCE(pr2.contains_id, l1.mid_id)
)
SELECT  top_pkg_name,
        item_name,
        SUM(total_qty) AS total_qty
FROM    lvl2
GROUP BY top_pkg_name, item_name
HAVING  SUM(total_qty) > 500
LIMIT 20
Answer:
top_pkg_name,item_name,total_qty
