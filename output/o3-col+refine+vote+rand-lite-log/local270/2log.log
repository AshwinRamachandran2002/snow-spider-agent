```sql
--Description:
-- Find every “top-level” package (appears as packaging_id but never as contains_id),
-- then walk down the whole packaging hierarchy with a recursive CTE.
-- At each step we multiply the running quantity by the edge quantity so that
-- qty_accum represents HOW MANY of the descendant item end up in ONE
-- top-level container.  
-- Finally, for every pair (top-level container, item) we add up all paths and
-- keep only those whose accumulated quantity exceeds 500.  Item names are taken
-- from `packaging` when the descendant is itself a package, otherwise from
-- `products`; if neither exists we show the raw id.
WITH
top_pkg AS (                          -- step 1: identify top-level containers
    SELECT p.id, p.name
    FROM   packaging AS p
    WHERE  p.id IN (SELECT packaging_id FROM packaging_relations)
      AND  p.id NOT IN (SELECT contains_id  FROM packaging_relations)
),
recursion (top_pkg_id, top_pkg_name, item_id, qty_accum) AS (   -- step 2 + 3
    /* seed: direct contents of the top-level container */
    SELECT tp.id, tp.name, pr.contains_id, pr.qty
    FROM   top_pkg tp
    JOIN   packaging_relations pr
           ON pr.packaging_id = tp.id
    UNION ALL
    /* recurse: if that item is itself a package, follow its contents */
    SELECT r.top_pkg_id,
           r.top_pkg_name,
           pr.contains_id,
           r.qty_accum * pr.qty
    FROM   recursion r
    JOIN   packaging_relations pr
           ON pr.packaging_id = r.item_id
)
SELECT  tp.top_pkg_name                                   AS container,
        COALESCE(pkg.name, prod.name,
                 CAST(r.item_id AS TEXT))                 AS item,
        SUM(r.qty_accum)                                  AS total_qty_in_container
FROM    recursion r
JOIN    top_pkg tp            ON tp.id = r.top_pkg_id
LEFT    JOIN packaging pkg    ON pkg.id = r.item_id
LEFT    JOIN products  prod   ON prod.id = r.item_id
GROUP BY container, item
HAVING  SUM(r.qty_accum) > 500;
```
