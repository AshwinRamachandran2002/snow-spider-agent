-- 6. Look at the direct (first-level) contents of every top-level container
SELECT t.top_pkg_name,
       p_in.id   AS direct_contained_id,
       p_in.name AS direct_contained_name,
       pr.qty    AS units_in_top
FROM (
      SELECT p.id, p.name AS top_pkg_name
      FROM packaging AS p
      WHERE p.id IN (SELECT packaging_id FROM packaging_relations)
        AND p.id NOT IN (SELECT contains_id FROM packaging_relations)
     ) AS t
JOIN packaging_relations AS pr
     ON pr.packaging_id = t.id
LEFT JOIN packaging AS p_in        -- will be NULL if the contained item is NOT a package
     ON p_in.id = pr.contains_id
LIMIT 20;
