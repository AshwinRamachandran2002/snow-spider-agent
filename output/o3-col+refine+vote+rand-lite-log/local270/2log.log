```sql
--Description:
-- Goal: list every TRUE top-level container (a package that appears in
--        packaging_relations.packaging_id but NEVER in packaging_relations.contains_id)
--        together with any item (product or package) whose TOTAL quantity,
--        accumulated through all nested levels of the hierarchy, exceeds 500.
--
-- Strategy
-- 1) CTE top_pkg   : find the ids/names of these top-level containers.
-- 2) RECURSIVE CTE rec :
--        • Seed rows = direct children of each top-level container
--          (qty_accum starts as the edge-quantity).
--        • Recursive step: while the current item is itself used as a package
--          (i.e. appears as packaging_id), follow its outgoing edges and
--          multiply qty_accum by the edge quantity.  Thus qty_accum always
--          reflects “how many of this descendant item end up in ONE top-level
--          container”.
-- 3) Final SELECT  : aggregate qty_accum per (container,item); bring a human
--                    readable item name from packaging.name if the item is a
--                    package, otherwise from products.name; keep only totals > 500.
WITH
    top_pkg AS (
        SELECT p.id, p.name
        FROM   packaging AS p
        WHERE  p.id IN (SELECT packaging_id FROM packaging_relations)
          AND  p.id NOT IN (SELECT contains_id  FROM packaging_relations)
    ),
    RECURSIVE rec (top_pkg_id, item_id, qty_accum) AS (
        /* seed: direct contents of each top-level container */
        SELECT tp.id,
               pr.contains_id,
               pr.qty
        FROM   top_pkg            AS tp
        JOIN   packaging_relations pr
                 ON pr.packaging_id = tp.id
        UNION ALL
        /* recurse: if current item is itself a package, follow its contents */
        SELECT r.top_pkg_id,
               pr2.contains_id,
               r.qty_accum * pr2.qty
        FROM   rec r
        JOIN   packaging_relations pr2
                 ON pr2.packaging_id = r.item_id
    )
SELECT  tp.name                                                   AS container,
        COALESCE(pkg.name, prod.name, CAST(r.item_id AS TEXT))    AS item,
        SUM(r.qty_accum)                                          AS total_qty
FROM    rec r
JOIN    top_pkg tp          ON tp.id = r.top_pkg_id
LEFT    JOIN packaging pkg  ON pkg.id = r.item_id     -- if the item is a package
LEFT    JOIN products  prod ON prod.id = r.item_id    -- if the item is a product
GROUP BY container, item
HAVING  SUM(r.qty_accum) > 500;
```
