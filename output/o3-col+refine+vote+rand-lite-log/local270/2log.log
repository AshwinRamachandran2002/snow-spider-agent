```sql
-- 6. Look at the direct (first-level) contents of every top-level container
SELECT t.top_pkg_name,
       p_in.id   AS direct_contained_id,
       p_in.name AS direct_contained_name,
       pr.qty    AS units_in_top
FROM (
      SELECT p.id, p.name AS top_pkg_name
      FROM packaging AS p
      WHERE p.id IN (SELECT packaging_id FROM packaging_relations)
        AND p.id NOT IN (SELECT contains_id FROM packaging_relations)
     ) AS t
JOIN packaging_relations AS pr
     ON pr.packaging_id = t.id
LEFT JOIN packaging AS p_in        -- will be NULL if the contained item is NOT a package
     ON p_in.id = pr.contains_id
LIMIT 20;
```

```sql
-- 7. One more level down: contents of any inner package that itself sits inside a top-level one
SELECT top_pkg.top_pkg_name,
       inner_lvl.contains_id  AS nested_item_id,
       COALESCE(p2.name , pr2.contains_id) AS nested_item_name,
       pr1.qty * pr2.qty      AS total_units_reaching_nested
FROM packaging_relations AS pr1             -- first hop (top -> inner package)
JOIN (
      SELECT p.id, p.name AS top_pkg_name
      FROM packaging AS p
      WHERE p.id IN (SELECT packaging_id FROM packaging_relations)
        AND p.id NOT IN (SELECT contains_id FROM packaging_relations)
     ) AS top_pkg
     ON top_pkg.id = pr1.packaging_id
JOIN packaging_relations AS pr2             -- second hop (inner package -> item)
     ON pr2.packaging_id = pr1.contains_id
LEFT JOIN packaging AS p2                   -- see if the nested item itself is also a package
     ON p2.id = pr2.contains_id
LIMIT 20;
```

```sql
-- 8. Aggregate the TOTAL quantity reaching every ultimate item (could be product or package)
--    when coming from any top-level container, but *only* using two levels deep.
WITH top_pkg AS (
    SELECT id, name
    FROM packaging
    WHERE id IN (SELECT packaging_id FROM packaging_relations)
      AND id NOT IN (SELECT contains_id FROM packaging_relations)
),
lvl1 AS (                                -- first level
    SELECT tp.id  AS top_pkg_id,
           tp.name AS top_pkg_name,
           pr.contains_id  AS mid_id,
           pr.qty          AS qty_lvl1
    FROM top_pkg AS tp
    JOIN packaging_relations AS pr
      ON pr.packaging_id = tp.id
),
lvl2 AS (                                -- second level
    SELECT l1.top_pkg_id,
           l1.top_pkg_name,
           COALESCE(p.name, l1.mid_id) AS item_name,
           l1.mid_id             AS item_id,
           l1.qty_lvl1 * COALESCE(pr2.qty, 1) AS total_qty
    FROM lvl1 AS l1
    LEFT JOIN packaging_relations AS pr2
           ON pr2.packaging_id = l1.mid_id          -- inner package? If none, stay at one level
    LEFT JOIN packaging AS p
           ON p.id = COALESCE(pr2.contains_id, l1.mid_id)
)
SELECT top_pkg_name, item_name, SUM(total_qty) AS total_qty
FROM lvl2
GROUP BY top_pkg_name, item_name
HAVING SUM(total_qty) > 500
LIMIT 20;
```

```sql
-- 9. Same idea as #8 but show ONLY the pairs whose accumulated quantity exceeds 500
WITH
top_pkg AS (
    SELECT id, name
    FROM packaging
    WHERE id IN (SELECT packaging_id FROM packaging_relations)
      AND id NOT IN (SELECT contains_id FROM packaging_relations)
),
rec (top_pkg_id, top_pkg_name, item_id, item_name, total_qty) AS (
    -- level 0 => direct contents
    SELECT tp.id, tp.name,
           pr.contains_id,
           COALESCE(p.name, pr.contains_id) AS item_name,
           pr.qty
    FROM top_pkg AS tp
    JOIN packaging_relations AS pr
      ON pr.packaging_id = tp.id
    LEFT JOIN packaging AS p
      ON p.id = pr.contains_id
    UNION ALL
    -- level 1 => walk down one more level
    SELECT r.top_pkg_id, r.top_pkg_name,
           pr2.contains_id,
           COALESCE(p2.name, pr2.contains_id),
           r.total_qty * pr2.qty
    FROM rec  AS r
    JOIN packaging_relations AS pr2
      ON pr2.packaging_id = r.item_id
    LEFT JOIN packaging AS p2
      ON p2.id = pr2.contains_id
)
SELECT DISTINCT top_pkg_name AS container,
       item_name   AS item,
       SUM(total_qty) AS accumulated_qty
FROM rec
GROUP BY top_pkg_name, item_name
HAVING SUM(total_qty) > 500
LIMIT 20;
```

