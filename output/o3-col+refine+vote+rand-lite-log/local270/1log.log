```sql
-- Description: Look at all available packaging types.
SELECT DISTINCT id, name
FROM packaging
LIMIT 20;
```

```sql
-- Description: Inspect the direct “parent → child (qty)” relations between packages / items.  
SELECT DISTINCT packaging_id, contains_id, qty
FROM packaging_relations
LIMIT 20;
```

```sql
-- Description: See which package-IDs ever appear as a child (i.e., are themselves contained in something else).
SELECT DISTINCT contains_id
FROM packaging_relations
LIMIT 20;
```

```sql
-- Description: List the top-level packages (those that never appear as a child in any relation).
SELECT DISTINCT p.id AS top_pkg_id, p.name AS top_pkg_name
FROM packaging AS p
WHERE p.id NOT IN (SELECT contains_id FROM packaging_relations)
LIMIT 20;
```

```sql
-- Description: Show the first-level contents (direct children) of every top-level package, with their names.
SELECT pr.packaging_id   AS top_pkg_id,
       p_top.name        AS top_pkg_name,
       pr.contains_id    AS child_id,
       p_child.name      AS child_name,
       pr.qty            AS child_qty_per_top
FROM packaging_relations AS pr
JOIN packaging          AS p_top   ON p_top.id   = pr.packaging_id
JOIN packaging          AS p_child ON p_child.id = pr.contains_id
WHERE pr.packaging_id IN (
        SELECT id FROM packaging
        WHERE id NOT IN (SELECT contains_id FROM packaging_relations)
      )
LIMIT 20;
```

```sql
-- Description: Use a recursive CTE to explode every top-level package down through all nested levels
-- and accumulate the effective quantity of each contained item reachable from the root.
WITH RECURSIVE
top_pkg AS (
    SELECT id AS top_id, name AS top_name
    FROM packaging
    WHERE id NOT IN (SELECT contains_id FROM packaging_relations)
),
exploded(top_id, top_name, item_id, item_qty) AS (
    -- level-0 : direct children of each top package
    SELECT t.top_id,
           t.top_name,
           pr.contains_id     AS item_id,
           pr.qty             AS item_qty
    FROM top_pkg AS t
    JOIN packaging_relations AS pr
      ON pr.packaging_id = t.top_id
    
    UNION ALL
    
    -- deeper levels : follow relations further down
    SELECT e.top_id,
           e.top_name,
           pr.contains_id                         AS item_id,
           e.item_qty * pr.qty                    AS item_qty   -- multiply to accumulate
    FROM exploded AS e
    JOIN packaging_relations AS pr
         ON pr.packaging_id = e.item_id
)
SELECT *
FROM exploded
LIMIT 20;
```

```sql
-- Description: Aggregate the total quantity of every contained item for each top-level package.
WITH RECURSIVE
top_pkg AS (
    SELECT id AS top_id, name AS top_name
    FROM packaging
    WHERE id NOT IN (SELECT contains_id FROM packaging_relations)
),
exploded(top_id, item_id, eff_qty) AS (
    SELECT t.top_id,
           pr.contains_id,
           pr.qty
    FROM top_pkg AS t
    JOIN packaging_relations AS pr
      ON pr.packaging_id = t.top_id
    UNION ALL
    SELECT e.top_id,
           pr.contains_id,
           e.eff_qty * pr.qty
    FROM exploded AS e
    JOIN packaging_relations AS pr
         ON pr.packaging_id = e.item_id
)
SELECT   e.top_id,
         p_top.name      AS top_pkg_name,
         e.item_id,
         p_item.name     AS item_name,
         SUM(e.eff_qty)  AS total_qty_in_top
FROM exploded AS e
JOIN packaging AS p_top  ON p_top.id  = e.top_id
JOIN packaging AS p_item ON p_item.id = e.item_id
GROUP BY e.top_id, e.item_id
LIMIT 20;
```

```sql
-- Description: Retrieve only those (top package, item) pairs where the accumulated quantity > 500.
WITH RECURSIVE
top_pkg AS (
    SELECT id AS top_id, name AS top_name
    FROM packaging
    WHERE id NOT IN (SELECT contains_id FROM packaging_relations)
),
exploded(top_id, item_id, eff_qty) AS (
    SELECT t.top_id,
           pr.contains_id,
           pr.qty
    FROM top_pkg t
    JOIN packaging_relations pr
      ON pr.packaging_id = t.top_id
    UNION ALL
    SELECT e.top_id,
           pr.contains_id,
           e.eff_qty * pr.qty
    FROM exploded e
    JOIN packaging_relations pr
         ON pr.packaging_id = e.item_id
)
SELECT   p_top.name  AS top_level_container,
         p_item.name AS contained_item,
         SUM(e.eff_qty) AS total_quantity
FROM exploded AS e
JOIN packaging AS p_top  ON p_top.id  = e.top_id
JOIN packaging AS p_item ON p_item.id = e.item_id
GROUP BY e.top_id, e.item_id
HAVING SUM(e.eff_qty) > 500
LIMIT 20;
```

```sql
-- Description: Same as above, but show only the distinct names of the qualifying top-level containers.
WITH RECURSIVE
top_pkg AS (
    SELECT id AS top_id
    FROM packaging
    WHERE id NOT IN (SELECT contains_id FROM packaging_relations)
),
exploded(top_id, item_id, eff_qty) AS (
    SELECT t.top_id,
           pr.contains_id,
           pr.qty
    FROM top_pkg t
    JOIN packaging_relations pr
      ON pr.packaging_id = t.top_id
    UNION ALL
    SELECT e.top_id,
           pr.contains_id,
           e.eff_qty * pr.qty
    FROM exploded e
    JOIN packaging_relations pr
         ON pr.packaging_id = e.item_id
)
SELECT DISTINCT p_top.name
FROM exploded AS e
JOIN packaging AS p_top ON p_top.id = e.top_id
GROUP BY e.top_id, e.item_id
HAVING SUM(e.eff_qty) > 500
LIMIT 20;
```

```sql
-- Description: Final answer – the exact pairings (container name & item name) whose accumulated count > 500.
WITH RECURSIVE
top_pkg AS (
    SELECT id AS top_id
    FROM packaging
    WHERE id NOT IN (SELECT contains_id FROM packaging_relations)
),
exploded(top_id, item_id, eff_qty) AS (
    SELECT t.top_id,
           pr.contains_id,
           pr.qty
    FROM top_pkg t
    JOIN packaging_relations pr
      ON pr.packaging_id = t.top_id
    UNION ALL
    SELECT e.top_id,
           pr.contains_id,
           e.eff_qty * pr.qty
    FROM exploded e
    JOIN packaging_relations pr
         ON pr.packaging_id = e.item_id
)
SELECT p_top.name  AS top_level_container,
       p_item.name AS contained_item,
       SUM(e.eff_qty) AS total_quantity
FROM exploded AS e
JOIN packaging AS p_top  ON p_top.id  = e.top_id
JOIN packaging AS p_item ON p_item.id = e.item_id
GROUP BY e.top_id, e.item_id
HAVING SUM(e.eff_qty) > 500;
```
