Query:
-- 3) Count how many times each packaging id is used as a parent and as a child
SELECT
       pr.packaging_id          AS parent_id,
       COUNT(*)                 AS parent_cnt,
       pc.child_cnt
FROM   packaging_relations AS pr
LEFT   JOIN (
        SELECT contains_id, COUNT(*) AS child_cnt
        FROM   packaging_relations
        GROUP  BY contains_id
       ) AS pc
       ON pr.packaging_id = pc.contains_id
GROUP  BY pr.packaging_id, pc.child_cnt
LIMIT 20
