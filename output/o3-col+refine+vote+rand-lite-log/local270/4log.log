```sql
-- 1) Inspect all available packaging definitions
SELECT *
FROM packaging
LIMIT 20;

-- 2) Inspect the immediate parent-child relations between packagings / items
SELECT *
FROM packaging_relations
LIMIT 20;

-- 3) Count how many times each packaging id is used as a parent and as a child
SELECT
       pr.packaging_id          AS parent_id,
       COUNT(*)                 AS parent_cnt,
       pc.child_cnt
FROM   packaging_relations AS pr
LEFT   JOIN (
        SELECT contains_id, COUNT(*) AS child_cnt
        FROM   packaging_relations
        GROUP  BY contains_id
       ) AS pc
       ON pr.packaging_id = pc.contains_id
GROUP  BY pr.packaging_id, pc.child_cnt
LIMIT 20;

-- 4) Find “top-level” packaging containers (never appear as a child)
SELECT DISTINCT p.id, p.name
FROM   packaging             AS p
WHERE  p.id NOT IN (SELECT DISTINCT contains_id FROM packaging_relations)
LIMIT 20;

-- 5) Look at the full hierarchy beneath one example top-level container (e.g. id 511)
WITH RECURSIVE r(root_id, contains_id, qty_path, level) AS (
        SELECT pr.packaging_id, pr.contains_id, pr.qty, 1
        FROM   packaging_relations AS pr
        WHERE  pr.packaging_id = 511      -- example root
      UNION ALL
        SELECT r.root_id, pr.contains_id, r.qty_path * pr.qty, r.level + 1
        FROM   r
        JOIN   packaging_relations AS pr
               ON pr.packaging_id = r.contains_id
)
SELECT *
FROM   r
LIMIT 20;

-- 6) Build the complete exploded tree for every top-level container
WITH RECURSIVE exploded(root_id, item_id, qty_mult) AS (
        -- direct children of every top-level root
        SELECT pr.packaging_id, pr.contains_id, pr.qty
        FROM   packaging_relations AS pr
        WHERE  pr.packaging_id NOT IN (SELECT DISTINCT contains_id FROM packaging_relations)

      UNION ALL
        -- keep drilling down while multiplying the quantities
        SELECT e.root_id, pr.contains_id, e.qty_mult * pr.qty
        FROM   exploded AS e
        JOIN   packaging_relations AS pr
               ON pr.packaging_id = e.item_id
)
SELECT *
FROM   exploded
LIMIT 20;

-- 7) Aggregate the accumulated quantity of every individual item under each root
WITH RECURSIVE exploded(root_id, item_id, qty_mult) AS (
        SELECT pr.packaging_id, pr.contains_id, pr.qty
        FROM   packaging_relations AS pr
        WHERE  pr.packaging_id NOT IN (SELECT DISTINCT contains_id FROM packaging_relations)
      UNION ALL
        SELECT e.root_id, pr.contains_id, e.qty_mult * pr.qty
        FROM   exploded AS e
        JOIN   packaging_relations AS pr
               ON pr.packaging_id = e.item_id
)
SELECT   root_id,
         item_id,
         SUM(qty_mult) AS total_qty
FROM     exploded
GROUP BY root_id, item_id
LIMIT 20;

-- 8) Final answer – top-level containers that hold any item in quantities > 500
WITH RECURSIVE exploded(root_id, item_id, qty_mult) AS (
        SELECT pr.packaging_id, pr.contains_id, pr.qty
        FROM   packaging_relations AS pr
        WHERE  pr.packaging_id NOT IN (SELECT DISTINCT contains_id FROM packaging_relations)
      UNION ALL
        SELECT e.root_id, pr.contains_id, e.qty_mult * pr.qty
        FROM   exploded AS e
        JOIN   packaging_relations AS pr
               ON pr.packaging_id = e.item_id
),
totals AS (
        SELECT   root_id,
                 item_id,
                 SUM(qty_mult) AS total_qty
        FROM     exploded
        GROUP BY root_id, item_id
        HAVING   total_qty > 500
)
SELECT DISTINCT
       pc.name  AS top_level_container,
       pi.name  AS contained_item,
       t.total_qty
FROM   totals  AS t
JOIN   packaging AS pc ON pc.id = t.root_id
JOIN   packaging AS pi ON pi.id = t.item_id
LIMIT 20;
```
