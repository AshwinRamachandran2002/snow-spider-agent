Query:
-- 5) Look at the full hierarchy beneath one example top-level container (e.g. id 511)
WITH RECURSIVE r(root_id, contains_id, qty_path, level) AS (
        SELECT pr.packaging_id, pr.contains_id, pr.qty, 1
        FROM   packaging_relations AS pr
        WHERE  pr.packaging_id = 511      -- example root
      UNION ALL
        SELECT r.root_id, pr.contains_id, r.qty_path * pr.qty, r.level + 1
        FROM   r
        JOIN   packaging_relations AS pr
               ON pr.packaging_id = r.contains_id
)
SELECT *
FROM   r
LIMIT 20
