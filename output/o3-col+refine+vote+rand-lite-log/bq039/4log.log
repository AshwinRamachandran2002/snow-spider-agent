FROM   `bigquery-public-data.new_york_taxi_trips.tlc_yellow_trips_2016`
WHERE  pickup_datetime BETWEEN '2016-07-01' AND '2016-07-02'
LIMIT 20;
```

```sql
-- 2. Which passenger counts are large ( > 5 ) during that week?
SELECT DISTINCT passenger_count
FROM   `bigquery-public-data.new_york_taxi_trips.tlc_yellow_trips_2016`
WHERE  pickup_datetime BETWEEN '2016-07-01' AND '2016-07-08'
  AND  passenger_count > 5
ORDER  BY passenger_count
LIMIT 20;
```

```sql
-- 3. Look at long trips (≥10 miles) with big parties to inspect the fare fields
SELECT pickup_datetime,
       dropoff_datetime,
       passenger_count,
       trip_distance,
       fare_amount,
       tip_amount,
       mta_tax,
       tolls_amount,
       total_amount
FROM   `bigquery-public-data.new_york_taxi_trips.tlc_yellow_trips_2016`
WHERE  pickup_datetime BETWEEN '2016-07-01' AND '2016-07-08'
  AND  passenger_count > 5
  AND  trip_distance >= 10
LIMIT 20;
```

```sql
-- 4. Verify that all monetary columns are non-negative in our week
SELECT COUNT(*) AS bad_rows
FROM   `bigquery-public-data.new_york_taxi_trips.tlc_yellow_trips_2016`
WHERE  pickup_datetime BETWEEN '2016-07-01' AND '2016-07-08'
  AND  passenger_count > 5
  AND  trip_distance >= 10
  AND (fare_amount   < 0 OR tip_amount   < 0 OR tolls_amount < 0
       OR mta_tax    < 0 OR total_amount < 0);
```

```sql
-- 5. Get the taxi-zone names we will need for joins
SELECT zone_id, zone_name, borough
FROM   `bigquery-public-data.new_york_taxi_trips.taxi_zone_geom`
LIMIT 20;
```

```sql
-- 6. Connect a few candidate trips to pickup / dropoff zone names
SELECT t.pickup_datetime,
       p.zone_name AS pickup_zone,
       d.zone_name AS dropoff_zone,
       t.trip_distance,
       t.total_amount
FROM   `bigquery-public-data.new_york_taxi_trips.tlc_yellow_trips_2016` AS t
JOIN   `bigquery-public-data.new_york_taxi_trips.taxi_zone_geom` AS p
       ON p.zone_id = t.pickup_location_id
JOIN   `bigquery-public-data.new_york_taxi_trips.taxi_zone_geom` AS d
       ON d.zone_id = t.dropoff_location_id
WHERE  t.pickup_datetime BETWEEN '2016-07-01' AND '2016-07-02'
LIMIT 20;
```

```sql
-- 7. Compute trip duration (sec) and speed (mph) for a sample of our filter
SELECT pickup_datetime,
       TIMESTAMP_DIFF(dropoff_datetime, pickup_datetime, SECOND) AS dur_sec,
       trip_distance,
       ROUND(SAFE_DIVIDE(CAST(trip_distance AS FLOAT64),
                         TIMESTAMP_DIFF(dropoff_datetime, pickup_datetime, SECOND)/3600),2) AS mph
FROM   `bigquery-public-data.new_york_taxi_trips.tlc_yellow_trips_2016`
WHERE  pickup_datetime BETWEEN '2016-07-01' AND '2016-07-02'
  AND  passenger_count > 5
  AND  trip_distance >= 10
  AND  dropoff_datetime > pickup_datetime
LIMIT 20;
```

```sql
-- 8. Calculate tip-rate (%) for a quick sanity check
SELECT pickup_datetime,
       tip_amount,
       total_amount,
       ROUND(SAFE_DIVIDE(tip_amount,total_amount)*100,2) AS tip_pct
FROM   `bigquery-public-data.new_york_taxi_trips.tlc_yellow_trips_2016`
WHERE  pickup_datetime BETWEEN '2016-07-01' AND '2016-07-02'
  AND  passenger_count > 5
  AND  trip_distance >= 10
  AND  dropoff_datetime > pickup_datetime
  AND  total_amount > 0
LIMIT 20;
```

```sql
-- 9. Gather every field we will ultimately need, fully filtered
SELECT t.*, 
       TIMESTAMP_DIFF(dropoff_datetime, pickup_datetime, SECOND)            AS trip_seconds,
       ROUND(SAFE_DIVIDE(CAST(trip_distance AS FLOAT64),
                         TIMESTAMP_DIFF(dropoff_datetime, pickup_datetime, SECOND)/3600),2) AS speed_mph,
       ROUND(SAFE_DIVIDE(tip_amount,total_amount)*100,2)                   AS tip_pct,
       p.zone_name AS pickup_zone,
       d.zone_name AS dropoff_zone
FROM   `bigquery-public-data.new_york_taxi_trips.tlc_yellow_trips_2016` AS t
JOIN   `bigquery-public-data.new_york_taxi_trips.taxi_zone_geom`         AS p
       ON p.zone_id = t.pickup_location_id
JOIN   `bigquery-public-data.new_york_taxi_trips.taxi_zone_geom`         AS d
       ON d.zone_id = t.dropoff_location_id
WHERE  t.pickup_datetime  BETWEEN '2016-07-01' AND '2016-07-08'
  AND  t.dropoff_datetime BETWEEN '2016-07-01' AND '2016-07-08'
  AND  t.dropoff_datetime > t.pickup_datetime
  AND  t.passenger_count > 5
  AND  t.trip_distance  >= 10
  AND  t.fare_amount    >= 0
  AND  t.tip_amount     >= 0
  AND  t.tolls_amount   >= 0
  AND  t.mta_tax        >= 0
  AND  t.total_amount   >= 0
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: top-10 qualifying trips, ordered by total fare
SELECT
  p.zone_name AS pickup_zone,
  d.zone_name AS dropoff_zone,
  TIMESTAMP_DIFF(t.dropoff_datetime, t.pickup_datetime, SECOND) AS trip_seconds,
  ROUND(SAFE_DIVIDE(CAST(t.trip_distance AS FLOAT64),
                    TIMESTAMP_DIFF(t.dropoff_datetime, t.pickup_datetime, SECOND)/3600),2) AS speed_mph,
  ROUND(SAFE_DIVIDE(t.tip_amount, t.total_amount)*100,2) AS tip_pct,
  t.total_amount
FROM   `bigquery-public-data.new_york_taxi_trips.tlc_yellow_trips_2016` AS t
JOIN   `bigquery-public-data.new_york_taxi_trips.taxi_zone_geom` AS p
       ON p.zone_id = t.pickup_location_id
JOIN   `bigquery-public-data.new_york_taxi_trips.taxi_zone_geom` AS d
       ON d.zone_id = t.dropoff_location_id
WHERE  t.pickup_datetime  BETWEEN '2016-07-01' AND '2016-07-08'
  AND  t.dropoff_datetime BETWEEN '2016-07-01' AND '2016-07-08'
  AND  t.dropoff_datetime > t.pickup_datetime
  AND  t.passenger_count  > 5
  AND  t.trip_distance    >= 10
  AND  t.fare_amount      >= 0
  AND  t.tip_amount       >= 0
  AND  t.tolls_amount     >= 0
  AND  t.mta_tax          >= 0
  AND  t.total_amount     >= 0
ORDER BY t.total_amount DESC
LIMIT 10;
```
