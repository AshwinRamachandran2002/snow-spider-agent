-- 9. Gather every field we will ultimately need, fully filtered
SELECT t.*, 
       TIMESTAMP_DIFF(dropoff_datetime, pickup_datetime, SECOND)            AS trip_seconds,
       ROUND(SAFE_DIVIDE(CAST(trip_distance AS FLOAT64),
                         TIMESTAMP_DIFF(dropoff_datetime, pickup_datetime, SECOND)/3600),2) AS speed_mph,
       ROUND(SAFE_DIVIDE(tip_amount,total_amount)*100,2)                   AS tip_pct,
       p.zone_name AS pickup_zone,
       d.zone_name AS dropoff_zone
FROM   `bigquery-public-data.new_york_taxi_trips.tlc_yellow_trips_2016` AS t
JOIN   `bigquery-public-data.new_york_taxi_trips.taxi_zone_geom`         AS p
       ON p.zone_id = t.pickup_location_id
JOIN   `bigquery-public-data.new_york_taxi_trips.taxi_zone_geom`         AS d
       ON d.zone_id = t.dropoff_location_id
