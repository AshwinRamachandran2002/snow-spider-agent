```sql
--Description: Preview a few rows of the raw “results” table
SELECT *
FROM results
LIMIT 20;
```

```sql
--Description: See which race years exist in “results” by joining to “races”
SELECT DISTINCT r.year
FROM results  AS res
JOIN races    AS r  ON r.race_id = res.race_id
ORDER BY r.year
LIMIT 20;
```

```sql
--Description: Driver-season points example – 2009
SELECT r.year,
       res.driver_id,
       SUM(res.points) AS driver_season_points
FROM   results  AS res
JOIN   races    AS r  ON r.race_id = res.race_id
WHERE  r.year = 2009
GROUP  BY r.year, res.driver_id
ORDER  BY driver_season_points DESC
LIMIT 20;
```

```sql
--Description: Constructor-season points example – 2009
SELECT r.year,
       res.constructor_id,
       SUM(res.points) AS constructor_season_points
FROM   results  AS res
JOIN   races    AS r  ON r.race_id = res.race_id
WHERE  r.year = 2009
GROUP  BY r.year, res.constructor_id
ORDER  BY constructor_season_points DESC
LIMIT 20;
```

```sql
--Description: For every year, find the highest total points scored by any single driver
SELECT year,
       MAX(driver_points) AS max_driver_points
FROM (
        SELECT r.year,
               res.driver_id,
               SUM(res.points) AS driver_points
        FROM   results AS res
        JOIN   races   AS r ON r.race_id = res.race_id
        GROUP  BY r.year, res.driver_id
     )
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--Description: For every year, find the highest total points scored by any single constructor
SELECT year,
       MAX(constructor_points) AS max_constructor_points
FROM (
        SELECT r.year,
               res.constructor_id,
               SUM(res.points) AS constructor_points
        FROM   results AS res
        JOIN   races   AS r ON r.race_id = res.race_id
        GROUP  BY r.year, res.constructor_id
     )
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--Description: Combine the two previous sub-results, add them, and return the three
--             years with the smallest (driver + constructor) totals.
SELECT d.year,
       d.max_driver_points,
       c.max_constructor_points,
       d.max_driver_points + c.max_constructor_points AS combined_total
FROM (
        SELECT year,
               MAX(driver_points) AS max_driver_points
        FROM (
                SELECT r.year,
                       res.driver_id,
                       SUM(res.points) AS driver_points
                FROM   results AS res
                JOIN   races   AS r ON r.race_id = res.race_id
                GROUP  BY r.year, res.driver_id
             )
        GROUP BY year
     ) AS d
JOIN (
        SELECT year,
               MAX(constructor_points) AS max_constructor_points
        FROM (
                SELECT r.year,
                       res.constructor_id,
                       SUM(res.points) AS constructor_points
                FROM   results AS res
                JOIN   races   AS r ON r.race_id = res.race_id
                GROUP  BY r.year, res.constructor_id
             )
        GROUP BY year
     ) AS c
  ON d.year = c.year
ORDER BY combined_total ASC, d.year ASC
LIMIT 3;
```
