Query:
--Description: For every year, find the highest total points scored by any single driver
SELECT year,
       MAX(driver_points) AS max_driver_points
FROM (
        SELECT r.year,
               res.driver_id,
               SUM(res.points) AS driver_points
        FROM   results AS res
        JOIN   races   AS r ON r.race_id = res.race_id
        GROUP  BY r.year, res.driver_id
     )
GROUP BY year
ORDER BY year
LIMIT 20;
