Query:
-- Description: Combine each year’s max driver points and max constructor points, then calculate their sum.
SELECT md."year",
       md.max_driver_pts,
       mc.max_constructor_pts,
       md.max_driver_pts + mc.max_constructor_pts AS year_total
FROM  (
         SELECT d."year",
                MAX(d.driver_pts) AS max_driver_pts
         FROM (
                 SELECT ra."year",
                        r."driver_id",
                        SUM(r."points") AS driver_pts
                 FROM   "results" AS r
                 JOIN   "races"   AS ra USING ("race_id")
                 GROUP  BY ra."year", r."driver_id"
              ) AS d
         GROUP BY d."year"
      ) AS md
JOIN (
         SELECT c."year",
                MAX(c.constructor_pts) AS max_constructor_pts
         FROM (
                 SELECT ra."year",
                        r."constructor_id",
                        SUM(r."points") AS constructor_pts
                 FROM   "results" AS r
                 JOIN   "races"   AS ra USING ("race_id")
                 GROUP  BY ra."year", r."constructor_id"
              ) AS c
         GROUP BY c."year"
      ) AS mc
  ON md."year" = mc."year"
ORDER BY year_total ASC
LIMIT 10;
