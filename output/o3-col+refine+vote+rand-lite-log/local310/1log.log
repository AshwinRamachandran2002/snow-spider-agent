```sql
-- Description: Preview points given in the results table along with the year of the race.
SELECT r."race_id",
       ra."year",
       r."driver_id",
       r."constructor_id",
       r."points"
FROM   "results" AS r
JOIN   "races"   AS ra USING ("race_id")
LIMIT 20;
```

```sql
-- Description: For every year / driver pair, total the driver’s points.
SELECT ra."year",
       r."driver_id",
       SUM(r."points") AS driver_pts
FROM   "results" AS r
JOIN   "races"   AS ra USING ("race_id")
GROUP  BY ra."year", r."driver_id"
ORDER  BY ra."year", driver_pts DESC
LIMIT 20;
```

```sql
-- Description: Highest (max) driver‐points total in each year.
SELECT d."year",
       MAX(d.driver_pts) AS max_driver_pts
FROM (
        SELECT ra."year",
               r."driver_id",
               SUM(r."points") AS driver_pts
        FROM   "results" AS r
        JOIN   "races"   AS ra USING ("race_id")
        GROUP  BY ra."year", r."driver_id"
     ) AS d
GROUP BY d."year"
ORDER BY d."year"
LIMIT 20;
```

```sql
-- Description: For every year / constructor pair, total the constructor’s points.
SELECT ra."year",
       r."constructor_id",
       SUM(r."points") AS constructor_pts
FROM   "results" AS r
JOIN   "races"   AS ra USING ("race_id")
GROUP  BY ra."year", r."constructor_id"
ORDER  BY ra."year", constructor_pts DESC
LIMIT 20;
```

```sql
-- Description: Highest (max) constructor‐points total in each year.
SELECT c."year",
       MAX(c.constructor_pts) AS max_constructor_pts
FROM (
        SELECT ra."year",
               r."constructor_id",
               SUM(r."points") AS constructor_pts
        FROM   "results" AS r
        JOIN   "races"   AS ra USING ("race_id")
        GROUP  BY ra."year", r."constructor_id"
     ) AS c
GROUP BY c."year"
ORDER BY c."year"
LIMIT 20;
```

```sql
-- Description: Combine each year’s max driver points and max constructor points, then calculate their sum.
SELECT md."year",
       md.max_driver_pts,
       mc.max_constructor_pts,
       md.max_driver_pts + mc.max_constructor_pts AS year_total
FROM  (
         SELECT d."year",
                MAX(d.driver_pts) AS max_driver_pts
         FROM (
                 SELECT ra."year",
                        r."driver_id",
                        SUM(r."points") AS driver_pts
                 FROM   "results" AS r
                 JOIN   "races"   AS ra USING ("race_id")
                 GROUP  BY ra."year", r."driver_id"
              ) AS d
         GROUP BY d."year"
      ) AS md
JOIN (
         SELECT c."year",
                MAX(c.constructor_pts) AS max_constructor_pts
         FROM (
                 SELECT ra."year",
                        r."constructor_id",
                        SUM(r."points") AS constructor_pts
                 FROM   "results" AS r
                 JOIN   "races"   AS ra USING ("race_id")
                 GROUP  BY ra."year", r."constructor_id"
              ) AS c
         GROUP BY c."year"
      ) AS mc
  ON md."year" = mc."year"
ORDER BY year_total ASC
LIMIT 10;
```

```sql
-- Description: Return the three years with the smallest driver+constructor maxima sums, ordered by that sum.
SELECT md."year"
FROM  (
         SELECT d."year",
                MAX(d.driver_pts) AS max_driver_pts
         FROM (
                 SELECT ra."year",
                        r."driver_id",
                        SUM(r."points") AS driver_pts
                 FROM   "results" AS r
                 JOIN   "races"   AS ra USING ("race_id")
                 GROUP  BY ra."year", r."driver_id"
              ) AS d
         GROUP BY d."year"
      ) AS md
JOIN (
         SELECT c."year",
                MAX(c.constructor_pts) AS max_constructor_pts
         FROM (
                 SELECT ra."year",
                        r."constructor_id",
                        SUM(r."points") AS constructor_pts
                 FROM   "results" AS r
                 JOIN   "races"   AS ra USING ("race_id")
                 GROUP  BY ra."year", r."constructor_id"
              ) AS c
         GROUP BY c."year"
      ) AS mc
  ON md."year" = mc."year"
ORDER BY (md.max_driver_pts + mc.max_constructor_pts) ASC
LIMIT 3;
```

These queries progressively:

1. Preview the needed columns.
2. Aggregate driver points by year.
3. Extract each year’s maximum driver total.
4. Aggregate constructor points by year.
5. Extract each year’s maximum constructor total.
6. Combine the two maxima and compute their sum per year.
7. Finally, list the three years whose sum is the smallest, satisfying the task requirement.
