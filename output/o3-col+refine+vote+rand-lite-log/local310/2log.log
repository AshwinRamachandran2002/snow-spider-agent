```sql
--Description:  To find the three years whose “combined-maximum” is smallest, we:
--  1) total every driver’s points in each season,
--  2) keep the largest of those driver-totals per season,
--  3) total every constructor’s points in each season,
--  4) keep the largest of those constructor-totals per season,
--  5) add the two maxima together for every season,
--  6) return the three seasons with the lowest sums.
WITH season_driver_totals AS (          -- step 1
    SELECT r."year",
           res."driver_id",
           SUM(res."points") AS driver_points
    FROM   "results"  AS res
    JOIN   "races"    AS r ON r."race_id" = res."race_id"
    GROUP  BY r."year", res."driver_id"
),
driver_max AS (                         -- step 2
    SELECT "year",
           MAX(driver_points) AS max_driver_points
    FROM   season_driver_totals
    GROUP  BY "year"
),
season_constructor_totals AS (          -- step 3
    SELECT r."year",
           res."constructor_id",
           SUM(res."points") AS constructor_points
    FROM   "results"  AS res
    JOIN   "races"    AS r ON r."race_id" = res."race_id"
    GROUP  BY r."year", res."constructor_id"
),
constructor_max AS (                    -- step 4
    SELECT "year",
           MAX(constructor_points) AS max_constructor_points
    FROM   season_constructor_totals
    GROUP  BY "year"
),
combined AS (                           -- step 5
    SELECT d."year",
           d.max_driver_points + c.max_constructor_points AS combined_points
    FROM   driver_max      AS d
    JOIN   constructor_max AS c USING ("year")
)
SELECT "year"                           -- step 6
FROM   combined
ORDER  BY combined_points ASC, "year" ASC
LIMIT 3;
```
