```sql
-- 1. See which seasons have at least one result (distinct race years).
SELECT DISTINCT r."year"
FROM "races" AS r
JOIN "results" AS res ON res."race_id" = r."race_id"
ORDER BY r."year"
LIMIT 20;
```

```sql
-- 2. Preview a few result rows together with their race-year.
SELECT r."year",
       res."race_id",
       res."driver_id",
       res."constructor_id",
       res."points"
FROM "results"  AS res
JOIN "races"    AS r ON r."race_id" = res."race_id"
ORDER BY r."year", res."race_id"
LIMIT 20;
```

```sql
-- 3. Aggregate total points per driver in each season.
SELECT r."year",
       res."driver_id",
       SUM(res."points") AS "driver_points"
FROM "results" AS res
JOIN "races"   AS r ON r."race_id" = res."race_id"
GROUP BY r."year", res."driver_id"
ORDER BY r."year", "driver_points" DESC
LIMIT 20;
```

```sql
-- 4. Pick the maximum (highest-scoring) driver points for every season.
SELECT r."year",
       MAX(SUM(res."points")) AS "max_driver_points"
FROM "results" AS res
JOIN "races"   AS r ON r."race_id" = res."race_id"
GROUP BY r."year", res."driver_id"
GROUP BY r."year"
ORDER BY r."year"
LIMIT 20;
```

```sql
-- 5. Aggregate total constructor points for every constructor in each season.
SELECT r."year",
       res."constructor_id",
       SUM(res."points") AS "constructor_points"
FROM "results" AS res
JOIN "races"   AS r ON r."race_id" = res."race_id"
GROUP BY r."year", res."constructor_id"
ORDER BY r."year", "constructor_points" DESC
LIMIT 20;
```

```sql
-- 6. Pick the maximum constructor points in every season.
SELECT r."year",
       MAX(SUM(res."points")) AS "max_constructor_points"
FROM "results" AS res
JOIN "races"   AS r ON r."race_id" = res."race_id"
GROUP BY r."year", res."constructor_id"
GROUP BY r."year"
ORDER BY r."year"
LIMIT 20;
```

```sql
-- 7. Combine the two season-level maxima (driver & constructor) and
--    compute their sum (combined total) for each year.
WITH driver_max AS (
    SELECT r."year",
           MAX(SUM(res."points")) AS "max_driver_points"
    FROM "results" AS res
    JOIN "races"   AS r ON r."race_id" = res."race_id"
    GROUP BY r."year", res."driver_id"
    GROUP BY r."year"
),
constructor_max AS (
    SELECT r."year",
           MAX(SUM(res."points")) AS "max_constructor_points"
    FROM "results" AS res
    JOIN "races"   AS r ON r."race_id" = res."race_id"
    GROUP BY r."year", res."constructor_id"
    GROUP BY r."year"
)
SELECT d."year",
       (d."max_driver_points" + c."max_constructor_points") AS "combined_max_points"
FROM   driver_max      AS d
JOIN   constructor_max AS c ON c."year" = d."year"
ORDER  BY "combined_max_points" ASC, d."year" ASC
LIMIT 20;
```

```sql
-- 8. Return the three seasons with the smallest sum of maxima
--    (answer required by the task).
WITH driver_max AS (
    SELECT r."year",
           MAX(SUM(res."points")) AS "max_driver_points"
    FROM "results" AS res
    JOIN "races"   AS r ON r."race_id" = res."race_id"
    GROUP BY r."year", res."driver_id"
    GROUP BY r."year"
),
constructor_max AS (
    SELECT r."year",
           MAX(SUM(res."points")) AS "max_constructor_points"
    FROM "results" AS res
    JOIN "races"   AS r ON r."race_id" = res."race_id"
    GROUP BY r."year", res."constructor_id"
    GROUP BY r."year"
)
SELECT d."year"
FROM   driver_max      AS d
JOIN   constructor_max AS c ON c."year" = d."year"
ORDER  BY (d."max_driver_points" + c."max_constructor_points") ASC,
          d."year" ASC
LIMIT 3;
```
