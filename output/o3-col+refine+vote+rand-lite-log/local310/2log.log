```sql
--Description:  (#5)  Total constructor points by season and constructor, 
--               sorted so you can see the biggest-scoring teams each year.
SELECT r."year",
       res."constructor_id",
       SUM(res."points") AS constructor_points
FROM   "results" AS res
JOIN   "races"   AS r ON r."race_id" = res."race_id"
GROUP  BY r."year", res."constructor_id"
ORDER  BY r."year", constructor_points DESC
LIMIT 20;
```

```sql
--Description:  (#6)  Highest season-total of points achieved by any constructor
--               in each year (first 20 years shown).
WITH season_constructor_totals AS (
    SELECT r."year",
           res."constructor_id",
           SUM(res."points") AS constructor_points
    FROM   "results" AS res
    JOIN   "races"   AS r ON r."race_id" = res."race_id"
    GROUP  BY r."year", res."constructor_id"
)
SELECT "year",
       MAX(constructor_points) AS max_constructor_points
FROM   season_constructor_totals
GROUP  BY "year"
ORDER  BY "year"
LIMIT 20;
```

```sql
--Description:  (#7)  Combine the per-season maxima (best driver total and best
--               constructor total) and list every season with the summed value.
WITH season_driver_totals AS (
    SELECT r."year",
           res."driver_id",
           SUM(res."points") AS driver_points
    FROM   "results" AS res
    JOIN   "races"   AS r ON r."race_id" = res."race_id"
    GROUP  BY r."year", res."driver_id"
),
driver_max AS (
    SELECT "year",
           MAX(driver_points) AS max_driver_points
    FROM   season_driver_totals
    GROUP  BY "year"
),
season_constructor_totals AS (
    SELECT r."year",
           res."constructor_id",
           SUM(res."points") AS constructor_points
    FROM   "results" AS res
    JOIN   "races"   AS r ON r."race_id" = res."race_id"
    GROUP  BY r."year", res."constructor_id"
),
constructor_max AS (
    SELECT "year",
           MAX(constructor_points) AS max_constructor_points
    FROM   season_constructor_totals
    GROUP  BY "year"
)
SELECT d."year",
       d.max_driver_points + c.max_constructor_points AS combined_max_points
FROM   driver_max      AS d
JOIN   constructor_max AS c USING ("year")
ORDER  BY combined_max_points ASC, d."year" ASC
LIMIT 20;
