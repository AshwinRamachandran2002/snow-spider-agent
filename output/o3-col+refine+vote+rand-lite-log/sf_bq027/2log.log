```sql
--Description: 1) Peek at a few publications (any year) to confirm the main columns we will use later  
SELECT 
  "publication_number",
  "grant_date",
  "publication_date",
  "citation"
FROM PATENTS.PATENTS.PUBLICATIONS
LIMIT 20;
```

```sql
--Description: 2) Look only at patents whose grant_date lies between 2010-01-01 and 2018-12-31 (inclusive)  
SELECT
  "publication_number",
  "grant_date",
  "citation"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "grant_date" BETWEEN 20100101 AND 20181231
LIMIT 20;
```

```sql
--Description: 3) Inspect the structure of the Variant-typed "citation" field for one recent patent  
SELECT 
  "publication_number",
  f.value                         AS "citation_item"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
LIMIT 20;
```

```sql
--Description: 4) From the flattened citation array, view the keys that exist inside each citation object  
SELECT 
  DISTINCT OBJECT_KEYS(f.value)  AS "citation_keys"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
LIMIT 20;
```

```sql
--Description: 5) Display a few citation objects whose internal key "category" (if present) equals 'SEA'  
SELECT
  p."publication_number",
  f.value                       AS "sea_citation_object"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
  AND LOWER(f.value:"category"::STRING) = 'sea'
LIMIT 20;
```

```sql
--Description: 6) Count the number of SEA-category backward citations for each patent granted 2010-2018  
SELECT
  p."publication_number",
  COUNT(*)                       AS "sea_backward_citation_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
  AND LOWER(f.value:"category"::STRING) = 'sea'
GROUP BY p."publication_number"
LIMIT 20;
```

```sql
--Description: 7) Same as (6) but return only patents that have at least one SEA citation and sort by count  
SELECT
  p."publication_number",
  COUNT(*)                       AS "sea_backward_citation_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
  AND LOWER(f.value:"category"::STRING) = 'sea'
GROUP BY p."publication_number"
HAVING COUNT(*) > 0
ORDER BY "sea_backward_citation_cnt" DESC
LIMIT 20;
```

```sql
--Description: 8) Use DISTINCT to show how many unique patents (publication numbers) have at least one SEA citation  
SELECT DISTINCT
  p."publication_number"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
  AND LOWER(f.value:"category"::STRING) = 'sea'
LIMIT 20;
```

```sql
--Description: 9) Verify that SEA citations are truly “backward” by checking that cited publication_date < citing filing_date  
SELECT
  p."publication_number",
  p."filing_date",
  (f.value:"publication_number"::STRING) AS "cited_pubn",
  (f.value:"publication_date"::NUMBER)   AS "cited_pubn_date"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
  AND LOWER(f.value:"category"::STRING) = 'sea'
  AND (f.value:"publication_date"::NUMBER) < p."filing_date"
LIMIT 20;
```

```sql
--Description: 10) FINAL – deliver publication_number & SEA backward-citation count for patents granted 2010-2018  
SELECT
  p."publication_number",
  COUNT(*) AS "sea_backward_citations"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
  AND LOWER(f.value:"category"::STRING) = 'sea'
GROUP BY p."publication_number"
ORDER BY p."publication_number"
LIMIT 20;
```
