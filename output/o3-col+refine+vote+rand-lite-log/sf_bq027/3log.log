```sql
--Description: Sample granted patents (2010-2018) with their raw citation JSON
SELECT
    "publication_number",
    "grant_date",
    "citation"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "grant_date" BETWEEN 20100101 AND 20181231
LIMIT 20;
```

```sql
--Description: Peek inside the citation array of those patents
SELECT
    p."publication_number",
    p."grant_date",
    f.value AS "citation_element"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
LIMIT 20;
```

```sql
--Description: Inspect the structure of one citation element
SELECT
    f.value:"publication_number"::STRING       AS "cited_pub",
    f.value:"category"::STRING                AS "category",
    f.value:"kind"::STRING                    AS "kind",
    f.value:"patent_office_code"::STRING      AS "office"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
LIMIT 20;
```

```sql
--Description: List the distinct citation categories that appear
SELECT DISTINCT
    f.value:"category"::STRING AS "distinct_category"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
LIMIT 20;
```

```sql
--Description: Show a few citations that fall into category “SEA”
SELECT
    p."publication_number"        AS "granted_pub",
    f.value:"publication_number"::STRING AS "cited_pub",
    f.value:"category"::STRING    AS "category"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value:"category"::STRING ILIKE '%SEA%'
LIMIT 20;
```

```sql
--Description: Count SEA-category backward citations for each granted patent
SELECT
    p."publication_number",
    COUNT(*) AS "sea_citation_count"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value:"category"::STRING ILIKE '%SEA%'
GROUP BY p."publication_number"
LIMIT 20;
```

```sql
--Description: Same as above but return only patents that have ≥1 SEA citation
SELECT
    "publication_number",
    "sea_citation_count"
FROM (
    SELECT
        p."publication_number",
        COUNT(*) AS "sea_citation_count"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") f
    WHERE p."grant_date" BETWEEN 20100101 AND 20181231
      AND f.value:"category"::STRING ILIKE '%SEA%'
    GROUP BY p."publication_number"
) s
WHERE "sea_citation_count" > 0
LIMIT 20;
```

```sql
--Description: Order patents by the number of SEA backward citations (desc)
SELECT
    "publication_number",
    "sea_citation_count"
FROM (
    SELECT
        p."publication_number",
        COUNT(*) AS "sea_citation_count"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") f
    WHERE p."grant_date" BETWEEN 20100101 AND 20181231
      AND f.value:"category"::STRING ILIKE '%SEA%'
    GROUP BY p."publication_number"
) s
ORDER BY "sea_citation_count" DESC
LIMIT 20;
```

```sql
--Description: Double-check that we correctly exclude citations outside 2010-2018
SELECT
    COUNT(DISTINCT p."publication_number") AS "total_grants_2010_2018",
    COUNT(DISTINCT CASE WHEN f.value:"category"::STRING ILIKE '%SEA%' THEN p."publication_number" END) AS "with_sea_citations"
FROM PATENTS.PATENTS.PUBLICATIONS p
LEFT JOIN LATERAL FLATTEN(input => p."citation") f ON TRUE
WHERE p."grant_date" BETWEEN 20100101 AND 20181231;
```

