```sql
--Description: Final query – list each patent granted between 2010-2018 together with the number
--             of backward citations whose “category” contains ‘SEA’.  
--             Uses comma-style placement of LATERAL FLATTEN (no JOIN predicate) to avoid the
--             unsupported OUTER JOIN-with-table-function pattern.
SELECT
    p."publication_number",
    COUNT(*) AS "sea_citation_count"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f      -- only expands rows that have citations
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value:"category"::STRING ILIKE '%SEA%'
GROUP BY p."publication_number"
ORDER BY p."publication_number"
LIMIT 20;
```
