```sql
--Description: Preview patent publications that contain citation data
SELECT 
  "publication_number",
  "grant_date",
  "citation"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "citation" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Flatten the citation array to inspect its internal structure
SELECT 
  p."publication_number", 
  f.value AS "raw_citation_record"
FROM PATENTS.PATENTS.PUBLICATIONS p, 
     LATERAL FLATTEN(input => p."citation") f
WHERE p."citation" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Extract likely keys inside each citation record
SELECT 
  p."publication_number",
  f.value:"publication_number"::STRING        AS "cited_pub_number",
  f.value:"category"::STRING                 AS "citation_category",
  f.value:"kind"::STRING                     AS "citation_kind"
FROM PATENTS.PATENTS.PUBLICATIONS p, 
     LATERAL FLATTEN(input => p."citation") f
WHERE p."citation" IS NOT NULL
LIMIT 20;
```

```sql
--Description: List all distinct citation categories that appear in the database
SELECT DISTINCT
  f.value:"category"::STRING AS "citation_category"
FROM PATENTS.PATENTS.PUBLICATIONS p, 
     LATERAL FLATTEN(input => p."citation") f
WHERE p."citation" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Retrieve citations whose category contains the text 'SEA'
SELECT 
  p."publication_number",
  f.value:"publication_number"::STRING AS "cited_pub_number",
  f.value:"category"::STRING          AS "citation_category"
FROM PATENTS.PATENTS.PUBLICATIONS p, 
     LATERAL FLATTEN(input => p."citation") f
WHERE f.value:"category"::STRING ILIKE '%SEA%'
LIMIT 20;
```

```sql
--Description: Preview patents granted between 2010-01-01 and 2018-12-31 that also have citations
SELECT 
  "publication_number",
  "grant_date"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "grant_date" BETWEEN 20100101 AND 20181231
  AND "citation" IS NOT NULL
LIMIT 20;
```

```sql
--Description: For patents granted 2010-2018, count how many of their backward citations are tagged with 'SEA'
SELECT 
  p."publication_number",
  COUNT(*) AS "sea_backward_citation_count"
FROM PATENTS.PATENTS.PUBLICATIONS p, 
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value:"category"::STRING ILIKE '%SEA%'
GROUP BY p."publication_number"
LIMIT 20;
```

```sql
--Description: Show the top 20 patents (2010-2018 grants) with the highest number of 'SEA' backward citations
SELECT 
  p."publication_number",
  COUNT(*) AS "sea_backward_citation_count"
FROM PATENTS.PATENTS.PUBLICATIONS p, 
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value:"category"::STRING ILIKE '%SEA%'
GROUP BY p."publication_number"
ORDER BY "sea_backward_citation_count" DESC
LIMIT 20;
```
