Query:
--Description: Corrected final query – returns every patent granted between 2010-01-01 and 2018-12-31 together with
--             the count of citations whose category value contains “SEA”.  The earlier “direction = backward”
--             filter has been removed because that key is not present in most citation objects.
SELECT
    t."publication_number",
    COUNT(*) AS "sea_citation_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value:"category"::STRING ILIKE '%SEA%'
GROUP BY t."publication_number"
