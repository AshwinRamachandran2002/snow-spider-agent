```sql
--Description: 1) Quick look at patents that were granted between 2010-01-01 and 2018-12-31  
SELECT 
    t."publication_number",
    t."grant_date"
FROM PATENTS.PATENTS.PUBLICATIONS t
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
LIMIT 20;
```

```sql
--Description: 2) Same grant-date slice, but keep only those publications whose "citation" array is not empty  
SELECT 
    t."publication_number",
    t."grant_date",
    t."citation"
FROM PATENTS.PATENTS.PUBLICATIONS t
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND t."citation" IS NOT NULL 
  AND t."citation" != '[]'
LIMIT 20;
```

```sql
--Description: 3) Peek inside one publication’s raw citation objects (flatten the array)  
SELECT 
    t."publication_number",
    f.value AS "raw_citation_object"
FROM PATENTS.PATENTS.PUBLICATIONS t, 
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND t."citation" IS NOT NULL 
  AND t."citation" != '[]'
LIMIT 20;
```

```sql
--Description: 4) Inspect the fields that exist in the citation objects to see available keys  
SELECT 
    OBJECT_KEYS(f.value) AS "citation_keys"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND t."citation" IS NOT NULL 
  AND t."citation" != '[]'
LIMIT 20;
```

```sql
--Description: 5) Extract the (possible) “category” field from citation objects for a feel of values present  
SELECT 
    f.value:"category"::STRING AS "category",
    COUNT(*) AS "examples"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
GROUP BY f.value:"category"::STRING
LIMIT 20;
```

```sql
--Description: 6) Show a few citations specifically where the category string contains “SEA” (case-insensitive)  
SELECT 
    t."publication_number",
    f.value:"category"::STRING AS "category",
    f.value AS "full_citation"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value:"category"::STRING ILIKE '%SEA%'
LIMIT 20;
```

```sql
--Description: 7) Count how many SEA-category backward citations each qualifying publication holds  
SELECT 
    t."publication_number",
    COUNT(*) AS "sea_backward_citation_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value:"category"::STRING ILIKE '%SEA%'
GROUP BY t."publication_number"
LIMIT 20;
```

```sql
--Description: 8) Verify that the “direction” (forward/backward) indicator exists and equals “backward”  
SELECT 
    f.value:"direction"::STRING AS "direction",
    f.value:"category"::STRING  AS "category",
    COUNT(*) AS "cnt"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value:"category"::STRING ILIKE '%SEA%'
GROUP BY f.value:"direction"::STRING,
         f.value:"category"::STRING
LIMIT 20;
```

```sql
--Description: 9) Restrict to citations that are both SEA category and explicitly flagged as “backward”  
SELECT
    t."publication_number",
    COUNT(*) AS "sea_backward_citation_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value:"category"::STRING ILIKE '%SEA%'
  AND f.value:"direction"::STRING ILIKE '%backward%'
GROUP BY t."publication_number"
LIMIT 20;
```

```sql
--Description: 10) (Final form) Full result set – each patent granted 2010-2018 with its SEA backward-citation count  
SELECT
    t."publication_number",
    COUNT(*) AS "sea_backward_citation_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value:"category"::STRING ILIKE '%SEA%'
  AND f.value:"direction"::STRING ILIKE '%backward%'
GROUP BY t."publication_number";
```
