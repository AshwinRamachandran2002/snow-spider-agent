Query:
--Description: 5) Extract the (possible) “category” field from citation objects for a feel of values present  
SELECT 
    f.value:"category"::STRING AS "category",
    COUNT(*) AS "examples"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
GROUP BY f.value:"category"::STRING
LIMIT 20;
