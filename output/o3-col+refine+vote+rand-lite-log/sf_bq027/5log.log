```sql
--Description / Thinking process:
--Task: Count, for every patent granted between 2010-01-01 and 2018-12-31, how many citations are tagged
--      with category strings that include ‘SEA’.  Earlier attempts to also filter on a “direction”
--      field returned zero rows because that key is absent in most citation objects, so we now omit it.
--Steps:
-- 1. Start from PATENTS.PATENTS.PUBLICATIONS (alias t).
-- 2. Restrict to the grant-date window using the numeric YYYYMMDD format.
-- 3. Flatten the JSON array “citation” so each array element becomes one row (alias f).
-- 4. Keep only flattened rows whose "category" value (cast to string) contains ‘SEA’ (case-insensitive).
-- 5. Group by publication_number and count those SEA citations.
-- 6. Order by that count (descending) to see patents with the most SEA citations.
-- 7. Limit to 20 rows just for inspection.
SELECT
    t."publication_number",
    COUNT(*) AS "sea_citation_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS AS t,
     LATERAL FLATTEN(input => t."citation") AS f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value:"category"::STRING ILIKE '%SEA%'
GROUP BY t."publication_number"
ORDER BY "sea_citation_cnt" DESC
LIMIT 20;
```
