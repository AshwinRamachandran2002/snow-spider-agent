Query:
--Description: Show flattened citation elements (all fields) for patents
-- granted between 2010-2018 to observe the “category” field values.
SELECT 
  t."publication_number",
  t."grant_date",
  f.value AS "citation_obj"
FROM PATENTS.PATENTS.PUBLICATIONS t,
  LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
LIMIT 20;
