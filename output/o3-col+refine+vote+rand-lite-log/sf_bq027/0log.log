```sql
--Description: Quick look at basic publication information ‒
-- publication number, grant year, and raw citation array.
SELECT 
  "publication_number",
  "grant_date",
  "citation"
FROM PATENTS.PATENTS.PUBLICATIONS
LIMIT 20;
```

```sql
--Description: Distinct grant years available in the table (helps see 2010-2018 coverage).
SELECT DISTINCT 
  FLOOR("grant_date" / 10000) AS "grant_year"
FROM PATENTS.PATENTS.PUBLICATIONS
ORDER BY "grant_year"
LIMIT 20;
```

```sql
--Description: Inspect the structure of one citation entry by flattening
-- the first publication that has citations.
SELECT 
  t."publication_number",
  f.value
FROM PATENTS.PATENTS.PUBLICATIONS t,
  LATERAL FLATTEN(input => t."citation") f
WHERE t."citation" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Show flattened citation elements (all fields) for patents
-- granted between 2010-2018 to observe the “category” field values.
SELECT 
  t."publication_number",
  t."grant_date",
  f.value AS "citation_obj"
FROM PATENTS.PATENTS.PUBLICATIONS t,
  LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
LIMIT 20;
```

```sql
--Description: Sample count of ALL backward citations per publication for
-- patents granted 2010-2018.
SELECT 
  t."publication_number",
  COUNT(*) AS "all_citation_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS t,
  LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
GROUP BY t."publication_number"
LIMIT 20;
```

```sql
--Description: Extract “category” field from each citation object to verify
-- SEA (or similar) tag values.
SELECT 
  f.value:"category"::STRING AS "citation_category",
  COUNT(*) AS "occurrences"
FROM PATENTS.PATENTS.PUBLICATIONS t,
  LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
GROUP BY f.value:"category"::STRING
ORDER BY "occurrences" DESC
LIMIT 20;
```

```sql
--Description: Check distribution of citation categories for a single
-- randomly chosen publication (granted in 2010-2018).
SELECT 
  t."publication_number",
  f.value:"category"::STRING AS "citation_category",
  COUNT(*) AS "cnt"
FROM PATENTS.PATENTS.PUBLICATIONS t,
  LATERAL FLATTEN(input => t."citation") f
WHERE t."publication_number" = (
    SELECT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "grant_date" BETWEEN 20100101 AND 20181231
      AND "citation" IS NOT NULL
    LIMIT 1
)
GROUP BY t."publication_number", f.value:"category"::STRING
LIMIT 20;
```

```sql
--Description: Gather the number of SEA-category citations per publication
-- (2010-2018) but show only the first 20 rows.
SELECT
  t."publication_number",
  COUNT(*) AS "sea_citation_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS t,
  LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND LOWER(f.value:"category"::STRING) = 'sea'
GROUP BY t."publication_number"
LIMIT 20;
```

```sql
--Description: Same as previous but include patents with zero SEA citations
-- to contrast counts (first 20 rows).
SELECT
  p."publication_number",
  COALESCE(sea."sea_citation_cnt", 0) AS "sea_citation_cnt"
FROM (
    SELECT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "grant_date" BETWEEN 20100101 AND 20181231
) p
LEFT JOIN (
    SELECT
      t."publication_number",
      COUNT(*) AS "sea_citation_cnt"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
      LATERAL FLATTEN(input => t."citation") f
    WHERE LOWER(f.value:"category"::STRING) = 'sea'
      AND t."grant_date" BETWEEN 20100101 AND 20181231
    GROUP BY t."publication_number"
) sea
ON p."publication_number" = sea."publication_number"
LIMIT 20;
```

```sql
--Description: Final query template ‒ publication numbers and SEA backward-
-- citation counts for ALL patents granted 2010-2018 (no LIMIT here,
-- remove LIMIT in production; kept 20 here for sampling).
SELECT
  t."publication_number",
  COUNT(*) AS "sea_citation_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS t,
  LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND LOWER(f.value:"category"::STRING) = 'sea'
GROUP BY t."publication_number"
ORDER BY "sea_citation_cnt" DESC
LIMIT 20;
```
