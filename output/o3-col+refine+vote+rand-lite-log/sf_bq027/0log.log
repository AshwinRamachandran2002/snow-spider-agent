Query:
--Description: Same as above but also list patents with ZERO SEA citations
--             (2010-2018 window); preview 20 rows.
SELECT
    p."publication_number",
    COALESCE(sea."sea_citation_cnt", 0) AS "sea_citation_cnt"
FROM (
        SELECT "publication_number"
        FROM PATENTS.PATENTS.PUBLICATIONS
        WHERE "grant_date" BETWEEN 20100101 AND 20181231
     ) p
LEFT JOIN (
        SELECT
            t."publication_number",
            COUNT(*) AS "sea_citation_cnt"
        FROM PATENTS.PATENTS.PUBLICATIONS t,
             LATERAL FLATTEN(input => t."citation") f
        WHERE t."grant_date" BETWEEN 20100101 AND 20181231
          AND LOWER(f.value:"category"::STRING) LIKE 'sea%'
        GROUP BY t."publication_number"
     ) sea
ON p."publication_number" = sea."publication_number"
LIMIT 20
