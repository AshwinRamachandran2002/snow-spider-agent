--Description:  We want an example patent (2010-2018 grants) that actually has
--              at least one backward citation, so the FLATTEN will return rows.
--              The inner sub-query first finds patents in that period, flattens
--              their "citation" arrays, counts the total citations per patent,
--              orders by that count (descending), and keeps only the top one.
--              The outer query then shows, for that selected patent, how many
--              citations fall into each “category” (SEA, APP, EXA, …).
--              LIMIT 20 just caps the preview.
SELECT
    t."publication_number",
    f.value:"category"::STRING AS "citation_category",
    COUNT(*)                       AS "cnt"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."publication_number" = (
        /* pick a patent with the most citations in 2010-2018 window */
        SELECT pub_inner."publication_number"
        FROM PATENTS.PATENTS.PUBLICATIONS pub_inner,
             LATERAL FLATTEN(input => pub_inner."citation") f_inner
        WHERE pub_inner."grant_date" BETWEEN 20100101 AND 20181231
        GROUP BY pub_inner."publication_number"
        ORDER BY COUNT(*) DESC
        LIMIT 1
      )
GROUP BY
    t."publication_number",
    f.value:"category"::STRING
LIMIT 20;
```
