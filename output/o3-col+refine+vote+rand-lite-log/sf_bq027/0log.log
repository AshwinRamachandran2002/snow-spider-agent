Query:
--Description: Extract “category” field from each citation object to verify
-- SEA (or similar) tag values.
SELECT 
  f.value:"category"::STRING AS "citation_category",
  COUNT(*) AS "occurrences"
FROM PATENTS.PATENTS.PUBLICATIONS t,
  LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
GROUP BY f.value:"category"::STRING
ORDER BY "occurrences" DESC
LIMIT 20;
