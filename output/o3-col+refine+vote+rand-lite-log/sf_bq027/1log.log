```sql
--Description: Retrieve a sample of distinct publication numbers (and their grant dates) for patents granted between 2010-01-01 and 2018-12-31.
SELECT DISTINCT 
       "publication_number", 
       "grant_date"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "grant_date" BETWEEN 20100101 AND 20181231
LIMIT 20;
```

```sql
--Description: Inspect the raw “citation” variant column for those same grant-year restrictions.
SELECT 
       "publication_number", 
       "citation"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "grant_date" BETWEEN 20100101 AND 20181231
  AND "citation" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Flatten the citation array to view individual citation records attached to each publication.
SELECT 
       p."publication_number", 
       c.value AS "citation_record"
FROM PATENTS.PATENTS.PUBLICATIONS  p,
     LATERAL FLATTEN(input => p."citation") c
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
LIMIT 20;
```

```sql
--Description: List the distinct JSON keys that appear inside citation records (helps find a “category” key or similar).
SELECT DISTINCT 
       OBJECT_KEYS(c.value) AS "citation_keys"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") c
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
LIMIT 20;
```

```sql
--Description: Show all distinct values found in the “category” field of citation records for 2010-2018 grants.
SELECT DISTINCT 
       c.value:"category"::STRING AS "citation_category"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") c
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
  AND c.value:"category" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Display sample citation records whose category equals ‘SEA’ (case-insensitive match).
SELECT 
       p."publication_number",
       c.value AS "sea_citation"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") c
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
  AND c.value:"category"::STRING ILIKE 'SEA'
LIMIT 20;
```

```sql
--Description: Count the number of ‘SEA’-category backward citations each publication received (top 20 by count).
SELECT 
       p."publication_number",
       COUNT(*) AS "sea_backward_citation_count"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") c
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
  AND c.value:"category"::STRING ILIKE 'SEA'
GROUP BY p."publication_number"
ORDER BY "sea_backward_citation_count" DESC
LIMIT 20;
```

```sql
--Description: For comparison, count ALL citation records (any category) per publication for the same grant window.
SELECT 
       p."publication_number",
       COUNT(*) AS "total_citation_count"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") c
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
GROUP BY p."publication_number"
ORDER BY "total_citation_count" DESC
LIMIT 20;
```

```sql
--Description: Identify publications that have at least one SEA citation (Boolean filter with HAVING clause).
SELECT 
       p."publication_number"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") c
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
GROUP BY p."publication_number"
HAVING SUM(CASE WHEN c.value:"category"::STRING ILIKE 'SEA' THEN 1 ELSE 0 END) > 0
LIMIT 20;
```

```sql
--Description: Final aggregation – publication number with its SEA backward-citation count for patents granted 2010-2018.
SELECT 
       p."publication_number",
       COUNT(*) AS "sea_backward_citation_count"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") c
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
  AND c.value:"category"::STRING ILIKE 'SEA'
GROUP BY p."publication_number"
LIMIT 20;
```
