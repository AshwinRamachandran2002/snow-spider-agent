Table full name: bigquery-public-data.san_francisco.bikeshare_trips
Column name: trip_id Type: INT64 Description: Numeric ID of bike trip
Column name: duration_sec Type: INT64 Description: Time of trip in seconds
Column name: start_date Type: TIMESTAMP Description: Start date of trip with date and time, in PST
Column name: start_station_name Type: STRING Description: Station name of start station
Column name: start_station_id Type: INT64 Description: Numeric reference for start station
Column name: end_date Type: TIMESTAMP Description: End date of trip with date and time, in PST
Column name: end_station_name Type: STRING Description: Station name for end station
Column name: end_station_id Type: INT64 Description: Numeric reference for end station
Column name: bike_number Type: INT64 Description: ID of bike used
Column name: zip_code Type: STRING Description: Home zip code of subscriber (customers can choose to manually enter zip at kiosk however data is unreliable)
Column name: subscriber_type Type: STRING Description: Subscriber = annual or 30-day member; Customer = 24-hour or 3-day member
