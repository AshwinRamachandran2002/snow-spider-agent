Table full name: bigquery-public-data.san_francisco.311_service_requests
Column name: unique_key Type: INT64 Description: Unique case id
Column name: created_date Type: TIMESTAMP Description: The date and time when the service request was made
Column name: closed_date Type: TIMESTAMP Description: The date and time when the service request was closed
Column name: resolution_action_updated_date Type: TIMESTAMP Description: The date and time when the service request was last modified. For requests with status=closed, this will be the date the request was closed
Column name: status Type: STRING Description: The current status of the service request.
Column name: status_notes Type: STRING Description: Explanation of why status was changed to current state or more details on current status than conveyed with status alone
Column name: agency_name Type: STRING Description: The agency responsible for fulfilling or otherwise addressing the service request.
Column name: category Type: STRING Description: The Human readable name of the specific service request type (service_name)
Column name: complaint_type Type: STRING Description: More specific description of the problem related to the Category
Column name: descriptor Type: STRING Description: More specific description of the problem related to the Request Type
Column name: incident_address Type: STRING Description: Human readable address or description of location
Column name: supervisor_district Type: INT64
Column name: neighborhood Type: STRING
Column name: location Type: STRING Description: Latitude and longitude using the (WGS84) projection.
Column name: source Type: STRING Description: How the service request was made
Column name: media_url Type: STRING Description: Website URL
Column name: latitude Type: FLOAT64 Description: Latitude using the (WGS84) projection.
Column name: longitude Type: FLOAT64 Description: Longitude using the (WGS84) projection.
Column name: police_district Type: STRING
Sample rows:
[{'unique_key': 4875703, 'created_date': '2015-07-02 13:37:09+00:00', 'closed_date': '2015-07-14 15:01:16+00:00', 'resolution_action_updated_date': '2015-07-14 15:01:16+00:00', 'status': 'Closed', 'status_notes': 'resolved: Maximo Service Request has been resolved', 'agency_name': 'PUC Sewer Ops', 'category': 'Sewer Issues', 'complaint_type': 'Odor', 'descriptor': 'Odor From_catch_basin', 'incident_address': 'Not associated with a specific address', 'supervisor_district': None, 'neighborhood': '', 'location': '', 'source': 'Web', 'media_url': '', 'latitude': 0.0, 'longitude': 0.0, 'police_district': ''}, {'unique_key': 3645142, 'created_date': '2014-05-15 11:25:58+00:00', 'closed_date': '2014-05-19 06:26:42+00:00', 'resolution_action_updated_date': '2014-05-19 06:26:42+00:00', 'status': 'Closed', 'status_notes': 'cancelled: Maximo Service Request has been cancelled', 'agency_name': 'PUC Sewer Ops', 'category': 'Sewer Issues', 'complaint_type': 'Odor', 'descriptor': 'Odor From_manhole_cover', 'incident_address': 'Not associated with a specific address', 'supervisor_district': None, 'neighborhood': '', 'location': '', 'source': 'Web', 'media_url': '', 'latitude': 0.0, 'longitude': 0.0, 'police_district': ''}, {'unique_key': 5188903, 'created_date': '2015-10-14 15:33:01+00:00', 'closed_date': 'NaT', 'resolution_action_updated_date': '2015-10-14 18:12:27+00:00', 'status': 'Open', 'status_notes': 'open', 'agency_name': 'PUC - Sewer - G', 'category': 'Sewer Issues', 'complaint_type': 'Odor', 'descriptor': 'Odor From_other_location', 'incident_address': 'Not associated with a specific address', 'supervisor_district': None, 'neighborhood': '', 'location': '', 'source': 'Web', 'media_url': '', 'latitude': 0.0, 'longitude': 0.0, 'police_district': ''}, {'unique_key': 2222674, 'created_date': '2013-04-08 23:53:48+00:00', 'closed_date': '2013-04-09 06:59:22+00:00', 'resolution_action_updated_date': '2013-04-09 06:59:22+00:00', 'status': 'Closed', 'status_notes': 'Eastside Recyc