FROM `bigquery-public-data.san_francisco.bikeshare_trips`
LIMIT 20;
```

```sql
--Description: 4) For one month (201506) list the trips ordered by start_date to see “first” & “last”
SELECT 
  trip_id,
  start_date,
  ROUND(duration_sec/60.0,2) AS duration_min
FROM `bigquery-public-data.san_francisco.bikeshare_trips`
WHERE FORMAT_TIMESTAMP('%Y%m', start_date) = '201506'
ORDER BY start_date
LIMIT 20;
```

```sql
--Description: 5) Use window functions to tag each trip with its rank (earliest / latest) inside its month
SELECT
  trip_id,
  FORMAT_TIMESTAMP('%Y%m', start_date) AS ym,
  start_date,
  ROUND(duration_sec/60.0,2)           AS duration_min,
  ROW_NUMBER() OVER (PARTITION BY FORMAT_TIMESTAMP('%Y%m', start_date) 
                     ORDER BY start_date)          AS rn_asc,
  ROW_NUMBER() OVER (PARTITION BY FORMAT_TIMESTAMP('%Y%m', start_date) 
                     ORDER BY start_date DESC)     AS rn_desc
FROM `bigquery-public-data.san_francisco.bikeshare_trips`
LIMIT 20;
```

```sql
--Description: 6) Aggregate the four requested metrics for a single month (201506)  
WITH trips AS (
  SELECT
    FORMAT_TIMESTAMP('%Y%m', start_date) AS ym,
    start_date,
    duration_sec/60.0 AS duration_min
  FROM `bigquery-public-data.san_francisco.bikeshare_trips`
  WHERE FORMAT_TIMESTAMP('%Y%m', start_date) = '201506'
), ranked AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY ym ORDER BY start_date)      AS rn_asc,
         ROW_NUMBER() OVER (PARTITION BY ym ORDER BY start_date DESC) AS rn_desc
  FROM trips
)
SELECT
  ym,
  MAX(IF(rn_asc  = 1, duration_min, NULL)) AS first_trip_min,
  MAX(IF(rn_desc = 1, duration_min, NULL)) AS last_trip_min,
  MAX(duration_min)                        AS longest_trip_min,
  MIN(duration_min)                        AS shortest_trip_min
FROM ranked
GROUP BY ym
LIMIT 20;
```

```sql
--Description: 7) Same aggregation for every month but show only the first 20 year-months
WITH trips AS (
  SELECT
    FORMAT_TIMESTAMP('%Y%m', start_date) AS ym,
    start_date,
    duration_sec/60.0 AS duration_min
  FROM `bigquery-public-data.san_francisco.bikeshare_trips`
), ranked AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY ym ORDER BY start_date)      AS rn_asc,
         ROW_NUMBER() OVER (PARTITION BY ym ORDER BY start_date DESC) AS rn_desc
  FROM trips
)
SELECT
  ym,
  MAX(IF(rn_asc  = 1, duration_min, NULL)) AS first_trip_min,
  MAX(IF(rn_desc = 1, duration_min, NULL)) AS last_trip_min,
  MAX(duration_min)                        AS longest_trip_min,
  MIN(duration_min)                        AS shortest_trip_min
FROM ranked
GROUP BY ym
ORDER BY ym
LIMIT 20;
```

```sql
--Description: 8) FINAL ANSWER – complete list of all months with first, last, highest & lowest trip durations (in minutes)
WITH trips AS (
  SELECT
    FORMAT_TIMESTAMP('%Y%m', start_date) AS ym,
    start_date,
    duration_sec/60.0 AS duration_min
  FROM `bigquery-public-data.san_francisco.bikeshare_trips`
), ranked AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY ym ORDER BY start_date)      AS rn_asc,
         ROW_NUMBER() OVER (PARTITION BY ym ORDER BY start_date DESC) AS rn_desc
  FROM trips
)
SELECT
  ym,
  CAST(MAX(IF(rn_asc  = 1, duration_min, NULL)) AS NUMERIC) AS first_trip_duration_min,
  CAST(MAX(IF(rn_desc = 1, duration_min, NULL)) AS NUMERIC) AS last_trip_duration_min,
  CAST(MAX(duration_min)                        AS NUMERIC) AS highest_trip_duration_min,
  CAST(MIN(duration_min)                        AS NUMERIC) AS lowest_trip_duration_min
FROM ranked
GROUP BY ym
ORDER BY ym;
```

