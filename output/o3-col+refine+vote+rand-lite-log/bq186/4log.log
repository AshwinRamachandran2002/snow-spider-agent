Query:
--Description: 5) Use window functions to tag each trip with its rank (earliest / latest) inside its month
SELECT
  trip_id,
  FORMAT_TIMESTAMP('%Y%m', start_date) AS ym,
  start_date,
  ROUND(duration_sec/60.0,2)           AS duration_min,
  ROW_NUMBER() OVER (PARTITION BY FORMAT_TIMESTAMP('%Y%m', start_date) 
                     ORDER BY start_date)          AS rn_asc,
  ROW_NUMBER() OVER (PARTITION BY FORMAT_TIMESTAMP('%Y%m', start_date) 
                     ORDER BY start_date DESC)     AS rn_desc
FROM `bigquery-public-data.san_francisco.bikeshare_trips`
LIMIT 20;
Answer:
trip_id,ym,start_date,duration_min,rn_asc,rn_desc
477116,201409,2014-09-30 23:53:00+00:00,10.55,31682,1
477115,201409,2014-09-30 23:34:00+00:00,3.73,31681,2
477114,201409,2014-09-30 23:26:00+00:00,3.6,31680,3
Query:
--Description: 6) Aggregate the four requested metrics for a single month (201506)  
WITH trips AS (
  SELECT
    FORMAT_TIMESTAMP('%Y%m', start_date) AS ym,
    start_date,
    duration_sec/60.0 AS duration_min
  FROM `bigquery-public-data.san_francisco.bikeshare_trips`
  WHERE FORMAT_TIMESTAMP('%Y%m', start_date) = '201506'
), ranked AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY ym ORDER BY start_date)      AS rn_asc,
         ROW_NUMBER() OVER (PARTITION BY ym ORDER BY start_date DESC) AS rn_desc
  FROM trips
)
SELECT
  ym,
  MAX(IF(rn_asc  = 1, duration_min, NULL)) AS first_trip_min,
  MAX(IF(rn_desc = 1, duration_min, NULL)) AS last_trip_min,
  MAX(duration_min)                        AS longest_trip_min,
  MIN(duration_min)                        AS shortest_trip_min
FROM ranked
GROUP BY ym
LIMIT 20;
Answer:
ym,first_trip_min,last_trip_min,longest_trip_min,shortest_trip_min
201506,6.433333333333334,5.65,35616.666666666664,1.0
