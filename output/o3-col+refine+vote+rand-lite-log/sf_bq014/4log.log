```sql
--Description: Get every user’s very first non-cancelled, non-returned order.
SELECT *
FROM (
    SELECT "user_id",
           "order_id",
           "created_at",
           ROW_NUMBER() OVER (PARTITION BY "user_id" ORDER BY "created_at") AS "rn"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
    WHERE "status" NOT ILIKE '%cancel%' 
      AND "returned_at" IS NULL
) t
WHERE "rn" = 1
LIMIT 20;
```

```sql
--Description: Pull the order-item records that belong to each user’s first valid order.
WITH first_orders AS (
    SELECT "user_id",
           "order_id"
    FROM (
        SELECT "user_id",
               "order_id",
               "created_at",
               ROW_NUMBER() OVER (PARTITION BY "user_id" ORDER BY "created_at") AS "rn"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "status" NOT ILIKE '%cancel%' 
          AND "returned_at" IS NULL
    ) fo
    WHERE "rn" = 1
)
SELECT oi."id"            AS "order_item_id",
       oi."order_id",
       oi."product_id",
       oi."sale_price"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
JOIN first_orders fo
  ON oi."order_id" = fo."order_id"
LIMIT 20;
```

```sql
--Description: Add the product category to the order-items from first valid orders.
WITH first_orders AS (
    SELECT "user_id",
           "order_id"
    FROM (
        SELECT "user_id",
               "order_id",
               "created_at",
               ROW_NUMBER() OVER (PARTITION BY "user_id" ORDER BY "created_at") AS "rn"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "status" NOT ILIKE '%cancel%' 
          AND "returned_at" IS NULL
    ) fo
    WHERE "rn" = 1
)
SELECT oi."order_id",
       oi."product_id",
       p."category",
       oi."sale_price"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
JOIN first_orders fo
  ON oi."order_id" = fo."order_id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
  ON oi."product_id" = p."id"
LIMIT 20;
```

```sql
--Description: Count how many distinct customers bought in each category through their first valid order.
WITH first_orders AS (
    SELECT "user_id",
           "order_id"
    FROM (
        SELECT "user_id",
               "order_id",
               "created_at",
               ROW_NUMBER() OVER (PARTITION BY "user_id" ORDER BY "created_at") AS "rn"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "status" NOT ILIKE '%cancel%' 
          AND "returned_at" IS NULL
    ) fo
    WHERE "rn" = 1
),
first_items AS (
    SELECT fo."user_id",
           p."category"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
    JOIN first_orders fo
      ON oi."order_id" = fo."order_id"
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
      ON oi."product_id" = p."id"
    GROUP BY fo."user_id", p."category"
)
SELECT "category",
       COUNT(DISTINCT "user_id") AS "customer_cnt"
FROM first_items
GROUP BY "category"
ORDER BY "customer_cnt" DESC
LIMIT 20;
```

```sql
--Description: Identify the single category that attracts the most first-time customers.
WITH first_orders AS (
    SELECT "user_id",
           "order_id"
    FROM (
        SELECT "user_id",
               "order_id",
               "created_at",
               ROW_NUMBER() OVER (PARTITION BY "user_id" ORDER BY "created_at") AS "rn"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "status" NOT ILIKE '%cancel%' 
          AND "returned_at" IS NULL
    ) fo
    WHERE "rn" = 1
),
first_items AS (
    SELECT fo."user_id",
           p."category"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
    JOIN first_orders fo
      ON oi."order_id" = fo."order_id"
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
      ON oi."product_id" = p."id"
    GROUP BY fo."user_id", p."category"
)
SELECT "category",
       COUNT(DISTINCT "user_id") AS "customer_cnt"
FROM first_items
GROUP BY "category"
ORDER BY "customer_cnt" DESC
LIMIT 1;
```

```sql
--Description: Compute the revenue generated by that top category in customers’ first valid orders.
WITH first_orders AS (
    SELECT "user_id",
           "order_id"
    FROM (
        SELECT "user_id",
               "order_id",
               "created_at",
               ROW_NUMBER() OVER (PARTITION BY "user_id" ORDER BY "created_at") AS "rn"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "status" NOT ILIKE '%cancel%' 
          AND "returned_at" IS NULL
    ) fo
    WHERE "rn" = 1
),
first_items AS (
    SELECT fo."user_id",
           fo."order_id",
           p."category",
           oi."sale_price"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
    JOIN first_orders fo
      ON oi."order_id" = fo."order_id"
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
      ON oi."product_id" = p."id"
),
top_category AS (
    SELECT "category"
    FROM (
        SELECT "category",
               COUNT(DISTINCT "user_id") AS "customer_cnt",
               ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT "user_id") DESC) AS "rnk"
        FROM first_items
        GROUP BY "category"
    ) tc
    WHERE "rnk" = 1
)
SELECT fi."category",
       SUM(fi."sale_price") AS "revenue"
FROM first_items fi
JOIN top_category tc
  ON fi."category" = tc."category"
GROUP BY fi."category"
LIMIT 20;
```

```sql
--Description: Revenue breakdown by category for first-time orders (for comparison).
WITH first_orders AS (
    SELECT "user_id",
           "order_id"
    FROM (
        SELECT "user_id",
               "order_id",
               "created_at",
               ROW_NUMBER() OVER (PARTITION BY "user_id" ORDER BY "created_at") AS "rn"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "status" NOT ILIKE '%cancel%' 
          AND "returned_at" IS NULL
    ) fo
    WHERE "rn" = 1
),
first_items AS (
    SELECT fo."user_id",
           p."category",
           oi."sale_price"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
    JOIN first_orders fo
      ON oi."order_id" = fo."order_id"
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
      ON oi."product_id" = p."id"
)
SELECT "category",
       SUM("sale_price") AS "revenue"
FROM first_items
GROUP BY "category"
ORDER BY "revenue" DESC
LIMIT 20;
```

