    ) t
    WHERE  "rn" = 1                               -- each customer’s first valid order
),
"first_items" AS (
    SELECT  fo."user_id",
            fo."order_id",
            p."category",
            oi."sale_price"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS   oi
