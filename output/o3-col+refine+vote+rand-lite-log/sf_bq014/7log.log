SELECT p."category",
       SUM(oi."sale_price") AS "total_revenue"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS      o
  ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS    p
  ON oi."product_id" = p."id"
WHERE p."category" = (
  SELECT "category"
  FROM (
    SELECT result."category",
           COUNT(DISTINCT result."user_id") AS "num_customers"
    FROM (
      SELECT f."user_id",
             p2."category"
      FROM (
        SELECT o2."user_id",
               o2."order_id",
               o2."created_at"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o2
        JOIN (
            SELECT t2."user_id",
                   MIN(t2."created_at") AS "first_created_at"
            FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS t2
            WHERE t2."status" ILIKE '%Complete%'
              AND t2."returned_at" IS NULL
            GROUP BY t2."user_id"
        ) first_orders
          ON o2."user_id"   = first_orders."user_id"
         AND o2."created_at" = first_orders."first_created_at"
      ) f
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi2
        ON f."order_id" = oi2."order_id"
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p2
        ON oi2."product_id" = p2."id"
    ) result
    GROUP BY result."category"
    ORDER BY "num_customers" DESC
    LIMIT 1
  )
)
AND o."status"  ILIKE '%Complete%'
AND oi."status" ILIKE '%Complete%'
AND o."returned_at"  IS NULL
AND oi."returned_at" IS NULL
GROUP BY p."category"
LIMIT 20;
