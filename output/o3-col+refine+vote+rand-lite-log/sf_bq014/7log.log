```sql
--Description: 3) Inspect the set of status values that appear in ORDER_ITEMS.
SELECT DISTINCT "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
LIMIT 20;
```

```sql
--Description: 4) Sample item-level rows that are complete and not returned. 
SELECT *
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
WHERE "status" ILIKE '%Complete%'
  AND "returned_at" IS NULL
LIMIT 20;
```

```sql
--Description: 5) Join ORDERS ↔ ORDER_ITEMS to view good items within good orders. 
SELECT oi."user_id",
       o."order_id",
       o."created_at",
       oi."product_id",
       oi."sale_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS         o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS    oi
  ON o."order_id" = oi."order_id"
WHERE o."status"  ILIKE '%Complete%'
  AND o."returned_at" IS NULL
  AND oi."status" ILIKE '%Complete%'
  AND oi."returned_at" IS NULL
LIMIT 20;
```

```sql
--Description: 6) For every customer, capture the timestamp of their first good order. 
SELECT t."user_id",
       MIN(t."created_at") AS "first_order_created_at"
FROM (
  SELECT o."user_id",
         o."created_at"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
  WHERE o."status" ILIKE '%Complete%'
    AND o."returned_at" IS NULL
) t
GROUP BY t."user_id"
LIMIT 20;
```

```sql
--Description: 7) Show which product categories appear in each customer’s first good order. 
SELECT f."user_id",
       p."category"
FROM (
  SELECT o."user_id",
         o."order_id"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
  JOIN (
      SELECT t2."user_id",
             MIN(t2."created_at") AS "first_created_at"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS t2
      WHERE t2."status" ILIKE '%Complete%'
        AND t2."returned_at" IS NULL
      GROUP BY t2."user_id"
  ) first_orders
    ON o."user_id"   = first_orders."user_id"
   AND o."created_at" = first_orders."first_created_at"
) f
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
  ON f."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS      p
  ON oi."product_id" = p."id"
LIMIT 20;
```

```sql
--Description: 8) Count how many unique customers bought from each category in their first good order. 
SELECT result."category",
       COUNT(DISTINCT result."user_id") AS "num_customers"
FROM (
  SELECT f."user_id",
         p."category"
  FROM (
    SELECT o."user_id",
           o."order_id",
           o."created_at"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
    JOIN (
        SELECT t2."user_id",
               MIN(t2."created_at") AS "first_created_at"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS t2
        WHERE t2."status" ILIKE '%Complete%'
          AND t2."returned_at" IS NULL
        GROUP BY t2."user_id"
    ) first_orders
      ON o."user_id"   = first_orders."user_id"
     AND o."created_at" = first_orders."first_created_at"
  ) f
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
    ON f."order_id" = oi."order_id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p
    ON oi."product_id" = p."id"
) result
GROUP BY result."category"
ORDER BY "num_customers" DESC
LIMIT 20;
```

```sql
--Description: 9) Identify the single category that attracts the most first-time customers. 
SELECT result."category",
       COUNT(DISTINCT result."user_id") AS "num_customers"
FROM (
  SELECT f."user_id",
         p."category"
  FROM (
    SELECT o."user_id",
           o."order_id",
           o."created_at"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
    JOIN (
        SELECT t2."user_id",
               MIN(t2."created_at") AS "first_created_at"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS t2
        WHERE t2."status" ILIKE '%Complete%'
          AND t2."returned_at" IS NULL
        GROUP BY t2."user_id"
    ) first_orders
      ON o."user_id"   = first_orders."user_id"
     AND o."created_at" = first_orders."first_created_at"
  ) f
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
    ON f."order_id" = oi."order_id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p
    ON oi."product_id" = p."id"
) result
GROUP BY result."category"
QUALIFY ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT result."user_id") DESC) = 1
LIMIT 20;
```

```sql
--Description: 10) Calculate total revenue (sum of sale_price) for that top category across all completed, non-returned items. 
SELECT p."category",
       SUM(oi."sale_price") AS "total_revenue"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS      o
  ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS    p
  ON oi."product_id" = p."id"
WHERE p."category" = (
  SELECT "category"
  FROM (
    SELECT result."category",
           COUNT(DISTINCT result."user_id") AS "num_customers"
    FROM (
      SELECT f."user_id",
             p2."category"
      FROM (
        SELECT o2."user_id",
               o2."order_id",
               o2."created_at"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o2
        JOIN (
            SELECT t2."user_id",
                   MIN(t2."created_at") AS "first_created_at"
            FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS t2
            WHERE t2."status" ILIKE '%Complete%'
              AND t2."returned_at" IS NULL
            GROUP BY t2."user_id"
        ) first_orders
          ON o2."user_id"   = first_orders."user_id"
         AND o2."created_at" = first_orders."first_created_at"
      ) f
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi2
        ON f."order_id" = oi2."order_id"
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p2
        ON oi2."product_id" = p2."id"
    ) result
    GROUP BY result."category"
    ORDER BY "num_customers" DESC
    LIMIT 1
  )
)
AND o."status"  ILIKE '%Complete%'
AND oi."status" ILIKE '%Complete%'
AND o."returned_at"  IS NULL
AND oi."returned_at" IS NULL
GROUP BY p."category"
LIMIT 20;
```
