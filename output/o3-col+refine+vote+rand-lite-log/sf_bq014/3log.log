Query:
--Description: For each user, pull the first non-cancelled & non-returned order and see which category it touches
SELECT fo."user_id",
       p."category",
       fo."sale_price"
FROM (
      SELECT o."user_id",
             oi."product_id",
             oi."sale_price",
             ROW_NUMBER() OVER (PARTITION BY o."user_id" ORDER BY o."created_at") AS rn
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"      o
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
           ON o."order_id" = oi."order_id"
      WHERE o."status" NOT ILIKE '%cancel%'
        AND oi."returned_at" IS NULL
     ) fo
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
     ON p."id" = fo."product_id"
WHERE rn = 1
LIMIT 20;
