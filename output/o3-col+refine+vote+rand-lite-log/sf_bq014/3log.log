Query:
--Description: Identify the single category with the MOST first-time customers
SELECT "category"
FROM (
      SELECT p."category",
             COUNT(DISTINCT o."user_id") AS "customer_count"
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"      o
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
           ON oi."order_id" = o."order_id"
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
           ON p."id"        = oi."product_id"
      WHERE o."status" NOT ILIKE '%cancel%'
        AND oi."returned_at" IS NULL
        AND o."created_at" = (
            SELECT MIN(o2."created_at")
            FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o2
            WHERE o2."user_id" = o."user_id"
              AND o2."status" NOT ILIKE '%cancel%'
           )
      GROUP BY p."category"
      ORDER BY "customer_count" DESC
      LIMIT 1
     )
LIMIT 20;
