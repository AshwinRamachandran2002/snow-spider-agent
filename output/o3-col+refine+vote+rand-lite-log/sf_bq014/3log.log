```sql
--Description: Sample of “good” orders (not cancelled and not returned) that will qualify for the first-purchase analysis
SELECT "order_id",
       "user_id",
       "status",
       "returned_at",
       "created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
WHERE "status" NOT ILIKE '%cancel%'
  AND "returned_at" IS NULL
LIMIT 20;
```

```sql
--Description: Look at line-items belonging to those good orders
SELECT oi."order_id",
       oi."user_id",
       oi."product_id",
       oi."sale_price",
       oi."status",
       o."created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"      oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"            o
     ON oi."order_id" = o."order_id"
WHERE o."status" NOT ILIKE '%cancel%'
  AND oi."returned_at" IS NULL
LIMIT 20;
```

```sql
--Description: Attach product information so we can see categories involved in those first orders
SELECT p."category",
       p."id"          AS "product_id",
       oi."sale_price"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"      oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"            o
     ON oi."order_id" = o."order_id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"          p
     ON p."id"        = oi."product_id"
WHERE o."status" NOT ILIKE '%cancel%'
  AND oi."returned_at" IS NULL
LIMIT 20;
```

```sql
--Description: For each user, pull the first non-cancelled & non-returned order and see which category it touches
SELECT fo."user_id",
       p."category",
       fo."sale_price"
FROM (
      SELECT o."user_id",
             oi."product_id",
             oi."sale_price",
             ROW_NUMBER() OVER (PARTITION BY o."user_id" ORDER BY o."created_at") AS rn
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"      o
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
           ON o."order_id" = oi."order_id"
      WHERE o."status" NOT ILIKE '%cancel%'
        AND oi."returned_at" IS NULL
     ) fo
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
     ON p."id" = fo."product_id"
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: Count how many unique customers have each category in their first qualifying order
SELECT p."category",
       COUNT(DISTINCT o."user_id") AS "customer_count"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"      o
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
     ON oi."order_id" = o."order_id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
     ON p."id"        = oi."product_id"
WHERE o."status" NOT ILIKE '%cancel%'
  AND oi."returned_at" IS NULL
  AND o."created_at" = (
      SELECT MIN(o2."created_at")
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o2
      WHERE o2."user_id" = o."user_id"
        AND o2."status" NOT ILIKE '%cancel%'
     )
GROUP BY p."category"
ORDER BY "customer_count" DESC
LIMIT 20;
```

```sql
--Description: Identify the single category with the MOST first-time customers
SELECT "category"
FROM (
      SELECT p."category",
             COUNT(DISTINCT o."user_id") AS "customer_count"
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"      o
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
           ON oi."order_id" = o."order_id"
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
           ON p."id"        = oi."product_id"
      WHERE o."status" NOT ILIKE '%cancel%'
        AND oi."returned_at" IS NULL
        AND o."created_at" = (
            SELECT MIN(o2."created_at")
            FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o2
            WHERE o2."user_id" = o."user_id"
              AND o2."status" NOT ILIKE '%cancel%'
           )
      GROUP BY p."category"
      ORDER BY "customer_count" DESC
      LIMIT 1
     )
LIMIT 20;
```

```sql
--Description: Show revenue of each category coming ONLY from those first, good orders
SELECT p."category",
       SUM(oi."sale_price") AS "revenue"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"      o
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
     ON oi."order_id" = o."order_id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
     ON p."id"        = oi."product_id"
WHERE o."status" NOT ILIKE '%cancel%'
  AND oi."returned_at" IS NULL
  AND o."created_at" = (
      SELECT MIN(o2."created_at")
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o2
      WHERE o2."user_id" = o."user_id"
        AND o2."status" NOT ILIKE '%cancel%'
     )
GROUP BY p."category"
ORDER BY "revenue" DESC
LIMIT 20;
```

```sql
--Description: Combine everything – compute the revenue ONLY for the category that wins the “most first-time customers” contest
WITH first_good_orders AS (
     SELECT o."order_id",
            o."user_id",
            o."created_at"
     FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
     WHERE o."status" NOT ILIKE '%cancel%'
       AND o."returned_at" IS NULL
     QUALIFY ROW_NUMBER() OVER (PARTITION BY o."user_id" ORDER BY o."created_at") = 1
), first_order_items AS (
     SELECT fgo."user_id",
            fgo."order_id",
            oi."product_id",
            oi."sale_price"
     FROM first_good_orders                         fgo
     JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
          ON oi."order_id" = fgo."order_id"
     WHERE oi."returned_at" IS NULL
), customer_category AS (
     SELECT foi."user_id",
            p."category",
            foi."sale_price"
     FROM first_order_items foi
     JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
          ON p."id" = foi."product_id"
), top_category AS (
     SELECT "category"
     FROM customer_category
     GROUP BY "category"
     ORDER BY COUNT(DISTINCT "user_id") DESC
     LIMIT 1
)
SELECT c."category",
       SUM(c."sale_price") AS "revenue"
FROM customer_category c
JOIN top_category        t
  ON c."category" = t."category"
GROUP BY c."category"
LIMIT 20;
```
