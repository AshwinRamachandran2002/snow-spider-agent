--Description: Combine everything – compute the revenue ONLY for the category that wins the “most first-time customers” contest
WITH first_good_orders AS (
     SELECT o."order_id",
            o."user_id",
            o."created_at"
     FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
     WHERE o."status" NOT ILIKE '%cancel%'
       AND o."returned_at" IS NULL
     QUALIFY ROW_NUMBER() OVER (PARTITION BY o."user_id" ORDER BY o."created_at") = 1
), first_order_items AS (
     SELECT fgo."user_id",
            fgo."order_id",
            oi."product_id",
            oi."sale_price"
     FROM first_good_orders                         fgo
     JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
          ON oi."order_id" = fgo."order_id"
     WHERE oi."returned_at" IS NULL
), customer_category AS (
     SELECT foi."user_id",
            p."category",
            foi."sale_price"
     FROM first_order_items foi
     JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
          ON p."id" = foi."product_id"
), top_category AS (
     SELECT "category"
     FROM customer_category
     GROUP BY "category"
     ORDER BY COUNT(DISTINCT "user_id") DESC
     LIMIT 1
)
SELECT c."category",
       SUM(c."sale_price") AS "revenue"
FROM customer_category c
JOIN top_category        t
  ON c."category" = t."category"
GROUP BY c."category"
LIMIT 20;
