Query:
-- Description: 7) Apply the “no negatives” rule (floor at zero)
--              to those running balances.
WITH daily_net AS (
    SELECT
        "customer_id",
        "txn_date",
        SUM(
            CASE
                WHEN "txn_type" = 'deposit' THEN 1
                ELSE -1
            END * "txn_amount"
        ) AS "net_change"
    FROM "customer_transactions"
    GROUP BY "customer_id", "txn_date"
),
running_bal AS (
    SELECT
        "customer_id",
        "txn_date",
        SUM("net_change") OVER (
            PARTITION BY "customer_id"
            ORDER BY "txn_date"
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS "balance_raw"
    FROM daily_net
)
SELECT DISTINCT
       "customer_id",
       "txn_date",
       CASE WHEN "balance_raw" < 0 THEN 0 ELSE "balance_raw" END AS "balance_capped"
FROM   running_bal
ORDER  BY "customer_id", "txn_date"
LIMIT 20;
