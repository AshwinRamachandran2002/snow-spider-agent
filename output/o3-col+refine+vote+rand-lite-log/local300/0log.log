Below are a series of exploratory SQL statements that progressively examine the data needed to solve the problem (≤ 10 independent queries, each limited to 20 rows).

```sql
-- Description: 1) View a sample of the distinct customer ids involved in any transaction.
SELECT DISTINCT "customer_id"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- Description: 2) Inspect the distinct kinds of transaction types that exist
--              (so we know which types should increase or decrease balances).
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- Description: 3) Check the range of transaction dates we are dealing with.
SELECT DISTINCT "txn_date"
FROM "customer_transactions"
ORDER BY "txn_date"
LIMIT 20;
```

```sql
-- Description: 4) For each customer, show their earliest and latest transaction date.
SELECT DISTINCT
       "customer_id",
       MIN("txn_date") AS "first_txn",
       MAX("txn_date") AS "last_txn"
FROM   "customer_transactions"
GROUP  BY "customer_id"
LIMIT 20;
```

```sql
-- Description: 5) Calculate each customer’s *net* movement per day
--              (deposit = +amount, anything else = –amount) as a base for balances.
WITH daily_net AS (
    SELECT
        "customer_id",
        "txn_date",
        SUM(
            CASE
                WHEN "txn_type" = 'deposit' THEN 1
                ELSE -1
            END * "txn_amount"
        ) AS "net_change"
    FROM "customer_transactions"
    GROUP BY "customer_id", "txn_date"
)
SELECT DISTINCT *
FROM daily_net
ORDER BY "customer_id", "txn_date"
LIMIT 20;
```

```sql
-- Description: 6) Derive a running balance per customer by cumulative-summing
--              the daily net movements.
WITH daily_net AS (
    SELECT
        "customer_id",
        "txn_date",
        SUM(
            CASE
                WHEN "txn_type" = 'deposit' THEN 1
                ELSE -1
            END * "txn_amount"
        ) AS "net_change"
    FROM "customer_transactions"
    GROUP BY "customer_id", "txn_date"
)
SELECT DISTINCT
       "customer_id",
       "txn_date",
       SUM("net_change") OVER (
           PARTITION BY "customer_id"
           ORDER BY "txn_date"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
       ) AS "running_balance"
FROM   daily_net
ORDER  BY "customer_id", "txn_date"
LIMIT 20;
```

```sql
-- Description: 7) Apply the “no negatives” rule (floor at zero)
--              to those running balances.
WITH daily_net AS (
    SELECT
        "customer_id",
        "txn_date",
        SUM(
            CASE
                WHEN "txn_type" = 'deposit' THEN 1
                ELSE -1
            END * "txn_amount"
        ) AS "net_change"
    FROM "customer_transactions"
    GROUP BY "customer_id", "txn_date"
),
running_bal AS (
    SELECT
        "customer_id",
        "txn_date",
        SUM("net_change") OVER (
            PARTITION BY "customer_id"
            ORDER BY "txn_date"
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS "balance_raw"
    FROM daily_net
)
SELECT DISTINCT
       "customer_id",
       "txn_date",
       CASE WHEN "balance_raw" < 0 THEN 0 ELSE "balance_raw" END AS "balance_capped"
FROM   running_bal
ORDER  BY "customer_id", "txn_date"
LIMIT 20;
```

```sql
-- Description: 8) For every month, find each customer’s maximum (peak) daily balance.
WITH daily_net AS (
    SELECT
        "customer_id",
        "txn_date",
        SUM(
            CASE
                WHEN "txn_type" = 'deposit' THEN 1
                ELSE -1
            END * "txn_amount"
        ) AS "net_change"
    FROM "customer_transactions"
    GROUP BY "customer_id", "txn_date"
),
running_bal AS (
    SELECT
        "customer_id",
        "txn_date",
        MAX(0, SUM("net_change") OVER (
            PARTITION BY "customer_id"
            ORDER BY "txn_date"
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        )) AS "daily_bal"
    FROM daily_net
),
month_peak AS (
    SELECT
        "customer_id",
        strftime('%Y-%m', "txn_date") AS "month",
        MAX("daily_bal")               AS "peak_bal_in_month"
    FROM running_bal
    GROUP BY "customer_id", "month"
)
SELECT DISTINCT *
FROM   month_peak
ORDER  BY "month", "customer_id"
LIMIT 20;
```

```sql
-- Description: 9) Finally, sum those customer-level month-peaks to get the total
--              peak balance held by *all* customers per month.
WITH daily_net AS (
    SELECT
        "customer_id",
        "txn_date",
        SUM(
            CASE
                WHEN "txn_type" = 'deposit' THEN 1
                ELSE -1
            END * "txn_amount"
        ) AS "net_change"
    FROM "customer_transactions"
    GROUP BY "customer_id", "txn_date"
),
running_bal AS (
    SELECT
        "customer_id",
        "txn_date",
        MAX(0, SUM("net_change") OVER (
            PARTITION BY "customer_id"
            ORDER BY "txn_date"
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        )) AS "daily_bal"
    FROM daily_net
),
month_peak AS (
    SELECT
        "customer_id",
        strftime('%Y-%m', "txn_date") AS "month",
        MAX("daily_bal")               AS "peak_bal_in_month"
    FROM running_bal
    GROUP BY "customer_id", "month"
)
SELECT DISTINCT
       "month",
       SUM("peak_bal_in_month") AS "total_peak_balance_all_customers"
FROM   month_peak
GROUP  BY "month"
ORDER  BY "month"
LIMIT 20;
```

These queries step from raw transactions through daily balances, enforce the “no negatives” rule, collect monthly peaks per customer, and aggregate those peaks for a final monthly total.
