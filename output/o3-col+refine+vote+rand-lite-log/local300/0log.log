-- Description: 9) Finally, sum those customer-level month-peaks to get the total
--              peak balance held by *all* customers per month.
WITH daily_net AS (
    SELECT
        "customer_id",
        "txn_date",
        SUM(
            CASE
                WHEN "txn_type" = 'deposit' THEN 1
                ELSE -1
            END * "txn_amount"
        ) AS "net_change"
    FROM "customer_transactions"
    GROUP BY "customer_id", "txn_date"
),
running_bal AS (
    SELECT
        "customer_id",
        "txn_date",
        MAX(0, SUM("net_change") OVER (
            PARTITION BY "customer_id"
            ORDER BY "txn_date"
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        )) AS "daily_bal"
    FROM daily_net
),
month_peak AS (
    SELECT
        "customer_id",
        strftime('%Y-%m', "txn_date") AS "month",
        MAX("daily_bal")               AS "peak_bal_in_month"
    FROM running_bal
    GROUP BY "customer_id", "month"
)
SELECT DISTINCT
       "month",
       SUM("peak_bal_in_month") AS "total_peak_balance_all_customers"
FROM   month_peak
GROUP  BY "month"
ORDER  BY "month"
LIMIT 20;
