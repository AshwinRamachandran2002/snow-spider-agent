-- Description: 5) Calculate each customer’s *net* movement per day
--              (deposit = +amount, anything else = –amount) as a base for balances.
WITH daily_net AS (
    SELECT
        "customer_id",
        "txn_date",
        SUM(
            CASE
                WHEN "txn_type" = 'deposit' THEN 1
                ELSE -1
            END * "txn_amount"
        ) AS "net_change"
    FROM "customer_transactions"
    GROUP BY "customer_id", "txn_date"
)
SELECT DISTINCT *
FROM daily_net
ORDER BY "customer_id", "txn_date"
LIMIT 20;
