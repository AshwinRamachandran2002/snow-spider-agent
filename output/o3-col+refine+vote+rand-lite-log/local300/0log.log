-- Description: 6) Derive a running balance per customer by cumulative-summing
--              the daily net movements.
WITH daily_net AS (
    SELECT
        "customer_id",
        "txn_date",
        SUM(
            CASE
                WHEN "txn_type" = 'deposit' THEN 1
                ELSE -1
            END * "txn_amount"
        ) AS "net_change"
    FROM "customer_transactions"
    GROUP BY "customer_id", "txn_date"
)
SELECT DISTINCT
       "customer_id",
       "txn_date",
       SUM("net_change") OVER (
           PARTITION BY "customer_id"
           ORDER BY "txn_date"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
       ) AS "running_balance"
FROM   daily_net
ORDER  BY "customer_id", "txn_date"
LIMIT 20;
