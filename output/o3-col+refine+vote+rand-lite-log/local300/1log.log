```sql
-- Description: Derive each customer’s net change per day (deposits +, everything else −)  
WITH daily_net AS (
    SELECT
        "customer_id",
        "txn_date",
        SUM(
            CASE 
                WHEN "txn_type" = 'deposit' THEN  "txn_amount"
                ELSE                       -1 * "txn_amount"
            END
        ) AS "net_change"
    FROM "customer_transactions"
    GROUP BY "customer_id", "txn_date"
)
SELECT *
FROM daily_net
ORDER BY "customer_id", "txn_date"
LIMIT 20;
```

```sql
-- Description: Find every customer’s first and last transaction dates (date-range boundaries)
SELECT 
    "customer_id",
    MIN("txn_date") AS "min_date",
    MAX("txn_date") AS "max_date"
FROM "customer_transactions"
GROUP BY "customer_id"
LIMIT 20;
```

```sql
-- Description: Build a per-customer calendar (one row per day) between their min & max dates
WITH date_bounds AS (
    SELECT 
        "customer_id",
        MIN("txn_date") AS "min_date",
        MAX("txn_date") AS "max_date"
    FROM "customer_transactions"
    GROUP BY "customer_id"
),
recursive_dates AS (
    SELECT 
        "customer_id",
        "min_date" AS "calendar_date",
        "max_date"
    FROM date_bounds
    UNION ALL
    SELECT
        "customer_id",
        DATE("calendar_date", '+1 day'),
        "max_date"
    FROM recursive_dates
    WHERE "calendar_date" < "max_date"
)
SELECT *
FROM recursive_dates
LIMIT 20;
```

```sql
-- Description: Combine the calendar with the net changes and construct a running balance
WITH date_bounds AS (
    SELECT 
        "customer_id",
        MIN("txn_date") AS "min_date",
        MAX("txn_date") AS "max_date"
    FROM "customer_transactions"
    GROUP BY "customer_id"
),
recursive_dates AS (
    SELECT 
        "customer_id",
        "min_date" AS "calendar_date",
        "max_date"
    FROM date_bounds
    UNION ALL
    SELECT
        "customer_id",
        DATE("calendar_date", '+1 day'),
        "max_date"
    FROM recursive_dates
    WHERE "calendar_date" < "max_date"
),
daily_net AS (
    SELECT
        "customer_id",
        "txn_date",
        SUM(
            CASE 
                WHEN "txn_type" = 'deposit' THEN  "txn_amount"
                ELSE                       -1 * "txn_amount"
            END
        ) AS "net_change"
    FROM "customer_transactions"
    GROUP BY "customer_id", "txn_date"
),
calendar_with_net AS (
    SELECT
        d."customer_id",
        d."calendar_date",
        COALESCE(n."net_change", 0) AS "net_change"
    FROM recursive_dates d
    LEFT JOIN daily_net n
      ON d."customer_id"   = n."customer_id"
     AND d."calendar_date" = n."txn_date"
),
running_balance AS (
    SELECT
        "customer_id",
        "calendar_date",
        MAX(0, SUM("net_change") OVER (
            PARTITION BY "customer_id"
            ORDER BY "calendar_date"
        )) AS "daily_balance"
    FROM calendar_with_net
)
SELECT *
FROM running_balance
ORDER BY "customer_id", "calendar_date"
LIMIT 20;
```

```sql
-- Description: Per customer & month, pick the maximum daily balance observed
WITH date_bounds AS (
    SELECT 
        "customer_id",
        MIN("txn_date") AS "min_date",
        MAX("txn_date") AS "max_date"
    FROM "customer_transactions"
    GROUP BY "customer_id"
),
recursive_dates AS (
    SELECT 
        "customer_id",
        "min_date" AS "calendar_date",
        "max_date"
    FROM date_bounds
    UNION ALL
    SELECT
        "customer_id",
        DATE("calendar_date", '+1 day'),
        "max_date"
    FROM recursive_dates
    WHERE "calendar_date" < "max_date"
),
daily_net AS (
    SELECT
        "customer_id",
        "txn_date",
        SUM(
            CASE 
                WHEN "txn_type" = 'deposit' THEN  "txn_amount"
                ELSE                       -1 * "txn_amount"
            END
        ) AS "net_change"
    FROM "customer_transactions"
    GROUP BY "customer_id", "txn_date"
),
calendar_with_net AS (
    SELECT
        d."customer_id",
        d."calendar_date",
        COALESCE(n."net_change", 0) AS "net_change"
    FROM recursive_dates d
    LEFT JOIN daily_net n
      ON d."customer_id"   = n."customer_id"
     AND d."calendar_date" = n."txn_date"
),
running_balance AS (
    SELECT
        "customer_id",
        "calendar_date",
        MAX(0, SUM("net_change") OVER (
            PARTITION BY "customer_id"
            ORDER BY "calendar_date"
        )) AS "daily_balance"
    FROM calendar_with_net
),
monthly_max AS (
    SELECT
        "customer_id",
        STRFTIME('%Y-%m', "calendar_date") AS "month",
        MAX("daily_balance")                AS "max_daily_balance"
    FROM running_balance
    GROUP BY "customer_id", "month"
)
SELECT *
FROM monthly_max
ORDER BY "month", "customer_id"
LIMIT 20;
```

```sql
-- Description: Finally, calculate the monthly total by summing each customer’s max daily balance for that month
WITH date_bounds AS (
    SELECT 
        "customer_id",
        MIN("txn_date") AS "min_date",
        MAX("txn_date") AS "max_date"
    FROM "customer_transactions"
    GROUP BY "customer_id"
),
recursive_dates AS (
    SELECT 
        "customer_id",
        "min_date" AS "calendar_date",
        "max_date"
    FROM date_bounds
    UNION ALL
    SELECT
        "customer_id",
        DATE("calendar_date", '+1 day'),
        "max_date"
    FROM recursive_dates
    WHERE "calendar_date" < "max_date"
),
daily_net AS (
    SELECT
        "customer_id",
        "txn_date",
        SUM(
            CASE 
                WHEN "txn_type" = 'deposit' THEN  "txn_amount"
                ELSE                       -1 * "txn_amount"
            END
        ) AS "net_change"
    FROM "customer_transactions"
    GROUP BY "customer_id", "txn_date"
),
calendar_with_net AS (
    SELECT
        d."customer_id",
        d."calendar_date",
        COALESCE(n."net_change", 0) AS "net_change"
    FROM recursive_dates d
    LEFT JOIN daily_net n
      ON d."customer_id"   = n."customer_id"
     AND d."calendar_date" = n."txn_date"
),
running_balance AS (
    SELECT
        "customer_id",
        "calendar_date",
        MAX(0, SUM("net_change") OVER (
            PARTITION BY "customer_id"
            ORDER BY "calendar_date"
        )) AS "daily_balance"
    FROM calendar_with_net
),
monthly_max AS (
    SELECT
        "customer_id",
        STRFTIME('%Y-%m', "calendar_date") AS "month",
        MAX("daily_balance")                AS "max_daily_balance"
    FROM running_balance
    GROUP BY "customer_id", "month"
)
SELECT
    "month",
    SUM("max_daily_balance") AS "monthly_total_max_balance"
FROM monthly_max
GROUP BY "month"
ORDER BY "month"
LIMIT 20;
```
