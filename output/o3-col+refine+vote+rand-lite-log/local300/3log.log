```sql
-- Description: 3) Aggregate each customer’s net cash-flow per calendar day (+deposit, –other)
SELECT DISTINCT
       ct."customer_id",
       date(ct."txn_date")     AS "txn_day",
       SUM(CASE WHEN ct."txn_type"='deposit' THEN  ct."txn_amount"
                ELSE                            -ct."txn_amount" END) AS "net_amount"
FROM   "customer_transactions" AS ct
GROUP  BY ct."customer_id", date(ct."txn_date")
ORDER  BY ct."customer_id", "txn_day"
LIMIT 20;
```

```sql
-- Description: 4) For one sample customer, expand every day between min and max dates and carry forward balance (negatives ⇒ 0)
WITH RECURSIVE
    c AS (SELECT DISTINCT "customer_id" FROM "customer_transactions" LIMIT 1),          -- pick one customer
    d AS (SELECT MIN(date("txn_date")) AS min_day,
                 MAX(date("txn_date")) AS max_day,
                 "customer_id"
          FROM   "customer_transactions"
          WHERE  "customer_id" = (SELECT "customer_id" FROM c)
         ),
    calendar(day, customer_id) AS (
          SELECT min_day, customer_id FROM d
          UNION ALL
          SELECT date(day,'+1 day'), customer_id
          FROM   calendar, d
          WHERE  day < d.max_day
     ),
    daily_net AS (
          SELECT date("txn_date") AS txn_day,
                 "customer_id",
                 SUM(CASE WHEN "txn_type"='deposit' THEN  "txn_amount"
                          ELSE                             - "txn_amount" END) AS net_amt
          FROM   "customer_transactions"
          WHERE  "customer_id" = (SELECT "customer_id" FROM c)
          GROUP  BY 1,2
     ),
     balances AS (
          SELECT calendar.day,
                 calendar.customer_id,
                 MAX(0, COALESCE(daily_net.net_amt,0)) AS net_amt          -- first day balance
          FROM   calendar
          LEFT JOIN daily_net
                 ON  calendar.day = daily_net.txn_day
          WHERE  calendar.day = (SELECT min_day FROM d)
          UNION ALL
          SELECT cal.day,
                 cal.customer_id,
                 MAX(0,
                     bal.net_amt + COALESCE(dn.net_amt,0))                -- carry forward + today
          FROM   balances AS bal
          JOIN   calendar  AS cal  ON cal.day = date(bal.day,'+1 day')
          LEFT  JOIN daily_net AS dn ON dn.txn_day = cal.day
     )
SELECT *
FROM   balances
ORDER  BY day
LIMIT 20;
```

```sql
-- Description: 5) From the previous step, find that customer’s maximum end-of-day balance in each month
WITH RECURSIVE
    daily_balances AS (   -- reuse logic from query 4 but without LIMIT 1 on customer later
        SELECT "customer_id",
               date("txn_date") AS txn_day,
               SUM(CASE WHEN "txn_type"='deposit' THEN  "txn_amount"
                        ELSE                             - "txn_amount" END) AS net_amt
        FROM   "customer_transactions"
        GROUP  BY 1,2
    ),
    frame AS (
        SELECT
               db."customer_id",
               db."txn_day",
               (SELECT SUM(net_amt)
                FROM   daily_balances AS db2
                WHERE  db2."customer_id" = db."customer_id"
                AND    db2."txn_day" <= db."txn_day") AS running_bal
        FROM   daily_balances AS db
    )
SELECT DISTINCT
       "customer_id",
       strftime('%Y-%m', "txn_day") AS "month",
       MAX(CASE WHEN running_bal<0 THEN 0 ELSE running_bal END) AS "max_daily_balance"
FROM   frame
GROUP  BY "customer_id", "month"
LIMIT 20;
```

```sql
-- Description: 6) Compute every customer’s maximum daily balance per month (all customers, capped at 20 rows)
WITH daily_net AS (
      SELECT "customer_id",
             date("txn_date") AS txn_day,
             SUM(CASE WHEN "txn_type"='deposit' THEN  "txn_amount"
                      ELSE                             - "txn_amount" END) AS net_amt
      FROM   "customer_transactions"
      GROUP  BY 1,2
),
running AS (
      SELECT dn1."customer_id",
             dn1."txn_day",
             (SELECT SUM(net_amt)
              FROM   daily_net AS dn2
              WHERE  dn2."customer_id" = dn1."customer_id"
              AND    dn2."txn_day" <= dn1."txn_day") AS bal
      FROM   daily_net AS dn1
),
monthly_max AS (
      SELECT "customer_id",
             strftime('%Y-%m', "txn_day") AS month,
             MAX(CASE WHEN bal<0 THEN 0 ELSE bal END) AS max_daily_bal
      FROM   running
      GROUP  BY 1,2
)
SELECT *
FROM   monthly_max
ORDER  BY "month", "customer_id"
LIMIT 20;
```

```sql
-- Description: 7) Sum the monthly maximum daily balances across all customers to obtain the final monthly totals
WITH daily_net AS (
      SELECT "customer_id",
             date("txn_date") AS txn_day,
             SUM(CASE WHEN "txn_type"='deposit' THEN  "txn_amount"
                      ELSE                             - "txn_amount" END) AS net_amt
      FROM   "customer_transactions"
      GROUP  BY 1,2
),
running AS (
      SELECT dn1."customer_id",
             dn1."txn_day",
             (SELECT SUM(net_amt)
              FROM   daily_net AS dn2
              WHERE  dn2."customer_id" = dn1."customer_id"
              AND    dn2."txn_day" <= dn1."txn_day") AS bal
      FROM   daily_net AS dn1
),
monthly_max AS (
      SELECT "customer_id",
             strftime('%Y-%m', "txn_day") AS month,
             MAX(CASE WHEN bal<0 THEN 0 ELSE bal END) AS max_daily_bal
      FROM   running
      GROUP  BY 1,2
)
SELECT DISTINCT
       month,
       SUM(max_daily_bal) AS total_monthly_max_balances
FROM   monthly_max
GROUP  BY month
ORDER  BY month
LIMIT 20;
```

```sql
-- Description: 8) Inspect final monthly totals together with customer count contributing to each month
WITH daily_net AS (
      SELECT "customer_id",
             date("txn_date") AS txn_day,
             SUM(CASE WHEN "txn_type"='deposit' THEN  "txn_amount"
                      ELSE                             - "txn_amount" END) AS net_amt
      FROM   "customer_transactions"
      GROUP  BY 1,2
),
running AS (
      SELECT dn1."customer_id",
             dn1."txn_day",
             (SELECT SUM(net_amt)
              FROM   daily_net AS dn2
              WHERE  dn2."customer_id" = dn1."customer_id"
              AND    dn2."txn_day" <= dn1."txn_day") AS bal
      FROM   daily_net AS dn1
),
monthly_max AS (
      SELECT "customer_id",
             strftime('%Y-%m', "txn_day") AS month,
             MAX(CASE WHEN bal<0 THEN 0 ELSE bal END) AS max_daily_bal
      FROM   running
      GROUP  BY 1,2
)
SELECT DISTINCT
       month,
       COUNT("customer_id")            AS customers_in_month,
       SUM(max_daily_bal)              AS total_monthly_max_balances
FROM   monthly_max
GROUP  BY month
ORDER  BY month
LIMIT 20;
```

