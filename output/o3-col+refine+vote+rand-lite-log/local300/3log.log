```sql
--Description:
-- SINGLE-QUERY SOLUTION (thinking steps embedded as comments)
-- 1) customer_span   : earliest and latest transaction date per customer.
-- 2) calendar        : build every calendar day for each customer between those dates.
-- 3) daily_net       : net cash-flow on a day (+deposit, –withdrawal/purchase).
-- 4) daily_balances  : running end-of-day balance (carry forward, never below 0).
-- 5) monthly_max     : highest daily balance each customer achieves in each month.
-- 6) final output    : sum the customer-month maxima to produce monthly totals.
WITH RECURSIVE
/* 1 ──────────────────────────────────────────────────────────────────────── */
customer_span AS (
    SELECT customer_id,
           MIN(date(txn_date)) AS start_date,
           MAX(date(txn_date)) AS end_date
    FROM   customer_transactions
    GROUP  BY customer_id
),
/* 2 ──────────────────────────────────────────────────────────────────────── */
calendar AS (
    SELECT customer_id, start_date AS day
    FROM   customer_span
    UNION ALL
    SELECT calendar.customer_id,
           date(calendar.day,'+1 day')
    FROM   calendar
    JOIN   customer_span USING (customer_id)
    WHERE  calendar.day < customer_span.end_date
),
/* 3 ──────────────────────────────────────────────────────────────────────── */
daily_net AS (
    SELECT customer_id,
           date(txn_date) AS day,
           SUM(CASE WHEN txn_type='deposit'
                    THEN  txn_amount
                    ELSE -txn_amount END) AS net_change
    FROM   customer_transactions
    GROUP  BY customer_id, day
),
/* 4 ──────────────────────────────────────────────────────────────────────── */
daily_balances AS (
    -- seed row: first day for every customer
    SELECT cal.customer_id,
           cal.day,
           MAX(0, COALESCE(dn.net_change,0)) AS balance
    FROM   calendar AS cal
    LEFT   JOIN daily_net AS dn
           ON  dn.customer_id = cal.customer_id
          AND dn.day        = cal.day
    JOIN   customer_span AS cs
           ON  cs.customer_id = cal.customer_id
          AND cal.day        = cs.start_date
    UNION ALL
    -- recursive step: advance one day, carry balance forward, add today’s net_change
    SELECT cal.customer_id,
           cal.day,
           MAX(0, db.balance + COALESCE(dn.net_change,0)) AS balance
    FROM   daily_balances AS db
    JOIN   calendar       AS cal
           ON  cal.customer_id = db.customer_id
          AND cal.day        = date(db.day,'+1 day')
    LEFT   JOIN daily_net  AS dn
           ON  dn.customer_id = cal.customer_id
          AND dn.day        = cal.day
),
/* 5 ──────────────────────────────────────────────────────────────────────── */
monthly_max AS (
    SELECT customer_id,
           strftime('%Y-%m', day) AS month,
           MAX(balance)          AS max_daily_balance
    FROM   daily_balances
    GROUP  BY customer_id, month
)
/* 6 ──────────────────────────────────────────────────────────────────────── */
SELECT month,
       SUM(max_daily_balance) AS total_monthly_max_balance
FROM   monthly_max
GROUP  BY month
ORDER  BY month;
```
