--Description: Quick verification that the CUMULATIVE balance (before any “floor-to-zero” logic)
--             does in fact go negative for some customers/days.
--             Steps:
--             1. net      – aggregate deposits (+) and withdrawals/purchases (–) per customer-day.
--             2. running  – compute running total by customer (no MAX(0) applied).
--             3. Final    – return the first 20 rows where the balance dropped below zero
--                           to prove negative states exist prior to flooring.
WITH net AS (
    SELECT "customer_id",
           date("txn_date") AS day,
           SUM(CASE WHEN "txn_type" = 'deposit'
                    THEN  1
                    ELSE -1 END * "txn_amount") AS change
