```sql
-- 6) Produce an expanded calendar for ONE sample customer (id = 1)
WITH bounds AS (
  SELECT MIN(date("txn_date")) AS "start_date",
         MAX(date("txn_date")) AS "end_date"
  FROM   "customer_transactions"
  WHERE  "customer_id" = 1
), RECURSIVE calendar(day) AS (
  SELECT "start_date" FROM bounds
  UNION ALL
  SELECT date(day,'+1 day')
  FROM   calendar, bounds
  WHERE  day < "end_date"
)
SELECT *
