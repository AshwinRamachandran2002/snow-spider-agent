-- 5) Rolling (cumulative) balance per customer ignoring non-transaction days
WITH net AS (
  SELECT "customer_id",
         "txn_date",
         SUM(CASE WHEN "txn_type"='deposit' THEN  1
                  ELSE                              -1 END
             * "txn_amount") AS "net_daily_change"
  FROM   "customer_transactions"
  GROUP  BY "customer_id","txn_date"
)
SELECT "customer_id",
       "txn_date",
       SUM("net_daily_change") OVER (
           PARTITION BY "customer_id"
           ORDER BY date("txn_date")
       ) AS "running_balance"
FROM   net
ORDER BY "customer_id","txn_date"
LIMIT 20;
