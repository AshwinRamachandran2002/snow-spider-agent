           SUM(change) OVER (
               PARTITION BY "customer_id"
               ORDER BY day
           ) AS running_balance
    FROM   net
)
SELECT *
FROM   running
WHERE  running_balance < 0
ORDER  BY "customer_id", day
LIMIT 20;
