Query:
--Description: Monthly maximum daily balance for each customer
WITH RECURSIVE
  bounds AS (
      SELECT "customer_id",
             MIN(date("txn_date")) AS start_date,
             MAX(date("txn_date")) AS end_date
      FROM   "customer_transactions"
      GROUP  BY "customer_id"
  ),
  calendar AS (
      SELECT "customer_id", start_date AS day, end_date
      FROM   bounds
      UNION ALL
      SELECT "customer_id", date(day,'+1 day'), end_date
      FROM   calendar
      WHERE  day < end_date
  ),
  net AS (
      SELECT "customer_id",
             date("txn_date") AS day,
             SUM(CASE WHEN "txn_type" = 'deposit' 
                      THEN  1 
                      ELSE -1 END * "txn_amount") AS change
      FROM   "customer_transactions"
      GROUP  BY "customer_id", day
  ),
  daily AS (
      SELECT c."customer_id",
             c.day,
             COALESCE(n.change,0) AS change
      FROM   calendar c
      LEFT   JOIN net n
             ON  n."customer_id" = c."customer_id"
             AND n.day           = c.day
  ),
  running AS (
      SELECT "customer_id",
             day,
             MAX(0, SUM(change) OVER (
                         PARTITION BY "customer_id"
                         ORDER BY day
                   )) AS daily_balance
      FROM   daily
  )
SELECT "customer_id",
       strftime('%Y-%m', day) AS month,
       MAX(daily_balance)     AS max_balance_in_month
FROM   running
GROUP  BY "customer_id", month
ORDER  BY month, "customer_id"
LIMIT 20
