                       WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"  
                       ELSE 0 END)  
                  OVER (PARTITION BY "customer_id" ORDER BY "txn_date" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)  
                  AS "running_balance"  
