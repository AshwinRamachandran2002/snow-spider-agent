```

```sql
--Description: 2. Inspect the different kinds of transaction types recorded (e.g. deposit / withdrawal)  
SELECT DISTINCT "txn_type"  
FROM "customer_transactions"  
LIMIT 20;  
```

```sql
--Description: 3. Find the earliest and latest transaction dates in the data set  
SELECT MIN("txn_date")  AS "earliest_date",  
       MAX("txn_date")  AS "latest_date"  
FROM   "customer_transactions";  
```

```sql
--Description: 4. Pull the first 20 transactions (chronological order) to understand the raw date and amount formats  
SELECT "customer_id", "txn_date", "txn_type", "txn_amount"  
FROM   "customer_transactions"  
ORDER  BY "txn_date" ASC  
LIMIT 20;  
```

```sql
--Description: 5. See which customers have the highest number of transactions (top-20 by count)  
SELECT "customer_id", COUNT(*) AS "txn_cnt"  
FROM   "customer_transactions"  
GROUP  BY "customer_id"  
ORDER  BY "txn_cnt" DESC  
LIMIT 20;  
```

```sql
--Description: 6. Compute each customer’s overall net balance (deposits – withdrawals) to check the sign of balances  
SELECT "customer_id",  
       SUM(CASE WHEN "txn_type" = 'deposit'   THEN  "txn_amount"  
                WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"  
                ELSE 0 END) AS "net_balance"  
FROM   "customer_transactions"  
GROUP  BY "customer_id"  
LIMIT 20;  
```

```sql
--Description: 7. Inspect a customer’s day-by-day net movement (choose the first customer in the data set)  
SELECT t1."txn_date",  
       SUM(CASE WHEN t1."txn_type" = 'deposit'   THEN  t1."txn_amount"  
                WHEN t1."txn_type" = 'withdrawal' THEN - t1."txn_amount"  
                ELSE 0 END) AS "daily_net"  
FROM   "customer_transactions" AS t1  
WHERE  t1."customer_id" = (SELECT MIN("customer_id") FROM "customer_transactions")  
GROUP  BY t1."txn_date"  
ORDER  BY t1."txn_date"  
LIMIT 20;  
```

```sql
--Description: 8. List distinct years-months that exist in the transaction table (helps when grouping by month later)  
SELECT DISTINCT SUBSTR("txn_date", 1, 7) AS "year_month"  
FROM   "customer_transactions"  
ORDER  BY "year_month"  
LIMIT 20;  
```

```sql
--Description: 9. Get the daily running balance for a single customer (first customer) using a window sum  
SELECT "customer_id",  
       "txn_date",  
       SUM(CASE WHEN "txn_type" = 'deposit'   THEN  "txn_amount"  
                WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"  
                ELSE 0 END)  
           OVER (PARTITION BY "customer_id" ORDER BY "txn_date" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)  
           AS "running_balance"  
FROM   "customer_transactions"  
WHERE  "customer_id" = (SELECT MIN("customer_id") FROM "customer_transactions")  
ORDER  BY "txn_date"  
LIMIT 20;  
```

```sql
--Description: 10. Preview how to capture each customer’s maximum daily balance per month (illustrative on first customer)  
SELECT SUBSTR("txn_date", 1, 7)                          AS "year_month",  
       MAX("running_balance")                            AS "max_daily_balance"  
FROM (  
       SELECT "customer_id",  
              "txn_date",  
              SUM(CASE WHEN "txn_type" = 'deposit'   THEN  "txn_amount"  
                       WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"  
                       ELSE 0 END)  
                  OVER (PARTITION BY "customer_id" ORDER BY "txn_date" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)  
                  AS "running_balance"  
       FROM   "customer_transactions"  
       WHERE  "customer_id" = (SELECT MIN("customer_id") FROM "customer_transactions")  
     )  
GROUP BY "year_month"  
ORDER BY "year_month"  
LIMIT 20;  
```
