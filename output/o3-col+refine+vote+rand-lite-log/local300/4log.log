Query:
-- Description: Join the calendar to the raw transactions so we can see the net
-- change (positive for deposits, negative for withdrawals) on each day
WITH daily_change AS (
    SELECT customer_id,
           txn_date,
           SUM(CASE WHEN txn_type='deposit'   THEN  txn_amount
                    WHEN txn_type='withdrawal'THEN -txn_amount
                    ELSE 0 END) AS net_change
    FROM customer_transactions
    GROUP BY customer_id, txn_date
)
SELECT d.customer_id,
       d.cal_date,
       COALESCE(dc.net_change,0) AS net_change
FROM (
    /* calendar built earlier */
    WITH spans AS (
        SELECT customer_id,
               MIN(txn_date) AS start_date,
               MAX(txn_date) AS end_date
        FROM customer_transactions
        GROUP BY customer_id
    )
    , dates (customer_id, cal_date) AS (
        SELECT customer_id, start_date
        FROM spans
        UNION ALL
        SELECT customer_id,
               DATE(cal_date,'+1 day')
        FROM dates
        JOIN spans  USING (customer_id)
        WHERE DATE(cal_date,'+1 day') <= spans.end_date
    )
    SELECT * FROM dates
