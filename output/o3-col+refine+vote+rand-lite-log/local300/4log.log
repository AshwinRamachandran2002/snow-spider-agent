Query:
-- Description: Produce a per-customer calendar of every date between their first and last transaction
WITH spans AS (
    SELECT customer_id,
           MIN(txn_date) AS start_date,
           MAX(txn_date) AS end_date
    FROM customer_transactions
    GROUP BY customer_id
)
, dates (customer_id, cal_date) AS (
    SELECT customer_id, start_date
    FROM spans
    UNION ALL
    SELECT customer_id,
           DATE(cal_date,'+1 day')
    FROM dates
    JOIN spans  USING (customer_id)
    WHERE DATE(cal_date,'+1 day') <= spans.end_date
)
SELECT customer_id, cal_date
FROM dates
LIMIT 20;
