```sql
-- Description: Take a quick look at a handful of raw rows in the transactions table
SELECT *
FROM customer_transactions
LIMIT 20;
```

```sql
-- Description: Check all transaction types that exist (e.g., deposits vs withdrawals)
SELECT DISTINCT txn_type
FROM customer_transactions;
```

```sql
-- Description: For every customer, find the first and last calendar date we will need to cover
SELECT customer_id,
       MIN(txn_date) AS first_txn_date,
       MAX(txn_date) AS last_txn_date
FROM customer_transactions
GROUP BY customer_id
LIMIT 20;
```

```sql
-- Description: Produce a per-customer calendar of every date between their first and last transaction
WITH spans AS (
    SELECT customer_id,
           MIN(txn_date) AS start_date,
           MAX(txn_date) AS end_date
    FROM customer_transactions
    GROUP BY customer_id
)
, dates (customer_id, cal_date) AS (
    SELECT customer_id, start_date
    FROM spans
    UNION ALL
    SELECT customer_id,
           DATE(cal_date,'+1 day')
    FROM dates
    JOIN spans  USING (customer_id)
    WHERE DATE(cal_date,'+1 day') <= spans.end_date
)
SELECT customer_id, cal_date
FROM dates
LIMIT 20;
```

```sql
-- Description: Join the calendar to the raw transactions so we can see the net
-- change (positive for deposits, negative for withdrawals) on each day
WITH daily_change AS (
    SELECT customer_id,
           txn_date,
           SUM(CASE WHEN txn_type='deposit'   THEN  txn_amount
                    WHEN txn_type='withdrawal'THEN -txn_amount
                    ELSE 0 END) AS net_change
    FROM customer_transactions
    GROUP BY customer_id, txn_date
)
SELECT d.customer_id,
       d.cal_date,
       COALESCE(dc.net_change,0) AS net_change
FROM (
    /* calendar built earlier */
    WITH spans AS (
        SELECT customer_id,
               MIN(txn_date) AS start_date,
               MAX(txn_date) AS end_date
        FROM customer_transactions
        GROUP BY customer_id
    )
    , dates (customer_id, cal_date) AS (
        SELECT customer_id, start_date
        FROM spans
        UNION ALL
        SELECT customer_id,
               DATE(cal_date,'+1 day')
        FROM dates
        JOIN spans  USING (customer_id)
        WHERE DATE(cal_date,'+1 day') <= spans.end_date
    )
    SELECT * FROM dates
) AS d
LEFT JOIN daily_change dc
       ON dc.customer_id = d.customer_id
      AND dc.txn_date   = d.cal_date
LIMIT 20;
```

```sql
-- Description: Calculate running balance per customer, turning negative balances to zero
WITH daily_change AS (
    SELECT customer_id,
           txn_date,
           SUM(CASE WHEN txn_type='deposit'   THEN  txn_amount
                    WHEN txn_type='withdrawal'THEN -txn_amount
                    ELSE 0 END) AS net_change
    FROM customer_transactions
    GROUP BY customer_id, txn_date
)
, calendar AS (
    WITH spans AS (
        SELECT customer_id,
               MIN(txn_date) AS start_date,
               MAX(txn_date) AS end_date
        FROM customer_transactions
        GROUP BY customer_id
    )
    , dates (customer_id, cal_date) AS (
        SELECT customer_id, start_date
        FROM spans
        UNION ALL
        SELECT customer_id,
               DATE(cal_date,'+1 day')
        FROM dates
        JOIN spans  USING (customer_id)
        WHERE DATE(cal_date,'+1 day') <= spans.end_date
    )
    SELECT * FROM dates
)
SELECT c.customer_id,
       c.cal_date,
       MAX(0,
           SUM(COALESCE(dc.net_change,0))
           OVER (PARTITION BY c.customer_id
                 ORDER BY c.cal_date
                 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
       ) AS daily_balance
FROM calendar c
LEFT JOIN daily_change dc
       ON dc.customer_id = c.customer_id
      AND dc.txn_date   = c.cal_date
LIMIT 20;
```

```sql
-- Description: For every customer & month, capture the single highest balance
WITH daily_balances AS (
    /* query from previous step */
    WITH daily_change AS (
        SELECT customer_id,
               txn_date,
               SUM(CASE WHEN txn_type='deposit'   THEN  txn_amount
                        WHEN txn_type='withdrawal'THEN -txn_amount
                        ELSE 0 END) AS net_change
        FROM customer_transactions
        GROUP BY customer_id, txn_date
    )
    , calendar AS (
        WITH spans AS (
            SELECT customer_id,
                   MIN(txn_date) AS start_date,
                   MAX(txn_date) AS end_date
            FROM customer_transactions
            GROUP BY customer_id
        )
        , dates (customer_id, cal_date) AS (
            SELECT customer_id, start_date
            FROM spans
            UNION ALL
            SELECT customer_id,
                   DATE(cal_date,'+1 day')
            FROM dates
            JOIN spans  USING (customer_id)
            WHERE DATE(cal_date,'+1 day') <= spans.end_date
        )
        SELECT * FROM dates
    )
    SELECT c.customer_id,
           c.cal_date,
           MAX(0,
               SUM(COALESCE(dc.net_change,0))
               OVER (PARTITION BY c.customer_id
                     ORDER BY c.cal_date
                     ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
           ) AS daily_balance
    FROM calendar c
    LEFT JOIN daily_change dc
           ON dc.customer_id = c.customer_id
          AND dc.txn_date   = c.cal_date
)
SELECT customer_id,
       STRFTIME('%Y-%m', cal_date) AS year_month,
       MAX(daily_balance)          AS max_daily_balance_in_month
FROM daily_balances
GROUP BY customer_id, year_month
LIMIT 20;
```

```sql
-- Description: Aggregate the customer-level monthly peaks into the required
-- “total of monthly maximums” figure
WITH daily_balances AS (
    /* same CTE as earlier for daily running balances */
    WITH daily_change AS (
        SELECT customer_id,
               txn_date,
               SUM(CASE WHEN txn_type='deposit'   THEN  txn_amount
                        WHEN txn_type='withdrawal'THEN -txn_amount
                        ELSE 0 END) AS net_change
        FROM customer_transactions
        GROUP BY customer_id, txn_date
    )
    , calendar AS (
        WITH spans AS (
            SELECT customer_id,
                   MIN(txn_date) AS start_date,
                   MAX(txn_date) AS end_date
            FROM customer_transactions
            GROUP BY customer_id
        )
        , dates (customer_id, cal_date) AS (
            SELECT customer_id, start_date
            FROM spans
            UNION ALL
            SELECT customer_id,
                   DATE(cal_date,'+1 day')
            FROM dates
            JOIN spans  USING (customer_id)
            WHERE DATE(cal_date,'+1 day') <= spans.end_date
        )
        SELECT * FROM dates
    )
    SELECT c.customer_id,
           c.cal_date,
           MAX(0,
               SUM(COALESCE(dc.net_change,0))
               OVER (PARTITION BY c.customer_id
                     ORDER BY c.cal_date
                     ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
           ) AS daily_balance
    FROM calendar c
    LEFT JOIN daily_change dc
           ON dc.customer_id = c.customer_id
          AND dc.txn_date   = c.cal_date
)
, customer_month_peaks AS (
    SELECT customer_id,
           STRFTIME('%Y-%m', cal_date) AS year_month,
           MAX(daily_balance)          AS max_daily_balance_in_month
    FROM daily_balances
    GROUP BY customer_id, year_month
)
SELECT year_month,
       SUM(max_daily_balance_in_month) AS monthly_total_max_balances
FROM customer_month_peaks
GROUP BY year_month
ORDER BY year_month
LIMIT 20;
```

```sql
-- Description: (Optional) Show the very first few months to verify the numbers look sensible
SELECT *
FROM (
      /* previous query */
      WITH daily_balances AS (
          WITH daily_change AS (
              SELECT customer_id,
                     txn_date,
                     SUM(CASE WHEN txn_type='deposit'   THEN  txn_amount
                              WHEN txn_type='withdrawal'THEN -txn_amount
                              ELSE 0 END) AS net_change
              FROM customer_transactions
              GROUP BY customer_id, txn_date
          )
          , calendar AS (
              WITH spans AS (
                  SELECT customer_id,
                         MIN(txn_date) AS start_date,
                         MAX(txn_date) AS end_date
                  FROM customer_transactions
                  GROUP BY customer_id
              )
              , dates (customer_id, cal_date) AS (
                  SELECT customer_id, start_date
                  FROM spans
                  UNION ALL
                  SELECT customer_id,
                         DATE(cal_date,'+1 day')
                  FROM dates
                  JOIN spans  USING (customer_id)
                  WHERE DATE(cal_date,'+1 day') <= spans.end_date
              )
              SELECT * FROM dates
          )
          SELECT c.customer_id,
                 c.cal_date,
                 MAX(0,
                     SUM(COALESCE(dc.net_change,0))
                     OVER (PARTITION BY c.customer_id
                           ORDER BY c.cal_date
                           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
                 ) AS daily_balance
          FROM calendar c
          LEFT JOIN daily_change dc
                 ON dc.customer_id = c.customer_id
                AND dc.txn_date   = c.cal_date
      )
      , customer_month_peaks AS (
          SELECT customer_id,
                 STRFTIME('%Y-%m', cal_date) AS year_month,
                 MAX(daily_balance)          AS max_daily_balance_in_month
          FROM daily_balances
          GROUP BY customer_id, year_month
      )
      SELECT year_month,
             SUM(max_daily_balance_in_month) AS monthly_total_max_balances
      FROM customer_month_peaks
      GROUP BY year_month
      ORDER BY year_month
     )
LIMIT 20;
```

These eight queries (the last one is purely to display the first few rows) walk from basic inspection all the way to the requested monthly total of the customers’ highest daily balances.
