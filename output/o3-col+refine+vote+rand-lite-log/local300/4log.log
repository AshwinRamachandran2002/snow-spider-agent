-- Description: For every customer & month, capture the single highest balance
WITH daily_balances AS (
    /* query from previous step */
    WITH daily_change AS (
        SELECT customer_id,
               txn_date,
               SUM(CASE WHEN txn_type='deposit'   THEN  txn_amount
                        WHEN txn_type='withdrawal'THEN -txn_amount
                        ELSE 0 END) AS net_change
        FROM customer_transactions
        GROUP BY customer_id, txn_date
    )
    , calendar AS (
        WITH spans AS (
            SELECT customer_id,
                   MIN(txn_date) AS start_date,
                   MAX(txn_date) AS end_date
            FROM customer_transactions
            GROUP BY customer_id
        )
        , dates (customer_id, cal_date) AS (
            SELECT customer_id, start_date
            FROM spans
            UNION ALL
            SELECT customer_id,
                   DATE(cal_date,'+1 day')
            FROM dates
            JOIN spans  USING (customer_id)
            WHERE DATE(cal_date,'+1 day') <= spans.end_date
        )
        SELECT * FROM dates
    )
    SELECT c.customer_id,
           c.cal_date,
           MAX(0,
               SUM(COALESCE(dc.net_change,0))
               OVER (PARTITION BY c.customer_id
                     ORDER BY c.cal_date
                     ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
           ) AS daily_balance
    FROM calendar c
    LEFT JOIN daily_change dc
           ON dc.customer_id = c.customer_id
          AND dc.txn_date   = c.cal_date
)
SELECT customer_id,
       STRFTIME('%Y-%m', cal_date) AS year_month,
       MAX(daily_balance)          AS max_daily_balance_in_month
FROM daily_balances
GROUP BY customer_id, year_month
LIMIT 20;
