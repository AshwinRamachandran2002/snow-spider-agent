--Description: Query 9 – determine every customer’s highest daily balance in each month.
-- Steps mirror the corrected query 8 but finish with MAX() per customer-month.
WITH RECURSIVE
bounds AS (                                      -- first & last txn date per customer
    SELECT customer_id,
           MIN(DATE(txn_date)) AS min_d,
           MAX(DATE(txn_date)) AS max_d
    FROM   customer_transactions
    GROUP  BY customer_id
),
cal(customer_id, cal_date, max_d) AS (           -- full daily calendar
    SELECT customer_id, min_d, max_d
    FROM   bounds
    UNION ALL
    SELECT customer_id,
           DATE(cal_date,'+1 day'),
           max_d
    FROM   cal
    WHERE  cal_date < max_d
),
daily AS (                                       -- net movement per day
    SELECT customer_id,
           DATE(txn_date) AS txn_date,
           SUM(CASE WHEN txn_type='deposit'
                    THEN  txn_amount
                    ELSE -txn_amount END) AS net_amt
    FROM   customer_transactions
    GROUP  BY customer_id, DATE(txn_date)
),
running AS (                                     -- cumulative balance ≥ 0
    SELECT customer_id,
           txn_date,
           MAX(0,
               SUM(net_amt) OVER (
                   PARTITION BY customer_id
                   ORDER BY txn_date
                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
           ) AS balance
    FROM   daily
),
full_bal AS (                                    -- attach balances to every calendar day
    SELECT c.customer_id,
           c.cal_date,
           r.balance
    FROM   cal AS c
    LEFT   JOIN running AS r
           ON r.customer_id = c.customer_id
          AND r.txn_date    = c.cal_date
),
filled AS (                                      -- forward-fill NULL balances
    SELECT fb.customer_id,
           fb.cal_date,
           COALESCE(
               (SELECT x.balance
                FROM   full_bal x
                WHERE  x.customer_id = fb.customer_id
                  AND  x.cal_date   <= fb.cal_date
                  AND  x.balance IS NOT NULL
                ORDER  BY x.cal_date DESC
                LIMIT 1),
               0) AS daily_balance
    FROM full_bal fb
)
SELECT customer_id,
       strftime('%Y-%m', cal_date) AS month,
       MAX(daily_balance)          AS max_daily_balance_in_month
FROM   filled
GROUP  BY customer_id, month
ORDER  BY customer_id, month
LIMIT 20
