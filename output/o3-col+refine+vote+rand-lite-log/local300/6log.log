-- 7) Description:  Produce a calendar for every customer (covers min→max txn dates)
WITH bounds AS (
    SELECT
           "customer_id",
           MIN(DATE("txn_date")) AS "min_d",
           MAX(DATE("txn_date")) AS "max_d"
    FROM   "customer_transactions"
    GROUP  BY "customer_id"),
dates AS (
    SELECT
           "customer_id",
           "min_d" AS "cal_date",
           "max_d"
    FROM   bounds
    UNION ALL
    SELECT
           "customer_id",
           DATE("cal_date", '+1 day'),
           "max_d"
    FROM   dates
    WHERE  DATE("cal_date") < "max_d")
SELECT DISTINCT * 
FROM   dates
ORDER  BY "customer_id", "cal_date"
LIMIT 20;
