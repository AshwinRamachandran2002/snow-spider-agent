```sql
-- 3) Description:  For every customer return their first and last transaction date
SELECT DISTINCT
       "customer_id",
       MIN("txn_date") AS "first_txn",
       MAX("txn_date") AS "last_txn"
FROM   "customer_transactions"
GROUP  BY "customer_id"
LIMIT 20;
```

```sql
-- 4) Description:  Aggregate each customer’s daily net movement
--      deposits are +, everything else is treated as – (e.g. withdrawals)
SELECT DISTINCT
       "customer_id",
       "txn_date",
       SUM(CASE WHEN "txn_type" = 'deposit'
                THEN  "txn_amount"
                ELSE - "txn_amount" END) AS "net_amount"
FROM   "customer_transactions"
GROUP  BY "customer_id", "txn_date"
ORDER  BY "customer_id", "txn_date"
LIMIT 20;
```

```sql
-- 5) Description:  From the daily net we create a running balance per customer
WITH daily AS (
    SELECT
           "customer_id",
           DATE("txn_date") AS "txn_date",
           SUM(CASE WHEN "txn_type" = 'deposit'
                    THEN  "txn_amount"
                    ELSE - "txn_amount" END) AS "net_amount"
    FROM   "customer_transactions"
    GROUP  BY "customer_id", DATE("txn_date"))
SELECT DISTINCT
       "customer_id",
       "txn_date",
       SUM("net_amount") OVER (
           PARTITION BY "customer_id"
           ORDER BY "txn_date"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
       ) AS "balance"
FROM   daily
ORDER  BY "customer_id", "txn_date"
LIMIT 20;
```

```sql
-- 6) Description:  Clamp any negative balances to zero (daily level)
WITH daily_bal AS (
    SELECT
           "customer_id",
           DATE("txn_date") AS "txn_date",
           SUM(CASE WHEN "txn_type" = 'deposit'
                    THEN  "txn_amount"
                    ELSE - "txn_amount" END) AS "net_amount"
    FROM   "customer_transactions"
    GROUP  BY "customer_id", DATE("txn_date"))
SELECT DISTINCT
       "customer_id",
       "txn_date",
       MAX(0,
           SUM("net_amount") OVER (
               PARTITION BY "customer_id"
               ORDER BY "txn_date"
               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
       ) AS "daily_balance"
FROM   daily_bal
ORDER  BY "customer_id", "txn_date"
LIMIT 20;
```

```sql
-- 7) Description:  Produce a calendar for every customer (covers min→max txn dates)
WITH bounds AS (
    SELECT
           "customer_id",
           MIN(DATE("txn_date")) AS "min_d",
           MAX(DATE("txn_date")) AS "max_d"
    FROM   "customer_transactions"
    GROUP  BY "customer_id"),
dates AS (
    SELECT
           "customer_id",
           "min_d" AS "cal_date",
           "max_d"
    FROM   bounds
    UNION ALL
    SELECT
           "customer_id",
           DATE("cal_date", '+1 day'),
           "max_d"
    FROM   dates
    WHERE  DATE("cal_date") < "max_d")
SELECT DISTINCT * 
FROM   dates
ORDER  BY "customer_id", "cal_date"
LIMIT 20;
```

```sql
-- 8) Description:  Merge the generated calendar with the running-balance table
--    and forward-fill balances (SQLite supports LAST_VALUE … IGNORE NULLS ≥3.35)
WITH daily AS (
    SELECT
           "customer_id",
           DATE("txn_date") AS "txn_date",
           SUM(CASE WHEN "txn_type" = 'deposit'
                    THEN  "txn_amount"
                    ELSE - "txn_amount" END) AS "net_amount"
    FROM   "customer_transactions"
    GROUP  BY "customer_id", DATE("txn_date")),
running AS (
    SELECT
           "customer_id",
           "txn_date",
           MAX(0,
               SUM("net_amount") OVER (
                   PARTITION BY "customer_id"
                   ORDER BY "txn_date"
                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
           ) AS "balance"
    FROM   daily),
bounds AS (
    SELECT
           "customer_id",
           MIN(DATE("txn_date")) AS "min_d",
           MAX(DATE("txn_date")) AS "max_d"
    FROM   "customer_transactions"
    GROUP  BY "customer_id"),
dates AS (
    SELECT
           "customer_id",
           "min_d" AS "cal_date",
           "max_d"
    FROM   bounds
    UNION ALL
    SELECT
           "customer_id",
           DATE("cal_date", '+1 day'),
           "max_d"
    FROM   dates
    WHERE  DATE("cal_date") < "max_d"),
full_bal AS (
    SELECT
           d."customer_id",
           d."cal_date",
           r."balance"
    FROM   dates  AS d
    LEFT   JOIN running AS r
           ON r."customer_id" = d."customer_id"
          AND r."txn_date"   = d."cal_date")
SELECT DISTINCT
       "customer_id",
       "cal_date",
       -- forward fill: take the last non-null balance up to current day
       LAST_VALUE("balance") IGNORE NULLS OVER (
           PARTITION BY "customer_id"
           ORDER BY "cal_date"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "daily_balance_filled"
FROM   full_bal
ORDER  BY "customer_id", "cal_date"
LIMIT 20;
```

```sql
-- 9) Description:  From the gap-filled balances, get each customer’s
--    highest daily balance per calendar month
WITH filled AS (
    --  (same CTE chain from query 8) …
    WITH daily AS (
        SELECT
               "customer_id",
               DATE("txn_date") AS "txn_date",
               SUM(CASE WHEN "txn_type" = 'deposit'
                        THEN  "txn_amount"
                        ELSE - "txn_amount" END) AS "net_amount"
        FROM   "customer_transactions"
        GROUP  BY "customer_id", DATE("txn_date")),
    running AS (
        SELECT
               "customer_id",
               "txn_date",
               MAX(0,
                   SUM("net_amount") OVER (
                       PARTITION BY "customer_id"
                       ORDER BY "txn_date"
                       ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
               ) AS "balance"
        FROM   daily),
    bounds AS (
        SELECT
               "customer_id",
               MIN(DATE("txn_date")) AS "min_d",
               MAX(DATE("txn_date")) AS "max_d"
        FROM   "customer_transactions"
        GROUP  BY "customer_id"),
    dates AS (
        SELECT
               "customer_id",
               "min_d" AS "cal_date",
               "max_d"
        FROM   bounds
        UNION ALL
        SELECT
               "customer_id",
               DATE("cal_date", '+1 day'),
               "max_d"
        FROM   dates
        WHERE  DATE("cal_date") < "max_d"),
    full_bal AS (
        SELECT
               d."customer_id",
               d."cal_date",
               r."balance"
        FROM   dates  AS d
        LEFT   JOIN running AS r
               ON r."customer_id" = d."customer_id"
              AND r."txn_date"   = d."cal_date")
    SELECT
           "customer_id",
           strftime('%Y-%m', "cal_date") AS "month",
           LAST_VALUE("balance") IGNORE NULLS OVER (
               PARTITION BY "customer_id"
               ORDER BY "cal_date"
               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "daily_balance"
    FROM   full_bal)
SELECT DISTINCT
       "customer_id",
       "month",
       MAX("daily_balance") AS "max_daily_balance_in_month"
FROM   filled
GROUP  BY "customer_id", "month"
ORDER  BY "customer_id", "month"
LIMIT 20;
```

```sql
-- 10) Description:  Final answer – sum those per-customer maximum balances
--     across all customers to get the total per month
WITH per_customer_month AS (
    -- (reuse query 9’s inner logic)
    WITH daily AS (
        SELECT
               "customer_id",
               DATE("txn_date") AS "txn_date",
               SUM(CASE WHEN "txn_type" = 'deposit'
                        THEN  "txn_amount"
                        ELSE - "txn_amount" END) AS "net_amount"
        FROM   "customer_transactions"
        GROUP  BY "customer_id", DATE("txn_date")),
    running AS (
        SELECT
               "customer_id",
               "txn_date",
               MAX(0,
                   SUM("net_amount") OVER (
                       PARTITION BY "customer_id"
                       ORDER BY "txn_date"
                       ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
               ) AS "balance"
        FROM   daily),
    bounds AS (
        SELECT
               "customer_id",
               MIN(DATE("txn_date")) AS "min_d",
               MAX(DATE("txn_date")) AS "max_d"
        FROM   "customer_transactions"
        GROUP  BY "customer_id"),
    dates AS (
        SELECT
               "customer_id",
               "min_d" AS "cal_date",
               "max_d"
        FROM   bounds
        UNION ALL
        SELECT
               "customer_id",
               DATE("cal_date", '+1 day'),
               "max_d"
        FROM   dates
        WHERE  DATE("cal_date") < "max_d"),
    full_bal AS (
        SELECT
               d."customer_id",
               d."cal_date",
               r."balance"
        FROM   dates  AS d
        LEFT   JOIN running AS r
               ON r."customer_id" = d."customer_id"
              AND r."txn_date"   = d."cal_date")
    SELECT
           "customer_id",
           strftime('%Y-%m', "cal_date") AS "month",
           LAST_VALUE("balance") IGNORE NULLS OVER (
               PARTITION BY "customer_id"
               ORDER BY "cal_date"
               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "daily_balance"
    FROM   full_bal)
SELECT DISTINCT
       "month",
       SUM("max_balance") AS "monthly_total_highest_balance"
FROM (
    SELECT
           "customer_id",
           "month",
           MAX("daily_balance") AS "max_balance"
    FROM   per_customer_month
    GROUP  BY "customer_id", "month")
GROUP  BY "month"
ORDER  BY "month"
LIMIT 20;
```
