```sql
--Description:  End-to-end solution: build daily running balances (never <0), fabricate a
--              complete date calendar for every customer, forward-fill missing balances,
--              extract each customer’s maximum daily balance per month and finally add
--              those peaks together to obtain the monthly total.  First 20 months shown.
WITH daily AS (                             -- 1. net movement per customer/day
    SELECT
        customer_id,
        DATE(txn_date)                     AS txn_date,
        SUM(CASE WHEN txn_type = 'deposit'
                 THEN  txn_amount
                 ELSE -txn_amount END)     AS net_amt
    FROM customer_transactions
    GROUP BY customer_id, DATE(txn_date)
), running AS (                            -- 2. cumulative balance, clamped at 0
    SELECT
        customer_id,
        txn_date,
        MAX(0,
            SUM(net_amt) OVER (
                PARTITION BY customer_id
                ORDER BY txn_date
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
        ) AS balance
    FROM daily
), bounds AS (                             -- 3. earliest and latest txn dates
    SELECT
        customer_id,
        MIN(DATE(txn_date)) AS min_d,
        MAX(DATE(txn_date)) AS max_d
    FROM customer_transactions
    GROUP BY customer_id
), RECURSIVE calendar AS (                 -- 4. every day between min_d and max_d
    SELECT customer_id, min_d AS cal_date, max_d
    FROM bounds
    UNION ALL
    SELECT customer_id,
           DATE(cal_date,'+1 day'),
           max_d
    FROM calendar
    WHERE cal_date < max_d
), full_bal AS (                           -- 5. attach the days that HAVE a txn
    SELECT
        c.customer_id,
        c.cal_date,
        r.balance
    FROM calendar c
    LEFT JOIN running r
      ON r.customer_id = c.customer_id
     AND r.txn_date    = c.cal_date
), filled AS (                             -- 6. forward-fill NULL balances
    SELECT
        fb.customer_id,
        fb.cal_date,
        COALESCE(
            (SELECT x.balance
             FROM   full_bal x
             WHERE  x.customer_id = fb.customer_id
               AND  x.cal_date   <= fb.cal_date
               AND  x.balance IS NOT NULL
             ORDER  BY x.cal_date DESC
             LIMIT 1),
            0
        ) AS daily_balance
    FROM full_bal fb
), per_customer_month AS (                 -- 7. max balance each month/customer
    SELECT
        customer_id,
        strftime('%Y-%m', cal_date) AS month,
        MAX(daily_balance)          AS max_balance
    FROM filled
    GROUP BY customer_id, month
)
SELECT                                      -- 8. monthly total of those peaks
    month,
    SUM(max_balance) AS monthly_total_highest_balance
FROM per_customer_month
GROUP BY month
ORDER BY month
LIMIT 20;
```
