Query:
--Description: Aggregate those signed amounts so that, per customer-day, we have one net cash-flow figure.
WITH cte AS (
    SELECT "customer_id",
           DATE("txn_date")            AS "txn_day",
           CASE 
               WHEN "txn_type"='deposit' THEN  "txn_amount"
               ELSE -1 * "txn_amount"
           END                         AS "change_amt"
    FROM   "customer_transactions"
)
SELECT DISTINCT 
       "customer_id",
       "txn_day",
       SUM("change_amt") AS "net_change"
FROM   cte
GROUP BY "customer_id","txn_day"
LIMIT  20;
