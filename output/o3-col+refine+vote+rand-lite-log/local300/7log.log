Query:
--Description: FINAL ANSWER – monthly total of each customer’s highest daily balance (negatives floored to zero).
WITH trans AS (
    SELECT "customer_id",
           DATE("txn_date") AS "txn_day",
           CASE 
               WHEN "txn_type"='deposit' THEN  "txn_amount"
               ELSE -1*"txn_amount"
           END              AS "change_amt"
    FROM   "customer_transactions"
),
cust_span AS (
    SELECT "customer_id",
           MIN("txn_day") AS "min_day",
           MAX("txn_day") AS "max_day"
    FROM   trans
    GROUP BY "customer_id"
),
-- generate every day for every customer
all_days AS (
    SELECT "customer_id", "min_day" AS "cal_day"
    FROM   cust_span
    UNION ALL
    SELECT "customer_id",
           DATE("cal_day",'+1 day')
    FROM   all_days
    JOIN   cust_span USING("customer_id")
    WHERE  "cal_day" < (SELECT "max_day"
                        FROM   cust_span AS c
                        WHERE  c."customer_id" = all_days."customer_id")
),
day_change AS (
    SELECT "customer_id",
           "txn_day",
           SUM("change_amt") AS "net_change"
    FROM   trans
    GROUP BY "customer_id","txn_day"
),
day_bal AS (
    SELECT d."customer_id",
           d."cal_day",
           -- running balance per customer
           CASE
               WHEN SUM(COALESCE(dc."net_change",0)) 
                    OVER (PARTITION BY d."customer_id"
                          ORDER BY d."cal_day"
                          ROWS BETWEEN UNBOUNDED PRECEDING
                                   AND CURRENT ROW) < 0
               THEN 0
               ELSE SUM(COALESCE(dc."net_change",0)) 
                    OVER (PARTITION BY d."customer_id"
                          ORDER BY d."cal_day"
                          ROWS BETWEEN UNBOUNDED PRECEDING
                                   AND CURRENT ROW)
           END AS "balance"
    FROM   all_days         AS d
    LEFT JOIN day_change    AS dc
           ON dc."customer_id" = d."customer_id"
          AND dc."txn_day"   = d."cal_day"
),
cust_month_max AS (
    SELECT "customer_id",
           STRFTIME('%Y-%m', "cal_day") AS "month",
           MAX("balance")              AS "max_balance_in_month"
    FROM   day_bal
    GROUP BY "customer_id","month"
)
SELECT  "month",
        SUM("max_balance_in_month") AS "total_of_monthly_max_balances"
FROM    cust_month_max
GROUP BY "month"
ORDER BY "month"
LIMIT   20;
