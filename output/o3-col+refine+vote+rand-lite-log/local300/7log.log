```sql
--Description: Convert each transaction into its signed cash-flow (+ for deposit, – for anything else).
SELECT DISTINCT 
       "customer_id",
       DATE("txn_date")               AS "txn_day",
       CASE 
           WHEN "txn_type"='deposit'  THEN  "txn_amount"
           ELSE -1 * "txn_amount"
       END                            AS "change_amt"
FROM   "customer_transactions"
LIMIT  20;
```

```sql
--Description: Aggregate those signed amounts so that, per customer-day, we have one net cash-flow figure.
WITH cte AS (
    SELECT "customer_id",
           DATE("txn_date")            AS "txn_day",
           CASE 
               WHEN "txn_type"='deposit' THEN  "txn_amount"
               ELSE -1 * "txn_amount"
           END                         AS "change_amt"
    FROM   "customer_transactions"
)
SELECT DISTINCT 
       "customer_id",
       "txn_day",
       SUM("change_amt") AS "net_change"
FROM   cte
GROUP BY "customer_id","txn_day"
LIMIT  20;
```

```sql
--Description: Build an expanding running-balance for one illustrative customer, turning negatives into zero.
WITH trans AS (
    SELECT "customer_id",
           DATE("txn_date")            AS "txn_day",
           CASE WHEN "txn_type"='deposit' 
                THEN "txn_amount" 
                ELSE -1*"txn_amount" 
           END                         AS "change_amt"
    FROM   "customer_transactions"
    WHERE  "customer_id" = 1          -- sample customer
),
bounds AS (
    SELECT MIN("txn_day") AS "min_day",
           MAX("txn_day") AS "max_day"
    FROM   trans
),
-- calendar days for that customer
dates(d) AS (
    SELECT "min_day" FROM bounds
    UNION ALL
    SELECT DATE(d,'+1 day')
    FROM   dates, bounds
    WHERE  d < (SELECT "max_day" FROM bounds)
),
daily AS (
    SELECT d                                 AS "the_day",
           COALESCE(SUM("change_amt"),0)     AS "net_change"
    FROM   dates
    LEFT JOIN trans
           ON trans."txn_day" = d
    GROUP BY d
),
running AS (
    SELECT "the_day",
           SUM("net_change") OVER (ORDER BY "the_day") AS "raw_running"
    FROM   daily
)
SELECT DISTINCT 
       "the_day",
       CASE WHEN "raw_running" < 0 THEN 0 ELSE "raw_running" END AS "balance"
FROM   running
LIMIT  20;
```

```sql
--Description: FINAL ANSWER – monthly total of each customer’s highest daily balance (negatives floored to zero).
WITH trans AS (
    SELECT "customer_id",
           DATE("txn_date") AS "txn_day",
           CASE 
               WHEN "txn_type"='deposit' THEN  "txn_amount"
               ELSE -1*"txn_amount"
           END              AS "change_amt"
    FROM   "customer_transactions"
),
cust_span AS (
    SELECT "customer_id",
           MIN("txn_day") AS "min_day",
           MAX("txn_day") AS "max_day"
    FROM   trans
    GROUP BY "customer_id"
),
-- generate every day for every customer
all_days AS (
    SELECT "customer_id", "min_day" AS "cal_day"
    FROM   cust_span
    UNION ALL
    SELECT "customer_id",
           DATE("cal_day",'+1 day')
    FROM   all_days
    JOIN   cust_span USING("customer_id")
    WHERE  "cal_day" < (SELECT "max_day"
                        FROM   cust_span AS c
                        WHERE  c."customer_id" = all_days."customer_id")
),
day_change AS (
    SELECT "customer_id",
           "txn_day",
           SUM("change_amt") AS "net_change"
    FROM   trans
    GROUP BY "customer_id","txn_day"
),
day_bal AS (
    SELECT d."customer_id",
           d."cal_day",
           -- running balance per customer
           CASE
               WHEN SUM(COALESCE(dc."net_change",0)) 
                    OVER (PARTITION BY d."customer_id"
                          ORDER BY d."cal_day"
                          ROWS BETWEEN UNBOUNDED PRECEDING
                                   AND CURRENT ROW) < 0
               THEN 0
               ELSE SUM(COALESCE(dc."net_change",0)) 
                    OVER (PARTITION BY d."customer_id"
                          ORDER BY d."cal_day"
                          ROWS BETWEEN UNBOUNDED PRECEDING
                                   AND CURRENT ROW)
           END AS "balance"
    FROM   all_days         AS d
    LEFT JOIN day_change    AS dc
           ON dc."customer_id" = d."customer_id"
          AND dc."txn_day"   = d."cal_day"
),
cust_month_max AS (
    SELECT "customer_id",
           STRFTIME('%Y-%m', "cal_day") AS "month",
           MAX("balance")              AS "max_balance_in_month"
    FROM   day_bal
    GROUP BY "customer_id","month"
)
SELECT  "month",
        SUM("max_balance_in_month") AS "total_of_monthly_max_balances"
FROM    cust_month_max
GROUP BY "month"
ORDER BY "month"
LIMIT   20;
```
