```sql
--Description: Check the different status values that exist in the stations table
SELECT DISTINCT "status"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS
LIMIT 20;
```

```sql
--Description: Take a quick look at 20 stations whose status is recorded as 'active'
SELECT "station_id",
       "name",
       "status",
       "location"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS
WHERE "status" ILIKE 'active'
LIMIT 20;
```

```sql
--Description: Identify the top-20 start stations by trip count (all stations, no status filter yet)
SELECT "start_station_id",
       COUNT(*) AS "start_trip_count"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS
GROUP BY "start_station_id"
ORDER BY "start_trip_count" DESC
LIMIT 20;
```

```sql
--Description: Drill into one specific busy station (ID 4051) to see some sample trips
SELECT "trip_id",
       "subscriber_type",
       "bike_type",
       "start_time",
       "duration_minutes"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS
WHERE "start_station_id" = 4051
LIMIT 20;
```

```sql
--Description: Count starting trips only for stations that are currently marked ‘active’
SELECT t."start_station_id",
       COUNT(*) AS "active_station_trip_count"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS t
JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
  ON t."start_station_id" = s."station_id"
WHERE s."status" ILIKE 'active'
GROUP BY t."start_station_id"
ORDER BY "active_station_trip_count" DESC
LIMIT 20;
```

```sql
--Description: Compute the total number of trips that originate from ALL active stations
SELECT COUNT(*) AS "total_active_station_trips"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS t
JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
  ON t."start_station_id" = s."station_id"
WHERE s."status" ILIKE 'active'
LIMIT 20;
```

```sql
--Description: Retrieve the top 20 active stations with their trip counts and average duration
SELECT t."start_station_id",
       COUNT(*)                              AS "trip_count",
       AVG(t."duration_minutes")             AS "avg_duration_minutes"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS t
JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
  ON t."start_station_id" = s."station_id"
WHERE s."status" ILIKE 'active'
GROUP BY t."start_station_id"
ORDER BY "trip_count" DESC
LIMIT 20;
```

```sql
--Description: Rank active stations by starting-trip count and keep the top 15 ranks (ties included)
WITH active_counts AS (
    SELECT t."start_station_id",
           COUNT(*) AS "trip_count"
    FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS t
    JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
      ON t."start_station_id" = s."station_id"
    WHERE s."status" ILIKE 'active'
    GROUP BY t."start_station_id"
)
SELECT "start_station_id",
       "trip_count",
       DENSE_RANK() OVER (ORDER BY "trip_count" DESC) AS "rank"
FROM active_counts
QUALIFY "rank" <= 15
ORDER BY "rank"
LIMIT 20;
```

```sql
--Description: Add percentage of total trips for each of the top-ranked active stations
WITH active_counts AS (
    SELECT t."start_station_id",
           COUNT(*) AS "trip_count"
    FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS t
    JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
      ON t."start_station_id" = s."station_id"
    WHERE s."status" ILIKE 'active'
    GROUP BY t."start_station_id"
),
tot AS (
    SELECT SUM("trip_count") AS "grand_total"
    FROM active_counts
)
SELECT a."start_station_id",
       a."trip_count",
       (a."trip_count" / t."grand_total") * 100 AS "pct_of_active_start_trips"
FROM active_counts a, tot t
ORDER BY a."trip_count" DESC
LIMIT 20;
```

```sql
--Description: Final result – top 15 (with ties) active stations by starting-trip count, including counts,
--             percentage of total active-station trips, and average trip duration
WITH active_trips AS (
    SELECT t."start_station_id",
           t."duration_minutes"
    FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS t
    JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
      ON t."start_station_id" = s."station_id"
    WHERE s."status" ILIKE 'active'
),
station_stats AS (
    SELECT "start_station_id",
           COUNT(*)                AS "trip_count",
           AVG("duration_minutes") AS "avg_duration_minutes"
    FROM active_trips
    GROUP BY "start_station_id"
),
tot AS (
    SELECT SUM("trip_count") AS "grand_total"
    FROM station_stats
),
ranked AS (
    SELECT s.*,
           DENSE_RANK() OVER (ORDER BY s."trip_count" DESC) AS "rank"
    FROM station_stats s
)
SELECT "start_station_id"                        AS "station_id",
       "trip_count",
       ROUND(("trip_count" / t."grand_total") * 100, 2) AS "pct_of_active_start_trips",
       ROUND("avg_duration_minutes", 2)           AS "avg_duration_minutes",
       "rank"
FROM ranked r, tot t
WHERE r."rank" <= 15
ORDER BY "rank", "start_station_id"
LIMIT 20;
```
