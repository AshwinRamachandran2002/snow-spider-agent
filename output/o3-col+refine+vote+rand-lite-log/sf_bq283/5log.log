--Description: Rank active stations by total starting trips (dense_rank keeps ties together).
SELECT t."start_station_id",
       COUNT(*)                                   AS "total_starting_trips",
       DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS "rank_by_starts"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS  AS t
JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS AS s
      ON t."start_station_id" = s."station_id"
WHERE s."status" = 'active'
GROUP BY t."start_station_id"
ORDER BY "rank_by_starts"
LIMIT 20;
