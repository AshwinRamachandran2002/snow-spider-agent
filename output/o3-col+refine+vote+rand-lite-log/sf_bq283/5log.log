```sql
--Description: Inspect the different status values a station can have.
SELECT DISTINCT "status"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS
LIMIT 20;
```

```sql
--Description: View a sample of stations that are currently marked as 'active'.
SELECT "station_id",
       "name",
       "status"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS
WHERE "status" = 'active'
LIMIT 20;
```

```sql
--Description: Count how many trips start from every station (all statuses) to get a sense of distribution.
SELECT "start_station_id",
       COUNT(*) AS "total_starting_trips"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS
GROUP BY "start_station_id"
ORDER BY "total_starting_trips" DESC
LIMIT 20;
```

```sql
--Description: Identify trips that start from stations that are currently active (simple join check).
SELECT t."trip_id",
       t."start_station_id",
       s."status"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS  AS t
JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS AS s
      ON t."start_station_id" = s."station_id"
WHERE s."status" = 'active'
LIMIT 20;
```

```sql
--Description: Aggregate total starting-trip counts **only** for active stations.
SELECT t."start_station_id",
       COUNT(*) AS "total_starting_trips"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS  AS t
JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS AS s
      ON t."start_station_id" = s."station_id"
WHERE s."status" = 'active'
GROUP BY t."start_station_id"
ORDER BY "total_starting_trips" DESC
LIMIT 20;
```

```sql
--Description: Compute both total trips and average duration (minutes) for each active station.
SELECT t."start_station_id",
       COUNT(*)                         AS "total_starting_trips",
       AVG(t."duration_minutes")        AS "avg_duration_minutes"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS  AS t
JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS AS s
      ON t."start_station_id" = s."station_id"
WHERE s."status" = 'active'
GROUP BY t."start_station_id"
ORDER BY "total_starting_trips" DESC
LIMIT 20;
```

```sql
--Description: Calculate the grand total of starting trips from all active stations (needed for percentage calc).
SELECT COUNT(*) AS "grand_total_active_starting_trips"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS  AS t
JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS AS s
      ON t."start_station_id" = s."station_id"
WHERE s."status" = 'active';
```

```sql
--Description: Rank active stations by total starting trips (dense_rank keeps ties together).
SELECT t."start_station_id",
       COUNT(*)                                   AS "total_starting_trips",
       DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS "rank_by_starts"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS  AS t
JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS AS s
      ON t."start_station_id" = s."station_id"
WHERE s."status" = 'active'
GROUP BY t."start_station_id"
ORDER BY "rank_by_starts"
LIMIT 20;
```

```sql
--Description: Combine everything—top 15 ranks (including ties) with percentage share and avg duration.
WITH active_trips AS (
     SELECT t."start_station_id",
            COUNT(*)          AS "total_starting_trips",
            AVG(t."duration_minutes") AS "avg_duration_minutes"
     FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS  AS t
     JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS AS s
           ON t."start_station_id" = s."station_id"
     WHERE s."status" = 'active'
     GROUP BY t."start_station_id"
),
ranked AS (
     SELECT *,
            DENSE_RANK() OVER (ORDER BY "total_starting_trips" DESC) AS "rank_by_starts"
     FROM active_trips
),
grand_total AS (
     SELECT SUM("total_starting_trips") AS "grand_total"
     FROM active_trips
)
SELECT r."start_station_id"                         AS "station_id",
       r."total_starting_trips",
       ROUND(100.0 * r."total_starting_trips" / g."grand_total", 2) AS "pct_of_active_starts",
       ROUND(r."avg_duration_minutes", 2)            AS "avg_duration_minutes"
FROM ranked r
CROSS JOIN grand_total g
WHERE r."rank_by_starts" <= 15
ORDER BY r."rank_by_starts", r."start_station_id"
LIMIT 20;
```

```sql
--Description: Verify that no additional stations share the 15th rank by checking max rank selected.
SELECT MAX("rank_by_starts") AS "highest_rank_included"
FROM (
     SELECT DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS "rank_by_starts"
     FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS  AS t
     JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS AS s
           ON t."start_station_id" = s."station_id"
     WHERE s."status" = 'active'
     GROUP BY t."start_station_id"
) q
WHERE "rank_by_starts" <= 15;
```
