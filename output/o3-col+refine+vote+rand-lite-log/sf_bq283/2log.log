Query:
--Description: Final query – adds percentage of trips vs. all active-station trips and orders by rank.  
WITH active_totals AS (
    SELECT t."start_station_id",
           COUNT(*)                AS "trip_count",
           AVG(t."duration_minutes") AS "avg_minutes"
    FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS t
    JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
         ON t."start_station_id" = s."station_id"
    WHERE s."status" ILIKE '%open%'
       OR s."status" ILIKE '%active%'
       OR s."status" ILIKE '%service%'
    GROUP BY t."start_station_id"
), ranked AS (
    SELECT  RANK() OVER (ORDER BY "trip_count" DESC) AS "station_rank",
            active_totals.*
    FROM   active_totals
), top15 AS (
    SELECT *
    FROM ranked
    WHERE "station_rank" <= 15
)
SELECT  "station_rank",
        "start_station_id"        AS "station_id",
        "trip_count",
        ROUND("trip_count" * 100.0 / SUM("trip_count") OVER (), 2) AS "pct_of_active_trips",
        ROUND("avg_minutes", 2)   AS "avg_duration_minutes"
FROM top15
ORDER BY "station_rank", "station_id"
LIMIT 100;   -- should include every tie for rank 15
