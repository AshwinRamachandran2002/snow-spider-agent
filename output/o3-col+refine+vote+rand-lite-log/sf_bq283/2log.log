```

```sql
--Description: Trip counts for ONLY the stations that are currently active.  
SELECT t."start_station_id",
       COUNT(*) AS "trip_count"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS   t
JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
     ON t."start_station_id" = s."station_id"
WHERE s."status" ILIKE '%open%'
   OR s."status" ILIKE '%active%'
   OR s."status" ILIKE '%service%'
GROUP BY t."start_station_id"
ORDER BY "trip_count" DESC
LIMIT 20;
```

```sql
--Description: Overall number of trips that START at any active station (needed for later % calculation).  
SELECT COUNT(*) AS "total_active_starting_trips"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS   t
JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
     ON t."start_station_id" = s."station_id"
WHERE s."status" ILIKE '%open%'
   OR s."status" ILIKE '%active%'
   OR s."status" ILIKE '%service%';
```

```sql
--Description: Rank active stations by trip count using RANK() so ties share the same rank.  
SELECT  RANK() OVER (ORDER BY COUNT(*) DESC) AS "station_rank",
        t."start_station_id",
        COUNT(*)  AS "trip_count"
FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS   t
JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
     ON t."start_station_id" = s."station_id"
WHERE s."status" ILIKE '%open%'
   OR s."status" ILIKE '%active%'
   OR s."status" ILIKE '%service%'
GROUP BY t."start_station_id"
ORDER BY "station_rank"
LIMIT 25;        -- a few extra rows so you can see if there are ties at 15
```

```sql
--Description: Pull the same ranking but also include average trip duration.  
WITH active AS (
    SELECT t."start_station_id",
           COUNT(*)                 AS "trip_count",
           AVG(t."duration_minutes") AS "avg_minutes"
    FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS   t
    JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
         ON t."start_station_id" = s."station_id"
    WHERE s."status" ILIKE '%open%'
       OR s."status" ILIKE '%active%'
       OR s."status" ILIKE '%service%'
    GROUP BY t."start_station_id"
), ranked AS (
    SELECT  RANK() OVER (ORDER BY "trip_count" DESC) AS "station_rank",
            *
    FROM active
)
SELECT *
FROM ranked
WHERE "station_rank" <= 15        -- still shows ties because rank repeats
ORDER BY "station_rank", "start_station_id"
LIMIT 50;                          -- just in case many ties
```

```sql
--Description: Final query – adds percentage of trips vs. all active-station trips and orders by rank.  
WITH active_totals AS (
    SELECT t."start_station_id",
           COUNT(*)                AS "trip_count",
           AVG(t."duration_minutes") AS "avg_minutes"
    FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS t
    JOIN AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS s
         ON t."start_station_id" = s."station_id"
    WHERE s."status" ILIKE '%open%'
       OR s."status" ILIKE '%active%'
       OR s."status" ILIKE '%service%'
    GROUP BY t."start_station_id"
), ranked AS (
    SELECT  RANK() OVER (ORDER BY "trip_count" DESC) AS "station_rank",
            active_totals.*
    FROM   active_totals
), top15 AS (
    SELECT *
    FROM ranked
    WHERE "station_rank" <= 15
)
SELECT  "station_rank",
        "start_station_id"        AS "station_id",
        "trip_count",
        ROUND("trip_count" * 100.0 / SUM("trip_count") OVER (), 2) AS "pct_of_active_trips",
        ROUND("avg_minutes", 2)   AS "avg_duration_minutes"
FROM top15
ORDER BY "station_rank", "station_id"
LIMIT 100;   -- should include every tie for rank 15
```

