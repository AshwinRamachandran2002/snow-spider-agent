--Description: 4) Average weekly Anosmia search score for each of the five NYC counties during 2019
SELECT `sub_region_2`,
       AVG(SAFE_CAST(`symptom_anosmia` AS FLOAT64)) AS avg_anosmia_2019
FROM   `bigquery-public-data.covid19_symptom_search.symptom_search_sub_region_2_weekly`
WHERE  `country_region` = 'United States'
  AND  `sub_region_1`   = 'New York'
  AND  `sub_region_2` IN ('Bronx County','Queens County','Kings County',
                          'New York County','Richmond County')
  AND  `date` BETWEEN '2019-01-01' AND '2019-12-31'
GROUP  BY `sub_region_2`
LIMIT  20;
