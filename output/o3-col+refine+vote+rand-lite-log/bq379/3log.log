```sql
--Description:
-- Determine which gene’s overall-direct association score for psoriasis
-- (diseaseId = 'EFO_0000676') lies closest to the mean score of all psoriasis
-- targets.  Steps inside one query:
--   1. ps_scores: gather targetId-score pairs for psoriasis from
--      associationByOverallDirect.
--   2. mean_val: compute the average of those scores.
--   3. Final SELECT joins to the targets table to obtain the approved gene
--      symbol, ranks targets by the absolute difference between their score
--      and the mean, and returns the single closest symbol.
-- NOTE: Open Targets public tables are stored in the EU multi-region; be sure
--       to run the query in the EU location setting.
WITH ps_scores AS (
  SELECT
    targetId,
    score
  FROM
    `bigquery-public-data.open_targets_platform.associationByOverallDirect`
  WHERE
    diseaseId = 'EFO_0000676'         -- psoriasis
),
mean_val AS (
  SELECT AVG(score) AS mean_score
  FROM ps_scores
)
SELECT
  t.approvedSymbol
FROM
  ps_scores s
CROSS JOIN
  mean_val m
JOIN
  `bigquery-public-data.open_targets_platform.targets` t
    ON t.id = s.targetId
ORDER BY
  ABS(s.score - m.mean_score)
LIMIT 1;
```
