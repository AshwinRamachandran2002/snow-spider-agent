```sql
--1. Look up disease identifier(s) that correspond to psoriasis
SELECT id, name
FROM `open-targets-prod.platform.diseases`
WHERE LOWER(name) LIKE '%psoriasis%'
LIMIT 20;
```

```sql
--2. Inspect a few overall-direct association scores for psoriasis  
SELECT diseaseId, targetId, score
FROM `open-targets-prod.platform.associationByOverallDirect`
WHERE diseaseId = 'EFO_0000676'            -- psoriasis
LIMIT 20;
```

```sql
--3. Count how many targets have an overall-direct score for psoriasis
SELECT COUNT(*) AS n_targets
FROM `open-targets-prod.platform.associationByOverallDirect`
WHERE diseaseId = 'EFO_0000676';
```

```sql
--4. Calculate the mean overall-direct association score for psoriasis
SELECT AVG(score) AS mean_score_psoriasis
FROM `open-targets-prod.platform.associationByOverallDirect`
WHERE diseaseId = 'EFO_0000676';
```

```sql
--5. Show each target’s score together with its distance from the mean
WITH mean AS (
  SELECT AVG(score) AS m
  FROM `open-targets-prod.platform.associationByOverallDirect`
  WHERE diseaseId = 'EFO_0000676'
)
SELECT a.targetId,
       a.score,
       ABS(a.score - m) AS diff_from_mean
FROM `open-targets-prod.platform.associationByOverallDirect` AS a
CROSS JOIN mean
WHERE a.diseaseId = 'EFO_0000676'
ORDER BY diff_from_mean
LIMIT 20;
```

```sql
--6. Attach approved gene symbols to the previous list
WITH mean AS (
  SELECT AVG(score) AS m
  FROM `open-targets-prod.platform.associationByOverallDirect`
  WHERE diseaseId = 'EFO_0000676'
)
SELECT t.approvedSymbol,
       a.score,
       ABS(a.score - m) AS diff_from_mean
FROM `open-targets-prod.platform.associationByOverallDirect` AS a
JOIN `open-targets-prod.platform.targets` AS t
  ON a.targetId = t.id
CROSS JOIN mean
WHERE a.diseaseId = 'EFO_0000676'
ORDER BY diff_from_mean
LIMIT 20;
```

```sql
--7. Return the single target whose overall-direct score is closest to the mean for psoriasis
WITH mean AS (
  SELECT AVG(score) AS m
  FROM `open-targets-prod.platform.associationByOverallDirect`
  WHERE diseaseId = 'EFO_0000676'
)
SELECT t.approvedSymbol  -- answer: target whose score is closest to mean
FROM `open-targets-prod.platform.associationByOverallDirect` AS a
JOIN `open-targets-prod.platform.targets`                AS t
  ON a.targetId = t.id
CROSS JOIN mean
WHERE a.diseaseId = 'EFO_0000676'
ORDER BY ABS(a.score - m)
LIMIT 1;
```

The final query (--7) outputs the approved gene symbol whose overall association score is nearest to the mean score for psoriasis.
