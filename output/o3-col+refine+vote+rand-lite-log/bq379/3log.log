```sql
--Description: 
-- Find the approved gene symbol whose overall-direct association score is closest
-- to the mean overall-direct score for psoriasis.  
-- The `region-eu` location qualifier is placed *before* the project ID, e.g.
-- `region-eu`.bigquery-public-data…  Make sure the BigQuery execution location
-- is set to EU when running this query.
WITH psoriasis AS (
  -- 1. Obtain the diseaseId for psoriasis
  SELECT id
  FROM `region-eu`.bigquery-public-data.open_targets_platform.diseases
  WHERE LOWER(name) LIKE '%psoriasis%'
  LIMIT 1
),
scores AS (
  -- 2. All target-score pairs for that disease
  SELECT targetId, score
  FROM `region-eu`.bigquery-public-data.open_targets_platform.associationByOverallDirect
  WHERE diseaseId IN (SELECT id FROM psoriasis)
),
mean_val AS (
  -- 3. Compute the mean score
  SELECT AVG(score) AS mean_score
  FROM scores
)
-- 4. Return the gene symbol whose score is closest to the mean
SELECT t.approvedSymbol
FROM scores s
CROSS JOIN mean_val m
JOIN `region-eu`.bigquery-public-data.open_targets_platform.targets t
  ON t.id = s.targetId
ORDER BY ABS(s.score - m.mean_score)
LIMIT 1;
```
