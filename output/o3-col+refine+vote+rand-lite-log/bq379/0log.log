```sql
-- 1. Find the ontology identifier used for “psoriasis”
SELECT id, name
FROM `open-targets-prod.platform.diseases`
WHERE LOWER(name) LIKE '%psoriasis%'
LIMIT 20;
```

```sql
-- 2. Inspect how many overall-direct association rows exist for psoriasis
SELECT COUNT(*) AS n_rows
FROM `open-targets-prod.platform.associationByOverallDirect`
WHERE diseaseId = 'EFO_0000676';          -- substitute with id returned in step 1
```

```sql
-- 3. Calculate the mean overall-direct association score for psoriasis
SELECT AVG(score) AS mean_score
FROM `open-targets-prod.platform.associationByOverallDirect`
WHERE diseaseId = 'EFO_0000676';          -- psoriasis id
```

```sql
-- 4. List every target with its score and its distance to the mean
WITH mean_val AS (
  SELECT AVG(score) AS m
  FROM `open-targets-prod.platform.associationByOverallDirect`
  WHERE diseaseId = 'EFO_0000676'
)
SELECT a.targetId,
       a.score,
       ABS(a.score - m) AS distance_to_mean
FROM   `open-targets-prod.platform.associationByOverallDirect` AS a
JOIN   mean_val
WHERE  a.diseaseId = 'EFO_0000676'
ORDER BY distance_to_mean ASC
LIMIT 20;
```

```sql
-- 5. Retrieve the single target whose score is closest to the mean
WITH mean_val AS (
  SELECT AVG(score) AS m
  FROM `open-targets-prod.platform.associationByOverallDirect`
  WHERE diseaseId = 'EFO_0000676'
),
ranked AS (
  SELECT a.targetId,
         a.score,
         ABS(a.score - m) AS distance_to_mean,
         ROW_NUMBER() OVER (ORDER BY ABS(a.score - m)) AS rk
  FROM   `open-targets-prod.platform.associationByOverallDirect` AS a
  JOIN   mean_val
  WHERE  a.diseaseId = 'EFO_0000676'
)
SELECT targetId, score, distance_to_mean
FROM   ranked
WHERE  rk = 1;
```

```sql
-- 6. Get the approved HGNC symbol of that target
SELECT t.id,
       t.approvedSymbol,
       t.approvedName
FROM   `open-targets-prod.platform.targets` AS t
WHERE  t.id = 'ENSG00000XXXXX';           -- replace with targetId found in step 5
```

```sql
-- 7. All-in-one query that returns the approved symbol closest to the mean score
WITH mean_val AS (
  SELECT AVG(score) AS m
  FROM `open-targets-prod.platform.associationByOverallDirect`
  WHERE diseaseId = 'EFO_0000676'
),
closest AS (
  SELECT a.targetId,
         ABS(a.score - m) AS distance_to_mean,
         ROW_NUMBER() OVER (ORDER BY ABS(a.score - m)) AS rk
  FROM   `open-targets-prod.platform.associationByOverallDirect` AS a
  JOIN   mean_val
  WHERE  a.diseaseId = 'EFO_0000676'
)
SELECT t.approvedSymbol
FROM   closest c
JOIN   `open-targets-prod.platform.targets` t
       ON t.id = c.targetId
WHERE  c.rk = 1;
```

```sql
-- 8. (Optional) Display that symbol together with its exact score, mean and distance
WITH mean_val AS (
  SELECT AVG(score) AS m
  FROM `open-targets-prod.platform.associationByOverallDirect`
  WHERE diseaseId = 'EFO_0000676'
),
closest AS (
  SELECT a.targetId,
         a.score,
         ABS(a.score - m) AS distance_to_mean,
         m,
         ROW_NUMBER() OVER (ORDER BY ABS(a.score - m)) AS rk
  FROM   `open-targets-prod.platform.associationByOverallDirect` AS a
  JOIN   mean_val
  WHERE  a.diseaseId = 'EFO_0000676'
)
SELECT t.approvedSymbol,
       c.score,
       c.m   AS mean_score,
       c.distance_to_mean
FROM   closest c
JOIN   `open-targets-prod.platform.targets` t
       ON t.id = c.targetId
WHERE  c.rk = 1;
```

```sql
-- 9. Verify that no other target has the same minimal distance (tie-checking)
WITH mean_val AS (
  SELECT AVG(score) AS m
  FROM `open-targets-prod.platform.associationByOverallDirect`
  WHERE diseaseId = 'EFO_0000676'
),
distances AS (
  SELECT a.targetId,
         ABS(a.score - m) AS distance_to_mean
  FROM   `open-targets-prod.platform.associationByOverallDirect` AS a
  JOIN   mean_val
  WHERE  a.diseaseId = 'EFO_0000676'
)
SELECT COUNT(*) AS n_with_min_distance
FROM   distances
WHERE  distance_to_mean = (SELECT MIN(distance_to_mean) FROM distances);
```

```sql
-- 10. (If needed) show all targets in case of ties
WITH mean_val AS (
  SELECT AVG(score) AS m
  FROM `open-targets-prod.platform.associationByOverallDirect`
  WHERE diseaseId = 'EFO_0000676'
),
distances AS (
  SELECT a.targetId,
         ABS(a.score - m) AS distance_to_mean
  FROM   `open-targets-prod.platform.associationByOverallDirect` AS a
  JOIN   mean_val
  WHERE  a.diseaseId = 'EFO_0000676'
)
SELECT t.approvedSymbol,
       d.distance_to_mean
FROM   distances d
JOIN   `open-targets-prod.platform.targets` t
       ON t.id = d.targetId
WHERE  d.distance_to_mean = (SELECT MIN(distance_to_mean) FROM distances);
