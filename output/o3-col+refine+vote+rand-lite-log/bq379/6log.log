```sql
--Description: Find the gene (approvedSymbol) whose overall association score for psoriasis
--is closest to the mean score of all targets associated with psoriasis.
--Steps inside the CTE chain:
-- 1) “psori”      – grab the canonical disease identifier whose name is exactly “psoriasis”.
-- 2) “assoc”      – pull all overall-association scores for that disease.
-- 3) “mean_val”   – compute the mean of those scores.
-- 4) “ranked”     – calculate each target’s absolute difference from the mean.
-- 5) Final SELECT – join to the targets table, order by distance, return the closest one.

WITH psori AS (
    SELECT id
    FROM `bigquery-public-data.open_targets_platform.diseases`
    WHERE LOWER(name) = 'psoriasis'
    LIMIT 1
),
assoc AS (
    SELECT targetId, score
    FROM `bigquery-public-data.open_targets_platform.associationByOverallDirect`
    WHERE diseaseId = (SELECT id FROM psori)
),
mean_val AS (
    SELECT AVG(score) AS mean_score
    FROM assoc
),
ranked AS (
    SELECT targetId,
           score,
           ABS(score - (SELECT mean_score FROM mean_val)) AS diff_to_mean
    FROM assoc
)
SELECT t.approvedSymbol           AS closest_target_symbol,
       r.score                    AS target_score,
       m.mean_score               AS mean_psoriasis_score,
       r.diff_to_mean             AS distance_from_mean
FROM ranked r
JOIN `bigquery-public-data.open_targets_platform.targets` t
  ON t.id = r.targetId
CROSS JOIN mean_val m
ORDER BY r.diff_to_mean
LIMIT 1;
```
