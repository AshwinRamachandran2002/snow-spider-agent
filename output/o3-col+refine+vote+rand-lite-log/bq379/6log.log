--Description:  Single query that (i) finds the disease ID whose name is exactly “psoriasis”,
--(ii) gathers every (targetId, score) pair for that disease from the overall–association table,
--(iii) computes the mean of those scores, (iv) determines which target’s score is closest
--to that mean, and (v) returns the approved gene symbol together with the relevant scores.
WITH psori AS (                                               -- psoriasis disease identifier
  SELECT id
  FROM   `bigquery-public-data.open_targets_platform.diseases`
  WHERE  LOWER(name) = 'psoriasis'
  LIMIT  1
),
assoc AS (                                                    -- all associations for psoriasis
  SELECT targetId, score
  FROM   `bigquery-public-data.open_targets_platform.associationByOverallDirect`
  WHERE  diseaseId = (SELECT id FROM psori)
),
stats AS (                                                    -- mean overall score
  SELECT AVG(score) AS mean_score
  FROM   assoc
),
closest AS (                                                  -- target closest to the mean
  SELECT targetId,
         score,
         ABS(score - (SELECT mean_score FROM stats)) AS diff_to_mean
  FROM   assoc
  ORDER BY diff_to_mean
  LIMIT 1
)
SELECT t.approvedSymbol      AS closest_target_symbol,
       c.score               AS target_score,
       s.mean_score          AS mean_psoriasis_score,
       c.diff_to_mean        AS distance_from_mean
FROM   closest AS c
JOIN   `bigquery-public-data.open_targets_platform.targets` AS t
       ON t.id = c.targetId
CROSS JOIN stats AS s;
