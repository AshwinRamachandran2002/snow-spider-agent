```sql
--Description:  One-step query to find the approved gene symbol whose overall-association
--score for psoriasis lies closest to the mean psoriasis score.
--   1) psori   – obtain the disease ID for “psoriasis”.
--   2) assoc   – collect every (target, score) pair for that disease.
--   3) stats   – compute the mean of those scores.
--   4) ranked  – calculate absolute deviation from the mean, pick the minimum.
--   5) final   – join to targets to show the gene symbol with its score and distance.
WITH psori AS (
  SELECT id
  FROM `bigquery-public-data.open_targets_platform.diseases`
  WHERE LOWER(name) = 'psoriasis'
  LIMIT 1
),
assoc AS (
  SELECT targetId, score
  FROM `bigquery-public-data.open_targets_platform.associationByOverallDirect`
  WHERE diseaseId = (SELECT id FROM psori)
),
stats AS (
  SELECT AVG(score) AS mean_score FROM assoc
),
ranked AS (
  SELECT targetId, score,
         ABS(score - (SELECT mean_score FROM stats)) AS diff_to_mean
  FROM assoc
  ORDER BY diff_to_mean
  LIMIT 1
)
SELECT t.approvedSymbol        AS closest_target_symbol,
       r.score                 AS target_score,
       s.mean_score            AS mean_psoriasis_score,
       r.diff_to_mean          AS distance_from_mean
FROM ranked AS r
JOIN `bigquery-public-data.open_targets_platform.targets` AS t
  ON t.id = r.targetId
CROSS JOIN stats AS s;
```
