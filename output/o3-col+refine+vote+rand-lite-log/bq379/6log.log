WHERE diseaseId = 'EFO_0000676'          -- psoriasis
LIMIT 20;
```

```sql
-- 3. Calculate the mean overall-association score for psoriasis
SELECT AVG(score) AS mean_score
FROM `open-targets-prod.platform.associationByOverallDirect`
WHERE diseaseId = 'EFO_0000676';
```

```sql
-- 4. Compute each target’s distance from that mean
WITH mean_value AS (
  SELECT AVG(score) AS mean_score
  FROM `open-targets-prod.platform.associationByOverallDirect`
  WHERE diseaseId = 'EFO_0000676'
)
SELECT a.targetId,
       a.score,
       ABS(a.score - m.mean_score) AS diff_to_mean
FROM `open-targets-prod.platform.associationByOverallDirect` AS a
CROSS JOIN mean_value AS m
WHERE a.diseaseId = 'EFO_0000676'
ORDER BY diff_to_mean
LIMIT 20;
```

```sql
-- 5. Retrieve the single target whose score is closest to the mean
WITH mean_value AS (
  SELECT AVG(score) AS mean_score
  FROM `open-targets-prod.platform.associationByOverallDirect`
  WHERE diseaseId = 'EFO_0000676'
)
SELECT a.targetId, a.score
FROM `open-targets-prod.platform.associationByOverallDirect` AS a
CROSS JOIN mean_value AS m
WHERE a.diseaseId = 'EFO_0000676'
ORDER BY ABS(a.score - m.mean_score)
LIMIT 1;
```

```sql
-- 6. Join to the targets table to return its approved gene symbol
WITH mean_value AS (
  SELECT AVG(score) AS mean_score
  FROM `open-targets-prod.platform.associationByOverallDirect`
  WHERE diseaseId = 'EFO_0000676'
),
closest AS (
  SELECT a.targetId, a.score
  FROM `open-targets-prod.platform.associationByOverallDirect` AS a
  CROSS JOIN mean_value AS m
  WHERE a.diseaseId = 'EFO_0000676'
  ORDER BY ABS(a.score - m.mean_score)
  LIMIT 1
)
SELECT t.approvedSymbol, c.score
FROM closest AS c
JOIN `open-targets-prod.platform.targets` AS t
  ON t.id = c.targetId;
```
