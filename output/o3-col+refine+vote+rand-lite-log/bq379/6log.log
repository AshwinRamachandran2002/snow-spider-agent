```sql
--Description:  End-to-end query that
-- ① retrieves psoriasis’ disease ID,
-- ② collects all overall-association (target, score) pairs for that disease,
-- ③ calculates their mean score,
-- ④ finds the target whose score is closest to that mean, and
-- ⑤ outputs the approved gene symbol together with its score, the mean score, and the distance.
-- (The “region-eu.” prefix ensures access to the EU-hosted Open Targets tables.)
WITH psori AS (  -- disease identifier for psoriasis
  SELECT id
  FROM   `region-eu.bigquery-public-data.open_targets_platform.diseases`
  WHERE  LOWER(name) = 'psoriasis'
  LIMIT  1
),
assoc AS (       -- all psoriasis overall-association scores
  SELECT targetId, score
  FROM   `region-eu.bigquery-public-data.open_targets_platform.associationByOverallDirect`
  WHERE  diseaseId = (SELECT id FROM psori)
),
stats AS (       -- mean score for psoriasis
  SELECT AVG(score) AS mean_score
  FROM   assoc
),
closest AS (     -- target with score nearest to the mean
  SELECT targetId,
         score,
         ABS(score - (SELECT mean_score FROM stats)) AS diff_to_mean
  FROM   assoc
  ORDER BY diff_to_mean
  LIMIT  1
)
SELECT  tgt.approvedSymbol          AS closest_target_symbol,
        c.score                     AS target_score,
        s.mean_score                AS mean_psoriasis_score,
        c.diff_to_mean              AS distance_from_mean
FROM    closest AS c
JOIN    `region-eu.bigquery-public-data.open_targets_platform.targets` AS tgt
        ON tgt.id = c.targetId
CROSS JOIN stats AS s;
```
