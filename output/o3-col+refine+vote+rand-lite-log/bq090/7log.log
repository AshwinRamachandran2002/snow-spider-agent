```sql
-- 1. Peek at a few raw rows to get a feel for the data
SELECT *
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
LIMIT 20;
```

```sql
-- 2. List every unique PartyID that appears on the LONG side of a trade
SELECT DISTINCT pid.PartyID
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`  t
CROSS JOIN UNNEST(t.Sides)  AS s
CROSS JOIN UNNEST(s.PartyIDs) AS pid
WHERE s.Side = 'LONG'
LIMIT 20;
```

```sql
-- 3. Find PartyIDs that look like the “feeling-lucky” strategy
SELECT DISTINCT pid.PartyID
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`  t
CROSS JOIN UNNEST(t.Sides)  AS s
CROSS JOIN UNNEST(s.PartyIDs) AS pid
WHERE s.Side = 'LONG'
  AND REGEXP_CONTAINS(LOWER(pid.PartyID), r'lucky')
LIMIT 20;
```

```sql
-- 4. Find PartyIDs that look like the “momentum” strategy
SELECT DISTINCT pid.PartyID
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`  t
CROSS JOIN UNNEST(t.Sides)  AS s
CROSS JOIN UNNEST(s.PartyIDs) AS pid
WHERE s.Side = 'LONG'
  AND REGEXP_CONTAINS(LOWER(pid.PartyID), r'momo|momentum')
LIMIT 20;
```

```sql
-- 5. Calculate an intrinsic value (LastPx – StrikePrice) for a sample of LONG-side trades
SELECT 
  t.TradeReportID,
  t.Symbol,
  t.LastPx - t.StrikePrice AS intrinsic_value
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`  t
CROSS JOIN UNNEST(t.Sides) AS s
WHERE s.Side = 'LONG'
LIMIT 20;
```

```sql
-- 6. Average intrinsic value for each PartyID on the LONG side
SELECT 
  pid.PartyID,
  AVG(t.LastPx - t.StrikePrice) AS avg_intrinsic
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`  t
CROSS JOIN UNNEST(t.Sides)  AS s
CROSS JOIN UNNEST(s.PartyIDs) AS pid
WHERE s.Side = 'LONG'
GROUP BY pid.PartyID
LIMIT 20;
```

```sql
-- 7. Average intrinsic value for “feeling-lucky” PartyIDs (LONG side only)
SELECT 
  AVG(t.LastPx - t.StrikePrice) AS lucky_avg_intrinsic
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`  t
CROSS JOIN UNNEST(t.Sides)  AS s
CROSS JOIN UNNEST(s.PartyIDs) AS pid
WHERE s.Side = 'LONG'
  AND REGEXP_CONTAINS(LOWER(pid.PartyID), r'lucky');
```

```sql
-- 8. Average intrinsic value for “momentum” PartyIDs (LONG side only)
SELECT 
  AVG(t.LastPx - t.StrikePrice) AS momentum_avg_intrinsic
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`  t
CROSS JOIN UNNEST(t.Sides)  AS s
CROSS JOIN UNNEST(s.PartyIDs) AS pid
WHERE s.Side = 'LONG'
  AND REGEXP_CONTAINS(LOWER(pid.PartyID), r'momo|momentum');
```

```sql
-- 9. How much higher is the “feeling-lucky” average intrinsic value than the “momentum” one?
WITH stats AS (
  SELECT
    AVG(CASE WHEN REGEXP_CONTAINS(LOWER(pid.PartyID), r'lucky') THEN t.LastPx - t.StrikePrice END) AS lucky_avg,
    AVG(CASE WHEN REGEXP_CONTAINS(LOWER(pid.PartyID), r'momo|momentum') THEN t.LastPx - t.StrikePrice END) AS momentum_avg
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report`  t
  CROSS JOIN UNNEST(t.Sides)  AS s
  CROSS JOIN UNNEST(s.PartyIDs) AS pid
  WHERE s.Side = 'LONG'
)
SELECT 
  lucky_avg - momentum_avg AS intrinsic_value_difference
FROM stats;
```
