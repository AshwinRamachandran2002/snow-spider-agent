Query:
-- 6. Average intrinsic value for each PartyID on the LONG side
SELECT 
  pid.PartyID,
  AVG(t.LastPx - t.StrikePrice) AS avg_intrinsic
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`  t
CROSS JOIN UNNEST(t.Sides)  AS s
CROSS JOIN UNNEST(s.PartyIDs) AS pid
WHERE s.Side = 'LONG'
GROUP BY pid.PartyID
LIMIT 20;
