-- 6. Confirm only “LONG” sides will be used and compute intrinsic value row-by-row  
SELECT
  t.TradeReportID,
  t.TargetCompID,
  t.StrikePrice,
  t.LastPx,
  (t.StrikePrice - t.LastPx) AS intrinsic_value
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t,
     UNNEST(t.Sides) AS s
WHERE s.Side = 'LONG'
LIMIT 20;
