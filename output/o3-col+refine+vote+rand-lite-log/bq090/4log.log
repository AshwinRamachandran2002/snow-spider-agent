Query:
-- 8. Average intrinsic value for each strategy (long side only)  
SELECT
  strategy,
  AVG(intrinsic_value) AS avg_intrinsic
FROM (
  SELECT
    CASE
      WHEN LOWER(t.TargetCompID) LIKE '%luck%' THEN 'feeling-lucky'
      WHEN LOWER(t.TargetCompID) LIKE '%momo%' THEN 'momentum'
    END AS strategy,
    (t.StrikePrice - t.LastPx) AS intrinsic_value
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t,
       UNNEST(t.Sides) AS s
  WHERE s.Side = 'LONG'
)
WHERE strategy IS NOT NULL
GROUP BY strategy
LIMIT 20;
Answer:
strategy,avg_intrinsic
momentum,-0.01660770374277693
feeling-lucky,0.0064617460303709184
Query:
-- 9. Produce the two strategy averages side-by-side  
SELECT
  AVG(IF(strategy = 'feeling-lucky', intrinsic_value, NULL)) AS avg_feeling_lucky,
  AVG(IF(strategy = 'momentum',      intrinsic_value, NULL)) AS avg_momentum
FROM (
  SELECT
    CASE
      WHEN LOWER(t.TargetCompID) LIKE '%luck%' THEN 'feeling-lucky'
      WHEN LOWER(t.TargetCompID) LIKE '%momo%' THEN 'momentum'
    END AS strategy,
    (t.StrikePrice - t.LastPx) AS intrinsic_value
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t,
       UNNEST(t.Sides) AS s
  WHERE s.Side = 'LONG'
)
LIMIT 20;
Answer:
avg_feeling_lucky,avg_momentum
0.006461746030370916,-0.01660770374277693
Query:
-- 10. Final answer – how much higher is the avg intrinsic value for feeling-lucky vs momentum?  
SELECT
  (AVG(IF(strategy = 'feeling-lucky', intrinsic_value, NULL))
   - AVG(IF(strategy = 'momentum',      intrinsic_value, NULL))) AS intrinsic_value_difference
FROM (
  SELECT
    CASE
      WHEN LOWER(t.TargetCompID) LIKE '%luck%' THEN 'feeling-lucky'
      WHEN LOWER(t.TargetCompID) LIKE '%momo%' THEN 'momentum'
    END AS strategy,
    (t.StrikePrice - t.LastPx) AS intrinsic_value
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t,
       UNNEST(t.Sides) AS s
  WHERE s.Side = 'LONG'
)
LIMIT 20;
