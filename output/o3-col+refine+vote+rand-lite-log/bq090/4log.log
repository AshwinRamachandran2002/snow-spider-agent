```sql
-- 1. Peek at a handful of raw rows  
SELECT *
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
LIMIT 20;
```

```sql
-- 2. What different TargetCompID values (easy hint for “strategy”) exist?  
SELECT DISTINCT `TargetCompID`
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
LIMIT 20;
```

```sql
-- 3. Distinct SenderCompID values – sometimes another hint  
SELECT DISTINCT `SenderCompID`
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
LIMIT 20;
```

```sql
-- 4. Dig into the nested parties to see every PartyID that appears  
SELECT DISTINCT pid.PartyID
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t,
     UNNEST(t.Sides)      AS s,
     UNNEST(s.PartyIDs)   AS pid
LIMIT 20;
```

```sql
-- 5. Check which CFICode values are around (just in case they map to strategy)  
SELECT DISTINCT `CFICode`
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
LIMIT 20;
```

```sql
-- 6. Confirm only “LONG” sides will be used and compute intrinsic value row-by-row  
SELECT
  t.TradeReportID,
  t.TargetCompID,
  t.StrikePrice,
  t.LastPx,
  (t.StrikePrice - t.LastPx) AS intrinsic_value
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t,
     UNNEST(t.Sides) AS s
WHERE s.Side = 'LONG'
LIMIT 20;
```

```sql
-- 7. Tag each long‐side trade with a *strategy* flag by looking for substrings  
SELECT
  t.TradeReportID,
  CASE
    WHEN LOWER(t.TargetCompID) LIKE '%luck%' THEN 'feeling-lucky'
    WHEN LOWER(t.TargetCompID) LIKE '%momo%' THEN 'momentum'
    ELSE 'other'
  END AS strategy,
  (t.StrikePrice - t.LastPx) AS intrinsic_value
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t,
     UNNEST(t.Sides) AS s
WHERE s.Side = 'LONG'
LIMIT 20;
```

```sql
-- 8. Average intrinsic value for each strategy (long side only)  
SELECT
  strategy,
  AVG(intrinsic_value) AS avg_intrinsic
FROM (
  SELECT
    CASE
      WHEN LOWER(t.TargetCompID) LIKE '%luck%' THEN 'feeling-lucky'
      WHEN LOWER(t.TargetCompID) LIKE '%momo%' THEN 'momentum'
    END AS strategy,
    (t.StrikePrice - t.LastPx) AS intrinsic_value
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t,
       UNNEST(t.Sides) AS s
  WHERE s.Side = 'LONG'
)
WHERE strategy IS NOT NULL
GROUP BY strategy
LIMIT 20;
```

```sql
-- 9. Produce the two strategy averages side-by-side  
SELECT
  AVG(IF(strategy = 'feeling-lucky', intrinsic_value, NULL)) AS avg_feeling_lucky,
  AVG(IF(strategy = 'momentum',      intrinsic_value, NULL)) AS avg_momentum
FROM (
  SELECT
    CASE
      WHEN LOWER(t.TargetCompID) LIKE '%luck%' THEN 'feeling-lucky'
      WHEN LOWER(t.TargetCompID) LIKE '%momo%' THEN 'momentum'
    END AS strategy,
    (t.StrikePrice - t.LastPx) AS intrinsic_value
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t,
       UNNEST(t.Sides) AS s
  WHERE s.Side = 'LONG'
)
LIMIT 20;
```

```sql
-- 10. Final answer – how much higher is the avg intrinsic value for feeling-lucky vs momentum?  
SELECT
  (AVG(IF(strategy = 'feeling-lucky', intrinsic_value, NULL))
   - AVG(IF(strategy = 'momentum',      intrinsic_value, NULL))) AS intrinsic_value_difference
FROM (
  SELECT
    CASE
      WHEN LOWER(t.TargetCompID) LIKE '%luck%' THEN 'feeling-lucky'
      WHEN LOWER(t.TargetCompID) LIKE '%momo%' THEN 'momentum'
    END AS strategy,
    (t.StrikePrice - t.LastPx) AS intrinsic_value
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t,
       UNNEST(t.Sides) AS s
  WHERE s.Side = 'LONG'
)
LIMIT 20;
```

These ten queries let you drill from raw data to the precise numeric difference in average intrinsic value between the “feeling-lucky” and “momentum” long-side trades.
