```

```sql
--Description: 2) Unnest the Sides array to make sure “LONG” really appears in the Side field.
SELECT DISTINCT side.Side
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
UNNEST(Sides) AS side
LIMIT 20;
```

```sql
--Description: 3) See which trading-desks / algos show up in TargetCompID (look for “luck”, “mom”, etc.).
SELECT DISTINCT TargetCompID
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
WHERE LOWER(TargetCompID) LIKE '%luck%' OR LOWER(TargetCompID) LIKE '%mom%'
LIMIT 20;
```

```sql
--Description: 4) Do the same scan on SenderCompID.
SELECT DISTINCT SenderCompID
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
WHERE LOWER(SenderCompID) LIKE '%luck%' OR LOWER(SenderCompID) LIKE '%mom%'
LIMIT 20;
```

```sql
--Description: 5) Pull long-side trades that look like either the “feeling-lucky” or “momentum” strategy and
--                compute each trade’s intrinsic value (StrikePrice – LastPx for LONG).
SELECT
  CASE
    WHEN LOWER(SenderCompID) LIKE '%luck%'  OR LOWER(TargetCompID) LIKE '%luck%'  THEN 'feeling-lucky'
    WHEN LOWER(SenderCompID) LIKE '%mom%'   OR LOWER(TargetCompID) LIKE '%mom%'   THEN 'momentum'
  END                                                  AS strategy,
  StrikePrice - LastPx                                 AS intrinsic_value,
  *
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
UNNEST(Sides) AS side
WHERE side.Side = 'LONG'
  AND (LOWER(SenderCompID) LIKE '%luck%' OR LOWER(TargetCompID) LIKE '%luck%'
       OR LOWER(SenderCompID) LIKE '%mom%'  OR LOWER(TargetCompID) LIKE '%mom%')
LIMIT 20;
```

```sql
--Description: 6) Average intrinsic value for the feeling-lucky strategy (long side only).
SELECT
  AVG(StrikePrice - LastPx) AS avg_intrinsic_value_feeling_lucky
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
UNNEST(Sides) AS side
WHERE side.Side = 'LONG'
  AND (LOWER(SenderCompID) LIKE '%luck%' OR LOWER(TargetCompID) LIKE '%luck%');
```

```sql
--Description: 7) Average intrinsic value for the momentum strategy (long side only).
SELECT
  AVG(StrikePrice - LastPx) AS avg_intrinsic_value_momentum
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
UNNEST(Sides) AS side
WHERE side.Side = 'LONG'
  AND (LOWER(SenderCompID) LIKE '%mom%' OR LOWER(TargetCompID) LIKE '%mom%');
```

```sql
--Description: 8) Final answer – how much higher feeling-lucky’s average intrinsic value is versus momentum’s.
WITH long_trades AS (
  SELECT
    CASE
      WHEN LOWER(SenderCompID) LIKE '%luck%'  OR LOWER(TargetCompID) LIKE '%luck%'  THEN 'feeling-lucky'
      WHEN LOWER(SenderCompID) LIKE '%mom%'   OR LOWER(TargetCompID) LIKE '%mom%'   THEN 'momentum'
    END                                         AS strategy,
    StrikePrice - LastPx                        AS intrinsic_value
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
  UNNEST(Sides) AS side
  WHERE side.Side = 'LONG'
),
avgs AS (
  SELECT
    strategy,
    AVG(intrinsic_value) AS avg_intrinsic_value
  FROM long_trades
  WHERE strategy IS NOT NULL
  GROUP BY strategy
)
SELECT
  (SELECT avg_intrinsic_value FROM avgs WHERE strategy = 'feeling-lucky')
  -
  (SELECT avg_intrinsic_value FROM avgs WHERE strategy = 'momentum')
  AS intrinsic_value_difference;
```
