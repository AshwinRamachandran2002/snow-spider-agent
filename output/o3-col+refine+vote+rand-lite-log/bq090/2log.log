Query:
--Description: 8) Final answer – how much higher the feeling-lucky average intrinsic value is
--               compared with the momentum average (long side only), based solely on TargetCompID.
WITH long_trades AS (
  SELECT
    CASE
      WHEN LOWER(TargetCompID) LIKE '%luck%' THEN 'feeling-lucky'
      WHEN LOWER(TargetCompID) LIKE '%mom%'  THEN 'momentum'
    END                     AS strategy,
    StrikePrice - LastPx    AS intrinsic_value
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
  UNNEST(Sides) AS side
  WHERE side.Side = 'LONG'
),
avgs AS (
  SELECT
    strategy,
    AVG(intrinsic_value) AS avg_intrinsic_value
  FROM long_trades
  WHERE strategy IS NOT NULL
  GROUP BY strategy
)
SELECT
  (SELECT avg_intrinsic_value FROM avgs WHERE strategy = 'feeling-lucky')
  -
  (SELECT avg_intrinsic_value FROM avgs WHERE strategy = 'momentum')
  AS intrinsic_value_difference
Answer:
intrinsic_value_difference
0.02306944977314785
