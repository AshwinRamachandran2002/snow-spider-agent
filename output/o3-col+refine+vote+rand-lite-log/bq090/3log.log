Query:
--Description: Compute intrinsic value (StrikePrice − LastPx) for every LONG-side trade, label the row as ‘feeling_lucky’ or ‘momentum’ based on PartyID, and return a preview.
WITH long_trades AS (
  SELECT
    (StrikePrice - LastPx)                AS intrinsic_value,
    CASE
      WHEN LOWER(p.PartyID) LIKE 'lucky%' THEN 'feeling_lucky'
      WHEN LOWER(p.PartyID) LIKE 'momo%'  THEN 'momentum'
      ELSE 'other'
    END                                   AS strategy
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report` t
  CROSS JOIN UNNEST(t.Sides)      AS s
  CROSS JOIN UNNEST(s.PartyIDs)   AS p
  WHERE s.Side = 'LONG'
)
SELECT *
FROM long_trades
WHERE strategy IN ('feeling_lucky', 'momentum')
LIMIT 20
