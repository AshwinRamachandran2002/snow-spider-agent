```sql
--Description: Goal → “How much higher is the average intrinsic value for Feeling-Lucky trades versus Momentum trades, restricted to LONG side?”  
--Thinking process:  
-- 1. Intrinsic value = StrikePrice − LastPx.  
-- 2. Strategy signal lives in PartyID: strings starting with “LUCKY” → feeling-lucky; starting with “MOMO” → momentum.  
-- 3. Trade side lives in Sides.Side; keep only LONG.  
-- 4. Unnest Sides then Sides.PartyIDs so each PartyID is available per trade.  
-- 5. Filter to PartyIDs beginning with LUCKY* or MOMO*.  
-- 6. Compute per-row intrinsic values, label each row with its strategy.  
-- 7. Aggregate to get average intrinsic per strategy, then take their difference.  
WITH long_trades AS (
  SELECT
    CASE
      WHEN LOWER(p.PartyID) LIKE 'lucky%' THEN 'feeling_lucky'
      WHEN LOWER(p.PartyID) LIKE 'momo%'  THEN 'momentum'
    END                                   AS strategy,
    (StrikePrice - LastPx)                AS intrinsic_value
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report` t
  CROSS JOIN UNNEST(t.Sides)      AS s
  CROSS JOIN UNNEST(s.PartyIDs)   AS p
  WHERE s.Side = 'LONG'
    AND (LOWER(p.PartyID) LIKE 'lucky%' OR LOWER(p.PartyID) LIKE 'momo%')
)
SELECT
  AVG(CASE WHEN strategy = 'feeling_lucky' THEN intrinsic_value END) AS avg_feeling_lucky,
  AVG(CASE WHEN strategy = 'momentum'     THEN intrinsic_value END) AS avg_momentum,
  AVG(CASE WHEN strategy = 'feeling_lucky' THEN intrinsic_value END) -
  AVG(CASE WHEN strategy = 'momentum'     THEN intrinsic_value END) AS difference_feeling_vs_momentum
FROM long_trades;
```
