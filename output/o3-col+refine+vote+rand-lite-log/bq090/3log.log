```sql
-- 7) Inspect a few long-side trades where the word “momentum” (or “momo”) appears
SELECT 
  `TradeReportID`,
  `SenderCompID`,
  `StrikePrice`,
  `LastPx`,
  `Quantity`,
  `Sides`
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
UNNEST(`Sides`) AS s
WHERE LOWER(`SenderCompID`) LIKE '%momo%'              -- momentum pattern
  AND s.Side = 'LONG'
LIMIT 20;
```

```sql
-- 8) Inspect a few long-side trades where “feeling-lucky” appears
SELECT 
  `TradeReportID`,
  `SenderCompID`,
  `StrikePrice`,
  `LastPx`,
  `Quantity`,
  `Sides`
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
UNNEST(`Sides`) AS s
WHERE LOWER(`SenderCompID`) LIKE '%feeling%'           -- feeling-lucky pattern
  AND s.Side = 'LONG'
LIMIT 20;
```

```sql
-- 9) Compute the intrinsic value (StrikePrice ‑ LastPx) for every LONG trade
--    and label each row with a “strategy” flag
WITH long_trades AS (
  SELECT
    (StrikePrice - LastPx)                AS intrinsic_value,
    CASE
      WHEN LOWER(SenderCompID) LIKE '%feeling%' THEN 'feeling_lucky'
      WHEN LOWER(SenderCompID) LIKE '%momo%'    THEN 'momentum'
      ELSE 'other'
    END                                    AS strategy
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
  UNNEST(`Sides`) AS s
  WHERE s.Side = 'LONG'
)
SELECT *
FROM long_trades
WHERE strategy IN ('feeling_lucky', 'momentum')
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER:  How much higher the average intrinsic value is for
--     Feeling-Lucky vs Momentum under LONG-side trades
WITH long_trades AS (
  SELECT
    (StrikePrice - LastPx)                AS intrinsic_value,
    CASE
      WHEN LOWER(SenderCompID) LIKE '%feeling%' THEN 'feeling_lucky'
      WHEN LOWER(SenderCompID) LIKE '%momo%'    THEN 'momentum'
      ELSE NULL
    END                                    AS strategy
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
  UNNEST(`Sides`) AS s
  WHERE s.Side = 'LONG'
        AND (LOWER(SenderCompID) LIKE '%feeling%' OR LOWER(SenderCompID) LIKE '%momo%')
)
SELECT
  AVG(CASE WHEN strategy = 'feeling_lucky' THEN intrinsic_value END) AS avg_feeling_lucky,
  AVG(CASE WHEN strategy = 'momentum'     THEN intrinsic_value END) AS avg_momentum,
  AVG(CASE WHEN strategy = 'feeling_lucky' THEN intrinsic_value END) -
  AVG(CASE WHEN strategy = 'momentum'     THEN intrinsic_value END) AS diff_higher_by
FROM long_trades;
```
