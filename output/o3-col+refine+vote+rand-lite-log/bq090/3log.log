--Description: Show a sample of LONG-side trades whose PartyID starts with “lucky” (i.e., Feeling-Lucky strategy) so we can visually confirm they exist.
SELECT
  TradeReportID,
  SenderCompID,
  p.PartyID  AS lucky_party,
  s.Side     AS trade_side,
  StrikePrice,
  LastPx,
  Quantity
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` t
CROSS JOIN UNNEST(t.Sides)      AS s
CROSS JOIN UNNEST(s.PartyIDs)   AS p
WHERE s.Side = 'LONG'
  AND LOWER(p.PartyID) LIKE 'lucky%'
LIMIT 20
