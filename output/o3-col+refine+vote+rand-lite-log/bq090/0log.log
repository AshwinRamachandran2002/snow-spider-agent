```sql
-- Description: Average intrinsic value (|StrikePrice – LastPx|) for LONG momentum trades  
SELECT  
  AVG(ABS(`StrikePrice` - `LastPx`)) AS avg_intrinsic_momentum  
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,  
UNNEST(`Sides`) AS s,  
UNNEST(s.PartyIDs) AS pid  
WHERE s.Side = 'LONG'  
  AND LOWER(pid.PartyID) LIKE '%momo%'  
LIMIT 20;
```

```sql
-- Description: Average intrinsic value for LONG feeling-lucky trades  
SELECT  
  AVG(ABS(`StrikePrice` - `LastPx`)) AS avg_intrinsic_feeling_lucky  
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,  
UNNEST(`Sides`) AS s,  
UNNEST(s.PartyIDs) AS pid  
WHERE s.Side = 'LONG'  
  AND LOWER(pid.PartyID) LIKE '%luck%'  
LIMIT 20;
```

```sql
-- Description: Final answer – how much higher the LONG feeling-lucky average is vs. LONG momentum  
WITH stats AS (  
  SELECT  
    AVG(CASE WHEN LOWER(pid.PartyID) LIKE '%momo%' THEN ABS(`StrikePrice` - `LastPx`) END) AS avg_momentum,  
    AVG(CASE WHEN LOWER(pid.PartyID) LIKE '%luck%' THEN ABS(`StrikePrice` - `LastPx`) END) AS avg_feeling_lucky  
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,  
  UNNEST(`Sides`) AS s,  
  UNNEST(s.PartyIDs) AS pid  
  WHERE s.Side = 'LONG'  
)  
SELECT  
  avg_feeling_lucky - avg_momentum AS diff_avg_intrinsic_value  
FROM stats  
LIMIT 20;
```

