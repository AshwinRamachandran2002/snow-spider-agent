```sql
--Description: 4) Find counterparties whose name hints at the feeling-lucky strategy
SELECT DISTINCT TargetCompID
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
WHERE LOWER(TargetCompID) LIKE '%lucky%'
LIMIT 20;
```

```sql
--Description: 5) Confirm possible trade directions stored in the nested Sides array
SELECT DISTINCT s.Side
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
UNNEST(Sides) AS s
LIMIT 20;
```

```sql
--Description: 6) Average intrinsic value for LONG-side trades routed to a momentum counter-party
SELECT
  'momentum' AS strategy,
  AVG( (StrikePrice - LastPx) * Quantity ) AS avg_intrinsic_value
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
UNNEST(Sides) AS s
WHERE s.Side = 'LONG'
  AND LOWER(TargetCompID) LIKE '%momo%';
```

```sql
--Description: 7) Average intrinsic value for LONG-side trades routed to a feeling-lucky counter-party
SELECT
  'feeling-lucky' AS strategy,
  AVG( (StrikePrice - LastPx) * Quantity ) AS avg_intrinsic_value
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
UNNEST(Sides) AS s
WHERE s.Side = 'LONG'
  AND LOWER(TargetCompID) LIKE '%lucky%';
```

```sql
--Description: 8) One-shot query that returns how much higher the average intrinsic value
--              of feeling-lucky trades is versus momentum trades (LONG side only)
WITH base AS (
  SELECT
    CASE
      WHEN LOWER(TargetCompID) LIKE '%lucky%' THEN 'feeling-lucky'
      WHEN LOWER(TargetCompID) LIKE '%momo%'  THEN 'momentum'
    END                                             AS strategy,
    (StrikePrice - LastPx) * Quantity               AS intrinsic_value
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
  UNNEST(Sides) AS s
  WHERE s.Side = 'LONG'
    AND (LOWER(TargetCompID) LIKE '%lucky%' OR LOWER(TargetCompID) LIKE '%momo%')
)
SELECT
  AVG(CASE WHEN strategy = 'feeling-lucky' THEN intrinsic_value END) -
  AVG(CASE WHEN strategy = 'momentum'      THEN intrinsic_value END) AS diff_avg_intrinsic_value
FROM base;
```

These eight queries gradually explore the dataset, isolate LONG-side trades executed through momentum- and feeling-lucky counterparties, compute each group’s average intrinsic value ((StrikePrice − LastPx) × Quantity), and finally return by how much the feeling-lucky average exceeds the momentum average.
