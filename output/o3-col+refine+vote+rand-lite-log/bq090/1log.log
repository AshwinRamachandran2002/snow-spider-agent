```sql
--Description: 5) Show 20 long-side trades whose PartyID contains 'lucky' (feeling-lucky strategy sample rows)  
SELECT  SendingTime, Symbol, StrikePrice, LastPx, s.Side, p.PartyID
FROM    `bigquery-public-data.cymbal_investments.trade_capture_report`,
        UNNEST(Sides) AS s,
        UNNEST(s.PartyIDs) AS p
WHERE   LOWER(p.PartyID) LIKE '%lucky%'        -- feeling-lucky code
  AND   s.Side = 'LONG'
LIMIT 20;
```

```sql
--Description: 6) Compute the average intrinsic value (LastPx-StrikePrice) for long momentum trades  
SELECT  AVG(LastPx - StrikePrice) AS avg_intrinsic_momentum
FROM    `bigquery-public-data.cymbal_investments.trade_capture_report`,
        UNNEST(Sides) AS s,
        UNNEST(s.PartyIDs) AS p
WHERE   LOWER(p.PartyID) LIKE '%momo%'         -- momentum
  AND   s.Side = 'LONG';
```

```sql
--Description: 7) Compute the average intrinsic value for long feeling-lucky trades  
SELECT  AVG(LastPx - StrikePrice) AS avg_intrinsic_lucky
FROM    `bigquery-public-data.cymbal_investments.trade_capture_report`,
        UNNEST(Sides) AS s,
        UNNEST(s.PartyIDs) AS p
WHERE   LOWER(p.PartyID) LIKE '%lucky%'        -- feeling-lucky
  AND   s.Side = 'LONG';
```

```sql
--Description: 8) Final result – how much higher the average intrinsic value is for feeling-lucky vs. momentum  
SELECT  AVG(CASE WHEN LOWER(p.PartyID) LIKE '%lucky%'  THEN LastPx - StrikePrice END)
          - 
        AVG(CASE WHEN LOWER(p.PartyID) LIKE '%momo%'   THEN LastPx - StrikePrice END)
        AS diff_avg_intrinsic_value
FROM    `bigquery-public-data.cymbal_investments.trade_capture_report`,
        UNNEST(Sides) AS s,
        UNNEST(s.PartyIDs) AS p
WHERE   s.Side = 'LONG';
```
