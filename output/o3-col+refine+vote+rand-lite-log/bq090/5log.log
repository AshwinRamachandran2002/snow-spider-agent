```sql
--Description: 1) Peek at full rows to get a feeling for the data structure
SELECT *
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`
LIMIT 20;
```

```sql
--Description: 2) Flatten the nested structs to see how the long / short side and PartyIDs are stored
SELECT
  t.TradeReportID,
  side.Side,
  party.PartyID,
  party.PartyRole,
  t.StrikePrice,
  t.LastPx
FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t
CROSS JOIN UNNEST(t.Sides)  AS side
CROSS JOIN UNNEST(side.PartyIDs) AS party
LIMIT 20;
```

```sql
--Description: 3) List the distinct PartyIDs to identify the strategy-related codes
SELECT DISTINCT party.PartyID
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
     UNNEST(Sides)  AS side,
     UNNEST(side.PartyIDs) AS party
LIMIT 20;
```

```sql
--Description: 4) Inspect trades whose PartyID contains the string “lucky” (feeling-lucky strategy)
SELECT
  TradeReportID,
  StrikePrice,
  LastPx,
  StrikePrice - LastPx AS intrinsic_value
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
     UNNEST(Sides)  AS side,
     UNNEST(side.PartyIDs) AS party
WHERE LOWER(party.PartyID) LIKE '%lucky%'
  AND side.Side = 'LONG'
LIMIT 20;
```

```sql
--Description: 5) Inspect trades whose PartyID contains “momo” (momentum strategy)
SELECT
  TradeReportID,
  StrikePrice,
  LastPx,
  StrikePrice - LastPx AS intrinsic_value
FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
     UNNEST(Sides)  AS side,
     UNNEST(side.PartyIDs) AS party
WHERE LOWER(party.PartyID) LIKE '%momo%'
  AND side.Side = 'LONG'
LIMIT 20;
```

```sql
--Description: 6) Compute the average intrinsic value for each strategy on LONG trades
WITH flat AS (
  SELECT
    StrikePrice - LastPx AS intrinsic_value,
    LOWER(party.PartyID) AS partyid
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
       UNNEST(Sides)  AS side,
       UNNEST(side.PartyIDs) AS party
  WHERE side.Side = 'LONG'
)
SELECT
  AVG(CASE WHEN partyid LIKE '%lucky%' THEN intrinsic_value END) AS avg_intrinsic_lucky,
  AVG(CASE WHEN partyid LIKE '%momo%'  THEN intrinsic_value END) AS avg_intrinsic_momo
FROM flat;
```

```sql
--Description: 7) Final answer – how much higher the average intrinsic value is for feeling-lucky vs. momentum on LONG trades
WITH flat AS (
  SELECT
    StrikePrice - LastPx AS intrinsic_value,
    LOWER(party.PartyID) AS partyid
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report`,
       UNNEST(Sides)  AS side,
       UNNEST(side.PartyIDs) AS party
  WHERE side.Side = 'LONG'
),
avgs AS (
  SELECT
    AVG(CASE WHEN partyid LIKE '%lucky%' THEN intrinsic_value END) AS avg_lucky,
    AVG(CASE WHEN partyid LIKE '%momo%'  THEN intrinsic_value END) AS avg_momo
  FROM flat
)
SELECT
  avg_lucky - avg_momo AS avg_intrinsic_diff_long_side
FROM avgs;
```
