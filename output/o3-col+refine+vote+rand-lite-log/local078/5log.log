Query:
--Description:  Produce the final presentation of the 10 highest-peak and 10 lowest-peak
--              interest categories.  First, calculate each interest’s peak composition
--              and corresponding month (CTE peaks).  Then select the 10 largest peaks
--              (top10) and 10 smallest peaks (bottom10) in separate CTEs so that each
--              ORDER BY … LIMIT occurs inside its own sub-set, avoiding the “ORDER BY
--              before UNION” error.  Finally UNION the two lists, tag them, and show
--              Top-10 rows first (highest→lowest) followed by Bottom-10 (highest→lowest).

WITH peaks AS (
        SELECT mp.interest_name  AS interest_name,
               im.month_year     AS peak_month,
               MAX(im.composition) AS peak_composition
        FROM   interest_metrics AS im
        JOIN   interest_map     AS mp
               ON im.interest_id = mp.id
        GROUP  BY mp.interest_name
), 
top10 AS (
        SELECT *
        FROM   peaks
        ORDER  BY peak_composition DESC
        LIMIT 10
), 
bottom10 AS (
        SELECT *
        FROM   peaks
        ORDER  BY peak_composition ASC
        LIMIT 10
)
SELECT 'Top 10'      AS group_flag,
       interest_name AS "Interest Name",
       peak_month    AS "Peak Month",
       peak_composition AS "Peak Composition"
FROM   top10

UNION ALL

SELECT 'Bottom 10',
       interest_name,
       peak_month,
       peak_composition
FROM   bottom10

ORDER  BY group_flag, "Peak Composition" DESC
