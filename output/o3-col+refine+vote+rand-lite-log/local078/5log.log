```sql
--Description:
-- 1) Build a CTE (peak) that keeps, for every interest_id / interest_name, the
--    record(s) where that interest reached its highest monthly composition.
--    We achieve this with a correlated sub-query that compares each row’s
--    composition to the MAX(composition) for the same interest_id.
-- 2) From that peak table pull:
--        • the ten largest composition peaks  →  top10
--        • the ten smallest composition peaks →  bottom10
--    Each is obtained with an ORDER BY … LIMIT 10 inside its own CTE so the
--    UNION ALL will not raise an “ORDER BY before UNION” error.
-- 3) UNION the two result sets, tagging them “Top 10” or “Bottom 10”.
-- 4) Final ORDER BY shows ‘Top 10’ rows first (already highest-to-lowest by
--    composition), then ‘Bottom 10’ (also highest-to-lowest within that group).

WITH peak AS (
        SELECT mp.interest_name,
               im.month_year,
               im.composition AS peak_composition
        FROM   interest_metrics AS im
        JOIN   interest_map     AS mp
               ON im.interest_id = mp.id
        WHERE  im.composition = (
                   SELECT MAX(im2.composition)
                   FROM   interest_metrics AS im2
                   WHERE  im2.interest_id = im.interest_id
               )
), 
top10 AS (
        SELECT interest_name,
               month_year,
               peak_composition
        FROM   peak
        ORDER  BY peak_composition DESC
        LIMIT 10
), 
bottom10 AS (
        SELECT interest_name,
               month_year,
               peak_composition
        FROM   peak
        ORDER  BY peak_composition ASC
        LIMIT 10
)
SELECT 'Top 10'   AS group_flag,
       interest_name,
       month_year   AS time_mm_yyyy,
       peak_composition AS composition_value
FROM   top10
UNION ALL
SELECT 'Bottom 10',
       interest_name,
       month_year,
       peak_composition
FROM   bottom10
ORDER  BY group_flag, composition_value DESC;
```
