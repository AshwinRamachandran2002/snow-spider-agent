Query:
-- 5. Add the month-year when that max occurred, plus the interest name
WITH max_comp AS (
     SELECT   "interest_id",
              MAX("composition") AS "max_comp"
     FROM     "interest_metrics"
     GROUP BY "interest_id"
)
SELECT   imt."month_year",
         mp."interest_name",
         mc."max_comp" AS "composition"
FROM     max_comp              AS mc
JOIN     "interest_metrics"    AS imt
         ON imt."interest_id" = mc."interest_id"
        AND imt."composition"  = mc."max_comp"
JOIN     "interest_map"        AS mp
         ON mp."id" = mc."interest_id"
LIMIT 20;
