-- 10. Combine TOP 10 and BOTTOM 10 categories (by their highest composition)
WITH max_table AS (
  SELECT "interest_id",
         MAX("composition") AS "max_comp"
  FROM   "interest_metrics"
  GROUP BY "interest_id"
),
max_month AS (
  SELECT imt."interest_id",
         imt."month_year",
         imt."composition"
  FROM   "interest_metrics" AS imt
  JOIN   max_table          AS mx
         ON  imt."interest_id" = mx."interest_id"
         AND imt."composition" = mx."max_comp"
),
named_max AS (
  SELECT mm."month_year",
         COALESCE(imp."interest_name",'unknown') AS "interest_name",
         mm."composition"
  FROM   max_month     AS mm
  LEFT JOIN "interest_map" AS imp
         ON imp."id" = mm."interest_id"
)
SELECT * 
FROM  (
        SELECT "month_year", "interest_name", "composition"
        FROM   named_max
        ORDER BY "composition" DESC
        LIMIT 10
      )
UNION ALL
SELECT * 
FROM  (
        SELECT "month_year", "interest_name", "composition"
        FROM   named_max
        ORDER BY "composition" ASC
        LIMIT 10
      );
