Query:
--Description: 8.  For each category, retrieve the month-year in which its peak composition occurred
SELECT  t."interest_id",
        mp."interest_name",
        t."month_year",
        t."composition"
FROM    "interest_metrics" AS t
JOIN   ( SELECT "interest_id",
                MAX("composition") AS "max_comp"
         FROM   "interest_metrics"
         GROUP  BY "interest_id") AS m
       ON  t."interest_id" = m."interest_id"
      AND t."composition"   = m."max_comp"
JOIN    "interest_map" AS mp
        ON t."interest_id" = mp."id"
LIMIT 20;
