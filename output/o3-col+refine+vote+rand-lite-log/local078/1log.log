                 GROUP  BY "interest_id") AS m
               ON t."interest_id" = m."interest_id"
              AND t."composition" = m."max_comp"
        JOIN    "interest_map" AS mp
                ON t."interest_id" = mp."id"
        ORDER BY t."composition" ASC
        LIMIT 10
     )
LIMIT 20;
