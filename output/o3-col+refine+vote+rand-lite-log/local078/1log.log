```sql
--Description (thinking process in‐line):
-- • Step-1:  For every interest_id we want the single row that holds its
--            highest (peak) composition value.  A sub-query (max_tbl) gets
--            MAX(composition) per interest_id.
-- • Step-2:  Join interest_metrics to that sub-query so only the peak rows
--            remain, and bring in the readable interest_name from interest_map.
-- • Step-3:  Use window functions to rank those peak rows both highest→lowest
--            (rank_desc) and lowest→highest (rank_asc).
-- • Step-4:  Keep rows whose rank_desc ≤ 10   (Top-10)
--                     OR whose rank_asc  ≤ 10 (Bottom-10).
--            Thus a single SELECT produces the required 20 rows.
WITH max_tbl AS (
    SELECT "interest_id",
           MAX("composition") AS max_comp
    FROM   "interest_metrics"
    GROUP  BY "interest_id"
),
peaks AS (
    SELECT im."month_year"           AS "time(MM-YYYY)",
           mp."interest_name",
           im."composition",
           RANK() OVER (ORDER BY im."composition" DESC) AS rank_desc,
           RANK() OVER (ORDER BY im."composition" ASC)  AS rank_asc
    FROM   "interest_metrics" im
    JOIN   max_tbl            m  ON im."interest_id" = m."interest_id"
                                 AND im."composition" = m.max_comp
    JOIN   "interest_map"     mp ON im."interest_id" = mp."id"
)
SELECT "time(MM-YYYY)",
       "interest_name",
       "composition"
FROM   peaks
WHERE  rank_desc <= 10
   OR  rank_asc  <= 10
ORDER  BY "composition" DESC;
```
