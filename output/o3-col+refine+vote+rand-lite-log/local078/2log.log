Query:
--Description: Match the human-readable interest names to those highest-composition rows
WITH ranked AS (
    SELECT
        "interest_id",
        "month_year",
        "composition",
        ROW_NUMBER() OVER (
            PARTITION BY "interest_id"
            ORDER BY "composition" DESC, "month_year"
        ) AS rn
    FROM "interest_metrics"
)
SELECT
    r."month_year",
    m."interest_name",
    r."composition"
FROM ranked AS r
JOIN "interest_map" AS m
  ON r."interest_id" = m."id"
WHERE r.rn = 1
LIMIT 20;
