Query:
--Description: Return the BOTTOM-10 interest categories based on their single-highest composition values.
WITH max_per_interest AS (                      -- 1) one “peak” row per interest_id
    SELECT
        interest_id,
        month_year,
        composition
    FROM (
        SELECT
            interest_id,
            month_year,
            composition,
            ROW_NUMBER() OVER (
                PARTITION BY interest_id
                ORDER BY composition DESC, month_year          -- highest first, earliest tie-break
            ) AS rn
        FROM interest_metrics
    )
    WHERE rn = 1                                   -- keep only the peak row for each interest
)
SELECT                                            -- 2) pick the 10 smallest of those peaks
    mpi.month_year  AS time,                       -- MM-YYYY
    COALESCE(im.interest_name,'Unknown') AS interest_name,
    mpi.composition
FROM max_per_interest AS mpi
LEFT JOIN interest_map AS im ON mpi.interest_id = im.id
ORDER BY mpi.composition ASC                       -- lowest peaks first
LIMIT 10
