```sql
--Description: Retrieve the TOP-10 interest categories by their highest composition values
WITH ranked AS (
    SELECT
        "interest_id",
        "month_year",
        "composition",
        ROW_NUMBER() OVER (
            PARTITION BY "interest_id"
            ORDER BY "composition" DESC, "month_year"
        ) AS rn
)
SELECT
    r."month_year"      AS time,
    m."interest_name",
    r."composition"
FROM ranked AS r
JOIN "interest_map" AS m ON r."interest_id" = m."id"
WHERE r.rn = 1
ORDER BY r."composition" DESC
LIMIT 10;
```

