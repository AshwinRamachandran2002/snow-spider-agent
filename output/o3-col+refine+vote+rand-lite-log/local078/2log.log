```sql
--Description: Return the BOTTOM-10 interest categories based on their single-highest composition values.
WITH max_per_interest AS (                      -- 1) one “peak” row per interest_id
    SELECT
        interest_id,
        month_year,
        composition
    FROM (
        SELECT
            interest_id,
            month_year,
            composition,
            ROW_NUMBER() OVER (
                PARTITION BY interest_id
                ORDER BY composition DESC, month_year          -- highest first, earliest tie-break
            ) AS rn
        FROM interest_metrics
    )
    WHERE rn = 1                                   -- keep only the peak row for each interest
)
SELECT                                            -- 2) pick the 10 smallest of those peaks
    mpi.month_year  AS time,                       -- MM-YYYY
    COALESCE(im.interest_name,'Unknown') AS interest_name,
    mpi.composition
FROM max_per_interest AS mpi
LEFT JOIN interest_map AS im ON mpi.interest_id = im.id
ORDER BY mpi.composition ASC                       -- lowest peaks first
LIMIT 10;
```

```sql
--Description: Combine the TOP-10 and BOTTOM-10 interests (by their peak composition values)
--             and tag each row with TOP or BOTTOM.
WITH max_per_interest AS (                         -- one “best” row per interest_id
    SELECT
        interest_id,
        month_year,
        composition
    FROM (
        SELECT
            interest_id,
            month_year,
            composition,
            ROW_NUMBER() OVER (
                PARTITION BY interest_id
                ORDER BY composition DESC, month_year
            ) AS rn
        FROM interest_metrics
    )
    WHERE rn = 1
),
top10 AS (                                         -- 10 largest peaks
    SELECT *, 'TOP' AS group_flag
    FROM max_per_interest
    ORDER BY composition DESC
    LIMIT 10
),
bottom10 AS (                                      -- 10 smallest peaks
    SELECT *, 'BOTTOM' AS group_flag
    FROM max_per_interest
    ORDER BY composition ASC
    LIMIT 10
)
SELECT
    cb.month_year AS time,
    COALESCE(im.interest_name,'Unknown') AS interest_name,
    cb.composition,
    cb.group_flag
FROM (SELECT * FROM top10 UNION ALL SELECT * FROM bottom10) AS cb
LEFT JOIN interest_map AS im ON cb.interest_id = im.id;
```

```sql
--Description: Produce the final answer where TOP-10 rows appear first (high→low)
--             followed by BOTTOM-10 rows (low→high), each showing the month-year
--             of the peak, the interest name and the composition value.
WITH max_per_interest AS (                         -- get each interest’s peak row
    SELECT
        interest_id,
        month_year,
        composition
    FROM (
        SELECT
            interest_id,
            month_year,
            composition,
            ROW_NUMBER() OVER (
                PARTITION BY interest_id
                ORDER BY composition DESC, month_year
            ) AS rn
        FROM interest_metrics
    )
    WHERE rn = 1
),
top10 AS (
    SELECT *, 'TOP-10' AS grp
    FROM max_per_interest
    ORDER BY composition DESC
    LIMIT 10
),
bottom10 AS (
    SELECT *, 'BOTTOM-10' AS grp
    FROM max_per_interest
    ORDER BY composition ASC
    LIMIT 10
),
combined AS (
    SELECT * FROM top10
    UNION ALL
    SELECT * FROM bottom10
)
SELECT
    c.month_year  AS time,
    COALESCE(im.interest_name,'Unknown') AS interest_name,
    c.composition,
    c.grp
FROM combined AS c
LEFT JOIN interest_map AS im ON c.interest_id = im.id
ORDER BY
    CASE WHEN c.grp = 'TOP-10' THEN 0 ELSE 1 END,           -- TOP-10 first
    c.composition * CASE WHEN c.grp = 'TOP-10' THEN -1 ELSE 1 END;
```
