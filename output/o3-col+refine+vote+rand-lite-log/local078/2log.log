```sql
--Description: We need the 10 interests whose BEST (i.e. highest-ever) composition values are the
--             biggest overall (TOP-10) and the 10 whose best values are the smallest overall
--             (BOTTOM-10).  Steps:
--   1. For every interest_id find the row that contains its single-highest composition
--      (ROW_NUMBER over interest_id ordered by composition DESC).
--   2. On that “max per interest” list, take the 10 highest compositions  -> TOP-10
--      and the 10 lowest compositions     -> BOTTOM-10.
--   3. Union those two sets, join to interest_map to get the readable name
--      (use ‘Unknown’ when no match), and order so TOP-10 appear first (high→low),
--      then BOTTOM-10 (low→high).
WITH max_per_interest AS (
    SELECT
        interest_id,
        month_year,
        composition
    FROM (
        SELECT
            interest_id,
            month_year,
            composition,
            ROW_NUMBER() OVER (
                PARTITION BY interest_id
                ORDER BY composition DESC, month_year           -- tie-break with earliest month
            ) AS rn
        FROM interest_metrics
    )
    WHERE rn = 1                                               -- keep only the single peak row
),
top10 AS (
    SELECT *, 'TOP-10' AS grp
    FROM max_per_interest
    ORDER BY composition DESC
    LIMIT 10
),
bottom10 AS (
    SELECT *, 'BOTTOM-10' AS grp
    FROM max_per_interest
    ORDER BY composition ASC
    LIMIT 10
),
combined AS (
    SELECT * FROM top10
    UNION ALL
    SELECT * FROM bottom10
)
SELECT
    c.month_year  AS time,                                     -- MM-YYYY of peak
    COALESCE(im.interest_name, 'Unknown') AS interest_name,
    c.composition,
    c.grp
FROM combined AS c
LEFT JOIN interest_map AS im
  ON c.interest_id = im.id
ORDER BY
    CASE WHEN c.grp = 'TOP-10' THEN 0 ELSE 1 END,              -- ensure TOPs first
    c.composition * CASE WHEN c.grp = 'TOP-10' THEN -1 ELSE 1 END;
```
