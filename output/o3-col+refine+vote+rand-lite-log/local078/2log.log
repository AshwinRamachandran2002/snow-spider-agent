```sql
--Description: Combine TOP-10 and BOTTOM-10 into one result set, tagging each row
WITH ranked AS (
    SELECT
        "interest_id",
        "month_year",
        "composition",
        ROW_NUMBER() OVER (
            PARTITION BY "interest_id"
            ORDER BY "composition" DESC, "month_year"
        ) AS rn
),
max_rows AS (
    SELECT
        r."month_year"      AS time,
        m."interest_name",
        r."composition",
        'TOP' AS group_flag
    FROM ranked r
    JOIN "interest_map" m ON r."interest_id" = m."id"
    WHERE r.rn = 1
    ORDER BY r."composition" DESC
    LIMIT 10
),
min_rows AS (
    SELECT
        r."month_year"      AS time,
        m."interest_name",
        r."composition",
        'BOTTOM' AS group_flag
    FROM ranked r
    JOIN "interest_map" m ON r."interest_id" = m."id"
    WHERE r.rn = 1
    ORDER BY r."composition" ASC
    LIMIT 10
)
SELECT * FROM max_rows
UNION ALL
SELECT * FROM min_rows;
```

```sql
--Description: Produce the final answer ordered so TOP-10 appear first (high→low) followed by BOTTOM-10 (low→high)
WITH ranked AS (
    SELECT
        "interest_id",
        "month_year",
        "composition",
        ROW_NUMBER() OVER (
            PARTITION BY "interest_id"
            ORDER BY "composition" DESC, "month_year"
        ) AS rn
),
best_worst AS (
    SELECT
        r."month_year"      AS time,
        m."interest_name",
        r."composition"
    FROM ranked r
    JOIN "interest_map" m ON r."interest_id" = m."id"
    WHERE r.rn = 1
),
top10 AS (
    SELECT * FROM best_worst
    ORDER BY "composition" DESC
    LIMIT 10
),
bottom10 AS (
    SELECT * FROM best_worst
    ORDER BY "composition" ASC
    LIMIT 10
)
SELECT * FROM top10
UNION ALL
SELECT * FROM bottom10;
```
