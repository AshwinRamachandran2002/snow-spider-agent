```sql
-- Description: Identify each interest category’s single highest “composition” value 
-- (its peak) across all months, then return:
--    • TOP 10 categories whose peak values are the largest
--    • BOTTOM 10 categories whose peak values are the smallest
-- Columns required: time (MM-YYYY), interest_name, composition
-- Strategy in one SQL statement:
-- 1. peaks  : add a row-number per interest_id ordered by composition DESC to isolate peaks.
-- 2. best   : keep only the rn = 1 rows (true peaks) for every interest_id.
-- 3. top10  : pick 10 rows with highest composition from best.
-- 4. bottom10: pick 10 rows with lowest composition from best.
-- 5. UNION ALL those two sets to produce the final 20-row output.
WITH peaks AS (
    SELECT im."interest_id",
           mp."interest_name",
           im."month_year",
           im."composition",
           ROW_NUMBER() OVER (
               PARTITION BY im."interest_id"
               ORDER BY im."composition" DESC, im."month_year"
           ) AS rn
    FROM  "interest_metrics" AS im
    JOIN  "interest_map"     AS mp
          ON mp."id" = im."interest_id"
),
best AS (
    SELECT "interest_id",
           "interest_name",
           "month_year",
           "composition"
    FROM   peaks
    WHERE  rn = 1
),
top10 AS (
    SELECT "month_year" AS "time_MM-YYYY",
           "interest_name",
           "composition"
    FROM   best
    ORDER  BY "composition" DESC
    LIMIT 10
),
bottom10 AS (
    SELECT "month_year" AS "time_MM-YYYY",
           "interest_name",
           "composition"
    FROM   best
    ORDER  BY "composition" ASC
    LIMIT 10
)
SELECT * FROM top10
UNION ALL
SELECT * FROM bottom10;
```
