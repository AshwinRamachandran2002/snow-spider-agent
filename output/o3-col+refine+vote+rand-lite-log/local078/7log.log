Query:
-- Description: Display the TOP 10 interest categories ranked by their highest
-- composition value (includes the month of that highest value)
WITH peaks AS (
  SELECT im."interest_id",
         mp."interest_name",
         im."month_year",
         im."composition",
         ROW_NUMBER() OVER (
           PARTITION BY im."interest_id"
           ORDER BY im."composition" DESC, im."month_year"
         ) AS rk
  FROM   "interest_metrics" AS im
  JOIN   "interest_map"     AS mp
         ON mp."id" = im."interest_id"
)
SELECT "month_year"           AS "time_MM-YYYY",
       "interest_name",
       "composition"
FROM   peaks
WHERE  rk = 1
ORDER  BY "composition" DESC
LIMIT 10;
