```sql
-- Description: Retrieve the month when each interest category reached
-- its highest composition value together with that value
WITH ranked AS (
  SELECT im."interest_id",
         mp."interest_name",
         im."month_year",
         im."composition",
         ROW_NUMBER() OVER (
           PARTITION BY im."interest_id"
           ORDER BY im."composition" DESC, im."month_year"
         ) AS rn
  FROM   "interest_metrics" AS im
  JOIN   "interest_map"     AS mp
         ON mp."id" = im."interest_id"
)
SELECT "interest_id",
       "interest_name",
       "month_year",
       "composition"
FROM   ranked
WHERE  rn = 1
LIMIT 20;
```

```sql
-- Description: Display the TOP 10 interest categories ranked by their highest
-- composition value (includes the month of that highest value)
WITH peaks AS (
  SELECT im."interest_id",
         mp."interest_name",
         im."month_year",
         im."composition",
         ROW_NUMBER() OVER (
           PARTITION BY im."interest_id"
           ORDER BY im."composition" DESC, im."month_year"
         ) AS rk
  FROM   "interest_metrics" AS im
  JOIN   "interest_map"     AS mp
         ON mp."id" = im."interest_id"
)
SELECT "month_year"           AS "time_MM-YYYY",
       "interest_name",
       "composition"
FROM   peaks
WHERE  rk = 1
ORDER  BY "composition" DESC
LIMIT 10;
```

```sql
-- Description: Display the BOTTOM 10 interest categories ranked by their highest
-- composition value (i.e., those whose peaks are the lowest)
WITH peaks AS (
  SELECT im."interest_id",
         mp."interest_name",
         im."month_year",
         im."composition",
         ROW_NUMBER() OVER (
           PARTITION BY im."interest_id"
           ORDER BY im."composition" DESC, im."month_year"
         ) AS rk
  FROM   "interest_metrics" AS im
  JOIN   "interest_map"     AS mp
         ON mp."id" = im."interest_id"
)
SELECT "month_year"           AS "time_MM-YYYY",
       "interest_name",
       "composition"
FROM   peaks
WHERE  rk = 1
ORDER  BY "composition" ASC
LIMIT 10;
```

```sql
-- Description: FINAL ANSWER – Combine TOP 10 and BOTTOM 10 interest categories
-- based on their peak composition values, keeping the month of that peak
WITH peaks AS (
  SELECT im."interest_id",
         mp."interest_name",
         im."month_year",
         im."composition",
         ROW_NUMBER() OVER (
           PARTITION BY im."interest_id"
           ORDER BY im."composition" DESC, im."month_year"
         ) AS rk
  FROM   "interest_metrics" AS im
  JOIN   "interest_map"     AS mp
         ON mp."id" = im."interest_id"
),
best AS (
  SELECT "interest_id",
         "interest_name",
         "month_year",
         "composition"
  FROM   peaks
  WHERE  rk = 1
)
SELECT "month_year"           AS "time_MM-YYYY",
       "interest_name",
       "composition"
FROM   best
ORDER  BY "composition" DESC
LIMIT 10

UNION ALL

SELECT "month_year"           AS "time_MM-YYYY",
       "interest_name",
       "composition"
FROM   best
ORDER  BY "composition" ASC
LIMIT 10;
```
