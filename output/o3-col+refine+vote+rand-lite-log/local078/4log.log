Query:
-- 8️⃣ Description: Combine the previous two result-sets (top-10 + bottom-10) in a single query
WITH ranked AS (
  SELECT im.*,
         ROW_NUMBER() OVER (PARTITION BY im.interest_id
                            ORDER BY im.composition DESC) AS rn
  FROM interest_metrics AS im
),
peaks AS (
  SELECT r.month_year AS time,
         mp.interest_name,
         r.composition
  FROM ranked AS r
  JOIN interest_map AS mp
    ON r.interest_id = mp.id
  WHERE r.rn = 1
),
top10 AS (
  SELECT *
  FROM peaks
  ORDER BY composition DESC
  LIMIT 10
),
bottom10 AS (
  SELECT *
  FROM peaks
  ORDER BY composition ASC
  LIMIT 10
)
SELECT *
FROM top10
UNION ALL
SELECT *
FROM bottom10;
