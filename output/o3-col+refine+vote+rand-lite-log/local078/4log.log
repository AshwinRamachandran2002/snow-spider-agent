Query:
-- 5️⃣ Description: For every interest category, find the single (month-year, composition) 
--                 record where it reached its HIGHEST composition value
WITH ranked AS (
  SELECT im.*,
         ROW_NUMBER() OVER (
           PARTITION BY im.interest_id
           ORDER BY im.composition DESC
         ) AS rn
  FROM interest_metrics AS im
)
SELECT r.month_year,
       mp.interest_name,
       r.composition
FROM ranked  AS r
JOIN interest_map AS mp
  ON r.interest_id = mp.id
WHERE r.rn = 1
LIMIT 20;
