```sql
-- 5️⃣ Description: For every interest category, find the single (month-year, composition) 
--                 record where it reached its HIGHEST composition value
WITH ranked AS (
  SELECT im.*,
         ROW_NUMBER() OVER (
           PARTITION BY im.interest_id
           ORDER BY im.composition DESC
         ) AS rn
  FROM interest_metrics AS im
)
SELECT r.month_year,
       mp.interest_name,
       r.composition
FROM ranked  AS r
JOIN interest_map AS mp
  ON r.interest_id = mp.id
WHERE r.rn = 1
LIMIT 20;
```

```sql
-- 6️⃣ Description: Top-10 categories based on their peak composition values
WITH ranked AS (
  SELECT im.*,
         ROW_NUMBER() OVER (PARTITION BY im.interest_id
                            ORDER BY im.composition DESC) AS rn
  FROM interest_metrics AS im
)
SELECT r.month_year              AS time,
       mp.interest_name          AS interest,
       r.composition
FROM ranked AS r
JOIN interest_map AS mp
  ON r.interest_id = mp.id
WHERE r.rn = 1
ORDER BY r.composition DESC
LIMIT 10;
```

```sql
-- 7️⃣ Description: Bottom-10 categories based on their peak composition values
WITH ranked AS (
  SELECT im.*,
         ROW_NUMBER() OVER (PARTITION BY im.interest_id
                            ORDER BY im.composition DESC) AS rn
  FROM interest_metrics AS im
)
SELECT r.month_year              AS time,
       mp.interest_name          AS interest,
       r.composition
FROM ranked AS r
JOIN interest_map AS mp
  ON r.interest_id = mp.id
WHERE r.rn = 1
ORDER BY r.composition ASC
LIMIT 10;
```

```sql
-- 8️⃣ Description: Combine the previous two result-sets (top-10 + bottom-10) in a single query
WITH ranked AS (
  SELECT im.*,
         ROW_NUMBER() OVER (PARTITION BY im.interest_id
                            ORDER BY im.composition DESC) AS rn
  FROM interest_metrics AS im
),
peaks AS (
  SELECT r.month_year AS time,
         mp.interest_name,
         r.composition
  FROM ranked AS r
  JOIN interest_map AS mp
    ON r.interest_id = mp.id
  WHERE r.rn = 1
),
top10 AS (
  SELECT *
  FROM peaks
  ORDER BY composition DESC
  LIMIT 10
),
bottom10 AS (
  SELECT *
  FROM peaks
  ORDER BY composition ASC
  LIMIT 10
)
SELECT *
FROM top10
UNION ALL
SELECT *
FROM bottom10;
```

```sql
-- 9️⃣ Description: Verify that every interest_id in interest_metrics 
--                 has a matching readable name in interest_map
SELECT DISTINCT im.interest_id
FROM interest_metrics AS im
LEFT JOIN interest_map AS mp
       ON im.interest_id = mp.id
WHERE mp.interest_name IS NULL
LIMIT 20;
```

