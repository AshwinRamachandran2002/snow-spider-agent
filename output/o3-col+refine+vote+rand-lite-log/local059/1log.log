```sql
-- Description: Inspect which calendar years are present in the monthly sales table
SELECT DISTINCT strftime('%Y', "date") AS "calendar_year"
FROM "hardware_fact_sales_monthly"
ORDER BY "calendar_year"
LIMIT 20;
```

```sql
-- Description: Look at a few 2021 records to confirm the columns we need
SELECT "date",
       "product_code",
       "customer_code",
       "sold_quantity"
FROM   "hardware_fact_sales_monthly"
WHERE  "date" BETWEEN '2021-01-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- Description: Browse the product master to see the “division” values
SELECT DISTINCT "division"
FROM   "hardware_dim_product"
LIMIT 20;
```

```sql
-- Description: Join 2021 sales with product master to show quantities by product & division
SELECT s."product_code",
       p."division",
       s."sold_quantity"
FROM   "hardware_fact_sales_monthly" AS s
JOIN   "hardware_dim_product"        AS p
       ON s."product_code" = p."product_code"
WHERE  s."date" BETWEEN '2021-01-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- Description: Aggregate 2021 total quantity per product within each division
SELECT p."division",
       s."product_code",
       SUM(s."sold_quantity") AS "total_2021_qty"
FROM   "hardware_fact_sales_monthly" AS s
JOIN   "hardware_dim_product"        AS p
       ON s."product_code" = p."product_code"
WHERE  s."date" BETWEEN '2021-01-01' AND '2021-12-31'
GROUP  BY p."division", s."product_code"
ORDER  BY p."division", "total_2021_qty" DESC
LIMIT 20;
```

```sql
-- Description: Pick the top-3 best-selling products per division using a window ranking
SELECT *
FROM (
        SELECT p."division",
               s."product_code",
               SUM(s."sold_quantity") AS "total_2021_qty",
               ROW_NUMBER() OVER (PARTITION BY p."division"
                                  ORDER BY SUM(s."sold_quantity") DESC) AS "rn"
        FROM   "hardware_fact_sales_monthly" AS s
        JOIN   "hardware_dim_product"        AS p
               ON s."product_code" = p."product_code"
        WHERE  s."date" BETWEEN '2021-01-01' AND '2021-12-31'
        GROUP  BY p."division", s."product_code"
) AS ranked
WHERE  "rn" <= 3
ORDER  BY "division", "total_2021_qty" DESC
LIMIT 20;
```

```sql
-- Description: Compute the average of the total quantities of those top-3 products per division
SELECT "division",
       AVG("total_2021_qty") AS "avg_qty_top3_2021"
FROM (
        SELECT p."division",
               SUM(s."sold_quantity") AS "total_2021_qty",
               ROW_NUMBER() OVER (PARTITION BY p."division"
                                  ORDER BY SUM(s."sold_quantity") DESC) AS "rn"
        FROM   "hardware_fact_sales_monthly" AS s
        JOIN   "hardware_dim_product"        AS p
               ON s."product_code" = p."product_code"
        WHERE  s."date" BETWEEN '2021-01-01' AND '2021-12-31'
        GROUP  BY p."division", s."product_code"
) AS ranked
WHERE  "rn" <= 3
GROUP  BY "division";
```

```sql
-- Description: Final answer – present each division with its overall average quantity sold for the top-3 products
SELECT "division"        AS "Division",
       ROUND(AVG("total_qty"), 2) AS "Average_Quantity_Sold_Top3_Products_2021"
FROM (
        SELECT p."division",
               SUM(s."sold_quantity") AS "total_qty",
               ROW_NUMBER() OVER (PARTITION BY p."division"
                                  ORDER BY SUM(s."sold_quantity") DESC) AS "rank_in_division"
        FROM   "hardware_fact_sales_monthly" AS s
        JOIN   "hardware_dim_product"        AS p
               ON s."product_code" = p."product_code"
        WHERE  s."date" BETWEEN '2021-01-01' AND '2021-12-31'
        GROUP  BY p."division", s."product_code"
) AS t
WHERE  "rank_in_division" <= 3
GROUP  BY "division";
```
