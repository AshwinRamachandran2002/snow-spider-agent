```sql
-- 1) Inspect which calendar years exist in the sales fact table
SELECT DISTINCT SUBSTR(date,1,4) AS year
FROM hardware_fact_sales_monthly
ORDER BY year
LIMIT 20;
```

```sql
-- 2) Look at a few sales records from calendar year 2021
SELECT *
FROM hardware_fact_sales_monthly
WHERE date BETWEEN '2021-01-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- 3) Preview how product codes map to divisions
SELECT DISTINCT hdp.product_code,
       hdp.division
FROM hardware_dim_product AS hdp
LIMIT 20;
```

```sql
-- 4) Compute total quantity sold per product during calendar year 2021
SELECT hfs.product_code,
       SUM(hfs.sold_quantity) AS total_qty_2021
FROM hardware_fact_sales_monthly AS hfs
WHERE hfs.date BETWEEN '2021-01-01' AND '2021-12-31'
GROUP BY hfs.product_code
ORDER BY total_qty_2021 DESC
LIMIT 20;
```

```sql
-- 5) Add division information to those product totals
SELECT hdp.division,
       hfs.product_code,
       SUM(hfs.sold_quantity) AS total_qty_2021
FROM hardware_fact_sales_monthly AS hfs
JOIN hardware_dim_product AS hdp
     ON hfs.product_code = hdp.product_code
WHERE hfs.date BETWEEN '2021-01-01' AND '2021-12-31'
GROUP BY hdp.division, hfs.product_code
ORDER BY hdp.division, total_qty_2021 DESC
LIMIT 20;
```

```sql
-- 6) Rank products inside each division by their 2021 totals
SELECT division,
       product_code,
       total_qty_2021,
       ROW_NUMBER() OVER (PARTITION BY division
                          ORDER BY total_qty_2021 DESC) AS rn
FROM (
    SELECT hdp.division,
           hfs.product_code,
           SUM(hfs.sold_quantity) AS total_qty_2021
    FROM hardware_fact_sales_monthly AS hfs
    JOIN hardware_dim_product AS hdp
         ON hfs.product_code = hdp.product_code
    WHERE hfs.date BETWEEN '2021-01-01' AND '2021-12-31'
    GROUP BY hdp.division, hfs.product_code
) AS t
ORDER BY division, rn
LIMIT 20;
```

```sql
-- 7) Keep only the top-3 products per division
SELECT division,
       product_code,
       total_qty_2021
FROM (
    SELECT division,
           product_code,
           total_qty_2021,
           ROW_NUMBER() OVER (PARTITION BY division
                              ORDER BY total_qty_2021 DESC) AS rn
    FROM (
        SELECT hdp.division,
               hfs.product_code,
               SUM(hfs.sold_quantity) AS total_qty_2021
        FROM hardware_fact_sales_monthly AS hfs
        JOIN hardware_dim_product AS hdp
             ON hfs.product_code = hdp.product_code
        WHERE hfs.date BETWEEN '2021-01-01' AND '2021-12-31'
        GROUP BY hdp.division, hfs.product_code
    )
)
WHERE rn <= 3
ORDER BY division, total_qty_2021 DESC
LIMIT 20;
```

```sql
-- 8) For each division, calculate the overall average quantity sold
--    of its top-3 best-selling products (calendar year 2021)
SELECT division,
       AVG(total_qty_2021) AS avg_qty_top3_2021
FROM (
    SELECT division,
           product_code,
           total_qty_2021,
           ROW_NUMBER() OVER (PARTITION BY division
                              ORDER BY total_qty_2021 DESC) AS rn
    FROM (
        SELECT hdp.division,
               hfs.product_code,
               SUM(hfs.sold_quantity) AS total_qty_2021
        FROM hardware_fact_sales_monthly AS hfs
        JOIN hardware_dim_product AS hdp
             ON hfs.product_code = hdp.product_code
        WHERE hfs.date BETWEEN '2021-01-01' AND '2021-12-31'
        GROUP BY hdp.division, hfs.product_code
    )
)
WHERE rn <= 3
GROUP BY division
ORDER BY division;
```

```sql
-- 9) (Optional) Show final result without ordering, to be used as answer
SELECT division,
       ROUND(AVG(total_qty_2021),2) AS avg_qty_top3_2021
FROM (
    SELECT division,
           product_code,
           total_qty_2021,
           ROW_NUMBER() OVER (PARTITION BY division
                              ORDER BY total_qty_2021 DESC) AS rn
    FROM (
        SELECT hdp.division,
               hfs.product_code,
               SUM(hfs.sold_quantity) AS total_qty_2021
        FROM hardware_fact_sales_monthly AS hfs
        JOIN hardware_dim_product AS hdp
             ON hfs.product_code = hdp.product_code
        WHERE hfs.date BETWEEN '2021-01-01' AND '2021-12-31'
        GROUP BY hdp.division, hfs.product_code
    )
)
WHERE rn <= 3
GROUP BY division;
```

