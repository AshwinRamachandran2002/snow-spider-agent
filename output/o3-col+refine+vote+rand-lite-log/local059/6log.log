```sql
-- 1. Look at a few 2021 rows in the monthly sales fact table
SELECT *
FROM hardware_fact_sales_monthly
WHERE date BETWEEN '2021-01-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- 2. List a few distinct product codes that appear in 2021 sales
SELECT DISTINCT product_code
FROM hardware_fact_sales_monthly
WHERE date BETWEEN '2021-01-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- 3. See how those product codes map to divisions in the product dimension
SELECT p.product_code,
       p.division,
       p.segment,
       p.category
FROM hardware_dim_product AS p
WHERE p.product_code IN (
      SELECT DISTINCT product_code
      FROM hardware_fact_sales_monthly
      WHERE date BETWEEN '2021-01-01' AND '2021-12-31'
)
LIMIT 20;
```

```sql
-- 4. Total quantity sold per product (all divisions) in calendar year-2021
SELECT h.product_code,
       SUM(h.sold_quantity) AS total_qty_2021
FROM hardware_fact_sales_monthly AS h
WHERE h.date BETWEEN '2021-01-01' AND '2021-12-31'
GROUP BY h.product_code
ORDER BY total_qty_2021 DESC
LIMIT 20;
```

```sql
-- 5. Total quantity sold per product WITH its division in 2021
SELECT p.division,
       h.product_code,
       SUM(h.sold_quantity) AS total_qty_2021
FROM hardware_fact_sales_monthly AS h
JOIN hardware_dim_product  AS p
  ON h.product_code = p.product_code
WHERE h.date BETWEEN '2021-01-01' AND '2021-12-31'
GROUP BY p.division, h.product_code
ORDER BY p.division, total_qty_2021 DESC
LIMIT 20;
```

```sql
-- 6. Rank products inside each division by 2021 quantity (top 3 per division)
SELECT division,
       product_code,
       total_qty_2021,
       ROW_NUMBER() OVER (PARTITION BY division ORDER BY total_qty_2021 DESC) AS rn
FROM (
    SELECT p.division,
           h.product_code,
           SUM(h.sold_quantity) AS total_qty_2021
    FROM hardware_fact_sales_monthly AS h
    JOIN hardware_dim_product  AS p
      ON h.product_code = p.product_code
    WHERE h.date BETWEEN '2021-01-01' AND '2021-12-31'
    GROUP BY p.division, h.product_code
)
WHERE rn <= 3
LIMIT 20;
```

```sql
-- 7. Overall average quantity sold of the TOP-3 products per division (final result)
SELECT division,
       ROUND(AVG(total_qty_2021),2) AS avg_qty_top3_2021
FROM (
    SELECT division,
           product_code,
           total_qty_2021,
           ROW_NUMBER() OVER (PARTITION BY division ORDER BY total_qty_2021 DESC) AS rn
    FROM (
        SELECT p.division,
               h.product_code,
               SUM(h.sold_quantity) AS total_qty_2021
        FROM hardware_fact_sales_monthly AS h
        JOIN hardware_dim_product  AS p
          ON h.product_code = p.product_code
        WHERE h.date BETWEEN '2021-01-01' AND '2021-12-31'
        GROUP BY p.division, h.product_code
    )
)
WHERE rn <= 3
GROUP BY division
ORDER BY avg_qty_top3_2021 DESC
LIMIT 20;
```
