Query:
--Description: Compute 2021 total quantity per (division, product), rank products inside each division,
--keep the three highest-selling products, and return the average of those top-3 quantities per division.
WITH totals AS (
    SELECT
        p.division,
        h.product_code,
        SUM(h.sold_quantity) AS total_qty_2021
    FROM hardware_fact_sales_monthly AS h
    JOIN hardware_dim_product        AS p
      ON h.product_code = p.product_code
    WHERE h.date BETWEEN '2021-01-01' AND '2021-12-31'
    GROUP BY p.division, h.product_code
),
ranked AS (
    SELECT
        division,
        product_code,
        total_qty_2021,
        ROW_NUMBER() OVER (PARTITION BY division ORDER BY total_qty_2021 DESC) AS rn
    FROM totals
)
SELECT
    division,
    ROUND(AVG(total_qty_2021), 2) AS avg_qty_top3_2021
FROM ranked
WHERE rn <= 3
GROUP BY division
ORDER BY avg_qty_top3_2021 DESC
LIMIT 20
