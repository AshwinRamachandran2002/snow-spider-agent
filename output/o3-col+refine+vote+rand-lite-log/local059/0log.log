-- Description: 7. Retrieve only the top-3 best-selling products per division for 2021
SELECT *
FROM (
     SELECT p."division",
            t."product_code",
            t."total_qty_2021",
            RANK() OVER (PARTITION BY p."division"
                         ORDER BY t."total_qty_2021" DESC) AS "div_rank"
     FROM (
          SELECT "product_code",
                 SUM("sold_quantity") AS "total_qty_2021"
          FROM "hardware_fact_sales_monthly"
          WHERE "date" LIKE '2021-%'
          GROUP BY "product_code"
     ) AS t
     JOIN "hardware_dim_product" AS p
     ON p."product_code" = t."product_code"
) AS ranked
WHERE "div_rank" <= 3
ORDER BY "division", "div_rank"
LIMIT 20;
