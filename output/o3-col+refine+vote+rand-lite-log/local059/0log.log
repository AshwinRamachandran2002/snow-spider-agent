-- Description: 8. For each division, calculate the average quantity sold across its top 3 products
SELECT "division",
       AVG("total_qty_2021") AS "avg_qty_top3_2021"
FROM (
     SELECT p."division",
            t."total_qty_2021",
            RANK() OVER (PARTITION BY p."division"
                         ORDER BY t."total_qty_2021" DESC) AS "div_rank"
     FROM (
          SELECT "product_code",
                 SUM("sold_quantity") AS "total_qty_2021"
          FROM "hardware_fact_sales_monthly"
          WHERE "date" LIKE '2021-%'
          GROUP BY "product_code"
     ) AS t
     JOIN "hardware_dim_product" AS p
     ON p."product_code" = t."product_code"
) AS ranked
WHERE "div_rank" <= 3
GROUP BY "division"
ORDER BY "division"
LIMIT 20;
