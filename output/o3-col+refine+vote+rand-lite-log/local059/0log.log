```sql
-- Description: 1. Look at all hardware divisions available in the product dimension table
SELECT DISTINCT "division"
FROM "hardware_dim_product"
LIMIT 20;
```

```sql
-- Description: 2. Inspect a few 2021 sales records to see the columns we will use
SELECT "date",
       "product_code",
       "customer_code",
       "sold_quantity"
FROM "hardware_fact_sales_monthly"
WHERE "date" LIKE '2021-%'
LIMIT 20;
```

```sql
-- Description: 3. Check the overall 2021 date range that exists in the monthly sales fact
SELECT MIN("date") AS "earliest_2021_date",
       MAX("date") AS "latest_2021_date"
FROM "hardware_fact_sales_monthly"
WHERE "date" LIKE '2021-%';
```

```sql
-- Description: 4. Compute total quantity sold in 2021 for every product (regardless of division)
SELECT "product_code",
       SUM("sold_quantity") AS "total_qty_2021"
FROM "hardware_fact_sales_monthly"
WHERE "date" LIKE '2021-%'
GROUP BY "product_code"
ORDER BY "total_qty_2021" DESC
LIMIT 20;
```

```sql
-- Description: 5. Join the totals with product-to-division mapping to see quantities by division
SELECT p."division",
       t."product_code",
       t."total_qty_2021"
FROM (
     SELECT "product_code",
            SUM("sold_quantity") AS "total_qty_2021"
     FROM "hardware_fact_sales_monthly"
     WHERE "date" LIKE '2021-%'
     GROUP BY "product_code"
) AS t
JOIN "hardware_dim_product" AS p
ON p."product_code" = t."product_code"
ORDER BY p."division", t."total_qty_2021" DESC
LIMIT 20;
```

```sql
-- Description: 6. Rank each product within its division by 2021 total quantity sold
SELECT p."division",
       t."product_code",
       t."total_qty_2021",
       RANK() OVER (PARTITION BY p."division"
                    ORDER BY t."total_qty_2021" DESC) AS "div_rank"
FROM (
     SELECT "product_code",
            SUM("sold_quantity") AS "total_qty_2021"
     FROM "hardware_fact_sales_monthly"
     WHERE "date" LIKE '2021-%'
     GROUP BY "product_code"
) AS t
JOIN "hardware_dim_product" AS p
ON p."product_code" = t."product_code"
ORDER BY p."division", "div_rank"
LIMIT 20;
```

```sql
-- Description: 7. Retrieve only the top-3 best-selling products per division for 2021
SELECT *
FROM (
     SELECT p."division",
            t."product_code",
            t."total_qty_2021",
            RANK() OVER (PARTITION BY p."division"
                         ORDER BY t."total_qty_2021" DESC) AS "div_rank"
     FROM (
          SELECT "product_code",
                 SUM("sold_quantity") AS "total_qty_2021"
          FROM "hardware_fact_sales_monthly"
          WHERE "date" LIKE '2021-%'
          GROUP BY "product_code"
     ) AS t
     JOIN "hardware_dim_product" AS p
     ON p."product_code" = t."product_code"
) AS ranked
WHERE "div_rank" <= 3
ORDER BY "division", "div_rank"
LIMIT 20;
```

```sql
-- Description: 8. For each division, calculate the average quantity sold across its top 3 products
SELECT "division",
       AVG("total_qty_2021") AS "avg_qty_top3_2021"
FROM (
     SELECT p."division",
            t."total_qty_2021",
            RANK() OVER (PARTITION BY p."division"
                         ORDER BY t."total_qty_2021" DESC) AS "div_rank"
     FROM (
          SELECT "product_code",
                 SUM("sold_quantity") AS "total_qty_2021"
          FROM "hardware_fact_sales_monthly"
          WHERE "date" LIKE '2021-%'
          GROUP BY "product_code"
     ) AS t
     JOIN "hardware_dim_product" AS p
     ON p."product_code" = t."product_code"
) AS ranked
WHERE "div_rank" <= 3
GROUP BY "division"
ORDER BY "division"
LIMIT 20;
```

```sql
-- Description: 9. (Optional) Display the final answer clearly: average quantity sold of the top-3
-- best-selling products in 2021 for every hardware division (no LIMIT because result set is tiny)
SELECT "division"                                       AS "Division",
       ROUND(AVG("total_qty_2021"), 2)                  AS "Avg_Qty_Top3_2021"
FROM (
     SELECT p."division",
            t."total_qty_2021",
            RANK() OVER (PARTITION BY p."division"
                         ORDER BY t."total_qty_2021" DESC) AS "div_rank"
     FROM (
          SELECT "product_code",
                 SUM("sold_quantity") AS "total_qty_2021"
          FROM "hardware_fact_sales_monthly"
          WHERE "date" LIKE '2021-%'
          GROUP BY "product_code"
     ) AS t
     JOIN "hardware_dim_product" AS p
     ON p."product_code" = t."product_code"
) AS ranked
WHERE "div_rank" <= 3
GROUP BY "division"
ORDER BY "division";
```

```sql
-- Description: 10. (Safety check) See the full breakdown (division, product, quantity) for the
-- products used in the final calculation so the numbers can be audited easily
SELECT "division",
       "product_code",
       "total_qty_2021"
