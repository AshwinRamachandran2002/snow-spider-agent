-- Description: 5. Join the totals with product-to-division mapping to see quantities by division
SELECT p."division",
       t."product_code",
       t."total_qty_2021"
FROM (
     SELECT "product_code",
            SUM("sold_quantity") AS "total_qty_2021"
     FROM "hardware_fact_sales_monthly"
     WHERE "date" LIKE '2021-%'
     GROUP BY "product_code"
) AS t
JOIN "hardware_dim_product" AS p
ON p."product_code" = t."product_code"
ORDER BY p."division", t."total_qty_2021" DESC
LIMIT 20;
