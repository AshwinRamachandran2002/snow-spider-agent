```sql
--Description: 1) Quick look at some IMAGE-format ads to understand column contents
SELECT 
    t."creative_id",
    t."creative_page_url",
    t."ad_format_type",
    t."topic",
    t."advertiser_location",
    t."advertiser_verification_status"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t
WHERE t."ad_format_type" = 'IMAGE'
LIMIT 20;
```

```sql
--Description: 2) IMAGE ads coming from advertisers located in Cyprus (CY)
SELECT DISTINCT
    t."creative_id",
    t."creative_page_url",
    t."advertiser_disclosed_name",
    t."advertiser_location"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t
WHERE t."ad_format_type" = 'IMAGE'
  AND t."advertiser_location" = 'CY'
LIMIT 20;
```

```sql
--Description: 3) Flatten region_stats of Cyprus IMAGE ads to see whether they were shown in Croatia (HR)
SELECT 
    t."creative_id",
    f.value:"region_code"::STRING  AS "region_code",
    f.value:"first_shown"::STRING  AS "first_shown",
    f.value:"last_shown"::STRING   AS "last_shown",
    f.value:"times_shown_availability_date"::STRING AS "times_shown_availability_date"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t,
     LATERAL FLATTEN(input => t."region_stats") f
WHERE t."ad_format_type" = 'IMAGE'
  AND t."advertiser_location" = 'CY'
  AND f.value:"region_code"::STRING = 'HR'
LIMIT 20;
```

```sql
--Description: 4) Check whether times_shown_availability_date is NULL for Cyprus IMAGE ads served in Croatia
SELECT 
    t."creative_id",
    t."creative_page_url",
    f.value:"region_code"::STRING                       AS "region_code",
    f.value:"times_shown_availability_date" IS NULL     AS "is_times_shown_available"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t,
     LATERAL FLATTEN(input => t."region_stats") f
WHERE t."ad_format_type" = 'IMAGE'
  AND t."advertiser_location" = 'CY'
  AND f.value:"region_code"::STRING = 'HR'
LIMIT 20;
```

```sql
--Description: 5) Add first_shown / last_shown date window filters (strictly inside 2023)
SELECT 
    t."creative_id",
    t."creative_page_url",
    f.value:"first_shown"::STRING  AS "first_shown",
    f.value:"last_shown"::STRING   AS "last_shown"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t,
     LATERAL FLATTEN(input => t."region_stats") f
WHERE t."ad_format_type" = 'IMAGE'
  AND t."advertiser_location"      = 'CY'
  AND t."advertiser_verification_status" = 'VERIFIED'
  AND f.value:"region_code"::STRING = 'HR'
  AND f.value:"first_shown"::DATE  > '2023-01-01'
  AND f.value:"last_shown"::DATE   < '2024-01-01'
LIMIT 20;
```

```sql
--Description: 6) Explore audience_selection_approach_info of those candidate ads
SELECT 
    t."creative_id",
    t."creative_page_url",
    a.value:"contextual_signals"::STRING  AS "contextual_signals",
    a.value:"customer_lists"::STRING      AS "customer_lists",
    a.value:"demographic_info"::STRING    AS "demographic_info",
    a.value:"geo_location"::STRING        AS "geo_location",
    a.value:"topics_of_interest"::STRING  AS "topics_of_interest"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t,
     LATERAL FLATTEN(input => ARRAY_CONSTRUCT(t."audience_selection_approach_info")) a
WHERE t."ad_format_type" = 'IMAGE'
  AND t."advertiser_location" = 'CY'
  AND t."topic" ILIKE '%Health%'
LIMIT 20;
```

```sql
--Description: 7) Filter ads where all five audience-selection signals are *not* 'CRITERIA_UNUSED'
SELECT 
    t."creative_id",
    t."creative_page_url"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t,
     LATERAL FLATTEN(input => ARRAY_CONSTRUCT(t."audience_selection_approach_info")) a
WHERE t."ad_format_type" = 'IMAGE'
  AND t."advertiser_location" = 'CY'
  AND a.value:"contextual_signals"::STRING  <> 'CRITERIA_UNUSED'
  AND a.value:"customer_lists"::STRING      <> 'CRITERIA_UNUSED'
  AND a.value:"demographic_info"::STRING    <> 'CRITERIA_UNUSED'
  AND a.value:"geo_location"::STRING        <> 'CRITERIA_UNUSED'
  AND a.value:"topics_of_interest"::STRING  <> 'CRITERIA_UNUSED'
LIMIT 20;
```

```sql
--Description: 8) Combine all earlier constraints to list candidate creatives and their times_shown_upper_bound
SELECT 
    t."creative_id",
    t."creative_page_url",
    MAX(f.value:"times_shown_upper_bound"::NUMBER) AS "max_upper_bound"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t,
     LATERAL FLATTEN(input => t."region_stats") f,
     LATERAL FLATTEN(input => ARRAY_CONSTRUCT(t."audience_selection_approach_info")) a
WHERE t."ad_format_type" = 'IMAGE'
  AND t."topic" ILIKE '%Health%'
  AND t."advertiser_location" = 'CY'
  AND t."advertiser_verification_status" = 'VERIFIED'
  AND f.value:"region_code"::STRING = 'HR'
  AND f.value:"times_shown_availability_date" IS NULL
  AND f.value:"first_shown"::DATE  > '2023-01-01'
  AND f.value:"last_shown"::DATE   < '2024-01-01'
  AND a.value:"contextual_signals"::STRING  <> 'CRITERIA_UNUSED'
  AND a.value:"customer_lists"::STRING      <> 'CRITERIA_UNUSED'
  AND a.value:"demographic_info"::STRING    <> 'CRITERIA_UNUSED'
  AND a.value:"geo_location"::STRING        <> 'CRITERIA_UNUSED'
  AND a.value:"topics_of_interest"::STRING  <> 'CRITERIA_UNUSED'
GROUP BY 1,2
ORDER BY "max_upper_bound" DESC
LIMIT 20;
```

```sql
--Description: 9) Pick the single ad (page URL) with the highest upper-bound of times shown
SELECT 
    t."creative_page_url"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t,
     LATERAL FLATTEN(input => t."region_stats") f,
     LATERAL FLATTEN(input => ARRAY_CONSTRUCT(t."audience_selection_approach_info")) a
WHERE t."ad_format_type" = 'IMAGE'
  AND t."topic" ILIKE '%Health%'
  AND t."advertiser_location" = 'CY'
  AND t."advertiser_verification_status" = 'VERIFIED'
  AND f.value:"region_code"::STRING = 'HR'
  AND f.value:"times_shown_availability_date" IS NULL
  AND f.value:"first_shown"::DATE  > '2023-01-01'
  AND f.value:"last_shown"::DATE   < '2024-01-01'
  AND a.value:"contextual_signals"::STRING  <> 'CRITERIA_UNUSED'
  AND a.value:"customer_lists"::STRING      <> 'CRITERIA_UNUSED'
  AND a.value:"demographic_info"::STRING    <> 'CRITERIA_UNUSED'
  AND a.value:"geo_location"::STRING        <> 'CRITERIA_UNUSED'
  AND a.value:"topics_of_interest"::STRING  <> 'CRITERIA_UNUSED'
ORDER BY f.value:"times_shown_upper_bound"::NUMBER DESC
LIMIT 1;
```

```sql
--Description: 10) (Optional) Verify the final candidate’s detailed stats for Croatia
SELECT 
    t."creative_id",
    t."creative_page_url",
    f.value:"first_shown"::STRING                              AS "first_shown",
    f.value:"last_shown"::STRING                               AS "last_shown",
    f.value:"times_shown_lower_bound"::NUMBER                  AS "lower_bound",
    f.value:"times_shown_upper_bound"::NUMBER                  AS "upper_bound",
    f.value:"times_shown_availability_date"                    AS "availability_date"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t,
     LATERAL FLATTEN(input => t."region_stats") f
WHERE t."creative_page_url" = (
      /* same sub-query as #9 to fetch the top URL */
      SELECT 
          tt."creative_page_url"
      FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS tt,
           LATERAL FLATTEN(input => tt."region_stats") ff,
           LATERAL FLATTEN(input => ARRAY_CONSTRUCT(tt."audience_selection_approach_info")) aa
      WHERE tt."ad_format_type" = 'IMAGE'
        AND tt."topic" ILIKE '%Health%'
        AND tt."advertiser_location" = 'CY'
        AND tt."advertiser_verification_status" = 'VERIFIED'
        AND ff.value:"region_code"::STRING = 'HR'
        AND ff.value:"times_shown_availability_date" IS NULL
        AND ff.value:"first_shown"::DATE  > '2023-01-01'
        AND ff.value:"last_shown"::DATE   < '2024-01-01'
        AND aa.value:"contextual_signals"::STRING  <> 'CRITERIA_UNUSED'
        AND aa.value:"customer_lists"::STRING      <> 'CRITERIA_UNUSED'
        AND aa.value:"demographic_info"::STRING    <> 'CRITERIA_UNUSED'
        AND aa.value:"geo_location"::STRING        <> 'CRITERIA_UNUSED'
        AND aa.value:"topics_of_interest"::STRING  <> 'CRITERIA_UNUSED'
      ORDER BY ff.value:"times_shown_upper_bound"::NUMBER DESC
      LIMIT 1
)
  AND f.value:"region_code"::STRING = 'HR'
LIMIT 20;
```
