```sql
--Description: 5) Pull region-level stats for all Croatian (“HR”) impressions of the Cyprus+Health+Image ads
SELECT  cs."creative_id",
        rs.value:"region_code"::STRING               AS "region_code",
        rs.value:"first_shown"::DATE                 AS "first_shown",
        rs.value:"last_shown"::DATE                  AS "last_shown",
        rs.value:"times_shown_upper_bound"::INTEGER  AS "times_shown_upper_bound",
        rs.value:"times_shown_availability_date"     AS "times_shown_availability_date"
FROM    GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS cs,
        LATERAL FLATTEN(input => cs."region_stats") rs
WHERE   cs."ad_format_type"  = 'IMAGE'
  AND   cs."topic"           ILIKE '%Health%'
  AND   cs."advertiser_location" = 'CY'
  AND   cs."advertiser_verification_status" = 'VERIFIED'
  AND   rs.value:"region_code"::STRING = 'HR'
LIMIT 20;
```

```sql
--Description: 6) Apply the exact date window (first > 2023-01-01 & last < 2024-01-01) and require NULL availability_date
SELECT  cs."creative_id",
        cs."creative_page_url",
        rs.value:"first_shown"::DATE                AS "first_shown",
        rs.value:"last_shown"::DATE                 AS "last_shown",
        rs.value:"times_shown_upper_bound"::INTEGER AS "times_shown_upper_bound"
FROM    GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS cs,
        LATERAL FLATTEN(input => cs."region_stats") rs
WHERE   cs."ad_format_type"  = 'IMAGE'
  AND   cs."topic"           ILIKE '%Health%'
  AND   cs."advertiser_location" = 'CY'
  AND   cs."advertiser_verification_status" = 'VERIFIED'
  AND   rs.value:"region_code"::STRING = 'HR'
  AND   rs.value:"first_shown"::DATE  > '2023-01-01'
  AND   rs.value:"last_shown"::DATE   < '2024-01-01'
  AND   rs.value:"times_shown_availability_date" IS NULL
LIMIT 20;
```

```sql
--Description: 7) Ensure NO targeting method is “CRITERIA_UNUSED” for those ads (all five keys present & not UNUSED)
SELECT  cs."creative_id",
        cs."creative_page_url"
FROM    GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS cs
WHERE   cs."creative_id" IN (
          SELECT DISTINCT rs.src.value:"creative_id"::STRING
          FROM   GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS src,
                 LATERAL FLATTEN(input => src."region_stats") rs
          WHERE  src."ad_format_type"  = 'IMAGE'
             AND src."topic"           ILIKE '%Health%'
             AND src."advertiser_location" = 'CY'
             AND src."advertiser_verification_status" = 'VERIFIED'
             AND rs.value:"region_code"::STRING = 'HR'
             AND rs.value:"first_shown"::DATE  > '2023-01-01'
             AND rs.value:"last_shown"::DATE   < '2024-01-01'
             AND rs.value:"times_shown_availability_date" IS NULL )
  AND   TRY_CAST(cs."audience_selection_approach_info":"contextual_signals" AS STRING)      NOT ILIKE '%UNUSED%'
  AND   TRY_CAST(cs."audience_selection_approach_info":"customer_lists"     AS STRING)      NOT ILIKE '%UNUSED%'
  AND   TRY_CAST(cs."audience_selection_approach_info":"demographic_info"   AS STRING)      NOT ILIKE '%UNUSED%'
  AND   TRY_CAST(cs."audience_selection_approach_info":"geo_location"       AS STRING)      NOT ILIKE '%UNUSED%'
  AND   TRY_CAST(cs."audience_selection_approach_info":"topics_of_interest" AS STRING)      NOT ILIKE '%UNUSED%'
LIMIT 20;
```

```sql
--Description: 8) Combine everything and rank by the maximum “times_shown_upper_bound”
SELECT  cs."creative_page_url",
        MAX(rs.value:"times_shown_upper_bound"::INTEGER) AS "max_upper_bound"
FROM    GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS cs,
        LATERAL FLATTEN(input => cs."region_stats") rs
WHERE   cs."ad_format_type"  = 'IMAGE'
  AND   cs."topic"           ILIKE '%Health%'
  AND   cs."advertiser_location" = 'CY'
  AND   cs."advertiser_verification_status" = 'VERIFIED'
  AND   rs.value:"region_code"::STRING = 'HR'
  AND   rs.value:"first_shown"::DATE  > '2023-01-01'
  AND   rs.value:"last_shown"::DATE   < '2024-01-01'
  AND   rs.value:"times_shown_availability_date" IS NULL
  AND   TRY_CAST(cs."audience_selection_approach_info":"contextual_signals" AS STRING)      NOT ILIKE '%UNUSED%'
  AND   TRY_CAST(cs."audience_selection_approach_info":"customer_lists"     AS STRING)      NOT ILIKE '%UNUSED%'
  AND   TRY_CAST(cs."audience_selection_approach_info":"demographic_info"   AS STRING)      NOT ILIKE '%UNUSED%'
  AND   TRY_CAST(cs."audience_selection_approach_info":"geo_location"       AS STRING)      NOT ILIKE '%UNUSED%'
  AND   TRY_CAST(cs."audience_selection_approach_info":"topics_of_interest" AS STRING)      NOT ILIKE '%UNUSED%'
GROUP  BY cs."creative_page_url"
ORDER  BY "max_upper_bound" DESC
LIMIT 20;
```

```sql
--Description: 9) Final pick – retrieve only the single page-URL with the very highest upper-bound of times shown
SELECT  TOP 1 "creative_page_url"
FROM  (
        SELECT  cs."creative_page_url",
                MAX(rs.value:"times_shown_upper_bound"::INTEGER) AS ub
        FROM    GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS cs,
                LATERAL FLATTEN(input => cs."region_stats") rs
        WHERE   cs."ad_format_type"  = 'IMAGE'
          AND   cs."topic"           ILIKE '%Health%'
          AND   cs."advertiser_location" = 'CY'
          AND   cs."advertiser_verification_status" = 'VERIFIED'
          AND   rs.value:"region_code"::STRING = 'HR'
          AND   rs.value:"first_shown"::DATE  > '2023-01-01'
          AND   rs.value:"last_shown"::DATE   < '2024-01-01'
          AND   rs.value:"times_shown_availability_date" IS NULL
          AND   TRY_CAST(cs."audience_selection_approach_info":"contextual_signals" AS STRING)      NOT ILIKE '%UNUSED%'
          AND   TRY_CAST(cs."audience_selection_approach_info":"customer_lists"     AS STRING)      NOT ILIKE '%UNUSED%'
          AND   TRY_CAST(cs."audience_selection_approach_info":"demographic_info"   AS STRING)      NOT ILIKE '%UNUSED%'
          AND   TRY_CAST(cs."audience_selection_approach_info":"geo_location"       AS STRING)      NOT ILIKE '%UNUSED%'
          AND   TRY_CAST(cs."audience_selection_approach_info":"topics_of_interest" AS STRING)      NOT ILIKE '%UNUSED%'
        GROUP  BY cs."creative_page_url"
        ORDER  BY ub DESC )
LIMIT 1;
```

