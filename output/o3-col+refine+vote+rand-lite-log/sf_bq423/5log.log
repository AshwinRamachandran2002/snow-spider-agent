       "creative_id",
       "creative_page_url",
       "topic",
       "ad_format_type"
FROM   GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS
WHERE  "ad_format_type" ILIKE '%IMAGE%'
  AND  "topic"          ILIKE '%Health%'
LIMIT 20;
