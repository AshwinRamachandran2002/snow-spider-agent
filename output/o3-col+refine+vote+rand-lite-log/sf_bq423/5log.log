--Description: One-shot query that finds the required advertisement and returns its page-URL.
-- Logic / thinking inside comments:
--  • IMAGE format & topic containing “Health”.
--  • Advertiser located in Cyprus (CY) and VERIFIED.
--  • Ad served in Croatia (region_code = HR).
--  • first_shown  > 2023-01-01  AND  last_shown  < 2024-01-01.
--  • times_shown_availability_date must be NULL (times-shown data already available).
--  • Every targeting method (contextual_signals, customer_lists, demographic_info,
--    geo_location, topics_of_interest) must exist and not be marked “CRITERIA_UNUSED”.
--  • Among those, pick the ad with the greatest times_shown_upper_bound in HR.
SELECT TOP 1
       cs."creative_page_url"
FROM   GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS cs
       ,LATERAL FLATTEN(input => cs."region_stats") rs          -- expand region-level stats
WHERE  cs."ad_format_type"                 = 'IMAGE'
  AND  cs."topic"                          ILIKE '%Health%'
  AND  cs."advertiser_location"            = 'CY'
  AND  cs."advertiser_verification_status" = 'VERIFIED'
  /* Croatian impressions inside 2023 calendar year */
  AND  rs.value:"region_code"::STRING      = 'HR'
  AND  rs.value:"first_shown"::DATE        >  '2023-01-01'
  AND  rs.value:"last_shown"::DATE         <  '2024-01-01'
  /* times_shown data already available (NULL availability date) */
  AND  rs.value:"times_shown_availability_date" IS NULL
  /* All targeting approaches present & not UNUSED */
  AND  cs."audience_selection_approach_info":"contextual_signals"::STRING      NOT ILIKE '%UNUSED%'
  AND  cs."audience_selection_approach_info":"customer_lists"::STRING          NOT ILIKE '%UNUSED%'
  AND  cs."audience_selection_approach_info":"demographic_info"::STRING        NOT ILIKE '%UNUSED%'
  AND  cs."audience_selection_approach_info":"geo_location"::STRING            NOT ILIKE '%UNUSED%'
  AND  cs."audience_selection_approach_info":"topics_of_interest"::STRING      NOT ILIKE '%UNUSED%'
GROUP BY cs."creative_page_url"
ORDER BY MAX(rs.value:"times_shown_upper_bound"::INTEGER) DESC;
```
