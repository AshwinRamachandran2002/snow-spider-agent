--Description: 4) Explode the audience_selection_approach_info JSON for Cyprus-based, Health-topic IMAGE ads
SELECT  cs."creative_id",
        kv.key   AS "selection_type",
        kv.value AS "selection_status"
FROM    GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS cs,
        LATERAL FLATTEN(input => cs."audience_selection_approach_info") kv
WHERE   cs."ad_format_type"                 = 'IMAGE'
  AND   cs."topic"                          ILIKE '%Health%'
  AND   cs."advertiser_location"            = 'CY'
  AND   cs."advertiser_verification_status" = 'VERIFIED'
LIMIT 20
