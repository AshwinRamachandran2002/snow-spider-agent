Query:
--Description: 9) From the Cyprus-based, VERIFIED, IMAGE Health ads that ran in Croatia (HR)
--between 2023-01-02 and 2023-12-31 and already have times-shown data available
--(times_shown_availability_date IS NULL), return the page-URL of the ad with the
--highest times_shown_upper_bound.
SELECT  t."creative_page_url",
        MAX(s.value:"times_shown_upper_bound"::NUMBER) AS "max_upper_bound"
FROM    GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t,
        LATERAL FLATTEN(INPUT => t."region_stats") s
WHERE   t."ad_format_type"               = 'IMAGE'
  AND   t."advertiser_location"          = 'CY'
  AND   t."advertiser_verification_status" = 'VERIFIED'
  AND   t."topic" ILIKE '%health%'
  AND   s.value:"region_code"::STRING    = 'HR'
  AND   s.value:"first_shown"::DATE   > '2023-01-01'
  AND   s.value:"last_shown"::DATE    < '2024-01-01'
  AND   s.value:"times_shown_availability_date" IS NULL
GROUP BY t."creative_page_url"
ORDER BY "max_upper_bound" DESC
LIMIT 1
Answer:
creative_page_url,max_upper_bound
