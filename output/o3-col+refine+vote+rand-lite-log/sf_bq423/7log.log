        t."creative_page_url",
        s.value:"region_code"::STRING            AS "region_code",
        s.value:"first_shown"::STRING            AS "first_shown",
        s.value:"last_shown"::STRING             AS "last_shown",
        s.value:"times_shown_upper_bound"::NUMBER AS "ts_upper"
