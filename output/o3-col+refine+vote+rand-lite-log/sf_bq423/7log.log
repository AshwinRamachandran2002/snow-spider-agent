LIMIT 20;
```

```sql
--Description: 5) List Cyprus / IMAGE / VERIFIED / Health ads that were shown in Croatia.
SELECT t."creative_id",
       t."creative_page_url",
       s.value:"region_code"::STRING           AS "region_code",
       s.value:"first_shown"::STRING           AS "first_shown",
       s.value:"last_shown"::STRING            AS "last_shown",
       s.value:"times_shown_availability_date" AS "tsa_date"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t,
     LATERAL FLATTEN(INPUT => t."region_stats") s
WHERE t."ad_format_type" = 'IMAGE'
  AND t."advertiser_location" = 'CY'
  AND t."advertiser_verification_status" = 'VERIFIED'
  AND t."topic" ILIKE '%health%'
  AND s.value:"region_code"::STRING = 'HR'
LIMIT 20;
```

```sql
--Description: 6) Tighten the date window to (2023-01-02 … 2023-12-31) and require the times_shown_availability_date to be NULL.
SELECT t."creative_id",
       t."creative_page_url",
       s.value:"first_shown"::STRING  AS "first_shown",
       s.value:"last_shown"::STRING   AS "last_shown",
       s.value:"times_shown_upper_bound"::NUMBER AS "ts_upper"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t,
     LATERAL FLATTEN(INPUT => t."region_stats") s
WHERE t."ad_format_type" = 'IMAGE'
  AND t."advertiser_location" = 'CY'
  AND t."advertiser_verification_status" = 'VERIFIED'
  AND t."topic" ILIKE '%health%'
  AND s.value:"region_code"::STRING = 'HR'
  AND s.value:"first_shown"::DATE  > '2023-01-01'
  AND s.value:"last_shown"::DATE   < '2024-01-01'
  AND s.value:"times_shown_availability_date" IS NULL
LIMIT 20;
```

```sql
--Description: 7) Explore the audience_selection_approach_info JSON to verify that none of the five targeting methods is “CRITERIA_UNUSED”.
SELECT t."creative_id",
       t."creative_page_url",
       t."audience_selection_approach_info":"contextual_signals"  AS "contextual",
       t."audience_selection_approach_info":"customer_lists"      AS "customer_lists",
       t."audience_selection_approach_info":"demographic_info"    AS "demographic",
       t."audience_selection_approach_info":"geo_location"        AS "geo",
       t."audience_selection_approach_info":"topics_of_interest"  AS "topics"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t
WHERE t."creative_id" IN (   -- plug in the creative_id(s) from previous step
        '<<CREATIVE_ID_1>>', '<<CREATIVE_ID_2>>'
     )
LIMIT 20;
```

```sql
--Description: 8) Combine all audience-selection criteria so that every one of the five keys is NOT “CRITERIA_UNUSED”.
SELECT t."creative_id",
       t."creative_page_url"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t
WHERE "creative_id" IN (  -- still working with the cropped set
        '<<CREATIVE_ID_1>>', '<<CREATIVE_ID_2>>'
     )
  AND t."audience_selection_approach_info":"contextual_signals"  <> 'CRITERIA_UNUSED'
  AND t."audience_selection_approach_info":"customer_lists"      <> 'CRITERIA_UNUSED'
  AND t."audience_selection_approach_info":"demographic_info"    <> 'CRITERIA_UNUSED'
  AND t."audience_selection_approach_info":"geo_location"        <> 'CRITERIA_UNUSED'
  AND t."audience_selection_approach_info":"topics_of_interest"  <> 'CRITERIA_UNUSED'
LIMIT 20;
```

```sql
--Description: 9) From the fully qualified set, pick the ad with the highest times_shown_upper_bound in Croatia.
SELECT t."creative_page_url",
       MAX(s.value:"times_shown_upper_bound"::NUMBER) AS max_upper_bound
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t,
     LATERAL FLATTEN(INPUT => t."region_stats") s
WHERE t."ad_format_type" = 'IMAGE'
  AND t."advertiser_location" = 'CY'
  AND t."advertiser_verification_status" = 'VERIFIED'
  AND t."topic" ILIKE '%health%'
  AND s.value:"region_code"::STRING = 'HR'
  AND s.value:"first_shown"::DATE  > '2023-01-01'
  AND s.value:"last_shown"::DATE   < '2024-01-01'
  AND s.value:"times_shown_availability_date" IS NULL
  AND t."audience_selection_approach_info":"contextual_signals"  <> 'CRITERIA_UNUSED'
  AND t."audience_selection_approach_info":"customer_lists"      <> 'CRITERIA_UNUSED'
  AND t."audience_selection_approach_info":"demographic_info"    <> 'CRITERIA_UNUSED'
  AND t."audience_selection_approach_info":"geo_location"        <> 'CRITERIA_UNUSED'
  AND t."audience_selection_approach_info":"topics_of_interest"  <> 'CRITERIA_UNUSED'
GROUP BY t."creative_page_url"
ORDER BY max_upper_bound DESC
LIMIT 1;
```

