Query:
--Description: 5) List Cyprus-based, VERIFIED, IMAGE ads on Health-related topics and show every region they served in (no Croatia filter yet, fewer chances of “no rows”).
SELECT  t."creative_id",
        t."creative_page_url",
        s.value:"region_code"::STRING          AS "region_code",
        s.value:"first_shown"::STRING          AS "first_shown",
        s.value:"last_shown"::STRING           AS "last_shown",
        s.value:"times_shown_availability_date" AS "tsa_date"
FROM    GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t,
        LATERAL FLATTEN(INPUT => t."region_stats") s
WHERE   t."ad_format_type"               = 'IMAGE'
  AND   t."advertiser_location"          = 'CY'
  AND   t."advertiser_verification_status" = 'VERIFIED'
  AND   t."topic" ILIKE '%health%'
LIMIT 20
