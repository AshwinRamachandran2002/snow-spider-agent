```sql
--Description: Identify every Cyprus-based, VERIFIED advertiser’s IMAGE ad on a “Health”-related topic
--that (a) was shown in Croatia (region_code = 'HR'), (b) has first_shown > 2023-01-01
--and last_shown < 2024-01-01, and (c) already has times-shown data available
--(times_shown_availability_date IS NULL).  For each matching ad we show the creative_id,
--page URL, first/last-shown dates, and the times_shown_upper_bound so we can later
--pick the one with the highest reach.  No audience-selection filter yet—this keeps the
--query simple and guarantees some rows.
SELECT  t."creative_id",
        t."creative_page_url",
        s.value:"first_shown"::STRING            AS "first_shown",
        s.value:"last_shown"::STRING             AS "last_shown",
        s.value:"times_shown_upper_bound"::NUMBER AS "ts_upper_bound"
FROM    GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t,
        LATERAL FLATTEN(INPUT => t."region_stats") s
WHERE   t."ad_format_type"              = 'IMAGE'
  AND   t."advertiser_location"         = 'CY'
  AND   t."advertiser_verification_status" = 'VERIFIED'
  AND   t."topic" ILIKE '%health%'
  AND   s.value:"region_code"::STRING   = 'HR'
  AND   s.value:"first_shown"::DATE  > '2023-01-01'
  AND   s.value:"last_shown"::DATE   < '2024-01-01'
  AND   s.value:"times_shown_availability_date" IS NULL
ORDER BY "ts_upper_bound" DESC
LIMIT 20;
```
