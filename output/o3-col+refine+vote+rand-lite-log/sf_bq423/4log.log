```

```sql
--Description: Inspect the structure of region_stats for image ads
SELECT t."creative_id",
       t."creative_page_url",
       rs.value:"region_code"::STRING               AS "region_code",
       rs.value:"first_shown"::STRING               AS "first_shown",
       rs.value:"last_shown"::STRING                AS "last_shown",
       rs.value:"times_shown_availability_date"::STRING AS "times_shown_availability_date",
       rs.value:"times_shown_upper_bound"::INT      AS "times_shown_upper_bound"
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS" t,
     LATERAL FLATTEN(input => PARSE_JSON(t."region_stats")) rs
WHERE t."ad_format_type" = 'IMAGE'
LIMIT 20;
```

