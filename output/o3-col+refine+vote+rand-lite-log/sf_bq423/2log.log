--Description: From the same subset, flatten region_stats to see the regions where they served
SELECT
    t."creative_id",
    region.value:"region_code"::STRING     AS "region_code",
    region.value:"first_shown"::STRING    AS "first_shown",
    region.value:"last_shown"::STRING     AS "last_shown",
    region.value:"times_shown_upper_bound"::NUMBER AS "upper_bound",
    region.value:"times_shown_availability_date"::STRING AS "availability_date"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER."CREATIVE_STATS"  t,
     LATERAL FLATTEN(input => t."region_stats") region
WHERE t."ad_format_type"           = 'IMAGE'
  AND t."advertiser_location"      = 'CY'
  AND t."advertiser_verification_status" = 'VERIFIED'
LIMIT 20;
