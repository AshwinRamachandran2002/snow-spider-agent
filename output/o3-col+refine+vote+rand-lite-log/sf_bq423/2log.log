--Description: Look for any image–format ads whose advertiser is located in Cyprus and verified  
--             (first broad filter – no JSON columns expanded yet, limit 20)
SELECT
    "creative_id",
    "creative_page_url",
    "advertiser_disclosed_name",
    "advertiser_location",
    "advertiser_verification_status",
    "ad_format_type",
    "topic"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER."CREATIVE_STATS"
WHERE "ad_format_type" = 'IMAGE'
  AND "advertiser_location" = 'CY'
  AND "advertiser_verification_status" = 'VERIFIED'
LIMIT 20;
