```sql
--Description: Cross-check that every required audience-selection dimension is **not** 'CRITERIA_UNUSED'
SELECT
    t."creative_id",
    t."creative_page_url",
    asi.value:"contextual_signals"::STRING   AS "contextual_signals",
    asi.value:"customer_lists"::STRING       AS "customer_lists",
    asi.value:"demographic_info"::STRING     AS "demographic_info",
    asi.value:"geo_location"::STRING         AS "geo_location",
    asi.value:"topics_of_interest"::STRING   AS "topics_of_interest"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER."CREATIVE_STATS" t,
     LATERAL (SELECT TRY_PARSE_JSON(t."audience_selection_approach_info") AS asi_json) x,
     LATERAL FLATTEN(input => OBJECT_PACK('root', x.asi_json)) asi
WHERE t."creative_id" = '<PASTE_CREATIVE_ID_FROM_PREVIOUS_QUERY>'
LIMIT 20;
