```sql
--Description: Produce a ranked list (by upper bound) of Health-topic, Cyprus, verified, image ads 
--             fulfilling all temporal & regional constraints; top entry will be required answer
SELECT
    t."creative_page_url",
    t."creative_id",
    region.value:"upper_bound"::NUMBER      AS "times_shown_upper_bound"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER."CREATIVE_STATS" t,
     LATERAL FLATTEN(input => t."region_stats") region,
     LATERAL (SELECT TRY_PARSE_JSON(t."audience_selection_approach_info") AS asi_json) x
WHERE t."ad_format_type" = 'IMAGE'
  AND t."advertiser_location" = 'CY'
  AND t."advertiser_verification_status" = 'VERIFIED'
  AND t."topic" ILIKE '%Health%'
  AND region.value:"region_code"::STRING = 'HR'
  AND region.value:"first_shown"::DATE  > '2023-01-01'
  AND region.value:"last_shown"::DATE   < '2024-01-01'
  AND region.value:"times_shown_availability_date" IS NULL
  AND asi_json:"contextual_signals"      <> 'CRITERIA_UNUSED'
  AND asi_json:"customer_lists"          <> 'CRITERIA_UNUSED'
  AND asi_json:"demographic_info"        <> 'CRITERIA_UNUSED'
  AND asi_json:"geo_location"            <> 'CRITERIA_UNUSED'
  AND asi_json:"topics_of_interest"      <> 'CRITERIA_UNUSED'
ORDER BY region.value:"times_shown_upper_bound"::NUMBER DESC
LIMIT 20;
```

