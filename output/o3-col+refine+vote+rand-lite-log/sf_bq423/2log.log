--Description: Locate the single IMAGE ad that meets *all* stated conditions and return its page-URL.
--             Steps in one query:
--               1. Flatten region_stats to inspect Croatia-specific records.
--               2. Parse audience_selection_approach_info to ensure every targeting dimension
--                  is present and NOT reported as 'CRITERIA_UNUSED'.
--               3. Keep only Health-topic ads from VERIFIED Cyprus-based advertisers,
--                  first shown after 2023-01-01 and last shown before 2024-01-01 in Croatia,
--                  with times_shown data already available (availability_date IS NULL).
--               4. Rank by the highest upper-bound of impressions and return the top result.
WITH croatia_2023 AS (
    SELECT
        t."creative_page_url",
        region.value:"times_shown_upper_bound"::NUMBER      AS times_shown_upper_bound,
        TRY_PARSE_JSON(t."audience_selection_approach_info") AS asi
    FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER."CREATIVE_STATS" t,
         LATERAL FLATTEN(input => t."region_stats") region
    WHERE t."ad_format_type"               = 'IMAGE'
      AND t."advertiser_location"          = 'CY'
      AND t."advertiser_verification_status" = 'VERIFIED'
      AND t."topic" ILIKE '%Health%'
      AND region.value:"region_code"::STRING = 'HR'
      AND region.value:"first_shown"::DATE  > '2023-01-01'
      AND region.value:"last_shown"::DATE   < '2024-01-01'
      AND region.value:"times_shown_availability_date" IS NULL
      AND asi:"contextual_signals"::STRING   != 'CRITERIA_UNUSED'
      AND asi:"customer_lists"::STRING       != 'CRITERIA_UNUSED'
      AND asi:"demographic_info"::STRING     != 'CRITERIA_UNUSED'
      AND asi:"geo_location"::STRING         != 'CRITERIA_UNUSED'
      AND asi:"topics_of_interest"::STRING   != 'CRITERIA_UNUSED'
)
SELECT "creative_page_url"
FROM croatia_2023
QUALIFY ROW_NUMBER() OVER (ORDER BY times_shown_upper_bound DESC) = 1;
