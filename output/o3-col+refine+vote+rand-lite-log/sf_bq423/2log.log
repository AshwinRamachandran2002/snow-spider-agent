Query:
--Description: Find ads from the previous step that were shown in Croatia (HR) between 2023-01-02 and 2023-12-31,
--             and whose times_shown_availability_date is NULL (already available)
SELECT
    t."creative_id",
    t."creative_page_url",
    region.value:"region_code"::STRING  AS "region_code",
    region.value:"first_shown"::STRING  AS "first_shown",
    region.value:"last_shown"::STRING   AS "last_shown",
    region.value:"times_shown_upper_bound"::NUMBER AS "upper_bound",
    region.value:"times_shown_availability_date"        AS "availability_date"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER."CREATIVE_STATS" t,
     LATERAL FLATTEN(input => t."region_stats") region
WHERE t."ad_format_type"                = 'IMAGE'
  AND t."advertiser_location"           = 'CY'
  AND t."advertiser_verification_status"= 'VERIFIED'
  AND region.value:"region_code"::STRING = 'HR'
  AND region.value:"first_shown"::DATE  > '2023-01-01'
  AND region.value:"last_shown"::DATE   < '2024-01-01'
  AND region.value:"times_shown_availability_date" IS NULL
LIMIT 20;
