Query:
--Description: Sanity-check — count creatives that meet the full criteria (should be 1)
SELECT COUNT(*) AS cnt
FROM (
    SELECT t."creative_id"
    FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER."CREATIVE_STATS" AS t
         , LATERAL FLATTEN(input => t."region_stats")               AS region
         , LATERAL (SELECT TRY_PARSE_JSON(t."audience_selection_approach_info") 
                          AS asi_json)                              AS j
    WHERE t."ad_format_type"                  = 'IMAGE'
      AND t."advertiser_location"             = 'CY'
      AND t."advertiser_verification_status"  = 'VERIFIED'
      AND t."topic" ILIKE '%Health%'
      AND region.value:"region_code"::STRING  = 'HR'
      AND region.value:"first_shown"::DATE   > '2023-01-01'
      AND region.value:"last_shown"::DATE    < '2024-01-01'
      AND region.value:"times_shown_availability_date" IS NULL
      AND j.asi_json:"contextual_signals"::STRING   <> 'CRITERIA_UNUSED'
