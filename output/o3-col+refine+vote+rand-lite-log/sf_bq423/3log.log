```sql
--Description: Pick ads whose five selection approaches are all *NOT* ‘CRITERIA_UNUSED’
SELECT "creative_id"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS
WHERE "ad_format_type" = 'IMAGE'
  AND "advertiser_location" = 'CY'
  AND "advertiser_verification_status" = 'VERIFIED'
  AND "topic" ILIKE '%Health%'
  AND "audience_selection_approach_info":"contextual_signals"::STRING   != 'CRITERIA_UNUSED'
  AND "audience_selection_approach_info":"customer_lists"::STRING       != 'CRITERIA_UNUSED'
  AND "audience_selection_approach_info":"demographic_info"::STRING     != 'CRITERIA_UNUSED'
  AND "audience_selection_approach_info":"geo_location"::STRING         != 'CRITERIA_UNUSED'
  AND "audience_selection_approach_info":"topics_of_interest"::STRING   != 'CRITERIA_UNUSED'
LIMIT 20;
```

```sql
--Description: Combine all filters; surface Croatian region rows with upper-bound impressions
SELECT c."creative_page_url",
       r.value:"times_shown_upper_bound"::INTEGER AS "upper_bound"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS c,
     LATERAL FLATTEN(input => c."region_stats") r
WHERE c."ad_format_type" = 'IMAGE'
  AND c."advertiser_location" = 'CY'
  AND c."advertiser_verification_status" = 'VERIFIED'
  AND c."topic" ILIKE '%Health%'
  AND r.value:"region_code"::STRING = 'HR'
  AND r.value:"first_shown"::DATE  > '2023-01-01'
  AND r.value:"last_shown"::DATE   < '2024-01-01'
  AND r.value:"times_shown_availability_date" IS NULL
  AND c."audience_selection_approach_info":"contextual_signals"::STRING   != 'CRITERIA_UNUSED'
  AND c."audience_selection_approach_info":"customer_lists"::STRING       != 'CRITERIA_UNUSED'
  AND c."audience_selection_approach_info":"demographic_info"::STRING     != 'CRITERIA_UNUSED'
  AND c."audience_selection_approach_info":"geo_location"::STRING         != 'CRITERIA_UNUSED'
  AND c."audience_selection_approach_info":"topics_of_interest"::STRING   != 'CRITERIA_UNUSED'
LIMIT 20;
```

```sql
--Description: Final query – same filters, order by highest upper-bound impressions and return the top ad’s page URL
SELECT c."creative_page_url"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS c,
     LATERAL FLATTEN(input => c."region_stats") r
WHERE c."ad_format_type" = 'IMAGE'
  AND c."advertiser_location" = 'CY'
  AND c."advertiser_verification_status" = 'VERIFIED'
  AND c."topic" ILIKE '%Health%'
  AND r.value:"region_code"::STRING = 'HR'
  AND r.value:"first_shown"::DATE  > '2023-01-01'
  AND r.value:"last_shown"::DATE   < '2024-01-01'
  AND r.value:"times_shown_availability_date" IS NULL
  AND c."audience_selection_approach_info":"contextual_signals"::STRING   != 'CRITERIA_UNUSED'
  AND c."audience_selection_approach_info":"customer_lists"::STRING       != 'CRITERIA_UNUSED'
  AND c."audience_selection_approach_info":"demographic_info"::STRING     != 'CRITERIA_UNUSED'
  AND c."audience_selection_approach_info":"geo_location"::STRING         != 'CRITERIA_UNUSED'
  AND c."audience_selection_approach_info":"topics_of_interest"::STRING   != 'CRITERIA_UNUSED'
ORDER BY r.value:"times_shown_upper_bound"::INTEGER DESC NULLS LAST
LIMIT 1;
```
