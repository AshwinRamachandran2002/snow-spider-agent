--Description: Exploration query with step-by-step reasoning inside the WHERE clause.  
-- Goal: Find IMAGE ads from VERIFIED Cyprus advertisers that appeared in Croatia during 2023.  
-- We will also pull the NULL-check on times_shown_availability_date to ensure
-- impression data is already available; topic is kept loose (ILIKE '%Health%').  
-- This single query tells us which creatives meet the main date/region criteria,
-- giving us their upper-bound impressions so we can later decide which one ranks highest.
SELECT
       c."creative_id",
       c."creative_page_url",
       c."topic",
       r.value:"first_shown"::DATE                AS "first_shown",
       r.value:"last_shown"::DATE                 AS "last_shown",
       r.value:"times_shown_upper_bound"::INTEGER AS "upper_bound"
FROM  GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS  c,
      LATERAL FLATTEN(input => c."region_stats") r
WHERE c."ad_format_type"              = 'IMAGE'          -- image-type ads
  AND c."advertiser_location"         = 'CY'             -- advertiser located in Cyprus
  AND c."advertiser_verification_status" = 'VERIFIED'    -- verified advertiser
  AND c."topic" ILIKE '%Health%'                         -- Health-related topic
  AND r.value:"region_code"::STRING   = 'HR'             -- served in Croatia
  AND r.value:"first_shown"::DATE     > '2023-01-01'     -- first_shown strictly after Jan-01-2023
  AND r.value:"last_shown"::DATE      < '2024-01-01'     -- last_shown strictly before Jan-01-2024
  AND r.value:"times_shown_availability_date" IS NULL    -- times_shown data is available
LIMIT 20;
