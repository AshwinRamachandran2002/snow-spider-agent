```sql
--Description: 1) Quick look at some rows of the main table
SELECT *
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS"
LIMIT 20;
```

```sql
--Description: 2) Focus on image ads only
SELECT *
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS"
WHERE "ad_format_type" = 'IMAGE'
LIMIT 20;
```

```sql
--Description: 3) Image ads coming from advertisers located in Cyprus (CY) that are VERIFIED
SELECT *
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS"
WHERE "ad_format_type" = 'IMAGE'
  AND "advertiser_location" = 'CY'
  AND "advertiser_verification_status" = 'VERIFIED'
LIMIT 20;
```

```sql
--Description: 4) Among those, show which ones were served in Croatia (HR) by flattening "region_stats"
SELECT
    t."creative_id",
    f.value:"region_code"::STRING  AS "region_code",
    f.value:"first_shown"::STRING  AS "first_shown",
    f.value:"last_shown"::STRING   AS "last_shown",
    f.value:"times_shown_availability_date"::STRING AS "tsa_date"
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS"  t,
     LATERAL FLATTEN(input => t."region_stats")                       f
WHERE t."ad_format_type"                = 'IMAGE'
  AND t."advertiser_location"           = 'CY'
  AND t."advertiser_verification_status"= 'VERIFIED'
  AND f.value:"region_code"::STRING     = 'HR'
LIMIT 20;
```

```sql
--Description: 5) Now narrow to the required date window (first_shown > 2023-01-01 AND last_shown < 2024-01-01)
SELECT
    t."creative_id",
    f.value:"region_code"::STRING  AS "region_code",
    f.value:"first_shown"::STRING  AS "first_shown",
    f.value:"last_shown"::STRING   AS "last_shown"
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS"  t,
     LATERAL FLATTEN(input => t."region_stats")                       f
WHERE t."ad_format_type"                = 'IMAGE'
  AND t."advertiser_location"           = 'CY'
  AND t."advertiser_verification_status"= 'VERIFIED'
  AND f.value:"region_code"::STRING     = 'HR'
  AND f.value:"first_shown"::STRING  >  '2023-01-01'
  AND f.value:"last_shown"::STRING   <  '2024-01-01'
LIMIT 20;
```

```sql
--Description: 6) Keep only rows where times_shown_availability_date is NULL (meaning data already available)
SELECT
    t."creative_id",
    f.value:"region_code"::STRING  AS "region_code",
    f.value:"times_shown_availability_date" AS "tsa_date"
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS"  t,
     LATERAL FLATTEN(input => t."region_stats")                       f
WHERE t."ad_format_type"                = 'IMAGE'
  AND t."advertiser_location"           = 'CY'
  AND t."advertiser_verification_status"= 'VERIFIED'
  AND f.value:"region_code"::STRING     = 'HR'
  AND f.value:"first_shown"::STRING  >  '2023-01-01'
  AND f.value:"last_shown"::STRING   <  '2024-01-01'
  AND f.value:"times_shown_availability_date" IS NULL
LIMIT 20;
```

```sql
--Description: 7) Filter for Health-related topic and ensure NO audience criteria is 'CRITERIA_UNUSED'
SELECT
    t."creative_id",
    t."creative_page_url",
    t."topic",
    t."audience_selection_approach_info"
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS"  t,
     LATERAL FLATTEN(input => t."region_stats")                       f
WHERE t."ad_format_type"                = 'IMAGE'
  AND t."advertiser_location"           = 'CY'
  AND t."advertiser_verification_status"= 'VERIFIED'
  AND t."topic" ILIKE '%Health%'
  AND t."audience_selection_approach_info" NOT ILIKE '%CRITERIA_UNUSED%'
  AND f.value:"region_code"::STRING     = 'HR'
  AND f.value:"first_shown"::STRING  >  '2023-01-01'
  AND f.value:"last_shown"::STRING   <  '2024-01-01'
  AND f.value:"times_shown_availability_date" IS NULL
LIMIT 20;
```

```sql
--Description: 8) See the times_shown_upper_bound values to identify the ad with the highest reach
SELECT
    t."creative_page_url",
    f.value:"times_shown_upper_bound"::INTEGER AS "times_shown_upper_bound"
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS"  t,
     LATERAL FLATTEN(input => t."region_stats")                       f
WHERE t."ad_format_type"                = 'IMAGE'
  AND t."advertiser_location"           = 'CY'
  AND t."advertiser_verification_status"= 'VERIFIED'
  AND t."topic" ILIKE '%Health%'
  AND t."audience_selection_approach_info" NOT ILIKE '%CRITERIA_UNUSED%'
  AND f.value:"region_code"::STRING     = 'HR'
  AND f.value:"first_shown"::STRING  >  '2023-01-01'
  AND f.value:"last_shown"::STRING   <  '2024-01-01'
  AND f.value:"times_shown_availability_date" IS NULL
ORDER BY "times_shown_upper_bound" DESC
LIMIT 20;
```

```sql
--Description: 9) Return the single page-URL of the qualifying ad with the highest upper bound of times shown
SELECT
    t."creative_page_url"
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS"  t,
     LATERAL FLATTEN(input => t."region_stats")                       f
WHERE t."ad_format_type"                = 'IMAGE'
  AND t."advertiser_location"           = 'CY'
  AND t."advertiser_verification_status"= 'VERIFIED'
  AND t."topic" ILIKE '%Health%'
  AND t."audience_selection_approach_info" NOT ILIKE '%CRITERIA_UNUSED%'
  AND f.value:"region_code"::STRING     = 'HR'
  AND f.value:"first_shown"::STRING  >  '2023-01-01'
  AND f.value:"last_shown"::STRING   <  '2024-01-01'
  AND f.value:"times_shown_availability_date" IS NULL
ORDER BY f.value:"times_shown_upper_bound"::INTEGER DESC
LIMIT 1;
```

```sql
--Description: 10) (Optional cross-check) Show all audience-selection attributes for the winning ad
SELECT
    t."creative_page_url",
    t."audience_selection_approach_info"
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS" t
WHERE t."creative_page_url" = (
      SELECT
          t2."creative_page_url"
      FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS"  t2,
           LATERAL FLATTEN(input => t2."region_stats")                     f2
      WHERE t2."ad_format_type"                = 'IMAGE'
        AND t2."advertiser_location"           = 'CY'
        AND t2."advertiser_verification_status"= 'VERIFIED'
        AND t2."topic" ILIKE '%Health%'
        AND t2."audience_selection_approach_info" NOT ILIKE '%CRITERIA_UNUSED%'
        AND f2.value:"region_code"::STRING     = 'HR'
        AND f2.value:"first_shown"::STRING  >  '2023-01-01'
        AND f2.value:"last_shown"::STRING   <  '2024-01-01'
        AND f2.value:"times_shown_availability_date" IS NULL
      ORDER BY f2.value:"times_shown_upper_bound"::INTEGER DESC
      LIMIT 1
);
```
