```sql
-- Description: Count how many cities were inserted for every year-month combination.
SELECT substr(insert_date, 1, 4)  AS yr,
       substr(insert_date, 6, 2)  AS mon,
       COUNT(*)                   AS qty
FROM   "cities"
GROUP  BY yr, mon
ORDER  BY yr, mon
LIMIT 20;
```

```sql
-- Description: Focus on April, May, June (04, 05, 06) for 2021-2023, showing monthly totals.
SELECT substr(insert_date, 1, 4)  AS yr,
       substr(insert_date, 6, 2)  AS mon,
       COUNT(*)                   AS month_total
FROM   "cities"
WHERE  substr(insert_date, 1, 4) BETWEEN '2021' AND '2023'
  AND  substr(insert_date, 6, 2) IN ('04','05','06')
GROUP  BY yr, mon
ORDER  BY yr, mon;
```

```sql
-- Description: Compute the running (cumulative) total per month across years for Apr-Jun.
WITH monthly AS (
  SELECT substr(insert_date, 1, 4) AS yr,
         substr(insert_date, 6, 2) AS mon,
         COUNT(*)                  AS month_total
  FROM   "cities"
  WHERE  substr(insert_date, 1, 4) BETWEEN '2021' AND '2023'
    AND  substr(insert_date, 6, 2) IN ('04','05','06')
  GROUP  BY yr, mon
)
SELECT yr,
       mon,
       month_total,
       (SELECT SUM(m2.month_total)
        FROM monthly AS m2
        WHERE m2.mon = m.mon
          AND m2.yr <= m.yr) AS running_total
FROM   monthly AS m
ORDER  BY mon, yr;
```

```sql
-- Description: Produce the final answer (2022, 2023 only) with YoY % growth for month total and running total.
WITH monthly AS (
  SELECT substr(insert_date, 1, 4) AS yr,
         substr(insert_date, 6, 2) AS mon,
         COUNT(*)                  AS month_total
  FROM   "cities"
  WHERE  substr(insert_date, 1, 4) BETWEEN '2021' AND '2023'
    AND  substr(insert_date, 6, 2) IN ('04','05','06')
  GROUP  BY yr, mon
),
running AS (
  SELECT m1.yr,
         m1.mon,
         m1.month_total,
         (SELECT SUM(m2.month_total)
          FROM monthly m2
          WHERE m2.mon = m1.mon
            AND m2.yr <= m1.yr) AS running_total
  FROM monthly m1
)
SELECT r.yr,
       r.mon,
       r.month_total,
       r.running_total,
       ROUND(100.0 * (r.month_total  - r_prev.month_total)  / r_prev.month_total, 2)  AS pct_growth_month,
       ROUND(100.0 * (r.running_total- r_prev.running_total)/ r_prev.running_total, 2) AS pct_growth_running
FROM   running AS r
JOIN   running AS r_prev
  ON   r_prev.mon = r.mon
 AND   CAST(r_prev.yr AS INTEGER) = CAST(r.yr AS INTEGER) - 1
WHERE  r.yr IN ('2022','2023')
ORDER  BY r.mon, r.yr;
```
