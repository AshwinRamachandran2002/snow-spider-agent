Query:
-- Description: Compute the running (cumulative) total per month across years for Apr-Jun.
WITH monthly AS (
  SELECT substr(insert_date, 1, 4) AS yr,
         substr(insert_date, 6, 2) AS mon,
         COUNT(*)                  AS month_total
  FROM   "cities"
  WHERE  substr(insert_date, 1, 4) BETWEEN '2021' AND '2023'
    AND  substr(insert_date, 6, 2) IN ('04','05','06')
  GROUP  BY yr, mon
)
SELECT yr,
       mon,
       month_total,
       (SELECT SUM(m2.month_total)
        FROM monthly AS m2
        WHERE m2.mon = m.mon
          AND m2.yr <= m.yr) AS running_total
FROM   monthly AS m
ORDER  BY mon, yr;
