```sql
--Description: Calculate, for April-June, the 2022-2023 monthly city-insert totals, the cumulative
--running totals of those months across years (using 2021-2023 data), and the YoY growth
--percentages versus the previous year.  Steps:
--1) month_cnt – count how many cities were inserted in Apr/May/Jun for each year 2021-2023.
--2) running   – add a window SUM to get the cumulative running total for each month across years.
--3) prev      – use LAG to pull the previous year’s totals so we can compute YoY growth.
--4) Final SELECT – keep only 2022 and 2023, compute YoY % for the month and for the running total,
--                  and order chronologically.
WITH month_cnt AS (
    SELECT
        strftime('%Y', insert_date)                              AS year,
        strftime('%m', insert_date)                              AS mon_num,
        CASE strftime('%m', insert_date)
             WHEN '04' THEN 'April'
             WHEN '05' THEN 'May'
             WHEN '06' THEN 'June'
        END                                                     AS month_name,
        COUNT(*)                                                AS month_total
    FROM cities
    WHERE strftime('%m', insert_date) IN ('04','05','06')
      AND strftime('%Y', insert_date) BETWEEN '2021' AND '2023'
    GROUP BY year, mon_num
),
running AS (
    SELECT
        m.*,
        SUM(month_total) OVER (PARTITION BY mon_num
                               ORDER BY year)                    AS running_total
    FROM month_cnt AS m
),
prev AS (
    SELECT
        r.*,
        LAG(month_total)   OVER (PARTITION BY mon_num ORDER BY year) AS prev_month_total,
        LAG(running_total) OVER (PARTITION BY mon_num ORDER BY year) AS prev_running_total
    FROM running AS r
)
SELECT
    year,
    month_name,
    month_total,
    running_total,
    ROUND( (month_total  - prev_month_total)  * 100.0 / prev_month_total, 2)  AS YoY_month_pct,
    ROUND( (running_total - prev_running_total) * 100.0 / prev_running_total, 2) AS YoY_running_pct
FROM prev
WHERE year IN ('2022','2023')
ORDER BY
    year,
    CASE month_name WHEN 'April' THEN 1 WHEN 'May' THEN 2 WHEN 'June' THEN 3 END;
```
