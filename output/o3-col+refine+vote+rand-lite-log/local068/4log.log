Query:
-- Description: Add year-over-year (YoY) growth for both the monthly total and the running total by using
--              LAG to pull the previous year’s values.  Still keep 2021 so we can reference it.
WITH month_counts AS (
    SELECT 
           substr("insert_date",1,4)                AS year,
           substr("insert_date",6,2)                AS month_num,
           CASE substr("insert_date",6,2)
                WHEN '04' THEN 'April'
                WHEN '05' THEN 'May'
                WHEN '06' THEN 'June'
           END                                      AS month_name,
           COUNT(*)                                 AS monthly_total
    FROM   "cities"
    WHERE  substr("insert_date",6,2) IN ('04','05','06')
      AND  substr("insert_date",1,4) BETWEEN '2021' AND '2023'
    GROUP  BY year, month_num
), running AS (
    SELECT
           year,
           month_num,
           month_name,
           monthly_total,
           SUM(monthly_total) OVER (PARTITION BY month_num
                                    ORDER BY year)  AS running_total
    FROM   month_counts
)
SELECT
       year,
       month_name,
       monthly_total,
       running_total,
       ROUND(100.0 * (monthly_total - LAG(monthly_total) OVER (PARTITION BY month_num ORDER BY year))
                    / LAG(monthly_total) OVER (PARTITION BY month_num ORDER BY year), 2) AS yoy_monthly_growth_pct,
       ROUND(100.0 * (running_total - LAG(running_total) OVER (PARTITION BY month_num ORDER BY year))
                    / LAG(running_total) OVER (PARTITION BY month_num ORDER BY year), 2) AS yoy_running_growth_pct
FROM   running
ORDER  BY month_name, year;
