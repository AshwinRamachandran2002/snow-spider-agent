Query:
-- Description: Produce the final answer required by the task:
--              keep only 2022-2023, display year, month, monthly total, cumulative running total,
--              plus YoY growth figures (2021 serves solely as the baseline for growth calculations).
WITH month_counts AS (
    SELECT 
           substr("insert_date",1,4)                AS year,
           substr("insert_date",6,2)                AS month_num,
           CASE substr("insert_date",6,2)
                WHEN '04' THEN 'April'
                WHEN '05' THEN 'May'
                WHEN '06' THEN 'June'
           END                                      AS month_name,
           COUNT(*)                                 AS monthly_total
    FROM   "cities"
    WHERE  substr("insert_date",6,2) IN ('04','05','06')
      AND  substr("insert_date",1,4) BETWEEN '2021' AND '2023'
    GROUP  BY year, month_num
), running AS (
    SELECT
           year,
           month_num,
           month_name,
           monthly_total,
           SUM(monthly_total) OVER (PARTITION BY month_num
                                    ORDER BY year)  AS running_total
    FROM   month_counts
)
SELECT
       year,
       month_name,
       monthly_total               AS "cities_added_in_month",
       running_total               AS "running_total_for_month",
       ROUND(100.0 * (monthly_total - LAG(monthly_total) OVER (PARTITION BY month_num ORDER BY year))
                    / LAG(monthly_total) OVER (PARTITION BY month_num ORDER BY year), 2)
                                    AS "yoy_growth_pct_monthly",
       ROUND(100.0 * (running_total - LAG(running_total) OVER (PARTITION BY month_num ORDER BY year))
                    / LAG(running_total) OVER (PARTITION BY month_num ORDER BY year), 2)
                                    AS "yoy_growth_pct_running"
FROM   running
WHERE  year IN ('2022','2023')
ORDER  BY month_name, year;
