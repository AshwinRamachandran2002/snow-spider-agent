```sql
-- Description: Count the number of cities inserted per year-month for April, May, June (2021-2023).
SELECT strftime('%Y', "insert_date") AS "year",
       strftime('%m', "insert_date") AS "month",
       COUNT(*)                       AS "month_total"
FROM   "cities"
WHERE  strftime('%m', "insert_date") IN ('04','05','06')
  AND  strftime('%Y', "insert_date") BETWEEN '2021' AND '2023'
GROUP  BY "year", "month"
ORDER  BY "year", "month"
LIMIT 20;
```

```sql
-- Description: Add the cumulative running total for each month across the years (2021-2023).
SELECT "year",
       "month",
       "month_total",
       SUM("month_total") OVER (PARTITION BY "month" ORDER BY "year") AS "running_total"
FROM   (
        SELECT strftime('%Y', "insert_date") AS "year",
               strftime('%m', "insert_date") AS "month",
               COUNT(*)                       AS "month_total"
        FROM   "cities"
        WHERE  strftime('%m', "insert_date") IN ('04','05','06')
          AND  strftime('%Y', "insert_date") BETWEEN '2021' AND '2023'
        GROUP  BY "year", "month"
       )
ORDER BY "year", "month"
LIMIT 20;
```

```sql
-- Description: Compute the year-over-year (YoY) growth for the monthly total and running total.
SELECT "year",
       "month",
       "month_total",
       "running_total",
       ROUND(
             ( "month_total" - LAG("month_total") OVER (PARTITION BY "month" ORDER BY "year") )
             * 100.0
             / LAG("month_total") OVER (PARTITION BY "month" ORDER BY "year"),
             2
       ) AS "yoy_month_pct",
       ROUND(
             ( "running_total" - LAG("running_total") OVER (PARTITION BY "month" ORDER BY "year") )
             * 100.0
             / LAG("running_total") OVER (PARTITION BY "month" ORDER BY "year"),
             2
       ) AS "yoy_running_pct"
FROM   (
        SELECT "year",
               "month",
               "month_total",
               SUM("month_total") OVER (PARTITION BY "month" ORDER BY "year") AS "running_total"
        FROM   (
                SELECT strftime('%Y', "insert_date") AS "year",
                       strftime('%m', "insert_date") AS "month",
                       COUNT(*)                       AS "month_total"
                FROM   "cities"
                WHERE  strftime('%m', "insert_date") IN ('04','05','06')
                  AND  strftime('%Y', "insert_date") BETWEEN '2021' AND '2023'
                GROUP  BY "year", "month"
               )
       )
ORDER BY "year", "month"
LIMIT 20;
```

```sql
-- Description: Final result – only 2022 and 2023, including YoY growth (2021 used only as baseline).
SELECT *
FROM   (
        SELECT "year",
               CASE "month"
                    WHEN '04' THEN 'April'
                    WHEN '05' THEN 'May'
                    WHEN '06' THEN 'June'
               END                                   AS "month_name",
               "month_total",
               "running_total",
               "yoy_month_pct",
               "yoy_running_pct"
        FROM   (
                SELECT "year",
                       "month",
                       "month_total",
                       "running_total",
                       ROUND(
                             ( "month_total" - LAG("month_total") OVER (PARTITION BY "month" ORDER BY "year") )
                             * 100.0
                             / LAG("month_total") OVER (PARTITION BY "month" ORDER BY "year"),
                             2
                       ) AS "yoy_month_pct",
                       ROUND(
                             ( "running_total" - LAG("running_total") OVER (PARTITION BY "month" ORDER BY "year") )
                             * 100.0
                             / LAG("running_total") OVER (PARTITION BY "month" ORDER BY "year"),
                             2
                       ) AS "yoy_running_pct"
                FROM   (
                        SELECT "year",
                               "month",
                               "month_total",
                               SUM("month_total") OVER (PARTITION BY "month" ORDER BY "year") AS "running_total"
                        FROM   (
                                SELECT strftime('%Y', "insert_date") AS "year",
                                       strftime('%m', "insert_date") AS "month",
                                       COUNT(*)                       AS "month_total"
                                FROM   "cities"
                                WHERE  strftime('%m', "insert_date") IN ('04','05','06')
                                  AND  strftime('%Y', "insert_date") BETWEEN '2021' AND '2023'
                                GROUP  BY "year", "month"
                               )
                       )
               )
       )
WHERE  "year" IN ('2022','2023')
ORDER BY "year", "month_name"
LIMIT 20;
```

