Query:
-- Description: Add the cumulative running total for each month across the years (2021-2023).
SELECT "year",
       "month",
       "month_total",
       SUM("month_total") OVER (PARTITION BY "month" ORDER BY "year") AS "running_total"
FROM   (
        SELECT strftime('%Y', "insert_date") AS "year",
               strftime('%m', "insert_date") AS "month",
               COUNT(*)                       AS "month_total"
        FROM   "cities"
        WHERE  strftime('%m', "insert_date") IN ('04','05','06')
          AND  strftime('%Y', "insert_date") BETWEEN '2021' AND '2023'
        GROUP  BY "year", "month"
       )
ORDER BY "year", "month"
LIMIT 20;
