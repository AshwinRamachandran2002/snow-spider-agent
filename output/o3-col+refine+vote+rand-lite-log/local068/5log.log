```sql
-- Description: Compute the cumulative running total for each month (04-06) across years up to and including that year.  
SELECT c."year",
       c."month",
       c."month_total",
       SUM(c."month_total") OVER (PARTITION BY c."month"
                                  ORDER BY c."year") AS "running_total"
FROM (
    SELECT SUBSTR("insert_date",1,4)  AS "year",
           SUBSTR("insert_date",6,2)  AS "month",
           COUNT(*)                   AS "month_total"
    FROM "cities"
    WHERE SUBSTR("insert_date",1,4) BETWEEN '2021' AND '2023'
      AND SUBSTR("insert_date",6,2) IN ('04','05','06')
    GROUP BY "year","month"
) AS c
ORDER BY c."year", c."month"
LIMIT 20;
```

```sql
-- Description: Add YoY growth for both the month total and its running total, comparing each year to the previous year.  
SELECT c."year",
       c."month",
       c."month_total",
       c."running_total",
       ROUND( (c."month_total"  - LAG(c."month_total")  OVER (PARTITION BY c."month" ORDER BY c."year"))
              *100.0 / NULLIF(LAG(c."month_total")  OVER (PARTITION BY c."month" ORDER BY c."year"),0), 2)
              AS "month_yoy_growth_pct",
       ROUND( (c."running_total"  - LAG(c."running_total")  OVER (PARTITION BY c."month" ORDER BY c."year"))
              *100.0 / NULLIF(LAG(c."running_total")  OVER (PARTITION BY c."month" ORDER BY c."year"),0), 2)
              AS "running_yoy_growth_pct"
FROM (
    SELECT SUBSTR("insert_date",1,4)  AS "year",
           SUBSTR("insert_date",6,2)  AS "month",
           COUNT(*)                   AS "month_total",
           SUM(COUNT(*)) OVER (PARTITION BY SUBSTR("insert_date",6,2)
                               ORDER BY SUBSTR("insert_date",1,4)) AS "running_total"
    FROM "cities"
    WHERE SUBSTR("insert_date",1,4) BETWEEN '2021' AND '2023'
      AND SUBSTR("insert_date",6,2) IN ('04','05','06')
    GROUP BY "year","month"
) AS c
ORDER BY c."year", c."month"
LIMIT 20;
```

```sql
-- Description: Final report – keep only 2022 & 2023, rename months for readability (April, May, June).  
SELECT CASE c."month"
          WHEN '04' THEN 'April'
          WHEN '05' THEN 'May'
          WHEN '06' THEN 'June'
       END                                AS "month",
       c."year",
       c."month_total"                    AS "cities_added_in_month",
       c."running_total"                  AS "cumulative_running_total",
       c."month_yoy_growth_pct"           AS "MoM_total_YoY_growth_pct",
       c."running_yoy_growth_pct"         AS "Running_total_YoY_growth_pct"
FROM (
    SELECT c1.*,
           ROUND( (c1."month_total" - LAG(c1."month_total") OVER (PARTITION BY c1."month" ORDER BY c1."year"))
                  *100.0 / NULLIF(LAG(c1."month_total") OVER (PARTITION BY c1."month" ORDER BY c1."year"),0), 2)
                  AS "month_yoy_growth_pct",
           ROUND( (c1."running_total" - LAG(c1."running_total") OVER (PARTITION BY c1."month" ORDER BY c1."year"))
                  *100.0 / NULLIF(LAG(c1."running_total") OVER (PARTITION BY c1."month" ORDER BY c1."year"),0), 2)
                  AS "running_yoy_growth_pct"
    FROM (
        SELECT SUBSTR("insert_date",1,4)  AS "year",
               SUBSTR("insert_date",6,2)  AS "month",
               COUNT(*)                   AS "month_total",
               SUM(COUNT(*)) OVER (PARTITION BY SUBSTR("insert_date",6,2) ORDER BY SUBSTR("insert_date",1,4))
                                         AS "running_total"
        FROM "cities"
        WHERE SUBSTR("insert_date",1,4) BETWEEN '2021' AND '2023'
          AND SUBSTR("insert_date",6,2) IN ('04','05','06')
        GROUP BY "year","month"
    ) AS c1
) AS c
WHERE c."year" IN ('2022','2023')
ORDER BY c."year","month"
LIMIT 20;
```

