Query:
-- Description: Compute the cumulative running total for each month (04-06) across years up to and including that year.  
SELECT c."year",
       c."month",
       c."month_total",
       SUM(c."month_total") OVER (PARTITION BY c."month"
                                  ORDER BY c."year") AS "running_total"
FROM (
    SELECT SUBSTR("insert_date",1,4)  AS "year",
           SUBSTR("insert_date",6,2)  AS "month",
           COUNT(*)                   AS "month_total"
    FROM "cities"
    WHERE SUBSTR("insert_date",1,4) BETWEEN '2021' AND '2023'
      AND SUBSTR("insert_date",6,2) IN ('04','05','06')
    GROUP BY "year","month"
) AS c
ORDER BY c."year", c."month"
LIMIT 20;
