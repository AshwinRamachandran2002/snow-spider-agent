```sql
--Description: We need, for April–June, 1) monthly counts of new cities for 2021-2023,  
--             2) cumulative running totals by month, 3) YoY % growth of both metrics,  
--             4) final output only for 2022-2023.  
--             CTE-1 month_counts  -> raw monthly totals.  
--             CTE-2 running       -> add cumulative totals per month.  
--             CTE-3 growth        -> compute YoY % for month_total & running_total.  
--             Final SELECT        -> keep years 2022-2023, convert month codes to names,  
--                                    order April-May-June then by year.
WITH month_counts AS (
    SELECT SUBSTR(insert_date,1,4) AS year,
           SUBSTR(insert_date,6,2) AS month,
           COUNT(*)               AS month_total
    FROM   cities
    WHERE  SUBSTR(insert_date,1,4) BETWEEN '2021' AND '2023'
      AND  SUBSTR(insert_date,6,2) IN ('04','05','06')
    GROUP  BY year, month
),
running AS (
    SELECT mc.*,
           SUM(month_total) OVER (PARTITION BY month ORDER BY year) AS running_total
    FROM month_counts mc
),
growth AS (
    SELECT r.*,
           ROUND(
               (r.month_total - LAG(r.month_total) OVER (PARTITION BY r.month ORDER BY r.year))
               *100.0 / NULLIF(LAG(r.month_total) OVER (PARTITION BY r.month ORDER BY r.year),0)
           ,2) AS month_yoy_growth_pct,
           ROUND(
               (r.running_total - LAG(r.running_total) OVER (PARTITION BY r.month ORDER BY r.year))
               *100.0 / NULLIF(LAG(r.running_total) OVER (PARTITION BY r.month ORDER BY r.year),0)
           ,2) AS running_yoy_growth_pct
    FROM running r
)
SELECT CASE month WHEN '04' THEN 'April'
                  WHEN '05' THEN 'May'
                  WHEN '06' THEN 'June' END      AS month,
       year,
       month_total                              AS cities_added_in_month,
       running_total                            AS cumulative_running_total,
       month_yoy_growth_pct                     AS monthly_total_yoy_growth_pct,
       running_yoy_growth_pct                   AS running_total_yoy_growth_pct
FROM   growth
WHERE  year IN ('2022','2023')
ORDER  BY CASE month WHEN '04' THEN 1 WHEN '05' THEN 2 WHEN '06' THEN 3 END,
          year;
```
