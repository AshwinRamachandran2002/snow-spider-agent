-- Description: Add YoY growth for both the month total and its running total, comparing each year to the previous year.  
SELECT c."year",
       c."month",
       c."month_total",
       c."running_total",
       ROUND( (c."month_total"  - LAG(c."month_total")  OVER (PARTITION BY c."month" ORDER BY c."year"))
              *100.0 / NULLIF(LAG(c."month_total")  OVER (PARTITION BY c."month" ORDER BY c."year"),0), 2)
              AS "month_yoy_growth_pct",
       ROUND( (c."running_total"  - LAG(c."running_total")  OVER (PARTITION BY c."month" ORDER BY c."year"))
              *100.0 / NULLIF(LAG(c."running_total")  OVER (PARTITION BY c."month" ORDER BY c."year"),0), 2)
              AS "running_yoy_growth_pct"
FROM (
    SELECT SUBSTR("insert_date",1,4)  AS "year",
           SUBSTR("insert_date",6,2)  AS "month",
           COUNT(*)                   AS "month_total",
           SUM(COUNT(*)) OVER (PARTITION BY SUBSTR("insert_date",6,2)
                               ORDER BY SUBSTR("insert_date",1,4)) AS "running_total"
    FROM "cities"
    WHERE SUBSTR("insert_date",1,4) BETWEEN '2021' AND '2023'
      AND SUBSTR("insert_date",6,2) IN ('04','05','06')
    GROUP BY "year","month"
) AS c
ORDER BY c."year", c."month"
LIMIT 20;
