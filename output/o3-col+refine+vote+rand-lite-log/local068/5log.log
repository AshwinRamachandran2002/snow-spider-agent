-- Description: Final report – keep only 2022 & 2023, rename months for readability (April, May, June).  
SELECT CASE c."month"
          WHEN '04' THEN 'April'
          WHEN '05' THEN 'May'
          WHEN '06' THEN 'June'
       END                                AS "month",
       c."year",
       c."month_total"                    AS "cities_added_in_month",
       c."running_total"                  AS "cumulative_running_total",
       c."month_yoy_growth_pct"           AS "MoM_total_YoY_growth_pct",
       c."running_yoy_growth_pct"         AS "Running_total_YoY_growth_pct"
FROM (
    SELECT c1.*,
           ROUND( (c1."month_total" - LAG(c1."month_total") OVER (PARTITION BY c1."month" ORDER BY c1."year"))
                  *100.0 / NULLIF(LAG(c1."month_total") OVER (PARTITION BY c1."month" ORDER BY c1."year"),0), 2)
                  AS "month_yoy_growth_pct",
           ROUND( (c1."running_total" - LAG(c1."running_total") OVER (PARTITION BY c1."month" ORDER BY c1."year"))
                  *100.0 / NULLIF(LAG(c1."running_total") OVER (PARTITION BY c1."month" ORDER BY c1."year"),0), 2)
                  AS "running_yoy_growth_pct"
    FROM (
        SELECT SUBSTR("insert_date",1,4)  AS "year",
               SUBSTR("insert_date",6,2)  AS "month",
               COUNT(*)                   AS "month_total",
               SUM(COUNT(*)) OVER (PARTITION BY SUBSTR("insert_date",6,2) ORDER BY SUBSTR("insert_date",1,4))
                                         AS "running_total"
        FROM "cities"
        WHERE SUBSTR("insert_date",1,4) BETWEEN '2021' AND '2023'
          AND SUBSTR("insert_date",6,2) IN ('04','05','06')
        GROUP BY "year","month"
    ) AS c1
) AS c
WHERE c."year" IN ('2022','2023')
ORDER BY c."year","month"
LIMIT 20;
