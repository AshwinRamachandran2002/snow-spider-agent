```sql
--Description:
--  Single-statement solution that produces, for CPC codes beginning with “A01B3…”,
--  the top-3 assignees by total number of applications, then for each of those
--  assignees:
--     • the calendar year in which they filed the most such applications,
--     • how many they filed in that peak year,
--     • and the country code with the highest share of those filings in that year.
--  Steps inside CTEs
--     1) cpc_apps   – all applications that contain at least one “A01B3%” CPC code,
--                     together with their assignee name, filing date, country code.
--     2) ranked     – the three assignees with the greatest overall application counts.
--     3) yearly     – year-by-year counts for each of those assignees.
--     4) best_year  – pick the single year with the maximum filings for each assignee.
--     5) country_ct – inside each best year, count applications per country code and
--                     keep only the leading country.
--  Final SELECT     – return the requested five columns, ordered by total filings.
WITH cpc_apps AS (         -- every A01B3 application with its assignee
    SELECT
        p."application_number",
        p."filing_date",
        p."country_code",
        a.value::VARIANT:"name"::STRING  AS assignee
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN (INPUT => p."cpc")               c,
         LATERAL FLATTEN (INPUT => p."assignee_harmonized") a
    WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
),
ranked AS (                 -- top-3 assignees by volume
    SELECT
        assignee,
        COUNT(DISTINCT "application_number")  AS total_apps
    FROM cpc_apps
    GROUP BY assignee
    ORDER BY total_apps DESC
    LIMIT 3
),
yearly AS (                 -- yearly counts for each top assignee
    SELECT
        r.assignee,
        FLOOR(c.filing_date/10000)           AS yr,
        COUNT(DISTINCT c."application_number") AS apps_year
    FROM cpc_apps            c
    JOIN ranked              r  ON c.assignee = r.assignee
    GROUP BY r.assignee, yr
),
best_year AS (              -- pick the max year per assignee
    SELECT
        *,
        ROW_NUMBER() OVER (PARTITION BY assignee ORDER BY apps_year DESC) AS rk
    FROM yearly
),
country_ct AS (             -- country distribution within each best year
    SELECT
        b.assignee,
        b.yr,
        c.country_code,
