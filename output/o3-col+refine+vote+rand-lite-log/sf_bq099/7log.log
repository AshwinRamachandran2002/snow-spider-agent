```sql
--Description:
--  One-step solution that produces, for CPC class codes beginning with “A01B3…”,
--  the top-3 assignees (by total number of such applications) and,
--  for each assignee:
--     • total number of A01B3-tagged applications,
--     • the calendar year with the highest count of those applications,
--     • the number of applications in that peak year,
--     • and the country code with the most applications in that same year.
--
--  CTE logic
--    cpc_apps   : explode PUBLICATIONS to one row per (application, assignee) that
--                 contains an “A01B3%” CPC symbol.
--    top3       : pick the three assignees with the largest overall counts.
--    yearly     : count applications per (assignee, year).
--    best_year  : keep the single highest-count year per assignee.
--    country_ct : within each best year, count apps per country and keep the leader.
WITH cpc_apps AS (                              -- all A01B3 apps with metadata
    SELECT
        p."application_number",
        p."filing_date",
        p."country_code",
        a.value::VARIANT:"name"::STRING  AS assignee
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc")                 c,
         LATERAL FLATTEN(INPUT => p."assignee_harmonized") a
    WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
),
top3 AS (                                       -- three biggest assignees
    SELECT
        assignee,
        COUNT(DISTINCT "application_number") AS total_apps
    FROM cpc_apps
    GROUP BY assignee
    ORDER BY total_apps DESC
    LIMIT 3
),
yearly AS (                                     -- yearly counts for those assignees
    SELECT
        c.assignee,
        FLOOR(c.filing_date / 10000)            AS yr,
        COUNT(DISTINCT c."application_number")  AS apps_year
    FROM cpc_apps c
    JOIN top3 t ON c.assignee = t.assignee
    GROUP BY c.assignee, yr
),
best_year AS (                                  -- peak year per assignee
    SELECT
        y.*,
        ROW_NUMBER() OVER (PARTITION BY y.assignee ORDER BY y.apps_year DESC) AS rk
    FROM yearly y
),
country_ct AS (                                 -- country totals in each peak year
    SELECT
        b.assignee,
        b.yr,
        c.country_code,
        COUNT(DISTINCT c."application_number") AS apps_country,
        ROW_NUMBER() OVER (PARTITION BY b.assignee, b.yr
                           ORDER BY COUNT(DISTINCT c."application_number") DESC) AS rk2
    FROM best_year b
    JOIN cpc_apps c
      ON c.assignee = b.assignee
     AND FLOOR(c.filing_date / 10000) = b.yr
    WHERE b.rk = 1
    GROUP BY b.assignee, b.yr, c.country_code
)
SELECT
    t.assignee               AS assignee_name,
    t.total_apps             AS total_applications,
    b.yr                     AS top_year,
    b.apps_year              AS apps_in_top_year,
    cc.country_code          AS top_country_code
FROM top3       t
JOIN best_year  b  ON b.assignee = t.assignee AND b.rk  = 1
JOIN country_ct cc ON cc.assignee = t.assignee AND cc.yr = b.yr AND cc.rk2 = 1
ORDER BY t.total_apps DESC;
