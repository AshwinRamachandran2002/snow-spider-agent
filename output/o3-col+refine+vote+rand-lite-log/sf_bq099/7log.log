```sql
--Description: For each of the overall top-3 A01B3 assignees, return the single year in
--             which that assignee filed the most A01B3-tagged applications, together
--             with the corresponding count.
WITH top3 AS (                              -- identify the 3 largest assignees
    SELECT
        a.value::VARIANT:"name"::STRING       AS assignee_name,
        COUNT(DISTINCT p."application_number") AS total_apps
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc")                c,
         LATERAL FLATTEN(INPUT => p."assignee_harmonized") a
    WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
    GROUP BY assignee_name
    ORDER BY total_apps DESC
    LIMIT 3
),
apps AS (                                   -- year-tagged list of all A01B3 apps
    SELECT
        a.value::VARIANT:"name"::STRING       AS assignee_name,
        FLOOR(p."filing_date"/10000)          AS filing_year,
        p."application_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc")                c,
         LATERAL FLATTEN(INPUT => p."assignee_harmonized") a
    WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
),
yearly AS (                                 -- count per assignee / year
    SELECT
        t.assignee_name,
        a.filing_year,
        COUNT(DISTINCT a."application_number") AS apps_in_year,
        ROW_NUMBER() OVER (PARTITION BY t.assignee_name
                           ORDER BY COUNT(DISTINCT a."application_number") DESC) AS rk
    FROM top3 t
    JOIN apps a
      ON a.assignee_name = t.assignee_name
    GROUP BY t.assignee_name, a.filing_year
)
SELECT
    assignee_name,
    filing_year     AS top_year,
    apps_in_year
FROM yearly
WHERE rk = 1
ORDER BY apps_in_year DESC;
```

```sql
--Description: Produce, for each of the three largest A01B3 assignees, the total number of
--             A01B3-tagged applications, the single year with their highest filings, how
--             many they filed that year, and the country code contributing the most filings
--             in that peak year.
WITH cpc_apps AS (                          -- every A01B3 application with metadata
    SELECT
        p."application_number",
        p."filing_date",
        p."country_code",
        a.value::VARIANT:"name"::STRING  AS assignee
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc")                c,
         LATERAL FLATTEN(INPUT => p."assignee_harmonized") a
    WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
),
top3 AS (                                   -- top-3 assignees by total apps
    SELECT
        assignee,
        COUNT(DISTINCT "application_number") AS total_apps
    FROM cpc_apps
    GROUP BY assignee
    ORDER BY total_apps DESC
    LIMIT 3
),
yearly AS (                                 -- yearly counts for those assignees
    SELECT
        t.assignee,
        FLOOR(c.filing_date/10000)           AS yr,
        COUNT(DISTINCT c."application_number") AS apps_year
    FROM top3 t
    JOIN cpc_apps c  ON c.assignee = t.assignee
    GROUP BY t.assignee, yr
),
best_year AS (                              -- pick peak year per assignee
    SELECT
        *,
        ROW_NUMBER() OVER (PARTITION BY assignee ORDER BY apps_year DESC) AS rk
    FROM yearly
),
country_ct AS (                             -- country counts inside each peak year
    SELECT
        b.assignee,
        b.yr,
        c.country_code,
        COUNT(DISTINCT c."application_number") AS apps_country,
        ROW_NUMBER() OVER (PARTITION BY b.assignee, b.yr
                           ORDER BY COUNT(DISTINCT c."application_number") DESC) AS rk2
    FROM best_year b
    JOIN cpc_apps c
      ON c.assignee = b.assignee
     AND FLOOR(c.filing_date/10000) = b.yr
    WHERE b.rk = 1
    GROUP BY b.assignee, b.yr, c.country_code
)
SELECT
    t.assignee                        AS assignee_name,
    t.total_apps                      AS total_applications,
    b.yr                              AS top_year,
    b.apps_year                       AS apps_in_top_year,
    cc.country_code                   AS top_country_code
FROM top3       t
JOIN best_year  b  ON b.assignee = t.assignee AND b.rk  = 1
JOIN country_ct cc ON cc.assignee = t.assignee AND cc.yr = b.yr AND cc.rk2 = 1
ORDER BY t.total_apps DESC;
```
