```sql
--Description: For the single largest A01B3 assignee, see application counts by filing-year
WITH top1 AS (
    SELECT 
        a.value::VARIANT:"name"::STRING AS "assignee_name"
    FROM PATENTS.PATENTS.PUBLICATIONS t, 
         LATERAL FLATTEN (INPUT => t."cpc") c,
         LATERAL FLATTEN (INPUT => t."assignee_harmonized") a
    WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
    GROUP BY 1
    ORDER BY COUNT(DISTINCT t."application_number") DESC
    LIMIT 1
)
SELECT 
    FLOOR(t."filing_date"/10000)                      AS "filing_year",
    COUNT(DISTINCT t."application_number")            AS "applications_in_year"
FROM PATENTS.PATENTS.PUBLICATIONS t, 
     LATERAL FLATTEN (INPUT => t."cpc") c,
     LATERAL FLATTEN (INPUT => t."assignee_harmonized") a,
     top1
WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
  AND a.value::VARIANT:"name"::STRING = top1."assignee_name"
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
--Description: Show yearly application totals for EACH of the overall top-3 A01B3 assignees
WITH ranked AS (
    SELECT 
        a.value::VARIANT:"name"::STRING AS "assignee_name",
        COUNT(DISTINCT t."application_number") AS "total_apps"
    FROM PATENTS.PATENTS.PUBLICATIONS t, 
         LATERAL FLATTEN (INPUT => t."cpc") c,
         LATERAL FLATTEN (INPUT => t."assignee_harmonized") a
    WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
    GROUP BY 1
    ORDER BY 2 DESC
    LIMIT 3
)
SELECT 
    r."assignee_name",
    FLOOR(t."filing_date"/10000)          AS "filing_year",
    COUNT(DISTINCT t."application_number") AS "apps_in_year"
FROM ranked r
JOIN PATENTS.PATENTS.PUBLICATIONS t
  ON 1=1
JOIN LATERAL FLATTEN (INPUT => t."cpc") c
  ON TRUE
JOIN LATERAL FLATTEN (INPUT => t."assignee_harmonized") a
  ON TRUE
WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
  AND a.value::VARIANT:"name"::STRING = r."assignee_name"
GROUP BY 1,2
ORDER BY 1,3 DESC
LIMIT 20;
```

```sql
--Description: For one chosen assignee/year combo (replace placeholders), list country codes & counts
SELECT 
    t."country_code",
    COUNT(DISTINCT t."application_number") AS "apps"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN (INPUT => t."cpc") c,
     LATERAL FLATTEN (INPUT => t."assignee_harmonized") a
WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
  AND a.value::VARIANT:"name"::STRING ILIKE '%<Replace_Assignee>%'   -- e.g. %DEERE%
  AND FLOOR(t."filing_date"/10000) = <Replace_Year>                  -- e.g. 2016
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
--Description: Determine, for every top-3 assignee, the single year with its maximum A01B3 filings
WITH top3 AS (
    SELECT 
        a.value::VARIANT:"name"::STRING AS "assignee_name",
        COUNT(DISTINCT t."application_number") AS "total_apps"
    FROM PATENTS.PATENTS.PUBLICATIONS t, 
         LATERAL FLATTEN (INPUT => t."cpc") c,
         LATERAL FLATTEN (INPUT => t."assignee_harmonized") a
    WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
    GROUP BY 1
    ORDER BY 2 DESC
    LIMIT 3
), yearly AS (
    SELECT 
        top3."assignee_name",
        FLOOR(t."filing_date"/10000) AS "year",
        COUNT(DISTINCT t."application_number") AS "apps_in_year",
        ROW_NUMBER() OVER (PARTITION BY top3."assignee_name" 
                           ORDER BY COUNT(DISTINCT t."application_number") DESC) AS "rk"
    FROM top3
    JOIN PATENTS.PATENTS.PUBLICATIONS t ON 1=1
    JOIN LATERAL FLATTEN (INPUT => t."cpc") c ON TRUE
    JOIN LATERAL FLATTEN (INPUT => t."assignee_harmonized") a ON TRUE
    WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
      AND a.value::VARIANT:"name"::STRING = top3."assignee_name"
    GROUP BY 1,2
)
SELECT 
    "assignee_name",
    "year"              AS "top_year",
    "apps_in_year"
FROM yearly
WHERE "rk" = 1
ORDER BY "apps_in_year" DESC
LIMIT 20;
```

```sql
--Description: Combine top-3 assignees, their best year, number of applications, 
--             and leading country code for that same year
WITH top3 AS (
    SELECT 
        a.value::VARIANT:"name"::STRING AS "assignee_name",
        COUNT(DISTINCT t."application_number") AS "tot_apps"
    FROM PATENTS.PATENTS.PUBLICATIONS t, 
         LATERAL FLATTEN (INPUT => t."cpc") c,
         LATERAL FLATTEN (INPUT => t."assignee_harmonized") a
    WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
    GROUP BY 1
    ORDER BY 2 DESC
    LIMIT 3
), best_year AS (
    SELECT 
        t3."assignee_name",
        FLOOR(p."filing_date"/10000) AS "year",
        COUNT(DISTINCT p."application_number") AS "apps_in_year",
        ROW_NUMBER() OVER (PARTITION BY t3."assignee_name" 
                           ORDER BY COUNT(DISTINCT p."application_number") DESC) AS "rk"
    FROM top3 t3
    JOIN PATENTS.PATENTS.PUBLICATIONS p ON 1=1
    JOIN LATERAL FLATTEN (INPUT => p."cpc") c ON TRUE
    JOIN LATERAL FLATTEN (INPUT => p."assignee_harmonized") a ON TRUE
    WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
      AND a.value::VARIANT:"name"::STRING = t3."assignee_name"
    GROUP BY 1,2
), country_ct AS (
    SELECT 
        b."assignee_name",
        b."year",
        p."country_code",
        COUNT(DISTINCT p."application_number") AS "country_apps",
        ROW_NUMBER() OVER (PARTITION BY b."assignee_name", b."year" 
                           ORDER BY COUNT(DISTINCT p."application_number") DESC) AS "rk2"
    FROM best_year b
    JOIN PATENTS.PATENTS.PUBLICATIONS p
      ON FLOOR(p."filing_date"/10000) = b."year"
    JOIN LATERAL FLATTEN (INPUT => p."cpc") c ON TRUE
    JOIN LATERAL FLATTEN (INPUT => p."assignee_harmonized") a ON TRUE
    WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
      AND a.value::VARIANT:"name"::STRING = b."assignee_name"
      AND b."rk" = 1
    GROUP BY 1,2,3
)
SELECT 
    b."assignee_name",
    b."apps_in_year"         AS "applications_in_top_year",
    b."year"                 AS "top_year",
    cc."country_code"        AS "top_country_code",
    cc."country_apps"        AS "apps_in_country"
FROM best_year b
JOIN country_ct cc 
  ON b."assignee_name" = cc."assignee_name"
 AND b."year" = cc."year"
WHERE b."rk" = 1
  AND cc."rk2" = 1
ORDER BY b."apps_in_year" DESC
LIMIT 20;
```
