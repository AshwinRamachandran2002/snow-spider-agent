```sql
--Description: 7)  Determine, for every assignee-year pair, the assignee’s max-year flag using window functions
SELECT
    "assignee_name",
    "pub_year",
    "apps_in_year",
    ROW_NUMBER() OVER (PARTITION BY "assignee_name" ORDER BY "apps_in_year" DESC) AS "year_rank"
FROM (
    SELECT 
        a.value:"name"::STRING                 AS "assignee_name",
        TO_NUMBER(SUBSTR(p."publication_date",1,4)) AS "pub_year",
        COUNT(DISTINCT p."application_number") AS "apps_in_year"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
    GROUP BY 
        a.value:"name"::STRING,
        TO_NUMBER(SUBSTR(p."publication_date",1,4))
) q
WHERE "year_rank" = 1
LIMIT 20;
```

```sql
--Description: 8)  For those top assignee-year pairs, count by country code to see which country provided most apps
SELECT 
    top3."assignee_name",
    top3."pub_year",
    a.value:"country_code"::STRING AS "country_code",
    COUNT(DISTINCT p."application_number")      AS "apps_in_country"
FROM (
    /* sub-query is the result of query 7 but restricted to year_rank=1 */
    SELECT 
        "assignee_name","pub_year"
    FROM (
        SELECT 
            a.value:"name"::STRING                            AS "assignee_name",
            TO_NUMBER(SUBSTR(p."publication_date",1,4))       AS "pub_year",
            COUNT(DISTINCT p."application_number")            AS "apps_in_year",
            ROW_NUMBER() OVER (PARTITION BY a.value:"name"::STRING ORDER BY COUNT(DISTINCT p."application_number") DESC) AS "year_rank"
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(input => p."cpc") c,
             LATERAL FLATTEN(input => p."assignee_harmonized") a
        WHERE c.value:"code"::STRING ILIKE 'A01B3%'
        GROUP BY a.value:"name"::STRING, TO_NUMBER(SUBSTR(p."publication_date",1,4))
    ) ranked
    WHERE "year_rank" = 1
    ORDER BY "assignee_name"
    LIMIT 3            --only top 3 assignees wanted
) top3
JOIN PATENTS.PATENTS.PUBLICATIONS p
    ON TRUE
JOIN LATERAL FLATTEN(input => p."cpc") c
    ON TRUE
JOIN LATERAL FLATTEN(input => p."assignee_harmonized") a
    ON TRUE
WHERE c.value:"code"::STRING ILIKE 'A01B3%'
  AND a.value:"name"::STRING = top3."assignee_name"
  AND TO_NUMBER(SUBSTR(p."publication_date",1,4)) = top3."pub_year"
GROUP BY 
    top3."assignee_name",
    top3."pub_year",
    a.value:"country_code"::STRING
ORDER BY "assignee_name","apps_in_country" DESC
LIMIT 20;
```

