```sql
--Description:  Single-statement solution that produces, for CPC subclass A01B3,
--  the five requested items for each of the TOP-3 assignees (ranked by total
--  distinct applications):
--      • assignee_name
--      • total_apps               (all years)
--      • top_year                 (year with most apps)
--      • apps_in_top_year         (# applications in that year)
--      • top_country_in_year      (country code with most apps in that year)
--
--  Approach – expressed as successive CTEs inside one query:
--    1) base            : explode CPC and ASSIGNEE arrays, keep rows whose CPC
--                         starts with ‘A01B3’, capture assignee_name,
--                         application_number, publication_year, country_code.
--    2) assignee_totals : count distinct applications per assignee.
--    3) top3            : retain the three assignees with the highest totals.
--    4) year_counts     : for those assignees, count apps per publication year.
--    5) top_year        : per assignee, pick the year holding the max count.
--    6) country_counts  : within each (assignee, top_year) pair, count apps per
--                         country_code.
--    7) top_country     : choose the country having the highest count
--                         (ties unstated).
--    8) final SELECT    : assemble the five requested columns.
WITH base AS (
    SELECT
        a.value:"name"::STRING        AS assignee_name,
        a.value:"country_code"::STRING AS country_code,
        p."application_number",
        TO_NUMBER(SUBSTR(p."publication_date",1,4)) AS pub_year
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")             c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'   -- restrict to subclass
),
assignee_totals AS (
    SELECT
        assignee_name,
        COUNT(DISTINCT application_number) AS total_apps
    FROM base
    GROUP BY assignee_name
),
top3 AS (
    SELECT *
    FROM assignee_totals
    ORDER BY total_apps DESC
    LIMIT 3                                     -- keep top-3 assignees
),
year_counts AS (
    SELECT
        b.assignee_name,
        b.pub_year,
        COUNT(DISTINCT b.application_number) AS apps_in_year
    FROM base b
    JOIN top3 t  ON b.assignee_name = t.assignee_name
    GROUP BY b.assignee_name, b.pub_year
),
top_year AS (
    SELECT
        yc.assignee_name,
        yc.pub_year      AS top_year,
        yc.apps_in_year  AS apps_in_top_year
    FROM (
        SELECT
            yc.*,
            ROW_NUMBER() OVER (PARTITION BY yc.assignee_name
                               ORDER BY yc.apps_in_year DESC) AS rk
        FROM year_counts yc
    ) yc
    WHERE rk = 1                              -- pick busiest year per assignee
),
country_counts AS (
    SELECT
        b.assignee_name,
        b.pub_year,
        b.country_code,
        COUNT(DISTINCT b.application_number) AS apps_in_country
    FROM base b
    JOIN top_year ty
      ON  b.assignee_name = ty.assignee_name
      AND b.pub_year      = ty.top_year
    GROUP BY b.assignee_name, b.pub_year, b.country_code
),
top_country AS (
    SELECT *
    FROM (
        SELECT
            cc.*,
            ROW_NUMBER() OVER (PARTITION BY cc.assignee_name
                               ORDER BY cc.apps_in_country DESC) AS rk
        FROM country_counts cc
    )
    WHERE rk = 1                           -- country with most apps that year
)
SELECT
    t3.assignee_name,
    t3.total_apps,
    ty.top_year,
    ty.apps_in_top_year,
    tc.country_code   AS top_country_in_year
FROM top3        t3
JOIN top_year    ty ON t3.assignee_name = ty.assignee_name
LEFT JOIN top_country tc ON  tc.assignee_name = ty.assignee_name
ORDER BY t3.total_apps DESC;
