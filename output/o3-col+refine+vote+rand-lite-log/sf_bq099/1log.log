```sql
--Description:  One-shot query (with inline reasoning) to obtain, for CPC subclass
--  “A01B3…”, the yearly application counts of the three assignees that own the
--  highest total number of distinct applications in that subclass.
--
--  1.  CTE “top3”:   From PATENTS.PATENTS.PUBLICATIONS we explode the CPC and
--      assignee_harmonized arrays, filter codes beginning with ‘A01B3’, then
--      count distinct application_numbers per assignee.  We sort those counts
--      descending and keep only the first three rows (the “top-3” assignees).
--
--  2.  Final SELECT:  Re-read the table, again flattening CPC and assignee
--      arrays, but keep only rows whose assignee_name matches one of the “top3”.
--      Group by assignee_name and publication year (derived from the first four
--      digits of publication_date) and count distinct applications, giving us
--      apps_in_year.  Order results so that, for each assignee, its busiest
--      year appears first.
--
WITH "top3" AS (
    SELECT
        a.value:"name"::STRING                     AS "assignee_name",
        COUNT(DISTINCT p."application_number")     AS "total_apps",
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT p."application_number") DESC) AS "rank"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")             c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'        -- keep only A01B3 subclass
    GROUP BY a.value:"name"::STRING
    ORDER BY "total_apps" DESC
    LIMIT 3                                            -- keep top 3 assignees
)

SELECT
    t3."assignee_name",
    TO_NUMBER(SUBSTR(p."publication_date",1,4))         AS "pub_year",
    COUNT(DISTINCT p."application_number")              AS "apps_in_year"
FROM "top3" t3
JOIN PATENTS.PATENTS.PUBLICATIONS p                     ON TRUE
JOIN LATERAL FLATTEN(input => p."cpc")                  c  ON TRUE
JOIN LATERAL FLATTEN(input => p."assignee_harmonized")  a  ON TRUE
WHERE c.value:"code"::STRING ILIKE 'A01B3%'              -- restrict to A01B3
  AND a.value:"name"::STRING = t3."assignee_name"        -- keep only top3 assignees
GROUP BY
    t3."assignee_name",
    TO_NUMBER(SUBSTR(p."publication_date",1,4))
ORDER BY
    t3."assignee_name",
    "apps_in_year" DESC
LIMIT 20;
