```sql
--Description: 10)  Assemble final 5-column answer (assignee, total apps, top year, apps in that year, top country) in one query
SELECT
    f."assignee_name",
    f."total_apps",
    f."top_year",
    f."apps_in_top_year",
    ctry."country_code"           AS "top_country_in_year"
FROM (
    /* derive total apps and top year for each of top-3 assignees */
    SELECT
        totals."assignee_name",
        totals."total_apps",
        yr."pub_year"              AS "top_year",
        yr."apps_in_year"          AS "apps_in_top_year"
    FROM (
        /* total apps for every assignee, bring top 3 */
        SELECT
            a.value:"name"::STRING                     AS "assignee_name",
            COUNT(DISTINCT p."application_number")     AS "total_apps",
            ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT p."application_number") DESC) AS "rank_all"
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(input => p."cpc") c,
             LATERAL FLATTEN(input => p."assignee_harmonized") a
        WHERE c.value:"code"::STRING ILIKE 'A01B3%'
        GROUP BY a.value:"name"::STRING
    ) totals
    JOIN (
        /* best year for each assignee */
        SELECT
            "assignee_name",
            "pub_year",
            "apps_in_year"
        FROM (
            SELECT
                a.value:"name"::STRING                 AS "assignee_name",
                TO_NUMBER(SUBSTR(p."publication_date",1,4)) AS "pub_year",
                COUNT(DISTINCT p."application_number") AS "apps_in_year",
                ROW_NUMBER() OVER (PARTITION BY a.value:"name"::STRING ORDER BY COUNT(DISTINCT p."application_number") DESC) AS "yr_rank"
            FROM PATENTS.PATENTS.PUBLICATIONS p,
                 LATERAL FLATTEN(input => p."cpc") c,
                 LATERAL FLATTEN(input => p."assignee_harmonized") a
            WHERE c.value:"code"::STRING ILIKE 'A01B3%'
            GROUP BY a.value:"name"::STRING, TO_NUMBER(SUBSTR(p."publication_date",1,4))
        ) yrs
        WHERE "yr_rank"=1
    ) yr
      ON totals."assignee_name" = yr."assignee_name"
    WHERE totals."rank_all" <= 3
) f
LEFT JOIN (
    /* top country within that top year */
    SELECT *
    FROM (
        SELECT
            t8."assignee_name",
            t8."pub_year",
            t8."country_code",
            t8."apps_in_country",
            ROW_NUMBER() OVER (PARTITION BY t8."assignee_name" ORDER BY t8."apps_in_country" DESC) AS "ctry_rank"
        FROM ( /* query 8 reused */ ) t8
    ) rc
    WHERE rc."ctry_rank" = 1
) ctry
  ON f."assignee_name" = ctry."assignee_name" AND f."top_year" = ctry."pub_year"
LIMIT 20;
```
