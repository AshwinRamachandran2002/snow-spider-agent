```sql
--Description:  Single-statement solution that returns, for CPC subclass “A01B3…”,
--  the requested five facts for the TOP-3 assignees (ranked by total distinct
--  applications):
--      • assignee_name
--      • total_apps              – total A01B3 applications (all years)
--      • top_year                – publication year with the most apps
--      • apps_in_top_year        – # apps in that year
--      • top_country_in_year     – country code contributing most apps in that year
--
--  CTE flow (all executed inside one query):
--    base         : explode CPC + assignee arrays, keep rows whose CPC code
--                   starts with ‘A01B3’; capture assignee_name, application_number,
--                   country_code, and pub_year.
--    top3         : count distinct applications per assignee, order DESC, keep 3.
--    top_year     : for each top assignee, pick the publication year with the
--                   largest application count.
--    country_cnt  : within each (assignee, top_year) pair, count apps per
--                   country_code.
--    top_country  : per assignee, keep the country with the highest count.
--    final SELECT : assemble and return the five columns.
WITH base AS (   /* flatten once, reuse everywhere */
    SELECT
        a.value:"name"::STRING         AS assignee_name,
        a.value:"country_code"::STRING AS country_code,
        p."application_number"         AS application_number,
        TO_NUMBER(SUBSTR(p."publication_date",1,4)) AS pub_year
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")            c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'           -- restrict to subclass
),
top3 AS (
    SELECT
        assignee_name,
        COUNT(DISTINCT application_number) AS total_apps
    FROM base
    GROUP BY assignee_name
    ORDER BY total_apps DESC
    LIMIT 3                                                -- three most-prolific
),
top_year AS (
    SELECT *
    FROM (
        SELECT
            b.assignee_name,
            b.pub_year,
            COUNT(DISTINCT b.application_number) AS apps_in_top_year,
            ROW_NUMBER() OVER (PARTITION BY b.assignee_name
                               ORDER BY COUNT(DISTINCT b.application_number) DESC) AS rk
        FROM base b
        WHERE b.assignee_name IN (SELECT assignee_name FROM top3)
        GROUP BY b.assignee_name, b.pub_year
    )
    WHERE rk = 1                                           -- busiest year/assignee
),
country_cnt AS (
    SELECT
        b.assignee_name,
        b.pub_year,
        b.country_code,
        COUNT(DISTINCT b.application_number) AS apps_in_country
    FROM base b
    JOIN top_year ty
      ON b.assignee_name = ty.assignee_name
     AND b.pub_year      = ty.pub_year
    GROUP BY b.assignee_name, b.pub_year, b.country_code
),
top_country AS (
    SELECT *
    FROM (
        SELECT
            cc.*,
            ROW_NUMBER() OVER (PARTITION BY cc.assignee_name
                               ORDER BY cc.apps_in_country DESC) AS rk
        FROM country_cnt cc
    )
    WHERE rk = 1                                           -- top country/assignee
)
SELECT
    t3.assignee_name,
    t3.total_apps,
    ty.pub_year                 AS top_year,
    ty.apps_in_top_year,
    tc.country_code             AS top_country_in_year
FROM top3 t3
JOIN top_year    ty ON ty.assignee_name = t3.assignee_name
LEFT JOIN top_country tc
       ON tc.assignee_name = t3.assignee_name
      AND tc.pub_year      = ty.pub_year
ORDER BY t3.total_apps DESC;
```
