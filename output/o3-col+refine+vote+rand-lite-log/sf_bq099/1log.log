--Description: 7)  For each assignee active in CPC subclass A01B3, find the
--               publication-year with the largest number of distinct
--               applications (“max-year”) and keep only that record.
WITH year_counts AS (
    SELECT
        a.value:"name"::STRING                        AS assignee_name,
        TO_NUMBER(SUBSTR(p."publication_date",1,4))   AS pub_year,
        COUNT(DISTINCT p."application_number")        AS apps_in_year
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")            c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
    GROUP BY a.value:"name"::STRING,
             TO_NUMBER(SUBSTR(p."publication_date",1,4))
),
ranked AS (
    SELECT
        *,
        ROW_NUMBER() OVER (PARTITION BY assignee_name
                           ORDER BY apps_in_year DESC) AS year_rank
    FROM year_counts
)
SELECT
    assignee_name,
    pub_year,
    apps_in_year
FROM ranked
WHERE year_rank = 1
LIMIT 20;
