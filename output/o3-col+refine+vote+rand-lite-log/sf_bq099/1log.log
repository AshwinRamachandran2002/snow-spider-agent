--Description: 10)  Build the final 5-column report for CPC subclass A01B3:
--                 assignee_name, total_apps, top_year, apps_in_top_year,
--                 and the country_code contributing the most apps in that year.
WITH base AS (
    SELECT
        a.value:"name"::STRING          AS assignee_name,
        a.value:"country_code"::STRING  AS country_code,
        p."application_number",
        TO_NUMBER(SUBSTR(p."publication_date",1,4)) AS pub_year
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")            c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
),
top3 AS (
    SELECT
        assignee_name,
        COUNT(DISTINCT application_number) AS total_apps
    FROM base
    GROUP BY assignee_name
    ORDER BY total_apps DESC
    LIMIT 3
),
top_year AS (
    SELECT *
    FROM (
        SELECT
            b.assignee_name,
            b.pub_year,
            COUNT(DISTINCT b.application_number) AS apps_in_top_year,
            ROW_NUMBER() OVER (PARTITION BY b.assignee_name
                               ORDER BY COUNT(DISTINCT b.application_number) DESC) AS rk
        FROM base b,
             top3 t
        WHERE b.assignee_name = t.assignee_name
        GROUP BY b.assignee_name, b.pub_year
    )
    WHERE rk = 1
),
top_country AS (
    SELECT *
    FROM (
        SELECT
            b.assignee_name,
            b.pub_year,
            b.country_code,
            COUNT(DISTINCT b.application_number) AS apps_in_country,
            ROW_NUMBER() OVER (PARTITION BY b.assignee_name
                               ORDER BY COUNT(DISTINCT b.application_number) DESC) AS rk
        FROM base b,
             top_year ty
        WHERE b.assignee_name = ty.assignee_name
          AND b.pub_year      = ty.pub_year
        GROUP BY b.assignee_name, b.pub_year, b.country_code
    )
    WHERE rk = 1
)
SELECT
    t3.assignee_name,
    t3.total_apps,
    ty.pub_year              AS top_year,
    ty.apps_in_top_year,
    tc.country_code          AS top_country_in_year
FROM top3 t3,
     top_year   ty,
     top_country tc
WHERE t3.assignee_name = ty.assignee_name
  AND t3.assignee_name = tc.assignee_name
  AND ty.pub_year      = tc.pub_year
ORDER BY t3.total_apps DESC
LIMIT 20;
