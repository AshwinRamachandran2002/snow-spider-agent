        WHERE c.value:"code"::STRING ILIKE 'A01B3%'
    ) b,
    (
        /* replicate CTE top_year logic here */
        SELECT *
        FROM (
            SELECT
                br.assignee_name,
                br.pub_year,
                COUNT(DISTINCT br.application_number) AS apps_in_year,
                ROW_NUMBER() OVER (PARTITION BY br.assignee_name
                                   ORDER BY COUNT(DISTINCT br.application_number) DESC) AS rk
            FROM (
