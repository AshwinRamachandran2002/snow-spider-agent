```sql
--Description: 
--For the assignee “LELY NV C VAN DER” in CPC subclass A01B3, this single query
--1) gathers all relevant publications,                                              
--2) determines the filing year with the most applications (treating NULL/0 dates   
--   as ‘UNK’), and                                                                  
--3) identifies the country code with the highest number of filings in that peak    
--   year.  The final SELECT returns the peak year, the number of applications in   
--   that year, and the dominant country code.                                       
WITH lely AS (                                  -- step-1: gather A01B3 data for assignee
    SELECT
        CASE
            WHEN p."filing_date" IS NOT NULL AND p."filing_date" > 0
            THEN LEFT(TO_CHAR(p."filing_date"),4)
            ELSE 'UNK'
        END                  AS year,
        p."country_code"     AS country_code
    FROM PATENTS.PATENTS.PUBLICATIONS p
         , LATERAL FLATTEN(input => p."cpc")                c
         , LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
      AND a.value:"name"::STRING = 'LELY NV C VAN DER'
), year_counts AS (                            -- step-2: count filings per year
    SELECT
        year,
        COUNT(*) AS apps_in_year,
        ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn
    FROM lely
    GROUP BY year
), peak_year AS (                              -- keep the single peak year
    SELECT year, apps_in_year
    FROM year_counts
    WHERE rn = 1
), country_counts AS (                         -- step-3: count countries in that peak year
    SELECT
        l.country_code,
        COUNT(*) AS country_apps,
        ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn
    FROM lely l
    JOIN peak_year p ON l.year = p.year
    GROUP BY l.country_code
)
SELECT
    'LELY NV C VAN DER'       AS assignee_name,
    p.year                    AS peak_year,
    p.apps_in_year,
    c.country_code            AS top_country_in_peak_year
FROM peak_year     p
JOIN country_counts c ON c.rn = 1;   -- dominant country in the peak year
