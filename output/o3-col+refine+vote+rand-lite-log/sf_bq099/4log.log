```sql
--Description: Build a compact summary table for the three leading assignees: total apps, peak year, apps in that year.
WITH a01b AS (
    SELECT 
        p."publication_number",
        LEFT(TO_CHAR(p."filing_date"),4) AS "year",
        a.value:"name"::STRING          AS "assignee_name",
        p."country_code"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
), totals AS (
    SELECT 
        "assignee_name",
        COUNT(*) AS "total_apps"
    FROM a01b
    GROUP BY "assignee_name"
    ORDER BY "total_apps" DESC
    LIMIT 3
), yearly AS (
    SELECT 
        b."assignee_name",
        b."year",
        COUNT(*) AS "apps_in_year",
        ROW_NUMBER() OVER (PARTITION BY b."assignee_name" 
                           ORDER BY COUNT(*) DESC) AS rn
    FROM a01b b
    WHERE b."assignee_name" IN (SELECT "assignee_name" FROM totals)
    GROUP BY b."assignee_name", b."year"
), peak_year AS (
    SELECT * FROM yearly WHERE rn = 1
), country_peak AS (
    SELECT 
        a."assignee_name",
        a."year",
        p."country_code",
        COUNT(*) AS "apps_country",
        ROW_NUMBER() OVER (PARTITION BY a."assignee_name", a."year" 
                           ORDER BY COUNT(*) DESC) AS rn
    FROM a01b p
    JOIN peak_year a 
      ON p."assignee_name" = a."assignee_name"
     AND p."year"          = a."year"
    GROUP BY a."assignee_name", a."year", p."country_code"
)
SELECT 
    t."assignee_name",
    t."total_apps",
    py."year"                 AS "peak_year",
    py."apps_in_year",
    cp."country_code"         AS "top_country_in_peak_year"
FROM totals t
JOIN peak_year py ON t."assignee_name" = py."assignee_name"
JOIN country_peak cp 
     ON cp."assignee_name" = py."assignee_name" 
    AND cp."year"          = py."year"
WHERE cp.rn = 1
ORDER BY t."total_apps" DESC
LIMIT 20;
```

