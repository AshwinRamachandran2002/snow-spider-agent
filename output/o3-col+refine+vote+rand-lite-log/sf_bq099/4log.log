```sql
--Description: Determine, for a specific assignee (replace <<ASSIGNEE_NAME>>) its peak-volume filing year in subclass “A01B3”, coping with NULL/zero filing dates.
SELECT
    peak.year,
    peak.apps_in_year
FROM (
    SELECT
        CASE
            WHEN p."filing_date" IS NOT NULL AND p."filing_date" > 0
            THEN LEFT(TO_CHAR(p."filing_date"),4)
            ELSE 'UNK'
        END                         AS year,
        COUNT(*)                    AS apps_in_year,
        ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")                c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
      AND a.value:"name"::STRING   = <<ASSIGNEE_NAME>>
    GROUP BY
        CASE
            WHEN p."filing_date" IS NOT NULL AND p."filing_date" > 0
            THEN LEFT(TO_CHAR(p."filing_date"),4)
            ELSE 'UNK'
        END
) peak
WHERE peak.rn = 1
LIMIT 1;
