--Description: 
--Objective: produce, in one query, the five requested figures for CPC subclass “A01B3”:  
--   1) assignee name (top-3 by total filings)  
--   2) total number of applications  
--   3) year with the most applications for that assignee  
--   4) number of applications in that peak year  
--   5) country code with the most applications during that peak year.  
--Thinking process inside the query:  
--  • a01b  : explode PUBLICATIONS into one row per (assignee, publication) that contains a CPC code starting with ‘A01B3’, capture year and country.  
--  • totals: rank assignees by total A01B3 filings, keep top-3.  
--  • yearly: count filings per (assignee, year); peak_year isolates the max-volume year for each assignee.  
--  • country_peak: within each assignee’s peak year, count by country_code and keep the largest.  
--  • final SELECT stitches everything together.  The CASE handles missing or zero filing dates by labelling them ‘UNK’.  
WITH a01b AS (  
    SELECT  
        a.value:"name"::STRING                         AS assignee_name,  
        CASE  
            WHEN p."filing_date" IS NOT NULL AND p."filing_date" > 0  
            THEN LEFT(TO_CHAR(p."filing_date"),4)  
            ELSE 'UNK'  
        END                                            AS year,  
        p."country_code"                               AS country_code  
    FROM PATENTS.PATENTS.PUBLICATIONS p,  
         LATERAL FLATTEN(input => p."cpc")                c,  
         LATERAL FLATTEN(input => p."assignee_harmonized") a  
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'  
), totals AS (  
    SELECT assignee_name, COUNT(*) AS total_apps  
    FROM a01b  
    GROUP BY assignee_name  
    ORDER BY total_apps DESC  
    LIMIT 3  
), yearly AS (  
    SELECT assignee_name, year, COUNT(*) AS apps_in_year  
    FROM a01b  
    WHERE assignee_name IN (SELECT assignee_name FROM totals)  
    GROUP BY assignee_name, year  
), peak_year AS (  
    SELECT *, ROW_NUMBER() OVER (PARTITION BY assignee_name ORDER BY apps_in_year DESC) AS rn  
    FROM yearly  
), country_peak AS (  
    SELECT  
        a.assignee_name,  
        a.year,  
        country_code,  
        COUNT(*) AS apps_country,  
        ROW_NUMBER() OVER (PARTITION BY a.assignee_name, a.year ORDER BY COUNT(*) DESC) AS rn  
    FROM a01b a  
    JOIN peak_year py  
      ON a.assignee_name = py.assignee_name  
     AND a.year          = py.year  
    WHERE py.rn = 1  
    GROUP BY a.assignee_name, a.year, country_code  
)  
SELECT  
    t.assignee_name,  
    t.total_apps,  
    py.year                     AS peak_year,  
    py.apps_in_year,  
    cp.country_code             AS top_country_in_peak_year  
FROM totals t  
JOIN peak_year   py ON t.assignee_name = py.assignee_name AND py.rn = 1  
JOIN country_peak cp ON cp.assignee_name = py.assignee_name AND cp.year = py.year AND cp.rn = 1  
ORDER BY t.total_apps DESC;
