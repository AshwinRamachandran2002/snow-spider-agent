```sql
--Description:  End-to-end answer in one query.
--Goal:  For CPC subclass A01B3, show for EACH of the three assignees with the
--highest total number of applications:
--   1) total A01B3 applications (“total_apps”);
--   2) the single filing year with the most A01B3 applications (“peak_year”)
--      and the count in that year (“apps_in_peak_year”);
--   3) the country code that accounts for the largest share of those
--      applications in the peak year (“top_country_in_peak_year”) together
--      with its count (“apps_in_country”).
--Strategy:
-- • CTE top3        – pick the three leaders (assignee_name, total_apps).
-- • CTE per_year    – count distinct applications for every (assignee, year).
-- • CTE peak        – keep only the busiest year per assignee (ROW_NUMBER=1).
-- • CTE country_rank– inside each (assignee, peak_year) count apps per
--                     country and rank them; keep rank 1 later.
-- • Final SELECT    – stitch the pieces together to deliver the requested
--                     five columns, ordered by total_apps descending.
WITH top3 AS (  -- three leading assignees in subclass A01B3
    SELECT  a.value:"name"::STRING                          AS assignee_name,
            COUNT(DISTINCT t."application_number_formatted") AS total_apps
    FROM    PATENTS.PATENTS.PUBLICATIONS t,
            LATERAL FLATTEN(input => t."cpc")                 c,
            LATERAL FLATTEN(input => t."assignee_harmonized") a
    WHERE   c.value:"code"::STRING ILIKE 'A01B3%'            -- subclass filter
    GROUP  BY a.value:"name"::STRING
    ORDER  BY total_apps DESC
    LIMIT  3
),
per_year AS (  -- application counts per (assignee, filing_year)
    SELECT  a.value:"name"::STRING            AS assignee_name,
            (t."filing_date" / 10000)::INT    AS filing_year,
            COUNT(DISTINCT t."application_number_formatted") AS apps_in_year
    FROM    PATENTS.PATENTS.PUBLICATIONS t,
            LATERAL FLATTEN(input => t."cpc")                 c,
            LATERAL FLATTEN(input => t."assignee_harmonized") a
    WHERE   c.value:"code"::STRING ILIKE 'A01B3%'
      AND   a.value:"name"::STRING IN (SELECT assignee_name FROM top3)
    GROUP  BY a.value:"name"::STRING, (t."filing_date" / 10000)::INT
),
peak AS (      -- busiest year per assignee
    SELECT  p.assignee_name,
            p.filing_year  AS peak_year,
            p.apps_in_year AS apps_in_peak_year
    FROM   (
            SELECT per_year.*,
                   ROW_NUMBER() OVER (PARTITION BY assignee_name
                                      ORDER BY apps_in_year DESC) AS rn
            FROM   per_year
          ) p
    WHERE  rn = 1
),
country_rank AS ( -- top country within each (assignee, peak_year)
    SELECT  peak.assignee_name,
            peak.peak_year,
            t."country_code",
            COUNT(DISTINCT t."application_number_formatted") AS apps_in_country,
            ROW_NUMBER() OVER (PARTITION BY peak.assignee_name
                               ORDER BY COUNT(DISTINCT t."application_number_formatted") DESC) AS crn
    FROM    peak,
            PATENTS.PATENTS.PUBLICATIONS t,
            LATERAL FLATTEN(input => t."cpc")                 c,
            LATERAL FLATTEN(input => t."assignee_harmonized") a
    WHERE   c.value:"code"::STRING ILIKE 'A01B3%'
      AND   a.value:"name"::STRING = peak.assignee_name
      AND   (t."filing_date" / 10000)::INT = peak.peak_year
    GROUP  BY peak.assignee_name, peak.peak_year, t."country_code"
)
SELECT  t3.assignee_name,
        t3.total_apps,
        p.peak_year,
        p.apps_in_peak_year,
        c."country_code"           AS top_country_in_peak_year,
        c.apps_in_country
FROM    top3           t3
JOIN    peak           p ON p.assignee_name = t3.assignee_name
JOIN    country_rank   c ON c.assignee_name = p.assignee_name
                         AND c.peak_year    = p.peak_year
                         AND c.crn          = 1
ORDER BY t3.total_apps DESC;
