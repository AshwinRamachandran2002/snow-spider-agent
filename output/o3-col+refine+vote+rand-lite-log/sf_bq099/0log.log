```sql
--Description:  Complete, self-contained summary – list for each TOP-3 assignee:
--total A01B3 applications, its peak filing year, number of apps that year, and
--the country code with the most filings in that peak year.
WITH leaders AS (                           -- step-1: identify top 3 assignees
  SELECT a.value:"name"::STRING AS assignee_name,
         COUNT(DISTINCT t."application_number_formatted") AS total_apps
  FROM   PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc")                 c,
         LATERAL FLATTEN(input => t."assignee_harmonized") a
  WHERE  c.value:"code"::STRING ILIKE 'A01B3%'
  GROUP  BY a.value:"name"::STRING
  ORDER  BY total_apps DESC
  LIMIT 3
),
peak AS (                                  -- step-2: find peak year per leader
  SELECT l.assignee_name,
         (t."filing_date"/10000)::INTEGER AS filing_year,
         COUNT(DISTINCT t."application_number_formatted") AS apps_in_year,
         ROW_NUMBER() OVER (PARTITION BY l.assignee_name
                            ORDER BY COUNT(DISTINCT t."application_number_formatted") DESC) AS rn
  FROM   leaders l
  JOIN   PATENTS.PATENTS.PUBLICATIONS t                     ON 1=1
  JOIN   LATERAL FLATTEN(input => t."cpc")                 c ON 1=1
  JOIN   LATERAL FLATTEN(input => t."assignee_harmonized") a ON 1=1
  WHERE  c.value:"code"::STRING ILIKE 'A01B3%'
    AND  a.value:"name"::STRING = l.assignee_name
  GROUP  BY l.assignee_name, (t."filing_date"/10000)::INTEGER
),
peak_sel AS (                             -- keep just the top row per assignee
  SELECT assignee_name, filing_year, apps_in_year
  FROM   peak
  WHERE  rn = 1
),
country_top AS (                          -- step-3: top country within peak year
  SELECT p.assignee_name,
         p.filing_year,
         t."country_code",
         COUNT(DISTINCT t."application_number_formatted") AS apps_in_country,
         ROW_NUMBER() OVER (PARTITION BY p.assignee_name
                            ORDER BY COUNT(DISTINCT t."application_number_formatted") DESC) AS crn
  FROM   peak_sel p
  JOIN   PATENTS.PATENTS.PUBLICATIONS t                     ON 1=1
  JOIN   LATERAL FLATTEN(input => t."cpc")                 c ON 1=1
  JOIN   LATERAL FLATTEN(input => t."assignee_harmonized") a ON 1=1
  WHERE  c.value:"code"::STRING ILIKE 'A01B3%'
    AND  a.value:"name"::STRING = p.assignee_name
    AND  (t."filing_date"/10000)::INTEGER = p.filing_year
  GROUP  BY p.assignee_name, p.filing_year, t."country_code"
)
SELECT  l.assignee_name,
        l.total_apps,
        p.filing_year         AS peak_year,
        p.apps_in_year        AS apps_in_peak_year,
        c."country_code"      AS top_country_in_peak_year,
        c.apps_in_country
FROM    leaders      l
JOIN    peak_sel     p ON p.assignee_name = l.assignee_name
JOIN    country_top  c ON c.assignee_name = p.assignee_name
                       AND c.filing_year  = p.filing_year
                       AND c.crn          = 1
LIMIT 20;
```
