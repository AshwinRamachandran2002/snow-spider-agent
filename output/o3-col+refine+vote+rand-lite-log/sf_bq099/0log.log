FROM    PATENTS.PATENTS.PUBLICATIONS t,
        LATERAL FLATTEN(input => t."cpc")                 c,
        LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE   c.value:"code"::STRING ILIKE 'A01B3%'
  AND   a.value:"name"::STRING ILIKE '%ACME%'      -- put real assignee name here
GROUP BY "filing_year"
ORDER BY "apps_in_year" DESC
LIMIT   20;
```

```sql
-- Description: For ALL publications in A01B3% belonging to the TOP-3 assignees
-- (derived with sub-query), give application counts per assignee & year
SELECT  top3."assignee_name",
        TO_CHAR(t."filing_date", 'YYYY')              AS "filing_year",
        COUNT(DISTINCT t."application_number_formatted") AS "apps_in_year"
FROM   ( /* subquery picking the 3 leaders */ 
        SELECT  a.value:"name"::STRING AS "assignee_name"
        FROM    PATENTS.PATENTS.PUBLICATIONS t,
                LATERAL FLATTEN(input => t."cpc")                 c,
                LATERAL FLATTEN(input => t."assignee_harmonized") a
        WHERE   c.value:"code"::STRING ILIKE 'A01B3%'
        GROUP  BY a.value:"name"::STRING
        ORDER  BY COUNT(DISTINCT t."application_number_formatted") DESC
        LIMIT  3
      ) top3
JOIN   PATENTS.PATENTS.PUBLICATIONS t
      ON 1=1
JOIN   LATERAL FLATTEN(input => t."cpc")                 c
      ON 1=1
JOIN   LATERAL FLATTEN(input => t."assignee_harmonized") a
      ON 1=1
WHERE  c.value:"code"::STRING ILIKE 'A01B3%'
  AND  a.value:"name"::STRING = top3."assignee_name"
GROUP BY top3."assignee_name", TO_CHAR(t."filing_date", 'YYYY')
ORDER BY top3."assignee_name", "apps_in_year" DESC
LIMIT  20;
```

```sql
-- Description: Pick, for every one of the TOP-3 assignees, the single year with the
-- highest number of applications (ties broken arbitrarily)
SELECT  s."assignee_name",
        s."filing_year",
        s."apps_in_year"
FROM  (
        SELECT  top3."assignee_name",
                TO_CHAR(t."filing_date", 'YYYY') AS "filing_year",
                COUNT(DISTINCT t."application_number_formatted") AS "apps_in_year",
                ROW_NUMBER() OVER
                  (PARTITION BY top3."assignee_name"
                   ORDER BY COUNT(DISTINCT t."application_number_formatted") DESC) AS rn
        FROM    (SELECT  a.value:"name"::STRING AS "assignee_name"
                 FROM    PATENTS.PATENTS.PUBLICATIONS t,
                         LATERAL FLATTEN(input => t."cpc") c,
                         LATERAL FLATTEN(input => t."assignee_harmonized") a
                 WHERE   c.value:"code"::STRING ILIKE 'A01B3%'
                 GROUP BY a.value:"name"::STRING
                 ORDER BY COUNT(DISTINCT t."application_number_formatted") DESC
                 LIMIT 3) top3
        JOIN    PATENTS.PATENTS.PUBLICATIONS t  ON 1=1
        JOIN    LATERAL FLATTEN(input => t."cpc")                 c ON 1=1
        JOIN    LATERAL FLATTEN(input => t."assignee_harmonized") a ON 1=1
        WHERE   c.value:"code"::STRING ILIKE 'A01B3%'
          AND   a.value:"name"::STRING = top3."assignee_name"
        GROUP  BY top3."assignee_name", TO_CHAR(t."filing_date", 'YYYY')
      ) s
WHERE  s.rn = 1
LIMIT  20;
```

```sql
-- Description: For each (assignee, peak-year) pair obtained above, determine the country
-- code with the most applications in that year
SELECT  peak."assignee_name",
        peak."filing_year",
        t."country_code",
        COUNT(DISTINCT t."application_number_formatted") AS "apps_in_country"
FROM    ( /* the peak year result from previous query */
         SELECT  'Dummy' AS "assignee_name", '2000' AS "filing_year"  -- replace with real result
       ) peak
JOIN    PATENTS.PATENTS.PUBLICATIONS t  ON 1=1
JOIN    LATERAL FLATTEN(input => t."cpc")                 c ON 1=1
JOIN    LATERAL FLATTEN(input => t."assignee_harmonized") a ON 1=1
WHERE   c.value:"code"::STRING ILIKE 'A01B3%'
  AND   a.value:"name"::STRING = peak."assignee_name"
  AND   TO_CHAR(t."filing_date", 'YYYY') = peak."filing_year"
GROUP BY peak."assignee_name", peak."filing_year", t."country_code"
ORDER BY "apps_in_country" DESC
LIMIT   20;
```

```sql
-- Description: Summarise everything – for the TOP-3 assignees list their total apps,
-- peak year, its application count, and the leading country for that peak year
-- (one-stop final aggregation; trimmed to 20 rows)
SELECT  fin."assignee_name",
        fin."total_apps",
        fin."peak_year",
        fin."apps_in_peak_year",
        fin."top_country_in_peak_year",
        fin."apps_in_top_country"
FROM   (
        /* complete multi-stage aggregation in one query (details condensed) */
        SELECT  ldr."assignee_name",
                ldr."total_apps",
                pk."filing_year"          AS "peak_year",
                pk."apps_in_year"         AS "apps_in_peak_year",
                cnt."country_code"        AS "top_country_in_peak_year",
                cnt."apps_in_country"
        FROM   ( /* leaders */ 
                SELECT  a.value:"name"::STRING AS "assignee_name",
                        COUNT(DISTINCT t."application_number_formatted") AS "total_apps"
                FROM    PATENTS.PATENTS.PUBLICATIONS t,
                        LATERAL FLATTEN(input => t."cpc")                 c,
                        LATERAL FLATTEN(input => t."assignee_harmonized") a
                WHERE   c.value:"code"::STRING ILIKE 'A01B3%'
                GROUP BY a.value:"name"::STRING
                ORDER BY "total_apps" DESC
                LIMIT 3 ) ldr
        JOIN  ( /* peak year per leader */ 
               SELECT  ass."assignee_name",
                       TO_CHAR(t."filing_date", 'YYYY') AS "filing_year",
                       COUNT(DISTINCT t."application_number_formatted") AS "apps_in_year",
                       ROW_NUMBER() OVER
                         (PARTITION BY ass."assignee_name"
                          ORDER BY COUNT(DISTINCT t."application_number_formatted") DESC) AS rn
               FROM    ldr ass
               JOIN    PATENTS.PATENTS.PUBLICATIONS t  ON 1=1
               JOIN    LATERAL FLATTEN(input => t."cpc")                 c ON 1=1
               JOIN    LATERAL FLATTEN(input => t."assignee_harmonized") a ON 1=1
               WHERE   c.value:"code"::STRING ILIKE 'A01B3%'
                 AND   a.value:"name"::STRING = ass."assignee_name"
               GROUP BY ass."assignee_name", TO_CHAR(t."filing_date", 'YYYY')
             ) pk ON pk."assignee_name" = ldr."assignee_name" AND pk.rn = 1
        JOIN  ( /* top country inside each peak year */ 
               SELECT  pk."assignee_name",
                       pk."filing_year",
                       t."country_code",
                       COUNT(DISTINCT t."application_number_formatted") AS "apps_in_country",
                       ROW_NUMBER() OVER
                         (PARTITION BY pk."assignee_name", pk."filing_year"
                          ORDER BY COUNT(DISTINCT t."application_number_formatted") DESC) AS crn
               FROM    pk
               JOIN    PATENTS.PATENTS.PUBLICATIONS t  ON 1=1
               JOIN    LATERAL FLATTEN(input => t."cpc")                 c ON 1=1
               JOIN    LATERAL FLATTEN(input => t."assignee_harmonized") a ON 1=1
               WHERE   c.value:"code"::STRING ILIKE 'A01B3%'
                 AND   a.value:"name"::STRING = pk."assignee_name"
                 AND   TO_CHAR(t."filing_date", 'YYYY') = pk."filing_year"
               GROUP BY pk."assignee_name", pk."filing_year", t."country_code"
             ) cnt ON cnt."assignee_name" = pk."assignee_name"
                 AND cnt."filing_year"   = pk."filing_year"
                 AND cnt.crn             = 1
      ) fin
LIMIT  20;
```

These ten progressively more sophisticated queries let you explore CPC subclass A01B3, find its leading assignees, identify their busiest filing year and the dominant filing country in that year—exactly the ingredients required for the final analysis.
