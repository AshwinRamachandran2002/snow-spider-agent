Query:
--Description: 5) Identify the yearly application counts for each of the (pre-filtered) top 3 assignees  
WITH top3 AS (
  SELECT a.value:"name"::STRING AS "assignee_name"
  FROM PATENTS.PATENTS.PUBLICATIONS pub,
       LATERAL FLATTEN(input => pub."cpc")  c,
       LATERAL FLATTEN(input => pub."assignee_harmonized") a
  WHERE c.value:"code"::STRING ILIKE 'A01B3%'
  GROUP BY a.value:"name"::STRING
  ORDER BY COUNT(DISTINCT pub."application_number") DESC
  LIMIT 3
)
SELECT 
  t."assignee_name",
  TO_NUMBER(LEFT(pub."filing_date",4)) AS "filing_year",
  COUNT(DISTINCT pub."application_number") AS "apps_in_year"
FROM PATENTS.PATENTS.PUBLICATIONS  pub,
     LATERAL FLATTEN(input => pub."cpc")  c,
     LATERAL FLATTEN(input => pub."assignee_harmonized")  a,
     top3 t
WHERE c.value:"code"::STRING ILIKE 'A01B3%'
  AND a.value:"name"::STRING = t."assignee_name"
GROUP BY t."assignee_name", TO_NUMBER(LEFT(pub."filing_date",4))
ORDER BY t."assignee_name", "apps_in_year" DESC
LIMIT 20;
