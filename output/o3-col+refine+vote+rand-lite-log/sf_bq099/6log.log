```sql
--Description: 5) Identify the yearly application counts for each of the (pre-filtered) top 3 assignees  
WITH top3 AS (
  SELECT a.value:"name"::STRING AS "assignee_name"
  FROM PATENTS.PATENTS.PUBLICATIONS pub,
       LATERAL FLATTEN(input => pub."cpc")  c,
       LATERAL FLATTEN(input => pub."assignee_harmonized") a
  WHERE c.value:"code"::STRING ILIKE 'A01B3%'
  GROUP BY a.value:"name"::STRING
  ORDER BY COUNT(DISTINCT pub."application_number") DESC
  LIMIT 3
)
SELECT 
  t."assignee_name",
  TO_NUMBER(LEFT(pub."filing_date",4)) AS "filing_year",
  COUNT(DISTINCT pub."application_number") AS "apps_in_year"
FROM PATENTS.PATENTS.PUBLICATIONS  pub,
     LATERAL FLATTEN(input => pub."cpc")  c,
     LATERAL FLATTEN(input => pub."assignee_harmonized")  a,
     top3 t
WHERE c.value:"code"::STRING ILIKE 'A01B3%'
  AND a.value:"name"::STRING = t."assignee_name"
GROUP BY t."assignee_name", TO_NUMBER(LEFT(pub."filing_date",4))
ORDER BY t."assignee_name", "apps_in_year" DESC
LIMIT 20;
```

```sql
--Description: 6) Retrieve the country codes of publications for the same top-3 assignees and CPC “A01B3%”  
WITH top3 AS (
  SELECT a.value:"name"::STRING AS "assignee_name"
  FROM PATENTS.PATENTS.PUBLICATIONS  pub,
       LATERAL FLATTEN(input => pub."cpc") c,
       LATERAL FLATTEN(input => pub."assignee_harmonized") a
  WHERE c.value:"code"::STRING ILIKE 'A01B3%'
  GROUP BY a.value:"name"::STRING
  ORDER BY COUNT(DISTINCT pub."application_number") DESC
  LIMIT 3
)
SELECT  
  t."assignee_name",
  TO_NUMBER(LEFT(pub."filing_date",4)) AS "filing_year",
  pub."country_code",
  COUNT(DISTINCT pub."application_number") AS "apps_ct"
FROM PATENTS.PATENTS.PUBLICATIONS  pub,
     LATERAL FLATTEN(input => pub."cpc")  c,
     LATERAL FLATTEN(input => pub."assignee_harmonized") a,
     top3 t
WHERE c.value:"code"::STRING ILIKE 'A01B3%'
  AND a.value:"name"::STRING = t."assignee_name"
GROUP BY t."assignee_name",
         TO_NUMBER(LEFT(pub."filing_date",4)),
         pub."country_code"
ORDER BY "apps_ct" DESC
LIMIT 20;
```

```sql
--Description: 7) Produce a compact view with, for every publication (limited rows), CPC “A01B3%”, filing year, country code and assignee
SELECT  
  pub."publication_number",
  TO_NUMBER(LEFT(pub."filing_date",4))       AS "filing_year",
  pub."country_code",
  a.value:"name"::STRING                     AS "assignee_name",
  c.value:"code"::STRING                     AS "cpc_code"
FROM PATENTS.PATENTS.PUBLICATIONS  pub,
     LATERAL FLATTEN(input => pub."cpc")  c,
     LATERAL FLATTEN(input => pub."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A01B3%'
LIMIT 20;
```

```sql
--Description: 8) Summarize (all assignees) – total apps, most-active year & count therein
WITH base AS (
  SELECT  
    a.value:"name"::STRING                   AS "assignee_name",
    pub."application_number",
    TO_NUMBER(LEFT(pub."filing_date",4))     AS "yr"
  FROM PATENTS.PATENTS.PUBLICATIONS  pub,
       LATERAL FLATTEN(input => pub."cpc")  c,
       LATERAL FLATTEN(input => pub."assignee_harmonized") a
  WHERE c.value:"code"::STRING ILIKE 'A01B3%'
), tot AS (
  SELECT "assignee_name",
         COUNT(DISTINCT "application_number") AS "tot_apps"
  FROM base
  GROUP BY "assignee_name"
), yr_ct AS (
  SELECT "assignee_name", "yr",
         COUNT(DISTINCT "application_number") AS "yr_apps",
         ROW_NUMBER() OVER (PARTITION BY "assignee_name"
                            ORDER BY COUNT(DISTINCT "application_number") DESC) AS rn
  FROM base
  GROUP BY "assignee_name","yr"
)
SELECT 
  t."assignee_name",
  t."tot_apps",
  y."yr"           AS "peak_year",
  y."yr_apps"      AS "apps_in_peak_year"
FROM tot t
JOIN yr_ct y
  ON t."assignee_name" = y."assignee_name"
WHERE y.rn = 1
ORDER BY t."tot_apps" DESC
LIMIT 20;
```

```sql
--Description: 9) Tie everything together – include the top country code in the peak year for each of the top 3 assignees  
WITH top3 AS (   --get 3 highest-volume assignees
  SELECT a.value:"name"::STRING              AS "assignee_name",
         COUNT(DISTINCT pub."application_number") AS "tot_apps"
  FROM PATENTS.PATENTS.PUBLICATIONS pub,
       LATERAL FLATTEN(input => pub."cpc")  c,
       LATERAL FLATTEN(input => pub."assignee_harmonized") a
  WHERE c.value:"code"::STRING ILIKE 'A01B3%'
  GROUP BY a.value:"name"::STRING
  ORDER BY "tot_apps" DESC
  LIMIT 3
),
base AS (
  SELECT  
    a.value:"name"::STRING                  AS "assignee_name",
    pub."application_number",
    TO_NUMBER(LEFT(pub."filing_date",4))    AS "yr",
    pub."country_code"
  FROM PATENTS.PATENTS.PUBLICATIONS  pub,
       LATERAL FLATTEN(input => pub."cpc")  c,
       LATERAL FLATTEN(input => pub."assignee_harmonized") a,
       top3 t
  WHERE c.value:"code"::STRING ILIKE 'A01B3%'
    AND a.value:"name"::STRING = t."assignee_name"
),
peak AS (                               --identify peak year for each assignee
  SELECT b."assignee_name", b."yr",
         COUNT(DISTINCT b."application_number") AS "yr_apps",
         ROW_NUMBER() OVER (PARTITION BY b."assignee_name"
                            ORDER BY COUNT(DISTINCT b."application_number") DESC) AS rn
  FROM base b 
  GROUP BY b."assignee_name", b."yr"
),
top_country AS (                         --within peak year, find top country code
  SELECT  
    b."assignee_name",
    b."yr"       AS "peak_year",
    b."country_code",
    COUNT(DISTINCT b."application_number") AS "ct",
    ROW_NUMBER() OVER (PARTITION BY b."assignee_name", b."yr"
                       ORDER BY COUNT(DISTINCT b."application_number") DESC) AS rn2
  FROM base b
  JOIN peak p
    ON b."assignee_name" = p."assignee_name"
   AND b."yr"            = p."yr"
  WHERE p.rn = 1
  GROUP BY b."assignee_name", b."yr", b."country_code"
)
SELECT  
  p."assignee_name",
  SUM(p."yr_apps")      OVER (PARTITION BY p."assignee_name") AS "total_apps",
  p."yr"                AS "peak_year",
  p."yr_apps"           AS "apps_in_peak_year",
  c."country_code"      AS "top_country_code_in_peak_year"
FROM peak p
JOIN top_country c
  ON p."assignee_name" = c."assignee_name"
 AND p."yr"            = c."peak_year"
WHERE p.rn = 1
  AND c.rn2 = 1
ORDER BY "total_apps" DESC
LIMIT 20;
```

