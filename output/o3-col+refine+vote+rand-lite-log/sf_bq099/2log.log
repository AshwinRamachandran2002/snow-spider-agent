--Description:  End-to-end report for CPC subclass “A01B3”.
--  • Step-1  (a01b3)  – gather every publication whose CPC code starts with A01B3,
--                       extracting assignee name, publication year, and country code.
--  • Step-2  (top3)   – determine the three assignees with the largest total counts.
--  • Step-3  (peak)   – for each of those assignees, find the single publication year
--                       with the greatest number of A01B3 publications (QUALIFY on rank).
--  • Step-4  (cty)    – within each peak year, find the country contributing the most
--                       publications (again QUALIFY on rank).
--  • Final SELECT     – return the five requested fields:
--                       assignee | total applications | peak year | apps in peak year | top country.
WITH a01b3 AS (  ------------------------------------------------------------------- Step-1
    SELECT
        ah.value:"name"::STRING                                AS assignee,
        YEAR(TO_DATE(t."publication_date"::STRING,'YYYYMMDD')) AS pub_year,
        t."country_code"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc")                 c,
         LATERAL FLATTEN(input => t."assignee_harmonized") ah
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
),
top3 AS (   ------------------------------------------------------------------------- Step-2
    SELECT assignee, COUNT(*) AS total_apps
    FROM a01b3
    GROUP BY assignee
    ORDER BY total_apps DESC
    LIMIT 3
),
peak AS (   ------------------------------------------------------------------------- Step-3
    SELECT
        assignee,
        pub_year,
        COUNT(*) AS apps_in_year,
        RANK() OVER (PARTITION BY assignee ORDER BY COUNT(*) DESC) AS rk
    FROM a01b3
    WHERE assignee IN (SELECT assignee FROM top3)
    GROUP BY assignee, pub_year
    QUALIFY rk = 1         -- keep only the year with the greatest count
),
cty AS (    ------------------------------------------------------------------------- Step-4
    SELECT
        a.assignee,
        a.pub_year,
        a."country_code",
        COUNT(*) AS apps_country,
        RANK() OVER (PARTITION BY a.assignee, a.pub_year ORDER BY COUNT(*) DESC) AS rk
    FROM a01b3 a
    JOIN peak p
      ON a.assignee = p.assignee
     AND a.pub_year = p.pub_year
    GROUP BY a.assignee, a.pub_year, a."country_code"
    QUALIFY rk = 1         -- keep only the country with the greatest count
)
SELECT  ----------------------------------------------------------------------------- Result
       t.assignee,
       t.total_apps,
       p.pub_year              AS peak_year,
       p.apps_in_year          AS apps_in_peak_year,
       c."country_code"        AS top_country_in_peak_year
FROM top3  t
JOIN peak  p ON p.assignee = t.assignee
JOIN cty   c ON c.assignee = p.assignee
             AND c.pub_year = p.pub_year
ORDER BY t.total_apps DESC
LIMIT 20;
```
