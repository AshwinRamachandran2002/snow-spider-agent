```sql
--Description:  Build everything in one shot.  
-- 1) “a01b3”     – every publication that carries a CPC code beginning with A01B3, with its assignee, publication-year and country.  
-- 2) “top3”      – the three assignees with the largest total counts.  
-- 3) “year_counts” – for those assignees, count applications per year and rank the years (r = 1 ⇒ peak year).  
-- 4) “peak_year” – keep only each assignee’s peak-year row.  
-- 5) “country_counts” – within each assignee’s peak year, count by country and rank (r = 1 ⇒ top country).  
-- Final SELECT    – return, for each of the top-3 assignees: total apps, peak year, apps in that year, and the country contributing most in that peak year.  
WITH a01b3 AS (
    SELECT
        ah.value:"name"::STRING                                          AS assignee,
        YEAR(TO_DATE(t."publication_date"::STRING,'YYYYMMDD'))           AS pub_year,
        t."country_code"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc")                c,
         LATERAL FLATTEN(input => t."assignee_harmonized") ah
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'                 -- subclass filter
),
top3 AS (
    SELECT assignee, COUNT(*) AS total_apps
    FROM a01b3
    GROUP BY assignee
    ORDER BY total_apps DESC
    LIMIT 3
),
year_counts AS (
    SELECT
        a.assignee,
        a.pub_year,
        COUNT(*) AS apps_in_year,
        RANK() OVER (PARTITION BY a.assignee ORDER BY COUNT(*) DESC) AS r
    FROM a01b3 a
    JOIN top3  t ON a.assignee = t.assignee
    GROUP BY a.assignee, a.pub_year
),
peak_year AS (
    SELECT * FROM year_counts WHERE r = 1                       -- keep only peak year / assignee
),
country_counts AS (
    SELECT
        a.assignee,
        a.pub_year,
        a."country_code",
        COUNT(*) AS apps_country,
        RANK() OVER (
            PARTITION BY a.assignee, a.pub_year
            ORDER BY COUNT(*) DESC
        ) AS r
    FROM a01b3 a
    JOIN peak_year p
      ON a.assignee = p.assignee
     AND a.pub_year = p.pub_year
    GROUP BY a.assignee, a.pub_year, a."country_code"
)
SELECT
       t.assignee,
       t.total_apps,
       p.pub_year          AS peak_year,
       p.apps_in_year      AS apps_in_peak_year,
       c."country_code"    AS top_country_in_peak_year
FROM       top3          t
JOIN       peak_year     p ON t.assignee = p.assignee
JOIN       country_counts c ON c.assignee = p.assignee
                           AND c.pub_year = p.pub_year
                           AND c.r = 1                          -- top country
ORDER BY t.total_apps DESC;
```
