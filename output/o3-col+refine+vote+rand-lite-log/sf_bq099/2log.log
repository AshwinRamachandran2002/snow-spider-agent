--Description:  Complete solution – identify the three assignees with the most A01B3-class applications, then for each:
--              (a) report their total number of A01B3 publications,
--              (b) find the single publication year with the highest count,
--              (c) show the number of publications in that peak year,
--              (d) indicate which country contributed the most publications during that peak year.
WITH a01b3 AS (  -- all A01B3 publications with assignee, year, and country
    SELECT
        ah.value:"name"::STRING                                AS assignee,
        YEAR(TO_DATE(t."publication_date"::STRING,'YYYYMMDD')) AS pub_year,
        t."country_code"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc")                 c,
         LATERAL FLATTEN(input => t."assignee_harmonized") ah
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
),
top3 AS (        -- three biggest assignees
    SELECT assignee, COUNT(*) AS total_apps
    FROM a01b3
    GROUP BY assignee
    ORDER BY total_apps DESC
    LIMIT 3
),
peak_year AS (   -- per-assignee peak publication year
    SELECT
        assignee,
        pub_year,
        COUNT(*) AS apps_in_year,
        RANK() OVER (PARTITION BY assignee ORDER BY COUNT(*) DESC) AS r
    FROM a01b3
    WHERE assignee IN (SELECT assignee FROM top3)
    GROUP BY assignee, pub_year
    QUALIFY r = 1
),
top_country AS ( -- top country within each assignee’s peak year
    SELECT
        a.assignee,
        a.pub_year,
        a."country_code",
        COUNT(*) AS apps_country,
        RANK() OVER (PARTITION BY a.assignee, a.pub_year ORDER BY COUNT(*) DESC) AS r
    FROM a01b3 a
    JOIN peak_year p
      ON a.assignee = p.assignee
     AND a.pub_year = p.pub_year
    GROUP BY a.assignee, a.pub_year, a."country_code"
    QUALIFY r = 1
)
SELECT
       t.assignee,
       t.total_apps,
       p.pub_year              AS peak_year,
       p.apps_in_year          AS apps_in_peak_year,
       c."country_code"        AS top_country_in_peak_year
FROM top3       t
JOIN peak_year  p ON p.assignee = t.assignee
JOIN top_country c ON c.assignee = p.assignee AND c.pub_year = p.pub_year
ORDER BY t.total_apps DESC
LIMIT 20;
