```sql
--Description: Compose final summary—one row per top assignee with total apps, peak year & its count (uses common table expressions)
WITH a01b3 AS (
    SELECT 
           ah.value:"name"::STRING  AS "assignee_name",
           YEAR(TO_DATE(t."filing_date"::STRING,'YYYYMMDD')) AS "filing_year",
           t."country_code"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc") c,
         LATERAL FLATTEN(input => t."assignee_harmonized") ah
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
), total AS (
    SELECT "assignee_name", COUNT(*) AS "total_apps"
    FROM a01b3
    GROUP BY "assignee_name"
    ORDER BY "total_apps" DESC
    LIMIT 3
), yearly AS (
    SELECT a."assignee_name",
           a."filing_year",
           COUNT(*) AS "apps_in_year",
           RANK() OVER (PARTITION BY a."assignee_name" ORDER BY COUNT(*) DESC) AS r
    FROM a01b3 a
    JOIN total t ON a."assignee_name"=t."assignee_name"
    GROUP BY a."assignee_name", a."filing_year"
), topyear AS (
    SELECT * FROM yearly WHERE r=1
), country AS (
    SELECT 
           a."assignee_name",
           a."filing_year",
           a."country_code",
           COUNT(*) AS "apps_country",
           RANK() OVER (PARTITION BY a."assignee_name", a."filing_year" ORDER BY COUNT(*) DESC) AS r
    FROM a01b3 a
    JOIN topyear y 
      ON a."assignee_name"=y."assignee_name"
     AND a."filing_year"   =y."filing_year"
    GROUP BY a."assignee_name", a."filing_year", a."country_code"
)
SELECT 
       t."assignee_name",
       t."total_apps",
       y."filing_year"      AS "peak_year",
       y."apps_in_year"     AS "apps_in_peak_year",
       c."country_code"     AS "top_country_in_peak_year"
FROM total t
JOIN topyear y ON t."assignee_name"=y."assignee_name"
JOIN country  c ON y."assignee_name"=c."assignee_name"
               AND y."filing_year"  =c."filing_year"
               AND c.r=1
ORDER BY t."total_apps" DESC
LIMIT 20;
```

