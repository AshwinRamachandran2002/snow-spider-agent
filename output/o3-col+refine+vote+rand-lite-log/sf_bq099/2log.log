--Description: For the same assignee, pick the single peak-publication year (derived inline) and list application counts by country for that year.  Uses “publication_date” instead of the sparsely-filled “filing_date”.
WITH assignee_data AS (
    SELECT
        t."country_code",
        YEAR(TO_DATE(t."publication_date"::STRING,'YYYYMMDD')) AS pub_year
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc")                c,
         LATERAL FLATTEN(input => t."assignee_harmonized") ah
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
      AND ah.value:"name"::STRING = 'LELY NV C VAN DER'      -- <-- replace with assignee of interest
),
peak AS (
    SELECT pub_year, COUNT(*) AS apps,
           RANK() OVER (ORDER BY COUNT(*) DESC) AS r
    FROM assignee_data
    GROUP BY pub_year
)
SELECT 
       ad."country_code",
       COUNT(*) AS apps_in_peak_year
FROM assignee_data ad
JOIN peak p ON ad.pub_year = p.pub_year
WHERE p.r = 1                                  -- keep only the peak year
GROUP BY ad."country_code"
ORDER BY apps_in_peak_year DESC
LIMIT 20;
