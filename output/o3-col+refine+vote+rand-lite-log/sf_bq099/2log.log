Query:
--Description: Repeat peak-year / country analysis for the three top assignees (found earlier) using “publication_date”.
WITH a01b3 AS (
    SELECT
        ah.value:"name"::STRING                                AS assignee,
        YEAR(TO_DATE(t."publication_date"::STRING,'YYYYMMDD')) AS pub_year,
        t."country_code"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc")                c,
         LATERAL FLATTEN(input => t."assignee_harmonized") ah
    WHERE c.value:"code"::STRING ILIKE 'A01B3%'
      AND ah.value:"name"::STRING IN ('LELY NV C VAN DER','TEXAS INDUSTRIES INC','DEERE & CO')  -- top-3 names
),
peak_year AS (
    SELECT
        assignee,
        pub_year,
        COUNT(*) AS apps,
        RANK() OVER (PARTITION BY assignee ORDER BY COUNT(*) DESC) AS r
    FROM a01b3
    GROUP BY assignee, pub_year
    QUALIFY r = 1                                              -- only peak year per assignee
)
SELECT
       a.assignee,
       a.pub_year,
       a."country_code",
       COUNT(*) AS apps
FROM a01b3 a
JOIN peak_year p
  ON a.assignee = p.assignee
 AND a.pub_year = p.pub_year
GROUP BY a.assignee, a.pub_year, a."country_code"
ORDER BY a.assignee, apps DESC
LIMIT 20
