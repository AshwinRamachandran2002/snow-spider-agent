```sql
--Description:
-- Goal: Return the single top-ranked rising search term for the week that is
-- as close as possible to “one year before” the latest week in the table.
--
-- Step-by-step thinking (expressed as comments):
-- 1) LATEST_WEEK  = the maximum “week” value stored in TOP_RISING_TERMS.
-- 2) TARGET_DATE  = LATEST_WEEK minus 52 weeks (exactly one calendar year).
-- 3) TARGET_WEEK  = the greatest “week” that is ≤ TARGET_DATE
--                   (handles cases where the exact one-year-prior week isn’t present).
-- 4) From TARGET_WEEK, keep only the row(s) with the minimum “rank” (i.e., rank = 1).
-- 5) Limit to the first 20 rows just to be safe (usually only a few ties exist).
SELECT  "term",
        "rank",
        "week",
        "percent_gain",
        "dma_name",
        "dma_id"
FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
WHERE "week" = (
        /* Step-3: closest recorded week on/before one-year-prior date */
        SELECT MAX("week")
        FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
        WHERE "week" <= DATEADD(week, -52,
                                (SELECT MAX("week")
                                 FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"))
      )
  AND "rank" = (
        /* Step-4: the best (smallest) rank for that week */
        SELECT MIN("rank")
        FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
        WHERE "week" = (
              SELECT MAX("week")
              FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
              WHERE "week" <= DATEADD(week, -52,
                                      (SELECT MAX("week")
                                       FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"))
             )
      )
ORDER BY "term"
LIMIT 20;
```
