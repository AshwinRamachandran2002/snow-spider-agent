    WHERE "week" <= anchor
)
SELECT MIN("rank") AS "top_rank"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
WHERE "week" = (SELECT chosen_week FROM chosen_week)
LIMIT 20
