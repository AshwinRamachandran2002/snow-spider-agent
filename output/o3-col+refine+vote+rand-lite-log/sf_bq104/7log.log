```sql
WITH latest_refresh AS (
    -- 1. Most recent refresh_date in the table
    SELECT MAX("refresh_date") AS "latest_refresh_date"
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
),
latest_week AS (
    -- 2. Latest available week for that refresh_date
    SELECT MAX("week") AS "latest_week"
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
    WHERE "refresh_date" = (SELECT "latest_refresh_date" FROM latest_refresh)
),
one_year_prior_week AS (
    -- 3. Week exactly one year before the latest week
    SELECT DATEADD(year, -1, "latest_week") AS "target_week"
    FROM latest_week
),
year_prior_data AS (
    -- 4. Rows for that prior week, using only the most-recent refresh_date
    SELECT
        "term",
        "rank",
        "percent_gain",
        "week"
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
    WHERE "refresh_date" = (SELECT "latest_refresh_date" FROM latest_refresh)
      AND "week" = (SELECT "target_week" FROM one_year_prior_week)
),
top_rank AS (
    -- 5. Best (minimum) rank that week
    SELECT MIN("rank") AS "best_rank"
    FROM year_prior_data
)
-- 6. Return the top-ranked rising search term(s) for that week
SELECT
    "term",
    "rank",
    "percent_gain",
    "week"
FROM year_prior_data
WHERE "rank" = (SELECT "best_rank" FROM top_rank)
ORDER BY "term";
```
