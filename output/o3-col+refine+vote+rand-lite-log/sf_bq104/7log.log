```sql
--Description: Identify the most recent week in the dataset, move back exactly one year, pick the closest week on or before that anchor date (so we always land on an existing week), then return the rising-term row(s) with the best (lowest) rank for that chosen week—the top-ranked rising search term one year prior to the latest available week.
WITH latest_week AS (                                                          -- Step 1: latest week overall
    SELECT MAX("week") AS latest_week
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
),
anchor_date AS (                                                               -- Step 2: subtract one year
    SELECT DATEADD(year, -1, latest_week) AS anchor
    FROM latest_week
),
chosen_week AS (                                                               -- Step 3: nearest week ≤ anchor
    SELECT MAX("week") AS chosen_week
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS, anchor_date
    WHERE "week" <= anchor
),
top_rank AS (                                                                  -- Step 4: minimal rank that week
    SELECT MIN("rank") AS top_rank
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
    WHERE "week" = (SELECT chosen_week FROM chosen_week)
)
SELECT "term",
       "rank",
       "percent_gain",
       "dma_name",
       "dma_id",
       "week"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS                              -- Step 5: final result
WHERE "week" = (SELECT chosen_week FROM chosen_week)
  AND "rank" = (SELECT top_rank FROM top_rank)
ORDER BY "term"
LIMIT 20;
```
