Query:
--Description: Return the top-ranked rising search term(s) for that target week, showing details for each DMA that shares the best rank.
SELECT "term",
       "rank",
       "score",
       "percent_gain",
       "dma_id",
       "dma_name"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
WHERE "week" = DATEADD(week, -52,
                       (SELECT MAX("week")
                        FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS))
  AND "rank" = (SELECT MIN("rank")
                FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
                WHERE "week" = DATEADD(week, -52,
                                       (SELECT MAX("week")
                                        FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS)))
ORDER BY "dma_name" ASC
LIMIT 20
