```sql
--Description: Thinking process – 
-- 1) Determine the most-recent “week” in the whole table (MAX("week")). 
-- 2) Subtract 52 weeks (DATEADD(week,-52,…)) to reach the equivalent week exactly one year earlier. 
-- 3) Return every rising-term row for that target week, ordering by ascending "rank" so the top-ranked term(s) come first.
SELECT *
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
WHERE "week" = DATEADD(week, -52,
                       (SELECT MAX("week")
                        FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS))
ORDER BY "rank" ASC
LIMIT 20;
```
