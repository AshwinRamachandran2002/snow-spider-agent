Query:
--Description: Get the minimum (best) rank for the week that is exactly 52 weeks before the latest week in the table.
SELECT MIN("rank") AS "best_rank"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
WHERE "week" = DATEADD(week, -52,
                       (SELECT MAX("week")
                        FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS))
LIMIT 20
