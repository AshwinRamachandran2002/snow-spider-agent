--Description: Compute the date exactly one year (365 days) before the latest week; show it along with latest week
SELECT  ( SELECT MAX("week")
          FROM GOOGLE_TRENDS.GOOGLE_TRENDS."TOP_RISING_TERMS"
          WHERE "refresh_date" = ( SELECT MAX("refresh_date")
                                   FROM GOOGLE_TRENDS.GOOGLE_TRENDS."TOP_RISING_TERMS" ) )          AS "latest_week",
        DATEADD('day', -365,
          ( SELECT MAX("week")
            FROM GOOGLE_TRENDS.GOOGLE_TRENDS."TOP_RISING_TERMS"
            WHERE "refresh_date" = ( SELECT MAX("refresh_date")
                                     FROM GOOGLE_TRENDS.GOOGLE_TRENDS."TOP_RISING_TERMS" ) ) )      AS "week_one_year_prior";
