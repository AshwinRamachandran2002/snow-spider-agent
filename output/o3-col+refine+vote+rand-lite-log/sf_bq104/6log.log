/* Identify the top-ranked rising search term for the week exactly
   one year prior to the latest available week, using the most-recent
   refresh of the data                                     */

WITH latest_refresh AS (
    SELECT MAX("refresh_date") AS "refresh_date"
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS."TOP_RISING_TERMS"
),
latest_week AS (
    SELECT MAX("week") AS "week"
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS."TOP_RISING_TERMS"
    WHERE "refresh_date" = (SELECT "refresh_date" FROM latest_refresh)
),
target_week AS (
