```sql
--Description: 
-- Step-1  ➜  grab the latest “week” value in the dataset and subtract 52 weeks to land on the
--            comparable week exactly one year earlier (“target_week”).
-- Step-2  ➜  for that target_week, pick the most-recent snapshot (largest refresh_date) so we’re
--            using the freshest data available for that week.
-- Step-3  ➜  return the rows whose rank = 1 (i.e., the top-ranked rising search term) for that
--            week, along with a few helpful fields.
SELECT
       "term",
       "rank",
       "week",
       "percent_gain",
       "dma_name",
       "dma_id",
       "refresh_date"
FROM   GOOGLE_TRENDS.GOOGLE_TRENDS."TOP_RISING_TERMS"
WHERE  "week" = (  -- target_week one year prior to the latest observed week
           SELECT DATEADD('week', -52, MAX("week"))
           FROM   GOOGLE_TRENDS.GOOGLE_TRENDS."TOP_RISING_TERMS"
       )
  AND  "refresh_date" = (  -- freshest snapshot for that target_week
           SELECT MAX("refresh_date")
           FROM   GOOGLE_TRENDS.GOOGLE_TRENDS."TOP_RISING_TERMS"
           WHERE  "week" = (
                    SELECT DATEADD('week', -52, MAX("week"))
                    FROM   GOOGLE_TRENDS.GOOGLE_TRENDS."TOP_RISING_TERMS"
                  )
       )
  AND  "rank" = 1          -- keep only the top-ranked rising term(s)
ORDER BY "percent_gain" DESC
LIMIT 20;
```
