Query:
-- Description: Retrieve all rising-term rows for the “one-year-prior (closest)” week, using the latest refresh date.
SELECT *
FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
WHERE "refresh_date" = (SELECT MAX("refresh_date")
                        FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS")
  AND "week" = (
        /* pick the stored week closest to exactly one-year-prior */
        SELECT "week"
        FROM (
            SELECT DISTINCT "week"
            FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
        ) w
        ORDER BY ABS(DATEDIFF(day,
                              w."week",
                              DATEADD(year, -1,
                                      (SELECT MAX("week")
                                       FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS")))) ASC
        LIMIT 1
      )
LIMIT 20
