```sql
-- Description / Thinking process:
-- 1) latest_week_cte:   Grab the latest calendar “week” present in the table.
-- 2) target_date_cte:   Shift that date back by exactly one year.
-- 3) candidate_weeks:   Pull all distinct weeks that are within ±7 days of the target date.
-- 4) best_week:         Choose the candidate week closest to the target date.
-- 5) latest_refresh:    Capture the most-recent refresh_date (ensuring we use the freshest run).
-- 6) rising_rows:       Keep only rows from latest_refresh & best_week.
-- 7) top_term:          From those rows, pick the term with the lowest (best) rank.
WITH latest_week_cte AS (
    SELECT MAX("week") AS "latest_week"
    FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
),
target_date_cte AS (
    SELECT DATEADD(year, -1, "latest_week") AS "target_date"
    FROM latest_week_cte
),
candidate_weeks AS (
    SELECT DISTINCT "week"
    FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS", target_date_cte
    WHERE ABS(DATEDIFF(day, "week", "target_date")) <= 7
),
best_week AS (
    SELECT "week"
    FROM candidate_weeks, target_date_cte
    ORDER BY ABS(DATEDIFF(day, "week", "target_date")) ASC
    LIMIT 1
),
latest_refresh AS (
    SELECT MAX("refresh_date") AS "latest_refresh"
    FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
),
rising_rows AS (
    SELECT *
    FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
    WHERE "refresh_date" = (SELECT "latest_refresh" FROM latest_refresh)
      AND "week"        = (SELECT "week"          FROM best_week)
),
top_term AS (
    SELECT "term", "rank"
    FROM rising_rows
    ORDER BY "rank" ASC
    LIMIT 1
)
SELECT *
FROM top_term;
```
