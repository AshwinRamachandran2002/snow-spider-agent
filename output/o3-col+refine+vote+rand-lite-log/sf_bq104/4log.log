ORDER BY "week" DESC
LIMIT 20;
```

```sql
--Description: 4. Compute the week that is exactly one year (-365 days) before the latest week in the table.
SELECT DATEADD(year, -1, MAX("week")) AS "week_minus_one_year"
FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
LIMIT 20;
```

```sql
--Description: 5. Verify that the computed “one-year-ago” week actually exists in the dataset.
SELECT DISTINCT "week"
FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
WHERE "week" = (
        SELECT DATEADD(year, -1, MAX("week"))
        FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
      )
LIMIT 20;
```

```sql
--Description: 6. List every rising term for the week that is one year prior to the latest week, ordered by rank.
SELECT *
FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
WHERE "week" = (
        SELECT DATEADD(year, -1, MAX("week"))
        FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
      )
ORDER BY "rank" ASC
LIMIT 20;
```

```sql
--Description: 7. Narrow the previous result to show only term, rank, and DMA for that target week.
SELECT "term",
       "rank",
       "dma_name"
FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
WHERE "week" = (
        SELECT DATEADD(year, -1, MAX("week"))
        FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
      )
ORDER BY "rank" ASC
LIMIT 20;
```

```sql
--Description: 8. Include percent_gain so we can compare ties when several terms share the same rank.
SELECT "term",
       "rank",
       "percent_gain"
FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
WHERE "week" = (
        SELECT DATEADD(year, -1, MAX("week"))
        FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
      )
ORDER BY "rank" ASC,
         "percent_gain" DESC
LIMIT 20;
```

```sql
--Description: 9. Quickly see any term already sitting at rank = 1 for the target week.
SELECT *
FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
WHERE "week" = (
        SELECT DATEADD(year, -1, MAX("week"))
        FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
      )
  AND "rank" = 1
ORDER BY "percent_gain" DESC
LIMIT 20;
```

```sql
--Description: 10. Final query – pick the single top-ranked rising term (lowest rank, highest percent_gain tie-breaker) for the week exactly one year before the latest week.
SELECT sub."term",
       sub."rank",
       sub."percent_gain",
       sub."week",
       sub."dma_name"
FROM (
        SELECT t.*,
               ROW_NUMBER() OVER (ORDER BY t."rank" ASC, t."percent_gain" DESC) AS rn
        FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS" t
        WHERE t."week" = (
                SELECT DATEADD(year, -1, MAX("week"))
                FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_RISING_TERMS"
              )
     ) sub
WHERE sub.rn = 1
LIMIT 20;
```
