```sql
WITH latest_refresh AS (      -- most recent refresh date
    SELECT MAX("refresh_date") AS "refresh_date"
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
),
latest_week AS (              -- latest week within that refresh
    SELECT MAX(t."week") AS "latest_week"
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS t
    JOIN latest_refresh lr
      ON t."refresh_date" = lr."refresh_date"
),
target_week AS (              -- exactly one-year-prior week
    SELECT DATEADD(year, -1, "latest_week") AS "target_week"
    FROM latest_week
),
candidates AS (               -- rows on latest refresh & target week
    SELECT t.*
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS t
    JOIN latest_refresh lr  ON t."refresh_date" = lr."refresh_date"
    JOIN target_week   tw   ON t."week"        = tw."target_week"
)
SELECT "term",
       "rank",
       "percent_gain",
       "week",
       "dma_name"
FROM (
    SELECT c.*,
           ROW_NUMBER() OVER (
               ORDER BY "rank" ASC,
                        "percent_gain" DESC NULLS LAST
           ) AS rn
    FROM candidates c
) sub
WHERE rn = 1;
```
