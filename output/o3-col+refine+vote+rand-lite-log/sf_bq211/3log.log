-- Description: 3) Count how many distinct application numbers exist in each family (across the whole table, any country / date).
SELECT 
  "family_id",
  COUNT(DISTINCT "application_number") AS "distinct_applications"
FROM PATENTS.PATENTS.PUBLICATIONS
GROUP BY "family_id"
ORDER BY "distinct_applications" DESC
LIMIT 20;
