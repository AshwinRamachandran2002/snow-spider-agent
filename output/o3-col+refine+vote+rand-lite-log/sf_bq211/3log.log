Query:
-- Description: 7) Aggregate the previous query to count how many CN grants (2010-2023) belong to families
-- with >1 distinct applications.  Keeps one row holding the answer.
SELECT 
  COUNT(*) AS "cn_granted_2010_2023_in_families_with_gt1_app"
FROM PATENTS.PATENTS.PUBLICATIONS p
JOIN (
    SELECT 
      "family_id"
    FROM PATENTS.PATENTS.PUBLICATIONS
    GROUP BY "family_id"
    HAVING COUNT(DISTINCT "application_number") > 1
) fam
  ON p."family_id" = fam."family_id"
WHERE p."country_code" = 'CN'
  AND p."grant_date" BETWEEN 20100101 AND 20231231
LIMIT 20;
Answer:
cn_granted_2010_2023_in_families_with_gt1_app
161
Query:
-- Description: 8) (Optional) If you want the same count but restricted to one record per publication number,
-- remove any duplicate rows that might exist.
SELECT 
  COUNT(DISTINCT p."publication_number") AS "cn_unique_publications_2010_2023_in_families_with_gt1_app"
FROM PATENTS.PATENTS.PUBLICATIONS p
JOIN (
    SELECT 
      "family_id"
    FROM PATENTS.PATENTS.PUBLICATIONS
    GROUP BY "family_id"
    HAVING COUNT(DISTINCT "application_number") > 1
) fam
  ON p."family_id" = fam."family_id"
WHERE p."country_code" = 'CN'
  AND p."grant_date" BETWEEN 20100101 AND 20231231
LIMIT 20;
