```sql
-- Description: 1) Quick look at a handful of publications to refresh the main columns we will use.
SELECT 
  "publication_number",
  "application_number",
  "country_code",
  "grant_date",
  "family_id"
FROM PATENTS.PATENTS.PUBLICATIONS
LIMIT 20;
```

```sql
-- Description: 2) Sample of Chinese (CN) publications that are recorded as granted between 2010-01-01 and 2023-12-31.
SELECT 
  "publication_number",
  "application_number",
  "grant_date",
  "family_id"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CN'
  AND "grant_date" BETWEEN 20100101 AND 20231231
LIMIT 20;
```

```sql
-- Description: 3) Count how many distinct application numbers exist in each family (across the whole table, any country / date).
SELECT 
  "family_id",
  COUNT(DISTINCT "application_number") AS "distinct_applications"
FROM PATENTS.PATENTS.PUBLICATIONS
GROUP BY "family_id"
ORDER BY "distinct_applications" DESC
LIMIT 20;
```

```sql
-- Description: 4) Display families whose total number of distinct applications is greater than 1.
SELECT 
  "family_id",
  COUNT(DISTINCT "application_number") AS "distinct_applications"
FROM PATENTS.PATENTS.PUBLICATIONS
GROUP BY "family_id"
HAVING COUNT(DISTINCT "application_number") > 1
LIMIT 20;
```

```sql
-- Description: 5) Preview Chinese grants in 2010-2023 together with their family distinct-application counts, 
-- so we can see which ones satisfy the “>1 distinct applications” condition.
SELECT 
  p."publication_number",
  p."application_number",
  p."grant_date",
  p."family_id",
  fam."distinct_applications"
FROM PATENTS.PATENTS.PUBLICATIONS p
JOIN (
    SELECT 
      "family_id",
      COUNT(DISTINCT "application_number") AS "distinct_applications"
    FROM PATENTS.PATENTS.PUBLICATIONS
    GROUP BY "family_id"
) fam
  ON p."family_id" = fam."family_id"
WHERE p."country_code" = 'CN'
  AND p."grant_date" BETWEEN 20100101 AND 20231231
LIMIT 20;
```

```sql
-- Description: 6) Same as query 5, but keep only those families having more than one distinct application.
SELECT 
  p."publication_number",
  p."application_number",
  p."grant_date",
  p."family_id"
FROM PATENTS.PATENTS.PUBLICATIONS p
JOIN (
    SELECT 
      "family_id"
    FROM PATENTS.PATENTS.PUBLICATIONS
    GROUP BY "family_id"
    HAVING COUNT(DISTINCT "application_number") > 1
) fam
  ON p."family_id" = fam."family_id"
WHERE p."country_code" = 'CN'
  AND p."grant_date" BETWEEN 20100101 AND 20231231
LIMIT 20;
```

```sql
