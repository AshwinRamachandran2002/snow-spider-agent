```sql
--Description: 1) Take a first look at a few Chinese (“CN”) publications: key date & family fields.  
SELECT 
    "publication_number",
    "grant_date",
    "family_id",
    "application_number"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CN'
LIMIT 20;
```

```sql
--Description: 2) Same as above, but keep only grants between 2010-01-01 and 2023-12-31.  
SELECT 
    "publication_number",
    "grant_date",
    "family_id",
    "application_number"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CN'
  AND "grant_date" BETWEEN 20100101 AND 20231231
LIMIT 20;
```

```sql
--Description: 3) Show distinct families (family_id) for CN grants 2010-2023.  
SELECT DISTINCT
    "family_id"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CN'
  AND "grant_date" BETWEEN 20100101 AND 20231231
LIMIT 20;
```

```sql
--Description: 4) For every family in the entire PUBLICATIONS table, count distinct applications.  
SELECT 
    "family_id",
    COUNT(DISTINCT "application_number") AS "distinct_app_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS
GROUP BY "family_id"
LIMIT 20;
```

```sql
--Description: 5) Families that have more than one distinct application in total.  
SELECT 
    "family_id"
FROM PATENTS.PATENTS.PUBLICATIONS
GROUP BY "family_id"
HAVING COUNT(DISTINCT "application_number") > 1
LIMIT 20;
```

```sql
--Description: 6) Intersect the two sets: CN grants 2010-2023 whose family has >1 applications.  
SELECT 
    p."publication_number",
    p."grant_date",
    p."family_id",
    p."application_number"
FROM PATENTS.PATENTS.PUBLICATIONS p
JOIN (
    SELECT "family_id"
    FROM PATENTS.PATENTS.PUBLICATIONS
    GROUP BY "family_id"
    HAVING COUNT(DISTINCT "application_number") > 1
) f
  ON p."family_id" = f."family_id"
WHERE p."country_code" = 'CN'
  AND p."grant_date" BETWEEN 20100101 AND 20231231
LIMIT 20;
```

```sql
--Description: 7) Count how many such CN-grant records exist (simple row count).  
SELECT 
    COUNT(*) AS "cn_granted_2010_2023_with_multi_app_fam"
FROM PATENTS.PATENTS.PUBLICATIONS p
JOIN (
    SELECT "family_id"
    FROM PATENTS.PATENTS.PUBLICATIONS
    GROUP BY "family_id"
    HAVING COUNT(DISTINCT "application_number") > 1
) f
  ON p."family_id" = f."family_id"
WHERE p."country_code" = 'CN'
  AND p."grant_date" BETWEEN 20100101 AND 20231231;
```

```sql
--Description: 8) If you need only one record per publication family (dedup by publication_number) while counting.  
SELECT 
    COUNT(DISTINCT p."publication_number") AS "distinct_cn_publications"
FROM PATENTS.PATENTS.PUBLICATIONS p
JOIN (
    SELECT "family_id"
    FROM PATENTS.PATENTS.PUBLICATIONS
    GROUP BY "family_id"
    HAVING COUNT(DISTINCT "application_number") > 1
) f
  ON p."family_id" = f."family_id"
WHERE p."country_code" = 'CN'
  AND p."grant_date" BETWEEN 20100101 AND 20231231;
```

```sql
--Description: 9) Return the list of the first 20 family_ids that meet all conditions, together with their total number of distinct applications (sanity-check).  
SELECT 
    p."family_id",
    COUNT(DISTINCT p."application_number") AS "cn_app_cnt_in_family",
    MIN(p."grant_date") AS "earliest_cn_grant_date"
FROM PATENTS.PATENTS.PUBLICATIONS p
WHERE p."country_code" = 'CN'
  AND p."grant_date" BETWEEN 20100101 AND 20231231
  AND p."family_id" IN (
        SELECT "family_id"
        FROM PATENTS.PATENTS.PUBLICATIONS
        GROUP BY "family_id"
        HAVING COUNT(DISTINCT "application_number") > 1
)
GROUP BY p."family_id"
LIMIT 20;
```

