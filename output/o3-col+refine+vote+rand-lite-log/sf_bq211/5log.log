Query:
--Description: 9) Return the list of the first 20 family_ids that meet all conditions, together with their total number of distinct applications (sanity-check).  
SELECT 
    p."family_id",
    COUNT(DISTINCT p."application_number") AS "cn_app_cnt_in_family",
    MIN(p."grant_date") AS "earliest_cn_grant_date"
FROM PATENTS.PATENTS.PUBLICATIONS p
WHERE p."country_code" = 'CN'
  AND p."grant_date" BETWEEN 20100101 AND 20231231
  AND p."family_id" IN (
        SELECT "family_id"
        FROM PATENTS.PATENTS.PUBLICATIONS
        GROUP BY "family_id"
        HAVING COUNT(DISTINCT "application_number") > 1
)
GROUP BY p."family_id"
LIMIT 20;
