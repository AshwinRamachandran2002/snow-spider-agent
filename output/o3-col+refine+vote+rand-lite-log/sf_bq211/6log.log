```sql
--Description: 1) Quick glimpse at CN publications (any years)
SELECT 
    "publication_number",
    "grant_date",
    "country_code",
    "family_id",
    "application_number"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CN'
LIMIT 20;
```

```sql
--Description: 2) CN publications that have a non-zero grant_date (to be sure they are granted)
SELECT 
    "publication_number",
    "grant_date",
    "family_id",
    "application_number"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CN'
  AND "grant_date" > 0
LIMIT 20;
```

```sql
--Description: 3) CN patents granted from 2010-01-01 through 2023-12-31 (inclusive)
SELECT 
    "publication_number",
    "grant_date",
    "family_id",
    "application_number"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CN'
  AND "grant_date" BETWEEN 20100101 AND 20231231
LIMIT 20;
```

```sql
--Description: 4) For those CN granted patents (2010-2023), count how many distinct applications each family_id has
SELECT 
    "family_id",
    COUNT(DISTINCT "application_number") AS "distinct_app_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CN'
  AND "grant_date" BETWEEN 20100101 AND 20231231
GROUP BY "family_id"
LIMIT 20;
```

```sql
--Description: 5) Show only the family_ids that have more than one distinct application_number
SELECT 
    "family_id",
    COUNT(DISTINCT "application_number") AS "distinct_app_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CN'
  AND "grant_date" BETWEEN 20100101 AND 20231231
GROUP BY "family_id"
HAVING COUNT(DISTINCT "application_number") > 1
LIMIT 20;
```

```sql
--Description: 6) Join back to the CN granted-patent rows that belong to those multi-application families
WITH multi_app_families AS (
    SELECT 
        "family_id"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "country_code" = 'CN'
      AND "grant_date" BETWEEN 20100101 AND 20231231
    GROUP BY "family_id"
    HAVING COUNT(DISTINCT "application_number") > 1
)
SELECT 
    p."publication_number",
    p."grant_date",
    p."family_id",
    p."application_number"
FROM PATENTS.PATENTS.PUBLICATIONS p
JOIN multi_app_families f
  ON p."family_id" = f."family_id"
WHERE p."country_code" = 'CN'
  AND p."grant_date" BETWEEN 20100101 AND 20231231
LIMIT 20;
```

```sql
--Description: 7) Count how many CN granted-patent records meet the criteria (families with >1 applications, 2010-2023)
WITH multi_app_families AS (
    SELECT 
        "family_id"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "country_code" = 'CN'
      AND "grant_date" BETWEEN 20100101 AND 20231231
    GROUP BY "family_id"
    HAVING COUNT(DISTINCT "application_number") > 1
)
SELECT 
    COUNT(*) AS "cn_granted_2010_2023_multiapp"
FROM PATENTS.PATENTS.PUBLICATIONS p
JOIN multi_app_families f
  ON p."family_id" = f."family_id"
WHERE p."country_code" = 'CN'
  AND p."grant_date" BETWEEN 20100101 AND 20231231
LIMIT 20;
```

```sql
--Description: 8) If you instead want the number of unique families (not individual patents) meeting the same criteria
WITH multi_app_families AS (
    SELECT 
        "family_id"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "country_code" = 'CN'
      AND "grant_date" BETWEEN 20100101 AND 20231231
    GROUP BY "family_id"
    HAVING COUNT(DISTINCT "application_number") > 1
)
SELECT 
    COUNT(DISTINCT "family_id") AS "unique_families_multiapp_cn_2010_2023"
FROM multi_app_families
LIMIT 20;
```
