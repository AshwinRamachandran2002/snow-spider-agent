           ON bs.match_id=b.match_id AND bs.over_id=b.over_id
          AND bs.ball_id=b.ball_id AND bs.innings_no=b.innings_no
    LEFT  JOIN extra_runs AS er
           ON er.match_id=b.match_id AND er.over_id=b.over_id
