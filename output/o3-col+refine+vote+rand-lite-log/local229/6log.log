--              • numbered: give the two batters row-numbers 1/2 for pivoting
--              • pivot:  one row per stand (player_low / player_high, runs_low / runs_high)
--              • ranked: rank stands by partnership_runs inside the match
--              • ordered: apply output ordering rule (higher individual runs first,
--                        if equal then higher player_id first)
--              Finally filter to match_id = 335987.
WITH ball AS (
    SELECT  b.match_id,
            b.innings_no,
            b.striker,
            b.non_striker,
            COALESCE(bs.runs_scored,0) AS runs_scored,
            COALESCE(er.extra_runs ,0) AS extra_runs,
