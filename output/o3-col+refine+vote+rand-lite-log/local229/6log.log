```sql
--Description:  Build a clean “partnership” snapshot (first 20 rows) without
--              nesting aggregate functions – the reason the previous query failed.
--              Outline
--              1)  ball  : every delivery with striker-runs, extras and a flag if the
--                          dismissal ends the current stand (is_wkt).
--              2)  tagged: cumulative sum of is_wkt inside each innings → partnership-id (p_id).
--              3)  tot   : total partnership runs (batsman + extras) for every p_id.
--              4)  indiv : individual runs that each batsman scored in that stand.
--              5)  pivot : turn the two batsmen rows into one (player_low / player_high,
--                          runs_low / runs_high) using ROW_NUMBER – no aggregate function
--                          is placed inside another aggregate, so SQLite is happy.
WITH ball AS (                       -- step 1
    SELECT  b.match_id,
            b.innings_no,
            b.striker,
            b.non_striker,
            COALESCE(bs.runs_scored,0) AS runs_scored,
            COALESCE(er.extra_runs ,0) AS extra_runs,
            CASE
                 WHEN wt.player_out IS NOT NULL
                  AND (wt.player_out = b.striker OR wt.player_out = b.non_striker)
                 THEN 1 ELSE 0
            END                         AS is_wkt,
            b.over_id,
            b.ball_id
    FROM   ball_by_ball AS b
    LEFT  JOIN batsman_scored AS bs
           ON  bs.match_id  = b.match_id
          AND bs.over_id    = b.over_id
          AND bs.ball_id    = b.ball_id
          AND bs.innings_no = b.innings_no
    LEFT  JOIN extra_runs    AS er
           ON  er.match_id   = b.match_id
          AND er.over_id     = b.over_id
          AND er.ball_id     = b.ball_id
          AND er.innings_no  = b.innings_no
    LEFT  JOIN wicket_taken  AS wt
           ON  wt.match_id   = b.match_id
          AND wt.over_id     = b.over_id
          AND wt.ball_id     = b.ball_id
          AND wt.innings_no  = b.innings_no
), tagged AS (                       -- step 2
    SELECT *,
           SUM(is_wkt) OVER (
                 PARTITION BY match_id, innings_no
                 ORDER BY over_id, ball_id
           ) AS p_id
    FROM   ball
), tot AS (                           -- step 3
    SELECT match_id,
           p_id,
           SUM(runs_scored + extra_runs) AS partnership_runs
    FROM   tagged
    GROUP BY match_id, p_id
), indiv AS (                         -- step 4
    SELECT match_id,
           p_id,
           striker                AS player_id,
           SUM(runs_scored)       AS runs
    FROM   tagged
    GROUP BY match_id, p_id, striker
), pivot AS (                         -- step 5
    SELECT  t.match_id,
            t.p_id,
            MAX(CASE WHEN r.rn = 1 THEN r.player_id END) AS player_low,
            MAX(CASE WHEN r.rn = 2 THEN r.player_id END) AS player_high,
            MAX(CASE WHEN r.rn = 1 THEN r.runs END)      AS runs_low,
            MAX(CASE WHEN r.rn = 2 THEN r.runs END)      AS runs_high,
            t.partnership_runs
    FROM    tot AS t
    JOIN   ( SELECT  i.*,
                     ROW_NUMBER() OVER (PARTITION BY i.match_id, i.p_id
                                        ORDER BY i.player_id) AS rn
             FROM    indiv AS i
           ) AS r
      ON    r.match_id = t.match_id
     AND    r.p_id     = t.p_id
    GROUP BY t.match_id, t.p_id, t.partnership_runs
)
SELECT *
FROM   pivot
LIMIT 20;
