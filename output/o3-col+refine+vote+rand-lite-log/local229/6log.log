```sql
--Description:  (#7) Rank every partnership (built without nested aggregates) by
--              its total runs and keep only the highest-scoring stand(s) per match
--              – first 20 rows shown.
WITH ball AS (
    SELECT  b.match_id,
            b.innings_no,
            b.striker,
            b.non_striker,
            COALESCE(bs.runs_scored,0) AS runs_scored,
            COALESCE(er.extra_runs ,0) AS extra_runs,
            CASE
                 WHEN wt.player_out IS NOT NULL
                  AND (wt.player_out = b.striker OR wt.player_out = b.non_striker)
                 THEN 1 ELSE 0
            END                         AS is_wkt,
            b.over_id,
            b.ball_id
    FROM   ball_by_ball AS b
    LEFT  JOIN batsman_scored AS bs
           ON  bs.match_id  = b.match_id
          AND bs.over_id    = b.over_id
          AND bs.ball_id    = b.ball_id
          AND bs.innings_no = b.innings_no
    LEFT  JOIN extra_runs    AS er
           ON  er.match_id   = b.match_id
          AND er.over_id     = b.over_id
          AND er.ball_id     = b.ball_id
          AND er.innings_no  = b.innings_no
    LEFT  JOIN wicket_taken  AS wt
           ON  wt.match_id   = b.match_id
          AND wt.over_id     = b.over_id
          AND wt.ball_id     = b.ball_id
          AND wt.innings_no  = b.innings_no
), tagged AS (
    SELECT *,
           SUM(is_wkt) OVER (PARTITION BY match_id, innings_no
                             ORDER BY over_id, ball_id) AS p_id
    FROM   ball
), tot AS (
    SELECT match_id,
           p_id,
           SUM(runs_scored + extra_runs) AS partnership_runs
    FROM   tagged
    GROUP BY match_id, p_id
), indiv AS (
    SELECT match_id,
           p_id,
           striker          AS player_id,
           SUM(runs_scored) AS runs
    FROM   tagged
    GROUP BY match_id, p_id, striker
), two_rows AS (
    SELECT  i.*,
            ROW_NUMBER() OVER (PARTITION BY match_id, p_id
                               ORDER BY player_id) AS rn
    FROM    indiv AS i
), partnerships AS (
    SELECT t.match_id,
           t.p_id,
           MAX(CASE WHEN rn = 1 THEN player_id END) AS player_low,
           MAX(CASE WHEN rn = 2 THEN player_id END) AS player_high,
           MAX(CASE WHEN rn = 1 THEN runs END)      AS runs_low,
           MAX(CASE WHEN rn = 2 THEN runs END)      AS runs_high,
           t.partnership_runs
    FROM   tot AS t
    JOIN   two_rows AS tr
           ON tr.match_id = t.match_id AND tr.p_id = t.p_id
    GROUP BY t.match_id, t.p_id, t.partnership_runs
), ranked AS (
    SELECT *,
           RANK() OVER (PARTITION BY match_id
                        ORDER BY partnership_runs DESC) AS rnk
    FROM   partnerships
)
SELECT *
FROM   ranked
WHERE  rnk = 1
LIMIT 20;
