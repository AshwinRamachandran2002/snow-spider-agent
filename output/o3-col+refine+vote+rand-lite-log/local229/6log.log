-- 5.  Create a running counter that jumps by 1 every time the partnership breaks.
--     That counter is the partnership-id inside an innings
SELECT DISTINCT
       x."match_id",
       x."innings_no",
       x."over_id",
       x."ball_id",
       x."striker",
       x."non_striker",
       SUM(x."is_partnership_wicket") OVER
             (PARTITION BY x."match_id", x."innings_no"
              ORDER BY x."over_id", x."ball_id"
              ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "partnership_id"
FROM   (
        SELECT  b.*,
                COALESCE(bs."runs_scored",0) AS "runs_scored",
                COALESCE(er."extra_runs",0)  AS "extra_runs",
                CASE 
                    WHEN wt."player_out" IS NOT NULL
                     AND (wt."player_out" = b."striker"
                       OR wt."player_out" = b."non_striker")
                    THEN 1 ELSE 0 
                END                          AS "is_partnership_wicket"
        FROM   "ball_by_ball"  AS b
        LEFT  JOIN "batsman_scored" AS bs
               ON  b."match_id"  = bs."match_id"
              AND b."over_id"    = bs."over_id"
              AND b."ball_id"    = bs."ball_id"
              AND b."innings_no" = bs."innings_no"
        LEFT  JOIN "extra_runs"   AS er
               ON  b."match_id"  = er."match_id"
              AND b."over_id"    = er."over_id"
              AND b."ball_id"    = er."ball_id"
              AND b."innings_no" = er."innings_no"
        LEFT  JOIN "wicket_taken" AS wt
               ON  b."match_id"  = wt."match_id"
              AND b."over_id"    = wt."over_id"
              AND b."ball_id"    = wt."ball_id"
              AND b."innings_no" = wt."innings_no"
        WHERE  b."match_id" = 335987
       ) AS x
ORDER  BY x."over_id", x."ball_id"
LIMIT  20;
