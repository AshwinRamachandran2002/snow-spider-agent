```sql
-- 3.  Join the two previous tables to see striker / non-striker together 
--     with the runs that go on the striker’s account
SELECT DISTINCT
       b."match_id",
       b."over_id",
       b."ball_id",
       b."striker",
       b."non_striker",
       COALESCE(bs."runs_scored",0) AS "runs_striker"
FROM   "ball_by_ball"  AS b
LEFT  JOIN "batsman_scored" AS bs
       ON  b."match_id"  = bs."match_id"
      AND b."over_id"    = bs."over_id"
      AND b."ball_id"    = bs."ball_id"
      AND b."innings_no" = bs."innings_no"
WHERE  b."match_id" = 335987
ORDER  BY b."over_id", b."ball_id"
LIMIT  20;
```

```sql
-- 4.  Add extras and mark whether a wicket that breaks the partnership fell on the ball
SELECT DISTINCT
       b."match_id",
       b."over_id",
       b."ball_id",
       COALESCE(bs."runs_scored",0)                  AS "runs_striker",
       COALESCE(er."extra_runs",0)                   AS "extra_runs",
       CASE 
           WHEN wt."player_out" IS NOT NULL
            AND (wt."player_out" = b."striker"
              OR wt."player_out" = b."non_striker")
           THEN 1 ELSE 0 
       END                                           AS "is_partnership_wicket"
FROM   "ball_by_ball"  AS b
LEFT  JOIN "batsman_scored" AS bs
       ON  b."match_id"  = bs."match_id"
      AND b."over_id"    = bs."over_id"
      AND b."ball_id"    = bs."ball_id"
      AND b."innings_no" = bs."innings_no"
LEFT  JOIN "extra_runs"   AS er
       ON  b."match_id"  = er."match_id"
      AND b."over_id"    = er."over_id"
      AND b."ball_id"    = er."ball_id"
      AND b."innings_no" = er."innings_no"
LEFT  JOIN "wicket_taken" AS wt
       ON  b."match_id"  = wt."match_id"
      AND b."over_id"    = wt."over_id"
      AND b."ball_id"    = wt."ball_id"
      AND b."innings_no" = wt."innings_no"
WHERE  b."match_id" = 335987
ORDER  BY b."over_id", b."ball_id"
LIMIT  20;
```

```sql
-- 5.  Create a running counter that jumps by 1 every time the partnership breaks.
--     That counter is the partnership-id inside an innings
SELECT DISTINCT
       x."match_id",
       x."innings_no",
       x."over_id",
       x."ball_id",
       x."striker",
       x."non_striker",
       SUM(x."is_partnership_wicket") OVER
             (PARTITION BY x."match_id", x."innings_no"
              ORDER BY x."over_id", x."ball_id"
              ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "partnership_id"
FROM   (
        SELECT  b.*,
                COALESCE(bs."runs_scored",0) AS "runs_scored",
                COALESCE(er."extra_runs",0)  AS "extra_runs",
                CASE 
                    WHEN wt."player_out" IS NOT NULL
                     AND (wt."player_out" = b."striker"
                       OR wt."player_out" = b."non_striker")
                    THEN 1 ELSE 0 
                END                          AS "is_partnership_wicket"
        FROM   "ball_by_ball"  AS b
        LEFT  JOIN "batsman_scored" AS bs
               ON  b."match_id"  = bs."match_id"
              AND b."over_id"    = bs."over_id"
              AND b."ball_id"    = bs."ball_id"
              AND b."innings_no" = bs."innings_no"
        LEFT  JOIN "extra_runs"   AS er
               ON  b."match_id"  = er."match_id"
              AND b."over_id"    = er."over_id"
              AND b."ball_id"    = er."ball_id"
              AND b."innings_no" = er."innings_no"
        LEFT  JOIN "wicket_taken" AS wt
               ON  b."match_id"  = wt."match_id"
              AND b."over_id"    = wt."over_id"
              AND b."ball_id"    = wt."ball_id"
              AND b."innings_no" = wt."innings_no"
        WHERE  b."match_id" = 335987
       ) AS x
ORDER  BY x."over_id", x."ball_id"
LIMIT  20;
```

```sql
-- 6.  Aggregate every partnership to (a) total partnership runs
--     (b) individual runs of each of the two batsmen in that stand
WITH rb AS (
      SELECT  b."match_id",
              b."innings_no",
              b."striker",
              b."non_striker",
              COALESCE(bs."runs_scored",0) AS "runs_scored",
              COALESCE(er."extra_runs",0)  AS "extra_runs",
              CASE 
                   WHEN wt."player_out" IS NOT NULL
                    AND (wt."player_out" = b."striker"
                      OR wt."player_out" = b."non_striker")
                   THEN 1 ELSE 0 
              END                          AS "is_wkt",
              b."over_id",
              b."ball_id"
      FROM  "ball_by_ball" AS b
      LEFT JOIN "batsman_scored" AS bs
        ON  b."match_id"  = bs."match_id"
       AND b."over_id"    = bs."over_id"
       AND b."ball_id"    = bs."ball_id"
       AND b."innings_no" = bs."innings_no"
      LEFT JOIN "extra_runs" AS er
        ON  b."match_id"  = er."match_id"
       AND b."over_id"    = er."over_id"
       AND b."ball_id"    = er."ball_id"
       AND b."innings_no" = er."innings_no"
      LEFT JOIN "wicket_taken" AS wt
        ON  b."match_id"  = wt."match_id"
       AND b."over_id"    = wt."over_id"
       AND b."ball_id"    = wt."ball_id"
       AND b."innings_no" = wt."innings_no"
), rb_tagged AS (
      SELECT rb.*,
             SUM(rb."is_wkt") OVER
                 (PARTITION BY rb."match_id", rb."innings_no"
                  ORDER BY rb."over_id", rb."ball_id"
                  ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "p_id"
      FROM rb
), pship AS (
      SELECT  "match_id",
              "p_id",
              MIN("innings_no")                          AS "innings_no",
              MIN(CASE WHEN "striker" <  "non_striker" THEN "striker"      ELSE "non_striker" END) AS "player_low",
              MIN(CASE WHEN "striker" <  "non_striker" THEN "non_striker"  ELSE "striker"     END) AS "player_high",
              SUM("runs_scored" + "extra_runs")          AS "total_pship",
              SUM(CASE WHEN "striker" = MIN(CASE WHEN "striker" < "non_striker" 
                                                   THEN "non_striker" ELSE "striker" END)
                       THEN "runs_scored" ELSE 0 END)    AS "runs_low",
              SUM(CASE WHEN "striker" = MIN(CASE WHEN "striker" > "non_striker" 
                                                   THEN "striker" ELSE "non_striker" END)
                       THEN "runs_scored" ELSE 0 END)    AS "runs_high"
      FROM   rb_tagged
      GROUP  BY "match_id", "p_id"
)
SELECT DISTINCT *
FROM   pship
LIMIT  20;
```

```sql
-- 7.  Rank partnerships inside every match by their total runs
WITH partnerships AS (   -- (same CTE block from query 6)   ),
ranked AS (
      SELECT  *,
              RANK() OVER (PARTITION BY "match_id"
                           ORDER BY "total_pship" DESC) AS "rnk"
      FROM    partnerships
)
SELECT DISTINCT *
FROM   ranked
WHERE  "rnk" = 1            -- keep only the highest-scoring partnership(s)
LIMIT  20;
```

```sql
-- 8.  Arrange the two batsmen in required order:
--     higher individual score first; if tied, higher player-id first
WITH partnerships AS (   -- (same CTE block from query 6)   ),
ranked AS (
      SELECT  *,
              RANK() OVER (PARTITION BY "match_id"
                           ORDER BY "total_pship" DESC) AS "rnk"
      FROM    partnerships
), ordered AS (
      SELECT  "match_id",
              CASE
                   WHEN "runs_high" > "runs_low" THEN "player_high"
                   WHEN "runs_low"  > "runs_high" THEN "player_low"
                   WHEN "player_high" > "player_low" THEN "player_high"
                   ELSE  "player_low"
              END                                         AS "player1_id",
              CASE
                   WHEN "runs_high" > "runs_low" THEN "player_low"
                   WHEN "runs_low"  > "runs_high" THEN "player_high"
                   WHEN "player_high" > "player_low" THEN "player_low"
                   ELSE  "player_high"
              END                                         AS "player2_id",
              CASE
                   WHEN "runs_high" > "runs_low" THEN "runs_high"
                   WHEN "runs_low"  > "runs_high" THEN "runs_low"
                   ELSE  "runs_high"
              END                                         AS "player1_runs",
              CASE
                   WHEN "runs_high" > "runs_low" THEN "runs_low"
                   WHEN "runs_low"  > "runs_high" THEN "runs_high"
                   ELSE  "runs_low"
              END                                         AS "player2_runs",
              "total_pship"
      FROM   ranked
      WHERE  "rnk" = 1
)
SELECT DISTINCT *
FROM   ordered
LIMIT  20;
```

```sql
-- 9.  The FINAL query – produces the answer for every match, keeping ties
--     (there can be multiple rows for a single match when equal partnership totals)
WITH ball AS (
      SELECT  b.*,
              COALESCE(bs."runs_scored",0) AS "runs_scored",
              COALESCE(er."extra_runs",0)  AS "extra_runs",
              CASE 
                   WHEN wt."player_out" IS NOT NULL
                    AND (wt."player_out" = b."striker"
                      OR wt."player_out" = b."non_striker")
                   THEN 1 ELSE 0 
              END                          AS "is_wkt"
      FROM  "ball_by_ball" AS b
      LEFT JOIN "batsman_scored" AS bs
        ON  b."match_id"  = bs."match_id"
       AND b."over_id"    = bs."over_id"
       AND b."ball_id"    = bs."ball_id"
       AND b."innings_no" = bs."innings_no"
      LEFT JOIN "extra_runs" AS er
        ON  b."match_id"  = er."match_id"
       AND b."over_id"    = er."over_id"
       AND b."ball_id"    = er."ball_id"
       AND b."innings_no" = er."innings_no"
      LEFT JOIN "wicket_taken" AS wt
        ON  b."match_id"  = wt."match_id"
       AND b."over_id"    = wt."over_id"
       AND b."ball_id"    = wt."ball_id"
       AND b."innings_no" = wt."innings_no"
), tagged AS (
      SELECT  *,
              SUM("is_wkt") OVER
                   (PARTITION BY "match_id","innings_no"
                    ORDER BY "over_id","ball_id"
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "p_id"
      FROM    ball
), partnership AS (
      SELECT  "match_id",
              "p_id",
              MIN("innings_no")          AS "innings_no",
              MIN(CASE WHEN "striker" < "non_striker" THEN "striker"     ELSE "non_striker" END) AS "low_id",
              MIN(CASE WHEN "striker" < "non_striker" THEN "non_striker" ELSE "striker"     END) AS "high_id",
              SUM("runs_scored" + "extra_runs") AS "tot_runs",
              SUM(CASE WHEN "striker" = MIN(CASE WHEN "striker" < "non_striker" 
                                                 THEN "non_striker" ELSE "striker" END)
                       THEN "runs_scored" ELSE 0 END)           AS "runs_low",
              SUM(CASE WHEN "striker" = MIN(CASE WHEN "striker" > "non_striker" 
                                                 THEN "striker" ELSE "non_striker" END)
                       THEN "runs_scored" ELSE 0 END)           AS "runs_high"
      FROM    tagged
      GROUP   BY "match_id","p_id"
), ranked AS (
      SELECT *,
             RANK() OVER (PARTITION BY "match_id" 
                          ORDER BY "tot_runs" DESC) AS "rnk"
      FROM   partnership
), ordered AS (
      SELECT  "match_id",
              CASE
                   WHEN "runs_high" > "runs_low"          THEN "high_id"
                   WHEN "runs_low"  > "runs_high"         THEN "low_id"
                   WHEN "high_id"   > "low_id"            THEN "high_id"
                   ELSE "low_id"
              END                                         AS "player1_id",
              CASE
                   WHEN "runs_high" > "runs_low"          THEN "low_id"
                   WHEN "runs_low"  > "runs_high"         THEN "high_id"
                   WHEN "high_id"   > "low_id"            THEN "low_id"
                   ELSE "high_id"
              END                                         AS "player2_id",
              CASE
                   WHEN "runs_high" > "runs_low"          THEN "runs_high"
                   WHEN "runs_low"  > "runs_high"         THEN "runs_low"
                   ELSE "runs_high"
              END                                         AS "player1_runs",
              CASE
                   WHEN "runs_high" > "runs_low"          THEN "runs_low"
                   WHEN "runs_low"  > "runs_high"         THEN "runs_high"
                   ELSE "runs_low"
              END                                         AS "player2_runs",
              "tot_runs"                                  AS "partnership_runs"
      FROM   ranked
      WHERE  "rnk" = 1
)
SELECT DISTINCT 
       "match_id",
       "player1_id" AS "player_1",
       "player1_runs" AS "player_1_runs",
       "player2_id" AS "player_2",
       "player2_runs" AS "player_2_runs",
       "partnership_runs"
FROM   ordered
ORDER  BY "match_id", "player_1", "player_2";
```

