              WHEN runs_high>runs_low THEN runs_low
              WHEN runs_high<runs_low THEN runs_high
              ELSE runs_low
         END AS player2_runs,
         partnership_runs
  FROM partner
),
with_max AS (
  SELECT o.*,
         MAX(partnership_runs) OVER (PARTITION BY match_id) AS max_pr
  FROM   ordered AS o
)
SELECT match_id       AS "match_id",
       player1_id     AS "player1_id",
