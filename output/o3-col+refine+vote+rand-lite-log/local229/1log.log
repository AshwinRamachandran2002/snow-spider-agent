```sql
-- 1. Look at a few deliveries with both batsmen present
SELECT DISTINCT "match_id","over_id","ball_id","striker","non_striker"
FROM "ball_by_ball"
LIMIT 20;
```

```sql
-- 2. Join every delivery with the run actually scored by the striker
SELECT  b.match_id,
        b.over_id,
        b.ball_id,
        b.striker,
        b.non_striker,
        bs.runs_scored
FROM   ball_by_ball  AS b
JOIN   batsman_scored AS bs
       ON bs.match_id  = b.match_id
      AND bs.over_id   = b.over_id
      AND bs.ball_id   = b.ball_id
      AND bs.innings_no= b.innings_no
LIMIT 20;
```

```sql
-- 3. Partnerships (total runs) for one sample match
SELECT  CASE WHEN b.striker>b.non_striker THEN b.striker ELSE b.non_striker END AS player_high,
        CASE WHEN b.striker>b.non_striker THEN b.non_striker ELSE b.striker END AS player_low,
        SUM(bs.runs_scored) AS partnership_runs
FROM   ball_by_ball AS b
JOIN   batsman_scored AS bs
       ON bs.match_id=b.match_id
      AND bs.over_id =b.over_id
      AND bs.ball_id=b.ball_id
      AND bs.innings_no=b.innings_no
WHERE  b.match_id = 335987
GROUP  BY player_high,player_low
ORDER  BY partnership_runs DESC
LIMIT 20;
```

```sql
-- 4. In the same match, split the partnership-runs between the two players
SELECT  CASE WHEN b.striker>b.non_striker THEN b.striker ELSE b.non_striker END AS player_high,
        CASE WHEN b.striker>b.non_striker THEN b.non_striker ELSE b.striker END AS player_low,
        SUM(CASE WHEN b.striker>b.non_striker THEN bs.runs_scored ELSE 0 END) AS runs_high,
        SUM(CASE WHEN b.striker<b.non_striker THEN bs.runs_scored ELSE 0 END) AS runs_low,
        SUM(bs.runs_scored) AS partnership_runs
FROM   ball_by_ball AS b
JOIN   batsman_scored AS bs
       ON bs.match_id=b.match_id
      AND bs.over_id =b.over_id
      AND bs.ball_id=b.ball_id
      AND bs.innings_no=b.innings_no
WHERE  b.match_id = 335987
GROUP  BY player_high,player_low
ORDER  BY partnership_runs DESC
LIMIT 20;
```

```sql
-- 5. Partnership-runs (total) for every pair in every match
WITH ball_runs AS (
  SELECT b.match_id,
         b.striker,
         b.non_striker,
         bs.runs_scored
  FROM   ball_by_ball  AS b
  JOIN   batsman_scored AS bs
         ON bs.match_id=b.match_id
        AND bs.over_id =b.over_id
        AND bs.ball_id=b.ball_id
        AND bs.innings_no=b.innings_no
)
SELECT match_id,
       CASE WHEN striker>non_striker THEN striker ELSE non_striker END AS player_high,
       CASE WHEN striker>non_striker THEN non_striker ELSE striker END AS player_low,
       SUM(runs_scored) AS partnership_runs
FROM   ball_runs
GROUP  BY match_id,player_high,player_low
LIMIT 20;
```

```sql
-- 6. Same CTE, but keep each player’s own contribution inside the pair
WITH ball_runs AS (
  SELECT b.match_id,
         b.striker,
         b.non_striker,
         bs.runs_scored
  FROM   ball_by_ball  AS b
  JOIN   batsman_scored AS bs
         ON bs.match_id=b.match_id
        AND bs.over_id =b.over_id
        AND bs.ball_id=b.ball_id
        AND bs.innings_no=b.innings_no
)
SELECT match_id,
       CASE WHEN striker>non_striker THEN striker ELSE non_striker END AS player_high,
       CASE WHEN striker>non_striker THEN non_striker ELSE striker END AS player_low,
       SUM(CASE WHEN striker>non_striker THEN runs_scored ELSE 0 END) AS runs_high,
       SUM(CASE WHEN striker<non_striker THEN runs_scored ELSE 0 END) AS runs_low,
       SUM(runs_scored) AS partnership_runs
FROM   ball_runs
GROUP  BY match_id,player_high,player_low
LIMIT 20;
```

```sql
-- 7. Arrange each pair as player1/player2 per rules (higher runs, then higher id)
WITH ball_runs AS (
  SELECT b.match_id,
         b.striker,
         b.non_striker,
         bs.runs_scored
  FROM   ball_by_ball  AS b
  JOIN   batsman_scored AS bs
         ON bs.match_id=b.match_id
        AND bs.over_id =b.over_id
        AND bs.ball_id=b.ball_id
        AND bs.innings_no=b.innings_no
),
partner AS (
  SELECT match_id,
         CASE WHEN striker>non_striker THEN striker ELSE non_striker END AS p_high,
         CASE WHEN striker>non_striker THEN non_striker ELSE striker END AS p_low,
         SUM(CASE WHEN striker>non_striker THEN runs_scored ELSE 0 END) AS runs_high,
         SUM(CASE WHEN striker<non_striker THEN runs_scored ELSE 0 END) AS runs_low,
         SUM(runs_scored) AS partnership_runs
  FROM   ball_runs
  GROUP  BY match_id,p_high,p_low
)
SELECT match_id,
       CASE 
            WHEN runs_high>runs_low              THEN p_high
            WHEN runs_high<runs_low              THEN p_low
            WHEN runs_high=runs_low AND p_high>p_low THEN p_high
            ELSE p_low
       END AS player1_id,
       CASE 
            WHEN runs_high>runs_low              THEN p_low
            WHEN runs_high<runs_low              THEN p_high
            WHEN runs_high=runs_low AND p_high>p_low THEN p_low
            ELSE p_high
       END AS player2_id,
       CASE 
            WHEN runs_high>runs_low THEN runs_high
            WHEN runs_high<runs_low THEN runs_low
            ELSE runs_high
       END AS player1_runs,
       CASE 
            WHEN runs_high>runs_low THEN runs_low
            WHEN runs_high<runs_low THEN runs_high
            ELSE runs_low
       END AS player2_runs,
       partnership_runs
FROM partner
LIMIT 20;
```

```sql
-- 8. Rank partnerships within each match on total runs
WITH ball_runs AS (
  SELECT b.match_id,
         b.striker,
         b.non_striker,
         bs.runs_scored
  FROM   ball_by_ball  AS b
  JOIN   batsman_scored AS bs
         ON bs.match_id=b.match_id
        AND bs.over_id =b.over_id
        AND bs.ball_id=b.ball_id
        AND bs.innings_no=b.innings_no
),
partner AS (
  SELECT match_id,
         CASE WHEN striker>non_striker THEN striker ELSE non_striker END AS p_high,
         CASE WHEN striker>non_striker THEN non_striker ELSE striker END AS p_low,
         SUM(CASE WHEN striker>non_striker THEN runs_scored ELSE 0 END) AS runs_high,
         SUM(CASE WHEN striker<non_striker THEN runs_scored ELSE 0 END) AS runs_low,
         SUM(runs_scored) AS partnership_runs
  FROM   ball_runs
  GROUP  BY match_id,p_high,p_low
),
ordered AS (
  SELECT match_id,
         CASE 
              WHEN runs_high>runs_low              THEN p_high
              WHEN runs_high<runs_low              THEN p_low
              WHEN runs_high=runs_low AND p_high>p_low THEN p_high
              ELSE p_low
         END AS player1_id,
         CASE 
              WHEN runs_high>runs_low              THEN p_low
              WHEN runs_high<runs_low              THEN p_high
              WHEN runs_high=runs_low AND p_high>p_low THEN p_low
              ELSE p_high
         END AS player2_id,
         CASE 
              WHEN runs_high>runs_low THEN runs_high
              WHEN runs_high<runs_low THEN runs_low
              ELSE runs_high
         END AS player1_runs,
         CASE 
              WHEN runs_high>runs_low THEN runs_low
              WHEN runs_high<runs_low THEN runs_high
              ELSE runs_low
         END AS player2_runs,
         partnership_runs
  FROM partner
),
ranked AS (
  SELECT o.*,
         MAX(partnership_runs) OVER (PARTITION BY match_id) AS max_partner_run
  FROM   ordered AS o
)
SELECT match_id,
       player1_id,
       player1_runs,
       player2_id,
       player2_runs,
       partnership_runs
FROM   ranked
WHERE  partnership_runs = max_partner_run
LIMIT 20;
```

```sql
-- 9. FINAL ANSWER: every match’s highest partnership with required ordering
WITH ball_runs AS (
  SELECT b.match_id,
         b.striker,
         b.non_striker,
         bs.runs_scored
  FROM   ball_by_ball  AS b
  JOIN   batsman_scored AS bs
         ON bs.match_id=b.match_id
        AND bs.over_id =b.over_id
        AND bs.ball_id=b.ball_id
        AND bs.innings_no=b.innings_no
),
partner AS (
  SELECT match_id,
         CASE WHEN striker>non_striker THEN striker ELSE non_striker END AS p_high,
         CASE WHEN striker>non_striker THEN non_striker ELSE striker END AS p_low,
         SUM(CASE WHEN striker>non_striker THEN runs_scored ELSE 0 END) AS runs_high,
         SUM(CASE WHEN striker<non_striker THEN runs_scored ELSE 0 END) AS runs_low,
         SUM(runs_scored) AS partnership_runs
  FROM   ball_runs
  GROUP  BY match_id,p_high,p_low
),
ordered AS (
  SELECT match_id,
         CASE 
              WHEN runs_high>runs_low              THEN p_high
              WHEN runs_high<runs_low              THEN p_low
              WHEN runs_high=runs_low AND p_high>p_low THEN p_high
              ELSE p_low
         END AS player1_id,
         CASE 
              WHEN runs_high>runs_low              THEN p_low
              WHEN runs_high<runs_low              THEN p_high
              WHEN runs_high=runs_low AND p_high>p_low THEN p_low
              ELSE p_high
         END AS player2_id,
         CASE 
              WHEN runs_high>runs_low THEN runs_high
              WHEN runs_high<runs_low THEN runs_low
              ELSE runs_high
         END AS player1_runs,
         CASE 
              WHEN runs_high>runs_low THEN runs_low
              WHEN runs_high<runs_low THEN runs_high
              ELSE runs_low
         END AS player2_runs,
         partnership_runs
  FROM partner
),
with_max AS (
  SELECT o.*,
         MAX(partnership_runs) OVER (PARTITION BY match_id) AS max_pr
  FROM   ordered AS o
)
SELECT match_id       AS "match_id",
       player1_id     AS "player1_id",
       player1_runs   AS "player1_runs",
       player2_id     AS "player2_id",
       player2_runs   AS "player2_runs",
       partnership_runs AS "partnership_runs"
FROM   with_max
WHERE  partnership_runs = max_pr
ORDER  BY match_id, player1_id DESC, player2_id DESC;
```
