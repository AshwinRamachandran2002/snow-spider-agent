-- 3. Partnerships (total runs) for one sample match
SELECT  CASE WHEN b.striker>b.non_striker THEN b.striker ELSE b.non_striker END AS player_high,
        CASE WHEN b.striker>b.non_striker THEN b.non_striker ELSE b.striker END AS player_low,
        SUM(bs.runs_scored) AS partnership_runs
FROM   ball_by_ball AS b
JOIN   batsman_scored AS bs
       ON bs.match_id=b.match_id
      AND bs.over_id =b.over_id
      AND bs.ball_id=b.ball_id
      AND bs.innings_no=b.innings_no
WHERE  b.match_id = 335987
GROUP  BY player_high,player_low
ORDER  BY partnership_runs DESC
LIMIT 20;
