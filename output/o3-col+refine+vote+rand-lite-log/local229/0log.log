-- 6. Aggregate partnership runs for every unordered pair of batsmen
--    within the same match & innings (player1 > player2 by ID to fix order).
SELECT   b."match_id",
         b."innings_no",
         CASE WHEN b."striker" > b."non_striker" THEN b."striker"
              ELSE b."non_striker" END AS "player_high_id",
         CASE WHEN b."striker" > b."non_striker" THEN b."non_striker"
              ELSE b."striker" END AS "player_low_id",
         SUM(s."runs_scored") AS "partnership_runs"
FROM     "ball_by_ball" AS b
JOIN     "batsman_scored" AS s
       ON b."match_id" = s."match_id"
      AND b."over_id"  = s."over_id"
      AND b."ball_id"  = s."ball_id"
      AND b."innings_no" = s."innings_no"
GROUP BY b."match_id",
         b."innings_no",
         "player_high_id",
         "player_low_id"
LIMIT 20;
