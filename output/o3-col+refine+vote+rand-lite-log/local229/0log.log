-- 9. For those top partnerships, also bring in the individual runs
--    each batsman made in that match to decide player1 / player2 order later.
WITH indiv AS (
      SELECT   b."match_id",
               b."striker" AS "player_id",
               SUM(s."runs_scored") AS "runs"
      FROM   "ball_by_ball" AS b
      JOIN   "batsman_scored" AS s
         ON  b."match_id" = s."match_id"
        AND b."over_id"  = s."over_id"
        AND b."ball_id"  = s."ball_id"
        AND b."innings_no" = s."innings_no"
      GROUP BY b."match_id", "player_id"
),
top_pair AS (
      /* reuse query 8 without LIMIT */
      WITH partnership AS (
            SELECT   b."match_id",
                     CASE WHEN b."striker" > b."non_striker" THEN b."striker"
                          ELSE b."non_striker" END AS "p1",
                     CASE WHEN b."striker" > b."non_striker" THEN b."non_striker"
                          ELSE b."striker" END AS "p2",
                     SUM(s."runs_scored") AS "partnership_runs"
            FROM   "ball_by_ball" AS b
            JOIN   "batsman_scored" AS s
               ON  b."match_id" = s."match_id"
              AND b."over_id"  = s."over_id"
              AND b."ball_id"  = s."ball_id"
              AND b."innings_no" = s."innings_no"
            GROUP BY b."match_id", "p1", "p2"
      ),
      max_partnership AS (
            SELECT "match_id",
                   MAX("partnership_runs") AS "max_runs"
            FROM   partnership
            GROUP BY "match_id"
      )
      SELECT pr."match_id",
             pr."p1",
             pr."p2",
             pr."partnership_runs"
      FROM   partnership  AS pr
      JOIN   max_partnership AS mp
        ON   pr."match_id" = mp."match_id"
       AND   pr."partnership_runs" = mp."max_runs"
)
SELECT tp."match_id",
       tp."p1",
       i1."runs" AS "runs_p1",
       tp."p2",
       i2."runs" AS "runs_p2",
       tp."partnership_runs"
FROM   top_pair AS tp
JOIN   indiv    AS i1 ON tp."match_id" = i1."match_id" AND tp."p1" = i1."player_id"
JOIN   indiv    AS i2 ON tp."match_id" = i2."match_id" AND tp."p2" = i2."player_id"
LIMIT 20;
