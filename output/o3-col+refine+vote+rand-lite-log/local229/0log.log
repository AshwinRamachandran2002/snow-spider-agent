2025-05-05 04:48:32 - Thread-3945 (execute) - INFO - [Exploration]
Below are 10 exploratory SQL queries (each limited to 20 rows) that progressively examine the information needed to identify the highest-run partnerships in every match.

```sql
-- 1. List some players and their IDs from the master "player" table.
SELECT DISTINCT "player_id",
                "player_name"
FROM   "player"
LIMIT  20;
```

```sql
-- 2. Show a sample of players who actually appeared in matches
--    (from the player_match table) together with their team.
SELECT DISTINCT "player_id",
                "team_id"
FROM   "player_match"
LIMIT  20;
```

```sql
-- 3. Inspect a few deliveries to see striker / non-striker / bowler IDs.
SELECT DISTINCT "match_id",
                "over_id",
                "ball_id",
                "innings_no",
                "striker",
                "non_striker",
                "bowler"
FROM   "ball_by_ball"
LIMIT  20;
```

```sql
-- 4. Join “ball_by_ball” with “batsman_scored” to view runs scored
--    by the striker on each ball.
SELECT DISTINCT b."match_id",
                b."over_id",
                b."ball_id",
                b."innings_no",
                b."striker",
                s."runs_scored"
FROM   "ball_by_ball" AS b
JOIN   "batsman_scored" AS s
       ON  b."match_id" = s."match_id"
       AND b."over_id"  = s."over_id"
       AND b."ball_id"  = s."ball_id"
       AND b."innings_no" = s."innings_no"
LIMIT  20;
```

```sql
-- 5. Compute each batsman’s total runs in an innings of one match
--    (grouping by match, innings, and player).
SELECT   b."match_id",
         b."innings_no",
         b."striker"  AS "player_id",
         SUM(s."runs_scored") AS "total_runs"
FROM     "ball_by_ball" AS b
JOIN     "batsman_scored" AS s
       ON b."match_id" = s."match_id"
      AND b."over_id"  = s."over_id"
      AND b."ball_id"  = s."ball_id"
      AND b."innings_no" = s."innings_no"
GROUP BY b."match_id",
         b."innings_no",
         b."striker"
LIMIT 20;
```

```sql
-- 6. Aggregate partnership runs for every unordered pair of batsmen
--    within the same match & innings (player1 > player2 by ID to fix order).
SELECT   b."match_id",
         b."innings_no",
         CASE WHEN b."striker" > b."non_striker" THEN b."striker"
              ELSE b."non_striker" END AS "player_high_id",
         CASE WHEN b."striker" > b."non_striker" THEN b."non_striker"
              ELSE b."striker" END AS "player_low_id",
         SUM(s."runs_scored") AS "partnership_runs"
FROM     "ball_by_ball" AS b
JOIN     "batsman_scored" AS s
       ON b."match_id" = s."match_id"
      AND b."over_id"  = s."over_id"
      AND b."ball_id"  = s."ball_id"
      AND b."innings_no" = s."innings_no"
GROUP BY b."match_id",
         b."innings_no",
         "player_high_id",
         "player_low_id"
LIMIT 20;
```

```sql
-- 7. Within each match, find the maximum partnership runs value.
--    (We’ll use it later to filter the partnerships we want.)
SELECT   p."match_id",
         MAX(p."partnership_runs") AS "max_partnership_runs"
FROM   (
        /* reuse query 6 as a sub-query without LIMIT */
        SELECT   b."match_id",
                 b."innings_no",
                 CASE WHEN b."striker" > b."non_striker" THEN b."striker"
                      ELSE b."non_striker" END AS "p1",
                 CASE WHEN b."striker" > b."non_striker" THEN b."non_striker"
                      ELSE b."striker" END AS "p2",
                 SUM(s."runs_scored") AS "partnership_runs"
        FROM     "ball_by_ball" AS b
        JOIN     "batsman_scored" AS s
               ON b."match_id" = s."match_id"
              AND b."over_id"  = s."over_id"
              AND b."ball_id"  = s."ball_id"
              AND b."innings_no" = s."innings_no"
        GROUP BY b."match_id",
                 b."innings_no",
                 "p1",
                 "p2"
      ) AS p
GROUP BY p."match_id"
LIMIT 20;
```

```sql
-- 8. Select the partnerships that match the maximum runs per match
--    (highest partnership(s) for each match).
WITH partnership AS (
      SELECT   b."match_id",
               CASE WHEN b."striker" > b."non_striker" THEN b."striker"
                    ELSE b."non_striker" END AS "p1",
               CASE WHEN b."striker" > b."non_striker" THEN b."non_striker"
                    ELSE b."striker" END AS "p2",
               SUM(s."runs_scored") AS "partnership_runs"
      FROM   "ball_by_ball" AS b
      JOIN   "batsman_scored" AS s
         ON  b."match_id" = s."match_id"
        AND b."over_id"  = s."over_id"
        AND b."ball_id"  = s."ball_id"
        AND b."innings_no" = s."innings_no"
      GROUP BY b."match_id", "p1", "p2"
),
max_partnership AS (
      SELECT "match_id",
             MAX("partnership_runs") AS "max_runs"
      FROM   partnership
      GROUP BY "match_id"
)
SELECT DISTINCT pr."match_id",
                pr."p1",
                pr."p2",
                pr."partnership_runs"
FROM   partnership  AS pr
JOIN   max_partnership AS mp
  ON   pr."match_id"      = mp."match_id"
 AND   pr."partnership_runs" = mp."max_runs"
LIMIT 20;
```

```sql
-- 9. For those top partnerships, also bring in the individual runs
--    each batsman made in that match to decide player1 / player2 order later.
WITH indiv AS (
      SELECT   b."match_id",
               b."striker" AS "player_id",
               SUM(s."runs_scored") AS "runs"
      FROM   "ball_by_ball" AS b
      JOIN   "batsman_scored" AS s
         ON  b."match_id" = s."match_id"
        AND b."over_id"  = s."over_id"
        AND b."ball_id"  = s."ball_id"
        AND b."innings_no" = s."innings_no"
      GROUP BY b."match_id", "player_id"
),
top_pair AS (
      /* reuse query 8 without LIMIT */
      WITH partnership AS (
            SELECT   b."match_id",
                     CASE WHEN b."striker" > b."non_striker" THEN b."striker"
                          ELSE b."non_striker" END AS "p1",
                     CASE WHEN b."striker" > b."non_striker" THEN b."non_striker"
                          ELSE b."striker" END AS "p2",
                     SUM(s."runs_scored") AS "partnership_runs"
            FROM   "ball_by_ball" AS b
            JOIN   "batsman_scored" AS s
               ON  b."match_id" = s."match_id"
              AND b."over_id"  = s."over_id"
              AND b."ball_id"  = s."ball_id"
              AND b."innings_no" = s."innings_no"
            GROUP BY b."match_id", "p1", "p2"
      ),
      max_partnership AS (
            SELECT "match_id",
                   MAX("partnership_runs") AS "max_runs"
            FROM   partnership
            GROUP BY "match_id"
      )
      SELECT pr."match_id",
             pr."p1",
             pr."p2",
             pr."partnership_runs"
      FROM   partnership  AS pr
      JOIN   max_partnership AS mp
        ON   pr."match_id" = mp."match_id"
       AND   pr."partnership_runs" = mp."max_runs"
)
SELECT tp."match_id",
       tp."p1",
       i1."runs" AS "runs_p1",
       tp."p2",
       i2."runs" AS "runs_p2",
       tp."partnership_runs"
FROM   top_pair AS tp
JOIN   indiv    AS i1 ON tp."match_id" = i1."match_id" AND tp."p1" = i1."player_id"
JOIN   indiv    AS i2 ON tp."match_id" = i2."match_id" AND tp."p2" = i2."player_id"
LIMIT 20;
```

```sql
-- 10. Final ordering per the requirement:
--     player_1 = the one with higher individual score,
--     or (if equal) the higher ID.
WITH indiv AS (
      SELECT   b."match_id",
               b."striker" AS "player_id",
               SUM(s."runs_scored") AS "runs"
      FROM   "ball_by_ball" AS b
      JOIN   "batsman_scored" AS s
         ON  b."match_id" = s."match_id"
        AND b."over_id"  = s."over_id"
        AND b."ball_id"  = s."ball_id"
        AND b."innings_no" = s."innings_no"
      GROUP BY b."match_id", "player_id"
),
top_pair AS (
      /* identical to query 8 without LIMIT */
      WITH partnership AS (
            SELECT   b."match_id",
                     CASE WHEN b."striker" > b."non_striker" THEN b."striker"
                          ELSE b."non_striker" END AS "p1",
                     CASE WHEN b."striker" > b."non_striker" THEN b."non_striker"
                          ELSE b."striker" END AS "p2",
                     SUM(s."runs_scored") AS "partnership_runs"
            FROM   "ball_by_ball" AS b
            JOIN   "batsman_scored" AS s
               ON  b."match_id" = s."match_id"
              AND b."over_id"  = s."over_id"
              AND b."ball_id"  = s."ball_id"
              AND b."innings_no" = s."innings_no"
            GROUP BY b."match_id", "p1", "p2"
      ),
      max_partnership AS (
            SELECT "match_id",
                   MAX("partnership_runs") AS "max_runs"
            FROM   partnership
            GROUP BY "match_id"
      )
      SELECT pr."match_id",
             pr."p1" AS "bat1",
             pr."p2" AS "bat2",
             pr."partnership_runs"
      FROM   partnership  AS pr
      JOIN   max_partnership AS mp
        ON   pr."match_id" = mp."match_id"
       AND   pr."partnership_runs" = mp."max_runs"
)
SELECT tp."match_id",
       CASE 
            WHEN i1."runs" > i2."runs" THEN tp."bat1"
            WHEN i1."runs" < i2."runs" THEN tp."bat2"
            WHEN i1."runs" = i2."runs" AND tp."bat1" > tp."bat2" THEN tp."bat1"
            ELSE tp."bat2"
       END AS "player1_id",
       CASE 
            WHEN i1."runs" > i2."runs" THEN i1."runs"
            WHEN i1."runs" < i2."runs" THEN i2."runs"
            WHEN i1."runs" = i2."runs" AND tp."bat1" > tp."bat2" THEN i1."runs"
            ELSE i2."runs"
       END AS "player1_runs",
       CASE 
            WHEN i1."runs" > i2."runs" THEN tp."bat2"
            WHEN i1."runs" < i2."runs" THEN tp."bat1"
            WHEN i1."runs" = i2."runs" AND tp."bat1" > tp."bat2" THEN tp."bat2"
            ELSE tp."bat1"
       END AS "player2_id",
       CASE 
            WHEN i1."runs" > i2."runs" THEN i2."runs"
            WHEN i1."runs" < i2."runs" THEN i1."runs"
            WHEN i1."runs" = i2."runs" AND tp."bat1" > tp."bat2" THEN i2."runs"
            ELSE i1."runs"
       END AS "player2_runs",
       tp."partnership_runs"
FROM   top_pair AS tp
JOIN   indiv     AS i1 ON tp."match_id" = i1."match_id" AND tp."bat1" = i1."player_id"
JOIN   indiv     AS i2 ON tp."match_id" = i2."match_id" AND tp."bat2" = i2."player_id"
LIMIT 20;
```

These queries move from simple inspection of players and deliveries to building partnership totals and finally ordering the two batsmen in each record exactly as the task requires.
