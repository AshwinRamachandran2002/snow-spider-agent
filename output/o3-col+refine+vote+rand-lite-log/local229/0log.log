-- 7. Within each match, find the maximum partnership runs value.
--    (We’ll use it later to filter the partnerships we want.)
SELECT   p."match_id",
         MAX(p."partnership_runs") AS "max_partnership_runs"
FROM   (
        /* reuse query 6 as a sub-query without LIMIT */
        SELECT   b."match_id",
                 b."innings_no",
                 CASE WHEN b."striker" > b."non_striker" THEN b."striker"
                      ELSE b."non_striker" END AS "p1",
                 CASE WHEN b."striker" > b."non_striker" THEN b."non_striker"
                      ELSE b."striker" END AS "p2",
                 SUM(s."runs_scored") AS "partnership_runs"
        FROM     "ball_by_ball" AS b
        JOIN     "batsman_scored" AS s
               ON b."match_id" = s."match_id"
              AND b."over_id"  = s."over_id"
              AND b."ball_id"  = s."ball_id"
              AND b."innings_no" = s."innings_no"
        GROUP BY b."match_id",
                 b."innings_no",
                 "p1",
                 "p2"
      ) AS p
GROUP BY p."match_id"
LIMIT 20;
