LIMIT 20;
```

```sql
--Description: Connect orders, items, payments & categories – show one row per (order, category, payment_type) to inspect.
SELECT op.order_id,
       pt.product_category_name_english AS category_en,
       op.payment_type,
       op.payment_value
FROM olist_order_payments               AS op
JOIN olist_order_items                  AS oi  ON oi.order_id = op.order_id
JOIN olist_products                     AS p   ON p.product_id = oi.product_id
JOIN product_category_name_translation  AS pt  ON pt.product_category_name = p.product_category_name
LIMIT 20;
```

```sql
--Description: Count number of payments per (category, payment_type).
SELECT pt.product_category_name_english AS category_en,
       op.payment_type,
       COUNT(*) AS n_payments
FROM olist_order_payments              AS op
JOIN olist_order_items                 AS oi  ON oi.order_id = op.order_id
JOIN olist_products                    AS p   ON p.product_id = oi.product_id
JOIN product_category_name_translation AS pt  ON pt.product_category_name = p.product_category_name
GROUP BY category_en, op.payment_type
ORDER BY n_payments DESC
LIMIT 20;
```

```sql
--Description: For every category, keep only the payment_type with the most payments (ties kept), then rank them.
WITH category_payments AS (
    SELECT pt.product_category_name_english AS category_en,
           op.payment_type,
           COUNT(*)               AS n_payments,
           RANK() OVER (PARTITION BY pt.product_category_name_english
                        ORDER BY COUNT(*) DESC) AS rnk
    FROM olist_order_payments              AS op
    JOIN olist_order_items                 AS oi  ON oi.order_id = op.order_id
    JOIN olist_products                    AS p   ON p.product_id = oi.product_id
    JOIN product_category_name_translation AS pt  ON pt.product_category_name = p.product_category_name
    GROUP BY category_en, op.payment_type
)
SELECT category_en,
       payment_type,
       n_payments
FROM category_payments
WHERE rnk = 1
ORDER BY n_payments DESC
LIMIT 20;
```

```sql
--Description: From previous CTE keep only the global Top-3 categories whose dominant payment_type has the highest payment counts.
WITH category_payments AS (
    SELECT pt.product_category_name_english AS category_en,
           op.payment_type,
           COUNT(*)               AS n_payments,
           RANK() OVER (PARTITION BY pt.product_category_name_english
                        ORDER BY COUNT(*) DESC) AS rnk
    FROM olist_order_payments              AS op
    JOIN olist_order_items                 AS oi  ON oi.order_id = op.order_id
    JOIN olist_products                    AS p   ON p.product_id = oi.product_id
    JOIN product_category_name_translation AS pt  ON pt.product_category_name = p.product_category_name
    GROUP BY category_en, op.payment_type
)
SELECT category_en          AS top_category,
       payment_type         AS dominant_payment_type,
       n_payments
FROM category_payments
WHERE rnk = 1
ORDER BY n_payments DESC
LIMIT 3;
```

