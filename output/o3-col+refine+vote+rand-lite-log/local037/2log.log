```sql
--Description: Preview how order items connect to their product categories.
SELECT oi."order_id",
       oi."product_id",
       p."product_category_name"
FROM "olist_order_items" AS oi
JOIN "olist_products" AS p
  ON p."product_id" = oi."product_id"
LIMIT 20;
```

```sql
--Description: Inspect how a payment row ties to a product category through an order.
SELECT op."order_id",
       op."payment_type",
       p."product_category_name"
FROM "olist_order_payments" AS op
JOIN "olist_order_items"  AS oi ON oi."order_id" = op."order_id"
JOIN "olist_products"     AS p  ON p."product_id" = oi."product_id"
LIMIT 20;
```

```sql
--Description: Count payments made for every (category, payment_type) pair.
SELECT p."product_category_name",
       op."payment_type",
       COUNT(*) AS "payments_count"
FROM "olist_order_payments" AS op
JOIN "olist_order_items"    AS oi ON oi."order_id" = op."order_id"
JOIN "olist_products"       AS p  ON p."product_id" = oi."product_id"
GROUP BY p."product_category_name", op."payment_type"
ORDER BY "payments_count" DESC
LIMIT 20;
```

```sql
--Description: Rank payment types inside each category by their payment count.
SELECT product_category_name,
       payment_type,
       payments_count,
       ROW_NUMBER() OVER (PARTITION BY product_category_name
                          ORDER BY payments_count DESC) AS rn
FROM (
    SELECT p."product_category_name"          AS product_category_name,
           op."payment_type"                  AS payment_type,
           COUNT(*)                           AS payments_count
    FROM "olist_order_payments" AS op
    JOIN "olist_order_items"    AS oi ON oi."order_id" = op."order_id"
    JOIN "olist_products"       AS p  ON p."product_id" = oi."product_id"
    GROUP BY p."product_category_name", op."payment_type"
) sub
LIMIT 20;
```

```sql
--Description: Keep only the most–used payment type for every category.
SELECT product_category_name,
       payment_type,
       payments_count
FROM (
    SELECT product_category_name,
           payment_type,
           payments_count,
           ROW_NUMBER() OVER (PARTITION BY product_category_name
                              ORDER BY payments_count DESC) AS rn
    FROM (
        SELECT p."product_category_name"          AS product_category_name,
               op."payment_type"                  AS payment_type,
               COUNT(*)                           AS payments_count
        FROM "olist_order_payments" AS op
        JOIN "olist_order_items"    AS oi ON oi."order_id" = op."order_id"
        JOIN "olist_products"       AS p  ON p."product_id" = oi."product_id"
        GROUP BY p."product_category_name", op."payment_type"
    )
)
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: Final answer – top-3 categories whose leading payment type has the most payments overall.
SELECT product_category_name,
       payment_type,
       payments_count
FROM (
    SELECT product_category_name,
           payment_type,
           payments_count,
           ROW_NUMBER() OVER (PARTITION BY product_category_name
                              ORDER BY payments_count DESC) AS rn
    FROM (
        SELECT p."product_category_name"          AS product_category_name,
               op."payment_type"                  AS payment_type,
               COUNT(*)                           AS payments_count
        FROM "olist_order_payments" AS op
        JOIN "olist_order_items"    AS oi ON oi."order_id" = op."order_id"
        JOIN "olist_products"       AS p  ON p."product_id" = oi."product_id"
        GROUP BY p."product_category_name", op."payment_type"
    )
)
WHERE rn = 1
ORDER BY payments_count DESC
LIMIT 3;
```

