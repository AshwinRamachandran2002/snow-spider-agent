Query:
--Description: Rank payment types inside each category by their payment count.
SELECT product_category_name,
       payment_type,
       payments_count,
       ROW_NUMBER() OVER (PARTITION BY product_category_name
                          ORDER BY payments_count DESC) AS rn
FROM (
    SELECT p."product_category_name"          AS product_category_name,
           op."payment_type"                  AS payment_type,
           COUNT(*)                           AS payments_count
    FROM "olist_order_payments" AS op
    JOIN "olist_order_items"    AS oi ON oi."order_id" = op."order_id"
    JOIN "olist_products"       AS p  ON p."product_id" = oi."product_id"
    GROUP BY p."product_category_name", op."payment_type"
) sub
LIMIT 20;
