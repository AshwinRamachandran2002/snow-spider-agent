```sql
-- 3. Look at how payments, order-items and product categories are related
SELECT oi.order_id,
       oi.product_id,
       p.product_category_name,
       op.payment_type
FROM olist_order_items  AS oi
JOIN olist_products     AS p  ON p.product_id = oi.product_id
JOIN olist_order_payments AS op ON op.order_id = oi.order_id
LIMIT 20;
```

```sql
-- 4. Count, for every (category, payment_type) pair, how many payments occur
SELECT p.product_category_name,
       op.payment_type,
       COUNT(*) AS payment_count
FROM olist_order_items      AS oi
JOIN olist_products         AS p  ON p.product_id = oi.product_id
JOIN olist_order_payments   AS op ON op.order_id   = oi.order_id
GROUP BY p.product_category_name,
         op.payment_type
ORDER BY payment_count DESC
LIMIT 20;
```

```sql
-- 5. For every category keep ONLY the payment type that is used the most
SELECT product_category_name,
       payment_type,
       payment_count
FROM (
        SELECT p.product_category_name                  AS product_category_name,
               op.payment_type                          AS payment_type,
               COUNT(*)                                 AS payment_count,
               ROW_NUMBER() OVER (PARTITION BY p.product_category_name
                                   ORDER BY COUNT(*) DESC) AS rn
        FROM olist_order_items    AS oi
        JOIN olist_products       AS p  ON p.product_id = oi.product_id
        JOIN olist_order_payments AS op ON op.order_id   = oi.order_id
        GROUP BY p.product_category_name,
                 op.payment_type
     )
WHERE rn = 1
ORDER BY payment_count DESC
LIMIT 20;
```

```sql
-- 6. Pick the TOP-3 categories whose dominant payment type has the largest counts
SELECT product_category_name,
       payment_type,
       payment_count
FROM (
        SELECT p.product_category_name                  AS product_category_name,
               op.payment_type                          AS payment_type,
               COUNT(*)                                 AS payment_count,
               ROW_NUMBER() OVER (PARTITION BY p.product_category_name
                                   ORDER BY COUNT(*) DESC) AS rn
        FROM olist_order_items    AS oi
        JOIN olist_products       AS p  ON p.product_id = oi.product_id
        JOIN olist_order_payments AS op ON op.order_id   = oi.order_id
        GROUP BY p.product_category_name,
                 op.payment_type
     )
WHERE rn = 1
ORDER BY payment_count DESC
LIMIT 3;
```

```sql
-- 7. Same TOP-3 list, but with the English translation of the category names
SELECT COALESCE(t.product_category_name_english, sub.category_pt) AS category_english,
       sub.payment_type,
       sub.payment_count
FROM (
        SELECT p.product_category_name  AS category_pt,
               op.payment_type          AS payment_type,
               COUNT(*)                 AS payment_count,
               ROW_NUMBER() OVER (PARTITION BY p.product_category_name
                                   ORDER BY COUNT(*) DESC) AS rn
        FROM olist_order_items    AS oi
        JOIN olist_products       AS p  ON p.product_id = oi.product_id
        JOIN olist_order_payments AS op ON op.order_id   = oi.order_id
        GROUP BY p.product_category_name,
                 op.payment_type
     ) AS sub
LEFT JOIN product_category_name_translation AS t
       ON t.product_category_name = sub.category_pt
WHERE sub.rn = 1
ORDER BY sub.payment_count DESC
LIMIT 3;
```

These seven queries progress from simple exploration to the final answer:  
they determine, for each product category, which payment type is most frequently used, then return the three categories whose dominant payment type registers the largest number of payments.
