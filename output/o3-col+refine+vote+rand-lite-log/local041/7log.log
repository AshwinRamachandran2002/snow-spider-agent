```sql
-- Description: Count only trees classified as Good by borough
SELECT "boroname",
       COUNT(*) AS "good_health_trees"
FROM "trees"
WHERE "health" = 'Good'
GROUP BY "boroname"
LIMIT 20;
```

```sql
-- Description: Retrieve the total number of trees and number of Good-health trees in the Bronx
SELECT
    (SELECT COUNT(*) FROM "trees" WHERE "boroname" = 'Bronx')           AS "total_bronx",
    (SELECT COUNT(*) FROM "trees" WHERE "boroname" = 'Bronx' AND "health" = 'Good') AS "good_bronx";
```

```sql
-- Description: Calculate the percentage of Bronx trees whose health status is Good
SELECT
    100.0 * 
    (SELECT COUNT(*) FROM "trees" WHERE "boroname" = 'Bronx' AND "health" = 'Good')
        /
    (SELECT COUNT(*) FROM "trees" WHERE "boroname" = 'Bronx')
    AS "percent_good_in_bronx";
```
