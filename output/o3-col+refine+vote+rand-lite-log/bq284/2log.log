--Description:  Attempt a “year” trend by extracting any 4-digit sequence from the filename
--              (REGEXP_EXTRACT).  Although most BBC-news filenames in this dataset do not
--              actually contain a year, this version runs safely and ignores rows that
--              lack a 4-digit match.  It counts how many “education” articles fall in
--              each extracted year and shows up to 20 distinct years (if any exist).
SELECT
  year,
  COUNT(*) AS education_articles
FROM (
  SELECT
    REGEXP_EXTRACT(`filename`, r'(\d{4})') AS year,
    LOWER(CONCAT(IFNULL(`title`, ''), ' ', IFNULL(`body`, ''))) AS full_text
  FROM `bigquery-public-data.bbc_news.fulltext`
) AS t
WHERE year IS NOT NULL
  AND full_text LIKE '%education%'
GROUP BY year
ORDER BY year
LIMIT 20;
