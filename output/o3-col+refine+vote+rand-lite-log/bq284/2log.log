```sql
--Description:  For each news category we need three metrics in a single query:
--   1) total_in_category  – COUNT(*) of all articles.
--   2) education_mentions – SUM over a CASE that checks if the word “education” appears
--      (case-insensitive) in either title or body via LOWER(... ) LIKE '%education%'.
--   3) education_percentage – the ratio of #2 to #1, guarded by SAFE_DIVIDE to avoid
--      divide-by-zero, then multiplied by 100 and rounded to two decimals.
-- A GROUP BY on `category` ensures every category is returned (even with zero matches).
-- Finally we ORDER BY category for easy reading.
SELECT
  `category`,
  COUNT(*) AS total_in_category,
  SUM(
    CASE
      WHEN LOWER(CONCAT(IFNULL(`title`,''), ' ', IFNULL(`body`,''))) LIKE '%education%' THEN 1
      ELSE 0
    END
  ) AS education_mentions,
  ROUND(
    SAFE_DIVIDE(
      SUM(
        CASE
          WHEN LOWER(CONCAT(IFNULL(`title`,''), ' ', IFNULL(`body`,''))) LIKE '%education%' THEN 1
          ELSE 0
        END
      ),
      COUNT(*)
    ) * 100,
    2
  ) AS education_percentage
FROM `bigquery-public-data.bbc_news.fulltext`
GROUP BY `category`
ORDER BY `category`;
```
