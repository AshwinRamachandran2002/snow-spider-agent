```sql
--Description:  Count how many times the word “education” appears in each article
--              (title + body) and list the 20 articles with the highest counts.
--              BigQuery does not have REGEXP_COUNT, so we:
--                • Merge title and body, convert to lowercase.
--                • REGEXP_EXTRACT_ALL returns an ARRAY containing every exact match of
--                  the pattern 'education'.
--                • ARRAY_LENGTH gives the number of matches (edu_count).
--              We filter first with LIKE to keep only articles that contain at least one
--              occurrence, then order by edu_count descending and limit to 20.
SELECT
  `title`,
  `category`,
  ARRAY_LENGTH(
    REGEXP_EXTRACT_ALL(
      LOWER(CONCAT(IFNULL(`title`, ''), ' ', IFNULL(`body`, ''))),
      r'education'
    )
  ) AS edu_count
FROM `bigquery-public-data.bbc_news.fulltext`
WHERE LOWER(CONCAT(IFNULL(`title`, ''), ' ', IFNULL(`body`, ''))) LIKE '%education%'
ORDER BY edu_count DESC
LIMIT 20;
```
