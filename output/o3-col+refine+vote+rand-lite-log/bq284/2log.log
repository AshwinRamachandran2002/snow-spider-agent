Query:
-- Description: Combine total articles and “education” mentions to compute the percentage within each category.
WITH base AS (
  SELECT `category`,
         COUNT(*) AS total_in_category
  FROM `bigquery-public-data.bbc_news.fulltext`
  GROUP BY `category`
), edu AS (
  SELECT `category`,
         COUNT(*) AS education_mentions
  FROM `bigquery-public-data.bbc_news.fulltext`
  WHERE LOWER(CONCAT(IFNULL(`title`,''), ' ', IFNULL(`body`,''))) LIKE '%education%'
  GROUP BY `category`
)
SELECT b.`category`,
       b.total_in_category,
       IFNULL(e.education_mentions, 0) AS education_mentions,
       ROUND(IFNULL(e.education_mentions,0) * 100.0 / b.total_in_category, 2) AS education_percentage
FROM base b
LEFT JOIN edu e
USING (`category`)
ORDER BY education_percentage DESC;
