--Description:  Build a simple “timeline” of articles containing the word “education”.
--              Because the BBC filenames seldom include an actual year, we still attempt:
--                  • REGEXP_EXTRACT(`filename`, r'(\d{4})') to capture any 4-digit sequence.
--                  • COALESCE(…, 'unknown') so rows without a 4-digit match fall into an
--                    “unknown” bucket instead of being NULL, guaranteeing we return data.
--              We then filter for rows where the concatenated title + body (lower-cased)
--              contains “education”, group by the derived year_or_unknown label, count
--              how many such articles each bucket holds, and order the result.
SELECT
  COALESCE(REGEXP_EXTRACT(`filename`, r'(\d{4})'), 'unknown') AS year_or_unknown,
  COUNT(*) AS education_articles
FROM `bigquery-public-data.bbc_news.fulltext`
WHERE LOWER(CONCAT(IFNULL(`title`, ''), ' ', IFNULL(`body`, ''))) LIKE '%education%'
GROUP BY year_or_unknown
ORDER BY year_or_unknown
