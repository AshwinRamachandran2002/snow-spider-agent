```

```sql
--Description: 2) Preview a handful of articles (title & category) to understand the data distribution.
SELECT `title`, `category`
FROM `bigquery-public-data.bbc_news.fulltext`
LIMIT 20;
```

```sql
--Description: 3) Preview articles whose body OR title contains the word “education” (case-insensitive) to confirm the search pattern.
SELECT `title`, `category`
FROM `bigquery-public-data.bbc_news.fulltext`
WHERE LOWER(`body`)    LIKE '%education%' 
   OR LOWER(`title`)   LIKE '%education%'
LIMIT 20;
```

```sql
--Description: 4) Count how many total BBC articles mention “education”.
SELECT COUNT(*) AS total_with_education
FROM `bigquery-public-data.bbc_news.fulltext`
WHERE LOWER(`body`)  LIKE '%education%' 
   OR LOWER(`title`) LIKE '%education%';
```

```sql
--Description: 5) For each category, count articles that mention “education”.
SELECT 
  `category`,
  COUNT(*) AS education_mentions
FROM `bigquery-public-data.bbc_news.fulltext`
WHERE LOWER(`body`)  LIKE '%education%' 
   OR LOWER(`title`) LIKE '%education%'
GROUP BY `category`
LIMIT 20;
```

```sql
--Description: 6) For each category, count the total number of articles (regardless of content).
SELECT 
  `category`,
  COUNT(*) AS total_articles
FROM `bigquery-public-data.bbc_news.fulltext`
GROUP BY `category`
LIMIT 20;
```

```sql
--Description: 7) Combine the two previous results to compute, per category, the percentage of articles that mention “education”.
SELECT
  total.`category`,
  total.total_articles,
  IFNULL(ed.education_mentions, 0) AS education_mentions,
  ROUND(100 * IFNULL(ed.education_mentions, 0) / total.total_articles, 2) AS pct_with_education
FROM
  (
    SELECT `category`, COUNT(*) AS total_articles
    FROM `bigquery-public-data.bbc_news.fulltext`
    GROUP BY `category`
  ) AS total
LEFT JOIN
  (
    SELECT `category`, COUNT(*) AS education_mentions
    FROM `bigquery-public-data.bbc_news.fulltext`
    WHERE LOWER(`body`)  LIKE '%education%' 
       OR LOWER(`title`) LIKE '%education%'
    GROUP BY `category`
  ) AS ed
USING (`category`)
ORDER BY pct_with_education DESC
LIMIT 20;
```
