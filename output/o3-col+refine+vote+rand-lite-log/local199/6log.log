```

```sql
-- 2️⃣ Description: See which staff members work at which store.
SELECT DISTINCT "staff_id",
                "first_name",
                "last_name",
                "store_id"
FROM "staff"
LIMIT 20;
```

```sql
-- 3️⃣ Description: Look at a few rental records (who created them, when, and which inventory item).
SELECT DISTINCT "rental_id",
                "rental_date",
                "inventory_id",
                "customer_id",
                "staff_id"
FROM "rental"
LIMIT 20;
```

```sql
-- 4️⃣ Description: Join rental → staff to attach the store that each rental came from.
SELECT DISTINCT r."rental_id",
                r."rental_date",
                s."store_id"
FROM   "rental"  AS r
JOIN   "staff"   AS s  ON r."staff_id" = s."staff_id"
LIMIT 20;
```

```sql
-- 5️⃣ Description: Extract year & month of every rental (all stores) to see the format.
SELECT DISTINCT strftime('%Y', r."rental_date") AS "year",
                strftime('%m', r."rental_date") AS "month"
FROM   "rental" AS r
LIMIT 20;
```

```sql
-- 6️⃣ Description: Count rentals by store-id / year / month (pre-aggregation result).
SELECT   s."store_id",
         strftime('%Y', r."rental_date") AS "year",
         strftime('%m', r."rental_date") AS "month",
         COUNT(*) AS "total_rentals"
FROM     "rental" AS r
JOIN     "staff"  AS s ON r."staff_id" = s."staff_id"
GROUP BY s."store_id",
         strftime('%Y', r."rental_date"),
         strftime('%m', r."rental_date")
ORDER BY s."store_id", "total_rentals" DESC
LIMIT 20;
```

```sql
-- 7️⃣ Description: Zoom in on one store (store_id = 1) to inspect its busiest months.
SELECT   strftime('%Y', r."rental_date") AS "year",
         strftime('%m', r."rental_date") AS "month",
         COUNT(*) AS "total_rentals"
FROM     "rental" AS r
JOIN     "staff"  AS s ON r."staff_id" = s."staff_id"
WHERE    s."store_id" = 1
GROUP BY strftime('%Y', r."rental_date"),
         strftime('%m', r."rental_date")
ORDER BY "total_rentals" DESC
LIMIT 20;
```

```sql
-- 8️⃣ Description: For every store, find its maximum monthly rental count.
SELECT   agg."store_id",
         MAX(agg."total_rentals") AS "max_monthly_rentals"
FROM   (
         SELECT s."store_id",
                strftime('%Y', r."rental_date") AS "year",
                strftime('%m', r."rental_date") AS "month",
                COUNT(*) AS "total_rentals"
         FROM   "rental" AS r
         JOIN   "staff"  AS s ON r."staff_id" = s."staff_id"
         GROUP  BY s."store_id",
                   strftime('%Y', r."rental_date"),
                   strftime('%m', r."rental_date")
       ) AS agg
GROUP BY agg."store_id"
LIMIT 20;
```

```sql
-- 9️⃣ Description: Final answer – year & month having the highest rentals for each store.
SELECT  a."store_id",
        a."year",
        a."month",
        a."total_rentals"
FROM   (
         SELECT s."store_id",
                strftime('%Y', r."rental_date") AS "year",
                strftime('%m', r."rental_date") AS "month",
                COUNT(*) AS "total_rentals",
                RANK() OVER (PARTITION BY s."store_id"
                             ORDER BY COUNT(*) DESC) AS "rnk"
         FROM   "rental" AS r
         JOIN   "staff"  AS s ON r."staff_id" = s."staff_id"
         GROUP  BY s."store_id",
                   strftime('%Y', r."rental_date"),
                   strftime('%m', r."rental_date")
       ) AS a
WHERE  a."rnk" = 1
ORDER BY a."store_id"
LIMIT 20;
```
