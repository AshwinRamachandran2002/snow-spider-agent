Query:
-- 8️⃣ Description: For every store, find its maximum monthly rental count.
SELECT   agg."store_id",
         MAX(agg."total_rentals") AS "max_monthly_rentals"
FROM   (
         SELECT s."store_id",
                strftime('%Y', r."rental_date") AS "year",
                strftime('%m', r."rental_date") AS "month",
                COUNT(*) AS "total_rentals"
         FROM   "rental" AS r
         JOIN   "staff"  AS s ON r."staff_id" = s."staff_id"
         GROUP  BY s."store_id",
                   strftime('%Y', r."rental_date"),
                   strftime('%m', r."rental_date")
       ) AS agg
GROUP BY agg."store_id"
LIMIT 20;
Answer:
store_id,max_monthly_rentals
1,3342
2,3367
Query:
-- 9️⃣ Description: Final answer – year & month having the highest rentals for each store.
SELECT  a."store_id",
        a."year",
        a."month",
        a."total_rentals"
FROM   (
         SELECT s."store_id",
                strftime('%Y', r."rental_date") AS "year",
                strftime('%m', r."rental_date") AS "month",
                COUNT(*) AS "total_rentals",
                RANK() OVER (PARTITION BY s."store_id"
                             ORDER BY COUNT(*) DESC) AS "rnk"
         FROM   "rental" AS r
         JOIN   "staff"  AS s ON r."staff_id" = s."staff_id"
         GROUP  BY s."store_id",
                   strftime('%Y', r."rental_date"),
                   strftime('%m', r."rental_date")
       ) AS a
WHERE  a."rnk" = 1
ORDER BY a."store_id"
LIMIT 20;
Answer:
store_id,year,month,total_rentals
1,2005,07,3342
2,2005,07,3367
