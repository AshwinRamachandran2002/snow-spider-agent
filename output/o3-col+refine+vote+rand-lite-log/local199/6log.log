-- 7️⃣ Description: Zoom in on one store (store_id = 1) to inspect its busiest months.
SELECT   strftime('%Y', r."rental_date") AS "year",
         strftime('%m', r."rental_date") AS "month",
         COUNT(*) AS "total_rentals"
FROM     "rental" AS r
JOIN     "staff"  AS s ON r."staff_id" = s."staff_id"
WHERE    s."store_id" = 1
GROUP BY strftime('%Y', r."rental_date"),
         strftime('%m', r."rental_date")
ORDER BY "total_rentals" DESC
LIMIT 20;
