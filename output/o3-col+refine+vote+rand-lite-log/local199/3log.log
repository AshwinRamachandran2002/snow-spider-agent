```sql
--Description: Inspect a few rental records to understand the key columns we will need (rental_id, rental_date, inventory_id, customer_id, staff_id).
SELECT *
FROM "rental"
LIMIT 20;
```

```sql
--Description: Inspect inventory records to learn how each inventory item is linked to a specific store.
SELECT *
FROM "inventory"
LIMIT 20;
```

```sql
--Description: Verify the store table so we know what store_id values exist.
SELECT *
FROM "store"
LIMIT 20;
```

```sql
--Description: Join rental → inventory to see how a rental maps to a store.  Display some sample rows.
SELECT r."rental_id",
       r."rental_date",
       i."store_id",
       r."staff_id"
FROM   "rental" AS r
JOIN   "inventory" AS i
       ON r."inventory_id" = i."inventory_id"
LIMIT 20;
```

```sql
--Description: Check which years appear in the rental data (DISTINCT year).
SELECT DISTINCT strftime('%Y', r."rental_date") AS "year"
FROM   "rental" AS r
LIMIT 20;
```

```sql
--Description: For one store (e.g., store 1) get rental totals by year-month to make sure the counts look reasonable.
SELECT strftime('%Y', r."rental_date") AS "year",
       strftime('%m', r."rental_date") AS "month",
       COUNT(*) AS "total_rentals"
FROM   "rental"  AS r
JOIN   "inventory" AS i
       ON r."inventory_id" = i."inventory_id"
WHERE  i."store_id" = 1
GROUP  BY "year","month"
ORDER  BY "total_rentals" DESC
LIMIT 20;
```

```sql
--Description: Produce rental totals per store, year, and month for ALL stores.
SELECT i."store_id",
       strftime('%Y', r."rental_date") AS "year",
       strftime('%m', r."rental_date") AS "month",
       COUNT(*)                          AS "total_rentals"
FROM   "rental"    AS r
JOIN   "inventory" AS i
       ON r."inventory_id" = i."inventory_id"
GROUP  BY i."store_id", "year", "month"
ORDER  BY i."store_id", "total_rentals" DESC
LIMIT 20;
```

```sql
--Description: Use a window function (ROW_NUMBER) to keep only the month with the highest rentals for each store.
WITH monthly_totals AS (
    SELECT i."store_id",
           strftime('%Y', r."rental_date") AS "year",
           strftime('%m', r."rental_date") AS "month",
           COUNT(*) AS "total_rentals"
    FROM   "rental"    AS r
    JOIN   "inventory" AS i
           ON r."inventory_id" = i."inventory_id"
    GROUP  BY i."store_id", "year", "month"
)
SELECT *
FROM (
    SELECT mt.*,
           ROW_NUMBER() OVER (PARTITION BY mt."store_id" ORDER BY mt."total_rentals" DESC) AS rn
    FROM   monthly_totals AS mt
) AS ranked
WHERE  rn = 1
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – list each store’s year & month with the highest rental count, sorted by store_id.
WITH monthly_totals AS (
    SELECT i."store_id",
           strftime('%Y', r."rental_date") AS "year",
           strftime('%m', r."rental_date") AS "month",
           COUNT(*) AS "total_rentals"
    FROM   "rental"    AS r
    JOIN   "inventory" AS i
           ON r."inventory_id" = i."inventory_id"
    GROUP  BY i."store_id", "year", "month"
),
ranked AS (
    SELECT mt.*,
           ROW_NUMBER() OVER (PARTITION BY mt."store_id" ORDER BY mt."total_rentals" DESC) AS rn
    FROM   monthly_totals AS mt
)
SELECT "store_id",
       "year",
       "month",
       "total_rentals"
FROM   ranked
WHERE  rn = 1
ORDER  BY "store_id";
```

