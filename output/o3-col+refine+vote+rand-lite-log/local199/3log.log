Query:
--Description: For one store (e.g., store 1) get rental totals by year-month to make sure the counts look reasonable.
SELECT strftime('%Y', r."rental_date") AS "year",
       strftime('%m', r."rental_date") AS "month",
       COUNT(*) AS "total_rentals"
FROM   "rental"  AS r
JOIN   "inventory" AS i
       ON r."inventory_id" = i."inventory_id"
WHERE  i."store_id" = 1
GROUP  BY "year","month"
ORDER  BY "total_rentals" DESC
LIMIT 20;
