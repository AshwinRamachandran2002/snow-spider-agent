```sql
-- Description: 1) Look at the list of stores that exist in the database
SELECT DISTINCT "store_id"
FROM "store"
LIMIT 20;
```

```sql
-- Description: 2) Inspect a few rental-date values to confirm the timestamp format
SELECT "rental_id",
       "rental_date"
FROM "rental"
LIMIT 20;
```

```sql
-- Description: 3) Verify the mapping between each staff member and the store they work in
SELECT DISTINCT s."staff_id",
                s."store_id"
FROM "staff" AS s
LIMIT 20;
```

```sql
-- Description: 4) Check a sample join of rental → staff → store to be sure we can reach the store_id
SELECT r."rental_id",
       r."rental_date",
       st."store_id"
FROM   "rental"  AS r
JOIN   "staff"   AS st ON r."staff_id" = st."staff_id"
LIMIT 20;
```

```sql
-- Description: 5) Count rentals per store per (year, month) pair
SELECT st."store_id",
       strftime('%Y', r."rental_date") AS "year",
       strftime('%m', r."rental_date") AS "month",
       COUNT(*)                        AS "total_rentals"
FROM   "rental" AS r
JOIN   "staff"  AS st ON r."staff_id" = st."staff_id"
GROUP  BY st."store_id",
          "year",
          "month"
ORDER  BY st."store_id",
          "total_rentals" DESC
LIMIT 20;
```

```sql
-- Description: 6) Rank the (year, month) rows within each store by total_rentals
SELECT *
FROM  (
        SELECT st."store_id",
               strftime('%Y', r."rental_date") AS "year",
               strftime('%m', r."rental_date") AS "month",
               COUNT(*)                        AS "total_rentals",
               ROW_NUMBER() OVER (PARTITION BY st."store_id"
                                  ORDER BY COUNT(*) DESC) AS "rn"
        FROM   "rental" AS r
        JOIN   "staff"  AS st ON r."staff_id" = st."staff_id"
        GROUP  BY st."store_id",
                 "year",
                 "month"
      )
WHERE "rn" = 1
LIMIT 20;
```

```sql
-- Description: 7) FINAL ANSWER – year & month with the highest rental count for each store
SELECT  sub."store_id",
        sub."year",
        sub."month",
        sub."total_rentals"
FROM  (
        SELECT st."store_id",
               strftime('%Y', r."rental_date") AS "year",
               strftime('%m', r."rental_date") AS "month",
               COUNT(*)                        AS "total_rentals",
               ROW_NUMBER() OVER (PARTITION BY st."store_id"
                                  ORDER BY COUNT(*) DESC) AS "rn"
        FROM   "rental" AS r
        JOIN   "staff"  AS st ON r."staff_id" = st."staff_id"
        GROUP  BY st."store_id",
                 "year",
                 "month"
      ) AS sub
WHERE sub."rn" = 1
ORDER BY sub."store_id"
LIMIT 20;
```
