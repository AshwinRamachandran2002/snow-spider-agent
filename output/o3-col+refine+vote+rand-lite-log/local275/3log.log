    /* 2) keep only 2017 months */
    SELECT *
    FROM   ratio_calc
    WHERE  mth BETWEEN '2017-01-01' AND '2017-12-31'
),
qualifying_products AS (
    /* 3) products whose ratio stayed above 2 in every recorded 2017 month */
    SELECT  product_id
    FROM    ratio_2017
    GROUP BY product_id
    HAVING  MIN(ratio_adj) > 2
)
SELECT  p.id   AS product_id,
        p.name AS product_name
FROM    products AS p
JOIN    qualifying_products q
          ON q.product_id = p.id
ORDER BY p.id;
