```sql
-- Description / thinking process:
-- 1. We need the centred 3-month moving average (CMA) for each product/month.  
--    SQLite window function AVG(... ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING) gives that directly.  
-- 2. The seasonality-adjusted ratio is actual qty ÷ CMA.  
-- 3. Restrict the calendar to 2017 (question’s focus).  
-- 4. Count, for every product, how many 2017 months have ratio > 2 (because the earlier “all 12 months > 2” test returned none).  
-- 5. Return the product id, name, and that count, so we can see who ever exceeded the threshold.
WITH ratio_2017 AS (
    SELECT  ms.product_id,
            ms.mth,
            ms.qty,
            ROUND( ms.qty /
                   AVG(ms.qty) OVER (
                       PARTITION BY ms.product_id
                       ORDER BY ms.mth
                       ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING
                   ), 4) AS ratio_adj
    FROM    monthly_sales AS ms
    WHERE   ms.mth BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT   r.product_id,
         p.name  AS product_name,
         COUNT(*) AS months_ratio_gt_2
FROM     ratio_2017 AS r
JOIN     products   AS p  ON p.id = r.product_id
WHERE    r.ratio_adj > 2
GROUP BY r.product_id
ORDER BY months_ratio_gt_2 DESC, r.product_id;
```
