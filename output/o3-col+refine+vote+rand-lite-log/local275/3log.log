```sql
WITH ratio_calc AS (
    -- 1.  Centre-3-month moving average and ratio for every product/month
    SELECT  ms.product_id,
            ms.mth,
            1.0 * ms.qty /
            AVG(ms.qty) OVER (
                PARTITION BY ms.product_id
                ORDER BY ms.mth
                ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING
            )               AS ratio_adj
    FROM    monthly_sales AS ms
),
ratio_2017 AS (
    -- 2.  Keep only 2017 months
    SELECT  *
    FROM    ratio_calc
    WHERE   mth BETWEEN '2017-01-01' AND '2017-12-31'
),
all_above_two AS (
    -- 3.  Products whose ratio was > 2 for every one of the 12 months in 2017
    SELECT  product_id
    FROM    ratio_2017
    GROUP BY product_id
    HAVING  COUNT(*) = 12            -- all 12 months present
       AND  MIN(ratio_adj) > 2       -- the lowest ratio is still above 2
)
-- 4.  Return the human-readable product names
SELECT  p.id   AS product_id,
        p.name AS product_name
FROM    products AS p
JOIN    all_above_two AS a
       ON a.product_id = p.id
ORDER BY p.id;
```
