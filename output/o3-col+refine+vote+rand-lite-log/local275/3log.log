Query:
-- 6) Derive the seasonality-adjusted ratio (actual / CMA)
SELECT  "product_id",
        "mth",
        "qty",
        ROUND("qty" /
              AVG("qty") OVER(
                    PARTITION BY "product_id"
                    ORDER BY "mth"
                    ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING
              ), 2) AS "ratio_adj"
FROM    "monthly_sales"
WHERE   "mth" >= '2016-01-01'
ORDER BY "product_id", "mth"
LIMIT 20;
