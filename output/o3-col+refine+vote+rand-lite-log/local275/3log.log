Query:
-- 4) Compute a 3-month centred moving average (CMA) for every product/month
--    (1 month before + current + 1 month after)
SELECT  ms."product_id",
        ms."mth",
        ms."qty",
        AVG(ms2."qty") AS "cma_qty"
FROM    "monthly_sales" ms
JOIN    "monthly_sales" ms2
        ON ms2."product_id" = ms."product_id"
       AND ABS(julianday(ms2."mth") - julianday(ms."mth")) <= 31*1          -- ±1 month window
GROUP BY ms."product_id", ms."mth"
ORDER BY ms."product_id", ms."mth"
LIMIT 20;
