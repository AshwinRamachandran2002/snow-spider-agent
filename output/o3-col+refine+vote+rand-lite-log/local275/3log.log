```sql
-- 1) Inspect the time-series source: monthly quantities per product
SELECT *
FROM "monthly_sales"
ORDER BY "product_id", "mth"
LIMIT 20;
```

```sql
-- 2) Check which years are covered in the data
SELECT DISTINCT SUBSTR("mth",1,4) AS "year"
FROM "monthly_sales"
ORDER BY "year";
```

```sql
-- 3) See how many monthly rows each product has from 2016 onwards
SELECT "product_id",
       COUNT(*) AS "months_recorded"
FROM "monthly_sales"
WHERE "mth" >= '2016-01-01'
GROUP BY "product_id"
ORDER BY "months_recorded" DESC
LIMIT 20;
```

```sql
-- 4) Compute a 3-month centred moving average (CMA) for every product/month
--    (1 month before + current + 1 month after)
SELECT  ms."product_id",
        ms."mth",
        ms."qty",
        AVG(ms2."qty") AS "cma_qty"
FROM    "monthly_sales" ms
JOIN    "monthly_sales" ms2
        ON ms2."product_id" = ms."product_id"
       AND ABS(julianday(ms2."mth") - julianday(ms."mth")) <= 31*1          -- ±1 month window
GROUP BY ms."product_id", ms."mth"
ORDER BY ms."product_id", ms."mth"
LIMIT 20;
```

```sql
-- 5) Using a window function for the same 3-month CMA calculation
SELECT  "product_id",
        "mth",
        "qty",
        AVG("qty") OVER(
              PARTITION BY "product_id"
              ORDER BY "mth"
              ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING
        ) AS "cma_qty"
FROM    "monthly_sales"
WHERE   "mth" >= '2016-01-01'
ORDER BY "product_id", "mth"
LIMIT 20;
```

```sql
-- 6) Derive the seasonality-adjusted ratio (actual / CMA)
SELECT  "product_id",
        "mth",
        "qty",
        ROUND("qty" /
              AVG("qty") OVER(
                    PARTITION BY "product_id"
                    ORDER BY "mth"
                    ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING
              ), 2) AS "ratio_adj"
FROM    "monthly_sales"
WHERE   "mth" >= '2016-01-01'
ORDER BY "product_id", "mth"
LIMIT 20;
```

```sql
-- 7) Focus on 2017 only and keep months whose ratio > 2
WITH ratio_2017 AS (
    SELECT  "product_id",
            "mth",
            ROUND("qty" /
                  AVG("qty") OVER(
                        PARTITION BY "product_id"
                        ORDER BY "mth"
                        ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING
                  ), 4) AS "ratio_adj"
    FROM    "monthly_sales"
    WHERE   "mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT *
FROM   ratio_2017
WHERE  "ratio_adj" > 2
ORDER BY "product_id", "mth"
LIMIT 20;
```

```sql
-- 8) Count how many 2017 months each product kept the ratio above 2
WITH ratio_2017 AS (
    SELECT  "product_id",
            "mth",
            ROUND("qty" /
                  AVG("qty") OVER(
                        PARTITION BY "product_id"
                        ORDER BY "mth"
                        ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING
                  ), 4) AS "ratio_adj"
    FROM    "monthly_sales"
    WHERE   "mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT  "product_id",
        COUNT(*) AS "months_ratio_gt_2"
FROM    ratio_2017
WHERE   "ratio_adj" > 2
GROUP BY "product_id"
ORDER BY "months_ratio_gt_2" DESC
LIMIT 20;
```

```sql
-- 9) Pick only the products that achieved a >2 ratio in *all* 12 months of 2017
WITH ratio_2017 AS (
    SELECT  "product_id",
            "mth",
            ROUND("qty" /
                  AVG("qty") OVER(
                        PARTITION BY "product_id"
                        ORDER BY "mth"
                        ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING
                  ), 4) AS "ratio_adj"
    FROM    "monthly_sales"
    WHERE   "mth" BETWEEN '2017-01-01' AND '2017-12-31'
),
good AS (
    SELECT  "product_id"
    FROM    ratio_2017
    WHERE   "ratio_adj" > 2
    GROUP BY "product_id"
    HAVING  COUNT(*) = 12          -- all months of 2017
)
SELECT DISTINCT "product_id"
FROM   good;
```

```sql
-- 10) Map the qualifying product IDs to human-readable names
SELECT DISTINCT p."id" AS "product_id",
                p."name" AS "product_name"
FROM   "products"   p
JOIN   (
        WITH ratio_2017 AS (
            SELECT  "product_id",
                    "mth",
                    ROUND("qty" /
                          AVG("qty") OVER(
                                PARTITION BY "product_id"
                                ORDER BY "mth"
                                ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING
                          ), 4) AS "ratio_adj"
            FROM    "monthly_sales"
            WHERE   "mth" BETWEEN '2017-01-01' AND '2017-12-31'
        )
        SELECT  "product_id"
        FROM    ratio_2017
        WHERE   "ratio_adj" > 2
        GROUP BY "product_id"
        HAVING  COUNT(*) = 12
) g
ON     g."product_id" = p."id";
```
