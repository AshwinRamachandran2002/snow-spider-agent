Query:
-- 7) Focus on 2017 only and keep months whose ratio > 2
WITH ratio_2017 AS (
    SELECT  "product_id",
            "mth",
            ROUND("qty" /
                  AVG("qty") OVER(
                        PARTITION BY "product_id"
                        ORDER BY "mth"
                        ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING
                  ), 4) AS "ratio_adj"
    FROM    "monthly_sales"
    WHERE   "mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT *
FROM   ratio_2017
WHERE  "ratio_adj" > 2
ORDER BY "product_id", "mth"
LIMIT 20;
Answer:
product_id,mth,ratio_adj
4160,2017-08-01,3.0
4280,2017-05-01,2.25
Query:
-- 8) Count how many 2017 months each product kept the ratio above 2
WITH ratio_2017 AS (
    SELECT  "product_id",
            "mth",
            ROUND("qty" /
                  AVG("qty") OVER(
                        PARTITION BY "product_id"
                        ORDER BY "mth"
                        ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING
                  ), 4) AS "ratio_adj"
    FROM    "monthly_sales"
    WHERE   "mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT  "product_id",
        COUNT(*) AS "months_ratio_gt_2"
FROM    ratio_2017
WHERE   "ratio_adj" > 2
GROUP BY "product_id"
ORDER BY "months_ratio_gt_2" DESC
LIMIT 20;
