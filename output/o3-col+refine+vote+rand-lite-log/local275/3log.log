```sql
WITH ratio_calc AS (                         -- 1. centred 3-month MA ratio
    SELECT  ms.product_id,
            ms.mth,
            ROUND(
                1.0 * ms.qty /
                AVG(ms.qty) OVER (
                    PARTITION BY ms.product_id
                    ORDER BY ms.mth
                    ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING
                ), 4
            ) AS ratio_adj
    FROM    monthly_sales AS ms
),
ratio_2017 AS (                              -- 2. restrict to 2017 months
    SELECT *
    FROM   ratio_calc
    WHERE  mth BETWEEN '2017-01-01' AND '2017-12-31'
),
qualifying_products AS (                     -- 3. consistently ≥ 2 all 12 months
    SELECT  product_id
    FROM    ratio_2017
    GROUP BY product_id
    HAVING  COUNT(*) = 12
       AND  MIN(ratio_adj) >= 2
)
SELECT  p.id   AS product_id,                -- 4. final list with names
        p.name AS product_name
FROM    products AS p
JOIN    qualifying_products q
          ON q.product_id = p.id
ORDER BY p.id;
```
