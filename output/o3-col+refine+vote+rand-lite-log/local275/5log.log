--Description: 6) Turn the moving average into a seasonality-adjusted ratio (actual ÷ centred MA).
WITH ms AS (
  SELECT *,
         date("mth") AS "dt"
  FROM   "monthly_sales"
), ma AS (
  SELECT "product_id",
         "mth",
         "qty",
         AVG("qty") OVER (PARTITION BY "product_id"
                          ORDER BY "dt"
                          ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "c_ma_12"
  FROM   ms
)
SELECT "product_id",
       "mth",
       "qty",
       ROUND("qty" * 1.0 / "c_ma_12", 3) AS "ratio"
FROM   ma
ORDER  BY "product_id",
          "mth"
LIMIT 20;
