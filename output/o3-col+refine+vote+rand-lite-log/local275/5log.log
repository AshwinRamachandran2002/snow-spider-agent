Query:
--Description: 
-- Show the complete set of 2017 season-adjusted ratios for every product that
-- registered at least one month in 2017 with a ratio > 2 (from the previous
-- “month-level spike” query).  This lets us inspect the whole year’s pattern.
-- Steps
--   1) ms   – copy monthly_sales and create a date column dt for ordering.
--   2) ma   – compute a centred 12-month moving average (c_ma_12) per product/month.
--   3) ratio– restrict to 2017 rows and calculate the ratio (qty ÷ c_ma_12).
--   4) ok_products – pick every product that had any month with ratio > 2.
--   5) final – list all 12 ratios for those products, ordered by product & month.
WITH ms AS (
    SELECT *,
           date(mth) AS dt
    FROM   monthly_sales
),
ma AS (
    SELECT  product_id,
            mth,
            qty,
            AVG(qty) OVER (
                   PARTITION BY product_id
                   ORDER BY dt
                   ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
            ) AS c_ma_12
    FROM    ms
),
ratio AS (
    SELECT  product_id,
            mth,
            ROUND(qty * 1.0 / c_ma_12, 3) AS ratio
    FROM    ma
    WHERE   mth BETWEEN '2017-01-01' AND '2017-12-01'
),
ok_products AS (
    SELECT DISTINCT product_id
    FROM   ratio
    WHERE  ratio > 2               -- at least one “spike” month
)
SELECT  r.product_id,
        p.name       AS product_name,
        r.mth        AS month_2017,
        r.ratio
FROM    ratio AS r
JOIN    ok_products AS o ON o.product_id = r.product_id
JOIN    products     AS p ON p.id         = r.product_id
ORDER BY r.product_id, r.mth
LIMIT 120
