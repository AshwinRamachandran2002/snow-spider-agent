--Description: 10) (Optional check) Show all 12 ratios for each qualifying product to manually verify consistency.
WITH ms AS (
  SELECT *,
         date("mth") AS "dt"
  FROM   "monthly_sales"
), ma AS (
  SELECT "product_id",
         "mth",
         "qty",
         AVG("qty") OVER (PARTITION BY "product_id"
                          ORDER BY "dt"
                          ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "c_ma_12"
  FROM   ms
), ratio AS (
  SELECT "product_id",
         "mth",
         ROUND("qty" * 1.0 / "c_ma_12", 3) AS "ratio"
  FROM   ma
  WHERE  "mth" BETWEEN '2017-01-01' AND '2017-12-01'
), ok_products AS (
  SELECT "product_id"
  FROM   ratio
  GROUP  BY "product_id"
  HAVING MIN("ratio") > 2
)
SELECT r.*
FROM   ratio AS r
WHERE  r."product_id" IN (SELECT "product_id" FROM ok_products)
ORDER  BY r."product_id",
          r."mth";
