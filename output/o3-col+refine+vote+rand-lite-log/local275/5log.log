WITH ms AS (
    -- 1) copy monthly_sales and add a true DATE column for ordering
    SELECT product_id,
           qty,
           mth,
           DATE(mth) AS dt
    FROM   monthly_sales
),
ma AS (
    -- 2) centred 12-month moving average per product / month
    SELECT product_id,
           mth,
           qty,
           AVG(qty) OVER (
                 PARTITION BY product_id
                 ORDER BY dt
                 ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
           ) AS c_ma_12
    FROM   ms
),
ratio AS (
    -- 3) restrict to the 2017 calendar year and compute the ratio
    SELECT product_id,
           mth,
           qty * 1.0 / c_ma_12 AS ratio
    FROM   ma
    WHERE  mth BETWEEN '2017-01-01' AND '2017-12-01'
)
-- 4) keep only products that have all 12 months in 2017
--    and whose ratio is > 2 for every single month
SELECT   r.product_id,
         p.name AS product_name
FROM     ratio r
JOIN     products p ON p.id = r.product_id
GROUP BY r.product_id
HAVING   COUNT(*) = 12          -- all months present
   AND   MIN(r.ratio) > 2       -- every month above threshold
ORDER BY r.product_id;
```
