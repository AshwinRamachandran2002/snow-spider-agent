```sql
--Description: 
-- Purpose: find which products ever achieved a seasonality-adjusted sales ratio
--          (actual ÷ centred 12-month moving average) above 2 in any month of 2017.
-- Thinking process, step-by-step
--  1) ms   : copy monthly_sales and add a real date column (dt) to drive the window.
--  2) ma   : for every product/month compute the centred 12-month moving average (c_ma_12).
--  3) ratio: calculate the ratio for 2017 rows only.
--  4) final: pick distinct product ids/names where that ratio > 2 at least once.
WITH ms AS (
    SELECT *,
           date("mth") AS dt
    FROM   "monthly_sales"
),
ma AS (
    SELECT  product_id,
            mth,
            qty,
            AVG(qty) OVER (
                PARTITION BY product_id
                ORDER BY dt
                ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
            ) AS c_ma_12
    FROM    ms
),
ratio AS (
    SELECT  product_id,
            mth,
            qty * 1.0 / c_ma_12 AS ratio
    FROM    ma
    WHERE   mth BETWEEN '2017-01-01' AND '2017-12-01'
)
SELECT DISTINCT
       p.id        AS product_id,
       p.name      AS product_name
FROM   ratio  AS r
JOIN   products AS p ON p.id = r.product_id
WHERE  r.ratio > 2
ORDER  BY p.id
LIMIT 20;
```
