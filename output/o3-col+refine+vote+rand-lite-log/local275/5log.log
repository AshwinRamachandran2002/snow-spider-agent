```sql
--Description: 2) Inspect the month-by-month figures for one well-known product (id 4040) so we see how the data looks.
SELECT "product_id",
       "mth",
       "qty"
FROM   "monthly_sales"
WHERE  "product_id" = 4040
ORDER BY "mth"
LIMIT 20;
```

```sql
--Description: 3) How many rows does every product have for the target year 2017? (We expect 12 if the series is complete.)
SELECT "product_id",
       COUNT(*) AS "rows_2017"
FROM   "monthly_sales"
WHERE  "mth" BETWEEN '2017-01-01' AND '2017-12-01'
GROUP  BY "product_id"
LIMIT 20;
```

```sql
--Description: 4) Build a centred 12-month moving average for just one product (4040) to validate the window logic.
SELECT "product_id",
       "mth",
       "qty",
       AVG("qty") OVER (PARTITION BY "product_id"
                        ORDER BY date("mth")
                        ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "c_ma_12"
FROM   "monthly_sales"
WHERE  "product_id" = 4040
ORDER  BY "mth"
LIMIT 20;
```

```sql
--Description: 5) Produce the same centred moving average for every product in the table.
WITH ms AS (
  SELECT *,
         date("mth") AS "dt"
  FROM   "monthly_sales"
)
SELECT "product_id",
       "mth",
       "qty",
       AVG("qty") OVER (PARTITION BY "product_id"
                        ORDER BY "dt"
                        ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "c_ma_12"
FROM   ms
ORDER  BY "product_id",
          "mth"
LIMIT 20;
```

```sql
--Description: 6) Turn the moving average into a seasonality-adjusted ratio (actual ÷ centred MA).
WITH ms AS (
  SELECT *,
         date("mth") AS "dt"
  FROM   "monthly_sales"
), ma AS (
  SELECT "product_id",
         "mth",
         "qty",
         AVG("qty") OVER (PARTITION BY "product_id"
                          ORDER BY "dt"
                          ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "c_ma_12"
  FROM   ms
)
SELECT "product_id",
       "mth",
       "qty",
       ROUND("qty" * 1.0 / "c_ma_12", 3) AS "ratio"
FROM   ma
ORDER  BY "product_id",
          "mth"
LIMIT 20;
```

```sql
--Description: 7) Keep only the 2017 rows whose ratio is above 2 (our condition of interest).
WITH ms AS (
  SELECT *,
         date("mth") AS "dt"
  FROM   "monthly_sales"
), ma AS (
  SELECT "product_id",
         "mth",
         "qty",
         AVG("qty") OVER (PARTITION BY "product_id"
                          ORDER BY "dt"
                          ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "c_ma_12"
  FROM   ms
), ratio AS (
  SELECT "product_id",
         "mth",
         "qty",
         "c_ma_12",
         "qty" * 1.0 / "c_ma_12" AS "ratio"
  FROM   ma
)
SELECT *
FROM   ratio
WHERE  "mth" BETWEEN '2017-01-01' AND '2017-12-01'
  AND  "ratio" > 2
ORDER  BY "product_id",
          "mth"
LIMIT 20;
```

```sql
--Description: 8) For every product, check the minimum ratio during 2017 – only those whose minimum stays above 2 throughout the year survive.
WITH ms AS (
  SELECT *,
         date("mth") AS "dt"
  FROM   "monthly_sales"
), ma AS (
  SELECT "product_id",
         "mth",
         "qty",
         AVG("qty") OVER (PARTITION BY "product_id"
                          ORDER BY "dt"
                          ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "c_ma_12"
  FROM   ms
), ratio AS (
  SELECT "product_id",
         "mth",
         "qty",
         "c_ma_12",
         "qty" * 1.0 / "c_ma_12" AS "ratio"
  FROM   ma
  WHERE  "mth" BETWEEN '2017-01-01' AND '2017-12-01'
)
SELECT "product_id",
       MIN("ratio") AS "worst_ratio_2017"
FROM   ratio
GROUP  BY "product_id"
HAVING MIN("ratio") > 2
LIMIT 20;
```

```sql
--Description: 9) The final answer – list the id & name of every product whose seasonality-adjusted sales ratio was >2 for every month of 2017.
WITH ms AS (
  SELECT *,
         date("mth") AS "dt"
  FROM   "monthly_sales"
), ma AS (
  SELECT "product_id",
         "mth",
         "qty",
         AVG("qty") OVER (PARTITION BY "product_id"
                          ORDER BY "dt"
                          ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "c_ma_12"
  FROM   ms
), ratio AS (
  SELECT "product_id",
         "mth",
         "qty",
         "c_ma_12",
         "qty" * 1.0 / "c_ma_12" AS "ratio"
  FROM   ma
  WHERE  "mth" BETWEEN '2017-01-01' AND '2017-12-01'
), ok_products AS (
  SELECT "product_id"
  FROM   ratio
  GROUP  BY "product_id"
  HAVING MIN("ratio") > 2
)
SELECT DISTINCT p."id",
       p."name"
FROM   ok_products AS o
JOIN   "products"  AS p ON p."id" = o."product_id";
```

