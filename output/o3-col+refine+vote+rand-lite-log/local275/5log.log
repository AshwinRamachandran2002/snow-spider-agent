        r.mth        AS month_2017,
        r.ratio
FROM    ratio AS r
JOIN    ok_products AS o ON o.product_id = r.product_id
JOIN    products     AS p ON p.id         = r.product_id
ORDER BY r.product_id, r.mth
LIMIT 120;
