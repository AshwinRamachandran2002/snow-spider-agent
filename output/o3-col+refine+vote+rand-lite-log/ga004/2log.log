```sql
--Description: Sample 20 purchase events in December-2020
SELECT `event_date`,
       `event_timestamp`,
       `user_pseudo_id`
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND `event_name` = 'purchase'
LIMIT 20;
```

```sql
--Description: How many purchase events happened on each December day?
SELECT _TABLE_SUFFIX AS `event_table`,
       COUNT(*)       AS `purchase_events`
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND `event_name` = 'purchase'
GROUP BY `event_table`
ORDER BY `event_table`
LIMIT 20;
```

```sql
--Description: List 20 distinct users who purchased something in December-2020
SELECT DISTINCT `user_pseudo_id`
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND `event_name` = 'purchase'
LIMIT 20;
```

```sql
--Description: Top 20 users by number of December pageviews
SELECT `user_pseudo_id`,
       COUNT(*) AS `pageviews`
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND `event_name` = 'page_view'
GROUP BY `user_pseudo_id`
ORDER BY `pageviews` DESC
LIMIT 20;
```

```sql
--Description: Build one-row-per-user summary for December (pageviews & purchase flag)
SELECT `user_pseudo_id`,
       SUM(CASE WHEN `event_name` = 'page_view'  THEN 1 ELSE 0 END) AS `pageviews`,
       MAX(CASE WHEN `event_name` = 'purchase'  THEN 1 ELSE 0 END) AS `purchased`
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
GROUP BY `user_pseudo_id`
LIMIT 20;
```

```sql
--Description: FINAL – average pageviews for purchasers vs. non-purchasers in December-2020
SELECT `purchased` AS `purchaser_flag`,          -- 1 = purchaser, 0 = non-purchaser
       AVG(`pageviews`) AS `avg_pageviews`
FROM (
    SELECT `user_pseudo_id`,
           SUM(CASE WHEN `event_name` = 'page_view' THEN 1 ELSE 0 END) AS `pageviews`,
           MAX(CASE WHEN `event_name` = 'purchase' THEN 1 ELSE 0 END) AS `purchased`
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    GROUP BY `user_pseudo_id`
)
GROUP BY `purchaser_flag`
LIMIT 20;
```
