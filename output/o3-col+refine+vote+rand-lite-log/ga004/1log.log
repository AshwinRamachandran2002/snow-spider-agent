```sql
--Description: Purchase counts per user in December 2020 (sample 20 users).
SELECT
  user_pseudo_id,
  COUNTIF(event_name = 'purchase') AS purchases
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
--Description: Combine page-view and purchase counts per user and tag purchasers (sample 20).
SELECT
  user_pseudo_id,
  COUNTIF(event_name = 'page_view')  AS pageviews,
  COUNTIF(event_name = 'purchase')   AS purchases,
  CASE WHEN COUNTIF(event_name = 'purchase') > 0
       THEN 'purchaser' ELSE 'non_purchaser' END     AS purchaser_flag
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
--Description: Average page-views per group (purchasers vs. non-purchasers).
WITH per_user AS (
  SELECT
    user_pseudo_id,
    COUNTIF(event_name = 'page_view')  AS pageviews,
    COUNTIF(event_name = 'purchase')   AS purchases,
    CASE WHEN COUNTIF(event_name = 'purchase') > 0
         THEN 'purchaser' ELSE 'non_purchaser' END AS purchaser_flag
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  GROUP BY user_pseudo_id
)
SELECT
  purchaser_flag,
  AVG(pageviews) AS avg_pageviews
FROM per_user
GROUP BY purchaser_flag
LIMIT 20;
```

```sql
--Description: Final answer – difference in average page-views between purchasers and non-purchasers in Dec 2020.
WITH per_user AS (
  SELECT
    user_pseudo_id,
    COUNTIF(event_name = 'page_view')  AS pageviews,
    COUNTIF(event_name = 'purchase')   AS purchases
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  GROUP BY user_pseudo_id
),
averages AS (
  SELECT
    AVG(CASE WHEN purchases > 0 THEN pageviews END) AS avg_pageviews_purchasers,
    AVG(CASE WHEN purchases = 0 THEN pageviews END) AS avg_pageviews_non_purchasers
  FROM per_user
)
SELECT
  avg_pageviews_purchasers,
  avg_pageviews_non_purchasers,
  avg_pageviews_purchasers - avg_pageviews_non_purchasers AS avg_pageviews_difference
FROM averages
LIMIT 20;
```
