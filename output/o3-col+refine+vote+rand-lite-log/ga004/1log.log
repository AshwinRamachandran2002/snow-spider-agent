Query:
--Description: Average page-views per group (purchasers vs. non-purchasers).
WITH per_user AS (
  SELECT
    user_pseudo_id,
    COUNTIF(event_name = 'page_view')  AS pageviews,
    COUNTIF(event_name = 'purchase')   AS purchases,
    CASE WHEN COUNTIF(event_name = 'purchase') > 0
         THEN 'purchaser' ELSE 'non_purchaser' END AS purchaser_flag
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  GROUP BY user_pseudo_id
)
SELECT
  purchaser_flag,
  AVG(pageviews) AS avg_pageviews
FROM per_user
GROUP BY purchaser_flag
LIMIT 20;
