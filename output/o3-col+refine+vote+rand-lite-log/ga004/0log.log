       `event_timestamp`,
       `event_name`,
       `user_pseudo_id`
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
WHERE `event_name` = 'purchase'
LIMIT 20;
```

```sql
--Description: 3) Grab a list of distinct purchasers in December-2020.  
SELECT DISTINCT `user_pseudo_id`
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
WHERE `event_name` = 'purchase'
LIMIT 20;
```

```sql
--Description: 4) Count how many page-views each user generated in December-2020.  
SELECT `user_pseudo_id`,
       COUNT(1) AS pageviews
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
WHERE `event_name` = 'page_view'
GROUP BY `user_pseudo_id`
LIMIT 20;
```

```sql
--Description: 5) Attach a purchaser flag to every user together with their page-view count.  
SELECT pv.`user_pseudo_id`,
       pv.pageviews,
       IF(pur.`user_pseudo_id` IS NULL, 0, 1) AS is_purchaser
FROM (
  SELECT `user_pseudo_id`, COUNT(1) AS pageviews
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE `event_name` = 'page_view'
  GROUP BY `user_pseudo_id`
) AS pv
LEFT JOIN (
  SELECT DISTINCT `user_pseudo_id`
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE `event_name` = 'purchase'
) AS pur
USING(`user_pseudo_id`)
LIMIT 20;
```

```sql
--Description: 6) Average page-views among purchasers only.  
SELECT AVG(pageviews) AS avg_pageviews_purchasers
FROM (
  SELECT `user_pseudo_id`, COUNT(1) AS pageviews
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE `event_name` = 'page_view'
  GROUP BY `user_pseudo_id`
) AS pv
WHERE `user_pseudo_id` IN (
  SELECT DISTINCT `user_pseudo_id`
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE `event_name` = 'purchase'
)
LIMIT 20;
```

```sql
--Description: 7) Average page-views among NON-purchasers.  
SELECT AVG(pageviews) AS avg_pageviews_non_purchasers
FROM (
  SELECT `user_pseudo_id`, COUNT(1) AS pageviews
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE `event_name` = 'page_view'
  GROUP BY `user_pseudo_id`
) AS pv
WHERE `user_pseudo_id` NOT IN (
  SELECT DISTINCT `user_pseudo_id`
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE `event_name` = 'purchase'
)
LIMIT 20;
```

```sql
--Description: 8) Put it all together – average page-views for each segment and their difference.  
SELECT
  AVG(CASE WHEN is_purchaser = 1 THEN pageviews END) AS avg_pageviews_purchasers,
  AVG(CASE WHEN is_purchaser = 0 THEN pageviews END) AS avg_pageviews_non_purchasers,
  AVG(CASE WHEN is_purchaser = 1 THEN pageviews END)
  - AVG(CASE WHEN is_purchaser = 0 THEN pageviews END)       AS avg_difference
FROM (
  SELECT pv.`user_pseudo_id`,
         pv.pageviews,
         IF(pur.`user_pseudo_id` IS NULL, 0, 1) AS is_purchaser
  FROM (
    SELECT `user_pseudo_id`, COUNT(1) AS pageviews
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
    WHERE `event_name` = 'page_view'
    GROUP BY `user_pseudo_id`
  ) AS pv
  LEFT JOIN (
    SELECT DISTINCT `user_pseudo_id`
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
    WHERE `event_name` = 'purchase'
  ) AS pur
  USING(`user_pseudo_id`)
)
LIMIT 20;
```

Running the final query (#8) will return three values:

• avg_pageviews_purchasers – average December page-view count for users who made at least one purchase  
• avg_pageviews_non_purchasers – average December page-view count for users who made no purchases  
• avg_difference – the difference between those two averages (purchasers minus non-purchasers)  

That number answers “the average difference in page-views between users who bought something and those who didn’t in December 2020.”
