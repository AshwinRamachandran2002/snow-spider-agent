```sql
--Description: Show page-view counts for a few non-purchasers (December only)
WITH purchasers AS (
  SELECT DISTINCT user_pseudo_id
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND  event_name = 'purchase'
)
SELECT  e.user_pseudo_id ,
        COUNT(*) AS pageviews
FROM    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
WHERE   _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND   e.event_name = 'page_view'
  AND   e.user_pseudo_id NOT IN (SELECT user_pseudo_id FROM purchasers)
GROUP BY e.user_pseudo_id
LIMIT 20;
```

```sql
--Description: Compute the average number of December page-views for purchasers vs non-purchasers
WITH purchasers AS (
  SELECT DISTINCT user_pseudo_id
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND  event_name = 'purchase'
),
pageviews AS (
  SELECT user_pseudo_id,
         COUNTIF(event_name = 'page_view') AS pv
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  GROUP  BY user_pseudo_id
)
SELECT CASE WHEN p.user_pseudo_id IS NOT NULL THEN 'Purchaser'
            ELSE 'Non_Purchaser' END   AS user_type,
       AVG(pv)                            AS avg_pageviews
FROM   pageviews  v
LEFT JOIN purchasers p
       ON v.user_pseudo_id = p.user_pseudo_id
GROUP BY user_type
LIMIT 20;
```

```sql
--Description: Produce a tidy two-row result showing average page-views side-by-side
WITH purchasers AS (
  SELECT DISTINCT user_pseudo_id
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND  event_name = 'purchase'
),
pageviews AS (
  SELECT user_pseudo_id,
         COUNTIF(event_name = 'page_view') AS pv
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  GROUP  BY user_pseudo_id
),
averages AS (
  SELECT CASE WHEN p.user_pseudo_id IS NOT NULL THEN 'Purchaser'
              ELSE 'Non_Purchaser' END   AS user_type,
         AVG(pv) AS avg_pageviews
  FROM   pageviews v
  LEFT  JOIN purchasers p
         ON v.user_pseudo_id = p.user_pseudo_id
  GROUP BY user_type
)
SELECT * FROM averages
LIMIT 20;
```

```sql
--Description: Finally, calculate the difference (purchasers – non-purchasers) in average page-views
WITH purchasers AS (
  SELECT DISTINCT user_pseudo_id
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND  event_name = 'purchase'
),
pageviews AS (
  SELECT user_pseudo_id,
         COUNTIF(event_name = 'page_view') AS pv
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  GROUP  BY user_pseudo_id
),
averages AS (
  SELECT CASE WHEN p.user_pseudo_id IS NOT NULL THEN 'Purchaser'
              ELSE 'Non_Purchaser' END   AS user_type,
         AVG(pv) AS avg_pageviews
  FROM   pageviews v
  LEFT  JOIN purchasers p
         ON v.user_pseudo_id = p.user_pseudo_id
  GROUP BY user_type
)
SELECT (MAX(CASE WHEN user_type = 'Purchaser'     THEN avg_pageviews END)
      - MAX(CASE WHEN user_type = 'Non_Purchaser' THEN avg_pageviews END))
      AS avg_pageview_difference
FROM   averages
LIMIT 20;
```

```sql
--Description: (extra) Show top-20 purchasers by page-views to eyeball distribution
WITH purchasers AS (
  SELECT DISTINCT user_pseudo_id
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND  event_name = 'purchase'
)
SELECT e.user_pseudo_id,
       COUNT(*) AS pageviews
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
WHERE  _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND  e.event_name = 'page_view'
  AND  e.user_pseudo_id IN (SELECT user_pseudo_id FROM purchasers)
GROUP BY e.user_pseudo_id
ORDER BY pageviews DESC
LIMIT 20;
```
