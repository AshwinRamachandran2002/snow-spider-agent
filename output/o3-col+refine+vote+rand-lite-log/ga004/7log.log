Query:
--Description: 8) Compute the average December page-views for purchasers vs. non-purchasers.  
SELECT
  is_purchaser,
  AVG(pageviews_dec_2020) AS avg_pageviews
FROM (
      SELECT
        a.user_pseudo_id,
        a.pageviews_dec_2020,
        CASE WHEN b.user_pseudo_id IS NOT NULL THEN 1 ELSE 0 END AS is_purchaser
      FROM (
            SELECT `user_pseudo_id`, COUNT(*) AS pageviews_dec_2020
            FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
            WHERE  `event_name` = 'page_view'
            GROUP BY `user_pseudo_id`
           ) AS a
      LEFT JOIN (
            SELECT DISTINCT `user_pseudo_id`
            FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
            WHERE  `event_name` = 'purchase'
           ) AS b
      USING (`user_pseudo_id`)
     )
GROUP BY is_purchaser
LIMIT 20;
