```sql
--Description: Build a list of purchasers (flag = 1) – sample the first 20  
SELECT DISTINCT
  `user_pseudo_id`,
  1 AS is_purchaser
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
WHERE `event_name` = 'purchase'
LIMIT 20;
```

```sql
--Description: Join pageview counts with the purchaser flag (0/1) – first 20 joined rows  
WITH pageviews AS (
  SELECT `user_pseudo_id`, COUNT(*) AS pageviews
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE `event_name` = 'page_view'
  GROUP BY `user_pseudo_id`
),
purchasers AS (
  SELECT DISTINCT `user_pseudo_id`, 1 AS is_purchaser
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE `event_name` = 'purchase'
)
SELECT
  pv.`user_pseudo_id`,
  pv.pageviews,
  IFNULL(pr.is_purchaser, 0) AS is_purchaser
FROM pageviews pv
LEFT JOIN purchasers pr
ON pv.`user_pseudo_id` = pr.`user_pseudo_id`
LIMIT 20;
```

```sql
--Description: Compute the average number of pageviews for purchasers vs. non-purchasers  
WITH pageviews AS (
  SELECT `user_pseudo_id`, COUNT(*) AS pageviews
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE `event_name` = 'page_view'
  GROUP BY `user_pseudo_id`
),
purchasers AS (
  SELECT DISTINCT `user_pseudo_id`, 1 AS is_purchaser
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE `event_name` = 'purchase'
)
SELECT
  IFNULL(pr.is_purchaser, 0) AS is_purchaser,
  AVG(pv.pageviews)        AS avg_pageviews
FROM pageviews pv
LEFT JOIN purchasers pr
ON pv.`user_pseudo_id` = pr.`user_pseudo_id`
GROUP BY is_purchaser
LIMIT 20;
```

```sql
--Description: Final step – difference in average pageviews (purchasers minus non-purchasers)  
WITH pageviews AS (
  SELECT `user_pseudo_id`, COUNT(*) AS pageviews
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE `event_name` = 'page_view'
  GROUP BY `user_pseudo_id`
),
purchasers AS (
  SELECT DISTINCT `user_pseudo_id`, 1 AS is_purchaser
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE `event_name` = 'purchase'
),
avg_views AS (
  SELECT
    IFNULL(pr.is_purchaser, 0) AS is_purchaser,
    AVG(pv.pageviews)          AS avg_pageviews
  FROM pageviews pv
  LEFT JOIN purchasers pr
  ON pv.`user_pseudo_id` = pr.`user_pseudo_id`
  GROUP BY is_purchaser
)
SELECT
  MAX(IF(is_purchaser = 1, avg_pageviews, NULL)) -
  MAX(IF(is_purchaser = 0, avg_pageviews, NULL)) AS avg_pageview_difference
FROM avg_views
LIMIT 20;
```
These nine queries progressively explore the dataset, identify purchasers, calculate per-user pageviews, and ultimately return the average difference in pageviews between purchasers and non-purchasers for December 2020.
