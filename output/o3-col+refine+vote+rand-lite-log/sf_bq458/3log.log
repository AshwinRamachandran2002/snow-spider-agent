WITH
/* ------------------------------------------------------------------ */
/* 1) hard-coded list of English stop-words to discard                */
stop_words(word) AS (
    SELECT column1 FROM VALUES
        ('the'),('of'),('and'),('in'),('to'),('a'),('with'),('for'),('was'),
        ('is'),('on'),('that'),('were'),('as'),('by'),('at'),('from'),
        ('it'),('this'),('an'),('be'),('are'),('which'),('or'),('we'),
        ('also'),('can'),('have'),('has'),('had'),('but'),('not'),('their'),
        ('they'),('these'),('our'),('one'),('two'),('three'),('four'),
        ('five'),('into'),('between'),('such'),('its'),('may')
),
/* ------------------------------------------------------------------ */
/* 2) tokenise every article body into (id, date, title, word) rows   */
tokens AS (
    SELECT
        n.id,
        n.date,
        n.title,
        TRIM(tk.value::string)   AS word
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE AS n,
         LATERAL FLATTEN(
                SPLIT(
                    LOWER(
                        REGEXP_REPLACE(n.body , '[^A-Za-z]+' , ' ')
                    ), ' ')
         ) tk
),
/* ------------------------------------------------------------------ */
/* 3) join to frequency table, glove vectors, and drop stop-words     */
words AS (
    SELECT
        t.id,
        t.date,
        t.title,
        f.frequency,
        g.vector                                   AS raw_vec
    FROM tokens t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
         ON f.word = t.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   g
         ON g.word = t.word
    LEFT JOIN stop_words sw                           ON sw.word = t.word
    WHERE sw.word IS NULL            -- remove stop words
      AND t.word <> ''               -- ignore empty tokens
),
/* ------------------------------------------------------------------ */
/* 4) weight every word vector by 1 / frequency^0.4                   */
weighted AS (
    SELECT
        id,
        date,
        title,
        ARRAY_TRANSFORM(raw_vec , x -> x / POW(frequency , 0.4))  AS w_vec
    FROM words
),
/* ------------------------------------------------------------------ */
/* 5) sum weighted vectors element-wise to obtain an article vector   */
summed AS (
    SELECT
        id,
        date,
        title,
        ARRAY_AGG( s_val ORDER BY pos )    AS sum_vec
    FROM (
        SELECT
            id,
            date,
            title,
            pos,
            SUM(val)           AS s_val
        FROM (
            SELECT
                id,
                date,
                title,
                f.index         AS pos,
                f.value::float  AS val
            FROM weighted,
                 LATERAL FLATTEN( input => w_vec )  f
        )
        GROUP BY id, date, title, pos
    )
    GROUP BY id, date, title
),
/* ------------------------------------------------------------------ */
/* 6) compute vector magnitude                                        */
magnitudes AS (
    SELECT
        s.*,
        SQRT( SUM( POWER(f.value::float , 2) ) )  AS mag
    FROM summed s,
         LATERAL FLATTEN( input => s.sum_vec ) f
    GROUP BY s.id, s.date, s.title, s.sum_vec
),
/* ------------------------------------------------------------------ */
/* 7) normalise to unit length                                        */
normalised AS (
    SELECT
        id,
        date,
        title,
        ARRAY_TRANSFORM( sum_vec , x -> x / mag )       AS article_vector
    FROM magnitudes
    WHERE mag > 0
)
/* ------------------------------------------------------------------ */
SELECT
    id,
    date,
    title,
    article_vector
FROM normalised;
```
