    SELECT
        id,
        date,
        title,
        ARRAY_TRANSFORM(raw_vec , x -> x / POW(frequency , 0.4)) AS w_vec
    FROM words
),

/* --------------------------------------------------------------- */
/* 5) Flatten & sum by position                                     */
flattened AS (
