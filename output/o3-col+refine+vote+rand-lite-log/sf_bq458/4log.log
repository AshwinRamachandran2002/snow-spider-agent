```sql
--Description: Tokenise (very naively) the body of one arbitrary article into lower-case alphabetic tokens  
SELECT  LOWER( REGEXP_REPLACE(tok.value::STRING, '[^a-zA-Z]', '') ) AS "token"
FROM    ( SELECT "id", "body"
          FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
          LIMIT  1 ) n,
