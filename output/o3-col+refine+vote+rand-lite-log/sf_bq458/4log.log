```sql
--Description: 
-- Build frequency-weighted word vectors for tokens in the first Nature article.
-- Logic:
--   • Pull the article body (LIMIT 1).
--   • Split on spaces, flatten → tokens, keep only alphabetic chars, lower-case.
--   • Join each token to WORD_FREQUENCIES (alias numerical column as freq).
--   • Join to GLOVE_VECTORS to obtain the 300-dim vector.
--   • In ARRAY_TRANSFORM divide every dimension by freq^0.4.
--   • Return 20 (token, weighted_vec) rows.
SELECT
       tok."token",
       ARRAY_TRANSFORM(
           gv."vector",
           (val, idx) -> val / POWER(freq, 0.4)      -- weight by frequency^0.4
       ) AS "weighted_vec"
FROM (
        /* tokenise & clean first Nature article */
        SELECT LOWER(REGEXP_REPLACE(f.value::STRING, '[^a-zA-Z]', '')) AS "token"
        FROM (
                 SELECT "body"
                 FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
                 LIMIT  1
             ) art,
             LATERAL FLATTEN(input => SPLIT(art."body", ' ')) f
        WHERE LEN(REGEXP_REPLACE(f.value::STRING, '[^a-zA-Z]', '')) > 0
     ) tok
JOIN (
        SELECT "word", "frequency"::FLOAT AS freq
        FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES"
     ) wf
  ON tok."token" = wf."word"
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
  ON tok."token" = gv."word"
LIMIT 20;
