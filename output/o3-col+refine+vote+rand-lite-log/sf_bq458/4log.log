--Description: 
-- Single SQL to derive a unit-length semantic vector for each Nature article (show 20 rows).
-- Thinking pipeline (implemented via CTEs):
--   1. token_data  : split every article body into lowercase alphabetic tokens, then
--                    join each token to WORD_FREQUENCIES (alias numeric column as freq)
--                    and GLOVE_VECTORS (vec = 300-dim embedding).
--   2. weighted    : scale each embedding dimension by freq^-0.4 using ARRAY_TRANSFORM.
--   3. summed      : sum (element-wise) all weighted vectors per article with
--                    ARRAY_REDUCE + ARRAY_ZIP_WITH.
--   4. normalised  : compute Euclidean magnitude of the summed vector and divide each
--                    component by that magnitude to obtain a unit-length article vector.
WITH token_data AS (  -- 1 ────────────────────────────────────────────────────────────
    SELECT
        n."id",
        n."date",
        n."title",
        gv."vector"               AS vec,
        wf."frequency"::FLOAT     AS freq
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"            n,
         LATERAL FLATTEN(
             input => SPLIT(
                         LOWER(REGEXP_REPLACE(n."body", '[^a-zA-Z ]', ' ')),
                         ' '
                     )
         ) t
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES"  wf
         ON t.value::STRING = wf."word"
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"     gv
         ON t.value::STRING = gv."word"
    WHERE LEN(t.value::STRING) > 0
), weighted AS (      -- 2 ────────────────────────────────────────────────────────────
    SELECT
        "id",
        "date",
        "title",
        ARRAY_TRANSFORM(
            vec,
            (v, i) -> v / POWER(freq, 0.4)
        ) AS w_vec
    FROM token_data
), summed AS (        -- 3 ────────────────────────────────────────────────────────────
    SELECT
        "id",
        "date",
        "title",
        ARRAY_REDUCE(
            ARRAY_AGG(w_vec),
            (acc, cur) -> ARRAY_ZIP_WITH(
                               acc, cur,
                               (a, b) -> COALESCE(a, 0) + COALESCE(b, 0)
                           )
        ) AS raw_vec
    FROM weighted
    GROUP BY "id", "date", "title"
), normalised AS (    -- 4 ────────────────────────────────────────────────────────────
    SELECT
        "id",
        "date",
        "title",
        raw_vec,
        SQRT(
            ARRAY_SUM(
                ARRAY_TRANSFORM(raw_vec, (v, i) -> v * v)
            )
        ) AS mag
    FROM summed
)
SELECT
    "id",
    "date",
    "title",
    ARRAY_TRANSFORM(raw_vec, (v, i) -> v / NULLIF(mag, 0)) AS article_vector_normalised
FROM normalised
LIMIT 20;
