--Description: 
-- Build frequency-weighted GloVe vectors for tokens in the first Nature article.
-- Strategy
--   • Tokenise the article body ⇒ clean, lower-case alphabetic tokens.
--   • Join each token to WORD_FREQUENCIES (get numeric alias "freq") and GLOVE_VECTORS.
--   • Put token, 300-dim vector and freq into a derived table d.
--   • Inside ARRAY_TRANSFORM divide every dimension by freq^0.4.
--     (referencing the column name "freq" directly, without table alias, so the
--      value is visible within the lambda).
--   • Show 20 (token, weighted_vec) rows.

SELECT
       d."token",
       ARRAY_TRANSFORM(
           d."vector",
           (val, idx) -> val / POWER("freq", 0.4)   -- weight each dimension
       ) AS "weighted_vec"
FROM (
        /* token + vector + frequency (alias as freq) */
        SELECT
               tok."token",
               gv."vector",
               wf."frequency"::FLOAT AS "freq"
        FROM (
                 /* Tokenise and clean the first Nature article */
                 SELECT LOWER(REGEXP_REPLACE(f.value::STRING, '[^a-zA-Z]', '')) AS "token"
                 FROM (
                          SELECT "body"
                          FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
                          LIMIT  1
                       ) art,
                       LATERAL FLATTEN(INPUT => SPLIT(art."body", ' ')) f
                 WHERE LEN(REGEXP_REPLACE(f.value::STRING, '[^a-zA-Z]', '')) > 0
             ) tok
        JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
             ON tok."token" = wf."word"
        JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
             ON tok."token" = gv."word"
     ) d
LIMIT 20;
```
