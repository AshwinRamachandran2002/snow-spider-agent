WHERE   LEN( REGEXP_REPLACE(tok.value::STRING, '[^a-zA-Z]', '') ) > 0
LIMIT   20;
```

```sql
--Description: Join those tokens to the frequency and GloVe tables so we get frequency & vector for each token  
SELECT tok."token",
       wf."frequency",
       POWER( wf."frequency", 0.4 )                            AS "freq_pow_04",
       gv."vector"
FROM  ( /* token list from previous step */
       SELECT LOWER( REGEXP_REPLACE(tok.value::STRING, '[^a-zA-Z]', '') ) AS "token"
       FROM   ( SELECT "id", "body"
                FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
                LIMIT  1 ) n,
              LATERAL FLATTEN( input => SPLIT( n."body", ' ' ) ) tok
       WHERE  LEN( REGEXP_REPLACE(tok.value::STRING, '[^a-zA-Z]', '') ) > 0
     ) tok
JOIN  "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
      ON tok."token" = wf."word"
JOIN  "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"     gv
      ON tok."token" = gv."word"
LIMIT 20;
```

```sql
--Description: Build weighted vectors for every token in one article (divide by frequency^0.4)  
SELECT tok."token",
       ARRAY_TRANSFORM( gv."vector",
                        (val, idx) -> val / POWER( wf."frequency", 0.4 ) ) AS "weighted_vec"
FROM   ( /* same token selection as before */ 
        SELECT LOWER( REGEXP_REPLACE(tok.value::STRING, '[^a-zA-Z]', '') ) AS "token"
        FROM   ( SELECT "id", "body"
                 FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
                 LIMIT  1 ) n,
               LATERAL FLATTEN( input => SPLIT( n."body", ' ' ) ) tok
        WHERE  LEN( REGEXP_REPLACE(tok.value::STRING, '[^a-zA-Z]', '') ) > 0
      ) tok
JOIN   "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
       ON tok."token" = wf."word"
JOIN   "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"     gv
       ON tok."token" = gv."word"
LIMIT  20;
```

```sql
--Description: Aggregate those weighted vectors to one (unnormalised) article vector, then normalise to unit length  
WITH article_tokens AS (
     SELECT n."id",
            n."date",
            n."title",
            ARRAY_TRANSFORM( gv."vector",
                             (v, i) -> v / POWER( wf."frequency", 0.4 ) ) AS "w_vec"
     FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
            LATERAL FLATTEN( input => SPLIT( LOWER( REGEXP_REPLACE( n."body", '[^a-zA-Z ]', ' ' ) ), ' ' ) ) t,
            "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf,
            "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
     WHERE  t.value::STRING = wf."word"
       AND  t.value::STRING = gv."word"
),
article_sum AS (
     SELECT "id",
            "date",
            "title",
            ARRAY_AGG( "w_vec" )                                AS "vecs"
     FROM   article_tokens
     GROUP  BY "id", "date", "title"
),
article_vec AS (
     SELECT "id",
            "date",
            "title",
            ARRAY_REDUCE( "vecs",
                          (acc, cur) -> ARRAY_ZIP_WITH(acc, cur, (a, b) -> COALESCE(a,0)+COALESCE(b,0) ) ) AS "raw_vec"
     FROM   article_sum
)
SELECT "id",
       "date",
       "title",
       ARRAY_TRANSFORM( "raw_vec",
                        (x, i) -> x / SQRT( ARRAY_SUM( ARRAY_TRANSFORM( "raw_vec", (y, j) -> y*y ) ) ) ) AS "article_vector_normalised"
FROM   article_vec
LIMIT  20;
```

These ten progressively more complex queries demonstrate how to explore the underlying data, link the three tables, calculate frequency-weighted word vectors for every token, sum them to an article vector, and normalise that vector to unit length.
