tokens AS (
    SELECT
        n."id",
        n."date",
        n."title",
        LOWER(REGEXP_REPLACE(tok.value::STRING,'[^a-zA-Z]','')) AS token
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(INPUT => SPLIT(n."body",' ')) tok
    WHERE LEN(REGEXP_REPLACE(tok.value::STRING,'[^a-zA-Z]','')) > 0
),

/* 3. remove stop-words */
filtered_tokens AS (
    SELECT t.*
    FROM tokens t
    LEFT JOIN stop_words s
           ON t.token = s.word
    WHERE s.word IS NULL
),

/* 4. join word frequencies */
token_freqs AS (
    SELECT ft.*, wf."frequency"
    FROM filtered_tokens ft
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
          ON ft.token = wf."word"
),

/* 5. join GloVe vectors */
token_vectors AS (
    SELECT tf.*, gv."vector"
    FROM token_freqs tf
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
          ON tf.token = gv."word"
),

/* 6. scale vector components */
scaled AS (
    SELECT
        tv."id",
        tv."date",
        tv."title",
        f.index::INT                                AS dim,
        (f.value::FLOAT) /
        POWER(tv."frequency", 0.4)                  AS dim_val
    FROM token_vectors tv,
         LATERAL FLATTEN(INPUT => tv."vector") f
),

/* 7. aggregate to article vectors */
article_vector AS (
    SELECT
        "id",
        MIN("date")  AS "date",
        MIN("title") AS "title",
        dim,
        SUM(dim_val) AS dim_val
    FROM scaled
    GROUP BY "id", dim
