```sql
--Description: 
-- ONE self-contained query that:
-- 1) tokenises every Nature article body into clean lower-case alphabetic tokens;
-- 2) joins each token to its corpus frequency and 300-d GloVe vector;
-- 3) weights the vector by dividing every dimension by frequency^0.4;
-- 4) sums all weighted vectors per article to obtain a single raw article vector;
-- 5) normalises that article vector to unit length;
-- 6) returns id, date, title, and the normalised vector (first 20 articles for a quick look).
WITH tokens AS (  ------------------------------------------------------------------- 1
    SELECT  n."id",
            n."date",
            n."title",
            LOWER(REGEXP_REPLACE(f.value::STRING, '[^a-zA-Z]', '')) AS token
    FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
            LATERAL FLATTEN( INPUT => SPLIT(n."body", ' ') ) f
    WHERE   LEN(REGEXP_REPLACE(f.value::STRING, '[^a-zA-Z]', '')) > 0
), weighted AS ( -------------------------------------------------------------------- 2–3
    SELECT  t."id",
            t."date",
            t."title",
            ARRAY_TRANSFORM(
                gv."vector",
                (val, idx) -> val / POWER(wf."frequency"::FLOAT, 0.4)
            ) AS w_vec
    FROM    tokens t
    JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
      ON    t.token = wf."word"
    JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"     gv
      ON    t.token = gv."word"
), summed AS ( ---------------------------------------------------------------------- 4
    SELECT  "id",
            "date",
            "title",
            ARRAY_REDUCE( ARRAY_AGG(w_vec),
                          (acc, cur) -> ARRAY_ZIP_WITH(
                                             acc, cur,
                                             (a, b) -> COALESCE(a,0) + COALESCE(b,0)
                                         )
                        ) AS raw_vec
    FROM    weighted
    GROUP BY "id","date","title"
), normalised AS ( ------------------------------------------------------------------- 5
    SELECT  "id",
            "date",
            "title",
            raw_vec,
            SQRT( ARRAY_SUM(
                     ARRAY_TRANSFORM(raw_vec, (v,i) -> v*v)
                 ) ) AS magnitude
    FROM    summed
)
SELECT  "id",
        "date",
        "title",
        ARRAY_TRANSFORM(raw_vec, (v,i) -> v / NULLIF(magnitude,0)) 
        AS article_vector_normalised
FROM    normalised
LIMIT   20;
```
