```sql
--Description: 
-- Goal: compute a unit-length semantic vector for each Nature article (sample 20).
-- Thought process:
--   1. Tokenise the article body → alphabetic lower-case tokens (REGEXP_REPLACE + SPLIT).
--   2. Join each token to WORD_FREQUENCIES and GLOVE_VECTORS.
--      • Alias wf.frequency as freq so it can be referenced inside lambdas.
--   3. Weight every GloVe dimension by freq-0.4 via ARRAY_TRANSFORM.
--   4. Sum all weighted vectors belonging to the same article (ARRAY_REDUCE + ARRAY_ZIP_WITH).
--   5. Compute vector magnitude and normalise to unit length.
--   6. Return id, date, title, normalised vector for 20 articles.

WITH tokenised AS (               -- 1 & 2: tokens + freq + vector
    SELECT
        n."id",
        n."date",
        n."title",
        gv."vector"                 AS vec,
        wf."frequency"::FLOAT       AS freq
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"            n,
         LATERAL FLATTEN(
             INPUT => SPLIT(
                         LOWER(REGEXP_REPLACE(n."body", '[^a-zA-Z ]', ' ')),
                         ' '
                     )
         ) t
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES"  wf
         ON t.value::STRING = wf."word"
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"     gv
         ON t.value::STRING = gv."word"
    WHERE LEN(t.value::STRING) > 0
),
weighted AS (                     -- 3: apply frequency weighting
    SELECT
        "id",
        "date",
        "title",
        ARRAY_TRANSFORM(
            vec,
            (v,i) -> v / POWER(freq, 0.4)
        ) AS w_vec
    FROM tokenised
),
summed AS (                        -- 4: sum weighted vectors per article
    SELECT
        "id",
        "date",
        "title",
        ARRAY_REDUCE(
            ARRAY_AGG(w_vec),
            (acc,cur) -> ARRAY_ZIP_WITH(acc,cur,(a,b)->COALESCE(a,0)+COALESCE(b,0))
        ) AS raw_vec
    FROM weighted
    GROUP BY "id","date","title"
),
normalised AS (                    -- 5: magnitude & unit-length vector
    SELECT
        "id",
        "date",
        "title",
        raw_vec,
        SQRT(
            ARRAY_SUM(
                ARRAY_TRANSFORM(raw_vec,(v,i)->v*v)
            )
        ) AS mag
    FROM summed
)
SELECT
    "id",
    "date",
    "title",
    ARRAY_TRANSFORM(raw_vec,(v,i)->v/NULLIF(mag,0)) AS article_vector_normalised
FROM normalised
LIMIT 20;
