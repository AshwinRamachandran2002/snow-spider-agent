Query:
--Description: Join those tokens to the frequency and GloVe tables so we get frequency & vector for each token  
SELECT tok."token",
       wf."frequency",
       POWER( wf."frequency", 0.4 )                            AS "freq_pow_04",
       gv."vector"
FROM  ( /* token list from previous step */
       SELECT LOWER( REGEXP_REPLACE(tok.value::STRING, '[^a-zA-Z]', '') ) AS "token"
       FROM   ( SELECT "id", "body"
                FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
                LIMIT  1 ) n,
              LATERAL FLATTEN( input => SPLIT( n."body", ' ' ) ) tok
       WHERE  LEN( REGEXP_REPLACE(tok.value::STRING, '[^a-zA-Z]', '') ) > 0
     ) tok
JOIN  "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
      ON tok."token" = wf."word"
JOIN  "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"     gv
      ON tok."token" = gv."word"
LIMIT 20;
