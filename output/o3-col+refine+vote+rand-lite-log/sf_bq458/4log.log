--   1) token_data  – split every article body into lower-case alphabetic tokens,
--                    join each token to WORD_FREQUENCIES (alias as freq) and
--                    GLOVE_VECTORS (vec = 300-dim embedding).
--   2) weighted    – weight each embedding dimension by freq-0.4.
--   3) summed      – element-wise sum all weighted vectors that belong to the same
--                    article.
--   4) normalised  – compute magnitude of the summed vector and scale to unit length.
WITH token_data AS (                 /* 1. token → freq + vector */
    SELECT
        n."id",
        n."date",
        n."title",
        gv."vector"           AS vec,
        wf."frequency"::FLOAT AS freq               -- alias for lambda
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"            n,
