```sql
WITH 

-- 1.  simple stop-word list
stop_words(word) AS (
    SELECT column1 FROM VALUES
    ('a'),('an'),('the'),('and'),('or'),('for'),('of'),('in'),('on'),('to'),
    ('with'),('is'),('are'),('was'),('were'),('be'),('been'),('being'),
    ('by'),('at'),('as'),('that'),('this'),('these'),('those'),('it'),
    ('its'),('from'),('which'),('but'),('we'),('they'),('their'),('them'),
    ('he'),('she'),('his'),('her'),('you'),('your'),('i'),('me'),('my'),
    ('mine'),('our'),('ours'),('us'),('not'),('so'),('if'),('out'),
    ('about'),('into'),('up'),('down'),('over'),('after'),('before'),
    ('then'),('once'),('can'),('could'),('should'),('would'),('may'),
    ('might'),('must')
),

-- 2.  tokenise article bodies
tokens AS (
    SELECT
        n."id",
        n."date",
        n."title",
        LOWER(REGEXP_REPLACE(tok.value::STRING,'[^a-zA-Z]','')) AS token
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(INPUT => SPLIT(n."body",' ')) tok
    WHERE LEN(REGEXP_REPLACE(tok.value::STRING,'[^a-zA-Z]','')) > 0
),

-- 3.  remove stop-words
filtered_tokens AS (
    SELECT t.*
    FROM tokens t
    LEFT JOIN stop_words s ON t.token = s.word
    WHERE s.word IS NULL
),

-- 4.  add frequencies
token_freqs AS (
    SELECT ft.*, wf."frequency"
    FROM filtered_tokens ft
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
          ON ft.token = wf."word"
),

-- 5.  add GloVe vectors
token_vectors AS (
    SELECT tf.*, gv."vector"
    FROM token_freqs tf
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
          ON tf.token = gv."word"
),

-- 6.  scale each vector component by 1 / frequency^0.4
scaled AS (
    SELECT
        tv."id",
        tv."date",
        tv."title",
        f."key"::INT                         AS dim,
        (f.value::FLOAT) /
        POWER(tv."frequency",0.4)           AS dim_val
    FROM token_vectors tv,
         LATERAL FLATTEN(INPUT => tv."vector") f
),

-- 7.  sum (element-wise) across all words to build raw article vectors
article_vector AS (
    SELECT
        "id",
        MIN("date")  AS "date",
        MIN("title") AS "title",
        dim,
        SUM(dim_val) AS dim_val
    FROM scaled
    GROUP BY "id", dim
),

-- 8.  compute vector magnitude
magnitude AS (
    SELECT
        "id",
        SQRT(SUM(POWER(dim_val,2))) AS mag
    FROM article_vector
    GROUP BY "id"
),

-- 9.  normalise article vectors to unit length
normalised AS (
    SELECT
        av."id",
        av."date",
        av."title",
        ARRAY_AGG( av.dim_val / NULLIF(mag.mag,0)
                   ORDER BY av.dim )         AS article_vector
    FROM article_vector av
    JOIN magnitude mag ON av."id" = mag."id"
    GROUP BY av."id", av."date", av."title", mag.mag
)

-- 10. final output
SELECT
    "id",
    "date",
    "title",
    article_vector
FROM normalised;
```
