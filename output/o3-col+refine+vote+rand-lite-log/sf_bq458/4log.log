WITH

/* 1. stop-word list */
stop_words(word) AS (
    SELECT column1
    FROM VALUES
        ('a'),('an'),('the'),('and'),('or'),('for'),('of'),('in'),('on'),('to'),
        ('with'),('is'),('are'),('was'),('were'),('be'),('been'),('being'),
        ('by'),('at'),('as'),('that'),('this'),('these'),('those'),('it'),
        ('its'),('from'),('which'),('but'),('we'),('they'),('their'),('them'),
        ('he'),('she'),('his'),('her'),('you'),('your'),('i'),('me'),('my'),
        ('mine'),('our'),('ours'),('us'),('not'),('so'),('if'),('out'),
        ('about'),('into'),('up'),('down'),('over'),('after'),('before'),
        ('then'),('once'),('can'),('could'),('should'),('would'),('may'),
        ('might'),('must')
),

/* 2. tokenise bodies and filter stop-words */
all_tokens AS (
    SELECT
        n."id",
        n."date",
        n."title",
        LOWER(REGEXP_REPLACE(tok.value::STRING,'[^a-zA-Z]','')) AS token
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(INPUT => SPLIT(n."body",' ')) tok
    WHERE LEN(REGEXP_REPLACE(tok.value::STRING,'[^a-zA-Z]','')) > 0
),
tokens_nostop AS (
    SELECT t.*
    FROM all_tokens t
    LEFT JOIN stop_words s ON t.token = s.word
    WHERE s.word IS NULL
),

/* 3. count occurrences of each token within each article */
token_counts AS (
    SELECT
        "id",
        "date",
        "title",
        token,
        COUNT(*) AS tok_cnt
    FROM tokens_nostop
    GROUP BY "id","date","title", token
),

/* 4. join frequencies and GloVe vectors */
token_info AS (
    SELECT
        tc."id",
        tc."date",
        tc."title",
        tc.token,
        tc.tok_cnt,
        wf."frequency",
        gv."vector"
    FROM token_counts tc
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
         ON tc.token = wf."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
         ON tc.token = gv."word"
),

/* 5. scale vectors by  (tok_cnt / freq^0.4)  and explode dimensions */
scaled AS (
    SELECT
        ti."id",
        ti."date",
        ti."title",
        f.index::INT                                          AS dim,
        (f.value::FLOAT) * (ti.tok_cnt / POWER(ti."frequency",0.4)) AS dim_val
    FROM token_info ti,
         LATERAL FLATTEN(INPUT => ti."vector") f
),

/* 6. sum per-article per-dimension */
article_vec AS (
    SELECT
        "id",
        MIN("date")  AS "date",
        MIN("title") AS "title",
        dim,
        SUM(dim_val) AS dim_val
    FROM scaled
    GROUP BY "id", dim
),

/* 7. magnitude per article */
mag AS (
    SELECT "id",
           SQRT(SUM(POWER(dim_val,2))) AS mag
    FROM article_vec
    GROUP BY "id"
),

/* 8. normalise to unit length */
normalised AS (
    SELECT
        av."id",
        av."date",
        av."title",
        ARRAY_AGG( av.dim_val / NULLIF(mag.mag,0)
                   ORDER BY av.dim)                     AS article_vector
    FROM article_vec av
    JOIN mag ON av."id" = mag."id"
    GROUP BY av."id", av."date", av."title"
)

/* 9. final output */
SELECT
    "id",
    "date",
    "title",
    article_vector
FROM normalised;
```
