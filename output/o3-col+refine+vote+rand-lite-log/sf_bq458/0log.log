/* ------------------------------------------------------------
   Build a unit-length (normalized) article vector for every row
   in WORD_VECTORS_US.WORD_VECTORS_US.NATURE
   ------------------------------------------------------------ */
WITH articles AS (   --------------------------------------------------
  SELECT "id",
         "date",
         "title",
         LOWER("body")                   AS body_text
  FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE
),                                                              
tokens AS (      ------------------------------------------------
  /* split the body into tokens and drop simple stop-words       */
  SELECT  a."id",
          a."date",
          a."title",
          t.value::string        AS token
  FROM    articles  a,
          LATERAL TABLE( REGEXP_SPLIT_TO_TABLE(a.body_text,
                         '[^a-z]+') )  t          -- keep letters only
  WHERE   t.value               IS NOT NULL
    AND   t.value <> ''
    AND   t.value NOT IN (      -- very small stop-word list
      'a','an','the','and','or','but','if','in','into','on','onto',
      'with','without','to','from','of','at','by','for','is','are',
      'was','were','be','been','being','this','that','these','those',
      'as','it','its','their','there','here','his','her','hers','our',
      'ours','your','yours','my','mine','they','them','he','she','we',
      'you','i','not','no','nor','so','than','too','very','can',
      'cannot','will','would','could','should','shall','may','might',
      'must','do','does','did','done','have','has','had','having',
      'which','who','whom','whose','what','when','where','why','how',
      'all','any','each','few','more','most','other','some','such',
      'only','own','same'
    )
),                                                              
word_data AS (    ----------------------------------------------
  /* join every remaining token to its frequency and GloVe vec.  */
  SELECT  tok."id",
          tok."date",
          tok."title",
          tok.token,
          wf."frequency",
          gv."vector"
  FROM    tokens tok
  JOIN    WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES  wf
         ON wf."word" = tok.token
  JOIN    WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS     gv
         ON gv."word" = tok.token
),                                                              
weighted_components AS (  --------------------------------------
  /* flatten each vector, apply 1/freq^0.4 weighting, then sum   */
  SELECT  wd."id",
          wd."date",
          wd."title",
          f.index                       AS idx,
          SUM( (f.value::float)
                / POWER(wd."frequency",0.4) )   AS component
  FROM    word_data  wd,
          LATERAL FLATTEN ( INPUT => wd."vector" )  f
  GROUP BY wd."id", wd."date", wd."title", f.index
),                                                              
vector_magnitude AS (  -----------------------------------------
  /* length of each raw article vector                           */
  SELECT  "id",
          SQRT( SUM( POWER(component,2) ) )  AS mag
  FROM    weighted_components
  GROUP BY "id"
),                                                              
normalized_components AS (  ------------------------------------
  /* divide every component by its article’s magnitude           */
  SELECT  wc."id",
          wc."date",
          wc."title",
          wc.idx,
          wc.component / vm.mag        AS norm_comp
  FROM    weighted_components  wc
  JOIN    vector_magnitude     vm
       ON wc."id" = vm."id"
),                                                              
article_vectors AS (  ------------------------------------------
  /* pack the ordered, normalised components back into an array  */
  SELECT  "id",
          "date",
          "title",
          ARRAY_AGG(norm_comp ORDER BY idx)  AS normalized_vector
  FROM    normalized_components
  GROUP BY "id", "date", "title"
)                                                              
SELECT  "id",
        "date",
        "title",
        normalized_vector          AS "article_vector"
FROM    article_vectors
ORDER BY "date" NULLS LAST;
```
