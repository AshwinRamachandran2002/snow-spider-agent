--Description: Tokenise the body of one Nature article, join each token to its
--             corpus frequency and GloVe embedding, and compute a frequency-weighted
--             vector (vector ÷ frequency^0.4) when both pieces of data exist.
--             We avoid earlier lateral-placement and alias-ordering errors by:
--               1) Selecting the article first (alias art).
--               2) CROSS JOIN LATERAL FLATTEN to explode LOWER(art."body") into tokens.
--               3) LEFT JOINing WORD_FREQUENCIES (wf) and GLOVE_VECTORS (gv) on the token.
--               4) Using ARRAY_TRANSFORM for element-wise division of the vector.
SELECT
    art."id",
    art."date",
    tok.value::STRING                                                    AS "token",
    wf."frequency",
    gv."vector",
    CASE
        WHEN gv."vector" IS NOT NULL AND wf."frequency" IS NOT NULL
        THEN ARRAY_TRANSFORM(
                 gv."vector",
                 x -> x::FLOAT / POW(wf."frequency", 0.4)
             )
    END                                                                  AS "weighted_vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE art
CROSS JOIN LATERAL FLATTEN(
    input => SPLIT(LOWER(art."body"), ' ')
) tok
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
       ON wf."word" = tok.value::STRING
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS  gv
       ON gv."word" = tok.value::STRING
WHERE art."id" = '95db4daa-a9f6-4eda-8ce3-c6045d75320f'   -- replace with desired article id
LIMIT 20;
