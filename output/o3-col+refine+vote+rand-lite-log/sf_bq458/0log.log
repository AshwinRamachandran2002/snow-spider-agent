--Description: Tokenise the body of a single Nature article, then enrich every token with its
--             corpus frequency and GloVe vector, computing a frequency-weighted vector per token.
--             Approach:
--               1) Filter NATURE (art) to the chosen article id.
--               2) CROSS JOIN LATERAL FLATTEN on SPLIT(LOWER(art."body"), ' ') to explode the text.
--                  This keeps the LATERAL clause on the right side of the join, avoiding the
--                  “Lateral View cannot be on the left side of join” compilation error.
--               3) LEFT JOIN each emitted token to WORD_FREQUENCIES (wf) and GLOVE_VECTORS (gv).
--               4) When both frequency and vector exist, use ARRAY_TRANSFORM so each element x of
--                  the vector is cast to FLOAT and divided by POW(wf."frequency", 0.4),
--                  yielding a per-token weighted vector.
--               5) LIMIT 20 just to preview a sample of the token rows.
SELECT
    art."id",
    art."date",
    f.value::STRING                                                      AS "token",
    wf."frequency",
    gv."vector",
    CASE
        WHEN gv."vector" IS NOT NULL AND wf."frequency" IS NOT NULL
        THEN ARRAY_TRANSFORM(
                 gv."vector",
                 x -> x::FLOAT / POW(wf."frequency", 0.4)
             )
    END                                                                  AS "weighted_vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE art
CROSS JOIN LATERAL FLATTEN(
    input => SPLIT(LOWER(art."body"), ' ')
) f
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
       ON wf."word" = f.value::STRING
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
       ON gv."word" = f.value::STRING
WHERE art."id" = '95db4daa-a9f6-4eda-8ce3-c6045d75320f'
LIMIT 20;
