-- Description / Thinking process:
-- Goal: produce the weighted GloVe vector for the word “polyamines”.
-- Problem encountered previously: direct division of a VARIANT array by a scalar fails.
-- Solution approach:
--   1. Join WORD_FREQUENCIES (wf) with GLOVE_VECTORS (gv) on "word".
--   2. Use ARRAY_TRANSFORM to iterate over each numeric element (x) of gv."vector".
--   3. Cast x to FLOAT, then divide by POW(wf."frequency", 0.4).
--   4. Return the resulting array as "weighted_vector".
--   5. LIMIT keeps the output manageable (the row count is already 1 here).
SELECT gv."word",
       ARRAY_TRANSFORM(
            gv."vector",
            x -> x::FLOAT / POW(wf."frequency", 0.4)
       ) AS "weighted_vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS    gv
  ON wf."word" = gv."word"
WHERE gv."word" = 'polyamines'
LIMIT 20;
