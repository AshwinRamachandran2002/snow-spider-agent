```sql
--Description: Build and L2-normalise a full-length weighted article vector for each Nature article  
WITH tokenised AS (
    SELECT
        n."id",
        n."date",
        n."title",
        gv."vector"                               AS vec,
        1.0 / POWER(wf."frequency", 0.4)          AS weight
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
             INPUT => SPLIT(
                         REGEXP_REPLACE(LOWER(n."body"), '[^a-z]+', ' '),
                         ' '
                     )
         ) f
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
      ON f.value::STRING = wf."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
      ON f.value::STRING = gv."word"
    WHERE f.value::STRING <> ''
),
summed AS (
    SELECT
        "id",
        "date",
        "title",
        ARRAY_ACCUM( vec * weight ) AS all_vectors   -- component-wise scalar multiplication
    FROM tokenised
    GROUP BY "id", "date", "title"
),
article_vec AS (
    SELECT
        "id",
        "date",
        "title",
        ARRAY_REDUCE(all_vectors, (x, y) -> x + y) AS raw_vector
    FROM summed
)
SELECT
    "id",
    "date",
    "title",
    raw_vector / SQRT(ARRAY_SUM(raw_vector * raw_vector)) AS normalized_vector
FROM article_vec
LIMIT 20;
```
