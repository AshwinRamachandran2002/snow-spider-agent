```sql
--Description: Build a single L2-normalised, frequency-weighted GloVe vector for each Nature article.
-- Conceptual steps placed directly in CTEs:
-- 1. tokenised  :   tokenise every article, join to WORD_FREQUENCIES & GLOVE_VECTORS.
--                   For every token compute its weighted vector (vec * freq^-0.4) with ARRAY_TRANSFORM.
-- 2. gathered   :   ARRAY_AGG all weighted vectors that belong to the same article.
-- 3. summed     :   ARRAY_REDUCE(+ ) to add those vectors element-wise, yielding one raw article vector.
-- 4. normalised :   compute √Σx² and divide each component to give a unit-length vector.
WITH tokenised AS (                 -------------------------------- step-1
    SELECT
        n."id",
        n."date",
        n."title",
        ARRAY_TRANSFORM(
            gv."vector",
            v -> v / POWER(wf."frequency", 0.4)     -- apply weight to every component
        ) AS wvec
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
         , LATERAL FLATTEN(
               INPUT => SPLIT(
                           REGEXP_REPLACE(LOWER(n."body"), '[^a-z]+', ' '),
                           ' '
                       )
           ) f
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
      ON f.value::STRING = wf."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
      ON f.value::STRING = gv."word"
    WHERE f.value::STRING <> ''
),
gathered AS (                    -------------------------------- step-2
    SELECT
        "id",
        "date",
        "title",
        ARRAY_AGG(wvec)  AS vec_list
    FROM tokenised
    GROUP BY "id", "date", "title"
),
summed AS (                       -------------------------------- step-3
    SELECT
        "id",
        "date",
        "title",
        ARRAY_REDUCE(vec_list, (a,b) -> a + b) AS raw_vec
    FROM gathered
),
normalised AS (                   -------------------------------- step-4
    SELECT
        "id",
        "date",
        "title",
        raw_vec,
        SQRT(
            ARRAY_SUM(
                ARRAY_TRANSFORM(raw_vec, x -> x * x)
            )
        ) AS magnitude
    FROM summed
)
SELECT
    "id",
    "date",
    "title",
    ARRAY_TRANSFORM(raw_vec, x -> x / NULLIF(magnitude, 0)) AS normalized_vector
FROM normalised
LIMIT 20;
