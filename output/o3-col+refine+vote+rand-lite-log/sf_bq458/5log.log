```sql
--Description:  Tokenise the first article’s body into individual lowercase words  
SELECT 
  n."id",
  f.value::STRING                                AS "token"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n ,
LATERAL FLATTEN( INPUT => SPLIT( REGEXP_REPLACE( LOWER(n."body"), '[^a-z]+', ' ' ) ) ) f
WHERE n."id" = (
        SELECT MIN("id") FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
      )
LIMIT 20;
```

```sql
--Description:  Join those tokens to the WORD_FREQUENCIES table to get token frequencies  
SELECT 
  tok."token",
  wf."frequency"
FROM (
      SELECT 
        f.value::STRING AS "token"
      FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n ,
      LATERAL FLATTEN( INPUT => SPLIT( REGEXP_REPLACE( LOWER(n."body"), '[^a-z]+', ' ' ) ) ) f
      WHERE n."id" = (
            SELECT MIN("id") FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
          )
     ) tok
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON tok."token" = wf."word"
LIMIT 20;
```

```sql
--Description:  Bring in the GloVe vector for each token that has both a frequency and a vector  
SELECT 
  tok."token",
  wf."frequency",
  gv."vector"                                    AS "glove_vector"
FROM (
      SELECT 
        f.value::STRING AS "token"
      FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n ,
      LATERAL FLATTEN( INPUT => SPLIT( REGEXP_REPLACE( LOWER(n."body"), '[^a-z]+', ' ' ) ) ) f
      WHERE n."id" = (
            SELECT MIN("id") FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
          )
     ) tok
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON tok."token" = wf."word"
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
  ON tok."token" = gv."word"
LIMIT 20;
```

```sql
--Description:  Weight a single vector component (position 0) by frequency^{-0.4} just to illustrate  
SELECT 
  tok."token",
  ( gv."vector"[0]::FLOAT / POWER( wf."frequency", 0.4) )  AS "weighted_comp0"
FROM (
      SELECT 
        f.value::STRING AS "token"
      FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n ,
      LATERAL FLATTEN( INPUT => SPLIT( REGEXP_REPLACE( LOWER(n."body"), '[^a-z]+', ' ' ) ) ) f
      WHERE n."id" = (
            SELECT MIN("id") FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
          )
     ) tok
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON tok."token" = wf."word"
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
  ON tok."token" = gv."word"
LIMIT 20;
```

```sql
--Description:  Sum the weighted vectors for each article (here using only the first 2 components for brevity)  
SELECT 
  n."id",
  SUM( gv."vector"[0]::FLOAT / POWER(wf."frequency", 0.4) )  AS "sum_dim0",
  SUM( gv."vector"[1]::FLOAT / POWER(wf."frequency", 0.4) )  AS "sum_dim1"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
  , LATERAL FLATTEN( INPUT => SPLIT( REGEXP_REPLACE( LOWER(n."body"), '[^a-z]+', ' ' ) ) ) f
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON f.value::STRING = wf."word"
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
  ON f.value::STRING = gv."word"
GROUP BY n."id"
LIMIT 20;
```

```sql
--Description:  Produce the final normalised article-level vectors (full dimensionality) together with id, date, title  
WITH tokenised AS (
     SELECT 
       n."id",
       n."date",
       n."title",
       gv."vector"                      AS vec,
       1.0 / POWER(wf."frequency", 0.4) AS weight
     FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
       , LATERAL FLATTEN( INPUT => SPLIT( REGEXP_REPLACE( LOWER(n."body"), '[^a-z]+', ' ' ) ) ) f
     JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
       ON f.value::STRING = wf."word"
     JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
       ON f.value::STRING = gv."word"
),
summed AS (
     SELECT 
       "id",
       "date",
       "title",
       ARRAY_AGG( vec * weight )        AS all_vectors     -- multiply every component by weight
     FROM tokenised
     GROUP BY "id","date","title"
),
article_vec AS (
     SELECT
       "id",
       "date",
       "title",
       ARRAY_REDUCE( all_vectors , (x,y) -> x + y ) AS raw_vector  -- vector summation
     FROM summed
)
SELECT
  "id",
  "date",
  "title",
  raw_vector / SQRT( ARRAY_SUM( raw_vector * raw_vector ) ) AS normalized_vector  -- L2 normalisation
FROM article_vec
LIMIT 20;
```
