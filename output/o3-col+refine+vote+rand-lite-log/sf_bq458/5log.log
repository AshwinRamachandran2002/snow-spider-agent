```sql
--Description: Tokenise the "body" of the earliest-ID article step by step.
-- Reasoning:
-- 1. Identify the article whose "id" is the lowest (MIN) – this gives us a single row to examine.
-- 2. Force its body text to lowercase for uniformity.
-- 3. Replace every non-alphabetic character with a space via REGEXP_REPLACE, ensuring only a–z remain.
-- 4. Snowflake’s SPLIT function requires an explicit delimiter, so we split on a single space ' '.
-- 5. FLATTEN turns the resulting array into one row per token.
-- 6. Filter out any empty tokens that may appear from consecutive spaces.
-- 7. LIMIT 20 so we just preview a sample.
SELECT
    n."id",
    f.value::STRING AS "token"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
     LATERAL FLATTEN(
         INPUT => SPLIT(
                     REGEXP_REPLACE(LOWER(n."body"), '[^a-z]+', ' '),
                     ' '
                 )
     ) f
WHERE n."id" = (SELECT MIN("id") FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE)
  AND f.value::STRING <> ''
LIMIT 20;
```
