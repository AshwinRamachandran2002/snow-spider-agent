--Description: Create a single unit-length (L2-normalised) frequency-weighted GloVe vector for
-- every Nature article.  Thinking process embedded:
-- 1. tokenised  – tokenise body text, join to WORD_FREQUENCIES and GLOVE_VECTORS, and weight each
--                 GloVe component by frequency-0.4 with ARRAY_TRANSFORM.
-- 2. summed     – gather (ARRAY_AGG) all weighted vectors per article and collapse them to one
--                 vector via ARRAY_REDUCE that performs element-wise addition.
-- 3. normalised – compute vector magnitude (sqrt of sum of squares) and divide each component to
--                 yield a normalised article vector.
WITH tokenised AS (  -- step-1
    SELECT
        n."id",
        n."date",
        n."title",
        ARRAY_TRANSFORM(
            gv."vector",
            v -> v * POWER(wf."frequency"::FLOAT, -0.4)   -- frequency-0.4 weighting
        ) AS wvec
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
         , LATERAL FLATTEN(
               INPUT => SPLIT(
                           REGEXP_REPLACE(LOWER(n."body"), '[^a-z]+', ' '),
                           ' '
                       )
           ) f
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
      ON f.value::STRING = wf."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
      ON f.value::STRING = gv."word"
    WHERE f.value::STRING <> ''
),
summed AS (      -- step-2
    SELECT
        "id",
        "date",
        "title",
        ARRAY_REDUCE( ARRAY_AGG(wvec), (a, b) -> a + b ) AS raw_vec
    FROM tokenised
    GROUP BY "id", "date", "title"
),
normalised AS (  -- step-3
    SELECT
        "id",
        "date",
        "title",
        raw_vec,
        SQRT(
            ARRAY_SUM(
                ARRAY_TRANSFORM(raw_vec, x -> x * x)
            )
        ) AS mag
    FROM summed
)
SELECT
    "id",
    "date",
    "title",
    ARRAY_TRANSFORM(raw_vec, x -> x / NULLIF(mag, 0)) AS normalized_vector
FROM normalised
LIMIT 20;
