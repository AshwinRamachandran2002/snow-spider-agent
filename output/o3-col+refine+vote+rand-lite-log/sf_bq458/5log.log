```sql
--Description: Build a single, unit-length (L2-normalised) weighted GloVe vector for each Nature
-- article.  Main reasoning:
-- 1. Tokenise every article’s body (lower-case, strip non-letters, split on space, FLATTEN).
-- 2. Join the tokens to WORD_FREQUENCIES and GLOVE_VECTORS.
-- 3. Weight each word’s vector by frequency-0.4 using ARRAY_TRANSFORM to multiply every component.
-- 4. ARRAY_AGG all weighted vectors for an article, then ARRAY_REDUCE (+) to sum them element-wise.
-- 5. Compute the magnitude (√ Σ x²) and divide each component to normalise the vector.
WITH tokenised AS (
    SELECT
        n."id",
        n."date",
        n."title",
        gv."vector"                               AS vec,
        1.0 / POWER(wf."frequency", 0.4)          AS weight
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
             INPUT => SPLIT(
                         REGEXP_REPLACE(LOWER(n."body"), '[^a-z]+', ' '),
                         ' '
                     )
         ) f
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
      ON f.value::STRING = wf."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
      ON f.value::STRING = gv."word"
    WHERE f.value::STRING <> ''
),
weighted AS (
    SELECT
        "id",
        "date",
        "title",
        ARRAY_TRANSFORM(vec, x -> x * weight) AS wvec          -- scale each component
    FROM tokenised
),
collected AS (
    SELECT
        "id",
        "date",
        "title",
        ARRAY_AGG(wvec)                         AS vec_array   -- all weighted vectors per article
    FROM weighted
    GROUP BY "id","date","title"
),
summed AS (
    SELECT
        "id",
        "date",
        "title",
        ARRAY_REDUCE(vec_array, (a,b) -> a + b) AS raw_vector  -- element-wise sum
    FROM collected
),
normalised AS (
    SELECT
        "id",
        "date",
        "title",
        raw_vector,
        SQRT(ARRAY_SUM(ARRAY_TRANSFORM(raw_vector, x -> x * x))) AS magnitude
    FROM summed
)
SELECT
    "id",
    "date",
    "title",
    ARRAY_TRANSFORM(raw_vector, x -> x / NULLIF(magnitude,0)) AS normalized_vector
FROM normalised
LIMIT 20;
```
