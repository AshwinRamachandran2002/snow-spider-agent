Query:
--Description: 9) Compact PIVOT version – correct top-5 names & column references
WITH top5 AS (  -- find 2008’s five biggest minor categories
  SELECT minor_category
  FROM (
    SELECT minor_category, SUM(value) AS cnt
    FROM `bigquery-public-data.london_crime.crime_by_lsoa`
    WHERE year = 2008
    GROUP BY minor_category
    ORDER BY cnt DESC
    LIMIT 5
  )
),
base AS (       -- yearly totals for those categories only
  SELECT
    c.year,
    c.minor_category,
    SUM(c.value) AS crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
  JOIN top5 USING (minor_category)
  GROUP BY c.year, c.minor_category
),
totals AS (     -- total crimes all categories per year
  SELECT year, SUM(value) AS total_year
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
)
SELECT
  p.year,
  ROUND(100 * `Other Theft`              / t.total_year, 2) AS pct_other_theft,
  ROUND(100 * `Theft From Motor Vehicle` / t.total_year, 2) AS pct_theft_from_mv,
  ROUND(100 * `Possession Of Drugs`      / t.total_year, 2) AS pct_possession_of_drugs,
  ROUND(100 * `Burglary in a Dwelling`   / t.total_year, 2) AS pct_burglary_dwelling,
  ROUND(100 * `Assault with Injury`      / t.total_year, 2) AS pct_assault_with_injury
FROM (
  SELECT *
  FROM base
  PIVOT (SUM(crimes) FOR minor_category IN ('Other Theft',
                                            'Theft From Motor Vehicle',
                                            'Possession Of Drugs',
                                            'Burglary in a Dwelling',
                                            'Assault with Injury'))
) AS p
JOIN totals t USING (year)
ORDER BY year
