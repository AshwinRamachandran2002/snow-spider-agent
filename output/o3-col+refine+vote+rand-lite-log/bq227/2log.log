Successfully corrected. SQL:
--Description: Produce one row per year showing the % share (rounded to 2 dp) of the
--             five minor-crime categories that were most frequent in 2008.
--             Steps:
--   1. CTE top5 → determine the 5 highest-volume minor categories in 2008.
--   2. CTE yearly_totals → total crimes each year (denominator for %).
--   3. CTE yearly_split → for every year, sum crimes that fall in each
--      of those five categories (using CASE to keep the query dynamic).
--   4. Final SELECT → divide each category count by the year total,
--      multiply by 100, round to 2 dp, and return the percentages.

WITH top5 AS (                       -- Step 1
  SELECT minor_category
  FROM (
    SELECT minor_category, SUM(value) AS cnt
    FROM `bigquery-public-data.london_crime.crime_by_lsoa`
    WHERE year = 2008
    GROUP BY minor_category
    ORDER BY cnt DESC
    LIMIT 5
  )
),
yearly_totals AS (                   -- Step 2
  SELECT year, SUM(value) AS total_year
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
),
yearly_split AS (                    -- Step 3
  SELECT
    year,
    SUM(CASE WHEN minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 0)
             THEN value END) AS cat1,
    SUM(CASE WHEN minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 1)
             THEN value END) AS cat2,
    SUM(CASE WHEN minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 2)
             THEN value END) AS cat3,
    SUM(CASE WHEN minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 3)
             THEN value END) AS cat4,
    SUM(CASE WHEN minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 4)
             THEN value END) AS cat5
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
)
SELECT                               -- Step 4
  y.year,
  ROUND(100 * cat1 / total_year, 2) AS pct_cat1,
  ROUND(100 * cat2 / total_year, 2) AS pct_cat2,
  ROUND(100 * cat3 / total_year, 2) AS pct_cat3,
  ROUND(100 * cat4 / total_year, 2) AS pct_cat4,
  ROUND(100 * cat5 / total_year, 2) AS pct_cat5
FROM yearly_split y
JOIN yearly_totals t USING (year)
ORDER BY year;
