```sql
-- Description: 9) Compact version using PIVOT to produce one-row-per-year with shares
WITH top5 AS (
  SELECT minor_category
  FROM (
    SELECT minor_category, SUM(value) AS cnt
    FROM `bigquery-public-data.london_crime.crime_by_lsoa`
    WHERE year = 2008
    GROUP BY minor_category
    ORDER BY cnt DESC
    LIMIT 5
  )
),
base AS (
  SELECT
    c.year,
    c.minor_category,
    SUM(c.value) AS crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
  JOIN top5 USING (minor_category)
  GROUP BY c.year, c.minor_category
),
totals AS (
  SELECT year, SUM(value) AS total_year
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
)
SELECT
  b.year,
  ROUND(100 * b.`Assault with Injury` / t.total_year, 2) AS pct_assault_with_injury,
  ROUND(100 * b.`Harassment`          / t.total_year, 2) AS pct_harassment,
  ROUND(100 * b.`Common Assault`      / t.total_year, 2) AS pct_common_assault,
  ROUND(100 * b.`Other theft`         / t.total_year, 2) AS pct_other_theft,
  ROUND(100 * b.`Theft From Motor Vehicle` / t.total_year, 2) AS pct_theft_from_mv
FROM (
  SELECT *
  FROM base
  PIVOT (SUM(crimes) FOR minor_category IN ('Assault with Injury',
                                            'Harassment',
                                            'Common Assault',
                                            'Other theft',
                                            'Theft From Motor Vehicle'))
) AS b
JOIN totals t USING (year)
ORDER BY year
LIMIT 20;
```

```sql
-- Description: 10) Final answer using the simple CASE approach (readable & ready for export)
WITH top5 AS (
  SELECT minor_category
  FROM (
    SELECT minor_category, SUM(value) AS cnt
    FROM `bigquery-public-data.london_crime.crime_by_lsoa`
    WHERE year = 2008
    GROUP BY minor_category
    ORDER BY cnt DESC
    LIMIT 5
  )
),
yearly AS (
  SELECT
    year,
    SUM(value) AS total_year,
    SUM(CASE WHEN minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 0) THEN value END) AS cat1,
    SUM(CASE WHEN minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 1) THEN value END) AS cat2,
    SUM(CASE WHEN minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 2) THEN value END) AS cat3,
    SUM(CASE WHEN minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 3) THEN value END) AS cat4,
    SUM(CASE WHEN minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 4) THEN value END) AS cat5
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
)
SELECT
  year,
  ROUND(cat1 * 100 / total_year, 2) AS pct_cat1,
  ROUND(cat2 * 100 / total_year, 2) AS pct_cat2,
  ROUND(cat3 * 100 / total_year, 2) AS pct_cat3,
  ROUND(cat4 * 100 / total_year, 2) AS pct_cat4,
  ROUND(cat5 * 100 / total_year, 2) AS pct_cat5
FROM yearly
ORDER BY year
LIMIT 20;
```
