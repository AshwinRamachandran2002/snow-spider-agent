Query:
-- Description: 7) Annual counts for just the 2008 TOP-5 categories (to build the shares)
WITH top5 AS (
  SELECT minor_category
  FROM (
    SELECT minor_category, SUM(value) AS cnt
    FROM `bigquery-public-data.london_crime.crime_by_lsoa`
    WHERE year = 2008
    GROUP BY minor_category
    ORDER BY cnt DESC
    LIMIT 5
  )
),
yearly_totals AS (
  SELECT year, SUM(value) AS total_year
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
),
yearly_top5 AS (
  SELECT
    c.year,
    c.minor_category,
    SUM(c.value) AS top5_cnt
  FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
  JOIN top5 USING (minor_category)
  GROUP BY c.year, c.minor_category
)
SELECT
  yt.year,
  ROUND(SUM(CASE WHEN minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 0) THEN top5_cnt END) * 100 / total_year, 2) AS pct_cat1,
  ROUND(SUM(CASE WHEN minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 1) THEN top5_cnt END) * 100 / total_year, 2) AS pct_cat2,
  ROUND(SUM(CASE WHEN minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 2) THEN top5_cnt END) * 100 / total_year, 2) AS pct_cat3,
  ROUND(SUM(CASE WHEN minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 3) THEN top5_cnt END) * 100 / total_year, 2) AS pct_cat4,
  ROUND(SUM(CASE WHEN minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 4) THEN top5_cnt END) * 100 / total_year, 2) AS pct_cat5
FROM yearly_top5 yt
JOIN yearly_totals t
  ON yt.year = t.year
GROUP BY yt.year, total_year
ORDER BY yt.year
LIMIT 20;
