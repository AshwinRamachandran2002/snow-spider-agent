```sql
-- 1) Description: Peek at 20 raw crime records to understand the basic columns we will use.
SELECT *
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
LIMIT 20;
```

```sql
-- 2) Description: List every distinct year that exists in the crime table (chronological order).
SELECT DISTINCT year
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
ORDER BY year
LIMIT 20;
```

```sql
-- 3) Description: Show 20 distinct minor crime categories that appear in the data.
SELECT DISTINCT minor_category
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
ORDER BY minor_category
LIMIT 20;
```

```sql
-- 4) Description: Rank minor categories by total crime counts in 2008.
SELECT
  minor_category,
  SUM(value) AS crimes_in_2008
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE year = 2008
GROUP BY minor_category
ORDER BY crimes_in_2008 DESC
LIMIT 20;
```

```sql
-- 5) Description: Isolate the TOP-5 minor categories of 2008. (They will be reused later.)
WITH ranked AS (
  SELECT
    minor_category,
    SUM(value) AS crimes_in_2008
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY crimes_in_2008 DESC
  LIMIT 5
)
SELECT *
FROM ranked
LIMIT 20;
```

```sql
-- 6) Description: Compute the total number of crimes per year (across every category).
SELECT
  year,
  SUM(value) AS total_crimes_year
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
-- 7) Description: For the TOP-5 set, get yearly totals *only* for those categories.
WITH top5 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
)
SELECT
  c.year,
  c.minor_category,
  SUM(c.value) AS top5_crimes_year_cat
FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
JOIN top5 USING (minor_category)
GROUP BY c.year, c.minor_category
ORDER BY c.year, top5_crimes_year_cat DESC
LIMIT 20;
```

```sql
-- 8) Description: Turn the previous result into percentage shares (long format: one row per year & category).
WITH top5 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
),
year_totals AS (
  SELECT year, SUM(value) AS total_year
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
),
year_cat AS (
  SELECT c.year, c.minor_category, SUM(c.value) AS cat_total
  FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
  JOIN top5 USING (minor_category)
  GROUP BY c.year, c.minor_category
)
SELECT
  y.year,
  ycat.minor_category,
  ROUND(100 * ycat.cat_total / y.total_year, 2) AS pct_share
FROM year_cat AS ycat
JOIN year_totals AS y
  ON y.year = ycat.year
ORDER BY y.year, pct_share DESC
LIMIT 20;
```

```sql
-- 9) Description: Aggregate the five percentages into an array so that **each year appears once**.
WITH top5 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
),
year_totals AS (
  SELECT year, SUM(value) AS total_year
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
),
year_cat AS (
  SELECT c.year, c.minor_category, SUM(c.value) AS cat_total
  FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
  JOIN top5 USING (minor_category)
  GROUP BY c.year, c.minor_category
),
pct AS (
  SELECT
    ycat.year,
    ycat.minor_category,
    ROUND(100 * ycat.cat_total / y.total_year, 2) AS pct_share
  FROM year_cat AS ycat
  JOIN year_totals AS y
    ON y.year = ycat.year
)
SELECT
  year,
  ARRAY_AGG(STRUCT(minor_category, pct_share) ORDER BY pct_share DESC) AS top5_pct_shares
FROM pct
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
-- 10) Description (FINAL): Produce the requested answer –
--     the annual percentage shares (rounded to 2 dp) of the 2008 TOP-5 minor categories,
--     returned as one row per year with an ordered array (size 5) of category/percentage pairs.
WITH top5 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
),
year_totals AS (
  SELECT year, SUM(value) AS total_year
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
),
year_cat AS (
  SELECT c.year, c.minor_category, SUM(c.value) AS cat_total
  FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
  JOIN top5 USING (minor_category)
  GROUP BY c.year, c.minor_category
),
pct AS (
  SELECT
    ycat.year,
    ycat.minor_category,
    ROUND(100 * ycat.cat_total / y.total_year, 2) AS pct_share
  FROM year_cat AS ycat
  JOIN year_totals AS y
    ON y.year = ycat.year
)
SELECT
  year,
  ARRAY_AGG(STRUCT(minor_category, pct_share)
            ORDER BY pct_share DESC) AS top5_minor_category_percentages
FROM pct
GROUP BY year
ORDER BY year
LIMIT 20;
```
