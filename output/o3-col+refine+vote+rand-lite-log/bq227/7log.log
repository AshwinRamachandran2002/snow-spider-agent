```sql
--5️⃣ Description: Grab the TOP-5 minor categories in 2008
SELECT
  minor_category,
  SUM(value) AS crimes_2008
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE year = 2008
GROUP BY minor_category
ORDER BY crimes_2008 DESC
LIMIT 5;
```

```sql
--6️⃣ Description: Crimes per year ONLY for the 5 categories found above
--   (sub-query repeats the TOP-5 logic so we don’t hard-code anything)
WITH top5_2008 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
)
SELECT
  c.year,
  c.minor_category,
  SUM(c.value) AS crimes_in_cat
FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
JOIN top5_2008 USING (minor_category)
GROUP BY c.year, c.minor_category
ORDER BY c.year, crimes_in_cat DESC
LIMIT 20;
```

```sql
--7️⃣ Description: Put every TOP-5 category into its own column (pivoted counts)
WITH top5_2008 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
)
SELECT
  year,
  SUM(IF(minor_category = (SELECT minor_category FROM top5_2008 LIMIT 1 OFFSET 0), value, 0)) AS cat1,
  SUM(IF(minor_category = (SELECT minor_category FROM top5_2008 LIMIT 1 OFFSET 1), value, 0)) AS cat2,
  SUM(IF(minor_category = (SELECT minor_category FROM top5_2008 LIMIT 1 OFFSET 2), value, 0)) AS cat3,
  SUM(IF(minor_category = (SELECT minor_category FROM top5_2008 LIMIT 1 OFFSET 3), value, 0)) AS cat4,
  SUM(IF(minor_category = (SELECT minor_category FROM top5_2008 LIMIT 1 OFFSET 4), value, 0)) AS cat5,
  SUM(value) AS total_crimes
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--8️⃣ Description (FINAL ANSWER):
--   Annual % share of each 2008 TOP-5 minor crime category in total London crimes
WITH top5_2008 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
),
labels AS (
  SELECT 
    MIN(CASE WHEN rn = 1 THEN minor_category END) AS cat1,
    MIN(CASE WHEN rn = 2 THEN minor_category END) AS cat2,
    MIN(CASE WHEN rn = 3 THEN minor_category END) AS cat3,
    MIN(CASE WHEN rn = 4 THEN minor_category END) AS cat4,
    MIN(CASE WHEN rn = 5 THEN minor_category END) AS cat5
  FROM (
    SELECT minor_category, ROW_NUMBER() OVER (ORDER BY SUM(value) DESC) AS rn
    FROM `bigquery-public-data.london_crime.crime_by_lsoa`
    WHERE year = 2008
    GROUP BY minor_category
    ORDER BY SUM(value) DESC
    LIMIT 5
  )
)
SELECT
  y.year,
  ROUND(SAFE_DIVIDE(SUM(IF(minor_category = l.cat1, value, 0)), SUM(value))*100, 2) AS `cat1_pct`,
  ROUND(SAFE_DIVIDE(SUM(IF(minor_category = l.cat2, value, 0)), SUM(value))*100, 2) AS `cat2_pct`,
  ROUND(SAFE_DIVIDE(SUM(IF(minor_category = l.cat3, value, 0)), SUM(value))*100, 2) AS `cat3_pct`,
  ROUND(SAFE_DIVIDE(SUM(IF(minor_category = l.cat4, value, 0)), SUM(value))*100, 2) AS `cat4_pct`,
  ROUND(SAFE_DIVIDE(SUM(IF(minor_category = l.cat5, value, 0)), SUM(value))*100, 2) AS `cat5_pct`
FROM `bigquery-public-data.london_crime.crime_by_lsoa`  y
CROSS JOIN labels l
GROUP BY y.year, l.cat1, l.cat2, l.cat3, l.cat4, l.cat5
ORDER BY y.year
LIMIT 20;
```

The last query produces one row per calendar year with the percentage contribution (to two decimal places) of each of the five minor crime categories that were most common in 2008.
