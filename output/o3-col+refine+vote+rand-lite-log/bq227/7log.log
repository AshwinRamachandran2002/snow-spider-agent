Query:
--8️⃣ Description (FINAL ANSWER):
--   Annual % share of each 2008 TOP-5 minor crime category in total London crimes
WITH top5_2008 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
),
labels AS (
  SELECT 
    MIN(CASE WHEN rn = 1 THEN minor_category END) AS cat1,
    MIN(CASE WHEN rn = 2 THEN minor_category END) AS cat2,
    MIN(CASE WHEN rn = 3 THEN minor_category END) AS cat3,
    MIN(CASE WHEN rn = 4 THEN minor_category END) AS cat4,
    MIN(CASE WHEN rn = 5 THEN minor_category END) AS cat5
  FROM (
    SELECT minor_category, ROW_NUMBER() OVER (ORDER BY SUM(value) DESC) AS rn
    FROM `bigquery-public-data.london_crime.crime_by_lsoa`
    WHERE year = 2008
    GROUP BY minor_category
    ORDER BY SUM(value) DESC
    LIMIT 5
  )
)
SELECT
  y.year,
  ROUND(SAFE_DIVIDE(SUM(IF(minor_category = l.cat1, value, 0)), SUM(value))*100, 2) AS `cat1_pct`,
  ROUND(SAFE_DIVIDE(SUM(IF(minor_category = l.cat2, value, 0)), SUM(value))*100, 2) AS `cat2_pct`,
  ROUND(SAFE_DIVIDE(SUM(IF(minor_category = l.cat3, value, 0)), SUM(value))*100, 2) AS `cat3_pct`,
  ROUND(SAFE_DIVIDE(SUM(IF(minor_category = l.cat4, value, 0)), SUM(value))*100, 2) AS `cat4_pct`,
  ROUND(SAFE_DIVIDE(SUM(IF(minor_category = l.cat5, value, 0)), SUM(value))*100, 2) AS `cat5_pct`
FROM `bigquery-public-data.london_crime.crime_by_lsoa`  y
CROSS JOIN labels l
GROUP BY y.year, l.cat1, l.cat2, l.cat3, l.cat4, l.cat5
ORDER BY y.year
LIMIT 20;
