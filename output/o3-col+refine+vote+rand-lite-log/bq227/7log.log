Query:
--6️⃣ Description: Crimes per year ONLY for the 5 categories found above
--   (sub-query repeats the TOP-5 logic so we don’t hard-code anything)
WITH top5_2008 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
)
SELECT
  c.year,
  c.minor_category,
  SUM(c.value) AS crimes_in_cat
FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
JOIN top5_2008 USING (minor_category)
GROUP BY c.year, c.minor_category
ORDER BY c.year, crimes_in_cat DESC
LIMIT 20;
