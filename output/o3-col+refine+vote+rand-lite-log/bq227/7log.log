Query:
--7️⃣ Description: Put every TOP-5 category into its own column (pivoted counts)
WITH top5_2008 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
)
SELECT
  year,
  SUM(IF(minor_category = (SELECT minor_category FROM top5_2008 LIMIT 1 OFFSET 0), value, 0)) AS cat1,
  SUM(IF(minor_category = (SELECT minor_category FROM top5_2008 LIMIT 1 OFFSET 1), value, 0)) AS cat2,
  SUM(IF(minor_category = (SELECT minor_category FROM top5_2008 LIMIT 1 OFFSET 2), value, 0)) AS cat3,
  SUM(IF(minor_category = (SELECT minor_category FROM top5_2008 LIMIT 1 OFFSET 3), value, 0)) AS cat4,
  SUM(IF(minor_category = (SELECT minor_category FROM top5_2008 LIMIT 1 OFFSET 4), value, 0)) AS cat5,
  SUM(value) AS total_crimes
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
GROUP BY year
ORDER BY year
LIMIT 20;
