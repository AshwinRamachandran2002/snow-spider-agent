```sql
--Description:  One-step query that
--   • finds the five highest-volume minor crime categories in 2008,
--   • calculates each year’s total crime count (denominator),
--   • aggregates yearly counts for those five categories only,
--   • and pivots the result so every row is a year showing
--       – the category names in their 2008 rank order
--       – the percentage share each holds of that year’s total crime
--     (rounded to two decimals).
WITH top5 AS (        -- top-5 minor categories based on 2008 volumes
  SELECT ARRAY_AGG(minor_category ORDER BY tot DESC LIMIT 5) AS cats
  FROM (
    SELECT minor_category, SUM(value) AS tot
    FROM `bigquery-public-data.london_crime.crime_by_lsoa`
    WHERE year = 2008
    GROUP BY minor_category
    ORDER BY tot DESC
  )
),
year_tot AS (         -- total crimes per year (all categories)
  SELECT year, SUM(value) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
),
cat_year AS (         -- yearly counts for just those five categories
  SELECT c.year, c.minor_category, SUM(c.value) AS cnt
  FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c, top5
  WHERE c.minor_category IN UNNEST(top5.cats)
  GROUP BY c.year, c.minor_category
)
SELECT
  y.year,
  cats[OFFSET(0)] AS cat1,
  ROUND(100 * SUM(IF(minor_category = cats[OFFSET(0)], cnt, 0)) / y.total_crimes, 2) AS pct_cat1,
  cats[OFFSET(1)] AS cat2,
  ROUND(100 * SUM(IF(minor_category = cats[OFFSET(1)], cnt, 0)) / y.total_crimes, 2) AS pct_cat2,
  cats[OFFSET(2)] AS cat3,
  ROUND(100 * SUM(IF(minor_category = cats[OFFSET(2)], cnt, 0)) / y.total_crimes, 2) AS pct_cat3,
  cats[OFFSET(3)] AS cat4,
  ROUND(100 * SUM(IF(minor_category = cats[OFFSET(3)], cnt, 0)) / y.total_crimes, 2) AS pct_cat4,
  cats[OFFSET(4)] AS cat5,
  ROUND(100 * SUM(IF(minor_category = cats[OFFSET(4)], cnt, 0)) / y.total_crimes, 2) AS pct_cat5
FROM year_tot AS y
JOIN cat_year USING (year), top5
GROUP BY y.year, y.total_crimes, cats
ORDER BY y.year;
