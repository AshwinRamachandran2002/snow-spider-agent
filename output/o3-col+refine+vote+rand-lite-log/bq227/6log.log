Query:
-- 6. Add the ALL-crime yearly denominator so we can see raw shares row-wise
WITH top5 AS (
  SELECT `minor_category`
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE `year` = 2008
  GROUP BY `minor_category`
  ORDER BY SUM(`value`) DESC
  LIMIT 5
),
year_totals AS (
  SELECT `year`, SUM(`value`) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY `year`
)
SELECT
  c.`year`,
  c.`minor_category`,
  ROUND(100 * SUM(c.`value`) / t.total_crimes, 2) AS pct_of_year
FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
JOIN top5               USING (`minor_category`)
JOIN year_totals AS t   USING (`year`)
