2025-05-05 04:14:28 - Thread-2767 (execute) - INFO - [Exploration]
Below is a progressive set of (≤ 10) BigQuery SQL statements that walk from simple exploration to a final answer.  
Each one is preceded by a short description and ends with LIMIT 20 as requested.

```sql
-- 1. List all distinct years that exist in the crime table
SELECT DISTINCT `year`
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
ORDER BY `year`
LIMIT 20;
```

```sql
-- 2. Total number of recorded crimes per year (for a quick overview)
SELECT
  `year`,
  SUM(`value`) AS total_crimes
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
GROUP BY `year`
ORDER BY `year`
LIMIT 20;
```

```sql
-- 3. All minor-crime categories ranked by volume for the base year 2008
SELECT
  `minor_category`,
  SUM(`value`) AS crimes_2008
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE `year` = 2008
GROUP BY `minor_category`
ORDER BY crimes_2008 DESC
LIMIT 20;
```

```sql
-- 4. Grab just the TOP-5 minor categories from 2008 (they will drive everything that follows)
SELECT
  `minor_category`
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE `year` = 2008
GROUP BY `minor_category`
ORDER BY SUM(`value`) DESC
LIMIT 5;          -- (still ≤ 20 rows)
```

```sql
-- 5. Year-by-year crime totals ONLY for those TOP-5 categories
WITH top5 AS (
  SELECT `minor_category`
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE `year` = 2008
  GROUP BY `minor_category`
  ORDER BY SUM(`value`) DESC
  LIMIT 5
)
SELECT
  c.`year`,
  c.`minor_category`,
  SUM(c.`value`) AS crimes_top5
FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
JOIN top5 USING (`minor_category`)
GROUP BY c.`year`, c.`minor_category`
ORDER BY c.`year`, crimes_top5 DESC
LIMIT 20;
```

```sql
-- 6. Add the ALL-crime yearly denominator so we can see raw shares row-wise
WITH top5 AS (
  SELECT `minor_category`
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE `year` = 2008
  GROUP BY `minor_category`
  ORDER BY SUM(`value`) DESC
  LIMIT 5
),
year_totals AS (
  SELECT `year`, SUM(`value`) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY `year`
)
SELECT
  c.`year`,
  c.`minor_category`,
  ROUND(100 * SUM(c.`value`) / t.total_crimes, 2) AS pct_of_year
FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
JOIN top5               USING (`minor_category`)
JOIN year_totals AS t   USING (`year`)
GROUP BY c.`year`, c.`minor_category`, t.total_crimes
ORDER BY c.`year`, pct_of_year DESC
LIMIT 20;
```

```sql
-- 7. Produce an ARRAY holding the exact names of the 2008 TOP-5 minor categories
SELECT
  ARRAY_AGG(`minor_category` ORDER BY tot DESC LIMIT 5) AS top5_array
FROM (
  SELECT `minor_category`, SUM(`value`) AS tot
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE `year` = 2008
  GROUP BY `minor_category`
  ORDER BY tot DESC
)
LIMIT 20;
```

```sql
-- 8. Assemble a helper table: yearly counts for each of the five categories
WITH top5 AS (
  SELECT
    ARRAY_AGG(`minor_category` ORDER BY tot DESC LIMIT 5) AS cats
  FROM (
    SELECT `minor_category`, SUM(`value`) AS tot
    FROM `bigquery-public-data.london_crime.crime_by_lsoa`
    WHERE `year` = 2008
    GROUP BY `minor_category`
    ORDER BY tot DESC
  )
),
main AS (
  SELECT
    c.`year`,
    c.`minor_category`,
    SUM(c.`value`) AS cat_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c,
       top5
  WHERE c.`minor_category` IN UNNEST(top5.cats)
  GROUP BY c.`year`, c.`minor_category`
)
SELECT *
FROM main
ORDER BY `year`, cat_crimes DESC
LIMIT 20;
```

```sql
-- 9. Now compute the 5 percentage columns and keep one row per year
WITH
top5 AS (
  SELECT ARRAY_AGG(`minor_category` ORDER BY tot DESC LIMIT 5) AS cats
  FROM (
    SELECT `minor_category`, SUM(`value`) AS tot
    FROM `bigquery-public-data.london_crime.crime_by_lsoa`
    WHERE `year` = 2008
    GROUP BY `minor_category`
    ORDER BY tot DESC
  )
),
year_tot AS (
  SELECT `year`, SUM(`value`) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY `year`
),
cat_year AS (
  SELECT
    c.`year`,
    c.`minor_category`,
    SUM(c.`value`) AS cnt
  FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c,
       top5
  WHERE c.`minor_category` IN UNNEST(top5.cats)
  GROUP BY c.`year`, c.`minor_category`
)
SELECT
  y.`year`,
  ROUND(100 * SUM(IF(c.`minor_category` = cats[OFFSET(0)], c.cnt, 0)) / y.total_crimes, 2) AS pct_cat1,
  ROUND(100 * SUM(IF(c.`minor_category` = cats[OFFSET(1)], c.cnt, 0)) / y.total_crimes, 2) AS pct_cat2,
  ROUND(100 * SUM(IF(c.`minor_category` = cats[OFFSET(2)], c.cnt, 0)) / y.total_crimes, 2) AS pct_cat3,
  ROUND(100 * SUM(IF(c.`minor_category` = cats[OFFSET(3)], c.cnt, 0)) / y.total_crimes, 2) AS pct_cat4,
  ROUND(100 * SUM(IF(c.`minor_category` = cats[OFFSET(4)], c.cnt, 0)) / y.total_crimes, 2) AS pct_cat5
FROM year_tot AS y
JOIN cat_year AS c   USING (`year`),
     top5
GROUP BY y.`year`, y.total_crimes, cats
ORDER BY y.`year`
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER – show the 5 category names plus their annual %-shares (one line per year)
WITH
top5 AS (
  SELECT
    `minor_category`,
    ROW_NUMBER() OVER (ORDER BY SUM(`value`) DESC) AS rn
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE `year` = 2008
  GROUP BY `minor_category`
  ORDER BY SUM(`value`) DESC
  LIMIT 5
),
pivoted AS (
  SELECT
    c.`year`,
    t1.`minor_category` AS cat1,
    t2.`minor_category` AS cat2,
    t3.`minor_category` AS cat3,
    t4.`minor_category` AS cat4,
    t5.`minor_category` AS cat5,
    ROUND(100 * SUM(IF(c.`minor_category` = t1.`minor_category`, c.`value`, 0)) / SUM(c.`value`) OVER (PARTITION BY c.`year`), 2) AS pct_cat1,
    ROUND(100 * SUM(IF(c.`minor_category` = t2.`minor_category`, c.`value`, 0)) / SUM(c.`value`) OVER (PARTITION BY c.`year`), 2) AS pct_cat2,
    ROUND(100 * SUM(IF(c.`minor_category` = t3.`minor_category`, c.`value`, 0)) / SUM(c.`value`) OVER (PARTITION BY c.`year`), 2) AS pct_cat3,
    ROUND(100 * SUM(IF(c.`minor_category` = t4.`minor_category`, c.`value`, 0)) / SUM(c.`value`) OVER (PARTITION BY c.`year`), 2) AS pct_cat4,
    ROUND(100 * SUM(IF(c.`minor_category` = t5.`minor_category`, c.`value`, 0)) / SUM(c.`value`) OVER (PARTITION BY c.`year`), 2) AS pct_cat5
  FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
  CROSS JOIN (SELECT * FROM top5 WHERE rn = 1) AS t1
  CROSS JOIN (SELECT * FROM top5 WHERE rn = 2) AS t2
  CROSS JOIN (SELECT * FROM top5 WHERE rn = 3) AS t3
  CROSS JOIN (SELECT * FROM top5 WHERE rn = 4) AS t4
  CROSS JOIN (SELECT * FROM top5 WHERE rn = 5) AS t5
  WHERE c.`minor_category` IN (t1.`minor_category`, t2.`minor_category`,
                               t3.`minor_category`, t4.`minor_category`,
                               t5.`minor_category`)
  GROUP BY c.`year`,
           t1.`minor_category`, t2.`minor_category`, t3.`minor_category`,
           t4.`minor_category`, t5.`minor_category`
)
SELECT *
FROM pivoted
ORDER BY `year`
LIMIT 20;
```

The last query returns (for every year in the data) one row that contains  
• the five top-minor-crime categories identified from 2008 and  
• their corresponding shares of total crimes for each subsequent year, rounded to two decimal places.
