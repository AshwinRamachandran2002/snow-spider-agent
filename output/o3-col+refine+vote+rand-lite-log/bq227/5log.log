```sql
--Description: We first identify (manually, from earlier exploration) the five minor-crime
--categories that had the highest counts in 2008:
--   1) Other Theft
--   2) Theft From Motor Vehicle
--   3) Possession Of Drugs
--   4) Burglary in a Dwelling
--   5) Assault with Injury
--The query then:
--  • Builds a one-column table (top5) containing those five strings.
--  • Calculates total crimes per year for the whole of London (city_year).
--  • Filters the crime table to only the five categories, joins to the annual total,
--    aggregates each category’s yearly counts, and converts them to a percentage
--    of the city total, rounded to two decimals (pct_tbl).
--  • Finally, pivots the long-form percentages into wide format by conditional
--    aggregation so we get one row per year and one percentage column per category.
WITH top5 AS (
  SELECT 'Other Theft'              AS cat UNION ALL
  SELECT 'Theft From Motor Vehicle' UNION ALL
  SELECT 'Possession Of Drugs'      UNION ALL
  SELECT 'Burglary in a Dwelling'   UNION ALL
  SELECT 'Assault with Injury'
),
city_year AS (
  SELECT
    `year`,
    SUM(`value`) AS city_total
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY `year`
),
pct_tbl AS (
  SELECT
    c.`year`,
    c.`minor_category`,
    ROUND(100 * SUM(c.`value`) / cy.city_total, 2) AS pct_share
  FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
  JOIN top5 t        ON c.`minor_category` = t.cat           -- keep only the 5 categories
  JOIN city_year cy  USING (`year`)                          -- bring in annual totals
  GROUP BY c.`year`, c.`minor_category`, cy.city_total
)
SELECT
  `year`,
  MAX(CASE WHEN `minor_category` = 'Other Theft'              THEN pct_share END) AS other_theft_pct,
  MAX(CASE WHEN `minor_category` = 'Theft From Motor Vehicle' THEN pct_share END) AS theft_from_mv_pct,
  MAX(CASE WHEN `minor_category` = 'Possession Of Drugs'      THEN pct_share END) AS possession_drugs_pct,
  MAX(CASE WHEN `minor_category` = 'Burglary in a Dwelling'   THEN pct_share END) AS burglary_dwelling_pct,
  MAX(CASE WHEN `minor_category` = 'Assault with Injury'      THEN pct_share END) AS assault_injury_pct
FROM pct_tbl
GROUP BY `year`
ORDER BY `year`;
```
