Below is a possible sequence of SQL statements (≤ 10, each limited to 20 rows) that go from simple exploration to the final result.  
Replace or remove the LIMIT 20 clause when you want the complete, un-truncated results.

```sql
--Description: 1) See the distinct years held in the crime table
SELECT DISTINCT `year`
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
ORDER BY `year`
LIMIT 20;
```

```sql
--Description: 2) Display 20 different minor crime categories
SELECT DISTINCT `minor_category`
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
ORDER BY `minor_category`
LIMIT 20;
```

```sql
--Description: 3) Find total crime counts per minor category in 2008 (top 20)
SELECT `minor_category`,
       SUM(`value`) AS crimes_in_2008
FROM   `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE  `year` = 2008
GROUP  BY `minor_category`
ORDER  BY crimes_in_2008 DESC
LIMIT 20;
```

```sql
--Description: 4) Identify the 5 most-frequent minor categories in 2008
SELECT `minor_category`,
       SUM(`value`) AS crimes_in_2008
FROM   `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE  `year` = 2008
GROUP  BY `minor_category`
ORDER  BY crimes_in_2008 DESC
LIMIT 5;
```

```sql
--Description: 5) Show total annual crime numbers for the whole city
SELECT `year`,
       SUM(`value`) AS total_city_crime
FROM   `bigquery-public-data.london_crime.crime_by_lsoa`
GROUP  BY `year`
ORDER  BY `year`
LIMIT 20;
```

```sql
--Description: 6) Check yearly totals for the top-5 2008 minor categories only
WITH top5_2008 AS (
  SELECT `minor_category`
  FROM   `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE  `year` = 2008
  GROUP  BY `minor_category`
  ORDER  BY SUM(`value`) DESC
  LIMIT 5
)
SELECT c.`year`,
       c.`minor_category`,
       SUM(c.`value`) AS yearly_crime_of_cat
FROM   `bigquery-public-data.london_crime.crime_by_lsoa` AS c
JOIN   top5_2008 USING (`minor_category`)
GROUP  BY c.`year`, c.`minor_category`
ORDER  BY c.`year`, yearly_crime_of_cat DESC
LIMIT 20;
```

```sql
--Description: 7) Combine the city totals with the category totals for % share
WITH top5_2008 AS (
  SELECT `minor_category`
  FROM   `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE  `year` = 2008
  GROUP  BY `minor_category`
  ORDER  BY SUM(`value`) DESC
  LIMIT 5
),
cat_year AS (
  SELECT `year`,
         `minor_category`,
         SUM(`value`) AS cat_year_total
  FROM   `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE  `minor_category` IN (SELECT `minor_category` FROM top5_2008)
  GROUP  BY `year`, `minor_category`
),
city_year AS (
  SELECT `year`,
         SUM(`value`) AS city_year_total
  FROM   `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP  BY `year`
)
SELECT cy.`year`,
       cat.`minor_category`,
       ROUND(100 * cat.cat_year_total / cy.city_year_total, 2) AS pct_share
FROM   cat_year AS cat
JOIN   city_year AS cy USING (`year`)
ORDER  BY cy.`year`, pct_share DESC
LIMIT 20;
```

```sql
--Description: 8) Pivot the category percentages so each year is one row
WITH top5_2008 AS (
  SELECT `minor_category`
  FROM   `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE  `year` = 2008
  GROUP  BY `minor_category`
  ORDER  BY SUM(`value`) DESC
  LIMIT 5
),
cat_year AS (
  SELECT `year`,
         `minor_category`,
         SUM(`value`) AS cat_year_total
  FROM   `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE  `minor_category` IN (SELECT `minor_category` FROM top5_2008)
  GROUP  BY `year`, `minor_category`
),
city_year AS (
  SELECT `year`,
         SUM(`value`) AS city_year_total
  FROM   `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP  BY `year`
),
pct_tbl AS (
  SELECT cy.`year`,
         cat.`minor_category`,
         ROUND(100 * cat.cat_year_total / cy.city_year_total, 2) AS pct_share
  FROM   cat_year AS cat
  JOIN   city_year AS cy USING (`year`)
)
SELECT *
FROM   pct_tbl
PIVOT (
  MAX(pct_share)
  FOR minor_category IN (
    -- the five categories discovered in step 4; substitute actual names after running step 4
    'Category_1', 'Category_2', 'Category_3', 'Category_4', 'Category_5'
  )
)
ORDER BY `year`
LIMIT 20;
```

```sql
--Description: 9) Same as #8 but keeping exact category names dynamically via ARRAY
WITH top5_2008 AS (
  SELECT ARRAY_AGG(`minor_category`) AS cats
  FROM   (
          SELECT `minor_category`
          FROM   `bigquery-public-data.london_crime.crime_by_lsoa`
          WHERE  `year` = 2008
          GROUP  BY `minor_category`
          ORDER  BY SUM(`value`) DESC
          LIMIT 5
        )
),
city_year AS (
  SELECT `year`,
         SUM(`value`) AS city_year_total
  FROM   `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP  BY `year`
),
pct_tbl AS (
  SELECT c.`year`,
         c.`minor_category`,
         ROUND(100 * SUM(c.`value`) / cy.city_year_total, 2) AS pct_share
  FROM   `bigquery-public-data.london_crime.crime_by_lsoa` AS c,
         top5_2008,
         UNNEST(cats) AS topcat
  JOIN   city_year AS cy USING (`year`)
  WHERE  c.`minor_category` = topcat
  GROUP  BY c.`year`, c.`minor_category`, cy.city_year_total
)
SELECT *
FROM   pct_tbl
LIMIT 20;
```

```sql
--Description: 10) FINAL ANSWER – exact annual percentage shares, one row per year
WITH top5_2008 AS (
  SELECT ARRAY_AGG(`minor_category`) AS cats
  FROM   (
          SELECT `minor_category`
          FROM   `bigquery-public-data.london_crime.crime_by_lsoa`
          WHERE  `year` = 2008
          GROUP  BY `minor_category`
          ORDER  BY SUM(`value`) DESC
          LIMIT 5
        )
),
city_year AS (
  SELECT `year`,
         SUM(`value`) AS city_year_total
  FROM   `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP  BY `year`
),
pct_tbl AS (
  SELECT c.`year`,
         c.`minor_category`,
         ROUND(100 * SUM(c.`value`) / cy.city_year_total, 2) AS pct_share
  FROM   `bigquery-public-data.london_crime.crime_by_lsoa` AS c,
         top5_2008,
         UNNEST(cats) AS topcat
  JOIN   city_year AS cy USING (`year`)
  WHERE  c.`minor_category` = topcat
  GROUP  BY c.`year`, c.`minor_category`, cy.city_year_total
)
SELECT *
FROM   pct_tbl
PIVOT (
  MAX(pct_share) FOR minor_category IN UNNEST((SELECT cats FROM top5_2008))
)
ORDER BY `year`
LIMIT 20;
```

Run statement #4 first to note the exact five minor categories, then feed them into the pivot list of query #8 (or use the fully dynamic version #10). Queries are shown with LIMIT 20 for preview; remove it to see all years.
