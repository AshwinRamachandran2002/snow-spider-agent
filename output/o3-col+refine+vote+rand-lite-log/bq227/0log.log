        / t.total_crimes
        , 2) AS `minor_cat_3`,
  ROUND(
        100 * SUM(CASE WHEN y.`minor_category` = (SELECT `minor_category` FROM top5 LIMIT 1 OFFSET 3) THEN y.crimes_in_year END)
