```sql
--Description:
-- Goal: show, for every calendar year (2008-2016), what share of all recorded
-- London crimes was accounted for by the five minor-crime categories that were
-- most numerous in 2008.  One row = one year; five columns = those categories;
-- values = percentage share rounded to 2 dp.
--
-- HOW IT WORKS
-- 1. top5 : find the 5 minor categories with the largest total crime count in 2008.
-- 2. tot_by_year : total crime count (all categories) for every year.
-- 3. cat_by_year : crime count per (year, minor_category) restricted to the Top-5 list.
-- 4. Final SELECT pivots the five categories into separate percentage columns.
WITH top5 AS (
  SELECT minor_category
  FROM (
    SELECT
      minor_category,
      SUM(value) AS crimes_2008
    FROM `bigquery-public-data.london_crime.crime_by_lsoa`
    WHERE year = 2008
    GROUP BY minor_category
    ORDER BY crimes_2008 DESC
    LIMIT 5
  )
),
tot_by_year AS (
  SELECT
    year,
    SUM(value) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
),
cat_by_year AS (
  SELECT
    year,
    minor_category,
    SUM(value) AS crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE minor_category IN (SELECT minor_category FROM top5)
  GROUP BY year, minor_category
)
SELECT
  t.year,
  -- For each of the five categories, divide its annual count by the annual total
  -- and round to 2 decimal places.
  ROUND(100 * SUM(IF(c.minor_category = 'Other Theft',              c.crimes, 0)) / t.total_crimes, 2) AS `Other Theft`,
  ROUND(100 * SUM(IF(c.minor_category = 'Theft From Motor Vehicle', c.crimes, 0)) / t.total_crimes, 2) AS `Theft From Motor Vehicle`,
  ROUND(100 * SUM(IF(c.minor_category = 'Possession Of Drugs',      c.crimes, 0)) / t.total_crimes, 2) AS `Possession Of Drugs`,
  ROUND(100 * SUM(IF(c.minor_category = 'Burglary in a Dwelling',   c.crimes, 0)) / t.total_crimes, 2) AS `Burglary in a Dwelling`,
  ROUND(100 * SUM(IF(c.minor_category = 'Assault with Injury',      c.crimes, 0)) / t.total_crimes, 2) AS `Assault with Injury`
FROM tot_by_year t
LEFT JOIN cat_by_year c
  ON t.year = c.year
GROUP BY t.year
ORDER BY t.year;
```
