    FROM `bigquery-public-data.london_crime.crime_by_lsoa`
    WHERE `year` = 2008
    GROUP BY `minor_category`
  )
  WHERE rk <= 5
),
yearly AS (
  SELECT
    `year`,
    `minor_category`,
    SUM(`value`) AS crimes_in_year
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE `minor_category` IN (SELECT `minor_category` FROM top5)
  GROUP BY `year`, `minor_category`
),
year_tot AS (
  SELECT `year`, SUM(`value`) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY `year`
)
SELECT
  y.`year`,
  ROUND(
        100 * SUM(CASE WHEN y.`minor_category` = (SELECT `minor_category` FROM top5 LIMIT 1 OFFSET 0) THEN y.crimes_in_year END)
