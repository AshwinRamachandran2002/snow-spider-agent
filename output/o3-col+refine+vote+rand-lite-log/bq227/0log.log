Query:
--Description: 5)  Year-by-year crime totals for the 5 minor-crime categories that were the most frequent in 2008
WITH top5 AS (
  -- Pick the five largest 2008 minor-crime categories (no window fn ⇒ simpler)
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
)
SELECT
  year,
  minor_category,
  SUM(value) AS crimes_in_year
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
