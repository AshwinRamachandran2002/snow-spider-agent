```sql
--Description: 4) Isolate the TOP-5 2008 minor categories with a window rank
SELECT
  `minor_category`,
  SUM(`value`) AS crimes_2008,
  DENSE_RANK() OVER (ORDER BY SUM(`value`) DESC) AS rk
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
