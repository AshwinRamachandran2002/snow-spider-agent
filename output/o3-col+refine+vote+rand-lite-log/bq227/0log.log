Query:
--Description: 
-- FINAL report – one row per year showing the % share of each of the five
-- minor-crime categories that were the most numerous in 2008.
-- Fix applied: wrap t.total_crimes in MAX( ) inside the percent calculations, so
-- every non-grouped field in SELECT is aggregated and complies with GROUP BY.
WITH top5 AS (                         -- five biggest minor categories in 2008
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
),
yearly AS (                            -- yearly totals for those five categories
  SELECT
    year,
    minor_category,
    SUM(value) AS crimes_in_year
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE minor_category IN (SELECT minor_category FROM top5)
  GROUP BY year, minor_category
),
year_tot AS (                          -- grand total crimes per year
  SELECT
    year,
    SUM(value) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
)
SELECT
  y.year,
  ROUND(100 * SUM(CASE WHEN y.minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 0)
                       THEN y.crimes_in_year ELSE 0 END) / MAX(t.total_crimes), 2) AS `minor_cat_1_%`,
  ROUND(100 * SUM(CASE WHEN y.minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 1)
                       THEN y.crimes_in_year ELSE 0 END) / MAX(t.total_crimes), 2) AS `minor_cat_2_%`,
  ROUND(100 * SUM(CASE WHEN y.minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 2)
                       THEN y.crimes_in_year ELSE 0 END) / MAX(t.total_crimes), 2) AS `minor_cat_3_%`,
  ROUND(100 * SUM(CASE WHEN y.minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 3)
                       THEN y.crimes_in_year ELSE 0 END) / MAX(t.total_crimes), 2) AS `minor_cat_4_%`,
  ROUND(100 * SUM(CASE WHEN y.minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 4)
                       THEN y.crimes_in_year ELSE 0 END) / MAX(t.total_crimes), 2) AS `minor_cat_5_%`
FROM yearly AS y
JOIN year_tot AS t
  ON y.year = t.year
GROUP BY y.year
ORDER BY y.year
LIMIT 20
