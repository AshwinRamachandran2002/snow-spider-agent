```sql
--Description:
-- Objective:  For each calendar year in the dataset, show the percentage of all
-- London crimes that fell into the five minor-crime categories which were most
-- numerous in 2008.  Percentages are rounded to 2 dp.  Each year appears once.
--
-- Walk-through of the logic
-- 1. top5  – Determine the 5 minor crime categories with the highest crime
--            totals in 2008 (these turn out to be
--            ‘Other Theft’, ‘Theft From Motor Vehicle’, ‘Possession Of Drugs’,
--            ‘Burglary in a Dwelling’, and ‘Assault with Injury’).
-- 2. totals – Total number of crimes (all categories) recorded in each year
--            → denominator for the % calculations.
-- 3. top5_y – Crime count by (year, minor_category) but restricted to the
--            categories in top5 → numerator for each percentage.
-- 4. Final SELECT
--      • LEFT JOIN totals (t) with top5_y (c) on year.
--      • For each of the five categories, conditionally sum its counts,
--        divide by MAX(t.total_crimes) (one value per year) and multiply by 100.
--      • ROUND to 2 decimal places.
WITH top5 AS (
  SELECT minor_category
  FROM (
    SELECT minor_category,
           SUM(value) AS cnt_2008
    FROM `bigquery-public-data.london_crime.crime_by_lsoa`
    WHERE year = 2008
    GROUP BY minor_category
    ORDER BY cnt_2008 DESC
    LIMIT 5
  )
),
totals AS (
  SELECT
    year,
    SUM(value) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
),
top5_y AS (
  SELECT
    year,
    minor_category,
    SUM(value) AS crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE minor_category IN (SELECT minor_category FROM top5)
  GROUP BY year, minor_category
)
SELECT
  t.year,
  ROUND(100 * SUM(IF(c.minor_category = 'Other Theft',              c.crimes, 0)) / MAX(t.total_crimes), 2) AS `Other Theft %`,
  ROUND(100 * SUM(IF(c.minor_category = 'Theft From Motor Vehicle', c.crimes, 0)) / MAX(t.total_crimes), 2) AS `Theft From Motor Vehicle %`,
  ROUND(100 * SUM(IF(c.minor_category = 'Possession Of Drugs',      c.crimes, 0)) / MAX(t.total_crimes), 2) AS `Possession Of Drugs %`,
  ROUND(100 * SUM(IF(c.minor_category = 'Burglary in a Dwelling',   c.crimes, 0)) / MAX(t.total_crimes), 2) AS `Burglary in a Dwelling %`,
  ROUND(100 * SUM(IF(c.minor_category = 'Assault with Injury',      c.crimes, 0)) / MAX(t.total_crimes), 2) AS `Assault with Injury %`
FROM totals AS t
LEFT JOIN top5_y AS c
  ON t.year = c.year
GROUP BY t.year
ORDER BY t.year;
```
