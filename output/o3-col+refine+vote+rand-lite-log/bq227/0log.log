```sql
--Description: 5) Year-by-year crime totals for those TOP-5 minor categories
WITH top5 AS (
  SELECT `minor_category`
  FROM (
    SELECT
      `minor_category`,
      DENSE_RANK() OVER (ORDER BY SUM(`value`) DESC) AS rk
    FROM `bigquery-public-data.london_crime.crime_by_lsoa`
    WHERE `year` = 2008
    GROUP BY `minor_category`
  )
  WHERE rk <= 5
)
SELECT
  `year`,
  `minor_category`,
  SUM(`value`) AS crimes_in_year
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE `minor_category` IN (SELECT `minor_category` FROM top5)
GROUP BY `year`, `minor_category`
ORDER BY `year`, crimes_in_year DESC
LIMIT 20;
```

```sql
--Description: 6) Add total-crime figures to compute % share for each (year, category)
WITH top5 AS (
  SELECT `minor_category`
  FROM (
    SELECT
      `minor_category`,
      DENSE_RANK() OVER (ORDER BY SUM(`value`) DESC) AS rk
    FROM `bigquery-public-data.london_crime.crime_by_lsoa`
    WHERE `year` = 2008
    GROUP BY `minor_category`
  )
  WHERE rk <= 5
),
year_cat AS (
  SELECT
    `year`,
    `minor_category`,
    SUM(`value`) AS crimes_in_year
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE `minor_category` IN (SELECT `minor_category` FROM top5)
  GROUP BY `year`, `minor_category`
),
year_tot AS (
  SELECT
    `year`,
    SUM(`value`) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY `year`
)
SELECT
  yc.`year`,
  yc.`minor_category`,
  ROUND(100 * yc.crimes_in_year / yt.total_crimes, 2) AS percent_share
FROM year_cat yc
JOIN year_tot yt
  ON yc.`year` = yt.`year`
ORDER BY yc.`year`, percent_share DESC
LIMIT 20;
```

