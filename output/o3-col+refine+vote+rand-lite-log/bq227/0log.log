--Description: 5)  Year-by-year crime totals for the 5 minor-crime categories that were the most frequent in 2008
WITH top5 AS (
  -- Pick the five largest 2008 minor-crime categories (no window fn ⇒ simpler)
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
)
SELECT
  year,
  minor_category,
  SUM(value) AS crimes_in_year
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE minor_category IN (SELECT minor_category FROM top5)
GROUP BY year, minor_category
ORDER BY year, crimes_in_year DESC
LIMIT 20;
```

```sql
--Description: 6)  Add total-crime figures to compute the % share of each Top-5 category per year
WITH top5 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
),
year_cat AS (               -- crimes for each (year, category) among the Top-5
  SELECT
    year,
    minor_category,
    SUM(value) AS crimes_in_year
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE minor_category IN (SELECT minor_category FROM top5)
  GROUP BY year, minor_category
),
year_tot AS (               -- all crimes in each year
  SELECT year, SUM(value) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
)
SELECT
  yc.year,
  yc.minor_category,
  ROUND(100 * yc.crimes_in_year / MAX(yt.total_crimes), 2) AS percent_share
FROM year_cat  AS yc
JOIN year_tot  AS yt
  ON yc.year = yt.year
GROUP BY yc.year, yc.minor_category
ORDER BY yc.year, percent_share DESC
LIMIT 20;
