  ROUND(100 * SUM(CASE WHEN y.minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 1) THEN y.crimes_in_year ELSE 0 END) / MAX(t.total_crimes), 2) AS `minor_cat_2_%`,
  ROUND(100 * SUM(CASE WHEN y.minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 2) THEN y.crimes_in_year ELSE 0 END) / MAX(t.total_crimes), 2) AS `minor_cat_3_%`,
  ROUND(100 * SUM(CASE WHEN y.minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 3) THEN y.crimes_in_year ELSE 0 END) / MAX(t.total_crimes), 2) AS `minor_cat_4_%`,
  ROUND(100 * SUM(CASE WHEN y.minor_category = (SELECT minor_category FROM top5 LIMIT 1 OFFSET 4) THEN y.crimes_in_year ELSE 0 END) / MAX(t.total_crimes), 2) AS `minor_cat_5_%`
FROM yearly AS y
JOIN year_tot AS t
