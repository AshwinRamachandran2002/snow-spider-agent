Query:
--Description: Final result – wide table showing annual percentage shares of the 2008 top-5 minor categories (one row per year)
WITH top5 AS (                       -- top 5 minor categories in 2008
  SELECT `minor_category`
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE `year` = 2008
  GROUP BY `minor_category`
  ORDER BY SUM(`value`) DESC
  LIMIT 5
),
top5_list AS (                       -- keep an ordered array of those 5 categories
  SELECT ARRAY_AGG(`minor_category` ORDER BY total DESC) AS cats
  FROM (
    SELECT `minor_category`, SUM(`value`) AS total
    FROM `bigquery-public-data.london_crime.crime_by_lsoa`
    WHERE `year` = 2008
    GROUP BY `minor_category`
    ORDER BY total DESC
    LIMIT 5
  )
),
year_tot AS (                        -- yearly totals across ALL crimes
  SELECT `year`, SUM(`value`) AS year_total
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY `year`
),
cat_tot AS (                         -- yearly totals for each of the top-5 categories
  SELECT `year`, `minor_category`, SUM(`value`) AS cat_total
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE `minor_category` IN (SELECT `minor_category` FROM top5)
  GROUP BY `year`, `minor_category`
)
SELECT
  yt.`year`,
  ROUND(100 * SUM(IF(ct.`minor_category` = (SELECT cats[OFFSET(0)] FROM top5_list), ct.cat_total, 0)) / yt.year_total, 2) AS pct_cat1,
  ROUND(100 * SUM(IF(ct.`minor_category` = (SELECT cats[OFFSET(1)] FROM top5_list), ct.cat_total, 0)) / yt.year_total, 2) AS pct_cat2,
  ROUND(100 * SUM(IF(ct.`minor_category` = (SELECT cats[OFFSET(2)] FROM top5_list), ct.cat_total, 0)) / yt.year_total, 2) AS pct_cat3,
  ROUND(100 * SUM(IF(ct.`minor_category` = (SELECT cats[OFFSET(3)] FROM top5_list), ct.cat_total, 0)) / yt.year_total, 2) AS pct_cat4,
  ROUND(100 * SUM(IF(ct.`minor_category` = (SELECT cats[OFFSET(4)] FROM top5_list), ct.cat_total, 0)) / yt.year_total, 2) AS pct_cat5
FROM year_tot AS yt
LEFT JOIN cat_tot AS ct
  ON yt.`year` = ct.`year`
GROUP BY yt.`year`, yt.year_total
ORDER BY yt.`year`
LIMIT 20;
