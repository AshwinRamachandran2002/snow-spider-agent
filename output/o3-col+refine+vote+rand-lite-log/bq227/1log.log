Query:
--Description: Long-format percentage share of each top-5 category within its year
WITH top5 AS (
  SELECT `minor_category`
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE `year` = 2008
  GROUP BY `minor_category`
  ORDER BY SUM(`value`) DESC
  LIMIT 5
),
year_tot AS (
  SELECT `year`, SUM(`value`) AS year_total
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY `year`
)
SELECT
  c.`year`,
  c.`minor_category`,
  ROUND(100 * SUM(c.`value`) / yt.year_total, 2) AS pct_share
FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
JOIN year_tot AS yt
  ON c.`year` = yt.`year`
WHERE c.`minor_category` IN (SELECT `minor_category` FROM top5)
GROUP BY c.`year`, c.`minor_category`, yt.year_total
ORDER BY c.`year`, pct_share DESC
LIMIT 20;
Answer:
