       SUM(value) AS all_crimes
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--Description: 7) Aggregate the five categories together per year
WITH top5_2008 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
)
SELECT year,
       SUM(value) AS top5_crimes
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE minor_category IN (SELECT minor_category FROM top5_2008)
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--Description: 8) Join totals & compute the annual percentage share of the 2008 top-5; round to 2 dp
WITH top5_2008 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
),
top5_per_year AS (
  SELECT year,
         SUM(value) AS top5_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE minor_category IN (SELECT minor_category FROM top5_2008)
  GROUP BY year
),
all_per_year AS (
  SELECT year,
         SUM(value) AS all_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
)
SELECT a.year,
       ROUND( (t.top5_crimes * 100.0) / a.all_crimes , 2) AS pct_share_top5_2008
FROM all_per_year AS a
JOIN top5_per_year AS t
ON a.year = t.year
ORDER BY a.year
LIMIT 20;
-- Each row now shows:  year | percentage share of 2008’s top-5 categories in that year’s total crimes
```


