```

```sql
--Description: 5) Total annual crimes for only those 5 categories
WITH top5_2008 AS (
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
)
SELECT year,
       minor_category,
       SUM(value) AS crimes_in_top5
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE minor_category IN (SELECT minor_category FROM top5_2008)
GROUP BY year, minor_category
ORDER BY year, crimes_in_top5 DESC
LIMIT 20;
```

```sql
--Description: 6) Grand total of ALL recorded crimes for every year
