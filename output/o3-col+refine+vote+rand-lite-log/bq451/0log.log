```sql
-- 1. Peek at chromosome-X variants that pass the region mask
SELECT reference_name, start, end, reference_bases, alternate_bases
FROM   `spider2-public-data.1000_genomes.variants`
WHERE  reference_name = 'X'
  AND  NOT ( (start BETWEEN 59999     AND 2699519)      -- PAR-1
          OR (start BETWEEN 154931042 AND 155260559) )  -- PAR-2
LIMIT  20;
```

```sql
-- 2. Inspect a few genotype calls (one row per call_set / sample)
SELECT v.start,
       c.call_set_name AS sample_id,
       c.genotype
FROM   `spider2-public-data.1000_genomes.variants` AS v
CROSS  JOIN UNNEST(v.call) AS c
WHERE  v.reference_name = 'X'
  AND  NOT ( (v.start BETWEEN 59999     AND 2699519)
          OR (v.start BETWEEN 154931042 AND 155260559) )
LIMIT  20;
```

```sql
-- 3. Check genotype array length distribution
SELECT ARRAY_LENGTH(c.genotype) AS allele_count,
       COUNT(*)                 AS n_calls
FROM   `spider2-public-data.1000_genomes.variants` AS v
CROSS  JOIN UNNEST(v.call) AS c
WHERE  v.reference_name = 'X'
  AND  NOT ( (v.start BETWEEN 59999     AND 2699519)
          OR (v.start BETWEEN 154931042 AND 155260559) )
  AND  ARRAY_LENGTH(c.genotype) > 0
GROUP  BY allele_count
ORDER  BY allele_count
LIMIT  20;
```

```sql
-- 4. Classify each genotype call into homo-ref / homo-alt / het
SELECT c.call_set_name                                 AS sample_id,
       CASE
         WHEN ( (ARRAY_LENGTH(c.genotype)=2
                 AND c.genotype[OFFSET(0)] = 0
                 AND c.genotype[OFFSET(1)] = 0)
              OR (ARRAY_LENGTH(c.genotype)=1
                 AND c.genotype[OFFSET(0)] = 0) )
              THEN 'homo_ref'
         WHEN ( (ARRAY_LENGTH(c.genotype)=2
                 AND c.genotype[OFFSET(0)] = c.genotype[OFFSET(1)]
                 AND c.genotype[OFFSET(0)] > 0)
              OR (ARRAY_LENGTH(c.genotype)=1
                 AND c.genotype[OFFSET(0)] > 0) )
              THEN 'homo_alt'
         ELSE 'het'
       END                                            AS category
FROM   `spider2-public-data.1000_genomes.variants` AS v
CROSS  JOIN UNNEST(v.call) AS c
WHERE  v.reference_name = 'X'
  AND  NOT ( (v.start BETWEEN 59999     AND 2699519)
          OR (v.start BETWEEN 154931042 AND 155260559) )
  AND  ARRAY_LENGTH(c.genotype) > 0
LIMIT  20;
```

```sql
-- 5. Count genotype categories per sample (callable sites on chr-X SNPs)
WITH classified AS (
  SELECT c.call_set_name AS sample_id,
         CASE
           WHEN ( (ARRAY_LENGTH(c.genotype)=2
                   AND c.genotype[OFFSET(0)] = 0
                   AND c.genotype[OFFSET(1)] = 0)
                OR (ARRAY_LENGTH(c.genotype)=1
                   AND c.genotype[OFFSET(0)] = 0) )
                THEN 'homo_ref'
           WHEN ( (ARRAY_LENGTH(c.genotype)=2
                   AND c.genotype[OFFSET(0)] = c.genotype[OFFSET(1)]
                   AND c.genotype[OFFSET(0)] > 0)
                OR (ARRAY_LENGTH(c.genotype)=1
                   AND c.genotype[OFFSET(0)] > 0) )
                THEN 'homo_alt'
           ELSE 'het'
         END AS category
  FROM   `spider2-public-data.1000_genomes.variants` AS v
  CROSS  JOIN UNNEST(v.call) AS c
  WHERE  v.reference_name = 'X'
    AND  NOT ( (v.start BETWEEN 59999     AND 2699519)
            OR (v.start BETWEEN 154931042 AND 155260559) )
    AND  ARRAY_LENGTH(c.genotype) > 0
)
SELECT sample_id,
       SUM(category = 'homo_ref') AS n_hom_ref,
       SUM(category = 'homo_alt') AS n_hom_alt,
       SUM(category = 'het')      AS n_het,
       COUNT(*)                   AS n_callable
FROM   classified
GROUP  BY sample_id
LIMIT  20;
```

```sql
-- 6. Add SNV count (het + hom-alt)
WITH per_sample AS (
  SELECT sample_id,
         SUM(category = 'homo_ref') AS n_hom_ref,
         SUM(category = 'homo_alt') AS n_hom_alt,
         SUM(category = 'het')      AS n_het,
         COUNT(*)                   AS n_callable
  FROM (
     SELECT c.call_set_name AS sample_id,
            CASE
              WHEN ( (ARRAY_LENGTH(c.genotype)=2
                      AND c.genotype[OFFSET(0)] = 0
                      AND c.genotype[OFFSET(1)] = 0)
                   OR (ARRAY_LENGTH(c.genotype)=1
                      AND c.genotype[OFFSET(0)] = 0) )
                   THEN 'homo_ref'
              WHEN ( (ARRAY_LENGTH(c.genotype)=2
                      AND c.genotype[OFFSET(0)] = c.genotype[OFFSET(1)]
                      AND c.genotype[OFFSET(0)] > 0)
                   OR (ARRAY_LENGTH(c.genotype)=1
                      AND c.genotype[OFFSET(0)] > 0) )
                   THEN 'homo_alt'
              ELSE 'het'
            END AS category
     FROM   `spider2-public-data.1000_genomes.variants` AS v
     CROSS  JOIN UNNEST(v.call) AS c
     WHERE  v.reference_name = 'X'
       AND  NOT ( (v.start BETWEEN 59999     AND 2699519)
               OR (v.start BETWEEN 154931042 AND 155260559) )
       AND  ARRAY_LENGTH(c.genotype) > 0
  )
  GROUP  BY sample_id
)
SELECT *,
       (n_het + n_hom_alt) AS n_snv
FROM   per_sample
LIMIT  20;
```

```sql
-- 7. Compute heterozygous and homo-alt percentages among SNVs
WITH per_sample AS (
  SELECT sample_id,
         SUM(category = 'homo_ref') AS n_hom_ref,
         SUM(category = 'homo_alt') AS n_hom_alt,
         SUM(category = 'het')      AS n_het,
         COUNT(*)                   AS n_callable
  FROM (
     SELECT c.call_set_name AS sample_id,
            CASE
              WHEN ( (ARRAY_LENGTH(c.genotype)=2
                      AND c.genotype[OFFSET(0)] = 0
                      AND c.genotype[OFFSET(1)] = 0)
                   OR (ARRAY_LENGTH(c.genotype)=1
                      AND c.genotype[OFFSET(0)] = 0) )
                   THEN 'homo_ref'
              WHEN ( (ARRAY_LENGTH(c.genotype)=2
                      AND c.genotype[OFFSET(0)] = c.genotype[OFFSET(1)]
                      AND c.genotype[OFFSET(0)] > 0)
                   OR (ARRAY_LENGTH(c.genotype)=1
                      AND c.genotype[OFFSET(0)] > 0) )
                   THEN 'homo_alt'
              ELSE 'het'
            END AS category
     FROM   `spider2-public-data.1000_genomes.variants` AS v
     CROSS  JOIN UNNEST(v.call) AS c
     WHERE  v.reference_name = 'X'
       AND  NOT ( (v.start BETWEEN 59999     AND 2699519)
               OR (v.start BETWEEN 154931042 AND 155260559) )
       AND  ARRAY_LENGTH(c.genotype) > 0
  )
  GROUP  BY sample_id
)
SELECT sample_id,
       n_callable,
       n_hom_ref,
       n_hom_alt,
       n_het,
       (n_hom_alt + n_het)                                               AS n_snv,
       SAFE_DIVIDE(n_het     , n_hom_alt + n_het) * 100.0 AS pct_het_snv,
       SAFE_DIVIDE(n_hom_alt , n_hom_alt + n_het) * 100.0 AS pct_homalt_snv
FROM   per_sample
LIMIT  20;
```

```sql
-- 8. FINAL RESULT: order by heterozygous-SNV percentage desc, then sample_id
WITH classified AS (
  SELECT c.call_set_name AS sample_id,
         CASE
           WHEN ( (ARRAY_LENGTH(c.genotype)=2
                   AND c.genotype[OFFSET(0)] = 0
                   AND c.genotype[OFFSET(1)] = 0)
                OR (ARRAY_LENGTH(c.genotype)=1
                   AND c.genotype[OFFSET(0)] = 0) )
                THEN 'homo_ref'
           WHEN ( (ARRAY_LENGTH(c.genotype)=2
                   AND c.genotype[OFFSET(0)] = c.genotype[OFFSET(1)]
                   AND c.genotype[OFFSET(0)] > 0)
                OR (ARRAY_LENGTH(c.genotype)=1
                   AND c.genotype[OFFSET(0)] > 0) )
                THEN 'homo_alt'
           ELSE 'het'
         END AS category
  FROM   `spider2-public-data.1000_genomes.variants` AS v
  CROSS  JOIN UNNEST(v.call) AS c
  WHERE  v.reference_name = 'X'
    AND  NOT ( (v.start BETWEEN 59999     AND 2699519)
            OR (v.start BETWEEN 154931042 AND 155260559) )
    AND  ARRAY_LENGTH(c.genotype) > 0
),
per_sample AS (
  SELECT sample_id,
         SUM(category = 'homo_ref') AS n_hom_ref,
         SUM(category = 'homo_alt') AS n_hom_alt,
         SUM(category = 'het')      AS n_het,
         COUNT(*)                   AS n_callable
  FROM   classified
  GROUP  BY sample_id
)
SELECT sample_id,
       n_callable,
       n_hom_ref,
       n_hom_alt,
       n_het,
       (n_hom_alt + n_het)                                             AS n_snv,
       SAFE_DIVIDE(n_het    , n_hom_alt + n_het) * 100.0 AS pct_het_snv,
       SAFE_DIVIDE(n_hom_alt, n_hom_alt + n_het) * 100.0 AS pct_homalt_snv
FROM   per_sample
ORDER  BY pct_het_snv DESC, sample_id
LIMIT  20;
```

Each successive query builds understanding—from inspecting variants and genotypes, through classification logic, to the final per-sample summary sorted by heterozygous-SNV percentage.
