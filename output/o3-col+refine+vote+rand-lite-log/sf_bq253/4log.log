```sql
WITH q1095 AS (          -- geometry of the multipolygon tagged wikidata = Q1095
    SELECT TO_GEOGRAPHY("geometry") AS geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf ,
         LATERAL FLATTEN (INPUT => pf."all_tags") tag
    WHERE tag.value:"key"::STRING  = 'wikidata'
      AND tag.value:"value"::STRING = 'Q1095'
    LIMIT 1
),

/* every way-feature with a flag telling whether that feature itself carries a wikidata tag */
features_flag AS (
    SELECT
        pf."osm_way_id"                                          AS way_id ,
        TO_GEOGRAPHY(pf."geometry")                              AS geom ,
        MAX( IFF( t.value:"key"::STRING = 'wikidata', 1, 0 ) )   AS has_wikidata
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf ,
         LATERAL FLATTEN (INPUT => pf."all_tags") t
    WHERE pf."osm_way_id" IS NOT NULL
    GROUP BY pf."osm_way_id" , pf."geometry"
),

/* relations that have a name, possess NO wikidata tag themselves */
relations_named_no_wd AS (
    SELECT
        pr."id"                                           AS relation_id ,
        name_tag.value:"value"::STRING                    AS relation_name
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_RELATIONS pr ,
         LATERAL FLATTEN (INPUT => pr."all_tags") name_tag
    WHERE name_tag.value:"key"::STRING = 'name'
      AND NOT EXISTS (      -- ensure the relation itself has no wikidata tag
            SELECT 1
            FROM LATERAL FLATTEN (INPUT => pr."all_tags") wd
            WHERE wd.value:"key"::STRING = 'wikidata'
      )
),

/* members (ways only) of the above relations */
relation_members AS (
    SELECT
        rn.relation_id ,
        rn.relation_name ,
        mem.value:"id"::NUMBER AS way_id
    FROM relations_named_no_wd      rn
    JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_RELATIONS pr
         ON pr."id" = rn.relation_id ,
         LATERAL FLATTEN (INPUT => pr."members") mem
    WHERE mem.value:"type"::STRING = 'w'          -- keep member-type = way
),

/* count how many of each relation’s member-features lie inside the Q1095 polygon */
counts AS (
    SELECT
        rm.relation_id ,
        rm.relation_name ,
        COUNT( DISTINCT ff.way_id )                       AS inside_cnt ,
        MAX( ff.has_wikidata )                            AS has_any_wikidata_feature
    FROM relation_members rm
    JOIN features_flag ff
         ON ff.way_id = rm.way_id
    CROSS JOIN q1095
    WHERE ST_INTERSECTS( ff.geom , q1095.geom )
    GROUP BY rm.relation_id , rm.relation_name
)

/* relation whose area contains the most features and meets all conditions */
SELECT relation_name
FROM counts
WHERE has_any_wikidata_feature = 1          -- at least one included feature has a wikidata tag
ORDER BY inside_cnt DESC NULLS LAST
LIMIT 1;
```
