    AND ARRAY_SIZE(
          FILTER(
             FLATTEN(input => feats."all_tags"),
             t2 -> t2.value:"key"::STRING = 'wikidata'
          )
        ) > 0                       -- at least one contained feature HAS wikidata
   GROUP BY
        rels."relation_id",
        f_tag.value
   ORDER BY
        "wikidata_feature_count" DESC
   LIMIT 20
) r1;
