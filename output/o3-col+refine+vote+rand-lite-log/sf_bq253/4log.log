```sql
--Description: For each such relation, count intersecting features that HAVE a wikidata tag
WITH named_relations AS (                    -- relations without wikidata, intersecting Q1095, possessing a name
     WITH q1095 AS (
          SELECT TO_GEOGRAPHY(p."geometry") AS geom
          FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p,
               LATERAL FLATTEN(input => p."all_tags") t
          WHERE t.value:"key"::STRING = 'wikidata'
            AND t.value:"value"::STRING = 'Q1095'
          LIMIT 1
     )
     SELECT pf."osm_id"  AS relation_id,
            GET_PATH(tag.value,'value')::STRING AS relation_name,
            pf."geometry"
     FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf
     JOIN q1095
       ON ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), q1095.geom )
     CROSS JOIN LATERAL FLATTEN(input => pf."all_tags") tag
     WHERE pf."feature_type" = 'multipolygons'
       AND tag.value:"key"::STRING = 'name'
       AND NOT EXISTS (
             SELECT 1
             FROM LATERAL FLATTEN(input => pf."all_tags") w
             WHERE w.value:"key"::STRING = 'wikidata'
       )
)
SELECT
    nr.relation_id,
    nr.relation_name,
    COUNT( DISTINCT COALESCE(f."osm_id", f."osm_way_id") ) AS wikidata_feature_count
FROM named_relations nr
JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f
  ON ST_INTERSECTS( TO_GEOGRAPHY(f."geometry"), TO_GEOGRAPHY(nr."geometry") )
CROSS JOIN LATERAL FLATTEN(input => f."all_tags") t2
WHERE t2.value:"key"::STRING = 'wikidata'
GROUP BY
    nr.relation_id,
    nr.relation_name
ORDER BY
    wikidata_feature_count DESC
LIMIT 20;
```

```sql
--Description: Restrict counted relations to those whose geometry intersects Q1095 (sanity-check + ordering)
WITH q1095 AS (
     SELECT TO_GEOGRAPHY(p."geometry") AS geom
     FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p,
          LATERAL FLATTEN(input => p."all_tags") t
     WHERE t.value:"key"::STRING = 'wikidata'
       AND t.value:"value"::STRING = 'Q1095'
     LIMIT 1
), rel_counts AS (      -- counts from previous query logic
     SELECT
         nr.relation_id,
         nr.relation_name,
         nr."geometry",
         COUNT( DISTINCT COALESCE(f."osm_id", f."osm_way_id") ) AS wikidata_feature_count
     FROM (
            SELECT pf."osm_id" AS relation_id,
                   GET_PATH(tag.value,'value')::STRING AS relation_name,
                   pf."geometry"
            FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
                 LATERAL FLATTEN(input => pf."all_tags") tag
            WHERE pf."feature_type" = 'multipolygons'
              AND tag.value:"key"::STRING = 'name'
              AND NOT EXISTS (
                     SELECT 1
                     FROM LATERAL FLATTEN(input => pf."all_tags") w
                     WHERE w.value:"key"::STRING = 'wikidata'
              )
         ) nr
     JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f
       ON ST_INTERSECTS( TO_GEOGRAPHY(f."geometry"), TO_GEOGRAPHY(nr."geometry") )
     CROSS JOIN LATERAL FLATTEN(input => f."all_tags") t2
     WHERE t2.value:"key"::STRING = 'wikidata'
     GROUP BY nr.relation_id, nr.relation_name, nr."geometry"
)
SELECT
    rc.relation_id,
    rc.relation_name,
    rc.wikidata_feature_count
FROM rel_counts rc
JOIN q1095
  ON ST_INTERSECTS( TO_GEOGRAPHY(rc."geometry"), q1095.geom )
ORDER BY rc.wikidata_feature_count DESC
LIMIT 20;
```

```sql
--Description: Show all tags for the top-ranked relation (most wikidata-tagged features)
WITH ranked AS (
     SELECT rels.relation_id,
            rels.relation_name,
            rels."geometry",
            COUNT( DISTINCT COALESCE(f."osm_id", f."osm_way_id") ) AS w_cnt
     FROM (
            SELECT pf."osm_id" AS relation_id,
                   GET_PATH(tag.value,'value')::STRING AS relation_name,
                   pf."geometry"
            FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
                 LATERAL FLATTEN(input => pf."all_tags") tag
            WHERE pf."feature_type" = 'multipolygons'
              AND tag.value:"key"::STRING = 'name'
              AND NOT EXISTS (
                     SELECT 1
                     FROM LATERAL FLATTEN(input => pf."all_tags") w
                     WHERE w.value:"key"::STRING = 'wikidata'
              )
         ) rels
     JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f
       ON ST_INTERSECTS( TO_GEOGRAPHY(f."geometry"), TO_GEOGRAPHY(rels."geometry") )
     CROSS JOIN LATERAL FLATTEN(input => f."all_tags") t2
     WHERE t2.value:"key"::STRING = 'wikidata'
     GROUP BY rels.relation_id, rels.relation_name, rels."geometry"
     ORDER BY w_cnt DESC
     LIMIT 1
)
SELECT p."osm_id"  AS relation_id,
       p."all_tags"
FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p
JOIN ranked r
  ON p."osm_id" = r.relation_id;
