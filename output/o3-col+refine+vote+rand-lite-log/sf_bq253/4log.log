```sql
-- Description: Count, for each remaining relation, how many features INSIDE the relation's geometry carry a `wikidata` tag
SELECT
  rels."relation_id",
  rels."relation_name",
  COUNT(*)                         AS "wikidata_feature_count"
FROM (
      /* the relation list without wikidata tag */
      SELECT pf.*
      FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf
      WHERE 
            pf."feature_type" = 'multipolygons'
        AND pf."osm_id" IS NOT NULL
        AND ARRAY_SIZE(
              FILTER(
                   FLATTEN(input => pf."all_tags"),
                   t -> t.value:"key"::STRING = 'wikidata'
              )
            ) = 0
     ) rels
JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES feats
  ON ST_INTERSECTS(
         TO_GEOGRAPHY(feats."geometry"),
         TO_GEOGRAPHY(rels."geometry")
     )
     AND ARRAY_SIZE(
           FILTER(
              FLATTEN(input => feats."all_tags"),
              t2 -> t2.value:"key"::STRING = 'wikidata'
           )
         ) > 0
GROUP BY
  rels."relation_id",
  rels."relation_name"
ORDER BY
  "wikidata_feature_count" DESC
LIMIT 20;
```

