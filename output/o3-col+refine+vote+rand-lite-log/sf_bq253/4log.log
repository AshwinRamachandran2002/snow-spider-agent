               AND MAX(CASE WHEN tag.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END)=0
         ) nr
    JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f
      ON ST_INTERSECTS( TO_GEOGRAPHY(f."geometry"), nr.rel_geom )
    ,    LATERAL FLATTEN(input => f."all_tags") t2
    WHERE t2.value:"key"::STRING = 'wikidata'
    GROUP BY nr.relation_id, nr.relation_name, nr.rel_geom
)
SELECT
    rc.relation_id,
    rc.relation_name,
    rc.wikidata_feature_count
FROM rel_counts rc
JOIN q1095 q
  ON ST_INTERSECTS(rc.rel_geom, q.geom)
ORDER BY rc.wikidata_feature_count DESC
LIMIT 20;
```

```sql
--Description: Show the full tag list for the single relation that contains the
--             greatest number of intersecting wikidata-tagged features.
WITH ranked AS (
    SELECT
        nr.relation_id,
        nr.rel_geom,
        COUNT( DISTINCT COALESCE(f."osm_id", f."osm_way_id") ) AS w_cnt
    FROM (  -- relations without wikidata tag
            SELECT
                r."osm_id" AS relation_id,
                TO_GEOGRAPHY(r."geometry") AS rel_geom
            FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES r
            WHERE r."feature_type" = 'multipolygons'
              AND NOT EXISTS (
                     SELECT 1
                     FROM LATERAL FLATTEN(input => r."all_tags") w
                     WHERE w.value:"key"::STRING = 'wikidata'
              )
         ) nr
    JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f
      ON ST_INTERSECTS( TO_GEOGRAPHY(f."geometry"), nr.rel_geom )
    ,    LATERAL FLATTEN(input => f."all_tags") t
    WHERE t.value:"key"::STRING = 'wikidata'
    GROUP BY nr.relation_id, nr.rel_geom
    ORDER BY w_cnt DESC
    LIMIT 1
)
SELECT p."osm_id"  AS relation_id,
       p."all_tags"
FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p
JOIN ranked r
  ON p."osm_id" = r.relation_id;
