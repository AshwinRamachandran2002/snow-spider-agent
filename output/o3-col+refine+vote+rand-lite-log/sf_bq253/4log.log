```sql
--Description: Return the complete tag array for the single multipolygon relation that
--             overlaps Limburg (wikidata = 'Q1095'), possesses a “name” tag, lacks its own
--             “wikidata” tag, and intersects the greatest number of other features that DO
--             carry a wikidata tag.  Geometry objects are never used in GROUP BY to satisfy
--             Snowflake restrictions.

WITH q1095 AS (  -- geometry of Limburg province (wikidata = Q1095)
    SELECT TO_GEOGRAPHY(p."geometry") AS geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p,
         LATERAL FLATTEN(input => p."all_tags") t
    WHERE t.value:"key"::STRING = 'wikidata'
      AND t.value:"value"::STRING = 'Q1095'
    LIMIT 1
),
candidate_relations AS (  -- relations intersecting Limburg, have name, no wikidata
    SELECT
        r."osm_id"                                            AS relation_id,
        TO_GEOGRAPHY(r."geometry")                            AS rel_geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES r,
         LATERAL FLATTEN(input => r."all_tags") tag
    JOIN q1095 q
      ON ST_INTERSECTS(TO_GEOGRAPHY(r."geometry"), q.geom)
    WHERE r."feature_type" = 'multipolygons'
    GROUP BY r."osm_id", r."geometry"                         -- geometry column is binary, allowed
    HAVING MAX(CASE WHEN tag.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END) = 1
       AND MAX(CASE WHEN tag.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0
),
relation_counts AS (      -- count wikidata-tagged features intersecting each candidate relation
    SELECT
        cr.relation_id,
        COUNT(DISTINCT COALESCE(f."osm_id", f."osm_way_id")) AS wd_feature_cnt
    FROM candidate_relations cr
    JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f
      ON ST_INTERSECTS(TO_GEOGRAPHY(f."geometry"), cr.rel_geom)
    ,    LATERAL FLATTEN(input => f."all_tags") ft
    WHERE ft.value:"key"::STRING = 'wikidata'
    GROUP BY cr.relation_id
)
SELECT
    pf."osm_id"  AS relation_id,
    pf."all_tags"
FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf
JOIN relation_counts rc
  ON pf."osm_id" = rc.relation_id
QUALIFY ROW_NUMBER() OVER (ORDER BY rc.wd_feature_cnt DESC) = 1;
