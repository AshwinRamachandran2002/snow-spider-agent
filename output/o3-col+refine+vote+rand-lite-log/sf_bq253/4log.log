--Description: Produce a list of multipolygon relations whose geometry overlaps the Limburg province
--             (the feature carrying wikidata = 'Q1095'), ensuring:
--             • the relation has at least one “name” tag,
--             • the relation itself does NOT have a “wikidata” tag.
--             Snowflake limitation: to test tag existence/absence, we aggregate over the flattened
--             tag rows and apply HAVING predicates.
WITH q1095 AS (  -- fetch geometry for wikidata = 'Q1095'
    SELECT TO_GEOGRAPHY(f."geometry") AS geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f,
         LATERAL FLATTEN(input => f."all_tags") t
    WHERE t.value:"key"::STRING  = 'wikidata'
      AND t.value:"value"::STRING = 'Q1095'
    LIMIT 1
)
SELECT
    r."osm_id"                                                   AS relation_id,
    MAX(CASE                                                     -- capture the name value
          WHEN tag.value:"key"::STRING = 'name'
          THEN GET_PATH(tag.value,'value')::STRING
        END)                                                     AS relation_name
FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES r
JOIN q1095
  ON ST_INTERSECTS(TO_GEOGRAPHY(r."geometry"), q1095.geom)       -- geometry overlap with Q1095
,    LATERAL FLATTEN(input => r."all_tags") tag                  -- unnest tags (comma CROSS-JOIN)
WHERE r."feature_type" = 'multipolygons'                         -- ensure relation geometry
GROUP BY r."osm_id"
HAVING MAX(CASE WHEN tag.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END) = 1   -- has name
   AND MAX(CASE WHEN tag.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0   -- lacks wikidata
LIMIT 20;
