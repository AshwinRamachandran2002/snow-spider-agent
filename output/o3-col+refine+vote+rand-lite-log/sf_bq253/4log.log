        COUNT(*) AS "wikidata_feature_count"
      FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES rels ,
           LATERAL FLATTEN(input => rels."all_tags") f_tag ,
           GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES feats
      JOIN (
            SELECT TO_GEOGRAPHY("geometry") AS q1095_geom
            FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES
            WHERE ARRAY_SIZE(
                    FILTER(
                       FLATTEN(input => "all_tags"),
                       f2 -> f2.value:"key"::STRING ILIKE '%wikidata%' 
                            AND f2.value:"value"::STRING = 'Q1095'
                    )
                  ) > 0
            LIMIT 1
           ) q
        ON ST_INTERSECTS( TO_GEOGRAPHY(rels."geometry"), q.q1095_geom )
   WHERE 
