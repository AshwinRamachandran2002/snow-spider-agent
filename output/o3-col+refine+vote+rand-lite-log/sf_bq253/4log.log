--Description: List a few features whose geometries intersect the polygon tagged with `wikidata = Q1095`
SELECT 
    pf."feature_type",
    COALESCE(pf."osm_id", pf."osm_way_id") AS "feature_id",
    pf."all_tags"
FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf
JOIN (
        SELECT TO_GEOGRAPHY(qf."geometry") AS q1095_geom
        FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES qf,
             LATERAL FLATTEN(input => qf."all_tags") qtag
        WHERE qtag.value:"key"::STRING  = 'wikidata'
          AND qtag.value:"value"::STRING = 'Q1095'
        LIMIT 1
     ) q
  ON ST_INTERSECTS(TO_GEOGRAPHY(pf."geometry"), q.q1095_geom)
LIMIT 20
