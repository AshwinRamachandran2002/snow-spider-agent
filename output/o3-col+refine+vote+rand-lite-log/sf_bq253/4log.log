```sql
WITH q1095 AS (   -- geometry of the multipolygon tagged with  wikidata = Q1095
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf ,
         LATERAL FLATTEN (INPUT => pf."all_tags") tag
    WHERE tag.value:"key"::STRING  = 'wikidata'
      AND tag.value:"value"::STRING = 'Q1095'
    LIMIT 1
),

/* every way-feature with a flag telling whether that feature itself has a wikidata tag */
features_flag AS (
    SELECT
        pf."osm_way_id"                                 AS way_id ,
        TO_GEOGRAPHY(pf."geometry")                     AS geom ,
        MAX( IFF( t.value:"key"::STRING = 'wikidata', 1, 0) ) AS has_wikidata
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf ,
         LATERAL FLATTEN (INPUT => pf."all_tags") t
    WHERE pf."osm_way_id" IS NOT NULL
    GROUP BY pf."osm_way_id" , pf."geometry"
),

/* aggregate tags of every relation: pick its name and see whether it has a wikidata tag */
relations_agg AS (
    SELECT
        pr."id"                                                AS relation_id ,
        MAX( IFF( tag.value:"key"::STRING = 'name'
                , tag.value:"value"::STRING , NULL) )          AS relation_name ,
        MAX( IFF( tag.value:"key"::STRING = 'wikidata' , 1 , 0) )  AS has_wikidata_tag
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_RELATIONS pr ,
         LATERAL FLATTEN (INPUT => pr."all_tags") tag
    GROUP BY pr."id"
),

/* keep relations that HAVE a name but NO wikidata tag */
relations_named_no_wd AS (
    SELECT relation_id , relation_name
    FROM relations_agg
    WHERE relation_name IS NOT NULL
      AND has_wikidata_tag = 0
),

/* pull member ways of those relations */
relation_members AS (
    SELECT
        r.relation_id ,
        r.relation_name ,
        mem.value:"id"::NUMBER AS way_id
    FROM relations_named_no_wd r
    JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_RELATIONS pr
          ON pr."id" = r.relation_id ,
         LATERAL FLATTEN (INPUT => pr."members") mem
    WHERE mem.value:"type"::STRING = 'w'
),

/* count how many member-features lie inside the Q1095 polygon */
counts AS (
    SELECT
        rm.relation_id ,
        rm.relation_name ,
        COUNT( DISTINCT ff.way_id )            AS inside_cnt ,
        MAX( ff.has_wikidata )                 AS has_any_wikidata_feature
    FROM relation_members rm
    JOIN features_flag ff
          ON ff.way_id = rm.way_id
    CROSS JOIN q1095
    WHERE ST_INTERSECTS( ff.geom , q1095.geom )
    GROUP BY rm.relation_id , rm.relation_name
)

/* return the name of the relation with the most such features */
SELECT relation_name
FROM counts
WHERE has_any_wikidata_feature = 1
ORDER BY inside_cnt DESC NULLS LAST
LIMIT 1;
