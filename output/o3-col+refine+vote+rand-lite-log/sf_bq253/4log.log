               FLATTEN(input => rels."all_tags"),
               t -> t.value:"key"::STRING = 'wikidata'
          )
        ) = 0                       -- relation has NO wikidata tag
    AND ST_INTERSECTS(
            TO_GEOGRAPHY(feats."geometry"),
            TO_GEOGRAPHY(rels."geometry")
