```sql
/* ---------------------------------------------------------------------------
   Find the named relation (no own wikidata tag) that has the largest number
   of its member ways located inside the multipolygon whose wikidata = Q1095,
   provided that at least one of those member ways itself has a wikidata tag.
--------------------------------------------------------------------------- */
WITH
/* geometry of the multipolygon tagged wikidata = Q1095 -------------------- */
q1095 AS (
    SELECT TO_GEOGRAPHY(pf."geometry") AS geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES  pf ,
         LATERAL FLATTEN(INPUT => pf."all_tags", OUTER => TRUE) tag
    WHERE tag.value:"key"::STRING  = 'wikidata'
      AND tag.value:"value"::STRING = 'Q1095'
    LIMIT 1
),

/* every way-feature: geometry + flag whether *it* has a wikidata tag --------*/
way_features AS (
    SELECT
        pf."osm_way_id"                                                   AS way_id ,
        TO_GEOGRAPHY(pf."geometry")                                       AS geom   ,
        MAX( IFF(tag.value:"key"::STRING = 'wikidata', 1, 0) )            AS has_wikidata
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf
         , LATERAL FLATTEN(INPUT => pf."all_tags", OUTER => TRUE) tag
    WHERE pf."osm_way_id" IS NOT NULL
      AND pf."geometry" IS NOT NULL
    GROUP BY pf."osm_way_id" , pf."geometry"
),

/* collect each relation’s name and whether it has its own wikidata tag ------*/
relations_tags AS (
    SELECT
        pr."id"                                                                 AS relation_id ,
        MAX( IFF(tag.value:"key"::STRING = 'name'    , tag.value:"value"::STRING , NULL) ) AS relation_name ,
        MAX( IFF(tag.value:"key"::STRING = 'wikidata', 1 , 0) )                           AS rel_has_wikidata
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_RELATIONS pr
         , LATERAL FLATTEN(INPUT => pr."all_tags", OUTER => TRUE) tag
    GROUP BY pr."id"
),

/* keep only relations that HAVE a name but NO wikidata tag ------------------*/
relations_kept AS (
    SELECT relation_id , relation_name
    FROM relations_tags
    WHERE relation_name IS NOT NULL
      AND rel_has_wikidata = 0
),

/* expand members (type = way) of those relations --------------------------- */
relation_members AS (
    SELECT
        rk.relation_id ,
        rk.relation_name ,
        mem.value:"id"::NUMBER AS way_id
    FROM relations_kept rk
    JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_RELATIONS pr
          ON pr."id" = rk.relation_id
       , LATERAL FLATTEN(INPUT => pr."members") mem
    WHERE mem.value:"type"::STRING = 'w'
),

/* does the relation have at least one member way with wikidata? ------------ */
relation_has_wd_member AS (
    SELECT
        rm.relation_id ,
        MAX(wf.has_wikidata) AS has_member_wikidata
    FROM relation_members rm
    JOIN way_features  wf ON wf.way_id = rm.way_id
    GROUP BY rm.relation_id
),

/* count how many of a relation’s member ways lie inside the Q1095 polygon -- */
inside_counts AS (
    SELECT
        rm.relation_id ,
        rm.relation_name ,
        COUNT(DISTINCT wf.way_id) AS inside_cnt
    FROM relation_members rm
    JOIN way_features wf  ON wf.way_id = rm.way_id
    CROSS JOIN q1095
    WHERE ST_INTERSECTS(wf.geom , q1095.geom)
    GROUP BY rm.relation_id , rm.relation_name
)

/* ---------------------------------------------------------------------------
   final answer
--------------------------------------------------------------------------- */
SELECT ic.relation_name
FROM   inside_counts          ic
JOIN   relation_has_wd_member hw
       ON hw.relation_id = ic.relation_id
WHERE  hw.has_member_wikidata = 1
ORDER  BY ic.inside_cnt DESC NULLS LAST
LIMIT 1;
```
