```sql
--Description:  Return the complete tag array for the single multipolygon relation that
--              (1) intersects the Limburg province polygon (feature with wikidata = 'Q1095'),
--              (2) has at least one “name” tag,
--              (3) has NO “wikidata” tag of its own, and
--              (4) intersects the greatest number of other OpenStreetMap features that DO
--                  possess a wikidata tag.  GEOGRAPHY objects are not used in GROUP BY.

WITH q1095 AS (                              -- geometry of Limburg (Q1095)
    SELECT TO_GEOGRAPHY(p."geometry") AS geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p,
         LATERAL FLATTEN(input => p."all_tags") tg
    WHERE tg.value:"key"::STRING  = 'wikidata'
      AND tg.value:"value"::STRING = 'Q1095'
    LIMIT 1
),

cand_rels AS (                               -- candidate relations overlapping Limburg, name present, no wikidata
    SELECT
        r."osm_id"                                           AS relation_id,
        TO_GEOGRAPHY(r."geometry")                           AS rel_geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES r,
         LATERAL FLATTEN(input => r."all_tags") tag
    JOIN q1095 q
      ON ST_INTERSECTS(TO_GEOGRAPHY(r."geometry"), q.geom)
    WHERE r."feature_type" = 'multipolygons'
    GROUP BY r."osm_id", r."geometry"                        -- binary geometry allowed
    HAVING MAX(CASE WHEN tag.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END) = 1
       AND MAX(CASE WHEN tag.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0
),

rel_ranking AS (                            -- count wikidata-tagged features intersecting each candidate
    SELECT
        cr.relation_id,
        COUNT( DISTINCT COALESCE(f."osm_id", f."osm_way_id") ) AS wd_cnt
    FROM cand_rels cr
    JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f
      ON ST_INTERSECTS(TO_GEOGRAPHY(f."geometry"), cr.rel_geom)
    ,    LATERAL FLATTEN(input => f."all_tags") ft
    WHERE ft.value:"key"::STRING = 'wikidata'
    GROUP BY cr.relation_id
)

SELECT
    pf."osm_id"  AS relation_id,
    pf."all_tags"
FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf
JOIN rel_ranking rr
  ON pf."osm_id" = rr.relation_id
QUALIFY ROW_NUMBER() OVER (ORDER BY rr.wd_cnt DESC) = 1;     -- keep the relation with the highest count
```
