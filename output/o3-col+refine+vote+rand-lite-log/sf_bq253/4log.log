     FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES r
     JOIN q1095 q
       ON ST_INTERSECTS(TO_GEOGRAPHY(r."geometry"), q.geom)
     ,    LATERAL FLATTEN(input => r."all_tags") rt
     LEFT JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f
       ON ST_INTERSECTS(TO_GEOGRAPHY(f."geometry"), TO_GEOGRAPHY(r."geometry"))
     ,    LATERAL FLATTEN(input => f."all_tags") ft
     WHERE r."feature_type" = 'multipolygons'
       AND rt.value:"key"::STRING = 'name'                         -- ensure name
       AND NOT EXISTS ( SELECT 1                                   -- ensure NO wikidata on relation
                        FROM LATERAL FLATTEN(input => r."all_tags") wx
                        WHERE wx.value:"key"::STRING = 'wikidata')
       AND ft.value:"key"::STRING = 'wikidata'                     -- features WITH wikidata
     GROUP BY r."osm_id"
     ORDER BY w_cnt DESC
     LIMIT 1
)
