```sql
-- Description: Retrieve candidate relations (multipolygons) that INTERSECT the Q1095 area and possess a `name` tag
SELECT
  pf."osm_id"                               AS "relation_id",
  GET_PATH(f.value, 'value')::STRING        AS "relation_name",
  pf."all_tags"
FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES  pf ,
     LATERAL FLATTEN( input => pf."all_tags")             f
JOIN (
      SELECT TO_GEOGRAPHY("geometry") AS q1095_geom
      FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES
      WHERE ARRAY_SIZE(
              FILTER(
                 FLATTEN(input => "all_tags"),
                 f2 -> f2.value:"key"::STRING ILIKE '%wikidata%' 
                      AND f2.value:"value"::STRING = 'Q1095'
              )
            ) > 0
      LIMIT 1
     ) q
  ON ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), q.q1095_geom )
WHERE 
      pf."feature_type" = 'multipolygons'       -- relations are extracted as multipolygons
  AND pf."osm_id" IS NOT NULL                   -- indicates relation-sourced object
  AND f.value:"key"::STRING = 'name'
LIMIT 20;
