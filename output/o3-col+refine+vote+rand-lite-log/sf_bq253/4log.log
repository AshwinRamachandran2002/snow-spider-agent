            JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES feats
              ON ST_INTERSECTS(TO_GEOGRAPHY(feats."geometry"), TO_GEOGRAPHY(rels."geometry"))
            JOIN LATERAL FLATTEN(input => feats."all_tags") f
              ON f.value:"key"::STRING = 'wikidata'
            GROUP BY rels."relation_id"
            ORDER BY wikidata_cnt DESC
            LIMIT 1
         ) c
)
SELECT
    pf."osm_id"  AS "relation_id",
    pf."all_tags"
FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf
JOIN top_relation tr
  ON pf."osm_id" = tr."relation_id"
LIMIT 20;
```

```sql
--Description: Extract the `name` tag from that top-ranked relation to confirm the final answer
WITH top_relation AS (
     SELECT c."relation_id"
     FROM (
            SELECT
                rels."relation_id",
                COUNT(DISTINCT COALESCE(feats."osm_id", feats."osm_way_id")) AS wikidata_cnt
            FROM (
                    SELECT
                        pf."osm_id"   AS "relation_id",
                        pf."geometry"
                    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf
                    WHERE pf."feature_type" = 'multipolygons'
                      AND pf."osm_id" IS NOT NULL
                      AND NOT EXISTS (
                              SELECT 1
                              FROM LATERAL FLATTEN(input => pf."all_tags") w
                              WHERE w.value:"key"::STRING = 'wikidata'
                      )
                 ) rels
            JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES feats
              ON ST_INTERSECTS(TO_GEOGRAPHY(feats."geometry"), TO_GEOGRAPHY(rels."geometry"))
            JOIN LATERAL FLATTEN(input => feats."all_tags") f
              ON f.value:"key"::STRING = 'wikidata'
            GROUP BY rels."relation_id"
            ORDER BY wikidata_cnt DESC
            LIMIT 1
         ) c
)
SELECT 
    GET_PATH(f.value,'value')::STRING AS "relation_name"
FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
     LATERAL FLATTEN(input => pf."all_tags") f
JOIN top_relation tr
  ON pf."osm_id" = tr."relation_id"
WHERE f.value:"key"::STRING = 'name'
LIMIT 20;
```

```sql
--Description: Optional – List distinct names of relations intersecting the Q1095 area that lack a Wikidata tag, ordered by the number of contained Wikidata-tagged features
SELECT
    rels."relation_name",
    COUNT(DISTINCT COALESCE(feats."osm_id", feats."osm_way_id")) AS "wikidata_feature_count"
FROM (
        SELECT
            pf."osm_id"                            AS "relation_id",
            GET_PATH(n.value,'value')::STRING      AS "relation_name",
            pf."geometry"
        FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
             LATERAL FLATTEN(input => pf."all_tags") n
        WHERE pf."feature_type" = 'multipolygons'
          AND pf."osm_id" IS NOT NULL
          AND n.value:"key"::STRING = 'name'
          AND NOT EXISTS (
                  SELECT 1
                  FROM LATERAL FLATTEN(input => pf."all_tags") w
                  WHERE w.value:"key"::STRING = 'wikidata'
          )
     ) rels
JOIN (
        SELECT TO_GEOGRAPHY(qf."geometry") AS q1095_geom
        FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES qf,
             LATERAL FLATTEN(input => qf."all_tags") qtag
        WHERE qtag.value:"key"::STRING  = 'wikidata'
          AND qtag.value:"value"::STRING = 'Q1095'
        LIMIT 1
     ) q
  ON ST_INTERSECTS(TO_GEOGRAPHY(rels."geometry"), q.q1095_geom)
JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES feats
  ON ST_INTERSECTS(TO_GEOGRAPHY(feats."geometry"), TO_GEOGRAPHY(rels."geometry"))
JOIN LATERAL FLATTEN(input => feats."all_tags") f2
  ON f2.value:"key"::STRING = 'wikidata'
GROUP BY
    rels."relation_name"
ORDER BY
    "wikidata_feature_count" DESC
LIMIT 20;
