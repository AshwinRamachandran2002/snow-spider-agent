```sql
--Description: Extract just the “name” tag of that top-ranked relation
WITH top_rel AS (
    SELECT p."osm_id"
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p
    WHERE p."feature_type" = 'multipolygons'
      AND NOT EXISTS (
             SELECT 1
             FROM LATERAL FLATTEN(input => p."all_tags") w
             WHERE w.value:"key"::STRING = 'wikidata'
      )
    QUALIFY ROW_NUMBER() OVER (ORDER BY
             (SELECT COUNT(*)
              FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f,
                   LATERAL FLATTEN(input => f."all_tags") s
              WHERE s.value:"key"::STRING = 'wikidata'
                AND ST_INTERSECTS( TO_GEOGRAPHY(f."geometry"),
                                   TO_GEOGRAPHY(p."geometry") )
             ) DESC) = 1
)
SELECT GET_PATH(t.value,'value')::STRING AS relation_name
FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p,
     LATERAL FLATTEN(input => p."all_tags") t
JOIN top_rel tr
  ON p."osm_id" = tr."osm_id"
WHERE t.value:"key"::STRING = 'name';
```

```sql
--Description: Show up to 20 relation names (that lack a wikidata tag) intersecting Q1095,
--             ordered by the number of wikidata-tagged features they contain.
WITH q1095 AS (
     SELECT TO_GEOGRAPHY(f."geometry") AS geom
     FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f,
          LATERAL FLATTEN(input => f."all_tags") t
     WHERE t.value:"key"::STRING = 'wikidata'
       AND t.value:"value"::STRING = 'Q1095'
     LIMIT 1
), rels AS (
     SELECT
         r."osm_id" AS relation_id,
         MAX( CASE WHEN tag.value:"key"::STRING = 'name'
                   THEN GET_PATH(tag.value,'value')::STRING END ) AS relation_name,
         r."geometry" AS geom
     FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES r,
          LATERAL FLATTEN(input => r."all_tags") tag
     WHERE r."feature_type" = 'multipolygons'
       AND ST_INTERSECTS( TO_GEOGRAPHY(r."geometry"), (SELECT geom FROM q1095) )
     GROUP BY r."osm_id", r."geometry"
     HAVING MAX(CASE WHEN tag.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END)=1
        AND MAX(CASE WHEN tag.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END)=0
), counts AS (
     SELECT
         rels.relation_name,
         COUNT( DISTINCT COALESCE(f."osm_id", f."osm_way_id") ) AS wikidata_feature_count
     FROM rels
     JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f
       ON ST_INTERSECTS( TO_GEOGRAPHY(f."geometry"), TO_GEOGRAPHY(rels.geom) )
     ,    LATERAL FLATTEN(input => f."all_tags") t
     WHERE t.value:"key"::STRING = 'wikidata'
     GROUP BY rels.relation_name
)
SELECT relation_name, wikidata_feature_count
FROM counts
ORDER BY wikidata_feature_count DESC
LIMIT 20;
```
