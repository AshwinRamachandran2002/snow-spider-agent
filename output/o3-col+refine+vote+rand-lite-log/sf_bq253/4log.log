```sql
--Description:  Retrieve the full tag array for the single multipolygon relation inside Limburg (wikidata = Q1095)
--              that satisfies:
--                • has at least one “name” tag,
--                • has NO “wikidata” tag of its own,
--                • intersects (spatially) the greatest number of other features that DO possess a wikidata tag.
--              Strategy
--                1.  q1095:  capture Limburg’s GEOGRAPHY.
--                2.  candidate_relations: relations overlapping q1095.geom, filtered by tag criteria.
--                3.  top_relation: rank those candidates by how many wikidata-tagged features intersect each.
--                4.  final SELECT: return the tag list for that top relation.

WITH q1095 AS (                     -- (1) Limburg geometry
    SELECT TO_GEOGRAPHY(p."geometry") AS geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p,
         LATERAL FLATTEN(input => p."all_tags") t
    WHERE t.value:"key"::STRING  = 'wikidata'
      AND t.value:"value"::STRING = 'Q1095'
    LIMIT 1
),
candidate_relations AS (            -- (2) name present, no wikidata, intersects Limburg
    SELECT
        r."osm_id"                                                      AS relation_id,
        MAX(CASE WHEN tag.value:"key"::STRING = 'name'
                 THEN GET_PATH(tag.value,'value')::STRING END)          AS relation_name,
        TO_GEOGRAPHY(r."geometry")                                      AS rel_geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES r
    JOIN q1095 q
      ON ST_INTERSECTS(TO_GEOGRAPHY(r."geometry"), q.geom)
    ,    LATERAL FLATTEN(input => r."all_tags") tag
    WHERE r."feature_type" = 'multipolygons'
    GROUP BY r."osm_id", r."geometry"
    HAVING MAX(CASE WHEN tag.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END) = 1
       AND MAX(CASE WHEN tag.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0
),
top_relation AS (                   -- (3) choose candidate with most intersecting wikidata-tagged features
    SELECT
        cr.relation_id
    FROM candidate_relations cr
    JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f
      ON ST_INTERSECTS(TO_GEOGRAPHY(f."geometry"), cr.rel_geom)
    WHERE EXISTS (                  -- feature has wikidata tag
          SELECT 1
          FROM LATERAL FLATTEN(input => f."all_tags") ft
          WHERE ft.value:"key"::STRING = 'wikidata'
    )
    GROUP BY cr.relation_id
    ORDER BY COUNT(DISTINCT COALESCE(f."osm_id", f."osm_way_id")) DESC
    LIMIT 1
)
SELECT p."osm_id"   AS relation_id,
       p."all_tags"                 -- (4) entire tag list of top relation
FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p
JOIN   top_relation tr
  ON   p."osm_id" = tr.relation_id;
