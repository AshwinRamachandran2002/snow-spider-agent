```sql
--Description: For every relation (multipolygon) that overlaps Q1095 and lacks a wikidata tag,
--             count how many intersecting features DO possess a wikidata tag.
WITH q1095 AS (                               -- Limburg geometry
     SELECT TO_GEOGRAPHY(f."geometry") AS geom
     FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f,
          LATERAL FLATTEN(input => f."all_tags") t
     WHERE t.value:"key"::STRING = 'wikidata'
       AND t.value:"value"::STRING = 'Q1095'
     LIMIT 1
), named_relations AS (                        -- candidate relations (have name, lack wikidata)
     SELECT
         r."osm_id"                           AS relation_id,
         MAX( CASE WHEN tag.value:"key"::STRING = 'name'
                   THEN GET_PATH(tag.value,'value')::STRING END ) AS relation_name,
         r."geometry"                         AS geom
     FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES r,
          LATERAL FLATTEN(input => r."all_tags") tag
     JOIN q1095
       ON ST_INTERSECTS(TO_GEOGRAPHY(r."geometry"), q1095.geom)
     WHERE r."feature_type" = 'multipolygons'
     GROUP BY r."osm_id", r."geometry"
     HAVING MAX(CASE WHEN tag.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END) = 1  -- has name
        AND MAX(CASE WHEN tag.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0  -- no wikidata
)
SELECT
    nr.relation_id,
    nr.relation_name,
    COUNT( DISTINCT COALESCE(f."osm_id", f."osm_way_id") ) AS wikidata_feature_count
FROM named_relations nr
JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f
  ON ST_INTERSECTS( TO_GEOGRAPHY(f."geometry"), TO_GEOGRAPHY(nr.geom) )
,    LATERAL FLATTEN(input => f."all_tags") t2
WHERE t2.value:"key"::STRING = 'wikidata'
GROUP BY nr.relation_id, nr.relation_name
ORDER BY wikidata_feature_count DESC
LIMIT 20;
```

```sql
--Description: Re-validate that each counted relation from the previous step indeed intersects Q1095
WITH q1095 AS (
    SELECT TO_GEOGRAPHY(f."geometry") AS geom
    FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f,
         LATERAL FLATTEN(input => f."all_tags") t
    WHERE t.value:"key"::STRING = 'wikidata'
      AND t.value:"value"::STRING = 'Q1095'
    LIMIT 1
), rel_counts AS (         -- reuse logic from first query to get counts per relation
    SELECT
        nr.relation_id,
        nr.relation_name,
        nr.geom,
        COUNT( DISTINCT COALESCE(f."osm_id", f."osm_way_id") ) AS wikidata_feature_count
    FROM (
            SELECT
                r."osm_id" AS relation_id,
                MAX( CASE WHEN tag.value:"key"::STRING = 'name'
                          THEN GET_PATH(tag.value,'value')::STRING END ) AS relation_name,
                r."geometry" AS geom
            FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES r,
                 LATERAL FLATTEN(input => r."all_tags") tag
            WHERE r."feature_type" = 'multipolygons'
            GROUP BY r."osm_id", r."geometry"
            HAVING MAX(CASE WHEN tag.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END)=1
               AND MAX(CASE WHEN tag.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END)=0
         ) nr
    JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f
      ON ST_INTERSECTS( TO_GEOGRAPHY(f."geometry"), TO_GEOGRAPHY(nr.geom) )
    ,    LATERAL FLATTEN(input => f."all_tags") t2
    WHERE t2.value:"key"::STRING = 'wikidata'
    GROUP BY nr.relation_id, nr.relation_name, nr.geom
)
SELECT
    rc.relation_id,
    rc.relation_name,
    rc.wikidata_feature_count
FROM rel_counts rc
JOIN q1095
  ON ST_INTERSECTS( TO_GEOGRAPHY(rc.geom), q1095.geom )
ORDER BY rc.wikidata_feature_count DESC
LIMIT 20;
```

```sql
--Description: Display every tag for the single relation with the highest
--             number of contained wikidata-tagged features.
WITH ranked AS (
    SELECT
        nr.relation_id,
        nr.geom,
        COUNT( DISTINCT COALESCE(f."osm_id", f."osm_way_id") ) AS wn
    FROM (
            SELECT
                r."osm_id" AS relation_id,
                r."geometry" AS geom
            FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES r
            WHERE r."feature_type" = 'multipolygons'
              AND NOT EXISTS (
                     SELECT 1
                     FROM LATERAL FLATTEN(input => r."all_tags") w
                     WHERE w.value:"key"::STRING = 'wikidata'
              )
         ) nr
    JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES f
      ON ST_INTERSECTS( TO_GEOGRAPHY(f."geometry"), TO_GEOGRAPHY(nr.geom) )
    ,    LATERAL FLATTEN(input => f."all_tags") t
    WHERE t.value:"key"::STRING = 'wikidata'
    GROUP BY nr.relation_id, nr.geom
    ORDER BY wn DESC
    LIMIT 1
)
SELECT p."osm_id" AS relation_id,
       p."all_tags"
FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p
JOIN ranked r
  ON p."osm_id" = r.relation_id;
