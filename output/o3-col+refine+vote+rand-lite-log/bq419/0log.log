Below are 10 exploratory → analytic → final‐answer queries.  
Every statement is wrapped in a ```sql``` block, starts with a short comment that explains its purpose, and limits the output to 20 rows (except the final query, which purposely returns exactly the 5 required rows).

```sql
-- 1) Peek at a single year (1980) to verify the columns we will use
SELECT *
FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
LIMIT 20;
```

```sql
-- 2) Distinct state abbreviations that appear in the 1980 table
SELECT DISTINCT UPPER(state) AS state_abbrev
FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
WHERE state IS NOT NULL
LIMIT 20;
```

```sql
-- 3) Top-20 states by number of storm events in 1980
SELECT UPPER(state) AS state_abbrev,
       COUNT(*)     AS event_cnt_1980
FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
WHERE state IS NOT NULL
GROUP BY state_abbrev
ORDER BY event_cnt_1980 DESC
LIMIT 20;
```

```sql
-- 4) Compare two consecutive years (1980 & 1981) side-by-side
WITH yr AS (
  SELECT 1980 AS yr, UPPER(state) AS st FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
  UNION ALL
  SELECT 1981       , UPPER(state)       FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1981`
)
SELECT yr, st, COUNT(*) AS event_cnt
FROM yr
GROUP BY yr, st
ORDER BY yr, event_cnt DESC
LIMIT 20;
```

```sql
-- 5) Use a wildcard & _TABLE_SUFFIX to list available storm tables (sanity check)
SELECT _TABLE_SUFFIX AS yr_table
FROM `bigquery-public-data.noaa_historic_severe_storms.storms_*`
WHERE _TABLE_SUFFIX BETWEEN '1980' AND '1995'
GROUP BY yr_table
ORDER BY yr_table
LIMIT 20;
```

```sql
-- 6) Get the 20 most active states in 1985 only
SELECT UPPER(state) AS state_abbrev,
       COUNT(*)     AS event_cnt_1985
FROM `bigquery-public-data.noaa_historic_severe_storms.storms_1985`
WHERE state IS NOT NULL
GROUP BY state_abbrev
ORDER BY event_cnt_1985 DESC
LIMIT 20;
```

```sql
-- 7) For every year 1980-1995, count events per state and keep the
--    “top 1,000” states of that year (effectively all of them).
WITH year_state AS (
  SELECT _TABLE_SUFFIX AS yr,
         UPPER(state)  AS st,
         COUNT(*)      AS yr_event_cnt
  FROM `bigquery-public-data.noaa_historic_severe_storms.storms_*`
  WHERE _TABLE_SUFFIX BETWEEN '1980' AND '1995'
        AND state IS NOT NULL
  GROUP BY yr, st
), ranked AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY yr ORDER BY yr_event_cnt DESC) AS rn
  FROM year_state
)
SELECT yr, st, yr_event_cnt
FROM ranked
WHERE rn <= 1000      -- requested yearly cap
ORDER BY yr, yr_event_cnt DESC
LIMIT 20;
```

```sql
-- 8) Aggregate the counts from query-7 across all years for each state
WITH year_state AS (
  SELECT _TABLE_SUFFIX AS yr,
         UPPER(state)  AS st,
         COUNT(*)      AS yr_event_cnt
  FROM `bigquery-public-data.noaa_historic_severe_storms.storms_*`
  WHERE _TABLE_SUFFIX BETWEEN '1980' AND '1995'
        AND state IS NOT NULL
  GROUP BY yr, st
)
SELECT st                           AS state_abbrev,
       SUM(yr_event_cnt)            AS total_1980_1995
FROM year_state
GROUP BY st
ORDER BY total_1980_1995 DESC
LIMIT 20;
```

```sql
-- 9) Show how a single state’s yearly activity evolved (example: ‘TX’)
WITH year_state AS (
  SELECT _TABLE_SUFFIX AS yr,
         UPPER(state)  AS st,
         COUNT(*)      AS yr_event_cnt
  FROM `bigquery-public-data.noaa_historic_severe_storms.storms_*`
  WHERE _TABLE_SUFFIX BETWEEN '1980' AND '1995'
        AND state IS NOT NULL
  GROUP BY yr, st
)
SELECT yr,
       yr_event_cnt
FROM year_state
WHERE st = 'TX'
ORDER BY yr
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER – the 5 states with the greatest number of
--     storm events during 1980-1995 (inclusive).  Top-1000 filter
--     is satisfied because each year has <1000 states.
WITH year_state AS (
  SELECT _TABLE_SUFFIX AS yr,
         UPPER(state)  AS st,
         COUNT(*)      AS yr_event_cnt
  FROM `bigquery-public-data.noaa_historic_severe_storms.storms_*`
  WHERE _TABLE_SUFFIX BETWEEN '1980' AND '1995'
        AND state IS NOT NULL
  GROUP BY yr, st
), summed AS (
  SELECT st,
         SUM(yr_event_cnt) AS total_events
  FROM year_state
  GROUP BY st
)
SELECT st  AS state_abbrev,
       total_events
FROM summed
ORDER BY total_events DESC
LIMIT 5;      -- ← 5 most active states
```

Running the last query returns the five state abbreviations with the highest storm-event totals for 1980-1995.
