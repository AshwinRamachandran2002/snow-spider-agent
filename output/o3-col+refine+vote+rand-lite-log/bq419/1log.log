Query:
--Description: Produce yearly state-level event counts for every year 1980-1995
SELECT
  _TABLE_SUFFIX               AS year,
  UPPER(state)                AS state,
  COUNT(*)                    AS events_in_year
FROM
  `bigquery-public-data.noaa_historic_severe_storms.storms_*`
WHERE
  _TABLE_SUFFIX BETWEEN '1980' AND '1995'
GROUP BY
  year, state
ORDER BY
  year,
  events_in_year DESC
LIMIT 20
