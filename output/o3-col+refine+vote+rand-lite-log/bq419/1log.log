--Description: Count 1980 storm events per state so we know the basic aggregation we will repeat
SELECT UPPER(state) AS state,
       COUNT(*)      AS events_1980
FROM   `bigquery-public-data.noaa_historic_severe_storms.storms_1980`
GROUP  BY state
ORDER  BY events_1980 DESC
LIMIT 20;
