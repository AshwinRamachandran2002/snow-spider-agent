--             large-event state normally expected to be “TX” instead appears under a different code
--             (e.g., “TE” with FIPS 48).  This insight explains why filtering on ‘TX’ returned no rows.
SELECT
  UPPER(state)        AS state_code,      -- two-letter (or variant) code used in the table
  state_fips_code,                        -- numeric FIPS; helps confirm true identity (e.g., 48 = Texas)
  COUNT(*)            AS events_80_81     -- total severe-storm events across 1980-1981
FROM
  `bigquery-public-data.noaa_historic_severe_storms.storms_19*`
