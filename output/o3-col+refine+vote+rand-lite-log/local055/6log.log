--Description: SINGLE query (with inline comments = thinking process)
--             to compute the absolute difference between:
--             • avg( customer spend on the highest-selling artist )
--             • avg( customer spend on the lowest (but non-zero) selling artist )
--             – in both cases ties are broken alphabetically by artist name.
WITH
/* 1) Total sales for every artist -----------------------------------------*/
artist_sales AS (
    SELECT ar."ArtistId",
           ar."Name",
           SUM(ii."UnitPrice" * ii."Quantity") AS sales
    FROM   "invoice_items" AS ii
    JOIN   "tracks"        USING ("TrackId")
    JOIN   "albums"        USING ("AlbumId")
    JOIN   "artists"  AS ar USING ("ArtistId")
    GROUP  BY ar."ArtistId", ar."Name"
),
/* 2) Grab the two artists we care about (order preserved via UNION ALL):
      • first row  = top seller (sales DESC, name ASC)
      • second row = bottom (>0) seller (sales ASC, name ASC) --------------*/
top_bottom AS (
      SELECT "ArtistId"
      FROM   artist_sales
      ORDER  BY sales DESC, "Name"
      LIMIT  1
      UNION ALL
      SELECT "ArtistId"
      FROM   artist_sales
      WHERE  sales > 0
      ORDER  BY sales ASC, "Name"
      LIMIT  1
),
/* 3) For just those two artists, total what each customer spent ------------*/
cust_spend AS (
    SELECT inv."CustomerId",
           ar."ArtistId",
           SUM(ii."UnitPrice" * ii."Quantity") AS spent
    FROM   "invoice_items" AS ii
    JOIN   "tracks"   USING ("TrackId")
    JOIN   "albums"   USING ("AlbumId")
    JOIN   "artists"  AS ar USING ("ArtistId")
    JOIN   "invoices" AS inv ON inv."InvoiceId" = ii."InvoiceId"
    WHERE  ar."ArtistId" IN (SELECT "ArtistId" FROM top_bottom)
    GROUP  BY inv."CustomerId", ar."ArtistId"
),
/* 4) Average spend per artist ---------------------------------------------*/
avgs AS (
    SELECT "ArtistId",
           AVG(spent) AS avg_spent
    FROM   cust_spend
    GROUP  BY "ArtistId"
)
/* 5) Return absolute difference between the two averages ------------------*/
SELECT ABS(
           (SELECT avg_spent
              FROM avgs
              WHERE "ArtistId" = (SELECT "ArtistId" FROM top_bottom LIMIT 1 OFFSET 0))
         -
           (SELECT avg_spent
              FROM avgs
              WHERE "ArtistId" = (SELECT "ArtistId" FROM top_bottom LIMIT 1 OFFSET 1))
       ) AS absolute_difference;
