```sql
--Description: 1) Quick look – list first 20 artists. 
SELECT DISTINCT "ArtistId", "Name"
FROM "artists"
LIMIT 20;
```

```sql
--Description: 2) Verify the artist-album relationship – show 20 albums with their artists. 
SELECT a."AlbumId", a."Title", ar."Name" AS "Artist"
FROM "albums"     AS a
JOIN "artists"    AS ar USING ("ArtistId")
LIMIT 20;
```

```sql
--Description: 3) Trace one level deeper – 20 tracks together with their albums & artists.
SELECT t."TrackId", t."Name"  AS "Track",
       al."Title"  AS "Album",
       ar."Name"   AS "Artist"
FROM   "tracks"  AS t
JOIN   "albums"  AS al USING ("AlbumId")
JOIN   "artists" AS ar USING ("ArtistId")
LIMIT 20;
```

```sql
--Description: 4) Confirm money movement – 20 invoice lines with extended price.
SELECT ii."InvoiceLineId",
       ii."TrackId",
       ii."UnitPrice",
       ii."Quantity",
       (ii."UnitPrice"*ii."Quantity") AS "Line_Total"
FROM   "invoice_items" AS ii
LIMIT 20;
```

```sql
--Description: 5) Calculate total sales per artist (top 10).
SELECT ar."ArtistId",
       ar."Name",
       SUM(ii."UnitPrice"*ii."Quantity") AS "Artist_Sales"
FROM "invoice_items" AS ii
JOIN "tracks"        AS t  USING ("TrackId")
JOIN "albums"        AS al USING ("AlbumId")
JOIN "artists"       AS ar USING ("ArtistId")
GROUP BY ar."ArtistId"
ORDER BY "Artist_Sales" DESC, ar."Name"
LIMIT 10;
```

```sql
--Description: 6) Same computation but bottom 10 artists with non-zero sales.
SELECT ar."ArtistId",
       ar."Name",
       SUM(ii."UnitPrice"*ii."Quantity") AS "Artist_Sales"
FROM "invoice_items" AS ii
JOIN "tracks"        AS t  USING ("TrackId")
JOIN "albums"        AS al USING ("AlbumId")
JOIN "artists"       AS ar USING ("ArtistId")
GROUP BY ar."ArtistId"
HAVING "Artist_Sales" > 0
ORDER BY "Artist_Sales" ASC, ar."Name"
LIMIT 10;
```

```sql
--Description: 7) Retrieve the single top-seller and single lowest-seller (ties resolved by name A-Z).
WITH artist_sales AS (
  SELECT ar."ArtistId",
         ar."Name",
         SUM(ii."UnitPrice"*ii."Quantity") AS sales
  FROM   "invoice_items" AS ii
  JOIN   "tracks"        AS t  USING ("TrackId")
  JOIN   "albums"        AS al USING ("AlbumId")
  JOIN   "artists"       AS ar USING ("ArtistId")
  GROUP  BY ar."ArtistId"
)
SELECT *
FROM artist_sales
WHERE sales = (SELECT MAX(sales) FROM artist_sales)
   OR sales = (SELECT MIN(sales) FROM artist_sales WHERE sales>0)
ORDER BY sales DESC, "Name";
```

```sql
--Description: 8) For those two artists, compute how much each customer spent on each.
WITH artist_map AS (
  /* pick top and bottom artistIds exactly as in previous CTE */
  SELECT ar."ArtistId"
  FROM (
        SELECT ar."ArtistId",
               SUM(ii."UnitPrice"*ii."Quantity") AS sales
        FROM "invoice_items" AS ii
        JOIN "tracks"   AS t  USING ("TrackId")
        JOIN "albums"   AS al USING ("AlbumId")
        JOIN "artists"  AS ar USING ("ArtistId")
        GROUP BY ar."ArtistId"
  ) ar
  WHERE ar.sales = (SELECT MAX(sales) FROM (
                      SELECT SUM(ii."UnitPrice"*ii."Quantity") AS sales
                      FROM "invoice_items" AS ii
                      JOIN "tracks"   AS t  USING ("TrackId")
                      JOIN "albums"   AS al USING ("AlbumId")
                      JOIN "artists"  AS ar USING ("ArtistId")
                      GROUP BY ar."ArtistId"))
     OR ar.sales = (SELECT MIN(sales) FROM (
                      SELECT SUM(ii."UnitPrice"*ii."Quantity") AS sales
                      FROM "invoice_items" AS ii
                      JOIN "tracks"   AS t  USING ("TrackId")
                      JOIN "albums"   AS al USING ("AlbumId")
                      JOIN "artists"  AS ar USING ("ArtistId")
                      GROUP BY ar."ArtistId"
                      HAVING sales>0))
),
lines AS (
  SELECT inv."CustomerId",
         ar."ArtistId",
         SUM(ii."UnitPrice"*ii."Quantity") AS spent
  FROM   "invoice_items" AS ii
  JOIN   "tracks"   AS t   USING ("TrackId")
  JOIN   "albums"   AS al  USING ("AlbumId")
  JOIN   "artists"  AS ar  USING ("ArtistId")
  JOIN   "invoices" AS inv ON inv."InvoiceId" = ii."InvoiceId"
  WHERE  ar."ArtistId" IN (SELECT "ArtistId" FROM artist_map)
  GROUP  BY inv."CustomerId", ar."ArtistId"
)
SELECT * FROM lines
ORDER BY "ArtistId", "CustomerId"
LIMIT 20;
```

```sql
--Description: 9) Average spending of customers who bought something from the top-selling artist.
WITH top_artist AS (
  SELECT ar."ArtistId"
  FROM "invoice_items" AS ii
  JOIN "tracks"   AS t  USING ("TrackId")
  JOIN "albums"   AS al USING ("AlbumId")
  JOIN "artists"  AS ar USING ("ArtistId")
  GROUP BY ar."ArtistId"
  ORDER BY SUM(ii."UnitPrice"*ii."Quantity") DESC, ar."Name"
  LIMIT 1
),
cust_spend AS (
  SELECT inv."CustomerId",
         SUM(ii."UnitPrice"*ii."Quantity") AS spent
  FROM   "invoice_items" AS ii
  JOIN   "tracks"   AS t  USING ("TrackId")
  JOIN   "albums"   AS al USING ("AlbumId")
  JOIN   "artists"  AS ar USING ("ArtistId")
  JOIN   "invoices" AS inv ON inv."InvoiceId" = ii."InvoiceId"
  WHERE  ar."ArtistId" = (SELECT "ArtistId" FROM top_artist)
  GROUP  BY inv."CustomerId"
)
SELECT AVG(spent) AS avg_top_artist_spending
FROM cust_spend;
```

```sql
--Description: 10) Absolute difference between the two customer-average spendings (top vs lowest artist).
WITH artist_rank AS (
  SELECT ar."ArtistId",
         SUM(ii."UnitPrice"*ii."Quantity") AS sales
  FROM   "invoice_items" AS ii
  JOIN   "tracks"   AS t  USING ("TrackId")
  JOIN   "albums"   AS al USING ("AlbumId")
  JOIN   "artists"  AS ar USING ("ArtistId")
  GROUP  BY ar."ArtistId"
),
top_bottom AS (
  SELECT "ArtistId"
  FROM (
        SELECT * FROM artist_rank ORDER BY sales DESC, (SELECT "Name" FROM artists WHERE "ArtistId"=artist_rank."ArtistId") LIMIT 1
        UNION ALL
        SELECT * FROM artist_rank WHERE sales>0 ORDER BY sales ASC, (SELECT "Name" FROM artists WHERE "ArtistId"=artist_rank."ArtistId") LIMIT 1
  )
),
cust_spend AS (
  SELECT inv."CustomerId",
         ar."ArtistId",
         SUM(ii."UnitPrice"*ii."Quantity") AS spent
  FROM   "invoice_items" AS ii
  JOIN   "tracks"   AS t  USING ("TrackId")
  JOIN   "albums"   AS al USING ("AlbumId")
  JOIN   "artists"  AS ar USING ("ArtistId")
  JOIN   "invoices" AS inv ON inv."InvoiceId" = ii."InvoiceId"
  WHERE  ar."ArtistId" IN (SELECT "ArtistId" FROM top_bottom)
  GROUP  BY inv."CustomerId", ar."ArtistId"
),
avgs AS (
  SELECT "ArtistId", AVG(spent) AS avg_spent
  FROM   cust_spend
  GROUP  BY "ArtistId"
)
SELECT ABS(
         (SELECT avg_spent FROM avgs WHERE "ArtistId" = (SELECT "ArtistId" FROM top_bottom ORDER BY ROWID ASC LIMIT 1)) -
         (SELECT avg_spent FROM avgs WHERE "ArtistId" = (SELECT "ArtistId" FROM top_bottom ORDER BY ROWID DESC LIMIT 1))
       ) AS absolute_difference;
```
