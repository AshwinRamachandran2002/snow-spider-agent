```sql
--Description: One self-contained statement (with inline comments to show thinking)
--             that ❶ totals sales per artist, ❷ picks the highest-selling artist
--             (alphabetical tie-break) and the lowest non-zero seller (alphabetical
--             tie-break), ❸ finds what each customer spent on just those two
--             artists, ❹ averages the spending per artist, and ❺ returns the
--             absolute difference between the two averages.

WITH
-- 1) Sales per artist
artist_sales AS (
    SELECT ar."ArtistId",
           ar."Name",
           SUM(ii."UnitPrice"*ii."Quantity") AS sales
    FROM   "invoice_items" AS ii
    JOIN   "tracks"        USING ("TrackId")
    JOIN   "albums"        USING ("AlbumId")
    JOIN   "artists"  AS ar USING ("ArtistId")
    GROUP  BY ar."ArtistId"
),

-- 2) Grab TOP seller (first SELECT) and LOWEST non-zero seller (second SELECT)
top_bottom AS (
    SELECT "ArtistId"                -- top (highest sales, tie -> name)
    FROM   artist_sales
    ORDER  BY sales DESC, "Name"
    LIMIT  1
    UNION ALL
    SELECT "ArtistId"                -- bottom (lowest >0 sales, tie -> name)
    FROM   artist_sales
    WHERE  sales > 0
    ORDER  BY sales ASC, "Name"
    LIMIT  1
),

-- 3) What every customer spent on each of those two artists
cust_spend AS (
    SELECT inv."CustomerId",
           ar."ArtistId",
           SUM(ii."UnitPrice"*ii."Quantity") AS spent
    FROM   "invoice_items" AS ii
    JOIN   "tracks"   USING ("TrackId")
    JOIN   "albums"   USING ("AlbumId")
    JOIN   "artists"  AS ar USING ("ArtistId")
    JOIN   "invoices" AS inv ON inv."InvoiceId" = ii."InvoiceId"
    WHERE  ar."ArtistId" IN (SELECT "ArtistId" FROM top_bottom)
    GROUP  BY inv."CustomerId", ar."ArtistId"
),

-- 4) Average spend per artist (across customers who bought that artist)
avgs AS (
    SELECT "ArtistId", AVG(spent) AS avg_spent
    FROM   cust_spend
    GROUP  BY "ArtistId"
)

-- 5) Absolute difference between the two averages
SELECT ABS(
           (SELECT avg_spent
              FROM avgs
             WHERE "ArtistId" = (SELECT "ArtistId" FROM top_bottom LIMIT 1 OFFSET 0))
         - (SELECT avg_spent
              FROM avgs
             WHERE "ArtistId" = (SELECT "ArtistId" FROM top_bottom LIMIT 1 OFFSET 1))
         ) AS absolute_difference;
