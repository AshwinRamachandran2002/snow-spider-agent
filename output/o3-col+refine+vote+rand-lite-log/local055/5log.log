```sql
--Description: Average spend per customer on the TOP-selling artist (Iron-Maiden in this DB, but
-- picked dynamically).  First find that ArtistId, then for every customer sum the dollars they
-- spent on tracks by that artist, finally take the average of those customer totals.
SELECT AVG(spend_per_customer) AS "avg_spend_top_artist"
FROM (
        SELECT cu."CustomerId",
               SUM(ii."UnitPrice" * ii."Quantity") AS spend_per_customer
        FROM   "customers"      AS cu
        JOIN   "invoices"       AS inv ON cu."CustomerId" = inv."CustomerId"
        JOIN   "invoice_items"  AS ii  ON inv."InvoiceId" = ii."InvoiceId"
        JOIN   "tracks"         AS tr  ON ii."TrackId"    = tr."TrackId"
        JOIN   "albums"         AS al  ON tr."AlbumId"    = al."AlbumId"
        JOIN   "artists"        AS ar  ON al."ArtistId"   = ar."ArtistId"
        WHERE  ar."ArtistId" = (    -- top-selling artist
               SELECT ar2."ArtistId"
               FROM   "artists"       AS ar2
               JOIN   "albums"        AS al2 ON ar2."ArtistId" = al2."ArtistId"
               JOIN   "tracks"        AS tr2 ON al2."AlbumId"  = tr2."AlbumId"
               JOIN   "invoice_items" AS ii2 ON tr2."TrackId"  = ii2."TrackId"
               GROUP  BY ar2."ArtistId"
               ORDER  BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC,
                         ar2."Name" ASC
               LIMIT 1 )
        GROUP BY cu."CustomerId"
);
```

```sql
--Description: Average spend per customer on the BOTTOM-selling artist.  
-- Include customers who never bought that artist by using LEFT JOINs and converting NULL to 0.
SELECT AVG(spend_per_customer) AS "avg_spend_bottom_artist"
FROM (
        SELECT cu."CustomerId",
               IFNULL(SUM(ii."UnitPrice" * ii."Quantity"),0) AS spend_per_customer
        FROM   "customers"       AS cu
        LEFT   JOIN "invoices"       AS inv ON cu."CustomerId" = inv."CustomerId"
        LEFT   JOIN "invoice_items"  AS ii  ON inv."InvoiceId" = ii."InvoiceId"
        LEFT   JOIN "tracks"         AS tr  ON ii."TrackId"    = tr."TrackId"
        LEFT   JOIN "albums"         AS al  ON tr."AlbumId"    = al."AlbumId"
        LEFT   JOIN "artists"        AS ar  ON al."ArtistId"   = ar."ArtistId"
                                             AND ar."ArtistId" = (   -- bottom-selling artist
             SELECT ar2."ArtistId"
             FROM   "artists"         AS ar2
             LEFT   JOIN "albums"         AS al2 ON ar2."ArtistId" = al2."ArtistId"
             LEFT   JOIN "tracks"         AS tr2 ON al2."AlbumId"  = tr2."AlbumId"
             LEFT   JOIN "invoice_items"  AS ii2 ON tr2."TrackId"  = ii2."TrackId"
             GROUP  BY ar2."ArtistId"
             ORDER  BY IFNULL(SUM(ii2."UnitPrice" * ii2."Quantity"),0) ASC,
                       ar2."Name" ASC
             LIMIT 1 )
        GROUP BY cu."CustomerId"
);
```

```sql
--Description: Absolute difference between the two averages computed above.
WITH
    top_avg    AS ( SELECT AVG(spend_per_customer) AS v FROM (
                        SELECT cu."CustomerId",
                               SUM(ii."UnitPrice"*ii."Quantity") AS spend_per_customer
                        FROM   "customers" cu
                        JOIN   "invoices"  inv ON cu."CustomerId" = inv."CustomerId"
                        JOIN   "invoice_items" ii ON inv."InvoiceId" = ii."InvoiceId"
                        JOIN   "tracks" tr  ON ii."TrackId" = tr."TrackId"
                        JOIN   "albums" al  ON tr."AlbumId" = al."AlbumId"
                        WHERE  al."ArtistId" = ( SELECT ar."ArtistId"
                                                 FROM   "artists" ar
                                                 JOIN   "albums"  al2 ON ar."ArtistId" = al2."ArtistId"
                                                 JOIN   "tracks"  tr2 ON al2."AlbumId" = tr2."AlbumId"
                                                 JOIN   "invoice_items" ii2 ON tr2."TrackId" = ii2."TrackId"
                                                 GROUP  BY ar."ArtistId"
                                                 ORDER  BY SUM(ii2."UnitPrice"*ii2."Quantity") DESC,
                                                           ar."Name" ASC
                                                 LIMIT 1 )
                        GROUP BY cu."CustomerId"
                    ) ),
    bottom_avg AS ( SELECT AVG(spend_per_customer) AS v FROM (
                        SELECT cu."CustomerId",
                               IFNULL(SUM(ii."UnitPrice"*ii."Quantity"),0) AS spend_per_customer
                        FROM   "customers" cu
                        LEFT   JOIN "invoices" inv ON cu."CustomerId" = inv."CustomerId"
                        LEFT   JOIN "invoice_items" ii ON inv."InvoiceId" = ii."InvoiceId"
                        LEFT   JOIN "tracks" tr ON ii."TrackId" = tr."TrackId"
                        LEFT   JOIN "albums" al ON tr."AlbumId" = al."AlbumId"
                        LEFT   JOIN "artists" ar ON al."ArtistId" = ar."ArtistId"
                                                   AND ar."ArtistId" = ( SELECT ar2."ArtistId"
                                                                         FROM   "artists" ar2
                                                                         LEFT   JOIN "albums" al2 ON ar2."ArtistId" = al2."ArtistId"
                                                                         LEFT   JOIN "tracks" tr2 ON al2."AlbumId" = tr2."AlbumId"
                                                                         LEFT   JOIN "invoice_items" ii2 ON tr2."TrackId" = ii2."TrackId"
                                                                         GROUP  BY ar2."ArtistId"
                                                                         ORDER  BY IFNULL(SUM(ii2."UnitPrice"*ii2."Quantity"),0) ASC,
                                                                                   ar2."Name" ASC
                                                                         LIMIT 1 )
                        GROUP BY cu."CustomerId"
                    ) )
SELECT ABS( (SELECT v FROM top_avg) - (SELECT v FROM bottom_avg) ) 
       AS "absolute_difference";
