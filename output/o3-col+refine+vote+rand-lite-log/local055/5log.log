```sql
--Description / thinking process:
-- Goal: return the absolute difference between
--   • the average amount customers spent on the top-selling artist
--   • the average amount customers spent on the bottom-selling artist
--
-- Steps
-- 1. Identify the top-selling and bottom-selling artists (CTEs top_artist & bottom_artist).
-- 2. top_spend  : for every customer, SUM(UnitPrice*Quantity) on invoices that contain tracks by the top artist.
-- 3. bottom_spend: for every customer, LEFT-JOIN through the sales chain and SUM only the lines tied to the bottom artist
--                  (NULL → 0) so even customers with no purchase are included.
-- 4. Take AVG(spend) from each CTE and compute ABS() difference.
WITH
top_artist AS (                    -- highest total sales, alphabetical tie-break
    SELECT ar."ArtistId"
    FROM   "artists"   ar
    JOIN   "albums"    al ON ar."ArtistId" = al."ArtistId"
    JOIN   "tracks"    tr ON al."AlbumId"  = tr."AlbumId"
    JOIN   "invoice_items" ii ON tr."TrackId" = ii."TrackId"
    GROUP  BY ar."ArtistId"
    ORDER  BY SUM(ii."UnitPrice"*ii."Quantity") DESC,
              ar."Name" ASC
    LIMIT 1
),
bottom_artist AS (                 -- lowest total sales, alphabetical tie-break
    SELECT ar."ArtistId"
    FROM   "artists"   ar
    LEFT   JOIN "albums"    al ON ar."ArtistId" = al."ArtistId"
    LEFT   JOIN "tracks"    tr ON al."AlbumId"  = tr."AlbumId"
    LEFT   JOIN "invoice_items" ii ON tr."TrackId" = ii."TrackId"
    GROUP  BY ar."ArtistId"
    ORDER  BY IFNULL(SUM(ii."UnitPrice"*ii."Quantity"),0) ASC,
              ar."Name" ASC
    LIMIT 1
),
top_spend AS (                     -- spend per customer on the top artist
    SELECT cu."CustomerId",
           SUM(ii."UnitPrice"*ii."Quantity") AS spend
    FROM   "customers"      cu
    JOIN   "invoices"       inv ON cu."CustomerId" = inv."CustomerId"
    JOIN   "invoice_items"  ii  ON inv."InvoiceId" = ii."InvoiceId"
    JOIN   "tracks"         tr  ON ii."TrackId"    = tr."TrackId"
    JOIN   "albums"         al  ON tr."AlbumId"    = al."AlbumId"
    JOIN   top_artist       ta  ON al."ArtistId"   = ta."ArtistId"
    GROUP  BY cu."CustomerId"
),
bottom_spend AS (                  -- spend per customer on the bottom artist (include 0s)
    SELECT cu."CustomerId",
           IFNULL(SUM(ii."UnitPrice"*ii."Quantity"),0) AS spend
    FROM   "customers"       cu
    LEFT   JOIN "invoices"       inv ON cu."CustomerId" = inv."CustomerId"
    LEFT   JOIN "invoice_items"  ii  ON inv."InvoiceId" = ii."InvoiceId"
    LEFT   JOIN "tracks"         tr  ON ii."TrackId"    = tr."TrackId"
    LEFT   JOIN "albums"         al  ON tr."AlbumId"    = al."AlbumId"
    LEFT   JOIN bottom_artist    ba  ON al."ArtistId"   = ba."ArtistId"
    GROUP  BY cu."CustomerId"
)
SELECT ABS( (SELECT AVG(spend) FROM top_spend)
          - (SELECT AVG(spend) FROM bottom_spend) ) AS "absolute_difference";
