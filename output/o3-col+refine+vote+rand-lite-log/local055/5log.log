```sql
-- 1. Description: Take a quick look at the first 20 artists.  
SELECT DISTINCT "ArtistId", "Name"
FROM "artists"
LIMIT 20;
```

```sql
-- 2. Description: How many albums does each artist have?  
SELECT ar."Name"       AS "artist",
       COUNT(al."AlbumId") AS "album_cnt"
FROM   "artists"  ar
JOIN   "albums"   al ON ar."ArtistId" = al."ArtistId"
GROUP  BY ar."ArtistId"
ORDER  BY "album_cnt" DESC
LIMIT 20;
```

```sql
-- 3. Description: Top-20 artists by total track sales value.  
SELECT ar."Name"                              AS "artist",
       SUM(ii."UnitPrice"*ii."Quantity)       AS "total_sales"
FROM   "artists"       ar
JOIN   "albums"        al ON ar."ArtistId" = al."ArtistId"
JOIN   "tracks"        tr ON al."AlbumId" = tr."AlbumId"
JOIN   "invoice_items" ii ON tr."TrackId" = ii."TrackId"
GROUP  BY ar."ArtistId"
ORDER  BY "total_sales" DESC
LIMIT 20;
```

```sql
-- 4. Description: Artist with the HIGHEST overall sales (tie → alphabetical).  
SELECT ar."ArtistId",
       ar."Name"                              AS "top_artist",
       SUM(ii."UnitPrice"*ii."Quantity)       AS "total_sales"
FROM   "artists"       ar
JOIN   "albums"        al ON ar."ArtistId" = al."ArtistId"
JOIN   "tracks"        tr ON al."AlbumId" = tr."AlbumId"
JOIN   "invoice_items" ii ON tr."TrackId" = ii."TrackId"
GROUP  BY ar."ArtistId"
ORDER  BY "total_sales" DESC, ar."Name" ASC
LIMIT 1;
```

```sql
-- 5. Description: Artist with the LOWEST overall sales (tie → alphabetical).  
SELECT ar."ArtistId",
       ar."Name"                                  AS "bottom_artist",
       IFNULL(SUM(ii."UnitPrice"*ii."Quantity"),0) AS "total_sales"
FROM   "artists"        ar
LEFT   JOIN "albums"        al ON ar."ArtistId" = al."ArtistId"
LEFT   JOIN "tracks"        tr ON al."AlbumId" = tr."AlbumId"
LEFT   JOIN "invoice_items" ii ON tr."TrackId" = ii."TrackId"
GROUP  BY ar."ArtistId"
ORDER  BY "total_sales" ASC, ar."Name" ASC
LIMIT 1;
```

```sql
-- 6. Description: What did customers spend on the TOP-selling artist?  
SELECT cu."CustomerId",
       cu."FirstName"||' '||cu."LastName"          AS "customer",
       SUM(ii."UnitPrice"*ii."Quantity")           AS "spend_on_top_artist"
FROM   "customers"     cu
JOIN   "invoices"      inv ON cu."CustomerId" = inv."CustomerId"
JOIN   "invoice_items" ii  ON inv."InvoiceId" = ii."InvoiceId"
JOIN   "tracks"        tr  ON ii."TrackId"   = tr."TrackId"
JOIN   "albums"        al  ON tr."AlbumId"   = al."AlbumId"
JOIN   "artists"       ar  ON al."ArtistId"  = ar."ArtistId"
WHERE  ar."ArtistId" = (   -- grab the top artist id
       SELECT ar2."ArtistId"
       FROM   "artists"       ar2
       JOIN   "albums"        al2 ON ar2."ArtistId" = al2."ArtistId"
       JOIN   "tracks"        tr2 ON al2."AlbumId"  = tr2."AlbumId"
       JOIN   "invoice_items" ii2 ON tr2."TrackId"  = ii2."TrackId"
       GROUP  BY ar2."ArtistId"
       ORDER  BY SUM(ii2."UnitPrice"*ii2."Quantity") DESC,
                 ar2."Name" ASC
       LIMIT 1)
GROUP  BY cu."CustomerId"
ORDER  BY "spend_on_top_artist" DESC
LIMIT 20;
```

```sql
-- 7. Description: What did customers spend on the BOTTOM-selling artist?  
SELECT cu."CustomerId",
       cu."FirstName"||' '||cu."LastName"             AS "customer",
       SUM(ii."UnitPrice"*ii."Quantity")              AS "spend_on_bottom_artist"
FROM   "customers"     cu
JOIN   "invoices"      inv ON cu."CustomerId" = inv."CustomerId"
JOIN   "invoice_items" ii  ON inv."InvoiceId" = ii."InvoiceId"
JOIN   "tracks"        tr  ON ii."TrackId"   = tr."TrackId"
JOIN   "albums"        al  ON tr."AlbumId"   = al."AlbumId"
JOIN   "artists"       ar  ON al."ArtistId"  = ar."ArtistId"
WHERE  ar."ArtistId" = (   -- grab the bottom artist id
       SELECT ar2."ArtistId"
       FROM   "artists"        ar2
       LEFT   JOIN "albums"        al2 ON ar2."ArtistId" = al2."ArtistId"
       LEFT   JOIN "tracks"        tr2 ON al2."AlbumId"  = tr2."AlbumId"
       LEFT   JOIN "invoice_items" ii2 ON tr2."TrackId"  = ii2."TrackId"
       GROUP  BY ar2."ArtistId"
       ORDER  BY IFNULL(SUM(ii2."UnitPrice"*ii2."Quantity"),0) ASC,
                 ar2."Name" ASC
       LIMIT 1)
GROUP  BY cu."CustomerId"
ORDER  BY "spend_on_bottom_artist" DESC
LIMIT 20;
```

```sql
-- 8. Description: Average amount spent per customer on the TOP artist.  
SELECT AVG("spend_per_customer") AS "avg_spend_top_artist"
FROM (
      SELECT cu."CustomerId",
             SUM(ii."UnitPrice"*ii."Quantity") AS "spend_per_customer"
      FROM   "customers"     cu
      JOIN   "invoices"      inv ON cu."CustomerId" = inv."CustomerId"
      JOIN   "invoice_items" ii  ON inv."InvoiceId" = ii."InvoiceId"
      JOIN   "tracks"        tr  ON ii."TrackId"   = tr."TrackId"
      JOIN   "albums"        al  ON tr."AlbumId"   = al."AlbumId"
      JOIN   "artists"       ar  ON al."ArtistId"  = ar."ArtistId"
      WHERE  ar."ArtistId" = (  -- top artist id
             SELECT ar2."ArtistId"
             FROM   "artists"       ar2
             JOIN   "albums"        al2 ON ar2."ArtistId" = al2."ArtistId"
             JOIN   "tracks"        tr2 ON al2."AlbumId"  = tr2."AlbumId"
             JOIN   "invoice_items" ii2 ON tr2."TrackId"  = ii2."TrackId"
             GROUP  BY ar2."ArtistId"
             ORDER  BY SUM(ii2."UnitPrice"*ii2."Quantity") DESC,
                       ar2."Name" ASC
             LIMIT 1)
      GROUP BY cu."CustomerId"
) LIMIT 20;
