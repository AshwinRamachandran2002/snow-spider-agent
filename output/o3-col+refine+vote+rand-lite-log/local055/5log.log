Query:
--Description: Average spend per customer on the TOP-selling artist (Iron-Maiden in this DB, but
-- picked dynamically).  First find that ArtistId, then for every customer sum the dollars they
-- spent on tracks by that artist, finally take the average of those customer totals.
SELECT AVG(spend_per_customer) AS "avg_spend_top_artist"
FROM (
        SELECT cu."CustomerId",
               SUM(ii."UnitPrice" * ii."Quantity") AS spend_per_customer
        FROM   "customers"      AS cu
        JOIN   "invoices"       AS inv ON cu."CustomerId" = inv."CustomerId"
        JOIN   "invoice_items"  AS ii  ON inv."InvoiceId" = ii."InvoiceId"
        JOIN   "tracks"         AS tr  ON ii."TrackId"    = tr."TrackId"
        JOIN   "albums"         AS al  ON tr."AlbumId"    = al."AlbumId"
        JOIN   "artists"        AS ar  ON al."ArtistId"   = ar."ArtistId"
        WHERE  ar."ArtistId" = (    -- top-selling artist
               SELECT ar2."ArtistId"
               FROM   "artists"       AS ar2
               JOIN   "albums"        AS al2 ON ar2."ArtistId" = al2."ArtistId"
               JOIN   "tracks"        AS tr2 ON al2."AlbumId"  = tr2."AlbumId"
               JOIN   "invoice_items" AS ii2 ON tr2."TrackId"  = ii2."TrackId"
               GROUP  BY ar2."ArtistId"
               ORDER  BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC,
                         ar2."Name" ASC
               LIMIT 1 )
        GROUP BY cu."CustomerId"
)
Answer:
avg_spend_top_artist
5.133333333333332
