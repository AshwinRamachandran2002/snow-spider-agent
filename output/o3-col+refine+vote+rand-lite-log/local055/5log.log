-- artists → albums (by ArtistId) → tracks (by AlbumId) → invoice_items (by TrackId).
-- For every invoice line we multiply UnitPrice by Quantity to get its dollar value.
-- Summing those values per artist gives total_sales.
-- Finally we sort descending to see the biggest earners.
SELECT ar."Name"                             AS "artist",
       SUM(ii."UnitPrice" * ii."Quantity")   AS "total_sales"
FROM   "artists"       AS ar
JOIN   "albums"        AS al ON ar."ArtistId" = al."ArtistId"
JOIN   "tracks"        AS tr ON al."AlbumId"  = tr."AlbumId"
JOIN   "invoice_items" AS ii ON tr."TrackId"  = ii."TrackId"
GROUP  BY ar."ArtistId"
ORDER  BY "total_sales" DESC
LIMIT 20;
