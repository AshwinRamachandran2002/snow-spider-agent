Query:
--Description: Get the artist with the HIGHEST total sales (ties broken alphabetically).
SELECT ar."ArtistId",
       ar."Name"                                   AS "top_artist",
       SUM(ii."UnitPrice" * ii."Quantity")         AS "total_sales"
FROM   "artists"        AS ar
JOIN   "albums"         AS al ON ar."ArtistId" = al."ArtistId"
JOIN   "tracks"         AS tr ON al."AlbumId"  = tr."AlbumId"
JOIN   "invoice_items"  AS ii ON tr."TrackId"  = ii."TrackId"
GROUP  BY ar."ArtistId"
ORDER  BY "total_sales" DESC,
          ar."Name"    ASC
LIMIT 1
