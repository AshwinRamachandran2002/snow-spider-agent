Query:
--Description: Get the artist with the LOWEST total sales (ties broken alphabetically).
SELECT ar."ArtistId",
       ar."Name"                                           AS "bottom_artist",
       IFNULL(SUM(ii."UnitPrice" * ii."Quantity"), 0)      AS "total_sales"
FROM   "artists"        AS ar
LEFT   JOIN "albums"         AS al ON ar."ArtistId" = al."ArtistId"
LEFT   JOIN "tracks"         AS tr ON al."AlbumId"  = tr."AlbumId"
LEFT   JOIN "invoice_items"  AS ii ON tr."TrackId"  = ii."TrackId"
GROUP  BY ar."ArtistId"
ORDER  BY "total_sales" ASC,
          ar."Name"     ASC
LIMIT 1
