-- Include customers who never bought that artist by using LEFT JOINs and converting NULL to 0.
SELECT AVG(spend_per_customer) AS "avg_spend_bottom_artist"
FROM (
        SELECT cu."CustomerId",
               IFNULL(SUM(ii."UnitPrice" * ii."Quantity"),0) AS spend_per_customer
        FROM   "customers"       AS cu
        LEFT   JOIN "invoices"       AS inv ON cu."CustomerId" = inv."CustomerId"
        LEFT   JOIN "invoice_items"  AS ii  ON inv."InvoiceId" = ii."InvoiceId"
        LEFT   JOIN "tracks"         AS tr  ON ii."TrackId"    = tr."TrackId"
        LEFT   JOIN "albums"         AS al  ON tr."AlbumId"    = al."AlbumId"
        LEFT   JOIN "artists"        AS ar  ON al."ArtistId"   = ar."ArtistId"
                                             AND ar."ArtistId" = (   -- bottom-selling artist
             SELECT ar2."ArtistId"
             FROM   "artists"         AS ar2
             LEFT   JOIN "albums"         AS al2 ON ar2."ArtistId" = al2."ArtistId"
             LEFT   JOIN "tracks"         AS tr2 ON al2."AlbumId"  = tr2."AlbumId"
             LEFT   JOIN "invoice_items"  AS ii2 ON tr2."TrackId"  = ii2."TrackId"
             GROUP  BY ar2."ArtistId"
             ORDER  BY IFNULL(SUM(ii2."UnitPrice" * ii2."Quantity"),0) ASC,
                       ar2."Name" ASC
             LIMIT 1 )
        GROUP BY cu."CustomerId"
)
