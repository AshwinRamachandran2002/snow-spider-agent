```sql
--Description: Preview how individual sales lines relate to artists (first 20 rows).
SELECT DISTINCT ii."InvoiceLineId",
       ar."Name"        AS "Artist",
       ii."UnitPrice" * ii."Quantity" AS "LineTotal"
FROM "invoice_items" AS ii
JOIN "tracks"  AS tr ON tr."TrackId"  = ii."TrackId"
JOIN "albums"  AS al ON al."AlbumId"  = tr."AlbumId"
JOIN "artists" AS ar ON ar."ArtistId" = al."ArtistId"
LIMIT 20;
```

```sql
--Description: Total sales amount for each artist, ordered from highest to lowest (top 20 shown).
SELECT DISTINCT ar."Name" AS "Artist",
       SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
FROM "invoice_items" AS ii
JOIN "tracks"  AS tr ON tr."TrackId"  = ii."TrackId"
JOIN "albums"  AS al ON al."AlbumId"  = tr."AlbumId"
JOIN "artists" AS ar ON ar."ArtistId" = al."ArtistId"
GROUP BY ar."ArtistId", ar."Name"
ORDER BY "TotalSales" DESC, ar."Name"
LIMIT 20;
```

```sql
--Description: Same sales table but ordered from lowest to highest to spot the least-selling artist (bottom 20).
SELECT DISTINCT ar."Name" AS "Artist",
       SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
FROM "invoice_items" AS ii
JOIN "tracks"  AS tr ON tr."TrackId"  = ii."TrackId"
JOIN "albums"  AS al ON al."AlbumId"  = tr."AlbumId"
JOIN "artists" AS ar ON ar."ArtistId" = al."ArtistId"
GROUP BY ar."ArtistId", ar."Name"
ORDER BY "TotalSales" ASC, ar."Name"
LIMIT 20;
```

```sql
--Description: Retrieve the single top-selling artist after tie-break (alphabetical).
SELECT DISTINCT ar_top."Name"
FROM (
  SELECT ar."Name",
         SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
  FROM "invoice_items" AS ii
  JOIN "tracks"  AS tr ON tr."TrackId"  = ii."TrackId"
  JOIN "albums"  AS al ON al."AlbumId"  = tr."AlbumId"
  JOIN "artists" AS ar ON ar."ArtistId" = al."ArtistId"
  GROUP BY ar."ArtistId", ar."Name"
) AS ar_top
ORDER BY ar_top."TotalSales" DESC, ar_top."Name"
LIMIT 1;
```

```sql
--Description: Retrieve the single lowest-selling artist after tie-break (alphabetical).
SELECT DISTINCT ar_low."Name"
FROM (
  SELECT ar."Name",
         SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
  FROM "invoice_items" AS ii
  JOIN "tracks"  AS tr ON tr."TrackId"  = ii."TrackId"
  JOIN "albums"  AS al ON al."AlbumId"  = tr."AlbumId"
  JOIN "artists" AS ar ON ar."ArtistId" = al."ArtistId"
  GROUP BY ar."ArtistId", ar."Name"
) AS ar_low
ORDER BY ar_low."TotalSales" ASC, ar_low."Name"
LIMIT 1;
```

```sql
--Description: How much each customer spent on the top-selling artist (first 20 customers).
SELECT DISTINCT c."CustomerId",
       c."FirstName" || ' ' || c."LastName" AS "Customer",
       SUM(ii."UnitPrice" * ii."Quantity")  AS "SpentOnTopArtist"
FROM "customers"      AS c
JOIN "invoices"       AS inv ON inv."CustomerId" = c."CustomerId"
JOIN "invoice_items"  AS ii  ON ii."InvoiceId"   = inv."InvoiceId"
JOIN "tracks"         AS tr  ON tr."TrackId"     = ii."TrackId"
JOIN "albums"         AS al  ON al."AlbumId"     = tr."AlbumId"
JOIN "artists"        AS ar  ON ar."ArtistId"    = al."ArtistId"
JOIN (
      SELECT DISTINCT ar_top."Name"
      FROM (
        SELECT ar."Name",
               SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
        FROM "invoice_items" AS ii
        JOIN "tracks"  AS tr ON tr."TrackId"  = ii."TrackId"
        JOIN "albums"  AS al ON al."AlbumId"  = tr."AlbumId"
        JOIN "artists" AS ar ON ar."ArtistId" = al."ArtistId"
        GROUP BY ar."ArtistId", ar."Name"
      ) AS ar_top
      ORDER BY ar_top."TotalSales" DESC, ar_top."Name"
      LIMIT 1
) AS top ON ar."Name" = top."Name"
GROUP BY c."CustomerId"
HAVING "SpentOnTopArtist" > 0
LIMIT 20;
```

```sql
--Description: How much each customer spent on the lowest-selling artist (first 20 customers).
SELECT DISTINCT c."CustomerId",
       c."FirstName" || ' ' || c."LastName" AS "Customer",
       SUM(ii."UnitPrice" * ii."Quantity")  AS "SpentOnLowArtist"
FROM "customers"      AS c
JOIN "invoices"       AS inv ON inv."CustomerId" = c."CustomerId"
JOIN "invoice_items"  AS ii  ON ii."InvoiceId"   = inv."InvoiceId"
JOIN "tracks"         AS tr  ON tr."TrackId"     = ii."TrackId"
JOIN "albums"         AS al  ON al."AlbumId"     = tr."AlbumId"
JOIN "artists"        AS ar  ON ar."ArtistId"    = al."ArtistId"
JOIN (
      SELECT DISTINCT ar_low."Name"
      FROM (
        SELECT ar."Name",
               SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
        FROM "invoice_items" AS ii
        JOIN "tracks"  AS tr ON tr."TrackId"  = ii."TrackId"
        JOIN "albums"  AS al ON al."AlbumId"  = tr."AlbumId"
        JOIN "artists" AS ar ON ar."ArtistId" = al."ArtistId"
        GROUP BY ar."ArtistId", ar."Name"
      ) AS ar_low
      ORDER BY ar_low."TotalSales" ASC, ar_low."Name"
      LIMIT 1
) AS low ON ar."Name" = low."Name"
GROUP BY c."CustomerId"
HAVING "SpentOnLowArtist" > 0
LIMIT 20;
```

```sql
--Description: Average spending among customers who bought the top-selling artist.
SELECT DISTINCT AVG("SpentOnTopArtist") AS "AvgTopArtistSpend"
FROM (
  SELECT c."CustomerId",
         SUM(ii."UnitPrice" * ii."Quantity") AS "SpentOnTopArtist"
  FROM "customers"      AS c
  JOIN "invoices"       AS inv ON inv."CustomerId" = c."CustomerId"
  JOIN "invoice_items"  AS ii  ON ii."InvoiceId"   = inv."InvoiceId"
  JOIN "tracks"         AS tr  ON tr."TrackId"     = ii."TrackId"
  JOIN "albums"         AS al  ON al."AlbumId"     = tr."AlbumId"
  JOIN "artists"        AS ar  ON ar."ArtistId"    = al."ArtistId"
  JOIN (
        SELECT DISTINCT ar_top."Name"
        FROM (
          SELECT ar."Name",
                 SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
          FROM "invoice_items" AS ii
          JOIN "tracks"  AS tr ON tr."TrackId"  = ii."TrackId"
          JOIN "albums"  AS al ON al."AlbumId"  = tr."AlbumId"
          JOIN "artists" AS ar ON ar."ArtistId" = al."ArtistId"
          GROUP BY ar."ArtistId", ar."Name"
        ) AS ar_top
        ORDER BY ar_top."TotalSales" DESC, ar_top."Name"
        LIMIT 1
  ) AS top ON ar."Name" = top."Name"
  GROUP BY c."CustomerId"
) ;
```

