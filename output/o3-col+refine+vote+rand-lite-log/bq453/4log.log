WHERE
  reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
--Description: 5)  Unnest the `call` array and classify every individual genotype
--               as hom-ref, het, or hom-alt (diploid only; skip missing / haploid / no-calls).
SELECT
  reference_name,
  start,
  reference_bases,
  alternate_bases[OFFSET(0)] AS alt_base,
  CASE
    WHEN ARRAY_LENGTH(c.genotype)=2
         AND c.genotype[OFFSET(0)] = 0
         AND c.genotype[OFFSET(1)] = 0                THEN 'hom_ref'
    WHEN ARRAY_LENGTH(c.genotype)=2
         AND c.genotype[OFFSET(0)] = c.genotype[OFFSET(1)]
         AND c.genotype[OFFSET(0)] = 1                THEN 'hom_alt'
    WHEN ARRAY_LENGTH(c.genotype)=2
         AND c.genotype[OFFSET(0)] != c.genotype[OFFSET(1)] THEN 'het'
    ELSE 'other'
  END AS genotype_class
FROM
  `spider2-public-data.1000_genomes.variants` AS v,
  UNNEST(v.call) AS c
WHERE
  v.reference_name = '17'
  AND v.start BETWEEN 41196311 AND 41277499
  AND ARRAY_LENGTH(c.genotype)=2
  AND c.genotype[OFFSET(0)] >= 0
  AND c.genotype[OFFSET(1)] >= 0
LIMIT 20;
```

```sql
--Description: 6)  Aggregate observed genotype counts per variant (diploid samples only).
SELECT
  reference_name,
  start,
  reference_bases,
  alternate_bases[OFFSET(0)] AS alt_base,
  SUM( CASE genotype_class WHEN 'hom_ref' THEN 1 ELSE 0 END ) AS obs_hom_ref,
  SUM( CASE genotype_class WHEN 'het'      THEN 1 ELSE 0 END ) AS obs_het,
  SUM( CASE genotype_class WHEN 'hom_alt' THEN 1 ELSE 0 END ) AS obs_hom_alt,
  COUNT(*) AS n_genotypes
FROM (
  SELECT
    v.reference_name,
    v.start,
    v.reference_bases,
    v.alternate_bases,
    CASE
      WHEN c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 0 THEN 'hom_ref'
      WHEN c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 1 THEN 'hom_alt'
      WHEN c.genotype[OFFSET(0)] != c.genotype[OFFSET(1)]           THEN 'het'
    END AS genotype_class
  FROM
    `spider2-public-data.1000_genomes.variants` AS v,
    UNNEST(v.call) AS c
  WHERE
    v.reference_name = '17'
    AND v.start BETWEEN 41196311 AND 41277499
    AND ARRAY_LENGTH(c.genotype)=2
    AND c.genotype[OFFSET(0)] >= 0
    AND c.genotype[OFFSET(1)] >= 0
)
GROUP BY reference_name, start, reference_bases, alternate_bases
LIMIT 20;
```

```sql
--Description: 7)  Add allele counts & sample allele frequency calculated
--               from the above observed genotype counts.
WITH geno AS (
  SELECT
    reference_name,
    start,
    reference_bases,
    alternate_bases[OFFSET(0)] AS alt_base,
    SUM( CASE genotype_class WHEN 'hom_ref' THEN 1 ELSE 0 END ) AS hom_ref,
    SUM( CASE genotype_class WHEN 'het'      THEN 1 ELSE 0 END ) AS het,
    SUM( CASE genotype_class WHEN 'hom_alt' THEN 1 ELSE 0 END ) AS hom_alt
  FROM (
    SELECT
      v.reference_name,
      v.start,
      v.reference_bases,
      v.alternate_bases,
      CASE
        WHEN c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 0 THEN 'hom_ref'
        WHEN c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 1 THEN 'hom_alt'
        WHEN c.genotype[OFFSET(0)] != c.genotype[OFFSET(1)]           THEN 'het'
      END AS genotype_class
    FROM
      `spider2-public-data.1000_genomes.variants` AS v,
      UNNEST(v.call) AS c
    WHERE
      v.reference_name = '17'
      AND v.start BETWEEN 41196311 AND 41277499
      AND ARRAY_LENGTH(c.genotype)=2
      AND c.genotype[OFFSET(0)] >= 0
      AND c.genotype[OFFSET(1)] >= 0
  )
  GROUP BY reference_name, start, reference_bases, alt_base
)
SELECT
  *,
  (2*hom_alt + het)     AS alt_allele_count,
  (2*hom_ref + het)     AS ref_allele_count,
  (2*hom_alt + het) /
  (2* (hom_ref + het + hom_alt))         AS sample_alt_freq
FROM geno
LIMIT 20;
```

```sql
--Description: 8)  Use the sample allele frequency (q) to compute the HWE-based expected
--               genotype counts and the χ² statistic component-wise (without Yates).
WITH counts AS (
  -- bring in observed counts & sample q
  SELECT
    *,
    (2*hom_alt + het) / (2* (hom_ref + het + hom_alt))    AS q           -- alt allele freq
  FROM (
    -- (reuse the aggregation from query 7)
    SELECT
      reference_name,
      start,
      reference_bases,
      alternate_bases[OFFSET(0)] AS alt_base,
      SUM( CASE genotype_class WHEN 'hom_ref' THEN 1 ELSE 0 END ) AS hom_ref,
      SUM( CASE genotype_class WHEN 'het'      THEN 1 ELSE 0 END ) AS het,
      SUM( CASE genotype_class WHEN 'hom_alt' THEN 1 ELSE 0 END ) AS hom_alt
    FROM (
      SELECT
        v.reference_name,
        v.start,
        v.reference_bases,
        v.alternate_bases,
        CASE
          WHEN c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 0 THEN 'hom_ref'
          WHEN c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 1 THEN 'hom_alt'
          WHEN c.genotype[OFFSET(0)] != c.genotype[OFFSET(1)]           THEN 'het'
        END AS genotype_class
      FROM
        `spider2-public-data.1000_genomes.variants` AS v,
        UNNEST(v.call) AS c
      WHERE
        v.reference_name = '17'
        AND v.start BETWEEN 41196311 AND 41277499
        AND ARRAY_LENGTH(c.genotype)=2
        AND c.genotype[OFFSET(0)] >= 0
        AND c.genotype[OFFSET(1)] >= 0
    )
    GROUP BY reference_name, start, reference_bases, alt_base
  )
)
SELECT
  reference_name,
  start,
  reference_bases,
  alt_base,
  hom_ref               AS obs_hom_ref,
  het                   AS obs_het,
  hom_alt               AS obs_hom_alt,
  n                      AS total_gts,
  n*(1-q)*(1-q)         AS exp_hom_ref,
  2*n*q*(1-q)           AS exp_het,
  n*q*q                 AS exp_hom_alt,
  -- Chi-square statistic
  ( (hom_ref - n*(1-q)*(1-q))*(hom_ref - n*(1-q)*(1-q))
      / NULLIF(n*(1-q)*(1-q),0) ) +
  ( (het - 2*n*q*(1-q))*(het - 2*n*q*(1-q))
      / NULLIF(2*n*q*(1-q),0) ) +
  ( (hom_alt - n*q*q)*(hom_alt - n*q*q)
      / NULLIF(n*q*q,0) )        AS chi_sq
FROM (
  SELECT
    *,
    (hom_ref + het + hom_alt) AS n
  FROM counts
)
LIMIT 20;
```

```sql
--Description: 9)  Bring together the calculated statistics with the pre-existing 1KG-wide
--               allele-frequency columns (AF, AFR_AF, AMR_AF, ASN_AF, EUR_AF).
WITH
  stat AS (                                               -- χ² & expected counts
    SELECT
      reference_name,
      start,
      reference_bases,
      alt_base,
      chi_sq,
      total_gts,
      obs_hom_ref,
      obs_het,
      obs_hom_alt,
      ROUND(exp_hom_ref,2) AS exp_hom_ref,
      ROUND(exp_het,2)     AS exp_het,
      ROUND(exp_hom_alt,2) AS exp_hom_alt
    FROM ( /* use query 8 (without LIMIT) */ )
),
  base AS (                                               -- basic variant info
    SELECT
      reference_name,
      start,
      `end`,
      reference_bases,
      alternate_bases[OFFSET(0)] AS alt_base,
      VT,
      AF,
      AFR_AF,
      AMR_AF,
      ASN_AF,
      EUR_AF
    FROM
      `spider2-public-data.1000_genomes.variants`
    WHERE
      reference_name = '17'
      AND start BETWEEN 41196311 AND 41277499
)
SELECT
  b.reference_name,
  b.start,
  b.`end`,
  b.reference_bases,
  b.alt_base            AS alternate_bases,
  b.VT                  AS variant_type,
  s.chi_sq,
  s.total_gts,
  s.obs_hom_ref, s.obs_het, s.obs_hom_alt,
  s.exp_hom_ref, s.exp_het, s.exp_hom_alt,
  b.AF     AS AF_overall,
  b.AFR_AF, b.AMR_AF, b.ASN_AF, b.EUR_AF
FROM
  base b
JOIN
  stat s
USING(reference_name, start, reference_bases, alt_base)
LIMIT 20;
```

```sql
--Description: 10)  Produce the final, fully-fledged answer for every variant
--                in one shot (no LIMIT here ‑- remove or modify if desired).
WITH per_call AS (
  -- classify each diploid genotype
  SELECT
    v.reference_name,
    v.start,
    v.`end`,
    v.reference_bases,
    v.alternate_bases[OFFSET(0)] AS alt_base,
    v.VT,
    v.AF, v.AFR_AF, v.AMR_AF, v.ASN_AF, v.EUR_AF,
    CASE
      WHEN c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 0 THEN 'hom_ref'
      WHEN c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 1 THEN 'hom_alt'
      WHEN c.genotype[OFFSET(0)] != c.genotype[OFFSET(1)]           THEN 'het'
    END AS gclass
  FROM `spider2-public-data.1000_genomes.variants`  AS v,
       UNNEST(v.call)                              AS c
  WHERE v.reference_name = '17'
    AND v.start BETWEEN 41196311 AND 41277499
    AND ARRAY_LENGTH(c.genotype)=2
    AND c.genotype[OFFSET(0)] >= 0
    AND c.genotype[OFFSET(1)] >= 0
), agg AS (
  -- observed counts
  SELECT
    reference_name, start, `end`, reference_bases, alt_base, VT,
    AF, AFR_AF, AMR_AF, ASN_AF, EUR_AF,
    COUNTIF(gclass='hom_ref') AS hom_ref,
    COUNTIF(gclass='het')     AS het,
    COUNTIF(gclass='hom_alt') AS hom_alt
  FROM per_call
  GROUP BY reference_name, start, `end`, reference_bases, alt_base, VT,
           AF, AFR_AF, AMR_AF, ASN_AF, EUR_AF
), stats AS (
  -- add allele freq, expected counts, χ²
  SELECT
    *,
    (hom_ref + het + hom_alt)                         AS n,
    (2*hom_alt + het) / (2* (hom_ref + het + hom_alt)) AS q,
    (hom_ref + het + hom_alt) * POW(1 - q, 2)          AS exp_hom_ref,
    2*(hom_ref + het + hom_alt)* q * (1 - q)           AS exp_het,
    (hom_ref + het + hom_alt) * POW(q,2)               AS exp_hom_alt
  FROM agg
)
SELECT
  reference_name,
  start,
  `end`,
  reference_bases,
  alt_base                               AS alternate_bases,
  VT                                     AS variant_type,
  ROUND( (
         POW(hom_ref - exp_hom_ref,2) / NULLIF(exp_hom_ref,0) +
         POW(het     - exp_het,    2) / NULLIF(exp_het,0) +
         POW(hom_alt - exp_hom_alt,2) / NULLIF(exp_hom_alt,0)
       ), 4)                             AS chi_squared,
  n                                       AS total_genotypes,
  hom_ref    AS obs_hom_ref,
  het        AS obs_het,
  hom_alt    AS obs_hom_alt,
  ROUND(exp_hom_ref,2) AS exp_hom_ref,
  ROUND(exp_het,2)     AS exp_het,
  ROUND(exp_hom_alt,2) AS exp_hom_alt,
  ROUND(q,6)           AS sample_alt_AF,
  AF        AS AF_overall,
  AFR_AF, AMR_AF, ASN_AF, EUR_AF
FROM stats
ORDER BY start;
```
