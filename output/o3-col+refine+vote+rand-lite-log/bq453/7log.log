```sql
-- 5.  Retrieve the raw allele counts (AC) and allele frequency (AF) that 1KG stores
SELECT
  reference_name , start , end ,
  reference_bases , alternate_bases ,
  AC  AS raw_AC ,
  AF  AS raw_AF ,
  AN
FROM   `spider2-public-data.1000_genomes.variants`
WHERE  reference_name = '17'
  AND  start BETWEEN 41196311 AND 41277499
LIMIT  20;
```

```sql
-- 6.  Unnest CALL records and classify each individual genotype
SELECT
  v.reference_name , v.start ,
  CASE WHEN ARRAY_LENGTH(c.genotype)=2
           AND c.genotype[OFFSET(0)]=0 AND c.genotype[OFFSET(1)]=0 THEN 'hom_ref'
       WHEN ARRAY_LENGTH(c.genotype)=2
           AND c.genotype[OFFSET(0)]!=c.genotype[OFFSET(1)] THEN 'het'
       WHEN ARRAY_LENGTH(c.genotype)=2
           AND c.genotype[OFFSET(0)]=1 AND c.genotype[OFFSET(1)]=1 THEN 'hom_alt'
       ELSE 'other' END      AS gt_class
FROM   `spider2-public-data.1000_genomes.variants` AS v ,
       UNNEST(v.call)        AS c
WHERE  v.reference_name = '17'
  AND  v.start BETWEEN 41196311 AND 41277499
LIMIT  20;
```

```sql
-- 7.  Aggregate observed genotype counts for every variant
WITH g AS (
  SELECT
    v.reference_name , v.start ,
    CASE WHEN ARRAY_LENGTH(c.genotype)=2
             AND c.genotype[OFFSET(0)]=0 AND c.genotype[OFFSET(1)]=0 THEN 'hom_ref'
         WHEN ARRAY_LENGTH(c.genotype)=2
             AND c.genotype[OFFSET(0)]!=c.genotype[OFFSET(1)] THEN 'het'
         WHEN ARRAY_LENGTH(c.genotype)=2
             AND c.genotype[OFFSET(0)]=1 AND c.genotype[OFFSET(1)]=1 THEN 'hom_alt'
         ELSE NULL END AS gt
  FROM `spider2-public-data.1000_genomes.variants` v ,
       UNNEST(v.call) c
  WHERE v.reference_name='17'
    AND v.start BETWEEN 41196311 AND 41277499
)
SELECT
  reference_name , start ,
  COUNTIF(gt='hom_ref') AS obs_homref ,
  COUNTIF(gt='het')     AS obs_het ,
  COUNTIF(gt='hom_alt') AS obs_homalt ,
  COUNT(*)              AS n_genotypes
FROM   g
GROUP  BY reference_name , start
LIMIT 20;
```

```sql
-- 8.  Derive allele frequencies from the observed genotype counts
WITH counts AS (
  SELECT
    reference_name , start ,
    COUNTIF(gt='hom_ref') AS homref ,
    COUNTIF(gt='het')     AS het ,
    COUNTIF(gt='hom_alt') AS homalt
  FROM (
    SELECT v.reference_name , v.start ,
           CASE WHEN ARRAY_LENGTH(c.genotype)=2
                    AND c.genotype[OFFSET(0)]=0 AND c.genotype[OFFSET(1)]=0 THEN 'hom_ref'
                WHEN ARRAY_LENGTH(c.genotype)=2
                    AND c.genotype[OFFSET(0)]!=c.genotype[OFFSET(1)] THEN 'het'
                WHEN ARRAY_LENGTH(c.genotype)=2
                    AND c.genotype[OFFSET(0)]=1 AND c.genotype[OFFSET(1)]=1 THEN 'hom_alt'
           END AS gt
    FROM `spider2-public-data.1000_genomes.variants` v ,
         UNNEST(v.call) c
    WHERE v.reference_name='17'
      AND v.start BETWEEN 41196311 AND 41277499 )
  GROUP BY reference_name , start
)
SELECT
  reference_name , start ,
  homref , het , homalt ,
  (2*homref + het)                AS total_ref_alleles ,
  (2*homalt + het)                AS total_alt_alleles ,
  (2*homref + het + 2*homalt)     AS total_alleles ,
  SAFE_DIVIDE( (2*homalt + het) , (2*homref + het + 2*homalt) ) AS alt_freq
FROM counts
LIMIT 20;
```

```sql
-- 9.  Compute expected HWE genotype counts and the χ² statistic per variant
WITH obs AS (
  SELECT
    reference_name , start ,
    COUNTIF(gt='hom_ref') AS hr ,
    COUNTIF(gt='het')     AS ht ,
    COUNTIF(gt='hom_alt') AS ha ,
    COUNT(*)              AS n
  FROM (
    SELECT v.reference_name , v.start ,
           CASE WHEN ARRAY_LENGTH(c.genotype)=2
                    AND c.genotype[OFFSET(0)]=0 AND c.genotype[OFFSET(1)]=0 THEN 'hom_ref'
                WHEN ARRAY_LENGTH(c.genotype)=2
                    AND c.genotype[OFFSET(0)]!=c.genotype[OFFSET(1)] THEN 'het'
                WHEN ARRAY_LENGTH(c.genotype)=2
                    AND c.genotype[OFFSET(0)]=1 AND c.genotype[OFFSET(1)]=1 THEN 'hom_alt'
           END AS gt
    FROM `spider2-public-data.1000_genomes.variants` v ,
         UNNEST(v.call) c
    WHERE v.reference_name='17'
      AND v.start BETWEEN 41196311 AND 41277499 )
  GROUP BY reference_name , start
)
SELECT
  reference_name , start ,
  hr , ht , ha , n ,
  -- allele frequency q (ALT)
  SAFE_DIVIDE( (2*ha + ht) , (2*n) )          AS q ,
  -- expected counts under HWE
  (n*(1-q)*(1-q))                             AS exp_hr ,
  (2*n*q*(1-q))                               AS exp_ht ,
  (n*q*q)                                     AS exp_ha ,
  -- χ² statistic
  SAFE_DIVIDE(POW(hr-exp_hr,2),exp_hr)+
  SAFE_DIVIDE(POW(ht-exp_ht,2),exp_ht)+
  SAFE_DIVIDE(POW(ha-exp_ha,2),exp_ha)        AS chi_sq
FROM obs
LIMIT 20;
```

```sql
--10.  Final report: requested fields for each variant in the region
WITH pre AS (
  SELECT v.reference_name , v.start , v.end ,
         v.reference_bases ,
         ARRAY(SELECT DISTINCT alt FROM UNNEST(v.alternate_bases) alt) AS alt_bases ,
         v.VT ,
         v.AF  AS onekg_af ,
         v.AC  AS onekg_ac ,
         v.AN  AS onekg_an ,
         v.HWE AS onekg_hwe_p ,
         v
  FROM `spider2-public-data.1000_genomes.variants` v
  WHERE v.reference_name='17'
    AND v.start BETWEEN 41196311 AND 41277499
),
gt AS (
  SELECT
    p.reference_name , p.start ,
    CASE WHEN ARRAY_LENGTH(c.genotype)=2
             AND c.genotype[OFFSET(0)]=0 AND c.genotype[OFFSET(1)]=0 THEN 'hom_ref'
         WHEN ARRAY_LENGTH(c.genotype)=2
             AND c.genotype[OFFSET(0)]!=c.genotype[OFFSET(1)] THEN 'het'
         WHEN ARRAY_LENGTH(c.genotype)=2
             AND c.genotype[OFFSET(0)]=1 AND c.genotype[OFFSET(1)]=1 THEN 'hom_alt'
    END AS gt_class
  FROM pre AS p, UNNEST(p.v.call) AS c
),
counts AS (
  SELECT
    reference_name , start ,
    COUNTIF(gt_class='hom_ref') AS obs_hr ,
    COUNTIF(gt_class='het')     AS obs_ht ,
    COUNTIF(gt_class='hom_alt') AS obs_ha ,
    COUNT(*)                    AS n
  FROM gt
  GROUP BY reference_name , start
),
chi AS (
  SELECT
    c.* ,
    SAFE_DIVIDE( (2*obs_ha + obs_ht) , (2*n) ) AS q ,
    (n*POW(1-q,2))                              AS exp_hr ,
    (2*n*q*(1-q))                               AS exp_ht ,
    (n*POW(q,2))                                AS exp_ha ,
    SAFE_DIVIDE(POW(obs_hr - n*POW(1-q,2),2), n*POW(1-q,2)) +
    SAFE_DIVIDE(POW(obs_ht - 2*n*q*(1-q),2), 2*n*q*(1-q)) +
    SAFE_DIVIDE(POW(obs_ha - n*POW(q,2),2), n*POW(q,2))     AS chi_sq
  FROM counts c
)
SELECT
  p.reference_name ,
  p.start , p.end ,
  p.reference_bases ,
  alt_bases                            AS distinct_alternate_bases ,
  p.VT                                 AS variant_type ,
  chi.chi_sq ,
  chi.n                                AS total_genotypes ,
  STRUCT(obs_hr  AS observed_hom_ref ,
         obs_ht  AS observed_het ,
         obs_ha  AS observed_hom_alt ,
         exp_hr  AS expected_hom_ref ,
         exp_ht  AS expected_het ,
         exp_ha  AS expected_hom_alt ) AS geno_counts ,
  STRUCT( SAFE_DIVIDE(obs_ha*2 + obs_ht , 2*n) AS alt_freq ,
          SAFE_DIVIDE(obs_hr*2 + obs_ht , 2*n) AS ref_freq ,
          p.onekg_af                            AS onekg_alt_freq )    AS allele_freqs
FROM pre  p
JOIN chi  USING(reference_name,start)
ORDER BY start
LIMIT 20;
```
