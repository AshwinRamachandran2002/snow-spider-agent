```sql
--Description: 4) For every variant in the interval count observed genotypes  
--              (homo-ref, hetero, homo-alt) ignoring missing (-1).  
SELECT
  v.reference_name,
  v.start,
  v.end,
  COUNT(1)                                                          AS total_genotypes,
  SUM(CASE WHEN ARRAY_LENGTH(c.genotype)=2
            AND c.genotype[OFFSET(0)] = 0
            AND c.genotype[OFFSET(1)] = 0          THEN 1 END)      AS hom_ref_obs,
  SUM(CASE WHEN ARRAY_LENGTH(c.genotype)=2
            AND c.genotype[OFFSET(0)] = 1
            AND c.genotype[OFFSET(1)] = 1          THEN 1 END)      AS hom_alt_obs,
  SUM(CASE WHEN ARRAY_LENGTH(c.genotype)=2
            AND ((c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 1) OR
                 (c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 0))
                                                  THEN 1 END)      AS het_obs
FROM  `spider2-public-data.1000_genomes.variants`  AS v,
      UNNEST(v.call)                              AS c
WHERE v.reference_name = '17'
  AND v.start BETWEEN 41196311 AND 41277499
GROUP BY v.reference_name, v.start, v.end
LIMIT 20;
```

```sql
--Description: 5) Add allele frequencies (p = ref, q = alt) calculated from
--              the observed genotype counts in query-4.  
WITH obs AS (
  SELECT
    v.reference_name,
    v.start, v.end,
    COUNT(1)                                                           AS n,
    SUM( (c.genotype[OFFSET(0)] = 0 AND c.genotype[SAFE_OFFSET(1)] = 0) ) AS hom_ref,
    SUM( (c.genotype[OFFSET(0)] = 1 AND c.genotype[SAFE_OFFSET(1)] = 1) ) AS hom_alt,
    SUM( ((c.genotype[OFFSET(0)] = 0 AND c.genotype[SAFE_OFFSET(1)] = 1) OR
          (c.genotype[OFFSET(0)] = 1 AND c.genotype[SAFE_OFFSET(1)] = 0)) ) AS het
  FROM  `spider2-public-data.1000_genomes.variants` AS v,
        UNNEST(v.call)                             AS c
  WHERE v.reference_name='17'
    AND v.start BETWEEN 41196311 AND 41277499
    AND ARRAY_LENGTH(c.genotype)=2
    AND c.genotype[OFFSET(0)]  != -1               -- skip missing
    AND c.genotype[OFFSET(1)]  != -1
  GROUP BY v.reference_name, v.start, v.end
)
SELECT *,
       (2*hom_ref + het)/(2*n)                     AS p_ref,
       (2*hom_alt + het)/(2*n)                     AS q_alt
FROM obs
LIMIT 20;
```

```sql
--Description: 6) Compute the expected genotype counts under H-W equilibrium  
--              and the Chi-squared statistic from those expected counts.  
WITH obs AS (
  SELECT
    v.reference_name, v.start, v.end,
    COUNT(1)                                                     AS n,
    SUM( (c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 0) ) AS hom_ref,
    SUM( (c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 1) ) AS hom_alt,
    SUM( ((c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 1) OR
          (c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 0)) ) AS het
  FROM  `spider2-public-data.1000_genomes.variants` AS v,
        UNNEST(v.call)                             AS c
  WHERE v.reference_name='17'
    AND v.start BETWEEN 41196311 AND 41277499
    AND ARRAY_LENGTH(c.genotype)=2
    AND c.genotype[OFFSET(0)]  != -1
    AND c.genotype[OFFSET(1)]  != -1
  GROUP BY v.reference_name, v.start, v.end
)
SELECT
  reference_name, start, end,
  n                                             AS total_genotypes,
  hom_ref, het, hom_alt,                       -- observed
  ROUND(n*POW((2*hom_ref + het)/(2*n),2),2)     AS exp_hom_ref,
  ROUND(2*n*((2*hom_ref + het)/(2*n))*((2*hom_alt + het)/(2*n)),2) AS exp_het,
  ROUND(n*POW((2*hom_alt + het)/(2*n),2),2)     AS exp_hom_alt,
  -- χ² = Σ (obs-exp)²/exp
  ROUND( 
    POW(hom_ref - n*POW((2*hom_ref + het)/(2*n),2),2) /
         NULLIF(n*POW((2*hom_ref + het)/(2*n),2),0) +
    POW(het - 2*n*((2*hom_ref + het)/(2*n))*((2*hom_alt + het)/(2*n)),2) /
         NULLIF(2*n*((2*hom_ref + het)/(2*n))*((2*hom_alt + het)/(2*n)),0) +
    POW(hom_alt - n*POW((2*hom_alt + het)/(2*n),2),2) /
         NULLIF(n*POW((2*hom_alt + het)/(2*n),2),0)
  ,3)                                            AS chi_sq
FROM obs
LIMIT 20;
```

```sql
--Description: 7) Combine everything (reference/alternate/VT, 1KG HWE column, our
--              freshly computed chi-square & allele freq, plus the 1KG AFs).  
WITH counts AS (
  SELECT
    v.reference_name, v.start, v.end,
    v.reference_bases, v.alternate_bases, v.VT,
    COUNT(1)                                                     AS n,
    SUM( (c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 0) ) AS hom_ref,
    SUM( (c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 1) ) AS hom_alt,
    SUM( ((c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 1) OR
          (c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 0)) ) AS het
  FROM  `spider2-public-data.1000_genomes.variants` AS v,
        UNNEST(v.call)                             AS c
  WHERE v.reference_name='17'
    AND v.start BETWEEN 41196311 AND 41277499
    AND ARRAY_LENGTH(c.genotype)=2
    AND c.genotype[OFFSET(0)]  != -1
    AND c.genotype[OFFSET(1)]  != -1
  GROUP BY v.reference_name, v.start, v.end,
           v.reference_bases, v.alternate_bases, v.VT
)
SELECT
  reference_name, start, end,
  reference_bases, alternate_bases, VT,
  n  AS total_genotypes,
  hom_ref  AS hom_ref_obs,
  het      AS het_obs,
  hom_alt  AS hom_alt_obs,
  ROUND((2*hom_ref + het)/(2*n),4)  AS p_ref,
  ROUND((2*hom_alt + het)/(2*n),4)  AS q_alt,
  ROUND(n*POW((2*hom_ref + het)/(2*n),2),2)                              AS exp_hom_ref,
  ROUND(2*n*((2*hom_ref + het)/(2*n))*((2*hom_alt + het)/(2*n)),2)       AS exp_het,
  ROUND(n*POW((2*hom_alt + het)/(2*n),2),2)                              AS exp_hom_alt,
  ROUND( 
    POW(hom_ref - n*POW((2*hom_ref + het)/(2*n),2),2) /
         NULLIF(n*POW((2*hom_ref + het)/(2*n),2),0) +
    POW(het - 2*n*((2*hom_ref + het)/(2*n))*((2*hom_alt + het)/(2*n)),2) /
         NULLIF(2*n*((2*hom_ref + het)/(2*n))*((2*hom_alt + het)/(2*n)),0) +
    POW(hom_alt - n*POW((2*hom_alt + het)/(2*n),2),2) /
         NULLIF(n*POW((2*hom_alt + het)/(2*n),2),0)
  ,3)  AS chi_sq_calc,
  v.HWE                                AS chi_sq_1KG,     -- Original χ2 from 1KG
  v.AC, v.AF, v.AF1, v.AFR_AF, v.AMR_AF, v.EUR_AF, v.ASN_AF
FROM counts
JOIN `spider2-public-data.1000_genomes.variants` AS v
  USING(reference_name,start,end)
ORDER BY start
LIMIT 20;
```

```sql
--Description: 8) Show only sites where our computed χ² differs by >0.01  
--              from the value reported by 1KG, for quality checking.  
WITH comp AS (
  -- reuse query-7 but without LIMIT
  SELECT
    reference_name, start, end,
    ROUND( 
      POW(hom_ref - n*POW((2*hom_ref + het)/(2*n),2),2) /
           NULLIF(n*POW((2*hom_ref + het)/(2*n),2),0) +
      POW(het - 2*n*((2*hom_ref + het)/(2*n))*((2*hom_alt + het)/(2*n)),2) /
           NULLIF(2*n*((2*hom_ref + het)/(2*n))*((2*hom_alt + het)/(2*n)),0) +
      POW(hom_alt - n*POW((2*hom_alt + het)/(2*n),2),2) /
           NULLIF(n*POW((2*hom_alt + het)/(2*n),2),0)
    ,3)  AS chi_sq_calc,
    v.HWE AS chi_sq_1KG
  FROM (
    SELECT v.reference_name, v.start, v.end, COUNT(1) AS n,
           SUM((c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 0)) AS hom_ref,
           SUM((c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 1)) AS hom_alt,
           SUM(((c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 1) OR
                (c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 0))) AS het
    FROM `spider2-public-data.1000_genomes.variants` AS v,
         UNNEST(v.call) AS c
    WHERE v.reference_name='17'
      AND v.start BETWEEN 41196311 AND 41277499
      AND ARRAY_LENGTH(c.genotype)=2
      AND c.genotype NOT LIKE [-1,-1]
    GROUP BY v.reference_name, v.start, v.end
  ) AS x
  JOIN `spider2-public-data.1000_genomes.variants` AS v
       USING(reference_name,start,end)
)
SELECT *
FROM   comp
WHERE  ABS(chi_sq_calc - chi_sq_1KG) > 0.01
ORDER  BY start
LIMIT 20;
```

