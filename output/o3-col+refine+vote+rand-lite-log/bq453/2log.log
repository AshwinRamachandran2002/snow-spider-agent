Below are ten exploratory-to-final BigQuery SQLs that progressively look at the variants on chromosome 17 (positions 41 196 311–41 277 499) and culminate in a complete result containing reference / alternate alleles, variant type, Hardy-Weinberg χ² statistic, observed & expected genotype counts, and allele-frequency fields that already exist in the 1000 Genomes release.

```sql
-- 1. Basic look at the variants that fall inside the region of interest
SELECT
  `reference_name`,
  `start`,
  `end`,
  `reference_bases`,
  `alternate_bases`
FROM `spider2-public-data.1000_genomes.variants`
WHERE `reference_name` = '17'
  AND `start` BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 2. Distinct sets of alternate bases observed in that region
SELECT DISTINCT
  ARRAY_TO_STRING(`alternate_bases`, ',') AS alt_bases
FROM `spider2-public-data.1000_genomes.variants`
WHERE `reference_name` = '17'
  AND `start` BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 3. What types of variants (VT) are present?
SELECT DISTINCT
  `VT`
FROM `spider2-public-data.1000_genomes.variants`
WHERE `reference_name` = '17'
  AND `start` BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 4. Inspect 1KG-wide allele-frequency fields
SELECT
  `start`,
  `AF`,            -- overall 1KG
  `AF1`,           -- minor-allele freq.
  `AFR_AF`, `AMR_AF`, `EUR_AF`, `ASN_AF`
FROM `spider2-public-data.1000_genomes.variants`
WHERE `reference_name` = '17'
  AND `start` BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 5. Hardy-Weinberg equilibrium P-values already provided by 1KG
SELECT
  `start`,
  `HWE`
FROM `spider2-public-data.1000_genomes.variants`
WHERE `reference_name` = '17'
  AND `start` BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 6. Un-nest the `call` array and attach each sample’s genotype sum (0,1,2 …)
SELECT
  v.`start`,
  c.call_set_name,
  (SELECT IFNULL(SUM(g),0) FROM UNNEST(c.genotype) AS g) AS genotype_sum
FROM `spider2-public-data.1000_genomes.variants` AS v,
     UNNEST(v.call)                AS c
WHERE v.`reference_name` = '17'
  AND v.`start` BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 7. Aggregate observed genotype counts (AA, Aa, aa) per variant
SELECT
  v.`start`,
  COUNT(*)                                        AS total_genotypes,
  COUNTIF(genotype_sum = 0)                       AS hom_ref_cnt,
  COUNTIF(genotype_sum = 1)                       AS het_cnt,
  COUNTIF(genotype_sum >= 2)                      AS hom_alt_cnt
FROM `spider2-public-data.1000_genomes.variants` AS v,
     UNNEST(v.call)                               AS c,
     UNNEST([STRUCT(
         (SELECT IFNULL(SUM(g),0) FROM UNNEST(c.genotype) AS g) AS genotype_sum
     )])                                          AS gs
WHERE v.`reference_name` = '17'
  AND v.`start` BETWEEN 41196311 AND 41277499
GROUP BY v.`start`
LIMIT 20;
```

```sql
-- 8. Add allele counts, allele freq., and H-W expected counts
WITH obs AS (
  SELECT
    v.`start`,
    COUNT(*)                                       AS total_geno,
    SUM(genotype_sum)                              AS alt_allele_cnt
  FROM `spider2-public-data.1000_genomes.variants` v,
       UNNEST(v.call)                              c,
       UNNEST([STRUCT(
           (SELECT IFNULL(SUM(g),0) FROM UNNEST(c.genotype) g) AS genotype_sum
       )])                                         gs
  WHERE v.`reference_name` = '17'
    AND v.`start` BETWEEN 41196311 AND 41277499
  GROUP BY v.`start`
)
SELECT
  `start`,
  total_geno,
  alt_allele_cnt                                 AS alt_cnt,
  alt_allele_cnt / (2*total_geno)                AS alt_freq,
  POW(1 - alt_allele_cnt/(2*total_geno),2)*total_geno                      AS exp_hom_ref,
  2*(alt_allele_cnt/(2*total_geno))*(1 - alt_allele_cnt/(2*total_geno))*total_geno AS exp_het,
  POW(alt_allele_cnt/(2*total_geno),2)*total_geno                         AS exp_hom_alt
FROM obs
LIMIT 20;
```

```sql
-- 9. Compute the Pearson χ² statistic for H-W equilibrium per variant
WITH geno AS (
  SELECT
    v.`start`,
    COUNT(*)                                        AS total,
    COUNTIF(gs=0)                                   AS obs_AA,
    COUNTIF(gs=1)                                   AS obs_Aa,
    COUNTIF(gs>=2)                                  AS obs_aa,
    SUM(gs)                                         AS alt_cnt
  FROM `spider2-public-data.1000_genomes.variants` v,
       UNNEST(v.call)                               c,
       UNNEST([STRUCT(
           (SELECT IFNULL(SUM(g),0) FROM UNNEST(c.genotype) g) AS gs
       )])                                          tmp
  WHERE v.`reference_name` = '17'
    AND v.`start` BETWEEN 41196311 AND 41277499
  GROUP BY v.`start`
)
SELECT
  *,
  -- compute p, q, expected counts, and χ²
  POW(1-q,2)*total                       AS exp_AA,
  2*q*(1-q)*total                        AS exp_Aa,
  POW(q,2)*total                         AS exp_aa,
  ((obs_AA-POW(1-q,2)*total)*(obs_AA-POW(1-q,2)*total)/(POW(1-q,2)*total) +
   (obs_Aa-2*q*(1-q)*total)*(obs_Aa-2*q*(1-q)*total)/(2*q*(1-q)*total)   +
   (obs_aa-POW(q,2)*total)*(obs_aa-POW(q,2)*total)/(POW(q,2)*total) )    AS chi_sq
FROM (
  SELECT *,
         alt_cnt/(2*total) AS q          -- minor-allele frequency
  FROM geno
)                                         
LIMIT 20;
```

```sql
-- 10. Final answer: every required field for each variant (20 rows shown)
WITH per_variant AS (
  SELECT
    v.`reference_name`,
    v.`start`,
    v.`end`,
    v.`reference_bases`,
    ARRAY_TO_STRING(v.`alternate_bases`, ',') AS alt_bases,
    v.`VT`                                    AS variant_type,
    COUNT(*)                                  AS total_geno,
    COUNTIF(gs = 0)                           AS obs_hom_ref,
    COUNTIF(gs = 1)                           AS obs_het,
    COUNTIF(gs >= 2)                          AS obs_hom_alt,
    SUM(gs)                                   AS alt_cnt,
    v.`AF`                                    AS af_overall_1kg,
    v.`AFR_AF`, v.`AMR_AF`, v.`EUR_AF`, v.`ASN_AF`
  FROM `spider2-public-data.1000_genomes.variants` v,
       UNNEST(v.call)                         AS c,
       UNNEST([STRUCT(
           (SELECT IFNULL(SUM(g),0) FROM UNNEST(c.genotype) g) AS gs
       )])                                    AS tmp
  WHERE v.`reference_name` = '17'
    AND v.`start` BETWEEN 41196311 AND 41277499
  GROUP BY
    v.`reference_name`, v.`start`, v.`end`,
    v.`reference_bases`, alt_bases, v.`VT`,
    v.`AF`, v.`AFR_AF`, v.`AMR_AF`, v.`EUR_AF`, v.`ASN_AF`
)
SELECT
  *,
  alt_cnt / (2*total_geno)                                   AS alt_freq_computed,
  -- Expected genotype counts under H-W
  POW(1 - alt_cnt/(2*total_geno),2)*total_geno              AS exp_hom_ref,
  2*(alt_cnt/(2*total_geno))*(1 - alt_cnt/(2*total_geno))*total_geno AS exp_het,
  POW(alt_cnt/(2*total_geno),2)*total_geno                  AS exp_hom_alt,
  -- Pearson χ²
  ((obs_hom_ref - POW(1 - alt_cnt/(2*total_geno),2)*total_geno)
     * (obs_hom_ref - POW(1 - alt_cnt/(2*total_geno),2)*total_geno)
     / (POW(1 - alt_cnt/(2*total_geno),2)*total_geno)
   +
   (obs_het - 2*(alt_cnt/(2*total_geno))*(1 - alt_cnt/(2*total_geno))*total_geno)
     * (obs_het - 2*(alt_cnt/(2*total_geno))*(1 - alt_cnt/(2*total_geno))*total_geno)
     / (2*(alt_cnt/(2*total_geno))*(1 - alt_cnt/(2*total_geno))*total_geno)
   +
   (obs_hom_alt - POW(alt_cnt/(2*total_geno),2)*total_geno)
     * (obs_hom_alt - POW(alt_cnt/(2*total_geno),2)*total_geno)
     / (POW(alt_cnt/(2*total_geno),2)*total_geno)
  )                                                         AS chi_squared_hw
FROM per_variant
LIMIT 20;
```

Each query builds on the previous ones—from simple selection, through genotype unnesting, to the comprehensive final query—which returns every item requested (reference / alternate alleles, variant type, χ², genotype counts & expectations, plus allele-frequency fields already provided by the 1000 Genomes Project).
