```sql
--Description:  End-to-end Hardy-Weinberg summary for every variant on chromosome 17
--              between positions 41 196 311 and 41 277 499.  The query
--              1) unnests each sample’s genotype to count 0/1/2 alt alleles,
--              2) aggregates observed genotype counts per variant,
--              3) derives allele frequency, H-W expected counts, and Pearson χ²,
--              4) returns these along with reference / alternate alleles,
--              variant type, and 1 KG allele-frequency fields.  Column “end”
--              is renamed pos_end to avoid the previous parser error.
WITH per_call AS (
  SELECT
    v.reference_name,
    v.start                     AS pos_start,
    v.end                       AS pos_end,
    v.reference_bases,
    ARRAY_TO_STRING(v.alternate_bases, ',')          AS alt_bases,
    v.VT                                           AS variant_type,
    v.AF                                           AS af_overall_1kg,
    v.AFR_AF, v.AMR_AF, v.EUR_AF, v.ASN_AF,
    (SELECT IFNULL(SUM(g),0) FROM UNNEST(c.genotype) g) AS gsum   -- 0,1,2
  FROM `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  WHERE v.reference_name = '17'
    AND v.start BETWEEN 41196311 AND 41277499
),
agg AS (
  SELECT
    reference_name,
    pos_start,
    pos_end,
    reference_bases,
    alt_bases,
    variant_type,
    ANY_VALUE(af_overall_1kg) AS af_overall_1kg,
    ANY_VALUE(AFR_AF)        AS afr_af,
    ANY_VALUE(AMR_AF)        AS amr_af,
    ANY_VALUE(EUR_AF)        AS eur_af,
    ANY_VALUE(ASN_AF)        AS asn_af,
    COUNT(*)                 AS total_geno,
    COUNTIF(gsum = 0)        AS obs_hom_ref,
    COUNTIF(gsum = 1)        AS obs_het,
    COUNTIF(gsum >= 2)       AS obs_hom_alt,
    SUM(gsum)                AS alt_allele_cnt
  FROM per_call
  GROUP BY reference_name, pos_start, pos_end,
           reference_bases, alt_bases, variant_type
),
calc AS (
  SELECT
    *,
    alt_allele_cnt / (2 * total_geno)                          AS alt_freq,
    POW(1 - alt_allele_cnt/(2*total_geno),2) * total_geno      AS exp_hom_ref,
    2 * alt_allele_cnt/(2*total_geno)
      * (1 - alt_allele_cnt/(2*total_geno)) * total_geno       AS exp_het,
    POW(alt_allele_cnt/(2*total_geno),2) * total_geno          AS exp_hom_alt
  FROM agg
)
SELECT
  reference_name,
  pos_start          AS start,
  pos_end            AS end,
  reference_bases,
  alt_bases,
  variant_type,
  -- Pearson χ² statistic for Hardy-Weinberg equilibrium
  ( (obs_hom_ref - exp_hom_ref)*(obs_hom_ref - exp_hom_ref)/NULLIF(exp_hom_ref ,0) +
    (obs_het     - exp_het    )*(obs_het     - exp_het    )/NULLIF(exp_het     ,0) +
    (obs_hom_alt - exp_hom_alt)*(obs_hom_alt - exp_hom_alt)/NULLIF(exp_hom_alt ,0) ) AS chi_squared_hw,
  total_geno,
  obs_hom_ref, obs_het, obs_hom_alt,
  exp_hom_ref,  exp_het,  exp_hom_alt,
  alt_freq,
  af_overall_1kg, afr_af, amr_af, eur_af, asn_af
FROM calc
ORDER BY pos_start
LIMIT 100;
```
