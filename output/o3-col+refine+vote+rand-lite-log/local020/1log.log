```sql
--Description: Count wickets credited to each bowler (excluding run-outs)
SELECT bb."bowler",
       COUNT(*) AS "wickets"
FROM "ball_by_ball"   AS bb
JOIN "wicket_taken"   AS w
  ON w."match_id" = bb."match_id"
 AND w."over_id"  = bb."over_id"
 AND w."ball_id"  = bb."ball_id"
WHERE w."kind_out" NOT LIKE 'run out'
GROUP BY bb."bowler"
LIMIT 20;
```

```sql
--Description: Sum runs scored off the bat against every bowler
SELECT bb."bowler",
       SUM(bs."runs_scored") AS "runs_off_bat"
FROM "ball_by_ball"   AS bb
JOIN "batsman_scored" AS bs
  ON bs."match_id" = bb."match_id"
 AND bs."over_id"  = bb."over_id"
 AND bs."ball_id"  = bb."ball_id"
GROUP BY bb."bowler"
LIMIT 20;
```

```sql
--Description: Sum extra runs conceded by each bowler
SELECT bb."bowler",
       SUM(er."extra_runs") AS "extra_runs_conceded"
FROM "ball_by_ball" AS bb
JOIN "extra_runs"   AS er
  ON er."match_id" = bb."match_id"
 AND er."over_id"  = bb."over_id"
 AND er."ball_id"  = bb."ball_id"
GROUP BY bb."bowler"
LIMIT 20;
```

```sql
--Description: Combine runs off the bat and extras to get total runs conceded per bowler
SELECT r."bowler",
       (r."runs_off_bat" + COALESCE(e."extra_runs_conceded",0)) AS "total_runs_conceded"
FROM (  -- runs off the bat
       SELECT bb."bowler",
              SUM(bs."runs_scored") AS "runs_off_bat"
       FROM "ball_by_ball"   AS bb
       JOIN "batsman_scored" AS bs
         ON bs."match_id" = bb."match_id"
        AND bs."over_id"  = bb."over_id"
        AND bs."ball_id"  = bb."ball_id"
       GROUP BY bb."bowler"
     ) AS r
LEFT JOIN (  -- extras
       SELECT bb."bowler",
              SUM(er."extra_runs") AS "extra_runs_conceded"
       FROM "ball_by_ball" AS bb
       JOIN "extra_runs"   AS er
         ON er."match_id" = bb."match_id"
        AND er."over_id"  = bb."over_id"
        AND er."ball_id"  = bb."ball_id"
       GROUP BY bb."bowler"
     ) AS e
  ON r."bowler" = e."bowler"
LIMIT 20;
```

```sql
--Description: Compute bowling average (runs / wickets) for bowlers with ≥1 wicket
SELECT t."bowler",
       t."total_runs_conceded",
       w."wickets",
       CAST(t."total_runs_conceded" AS FLOAT) / w."wickets" AS "bowling_average"
FROM (  -- total runs conceded
       SELECT r."bowler",
              (r."runs_off_bat" + COALESCE(e."extra_runs_conceded",0)) AS "total_runs_conceded"
       FROM (SELECT bb."bowler",
                    SUM(bs."runs_scored") AS "runs_off_bat"
             FROM "ball_by_ball"   AS bb
             JOIN "batsman_scored" AS bs
               ON bs."match_id" = bb."match_id"
              AND bs."over_id"  = bb."over_id"
              AND bs."ball_id"  = bb."ball_id"
             GROUP BY bb."bowler") AS r
       LEFT JOIN (SELECT bb."bowler",
                         SUM(er."extra_runs") AS "extra_runs_conceded"
                  FROM "ball_by_ball" AS bb
                  JOIN "extra_runs"   AS er
                    ON er."match_id" = bb."match_id"
                   AND er."over_id"  = bb."over_id"
                   AND er."ball_id"  = bb."ball_id"
                  GROUP BY bb."bowler") AS e
         ON r."bowler" = e."bowler"
     ) AS t
JOIN (  -- wickets
      SELECT bb."bowler",
             COUNT(*) AS "wickets"
      FROM "ball_by_ball"   AS bb
      JOIN "wicket_taken"   AS w
        ON w."match_id" = bb."match_id"
       AND w."over_id"  = bb."over_id"
       AND w."ball_id"  = bb."ball_id"
      WHERE w."kind_out" NOT LIKE 'run out'
      GROUP BY bb."bowler") AS w
  ON t."bowler" = w."bowler"
WHERE w."wickets" > 0
LIMIT 20;
```

```sql
--Description: Retrieve the bowler (player name) with the lowest bowling average
SELECT p."player_name",
       ba."bowling_average"
FROM (
      SELECT t."bowler",
             CAST(t."total_runs_conceded" AS FLOAT) / w."wickets" AS "bowling_average"
      FROM (  -- total runs conceded
             SELECT r."bowler",
                    (r."runs_off_bat" + COALESCE(e."extra_runs_conceded",0)) AS "total_runs_conceded"
             FROM (SELECT bb."bowler",
                          SUM(bs."runs_scored") AS "runs_off_bat"
                   FROM "ball_by_ball"   AS bb
                   JOIN "batsman_scored" AS bs
                     ON bs."match_id" = bb."match_id"
                    AND bs."over_id"  = bb."over_id"
                    AND bs."ball_id"  = bb."ball_id"
                   GROUP BY bb."bowler") AS r
             LEFT JOIN (SELECT bb."bowler",
                               SUM(er."extra_runs") AS "extra_runs_conceded"
                        FROM "ball_by_ball" AS bb
                        JOIN "extra_runs"   AS er
                          ON er."match_id" = bb."match_id"
                         AND er."over_id"  = bb."over_id"
                         AND er."ball_id"  = bb."ball_id"
                        GROUP BY bb."bowler") AS e
               ON r."bowler" = e."bowler"
           ) AS t
      JOIN (  -- wickets
            SELECT bb."bowler",
                   COUNT(*) AS "wickets"
            FROM "ball_by_ball"   AS bb
            JOIN "wicket_taken"   AS w
              ON w."match_id" = bb."match_id"
             AND w."over_id"  = bb."over_id"
             AND w."ball_id"  = bb."ball_id"
            WHERE w."kind_out" NOT LIKE 'run out'
            GROUP BY bb."bowler") AS w
        ON t."bowler" = w."bowler"
      WHERE w."wickets" > 0
     ) AS ba
JOIN "player" AS p
  ON p."player_id" = ba."bowler"
ORDER BY ba."bowling_average" ASC
LIMIT 1;
```
