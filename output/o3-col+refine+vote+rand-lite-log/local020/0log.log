--Description: 4) For a quick check, show every delivery with the total runs 
-- conceded by the bowler (bat + extras combined).
SELECT bb.match_id,
       bb.over_id,
       bb.ball_id,
       bb.bowler,
       COALESCE(bs.runs_scored,0)+COALESCE(er.extra_runs,0) AS total_runs_conceded
FROM ball_by_ball AS bb
LEFT JOIN batsman_scored AS bs
       ON bb.match_id = bs.match_id
      AND bb.over_id  = bs.over_id
      AND bb.ball_id  = bs.ball_id
LEFT JOIN extra_runs AS er
       ON bb.match_id = er.match_id
      AND bb.over_id  = er.over_id
      AND bb.ball_id  = er.ball_id
LIMIT 20;
