       extra_runs
FROM extra_runs
LIMIT 20;
```

```sql
--Description: 4) For a quick check, show every delivery with the total runs 
-- conceded by the bowler (bat + extras combined).
SELECT bb.match_id,
       bb.over_id,
       bb.ball_id,
       bb.bowler,
       COALESCE(bs.runs_scored,0)+COALESCE(er.extra_runs,0) AS total_runs_conceded
FROM ball_by_ball AS bb
LEFT JOIN batsman_scored AS bs
       ON bb.match_id = bs.match_id
      AND bb.over_id  = bs.over_id
      AND bb.ball_id  = bs.ball_id
LEFT JOIN extra_runs AS er
       ON bb.match_id = er.match_id
      AND bb.over_id  = er.over_id
      AND bb.ball_id  = er.ball_id
LIMIT 20;
```

```sql
--Description: 5) Identify how each wicket can be attributed to the bowler of that ball.
SELECT wt.match_id,
       wt.over_id,
       wt.ball_id,
       bb.bowler,
       wt.player_out,
       wt.kind_out
FROM wicket_taken AS wt
JOIN ball_by_ball AS bb
  ON wt.match_id = bb.match_id
 AND wt.over_id  = bb.over_id
 AND wt.ball_id  = bb.ball_id
LIMIT 20;
```

```sql
--Description: 6) Aggregate total runs conceded by every bowler.
SELECT bb.bowler,
       SUM(COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0)) AS runs_conceded
FROM ball_by_ball AS bb
LEFT JOIN batsman_scored AS bs
       ON bb.match_id = bs.match_id
      AND bb.over_id  = bs.over_id
      AND bb.ball_id  = bs.ball_id
LEFT JOIN extra_runs AS er
       ON bb.match_id = er.match_id
      AND bb.over_id  = er.over_id
      AND bb.ball_id  = er.ball_id
GROUP BY bb.bowler
LIMIT 20;
```

```sql
--Description: 7) Aggregate wickets taken by every bowler.
SELECT bb.bowler,
       COUNT(*) AS wickets
FROM wicket_taken AS wt
JOIN ball_by_ball AS bb
  ON wt.match_id = bb.match_id
 AND wt.over_id  = bb.over_id
 AND wt.ball_id  = bb.ball_id
GROUP BY bb.bowler
LIMIT 20;
```

```sql
--Description: 8) Combine the two aggregates to compute each bowler's bowling average.
SELECT rc.bowler,
       rc.runs_conceded,
       wk.wickets,
       1.0 * rc.runs_conceded / wk.wickets AS bowling_average
FROM (
        SELECT bb.bowler,
               SUM(COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0)) AS runs_conceded
        FROM ball_by_ball AS bb
        LEFT JOIN batsman_scored AS bs
               ON bb.match_id = bs.match_id
              AND bb.over_id  = bs.over_id
              AND bb.ball_id  = bs.ball_id
        LEFT JOIN extra_runs AS er
               ON bb.match_id = er.match_id
              AND bb.over_id  = er.over_id
              AND bb.ball_id  = er.ball_id
        GROUP BY bb.bowler
     ) AS rc
JOIN (
        SELECT bb.bowler,
               COUNT(*) AS wickets
        FROM wicket_taken AS wt
        JOIN ball_by_ball AS bb
          ON wt.match_id = bb.match_id
         AND wt.over_id  = bb.over_id
         AND wt.ball_id  = bb.ball_id
        GROUP BY bb.bowler
     ) AS wk
  ON rc.bowler = wk.bowler
WHERE wk.wickets > 0
LIMIT 20;
```

```sql
--Description: 9) Find the bowler(s) with the lowest bowling average and show the player’s name.
WITH run_conceded AS (
     SELECT bb.bowler,
            SUM(COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0)) AS runs_conceded
     FROM ball_by_ball AS bb
     LEFT JOIN batsman_scored AS bs
            ON bb.match_id = bs.match_id
           AND bb.over_id  = bs.over_id
           AND bb.ball_id  = bs.ball_id
     LEFT JOIN extra_runs AS er
            ON bb.match_id = er.match_id
           AND bb.over_id  = er.over_id
           AND bb.ball_id  = er.ball_id
     GROUP BY bb.bowler
), wicket_count AS (
     SELECT bb.bowler,
            COUNT(*) AS wickets
     FROM wicket_taken AS wt
     JOIN ball_by_ball AS bb
       ON wt.match_id = bb.match_id
      AND wt.over_id  = bb.over_id
      AND wt.ball_id  = bb.ball_id
     GROUP BY bb.bowler
), averages AS (
     SELECT rc.bowler,
            rc.runs_conceded,
            wc.wickets,
            1.0 * rc.runs_conceded / wc.wickets AS bowling_average
     FROM run_conceded AS rc
     JOIN wicket_count AS wc
       ON rc.bowler = wc.bowler
     WHERE wc.wickets > 0
)
SELECT p.player_name,
       a.bowling_average
FROM averages AS a
JOIN player AS p
  ON a.bowler = p.player_id
WHERE a.bowling_average = (
      SELECT MIN(bowling_average) FROM averages
)
LIMIT 20;
```
