Query:
--Description: 8) Combine the two aggregates to compute each bowler's bowling average.
SELECT rc.bowler,
       rc.runs_conceded,
       wk.wickets,
       1.0 * rc.runs_conceded / wk.wickets AS bowling_average
FROM (
        SELECT bb.bowler,
               SUM(COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0)) AS runs_conceded
        FROM ball_by_ball AS bb
        LEFT JOIN batsman_scored AS bs
               ON bb.match_id = bs.match_id
              AND bb.over_id  = bs.over_id
              AND bb.ball_id  = bs.ball_id
        LEFT JOIN extra_runs AS er
               ON bb.match_id = er.match_id
              AND bb.over_id  = er.over_id
              AND bb.ball_id  = er.ball_id
        GROUP BY bb.bowler
     ) AS rc
JOIN (
        SELECT bb.bowler,
               COUNT(*) AS wickets
        FROM wicket_taken AS wt
        JOIN ball_by_ball AS bb
          ON wt.match_id = bb.match_id
         AND wt.over_id  = bb.over_id
         AND wt.ball_id  = bb.ball_id
        GROUP BY bb.bowler
     ) AS wk
  ON rc.bowler = wk.bowler
WHERE wk.wickets > 0
LIMIT 20;
