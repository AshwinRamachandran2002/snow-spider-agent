```sql
-- 1. Look at some bowlers who actually delivered the ball
SELECT DISTINCT bb."bowler"
FROM "ball_by_ball" AS bb
LIMIT 20;
```

```sql
-- 2. Map a few of those bowler-ids to names
SELECT DISTINCT p."player_id", p."player_name"
FROM "player" AS p
WHERE p."player_id" IN (
    SELECT bb."bowler"
    FROM "ball_by_ball" AS bb
    LIMIT 20
)
LIMIT 20;
```

```sql
-- 3. How many wickets did each bowler take?
SELECT bb."bowler",
       COUNT(*) AS "wickets"
FROM "wicket_taken"  AS wt
JOIN "ball_by_ball" AS bb  USING ("match_id","over_id","ball_id","innings_no")
GROUP BY bb."bowler"
ORDER BY "wickets" DESC
LIMIT 20;
```

```sql
-- 4. Runs scored off the bat against every bowler
SELECT bb."bowler",
       SUM(bs."runs_scored") AS "bat_runs"
FROM   "ball_by_ball"  AS bb
JOIN   "batsman_scored" AS bs
       USING ("match_id","over_id","ball_id","innings_no")
GROUP  BY bb."bowler"
ORDER  BY "bat_runs" DESC
LIMIT 20;
```

```sql
-- 5. Extra-runs conceded by each bowler
SELECT bb."bowler",
       SUM(er."extra_runs") AS "extra_runs"
FROM   "ball_by_ball" AS bb
JOIN   "extra_runs"   AS er
       USING ("match_id","over_id","ball_id","innings_no")
GROUP  BY bb."bowler"
ORDER  BY "extra_runs" DESC
LIMIT 20;
```

```sql
-- 6. Total runs (bat + extras) conceded by every bowler
SELECT rc."bowler",
       rc."bat_runs" + COALESCE(er."extra_runs",0) AS "total_runs"
FROM  (
        SELECT bb."bowler",
               SUM(bs."runs_scored") AS "bat_runs"
        FROM   "ball_by_ball"  AS bb
        JOIN   "batsman_scored" AS bs
               USING ("match_id","over_id","ball_id","innings_no")
        GROUP  BY bb."bowler"
      ) AS rc
LEFT JOIN (
        SELECT bb."bowler",
               SUM(er."extra_runs") AS "extra_runs"
        FROM   "ball_by_ball" AS bb
        JOIN   "extra_runs"   AS er
               USING ("match_id","over_id","ball_id","innings_no")
        GROUP  BY bb."bowler"
) AS er
ON rc."bowler" = er."bowler"
LIMIT 20;
```

```sql
-- 7. Combine wickets & runs to get bowling average for every bowler
WITH wicket_ct AS (
        SELECT bb."bowler",
               COUNT(*) AS "wickets"
        FROM   "wicket_taken"  AS wt
        JOIN   "ball_by_ball" AS bb
               USING ("match_id","over_id","ball_id","innings_no")
        GROUP  BY bb."bowler"
),
run_ct AS (
        SELECT rc."bowler",
               rc."bat_runs" + COALESCE(er."extra_runs",0) AS "runs"
        FROM  (
                SELECT bb."bowler",
                       SUM(bs."runs_scored") AS "bat_runs"
                FROM   "ball_by_ball"  AS bb
                JOIN   "batsman_scored" AS bs
                       USING ("match_id","over_id","ball_id","innings_no")
                GROUP  BY bb."bowler"
        ) AS rc
        LEFT JOIN (
                SELECT bb."bowler",
                       SUM(er."extra_runs") AS "extra_runs"
                FROM   "ball_by_ball" AS bb
                JOIN   "extra_runs"   AS er
                       USING ("match_id","over_id","ball_id","innings_no")
                GROUP  BY bb."bowler"
        ) AS er
        ON rc."bowler" = er."bowler"
)
SELECT p."player_name",
       ROUND(1.0 * r."runs" / w."wickets", 2) AS "bowling_average",
       w."wickets",
       r."runs"
FROM   wicket_ct AS w
JOIN   run_ct    AS r ON w."bowler" = r."bowler"
JOIN   "player"  AS p ON p."player_id" = w."bowler"
WHERE  w."wickets" > 0
ORDER  BY "bowling_average" ASC
LIMIT 20;
```

```sql
-- 8. The single bowler with the lowest bowling average
WITH wicket_ct AS (
        SELECT bb."bowler",
               COUNT(*) AS "wickets"
        FROM   "wicket_taken"  AS wt
        JOIN   "ball_by_ball" AS bb
               USING ("match_id","over_id","ball_id","innings_no")
        GROUP  BY bb."bowler"
),
run_ct AS (
        SELECT rc."bowler",
               rc."bat_runs" + COALESCE(er."extra_runs",0) AS "runs"
        FROM  (
                SELECT bb."bowler",
                       SUM(bs."runs_scored") AS "bat_runs"
                FROM   "ball_by_ball"  AS bb
                JOIN   "batsman_scored" AS bs
                       USING ("match_id","over_id","ball_id","innings_no")
                GROUP  BY bb."bowler"
        ) AS rc
        LEFT JOIN (
                SELECT bb."bowler",
                       SUM(er."extra_runs") AS "extra_runs"
                FROM   "ball_by_ball" AS bb
                JOIN   "extra_runs"   AS er
                       USING ("match_id","over_id","ball_id","innings_no")
                GROUP  BY bb."bowler"
        ) AS er
        ON rc."bowler" = er."bowler"
)
SELECT p."player_name"
FROM   wicket_ct AS w
JOIN   run_ct    AS r ON w."bowler" = r."bowler"
JOIN   "player"  AS p ON p."player_id" = w."bowler"
WHERE  w."wickets" > 0
ORDER  BY 1.0 * r."runs" / w."wickets" ASC
LIMIT 1;
```

