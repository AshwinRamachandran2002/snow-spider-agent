        SELECT bb."bowler",
               SUM(er."extra_runs") AS "extra_runs"
        FROM   "ball_by_ball" AS bb
        JOIN   "extra_runs"   AS er
               USING ("match_id","over_id","ball_id","innings_no")
        GROUP  BY bb."bowler"
) AS er
ON rc."bowler" = er."bowler"
