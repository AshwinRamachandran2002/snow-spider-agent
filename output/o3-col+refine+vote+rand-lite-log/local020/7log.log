```sql
--Description: 1) Inspect a random sample of deliveries to see bowler ids involved  
SELECT DISTINCT "match_id", "over_id", "ball_id", "bowler" 
FROM "ball_by_ball" 
LIMIT 20;
```

```sql
--Description: 2) Map those bowler-ids to player names  
SELECT DISTINCT p."player_id", p."player_name" 
FROM "player" AS p
JOIN "ball_by_ball" AS b
  ON p."player_id" = b."bowler"
LIMIT 20;
```

```sql
--Description: 3) Look at runs off the bat on each delivery together with the bowler  
SELECT DISTINCT b."bowler", s."runs_scored" 
FROM "ball_by_ball" AS b
JOIN "batsman_scored" AS s
  ON b."match_id" = s."match_id"
 AND b."over_id"  = s."over_id"
 AND b."ball_id"  = s."ball_id"
 AND b."innings_no" = s."innings_no"
LIMIT 20;
```

```sql
--Description: 4) Examine extra runs (wides, no-balls, etc.) conceded by each bowler  
SELECT DISTINCT b."bowler", e."extra_type", e."extra_runs" 
FROM "ball_by_ball" AS b
JOIN "extra_runs" AS e
  ON b."match_id" = e."match_id"
 AND b."over_id"  = e."over_id"
 AND b."ball_id"  = e."ball_id"
 AND b."innings_no" = e."innings_no"
LIMIT 20;
```

```sql
--Description: 5) List wickets and the bowler responsible for each dismissal  
SELECT DISTINCT p."player_name" AS "bowler_name", w."player_out", w."kind_out" 
FROM "player" AS p
JOIN "ball_by_ball" AS b  ON p."player_id" = b."bowler"
JOIN "wicket_taken" AS w ON b."match_id" = w."match_id"
                         AND b."over_id"  = w."over_id"
                         AND b."ball_id"  = w."ball_id"
                         AND b."innings_no" = w."innings_no"
LIMIT 20;
```

```sql
--Description: 6) Calculate total runs conceded (off the bat + all extras) by each bowler  
SELECT b."bowler",
       SUM(COALESCE(s."runs_scored",0) + COALESCE(e."extra_runs",0)) AS "total_runs_conceded"
FROM "ball_by_ball" AS b
LEFT JOIN "batsman_scored" AS s
       ON b."match_id" = s."match_id"
      AND b."over_id"  = s."over_id"
      AND b."ball_id"  = s."ball_id"
      AND b."innings_no" = s."innings_no"
LEFT JOIN "extra_runs"   AS e
       ON b."match_id" = e."match_id"
      AND b."over_id"  = e."over_id"
      AND b."ball_id"  = e."ball_id"
      AND b."innings_no" = e."innings_no"
GROUP BY b."bowler"
LIMIT 20;
```

```sql
--Description: 7) Compute total wickets taken by each bowler  
SELECT b."bowler",
       COUNT(*) AS "wickets"
FROM "ball_by_ball" AS b
JOIN "wicket_taken" AS w
  ON b."match_id" = w."match_id"
 AND b."over_id"  = w."over_id"
 AND b."ball_id"  = w."ball_id"
 AND b."innings_no" = w."innings_no"
GROUP BY b."bowler"
LIMIT 20;
```

```sql
--Description: 8) Combine runs conceded and wickets to derive bowling average (runs per wicket)  
SELECT r."bowler",
       r."total_runs_conceded",
       w."wickets",
       CAST(r."total_runs_conceded" AS FLOAT) / w."wickets" AS "bowling_average"
FROM (
      SELECT b."bowler",
             SUM(COALESCE(s."runs_scored",0) + COALESCE(e."extra_runs",0)) AS "total_runs_conceded"
      FROM "ball_by_ball" AS b
      LEFT JOIN "batsman_scored" AS s
             ON b."match_id" = s."match_id"
            AND b."over_id"  = s."over_id"
            AND b."ball_id"  = s."ball_id"
            AND b."innings_no" = s."innings_no"
      LEFT JOIN "extra_runs"   AS e
             ON b."match_id" = e."match_id"
            AND b."over_id"  = e."over_id"
            AND b."ball_id"  = e."ball_id"
            AND b."innings_no" = e."innings_no"
      GROUP BY b."bowler"
     ) AS r
JOIN (
      SELECT b."bowler",
             COUNT(*) AS "wickets"
      FROM "ball_by_ball" AS b
      JOIN "wicket_taken" AS w
        ON b."match_id" = w."match_id"
       AND b."over_id"  = w."over_id"
       AND b."ball_id"  = w."ball_id"
       AND b."innings_no" = w."innings_no"
      GROUP BY b."bowler"
     ) AS w
 ON r."bowler" = w."bowler"
WHERE w."wickets" > 0
LIMIT 20;
```

```sql
--Description: 9) Order the bowling averages in ascending order to locate the lowest value  
SELECT p."player_name", t."bowling_average"
FROM (
      SELECT r."bowler",
             CAST(r."total_runs_conceded" AS FLOAT) / w."wickets" AS "bowling_average"
      FROM (
            SELECT b."bowler",
                   SUM(COALESCE(s."runs_scored",0) + COALESCE(e."extra_runs",0)) AS "total_runs_conceded"
            FROM "ball_by_ball" AS b
            LEFT JOIN "batsman_scored" AS s
                   ON b."match_id" = s."match_id"
                  AND b."over_id"  = s."over_id"
                  AND b."ball_id"  = s."ball_id"
                  AND b."innings_no" = s."innings_no"
            LEFT JOIN "extra_runs"   AS e
                   ON b."match_id" = e."match_id"
                  AND b."over_id"  = e."over_id"
                  AND b."ball_id"  = e."ball_id"
                  AND b."innings_no" = e."innings_no"
            GROUP BY b."bowler"
           ) AS r
      JOIN (
            SELECT b."bowler",
                   COUNT(*) AS "wickets"
            FROM "ball_by_ball" AS b
            JOIN "wicket_taken" AS w
              ON b."match_id" = w."match_id"
             AND b."over_id"  = w."over_id"
             AND b."ball_id"  = w."ball_id"
             AND b."innings_no" = w."innings_no"
            GROUP BY b."bowler"
           ) AS w
       ON r."bowler" = w."bowler"
      WHERE w."wickets" > 0
     ) AS t
JOIN "player" AS p
  ON p."player_id" = t."bowler"
ORDER BY t."bowling_average" ASC
LIMIT 20;
```

```sql
--Description: 10) Return the single bowler with the absolute lowest bowling average  
SELECT p."player_name" AS "best_bowler",
       MIN(t."bowling_average") AS "lowest_bowling_average"
FROM (
      SELECT r."bowler",
             CAST(r."total_runs_conceded" AS FLOAT) / w."wickets" AS "bowling_average"
      FROM (
            SELECT b."bowler",
                   SUM(COALESCE(s."runs_scored",0) + COALESCE(e."extra_runs",0)) AS "total_runs_conceded"
            FROM "ball_by_ball" AS b
            LEFT JOIN "batsman_scored" AS s
                   ON b."match_id" = s."match_id"
                  AND b."over_id"  = s."over_id"
                  AND b."ball_id"  = s."ball_id"
                  AND b."innings_no" = s."innings_no"
            LEFT JOIN "extra_runs"   AS e
                   ON b."match_id" = e."match_id"
                  AND b."over_id"  = e."over_id"
                  AND b."ball_id"  = e."ball_id"
                  AND b."innings_no" = e."innings_no"
            GROUP BY b."bowler"
           ) AS r
      JOIN (
            SELECT b."bowler",
                   COUNT(*) AS "wickets"
            FROM "ball_by_ball" AS b
            JOIN "wicket_taken" AS w
              ON b."match_id" = w."match_id"
             AND b."over_id"  = w."over_id"
             AND b."ball_id"  = w."ball_id"
             AND b."innings_no" = w."innings_no"
            GROUP BY b."bowler"
           ) AS w
       ON r."bowler" = w."bowler"
      WHERE w."wickets" > 0
     ) AS t
JOIN "player" AS p
  ON p."player_id" = t."bowler";
```
