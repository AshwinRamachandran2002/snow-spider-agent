```sql
--Description: ① Inspect a few bowler-ids present in the deliveries table.
SELECT DISTINCT bowler
FROM ball_by_ball
LIMIT 20;
```

```sql
--Description: ② Map some of those bowler-ids to their names.
SELECT DISTINCT p.player_id, p.player_name
FROM player AS p
WHERE p.player_id IN (SELECT bowler FROM ball_by_ball)
LIMIT 20;
```

```sql
--Description: ③ Count the number of legal deliveries each bowler has bowled (sample).
SELECT b.bowler, COUNT(*) AS balls_bowled
FROM ball_by_ball AS b
GROUP BY b.bowler
ORDER BY balls_bowled DESC
LIMIT 20;
```

```sql
--Description: ④ Sum the batsman-runs conceded by every bowler (sample).
SELECT b.bowler, SUM(bs.runs_scored) AS batsman_runs
FROM ball_by_ball AS b
JOIN batsman_scored AS bs
  ON b.match_id = bs.match_id
 AND b.over_id  = bs.over_id
 AND b.ball_id  = bs.ball_id
 AND b.innings_no = bs.innings_no
GROUP BY b.bowler
ORDER BY batsman_runs DESC
LIMIT 20;
```

```sql
--Description: ⑤ Sum the extra-runs (wides, no-balls, etc.) conceded by every bowler (sample).
SELECT b.bowler, SUM(COALESCE(er.extra_runs,0)) AS extra_runs
FROM ball_by_ball AS b
LEFT JOIN extra_runs AS er
  ON b.match_id = er.match_id
 AND b.over_id  = er.over_id
 AND b.ball_id  = er.ball_id
 AND b.innings_no = er.innings_no
GROUP BY b.bowler
ORDER BY extra_runs DESC
LIMIT 20;
```

```sql
--Description: ⑥ Show how total runs per delivery are gathered from the three tables (first 20 balls).
SELECT b.match_id, b.over_id, b.ball_id, b.bowler,
       bs.runs_scored                        AS batsman_runs,
       COALESCE(er.extra_runs,0)             AS extra_runs,
       bs.runs_scored + COALESCE(er.extra_runs,0) AS total_runs
FROM ball_by_ball AS b
JOIN batsman_scored AS bs
  ON b.match_id = bs.match_id
 AND b.over_id  = bs.over_id
 AND b.ball_id  = bs.ball_id
 AND b.innings_no = bs.innings_no
LEFT JOIN extra_runs AS er
  ON b.match_id = er.match_id
 AND b.over_id  = er.over_id
 AND b.ball_id  = er.ball_id
 AND b.innings_no = er.innings_no
LIMIT 20;
```

```sql
--Description: ⑦ Aggregate total runs conceded by each bowler.
SELECT b.bowler,
       SUM(bs.runs_scored + COALESCE(er.extra_runs,0)) AS runs_conceded
FROM ball_by_ball AS b
JOIN batsman_scored AS bs
  ON b.match_id = bs.match_id
 AND b.over_id  = bs.over_id
 AND b.ball_id  = bs.ball_id
 AND b.innings_no = bs.innings_no
LEFT JOIN extra_runs AS er
  ON b.match_id = er.match_id
 AND b.over_id  = er.over_id
 AND b.ball_id  = er.ball_id
 AND b.innings_no = er.innings_no
GROUP BY b.bowler
ORDER BY runs_conceded DESC
LIMIT 20;
```

```sql
--Description: ⑧ Count wickets credited to each bowler (excluding run-outs, which aren’t charged to the bowler).
SELECT b.bowler,
       COUNT(*) AS wickets
FROM wicket_taken AS w
JOIN ball_by_ball AS b
  ON b.match_id = w.match_id
 AND b.over_id  = w.over_id
 AND b.ball_id  = w.ball_id
 AND b.innings_no = w.innings_no
WHERE w.kind_out <> 'run out'
GROUP BY b.bowler
ORDER BY wickets DESC
LIMIT 20;
```

```sql
--Description: ⑨ Build a temporary result combining runs conceded & wickets to compute bowling averages.
SELECT rc.bowler,
       rc.runs_conceded,
       wk.wickets,
       ROUND(1.0 * rc.runs_conceded / wk.wickets, 2) AS bowling_average
FROM
  (SELECT b.bowler,
          SUM(bs.runs_scored + COALESCE(er.extra_runs,0)) AS runs_conceded
   FROM ball_by_ball AS b
   JOIN batsman_scored AS bs
     ON b.match_id = bs.match_id
    AND b.over_id  = bs.over_id
    AND b.ball_id  = bs.ball_id
    AND b.innings_no = bs.innings_no
   LEFT JOIN extra_runs AS er
     ON b.match_id = er.match_id
    AND b.over_id  = er.over_id
    AND b.ball_id  = er.ball_id
    AND b.innings_no = er.innings_no
   GROUP BY b.bowler) AS rc
JOIN
  (SELECT b.bowler,
          COUNT(*) AS wickets
   FROM wicket_taken AS w
   JOIN ball_by_ball AS b
     ON b.match_id = w.match_id
    AND b.over_id  = w.over_id
    AND b.ball_id  = w.ball_id
    AND b.innings_no = w.innings_no
   WHERE w.kind_out <> 'run out'
   GROUP BY b.bowler) AS wk
ON rc.bowler = wk.bowler
WHERE wk.wickets > 0
ORDER BY bowling_average ASC
LIMIT 20;
```

```sql
--Description: ⑩ Final answer – the bowler with the lowest bowling average in the entire dataset.
SELECT p.player_name,
       ROUND(1.0 * rc.runs_conceded / wk.wickets, 2) AS bowling_average
FROM
  (SELECT b.bowler,
          SUM(bs.runs_scored + COALESCE(er.extra_runs,0)) AS runs_conceded
   FROM ball_by_ball AS b
   JOIN batsman_scored AS bs
     ON b.match_id = bs.match_id
    AND b.over_id  = bs.over_id
    AND b.ball_id  = bs.ball_id
    AND b.innings_no = bs.innings_no
   LEFT JOIN extra_runs AS er
     ON b.match_id = er.match_id
    AND b.over_id  = er.over_id
    AND b.ball_id  = er.ball_id
    AND b.innings_no = er.innings_no
   GROUP BY b.bowler) AS rc
JOIN
  (SELECT b.bowler,
          COUNT(*) AS wickets
   FROM wicket_taken AS w
   JOIN ball_by_ball AS b
     ON b.match_id = w.match_id
    AND b.over_id  = w.over_id
    AND b.ball_id  = w.ball_id
    AND b.innings_no = w.innings_no
   WHERE w.kind_out <> 'run out'
   GROUP BY b.bowler) AS wk
ON rc.bowler = wk.bowler
JOIN player AS p
  ON p.player_id = rc.bowler
WHERE wk.wickets > 0
ORDER BY bowling_average ASC
LIMIT 1;
```
