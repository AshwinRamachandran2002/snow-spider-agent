Query:
--Description: 9) FINAL – Bowler having the lowest bowling average
SELECT p.player_name, ba.bowling_average
FROM (
    SELECT tr.bowler,
           CAST(tr.total_runs AS REAL) / w.wickets AS bowling_average
    FROM (
        SELECT r1.bowler,
               r1.bat_runs + COALESCE(r2.extra_runs,0) AS total_runs
        FROM (
            SELECT bb.bowler, SUM(bs.runs_scored) AS bat_runs
            FROM batsman_scored AS bs
            JOIN ball_by_ball AS bb
              ON bb.match_id = bs.match_id
             AND bb.over_id  = bs.over_id
             AND bb.ball_id  = bs.ball_id
            GROUP BY bb.bowler
        ) AS r1
        LEFT JOIN (
            SELECT bb.bowler, SUM(er.extra_runs) AS extra_runs
            FROM extra_runs AS er
            JOIN ball_by_ball AS bb
              ON bb.match_id = er.match_id
             AND bb.over_id  = er.over_id
             AND bb.ball_id  = er.ball_id
            GROUP BY bb.bowler
        ) AS r2
        ON r1.bowler = r2.bowler
    ) AS tr
    JOIN (
        SELECT bb.bowler, COUNT(*) AS wickets
        FROM wicket_taken AS w
        JOIN ball_by_ball AS bb
          ON bb.match_id = w.match_id
         AND bb.over_id  = w.over_id
         AND bb.ball_id  = w.ball_id
        GROUP BY bb.bowler
    ) AS w
    ON tr.bowler = w.bowler
    WHERE w.wickets > 0
) AS ba
JOIN player AS p
ON p.player_id = ba.bowler
ORDER BY ba.bowling_average ASC
LIMIT 1;
