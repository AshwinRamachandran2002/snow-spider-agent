```sql
-- Description: Peek at a few bowling records: which player-ids appear as “bowler” in ball-by-ball?
SELECT DISTINCT "bowler"
FROM "ball_by_ball"
LIMIT 20;
```

```sql
-- Description: Map those bowler-ids to player names for context.
SELECT DISTINCT p."player_id",
       p."player_name"
FROM "player" AS p
JOIN "ball_by_ball" AS b
  ON p."player_id" = b."bowler"
LIMIT 20;
```

```sql
-- Description: Look at how many wickets are linked to each (match,over,ball) and therefore each bowler.
SELECT DISTINCT w."match_id",
       w."over_id",
       w."ball_id",
       b."bowler",
       p."player_name",
       w."kind_out"
FROM "wicket_taken"  AS w
JOIN "ball_by_ball" AS b
  ON w."match_id" = b."match_id"
 AND w."over_id"   = b."over_id"
 AND w."ball_id"   = b."ball_id"
JOIN "player"      AS p
  ON p."player_id" = b."bowler"
LIMIT 20;
```

```sql
-- Description: Aggregate total wickets per bowler.
SELECT b."bowler",
       COUNT(*) AS "wickets"
FROM "wicket_taken"  AS w
JOIN "ball_by_ball" AS b
  ON w."match_id" = b."match_id"
 AND w."over_id"   = b."over_id"
 AND w."ball_id"   = b."ball_id"
GROUP BY b."bowler"
HAVING COUNT(*) > 0
LIMIT 20;
```

```sql
-- Description: Runs scored off each ball (batsman runs + any extras on that ball) for every delivery.
SELECT b."match_id",
       b."over_id",
       b."ball_id",
       b."bowler",
       COALESCE(bs."runs_scored",0)            AS "bat_runs",
       COALESCE(er."extra_runs",0)             AS "extra_runs",
       COALESCE(bs."runs_scored",0)
       + COALESCE(er."extra_runs",0)           AS "total_ball_runs"
FROM "ball_by_ball" AS b
LEFT JOIN "batsman_scored" AS bs
  ON b."match_id" = bs."match_id"
 AND b."over_id"  = bs."over_id"
 AND b."ball_id"  = bs."ball_id"
LEFT JOIN "extra_runs" AS er
  ON b."match_id" = er."match_id"
 AND b."over_id"  = er."over_id"
 AND b."ball_id"  = er."ball_id"
LIMIT 20;
```

```sql
-- Description: Aggregate total runs conceded by every bowler.
SELECT b."bowler",
       SUM( COALESCE(bs."runs_scored",0)
          + COALESCE(er."extra_runs",0) ) AS "runs_conceded"
FROM "ball_by_ball" AS b
LEFT JOIN "batsman_scored" AS bs
  ON b."match_id" = bs."match_id"
 AND b."over_id"  = bs."over_id"
 AND b."ball_id"  = bs."ball_id"
LEFT JOIN "extra_runs" AS er
  ON b."match_id" = er."match_id"
 AND b."over_id"  = er."over_id"
 AND b."ball_id"  = er."ball_id"
GROUP BY b."bowler"
LIMIT 20;
```

```sql
-- Description: Combine runs & wickets to calculate each bowler’s bowling average (runs per wicket).
WITH wickets AS (
    SELECT b."bowler",
           COUNT(*) AS wkts
    FROM "wicket_taken" AS w
    JOIN "ball_by_ball" AS b
      ON w."match_id" = b."match_id"
     AND w."over_id"  = b."over_id"
     AND w."ball_id"  = b."ball_id"
    GROUP BY b."bowler"
),
runs AS (
    SELECT b."bowler",
           SUM( COALESCE(bs."runs_scored",0)
              + COALESCE(er."extra_runs",0) ) AS runs_conceded
    FROM "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS bs
      ON b."match_id" = bs."match_id"
     AND b."over_id"  = bs."over_id"
     AND b."ball_id"  = bs."ball_id"
    LEFT JOIN "extra_runs" AS er
      ON b."match_id" = er."match_id"
     AND b."over_id"  = er."over_id"
     AND b."ball_id"  = er."ball_id"
    GROUP BY b."bowler"
)
SELECT r."bowler",
       1.0 * r."runs_conceded" / w."wkts" AS "bowling_average",
       w."wkts"
FROM runs AS r
JOIN wickets AS w
  ON r."bowler" = w."bowler"
WHERE w."wkts" > 0
LIMIT 20;
```

```sql
-- Description: List bowlers ordered by lowest bowling average.
WITH wickets AS (
    SELECT b."bowler",
           COUNT(*) AS wkts
    FROM "wicket_taken" AS w
    JOIN "ball_by_ball" AS b
      ON w."match_id" = b."match_id"
     AND w."over_id"  = b."over_id"
     AND w."ball_id"  = b."ball_id"
    GROUP BY b."bowler"
),
runs AS (
    SELECT b."bowler",
           SUM( COALESCE(bs."runs_scored",0)
              + COALESCE(er."extra_runs",0) ) AS runs_conceded
    FROM "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS bs
      ON b."match_id" = bs."match_id"
     AND b."over_id"  = bs."over_id"
     AND b."ball_id"  = bs."ball_id"
    LEFT JOIN "extra_runs" AS er
      ON b."match_id" = er."match_id"
     AND b."over_id"  = er."over_id"
     AND b."ball_id"  = er."ball_id"
    GROUP BY b."bowler"
)
SELECT p."player_name",
       r."runs_conceded",
       w."wkts",
       ROUND(1.0 * r."runs_conceded" / w."wkts",2) AS "bowling_average"
FROM runs AS r
JOIN wickets AS w
  ON r."bowler" = w."bowler"
JOIN "player" AS p
  ON p."player_id" = r."bowler"
WHERE w."wkts" > 0
ORDER BY "bowling_average" ASC
LIMIT 20;
```

```sql
-- Description: Finally, fetch the single bowler with the overall lowest bowling average.
WITH wickets AS (
    SELECT b."bowler",
           COUNT(*) AS wkts
    FROM "wicket_taken" AS w
    JOIN "ball_by_ball" AS b
      ON w."match_id" = b."match_id"
     AND w."over_id"  = b."over_id"
     AND w."ball_id"  = b."ball_id"
    GROUP BY b."bowler"
),
runs AS (
    SELECT b."bowler",
           SUM( COALESCE(bs."runs_scored",0)
              + COALESCE(er."extra_runs",0) ) AS runs_conceded
    FROM "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS bs
      ON b."match_id" = bs."match_id"
     AND b."over_id"  = bs."over_id"
     AND b."ball_id"  = bs."ball_id"
    LEFT JOIN "extra_runs" AS er
      ON b."match_id" = er."match_id"
     AND b."over_id"  = er."over_id"
     AND b."ball_id"  = er."ball_id"
    GROUP BY b."bowler"
)
SELECT p."player_name"        AS "best_bowler",
       ROUND(1.0 * r."runs_conceded" / w."wkts",2) AS "lowest_bowling_average"
FROM runs    AS r
JOIN wickets AS w
  ON r."bowler" = w."bowler"
JOIN "player" AS p
  ON p."player_id" = r."bowler"
WHERE w."wkts" > 0
ORDER BY 1.0 * r."runs_conceded" / w."wkts" ASC
LIMIT 1;
```
