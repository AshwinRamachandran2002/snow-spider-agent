-- Description: Runs scored off each ball (batsman runs + any extras on that ball) for every delivery.
SELECT b."match_id",
       b."over_id",
       b."ball_id",
       b."bowler",
       COALESCE(bs."runs_scored",0)            AS "bat_runs",
       COALESCE(er."extra_runs",0)             AS "extra_runs",
       COALESCE(bs."runs_scored",0)
       + COALESCE(er."extra_runs",0)           AS "total_ball_runs"
FROM "ball_by_ball" AS b
