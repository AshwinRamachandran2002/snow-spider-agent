SELECT DISTINCT "player_id", "player_name"
FROM "player"
LIMIT 20;
```

```sql
-- 2) Look at a handful of deliveries to understand the columns we will join on
SELECT DISTINCT "match_id", "over_id", "ball_id",
       "innings_no", "bowler", "team_bowling"
FROM "ball_by_ball"
LIMIT 20;
```

```sql
-- 3) Check how runs scored off the bat are recorded
SELECT DISTINCT "match_id", "over_id", "ball_id",
       "innings_no", "runs_scored"
FROM "batsman_scored"
LIMIT 20;
```

```sql
-- 4) Inspect the type and size of extra runs that can be charged to the bowler
SELECT DISTINCT "match_id", "over_id", "ball_id",
       "innings_no", "extra_type", "extra_runs"
FROM "extra_runs"
LIMIT 20;
```

```sql
-- 5) Inspect how a dismissal is linked to the delivery (needed for wickets)
SELECT DISTINCT "match_id", "over_id", "ball_id",
       "innings_no", "player_out", "kind_out"
FROM "wicket_taken"
LIMIT 20;
```

```sql
-- 6) Aggregate total runs conceded PER BOWLER
--    (runs off the bat + all extras on that delivery)
SELECT  b."bowler",
        SUM( COALESCE(bs."runs_scored",0)
           + COALESCE(er."extra_runs",0) )  AS "runs_conceded"
FROM            "ball_by_ball" AS b
LEFT  JOIN      "batsman_scored" AS bs
       ON  b."match_id"   = bs."match_id"
       AND b."over_id"    = bs."over_id"
       AND b."ball_id"    = bs."ball_id"
       AND b."innings_no" = bs."innings_no"
LEFT  JOIN      "extra_runs" AS er
       ON  b."match_id"   = er."match_id"
       AND b."over_id"    = er."over_id"
       AND b."ball_id"    = er."ball_id"
       AND b."innings_no" = er."innings_no"
GROUP BY b."bowler"
LIMIT 20;
```

```sql
-- 7) Aggregate total wickets taken PER BOWLER
SELECT  b."bowler",
        COUNT(*) AS "wickets"
FROM            "ball_by_ball" AS b
JOIN            "wicket_taken" AS w
       ON  b."match_id"   = w."match_id"
       AND b."over_id"    = w."over_id"
       AND b."ball_id"    = w."ball_id"
       AND b."innings_no" = w."innings_no"
GROUP BY b."bowler"
LIMIT 20;
```

```sql
-- 8) Join the two aggregates, compute bowling average,
--    list the 20 best (lowest) averages
WITH runs AS (
    SELECT  b."bowler",
            SUM( COALESCE(bs."runs_scored",0)
               + COALESCE(er."extra_runs",0) )  AS "runs_conceded"
    FROM            "ball_by_ball" AS b
    LEFT  JOIN      "batsman_scored" AS bs
           ON  b."match_id"   = bs."match_id"
           AND b."over_id"    = bs."over_id"
           AND b."ball_id"    = bs."ball_id"
           AND b."innings_no" = bs."innings_no"
    LEFT  JOIN      "extra_runs" AS er
           ON  b."match_id"   = er."match_id"
           AND b."over_id"    = er."over_id"
           AND b."ball_id"    = er."ball_id"
           AND b."innings_no" = er."innings_no"
    GROUP BY b."bowler"
), wkts AS (
    SELECT  b."bowler",
            COUNT(*) AS "wickets"
    FROM            "ball_by_ball" AS b
    JOIN            "wicket_taken" AS w
           ON  b."match_id"   = w."match_id"
           AND b."over_id"    = w."over_id"
           AND b."ball_id"    = w."ball_id"
           AND b."innings_no" = w."innings_no"
    GROUP BY b."bowler"
)
SELECT  r."bowler",
        r."runs_conceded",
        w."wickets",
        1.0 * r."runs_conceded" / w."wickets"  AS "bowling_average"
FROM    runs AS r
JOIN    wkts AS w
ON      r."bowler" = w."bowler"
WHERE   w."wickets" > 0
ORDER BY "bowling_average" ASC
LIMIT 20;
```

```sql
-- 9) FINAL: fetch the bowler who has the absolute lowest bowling average
WITH runs AS (
    SELECT  b."bowler",
            SUM( COALESCE(bs."runs_scored",0)
               + COALESCE(er."extra_runs",0) )  AS "runs_conceded"
    FROM            "ball_by_ball" AS b
    LEFT  JOIN      "batsman_scored" AS bs
           ON  b."match_id"   = bs."match_id"
           AND b."over_id"    = bs."over_id"
           AND b."ball_id"    = bs."ball_id"
           AND b."innings_no" = bs."innings_no"
    LEFT  JOIN      "extra_runs" AS er
           ON  b."match_id"   = er."match_id"
           AND b."over_id"    = er."over_id"
           AND b."ball_id"    = er."ball_id"
           AND b."innings_no" = er."innings_no"
    GROUP BY b."bowler"
), wkts AS (
    SELECT  b."bowler",
            COUNT(*) AS "wickets"
    FROM            "ball_by_ball" AS b
    JOIN            "wicket_taken" AS w
           ON  b."match_id"   = w."match_id"
           AND b."over_id"    = w."over_id"
           AND b."ball_id"    = w."ball_id"
           AND b."innings_no" = w."innings_no"
    GROUP BY b."bowler"
), avgs AS (
    SELECT  r."bowler",
            r."runs_conceded",
            w."wickets",
            1.0 * r."runs_conceded" / w."wickets"  AS "bowling_average"
    FROM    runs AS r
    JOIN    wkts AS w
    ON      r."bowler" = w."bowler"
    WHERE   w."wickets" > 0
)
SELECT      p."player_name"       AS "Best_Bowler",
            a."bowling_average"   AS "Lowest_Average"
FROM        avgs AS a
JOIN        "player" AS p
       ON   a."bowler" = p."player_id"
ORDER BY     a."bowling_average" ASC
LIMIT 1;
```
