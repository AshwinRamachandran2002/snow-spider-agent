Query:
-- Description: List only those striker–match pairs where the striker scored MORE than 50
SELECT player_id,
       player_name,
       match_id,
       total_runs
FROM (
       SELECT t1.player_id,
              p.player_name,
              t1.match_id,
              SUM(t1.runs_scored) AS total_runs
       FROM (
              SELECT bbb.match_id,
                     bbb.striker AS player_id,
                     bs.runs_scored
              FROM   ball_by_ball AS bbb
              JOIN   batsman_scored AS bs
                     ON  bbb.match_id = bs.match_id
                     AND bbb.over_id  = bs.over_id
                     AND bbb.ball_id  = bs.ball_id
            ) AS t1
       JOIN player AS p
            ON p.player_id = t1.player_id
       GROUP BY t1.player_id, t1.match_id
       HAVING total_runs > 50
     )
LIMIT 20;
