Query:
-- Description: Add player names to the previous result set
SELECT DISTINCT p.player_name,
       t1.match_id,
       t1.runs_scored
FROM  (
        SELECT bbb.match_id,
               bbb.striker AS player_id,
               bs.runs_scored
        FROM   ball_by_ball AS bbb
        JOIN   batsman_scored AS bs
               ON  bbb.match_id = bs.match_id
               AND bbb.over_id  = bs.over_id
               AND bbb.ball_id  = bs.ball_id
      ) AS t1
JOIN  player AS p
      ON p.player_id = t1.player_id
LIMIT 20;
