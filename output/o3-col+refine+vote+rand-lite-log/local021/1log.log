```sql
-- Description: Peek into how runs are recorded ball-by-ball
SELECT DISTINCT match_id, over_id, ball_id, runs_scored, innings_no
FROM batsman_scored
LIMIT 20;
```

```sql
-- Description: Look at how strikers are logged in every delivery
SELECT DISTINCT match_id, over_id, ball_id, striker
FROM ball_by_ball
LIMIT 20;
```

```sql
-- Description: Join the two previous tables to see each striker’s runs per delivery
SELECT DISTINCT bbb.match_id,
       bbb.striker          AS player_id,
       bs.runs_scored
FROM   ball_by_ball AS bbb
JOIN   batsman_scored AS bs
       ON  bbb.match_id = bs.match_id
       AND bbb.over_id  = bs.over_id
       AND bbb.ball_id  = bs.ball_id
LIMIT 20;
```

```sql
-- Description: Add player names to the previous result set
SELECT DISTINCT p.player_name,
       t1.match_id,
       t1.runs_scored
FROM  (
        SELECT bbb.match_id,
               bbb.striker AS player_id,
               bs.runs_scored
        FROM   ball_by_ball AS bbb
        JOIN   batsman_scored AS bs
               ON  bbb.match_id = bs.match_id
               AND bbb.over_id  = bs.over_id
               AND bbb.ball_id  = bs.ball_id
      ) AS t1
JOIN  player AS p
      ON p.player_id = t1.player_id
LIMIT 20;
```

```sql
-- Description: Total runs a striker scores in every match (irrespective of innings)
SELECT t1.player_id,
       p.player_name,
       t1.match_id,
       SUM(t1.runs_scored) AS total_runs
FROM (
        SELECT bbb.match_id,
               bbb.striker AS player_id,
               bs.runs_scored
        FROM   ball_by_ball AS bbb
        JOIN   batsman_scored AS bs
               ON  bbb.match_id = bs.match_id
               AND bbb.over_id  = bs.over_id
               AND bbb.ball_id  = bs.ball_id
     ) AS t1
JOIN player AS p
     ON p.player_id = t1.player_id
GROUP BY t1.player_id, t1.match_id
HAVING total_runs > 0
LIMIT 20;
```

```sql
-- Description: List only those striker–match pairs where the striker scored MORE than 50
SELECT player_id,
       player_name,
       match_id,
       total_runs
FROM (
       SELECT t1.player_id,
              p.player_name,
              t1.match_id,
              SUM(t1.runs_scored) AS total_runs
       FROM (
              SELECT bbb.match_id,
                     bbb.striker AS player_id,
                     bs.runs_scored
              FROM   ball_by_ball AS bbb
              JOIN   batsman_scored AS bs
                     ON  bbb.match_id = bs.match_id
                     AND bbb.over_id  = bs.over_id
                     AND bbb.ball_id  = bs.ball_id
            ) AS t1
       JOIN player AS p
            ON p.player_id = t1.player_id
       GROUP BY t1.player_id, t1.match_id
       HAVING total_runs > 50
     )
LIMIT 20;
```

```sql
-- Description: Compute the total runs for every striker in every match and keep only scores > 50
WITH striker_match_totals AS (
    SELECT t1.player_id,
           SUM(t1.runs_scored) AS total_runs
    FROM (
            SELECT bbb.match_id,
                   bbb.striker AS player_id,
                   bs.runs_scored
            FROM   ball_by_ball AS bbb
            JOIN   batsman_scored AS bs
                   ON  bbb.match_id = bs.match_id
                   AND bbb.over_id  = bs.over_id
                   AND bbb.ball_id  = bs.ball_id
         ) AS t1
    GROUP BY t1.player_id, t1.match_id
    HAVING total_runs > 50
)
SELECT DISTINCT *
FROM   striker_match_totals
LIMIT 20;
```

```sql
-- Description: FINAL – Average of the total runs scored by all strikers who scored >50 in a single match
WITH striker_match_totals AS (
    SELECT t1.player_id,
           SUM(t1.runs_scored) AS total_runs
    FROM (
            SELECT bbb.match_id,
                   bbb.striker AS player_id,
                   bs.runs_scored
            FROM   ball_by_ball AS bbb
            JOIN   batsman_scored AS bs
                   ON  bbb.match_id = bs.match_id
                   AND bbb.over_id  = bs.over_id
                   AND bbb.ball_id  = bs.ball_id
         ) AS t1
    GROUP BY t1.player_id, t1.match_id
    HAVING SUM(t1.runs_scored) > 50
)
SELECT AVG(total_runs) AS average_total_runs_above_50
FROM   striker_match_totals;
```
