```sql
-- Description: Check some striker ids appearing in the deliveries table
SELECT DISTINCT "striker"
FROM "ball_by_ball"
LIMIT 20;
```

```sql
-- Description: Look at the different run–values recorded for a ball
SELECT DISTINCT "runs_scored"
FROM "batsman_scored"
LIMIT 20;
```

```sql
-- Description: Peek at how runs-per-ball are stored together with the striker on the same delivery
SELECT b."match_id",
       b."over_id",
       b."ball_id",
       b."striker",
       s."runs_scored"
FROM   "ball_by_ball" AS b
JOIN   "batsman_scored" AS s
  ON   b."match_id" = s."match_id"
 AND   b."over_id"  = s."over_id"
 AND   b."ball_id"  = s."ball_id"
LIMIT 20;
```

```sql
-- Description: Aggregate total runs for every (match, striker) combination
SELECT b."match_id",
       b."striker"             AS "player_id",
       SUM(s."runs_scored")    AS "total_runs"
FROM   "ball_by_ball" AS b
JOIN   "batsman_scored" AS s
  ON   b."match_id" = s."match_id"
 AND   b."over_id"  = s."over_id"
 AND   b."ball_id"  = s."ball_id"
GROUP BY b."match_id", b."striker"
LIMIT 20;
```

```sql
-- Description: Identify only those (match, striker) records where the striker’s total exceeds 50
SELECT *
FROM (
      SELECT b."match_id",
             b."striker"          AS "player_id",
             SUM(s."runs_scored") AS "total_runs"
      FROM   "ball_by_ball" AS b
      JOIN   "batsman_scored" AS s
        ON   b."match_id" = s."match_id"
       AND   b."over_id"  = s."over_id"
       AND   b."ball_id"  = s."ball_id"
      GROUP BY b."match_id", b."striker"
) AS t
WHERE t."total_runs" > 50
LIMIT 20;
```

```sql
-- Description: Bring in player names for the 50+ scoring efforts (optional inspection)
SELECT p."player_name",
       t."match_id",
       t."total_runs"
FROM (
      SELECT b."match_id",
             b."striker"          AS "player_id",
             SUM(s."runs_scored") AS "total_runs"
      FROM   "ball_by_ball" AS b
      JOIN   "batsman_scored" AS s
        ON   b."match_id" = s."match_id"
       AND   b."over_id"  = s."over_id"
       AND   b."ball_id"  = s."ball_id"
      GROUP BY b."match_id", b."striker"
      HAVING SUM(s."runs_scored") > 50
) AS t
JOIN "player" AS p
  ON p."player_id" = t."player_id"
LIMIT 20;
```

```sql
-- Description: Count how many such 50+ knocks exist – sanity check
SELECT COUNT(*) AS "fifties_count"
FROM (
      SELECT b."match_id",
             b."striker",
             SUM(s."runs_scored") AS "total_runs"
      FROM   "ball_by_ball" AS b
      JOIN   "batsman_scored" AS s
        ON   b."match_id" = s."match_id"
       AND   b."over_id"  = s."over_id"
       AND   b."ball_id"  = s."ball_id"
      GROUP BY b."match_id", b."striker"
      HAVING SUM(s."runs_scored") > 50
) AS t;
```

```sql
-- Description: Finally, compute the average of the total runs for all 50+ scoring (match, striker) efforts
SELECT AVG(t."total_runs") AS "average_runs_for_50plus"
FROM (
      SELECT b."match_id",
             b."striker",
             SUM(s."runs_scored") AS "total_runs"
      FROM   "ball_by_ball" AS b
      JOIN   "batsman_scored" AS s
        ON   b."match_id" = s."match_id"
       AND   b."over_id"  = s."over_id"
       AND   b."ball_id"  = s."ball_id"
      GROUP BY b."match_id", b."striker"
      HAVING SUM(s."runs_scored") > 50
) AS t;
```
