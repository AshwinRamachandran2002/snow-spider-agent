```

```sql
--Description: Glimpse at deliveries with match, striker, over and ball numbers  
SELECT DISTINCT "match_id", "striker", "over_id", "ball_id"
FROM "ball_by_ball"
LIMIT 20;
```

```sql
--Description: Check how runs are recorded for those same deliveries in batsman_scored  
SELECT DISTINCT "match_id", "over_id", "ball_id", "runs_scored"
FROM "batsman_scored"
LIMIT 20;
```

```sql
--Description: Join both tables for one match (sample) to confirm run linkage  
SELECT b."match_id",
       b."striker",
       s."runs_scored"
FROM   "ball_by_ball" AS b
JOIN   "batsman_scored" AS s
  ON   b."match_id" = s."match_id"
 AND   b."over_id"  = s."over_id"
 AND   b."ball_id"  = s."ball_id"
 AND   b."innings_no" = s."innings_no"
WHERE  b."match_id" = (SELECT DISTINCT "match_id" FROM "ball_by_ball" LIMIT 1)
LIMIT 20;
```

```sql
--Description: Aggregate total runs per striker in each match (top 20 rows)  
SELECT b."match_id",
       b."striker",
       SUM(s."runs_scored") AS "total_runs"
FROM   "ball_by_ball" AS b
JOIN   "batsman_scored" AS s
  ON   b."match_id" = s."match_id"
 AND   b."over_id"  = s."over_id"
 AND   b."ball_id"  = s."ball_id"
 AND   b."innings_no" = s."innings_no"
GROUP BY b."match_id", b."striker"
ORDER BY "total_runs" DESC
LIMIT 20;
```

```sql
--Description: Find only those striker-match pairs where the batsman scored more than 50  
SELECT b."match_id",
       b."striker",
       SUM(s."runs_scored") AS "total_runs"
FROM   "ball_by_ball" AS b
JOIN   "batsman_scored" AS s
  ON   b."match_id" = s."match_id"
 AND   b."over_id"  = s."over_id"
 AND   b."ball_id"  = s."ball_id"
 AND   b."innings_no" = s."innings_no"
GROUP BY b."match_id", b."striker"
HAVING SUM(s."runs_scored") > 50
LIMIT 20;
```

```sql
--Description: Final answer – average of those total runs (across all striker-match instances > 50)  
SELECT AVG("total_runs") AS "average_runs"
FROM (
      SELECT b."match_id",
             b."striker",
             SUM(s."runs_scored") AS "total_runs"
      FROM   "ball_by_ball" AS b
      JOIN   "batsman_scored" AS s
        ON   b."match_id" = s."match_id"
       AND   b."over_id"  = s."over_id"
       AND   b."ball_id"  = s."ball_id"
       AND   b."innings_no" = s."innings_no"
      GROUP BY b."match_id", b."striker"
      HAVING SUM(s."runs_scored") > 50
     );
```
