```sql
--Description: Show how runs per ball are stored along with the striker’s id
SELECT DISTINCT bb.match_id,
                bb.over_id,
                bb.ball_id,
                bb.striker,
                bs.runs_scored
FROM   ball_by_ball AS bb
JOIN   batsman_scored AS bs
       ON  bb.match_id = bs.match_id
       AND bb.over_id  = bs.over_id
       AND bb.ball_id  = bs.ball_id
       AND bb.innings_no = bs.innings_no
LIMIT 20;
```

```sql
--Description: Total runs scored by every striker in each match
SELECT bb.striker        AS player_id,
       bb.match_id,
       SUM(bs.runs_scored) AS total_runs
FROM   ball_by_ball AS bb
JOIN   batsman_scored AS bs
       ON  bb.match_id = bs.match_id
       AND bb.over_id  = bs.over_id
       AND bb.ball_id  = bs.ball_id
       AND bb.innings_no = bs.innings_no
GROUP  BY bb.striker,
          bb.match_id
LIMIT 20;
```

```sql
--Description: Identify striker-match pairs where the striker scored > 50 runs
SELECT *
FROM  (
        SELECT bb.striker   AS player_id,
               bb.match_id,
               SUM(bs.runs_scored) AS total_runs
        FROM   ball_by_ball AS bb
        JOIN   batsman_scored AS bs
               ON  bb.match_id = bs.match_id
               AND bb.over_id  = bs.over_id
               AND bb.ball_id  = bs.ball_id
               AND bb.innings_no = bs.innings_no
        GROUP  BY bb.striker,
                  bb.match_id
      ) AS t
WHERE  t.total_runs > 50
LIMIT 20;
```

```sql
--Description: Average of those per-match totals (answer requested)
SELECT AVG(t.total_runs) AS avg_runs_for_50plus
FROM  (
        SELECT bb.striker   AS player_id,
               bb.match_id,
               SUM(bs.runs_scored) AS total_runs
        FROM   ball_by_ball AS bb
        JOIN   batsman_scored AS bs
               ON  bb.match_id = bs.match_id
               AND bb.over_id  = bs.over_id
               AND bb.ball_id  = bs.ball_id
               AND bb.innings_no = bs.innings_no
        GROUP  BY bb.striker,
                  bb.match_id
        HAVING SUM(bs.runs_scored) > 50
      ) AS t;
```

```sql
--Description: List the distinct players who have ever scored > 50 in a match
SELECT DISTINCT t.player_id
FROM  (
        SELECT bb.striker   AS player_id,
               bb.match_id,
               SUM(bs.runs_scored) AS total_runs
        FROM   ball_by_ball AS bb
        JOIN   batsman_scored AS bs
               ON  bb.match_id = bs.match_id
               AND bb.over_id  = bs.over_id
               AND bb.ball_id  = bs.ball_id
               AND bb.innings_no = bs.innings_no
        GROUP  BY bb.striker,
                  bb.match_id
        HAVING SUM(bs.runs_scored) > 50
      ) AS t
