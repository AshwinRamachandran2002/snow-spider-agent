```

```sql
--Description: Show player names for those 50+ scorers
SELECT DISTINCT p.player_name
FROM   player AS p
JOIN  (
        SELECT DISTINCT bb.striker AS player_id
        FROM   ball_by_ball AS bb
        JOIN   batsman_scored AS bs
               ON  bb.match_id = bs.match_id
               AND bb.over_id  = bs.over_id
               AND bb.ball_id  = bs.ball_id
               AND bb.innings_no = bs.innings_no
        GROUP  BY bb.striker,
                  bb.match_id
        HAVING SUM(bs.runs_scored) > 50
      ) AS t
      ON p.player_id = t.player_id
LIMIT 20;
```

```sql
--Description: Total career runs for each player who has a 50+ score
SELECT p.player_name,
       SUM(bs.runs_scored) AS career_runs
FROM   player AS p
JOIN   ball_by_ball AS bb  ON p.player_id = bb.striker
JOIN   batsman_scored AS bs
       ON  bb.match_id = bs.match_id
       AND bb.over_id  = bs.over_id
       AND bb.ball_id  = bs.ball_id
       AND bb.innings_no = bs.innings_no
WHERE  p.player_id IN (
           SELECT DISTINCT bb.striker
           FROM   ball_by_ball AS bb
           JOIN   batsman_scored AS bs
                ON  bb.match_id = bs.match_id
                AND bb.over_id  = bs.over_id
                AND bb.ball_id  = bs.ball_id
                AND bb.innings_no = bs.innings_no
           GROUP  BY bb.striker,
                     bb.match_id
           HAVING SUM(bs.runs_scored) > 50
       )
GROUP  BY p.player_id
LIMIT 20;
```

```sql
--Description: Verify the count of 50+ instances
SELECT COUNT(*) AS number_of_50plus_entries
FROM  (
        SELECT bb.striker,
               bb.match_id,
               SUM(bs.runs_scored) AS total_runs
        FROM   ball_by_ball AS bb
        JOIN   batsman_scored AS bs
               ON  bb.match_id = bs.match_id
               AND bb.over_id  = bs.over_id
               AND bb.ball_id  = bs.ball_id
               AND bb.innings_no = bs.innings_no
        GROUP  BY bb.striker,
                  bb.match_id
        HAVING SUM(bs.runs_scored) > 50
      ) AS t;
```

```sql
--Description: Distribution of these 50+ totals (grouped buckets)
SELECT CASE
         WHEN total_runs BETWEEN 51 AND 75  THEN '51-75'
         WHEN total_runs BETWEEN 76 AND 100 THEN '76-100'
         WHEN total_runs > 100              THEN '101+'
       END AS range_bucket,
       COUNT(*) AS cnt
FROM (
        SELECT bb.striker,
               bb.match_id,
               SUM(bs.runs_scored) AS total_runs
        FROM   ball_by_ball AS bb
        JOIN   batsman_scored AS bs
               ON  bb.match_id = bs.match_id
               AND bb.over_id  = bs.over_id
               AND bb.ball_id  = bs.ball_id
               AND bb.innings_no = bs.innings_no
        GROUP  BY bb.striker,
                  bb.match_id
        HAVING SUM(bs.runs_scored) > 50
     ) AS t
GROUP BY range_bucket
LIMIT 20;
```

```sql
--Description: Final answer in a single compact query (same as 4th, repeated for clarity)
SELECT AVG(total_runs) AS average_runs_of_50plus
FROM (
        SELECT bb.striker,
               bb.match_id,
               SUM(bs.runs_scored) AS total_runs
        FROM   ball_by_ball AS bb
        JOIN   batsman_scored AS bs
               ON  bb.match_id = bs.match_id
               AND bb.over_id  = bs.over_id
               AND bb.ball_id  = bs.ball_id
               AND bb.innings_no = bs.innings_no
        GROUP BY bb.striker,
                 bb.match_id
        HAVING SUM(bs.runs_scored) > 50
     );
```
