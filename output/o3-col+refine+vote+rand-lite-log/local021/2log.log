```sql
--Description: Inspect a few rows from batsman_scored to see how runs are recorded
SELECT DISTINCT * 
FROM batsman_scored 
LIMIT 20;
```

```sql
--Description: Inspect a few rows from ball_by_ball to confirm striker information
SELECT DISTINCT match_id, over_id, ball_id, innings_no, striker 
FROM ball_by_ball 
LIMIT 20;
```

```sql
--Description: Join batsman_scored with ball_by_ball to associate every run with the corresponding striker
SELECT DISTINCT bsc.match_id, bsc.over_id, bsc.ball_id, bsc.innings_no,
       bb.striker, bsc.runs_scored
FROM batsman_scored AS bsc
JOIN ball_by_ball AS bb
  ON bsc.match_id  = bb.match_id
 AND bsc.over_id   = bb.over_id
 AND bsc.ball_id   = bb.ball_id
 AND bsc.innings_no = bb.innings_no
LIMIT 20;
```

```sql
--Description: Calculate total runs scored by each striker in every match (sample)
SELECT DISTINCT agg.match_id,
       agg.striker,
       agg.total_runs
FROM (
    SELECT bb.match_id,
           bb.striker,
           SUM(bsc.runs_scored) AS total_runs
    FROM batsman_scored AS bsc
    JOIN ball_by_ball AS bb
      ON bsc.match_id  = bb.match_id
     AND bsc.over_id   = bb.over_id
     AND bsc.ball_id   = bb.ball_id
     AND bsc.innings_no = bb.innings_no
    GROUP BY bb.match_id, bb.striker
) AS agg
LIMIT 20;
```

```sql
--Description: Retrieve only those (match, striker) pairs where total_runs > 50 (sample)
SELECT DISTINCT *
FROM (
    SELECT bb.match_id,
           bb.striker,
           SUM(bsc.runs_scored) AS total_runs
    FROM batsman_scored AS bsc
    JOIN ball_by_ball AS bb
      ON bsc.match_id  = bb.match_id
     AND bsc.over_id   = bb.over_id
     AND bsc.ball_id   = bb.ball_id
     AND bsc.innings_no = bb.innings_no
    GROUP BY bb.match_id, bb.striker
) AS t
WHERE total_runs > 50
LIMIT 20;
```

```sql
--Description: Show the list of total runs ( > 50 ) that will be used to compute the average
SELECT DISTINCT total_runs
FROM (
    SELECT bb.match_id,
           bb.striker,
           SUM(bsc.runs_scored) AS total_runs
    FROM batsman_scored AS bsc
    JOIN ball_by_ball AS bb
      ON bsc.match_id  = bb.match_id
     AND bsc.over_id   = bb.over_id
     AND bsc.ball_id   = bb.ball_id
     AND bsc.innings_no = bb.innings_no
    GROUP BY bb.match_id, bb.striker
    HAVING SUM(bsc.runs_scored) > 50
) AS runs_over_50
LIMIT 20;
```

```sql
--Description: FINAL – calculate the average of total runs scored by all strikers who scored more than 50 in any single match
SELECT AVG(total_runs) AS average_runs_above_50
FROM (
    SELECT bb.match_id,
           bb.striker,
           SUM(bsc.runs_scored) AS total_runs
    FROM batsman_scored AS bsc
    JOIN ball_by_ball AS bb
      ON bsc.match_id  = bb.match_id
     AND bsc.over_id   = bb.over_id
     AND bsc.ball_id   = bb.ball_id
     AND bsc.innings_no = bb.innings_no
    GROUP BY bb.match_id, bb.striker
    HAVING SUM(bsc.runs_scored) > 50
) AS scored_50_plus
LIMIT 20;
```
