Query:
--Description: Retrieve only those (match, striker) pairs where total_runs > 50 (sample)
SELECT DISTINCT *
FROM (
    SELECT bb.match_id,
           bb.striker,
           SUM(bsc.runs_scored) AS total_runs
    FROM batsman_scored AS bsc
    JOIN ball_by_ball AS bb
      ON bsc.match_id  = bb.match_id
     AND bsc.over_id   = bb.over_id
     AND bsc.ball_id   = bb.ball_id
     AND bsc.innings_no = bb.innings_no
    GROUP BY bb.match_id, bb.striker
) AS t
WHERE total_runs > 50
LIMIT 20;
