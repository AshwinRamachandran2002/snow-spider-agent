```sql
-- 1. Preview some distinct striker-ids that appear in the ball-by-ball log  
SELECT DISTINCT "striker"
FROM "ball_by_ball"
LIMIT 20;
```

```sql
-- 2. Map those striker-ids to player names to confirm they are players  
SELECT DISTINCT p."player_id",
                p."player_name"
FROM "player"       AS p
JOIN "ball_by_ball" AS b
      ON p."player_id" = b."striker"
LIMIT 20;
```

```sql
-- 3. Look at a sample of the batsman_scored table (runs recorded for every ball)  
SELECT *
FROM "batsman_scored"
LIMIT 20;
```

```sql
-- 4. Join one ball of play to see who scored how many runs on that ball  
SELECT b."match_id",
       b."over_id",
       b."ball_id",
       b."striker",
       bs."runs_scored"
FROM "ball_by_ball"  AS b
JOIN "batsman_scored" AS bs
      ON  b."match_id"   = bs."match_id"
      AND b."over_id"    = bs."over_id"
      AND b."ball_id"    = bs."ball_id"
      AND b."innings_no" = bs."innings_no"
LIMIT 20;
```

```sql
-- 5. Compute total runs each striker scored in each match (top 20 rows)  
SELECT b."match_id",
       b."striker",
       SUM(bs."runs_scored") AS "total_runs"
FROM "ball_by_ball"  AS b
JOIN "batsman_scored" AS bs
      ON  b."match_id"   = bs."match_id"
      AND b."over_id"    = bs."over_id"
      AND b."ball_id"    = bs."ball_id"
      AND b."innings_no" = bs."innings_no"
GROUP BY b."match_id", b."striker"
LIMIT 20;
```

```sql
-- 6. Filter to only those striker-match performances where the total exceeds 50 runs  
SELECT b."match_id",
       b."striker",
       SUM(bs."runs_scored") AS "total_runs"
FROM "ball_by_ball"  AS b
JOIN "batsman_scored" AS bs
      ON  b."match_id"   = bs."match_id"
      AND b."over_id"    = bs."over_id"
      AND b."ball_id"    = bs."ball_id"
      AND b."innings_no" = bs."innings_no"
GROUP BY b."match_id", b."striker"
HAVING SUM(bs."runs_scored") > 50
LIMIT 20;
```

```sql
-- 7. Count how many striker-match innings satisfy the “>50 runs” condition  
SELECT COUNT(*) AS "num_innings_over_50"
FROM (
      SELECT b."match_id",
             b."striker",
             SUM(bs."runs_scored") AS "total_runs"
      FROM "ball_by_ball"  AS b
      JOIN "batsman_scored" AS bs
            ON  b."match_id"   = bs."match_id"
            AND b."over_id"    = bs."over_id"
            AND b."ball_id"    = bs."ball_id"
            AND b."innings_no" = bs."innings_no"
      GROUP BY b."match_id", b."striker"
      HAVING SUM(bs."runs_scored") > 50
) AS t;
```

```sql
-- 8. Show a few examples together with player names to validate  
SELECT p."player_name",
       t."match_id",
       t."total_runs"
FROM (
      SELECT b."match_id",
             b."striker",
             SUM(bs."runs_scored") AS "total_runs"
      FROM "ball_by_ball"  AS b
      JOIN "batsman_scored" AS bs
            ON  b."match_id"   = bs."match_id"
            AND b."over_id"    = bs."over_id"
            AND b."ball_id"    = bs."ball_id"
            AND b."innings_no" = bs."innings_no"
      GROUP BY b."match_id", b."striker"
      HAVING SUM(bs."runs_scored") > 50
) AS t
JOIN "player" AS p
     ON p."player_id" = t."striker"
LIMIT 20;
```

```sql
-- 9. Compute the average of those “total_runs” values (the required answer)  
SELECT ROUND(AVG(t."total_runs"), 2) AS "average_runs_over_50"
FROM (
      SELECT b."match_id",
             b."striker",
             SUM(bs."runs_scored") AS "total_runs"
      FROM "ball_by_ball"  AS b
      JOIN "batsman_scored" AS bs
            ON  b."match_id"   = bs."match_id"
            AND b."over_id"    = bs."over_id"
            AND b."ball_id"    = bs."ball_id"
            AND b."innings_no" = bs."innings_no"
      GROUP BY b."match_id", b."striker"
      HAVING SUM(bs."runs_scored") > 50
) AS t;
```

The last query returns one value – the average total runs scored in a match by every striker who scored more than 50 in that match.
