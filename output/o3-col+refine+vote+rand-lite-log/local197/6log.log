-- 7. Attach the customer’s name to the result for clearer reporting
WITH top10 AS (
  SELECT customer_id
  FROM   (SELECT customer_id,
                 SUM(amount) AS total_paid
          FROM   payment
          GROUP  BY customer_id
          ORDER  BY total_paid DESC
          LIMIT 10)
),
monthly AS (
  SELECT p.customer_id,
         STRFTIME('%Y-%m', p.payment_date) AS ym,
         ROUND(SUM(p.amount),2)            AS month_sum
  FROM   payment AS p
  JOIN   top10   USING (customer_id)
  GROUP  BY p.customer_id, ym
),
diffs AS (
  SELECT customer_id,
         ym,
         ROUND(month_sum - LAG(month_sum) OVER (PARTITION BY customer_id ORDER BY ym),2) AS mo_diff
  FROM   monthly
),
maxdiff AS (
  SELECT customer_id,
         ym  AS month_with_max_change,
         mo_diff AS difference
  FROM   diffs
  WHERE  mo_diff IS NOT NULL
  ORDER  BY ABS(mo_diff) DESC
  LIMIT 1
)
SELECT DISTINCT c.first_name || ' ' || c.last_name AS customer_name,
                m.month_with_max_change,
                ROUND(m.difference,2)              AS difference
FROM   maxdiff AS m
JOIN   customer AS c USING (customer_id);
