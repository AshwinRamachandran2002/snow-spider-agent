-- 4. Pick one of those customers (e.g. the first) to examine month-over-month totals
WITH top1 AS (
  SELECT customer_id
  FROM   (SELECT customer_id,
                 SUM(amount) AS total_paid
          FROM   payment
          GROUP  BY customer_id
          ORDER  BY total_paid DESC
          LIMIT 1)
),
cust_month AS (
  SELECT STRFTIME('%Y-%m', payment_date) AS ym,
         ROUND(SUM(amount),2)            AS month_sum
  FROM   payment
  WHERE  customer_id = (SELECT customer_id FROM top1)
  GROUP  BY ym
  ORDER  BY ym
)
SELECT DISTINCT *
FROM   cust_month;
