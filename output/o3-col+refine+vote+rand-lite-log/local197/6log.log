-- 2. Find the 10 customers who have paid the most money in total
WITH totals AS (
  SELECT customer_id,
         ROUND(SUM(amount),2) AS total_paid
  FROM   payment
  GROUP  BY customer_id
)
SELECT DISTINCT customer_id,
                total_paid
FROM   totals
ORDER  BY total_paid DESC
LIMIT 10;
