```sql
-- 1. Preview some rows of the payment table to see the key columns
SELECT DISTINCT payment_id,
                customer_id,
                amount,
                payment_date
FROM   payment
LIMIT 20;
```

```sql
-- 2. Find the 10 customers who have paid the most money in total
WITH totals AS (
  SELECT customer_id,
         ROUND(SUM(amount),2) AS total_paid
  FROM   payment
  GROUP  BY customer_id
)
SELECT DISTINCT customer_id,
                total_paid
FROM   totals
ORDER  BY total_paid DESC
LIMIT 10;
```

```sql
-- 3. Aggregate those top-10 customers’ payments by year-month
WITH top10 AS (
  SELECT customer_id
  FROM   (SELECT customer_id,
                 SUM(amount) AS total_paid
          FROM   payment
          GROUP  BY customer_id
          ORDER  BY total_paid DESC
          LIMIT 10)
),
monthly AS (
  SELECT p.customer_id,
         STRFTIME('%Y-%m', p.payment_date) AS ym,
         ROUND(SUM(p.amount),2)            AS month_sum
  FROM   payment AS p
  JOIN   top10   USING (customer_id)
  GROUP  BY p.customer_id, ym
)
SELECT DISTINCT *
FROM   monthly
ORDER  BY customer_id, ym
LIMIT 20;
```

```sql
-- 4. Pick one of those customers (e.g. the first) to examine month-over-month totals
WITH top1 AS (
  SELECT customer_id
  FROM   (SELECT customer_id,
                 SUM(amount) AS total_paid
          FROM   payment
          GROUP  BY customer_id
          ORDER  BY total_paid DESC
          LIMIT 1)
),
cust_month AS (
  SELECT STRFTIME('%Y-%m', payment_date) AS ym,
         ROUND(SUM(amount),2)            AS month_sum
  FROM   payment
  WHERE  customer_id = (SELECT customer_id FROM top1)
  GROUP  BY ym
  ORDER  BY ym
)
SELECT DISTINCT *
FROM   cust_month;
```

```sql
-- 5. For all top-10 customers compute the month-over-month difference
WITH top10 AS (
  SELECT customer_id
  FROM   (SELECT customer_id,
                 SUM(amount) AS total_paid
          FROM   payment
          GROUP  BY customer_id
          ORDER  BY total_paid DESC
          LIMIT 10)
),
monthly AS (
  SELECT p.customer_id,
         STRFTIME('%Y-%m', p.payment_date) AS ym,
         ROUND(SUM(p.amount),2)            AS month_sum
  FROM   payment AS p
  JOIN   top10   USING (customer_id)
  GROUP  BY p.customer_id, ym
),
diffs AS (
  SELECT customer_id,
         ym,
         month_sum,
         LAG(month_sum) OVER (PARTITION BY customer_id ORDER BY ym) AS prev_month_sum,
         ROUND(month_sum - LAG(month_sum) OVER (PARTITION BY customer_id ORDER BY ym),2) AS mo_diff
  FROM   monthly
)
SELECT DISTINCT *
FROM   diffs
WHERE  prev_month_sum IS NOT NULL
ORDER  BY customer_id, ym
LIMIT 20;
```

```sql
-- 6. Identify the largest absolute month-over-month difference among the top-10 customers
WITH top10 AS (
  SELECT customer_id
  FROM   (SELECT customer_id,
                 SUM(amount) AS total_paid
          FROM   payment
          GROUP  BY customer_id
          ORDER  BY total_paid DESC
          LIMIT 10)
),
monthly AS (
  SELECT p.customer_id,
         STRFTIME('%Y-%m', p.payment_date) AS ym,
         ROUND(SUM(p.amount),2)            AS month_sum
  FROM   payment AS p
  JOIN   top10   USING (customer_id)
  GROUP  BY p.customer_id, ym
),
diffs AS (
  SELECT customer_id,
         ym,
         ROUND(month_sum - LAG(month_sum) OVER (PARTITION BY customer_id ORDER BY ym),2) AS mo_diff
  FROM   monthly
)
SELECT DISTINCT customer_id,
                ym  AS month_with_max_change,
                mo_diff AS difference
FROM   diffs
WHERE  mo_diff IS NOT NULL
ORDER  BY ABS(mo_diff) DESC
LIMIT 1;
```

```sql
-- 7. Attach the customer’s name to the result for clearer reporting
WITH top10 AS (
  SELECT customer_id
  FROM   (SELECT customer_id,
                 SUM(amount) AS total_paid
          FROM   payment
          GROUP  BY customer_id
          ORDER  BY total_paid DESC
          LIMIT 10)
),
monthly AS (
  SELECT p.customer_id,
         STRFTIME('%Y-%m', p.payment_date) AS ym,
         ROUND(SUM(p.amount),2)            AS month_sum
  FROM   payment AS p
  JOIN   top10   USING (customer_id)
  GROUP  BY p.customer_id, ym
),
diffs AS (
  SELECT customer_id,
         ym,
         ROUND(month_sum - LAG(month_sum) OVER (PARTITION BY customer_id ORDER BY ym),2) AS mo_diff
  FROM   monthly
),
maxdiff AS (
  SELECT customer_id,
         ym  AS month_with_max_change,
         mo_diff AS difference
  FROM   diffs
  WHERE  mo_diff IS NOT NULL
  ORDER  BY ABS(mo_diff) DESC
  LIMIT 1
)
SELECT DISTINCT c.first_name || ' ' || c.last_name AS customer_name,
                m.month_with_max_change,
                ROUND(m.difference,2)              AS difference
FROM   maxdiff AS m
JOIN   customer AS c USING (customer_id);
```

These seven queries progress from inspecting the raw data to isolating the single customer-month that shows the greatest month-over-month change in payments (rounded to two decimals) among the top-10 paying customers.
