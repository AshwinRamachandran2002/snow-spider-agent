```sql
--Description: Calculate, for the winning customer (ID = 148), the total amount paid
--             in each calendar month, the previous month’s total, and the absolute
--             month-over-month difference. 
--             • “monthly”   – sum that customer’s payments by YYYY-MM.  
--             • “with_prev” – attach the prior month’s total via LAG (one use only to
--                              avoid the earlier “misuse of window function” error).  
--             • Final step  – compute and display the difference, rounded to 2 decimals.
WITH monthly AS (
    SELECT
        strftime('%Y-%m', "payment_date") AS "month",
        ROUND(SUM("amount"), 2)           AS "monthly_paid"
    FROM   "payment"
    WHERE  "customer_id" = 148                -- top-spending customer
    GROUP  BY "month"
),
with_prev AS (
    SELECT
        "month",
        "monthly_paid",
        LAG("monthly_paid") OVER (ORDER BY "month") AS "prev_month_paid"
    FROM   monthly
)
SELECT
    "month",
    "monthly_paid",
    "prev_month_paid",
    CASE
        WHEN "prev_month_paid" IS NULL
        THEN NULL
        ELSE ROUND(ABS("monthly_paid" - "prev_month_paid"), 2)
    END AS "diff_to_prev"
FROM   with_prev
ORDER  BY "month";
