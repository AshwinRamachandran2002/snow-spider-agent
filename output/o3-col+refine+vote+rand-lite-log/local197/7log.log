-- 1)  Find how much every customer has paid in total (descending order, top 15 just to take a look)
SELECT 
        "customer_id",
        ROUND(SUM("amount"),2)  AS "total_paid"
FROM    "payment"
GROUP BY "customer_id"
ORDER BY "total_paid" DESC
LIMIT 15;

-- 2)  Narrow the list to the real “TOP-10” paying customers
SELECT 
        "customer_id",
        ROUND(SUM("amount"),2)  AS "total_paid"
FROM    "payment"
GROUP BY "customer_id"
ORDER BY "total_paid" DESC
LIMIT 10;

-- 3)  See the monthly pattern of one particular high-spending customer (replace 1 by an id returned above)
SELECT  
        strftime('%Y-%m',"payment_date")   AS "month",
        ROUND(SUM("amount"),2)            AS "monthly_paid"
FROM     "payment"
WHERE    "customer_id" = 1
GROUP BY "month"
ORDER BY "month"
LIMIT 20;

-- 4)  Produce month-by-month totals for every one of the TOP-10 customers
WITH top10 AS (
        SELECT "customer_id"
        FROM   "payment"
        GROUP  BY "customer_id"
        ORDER  BY SUM("amount") DESC
        LIMIT 10
)
SELECT  
        p."customer_id",
        strftime('%Y-%m',p."payment_date") AS "month",
        ROUND(SUM(p."amount"),2)           AS "monthly_paid"
FROM     "payment" AS p
JOIN     top10     USING ("customer_id")
GROUP BY p."customer_id", "month"
ORDER BY p."customer_id", "month"
LIMIT 40;

-- 5)  For those same rows, calculate the previous month’s total (LAG) and the difference
WITH top10 AS (
        SELECT "customer_id"
        FROM   "payment"
        GROUP  BY "customer_id"
        ORDER  BY SUM("amount") DESC
        LIMIT 10
),
monthly AS (
        SELECT  
                p."customer_id",
                strftime('%Y-%m',p."payment_date") AS "month",
                ROUND(SUM(p."amount"),2)           AS "monthly_paid"
        FROM     "payment" AS p
        JOIN     top10     USING ("customer_id")
        GROUP BY p."customer_id", "month"
)
SELECT  
        "customer_id",
        "month",
        "monthly_paid",
        LAG("monthly_paid") OVER (PARTITION BY "customer_id" ORDER BY "month") AS "prev_month_paid",
        ROUND(ABS("monthly_paid" - LAG("monthly_paid") OVER (PARTITION BY "customer_id" ORDER BY "month")),2) 
                                                AS "diff_to_prev"
FROM    monthly
ORDER BY "customer_id","month"
LIMIT 40;

-- 6)  Pick, for every TOP-10 customer, his or her largest month-over-month jump
WITH top10 AS (
        SELECT "customer_id"
        FROM   "payment"
        GROUP  BY "customer_id"
        ORDER  BY SUM("amount") DESC
        LIMIT 10
),
monthly AS (
        SELECT  
                p."customer_id",
                strftime('%Y-%m',p."payment_date") AS "month",
                ROUND(SUM(p."amount"),2)           AS "monthly_paid"
        FROM     "payment" AS p
        JOIN     top10     USING ("customer_id")
        GROUP BY p."customer_id", "month"
),
with_diff AS (
        SELECT  
                "customer_id",
                "month",
                "monthly_paid",
                ROUND(ABS("monthly_paid" - LAG("monthly_paid") OVER (PARTITION BY "customer_id" ORDER BY "month")),2) 
                                                AS "diff_to_prev"
        FROM    monthly
)
SELECT  "customer_id",
        MAX("diff_to_prev")  AS "max_jump"
FROM    with_diff
GROUP BY "customer_id"
ORDER BY "max_jump" DESC
LIMIT 20;

-- 7)  Finally, locate the single biggest month-to-month change among the TOP-10 customers
WITH top10 AS (
        SELECT "customer_id"
        FROM   "payment"
        GROUP  BY "customer_id"
        ORDER  BY SUM("amount") DESC
        LIMIT 10
),
monthly AS (
        SELECT  
                p."customer_id",
                strftime('%Y-%m',p."payment_date") AS "month",
                ROUND(SUM(p."amount"),2)           AS "monthly_paid"
        FROM     "payment" AS p
        JOIN     top10     USING ("customer_id")
        GROUP BY p."customer_id", "month"
),
with_diff AS (
        SELECT  
                "customer_id",
                "month",
                ROUND(ABS("monthly_paid" - LAG("monthly_paid") OVER (PARTITION BY "customer_id" ORDER BY "month")),2) 
                                                AS "diff_to_prev"
        FROM    monthly
)
SELECT  
        d."customer_id",
        c."first_name" || ' ' || c."last_name"          AS "customer_name",
        d."month"                                       AS "current_month",
        d."diff_to_prev"                                AS "largest_monthly_change"
FROM     with_diff  AS d
JOIN     "customer" AS c ON c."customer_id" = d."customer_id"
WHERE    d."diff_to_prev" IS NOT NULL
ORDER BY d."diff_to_prev" DESC
LIMIT 1;

-- 8)  (Optional look) Show all the month-to-month differences for that winning customer
WITH top AS (
        /* the id returned by the query above */
        SELECT  ? AS win_id
