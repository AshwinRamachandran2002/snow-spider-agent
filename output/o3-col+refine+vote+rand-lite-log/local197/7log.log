```sql
--Description: 
-- Find, among the 10 customers who have spent the most in total, the single
-- largest change in payment from one month to the immediately following month.
-- • top10   : identify the ten highest-spending customers overall.  
-- • monthly : for those customers, sum payments per calendar month (YYYY-MM).  
-- • diff_cte: for every customer-month, use LAG to get the previous month’s total
--             and compute the absolute difference.  
-- • Final   : return the customer, the month in which the change is observed
--             (the later month), and the change rounded to two decimals.
WITH top10 AS (                                   -- 1) top ten customers
    SELECT  "customer_id"
    FROM    "payment"
    GROUP BY "customer_id"
    ORDER BY SUM("amount") DESC
    LIMIT   10
),
monthly AS (                                      -- 2) monthly totals
    SELECT
        p."customer_id",
        strftime('%Y-%m', p."payment_date") AS "month",
        ROUND(SUM(p."amount"), 2)           AS "monthly_paid"
    FROM   "payment" AS p
    JOIN   top10     USING ("customer_id")
    GROUP  BY p."customer_id", "month"
),
diff_cte AS (                                     -- 3) month-over-month diff
    SELECT
        m."customer_id",
        m."month",
        ROUND(
            ABS(m."monthly_paid"
              - LAG(m."monthly_paid") OVER (
                    PARTITION BY m."customer_id"
                    ORDER BY m."month")
            ), 2)                               AS "diff_to_prev"
    FROM   monthly AS m
    WHERE  LAG(m."monthly_paid") OVER (
              PARTITION BY m."customer_id"
              ORDER BY m."month") IS NOT NULL
)
SELECT                                            -- 4) single largest jump
    d."customer_id",
    c."first_name" || ' ' || c."last_name" AS "customer_name",
    d."month"                               AS "month_of_change",
    d."diff_to_prev"                        AS "largest_monthly_change"
FROM   diff_cte AS d
JOIN   "customer" AS c ON c."customer_id" = d."customer_id"
ORDER  BY d."diff_to_prev" DESC
LIMIT  1;
```
