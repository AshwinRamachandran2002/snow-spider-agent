-- 7)  Finally, locate the single biggest month-to-month change among the TOP-10 customers
WITH top10 AS (
        SELECT "customer_id"
        FROM   "payment"
        GROUP  BY "customer_id"
        ORDER  BY SUM("amount") DESC
        LIMIT 10
),
monthly AS (
        SELECT  
                p."customer_id",
                strftime('%Y-%m',p."payment_date") AS "month",
                ROUND(SUM(p."amount"),2)           AS "monthly_paid"
        FROM     "payment" AS p
        JOIN     top10     USING ("customer_id")
        GROUP BY p."customer_id", "month"
),
with_diff AS (
        SELECT  
                "customer_id",
                "month",
                ROUND(ABS("monthly_paid" - LAG("monthly_paid") OVER (PARTITION BY "customer_id" ORDER BY "month")),2) 
                                                AS "diff_to_prev"
        FROM    monthly
)
SELECT  
        d."customer_id",
        c."first_name" || ' ' || c."last_name"          AS "customer_name",
        d."month"                                       AS "current_month",
        d."diff_to_prev"                                AS "largest_monthly_change"
FROM     with_diff  AS d
JOIN     "customer" AS c ON c."customer_id" = d."customer_id"
WHERE    d."diff_to_prev" IS NOT NULL
ORDER BY d."diff_to_prev" DESC
LIMIT 1
Answer:
customer_id,customer_name,current_month,largest_monthly_change
148,ELEANOR HUNT,2005-07,77.83
