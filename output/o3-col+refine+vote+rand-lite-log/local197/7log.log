```sql
--Description: 
-- 1) Identify the 10 customers who have spent the most overall (“top10”).  
-- 2) For those customers, sum their payments per month (“monthly”).  
-- 3) For every customer-month, use LAG to grab the previous month’s total and compute the absolute difference (“diff_cte”).  
-- 4) Return the single row with the greatest month-over-month change, including customer name, the (later) month, and the change rounded to two decimals.
WITH top10 AS (                                             -- step 1
    SELECT  "customer_id"
    FROM    "payment"
    GROUP BY "customer_id"
    ORDER BY SUM("amount") DESC
    LIMIT   10
),
monthly AS (                                                -- step 2
    SELECT
        p."customer_id",
        strftime('%Y-%m', p."payment_date") AS "month",
        ROUND(SUM(p."amount"), 2)           AS "monthly_paid"
    FROM   "payment" AS p
    JOIN   top10     USING ("customer_id")
    GROUP  BY p."customer_id", "month"
),
diff_cte AS (                                               -- step 3
    SELECT
        m."customer_id",
        m."month",
        m."monthly_paid",
        ROUND(
            ABS(m."monthly_paid" - LAG(m."monthly_paid") OVER (
                    PARTITION BY m."customer_id" ORDER BY m."month"
            )), 2
        ) AS "diff_to_prev"
    FROM   monthly AS m
    WHERE  LAG(m."monthly_paid") OVER (PARTITION BY m."customer_id" ORDER BY m."month") IS NOT NULL
)
SELECT                                                      -- step 4 (final answer)
    d."customer_id",
    c."first_name" || ' ' || c."last_name"  AS "customer_name",
    d."month"                               AS "month_of_change",
    d."diff_to_prev"                        AS "largest_monthly_change"
FROM   diff_cte AS d
JOIN   "customer" AS c ON c."customer_id" = d."customer_id"
ORDER  BY d."diff_to_prev" DESC
LIMIT  1;
```
