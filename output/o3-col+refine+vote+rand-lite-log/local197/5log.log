```

```sql
-- 2) How many customers have payments recorded?  
SELECT DISTINCT COUNT(DISTINCT "customer_id") AS "total_customers"  
FROM "payment"  
LIMIT 20;
```

```sql
-- 3) Total amount each customer has paid so far  
SELECT DISTINCT "customer_id", ROUND(SUM("amount"),2) AS "total_paid"  
FROM "payment"  
GROUP BY "customer_id"  
ORDER BY "total_paid" DESC  
LIMIT 20;
```

```sql
-- 4) Identify the TOP-10 paying customers (id & total)  
SELECT DISTINCT "customer_id", ROUND(SUM("amount"),2) AS "total_paid"  
FROM "payment"  
GROUP BY "customer_id"  
ORDER BY "total_paid" DESC  
LIMIT 10;
```

```sql
-- 5) Add first/last names for those TOP-10 customers  
SELECT DISTINCT c."customer_id", c."first_name", c."last_name",  
       ROUND(SUM(p."amount"),2) AS "total_paid"  
FROM "payment"  p  
JOIN "customer" c ON c."customer_id" = p."customer_id"  
GROUP BY c."customer_id"  
ORDER BY "total_paid" DESC  
LIMIT 10;
```

```sql
-- 6) Build monthly payment totals for every TOP-10 customer  
SELECT DISTINCT p."customer_id",  
       strftime('%Y-%m', p."payment_date") AS "yyyymm",  
       ROUND(SUM(p."amount"),2) AS "month_total"  
FROM "payment" p  
WHERE p."customer_id" IN (                       -- TOP-10 sub-query
        SELECT "customer_id"  
        FROM "payment"  
        GROUP BY "customer_id"  
        ORDER BY SUM("amount") DESC  
        LIMIT 10  
      )  
GROUP BY p."customer_id", "yyyymm"  
ORDER BY p."customer_id", "yyyymm"  
LIMIT 20;
```

```sql
-- 7) Compute the month-over-month differences for the TOP-10 customers  
SELECT DISTINCT t."customer_id",  
       t."yyyymm",  
       t."month_total",  
       t."prev_month_total",  
       ROUND(ABS(t."month_total" - t."prev_month_total"),2) AS "mo_mo_diff"  
FROM (  
        SELECT p."customer_id",  
               strftime('%Y-%m', p."payment_date")          AS "yyyymm",  
               SUM(p."amount")                              AS "month_total",  
               LAG(SUM(p."amount"))  
                   OVER (PARTITION BY p."customer_id"  
                         ORDER BY strftime('%Y-%m', p."payment_date"))  
                                                            AS "prev_month_total"  
        FROM "payment" p  
        WHERE p."customer_id" IN (                         -- TOP-10 list
                SELECT "customer_id"  
                FROM "payment"  
                GROUP BY "customer_id"  
                ORDER BY SUM("amount") DESC  
                LIMIT 10  
             )  
        GROUP BY p."customer_id", "yyyymm"  
     ) t  
WHERE t."prev_month_total" IS NOT NULL  
ORDER BY "mo_mo_diff" DESC  
LIMIT 20;
```

```sql
-- 8) FINAL ANSWER: customer & month with the single largest MoM change  
SELECT DISTINCT c."customer_id",  
       c."first_name",  
       c."last_name",  
       r."yyyymm"          AS "month_with_max_change",  
       ROUND(r."mo_mo_diff",2) AS "largest_mom_difference"  
FROM (                                        -- result from step-7
        SELECT p."customer_id",  
               strftime('%Y-%m', p."payment_date") AS "yyyymm",  
               SUM(p."amount")                     AS "month_total",  
               LAG(SUM(p."amount"))  
                   OVER (PARTITION BY p."customer_id"  
                         ORDER BY strftime('%Y-%m', p."payment_date"))  
                                                  AS "prev_month_total",  
               ABS(SUM(p."amount") -  
                   LAG(SUM(p."amount"))  
                       OVER (PARTITION BY p."customer_id"  
                             ORDER BY strftime('%Y-%m', p."payment_date"))  
                  )                               AS "mo_mo_diff"  
        FROM "payment" p  
        WHERE p."customer_id" IN (                -- TOP-10 customers
                SELECT "customer_id"  
                FROM "payment"  
                GROUP BY "customer_id"  
                ORDER BY SUM("amount") DESC  
                LIMIT 10  
             )  
        GROUP BY p."customer_id", "yyyymm"  
     ) r  
JOIN "customer" c ON c."customer_id" = r."customer_id"  
WHERE r."prev_month_total" IS NOT NULL  
ORDER BY r."mo_mo_diff" DESC  
LIMIT 20;
```
