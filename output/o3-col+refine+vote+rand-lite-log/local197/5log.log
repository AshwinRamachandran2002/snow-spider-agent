Query:
-- 8) FINAL ANSWER: customer & month with the single largest MoM change  
SELECT DISTINCT c."customer_id",  
       c."first_name",  
       c."last_name",  
       r."yyyymm"          AS "month_with_max_change",  
       ROUND(r."mo_mo_diff",2) AS "largest_mom_difference"  
FROM (                                        -- result from step-7
        SELECT p."customer_id",  
               strftime('%Y-%m', p."payment_date") AS "yyyymm",  
               SUM(p."amount")                     AS "month_total",  
               LAG(SUM(p."amount"))  
                   OVER (PARTITION BY p."customer_id"  
                         ORDER BY strftime('%Y-%m', p."payment_date"))  
                                                  AS "prev_month_total",  
               ABS(SUM(p."amount") -  
                   LAG(SUM(p."amount"))  
                       OVER (PARTITION BY p."customer_id"  
                             ORDER BY strftime('%Y-%m', p."payment_date"))  
                  )                               AS "mo_mo_diff"  
        FROM "payment" p  
        WHERE p."customer_id" IN (                -- TOP-10 customers
                SELECT "customer_id"  
                FROM "payment"  
                GROUP BY "customer_id"  
                ORDER BY SUM("amount") DESC  
                LIMIT 10  
             )  
        GROUP BY p."customer_id", "yyyymm"  
     ) r  
JOIN "customer" c ON c."customer_id" = r."customer_id"  
WHERE r."prev_month_total" IS NOT NULL  
ORDER BY r."mo_mo_diff" DESC  
LIMIT 20;
