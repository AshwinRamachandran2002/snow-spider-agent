-- Description: 1) Total amount paid by each customer (top 20 to see who our biggest spenders are).
SELECT DISTINCT p.customer_id,
       ROUND(SUM(p.amount), 2) AS total_paid
FROM payment AS p
GROUP BY p.customer_id
ORDER BY total_paid DESC
LIMIT 20;
```

```sql
-- Description: 2) List the top-10 paying customers (id + running total) to be reused later.
SELECT DISTINCT p.customer_id,
       ROUND(SUM(p.amount), 2) AS total_paid
FROM payment AS p
GROUP BY p.customer_id
ORDER BY total_paid DESC
LIMIT 10;
```

```sql
-- Description: 3) Show one customer’s payments broken down by month to understand the pattern.
SELECT DISTINCT strftime('%Y-%m', p.payment_date) AS pay_month,
       ROUND(SUM(p.amount), 2)                  AS monthly_total
FROM payment AS p
WHERE p.customer_id = 1          -- swap id to inspect others
GROUP BY pay_month
ORDER BY pay_month
LIMIT 20;
```

```sql
-- Description: 4) Monthly payment totals for ALL customers in the previous top-10 list.
WITH top_ten AS (
    SELECT p.customer_id
    FROM payment AS p
    GROUP BY p.customer_id
    ORDER BY SUM(p.amount) DESC
    LIMIT 10
)
SELECT DISTINCT t.customer_id,
       strftime('%Y-%m', p.payment_date) AS pay_month,
       ROUND(SUM(p.amount), 2)           AS monthly_total
FROM payment AS p
JOIN top_ten AS t
  ON t.customer_id = p.customer_id
GROUP BY t.customer_id, pay_month
ORDER BY t.customer_id, pay_month
LIMIT 20;
```

```sql
-- Description: 5) Compute each month-over-month (MoM) difference for every top-10 customer.
WITH top_ten AS (
    SELECT p.customer_id
    FROM payment AS p
    GROUP BY p.customer_id
    ORDER BY SUM(p.amount) DESC
    LIMIT 10
),
month_totals AS (
    SELECT p.customer_id,
           strftime('%Y-%m', p.payment_date) AS pay_month,
           ROUND(SUM(p.amount), 2)           AS monthly_total
    FROM payment AS p
    JOIN top_ten t USING (customer_id)
    GROUP BY p.customer_id, pay_month
)
SELECT DISTINCT m1.customer_id,
       m1.pay_month         AS current_month,
       m0.pay_month         AS prev_month,
       ROUND(m1.monthly_total - m0.monthly_total, 2) AS mom_diff
FROM month_totals AS m1
JOIN month_totals AS m0
  ON m1.customer_id = m0.customer_id
 AND m1.pay_month  = strftime('%Y-%m',
        date(m0.pay_month || '-01', '+1 month'))
ORDER BY ABS(mom_diff) DESC
LIMIT 20;
```

```sql
-- Description: 6) Retrieve only the single largest absolute MoM change among the top-10 customers.
WITH top_ten AS (
    SELECT p.customer_id
    FROM payment AS p
    GROUP BY p.customer_id
    ORDER BY SUM(p.amount) DESC
    LIMIT 10
),
month_totals AS (
    SELECT p.customer_id,
           strftime('%Y-%m', p.payment_date) AS pay_month,
           ROUND(SUM(p.amount), 2)           AS monthly_total
    FROM payment AS p
    JOIN top_ten t USING (customer_id)
    GROUP BY p.customer_id, pay_month
),
mom AS (
    SELECT m1.customer_id,
           m0.pay_month AS prev_month,
           m1.pay_month AS curr_month,
           ROUND(m1.monthly_total - m0.monthly_total, 2) AS mom_diff
    FROM month_totals m1
    JOIN month_totals m0
      ON m1.customer_id = m0.customer_id
     AND m1.pay_month  = strftime('%Y-%m',
         date(m0.pay_month || '-01', '+1 month'))
)
SELECT DISTINCT customer_id,
       prev_month || ' → ' || curr_month AS period,
       ROUND(mom_diff, 2)                AS largest_mom_difference
FROM mom
ORDER BY ABS(mom_diff) DESC
LIMIT 1;
```

```sql
-- Description: 7) Attach the customer’s full name to the winning record.
WITH top_ten AS (
    SELECT p.customer_id
    FROM payment AS p
    GROUP BY p.customer_id
    ORDER BY SUM(p.amount) DESC
    LIMIT 10
),
month_totals AS (
    SELECT p.customer_id,
           strftime('%Y-%m', p.payment_date) AS pay_month,
           ROUND(SUM(p.amount), 2)           AS monthly_total
    FROM payment AS p
    JOIN top_ten t USING (customer_id)
    GROUP BY p.customer_id, pay_month
),
mom AS (
    SELECT m1.customer_id,
           m0.pay_month AS prev_month,
           m1.pay_month AS curr_month,
           ROUND(m1.monthly_total - m0.monthly_total, 2) AS mom_diff
    FROM month_totals m1
    JOIN month_totals m0
      ON m1.customer_id = m0.customer_id
     AND m1.pay_month  = strftime('%Y-%m',
         date(m0.pay_month || '-01', '+1 month'))
),
winner AS (
    SELECT customer_id,
           prev_month,
           curr_month,
           mom_diff
    FROM mom
    ORDER BY ABS(mom_diff) DESC
    LIMIT 1
)
SELECT DISTINCT w.customer_id,
       c.first_name || ' ' || c.last_name AS customer_name,
       w.prev_month || ' → ' || w.curr_month AS period,
       ROUND(w.mom_diff, 2) AS largest_mom_difference
FROM winner AS w
JOIN customer AS c ON c.customer_id = w.customer_id;
```

```sql
-- Description: 8) If you need to verify raw monthly totals for that winner.
WITH winner_id AS (
    SELECT customer_id
    FROM payment
    GROUP BY customer_id
    ORDER BY SUM(amount) DESC
    LIMIT 1             -- replace if winner is not #1
)
SELECT DISTINCT strftime('%Y-%m', payment_date) AS pay_month,
       ROUND(SUM(amount), 2)                    AS monthly_total
FROM payment
WHERE customer_id = (SELECT customer_id FROM winner_id)
GROUP BY pay_month
ORDER BY pay_month
LIMIT 20;
```

```sql
-- Description: 9) Optional: list all MoM diffs for the winning customer for context.
WITH winner AS (
    SELECT customer_id
    FROM (
        SELECT p.customer_id,
               SUM(p.amount) AS tot
        FROM payment AS p
        GROUP BY p.customer_id
        ORDER BY tot DESC
        LIMIT 10
    )
    -- link to the earlier MAX result
    LIMIT 1
),
months AS (
    SELECT strftime('%Y-%m', payment_date) AS pay_month,
           SUM(amount)                     AS amt
    FROM payment
    WHERE customer_id = (SELECT customer_id FROM winner)
    GROUP BY pay_month
)
SELECT DISTINCT m1.pay_month AS curr_month,
       m0.pay_month AS prev_month,
       ROUND(m1.amt - m0.amt, 2) AS mom_diff
FROM months m1
JOIN months m0
  ON m1.pay_month = strftime('%Y-%m',
       date(m0.pay_month || '-01', '+1 month'))
ORDER BY curr_month
LIMIT 20;
```

