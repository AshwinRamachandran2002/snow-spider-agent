```sql
-- Description: Check each customer's total payments to identify the 10 biggest spenders
SELECT DISTINCT
       p.customer_id,
       ROUND(SUM(p.amount), 2) AS total_paid
FROM   payment AS p
GROUP  BY p.customer_id
ORDER  BY total_paid DESC
LIMIT  10;
```

```sql
-- Description: For those 10 customers, calculate how much each one paid in every month
SELECT DISTINCT
       p.customer_id,
       strftime('%Y-%m', p.payment_date) AS year_month,
       ROUND(SUM(p.amount), 2)            AS month_total
FROM   payment AS p
WHERE  p.customer_id IN (                 -- restrict to the 10 biggest spenders
       SELECT customer_id
       FROM   payment
       GROUP  BY customer_id
       ORDER  BY SUM(amount) DESC
       LIMIT 10)
GROUP  BY p.customer_id, year_month
ORDER  BY p.customer_id, year_month
LIMIT  20;
```

```sql
-- Description: Show month-over-month payment differences (absolute value) for the same 10 customers
SELECT DISTINCT
       m.customer_id,
       m.year_month,
       m.month_total,
       LAG(m.month_total) OVER (PARTITION BY m.customer_id
                                ORDER BY m.year_month)         AS prev_month_total,
       ROUND(ABS(m.month_total -
                 LAG(m.month_total) OVER (PARTITION BY m.customer_id
                                           ORDER BY m.year_month)), 2) AS diff_amt
FROM   (
        SELECT
               p.customer_id,
               strftime('%Y-%m', p.payment_date) AS year_month,
               SUM(p.amount)                     AS month_total
        FROM   payment AS p
        WHERE  p.customer_id IN (
               SELECT customer_id
               FROM   payment
               GROUP  BY customer_id
               ORDER  BY SUM(amount) DESC
               LIMIT 10)
        GROUP  BY p.customer_id, year_month
       ) AS m
ORDER  BY diff_amt DESC, m.customer_id, m.year_month
LIMIT  20;
```

```sql
-- Description: Retrieve the single largest month-over-month change among the top 10 customers
SELECT DISTINCT
       mo.customer_id,
       mo.year_month          AS month_of_max_change,
       ROUND(mo.diff_amt, 2)  AS max_monthly_difference
FROM  (
      SELECT
             m.customer_id,
             m.year_month,
             m.month_total,
             LAG(m.month_total) OVER (PARTITION BY m.customer_id
                                      ORDER BY m.year_month) AS prev_month_total,
             ABS(m.month_total -
                 LAG(m.month_total) OVER (PARTITION BY m.customer_id
                                           ORDER BY m.year_month)) AS diff_amt
      FROM (
           SELECT
                  p.customer_id,
                  strftime('%Y-%m', p.payment_date) AS year_month,
                  SUM(p.amount)                     AS month_total
           FROM   payment AS p
           WHERE  p.customer_id IN (
                  SELECT customer_id
                  FROM   payment
                  GROUP  BY customer_id
                  ORDER  BY SUM(amount) DESC
                  LIMIT 10)
           GROUP  BY p.customer_id, year_month
          ) AS m
     ) AS mo
ORDER BY mo.diff_amt DESC
LIMIT 1;
```

```sql
-- Description: Final answer – customer, month, and amount of the greatest month-over-month jump (rounded)
SELECT DISTINCT
       result.customer_id  AS customer_id,
       result.month_of_max_change,
       ROUND(result.max_monthly_difference, 2) AS largest_change
FROM (
     SELECT
            mo.customer_id,
            mo.year_month          AS month_of_max_change,
            mo.diff_amt            AS max_monthly_difference,
            ROW_NUMBER() OVER (ORDER BY mo.diff_amt DESC) AS rn
     FROM (
          SELECT
                 m.customer_id,
                 m.year_month,
                 ABS(m.month_total -
                     LAG(m.month_total) OVER (PARTITION BY m.customer_id
                                               ORDER BY m.year_month)) AS diff_amt
          FROM (
               SELECT
                      p.customer_id,
                      strftime('%Y-%m', p.payment_date) AS year_month,
                      SUM(p.amount)                     AS month_total
               FROM   payment AS p
               WHERE  p.customer_id IN (
                      SELECT customer_id
                      FROM   payment
                      GROUP  BY customer_id
                      ORDER  BY SUM(amount) DESC
                      LIMIT 10)
               GROUP  BY p.customer_id, year_month
              ) AS m
         ) AS mo
     WHERE mo.diff_amt IS NOT NULL
    ) AS result
WHERE result.rn = 1;
```
