Query:
-- Description: For those 10 customers, calculate how much each one paid in every month
SELECT DISTINCT
       p.customer_id,
       strftime('%Y-%m', p.payment_date) AS year_month,
       ROUND(SUM(p.amount), 2)            AS month_total
FROM   payment AS p
WHERE  p.customer_id IN (                 -- restrict to the 10 biggest spenders
       SELECT customer_id
       FROM   payment
       GROUP  BY customer_id
       ORDER  BY SUM(amount) DESC
       LIMIT 10)
GROUP  BY p.customer_id, year_month
ORDER  BY p.customer_id, year_month
LIMIT  20;
