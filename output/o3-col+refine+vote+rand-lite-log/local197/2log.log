Query:
-- 3. Monthly payment totals for those top-10 customers  
WITH top10 AS (                              
    SELECT "customer_id"
    FROM   "payment"
    GROUP  BY "customer_id"
    ORDER  BY SUM("amount") DESC
    LIMIT 10
)
SELECT p."customer_id",
       strftime('%Y-%m', p."payment_date")     AS "yyyymm",
       ROUND(SUM(p."amount"),2)               AS "month_total"
FROM   "payment"  AS p
JOIN   top10      AS t USING ("customer_id")
GROUP  BY p."customer_id", "yyyymm"
ORDER  BY p."customer_id", "yyyymm"
LIMIT 20;
