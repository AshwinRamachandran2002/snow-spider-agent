Query:
-- 4. Add the previous month’s total per customer (using LAG)  
WITH top10 AS (
    SELECT "customer_id"
    FROM   "payment"
    GROUP  BY "customer_id"
    ORDER  BY SUM("amount") DESC
    LIMIT 10
),
month_pay AS (
    SELECT p."customer_id",
           strftime('%Y-%m', p."payment_date") AS "yyyymm",
           SUM(p."amount")                     AS "month_total"
    FROM   "payment" AS p
    JOIN   top10    AS t USING ("customer_id")
    GROUP  BY p."customer_id", "yyyymm"
)
SELECT  "customer_id",
        "yyyymm",
        ROUND("month_total",2)                 AS "month_total",
        ROUND(LAG("month_total") OVER (
              PARTITION BY "customer_id"
              ORDER BY "yyyymm"),2)            AS "prev_month_total"
FROM    month_pay
ORDER   BY "customer_id", "yyyymm"
LIMIT 20;
