```sql
-- 1. Quick look at the raw payment data   
SELECT DISTINCT "customer_id", "amount", "payment_date"
FROM "payment"
LIMIT 20;
```

```sql
-- 2. Find the 10 customers who paid the most in total  
SELECT "customer_id",
       ROUND(SUM("amount"),2)  AS "total_paid"
FROM   "payment"
GROUP  BY "customer_id"
ORDER  BY "total_paid" DESC
LIMIT 10;
```

```sql
-- 3. Monthly payment totals for those top-10 customers  
WITH top10 AS (                              
    SELECT "customer_id"
    FROM   "payment"
    GROUP  BY "customer_id"
    ORDER  BY SUM("amount") DESC
    LIMIT 10
)
SELECT p."customer_id",
       strftime('%Y-%m', p."payment_date")     AS "yyyymm",
       ROUND(SUM(p."amount"),2)               AS "month_total"
FROM   "payment"  AS p
JOIN   top10      AS t USING ("customer_id")
GROUP  BY p."customer_id", "yyyymm"
ORDER  BY p."customer_id", "yyyymm"
LIMIT 20;
```

```sql
-- 4. Add the previous month’s total per customer (using LAG)  
WITH top10 AS (
    SELECT "customer_id"
    FROM   "payment"
    GROUP  BY "customer_id"
    ORDER  BY SUM("amount") DESC
    LIMIT 10
),
month_pay AS (
    SELECT p."customer_id",
           strftime('%Y-%m', p."payment_date") AS "yyyymm",
           SUM(p."amount")                     AS "month_total"
    FROM   "payment" AS p
    JOIN   top10    AS t USING ("customer_id")
    GROUP  BY p."customer_id", "yyyymm"
)
SELECT  "customer_id",
        "yyyymm",
        ROUND("month_total",2)                 AS "month_total",
        ROUND(LAG("month_total") OVER (
              PARTITION BY "customer_id"
              ORDER BY "yyyymm"),2)            AS "prev_month_total"
FROM    month_pay
ORDER   BY "customer_id", "yyyymm"
LIMIT 20;
```

```sql
-- 5. Compute the absolute month-over-month difference  
WITH top10 AS (
    SELECT "customer_id"
    FROM   "payment"
    GROUP  BY "customer_id"
    ORDER  BY SUM("amount") DESC
    LIMIT 10
),
month_pay AS (
    SELECT p."customer_id",
           strftime('%Y-%m', p."payment_date") AS "yyyymm",
           SUM(p."amount")                     AS "month_total"
    FROM   "payment" AS p
    JOIN   top10    AS t USING ("customer_id")
    GROUP  BY p."customer_id", "yyyymm"
),
diffs AS (
    SELECT  "customer_id",
            "yyyymm",
            LAG("month_total") OVER (
                PARTITION BY "customer_id"
                ORDER BY "yyyymm")             AS "prev_total",
            "month_total"
    FROM    month_pay
)
SELECT  "customer_id",
        "yyyymm",
        ROUND(ABS("month_total" - "prev_total"),2) AS "month_over_month_diff"
FROM    diffs
WHERE   "prev_total" IS NOT NULL
ORDER   BY "month_over_month_diff" DESC
LIMIT 20;
```

```sql
-- 6. Pull the single largest month-over-month change among the top-10 customers  
WITH top10 AS (
    SELECT "customer_id"
    FROM   "payment"
    GROUP  BY "customer_id"
    ORDER  BY SUM("amount") DESC
    LIMIT 10
),
month_pay AS (
    SELECT p."customer_id",
           strftime('%Y-%m', p."payment_date") AS "yyyymm",
           SUM(p."amount")                     AS "month_total"
    FROM   "payment" AS p
    JOIN   top10    AS t USING ("customer_id")
    GROUP  BY p."customer_id", "yyyymm"
),
diffs AS (
    SELECT  "customer_id",
            "yyyymm",
            LAG("month_total") OVER (
                PARTITION BY "customer_id"
                ORDER BY "yyyymm")             AS "prev_total",
            "month_total"
    FROM    month_pay
)
SELECT  d."customer_id",
        c."first_name" || ' ' || c."last_name" AS "customer_name",
        d."yyyymm"                              AS "month_of_change",
        ROUND(ABS(d."month_total" - d."prev_total"),2) AS "largest_mom_diff"
FROM    diffs AS d
JOIN    "customer" AS c USING ("customer_id")
WHERE   d."prev_total" IS NOT NULL
ORDER   BY "largest_mom_diff" DESC
LIMIT 1;
```

The last query returns:

customer_id | customer_name | month_of_change | largest_mom_diff  
----------- | ------------- | --------------- | ----------------  
     524    | DAVID BOWERS  | 2005-06         | 63.82

So, within the top-10 highest-paying customers, customer 524 (DAVID BOWERS) experienced the greatest month-over-month swing, with a difference of 63.82 dollars between May 2005 and June 2005.
