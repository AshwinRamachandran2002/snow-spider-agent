Query:
--Description: Identify the single largest month-over-month difference (positive or negative) among top 10 payers
SELECT DISTINCT customer_id,
       yyyy_mm            AS month_of_change,    -- current month
       ROUND(ABS(mom_diff),2) AS abs_difference
FROM (
    SELECT customer_id,
           yyyy_mm,
           month_total,
           LAG(month_total) OVER (PARTITION BY customer_id ORDER BY yyyy_mm) AS prev_month_total,
           month_total - LAG(month_total) OVER (PARTITION BY customer_id ORDER BY yyyy_mm) AS mom_diff
    FROM (
        SELECT p.customer_id,
               strftime('%Y-%m', p.payment_date) AS yyyy_mm,
               SUM(p.amount)                     AS month_total
        FROM   payment AS p
        WHERE  p.customer_id IN (
                SELECT customer_id
                FROM (
                    SELECT customer_id,
                           SUM(amount) AS total_paid
                    FROM payment
                    GROUP BY customer_id
                    ORDER BY total_paid DESC
                    LIMIT 10
                )
              )
        GROUP BY p.customer_id,
                 yyyy_mm
    )
)
WHERE mom_diff IS NOT NULL
ORDER BY abs_difference DESC
LIMIT 1;
