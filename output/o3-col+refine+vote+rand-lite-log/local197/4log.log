```sql
--Description: Take a quick look at the raw payment facts we will analyse
SELECT *
FROM payment
LIMIT 20;
```

```sql
--Description: Compute each customer’s lifetime payment total
SELECT customer_id,
       ROUND(SUM(amount), 2) AS total_paid
FROM payment
GROUP BY customer_id
ORDER BY total_paid DESC
LIMIT 20;
```

```sql
--Description: Isolate our 10 biggest payers (by total amount)
SELECT DISTINCT customer_id
FROM (
    SELECT customer_id,
           SUM(amount) AS total_paid
    FROM payment
    GROUP BY customer_id
    ORDER BY total_paid DESC
    LIMIT 10
);
```

```sql
--Description: Monthly payment totals for those top-10 customers
SELECT p.customer_id,
       strftime('%Y-%m', p.payment_date) AS yyyy_mm,
       ROUND(SUM(p.amount),2)            AS month_total
FROM   payment AS p
WHERE  p.customer_id IN (                         -- top 10 set
        SELECT customer_id
        FROM (
            SELECT customer_id,
                   SUM(amount) AS total_paid
            FROM payment
            GROUP BY customer_id
            ORDER BY total_paid DESC
            LIMIT 10
        )
      )
GROUP BY p.customer_id,
         yyyy_mm
ORDER BY p.customer_id,
         yyyy_mm
LIMIT 20;
```

```sql
--Description: For each of those customers, calculate month-over-month (MoM) change
SELECT customer_id,
       yyyy_mm,
       month_total,
       LAG(month_total) OVER (PARTITION BY customer_id ORDER BY yyyy_mm) AS prev_month_total,
       ROUND(month_total - LAG(month_total) OVER (PARTITION BY customer_id ORDER BY yyyy_mm),2) AS mom_diff
FROM (
    SELECT p.customer_id,
           strftime('%Y-%m', p.payment_date) AS yyyy_mm,
           SUM(p.amount)                     AS month_total
    FROM   payment AS p
    WHERE  p.customer_id IN (
            SELECT customer_id
            FROM (
                SELECT customer_id,
                       SUM(amount) AS total_paid
                FROM payment
                GROUP BY customer_id
                ORDER BY total_paid DESC
                LIMIT 10
            )
          )
    GROUP BY p.customer_id,
             yyyy_mm
)
ORDER BY customer_id,
         yyyy_mm
LIMIT 40;
```

```sql
--Description: Identify the single largest month-over-month difference (positive or negative) among top 10 payers
SELECT DISTINCT customer_id,
       yyyy_mm            AS month_of_change,    -- current month
       ROUND(ABS(mom_diff),2) AS abs_difference
FROM (
    SELECT customer_id,
           yyyy_mm,
           month_total,
           LAG(month_total) OVER (PARTITION BY customer_id ORDER BY yyyy_mm) AS prev_month_total,
           month_total - LAG(month_total) OVER (PARTITION BY customer_id ORDER BY yyyy_mm) AS mom_diff
    FROM (
        SELECT p.customer_id,
               strftime('%Y-%m', p.payment_date) AS yyyy_mm,
               SUM(p.amount)                     AS month_total
        FROM   payment AS p
        WHERE  p.customer_id IN (
                SELECT customer_id
                FROM (
                    SELECT customer_id,
                           SUM(amount) AS total_paid
                    FROM payment
                    GROUP BY customer_id
                    ORDER BY total_paid DESC
                    LIMIT 10
                )
              )
        GROUP BY p.customer_id,
                 yyyy_mm
    )
)
WHERE mom_diff IS NOT NULL
ORDER BY abs_difference DESC
LIMIT 1;
```

```sql
--Description: (Optional check) Show the full month-by-month history for the winning customer to validate result
SELECT customer_id,
       yyyy_mm,
       ROUND(month_total,2) AS month_total
FROM (
    SELECT p.customer_id,
           strftime('%Y-%m', p.payment_date) AS yyyy_mm,
           SUM(p.amount)                     AS month_total
    FROM   payment AS p
    GROUP BY p.customer_id,
             yyyy_mm
) AS m
WHERE customer_id = (
        SELECT customer_id
        FROM (
            SELECT customer_id,
                   yyyy_mm,
                   ABS(month_total - LAG(month_total) OVER (PARTITION BY customer_id ORDER BY yyyy_mm)) AS abs_diff
            FROM (
                SELECT p.customer_id,
                       strftime('%Y-%m', p.payment_date) AS yyyy_mm,
                       SUM(p.amount)                     AS month_total
                FROM   payment AS p
                WHERE  p.customer_id IN (
                        SELECT customer_id
                        FROM (
                            SELECT customer_id,
                                   SUM(amount) AS total_paid
                            FROM payment
                            GROUP BY customer_id
                            ORDER BY total_paid DESC
                            LIMIT 10
                        )
                      )
                GROUP BY p.customer_id,
                         yyyy_mm
            )
        )
        ORDER BY abs_diff DESC
        LIMIT 1
)
ORDER BY yyyy_mm
LIMIT 20;
```

These successive queries narrow the focus from raw payments to top 10 customers, compute their month-over-month deltas, and finally extract the single largest change along with the customer and month in which it happened.
