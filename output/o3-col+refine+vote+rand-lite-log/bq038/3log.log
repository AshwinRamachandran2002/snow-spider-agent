-- “Group ride” = a round-trip (same start & end station) where ≥ 2 such trips end
-- in the SAME 2-minute window (station-wise). Plan:
--   1. Filter citibike_trips for round-trips (start_station_id = end_station_id).
--   2. Put each trip into a 2-minute bucket:   bucket = FLOOR(UNIX_SECONDS(stoptime)/120).
--   3. With a window COUNT over (station , bucket) tag trips as group (count>1) or solo.
--   4. Aggregate by station:  group_trips, total_trips, ratio = group/total.
--   5. Keep stations with at least 100 round-trips to avoid tiny denominators.
--   6. Join to citibike_stations for names.  trip table IDs are INT64; lookup IDs are
--      STRING, so cast INT64 → STRING when joining.
--   7. Order by ratio desc, limit 10.

SELECT
  st.name                           AS station_name,
  stats.end_station_id              AS station_id,
  stats.group_trips,
  stats.total_trips_ending,
  stats.group_ride_ratio
FROM (
  -- Steps 1-4: build per-station statistics
  SELECT
    end_station_id,
    SUM(is_group)                        AS group_trips,
    COUNT(*)                             AS total_trips_ending,
    SAFE_DIVIDE(SUM(is_group), COUNT(*)) AS group_ride_ratio
  FROM (
    -- Steps 1-3: flag each round-trip as group (=1) or solo (=0)
    SELECT
      end_station_id,
      CASE
        WHEN COUNT(*) OVER (
               PARTITION BY end_station_id,
                            TIMESTAMP_SECONDS(DIV(UNIX_SECONDS(stoptime),120)*120)
             ) > 1
        THEN 1 ELSE 0
      END AS is_group
    FROM `bigquery-public-data.new_york.citibike_trips`
    WHERE start_station_id = end_station_id
  )
  GROUP BY end_station_id
  HAVING total_trips_ending > 100            -- Step 5: sample-size threshold
) AS stats
LEFT JOIN `bigquery-public-data.new_york.citibike_stations` AS st
       ON st.station_id = CAST(stats.end_station_id AS STRING)   -- Step 6 join
ORDER BY stats.group_ride_ratio DESC                              -- Step 7
LIMIT 10;
