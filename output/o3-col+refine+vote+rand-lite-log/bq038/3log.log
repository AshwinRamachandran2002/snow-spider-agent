Query:
--Description: Tag every trip that meets the “group ride” definition:
--             (1) same start & end station  (2) ≥2 trips share the same 2-min bucket at _stop_.
SELECT
  `trip_id`,                                -- synthetic row id for illustration
  `end_station_id`,
  `stoptime`,
  CASE
    WHEN cnt_in_bucket > 1 THEN 1 ELSE 0
  END AS `is_group_trip`
FROM (
  SELECT
    GENERATE_UUID() AS `trip_id`,            -- creates per-row id
    `end_station_id`,
    `stoptime`,
    COUNT(*) OVER (
      PARTITION BY `end_station_id`,
                   TIMESTAMP_SECONDS(DIV(UNIX_SECONDS(`stoptime`),120)*120)
    ) AS cnt_in_bucket
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE `start_station_id` = `end_station_id`
)
LIMIT 20;
