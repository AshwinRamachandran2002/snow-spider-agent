WHERE `start_station_id` = `end_station_id`
  AND `end_station_id` = 520          -- sample station picked from earlier query
GROUP BY `end_station_id`, `two_min_bucket`
HAVING `trips_in_bucket` > 1
ORDER BY `two_min_bucket`
LIMIT 20;
```

```sql
--Description: Tag every trip that meets the “group ride” definition:
--             (1) same start & end station  (2) ≥2 trips share the same 2-min bucket at _stop_.
SELECT
  `trip_id`,                                -- synthetic row id for illustration
  `end_station_id`,
  `stoptime`,
  CASE
    WHEN cnt_in_bucket > 1 THEN 1 ELSE 0
  END AS `is_group_trip`
FROM (
  SELECT
    GENERATE_UUID() AS `trip_id`,            -- creates per-row id
    `end_station_id`,
    `stoptime`,
    COUNT(*) OVER (
      PARTITION BY `end_station_id`,
                   TIMESTAMP_SECONDS(DIV(UNIX_SECONDS(`stoptime`),120)*120)
    ) AS cnt_in_bucket
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE `start_station_id` = `end_station_id`
)
LIMIT 20;
```

```sql
--Description: Compute total trips ending at each station & how many are part of a group.
SELECT
  `end_station_id`,
  SUM(`is_group_trip`)       AS `group_trips`,
  COUNT(*)                   AS `total_trips_ending`
FROM (
  SELECT
    `end_station_id`,
    CASE
      WHEN COUNT(*) OVER (
             PARTITION BY `end_station_id`,
                          TIMESTAMP_SECONDS(DIV(UNIX_SECONDS(`stoptime`),120)*120)
           ) > 1
      THEN 1 ELSE 0
    END AS `is_group_trip`
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE `start_station_id` = `end_station_id`
)
GROUP BY `end_station_id`
LIMIT 20;
```

```sql
--Description: Calculate proportion of group rides for every station (pre-filtering stations with enough trips).
SELECT
  `end_station_id`,
  SAFE_DIVIDE(`group_trips`, `total_trips_ending`) AS `group_ride_ratio`
FROM (
  SELECT
    `end_station_id`,
    SUM(`is_group_trip`) AS `group_trips`,
    COUNT(*)             AS `total_trips_ending`
  FROM (
    SELECT
      `end_station_id`,
      CASE
        WHEN COUNT(*) OVER (
               PARTITION BY `end_station_id`,
                            TIMESTAMP_SECONDS(DIV(UNIX_SECONDS(`stoptime`),120)*120)
             ) > 1
        THEN 1 ELSE 0
      END AS `is_group_trip`
    FROM `bigquery-public-data.new_york.citibike_trips`
    WHERE `start_station_id` = `end_station_id`
  )
  GROUP BY `end_station_id`
)
WHERE `total_trips_ending` > 100        -- keep stations with some usage
ORDER BY `group_ride_ratio` DESC
LIMIT 20;
```

```sql
--Description: Final answer – top 10 stations with highest proportion of group rides,
--             joined to get readable station names.
SELECT
  s.`name`                              AS `station_name`,
  r.`end_station_id`                    AS `station_id`,
  r.`group_trips`,
  r.`total_trips_ending`,
  r.`group_ride_ratio`
FROM (
  -- ratio per station computed exactly as above
  SELECT
    `end_station_id`,
    SUM(`is_group_trip`) AS `group_trips`,
    COUNT(*)             AS `total_trips_ending`,
    SAFE_DIVIDE(SUM(`is_group_trip`), COUNT(*)) AS `group_ride_ratio`
  FROM (
    SELECT
      `end_station_id`,
      CASE
        WHEN COUNT(*) OVER (
               PARTITION BY `end_station_id`,
                            TIMESTAMP_SECONDS(DIV(UNIX_SECONDS(`stoptime`),120)*120)
             ) > 1
        THEN 1 ELSE 0
      END AS `is_group_trip`
    FROM `bigquery-public-data.new_york.citibike_trips`
    WHERE `start_station_id` = `end_station_id`
  )
  GROUP BY `end_station_id`
  HAVING `total_trips_ending` > 100     -- optional threshold
) AS r
LEFT JOIN `bigquery-public-data.new_york.citibike_stations` AS s
  ON CAST(s.`station_id` AS INT64) = r.`end_station_id`
ORDER BY `group_ride_ratio` DESC
LIMIT 10;
```
