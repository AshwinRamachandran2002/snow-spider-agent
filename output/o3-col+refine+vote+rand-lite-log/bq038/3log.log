Query:
--Description: For one sample station, bucket round-trip STOP times into 2-minute windows
--             and show windows that already contain >1 trip (i.e., potential group).
SELECT
  `end_station_id`,
  TIMESTAMP_SECONDS(DIV(UNIX_SECONDS(`stoptime`),120)*120) AS `two_min_bucket`,
  COUNT(*) AS `trips_in_bucket`
FROM `bigquery-public-data.new_york.citibike_trips`
WHERE `start_station_id` = `end_station_id`
  AND `end_station_id` = 520          -- sample station picked from earlier query
GROUP BY `end_station_id`, `two_min_bucket`
HAVING `trips_in_bucket` > 1
ORDER BY `two_min_bucket`
LIMIT 20;
