Query:
--Description: Compute total trips ending at each station & how many are part of a group.
SELECT
  `end_station_id`,
  SUM(`is_group_trip`)       AS `group_trips`,
  COUNT(*)                   AS `total_trips_ending`
FROM (
  SELECT
    `end_station_id`,
    CASE
      WHEN COUNT(*) OVER (
             PARTITION BY `end_station_id`,
                          TIMESTAMP_SECONDS(DIV(UNIX_SECONDS(`stoptime`),120)*120)
           ) > 1
      THEN 1 ELSE 0
    END AS `is_group_trip`
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE `start_station_id` = `end_station_id`
)
GROUP BY `end_station_id`
LIMIT 20;
