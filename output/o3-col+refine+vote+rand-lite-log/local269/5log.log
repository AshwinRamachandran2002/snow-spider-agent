Query:
-- 9. Final step: the requested average of those totals across all root packages
WITH RECURSIVE r(parent_id, leaf_id, qty) AS (
    SELECT packaging_id,
           contains_id,
           qty
    FROM   packaging_relations
    UNION ALL
    SELECT r.parent_id,
           pr.contains_id,
           r.qty * pr.qty
    FROM   r
    JOIN   packaging_relations AS pr
           ON pr.packaging_id = r.leaf_id
), per_pack AS (
    SELECT parent_id,
           SUM(qty) AS total_leaf_qty
    FROM   r
    GROUP BY parent_id
)
SELECT AVG(total_leaf_qty) AS avg_total_quantity_per_package
FROM   per_pack;
