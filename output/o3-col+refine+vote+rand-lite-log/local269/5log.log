```sql
-- 1. Overview: list every packaging item in the catalogue
SELECT DISTINCT id, name
FROM packaging
LIMIT 20;
```

```sql
-- 2. Basic relations: which packaging items contain which others and in what qty?
SELECT DISTINCT packaging_id, contains_id, qty
FROM packaging_relations
LIMIT 20;
```

```sql
-- 3. Same as (2) but with human-readable names for both the container and the content
SELECT DISTINCT pr.packaging_id      AS parent_id,
                p1.name              AS parent_name,
                pr.contains_id       AS child_id,
                p2.name              AS child_name,
                pr.qty
FROM packaging_relations AS pr
JOIN packaging AS p1 ON p1.id = pr.packaging_id
JOIN packaging AS p2 ON p2.id = pr.contains_id
LIMIT 20;
```

```sql
-- 4. Which packaging items act as *containers* (have children)?
SELECT DISTINCT packaging_id
FROM packaging_relations
LIMIT 20;
```

```sql
-- 5. Which packaging items are *leaf* items (never appear as a parent)?
SELECT DISTINCT id, name
FROM packaging
WHERE id NOT IN (SELECT DISTINCT packaging_id FROM packaging_relations)
LIMIT 20;
```

```sql
-- 6. Detect possible nesting: children that are themselves parents somewhere else
SELECT DISTINCT pr.contains_id      AS nested_parent_id,
                p.name              AS nested_parent_name
FROM packaging_relations AS pr
JOIN packaging AS p ON p.id = pr.contains_id
WHERE pr.contains_id IN (SELECT DISTINCT packaging_id FROM packaging_relations)
LIMIT 20;
```

```sql
-- 7. Recursively expand every packaging combination down to its leaf-level items
WITH RECURSIVE r(parent_id, leaf_id, qty) AS (
    -- anchor: direct contents
    SELECT packaging_id,
           contains_id,
           qty
    FROM   packaging_relations
    UNION ALL
    -- recursive step: if a child is itself a container, go one level deeper
    SELECT r.parent_id,
           pr.contains_id,
           r.qty * pr.qty            -- multiply quantities along the path
    FROM   r
    JOIN   packaging_relations AS pr
           ON pr.packaging_id = r.leaf_id
)
SELECT parent_id,
       leaf_id,
       SUM(qty) AS total_leaf_qty
FROM   r
GROUP BY parent_id, leaf_id
LIMIT 20;
```

```sql
-- 8. Aggregate: total quantity of *all* leaf items inside each *root* packaging id
WITH RECURSIVE r(parent_id, leaf_id, qty) AS (
    SELECT packaging_id,
           contains_id,
           qty
    FROM   packaging_relations
    UNION ALL
    SELECT r.parent_id,
           pr.contains_id,
           r.qty * pr.qty
    FROM   r
    JOIN   packaging_relations AS pr
           ON pr.packaging_id = r.leaf_id
)
SELECT parent_id                 AS packaging_id,
       SUM(qty)                  AS total_qty_across_leaves
FROM   r
GROUP BY parent_id
LIMIT 20;
```

```sql
-- 9. Final step: the requested average of those totals across all root packages
WITH RECURSIVE r(parent_id, leaf_id, qty) AS (
    SELECT packaging_id,
           contains_id,
           qty
    FROM   packaging_relations
    UNION ALL
    SELECT r.parent_id,
           pr.contains_id,
           r.qty * pr.qty
    FROM   r
    JOIN   packaging_relations AS pr
           ON pr.packaging_id = r.leaf_id
), per_pack AS (
    SELECT parent_id,
           SUM(qty) AS total_leaf_qty
    FROM   r
    GROUP BY parent_id
)
SELECT AVG(total_leaf_qty) AS avg_total_quantity_per_package
FROM   per_pack;
```

```sql
-- 10. For reference, show each packaging name together with its computed total
WITH RECURSIVE r(parent_id, leaf_id, qty) AS (
    SELECT packaging_id,
           contains_id,
           qty
    FROM   packaging_relations
    UNION ALL
    SELECT r.parent_id,
           pr.contains_id,
           r.qty * pr.qty
    FROM   r
    JOIN   packaging_relations AS pr
           ON pr.packaging_id = r.leaf_id
), per_pack AS (
    SELECT parent_id,
           SUM(qty) AS total_leaf_qty
    FROM   r
    GROUP BY parent_id
)
SELECT pp.parent_id        AS packaging_id,
       p.name              AS packaging_name,
       pp.total_leaf_qty
FROM   per_pack  AS pp
JOIN   packaging AS p ON p.id = pp.parent_id
LIMIT 20;
```
