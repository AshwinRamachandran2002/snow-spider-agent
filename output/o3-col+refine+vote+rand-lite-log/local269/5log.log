Query:
-- 7. Recursively expand every packaging combination down to its leaf-level items
WITH RECURSIVE r(parent_id, leaf_id, qty) AS (
    -- anchor: direct contents
    SELECT packaging_id,
           contains_id,
           qty
    FROM   packaging_relations
    UNION ALL
    -- recursive step: if a child is itself a container, go one level deeper
    SELECT r.parent_id,
           pr.contains_id,
           r.qty * pr.qty            -- multiply quantities along the path
    FROM   r
    JOIN   packaging_relations AS pr
           ON pr.packaging_id = r.leaf_id
)
SELECT parent_id,
       leaf_id,
       SUM(qty) AS total_leaf_qty
FROM   r
GROUP BY parent_id, leaf_id
LIMIT 20;
