```sql
-- 1.  Get an overview of all available packaging definitions
SELECT DISTINCT
       p.id   AS packaging_id,
       p.name AS packaging_name
FROM   packaging AS p
LIMIT 20;
```

```sql
-- 2.  Inspect all “parent ➜ child” links that build the Bill-Of-Materials (BOM)
SELECT DISTINCT
       pr.packaging_id  AS parent_pack,
       pr.contains_id   AS child_pack,
       pr.qty           AS child_qty
FROM   packaging_relations AS pr
LIMIT 20;
```

```sql
-- 3.  Which packaging items actually contain other items (i.e. are NOT leaves)?
SELECT DISTINCT
       pr.packaging_id AS non_leaf_pack
FROM   packaging_relations AS pr
LIMIT 20;
```

```sql
-- 4.  Which packaging items never appear as a parent (true leaves in the BOM)?
SELECT DISTINCT
       pr.contains_id AS leaf_pack
FROM   packaging_relations AS pr
WHERE  pr.contains_id NOT IN (SELECT packaging_id FROM packaging_relations)
LIMIT 20;
```

```sql
-- 5.  Expand every BOM recursively down to its leaves, keeping the running quantity
WITH RECURSIVE bom(packaging_id, leaf_id, qty) AS (
       -- start with the direct relations
       SELECT pr.packaging_id,
              pr.contains_id,
              pr.qty
       FROM   packaging_relations AS pr
       UNION ALL
       -- walk further down whenever the current leaf still contains sub-items
       SELECT b.packaging_id,
              pr.contains_id,
              b.qty * pr.qty
       FROM   bom AS b
       JOIN   packaging_relations AS pr
              ON pr.packaging_id = b.leaf_id
)
SELECT DISTINCT
       bom.packaging_id,
       bom.leaf_id,
       bom.qty AS leaf_qty
FROM   bom
LIMIT 20;
```

```sql
-- 6.  Sum the quantities of all leaf-level items for each top-level package
WITH RECURSIVE bom(packaging_id, leaf_id, qty) AS (
       SELECT pr.packaging_id,
              pr.contains_id,
              pr.qty
       FROM   packaging_relations AS pr
       UNION ALL
       SELECT b.packaging_id,
              pr.contains_id,
              b.qty * pr.qty
       FROM   bom AS b
       JOIN   packaging_relations AS pr
              ON pr.packaging_id = b.leaf_id
),
leaf_only AS (
       SELECT packaging_id,
              leaf_id,
              qty
       FROM   bom
       WHERE  leaf_id NOT IN (SELECT DISTINCT packaging_id FROM packaging_relations)
)
SELECT DISTINCT
       packaging_id,
       SUM(qty) AS total_leaf_qty
FROM   leaf_only
GROUP  BY packaging_id
LIMIT 20;
```

```sql
-- 7.  Count how many distinct top-level packaging combinations exist
WITH RECURSIVE bom(packaging_id, leaf_id, qty) AS (
       SELECT pr.packaging_id,
              pr.contains_id,
              pr.qty
       FROM   packaging_relations AS pr
       UNION ALL
       SELECT b.packaging_id,
              pr.contains_id,
              b.qty * pr.qty
       FROM   bom AS b
       JOIN   packaging_relations AS pr
              ON pr.packaging_id = b.leaf_id
),
leaf_only AS (
       SELECT packaging_id,
              leaf_id,
              qty
       FROM   bom
       WHERE  leaf_id NOT IN (SELECT DISTINCT packaging_id FROM packaging_relations)
),
totals AS (
       SELECT packaging_id,
              SUM(qty) AS total_leaf_qty
       FROM   leaf_only
       GROUP  BY packaging_id
)
SELECT DISTINCT
       COUNT(*) AS nbr_of_packages
FROM   totals
LIMIT 20;
```

```sql
-- 8.  FINAL RESULT – average total quantity per packaging combination
WITH RECURSIVE bom(packaging_id, leaf_id, qty) AS (
       SELECT pr.packaging_id,
              pr.contains_id,
              pr.qty
       FROM   packaging_relations AS pr
       UNION ALL
       SELECT b.packaging_id,
              pr.contains_id,
              b.qty * pr.qty
       FROM   bom AS b
       JOIN   packaging_relations AS pr
              ON pr.packaging_id = b.leaf_id
),
leaf_only AS (
       SELECT packaging_id,
              leaf_id,
              qty
       FROM   bom
       WHERE  leaf_id NOT IN (SELECT DISTINCT packaging_id FROM packaging_relations)
),
totals AS (
       SELECT packaging_id,
              SUM(qty) AS total_leaf_qty
       FROM   leaf_only
       GROUP  BY packaging_id
)
SELECT DISTINCT
       AVG(total_leaf_qty) AS average_total_leaf_qty
FROM   totals;
```

Explanation of the last query  
• `bom` recursively flattens every package down to the smallest (leaf) items, multiplying quantities along the path.  
• `leaf_only` keeps only those rows whose `leaf_id` never appears as a parent in `packaging_relations`, guaranteeing true leaf components.  
• `totals` aggregates the leaf quantities per top-level `packaging_id`.  
• Finally, `AVG(total_leaf_qty)` delivers the requested “average total quantity across all final packaging combinations”.
