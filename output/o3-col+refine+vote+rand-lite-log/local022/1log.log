```sql
-- Description: Peek at batsman-wise scoring events.
SELECT DISTINCT * 
FROM "batsman_scored" 
LIMIT 20;
```

```sql
-- Description: Join every scoring event to the ball record in order to know the striker (player_id).
SELECT DISTINCT 
       bs."match_id",
       bs."over_id",
       bs."ball_id",
       bb."striker"  AS player_id,
       bs."runs_scored"
FROM   "batsman_scored" AS bs
JOIN   "ball_by_ball"   AS bb
  ON   bs."match_id"   = bb."match_id"
 AND   bs."over_id"    = bb."over_id"
 AND   bs."ball_id"    = bb."ball_id"
 AND   bs."innings_no" = bb."innings_no"
LIMIT 20;
```

```sql
-- Description: Aggregate total runs each player scores in every match.
SELECT 
       bb."striker"           AS player_id,
       bs."match_id",
       SUM(bs."runs_scored")  AS total_runs
FROM   "batsman_scored" AS bs
JOIN   "ball_by_ball"   AS bb
  ON   bs."match_id"   = bb."match_id"
 AND   bs."over_id"    = bb."over_id"
 AND   bs."ball_id"    = bb."ball_id"
 AND   bs."innings_no" = bb."innings_no"
GROUP BY bs."match_id", bb."striker"
ORDER BY total_runs DESC
LIMIT 20;
```

```sql
-- Description: Keep only centuries (≥ 100 runs in a single match).
SELECT 
       bb."striker"  AS player_id,
       bs."match_id",
       SUM(bs."runs_scored") AS total_runs
FROM   "batsman_scored" AS bs
JOIN   "ball_by_ball"   AS bb
  ON   bs."match_id"   = bb."match_id"
 AND   bs."over_id"    = bb."over_id"
 AND   bs."ball_id"    = bb."ball_id"
 AND   bs."innings_no" = bb."innings_no"
GROUP BY bs."match_id", bb."striker"
HAVING SUM(bs."runs_scored") >= 100
ORDER BY total_runs DESC
LIMIT 20;
```

```sql
-- Description: Add the batting team to every century.
SELECT 
       bb."striker"  AS player_id,
       bs."match_id",
       bb."team_batting" AS team_id,
       SUM(bs."runs_scored") AS total_runs
FROM   "batsman_scored" AS bs
JOIN   "ball_by_ball"   AS bb
  ON   bs."match_id"   = bb."match_id"
 AND   bs."over_id"    = bb."over_id"
 AND   bs."ball_id"    = bb."ball_id"
 AND   bs."innings_no" = bb."innings_no"
GROUP BY bs."match_id", bb."striker", bb."team_batting"
HAVING SUM(bs."runs_scored") >= 100
LIMIT 20;
```

```sql
-- Description: Compare each century-maker’s team with the match winner.
SELECT 
       c.player_id,
       c."match_id",
       c.team_id,
       c.total_runs,
       m."match_winner"
FROM  (
        SELECT 
               bb."striker"          AS player_id,
               bs."match_id",
               bb."team_batting"     AS team_id,
               SUM(bs."runs_scored") AS total_runs
        FROM   "batsman_scored" AS bs
        JOIN   "ball_by_ball"   AS bb
          ON   bs."match_id"   = bb."match_id"
         AND   bs."over_id"    = bb."over_id"
         AND   bs."ball_id"    = bb."ball_id"
         AND   bs."innings_no" = bb."innings_no"
        GROUP BY bs."match_id", bb."striker", bb."team_batting"
        HAVING SUM(bs."runs_scored") >= 100
      ) AS c
JOIN   "match" AS m
  ON   c."match_id" = m."match_id"
LIMIT 20;
```

```sql
-- Description: Retain only those centuries made for the team that eventually LOST the match.
SELECT 
       c.player_id,
       c."match_id",
       c.total_runs
FROM  (
        SELECT 
               bb."striker"          AS player_id,
               bs."match_id",
               bb."team_batting"     AS team_id,
               SUM(bs."runs_scored") AS total_runs
        FROM   "batsman_scored" AS bs
        JOIN   "ball_by_ball"   AS bb
          ON   bs."match_id"   = bb."match_id"
         AND   bs."over_id"    = bb."over_id"
         AND   bs."ball_id"    = bb."ball_id"
         AND   bs."innings_no" = bb."innings_no"
        GROUP BY bs."match_id", bb."striker", bb."team_batting"
        HAVING SUM(bs."runs_scored") >= 100
      ) AS c
JOIN   "match" AS m
  ON   c."match_id" = m."match_id"
WHERE  c.team_id <> m."match_winner"
ORDER BY c.total_runs DESC
LIMIT 20;
```

```sql
-- Description: Final answer – unique names of players who hit ≥100 but were on the losing side.
SELECT DISTINCT p."player_name"
FROM   "player" AS p
JOIN  (
        SELECT 
               c.player_id
        FROM  (
                SELECT 
                       bb."striker"          AS player_id,
                       bs."match_id",
                       bb."team_batting"     AS team_id,
                       SUM(bs."runs_scored") AS total_runs
                FROM   "batsman_scored" AS bs
                JOIN   "ball_by_ball"   AS bb
                  ON   bs."match_id"   = bb."match_id"
                 AND   bs."over_id"    = bb."over_id"
                 AND   bs."ball_id"    = bb."ball_id"
                 AND   bs."innings_no" = bb."innings_no"
                GROUP BY bs."match_id", bb."striker", bb."team_batting"
                HAVING SUM(bs."runs_scored") >= 100
              ) AS c
        JOIN   "match" AS m
          ON   c."match_id" = m."match_id"
        WHERE  c.team_id <> m."match_winner"
      ) AS losers_century
  ON  p."player_id" = losers_century.player_id;
```
