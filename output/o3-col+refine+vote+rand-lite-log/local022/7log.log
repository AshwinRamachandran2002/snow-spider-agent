Query:
--Description: Identify which team lost each match (team_1 or team_2 different from match_winner).
SELECT m.match_id,
       CASE 
            WHEN m.team_1 = m.match_winner THEN m.team_2
            WHEN m.team_2 = m.match_winner THEN m.team_1
       END AS losing_team_id
FROM match AS m
WHERE m.match_winner IS NOT NULL
LIMIT 20;
