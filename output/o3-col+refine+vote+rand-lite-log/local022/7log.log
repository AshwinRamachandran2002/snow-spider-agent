```sql
--Description: Inspect a few rows from batsman_scored to see how individual run events are stored.
SELECT * 
FROM batsman_scored 
LIMIT 20;
```

```sql
--Description: Inspect corresponding ball_by_ball rows (contains striker id) to understand how to link a run event to the batsman.
SELECT bb.match_id,
       bb.over_id,
       bb.ball_id,
       bb.striker,
       bs.runs_scored
FROM ball_by_ball AS bb
JOIN batsman_scored AS bs
  ON bb.match_id = bs.match_id
 AND bb.over_id  = bs.over_id
 AND bb.ball_id  = bs.ball_id
 AND bb.innings_no = bs.innings_no
LIMIT 20;
```

```sql
--Description: Aggregate total runs scored by every batsman in every match.
SELECT bb.match_id,
       bb.striker  AS player_id,
       SUM(bs.runs_scored) AS total_runs
FROM ball_by_ball AS bb
JOIN batsman_scored AS bs
  ON bb.match_id = bs.match_id
 AND bb.over_id  = bs.over_id
 AND bb.ball_id  = bs.ball_id
 AND bb.innings_no = bs.innings_no
GROUP BY bb.match_id,
         bb.striker
LIMIT 20;
```

```sql
--Description: Keep only instances where a batsman scored at least 100 runs in a match.
SELECT bb.match_id,
       bb.striker  AS player_id,
       SUM(bs.runs_scored) AS total_runs
FROM ball_by_ball AS bb
JOIN batsman_scored AS bs
  ON bb.match_id = bs.match_id
 AND bb.over_id  = bs.over_id
 AND bb.ball_id  = bs.ball_id
 AND bb.innings_no = bs.innings_no
GROUP BY bb.match_id,
         bb.striker
HAVING SUM(bs.runs_scored) >= 100
LIMIT 20;
```

```sql
--Description: Attach player and team information for those 100-plus scores.
SELECT r.match_id,
       r.player_id,
       p.player_name,
       pm.team_id
FROM (
        SELECT bb.match_id,
               bb.striker AS player_id,
               SUM(bs.runs_scored) AS total_runs
        FROM ball_by_ball AS bb
        JOIN batsman_scored AS bs
          ON bb.match_id = bs.match_id
         AND bb.over_id  = bs.over_id
         AND bb.ball_id  = bs.ball_id
         AND bb.innings_no = bs.innings_no
        GROUP BY bb.match_id,
                 bb.striker
        HAVING SUM(bs.runs_scored) >= 100
     ) AS r
JOIN player_match AS pm
  ON r.match_id = pm.match_id
 AND r.player_id = pm.player_id
JOIN player AS p
  ON r.player_id = p.player_id
LIMIT 20;
```

```sql
--Description: Identify which team lost each match (team_1 or team_2 different from match_winner).
SELECT m.match_id,
       CASE 
            WHEN m.team_1 = m.match_winner THEN m.team_2
            WHEN m.team_2 = m.match_winner THEN m.team_1
       END AS losing_team_id
FROM match AS m
WHERE m.match_winner IS NOT NULL
LIMIT 20;
```

```sql
--Description: Final answer – players who made 100+ while playing for the losing side.
SELECT DISTINCT p.player_name
FROM (
        SELECT bb.match_id,
               bb.striker AS player_id,
               SUM(bs.runs_scored) AS total_runs
        FROM ball_by_ball AS bb
        JOIN batsman_scored AS bs
          ON bb.match_id = bs.match_id
         AND bb.over_id  = bs.over_id
         AND bb.ball_id  = bs.ball_id
         AND bb.innings_no = bs.innings_no
        GROUP BY bb.match_id,
                 bb.striker
        HAVING SUM(bs.runs_scored) >= 100
     ) AS r
JOIN player_match AS pm
  ON r.match_id = pm.match_id
 AND r.player_id = pm.player_id
JOIN match AS m
  ON r.match_id = m.match_id
JOIN player AS p
  ON r.player_id = p.player_id
WHERE pm.team_id <> m.match_winner            -- player’s team lost
  AND (pm.team_id = m.team_1 OR pm.team_id = m.team_2)
LIMIT 20;
```
