```sql
-- Description: Inspect matches to see winner / loser information.
SELECT 
       m.match_id,
       m.team_1,
       m.team_2,
       m.match_winner
FROM   match AS m
LIMIT 20;
```

```sql
-- Description: Look at a few deliveries together with the striker (batsman who faced the ball).
SELECT 
       b.match_id,
       b.over_id,
       b.ball_id,
       b.striker,
       b.team_batting,
       bs.runs_scored
FROM   ball_by_ball AS b
JOIN   batsman_scored AS bs
       ON  b.match_id = bs.match_id
       AND b.over_id  = bs.over_id
       AND b.ball_id  = bs.ball_id
LIMIT 20;
```

```sql
-- Description: Aggregate total runs scored by each batsman in each match.
SELECT 
       b.match_id,
       b.striker              AS player_id,
       SUM(bs.runs_scored)    AS total_runs
FROM   ball_by_ball AS b
JOIN   batsman_scored AS bs
       ON  b.match_id = bs.match_id
       AND b.over_id  = bs.over_id
       AND b.ball_id  = bs.ball_id
GROUP  BY b.match_id, b.striker
LIMIT 20;
```

```sql
-- Description: Add the batting team for each player-match run aggregate.
SELECT 
       b.match_id,
       b.striker              AS player_id,
       b.team_batting         AS team_id,
       SUM(bs.runs_scored)    AS total_runs
FROM   ball_by_ball AS b
JOIN   batsman_scored AS bs
       ON  b.match_id = bs.match_id
       AND b.over_id  = bs.over_id
       AND b.ball_id  = bs.ball_id
GROUP  BY b.match_id, b.striker, b.team_batting
LIMIT 20;
```

```sql
-- Description: Keep only those player-match rows where the batsman made 100 or more.
SELECT 
       agg.match_id,
       agg.player_id,
       agg.team_id,
       agg.total_runs
FROM (
       SELECT b.match_id,
              b.striker      AS player_id,
              b.team_batting AS team_id,
              SUM(bs.runs_scored) AS total_runs
       FROM   ball_by_ball AS b
       JOIN   batsman_scored AS bs
              ON  b.match_id = bs.match_id
              AND b.over_id  = bs.over_id
              AND b.ball_id  = bs.ball_id
       GROUP  BY b.match_id, b.striker, b.team_batting
     ) AS agg
WHERE  agg.total_runs >= 100
LIMIT 20;
```

```sql
-- Description: Determine for every match the team that lost (team_1 or team_2 that is not the match_winner).
SELECT 
       m.match_id,
       CASE
           WHEN m.team_1 = m.match_winner THEN m.team_2
           ELSE m.team_1
       END AS loser_team_id
FROM   match AS m
WHERE  m.match_winner IS NOT NULL
LIMIT 20;
```

```sql
-- Description: Join the 100+ run scorers with the loser team list to retain only instances where they batted for the losing side.
SELECT 
       s.match_id,
       s.player_id,
       s.team_id,
       s.total_runs
FROM (
       SELECT b.match_id,
              b.striker      AS player_id,
              b.team_batting AS team_id,
              SUM(bs.runs_scored) AS total_runs
       FROM   ball_by_ball AS b
       JOIN   batsman_scored AS bs
              ON  b.match_id = bs.match_id
              AND b.over_id  = bs.over_id
              AND b.ball_id  = bs.ball_id
       GROUP  BY b.match_id, b.striker, b.team_batting
       HAVING SUM(bs.runs_scored) >= 100
     ) AS s
JOIN (
       SELECT m.match_id,
              CASE
                  WHEN m.team_1 = m.match_winner THEN m.team_2
                  ELSE m.team_1
              END AS loser_team_id
       FROM   match AS m
       WHERE  m.match_winner IS NOT NULL
     ) AS l
     ON  s.match_id = l.match_id
     AND s.team_id  = l.loser_team_id
LIMIT 20;
```

```sql
-- Description: Bring in player names for the qualifying records.
SELECT 
       p.player_name,
       q.match_id,
       q.total_runs
FROM (
       SELECT 
              s.match_id,
              s.player_id,
              s.total_runs
       FROM (
              SELECT b.match_id,
                     b.striker      AS player_id,
                     b.team_batting AS team_id,
                     SUM(bs.runs_scored) AS total_runs
              FROM   ball_by_ball AS b
              JOIN   batsman_scored AS bs
                     ON  b.match_id = bs.match_id
                     AND b.over_id  = bs.over_id
                     AND b.ball_id  = bs.ball_id
              GROUP  BY b.match_id, b.striker, b.team_batting
              HAVING SUM(bs.runs_scored) >= 100
            ) AS s
       JOIN (
              SELECT m.match_id,
                     CASE
                         WHEN m.team_1 = m.match_winner THEN m.team_2
                         ELSE m.team_1
                     END AS loser_team_id
              FROM   match AS m
              WHERE  m.match_winner IS NOT NULL
            ) AS l
            ON  s.match_id = l.match_id
            AND s.team_id  = l.loser_team_id
     ) AS q
JOIN   player AS p
       ON p.player_id = q.player_id
LIMIT 20;
```

```sql
-- Description: Final answer – distinct names of players who scored ≥100 runs in a match while playing for the team that lost that match.
SELECT DISTINCT
       p.player_name
FROM   player            AS p
JOIN (
       SELECT 
              s.match_id,
              s.player_id,
              s.team_id,
              s.total_runs
       FROM (
              SELECT b.match_id,
                     b.striker      AS player_id,
                     b.team_batting AS team_id,
                     SUM(bs.runs_scored) AS total_runs
              FROM   ball_by_ball AS b
              JOIN   batsman_scored AS bs
                     ON  b.match_id = bs.match_id
                     AND b.over_id  = bs.over_id
                     AND b.ball_id  = bs.ball_id
              GROUP  BY b.match_id, b.striker, b.team_batting
              HAVING SUM(bs.runs_scored) >= 100
            ) AS s
       JOIN (
              SELECT m.match_id,
                     CASE
                         WHEN m.team_1 = m.match_winner THEN m.team_2
                         ELSE m.team_1
                     END AS loser_team_id
              FROM   match AS m
              WHERE  m.match_winner IS NOT NULL
            ) AS l
            ON  s.match_id = l.match_id
            AND s.team_id  = l.loser_team_id
     ) AS q
       ON p.player_id = q.player_id;
```

```sql
-- Description: Same final answer but showing the exact match, losing team and runs for additional verification.
SELECT 
       p.player_name,
       t.name           AS losing_team,
       q.match_id,
       q.total_runs
FROM (
       SELECT 
              s.match_id,
              s.player_id,
              s.team_id,
              s.total_runs
       FROM (
              SELECT b.match_id,
                     b.striker      AS player_id,
                     b.team_batting AS team_id,
                     SUM(bs.runs_scored) AS total_runs
              FROM   ball_by_ball AS b
              JOIN   batsman_scored AS bs
                     ON  b.match_id = bs.match_id
                     AND b.over_id  = bs.over_id
                     AND b.ball_id  = bs.ball_id
              GROUP  BY b.match_id, b.striker, b.team_batting
              HAVING SUM(bs.runs_scored) >= 100
            ) AS s
       JOIN (
              SELECT m.match_id,
                     CASE
                         WHEN m.team_1 = m.match_winner THEN m.team_2
                         ELSE m.team_1
                     END AS loser_team_id
              FROM   match AS m
              WHERE  m.match_winner IS NOT NULL
            ) AS l
            ON  s.match_id = l.match_id
            AND s.team_id  = l.loser_team_id
     ) AS q
JOIN   player AS p
       ON p.player_id = q.player_id
JOIN   team   AS t
       ON t.team_id   = q.team_id
LIMIT 20;
```
