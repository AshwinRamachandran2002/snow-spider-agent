```sql
--Description: 1) Check a few players’ basic details.
SELECT DISTINCT * 
FROM player 
LIMIT 20;
```

```sql
--Description: 2) Have a quick look at matches – who won and who lost.
SELECT DISTINCT match_id,
       team_1,
       team_2,
       match_winner
FROM match
LIMIT 20;
```

```sql
--Description: 3) Inspect player-to-team mapping for a match.
SELECT DISTINCT match_id,
       player_id,
       team_id
FROM player_match
LIMIT 20;
```

```sql
--Description: 4) View one ball’s information together with the runs scored on that ball.
SELECT DISTINCT b.match_id,
       b.over_id,
       b.ball_id,
       b.striker,
       ba.runs_scored
FROM ball_by_ball AS b
JOIN batsman_scored AS ba
  ON  b.match_id  = ba.match_id
  AND b.over_id   = ba.over_id
  AND b.ball_id   = ba.ball_id
  AND b.innings_no= ba.innings_no
LIMIT 20;
```

```sql
--Description: 5) Aggregate every player’s total runs in each match.
SELECT DISTINCT b.match_id,
       b.striker           AS player_id,
       SUM(ba.runs_scored) AS total_runs
FROM ball_by_ball   AS b
JOIN batsman_scored AS ba
  ON  b.match_id  = ba.match_id
  AND b.over_id   = ba.over_id
  AND b.ball_id   = ba.ball_id
  AND b.innings_no= ba.innings_no
GROUP BY b.match_id, b.striker
LIMIT 20;
```

```sql
--Description: 6) Keep only those innings where the batter scored 100 or more.
SELECT DISTINCT b.match_id,
       b.striker           AS player_id,
       SUM(ba.runs_scored) AS total_runs
FROM ball_by_ball   AS b
JOIN batsman_scored AS ba
  ON  b.match_id  = ba.match_id
  AND b.over_id   = ba.over_id
  AND b.ball_id   = ba.ball_id
  AND b.innings_no= ba.innings_no
GROUP BY b.match_id, b.striker
HAVING SUM(ba.runs_scored) >= 100
LIMIT 20;
```

```sql
--Description: 7) Attach the side (team_id) for which each 100+ scorer played.
SELECT DISTINCT r.match_id,
       r.player_id,
       r.total_runs,
       pm.team_id
FROM (
       SELECT   b.match_id,
                b.striker AS player_id,
                SUM(ba.runs_scored) AS total_runs
       FROM ball_by_ball   AS b
       JOIN batsman_scored AS ba
         ON  b.match_id  = ba.match_id
         AND b.over_id   = ba.over_id
         AND b.ball_id   = ba.ball_id
         AND b.innings_no= ba.innings_no
       GROUP BY b.match_id, b.striker
       HAVING SUM(ba.runs_scored) >= 100
     ) AS r
JOIN player_match AS pm
  ON  r.match_id = pm.match_id
 AND r.player_id = pm.player_id
LIMIT 20;
```

```sql
--Description: 8) Mark whether the player’s team won or lost that match.
SELECT DISTINCT t.match_id,
       t.player_id,
       t.total_runs,
       t.team_id,
       m.match_winner,
       CASE 
            WHEN t.team_id = m.match_winner THEN 'Won'
            ELSE 'Lost'
       END AS result_for_team
FROM (
       SELECT   b.match_id,
                b.striker AS player_id,
                SUM(ba.runs_scored) AS total_runs,
                pm.team_id
       FROM ball_by_ball   AS b
       JOIN batsman_scored AS ba
         ON  b.match_id  = ba.match_id
         AND b.over_id   = ba.over_id
         AND b.ball_id   = ba.ball_id
         AND b.innings_no= ba.innings_no
       JOIN player_match  AS pm
         ON  b.match_id = pm.match_id
        AND b.striker   = pm.player_id
       GROUP BY b.match_id, b.striker
       HAVING SUM(ba.runs_scored) >= 100
     ) AS t
JOIN match AS m
  ON t.match_id = m.match_id
LIMIT 20;
```

```sql
--Description: 9) Finally, list the names of players who scored ≥100 while their side still lost.
SELECT DISTINCT p.player_name
FROM (
       SELECT   b.match_id,
                b.striker AS player_id,
                pm.team_id
       FROM ball_by_ball   AS b
       JOIN batsman_scored AS ba
         ON  b.match_id  = ba.match_id
         AND b.over_id   = ba.over_id
         AND b.ball_id   = ba.ball_id
         AND b.innings_no= ba.innings_no
       JOIN player_match  AS pm
         ON  b.match_id = pm.match_id
        AND b.striker   = pm.player_id
       GROUP BY b.match_id, b.striker, pm.team_id
       HAVING SUM(ba.runs_scored) >= 100
     ) AS s
JOIN match  AS m ON s.match_id = m.match_id
JOIN player AS p ON s.player_id = p.player_id
WHERE s.team_id <> m.match_winner;
```
