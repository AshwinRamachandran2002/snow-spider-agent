```sql
-- Description: Peek into the batsman_scored table to see how runs are stored for every ball.
SELECT * 
FROM batsman_scored 
LIMIT 20;
```

```sql
-- Description: Join batsman_scored with ball_by_ball to discover which player (striker) made those runs.
SELECT bb.match_id,
       bb.striker      AS player_id,
       bs.over_id,
       bs.ball_id,
       bs.runs_scored
FROM batsman_scored AS bs
JOIN ball_by_ball  AS bb
  ON  bb.match_id   = bs.match_id
 AND bb.over_id    = bs.over_id
 AND bb.ball_id    = bs.ball_id
 AND bb.innings_no = bs.innings_no
LIMIT 20;
```

```sql
-- Description: Aggregate the previous join to compute total runs each player scored in every match.
SELECT bb.match_id,
       bb.striker            AS player_id,
       SUM(bs.runs_scored)   AS total_runs
FROM batsman_scored AS bs
JOIN ball_by_ball  AS bb
  ON  bb.match_id   = bs.match_id
 AND bb.over_id    = bs.over_id
 AND bb.ball_id    = bs.ball_id
 AND bb.innings_no = bs.innings_no
GROUP BY bb.match_id, bb.striker
LIMIT 20;
```

```sql
-- Description: Bring in the player's name to make the result more readable.
SELECT p.player_name,
       runs_per_match.match_id,
       runs_per_match.total_runs
FROM (
        SELECT bb.match_id,
               bb.striker          AS player_id,
               SUM(bs.runs_scored) AS total_runs
        FROM batsman_scored AS bs
        JOIN ball_by_ball  AS bb
          ON  bb.match_id   = bs.match_id
         AND bb.over_id    = bs.over_id
         AND bb.ball_id    = bs.ball_id
         AND bb.innings_no = bs.innings_no
        GROUP BY bb.match_id, bb.striker
     ) AS runs_per_match
JOIN player AS p
  ON p.player_id = runs_per_match.player_id
LIMIT 20;
```

```sql
-- Description: Check which teams won each match to know the losing sides later.
SELECT match_id,
       match_winner
FROM match
WHERE match_winner IS NOT NULL
LIMIT 20;
```

```sql
-- Description: Observe how player_match links a player to the team he represented in a specific match.
SELECT *
FROM player_match
LIMIT 20;
```

```sql
-- Description: Combine everything up to this point, keeping only scores of at least 100.
SELECT p.player_name,
       rpm.match_id,
       pm.team_id              AS players_team,
       m.match_winner,
       rpm.total_runs
FROM (
        SELECT bb.match_id,
               bb.striker          AS player_id,
               SUM(bs.runs_scored) AS total_runs
        FROM batsman_scored AS bs
        JOIN ball_by_ball  AS bb
          ON  bb.match_id   = bs.match_id
         AND bb.over_id    = bs.over_id
         AND bb.ball_id    = bs.ball_id
         AND bb.innings_no = bs.innings_no
        GROUP BY bb.match_id, bb.striker
     ) AS rpm                               -- runs per match
JOIN player_match AS pm
  ON  pm.match_id  = rpm.match_id
 AND pm.player_id = rpm.player_id
JOIN match AS m
  ON m.match_id = rpm.match_id
JOIN player AS p
  ON p.player_id = rpm.player_id
WHERE rpm.total_runs >= 100
LIMIT 20;
```

```sql
-- Description (FINAL ANSWER): Retrieve DISTINCT names of players who scored 100-plus while playing for the team that LOST the match.
SELECT DISTINCT
       p.player_name
FROM (
        SELECT bb.match_id,
               bb.striker          AS player_id,
               SUM(bs.runs_scored) AS total_runs
        FROM batsman_scored AS bs
        JOIN ball_by_ball  AS bb
          ON  bb.match_id   = bs.match_id
         AND bb.over_id    = bs.over_id
         AND bb.ball_id    = bs.ball_id
         AND bb.innings_no = bs.innings_no
        GROUP BY bb.match_id, bb.striker
        HAVING SUM(bs.runs_scored) >= 100
     ) AS rpm
JOIN player_match AS pm
  ON  pm.match_id  = rpm.match_id
 AND pm.player_id = rpm.player_id          -- team the player represented
JOIN match AS m
  ON m.match_id = rpm.match_id
JOIN player AS p
  ON p.player_id = rpm.player_id
WHERE pm.team_id <> m.match_winner         -- player’s team lost
  AND m.match_winner IS NOT NULL
LIMIT 20;
```
