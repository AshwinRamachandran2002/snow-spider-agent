```sql
-- Description: Preview batsman runs event-wise (batsman_scored keeps the runs credited to the striker).
SELECT * 
FROM batsman_scored 
LIMIT 20;
```

```sql
-- Description: Bring in striker information so that every scoring event is tied to a player_id.
SELECT b.match_id, b.over_id, b.ball_id, bb.striker AS player_id, b.runs_scored
FROM batsman_scored  AS b
JOIN ball_by_ball    AS bb
  ON b.match_id   = bb.match_id
 AND b.over_id    = bb.over_id
 AND b.ball_id    = bb.ball_id
 AND b.innings_no = bb.innings_no
LIMIT 20;
```

```sql
-- Description: Aggregate total runs scored by each player in every match.
SELECT bb.striker   AS player_id,
       b.match_id,
       SUM(b.runs_scored) AS total_runs
FROM batsman_scored AS b
JOIN ball_by_ball   AS bb
  ON b.match_id   = bb.match_id
 AND b.over_id    = bb.over_id
 AND b.ball_id    = bb.ball_id
 AND b.innings_no = bb.innings_no
GROUP BY b.match_id, bb.striker
LIMIT 20;
```

```sql
-- Description: Filter only those (match_id, player_id) pairs where the player made 100+ runs (a century).
SELECT bb.striker   AS player_id,
       b.match_id,
       SUM(b.runs_scored) AS total_runs
FROM batsman_scored AS b
JOIN ball_by_ball   AS bb
  ON b.match_id   = bb.match_id
 AND b.over_id    = bb.over_id
 AND b.ball_id    = bb.ball_id
 AND b.innings_no = bb.innings_no
GROUP BY b.match_id, bb.striker
HAVING SUM(b.runs_scored) >= 100
LIMIT 20;
```

```sql
-- Description: Look at match table to see who actually won each match.
SELECT match_id, match_winner 
FROM match
LIMIT 20;
```

```sql
-- Description: Verify how a player is linked to a team in a given match (from player_match).
SELECT match_id, player_id, team_id
FROM player_match
LIMIT 20;
```

```sql
-- Description: Combine the century list with player_match and match tables to decide whether the century-maker’s team lost.
SELECT c.match_id,
       c.player_id,
       pm.team_id           AS players_team,
       m.match_winner       AS winner_team,
       c.total_runs
FROM (
     SELECT bb.striker AS player_id,
            b.match_id,
            SUM(b.runs_scored) AS total_runs
     FROM batsman_scored AS b
     JOIN ball_by_ball   AS bb
       ON b.match_id   = bb.match_id
      AND b.over_id    = bb.over_id
      AND b.ball_id    = bb.ball_id
      AND b.innings_no = bb.innings_no
     GROUP BY b.match_id, bb.striker
     HAVING SUM(b.runs_scored) >= 100
) AS c
JOIN player_match AS pm  ON pm.match_id = c.match_id AND pm.player_id = c.player_id
JOIN match        AS m   ON m.match_id  = c.match_id
WHERE pm.team_id <> m.match_winner
LIMIT 20;
```

```sql
-- Description: Final answer – list distinct player names who scored a century for the side that eventually lost the match.
SELECT DISTINCT p.player_name
FROM (
     SELECT bb.striker AS player_id,
            b.match_id,
            SUM(b.runs_scored) AS total_runs
     FROM batsman_scored AS b
     JOIN ball_by_ball   AS bb
       ON b.match_id   = bb.match_id
      AND b.over_id    = bb.over_id
      AND b.ball_id    = bb.ball_id
      AND b.innings_no = bb.innings_no
     GROUP BY b.match_id, bb.striker
     HAVING SUM(b.runs_scored) >= 100
) AS c
JOIN player_match AS pm ON pm.match_id = c.match_id AND pm.player_id = c.player_id
JOIN match        AS m  ON m.match_id  = c.match_id
JOIN player       AS p  ON p.player_id = c.player_id
WHERE pm.team_id <> m.match_winner;
```
