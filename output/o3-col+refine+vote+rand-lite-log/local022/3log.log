```sql
-- Description: Inspect a few rows from batsman_scored to understand the runs information recorded for each delivery
SELECT * 
FROM batsman_scored 
LIMIT 20;
```

```sql
-- Description: Inspect the corresponding deliveries in ball_by_ball to see which player (striker) made those runs
SELECT b.match_id, b.over_id, b.ball_id, b.striker, s.runs_scored
FROM ball_by_ball AS b
JOIN batsman_scored AS s
  ON b.match_id = s.match_id 
 AND b.over_id  = s.over_id
 AND b.ball_id  = s.ball_id
 AND b.innings_no = s.innings_no
LIMIT 20;
```

```sql
-- Description: Aggregate total runs scored by every player in every match
SELECT 
    b.match_id,
    b.striker          AS player_id,
    SUM(s.runs_scored) AS total_runs
FROM ball_by_ball AS b
JOIN batsman_scored AS s
  ON b.match_id = s.match_id 
 AND b.over_id  = s.over_id
 AND b.ball_id  = s.ball_id
 AND b.innings_no = s.innings_no
GROUP BY b.match_id, b.striker
LIMIT 20;
```

```sql
-- Description: Keep only those (match, player) pairs where the player scored at least 100 runs
SELECT 
    agg.match_id,
    agg.player_id,
    agg.total_runs
FROM (
    SELECT 
        b.match_id,
        b.striker AS player_id,
        SUM(s.runs_scored) AS total_runs
    FROM ball_by_ball AS b
    JOIN batsman_scored AS s
      ON b.match_id = s.match_id 
     AND b.over_id  = s.over_id
     AND b.ball_id  = s.ball_id
     AND b.innings_no = s.innings_no
    GROUP BY b.match_id, b.striker
) AS agg
WHERE agg.total_runs >= 100
LIMIT 20;
```

```sql
-- Description: Attach player names to those 100-plus scores
SELECT 
    p.player_name,
    x.match_id,
    x.total_runs
FROM (
    SELECT 
        b.match_id,
        b.striker AS player_id,
        SUM(s.runs_scored) AS total_runs
    FROM ball_by_ball AS b
    JOIN batsman_scored AS s
      ON b.match_id = s.match_id 
     AND b.over_id  = s.over_id
     AND b.ball_id  = s.ball_id
     AND b.innings_no = s.innings_no
    GROUP BY b.match_id, b.striker
) AS x
JOIN player AS p
  ON p.player_id = x.player_id
WHERE x.total_runs >= 100
LIMIT 20;
```

```sql
-- Description: For every (match, player) with ≥100 runs, find the team that player represented in that match
SELECT 
    x.match_id,
    x.player_id,
    pm.team_id,
    x.total_runs
FROM (
    SELECT 
        b.match_id,
        b.striker AS player_id,
        SUM(s.runs_scored) AS total_runs
    FROM ball_by_ball AS b
    JOIN batsman_scored AS s
      ON b.match_id = s.match_id 
     AND b.over_id  = s.over_id
     AND b.ball_id  = s.ball_id
     AND b.innings_no = s.innings_no
    GROUP BY b.match_id, b.striker
) AS x
JOIN player_match AS pm
  ON pm.match_id = x.match_id
 AND pm.player_id = x.player_id
WHERE x.total_runs >= 100
LIMIT 20;
```

```sql
-- Description: Identify which of those teams lost their matches (team_id ≠ match_winner)
SELECT 
    x.player_id,
    x.match_id,
    pm.team_id,
    m.match_winner,
    x.total_runs
FROM (
    SELECT 
        b.match_id,
        b.striker AS player_id,
        SUM(s.runs_scored) AS total_runs
    FROM ball_by_ball AS b
    JOIN batsman_scored AS s
      ON b.match_id = s.match_id 
     AND b.over_id  = s.over_id
     AND b.ball_id  = s.ball_id
     AND b.innings_no = s.innings_no
    GROUP BY b.match_id, b.striker
) AS x
JOIN player_match AS pm
  ON pm.match_id = x.match_id
 AND pm.player_id = x.player_id
JOIN match AS m
  ON m.match_id = x.match_id
WHERE x.total_runs >= 100
  AND pm.team_id <> m.match_winner
LIMIT 20;
```

```sql
-- Description: FINAL – list distinct player names who scored ≥100 runs for the losing side
SELECT DISTINCT 
    p.player_name
FROM (
    SELECT 
        b.match_id,
        b.striker AS player_id,
        SUM(s.runs_scored) AS total_runs
    FROM ball_by_ball AS b
    JOIN batsman_scored AS s
      ON b.match_id = s.match_id
     AND b.over_id  = s.over_id
     AND b.ball_id  = s.ball_id
     AND b.innings_no = s.innings_no
    GROUP BY b.match_id, b.striker
) AS x
JOIN player_match AS pm
  ON pm.match_id = x.match_id
 AND pm.player_id = x.player_id
JOIN match AS m
  ON m.match_id = x.match_id
JOIN player AS p
  ON p.player_id = x.player_id
WHERE x.total_runs >= 100
  AND pm.team_id <> m.match_winner
LIMIT 20;
```
