LIMIT 20;
```

```sql
--Description: Look at some ball-by-ball rows to see who the striker and batting team are
SELECT DISTINCT "match_id",
       "over_id",
       "ball_id",
       "innings_no",
       "team_batting",
       "striker"
FROM   "ball_by_ball"
LIMIT 20;
```

```sql
--Description: Join one delivery from ball_by_ball with batsman_scored to confirm runs linkage
SELECT DISTINCT bb."match_id",
       bb."over_id",
       bb."ball_id",
       bb."striker",
       bb."team_batting",
       bs."runs_scored"
FROM   "ball_by_ball" AS bb
JOIN   "batsman_scored" AS bs
       ON  bb."match_id" = bs."match_id"
       AND bb."over_id"  = bs."over_id"
       AND bb."ball_id"  = bs."ball_id"
       AND bb."innings_no" = bs."innings_no"
LIMIT 20;
```

```sql
--Description: Aggregate total runs each player makes in every match
SELECT   bb."striker"          AS "player_id",
         bb."match_id",
         bb."team_batting"     AS "team_id",
         SUM(bs."runs_scored") AS "total_runs"
FROM     "ball_by_ball"  AS bb
JOIN     "batsman_scored" AS bs
       ON  bb."match_id"     = bs."match_id"
       AND bb."over_id"      = bs."over_id"
       AND bb."ball_id"      = bs."ball_id"
       AND bb."innings_no"   = bs."innings_no"
GROUP BY bb."match_id",
         bb."striker"
LIMIT 20;
```

```sql
--Description: Keep only those innings where the player scored at least 100
SELECT *
FROM (
        SELECT   bb."striker"        AS "player_id",
                 bb."match_id",
                 bb."team_batting"   AS "team_id",
                 SUM(bs."runs_scored") AS "total_runs"
        FROM     "ball_by_ball"  AS bb
        JOIN     "batsman_scored" AS bs
               ON  bb."match_id"     = bs."match_id"
               AND bb."over_id"      = bs."over_id"
               AND bb."ball_id"      = bs."ball_id"
               AND bb."innings_no"   = bs."innings_no"
        GROUP BY bb."match_id",
                 bb."striker"
) AS t
WHERE  t."total_runs" >= 100
LIMIT 20;
```

```sql
--Description: Link those 100+ scores to the match table to determine if the player’s team lost
SELECT  t."player_id",
        t."match_id",
        t."team_id"       AS "player_team",
        m."match_winner",
        t."total_runs"
FROM   (
         SELECT   bb."striker"        AS "player_id",
                  bb."match_id",
                  bb."team_batting"   AS "team_id",
                  SUM(bs."runs_scored") AS "total_runs"
         FROM     "ball_by_ball"  AS bb
         JOIN     "batsman_scored" AS bs
                ON  bb."match_id"   = bs."match_id"
                AND bb."over_id"    = bs."over_id"
                AND bb."ball_id"    = bs."ball_id"
                AND bb."innings_no" = bs."innings_no"
         GROUP BY bb."match_id",
                  bb."striker"
         HAVING  SUM(bs."runs_scored") >= 100
       ) AS t
JOIN   "match" AS m
     ON m."match_id" = t."match_id"
WHERE  t."team_id" <> m."match_winner"
LIMIT 20;
```

```sql
--Description: Final list – player names who hit 100+ but still ended on the losing side
SELECT DISTINCT p."player_name"
FROM  (
        SELECT   bb."striker"        AS "player_id",
                 bb."match_id",
                 bb."team_batting"   AS "team_id",
                 SUM(bs."runs_scored") AS "total_runs"
        FROM     "ball_by_ball"  AS bb
        JOIN     "batsman_scored" AS bs
               ON  bb."match_id"   = bs."match_id"
               AND bb."over_id"    = bs."over_id"
               AND bb."ball_id"    = bs."ball_id"
               AND bb."innings_no" = bs."innings_no"
        GROUP BY bb."match_id",
                 bb."striker"
        HAVING  SUM(bs."runs_scored") >= 100
      ) AS big_scores
JOIN   "match"  AS m
     ON m."match_id" = big_scores."match_id"
WHERE  big_scores."team_id" <> m."match_winner"
JOIN   "player" AS p
     ON p."player_id" = big_scores."player_id"
LIMIT 20;
```

