```sql
--Description: We first calculate every batter’s total runs in each match by summing batsman_scored for the (match_id, striker) pair derived
--             from ball_by_ball.  Next, we retain only those pairs where this sum ≥ 100 (big_scores CTE).  We then join to the match table
--             to know the winning team and to the player table for the batter’s name.  Finally, we filter to keep rows where the batter’s
--             team_batting is different from match_winner, meaning the century came in a losing cause.  The DISTINCT ensures unique names.
SELECT DISTINCT p."player_name"
FROM (
        SELECT  bb."striker"      AS "player_id",
                bb."match_id",
                bb."team_batting" AS "team_id",
                SUM(bs."runs_scored") AS "total_runs"
        FROM    "ball_by_ball"  AS bb
        JOIN    "batsman_scored" AS bs
          ON  bb."match_id"   = bs."match_id"
         AND  bb."over_id"    = bs."over_id"
         AND  bb."ball_id"    = bs."ball_id"
         AND  bb."innings_no" = bs."innings_no"
        GROUP BY bb."match_id", bb."striker"
        HAVING SUM(bs."runs_scored") >= 100
     ) AS big_scores
JOIN "match"  AS m ON m."match_id"  = big_scores."match_id"
JOIN "player" AS p ON p."player_id" = big_scores."player_id"
WHERE big_scores."team_id" <> m."match_winner"
LIMIT 20;
```
