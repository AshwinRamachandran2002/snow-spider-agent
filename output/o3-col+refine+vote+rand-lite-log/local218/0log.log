```sql
--Description: Inspect the different season identifiers recorded in the Match table
SELECT DISTINCT "season"
FROM "Match"
LIMIT 20;
```

```sql
--Description: Look at a few rows to understand how goals are stored for the home- and away-side
SELECT "match_api_id",
       "season",
       "home_team_api_id",
       "away_team_api_id",
       "home_team_goal",
       "away_team_goal"
FROM "Match"
LIMIT 20;
```

```sql
--Description: List some distinct team_api_id values appearing as either a home or an away side
SELECT DISTINCT "home_team_api_id" AS team_api_id
FROM "Match"
UNION
SELECT DISTINCT "away_team_api_id"
FROM "Match"
LIMIT 20;
```

```sql
--Description: Compute total goals scored by each team within each season (first 20 rows)
SELECT sg."season",
       sg.team_api_id,
       SUM(sg.goals_scored) AS season_goals
FROM (
        /* collect goals when a club plays at home */
        SELECT "season",
               "home_team_api_id"  AS team_api_id,
               "home_team_goal"    AS goals_scored
        FROM "Match"
        UNION ALL
        /* collect goals when a club plays away */
        SELECT "season",
               "away_team_api_id",
               "away_team_goal"
        FROM "Match"
     ) AS sg
GROUP BY sg."season", sg.team_api_id
LIMIT 20;
```

```sql
--Description: For every club, find the highest (best) season-goal tally it ever achieved
SELECT team_api_id,
       MAX(season_goals) AS best_season_goals
FROM (
        SELECT sg."season",
               sg.team_api_id,
               SUM(sg.goals_scored) AS season_goals
        FROM (
                SELECT "season",
                       "home_team_api_id"  AS team_api_id,
                       "home_team_goal"    AS goals_scored
                FROM "Match"
                UNION ALL
                SELECT "season",
                       "away_team_api_id",
                       "away_team_goal"
                FROM "Match"
             ) AS sg
        GROUP BY sg."season", sg.team_api_id
     )
GROUP BY team_api_id
ORDER BY best_season_goals DESC
LIMIT 20;
```

```sql
--Description: Check how many distinct teams we have (needed for median logic)
SELECT COUNT(*) AS total_teams
FROM (
        SELECT DISTINCT "home_team_api_id" AS team_api_id
        FROM "Match"
        UNION
        SELECT DISTINCT "away_team_api_id"
        FROM "Match"
     );
```

```sql
--Description: Add an order position (row number) to every team’s best-season total to prepare for median
WITH best AS (
        SELECT team_api_id,
               MAX(season_goals) AS best_season_goals
        FROM (
                SELECT sg."season",
                       sg.team_api_id,
                       SUM(sg.goals_scored) AS season_goals
                FROM (
                        SELECT "season",
                               "home_team_api_id"  AS team_api_id,
                               "home_team_goal"    AS goals_scored
                        FROM "Match"
                        UNION ALL
                        SELECT "season",
                               "away_team_api_id",
                               "away_team_goal"
                        FROM "Match"
                     ) AS sg
                GROUP BY sg."season", sg.team_api_id
             )
        GROUP BY team_api_id
)
SELECT b.*,
       ROW_NUMBER() OVER (ORDER BY b.best_season_goals) AS rn,
       COUNT(*)  OVER ()                               AS cnt
FROM best AS b
LIMIT 20;
```

```sql
--Description: Final query – calculate the median of every club’s single best-season goal total
WITH season_goals AS (
        /* collect goals for each team/season */
        SELECT "season",
               "home_team_api_id" AS team_api_id,
               "home_team_goal"   AS g
        FROM "Match"
        UNION ALL
        SELECT "season",
               "away_team_api_id",
               "away_team_goal"
        FROM "Match"
), per_season AS (
        SELECT "season",
               team_api_id,
               SUM(g) AS season_goals
        FROM season_goals
        GROUP BY "season", team_api_id
), best_per_team AS (
        SELECT team_api_id,
               MAX(season_goals) AS best_season_goals
        FROM per_season
        GROUP BY team_api_id
), ordered AS (
        SELECT best_season_goals,
               ROW_NUMBER() OVER (ORDER BY best_season_goals) AS rn,
               COUNT(*)  OVER ()                              AS cnt
        FROM best_per_team
)
SELECT AVG(best_season_goals) AS median_best_season_goals
FROM ordered
WHERE rn IN ( (cnt + 1) / 2, (cnt + 2) / 2 );
```

These queries progress from exploring the raw data through to producing the requested statistic—the median of each club’s greatest single-season goal output.
