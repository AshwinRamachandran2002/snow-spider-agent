Query:
--Description: Compute total goals scored by each team within each season (first 20 rows)
SELECT sg."season",
       sg.team_api_id,
       SUM(sg.goals_scored) AS season_goals
FROM (
        /* collect goals when a club plays at home */
        SELECT "season",
               "home_team_api_id"  AS team_api_id,
               "home_team_goal"    AS goals_scored
        FROM "Match"
        UNION ALL
        /* collect goals when a club plays away */
        SELECT "season",
               "away_team_api_id",
               "away_team_goal"
        FROM "Match"
     ) AS sg
GROUP BY sg."season", sg.team_api_id
LIMIT 20;
