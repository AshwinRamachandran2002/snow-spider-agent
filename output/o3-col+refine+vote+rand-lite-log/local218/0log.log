Query:
--Description: Final query – calculate the median of every club’s single best-season goal total
WITH season_goals AS (
        /* collect goals for each team/season */
        SELECT "season",
               "home_team_api_id" AS team_api_id,
               "home_team_goal"   AS g
        FROM "Match"
        UNION ALL
        SELECT "season",
               "away_team_api_id",
               "away_team_goal"
        FROM "Match"
), per_season AS (
        SELECT "season",
               team_api_id,
               SUM(g) AS season_goals
        FROM season_goals
        GROUP BY "season", team_api_id
), best_per_team AS (
        SELECT team_api_id,
               MAX(season_goals) AS best_season_goals
        FROM per_season
        GROUP BY team_api_id
), ordered AS (
        SELECT best_season_goals,
               ROW_NUMBER() OVER (ORDER BY best_season_goals) AS rn,
               COUNT(*)  OVER ()                              AS cnt
        FROM best_per_team
)
SELECT AVG(best_season_goals) AS median_best_season_goals
FROM ordered
WHERE rn IN ( (cnt + 1) / 2, (cnt + 2) / 2 );
