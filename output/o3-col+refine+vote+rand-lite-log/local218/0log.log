Query:
--Description: For every club, find the highest (best) season-goal tally it ever achieved
SELECT team_api_id,
       MAX(season_goals) AS best_season_goals
FROM (
        SELECT sg."season",
               sg.team_api_id,
               SUM(sg.goals_scored) AS season_goals
        FROM (
                SELECT "season",
                       "home_team_api_id"  AS team_api_id,
                       "home_team_goal"    AS goals_scored
                FROM "Match"
                UNION ALL
                SELECT "season",
                       "away_team_api_id",
                       "away_team_goal"
                FROM "Match"
             ) AS sg
        GROUP BY sg."season", sg.team_api_id
     )
GROUP BY team_api_id
ORDER BY best_season_goals DESC
LIMIT 20;
