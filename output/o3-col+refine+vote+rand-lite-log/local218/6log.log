--Description: 8) Put the highest-season-goal values in order and assign row numbers
WITH best AS (
     /* identical CTE as in step-7 */
     WITH per_season AS (
          WITH home AS (
               SELECT "season",
                      "home_team_api_id" AS "team_id",
                      SUM("home_team_goal") AS "goals"
               FROM   "Match"
               GROUP  BY "season", "home_team_api_id"
          ),
          away AS (
               SELECT "season",
                      "away_team_api_id" AS "team_id",
