```sql
--Description: 1) Inspect the different season labels that exist in the Match table
SELECT DISTINCT "season"
FROM "Match"
LIMIT 20;
```

```sql
--Description: 2) Look at a few matches with the goals each side scored
SELECT "id",
       "season",
       "home_team_api_id"  AS "team_id",
       "home_team_goal"    AS "goals_scored",
       'home'              AS "side"
FROM   "Match"
UNION ALL
SELECT "id",
       "season",
       "away_team_api_id",
       "away_team_goal",
       'away'
FROM   "Match"
LIMIT 20;
```

```sql
--Description: 3) Aggregate goals that every team scored **at home** in each season
SELECT "season",
       "home_team_api_id"      AS "team_id",
       SUM("home_team_goal")   AS "home_goals"
FROM   "Match"
GROUP  BY "season", "home_team_api_id"
LIMIT 20;
```

```sql
--Description: 4) Aggregate goals that every team scored **away** in each season
SELECT "season",
       "away_team_api_id"     AS "team_id",
       SUM("away_team_goal")  AS "away_goals"
FROM   "Match"
GROUP  BY "season", "away_team_api_id"
LIMIT 20;
```

```sql
--Description: 5) Combine home & away tallies → total goals each team scored per season
WITH home AS (
     SELECT "season",
            "home_team_api_id"  AS "team_id",
            SUM("home_team_goal") AS "goals"
     FROM   "Match"
     GROUP  BY "season", "home_team_api_id"
),
away AS (
     SELECT "season",
            "away_team_api_id"  AS "team_id",
            SUM("away_team_goal") AS "goals"
     FROM   "Match"
     GROUP  BY "season", "away_team_api_id"
)
SELECT "season",
       "team_id",
       SUM("goals") AS "total_goals"
FROM   (
       SELECT * FROM home
       UNION ALL
       SELECT * FROM away
)
GROUP  BY "season", "team_id"
LIMIT 20;
```

```sql
--Description: 6) For every team, find the **highest** goal-scoring season
WITH per_season AS (
     /* query from step-5 without the LIMIT */
     WITH home AS (
          SELECT "season",
                 "home_team_api_id" AS "team_id",
                 SUM("home_team_goal") AS "goals"
          FROM   "Match"
          GROUP  BY "season", "home_team_api_id"
     ),
     away AS (
          SELECT "season",
                 "away_team_api_id" AS "team_id",
                 SUM("away_team_goal") AS "goals"
          FROM   "Match"
          GROUP  BY "season", "away_team_api_id"
     )
     SELECT "season",
            "team_id",
            SUM("goals") AS "total_goals"
     FROM   (
            SELECT * FROM home
            UNION ALL
            SELECT * FROM away
     )
     GROUP  BY "season", "team_id"
)
SELECT "team_id",
       MAX("total_goals") AS "highest_season_goals"
FROM   per_season
GROUP  BY "team_id"
LIMIT 20;
```

```sql
--Description: 7) Count how many teams we have (needed to locate the median position)
WITH best AS (
     /* step-6 without LIMIT */
     WITH per_season AS (
          WITH home AS (
               SELECT "season",
                      "home_team_api_id" AS "team_id",
                      SUM("home_team_goal") AS "goals"
               FROM   "Match"
               GROUP  BY "season", "home_team_api_id"
          ),
          away AS (
               SELECT "season",
                      "away_team_api_id" AS "team_id",
                      SUM("away_team_goal") AS "goals"
               FROM   "Match"
               GROUP  BY "season", "away_team_api_id"
          )
          SELECT "season",
                 "team_id",
                 SUM("goals") AS "total_goals"
          FROM   (
                 SELECT * FROM home
                 UNION ALL
                 SELECT * FROM away
          )
          GROUP  BY "season", "team_id"
     )
     SELECT "team_id",
            MAX("total_goals") AS "highest_season_goals"
     FROM   per_season
     GROUP  BY "team_id"
)
SELECT COUNT(*) AS "team_count"
FROM   best;
```

```sql
--Description: 8) Put the highest-season-goal values in order and assign row numbers
WITH best AS (
     /* identical CTE as in step-7 */
     WITH per_season AS (
          WITH home AS (
               SELECT "season",
                      "home_team_api_id" AS "team_id",
                      SUM("home_team_goal") AS "goals"
               FROM   "Match"
               GROUP  BY "season", "home_team_api_id"
          ),
          away AS (
               SELECT "season",
                      "away_team_api_id" AS "team_id",
                      SUM("away_team_goal") AS "goals"
               FROM   "Match"
               GROUP  BY "season", "away_team_api_id"
          )
          SELECT "season",
                 "team_id",
                 SUM("goals") AS "total_goals"
          FROM   (
                 SELECT * FROM home
                 UNION ALL
                 SELECT * FROM away
          )
          GROUP  BY "season", "team_id"
     )
     SELECT "team_id",
            MAX("total_goals") AS "highest_season_goals"
     FROM   per_season
     GROUP  BY "team_id"
),
ordered AS (
     SELECT "highest_season_goals",
            ROW_NUMBER() OVER (ORDER BY "highest_season_goals") AS "rn",
            COUNT(*)    OVER ()                                   AS "cnt"
     FROM   best
)
SELECT *
FROM   ordered
LIMIT 20;
```

```sql
--Description: 9) FINAL ANSWER – median of the highest season-goals scored by every team
WITH best AS (
     /* CTE that finds each team’s best season */
     WITH per_season AS (
          WITH home AS (
               SELECT "season",
                      "home_team_api_id" AS "team_id",
                      SUM("home_team_goal") AS "goals"
               FROM   "Match"
               GROUP  BY "season", "home_team_api_id"
          ),
          away AS (
               SELECT "season",
                      "away_team_api_id" AS "team_id",
                      SUM("away_team_goal") AS "goals"
               FROM   "Match"
               GROUP  BY "season", "away_team_api_id"
          )
          SELECT "season",
                 "team_id",
                 SUM("goals") AS "total_goals"
          FROM   (
                 SELECT * FROM home
                 UNION ALL
                 SELECT * FROM away
          )
          GROUP  BY "season", "team_id"
     )
     SELECT "team_id",
            MAX("total_goals") AS "highest_season_goals"
     FROM   per_season
     GROUP  BY "team_id"
),
ordered AS (
     SELECT "highest_season_goals",
            ROW_NUMBER() OVER (ORDER BY "highest_season_goals") AS "rn",
            COUNT(*)    OVER ()                                   AS "cnt"
     FROM   best
)
SELECT AVG("highest_season_goals") AS "median_highest_season_goals"
FROM   ordered
WHERE  "rn" IN ( ( "cnt" + 1) / 2,        -- middle row for odd count
                 ( "cnt" + 2) / 2 );      -- two middle rows for even count
```
