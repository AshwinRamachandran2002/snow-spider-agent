-- Description: 5) Compute total goals a team scored in a given season (home + away) – sample 20 rows
WITH team_season_goals AS (
    SELECT "season",
           "home_team_api_id" AS "team_api_id",
           SUM("home_team_goal") AS "season_goals"
    FROM "Match"
    GROUP BY "season", "home_team_api_id"

    UNION ALL

    SELECT "season",
           "away_team_api_id" AS "team_api_id",
           SUM("away_team_goal") AS "season_goals"
    FROM "Match"
    GROUP BY "season", "away_team_api_id"
)
