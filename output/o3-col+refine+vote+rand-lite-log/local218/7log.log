```sql
-- Description: 1) Take a look at the available seasons in the Match table
SELECT DISTINCT "season"
FROM "Match"
LIMIT 20;
```

```sql
-- Description: 2) Inspect a handful of matches with the goals scored by each side
SELECT "id",
       "season",
       "home_team_api_id",
       "away_team_api_id",
       "home_team_goal",
       "away_team_goal"
FROM "Match"
LIMIT 20;
```

```sql
-- Description: 3) Preview some teams and their names
SELECT DISTINCT "team_api_id",
       "team_long_name"
FROM "Team"
LIMIT 20;
```

```sql
-- Description: 4) How many matches are recorded for each season? (sample – first 20 rows)
SELECT "season",
       COUNT(*) AS "matches_in_season"
FROM "Match"
GROUP BY "season"
ORDER BY "season"
LIMIT 20;
```

```sql
-- Description: 5) Compute total goals a team scored in a given season (home + away) – sample 20 rows
WITH team_season_goals AS (
    SELECT "season",
           "home_team_api_id" AS "team_api_id",
           SUM("home_team_goal") AS "season_goals"
    FROM "Match"
    GROUP BY "season", "home_team_api_id"

    UNION ALL

    SELECT "season",
           "away_team_api_id" AS "team_api_id",
           SUM("away_team_goal") AS "season_goals"
    FROM "Match"
    GROUP BY "season", "away_team_api_id"
)
SELECT "season",
       "team_api_id",
       SUM("season_goals") AS "total_goals_in_season"
FROM team_season_goals
GROUP BY "season", "team_api_id"
LIMIT 20;
```

```sql
-- Description: 6) For every team, find the highest number of goals it scored in ANY single season
WITH team_season_goals AS (
    SELECT "season",
           "home_team_api_id" AS "team_api_id",
           "home_team_goal"  AS "goals"
    FROM "Match"

    UNION ALL

    SELECT "season",
           "away_team_api_id" AS "team_api_id",
           "away_team_goal"   AS "goals"
    FROM "Match"
), summed AS (
    SELECT "season",
           "team_api_id",
           SUM("goals") AS "season_goals"
    FROM team_season_goals
    GROUP BY "season", "team_api_id"
)
SELECT "team_api_id",
       MAX("season_goals") AS "highest_season_goals"
FROM summed
GROUP BY "team_api_id"
LIMIT 20;
```

```sql
-- Description: 7) Quick statistical feel: min / avg / max of those best-ever season tallies
WITH team_season_goals AS (
    SELECT "season",
           "home_team_api_id" AS "team_api_id",
           "home_team_goal"  AS "goals"
    FROM "Match"

    UNION ALL

    SELECT "season",
           "away_team_api_id" AS "team_api_id",
           "away_team_goal"   AS "goals"
    FROM "Match"
), summed AS (
    SELECT "season",
           "team_api_id",
           SUM("goals") AS "season_goals"
    FROM team_season_goals
    GROUP BY "season", "team_api_id"
), best AS (
    SELECT "team_api_id",
           MAX("season_goals") AS "highest_season_goals"
    FROM summed
    GROUP BY "team_api_id"
)
SELECT MIN("highest_season_goals") AS "min_best",
       AVG("highest_season_goals") AS "avg_best",
       MAX("highest_season_goals") AS "max_best",
       COUNT(*)                    AS "num_teams"
FROM best;
```

```sql
-- Description: 8) Order the best-ever tallies so we can eyeball the distribution (first 20)
WITH team_season_goals AS (
    SELECT "season",
           "home_team_api_id" AS "team_api_id",
           "home_team_goal"  AS "goals"
    FROM "Match"

    UNION ALL

    SELECT "season",
           "away_team_api_id" AS "team_api_id",
           "away_team_goal"   AS "goals"
    FROM "Match"
), summed AS (
    SELECT "season",
           "team_api_id",
           SUM("goals") AS "season_goals"
    FROM team_season_goals
    GROUP BY "season", "team_api_id"
), best AS (
    SELECT "team_api_id",
           MAX("season_goals") AS "highest_season_goals"
    FROM summed
    GROUP BY "team_api_id"
)
SELECT "team_api_id",
       "highest_season_goals"
FROM best
ORDER BY "highest_season_goals"
LIMIT 20;
```

```sql
-- Description: 9) Count how many teams share each distinct best-ever tally (first 20 rows)
WITH team_season_goals AS (
    SELECT "season",
           "home_team_api_id" AS "team_api_id",
           "home_team_goal"  AS "goals"
    FROM "Match"

    UNION ALL

    SELECT "season",
           "away_team_api_id" AS "team_api_id",
           "away_team_goal"   AS "goals"
    FROM "Match"
), summed AS (
    SELECT "season",
           "team_api_id",
           SUM("goals") AS "season_goals"
    FROM team_season_goals
    GROUP BY "season", "team_api_id"
), best AS (
    SELECT "team_api_id",
           MAX("season_goals") AS "highest_season_goals"
    FROM summed
    GROUP BY "team_api_id"
)
SELECT "highest_season_goals",
       COUNT(*) AS "teams_with_this_best"
FROM best
GROUP BY "highest_season_goals"
ORDER BY "highest_season_goals"
LIMIT 20;
```

```sql
-- Description: 10) FINAL ANSWER – median of every team’s best-ever season-goal total
WITH team_season_goals AS (
    SELECT "season",
           "home_team_api_id" AS "team_api_id",
           "home_team_goal"  AS "goals"
    FROM "Match"

    UNION ALL

    SELECT "season",
           "away_team_api_id" AS "team_api_id",
           "away_team_goal"   AS "goals"
    FROM "Match"
), summed AS (
    SELECT "season",
           "team_api_id",
           SUM("goals") AS "season_goals"
    FROM team_season_goals
    GROUP BY "season", "team_api_id"
), best AS (
    SELECT "team_api_id",
           MAX("season_goals") AS "highest_season_goals"
    FROM summed
    GROUP BY "team_api_id"
), ordered AS (
    SELECT "highest_season_goals",
           ROW_NUMBER() OVER (ORDER BY "highest_season_goals") AS "rn",
           COUNT(*)  OVER ()                                   AS "cnt"
    FROM best
)
SELECT AVG("highest_season_goals") AS "median_highest_season_goals"
FROM ordered
WHERE "rn" IN ( (("cnt"+1)/2), (("cnt"+2)/2) );
```
