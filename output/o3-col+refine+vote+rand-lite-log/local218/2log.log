```sql
--Description: 5) Sum of HOME goals per team-season (part 1 of aggregation)
SELECT "season",
       "home_team_api_id" AS "team_id",
       SUM("home_team_goal") AS "home_goals"
FROM "Match"
GROUP BY "season", "team_id"
LIMIT 20;
```

```sql
--Description: 6) Sum of AWAY goals per team-season (part 2 of aggregation)
SELECT "season",
       "away_team_api_id" AS "team_id",
       SUM("away_team_goal") AS "away_goals"
FROM "Match"
GROUP BY "season", "team_id"
LIMIT 20;
```

```sql
--Description: 7) Home + Away goals for every team-season (union of the two pieces)
SELECT tg."season",
       tg."team_id",
       tg."season_goals"
FROM (
      SELECT "season",
             "home_team_api_id" AS "team_id",
             SUM("home_team_goal") AS "season_goals"
      FROM "Match"
      GROUP BY "season", "team_id"
      UNION ALL
      SELECT "season",
             "away_team_api_id" AS "team_id",
             SUM("away_team_goal")
      FROM "Match"
      GROUP BY "season", "team_id"
) AS tg
LIMIT 20;
```

```sql
--Description: 8) Re-sum the union to get TOTAL goals per team-season
SELECT "season",
       "team_id",
       SUM("season_goals") AS "total_season_goals"
FROM (
      SELECT "season",
             "home_team_api_id" AS "team_id",
             SUM("home_team_goal") AS "season_goals"
      FROM "Match"
      GROUP BY "season", "team_id"
      UNION ALL
      SELECT "season",
             "away_team_api_id" AS "team_id",
             SUM("away_team_goal")
      FROM "Match"
      GROUP BY "season", "team_id"
)
GROUP BY "season", "team_id"
LIMIT 20;
```

```sql
--Description: 9) Pick the highest season-goal figure for each team
WITH team_season AS (
     SELECT "season",
            "team_id",
            SUM("season_goals") AS "total_season_goals"
     FROM (
           SELECT "season",
                  "home_team_api_id" AS "team_id",
                  SUM("home_team_goal") AS "season_goals"
           FROM "Match"
           GROUP BY "season", "team_id"
           UNION ALL
           SELECT "season",
                  "away_team_api_id" AS "team_id",
                  SUM("away_team_goal")
           FROM "Match"
           GROUP BY "season", "team_id"
     )
     GROUP BY "season", "team_id"
)
SELECT "team_id",
       MAX("total_season_goals") AS "highest_season_goals"
FROM team_season
GROUP BY "team_id"
LIMIT 20;
```

```sql
--Description: 10) FINAL – median of every team’s best season-goal total
WITH home AS (
     SELECT "season",
            "home_team_api_id" AS "team_id",
            SUM("home_team_goal") AS "goals"
     FROM "Match"
     GROUP BY "season", "team_id"
),
away AS (
     SELECT "season",
            "away_team_api_id" AS "team_id",
            SUM("away_team_goal") AS "goals"
     FROM "Match"
     GROUP BY "season", "team_id"
),
team_season AS (
     SELECT * FROM home
     UNION ALL
     SELECT * FROM away
),
combined AS (
     SELECT "season",
            "team_id",
            SUM("goals") AS "season_goals"
     FROM team_season
     GROUP BY "season", "team_id"
),
highest AS (
     SELECT "team_id",
            MAX("season_goals") AS "highest_goals"
     FROM combined
     GROUP BY "team_id"
),
cnt AS (SELECT COUNT(*) AS n FROM highest),
ord AS (
     SELECT "highest_goals",
            ROW_NUMBER() OVER (ORDER BY "highest_goals") AS rn
     FROM highest
)
SELECT AVG("highest_goals") AS "median_highest_season_goals"
FROM  ord, cnt
WHERE (cnt.n % 2 = 1  AND ord.rn = (cnt.n + 1)/2)
   OR (cnt.n % 2 = 0  AND ord.rn IN (cnt.n/2, cnt.n/2 + 1));
```
