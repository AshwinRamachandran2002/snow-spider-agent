--Description: 9) Pick the highest season-goal figure for each team
WITH team_season AS (
     SELECT "season",
            "team_id",
            SUM("season_goals") AS "total_season_goals"
     FROM (
           SELECT "season",
                  "home_team_api_id" AS "team_id",
                  SUM("home_team_goal") AS "season_goals"
           FROM "Match"
           GROUP BY "season", "team_id"
           UNION ALL
           SELECT "season",
                  "away_team_api_id" AS "team_id",
                  SUM("away_team_goal")
           FROM "Match"
           GROUP BY "season", "team_id"
     )
     GROUP BY "season", "team_id"
)
SELECT "team_id",
       MAX("total_season_goals") AS "highest_season_goals"
FROM team_season
GROUP BY "team_id"
LIMIT 20;
