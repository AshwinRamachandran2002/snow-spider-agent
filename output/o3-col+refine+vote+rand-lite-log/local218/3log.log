```sql
-- Description: Take a quick glance at matches that involve the team whose api-id = 9987
SELECT "id",
       "season",
       "home_team_api_id",
       "away_team_api_id",
       "home_team_goal",
       "away_team_goal"
FROM "Match"
WHERE "home_team_api_id" = 9987
   OR "away_team_api_id" = 9987
LIMIT 20;
```

```sql
-- Description: Calculate goals scored by every team in every season (home + away goals)
SELECT m."season",
       t."team_long_name",
       SUM(CASE
               WHEN m."home_team_api_id" = t."team_api_id"
                    THEN m."home_team_goal"
               ELSE m."away_team_goal"
           END) AS "season_goals"
FROM   "Match" AS m
JOIN   "Team"  AS t
       ON t."team_api_id" IN (m."home_team_api_id", m."away_team_api_id")
GROUP  BY t."team_long_name",
          m."season"
LIMIT 20;
```

```sql
-- Description: From the season-totals above, keep only each team’s single highest-scoring season
WITH season_totals AS (
       SELECT m."season",
              t."team_long_name",
              SUM(CASE
                      WHEN m."home_team_api_id" = t."team_api_id"
                           THEN m."home_team_goal"
                      ELSE m."away_team_goal"
                  END) AS season_goals
       FROM   "Match" AS m
       JOIN   "Team"  AS t
              ON t."team_api_id" IN (m."home_team_api_id", m."away_team_api_id")
       GROUP  BY t."team_long_name",
                 m."season"
)
SELECT   "team_long_name",
         MAX("season_goals") AS "max_season_goals"
FROM     season_totals
GROUP BY "team_long_name"
LIMIT 20;
```

```sql
-- Description: Order teams by their highest season-goal tally
WITH season_totals AS (
       SELECT m."season",
              t."team_long_name",
              SUM(CASE
                      WHEN m."home_team_api_id" = t."team_api_id"
                           THEN m."home_team_goal"
                      ELSE m."away_team_goal"
                  END) AS season_goals
       FROM   "Match" AS m
       JOIN   "Team"  AS t
              ON t."team_api_id" IN (m."home_team_api_id", m."away_team_api_id")
       GROUP  BY t."team_long_name",
                 m."season"
), team_best AS (
       SELECT   "team_long_name",
                MAX("season_goals") AS "max_season_goals"
       FROM     season_totals
       GROUP BY "team_long_name"
)
SELECT *
FROM   team_best
ORDER  BY "max_season_goals" DESC
LIMIT 20;
```

```sql
-- Description: Count how many teams we have after extracting each team’s best season
WITH season_totals AS (
       SELECT m."season",
              t."team_long_name",
              SUM(CASE
                      WHEN m."home_team_api_id" = t."team_api_id"
                           THEN m."home_team_goal"
                      ELSE m."away_team_goal"
                  END) AS season_goals
       FROM   "Match" AS m
       JOIN   "Team"  AS t
              ON t."team_api_id" IN (m."home_team_api_id", m."away_team_api_id")
       GROUP  BY t."team_long_name",
                 m."season"
), team_best AS (
       SELECT   "team_long_name",
                MAX("season_goals") AS "max_season_goals"
       FROM     season_totals
       GROUP BY "team_long_name"
)
SELECT COUNT(*) AS "num_teams"
FROM   team_best;
```

```sql
-- Description: Compute the median of the “highest season goals” values across all teams
WITH season_totals AS (
       SELECT m."season",
              t."team_long_name",
              SUM(CASE
                      WHEN m."home_team_api_id" = t."team_api_id"
                           THEN m."home_team_goal"
                      ELSE m."away_team_goal"
                  END) AS season_goals
       FROM   "Match" AS m
       JOIN   "Team"  AS t
              ON t."team_api_id" IN (m."home_team_api_id", m."away_team_api_id")
       GROUP  BY t."team_long_name",
                 m."season"
), team_best AS (
       SELECT   "team_long_name",
                MAX("season_goals") AS "max_season_goals"
       FROM     season_totals
       GROUP BY "team_long_name"
), ordered AS (
       SELECT "max_season_goals",
              ROW_NUMBER() OVER (ORDER BY "max_season_goals")      AS rn,
              COUNT(*)    OVER ()                                  AS cnt
       FROM   team_best
)
SELECT AVG("max_season_goals") AS "median_max_season_goals"
FROM   ordered
WHERE  rn IN ( (cnt + 1) / 2, (cnt + 2) / 2 );     -- handles both odd & even counts
```

