-- Description: Count how many teams we have after extracting each team’s best season
WITH season_totals AS (
       SELECT m."season",
              t."team_long_name",
              SUM(CASE
                      WHEN m."home_team_api_id" = t."team_api_id"
                           THEN m."home_team_goal"
                      ELSE m."away_team_goal"
                  END) AS season_goals
       FROM   "Match" AS m
       JOIN   "Team"  AS t
              ON t."team_api_id" IN (m."home_team_api_id", m."away_team_api_id")
       GROUP  BY t."team_long_name",
                 m."season"
), team_best AS (
       SELECT   "team_long_name",
                MAX("season_goals") AS "max_season_goals"
       FROM     season_totals
       GROUP BY "team_long_name"
)
SELECT COUNT(*) AS "num_teams"
