```sql
--Description: 1) Inspect the list of available seasons in the Match table
SELECT DISTINCT "season"
FROM "Match"
LIMIT 20;
```

```sql
--Description: 2) Look at a sample of matches together with the goals each side scored
SELECT "match_api_id",
       "season",
       "home_team_api_id",
       "away_team_api_id",
       "home_team_goal",
       "away_team_goal"
FROM "Match"
LIMIT 20;
```

```sql
--Description: 3) Derive (team , season , goals) by stacking home & away rows and aggregating
SELECT "team_id",
       "season",
       SUM("goals") AS "season_goals"
FROM (
        SELECT "home_team_api_id" AS "team_id",
               "season",
               "home_team_goal"       AS "goals"
        FROM   "Match"
        UNION ALL
        SELECT "away_team_api_id",
               "season",
               "away_team_goal"
        FROM   "Match"
     )
GROUP BY "team_id","season"
LIMIT 20;
```

```sql
--Description: 4) Check one concrete club (id = 9987) to confirm we obtained its season-level totals
SELECT "team_id",
       "season",
       SUM("goals") AS "season_goals"
FROM (
        SELECT "home_team_api_id" AS "team_id",
               "season",
               "home_team_goal" AS "goals"
        FROM   "Match"
        UNION ALL
        SELECT "away_team_api_id",
               "season",
               "away_team_goal"
        FROM   "Match"
     )
GROUP BY "team_id","season"
HAVING "team_id" = 9987
ORDER BY "season_goals" DESC
LIMIT 20;
```

```sql
--Description: 5) For every club, keep the highest goal total it ever achieved in a single season
WITH per_season AS (
     SELECT "team_id",
            "season",
            SUM("goals") AS "season_goals"
     FROM (
            SELECT "home_team_api_id" AS "team_id","season","home_team_goal" AS "goals" FROM "Match"
            UNION ALL
            SELECT "away_team_api_id","season","away_team_goal" FROM "Match"
          )
     GROUP BY "team_id","season"
)
SELECT "team_id",
       MAX("season_goals") AS "max_season_goals"
FROM   per_season
GROUP BY "team_id"
LIMIT 20;
```

```sql
--Description: 6) Show the ordered list of those per-team maximums (first 20 values)
WITH per_season AS (
     SELECT "team_id","season",SUM("goals") AS "season_goals"
     FROM (
            SELECT "home_team_api_id" AS "team_id","season","home_team_goal" AS "goals" FROM "Match"
            UNION ALL
            SELECT "away_team_api_id","season","away_team_goal" FROM "Match"
          )
     GROUP BY "team_id","season"
),
max_season AS (
     SELECT "team_id",MAX("season_goals") AS "max_season_goals"
     FROM   per_season
     GROUP BY "team_id"
)
SELECT "max_season_goals"
FROM   max_season
ORDER BY "max_season_goals"
LIMIT 20;
```

```sql
--Description: 7) How many teams do we have in total (i.e., number of per-team maximums)?
WITH per_season AS (
     SELECT "team_id","season",SUM("goals") AS "season_goals"
     FROM (
            SELECT "home_team_api_id" AS "team_id","season","home_team_goal" AS "goals" FROM "Match"
            UNION ALL
            SELECT "away_team_api_id","season","away_team_goal" FROM "Match"
          )
     GROUP BY "team_id","season"
),
max_season AS (
     SELECT "team_id",MAX("season_goals") AS "max_season_goals"
     FROM   per_season
     GROUP BY "team_id"
)
SELECT COUNT(*) AS "team_count"
FROM   max_season;
```

```sql
--Description: 8) FINAL – compute the median of the “highest season-goal totals” across all teams
WITH per_season AS (
     SELECT "team_id",
            "season",
            SUM("goals") AS "season_goals"
     FROM (
            SELECT "home_team_api_id" AS "team_id","season","home_team_goal" AS "goals" FROM "Match"
            UNION ALL
            SELECT "away_team_api_id","season","away_team_goal" FROM "Match"
          )
     GROUP BY "team_id","season"
),
max_season AS (
     SELECT "team_id",
            MAX("season_goals") AS "max_season_goals"
     FROM   per_season
     GROUP BY "team_id"
),
ordered AS (
     SELECT "max_season_goals",
            ROW_NUMBER() OVER (ORDER BY "max_season_goals")        AS rn,
            COUNT(*)     OVER ()                                   AS cnt
     FROM   max_season
)
SELECT AVG("max_season_goals") AS "median_max_season_goals"
FROM   ordered
WHERE  rn IN ( (cnt + 1) / 2 , (cnt + 2) / 2 );
```
