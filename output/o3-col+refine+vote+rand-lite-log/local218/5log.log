--Description: 5) For every club, keep the highest goal total it ever achieved in a single season
WITH per_season AS (
     SELECT "team_id",
            "season",
            SUM("goals") AS "season_goals"
     FROM (
            SELECT "home_team_api_id" AS "team_id","season","home_team_goal" AS "goals" FROM "Match"
            UNION ALL
            SELECT "away_team_api_id","season","away_team_goal" FROM "Match"
          )
     GROUP BY "team_id","season"
)
SELECT "team_id",
       MAX("season_goals") AS "max_season_goals"
FROM   per_season
GROUP BY "team_id"
LIMIT 20;
